// # Pasta 2-Cycle Elliptic Curves (Pallas & Vesta)
//
// Logline: Pallas/Vesta modular add + field switch. Toy p=1009 q=1013.
//
// Setup: Affine points. Cycle: base of one is scalar of the other.
//
// Beats:
//   1. Pallas add (x1+x2, y1+y2) mod p.
//   2. Vesta add (x1+x2, y1+y2) mod q.
//   3. Field switch reduces Pallas coords into Vesta modulus.

type PallasPoint = struct {
    x_fp: Int,
    y_fp: Int,
    is_infinity: Int
};

type VestaPoint = struct {
    x_fq: Int,
    y_fq: Int,
    is_infinity: Int
};

type PastaCycleParams = struct {
    pallas_base_field_p: Int,
    vesta_base_field_q: Int
};

fn pasta_mod_pos(x: Int, m: Int) -> Int {
    let r: Int = x % m;
    if r < 0 {
        return r + m;
    }
    return r;
}

pub fn pasta_cycle_params_init() -> PastaCycleParams {
    return PastaCycleParams {
        pallas_base_field_p: 1009,
        vesta_base_field_q: 1013
    };
}

pub fn pallas_point_new(x: Int, y: Int) -> PallasPoint {
    return PallasPoint {
        x_fp: x,
        y_fp: y,
        is_infinity: 0
    };
}

pub fn vesta_point_new(x: Int, y: Int) -> VestaPoint {
    return VestaPoint {
        x_fq: x,
        y_fq: y,
        is_infinity: 0
    };
}

pub fn pallas_add(
    p1: PallasPoint,
    p2: PallasPoint,
    p_mod: Int
) -> PallasPoint {
    return PallasPoint {
        x_fp: pasta_mod_pos(p1.x_fp + p2.x_fp, p_mod),
        y_fp: pasta_mod_pos(p1.y_fp + p2.y_fp, p_mod),
        is_infinity: 0
    };
}

pub fn vesta_add(
    v1: VestaPoint,
    v2: VestaPoint,
    q_mod: Int
) -> VestaPoint {
    return VestaPoint {
        x_fq: pasta_mod_pos(v1.x_fq + v2.x_fq, q_mod),
        y_fq: pasta_mod_pos(v1.y_fq + v2.y_fq, q_mod),
        is_infinity: 0
    };
}

pub fn pasta_field_switch_p_to_q(x_fp: Int, q_mod: Int) -> Int {
    return pasta_mod_pos(x_fp, q_mod);
}

pub fn pasta_pallas_as_vesta(pt: PallasPoint, q_mod: Int) -> VestaPoint {
    return VestaPoint {
        x_fq: pasta_mod_pos(pt.x_fp, q_mod),
        y_fq: pasta_mod_pos(pt.y_fp, q_mod),
        is_infinity: pt.is_infinity
    };
}
