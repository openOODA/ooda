// # PLONK Prover Execution Trace
//
// Logline: Four-row wire table (A,B,C). Append + column extract. Int floor.
//
// Setup: List[row] destubbed to a0..c3 slots. filled tracks occupied rows.
//
// Beats:
//   1. New table is empty; domain_size is the padded power-of-two bound.
//   2. Append writes the next empty slot; full table (filled=4) is unchanged.
//   3. Extract copies the three wire columns out of the table slots.

type PlonkTraceRow = struct {
    row_index: Int,
    wire_a_val: Int,
    wire_b_val: Int,
    wire_c_val: Int
};

type PlonkTraceTable = struct {
    domain_size: Int,
    filled: Int,
    a0: Int,
    b0: Int,
    c0: Int,
    a1: Int,
    b1: Int,
    c1: Int,
    a2: Int,
    b2: Int,
    c2: Int,
    a3: Int,
    b3: Int,
    c3: Int
};

type ColumnEvaluations = struct {
    a0: Int,
    a1: Int,
    a2: Int,
    a3: Int,
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int
};

pub fn plonk_trace_row_new(idx: Int, a: Int, b: Int, c: Int) -> PlonkTraceRow {
    return PlonkTraceRow {
        row_index: idx,
        wire_a_val: a,
        wire_b_val: b,
        wire_c_val: c
    };
}

pub fn plonk_trace_table_new(domain_sz: Int) -> PlonkTraceTable {
    return PlonkTraceTable {
        domain_size: domain_sz,
        filled: 0,
        a0: 0,
        b0: 0,
        c0: 0,
        a1: 0,
        b1: 0,
        c1: 0,
        a2: 0,
        b2: 0,
        c2: 0,
        a3: 0,
        b3: 0,
        c3: 0
    };
}

pub fn plonk_trace_append_row(
    table: PlonkTraceTable,
    row: PlonkTraceRow
) -> PlonkTraceTable {
    let f: Int = table.filled;
    if f == 0 {
        return PlonkTraceTable {
            domain_size: table.domain_size,
            filled: 1,
            a0: row.wire_a_val,
            b0: row.wire_b_val,
            c0: row.wire_c_val,
            a1: table.a1,
            b1: table.b1,
            c1: table.c1,
            a2: table.a2,
            b2: table.b2,
            c2: table.c2,
            a3: table.a3,
            b3: table.b3,
            c3: table.c3
        };
    }
    if f == 1 {
        return PlonkTraceTable {
            domain_size: table.domain_size,
            filled: 2,
            a0: table.a0,
            b0: table.b0,
            c0: table.c0,
            a1: row.wire_a_val,
            b1: row.wire_b_val,
            c1: row.wire_c_val,
            a2: table.a2,
            b2: table.b2,
            c2: table.c2,
            a3: table.a3,
            b3: table.b3,
            c3: table.c3
        };
    }
    if f == 2 {
        return PlonkTraceTable {
            domain_size: table.domain_size,
            filled: 3,
            a0: table.a0,
            b0: table.b0,
            c0: table.c0,
            a1: table.a1,
            b1: table.b1,
            c1: table.c1,
            a2: row.wire_a_val,
            b2: row.wire_b_val,
            c2: row.wire_c_val,
            a3: table.a3,
            b3: table.b3,
            c3: table.c3
        };
    }
    if f == 3 {
        return PlonkTraceTable {
            domain_size: table.domain_size,
            filled: 4,
            a0: table.a0,
            b0: table.b0,
            c0: table.c0,
            a1: table.a1,
            b1: table.b1,
            c1: table.c1,
            a2: table.a2,
            b2: table.b2,
            c2: table.c2,
            a3: row.wire_a_val,
            b3: row.wire_b_val,
            c3: row.wire_c_val
        };
    }
    return table;
}

pub fn plonk_trace_extract_columns(table: PlonkTraceTable) -> ColumnEvaluations {
    return ColumnEvaluations {
        a0: table.a0,
        a1: table.a1,
        a2: table.a2,
        a3: table.a3,
        b0: table.b0,
        b1: table.b1,
        b2: table.b2,
        b3: table.b3,
        c0: table.c0,
        c1: table.c1,
        c2: table.c2,
        c3: table.c3
    };
}
