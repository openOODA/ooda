// # FRI Folding Operator (pair + 4-eval layer floor)
//
// Logline: f' = (f(x)+f(-x)) + alpha*(f(x)-f(-x))  (mod p). Destubbed off List/pub type.
//
// Setup: Four evaluations e0..e3 stand for a domain of 4.
//
// Beats:
//   1. fold_single_pair is the even/odd linear combination.
//   2. fold_layer halves 4 evals to 2.
//   3. Negative diffs wrap by +p.

type FriLayer = struct {
    round_index: Int,
    domain_size: Int,
    e0: Int,
    e1: Int,
    e2: Int,
    e3: Int
};

pub fn fri_layer_new(r_idx: Int, d_size: Int, e0: Int, e1: Int, e2: Int, e3: Int) -> FriLayer {
    return FriLayer {
        round_index: r_idx,
        domain_size: d_size,
        e0: e0,
        e1: e1,
        e2: e2,
        e3: e3
    };
}

fn fri_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn fri_fold_single_pair(fx_pos: Int, fx_neg: Int, alpha: Int, p_mod: Int) -> Int {
    let sum_even: Int = fri_mod_pos(fx_pos + fx_neg, p_mod);
    let diff_odd: Int = fri_mod_pos(fx_pos - fx_neg, p_mod);
    let alpha_odd: Int = fri_mod_pos(diff_odd * alpha, p_mod);
    return fri_mod_pos(sum_even + alpha_odd, p_mod);
}

pub fn fri_fold_layer(layer: FriLayer, alpha: Int, p_mod: Int) -> FriLayer {
    let n2: Int = layer.domain_size / 2;
    let f0: Int = fri_fold_single_pair(layer.e0, layer.e2, alpha, p_mod);
    let f1: Int = fri_fold_single_pair(layer.e1, layer.e3, alpha, p_mod);
    return FriLayer {
        round_index: layer.round_index + 1,
        domain_size: n2,
        e0: f0,
        e1: f1,
        e2: 0,
        e3: 0
    };
}
