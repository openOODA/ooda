// # PLONK Permutation Argument
//
// Logline: Grand product (w+β·id+γ) on three wires. Boundary Z(g^0)=1. Int floor.
//
// Setup: Beta/gamma challenges. Copy map is four Ints. Z evals flattened off List.
//
// Beats:
//   1. One step: (w_L+β·id_L+γ)(w_R+β·id_R+γ)(w_O+β·id_O+γ)  (mod p).
//   2. Boundary rejects first_val != 1 (error 1).
//   3. Copy constraint stores source/target wire+gate.

type PlonkPermutationState = struct {
    domain_size: Int,
    beta_challenge: Int,
    gamma_challenge: Int,
    prime_mod: Int
};

type PlonkCopyConstraint = struct {
    source_wire: Int,
    source_gate: Int,
    target_wire: Int,
    target_gate: Int
};

type PermutationCheckResult = struct {
    is_satisfied: Int,
    final_accumulator: Int,
    error_code: Int
};

fn pperm_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn plonk_permutation_state_new(
    n_dom: Int,
    beta: Int,
    gamma: Int,
    p_mod: Int
) -> PlonkPermutationState {
    return PlonkPermutationState {
        domain_size: n_dom,
        beta_challenge: beta,
        gamma_challenge: gamma,
        prime_mod: p_mod
    };
}

pub fn plonk_copy_constraint_new(
    sw: Int,
    sg: Int,
    tw: Int,
    tg: Int
) -> PlonkCopyConstraint {
    return PlonkCopyConstraint {
        source_wire: sw,
        source_gate: sg,
        target_wire: tw,
        target_gate: tg
    };
}

pub fn plonk_compute_grand_product_step(
    st: PlonkPermutationState,
    w_left: Int,
    w_right: Int,
    w_out: Int,
    sid_left: Int,
    sid_right: Int,
    sid_out: Int
) -> Int {
    let beta: Int = st.beta_challenge;
    let gamma: Int = st.gamma_challenge;
    let p_mod: Int = st.prime_mod;
    let num_l: Int = pperm_mod_pos(w_left + (beta * sid_left) + gamma, p_mod);
    let num_r: Int = pperm_mod_pos(w_right + (beta * sid_right) + gamma, p_mod);
    let num_o: Int = pperm_mod_pos(w_out + (beta * sid_out) + gamma, p_mod);
    return pperm_mod_pos((num_l * num_r) * num_o, p_mod);
}

pub fn plonk_verify_grand_product_boundary(
    first_val: Int,
    last_val: Int
) -> PermutationCheckResult {
    if first_val != 1 {
        return PermutationCheckResult {
            is_satisfied: 0,
            final_accumulator: last_val,
            error_code: 1
        };
    }
    return PermutationCheckResult {
        is_satisfied: 1,
        final_accumulator: last_val,
        error_code: 0
    };
}
