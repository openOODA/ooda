// # Merkle Patricia Trie Insertion
//
// Logline: 4-nibble prefix, leaf-into-empty, branch split. Four-slot batch.
//
// Setup: Hex keys as 16-bit nibble words. Empty root 1454123767.
//
// Beats:
//   1. Common prefix walks high nibble to low (div 4096/256/16/1).
//   2. Empty insert: new_root = mix(mix(1,key),val); nodes_created=1.
//   3. Split: mix(mix(mix(4,old),key),val); nodes_created=2.

type MptInsertRequest = struct {
    key_hex: Int,
    value_hex: Int,
    tree_depth: Int
};

type MptInsertResult = struct {
    old_root: Int,
    new_root: Int,
    nodes_created: Int,
    is_success: Int
};

fn mpt_ins_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

fn mpt_nibble(x: Int, shift_div: Int) -> Int {
    return (x / shift_div) % 16;
}

pub fn mpt_insert_request_new(k_hex: Int, v_hex: Int) -> MptInsertRequest {
    return MptInsertRequest {
        key_hex: k_hex,
        value_hex: v_hex,
        tree_depth: 0
    };
}

pub fn mpt_common_prefix_len(key_a: Int, key_b: Int) -> Int {
    if mpt_nibble(key_a, 4096) != mpt_nibble(key_b, 4096) {
        return 0;
    }
    if mpt_nibble(key_a, 256) != mpt_nibble(key_b, 256) {
        return 1;
    }
    if mpt_nibble(key_a, 16) != mpt_nibble(key_b, 16) {
        return 2;
    }
    if (key_a % 16) != (key_b % 16) {
        return 3;
    }
    return 4;
}

pub fn mpt_insert_leaf_into_empty(req: MptInsertRequest) -> MptInsertResult {
    let k: Int = req.key_hex;
    let v: Int = req.value_hex;
    return MptInsertResult {
        old_root: 1454123767,
        new_root: mpt_ins_mix(mpt_ins_mix(1, k), v),
        nodes_created: 1,
        is_success: 1
    };
}

pub fn mpt_insert_branch_split(
    current_root: Int,
    req: MptInsertRequest,
    split_index: Int
) -> MptInsertResult {
    let k: Int = req.key_hex;
    let v: Int = req.value_hex;
    return MptInsertResult {
        old_root: current_root,
        new_root: mpt_ins_mix(mpt_ins_mix(mpt_ins_mix(4, current_root), k), v),
        nodes_created: 2,
        is_success: 1
    };
}

fn mpt_batch_one(cur_root: Int, k: Int, v: Int, created: Int) -> MptInsertResult {
    if k == 0 {
        return MptInsertResult {
            old_root: cur_root,
            new_root: cur_root,
            nodes_created: created,
            is_success: 1
        };
    }
    let req: MptInsertRequest = mpt_insert_request_new(k, v);
    let res: MptInsertResult = mpt_insert_leaf_into_empty(req);
    return MptInsertResult {
        old_root: cur_root,
        new_root: res.new_root,
        nodes_created: created + res.nodes_created,
        is_success: 1
    };
}

pub fn mpt_batch_insert(
    base_root: Int,
    k0: Int,
    v0: Int,
    k1: Int,
    v1: Int,
    k2: Int,
    v2: Int,
    k3: Int,
    v3: Int
) -> MptInsertResult {
    let s0: MptInsertResult = mpt_batch_one(base_root, k0, v0, 0);
    let s1: MptInsertResult = mpt_batch_one(s0.new_root, k1, v1, s0.nodes_created);
    let s2: MptInsertResult = mpt_batch_one(s1.new_root, k2, v2, s1.nodes_created);
    let s3: MptInsertResult = mpt_batch_one(s2.new_root, k3, v3, s2.nodes_created);
    return MptInsertResult {
        old_root: base_root,
        new_root: s3.new_root,
        nodes_created: s3.nodes_created,
        is_success: 1
    };
}
