// # STARK Composition Polynomial
//
// Logline: Implements boundary and transition constraint quotient merging into the STARK composition polynomial.
//
// Setup: Pure algebraic algorithms combining AIR constraints with random linear combination coefficients.
//
// Beats:
//   1. Define composition polynomial evaluation context, random alphas, and quotient terms.
//   2. Implement boundary quotient terms: (P(x) - B(x)) / Z_B(x).
//   3. Implement transition quotient terms: C(x, P(x), P(gx)) / Z_T(x) and linear combination summation.

pub type CompositionPolyContext = struct {
    num_boundary_constraints: Int,
    num_transition_constraints: Int,
    alpha_coefficients: List[Int],
    prime_mod: Int,
};

pub type CompositionEvaluation = struct {
    eval_point: Int,
    boundary_quotient_eval: Int,
    transition_quotient_eval: Int,
    composition_eval: Int,
};

pub fn composition_poly_context_new(
    n_bound: Int,
    n_trans: Int,
    p_mod: Int
) -> CompositionPolyContext {
    let mut alphas: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_bound + n_trans {
        alphas = list_push(alphas, i + 3);
        i = i + 1;
    }

    return CompositionPolyContext {
        num_boundary_constraints: n_bound,
        num_transition_constraints: n_trans,
        alpha_coefficients: alphas,
        prime_mod: p_mod,
    };
}

pub fn composition_poly_evaluate_point(
    ctx: CompositionPolyContext,
    pt: Int,
    b_quot: Int,
    t_quot: Int
) -> CompositionEvaluation {
    let p_mod: Int = (ctx).prime_mod;
    let combined: Int = (b_quot + t_quot * 5) % p_mod;

    return CompositionEvaluation {
        eval_point: pt,
        boundary_quotient_eval: b_quot,
        transition_quotient_eval: t_quot,
        composition_eval: combined,
    };
}
