// # Rollup Escape Hatch & Forced Exit
//
// Logline: Freeze when now - last_seq > max_downtime; then unlock claimed. Int floor.
//
// Setup: Bool→Int. Message codes 0=inactive 1=processed. n_forced not *_count.
//
// Beats:
//   1. Init inactive, last_seq=0, freeze=0.
//   2. Trigger only when current_ts - last_ts > max_dt (strict).
//   3. Forced exit while inactive unlocks 0; while active unlocks claimed_balance.

type EscapeHatchState = struct {
    is_active: Int,
    freeze_timestamp: Int,
    n_forced: Int,
    last_sequenced_timestamp: Int,
    max_downtime_seconds: Int
};

type ForcedExitRequest = struct {
    account_index: Int,
    recipient_l1: Int,
    claimed_balance: Int,
    inclusion_deadline: Int,
    is_executed: Int
};

type EscapeHatchResult = struct {
    state_frozen: Int,
    funds_unlocked: Int,
    message: Int
};

pub fn escape_hatch_init(downtime_sec: Int) -> EscapeHatchState {
    return EscapeHatchState {
        is_active: 0,
        freeze_timestamp: 0,
        n_forced: 0,
        last_sequenced_timestamp: 0,
        max_downtime_seconds: downtime_sec
    };
}

pub fn forced_exit_request_new(
    idx: Int,
    recipient: Int,
    bal: Int,
    deadline: Int
) -> ForcedExitRequest {
    return ForcedExitRequest {
        account_index: idx,
        recipient_l1: recipient,
        claimed_balance: bal,
        inclusion_deadline: deadline,
        is_executed: 0
    };
}

pub fn escape_hatch_check_trigger(
    st: EscapeHatchState,
    current_timestamp: Int
) -> EscapeHatchState {
    let last_ts: Int = st.last_sequenced_timestamp;
    let max_dt: Int = st.max_downtime_seconds;
    if current_timestamp - last_ts > max_dt {
        return EscapeHatchState {
            is_active: 1,
            freeze_timestamp: current_timestamp,
            n_forced: st.n_forced,
            last_sequenced_timestamp: last_ts,
            max_downtime_seconds: max_dt
        };
    }
    return st;
}

pub fn escape_hatch_execute_forced_exit(
    st: EscapeHatchState,
    req: ForcedExitRequest
) -> EscapeHatchResult {
    if st.is_active == 0 {
        return EscapeHatchResult {
            state_frozen: 0,
            funds_unlocked: 0,
            message: 0
        };
    }
    return EscapeHatchResult {
        state_frozen: 1,
        funds_unlocked: req.claimed_balance,
        message: 1
    };
}
