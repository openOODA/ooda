// # Lookup Argument & Multiset Equality (Plookup / Halo2)
//
// Logline: Grand product over (w+γ)(t+βt+γ). Four-slot by-value floor.
//
// Setup: Four table slots and four witness slots. Membership + accumulate.
//
// Beats:
//   1. acc *= (w + gamma) * (t + beta*t + gamma)  (mod p).
//   2. Unmatched = witnesses absent from the four table slots.
//   3. Empty table (filled=0) is invalid.

type LookupTable = struct {
    table_id: Int,
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int,
    filled: Int
};

type LookupGrandProductState = struct {
    beta_challenge: Int,
    gamma_challenge: Int,
    prime_mod: Int,
    accumulator_val: Int
};

type LookupProofResult = struct {
    is_valid: Int,
    final_prod: Int,
    n_unmatched: Int
};

fn anlk_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn lookup_table_new(t_id: Int, t0: Int, t1: Int, t2: Int, t3: Int) -> LookupTable {
    return LookupTable {
        table_id: t_id,
        t0: t0,
        t1: t1,
        t2: t2,
        t3: t3,
        filled: 4
    };
}

pub fn lookup_grand_product_init(beta: Int, gamma: Int, p_mod: Int) -> LookupGrandProductState {
    return LookupGrandProductState {
        beta_challenge: beta,
        gamma_challenge: gamma,
        prime_mod: p_mod,
        accumulator_val: 1
    };
}

pub fn lookup_accumulate_step(
    st: LookupGrandProductState,
    witness_val: Int,
    table_val: Int
) -> LookupGrandProductState {
    let beta: Int = st.beta_challenge;
    let gamma: Int = st.gamma_challenge;
    let p_mod: Int = st.prime_mod;
    let term_w: Int = anlk_mod_pos(witness_val + gamma, p_mod);
    let term_t: Int = anlk_mod_pos(table_val + (beta * table_val) + gamma, p_mod);
    let new_acc: Int = anlk_mod_pos((st.accumulator_val * term_w) * term_t, p_mod);
    return LookupGrandProductState {
        beta_challenge: beta,
        gamma_challenge: gamma,
        prime_mod: p_mod,
        accumulator_val: new_acc
    };
}

fn anlk_in_table(table: LookupTable, w: Int) -> Int {
    if table.t0 == w {
        return 1;
    }
    if table.t1 == w {
        return 1;
    }
    if table.t2 == w {
        return 1;
    }
    if table.t3 == w {
        return 1;
    }
    return 0;
}

fn anlk_absent(table: LookupTable, w: Int) -> Int {
    if anlk_in_table(table, w) == 0 {
        return 1;
    }
    return 0;
}

pub fn lookup_verify_multiset(
    table: LookupTable,
    w0: Int,
    w1: Int,
    w2: Int,
    w3: Int
) -> LookupProofResult {
    if table.filled == 0 {
        return LookupProofResult {
            is_valid: 0,
            final_prod: 0,
            n_unmatched: 4
        };
    }
    let n_miss: Int = anlk_absent(table, w0) + anlk_absent(table, w1) + anlk_absent(table, w2) + anlk_absent(table, w3);
    if n_miss == 0 {
        return LookupProofResult {
            is_valid: 1,
            final_prod: 1,
            n_unmatched: 0
        };
    }
    return LookupProofResult {
        is_valid: 0,
        final_prod: 0,
        n_unmatched: n_miss
    };
}
