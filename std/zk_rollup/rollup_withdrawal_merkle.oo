// # Rollup L2-to-L1 Withdrawal Merkle Proof
//
// Logline: Implements L2-to-L1 exit message trees, withdrawal roots, and claim proof verification on L1.
//
// Setup: Pure Merkle proof algorithms for cross-layer bridge exits and token withdrawals.
//
// Beats:
//   1. Define withdrawal message, withdrawal tree root, and claim proof structures.
//   2. Implement withdrawal leaf serialization and message hash computation.
//   3. Implement withdrawal claim verification against finalized L2 state roots.

pub type WithdrawalMessage = struct {
    withdrawal_id: Int,
    l2_sender: String,
    l1_recipient: String,
    token_address: String,
    amount: Int,
    nonce: Int,
};

pub type WithdrawalProof = struct {
    message: WithdrawalMessage,
    withdrawal_root: String,
    merkle_branch: List[String],
    leaf_index: Int,
};

pub type WithdrawalClaimResult = struct {
    is_claimable: Bool,
    withdrawal_id: Int,
    amount: Int,
    recipient: String,
};

pub fn withdrawal_message_new(
    w_id: Int,
    sender: String,
    recipient: String,
    token: String,
    amt: Int,
    n_val: Int
) -> WithdrawalMessage {
    return WithdrawalMessage {
        withdrawal_id: w_id,
        l2_sender: sender,
        l1_recipient: recipient,
        token_address: token,
        amount: amt,
        nonce: n_val,
    };
}

pub fn withdrawal_message_hash(msg: WithdrawalMessage) -> String {
    let s: String = (msg).l2_sender;
    let r: String = (msg).l1_recipient;
    let t: String = (msg).token_address;
    return "w_hash_" + s + "_" + r + "_" + t;
}

pub fn withdrawal_verify_proof(
    proof: WithdrawalProof,
    finalized_root: String
) -> WithdrawalClaimResult {
    let target_root: String = (proof).withdrawal_root;
    let msg: WithdrawalMessage = (proof).message;

    if target_root != finalized_root {
        return WithdrawalClaimResult {
            is_claimable: false,
            withdrawal_id: (msg).withdrawal_id,
            amount: 0,
            recipient: (msg).l1_recipient,
        };
    }

    return WithdrawalClaimResult {
        is_claimable: true,
        withdrawal_id: (msg).withdrawal_id,
        amount: (msg).amount,
        recipient: (msg).l1_recipient,
    };
}
