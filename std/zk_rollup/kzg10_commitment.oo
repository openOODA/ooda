// # KZG10 Polynomial Commitment Scheme
//
// Logline: MSM commit + Horner open. Degree-3 four-coeff floor.
//
// Setup: Degree-3 poly in four coeff slots. G_i = i+1.
//
// Beats:
//   1. C_x = c0*1 + c1*2 + c2*3 + c3*4  (mod p).
//   2. p(z) by Horner: ((c3*z+c2)*z+c1)*z+c0.
//   3. Opening verifies y == p(z) and C_x matches MSM.

type Kzg10Poly = struct {
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int,
    prime_mod: Int
};

type Kzg10Commitment = struct {
    commitment_point_x: Int,
    commitment_point_y: Int,
    deg_bound: Int,
    is_valid: Int
};

type Kzg10OpeningProof = struct {
    eval_point_z: Int,
    eval_value_y: Int,
    quotient_point_x: Int,
    quotient_point_y: Int,
    is_valid: Int
};

type Kzg10VerifyResult = struct {
    is_verified: Int,
    pairing_equation_satisfied: Int,
    error_code: Int
};

fn kzg_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn kzg10_poly_new(c0: Int, c1: Int, c2: Int, c3: Int, p_mod: Int) -> Kzg10Poly {
    return Kzg10Poly {
        c0: c0,
        c1: c1,
        c2: c2,
        c3: c3,
        prime_mod: p_mod
    };
}

pub fn kzg10_commitment_new(px: Int, py: Int, deg: Int) -> Kzg10Commitment {
    return Kzg10Commitment {
        commitment_point_x: px,
        commitment_point_y: py,
        deg_bound: deg,
        is_valid: 1
    };
}

pub fn kzg10_opening_proof_new(z_val: Int, y_val: Int, qx: Int, qy: Int) -> Kzg10OpeningProof {
    return Kzg10OpeningProof {
        eval_point_z: z_val,
        eval_value_y: y_val,
        quotient_point_x: qx,
        quotient_point_y: qy,
        is_valid: 1
    };
}

pub fn kzg10_commit_polynomial(poly: Kzg10Poly) -> Kzg10Commitment {
    let p_mod: Int = poly.prime_mod;
    let sum_x: Int = kzg_mod_pos(poly.c0 * 1 + poly.c1 * 2 + poly.c2 * 3 + poly.c3 * 4, p_mod);
    return Kzg10Commitment {
        commitment_point_x: sum_x,
        commitment_point_y: kzg_mod_pos(sum_x * 2, p_mod),
        deg_bound: 3,
        is_valid: 1
    };
}

pub fn kzg10_eval_horner(poly: Kzg10Poly, z_val: Int) -> Int {
    let p_mod: Int = poly.prime_mod;
    let t3: Int = kzg_mod_pos(poly.c3 * z_val + poly.c2, p_mod);
    let t2: Int = kzg_mod_pos(t3 * z_val + poly.c1, p_mod);
    return kzg_mod_pos(t2 * z_val + poly.c0, p_mod);
}

pub fn kzg10_verify_opening(
    commit: Kzg10Commitment,
    proof: Kzg10OpeningProof,
    poly: Kzg10Poly
) -> Kzg10VerifyResult {
    if commit.is_valid == 0 {
        return Kzg10VerifyResult {
            is_verified: 0,
            pairing_equation_satisfied: 0,
            error_code: 1
        };
    }
    if proof.is_valid == 0 {
        return Kzg10VerifyResult {
            is_verified: 0,
            pairing_equation_satisfied: 0,
            error_code: 1
        };
    }
    let y_chk: Int = kzg10_eval_horner(poly, proof.eval_point_z);
    let c_chk: Kzg10Commitment = kzg10_commit_polynomial(poly);
    if y_chk != proof.eval_value_y {
        return Kzg10VerifyResult {
            is_verified: 0,
            pairing_equation_satisfied: 0,
            error_code: 2
        };
    }
    if c_chk.commitment_point_x != commit.commitment_point_x {
        return Kzg10VerifyResult {
            is_verified: 0,
            pairing_equation_satisfied: 0,
            error_code: 3
        };
    }
    return Kzg10VerifyResult {
        is_verified: 1,
        pairing_equation_satisfied: 1,
        error_code: 0
    };
}
