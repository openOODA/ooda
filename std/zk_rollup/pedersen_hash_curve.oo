// # Pedersen Hash on Elliptic Curves
//
// Logline: MSM vector hash acc += g_i * v_i (mod p). Four-slot Int floor.
//
// Setup: Generators g_i = (i+5, 3*(i+5)). Window size 4. Nested commit flattened.
//
// Beats:
//   1. Four generators (5,15),(6,18),(7,21),(8,24).
//   2. acc_x = Σ g_i.x * v_i ; acc_y = Σ g_i.y * v_i  (mod p).
//   3. compressed_x is acc_x; infinity is the (0,0) flag point.

type PedersenPoint = struct {
    x: Int,
    y: Int,
    is_infinity: Int
};

type PedersenGenerators = struct {
    g0x: Int,
    g0y: Int,
    g1x: Int,
    g1y: Int,
    g2x: Int,
    g2y: Int,
    g3x: Int,
    g3y: Int,
    window_size: Int,
    prime_mod: Int
};

type PedersenHashResult = struct {
    commit_x: Int,
    commit_y: Int,
    commit_inf: Int,
    compressed_x: Int,
    is_valid: Int
};

fn pedh_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn pedersen_point_new(px: Int, py: Int) -> PedersenPoint {
    return PedersenPoint {
        x: px,
        y: py,
        is_infinity: 0
    };
}

pub fn pedersen_point_infinity() -> PedersenPoint {
    return PedersenPoint {
        x: 0,
        y: 0,
        is_infinity: 1
    };
}

pub fn pedersen_generators_init(p_mod: Int) -> PedersenGenerators {
    return PedersenGenerators {
        g0x: 5,
        g0y: 15,
        g1x: 6,
        g1y: 18,
        g2x: 7,
        g2y: 21,
        g3x: 8,
        g3y: 24,
        window_size: 4,
        prime_mod: p_mod
    };
}

pub fn pedersen_hash_vector(
    gens: PedersenGenerators,
    v0: Int,
    v1: Int,
    v2: Int,
    v3: Int
) -> PedersenHashResult {
    let p_mod: Int = gens.prime_mod;
    let acc_x: Int = pedh_mod_pos(
        gens.g0x * v0 + gens.g1x * v1 + gens.g2x * v2 + gens.g3x * v3,
        p_mod
    );
    let acc_y: Int = pedh_mod_pos(
        gens.g0y * v0 + gens.g1y * v1 + gens.g2y * v2 + gens.g3y * v3,
        p_mod
    );
    return PedersenHashResult {
        commit_x: acc_x,
        commit_y: acc_y,
        commit_inf: 0,
        compressed_x: acc_x,
        is_valid: 1
    };
}
