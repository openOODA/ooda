// # Ed25519 Twisted Edwards Curve Arithmetic
//
// Logline: Complete add floor + [s]B = R + [h]A. By-value Int floor.
//
// Setup: Extended (X,Y,Z,T) stored; add uses affine numerator floor.
//
// Beats:
//   1. x3 = x1*y2 + y1*x2 ; y3 = y1*y2 + x1*x2  (mod p).
//   2. Double-and-add scalar mul.
//   3. Verify checks s*B against R + h*A.

type EdwardsPoint = struct {
    x_val: Int,
    y_val: Int,
    z_val: Int,
    t_val: Int
};

type EdwardsCurveParams = struct {
    d_coeff: Int,
    prime_mod: Int
};

type Ed25519VerifyResult = struct {
    is_valid: Int,
    lhs_x: Int,
    rhs_x: Int
};

fn edw_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn edwards_params_ed25519() -> EdwardsCurveParams {
    return EdwardsCurveParams {
        d_coeff: 370957059,
        prime_mod: 1009
    };
}

pub fn edwards_point_identity() -> EdwardsPoint {
    return EdwardsPoint {
        x_val: 0,
        y_val: 1,
        z_val: 1,
        t_val: 0
    };
}

pub fn edwards_point_base() -> EdwardsPoint {
    return EdwardsPoint {
        x_val: 1,
        y_val: 2,
        z_val: 1,
        t_val: 2
    };
}

pub fn edwards_point_new(x: Int, y: Int, z: Int, t: Int) -> EdwardsPoint {
    return EdwardsPoint {
        x_val: x,
        y_val: y,
        z_val: z,
        t_val: t
    };
}

pub fn edwards_add(
    p1: EdwardsPoint,
    p2: EdwardsPoint,
    params: EdwardsCurveParams
) -> EdwardsPoint {
    let p_mod: Int = params.prime_mod;
    let x3: Int = edw_mod_pos((p1.x_val * p2.y_val) + (p1.y_val * p2.x_val), p_mod);
    let y3: Int = edw_mod_pos((p1.y_val * p2.y_val) + (p1.x_val * p2.x_val), p_mod);
    return EdwardsPoint {
        x_val: x3,
        y_val: y3,
        z_val: 1,
        t_val: edw_mod_pos(x3 * y3, p_mod)
    };
}

pub fn edwards_scalar_mul(
    pt: EdwardsPoint,
    scalar: Int,
    params: EdwardsCurveParams
) -> EdwardsPoint {
    if scalar <= 1 {
        return pt;
    }
    let half: EdwardsPoint = edwards_scalar_mul(pt, scalar / 2, params);
    let doubled: EdwardsPoint = edwards_add(half, half, params);
    if (scalar % 2) == 1 {
        return edwards_add(doubled, pt, params);
    }
    return doubled;
}

pub fn ed25519_verify_signature(
    pk_point: EdwardsPoint,
    msg_hash: Int,
    sig_r: EdwardsPoint,
    sig_s: Int,
    params: EdwardsCurveParams
) -> Ed25519VerifyResult {
    let base: EdwardsPoint = edwards_point_base();
    let lhs: EdwardsPoint = edwards_scalar_mul(base, sig_s, params);
    let h_a: EdwardsPoint = edwards_scalar_mul(pk_point, msg_hash, params);
    let rhs: EdwardsPoint = edwards_add(sig_r, h_a, params);
    if lhs.x_val == rhs.x_val {
        if lhs.y_val == rhs.y_val {
            return Ed25519VerifyResult {
                is_valid: 1,
                lhs_x: lhs.x_val,
                rhs_x: rhs.x_val
            };
        }
    }
    return Ed25519VerifyResult {
        is_valid: 0,
        lhs_x: lhs.x_val,
        rhs_x: rhs.x_val
    };
}
