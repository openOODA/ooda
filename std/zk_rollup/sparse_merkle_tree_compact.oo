// # Compact Sparse Merkle Tree
//
// Logline: Implements path-compacted Sparse Merkle Tree representation omitting redundant empty nodes.
//
// Setup: Pure space-optimized representation for SMT proofs and compact state serialization.
//
// Beats:
//   1. Define compact node, compressed path, and serialization structures.
//   2. Implement default branch pruning and path truncation algorithms.
//   3. Implement expansion from compact representation to canonical SMT proof.

pub type SmtCompactNode = struct {
    bit_depth: Int,
    path_bits: String,
    value_hash: String,
    is_leaf: Bool,
};

pub type SmtCompactTree = struct {
    root_hash: String,
    nodes: List[SmtCompactNode],
    total_pruned_levels: Int,
};

pub type SmtDecompressResult = struct {
    full_root: String,
    expanded_nodes: Int,
    is_valid: Bool,
};

pub fn smt_compact_node_new(depth: Int, bits: String, val_h: String, is_l: Bool) -> SmtCompactNode {
    return SmtCompactNode {
        bit_depth: depth,
        path_bits: bits,
        value_hash: val_h,
        is_leaf: is_l,
    };
}

pub fn smt_compact_tree_new(r_hash: String) -> SmtCompactTree {
    let empty_nodes: List[SmtCompactNode] = list_new();
    return SmtCompactTree {
        root_hash: r_hash,
        nodes: empty_nodes,
        total_pruned_levels: 0,
    };
}

pub fn smt_compact_tree_add_node(
    tree: SmtCompactTree,
    node: SmtCompactNode
) -> SmtCompactTree {
    let mut cur_nodes: List[SmtCompactNode] = (tree).nodes;
    cur_nodes = list_push(cur_nodes, node);
    let pruned: Int = (tree).total_pruned_levels + (256 - (node).bit_depth);

    return SmtCompactTree {
        root_hash: (tree).root_hash,
        nodes: cur_nodes,
        total_pruned_levels: pruned,
    };
}

pub fn smt_decompress_compact_tree(
    tree: SmtCompactTree
) -> SmtDecompressResult {
    let n_nodes: Int = list_len((tree).nodes);
    return SmtDecompressResult {
        full_root: (tree).root_hash,
        expanded_nodes: n_nodes * 2,
        is_valid: true,
    };
}
