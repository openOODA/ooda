// # MiMC Block Cipher & Sponge Permutation
//
// Logline: S-box x^7; round (x+k+c_i)^7; 2-to-1 sponge. Four-round floor.
//
// Setup: Four round constants c_i = (i*37+11) mod p. Exponent 7.
//
// Beats:
//   1. Cube x^2*x; deg7 x^6*x via x2,x4,x6.
//   2. Encrypt round: (current + key + c_round)^7.
//   3. Hash2: n_rounds then add left+right.

type MimcParams = struct {
    n_rounds: Int,
    exponent: Int,
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int,
    prime_mod: Int
};

type MimcState = struct {
    current_val: Int,
    round: Int
};

fn mimc_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

fn mimc_clamp_rounds(rounds: Int) -> Int {
    if rounds < 1 {
        return 1;
    }
    if rounds > 4 {
        return 4;
    }
    return rounds;
}

pub fn mimc_params_default(rounds: Int, p_mod: Int) -> MimcParams {
    return MimcParams {
        n_rounds: mimc_clamp_rounds(rounds),
        exponent: 7,
        c0: mimc_mod_pos(11, p_mod),
        c1: mimc_mod_pos(48, p_mod),
        c2: mimc_mod_pos(85, p_mod),
        c3: mimc_mod_pos(122, p_mod),
        prime_mod: p_mod
    };
}

pub fn mimc_sbox_cube(x_in: Int, p_mod: Int) -> Int {
    let x: Int = mimc_mod_pos(x_in, p_mod);
    let x2: Int = mimc_mod_pos(x * x, p_mod);
    return mimc_mod_pos(x2 * x, p_mod);
}

pub fn mimc_sbox_deg7(x_in: Int, p_mod: Int) -> Int {
    let x: Int = mimc_mod_pos(x_in, p_mod);
    let x2: Int = mimc_mod_pos(x * x, p_mod);
    let x4: Int = mimc_mod_pos(x2 * x2, p_mod);
    let x6: Int = mimc_mod_pos(x4 * x2, p_mod);
    return mimc_mod_pos(x6 * x, p_mod);
}

fn mimc_round_const(params: MimcParams, r: Int) -> Int {
    if r == 0 {
        return params.c0;
    }
    if r == 1 {
        return params.c1;
    }
    if r == 2 {
        return params.c2;
    }
    return params.c3;
}

pub fn mimc_encrypt_round(
    st: MimcState,
    key_val: Int,
    params: MimcParams
) -> MimcState {
    let p_mod: Int = params.prime_mod;
    let c_i: Int = mimc_round_const(params, st.round);
    let sum_val: Int = mimc_mod_pos(st.current_val + key_val + c_i, p_mod);
    return MimcState {
        current_val: mimc_sbox_deg7(sum_val, p_mod),
        round: st.round + 1
    };
}

fn mimc_run(
    st: MimcState,
    key_val: Int,
    params: MimcParams,
    left_val: Int
) -> Int {
    if st.round >= params.n_rounds {
        return mimc_mod_pos(st.current_val + left_val + key_val, params.prime_mod);
    }
    return mimc_run(mimc_encrypt_round(st, key_val, params), key_val, params, left_val);
}

pub fn mimc_hash_2(
    left_val: Int,
    right_val: Int,
    params: MimcParams
) -> Int {
    let st0: MimcState = MimcState {
        current_val: left_val,
        round: 0
    };
    return mimc_run(st0, right_val, params, left_val);
}
