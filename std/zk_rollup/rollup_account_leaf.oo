// # Rollup Account Leaf Schema
//
// Logline: Deposit adds; debit subtracts amount+fee and bumps nonce. Int floor.
//
// Setup: Strings flattened to Int slots. Empty storage/code = 0. Hash mix(px,py,sr).
//
// Beats:
//   1. New leaf: nonce=0, storage_root=0, code_hash=0.
//   2. Hash is mix(mix(px, py), storage_root) with mix(a,b)=131a+b+17.
//   3. Debit fails (is_success=0) when balance < amount+fee.

type RollupAccountLeaf = struct {
    account_index: Int,
    nonce: Int,
    balance: Int,
    storage_root: Int,
    code_hash: Int,
    pubkey_x: Int,
    pubkey_y: Int
};

type AccountUpdateResult = struct {
    account_index: Int,
    nonce: Int,
    balance: Int,
    storage_root: Int,
    code_hash: Int,
    pubkey_x: Int,
    pubkey_y: Int,
    leaf_hash: Int,
    is_success: Int
};

fn rleaf_pack(acc: RollupAccountLeaf, h: Int, ok: Int) -> AccountUpdateResult {
    return AccountUpdateResult {
        account_index: acc.account_index,
        nonce: acc.nonce,
        balance: acc.balance,
        storage_root: acc.storage_root,
        code_hash: acc.code_hash,
        pubkey_x: acc.pubkey_x,
        pubkey_y: acc.pubkey_y,
        leaf_hash: h,
        is_success: ok
    };
}

fn rleaf_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn rollup_account_leaf_new(
    idx: Int,
    bal: Int,
    px: Int,
    py: Int
) -> RollupAccountLeaf {
    return RollupAccountLeaf {
        account_index: idx,
        nonce: 0,
        balance: bal,
        storage_root: 0,
        code_hash: 0,
        pubkey_x: px,
        pubkey_y: py
    };
}

pub fn rollup_account_compute_hash(acc: RollupAccountLeaf) -> Int {
    return rleaf_mix(rleaf_mix(acc.pubkey_x, acc.pubkey_y), acc.storage_root);
}

pub fn rollup_account_deposit(
    acc: RollupAccountLeaf,
    amount: Int
) -> AccountUpdateResult {
    let updated: RollupAccountLeaf = RollupAccountLeaf {
        account_index: acc.account_index,
        nonce: acc.nonce,
        balance: acc.balance + amount,
        storage_root: acc.storage_root,
        code_hash: acc.code_hash,
        pubkey_x: acc.pubkey_x,
        pubkey_y: acc.pubkey_y
    };
    return rleaf_pack(updated, rollup_account_compute_hash(updated), 1);
}

pub fn rollup_account_debit(
    acc: RollupAccountLeaf,
    amount: Int,
    fee: Int
) -> AccountUpdateResult {
    let total_sub: Int = amount + fee;
    let cur_bal: Int = acc.balance;
    if cur_bal < total_sub {
        return rleaf_pack(acc, rollup_account_compute_hash(acc), 0);
    }
    let updated: RollupAccountLeaf = RollupAccountLeaf {
        account_index: acc.account_index,
        nonce: acc.nonce + 1,
        balance: cur_bal - total_sub,
        storage_root: acc.storage_root,
        code_hash: acc.code_hash,
        pubkey_x: acc.pubkey_x,
        pubkey_y: acc.pubkey_y
    };
    return rleaf_pack(updated, rollup_account_compute_hash(updated), 1);
}
