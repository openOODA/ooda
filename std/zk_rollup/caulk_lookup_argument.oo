// # Caulk Subvector Lookup Argument
//
// Logline: Z_I(X) = (X-ω^{i0})(X-ω^{i1}). Int commit floor.
//
// Setup: Two-index vanishing on the multiplicative subgroup generated by omega.
//
// Beats:
//   1. Table bind commit_c = n_table * omega.
//   2. eval_v must equal Z_I(challenge).
//   3. Empty sub_commit rejects.

type CaulkTableCommitment = struct {
    n_table: Int,
    commit_c: Int,
    omega: Int
};

type CaulkProof = struct {
    sub_commit: Int,
    quot_commit: Int,
    eval_v: Int,
    idx0: Int,
    idx1: Int
};

type CaulkVerifyResult = struct {
    is_valid: Int,
    n_lookup: Int,
    vanish_eval: Int
};

fn caulk_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

fn caulk_pow_mod(base: Int, exp: Int, p_mod: Int) -> Int {
    if exp == 0 {
        return 1;
    }
    let half: Int = caulk_pow_mod(base, exp / 2, p_mod);
    let sq: Int = caulk_mod_pos(half * half, p_mod);
    if (exp % 2) == 1 {
        return caulk_mod_pos(sq * base, p_mod);
    }
    return sq;
}

pub fn caulk_table_commitment_new(sz: Int, omega: Int) -> CaulkTableCommitment {
    return CaulkTableCommitment {
        n_table: sz,
        commit_c: sz * omega,
        omega: omega
    };
}

pub fn caulk_proof_new(
    sub_c: Int,
    q_c: Int,
    v_val: Int,
    idx0: Int,
    idx1: Int
) -> CaulkProof {
    return CaulkProof {
        sub_commit: sub_c,
        quot_commit: q_c,
        eval_v: v_val,
        idx0: idx0,
        idx1: idx1
    };
}

pub fn caulk_vanish_eval(
    challenge: Int,
    omega: Int,
    idx0: Int,
    idx1: Int,
    p_mod: Int
) -> Int {
    let w0: Int = caulk_pow_mod(omega, idx0, p_mod);
    let w1: Int = caulk_pow_mod(omega, idx1, p_mod);
    return caulk_mod_pos((challenge - w0) * (challenge - w1), p_mod);
}

pub fn caulk_verify(
    table_commit: CaulkTableCommitment,
    proof: CaulkProof,
    challenge: Int,
    p_mod: Int
) -> CaulkVerifyResult {
    if proof.sub_commit == 0 {
        return CaulkVerifyResult {
            is_valid: 0,
            n_lookup: 0,
            vanish_eval: 0
        };
    }
    let z_i: Int = caulk_vanish_eval(challenge, table_commit.omega, proof.idx0, proof.idx1, p_mod);
    if proof.eval_v != z_i {
        return CaulkVerifyResult {
            is_valid: 0,
            n_lookup: 2,
            vanish_eval: z_i
        };
    }
    return CaulkVerifyResult {
        is_valid: 1,
        n_lookup: 2,
        vanish_eval: z_i
    };
}
