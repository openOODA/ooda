// # PLONK Gate Selectors & Custom Gates
//
// Logline: q_L*a + q_R*b + q_O*c + q_M*(a*b) + q_C ≡ 0 (mod p). Int floor.
//
// Setup: Selector vector (q_L, q_R, q_O, q_M, q_C). Add / mul / const presets.
//
// Beats:
//   1. Add: q_L=1 q_R=1 q_O=p-1. Mul: q_M=1 q_O=p-1. Const: q_L=1 q_C=p-c.
//   2. Residual is the linear combination reduced mod p.
//   3. Satisfied iff residual == 0.

type PlonkGateSelectors = struct {
    q_l: Int,
    q_r: Int,
    q_o: Int,
    q_m: Int,
    q_c: Int
};

type PlonkGateWires = struct {
    wire_a: Int,
    wire_b: Int,
    wire_c: Int
};

type GateEvaluationResult = struct {
    residual: Int,
    is_satisfied: Int
};

fn pgate_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn plonk_gate_selectors_arithmetic_add(p_mod: Int) -> PlonkGateSelectors {
    return PlonkGateSelectors {
        q_l: 1,
        q_r: 1,
        q_o: p_mod - 1,
        q_m: 0,
        q_c: 0
    };
}

pub fn plonk_gate_selectors_arithmetic_mul(p_mod: Int) -> PlonkGateSelectors {
    return PlonkGateSelectors {
        q_l: 0,
        q_r: 0,
        q_o: p_mod - 1,
        q_m: 1,
        q_c: 0
    };
}

pub fn plonk_gate_selectors_constant(const_val: Int, p_mod: Int) -> PlonkGateSelectors {
    return PlonkGateSelectors {
        q_l: 1,
        q_r: 0,
        q_o: 0,
        q_m: 0,
        q_c: pgate_mod_pos(p_mod - const_val, p_mod)
    };
}

pub fn plonk_gate_wires_new(a: Int, b: Int, c: Int) -> PlonkGateWires {
    return PlonkGateWires {
        wire_a: a,
        wire_b: b,
        wire_c: c
    };
}

pub fn plonk_evaluate_gate(
    sel: PlonkGateSelectors,
    wires: PlonkGateWires,
    p_mod: Int
) -> GateEvaluationResult {
    let a: Int = wires.wire_a;
    let b: Int = wires.wire_b;
    let c: Int = wires.wire_c;
    let term_l: Int = pgate_mod_pos(sel.q_l * a, p_mod);
    let term_r: Int = pgate_mod_pos(sel.q_r * b, p_mod);
    let term_o: Int = pgate_mod_pos(sel.q_o * c, p_mod);
    let term_m: Int = pgate_mod_pos((sel.q_m * a) * b, p_mod);
    let term_c: Int = pgate_mod_pos(sel.q_c, p_mod);
    let res: Int = pgate_mod_pos(term_l + term_r + term_o + term_m + term_c, p_mod);
    if res == 0 {
        return GateEvaluationResult {
            residual: 0,
            is_satisfied: 1
        };
    }
    return GateEvaluationResult {
        residual: res,
        is_satisfied: 0
    };
}
