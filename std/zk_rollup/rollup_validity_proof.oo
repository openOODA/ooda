// # Rollup ZK Validity Proof Verification
//
// Logline: Bind pre/post/batch; accept iff pre matches and format ok. Int floor.
//
// Setup: Hex strings flattened to Int. Digest mix(mix(pre,post),data).
//
// Beats:
//   1. Digest = mix(mix(pre, post), batch) with mix(a,b)=131a+b+17.
//   2. Pre-root mismatch → reject, new_state_root stays expected.
//   3. Malformed envelope (format=0) → reject.

type ValidityProofEnvelope = struct {
    proof_system_tag: Int,
    pre_state_root: Int,
    post_state_root: Int,
    batch_data_hash: Int,
    proof_bytes_hex: Int,
    public_inputs_digest: Int,
    is_valid_format: Int
};

type ValidityVerifyResult = struct {
    is_accepted: Int,
    new_state_root: Int,
    error_message: Int
};

fn rval_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn validity_proof_envelope_new(
    system_tag: Int,
    pre_root: Int,
    post_root: Int,
    data_hash: Int,
    proof_hex: Int
) -> ValidityProofEnvelope {
    return ValidityProofEnvelope {
        proof_system_tag: system_tag,
        pre_state_root: pre_root,
        post_state_root: post_root,
        batch_data_hash: data_hash,
        proof_bytes_hex: proof_hex,
        public_inputs_digest: rval_mix(rval_mix(pre_root, post_root), data_hash),
        is_valid_format: 1
    };
}

pub fn validity_verify_batch_proof(
    envelope: ValidityProofEnvelope,
    expected_pre_root: Int
) -> ValidityVerifyResult {
    if envelope.pre_state_root != expected_pre_root {
        return ValidityVerifyResult {
            is_accepted: 0,
            new_state_root: expected_pre_root,
            error_message: 1
        };
    }
    if envelope.is_valid_format == 0 {
        return ValidityVerifyResult {
            is_accepted: 0,
            new_state_root: expected_pre_root,
            error_message: 2
        };
    }
    return ValidityVerifyResult {
        is_accepted: 1,
        new_state_root: envelope.post_state_root,
        error_message: 0
    };
}
