// # Rollup Batch Sequencer
//
// Logline: Seal header + four tx hashes; commit mix(tag, n, post). Int floor.
//
// Setup: Strings → Int. Nested header flattened into the proposal. No List.
//
// Beats:
//   1. New header gas_limit=30000000, gas_used=21000.
//   2. Seal copies header slots, writes h0..h3, is_sealed=1.
//   3. Commitment mix(mix(tag, batch_number), post) with tag=1 iff n>0.

type RollupBatchHeader = struct {
    batch_number: Int,
    sequencer_address: Int,
    tx_root: Int,
    pre_state_root: Int,
    post_state_root: Int,
    timestamp: Int,
    gas_limit: Int,
    gas_used: Int
};

type RollupBatchProposal = struct {
    batch_number: Int,
    sequencer_address: Int,
    tx_root: Int,
    pre_state_root: Int,
    post_state_root: Int,
    timestamp: Int,
    gas_limit: Int,
    gas_used: Int,
    h0: Int,
    h1: Int,
    h2: Int,
    h3: Int,
    batch_signature: Int,
    is_sealed: Int
};

fn rseq_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn rollup_batch_header_new(
    b_num: Int,
    seq_addr: Int,
    pre_root: Int,
    post_root: Int,
    tx_r: Int,
    ts: Int
) -> RollupBatchHeader {
    return RollupBatchHeader {
        batch_number: b_num,
        sequencer_address: seq_addr,
        tx_root: tx_r,
        pre_state_root: pre_root,
        post_state_root: post_root,
        timestamp: ts,
        gas_limit: 30000000,
        gas_used: 21000
    };
}

pub fn rollup_seal_batch(
    hdr: RollupBatchHeader,
    h0: Int,
    h1: Int,
    h2: Int,
    h3: Int,
    sig: Int
) -> RollupBatchProposal {
    return RollupBatchProposal {
        batch_number: hdr.batch_number,
        sequencer_address: hdr.sequencer_address,
        tx_root: hdr.tx_root,
        pre_state_root: hdr.pre_state_root,
        post_state_root: hdr.post_state_root,
        timestamp: hdr.timestamp,
        gas_limit: hdr.gas_limit,
        gas_used: hdr.gas_used,
        h0: h0,
        h1: h1,
        h2: h2,
        h3: h3,
        batch_signature: sig,
        is_sealed: 1
    };
}

pub fn rollup_compute_batch_commitment(proposal: RollupBatchProposal) -> Int {
    if proposal.batch_number > 0 {
        return rseq_mix(rseq_mix(1, proposal.batch_number), proposal.post_state_root);
    }
    return rseq_mix(rseq_mix(0, proposal.batch_number), proposal.post_state_root);
}
