// # PLONK Verifier Protocol
//
// Logline: lin = (a + b + Σ PI) mod 1009; reject if proof invalid. Int floor.
//
// Setup: Commit strings → Int. Four public-input slots. details is 0/1.
//
// Beats:
//   1. VK domain_size kept; selector/sigma commits are 1..8.
//   2. is_valid=0 → is_verified=0, lin=0.
//   3. Else linearization is (a_eval + b_eval + pi0+pi1+pi2+pi3) % 1009.

type PlonkVerifyingKey = struct {
    domain_size: Int,
    q_l_commit: Int,
    q_r_commit: Int,
    q_o_commit: Int,
    q_m_commit: Int,
    q_c_commit: Int,
    sigma_1_commit: Int,
    sigma_2_commit: Int,
    sigma_3_commit: Int
};

type PlonkProof = struct {
    a_commit: Int,
    b_commit: Int,
    c_commit: Int,
    z_commit: Int,
    t_lo_commit: Int,
    t_mid_commit: Int,
    t_hi_commit: Int,
    w_zeta_commit: Int,
    w_zeta_omega_commit: Int,
    a_eval: Int,
    b_eval: Int,
    c_eval: Int,
    sigma_1_eval: Int,
    sigma_2_eval: Int,
    z_omega_eval: Int,
    is_valid: Int
};

type PlonkVerificationOutcome = struct {
    is_verified: Int,
    linearization_eval: Int,
    details: Int
};

pub fn plonk_verifying_key_new(n_dom: Int) -> PlonkVerifyingKey {
    return PlonkVerifyingKey {
        domain_size: n_dom,
        q_l_commit: 1,
        q_r_commit: 2,
        q_o_commit: 3,
        q_m_commit: 4,
        q_c_commit: 5,
        sigma_1_commit: 6,
        sigma_2_commit: 7,
        sigma_3_commit: 8
    };
}

pub fn plonk_proof_new(a_ev: Int, b_ev: Int, c_ev: Int, valid: Int) -> PlonkProof {
    return PlonkProof {
        a_commit: 0,
        b_commit: 0,
        c_commit: 0,
        z_commit: 0,
        t_lo_commit: 0,
        t_mid_commit: 0,
        t_hi_commit: 0,
        w_zeta_commit: 0,
        w_zeta_omega_commit: 0,
        a_eval: a_ev,
        b_eval: b_ev,
        c_eval: c_ev,
        sigma_1_eval: 0,
        sigma_2_eval: 0,
        z_omega_eval: 0,
        is_valid: valid
    };
}

pub fn plonk_verify_proof(
    vk: PlonkVerifyingKey,
    proof: PlonkProof,
    pi0: Int,
    pi1: Int,
    pi2: Int,
    pi3: Int
) -> PlonkVerificationOutcome {
    if proof.is_valid == 0 {
        return PlonkVerificationOutcome {
            is_verified: 0,
            linearization_eval: 0,
            details: 0
        };
    }
    let pi_sum: Int = pi0 + pi1 + pi2 + pi3;
    let lin_eval: Int = (proof.a_eval + proof.b_eval + pi_sum) % 1009;
    return PlonkVerificationOutcome {
        is_verified: 1,
        linearization_eval: lin_eval,
        details: vk.domain_size
    };
}
