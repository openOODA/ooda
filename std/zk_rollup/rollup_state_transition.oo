// # Rollup State Transition Function
//
// Logline: post = mix(mix(pre, from), to) per tx; fees sum. Two-tx Int floor.
//
// Setup: Account/sig strings → Int. List[tx] destubbed to tx0, tx1 + n_tx.
//
// Beats:
//   1. mix(a,b) = 131a + b + 17.
//   2. n_tx=0 keeps pre; n_tx=1 applies tx0; n_tx>=2 applies tx0 then tx1.
//   3. total_fees is the sum of applied fees. is_valid=1.

type RollupTx = struct {
    sender_account: Int,
    receiver_account: Int,
    amount: Int,
    nonce: Int,
    fee: Int,
    signature_r: Int,
    signature_s: Int
};

type RollupStateTransition = struct {
    pre_state_root: Int,
    post_state_root: Int,
    batch_index: Int,
    n_tx: Int,
    total_fees: Int,
    is_valid: Int
};

fn rstx_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn rollup_tx_new(
    from_acc: Int,
    to_acc: Int,
    amt: Int,
    seq_nonce: Int,
    tx_fee: Int
) -> RollupTx {
    return RollupTx {
        sender_account: from_acc,
        receiver_account: to_acc,
        amount: amt,
        nonce: seq_nonce,
        fee: tx_fee,
        signature_r: 0,
        signature_s: 0
    };
}

pub fn rollup_apply_single_tx(current_root: Int, tx: RollupTx) -> Int {
    return rstx_mix(rstx_mix(current_root, tx.sender_account), tx.receiver_account);
}

pub fn rollup_execute_transition(
    pre_root: Int,
    tx0: RollupTx,
    tx1: RollupTx,
    n_tx: Int,
    b_idx: Int
) -> RollupStateTransition {
    if n_tx <= 0 {
        return RollupStateTransition {
            pre_state_root: pre_root,
            post_state_root: pre_root,
            batch_index: b_idx,
            n_tx: 0,
            total_fees: 0,
            is_valid: 1
        };
    }
    let root1: Int = rollup_apply_single_tx(pre_root, tx0);
    if n_tx == 1 {
        return RollupStateTransition {
            pre_state_root: pre_root,
            post_state_root: root1,
            batch_index: b_idx,
            n_tx: 1,
            total_fees: tx0.fee,
            is_valid: 1
        };
    }
    let root2: Int = rollup_apply_single_tx(root1, tx1);
    return RollupStateTransition {
        pre_state_root: pre_root,
        post_state_root: root2,
        batch_index: b_idx,
        n_tx: 2,
        total_fees: tx0.fee + tx1.fee,
        is_valid: 1
    };
}
