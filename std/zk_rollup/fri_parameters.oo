// # FRI Protocol Parameters & Domain Config
//
// Logline: Blowup, folding, query rounds, LDE size. Destubbed off pub type / let mut.
//
// Setup: Int parameters. layers = log2(lde / stopping_degree).
//
// Beats:
//   1. 100-bit preset: blowup 4, queries 40.
//   2. 128-bit preset: blowup 8, queries 50.
//   3. LDE size = trace * blowup; layers while cur > stopping.

type FriParameters = struct {
    blowup_factor: Int,
    folding_factor: Int,
    num_query_rounds: Int,
    stopping_degree: Int,
    prime_modulus: Int,
    target_security_bits: Int
};

type FriDomainConfig = struct {
    trace_length: Int,
    lde_domain_size: Int,
    num_fri_layers: Int,
    is_valid: Int
};

pub fn fri_parameters_100_bits(p_mod: Int) -> FriParameters {
    return FriParameters {
        blowup_factor: 4,
        folding_factor: 2,
        num_query_rounds: 40,
        stopping_degree: 1,
        prime_modulus: p_mod,
        target_security_bits: 100
    };
}

pub fn fri_parameters_128_bits(p_mod: Int) -> FriParameters {
    return FriParameters {
        blowup_factor: 8,
        folding_factor: 2,
        num_query_rounds: 50,
        stopping_degree: 1,
        prime_modulus: p_mod,
        target_security_bits: 128
    };
}

fn fri_layers(lde_size: Int, stop: Int) -> Int {
    if lde_size <= stop {
        return 0;
    }
    return 1 + fri_layers(lde_size / 2, stop);
}

pub fn fri_compute_domain_config(params: FriParameters, trace_len: Int) -> FriDomainConfig {
    let blowup: Int = params.blowup_factor;
    let lde_size: Int = trace_len * blowup;
    let layers: Int = fri_layers(lde_size, params.stopping_degree);
    return FriDomainConfig {
        trace_length: trace_len,
        lde_domain_size: lde_size,
        num_fri_layers: layers,
        is_valid: 1
    };
}
