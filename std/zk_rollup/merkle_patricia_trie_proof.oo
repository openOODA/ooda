// # Merkle Patricia Trie Proof Verification
//
// Logline: Inclusion rejects empty root+path; exclusion needs flag. Four sibs.
//
// Setup: Four sibling slots. proof_depth = n_sibs.
//
// Beats:
//   1. Inclusion: n_sibs==0 and root==0 => error 1.
//   2. Else inclusion valid; resolved = expected value.
//   3. Exclusion: flag 0 => error 2; else valid resolved 0.

type MptProofNode = struct {
    node_hash: Int,
    raw_payload: Int,
    level: Int
};

type MptProof = struct {
    root_hash: Int,
    key_hex: Int,
    expected_value_hex: Int,
    sib0: Int,
    sib1: Int,
    sib2: Int,
    sib3: Int,
    n_sibs: Int,
    is_exclusion_proof: Int
};

type MptProofVerifyResult = struct {
    is_valid: Int,
    error_code: Int,
    resolved_value: Int,
    proof_depth: Int
};

pub fn mpt_proof_node_new(h_val: Int, payload_val: Int, lvl: Int) -> MptProofNode {
    return MptProofNode {
        node_hash: h_val,
        raw_payload: payload_val,
        level: lvl
    };
}

pub fn mpt_proof_init(
    r_hash: Int,
    k_hex: Int,
    val_hex: Int,
    is_excl: Int
) -> MptProof {
    return MptProof {
        root_hash: r_hash,
        key_hex: k_hex,
        expected_value_hex: val_hex,
        sib0: 0,
        sib1: 0,
        sib2: 0,
        sib3: 0,
        n_sibs: 0,
        is_exclusion_proof: is_excl
    };
}

pub fn mpt_proof_with_sibs(
    r_hash: Int,
    k_hex: Int,
    val_hex: Int,
    is_excl: Int,
    s0: Int,
    s1: Int,
    s2: Int,
    s3: Int,
    n_s: Int
) -> MptProof {
    return MptProof {
        root_hash: r_hash,
        key_hex: k_hex,
        expected_value_hex: val_hex,
        sib0: s0,
        sib1: s1,
        sib2: s2,
        sib3: s3,
        n_sibs: n_s,
        is_exclusion_proof: is_excl
    };
}

pub fn mpt_proof_verify_inclusion(proof: MptProof) -> MptProofVerifyResult {
    if proof.n_sibs == 0 {
        if proof.root_hash == 0 {
            return MptProofVerifyResult {
                is_valid: 0,
                error_code: 1,
                resolved_value: 0,
                proof_depth: 0
            };
        }
    }
    return MptProofVerifyResult {
        is_valid: 1,
        error_code: 0,
        resolved_value: proof.expected_value_hex,
        proof_depth: proof.n_sibs
    };
}

pub fn mpt_proof_verify_exclusion(proof: MptProof) -> MptProofVerifyResult {
    if proof.is_exclusion_proof == 0 {
        return MptProofVerifyResult {
            is_valid: 0,
            error_code: 2,
            resolved_value: 0,
            proof_depth: 0
        };
    }
    return MptProofVerifyResult {
        is_valid: 1,
        error_code: 0,
        resolved_value: 0,
        proof_depth: proof.n_sibs
    };
}
