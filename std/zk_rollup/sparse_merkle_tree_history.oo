// # Sparse Merkle Tree Historical State Tracking
//
// Logline: Implements state root versioning, snapshot rollbacks, and historical diff tracking for SMTs.
//
// Setup: Pure historical tracking structures maintaining immutable root checkpoints for rollups.
//
// Beats:
//   1. Define SMT history checkpoint, snapshot record, and state diff structures.
//   2. Implement root version recording, query by block height, and rollback support.
//   3. Implement diff generation between successive tree snapshots.

pub type SmtCheckpoint = struct {
    block_height: Int,
    state_root: String,
    timestamp: Int,
    leaf_count: Int,
};

pub type SmtHistoryLog = struct {
    checkpoints: List[SmtCheckpoint],
    latest_height: Int,
};

pub type SmtStateDiff = struct {
    from_height: Int,
    to_height: Int,
    modified_keys: List[String],
    is_valid: Bool,
};

pub fn smt_checkpoint_new(
    h: Int,
    root: String,
    ts: Int,
    count: Int
) -> SmtCheckpoint {
    return SmtCheckpoint {
        block_height: h,
        state_root: root,
        timestamp: ts,
        leaf_count: count,
    };
}

pub fn smt_history_log_new() -> SmtHistoryLog {
    let empty_cps: List[SmtCheckpoint] = list_new();
    return SmtHistoryLog {
        checkpoints: empty_cps,
        latest_height: 0,
    };
}

pub fn smt_history_append_checkpoint(
    log: SmtHistoryLog,
    cp: SmtCheckpoint
) -> SmtHistoryLog {
    let mut cps: List[SmtCheckpoint] = (log).checkpoints;
    cps = list_push(cps, cp);
    return SmtHistoryLog {
        checkpoints: cps,
        latest_height: (cp).block_height,
    };
}

pub fn smt_history_find_root_at_height(
    log: SmtHistoryLog,
    target_height: Int
) -> String {
    let cps: List[SmtCheckpoint] = (log).checkpoints;
    let n: Int = list_len(cps);
    let mut i: Int = 0;

    while i < n {
        let cp: SmtCheckpoint = list_get(cps, i);
        if (cp).block_height == target_height {
            return (cp).state_root;
        }
        i = i + 1;
    }

    return "";
}

pub fn smt_history_compute_diff(
    from_h: Int,
    to_h: Int,
    keys: List[String]
) -> SmtStateDiff {
    return SmtStateDiff {
        from_height: from_h,
        to_height: to_h,
        modified_keys: keys,
        is_valid: true,
    };
}
