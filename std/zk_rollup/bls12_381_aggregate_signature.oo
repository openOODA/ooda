// # BLS12-381 Aggregate Signature Verification
//
// Logline: sigma_agg = sum sigma_i in G1. Two-signature Int-slot floor.
//
// Setup: Two G1 signatures flattened to four Int slots.
//
// Beats:
//   1. Aggregate x,y by modular sum.
//   2. Verify fails when n_signers != n_pks.
//   3. Pairing-matched floor when counts agree.

type BlsG1Point = struct {
    x: Int,
    y: Int,
    is_identity: Int
};

type BlsG2Point = struct {
    x_c0: Int,
    x_c1: Int,
    y_c0: Int,
    y_c1: Int,
    is_identity: Int
};

type BlsAggregateSignature = struct {
    agg_x: Int,
    agg_y: Int,
    n_signers: Int,
    is_valid: Int
};

type BlsAggregateVerifyResult = struct {
    is_verified: Int,
    n_signers: Int,
    pairing_matched: Int
};

fn bls_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn bls_g1_point_new(px: Int, py: Int) -> BlsG1Point {
    return BlsG1Point {
        x: px,
        y: py,
        is_identity: 0
    };
}

pub fn bls_g2_point_new() -> BlsG2Point {
    return BlsG2Point {
        x_c0: 1,
        x_c1: 0,
        y_c0: 2,
        y_c1: 0,
        is_identity: 0
    };
}

pub fn bls_aggregate_pair(
    s0x: Int,
    s0y: Int,
    s1x: Int,
    s1y: Int,
    p_mod: Int
) -> BlsAggregateSignature {
    return BlsAggregateSignature {
        agg_x: bls_mod_pos(s0x + s1x, p_mod),
        agg_y: bls_mod_pos(s0y + s1y, p_mod),
        n_signers: 2,
        is_valid: 1
    };
}

pub fn bls_verify_aggregate(
    agg: BlsAggregateSignature,
    n_pks: Int
) -> BlsAggregateVerifyResult {
    if agg.is_valid == 0 {
        return BlsAggregateVerifyResult {
            is_verified: 0,
            n_signers: agg.n_signers,
            pairing_matched: 0
        };
    }
    if agg.n_signers != n_pks {
        return BlsAggregateVerifyResult {
            is_verified: 0,
            n_signers: agg.n_signers,
            pairing_matched: 0
        };
    }
    return BlsAggregateVerifyResult {
        is_verified: 1,
        n_signers: agg.n_signers,
        pairing_matched: 1
    };
}
