// # Merkle Patricia Trie Root
//
// Logline: HP prefix 0x20 leaf / 0x00 ext; last filled hash is root.
//
// Setup: Four child slots. Empty keccak prefix 1454123767.
//
// Beats:
//   1. Encode: leaf 32*65536+path; ext path.
//   2. Leaf/ext/branch hashes mix tags 1/2/3.
//   3. n_nodes==0 => empty root; else last filled hash.

type MptNodeType = struct {
    tag: Int
};

type MptNode = struct {
    node_type: Int,
    encoded_path: Int,
    value_data: Int,
    child0: Int,
    child1: Int,
    child2: Int,
    child3: Int,
    node_hash: Int,
    is_valid: Int
};

type MptRootResult = struct {
    root_hash: Int,
    n_nodes: Int,
    is_empty: Int
};

fn mpt_root_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn mpt_node_type_empty() -> MptNodeType {
    return MptNodeType {
        tag: 0
    };
}

pub fn mpt_node_type_leaf() -> MptNodeType {
    return MptNodeType {
        tag: 1
    };
}

pub fn mpt_node_type_extension() -> MptNodeType {
    return MptNodeType {
        tag: 2
    };
}

pub fn mpt_node_type_branch() -> MptNodeType {
    return MptNodeType {
        tag: 3
    };
}

pub fn mpt_encode_nibbles(path_nibs: Int, is_leaf: Int) -> Int {
    let path_low: Int = path_nibs % 65536;
    if is_leaf == 1 {
        return (32 * 65536) + path_low;
    }
    return path_low;
}

pub fn mpt_node_empty() -> MptNode {
    return MptNode {
        node_type: 0,
        encoded_path: 0,
        value_data: 0,
        child0: 0,
        child1: 0,
        child2: 0,
        child3: 0,
        node_hash: 1454123767,
        is_valid: 1
    };
}

pub fn mpt_node_leaf(path_nibs: Int, val: Int) -> MptNode {
    let enc: Int = mpt_encode_nibbles(path_nibs, 1);
    return MptNode {
        node_type: 1,
        encoded_path: enc,
        value_data: val,
        child0: 0,
        child1: 0,
        child2: 0,
        child3: 0,
        node_hash: mpt_root_mix(mpt_root_mix(1, enc), val),
        is_valid: 1
    };
}

pub fn mpt_node_extension(path_nibs: Int, child_hash: Int) -> MptNode {
    let enc: Int = mpt_encode_nibbles(path_nibs, 0);
    return MptNode {
        node_type: 2,
        encoded_path: enc,
        value_data: 0,
        child0: child_hash,
        child1: 0,
        child2: 0,
        child3: 0,
        node_hash: mpt_root_mix(mpt_root_mix(2, enc), child_hash),
        is_valid: 1
    };
}

pub fn mpt_node_branch(
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int,
    val: Int
) -> MptNode {
    let kids: Int = c0 + c1 + c2 + c3;
    return MptNode {
        node_type: 3,
        encoded_path: 0,
        value_data: val,
        child0: c0,
        child1: c1,
        child2: c2,
        child3: c3,
        node_hash: mpt_root_mix(mpt_root_mix(3, val), kids),
        is_valid: 1
    };
}

pub fn mpt_compute_root(
    h0: Int,
    h1: Int,
    h2: Int,
    h3: Int,
    n_nodes: Int
) -> MptRootResult {
    if n_nodes == 0 {
        let empty_node: MptNode = mpt_node_empty();
        return MptRootResult {
            root_hash: empty_node.node_hash,
            n_nodes: 0,
            is_empty: 1
        };
    }
    if n_nodes == 1 {
        return MptRootResult {
            root_hash: h0,
            n_nodes: 1,
            is_empty: 0
        };
    }
    if n_nodes == 2 {
        return MptRootResult {
            root_hash: h1,
            n_nodes: 2,
            is_empty: 0
        };
    }
    if n_nodes == 3 {
        return MptRootResult {
            root_hash: h2,
            n_nodes: 3,
            is_empty: 0
        };
    }
    return MptRootResult {
        root_hash: h3,
        n_nodes: 4,
        is_empty: 0
    };
}
