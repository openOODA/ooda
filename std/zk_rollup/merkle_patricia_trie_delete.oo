// # Merkle Patricia Trie Deletion
//
// Logline: Empty-root reject; else mix(root,key) and collapse branch. Int floor.
//
// Setup: Hex keys flattened to Int. Empty root is keccak prefix 0x56e81f17.
//
// Beats:
//   1. Empty root (1454123767) is not deleted; collapsed=0.
//   2. Branch-to-leaf mix tag 1; branch-to-ext mix tag 2.
//   3. Delete mix tag 3; nodes_collapsed=1 when deleted.

type MptDeleteRequest = struct {
    key_hex: Int,
    tree_root: Int,
    enforce_existence: Int
};

type MptDeleteResult = struct {
    old_root: Int,
    new_root: Int,
    nodes_collapsed: Int,
    is_deleted: Int
};

fn mpt_del_mix(a: Int, b: Int) -> Int {
    return (a * 131) + b + 17;
}

pub fn mpt_empty_root() -> Int {
    return 1454123767;
}

pub fn mpt_delete_request_new(k_hex: Int, r_hash: Int) -> MptDeleteRequest {
    return MptDeleteRequest {
        key_hex: k_hex,
        tree_root: r_hash,
        enforce_existence: 1
    };
}

pub fn mpt_collapse_branch_to_leaf(
    branch_root: Int,
    remaining_nibble: Int,
    remaining_value: Int
) -> Int {
    return mpt_del_mix(mpt_del_mix(1, remaining_nibble), remaining_value);
}

pub fn mpt_collapse_branch_to_extension(
    branch_root: Int,
    remaining_nibble: Int,
    child_hash: Int
) -> Int {
    return mpt_del_mix(mpt_del_mix(2, remaining_nibble), child_hash);
}

pub fn mpt_delete_key(req: MptDeleteRequest) -> MptDeleteResult {
    let r: Int = req.tree_root;
    let k: Int = req.key_hex;
    if r == 1454123767 {
        return MptDeleteResult {
            old_root: r,
            new_root: r,
            nodes_collapsed: 0,
            is_deleted: 0
        };
    }
    return MptDeleteResult {
        old_root: r,
        new_root: mpt_del_mix(mpt_del_mix(3, r), k),
        nodes_collapsed: 1,
        is_deleted: 1
    };
}
