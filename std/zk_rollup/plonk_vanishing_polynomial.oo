// # PLONK Vanishing Polynomial
//
// Logline: Z_H(ζ) = ζ^n - 1; t = t_lo + t_mid*ζ^n + t_hi*ζ^{2n}. Int floor.
//
// Setup: Domain size n, omega unused in eval. Binary exponentiation (no mut/while).
//
// Beats:
//   1. Z_H(zeta) via recursive ζ^n then subtract 1 (mod p).
//   2. Quotient combine: t_lo + t_mid*zeta_n + t_hi*zeta_n^2.
//   3. Negative residues wrap by +p.

type VanishingPolyConfig = struct {
    domain_size: Int,
    generator_omega: Int,
    prime_mod: Int
};

type QuotientPolySplit = struct {
    lo_eval: Int,
    mid_eval: Int,
    hi_eval: Int,
    combined_eval: Int
};

fn pvan_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

fn pvan_pow(base: Int, exp: Int, p_mod: Int) -> Int {
    if exp == 0 {
        return 1;
    }
    let half: Int = pvan_pow(base, exp / 2, p_mod);
    let sq: Int = pvan_mod_pos(half * half, p_mod);
    if (exp % 2) == 1 {
        return pvan_mod_pos(sq * pvan_mod_pos(base, p_mod), p_mod);
    }
    return sq;
}

pub fn vanishing_poly_config_new(
    n_dom: Int,
    omega: Int,
    p_mod: Int
) -> VanishingPolyConfig {
    return VanishingPolyConfig {
        domain_size: n_dom,
        generator_omega: omega,
        prime_mod: p_mod
    };
}

pub fn vanishing_poly_eval_zh(
    cfg: VanishingPolyConfig,
    zeta: Int
) -> Int {
    let p_mod: Int = cfg.prime_mod;
    let res: Int = pvan_pow(zeta, cfg.domain_size, p_mod);
    return pvan_mod_pos(res - 1, p_mod);
}

pub fn quotient_poly_combine_evals(
    t_lo: Int,
    t_mid: Int,
    t_hi: Int,
    zeta_n: Int,
    p_mod: Int
) -> QuotientPolySplit {
    let zeta_2n: Int = pvan_mod_pos(zeta_n * zeta_n, p_mod);
    let term_mid: Int = pvan_mod_pos(t_mid * zeta_n, p_mod);
    let term_hi: Int = pvan_mod_pos(t_hi * zeta_2n, p_mod);
    let combined: Int = pvan_mod_pos(t_lo + term_mid + term_hi, p_mod);
    return QuotientPolySplit {
        lo_eval: t_lo,
        mid_eval: t_mid,
        hi_eval: t_hi,
        combined_eval: combined
    };
}
