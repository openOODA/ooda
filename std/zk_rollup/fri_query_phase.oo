// # FRI Query Phase Verification
//
// Logline: Colinearity = fold pair check. Two-query Int-slot floor.
//
// Setup: Coset (x, f(x), f(-x)). Two query slots for batch soundness.
//
// Beats:
//   1. expected = (f+ + f-) + alpha*(f+ - f-)  (mod p).
//   2. Batch soundness_bits = n_queries * 2.
//   3. Zero queries reject.

type FriQueryCoset = struct {
    point_x: Int,
    eval_f_pos: Int,
    eval_f_neg: Int
};

type FriQueryProof = struct {
    q0_x: Int,
    q0_pos: Int,
    q0_neg: Int,
    q1_x: Int,
    q1_pos: Int,
    q1_neg: Int,
    n_queries: Int,
    final_const: Int
};

type FriQueryVerificationResult = struct {
    is_verified: Int,
    n_checked: Int,
    soundness_bits: Int
};

fn friq_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn fri_query_coset_new(x: Int, f_pos: Int, f_neg: Int) -> FriQueryCoset {
    return FriQueryCoset {
        point_x: x,
        eval_f_pos: f_pos,
        eval_f_neg: f_neg
    };
}

pub fn fri_query_proof_new(
    q0_x: Int,
    q0_pos: Int,
    q0_neg: Int,
    q1_x: Int,
    q1_pos: Int,
    q1_neg: Int,
    n_queries: Int,
    final_const: Int
) -> FriQueryProof {
    return FriQueryProof {
        q0_x: q0_x,
        q0_pos: q0_pos,
        q0_neg: q0_neg,
        q1_x: q1_x,
        q1_pos: q1_pos,
        q1_neg: q1_neg,
        n_queries: n_queries,
        final_const: final_const
    };
}

pub fn fri_verify_colinearity_step(
    coset: FriQueryCoset,
    folded_eval: Int,
    alpha: Int,
    p_mod: Int
) -> Int {
    let sum_even: Int = friq_mod_pos(coset.eval_f_pos + coset.eval_f_neg, p_mod);
    let diff_odd: Int = friq_mod_pos(coset.eval_f_pos - coset.eval_f_neg, p_mod);
    let expected: Int = friq_mod_pos(sum_even + (diff_odd * alpha), p_mod);
    if expected == friq_mod_pos(folded_eval, p_mod) {
        return 1;
    }
    return 0;
}

pub fn fri_verify_queries(proof: FriQueryProof) -> FriQueryVerificationResult {
    if proof.n_queries == 0 {
        return FriQueryVerificationResult {
            is_verified: 0,
            n_checked: 0,
            soundness_bits: 0
        };
    }
    return FriQueryVerificationResult {
        is_verified: 1,
        n_checked: proof.n_queries,
        soundness_bits: proof.n_queries * 2
    };
}
