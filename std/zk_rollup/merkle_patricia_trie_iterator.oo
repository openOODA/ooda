// # Merkle Patricia Trie Iterator
//
// Logline: Cursor step until exhausted. Four-entry key collect.
//
// Setup: Index walks 0..n_entries. Exhausted when next >= n_entries.
//
// Beats:
//   1. New iterator starts at 0; empty n_entries is exhausted.
//   2. Step increments current_index and sets exhausted.
//   3. Collect copies four entry keys into four slots.

type MptEntry = struct {
    key_hex: Int,
    value_hex: Int
};

type MptIteratorState = struct {
    root_hash: Int,
    current_index: Int,
    n_entries: Int,
    is_exhausted: Int
};

type MptKeySlots = struct {
    k0: Int,
    k1: Int,
    k2: Int,
    k3: Int
};

pub fn mpt_entry_new(k: Int, v: Int) -> MptEntry {
    return MptEntry {
        key_hex: k,
        value_hex: v
    };
}

pub fn mpt_iterator_new(r_hash: Int, total: Int) -> MptIteratorState {
    if total == 0 {
        return MptIteratorState {
            root_hash: r_hash,
            current_index: 0,
            n_entries: 0,
            is_exhausted: 1
        };
    }
    return MptIteratorState {
        root_hash: r_hash,
        current_index: 0,
        n_entries: total,
        is_exhausted: 0
    };
}

pub fn mpt_iterator_step(iter: MptIteratorState) -> MptIteratorState {
    let next_idx: Int = iter.current_index + 1;
    if next_idx >= iter.n_entries {
        return MptIteratorState {
            root_hash: iter.root_hash,
            current_index: next_idx,
            n_entries: iter.n_entries,
            is_exhausted: 1
        };
    }
    return MptIteratorState {
        root_hash: iter.root_hash,
        current_index: next_idx,
        n_entries: iter.n_entries,
        is_exhausted: 0
    };
}

pub fn mpt_collect_keys(
    e0: MptEntry,
    e1: MptEntry,
    e2: MptEntry,
    e3: MptEntry
) -> MptKeySlots {
    return MptKeySlots {
        k0: e0.key_hex,
        k1: e1.key_hex,
        k2: e2.key_hex,
        k3: e3.key_hex
    };
}
