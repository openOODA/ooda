// # KZG10 Structured Reference String & Trusted Setup
//
// Logline: g1[i] = tau^i. Four-power Int-slot floor.
//
// Setup: Four G1 powers (deg 0..3) and one G2 tau slot.
//
// Beats:
//   1. Init writes 1, tau, tau^2, tau^3  (mod p).
//   2. Validate checks each power multiplies by tau.
//   3. Broken progression is inconsistent.

type SrsG1Point = struct {
    x_val: Int,
    y_val: Int,
    power_index: Int
};

type SrsG2Point = struct {
    x_c0: Int,
    x_c1: Int,
    y_c0: Int,
    y_c1: Int,
    power_index: Int
};

type Kzg10Srs = struct {
    g1_0: Int,
    g1_1: Int,
    g1_2: Int,
    g1_3: Int,
    g2_tau: Int,
    tau: Int,
    prime_mod: Int
};

type SrsValidationResult = struct {
    is_consistent: Int,
    verified_deg: Int,
    broken_idx: Int
};

fn srs_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

fn srs_pow_mod(base: Int, exp: Int, p_mod: Int) -> Int {
    if exp == 0 {
        return 1;
    }
    let half: Int = srs_pow_mod(base, exp / 2, p_mod);
    let sq: Int = srs_mod_pos(half * half, p_mod);
    if (exp % 2) == 1 {
        return srs_mod_pos(sq * base, p_mod);
    }
    return sq;
}

pub fn srs_g1_point_new(x: Int, y: Int, p_idx: Int) -> SrsG1Point {
    return SrsG1Point {
        x_val: x,
        y_val: y,
        power_index: p_idx
    };
}

pub fn srs_g2_point_new(p_idx: Int) -> SrsG2Point {
    return SrsG2Point {
        x_c0: 1,
        x_c1: 0,
        y_c0: 2,
        y_c1: 0,
        power_index: p_idx
    };
}

pub fn kzg10_srs_init(tau: Int, p_mod: Int) -> Kzg10Srs {
    return Kzg10Srs {
        g1_0: srs_pow_mod(tau, 0, p_mod),
        g1_1: srs_pow_mod(tau, 1, p_mod),
        g1_2: srs_pow_mod(tau, 2, p_mod),
        g1_3: srs_pow_mod(tau, 3, p_mod),
        g2_tau: tau,
        tau: tau,
        prime_mod: p_mod
    };
}

pub fn kzg10_srs_from_powers(
    g0: Int,
    g1: Int,
    g2: Int,
    g3: Int,
    tau: Int,
    p_mod: Int
) -> Kzg10Srs {
    return Kzg10Srs {
        g1_0: g0,
        g1_1: g1,
        g1_2: g2,
        g1_3: g3,
        g2_tau: tau,
        tau: tau,
        prime_mod: p_mod
    };
}

fn srs_step_ok(prev: Int, next: Int, tau: Int, p_mod: Int) -> Int {
    if next == srs_mod_pos(prev * tau, p_mod) {
        return 1;
    }
    return 0;
}

pub fn kzg10_srs_validate(srs: Kzg10Srs) -> SrsValidationResult {
    let p_mod: Int = srs.prime_mod;
    let tau: Int = srs.tau;
    if srs_step_ok(srs.g1_0, srs.g1_1, tau, p_mod) == 0 {
        return SrsValidationResult {
            is_consistent: 0,
            verified_deg: 0,
            broken_idx: 1
        };
    }
    if srs_step_ok(srs.g1_1, srs.g1_2, tau, p_mod) == 0 {
        return SrsValidationResult {
            is_consistent: 0,
            verified_deg: 1,
            broken_idx: 2
        };
    }
    if srs_step_ok(srs.g1_2, srs.g1_3, tau, p_mod) == 0 {
        return SrsValidationResult {
            is_consistent: 0,
            verified_deg: 2,
            broken_idx: 3
        };
    }
    return SrsValidationResult {
        is_consistent: 1,
        verified_deg: 3,
        broken_idx: 0
    };
}
