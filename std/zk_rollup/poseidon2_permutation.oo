// # Poseidon2 S-box and t=3 config (Int destub floor)
//
// Logline: S-box x^5 mod p. t=3, Rf=8, Rp=56. Destubbed off List/pub type.
//
// Setup: Full permutation List destubbed; keep S-box and config constants.
//
// Beats:
//   1. sbox_x5 is x^5 mod p.
//   2. t3 config Rf=8 Rp=56.
//   3. diag 2,3,4.

type Poseidon2Config = struct {
    width_t: Int,
    full_rounds_rf: Int,
    partial_rounds_rp: Int,
    prime_mod: Int,
    d0: Int,
    d1: Int,
    d2: Int
};

pub fn poseidon2_config_t3(p_mod: Int) -> Poseidon2Config {
    return Poseidon2Config {
        width_t: 3,
        full_rounds_rf: 8,
        partial_rounds_rp: 56,
        prime_mod: p_mod,
        d0: 2,
        d1: 3,
        d2: 4
    };
}

pub fn poseidon2_sbox_x5(x_val: Int, p_mod: Int) -> Int {
    let x: Int = x_val % p_mod;
    let x2: Int = (x * x) % p_mod;
    let x4: Int = (x2 * x2) % p_mod;
    return (x4 * x) % p_mod;
}
