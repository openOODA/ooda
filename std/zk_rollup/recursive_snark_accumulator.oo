// # Recursive SNARK Accumulator (Nova IVC)
//
// Logline: u' = u1 + r*u2; W' = W1 + r*W2; E' = E1 + r*T + r^2*E2. Int floor.
//
// Setup: Commit strings and List vectors destubbed to two-slot Ints. Nested flatten.
//
// Beats:
//   1. Instance fold: u' and commit mix are (x1 + r*x2) mod p.
//   2. Witness slot W' = W1 + r*W2; error slot E' = E1 + r*T + r^2*E2.
//   3. Step verify is the accumulator is_valid flag.

type RelaxedR1csInstance = struct {
    commit_w: Int,
    commit_e: Int,
    scalar_u: Int,
    pi0: Int,
    pi1: Int
};

type RelaxedR1csWitness = struct {
    w0: Int,
    w1: Int,
    e0: Int,
    e1: Int
};

type NovaAccumulatorState = struct {
    step_number: Int,
    commit_w: Int,
    commit_e: Int,
    scalar_u: Int,
    pi0: Int,
    pi1: Int,
    w0: Int,
    w1: Int,
    e0: Int,
    e1: Int,
    is_valid: Int
};

fn nova_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn relaxed_r1cs_instance_new(
    w_hash: Int,
    e_hash: Int,
    u_val: Int
) -> RelaxedR1csInstance {
    return RelaxedR1csInstance {
        commit_w: w_hash,
        commit_e: e_hash,
        scalar_u: u_val,
        pi0: 0,
        pi1: 0
    };
}

pub fn nova_fold_instances(
    inst1: RelaxedR1csInstance,
    inst2: RelaxedR1csInstance,
    challenge_r: Int,
    p_mod: Int
) -> RelaxedR1csInstance {
    let folded_u: Int = nova_mod_pos(inst1.scalar_u + challenge_r * inst2.scalar_u, p_mod);
    let folded_w: Int = nova_mod_pos(inst1.commit_w + challenge_r * inst2.commit_w, p_mod);
    let folded_e: Int = nova_mod_pos(inst1.commit_e + challenge_r * inst2.commit_e, p_mod);
    return RelaxedR1csInstance {
        commit_w: folded_w,
        commit_e: folded_e,
        scalar_u: folded_u,
        pi0: inst1.pi0,
        pi1: inst1.pi1
    };
}

pub fn nova_fold_witness_slot(w1: Int, w2: Int, r: Int, p_mod: Int) -> Int {
    return nova_mod_pos(w1 + r * w2, p_mod);
}

pub fn nova_fold_error_slot(e1: Int, e2: Int, t_cross: Int, r: Int, p_mod: Int) -> Int {
    let r2: Int = nova_mod_pos(r * r, p_mod);
    let rt: Int = nova_mod_pos(r * t_cross, p_mod);
    let r2e: Int = nova_mod_pos(r2 * e2, p_mod);
    return nova_mod_pos(e1 + rt + r2e, p_mod);
}

pub fn nova_step_verify(acc: NovaAccumulatorState) -> Int {
    return acc.is_valid;
}
