// # IEEE-754 Double Math
//
// Logline: Thin wrappers publish host math.h sin, cos, ln, exp, sqrt, and pow on product Float.
//
// Setup: Backend-C lowers Float to C double; callers import these names instead of the free libm floor.
//
// Beats:
//   1. Alias Float64 as Float so docs name the IEEE-754 double.
//   2. math_sin and math_cos take radians and forward to sin and cos.
//   3. math_ln is natural log; math_exp is e^x.
//   4. math_sqrt and math_pow complete the six-name floor.
//   5. Domain errors stay host NaN or inf; this module never returns Result.
//
// residual: Float is double; domain errors follow host math.h; no Result.

// Docs-only alias honesty: product Float lowers to C double (IEEE-754).
type Float64 = Float;

// Sine of x radians.
pub fn math_sin(x: Float) -> Float {
    return sin(x);
}

// Cosine of x radians.
pub fn math_cos(x: Float) -> Float {
    return cos(x);
}

// Natural logarithm (ln); residual: ≤0 → host NaN/inf.
pub fn math_ln(x: Float) -> Float {
    return ln(x);
}

// e raised to x.
pub fn math_exp(x: Float) -> Float {
    return exp(x);
}

// Square root; residual: <0 → host NaN.
pub fn math_sqrt(x: Float) -> Float {
    return sqrt(x);
}

// base raised to expn.
pub fn math_pow(base: Float, expn: Float) -> Float {
    return pow(base, expn);
}
