// package: std — IEEE-754 double math wrappers (path A)
// job: thin wrappers over free names sin/cos/ln/exp/sqrt/pow
// caps: none
// residual: Float is double alias only — NOT decimal, NOT soft-float, NOT BigDecimal
// residual: domain errors follow host math.h (NaN/inf); no Result error surface

// Docs-only alias honesty: product Float lowers to C double (IEEE-754).
type Float64 = Float;

pub fn math_sin(x: Float) -> Float {
    return sin(x);
}

pub fn math_cos(x: Float) -> Float {
    return cos(x);
}

// Natural logarithm (ln); residual: ≤0 → host NaN/inf.
pub fn math_ln(x: Float) -> Float {
    return ln(x);
}

pub fn math_exp(x: Float) -> Float {
    return exp(x);
}

pub fn math_sqrt(x: Float) -> Float {
    return sqrt(x);
}

pub fn math_pow(base: Float, expn: Float) -> Float {
    return pow(base, expn);
}
