// # Reference count lifecycle manager
//
// Logline: Track shared resource reference counts and detect when count drops to zero for deallocation.
//
// Setup: Reference count state tracking without external capability dependencies.
//
// Beats:
//   1. Initialize reference counters with an initial count of one.
//   2. Increment count on retain and decrement count on release.
//   3. Check zero-count threshold to determine when destruction is required.

type RefCount = struct {
    ref_id: String,
    count: Int,
    inc_count: Int,
    dec_count: Int,
    max_seen: Int
};

pub fn refcount_create(ref_id: String) -> RefCount {
    return RefCount {
        ref_id: ref_id,
        count: 1,
        inc_count: 0,
        dec_count: 0,
        max_seen: 1
    };
}

pub fn refcount_inc(rc: RefCount) -> RefCount {
    let cur: Int = rc.count;
    let new_c: Int = cur + 1;
    let cur_max: Int = rc.max_seen;
    let cmp: Bool = new_c > cur_max;
    let higher: Bool = cmp;
    let mut new_max: Int = cur_max;
    if higher {
        new_max = new_c;
    }
    return RefCount {
        ref_id: rc.ref_id,
        count: new_c,
        inc_count: rc.inc_count + 1,
        dec_count: rc.dec_count,
        max_seen: new_max
    };
}

pub fn refcount_dec(rc: RefCount) -> RefCount {
    let cur: Int = rc.count;
    let zero: Int = 0;
    let empty: Bool = cur == zero;
    if empty {
        return rc;
    }
    return RefCount {
        ref_id: rc.ref_id,
        count: cur - 1,
        inc_count: rc.inc_count,
        dec_count: rc.dec_count + 1,
        max_seen: rc.max_seen
    };
}

pub fn refcount_value(rc: &RefCount) -> Int {
    return (rc).count;
}

pub fn refcount_is_zero(rc: &RefCount) -> Bool {
    let c: Int = (rc).count;
    let zero: Int = 0;
    return c == zero;
}

pub fn refcount_max_seen(rc: &RefCount) -> Int {
    return (rc).max_seen;
}
