// # Integer handle recycling and allocation pool
//
// Logline: Allocate and recycle unique integer handles using a free list to prevent handle exhaustion.
//
// Setup: In-memory handle tracking without external capability dependencies.
//
// Beats:
//   1. Initialize handle pool with auto-increment counter and free list.
//   2. Acquire fresh or recycled integer identifiers.
//   3. Release handles back to the free list and report pool statistics.

pub type HandlePool = struct {
    pool_id: String,
    next_id: Int,
    free_list: List[Int],
    alloc_count: Int,
    free_count: Int,
    recycled_count: Int
};

pub fn handle_pool_create(pool_id: String) -> HandlePool {
    return HandlePool {
        pool_id: pool_id,
        next_id: 1,
        free_list: list_new(),
        alloc_count: 0,
        free_count: 0,
        recycled_count: 0
    };
}

pub fn handle_pool_alloc(p: HandlePool) -> HandlePool {
    let free: List[Int] = p.free_list;
    let len: Int = list_len(free);
    let zero: Int = 0;
    let cmp: Bool = len > zero;
    let has_recycled: Bool = cmp;
    if has_recycled {
        let mut new_free: List[Int] = list_new();
        let mut i: Int = 0;
        let last_idx: Int = len - 1;
        let cond: Bool = i < last_idx;
        while cond {
            let h: Int = list_get(free, i);
            new_free = list_push(new_free, h);
            i = i + 1;
        }
        let h: Int = list_get(free, last_idx);
        return HandlePool {
            pool_id: p.pool_id,
            next_id: p.next_id,
            free_list: new_free,
            alloc_count: p.alloc_count + 1,
            free_count: p.free_count,
            recycled_count: p.recycled_count + 1
        };
    }
    return HandlePool {
        pool_id: p.pool_id,
        next_id: p.next_id + 1,
        free_list: p.free_list,
        alloc_count: p.alloc_count + 1,
        free_count: p.free_count,
        recycled_count: p.recycled_count
    };
}

pub fn handle_pool_free(p: HandlePool, h: Int) -> HandlePool {
    let cur_free: List[Int] = p.free_list;
    let new_free: List[Int] = list_push(cur_free, h);
    return HandlePool {
        pool_id: p.pool_id,
        next_id: p.next_id,
        free_list: new_free,
        alloc_count: p.alloc_count,
        free_count: p.free_count + 1,
        recycled_count: p.recycled_count
    };
}

pub fn handle_pool_alloc_count(p: &HandlePool) -> Int {
    return (p).alloc_count;
}

pub fn handle_pool_recycled_count(p: &HandlePool) -> Int {
    return (p).recycled_count;
}

pub fn handle_pool_next_id(p: &HandlePool) -> Int {
    return (p).next_id;
}
