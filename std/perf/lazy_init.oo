// # Lazy one-shot initialization cell
//
// Logline: Manage one-shot initialization state ensuring initialization logic executes exactly once.
//
// Setup: In-memory state tracking without external capability dependencies.
//
// Beats:
//   1. Initialize lazy cells in uninitialized state with zeroed check counts.
//   2. Mark cells as initialized upon one-shot execution.
//   3. Query initialization status and track invocation attempts.

type LazyInit = struct {
    init_id: String,
    is_initialized: Bool,
    init_count: Int,
    check_count: Int
};

pub fn lazy_init_create(init_id: String) -> LazyInit {
    return LazyInit {
        init_id: init_id,
        is_initialized: false,
        init_count: 0,
        check_count: 0
    };
}

pub fn lazy_init_is_done(li: LazyInit) -> Bool {
    return li.is_initialized;
}

pub fn lazy_init_mark_done(li: LazyInit) -> LazyInit {
    let already: Bool = li.is_initialized;
    if already {
        return li;
    }
    return LazyInit {
        init_id: li.init_id,
        is_initialized: true,
        init_count: li.init_count + 1,
        check_count: li.check_count + 1
    };
}

pub fn lazy_init_check(li: LazyInit) -> LazyInit {
    return LazyInit {
        init_id: li.init_id,
        is_initialized: li.is_initialized,
        init_count: li.init_count,
        check_count: li.check_count + 1
    };
}

pub fn lazy_init_attempt_count(li: LazyInit) -> Int {
    return li.init_count;
}
