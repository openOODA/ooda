// # Bump-pointer stack memory allocator
//
// Logline: Provide LIFO memory allocation with fast bump pointer advancement and full reset.
//
// Setup: In-memory stack allocation without external capability dependencies.
//
// Beats:
//   1. Initialize stack allocator with total memory capacity.
//   2. Advance stack top pointer for consecutive allocations and track peak usage.
//   3. Reset stack allocator to reclaim all allocated memory.

type StackAlloc = struct {
    alloc_id: String,
    total_size: Int,
    used: Int,
    peak: Int,
    alloc_count: Int,
    high_water: Int
};

pub fn stack_alloc_create(alloc_id: String, total_size: Int) -> StackAlloc {
    return StackAlloc {
        alloc_id: alloc_id,
        total_size: total_size,
        used: 0,
        peak: 0,
        alloc_count: 0,
        high_water: 0
    };
}

pub fn stack_alloc_alloc(a: StackAlloc, n: Int) -> StackAlloc {
    let cur_used: Int = a.used;
    let new_used: Int = cur_used + n;
    let cap: Int = a.total_size;
    let overflow: Bool = new_used > cap;
    if overflow {
        return a;
    }
    let cur_peak: Int = a.peak;
    let cmp: Bool = new_used > cur_peak;
    let new_peak: Int = if cmp { new_used } else { cur_peak };
    let cur_high: Int = a.high_water;
    let new_high: Int = if cmp { new_used } else { cur_high };
    return StackAlloc {
        alloc_id: a.alloc_id,
        total_size: cap,
        used: new_used,
        peak: new_peak,
        alloc_count: a.alloc_count + 1,
        high_water: new_high
    };
}

pub fn stack_alloc_reset(a: StackAlloc) -> StackAlloc {
    return StackAlloc {
        alloc_id: a.alloc_id,
        total_size: a.total_size,
        used: 0,
        peak: a.peak,
        alloc_count: 0,
        high_water: a.high_water
    };
}

pub fn stack_alloc_remaining(a: StackAlloc) -> Int {
    let total: Int = a.total_size;
    let used: Int = a.used;
    return total - used;
}

pub fn stack_alloc_peak(a: StackAlloc) -> Int {
    return a.peak;
}

pub fn stack_alloc_used(a: StackAlloc) -> Int {
    return a.used;
}
