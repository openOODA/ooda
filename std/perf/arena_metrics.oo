// # Per-thread allocation and arena metrics tracker
//
// Logline: Track per-thread memory allocation totals, peak byte counts, and resource leaks.
//
// Setup: Memory metrics accounting without external capability dependencies.
//
// Beats:
//   1. Initialize arena metrics tracking structure with zeroed baseline metrics.
//   2. Record memory allocation, free, and byte expansion events.
//   3. Compute memory leak counts and peak usage statistics.

type ArenaMetrics = struct {
    metrics_id: String,
    total_allocs: Int,
    total_bytes: Int,
    peak_bytes: Int,
    alloc_count: Int,
    free_count: Int,
    leak_count: Int
};

pub fn arena_metrics_create(metrics_id: String) -> ArenaMetrics {
    return ArenaMetrics {
        metrics_id: metrics_id,
        total_allocs: 0,
        total_bytes: 0,
        peak_bytes: 0,
        alloc_count: 0,
        free_count: 0,
        leak_count: 0
    };
}

pub fn arena_metrics_total_bytes(m: ArenaMetrics) -> Int {
    return m.total_bytes;
}

pub fn arena_metrics_peak_bytes(m: ArenaMetrics) -> Int {
    return m.peak_bytes;
}

pub fn arena_metrics_alloc_count(m: ArenaMetrics) -> Int {
    return m.alloc_count;
}

pub fn arena_metrics_free_count(m: ArenaMetrics) -> Int {
    return m.free_count;
}

pub fn arena_metrics_record_alloc(m: ArenaMetrics, bytes: Int) -> ArenaMetrics {
    let cur_allocs: Int = m.total_allocs;
    let cur_bytes: Int = m.total_bytes;
    let new_bytes: Int = cur_bytes + bytes;
    let cur_peak: Int = m.peak_bytes;
    let peak_higher: Bool = cur_peak > new_bytes;
    let peak_v: Int = if peak_higher { cur_peak } else { new_bytes };
    return ArenaMetrics {
        metrics_id: m.metrics_id,
        total_allocs: cur_allocs + bytes,
        total_bytes: new_bytes,
        peak_bytes: peak_v,
        alloc_count: m.alloc_count + 1,
        free_count: m.free_count,
        leak_count: m.leak_count
    };
}

pub fn arena_metrics_record_free(m: ArenaMetrics, bytes: Int) -> ArenaMetrics {
    let cur_bytes: Int = m.total_bytes;
    return ArenaMetrics {
        metrics_id: m.metrics_id,
        total_allocs: m.total_allocs,
        total_bytes: cur_bytes - bytes,
        peak_bytes: m.peak_bytes,
        alloc_count: m.alloc_count,
        free_count: m.free_count + 1,
        leak_count: m.leak_count
    };
}

pub fn arena_metrics_check_leaks(m: ArenaMetrics) -> Int {
    let a: Int = m.alloc_count;
    let f: Int = m.free_count;
    return a - f;
}

pub fn arena_metrics_reset(m: ArenaMetrics) -> ArenaMetrics {
    let cur_leaks: Int = m.leak_count;
    let cur_a: Int = m.alloc_count;
    let cur_f: Int = m.free_count;
    let gap: Int = cur_a - cur_f;
    let has_leaks: Bool = gap > 0;
    let new_leaks: Int = if has_leaks { cur_leaks + gap } else { cur_leaks };
    return ArenaMetrics {
        metrics_id: m.metrics_id,
        total_allocs: m.total_allocs,
        total_bytes: m.total_bytes,
        peak_bytes: m.peak_bytes,
        alloc_count: 0,
        free_count: 0,
        leak_count: new_leaks
    };
}
