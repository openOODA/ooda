// # Multi-lap execution stopwatch
//
// Logline: Measure elapsed time splits across multiple laps tracking best, worst, and total durations.
//
// Setup: Microsecond timestamp inputs from system timer.
//
// Beats:
//   1. Initialize and start stopwatch with baseline microsecond timestamp.
//   2. Record lap splits, updating best and worst lap durations.
//   3. Calculate cumulative elapsed time and total recorded lap count.

type Stopwatch = struct {
    watch_id: String,
    start_us: Int,
    is_running: Bool,
    lap_count: Int,
    best_us: Int,
    worst_us: Int,
    total_us: Int,
    last_lap_us: Int
};

pub fn stopwatch_create(watch_id: String) -> Stopwatch {
    return Stopwatch {
        watch_id: watch_id,
        start_us: 0,
        is_running: false,
        lap_count: 0,
        best_us: 0,
        worst_us: 0,
        total_us: 0,
        last_lap_us: 0
    };
}

pub fn stopwatch_start(w: Stopwatch, start_us: Int) -> Stopwatch {
    return Stopwatch {
        watch_id: w.watch_id,
        start_us: start_us,
        is_running: true,
        lap_count: 0,
        best_us: 0,
        worst_us: 0,
        total_us: 0,
        last_lap_us: 0
    };
}

pub fn stopwatch_lap(w: Stopwatch, now_us: Int) -> Stopwatch {
    let cur_lap: Int = w.lap_count;
    let new_lap: Int = cur_lap + 1;
    let start_v: Int = w.start_us;
    let diff: Int = now_us - start_v;
    let lap_us: Int = diff;
    let cur_best: Int = w.best_us;
    let cur_worst: Int = w.worst_us;
    let no_laps: Bool = cur_lap == 0;
    let cmp_best: Bool = lap_us < cur_best;
    let new_best: Int = if no_laps { lap_us } else { if cmp_best { lap_us } else { cur_best } };
    let cmp_worst: Bool = lap_us > cur_worst;
    let new_worst: Int = if no_laps { lap_us } else { if cmp_worst { lap_us } else { cur_worst } };
    let cur_total: Int = w.total_us;
    return Stopwatch {
        watch_id: w.watch_id,
        start_us: now_us,
        is_running: w.is_running,
        lap_count: new_lap,
        best_us: new_best,
        worst_us: new_worst,
        total_us: cur_total + lap_us,
        last_lap_us: lap_us
    };
}

pub fn stopwatch_count(w: Stopwatch) -> Int {
    return w.lap_count;
}

pub fn stopwatch_best(w: Stopwatch) -> Int {
    return w.best_us;
}

pub fn stopwatch_worst(w: Stopwatch) -> Int {
    return w.worst_us;
}
