// # Thread synchronization barrier
//
// Logline: Synchronize concurrent workers at designated phase barriers with generation tracking.
//
// Setup: Barrier synchronization state without external capability dependencies.
//
// Beats:
//   1. Create cyclic barriers with designated participant target counts.
//   2. Track arriving threads and trigger release when the target count is satisfied.
//   3. Handle barrier resets, broken states, and arrival queries.

type Barrier = struct {
    barrier_id: String,
    target_count: Int,
    arrived: Int,
    release_count: Int,
    reset_count: Int,
    is_broken: Bool
};

pub fn barrier_create(barrier_id: String, target: Int) -> Barrier {
    return Barrier {
        barrier_id: barrier_id,
        target_count: target,
        arrived: 0,
        release_count: 0,
        reset_count: 0,
        is_broken: false
    };
}

pub fn barrier_arrive(b: Barrier) -> Barrier {
    let cur: Int = b.arrived;
    let target: Int = b.target_count;
    let next: Int = cur + 1;
    let at_target: Bool = next == target;
    let rel: Int = b.release_count;
    let new_rel: Int = if at_target { rel + 1 } else { rel };
    return Barrier {
        barrier_id: b.barrier_id,
        target_count: target,
        arrived: next,
        release_count: new_rel,
        reset_count: b.reset_count,
        is_broken: b.is_broken
    };
}

pub fn barrier_is_open(b: Barrier) -> Bool {
    let cur: Int = b.arrived;
    let target: Int = b.target_count;
    return cur >= target;
}

pub fn barrier_reset(b: Barrier) -> Barrier {
    return Barrier {
        barrier_id: b.barrier_id,
        target_count: b.target_count,
        arrived: 0,
        release_count: b.release_count,
        reset_count: b.reset_count + 1,
        is_broken: b.is_broken
    };
}

pub fn barrier_arrived(b: Barrier) -> Int {
    return b.arrived;
}

pub fn barrier_release_count(b: Barrier) -> Int {
    return b.release_count;
}
