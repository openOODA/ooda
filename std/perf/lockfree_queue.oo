// # Single-producer single-consumer lock-free queue
//
// Logline: Manage FIFO message transfer between a single producer and consumer without mutual exclusion locks.
//
// Setup: Single-producer single-consumer concurrency model with ring indexing.
//
// Beats:
//   1. Initialize lock-free queue with head, tail, and capacity bounds.
//   2. Enqueue items from producer head and advance write index.
//   3. Dequeue items from consumer tail and compute queue occupancy metrics.

type SpscQueue = struct {
    queue_id: String,
    capacity: Int,
    head: Int,
    tail: Int,
    count: Int,
    push_count: Int,
    pop_count: Int
};

pub fn spsc_queue_create(queue_id: String, cap: Int) -> SpscQueue {
    return SpscQueue {
        queue_id: queue_id,
        capacity: cap,
        head: 0,
        tail: 0,
        count: 0,
        push_count: 0,
        pop_count: 0
    };
}

pub fn spsc_queue_push(q: SpscQueue) -> SpscQueue {
    let cnt: Int = q.count;
    let cap: Int = q.capacity;
    let full: Bool = cnt >= cap;
    if full {
        return q;
    }
    let h: Int = q.head;
    let inc: Int = h + 1;
    let mod_v: Int = inc % cap;
    return SpscQueue {
        queue_id: q.queue_id,
        capacity: cap,
        head: mod_v,
        tail: q.tail,
        count: cnt + 1,
        push_count: q.push_count + 1,
        pop_count: q.pop_count
    };
}

pub fn spsc_queue_pop(q: SpscQueue) -> SpscQueue {
    let cnt: Int = q.count;
    let zero: Int = 0;
    let empty: Bool = cnt == zero;
    if empty {
        return q;
    }
    let t: Int = q.tail;
    let cap: Int = q.capacity;
    let inc: Int = t + 1;
    let mod_v: Int = inc % cap;
    return SpscQueue {
        queue_id: q.queue_id,
        capacity: cap,
        head: q.head,
        tail: mod_v,
        count: cnt - 1,
        push_count: q.push_count,
        pop_count: q.pop_count + 1
    };
}

pub fn spsc_queue_peek(q: SpscQueue) -> Int {
    return q.head;
}

pub fn spsc_queue_size(q: SpscQueue) -> Int {
    return q.count;
}

pub fn spsc_queue_capacity(q: SpscQueue) -> Int {
    return q.capacity;
}

pub fn spsc_queue_push_count(q: SpscQueue) -> Int {
    return q.push_count;
}

pub fn spsc_queue_pop_count(q: SpscQueue) -> Int {
    return q.pop_count;
}

pub fn spsc_queue_is_empty(q: SpscQueue) -> Bool {
    let c: Int = q.count;
    let zero: Int = 0;
    return c == zero;
}

pub fn spsc_queue_is_full(q: SpscQueue) -> Bool {
    let c: Int = q.count;
    let cap: Int = q.capacity;
    return c >= cap;
}
