// # Work-stealing task queue
//
// Logline: Manage local task dequeues and remote task stealing across concurrent worker threads.
//
// Setup: Task list management without external capability dependencies.
//
// Beats:
//   1. Initialize work-stealing queue with empty task lists and tracking counters.
//   2. Enqueue and dequeue tasks locally on the worker thread.
//   3. Steal tasks from the queue for load balancing and track stolen counts.

pub type WorkTask = struct {
    task_id: String,
    priority: Int,
    enqueued_ts: Int,
    work_count: Int,
};

pub type WorkStealingQueue = struct {
    queue_id: String,
    tasks: List[WorkTask>,
    enqueued_count: Int,
    completed_count: Int,
    stolen_count: Int,
    active_workers: Int,
};

pub fn work_stealing_queue_create(queue_id: String) -> WorkStealingQueue {
    return WorkStealingQueue {
        queue_id: queue_id,
        tasks: list_new(),
        enqueued_count: 0,
        completed_count: 0,
        stolen_count: 0,
        active_workers: 0,
    };
}

pub fn work_stealing_queue_enqueue(q: WorkStealingQueue, task: WorkTask) -> WorkStealingQueue {
    return WorkStealingQueue {
        queue_id: q.queue_id,
        tasks: list_push(q.tasks, task),
        enqueued_count: q.enqueued_count + 1,
        completed_count: q.completed_count,
        stolen_count: q.stolen_count,
        active_workers: q.active_workers,
    };
}

pub fn work_stealing_queue_dequeue(q: WorkStealingQueue) -> WorkStealingQueue {
    let cur: List[WorkTask> = q.tasks;
    let len: Int = list_len(cur);
    let zero: Int = 0;
    let empty: Bool = len == zero;
    if empty {
        return q;
    }
    let mut new_tasks: List[WorkTask] = list_new();
    let mut i: Int = 0;
    let last_idx: Int = len - 1;
    let cond: Bool = i < last_idx;
    while cond {
        let t: WorkTask = list_get(cur, i);
        new_tasks = list_push(new_tasks, t);
        i = i + 1;
    }
    return WorkStealingQueue {
        queue_id: q.queue_id,
        tasks: new_tasks,
        enqueued_count: q.enqueued_count,
        completed_count: q.completed_count + 1,
        stolen_count: q.stolen_count,
        active_workers: q.active_workers,
    };
}

pub fn work_stealing_queue_steal(q: WorkStealingQueue) -> WorkStealingQueue {
    let len: Int = list_len(q.tasks);
    let zero: Int = 0;
    let empty: Bool = len == zero;
    if empty {
        return q;
    }
    return WorkStealingQueue {
        queue_id: q.queue_id,
        tasks: q.tasks,
        enqueued_count: q.enqueued_count,
        completed_count: q.completed_count,
        stolen_count: q.stolen_count + 1,
        active_workers: q.active_workers,
    };
}

pub fn work_stealing_queue_size(q: &WorkStealingQueue) -> Int {
    return list_len((q).tasks);
}
