// # Fixed-capacity batch aggregation buffer
//
// Logline: Accumulate items into fixed batches and trigger flushes upon reaching capacity thresholds.
//
// Setup: In-memory batch aggregation without external capability dependencies.
//
// Beats:
//   1. Create batch buffers configured with capacity and max batch limits.
//   2. Add items, accumulate byte sizes, and monitor flush thresholds.
//   3. Perform buffer flushes and update aggregate flush statistics.

type BatchBuffer = struct {
    buffer_id: String,
    capacity: Int,
    count: Int,
    total_bytes: Int,
    max_batch: Int,
    flush_count: Int,
    items_flushed_total: Int
};

pub fn batch_buffer_create(buffer_id: String, cap: Int, max_batch: Int) -> BatchBuffer {
    return BatchBuffer {
        buffer_id: buffer_id,
        capacity: cap,
        count: 0,
        total_bytes: 0,
        max_batch: max_batch,
        flush_count: 0,
        items_flushed_total: 0
    };
}

pub fn batch_buffer_push(bb: BatchBuffer) -> BatchBuffer {
    let cnt: Int = bb.count;
    let cap: Int = bb.capacity;
    let full: Bool = cnt >= cap;
    if full {
        return bb;
    }
    return BatchBuffer {
        buffer_id: bb.buffer_id,
        capacity: cap,
        count: cnt + 1,
        total_bytes: bb.total_bytes,
        max_batch: bb.max_batch,
        flush_count: bb.flush_count,
        items_flushed_total: bb.items_flushed_total
    };
}

pub fn batch_buffer_should_flush(bb: BatchBuffer) -> Bool {
    let cnt: Int = bb.count;
    let max: Int = bb.max_batch;
    return cnt >= max;
}

pub fn batch_buffer_flush(bb: BatchBuffer) -> BatchBuffer {
    let flushed: Int = bb.count;
    return BatchBuffer {
        buffer_id: bb.buffer_id,
        capacity: bb.capacity,
        count: 0,
        total_bytes: bb.total_bytes,
        max_batch: bb.max_batch,
        flush_count: bb.flush_count + 1,
        items_flushed_total: bb.items_flushed_total + flushed
    };
}

pub fn batch_buffer_size(bb: BatchBuffer) -> Int {
    return bb.count;
}

pub fn batch_buffer_flush_count(bb: BatchBuffer) -> Int {
    return bb.flush_count;
}

pub fn batch_buffer_items_flushed(bb: BatchBuffer) -> Int {
    return bb.items_flushed_total;
}

pub fn batch_buffer_stats(bb: BatchBuffer) -> Int {
    let fc: Int = bb.flush_count;
    let ifl: Int = bb.items_flushed_total;
    return fc + ifl;
}
