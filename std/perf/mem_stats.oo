// # Global memory allocation statistics tracker
//
// Logline: Aggregate heap allocation, deallocation, and peak usage counters across subsystems.
//
// Setup: Memory accounting without external capability dependencies.
//
// Beats:
//   1. Initialize global memory tracking counters with zeroed baselines.
//   2. Record memory allocation, free, and reallocation events.
//   3. Compute current live bytes and lifetime high-water marks.

type MemStats = struct {
    stats_id: String,
    total_allocs: Int,
    total_frees: Int,
    live_count: Int,
    total_bytes_alloced: Int,
    total_bytes_freed: Int,
    bytes_in_use: Int,
    peak_bytes: Int,
    alloc_count: Int
};

pub fn mem_stats_create(stats_id: String) -> MemStats {
    return MemStats {
        stats_id: stats_id,
        total_allocs: 0,
        total_frees: 0,
        live_count: 0,
        total_bytes_alloced: 0,
        total_bytes_freed: 0,
        bytes_in_use: 0,
        peak_bytes: 0,
        alloc_count: 0
    };
}

pub fn mem_stats_record_alloc(m: MemStats, bytes: Int) -> MemStats {
    let cur_total: Int = m.total_allocs;
    let new_total_a: Int = cur_total + bytes;
    let cur_in_use: Int = m.bytes_in_use;
    let new_bytes_in_use: Int = cur_in_use + bytes;
    let cur_peak: Int = m.peak_bytes;
    let cmp: Bool = new_bytes_in_use > cur_peak;
    let peak_higher: Bool = cmp;
    let new_peak: Int = if peak_higher { new_bytes_in_use } else { cur_peak };
    return MemStats {
        stats_id: m.stats_id,
        total_allocs: new_total_a,
        total_frees: m.total_frees,
        live_count: m.live_count + 1,
        total_bytes_alloced: m.total_bytes_alloced + bytes,
        total_bytes_freed: m.total_bytes_freed,
        bytes_in_use: new_bytes_in_use,
        peak_bytes: new_peak,
        alloc_count: m.alloc_count + 1
    };
}

pub fn mem_stats_record_free(m: MemStats, bytes: Int) -> MemStats {
    let cur_in_use: Int = m.bytes_in_use;
    let new_bytes_in_use: Int = cur_in_use - bytes;
    let cur_live: Int = m.live_count;
    let new_live: Int = cur_live - 1;
    let cur_total_f: Int = m.total_frees;
    let cur_total_bytes_f: Int = m.total_bytes_freed;
    return MemStats {
        stats_id: m.stats_id,
        total_allocs: m.total_allocs,
        total_frees: cur_total_f + bytes,
        live_count: new_live,
        total_bytes_alloced: m.total_bytes_alloced,
        total_bytes_freed: cur_total_bytes_f + bytes,
        bytes_in_use: new_bytes_in_use,
        peak_bytes: m.peak_bytes,
        alloc_count: m.alloc_count
    };
}

pub fn mem_stats_live(m: MemStats) -> Int {
    return m.live_count;
}

pub fn mem_stats_peak(m: MemStats) -> Int {
    return m.peak_bytes;
}

pub fn mem_stats_bytes_in_use(m: MemStats) -> Int {
    return m.bytes_in_use;
}
