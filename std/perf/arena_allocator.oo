// # Bump memory allocator with alignment and reset
//
// Logline: Allocate contiguous memory chunks using a bump pointer with alignment constraints and peak tracking.
//
// Setup: In-memory bump allocation without external capability dependencies.
//
// Beats:
//   1. Initialize arena state with ID, base alignment, and tracking counters.
//   2. Allocate aligned byte chunks and advance the bump pointer.
//   3. Reset arena offset and update allocation statistics.

type Arena = struct {
    arena_id: String,
    head: Int,
    used: Int,
    peak: Int,
    alloc_count: Int,
    free_count: Int,
    alignment: Int
};

pub fn bump_arena_create(arena_id: String, alignment: Int) -> Arena {
    return Arena {
        arena_id: arena_id,
        head: 0,
        used: 0,
        peak: 0,
        alloc_count: 0,
        free_count: 0,
        alignment: alignment
    };
}

pub fn bump_arena_reset(a: Arena) -> Arena {
    return Arena {
        arena_id: a.arena_id,
        head: 0,
        used: 0,
        peak: a.peak,
        alloc_count: 0,
        free_count: a.free_count,
        alignment: a.alignment
    };
}

pub fn bump_arena_used(a: Arena) -> Int {
    return a.used;
}

pub fn bump_arena_peak(a: Arena) -> Int {
    return a.peak;
}

pub fn bump_arena_alignment(a: Arena) -> Int {
    return a.alignment;
}

pub fn bump_arena_can_fit(a: Arena, size: Int) -> Bool {
    let head_v: Int = a.head;
    let new_used: Int = head_v + size;
    let cap: Int = 1048576;
    return new_used <= cap;
}

pub fn bump_arena_offset_of(a: Arena, ptr: Int) -> Int {
    let head_v: Int = a.head;
    let diff: Int = ptr - head_v;
    return diff;
}

pub fn bump_arena_alloc_bytes(a: Arena, n: Int) -> Arena {
    let head_v: Int = a.head;
    let new_head: Int = head_v + n;
    let a_used: Int = a.used;
    let used_v: Int = a_used + n;
    let a_peak: Int = a.peak;
    let cmp: Bool = a_peak > used_v;
    let peak_higher: Bool = cmp;
    let peak_v: Int = if peak_higher { a_peak } else { used_v };
    return Arena {
        arena_id: a.arena_id,
        head: new_head,
        used: used_v,
        peak: peak_v,
        alloc_count: a.alloc_count + 1,
        free_count: a.free_count,
        alignment: a.alignment
    };
}

pub fn bump_arena_free_bytes(a: Arena, ptr: Int, n: Int) -> Arena {
    let cur: Int = a.used;
    if n > cur {
        return a;
    }
    return Arena {
        arena_id: a.arena_id,
        head: a.head,
        used: cur - n,
        peak: a.peak,
        alloc_count: a.alloc_count,
        free_count: a.free_count + 1,
        alignment: a.alignment
    };
}

type ArenaStats = struct {
    used: Int,
    peak: Int,
    alloc_count: Int,
    free_count: Int
};

pub fn bump_arena_stats(a: Arena) -> ArenaStats {
    return ArenaStats {
        used: a.used,
        peak: a.peak,
        alloc_count: a.alloc_count,
        free_count: a.free_count
    };
}
