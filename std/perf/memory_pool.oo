// # Fixed-block memory pool
//
// Logline: Manage fixed-block memory allocations and returns using reusable pool partitions.
//
// Setup: In-memory block management without external capability dependencies.
//
// Beats:
//   1. Create memory pool partitions with fixed block sizes and total block counts.
//   2. Allocate blocks and update used and free block counters.
//   3. Reclaim freed blocks and calculate memory utilization metrics.

type MemPool = struct {
    pool_id: String,
    block_size: Int,
    block_count: Int,
    used: Int,
    free_count: Int,
    alloc_count: Int
};

pub fn mem_pool_create(pool_id: String, block_size: Int, count: Int) -> MemPool {
    return MemPool {
        pool_id: pool_id,
        block_size: block_size,
        block_count: count,
        used: 0,
        free_count: count,
        alloc_count: 0
    };
}

pub fn mem_pool_alloc(mp: MemPool) -> MemPool {
    let free: Int = mp.free_count;
    let zero: Int = 0;
    let empty: Bool = free == zero;
    if empty {
        return mp;
    }
    return MemPool {
        pool_id: mp.pool_id,
        block_size: mp.block_size,
        block_count: mp.block_count,
        used: mp.used + 1,
        free_count: mp.free_count - 1,
        alloc_count: mp.alloc_count + 1
    };
}

pub fn mem_pool_free(mp: MemPool) -> MemPool {
    let used: Int = mp.used;
    let zero: Int = 0;
    let no_used: Bool = used == zero;
    if no_used {
        return mp;
    }
    return MemPool {
        pool_id: mp.pool_id,
        block_size: mp.block_size,
        block_count: mp.block_count,
        used: mp.used - 1,
        free_count: mp.free_count + 1,
        alloc_count: mp.alloc_count
    };
}

pub fn mem_pool_used(mp: MemPool) -> Int {
    return mp.used;
}

pub fn mem_pool_available(mp: MemPool) -> Int {
    return mp.free_count;
}

pub fn mem_pool_stats(mp: MemPool) -> Int {
    let alloc: Int = mp.alloc_count;
    let used: Int = mp.used;
    return alloc + used;
}
