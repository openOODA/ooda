// # High-resolution CPU execution timer
//
// Logline: Measure elapsed CPU execution time and tick durations for performance profiling.
//
// Setup: High-resolution timestamp inputs in microseconds.
//
// Beats:
//   1. Initialize CPU timers in stopped state with tracking counters.
//   2. Start and stop timers using timestamp inputs to calculate elapsed time.
//   3. Query elapsed durations and total measurement history.

type CpuTimer = struct {
    timer_id: String,
    start_us: Int,
    end_us: Int,
    is_running: Bool,
    elapsed_us: Int,
    measurement_count: Int
};

pub fn cpu_timer_create(timer_id: String) -> CpuTimer {
    return CpuTimer {
        timer_id: timer_id,
        start_us: 0,
        end_us: 0,
        is_running: false,
        elapsed_us: 0,
        measurement_count: 0
    };
}

pub fn cpu_timer_start(t: CpuTimer, start_us: Int) -> CpuTimer {
    return CpuTimer {
        timer_id: t.timer_id,
        start_us: start_us,
        end_us: t.end_us,
        is_running: true,
        elapsed_us: t.elapsed_us,
        measurement_count: t.measurement_count
    };
}

pub fn cpu_timer_stop(t: CpuTimer, end_us: Int) -> CpuTimer {
    let cur_start: Int = t.start_us;
    let elapsed: Int = end_us - cur_start;
    let cur_count: Int = t.measurement_count;
    return CpuTimer {
        timer_id: t.timer_id,
        start_us: t.start_us,
        end_us: end_us,
        is_running: false,
        elapsed_us: elapsed,
        measurement_count: cur_count + 1
    };
}

pub fn cpu_timer_is_running(t: CpuTimer) -> Bool {
    return t.is_running;
}

pub fn cpu_timer_elapsed_us(t: CpuTimer) -> Int {
    return t.elapsed_us;
}

pub fn cpu_timer_count(t: CpuTimer) -> Int {
    return t.measurement_count;
}
