// # Fixed-size small object slot pool
//
// Logline: Acquire and release reusable small object slots using a free index stack.
//
// Setup: In-memory slot pooling without external capability dependencies.
//
// Beats:
//   1. Initialize object pool with slot size, capacity, and populated free stack.
//   2. Acquire available slot indexes and mark slots as occupied.
//   3. Release slot indexes back to the free stack and report pool statistics.

pub type ObjectPool = struct {
    pool_id: String,
    slot_size: Int,
    capacity: Int,
    used: Int,
    free_stack: List[Int>,
    alloc_count: Int,
    recycle_count: Int
};

pub fn object_pool_create(pool_id: String, slot_size: Int, capacity: Int) -> ObjectPool {
    let free: List[Int] = list_new();
    let mut i: Int = capacity - 1;
    let mut stack: List[Int] = list_new();
    let zero: Int = 0;
    while i >= zero {
        stack = list_push(stack, i);
        i = i - 1;
    }
    return ObjectPool {
        pool_id: pool_id,
        slot_size: slot_size,
        capacity: capacity,
        used: 0,
        free_stack: stack,
        alloc_count: 0,
        recycle_count: 0
    };
}

pub fn object_pool_acquire(p: &mut ObjectPool) -> Int {
    let mut pool = p;
    let used_v: Int = pool.used;
    let cap: Int = pool.capacity;
    if used_v >= cap {
        return -1;
    }
    let stack: List[Int] = pool.free_stack;
    let mut new_stack: List[Int] = list_new();
    let len: Int = list_len(stack);
    if len == 0 {
        return -1;
    }
    let mut i: Int = 0;
    let mut slot: Int = 0;
    let last_idx: Int = len - 1;
    while i < last_idx {
        let s: Int = list_get(stack, i);
        new_stack = list_push(new_stack, s);
        i = i + 1;
    }
    slot = list_get(stack, last_idx);
    pool.free_stack = new_stack;
    let cur_used: Int = pool.used;
    pool.used = cur_used + 1;
    let cur_a: Int = pool.alloc_count;
    pool.alloc_count = cur_a + 1;
    return slot;
}

pub fn object_pool_release(p: &mut ObjectPool, slot: Int) {
    let mut pool = p;
    let cur_stack: List[Int] = pool.free_stack;
    let new_stack: List[Int] = list_push(cur_stack, slot);
    pool.free_stack = new_stack;
    let cur_used: Int = pool.used;
    pool.used = cur_used - 1;
    let cur_r: Int = pool.recycle_count;
    pool.recycle_count = cur_r + 1;
}

pub fn object_pool_available(p: &ObjectPool) -> Int {
    let used_v: Int = (p).used;
    let cap: Int = (p).capacity;
    return cap - used_v;
}

pub fn object_pool_stats(p: &ObjectPool) -> Int {
    let a: Int = (p).alloc_count;
    let r: Int = (p).recycle_count;
    return a + r;
}
