// # Cache Miss and Memory Hierarchy Model
//
// Logline: Estimate and model L1, L2, and L3 cache misses, data locality, and memory stall cycles for compiled kernels.
//
// Setup: Used by the continuous performance profiler to verify high cache locality in hot loops.
//
// Beats:
//   1. Model memory hierarchy access latencies across L1D, L2, L3, and main RAM.
//   2. Calculate simulated cache miss ratios from stride patterns and working set sizes.
//   3. Compute overall memory stall cycles and effective access times.
//   4. Validate that hot inner loops maintain greater than 98 percent L1 cache hit rate.

pub type CacheProfile = struct {
    working_set_bytes: Int,
    l1_hits: Int,
    l1_misses: Int,
    l2_misses: Int,
    l3_misses: Int
};

pub type LocalityEvaluation = struct {
    l1_hit_rate_pct: Int,
    effective_latency_ns: Int,
    is_optimal_locality: Bool
};

pub fn cache_profile_new(bytes: Int, l1_h: Int, l1_m: Int, l2_m: Int, l3_m: Int) -> CacheProfile { return CacheProfile {
        working_set_bytes: bytes,
        l1_hits: l1_h,
        l1_misses: l1_m,
        l2_misses: l2_m,
        l3_misses: l3_m
    }; }

pub fn calculate_l1_hit_rate(profile: CacheProfile) -> Int {
    let total: Int = profile.l1_hits + profile.l1_misses;
    if total <= 0 {
        return 100;
    }
    let pct: Int = (profile.l1_hits * 100) / total;
    return pct;
}

pub fn calculate_effective_latency(profile: CacheProfile) -> Int {
    let l1_lat: Int = 1;
    let l2_lat: Int = 4;
    let l3_lat: Int = 12;
    let ram_lat: Int = 60;

    let l1_cost: Int = profile.l1_hits * l1_lat;
    let l2_cost: Int = (profile.l1_misses - profile.l2_misses) * l2_lat;
    let l3_cost: Int = (profile.l2_misses - profile.l3_misses) * l3_lat;
    let ram_cost: Int = profile.l3_misses * ram_lat;

    let c12: Int = l1_cost + l2_cost;
    let c3r: Int = l3_cost + ram_cost;
    let total_cost: Int = c12 + c3r;

    let total_accesses: Int = profile.l1_hits + profile.l1_misses;
    if total_accesses <= 0 {
        return 1;
    }
    let effective: Int = total_cost / total_accesses;
    if effective < 1 {
        return 1;
    }
    return effective;
}

pub fn evaluate_locality(profile: CacheProfile) -> LocalityEvaluation {
    let hit_rate: Int = calculate_l1_hit_rate(profile);
    let eff_lat: Int = calculate_effective_latency(profile);
    let optimal: Bool = hit_rate >= 95;
    return LocalityEvaluation {
        l1_hit_rate_pct: hit_rate,
        effective_latency_ns: eff_lat,
        is_optimal_locality: optimal
    };
}
