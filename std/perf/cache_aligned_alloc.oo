// # Cache-line aligned memory allocator
//
// Logline: Align memory allocations to cache-line boundaries and compute padding overhead to prevent false sharing.
//
// Setup: Cache geometry constants and byte offset calculations.
//
// Beats:
//   1. Calculate padded byte sizes aligned to CPU cache-line boundaries.
//   2. Track cache-aligned allocation offsets and total overhead.
//   3. Inspect alignment efficiency and waste ratios.

type CacheAlignedAlloc = struct {
    alloc_id: String,
    cache_line_size: Int,
    total_allocated: Int,
    total_wasted: Int,
    alloc_count: Int
};

pub fn cache_aligned_create(alloc_id: String, cache_line_size: Int) -> CacheAlignedAlloc {
    return CacheAlignedAlloc {
        alloc_id: alloc_id,
        cache_line_size: cache_line_size,
        total_allocated: 0,
        total_wasted: 0,
        alloc_count: 0
    };
}

pub fn cache_aligned_align_up(value: Int, alignment: Int) -> Int {
    let rem: Int = value % alignment;
    let zero: Int = 0;
    let aligned: Bool = rem == zero;
    if aligned {
        return value;
    }
    let add: Int = alignment - rem;
    return value + add;
}

pub fn cache_aligned_alloc(a: CacheAlignedAlloc, size: Int) -> CacheAlignedAlloc {
    let cur_total: Int = a.total_allocated;
    let new_total: Int = cur_total + size;
    let aligned_size: Int = cache_aligned_align_up(size, a.cache_line_size);
    let wasted: Int = aligned_size - size;
    let cur_w: Int = a.total_wasted;
    let new_w: Int = cur_w + wasted;
    return CacheAlignedAlloc {
        alloc_id: a.alloc_id,
        cache_line_size: a.cache_line_size,
        total_allocated: new_total,
        total_wasted: new_w,
        alloc_count: a.alloc_count + 1
    };
}

pub fn cache_aligned_allocated(a: CacheAlignedAlloc) -> Int {
    return a.total_allocated;
}

pub fn cache_aligned_wasted(a: CacheAlignedAlloc) -> Int {
    return a.total_wasted;
}

pub fn cache_aligned_overhead_pct(a: CacheAlignedAlloc) -> Int {
    let total: Int = a.total_allocated;
    let wasted: Int = a.total_wasted;
    let zero: Int = 0;
    if total == zero {
        return 0;
    }
    let hundred: Int = 100;
    return (wasted * hundred) / total;
}
