// # Pool of reusable memory arenas
//
// Logline: Allocate, recycle, and reset multiple memory arenas across concurrent tasks.
//
// Setup: In-memory arena pooling without external capability dependencies.
//
// Beats:
//   1. Initialize arena pool with capacity limits and tracking counters.
//   2. Checkout idle arenas for scoped task allocations and track byte totals.
//   3. Reset and return used arenas to the available pool.

type ArenaPool = struct {
    pool_id: String,
    max_arenas: Int,
    active_arenas: Int,
    total_alloc_bytes: Int,
    total_reset_count: Int
};

pub fn arena_pool_create(pool_id: String, max_arenas: Int) -> ArenaPool {
    return ArenaPool {
        pool_id: pool_id,
        max_arenas: max_arenas,
        active_arenas: 0,
        total_alloc_bytes: 0,
        total_reset_count: 0
    };
}

pub fn arena_pool_acquire(p: ArenaPool) -> ArenaPool {
    let cur: Int = p.active_arenas;
    let max: Int = p.max_arenas;
    let full: Bool = cur >= max;
    if full {
        return p;
    }
    return ArenaPool {
        pool_id: p.pool_id,
        max_arenas: max,
        active_arenas: cur + 1,
        total_alloc_bytes: p.total_alloc_bytes,
        total_reset_count: p.total_reset_count
    };
}

pub fn arena_pool_release(p: ArenaPool) -> ArenaPool {
    let cur: Int = p.active_arenas;
    let zero: Int = 0;
    let empty: Bool = cur == zero;
    if empty {
        return p;
    }
    return ArenaPool {
        pool_id: p.pool_id,
        max_arenas: p.max_arenas,
        active_arenas: cur - 1,
        total_alloc_bytes: p.total_alloc_bytes,
        total_reset_count: p.total_reset_count + 1
    };
}

pub fn arena_pool_record_alloc(p: ArenaPool, bytes: Int) -> ArenaPool {
    return ArenaPool {
        pool_id: p.pool_id,
        max_arenas: p.max_arenas,
        active_arenas: p.active_arenas,
        total_alloc_bytes: p.total_alloc_bytes + bytes,
        total_reset_count: p.total_reset_count
    };
}

pub fn arena_pool_active(p: ArenaPool) -> Int {
    return p.active_arenas;
}

pub fn arena_pool_total_alloc(p: ArenaPool) -> Int {
    return p.total_alloc_bytes;
}

pub fn arena_pool_reset_count(p: ArenaPool) -> Int {
    return p.total_reset_count;
}
