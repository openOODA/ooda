// # Copy-on-write buffer wrapper
//
// Logline: Provide lazy cloning semantics for shared buffers by duplicating data only on mutation.
//
// Setup: In-memory reference counting and buffer virtualization.
//
// Beats:
//   1. Initialize shared copy-on-write wrappers referencing source data buffers.
//   2. Clone underlying buffers when mutative writes occur under shared ownership.
//   3. Track clone operations, write counts, and active reference shares.

type CowBuffer = struct {
    buffer_id: String,
    data: String,
    ref_count: Int,
    copy_count: Int,
    write_count: Int,
    share_count: Int
};

pub fn cow_buffer_create(buffer_id: String, data: String) -> CowBuffer {
    return CowBuffer {
        buffer_id: buffer_id,
        data: data,
        ref_count: 1,
        copy_count: 0,
        write_count: 0,
        share_count: 0
    };
}

pub fn cow_buffer_share(b: CowBuffer) -> CowBuffer {
    return CowBuffer {
        buffer_id: b.buffer_id,
        data: b.data,
        ref_count: b.ref_count + 1,
        copy_count: b.copy_count,
        write_count: b.write_count,
        share_count: b.share_count + 1
    };
}

pub fn cow_buffer_write(b: CowBuffer, new_data: String) -> CowBuffer {
    let cur_ref: Int = b.ref_count;
    let one: Int = 1;
    let cmp: Bool = cur_ref > one;
    let is_shared: Bool = cmp;
    if is_shared {
        return CowBuffer {
            buffer_id: b.buffer_id + "_copy",
            data: new_data,
            ref_count: 1,
            copy_count: b.copy_count + 1,
            write_count: b.write_count + 1,
            share_count: b.share_count
        };
    }
    return CowBuffer {
        buffer_id: b.buffer_id,
        data: new_data,
        ref_count: b.ref_count,
        copy_count: b.copy_count,
        write_count: b.write_count + 1,
        share_count: b.share_count
    };
}

pub fn cow_buffer_refcount(b: CowBuffer) -> Int {
    return b.ref_count;
}

pub fn cow_buffer_data(b: CowBuffer) -> String {
    return b.data;
}

pub fn cow_buffer_copy_count(b: CowBuffer) -> Int {
    return b.copy_count;
}

pub fn cow_buffer_write_count(b: CowBuffer) -> Int {
    return b.write_count;
}
