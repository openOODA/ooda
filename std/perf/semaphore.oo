// # Counting semaphore permit manager
//
// Logline: Manage available resource permits with bounded acquire and release operations.
//
// Setup: Semaphore permit counting without external capability dependencies.
//
// Beats:
//   1. Initialize counting semaphore with initial and maximum permit limits.
//   2. Decrement permits on acquire and increment permits on release.
//   3. Query available permits and total acquisition history.

type Semaphore = struct {
    sem_id: String,
    permits: Int,
    max_permits: Int,
    acquire_count: Int,
    release_count: Int,
    wait_count: Int
};

pub fn semaphore_create(sem_id: String, initial: Int, max_permits: Int) -> Semaphore {
    return Semaphore {
        sem_id: sem_id,
        permits: initial,
        max_permits: max_permits,
        acquire_count: 0,
        release_count: 0,
        wait_count: 0
    };
}

pub fn semaphore_acquire(s: Semaphore) -> Semaphore {
    let cur: Int = s.permits;
    let zero: Int = 0;
    let empty: Bool = cur == zero;
    if empty {
        return Semaphore {
            sem_id: s.sem_id,
            permits: 0,
            max_permits: s.max_permits,
            acquire_count: s.acquire_count,
            release_count: s.release_count,
            wait_count: s.wait_count + 1
        };
    }
    return Semaphore {
        sem_id: s.sem_id,
        permits: cur - 1,
        max_permits: s.max_permits,
        acquire_count: s.acquire_count + 1,
        release_count: s.release_count,
        wait_count: s.wait_count
    };
}

pub fn semaphore_release(s: Semaphore) -> Semaphore {
    let cur: Int = s.permits;
    let max: Int = s.max_permits;
    let full: Bool = cur >= max;
    if full {
        return s;
    }
    return Semaphore {
        sem_id: s.sem_id,
        permits: cur + 1,
        max_permits: max,
        acquire_count: s.acquire_count,
        release_count: s.release_count + 1,
        wait_count: s.wait_count
    };
}

pub fn semaphore_available(s: Semaphore) -> Int {
    return s.permits;
}

pub fn semaphore_acquire_count(s: Semaphore) -> Int {
    return s.acquire_count;
}

pub fn semaphore_release_count(s: Semaphore) -> Int {
    return s.release_count;
}

pub fn semaphore_wait_count(s: Semaphore) -> Int {
    return s.wait_count;
}
