// # Bounded circular ring buffer
//
// Logline: Provide FIFO queue semantics with fixed capacity using circular array indexing.
//
// Setup: In-memory circular buffer without external capability dependencies.
//
// Beats:
//   1. Initialize circular ring buffer with maximum capacity.
//   2. Push elements at tail index handling overflow policies and dropped counts.
//   3. Pop elements from head index and report buffer occupancy.

type RingBuffer = struct {
    buffer_id: String,
    capacity: Int,
    head: Int,
    tail: Int,
    count: Int,
    dropped: Int
};


pub fn ring_buffer_create(buffer_id: String, cap: Int) -> RingBuffer {
    return RingBuffer {
        buffer_id: buffer_id,
        capacity: cap,
        head: 0,
        tail: 0,
        count: 0,
        dropped: 0
    };
}

pub fn ring_buffer_size(rb: RingBuffer) -> Int {
    return rb.count;
}

pub fn ring_buffer_capacity(rb: RingBuffer) -> Int {
    return rb.capacity;
}

pub fn ring_buffer_is_full(rb: RingBuffer) -> Bool {
    let c: Int = rb.count;
    let cap: Int = rb.capacity;
    let full: Bool = c >= cap;
    return full;
}

pub fn ring_buffer_is_empty(rb: RingBuffer) -> Bool {
    let c: Int = rb.count;
    let zero: Int = 0;
    let empty: Bool = c == zero;
    return empty;
}

pub fn ring_buffer_dropped(rb: RingBuffer) -> Int {
    return rb.dropped;
}

pub fn ring_buffer_push(rb: RingBuffer) -> RingBuffer {
    let cnt: Int = rb.count;
    let cap: Int = rb.capacity;
    if cnt >= cap {
        return RingBuffer {
            buffer_id: rb.buffer_id,
            capacity: cap,
            head: rb.head,
            tail: rb.tail,
            count: cnt,
            dropped: rb.dropped + 1
        };
    }
    let head_v: Int = rb.head;
    let inc_h: Int = head_v + 1;
    let mod_h: Int = inc_h % cap;
    return RingBuffer {
        buffer_id: rb.buffer_id,
        capacity: cap,
        head: mod_h,
        tail: rb.tail,
        count: cnt + 1,
        dropped: rb.dropped
    };
}

pub fn ring_buffer_pop(rb: RingBuffer) -> RingBuffer {
    let cnt: Int = rb.count;
    if cnt == 0 {
        return rb;
    }
    let tail_v: Int = rb.tail;
    let cap: Int = rb.capacity;
    let inc_t: Int = tail_v + 1;
    let mod_t: Int = inc_t % cap;
    return RingBuffer {
        buffer_id: rb.buffer_id,
        capacity: cap,
        head: rb.head,
        tail: mod_t,
        count: cnt - 1,
        dropped: rb.dropped
    };
}

pub fn ring_buffer_peek(rb: RingBuffer) -> Int {
    return rb.tail;
}

