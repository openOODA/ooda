// # Log-scale latency distribution histogram
//
// Logline: Aggregate latency measurements into logarithmic interval buckets to analyze response times.
//
// Setup: Latency measurement inputs in microseconds.
//
// Beats:
//   1. Initialize histogram structures with log-scale interval buckets.
//   2. Record latency sample measurements into matching buckets.
//   3. Compute aggregate sample count, mean latency, and maximum observed time.

type LatencyBucket = struct {
    bucket_id: String,
    lower_us: Int,
    upper_us: Int,
    count: Int
};

type LatencyHistogram = struct {
    histogram_id: String,
    bucket_count: Int,
    min_us: Int,
    max_us: Int,
    total_count: Int,
    sum_us: Int,
    max_seen: Int,
    buckets: List[LatencyBucket]
};

pub fn latency_histogram_create(histogram_id: String, buckets: Int, min_us: Int, max_us: Int) -> LatencyHistogram {
    return LatencyHistogram {
        histogram_id: histogram_id,
        bucket_count: buckets,
        min_us: min_us,
        max_us: max_us,
        total_count: 0,
        sum_us: 0,
        max_seen: 0,
        buckets: list_new()
    };
}

pub fn latency_histogram_record(lh: LatencyHistogram, value_us: Int) -> LatencyHistogram {
    let cur_total: Int = lh.total_count;
    let new_total: Int = cur_total + 1;
    let cur_sum: Int = lh.sum_us;
    let new_sum: Int = cur_sum + value_us;
    let cur_max: Int = lh.max_seen;
    let higher: Bool = value_us > cur_max;
    let new_max: Int = if higher { value_us } else { cur_max };
    return LatencyHistogram {
        histogram_id: lh.histogram_id,
        bucket_count: lh.bucket_count,
        min_us: lh.min_us,
        max_us: lh.max_us,
        total_count: new_total,
        sum_us: new_sum,
        max_seen: new_max,
        buckets: lh.buckets
    };
}

pub fn latency_histogram_count(lh: LatencyHistogram) -> Int {
    return lh.total_count;
}

pub fn latency_histogram_avg(lh: LatencyHistogram) -> Int {
    let cnt: Int = lh.total_count;
    let zero: Int = 0;
    if cnt == zero {
        return 0;
    }
    let sum: Int = lh.sum_us;
    return sum / cnt;
}

pub fn latency_histogram_max(lh: LatencyHistogram) -> Int {
    return lh.max_seen;
}

pub fn latency_histogram_percentile(lh: LatencyHistogram, pct: Int) -> Int {
    let cnt: Int = lh.total_count;
    let hundred: Int = 100;
    let mult: Int = cnt * pct;
    return mult / hundred;
}
