// # Reader-writer lock tracker
//
// Logline: Coordinate concurrent shared read locks and exclusive single-writer locks.
//
// Setup: Reader-writer lock state tracking without external capability dependencies.
//
// Beats:
//   1. Initialize reader-writer lock with zero active readers and unlocked writer.
//   2. Acquire and release shared read locks while tracking active reader counts.
//   3. Acquire and release exclusive write locks with owner validation.

type RwLock = struct {
    lock_id: String,
    reader_count: Int,
    writer_active: Bool,
    writer_holder: String,
    read_count: Int,
    write_count: Int,
    upgrade_count: Int,
    wait_count: Int
};

pub fn rwlock_create(lock_id: String) -> RwLock {
    return RwLock {
        lock_id: lock_id,
        reader_count: 0,
        writer_active: false,
        writer_holder: "",
        read_count: 0,
        write_count: 0,
        upgrade_count: 0,
        wait_count: 0
    };
}

pub fn rwlock_read_lock(l: RwLock) -> RwLock {
    let writing: Bool = l.writer_active;
    if writing {
        return RwLock {
            lock_id: l.lock_id,
            reader_count: l.reader_count,
            writer_active: l.writer_active,
            writer_holder: l.writer_holder,
            read_count: l.read_count,
            write_count: l.write_count,
            upgrade_count: l.upgrade_count,
            wait_count: l.wait_count + 1
        };
    }
    return RwLock {
        lock_id: l.lock_id,
        reader_count: l.reader_count + 1,
        writer_active: l.writer_active,
        writer_holder: l.writer_holder,
        read_count: l.read_count + 1,
        write_count: l.write_count,
        upgrade_count: l.upgrade_count,
        wait_count: l.wait_count
    };
}

pub fn rwlock_read_unlock(l: RwLock) -> RwLock {
    let cur: Int = l.reader_count;
    let zero: Int = 0;
    let no_readers: Bool = cur == zero;
    if no_readers {
        return l;
    }
    return RwLock {
        lock_id: l.lock_id,
        reader_count: cur - 1,
        writer_active: l.writer_active,
        writer_holder: l.writer_holder,
        read_count: l.read_count,
        write_count: l.write_count,
        upgrade_count: l.upgrade_count,
        wait_count: l.wait_count
    };
}

pub fn rwlock_write_lock(l: RwLock, holder: String) -> RwLock {
    let readers: Int = l.reader_count;
    let has_readers: Bool = readers > 0;
    let has_writer: Bool = l.writer_active;
    let busy: Bool = has_readers || has_writer;
    if busy {
        return RwLock {
            lock_id: l.lock_id,
            reader_count: l.reader_count,
            writer_active: l.writer_active,
            writer_holder: l.writer_holder,
            read_count: l.read_count,
            write_count: l.write_count,
            upgrade_count: l.upgrade_count,
            wait_count: l.wait_count + 1
        };
    }
    return RwLock {
        lock_id: l.lock_id,
        reader_count: 0,
        writer_active: true,
        writer_holder: holder,
        read_count: l.read_count,
        write_count: l.write_count + 1,
        upgrade_count: l.upgrade_count,
        wait_count: l.wait_count
    };
}

pub fn rwlock_write_unlock(l: RwLock) -> RwLock {
    return RwLock {
        lock_id: l.lock_id,
        reader_count: l.reader_count,
        writer_active: false,
        writer_holder: "",
        read_count: l.read_count,
        write_count: l.write_count,
        upgrade_count: l.upgrade_count,
        wait_count: l.wait_count
    };
}

pub fn rwlock_active_readers(l: RwLock) -> Int {
    return l.reader_count;
}

pub fn rwlock_write_count(l: RwLock) -> Int {
    return l.write_count;
}

pub fn rwlock_wait_count(l: RwLock) -> Int {
    return l.wait_count;
}

pub fn rwlock_writer_active(l: RwLock) -> Bool {
    return l.writer_active;
}
