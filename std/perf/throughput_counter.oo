// # Windowed throughput counter
//
// Logline: Measure event throughput across rolling time windows to compute current and peak rates.
//
// Setup: Monotonic timestamp inputs in milliseconds.
//
// Beats:
//   1. Initialize throughput counter with window size duration.
//   2. Record incoming events and advance window timestamps upon expiration.
//   3. Calculate current window event rate and track all-time peak throughput.

type ThroughputCounter = struct {
    counter_id: String,
    window_size_ms: Int,
    event_count: Int,
    last_window_ts: Int,
    current_window_count: Int,
    peak_rate: Int,
    total_events: Int,
    last_event_ts: Int
};

pub fn throughput_counter_create(counter_id: String, window_ms: Int) -> ThroughputCounter {
    return ThroughputCounter {
        counter_id: counter_id,
        window_size_ms: window_ms,
        event_count: 0,
        last_window_ts: 0,
        current_window_count: 0,
        peak_rate: 0,
        total_events: 0,
        last_event_ts: 0
    };
}

pub fn throughput_counter_record(tc: ThroughputCounter, ts: Int) -> ThroughputCounter {
    let cur_total: Int = tc.total_events;
    let new_total: Int = cur_total + 1;
    let last_ts: Int = tc.last_window_ts;
    let elapsed: Int = ts - last_ts;
    let win: Int = tc.window_size_ms;
    let overflow: Bool = elapsed >= win;
    let cur_win: Int = tc.current_window_count;
    let next_win: Int = cur_win + 1;
    let new_window_count: Int = if overflow { 1 } else { next_win };
    let new_last_ts: Int = if overflow { ts } else { last_ts };
    let cur_peak: Int = tc.peak_rate;
    let higher: Bool = new_window_count > cur_peak;
    let new_peak: Int = if higher { new_window_count } else { cur_peak };
    return ThroughputCounter {
        counter_id: tc.counter_id,
        window_size_ms: tc.window_size_ms,
        event_count: tc.event_count + 1,
        last_window_ts: new_last_ts,
        current_window_count: new_window_count,
        peak_rate: new_peak,
        total_events: new_total,
        last_event_ts: ts
    };
}

pub fn throughput_counter_current_rate(tc: ThroughputCounter, ts: Int) -> Int {
    let last_ts: Int = tc.last_window_ts;
    let elapsed: Int = ts - last_ts;
    let win: Int = tc.window_size_ms;
    let overflow: Bool = elapsed >= win;
    let cnt: Int = tc.current_window_count;
    if overflow {
        return 0;
    }
    return cnt;
}

pub fn throughput_counter_peak(tc: ThroughputCounter) -> Int {
    return tc.peak_rate;
}

pub fn throughput_counter_total(tc: ThroughputCounter) -> Int {
    return tc.total_events;
}
