// # Fixed-size object slab allocator
//
// Logline: Allocate and free uniform fixed-size memory objects using partitioned slabs.
//
// Setup: In-memory slab management without external capability dependencies.
//
// Beats:
//   1. Initialize slab allocator with fixed object size and slab capacity.
//   2. Allocate object slots from available slabs or grow slab count.
//   3. Free object slots and compute slab utilization metrics.

type Slab = struct {
    slab_id: String,
    object_size: Int,
    objects_per_slab: Int,
    slabs_allocated: Int,
    total_objects: Int,
    allocated_objects: Int,
    alloc_count: Int,
    free_count: Int
};

pub fn slab_create(slab_id: String, object_size: Int, objects_per_slab: Int) -> Slab {
    return Slab {
        slab_id: slab_id,
        object_size: object_size,
        objects_per_slab: objects_per_slab,
        slabs_allocated: 0,
        total_objects: 0,
        allocated_objects: 0,
        alloc_count: 0,
        free_count: 0
    };
}

pub fn slab_grow(s: Slab) -> Slab {
    let cur_slabs: Int = s.slabs_allocated;
    let cur_total: Int = s.total_objects;
    let add: Int = s.objects_per_slab;
    return Slab {
        slab_id: s.slab_id,
        object_size: s.object_size,
        objects_per_slab: s.objects_per_slab,
        slabs_allocated: cur_slabs + 1,
        total_objects: cur_total + add,
        allocated_objects: s.allocated_objects,
        alloc_count: s.alloc_count,
        free_count: s.free_count + add
    };
}

pub fn slab_alloc(s: Slab) -> Slab {
    let free: Int = s.free_count;
    let zero: Int = 0;
    let empty: Bool = free == zero;
    if empty {
        return s;
    }
    return Slab {
        slab_id: s.slab_id,
        object_size: s.object_size,
        objects_per_slab: s.objects_per_slab,
        slabs_allocated: s.slabs_allocated,
        total_objects: s.total_objects,
        allocated_objects: s.allocated_objects + 1,
        alloc_count: s.alloc_count + 1,
        free_count: s.free_count - 1
    };
}

pub fn slab_free(s: Slab) -> Slab {
    let used: Int = s.allocated_objects;
    let zero: Int = 0;
    let no_used: Bool = used == zero;
    if no_used {
        return s;
    }
    return Slab {
        slab_id: s.slab_id,
        object_size: s.object_size,
        objects_per_slab: s.objects_per_slab,
        slabs_allocated: s.slabs_allocated,
        total_objects: s.total_objects,
        allocated_objects: s.allocated_objects - 1,
        alloc_count: s.alloc_count,
        free_count: s.free_count + 1
    };
}

pub fn slab_utilization(s: Slab) -> Int {
    let total: Int = s.total_objects;
    let zero: Int = 0;
    if total == zero {
        return 0;
    }
    let hundred: Int = 100;
    return (s.allocated_objects * hundred) / total;
}

pub fn slab_allocated(s: Slab) -> Int {
    return s.allocated_objects;
}

pub fn slab_free_count(s: Slab) -> Int {
    return s.free_count;
}
