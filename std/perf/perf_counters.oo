// # CPU hardware and software performance counters
//
// Logline: Capture CPU cycles, instructions, cache misses, and branch mispredictions for profiling.
//
// Setup: Performance counter snapshots from execution measurements.
//
// Beats:
//   1. Initialize performance counter snapshots with zeroed baseline metrics.
//   2. Record sampled hardware event counts including cycles and cache misses.
//   3. Compute instructions per cycle and evaluate performance ratios.

type PerfCounters = struct {
    counters_id: String,
    cycles: Int,
    instructions: Int,
    cache_misses: Int,
    branch_misses: Int,
    page_faults: Int,
    context_switches: Int,
    read_count: Int
};

pub fn perf_counters_create(counters_id: String) -> PerfCounters {
    return PerfCounters {
        counters_id: counters_id,
        cycles: 0,
        instructions: 0,
        cache_misses: 0,
        branch_misses: 0,
        page_faults: 0,
        context_switches: 0,
        read_count: 0
    };
}

pub fn perf_counters_add_cycles(p: PerfCounters, n: Int) -> PerfCounters {
    return PerfCounters {
        counters_id: p.counters_id,
        cycles: p.cycles + n,
        instructions: p.instructions,
        cache_misses: p.cache_misses,
        branch_misses: p.branch_misses,
        page_faults: p.page_faults,
        context_switches: p.context_switches,
        read_count: p.read_count
    };
}

pub fn perf_counters_add_instructions(p: PerfCounters, n: Int) -> PerfCounters {
    return PerfCounters {
        counters_id: p.counters_id,
        cycles: p.cycles,
        instructions: p.instructions + n,
        cache_misses: p.cache_misses,
        branch_misses: p.branch_misses,
        page_faults: p.page_faults,
        context_switches: p.context_switches,
        read_count: p.read_count
    };
}

pub fn perf_counters_add_cache_miss(p: PerfCounters) -> PerfCounters {
    return PerfCounters {
        counters_id: p.counters_id,
        cycles: p.cycles,
        instructions: p.instructions,
        cache_misses: p.cache_misses + 1,
        branch_misses: p.branch_misses,
        page_faults: p.page_faults,
        context_switches: p.context_switches,
        read_count: p.read_count
    };
}

pub fn perf_counters_cycles(p: PerfCounters) -> Int {
    return p.cycles;
}

pub fn perf_counters_instructions(p: PerfCounters) -> Int {
    return p.instructions;
}

pub fn perf_counters_cache_misses(p: PerfCounters) -> Int {
    return p.cache_misses;
}

pub fn perf_counters_ipc(p: PerfCounters) -> Int {
    let c: Int = p.cycles;
    let zero: Int = 0;
    if c == zero {
        return 0;
    }
    let ins: Int = p.instructions;
    return ins / c;
}

pub fn perf_counters_cache_miss_rate(p: PerfCounters) -> Int {
    let insns: Int = p.instructions;
    let hundred: Int = 100;
    if insns == 0 {
        return 0;
    }
    let misses: Int = p.cache_misses;
    return (misses * hundred) / insns;
}
