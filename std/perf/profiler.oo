// # Function execution profiler
//
// Logline: Record function execution durations and call counts to identify performance bottlenecks.
//
// Setup: In-memory profiling registry without external capability dependencies.
//
// Beats:
//   1. Register profiling entries for named execution scopes.
//   2. Record function invocation durations and aggregate cumulative runtime.
//   3. Track minimum, maximum, and total execution times across profile entries.

pub type ProfileEntry = struct {
    function_name: String,
    call_count: Int,
    total_ns: Int,
    max_ns: Int,
    min_ns: Int,
};

pub type Profiler = struct {
    profiler_id: String,
    entries: List[ProfileEntry>,
    total_entries: Int,
    start_ns: Int,
    active: Bool,
};

pub fn profiler_create(profiler_id: String) -> Profiler {
    return Profiler {
        profiler_id: profiler_id,
        entries: list_new(),
        total_entries: 0,
        start_ns: 0,
        active: false,
    };
}

pub fn profiler_record(p: Profiler, name: String, elapsed_ns: Int) -> Profiler {
    let entry: ProfileEntry = ProfileEntry {
        function_name: name,
        call_count: 1,
        total_ns: elapsed_ns,
        max_ns: elapsed_ns,
        min_ns: elapsed_ns,
    };
    return Profiler {
        profiler_id: p.profiler_id,
        entries: list_push(p.entries, entry),
        total_entries: p.total_entries + 1,
        start_ns: p.start_ns,
        active: p.active,
    };
}

pub fn profiler_start(t: Profiler, start_ns: Int) -> Profiler {
    return Profiler {
        profiler_id: t.profiler_id,
        entries: t.entries,
        total_entries: t.total_entries,
        start_ns: start_ns,
        active: true,
    };
}

pub fn profiler_stop(t: Profiler) -> Profiler {
    return Profiler {
        profiler_id: t.profiler_id,
        entries: t.entries,
        total_entries: t.total_entries,
        start_ns: t.start_ns,
        active: false,
    };
}

pub fn profiler_count(p: &Profiler) -> Int {
    return (p).total_entries;
}

pub fn profiler_is_active(p: &Profiler) -> Bool {
    return (p).active;
}
