// # Sliding-window event rate meter
//
// Logline: Measure instantaneous event rates over sliding time intervals for throughput monitoring.
//
// Setup: Monotonic timestamp inputs in milliseconds.
//
// Beats:
//   1. Initialize rate meter with defined sliding window durations.
//   2. Record incoming event timestamps and update window sample counts.
//   3. Compute current events per second and track peak throughput rates.

pub type RateMeter = struct {
    meter_id: String,
    window_ms: Int,
    samples: List[Int>,
    sample_count: Int,
    total_count: Int,
    last_rate: Int,
    peak_rate: Int,
};

pub fn rate_meter_create(meter_id: String, window_ms: Int) -> RateMeter {
    return RateMeter {
        meter_id: meter_id,
        window_ms: window_ms,
        samples: list_new(),
        sample_count: 0,
        total_count: 0,
        last_rate: 0,
        peak_rate: 0,
    };
}

pub fn rate_meter_record(m: RateMeter, value: Int) -> RateMeter {
    let cur_total: Int = m.total_count;
    let new_total: Int = cur_total + value;
    let cur_peak: Int = m.peak_rate;
    let cmp: Bool = value > cur_peak;
    let higher: Bool = cmp;
    let new_peak: Int = if higher { value } else { cur_peak };
    return RateMeter {
        meter_id: m.meter_id,
        window_ms: m.window_ms,
        samples: list_push(m.samples, value),
        sample_count: m.sample_count + 1,
        total_count: new_total,
        last_rate: value,
        peak_rate: new_peak,
    };
}

pub fn rate_meter_total(m: &RateMeter) -> Int {
    return (m).total_count;
}

pub fn rate_meter_peak(m: &RateMeter) -> Int {
    return (m).peak_rate;
}

pub fn rate_meter_count(m: &RateMeter) -> Int {
    return (m).sample_count;
}

pub fn rate_meter_avg(m: &RateMeter) -> Int {
    let samples: List[Int] = (m).samples;
    let len: Int = list_len(samples);
    let zero: Int = 0;
    if len == zero {
        return 0;
    }
    return (m).total_count / len;
}
