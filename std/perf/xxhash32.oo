// # XXH32 one-shot
//
// Logline: Mix little-endian 32-bit lanes with the official XXH32 primes and avalanche.
//
// Setup: Pure Int bitwise ops. Seed 0. No caps.
//
// Beats:
//   1. Sixteen-byte stripes use four accumulators; shorter input starts at prime5.
//   2. Mix leftover 4-byte and 1-byte tails.
//   3. Avalanche and return 32 bits.

fn xx_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn xx_rotl(x: Int, r: Int) -> Int {
    let mask: Int = 4294967295;
    let v: Int = x & mask;
    let left: Int = (v << r) & mask;
    let right: Int = v >> (32 - r);
    return (left | right) & mask;
}

fn xx_le32(data: String, off: Int) -> Int {
    let b0: Int = byte_at(data, off);
    let b1: Int = byte_at(data, off + 1);
    let b2: Int = byte_at(data, off + 2);
    let b3: Int = byte_at(data, off + 3);
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}

fn xx_round(acc: Int, input: Int) -> Int {
    let mask: Int = 4294967295;
    let p1: Int = 2654435761;
    let p2: Int = 2246822519;
    let mut a: Int = (acc + ((input * p2) & mask)) & mask;
    a = xx_rotl(a, 13);
    return (a * p1) & mask;
}

fn xx_avalanche(h0: Int) -> Int {
    let mask: Int = 4294967295;
    let p2: Int = 2246822519;
    let p3: Int = 3266489917;
    let mut h: Int = h0;
    h = xx_xor(h, h >> 15);
    h = (h * p2) & mask;
    h = xx_xor(h, h >> 13);
    h = (h * p3) & mask;
    h = xx_xor(h, h >> 16);
    return h & mask;
}

pub fn xxhash32(data: String) -> Int {
    let seed: Int = 0;
    let mask: Int = 4294967295;
    let p1: Int = 2654435761;
    let p2: Int = 2246822519;
    let p3: Int = 3266489917;
    let p4: Int = 668265263;
    let p5: Int = 374761393;
    let n: Int = data.len();
    let mut pos: Int = 0;
    let mut h: Int = 0;
    if n >= 16 {
        let mut v1: Int = (seed + p1 + p2) & mask;
        let mut v2: Int = (seed + p2) & mask;
        let mut v3: Int = seed & mask;
        let mut v4: Int = (seed - p1) & mask;
        let limit: Int = n - 16;
        while pos <= limit {
            v1 = xx_round(v1, xx_le32(data, pos));
            v2 = xx_round(v2, xx_le32(data, pos + 4));
            v3 = xx_round(v3, xx_le32(data, pos + 8));
            v4 = xx_round(v4, xx_le32(data, pos + 12));
            pos = pos + 16;
        }
        let r1: Int = xx_rotl(v1, 1);
        let r2: Int = xx_rotl(v2, 7);
        let r3: Int = xx_rotl(v3, 12);
        let r4: Int = xx_rotl(v4, 18);
        let s12: Int = r1 + r2;
        let s34: Int = r3 + r4;
        h = (s12 + s34) & mask;
    } else {
        h = (seed + p5) & mask;
    }
    h = (h + n) & mask;
    while pos + 4 <= n {
        h = (h + ((xx_le32(data, pos) * p3) & mask)) & mask;
        h = (xx_rotl(h, 17) * p4) & mask;
        pos = pos + 4;
    }
    while pos < n {
        let b: Int = byte_at(data, pos);
        h = (h + ((b * p5) & mask)) & mask;
        h = (xx_rotl(h, 11) * p1) & mask;
        pos = pos + 1;
    }
    return xx_avalanche(h);
}
