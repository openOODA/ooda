// # Mutex lock state tracker
//
// Logline: Track mutual exclusion lock ownership, contention counts, and acquisition states.
//
// Setup: Mutex lock state tracking without external capability dependencies.
//
// Beats:
//   1. Initialize mutex locks in unlocked state with tracking IDs.
//   2. Acquire locks by recording owning thread identifiers and tracking contention.
//   3. Release locks and query lock availability metrics.

type Mutex = struct {
    lock_id: String,
    is_held: Bool,
    holder: String,
    acquire_count: Int,
    release_count: Int,
    contention_count: Int,
    wait_ns_total: Int
};

pub fn mutex_create(lock_id: String) -> Mutex {
    return Mutex {
        lock_id: lock_id,
        is_held: false,
        holder: "",
        acquire_count: 0,
        release_count: 0,
        contention_count: 0,
        wait_ns_total: 0
    };
}

pub fn mutex_acquire(m: Mutex, holder: String) -> Mutex {
    let already: Bool = m.is_held;
    if already {
        return Mutex {
            lock_id: m.lock_id,
            is_held: true,
            holder: holder,
            acquire_count: m.acquire_count,
            release_count: m.release_count,
            contention_count: m.contention_count + 1,
            wait_ns_total: m.wait_ns_total
        };
    }
    return Mutex {
        lock_id: m.lock_id,
        is_held: true,
        holder: holder,
        acquire_count: m.acquire_count + 1,
        release_count: m.release_count,
        contention_count: m.contention_count,
        wait_ns_total: m.wait_ns_total
    };
}

pub fn mutex_release(m: Mutex) -> Mutex {
    let held: Bool = m.is_held;
    if held == false {
        return m;
    }
    return Mutex {
        lock_id: m.lock_id,
        is_held: false,
        holder: "",
        acquire_count: m.acquire_count,
        release_count: m.release_count + 1,
        contention_count: m.contention_count,
        wait_ns_total: m.wait_ns_total
    };
}

pub fn mutex_is_held(m: Mutex) -> Bool {
    return m.is_held;
}

pub fn mutex_acquire_count(m: Mutex) -> Int {
    return m.acquire_count;
}

pub fn mutex_contention_count(m: Mutex) -> Int {
    return m.contention_count;
}
