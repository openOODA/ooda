// # Reusable variable-size buffer pool
//
// Logline: Manage pools of recyclable fixed-class byte buffers to minimize heap allocation overhead.
//
// Setup: In-memory buffer pooling without external capability dependencies.
//
// Beats:
//   1. Initialize buffer pools with designated size classes and capacity limits.
//   2. Acquire available buffers and update in-use and allocation attempt counters.
//   3. Release recycled buffers and calculate pool utilization rates.

type BufferPool = struct {
    pool_id: String,
    size_class: Int,
    capacity: Int,
    used: Int,
    alloc_count: Int,
    free_count: Int,
    alloc_attempts: Int
};

pub fn buffer_pool_create(pool_id: String, size_class: Int, capacity: Int) -> BufferPool {
    return BufferPool {
        pool_id: pool_id,
        size_class: size_class,
        capacity: capacity,
        used: 0,
        alloc_count: 0,
        free_count: capacity,
        alloc_attempts: 0
    };
}

pub fn buffer_pool_alloc(p: BufferPool) -> BufferPool {
    let cur_attempts: Int = p.alloc_attempts;
    let new_attempts: Int = cur_attempts + 1;
    let free: Int = p.free_count;
    let zero: Int = 0;
    let empty: Bool = free == zero;
    if empty {
        return BufferPool {
            pool_id: p.pool_id,
            size_class: p.size_class,
            capacity: p.capacity,
            used: p.used,
            alloc_count: p.alloc_count,
            free_count: p.free_count,
            alloc_attempts: new_attempts
        };
    }
    return BufferPool {
        pool_id: p.pool_id,
        size_class: p.size_class,
        capacity: p.capacity,
        used: p.used + 1,
        alloc_count: p.alloc_count + 1,
        free_count: p.free_count - 1,
        alloc_attempts: new_attempts
    };
}

pub fn buffer_pool_free(p: BufferPool) -> BufferPool {
    let used: Int = p.used;
    let zero: Int = 0;
    let no_used: Bool = used == zero;
    if no_used {
        return p;
    }
    return BufferPool {
        pool_id: p.pool_id,
        size_class: p.size_class,
        capacity: p.capacity,
        used: p.used - 1,
        alloc_count: p.alloc_count,
        free_count: p.free_count + 1,
        alloc_attempts: p.alloc_attempts
    };
}

pub fn buffer_pool_used(p: BufferPool) -> Int {
    return p.used;
}

pub fn buffer_pool_alloc_count(p: BufferPool) -> Int {
    return p.alloc_count;
}

pub fn buffer_pool_attempts(p: BufferPool) -> Int {
    return p.alloc_attempts;
}

pub fn buffer_pool_hit_rate(p: BufferPool) -> Int {
    let attempts: Int = p.alloc_attempts;
    let zero: Int = 0;
    if attempts == zero {
        return 0;
    }
    let hundred: Int = 100;
    let hits: Int = p.alloc_count;
    return (hits * hundred) / attempts;
}
