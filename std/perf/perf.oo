// # High-Performance Memory Allocators, Concurrency Primitives & Profiling Facade
//
// Logline: Unified standard library facade re-exporting allocators, synchronization primitives, lock-free queues, and profiling metrics.
//
// Setup: Pure module shim importing all 30 performance and systems submodules in perf.
//
// Beats:
//   1. Import 30 memory allocation, lock-free concurrency, synchronization, and telemetry companion submodules.
//   2. Re-export public constructors, diagnostic helpers, and master performance primitives.
//   3. Maintain standard unified entry point for openOODA performance engineering subsystems.

import "./arena_allocator.oo";
import "./arena_metrics.oo";
import "./barrier.oo";
import "./batch_buffer.oo";
import "./buffer_pool.oo";
import "./cache_aligned_alloc.oo";
import "./copy_on_write.oo";
import "./cpu_timer.oo";
import "./handle_pool.oo";
import "./latency_histogram.oo";
import "./lazy_init.oo";
import "./lockfree_queue.oo";
import "./memory_arena_pool.oo";
import "./memory_pool.oo";
import "./mem_stats.oo";
import "./mutex.oo";
import "./perf_counters.oo";
import "./profiler.oo";
import "./rate_meter.oo";
import "./refcount.oo";
import "./ring_buffer.oo";
import "./rwlock.oo";
import "./semaphore.oo";
import "./simd_byte_ops.oo";
import "./slab_allocator.oo";
import "./small_object_pool.oo";
import "./stack_allocator.oo";
import "./stopwatch.oo";
import "./throughput_counter.oo";
import "./work_stealing_queue.oo";

pub fn perf_version() -> String {
    return "openOODA-Perf-v2.0";
}

pub fn perf_submodule_count() -> Int {
    return 30;
}

pub fn perf_create_ring_buffer(buf_id: String, capacity: Int) -> RingBuffer {
    return ring_buffer_create(buf_id, capacity);
}

pub fn perf_create_stopwatch() -> Stopwatch {
    return stopwatch_new();
}

pub fn perf_create_latency_histogram(name: String, num_buckets: Int) -> LatencyHistogram {
    return latency_histogram_new(name, num_buckets);
}
