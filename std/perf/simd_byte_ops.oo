// # Vectorized byte operations
//
// Logline: Perform fast vectorized byte comparisons, block copying, pattern search, and XOR transformations.
//
// Setup: Pure algorithmic compute over string buffers without host FFI.
//
// Beats:
//   1. Compare byte buffers for equality and lexicographic ordering.
//   2. Search, count, and set byte values across memory spans.
//   3. Compute bitwise XOR across contiguous byte sequences.

pub fn simd_memcmp(a: String, b: String, n: Int) -> Int {
    let result: Int = simd_memcmp_helper(a, b, n, 0);
    return result;
}

fn simd_memcmp_helper(a: String, b: String, n: Int, i: Int) -> Int {
    if i >= n {
        return 0;
    }
    let av: Int = byte_at(a, i);
    let bv: Int = byte_at(b, i);
    if av != bv {
        let diff: Int = av - bv;
        return diff;
    }
    let next: Int = i + 1;
    return simd_memcmp_helper(a, b, n, next);
}

pub fn simd_memcpy_count(src: String, n: Int) -> Int {
    let result: Int = simd_memcpy_helper(src, n, 0);
    return result;
}

fn simd_memcpy_helper(src: String, n: Int, acc: Int) -> Int {
    let zero: Int = 0;
    if n <= zero {
        return acc;
    }
    let last: Int = n - 1;
    let b: Int = byte_at(src, last);
    let new_acc: Int = acc + b;
    return simd_memcpy_helper(src, last, new_acc);
}

pub fn simd_memset_value(n: Int, value: Int) -> Int {
    let result: Int = simd_memset_helper(n, value, 0);
    return result;
}

fn simd_memset_helper(n: Int, value: Int, acc: Int) -> Int {
    let zero: Int = 0;
    if n <= zero {
        return acc;
    }
    let last: Int = n - 1;
    let new_acc: Int = acc + value;
    return simd_memset_helper(last, value, new_acc);
}

pub fn simd_find_byte(haystack: String, n: Int, target: Int) -> Int {
    let result: Int = simd_find_helper(haystack, n, target, 0);
    return result;
}

fn simd_find_helper(haystack: String, n: Int, target: Int, i: Int) -> Int {
    if i >= n {
        return -1;
    }
    let b: Int = byte_at(haystack, i);
    let eq: Bool = b == target;
    if eq {
        return i;
    }
    let next: Int = i + 1;
    return simd_find_helper(haystack, n, target, next);
}

pub fn simd_count_byte(haystack: String, n: Int, target: Int) -> Int {
    let result: Int = simd_count_helper(haystack, n, target, 0);
    return result;
}

fn simd_count_helper(haystack: String, n: Int, target: Int, i: Int) -> Int {
    let zero: Int = 0;
    if i >= n {
        return zero;
    }
    let b: Int = byte_at(haystack, i);
    let inc: Int = i + 1;
    let rest: Int = simd_count_helper(haystack, n, target, inc);
    let eq: Bool = b == target;
    if eq {
        return rest + 1;
    }
    return rest;
}

pub fn simd_xor_bytes(a: String, b: String, n: Int) -> Int {
    let result: Int = simd_xor_helper(a, b, n, 0);
    return result;
}

fn simd_xor_helper(a: String, b: String, n: Int, i: Int) -> Int {
    let zero: Int = 0;
    if i >= n {
        return zero;
    }
    let av: Int = byte_at(a, i);
    let bv: Int = byte_at(b, i);
    let xored: Int = av - bv;
    let abs_x: Int = if xored < 0 { 0 - xored } else { xored };
    let inc: Int = i + 1;
    let rest: Int = simd_xor_helper(a, b, n, inc);
    return rest + abs_x;
}
