// # Sprint 4 Integration Suite
//
// Logline: Drive telecom doppler shift, GIS haversine, and IoT deadband filter smoke tests.
//
// Setup: Imports telecom/doppler_shift.oo, gis_spatial/haversine.oo, and industrial_iot/deadband_filter.oo. CWD must be ooda/.
//
// Beats:
//   1. main: assert doppler_calc_shift_hz returns a positive Float.
//   2. main: assert haversine_distance_km returns a positive Float for LAX<->SFO.
//   3. main: drive deadband_filter_update and assert it reported a change.
//   4. main: print SPRINT4_INTEGRATION_SUITE_PASSED and process_exit(0).
//
// residual: smoke only; no DSP-grade validation.

import "src/ooda/telecom/doppler_shift.oo";
import "src/ooda/gis_spatial/haversine.oo";
import "src/ooda/industrial_iot/deadband_filter.oo";

pub fn main() {
    // 1. Telecom Doppler Test
    let shift: Float = doppler_calc_shift_hz(1000000000.0, 30.0, 0.0);
    if shift > 0.0 {
        println("TELECOM_DOPPLER: OK");
    }

    // 2. GIS Haversine Test
    let d_km: Float = haversine_distance_km(37.7749, -122.4194, 34.0522, -118.2437);
    if d_km > 0.0 {
        println("GIS_HAVERSINE: OK");
    }

    // 3. Industrial IoT Deadband Test
    let mut db: DeadbandFilter = deadband_filter_new(1.0);
    let updated: Bool = deadband_filter_update(&mut db, 10.0);
    if updated == true {
        println("IOT_DEADBAND: OK");
    }

    println("SPRINT4_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
