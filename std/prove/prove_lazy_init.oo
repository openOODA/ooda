// # Org std perf/lazy_init prove
//
// Logline: Fail-closed emit+gcc+run of destubbed one-shot lazy_init counts.
//
// Setup: Tree oodac emit-c. Int and Bool only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Fresh cell is not done. Mark done once. init_count is 1.
//   2. Second mark_done does not increase init_count.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/lazy_init.oo";

pub fn main() {
    let a0: LazyInit = lazy_init_create("cell");
    if lazy_init_is_done(a0) != false {
        println("FAIL lazy fresh");
        process_exit(1);
    }
    let a1: LazyInit = lazy_init_mark_done(a0);
    if lazy_init_is_done(a1) != true {
        println("FAIL lazy mark");
        process_exit(1);
    }
    if lazy_init_attempt_count(a1) != 1 {
        println("FAIL lazy count1");
        process_exit(1);
    }
    let a2: LazyInit = lazy_init_mark_done(a1);
    if lazy_init_attempt_count(a2) != 1 {
        println("FAIL lazy count2");
        process_exit(1);
    }
    println("org_std_lazy_init: PASSED");
}