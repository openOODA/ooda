// # Org std hmac_ops prove
//
// Logline: Fail-closed emit+gcc+run of shipped hex, checksum, and constant-time eq.
//
// Setup: Locked oodac. Calls src/ooda/sec/crypto/hmac_ops.oo. No caps.
//
// Beats:
//   1. hex_encode openOODA and require the known hex.
//   2. hex_decode that hex and require the same payload.
//   3. Equal tags match; a one-byte miss does not. Exit 1 before PASSED.

import "src/ooda/sec/crypto/hmac_ops.oo";

pub fn main() {
    let enc: String = hex_encode("openOODA");
    if enc != "6f70656e4f4f4441" {
        println("FAIL hex_encode");
        process_exit(1);
    }
    let dec_r: Result[String, String] = hex_decode(enc);
    if dec_r.is_err() {
        println("FAIL hex_decode err");
        process_exit(1);
    }
    let dec: String = dec_r.unwrap();
    if dec != "openOODA" {
        println("FAIL hex_decode");
        process_exit(1);
    }
    let odd: Result[String, String] = hex_decode("abc");
    if odd.is_ok() {
        println("FAIL hex_decode odd");
        process_exit(1);
    }
    if !bytes_constant_time_eq("tag", "tag") {
        println("FAIL cteq same");
        process_exit(1);
    }
    if bytes_constant_time_eq("tag", "tAg") {
        println("FAIL cteq miss");
        process_exit(1);
    }
    let sum: Int = checksum_calculate("openOODA");
    if sum == 0 {
        println("FAIL checksum");
        process_exit(1);
    }
    println("org_std_hmac_ops: PASSED");
}
