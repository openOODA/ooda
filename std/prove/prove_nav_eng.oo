// # Org std aero/navigation_engine prove
//
// Logline: Fail-closed emit+gcc+run of destubbed nav_eng fix_type and sats.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. nav_eng_new(3, 12) sats is 12.
//   2. fix_type is 3 (not sats).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation_engine.oo";

pub fn main() {
    let e: NavEng = nav_eng_new(3, 12);
    if nav_eng_sats(e) != 12 {
        println("FAIL neng sats");
        process_exit(1);
    }
    if nav_eng_fix_type(e) != 3 {
        println("FAIL neng fix");
        process_exit(1);
    }
    println("org_std_nav_eng: PASSED");
}
