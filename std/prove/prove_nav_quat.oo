// # Org std aero/navigation_quat prove
//
// Logline: Fail-closed emit+gcc+run of destubbed nav_quat w and x.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. nav_quat_new(1000, 7) w is 1000.
//   2. x is 7 (not w).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation_quat.oo";

pub fn main() {
    let q: NavQuat = nav_quat_new(1000, 7);
    if nav_quat_w(q) != 1000 {
        println("FAIL nquat w");
        process_exit(1);
    }
    if nav_quat_x(q) != 7 {
        println("FAIL nquat x");
        process_exit(1);
    }
    println("org_std_nav_quat: PASSED");
}
