// # Sparse Merkle Tree Compact Emit Smoke
//
// Logline: Drive a sparse Merkle tree insert via smt_compact_tree_new, smt_compact_node_new, and smt_compact_tree_add_node, then print test ok.
//
// Setup: Imports src/ooda/zk_rollup/sparse_merkle_tree_compact.oo. CWD must be ooda/.
//
// Beats:
//   1. main: build an SmtCompactTree with root 0x00.
//   2. main: allocate an SmtCompactNode with id 10 and a 101-bit path.
//   3. main: append the node to the tree and print test ok.
//
// residual: smoke only; no merkle proof verification.

import "src/ooda/zk_rollup/sparse_merkle_tree_compact.oo";

pub fn main() {
    let tree: SmtCompactTree = smt_compact_tree_new("0x00");
    let node: SmtCompactNode = smt_compact_node_new(10, "101", "0x01", true);
    let tree2: SmtCompactTree = smt_compact_tree_add_node(tree, node);
    println("test ok");
}
