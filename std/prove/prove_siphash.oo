// # Org std hash/siphash prove
//
// Logline: Fail-closed emit+gcc+run of shipped siphash24 against official vectors.
//
// Setup: Tree oodac emit-c. Calls hash/siphash.oo. Key 00..0f as two LE words.
//
// Beats:
//   1. Empty is 0x726fdb47dd0e0e31 (Aumasson/Bernstein vectors.h).
//   2. hello is 22433990042967937 (same key, independent spec impl).
//   3. Exit 1 before PASSED on a miss.

import "hash/siphash.oo";

pub fn main() {
    let k0: Int = 506097522914230528;
    let k1: Int = 1084818905618843912;
    let empty: Int = siphash24("", k0, k1);
    if empty != 8246050544436514353 {
        println("FAIL siphash empty");
        process_exit(1);
    }
    let h: Int = siphash24("hello", k0, k1);
    if h != 22433990042967937 {
        println("FAIL siphash hello");
        process_exit(1);
    }
    println("org_std_siphash: PASSED");
}
