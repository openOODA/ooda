// # Org std 3d/materials_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed mat_op albedo and rough.
//
// Setup: Tree oodac emit-c. Int channels only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. mat_op_new(40, 7) albedo is 40.
//   2. Rough is 7 (not albedo).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/materials_ops.oo";

pub fn main() {
    let op: MatOp = mat_op_new(40, 7);
    if mat_op_albedo(op) != 40 {
        println("FAIL mat albedo");
        process_exit(1);
    }
    if mat_op_rough(op) != 7 {
        println("FAIL mat rough");
        process_exit(1);
    }
    println("org_std_mat_op: PASSED");
}
