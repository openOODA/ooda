// # Org std aero/attitude_dcm prove
//
// Logline: Fail-closed emit+gcc+run of destubbed dcm_cell_new diagonals.
//
// Setup: Tree oodac emit-c. Int cells only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. dcm_cell_new(1, 0) r00 is 1.
//   2. r11 is 0 (not r00).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/attitude_dcm.oo";

pub fn main() {
    let c: DcmCell = dcm_cell_new(1, 0);
    if dcm_cell_r00(c) != 1 {
        println("FAIL dcm r00");
        process_exit(1);
    }
    if dcm_cell_r11(c) != 0 {
        println("FAIL dcm r11");
        process_exit(1);
    }
    let c2: DcmCell = dcm_cell_new(2, 3);
    if dcm_cell_r11(c2) != 3 {
        println("FAIL dcm r11b");
        process_exit(1);
    }
    println("org_std_dcm: PASSED");
}
