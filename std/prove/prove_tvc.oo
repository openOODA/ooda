// # Org std aero/tvc_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed TVC abs, clamp, and deg<->milli-rad.
//
// Setup: Tree oodac emit-c. Int milli-rad only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. abs(-7) is 7. clamp(12, 0, 10) is 10.
//   2. 180 deg is 3142 milli-rad. 3142 milli-rad is 180 deg.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/tvc_types.oo";

pub fn main() {
    let neg: Int = 0 - 7;
    if tvc_abs_milli(neg) != 7 {
        println("FAIL tvc abs");
        process_exit(1);
    }
    if tvc_clamp(12, 0, 10) != 10 {
        println("FAIL tvc clamp");
        process_exit(1);
    }
    if tvc_deg_to_milli_rad(180) != 3142 {
        println("FAIL tvc deg2rad");
        process_exit(1);
    }
    if tvc_milli_rad_to_deg(3142) != 180 {
        println("FAIL tvc rad2deg");
        process_exit(1);
    }
    println("org_std_tvc: PASSED");
}
