// # Org std aero/tvc facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed tvc_facade deg<->milli and clamp.
//
// Setup: Tree oodac emit-c. Int milli-rad only. Import tvc.oo only.
//
// Beats:
//   1. 90 deg is 1571 milli-rad. 1571 milli-rad is 90 deg.
//   2. abs(-9) is 9. clamp(20, 0, 8) is 8.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/tvc.oo";

pub fn main() {
    if tvc_facade_deg_to_milli(90) != 1571 {
        println("FAIL tvcf deg2milli");
        process_exit(1);
    }
    if tvc_facade_milli_to_deg(1571) != 90 {
        println("FAIL tvcf milli2deg");
        process_exit(1);
    }
    let neg: Int = 0 - 9;
    if tvc_facade_abs(neg) != 9 {
        println("FAIL tvcf abs");
        process_exit(1);
    }
    if tvc_facade_clamp(20, 0, 8) != 8 {
        println("FAIL tvcf clamp");
        process_exit(1);
    }
    println("org_std_tvc_facade: PASSED");
}
