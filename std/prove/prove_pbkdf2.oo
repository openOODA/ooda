// # Org std crypto/pbkdf2 prove
//
// Logline: Fail-closed emit+gcc+run of PBKDF2-HMAC-SHA256 for c=1 and c=2.
//
// Setup: Tree oodac emit-c. Vectors match RFC 6070-style SHA-256 test cases.
//
// Beats:
//   1. password/salt/c=1/dkLen=32 matches the published 32-byte hex.
//   2. password/salt/c=2/dkLen=32 matches the published c=2 hex.
//   3. Exit 1 before PASSED on a miss.

import "crypto/pbkdf2.oo";

pub fn main() {
    let dk1: String = pbkdf2_hmac_sha256("password", "salt", 1, 32);
    if dk1 != "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b" {
        println("FAIL pbkdf2 c1");
        process_exit(1);
    }
    let dk2: String = pbkdf2_hmac_sha256("password", "salt", 2, 32);
    if dk2 != "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" {
        println("FAIL pbkdf2 c2");
        process_exit(1);
    }
    println("org_std_pbkdf2: PASSED");
}

