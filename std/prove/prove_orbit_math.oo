// # Org std aero/orbit_math prove
//
// Logline: Fail-closed emit+gcc+run of destubbed orbit_math_add.
//
// Setup: Tree oodac emit-c. Int Vec3 only. Import orbit_math only.
//
// Beats:
//   1. (1,2,3)+(4,5,6) is (5,7,9).
//   2. Exit 1 before PASSED on a miss.

import "src/ooda/aero/orbit_math.oo";

pub fn main() {
    let a: Vec3 = orbit_vec3_new(1, 2, 3);
    let b: Vec3 = orbit_vec3_new(4, 5, 6);
    let s: Vec3 = orbit_math_add(a, b);
    if orbit_math_x(s) != 5 {
        println("FAIL orbit add x");
        process_exit(1);
    }
    if orbit_math_y(s) != 7 {
        println("FAIL orbit add y");
        process_exit(1);
    }
    if orbit_math_z(s) != 9 {
        println("FAIL orbit add z");
        process_exit(1);
    }
    println("org_std_orbit_math: PASSED");
}
