// # Org std Murmur3 prove
//
// Logline: Fail-closed emit+gcc+run of shipped murmur3_32 against SMHasher vectors.
//
// Setup: Locked oodac. Calls hash/murmur3.oo. Seed 0. No caps.
//
// Beats:
//   1. Empty is 0.
//   2. hello is 613153351.
//   3. Exit 1 before PASSED on any miss.

import "hash/murmur3.oo";

pub fn main() {
    let empty: Int = murmur3_32("");
    if empty != 0 {
        println("FAIL murmur empty");
        process_exit(1);
    }
    let h: Int = murmur3_32("hello");
    if h != 613153351 {
        println("FAIL murmur hello");
        process_exit(1);
    }
    println("org_std_murmur3: PASSED");
}
