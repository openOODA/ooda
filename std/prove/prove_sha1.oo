// # Org std hash/sha1 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/sha1.oo one-shot.
//
// Setup: Tree oodac emit-c. Calls sha1. RFC 3174 / FIPS vectors. No caps.
//
// Beats:
//   1. sha1("") is da39a3ee5e6b4b0d3255bfef95601890afd80709.
//   2. sha1("abc") is a9993e364706816aba3e25717850c26c9cd0d89d.
//   3. Exit 1 before PASSED on a miss.

import "hash/sha1.oo";

pub fn main() {
    let empty: String = sha1("");
    if empty != "da39a3ee5e6b4b0d3255bfef95601890afd80709" {
        println("FAIL sha1 empty");
        process_exit(1);
    }
    let abc: String = sha1("abc");
    if abc != "a9993e364706816aba3e25717850c26c9cd0d89d" {
        println("FAIL sha1 abc");
        process_exit(1);
    }
    println("org_std_sha1: PASSED");
}
