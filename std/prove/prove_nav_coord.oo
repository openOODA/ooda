// # Org std aero/navigation_coords prove
//
// Logline: Fail-closed emit+gcc+run of destubbed nav_coord lat and lon.
//
// Setup: Tree oodac emit-c. Int milli-deg only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. nav_coord_new(37774, -122419) lat is 37774.
//   2. Lon is -122419 (not lat).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation_coords.oo";

pub fn main() {
    let lon_v: Int = 0 - 122419;
    let c: NavCoord = nav_coord_new(37774, lon_v);
    if nav_coord_lat(c) != 37774 {
        println("FAIL ncoord lat");
        process_exit(1);
    }
    if nav_coord_lon(c) != lon_v {
        println("FAIL ncoord lon");
        process_exit(1);
    }
    println("org_std_nav_coord: PASSED");
}
