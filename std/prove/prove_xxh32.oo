// # Org std XXH32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped xxhash32 against official empty and hello vectors.
//
// Setup: Installed tree oodac emit-c. Calls src/ooda/perf/xxhash32.oo. Seed 0.
//
// Beats:
//   1. Empty is 46947589 (0x02CC5D05).
//   2. hello is 4211111929.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/xxhash32.oo";

pub fn main() {
    let empty: Int = xxhash32("");
    if empty != 46947589 {
        println("FAIL xxh32 empty");
        process_exit(1);
    }
    let h: Int = xxhash32("hello");
    if h != 4211111929 {
        println("FAIL xxh32 hello");
        process_exit(1);
    }
    println("org_std_xxh32: PASSED");
}
