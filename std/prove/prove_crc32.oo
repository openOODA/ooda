// # Org std CRC-32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped crc32 against the ISO-HDLC check vector.
//
// Setup: Locked oodac. Calls hash/crc32.oo. No caps.
//
// Beats:
//   1. Hash 123456789 and require 3421780262 (0xCBF43926).
//   2. Hash empty and require 0.
//   3. Exit 1 before PASSED on any miss.

import "hash/crc32.oo";

pub fn main() {
    let empty: Int = crc32("");
    if empty != 0 {
        println("FAIL crc32 empty");
        process_exit(1);
    }
    let v: Int = crc32("123456789");
    if v != 3421780262 {
        println("FAIL crc32 vector");
        process_exit(1);
    }
    println("org_std_crc32: PASSED");
}
