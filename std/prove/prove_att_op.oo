// # Org std aero/attitude_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed att_op roll and pitch.
//
// Setup: Tree oodac emit-c. Int angles only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. att_op_new(15, 30) roll is 15.
//   2. Pitch is 30 (not roll).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/attitude_ops.oo";

pub fn main() {
    let op: AttOp = att_op_new(15, 30);
    if att_op_roll(op) != 15 {
        println("FAIL att roll");
        process_exit(1);
    }
    if att_op_pitch(op) != 30 {
        println("FAIL att pitch");
        process_exit(1);
    }
    println("org_std_att_op: PASSED");
}
