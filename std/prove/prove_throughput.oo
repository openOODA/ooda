// # Org std perf/throughput_counter prove
//
// Logline: Fail-closed emit+gcc+run of destubbed window counts, totals, and peak.
//
// Setup: Tree oodac emit-c. Int timestamps only. No List[Float].
//
// Beats:
//   1. Three events inside a 1000ms window. Total 3. Current rate 3. Peak 3.
//   2. Fourth event at 2000ms starts a new window. Current rate 1. Peak stays 3.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/throughput_counter.oo";

pub fn main() {
    let c0: ThroughputCounter = throughput_counter_create("c", 1000);
    let c1: ThroughputCounter = throughput_counter_record(c0, 0);
    let c2: ThroughputCounter = throughput_counter_record(c1, 10);
    let c3: ThroughputCounter = throughput_counter_record(c2, 20);
    if throughput_counter_total(c3) != 3 {
        println("FAIL thr total3");
        process_exit(1);
    }
    if throughput_counter_current_rate(c3, 20) != 3 {
        println("FAIL thr rate3");
        process_exit(1);
    }
    if throughput_counter_peak(c3) != 3 {
        println("FAIL thr peak3");
        process_exit(1);
    }
    let c4: ThroughputCounter = throughput_counter_record(c3, 2000);
    if throughput_counter_total(c4) != 4 {
        println("FAIL thr total4");
        process_exit(1);
    }
    if throughput_counter_current_rate(c4, 2000) != 1 {
        println("FAIL thr rate1");
        process_exit(1);
    }
    if throughput_counter_peak(c4) != 3 {
        println("FAIL thr peak keep");
        process_exit(1);
    }
    println("org_std_throughput: PASSED");
}