// # Org std AES prove
//
// Logline: Fail-closed emit+gcc+run of shipped crypto/aes.oo one-shot.
//
// Setup: OPEN-80. Tree oodac. Calls destubbed aes_encrypt. No caps.
//
// Beats:
//   1. Encrypt one 16-byte block.
//   2. Require 32 hex chars and a stable repeat.
//   3. Exit 1 before PASSED on a miss.

import "crypto/aes.oo";

pub fn main() {
    let c: String = aes_encrypt("0123456789abcdef", "0123456789abcdef");
    if chars_len(c) != 32 {
        println("FAIL aes len");
        process_exit(1);
    }
    if c == "STUB_FAIL_CLOSED" {
        println("FAIL aes stub");
        process_exit(1);
    }
    let again: String = aes_encrypt("0123456789abcdef", "0123456789abcdef");
    if again != c {
        println("FAIL aes repeat");
        process_exit(1);
    }
    println(c);
    println("open80: PASSED");
}
