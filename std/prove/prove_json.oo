// # Org std json prove
//
// Logline: Fail-closed emit+gcc+run of shipped json parse and stringify.
//
// Setup: Locked oodac. Calls json.oo. No caps.
//
// Beats:
//   1. Parse an object and require Ok of the same text.
//   2. Refuse a non-JSON prefix.
//   3. Stringify is identity. Exit 1 before PASSED on a miss.

import "json.oo";

pub fn main() {
    let raw: String = "{\"status\":\"ok\"}";
    let p: Result[String, String] = parse(raw);
    if p.is_err() {
        println("FAIL parse ok");
        process_exit(1);
    }
    let got: String = p.unwrap();
    if got != raw {
        println("FAIL parse payload");
        process_exit(1);
    }
    let empty: Result[String, String] = parse("");
    if empty.is_ok() {
        println("FAIL parse empty");
        process_exit(1);
    }
    let bad: Result[String, String] = parse("nope");
    if bad.is_ok() {
        println("FAIL parse nope");
        process_exit(1);
    }
    let s: String = stringify(raw);
    if s != raw {
        println("FAIL stringify");
        process_exit(1);
    }
    println("org_std_json: PASSED");
}
