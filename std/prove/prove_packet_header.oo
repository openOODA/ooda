// # Org std aero/telemetry_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed packet_header apid, seq, and len.
//
// Setup: Tree oodac emit-c. Int header fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. packet_header_new(42, 7, 128) apid is 42.
//   2. Seq is 7 (not apid). Len is 128.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/telemetry_types.oo";

pub fn main() {
    let h: PacketHeader = packet_header_new(42, 7, 128);
    if packet_header_apid(h) != 42 {
        println("FAIL pkt apid");
        process_exit(1);
    }
    if packet_header_seq(h) != 7 {
        println("FAIL pkt seq");
        process_exit(1);
    }
    if packet_header_len(h) != 128 {
        println("FAIL pkt len");
        process_exit(1);
    }
    println("org_std_packet_header: PASSED");
}
