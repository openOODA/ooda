// # Org std 3d/xr_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed xr_pose_new axes.
//
// Setup: Tree oodac emit-c. Int pose only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. xr_pose_new(4, 5, 6) x is 4.
//   2. Stored y is 5 (not x).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/xr_types.oo";

pub fn main() {
    let p: XrPose = xr_pose_new(4, 5, 6);
    if xr_pose_x(p) != 4 {
        println("FAIL xr x");
        process_exit(1);
    }
    let y: Int = p.y;
    let z: Int = p.z;
    if y != 5 {
        println("FAIL xr y");
        process_exit(1);
    }
    if z != 6 {
        println("FAIL xr z");
        process_exit(1);
    }
    println("org_std_xr_pose: PASSED");
}
