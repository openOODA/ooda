// # Org std hash/sha256 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/sha256.oo one-shot.
//
// Setup: Installed tree oodac. Calls sha256. No caps.
//
// Beats:
//   1. sha256(hello) matches the FIPS hex.
//   2. Exit 1 before PASSED on a miss.

import "hash/sha256.oo";

pub fn main() {
    let d: String = sha256("hello");
    if d != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        println("FAIL hash sha256");
        process_exit(1);
    }
    println("org_std_sha256: PASSED");
}
