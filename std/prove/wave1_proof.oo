// # Wave 1 fail-closed prove
//
// Logline: Ring buffer empty/push and a swarm dispatcher must hold or this exits 1.
//
// Setup: Org std swarm and perf modules. Not a 4072-file certification.
//
// Beats:
//   1. Empty ring, then push, require not empty.
//   2. Submit and route one dispatcher task.
//   3. Print PASSED only after those checks.

import "src/ooda/perf/ring_buffer.oo";
import "src/ooda/swarm/dispatch_types.oo";
import "src/ooda/swarm/dispatch_engine.oo";
import "src/ooda/swarm/dispatch_worker.oo";

pub fn main() {
    let rb0 = ring_buffer_create("test_buf", 4);
    if !ring_buffer_is_empty(rb0) {
        println("FAIL RING_EMPTY");
        process_exit(1);
    }
    let rb1 = ring_buffer_push(rb0);
    if ring_buffer_is_empty(rb1) {
        println("FAIL RING_PUSH");
        process_exit(1);
    }
    println("RING_EMPTY: OK");

    let cfg = dispatcher_config_struct(0, 32, 4, 1000, 2);
    let mut disp = SwarmDispatcher {
        config: cfg,
        total_submitted: 0,
        total_completed: 0,
        total_failed: 0,
        total_cancelled: 0,
        rr_cursor: 0,
        next_task_id: 1,
        active_worker_count: 1
    };

    let mut task = dispatcher_submit(&mut disp, 10, 42, 100);
    let mut worker = worker_node_struct(101, 1, 0, 2, 0, 0, 100);
    let res = dispatcher_route_task(&mut disp, &mut task, &mut worker);
    if res.success != true {
        println("FAIL ROUTE");
        process_exit(1);
    }
    dispatcher_process_completion(&mut disp, &mut task, &mut worker, true, 200);
    println("WAVE1_INTEGRATION_SUITE_PASSED");
}
