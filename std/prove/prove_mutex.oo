// # Org std perf/mutex prove
//
// Logline: Fail-closed emit+gcc+run of destubbed mutex acquire and contention.
//
// Setup: Tree oodac emit-c. Int counters only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. First acquire holds and sets acquire_count to 1.
//   2. Second acquire increments contention and not acquire_count.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/mutex.oo";

pub fn main() {
    let m0: Mutex = mutex_create("lk");
    let m1: Mutex = mutex_acquire(m0, "a");
    if mutex_is_held(m1) != true {
        println("FAIL mtx held");
        process_exit(1);
    }
    if mutex_acquire_count(m1) != 1 {
        println("FAIL mtx acq1");
        process_exit(1);
    }
    if mutex_contention_count(m1) != 0 {
        println("FAIL mtx cont0");
        process_exit(1);
    }
    let m2: Mutex = mutex_acquire(m1, "b");
    if mutex_acquire_count(m2) != 1 {
        println("FAIL mtx acq stay");
        process_exit(1);
    }
    if mutex_contention_count(m2) != 1 {
        println("FAIL mtx cont1");
        process_exit(1);
    }
    let m3: Mutex = mutex_release(m2);
    if mutex_is_held(m3) != false {
        println("FAIL mtx released");
        process_exit(1);
    }
    println("org_std_mutex: PASSED");
}