// # Org std crypto.oo prove
//
// Logline: Fail-closed emit+gcc+run of shipped sha256 and hmac_sha256 wrappers.
//
// Setup: Locked oodac. Calls crypto.oo. No caps.
//
// Beats:
//   1. sha256(hello) matches the FIPS hex.
//   2. hmac_sha256 of k,hello has length 64.
//   3. Empty key is empty. Exit 1 before PASSED on a miss.

import "crypto.oo";

pub fn main() {
    let d: String = sha256("hello");
    if d != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        println("FAIL sha256 wrap");
        process_exit(1);
    }
    let mac: String = hmac_sha256("k", "hello");
    if mac.len() != 64 {
        println("FAIL hmac len");
        process_exit(1);
    }
    let empty: String = hmac_sha256("", "hello");
    if empty != "" {
        println("FAIL hmac empty key");
        process_exit(1);
    }
    println("org_std_crypto: PASSED");
}
