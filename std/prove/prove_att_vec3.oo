// # Org std aero/attitude_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed att_vec3_new axes.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. att_vec3_new(7, 8, 9) x is 7.
//   2. y is 8 (not x). z is 9.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/attitude_types.oo";

pub fn main() {
    let v: AttVec3 = att_vec3_new(7, 8, 9);
    if att_vec3_x(v) != 7 {
        println("FAIL att x");
        process_exit(1);
    }
    if att_vec3_y(v) != 8 {
        println("FAIL att y");
        process_exit(1);
    }
    if att_vec3_z(v) != 9 {
        println("FAIL att z");
        process_exit(1);
    }
    println("org_std_att_vec3: PASSED");
}
