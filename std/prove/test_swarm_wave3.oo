// # Swarm Wave 3 Integration Suite
//
// Logline: Drive URDF robot model, 5G LDPC base graph, OPC-UA encoder, and QOI fast codec smoke tests.
//
// Setup: Imports robotics_ros2/urdf_robot_model.oo, telecom_5g/nr5g_ldpc_base_graph.oo, iot_scada/opcua_binary_encoder.oo, and media_dsp/qoi_fast_codec.oo. CWD must be ooda/.
//
// Beats:
//   1. main: build an UrdfRobotModel and assert model_id == 101.
//   2. main: build an Nr5gLdpcBaseGraph and assert nrows_mb > 0.
//   3. main: build an OpcUaEncoder and assert length == 0.
//   4. main: build a QoiHeader and assert width == 640.
//   5. main: print WAVE3_INTEGRATION_SUITE_PASSED and process_exit(0).
//
// residual: smoke only; no encoding round-trip.

import "src/ooda/robotics_ros2/urdf_robot_model.oo";
import "src/ooda/telecom_5g/nr5g_ldpc_base_graph.oo";
import "src/ooda/iot_scada/opcua_binary_encoder.oo";
import "src/ooda/media_dsp/qoi_fast_codec.oo";

pub fn main() {
    // 1. Robotics URDF Model Test
    let model: UrdfRobotModel = urdf_robot_model_new(101);
    if (model).model_id == 101 {
        println("ROBOTICS_URDF_MODEL: OK");
    }

    // 2. Telecom 5G LDPC Test
    let bg: Nr5gLdpcBaseGraph = nr5g_ldpc_base_graph_new(1, 384);
    if (bg).nrows_mb > 0 {
        println("TELECOM_5G_LDPC_BASE_GRAPH: OK");
    }

    // 3. SCADA OPC-UA Encoder Test
    let enc: OpcUaEncoder = opcua_encoder_new();
    if (enc).length == 0 {
        println("SCADA_OPCUA_ENCODER: OK");
    }

    // 4. Media QOI Codec Test
    let qoi: QoiHeader = qoi_header_new(640, 480, 4, 0);
    if (qoi).width == 640 {
        println("MEDIA_QOI_FAST_CODEC: OK");
    }

    println("WAVE3_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
