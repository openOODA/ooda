// # Org std zk_rollup/sparse_merkle_tree_compact prove
//
// Logline: Fail-closed verification of Sparse Merkle Tree compact representation, node insertions, and decompression.
//
// Setup: Tree oodac check and emit-c verification for SMT compact tree construction, node pruning, and decompression.
//
// Beats:
//   1. Construct empty compact tree with root hash and verify zero pruned levels.
//   2. Construct compact nodes with depth, path, value hash, and leaf flags.
//   3. Add depth 10 node and verify total_pruned_levels equals 246.
//   4. Add depth 20 node and verify total_pruned_levels accumulates to 482.
//   5. Decompress compact tree and verify full_root, expanded_nodes count, and validity.
//   6. Fail-closed on any mismatch; print org_std_smt_compact: PASSED on success.

import "src/ooda/zk_rollup/sparse_merkle_tree_compact.oo";

pub fn main() {
    let initial_root: String = "0x4a5b6c7d8e9f0123456789abcdef0123456789abcdef0123456789abcdef01";
    let tree0: SmtCompactTree = smt_compact_tree_new(initial_root);

    if (tree0).root_hash != initial_root {
        println("FAIL smt_compact tree0 root_hash");
        process_exit(1);
    }
    if (tree0).total_pruned_levels != 0 {
        println("FAIL smt_compact tree0 total_pruned_levels");
        process_exit(1);
    }

    let node1: SmtCompactNode = smt_compact_node_new(10, "1011001110", "0xleaf1", false);
    if (node1).bit_depth != 10 {
        println("FAIL smt_compact node1 bit_depth");
        process_exit(1);
    }
    if (node1).path_bits != "1011001110" {
        println("FAIL smt_compact node1 path_bits");
        process_exit(1);
    }
    if (node1).value_hash != "0xleaf1" {
        println("FAIL smt_compact node1 value_hash");
        process_exit(1);
    }
    if (node1).is_leaf != false {
        println("FAIL smt_compact node1 is_leaf");
        process_exit(1);
    }

    let tree1: SmtCompactTree = smt_compact_tree_add_node(tree0, node1);
    if (tree1).root_hash != initial_root {
        println("FAIL smt_compact tree1 root_hash");
        process_exit(1);
    }
    if (tree1).total_pruned_levels != 246 {
        println("FAIL smt_compact tree1 total_pruned_levels");
        process_exit(1);
    }

    let node2: SmtCompactNode = smt_compact_node_new(20, "11001100110011001100", "0xleaf2", true);
    if (node2).bit_depth != 20 {
        println("FAIL smt_compact node2 bit_depth");
        process_exit(1);
    }
    if (node2).path_bits != "11001100110011001100" {
        println("FAIL smt_compact node2 path_bits");
        process_exit(1);
    }
    if (node2).value_hash != "0xleaf2" {
        println("FAIL smt_compact node2 value_hash");
        process_exit(1);
    }
    if (node2).is_leaf != true {
        println("FAIL smt_compact node2 is_leaf");
        process_exit(1);
    }

    let tree2: SmtCompactTree = smt_compact_tree_add_node(tree1, node2);
    if (tree2).root_hash != initial_root {
        println("FAIL smt_compact tree2 root_hash");
        process_exit(1);
    }
    if (tree2).total_pruned_levels != 482 {
        println("FAIL smt_compact tree2 total_pruned_levels");
        process_exit(1);
    }

    let decomp: SmtDecompressResult = smt_decompress_compact_tree(tree2);
    if (decomp).full_root != initial_root {
        println("FAIL smt_compact decomp full_root");
        process_exit(1);
    }
    if (decomp).expanded_nodes != 4 {
        println("FAIL smt_compact decomp expanded_nodes");
        process_exit(1);
    }
    if (decomp).is_valid != true {
        println("FAIL smt_compact decomp is_valid");
        process_exit(1);
    }

    println("org_std_smt_compact: PASSED");
}
