// # Org std 3d/camera prove
//
// Logline: Fail-closed emit+gcc+run of destubbed camera move and project.
//
// Setup: Tree oodac emit-c. Int offsets only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Create FOV 90. Move +10 z. Position z is 10.
//   2. Project world z 50 is 40 (50 minus camera z).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/camera.oo";

pub fn main() {
    let cfg: CameraConfig = init_camera_config(90, 1);
    let c0: Camera = create_camera(cfg);
    if camera_get_position_z(c0) != 0 {
        println("FAIL cam z0");
        process_exit(1);
    }
    let c1: Camera = camera_move(c0, 0, 0, 10);
    if camera_get_position_z(c1) != 10 {
        println("FAIL cam z10");
        process_exit(1);
    }
    let depth: Int = camera_project(c1, 0, 0, 50);
    if depth != 40 {
        println("FAIL cam project");
        process_exit(1);
    }
    println("org_std_camera: PASSED");
}
