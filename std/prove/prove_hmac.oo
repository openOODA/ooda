// # Org std crypto/hmac prove
//
// Logline: Fail-closed emit+gcc+run of hmac_sha256, hmac_sign, and hmac_verify.
//
// Setup: Tree oodac emit-c. RFC 4231 test case 2. No caps.
//
// Beats:
//   1. hmac_sha256 and hmac_sign match the published case-2 hex tag.
//   2. hmac_verify accepts that tag and refuses a flipped first nibble.
//   3. Exit 1 before PASSED on a miss.

import "crypto/hmac.oo";

pub fn main() {
    let want: String = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843";
    let tag: String = hmac_sha256("Jefe", "what do ya want for nothing?");
    if tag != want {
        println("FAIL hmac rfc4231-2");
        process_exit(1);
    }
    let tag2: String = hmac_sign("Jefe", "what do ya want for nothing?");
    if tag2 != want {
        println("FAIL hmac sign rfc4231-2");
        process_exit(1);
    }
    if hmac_verify("Jefe", "what do ya want for nothing?", want) != true {
        println("FAIL hmac verify good");
        process_exit(1);
    }
    if hmac_verify("Jefe", "what do ya want for nothing?", "6bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843") != false {
        println("FAIL hmac verify bad");
        process_exit(1);
    }
    println("org_std_hmac: PASSED");
}
