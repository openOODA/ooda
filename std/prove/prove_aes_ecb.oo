// # Org std crypto/aes ECB prove
//
// Logline: Fail-closed emit+gcc+run of AES-128-ECB encrypt and decrypt against FIPS-197 C.1.
//
// Setup: Tree oodac emit-c. Encrypt is runtime. Decrypt is aes_inv_block.
//
// Beats:
//   1. Encrypt matches the published C.1 ciphertext hex.
//   2. Decrypt of that hex returns the C.1 plaintext.
//   3. Exit 1 before PASSED on a miss.

import "crypto/aes.oo";

fn px_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 { return ch - 48; }
    }
    if ch >= 97 {
        if ch <= 102 { return ch - 87; }
    }
    return -1;
}

fn px_unhex(hex: String) -> String {
    let n: Int = hex.len();
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        buf = bytes_push(buf, px_nibble(byte_at(hex, i)) * 16 + px_nibble(byte_at(hex, i + 1)));
        i = i + 2;
    }
    return bytes_to_str(buf);
}

pub fn main() {
    let key: String = px_unhex("000102030405060708090a0b0c0d0e0f");
    let pt: String = px_unhex("00112233445566778899aabbccddeeff");
    let want: String = "69c4e0d86a7b0430d8cdb78070b4c55a";
    let ct: String = aes_encrypt(key, pt);
    if ct != want {
        println("FAIL aes fips197-c1 encrypt");
        process_exit(1);
    }
    let back: String = aes_decrypt(key, ct);
    if back != pt {
        println("FAIL aes fips197-c1 decrypt");
        process_exit(1);
    }
    println("org_std_aes_ecb: PASSED");
}
