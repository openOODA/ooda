// # Org std perf/semaphore prove
//
// Logline: Fail-closed emit+gcc+run of destubbed semaphore acquire, wait, and release.
//
// Setup: Tree oodac emit-c. Int permits only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Create with 1 of max 2. Acquire empties. Available 0. Acquire_count 1.
//   2. Acquire while empty increments wait_count not acquire_count.
//   3. Release restores 1 permit. Exit 1 before PASSED on a miss.

import "src/ooda/perf/semaphore.oo";

pub fn main() {
    let s0: Semaphore = semaphore_create("sm", 1, 2);
    if semaphore_available(s0) != 1 {
        println("FAIL sem init");
        process_exit(1);
    }
    let s1: Semaphore = semaphore_acquire(s0);
    if semaphore_available(s1) != 0 {
        println("FAIL sem empty");
        process_exit(1);
    }
    if semaphore_acquire_count(s1) != 1 {
        println("FAIL sem acq1");
        process_exit(1);
    }
    let s2: Semaphore = semaphore_acquire(s1);
    if semaphore_acquire_count(s2) != 1 {
        println("FAIL sem acq stay");
        process_exit(1);
    }
    if semaphore_wait_count(s2) != 1 {
        println("FAIL sem wait1");
        process_exit(1);
    }
    if semaphore_available(s2) != 0 {
        println("FAIL sem still empty");
        process_exit(1);
    }
    let s3: Semaphore = semaphore_release(s2);
    if semaphore_available(s3) != 1 {
        println("FAIL sem release");
        process_exit(1);
    }
    if semaphore_release_count(s3) != 1 {
        println("FAIL sem rel1");
        process_exit(1);
    }
    println("org_std_semaphore: PASSED");
}
