// # Org std aero/telemetry_batch prove
//
// Logline: Fail-closed emit+gcc+run of destubbed tm_batch count and bytes.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. tm_batch_new(4, 512) count is 4.
//   2. bytes is 512 (not count).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/telemetry_batch.oo";

pub fn main() {
    let b: TmBatch = tm_batch_new(4, 512);
    if tm_batch_count(b) != 4 {
        println("FAIL tmb count");
        process_exit(1);
    }
    if tm_batch_bytes(b) != 512 {
        println("FAIL tmb bytes");
        process_exit(1);
    }
    println("org_std_tm_batch: PASSED");
}
