// # Org std perf/slab_allocator prove
//
// Logline: Fail-closed emit+gcc+run of destubbed slab grow, alloc, and utilization.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Grow one slab of 4. Alloc twice. Allocated is 2. Free is 2. Utilization is 50.
//   2. Free once. Allocated is 1. Utilization is 25.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/slab_allocator.oo";

pub fn main() {
    let s0: Slab = slab_create("sl", 16, 4);
    if slab_utilization(s0) != 0 {
        println("FAIL slab empty util");
        process_exit(1);
    }
    let s1: Slab = slab_grow(s0);
    let s2: Slab = slab_alloc(s1);
    let s3: Slab = slab_alloc(s2);
    if slab_allocated(s3) != 2 {
        println("FAIL slab alloc2");
        process_exit(1);
    }
    if slab_free_count(s3) != 2 {
        println("FAIL slab free2");
        process_exit(1);
    }
    if slab_utilization(s3) != 50 {
        println("FAIL slab util50");
        process_exit(1);
    }
    let s4: Slab = slab_free(s3);
    if slab_allocated(s4) != 1 {
        println("FAIL slab after free");
        process_exit(1);
    }
    if slab_utilization(s4) != 25 {
        println("FAIL slab util25");
        process_exit(1);
    }
    println("org_std_slab: PASSED");
}