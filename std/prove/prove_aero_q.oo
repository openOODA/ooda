// # Org std aero/aerodynamics_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed milli q, aspect ratio, and add.
//
// Setup: Tree oodac emit-c. Int milli only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. q_milli(1250, 20) is 250 (1250*400/2000).
//   2. aspect_ratio(10, 5) is 20. aspect_ratio(10, 0) is 0.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/aerodynamics_types.oo";

pub fn main() {
    let q: Int = aero_dynamic_pressure_milli(1250, 20);
    if q != 250 {
        println("FAIL aero q");
        process_exit(1);
    }
    let ar: Int = aero_aspect_ratio(10, 5);
    if ar != 20 {
        println("FAIL aero ar");
        process_exit(1);
    }
    let ar0: Int = aero_aspect_ratio(10, 0);
    if ar0 != 0 {
        println("FAIL aero ar0");
        process_exit(1);
    }
    let a: Vector3 = aero_vector3_new(1, 2, 3);
    let b: Vector3 = aero_vector3_new(4, 5, 6);
    let s: Vector3 = aero_vector3_add(a, b);
    let sz: Int = s.z;
    if sz != 9 {
        println("FAIL aero add z");
        process_exit(1);
    }
    println("org_std_aero_q: PASSED");
}
