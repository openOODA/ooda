// # Org std perf/perf_counters prove
//
// Logline: Fail-closed emit+gcc+run of destubbed IPC and cache miss rate.
//
// Setup: Tree oodac emit-c. Int ratios only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. 20 instructions over 10 cycles. IPC is 2.
//   2. Two cache misses. Miss rate is 10.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/perf_counters.oo";

pub fn main() {
    let p0: PerfCounters = perf_counters_create("pc");
    let p1: PerfCounters = perf_counters_add_cycles(p0, 10);
    let p2: PerfCounters = perf_counters_add_instructions(p1, 20);
    if perf_counters_ipc(p2) != 2 {
        println("FAIL pc ipc");
        process_exit(1);
    }
    let p3: PerfCounters = perf_counters_add_cache_miss(p2);
    let p4: PerfCounters = perf_counters_add_cache_miss(p3);
    if perf_counters_cache_misses(p4) != 2 {
        println("FAIL pc misses");
        process_exit(1);
    }
    if perf_counters_cache_miss_rate(p4) != 10 {
        println("FAIL pc missrate");
        process_exit(1);
    }
    println("org_std_perf_counters: PASSED");
}
