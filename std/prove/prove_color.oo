// # Org std 3d/materials_types Color prove
//
// Logline: Fail-closed emit+gcc+run of destubbed color_new and color_red channels.
//
// Setup: Tree oodac emit-c. Int RGBA only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. color_new(1,2,3,4) stores b=3.
//   2. color_red r=255 g=0 a=255.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/materials_types.oo";

pub fn main() {
    let c: Color = color_new(1, 2, 3, 4);
    let cb: Int = c.b;
    let ca: Int = c.a;
    if cb != 3 {
        println("FAIL color new b");
        process_exit(1);
    }
    if ca != 4 {
        println("FAIL color new a");
        process_exit(1);
    }
    let r: Color = color_red();
    let rr: Int = r.r;
    let rg: Int = r.g;
    let ra: Int = r.a;
    if rr != 255 {
        println("FAIL color red r");
        process_exit(1);
    }
    if rg != 0 {
        println("FAIL color red g");
        process_exit(1);
    }
    if ra != 255 {
        println("FAIL color red a");
        process_exit(1);
    }
    println("org_std_color: PASSED");
}
