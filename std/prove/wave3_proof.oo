import "src/ooda/sec/crypto/hmac_ops.oo";

pub fn main() {
    let eq_res = bytes_constant_time_eq("abcdef123456", "abcdef123456");
    if eq_res == false {
        println("FAIL: constant time eq");
        process_exit(1);
    }
    println("CONSTANT_TIME_EQ: OK");

    let hex_s = hex_encode("hello");
    let dec_res = hex_decode(hex_s);
    if dec_res.is_err() {
        println("FAIL: hex decode error");
        process_exit(1);
    }
    println("HEX_CODEC: OK");

    let h = checksum_calculate("openOODA");
    if h == 0 {
        println("FAIL: checksum calculation");
        process_exit(1);
    }
    println("CHECKSUM: OK");

    let tag = hmac_sha256("secret_key", "payload_message");
    if tag.len() == 0 {
        println("FAIL: HMAC SHA256 tag empty");
        process_exit(1);
    }
    println("HMAC_SHA256: OK");

    println("WAVE3_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
