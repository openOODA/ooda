// # Wave 3 Crypto Proof Driver
//
// Logline: Drive bytes_constant_time_eq, hex_encode/decode, checksum_calculate, and hmac_sha256 smoke tests.
//
// Setup: Imports sec/crypto/hmac_ops.oo. CWD must be ooda/.
//
// Beats:
//   1. main: assert bytes_constant_time_eq matches for two equal byte strings.
//   2. main: round-trip hex_encode and hex_decode and assert no Err.
//   3. main: compute checksum_calculate and assert the hash is non-zero.
//   4. main: compute hmac_sha256 and assert the tag length is non-zero.
//   5. main: print WAVE3_INTEGRATION_SUITE_PASSED and process_exit(0).
//
// residual: smoke only; no FIPS-validated KAT.

import "src/ooda/sec/crypto/hmac_ops.oo";

pub fn main() {
    let eq_res = bytes_constant_time_eq("abcdef123456", "abcdef123456");
    if eq_res == false {
        println("FAIL: constant time eq");
        process_exit(1);
    }
    println("CONSTANT_TIME_EQ: OK");

    let hex_s = hex_encode("hello");
    let dec_res = hex_decode(hex_s);
    if dec_res.is_err() {
        println("FAIL: hex decode error");
        process_exit(1);
    }
    println("HEX_CODEC: OK");

    let h = checksum_calculate("openOODA");
    if h == 0 {
        println("FAIL: checksum calculation");
        process_exit(1);
    }
    println("CHECKSUM: OK");

    let tag = hmac_sha256("secret_key", "payload_message");
    if tag.len() == 0 {
        println("FAIL: HMAC SHA256 tag empty");
        process_exit(1);
    }
    println("HMAC_SHA256: OK");

    println("WAVE3_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
