// # Org std aero/propulsion facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed propulsion_eng thrust and isp.
//
// Setup: Tree oodac emit-c. Int fields only. Import propulsion.oo only.
//
// Beats:
//   1. propulsion_eng_new(180000, 280) thrust is 180000.
//   2. isp is 280 (not thrust).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/propulsion.oo";

pub fn main() {
    let e: PropEng = propulsion_eng_new(180000, 280);
    if propulsion_eng_thrust(e) != 180000 {
        println("FAIL prop thrust");
        process_exit(1);
    }
    if propulsion_eng_isp(e) != 280 {
        println("FAIL prop isp");
        process_exit(1);
    }
    println("org_std_propulsion: PASSED");
}
