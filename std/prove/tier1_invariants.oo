// # Tier 1 First-Principles Invariant Proofs
//
// Logline: Live mathematical property validation across FFT energy conservation, IIR pole stability, quaternion norms, and vector cross products.
//
// Setup: First-principles verification engine asserting strict analytical invariants on live numeric outputs.
//
// Beats:
//   1. Verify FFT Parseval energy conservation: sum(|x[n]|^2) == (1/N) * sum(|X[k]|^2).
//   2. Verify IIR filter pole roots strictly inside unit circle |z| < 1.0 via Jury stability.
//   3. Verify unit quaternion normalization ||q|| == 1.0 and Hamilton product norm preservation.
//   4. Verify 3D vector cross product orthogonality, anti-commutativity, and Lagrange identity.

pub type Tier1InvariantReport = struct {
    fft_energy_conserved: Bool,
    iir_poles_stable: Bool,
    quat_norm_unity: Bool,
    cross_product_orthogonal: Bool,
    all_invariants_passed: Bool
};

fn abs_flt(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn tier1_verify_fft_parseval() -> Result[Bool, String] {
    let mut rx: List[Float] = list_new();
    let mut ix: List[Float] = list_new();
    rx = list_push(rx, 1.0);
    rx = list_push(rx, 2.0);
    rx = list_push(rx, 3.0);
    rx = list_push(rx, 4.0);
    rx = list_push(rx, 1.0);
    rx = list_push(rx, 0.0);
    rx = list_push(rx, -1.0);
    rx = list_push(rx, 0.0);
    let mut i: Int = 0;
    while i < 8 {
        ix = list_push(ix, 0.0);
        i = i + 1;
    }
    let mut e_time: Float = 0.0;
    i = 0;
    while i < 8 {
        let r: Float = list_get(rx, i);
        let im: Float = list_get(ix, i);
        e_time = e_time + r * r + im * im;
        i = i + 1;
    }

    let mut out_r: List[Float] = list_new();
    let mut out_im: List[Float] = list_new();
    let mut k: Int = 0;
    while k < 8 {
        let mut sum_r: Float = 0.0;
        let mut sum_i: Float = 0.0;
        let mut n: Int = 0;
        while n < 8 {
            let angle: Float = (0.0 - 2.0 * 3.141592653589793 * (k * n)) / 8.0;
            let c: Float = cos(angle);
            let s: Float = sin(angle);
            let xn_r: Float = list_get(rx, n);
            let xn_i: Float = list_get(ix, n);
            sum_r = sum_r + (xn_r * c - xn_i * s);
            sum_i = sum_i + (xn_r * s + xn_i * c);
            n = n + 1;
        }
        out_r = list_push(out_r, sum_r);
        out_im = list_push(out_im, sum_i);
        k = k + 1;
    }

    let mut e_freq: Float = 0.0;
    k = 0;
    while k < 8 {
        let fr: Float = list_get(out_r, k);
        let fi: Float = list_get(out_im, k);
        e_freq = e_freq + (fr * fr + fi * fi);
        k = k + 1;
    }
    e_freq = e_freq / 8.0;

    let diff: Float = abs_flt(e_time - e_freq);
    if diff > 0.001 {
        return Err("E_PARSEVAL_VIOLATION: energy not conserved between time and frequency domains");
    }
    return Ok(true);
}

pub fn tier1_verify_iir_stability(a1: Float, a2: Float) -> Result[Bool, String] {
    let a2_abs: Float = abs_flt(a2);
    if a2_abs >= 1.0 {
        return Err("E_IIR_UNSTABLE: Schur-Cohn condition 1 failed (|a2| >= 1)");
    }
    if 1.0 + a1 + a2 <= 0.0 {
        return Err("E_IIR_UNSTABLE: Schur-Cohn condition 2 failed (1 + a1 + a2 <= 0)");
    }
    if 1.0 - a1 + a2 <= 0.0 {
        return Err("E_IIR_UNSTABLE: Schur-Cohn condition 3 failed (1 - a1 + a2 <= 0)");
    }
    let disc: Float = a1 * a1 - 4.0 * a2;
    if disc < 0.0 {
        let mag: Float = sqrt(a2);
        if mag >= 1.0 {
            return Err("E_IIR_UNSTABLE: complex pole magnitude >= 1");
        }
    } else {
        let s_disc: Float = sqrt(disc);
        let r1: Float = (0.0 - a1 + s_disc) / 2.0;
        let r2: Float = (0.0 - a1 - s_disc) / 2.0;
        if abs_flt(r1) >= 1.0 || abs_flt(r2) >= 1.0 {
            return Err("E_IIR_UNSTABLE: real pole magnitude >= 1");
        }
    }
    return Ok(true);
}

pub fn tier1_verify_quat_norm(w: Float, x: Float, y: Float, z: Float) -> Result[Bool, String] {
    let sq: Float = w * w + x * x + y * y + z * z;
    if sq <= 0.0000001 {
        return Err("E_ZERO_QUATERNION: zero quaternion cannot be normalized");
    }
    let mag: Float = sqrt(sq);
    let nw: Float = w / mag;
    let nx: Float = x / mag;
    let ny: Float = y / mag;
    let nz: Float = z / mag;
    let n_sq: Float = nw * nw + nx * nx + ny * ny + nz * nz;
    let diff: Float = abs_flt(n_sq - 1.0);
    if diff > 0.0001 {
        return Err("E_QUAT_NORM_VIOLATION: unit normalization failed to produce unity norm");
    }
    let bw: Float = 0.5;
    let bx: Float = 0.5;
    let by: Float = 0.5;
    let bz: Float = 0.5;
    let pw: Float = nw * bw - nx * bx - ny * by - nz * bz;
    let px: Float = nw * bx + nx * bw + ny * bz - nz * by;
    let py: Float = nw * by - nx * bz + ny * bw + nz * bx;
    let pz: Float = nw * bz + nx * by - ny * bx + nz * bw;
    let p_sq: Float = pw * pw + px * px + py * py + pz * pz;
    let p_diff: Float = abs_flt(p_sq - 1.0);
    if p_diff > 0.0001 {
        return Err("E_HAMILTON_NORM_VIOLATION: Hamilton product norm multiplicativity violated");
    }
    return Ok(true);
}

pub fn tier1_verify_cross_product(ux: Float, uy: Float, uz: Float, vx: Float, vy: Float, vz: Float) -> Result[Bool, String] {
    let wx: Float = uy * vz - uz * vy;
    let wy: Float = uz * vx - ux * vz;
    let wz: Float = ux * vy - uy * vx;

    let dot_u: Float = ux * wx + uy * wy + uz * wz;
    let dot_v: Float = vx * wx + vy * wy + vz * wz;
    if abs_flt(dot_u) > 0.0001 || abs_flt(dot_v) > 0.0001 {
        return Err("E_CROSS_ORTHOGONAL_VIOLATION: cross product vector not orthogonal to operands");
    }

    let anti_x: Float = vy * uz - vz * uy;
    let anti_y: Float = vz * ux - vx * uz;
    let anti_z: Float = vx * uy - vy * ux;
    if abs_flt(wx + anti_x) > 0.0001 || abs_flt(wy + anti_y) > 0.0001 || abs_flt(wz + anti_z) > 0.0001 {
        return Err("E_ANTI_COMMUTATIVE_VIOLATION: cross product anti-commutativity violated");
    }

    let w_len_sq: Float = wx * wx + wy * wy + wz * wz;
    let u_len_sq: Float = ux * ux + uy * uy + uz * uz;
    let v_len_sq: Float = vx * vx + vy * vy + vz * vz;
    let dot_uv: Float = ux * vx + uy * vy + uz * vz;
    let lagrange_rhs: Float = u_len_sq * v_len_sq - dot_uv * dot_uv;
    if abs_flt(w_len_sq - lagrange_rhs) > 0.001 {
        return Err("E_LAGRANGE_VIOLATION: Lagrange identity |u x v|^2 == |u|^2 |v|^2 - (u.v)^2 failed");
    }
    return Ok(true);
}

pub fn tier1_invariants_evaluate_all() -> Result[Tier1InvariantReport, String] {
    let res_fft = tier1_verify_fft_parseval();
    let mut fft_ok: Bool = false;
    match res_fft {
        Ok(v) => { fft_ok = v; },
        Err(e) => { return Err(e); }
    }

    let res_iir = tier1_verify_iir_stability(-1.143, 0.4128);
    let mut iir_ok: Bool = false;
    match res_iir {
        Ok(v) => { iir_ok = v; },
        Err(e) => { return Err(e); }
    }

    let res_quat = tier1_verify_quat_norm(1.0, 2.0, 3.0, 4.0);
    let mut quat_ok: Bool = false;
    match res_quat {
        Ok(v) => { quat_ok = v; },
        Err(e) => { return Err(e); }
    }

    let res_cross = tier1_verify_cross_product(1.0, 3.0, -2.0, 4.0, -1.0, 5.0);
    let mut cross_ok: Bool = false;
    match res_cross {
        Ok(v) => { cross_ok = v; },
        Err(e) => { return Err(e); }
    }

    let all_ok: Bool = (fft_ok && iir_ok && quat_ok && cross_ok);
    return Ok(Tier1InvariantReport {
        fft_energy_conserved: fft_ok,
        iir_poles_stable: iir_ok,
        quat_norm_unity: quat_ok,
        cross_product_orthogonal: cross_ok,
        all_invariants_passed: all_ok
    });
}
