// # Org std aero/propulsion_engine prove
//
// Logline: Fail-closed emit+gcc+run of destubbed prop_eng thrust and isp.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. prop_eng_new(250000, 311) thrust is 250000.
//   2. isp is 311 (not thrust).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/propulsion_engine.oo";

pub fn main() {
    let e: PropEng = prop_eng_new(250000, 311);
    if prop_eng_thrust(e) != 250000 {
        println("FAIL peng thrust");
        process_exit(1);
    }
    if prop_eng_isp(e) != 311 {
        println("FAIL peng isp");
        process_exit(1);
    }
    println("org_std_prop_eng: PASSED");
}
