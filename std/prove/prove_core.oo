// # Org std core prove
//
// Logline: Fail-closed emit+gcc+run of FIPS SHA-256 and a typed ring buffer.
//
// Setup: Locked oodac. Runtime crypto_sha256_internal. Typed let so struct emit is not long long.
//
// Beats:
//   1. Hash hello and require the FIPS hex.
//   2. Create an empty ring, push once, require size 1.
//   3. Exit 1 on any miss. Print org_std_core: PASSED only if both hold.
// residual: untyped struct lets still emit as long long. 4072 files not this proof.

import "src/ooda/perf/ring_buffer.oo";

pub fn main() {
    let d: String = crypto_sha256_internal("hello");
    if d != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        println("FAIL sha256");
        process_exit(1);
    }
    let rb0: RingBuffer = ring_buffer_create("p", 4);
    if !ring_buffer_is_empty(rb0) {
        println("FAIL empty");
        process_exit(1);
    }
    let rb1: RingBuffer = ring_buffer_push(rb0);
    if ring_buffer_size(rb1) != 1 {
        println("FAIL size");
        process_exit(1);
    }
    if ring_buffer_is_empty(rb1) {
        println("FAIL not empty");
        process_exit(1);
    }
    println("org_std_core: PASSED");
}
