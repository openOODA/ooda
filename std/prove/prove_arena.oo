// # Org std perf/arena_allocator prove
//
// Logline: Fail-closed emit+gcc+run of destubbed arena bump alloc, peak, and reset.
//
// Setup: Tree oodac emit-c. Int offsets only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Alloc 32 then 16. Used is 48. Peak is 48.
//   2. Reset zeros used and keeps peak 48.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/arena_allocator.oo";

pub fn main() {
    let a0: Arena = bump_arena_create("ar", 8);
    let a1: Arena = bump_arena_alloc_bytes(a0, 32);
    let a2: Arena = bump_arena_alloc_bytes(a1, 16);
    if bump_arena_used(a2) != 48 {
        println("FAIL arena used");
        process_exit(1);
    }
    if bump_arena_peak(a2) != 48 {
        println("FAIL arena peak");
        process_exit(1);
    }
    let a3: Arena = bump_arena_reset(a2);
    if bump_arena_used(a3) != 0 {
        println("FAIL arena reset used");
        process_exit(1);
    }
    if bump_arena_peak(a3) != 48 {
        println("FAIL arena peak keep");
        process_exit(1);
    }
    println("org_std_arena: PASSED");
}