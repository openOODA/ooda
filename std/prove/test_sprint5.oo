import "src/ooda/cloud/circuit_breaker.oo";
import "src/ooda/multimedia/color_rgb.oo";
import "src/ooda/token_opt/token_budget.oo";

pub fn main() {
    // 1. Cloud Circuit Breaker Test
    let mut cb: CircuitBreaker = circuit_breaker_new(3, 2, 5000, 1000);
    let allowed: Bool = circuit_breaker_allow_request(&mut cb, 1000);
    if allowed == true {
        println("CLOUD_CIRCUIT_BREAKER: OK");
    }

    // 2. Multimedia RGB Test
    let c: ColorRgb = color_rgb_new(255, 128, 0);
    if (c).r == 255 {
        println("MEDIA_COLOR_RGB: OK");
    }

    // 3. Token Opt Budget Test
    let cfg: TokenBudgetConfig = token_budget_config_new(8192, 1024);
    if (cfg).target_budget == 7168 {
        println("TOKEN_OPT_BUDGET: OK");
    }

    println("SPRINT5_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
