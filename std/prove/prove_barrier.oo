// # Org std perf/barrier prove
//
// Logline: Fail-closed emit+gcc+run of destubbed barrier arrive and release.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Target 2. First arrive: arrived 1, not open, release 0.
//   2. Second arrive: arrived 2, open, release 1.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/barrier.oo";

pub fn main() {
    let b0: Barrier = barrier_create("b", 2);
    let b1: Barrier = barrier_arrive(b0);
    if barrier_arrived(b1) != 1 {
        println("FAIL bar arrived1");
        process_exit(1);
    }
    if barrier_is_open(b1) != false {
        println("FAIL bar closed");
        process_exit(1);
    }
    if barrier_release_count(b1) != 0 {
        println("FAIL bar rel0");
        process_exit(1);
    }
    let b2: Barrier = barrier_arrive(b1);
    if barrier_arrived(b2) != 2 {
        println("FAIL bar arrived2");
        process_exit(1);
    }
    if barrier_is_open(b2) != true {
        println("FAIL bar open");
        process_exit(1);
    }
    if barrier_release_count(b2) != 1 {
        println("FAIL bar rel1");
        process_exit(1);
    }
    println("org_std_barrier: PASSED");
}