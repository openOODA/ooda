// # Org std 3d/math Vector3 prove
//
// Logline: Fail-closed emit+gcc+run of destubbed vec3 add, dot, and cross.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. (1,2,3)+(4,5,6) is (5,7,9). Dot is 32.
//   2. Cross (1,0,0) x (0,1,0) is (0,0,1).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/math.oo";

pub fn main() {
    let a: Vector3 = vec3_new(1, 2, 3);
    let b: Vector3 = vec3_new(4, 5, 6);
    let s: Vector3 = vec3_add(a, b);
    let sx: Int = s.x;
    let sy: Int = s.y;
    let sz: Int = s.z;
    if sx != 5 {
        println("FAIL vec3 add x");
        process_exit(1);
    }
    if sy != 7 {
        println("FAIL vec3 add y");
        process_exit(1);
    }
    if sz != 9 {
        println("FAIL vec3 add z");
        process_exit(1);
    }
    let d: Int = vec3_dot(a, b);
    if d != 32 {
        println("FAIL vec3 dot");
        process_exit(1);
    }
    let i: Vector3 = vec3_new(1, 0, 0);
    let j: Vector3 = vec3_new(0, 1, 0);
    let k: Vector3 = vec3_cross(i, j);
    let kz: Int = k.z;
    let kx: Int = k.x;
    let ky: Int = k.y;
    if kx != 0 {
        println("FAIL vec3 cross x");
        process_exit(1);
    }
    if ky != 0 {
        println("FAIL vec3 cross y");
        process_exit(1);
    }
    if kz != 1 {
        println("FAIL vec3 cross z");
        process_exit(1);
    }
    println("org_std_vec3: PASSED");
}
