// # Org std 3d/mesh_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed triangle_new and mesh_new.
//
// Setup: Tree oodac emit-c. Int coords only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. triangle_new copies v2 into x2/y2/z2.
//   2. mesh_new(7) id is 7 and n_tri is 0.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/mesh_types.oo";

pub fn main() {
    let v1: Vector3 = vector3_new(1, 0, 0);
    let v2: Vector3 = vector3_new(0, 2, 0);
    let v3: Vector3 = vector3_new(0, 0, 3);
    let t: Triangle = triangle_new(v1, v2, v3);
    let x2: Int = t.x2;
    let y2: Int = t.y2;
    let z3: Int = t.z3;
    if x2 != 0 {
        println("FAIL tri x2");
        process_exit(1);
    }
    if y2 != 2 {
        println("FAIL tri y2");
        process_exit(1);
    }
    if z3 != 3 {
        println("FAIL tri z3");
        process_exit(1);
    }
    let m: Mesh = mesh_new(7);
    let mid: Int = m.id;
    let n: Int = m.n_tri;
    if mid != 7 {
        println("FAIL mesh id");
        process_exit(1);
    }
    if n != 0 {
        println("FAIL mesh empty");
        process_exit(1);
    }
    println("org_std_mesh_types: PASSED");
}
