// # Org std aero/propulsion_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed rocket_engine_new fields.
//
// Setup: Tree oodac emit-c. Int thrust/mass only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. rocket_engine_new(3, 250000, 1800) thrust is 250000.
//   2. Dry mass is 1800 (not thrust). Id is 3.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/propulsion_types.oo";

pub fn main() {
    let e: RocketEngine = rocket_engine_new(3, 250000, 1800);
    if rocket_engine_id(e) != 3 {
        println("FAIL reng id");
        process_exit(1);
    }
    if rocket_engine_thrust(e) != 250000 {
        println("FAIL reng thrust");
        process_exit(1);
    }
    if rocket_engine_dry_mass(e) != 1800 {
        println("FAIL reng mass");
        process_exit(1);
    }
    println("org_std_rocket_engine: PASSED");
}
