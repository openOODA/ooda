// # Wave 4 Aero-Robot Proof Driver
//
// Logline: Drive aero vec3 cross and length, plus robot vec2 add and pose2d constructors.
//
// Setup: Imports aero/orbit_types.oo, aero/orbit_math.oo, robot/kinematics_types.oo, and robot/kinematics_ops.oo. CWD must be ooda/.
//
// Beats:
//   1. main: cross product of (1,0,0) and (0,1,0) must yield z=1.
//   2. main: length of that cross product must equal 1.0.
//   3. main: vec2_add of (10,20) and (5,5) must yield x=15.0.
//   4. main: pose2d_new(100,200,0.5) must preserve the x field.
//   5. main: print WAVE4_INTEGRATION_SUITE_PASSED.
//
// residual: smoke only; no SIMD numerics or RK4 propagation.

import "src/ooda/aero/orbit_types.oo";
import "src/ooda/aero/orbit_math.oo";
import "src/ooda/robot/kinematics_types.oo";
import "src/ooda/robot/kinematics_ops.oo";

pub fn main() {
    // 1. Aerospace Orbit Math Test
    let v1 = vec3_new(1.0, 0.0, 0.0);
    let v2 = vec3_new(0.0, 1.0, 0.0);
    let v3 = vec3_cross(v1, v2);
    if (v3).z != 1.0 {
        println("FAIL AERO_VEC3_CROSS");
        process_exit(1);
    }
    println("AERO_VEC3_CROSS: OK");

    let len = vec3_length(v3);
    if len != 1.0 {
        println("FAIL AERO_VEC3_LEN");
        process_exit(1);
    }
    println("AERO_VEC3_LEN: OK");

    // 2. Robot Kinematics Test
    let p1 = vec2_new(10.0, 20.0);
    let p2 = vec2_new(5.0, 5.0);
    let p3 = vec2_add(p1, p2);
    if (p3).x != 15.0 {
        println("FAIL ROBOT_VEC2_ADD");
        process_exit(1);
    }
    println("ROBOT_VEC2_ADD: OK");

    let pose = pose2d_new(100.0, 200.0, 0.5);
    if (pose).x != 100.0 {
        println("FAIL ROBOT_POSE2D");
        process_exit(1);
    }
    println("ROBOT_POSE2D: OK");
    println("WAVE4_INTEGRATION_SUITE_PASSED");
}
