// # Org std crypto/aes_gcm prove
//
// Logline: Fail-closed emit+gcc+run of AES-128-GCM against NIST SP 800-38D case 2.
//
// Setup: Tree oodac emit-c. Local hex_decode. Empty AAD. 16-byte zero plaintext.
//
// Beats:
//   1. Seal matches published ciphertext hex plus 16-byte tag hex.
//   2. Open returns the 16 zero bytes. A flipped tag returns empty.
//   3. Exit 1 before PASSED on a miss.

import "crypto/aes_gcm.oo";

fn px_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

fn px_hex_decode(hex: String) -> String {
    let n: Int = hex.len();
    if n % 2 != 0 {
        process_exit(1);
        return "";
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        let hi_v: Int = px_nibble(byte_at(hex, i));
        let lo_v: Int = px_nibble(byte_at(hex, i + 1));
        if hi_v < 0 {
            process_exit(1);
            return "";
        }
        if lo_v < 0 {
            process_exit(1);
            return "";
        }
        buf = bytes_push(buf, hi_v * 16 + lo_v);
        i = i + 2;
    }
    return bytes_to_str(buf);
}

pub fn main() {
    let key: String = px_hex_decode("00000000000000000000000000000000");
    let nonce: String = px_hex_decode("000000000000000000000000");
    let pt: String = px_hex_decode("00000000000000000000000000000000");
    let want: String = "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf";
    let out: String = aes_gcm_encrypt(key, nonce, pt, "");
    if out != want {
        println("FAIL gcm nist-tc2 seal");
        process_exit(1);
    }
    let ct: String = px_hex_decode("0388dace60b6a392f328c2b971b2fe78");
    let tag: String = px_hex_decode("ab6e47d42cec13bdf53a67b21257bddf");
    let back: String = aes_gcm_decrypt(key, nonce, ct, tag, "");
    if back != pt {
        println("FAIL gcm nist-tc2 open");
        process_exit(1);
    }
    let bad_tag: String = px_hex_decode("bb6e47d42cec13bdf53a67b21257bddf");
    let rejected: String = aes_gcm_decrypt(key, nonce, ct, bad_tag, "");
    if rejected.len() != 0 {
        println("FAIL gcm bad tag leaked");
        process_exit(1);
    }
    println("org_std_aes_gcm: PASSED");
}
