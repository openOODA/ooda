// # Org std aero/navigation_ekf prove
//
// Logline: Fail-closed emit+gcc+run of destubbed nav_ekf px and vx.
//
// Setup: Tree oodac emit-c. Int state only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. nav_ekf_new(1000, 15) px is 1000.
//   2. vx is 15 (not px).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation_ekf.oo";

pub fn main() {
    let e: NavEkf = nav_ekf_new(1000, 15);
    if nav_ekf_px(e) != 1000 {
        println("FAIL ekf px");
        process_exit(1);
    }
    if nav_ekf_vx(e) != 15 {
        println("FAIL ekf vx");
        process_exit(1);
    }
    println("org_std_nav_ekf: PASSED");
}
