// # Org std 3d/lights_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed LightColor constructors.
//
// Setup: Tree oodac emit-c. Int channels only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. light_color_white r and a are 255. light_color_black r is 0.
//   2. light_color_new(1, 2, 3, 4) stores b=3.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/lights_types.oo";

pub fn main() {
    let w: LightColor = light_color_white();
    let wr: Int = w.r;
    let wa: Int = w.a;
    if wr != 255 {
        println("FAIL color white r");
        process_exit(1);
    }
    if wa != 255 {
        println("FAIL color white a");
        process_exit(1);
    }
    let k: LightColor = light_color_black();
    let kr: Int = k.r;
    if kr != 0 {
        println("FAIL color black r");
        process_exit(1);
    }
    let c: LightColor = light_color_new(1, 2, 3, 4);
    let cb: Int = c.b;
    if cb != 3 {
        println("FAIL color new b");
        process_exit(1);
    }
    println("org_std_light_color: PASSED");
}