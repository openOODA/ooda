// # Org std aero/formation facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed formation vec3 x and y.
//
// Setup: Tree oodac emit-c. Int components only. Import formation.oo only.
//
// Beats:
//   1. formation_vec3_new(2, 8, 9) x is 2.
//   2. y is 8 (not x). z is 9.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/formation.oo";

pub fn main() {
    let v: FormVec3 = formation_vec3_new(2, 8, 9);
    if formation_vec3_x(v) != 2 {
        println("FAIL form x");
        process_exit(1);
    }
    if formation_vec3_y(v) != 8 {
        println("FAIL form y");
        process_exit(1);
    }
    if formation_vec3_z(v) != 9 {
        println("FAIL form z");
        process_exit(1);
    }
    println("org_std_formation: PASSED");
}
