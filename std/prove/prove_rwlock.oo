// # Org std perf/rwlock prove
//
// Logline: Fail-closed emit+gcc+run of destubbed rwlock readers vs exclusive write wait.
//
// Setup: Tree oodac emit-c. Int counters only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Two read locks. Active readers 2.
//   2. Write while readers increments wait_count and does not set writer_active.
//   3. After both unlocks, write_lock sets writer_active and write_count 1.
//   4. Exit 1 before PASSED on a miss.

import "src/ooda/perf/rwlock.oo";

pub fn main() {
    let l0: RwLock = rwlock_create("rw");
    let l1: RwLock = rwlock_read_lock(l0);
    let l2: RwLock = rwlock_read_lock(l1);
    if rwlock_active_readers(l2) != 2 {
        println("FAIL rw readers2");
        process_exit(1);
    }
    let l3: RwLock = rwlock_write_lock(l2, "w");
    if rwlock_writer_active(l3) != false {
        println("FAIL rw write blocked");
        process_exit(1);
    }
    if rwlock_write_count(l3) != 0 {
        println("FAIL rw write stay");
        process_exit(1);
    }
    if rwlock_wait_count(l3) != 1 {
        println("FAIL rw wait1");
        process_exit(1);
    }
    let l4: RwLock = rwlock_read_unlock(l3);
    let l5: RwLock = rwlock_read_unlock(l4);
    if rwlock_active_readers(l5) != 0 {
        println("FAIL rw readers0");
        process_exit(1);
    }
    let l6: RwLock = rwlock_write_lock(l5, "w");
    if rwlock_writer_active(l6) != true {
        println("FAIL rw writer");
        process_exit(1);
    }
    if rwlock_write_count(l6) != 1 {
        println("FAIL rw write1");
        process_exit(1);
    }
    println("org_std_rwlock: PASSED");
}
