// # Org std 3d/gaussian_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed gaussian3d_new opacity and center.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. gaussian3d_new(1,2,3,90) opacity is 90.
//   2. Stored cz is 3 (not opacity).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/gaussian_types.oo";

pub fn main() {
    let g: Gaussian3D = gaussian3d_new(1, 2, 3, 90);
    if gaussian3d_opacity(g) != 90 {
        println("FAIL gau opacity");
        process_exit(1);
    }
    let cz: Int = g.cz;
    let cx: Int = g.cx;
    if cz != 3 {
        println("FAIL gau cz");
        process_exit(1);
    }
    if cx != 1 {
        println("FAIL gau cx");
        process_exit(1);
    }
    println("org_std_gaussian3d: PASSED");
}
