// # Org std perf/batch_buffer prove
//
// Logline: Fail-closed emit+gcc+run of destubbed batch push, should_flush, and flush totals.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Cap 4, max_batch 2. Push twice. Size 2. should_flush true.
//   2. Flush zeros size, flush_count 1, items_flushed 2.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/batch_buffer.oo";

pub fn main() {
    let b0: BatchBuffer = batch_buffer_create("bb", 4, 2);
    let b1: BatchBuffer = batch_buffer_push(b0);
    if batch_buffer_should_flush(b1) != false {
        println("FAIL batch early flush");
        process_exit(1);
    }
    let b2: BatchBuffer = batch_buffer_push(b1);
    if batch_buffer_size(b2) != 2 {
        println("FAIL batch size2");
        process_exit(1);
    }
    if batch_buffer_should_flush(b2) != true {
        println("FAIL batch should");
        process_exit(1);
    }
    let b3: BatchBuffer = batch_buffer_flush(b2);
    if batch_buffer_size(b3) != 0 {
        println("FAIL batch flushed empty");
        process_exit(1);
    }
    if batch_buffer_flush_count(b3) != 1 {
        println("FAIL batch flush1");
        process_exit(1);
    }
    if batch_buffer_items_flushed(b3) != 2 {
        println("FAIL batch items2");
        process_exit(1);
    }
    println("org_std_batch_buffer: PASSED");
}
