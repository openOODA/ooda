// # Org std perf/ring_buffer prove
//
// Logline: Fail-closed emit+gcc+run of destubbed ring push, drop-on-full, and pop.
//
// Setup: Tree oodac emit-c. Int occupancy only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Cap 2. Push twice. Size 2.
//   2. Push while full increments dropped and keeps size 2.
//   3. Pop once. Size 1. Exit 1 before PASSED on a miss.

import "src/ooda/perf/ring_buffer.oo";

pub fn main() {
    let r0: RingBuffer = ring_buffer_create("rb", 2);
    let r1: RingBuffer = ring_buffer_push(r0);
    let r2: RingBuffer = ring_buffer_push(r1);
    if ring_buffer_size(r2) != 2 {
        println("FAIL ring size2");
        process_exit(1);
    }
    if ring_buffer_is_full(r2) != true {
        println("FAIL ring full");
        process_exit(1);
    }
    let r3: RingBuffer = ring_buffer_push(r2);
    if ring_buffer_size(r3) != 2 {
        println("FAIL ring stay2");
        process_exit(1);
    }
    if ring_buffer_dropped(r3) != 1 {
        println("FAIL ring drop1");
        process_exit(1);
    }
    let r4: RingBuffer = ring_buffer_pop(r3);
    if ring_buffer_size(r4) != 1 {
        println("FAIL ring pop");
        process_exit(1);
    }
    if ring_buffer_dropped(r4) != 1 {
        println("FAIL ring drop keep");
        process_exit(1);
    }
    println("org_std_ring_buffer: PASSED");
}
