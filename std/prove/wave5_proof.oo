// # Wave 5 3D-Quantum Proof Driver
//
// Logline: Drive 3D triangle centroid, quantum complex add, and Pauli-Z trace smoke tests.
//
// Setup: Imports 3d/mesh_types.oo, 3d/mesh_ops.oo, quantum/gates_types.oo, and quantum/gates_pauli.oo. CWD must be ooda/.
//
// Beats:
//   1. main: build a triangle from (0,0,0), (300,0,0), (0,300,0) and assert centroid x=100.
//   2. main: complex_add(1+2i, 3+4i) must yield real=4.0 and imag=6.0.
//   3. main: pauli_trace(pauli_z(0)) must yield real=0.0.
//   4. main: print WAVE5_INTEGRATION_SUITE_PASSED.
//
// residual: smoke only; no statevector or shot simulation.

import "src/ooda/3d/mesh_types.oo";
import "src/ooda/3d/mesh_ops.oo";
import "src/ooda/quantum/gates_types.oo";
import "src/ooda/quantum/gates_pauli.oo";

pub fn main() {
    // 1. 3D Mesh Test
    let v1 = vector3_new(0, 0, 0);
    let v2 = vector3_new(300, 0, 0);
    let v3 = vector3_new(0, 300, 0);
    let tri = triangle_new(v1, v2, v3);
    let centroid = triangle_centroid(&tri);
    if (centroid).x != 100 {
        println("FAIL 3D_CENTROID");
        process_exit(1);
    }
    println("3D_CENTROID: OK");

    // 2. Quantum Complex Test
    let c1 = complex_new(1.0, 2.0);
    let c2 = complex_new(3.0, 4.0);
    let c3 = complex_add(c1, c2);
    if (c3).real != 4.0 {
        println("FAIL QUANTUM_COMPLEX");
        process_exit(1);
    }
    if (c3).imag != 6.0 {
        println("FAIL QUANTUM_COMPLEX");
        process_exit(1);
    }
    println("QUANTUM_COMPLEX: OK");

    let p_z = pauli_z(0);
    let tr = pauli_trace(&p_z);
    if (tr).real != 0.0 {
        println("FAIL PAULI_Z_TRACE");
        process_exit(1);
    }
    println("PAULI_Z_TRACE: OK");
    println("WAVE5_INTEGRATION_SUITE_PASSED");
}
