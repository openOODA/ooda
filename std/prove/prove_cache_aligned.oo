// # Org std perf/cache_aligned_alloc prove
//
// Logline: Fail-closed emit+gcc+run of destubbed cache-line align_up, waste, and overhead.
//
// Setup: Tree oodac emit-c. Int padding only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. align_up(20, 8) is 24.
//   2. Alloc 20 on line 8. Wasted 4. Allocated 20. Overhead 20.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/cache_aligned_alloc.oo";

pub fn main() {
    if cache_aligned_align_up(20, 8) != 24 {
        println("FAIL align 20/8");
        process_exit(1);
    }
    if cache_aligned_align_up(16, 8) != 16 {
        println("FAIL align 16/8");
        process_exit(1);
    }
    let a0: CacheAlignedAlloc = cache_aligned_create("ca", 8);
    let a1: CacheAlignedAlloc = cache_aligned_alloc(a0, 20);
    if cache_aligned_allocated(a1) != 20 {
        println("FAIL ca alloc20");
        process_exit(1);
    }
    if cache_aligned_wasted(a1) != 4 {
        println("FAIL ca waste4");
        process_exit(1);
    }
    if cache_aligned_overhead_pct(a1) != 20 {
        println("FAIL ca overhead20");
        process_exit(1);
    }
    println("org_std_cache_aligned: PASSED");
}
