// # Org std aero/navigation_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed nav_vec3_new axes.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. nav_vec3_new(11, 22, 33) x is 11.
//   2. y is 22 (not x). z is 33.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation_types.oo";

pub fn main() {
    let v: NavVec3 = nav_vec3_new(11, 22, 33);
    if nav_vec3_x(v) != 11 {
        println("FAIL nav x");
        process_exit(1);
    }
    if nav_vec3_y(v) != 22 {
        println("FAIL nav y");
        process_exit(1);
    }
    if nav_vec3_z(v) != 33 {
        println("FAIL nav z");
        process_exit(1);
    }
    println("org_std_nav_vec3: PASSED");
}
