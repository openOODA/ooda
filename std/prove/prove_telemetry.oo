// # Org std aero/telemetry facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed telemetry header apid and seq.
//
// Setup: Tree oodac emit-c. Int header only. Import telemetry.oo only.
//
// Beats:
//   1. telemetry_header_new(42, 7, 128) apid is 42.
//   2. seq is 7 (not apid).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/telemetry.oo";

pub fn main() {
    let h: PacketHeader = telemetry_header_new(42, 7, 128);
    if telemetry_header_apid(h) != 42 {
        println("FAIL tm apid");
        process_exit(1);
    }
    if telemetry_header_seq(h) != 7 {
        println("FAIL tm seq");
        process_exit(1);
    }
    if telemetry_header_len(h) != 128 {
        println("FAIL tm len");
        process_exit(1);
    }
    println("org_std_telemetry: PASSED");
}
