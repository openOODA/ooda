// # Org std 3d/lights_spot prove
//
// Logline: Fail-closed emit+gcc+run of destubbed spot_light_set_position.
//
// Setup: Tree oodac emit-c. SpotLight is Int fields. No List[Float].
//
// Beats:
//   1. Default spot, then set position to (1, 2, 3).
//   2. x+y+z must be 6. Direction set to (4, 0, 0) must keep x=1.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/lights_spot.oo";

pub fn main() {
    let s0: SpotLight = spot_light_default();
    let s1: SpotLight = spot_light_set_position(s0, 1, 2, 3);
    let sx: Int = s1.x;
    let sy: Int = s1.y;
    let sz: Int = s1.z;
    if sx != 1 {
        println("FAIL spot x");
        process_exit(1);
    }
    if sy != 2 {
        println("FAIL spot y");
        process_exit(1);
    }
    if sz != 3 {
        println("FAIL spot z");
        process_exit(1);
    }
    let s2: SpotLight = spot_light_set_direction(s1, 4, 0, 0);
    let dx: Int = s2.dir_x;
    if dx != 4 {
        println("FAIL spot dir");
        process_exit(1);
    }
    if s2.x != 1 {
        println("FAIL spot pos kept");
        process_exit(1);
    }
    println("org_std_spot_light: PASSED");
}