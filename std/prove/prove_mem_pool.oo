// # Org std perf/memory_pool prove
//
// Logline: Fail-closed emit+gcc+run of destubbed memory pool alloc, free, and empty refuse.
//
// Setup: Tree oodac emit-c. Int block counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Create 2-block pool. Alloc twice. Used 2. Available 0.
//   2. Alloc while empty leaves used 2 and available 0.
//   3. Free once. Used 1. Available 1. Exit 1 before PASSED on a miss.

import "src/ooda/perf/memory_pool.oo";

pub fn main() {
    let p0: MemPool = mem_pool_create("mp", 16, 2);
    if mem_pool_available(p0) != 2 {
        println("FAIL pool init");
        process_exit(1);
    }
    let p1: MemPool = mem_pool_alloc(p0);
    let p2: MemPool = mem_pool_alloc(p1);
    if mem_pool_used(p2) != 2 {
        println("FAIL pool used2");
        process_exit(1);
    }
    if mem_pool_available(p2) != 0 {
        println("FAIL pool empty");
        process_exit(1);
    }
    let p3: MemPool = mem_pool_alloc(p2);
    if mem_pool_used(p3) != 2 {
        println("FAIL pool refuse");
        process_exit(1);
    }
    if mem_pool_available(p3) != 0 {
        println("FAIL pool still empty");
        process_exit(1);
    }
    let p4: MemPool = mem_pool_free(p3);
    if mem_pool_used(p4) != 1 {
        println("FAIL pool after free");
        process_exit(1);
    }
    if mem_pool_available(p4) != 1 {
        println("FAIL pool avail1");
        process_exit(1);
    }
    println("org_std_mem_pool: PASSED");
}
