// # Org std perf/stopwatch prove
//
// Logline: Fail-closed emit+gcc+run of destubbed stopwatch lap best and worst.
//
// Setup: Tree oodac emit-c. Int timestamps only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Start at 1000us. Lap at 1100us then 1300us.
//   2. Count is 2. Best is 100. Worst is 200.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/stopwatch.oo";

pub fn main() {
    let w0: Stopwatch = stopwatch_create("sw");
    let w1: Stopwatch = stopwatch_start(w0, 1000);
    let w2: Stopwatch = stopwatch_lap(w1, 1100);
    let w3: Stopwatch = stopwatch_lap(w2, 1300);
    if stopwatch_count(w3) != 2 {
        println("FAIL sw count");
        process_exit(1);
    }
    if stopwatch_best(w3) != 100 {
        println("FAIL sw best");
        process_exit(1);
    }
    if stopwatch_worst(w3) != 200 {
        println("FAIL sw worst");
        process_exit(1);
    }
    println("org_std_stopwatch: PASSED");
}