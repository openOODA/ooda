// # Wave 2 ASLR-Grid Proof Driver
//
// Logline: Drive ASLR config validate, entropy, range overlap, and grid-frequency inertia smoke tests.
//
// Setup: Imports sec/sys/aslr_types.oo, sec/sys/aslr_ops.oo, grid/freq_types.oo, and grid/freq_inertia.oo. CWD must be ooda/.
//
// Beats:
//   1. main: validate aslr_config_default() and assert no Err.
//   2. main: aslr_compute_entropy(65536) must equal 16 bits.
//   3. main: aslr_ranges_overlap(1000,500,1200,500) must be true.
//   4. main: grid_frequency_is_stable on default frequency must be true.
//   5. main: inertial_response_calc_kinetic_energy(5.0,1000.0) must be positive.
//   6. main: print WAVE2_INTEGRATION_SUITE_PASSED.
//
// residual: smoke only; no kernel ASLR or grid-load simulation.

import "src/ooda/sec/sys/aslr_types.oo";
import "src/ooda/sec/sys/aslr_ops.oo";
import "src/ooda/grid/freq_types.oo";
import "src/ooda/grid/freq_inertia.oo";

pub fn main() {
    let config = aslr_config_default();
    let val_res = aslr_config_validate(&config);
    if val_res.is_err() {
        println("FAIL: ASLR validate error");
        process_exit(1);
    }

    let entropy_bits = aslr_compute_entropy(65536);
    if entropy_bits != 16 {
        println("FAIL ASLR_ENTROPY");
        process_exit(1);
    }
    println("ASLR_ENTROPY: OK");

    let overlap = aslr_ranges_overlap(1000, 500, 1200, 500);
    if overlap != true {
        println("FAIL ASLR_OVERLAP");
        process_exit(1);
    }
    println("ASLR_OVERLAP: OK");

    let f_state = grid_frequency_default();
    if grid_frequency_is_stable(&f_state) != true {
        println("FAIL GRID_FREQ_STABLE");
        process_exit(1);
    }
    println("GRID_FREQ_STABLE: OK");

    let ke = inertial_response_calc_kinetic_energy(5.0, 1000.0);
    if ke <= 0.0 {
        println("FAIL GRID_INERTIA");
        process_exit(1);
    }
    println("GRID_INERTIA: OK");
    println("WAVE2_INTEGRATION_SUITE_PASSED");
}
