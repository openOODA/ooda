// # Org std perf/mem_stats prove
//
// Logline: Fail-closed emit+gcc+run of destubbed mem stats live bytes and peak.
//
// Setup: Tree oodac emit-c. Int bytes only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Alloc 32 then 16. In use 48. Peak 48. Live 2.
//   2. Free 16. In use 32. Peak stays 48. Live 1.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/mem_stats.oo";

pub fn main() {
    let m0: MemStats = mem_stats_create("ms");
    let m1: MemStats = mem_stats_record_alloc(m0, 32);
    let m2: MemStats = mem_stats_record_alloc(m1, 16);
    if mem_stats_bytes_in_use(m2) != 48 {
        println("FAIL ms inuse");
        process_exit(1);
    }
    if mem_stats_peak(m2) != 48 {
        println("FAIL ms peak");
        process_exit(1);
    }
    if mem_stats_live(m2) != 2 {
        println("FAIL ms live2");
        process_exit(1);
    }
    let m3: MemStats = mem_stats_record_free(m2, 16);
    if mem_stats_bytes_in_use(m3) != 32 {
        println("FAIL ms after free");
        process_exit(1);
    }
    if mem_stats_peak(m3) != 48 {
        println("FAIL ms peak keep");
        process_exit(1);
    }
    if mem_stats_live(m3) != 1 {
        println("FAIL ms live1");
        process_exit(1);
    }
    println("org_std_mem_stats: PASSED");
}
