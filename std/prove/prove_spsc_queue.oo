// # Org std perf/lockfree_queue prove
//
// Logline: Fail-closed emit+gcc+run of destubbed SPSC push, full refuse, and pop.
//
// Setup: Tree oodac emit-c. Int occupancy only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Cap 2. Push twice. Size 2. Full true.
//   2. Push while full leaves size 2 and push_count 2.
//   3. Pop once. Size 1. pop_count 1. Exit 1 before PASSED on a miss.

import "src/ooda/perf/lockfree_queue.oo";

pub fn main() {
    let q0: SpscQueue = spsc_queue_create("sq", 2);
    let q1: SpscQueue = spsc_queue_push(q0);
    let q2: SpscQueue = spsc_queue_push(q1);
    if spsc_queue_size(q2) != 2 {
        println("FAIL spsc size2");
        process_exit(1);
    }
    if spsc_queue_is_full(q2) != true {
        println("FAIL spsc full");
        process_exit(1);
    }
    let q3: SpscQueue = spsc_queue_push(q2);
    if spsc_queue_size(q3) != 2 {
        println("FAIL spsc stay2");
        process_exit(1);
    }
    if spsc_queue_push_count(q3) != 2 {
        println("FAIL spsc push2");
        process_exit(1);
    }
    let q4: SpscQueue = spsc_queue_pop(q3);
    if spsc_queue_size(q4) != 1 {
        println("FAIL spsc pop");
        process_exit(1);
    }
    if spsc_queue_pop_count(q4) != 1 {
        println("FAIL spsc pop1");
        process_exit(1);
    }
    println("org_std_spsc_queue: PASSED");
}
