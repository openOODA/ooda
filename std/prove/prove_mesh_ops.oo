// # Org std 3d/mesh_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed triangle centroid and mesh add.
//
// Setup: Tree oodac emit-c. Int geometry only. No List[Float]. Import mesh_ops only.
//
// Beats:
//   1. Triangle (0,0,0)/(6,0,0)/(0,6,0) centroid is (2,2,0).
//   2. mesh_add_triangle count is 1. mesh_get_centroid matches.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/mesh_ops.oo";

pub fn main() {
    let v1: Vector3 = vector3_new(0, 0, 0);
    let v2: Vector3 = vector3_new(6, 0, 0);
    let v3: Vector3 = vector3_new(0, 6, 0);
    let t: Triangle = triangle_new(v1, v2, v3);
    let c: Vector3 = triangle_centroid(t);
    let cx: Int = c.x;
    let cy: Int = c.y;
    let cz: Int = c.z;
    if cx != 2 {
        println("FAIL tri cx");
        process_exit(1);
    }
    if cy != 2 {
        println("FAIL tri cy");
        process_exit(1);
    }
    if cz != 0 {
        println("FAIL tri cz");
        process_exit(1);
    }
    let n: Vector3 = triangle_normal(t);
    let nz: Int = n.z;
    if nz != 36 {
        println("FAIL tri nz");
        process_exit(1);
    }
    let m0: Mesh = mesh_new(1);
    let m1: Mesh = mesh_add_triangle(m0, t);
    if mesh_get_triangle_count(m1) != 1 {
        println("FAIL mesh n1");
        process_exit(1);
    }
    let mc: Vector3 = mesh_get_centroid(m1);
    let mx: Int = mc.x;
    if mx != 2 {
        println("FAIL mesh cx");
        process_exit(1);
    }
    println("org_std_mesh_ops: PASSED");
}
