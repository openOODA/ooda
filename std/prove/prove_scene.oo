// # Org std 3d/scene_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed scene_new and scene_add.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. scene_new length is 0.
//   2. Two scene_add. Length 2. next_id 3.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/scene_types.oo";

pub fn main() {
    let s0: Scene = scene_new();
    if scene_len(s0) != 0 {
        println("FAIL scene empty");
        process_exit(1);
    }
    let s1: Scene = scene_add(s0);
    let s2: Scene = scene_add(s1);
    if scene_len(s2) != 2 {
        println("FAIL scene len2");
        process_exit(1);
    }
    let nid: Int = s2.next_id;
    if nid != 3 {
        println("FAIL scene next3");
        process_exit(1);
    }
    println("org_std_scene: PASSED");
}
