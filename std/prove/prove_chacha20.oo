// # Org std crypto/chacha20 prove
//
// Logline: Fail-closed emit+gcc+run of shipped chacha20_block against RFC 8439.
//
// Setup: Tree oodac emit-c. hex_decode builds the 32-byte key and 12-byte nonce.
//
// Beats:
//   1. RFC 8439 2.3.2 key 00..1f, nonce 000000090000004a00000000, counter 1.
//   2. Block hex is the published 128-nibble string.
//   3. Exit 1 before PASSED on a miss.

import "crypto/chacha20.oo";
import "src/ooda/sec/crypto/hmac_ops.oo";

pub fn main() {
    let key_r: Result[String, String] = hex_decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    if key_r.is_err() {
        println("FAIL chacha key hex");
        process_exit(1);
    }
    let nonce_r: Result[String, String] = hex_decode("000000090000004a00000000");
    if nonce_r.is_err() {
        println("FAIL chacha nonce hex");
        process_exit(1);
    }
    let key: String = key_r.unwrap();
    let nonce: String = nonce_r.unwrap();
    let blk: String = chacha20_block(key, nonce, 1);
    if blk != "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e" {
        println("FAIL chacha rfc8439");
        process_exit(1);
    }
    println("org_std_chacha20: PASSED");
}
