// # Org std perf/memory_arena_pool prove
//
// Logline: Fail-closed emit+gcc+run of destubbed arena pool acquire, refuse, and reset count.
//
// Setup: Tree oodac emit-c. Int counters only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Max 1. Acquire. Active 1. Record 32 bytes.
//   2. Acquire while full leaves active 1.
//   3. Release. Active 0. Reset count 1. Exit 1 before PASSED on a miss.

import "src/ooda/perf/memory_arena_pool.oo";

pub fn main() {
    let p0: ArenaPool = arena_pool_create("ap", 1);
    let p1: ArenaPool = arena_pool_acquire(p0);
    if arena_pool_active(p1) != 1 {
        println("FAIL ap active1");
        process_exit(1);
    }
    let p2: ArenaPool = arena_pool_record_alloc(p1, 32);
    if arena_pool_total_alloc(p2) != 32 {
        println("FAIL ap bytes32");
        process_exit(1);
    }
    let p3: ArenaPool = arena_pool_acquire(p2);
    if arena_pool_active(p3) != 1 {
        println("FAIL ap refuse");
        process_exit(1);
    }
    let p4: ArenaPool = arena_pool_release(p3);
    if arena_pool_active(p4) != 0 {
        println("FAIL ap released");
        process_exit(1);
    }
    if arena_pool_reset_count(p4) != 1 {
        println("FAIL ap reset1");
        process_exit(1);
    }
    println("org_std_arena_pool: PASSED");
}
