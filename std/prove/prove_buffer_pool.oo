// # Org std perf/buffer_pool prove
//
// Logline: Fail-closed emit+gcc+run of destubbed buffer pool alloc, miss, and hit_rate.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Cap 1. Alloc once. Used 1. Hit rate 100.
//   2. Alloc while empty increments attempts. Hit rate 50.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/buffer_pool.oo";

pub fn main() {
    let p0: BufferPool = buffer_pool_create("bp", 64, 1);
    let p1: BufferPool = buffer_pool_alloc(p0);
    if buffer_pool_used(p1) != 1 {
        println("FAIL bp used1");
        process_exit(1);
    }
    if buffer_pool_hit_rate(p1) != 100 {
        println("FAIL bp hit100");
        process_exit(1);
    }
    let p2: BufferPool = buffer_pool_alloc(p1);
    if buffer_pool_used(p2) != 1 {
        println("FAIL bp refuse");
        process_exit(1);
    }
    if buffer_pool_attempts(p2) != 2 {
        println("FAIL bp att2");
        process_exit(1);
    }
    if buffer_pool_alloc_count(p2) != 1 {
        println("FAIL bp acq1");
        process_exit(1);
    }
    if buffer_pool_hit_rate(p2) != 50 {
        println("FAIL bp hit50");
        process_exit(1);
    }
    println("org_std_buffer_pool: PASSED");
}
