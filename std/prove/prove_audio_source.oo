// # Org std 3d/spatial_audio_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed audio_source_new channels.
//
// Setup: Tree oodac emit-c. Int coords only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. audio_source_new(1,2,3,80) volume is 80.
//   2. Stored z is 3 (not volume).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/spatial_audio_types.oo";

pub fn main() {
    let s: AudioSource = audio_source_new(1, 2, 3, 80);
    if audio_source_volume(s) != 80 {
        println("FAIL audio vol");
        process_exit(1);
    }
    let z: Int = s.z;
    if z != 3 {
        println("FAIL audio z");
        process_exit(1);
    }
    let x: Int = s.x;
    if x != 1 {
        println("FAIL audio x");
        process_exit(1);
    }
    println("org_std_audio_source: PASSED");
}
