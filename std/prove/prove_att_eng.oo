// # Org std aero/attitude_engine prove
//
// Logline: Fail-closed emit+gcc+run of destubbed att_eng mode and rate.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. att_eng_new(2, 45) mode is 2.
//   2. Rate is 45 (not mode).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/attitude_engine.oo";

pub fn main() {
    let e: AttEng = att_eng_new(2, 45);
    if att_eng_mode(e) != 2 {
        println("FAIL atteng mode");
        process_exit(1);
    }
    if att_eng_rate(e) != 45 {
        println("FAIL atteng rate");
        process_exit(1);
    }
    println("org_std_att_eng: PASSED");
}
