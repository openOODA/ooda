// # Org std aero/attitude facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed attitude_vec3 x and y.
//
// Setup: Tree oodac emit-c. Int components only. Import attitude.oo only.
//
// Beats:
//   1. attitude_vec3_new(13, 27, 41) x is 13.
//   2. y is 27 (not x). z is 41.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/attitude.oo";

pub fn main() {
    let v: AttVec3 = attitude_vec3_new(13, 27, 41);
    if attitude_vec3_x(v) != 13 {
        println("FAIL att x");
        process_exit(1);
    }
    if attitude_vec3_y(v) != 27 {
        println("FAIL att y");
        process_exit(1);
    }
    if attitude_vec3_z(v) != 41 {
        println("FAIL att z");
        process_exit(1);
    }
    println("org_std_attitude: PASSED");
}
