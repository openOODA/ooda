// # Org perf refcount prove
//
// Logline: Fail-closed emit+gcc+run of shipped refcount_create/inc.
//
// Setup: Org std/src/ooda/perf/refcount.oo. One domain slice, not folder cert.
//
// Beats:
//   1. Create count is 1.
//   2. After inc count is 2.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/refcount.oo";

pub fn main() {
    let rc0: RefCount = refcount_create("x");
    let c0: Int = rc0.count;
    if c0 != 1 {
        println("FAIL rc create");
        process_exit(1);
    }
    let rc1: RefCount = refcount_inc(rc0);
    let c1: Int = rc1.count;
    if c1 != 2 {
        println("FAIL rc inc");
        process_exit(1);
    }
    println("org_perf_refcount: PASSED");
}
