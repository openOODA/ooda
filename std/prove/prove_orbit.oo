// # Org std aero/orbit facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed orbit_state x and y.
//
// Setup: Tree oodac emit-c. Int components only. Import orbit.oo only.
//
// Beats:
//   1. orbit_state_new(11, 22, 33) x is 11.
//   2. y is 22 (not x). z is 33.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/orbit.oo";

pub fn main() {
    let v: Vec3 = orbit_state_new(11, 22, 33);
    if orbit_state_x(v) != 11 {
        println("FAIL orbit x");
        process_exit(1);
    }
    if orbit_state_y(v) != 22 {
        println("FAIL orbit y");
        process_exit(1);
    }
    if orbit_state_z(v) != 33 {
        println("FAIL orbit z");
        process_exit(1);
    }
    println("org_std_orbit: PASSED");
}
