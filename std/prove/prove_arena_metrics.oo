// # Org std perf/arena_metrics prove
//
// Logline: Fail-closed emit+gcc+run of destubbed arena metrics bytes, peak, and leaks.
//
// Setup: Tree oodac emit-c. Int counts only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Record alloc 32 then 16. Bytes 48. Peak 48. Leaks 2.
//   2. Free 16. Bytes 32. Peak stays 48. Leaks 1.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/arena_metrics.oo";

pub fn main() {
    let m0: ArenaMetrics = arena_metrics_create("am");
    let m1: ArenaMetrics = arena_metrics_record_alloc(m0, 32);
    let m2: ArenaMetrics = arena_metrics_record_alloc(m1, 16);
    if arena_metrics_total_bytes(m2) != 48 {
        println("FAIL metrics bytes");
        process_exit(1);
    }
    if arena_metrics_peak_bytes(m2) != 48 {
        println("FAIL metrics peak");
        process_exit(1);
    }
    if arena_metrics_check_leaks(m2) != 2 {
        println("FAIL metrics leaks2");
        process_exit(1);
    }
    let m3: ArenaMetrics = arena_metrics_record_free(m2, 16);
    if arena_metrics_total_bytes(m3) != 32 {
        println("FAIL metrics after free");
        process_exit(1);
    }
    if arena_metrics_peak_bytes(m3) != 48 {
        println("FAIL metrics peak keep");
        process_exit(1);
    }
    if arena_metrics_check_leaks(m3) != 1 {
        println("FAIL metrics leaks1");
        process_exit(1);
    }
    println("org_std_arena_metrics: PASSED");
}
