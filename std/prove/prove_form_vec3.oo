// # Org std aero/formation_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed form_vec3_new axes.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. form_vec3_new(2, 8, 9) x is 2.
//   2. y is 8 (not x). z is 9.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/formation_types.oo";

pub fn main() {
    let v: FormVec3 = form_vec3_new(2, 8, 9);
    if form_vec3_x(v) != 2 {
        println("FAIL form x");
        process_exit(1);
    }
    if form_vec3_y(v) != 8 {
        println("FAIL form y");
        process_exit(1);
    }
    if form_vec3_z(v) != 9 {
        println("FAIL form z");
        process_exit(1);
    }
    println("org_std_form_vec3: PASSED");
}
