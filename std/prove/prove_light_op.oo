// # Org std 3d/lights_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed LightOp intensity.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Build LightOp kind 2 intensity 80.
//   2. light_op_intensity must return 80.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/3d/lights_ops.oo";

pub fn main() {
    let op: LightOp = light_op_new(2, 80);
    if light_op_intensity(op) != 80 {
        println("FAIL light_op intensity");
        process_exit(1);
    }
    if light_op_intensity(light_op_new(1, 0)) != 0 {
        println("FAIL light_op zero");
        process_exit(1);
    }
    println("org_std_light_op: PASSED");
}