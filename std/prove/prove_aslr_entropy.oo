// # Org std ASLR entropy prove
//
// Logline: Fail-closed emit+gcc+run of shipped aslr_compute_entropy.
//
// Setup: Locked oodac. Calls aslr_entropy.oo only (no struct emit).
//
// Beats:
//   1. 65536 is 16 bits.
//   2. 0 and 1 are 0 bits.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/sec/sys/aslr_entropy.oo";

pub fn main() {
    if aslr_compute_entropy(65536) != 16 {
        println("FAIL entropy 65536");
        process_exit(1);
    }
    if aslr_compute_entropy(0) != 0 {
        println("FAIL entropy 0");
        process_exit(1);
    }
    if aslr_compute_entropy(1) != 0 {
        println("FAIL entropy 1");
        process_exit(1);
    }
    println("org_std_aslr_entropy: PASSED");
}
