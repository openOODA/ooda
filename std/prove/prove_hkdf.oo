// # Org std crypto/hkdf prove
//
// Logline: Fail-closed emit+gcc+run of shipped hkdf extract and combined RFC 5869 A.1.
//
// Setup: Tree oodac emit-c. Local hex_decode only. Combined hkdf must not process_exit.
//
// Beats:
//   1. Extract of RFC 4231 case 2 matches the published HMAC hex.
//   2. Combined hkdf(salt, ikm, info, 42) matches RFC 5869 A.1 OKM hex.
//   3. Exit 1 before PASSED on a miss.

import "crypto/hkdf.oo";

fn px_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

fn px_hex_decode(hex: String) -> String {
    let n: Int = hex.len();
    if n % 2 != 0 {
        process_exit(1);
        return "";
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        let hi_v: Int = px_nibble(byte_at(hex, i));
        let lo_v: Int = px_nibble(byte_at(hex, i + 1));
        if hi_v < 0 {
            process_exit(1);
            return "";
        }
        if lo_v < 0 {
            process_exit(1);
            return "";
        }
        buf = bytes_push(buf, hi_v * 16 + lo_v);
        i = i + 2;
    }
    return bytes_to_str(buf);
}

pub fn main() {
    let prk_ascii: String = hkdf_extract("Jefe", "what do ya want for nothing?");
    if prk_ascii != "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" {
        println("FAIL hkdf extract rfc4231-2");
        process_exit(1);
    }
    let salt: String = px_hex_decode("000102030405060708090a0b0c");
    let ikm: String = px_hex_decode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
    let info: String = px_hex_decode("f0f1f2f3f4f5f6f7f8f9");
    let prk_a1: String = hkdf_extract(salt, ikm);
    if prk_a1 != "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" {
        println("FAIL hkdf extract rfc5869-a1");
        process_exit(1);
    }
    let okm: String = hkdf(salt, ikm, info, 42);
    if okm != "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865" {
        println("FAIL hkdf combined rfc5869-a1");
        process_exit(1);
    }
    println("org_std_hkdf: PASSED");
}
