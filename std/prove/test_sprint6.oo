// # Sprint 6 Integration Suite
//
// Logline: Exercise game-engine AABB overlap and TUI box-drawing glyph shims.
//
// Setup: Imports src/ooda/game_engine/collision_aabb.oo and tui/box_drawing.oo. CWD must be ooda/.
//
// Beats:
//   1. main: build two AABB2D rectangles and assert overlap flag == 1.
//   2. main: build a BoxGlyphs single-line set and assert the horizontal glyph.
//   3. main: print SPRINT6_INTEGRATION_SUITE_PASSED and process_exit(0).
//
// residual: smoke only; no path-coverage or fuzz.

import "src/ooda/game_engine/collision_aabb.oo";
import "src/ooda/tui/box_drawing.oo";

pub fn main() {
    // 1. Game Engine AABB Test
    let box1: AABB2D = aabb2d_new(0.0, 0.0, 10.0, 10.0);
    let box2: AABB2D = aabb2d_new(5.0, 5.0, 15.0, 15.0);
    let has_overlap: Int = aabb2d_overlaps(&box1, &box2);
    if has_overlap == 1 {
        println("GAME_COLLISION_AABB: OK");
    }

    // 2. TUI Box Drawing Test
    let glyphs: BoxGlyphs = box_glyphs_single();
    if (glyphs).horizontal == "─" {
        println("TUI_BOX_DRAWING: OK");
    }

    println("SPRINT6_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
