import "src/ooda/game_engine/collision_aabb.oo";
import "src/ooda/tui/box_drawing.oo";

pub fn main() {
    // 1. Game Engine AABB Test
    let box1: AABB2D = aabb2d_new(0.0, 0.0, 10.0, 10.0);
    let box2: AABB2D = aabb2d_new(5.0, 5.0, 15.0, 15.0);
    let has_overlap: Int = aabb2d_overlaps(&box1, &box2);
    if has_overlap == 1 {
        println("GAME_COLLISION_AABB: OK");
    }

    // 2. TUI Box Drawing Test
    let glyphs: BoxGlyphs = box_glyphs_single();
    if (glyphs).horizontal == "─" {
        println("TUI_BOX_DRAWING: OK");
    }

    println("SPRINT6_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
