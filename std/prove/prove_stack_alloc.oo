// # Org std perf/stack_allocator prove
//
// Logline: Fail-closed emit+gcc+run of destubbed stack bump alloc and reset.
//
// Setup: Tree oodac emit-c. Int sizes only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Capacity 100. Alloc 30 then 20. Used is 50. Peak is 50. Remaining is 50.
//   2. Reset zeros used and keeps peak 50.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/stack_allocator.oo";

pub fn main() {
    let a0: StackAlloc = stack_alloc_create("s", 100);
    let a1: StackAlloc = stack_alloc_alloc(a0, 30);
    let a2: StackAlloc = stack_alloc_alloc(a1, 20);
    if stack_alloc_used(a2) != 50 {
        println("FAIL stk used");
        process_exit(1);
    }
    if stack_alloc_peak(a2) != 50 {
        println("FAIL stk peak");
        process_exit(1);
    }
    if stack_alloc_remaining(a2) != 50 {
        println("FAIL stk remain");
        process_exit(1);
    }
    let a3: StackAlloc = stack_alloc_reset(a2);
    if stack_alloc_used(a3) != 0 {
        println("FAIL stk reset used");
        process_exit(1);
    }
    if stack_alloc_peak(a3) != 50 {
        println("FAIL stk peak keep");
        process_exit(1);
    }
    println("org_std_stack_alloc: PASSED");
}