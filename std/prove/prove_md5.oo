// # Org std hash/md5 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/md5.oo one-shot.
//
// Setup: Tree oodac emit-c. Calls md5. RFC 1321 A.5 vectors. No caps.
//
// Beats:
//   1. md5("") is d41d8cd98f00b204e9800998ecf8427e.
//   2. md5("abc") is 900150983cd24fb0d6963f7d28e17f72.
//   3. Exit 1 before PASSED on a miss.

import "hash/md5.oo";

pub fn main() {
    let empty: String = md5("");
    if empty != "d41d8cd98f00b204e9800998ecf8427e" {
        println("FAIL md5 empty");
        process_exit(1);
    }
    let abc: String = md5("abc");
    if abc != "900150983cd24fb0d6963f7d28e17f72" {
        println("FAIL md5 abc");
        process_exit(1);
    }
    println("org_std_md5: PASSED");
}
