// # Sprint 3 Integration Suite
//
// Logline: Drive AI/ML ReLU activation, vector cosine similarity, and WASM LEB128 encoding smoke tests.
//
// Setup: Imports ai_ml/activation_ops.oo, database/vector_cosine.oo, and compilers/wasm_encoder.oo. CWD must be ooda/.
//
// Beats:
//   1. main: assert act_relu(5.5) == 5.5.
//   2. main: build two equal VectorFloat and assert cosine_similarity > 0.
//   3. main: encode 624485 as WASM LEB128 and assert the list is non-empty.
//   4. main: print SPRINT3_INTEGRATION_SUITE_PASSED and process_exit(0).
//
// residual: smoke only; no SIMD or vector math intrinsics.

import "src/ooda/ai_ml/activation_ops.oo";
import "src/ooda/database/vector_cosine.oo";
import "src/ooda/compilers/wasm_encoder.oo";

pub fn main() {
    // 1. AI/ML Activation Test
    let r_pos: Float = act_relu(5.5);
    if r_pos == 5.5 {
        println("AI_ML_RELU: OK");
    }

    // 2. Database Vector Cosine Test
    let mut v1_list: List[Int] = list_new();
    v1_list = list_push(v1_list, 100);
    v1_list = list_push(v1_list, 0);
    let v1: VectorFloat = vector_create(v1_list);

    let mut v2_list: List[Int] = list_new();
    v2_list = list_push(v2_list, 100);
    v2_list = list_push(v2_list, 0);
    let v2: VectorFloat = vector_create(v2_list);

    let sim: Int = vector_cosine_similarity(&v1, &v2);
    if sim > 0 {
        println("DB_VECTOR_COSINE: OK");
    }

    // 3. Compiler WASM LEB128 Test
    let leb: List[Int] = wasm_encode_u32_leb128(624485);
    if list_len(leb) > 0 {
        println("COMPILER_WASM_ENCODER: OK");
    }

    println("SPRINT3_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
