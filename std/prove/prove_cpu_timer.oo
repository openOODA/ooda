// # Org std perf/cpu_timer prove
//
// Logline: Fail-closed emit+gcc+run of destubbed cpu_timer start and stop.
//
// Setup: Tree oodac emit-c. Int timestamps only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. Start at 1000us and stop at 1250us. Elapsed must be 250.
//   2. Count must be 1. Timer must not still be running.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/cpu_timer.oo";

pub fn main() {
    let t0: CpuTimer = cpu_timer_create("t");
    let t1: CpuTimer = cpu_timer_start(t0, 1000);
    if cpu_timer_is_running(t1) != true {
        println("FAIL cpu start");
        process_exit(1);
    }
    let t2: CpuTimer = cpu_timer_stop(t1, 1250);
    if cpu_timer_elapsed_us(t2) != 250 {
        println("FAIL cpu elapsed");
        process_exit(1);
    }
    if cpu_timer_count(t2) != 1 {
        println("FAIL cpu count");
        process_exit(1);
    }
    if cpu_timer_is_running(t2) != false {
        println("FAIL cpu stopped");
        process_exit(1);
    }
    println("org_std_cpu_timer: PASSED");
}