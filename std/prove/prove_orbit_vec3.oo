// # Org std aero/orbit_types prove
//
// Logline: Fail-closed emit+gcc+run of destubbed orbit_vec3_new axes.
//
// Setup: Tree oodac emit-c. Int components only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. orbit_vec3_new(5, 6, 7) x is 5.
//   2. y is 6 (not x). z is 7.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/orbit_types.oo";

pub fn main() {
    let v: Vec3 = orbit_vec3_new(5, 6, 7);
    if orbit_vec3_x(v) != 5 {
        println("FAIL ovec x");
        process_exit(1);
    }
    if orbit_vec3_y(v) != 6 {
        println("FAIL ovec y");
        process_exit(1);
    }
    if orbit_vec3_z(v) != 7 {
        println("FAIL ovec z");
        process_exit(1);
    }
    println("org_std_orbit_vec3: PASSED");
}
