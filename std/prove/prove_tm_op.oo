// # Org std aero/telemetry_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed tm_op apid and seq.
//
// Setup: Tree oodac emit-c. Int fields only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. tm_op_new(2048, 7) apid is 2048.
//   2. seq is 7 (not apid).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/telemetry_ops.oo";

pub fn main() {
    let op: TmOp = tm_op_new(2048, 7);
    if tm_op_apid(op) != 2048 {
        println("FAIL tmop apid");
        process_exit(1);
    }
    if tm_op_seq(op) != 7 {
        println("FAIL tmop seq");
        process_exit(1);
    }
    println("org_std_tm_op: PASSED");
}
