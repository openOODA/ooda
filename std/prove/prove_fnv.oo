// # Org std FNV-1a prove
//
// Logline: Fail-closed emit+gcc+run of shipped fnv1a_32 against published vectors.
//
// Setup: Locked oodac. Calls hash/fnv.oo. No caps.
//
// Beats:
//   1. Empty string is the offset basis 2166136261.
//   2. foobar is 3214735720 (0xbf9cf968).
//   3. Exit 1 before PASSED on any miss.

import "hash/fnv.oo";

pub fn main() {
    let empty: Int = fnv1a_32("");
    if empty != 2166136261 {
        println("FAIL fnv empty");
        process_exit(1);
    }
    let fb: Int = fnv1a_32("foobar");
    if fb != 3214735720 {
        println("FAIL fnv foobar");
        process_exit(1);
    }
    println("org_std_fnv: PASSED");
}
