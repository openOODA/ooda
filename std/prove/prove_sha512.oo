// # Org std hash/sha512 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/sha512.oo one-shot.
//
// Setup: Tree oodac emit-c. Calls sha512. FIPS 180-4 / NIST vectors. No caps.
//
// Beats:
//   1. sha512("") is the NIST empty digest.
//   2. sha512("abc") is the FIPS abc digest (12e6fa4e..., not the Wikipedia 12e6c746... typo).
//   3. Exit 1 before PASSED on a miss.

import "hash/sha512.oo";

pub fn main() {
    let empty: String = sha512("");
    if empty != "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" {
        println("FAIL sha512 empty");
        process_exit(1);
    }
    let abc: String = sha512("abc");
    if abc != "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" {
        println("FAIL sha512 abc");
        process_exit(1);
    }
    println("org_std_sha512: PASSED");
}
