// # Org std aero/navigation facade prove
//
// Logline: Fail-closed emit+gcc+run of destubbed navigation_fix lat and lon.
//
// Setup: Tree oodac emit-c. Int milli-deg only. Import navigation.oo only.
//
// Beats:
//   1. navigation_fix_new(51234, -99876) lat is 51234.
//   2. lon is -99876 (not lat).
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/aero/navigation.oo";

pub fn main() {
    let lon_v: Int = 0 - 99876;
    let c: NavCoord = navigation_fix_new(51234, lon_v);
    if navigation_fix_lat(c) != 51234 {
        println("FAIL navfix lat");
        process_exit(1);
    }
    if navigation_fix_lon(c) != lon_v {
        println("FAIL navfix lon");
        process_exit(1);
    }
    println("org_std_navigation: PASSED");
}
