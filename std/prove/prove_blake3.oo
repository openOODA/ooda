// # Org std hash/blake3 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/blake3.oo one-shot.
//
// Setup: Tree oodac emit-c. Calls blake3. Official BLAKE3 test vectors. No caps.
//
// Beats:
//   1. blake3("") is the official empty digest.
//   2. blake3("abc") is the published abc digest.
//   3. Exit 1 before PASSED on a miss.

import "hash/blake3.oo";

pub fn main() {
    let empty: String = blake3("");
    if empty != "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262" {
        println("FAIL blake3 empty");
        process_exit(1);
    }
    let abc: String = blake3("abc");
    if abc != "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85" {
        println("FAIL blake3 abc");
        process_exit(1);
    }
    println("org_std_blake3: PASSED");
}
