// # Org std hash/xxhash XXH64 prove
//
// Logline: Fail-closed emit+gcc+run of shipped xxhash64_hex against official vectors.
//
// Setup: Tree oodac emit-c. Calls hash/xxhash.oo. Seed 0.
//
// Beats:
//   1. Empty is ef46db3751d8e999 (official XXH64 seed 0).
//   2. hello is 26c7827d889f6da3 (independent published spec digest).
//   3. Exit 1 before PASSED on a miss.

import "hash/xxhash.oo";

pub fn main() {
    let empty: String = xxhash64_hex("", 0);
    if empty != "ef46db3751d8e999" {
        println("FAIL xxh64 empty");
        process_exit(1);
    }
    let h: String = xxhash64_hex("hello", 0);
    if h != "26c7827d889f6da3" {
        println("FAIL xxh64 hello");
        process_exit(1);
    }
    println("org_std_xxh64: PASSED");
}
