// # Org std perf/simd_byte_ops prove
//
// Logline: Fail-closed emit+gcc+run of destubbed find_byte, count_byte, and memcmp.
//
// Setup: Tree oodac emit-c. ASCII bytes only. No List[Float]. No process_exit in the leaf.
//
// Beats:
//   1. find_byte('l') in "hello" is 2. count_byte is 2.
//   2. memcmp("abc","abd",3) is -1.
//   3. memset_value(3, 5) is 15. Exit 1 before PASSED on a miss.

import "src/ooda/perf/simd_byte_ops.oo";

pub fn main() {
    let idx: Int = simd_find_byte("hello", 5, 108);
    if idx != 2 {
        println("FAIL simd find l");
        process_exit(1);
    }
    let cnt: Int = simd_count_byte("hello", 5, 108);
    if cnt != 2 {
        println("FAIL simd count l");
        process_exit(1);
    }
    let cmp: Int = simd_memcmp("abc", "abd", 3);
    if cmp != -1 {
        println("FAIL simd memcmp");
        process_exit(1);
    }
    let fill: Int = simd_memset_value(3, 5);
    if fill != 15 {
        println("FAIL simd memset");
        process_exit(1);
    }
    println("org_std_simd_bytes: PASSED");
}
