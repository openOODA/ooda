import "src/ooda/astro_advanced/astro_constants.oo";
import "src/ooda/scicomp/sparse_matrix_csr.oo";
import "src/ooda/fintech_defi/amm_constant_product.oo";

pub fn main() {
    // 1. Astro Constants Test
    let c: Float = const_c();
    if c > 299000000.0 {
        println("ASTRO_CONSTANTS_SPEED_OF_LIGHT: OK");
    }

    // 2. SciComp Sparse Matrix CSR Test
    let csr: CsrMatrix = csr_matrix_new(10, 10);
    if (csr).rows == 10 {
        println("SCICOMP_CSR_SPARSE_MATRIX: OK");
    }

    // 3. FinTech DeFi AMM Constant Product Test
    let pool: ConstantProductPool = amm_pool_new("ETH", "USDC", 1000, 2000000, 10000, 30);
    let quote: SwapQuote = amm_get_amount_out(10, (pool).reserve_a, (pool).reserve_b, (pool).fee_bps);
    if (quote).amount_out > 0 {
        println("FINTECH_DEFI_AMM: OK");
    }

    println("MEGA_SWARM_INTEGRATION_PASSED");
    process_exit(0);
}
