// # Sparse Merkle Tree Syntax Smoke
//
// Logline: Drive sparse Merkle tree insert via smt_compact_tree_new, smt_compact_node_new, and smt_compact_tree_add_node.
//
// Setup: Self-contained smoke driver. CWD must be ooda/.
//
// Beats:
//   1. build an SmtCompactTree with root 0x00.
//   2. allocate an SmtCompactNode with id 10 and 101-bit path.
//   3. append the node to the tree and print test ok.
//
// residual: smoke only; no merkle proof verification.

type SmtCompactNode = struct {
    bit_depth: Int,
    path_bits: String,
    value_hash: String,
    is_leaf: Bool
};

type SmtCompactTree = struct {
    root_hash: String,
    nodes: List[SmtCompactNode],
    total_pruned_levels: Int
};

pub fn smt_compact_node_new(depth: Int, bits: String, val_h: String, is_l: Bool) -> SmtCompactNode {
    return SmtCompactNode {
        bit_depth: depth,
        path_bits: bits,
        value_hash: val_h,
        is_leaf: is_l
    };
}

pub fn smt_compact_tree_new(r_hash: String) -> SmtCompactTree {
    let empty_nodes: List[SmtCompactNode] = list_new();
    return SmtCompactTree {
        root_hash: r_hash,
        nodes: empty_nodes,
        total_pruned_levels: 0
    };
}

pub fn smt_compact_tree_add_node(
    tree: SmtCompactTree,
    node: SmtCompactNode
) -> SmtCompactTree {
    let mut cur_nodes: List[SmtCompactNode] = tree.nodes;
    cur_nodes = list_push(cur_nodes, node);
    let pruned: Int = tree.total_pruned_levels + (256 - node.bit_depth);

    return SmtCompactTree {
        root_hash: tree.root_hash,
        nodes: cur_nodes,
        total_pruned_levels: pruned
    };
}

pub fn main() {
    let tree: SmtCompactTree = smt_compact_tree_new("0x00");
    let node: SmtCompactNode = smt_compact_node_new(10, "101", "0x01", true);
    let tree2: SmtCompactTree = smt_compact_tree_add_node(tree, node);
    println("ok");
}
