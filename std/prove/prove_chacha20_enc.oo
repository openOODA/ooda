// # Org std ChaCha20 one-block encrypt prove
//
// Logline: Fail-closed emit+gcc+run of shipped chacha20_encrypt on 64 zero bytes.
//
// Setup: XOR of RFC 8439 2.3.2 keystream with zeros is the block hex.
//
// Beats:
//   1. Build 64 zero bytes.
//   2. Encrypt with the RFC 8439 2.3.2 key/nonce.
//   3. Decrypt of that hex returns 64 zero bytes. Exit 1 before PASSED on a miss.

import "crypto/chacha20.oo";

pub fn main() {
    let key_hex: String = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    let nonce_hex: String = "000000090000004a00000000";
    let mut key_buf: List[Int] = bytes_new();
    let mut ni: Int = 0;
    while ni < 64 {
        let hv: Int = byte_at(key_hex, ni);
        let lv: Int = byte_at(key_hex, ni + 1);
        let mut hi: Int = 0;
        let mut lo: Int = 0;
        if hv >= 97 { hi = hv - 87; } else { hi = hv - 48; }
        if lv >= 97 { lo = lv - 87; } else { lo = lv - 48; }
        key_buf = bytes_push(key_buf, hi * 16 + lo);
        ni = ni + 2;
    }
    let key: String = bytes_to_str(key_buf);
    let mut nonce_buf: List[Int] = bytes_new();
    let mut nj: Int = 0;
    while nj < 24 {
        let hv2: Int = byte_at(nonce_hex, nj);
        let lv2: Int = byte_at(nonce_hex, nj + 1);
        let mut hi2: Int = 0;
        let mut lo2: Int = 0;
        if hv2 >= 97 { hi2 = hv2 - 87; } else { hi2 = hv2 - 48; }
        if lv2 >= 97 { lo2 = lv2 - 87; } else { lo2 = lv2 - 48; }
        nonce_buf = bytes_push(nonce_buf, hi2 * 16 + lo2);
        nj = nj + 2;
    }
    let nonce: String = bytes_to_str(nonce_buf);
    let mut zbuf: List[Int] = bytes_new();
    let mut z: Int = 0;
    while z < 64 {
        zbuf = bytes_push(zbuf, 0);
        z = z + 1;
    }
    let zeros: String = bytes_to_str(zbuf);
    let ct: String = chacha20_encrypt(key, nonce, zeros);
    if ct != "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e" {
        println("FAIL chacha encrypt zeros");
        process_exit(1);
    }
    let back: String = chacha20_decrypt(key, nonce, ct);
    if back != zeros {
        println("FAIL chacha decrypt zeros");
        process_exit(1);
    }
    println("org_std_chacha20_enc: PASSED");
}
