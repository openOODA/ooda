// # Org std perf/copy_on_write prove
//
// Logline: Fail-closed emit+gcc+run of destubbed share and copy-on-write.
//
// Setup: Tree oodac emit-c. Int counters and String data. No List[Float].
//
// Beats:
//   1. Share increments ref_count. Write while shared increments copy_count.
//   2. Copied buffer holds the new data. Unique write does not copy again.
//   3. Exit 1 before PASSED on a miss.

import "src/ooda/perf/copy_on_write.oo";

pub fn main() {
    let b0: CowBuffer = cow_buffer_create("b", "hello");
    let b1: CowBuffer = cow_buffer_share(b0);
    if cow_buffer_refcount(b1) != 2 {
        println("FAIL cow ref2");
        process_exit(1);
    }
    let b2: CowBuffer = cow_buffer_write(b1, "world");
    if cow_buffer_copy_count(b2) != 1 {
        println("FAIL cow copy1");
        process_exit(1);
    }
    if cow_buffer_data(b2) != "world" {
        println("FAIL cow data");
        process_exit(1);
    }
    if cow_buffer_refcount(b2) != 1 {
        println("FAIL cow ref1");
        process_exit(1);
    }
    let b3: CowBuffer = cow_buffer_write(b2, "next");
    if cow_buffer_copy_count(b3) != 1 {
        println("FAIL cow no second copy");
        process_exit(1);
    }
    if cow_buffer_write_count(b3) != 2 {
        println("FAIL cow writes");
        process_exit(1);
    }
    println("org_std_cow: PASSED");
}