import "src/ooda/fintech/black_scholes.oo";
import "src/ooda/bioinformatics/dna_sequence.oo";
import "src/ooda/astrodynamics/kepler_orbit.oo";
import "src/ooda/embedded_hal/crc32_hardware.oo";

pub fn main() {
    // 1. FinTech Black-Scholes Test
    let opt: EuropeanOption = EuropeanOption {
        is_call: true,
        spot: 100.0,
        strike: 100.0,
        time_to_expiry: 1.0,
        risk_free_rate: 0.05,
        dividend_yield: 0.0,
        volatility: 0.2
    };
    let res: BsPriceResult = black_scholes_price(&opt);
    if (res).price > 0.0 {
        println("FINTECH_BLACK_SCHOLES: OK");
    }

    // 2. Bioinformatics DNA Test
    let rev_comp: String = dna_reverse_complement("ATGC");
    if rev_comp == "GCAT" {
        println("BIOINFORMATICS_DNA: OK");
    }

    // 3. Astrodynamics Kepler Orbit Test
    let r_vec: Vector3 = vec3_new(7000.0, 0.0, 0.0);
    let mu_earth: Float = 398600441800000.0;
    let v_circ: Float = kepler_orbit_circular_velocity(7000000.0, mu_earth);
    if v_circ > 0.0 {
        println("ASTRODYNAMICS_KEPLER: OK");
    }

    // 4. Embedded HAL Hardware CRC32 Test
    let engine: Crc32Engine = crc32_engine_new_ieee();
    if (engine).init_seed > 0 {
        println("EMBEDDED_CRC32: OK");
    }

    println("SWARM12_INTEGRATION_SUITE_PASSED");
    process_exit(0);
}
