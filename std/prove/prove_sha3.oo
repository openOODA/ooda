// # Org std hash/sha3 prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash/sha3.oo one-shot.
//
// Setup: Tree oodac emit-c. Calls sha3_256 / keccak256. FIPS 202 / Ethereum vectors.
//
// Beats:
//   1. sha3_256("") and sha3_256("abc") match FIPS 202.
//   2. keccak256("") matches the Ethereum empty digest.
//   3. Exit 1 before PASSED on a miss.

import "hash/sha3.oo";

pub fn main() {
    let empty: String = sha3_256("");
    if empty != "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a" {
        println("FAIL sha3_256 empty");
        process_exit(1);
    }
    let abc: String = sha3_256("abc");
    if abc != "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532" {
        println("FAIL sha3_256 abc");
        process_exit(1);
    }
    let kempty: String = keccak256("");
    if kempty != "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470" {
        println("FAIL keccak256 empty");
        process_exit(1);
    }
    println("org_std_sha3: PASSED");
}
