// # Vehicle Sideslip Angle (Beta) Observer
//
// Logline: Fuses kinematic acceleration integration and dynamic 2-DOF bicycle models to estimate vehicle sideslip angle beta.
//
// Setup: Nonlinear complementary observer providing drift-free vehicle sideslip angle estimates across all dynamic handling regimes.
//
// Beats:
//   1. Integrate kinematic sideslip derivative dot_beta_kin = ay/vx - r.
//   2. Evaluate model-based sideslip derivative dot_beta_dyn from dynamic cornering forces.
//   3. Blend kinematic and dynamic derivatives using velocity-adaptive complementary filtering.
//   4. Deliver filtered sideslip angle beta_hat and lateral velocity vy_hat.

pub type SideslipObserverState = struct {
    beta_hat_rad: Float,
    vy_hat_ms: Float
};

pub fn sideslip_observer_new() -> SideslipObserverState {
    return SideslipObserverState {
        beta_hat_rad: 0.0,
        vy_hat_ms: 0.0
    };
}

pub fn update_sideslip_observer(
    state: &SideslipObserverState,
    vx: Float,
    ay_measured: Float,
    yaw_rate_measured: Float,
    steer_rad: Float,
    dt: Float
) -> SideslipObserverState {
    let safe_vx: Float = if vx < 1.0 { 1.0 } else { vx };

    // Kinematic observer: dot_beta = (ay / vx) - r
    let dot_beta_kin: Float = (ay_measured / safe_vx) - yaw_rate_measured;

    // Linear dynamic model: Cf, Cr
    let cf: Float = 90000.0;
    let cr: Float = 100000.0;
    let m: Float = 1600.0;
    let lf: Float = 1.3;
    let lr: Float = 1.5;

    let dot_beta_dyn: Float = ((cf * (steer_rad - (state).beta_hat_rad - ((lf * yaw_rate_measured) / safe_vx)))
        + (cr * ((0.0 - (state).beta_hat_rad) + ((lr * yaw_rate_measured) / safe_vx)))) / (m * safe_vx)
        - yaw_rate_measured;

    // Complementary blend
    let weight_dyn: Float = 0.3;
    let blended_dot_beta: Float = ((1.0 - weight_dyn) * dot_beta_kin) + (weight_dyn * dot_beta_dyn);

    let next_beta: Float = (state).beta_hat_rad + (blended_dot_beta * dt);
    let next_vy: Float = next_beta * safe_vx;

    return SideslipObserverState {
        beta_hat_rad: next_beta,
        vy_hat_ms: next_vy
    };
}
