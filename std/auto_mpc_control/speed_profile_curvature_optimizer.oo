// # Curvature-Constrained Speed Profile Optimizer
//
// Logline: Generates optimal forward-backward velocity profiles along reference paths respecting lateral and longitudinal g-limits.
//
// Setup: Path speed profiling engine computing maximum entry speeds, braking points, and acceleration limits across road curves.
//
// Beats:
//   1. Compute maximum cornering speed v_lat_max = sqrt(a_lat_max / (|kappa| + eps)).
//   2. Perform backward integration pass enforcing vehicle braking deceleration limits.
//   3. Perform forward integration pass enforcing vehicle powertrain acceleration limits.
//   4. Deliver smooth, time-optimal, passenger-comfortable velocity profile.

pub type SpeedProfileConfig = struct {
    max_speed_ms: Float,
    max_lat_accel_ms2: Float,
    max_long_accel_ms2: Float,
    max_long_decel_ms2: Float
};

pub fn speed_profile_config_default() -> SpeedProfileConfig {
    return SpeedProfileConfig {
        max_speed_ms: 33.33, // 120 km/h
        max_lat_accel_ms2: 3.5,
        max_long_accel_ms2: 2.5,
        max_long_decel_ms2: 4.0
    };
}

pub fn compute_max_cornering_speed(
    curvature: Float,
    cfg: &SpeedProfileConfig
) -> Float {
    let abs_k: Float = if curvature < 0.0 { 0.0 - curvature } else { curvature };
    let safe_k: Float = if abs_k < 0.0001 { 0.0001 } else { abs_k };

    let v_curve: Float = sqrt((cfg).max_lat_accel_ms2 / safe_k);
    let v_opt: Float = if v_curve > (cfg).max_speed_ms { (cfg).max_speed_ms } else { v_curve };
    return v_opt;
}

pub fn speed_profile_step(
    v_curr: Float,
    target_curvature: Float,
    segment_length_m: Float,
    cfg: &SpeedProfileConfig
) -> Float {
    let v_corner_limit: Float = compute_max_cornering_speed(target_curvature, cfg);
    let v_accel_limit: Float = sqrt((v_curr * v_curr) + (2.0 * (cfg).max_long_accel_ms2 * segment_length_m));

    let v_cand: Float = if v_corner_limit < v_accel_limit { v_corner_limit } else { v_accel_limit };
    return if v_cand > (cfg).max_speed_ms { (cfg).max_speed_ms } else { v_cand };
}
