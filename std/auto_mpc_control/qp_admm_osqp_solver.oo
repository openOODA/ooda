// # ADMM Operator-Splitting QP Solver (OSQP Paradigm)
//
// Logline: Executes Alternating Direction Method of Multipliers (ADMM) operator splitting for rapid constrained MPC optimization.
//
// Setup: Fast, first-order convex QP solver decoupling quadratic objectives from polyhedral state and input constraint projections.
//
// Beats:
//   1. Formulate ADMM splitting with primal variable x, slack variable z, and dual multipliers y.
//   2. Solve linear primal subproblem with fixed augmented penalty rho and regularization sigma.
//   3. Project auxiliary slack vector z onto box and half-space constraints.
//   4. Update dual multipliers y and evaluate primal/dual residual convergence tolerances.

pub type ADMMQPConfig = struct {
    rho: Float,
    sigma: Float,
    alpha_relax: Float,
    max_iter: Int,
    eps_abs: Float,
};

pub type ADMMOutput = struct {
    x1: Float,
    x2: Float,
    primal_res: Float,
    dual_res: Float,
    iterations: Int,
};

pub fn admm_config_default() -> ADMMQPConfig {
    return ADMMQPConfig {
        rho: 1.0,
        sigma: 0.000001,
        alpha_relax: 1.6,
        max_iter: 50,
        eps_abs: 0.0001,
    };
}

pub fn admm_osqp_solve_2d(
    q1: Float, q2: Float,
    l1: Float, u1: Float,
    l2: Float, u2: Float,
    cfg: &ADMMQPConfig
) -> ADMMOutput {
    let mut x1: Float = 0.0;
    let mut x2: Float = 0.0;
    let mut z1: Float = 0.0;
    let mut z2: Float = 0.0;
    let mut y1: Float = 0.0;
    let mut y2: Float = 0.0;

    let rho: Float = (cfg).rho;
    let alpha: Float = (cfg).alpha_relax;
    let mut iter: Int = 0;
    let mut prim_res: Float = 1.0;
    let mut dual_res: Float = 1.0;

    while (iter < (cfg).max_iter) && (prim_res > (cfg).eps_abs) {
        iter = iter + 1;
        let z1_prev: Float = z1;
        let z2_prev: Float = z2;

        // Primal solve: min 0.5*q*x^2 + (rho/2)*(x - z + y/rho)^2
        x1 = (0.0 - q1 + (rho * z1) - y1) / (1.0 + rho);
        x2 = (0.0 - q2 + (rho * z2) - y2) / (1.0 + rho);

        // Relaxation
        let x1_hat: Float = (alpha * x1) + ((1.0 - alpha) * z1_prev);
        let x2_hat: Float = (alpha * x2) + ((1.0 - alpha) * z2_prev);

        // Slack projection
        let cand_z1: Float = x1_hat + (y1 / rho);
        let cand_z2: Float = x2_hat + (y2 / rho);

        z1 = if cand_z1 < l1 { l1 } else { if cand_z1 > u1 { u1 } else { cand_z1 } };
        z2 = if cand_z2 < l2 { l2 } else { if cand_z2 > u2 { u2 } else { cand_z2 } };

        // Dual update
        y1 = y1 + (rho * (x1_hat - z1));
        y2 = y2 + (rho * (x2_hat - z2));

        let r1: Float = x1 - z1;
        let r2: Float = x2 - z2;
        prim_res = sqrt((r1 * r1) + (r2 * r2));

        let s1: Float = rho * (z1 - z1_prev);
        let s2: Float = rho * (z2 - z2_prev);
        dual_res = sqrt((s1 * s1) + (s2 * s2));
    }

    return ADMMOutput {
        x1: z1,
        x2: z2,
        primal_res: prim_res,
        dual_res: dual_res,
        iterations: iter,
    };
}
