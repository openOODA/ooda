// # Adaptive Lookahead Pure Pursuit Path Tracker
//
// Logline: Generates geometric steering commands targeting an adaptive preview point on the reference trajectory.
//
// Setup: Classic geometric path tracker scaling lookahead distance with vehicle speed to balance cornering agility and high-speed stability.
//
// Beats:
//   1. Calculate dynamic lookahead distance L_d = max(L_d_min, k_look * v_x).
//   2. Identify target lookahead point (x_tgt, y_tgt) on reference trajectory.
//   3. Compute lookahead azimuth angle alpha relative to vehicle heading.
//   4. Calculate steering angle delta = atan(2 * L * sin(alpha) / L_d).

pub type PurePursuitConfig = struct {
    k_lookahead: Float,
    min_lookahead_m: Float,
    max_lookahead_m: Float,
    wheelbase_m: Float,
    max_steer_rad: Float,
};

pub type PurePursuitOutput = struct {
    steer_cmd_rad: Float,
    lookahead_dist_m: Float,
    target_alpha_rad: Float,
};

pub fn pure_pursuit_config_default() -> PurePursuitConfig {
    return PurePursuitConfig {
        k_lookahead: 0.6,
        min_lookahead_m: 3.0,
        max_lookahead_m: 25.0,
        wheelbase_m: 2.8,
        max_steer_rad: 0.6,
    };
}

pub fn pure_pursuit_control_step(
    veh_x: Float,
    veh_y: Float,
    veh_yaw: Float,
    veh_v: Float,
    target_x: Float,
    target_y: Float,
    cfg: &PurePursuitConfig
) -> PurePursuitOutput {
    let raw_ld: Float = (cfg).k_lookahead * veh_v;
    let ld: Float = if raw_ld < (cfg).min_lookahead_m {
        (cfg).min_lookahead_m
    } else {
        if raw_ld > (cfg).max_lookahead_m { (cfg).max_lookahead_m } else { raw_ld }
    };

    let dx: Float = target_x - veh_x;
    let dy: Float = target_y - veh_y;
    let c_yaw: Float = cos(veh_yaw);
    let s_yaw: Float = sin(veh_yaw);

    // Target in vehicle body frame
    let target_body_x: Float = (dx * c_yaw) + (dy * s_yaw);
    let target_body_y: Float = ((0.0 - dx) * s_yaw) + (dy * c_yaw);

    let alpha: Float = if target_body_x > 0.001 {
        target_body_y / target_body_x
    } else {
        0.0
    };

    let curvature: Float = (2.0 * target_body_y) / (ld * ld);
    let raw_steer: Float = (cfg).wheelbase_m * curvature;

    let clamped_steer: Float = if raw_steer < (0.0 - (cfg).max_steer_rad) {
        0.0 - (cfg).max_steer_rad
    } else {
        if raw_steer > (cfg).max_steer_rad { (cfg).max_steer_rad } else { raw_steer }
    };

    return PurePursuitOutput {
        steer_cmd_rad: clamped_steer,
        lookahead_dist_m: ld,
        target_alpha_rad: alpha,
    };
}
