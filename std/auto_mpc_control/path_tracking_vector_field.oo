// # Vector Field Guidance (VFG) Path Follower
//
// Logline: Constructs smooth 2D velocity vector fields directing the vehicle asymptotically onto the reference path curve.
//
// Setup: Singularity-free path guidance law generating desired course angle fields chi_d(d) as a function of cross-track deviation d.
//
// Beats:
//   1. Define asymptotic approach angle chi_inf and convergence rate parameter k_vfg.
//   2. Compute desired course angle chi_d(d) = psi_path - chi_inf * (2/pi) * atan(k_vfg * d).
//   3. Compute course angle error chi_tilde = psi_veh - chi_d.
//   4. Command yaw rate dot_psi = -k_chi * chi_tilde + dot_chi_d for smooth trajectory convergence.

pub type VFGConfig = struct {
    chi_inf_rad: Float,
    k_vfg: Float,
    k_yaw_rate: Float,
    max_yaw_rate: Float
};

pub type VFGOutput = struct {
    desired_course_rad: Float,
    yaw_rate_cmd: Float
};

pub fn vfg_config_default() -> VFGConfig {
    return VFGConfig {
        chi_inf_rad: 0.8, // ~45 deg max intercept angle
        k_vfg: 0.4,
        k_yaw_rate: 1.5,
        max_yaw_rate: 0.5
    };
}

pub fn vfg_guidance_step(
    cross_track_d: Float,
    path_yaw: Float,
    veh_yaw: Float,
    cfg: &VFGConfig
) -> VFGOutput {
    let arg: Float = (cfg).k_vfg * cross_track_d;
    let atan_arg: Float = arg * (1.0 - (0.33333333 * arg * arg));
    let two_over_pi: Float = 0.63661977;

    let chi_desired: Float = path_yaw - ((cfg).chi_inf_rad * two_over_pi * atan_arg);
    let error_course: Float = veh_yaw - chi_desired;

    let yaw_rate_raw: Float = (0.0 - (cfg).k_yaw_rate) * error_course;
    let yaw_rate: Float = if yaw_rate_raw < (0.0 - (cfg).max_yaw_rate) {
        0.0 - (cfg).max_yaw_rate
    } else {
        if yaw_rate_raw > (cfg).max_yaw_rate { (cfg).max_yaw_rate } else { yaw_rate_raw }
    };

    return VFGOutput {
        desired_course_rad: chi_desired,
        yaw_rate_cmd: yaw_rate
    };
}
