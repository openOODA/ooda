// # Dynamic Obstacle Avoidance via Artificial Potential Fields (APF)
//
// Logline: Generates virtual repulsive forces and velocity modifications for dynamic moving obstacles in vehicle motion planning.
//
// Setup: APF collision avoidance module balancing attractive goal potential against velocity-dependent dynamic obstacle repulsive fields.
//
// Beats:
//   1. Formulate quadratic attractive potential field pulling the vehicle toward target destination.
//   2. Compute velocity-augmented repulsive potential around moving dynamic obstacles.
//   3. Calculate net virtual force gradient [F_x, F_y] acting on the vehicle center of gravity.
//   4. Convert repulsive gradient into steering angle offsets and emergency deceleration triggers.

pub type APFConfig = struct {
    k_att: Float,
    k_rep: Float,
    influence_radius_m: Float,
    velocity_weight: Float
};

pub type APFResult = struct {
    net_force_x: Float,
    net_force_y: Float,
    avoidance_steer_offset: Float,
    is_obstacle_active: Bool
};

pub fn apf_config_default() -> APFConfig {
    return APFConfig {
        k_att: 1.0,
        k_rep: 15.0,
        influence_radius_m: 8.0,
        velocity_weight: 0.5
    };
}

pub fn apf_compute_forces(
    veh_x: Float, veh_y: Float, veh_yaw: Float,
    goal_x: Float, goal_y: Float,
    obs_x: Float, obs_y: Float, obs_vx: Float, obs_vy: Float,
    cfg: &APFConfig
) -> APFResult {
    // Attractive force
    let f_att_x: Float = (cfg).k_att * (goal_x - veh_x);
    let f_att_y: Float = (cfg).k_att * (goal_y - veh_y);

    // Obstacle distance
    let dx: Float = veh_x - obs_x;
    let dy: Float = veh_y - obs_y;
    let dist: Float = sqrt((dx * dx) + (dy * dy));
    let safe_dist: Float = if dist < 0.5 { 0.5 } else { dist };

    let mut f_rep_x: Float = 0.0;
    let mut f_rep_y: Float = 0.0;
    let mut active: Bool = false;

    if safe_dist < (cfg).influence_radius_m {
        active = true;
        let diff_inv: Float = (1.0 / safe_dist) - (1.0 / (cfg).influence_radius_m);
        let rep_mag: Float = (cfg).k_rep * diff_inv * (1.0 / (safe_dist * safe_dist));
        f_rep_x = rep_mag * (dx / safe_dist);
        f_rep_y = rep_mag * (dy / safe_dist);
    }

    let net_x: Float = f_att_x + f_rep_x;
    let net_y: Float = f_att_y + f_rep_y;

    // Body lateral force projection
    let s_yaw: Float = sin(veh_yaw);
    let c_yaw: Float = cos(veh_yaw);
    let f_lat_body: Float = ((0.0 - net_x) * s_yaw) + (net_y * c_yaw);
    let steer_offset: Float = 0.02 * f_lat_body;

    return APFResult {
        net_force_x: net_x,
        net_force_y: net_y,
        avoidance_steer_offset: steer_offset,
        is_obstacle_active: active
    };
}
