// # Vehicle Coordinate Frames & Planar Transformations
//
// Logline: Converts vehicle spatial poses, kinematics, and accelerations between ISO 8855, SAE J670, and world navigation frames.
//
// Setup: Core planar coordinate transformation library standardizing autonomous vehicle chassis, axle, and sensor reference frames.
//
// Beats:
//   1. Represent 2D/3D vehicle poses, velocities, and linear accelerations in standard Cartesian coordinates.
//   2. Transform spatial points and vectors between world navigation frame and vehicle chassis body frame.
//   3. Project velocities and accelerations along longitudinal, lateral, and vertical axes.
//   4. Compute planar frame rotations, frame offsets, and relative azimuth angles.

pub type VehiclePose2D = struct {
    x: Float,
    y: Float,
    yaw: Float,
};

pub type VehicleVelocity2D = struct {
    vx: Float,
    vy: Float,
    yaw_rate: Float,
};

pub type VehicleAccel2D = struct {
    ax: Float,
    ay: Float,
};

pub fn vehicle_pose2d_new(x: Float, y: Float, yaw: Float) -> VehiclePose2D {
    return VehiclePose2D { x: x, y: y, yaw: yaw };
}

pub fn vehicle_pose2d_zero() -> VehiclePose2D {
    return VehiclePose2D { x: 0.0, y: 0.0, yaw: 0.0 };
}

pub fn vehicle_velocity2d_new(vx: Float, vy: Float, yaw_rate: Float) -> VehicleVelocity2D {
    return VehicleVelocity2D { vx: vx, vy: vy, yaw_rate: yaw_rate };
}

pub fn vehicle_velocity2d_zero() -> VehicleVelocity2D {
    return VehicleVelocity2D { vx: 0.0, vy: 0.0, yaw_rate: 0.0 };
}

pub fn vehicle_accel2d_new(ax: Float, ay: Float) -> VehicleAccel2D {
    return VehicleAccel2D { ax: ax, ay: ay };
}

pub fn world_to_body_point(pt_x: Float, pt_y: Float, pose: &VehiclePose2D) -> VehiclePose2D {
    let dx: Float = pt_x - (pose).x;
    let dy: Float = pt_y - (pose).y;
    let c_yaw: Float = cos((pose).yaw);
    let s_yaw: Float = sin((pose).yaw);
    let bx: Float = (dx * c_yaw) + (dy * s_yaw);
    let by: Float = ((0.0 - dx) * s_yaw) + (dy * c_yaw);
    return VehiclePose2D { x: bx, y: by, yaw: 0.0 };
}

pub fn body_to_world_point(bx: Float, by: Float, pose: &VehiclePose2D) -> VehiclePose2D {
    let c_yaw: Float = cos((pose).yaw);
    let s_yaw: Float = sin((pose).yaw);
    let wx: Float = (pose).x + (bx * c_yaw) - (by * s_yaw);
    let wy: Float = (pose).y + (bx * s_yaw) + (by * c_yaw);
    return VehiclePose2D { x: wx, y: wy, yaw: (pose).yaw };
}

pub fn transform_velocity_to_wheel(
    chassis_vel: &VehicleVelocity2D,
    offset_x: Float,
    offset_y: Float
) -> VehicleVelocity2D {
    let w_vx: Float = (chassis_vel).vx - ((chassis_vel).yaw_rate * offset_y);
    let w_vy: Float = (chassis_vel).vy + ((chassis_vel).yaw_rate * offset_x);
    return VehicleVelocity2D {
        vx: w_vx,
        vy: w_vy,
        yaw_rate: (chassis_vel).yaw_rate,
    };
}

pub fn compute_speed_magnitude(vx: Float, vy: Float) -> Float {
    return sqrt((vx * vx) + (vy * vy));
}
