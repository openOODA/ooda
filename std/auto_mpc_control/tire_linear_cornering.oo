// # Linear Tire Cornering Stiffness & Slip Model
//
// Logline: Provides linearized tire lateral force models with normal load scaling and smooth saturation clamping for linear MPC.
//
// Setup: Computationally lightweight linear cornering force approximation suited for real-time QP solvers and LQR tracking.
//
// Beats:
//   1. Define front and rear cornering stiffness parameters Cf and Cr.
//   2. Scale cornering stiffness proportionally to dynamic vertical normal load Fz.
//   3. Compute linear lateral forces Fy = -C * alpha with linear slip angle thresholds.
//   4. Enforce smooth saturation clamping at maximum friction limit mu * Fz.

pub type LinearTireParams = struct {
    nominal_stiff: Float,
    nominal_fz: Float,
    friction_mu: Float,
    max_linear_slip_rad: Float,
};

pub fn linear_tire_params_default() -> LinearTireParams {
    return LinearTireParams {
        nominal_stiff: 85000.0,
        nominal_fz: 4000.0,
        friction_mu: 0.9,
        max_linear_slip_rad: 0.08,
    };
}

pub fn compute_effective_stiffness(fz: Float, p: &LinearTireParams) -> Float {
    let safe_fz: Float = if fz < 10.0 { 10.0 } else { fz };
    let fz_ratio: Float = safe_fz / (p).nominal_fz;
    // De-rating stiffness slightly under extreme normal load
    return (p).nominal_stiff * (fz_ratio * (1.2 - (0.2 * fz_ratio)));
}

pub fn compute_linear_lateral_force(
    alpha_rad: Float,
    fz: Float,
    p: &LinearTireParams
) -> Float {
    let c_eff: Float = compute_effective_stiffness(fz, p);
    let fy_raw: Float = (0.0 - c_eff) * alpha_rad;
    let max_force: Float = (p).friction_mu * fz;

    if fy_raw > max_force {
        return max_force;
    }
    if fy_raw < (0.0 - max_force) {
        return 0.0 - max_force;
    }
    return fy_raw;
}
