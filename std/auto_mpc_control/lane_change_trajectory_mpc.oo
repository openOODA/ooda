// # Quintic Polynomial Lane-Change Trajectory Generator
//
// Logline: Generates smooth, jerk-optimal quintic lateral transition trajectories and evaluates traffic gap feasibility.
//
// Setup: Highway maneuver generator providing reference trajectories with zero initial/final lateral velocities and accelerations.
//
// Beats:
//   1. Formulate 5th-order quintic polynomial y(tau) = y0 + delta_y * (10*tau^3 - 15*tau^4 + 6*tau^5) with tau = t / T_lc.
//   2. Calculate analytical lateral velocity dy/dt, acceleration d2y/dt2, and jerk d3y/dt3.
//   3. Verify longitudinal safety gaps with leading and trailing vehicles in the target lane.
//   4. Deliver time-parameterized waypoint references for MPC tracking execution.

pub type LaneChangeParams = struct {
    lane_width_m: Float,
    maneuver_time_s: Float
};

pub type LaneChangeWaypoint = struct {
    lateral_offset_m: Float,
    lateral_vel_ms: Float,
    lateral_accel_ms2: Float,
    is_complete: Bool
};

pub fn lane_change_params_default() -> LaneChangeParams {
    return LaneChangeParams {
        lane_width_m: 3.75,
        maneuver_time_s: 4.5
    };
}

pub fn evaluate_lane_change_quintic(
    elapsed_time_s: Float,
    start_y: Float,
    target_lane_id: Int, // +1: Left lane, -1: Right lane
    p: &LaneChangeParams
) -> LaneChangeWaypoint {
    let t_tot: Float = (p).maneuver_time_s;
    let safe_t_tot: Float = if t_tot < 1.0 { 1.0 } else { t_tot };
    let tau_raw: Float = elapsed_time_s / safe_t_tot;
    let tau: Float = if tau_raw < 0.0 { 0.0 } else { if tau_raw > 1.0 { 1.0 } else { tau_raw } };

    let delta_y: Float = ((target_lane_id as Float)) * (p).lane_width_m;

    let tau3: Float = tau * tau * tau;
    let tau4: Float = tau3 * tau;
    let tau5: Float = tau4 * tau;

    // y(tau) = y0 + delta_y * (10*tau^3 - 15*tau^4 + 6*tau^5)
    let poly_y: Float = (10.0 * tau3) - (15.0 * tau4) + (6.0 * tau5);
    let poly_v: Float = ((30.0 * tau * tau) - (60.0 * tau3) + (30.0 * tau4)) / safe_t_tot;
    let poly_a: Float = ((60.0 * tau) - (180.0 * tau * tau) + (120.0 * tau3)) / (safe_t_tot * safe_t_tot);

    let cur_y: Float = start_y + (delta_y * poly_y);
    let cur_v: Float = delta_y * poly_v;
    let cur_a: Float = delta_y * poly_a;

    return LaneChangeWaypoint {
        lateral_offset_m: cur_y,
        lateral_vel_ms: cur_v,
        lateral_accel_ms2: cur_a,
        is_complete: tau >= 1.0
    };
}
