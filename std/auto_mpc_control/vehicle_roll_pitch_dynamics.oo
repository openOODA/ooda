// # Vehicle Roll & Pitch Dynamics & Load Transfer
//
// Logline: Calculates dynamic 4-wheel normal load transfers, suspension roll angles, and pitch moments during acceleration and cornering.
//
// Setup: Suspension load transfer estimator predicting dynamic tire normal loads (Fz_fl, Fz_fr, Fz_rl, Fz_rr) for non-linear tire grip limits.
//
// Beats:
//   1. Determine static weight distribution between front and rear axles.
//   2. Calculate longitudinal load transfer during acceleration and braking.
//   3. Compute roll angle and roll-induced lateral load transfer across front and rear anti-roll stiffnesses.
//   4. Deliver dynamic 4-wheel normal forces enforcing non-negative ground contact constraints.

pub type SuspensionParams = struct {
    mass: Float,
    cg_height: Float,
    wheelbase: Float,
    dist_front: Float,
    dist_rear: Float,
    track_front: Float,
    track_rear: Float,
    roll_stiff_f: Float,
    roll_stiff_r: Float,
};

pub type FourWheelNormalLoads = struct {
    fz_fl: Float,
    fz_fr: Float,
    fz_rl: Float,
    fz_rr: Float,
};

pub fn suspension_params_default() -> SuspensionParams {
    return SuspensionParams {
        mass: 1650.0,
        cg_height: 0.52,
        wheelbase: 2.8,
        dist_front: 1.28,
        dist_rear: 1.52,
        track_front: 1.62,
        track_rear: 1.62,
        roll_stiff_f: 55000.0,
        roll_stiff_r: 45000.0,
    };
}

pub fn compute_dynamic_normal_loads(
    ax: Float,
    ay: Float,
    p: &SuspensionParams
) -> FourWheelNormalLoads {
    let g: Float = 9.80665;
    let total_w: Float = (p).mass * g;
    let l_tot: Float = (p).wheelbase;

    let fz_f_static: Float = total_w * ((p).dist_rear / l_tot);
    let fz_r_static: Float = total_w * ((p).dist_front / l_tot);

    let delta_fz_long: Float = ((p).mass * ax * (p).cg_height) / l_tot;
    let fz_f_long: Float = fz_f_static - delta_fz_long;
    let fz_r_long: Float = fz_r_static + delta_fz_long;

    let total_roll_stiff: Float = (p).roll_stiff_f + (p).roll_stiff_r;
    let roll_dist_f: Float = (p).roll_stiff_f / total_roll_stiff;
    let roll_dist_r: Float = (p).roll_stiff_r / total_roll_stiff;

    let delta_fz_lat_f: Float = (((p).mass * ay * (p).cg_height) / (p).track_front) * roll_dist_f;
    let delta_fz_lat_r: Float = (((p).mass * ay * (p).cg_height) / (p).track_rear) * roll_dist_r;

    let raw_fl: Float = (0.5 * fz_f_long) - delta_fz_lat_f;
    let raw_fr: Float = (0.5 * fz_f_long) + delta_fz_lat_f;
    let raw_rl: Float = (0.5 * fz_r_long) - delta_fz_lat_r;
    let raw_rr: Float = (0.5 * fz_r_long) + delta_fz_lat_r;

    let fz_fl: Float = if raw_fl < 0.0 { 0.0 } else { raw_fl };
    let fz_fr: Float = if raw_fr < 0.0 { 0.0 } else { raw_fr };
    let fz_rl: Float = if raw_rl < 0.0 { 0.0 } else { raw_rl };
    let fz_rr: Float = if raw_rr < 0.0 { 0.0 } else { raw_rr };

    return FourWheelNormalLoads {
        fz_fl: fz_fl,
        fz_fr: fz_fr,
        fz_rl: fz_rl,
        fz_rr: fz_rr,
    };
}
