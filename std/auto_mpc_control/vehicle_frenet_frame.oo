// # Curvilinear Frenet-Serret Road Frame Transformations
//
// Logline: Converts vehicle Cartesian poses into path-relative Frenet coordinates (s, d, e_psi) and computes differential path kinematics.
//
// Setup: Coordinate transformation system standardizing cross-track error, longitudinal station s, heading error, and road curvature.
//
// Beats:
//   1. Project Cartesian point (x, y) onto reference path curve to obtain arc length s and lateral deviation d.
//   2. Compute path-relative heading error e_psi and instantaneous road curvature kappa.
//   3. Compute path-relative state derivatives ds/dt and dd/dt accounting for curvature singularity correction.
//   4. Convert Frenet coordinate states back into global Cartesian coordinates.

pub type FrenetState = struct {
    s: Float,
    d: Float,
    e_psi: Float,
    s_dot: Float,
    d_dot: Float,
    curvature: Float,
};

pub type CartesianState = struct {
    x: Float,
    y: Float,
    yaw: Float,
    v: Float,
};

pub type PathWaypoint = struct {
    x: Float,
    y: Float,
    yaw: Float,
    s: Float,
    curvature: Float,
};

pub fn cartesian_to_frenet(
    veh: &CartesianState,
    wpt: &PathWaypoint
) -> FrenetState {
    let dx: Float = (veh).x - (wpt).x;
    let dy: Float = (veh).y - (wpt).y;
    let c_yaw: Float = cos((wpt).yaw);
    let s_yaw: Float = sin((wpt).yaw);

    let d: Float = ((0.0 - dx) * s_yaw) + (dy * c_yaw);
    let e_psi: Float = (veh).yaw - (wpt).yaw;

    let kappa: Float = (wpt).curvature;
    let factor: Float = 1.0 - (kappa * d);
    let safe_factor: Float = if factor < 0.1 { 0.1 } else { factor };

    let s_dot: Float = ((veh).v * cos(e_psi)) / safe_factor;
    let d_dot: Float = (veh).v * sin(e_psi);

    return FrenetState {
        s: (wpt).s,
        d: d,
        e_psi: e_psi,
        s_dot: s_dot,
        d_dot: d_dot,
        curvature: kappa,
    };
}

pub fn frenet_to_cartesian(
    frenet: &FrenetState,
    wpt: &PathWaypoint
) -> CartesianState {
    let s_yaw: Float = sin((wpt).yaw);
    let c_yaw: Float = cos((wpt).yaw);

    let x: Float = (wpt).x - ((frenet).d * s_yaw);
    let y: Float = (wpt).y + ((frenet).d * c_yaw);
    let yaw: Float = (wpt).yaw + (frenet).e_psi;

    let kappa: Float = (wpt).curvature;
    let factor: Float = 1.0 - (kappa * (frenet).d);
    let v_s: Float = (frenet).s_dot * factor;
    let v_d: Float = (frenet).d_dot;
    let v: Float = sqrt((v_s * v_s) + (v_d * v_d));

    return CartesianState {
        x: x,
        y: y,
        yaw: yaw,
        v: v,
    };
}

pub fn vehicle_frenet_frame_probe() -> Int {
    return 0;
}
