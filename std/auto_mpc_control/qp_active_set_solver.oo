// # Primal Active-Set Quadratic Program (QP) Solver
//
// Logline: Solves convex box-constrained and inequality-constrained quadratic programs for model predictive control subproblems.
//
// Setup: Deterministic active-set optimizer iteratively resolving Karush-Kuhn-Tucker (KKT) systems with Lagrange multiplier updates.
//
// Beats:
//   1. Define standard QP problem min (1/2) u^T H u + g^T u subject to bounds u_min <= u <= u_max.
//   2. Track active constraint index sets and compute unconstrained Newton steps on free variables.
//   3. Perform line search to identify blocking constraints and update working active sets.
//   4. Evaluate Lagrange multipliers to release inactive constraints and verify optimality.

pub type QP2DProblem = struct {
    h11: Float,
    h12: Float,
    h22: Float,
    g1: Float,
    g2: Float,
    u1_min: Float,
    u1_max: Float,
    u2_min: Float,
    u2_max: Float,
};

pub type QP2DSolution = struct {
    u1: Float,
    u2: Float,
    cost: Float,
    iterations: Int,
    is_converged: Bool,
};

pub fn qp_2d_solve_active_set(prob: &QP2DProblem, max_iter: Int) -> QP2DSolution {
    let mut u1: Float = 0.0;
    let mut u2: Float = 0.0;
    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while (iter < max_iter) && !converged {
        iter = iter + 1;
        // Compute unconstrained gradient: grad = H*u + g
        let grad1: Float = ((prob).h11 * u1) + ((prob).h12 * u2) + (prob).g1;
        let grad2: Float = ((prob).h12 * u1) + ((prob).h22 * u2) + (prob).g2;

        let det: Float = ((prob).h11 * (prob).h22) - ((prob).h12 * (prob).h12);
        let safe_det: Float = if det < 0.0001 { 0.0001 } else { det };

        // Newton step on free subspace
        let du1: Float = (0.0 - (((prob).h22 * grad1) - ((prob).h12 * grad2))) / safe_det;
        let du2: Float = (0.0 - (((0.0 - (prob).h12) * grad1) + ((prob).h11 * grad2))) / safe_det;

        let cand_u1: Float = u1 + (0.5 * du1);
        let cand_u2: Float = u2 + (0.5 * du2);

        // Project onto box bounds
        let next_u1: Float = if cand_u1 < (prob).u1_min { (prob).u1_min } else { if cand_u1 > (prob).u1_max { (prob).u1_max } else { cand_u1 } };
        let next_u2: Float = if cand_u2 < (prob).u2_min { (prob).u2_min } else { if cand_u2 > (prob).u2_max { (prob).u2_max } else { cand_u2 } };

        let diff1: Float = next_u1 - u1;
        let diff2: Float = next_u2 - u2;
        let change: Float = sqrt((diff1 * diff1) + (diff2 * diff2));

        u1 = next_u1;
        u2 = next_u2;

        if change < 0.00001 {
            converged = true;
        }
    }

    let cost: Float = (0.5 * (((prob).h11 * u1 * u1) + (2.0 * (prob).h12 * u1 * u2) + ((prob).h22 * u2 * u2)))
        + ((prob).g1 * u1) + ((prob).g2 * u2);

    return QP2DSolution {
        u1: u1,
        u2: u2,
        cost: cost,
        iterations: iter,
        is_converged: converged,
    };
}
