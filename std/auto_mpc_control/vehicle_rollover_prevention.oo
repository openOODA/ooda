// # Dynamic Rollover Index (RI) Monitor & Prevention Controller
//
// Logline: Calculates real-time lateral load transfer Rollover Index (RI) and commands active differential braking to prevent vehicle rollover.
//
// Setup: Active rollover protection module intervening via outside front wheel braking and steering angle reduction.
//
// Beats:
//   1. Compute normalized Rollover Index RI = 2*|Fz_left - Fz_right| / Fz_tot ~ 2*h_cg*a_y / (g*W).
//   2. Compare RI against warning threshold (0.60) and critical intervention threshold (0.80).
//   3. Command differential braking moment on outside wheels to induce stabilizing yaw and roll reduction.
//   4. Apply override counter-steering intervention when approaching wheel lift-off conditions.

pub type RolloverConfig = struct {
    cg_height_m: Float,
    track_width_m: Float,
    warning_threshold: Float,
    intervention_threshold: Float,
};

pub type RolloverIntervention = struct {
    rollover_index: Float,
    is_rollover_threat: Bool,
    corrective_steer_cut_pct: Float,
    outside_brake_force_n: Float,
};

pub fn rollover_config_default() -> RolloverConfig {
    return RolloverConfig {
        cg_height_m: 0.55,
        track_width_m: 1.62,
        warning_threshold: 0.60,
        intervention_threshold: 0.80,
    };
}

pub fn evaluate_rollover_risk(
    lateral_accel_ay: Float,
    cfg: &RolloverConfig
) -> RolloverIntervention {
    let g: Float = 9.80665;
    let abs_ay: Float = if lateral_accel_ay < 0.0 { 0.0 - lateral_accel_ay } else { lateral_accel_ay };

    let ri: Float = (2.0 * (cfg).cg_height_m * abs_ay) / (g * (cfg).track_width_m);

    if ri < (cfg).warning_threshold {
        return RolloverIntervention {
            rollover_index: ri,
            is_rollover_threat: false,
            corrective_steer_cut_pct: 0.0,
            outside_brake_force_n: 0.0,
        };
    }

    // Rollover threat detected: compute intervention
    let severity: Float = (ri - (cfg).warning_threshold) / (1.0 - (cfg).warning_threshold);
    let steer_cut: Float = severity * 50.0; // Cut steering up to 50%
    let brake_force: Float = severity * 3500.0; // Apply outside braking

    return RolloverIntervention {
        rollover_index: ri,
        is_rollover_threat: true,
        corrective_steer_cut_pct: steer_cut,
        outside_brake_force_n: brake_force,
    };
}
