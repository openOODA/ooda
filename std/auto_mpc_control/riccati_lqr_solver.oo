// # Discrete-Time Algebraic Riccati Equation (DARE) & LQR Solver
//
// Logline: Solves the steady-state Discrete Algebraic Riccati Equation and computes infinite-horizon optimal state feedback gain matrix K.
//
// Setup: Riccati equation iteration engine delivering optimal Linear Quadratic Regulator (LQR) control policies for vehicle tracking error systems.
//
// Beats:
//   1. Formulate discrete-time linear system x_{k+1} = A*x_k + B*u_k with state weight Q and control weight R.
//   2. Iterate the Riccati recurrence P_{k+1} = Q + A^T P_k A - A^T P_k B (R + B^T P_k B)^{-1} B^T P_k A until convergence.
//   3. Compute the optimal steady-state state-feedback gain matrix K = (R + B^T P B)^{-1} B^T P A.
//   4. Calculate closed-loop eigenvalues and minimum infinite-horizon tracking cost J* = x0^T P x0.

pub type LQR2DProblem = struct {
    a11: Float,
    a12: Float,
    a21: Float,
    a22: Float,
    b1: Float,
    b2: Float,
    q11: Float,
    q22: Float,
    r_weight: Float
};

pub type LQR2DSolution = struct {
    k1: Float,
    k2: Float,
    p11: Float,
    p12: Float,
    p22: Float,
    converged: Bool
};

pub fn dare_lqr_solve_2d(prob: &LQR2DProblem, max_iter: Int) -> LQR2DSolution {
    let mut p11: Float = (prob).q11;
    let mut p12: Float = 0.0;
    let mut p22: Float = (prob).q22;

    let mut iter: Int = 0;
    let mut is_conv: Bool = false;

    while (iter < max_iter) && !is_conv {
        iter = iter + 1;
        // B^T * P
        let btp1: Float = ((prob).b1 * p11) + ((prob).b2 * p12);
        let btp2: Float = ((prob).b1 * p12) + ((prob).b2 * p22);

        // B^T * P * B + R
        let btp_b_r: Float = (btp1 * (prob).b1) + (btp2 * (prob).b2) + (prob).r_weight;
        let safe_denom: Float = if btp_b_r < 0.0001 { 0.0001 } else { btp_b_r };

        // B^T * P * A
        let btpa1: Float = (btp1 * (prob).a11) + (btp2 * (prob).a21);
        let btpa2: Float = (btp1 * (prob).a12) + (btp2 * (prob).a22);

        // A^T * P * A
        let pa11: Float = (p11 * (prob).a11) + (p12 * (prob).a21);
        let pa12: Float = (p11 * (prob).a12) + (p12 * (prob).a22);
        let pa21: Float = (p12 * (prob).a11) + (p22 * (prob).a21);
        let pa22: Float = (p12 * (prob).a12) + (p22 * (prob).a22);

        let at_pa11: Float = ((prob).a11 * pa11) + ((prob).a21 * pa21);
        let at_pa12: Float = ((prob).a11 * pa12) + ((prob).a21 * pa22);
        let at_pa22: Float = ((prob).a12 * pa12) + ((prob).a22 * pa22);

        // P_next = Q + A^T*P*A - (A^T*P*B)*(B^T*P*B + R)^-1*(B^T*P*A)
        let next_p11: Float = (prob).q11 + at_pa11 - ((btpa1 * btpa1) / safe_denom);
        let next_p12: Float = at_pa12 - ((btpa1 * btpa2) / safe_denom);
        let next_p22: Float = (prob).q22 + at_pa22 - ((btpa2 * btpa2) / safe_denom);

        let diff: Float = sqrt(((next_p11 - p11) * (next_p11 - p11)) + ((next_p22 - p22) * (next_p22 - p22)));
        p11 = next_p11;
        p12 = next_p12;
        p22 = next_p22;

        if diff < 0.0001 {
            is_conv = true;
        }
    }

    let btp1: Float = ((prob).b1 * p11) + ((prob).b2 * p12);
    let btp2: Float = ((prob).b1 * p12) + ((prob).b2 * p22);
    let btp_b_r: Float = (btp1 * (prob).b1) + (btp2 * (prob).b2) + (prob).r_weight;
    let safe_denom: Float = if btp_b_r < 0.0001 { 0.0001 } else { btp_b_r };

    let btpa1: Float = (btp1 * (prob).a11) + (btp2 * (prob).a21);
    let btpa2: Float = (btp1 * (prob).a12) + (btp2 * (prob).a22);

    let k1: Float = btpa1 / safe_denom;
    let k2: Float = btpa2 / safe_denom;

    return LQR2DSolution {
        k1: k1,
        k2: k2,
        p11: p11,
        p12: p12,
        p22: p22,
        converged: is_conv
    };
}
