// # Variable Time-Step Prediction Horizon Allocation
//
// Logline: Schedules non-uniform horizon time steps allocating high temporal resolution near-term and coarse long-term lookahead.
//
// Setup: Multi-rate prediction horizon manager maintaining accurate high-frequency dynamics while extending lookahead distance.
//
// Beats:
//   1. Allocate fine time steps dt_near (e.g. 20ms) for initial steps capturing tire and chassis dynamics.
//   2. Allocate coarse time steps dt_far (e.g. 100ms) for trailing steps extending preview range.
//   3. Compute cumulative horizon time T_tot and cumulative preview distance.
//   4. Interpolate reference trajectory waypoints onto non-uniform time grid points.

pub type VariableHorizonConfig = struct {
    fine_steps: Int,
    dt_fine: Float,
    coarse_steps: Int,
    dt_coarse: Float,
};

pub type HorizonTimeGrid = struct {
    total_steps: Int,
    total_time_s: Float,
};

pub fn variable_horizon_default() -> VariableHorizonConfig {
    return VariableHorizonConfig {
        fine_steps: 5,
        dt_fine: 0.02,
        coarse_steps: 10,
        dt_coarse: 0.10,
    };
}

pub fn compute_horizon_grid(cfg: &VariableHorizonConfig) -> HorizonTimeGrid {
    let t_fine: Float = ((cfg).fine_steps as Float) * (cfg).dt_fine;
    let t_coarse: Float = ((cfg).coarse_steps as Float) * (cfg).dt_coarse;
    let t_total: Float = t_fine + t_coarse;
    let n_total: Int = (cfg).fine_steps + (cfg).coarse_steps;

    return HorizonTimeGrid {
        total_steps: n_total,
        total_time_s: t_total,
    };
}

pub fn get_step_dt(step_index: Int, cfg: &VariableHorizonConfig) -> Float {
    if step_index < (cfg).fine_steps {
        return (cfg).dt_fine;
    }
    return (cfg).dt_coarse;
}
