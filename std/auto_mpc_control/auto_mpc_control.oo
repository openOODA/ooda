pub type AutonomousVehicleMpcSystem = struct {
    capabilities: AutoControlCapabilities,
    kinematic_params: KinematicBicycleParams,
    dynamic_params: DynamicBicycleParams,
    nmpc_config: NMPCConfig,
    stanley_config: StanleyConfig,
    is_armed: Bool
};

pub fn auto_mpc_system_new() -> AutonomousVehicleMpcSystem {
    return AutonomousVehicleMpcSystem {
        capabilities: auto_control_capabilities_default(),
        kinematic_params: kinematic_bicycle_params_default(),
        dynamic_params: dynamic_bicycle_params_default(),
        nmpc_config: nmpc_config_default(),
        stanley_config: stanley_config_default(),
        is_armed: false
    };
}

pub fn auto_mpc_system_arm(sys: &AutonomousVehicleMpcSystem) -> AutonomousVehicleMpcSystem {
    return AutonomousVehicleMpcSystem {
        capabilities: (sys).capabilities,
        kinematic_params: (sys).kinematic_params,
        dynamic_params: (sys).dynamic_params,
        nmpc_config: (sys).nmpc_config,
        stanley_config: (sys).stanley_config,
        is_armed: true
    };
}

pub fn auto_mpc_system_disarm(sys: &AutonomousVehicleMpcSystem) -> AutonomousVehicleMpcSystem {
    return AutonomousVehicleMpcSystem {
        capabilities: (sys).capabilities,
        kinematic_params: (sys).kinematic_params,
        dynamic_params: (sys).dynamic_params,
        nmpc_config: (sys).nmpc_config,
        stanley_config: (sys).stanley_config,
        is_armed: false
    };
}
