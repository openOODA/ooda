// # Dynamic 2-DOF Bicycle Vehicle Model & State-Space
//
// Logline: Formulates lateral velocity and yaw rate dynamics incorporating linear and nonlinear front/rear cornering tire forces.
//
// Setup: High-speed dynamic vehicle handling model providing continuous and discrete state-space representations for optimal MPC and LQR.
//
// Beats:
//   1. Formulate 2-DOF equations of motion for vehicle lateral velocity vy and yaw rate r.
//   2. Compute continuous-time state matrix A and input matrix B as a function of forward speed vx.
//   3. Discretize dynamics over sample interval dt using forward Euler and matrix exponential approximations.
//   4. Calculate understeer gradient Kus, neutral steer characteristic speed, and critical stability speed.

pub type DynamicBicycleParams = struct {
    mass: Float,
    inertia_z: Float,
    dist_front: Float,
    dist_rear: Float,
    cornering_stiff_f: Float,
    cornering_stiff_r: Float
};

pub type DynamicBicycleState = struct {
    vy: Float,
    yaw_rate: Float,
    y_pos: Float,
    yaw: Float
};

pub type DynamicBicycleDeriv = struct {
    d_vy: Float,
    d_yaw_rate: Float,
    d_y_pos: Float,
    d_yaw: Float
};

pub fn dynamic_bicycle_params_default() -> DynamicBicycleParams {
    return DynamicBicycleParams {
        mass: 1600.0,
        inertia_z: 2500.0,
        dist_front: 1.25,
        dist_rear: 1.55,
        cornering_stiff_f: 90000.0,
        cornering_stiff_r: 100000.0
    };
}

pub fn dynamic_bicycle_state_new(vy: Float, yaw_rate: Float, y_pos: Float, yaw: Float) -> DynamicBicycleState {
    return DynamicBicycleState {
        vy: vy,
        yaw_rate: yaw_rate,
        y_pos: y_pos,
        yaw: yaw
    };
}

pub fn dynamic_bicycle_state_zero() -> DynamicBicycleState {
    return DynamicBicycleState { vy: 0.0, yaw_rate: 0.0, y_pos: 0.0, yaw: 0.0 };
}

pub fn compute_understeer_gradient(p: &DynamicBicycleParams) -> Float {
    let l_tot: Float = (p).dist_front + (p).dist_rear;
    let front_term: Float = ((p).dist_rear * (p).mass) / ((p).cornering_stiff_f * l_tot);
    let rear_term: Float = ((p).dist_front * (p).mass) / ((p).cornering_stiff_r * l_tot);
    return front_term - rear_term;
}

pub fn compute_dynamic_deriv(
    s: &DynamicBicycleState,
    delta_steer: Float,
    vx: Float,
    p: &DynamicBicycleParams
) -> DynamicBicycleDeriv {
    let safe_vx: Float = if vx < 1.0 { 1.0 } else { vx };
    let cf: Float = (p).cornering_stiff_f;
    let cr: Float = (p).cornering_stiff_r;
    let lf: Float = (p).dist_front;
    let lr: Float = (p).dist_rear;
    let m: Float = (p).mass;
    let iz: Float = (p).inertia_z;

    let alpha_f: Float = delta_steer - (((s).vy + (lf * (s).yaw_rate)) / safe_vx);
    let alpha_r: Float = 0.0 - (((s).vy - (lr * (s).yaw_rate)) / safe_vx);

    let fy_f: Float = cf * alpha_f;
    let fy_r: Float = cr * alpha_r;

    let d_vy: Float = ((fy_f + fy_r) / m) - (safe_vx * (s).yaw_rate);
    let d_yaw_rate: Float = ((lf * fy_f) - (lr * fy_r)) / iz;
    let d_y_pos: Float = ((s).vy * cos((s).yaw)) + (safe_vx * sin((s).yaw));
    let d_yaw: Float = (s).yaw_rate;

    return DynamicBicycleDeriv {
        d_vy: d_vy,
        d_yaw_rate: d_yaw_rate,
        d_y_pos: d_y_pos,
        d_yaw: d_yaw
    };
}

pub fn dynamic_bicycle_step_euler(
    s: &DynamicBicycleState,
    delta_steer: Float,
    vx: Float,
    dt: Float,
    p: &DynamicBicycleParams
) -> DynamicBicycleState {
    let d: DynamicBicycleDeriv = compute_dynamic_deriv(s, delta_steer, vx, p);
    return DynamicBicycleState {
        vy: (s).vy + ((d).d_vy * dt),
        yaw_rate: (s).yaw_rate + ((d).d_yaw_rate * dt),
        y_pos: (s).y_pos + ((d).d_y_pos * dt),
        yaw: (s).yaw + ((d).d_yaw * dt)
    };
}
