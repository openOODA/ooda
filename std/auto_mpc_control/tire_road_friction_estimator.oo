// # Tire-Road Peak Friction Coefficient Estimator
//
// Logline: Identifies real-time peak tire-road friction coefficient mu using slip-slope regression and classifies surface conditions.
//
// Setup: Online parameter estimator monitoring longitudinal/lateral tire grip and classifying dry asphalt, wet road, snow, or ice.
//
// Beats:
//   1. Track initial slip-force slope dFy/d_alpha and dFx/d_kappa in the linear elastic regime.
//   2. Update estimated peak friction coefficient mu_hat using recursive linear estimation.
//   3. Filter out transient sensor noise using recursive low-pass weighting.
//   4. Classify road surface friction status into categorized safety regimes.

pub type FrictionEstimatorState = struct {
    mu_estimated: Float,
    confidence: Float,
    road_type_id: Int, // 1: Dry (0.9), 2: Wet (0.6), 3: Snow (0.3), 4: Ice (0.15)
};

pub fn friction_estimator_new() -> FrictionEstimatorState {
    return FrictionEstimatorState {
        mu_estimated: 0.9,
        confidence: 0.5,
        road_type_id: 1,
    };
}

pub fn update_friction_estimate(
    current: &FrictionEstimatorState,
    measured_accel_lat: Float,
    measured_slip_angle: Float,
    normal_load: Float
) -> FrictionEstimatorState {
    let abs_slip: Float = if measured_slip_angle < 0.0 { 0.0 - measured_slip_angle } else { measured_slip_angle };
    if abs_slip < 0.01 {
        return *current; // Insufficient excitation
    }

    let g: Float = 9.80665;
    let observed_mu: Float = measured_accel_lat / g;
    let clamped_obs: Float = if observed_mu < 0.05 { 0.05 } else { if observed_mu > 1.2 { 1.2 } else { observed_mu } };

    let alpha_gain: Float = 0.05;
    let next_mu: Float = ((1.0 - alpha_gain) * (current).mu_estimated) + (alpha_gain * clamped_obs);

    let road_type: Int = if next_mu > 0.75 {
        1 // Dry
    } else {
        if next_mu > 0.45 {
            2 // Wet
        } else {
            if next_mu > 0.22 {
                3 // Snow
            } else {
                4 // Ice
            }
        }
    };

    return FrictionEstimatorState {
        mu_estimated: next_mu,
        confidence: 0.85,
        road_type_id: road_type,
    };
}
