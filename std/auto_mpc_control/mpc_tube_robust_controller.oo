// # Tube-Based Robust MPC with Robust Invariant Sets
//
// Logline: Decouples nominal trajectory optimization from ancillary feedback control to guarantee constraint satisfaction under bounded disturbances.
//
// Setup: Robust MPC architecture utilizing a nominal system optimizer surrounded by a Robust Positively Invariant (RPI) tube.
//
// Beats:
//   1. Formulate nominal model evolution under zero disturbance.
//   2. Compute tightened state and input constraint boundaries subtracting invariant tube cross-section.
//   3. Implement ancillary state-feedback controller u = u_nom + K*(x_true - x_nom).
//   4. Prove closed-loop robust forward invariance against bounded wind and road disturbances.

pub type TubeMPCConfig = struct {
    tube_radius_m: Float,
    feedback_gain_k: Float,
    nominal_u_max: Float,
};

pub type TubeControlOutput = struct {
    nominal_steer: Float,
    feedback_steer: Float,
    total_steer: Float,
    is_inside_tube: Bool,
};

pub fn tube_mpc_config_default() -> TubeMPCConfig {
    return TubeMPCConfig {
        tube_radius_m: 0.25,
        feedback_gain_k: 2.0,
        nominal_u_max: 0.5,
    };
}

pub fn tube_mpc_control_step(
    actual_cte: Float,
    nominal_cte: Float,
    nominal_steer: Float,
    cfg: &TubeMPCConfig
) -> TubeControlOutput {
    let error_inside_tube: Float = actual_cte - nominal_cte;
    let abs_err: Float = if error_inside_tube < 0.0 { 0.0 - error_inside_tube } else { error_inside_tube };
    let inside: Bool = abs_err <= (cfg).tube_radius_m;

    let fb_steer: Float = (0.0 - (cfg).feedback_gain_k) * error_inside_tube;
    let total: Float = nominal_steer + fb_steer;

    let clamped_total: Float = if total < (0.0 - (cfg).nominal_u_max) {
        0.0 - (cfg).nominal_u_max
    } else {
        if total > (cfg).nominal_u_max { (cfg).nominal_u_max } else { total }
    };

    return TubeControlOutput {
        nominal_steer: nominal_steer,
        feedback_steer: fb_steer,
        total_steer: clamped_total,
        is_inside_tube: inside,
    };
}
