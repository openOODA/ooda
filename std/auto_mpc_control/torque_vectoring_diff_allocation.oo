// # Direct Yaw Moment Control (DYC) & Torque Vectoring
//
// Logline: Allocates drive and braking torques to four independent in-wheel electric motors to generate corrective yaw moments.
//
// Setup: Multi-motor torque allocation engine optimizing yaw stability while minimizing individual tire friction utilization.
//
// Beats:
//   1. Receive total requested traction force F_x_tot and stabilizing yaw moment delta_M_z.
//   2. Allocate left-right torque differentials across front and rear axles.
//   3. Minimize individual wheel friction capacity consumption (Fx_i / Fz_i)^2.
//   4. Enforce electric motor peak torque limits and inverter thermal limits.

pub type TorqueAllocationParams = struct {
    track_width: Float,
    wheel_radius: Float,
    max_motor_torque_nm: Float
};

pub type FourWheelTorques = struct {
    torque_fl_nm: Float,
    torque_fr_nm: Float,
    torque_rl_nm: Float,
    torque_rr_nm: Float
};

pub fn torque_params_default() -> TorqueAllocationParams {
    return TorqueAllocationParams {
        track_width: 1.6,
        wheel_radius: 0.33,
        max_motor_torque_nm: 400.0
    };
}

pub fn allocate_motor_torques(
    total_force_fx_n: Float,
    target_yaw_moment_nm: Float,
    p: &TorqueAllocationParams
) -> FourWheelTorques {
    let r: Float = (p).wheel_radius;
    let w: Float = (p).track_width;

    // Base torque per wheel
    let base_torque: Float = (total_force_fx_n * r) * 0.25;

    // Differential force: Delta_Fx = Mz / track_width
    // Delta_Torque per side = (Delta_Fx / 2) * r = (Mz * r) / (2 * track_width)
    let delta_torque: Float = (target_yaw_moment_nm * r) / (2.0 * w);

    let raw_fl: Float = base_torque - (0.5 * delta_torque);
    let raw_fr: Float = base_torque + (0.5 * delta_torque);
    let raw_rl: Float = base_torque - (0.5 * delta_torque);
    let raw_rr: Float = base_torque + (0.5 * delta_torque);

    let max_t: Float = (p).max_motor_torque_nm;
    let fl: Float = if raw_fl < (0.0 - max_t) { 0.0 - max_t } else { if raw_fl > max_t { max_t } else { raw_fl } };
    let fr: Float = if raw_fr < (0.0 - max_t) { 0.0 - max_t } else { if raw_fr > max_t { max_t } else { raw_fr } };
    let rl: Float = if raw_rl < (0.0 - max_t) { 0.0 - max_t } else { if raw_rl > max_t { max_t } else { raw_rl } };
    let rr: Float = if raw_rr < (0.0 - max_t) { 0.0 - max_t } else { if raw_rr > max_t { max_t } else { raw_rr } };

    return FourWheelTorques {
        torque_fl_nm: fl,
        torque_fr_nm: fr,
        torque_rl_nm: rl,
        torque_rr_nm: rr
    };
}
