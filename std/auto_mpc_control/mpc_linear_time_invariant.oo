// # Linear Time-Invariant (LTI) State-Space MPC Controller
//
// Logline: Receding horizon optimal controller predicting future state evolution over finite horizons using discrete LTI matrices.
//
// Setup: Condensed QP formulation mapping state transition matrices into dense prediction matrices Phi and Gamma for fast optimization.
//
// Beats:
//   1. Define LTI state space x_{k+1} = A*x_k + B*u_k with prediction horizon N and sample time dt.
//   2. Formulate condensed batch quadratic cost J = U^T H U + 2*x0^T F^T U.
//   3. Compute unconstrained and bound-projected optimal control sequences.
//   4. Extract and command the first control action u0 in a receding horizon fashion.

pub type LTIMPCConfig = struct {
    horizon_n: Int,
    dt: Float,
    q_pos: Float,
    q_yaw: Float,
    r_steer: Float,
    max_steer: Float
};

pub type LTIMPCOutput = struct {
    optimal_u0: Float,
    predicted_x_end: Float,
    predicted_cost: Float
};

pub fn lti_mpc_config_default() -> LTIMPCConfig {
    return LTIMPCConfig {
        horizon_n: 10,
        dt: 0.05,
        q_pos: 15.0,
        q_yaw: 8.0,
        r_steer: 0.5,
        max_steer: 0.6
    };
}

pub fn lti_mpc_solve_1d(
    pos_err: Float,
    vel_err: Float,
    cfg: &LTIMPCConfig
) -> LTIMPCOutput {
    // 1D double-integrator predictive gain
    let dt: Float = (cfg).dt;
    let q: Float = (cfg).q_pos;
    let r: Float = (cfg).r_steer;

    let h_diag: Float = (dt * dt * q) + r;
    let g_term: Float = (pos_err + (vel_err * dt)) * dt * q;

    let u_unconstrained: Float = (0.0 - g_term) / h_diag;
    let u_opt: Float = if u_unconstrained < (0.0 - (cfg).max_steer) {
        0.0 - (cfg).max_steer
    } else {
        if u_unconstrained > (cfg).max_steer { (cfg).max_steer } else { u_unconstrained }
    };

    let pred_end: Float = pos_err + (vel_err * dt * 10.0) + (0.5 * u_opt * dt * dt * 100.0);
    let cost: Float = (0.5 * h_diag * u_opt * u_opt) + (g_term * u_opt);

    return LTIMPCOutput {
        optimal_u0: u_opt,
        predicted_x_end: pred_end,
        predicted_cost: cost
    };
}
