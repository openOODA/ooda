// # Ellipsoidal Obstacle Boundary & Collision Detection
//
// Logline: Evaluates oriented ellipsoidal collision buffers and Minkowski sum safety envelopes for vehicles and obstacles.
//
// Setup: Geometric collision evaluator standardizing oriented bounding ellipses (OBE) and continuous safety margin gradients.
//
// Beats:
//   1. Define oriented obstacle ellipse parameters (center x0/y0, semi-major a, semi-minor b, orientation theta).
//   2. Expand ellipse boundary via Minkowski sum with vehicle outer bounding radius.
//   3. Evaluate normalized quadratic distance metric (dx/a)^2 + (dy/b)^2.
//   4. Output binary collision flag, clearance distance, and outward normal repulsion vector.

pub type ObstacleEllipse = struct {
    center_x: Float,
    center_y: Float,
    semi_axis_a: Float,
    semi_axis_b: Float,
    yaw_angle: Float,
};

pub type CollisionMetric = struct {
    distance_ratio: Float,
    is_colliding: Bool,
    normal_x: Float,
    normal_y: Float,
};

pub fn evaluate_obstacle_ellipse(
    veh_x: Float,
    veh_y: Float,
    veh_radius_m: Float,
    obs: &ObstacleEllipse
) -> CollisionMetric {
    let dx: Float = veh_x - (obs).center_x;
    let dy: Float = veh_y - (obs).center_y;

    let c_yaw: Float = cos((obs).yaw_angle);
    let s_yaw: Float = sin((obs).yaw_angle);

    let local_x: Float = (dx * c_yaw) + (dy * s_yaw);
    let local_y: Float = ((0.0 - dx) * s_yaw) + (dy * c_yaw);

    let a_exp: Float = (obs).semi_axis_a + veh_radius_m;
    let b_exp: Float = (obs).semi_axis_b + veh_radius_m;

    let norm_x: Float = local_x / a_exp;
    let norm_y: Float = local_y / b_exp;
    let quad_dist: Float = (norm_x * norm_x) + (norm_y * norm_y);

    let is_hit: Bool = quad_dist <= 1.0;

    let norm_mag: Float = sqrt((local_x * local_x) + (local_y * local_y));
    let safe_mag: Float = if norm_mag < 0.1 { 0.1 } else { norm_mag };

    let world_norm_x: Float = ((local_x / safe_mag) * c_yaw) - ((local_y / safe_mag) * s_yaw);
    let world_norm_y: Float = ((local_x / safe_mag) * s_yaw) + ((local_y / safe_mag) * c_yaw);

    return CollisionMetric {
        distance_ratio: quad_dist,
        is_colliding: is_hit,
        normal_x: world_norm_x,
        normal_y: world_norm_y,
    };
}
