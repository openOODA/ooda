// # Fiala Analytical Brush Tire Mechanics Model
//
// Logline: Simulates tire tread brush element deformation, carcass shear compliance, and sliding contact boundaries.
//
// Setup: Physical analytical brush model capturing parabolic contact pressure and Coulomb friction limit transitions.
//
// Beats:
//   1. Calculate critical slip angle alpha_crit separating adhesion and full sliding regimes.
//   2. Compute cubic deflection polynomial for the partial elastic adhesion contact patch.
//   3. Enforce sliding friction force saturation for slip angles exceeding critical threshold.
//   4. Deliver smooth lateral cornering force Fy with load-dependent stiffness.

pub type FialaParams = struct {
    cornering_stiff: Float,
    friction_mu: Float,
};

pub type FialaOutput = struct {
    fy: Float,
    is_sliding: Bool,
    alpha_crit: Float,
};

pub fn fiala_params_default() -> FialaParams {
    return FialaParams {
        cornering_stiff: 80000.0,
        friction_mu: 0.9,
    };
}

pub fn compute_fiala_lateral_force(
    alpha_rad: Float,
    fz: Float,
    p: &FialaParams
) -> FialaOutput {
    let safe_fz: Float = if fz < 10.0 { 10.0 } else { fz };
    let c_alpha: Float = (p).cornering_stiff;
    let mu_fz: Float = (p).friction_mu * safe_fz;

    let tan_alpha_crit: Float = (3.0 * mu_fz) / c_alpha;
    let alpha_crit: Float = tan_alpha_crit; // small angle

    let tan_alpha: Float = sin(alpha_rad) / cos(alpha_rad);
    let abs_tan_a: Float = if tan_alpha < 0.0 { 0.0 - tan_alpha } else { tan_alpha };
    let sign_a: Float = if alpha_rad > 0.0 { 1.0 } else { if alpha_rad < 0.0 { 0.0 - 1.0 } else { 0.0 } };

    if abs_tan_a < tan_alpha_crit {
        let term1: Float = c_alpha * abs_tan_a;
        let term2: Float = ((c_alpha * c_alpha) / (3.0 * mu_fz)) * (abs_tan_a * abs_tan_a);
        let term3: Float = ((c_alpha * c_alpha * c_alpha) / (27.0 * mu_fz * mu_fz)) * (abs_tan_a * abs_tan_a * abs_tan_a);
        let fy_mag: Float = term1 - term2 + term3;
        let fy: Float = (0.0 - sign_a) * fy_mag;
        return FialaOutput { fy: fy, is_sliding: false, alpha_crit: alpha_crit };
    } else {
        let fy: Float = (0.0 - sign_a) * mu_fz;
        return FialaOutput { fy: fy, is_sliding: true, alpha_crit: alpha_crit };
    }
}
