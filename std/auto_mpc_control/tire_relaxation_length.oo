// # Tire Relaxation Length & Dynamic Lag Compensator
//
// Logline: Simulates transient first-order elastic tire carcass lag and phase delay during rapid steering transitions.
//
// Setup: Dynamic tire lag differential solver replacing instantaneous steady-state force assumptions with physical transient response.
//
// Beats:
//   1. Model first-order tire lateral force dynamics sigma_lag * dFy/dt + vx * Fy = vx * Fy_ss.
//   2. Calculate speed-dependent and normal-load-dependent relaxation length sigma_lag.
//   3. Step dynamic tire force forward in time using discrete integration.
//   4. Compensate control inputs for transient phase delay and high-frequency force attenuation.

pub type RelaxationState = struct {
    fy_current: Float,
    sigma_length: Float,
};

pub fn relaxation_state_new(sigma_length: Float) -> RelaxationState {
    return RelaxationState {
        fy_current: 0.0,
        sigma_length: sigma_length,
    };
}

pub fn relaxation_step(
    state: &RelaxationState,
    fy_steady_state: Float,
    vx: Float,
    dt: Float
) -> RelaxationState {
    let safe_vx: Float = if vx < 1.0 { 1.0 } else { vx };
    let sigma: Float = (state).sigma_length;
    let safe_sigma: Float = if sigma < 0.05 { 0.05 } else { sigma };

    // dFy/dt = (safe_vx / safe_sigma) * (fy_ss - fy_curr)
    let d_fy: Float = (safe_vx / safe_sigma) * (fy_steady_state - (state).fy_current);
    let next_fy: Float = (state).fy_current + (d_fy * dt);

    return RelaxationState {
        fy_current: next_fy,
        sigma_length: sigma,
    };
}
