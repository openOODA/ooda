// # Anti-Lock Braking System (ABS) Sliding-Mode Regulator
//
// Logline: Detects wheel lockup onset and modulates brake hydraulic pressure across 5 discrete phases to achieve minimum stopping distance.
//
// Setup: Active ABS braking regulator executing state machine pressure cycles (Hold, Dump, Pulse-Rise) at 100 Hz.
//
// Beats:
//   1. Calculate individual wheel angular deceleration dot_omega and braking slip ratio kappa.
//   2. Detect wheel lockup conditions (high deceleration + high slip).
//   3. Execute pressure dump phase to restore wheel spin when lockup is imminent.
//   4. Execute pulsed pressure rise phase to re-approach peak tire braking friction.

pub type ABSConfig = struct {
    slip_threshold: Float,
    accel_threshold_rad_s2: Float
};

pub type ABSOutput = struct {
    valve_state_id: Int, // 0: Apply, 1: Hold, 2: Dump
    commanded_pressure_ratio: Float,
    is_abs_active: Bool
};

pub fn abs_config_default() -> ABSConfig {
    return ABSConfig {
        slip_threshold: 0.20,
        accel_threshold_rad_s2: 0.0 - 80.0
    };
}

pub fn abs_control_cycle(
    wheel_slip_kappa: Float,
    wheel_accel: Float,
    current_pressure_ratio: Float,
    cfg: &ABSConfig
) -> ABSOutput {
    // Check if wheel is locking: large negative slip or excessive deceleration
    let abs_slip: Float = if wheel_slip_kappa < 0.0 { 0.0 - wheel_slip_kappa } else { wheel_slip_kappa };

    if (abs_slip > (cfg).slip_threshold) || (wheel_accel < (cfg).accel_threshold_rad_s2) {
        // DUMP PRESSURE
        return ABSOutput {
            valve_state_id: 2,
            commanded_pressure_ratio: current_pressure_ratio * 0.7,
            is_abs_active: true
        };
    }

    if abs_slip > ((cfg).slip_threshold * 0.7) {
        // HOLD PRESSURE
        return ABSOutput {
            valve_state_id: 1,
            commanded_pressure_ratio: current_pressure_ratio,
            is_abs_active: true
        };
    }

    // APPLY PRESSURE
    let next_p: Float = current_pressure_ratio + 0.05;
    let clamped_p: Float = if next_p > 1.0 { 1.0 } else { next_p };

    return ABSOutput {
        valve_state_id: 0,
        commanded_pressure_ratio: clamped_p,
        is_abs_active: false
    };
}
