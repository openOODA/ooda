// # Traction Control System (TCS) Wheel Spin Slip Regulator
//
// Logline: Monitors drive wheel spin during acceleration and modulates powertrain torque to maintain peak tire grip.
//
// Setup: High-speed slip regulator keeping drive wheel longitudinal slip ratio near optimal adhesion threshold (kappa ~ 0.10 - 0.15).
//
// Beats:
//   1. Compare driven wheel speeds with vehicle reference ground speed to compute slip ratio kappa.
//   2. Detect excessive wheel spin exceeding target traction slip threshold kappa_target.
//   3. Execute PI torque reduction control to rapidly attenuate wheel acceleration.
//   4. Deliver torque scaling factor preventing vehicle fishtailing and loss of forward traction.

pub type TCSConfig = struct {
    target_slip_kappa: Float,
    kp_gain: Float,
    ki_gain: Float
};

pub type TCSState = struct {
    integral_err: Float,
    tcs_active: Bool
};

pub type TCSOutput = struct {
    torque_scale_factor: Float,
    next_integral_err: Float,
    is_tcs_engaged: Bool
};

pub fn tcs_config_default() -> TCSConfig {
    return TCSConfig {
        target_slip_kappa: 0.12,
        kp_gain: 3.5,
        ki_gain: 0.8
    };
}

pub fn tcs_step(
    wheel_slip_kappa: Float,
    state: &TCSState,
    dt: Float,
    cfg: &TCSConfig
) -> TCSOutput {
    let slip_err: Float = wheel_slip_kappa - (cfg).target_slip_kappa;

    if slip_err <= 0.0 {
        return TCSOutput {
            torque_scale_factor: 1.0,
            next_integral_err: 0.0,
            is_tcs_engaged: false
        };
    }

    let next_int: Float = (state).integral_err + (slip_err * dt);
    let raw_reduction: Float = ((cfg).kp_gain * slip_err) + ((cfg).ki_gain * next_int);

    let scale: Float = 1.0 - raw_reduction;
    let clamped_scale: Float = if scale < 0.1 { 0.1 } else { if scale > 1.0 { 1.0 } else { scale } };

    return TCSOutput {
        torque_scale_factor: clamped_scale,
        next_integral_err: next_int,
        is_tcs_engaged: true
    };
}
