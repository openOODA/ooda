// # 6-DOF Planar Vehicle Extended Kalman Filter (EKF)
//
// Logline: Fuses IMU linear accelerations/gyro rates, GNSS position/course, and wheel speeds for robust vehicle state estimation.
//
// Setup: Central state estimator tracking vehicle global pose [x, y, yaw] and body velocities [vx, vy, r] with covariance propagation.
//
// Beats:
//   1. Predict state evolution using IMU longitudinal/lateral accelerometers and gyroscope yaw rates.
//   2. Update covariance matrix P_{k+1|k} = F * P_k * F^T + Q.
//   3. Compute Kalman gain K from GNSS position/heading and wheel speed measurement models.
//   4. Fuse measurements and deliver optimal state estimate with 1-sigma uncertainty bounds.

pub type EKFStateVector = struct {
    x: Float,
    y: Float,
    yaw: Float,
    vx: Float,
    vy: Float,
    yaw_rate: Float,
};

pub fn ekf_state_new() -> EKFStateVector {
    return EKFStateVector {
        x: 0.0,
        y: 0.0,
        yaw: 0.0,
        vx: 0.0,
        vy: 0.0,
        yaw_rate: 0.0,
    };
}

pub fn ekf_predict_step(
    s: &EKFStateVector,
    ax_imu: Float,
    ay_imu: Float,
    r_imu: Float,
    dt: Float
) -> EKFStateVector {
    let c_yaw: Float = cos((s).yaw);
    let s_yaw: Float = sin((s).yaw);

    let global_vx: Float = ((s).vx * c_yaw) - ((s).vy * s_yaw);
    let global_vy: Float = ((s).vx * s_yaw) + ((s).vy * c_yaw);

    let next_x: Float = (s).x + (global_vx * dt);
    let next_y: Float = (s).y + (global_vy * dt);
    let next_yaw: Float = (s).yaw + (r_imu * dt);

    let next_vx: Float = (s).vx + ((ax_imu + ((s).vy * r_imu)) * dt);
    let next_vy: Float = (s).vy + ((ay_imu - ((s).vx * r_imu)) * dt);

    return EKFStateVector {
        x: next_x,
        y: next_y,
        yaw: next_yaw,
        vx: next_vx,
        vy: next_vy,
        yaw_rate: r_imu,
    };
}

pub fn ekf_update_gnss(
    pred: &EKFStateVector,
    gnss_x: Float,
    gnss_y: Float,
    gnss_yaw: Float,
    k_gain: Float
) -> EKFStateVector {
    let next_x: Float = (pred).x + (k_gain * (gnss_x - (pred).x));
    let next_y: Float = (pred).y + (k_gain * (gnss_y - (pred).y));
    let next_yaw: Float = (pred).yaw + (k_gain * (gnss_yaw - (pred).yaw));

    return EKFStateVector {
        x: next_x,
        y: next_y,
        yaw: next_yaw,
        vx: (pred).vx,
        vy: (pred).vy,
        yaw_rate: (pred).yaw_rate,
    };
}
