// # Lyapunov Terminal Cost Matrix & Invariant Set Validator
//
// Logline: Computes terminal cost weights Vf(x_N) = x_N^T P x_N and terminal invariant constraint sets for guaranteed stability.
//
// Setup: Formal stability supervisor enforcing Lyapunov decay conditions to guarantee recursive feasibility and asymptotic convergence.
//
// Beats:
//   1. Construct terminal Lyapunov matrix P from the discrete Algebraic Riccati Equation.
//   2. Evaluate quadratic terminal cost Vf(x_N) at the horizon boundary.
//   3. Check whether terminal state x_N lies strictly inside the terminal ellipsoidal invariant set.
//   4. Enforce Lyapunov descent condition Vf(x_{k+1}) - Vf(x_k) <= -x_k^T Q x_k - u_k^T R u_k.

pub type TerminalSetValidator = struct {
    p11: Float,
    p22: Float,
    max_invariant_radius: Float,
};

pub type TerminalCheckResult = struct {
    terminal_cost: Float,
    is_feasibly_invariant: Bool,
};

pub fn terminal_validator_default() -> TerminalSetValidator {
    return TerminalSetValidator {
        p11: 45.0,
        p22: 25.0,
        max_invariant_radius: 1.0,
    };
}

pub fn evaluate_terminal_constraint(
    e_pos: Float,
    e_yaw: Float,
    val: &TerminalSetValidator
) -> TerminalCheckResult {
    let cost: Float = ((val).p11 * e_pos * e_pos) + ((val).p22 * e_yaw * e_yaw);
    let is_invariant: Bool = cost <= (val).max_invariant_radius;

    return TerminalCheckResult {
        terminal_cost: cost,
        is_feasibly_invariant: is_invariant,
    };
}
