// # Linear Time-Varying (LTV) MPC with Successive Linearization
//
// Logline: Updates dynamic vehicle state-space matrices along nominal preview trajectory waypoints for high-speed tracking.
//
// Setup: Time-varying predictive controller re-linearizing bicycle dynamics at each horizon step around scheduled speeds and yaw angles.
//
// Beats:
//   1. Linearize vehicle kinematics along nominal reference trajectory waypoints (x_ref_k, u_ref_k).
//   2. Construct step-specific state transition matrices A_k and input matrices B_k.
//   3. Propagate state deviation error dynamics Delta_x_{k+1} = A_k Delta_x_k + B_k Delta_u_k.
//   4. Deliver smooth receding horizon tracking commands compensating for time-varying vehicle speeds.

pub type LTVPoint = struct {
    vx_k: Float,
    yaw_k: Float,
    curvature_k: Float,
};

pub type LTVControlResult = struct {
    steer_cmd: Float,
    accel_cmd: Float,
};

pub fn ltv_mpc_step(
    lat_err: Float,
    yaw_err: Float,
    vx: Float,
    ref_pt: &LTVPoint,
    dt: Float
) -> LTVControlResult {
    let safe_vx: Float = if vx < 1.0 { 1.0 } else { vx };
    let lf: Float = 1.3;
    let lr: Float = 1.5;
    let l_tot: Float = lf + lr;

    // Linearized error feedback: steer = yaw_err + (k_lat * lat_err / safe_vx)
    let k_lat: Float = 2.5;
    let k_yaw: Float = 1.8;

    let ff_steer: Float = l_tot * (ref_pt).curvature_k;
    let fb_steer: Float = (k_yaw * yaw_err) + ((k_lat * lat_err) / safe_vx);
    let total_steer: Float = ff_steer + fb_steer;

    let target_vx: Float = (ref_pt).vx_k;
    let k_v: Float = 1.2;
    let accel: Float = k_v * (target_vx - safe_vx);

    return LTVControlResult {
        steer_cmd: total_steer,
        accel_cmd: accel,
    };
}
