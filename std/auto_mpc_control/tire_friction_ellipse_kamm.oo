// # Kamm Friction Circle & Friction Ellipse Governor
//
// Logline: Enforces coupled longitudinal/lateral tire force saturation and prioritizes steering vs braking traction allocation.
//
// Setup: Active tire friction constraint governor projecting unconstrained control commands onto the physical tire friction ellipse.
//
// Beats:
//   1. Formulate the Kamm friction ellipse equation (Fx/Fx_max)^2 + (Fy/Fy_max)^2 <= 1.
//   2. Calculate current friction capacity utilization percentage.
//   3. Project overflowing force demands onto the ellipse boundary using radial projection.
//   4. Provide prioritized allocation modes (Steering Priority vs Braking Priority).

pub type FrictionEllipseParams = struct {
    mu_x: Float,
    mu_y: Float,
};

pub type SaturatedTireForces = struct {
    fx_sat: Float,
    fy_sat: Float,
    utilization_pct: Float,
};

pub fn friction_ellipse_params_default() -> FrictionEllipseParams {
    return FrictionEllipseParams {
        mu_x: 0.95,
        mu_y: 0.90,
    };
}

pub fn project_kamm_friction_ellipse(
    fx_cmd: Float,
    fy_cmd: Float,
    fz: Float,
    p: &FrictionEllipseParams
) -> SaturatedTireForces {
    let safe_fz: Float = if fz < 10.0 { 10.0 } else { fz };
    let fx_max: Float = (p).mu_x * safe_fz;
    let fy_max: Float = (p).mu_y * safe_fz;

    let norm_x: Float = fx_cmd / fx_max;
    let norm_y: Float = fy_cmd / fy_max;
    let norm_radius_sq: Float = (norm_x * norm_x) + (norm_y * norm_y);
    let norm_radius: Float = sqrt(norm_radius_sq);

    let utilization: Float = norm_radius * 100.0;

    if norm_radius <= 1.0 {
        return SaturatedTireForces {
            fx_sat: fx_cmd,
            fy_sat: fy_cmd,
            utilization_pct: utilization,
        };
    }

    // Radial scaling to ellipse boundary
    let scale: Float = 1.0 / norm_radius;
    return SaturatedTireForces {
        fx_sat: fx_cmd * scale,
        fy_sat: fy_cmd * scale,
        utilization_pct: 100.0,
    };
}
