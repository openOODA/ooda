// # Stochastic Chance-Constrained MPC (SCMPC)
//
// Logline: Converts probabilistic vehicle state boundaries under Gaussian uncertainty into tightened deterministic MPC constraints.
//
// Setup: Stochastic MPC solver propagating mean states and covariance matrices to enforce safety with confidence 1 - epsilon.
//
// Beats:
//   1. Propagate mean state vector and error covariance Sigma_{k+1} = A*Sigma_k*A^T + W.
//   2. Calculate quantile multiplier for Gaussian safety probability 1 - epsilon.
//   3. Compute tightened deterministic road corridor boundaries y_det_max = y_road_max - z_quantile * sigma_y.
//   4. Enforce collision-free navigation under stochastic sensor noise and tire slip variations.

pub type ChanceConstraintConfig = struct {
    quantile_multiplier: Float, // e.g. 2.33 for 99% confidence
    road_half_width_m: Float
};

pub type TightenedBounds = struct {
    max_lateral_m: Float,
    min_lateral_m: Float,
    current_sigma_m: Float
};

pub fn chance_config_default() -> ChanceConstraintConfig {
    return ChanceConstraintConfig {
        quantile_multiplier: 2.33,
        road_half_width_m: 1.75
    };
}

pub fn compute_tightened_bounds(
    initial_sigma_m: Float,
    step: Int,
    disturb_var: Float,
    cfg: &ChanceConstraintConfig
) -> TightenedBounds {
    let sigma_growth: Float = sqrt((initial_sigma_m * initial_sigma_m) + (0.005 * disturb_var * (step as Float)));
    let tightening: Float = (cfg).quantile_multiplier * sigma_growth;

    let max_lat: Float = (cfg).road_half_width_m - tightening;
    let min_lat: Float = (0.0 - (cfg).road_half_width_m) + tightening;

    let safe_max: Float = if max_lat < 0.2 { 0.2 } else { max_lat };
    let safe_min: Float = if min_lat > (0.0 - 0.2) { 0.0 - 0.2 } else { min_lat };

    return TightenedBounds {
        max_lateral_m: safe_max,
        min_lateral_m: safe_min,
        current_sigma_m: sigma_growth
    };
}
