// # LQR Lateral Error Controller with Curvature Feedforward
//
// Logline: Regulates 4-state lateral tracking error [e_y, e_y_dot, e_psi, e_psi_dot] with dynamic curvature feedforward compensation.
//
// Setup: State-space LQR tracking controller delivering zero steady-state tracking error across high-speed highway curves.
//
// Beats:
//   1. Formulate 4-state lateral error dynamics on cross-track and heading error rates.
//   2. Compute feedforward steering delta_ff = L*kappa - lr*kappa + m*vx^2*kappa*(lf/2Cr - lr/2Cf)/L.
//   3. Evaluate state-feedback LQR control law delta_fb = -K * e.
//   4. Deliver total steering command delta = delta_ff + delta_fb.

pub type LQRLateralGains = struct {
    k_ey: Float,
    k_ey_dot: Float,
    k_epsi: Float,
    k_epsi_dot: Float
};

pub type LQRLateralOutput = struct {
    steer_total: Float,
    steer_ff: Float,
    steer_fb: Float
};

pub fn lqr_lateral_gains_default() -> LQRLateralGains {
    return LQRLateralGains {
        k_ey: 0.85,
        k_ey_dot: 0.45,
        k_epsi: 1.45,
        k_epsi_dot: 0.25
    };
}

pub fn lqr_lateral_step(
    ey: Float,
    ey_dot: Float,
    epsi: Float,
    epsi_dot: Float,
    curvature: Float,
    vx: Float,
    gains: &LQRLateralGains
) -> LQRLateralOutput {
    let safe_vx: Float = if vx < 1.0 { 1.0 } else { vx };
    let lf: Float = 1.3;
    let lr: Float = 1.5;
    let l_tot: Float = lf + lr;
    let m: Float = 1600.0;
    let cf: Float = 90000.0;
    let cr: Float = 100000.0;

    let understeer_term: Float = ((lr * m) / (2.0 * cf * l_tot)) - ((lf * m) / (2.0 * cr * l_tot));
    let steer_ff: Float = (l_tot * curvature) + (understeer_term * safe_vx * safe_vx * curvature);

    let steer_fb: Float = (0.0 - ((gains).k_ey * ey))
        - ((gains).k_ey_dot * ey_dot)
        - ((gains).k_epsi * epsi)
        - ((gains).k_epsi_dot * epsi_dot);

    let total: Float = steer_ff + steer_fb;
    let clamped: Float = if total < (0.0 - 0.6) { 0.0 - 0.6 } else { if total > 0.6 { 0.6 } else { total } };

    return LQRLateralOutput {
        steer_total: clamped,
        steer_ff: steer_ff,
        steer_fb: steer_fb
    };
}
