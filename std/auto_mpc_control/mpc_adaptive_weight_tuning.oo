// # Adaptive MPC Cost Weight Matrix Tuning Supervisor
//
// Logline: Dynamically modulates state tracking and control penalty matrices based on road curvature, tracking error, and comfort requirements.
//
// Setup: Online meta-controller adapting MPC Q and R weights to prioritize tight tracking during sharp curves and comfort on straights.
//
// Beats:
//   1. Monitor cross-track error magnitude and boost lateral tracking weight Q_y under high deviations.
//   2. Increase heading weight Q_psi during high road curvature segments.
//   3. Scale up control rate penalties R_delta in passenger comfort mode to prevent abrupt steering jerks.
//   4. De-rate control weights under low tire-road friction to prevent actuator saturation.

pub type AdaptiveWeights = struct {
    weight_cte: Float,
    weight_epsi: Float,
    weight_v: Float,
    weight_steer: Float,
    weight_accel: Float,
};

pub fn compute_adaptive_weights(
    abs_cte_m: Float,
    abs_curvature: Float,
    friction_mu: Float,
    comfort_mode: Bool
) -> AdaptiveWeights {
    let mut w_cte: Float = 20.0;
    let mut w_epsi: Float = 12.0;
    let mut w_v: Float = 2.0;
    let mut w_steer: Float = 5.0;
    let mut w_accel: Float = 1.0;

    // High error -> tighten tracking
    if abs_cte_m > 0.5 {
        w_cte = w_cte * 2.0;
    }

    // High curvature -> prioritize heading alignment
    if abs_curvature > 0.02 {
        w_epsi = w_epsi * 1.8;
    }

    // Low friction -> penalize sharp inputs
    if friction_mu < 0.5 {
        w_steer = w_steer * 2.5;
        w_accel = w_accel * 2.0;
    }

    // Comfort mode
    if comfort_mode {
        w_steer = w_steer * 1.5;
        w_accel = w_accel * 1.5;
    }

    return AdaptiveWeights {
        weight_cte: w_cte,
        weight_epsi: w_epsi,
        weight_v: w_v,
        weight_steer: w_steer,
        weight_accel: w_accel,
    };
}
