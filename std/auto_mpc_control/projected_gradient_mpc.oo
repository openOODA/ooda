// # Fast Projected Gradient Descent Optimizer for Box MPC
//
// Logline: Executes projected gradient descent with Nesterov momentum acceleration for ultra-low latency real-time MPC tracking.
//
// Setup: Lightweight convex optimizer computing control commands under strict microsecond execution deadlines without matrix inversions.
//
// Beats:
//   1. Compute gradient of quadratic objective grad = H*u + g.
//   2. Apply Nesterov momentum extrapolation using previous control iterations.
//   3. Project updated controls onto box actuation constraints [u_min, u_max].
//   4. Terminate adaptively when gradient projection norm drops below convergence tolerance.

pub type ProjectedGradConfig = struct {
    step_size: Float,
    momentum_beta: Float,
    max_iter: Int,
    tolerance: Float,
};

pub type ProjectedGradOutput = struct {
    u1_opt: Float,
    u2_opt: Float,
    iterations: Int,
    final_grad_norm: Float,
};

pub fn projected_grad_config_default() -> ProjectedGradConfig {
    return ProjectedGradConfig {
        step_size: 0.1,
        momentum_beta: 0.8,
        max_iter: 30,
        tolerance: 0.0001,
    };
}

pub fn solve_projected_gradient_2d(
    h11: Float, h22: Float,
    g1: Float, g2: Float,
    u1_min: Float, u1_max: Float,
    u2_min: Float, u2_max: Float,
    cfg: &ProjectedGradConfig
) -> ProjectedGradOutput {
    let mut u1: Float = 0.0;
    let mut u2: Float = 0.0;
    let mut u1_prev: Float = 0.0;
    let mut u2_prev: Float = 0.0;

    let gamma: Float = (cfg).step_size;
    let beta: Float = (cfg).momentum_beta;
    let mut iter: Int = 0;
    let mut grad_norm: Float = 1.0;

    while (iter < (cfg).max_iter) && (grad_norm > (cfg).tolerance) {
        iter = iter + 1;
        // Momentum point
        let y1: Float = u1 + (beta * (u1 - u1_prev));
        let y2: Float = u2 + (beta * (u2 - u2_prev));

        let grad1: Float = (h11 * y1) + g1;
        let grad2: Float = (h22 * y2) + g2;

        u1_prev = u1;
        u2_prev = u2;

        let cand1: Float = y1 - (gamma * grad1);
        let cand2: Float = y2 - (gamma * grad2);

        u1 = if cand1 < u1_min { u1_min } else { if cand1 > u1_max { u1_max } else { cand1 } };
        u2 = if cand2 < u2_min { u2_min } else { if cand2 > u2_max { u2_max } else { cand2 } };

        let diff1: Float = u1 - u1_prev;
        let diff2: Float = u2 - u2_prev;
        grad_norm = sqrt((diff1 * diff1) + (diff2 * diff2));
    }

    return ProjectedGradOutput {
        u1_opt: u1,
        u2_opt: u2,
        iterations: iter,
        final_grad_norm: grad_norm,
    };
}
