// # Super-Twisting Sliding Mode Lateral Yaw Controller
//
// Logline: Provides robust second-order sliding mode trajectory tracking invariant to lateral wind gusts and tire parameter uncertainty.
//
// Setup: Chattering-free sliding mode controller driving cross-track error to zero in finite time using super-twisting integration.
//
// Beats:
//   1. Construct sliding surface s = e_y_dot + c1 * e_y.
//   2. Compute continuous super-twisting control law u = -k1 * sqrt(|s|) * sgn(s) + v_int.
//   3. Update internal super-twisting integrator dv_int/dt = -k2 * sgn(s).
//   4. Enforce robust finite-time convergence rejecting external lateral disturbance forces.

pub type SlidingModeState = struct {
    integrator_v: Float
};

pub type SlidingModeConfig = struct {
    c1_surface: Float,
    k1_gain: Float,
    k2_gain: Float,
    max_steer: Float
};

pub type SlidingModeOutput = struct {
    steer_cmd: Float,
    sliding_surface_val: Float,
    next_integrator_v: Float
};

pub fn sliding_mode_config_default() -> SlidingModeConfig {
    return SlidingModeConfig {
        c1_surface: 1.5,
        k1_gain: 0.8,
        k2_gain: 0.2,
        max_steer: 0.6
    };
}

pub fn sliding_mode_step(
    ey: Float,
    ey_dot: Float,
    state: &SlidingModeState,
    dt: Float,
    cfg: &SlidingModeConfig
) -> SlidingModeOutput {
    let s: Float = ey_dot + ((cfg).c1_surface * ey);
    let abs_s: Float = if s < 0.0 { 0.0 - s } else { s };
    let sgn_s: Float = if s > 0.001 { 1.0 } else { if s < (0.0 - 0.001) { 0.0 - 1.0 } else { 0.0 } };

    let sqrt_abs_s: Float = sqrt(abs_s);
    let u_prop: Float = (0.0 - (cfg).k1_gain) * sqrt_abs_s * sgn_s;
    let next_v: Float = (state).integrator_v - ((cfg).k2_gain * sgn_s * dt);

    let total_u: Float = u_prop + next_v;
    let clamped_u: Float = if total_u < (0.0 - (cfg).max_steer) {
        0.0 - (cfg).max_steer
    } else {
        if total_u > (cfg).max_steer { (cfg).max_steer } else { total_u }
    };

    return SlidingModeOutput {
        steer_cmd: clamped_u,
        sliding_surface_val: s,
        next_integrator_v: next_v
    };
}
