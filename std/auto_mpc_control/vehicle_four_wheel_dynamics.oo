// # Four-Wheel Planar Vehicle Dynamics & Corner Forces
//
// Logline: Resolves individual wheel velocities, corner slip angles, tire forces, and chassis yaw moments for 4-wheel vehicles.
//
// Setup: Detailed 4-wheel planar vehicle dynamic model (FL, FR, RL, RR) for torque vectoring, stability control, and multi-actuator MPC.
//
// Beats:
//   1. Calculate individual wheel center velocities from chassis translational and rotational speeds.
//   2. Determine independent front left, front right, rear left, and rear right slip angles.
//   3. Sum longitudinal forces, lateral forces, and direct yaw moments acting on the chassis.
//   4. Deliver complete 3-DOF planar equations of motion (Fx, Fy, Mz).

pub type FourWheelGeometry = struct {
    mass: Float,
    inertia_z: Float,
    dist_front: Float,
    dist_rear: Float,
    track_width_f: Float,
    track_width_r: Float
};

pub type FourWheelForces = struct {
    fx_fl: Float,
    fx_fr: Float,
    fx_rl: Float,
    fx_rr: Float,
    fy_fl: Float,
    fy_fr: Float,
    fy_rl: Float,
    fy_rr: Float
};

pub type ChassisAccelerations = struct {
    accel_x: Float,
    accel_y: Float,
    yaw_accel: Float
};

pub fn four_wheel_geometry_default() -> FourWheelGeometry {
    return FourWheelGeometry {
        mass: 1750.0,
        inertia_z: 2800.0,
        dist_front: 1.3,
        dist_rear: 1.5,
        track_width_f: 1.6,
        track_width_r: 1.6
    };
}

pub fn compute_corner_velocities(
    vx: Float,
    vy: Float,
    r: Float,
    geom: &FourWheelGeometry
) -> FourWheelForces {
    let half_wf: Float = (geom).track_width_f * 0.5;
    let half_wr: Float = (geom).track_width_r * 0.5;
    let lf: Float = (geom).dist_front;
    let lr: Float = (geom).dist_rear;

    let vx_fl: Float = vx - (r * half_wf);
    let vy_fl: Float = vy + (r * lf);

    let vx_fr: Float = vx + (r * half_wf);
    let vy_fr: Float = vy + (r * lf);

    let vx_rl: Float = vx - (r * half_wr);
    let vy_rl: Float = vy - (r * lr);

    let vx_rr: Float = vx + (r * half_wr);
    let vy_rr: Float = vy - (r * lr);

    return FourWheelForces {
        fx_fl: vx_fl,
        fx_fr: vx_fr,
        fx_rl: vx_rl,
        fx_rr: vx_rr,
        fy_fl: vy_fl,
        fy_fr: vy_fr,
        fy_rl: vy_rl,
        fy_rr: vy_rr
    };
}

pub fn sum_chassis_forces(
    forces: &FourWheelForces,
    delta_fl: Float,
    delta_fr: Float,
    geom: &FourWheelGeometry
) -> ChassisAccelerations {
    let cos_dfl: Float = cos(delta_fl);
    let sin_dfl: Float = sin(delta_fl);
    let cos_dfr: Float = cos(delta_fr);
    let sin_dfr: Float = sin(delta_fr);

    let half_wf: Float = (geom).track_width_f * 0.5;
    let half_wr: Float = (geom).track_width_r * 0.5;
    let lf: Float = (geom).dist_front;
    let lr: Float = (geom).dist_rear;

    let f_x_fl: Float = ((forces).fx_fl * cos_dfl) - ((forces).fy_fl * sin_dfl);
    let f_y_fl: Float = ((forces).fx_fl * sin_dfl) + ((forces).fy_fl * cos_dfl);

    let f_x_fr: Float = ((forces).fx_fr * cos_dfr) - ((forces).fy_fr * sin_dfr);
    let f_y_fr: Float = ((forces).fx_fr * sin_dfr) + ((forces).fy_fr * cos_dfr);

    let f_x_rl: Float = (forces).fx_rl;
    let f_y_rl: Float = (forces).fy_rl;

    let f_x_rr: Float = (forces).fx_rr;
    let f_y_rr: Float = (forces).fy_rr;

    let total_fx: Float = f_x_fl + f_x_fr + f_x_rl + f_x_rr;
    let total_fy: Float = f_y_fl + f_y_fr + f_y_rl + f_y_rr;

    let moment_z: Float = ((f_x_fr - f_x_fl) * half_wf)
        + ((f_x_rr - f_x_rl) * half_wr)
        + ((f_y_fl + f_y_fr) * lf)
        - ((f_y_rl + f_y_rr) * lr);

    let ax: Float = total_fx / (geom).mass;
    let ay: Float = total_fy / (geom).mass;
    let d_r: Float = moment_z / (geom).inertia_z;

    return ChassisAccelerations {
        accel_x: ax,
        accel_y: ay,
        yaw_accel: d_r
    };
}
