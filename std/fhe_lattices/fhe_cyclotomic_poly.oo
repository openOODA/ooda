// # Power-of-Two Cyclotomic Polynomial Ring Arithmetic
//
// Logline: Implements schoolbook and negacyclic polynomial arithmetic modulo (X^N + 1) for power-of-two lattice rings.
//
// Setup: Core algebraic framework for RLWE, BGV, BFV, and CKKS polynomial coefficient rings.
//
// Beats:
//   1. Define CyclotomicRing and CycloPoly structures.
//   2. Implement negacyclic ring reduction modulo X^N + 1.
//   3. Implement polynomial addition, subtraction, multiplication, and infinity norm calculation.

pub type CyclotomicRing = struct {
    degree_n: Int,
    modulus_q: Int
};

pub type CycloPoly = struct {
    coeffs: List[Int],
    degree_n: Int
};

pub fn cyclotomic_ring_new(n: Int, q: Int) -> CyclotomicRing {
    return CyclotomicRing {
        degree_n: n,
        modulus_q: q
    };
}

pub fn cyclo_poly_zero(n: Int) -> CycloPoly {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        c = list_push(c, 0);
        i = i + 1;
    }
    return CycloPoly {
        coeffs: c,
        degree_n: n
    };
}

pub fn cyclo_poly_add(a: &CycloPoly, b: &CycloPoly, q: Int) -> CycloPoly {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let va: Int = list_get(a.coeffs, i);
        let vb: Int = list_get(b.coeffs, i);
        out = list_push(out, (va + vb) % q);
        i = i + 1;
    }
    return CycloPoly {
        coeffs: out,
        degree_n: a.degree_n
    };
}

pub fn cyclo_poly_sub(a: &CycloPoly, b: &CycloPoly, q: Int) -> CycloPoly {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let va: Int = list_get(a.coeffs, i);
        let vb: Int = list_get(b.coeffs, i);
        let mut diff: Int = (va - vb) % q;
        if diff < 0 {
            diff = diff + q;
        }
        out = list_push(out, diff);
        i = i + 1;
    }
    return CycloPoly {
        coeffs: out,
        degree_n: a.degree_n
    };
}

pub fn cyclo_poly_mul_schoolbook_negacyclic(a: &CycloPoly, b: &CycloPoly, q: Int) -> CycloPoly {
    let n: Int = a.degree_n;
    let mut prod: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        prod = list_push(prod, 0);
        k = k + 1;
    }
    let mut i: Int = 0;
    while i < n {
        let va: Int = list_get(a.coeffs, i);
        let mut j: Int = 0;
        while j < n {
            let vb: Int = list_get(b.coeffs, j);
            let term: Int = (va * vb) % q;
            let idx: Int = i + j;
            if idx < n {
                let cur: Int = list_get(prod, idx);
                prod = list_set(prod, idx, (cur + term) % q);
            } else {
                let red_idx: Int = idx - n;
                let cur: Int = list_get(prod, red_idx);
                let mut updated: Int = (cur - term) % q;
                if updated < 0 {
                    updated = updated + q;
                }
                prod = list_set(prod, red_idx, updated);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return CycloPoly {
        coeffs: prod,
        degree_n: n
    };
}
