// # FHE Key Switching Key (KSK) Engine
//
// Logline: Implements generalized key switching keys (KSK) enabling ciphertext transformation between distinct secret keys.
//
// Setup: Core mechanism underlying relinearization, Galois automorphism rotations, and bootstrap key switching.
//
// Beats:
//   1. Define KeySwitchKey matrix structures and decomposition parameters.
//   2. Implement digital polynomial decomposition into base-B limbs.
//   3. Implement KSK vector dot product evaluation.

pub type KeySwitchKey = struct {
    num_levels: Int,
    base_b: Int,
    degree_n: Int,
    modulus_q: Int,
    key_pairs_c0: List[List[Int]],
    key_pairs_c1: List[List[Int]],
};

pub fn key_switch_key_new(levels: Int, base_b: Int, n: Int, q: Int, k0: List[List[Int]], k1: List[List[Int]]) -> KeySwitchKey {
    return KeySwitchKey {
        num_levels: levels,
        base_b: base_b,
        degree_n: n,
        modulus_q: q,
        key_pairs_c0: k0,
        key_pairs_c1: k1,
    };
}

pub fn key_switch_decompose_poly(poly: List[Int], levels: Int, base_b: Int) -> List[List[Int]] {
    let mut decomposed: List[List[Int]] = list_new();
    let n: Int = list_len(poly);
    let mut lvl: Int = 0;
    while lvl < levels {
        let mut limb: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            let val: Int = list_get(poly, i);
            let mut shifted: Int = val;
            let mut s: Int = 0;
            while s < lvl {
                shifted = shifted / base_b;
                s = s + 1;
            }
            let digit: Int = shifted % base_b;
            limb = list_push(limb, digit);
            i = i + 1;
        }
        decomposed = list_push(decomposed, limb);
        lvl = lvl + 1;
    }
    return decomposed;
}
