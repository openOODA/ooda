// # Montgomery and Barrett Modular Arithmetic
//
// Logline: Implements Montgomery space transformations, constant-time REDC reductions, and Barrett fast division shims.
//
// Setup: Low-level modular arithmetic acceleration for high-throughput FHE evaluation keys and NTT engines.
//
// Beats:
//   1. Define Montgomery context with precomputed reduction constants.
//   2. Implement Montgomery forward/inverse transformation and REDC reduction.
//   3. Implement Barrett reduction for arbitrary non-power-of-two prime moduli.

pub type MontgomeryContext = struct {
    modulus_q: Int,
    r_val: Int,
    r_inv: Int,
    q_inv_neg: Int,
    is_valid: Bool
};

pub fn montgomery_init(q: Int, r: Int, r_inv: Int, q_inv_neg: Int) -> MontgomeryContext {
    return MontgomeryContext {
        modulus_q: q,
        r_val: r,
        r_inv: r_inv,
        q_inv_neg: q_inv_neg,
        is_valid: true
    };
}

pub fn montgomery_to_form(x: Int, ctx: &MontgomeryContext) -> Int {
    return (x * ctx.r_val) % ctx.modulus_q;
}

pub fn montgomery_from_form(x_mont: Int, ctx: &MontgomeryContext) -> Int {
    return (x_mont * ctx.r_inv) % ctx.modulus_q;
}

pub fn montgomery_reduce(t: Int, ctx: &MontgomeryContext) -> Int {
    let m: Int = ((t % ctx.r_val) * ctx.q_inv_neg) % ctx.r_val;
    let mut res: Int = (t + m * ctx.modulus_q) / ctx.r_val;
    if res >= ctx.modulus_q {
        res = res - ctx.modulus_q;
    }
    return res;
}

pub fn montgomery_mul(a_mont: Int, b_mont: Int, ctx: &MontgomeryContext) -> Int {
    let t: Int = a_mont * b_mont;
    return montgomery_reduce(t, ctx);
}

pub fn barrett_reduce(a: Int, q: Int, mu: Int, k_shift: Int) -> Int {
    let q_approx: Int = (a * mu) >> k_shift;
    let mut rem: Int = a - q_approx * q;
    while rem >= q {
        rem = rem - q;
    }
    while rem < 0 {
        rem = rem + q;
    }
    return rem;
}
