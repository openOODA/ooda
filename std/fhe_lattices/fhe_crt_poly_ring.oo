// # Chinese Remainder Theorem (RNS/CRT) Polynomial Ring
//
// Logline: Implements Residue Number System (RNS) multi-prime polynomial representations and base extensions for multi-word FHE arithmetic.
//
// Setup: Bridges large cryptographic coefficient moduli into hardware-friendly 64-bit limbs.
//
// Beats:
//   1. Define RnsPolyRing and multi-limb RnsPolynomial structures.
//   2. Implement RNS polynomial addition, subtraction, and scalar multiplication.
//   3. Implement RNS base extension and limb conversion primitives.

pub type RnsPolyRing = struct {
    degree_n: Int,
    num_moduli: Int,
    moduli: List[Int]
};

pub type RnsPolynomial = struct {
    degree_n: Int,
    num_moduli: Int,
    coeffs: List[List[Int]]
};

pub fn rns_poly_ring_new(degree: Int, moduli: List[Int]) -> RnsPolyRing {
    return RnsPolyRing {
        degree_n: degree,
        num_moduli: list_len(moduli),
        moduli: moduli
    };
}

pub fn rns_poly_new(degree: Int, num_moduli: Int) -> RnsPolynomial {
    let mut table: List[List[Int]] = list_new();
    let mut m_idx: Int = 0;
    while m_idx < num_moduli {
        let mut limb: List[Int] = list_new();
        let mut i: Int = 0;
        while i < degree {
            limb = list_push(limb, 0);
            i = i + 1;
        }
        table = list_push(table, limb);
        m_idx = m_idx + 1;
    }
    return RnsPolynomial {
        degree_n: degree,
        num_moduli: num_moduli,
        coeffs: table
    };
}

pub fn rns_poly_add(a: &RnsPolynomial, b: &RnsPolynomial, ring: &RnsPolyRing) -> RnsPolynomial {
    let mut out_table: List[List[Int]] = list_new();
    let mut m_idx: Int = 0;
    while m_idx < ring.num_moduli {
        let q_i: Int = list_get(ring.moduli, m_idx);
        let a_limb: List[Int] = list_get(a.coeffs, m_idx);
        let b_limb: List[Int] = list_get(b.coeffs, m_idx);
        let mut sum_limb: List[Int] = list_new();
        let mut i: Int = 0;
        while i < ring.degree_n {
            let va: Int = list_get(a_limb, i);
            let vb: Int = list_get(b_limb, i);
            sum_limb = list_push(sum_limb, (va + vb) % q_i);
            i = i + 1;
        }
        out_table = list_push(out_table, sum_limb);
        m_idx = m_idx + 1;
    }
    return RnsPolynomial {
        degree_n: ring.degree_n,
        num_moduli: ring.num_moduli,
        coeffs: out_table
    };
}

pub fn rns_base_extend_step(val_mod_qi: Int, qi: Int, q_target: Int, inv_qi_target: Int) -> Int {
    let norm_val: Int = (val_mod_qi * inv_qi_target) % q_target;
    if norm_val < 0 {
        return norm_val + q_target;
    }
    return norm_val;
}
