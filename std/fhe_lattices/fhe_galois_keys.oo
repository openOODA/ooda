// # Galois Keys & Homomorphic Slot Rotations
//
// Logline: Implements Galois rotation evaluation keys (GaloisKey) enabling cyclic shifts of packed SIMD plaintext slots.
//
// Setup: Essential for matrix multiplications, neural network convolutions, and parallel vector algorithms in FHE.
//
// Beats:
//   1. Define GaloisKey structure associated with automorphism generator sigma_k.
//   2. Implement slot rotation key generation and evaluation routines.
//   3. Implement complex slot conjugation via sigma_{-1}.

pub type GaloisKey = struct {
    galois_element_k: Int,
    degree_n: Int,
    modulus_q: Int,
    key_c0: List[List[Int]],
    key_c1: List[List[Int]],
};

pub fn galois_key_new(k: Int, n: Int, q: Int, k0: List[List[Int]], k1: List[List[Int]]) -> GaloisKey {
    return GaloisKey {
        galois_element_k: k,
        degree_n: n,
        modulus_q: q,
        key_c0: k0,
        key_c1: k1,
    };
}

pub fn galois_key_conjugation_element(n: Int) -> Int {
    return 2 * n - 1;
}

pub fn galois_key_rotation_step_element(step: Int, n: Int) -> Int {
    let mut g: Int = 5;
    let mut i: Int = 0;
    let mut res: Int = 1;
    while i < step {
        res = (res * g) % (2 * n);
        i = i + 1;
    }
    return res;
}
