// # Ternary & Sparse Secret Sampler
//
// Logline: Generates sparse and uniform ternary secret polynomials over {-1, 0, 1}^N with fixed Hamming weight constraints.
//
// Setup: Minimizes key-switching noise and computational complexity in BGV/BFV/CKKS key generation.
//
// Beats:
//   1. Define TernarySampler and Hamming weight bounds.
//   2. Implement uniform ternary random sampling.
//   3. Implement fixed Hamming weight sparse secret vector sampling.

pub type TernarySampler = struct {
    degree_n: Int,
    hamming_weight: Int,
    seed: Int,
};

pub fn ternary_sampler_new(n: Int, h: Int, seed: Int) -> TernarySampler {
    return TernarySampler {
        degree_n: n,
        hamming_weight: h,
        seed: seed,
    };
}

pub fn ternary_sample_uniform(sampler: &mut TernarySampler) -> List[Int] {
    let mut vec: List[Int] = list_new();
    let mut i: Int = 0;
    while i < sampler.degree_n {
        sampler.seed = (sampler.seed * 1103515245 + 12345) & 2147483647;
        let choice: Int = (sampler.seed >> 16) % 3;
        let val: Int = choice - 1;
        vec = list_push(vec, val);
        i = i + 1;
    }
    return vec;
}

pub fn ternary_count_nonzeros(vec: List[Int]) -> Int {
    let mut count: Int = 0;
    let mut i: Int = 0;
    let len_v: Int = list_len(vec);
    while i < len_v {
        let v: Int = list_get(vec, i);
        if v != 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn ternary_dot_product(a: List[Int], b: List[Int]) -> Int {
    let mut sum_v: Int = 0;
    let mut i: Int = 0;
    let len_v: Int = list_len(a);
    while i < len_v {
        sum_v = sum_v + list_get(a, i) * list_get(b, i);
        i = i + 1;
    }
    return sum_v;
}
