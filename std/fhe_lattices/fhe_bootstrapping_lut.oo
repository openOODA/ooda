// # Programmable Bootstrapping Look-Up Tables (LUT)
//
// Logline: Implements programmable bootstrapping Look-Up Tables (LUT) and test vector polynomial initializations.
//
// Setup: Enables homomorphic evaluation of arbitrary Boolean and integer truth tables in a single bootstrap step.
//
// Beats:
//   1. Define BootstrappingLut and test polynomial encoding structures.
//   2. Encode discrete functions (LUT) into anti-cyclic Torus polynomials.
//   3. Evaluate gate output phases from test vector polynomials.

pub type BootstrappingLut = struct {
    degree_n: Int,
    lut_values: List[Int],
    scale_factor: Float
};

pub fn bootstrapping_lut_new(n: Int, values: List[Int], scale: Float) -> BootstrappingLut {
    return BootstrappingLut {
        degree_n: n,
        lut_values: values,
        scale_factor: scale
    };
}

pub fn bootstrapping_lut_encode_poly(lut: &BootstrappingLut) -> List[Float] {
    let mut poly: List[Float] = list_new();
    let num_v: Int = list_len(lut.lut_values);
    let mut i: Int = 0;
    while i < lut.degree_n {
        let v_idx: Int = (i * num_v) / lut.degree_n;
        let v: Int = list_get(lut.lut_values, v_idx);
        let torus_val: Float = (v as Float) * lut.scale_factor;
        poly = list_push(poly, torus_val);
        i = i + 1;
    }
    return poly;
}
