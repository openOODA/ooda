// # FHE Number Theoretic Transform (NTT) Polynomial Arithmetic
//
// Logline: Implements Cooley-Tukey and Gentleman-Sande NTT butterflies, bit-reversal permutations, and fast negacyclic ring arithmetic over Z_q[X]/(X^N + 1).
//
// Setup: Core algebraic building block for homomorphic lattice operations and polynomial multiplications.
//
// Beats:
//   1. Define NTT context configuration and twiddle factor precomputations.
//   2. Provide forward Cooley-Tukey and inverse Gentleman-Sande butterfly transformations.
//   3. Implement pointwise modular multiplication in the NTT domain.

pub type NttContext = struct {
    ring_degree_n: Int,
    modulus_q: Int,
    root_of_unity: Int,
    inv_degree_n: Int,
    is_ready: Bool,
};

pub fn ntt_context_new(n: Int, q: Int, root: Int, inv_n: Int) -> NttContext {
    return NttContext {
        ring_degree_n: n,
        modulus_q: q,
        root_of_unity: root,
        inv_degree_n: inv_n,
        is_ready: true,
    };
}

pub fn ntt_butterfly_ct(a: Int, b: Int, twiddle: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let t: Int = (b * twiddle) % q;
    let mut u0: Int = (a + t) % q;
    let mut u1: Int = (a - t) % q;
    if u1 < 0 {
        u1 = u1 + q;
    }
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn ntt_butterfly_gs(a: Int, b: Int, twiddle: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let u0: Int = (a + b) % q;
    let mut diff: Int = (a - b) % q;
    if diff < 0 {
        diff = diff + q;
    }
    let u1: Int = (diff * twiddle) % q;
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn ntt_bit_reverse(val: Int, bits: Int) -> Int {
    let mut res: Int = 0;
    let mut v: Int = val;
    let mut i: Int = 0;
    while i < bits {
        res = (res << 1) | (v & 1);
        v = v >> 1;
        i = i + 1;
    }
    return res;
}

pub fn ntt_pointwise_multiply(poly_a: List[Int], poly_b: List[Int], q: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let len_a: Int = list_len(poly_a);
    let mut i: Int = 0;
    while i < len_a {
        let va: Int = list_get(poly_a, i);
        let vb: Int = list_get(poly_b, i);
        let prod: Int = (va * vb) % q;
        out = list_push(out, prod);
        i = i + 1;
    }
    return out;
}

pub fn ntt_pointwise_add(poly_a: List[Int], poly_b: List[Int], q: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let len_a: Int = list_len(poly_a);
    let mut i: Int = 0;
    while i < len_a {
        let va: Int = list_get(poly_a, i);
        let vb: Int = list_get(poly_b, i);
        let sum_v: Int = (va + vb) % q;
        out = list_push(out, sum_v);
        i = i + 1;
    }
    return out;
}
