// # Torus LWE (TLWE) Ciphertexts & Phase Extraction
//
// Logline: Implements TLWE ciphertexts over the real Torus T = R / Z, Torus addition, scalar multiplication, and phase extraction.
//
// Setup: Mathematical cornerstone of the TFHE fast bootstrapping and gate-by-gate evaluation architecture.
//
// Beats:
//   1. Define TorusTlweCiphertext with floating-point Torus coordinates in [0, 1).
//   2. Implement Torus modulo 1 arithmetic (x mod 1.0).
//   3. Implement TLWE addition, integer scalar multiplication, and phase decryption.

pub type TorusTlweCiphertext = struct {
    a_vector: List[Float],
    b_val: Float,
    dimension_n: Int,
};

pub fn torus_mod1(x: Float) -> Float {
    let mut v: Float = x;
    while v >= 1.0 {
        v = v - 1.0;
    }
    while v < 0.0 {
        v = v + 1.0;
    }
    return v;
}

pub fn torus_tlwe_new(a: List[Float], b: Float, n: Int) -> TorusTlweCiphertext {
    return TorusTlweCiphertext {
        a_vector: a,
        b_val: torus_mod1(b),
        dimension_n: n,
    };
}

pub fn torus_tlwe_add(a: &TorusTlweCiphertext, b: &TorusTlweCiphertext) -> TorusTlweCiphertext {
    let mut new_a: List[Float] = list_new();
    let mut i: Int = 0;
    while i < a.dimension_n {
        let va: Float = list_get(a.a_vector, i);
        let vb: Float = list_get(b.a_vector, i);
        new_a = list_push(new_a, torus_mod1(va + vb));
        i = i + 1;
    }
    let new_b: Float = torus_mod1(a.b_val + b.b_val);
    return TorusTlweCiphertext {
        a_vector: new_a,
        b_val: new_b,
        dimension_n: a.dimension_n,
    };
}

pub fn torus_tlwe_phase(ct: &TorusTlweCiphertext, sk: List[Int]) -> Float {
    let mut dot: Float = 0.0;
    let mut i: Int = 0;
    while i < ct.dimension_n {
        let s_i: Int = list_get(sk, i);
        let a_i: Float = list_get(ct.a_vector, i);
        dot = dot + (s_i as Float) * a_i;
        i = i + 1;
    }
    return torus_mod1(ct.b_val - dot);
}
