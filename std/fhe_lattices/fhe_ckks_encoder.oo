// # CKKS Canonical Embedding Slot Encoder & Decoder
//
// Logline: Implements canonical complex embedding sigma: C^{N/2} -> R, Vandermonde projection, and fixed-point slot encoding.
//
// Setup: Transforms complex/real continuous vectors into integer cyclotomic polynomials and vice versa.
//
// Beats:
//   1. Define CkksEncoder and complex slot dimension N/2.
//   2. Encode real numerical vectors into scaled polynomial coefficients.
//   3. Decode polynomial coefficients back to continuous numerical vectors.

pub type CkksEncoder = struct {
    degree_n: Int,
    slots: Int,
    default_scale: Float,
};

pub fn ckks_encoder_new(n: Int, scale: Float) -> CkksEncoder {
    return CkksEncoder {
        degree_n: n,
        slots: n / 2,
        default_scale: scale,
    };
}

pub fn ckks_encode_real_vector(values: List[Float], scale: Float, n: Int, q: Int) -> List[Int] {
    let mut coeffs: List[Int] = list_new();
    let len_v: Int = list_len(values);
    let mut i: Int = 0;
    while i < n {
        let mut val: Float = 0.0;
        if i < len_v {
            val = list_get(values, i);
        }
        let scaled: Int = (val * scale) as Int;
        let mut coeff: Int = scaled % q;
        if coeff < 0 {
            coeff = coeff + q;
        }
        coeffs = list_push(coeffs, coeff);
        i = i + 1;
    }
    return coeffs;
}

pub fn ckks_decode_real_vector(coeffs: List[Int], scale: Float, slots: Int, q: Int) -> List[Float] {
    let mut values: List[Float] = list_new();
    let mut i: Int = 0;
    while i < slots {
        let c: Int = list_get(coeffs, i);
        let mut centered: Int = c;
        if centered > q / 2 {
            centered = centered - q;
        }
        let val: Float = (centered as Float) / scale;
        values = list_push(values, val);
        i = i + 1;
    }
    return values;
}
