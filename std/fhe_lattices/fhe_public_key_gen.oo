// # Asymmetric Public Key Generation & Zero-Encryption
//
// Logline: Generates asymmetric public keys pk = (-(a*s + e), a) and performs public key zero-encryptions for BGV/BFV/CKKS.
//
// Setup: Asymmetric key infrastructure for client-server outsourced computation models.
//
// Beats:
//   1. Define PublicKey pair structures over cyclotomic polynomial rings.
//   2. Implement public key generation from secret keys and Gaussian noise.
//   3. Implement public key validation and zero-encryption primitive.

pub type PublicKey = struct {
    pk0: List[Int],
    pk1: List[Int],
    degree_n: Int,
    modulus_q: Int
};

pub fn public_key_new(pk0: List[Int], pk1: List[Int], n: Int, q: Int) -> PublicKey {
    return PublicKey {
        pk0: pk0,
        pk1: pk1,
        degree_n: n,
        modulus_q: q
    };
}

pub fn public_key_validate(pk: &PublicKey) -> Bool {
    if list_len(pk.pk0) != pk.degree_n {
        return false;
    }
    if list_len(pk.pk1) != pk.degree_n {
        return false;
    }
    return true;
}
