// # Module-LWE (MLWE) Rank-k Lattice Ciphertext
//
// Logline: Implements Module-LWE vectors and matrix structures (u_vector, v_poly) for rank-k lattice encryption.
//
// Setup: Bridges standard scalar LWE and single-polynomial Ring-LWE for flexible security tradeoffs.
//
// Beats:
//   1. Define ModuleLweCiphertext rank-k polynomial vector structures.
//   2. Implement Module-LWE vector addition and inner products.
//   3. Implement Module-LWE polynomial decryption.

pub type ModuleLweCiphertext = struct {
    rank_k: Int,
    degree_n: Int,
    modulus_q: Int,
    u_vector: List[List[Int]],
    v_poly: List[Int],
};

pub fn module_lwe_ciphertext_new(rank: Int, n: Int, q: Int, u: List[List[Int]], v: List[Int]) -> ModuleLweCiphertext {
    return ModuleLweCiphertext {
        rank_k: rank,
        degree_n: n,
        modulus_q: q,
        u_vector: u,
        v_poly: v,
    };
}

pub fn module_lwe_add(a: &ModuleLweCiphertext, b: &ModuleLweCiphertext) -> ModuleLweCiphertext {
    let mut new_u: List[List[Int]] = list_new();
    let mut r: Int = 0;
    while r < a.rank_k {
        let row_a: List[Int] = list_get(a.u_vector, r);
        let row_b: List[Int] = list_get(b.u_vector, r);
        let mut row_sum: List[Int] = list_new();
        let mut i: Int = 0;
        while i < a.degree_n {
            let sum_val: Int = (list_get(row_a, i) + list_get(row_b, i)) % a.modulus_q;
            row_sum = list_push(row_sum, sum_val);
            i = i + 1;
        }
        new_u = list_push(new_u, row_sum);
        r = r + 1;
    }
    let mut new_v: List[Int] = list_new();
    let mut j: Int = 0;
    while j < a.degree_n {
        let v_val: Int = (list_get(a.v_poly, j) + list_get(b.v_poly, j)) % a.modulus_q;
        new_v = list_push(new_v, v_val);
        j = j + 1;
    }
    return ModuleLweCiphertext {
        rank_k: a.rank_k,
        degree_n: a.degree_n,
        modulus_q: a.modulus_q,
        u_vector: new_u,
        v_poly: new_v,
    };
}
