// # Standard FHE Parameter Set Presets
//
// Logline: Provides standard HomomorphicEncryption.org compliant parameter presets for Toy, 128-bit, 192-bit, 256-bit, and deep CKKS pipelines.
//
// Setup: Central parameter catalog ensuring correct ring dimension and modulus bit choices.
//
// Beats:
//   1. Define FheParameterSet configuration descriptors.
//   2. Provide standard 128-bit, 192-bit, and 256-bit secure presets.
//   3. Provide fast toy testing and deep CKKS bootstrapping configurations.

pub type FheParameterSet = struct {
    preset_name: String,
    ring_degree_n: Int,
    total_modulus_bits: Int,
    plaintext_modulus_t: Int,
    security_bits: Int
};

pub fn fhe_param_toy_test() -> FheParameterSet {
    return FheParameterSet {
        preset_name: "TOY_TEST_PARAMS",
        ring_degree_n: 1024,
        total_modulus_bits: 27,
        plaintext_modulus_t: 65537,
        security_bits: 0
    };
}

pub fn fhe_param_128_bit_secure() -> FheParameterSet {
    return FheParameterSet {
        preset_name: "HE_STD_128BIT_N8192",
        ring_degree_n: 8192,
        total_modulus_bits: 218,
        plaintext_modulus_t: 65537,
        security_bits: 128
    };
}

pub fn fhe_param_256_bit_secure() -> FheParameterSet {
    return FheParameterSet {
        preset_name: "HE_STD_256BIT_N16384",
        ring_degree_n: 16384,
        total_modulus_bits: 218,
        plaintext_modulus_t: 65537,
        security_bits: 256
    };
}

pub fn fhe_param_ckks_deep_pipeline() -> FheParameterSet {
    return FheParameterSet {
        preset_name: "CKKS_DEEP_BOOTSTRAP_N32768",
        ring_degree_n: 32768,
        total_modulus_bits: 880,
        plaintext_modulus_t: 0,
        security_bits: 128
    };
}
