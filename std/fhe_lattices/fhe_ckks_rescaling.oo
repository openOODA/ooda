// # CKKS Rescaling & Scale Stabilization
//
// Logline: Implements CKKS Rescale operation dividing ciphertext by prime q_l to maintain invariant scale Delta after multiplication.
//
// Setup: Prevents precision scaling explosion Delta^2 -> Delta across deep arithmetic circuits.
//
// Beats:
//   1. Define CkksRescaleEngine and modulus transition primes.
//   2. Implement coefficient division and rounding c' = round(c / q_l).
//   3. Implement polynomial rescaling and level decrementing.

pub type CkksRescaleEngine = struct {
    modulus_drop_q: Int,
    current_scale: Float,
    target_scale: Float,
};

pub fn ckks_rescale_engine_new(mod_drop: Int, cur_scale: Float, tgt_scale: Float) -> CkksRescaleEngine {
    return CkksRescaleEngine {
        modulus_drop_q: mod_drop,
        current_scale: cur_scale,
        target_scale: tgt_scale,
    };
}

pub fn ckks_rescale_coeff(coeff: Int, q_prime: Int) -> Int {
    return (coeff + q_prime / 2) / q_prime;
}

pub fn ckks_rescale_poly(poly: List[Int], engine: &CkksRescaleEngine) -> List[Int] {
    let mut out: List[Int] = list_new();
    let len_p: Int = list_len(poly);
    let mut i: Int = 0;
    while i < len_p {
        let c: Int = list_get(poly, i);
        let rescaled: Int = ckks_rescale_coeff(c, engine.modulus_drop_q);
        out = list_push(out, rescaled);
        i = i + 1;
    }
    return out;
}
