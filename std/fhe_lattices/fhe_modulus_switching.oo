// # FHE Modulus Switching & Noise Reduction
//
// Logline: Implements ModSwitch transformation c' = round(Q' / Q * c) mod Q' reducing noise variance by (Q'/Q)^2.
//
// Setup: Fundamental noise management technique in BGV and CKKS leveled computation chains.
//
// Beats:
//   1. Define ModSwitchEngine context and modulus transitions.
//   2. Implement coefficient-wise scaling and rounding modulo plaintext constraint t.
//   3. Compute theoretical noise reduction ratios.

pub type ModSwitchEngine = struct {
    q_initial: Int,
    q_target: Int,
    plaintext_t: Int,
};

pub fn mod_switch_engine_new(q_init: Int, q_tgt: Int, t: Int) -> ModSwitchEngine {
    return ModSwitchEngine {
        q_initial: q_init,
        q_target: q_tgt,
        plaintext_t: t,
    };
}

pub fn mod_switch_scale_coeff(coeff: Int, q_init: Int, q_tgt: Int, t: Int) -> Int {
    let scaled: Int = (coeff * q_tgt + q_init / 2) / q_init;
    let mut rem: Int = scaled % q_tgt;
    if rem < 0 {
        rem = rem + q_tgt;
    }
    return rem;
}

pub fn mod_switch_poly(poly: List[Int], engine: &ModSwitchEngine) -> List[Int] {
    let mut out: List[Int] = list_new();
    let len_p: Int = list_len(poly);
    let mut i: Int = 0;
    while i < len_p {
        let c: Int = list_get(poly, i);
        let switched: Int = mod_switch_scale_coeff(c, engine.q_initial, engine.q_target, engine.plaintext_t);
        out = list_push(out, switched);
        i = i + 1;
    }
    return out;
}

pub fn mod_switch_noise_reduction_factor(q_init: Int, q_tgt: Int) -> Float {
    let r: Float = (q_tgt as Float) / (q_init as Float);
    return r * r;
}
