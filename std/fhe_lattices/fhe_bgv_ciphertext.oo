// # BGV Leveled Ciphertext Structure & Arithmetic
//
// Logline: Implements BGV (Brakerski-Gentry-Vaikuntanathan) ciphertext formats, scale factor t, modulus chain levels, and addition/subtraction.
//
// Setup: Exact integer homomorphic encryption with leveled modulus switching noise management.
//
// Beats:
//   1. Define BgvCiphertext structure with level tracking and plaintext modulus t.
//   2. Implement BGV homomorphic addition and subtraction.
//   3. Implement BGV plaintext polynomial addition and scalar multiplication.

pub type BgvCiphertext = struct {
    c0: List[Int],
    c1: List[Int],
    degree_n: Int,
    modulus_q: Int,
    plaintext_t: Int,
    level: Int
};

pub fn bgv_ciphertext_new(c0: List[Int], c1: List[Int], n: Int, q: Int, t: Int, level: Int) -> BgvCiphertext {
    return BgvCiphertext {
        c0: c0,
        c1: c1,
        degree_n: n,
        modulus_q: q,
        plaintext_t: t,
        level: level
    };
}

pub fn bgv_add(a: &BgvCiphertext, b: &BgvCiphertext) -> BgvCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut out_c1: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let v0: Int = (list_get(a.c0, i) + list_get(b.c0, i)) % a.modulus_q;
        let v1: Int = (list_get(a.c1, i) + list_get(b.c1, i)) % a.modulus_q;
        out_c0 = list_push(out_c0, v0);
        out_c1 = list_push(out_c1, v1);
        i = i + 1;
    }
    return BgvCiphertext {
        c0: out_c0,
        c1: out_c1,
        degree_n: a.degree_n,
        modulus_q: a.modulus_q,
        plaintext_t: a.plaintext_t,
        level: a.level
    };
}

pub fn bgv_add_plain(ct: &BgvCiphertext, pt: List[Int]) -> BgvCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut i: Int = 0;
    while i < ct.degree_n {
        let mut pt_val: Int = 0;
        if i < list_len(pt) {
            pt_val = list_get(pt, i);
        }
        let v0: Int = (list_get(ct.c0, i) + pt_val) % ct.modulus_q;
        out_c0 = list_push(out_c0, v0);
        i = i + 1;
    }
    return BgvCiphertext {
        c0: out_c0,
        c1: ct.c1,
        degree_n: ct.degree_n,
        modulus_q: ct.modulus_q,
        plaintext_t: ct.plaintext_t,
        level: ct.level
    };
}
