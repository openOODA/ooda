// # Ciphertext Relinearization Keys (RelinKey)
//
// Logline: Implements degree-2 to degree-1 ciphertext relinearization reducing quadratic tensor products back to linear ciphertexts.
//
// Setup: Prevents exponential ciphertext size explosion during homomorphic multiplication.
//
// Beats:
//   1. Define RelinKey evaluation key matrices.
//   2. Compute degree-2 tensor product expansion (c0, c1) * (d0, d1) -> (e0, e1, e2).
//   3. Implement relinearization key evaluation and modulus reduction.

pub type RelinKey = struct {
    degree_n: Int,
    modulus_q: Int,
    num_windows: Int,
    keys_c0: List[List[Int]],
    keys_c1: List[List[Int]],
};

pub fn relin_key_new(n: Int, q: Int, windows: Int, k0: List[List[Int]], k1: List[List[Int]]) -> RelinKey {
    return RelinKey {
        degree_n: n,
        modulus_q: q,
        num_windows: windows,
        keys_c0: k0,
        keys_c1: k1,
    };
}

pub fn relin_tensor_multiply_scalars(c0_a: Int, c1_a: Int, c0_b: Int, c1_b: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let d0: Int = (c0_a * c0_b) % q;
    let d1: Int = (c0_a * c1_b + c1_a * c0_b) % q;
    let d2: Int = (c1_a * c1_b) % q;
    res = list_push(res, d0);
    res = list_push(res, d1);
    res = list_push(res, d2);
    return res;
}
