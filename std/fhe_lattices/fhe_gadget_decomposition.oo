// # Gadget Vector Decomposition & Signed Digits
//
// Logline: Implements digital gadget vectors g = (1, B, B^2, ...) and signed-digit decomposition for noise-controlled key switching.
//
// Setup: Fundamental decomposition mechanism for TRGSW, KSK, and GSW external products.
//
// Beats:
//   1. Define GadgetDecomposition context and digit base parameters.
//   2. Implement signed-digit scalar and polynomial decomposition.
//   3. Implement gadget vector reconstruction and error bounds.

pub type GadgetDecomposition = struct {
    base_b: Int,
    num_digits_d: Int,
    modulus_q: Int
};

pub fn gadget_decomposition_new(base: Int, digits: Int, q: Int) -> GadgetDecomposition {
    return GadgetDecomposition {
        base_b: base,
        num_digits_d: digits,
        modulus_q: q
    };
}

pub fn gadget_decompose_scalar(val: Int, gadget: &GadgetDecomposition) -> List[Int] {
    let mut digits: List[Int] = list_new();
    let mut cur: Int = val;
    let mut i: Int = 0;
    while i < gadget.num_digits_d {
        let d: Int = cur % gadget.base_b;
        digits = list_push(digits, d);
        cur = cur / gadget.base_b;
        i = i + 1;
    }
    return digits;
}

pub fn gadget_reconstruct_scalar(digits: List[Int], gadget: &GadgetDecomposition) -> Int {
    let mut sum_v: Int = 0;
    let mut weight: Int = 1;
    let mut i: Int = 0;
    let len_d: Int = list_len(digits);
    while i < len_d {
        let d: Int = list_get(digits, i);
        sum_v = (sum_v + d * weight) % gadget.modulus_q;
        weight = (weight * gadget.base_b) % gadget.modulus_q;
        i = i + 1;
    }
    return sum_v;
}
