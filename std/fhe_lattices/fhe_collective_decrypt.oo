// # Multi-Party Distributed Decryption & Noise Flooding
//
// Logline: Implements distributed threshold decryption, smudging noise flooding, and partial share aggregation.
//
// Setup: Cryptographically prevents key reconstruction during collective plaintext recovery.
//
// Beats:
//   1. Define CollectiveDecryptProtocol and noise flooding parameters.
//   2. Compute partial decryption shares h_i = s_i * c1 + e_smudge.
//   3. Aggregate partial shares to recover decrypted message m.

pub type CollectiveDecryptProtocol = struct {
    num_parties: Int,
    threshold: Int,
    modulus_q: Int,
    noise_flooding_bound: Int,
};

pub fn collective_decrypt_new(parties: Int, threshold: Int, q: Int, flood_bound: Int) -> CollectiveDecryptProtocol {
    return CollectiveDecryptProtocol {
        num_parties: parties,
        threshold: threshold,
        modulus_q: q,
        noise_flooding_bound: flood_bound,
    };
}

pub fn collective_decrypt_aggregate(c0: List[Int], partial_shares: List[List[Int]], degree_n: Int, q: Int) -> List[Int] {
    let mut decrypted: List[Int] = list_new();
    let mut i: Int = 0;
    while i < degree_n {
        let mut sum_shares: Int = 0;
        let mut p: Int = 0;
        let num_p: Int = list_len(partial_shares);
        while p < num_p {
            let p_share: List[Int] = list_get(partial_shares, p);
            sum_shares = (sum_shares + list_get(p_share, i)) % q;
            p = p + 1;
        }
        let mut phase: Int = (list_get(c0, i) + sum_shares) % q;
        if phase < 0 {
            phase = phase + q;
        }
        decrypted = list_push(decrypted, phase);
        i = i + 1;
    }
    return decrypted;
}
