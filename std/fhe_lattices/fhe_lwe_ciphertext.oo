// # Learning With Errors (LWE) Ciphertext Arithmetic
//
// Logline: Implements standard LWE ciphertext tuples (a, b) in Z_q^n x Z_q, symmetric encryption, decryption, and phase extraction.
//
// Setup: Core primitive for TFHE/FHEW word-level logic gates and bootstrapping input states.
//
// Beats:
//   1. Define LweCiphertext and LweSecretKey structures.
//   2. Implement LWE encryption, decryption, and phase evaluation.
//   3. Implement homomorphic addition and scalar multiplication on LWE ciphertexts.

pub type LweCiphertext = struct {
    a_vector: List[Int],
    b_scalar: Int,
    dimension_n: Int,
    modulus_q: Int,
};

pub fn lwe_ciphertext_new(a: List[Int], b: Int, n: Int, q: Int) -> LweCiphertext {
    return LweCiphertext {
        a_vector: a,
        b_scalar: b,
        dimension_n: n,
        modulus_q: q,
    };
}

pub fn lwe_encrypt(secret_key: List[Int], message: Int, scale_delta: Int, error: Int, a_rand: List[Int], q: Int) -> LweCiphertext {
    let n: Int = list_len(secret_key);
    let mut dot: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let s_i: Int = list_get(secret_key, i);
        let a_i: Int = list_get(a_rand, i);
        dot = (dot + s_i * a_i) % q;
        i = i + 1;
    }
    let mut b_val: Int = (dot + message * scale_delta + error) % q;
    if b_val < 0 {
        b_val = b_val + q;
    }
    return LweCiphertext {
        a_vector: a_rand,
        b_scalar: b_val,
        dimension_n: n,
        modulus_q: q,
    };
}

pub fn lwe_decrypt(ct: &LweCiphertext, secret_key: List[Int], scale_delta: Int) -> Int {
    let mut dot: Int = 0;
    let mut i: Int = 0;
    while i < ct.dimension_n {
        let s_i: Int = list_get(secret_key, i);
        let a_i: Int = list_get(ct.a_vector, i);
        dot = (dot + s_i * a_i) % ct.modulus_q;
        i = i + 1;
    }
    let mut phase: Int = (ct.b_scalar - dot) % ct.modulus_q;
    if phase < 0 {
        phase = phase + ct.modulus_q;
    }
    return (phase + scale_delta / 2) / scale_delta;
}

pub fn lwe_add(ct1: &LweCiphertext, ct2: &LweCiphertext) -> LweCiphertext {
    let mut new_a: List[Int] = list_new();
    let mut i: Int = 0;
    while i < ct1.dimension_n {
        let v1: Int = list_get(ct1.a_vector, i);
        let v2: Int = list_get(ct2.a_vector, i);
        new_a = list_push(new_a, (v1 + v2) % ct1.modulus_q);
        i = i + 1;
    }
    let new_b: Int = (ct1.b_scalar + ct2.b_scalar) % ct1.modulus_q;
    return LweCiphertext {
        a_vector: new_a,
        b_scalar: new_b,
        dimension_n: ct1.dimension_n,
        modulus_q: ct1.modulus_q,
    };
}
