// # LWE Lattice Security & BKZ Block-Size Estimator
//
// Logline: Implements lattice attack complexity estimators, BKZ reduction block size beta estimation, and bit-security level checks.
//
// Setup: Cryptographic parameter verification against primal and dual BKZ lattice reduction attacks.
//
// Beats:
//   1. Define LweSecurityEstimator and dimension/modulus parameters.
//   2. Estimate required BKZ block size beta for lattice reduction.
//   3. Verify compliance with 128-bit, 192-bit, and 256-bit quantum security standards.

pub type LweSecurityEstimator = struct {
    dimension_n: Int,
    modulus_q_bits: Int,
    noise_sigma: Float,
    secret_distribution: Int
};

pub fn lwe_security_estimator_new(n: Int, q_bits: Int, sigma: Float, secret_dist: Int) -> LweSecurityEstimator {
    return LweSecurityEstimator {
        dimension_n: n,
        modulus_q_bits: q_bits,
        noise_sigma: sigma,
        secret_distribution: secret_dist
    };
}

pub fn lwe_estimate_bkz_block_size(n: Int, q_bits: Int) -> Int {
    let ratio: Float = (n as Float) / (q_bits as Float);
    return (ratio * 15.0) as Int;
}

pub fn lwe_estimate_security_bits(beta: Int) -> Int {
    return ((beta as Float) * 0.292) as Int;
}

pub fn lwe_is_128bit_secure(estimator: &LweSecurityEstimator) -> Bool {
    let beta: Int = lwe_estimate_bkz_block_size(estimator.dimension_n, estimator.modulus_q_bits);
    let sec_bits: Int = lwe_estimate_security_bits(beta);
    return sec_bits >= 128;
}
