// # Encrypted Binary Search Tree & Oblivious Traversal
//
// Logline: Implements oblivious binary search tree traversal, homomorphic node comparisons, and multiplexer path selections.
//
// Setup: Enables private index lookups, encrypted dictionary search, and oblivious data structures.
//
// Beats:
//   1. Define BlindSearchTree and node key collections.
//   2. Implement homomorphic path comparison and multiplexing shims.
//   3. Compute evaluation depth costs for logarithmic tree traversal.

pub type BlindSearchTree = struct {
    tree_depth: Int,
    num_nodes: Int,
    node_keys_scaled: List[Int]
};

pub fn blind_search_tree_new(depth: Int, keys: List[Int]) -> BlindSearchTree {
    return BlindSearchTree {
        tree_depth: depth,
        num_nodes: list_len(keys),
        node_keys_scaled: keys
    };
}

pub fn blind_search_eval_depth_cost(depth: Int) -> Int {
    return depth * 2;
}
