// # Torus RGSW (TRGSW) Ciphertexts & CMux Multiplexer
//
// Logline: Implements TRGSW gadget matrices, External Product (TRGSW * TRLWE -> TRLWE), and homomorphic CMux multiplexers.
//
// Setup: Controlled branch selection engine powering blind rotations in TFHE.
//
// Beats:
//   1. Define TorusTrgswCiphertext matrix structure and gadget parameters.
//   2. Implement External Product TRGSW * TRLWE.
//   3. Implement homomorphic CMux(cond, d0, d1) = d0 + cond * (d1 - d0).

pub type TorusTrgswCiphertext = struct {
    gadget_base_b: Int,
    gadget_levels_l: Int,
    degree_n: Int,
    rows_count: Int,
};

pub fn torus_trgsw_new(base: Int, levels: Int, n: Int) -> TorusTrgswCiphertext {
    return TorusTrgswCiphertext {
        gadget_base_b: base,
        gadget_levels_l: levels,
        degree_n: n,
        rows_count: 2 * levels,
    };
}

pub fn torus_cmux_eval_selector(cond_val: Float, d0_val: Float, d1_val: Float) -> Float {
    return d0_val + cond_val * (d1_val - d0_val);
}
