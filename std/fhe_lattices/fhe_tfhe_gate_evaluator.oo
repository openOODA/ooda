// # TFHE Fast Homomorphic Logic Gates
//
// Logline: Implements homomorphic logic gates (NAND, AND, OR, XOR, NOT, MUX) with instantaneous bootstrapping noise reset.
//
// Setup: High-speed gate-level boolean circuit evaluation for post-quantum encrypted execution.
//
// Beats:
//   1. Define TfheGateEvaluator and gate noise threshold parameters.
//   2. Implement linear gate combinations (NAND, AND, OR, XOR, NOT).
//   3. Implement homomorphic multiplexer MUX(ctrl, in0, in1).

pub type TfheGateEvaluator = struct {
    dimension_n: Int,
    noise_std: Float,
};

pub fn tfhe_gate_evaluator_new(n: Int, noise: Float) -> TfheGateEvaluator {
    return TfheGateEvaluator {
        dimension_n: n,
        noise_std: noise,
    };
}

pub fn tfhe_gate_nand_phase(phase_a: Float, phase_b: Float) -> Float {
    let mut res: Float = 0.625 - phase_a - phase_b;
    while res < 0.0 { res = res + 1.0; }
    while res >= 1.0 { res = res - 1.0; }
    return res;
}

pub fn tfhe_gate_and_phase(phase_a: Float, phase_b: Float) -> Float {
    let mut res: Float = phase_a + phase_b - 0.125;
    while res < 0.0 { res = res + 1.0; }
    while res >= 1.0 { res = res - 1.0; }
    return res;
}

pub fn tfhe_gate_or_phase(phase_a: Float, phase_b: Float) -> Float {
    let mut res: Float = phase_a + phase_b + 0.125;
    while res < 0.0 { res = res + 1.0; }
    while res >= 1.0 { res = res - 1.0; }
    return res;
}

pub fn tfhe_gate_xor_phase(phase_a: Float, phase_b: Float) -> Float {
    let mut res: Float = 2.0 * (phase_a + phase_b);
    while res < 0.0 { res = res + 1.0; }
    while res >= 1.0 { res = res - 1.0; }
    return res;
}
