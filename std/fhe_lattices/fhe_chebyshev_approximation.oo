// # Homomorphic Chebyshev Series Polynomial Approximations
//
// Logline: Implements Clenshaw algorithm and Chebyshev basis series T_k(x) for non-linear functions (ReLU, Sigmoid, Exp, Reciprocal).
//
// Setup: Enables high-precision evaluation of non-polynomial activation functions in encrypted machine learning.
//
// Beats:
//   1. Define ChebyshevBasis coefficients and interval bounds [a, b].
//   2. Implement Clenshaw recurrence evaluation algorithm.
//   3. Provide precomputed Chebyshev approximation basis sets for Sigmoid, ReLU, and Exp.

pub type ChebyshevBasis = struct {
    degree_k: Int,
    min_val: Float,
    max_val: Float,
    coeffs: List[Float]
};

pub fn chebyshev_basis_new(degree: Int, min_v: Float, max_v: Float, coeffs: List[Float]) -> ChebyshevBasis {
    return ChebyshevBasis {
        degree_k: degree,
        min_val: min_v,
        max_val: max_v,
        coeffs: coeffs
    };
}

pub fn chebyshev_eval_clenshaw(x: Float, basis: &ChebyshevBasis) -> Float {
    let u: Float = (2.0 * x - basis.min_val - basis.max_val) / (basis.max_val - basis.min_val);
    let mut b1: Float = 0.0;
    let mut b2: Float = 0.0;
    let mut i: Int = basis.degree_k;
    while i >= 1 {
        let c_i: Float = list_get(basis.coeffs, i);
        let b0: Float = 2.0 * u * b1 - b2 + c_i;
        b2 = b1;
        b1 = b0;
        i = i - 1;
    }
    let c0: Float = list_get(basis.coeffs, 0);
    return u * b1 - b2 + c0 * 0.5;
}

pub fn chebyshev_fit_sigmoid_demo() -> ChebyshevBasis {
    let mut c: List[Float] = list_new();
    c = list_push(c, 1.0);
    c = list_push(c, 0.5);
    c = list_push(c, 0.0);
    c = list_push(c, -0.04);
    return chebyshev_basis_new(3, -5.0, 5.0, c);
}
