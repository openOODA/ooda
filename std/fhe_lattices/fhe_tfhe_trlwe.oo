// # Torus Ring-LWE (TRLWE) Polynomial Ciphertexts
//
// Logline: Implements TRLWE ciphertexts over T_N[X] = (R/Z)[X]/(X^N + 1), polynomial additions, and monomial rotations.
//
// Setup: Accumulator ciphertexts used during TFHE blind rotation bootstrapping.
//
// Beats:
//   1. Define TorusTrlweCiphertext pairs of Torus polynomials.
//   2. Implement TRLWE addition and monomial multiplication X^k * (A, B).
//   3. Implement sample extraction from TRLWE to TLWE.

pub type TorusTrlweCiphertext = struct {
    a_poly: List[Float],
    b_poly: List[Float],
    degree_n: Int,
};

pub fn torus_trlwe_new(a: List[Float], b: List[Float], n: Int) -> TorusTrlweCiphertext {
    return TorusTrlweCiphertext {
        a_poly: a,
        b_poly: b,
        degree_n: n,
    };
}

pub fn torus_trlwe_add(a: &TorusTrlweCiphertext, b: &TorusTrlweCiphertext) -> TorusTrlweCiphertext {
    let mut out_a: List[Float] = list_new();
    let mut out_b: List[Float] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let mut va: Float = list_get(a.a_poly, i) + list_get(b.a_poly, i);
        let mut vb: Float = list_get(a.b_poly, i) + list_get(b.b_poly, i);
        while va >= 1.0 { va = va - 1.0; }
        while vb >= 1.0 { vb = vb - 1.0; }
        out_a = list_push(out_a, va);
        out_b = list_push(out_b, vb);
        i = i + 1;
    }
    return TorusTrlweCiphertext {
        a_poly: out_a,
        b_poly: out_b,
        degree_n: a.degree_n,
    };
}
