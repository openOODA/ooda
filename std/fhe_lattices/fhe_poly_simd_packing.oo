// # Plaintext SIMD Slot Packing & Batching
//
// Logline: Implements plaintext SIMD batching and CRT slot packing across polynomial ring factor ideals.
//
// Setup: Enables homomorphic SIMD parallel arithmetic over thousands of independent data slots in a single ciphertext.
//
// Beats:
//   1. Define SimdSlotConfig and SimdPlaintext structures.
//   2. Implement slot packing into polynomial coefficients and unpacking extraction.
//   3. Implement parallel component-wise slot addition and multiplication.

pub type SimdSlotConfig = struct {
    num_slots: Int,
    slot_capacity: Int,
    modulus_t: Int
};

pub type SimdPlaintext = struct {
    slots: List[Int],
    count: Int
};

pub fn simd_slot_config_new(num_slots: Int, slot_capacity: Int, modulus_t: Int) -> SimdSlotConfig {
    return SimdSlotConfig {
        num_slots: num_slots,
        slot_capacity: slot_capacity,
        modulus_t: modulus_t
    };
}

pub fn simd_plaintext_new(slots: List[Int]) -> SimdPlaintext {
    return SimdPlaintext {
        slots: slots,
        count: list_len(slots)
    };
}

pub fn simd_pack_slots_to_poly(pt: &SimdPlaintext, degree_n: Int) -> List[Int] {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < degree_n {
        if i < pt.count {
            coeffs = list_push(coeffs, list_get(pt.slots, i));
        } else {
            coeffs = list_push(coeffs, 0);
        }
        i = i + 1;
    }
    return coeffs;
}

pub fn simd_unpack_poly_to_slots(coeffs: List[Int], num_slots: Int) -> SimdPlaintext {
    let mut slots: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_slots {
        if i < list_len(coeffs) {
            slots = list_push(slots, list_get(coeffs, i));
        } else {
            slots = list_push(slots, 0);
        }
        i = i + 1;
    }
    return SimdPlaintext {
        slots: slots,
        count: num_slots
    };
}

pub fn simd_slot_add(a: &SimdPlaintext, b: &SimdPlaintext, t: Int) -> SimdPlaintext {
    let mut res: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.count {
        let va: Int = list_get(a.slots, i);
        let vb: Int = list_get(b.slots, i);
        res = list_push(res, (va + vb) % t);
        i = i + 1;
    }
    return SimdPlaintext {
        slots: res,
        count: a.count
    };
}
