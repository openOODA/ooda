// # Galois Polynomial Automorphisms & Permutations
//
// Logline: Implements Galois group automorphisms sigma_k(X) = X^k on cyclotomic rings for homomorphic slot rotations.
//
// Setup: Essential primitive for vector cyclic shifts, matrix transformations, and Frobenian mappings.
//
// Beats:
//   1. Define GaloisAutomorphism descriptor and permutation tables.
//   2. Compute index mapping tables for odd Galois elements sigma_k.
//   3. Apply automorphisms over polynomial coefficient vectors.

pub type GaloisAutomorphism = struct {
    k_generator: Int,
    ring_degree_n: Int,
    modulus_q: Int
};

pub fn galois_automorphism_new(k: Int, n: Int, q: Int) -> GaloisAutomorphism {
    return GaloisAutomorphism {
        k_generator: k,
        ring_degree_n: n,
        modulus_q: q
    };
}

pub fn galois_compute_perm_table(k: Int, n: Int) -> List[Int] {
    let mut perm: List[Int] = list_new();
    let m: Int = 2 * n;
    let mut i: Int = 0;
    while i < n {
        let mapped: Int = (i * k) % m;
        perm = list_push(perm, mapped);
        i = i + 1;
    }
    return perm;
}

pub fn galois_apply_to_poly(coeffs: List[Int], perm_table: List[Int], n: Int, q: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut idx: Int = 0;
    while idx < n {
        out = list_push(out, 0);
        idx = idx + 1;
    }
    let mut i: Int = 0;
    while i < n {
        let target_idx: Int = list_get(perm_table, i);
        let val: Int = list_get(coeffs, i);
        if target_idx < n {
            let cur: Int = list_get(out, target_idx);
            out = list_set(out, target_idx, (cur + val) % q);
        } else {
            let red_idx: Int = target_idx - n;
            let cur: Int = list_get(out, red_idx);
            let mut diff: Int = (cur - val) % q;
            if diff < 0 {
                diff = diff + q;
            }
            out = list_set(out, red_idx, diff);
        }
        i = i + 1;
    }
    return out;
}

pub fn galois_slot_rotation_generator(step: Int, n: Int) -> Int {
    let mut k: Int = 5;
    let mut count: Int = 0;
    while count < step {
        k = (k * 5) % (2 * n);
        count = count + 1;
    }
    return k;
}
