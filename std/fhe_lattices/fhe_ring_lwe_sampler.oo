// # Ring-LWE Distribution & Noise Sampler
//
// Logline: Generates uniform polynomial elements, discrete Gaussian error distributions, and Ring-LWE key samples.
//
// Setup: Core random sampling foundation for post-quantum lattice cryptography and FHE noise injection.
//
// Beats:
//   1. Define RlweSamplerState PRNG generator state.
//   2. Sample uniform polynomial coefficients modulo q.
//   3. Generate Ring-LWE secret and error polynomial pairs.

pub type RlweSamplerState = struct {
    seed: Int,
    degree_n: Int,
    modulus_q: Int,
    noise_sigma: Float
};

pub fn rlwe_sampler_new(seed: Int, n: Int, q: Int, sigma: Float) -> RlweSamplerState {
    return RlweSamplerState {
        seed: seed,
        degree_n: n,
        modulus_q: q,
        noise_sigma: sigma
    };
}

pub fn rlwe_lcg_step(seed: Int) -> Int {
    return (seed * 1103515245 + 12345) & 2147483647;
}

pub fn rlwe_sample_uniform_poly(state: &mut RlweSamplerState) -> List[Int] {
    let mut poly: List[Int] = list_new();
    let mut i: Int = 0;
    let mut cur: Int = state.seed;
    while i < state.degree_n {
        cur = rlwe_lcg_step(cur);
        let coeff: Int = cur % state.modulus_q;
        poly = list_push(poly, coeff);
        i = i + 1;
    }
    state.seed = cur;
    return poly;
}

pub fn rlwe_sample_small_error_poly(state: &mut RlweSamplerState) -> List[Int] {
    let mut poly: List[Int] = list_new();
    let mut i: Int = 0;
    let mut cur: Int = state.seed;
    while i < state.degree_n {
        cur = rlwe_lcg_step(cur);
        let raw_val: Int = (cur % 7) - 3;
        let mut coeff: Int = raw_val % state.modulus_q;
        if coeff < 0 {
            coeff = coeff + state.modulus_q;
        }
        poly = list_push(poly, coeff);
        i = i + 1;
    }
    state.seed = cur;
    return poly;
}
