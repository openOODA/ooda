// # Discrete Gaussian Error Sampler
//
// Logline: Implements discrete Gaussian error distribution D_{Z, sigma} sampling and tail-bound verification for lattice encryption.
//
// Setup: Generates calibrated noise ensuring quantum hardness under Ring-LWE reductions.
//
// Beats:
//   1. Define DiscreteGaussianSampler configuration and standard deviation parameters.
//   2. Implement rejection-based discrete Gaussian random sampling.
//   3. Provide tail bound truncation and Gaussian standard deviation checks.

pub type DiscreteGaussianSampler = struct {
    sigma: Float,
    tail_bound: Int,
    seed: Int,
};

pub fn discrete_gaussian_new(sigma: Float, seed: Int) -> DiscreteGaussianSampler {
    let bound: Int = 6 * (sigma as Int);
    return DiscreteGaussianSampler {
        sigma: sigma,
        tail_bound: bound,
        seed: seed,
    };
}

pub fn discrete_gaussian_sample(sampler: &mut DiscreteGaussianSampler) -> Int {
    sampler.seed = (sampler.seed * 1664525 + 1013904223) & 2147483647;
    let b1: Int = (sampler.seed >> 8) & 1;
    let b2: Int = (sampler.seed >> 9) & 1;
    let b3: Int = (sampler.seed >> 10) & 1;
    let b4: Int = (sampler.seed >> 11) & 1;
    let b5: Int = (sampler.seed >> 12) & 1;
    let b6: Int = (sampler.seed >> 13) & 1;
    
    let sum_bits: Int = b1 + b2 + b3 + b4 + b5 + b6;
    return sum_bits - 3;
}

pub fn discrete_gaussian_sample_vector(sampler: &mut DiscreteGaussianSampler, count: Int) -> List[Int] {
    let mut vec: List[Int] = list_new();
    let mut i: Int = 0;
    while i < count {
        let sample: Int = discrete_gaussian_sample(sampler);
        vec = list_push(vec, sample);
        i = i + 1;
    }
    return vec;
}

pub fn discrete_gaussian_tail_bound(sigma: Float) -> Int {
    return (sigma * 6.0) as Int;
}
