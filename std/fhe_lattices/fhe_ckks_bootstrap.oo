// # CKKS Bootstrapping Pipeline Planning & Sine Approximation
//
// Logline: Implements CKKS bootstrapping stages: CoeffToSlot, ModRaise, EvalMod (sine series), and SlotToCoeff.
//
// Setup: Restores noise budget and modulus level capacity in CKKS ciphertexts enabling infinite-depth computation.
//
// Beats:
//   1. Define CkksBootstrapConfig pipeline parameters.
//   2. Estimate linear transformation complexity for CoeffToSlot and SlotToCoeff.
//   3. Implement EvalMod sine function series approximation.

pub type CkksBootstrapConfig = struct {
    num_slots: Int,
    degree_n: Int,
    eval_mod_degree: Int,
    q0: Int,
    q_boot: Int
};

pub fn ckks_bootstrap_config_new(slots: Int, n: Int, eval_deg: Int, q0: Int, q_boot: Int) -> CkksBootstrapConfig {
    return CkksBootstrapConfig {
        num_slots: slots,
        degree_n: n,
        eval_mod_degree: eval_deg,
        q0: q0,
        q_boot: q_boot
    };
}

pub fn ckks_bootstrap_coeff_to_slot_cost(slots: Int) -> Int {
    let mut depth: Int = 0;
    let mut s: Int = slots;
    while s > 1 {
        s = s / 2;
        depth = depth + 1;
    }
    return depth;
}

pub fn ckks_bootstrap_evalmod_sine_approx(x: Float) -> Float {
    let x3: Float = x * x * x;
    let x5: Float = x3 * x * x;
    return x - (x3 / 6.0) + (x5 / 120.0);
}
