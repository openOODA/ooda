// # Invariant Noise Budget & Growth Tracker
//
// Logline: Computes remaining noise budget bits B = log2(q / (2*||v||_inf)), tracks additive/multiplicative consumption, and flags decryption hazards.
//
// Setup: Real-time invariant telemetry preventing ciphertext corruption during deep homomorphic evaluation.
//
// Beats:
//   1. Define NoiseBudgetTracker and initial budget calculations.
//   2. Track noise growth across additions and homomorphic multiplications.
//   3. Verify decryption safety margins and remaining budget bits.

pub type NoiseBudgetTracker = struct {
    initial_budget_bits: Float,
    current_budget_bits: Float,
    noise_scale_delta: Float,
};

pub fn noise_budget_tracker_new(initial_bits: Float, delta: Float) -> NoiseBudgetTracker {
    return NoiseBudgetTracker {
        initial_budget_bits: initial_bits,
        current_budget_bits: initial_bits,
        noise_scale_delta: delta,
    };
}

pub fn noise_budget_consume_addition(tracker: &mut NoiseBudgetTracker) -> Float {
    tracker.current_budget_bits = tracker.current_budget_bits - 1.0;
    return tracker.current_budget_bits;
}

pub fn noise_budget_consume_mult(tracker: &mut NoiseBudgetTracker, bits_consumed: Float) -> Float {
    tracker.current_budget_bits = tracker.current_budget_bits - bits_consumed;
    return tracker.current_budget_bits;
}

pub fn noise_budget_is_decryption_safe(tracker: &NoiseBudgetTracker) -> Bool {
    return tracker.current_budget_bits > 5.0;
}
