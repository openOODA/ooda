// # Ring-LWE (RLWE) Ciphertext Structures & Operations
//
// Logline: Implements Ring-LWE ciphertext pairs (c0, c1) over polynomial quotient rings, addition, subtraction, and sample extraction.
//
// Setup: Core ciphertext container for RLWE-based schemes including BGV, BFV, and CKKS.
//
// Beats:
//   1. Define RlweCiphertext and polynomial coefficient vectors.
//   2. Implement component-wise ciphertext addition and subtraction.
//   3. Implement RLWE-to-LWE coefficient sample extraction.

pub type RlweCiphertext = struct {
    c0: List[Int],
    c1: List[Int],
    degree_n: Int,
    modulus_q: Int
};

pub fn rlwe_ciphertext_new(c0: List[Int], c1: List[Int], n: Int, q: Int) -> RlweCiphertext {
    return RlweCiphertext {
        c0: c0,
        c1: c1,
        degree_n: n,
        modulus_q: q
    };
}

pub fn rlwe_add(a: &RlweCiphertext, b: &RlweCiphertext) -> RlweCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut out_c1: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let v0: Int = (list_get(a.c0, i) + list_get(b.c0, i)) % a.modulus_q;
        let v1: Int = (list_get(a.c1, i) + list_get(b.c1, i)) % a.modulus_q;
        out_c0 = list_push(out_c0, v0);
        out_c1 = list_push(out_c1, v1);
        i = i + 1;
    }
    return RlweCiphertext {
        c0: out_c0,
        c1: out_c1,
        degree_n: a.degree_n,
        modulus_q: a.modulus_q
    };
}

pub fn rlwe_sub(a: &RlweCiphertext, b: &RlweCiphertext) -> RlweCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut out_c1: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let mut diff0: Int = (list_get(a.c0, i) - list_get(b.c0, i)) % a.modulus_q;
        let mut diff1: Int = (list_get(a.c1, i) - list_get(b.c1, i)) % a.modulus_q;
        if diff0 < 0 { diff0 = diff0 + a.modulus_q; }
        if diff1 < 0 { diff1 = diff1 + a.modulus_q; }
        out_c0 = list_push(out_c0, diff0);
        out_c1 = list_push(out_c1, diff1);
        i = i + 1;
    }
    return RlweCiphertext {
        c0: out_c0,
        c1: out_c1,
        degree_n: a.degree_n,
        modulus_q: a.modulus_q
    };
}

pub fn rlwe_extract_lwe_sample(ct: &RlweCiphertext, slot_idx: Int) -> List[Int] {
    let mut extracted_a: List[Int] = list_new();
    let mut i: Int = 0;
    while i < ct.degree_n {
        let target_idx: Int = (ct.degree_n + slot_idx - i) % ct.degree_n;
        let mut val: Int = list_get(ct.c1, target_idx);
        if target_idx > slot_idx {
            val = (ct.modulus_q - val) % ct.modulus_q;
        }
        extracted_a = list_push(extracted_a, val);
        i = i + 1;
    }
    return extracted_a;
}
