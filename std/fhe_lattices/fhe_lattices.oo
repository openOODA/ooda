// -------------------------------------------------------------------
// Unified FHE Lattice Runtime Config
// -------------------------------------------------------------------

pub type FheLatticeRuntime = struct {
    default_ring_degree_n: Int,
    default_security_bits: Int,
    enable_auto_relinearization: Int,
    enable_auto_rescaling: Int,
};

pub fn fhe_lattice_runtime_default() -> FheLatticeRuntime {
    return FheLatticeRuntime {
        default_ring_degree_n: 8192,
        default_security_bits: 128,
        enable_auto_relinearization: 1,
        enable_auto_rescaling: 1,
    };
}

// -------------------------------------------------------------------
// High-Level Facade Convenience Shims
// -------------------------------------------------------------------

pub fn fhe_ntt_init_default(n: Int, q: Int, root: Int, inv_n: Int) -> NttContext {
    return ntt_context_new(n, q, root, inv_n);
}

pub fn fhe_lwe_create(a: List[Int], b: Int, n: Int, q: Int) -> LweCiphertext {
    return lwe_ciphertext_new(a, b, n, q);
}

pub fn fhe_rlwe_create(c0: List[Int], c1: List[Int], n: Int, q: Int) -> RlweCiphertext {
    return rlwe_ciphertext_new(c0, c1, n, q);
}

pub fn fhe_bgv_create(c0: List[Int], c1: List[Int], n: Int, q: Int, t: Int, level: Int) -> BgvCiphertext {
    return bgv_ciphertext_new(c0, c1, n, q, t, level);
}

pub fn fhe_bfv_create(c0: List[Int], c1: List[Int], n: Int, q: Int, t: Int) -> BfvCiphertext {
    return bfv_ciphertext_new(c0, c1, n, q, t);
}

pub fn fhe_ckks_create(c0: List[Int], c1: List[Int], n: Int, q: Int, scale: Float, level: Int) -> CkksCiphertext {
    return ckks_ciphertext_new(c0, c1, n, q, scale, level);
}

pub fn fhe_tfhe_tlwe_create(a: List[Float], b: Float, n: Int) -> TorusTlweCiphertext {
    return torus_tlwe_new(a, b, n);
}

pub fn fhe_param_preset_128() -> FheParameterSet {
    return fhe_param_128_bit_secure();
}

pub fn fhe_security_check_128(n: Int, q_bits: Int, sigma: Float) -> Bool {
    let est: LweSecurityEstimator = lwe_security_estimator_new(n, q_bits, sigma, 0);
    return lwe_is_128bit_secure(&est);
}
