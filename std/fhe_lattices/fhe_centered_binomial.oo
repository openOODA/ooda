// # Centered Binomial Distribution (CBD) Noise Sampler
//
// Logline: Implements constant-time Centered Binomial Distribution CBD_eta sampling for post-quantum lattice error generation.
//
// Setup: Replaces floating-point Gaussian sampling with fast bit-counting operations for standard FHE parameters.
//
// Beats:
//   1. Define CbdSampler configuration with parameter eta.
//   2. Implement single-sample CBD generation via bit population counts.
//   3. Sample full polynomial noise vectors modulo q.

pub type CbdSampler = struct {
    eta: Int,
    seed: Int
};

pub fn cbd_sampler_new(eta: Int, seed: Int) -> CbdSampler {
    return CbdSampler {
        eta: eta,
        seed: seed
    };
}

pub fn cbd_sample_single(sampler: &mut CbdSampler) -> Int {
    sampler.seed = (sampler.seed * 214013 + 2531011) & 2147483647;
    let mut a_bits: Int = 0;
    let mut b_bits: Int = 0;
    let mut i: Int = 0;
    while i < sampler.eta {
        let bit_a: Int = (sampler.seed >> (i * 2)) & 1;
        let bit_b: Int = (sampler.seed >> (i * 2 + 1)) & 1;
        a_bits = a_bits + bit_a;
        b_bits = b_bits + bit_b;
        i = i + 1;
    }
    return a_bits - b_bits;
}

pub fn cbd_sample_poly(sampler: &mut CbdSampler, n: Int, q: Int) -> List[Int] {
    let mut poly: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let sample: Int = cbd_sample_single(sampler);
        let mut coeff: Int = sample % q;
        if coeff < 0 {
            coeff = coeff + q;
        }
        poly = list_push(poly, coeff);
        i = i + 1;
    }
    return poly;
}

pub fn cbd_variance(eta: Int) -> Float {
    return (eta * 1.0) * 0.5;
}
