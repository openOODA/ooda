// # BFV Scale-Invariant Ciphertext Format
//
// Logline: Implements BFV (Brakerski-Fan-Vercauteren) ciphertexts with invariant scaling delta = floor(Q/t) for scale-invariant arithmetic.
//
// Setup: Standard exact integer FHE scheme avoiding modulus switching during homomorphic additions.
//
// Beats:
//   1. Define BfvCiphertext structure and delta calculation delta = floor(Q/t).
//   2. Implement BFV scale-invariant addition and subtraction.
//   3. Implement BFV plaintext addition scaled by delta.

pub type BfvCiphertext = struct {
    c0: List[Int],
    c1: List[Int],
    degree_n: Int,
    modulus_q: Int,
    plaintext_t: Int,
    delta: Int,
};

pub fn bfv_compute_delta(q: Int, t: Int) -> Int {
    return q / t;
}

pub fn bfv_ciphertext_new(c0: List[Int], c1: List[Int], n: Int, q: Int, t: Int) -> BfvCiphertext {
    let d: Int = bfv_compute_delta(q, t);
    return BfvCiphertext {
        c0: c0,
        c1: c1,
        degree_n: n,
        modulus_q: q,
        plaintext_t: t,
        delta: d,
    };
}

pub fn bfv_add(a: &BfvCiphertext, b: &BfvCiphertext) -> BfvCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut out_c1: List[Int] = list_new();
    let mut i: Int = 0;
    while i < a.degree_n {
        let v0: Int = (list_get(a.c0, i) + list_get(b.c0, i)) % a.modulus_q;
        let v1: Int = (list_get(a.c1, i) + list_get(b.c1, i)) % a.modulus_q;
        out_c0 = list_push(out_c0, v0);
        out_c1 = list_push(out_c1, v1);
        i = i + 1;
    }
    return BfvCiphertext {
        c0: out_c0,
        c1: out_c1,
        degree_n: a.degree_n,
        modulus_q: a.modulus_q,
        plaintext_t: a.plaintext_t,
        delta: a.delta,
    };
}

pub fn bfv_add_plain(ct: &BfvCiphertext, pt: List[Int]) -> BfvCiphertext {
    let mut out_c0: List[Int] = list_new();
    let mut i: Int = 0;
    while i < ct.degree_n {
        let mut pt_val: Int = 0;
        if i < list_len(pt) {
            pt_val = list_get(pt, i);
        }
        let scaled_pt: Int = (pt_val * ct.delta) % ct.modulus_q;
        let v0: Int = (list_get(ct.c0, i) + scaled_pt) % ct.modulus_q;
        out_c0 = list_push(out_c0, v0);
        i = i + 1;
    }
    return BfvCiphertext {
        c0: out_c0,
        c1: ct.c1,
        degree_n: ct.degree_n,
        modulus_q: ct.modulus_q,
        plaintext_t: ct.plaintext_t,
        delta: ct.delta,
    };
}
