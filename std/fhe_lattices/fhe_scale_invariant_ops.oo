// # Scale-Invariant Quantization & Alignment
//
// Logline: Implements scale alignment, fixed-point quantization, and dequantization for mixed-scale homomorphic operations.
//
// Setup: Bridges floating-point numerical workflows with discrete integer polynomial lattices.
//
// Beats:
//   1. Define ScaleInvariantContext and precision scale parameters.
//   2. Implement fixed-point quantization from Float to integer coefficients.
//   3. Implement coefficient dequantization back to real values.

pub type ScaleInvariantContext = struct {
    scale_factor: Float,
    modulus_q: Int,
    precision_bits: Int,
};

pub fn scale_invariant_context_new(scale: Float, mod_q: Int, bits: Int) -> ScaleInvariantContext {
    return ScaleInvariantContext {
        scale_factor: scale,
        modulus_q: mod_q,
        precision_bits: bits,
    };
}

pub fn scale_invariant_quantize(value: Float, scale: Float, q: Int) -> Int {
    let scaled: Int = (value * scale) as Int;
    let mut res: Int = scaled % q;
    if res < 0 {
        res = res + q;
    }
    return res;
}

pub fn scale_invariant_dequantize(coeff: Int, scale: Float, q: Int) -> Float {
    let mut centered: Int = coeff;
    if centered > q / 2 {
        centered = centered - q;
    }
    return (centered as Float) / scale;
}
