// # BGV Leveled Evaluator & Polynomial Horner Engine
//
// Logline: Implements leveled polynomial evaluation pipelines, Horner chains, and evaluation depth consumption for BGV.
//
// Setup: Executes complex integer arithmetic circuits over BGV encrypted plaintexts.
//
// Beats:
//   1. Define BgvEvaluatorConfig and modulus chain levels.
//   2. Implement Horner polynomial evaluation chains on BGV ciphertexts.
//   3. Compute multiplicative depth consumption and remaining level capacity.

pub type BgvEvaluatorConfig = struct {
    max_depth: Int,
    plaintext_t: Int,
    modulus_chain: List[Int]
};

pub fn bgv_evaluator_config_new(max_depth: Int, t: Int, chain: List[Int]) -> BgvEvaluatorConfig {
    return BgvEvaluatorConfig {
        max_depth: max_depth,
        plaintext_t: t,
        modulus_chain: chain
    };
}

pub fn bgv_eval_depth_consumed(init_level: Int, cur_level: Int) -> Int {
    return init_level - cur_level;
}

pub fn bgv_eval_is_level_valid(cur_level: Int) -> Bool {
    return cur_level >= 0;
}
