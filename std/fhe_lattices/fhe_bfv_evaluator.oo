// # BFV Leveled Multiplier & Tensor Rounding Engine
//
// Logline: Implements BFV tensor product division and rounding round(t * c_i * c_j / Q) for scale-invariant multiplication.
//
// Setup: Executes homomorphic integer multiplications under the BFV scheme.
//
// Beats:
//   1. Define BfvEvaluator structure and precision parameters.
//   2. Implement tensor product coefficient rounding round(t * prod / Q).
//   3. Implement scaled scalar polynomial multiplications.

pub type BfvEvaluator = struct {
    modulus_q: Int,
    plaintext_t: Int,
    delta: Int
};

pub fn bfv_evaluator_new(q: Int, t: Int) -> BfvEvaluator {
    let d: Int = q / t;
    return BfvEvaluator {
        modulus_q: q,
        plaintext_t: t,
        delta: d
    };
}

pub fn bfv_tensor_round_coeff(c_prod: Int, t: Int, q: Int) -> Int {
    let num: Int = t * c_prod + q / 2;
    return (num / q) % q;
}

pub fn bfv_eval_scalar_mul(coeff: Int, scalar: Int, q: Int) -> Int {
    return (coeff * scalar) % q;
}
