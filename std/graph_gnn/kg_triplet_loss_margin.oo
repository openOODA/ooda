// # Knowledge Graph Triplet Margin & Ranking Loss
//
// Logline: Implements margin ranking, log-sigmoid, and self-adversarial loss functions for knowledge graph embeddings.
//
// Setup: Loss evaluation engine supporting additive margin, cross-entropy, and smooth approximations for gradient backpropagation.
//
// Beats:
//   1. Compute pairwise margin ranking loss L = max(0, margin - s_pos + s_neg).
//   2. Evaluate binary log-sigmoid cross-entropy loss -log(sigmoid(s_pos)) - sum log(sigmoid(-s_neg)).
//   3. Compute temperature-scaled self-adversarial loss weighting hardest negative triplets.

pub type TripletLossConfig = struct {
    margin: Float,
    adversarial_temperature: Float,
    use_subsampling_weight: Bool,
};

pub fn triplet_loss_config_new(
    margin: Float,
    temp: Float,
    use_subsampling: Bool
) -> TripletLossConfig {
    return TripletLossConfig {
        margin: margin,
        adversarial_temperature: temp,
        use_subsampling_weight: use_subsampling,
    };
}

pub fn loss_pairwise_margin(
    pos_score: Float,
    neg_score: Float,
    margin: Float
) -> Float {
    let loss: Float = margin - pos_score + neg_score;
    if loss > 0.0 {
        return loss;
    }
    return 0.0;
}

pub fn loss_softplus(x: Float) -> Float {
    if x > 30.0 {
        return x;
    }
    if x < 0.0 - 30.0 {
        return exp(x);
    }
    return (1.0 + exp(x)); // Numerically stable proxy
}

pub fn loss_log_sigmoid_contrastive(
    pos_score: Float,
    neg_scores: List[Float],
    margin: Float
) -> Float {
    // Loss = -log(sigmoid(pos_score - margin)) - sum log(sigmoid(margin - neg_score))
    // -log(sigmoid(z)) = softplus(-z)
    let pos_loss: Float = loss_softplus(margin - pos_score);

    let mut neg_loss_sum: Float = 0.0;
    let n_neg: Int = list_len(neg_scores);
    let mut i: Int = 0;
    while i < n_neg {
        let neg_s: Float = list_get(neg_scores, i);
        let n_loss: Float = loss_softplus(neg_s - margin);
        neg_loss_sum = neg_loss_sum + n_loss;
        i = i + 1;
    }

    if n_neg > 0 {
        return pos_loss + (neg_loss_sum / (n_neg as Float));
    }
    return pos_loss;
}

pub fn loss_adversarial_weighted(
    pos_score: Float,
    neg_scores: List[Float],
    weights: List[Float],
    margin: Float
) -> Float {
    let pos_loss: Float = loss_softplus(margin - pos_score);

    let mut weighted_neg_loss: Float = 0.0;
    let n_neg: Int = list_len(neg_scores);
    let mut i: Int = 0;
    while i < n_neg {
        let neg_s: Float = list_get(neg_scores, i);
        let w: Float = list_get(weights, i);
        let n_loss: Float = loss_softplus(neg_s - margin);
        weighted_neg_loss = weighted_neg_loss + (w * n_loss);
        i = i + 1;
    }
    return pos_loss + weighted_neg_loss;
}
