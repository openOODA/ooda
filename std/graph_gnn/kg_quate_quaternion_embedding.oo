// # QuatE Quaternion Knowledge Graph Embeddings
//
// Logline: Models knowledge graph relations using 4D Hamilton hypercomplex quaternion rotations and scaling.
//
// Setup: Quaternion geometric embedder computing non-commutative 3D spatial rotations with Hamilton products.
//
// Beats:
//   1. Represent entities and relations as 4D quaternions (real 1, imaginary i, j, k).
//   2. Compute Hamilton product (h \otimes r) enforcing non-commutative relation composition.
//   3. Evaluate inner product <h \otimes r, t> for multi-relational link prediction.

pub type QuaternionConfig = struct {
    num_entities: Int,
    num_relations: Int,
    quat_dim: Int, // Number of 4D quaternion components (each component has 4 floats: r, i, j, k)
    margin: Float
};

pub type QuaternionModel = struct {
    config: QuaternionConfig,
    entity_r: List[Float],
    entity_i: List[Float],
    entity_j: List[Float],
    entity_k: List[Float],
    relation_r: List[Float],
    relation_i: List[Float],
    relation_j: List[Float],
    relation_k: List[Float]
};

pub fn quate_config_new(
    num_entities: Int,
    num_relations: Int,
    quat_dim: Int,
    margin: Float
) -> QuaternionConfig {
    return QuaternionConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        quat_dim: quat_dim,
        margin: margin
    };
}

pub fn quate_model_init(config: QuaternionConfig, seed: Int) -> QuaternionModel {
    let dim: Int = (config).quat_dim;
    let total_e: Int = (config).num_entities * dim;
    let mut er: List[Float] = list_new();
    let mut ei: List[Float] = list_new();
    let mut ej: List[Float] = list_new();
    let mut ek: List[Float] = list_new();
    let mut state: Int = seed;

    let mut idx: Int = 0;
    while idx < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        er = list_push(er, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        ei = list_push(ei, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        ej = list_push(ej, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        ek = list_push(ek, (((state % 1000) as Float) / 500.0) - 1.0);
        idx = idx + 1;
    }

    let total_r: Int = (config).num_relations * dim;
    let mut rr: List[Float] = list_new();
    let mut ri: List[Float] = list_new();
    let mut rj: List[Float] = list_new();
    let mut rk: List[Float] = list_new();
    let mut r_idx: Int = 0;
    while r_idx < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        rr = list_push(rr, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        ri = list_push(ri, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        rj = list_push(rj, (((state % 1000) as Float) / 500.0) - 1.0);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        rk = list_push(rk, (((state % 1000) as Float) / 500.0) - 1.0);
        r_idx = r_idx + 1;
    }

    return QuaternionModel {
        config: config,
        entity_r: er,
        entity_i: ei,
        entity_j: ej,
        entity_k: ek,
        relation_r: rr,
        relation_i: ri,
        relation_j: rj,
        relation_k: rk
    };
}

pub fn quate_score(
    model: &QuaternionModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: QuaternionConfig = (*model).config;
    let dim: Int = (cfg).quat_dim;
    let h_off: Int = head * dim;
    let r_off: Int = relation * dim;
    let t_off: Int = tail * dim;

    let mut score: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let hr: Float = list_get((*model).entity_r, h_off + d);
        let hi: Float = list_get((*model).entity_i, h_off + d);
        let hj: Float = list_get((*model).entity_j, h_off + d);
        let hk: Float = list_get((*model).entity_k, h_off + d);

        let rr: Float = list_get((*model).relation_r, r_off + d);
        let ri: Float = list_get((*model).relation_i, r_off + d);
        let rj: Float = list_get((*model).relation_j, r_off + d);
        let rk: Float = list_get((*model).relation_k, r_off + d);

        let tr: Float = list_get((*model).entity_r, t_off + d);
        let ti: Float = list_get((*model).entity_i, t_off + d);
        let tj: Float = list_get((*model).entity_j, t_off + d);
        let tk: Float = list_get((*model).entity_k, t_off + d);

        // Hamilton product h * r:
        // (hr + hi*i + hj*j + hk*k) * (rr + ri*i + rj*j + rk*k)
        let prod_r: Float = (hr * rr) - (hi * ri) - (hj * rj) - (hk * rk);
        let prod_i: Float = (hr * ri) + (hi * rr) + (hj * rk) - (hk * rj);
        let prod_j: Float = (hr * rj) - (hi * rk) + (hj * rr) + (hk * ri);
        let prod_k: Float = (hr * rk) + (hi * rj) - (hj * ri) + (hk * rr);

        // Inner product <h*r, t>
        score = score + (prod_r * tr) + (prod_i * ti) + (prod_j * tj) + (prod_k * tk);
        d = d + 1;
    }
    return score;
}
