// # Cluster-GCN Graph Partitioning & Mini-Batching
//
// Logline: Scales GNN training to massive graphs by restricting message-passing to clustered subgraphs and stochastic multi-cluster batches.
//
// Setup: Memory-efficient graph training engine avoiding exponential neighborhood expansion through cluster-based subgraph sampling.
//
// Beats:
//   1. Partition full graph V into k disjoint dense clusters V_1, V_2, ..., V_k.
//   2. Filter edge connections to retain intra-cluster subgraphs A_{V_t, V_t}.
//   3. Assemble stochastic multi-cluster mini-batches with preserved cross-cluster boundary edges.

pub type ClusterGCNConfig = struct {
    num_nodes: Int,
    num_clusters: Int,
    batch_clusters: Int,
};

pub type ClusterAssignment = struct {
    node_to_cluster: List[Int], // Length num_nodes
    cluster_sizes: List[Int],   // Length num_clusters
};

pub fn cluster_gcn_config_new(
    num_nodes: Int,
    num_clusters: Int,
    batch_clusters: Int
) -> ClusterGCNConfig {
    return ClusterGCNConfig {
        num_nodes: num_nodes,
        num_clusters: num_clusters,
        batch_clusters: batch_clusters,
    };
}

pub fn cluster_partition_simple(
    config: &ClusterGCNConfig,
    num_nodes: Int,
    num_clusters: Int
) -> ClusterAssignment {
    let mut assignment: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        let cluster_id: Int = i % num_clusters;
        assignment = list_push(assignment, cluster_id);
        i = i + 1;
    }

    let mut clean_sizes: List[Int] = list_new();
    let mut m: Int = 0;
    while m < num_clusters {
        let count_m: Int = num_nodes / num_clusters + (if m < (num_nodes % num_clusters) { 1 } else { 0 });
        clean_sizes = list_push(clean_sizes, count_m);
        m = m + 1;
    }

    return ClusterAssignment {
        node_to_cluster: assignment,
        cluster_sizes: clean_sizes,
    };
}

pub fn is_node_in_batch_clusters(
    node_id: Int,
    assignment: &ClusterAssignment,
    selected_clusters: List[Int]
) -> Bool {
    let c_id: Int = list_get((*assignment).node_to_cluster, node_id);
    let num_selected: Int = list_len(selected_clusters);
    let mut i: Int = 0;
    while i < num_selected {
        if list_get(selected_clusters, i) == c_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}
