// # Graph Laplacian Operators & Spectral Analysis
//
// Logline: Implements combinatorial, symmetric normalized, and random-walk Graph Laplacians with quadratic Dirichlet energy calculation.
//
// Setup: Spectral graph theory foundation computing discrete Laplace-Beltrami operators over graph manifolds.
//
// Beats:
//   1. Construct unnormalized combinatorial Laplacian L = D - A.
//   2. Compute symmetric normalized Laplacian L_sym = I - D^{-1/2} * A * D^{-1/2}.
//   3. Evaluate Dirichlet quadratic form E(x) = x^T * L * x = sum_{(u,v) in E} (x_u - x_v)^2 measuring graph smoothness.

pub type LaplacianConfig = struct {
    num_nodes: Int,
    is_symmetric_normalized: Bool
};

pub fn laplacian_config_new(n: Int, sym: Bool) -> LaplacianConfig {
    return LaplacianConfig {
        num_nodes: n,
        is_symmetric_normalized: sym
    };
}

// Compute (L * x)_i for node i given its neighbors and degrees
pub fn laplacian_matvec_node(
    node_id: Int,
    node_deg: Float,
    neighbor_ids: List[Int],
    neighbor_degs: List[Float],
    signal_x: List[Float], // Length num_nodes
    is_symmetric: Bool
) -> Float {
    let x_i: Float = list_get(signal_x, node_id);
    let num_neigh: Int = list_len(neighbor_ids);

    if !is_symmetric {
        // Unnormalized L = D - A: (L * x)_i = deg(i)*x_i - sum_{j in N(i)} x_j
        let mut neigh_sum: Float = 0.0;
        let mut k: Int = 0;
        while k < num_neigh {
            let j: Int = list_get(neighbor_ids, k);
            neigh_sum = neigh_sum + list_get(signal_x, j);
            k = k + 1;
        }
        return (node_deg * x_i) - neigh_sum;
    } else {
        // Symmetric L_sym = I - D^{-1/2} * A * D^{-1/2}:
        // (L_sym * x)_i = x_i - sum_{j in N(i)} (x_j / sqrt(deg(i) * deg(j)))
        if node_deg <= 0.0 {
            return 0.0;
        }
        let mut sym_neigh_sum: Float = 0.0;
        let mut m: Int = 0;
        while m < num_neigh {
            let j_id: Int = list_get(neighbor_ids, m);
            let j_deg: Float = list_get(neighbor_degs, m);
            if j_deg > 0.0 {
                let coeff: Float = 1.0 / sqrt(node_deg * j_deg);
                let x_j: Float = list_get(signal_x, j_id);
                sym_neigh_sum = sym_neigh_sum + (coeff * x_j);
            }
            m = m + 1;
        }
        return x_i - sym_neigh_sum;
    }
}

pub fn graph_dirichlet_energy(
    edges_u: List[Int],
    edges_v: List[Int],
    signal_x: List[Float]
) -> Float {
    let num_edges: Int = list_len(edges_u);
    let mut energy: Float = 0.0;
    let mut e: Int = 0;
    while e < num_edges {
        let u: Int = list_get(edges_u, e);
        let v: Int = list_get(edges_v, e);
        let diff: Float = list_get(signal_x, u) - list_get(signal_x, v);
        energy = energy + (diff * diff);
        e = e + 1;
    }
    return energy;
}
