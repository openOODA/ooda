// # Node2Vec 2nd-Order Biased Random Walks
//
// Logline: Generates 2nd-order parameterized random walks interpolating between BFS community and DFS structural explorations.
//
// Setup: Flexible random walk generator employing return parameter p and in-out parameter q for skip-gram representation learning.
//
// Beats:
//   1. Track 2-step history (previous node t, current node v, candidate neighbor x).
//   2. Compute search bias alpha_{pq}(t, x) based on shortest distance d_{tx} in {0, 1, 2}.
//   3. Sample walk transitions with rejection sampling or alias method distributions.

pub type Node2VecConfig = struct {
    p_return: Float,   // Return parameter p: high p encourages exploration, low p returns
    q_inout: Float,    // In-out parameter q: low q encourages outward DFS, high q local BFS
    walk_length: Int,
    num_walks_per_node: Int
};

pub fn node2vec_config_new(
    p: Float,
    q: Float,
    length: Int,
    num_walks: Int
) -> Node2VecConfig {
    return Node2VecConfig {
        p_return: p,
        q_inout: q,
        walk_length: length,
        num_walks_per_node: num_walks
    };
}

pub fn node2vec_transition_weight(
    config: &Node2VecConfig,
    t_prev: Int,
    x_cand: Int,
    is_t_neighbor_of_x: Bool
) -> Float {
    if x_cand == t_prev {
        // Distance d_{tx} = 0 -> return to previous node
        return 1.0 / (*config).p_return;
    }
    if is_t_neighbor_of_x {
        // Distance d_{tx} = 1 -> common neighbor
        return 1.0;
    }
    // Distance d_{tx} = 2 -> outward exploration
    return 1.0 / (*config).q_inout;
}

pub fn sample_next_node2vec_step(
    config: &Node2VecConfig,
    t_prev: Int,
    v_curr: Int,
    candidates: List[Int],
    t_neighbor_flags: List[Bool],
    seed: Int
) -> Int {
    let num_cand: Int = list_len(candidates);
    if num_cand == 0 {
        return v_curr;
    }

    let mut weights: List[Float] = list_new();
    let mut sum_w: Float = 0.0;
    let mut i: Int = 0;
    while i < num_cand {
        let x: Int = list_get(candidates, i);
        let is_neigh: Bool = list_get(t_neighbor_flags, i);
        let w: Float = node2vec_transition_weight(config, t_prev, x, is_neigh);
        weights = list_push(weights, w);
        sum_w = sum_w + w;
        i = i + 1;
    }

    let mut state: Int = seed;
    state = (state * 1103515245 + 12345) % 2147483647;
    if state < 0 { state = 0 - state; }
    let rand_val: Float = (((state % 10000) * 1.0) / 10000.0) * sum_w;

    let mut accum: Float = 0.0;
    let mut j: Int = 0;
    while j < num_cand {
        accum = accum + list_get(weights, j);
        if accum >= rand_val {
            return list_get(candidates, j);
        }
        j = j + 1;
    }
    return list_get(candidates, num_cand - 1);
}
