// # Cross-Graph Entity Alignment & CSLS Metric
//
// Logline: Aligns equivalent entities across heterogeneous knowledge graphs using joint latent embeddings and Cross-domain Similarity Local Scaling.
//
// Setup: Cross-ontology alignment module mitigating hubness problems in high-dimensional graph vector spaces.
//
// Beats:
//   1. Compute pairwise cosine similarities between source graph and target graph entity embeddings.
//   2. Calculate mean k-nearest neighborhood similarities r_T(x) and r_S(y) to identify high-density hubs.
//   3. Compute CSLS score 2*cos(x, y) - r_T(x) - r_S(y) for optimal bidirectional 1-to-1 matching.

pub type EntityAlignmentConfig = struct {
    dim: Int,
    k_nearest_neighbors: Int,
    similarity_threshold: Float
};

pub fn entity_alignment_config_new(
    dim: Int,
    k: Int,
    threshold: Float
) -> EntityAlignmentConfig {
    return EntityAlignmentConfig {
        dim: dim,
        k_nearest_neighbors: k,
        similarity_threshold: threshold
    };
}

pub fn cosine_similarity(
    vec_a: List[Float],
    a_off: Int,
    vec_b: List[Float],
    b_off: Int,
    dim: Int
) -> Float {
    let mut dot: Float = 0.0;
    let mut norm_a_sq: Float = 0.0;
    let mut norm_b_sq: Float = 0.0;

    let mut d: Int = 0;
    while d < dim {
        let va: Float = list_get(vec_a, a_off + d);
        let vb: Float = list_get(vec_b, b_off + d);
        dot = dot + (va * vb);
        norm_a_sq = norm_a_sq + (va * va);
        norm_b_sq = norm_b_sq + (vb * vb);
        d = d + 1;
    }

    let denom: Float = sqrt(norm_a_sq) * sqrt(norm_b_sq);
    if denom > 0.000001 {
        return dot / denom;
    }
    return 0.0;
}

pub fn compute_mean_top_k_similarity(
    query_emb: List[Float],
    q_off: Int,
    target_embs: List[Float],
    num_targets: Int,
    dim: Int,
    k: Int
) -> Float {
    let mut all_sims: List[Float] = list_new();
    let mut t: Int = 0;
    while t < num_targets {
        let sim: Float = cosine_similarity(query_emb, q_off, target_embs, t * dim, dim);
        all_sims = list_push(all_sims, sim);
        t = t + 1;
    }

    let actual_k: Int = if k < num_targets { k } else { num_targets };
    let mut sum_k: Float = 0.0;
    let mut min_bound: Float = -2.0;

    let mut step: Int = 0;
    while step < actual_k {
        let mut max_sim: Float = -100.0;
        let mut i: Int = 0;
        while i < num_targets {
            let s: Float = list_get(all_sims, i);
            if (step == 0 || s < min_bound) && s > max_sim {
                max_sim = s;
            }
            i = i + 1;
        }
        if max_sim > -90.0 {
            sum_k = sum_k + max_sim;
            min_bound = max_sim;
        }
        step = step + 1;
    }

    if actual_k > 0 {
        return sum_k / (actual_k as Float);
    }
    return 0.0;
}

pub fn csls_score(
    cos_xy: Float,
    mean_sim_x: Float,
    mean_sim_y: Float
) -> Float {
    return (2.0 * cos_xy) - mean_sim_x - mean_sim_y;
}
