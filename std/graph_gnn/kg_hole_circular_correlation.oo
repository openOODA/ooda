// # HolE Holographic Embeddings & Circular Correlation
//
// Logline: Implements holographic embeddings (HolE) using circular correlation to compose entity representations efficiently.
//
// Setup: Associative holographic memory model combining expressive power of tensor products with efficiency of vector additions.
//
// Beats:
//   1. Represent entities and relations as real-valued continuous vector embeddings.
//   2. Compute circular correlation operator [a * b]_k = sum_i a_i * b_{(i+k) mod d}.
//   3. Score triplet plausibility via inner product <r, h * t> with non-commutative compositional semantics.

pub type HolEConfig = struct {
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    margin: Float
};

pub type HolEModel = struct {
    config: HolEConfig,
    entity_embeddings: List[Float],
    relation_embeddings: List[Float]
};

pub fn hole_config_new(
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    margin: Float
) -> HolEConfig {
    return HolEConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        dim: dim,
        margin: margin
    };
}

pub fn hole_model_init(config: HolEConfig, seed: Int) -> HolEModel {
    let dim: Int = (config).dim;
    let total_e: Int = (config).num_entities * dim;
    let mut e_emb: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        e_emb = list_push(e_emb, (((state % 1000) as Float) / 500.0) - 1.0);
        i = i + 1;
    }

    let total_r: Int = (config).num_relations * dim;
    let mut r_emb: List[Float] = list_new();
    let mut j: Int = 0;
    while j < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        r_emb = list_push(r_emb, (((state % 1000) as Float) / 500.0) - 1.0);
        j = j + 1;
    }

    return HolEModel {
        config: config,
        entity_embeddings: e_emb,
        relation_embeddings: r_emb
    };
}

// Circular correlation: c_k = sum_{i=0}^{d-1} a_i * b_{(i + k) % d}
pub fn hole_circular_correlation(
    a: List[Float],
    a_offset: Int,
    b: List[Float],
    b_offset: Int,
    dim: Int
) -> List[Float] {
    let mut result: List[Float] = list_new();
    let mut k: Int = 0;
    while k < dim {
        let mut sum_k: Float = 0.0;
        let mut i: Int = 0;
        while i < dim {
            let idx_b: Int = (i + k) % dim;
            let val_a: Float = list_get(a, a_offset + i);
            let val_b: Float = list_get(b, b_offset + idx_b);
            sum_k = sum_k + (val_a * val_b);
            i = i + 1;
        }
        result = list_push(result, sum_k);
        k = k + 1;
    }
    return result;
}

pub fn hole_score(
    model: &HolEModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: HolEConfig = (*model).config;
    let dim: Int = (cfg).dim;
    let h_off: Int = head * dim;
    let r_off: Int = relation * dim;
    let t_off: Int = tail * dim;

    let corr: List[Float] = hole_circular_correlation(
        (*model).entity_embeddings,
        h_off,
        (*model).entity_embeddings,
        t_off,
        dim
    );

    let mut score: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let r_val: Float = list_get((*model).relation_embeddings, r_off + d);
        let c_val: Float = list_get(corr, d);
        score = score + (r_val * c_val);
        d = d + 1;
    }
    return score;
}
