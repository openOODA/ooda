// # Relational Graph Convolutional Networks (R-GCN)
//
// Logline: Implements multi-relational graph convolution with relation-specific transformations and basis decomposition.
//
// Setup: Deep relational message-passing layer aggregating directional typed neighbor embeddings with normalization factors.
//
// Beats:
//   1. Implement relation-specific message transformations W_r * h_j with basis decomposition parameter sharing.
//   2. Accumulate incoming relational neighbor messages normalized by relation-specific degrees c_{i, r}.
//   3. Apply self-loop residual transformation W_0 * h_i and non-linear activation functions.

pub type RGCNConfig = struct {
    in_dim: Int,
    out_dim: Int,
    num_relations: Int,
    num_bases: Int,
};

pub type RGCNLayer = struct {
    config: RGCNConfig,
    basis_matrices: List[Float],  // num_bases * (in_dim * out_dim)
    relation_coeffs: List[Float], // num_relations * num_bases
    self_loop_weight: List[Float],// in_dim * out_dim
};

pub fn rgcn_config_new(
    in_dim: Int,
    out_dim: Int,
    num_rel: Int,
    num_bases: Int
) -> RGCNConfig {
    return RGCNConfig {
        in_dim: in_dim,
        out_dim: out_dim,
        num_relations: num_rel,
        num_bases: num_bases,
    };
}

pub fn rgcn_layer_init(config: RGCNConfig, seed: Int) -> RGCNLayer {
    let in_d: Int = (config).in_dim;
    let out_d: Int = (config).out_dim;
    let bases: Int = (config).num_bases;
    let num_rel: Int = (config).num_relations;

    let total_basis: Int = bases * in_d * out_d;
    let mut basis_m: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_basis {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        basis_m = list_push(basis_m, (((state % 1000) as Float) / 500.0) - 1.0);
        i = i + 1;
    }

    let total_coeffs: Int = num_rel * bases;
    let mut coeffs: List[Float] = list_new();
    let mut j: Int = 0;
    while j < total_coeffs {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        coeffs = list_push(coeffs, (((state % 1000) as Float) / 500.0) - 1.0);
        j = j + 1;
    }

    let total_self: Int = in_d * out_d;
    let mut self_w: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total_self {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        self_w = list_push(self_w, (((state % 1000) as Float) / 500.0) - 1.0);
        k = k + 1;
    }

    return RGCNLayer {
        config: config,
        basis_matrices: basis_m,
        relation_coeffs: coeffs,
        self_loop_weight: self_w,
    };
}

pub fn rgcn_transform_relation(
    layer: &RGCNLayer,
    relation: Int,
    input_vec: List[Float],
    in_offset: Int
) -> List[Float] {
    let cfg: RGCNConfig = (*layer).config;
    let in_d: Int = (cfg).in_dim;
    let out_d: Int = (cfg).out_dim;
    let bases: Int = (cfg).num_bases;
    let coeff_off: Int = relation * bases;

    let mut out_vec: List[Float] = list_new();
    let mut out_idx: Int = 0;
    while out_idx < out_d {
        let mut total_val: Float = 0.0;
        let mut b: Int = 0;
        while b < bases {
            let a_rb: Float = list_get((*layer).relation_coeffs, coeff_off + b);
            let b_mat_off: Int = b * (in_d * out_d);

            let mut dot: Float = 0.0;
            let mut in_idx: Int = 0;
            while in_idx < in_d {
                let x_val: Float = list_get(input_vec, in_offset + in_idx);
                let w_val: Float = list_get((*layer).basis_matrices, b_mat_off + (in_idx * out_d) + out_idx);
                dot = dot + (x_val * w_val);
                in_idx = in_idx + 1;
            }
            total_val = total_val + (a_rb * dot);
            b = b + 1;
        }
        out_vec = list_push(out_vec, total_val);
        out_idx = out_idx + 1;
    }
    return out_vec;
}
