// # HITS Hyperlink-Induced Topic Search (Authority & Hub Scores)
//
// Logline: Implements Kleinberg's HITS algorithm mutually updating Authority and Hub centrality scores.
//
// Setup: Link analysis algorithm discovering authoritative knowledge sources and directory hub pages on directed graphs.
//
// Beats:
//   1. Update Authority scores from incoming Hubs: a^{(t+1)} = A^T * h^{(t)}.
//   2. Update Hub scores from outgoing Authorities: h^{(t+1)} = A * a^{(t+1)}.
//   3. Normalize Authority and Hub score vectors under iteration step.

type HITSConfig = struct {
    num_nodes: Int,
    max_iterations: Int,
    tolerance_milli: Int
};

pub fn hits_config_new(n: Int, max_iters: Int, tol_milli: Int) -> HITSConfig {
    return HITSConfig {
        num_nodes: n,
        max_iterations: max_iters,
        tolerance_milli: tol_milli
    };
}

pub fn hits_update_step(
    num_nodes: Int,
    current_hubs: List[Int],
    node_in_neighbors: List[Int],
    node_in_offsets: List[Int]
) -> List[Int] {
    // Step 1: Update authorities a_i = sum_{j in in_neigh(i)} h_j
    let mut norm_auth: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        let start_in: Int = list_get(node_in_offsets, i);
        let mut next_i: Int = i + 1;
        let end_in: Int = list_get(node_in_offsets, next_i);
        let mut sum_h: Int = 0;
        let mut k: Int = start_in;
        while k < end_in {
            let j: Int = list_get(node_in_neighbors, k);
            let h_val: Int = list_get(current_hubs, j);
            sum_h = sum_h + h_val;
            k = k + 1;
        }
        norm_auth = list_push(norm_auth, sum_h);
        i = i + 1;
    }
    return norm_auth;
}

pub fn hits_hub_update_step(
    num_nodes: Int,
    norm_auth: List[Int],
    node_out_neighbors: List[Int],
    node_out_offsets: List[Int]
) -> List[Int] {
    // Step 2: Update hubs h_i = sum_{j in out_neigh(i)} a_j
    let mut norm_hubs: List[Int] = list_new();
    let mut j_idx: Int = 0;
    while j_idx < num_nodes {
        let start_out: Int = list_get(node_out_offsets, j_idx);
        let mut next_j: Int = j_idx + 1;
        let end_out: Int = list_get(node_out_offsets, next_j);
        let mut sum_a: Int = 0;
        let mut m: Int = start_out;
        while m < end_out {
            let target_a: Int = list_get(node_out_neighbors, m);
            let a_val: Int = list_get(norm_auth, target_a);
            sum_a = sum_a + a_val;
            m = m + 1;
        }
        norm_hubs = list_push(norm_hubs, sum_a);
        j_idx = j_idx + 1;
    }
    return norm_hubs;
}
