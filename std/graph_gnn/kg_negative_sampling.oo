// # Knowledge Graph Negative Sampling Strategies
//
// Logline: Generates corrupted head and tail negative triplets using uniform, frequency-based, and self-adversarial weighting.
//
// Setup: Probabilistic sampling module creating high-entropy negative triplets for contrastive KG optimization.
//
// Beats:
//   1. Generate uniform negative entity replacements for head and tail triplet positions.
//   2. Apply Bernoulli negative sampling according to entity relation degree distributions (tph / hpt).
//   3. Compute self-adversarial negative sample weights via temperature-scaled softmax.

pub type Triplet = struct {
    head: Int,
    relation: Int,
    tail: Int
};

pub type NegativeSamplingConfig = struct {
    num_entities: Int,
    num_negatives_per_pos: Int,
    adversarial_temperature: Float,
    bernoulli_mode: Bool
};

pub fn negative_sampling_config_new(
    num_entities: Int,
    num_neg: Int,
    temp: Float,
    bernoulli: Bool
) -> NegativeSamplingConfig {
    return NegativeSamplingConfig {
        num_entities: num_entities,
        num_negatives_per_pos: num_neg,
        adversarial_temperature: temp,
        bernoulli_mode: bernoulli
    };
}

pub fn sample_uniform_negatives(
    config: &NegativeSamplingConfig,
    pos_trip: Triplet,
    seed: Int,
    corrupt_head: Bool
) -> List[Triplet] {
    let mut negs: List[Triplet] = list_new();
    let num_neg: Int = (*config).num_negatives_per_pos;
    let n_ent: Int = (*config).num_entities;
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < num_neg {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let mut corrupted_id: Int = state % n_ent;

        if corrupt_head {
            if corrupted_id == (pos_trip).head {
                corrupted_id = (corrupted_id + 1) % n_ent;
            }
            let t: Triplet = Triplet {
                head: corrupted_id,
                relation: (pos_trip).relation,
                tail: (pos_trip).tail
            };
            negs = list_push(negs, t);
        } else {
            if corrupted_id == (pos_trip).tail {
                corrupted_id = (corrupted_id + 1) % n_ent;
            }
            let t: Triplet = Triplet {
                head: (pos_trip).head,
                relation: (pos_trip).relation,
                tail: corrupted_id
            };
            negs = list_push(negs, t);
        }
        i = i + 1;
    }
    return negs;
}

pub fn self_adversarial_weights(
    scores: List[Float],
    temperature: Float
) -> List[Float] {
    let count: Int = list_len(scores);
    let mut exp_scores: List[Float] = list_new();
    let mut sum_exp: Float = 0.0;

    // Find max score for numerical stability
    let mut max_s: Float = -1000000.0;
    let mut i: Int = 0;
    while i < count {
        let s: Float = list_get(scores, i);
        if s > max_s {
            max_s = s;
        }
        i = i + 1;
    }

    let mut j: Int = 0;
    while j < count {
        let s: Float = list_get(scores, j);
        let scaled: Float = (s - max_s) / temperature;
        let e: Float = exp(scaled);
        exp_scores = list_push(exp_scores, e);
        sum_exp = sum_exp + e;
        j = j + 1;
    }

    let mut weights: List[Float] = list_new();
    let mut k: Int = 0;
    while k < count {
        let e_val: Float = list_get(exp_scores, k);
        if sum_exp > 0.0 {
            weights = list_push(weights, e_val / sum_exp);
        } else {
            weights = list_push(weights, 1.0 / (count * 1.0));
        }
        k = k + 1;
    }
    return weights;
}
