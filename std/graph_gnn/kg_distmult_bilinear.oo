// # DistMult Bilinear Knowledge Graph Embeddings
//
// Logline: Computes symmetric bilinear relational interactions using diagonal relation matrices for link prediction.
//
// Setup: Multiplicative latent factor model scoring triplets via tri-linear vector products over real vector representations.
//
// Beats:
//   1. Factorize relational interaction tensors into diagonal relation matrix representations.
//   2. Compute 3-way dot product score <h, r, t> = sum_i (h_i * r_i * t_i).
//   3. Apply L2 weight decay regularization and logistic/sigmoid link scoring.

pub type DistMultConfig = struct {
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    l2_reg: Float,
};

pub type DistMultModel = struct {
    config: DistMultConfig,
    entity_embeddings: List[Float],
    relation_embeddings: List[Float],
};

pub fn distmult_config_new(
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    l2_reg: Float
) -> DistMultConfig {
    return DistMultConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        dim: dim,
        l2_reg: l2_reg,
    };
}

pub fn distmult_model_init(config: DistMultConfig, seed: Int) -> DistMultModel {
    let dim: Int = (config).dim;
    let total_e: Int = (config).num_entities * dim;
    let mut e_emb: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let val: Float = (((state % 1000) as Float) / 500.0) - 1.0;
        e_emb = list_push(e_emb, val);
        i = i + 1;
    }

    let total_r: Int = (config).num_relations * dim;
    let mut r_emb: List[Float] = list_new();
    let mut j: Int = 0;
    while j < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let val: Float = (((state % 1000) as Float) / 500.0) - 1.0;
        r_emb = list_push(r_emb, val);
        j = j + 1;
    }

    return DistMultModel {
        config: config,
        entity_embeddings: e_emb,
        relation_embeddings: r_emb,
    };
}

pub fn distmult_score(
    model: &DistMultModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: DistMultConfig = (*model).config;
    let dim: Int = (cfg).dim;
    let h_off: Int = head * dim;
    let r_off: Int = relation * dim;
    let t_off: Int = tail * dim;

    let mut score: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let h_val: Float = list_get((*model).entity_embeddings, h_off + d);
        let r_val: Float = list_get((*model).relation_embeddings, r_off + d);
        let t_val: Float = list_get((*model).entity_embeddings, t_off + d);
        score = score + (h_val * r_val * t_val);
        d = d + 1;
    }
    return score;
}

pub fn distmult_probability(score: Float) -> Float {
    if score > 40.0 {
        return 1.0;
    }
    if score < 0.0 - 40.0 {
        return 0.0;
    }
    return 1.0 / (1.0 + exp(0.0 - score));
}

pub fn distmult_l2_penalty(
    model: &DistMultModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: DistMultConfig = (*model).config;
    let dim: Int = (cfg).dim;
    let h_off: Int = head * dim;
    let r_off: Int = relation * dim;
    let t_off: Int = tail * dim;

    let mut sum_sq: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let h: Float = list_get((*model).entity_embeddings, h_off + d);
        let r: Float = list_get((*model).relation_embeddings, r_off + d);
        let t: Float = list_get((*model).entity_embeddings, t_off + d);
        sum_sq = sum_sq + (h * h) + (r * r) + (t * t);
        d = d + 1;
    }
    return (cfg).l2_reg * sum_sq;
}
