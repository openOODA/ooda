// # Laplacian Positional Encodings (LapPE)
//
// Logline: Computes Laplacian eigenvector positional encodings with sign-flip invariance for graph transformers.
//
// Setup: Low-frequency spectral coordinate generator establishing canonical spatial node positions on non-Euclidean graphs.
//
// Beats:
//   1. Extract k smallest non-trivial eigenvectors of the normalized graph Laplacian L_sym.
//   2. Apply random sign-flip augmentations during training to handle eigenvector sign ambiguity (+/- v).
//   3. Project spectral coordinates into d-dimensional transformer embedding space via linear MLP.

pub type LapPEConfig = struct {
    num_eigenvectors: Int,
    pe_dim: Int,
};

pub type LapPELayer = struct {
    config: LapPEConfig,
    w_pe: List[Float], // num_eigenvectors * pe_dim
    bias: List[Float], // pe_dim
};

pub fn lap_pe_config_new(k_eig: Int, pe_dim: Int) -> LapPEConfig {
    return LapPEConfig {
        num_eigenvectors: k_eig,
        pe_dim: pe_dim,
    };
}

pub fn lap_pe_layer_init(config: LapPEConfig, seed: Int) -> LapPELayer {
    let k: Int = (config).num_eigenvectors;
    let pe_d: Int = (config).pe_dim;
    let total_w: Int = k * pe_d;
    let mut state: Int = seed;

    let mut w_mat: List[Float] = list_new();
    let scale: Float = sqrt(2.0 / ((k + pe_d) as Float));
    let mut i: Int = 0;
    while i < total_w {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_mat = list_push(w_mat, ((((state % 2000) as Float) / 1000.0) - 1.0) * scale);
        i = i + 1;
    }

    let mut b_vec: List[Float] = list_new();
    let mut j: Int = 0;
    while j < pe_d {
        b_vec = list_push(b_vec, 0.0);
        j = j + 1;
    }

    return LapPELayer {
        config: config,
        w_pe: w_mat,
        bias: b_vec,
    };
}

pub fn lap_pe_transform_node(
    layer: &LapPELayer,
    raw_eigenvectors: List[Float], // Length k_eigenvectors for target node
    sign_flips: List[Float]        // Length k_eigenvectors (+1.0 or -1.0)
) -> List[Float] {
    let cfg: LapPEConfig = (*layer).config;
    let k: Int = (cfg).num_eigenvectors;
    let pe_d: Int = (cfg).pe_dim;

    let mut out_pe: List[Float] = list_new();
    let mut o: Int = 0;
    while o < pe_d {
        let b: Float = list_get((*layer).bias, o);
        let mut dot: Float = 0.0;
        let mut i: Int = 0;
        while i < k {
            let eig_val: Float = list_get(raw_eigenvectors, i);
            let sign: Float = list_get(sign_flips, i);
            let w: Float = list_get((*layer).w_pe, (i * pe_d) + o);
            dot = dot + (eig_val * sign * w);
            i = i + 1;
        }
        let act: Float = if (dot + b) > 0.0 { dot + b } else { 0.0 }; // ReLU
        out_pe = list_push(out_pe, act);
        o = o + 1;
    }
    return out_pe;
}
