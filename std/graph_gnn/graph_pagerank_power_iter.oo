// # PageRank & Personalized PageRank Power Iteration
//
// Logline: Computes stationary random walk distributions via damped power iteration for global and personalized PageRank.
//
// Setup: Stochastic matrix power iteration engine computing eigenvector centrality and localized graph proximity distributions.
//
// Beats:
//   1. Formulate transition probability matrix P = D^{-1} * A with dangling node redistribution.
//   2. Apply damping factor alpha and teleportation preference vector v: p^{(t+1)} = alpha * P^T * p^{(t)} + (1 - alpha) * v.
//   3. Iterate power method until L1 norm convergence criteria ||p^{(t+1)} - p^{(t)}||_1 < eps is reached.

pub type PageRankConfig = struct {
    num_nodes: Int,
    damping_factor: Float, // e.g. 0.85
    max_iterations: Int,
    tolerance: Float,
};

pub fn pagerank_config_new(
    n: Int,
    alpha: Float,
    max_iters: Int,
    tol: Float
) -> PageRankConfig {
    return PageRankConfig {
        num_nodes: n,
        damping_factor: alpha,
        max_iterations: max_iters,
        tolerance: tol,
    };
}

pub fn pagerank_power_iteration_step(
    config: &PageRankConfig,
    current_p: List[Float], // Length num_nodes
    teleport_v: List[Float],// Length num_nodes (uniform or personalized)
    node_in_neighbors: List[List[Int]], // in-neighbors per node
    node_out_degrees: List[Int]         // out-degree per node
) -> List[Float] {
    let n: Int = (*config).num_nodes;
    let alpha: Float = (*config).damping_factor;

    // First: calculate probability mass lost from dangling nodes (out_degree == 0)
    let mut dangling_sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let deg: Int = list_get(node_out_degrees, i);
        if deg == 0 {
            dangling_sum = dangling_sum + list_get(current_p, i);
        }
        i = i + 1;
    }

    let mut next_p: List[Float] = list_new();
    let mut target: Int = 0;
    while target < n {
        let v_tele: Float = list_get(teleport_v, target);
        let in_neighs: List[Int] = list_get(node_in_neighbors, target);
        let num_in: Int = list_len(in_neighs);

        let mut in_flow: Float = 0.0;
        let mut k: Int = 0;
        while k < num_in {
            let src: Int = list_get(in_neighs, k);
            let p_src: Float = list_get(current_p, src);
            let deg_src: Int = list_get(node_out_degrees, src);
            if deg_src > 0 {
                in_flow = in_flow + (p_src / (deg_src as Float));
            }
            k = k + 1;
        }

        // p_next = alpha * (in_flow + dangling_sum / N) + (1 - alpha) * v_tele
        let val: Float = (alpha * (in_flow + (dangling_sum / (n as Float)))) + ((1.0 - alpha) * v_tele);
        next_p = list_push(next_p, val);
        target = target + 1;
    }
    return next_p;
}

pub fn pagerank_l1_diff(p1: List[Float], p2: List[Float]) -> Float {
    let n: Int = list_len(p1);
    let mut diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let v1: Float = list_get(p1, i);
        let v2: Float = list_get(p2, i);
        let d: Float = v1 - v2;
        if d < 0.0 {
            diff = diff + (0.0 - d);
        } else {
            diff = diff + d;
        }
        i = i + 1;
    }
    return diff;
}
