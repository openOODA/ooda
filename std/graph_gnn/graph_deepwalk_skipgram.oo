// # DeepWalk Uniform Random Walks & Skip-Gram
//
// Logline: Generates uniform random walks on network graphs and optimizes node embeddings via Skip-Gram objective.
//
// Setup: Pioneering graph representation learning framework connecting random walk sequences to word2vec language models.
//
// Beats:
//   1. Sample unbiased uniform random walks W = (v_1, v_2, ..., v_L) across graph vertices.
//   2. Extract sliding context windows of size w around target center nodes.
//   3. Optimize Skip-Gram negative sampling loss log(sigmoid(u_c^T v_w)) + sum log(sigmoid(-u_neg^T v_w)).

pub type DeepWalkConfig = struct {
    num_nodes: Int,
    embedding_dim: Int,
    walk_length: Int,
    window_size: Int,
    num_negative_samples: Int
};

pub fn deepwalk_config_new(
    n: Int,
    dim: Int,
    len: Int,
    win: Int,
    neg: Int
) -> DeepWalkConfig {
    return DeepWalkConfig {
        num_nodes: n,
        embedding_dim: dim,
        walk_length: len,
        window_size: win,
        num_negative_samples: neg
    };
}

pub fn deepwalk_sample_walk(
    start_node: Int,
    node_neighbors: List[List[Int]],
    walk_length: Int,
    seed: Int
) -> List[Int] {
    let mut walk: List[Int] = list_new();
    walk = list_push(walk, start_node);

    let mut curr: Int = start_node;
    let mut state: Int = seed;

    let mut step: Int = 1;
    while step < walk_length {
        let neighs: List[Int] = list_get(node_neighbors, curr);
        let deg: Int = list_len(neighs);
        if deg == 0 {
            // Dangling node, stop walk early or repeat curr
            walk = list_push(walk, curr);
        } else {
            state = (state * 1103515245 + 12345) % 2147483647;
            if state < 0 { state = 0 - state; }
            let chosen_idx: Int = state % deg;
            curr = list_get(neighs, chosen_idx);
            walk = list_push(walk, curr);
        }
        step = step + 1;
    }
    return walk;
}

pub fn deepwalk_skipgram_loss_pair(
    target_emb: List[Float],
    t_off: Int,
    context_emb: List[Float],
    c_off: Int,
    neg_embs: List[Float],
    dim: Int,
    num_neg: Int
) -> Float {
    // Positive dot product
    let mut pos_dot: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let vt: Float = list_get(target_emb, t_off + d);
        let vc: Float = list_get(context_emb, c_off + d);
        pos_dot = pos_dot + (vt * vc);
        d = d + 1;
    }

    // Sigmoid log loss for positive pair
    let pos_prob: Float = 1.0 / (1.0 + exp(0.0 - pos_dot));
    let pos_loss: Float = 0.0 - (if pos_prob > 0.000001 { pos_prob } else { 0.000001 });

    // Negative sample loss sum
    let mut neg_loss_sum: Float = 0.0;
    let mut k: Int = 0;
    while k < num_neg {
        let neg_off: Int = k * dim;
        let mut neg_dot: Float = 0.0;
        let mut d2: Int = 0;
        while d2 < dim {
            let vt2: Float = list_get(target_emb, t_off + d2);
            let vn: Float = list_get(neg_embs, neg_off + d2);
            neg_dot = neg_dot + (vt2 * vn);
            d2 = d2 + 1;
        }
        let neg_prob: Float = 1.0 / (1.0 + exp(neg_dot));
        neg_loss_sum = neg_loss_sum + (0.0 - (if neg_prob > 0.000001 { neg_prob } else { 0.000001 }));
        k = k + 1;
    }

    return pos_loss + neg_loss_sum;
}
