// # GraphSAGE Inductive Neighborhood Sampling & Aggregation
//
// Logline: Implements inductive graph representation learning via uniform neighborhood sampling and mean/pool aggregators.
//
// Setup: Scalable mini-batch GNN layer generating embeddings for previously unseen nodes without retraining full graph topologies.
//
// Beats:
//   1. Uniformly sample a fixed-size local neighborhood S(v) of k target nodes.
//   2. Aggregate neighbor feature vectors using Mean or Max-Pooling aggregation operators.
//   3. Concatenate target node features [h_v || h_N(v)], project with W, and L2 normalize.

pub type GraphSAGEConfig = struct {
    in_features: Int,
    out_features: Int,
    sample_size: Int,
    use_pool_aggregator: Bool,
    normalize_output: Bool,
};

pub type GraphSAGELayer = struct {
    config: GraphSAGEConfig,
    weight_concat: List[Float], // (2 * in_features) * out_features
};

pub fn graphsage_config_new(
    in_f: Int,
    out_f: Int,
    sample_size: Int,
    use_pool: Bool,
    norm: Bool
) -> GraphSAGEConfig {
    return GraphSAGEConfig {
        in_features: in_f,
        out_features: out_f,
        sample_size: sample_size,
        use_pool_aggregator: use_pool,
        normalize_output: norm,
    };
}

pub fn graphsage_layer_init(config: GraphSAGEConfig, seed: Int) -> GraphSAGELayer {
    let in_f: Int = (config).in_features;
    let out_f: Int = (config).out_features;
    let total_w: Int = 2 * in_f * out_f;
    let mut w_mat: List[Float] = list_new();
    let mut state: Int = seed;

    let scale: Float = sqrt(2.0 / ((2 * in_f + out_f) as Float));
    let mut i: Int = 0;
    while i < total_w {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_mat = list_push(w_mat, ((((state % 2000) as Float) / 1000.0) - 1.0) * scale);
        i = i + 1;
    }

    return GraphSAGELayer {
        config: config,
        weight_concat: w_mat,
    };
}

pub fn graphsage_aggregate_neighbors(
    layer: &GraphSAGELayer,
    sampled_neighbor_ids: List[Int],
    input_features: List[Float]
) -> List[Float] {
    let cfg: GraphSAGEConfig = (*layer).config;
    let in_f: Int = (cfg).in_features;
    let num_sampled: Int = list_len(sampled_neighbor_ids);

    let mut agg_vec: List[Float] = list_new();
    let mut d: Int = 0;
    while d < in_f {
        if (cfg).use_pool_aggregator {
            let mut max_val: Float = -1000000.0;
            let mut s: Int = 0;
            while s < num_sampled {
                let n_id: Int = list_get(sampled_neighbor_ids, s);
                let v: Float = list_get(input_features, (n_id * in_f) + d);
                if v > max_val {
                    max_val = v;
                }
                s = s + 1;
            }
            let res: Float = if num_sampled > 0 { max_val } else { 0.0 };
            agg_vec = list_push(agg_vec, res);
        } else {
            let mut sum_val: Float = 0.0;
            let mut s2: Int = 0;
            while s2 < num_sampled {
                let n_id2: Int = list_get(sampled_neighbor_ids, s2);
                let v2: Float = list_get(input_features, (n_id2 * in_f) + d);
                sum_val = sum_val + v2;
                s2 = s2 + 1;
            }
            let res_mean: Float = if num_sampled > 0 { sum_val / (num_sampled as Float) } else { 0.0 };
            agg_vec = list_push(agg_vec, res_mean);
        }
        d = d + 1;
    }
    return agg_vec;
}

pub fn graphsage_forward_node(
    layer: &GraphSAGELayer,
    node_id: Int,
    sampled_neighbor_ids: List[Int],
    input_features: List[Float]
) -> List[Float] {
    let cfg: GraphSAGEConfig = (*layer).config;
    let in_f: Int = (cfg).in_features;
    let out_f: Int = (cfg).out_features;

    let h_neigh: List[Float] = graphsage_aggregate_neighbors(layer, sampled_neighbor_ids, input_features);
    let v_off: Int = node_id * in_f;

    // Concatenate [h_v || h_neigh] (length 2 * in_f) and multiply by weight_concat
    let mut out_h: List[Float] = list_new();
    let mut norm_sq: Float = 0.0;

    let mut o: Int = 0;
    while o < out_f {
        let mut dot: Float = 0.0;
        // First part: target node features
        let mut c1: Int = 0;
        while c1 < in_f {
            let xv: Float = list_get(input_features, v_off + c1);
            let wv: Float = list_get((*layer).weight_concat, (c1 * out_f) + o);
            dot = dot + (xv * wv);
            c1 = c1 + 1;
        }
        // Second part: aggregated neighbor features
        let mut c2: Int = 0;
        while c2 < in_f {
            let xn: Float = list_get(h_neigh, c2);
            let wn: Float = list_get((*layer).weight_concat, ((in_f + c2) * out_f) + o);
            dot = dot + (xn * wn);
            c2 = c2 + 1;
        }

        // ReLU non-linearity
        let act: Float = if dot > 0.0 { dot } else { 0.0 };
        norm_sq = norm_sq + (act * act);
        out_h = list_push(out_h, act);
        o = o + 1;
    }

    if (cfg).normalize_output && norm_sq > 0.000001 {
        let norm: Float = sqrt(norm_sq);
        let mut normalized: List[Float] = list_new();
        let mut k: Int = 0;
        while k < out_f {
            normalized = list_push(normalized, list_get(out_h, k) / norm);
            k = k + 1;
        }
        return normalized;
    }

    return out_h;
}
