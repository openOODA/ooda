// # CSR Graph Representation & Layer-Wise Neighbor Sampler
//
// Logline: Implements Compressed Sparse Row (CSR) graph storage and fixed-size layer-wise neighbor sampling for mini-batch GNNs.
//
// Setup: High-performance sparse graph storage and deterministic sampling engine for bounded memory execution.
//
// Beats:
//   1. Represent adjacency in Compressed Sparse Row (CSR) format: row_ptrs and col_indices.
//   2. Sample fixed-size neighbor budgets S_l per layer with uniform pseudo-random sampling.
//   3. Construct multi-layer computational bipartite subgraphs for localized message passing.

pub type CSRGraph = struct {
    num_nodes: Int,
    num_edges: Int,
    row_ptrs: List[Int],    // Length num_nodes + 1
    col_indices: List[Int], // Length num_edges
};

pub fn csr_graph_new(
    n_nodes: Int,
    n_edges: Int,
    row_ptrs: List[Int],
    col_indices: List[Int]
) -> CSRGraph {
    return CSRGraph {
        num_nodes: n_nodes,
        num_edges: n_edges,
        row_ptrs: row_ptrs,
        col_indices: col_indices,
    };
}

pub fn csr_get_neighbors(graph: &CSRGraph, node_id: Int) -> List[Int] {
    let start_idx: Int = list_get((*graph).row_ptrs, node_id);
    let end_idx: Int = list_get((*graph).row_ptrs, node_id + 1);

    let mut neighs: List[Int] = list_new();
    let mut i: Int = start_idx;
    while i < end_idx {
        let target: Int = list_get((*graph).col_indices, i);
        neighs = list_push(neighs, target);
        i = i + 1;
    }
    return neighs;
}

pub fn csr_sample_neighbors_fixed(
    graph: &CSRGraph,
    node_id: Int,
    sample_size: Int,
    seed: Int
) -> List[Int] {
    let start_idx: Int = list_get((*graph).row_ptrs, node_id);
    let end_idx: Int = list_get((*graph).row_ptrs, node_id + 1);
    let degree: Int = end_idx - start_idx;

    let mut sampled: List[Int] = list_new();
    if degree == 0 {
        return sampled;
    }

    let mut state: Int = seed;
    let mut s: Int = 0;
    while s < sample_size {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let offset: Int = state % degree;
        let chosen_node: Int = list_get((*graph).col_indices, start_idx + offset);
        sampled = list_push(sampled, chosen_node);
        s = s + 1;
    }
    return sampled;
}
