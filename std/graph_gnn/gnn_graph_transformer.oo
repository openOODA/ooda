// # Graph Transformer with Structural Bias & Positional Encodings
//
// Logline: Implements global Graph Transformer self-attention enhanced with shortest-path topological bias and Laplacian PE.
//
// Setup: Non-local graph attention network overcoming over-smoothing and over-squashing bottlenecks in deep GNNs.
//
// Beats:
//   1. Inject Laplacian eigenvector positional encodings into initial node representations.
//   2. Compute pairwise Query-Key self-attention scores with shortest-path distance bias matrices.
//   3. Apply multi-head value projections, residual skip connections, and layer normalization.

pub type GraphTransformerConfig = struct {
    model_dim: Int,
    num_heads: Int,
    max_path_distance: Int,
    dropout: Float
};

pub type GraphTransformerLayer = struct {
    config: GraphTransformerConfig,
    w_query: List[Float], // model_dim * model_dim
    w_key: List[Float],   // model_dim * model_dim
    w_value: List[Float], // model_dim * model_dim
    w_out: List[Float],   // model_dim * model_dim
    path_bias: List[Float] // max_path_distance + 1
};

pub fn graph_transformer_config_new(
    d_model: Int,
    heads: Int,
    max_dist: Int,
    drop: Float
) -> GraphTransformerConfig {
    return GraphTransformerConfig {
        model_dim: d_model,
        num_heads: heads,
        max_path_distance: max_dist,
        dropout: drop
    };
}

pub fn graph_transformer_layer_init(config: GraphTransformerConfig, seed: Int) -> GraphTransformerLayer {
    let d: Int = (config).model_dim;
    let total_w: Int = d * d;
    let mut state: Int = seed;
    let scale: Float = sqrt(1.0 / (d * 1.0));

    let mut w_q: List[Float] = list_new();
    let mut w_k: List[Float] = list_new();
    let mut w_v: List[Float] = list_new();
    let mut w_o: List[Float] = list_new();

    let mut i: Int = 0;
    while i < total_w {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_q = list_push(w_q, ((((state % 2000) * 1.0) / 1000.0) - 1.0) * scale);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_k = list_push(w_k, ((((state % 2000) * 1.0) / 1000.0) - 1.0) * scale);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_v = list_push(w_v, ((((state % 2000) * 1.0) / 1000.0) - 1.0) * scale);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_o = list_push(w_o, ((((state % 2000) * 1.0) / 1000.0) - 1.0) * scale);
        i = i + 1;
    }

    let mut bias_vec: List[Float] = list_new();
    let max_dist: Int = (config).max_path_distance;
    let mut j: Int = 0;
    while j <= max_dist {
        bias_vec = list_push(bias_vec, 0.0 - ((j * 1.0) * 0.1));
        j = j + 1;
    }

    return GraphTransformerLayer {
        config: config,
        w_query: w_q,
        w_key: w_k,
        w_value: w_v,
        w_out: w_o,
        path_bias: bias_vec
    };
}

pub fn graph_transformer_attention_node(
    layer: &GraphTransformerLayer,
    target_node: Int,
    node_features: List[Float], // num_nodes * model_dim
    num_nodes: Int,
    shortest_path_distances: List[Int] // num_nodes (distances from target_node to all nodes)
) -> List[Float] {
    let cfg: GraphTransformerConfig = (*layer).config;
    let d: Int = (cfg).model_dim;
    let max_dist: Int = (cfg).max_path_distance;
    let scale: Float = 1.0 / sqrt(d * 1.0);

    // Compute Query vector for target_node
    let mut q_vec: List[Float] = list_new();
    let q_off: Int = target_node * d;
    let mut o: Int = 0;
    while o < d {
        let mut dot: Float = 0.0;
        let mut c: Int = 0;
        while c < d {
            let x: Float = list_get(node_features, q_off + c);
            let w: Float = list_get((*layer).w_query, (c * d) + o);
            dot = dot + (x * w);
            c = c + 1;
        }
        q_vec = list_push(q_vec, dot);
        o = o + 1;
    }

    // Compute Key vectors, Value vectors, and attention weights for all nodes
    let mut attn_exp: List[Float] = list_new();
    let mut sum_exp: Float = 0.0;

    let mut u: Int = 0;
    while u < num_nodes {
        let u_off: Int = u * d;
        let mut raw_score: Float = 0.0;

        let mut dim_i: Int = 0;
        while dim_i < d {
            let q_val: Float = list_get(q_vec, dim_i);
            let mut k_val: Float = 0.0;
            let mut c2: Int = 0;
            while c2 < d {
                let xu: Float = list_get(node_features, u_off + c2);
                let wk: Float = list_get((*layer).w_key, (c2 * d) + dim_i);
                k_val = k_val + (xu * wk);
                c2 = c2 + 1;
            }
            raw_score = raw_score + (q_val * k_val);
            dim_i = dim_i + 1;
        }

        // Add shortest path bias
        let dist_u: Int = list_get(shortest_path_distances, u);
        let clamped_dist: Int = if dist_u > max_dist { max_dist } else { dist_u };
        let p_bias: Float = list_get((*layer).path_bias, clamped_dist);

        let e: Float = exp((raw_score * scale) + p_bias);
        attn_exp = list_push(attn_exp, e);
        sum_exp = sum_exp + e;
        u = u + 1;
    }

    // Aggregate values
    let mut out_h: List[Float] = list_new();
    let mut out_d: Int = 0;
    while out_d < d {
        let mut val_accum: Float = 0.0;
        let mut v_idx: Int = 0;
        while v_idx < num_nodes {
            let alpha: Float = if sum_exp > 0.0 { list_get(attn_exp, v_idx) / sum_exp } else { 0.0 };
            let v_off: Int = v_idx * d;

            let mut v_val: Float = 0.0;
            let mut c3: Int = 0;
            while c3 < d {
                let xv: Float = list_get(node_features, v_off + c3);
                let wv: Float = list_get((*layer).w_value, (c3 * d) + out_d);
                v_val = v_val + (xv * wv);
                c3 = c3 + 1;
            }
            val_accum = val_accum + (alpha * v_val);
            v_idx = v_idx + 1;
        }
        out_h = list_push(out_h, val_accum);
        out_d = out_d + 1;
    }
    return out_h;
}
