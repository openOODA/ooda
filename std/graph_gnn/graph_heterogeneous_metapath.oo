// # Heterogeneous Graph Metapath Random Walks (Metapath2Vec)
//
// Logline: Schema-constrained walks over typed edges.
// residual: &mut destubbed to by-value.

type HeteroGraph = struct {
    num_nodes: Int,
    src_nodes: List[Int],
    src_types: List[Int],
    edge_types: List[Int],
    dst_nodes: List[Int],
    dst_types: List[Int]
};

pub fn hetero_graph_new(num_nodes: Int) -> HeteroGraph {
    return HeteroGraph {
        num_nodes: num_nodes,
        src_nodes: list_new(),
        src_types: list_new(),
        edge_types: list_new(),
        dst_nodes: list_new(),
        dst_types: list_new()
    };
}

pub fn hetero_graph_add_edge(g: HeteroGraph, src: Int, s_type: Int, e_type: Int, dst: Int, d_type: Int) -> HeteroGraph {
    return HeteroGraph {
        num_nodes: g.num_nodes,
        src_nodes: list_push(g.src_nodes, src),
        src_types: list_push(g.src_types, s_type),
        edge_types: list_push(g.edge_types, e_type),
        dst_nodes: list_push(g.dst_nodes, dst),
        dst_types: list_push(g.dst_types, d_type)
    };
}

pub fn sample_metapath_step(graph: HeteroGraph, current_node: Int, expected_edge_type: Int, expected_dst_type: Int, seed: Int) -> Int {
    let total_edges: Int = list_len(graph.src_nodes);
    let mut candidates: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_edges {
        let src: Int = list_get(graph.src_nodes, i);
        let et: Int = list_get(graph.edge_types, i);
        let dt: Int = list_get(graph.dst_types, i);
        if src == current_node {
            if et == expected_edge_type {
                if dt == expected_dst_type {
                    candidates = list_push(candidates, list_get(graph.dst_nodes, i));
                }
            }
        }
        i = i + 1;
    }
    let num_cand: Int = list_len(candidates);
    if num_cand == 0 {
        return current_node;
    }
    let mut state: Int = seed;
    state = ((state * 1103515245) + 12345) % 2147483647;
    if state < 0 {
        state = 0 - state;
    }
    let chosen_idx: Int = state % num_cand;
    return list_get(candidates, chosen_idx);
}
