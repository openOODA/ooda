// # 1-Weisfeiler-Lehman (1-WL) Graph Isomorphism Test
//
// Logline: Implements 1-WL iterative color refinement and histogram hashing to test graph isomorphism and subtree equivalence.
//
// Setup: Canonical combinatorial graph isomorphism tester providing upper bound on standard message-passing GNN expressiveness.
//
// Beats:
//   1. Assign initial discrete color labels to all vertices c_v^{(0)}.
//   2. Hash sorted multiset of neighbor colors c_v^{(t+1)} = hash(c_v^{(t)}, {{c_u^{(t)} : u in N(v)}}).
//   3. Compare compressed color histogram signatures to detect non-isomorphic graph structures.

pub type WLConfig = struct {
    num_iterations: Int,
};

pub fn wl_config_new(iters: Int) -> WLConfig {
    return WLConfig {
        num_iterations: iters,
    };
}

// Simple integer hash mixing function
pub fn wl_hash_combine(seed: Int, val: Int) -> Int {
    let mut h: Int = seed ^ (val + 265443576 + (seed << 6) + (seed >> 2));
    if h < 0 { h = 0 - h; }
    return h % 2147483647;
}

pub fn wl_refine_step(
    current_colors: List[Int],
    node_neighbors: List[List[Int]],
    num_nodes: Int
) -> List[Int] {
    let mut next_colors: List[Int] = list_new();
    let mut v: Int = 0;
    while v < num_nodes {
        let c_v: Int = list_get(current_colors, v);
        let neighs: List[Int] = list_get(node_neighbors, v);
        let num_n: Int = list_len(neighs);

        // Gather and hash neighbor colors
        let mut hash_acc: Int = c_v * 31;
        let mut k: Int = 0;
        while k < num_n {
            let u: Int = list_get(neighs, k);
            let c_u: Int = list_get(current_colors, u);
            hash_acc = wl_hash_combine(hash_acc, c_u);
            k = k + 1;
        }

        next_colors = list_push(next_colors, hash_acc);
        v = v + 1;
    }
    return next_colors;
}

pub fn wl_compare_histograms(
    colors_g1: List[Int],
    colors_g2: List[Int]
) -> Bool {
    let n1: Int = list_len(colors_g1);
    let n2: Int = list_len(colors_g2);
    if n1 != n2 {
        return false;
    }

    // Check multiset equivalence by verifying every color in g1 has matching count in g2
    let mut i: Int = 0;
    while i < n1 {
        let target_c: Int = list_get(colors_g1, i);

        let mut count1: Int = 0;
        let mut j: Int = 0;
        while j < n1 {
            if list_get(colors_g1, j) == target_c {
                count1 = count1 + 1;
            }
            j = j + 1;
        }

        let mut count2: Int = 0;
        let mut k: Int = 0;
        while k < n2 {
            if list_get(colors_g2, k) == target_c {
                count2 = count2 + 1;
            }
            k = k + 1;
        }

        if count1 != count2 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
