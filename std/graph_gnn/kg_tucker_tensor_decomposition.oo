// # TuckER 3-Way Tensor Decomposition Embeddings
//
// Logline: Implements TuckER 3-way tensor decomposition with a shared core tensor for expressive link prediction.
//
// Setup: High-capacity multi-relational representation learning utilizing Tucker tensor factorizations across entities and relations.
//
// Beats:
//   1. Maintain entity embedding matrix E, relation matrix R, and shared 3-way core tensor W.
//   2. Compute 3-mode tensor product W x1 e_h x2 w_r x3 e_t for triplet scoring.
//   3. Apply 1D/2D batch normalization and dropout regularization on intermediate tensor projections.

pub type TuckERConfig = struct {
    num_entities: Int,
    num_relations: Int,
    entity_dim: Int,
    relation_dim: Int,
    dropout: Float
};

pub type TuckERModel = struct {
    config: TuckERConfig,
    entity_embeddings: List[Float],  // num_entities * entity_dim
    relation_embeddings: List[Float],// num_relations * relation_dim
    core_tensor: List[Float]        // entity_dim * relation_dim * entity_dim
};

pub fn tucker_config_new(
    num_entities: Int,
    num_relations: Int,
    d_e: Int,
    d_r: Int,
    dropout: Float
) -> TuckERConfig {
    return TuckERConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        entity_dim: d_e,
        relation_dim: d_r,
        dropout: dropout
    };
}

pub fn tucker_model_init(config: TuckERConfig, seed: Int) -> TuckERModel {
    let de: Int = (config).entity_dim;
    let dr: Int = (config).relation_dim;
    let total_e: Int = (config).num_entities * de;
    let mut e_emb: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        e_emb = list_push(e_emb, (((state % 1000) * 1.0) / 500.0) - 1.0);
        i = i + 1;
    }

    let total_r: Int = (config).num_relations * dr;
    let mut r_emb: List[Float] = list_new();
    let mut j: Int = 0;
    while j < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        r_emb = list_push(r_emb, (((state % 1000) * 1.0) / 500.0) - 1.0);
        j = j + 1;
    }

    let total_w: Int = de * dr * de;
    let mut w_core: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total_w {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_core = list_push(w_core, (((state % 1000) * 1.0) / 500.0) - 1.0);
        k = k + 1;
    }

    return TuckERModel {
        config: config,
        entity_embeddings: e_emb,
        relation_embeddings: r_emb,
        core_tensor: w_core
    };
}

pub fn tucker_score(
    model: &TuckERModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: TuckERConfig = (*model).config;
    let de: Int = (cfg).entity_dim;
    let dr: Int = (cfg).relation_dim;
    let h_off: Int = head * de;
    let r_off: Int = relation * dr;
    let t_off: Int = tail * de;

    let mut score: Float = 0.0;
    let mut i: Int = 0;
    while i < de {
        let eh_i: Float = list_get((*model).entity_embeddings, h_off + i);
        let mut j: Int = 0;
        while j < dr {
            let wr_j: Float = list_get((*model).relation_embeddings, r_off + j);
            let mut k: Int = 0;
            while k < de {
                let w_idx: Int = (i * dr * de) + (j * de) + k;
                let w_ijk: Float = list_get((*model).core_tensor, w_idx);
                let et_k: Float = list_get((*model).entity_embeddings, t_off + k);
                score = score + (w_ijk * eh_i * wr_j * et_k);
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return score;
}
