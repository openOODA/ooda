// # Top-K Graph Pooling (gPool)
//
// Logline: Implements learnable projection vector scoring and graph coarsening via Top-K node selection.
//
// Setup: Parameterized graph downsampling layer projecting node feature vectors onto a 1D learnable direction vector.
//
// Beats:
//   1. Project node representations onto learnable unit direction vector p: y = X * p / ||p||.
//   2. Identify indices of top-k largest scalar projection values.
//   3. Apply soft-gating feature modulation and extract downsampled subgraph representations.

pub type TopKPoolingConfig = struct {
    in_features: Int,
    k_nodes_to_keep: Int,
};

pub type TopKPoolingLayer = struct {
    config: TopKPoolingConfig,
    projection_vector: List[Float], // in_features
};

pub fn topk_pooling_config_new(in_f: Int, k_nodes: Int) -> TopKPoolingConfig {
    return TopKPoolingConfig {
        in_features: in_f,
        k_nodes_to_keep: k_nodes,
    };
}

pub fn topk_pooling_layer_init(config: TopKPoolingConfig, seed: Int) -> TopKPoolingLayer {
    let in_f: Int = (config).in_features;
    let mut p_vec: List[Float] = list_new();
    let mut state: Int = seed;
    let mut norm_sq: Float = 0.0;

    let mut i: Int = 0;
    while i < in_f {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let val: Float = (((state % 1000) as Float) / 500.0) - 1.0;
        p_vec = list_push(p_vec, val);
        norm_sq = norm_sq + (val * val);
        i = i + 1;
    }

    // Normalize p to unit length
    let norm: Float = sqrt(norm_sq);
    let mut unit_p: List[Float] = list_new();
    let mut j: Int = 0;
    while j < in_f {
        let v: Float = list_get(p_vec, j);
        unit_p = list_push(unit_p, if norm > 0.000001 { v / norm } else { 0.0 });
        j = j + 1;
    }

    return TopKPoolingLayer {
        config: config,
        projection_vector: unit_p,
    };
}

pub fn topk_score_node(
    layer: &TopKPoolingLayer,
    node_features: List[Float], // Length in_features
    feat_offset: Int
) -> Float {
    let in_f: Int = (*layer).config.in_features;
    let mut dot: Float = 0.0;
    let mut c: Int = 0;
    while c < in_f {
        let x: Float = list_get(node_features, feat_offset + c);
        let p: Float = list_get((*layer).projection_vector, c);
        dot = dot + (x * p);
        c = c + 1;
    }

    // Tanh gate
    if dot > 20.0 { return 1.0; }
    if dot < -20.0 { return -1.0; }
    let ep: Float = exp(dot);
    let em: Float = exp(0.0 - dot);
    return (ep - em) / (ep + em);
}
