// # RotatE Complex Relational Rotations
//
// Logline: Models knowledge graph relations as element-wise rotations in complex vector space to handle symmetry, inversion, and composition.
//
// Setup: Rotational relational embedder with unit-modulus relation constraints preserving complex algebraic properties.
//
// Beats:
//   1. Map entities to complex vectors and relations to complex phase angles theta.
//   2. Apply Hadamard complex multiplication h \circ r using Euler's formula cos(theta) + i*sin(theta).
//   3. Compute L1/L2 distance metric d(h \circ r, t) in complex Euclidean space.

pub type RotateConfig = struct {
    num_entities: Int,
    num_relations: Int,
    complex_dim: Int, // Number of complex components (real + imag per component)
    margin: Float,
    epsilon: Float
};

pub type RotateModel = struct {
    config: RotateConfig,
    entity_re: List[Float],  // num_entities * complex_dim
    entity_im: List[Float],  // num_entities * complex_dim
    relation_phase: List[Float] // num_relations * complex_dim (angles in radians)
};

pub fn rotate_config_new(
    num_entities: Int,
    num_relations: Int,
    complex_dim: Int,
    margin: Float,
    eps: Float
) -> RotateConfig {
    return RotateConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        complex_dim: complex_dim,
        margin: margin,
        epsilon: eps
    };
}

pub fn rotate_model_init(config: RotateConfig, seed: Int) -> RotateModel {
    let dim: Int = (config).complex_dim;
    let total_e: Int = (config).num_entities * dim;
    let mut e_re: List[Float] = list_new();
    let mut e_im: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let re_val: Float = (((state % 1000) as Float) / 500.0) - 1.0;
        e_re = list_push(e_re, re_val);

        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let im_val: Float = (((state % 1000) as Float) / 500.0) - 1.0;
        e_im = list_push(e_im, im_val);
        i = i + 1;
    }

    let total_r: Int = (config).num_relations * dim;
    let mut r_phase: List[Float] = list_new();
    let pi: Float = 3.141592653589793;
    let mut j: Int = 0;
    while j < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        let phase: Float = (((state % 2000) as Float) / 1000.0 - 1.0) * pi;
        r_phase = list_push(r_phase, phase);
        j = j + 1;
    }

    return RotateModel {
        config: config,
        entity_re: e_re,
        entity_im: e_im,
        relation_phase: r_phase
    };
}

pub fn rotate_score(
    model: &RotateModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: RotateConfig = (*model).config;
    let dim: Int = (cfg).complex_dim;
    let h_off: Int = head * dim;
    let r_off: Int = relation * dim;
    let t_off: Int = tail * dim;

    let mut dist: Float = 0.0;
    let mut d: Int = 0;
    while d < dim {
        let h_r: Float = list_get((*model).entity_re, h_off + d);
        let h_i: Float = list_get((*model).entity_im, h_off + d);
        let theta: Float = list_get((*model).relation_phase, r_off + d);
        let t_r: Float = list_get((*model).entity_re, t_off + d);
        let t_i: Float = list_get((*model).entity_im, t_off + d);

        // Complex rotation: (h_r + i*h_i) * (cos(theta) + i*sin(theta))
        let cos_t: Float = cos(theta);
        let sin_t: Float = sin(theta);
        let rot_re: Float = (h_r * cos_t) - (h_i * sin_t);
        let rot_im: Float = (h_r * sin_t) + (h_i * cos_t);

        let diff_re: Float = rot_re - t_r;
        let diff_im: Float = rot_im - t_i;
        let sq_dist: Float = (diff_re * diff_re) + (diff_im * diff_im);
        dist = dist + sqrt(sq_dist);
        d = d + 1;
    }

    let gamma: Float = (cfg).margin;
    return gamma - dist;
}

pub fn rotate_loss(
    model: &RotateModel,
    pos_score: Float,
    neg_score: Float
) -> Float {
    let cfg: RotateConfig = (*model).config;
    let diff: Float = (cfg).margin - (pos_score - neg_score);
    if diff > 0.0 {
        return diff;
    }
    return 0.0;
}
