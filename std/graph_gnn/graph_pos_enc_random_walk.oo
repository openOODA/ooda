// # Random Walk Positional Encodings (RWPE)
//
// Logline: Computes k-step random walk return landing probabilities [P_{ii}^1, ..., P_{ii}^k] capturing local topological graph motifs.
//
// Setup: Structural positional encoding module measuring return loop counts and localized graph curvature without spectral ambiguity.
//
// Beats:
//   1. Compute powers of random walk transition matrix P = D^{-1} * A for k = 1, ..., K steps.
//   2. Extract diagonal self-return probabilities P_{ii}^k indicating density of k-length cycles.
//   3. Project k-dimensional RWPE feature vectors via linear transformation into transformer hidden dimensions.

pub type RWPEConfig = struct {
    k_steps: Int, // Max random walk steps (e.g. K=16)
    out_dim: Int,
};

pub type RWPELayer = struct {
    config: RWPEConfig,
    projection_weight: List[Float], // k_steps * out_dim
    bias: List[Float],              // out_dim
};

pub fn rwpe_config_new(k_steps: Int, out_d: Int) -> RWPEConfig {
    return RWPEConfig {
        k_steps: k_steps,
        out_dim: out_d,
    };
}

pub fn rwpe_layer_init(config: RWPEConfig, seed: Int) -> RWPELayer {
    let k: Int = (config).k_steps;
    let out_d: Int = (config).out_dim;
    let total_w: Int = k * out_d;
    let mut state: Int = seed;

    let mut w_mat: List[Float] = list_new();
    let scale: Float = sqrt(2.0 / ((k + out_d) as Float));
    let mut i: Int = 0;
    while i < total_w {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        w_mat = list_push(w_mat, ((((state % 2000) as Float) / 1000.0) - 1.0) * scale);
        i = i + 1;
    }

    let mut b_vec: List[Float] = list_new();
    let mut j: Int = 0;
    while j < out_d {
        b_vec = list_push(b_vec, 0.0);
        j = j + 1;
    }

    return RWPELayer {
        config: config,
        projection_weight: w_mat,
        bias: b_vec,
    };
}

pub fn rwpe_transform_node(
    layer: &RWPELayer,
    rw_landing_probs: List[Float] // Length k_steps (P_{ii}^1, ..., P_{ii}^K)
) -> List[Float] {
    let cfg: RWPEConfig = (*layer).config;
    let k: Int = (cfg).k_steps;
    let out_d: Int = (cfg).out_dim;

    let mut out_h: List[Float] = list_new();
    let mut o: Int = 0;
    while o < out_d {
        let b: Float = list_get((*layer).bias, o);
        let mut dot: Float = 0.0;
        let mut step: Int = 0;
        while step < k {
            let p_val: Float = list_get(rw_landing_probs, step);
            let w: Float = list_get((*layer).projection_weight, (step * out_d) + o);
            dot = dot + (p_val * w);
            step = step + 1;
        }
        let act: Float = if (dot + b) > 0.0 { dot + b } else { 0.0 }; // ReLU
        out_h = list_push(out_h, act);
        o = o + 1;
    }
    return out_h;
}
