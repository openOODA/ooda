// # RESCAL Relational Tensor Factorization
//
// Logline: Implements bilinear relational tensor factorization modeling full pairwise interaction matrices per relation.
//
// Setup: Tensor decomposition framework factorizing 3-way adjacency tensors via entity vectors and relation weight matrices.
//
// Beats:
//   1. Represent entities with d-dimensional vectors and relations with d x d full matrices.
//   2. Compute bilinear score h^T * M_r * t = sum_{i,j} (h_i * M_{r,i,j} * t_j).
//   3. Regularize full relation matrices using Frobenius norm regularization.

pub type RESCALConfig = struct {
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    lambda_ent: Float,
    lambda_rel: Float,
};

pub type RESCALModel = struct {
    config: RESCALConfig,
    entity_embeddings: List[Float],  // num_entities * dim
    relation_matrices: List[Float],  // num_relations * (dim * dim)
};

pub fn rescal_config_new(
    num_entities: Int,
    num_relations: Int,
    dim: Int,
    lambda_ent: Float,
    lambda_rel: Float
) -> RESCALConfig {
    return RESCALConfig {
        num_entities: num_entities,
        num_relations: num_relations,
        dim: dim,
        lambda_ent: lambda_ent,
        lambda_rel: lambda_rel,
    };
}

pub fn rescal_model_init(config: RESCALConfig, seed: Int) -> RESCALModel {
    let dim: Int = (config).dim;
    let total_e: Int = (config).num_entities * dim;
    let mut e_emb: List[Float] = list_new();
    let mut state: Int = seed;

    let mut i: Int = 0;
    while i < total_e {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        e_emb = list_push(e_emb, (((state % 1000) * 1.0) / 500.0) - 1.0);
        i = i + 1;
    }

    let total_r: Int = (config).num_relations * dim * dim;
    let mut r_mat: List[Float] = list_new();
    let mut j: Int = 0;
    while j < total_r {
        state = (state * 1103515245 + 12345) % 2147483647;
        if state < 0 { state = 0 - state; }
        r_mat = list_push(r_mat, (((state % 1000) * 1.0) / 500.0) - 1.0);
        j = j + 1;
    }

    return RESCALModel {
        config: config,
        entity_embeddings: e_emb,
        relation_matrices: r_mat,
    };
}

pub fn rescal_score(
    model: &RESCALModel,
    head: Int,
    relation: Int,
    tail: Int
) -> Float {
    let cfg: RESCALConfig = (*model).config;
    let dim: Int = (cfg).dim;
    let h_off: Int = head * dim;
    let r_mat_off: Int = relation * (dim * dim);
    let t_off: Int = tail * dim;

    let mut score: Float = 0.0;
    let mut i: Int = 0;
    while i < dim {
        let h_i: Float = list_get((*model).entity_embeddings, h_off + i);
        let mut j: Int = 0;
        while j < dim {
            let m_ij: Float = list_get((*model).relation_matrices, r_mat_off + (i * dim) + j);
            let t_j: Float = list_get((*model).entity_embeddings, t_off + j);
            score = score + (h_i * m_ij * t_j);
            j = j + 1;
        }
        i = i + 1;
    }
    return score;
}

pub fn rescal_frobenius_norm(
    model: &RESCALModel,
    relation: Int
) -> Float {
    let cfg: RESCALConfig = (*model).config;
    let dim: Int = (cfg).dim;
    let r_mat_off: Int = relation * (dim * dim);
    let total_entries: Int = dim * dim;

    let mut sum_sq: Float = 0.0;
    let mut idx: Int = 0;
    while idx < total_entries {
        let v: Float = list_get((*model).relation_matrices, r_mat_off + idx);
        sum_sq = sum_sq + (v * v);
        idx = idx + 1;
    }
    return sqrt(sum_sq);
}
