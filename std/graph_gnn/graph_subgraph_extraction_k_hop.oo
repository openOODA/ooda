// # K-Hop Subgraph Extraction & Double Radius Node Labeling (DRNL)
//
// Logline: Extracts localized k-hop enclosing subgraphs and assigns relative structural distance coordinates (DRNL) for link prediction.
//
// Setup: Subgraph extraction engine enabling inductive link prediction (SEAL) over variable-sized graph topologies.
//
// Beats:
//   1. Traverse breadth-first search (BFS) to extract k-hop enclosing subgraphs surrounding target node pairs (u, v).
//   2. Compute Double Radius Node Labeling (DRNL) z = 1 + min(d_u, d_v) + (d/2)[(d/2) + (d%2) - 1].
//   3. Mask target edge (u, v) during subgraph embedding to prevent circular information leakage.

pub type SubgraphConfig = struct {
    k_hop: Int,
    max_nodes_per_subgraph: Int,
};

pub fn subgraph_config_new(k: Int, max_nodes: Int) -> SubgraphConfig {
    return SubgraphConfig {
        k_hop: k,
        max_nodes_per_subgraph: max_nodes,
    };
}

// Compute DRNL structural label integer given distance to u (d_u) and distance to v (d_v)
pub fn compute_drnl_label(d_u: Int, d_v: Int) -> Int {
    if (d_u == 0 && d_v == 1) || (d_u == 1 && d_v == 0) {
        return 1; // Target nodes u and v
    }
    if d_u < 0 || d_v < 0 {
        return 0; // Unreachable
    }

    let min_d: Int = if d_u < d_v { d_u } else { d_v };
    let max_d: Int = if d_u > d_v { d_u } else { d_v };
    let d: Int = d_u + d_v;

    // DRNL hash formula
    let half_d: Int = d / 2;
    let d_mod: Int = d % 2;
    let term: Int = (half_d * (half_d + d_mod - 1));
    return 1 + min_d + term + (max_d - min_d);
}

pub fn is_in_list(l: List[Int], target: Int) -> Bool {
    let n: Int = list_len(l);
    let mut i: Int = 0;
    while i < n {
        if list_get(l, i) == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}
