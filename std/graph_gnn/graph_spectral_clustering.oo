// # Spectral Graph Clustering & Normalized Cut
//
// Logline: Implements normalized spectral clustering partitioning graphs via low-frequency Laplacian eigenvectors.
//
// Setup: Non-linear graph partitioning engine projecting complex manifold topologies into low-dimensional Euclidean spaces.
//
// Beats:
//   1. Construct continuous spectral embedding matrix U in R^{N x K} from leading eigenvectors.
//   2. Normalize embedding rows to unit Euclidean sphere: y_i = u_i / ||u_i||.
//   3. Compute cluster centroids and assign nodes to closest partition clusters.

pub type SpectralClusteringConfig = struct {
    num_nodes: Int,
    num_clusters: Int,
    max_kmeans_iters: Int,
};

pub fn spectral_clustering_config_new(
    n: Int,
    k: Int,
    max_iters: Int
) -> SpectralClusteringConfig {
    return SpectralClusteringConfig {
        num_nodes: n,
        num_clusters: k,
        max_kmeans_iters: max_iters,
    };
}

pub fn normalize_spectral_embedding_rows(
    raw_embeddings: List[Float], // num_nodes * num_clusters
    num_nodes: Int,
    num_clusters: Int
) -> List[Float] {
    let mut normalized: List[Float] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        let off: Int = i * num_clusters;
        let mut norm_sq: Float = 0.0;
        let mut c: Int = 0;
        while c < num_clusters {
            let v: Float = list_get(raw_embeddings, off + c);
            norm_sq = norm_sq + (v * v);
            c = c + 1;
        }

        let norm: Float = sqrt(norm_sq);
        let mut c2: Int = 0;
        while c2 < num_clusters {
            let v2: Float = list_get(raw_embeddings, off + c2);
            let norm_val: Float = if norm > 0.000001 { v2 / norm } else { 0.0 };
            normalized = list_push(normalized, norm_val);
            c2 = c2 + 1;
        }
        i = i + 1;
    }
    return normalized;
}

pub fn assign_nodes_to_nearest_centroid(
    norm_embeddings: List[Float], // num_nodes * num_clusters
    centroids: List[Float],       // num_clusters * num_clusters
    num_nodes: Int,
    num_clusters: Int
) -> List[Int] {
    let mut assignments: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        let node_off: Int = i * num_clusters;
        let mut min_dist_sq: Float = 1000000.0;
        let mut best_k: Int = 0;

        let mut k: Int = 0;
        while k < num_clusters {
            let cent_off: Int = k * num_clusters;
            let mut dist_sq: Float = 0.0;
            let mut c: Int = 0;
            while c < num_clusters {
                let xn: Float = list_get(norm_embeddings, node_off + c);
                let xc: Float = list_get(centroids, cent_off + c);
                let diff: Float = xn - xc;
                dist_sq = dist_sq + (diff * diff);
                c = c + 1;
            }
            if dist_sq < min_dist_sq {
                min_dist_sq = dist_sq;
                best_k = k;
            }
            k = k + 1;
        }
        assignments = list_push(assignments, best_k);
        i = i + 1;
    }
    return assignments;
}
