// # Knowledge Graph Link Prediction Evaluation Metrics
//
// Logline: Evaluates knowledge graph embedding models using filtered Mean Rank (MR), Mean Reciprocal Rank (MRR), and Hits@K.
//
// Setup: Benchmark validation module measuring link prediction rank accuracy against ground-truth knowledge triplets.
//
// Beats:
//   1. Filter out known positive triplets from candidate rankings to avoid corrupt rank penalization.
//   2. Compute position rank of ground-truth target entity against all candidate replacements.
//   3. Aggregate Mean Rank (MR), Mean Reciprocal Rank (MRR), and Hits@{1, 3, 10} performance metrics.

pub type LinkPredMetrics = struct {
    mean_rank: Float,
    mrr: Float,
    hits_at_1: Float,
    hits_at_3: Float,
    hits_at_10: Float,
    num_queries: Int,
};

pub fn link_pred_metrics_new() -> LinkPredMetrics {
    return LinkPredMetrics {
        mean_rank: 0.0,
        mrr: 0.0,
        hits_at_1: 0.0,
        hits_at_3: 0.0,
        hits_at_10: 0.0,
        num_queries: 0,
    };
}

pub fn compute_filtered_rank(
    candidate_scores: List[Float],
    true_target_id: Int,
    known_positives: List[Int] // List of entity IDs that are true positives and should be filtered out
) -> Int {
    let true_score: Float = list_get(candidate_scores, true_target_id);
    let total_candidates: Int = list_len(candidate_scores);
    let num_positives: Int = list_len(known_positives);

    let mut rank: Int = 1;
    let mut i: Int = 0;
    while i < total_candidates {
        if i != true_target_id {
            let s: Float = list_get(candidate_scores, i);
            if s > true_score {
                // Check if candidate i is a known true positive to skip
                let mut is_known: Bool = false;
                let mut p: Int = 0;
                while p < num_positives {
                    if list_get(known_positives, p) == i {
                        is_known = true;
                    }
                    p = p + 1;
                }
                if !is_known {
                    rank = rank + 1;
                }
            }
        }
        i = i + 1;
    }
    return rank;
}

pub fn aggregate_rank_metrics(ranks: List[Int]) -> LinkPredMetrics {
    let n: Int = list_len(ranks);
    if n == 0 {
        return link_pred_metrics_new();
    }

    let mut sum_rank: Float = 0.0;
    let mut sum_recip_rank: Float = 0.0;
    let mut h1_count: Int = 0;
    let mut h3_count: Int = 0;
    let mut h10_count: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let r: Int = list_get(ranks, i);
        let r_f: Float = r as Float;
        sum_rank = sum_rank + r_f;
        sum_recip_rank = sum_recip_rank + (1.0 / r_f);

        if r <= 1 { h1_count = h1_count + 1; }
        if r <= 3 { h3_count = h3_count + 1; }
        if r <= 10 { h10_count = h10_count + 1; }
        i = i + 1;
    }

    let total_f: Float = n as Float;
    return LinkPredMetrics {
        mean_rank: sum_rank / total_f,
        mrr: sum_recip_rank / total_f,
        hits_at_1: (h1_count as Float) / total_f,
        hits_at_3: (h3_count as Float) / total_f,
        hits_at_10: (h10_count as Float) / total_f,
        num_queries: n,
    };
}
