// # Typed shell primitives
//
// Logline: Thin process_exec wrappers run trusted shell strings under ProcessCap and fail closed on nonzero exit.
//
// Setup: Callers pass &ProcessCap. Side-effect ops return Result[Void, String]; read ops return Result[String, String].
//
// Beats:
//   1. sh_clean, sh_mkdir_p, sh_copy, sh_chmod, and sh_chmod_recursive mutate a path.
//   2. sh_git_clone and sh_tar_extract fetch or unpack into a destination.
//   3. sh_sleep waits; sh_curl_get and sh_which probe the host.
//   4. sh_env_get and sh_env_get_or read printenv, with a fallback echo.
//   5. sh_md5sum, sh_sha256sum, sh_diff, and sh_grep inspect files.
//   6. sh_basename, sh_dirname, sh_realpath, and sh_tempfile name paths.
//
// residual: thin process_exec wrappers under ProcessCap; shell-string interpolation is the caller's job; no argv facade

import "std/os/process.oo";

// ---- side-effect ops ------------------------------------------------

pub fn sh_clean(p: &ProcessCap, dir: String) -> Result[Void, String]
    requires chars_len(dir) > 0
{
    let r = process_exec(p, "rm -rf " + dir);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_mkdir_p(p: &ProcessCap, dir: String) -> Result[Void, String]
    requires chars_len(dir) > 0
{
    let r = process_exec(p, "mkdir -p " + dir);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_copy(p: &ProcessCap, src: String, dst: String) -> Result[Void, String]
    requires chars_len(src) > 0
    requires chars_len(dst) > 0
{
    let r = process_exec(p, "cp -r " + src + " " + dst);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_chmod(p: &ProcessCap, mode: String, path: String) -> Result[Void, String]
    requires chars_len(mode) > 0
    requires chars_len(path) > 0
{
    let r = process_exec(p, "chmod " + mode + " " + path);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_git_clone(p: &ProcessCap, url: String, dst: String) -> Result[Void, String]
    requires chars_len(url) > 0
    requires chars_len(dst) > 0
{
    let r = process_exec(p, "git clone " + url + " " + dst);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_tar_extract(p: &ProcessCap, arc: String, dst: String) -> Result[Void, String]
    requires chars_len(arc) > 0
    requires chars_len(dst) > 0
{
    let r = process_exec(p, "tar -xzf " + arc + " -C " + dst);
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_chmod_recursive(p: &ProcessCap, path: String, mode: String) -> Result[Void, String]
    requires chars_len(path) > 0
    requires chars_len(mode) > 0
{
    let r = process_exec(p, "find " + path + " -exec chmod " + mode + " {} +");
    if r.is_err() { return r; }
    return Ok(void);
}

pub fn sh_sleep(p: &ProcessCap, sec: Int) -> Result[Void, String]
    requires sec >= 0
{
    let r = process_exec(p, "sleep " + sec.to_string());
    if r.is_err() { return r; }
    return Ok(void);
}

// ---- read ops -------------------------------------------------------

pub fn sh_curl_get(p: &ProcessCap, url: String) -> Result[String, String]
    requires chars_len(url) > 0
{
    return process_exec(p, "curl -s " + url);
}

pub fn sh_which(p: &ProcessCap, name: String) -> Result[String, String]
    requires chars_len(name) > 0
{
    return process_exec(p, "command -v " + name);
}

pub fn sh_env_get(p: &ProcessCap, key: String) -> Result[String, String]
    requires chars_len(key) > 0
{
    return process_exec(p, "printenv " + key);
}

pub fn sh_env_get_or(p: &ProcessCap, key: String, default: String) -> Result[String, String]
    requires chars_len(key) > 0
{
    return process_exec(p, "printenv " + key + " || echo " + default);
}

pub fn sh_md5sum(p: &ProcessCap, path: String) -> Result[String, String]
    requires chars_len(path) > 0
{
    return process_exec(p, "md5sum " + path);
}

pub fn sh_sha256sum(p: &ProcessCap, path: String) -> Result[String, String]
    requires chars_len(path) > 0
{
    return process_exec(p, "sha256sum " + path);
}

pub fn sh_diff(p: &ProcessCap, a: String, b: String) -> Result[String, String]
    requires chars_len(a) > 0
    requires chars_len(b) > 0
{
    return process_exec(p, "diff " + a + " " + b);
}

pub fn sh_grep(p: &ProcessCap, pat: String, path: String) -> Result[String, String]
    requires chars_len(pat) > 0
    requires chars_len(path) > 0
{
    return process_exec(p, "grep " + pat + " " + path);
}

pub fn sh_basename(p: &ProcessCap, path: String) -> Result[String, String]
    requires chars_len(path) > 0
{
    return process_exec(p, "basename " + path);
}

pub fn sh_dirname(p: &ProcessCap, path: String) -> Result[String, String]
    requires chars_len(path) > 0
{
    return process_exec(p, "dirname " + path);
}

pub fn sh_realpath(p: &ProcessCap, path: String) -> Result[String, String]
    requires chars_len(path) > 0
{
    return process_exec(p, "realpath " + path);
}

pub fn sh_tempfile(p: &ProcessCap, template: String) -> Result[String, String]
    requires chars_len(template) > 0
{
    return process_exec(p, "mktemp " + template);
}
