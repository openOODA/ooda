// # 2D Character Canvas Buffer TUI Widget
//
// Logline: Defines a 2D character grid of fixed width and height, supports set_char and get_char, and renders to a newline-separated String for terminal output.
//
// Setup: Pure value-returning helpers, no IO. The canvas is initialized to space characters; coordinates are (x, y) with (0, 0) at the top-left. Out-of-bounds set_char returns Err; out-of-bounds get_char returns Err with a sentinel space.
//
// Beats:
//   1. Construct a CanvasBuffer of size width x height, filled with space characters.
//   2. set_char(x, y, ch) sets the cell; returns Err on out-of-bounds coordinates.
//   3. get_char(x, y) returns the cell; returns Err on out-of-bounds coordinates.
//   4. render_to_string joins rows with newlines and returns the final string.

import "std/core/str.oo";

type CanvasBuffer = struct {
    width: Int,
    height: Int,
    cells: List[String]
};

pub fn canvas_new(width: Int, height: Int) -> CanvasBuffer {
    let mut cells: List[String] = list_new();
    let total: Int = width * height;
    let mut i: Int = 0;
    while i < total {
        cells = list_push(cells, " ");
        i = i + 1;
    }
    return CanvasBuffer {
        width: width,
        height: height,
        cells: cells
    };
}

pub fn canvas_width(c: &CanvasBuffer) -> Int { return (c).width; }

pub fn canvas_height(c: &CanvasBuffer) -> Int { return (c).height; }

pub fn canvas_set_char(mut_c: &mut CanvasBuffer, x: Int, y: Int, ch: String) -> Result[Void, String] {
    let w: Int = (mut_c).width;
    let h: Int = (mut_c).height;
    if x < 0 { return Err("E_CANVAS_OOB: x < 0"); }
    if y < 0 { return Err("E_CANVAS_OOB: y < 0"); }
    if x >= w { return Err("E_CANVAS_OOB: x >= width"); }
    if y >= h { return Err("E_CANVAS_OOB: y >= height"); }
    let idx: Int = (y * w) + x;
    let old_cells: List[String] = (mut_c).cells;
    (mut_c).cells = canvas_replace_at(old_cells, idx, ch);
    return Ok(());
}

pub fn canvas_get_char(c: &CanvasBuffer, x: Int, y: Int) -> Result[String, String] {
    let w: Int = (c).width;
    let h: Int = (c).height;
    if x < 0 { return Err("E_CANVAS_OOB: x < 0"); }
    if y < 0 { return Err("E_CANVAS_OOB: y < 0"); }
    if x >= w { return Err("E_CANVAS_OOB: x >= width"); }
    if y >= h { return Err("E_CANVAS_OOB: y >= height"); }
    let idx: Int = (y * w) + x;
    let cells: List[String] = (c).cells;
    return Ok(list_get(cells, idx));
}

pub fn canvas_replace_at(cells: List[String], idx: Int, ch: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(cells);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, ch);
        } else {
            out = list_push(out, list_get(cells, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn canvas_render_to_string(c: &CanvasBuffer) -> String {
    let w: Int = (c).width;
    let h: Int = (c).height;
    let cells: List[String] = (c).cells;
    let mut out: String = str_concat("R", "C");
    let mut y: Int = 0;
    while y < h {
        let mut x: Int = 0;
        while x < w {
            let idx: Int = (y * w) + x;
            out = str_concat(out, list_get(cells, idx));
            x = x + 1;
        }
        if y < h - 1 { out = str_concat(out, str_concat("X", "Y")); }
        y = y + 1;
    }
    return out;
}

pub fn canvas_clear(mut_c: &mut CanvasBuffer) {
    let w: Int = (mut_c).width;
    let h: Int = (mut_c).height;
    let total: Int = w * h;
    let mut cells: List[String] = list_new();
    let mut i: Int = 0;
    while i < total {
        cells = list_push(cells, " ");
        i = i + 1;
    }
    (mut_c).cells = cells;
}
