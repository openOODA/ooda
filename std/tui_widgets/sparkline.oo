// # Sparkline TUI Widget
//
// Logline: Renders a list of integer or float values into a unicode sparkline string using 8-level block characters, automatically normalizing the scale between the observed minimum and maximum.
//
// Setup: Pure value-returning helpers, no IO. The widget accepts a List[Float] and produces a String. Empty lists produce an empty string; single-element lists render as the mid-level bar.
//
// Beats:
//   1. Compute the minimum and maximum of the input list in a single pass.
//   2. Handle the degenerate case where min == max (all values equal) by rendering a flat mid-level line.
//   3. Map each value to a normalized level 0..7 using the observed min/max range.
//   4. Convert the level to the corresponding unicode block character and concatenate into the result string.

pub fn sparkline_levels() -> List[String] {
    let mut levels: List[String] = list_new();
    levels = list_push(levels, " ");
    levels = list_push(levels, "▂");
    levels = list_push(levels, "▃");
    levels = list_push(levels, "▄");
    levels = list_push(levels, "▅");
    levels = list_push(levels, "▆");
    levels = list_push(levels, "▇");
    levels = list_push(levels, "█");
    return levels;
}

pub fn sparkline_render(values: List[Float]) -> String {
    let n: Int = list_len(values);
    if n == 0 { return ""; }
    if n == 1 { return "▄"; }
    let levels: List[String] = sparkline_levels();
    // First pass: compute min and max.
    let mut mn: Float = list_get(values, 0);
    let mut mx: Float = list_get(values, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(values, i);
        if v < mn { mn = v; }
        if v > mx { mx = v; }
        i = i + 1;
    }
    let mut out: String = "";
    // Degenerate range: render a flat mid-level line.
    if mx == mn {
        let mut j: Int = 0;
        while j < n {
            out = out + "▄";
            j = j + 1;
        }
        return out;
    }
    let range: Float = mx - mn;
    i = 0;
    while i < n {
        let v: Float = list_get(values, i);
        // level = round((v - mn) / range * 7), clamped to [0, 7].
        let norm: Float = (v - mn) / range;
        let scaled: Float = norm * 7.0;
        let mut level: Int = scaled;
        // Round-half-up: if scaled - level >= 0.5, increment.
        let frac: Float = scaled - level;
        if frac >= 0.5 { level = level + 1; }
        if level < 0 { level = 0; }
        if level > 7 { level = 7; }
        let ch: String = list_get(levels, level);
        out = out + ch;
        i = i + 1;
    }
    return out;
}

pub fn sparkline_min(values: List[Float]) -> Float {
    let n: Int = list_len(values);
    if n == 0 { return 0.0; }
    let mut mn: Float = list_get(values, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(values, i);
        if v < mn { mn = v; }
        i = i + 1;
    }
    return mn;
}

pub fn sparkline_max(values: List[Float]) -> Float {
    let n: Int = list_len(values);
    if n == 0 { return 0.0; }
    let mut mx: Float = list_get(values, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(values, i);
        if v > mx { mx = v; }
        i = i + 1;
    }
    return mx;
}
