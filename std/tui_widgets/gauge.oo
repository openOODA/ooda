// # Gauge TUI Widget
//
// Logline: Renders a horizontal progress bar with filled/empty block characters, a percent label, and a color hint (green/yellow/red) chosen by configurable thresholds.
//
// Setup: Pure value-returning helpers, no IO. The widget accepts a percentage in [0, 100] and a width, and produces a String of the form "[████████░░░░░░] 60%". The color hint is returned as a separate String label for terminal-emulator integration.
//
// Beats:
//   1. Render the filled/empty block characters according to the percentage and width.
//   2. Clamp the percentage to [0, 100] to keep the bar in valid bounds.
//   3. Choose a color hint label (green/yellow/red) based on configurable thresholds (defaults 30/70).
//   4. Compose the final "[filled empty] percent%" string with the color hint.

pub fn gauge_color_green() -> String { return "green"; }
pub fn gauge_color_yellow() -> String { return "yellow"; }
pub fn gauge_color_red() -> String { return "red"; }

pub fn gauge_color_for_percent(p: Int, yellow_threshold: Int, red_threshold: Int) -> String {
    if p < yellow_threshold { return gauge_color_green(); }
    if p < red_threshold { return gauge_color_yellow(); }
    return gauge_color_red();
}

pub fn gauge_render(percent: Int, width: Int) -> String {
    let mut p: Int = percent;
    if p < 0 { p = 0; }
    if p > 100 { p = 100; }
    let mut w: Int = width;
    if w < 1 { w = 1; }
    // filled = round(p / 100 * w).
    let mut filled: Int = (p * w) / 100;
    if filled < 0 { filled = 0; }
    if filled > w { filled = w; }
    let mut empty: Int = w - filled;
    if empty < 0 { empty = 0; }
    let mut i: Int = 0;
    let mut out: String = "[";
    while i < filled {
        out = out + "█";
        i = i + 1;
    }
    i = 0;
    while i < empty {
        out = out + "░";
        i = i + 1;
    }
    out = out + "] " + p.to_string() + "%";
    return out;
}

pub fn gauge_render_with_color(percent: Int, width: Int) -> String {
    let color: String = gauge_color_for_percent(percent, 30, 70);
    return color + " " + gauge_render(percent, width);
}

pub fn gauge_default_width() -> Int { return 20; }
