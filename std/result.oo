// # String Result
//
// Logline: Pure helpers construct, test, unwrap, map, and compare a Result of two Strings without panicking.
//
// Setup: Backend-C lowers Result[String, String] as OoResS. This module is pure: no FS, net, or env.
//
// Beats:
//   1. res_ok and res_err construct the two arms.
//   2. res_is_ok and res_is_err name the live arm.
//   3. res_unwrap_or yields the Ok payload or a default.
//   4. res_map_err replaces the Err message; Ok is unchanged.
//   5. res_map_ok_prefix prefixes the Ok payload; Err is unchanged.
//   6. res_ok_eq is true if the Ok payload equals the expected string.
//
// Residual: only String payload; generic Result[T,E] not lowered.

// Construct Ok(v).
pub fn res_ok(v: String) -> Result[String, String] {
    return Ok(v);
}

// Construct Err(msg).
pub fn res_err(msg: String) -> Result[String, String] {
    return Err(msg);
}

// True if the arm is Ok.
pub fn res_is_ok(r: Result[String, String]) -> Bool {
    return r.is_ok();
}

// True if the arm is Err.
pub fn res_is_err(r: Result[String, String]) -> Bool {
    return r.is_err();
}

// Ok payload or default. Never panics.
pub fn res_unwrap_or(r: Result[String, String], d: String) -> String {
    if r.is_ok() {
        let v: String = match r {
            Ok(x) => x,
            Err(y) => y
        };
        return v;
    }
    return d;
}

// Replace the Err message. Ok payload is unchanged.
pub fn res_map_err(r: Result[String, String], msg: String) -> Result[String, String] {
    if r.is_ok() {
        let v: String = match r {
            Ok(x) => x,
            Err(y) => y
        };
        return Ok(v);
    }
    return Err(msg);
}

// Prefix the Ok payload. Err is unchanged.
// Uses res_unwrap_or instead of match-assign (type hole).
pub fn res_map_ok_prefix(r: Result[String, String], pre: String) -> Result[String, String] {
    if r.is_err() {
        return r;
    }
    let v: String = res_unwrap_or(r, "");
    return Ok(pre + v);
}

// True if the Ok payload equals want. Err is false.
pub fn res_ok_eq(r: Result[String, String], want: String) -> Bool {
    if r.is_err() {
        return false;
    }
    let v: String = res_unwrap_or(r, "");
    if v == want {
        return true;
    }
    return false;
}

// Monadic map: apply transform if Ok, propagate Err.
pub fn res_map(r: Result[String, String], suffix: String) -> Result[String, String] {
    if r.is_err() {
        return r;
    }
    let v: String = res_unwrap_or(r, "");
    return Ok(v + suffix);
}

// Monadic and_then: chain dependent operation if Ok, propagate Err.
pub fn res_and_then(r: Result[String, String], next_val: String) -> Result[String, String] {
    if r.is_err() {
        return r;
    }
    return Ok(next_val);
}

// Provide fallback Result if Err.
pub fn res_or_else(r: Result[String, String], fallback: String) -> Result[String, String] {
    if r.is_ok() {
        return r;
    }
    return Ok(fallback);
}

