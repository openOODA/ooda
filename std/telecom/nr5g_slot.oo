// # 5G NR Slot Format & Resource Grid Allocation
//
// Logline: Manages 5G NR slot formatting, DL/UL/Flexible symbol patterns, and physical resource grid mapping.
//
// Setup: Pure telecom module implementing 3GPP TS 38.213 slot format combinations and symbol assignments.
//
// Beats:
//   1. Define slot format configuration and transmission direction enumerations.
//   2. Classify individual OFDM symbols as Downlink, Uplink, or Flexible per slot pattern.
//   3. Validate physical shared channel (PDSCH/PUSCH) symbol allocation boundaries.

pub type Nr5gSlotFormat = struct {
    format_id: Int,
    num_dl_symbols: Int,
    num_ul_symbols: Int,
    num_flex_symbols: Int,
    is_extended_cp: Bool
};

pub type Nr5gSymbolAllocation = struct {
    start_symbol: Int,
    num_symbols: Int,
    is_downlink: Bool
};

pub fn nr5g_slot_format_new(format_id: Int, num_dl: Int, num_ul: Int, is_ext_cp: Bool) -> Nr5gSlotFormat {
    let mut total_syms: Int = 14;
    if is_ext_cp {
        total_syms = 12;
    }

    let mut dl: Int = num_dl;
    if dl > total_syms {
        dl = total_syms;
    }
    let mut ul: Int = num_ul;
    if (dl + ul) > total_syms {
        ul = total_syms - dl;
    }
    let flex: Int = total_syms - (dl + ul);

    return Nr5gSlotFormat {
        format_id: format_id,
        num_dl_symbols: dl,
        num_ul_symbols: ul,
        num_flex_symbols: flex,
        is_extended_cp: is_ext_cp
    };
}

pub fn nr5g_slot_total_symbols(slot: &Nr5gSlotFormat) -> Int {
    if (slot).is_extended_cp {
        return 12;
    }
    return 14;
}

pub fn nr5g_slot_symbol_direction(slot: &Nr5gSlotFormat, symbol_idx: Int) -> Int {
    // Returns: 0 = Downlink (DL), 1 = Uplink (UL), 2 = Flexible (F)
    let total: Int = nr5g_slot_total_symbols(slot);
    if symbol_idx < 0 {
        return 2;
    }
    if symbol_idx >= total {
        return 2;
    }

    if symbol_idx < (slot).num_dl_symbols {
        return 0;
    }

    let ul_start: Int = total - (slot).num_ul_symbols;
    if symbol_idx >= ul_start {
        return 1;
    }

    return 2;
}

pub fn nr5g_slot_validate_pdsch_alloc(slot: &Nr5gSlotFormat, alloc: &Nr5gSymbolAllocation) -> Bool {
    let total: Int = nr5g_slot_total_symbols(slot);
    if (alloc).start_symbol < 0 {
        return false;
    }
    if (alloc).num_symbols <= 0 {
        return false;
    }
    let end_sym: Int = (alloc).start_symbol + (alloc).num_symbols;
    if end_sym > total {
        return false;
    }

    let mut i: Int = (alloc).start_symbol;
    while i < end_sym {
        let dir: Int = nr5g_slot_symbol_direction(slot, i);
        // PDSCH can only use DL (0) or Flexible (2)
        if dir == 1 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn nr5g_slot_validate_pusch_alloc(slot: &Nr5gSlotFormat, alloc: &Nr5gSymbolAllocation) -> Bool {
    let total: Int = nr5g_slot_total_symbols(slot);
    if (alloc).start_symbol < 0 {
        return false;
    }
    if (alloc).num_symbols <= 0 {
        return false;
    }
    let end_sym: Int = (alloc).start_symbol + (alloc).num_symbols;
    if end_sym > total {
        return false;
    }

    let mut i: Int = (alloc).start_symbol;
    while i < end_sym {
        let dir: Int = nr5g_slot_symbol_direction(slot, i);
        // PUSCH can only use UL (1) or Flexible (2)
        if dir == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn nr5g_slot_guard_period_symbols(slot: &Nr5gSlotFormat) -> Int {
    return (slot).num_flex_symbols;
}
