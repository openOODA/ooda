// # Radio Cyclic Redundancy Check (CRC) Algorithms
//
// Logline: Implements 3GPP and IEEE radio CRC generators: CRC-8, CRC-11, CRC-16, CRC-24A/B/C, and CRC-32.
//
// Setup: Pure telecom error detection module for transport block and control channel validation.
//
// Beats:
//   1. Define CRC polynomial parameters and initial remainder state.
//   2. Compute bitwise modulo-2 polynomial division across byte buffers.
//   3. Verify frame syndrome residues and detect transport block transmission errors.

pub type CrcRadioSpec = struct {
    width_bits: Int,
    polynomial: Int,
    init_val: Int,
    xor_out: Int
};

pub fn crc_radio_spec_crc8_lte() -> CrcRadioSpec {
    // 3GPP TS 36.212 Section 5.1.1: g_CRC8(D) = [D^8 + D^7 + D^4 + D^3 + D + 1] -> 0x9B (155)
    return CrcRadioSpec {
        width_bits: 8,
        polynomial: 155,
        init_val: 0,
        xor_out: 0
    };
}

pub fn crc_radio_spec_crc11_nr() -> CrcRadioSpec {
    // 3GPP TS 38.212 Section 5.1: g_CRC11(D) -> 0x621 (1569)
    return CrcRadioSpec {
        width_bits: 11,
        polynomial: 1569,
        init_val: 0,
        xor_out: 0
    };
}

pub fn crc_radio_spec_crc16_ccitt() -> CrcRadioSpec {
    // CCITT polynomial 0x1021 (4129)
    return CrcRadioSpec {
        width_bits: 16,
        polynomial: 4129,
        init_val: 65535,
        xor_out: 0
    };
}

pub fn crc_radio_spec_crc24a_lte() -> CrcRadioSpec {
    // 3GPP TS 36.212: g_CRC24A(D) -> 0x864CFB (8801531)
    return CrcRadioSpec {
        width_bits: 24,
        polynomial: 8801531,
        init_val: 0,
        xor_out: 0
    };
}

pub fn crc_radio_spec_crc24b_lte() -> CrcRadioSpec {
    // 3GPP TS 36.212: g_CRC24B(D) -> 0x800063 (8388707)
    return CrcRadioSpec {
        width_bits: 24,
        polynomial: 8388707,
        init_val: 0,
        xor_out: 0
    };
}

pub fn crc_radio_spec_crc24c_nr() -> CrcRadioSpec {
    // 3GPP TS 38.212: g_CRC24C(D) -> 0xB2B117 (11710743)
    return CrcRadioSpec {
        width_bits: 24,
        polynomial: 11710743,
        init_val: 0,
        xor_out: 0
    };
}

pub fn crc_radio_mask_for_width(width: Int) -> Int {
    if width == 8 { return 255; }
    if width == 11 { return 2047; }
    if width == 16 { return 65535; }
    if width == 24 { return 16777215; }
    if width == 32 { return 2147483647; }
    return 255;
}

pub fn crc_radio_step_bit(crc: Int, bit: Int, poly: Int, width: Int) -> Int {
    let top_bit_mask: Int = 1 << (width - 1);
    let full_mask: Int = crc_radio_mask_for_width(width);

    let msb_set: Bool = (crc & top_bit_mask) != 0;
    let shifted: Int = ((crc << 1) | (bit & 1)) & full_mask;

    if msb_set {
        return shifted ^ poly;
    }
    return shifted;
}

pub fn crc_radio_verify(calculated_crc: Int, expected_crc: Int) -> Bool {
    return calculated_crc == expected_crc;
}
