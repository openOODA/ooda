// # Finite Impulse Response (FIR) Filter Engine
//
// Logline: Implements digital FIR filter convolution, windowed sinc tap design, and group delay analysis.
//
// Setup: Pure digital signal processing filter library for linear-phase channel filtering.
//
// Beats:
//   1. Define FIR filter state, tap coefficient records, and delay line memory.
//   2. Generate windowed sinc coefficients for Lowpass, Highpass, and Bandpass responses.
//   3. Compute sample convolution, evaluate linear phase group delay, and verify BIBO stability.

pub type FirFilterConfig = struct {
    num_taps: Int,
    cutoff_norm_freq: Float,
    window_type: Int
};

pub fn fir_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn fir_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn fir_config_new(num_taps: Int, cutoff: Float, window_type: Int) -> FirFilterConfig {
    return FirFilterConfig {
        num_taps: num_taps,
        cutoff_norm_freq: cutoff,
        window_type: window_type
    };
}

pub fn fir_sinc_tap(tap_idx: Int, num_taps: Int, cutoff: Float) -> Float {
    let m: Float = fir_int_to_float(num_taps - 1) / 2.0;
    let n: Float = fir_int_to_float(tap_idx) - m;

    if n == 0.0 {
        return 2.0 * cutoff;
    }

    let pi_val: Float = fir_pi();
    let numerator: Float = sin(2.0 * pi_val * cutoff * n);
    let denominator: Float = pi_val * n;

    return numerator / denominator;
}

pub fn fir_window_weight(tap_idx: Int, num_taps: Int, window_type: Int) -> Float {
    if num_taps <= 1 {
        return 1.0;
    }

    let pi_val: Float = fir_pi();
    let two_pi: Float = 2.0 * pi_val;
    let n_f: Float = fir_int_to_float(tap_idx);
    let m_f: Float = fir_int_to_float(num_taps - 1);
    let norm_pos: Float = n_f / m_f;

    // 0 = Rectangular
    if window_type == 0 {
        return 1.0;
    }
    // 1 = Hann
    if window_type == 1 {
        return 0.5 - (0.5 * cos(two_pi * norm_pos));
    }
    // 2 = Hamming
    if window_type == 2 {
        return 0.54 - (0.46 * cos(two_pi * norm_pos));
    }
    // 3 = Blackman
    if window_type == 3 {
        let term1: Float = 0.42;
        let term2: Float = 0.50 * cos(two_pi * norm_pos);
        let term3: Float = 0.08 * cos(4.0 * pi_val * norm_pos);
        return (term1 - term2) + term3;
    }

    return 1.0;
}

pub fn fir_calc_tap_coeff(tap_idx: Int, num_taps: Int, cutoff: Float, window_type: Int) -> Float {
    let sinc_val: Float = fir_sinc_tap(tap_idx, num_taps, cutoff);
    let win_val: Float = fir_window_weight(tap_idx, num_taps, window_type);
    return sinc_val * win_val;
}

pub fn fir_group_delay_samples(num_taps: Int) -> Float {
    return fir_int_to_float(num_taps - 1) / 2.0;
}

pub fn fir_is_stable() -> Bool {
    // FIR filters with finite tap weights are unconditionally BIBO stable
    return true;
}
