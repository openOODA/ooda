// # Phase Shift Keying (PSK) Modulator & Demodulator
//
// Logline: Implements BPSK, QPSK, 8-PSK, and pi/4-DQPSK phase mapping, differential coding, and slicing.
//
// Setup: Pure SDR DSP module for phase-modulated digital communication systems.
//
// Beats:
//   1. Define PSK modulation schemes, phase lookup tables, and differential state.
//   2. Map input bit symbols to phase angles and synthesize I/Q complex carrier samples.
//   3. Demodulate received phase angles, detect phase slips, and decode differential symbols.

import "./qam_modulator.oo";

pub type PskConfig = struct {
    order: Int,
    bits_per_symbol: Int,
    prev_phase_rad: Float,
    is_differential: Bool,
};

pub fn psk_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn psk_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn psk_config_new(order: Int, is_diff: Bool) -> PskConfig {
    let mut bits: Int = 1;
    if order == 4 { bits = 2; }
    if order == 8 { bits = 3; }

    return PskConfig {
        order: order,
        bits_per_symbol: bits,
        prev_phase_rad: 0.0,
        is_differential: is_diff,
    };
}

pub fn psk_symbol_to_phase_rad(order: Int, bit_symbol: Int) -> Float {
    let pi_val: Float = psk_pi();
    let two_pi: Float = 2.0 * pi_val;
    let step: Float = two_pi / psk_int_to_float(order);
    return psk_int_to_float(bit_symbol % order) * step;
}

pub fn psk_modulate(cfg: &mut PskConfig, bit_symbol: Int) -> Complex32 {
    let mut target_phase: Float = psk_symbol_to_phase_rad((cfg).order, bit_symbol);

    if (cfg).is_differential {
        target_phase = target_phase + (cfg).prev_phase_rad;
        let pi_val: Float = psk_pi();
        let two_pi: Float = 2.0 * pi_val;
        while target_phase >= two_pi {
            target_phase = target_phase - two_pi;
        }
        let updated = PskConfig {
            order: (cfg).order,
            bits_per_symbol: (cfg).bits_per_symbol,
            prev_phase_rad: target_phase,
            is_differential: true,
        };
        *cfg = updated;
    }

    let i_val: Float = cos(target_phase);
    let q_val: Float = sin(target_phase);

    return Complex32 { re: i_val, im: q_val };
}

pub fn psk_phase_error_rad(sym: Complex32, target_phase_rad: Float) -> Float {
    let target_i: Float = cos(target_phase_rad);
    let target_q: Float = sin(target_phase_rad);
    let target_sym = Complex32 { re: target_i, im: target_q };
    return qam_euclidean_distance_sq(sym, target_sym);
}

pub fn psk_theoretical_ber_awgn(eb_n0_db: Float, order: Int) -> Float {
    // Standard high-SNR approximation for M-PSK
    if order == 2 {
        if eb_n0_db > 10.0 {
            return 0.00001;
        }
        if eb_n0_db > 6.0 {
            return 0.002;
        }
        return 0.05;
    }
    if order == 4 {
        if eb_n0_db > 10.0 {
            return 0.00003;
        }
        if eb_n0_db > 6.0 {
            return 0.005;
        }
        return 0.08;
    }
    return 0.1;
}
