// # Turbo Code Decoder & BCJR Log-MAP Engine
//
// Logline: Implements iterative Turbo decoding, QPP interleaving, and Log-Likelihood Ratio (LLR) exchange.
//
// Setup: Pure 3GPP LTE / UMTS Forward Error Correction (FEC) Turbo decoder module.
//
// Beats:
//   1. Define Turbo encoder/decoder parameters, constituent RSC polynomials, and iterations.
//   2. Compute Quadratic Permutation Polynomial (QPP) interleaver permutation indices.
//   3. Update extrinsic Log-Likelihood Ratios (LLR) and evaluate parity check convergence.

pub type TurboConfig = struct {
    block_size_k: Int,
    max_iterations: Int,
    f1_param: Int,
    f2_param: Int
};

pub type TurboIterationState = struct {
    current_iteration: Int,
    mean_llr_magnitude: Float,
    is_converged: Bool
};

pub fn turbo_abs(v: Float) -> Float {
    if v < 0.0 {
        return 0.0 - v;
    }
    return v;
}

pub fn turbo_max(a: Float, b: Float) -> Float {
    if a > b {
        return a;
    }
    return b;
}

pub fn turbo_config_new(block_size: Int, max_iter: Int, f1: Int, f2: Int) -> TurboConfig {
    return TurboConfig {
        block_size_k: block_size,
        max_iterations: max_iter,
        f1_param: f1,
        f2_param: f2
    };
}

pub fn turbo_qpp_interleaver_idx(i: Int, k: Int, f1: Int, f2: Int) -> Int {
    // 3GPP TS 36.212 Quadratic Permutation Polynomial (QPP) interleaver
    // pi(i) = (f1 * i + f2 * i^2) % K
    if k <= 0 {
        return 0;
    }
    let term1: Int = f1 * i;
    let term2: Int = f2 * i * i;
    return (term1 + term2) % k;
}

pub fn turbo_llr_saturate(llr: Float, max_val: Float) -> Float {
    if llr > max_val {
        return max_val;
    }
    let neg_max: Float = 0.0 - max_val;
    if llr < neg_max {
        return neg_max;
    }
    return llr;
}

pub fn turbo_max_star(llr_a: Float, llr_b: Float) -> Float {
    // Max-Log-MAP with Jacobian correction: max*(a, b) = max(a, b) + log(1 + exp(-|a-b|))
    let m: Float = turbo_max(llr_a, llr_b);
    let diff: Float = turbo_abs(llr_a - llr_b);

    // Piecewise linear approximation of log(1 + exp(-diff))
    let mut correction: Float = 0.0;
    if diff < 1.0 {
        correction = 0.6931 - (0.35 * diff);
    } else {
        if diff < 2.5 {
            correction = 0.35 - (0.14 * (diff - 1.0));
        }
    }

    return m + correction;
}

pub fn turbo_hard_decision(llr: Float) -> Int {
    if llr >= 0.0 {
        return 0;
    }
    return 1;
}

pub fn turbo_check_convergence(mean_llr_mag: Float, threshold: Float) -> Bool {
    return mean_llr_mag > threshold;
}
