// # Signal-to-Noise Ratio (SNR) Estimation Algorithms
//
// Logline: Estimates SNR and SINR using M2M4 moments, EVM conversion, and Shannon channel capacity.
//
// Setup: Pure telecom measurement module for wireless link quality estimation.
//
// Beats:
//   1. Define statistical moment accumulators and signal power metrics.
//   2. Compute SNR using the 2nd and 4th order moment estimator (M2M4).
//   3. Convert constellation EVM to equivalent SNR and compute Shannon channel capacity.

pub type SnrMetrics = struct {
    signal_power_watts: Float,
    noise_power_watts: Float,
    snr_linear: Float,
    snr_db: Float,
};

pub fn snr_ln_approx(x: Float) -> Float {
    if x <= 0.000001 {
        return 0.0 - 13.8155;
    }
    // Bring into range [0.5, 1.5] by scaling by e (~2.71828)
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.718281828459045;
        k = k + 1.0;
    }
    while val < 0.7 {
        val = val * 2.718281828459045;
        k = k - 1.0;
    }

    // Series expansion: ln((1+y)/(1-y)) where y = (val-1)/(val+1)
    let y: Float = (val - 1.0) / (val + 1.0);
    let y2: Float = y * y;
    let y3: Float = y2 * y;
    let y5: Float = y3 * y2;
    let ln_val: Float = 2.0 * (y + (y3 / 3.0) + (y5 / 5.0));

    return ln_val + k;
}

pub fn snr_log10_approx(x: Float) -> Float {
    return snr_ln_approx(x) / 2.302585092994046;
}

pub fn snr_log2_approx(x: Float) -> Float {
    return snr_ln_approx(x) / 0.6931471805599453;
}

pub fn snr_linear_to_db(snr_lin: Float) -> Float {
    if snr_lin <= 0.000001 {
        return 0.0 - 60.0;
    }
    return 10.0 * snr_log10_approx(snr_lin);
}

pub fn snr_estimate_m2m4(m2: Float, m4: Float) -> Float {
    // 2nd moment M2 = S + N, 4th moment M4 = ka*S^2 + 4*S*N + 2*N^2
    // For QPSK/BPSK ka=1: 2*M2^2 - M4 = S^2
    let term: Float = (2.0 * m2 * m2) - m4;
    let mut sig_sq: Float = 0.0;
    if term > 0.0 {
        sig_sq = term;
    }
    let s_pwr: Float = sqrt(sig_sq);
    let n_pwr: Float = m2 - s_pwr;
    if n_pwr <= 0.000001 {
        return 1000.0;
    }
    return s_pwr / n_pwr;
}

pub fn snr_evm_to_snr_db(evm_rms_percent: Float) -> Float {
    if evm_rms_percent <= 0.01 {
        return 40.0;
    }
    let evm_ratio: Float = evm_rms_percent / 100.0;
    let snr_lin: Float = 1.0 / (evm_ratio * evm_ratio);
    return snr_linear_to_db(snr_lin);
}

pub fn snr_shannon_capacity_bps(bandwidth_hz: Float, snr_linear: Float) -> Float {
    let cap_per_hz: Float = snr_log2_approx(1.0 + snr_linear);
    return bandwidth_hz * cap_per_hz;
}

pub fn snr_calc_sinr_db(sig_pwr: Float, noise_pwr: Float, interf_pwr: Float) -> Float {
    let total_noise: Float = noise_pwr + interf_pwr;
    if total_noise <= 0.000001 {
        return 60.0;
    }
    let sinr_lin: Float = sig_pwr / total_noise;
    return snr_linear_to_db(sinr_lin);
}
