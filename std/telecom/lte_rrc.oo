// # LTE Radio Resource Control (RRC) State Machine
//
// Logline: Models 3GPP LTE RRC protocol states, connection establishment, and mobility measurements.
//
// Setup: Pure telecom protocol state engine for LTE / E-UTRAN Radio Resource Control.
//
// Beats:
//   1. Define RRC states, transaction identifiers, and connection lifecycle records.
//   2. Manage state transitions for Connection Request, Setup, Reconfiguration, and Release.
//   3. Evaluate signal strength measurement events (A1..A5) for cell handover.

pub type LteRrcState = struct {
    state_id: Int,
    transaction_id: Int,
    ue_identity: Int,
    is_security_active: Bool,
    bearer_count: Int,
};

pub type LteRrcMeasurement = struct {
    rsrp_dbm: Float,
    rsrq_db: Float,
    serving_cell_rsrp: Float,
    threshold_rsrp: Float,
};

pub fn lte_rrc_new(ue_id: Int) -> LteRrcState {
    // state_id: 0 = RRC_IDLE, 1 = RRC_CONNECTING, 2 = RRC_CONNECTED, 3 = RRC_INACTIVE
    return LteRrcState {
        state_id: 0,
        transaction_id: 1,
        ue_identity: ue_id,
        is_security_active: false,
        bearer_count: 0,
    };
}

pub fn lte_rrc_is_connected(rrc: &LteRrcState) -> Bool {
    return (rrc).state_id == 2;
}

pub fn lte_rrc_connection_request(rrc: &mut LteRrcState) -> Bool {
    if (rrc).state_id == 0 {
        let new_tx: Int = (rrc).transaction_id + 1;
        let s = LteRrcState {
            state_id: 1,
            transaction_id: new_tx,
            ue_identity: (rrc).ue_identity,
            is_security_active: (rrc).is_security_active,
            bearer_count: (rrc).bearer_count,
        };
        *rrc = s;
        return true;
    }
    return false;
}

pub fn lte_rrc_connection_setup_complete(rrc: &mut LteRrcState) -> Bool {
    if (rrc).state_id == 1 {
        let new_tx: Int = (rrc).transaction_id + 1;
        let s = LteRrcState {
            state_id: 2,
            transaction_id: new_tx,
            ue_identity: (rrc).ue_identity,
            is_security_active: true,
            bearer_count: 1,
        };
        *rrc = s;
        return true;
    }
    return false;
}

pub fn lte_rrc_connection_release(rrc: &mut LteRrcState) -> Bool {
    if (rrc).state_id == 2 {
        let new_tx: Int = (rrc).transaction_id + 1;
        let s = LteRrcState {
            state_id: 0,
            transaction_id: new_tx,
            ue_identity: (rrc).ue_identity,
            is_security_active: false,
            bearer_count: 0,
        };
        *rrc = s;
        return true;
    }
    return false;
}

pub fn lte_rrc_eval_a3_handover(meas: &LteRrcMeasurement, a3_offset_db: Float, hyst_db: Float) -> Bool {
    // Event A3: Neighbor becomes offset better than serving
    // Condition: Mn + Ofn + Ocn - Hys > Ms + Ofs + Ocs + Off
    let neighbor_score: Float = (meas).rsrp_dbm - hyst_db;
    let serving_score: Float = (meas).serving_cell_rsrp + a3_offset_db;
    return neighbor_score > serving_score;
}

pub fn lte_rrc_eval_a1_serving_better_than_threshold(meas: &LteRrcMeasurement, hyst_db: Float) -> Bool {
    // Event A1: Serving becomes better than threshold
    return ((meas).serving_cell_rsrp - hyst_db) > (meas).threshold_rsrp;
}

pub fn lte_rrc_eval_a2_serving_worse_than_threshold(meas: &LteRrcMeasurement, hyst_db: Float) -> Bool {
    // Event A2: Serving becomes worse than threshold
    return ((meas).serving_cell_rsrp + hyst_db) < (meas).threshold_rsrp;
}
