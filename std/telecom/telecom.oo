// # Telecom & SDR Signal Processing Facade
//
// Logline: Re-exports 5G NR, LTE, SDR streaming, modulation, DSP filters, FEC, and beamforming submodules.
//
// Setup: Pure standard library facade module importing all telecom companion submodules.
//
// Beats:
//   1. Import all 24 telecom domain submodules.
//   2. Provide typed shim markers exercising symbols across the entire stack.
//   3. Maintain backwards compatibility and API discoverability for telecom consumers.

import "./nr5g_frame.oo";
import "./nr5g_slot.oo";
import "./nr5g_subcarrier.oo";
import "./lte_rrc.oo";
import "./lte_pdcp.oo";
import "./qam_modulator.oo";
import "./psk_modulator.oo";
import "./sdr_buffer.oo";
import "./sdr_stream.oo";
import "./ofdm_demod.oo";
import "./fft_radix2.oo";
import "./ifft_radix2.oo";
import "./dsp_filter_fir.oo";
import "./dsp_filter_iir.oo";
import "./channel_equalizer.oo";
import "./snr_estimator.oo";
import "./viterbi_decoder.oo";
import "./turbo_decoder.oo";
import "./crc_radio.oo";
import "./constellation_diagram.oo";
import "./spectrum_analyzer.oo";
import "./doppler_shift.oo";
import "./beamforming_weights.oo";
import "./telecom_stubs.oo";

pub fn shim_marker_nr5g_frame_new() -> Nr5gFrameConfig {
    return nr5g_frame_config_new(1, 0);
}

pub fn shim_marker_nr5g_slot_format() -> Nr5gSlotFormat {
    return nr5g_slot_format_new(0, 14, 0, false);
}

pub fn shim_marker_nr5g_carrier_grid() -> Nr5gCarrierGrid {
    return nr5g_carrier_grid_new(3500000000.0, 30, 51);
}

pub fn shim_marker_lte_rrc_new() -> LteRrcState {
    return lte_rrc_new(1001);
}

pub fn shim_marker_lte_pdcp_new() -> LtePdcpEntity {
    return lte_pdcp_new(12);
}

pub fn shim_marker_qam_config() -> QamConfig {
    return qam_config_new(16);
}

pub fn shim_marker_psk_config() -> PskConfig {
    return psk_config_new(4, false);
}

pub fn shim_marker_sdr_buffer_new() -> SdrRingBuffer {
    return sdr_buffer_new(1024);
}

pub fn shim_marker_sdr_stream_config() -> SdrStreamConfig {
    return sdr_stream_config_default();
}

pub fn shim_marker_ofdm_config() -> OfdmConfig {
    return ofdm_config_new(64, 16, 52, 4);
}

pub fn shim_marker_fft_twiddle() -> Complex32 {
    return fft_twiddle_factor(1, 64);
}

pub fn shim_marker_ifft_twiddle() -> Complex32 {
    return ifft_twiddle_factor(1, 64);
}

pub fn shim_marker_fir_config() -> FirFilterConfig {
    return fir_config_new(31, 0.25, 2);
}

pub fn shim_marker_iir_coeffs() -> BiquadCoeffs {
    return biquad_coeffs_lowpass(1000.0, 48000.0, 0.7071);
}

pub fn shim_marker_equalizer_config() -> EqualizerConfig {
    return equalizer_config_new(1, 20.0);
}

pub fn shim_marker_snr_estimate() -> Float {
    return snr_estimate_m2m4(1.0, 1.5);
}

pub fn shim_marker_viterbi_config() -> ViterbiConfig {
    return viterbi_config_standard_nasa();
}

pub fn shim_marker_turbo_config() -> TurboConfig {
    return turbo_config_new(6144, 8, 31, 64);
}

pub fn shim_marker_crc_spec() -> CrcRadioSpec {
    return crc_radio_spec_crc24a_lte();
}

pub fn shim_marker_constellation_stats() -> ConstellationStats {
    return constellation_stats_new();
}

pub fn shim_marker_spectrum_config() -> SpectrumConfig {
    return spectrum_config_new(3500000000.0, 20000000.0, 1024);
}

pub fn shim_marker_doppler_profile() -> DopplerProfile {
    return doppler_profile_new(3500000000.0, 30.0, 0.0);
}

pub fn shim_marker_beamforming_config() -> AntennaArrayConfig {
    return antenna_array_config_new(64, 0.05, 0.1);
}
