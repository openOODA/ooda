// # 5G NR Subcarrier & Resource Block Mapping
//
// Logline: Implements 5G NR frequency domain resource grid, PRB indexing, and Point A carrier spacing.
//
// Setup: Pure telecom module for 3GPP TS 38.211 subcarrier frequency calculations and bandwidth parts.
//
// Beats:
//   1. Define Physical Resource Block (PRB) grid and carrier bandwidth configurations.
//   2. Compute absolute subcarrier frequencies relative to Point A reference frequency.
//   3. Calculate minimum guard band, transmission bandwidth, and channel raster points.

pub type Nr5gCarrierGrid = struct {
    point_a_freq_hz: Float,
    scs_khz: Int,
    num_prb: Int,
    k0_offset: Int,
};

pub type Nr5gBwpConfig = struct {
    bwp_id: Int,
    start_prb: Int,
    num_prb: Int,
    scs_khz: Int,
};

pub fn nr5g_subcarrier_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn nr5g_carrier_grid_new(point_a_hz: Float, scs_khz: Int, num_prb: Int) -> Nr5gCarrierGrid {
    let mut prb: Int = num_prb;
    if prb < 1 {
        prb = 1;
    }
    if prb > 275 {
        prb = 275;
    }

    return Nr5gCarrierGrid {
        point_a_freq_hz: point_a_hz,
        scs_khz: scs_khz,
        num_prb: prb,
        k0_offset: 0,
    };
}

pub fn nr5g_subcarrier_freq_hz(grid: &Nr5gCarrierGrid, prb_idx: Int, sc_in_prb: Int) -> Float {
    let scs_hz: Float = nr5g_subcarrier_int_to_float((grid).scs_khz) * 1000.0;
    let abs_sc_idx: Int = (prb_idx * 12) + (sc_in_prb % 12) + (grid).k0_offset;
    let delta_f: Float = nr5g_subcarrier_int_to_float(abs_sc_idx) * scs_hz;
    return (grid).point_a_freq_hz + delta_f;
}

pub fn nr5g_carrier_occupied_bw_hz(grid: &Nr5gCarrierGrid) -> Float {
    let total_sc: Int = (grid).num_prb * 12;
    let scs_hz: Float = nr5g_subcarrier_int_to_float((grid).scs_khz) * 1000.0;
    return nr5g_subcarrier_int_to_float(total_sc) * scs_hz;
}

pub fn nr5g_carrier_guard_band_khz(scs_khz: Int, channel_bw_mhz: Int) -> Int {
    // 3GPP TS 38.101-1 minimum guard band (kHz) for FR1
    if channel_bw_mhz == 10 {
        if scs_khz == 15 { return 312; }
        if scs_khz == 30 { return 660; }
        if scs_khz == 60 { return 1010; }
    }
    if channel_bw_mhz == 20 {
        if scs_khz == 15 { return 692; }
        if scs_khz == 30 { return 820; }
        if scs_khz == 60 { return 1420; }
    }
    if channel_bw_mhz == 50 {
        if scs_khz == 15 { return 1692; }
        if scs_khz == 30 { return 1920; }
        if scs_khz == 60 { return 2320; }
    }
    if channel_bw_mhz == 100 {
        if scs_khz == 30 { return 3840; }
        if scs_khz == 60 { return 4240; }
    }
    return 1000;
}

pub fn nr5g_bwp_validate_bounds(grid: &Nr5gCarrierGrid, bwp: &Nr5gBwpConfig) -> Bool {
    if (bwp).start_prb < 0 {
        return false;
    }
    if (bwp).num_prb <= 0 {
        return false;
    }
    let end_prb: Int = (bwp).start_prb + (bwp).num_prb;
    if end_prb > (grid).num_prb {
        return false;
    }
    return true;
}

pub fn nr5g_subcarrier_index_to_prb(subcarrier_idx: Int) -> Int {
    if subcarrier_idx < 0 {
        return 0;
    }
    return subcarrier_idx / 12;
}
