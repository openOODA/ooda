// # SDR Circular Ring Buffer & Sample Storage
//
// Logline: Implements lock-free style circular ring buffering for continuous I/Q sample streaming.
//
// Setup: Pure SDR memory buffer management for baseband sample ingestion and egress.
//
// Beats:
//   1. Define circular sample buffer state with head/tail tracking and capacity metrics.
//   2. Perform push and pop indexing with wrap-around arithmetic and overflow detection.
//   3. Compute available capacity, fill levels, and sample rate decimation strides.

pub type SdrRingBuffer = struct {
    capacity: Int,
    head: Int,
    tail: Int,
    count: Int,
    dropped_samples: Int,
};

pub fn sdr_buf_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn sdr_buffer_new(capacity: Int) -> SdrRingBuffer {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1024;
    }

    return SdrRingBuffer {
        capacity: cap,
        head: 0,
        tail: 0,
        count: 0,
        dropped_samples: 0,
    };
}

pub fn sdr_buffer_is_full(buf: &SdrRingBuffer) -> Bool {
    return (buf).count >= (buf).capacity;
}

pub fn sdr_buffer_is_empty(buf: &SdrRingBuffer) -> Bool {
    return (buf).count == 0;
}

pub fn sdr_buffer_push_sample(buf: &mut SdrRingBuffer) -> Bool {
    if sdr_buffer_is_full(buf) {
        let updated = SdrRingBuffer {
            capacity: (buf).capacity,
            head: (buf).head,
            tail: (buf).tail,
            count: (buf).count,
            dropped_samples: (buf).dropped_samples + 1,
        };
        *buf = updated;
        return false;
    }

    let next_head: Int = ((buf).head + 1) % (buf).capacity;
    let next_count: Int = (buf).count + 1;

    let updated = SdrRingBuffer {
        capacity: (buf).capacity,
        head: next_head,
        tail: (buf).tail,
        count: next_count,
        dropped_samples: (buf).dropped_samples,
    };
    *buf = updated;
    return true;
}

pub fn sdr_buffer_pop_sample(buf: &mut SdrRingBuffer) -> Bool {
    if sdr_buffer_is_empty(buf) {
        return false;
    }

    let next_tail: Int = ((buf).tail + 1) % (buf).capacity;
    let next_count: Int = (buf).count - 1;

    let updated = SdrRingBuffer {
        capacity: (buf).capacity,
        head: (buf).head,
        tail: next_tail,
        count: next_count,
        dropped_samples: (buf).dropped_samples,
    };
    *buf = updated;
    return true;
}

pub fn sdr_buffer_occupancy_ratio(buf: &SdrRingBuffer) -> Float {
    if (buf).capacity <= 0 {
        return 0.0;
    }
    return sdr_buf_int_to_float((buf).count) / sdr_buf_int_to_float((buf).capacity);
}

pub fn sdr_buffer_decimate_step(in_rate: Int, out_rate: Int) -> Int {
    if out_rate <= 0 {
        return 1;
    }
    let step: Int = in_rate / out_rate;
    if step < 1 {
        return 1;
    }
    return step;
}
