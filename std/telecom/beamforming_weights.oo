// # Massive MIMO & Antenna Array Digital Beamforming
//
// Logline: Computes steering vectors, progressive phase shifts, and beamforming weights for phased arrays.
//
// Setup: Pure telecom spatial signal processing library for 5G NR Massive MIMO arrays.
//
// Beats:
//   1. Define Uniform Linear Array (ULA) geometry, element spacing, and carrier wavelength.
//   2. Calculate spatial steering vectors and progressive inter-element phase shifts.
//   3. Synthesize Maximum Ratio Transmission (MRT) and Zero-Forcing (ZF) beamforming weights.

import "./qam_modulator.oo";

pub type AntennaArrayConfig = struct {
    num_elements: Int,
    element_spacing_m: Float,
    wavelength_m: Float,
};

pub fn beamforming_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn beamforming_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn antenna_array_config_new(elements: Int, spacing_m: Float, wavelength_m: Float) -> AntennaArrayConfig {
    let mut n_elem: Int = elements;
    if n_elem < 1 {
        n_elem = 1;
    }
    return AntennaArrayConfig {
        num_elements: n_elem,
        element_spacing_m: spacing_m,
        wavelength_m: wavelength_m,
    };
}

pub fn beamforming_phase_shift_rad(spacing_m: Float, wavelength_m: Float, azimuth_rad: Float) -> Float {
    if wavelength_m <= 0.000001 {
        return 0.0;
    }
    let pi_val: Float = beamforming_pi();
    let two_pi: Float = 2.0 * pi_val;
    let k_wave: Float = two_pi / wavelength_m;
    return k_wave * spacing_m * sin(azimuth_rad);
}

pub fn beamforming_steering_vector_weight(cfg: &AntennaArrayConfig, elem_idx: Int, azimuth_rad: Float) -> Complex32 {
    let psi: Float = beamforming_phase_shift_rad((cfg).element_spacing_m, (cfg).wavelength_m, azimuth_rad);
    let total_phase: Float = (0.0 - psi) * beamforming_int_to_float(elem_idx);

    let n_f: Float = beamforming_int_to_float((cfg).num_elements);
    let norm: Float = 1.0 / sqrt(n_f);

    return Complex32 {
        re: cos(total_phase) * norm,
        im: sin(total_phase) * norm,
    };
}

pub fn beamforming_half_power_beamwidth_deg(cfg: &AntennaArrayConfig) -> Float {
    let total_aperture: Float = beamforming_int_to_float((cfg).num_elements) * (cfg).element_spacing_m;
    if total_aperture <= 0.000001 {
        return 180.0;
    }
    let pi_val: Float = beamforming_pi();
    let hpbw_rad: Float = (0.886 * (cfg).wavelength_m) / total_aperture;
    return (hpbw_rad * 180.0) / pi_val;
}

pub fn beamforming_array_factor_gain(cfg: &AntennaArrayConfig, azimuth_rad: Float, steer_rad: Float) -> Float {
    let psi_target: Float = beamforming_phase_shift_rad((cfg).element_spacing_m, (cfg).wavelength_m, steer_rad);
    let psi_actual: Float = beamforming_phase_shift_rad((cfg).element_spacing_m, (cfg).wavelength_m, azimuth_rad);
    let delta_psi: Float = psi_actual - psi_target;

    if delta_psi == 0.0 {
        return beamforming_int_to_float((cfg).num_elements);
    }

    let n_f: Float = beamforming_int_to_float((cfg).num_elements);
    let num: Float = sin((n_f * delta_psi) / 2.0);
    let den: Float = sin(delta_psi / 2.0);

    if den == 0.0 {
        return n_f;
    }
    let af: Float = num / den;
    if af < 0.0 {
        return 0.0 - af;
    }
    return af;
}
