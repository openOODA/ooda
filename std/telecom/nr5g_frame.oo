// # 5G NR Radio Frame Processing
//
// Logline: Implements 3GPP TS 38.211 5G NR radio frame, subframe, and slot numerology calculations.
//
// Setup: Pure telecom signal processing module for 5G New Radio frame and timing management.
//
// Beats:
//   1. Define 5G NR frame configuration, timing structures, and radio frame state.
//   2. Calculate subframe, slot, and symbol numerologies across subcarrier spacings (mu 0..4).
//   3. Manage System Frame Number (SFN) progression, hyper-SFN, and frame boundary alignment.

pub type Nr5gFrameConfig = struct {
    numerology_mu: Int,
    subcarrier_spacing_khz: Int,
    slots_per_subframe: Int,
    slots_per_frame: Int,
    symbols_per_slot: Int,
    system_frame_number: Int,
};

pub type Nr5gTimePosition = struct {
    sfn: Int,
    subframe_idx: Int,
    slot_in_subframe: Int,
    symbol_in_slot: Int,
    absolute_slot: Int,
    absolute_symbol: Int,
};

pub fn nr5g_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn nr5g_frame_config_new(mu: Int, sfn: Int) -> Nr5gFrameConfig {
    let mut scs: Int = 15;
    let mut slots_per_sf: Int = 1;

    if mu == 1 {
        scs = 30;
        slots_per_sf = 2;
    } else {
        if mu == 2 {
            scs = 60;
            slots_per_sf = 4;
        } else {
            if mu == 3 {
                scs = 120;
                slots_per_sf = 8;
            } else {
                if mu == 4 {
                    scs = 240;
                    slots_per_sf = 16;
                }
            }
        }
    }

    let total_slots: Int = slots_per_sf * 10;
    let norm_sfn: Int = sfn % 1024;

    return Nr5gFrameConfig {
        numerology_mu: mu,
        subcarrier_spacing_khz: scs,
        slots_per_subframe: slots_per_sf,
        slots_per_frame: total_slots,
        symbols_per_slot: 14,
        system_frame_number: norm_sfn,
    };
}

pub fn nr5g_frame_slot_duration_us(mu: Int) -> Float {
    if mu == 0 {
        return 1000.0;
    }
    if mu == 1 {
        return 500.0;
    }
    if mu == 2 {
        return 250.0;
    }
    if mu == 3 {
        return 125.0;
    }
    if mu == 4 {
        return 62.5;
    }
    return 1000.0;
}

pub fn nr5g_frame_symbol_duration_us(mu: Int) -> Float {
    let slot_dur: Float = nr5g_frame_slot_duration_us(mu);
    return slot_dur / 14.0;
}

pub fn nr5g_frame_sfn_increment(sfn: Int, delta: Int) -> Int {
    let raw: Int = sfn + delta;
    return raw % 1024;
}

pub fn nr5g_frame_time_position_new(sfn: Int, subframe: Int, slot_in_sf: Int, symbol: Int, mu: Int) -> Nr5gTimePosition {
    let cfg: Nr5gFrameConfig = nr5g_frame_config_new(mu, sfn);
    let abs_slot: Int = (sfn * (cfg).slots_per_frame) + (subframe * (cfg).slots_per_subframe) + slot_in_sf;
    let abs_sym: Int = (abs_slot * 14) + symbol;

    return Nr5gTimePosition {
        sfn: sfn % 1024,
        subframe_idx: subframe % 10,
        slot_in_subframe: slot_in_sf % (cfg).slots_per_subframe,
        symbol_in_slot: symbol % 14,
        absolute_slot: abs_slot,
        absolute_symbol: abs_sym,
    };
}

pub fn nr5g_frame_is_boundary(pos: &Nr5gTimePosition) -> Bool {
    if (pos).subframe_idx == 0 {
        if (pos).slot_in_subframe == 0 {
            if (pos).symbol_in_slot == 0 {
                return true;
            }
        }
    }
    return false;
}

pub fn nr5g_frame_calc_time_ms(cfg: &Nr5gFrameConfig, pos: &Nr5gTimePosition) -> Float {
    let frame_ms: Float = 10.0;
    let sfn_time: Float = nr5g_int_to_float((pos).sfn) * frame_ms;
    let sf_time: Float = nr5g_int_to_float((pos).subframe_idx) * 1.0;
    let slot_dur_ms: Float = nr5g_frame_slot_duration_us((cfg).numerology_mu) / 1000.0;
    let slot_time: Float = nr5g_int_to_float((pos).slot_in_subframe) * slot_dur_ms;
    let sym_dur_ms: Float = nr5g_frame_symbol_duration_us((cfg).numerology_mu) / 1000.0;
    let sym_time: Float = nr5g_int_to_float((pos).symbol_in_slot) * sym_dur_ms;

    return sfn_time + sf_time + slot_time + sym_time;
}
