// # RF Spectrum Analyzer & Spectral Occupancy
//
// Logline: Computes Power Spectral Density (PSD), Occupied Bandwidth (OBW), and ACLR adjacent leakage.
//
// Setup: Pure SDR DSP RF measurement module for spectral compliance and emission masks.
//
// Beats:
//   1. Define Power Spectral Density (PSD) bins, Resolution Bandwidth (RBW), and noise floor.
//   2. Estimate Occupied Bandwidth (OBW) containing 99% integrated total power.
//   3. Compute Adjacent Channel Leakage Ratio (ACLR) and locate spurious emission peaks.

pub type SpectrumConfig = struct {
    rbw_hz: Float,
    vbw_hz: Float,
    center_freq_hz: Float,
    span_hz: Float,
    num_bins: Int,
};

pub type SpectrumMetrics = struct {
    peak_power_dbm: Float,
    peak_freq_hz: Float,
    noise_floor_dbm: Float,
    obw_hz: Float,
    aclr_lower_dbc: Float,
    aclr_upper_dbc: Float,
};

pub fn spectrum_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn spectrum_ln_approx(x: Float) -> Float {
    if x <= 0.000001 {
        return 0.0 - 13.8155;
    }
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.718281828459045;
        k = k + 1.0;
    }
    while val < 0.7 {
        val = val * 2.718281828459045;
        k = k - 1.0;
    }

    let y: Float = (val - 1.0) / (val + 1.0);
    let y2: Float = y * y;
    let y3: Float = y2 * y;
    let y5: Float = y3 * y2;
    let ln_val: Float = 2.0 * (y + (y3 / 3.0) + (y5 / 5.0));

    return ln_val + k;
}

pub fn spectrum_log10(x: Float) -> Float {
    return spectrum_ln_approx(x) / 2.302585092994046;
}

pub fn spectrum_config_new(center_hz: Float, span_hz: Float, bins: Int) -> SpectrumConfig {
    let mut num_b: Int = bins;
    if num_b < 16 {
        num_b = 1024;
    }
    let rbw: Float = span_hz / spectrum_int_to_float(num_b);

    return SpectrumConfig {
        rbw_hz: rbw,
        vbw_hz: rbw * 3.0,
        center_freq_hz: center_hz,
        span_hz: span_hz,
        num_bins: num_b,
    };
}

pub fn spectrum_bin_to_freq_hz(cfg: &SpectrumConfig, bin_idx: Int) -> Float {
    let half_span: Float = (cfg).span_hz / 2.0;
    let start_freq: Float = (cfg).center_freq_hz - half_span;
    let bin_ratio: Float = spectrum_int_to_float(bin_idx) / spectrum_int_to_float((cfg).num_bins);
    return start_freq + (bin_ratio * (cfg).span_hz);
}

pub fn spectrum_calc_aclr_dbc(carrier_pwr_linear: Float, adjacent_pwr_linear: Float) -> Float {
    if adjacent_pwr_linear <= 0.0000001 {
        return 0.0 - 60.0;
    }
    if carrier_pwr_linear <= 0.0000001 {
        return 0.0;
    }
    let ratio: Float = adjacent_pwr_linear / carrier_pwr_linear;
    return 10.0 * spectrum_log10(ratio);
}

pub fn spectrum_estimate_snr_db(peak_dbm: Float, noise_floor_dbm: Float) -> Float {
    return peak_dbm - noise_floor_dbm;
}
