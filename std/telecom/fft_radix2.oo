// # Cooley-Tukey Radix-2 Fast Fourier Transform (FFT)
//
// Logline: Computes Radix-2 Decimation-in-Time (DIT) FFT twiddle factors, bit reversals, and butterflies.
//
// Setup: Pure DSP signal processing module for frequency domain spectral transformations.
//
// Beats:
//   1. Compute bit-reversal permutation indices for power-of-2 sequence lengths.
//   2. Calculate complex twiddle factors (exp(-j*2*pi*k/N)) with sine/cosine trigonometry.
//   3. Execute butterfly stage arithmetic and evaluate discrete spectral bin frequencies.

import "./qam_modulator.oo";

pub fn fft_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn fft_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn fft_is_power_of_two(n: Int) -> Bool {
    if n <= 0 {
        return false;
    }
    let mut val: Int = n;
    while (val % 2) == 0 {
        val = val / 2;
    }
    return val == 1;
}

pub fn fft_log2_int(n: Int) -> Int {
    let mut val: Int = n;
    let mut bits: Int = 0;
    while val > 1 {
        val = val / 2;
        bits = bits + 1;
    }
    return bits;
}

pub fn fft_bit_reverse(idx: Int, num_bits: Int) -> Int {
    let mut rev: Int = 0;
    let mut i: Int = 0;
    let mut temp: Int = idx;

    while i < num_bits {
        let bit: Int = temp % 2;
        rev = (rev * 2) + bit;
        temp = temp / 2;
        i = i + 1;
    }
    return rev;
}

pub fn fft_twiddle_factor(k: Int, n_points: Int) -> Complex32 {
    let pi_val: Float = fft_pi();
    let two_pi: Float = 2.0 * pi_val;
    let angle: Float = (0.0 - two_pi) * (fft_int_to_float(k) / fft_int_to_float(n_points));

    return Complex32 {
        re: cos(angle),
        im: sin(angle),
    };
}

pub fn fft_butterfly_top(u: Complex32, v: Complex32, twiddle: Complex32) -> Complex32 {
    let v_tw: Complex32 = complex_mul(v, twiddle);
    return complex_add(u, v_tw);
}

pub fn fft_butterfly_bottom(u: Complex32, v: Complex32, twiddle: Complex32) -> Complex32 {
    let v_tw: Complex32 = complex_mul(v, twiddle);
    return complex_sub(u, v_tw);
}

pub fn fft_bin_frequency_hz(bin_idx: Int, total_bins: Int, sample_rate_hz: Float) -> Float {
    if total_bins <= 0 {
        return 0.0;
    }
    let bin_f: Float = fft_int_to_float(bin_idx);
    let total_f: Float = fft_int_to_float(total_bins);
    return (bin_f / total_f) * sample_rate_hz;
}
