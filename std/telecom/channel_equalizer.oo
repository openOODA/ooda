// # Channel Equalization & Multipath Compensation
//
// Logline: Implements Zero-Forcing (ZF) and Minimum Mean Square Error (MMSE) frequency domain equalizers.
//
// Setup: Pure telecom baseband equalization engine for fading wireless multipath channels.
//
// Beats:
//   1. Define channel frequency response estimates and equalizer configurations.
//   2. Compute Zero-Forcing (ZF) channel inversion weights: H* / |H|^2.
//   3. Compute MMSE channel equalization weights: H* / (|H|^2 + 1/SNR) and adaptive LMS updates.

import "./qam_modulator.oo";

pub type EqualizerConfig = struct {
    algo_type: Int,
    snr_linear: Float,
    mu_step_size: Float
};

pub fn complex_conj(c: Complex32) -> Complex32 {
    return Complex32 {
        re: (c).re,
        im: 0.0 - (c).im
    };
}

pub fn equalizer_config_new(algo_type: Int, snr_linear: Float) -> EqualizerConfig {
    let mut snr: Float = snr_linear;
    if snr < 0.001 {
        snr = 0.001;
    }
    return EqualizerConfig {
        algo_type: algo_type, // 0 = ZF, 1 = MMSE
        snr_linear: snr,
        mu_step_size: 0.01
    };
}

pub fn equalizer_calc_weight_zf(h: Complex32) -> Complex32 {
    let h_sq: Float = complex_mag_sq(h);
    if h_sq < 0.00000001 {
        return Complex32 { re: 0.0, im: 0.0 };
    }
    let h_conj: Complex32 = complex_conj(h);
    return Complex32 {
        re: (h_conj).re / h_sq,
        im: (h_conj).im / h_sq
    };
}

pub fn equalizer_calc_weight_mmse(h: Complex32, snr_linear: Float) -> Complex32 {
    let h_sq: Float = complex_mag_sq(h);
    let mut inv_snr: Float = 0.01;
    if snr_linear > 0.00001 {
        inv_snr = 1.0 / snr_linear;
    }
    let denom: Float = h_sq + inv_snr;
    let h_conj: Complex32 = complex_conj(h);

    return Complex32 {
        re: (h_conj).re / denom,
        im: (h_conj).im / denom
    };
}

pub fn equalizer_apply(rx_symbol: Complex32, weight: Complex32) -> Complex32 {
    return complex_mul(rx_symbol, weight);
}

pub fn equalizer_lms_update_weight(w: Complex32, error: Complex32, rx_symbol: Complex32, mu: Float) -> Complex32 {
    let rx_conj: Complex32 = complex_conj(rx_symbol);
    let grad: Complex32 = complex_mul(error, rx_conj);
    let scaled_grad = Complex32 {
        re: (grad).re * mu,
        im: (grad).im * mu
    };
    return complex_add(w, scaled_grad);
}
