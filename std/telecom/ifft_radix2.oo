// # Inverse Fast Fourier Transform (IFFT) & OFDM Modulator
//
// Logline: Implements Radix-2 IFFT twiddle factors, 1/N energy scaling, and cyclic prefix insertion.
//
// Setup: Pure DSP signal processing module for time-domain multicarrier waveform synthesis.
//
// Beats:
//   1. Compute inverse twiddle factors (exp(+j*2*pi*k/N)) with conjugate symmetry.
//   2. Perform inverse butterfly computations and 1/N amplitude normalization.
//   3. Insert cyclic prefix guard intervals and evaluate Peak-to-Average Power Ratio (PAPR).

import "./qam_modulator.oo";

pub fn ifft_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn ifft_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn ifft_twiddle_factor(k: Int, n_points: Int) -> Complex32 {
    let pi_val: Float = ifft_pi();
    let two_pi: Float = 2.0 * pi_val;
    let angle: Float = two_pi * (ifft_int_to_float(k) / ifft_int_to_float(n_points));

    return Complex32 {
        re: cos(angle),
        im: sin(angle)
    };
}

pub fn ifft_butterfly_top(u: Complex32, v: Complex32, twiddle: Complex32) -> Complex32 {
    let v_tw: Complex32 = complex_mul(v, twiddle);
    return complex_add(u, v_tw);
}

pub fn ifft_butterfly_bottom(u: Complex32, v: Complex32, twiddle: Complex32) -> Complex32 {
    let v_tw: Complex32 = complex_mul(v, twiddle);
    return complex_sub(u, v_tw);
}

pub fn ifft_scale_sample(val: Complex32, n_points: Int) -> Complex32 {
    let scale: Float = 1.0 / ifft_int_to_float(n_points);
    return Complex32 {
        re: (val).re * scale,
        im: (val).im * scale
    };
}

pub fn ifft_cp_source_sample_index(cp_sample_idx: Int, fft_size: Int, cp_len: Int) -> Int {
    // Cyclic prefix copies the tail of the IFFT output symbol: [N - cp_len + cp_sample_idx]
    let start_idx: Int = fft_size - cp_len;
    return (start_idx + cp_sample_idx) % fft_size;
}

pub fn ifft_calc_papr_ratio(peak_power: Float, mean_power: Float) -> Float {
    if mean_power <= 0.0000001 {
        return 1.0;
    }
    return peak_power / mean_power;
}
