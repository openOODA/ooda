// # Modulation Constellation & EVM Analyzer
//
// Logline: Computes Error Vector Magnitude (EVM), Modulation Error Ratio (MER), and IQ imbalance metrics.
//
// Setup: Pure telecom digital demodulation analysis and signal quality evaluation.
//
// Beats:
//   1. Define constellation point statistics, reference symbols, and error vectors.
//   2. Compute root-mean-square (RMS) and peak Error Vector Magnitude (EVM) in % and dB.
//   3. Estimate carrier leakage, origin offset, and quadrature amplitude/phase imbalance.

import "./qam_modulator.oo";

pub type ConstellationStats = struct {
    num_symbols: Int,
    evm_rms_percent: Float,
    evm_peak_percent: Float,
    mer_db: Float,
    origin_offset_db: Float
};

pub fn constell_ln_approx(x: Float) -> Float {
    if x <= 0.000001 {
        return 0.0 - 13.8155;
    }
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.718281828459045;
        k = k + 1.0;
    }
    while val < 0.7 {
        val = val * 2.718281828459045;
        k = k - 1.0;
    }

    let y: Float = (val - 1.0) / (val + 1.0);
    let y2: Float = y * y;
    let y3: Float = y2 * y;
    let y5: Float = y3 * y2;
    let ln_val: Float = 2.0 * (y + (y3 / 3.0) + (y5 / 5.0));

    return ln_val + k;
}

pub fn constell_log10(x: Float) -> Float {
    return constell_ln_approx(x) / 2.302585092994046;
}

pub fn constellation_stats_new() -> ConstellationStats {
    return ConstellationStats {
        num_symbols: 0,
        evm_rms_percent: 0.0,
        evm_peak_percent: 0.0,
        mer_db: 40.0,
        origin_offset_db: 0.0 - 50.0
    };
}

pub fn constellation_error_vector(rx: Complex32, ref_sym: Complex32) -> Complex32 {
    return complex_sub(rx, ref_sym);
}

pub fn constellation_calc_evm_rms(sum_err_sq: Float, sum_ref_sq: Float) -> Float {
    if sum_ref_sq <= 0.000001 {
        return 0.0;
    }
    let ratio: Float = sum_err_sq / sum_ref_sq;
    return sqrt(ratio) * 100.0;
}

pub fn constellation_evm_to_mer_db(evm_rms_percent: Float) -> Float {
    if evm_rms_percent <= 0.001 {
        return 50.0;
    }
    let evm_ratio: Float = evm_rms_percent / 100.0;
    let mer_lin: Float = 1.0 / (evm_ratio * evm_ratio);
    return 10.0 * constell_log10(mer_lin);
}

pub fn constellation_iq_imbalance_ratio(i_power: Float, q_power: Float) -> Float {
    if q_power <= 0.000001 {
        return 1.0;
    }
    return i_power / q_power;
}

pub fn constellation_origin_offset_db(dc_power: Float, signal_power: Float) -> Float {
    if signal_power <= 0.000001 {
        return 0.0 - 50.0;
    }
    let ratio: Float = dc_power / signal_power;
    if ratio <= 0.000001 {
        return 0.0 - 60.0;
    }
    return 10.0 * constell_log10(ratio);
}
