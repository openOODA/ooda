// # Infinite Impulse Response (IIR) Biquad Filter
//
// Logline: Implements Direct Form I/II biquad IIR filters, Butterworth poles, and stability checks.
//
// Setup: Pure digital signal processing filter library for recursive audio and RF filtering.
//
// Beats:
//   1. Define second-order Direct Form I and II biquad filter coefficients and delay states.
//   2. Compute biquad coefficients for Lowpass, Highpass, Bandpass, and Notch transfer functions.
//   3. Execute single-sample recursive difference equations and verify pole stability inside unit circle.

pub type BiquadCoeffs = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float,
};

pub type BiquadState = struct {
    x1: Float,
    x2: Float,
    y1: Float,
    y2: Float,
};

pub fn iir_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn iir_abs(v: Float) -> Float {
    if v < 0.0 {
        return 0.0 - v;
    }
    return v;
}

pub fn biquad_state_new() -> BiquadState {
    return BiquadState {
        x1: 0.0,
        x2: 0.0,
        y1: 0.0,
        y2: 0.0,
    };
}

pub fn biquad_coeffs_lowpass(cutoff_hz: Float, sample_rate_hz: Float, q_factor: Float) -> BiquadCoeffs {
    let pi_val: Float = iir_pi();
    let omega: Float = (2.0 * pi_val * cutoff_hz) / sample_rate_hz;
    let cos_w: Float = cos(omega);
    let sin_w: Float = sin(omega);
    let alpha: Float = sin_w / (2.0 * q_factor);

    let a0: Float = 1.0 + alpha;
    let b0_val: Float = (1.0 - cos_w) / (2.0 * a0);
    let b1_val: Float = (1.0 - cos_w) / a0;
    let b2_val: Float = b0_val;
    let a1_val: Float = (0.0 - (2.0 * cos_w)) / a0;
    let a2_val: Float = (1.0 - alpha) / a0;

    return BiquadCoeffs {
        b0: b0_val,
        b1: b1_val,
        b2: b2_val,
        a1: a1_val,
        a2: a2_val,
    };
}

pub fn biquad_coeffs_highpass(cutoff_hz: Float, sample_rate_hz: Float, q_factor: Float) -> BiquadCoeffs {
    let pi_val: Float = iir_pi();
    let omega: Float = (2.0 * pi_val * cutoff_hz) / sample_rate_hz;
    let cos_w: Float = cos(omega);
    let sin_w: Float = sin(omega);
    let alpha: Float = sin_w / (2.0 * q_factor);

    let a0: Float = 1.0 + alpha;
    let b0_val: Float = (1.0 + cos_w) / (2.0 * a0);
    let b1_val: Float = (0.0 - (1.0 + cos_w)) / a0;
    let b2_val: Float = b0_val;
    let a1_val: Float = (0.0 - (2.0 * cos_w)) / a0;
    let a2_val: Float = (1.0 - alpha) / a0;

    return BiquadCoeffs {
        b0: b0_val,
        b1: b1_val,
        b2: b2_val,
        a1: a1_val,
        a2: a2_val,
    };
}

pub fn biquad_process_sample(c: &BiquadCoeffs, st: &mut BiquadState, x: Float) -> Float {
    let ff: Float = ((c).b0 * x) + ((c).b1 * (st).x1) + ((c).b2 * (st).x2);
    let fb: Float = ((c).a1 * (st).y1) + ((c).a2 * (st).y2);
    let y: Float = ff - fb;

    let updated = BiquadState {
        x1: x,
        x2: (st).x1,
        y1: y,
        y2: (st).y1,
    };
    *st = updated;
    return y;
}

pub fn biquad_is_stable(c: &BiquadCoeffs) -> Bool {
    // Jury / Schur-Cohn stability criterion for 2nd order polynomial 1 + a1*z^-1 + a2*z^-2
    // 1) |a2| < 1
    // 2) 1 + a1 + a2 > 0
    // 3) 1 - a1 + a2 > 0
    if iir_abs((c).a2) >= 1.0 {
        return false;
    }
    if (1.0 + (c).a1 + (c).a2) <= 0.0 {
        return false;
    }
    if (1.0 - (c).a1 + (c).a2) <= 0.0 {
        return false;
    }
    return true;
}
