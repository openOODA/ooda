// # Viterbi Convolutional Decoder Engine
//
// Logline: Implements Trellis branch metric calculation, path metric accumulation, and traceback decoding.
//
// Setup: Pure forward error correction (FEC) decoder for Rate 1/2 Constraint Length K=7 convolutional codes.
//
// Beats:
//   1. Define convolutional code generator polynomials and Trellis state structures.
//   2. Compute branch metrics (Hamming distance for hard-decision, squared Euclidean for soft-decision).
//   3. Accumulate path metrics, select survival paths, and perform traceback bit recovery.

pub type ViterbiConfig = struct {
    constraint_len: Int,
    num_states: Int,
    poly_a: Int,
    poly_b: Int,
    traceback_depth: Int
};

pub fn viterbi_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn viterbi_config_standard_nasa() -> ViterbiConfig {
    // NASA standard Rate 1/2, K=7: G1 = 171_oct (121_dec), G2 = 133_oct (91_dec), 64 states
    return ViterbiConfig {
        constraint_len: 7,
        num_states: 64,
        poly_a: 121,
        poly_b: 91,
        traceback_depth: 35
    };
}

pub fn viterbi_calc_parity(val: Int) -> Int {
    let mut count: Int = 0;
    let mut temp: Int = val;
    while temp > 0 {
        if (temp % 2) == 1 {
            count = count + 1;
        }
        temp = temp / 2;
    }
    return count % 2;
}

pub fn viterbi_encode_bit(state: Int, bit: Int, poly_a: Int, poly_b: Int) -> Int {
    // Shift bit into state: composite = (state * 2) + bit
    let composite: Int = (state * 2) + (bit % 2);
    let a_masked: Int = composite & poly_a;
    let b_masked: Int = composite & poly_b;

    let out_a: Int = viterbi_calc_parity(a_masked);
    let out_b: Int = viterbi_calc_parity(b_masked);

    return out_a + (out_b * 2);
}

pub fn viterbi_hamming_distance(sym_rx: Int, sym_expected: Int) -> Int {
    let diff: Int = sym_rx ^ sym_expected;
    let mut dist: Int = 0;
    if (diff & 1) != 0 { dist = dist + 1; }
    if (diff & 2) != 0 { dist = dist + 1; }
    return dist;
}

pub fn viterbi_next_state(cur_state: Int, input_bit: Int, constraint_len: Int) -> Int {
    let num_states: Int = 64; // for K=7, 2^(K-1) = 64
    let shifted: Int = (cur_state * 2) + (input_bit % 2);
    return shifted % num_states;
}

pub fn viterbi_est_ber(err_count: Int, total_bits: Int) -> Float {
    if total_bits <= 0 {
        return 0.0;
    }
    return viterbi_int_to_float(err_count) / viterbi_int_to_float(total_bits);
}
