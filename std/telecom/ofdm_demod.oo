// # OFDM Demodulation & Synchronization Pipeline
//
// Logline: Performs OFDM cyclic prefix removal, FFT windowing, pilot extraction, and carrier offset correction.
//
// Setup: Pure telecom SDR module for multicarrier baseband demodulation and synchronization.
//
// Beats:
//   1. Define OFDM receiver parameters (FFT size, CP length, pilot pattern spacing).
//   2. Remove cyclic prefix and locate optimal FFT symbol timing window.
//   3. Correct Carrier Frequency Offset (CFO) and extract frequency-domain data subcarriers.

import "./qam_modulator.oo";

pub type OfdmConfig = struct {
    fft_size: Int,
    cp_len: Int,
    num_subcarriers: Int,
    pilot_spacing: Int,
    is_extended_cp: Bool
};

pub type OfdmSymbolSync = struct {
    cfo_rad_per_sample: Float,
    timing_offset: Int,
    is_locked: Bool
};

pub fn ofdm_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn ofdm_config_new(fft_size: Int, cp_len: Int, num_subcarriers: Int, pilot_spacing: Int) -> OfdmConfig {
    return OfdmConfig {
        fft_size: fft_size,
        cp_len: cp_len,
        num_subcarriers: num_subcarriers,
        pilot_spacing: pilot_spacing,
        is_extended_cp: false
    };
}

pub fn ofdm_total_symbol_samples(cfg: &OfdmConfig) -> Int {
    return (cfg).fft_size + (cfg).cp_len;
}

pub fn ofdm_is_pilot_subcarrier(cfg: &OfdmConfig, k_idx: Int) -> Bool {
    if (cfg).pilot_spacing <= 0 {
        return false;
    }
    return (k_idx % (cfg).pilot_spacing) == 0;
}

pub fn ofdm_correct_cfo(sample: Complex32, sample_idx: Int, cfo_rad: Float) -> Complex32 {
    let angle: Float = 0.0 - (cfo_rad * ofdm_int_to_float(sample_idx));
    let rotator = Complex32 {
        re: cos(angle),
        im: sin(angle)
    };
    return complex_mul(sample, rotator);
}

pub fn ofdm_extract_active_subcarrier_index(cfg: &OfdmConfig, logical_k: Int) -> Int {
    // Maps logical subcarrier index [0..N_sc-1] to FFT bin with DC null centering
    let half_sc: Int = (cfg).num_subcarriers / 2;
    if logical_k < half_sc {
        // Positive frequencies starting from bin 1
        return logical_k + 1;
    }
    // Negative frequencies in upper half of FFT buffer
    let upper_offset: Int = logical_k - half_sc;
    return ((cfg).fft_size - half_sc) + upper_offset;
}

pub fn ofdm_cp_removal_start_index(timing_offset: Int, cp_len: Int) -> Int {
    return timing_offset + cp_len;
}
