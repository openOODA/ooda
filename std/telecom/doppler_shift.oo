// # Doppler Shift & Channel Fading Dynamics
//
// Logline: Calculates Doppler frequency shifts, carrier frequency offsets (CFO), and channel coherence time.
//
// Setup: Pure telecom wireless propagation module for mobile and satellite communications.
//
// Beats:
//   1. Define mobile platform velocity, trajectory angle, carrier frequency, and speed of light.
//   2. Compute line-of-sight Doppler frequency shift fd = (v / c) * fc * cos(theta).
//   3. Calculate wireless channel coherence time, Jake's Doppler spectrum, and satellite CFO profiles.

type DopplerProfile = struct {
    carrier_freq_hz: Float,
    velocity_mps: Float,
    arrival_angle_rad: Float,
    max_doppler_hz: Float,
    observed_shift_hz: Float
};

pub fn doppler_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn doppler_speed_of_light() -> Float {
    return 299792458.0;
}

pub fn doppler_calc_shift_hz(fc_hz: Float, v_mps: Float, angle_rad: Float) -> Float {
    let c: Float = doppler_speed_of_light();
    let max_fd: Float = (v_mps / c) * fc_hz;
    return max_fd * cos(angle_rad);
}

pub fn doppler_profile_new(fc_hz: Float, v_mps: Float, angle_rad: Float) -> DopplerProfile {
    let c: Float = doppler_speed_of_light();
    let max_fd: Float = (v_mps / c) * fc_hz;
    let shift: Float = max_fd * cos(angle_rad);

    return DopplerProfile {
        carrier_freq_hz: fc_hz,
        velocity_mps: v_mps,
        arrival_angle_rad: angle_rad,
        max_doppler_hz: max_fd,
        observed_shift_hz: shift
    };
}

pub fn doppler_calc_coherence_time_s(max_doppler_hz: Float) -> Float {
    // Clarke-Jakes model coherence time: Tc = 9 / (16 * pi * fd) ~ 0.179 / fd
    if max_doppler_hz <= 0.0001 {
        return 1000.0;
    }
    let pi_val: Float = doppler_pi();
    return 9.0 / (16.0 * pi_val * max_doppler_hz);
}

pub fn doppler_calc_coherence_bandwidth_hz(delay_spread_s: Float) -> Float {
    // 50% correlation coherence bandwidth: Bc = 1 / (5 * tau_rms)
    if delay_spread_s <= 0.000000001 {
        return 1000000000.0;
    }
    return 1.0 / (5.0 * delay_spread_s);
}

pub fn doppler_compensate_carrier_freq(carrier_hz: Float, doppler_hz: Float) -> Float {
    return carrier_hz - doppler_hz;
}

pub fn doppler_satellite_leo_shift_hz(fc_hz: Float, ground_v_mps: Float, elevation_rad: Float) -> Float {
    // LEO satellite line-of-sight radial velocity component
    let radial_v: Float = ground_v_mps * cos(elevation_rad);
    let c: Float = doppler_speed_of_light();
    return (radial_v / c) * fc_hz;
}
