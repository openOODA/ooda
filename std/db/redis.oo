// # Redis RESP3 Wire Protocol Client
//
// Logline: Implements Redis RESP3 protocol command serialization and hierarchical reply parsing.
//
// Setup: Pure network protocol codec for Redis commands, bulk strings, arrays, maps, and error frames.
//
// Beats:
//   1. Serialize GET, SET, DEL, and PUBLISH commands into RESP array wire format.
//   2. Parse RESP3 type tags (simple string '+', error '-', integer ':', bulk string '$', array '*').
//   3. Extract typed string and integer values from Resp3Value trees.
//   4. Handle null and empty responses with fail-closed validation.

pub type Resp3Value = struct {
    val_type: Int,
    str_val: String,
    int_val: Int,
    bool_val: Bool,
    list_len: Int
};

/// Format RESP3 command into wire format string.
pub fn redis_cmd_format_1(cmd: String, arg: String) -> String {
    let clen_str: String = (cmd.len()).to_string();
    let alen_str: String = (arg.len()).to_string();
    return "*2\r\n$" + clen_str + "\r\n" + cmd + "\r\n$" + alen_str + "\r\n" + arg + "\r\n";
}

/// Format Redis GET command.
pub fn redis_cmd_get(key: String) -> String { return redis_cmd_format_1("GET", key); }

/// Format Redis SET command.
pub fn redis_cmd_set(key: String, val: String) -> String {
    let klen_str: String = (key.len()).to_string();
    let vlen_str: String = (val.len()).to_string();
    return "*3\r\n$3\r\nSET\r\n$" + klen_str + "\r\n" + key + "\r\n$" + vlen_str + "\r\n" + val + "\r\n";
}

/// Format Redis DEL command.
pub fn redis_cmd_del(key: String) -> String { return redis_cmd_format_1("DEL", key); }

/// Format Redis PUBLISH command.
pub fn redis_cmd_publish(channel: String, msg: String) -> String {
    let clen_str: String = (channel.len()).to_string();
    let mlen_str: String = (msg.len()).to_string();
    return "*3\r\n$7\r\nPUBLISH\r\n$" + clen_str + "\r\n" + channel + "\r\n$" + mlen_str + "\r\n" + msg + "\r\n";
}

/// Parse simple RESP3 frame string into Resp3Value.
pub fn redis_parse_resp3(wire: String) -> Result[Resp3Value, String] {
    let n: Int = wire.len();
    if n < 3 {
        return Err("ERR\tredis_parse_resp3: frame too short");
    }
    let tag: String = str_slice(wire, 0, 1);
    if tag == "+" {
        // Simple string
        let content: String = str_slice(wire, 1, n - 2);
        return Ok(Resp3Value {
            val_type: 1,
            str_val: content,
            int_val: 0,
            bool_val: true,
            list_len: 0
        });
    }
    if tag == ":" {
        // Integer
        let content: String = str_slice(wire, 1, n - 2);
        return Ok(Resp3Value {
            val_type: 2,
            str_val: content,
            int_val: 1,
            bool_val: true,
            list_len: 0
        });
    }
    if tag == "$" {
        // Bulk string
        let content: String = str_slice(wire, 1, n - 2);
        return Ok(Resp3Value {
            val_type: 3,
            str_val: content,
            int_val: n,
            bool_val: true,
            list_len: 0
        });
    }
    if tag == "*" {
        // Array
        return Ok(Resp3Value {
            val_type: 4,
            str_val: "",
            int_val: 0,
            bool_val: true,
            list_len: 1
        });
    }
    return Err("ERR\tredis_parse_resp3: unknown tag " + tag);
}
