// # Key-Value Storage Engine Types & Configuration
//
// Logline: Defines core records, configuration parameters, and mutation entries for the sovereign KV engine.
//
// Setup: Pure data definitions for LSM and B-Tree storage structures with zero struct trailing commas.
//
// Beats:
//   1. Define KvConfig for disk persistence paths, flush limits, and compaction thresholds.
//   2. Define KvEntry representing sequenced key-value records and tombstones.
//   3. Define KvStats for runtime query and compaction telemetry.
//   4. Provide lexicographic string comparison helpers for sorted indices.

pub type KvConfig = struct {
    db_path: String,
    memtable_capacity: Int,
    sync_wal: Bool,
    compaction_threshold: Int,
    bloom_bits_per_key: Int
};

pub type KvEntry = struct {
    key: String,
    value: String,
    seq_num: Int,
    is_tombstone: Bool
};

pub type KvStats = struct {
    total_entries: Int,
    memtable_entries: Int,
    sstable_count: Int,
    wal_bytes: Int
};

/// Lexicographic string less-than comparison.
pub fn str_lt(a: String, b: String) -> Bool {
    let la: Int = a.len();
    let lb: Int = b.len();
    let mut min_l: Int = la;
    if lb < min_l {
        min_l = lb;
    }
    let mut i: Int = 0;
    while i < min_l {
        let ba: Int = byte_at(a, i);
        let bb: Int = byte_at(b, i);
        if ba < bb {
            return true;
        }
        if ba > bb {
            return false;
        }
        i = i + 1;
    }
    return la < lb;
}

/// Lexicographic string less-than-or-equal comparison.
pub fn str_lte(a: String, b: String) -> Bool { return a == b || str_lt(a, b); }

/// Initialize a default KvConfig.
pub fn kv_config_default(db_path: String) -> KvConfig { return KvConfig {
        db_path: db_path,
        memtable_capacity: 1000,
        sync_wal: true,
        compaction_threshold: 4,
        bloom_bits_per_key: 10
    }; }

/// Create a standard active key-value entry.
pub fn kv_entry_new(key: String, value: String, seq: Int) -> KvEntry { return KvEntry {
        key: key,
        value: value,
        seq_num: seq,
        is_tombstone: false
    }; }

/// Create a tombstone entry marking a key as deleted.
pub fn kv_entry_tombstone(key: String, seq: Int) -> KvEntry { return KvEntry {
        key: key,
        value: "",
        seq_num: seq,
        is_tombstone: true
    }; }
