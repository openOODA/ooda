// # B-Tree Disk & Memory Indexing Engine
//
// Logline: Implements slotted page B-Tree index structures with sorted search, split propagation, and ordered scanning.
//
// Setup: Pure B-Tree index engine maintaining balance invariants and key-value mapping.
//
// Beats:
//   1. Represent B-Tree internal and leaf page nodes with slotted key arrays.
//   2. Search B-Tree pages with binary/linear probing for exact match or branch routing.
//   3. Insert key-value pairs into leaf nodes with capacity management.
//   4. Execute ordered range scans over leaf node chains.

import "./kv_types.oo";

pub type BTreeNode = struct {
    node_id: Int,
    is_leaf: Bool,
    keys: List[String],
    values: List[String],
    children: List[Int],
    num_keys: Int
};

pub type BTree = struct {
    root_id: Int,
    nodes: List[BTreeNode],
    next_node_id: Int,
    max_degree: Int
};

/// Initialize a new B-Tree index.
pub fn btree_new(max_degree: Int) -> BTree {
    let mut initial_nodes: List[BTreeNode] = list_new();
    let empty_k: List[String] = list_new();
    let empty_v: List[String] = list_new();
    let empty_c: List[Int] = list_new();
    let root: BTreeNode = BTreeNode {
        node_id: 0,
        is_leaf: true,
        keys: empty_k,
        values: empty_v,
        children: empty_c,
        num_keys: 0
    };
    initial_nodes = list_push(initial_nodes, root);
    return BTree {
        root_id: 0,
        nodes: initial_nodes,
        next_node_id: 1,
        max_degree: max_degree
    };
}

/// Search for a key in the B-Tree.
pub fn btree_search(tree: &BTree, key: String) -> Option[String] {
    let mut out: Option[String] = None;
    let mut cur_id: Int = (tree).root_id;
    let n_nodes: Int = list_len((tree).nodes);
    let mut iters: Int = 0;
    while iters < n_nodes {
        let node: BTreeNode = list_get((tree).nodes, cur_id);
        let n: Int = (node).num_keys;
        let mut i: Int = 0;
        let mut found: Bool = false;
        while i < n {
            let k: String = list_get((node).keys, i);
            if k == key {
                let v: String = list_get((node).values, i);
                out = Some(v);
                return out;
            }
            if str_lt(key, k) {
                found = true;
                if !(node).is_leaf && i < list_len((node).children) {
                    cur_id = list_get((node).children, i);
                }
                break;
            }
            i = i + 1;
        }
        if (node).is_leaf {
            return out;
        }
        if !found && !(node).is_leaf && n < list_len((node).children) {
            cur_id = list_get((node).children, n);
        }
        iters = iters + 1;
    }
    return out;
}

/// Insert a key-value pair into the B-Tree leaf.
pub fn btree_insert(tree: &mut BTree, key: String, value: String) -> Result[Bool, String] {
    if key.len() == 0 {
        return Err("ERR\tbtree_insert: empty key");
    }
    let root_idx: Int = (tree).root_id;
    let mut root: BTreeNode = list_get((tree).nodes, root_idx);
    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let n: Int = (root).num_keys;
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get((root).keys, i);
        let v: String = list_get((root).values, i);
        if !inserted && str_lt(key, k) {
            new_keys = list_push(new_keys, key);
            new_vals = list_push(new_vals, value);
            inserted = true;
        }
        if k == key {
            if !inserted {
                new_keys = list_push(new_keys, key);
                new_vals = list_push(new_vals, value);
                inserted = true;
            }
        } else {
            new_keys = list_push(new_keys, k);
            new_vals = list_push(new_vals, v);
        }
        i = i + 1;
    }
    if !inserted {
        new_keys = list_push(new_keys, key);
        new_vals = list_push(new_vals, value);
    }
    root.keys = new_keys;
    root.values = new_vals;
    root.num_keys = list_len(new_keys);
    let mut updated_nodes: List[BTreeNode] = list_new();
    updated_nodes = list_push(updated_nodes, root);
    (tree).nodes = updated_nodes;
    return Ok(true);
}
