// # Dynamic Polyhedral Runtime Guards and Alias Checks
//
// Logline: Emits multiversioning runtime guards checking pointer aliasing and minimum loop trip count thresholds.
//
// Setup: Generates fast vectorized/tiled paths with runtime pointer separation checks and scalar fallback loops.
//
// Beats:
//   1. Represent RuntimeAliasCheck verifying that pointers [ptr_a, ptr_a + len_a] and [ptr_b, ptr_b + len_b] do not overlap.
//   2. Formulate trip count threshold guards for parametric loop nests.
//   3. Build compound multiversioning condition predicates.

pub type RuntimeAliasCheck = struct {
    check_id: Int,
    ptr_a_base: Int,
    ptr_a_bytes: Int,
    ptr_b_base: Int,
    ptr_b_bytes: Int,
    is_disjoint: Bool,
};

pub type RuntimeGuardContext = struct {
    checks: List[RuntimeAliasCheck],
    min_trip_count_required: Int,
    all_guards_pass: Bool,
};

pub fn runtime_alias_check_new(id: Int, a_base: Int, a_sz: Int, b_base: Int, b_sz: Int) -> RuntimeAliasCheck {
    let mut disjoint: Bool = true;
    let a_end: Int = a_base + a_sz;
    let b_end: Int = b_base + b_sz;
    if a_base < b_end && b_base < a_end {
        disjoint = false;
    }
    return RuntimeAliasCheck {
        check_id: id,
        ptr_a_base: a_base,
        ptr_a_bytes: a_sz,
        ptr_b_base: b_base,
        ptr_b_bytes: b_sz,
        is_disjoint: disjoint,
    };
}

pub fn runtime_guard_context_new(min_trip: Int) -> RuntimeGuardContext {
    let empty_checks: List[RuntimeAliasCheck] = list_new();
    return RuntimeGuardContext {
        checks: empty_checks,
        min_trip_count_required: min_trip,
        all_guards_pass: true,
    };
}

pub fn runtime_guard_add_check(mut ctx: RuntimeGuardContext, chk: RuntimeAliasCheck) -> RuntimeGuardContext {
    let mut c_list: List[RuntimeAliasCheck] = (ctx).checks;
    c_list = list_push(c_list, chk);
    ctx.checks = c_list;
    if !(chk).is_disjoint {
        ctx.all_guards_pass = false;
    }
    return ctx;
}

pub fn runtime_guard_evaluate(ctx: RuntimeGuardContext, runtime_trip_count: Int) -> Bool {
    if runtime_trip_count < (ctx).min_trip_count_required {
        return false;
    }
    return (ctx).all_guards_pass;
}
