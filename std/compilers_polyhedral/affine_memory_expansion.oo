// # Affine Memory Expansion and Array Privatization
//
// Logline: Eliminates false WAR and WAW data dependencies by expanding scalar and array variables into iteration-indexed arrays.
//
// Setup: Converts code into Single Assignment Form (SARE) across polyhedral iteration spaces to expose maximal parallelism.
//
// Beats:
//   1. Represent VariableExpansionPlan with original variable name, added array dimensions, and expansion factors.
//   2. Determine required expansion dimension rank to break false dependencies.
//   3. Compute memory overhead vs extracted parallelism trade-off.

pub type VariableExpansionPlan = struct {
    variable_name: String,
    original_rank: Int,
    expanded_rank: Int,
    expansion_dimensions: List[Int],
    is_fully_privatized: Bool
};

pub type MemoryExpansionContext = struct {
    plans: List[VariableExpansionPlan],
    num_expansions: Int,
    total_expanded_bytes: Int
};

pub fn variable_expansion_plan_new(name: String, orig_rank: Int, exp_rank: Int) -> VariableExpansionPlan {
    let empty_dims: List[Int] = list_new();
    return VariableExpansionPlan {
        variable_name: name,
        original_rank: orig_rank,
        expanded_rank: exp_rank,
        expansion_dimensions: empty_dims,
        is_fully_privatized: false
    };
}

pub fn expansion_plan_add_dim(mut plan: VariableExpansionPlan, dim_size: Int) -> VariableExpansionPlan {
    let mut d_list: List[Int] = (plan).expansion_dimensions;
    d_list = list_push(d_list, dim_size);
    plan.expansion_dimensions = d_list;
    return plan;
}

pub fn memory_expansion_context_new() -> MemoryExpansionContext {
    let empty_plans: List[VariableExpansionPlan] = list_new();
    return MemoryExpansionContext {
        plans: empty_plans,
        num_expansions: 0,
        total_expanded_bytes: 0
    };
}

pub fn memory_expansion_add_plan(mut ctx: MemoryExpansionContext, plan: VariableExpansionPlan, elem_size: Int) -> MemoryExpansionContext {
    let mut p_list: List[VariableExpansionPlan] = (ctx).plans;
    p_list = list_push(p_list, plan);
    ctx.plans = p_list;
    ctx.num_expansions = (ctx).num_expansions + 1;
    
    let mut total_elements: Int = 1;
    let mut idx: Int = 0;
    let count: Int = list_len((plan).expansion_dimensions);
    while idx < count {
        total_elements = total_elements * list_get((plan).expansion_dimensions, idx);
        idx = idx + 1;
    }
    ctx.total_expanded_bytes = (ctx).total_expanded_bytes + (total_elements * elem_size);
    return ctx;
}
