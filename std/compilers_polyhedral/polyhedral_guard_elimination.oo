// # Contextual Guard and Bound Simplification
//
// Logline: Eliminates redundant conditional guards and min/max expressions within polyhedral loop nests.
//
// Setup: Evaluates context polyhedra to prove that inner loop conditions are unconditionally true or false.
//
// Beats:
//   1. Represent ConditionalGuard with test inequality and loop nesting level.
//   2. Check if the guard inequality is strictly implied by outer loop bound context polyhedra.
//   3. Simplify nested min/max expressions into single affine bound constants.

pub type ConditionalGuard = struct {
    guard_id: Int,
    loop_level: Int,
    coeff: Int,
    threshold: Int,
    is_greater_or_equal: Bool,
    is_redundant: Bool,
};

pub type GuardEliminationContext = struct {
    guards: List[ConditionalGuard],
    eliminated_count: Int,
    total_guards: Int,
};

pub fn conditional_guard_new(id: Int, level: Int, coeff: Int, thresh: Int, ge: Bool) -> ConditionalGuard {
    return ConditionalGuard {
        guard_id: id,
        loop_level: level,
        coeff: coeff,
        threshold: thresh,
        is_greater_or_equal: ge,
        is_redundant: false,
    };
}

pub fn guard_elimination_context_new() -> GuardEliminationContext {
    let empty_guards: List[ConditionalGuard] = list_new();
    return GuardEliminationContext {
        guards: empty_guards,
        eliminated_count: 0,
        total_guards: 0,
    };
}

pub fn guard_elimination_add_guard(mut ctx: GuardEliminationContext, guard: ConditionalGuard) -> GuardEliminationContext {
    let mut g_list: List[ConditionalGuard] = (ctx).guards;
    g_list = list_push(g_list, guard);
    ctx.guards = g_list;
    ctx.total_guards = (ctx).total_guards + 1;
    return ctx;
}

pub fn guard_is_always_true(guard: ConditionalGuard, iter_min: Int, iter_max: Int) -> Bool {
    if (guard).is_greater_or_equal {
        let min_val: Int = (guard).coeff * iter_min;
        return min_val >= (guard).threshold;
    } else {
        let max_val: Int = (guard).coeff * iter_max;
        return max_val <= (guard).threshold;
    }
}
