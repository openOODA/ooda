// # Polyhedral Domain Coalescing and Redundancy Elimination
//
// Logline: Merge adjacent/overlapping integer intervals to [min_lb, max_ub].
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; List[Int] flattened to lb/ub; Bool to Int.

type SimplificationMetric = struct {
    initial_inequalities: Int,
    remaining_inequalities: Int,
    eliminated_n: Int,
    is_fully_simplified: Int
};

type CoalescedBounds = struct {
    lb: Int,
    ub: Int
};

pub fn simplification_metric_new(initial: Int) -> SimplificationMetric {
    return SimplificationMetric {
        initial_inequalities: initial,
        remaining_inequalities: initial,
        eliminated_n: 0,
        is_fully_simplified: 0
    };
}

pub fn can_coalesce_intervals(lb1: Int, ub1: Int, lb2: Int, ub2: Int) -> Int {
    if ub1 + 1 == lb2 {
        return 1;
    }
    if ub2 + 1 == lb1 {
        return 1;
    }
    if lb1 <= ub2 {
        if lb2 <= ub1 {
            return 1;
        }
    }
    return 0;
}

pub fn coalesce_merged_bounds(lb1: Int, ub1: Int, lb2: Int, ub2: Int) -> CoalescedBounds {
    let mut min_lb: Int = lb1;
    if lb2 < min_lb {
        min_lb = lb2;
    }
    let mut max_ub: Int = ub1;
    if ub2 > max_ub {
        max_ub = ub2;
    }
    return CoalescedBounds {
        lb: min_lb,
        ub: max_ub
    };
}

pub fn coalesce_lb(b: CoalescedBounds) -> Int {
    return b.lb;
}

pub fn coalesce_ub(b: CoalescedBounds) -> Int {
    return b.ub;
}
