// # Outer Loop Auto-Vectorization and Vector Unroll-and-Jam
//
// Logline: Register pressure = unroll_m * unroll_n + 2 load slots.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type OuterLoopVectorConfig = struct {
    outer_loop_id: Int,
    inner_loop_id: Int,
    vector_width: Int,
    unroll_m: Int,
    unroll_n: Int,
    is_outer_vectorizable: Int
};

pub fn outer_loop_vector_config_new(outer_id: Int, inner_id: Int, width: Int) -> OuterLoopVectorConfig {
    return OuterLoopVectorConfig {
        outer_loop_id: outer_id,
        inner_loop_id: inner_id,
        vector_width: width,
        unroll_m: 4,
        unroll_n: 2,
        is_outer_vectorizable: 1
    };
}

pub fn outer_vector_required_vector_registers(cfg: OuterLoopVectorConfig) -> Int {
    let acc_regs: Int = cfg.unroll_m * cfg.unroll_n;
    return acc_regs + 2;
}

pub fn outer_vector_fits_in_regfile(cfg: OuterLoopVectorConfig, available_regs: Int) -> Int {
    let need: Int = outer_vector_required_vector_registers(cfg);
    if need <= available_regs {
        return 1;
    }
    return 0;
}

pub fn outer_vector_unroll_m(cfg: OuterLoopVectorConfig) -> Int {
    return cfg.unroll_m;
}

pub fn outer_vector_unroll_n(cfg: OuterLoopVectorConfig) -> Int {
    return cfg.unroll_n;
}
