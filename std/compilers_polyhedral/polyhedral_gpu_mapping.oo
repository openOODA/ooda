// # Polyhedral GPU Grid/Block/Thread Mapping Engine
//
// Logline: Threads = grid_x*grid_y*block_x*block_y; warp multiple of 32.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type GpuDimensionAssignment = struct {
    loop_level: Int,
    gpu_axis: Int,
    extent: Int
};

type GpuKernelLaunchPlan = struct {
    grid_dim_x: Int,
    grid_dim_y: Int,
    block_dim_x: Int,
    block_dim_y: Int,
    shared_mem_bytes: Int,
    is_coalesced_access: Int
};

pub fn gpu_kernel_launch_plan_new() -> GpuKernelLaunchPlan {
    return GpuKernelLaunchPlan {
        grid_dim_x: 1,
        grid_dim_y: 1,
        block_dim_x: 32,
        block_dim_y: 1,
        shared_mem_bytes: 0,
        is_coalesced_access: 1
    };
}

pub fn gpu_kernel_launch_dims(gx: Int, gy: Int, bx: Int, by: Int, smem: Int) -> GpuKernelLaunchPlan {
    return GpuKernelLaunchPlan {
        grid_dim_x: gx,
        grid_dim_y: gy,
        block_dim_x: bx,
        block_dim_y: by,
        shared_mem_bytes: smem,
        is_coalesced_access: 1
    };
}

pub fn gpu_compute_total_threads(plan: GpuKernelLaunchPlan) -> Int {
    let total_blocks: Int = plan.grid_dim_x * plan.grid_dim_y;
    let threads_per_block: Int = plan.block_dim_x * plan.block_dim_y;
    return total_blocks * threads_per_block;
}

pub fn gpu_is_warp_multiple(threads_per_block: Int) -> Int {
    if (threads_per_block % 32) == 0 {
        return 1;
    }
    return 0;
}

pub fn gpu_block_dim_x(plan: GpuKernelLaunchPlan) -> Int {
    return plan.block_dim_x;
}

pub fn gpu_shared_mem_bytes(plan: GpuKernelLaunchPlan) -> Int {
    return plan.shared_mem_bytes;
}
