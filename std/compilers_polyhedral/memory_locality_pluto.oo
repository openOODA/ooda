// # Pluto Algorithm Locality and Tiling Cost Model
//
// Logline: Implements the Pluto polyhedral scheduler cost functions to minimize reuse distance and maximize loop tiling bands.
//
// Setup: Formulates integer linear programming constraints bounding affine dependence distances |theta(sink) - theta(src)| <= delta.
//
// Beats:
//   1. Define PlutoDependenceCost and LocalityObjective structures.
//   2. Measure spatial stride and temporal reuse along candidate schedule dimensions.
//   3. Compute schedule permutation scores prioritizing outer parallel loops and inner vectorizable unit-stride bands.

pub type PlutoDependenceCost = struct {
    edge_id: Int,
    src_stmt: Int,
    sink_stmt: Int,
    bounding_distance_delta: Int,
    is_satisfied: Bool,
};

pub type LocalityObjective = struct {
    num_edges: Int,
    costs: List[PlutoDependenceCost],
    total_latency_bound: Int,
    spatial_stride_score: Int,
};

pub fn pluto_dependence_cost_new(edge: Int, src: Int, sink: Int, delta: Int) -> PlutoDependenceCost {
    return PlutoDependenceCost {
        edge_id: edge,
        src_stmt: src,
        sink_stmt: sink,
        bounding_distance_delta: delta,
        is_satisfied: true,
    };
}

pub fn locality_objective_new() -> LocalityObjective {
    let empty_costs: List[PlutoDependenceCost] = list_new();
    return LocalityObjective {
        num_edges: 0,
        costs: empty_costs,
        total_latency_bound: 0,
        spatial_stride_score: 0,
    };
}

pub fn locality_objective_add_cost(mut obj: LocalityObjective, cost: PlutoDependenceCost) -> LocalityObjective {
    let mut c_list: List[PlutoDependenceCost] = (obj).costs;
    c_list = list_push(c_list, cost);
    obj.costs = c_list;
    obj.num_edges = (obj).num_edges + 1;
    obj.total_latency_bound = (obj).total_latency_bound + (cost).bounding_distance_delta;
    return obj;
}

pub fn pluto_evaluate_tiling_legality(costs: List[PlutoDependenceCost]) -> Bool {
    let mut idx: Int = 0;
    let count: Int = list_len(costs);
    while idx < count {
        let c: PlutoDependenceCost = list_get(costs, idx);
        if (c).bounding_distance_delta < 0 {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}
