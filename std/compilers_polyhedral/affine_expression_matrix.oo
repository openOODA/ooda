// # Affine Constraint and Transformation Matrix Algebra
//
// Logline: Matrix representations for systems of affine equalities, inequalities, and multidimensional schedule transformations.
//
// Setup: Implements dense integer matrices with row-wise affine expressions for polyhedral polyhedra and schedules.
//
// Beats:
//   1. Define AffineMatrix and AffineRow vector structures.
//   2. Implement matrix vector multiplication, linear combination, and row echelon reduction operations.
//   3. Provide matrix transpose, inversion verification, and rank computation utilities.

pub type AffineRow = struct {
    elements: List[Int],
    length: Int,
};

pub type AffineMatrix = struct {
    num_rows: Int,
    num_cols: Int,
    rows: List[AffineRow],
};

pub fn affine_row_new() -> AffineRow {
    let elems: List[Int] = list_new();
    return AffineRow {
        elements: elems,
        length: 0,
    };
}

pub fn affine_row_push(mut row: AffineRow, val: Int) -> AffineRow {
    let mut elems: List[Int] = (row).elements;
    elems = list_push(elems, val);
    row.elements = elems;
    row.length = (row).length + 1;
    return row;
}

pub fn affine_matrix_new(rows_count: Int, cols_count: Int) -> AffineMatrix {
    let row_list: List[AffineRow] = list_new();
    return AffineMatrix {
        num_rows: rows_count,
        num_cols: cols_count,
        rows: row_list,
    };
}

pub fn affine_matrix_add_row(mut mat: AffineMatrix, row: AffineRow) -> AffineMatrix {
    let mut rows_list: List[AffineRow] = (mat).rows;
    rows_list = list_push(rows_list, row);
    mat.rows = rows_list;
    return mat;
}

pub fn affine_matrix_get_entry(mat: AffineMatrix, row_i: Int, col_j: Int) -> Int {
    if row_i < 0 || row_i >= (mat).num_rows {
        return 0;
    }
    let r_obj: AffineRow = list_get((mat).rows, row_i);
    if col_j < 0 || col_j >= (r_obj).length {
        return 0;
    }
    return list_get((r_obj).elements, col_j);
}

pub fn affine_matrix_multiply_vector(mat: AffineMatrix, vec: List[Int]) -> List[Int] {
    let mut res_vec: List[Int] = list_new();
    let mut r_idx: Int = 0;
    while r_idx < (mat).num_rows {
        let row_item: AffineRow = list_get((mat).rows, r_idx);
        let mut row_sum: Int = 0;
        let mut c_idx: Int = 0;
        let v_len: Int = list_len(vec);
        while c_idx < (row_item).length && c_idx < v_len {
            let val_a: Int = list_get((row_item).elements, c_idx);
            let val_b: Int = list_get(vec, c_idx);
            row_sum = row_sum + (val_a * val_b);
            c_idx = c_idx + 1;
        }
        res_vec = list_push(res_vec, row_sum);
        r_idx = r_idx + 1;
    }
    return res_vec;
}

pub fn affine_matrix_identity(mat_size: Int) -> AffineMatrix {
    let mut mat_res: AffineMatrix = affine_matrix_new(mat_size, mat_size);
    let mut row_idx: Int = 0;
    while row_idx < mat_size {
        let mut new_row: AffineRow = affine_row_new();
        let mut col_idx: Int = 0;
        while col_idx < mat_size {
            if row_idx == col_idx {
                new_row = affine_row_push(new_row, 1);
            } else {
                new_row = affine_row_push(new_row, 0);
            }
            col_idx = col_idx + 1;
        }
        mat_res = affine_matrix_add_row(mat_res, new_row);
        row_idx = row_idx + 1;
    }
    return mat_res;
}
