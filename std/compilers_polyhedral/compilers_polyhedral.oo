pub fn compilers_polyhedral_version() -> String {
    return "openOODA-Compilers-Polyhedral-v2.0";
}

pub fn compilers_polyhedral_submodule_count() -> Int {
    return 49;
}

pub fn compilers_polyhedral_create_default_pipeline(opt_level: Int) -> PolyhedralPipeline {
    return polyhedral_pipeline_new(opt_level);
}

pub fn compilers_polyhedral_create_gemm_benchmark() -> PolyhedralBenchmarkKernel {
    return stub_gemm_kernel();
}

pub fn compilers_polyhedral_create_tile_plan(depth: Int, levels: Int) -> PolyhedralTilePlan {
    return polyhedral_tile_plan_new(depth, levels);
}

pub fn compilers_polyhedral_create_domain(id: Int, dims: Int) -> PolyhedralDomain {
    return polyhedral_domain_new(id, dims);
}

pub fn compilers_polyhedral_create_audit_report(name: String) -> PolyhedralAuditReport {
    return polyhedral_audit_report_new(name);
}
