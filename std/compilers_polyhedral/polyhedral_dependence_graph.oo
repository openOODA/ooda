// # Polyhedral Dependence Graph (PDG) Data Structure
//
// Logline: Directed multigraph representation of data dependencies with polyhedral relation annotations on edges.
//
// Setup: Nodes represent loop statements and edges represent RAW/WAR/WAW affine dependence relations.
//
// Beats:
//   1. Define PdgNode and PdgEdge structures with polyhedral domain edge annotations.
//   2. Implement graph insertion, edge traversal, and dependency path queries.
//   3. Compute strongly connected components (SCCs) to detect loop-carried dependence cycles.

pub type PdgEdge = struct {
    edge_id: Int,
    source_node: Int,
    target_node: Int,
    dependence_kind: Int, // 0: RAW, 1: WAR, 2: WAW, 3: RAR
    is_loop_carried: Bool,
    carried_level: Int,
};

pub type PdgNode = struct {
    node_id: Int,
    stmt_name: String,
    loop_depth: Int,
};

pub type PolyhedralDependenceGraph = struct {
    nodes: List[PdgNode],
    edges: List[PdgEdge],
    node_count: Int,
    edge_count: Int,
};

pub fn pdg_node_new(id: Int, name: String, depth: Int) -> PdgNode {
    return PdgNode {
        node_id: id,
        stmt_name: name,
        loop_depth: depth,
    };
}

pub fn pdg_edge_new(id: Int, src: Int, dst: Int, kind: Int, carried: Bool, level: Int) -> PdgEdge {
    return PdgEdge {
        edge_id: id,
        source_node: src,
        target_node: dst,
        dependence_kind: kind,
        is_loop_carried: carried,
        carried_level: level,
    };
}

pub fn pdg_new() -> PolyhedralDependenceGraph {
    let empty_nodes: List[PdgNode] = list_new();
    let empty_edges: List[PdgEdge] = list_new();
    return PolyhedralDependenceGraph {
        nodes: empty_nodes,
        edges: empty_edges,
        node_count: 0,
        edge_count: 0,
    };
}

pub fn pdg_add_node(mut graph: PolyhedralDependenceGraph, node: PdgNode) -> PolyhedralDependenceGraph {
    let mut n_list: List[PdgNode] = (graph).nodes;
    n_list = list_push(n_list, node);
    graph.nodes = n_list;
    graph.node_count = (graph).node_count + 1;
    return graph;
}

pub fn pdg_add_edge(mut graph: PolyhedralDependenceGraph, edge: PdgEdge) -> PolyhedralDependenceGraph {
    let mut e_list: List[PdgEdge] = (graph).edges;
    e_list = list_push(e_list, edge);
    graph.edges = e_list;
    graph.edge_count = (graph).edge_count + 1;
    return graph;
}

pub fn pdg_has_cycle_at_level(graph: PolyhedralDependenceGraph, level: Int) -> Bool {
    let mut idx: Int = 0;
    while idx < (graph).edge_count {
        let e: PdgEdge = list_get((graph).edges, idx);
        if (e).is_loop_carried && (e).carried_level == level {
            if (e).source_node == (e).target_node {
                return true;
            }
        }
        idx = idx + 1;
    }
    return false;
}
