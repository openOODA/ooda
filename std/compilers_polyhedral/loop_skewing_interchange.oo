// # Loop Skewing, Interchange, and Reversal Transformations
//
// Logline: 2x2 unimodular interchange/skew and dependence legality.
// residual: pub type destubbed; apply flattened onto last_i/last_j.

type UnimodularMatrix2x2 = struct {
    m00: Int,
    m01: Int,
    m10: Int,
    m11: Int,
    last_i: Int,
    last_j: Int
};

pub fn unimodular_2x2_identity() -> UnimodularMatrix2x2 {
    return UnimodularMatrix2x2 {
        m00: 1,
        m01: 0,
        m10: 0,
        m11: 1,
        last_i: 0,
        last_j: 0
    };
}

pub fn unimodular_2x2_interchange() -> UnimodularMatrix2x2 {
    return UnimodularMatrix2x2 {
        m00: 0,
        m01: 1,
        m10: 1,
        m11: 0,
        last_i: 0,
        last_j: 0
    };
}

pub fn unimodular_2x2_skew(skew_factor: Int) -> UnimodularMatrix2x2 {
    return UnimodularMatrix2x2 {
        m00: 1,
        m01: 0,
        m10: skew_factor,
        m11: 1,
        last_i: 0,
        last_j: 0
    };
}

pub fn unimodular_2x2_determinant(mat: UnimodularMatrix2x2) -> Int {
    return (mat.m00 * mat.m11) - (mat.m01 * mat.m10);
}

pub fn unimodular_2x2_is_valid(mat: UnimodularMatrix2x2) -> Int {
    let det_val: Int = unimodular_2x2_determinant(mat);
    if det_val == 1 {
        return 1;
    }
    if det_val == 0 - 1 {
        return 1;
    }
    return 0;
}

pub fn unimodular_2x2_apply(mat: UnimodularMatrix2x2, iter_i: Int, iter_j: Int) -> UnimodularMatrix2x2 {
    let new_i: Int = (mat.m00 * iter_i) + (mat.m01 * iter_j);
    let new_j: Int = (mat.m10 * iter_i) + (mat.m11 * iter_j);
    return UnimodularMatrix2x2 {
        m00: mat.m00,
        m01: mat.m01,
        m10: mat.m10,
        m11: mat.m11,
        last_i: new_i,
        last_j: new_j
    };
}

pub fn is_interchange_legal_2d(dist_i: Int, dist_j: Int) -> Int {
    if dist_j < 0 {
        return 0;
    }
    if dist_j == 0 {
        if dist_i < 0 {
            return 0;
        }
    }
    return 1;
}

pub fn unimodular_2x2_last_i(mat: UnimodularMatrix2x2) -> Int {
    return mat.last_i;
}

pub fn unimodular_2x2_last_j(mat: UnimodularMatrix2x2) -> Int {
    return mat.last_j;
}
