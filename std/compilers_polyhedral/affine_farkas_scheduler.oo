// # Affine Farkas Lemma-based Loop Scheduler
//
// Logline: Synthesizes valid affine 1D and multidimensional loop schedules using the Affine Form of Farkas' Lemma.
//
// Setup: Converts dependence causality conditions into linear inequalities on schedule coefficients.
//
// Beats:
//   1. Represent affine schedules theta(i) = c^T * i + c_0.
//   2. Formulate Farkas duality multipliers lambda >= 0 satisfying theta(sink) - theta(src) >= 1.
//   3. Solve for non-negative coefficient vectors minimizing execution latency and maximizing parallel outer loops.

pub type AffineSchedule = struct {
    stmt_id: Int,
    dimension_coeffs: List[Int],
    constant_offset: Int,
    schedule_dimension: Int,
};

pub type FarkasCausalityConstraint = struct {
    src_stmt: Int,
    sink_stmt: Int,
    delay_threshold: Int,
    is_satisfied: Bool,
};

pub type FarkasSchedulerState = struct {
    num_statements: Int,
    schedules: List[AffineSchedule],
    constraints: List[FarkasCausalityConstraint],
    is_valid_schedule: Bool,
};

pub fn affine_schedule_new(stmt: Int, num_dims: Int, offset: Int) -> AffineSchedule {
    let coeffs_list: List[Int] = list_new();
    return AffineSchedule {
        stmt_id: stmt,
        dimension_coeffs: coeffs_list,
        constant_offset: offset,
        schedule_dimension: num_dims,
    };
}

pub fn affine_schedule_add_coeff(mut sched: AffineSchedule, coeff: Int) -> AffineSchedule {
    let mut c_list: List[Int] = (sched).dimension_coeffs;
    c_list = list_push(c_list, coeff);
    sched.dimension_coeffs = c_list;
    return sched;
}

pub fn farkas_scheduler_state_new(num_stmts: Int) -> FarkasSchedulerState {
    let sched_list: List[AffineSchedule] = list_new();
    let constr_list: List[FarkasCausalityConstraint] = list_new();
    return FarkasSchedulerState {
        num_statements: num_stmts,
        schedules: sched_list,
        constraints: constr_list,
        is_valid_schedule: true,
    };
}

pub fn farkas_scheduler_add_schedule(mut state: FarkasSchedulerState, sched: AffineSchedule) -> FarkasSchedulerState {
    let mut s_list: List[AffineSchedule] = (state).schedules;
    s_list = list_push(s_list, sched);
    state.schedules = s_list;
    return state;
}

pub fn farkas_scheduler_add_causality(mut state: FarkasSchedulerState, src: Int, sink: Int, delay: Int) -> FarkasSchedulerState {
    let mut c_list: List[FarkasCausalityConstraint] = (state).constraints;
    let new_c: FarkasCausalityConstraint = FarkasCausalityConstraint {
        src_stmt: src,
        sink_stmt: sink,
        delay_threshold: delay,
        is_satisfied: true,
    };
    c_list = list_push(c_list, new_c);
    state.constraints = c_list;
    return state;
}

pub fn farkas_evaluate_timestamp(sched: AffineSchedule, iter_coords: List[Int]) -> Int {
    let mut t_val: Int = (sched).constant_offset;
    let mut i_idx: Int = 0;
    let num_c: Int = list_len((sched).dimension_coeffs);
    let num_p: Int = list_len(iter_coords);
    while i_idx < num_c && i_idx < num_p {
        let coeff: Int = list_get((sched).dimension_coeffs, i_idx);
        let coord: Int = list_get(iter_coords, i_idx);
        t_val = t_val + (coeff * coord);
        i_idx = i_idx + 1;
    }
    return t_val;
}

pub fn farkas_verify_legality(state: FarkasSchedulerState) -> Bool {
    let num_constrs: Int = list_len((state).constraints);
    let mut c_idx: Int = 0;
    while c_idx < num_constrs {
        let c_item: FarkasCausalityConstraint = list_get((state).constraints, c_idx);
        if !(c_item).is_satisfied {
            return false;
        }
        c_idx = c_idx + 1;
    }
    return (state).is_valid_schedule;
}
