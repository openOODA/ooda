// # General N-Dimensional Unimodular Loop Transformation Engine
//
// Logline: 3x3 unimodular det ±1 and integer bijection.
// residual: pub type destubbed; apply flattened onto last_y*.

type UnimodularMatrix3x3 = struct {
    m00: Int,
    m01: Int,
    m02: Int,
    m10: Int,
    m11: Int,
    m12: Int,
    m20: Int,
    m21: Int,
    m22: Int,
    last_y0: Int,
    last_y1: Int,
    last_y2: Int
};

pub fn unimodular_3x3_new(
    m00: Int,
    m01: Int,
    m02: Int,
    m10: Int,
    m11: Int,
    m12: Int,
    m20: Int,
    m21: Int,
    m22: Int
) -> UnimodularMatrix3x3 {
    return UnimodularMatrix3x3 {
        m00: m00,
        m01: m01,
        m02: m02,
        m10: m10,
        m11: m11,
        m12: m12,
        m20: m20,
        m21: m21,
        m22: m22,
        last_y0: 0,
        last_y1: 0,
        last_y2: 0
    };
}

pub fn unimodular_3x3_identity() -> UnimodularMatrix3x3 {
    return unimodular_3x3_new(1, 0, 0, 0, 1, 0, 0, 0, 1);
}

pub fn unimodular_3x3_determinant(m: UnimodularMatrix3x3) -> Int {
    let t11: Int = (m.m11 * m.m22) - (m.m12 * m.m21);
    let t12: Int = (m.m10 * m.m22) - (m.m12 * m.m20);
    let t13: Int = (m.m10 * m.m21) - (m.m11 * m.m20);
    let term1: Int = m.m00 * t11;
    let term2: Int = m.m01 * t12;
    let term3: Int = m.m02 * t13;
    return (term1 - term2) + term3;
}

pub fn unimodular_3x3_is_legal(m: UnimodularMatrix3x3) -> Int {
    let det_val: Int = unimodular_3x3_determinant(m);
    if det_val == 1 {
        return 1;
    }
    if det_val == 0 - 1 {
        return 1;
    }
    return 0;
}

pub fn unimodular_3x3_apply(m: UnimodularMatrix3x3, c0: Int, c1: Int, c2: Int) -> UnimodularMatrix3x3 {
    let y0: Int = ((m.m00 * c0) + (m.m01 * c1)) + (m.m02 * c2);
    let y1: Int = ((m.m10 * c0) + (m.m11 * c1)) + (m.m12 * c2);
    let y2: Int = ((m.m20 * c0) + (m.m21 * c1)) + (m.m22 * c2);
    return UnimodularMatrix3x3 {
        m00: m.m00,
        m01: m.m01,
        m02: m.m02,
        m10: m.m10,
        m11: m.m11,
        m12: m.m12,
        m20: m.m20,
        m21: m.m21,
        m22: m.m22,
        last_y0: y0,
        last_y1: y1,
        last_y2: y2
    };
}

pub fn unimodular_3x3_last_y0(m: UnimodularMatrix3x3) -> Int {
    return m.last_y0;
}

pub fn unimodular_3x3_last_y1(m: UnimodularMatrix3x3) -> Int {
    return m.last_y1;
}
