// # Polyhedral Basic Integer Maps and Binary Relations
//
// Logline: Binary relations and affine mappings between input and output multi-dimensional integer vector spaces.
//
// Setup: Encapsulates mappings [in_1, in_2] -> [out_1, out_2] subject to equality and inequality constraints.
//
// Beats:
//   1. Represent BasicIntegerMap with domain dimensions, range dimensions, and affine map matrices.
//   2. Apply map relations to project input iteration points into output target spaces.
//   3. Compute map domain and range space dimension identities.

pub type MapDimensionMapping = struct {
    out_dim_idx: Int,
    in_coeffs: List[Int],
    constant_val: Int
};

pub type BasicIntegerMap = struct {
    map_id: Int,
    num_in_dims: Int,
    num_out_dims: Int,
    mappings: List[MapDimensionMapping]
};

pub fn map_dimension_mapping_new(out_idx: Int, coeffs: List[Int], c_val: Int) -> MapDimensionMapping {
    return MapDimensionMapping {
        out_dim_idx: out_idx,
        in_coeffs: coeffs,
        constant_val: c_val
    };
}

pub fn basic_integer_map_new(id: Int, in_dims: Int, out_dims: Int) -> BasicIntegerMap {
    let empty_mappings: List[MapDimensionMapping] = list_new();
    return BasicIntegerMap {
        map_id: id,
        num_in_dims: in_dims,
        num_out_dims: out_dims,
        mappings: empty_mappings
    };
}

pub fn basic_map_add_dim(mut bmap: BasicIntegerMap, mapping: MapDimensionMapping) -> BasicIntegerMap {
    let mut m_list: List[MapDimensionMapping] = (bmap).mappings;
    m_list = list_push(m_list, mapping);
    bmap.mappings = m_list;
    return bmap;
}

pub fn basic_map_apply_point(bmap: BasicIntegerMap, in_point: List[Int]) -> List[Int] {
    let mut out_point: List[Int] = list_new();
    let mut idx: Int = 0;
    let count: Int = list_len((bmap).mappings);
    while idx < count {
        let m: MapDimensionMapping = list_get((bmap).mappings, idx);
        let mut out_val: Int = (m).constant_val;
        let mut i: Int = 0;
        let num_c: Int = list_len((m).in_coeffs);
        let num_p: Int = list_len(in_point);
        while i < num_c && i < num_p {
            let coeff: Int = list_get((m).in_coeffs, i);
            let coord: Int = list_get(in_point, i);
            out_val = out_val + (coeff * coord);
            i = i + 1;
        }
        out_point = list_push(out_point, out_val);
        idx = idx + 1;
    }
    return out_point;
}
