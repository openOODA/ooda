// # Analytical Unroll Factor and Tile Size Auto-Tuner
//
// Logline: Register-pressure score for (Ti,Tj,Tk,Ui,Uj) tile/unroll candidates.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type TuningCandidate = struct {
    candidate_id: Int,
    tile_i: Int,
    tile_j: Int,
    tile_k: Int,
    unroll_i: Int,
    unroll_j: Int,
    predicted_gflops: Int,
    register_spill_risk: Int
};

pub fn tuning_candidate_new(id: Int, ti: Int, tj: Int, tk: Int, ui: Int, uj: Int) -> TuningCandidate {
    let reg_pressure: Int = (ui * uj) + ui + uj;
    let mut spill: Int = 0;
    if reg_pressure > 32 {
        spill = 1;
    }
    return TuningCandidate {
        candidate_id: id,
        tile_i: ti,
        tile_j: tj,
        tile_k: tk,
        unroll_i: ui,
        unroll_j: uj,
        predicted_gflops: 0,
        register_spill_risk: spill
    };
}

pub fn score_tuning_candidate(cand: TuningCandidate) -> Int {
    if cand.register_spill_risk != 0 {
        return 10;
    }
    let tile_volume: Int = cand.tile_i * cand.tile_j * cand.tile_k;
    let unroll_intensity: Int = cand.unroll_i * cand.unroll_j * 10;
    return unroll_intensity + (tile_volume / 100);
}

pub fn tuner_spill_risk(cand: TuningCandidate) -> Int {
    return cand.register_spill_risk;
}

pub fn tuner_score(cand: TuningCandidate) -> Int {
    return score_tuning_candidate(cand);
}
