// # Superword-Level Parallelism (SLP) Vector Pack Tree Builder
//
// Logline: Constructs SLP vectorization pack trees by matching isomorphic scalar operations and seeds.
//
// Setup: Identifies parallel scalar instruction chains, checks operand alignment, and builds SIMD pack DAGs.
//
// Beats:
//   1. Define SlpTreeNode, SlpPack, and SlpForest data structures.
//   2. Match isomorphic scalar operation seeds (adjacent memory stores/loads).
//   3. Recursively build SLP vectorization trees and compute vectorization profitability.

pub type SlpScalarInstruction = struct {
    inst_id: Int,
    opcode: Int,
    output_var: String,
    input_a: String,
    input_b: String,
};

pub type SlpVectorPack = struct {
    pack_id: Int,
    vector_width: Int, // 2: 64b, 4: 128b, 8: 256b, 16: 512b
    opcode: Int,
    scalar_instructions: List[SlpScalarInstruction],
    scalar_count: Int,
    is_profitable: Bool,
    cost_saving: Int,
};

pub type SlpTreeContext = struct {
    packs: List[SlpVectorPack],
    pack_count: Int,
    total_cost_saving: Int,
};

pub fn slp_scalar_inst_new(id: Int, op: Int, out: String, in_a: String, in_b: String) -> SlpScalarInstruction {
    return SlpScalarInstruction {
        inst_id: id,
        opcode: op,
        output_var: out,
        input_a: in_a,
        input_b: in_b,
    };
}

pub fn slp_vector_pack_new(id: Int, width: Int, op: Int) -> SlpVectorPack {
    let empty_insts: List[SlpScalarInstruction] = list_new();
    return SlpVectorPack {
        pack_id: id,
        vector_width: width,
        opcode: op,
        scalar_instructions: empty_insts,
        scalar_count: 0,
        is_profitable: false,
        cost_saving: 0,
    };
}

pub fn slp_pack_add_instruction(mut pack: SlpVectorPack, inst: SlpScalarInstruction) -> SlpVectorPack {
    let mut i_list: List[SlpScalarInstruction] = (pack).scalar_instructions;
    i_list = list_push(i_list, inst);
    pack.scalar_instructions = i_list;
    pack.scalar_count = (pack).scalar_count + 1;
    return pack;
}

pub fn slp_tree_context_new() -> SlpTreeContext {
    let empty_packs: List[SlpVectorPack] = list_new();
    return SlpTreeContext {
        packs: empty_packs,
        pack_count: 0,
        total_cost_saving: 0,
    };
}

pub fn slp_tree_add_pack(mut ctx: SlpTreeContext, pack: SlpVectorPack) -> SlpTreeContext {
    let mut p_list: List[SlpVectorPack] = (ctx).packs;
    p_list = list_push(p_list, pack);
    ctx.packs = p_list;
    ctx.pack_count = (ctx).pack_count + 1;
    ctx.total_cost_saving = (ctx).total_cost_saving + (pack).cost_saving;
    return ctx;
}

pub fn slp_compute_pack_profitability(pack: SlpVectorPack) -> Int {
    let count: Int = (pack).scalar_count;
    if count < 2 {
        return -50;
    }
    let scalar_cost: Int = count * 10;
    let vector_cost: Int = 12;
    return scalar_cost - vector_cost;
}
