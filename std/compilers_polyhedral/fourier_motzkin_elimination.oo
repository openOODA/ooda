// # Fourier-Motzkin Variable Elimination Algorithm
//
// Logline: Exact polyhedral projection and quantifier elimination for integer and rational polyhedra.
//
// Setup: Eliminates target variables from systems of affine inequalities by pairing positive and negative coefficients.
//
// Beats:
//   1. Partition linear inequalities into positive, negative, and zero coefficients for a designated variable.
//   2. Generate cross-product pairs of bounds to eliminate the projected dimension.
//   3. Filter trivially redundant constraints and normalize greatest common divisors.

pub type FmInequality = struct {
    coeffs: List[Int],
    constant_val: Int,
};

pub type FmSystem = struct {
    num_vars: Int,
    inequalities: List[FmInequality],
    count: Int,
};

pub fn fm_inequality_new(coeffs: List[Int], const_v: Int) -> FmInequality {
    return FmInequality {
        coeffs: coeffs,
        constant_val: const_v,
    };
}

pub fn fm_system_new(vars_count: Int) -> FmSystem {
    let ineqs_list: List[FmInequality] = list_new();
    return FmSystem {
        num_vars: vars_count,
        inequalities: ineqs_list,
        count: 0,
    };
}

pub fn fm_system_add(mut sys: FmSystem, ineq: FmInequality) -> FmSystem {
    let mut ineqs_list: List[FmInequality] = (sys).inequalities;
    ineqs_list = list_push(ineqs_list, ineq);
    sys.inequalities = ineqs_list;
    sys.count = (sys).count + 1;
    return sys;
}

pub fn fm_gcd(num_a: Int, num_b: Int) -> Int {
    let mut val_x: Int = num_a;
    let mut val_y: Int = num_b;
    if val_x < 0 { val_x = 0 - val_x; }
    if val_y < 0 { val_y = 0 - val_y; }
    while val_y != 0 {
        let temp_t: Int = val_y;
        val_y = val_x % val_y;
        val_x = temp_t;
    }
    if val_x == 0 { return 1; }
    return val_x;
}

pub fn fm_eliminate_variable(sys: FmSystem, target_var_idx: Int) -> FmSystem {
    let mut pos_list: List[FmInequality] = list_new();
    let mut neg_list: List[FmInequality] = list_new();
    let mut zero_list: List[FmInequality] = list_new();
    
    let mut idx: Int = 0;
    while idx < (sys).count {
        let ineq: FmInequality = list_get((sys).inequalities, idx);
        let coeff_val: Int = list_get((ineq).coeffs, target_var_idx);
        if coeff_val > 0 {
            pos_list = list_push(pos_list, ineq);
        } else if coeff_val < 0 {
            neg_list = list_push(neg_list, ineq);
        } else {
            zero_list = list_push(zero_list, ineq);
        }
        idx = idx + 1;
    }
    
    let mut new_sys: FmSystem = fm_system_new((sys).num_vars - 1);
    let mut z_idx: Int = 0;
    while z_idx < list_len(zero_list) {
        new_sys = fm_system_add(new_sys, list_get(zero_list, z_idx));
        z_idx = z_idx + 1;
    }
    
    let mut p_idx: Int = 0;
    while p_idx < list_len(pos_list) {
        let pos_ineq: FmInequality = list_get(pos_list, p_idx);
        let pos_coeff: Int = list_get((pos_ineq).coeffs, target_var_idx);
        let mut n_idx: Int = 0;
        while n_idx < list_len(neg_list) {
            let neg_ineq: FmInequality = list_get(neg_list, n_idx);
            let neg_coeff: Int = 0 - list_get((neg_ineq).coeffs, target_var_idx);
            
            let mut comb_coeffs: List[Int] = list_new();
            let mut v_idx: Int = 0;
            while v_idx < (sys).num_vars {
                if v_idx != target_var_idx {
                    let c_p: Int = list_get((pos_ineq).coeffs, v_idx);
                    let c_n: Int = list_get((neg_ineq).coeffs, v_idx);
                    let c_combined: Int = (c_p * neg_coeff) + (c_n * pos_coeff);
                    comb_coeffs = list_push(comb_coeffs, c_combined);
                }
                v_idx = v_idx + 1;
            }
            let c_const: Int = ((pos_ineq).constant_val * neg_coeff) + ((neg_ineq).constant_val * pos_coeff);
            new_sys = fm_system_add(new_sys, fm_inequality_new(comb_coeffs, c_const));
            n_idx = n_idx + 1;
        }
        p_idx = p_idx + 1;
    }
    return new_sys;
}
