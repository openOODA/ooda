// # Parametric Polyhedral Analysis and Symbolic Solver
//
// Logline: Analyzes polyhedral iteration spaces parameterized by runtime symbolic variables (N, M, K).
//
// Setup: Treats outer problem dimensions as symbolic parameters, computing parametric bounds and existence conditions.
//
// Beats:
//   1. Define SymbolicParameter and ParametricConstraint structures.
//   2. Formulate parametric iteration spaces where bounds depend on affine combinations of parameters.
//   3. Check domain non-emptiness conditioned on parameter value intervals.

pub type SymbolicParameter = struct {
    param_id: Int,
    param_name: String,
    min_value: Int,
    max_value: Int
};

pub type ParametricConstraint = struct {
    dim_coeffs: List[Int],
    param_coeffs: List[Int],
    constant_val: Int,
    is_strict_ineq: Bool
};

pub type ParametricDomain = struct {
    domain_id: Int,
    num_dims: Int,
    num_params: Int,
    parameters: List[SymbolicParameter],
    constraints: List[ParametricConstraint]
};

pub fn symbolic_parameter_new(id: Int, name: String, min_v: Int, max_v: Int) -> SymbolicParameter {
    return SymbolicParameter {
        param_id: id,
        param_name: name,
        min_value: min_v,
        max_value: max_v
    };
}

pub fn parametric_domain_new(id: Int, dims: Int, params: Int) -> ParametricDomain {
    let p_list: List[SymbolicParameter] = list_new();
    let c_list: List[ParametricConstraint] = list_new();
    return ParametricDomain {
        domain_id: id,
        num_dims: dims,
        num_params: params,
        parameters: p_list,
        constraints: c_list
    };
}

pub fn parametric_domain_add_param(mut dom: ParametricDomain, param: SymbolicParameter) -> ParametricDomain {
    let mut p_list: List[SymbolicParameter] = (dom).parameters;
    p_list = list_push(p_list, param);
    dom.parameters = p_list;
    return dom;
}

pub fn parametric_domain_add_constraint(mut dom: ParametricDomain, constr: ParametricConstraint) -> ParametricDomain {
    let mut c_list: List[ParametricConstraint] = (dom).constraints;
    c_list = list_push(c_list, constr);
    dom.constraints = c_list;
    return dom;
}

pub fn parametric_evaluate_at_instance(constr: ParametricConstraint, dims: List[Int], param_vals: List[Int]) -> Bool {
    let mut sum_val: Int = (constr).constant_val;
    let mut d_idx: Int = 0;
    let d_count: Int = list_len(dims);
    while d_idx < d_count && d_idx < list_len((constr).dim_coeffs) {
        let c_d: Int = list_get((constr).dim_coeffs, d_idx);
        let v_d: Int = list_get(dims, d_idx);
        sum_val = sum_val + (c_d * v_d);
        d_idx = d_idx + 1;
    }
    let mut p_idx: Int = 0;
    let p_count: Int = list_len(param_vals);
    while p_idx < p_count && p_idx < list_len((constr).param_coeffs) {
        let c_p: Int = list_get((constr).param_coeffs, p_idx);
        let v_p: Int = list_get(param_vals, p_idx);
        sum_val = sum_val + (c_p * v_p);
        p_idx = p_idx + 1;
    }
    if (constr).is_strict_ineq {
        return sum_val > 0;
    }
    return sum_val >= 0;
}
