// # Multi-Level Polyhedral Loop Tiling Engine
//
// Logline: Parametric and multi-level loop tiling transformation for cache hierarchy locality and wavefront parallelism.
//
// Setup: Divides high-dimensional polyhedral iteration spaces into rectangular and skewed tiles for L1/L2/L3 caches.
//
// Beats:
//   1. Represent TileBandConfig with tile dimensions, tile sizes, and skew factors.
//   2. Compute point-loop and tile-loop bounds from original affine iteration polytopes.
//   3. Generate parametric tile sizes and wavefront tiling schedule transformations.

pub type TileDimension = struct {
    dim_index: Int,
    tile_size: Int,
    is_wavefront: Bool,
    skew_factor: Int
};

pub type PolyhedralTilePlan = struct {
    loop_nest_depth: Int,
    tile_levels: Int, // 1: L1, 2: L1+L2, 3: Register+L1+L2
    tile_dims: List[TileDimension],
    num_tiled_loops: Int,
    is_legal_tiling: Bool
};

pub fn tile_dimension_new(dim_idx: Int, size_val: Int) -> TileDimension {
    return TileDimension {
        dim_index: dim_idx,
        tile_size: size_val,
        is_wavefront: false,
        skew_factor: 0
    };
}

pub fn polyhedral_tile_plan_new(depth: Int, levels: Int) -> PolyhedralTilePlan {
    let dims_list: List[TileDimension] = list_new();
    return PolyhedralTilePlan {
        loop_nest_depth: depth,
        tile_levels: levels,
        tile_dims: dims_list,
        num_tiled_loops: 0,
        is_legal_tiling: true
    };
}

pub fn tile_plan_add_dimension(mut plan: PolyhedralTilePlan, dim: TileDimension) -> PolyhedralTilePlan {
    let mut d_list: List[TileDimension] = (plan).tile_dims;
    d_list = list_push(d_list, dim);
    plan.tile_dims = d_list;
    plan.num_tiled_loops = (plan).num_tiled_loops + 1;
    return plan;
}

pub fn tile_compute_num_tiles(total_iterations: Int, tile_sz: Int) -> Int {
    if tile_sz <= 0 {
        return 1;
    }
    let full_tiles: Int = total_iterations / tile_sz;
    if (total_iterations % tile_sz) != 0 {
        return full_tiles + 1;
    }
    return full_tiles;
}

pub fn tile_get_point_lower_bound(tile_coord: Int, tile_sz: Int) -> Int {
    return tile_coord * tile_sz;
}

pub fn tile_get_point_upper_bound(tile_coord: Int, tile_sz: Int, max_iter: Int) -> Int {
    let candidate_ub: Int = ((tile_coord + 1) * tile_sz) - 1;
    if candidate_ub < max_iter {
        return candidate_ub;
    }
    return max_iter - 1;
}
