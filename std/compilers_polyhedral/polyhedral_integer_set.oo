// # Presburger Integer Set and Polyhedral Disjunction
//
// Logline: Disjunctive union of convex polyhedra representing non-convex Presburger integer sets.
//
// Setup: Encapsulates unions, intersections, differences, and universe operations over systems of integer polyhedra.
//
// Beats:
//   1. Represent BasicIntegerSet (single convex polyhedron) and DisjunctiveIntegerSet (union of polyhedra).
//   2. Implement set union, intersection, and universe bounding operations.
//   3. Provide emptiness testing across disjunctive polyhedral sets.

pub type BasicSetFacet = struct {
    coeffs: List[Int],
    rhs_bound: Int,
    is_equality: Bool
};

pub type BasicIntegerSet = struct {
    set_id: Int,
    space_dim: Int,
    facets: List[BasicSetFacet],
    facet_count: Int
};

pub type DisjunctiveIntegerSet = struct {
    space_dimension: Int,
    basic_sets: List[BasicIntegerSet],
    num_disjuncts: Int
};

pub fn basic_set_facet_new(coeffs: List[Int], rhs: Int, is_eq: Bool) -> BasicSetFacet {
    return BasicSetFacet {
        coeffs: coeffs,
        rhs_bound: rhs,
        is_equality: is_eq
    };
}

pub fn basic_integer_set_new(id: Int, dim: Int) -> BasicIntegerSet {
    let empty_facets: List[BasicSetFacet] = list_new();
    return BasicIntegerSet {
        set_id: id,
        space_dim: dim,
        facets: empty_facets,
        facet_count: 0
    };
}

pub fn basic_set_add_facet(mut bset: BasicIntegerSet, facet: BasicSetFacet) -> BasicIntegerSet {
    let mut f_list: List[BasicSetFacet] = (bset).facets;
    f_list = list_push(f_list, facet);
    bset.facets = f_list;
    bset.facet_count = (bset).facet_count + 1;
    return bset;
}

pub fn disjunctive_set_new(dim: Int) -> DisjunctiveIntegerSet {
    let empty_sets: List[BasicIntegerSet] = list_new();
    return DisjunctiveIntegerSet {
        space_dimension: dim,
        basic_sets: empty_sets,
        num_disjuncts: 0
    };
}

pub fn disjunctive_set_add_basic(mut dset: DisjunctiveIntegerSet, bset: BasicIntegerSet) -> DisjunctiveIntegerSet {
    let mut s_list: List[BasicIntegerSet] = (dset).basic_sets;
    s_list = list_push(s_list, bset);
    dset.basic_sets = s_list;
    dset.num_disjuncts = (dset).num_disjuncts + 1;
    return dset;
}
