// # Polyhedral Loop Fusion and Fission Legality Heuristic
//
// Logline: Evaluates loop fusion and fission opportunities by analyzing inter-statement dependence distances.
//
// Setup: Determines whether distinct loops can share an iteration space without introducing backwards dependence cycles.
//
// Beats:
//   1. Represent LoopFusionCandidate pairing two loop nests.
//   2. Verify fusion legality by checking that fused dependencies have non-negative direction components.
//   3. Compute data reuse locality gain achieved by loop fusion.

pub type LoopFusionCandidate = struct {
    candidate_id: Int,
    loop_a_id: Int,
    loop_b_id: Int,
    shared_nesting_depth: Int,
    locality_benefit_score: Int,
    is_legal: Bool
};

pub type PolyhedralFusionEngine = struct {
    candidates: List[LoopFusionCandidate],
    num_candidates: Int,
    max_fusion_depth: Int
};

pub fn loop_fusion_candidate_new(id: Int, a: Int, b: Int, depth: Int) -> LoopFusionCandidate {
    return LoopFusionCandidate {
        candidate_id: id,
        loop_a_id: a,
        loop_b_id: b,
        shared_nesting_depth: depth,
        locality_benefit_score: 0,
        is_legal: true
    };
}

pub fn polyhedral_fusion_engine_new(max_depth: Int) -> PolyhedralFusionEngine {
    let empty_cand: List[LoopFusionCandidate] = list_new();
    return PolyhedralFusionEngine {
        candidates: empty_cand,
        num_candidates: 0,
        max_fusion_depth: max_depth
    };
}

pub fn fusion_engine_add_candidate(mut engine: PolyhedralFusionEngine, cand: LoopFusionCandidate) -> PolyhedralFusionEngine {
    let mut c_list: List[LoopFusionCandidate] = (engine).candidates;
    c_list = list_push(c_list, cand);
    engine.candidates = c_list;
    engine.num_candidates = (engine).num_candidates + 1;
    return engine;
}

pub fn evaluate_fusion_legality(dep_distance_after_fusion: Int) -> Bool {
    // If fused distance is negative, it violates RAW causality
    return dep_distance_after_fusion >= 0;
}

pub fn calculate_fusion_locality_gain(shared_arrays_count: Int, trip_count: Int) -> Int {
    return shared_arrays_count * trip_count;
}
