// # Hermite Normal Form (HNF) Matrix Decomposition
//
// Logline: Lower-triangular 2x2 HNF basis and lattice determinant.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int.

type HnfMatrix2x2 = struct {
    h00: Int,
    h01: Int,
    h10: Int,
    h11: Int,
    is_valid_basis: Int
};

pub fn hnf_matrix_2x2_new(h00: Int, h10: Int, h11: Int) -> HnfMatrix2x2 {
    let mut valid: Int = 0;
    if h00 > 0 {
        if h11 > 0 {
            if h10 >= 0 {
                if h10 < h11 {
                    valid = 1;
                }
            }
        }
    }
    return HnfMatrix2x2 {
        h00: h00,
        h01: 0,
        h10: h10,
        h11: h11,
        is_valid_basis: valid
    };
}

pub fn hnf_lattice_determinant(hnf: HnfMatrix2x2) -> Int {
    return hnf.h00 * hnf.h11;
}

pub fn hnf_is_canonical_grid(hnf: HnfMatrix2x2) -> Int {
    if hnf.h00 == 1 {
        if hnf.h11 == 1 {
            if hnf.h10 == 0 {
                return 1;
            }
        }
    }
    return 0;
}
