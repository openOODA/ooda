// # Wavefront Diamond Tiling for Time-Iterative Stencil Kernels
//
// Logline: Wavefront = 2*t + s; concurrent tiles share a wavefront level.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; tile_indices flattened to t0..t3; Bool to Int.

type DiamondTileConfig = struct {
    tile_id: Int,
    time_depth: Int,
    space_width: Int,
    stencil_radius: Int,
    wavefront_slope: Int
};

type DiamondWavefrontLevel = struct {
    level_id: Int,
    concurrent_n: Int,
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int
};

pub fn diamond_tile_config_new(id: Int, t_depth: Int, s_width: Int, radius: Int) -> DiamondTileConfig {
    return DiamondTileConfig {
        tile_id: id,
        time_depth: t_depth,
        space_width: s_width,
        stencil_radius: radius,
        wavefront_slope: radius
    };
}

pub fn diamond_wavefront_level_new(lvl: Int) -> DiamondWavefrontLevel {
    return DiamondWavefrontLevel {
        level_id: lvl,
        concurrent_n: 0,
        t0: 0,
        t1: 0,
        t2: 0,
        t3: 0
    };
}

pub fn diamond_level_add_tile(lvl: DiamondWavefrontLevel, tile_idx: Int) -> DiamondWavefrontLevel {
    let n: Int = lvl.concurrent_n;
    if n <= 0 {
        return DiamondWavefrontLevel {
            level_id: lvl.level_id,
            concurrent_n: 1,
            t0: tile_idx,
            t1: 0,
            t2: 0,
            t3: 0
        };
    }
    if n == 1 {
        return DiamondWavefrontLevel {
            level_id: lvl.level_id,
            concurrent_n: 2,
            t0: lvl.t0,
            t1: tile_idx,
            t2: 0,
            t3: 0
        };
    }
    if n == 2 {
        return DiamondWavefrontLevel {
            level_id: lvl.level_id,
            concurrent_n: 3,
            t0: lvl.t0,
            t1: lvl.t1,
            t2: tile_idx,
            t3: 0
        };
    }
    return DiamondWavefrontLevel {
        level_id: lvl.level_id,
        concurrent_n: 4,
        t0: lvl.t0,
        t1: lvl.t1,
        t2: lvl.t2,
        t3: tile_idx
    };
}

pub fn diamond_compute_tile_wavefront(tile_time_coord: Int, tile_space_coord: Int) -> Int {
    return (2 * tile_time_coord) + tile_space_coord;
}

pub fn diamond_is_tile_concurrent(wavefront_a: Int, wavefront_b: Int) -> Int {
    if wavefront_a == wavefront_b {
        return 1;
    }
    return 0;
}

pub fn diamond_concurrent_n(lvl: DiamondWavefrontLevel) -> Int {
    return lvl.concurrent_n;
}

pub fn diamond_wavefront_slope(cfg: DiamondTileConfig) -> Int {
    return cfg.wavefront_slope;
}
