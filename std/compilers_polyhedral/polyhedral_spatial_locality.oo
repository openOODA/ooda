// # Spatial Stride Minimization and Cache Line Alignment
//
// Logline: Unit-stride cache-line waste for innermost array accesses.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; dim_strides flattened to s0..s2; Bool to Int.

type ArrayMemoryStride = struct {
    array_id: Int,
    innermost_stride_bytes: Int,
    is_unit_stride: Int,
    s0: Int,
    s1: Int,
    s2: Int
};

pub fn array_memory_stride_new(id: Int, innermost_stride: Int) -> ArrayMemoryStride {
    let mut is_unit: Int = 0;
    if innermost_stride == 4 {
        is_unit = 1;
    }
    if innermost_stride == 8 {
        is_unit = 1;
    }
    return ArrayMemoryStride {
        array_id: id,
        innermost_stride_bytes: innermost_stride,
        is_unit_stride: is_unit,
        s0: innermost_stride,
        s1: 0,
        s2: 0
    };
}

pub fn spatial_cache_line_waste_percent(stride_bytes: Int, cache_line_bytes: Int) -> Int {
    if stride_bytes <= 0 {
        return 0;
    }
    if cache_line_bytes <= 0 {
        return 0;
    }
    if stride_bytes >= cache_line_bytes {
        return 87;
    }
    let elements_per_line: Int = cache_line_bytes / stride_bytes;
    let used_bytes: Int = elements_per_line * 8;
    let wasted: Int = cache_line_bytes - used_bytes;
    return (wasted * 100) / cache_line_bytes;
}

pub fn spatial_stride_bytes(s: ArrayMemoryStride) -> Int {
    return s.innermost_stride_bytes;
}

pub fn spatial_is_unit(s: ArrayMemoryStride) -> Int {
    return s.is_unit_stride;
}
