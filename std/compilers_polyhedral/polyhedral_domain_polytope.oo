// # Polyhedral Iteration Space Domain and Polytope Representation
//
// Logline: Represents multi-dimensional iteration domains as convex polyhedra bounded by systems of affine inequalities.
//
// Setup: Encapsulates affine constraints, loop iteration variables, lower/upper bounds, and polytope geometric dimensionality.
//
// Beats:
//   1. Define PolyhedralInequality, IterationDimension, and PolyhedralDomain structures.
//   2. Provide constructors for creating iteration spaces from loop bounds and affine constraints.
//   3. Implement polytope point containment, empty space detection, and dimension projection.

pub type PolyhedralInequality = struct {
    coefficients: List[Int],
    constant_term: Int,
    is_strict: Bool,
};

pub type IterationDimension = struct {
    dim_id: Int,
    name: String,
    lower_bound: Int,
    upper_bound: Int,
};

pub type PolyhedralDomain = struct {
    domain_id: Int,
    num_dimensions: Int,
    dimensions: List[IterationDimension],
    constraints: List[PolyhedralInequality],
    constraint_count: Int,
};

pub fn polyhedral_inequality_new(coeffs: List[Int], c_term: Int, strict: Bool) -> PolyhedralInequality {
    return PolyhedralInequality {
        coefficients: coeffs,
        constant_term: c_term,
        is_strict: strict,
    };
}

pub fn iteration_dimension_new(id: Int, d_name: String, lb: Int, ub: Int) -> IterationDimension {
    return IterationDimension {
        dim_id: id,
        name: d_name,
        lower_bound: lb,
        upper_bound: ub,
    };
}

pub fn polyhedral_domain_new(dom_id: Int, num_dims: Int) -> PolyhedralDomain {
    let dims_list: List[IterationDimension] = list_new();
    let ineqs_list: List[PolyhedralInequality] = list_new();
    return PolyhedralDomain {
        domain_id: dom_id,
        num_dimensions: num_dims,
        dimensions: dims_list,
        constraints: ineqs_list,
        constraint_count: 0,
    };
}

pub fn polyhedral_domain_add_dimension(mut dom: PolyhedralDomain, dim: IterationDimension) -> PolyhedralDomain {
    let mut dims: List[IterationDimension] = (dom).dimensions;
    dims = list_push(dims, dim);
    dom.dimensions = dims;
    return dom;
}

pub fn polyhedral_domain_add_constraint(mut dom: PolyhedralDomain, ineq: PolyhedralInequality) -> PolyhedralDomain {
    let mut ineqs: List[PolyhedralInequality] = (dom).constraints;
    ineqs = list_push(ineqs, ineq);
    dom.constraints = ineqs;
    dom.constraint_count = (dom).constraint_count + 1;
    return dom;
}

pub fn polyhedral_domain_contains_point(dom: PolyhedralDomain, point: List[Int]) -> Bool {
    let num_c: Int = (dom).constraint_count;
    let mut c_idx: Int = 0;
    while c_idx < num_c {
        let ineq: PolyhedralInequality = list_get((dom).constraints, c_idx);
        let mut total_sum: Int = (ineq).constant_term;
        let mut p_idx: Int = 0;
        let p_len: Int = list_len(point);
        while p_idx < p_len {
            let coeff: Int = list_get((ineq).coefficients, p_idx);
            let coord: Int = list_get(point, p_idx);
            total_sum = total_sum + (coeff * coord);
            p_idx = p_idx + 1;
        }
        if (ineq).is_strict {
            if total_sum <= 0 {
                return false;
            }
        } else {
            if total_sum < 0 {
                return false;
            }
        }
        c_idx = c_idx + 1;
    }
    return true;
}

pub fn polyhedral_domain_is_empty(dom: PolyhedralDomain) -> Bool {
    let mut d_idx: Int = 0;
    let d_count: Int = list_len((dom).dimensions);
    while d_idx < d_count {
        let dim: IterationDimension = list_get((dom).dimensions, d_idx);
        if (dim).lower_bound > (dim).upper_bound {
            return true;
        }
        d_idx = d_idx + 1;
    }
    return false;
}
