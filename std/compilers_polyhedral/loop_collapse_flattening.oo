// # Multi-Dimensional Loop Nest Collapsing and Flattening
//
// Logline: idx = ((i * nj + j) * nk + k); coord = (idx / stride) % trip.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; String/List flattened to 3 dim slots; Bool to Int.

type CollapsedLoopNest = struct {
    nest_id: Int,
    dim_n: Int,
    total_trip_n: Int,
    perfectly_nested: Int,
    d0_trip: Int,
    d0_stride: Int,
    d1_trip: Int,
    d1_stride: Int,
    d2_trip: Int,
    d2_stride: Int
};

pub fn collapsed_loop_nest_new(id: Int) -> CollapsedLoopNest {
    return CollapsedLoopNest {
        nest_id: id,
        dim_n: 0,
        total_trip_n: 1,
        perfectly_nested: 1,
        d0_trip: 0,
        d0_stride: 0,
        d1_trip: 0,
        d1_stride: 0,
        d2_trip: 0,
        d2_stride: 0
    };
}

pub fn loop_nest_add_dim(nest: CollapsedLoopNest, trip: Int, stride: Int) -> CollapsedLoopNest {
    let n: Int = nest.dim_n;
    let tot: Int = nest.total_trip_n * trip;
    if n <= 0 {
        return CollapsedLoopNest {
            nest_id: nest.nest_id,
            dim_n: 1,
            total_trip_n: tot,
            perfectly_nested: nest.perfectly_nested,
            d0_trip: trip,
            d0_stride: stride,
            d1_trip: 0,
            d1_stride: 0,
            d2_trip: 0,
            d2_stride: 0
        };
    }
    if n == 1 {
        return CollapsedLoopNest {
            nest_id: nest.nest_id,
            dim_n: 2,
            total_trip_n: tot,
            perfectly_nested: nest.perfectly_nested,
            d0_trip: nest.d0_trip,
            d0_stride: nest.d0_stride,
            d1_trip: trip,
            d1_stride: stride,
            d2_trip: 0,
            d2_stride: 0
        };
    }
    return CollapsedLoopNest {
        nest_id: nest.nest_id,
        dim_n: 3,
        total_trip_n: tot,
        perfectly_nested: nest.perfectly_nested,
        d0_trip: nest.d0_trip,
        d0_stride: nest.d0_stride,
        d1_trip: nest.d1_trip,
        d1_stride: nest.d1_stride,
        d2_trip: trip,
        d2_stride: stride
    };
}

pub fn linearize_ijk(i: Int, nj: Int, j: Int, nk: Int, k: Int) -> Int {
    return ((i * nj + j) * nk) + k;
}

pub fn linear_index_to_coord(linear_idx: Int, dim_stride: Int, dim_trip: Int) -> Int {
    if dim_stride <= 0 {
        return 0;
    }
    if dim_trip <= 0 {
        return 0;
    }
    return (linear_idx / dim_stride) % dim_trip;
}

pub fn collapsed_total_trip(nest: CollapsedLoopNest) -> Int {
    return nest.total_trip_n;
}

pub fn collapsed_dim_n(nest: CollapsedLoopNest) -> Int {
    return nest.dim_n;
}
