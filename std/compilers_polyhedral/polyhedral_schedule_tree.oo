// # Polyhedral Schedule Tree IR Representation
//
// Logline: Tree-structured representation of polyhedral iteration schedules comprising domain, band, filter, and sequence nodes.
//
// Setup: Encapsulates hierarchical loop nest transformations using structured schedule trees rather than flat 2D matrices.
//
// Beats:
//   1. Define ScheduleNodeType enum values and ScheduleTreeNode data structure.
//   2. Provide tree building utilities for domain, band (loop dimensions), filter, and sequence branches.
//   3. Implement tree traversal, node depth calculation, and band tile insertion.

pub type ScheduleTreeNode = struct {
    node_id: Int,
    node_type: Int, // 0: Domain, 1: Band, 2: Filter, 3: Sequence, 4: Set, 5: Mark
    parent_id: Int,
    loop_depth: Int,
    is_permutable: Bool,
    coincident: List[Bool],
    child_ids: List[Int],
};

pub type ScheduleTreeContext = struct {
    root_id: Int,
    nodes: List[ScheduleTreeNode],
    node_count: Int,
};

pub fn schedule_tree_node_new(id: Int, n_type: Int, parent: Int, depth: Int) -> ScheduleTreeNode {
    let empty_children: List[Int] = list_new();
    let empty_coincident: List[Bool] = list_new();
    return ScheduleTreeNode {
        node_id: id,
        node_type: n_type,
        parent_id: parent,
        loop_depth: depth,
        is_permutable: false,
        coincident: empty_coincident,
        child_ids: empty_children,
    };
}

pub fn schedule_tree_node_add_child(mut node: ScheduleTreeNode, child_id: Int) -> ScheduleTreeNode {
    let mut c_list: List[Int] = (node).child_ids;
    c_list = list_push(c_list, child_id);
    node.child_ids = c_list;
    return node;
}

pub fn schedule_tree_context_new(root_id: Int) -> ScheduleTreeContext {
    let n_list: List[ScheduleTreeNode] = list_new();
    return ScheduleTreeContext {
        root_id: root_id,
        nodes: n_list,
        node_count: 0,
    };
}

pub fn schedule_tree_add_node(mut ctx: ScheduleTreeContext, node: ScheduleTreeNode) -> ScheduleTreeContext {
    let mut n_list: List[ScheduleTreeNode] = (ctx).nodes;
    n_list = list_push(n_list, node);
    ctx.nodes = n_list;
    ctx.node_count = (ctx).node_count + 1;
    return ctx;
}

pub fn schedule_tree_find_node(ctx: ScheduleTreeContext, target_id: Int) -> Int {
    let mut idx: Int = 0;
    while idx < (ctx).node_count {
        let node_item: ScheduleTreeNode = list_get((ctx).nodes, idx);
        if (node_item).node_id == target_id {
            return idx;
        }
        idx = idx + 1;
    }
    return -1;
}

pub fn schedule_tree_is_band(node: ScheduleTreeNode) -> Bool {
    return (node).node_type == 1;
}
