// # Polyhedral Dependence Transitive Closure
//
// Logline: k-step affine recurrence reachability for R^+.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type DependenceClosureRelation = struct {
    relation_id: Int,
    step_delta_i: Int,
    step_delta_j: Int,
    is_exact_closure: Int
};

pub fn dependence_closure_new(id: Int, di: Int, dj: Int) -> DependenceClosureRelation {
    return DependenceClosureRelation {
        relation_id: id,
        step_delta_i: di,
        step_delta_j: dj,
        is_exact_closure: 1
    };
}

pub fn closure_is_point_reachable(
    rel: DependenceClosureRelation,
    start_i: Int,
    start_j: Int,
    target_i: Int,
    target_j: Int
) -> Int {
    let diff_i: Int = target_i - start_i;
    let diff_j: Int = target_j - start_j;
    if rel.step_delta_i == 0 {
        if diff_i != 0 {
            return 0;
        }
        return 1;
    }
    if (diff_i % rel.step_delta_i) != 0 {
        return 0;
    }
    let k: Int = diff_i / rel.step_delta_i;
    if k < 0 {
        return 0;
    }
    if diff_j == (k * rel.step_delta_j) {
        return 1;
    }
    return 0;
}

pub fn closure_step_di(rel: DependenceClosureRelation) -> Int {
    return rel.step_delta_i;
}

pub fn closure_step_dj(rel: DependenceClosureRelation) -> Int {
    return rel.step_delta_j;
}
