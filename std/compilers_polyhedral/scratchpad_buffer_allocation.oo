// # Scratchpad SRAM Memory Allocation and Double-Buffering
//
// Logline: Ping-pong DMA fit: double-buffered tiles require 2x bytes.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; String flattened to name_id; Bool to Int.

type ScratchpadBuffer = struct {
    buffer_id: Int,
    name_id: Int,
    capacity_bytes: Int,
    allocated_bytes: Int,
    is_double_buffered: Int
};

type DmaTransferSchedule = struct {
    transfer_id: Int,
    src_global_offset: Int,
    dst_scratchpad_offset: Int,
    bytes_to_copy: Int,
    target_buffer_bank: Int
};

pub fn scratchpad_buffer_new(id: Int, name_id: Int, capacity: Int, double_buf: Int) -> ScratchpadBuffer {
    return ScratchpadBuffer {
        buffer_id: id,
        name_id: name_id,
        capacity_bytes: capacity,
        allocated_bytes: 0,
        is_double_buffered: double_buf
    };
}

pub fn dma_schedule_new(id: Int, src: Int, dst: Int, sz: Int, bank: Int) -> DmaTransferSchedule {
    return DmaTransferSchedule {
        transfer_id: id,
        src_global_offset: src,
        dst_scratchpad_offset: dst,
        bytes_to_copy: sz,
        target_buffer_bank: bank
    };
}

pub fn scratchpad_can_fit(buf: ScratchpadBuffer, required_bytes: Int) -> Int {
    let mut total_req: Int = required_bytes;
    if buf.is_double_buffered != 0 {
        total_req = total_req * 2;
    }
    if total_req <= buf.capacity_bytes {
        return 1;
    }
    return 0;
}

pub fn scratchpad_capacity(buf: ScratchpadBuffer) -> Int {
    return buf.capacity_bytes;
}

pub fn scratchpad_dma_bytes(s: DmaTransferSchedule) -> Int {
    return s.bytes_to_copy;
}
