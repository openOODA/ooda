// # Polyhedral Loop Peeling and Unroll-and-Jam
//
// Logline: Remainder peel + full-tile body for unroll factor.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; field-assign reconstructed.

type LoopPeelingPlan = struct {
    loop_id: Int,
    prologue_n: Int,
    main_body_start: Int,
    main_body_end: Int,
    epilogue_n: Int,
    unroll_factor: Int
};

pub fn loop_peeling_plan_new(loop_id: Int, unroll: Int) -> LoopPeelingPlan {
    return LoopPeelingPlan {
        loop_id: loop_id,
        prologue_n: 0,
        main_body_start: 0,
        main_body_end: 0,
        epilogue_n: 0,
        unroll_factor: unroll
    };
}

pub fn compute_peeled_bounds(total_iters: Int, tile_sz: Int) -> LoopPeelingPlan {
    if tile_sz <= 0 {
        return loop_peeling_plan_new(1, tile_sz);
    }
    let remainder: Int = total_iters % tile_sz;
    let full_tile_iters: Int = total_iters - remainder;
    return LoopPeelingPlan {
        loop_id: 1,
        prologue_n: 0,
        main_body_start: 0,
        main_body_end: full_tile_iters,
        epilogue_n: remainder,
        unroll_factor: tile_sz
    };
}

pub fn peeling_has_epilogue(plan: LoopPeelingPlan) -> Int {
    if plan.epilogue_n > 0 {
        return 1;
    }
    return 0;
}

pub fn peeling_full_tile_count(plan: LoopPeelingPlan) -> Int {
    if plan.unroll_factor <= 0 {
        return 0;
    }
    return (plan.main_body_end - plan.main_body_start) / plan.unroll_factor;
}
