// # Analytical Cache Memory Footprint and Working Set Estimation
//
// Logline: Exact polyhedral calculation of cache footprint and memory working sets across tiled loop executions.
//
// Setup: Projects affine array access relations over iteration tile polytopes to count distinct cache lines accessed.
//
// Beats:
//   1. Define ArrayFootprint and TileFootprintProfile structures.
//   2. Compute bounding hyper-rectangle of array indices accessed per tile.
//   3. Compare tile memory footprint against L1/L2 cache capacity thresholds.

pub type ArrayFootprint = struct {
    array_name: String,
    element_size_bytes: Int,
    dimension_extents: List[Int],
    total_elements_accessed: Int,
    total_bytes_accessed: Int
};

pub type TileFootprintProfile = struct {
    tile_id: Int,
    footprints: List[ArrayFootprint],
    total_tile_footprint_bytes: Int,
    fits_in_l1: Bool,
    fits_in_l2: Bool
};

pub fn array_footprint_new(name: String, elem_sz: Int) -> ArrayFootprint {
    let empty_extents: List[Int] = list_new();
    return ArrayFootprint {
        array_name: name,
        element_size_bytes: elem_sz,
        dimension_extents: empty_extents,
        total_elements_accessed: 0,
        total_bytes_accessed: 0
    };
}

pub fn array_footprint_add_extent(mut fp: ArrayFootprint, extent: Int) -> ArrayFootprint {
    let mut e_list: List[Int] = (fp).dimension_extents;
    e_list = list_push(e_list, extent);
    fp.dimension_extents = e_list;
    if (fp).total_elements_accessed == 0 {
        fp.total_elements_accessed = extent;
    } else {
        fp.total_elements_accessed = (fp).total_elements_accessed * extent;
    }
    fp.total_bytes_accessed = (fp).total_elements_accessed * (fp).element_size_bytes;
    return fp;
}

pub fn tile_footprint_profile_new(id: Int, l1_cap: Int, l2_cap: Int) -> TileFootprintProfile {
    let empty_fps: List[ArrayFootprint] = list_new();
    return TileFootprintProfile {
        tile_id: id,
        footprints: empty_fps,
        total_tile_footprint_bytes: 0,
        fits_in_l1: true,
        fits_in_l2: true
    };
}

pub fn tile_profile_add_array(mut prof: TileFootprintProfile, fp: ArrayFootprint, l1_cap: Int, l2_cap: Int) -> TileFootprintProfile {
    let mut f_list: List[ArrayFootprint] = (prof).footprints;
    f_list = list_push(f_list, fp);
    prof.footprints = f_list;
    prof.total_tile_footprint_bytes = (prof).total_tile_footprint_bytes + (fp).total_bytes_accessed;
    prof.fits_in_l1 = (prof).total_tile_footprint_bytes <= l1_cap;
    prof.fits_in_l2 = (prof).total_tile_footprint_bytes <= l2_cap;
    return prof;
}
