// # Polyhedral Space-Time Mapping for 2D Systolic Arrays
//
// Logline: GEMM PE(i,j) at time t = i + j + k; cycles = W + H + Nk.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type SystolicPeCoordinate = struct {
    pe_x: Int,
    pe_y: Int,
    activation_time_step: Int
};

type SystolicArrayConfig = struct {
    array_width: Int,
    array_height: Int,
    data_direction_a: Int,
    data_direction_b: Int,
    total_compute_steps: Int
};

pub fn systolic_array_config_new(w: Int, h: Int) -> SystolicArrayConfig {
    return SystolicArrayConfig {
        array_width: w,
        array_height: h,
        data_direction_a: 0,
        data_direction_b: 1,
        total_compute_steps: 0
    };
}

pub fn systolic_map_iteration_to_pe(iter_i: Int, iter_j: Int, iter_k: Int) -> SystolicPeCoordinate {
    let px: Int = iter_i;
    let py: Int = iter_j;
    let t_step: Int = iter_i + iter_j + iter_k;
    return SystolicPeCoordinate {
        pe_x: px,
        pe_y: py,
        activation_time_step: t_step
    };
}

pub fn systolic_total_cycles(cfg: SystolicArrayConfig, n_k: Int) -> Int {
    return cfg.array_width + cfg.array_height + n_k;
}

pub fn systolic_pe_time(pe: SystolicPeCoordinate) -> Int {
    return pe.activation_time_step;
}

pub fn systolic_pe_x(pe: SystolicPeCoordinate) -> Int {
    return pe.pe_x;
}
