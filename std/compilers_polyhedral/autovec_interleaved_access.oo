// # Interleaved Strided Memory Access Auto-Vectorizer
//
// Logline: Vectorizes strided array memory access patterns (RGB channels, complex numbers) via SIMD unpack/shuffle passes.
//
// Setup: Recognizes stride-2, stride-3, and stride-4 memory access groups and generates vectorized load-deinterleave sequences.
//
// Beats:
//   1. Represent InterleavedAccessGroup with stride factor, channel count, and member variable names.
//   2. Formulate SIMD shuffle mask patterns for deinterleaving consecutive memory words.
//   3. Compute vectorization overhead vs contiguous scalar load instructions.

pub type InterleavedAccessGroup = struct {
    group_id: Int,
    stride_factor: Int, // 2: complex/stereo, 3: RGB, 4: RGBA/quaternion
    num_members: Int,
    member_arrays: List[String],
    is_supported_stride: Bool
};

pub type ShuffleMaskConfig = struct {
    mask_id: Int,
    stride: Int,
    vector_bytes: Int,
    num_instructions_needed: Int
};

pub fn interleaved_group_new(id: Int, stride: Int) -> InterleavedAccessGroup {
    let empty_members: List[String] = list_new();
    let supported: Bool = stride == 2 || stride == 3 || stride == 4;
    return InterleavedAccessGroup {
        group_id: id,
        stride_factor: stride,
        num_members: 0,
        member_arrays: empty_members,
        is_supported_stride: supported
    };
}

pub fn interleaved_group_add_member(mut grp: InterleavedAccessGroup, name: String) -> InterleavedAccessGroup {
    let mut m_list: List[String] = (grp).member_arrays;
    m_list = list_push(m_list, name);
    grp.member_arrays = m_list;
    grp.num_members = (grp).num_members + 1;
    return grp;
}

pub fn compute_shuffle_overhead(stride: Int, vec_lanes: Int) -> Int {
    if stride == 2 {
        return 2; // 2 unpack instructions
    } else if stride == 3 {
        return 6; // 6 shuffle instructions
    } else if stride == 4 {
        return 4; // 4 unpack/shuffle instructions
    }
    return 10;
}
