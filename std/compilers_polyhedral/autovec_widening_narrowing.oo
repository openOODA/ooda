// # SIMD Vector Widening, Narrowing, and Type Conversion
//
// Logline: Lane widen/narrow plus saturating integer clamp limits.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; Bool flattened to Int; by-value.

type VectorConversionKind = struct {
    conv_id: Int,
    src_bits: Int,
    dst_bits: Int,
    is_signed: Int,
    is_saturating: Int
};

pub fn vector_conversion_kind_new(id: Int, src: Int, dst: Int, is_sgn: Int, is_sat: Int) -> VectorConversionKind {
    return VectorConversionKind {
        conv_id: id,
        src_bits: src,
        dst_bits: dst,
        is_signed: is_sgn,
        is_saturating: is_sat
    };
}

pub fn is_widening_conversion(conv: VectorConversionKind) -> Int {
    if conv.dst_bits > conv.src_bits {
        return 1;
    }
    return 0;
}

pub fn is_narrowing_conversion(conv: VectorConversionKind) -> Int {
    if conv.dst_bits < conv.src_bits {
        return 1;
    }
    return 0;
}

pub fn get_saturating_max_val(bits: Int, is_signed: Int) -> Int {
    if bits == 8 {
        if is_signed != 0 {
            return 127;
        }
        return 255;
    }
    if bits == 16 {
        if is_signed != 0 {
            return 32767;
        }
        return 65535;
    }
    return 2147483647;
}

pub fn get_saturating_min_val(bits: Int, is_signed: Int) -> Int {
    if is_signed == 0 {
        return 0;
    }
    if bits == 8 {
        return 0 - 128;
    }
    if bits == 16 {
        return 0 - 32768;
    }
    return 0 - 2147483647 - 1;
}

pub fn vector_conversion_src_bits(conv: VectorConversionKind) -> Int {
    return conv.src_bits;
}

pub fn vector_conversion_dst_bits(conv: VectorConversionKind) -> Int {
    return conv.dst_bits;
}
