// # Polyhedral AST Scanning and Code Generator
//
// Logline: Transforms transformed polyhedral domains and schedules into imperative nested loop ASTs (CLooG/ISL style).
//
// Setup: Generates scanning loops for polyhedra, synthesizing parameterized loop bounds and statement bodies.
//
// Beats:
//   1. Define PolyAstNode kinds: ForLoop, IfCondition, UserStatement, Block.
//   2. Build recursive abstract syntax trees representing generated loop nests.
//   3. Compute lower and upper bound loop expressions from polyhedron facet projections.

pub type PolyAstNode = struct {
    node_id: Int,
    node_kind: Int, // 0: ForLoop, 1: IfCondition, 2: UserStatement, 3: Block
    iterator_var: String,
    lower_bound_val: Int,
    upper_bound_val: Int,
    step_val: Int,
    stmt_id: Int,
    child_ids: List[Int],
};

pub type PolyAstContext = struct {
    root_node_id: Int,
    nodes: List[PolyAstNode],
    node_count: Int,
};

pub fn poly_ast_node_for(id: Int, iter_var: String, lb: Int, ub: Int, step: Int) -> PolyAstNode {
    let empty_children: List[Int] = list_new();
    return PolyAstNode {
        node_id: id,
        node_kind: 0,
        iterator_var: iter_var,
        lower_bound_val: lb,
        upper_bound_val: ub,
        step_val: step,
        stmt_id: 0,
        child_ids: empty_children,
    };
}

pub fn poly_ast_node_stmt(id: Int, stmt_id: Int) -> PolyAstNode {
    let empty_children: List[Int] = list_new();
    return PolyAstNode {
        node_id: id,
        node_kind: 2,
        iterator_var: "",
        lower_bound_val: 0,
        upper_bound_val: 0,
        step_val: 0,
        stmt_id: stmt_id,
        child_ids: empty_children,
    };
}

pub fn poly_ast_context_new(root: Int) -> PolyAstContext {
    let empty_nodes: List[PolyAstNode] = list_new();
    return PolyAstContext {
        root_node_id: root,
        nodes: empty_nodes,
        node_count: 0,
    };
}

pub fn poly_ast_add_node(mut ctx: PolyAstContext, node: PolyAstNode) -> PolyAstContext {
    let mut n_list: List[PolyAstNode] = (ctx).nodes;
    n_list = list_push(n_list, node);
    ctx.nodes = n_list;
    ctx.node_count = (ctx).node_count + 1;
    return ctx;
}

pub fn poly_ast_node_add_child(mut node: PolyAstNode, child_id: Int) -> PolyAstNode {
    let mut c_list: List[Int] = (node).child_ids;
    c_list = list_push(c_list, child_id);
    node.child_ids = c_list;
    return node;
}
