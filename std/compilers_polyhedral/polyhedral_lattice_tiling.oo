// # Non-Orthogonal Lattice Loop Tiling
//
// Logline: 2D lattice cell volume |det B| and tile-index map.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; map flattened onto last_ti/last_tj.

type LatticeTileBasis2D = struct {
    b00: Int,
    b01: Int,
    b10: Int,
    b11: Int,
    cell_volume: Int,
    last_ti: Int,
    last_tj: Int
};

pub fn lattice_tile_basis_2d_new(b00: Int, b01: Int, b10: Int, b11: Int) -> LatticeTileBasis2D {
    let raw: Int = (b00 * b11) - (b01 * b10);
    let mut vol: Int = raw;
    if raw < 0 {
        vol = 0 - raw;
    }
    return LatticeTileBasis2D {
        b00: b00,
        b01: b01,
        b10: b10,
        b11: b11,
        cell_volume: vol,
        last_ti: 0,
        last_tj: 0
    };
}

pub fn lattice_map_to_tile(basis: LatticeTileBasis2D, i: Int, j: Int) -> LatticeTileBasis2D {
    let vol: Int = basis.cell_volume;
    if vol <= 0 {
        return LatticeTileBasis2D {
            b00: basis.b00,
            b01: basis.b01,
            b10: basis.b10,
            b11: basis.b11,
            cell_volume: vol,
            last_ti: 0,
            last_tj: 0
        };
    }
    let t_i: Int = i / basis.b00;
    let t_j: Int = j / basis.b11;
    return LatticeTileBasis2D {
        b00: basis.b00,
        b01: basis.b01,
        b10: basis.b10,
        b11: basis.b11,
        cell_volume: vol,
        last_ti: t_i,
        last_tj: t_j
    };
}

pub fn lattice_cell_volume(basis: LatticeTileBasis2D) -> Int {
    return basis.cell_volume;
}

pub fn lattice_last_ti(basis: LatticeTileBasis2D) -> Int {
    return basis.last_ti;
}

pub fn lattice_last_tj(basis: LatticeTileBasis2D) -> Int {
    return basis.last_tj;
}
