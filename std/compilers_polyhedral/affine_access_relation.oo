// # Affine Array Memory Access Relations
//
// Logline: Multi-dimensional array read and write access mapping functions for polyhedral memory footprints.
//
// Setup: Maps loop iteration vectors to multi-dimensional array memory indices via affine transformation matrices.
//
// Beats:
//   1. Represent ArrayAccessRelation with base array name, access type (Read/Write), and affine index functions.
//   2. Compute memory footprints and bounding boxes for array references within polyhedral domains.
//   3. Check memory aliasing and overlap between pairs of affine access functions.

pub type AffineIndexExpr = struct {
    coeffs: List[Int],
    constant_offset: Int
};

pub type ArrayAccessRelation = struct {
    relation_id: Int,
    array_name: String,
    is_write: Bool,
    num_array_dims: Int,
    index_expressions: List[AffineIndexExpr]
};

pub fn affine_index_expr_new(coeffs: List[Int], offset: Int) -> AffineIndexExpr {
    return AffineIndexExpr {
        coeffs: coeffs,
        constant_offset: offset
    };
}

pub fn array_access_relation_new(id: Int, name: String, is_wr: Bool, dims: Int) -> ArrayAccessRelation {
    let empty_exprs: List[AffineIndexExpr] = list_new();
    return ArrayAccessRelation {
        relation_id: id,
        array_name: name,
        is_write: is_wr,
        num_array_dims: dims,
        index_expressions: empty_exprs
    };
}

pub fn array_access_add_dim_expr(mut rel: ArrayAccessRelation, expr: AffineIndexExpr) -> ArrayAccessRelation {
    let mut e_list: List[AffineIndexExpr] = (rel).index_expressions;
    e_list = list_push(e_list, expr);
    rel.index_expressions = e_list;
    return rel;
}

pub fn array_access_evaluate_index(rel: ArrayAccessRelation, dim_idx: Int, iter_point: List[Int]) -> Int {
    if dim_idx < 0 || dim_idx >= list_len((rel).index_expressions) {
        return 0;
    }
    let expr: AffineIndexExpr = list_get((rel).index_expressions, dim_idx);
    let mut total_offset: Int = (expr).constant_offset;
    let mut i: Int = 0;
    let num_c: Int = list_len((expr).coeffs);
    let num_p: Int = list_len(iter_point);
    while i < num_c && i < num_p {
        let coeff: Int = list_get((expr).coeffs, i);
        let coord: Int = list_get(iter_point, i);
        total_offset = total_offset + (coeff * coord);
        i = i + 1;
    }
    return total_offset;
}

pub fn array_access_is_unit_stride(rel: ArrayAccessRelation, dim_idx: Int, innermost_loop_idx: Int) -> Bool {
    if dim_idx < 0 || dim_idx >= list_len((rel).index_expressions) {
        return false;
    }
    let expr: AffineIndexExpr = list_get((rel).index_expressions, dim_idx);
    if innermost_loop_idx < 0 || innermost_loop_idx >= list_len((expr).coeffs) {
        return false;
    }
    let coeff: Int = list_get((expr).coeffs, innermost_loop_idx);
    return coeff == 1 || coeff == -1;
}
