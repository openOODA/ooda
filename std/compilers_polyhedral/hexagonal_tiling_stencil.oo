// # Hexagonal and Trapezoidal Stencil Tiling
//
// Logline: Advanced hexagonal and trapezoidal tiling for 1D/2D iterative time-dependent stencil computations.
//
// Setup: Partitions the time-space polytope into overlapping hexagonal or trapezoidal tiles to optimize cache reuse.
//
// Beats:
//   1. Represent HexagonalTile with base duration, bottom width, and top width.
//   2. Formulate trapezoidal tile time boundaries avoiding inter-tile communication during time steps.
//   3. Compute tile execution schedule alternating forward and backward base tiles.

pub type HexagonalTile = struct {
    tile_id: Int,
    time_steps: Int,
    bottom_spatial_width: Int,
    top_spatial_width: Int,
    is_inverted: Bool,
};

pub type HexagonalTilingSchedule = struct {
    num_time_iterations: Int,
    num_space_points: Int,
    tiles: List[HexagonalTile],
    tile_count: Int,
};

pub fn hexagonal_tile_new(id: Int, t_steps: Int, b_width: Int, t_width: Int, inverted: Bool) -> HexagonalTile {
    return HexagonalTile {
        tile_id: id,
        time_steps: t_steps,
        bottom_spatial_width: b_width,
        top_spatial_width: t_width,
        is_inverted: inverted,
    };
}

pub fn hexagonal_schedule_new(t_iters: Int, s_pts: Int) -> HexagonalTilingSchedule {
    let empty_tiles: List[HexagonalTile] = list_new();
    return HexagonalTilingSchedule {
        num_time_iterations: t_iters,
        num_space_points: s_pts,
        tiles: empty_tiles,
        tile_count: 0,
    };
}

pub fn hexagonal_schedule_add_tile(mut sched: HexagonalTilingSchedule, tile: HexagonalTile) -> HexagonalTilingSchedule {
    let mut t_list: List[HexagonalTile] = (sched).tiles;
    t_list = list_push(t_list, tile);
    sched.tiles = t_list;
    sched.tile_count = (sched).tile_count + 1;
    return sched;
}

pub fn hexagonal_tile_internal_volume(tile: HexagonalTile) -> Int {
    let avg_width: Int = ((tile).bottom_spatial_width + (tile).top_spatial_width) / 2;
    return avg_width * (tile).time_steps;
}
