// # Polyhedral Scattering Functions and Time-Space Mappings
//
// Logline: Multi-dimensional affine scattering functions mapping statement iterations into execution time and processor space.
//
// Setup: Generates interleaved (2d+1) scattering schedules capturing sequential loop ordering and parallel dimensions.
//
// Beats:
//   1. Represent ScatteringDimension (static scalar ordering vs dynamic loop coordinate).
//   2. Construct 2d+1 multidimensional affine scattering matrix for nested loop statements.
//   3. Compute lexicographic timestamp ordering between statement iteration instances.

pub type ScatteringDimension = struct {
    dim_idx: Int,
    is_static_constant: Bool,
    static_value: Int,
    loop_coeff: Int
};

pub type ScatteringFunction = struct {
    stmt_id: Int,
    total_dimensions: Int,
    dimensions: List[ScatteringDimension]
};

pub fn scattering_dimension_static(dim: Int, val: Int) -> ScatteringDimension {
    return ScatteringDimension {
        dim_idx: dim,
        is_static_constant: true,
        static_value: val,
        loop_coeff: 0
    };
}

pub fn scattering_dimension_dynamic(dim: Int, coeff: Int) -> ScatteringDimension {
    return ScatteringDimension {
        dim_idx: dim,
        is_static_constant: false,
        static_value: 0,
        loop_coeff: coeff
    };
}

pub fn scattering_function_new(stmt: Int, num_dims: Int) -> ScatteringFunction {
    let empty_dims: List[ScatteringDimension] = list_new();
    return ScatteringFunction {
        stmt_id: stmt,
        total_dimensions: num_dims,
        dimensions: empty_dims
    };
}

pub fn scattering_function_add_dim(mut scat: ScatteringFunction, dim: ScatteringDimension) -> ScatteringFunction {
    let mut d_list: List[ScatteringDimension] = (scat).dimensions;
    d_list = list_push(d_list, dim);
    scat.dimensions = d_list;
    return scat;
}

pub fn scattering_compute_timestamp(scat: ScatteringFunction, loop_iters: List[Int]) -> List[Int] {
    let mut ts_list: List[Int] = list_new();
    let mut d_idx: Int = 0;
    let mut l_idx: Int = 0;
    let count: Int = list_len((scat).dimensions);
    while d_idx < count {
        let dim_item: ScatteringDimension = list_get((scat).dimensions, d_idx);
        if (dim_item).is_static_constant {
            ts_list = list_push(ts_list, (dim_item).static_value);
        } else {
            let mut iter_val: Int = 0;
            if l_idx < list_len(loop_iters) {
                iter_val = list_get(loop_iters, l_idx);
                l_idx = l_idx + 1;
            }
            ts_list = list_push(ts_list, (dim_item).loop_coeff * iter_val);
        }
        d_idx = d_idx + 1;
    }
    return ts_list;
}
