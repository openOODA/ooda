// # Fast Mathematical Intrinsics and Approximations
//
// Logline: Pure standard library fast trigonometric, logarithm, exponential, and numerical approximation intrinsics.
//
// Setup: Zero external C library dependency math intrinsics using polynomial expansions and Newton-Raphson iterations.
//
// Beats:
//   1. Mathematical constants and fundamental clamp/abs utilities.
//   2. Fast trigonometric functions: sin, cos, tan, atan, and atan2 via minimax Maclaurin series.
//   3. Fast exponential and logarithm functions: exp, ln, log2, log10, and pow via range reduction.
//   4. Fast square root and inverse square root via Newton-Raphson iteration.

// Mathematical constant Pi (3.141592653589793).
pub fn math_pi() -> Float {
    return 3.141592653589793;
}

// Mathematical constant 2*Pi.
pub fn math_two_pi() -> Float {
    return 6.283185307179586;
}

// Mathematical constant Pi/2.
pub fn math_half_pi() -> Float {
    return 1.5707963267948966;
}

// Mathematical constant e (Euler's number).
pub fn math_e() -> Float {
    return 2.718281828459045;
}

// Mathematical constant natural log of 2 (ln 2).
pub fn math_ln2() -> Float {
    return 0.6931471805599453;
}

// Absolute value of a Float.
pub fn fast_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

// Clamp a Float within [min_v, max_v].
pub fn fast_clamp(val: Float, min_v: Float, max_v: Float) -> Float {
    if val < min_v { return min_v; }
    if val > max_v { return max_v; }
    return val;
}

// Internal integer to float helper for scaling.
fn math_int_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    let mut is_neg: Bool = false;
    if count < 0 { is_neg = true; count = 0 - count; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if is_neg { return 0.0 - f; }
    return f;
}

// Fast sine approximation using range reduction and Horner-form Maclaurin polynomial.
pub fn fast_sin(x: Float) -> Float {
    let pi_v: Float = math_pi();
    let two_pi_v: Float = math_two_pi();
    let mut rad: Float = x;
    while rad > pi_v { rad = rad - two_pi_v; }
    while rad < (0.0 - pi_v) { rad = rad + two_pi_v; }
    let x2: Float = rad * rad;
    let poly: Float = 1.0 - (x2 * (0.16666666666666666 - (x2 * (0.008333333333333333 - (x2 * (0.0001984126984126984 - (x2 * 0.000002755731922398589)))))));
    return rad * poly;
}

// Fast cosine approximation.
pub fn fast_cos(x: Float) -> Float {
    return fast_sin(x + math_half_pi());
}

// Fast tangent approximation.
pub fn fast_tan(x: Float) -> Float {
    let c: Float = fast_cos(x);
    if fast_abs(c) < 0.0000001 { return 0.0; }
    return fast_sin(x) / c;
}

// Unit polynomial for arctangent in |z| <= 1.0 (Abramowitz & Stegun minimax).
fn fast_atan_unit(z: Float) -> Float {
    let z2: Float = z * z;
    let poly: Float = 0.999866 - (z2 * (0.3302995 - (z2 * (0.180141 - (z2 * (0.085133 - (z2 * 0.0208351)))))));
    return z * poly;
}

// Fast arctangent approximation.
pub fn fast_atan(x: Float) -> Float {
    let ax: Float = fast_abs(x);
    if ax <= 1.0 {
        let res: Float = fast_atan_unit(ax);
        if x < 0.0 { return 0.0 - res; }
        return res;
    }
    let res: Float = math_half_pi() - fast_atan_unit(1.0 / ax);
    if x < 0.0 { return 0.0 - res; }
    return res;
}

// Fast 2-argument arctangent.
pub fn fast_atan2(y: Float, x: Float) -> Float {
    let pi_v: Float = math_pi();
    let half_pi_v: Float = math_half_pi();
    if x > 0.0 { return fast_atan(y / x); }
    if x < 0.0 {
        if y >= 0.0 { return fast_atan(y / x) + pi_v; }
        return fast_atan(y / x) - pi_v;
    }
    if y > 0.0 { return half_pi_v; }
    if y < 0.0 { return 0.0 - half_pi_v; }
    return 0.0;
}

// Fast exponential function e^x.
pub fn fast_exp(x: Float) -> Float {
    if x < (0.0 - 40.0) { return 0.0; }
    if x > 40.0 { return 235385266837019985408.0; }
    let ln2_v: Float = math_ln2();
    let half_ln2: Float = ln2_v * 0.5;
    let mut r: Float = x;
    let mut k: Int = 0;
    while r > half_ln2 { r = r - ln2_v; k = k + 1; }
    while r < (0.0 - half_ln2) { r = r + ln2_v; k = k - 1; }
    let er: Float = 1.0 + (r * (1.0 + (r * (0.5 + (r * (0.16666666666666666 + (r * (0.041666666666666664 + (r * (0.008333333333333333 + (r * 0.001388888888888889)))))))))));
    let mut scale: Float = 1.0;
    if k >= 0 {
        let mut i: Int = 0;
        while i < k { scale = scale * 2.0; i = i + 1; }
    } else {
        let mut i: Int = 0;
        let k_abs: Int = 0 - k;
        while i < k_abs { scale = scale * 0.5; i = i + 1; }
    }
    return er * scale;
}

// Fast natural logarithm ln(x).
pub fn fast_ln(x: Float) -> Float {
    if x <= 0.0 { return 0.0 - 999999.0; }
    let mut m: Float = x;
    let mut k: Int = 0;
    while m > 1.414213562373095 { m = m * 0.5; k = k + 1; }
    while m < 0.7071067811865475 { m = m * 2.0; k = k - 1; }
    let u: Float = (m - 1.0) / (m + 1.0);
    let u2: Float = u * u;
    let poly: Float = 1.0 + (u2 * (0.3333333333333333 + (u2 * (0.2 + (u2 * (0.14285714285714285 + (u2 * 0.1111111111111111)))))));
    let ln_m: Float = 2.0 * u * poly;
    return ln_m + (math_ln2() * math_int_to_f(k));
}

// Fast base-2 logarithm log2(x).
pub fn fast_log2(x: Float) -> Float {
    return fast_ln(x) / math_ln2();
}

// Fast base-10 logarithm log10(x).
pub fn fast_log10(x: Float) -> Float {
    return fast_ln(x) / 2.302585092994046;
}

// Fast power function base^expn.
pub fn fast_pow(base: Float, expn: Float) -> Float {
    if base <= 0.0 {
        if base == 0.0 { return 0.0; }
        return 0.0;
    }
    if expn == 0.0 { return 1.0; }
    return fast_exp(expn * fast_ln(base));
}

// Fast square root using Newton-Raphson quadratic iterations.
pub fn fast_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut y: Float = if x >= 1.0 { (x * 0.5) + 0.5 } else { 0.5 + (x * 0.5) };
    let mut i: Int = 0;
    while i < 8 {
        y = 0.5 * (y + (x / y));
        i = i + 1;
    }
    return y;
}

// Fast reciprocal square root 1/sqrt(x).
pub fn fast_inv_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let s: Float = fast_sqrt(x);
    if s == 0.0 { return 0.0; }
    return 1.0 / s;
}
