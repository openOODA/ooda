// # Pure Capability Token Validation and Sandboxing Helpers
//
// Logline: Pure standard library capability token validation, permission bitmask arithmetic, and sandboxing checks.
//
// Setup: Pure permission model without OS/ASLR dependencies for capability-based isolation.
//
// Beats:
//   1. CapToken structure and domain ID / permission bitmask constants.
//   2. Token instantiation, validation, restriction, and revocation.
//   3. Permission bitmask combination, query, and containment checking.
//   4. Sandboxing operation guard and human-readable domain/permission names.

// Capability Token record.
type CapToken = struct {
    domain_id: Int,
    perms: Int,
    nonce: Int,
    is_active: Bool,
};

// Capability Domain ID Constants.
pub fn cap_domain_fs() -> Int { return 1; }
pub fn cap_domain_sys() -> Int { return 2; }
pub fn cap_domain_env() -> Int { return 3; }
pub fn cap_domain_net() -> Int { return 4; }
pub fn cap_domain_sign() -> Int { return 5; }
pub fn cap_domain_process() -> Int { return 6; }
pub fn cap_domain_sync() -> Int { return 7; }
pub fn cap_domain_mem() -> Int { return 8; }
pub fn cap_domain_http() -> Int { return 9; }
pub fn cap_domain_tcp() -> Int { return 10; }
pub fn cap_domain_udp() -> Int { return 11; }
pub fn cap_domain_bind() -> Int { return 12; }
pub fn cap_domain_audio() -> Int { return 13; }
pub fn cap_domain_camera() -> Int { return 14; }
pub fn cap_domain_usb() -> Int { return 15; }
pub fn cap_domain_hid() -> Int { return 16; }
pub fn cap_domain_window() -> Int { return 17; }
pub fn cap_domain_frame() -> Int { return 18; }
pub fn cap_domain_fsread() -> Int { return 19; }
pub fn cap_domain_fswrite() -> Int { return 20; }
pub fn cap_domain_arena() -> Int { return 21; }

// Capability Permission Bitflags.
pub fn cap_perm_read() -> Int { return 1; }
pub fn cap_perm_write() -> Int { return 2; }
pub fn cap_perm_exec() -> Int { return 4; }
pub fn cap_perm_admin() -> Int { return 8; }
pub fn cap_perm_connect() -> Int { return 16; }
pub fn cap_perm_bind() -> Int { return 32; }
pub fn cap_perm_all() -> Int { return 63; }

// Create a new active capability token.
pub fn cap_token_new(domain: Int, perms: Int, nonce: Int) -> CapToken {
    return CapToken {
        domain_id: domain,
        perms: perms,
        nonce: nonce,
        is_active: true,
    };
}

// Create an invalid / inactive token.
pub fn cap_token_invalid() -> CapToken {
    return CapToken {
        domain_id: 0,
        perms: 0,
        nonce: 0,
        is_active: false,
    };
}

// Check if a capability token is active and has a valid domain.
pub fn cap_token_is_valid(token: CapToken) -> Bool {
    if !(token).is_active { return false; }
    if (token).domain_id <= 0 { return false; }
    if (token).perms <= 0 { return false; }
    return true;
}

// Check if token matches a required domain.
pub fn cap_token_has_domain(token: CapToken, req_domain: Int) -> Bool {
    if !cap_token_is_valid(token) { return false; }
    let dom: Int = (token).domain_id;
    if dom == req_domain { return true; }
    if req_domain == cap_domain_fsread() && dom == cap_domain_fs() { return true; }
    if req_domain == cap_domain_fswrite() && dom == cap_domain_fs() { return true; }
    if req_domain == cap_domain_http() && dom == cap_domain_net() { return true; }
    if req_domain == cap_domain_tcp() && dom == cap_domain_net() { return true; }
    if req_domain == cap_domain_udp() && dom == cap_domain_net() { return true; }
    if req_domain == cap_domain_bind() && dom == cap_domain_net() { return true; }
    if req_domain == cap_domain_process() && dom == cap_domain_sys() { return true; }
    return false;
}

// Check if bitmask has all bits of flag set.
pub fn cap_mask_has(mask: Int, flag: Int) -> Bool {
    if flag == 0 { return true; }
    return (mask & flag) == flag;
}

// Combine two permission masks (bitwise OR).
pub fn cap_mask_combine(mask_a: Int, mask_b: Int) -> Int {
    return mask_a | mask_b;
}

// Remove permission flag from mask.
pub fn cap_mask_remove(mask: Int, flag: Int) -> Int {
    if (mask & flag) == flag {
        return mask - flag;
    }
    return mask;
}

// Check if token has the required permissions.
pub fn cap_token_has_perm(token: CapToken, req_perm: Int) -> Bool {
    if !cap_token_is_valid(token) { return false; }
    return cap_mask_has((token).perms, req_perm);
}

// Verify that a token is valid, matches domain, and has required permissions.
pub fn cap_token_check(token: CapToken, req_domain: Int, req_perm: Int) -> Bool {
    if !cap_token_has_domain(token, req_domain) { return false; }
    return cap_token_has_perm(token, req_perm);
}

// Create a restricted descendant token with attenuated permissions.
pub fn cap_token_restrict(token: CapToken, allowed_perms: Int) -> CapToken {
    if !cap_token_is_valid(token) { return cap_token_invalid(); }
    let new_perms: Int = (token).perms & allowed_perms;
    return CapToken {
        domain_id: (token).domain_id,
        perms: new_perms,
        nonce: (token).nonce,
        is_active: new_perms > 0,
    };
}

// Revoke a token by setting it inactive.
pub fn cap_token_revoke(token: CapToken) -> CapToken {
    return CapToken {
        domain_id: (token).domain_id,
        perms: 0,
        nonce: (token).nonce,
        is_active: false,
    };
}

// Get the human-readable name of a domain ID.
pub fn cap_domain_name(domain: Int) -> String {
    if domain == 1 { return "fs"; }
    if domain == 2 { return "sys"; }
    if domain == 3 { return "env"; }
    if domain == 4 { return "net"; }
    if domain == 5 { return "sign"; }
    if domain == 6 { return "process"; }
    if domain == 7 { return "sync"; }
    if domain == 8 { return "mem"; }
    if domain == 9 { return "http"; }
    if domain == 10 { return "tcp"; }
    if domain == 11 { return "udp"; }
    if domain == 12 { return "bind"; }
    if domain == 13 { return "audio"; }
    if domain == 14 { return "camera"; }
    if domain == 15 { return "usb"; }
    if domain == 16 { return "hid"; }
    if domain == 17 { return "window"; }
    if domain == 18 { return "frame"; }
    if domain == 19 { return "fsread"; }
    if domain == 20 { return "fswrite"; }
    if domain == 21 { return "arena"; }
    return "unknown";
}

// Get the human-readable name of a single permission bit.
pub fn cap_perm_name(perm: Int) -> String {
    if perm == 1 { return "read"; }
    if perm == 2 { return "write"; }
    if perm == 4 { return "exec"; }
    if perm == 8 { return "admin"; }
    if perm == 16 { return "connect"; }
    if perm == 32 { return "bind"; }
    return "custom";
}

// Verify a sandbox operation request against a capability token.
pub fn cap_sandbox_verify(token: CapToken, op_name: String, req_domain: Int, req_perm: Int) -> Bool {
    if !cap_token_is_valid(token) { return false; }
    if op_name == "" { return false; }
    return cap_token_check(token, req_domain, req_perm);
}
