// # String Formatting and Numeric Conversion Runtime Helpers
//
// Logline: Pure standard library string formatting, integer/float conversions, padding, splitting, and trimming.
//
// Setup: Pure string manipulation and formatting operations with zero C runtime dependencies.
//
// Beats:
//   1. Integer conversions: decimal, hexadecimal, binary, and width padding.
//   2. Float formatting: fixed precision decimal formatting with digit extraction.
//   3. String operations: trimming, substring searching, prefix/suffix tests, repetition, and delimiter splitting.

// Convert an integer to decimal String representation.
pub fn int_to_str(val: Int) -> String {
    return val.to_string();
}

// Convert an integer to a hexadecimal String.
pub fn int_to_hex(val: Int, uppercase: Bool) -> String {
    if val == 0 { return "0"; }
    let mut n: Int = val;
    let mut is_neg: Bool = false;
    if n < 0 { is_neg = true; n = 0 - n; }
    let hex_chars: String = if uppercase { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let mut result: String = "";
    while n > 0 {
        let rem: Int = n % 16;
        result = char_at(hex_chars, rem) + result;
        n = n / 16;
    }
    if is_neg { return "-" + result; }
    return result;
}

// Convert an integer to a binary String representation.
pub fn int_to_bin(val: Int) -> String {
    if val == 0 { return "0"; }
    let mut n: Int = val;
    let mut is_neg: Bool = false;
    if n < 0 { is_neg = true; n = 0 - n; }
    let mut result: String = "";
    while n > 0 {
        let digit: String = if (n % 2) == 1 { "1" } else { "0" };
        result = digit + result;
        n = n / 2;
    }
    if is_neg { return "-" + result; }
    return result;
}

// Pad a string on the left up to width using pad_char.
pub fn pad_left(s: String, width: Int, pad_char: String) -> String {
    let cur_len: Int = chars_len(s);
    if cur_len >= width { return s; }
    let diff: Int = width - cur_len;
    let mut padding: String = "";
    let mut i: Int = 0;
    while i < diff {
        padding = padding + pad_char;
        i = i + 1;
    }
    return padding + s;
}

// Pad a string on the right up to width using pad_char.
pub fn pad_right(s: String, width: Int, pad_char: String) -> String {
    let cur_len: Int = chars_len(s);
    if cur_len >= width { return s; }
    let diff: Int = width - cur_len;
    let mut padding: String = "";
    let mut i: Int = 0;
    while i < diff {
        padding = padding + pad_char;
        i = i + 1;
    }
    return s + padding;
}

// Format an integer with a minimum width, padding with zeros or spaces.
pub fn format_int(val: Int, width: Int, pad_zero: Bool) -> String {
    let pad_c: String = if pad_zero { "0" } else { " " };
    return pad_left(val.to_string(), width, pad_c);
}

// Format a Float value with given decimal precision.
pub fn format_float(val: Float, precision: Int) -> String {
    let mut is_neg: Bool = false;
    let mut abs_v: Float = val;
    if abs_v < 0.0 { is_neg = true; abs_v = 0.0 - abs_v; }
    let mut int_acc: Int = 0;
    let mut rem_f: Float = abs_v;
    while rem_f >= 1000000.0 { int_acc = int_acc + 1000000; rem_f = rem_f - 1000000.0; }
    while rem_f >= 1000.0 { int_acc = int_acc + 1000; rem_f = rem_f - 1000.0; }
    while rem_f >= 1.0 { int_acc = int_acc + 1; rem_f = rem_f - 1.0; }
    let int_str: String = int_acc.to_string();
    if precision <= 0 {
        if is_neg { return "-" + int_str; }
        return int_str;
    }
    let mut frac_str: String = "";
    let mut prec_i: Int = 0;
    let mut cur_frac: Float = rem_f;
    while prec_i < precision {
        cur_frac = cur_frac * 10.0;
        let mut digit_val: Int = 0;
        while cur_frac >= 1.0 { digit_val = digit_val + 1; cur_frac = cur_frac - 1.0; }
        frac_str = frac_str + digit_val.to_string();
        prec_i = prec_i + 1;
    }
    let combined: String = int_str + "." + frac_str;
    if is_neg { return "-" + combined; }
    return combined;
}

// Trim leading whitespace from string.
pub fn rt_str_trim_left(s: String) -> String {
    let n: Int = chars_len(s);
    let mut start: Int = 0;
    while start < n {
        let ch: String = char_at(s, start);
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break; }
        start = start + 1;
    }
    if start >= n { return ""; }
    return str_slice(s, start, n);
}

// Trim trailing whitespace from string.
pub fn rt_str_trim_right(s: String) -> String {
    let n: Int = chars_len(s);
    let mut end: Int = n;
    while end > 0 {
        let ch: String = char_at(s, end - 1);
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break; }
        end = end - 1;
    }
    if end <= 0 { return ""; }
    return str_slice(s, 0, end);
}

// Trim leading and trailing whitespace.
pub fn rt_str_trim(s: String) -> String {
    return rt_str_trim_right(rt_str_trim_left(s));
}

// Check if string starts with a prefix.
pub fn rt_str_starts_with(s: String, pre: String) -> Bool {
    let n_s: Int = chars_len(s);
    let n_pre: Int = chars_len(pre);
    if n_pre == 0 { return true; }
    if n_s < n_pre { return false; }
    return str_slice(s, 0, n_pre) == pre;
}

// Check if string ends with a suffix.
pub fn rt_str_ends_with(s: String, suf: String) -> Bool {
    let n_s: Int = chars_len(s);
    let n_suf: Int = chars_len(suf);
    if n_suf == 0 { return true; }
    if n_s < n_suf { return false; }
    return str_slice(s, n_s - n_suf, n_s) == suf;
}

// Find index of substring in string (-1 if not found).
pub fn rt_str_index_of(s: String, sub: String) -> Int {
    let n_s: Int = chars_len(s);
    let n_sub: Int = chars_len(sub);
    if n_sub == 0 { return 0; }
    if n_s < n_sub { return 0 - 1; }
    let mut i: Int = 0;
    let limit: Int = n_s - n_sub;
    while i <= limit {
        if str_slice(s, i, i + n_sub) == sub { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Repeat a string count times.
pub fn rt_str_repeat(s: String, count: Int) -> String {
    if count <= 0 { return ""; }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < count { out = out + s; i = i + 1; }
    return out;
}

// Split a string by a delimiter into a list of strings.
pub fn rt_str_split(s: String, delim: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n_s: Int = chars_len(s);
    let n_delim: Int = chars_len(delim);
    if n_s == 0 { return out; }
    if n_delim == 0 { return list_push(out, s); }
    let mut start: Int = 0;
    let mut i: Int = 0;
    let limit: Int = n_s - n_delim;
    while i <= limit {
        if str_slice(s, i, i + n_delim) == delim {
            out = list_push(out, str_slice(s, start, i));
            i = i + n_delim;
            start = i;
        } else {
            i = i + 1;
        }
    }
    return list_push(out, str_slice(s, start, n_s));
}
