// # Token-Efficient Tabular JSON Compressor
//
// Logline: Converts repetitive JSON object arrays into dense tabular and CSV formats to reduce prompt token footprint.
//
// Setup: Pure tabular transformation engine compressing structured records for LLM context windows.
//
// Beats:
//   1. Define TabularDataset and JsonCompactResult structures.
//   2. Extract shared column keys into a single header descriptor.
//   3. Compress array-of-objects data into dense comma-separated value matrices.

pub type TabularDataset = struct {
    headers: List[String],
    rows: List[List[String]],
    total_records: Int
};

pub type JsonCompactResult = struct {
    original_json_chars: Int,
    compact_chars: Int,
    estimated_tokens_saved: Int,
    compressed_payload: String
};

pub fn tabular_dataset_new(headers: List[String]) -> TabularDataset {
    let empty_rows: List[List[String]] = list_new();
    let n: Int = list_len(headers);
    return TabularDataset {
        headers: headers,
        rows: empty_rows,
        total_records: 0
    };
}

pub fn tabular_dataset_add_row(dataset: &mut TabularDataset, row: List[String]) {
    dataset.rows = list_push(dataset.rows, row);
    dataset.total_records = dataset.total_records + 1;
}

pub fn json_compact_format_csv(dataset: &TabularDataset) -> String {
    let num_headers: Int = list_len((dataset).headers);
    let mut out: String = "";

    let mut i: Int = 0;
    while i < num_headers {
        let h: String = list_get((dataset).headers, i);
        if i > 0 {
            out = out + ",";
        }
        out = out + h;
        i = i + 1;
    }
    out = out + "\n";

    let num_rows: Int = list_len((dataset).rows);
    let mut r_idx: Int = 0;
    while r_idx < num_rows {
        let row: List[String] = list_get((dataset).rows, r_idx);
        let row_len: Int = list_len(row);
        let mut c_idx: Int = 0;
        while c_idx < row_len {
            let val: String = list_get(row, c_idx);
            if c_idx > 0 {
                out = out + ",";
            }
            out = out + val;
            c_idx = c_idx + 1;
        }
        out = out + "\n";
        r_idx = r_idx + 1;
    }

    return out;
}

pub fn json_compact_compress(
    dataset: &TabularDataset,
    orig_chars: Int
) -> JsonCompactResult {
    let csv_out: String = json_compact_format_csv(dataset);
    let comp_len: Int = csv_out.len();

    let orig_tok: Int = (orig_chars / 4) + 1;
    let comp_tok: Int = (comp_len / 4) + 1;
    let saved: Int = if orig_tok > comp_tok { orig_tok - comp_tok } else { 0 };

    return JsonCompactResult {
        original_json_chars: orig_chars,
        compact_chars: comp_len,
        estimated_tokens_saved: saved,
        compressed_payload: csv_out
    };
}
