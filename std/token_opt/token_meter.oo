// # Monotonic Token Usage Counter and Rate Limiter
//
// Logline: Prompt/completion token counters, cost, and TPM/RPM windows.
// residual: &mut destubbed to by-value.

type TokenRateLimiterConfig = struct {
    max_tokens_per_minute: Int,
    max_requests_per_minute: Int,
    cost_per_million_prompt: Int,
    cost_per_million_completion: Int
};

type TokenMeter = struct {
    meter_id: Int,
    config: TokenRateLimiterConfig,
    total_prompt_tokens: Int,
    total_completion_tokens: Int,
    total_requests: Int,
    window_start_time: Int,
    window_tokens_used: Int,
    window_requests_used: Int,
    last_ok: Int
};

pub fn token_rate_limiter_config_default() -> TokenRateLimiterConfig {
    return TokenRateLimiterConfig {
        max_tokens_per_minute: 1000000,
        max_requests_per_minute: 500,
        cost_per_million_prompt: 1500000,
        cost_per_million_completion: 6000000
    };
}

pub fn token_meter_new(id: Int, cfg: TokenRateLimiterConfig, now: Int) -> TokenMeter {
    return TokenMeter {
        meter_id: id,
        config: cfg,
        total_prompt_tokens: 0,
        total_completion_tokens: 0,
        total_requests: 0,
        window_start_time: now,
        window_tokens_used: 0,
        window_requests_used: 0,
        last_ok: 1
    };
}

pub fn token_meter_check_quota(meter: TokenMeter, requested_tokens: Int, now: Int) -> TokenMeter {
    let elapsed: Int = now - meter.window_start_time;
    let mut start: Int = meter.window_start_time;
    let mut win_tok: Int = meter.window_tokens_used;
    let mut win_req: Int = meter.window_requests_used;
    if elapsed >= 60000 {
        start = now;
        win_tok = 0;
        win_req = 0;
    }
    let mut ok: Int = 1;
    if (win_tok + requested_tokens) > meter.config.max_tokens_per_minute {
        ok = 0;
    }
    if (win_req + 1) > meter.config.max_requests_per_minute {
        ok = 0;
    }
    return TokenMeter {
        meter_id: meter.meter_id,
        config: meter.config,
        total_prompt_tokens: meter.total_prompt_tokens,
        total_completion_tokens: meter.total_completion_tokens,
        total_requests: meter.total_requests,
        window_start_time: start,
        window_tokens_used: win_tok,
        window_requests_used: win_req,
        last_ok: ok
    };
}

pub fn token_meter_record_usage(meter: TokenMeter, prompt_tokens: Int, completion_tokens: Int) -> TokenMeter {
    let tot: Int = prompt_tokens + completion_tokens;
    return TokenMeter {
        meter_id: meter.meter_id,
        config: meter.config,
        total_prompt_tokens: meter.total_prompt_tokens + prompt_tokens,
        total_completion_tokens: meter.total_completion_tokens + completion_tokens,
        total_requests: meter.total_requests + 1,
        window_start_time: meter.window_start_time,
        window_tokens_used: meter.window_tokens_used + tot,
        window_requests_used: meter.window_requests_used + 1,
        last_ok: 1
    };
}

pub fn token_meter_total_tokens(meter: TokenMeter) -> Int {
    return meter.total_prompt_tokens + meter.total_completion_tokens;
}

pub fn token_meter_prompt_cost_micro(meter: TokenMeter) -> Int {
    return (meter.total_prompt_tokens * meter.config.cost_per_million_prompt) / 1000000;
}
