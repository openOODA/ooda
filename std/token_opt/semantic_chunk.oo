// # Boundary-Aware Function and Struct Semantic Chunker
//
// Logline: Splits source code along function and struct definition boundaries to prevent broken context spans.
//
// Setup: Pure semantic code chunker for LLM retrieval and context window packing.
//
// Beats:
//   1. Define CodeChunk and SemanticChunker structures.
//   2. Identify declaration boundaries for functions, structs, and interfaces.
//   3. Pack cohesive semantic code units within maximum chunk token thresholds.

pub type CodeChunk = struct {
    chunk_id: Int,
    declaration_name: String,
    chunk_type: String,   // "function", "struct", "module_header"
    content: String,
    token_count: Int,
    start_line: Int,
    end_line: Int
};

pub type SemanticChunker = struct {
    max_tokens_per_chunk: Int,
    min_tokens_per_chunk: Int,
    chunks: List[CodeChunk],
    total_tokens: Int
};

pub fn semantic_chunker_new(max_tok: Int, min_tok: Int) -> SemanticChunker {
    let empty_chunks: List[CodeChunk] = list_new();
    return SemanticChunker {
        max_tokens_per_chunk: max_tok,
        min_tokens_per_chunk: min_tok,
        chunks: empty_chunks,
        total_tokens: 0
    };
}

pub fn code_chunk_new(
    id: Int,
    name: String,
    ctype: String,
    content: String,
    start_l: Int,
    end_l: Int
) -> CodeChunk {
    let c_len: Int = content.len();
    let est_tok: Int = (c_len / 4) + 1;
    return CodeChunk {
        chunk_id: id,
        declaration_name: name,
        chunk_type: ctype,
        content: content,
        token_count: est_tok,
        start_line: start_l,
        end_line: end_l
    };
}

pub fn semantic_chunker_add_chunk(
    chunker: &mut SemanticChunker,
    chunk: CodeChunk
) {
    let tok: Int = chunk.token_count;
    chunker.chunks = list_push(chunker.chunks, chunk);
    chunker.total_tokens = chunker.total_tokens + tok;
}

pub fn semantic_chunker_count(chunker: &SemanticChunker) -> Int {
    let ch: List[CodeChunk] = (chunker).chunks;
    return list_len(ch);
}
