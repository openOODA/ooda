// # Attention KV-Cache Pruning and Streaming Token Sinks
//
// Logline: Preserves initial attention sink tokens and evicts low-importance middle tokens for streaming context.
//
// Setup: Pure KV-cache memory optimizer implementing StreamingLLM and H2O attention eviction strategies.
//
// Beats:
//   1. Define KvCacheToken and KvCachePruner structures.
//   2. Pin critical initial attention sink tokens (first K positions).
//   3. Prune middle tokens based on cumulative attention scores while preserving recent sliding window.

pub type KvCacheToken = struct {
    position: Int,
    token_id: Int,
    attention_score: Int,
    is_sink: Bool,
    is_recent: Bool
};

pub type KvCachePruner = struct {
    num_sink_tokens: Int,     // e.g. 4 initial tokens
    recent_window_size: Int,  // e.g. 64 recent tokens
    max_cached_tokens: Int,   // cache capacity
    cached_tokens: List[KvCacheToken],
    evicted_tokens_count: Int
};

pub fn kv_cache_pruner_new(
    num_sinks: Int,
    recent_win: Int,
    max_cap: Int
) -> KvCachePruner {
    let empty_tokens: List[KvCacheToken] = list_new();
    return KvCachePruner {
        num_sink_tokens: num_sinks,
        recent_window_size: recent_win,
        max_cached_tokens: max_cap,
        cached_tokens: empty_tokens,
        evicted_tokens_count: 0
    };
}

pub fn kv_cache_insert_token(
    pruner: &mut KvCachePruner,
    pos: Int,
    tok_id: Int,
    attn_score: Int
) {
    let is_sink: Bool = pos < pruner.num_sink_tokens;
    let entry: KvCacheToken = KvCacheToken {
        position: pos,
        token_id: tok_id,
        attention_score: attn_score,
        is_sink: is_sink,
        is_recent: true
    };

    pruner.cached_tokens = list_push(pruner.cached_tokens, entry);

    // If cache exceeds capacity, prune oldest non-sink token
    let total: Int = list_len(pruner.cached_tokens);
    if total > pruner.max_cached_tokens {
        let mut new_list: List[KvCacheToken] = list_new();
        let mut pruned: Bool = false;
        let mut i: Int = 0;

        while i < total {
            let tok: KvCacheToken = list_get(pruner.cached_tokens, i);
            if !((tok).is_sink) && !pruned {
                pruned = true;
                pruner.evicted_tokens_count = pruner.evicted_tokens_count + 1;
            } else {
                new_list = list_push(new_list, tok);
            }
            i = i + 1;
        }
        pruner.cached_tokens = new_list;
    }
}

pub fn kv_cache_current_size(pruner: &KvCachePruner) -> Int {
    let t: List[KvCacheToken] = (pruner).cached_tokens;
    return list_len(t);
}
