// CAP-G6: preferred UdpCap for DNS residual (UDP query path when product lands).
// IETF RFC Compliance: RFC 1035 (Domain Names - Implementation and Specification).
// Not raw/L2 — soft-granular; do not keep legacy &NetCap on this surface.
// Residual: real UDP socket DNS not implemented (localhost hardcode + Err).
// SECURITY: never construct Cap(0)/NetCap(0)/UdpCap(0) in verify (forge theater banned).
// Cap on resolve_ipv4 is API honesty for a future sealed UDP path; pure residual
// contract is verified without synthesizing capability tokens.

fn resolve_ipv4_pure(hostname: String) -> Result[String, String]
    requires hostname != ""
{
    if hostname == "localhost" {
        return Ok("127.0.0.1");
    }

    return Err("Residual: UDP socket DNS not implemented");
}

fn resolve_ipv4(udp: &UdpCap, hostname: String) -> Result[String, String]
    requires hostname != ""
{
    return resolve_ipv4_pure(hostname);
}

verify resolve_ipv4_pure {
    let ok_res: Result[String, String] = resolve_ipv4_pure("localhost");
    assert_eq!(ok_res, Ok("127.0.0.1"));

    let err_res: Result[String, String] = resolve_ipv4_pure("openooda.org");
    assert_eq!(err_res, Err("Residual: UDP socket DNS not implemented"));
}
