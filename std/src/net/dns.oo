fn resolve_ipv4(net: &NetCap, hostname: String) -> Result[String, String]
    requires hostname != ""
{
    if hostname == "localhost" {
        return Ok("127.0.0.1");
    }
    
    return Err("Residual: UDP socket DNS not implemented");
}
verify resolve_ipv4 {
    let ok_res: Result[String, String] = resolve_ipv4(NetCap(0), "localhost");
    assert_eq!(ok_res, Ok("127.0.0.1"));

    let err_res: Result[String, String] = resolve_ipv4(NetCap(0), "openooda.org");
    assert_eq!(err_res, Err("Residual: UDP socket DNS not implemented"));
}
