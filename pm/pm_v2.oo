// # Lock v2 replaces, overrides, and local git pins
//
// Logline: Rename a dep, pin a version, and accept git:name#commit only with a matching local commit file.
//
// Setup: ooda.pkg keys replaces= and overrides=. No git clone. No network.
//
// Beats:
//   1. replaces=old>new maps a name before resolve.
//   2. overrides=name@ver refuses a different resolved version.
//   3. git:name#commit is ok only when fixtures/pm_name/commit or name/commit matches.

import "pm_resolve.oo";

fn v2_tok_name(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 1 {
        return tok;
    }
    return str_slice(tok, 0, at);
}

pub fn pm_replace_name(name: String, replaces: String) -> String {
    let n: Int = chars_len(replaces);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(replaces, i) == "," {
            if i > start {
                let one: String = str_slice(replaces, start, i);
                let gt: Int = str_index_of(one, ">");
                if gt > 0 {
                    if str_slice(one, 0, gt) == name {
                        return str_slice(one, gt + 1, chars_len(one));
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return name;
}

pub fn pm_override_ver(name: String, overrides: String) -> String {
    let n: Int = chars_len(overrides);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(overrides, i) == "," {
            if i > start {
                let one: String = str_slice(overrides, start, i);
                let at: Int = str_index_of(one, "@");
                if at > 0 {
                    if str_slice(one, 0, at) == name {
                        return str_slice(one, at + 1, chars_len(one));
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn pm_git_name(spec: String) -> String {
    if chars_len(spec) < 5 {
        return "";
    }
    if str_slice(spec, 0, 4) == "git:" {
        let rest: String = str_slice(spec, 4, chars_len(spec));
        let h: Int = str_index_of(rest, "#");
        if h < 1 {
            return rest;
        }
        return str_slice(rest, 0, h);
    }
    return "";
}

pub fn pm_git_commit(spec: String) -> String {
    let h: Int = str_index_of(spec, "#");
    if h < 0 {
        return "";
    }
    return str_slice(spec, h + 1, chars_len(spec));
}

pub fn pm_git_ok(have: String, want: String) -> Bool {
    if want == "" {
        return false;
    }
    let mut live: String = have;
    let n: Int = chars_len(live);
    if n > 0 {
        if char_at(live, n - 1) == "\n" {
            live = str_slice(live, 0, n - 1);
        }
    }
    return live == want;
}

pub fn pm_dep_names(deps: String) -> String {
    let n: Int = chars_len(deps);
    let mut out: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(deps, i) == "," {
            if i > start {
                let one: String = str_slice(deps, start, i);
                let mut nm: String = one;
                if chars_len(one) >= 5 {
                    if str_slice(one, 0, 5) == "path:" {
                        nm = str_slice(one, 5, chars_len(one));
                    }
                }
                if chars_len(one) >= 4 {
                    if str_slice(one, 0, 4) == "git:" {
                        nm = pm_git_name(one);
                    }
                }
                nm = v2_tok_name(nm);
                if nm != "" {
                    out = out + nm + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn pm_lock_has_name(acc: String, name: String) -> Bool {
    return str_index_of(acc, name + "@") >= 0;
}

fn pm_lock_union(acc: String, more: String) -> String {
    let n: Int = chars_len(more);
    let mut out: String = acc;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(more, i) == "\n" {
            if i > start {
                let line: String = str_slice(more, start, i);
                let nm: String = v2_tok_name(line);
                if nm != "" {
                    if pm_lock_has_name(out, nm) == false {
                        out = out + line + "\n";
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn pm_resolve_names(catalog: String, names: String, parent_caps: Int) -> String {
    let n: Int = chars_len(names);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut acc: String = "";
    while i <= n {
        if i == n || char_at(names, i) == "\n" || char_at(names, i) == "," {
            if i > start {
                let one: String = str_slice(names, start, i);
                if one != "" {
                    let r: String = pm_resolve(catalog, one, parent_caps);
                    if chars_len(r) < 3 {
                        return r;
                    }
                    if str_slice(r, 0, 3) != "ok " {
                        return r;
                    }
                    acc = pm_lock_union(acc, str_slice(r, 3, chars_len(r)));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "ok " + acc;
}
