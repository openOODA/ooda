// # Ingest recipe unit proofs
//
// Logline: Drive shipped parse, sha match, git pin, origin, and wrapper text.
//
// Setup: In-memory strings. Same-dir imports. No HTTP.
//
// Beats:
//   1. Origins and sha match/refuse.
//   2. Local git commit match and miss.
//   3. Wrapper names the payload and does not claim transmutation.

import "pm_policy.oo";
import "pm_recipe.oo";
import "pm_v2.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    if !pm_origin_ok("dir") { fail("origin dir"); }
    if !pm_origin_ok("git") { fail("origin git"); }
    if !pm_origin_blob("deb") { fail("blob deb"); }
    if pm_origin_ok("aur") { fail("origin aur"); }
    println("origin");
    if !pm_recipe_sha_ok("", "abc") { fail("sha empty"); }
    if !pm_recipe_sha_ok("abc", "abc") { fail("sha hit"); }
    if pm_recipe_sha_ok("abc", "zzz") { fail("sha miss"); }
    println("sha");
    if pm_git_ok("abc123\n", "abc123") { println("git ok"); } else { fail("git ok"); }
    if pm_git_ok("abc123\n", "nope") { fail("git miss"); }
    println("git refuse");
    if pm_recipe_commit_want("commit=dead\n") == "dead" {
        println("commit want");
    } else {
        fail("commit want");
    }
    let wrap: String = pm_recipe_wrap("ingdir", "abc", "ingdir.oo");
    if str_index_of(wrap, "ingdir.oo") < 0 { fail("wrap payload"); }
    if str_index_of(wrap, "transmut") >= 0 { fail("wrap transmut"); }
    if str_index_of(wrap, "Ooda binary") >= 0 { fail("wrap binary"); }
    if str_index_of(wrap, "seccomp") >= 0 { fail("wrap seccomp"); }
    println("wrapper");
    if pm_yanked("tooyank@1.0.0\n", "tooyank", "1.0.0") { println("yank"); } else { fail("yank"); }
    if pm_license_ok("MIT", "Proprietary") { fail("lic"); }
    println("policy");
    println("pm_ingest_proof: PASSED");
}
