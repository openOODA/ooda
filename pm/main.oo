// job: package manager entry point
// in: NetCap + FsWriteCap
import "std/os/process.oo";
import "std/os/fs.oo";
import "std/net/http.oo";
import "std/str.oo";

pub fn is_valid_pkg_name(name: String) -> Bool {
    if name == "" || name == "." || name == ".." { return false; }
    if str_contains(name, "/") || str_contains(name, "\\") { return false; }
    if str_contains(name, "..") { return false; }
    return true;
}

pub fn main(p: &ProcessCap, net: &NetCap, fsW: &FsWriteCap, env: &EnvCap) {
    let cli_args: List[String] = process_args(p);
    let n = list_len(cli_args);
    if n < 1 {
        println("usage: ooda-pm <cmd> [args...]");
        process_exit(1);
    }
    let cmd = list_get(cli_args, 0);
    
    let mut registry = "https://registry.openooda.org";
    let mut pkg_name = "";
    
    let mut i = 1;
    while i < n {
        let arg = list_get(cli_args, i);
        if arg == "--registry" && i + 1 < n {
            registry = list_get(cli_args, i + 1);
            i = i + 1;
        } else if str_starts_with(arg, "--registry=") {
            registry = str_slice(arg, 11, chars_len(arg));
        } else if str_slice(arg, 0, 1) != "-" {
            if pkg_name == "" {
                pkg_name = arg;
            }
        }
        i = i + 1;
    }
    
    let r_cwd: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if r_cwd.is_err() {
        println("ERR: OODA_FS_WRITEDIR not set");
        process_exit(1);
    }
    let cwd = r_cwd.unwrap();
    let _m1: Result[Void, String] = fs_mkdir(fsW, cwd + "/.ooda_modules");
    let _m2: Result[Void, String] = fs_mkdir(fsW, cwd + "/.ooda_modules/cas");

    if cmd == "install" {
        let url = registry + "/api/v1/manifest/install";
        let res: Result[String, String] = http_fetch(net, url);
        if res.is_err() {
            println("ERR: fetch failed"); process_exit(1);
        }
        let content = res.unwrap();
        let _w: Result[Void, String] = fs_write_file(fsW, cwd + "/.ooda_modules/cas/manifest_install.json", content);
        if _w.is_err() { println("ERR: write failed"); process_exit(1); }
        return;
    }
    
    if cmd == "add" {
        if pkg_name == "" {
            println("ERR: missing package name"); process_exit(1);
        }
        // SSRF / Path Traversal validation
        if !is_valid_pkg_name(pkg_name) {
            println("ERR: invalid package name (SSRF / traversal attempt rejected)");
            process_exit(1);
        }
        
        let url = registry + "/api/v1/" + pkg_name;
        let res: Result[String, String] = http_fetch(net, url);
        if res.is_err() {
            println("ERR: fetch failed"); process_exit(1);
        }
        let content = res.unwrap();
        let _w: Result[Void, String] = fs_write_file(fsW, cwd + "/.ooda_modules/cas/" + pkg_name, content);
        if _w.is_err() { println("ERR: write failed"); process_exit(1); }
        return;
    }
    
    println("ERR: unknown command");
    process_exit(1);
}
