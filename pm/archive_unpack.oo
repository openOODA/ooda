// # Package archive unpack
//
// Logline: Validate package paths, verify content-addressable checksums, and unpack safely into CAS stores.
//
// Setup: Imports manifest_types and os/fs.oo. Validates against directory traversal and checksum tampering.
//
// Beats:
//   1. Validate destination paths and reject directory traversal attempts (.. or root escapes).
//   2. Calculate and verify content-addressable storage (CAS) checksums.
//   3. Provide safe CAS unpacking and integrity verification.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "os/fs.oo";

pub fn pm_archive_validate_path(target_path: String) -> Bool {
    let len: Int = target_path.len();
    if len == 0 {
        return false;
    }
    // Reject absolute paths escaping root or suspicious prefixes
    if str_slice(target_path, 0, 1) == "/" {
        return false;
    }
    if str_slice(target_path, 0, 1) == "\\" {
        return false;
    }
    // Reject directory traversal patterns
    if target_path.contains("..") {
        return false;
    }
    if target_path.contains(":") {
        return false;
    }
    return true;
}

pub fn pm_archive_checksum(content: String) -> String {
    let len: Int = content.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let ch: Int = byte_at(content, i);
        let h_scaled = hash * 33;
        hash = h_scaled + ch;
        i = i + 1;
    }
    return "cas_" + hash.to_string();
}

pub fn pm_archive_verify_checksum(content: String, expected_checksum: String) -> Bool {
    if expected_checksum.len() == 0 {
        return false;
    }
    let actual = pm_archive_checksum(content);
    return actual == expected_checksum;
}

pub fn pm_archive_unpack_cas(
    fsW: &FsWriteCap,
    archive_name: String,
    content: String,
    dest_dir: String,
    expected_checksum: String
) -> Result[Int, String] {
    if pm_archive_validate_path(archive_name) == false {
        return Err("Path traversal attempt detected in archive name");
    }
    if expected_checksum.len() != 0 {
        if pm_archive_verify_checksum(content, expected_checksum) == false {
            return Err("Archive integrity verification failed: checksum mismatch");
        }
    }
    let full_path = dest_dir + "/" + archive_name;
    let write_res: Result[Void, String] = fs_write_file(fsW, full_path, content);
    match write_res {
        Ok(_) => return Ok(content.len()),
        Err(e) => return Err("Failed to unpack archive into CAS: " + e),
    };
}