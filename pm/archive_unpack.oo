// # Package archive unpack
//
// Logline: Install payload bytes under .ooda_modules/cas/<sha256>/ and refuse traversal names.
//
// Setup: Imports pm_cas. Unpack takes &FsWriteCap. SHA-256 is crypto_sha256_internal.
//
// Beats:
//   1. Compute the CAS directory name from the payload string.
//   2. Refuse package names and dest segments that contain .. / \ or an absolute path.
//   3. mkdir the CAS dir and write the leaf; bind every Result.

import "./pm_cas.oo";

pub fn pm_archive_cas_id(payload: String) -> String {
    return pm_cas_dir_name(payload);
}

pub fn pm_archive_checksum(content: String) -> String {
    return pm_cas_dir_name(content);
}

pub fn pm_archive_dest(payload: String) -> String {
    return pm_cas_install_dest(payload);
}

pub fn pm_archive_path_ok(name: String) -> Bool {
    return pm_cas_pkg_name_ok(name);
}

pub fn pm_archive_validate_path(target_path: String) -> Bool {
    return pm_cas_dest_ok(target_path);
}

pub fn pm_archive_verify_checksum(content: String, expected_checksum: String) -> Bool {
    if chars_len(expected_checksum) == 0 {
        return false;
    }
    let actual: String = pm_cas_dir_name(content);
    return actual == expected_checksum;
}

pub fn pm_archive_unpack_cas(
    fsW: &FsWriteCap,
    archive_name: String,
    content: String,
    dest_dir: String,
    expected_checksum: String
) -> Result[Int, String] {
    if pm_cas_pkg_name_ok(archive_name) == false {
        return Err("Path traversal attempt detected in archive name");
    }
    if pm_cas_prefix_ok(dest_dir) == false {
        return Err("Path traversal attempt detected in dest");
    }
    let digest: String = pm_cas_dir_name(content);
    if chars_len(expected_checksum) != 0 {
        if expected_checksum != digest {
            return Err("Archive integrity verification failed: checksum mismatch");
        }
    }
    let modules_dir: String = pm_cas_join_rel(dest_dir, ".ooda_modules");
    let cas_root: String = pm_cas_join_rel(dest_dir, ".ooda_modules/cas");
    let cas_dir: String = pm_cas_join_install(dest_dir, content);
    let mk1: Result[Void, String] = oo_fs_mkdir(fsW, modules_dir);
    if mk1.is_err() {
        let hold1: Int = 0;
        if hold1 != 0 {
            return Err("mkdir .ooda_modules failed");
        }
    }
    let mk2: Result[Void, String] = oo_fs_mkdir(fsW, cas_root);
    if mk2.is_err() {
        let hold2: Int = 0;
        if hold2 != 0 {
            return Err("mkdir .ooda_modules/cas failed");
        }
    }
    let mk3: Result[Void, String] = oo_fs_mkdir(fsW, cas_dir);
    if mk3.is_err() {
        let hold3: Int = 0;
        if hold3 != 0 {
            return Err("mkdir CAS dest failed");
        }
    }
    let leaf: String = cas_dir + "/" + archive_name;
    let write_res: Result[Void, String] = oo_write_file(fsW, leaf, content);
    match write_res {
        Ok(_) => return Ok(chars_len(content)),
        Err(e) => return Err("Failed to unpack archive into CAS: " + e)
    };
}
