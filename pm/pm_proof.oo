// # Named package-manager proofs
//
// Logline: Drive shipped pm_core and pm_resolve: resolve, traversal, lock, caps.
//
// Setup: In-memory catalog. No hard-coded SHA-256 hex. No network.
//
// Beats:
//   1. hello resolves world@^1.0.0.
//   2. .. / and absolute names refuse.
//   3. Lock match/tamper and cap escalation.

import "pm_core.oo";
import "pm_resolve.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let cat: String = "world|1.0.0|1|\nhello|1.0.0|1|world@^1.0.0#1\nevilcap|1.0.0|2|\n";
    let r: String = pm_resolve(cat, "hello", 1);
    if str_slice(r, 0, 3) != "ok " {
        fail("resolve " + r);
    }
    if str_index_of(r, "hello@1.0.0") < 0 {
        fail("hello missing " + r);
    }
    if str_index_of(r, "world@1.0.0") < 0 {
        fail("world missing " + r);
    }
    println("resolve " + r);
    if pm_name_ok("..") {
        fail("dotdot");
    }
    if pm_name_ok("a/b") {
        fail("slash");
    }
    if pm_name_ok("/abs") {
        fail("abs");
    }
    if !pm_name_ok("hello") {
        fail("hello name");
    }
    println("traversal refuse");
    let lock: String = "hello@1.0.0#abc\nworld@1.0.0#def\n";
    let h1: String = pm_lock_hash(lock);
    let h2: String = pm_lock_hash(lock);
    if h1 != h2 {
        fail("lock match");
    }
    if chars_len(h1) != 64 {
        fail("lock len");
    }
    let bad: String = "hello@1.0.0#EVIL\nworld@1.0.0#def\n";
    if pm_lock_same(lock, bad) {
        fail("lock tamper");
    }
    println("lock match/tamper");
    if pm_caps_ok(1, 2) {
        fail("caps escalate");
    }
    if pm_caps_ok(1, 256) {
        fail("caps high bit");
    }
    if !pm_caps_ok(7, 5) {
        fail("caps subset");
    }
    if !pm_caps_ok(0, 0) {
        fail("caps empty");
    }
    let ev: String = pm_resolve(cat, "evilcap", 1);
    if str_index_of(ev, "err caps") < 0 {
        fail("evilcap " + ev);
    }
    let hi: String = pm_resolve("hibit|1.0.0|256|\n", "hibit", 1);
    if str_index_of(hi, "err caps") < 0 {
        fail("hibit " + hi);
    }
    println("caps refuse");
    println("pm_proof: PASSED");
}
