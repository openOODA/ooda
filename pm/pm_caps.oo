// # Package capability non-escalation
//
// Logline: Refuse child capability bits that the parent grant does not contain.
//
// Setup: Parent grant and child required_caps are Int bitmasks. Default-deny.
//
// Beats:
//   1. Intersect the child mask with the parent grant.
//   2. Accept only when every child bit is already granted.
//   3. Fail closed so resolve and install refuse any extra bit.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub fn pm_caps_ok(parent: Int, child: Int) -> Bool {
    return (child & parent) == child;
}

pub fn pm_caps_denied() -> String {
    return "Capability escalation refused";
}

pub fn pm_caps_gate(parent: Int, child: Int) -> Result[Bool, String] {
    if pm_caps_ok(parent, child) == false {
        return Err(pm_caps_denied());
    }
    return Ok(true);
}
