// # Named package capabilities
//
// Logline: Map FsRead, FsWrite, Net, Process to bits and refuse extra bits.
//
// Setup: Manifest caps=FsRead or a small Int. Default-deny.
//
// Beats:
//   1. Parse a cap name or digit string to a mask.
//   2. Accept a child mask only when it is a subset of the parent.
//   3. Print the primary cap name for lock lines.

pub fn pm_cap_bit(name: String) -> Int {
    if name == "FsRead" { return 1; }
    if name == "Net" { return 2; }
    if name == "Process" { return 4; }
    if name == "FsWrite" { return 8; }
    if name == "1" { return 1; }
    if name == "2" { return 2; }
    if name == "4" { return 4; }
    if name == "8" { return 8; }
    return 0;
}

pub fn pm_cap_parse(s: String) -> Int {
    if s == "" {
        return 1;
    }
    let at: Int = str_index_of(s, ",");
    if at >= 0 {
        return pm_cap_bit(str_slice(s, 0, at)) + pm_cap_bit(str_slice(s, at + 1, chars_len(s)));
    }
    let b: Int = pm_cap_bit(s);
    if b > 0 {
        return b;
    }
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    let mut dig: Bool = true;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        else { dig = false; }
        i = i + 1;
    }
    if dig { return v; }
    return 0;
}

pub fn pm_cap_name(mask: Int) -> String {
    if mask == 1 { return "FsRead"; }
    if mask == 2 { return "Net"; }
    if mask == 4 { return "Process"; }
    if mask == 8 { return "FsWrite"; }
    return "FsRead";
}

pub fn pm_caps_ok(parent: Int, child: Int) -> Bool {
    return (child & parent) == child;
}
