// # Manifest parse entry
//
// Logline: Expose on-disk key=value parse and payload SHA-256 for typed manifests.
//
// Setup: Imports manifest_parse. File-backed vendor only. No integer checksums.
//
// Beats:
//   1. Parse name, version, deps, caps, and payload keys.
//   2. Return a PmManifest with List[PmDependency].
//   3. Hash payload_bytes with crypto_sha256_internal.

import "./manifest_parse.oo";

pub fn pm_man_name(text: String) -> String {
    return pm_manifest_name(text);
}

pub fn pm_man_parse(text: String) -> PmManifest {
    return pm_manifest_parse(text);
}

pub fn pm_man_sha(payload_bytes: String) -> String {
    return crypto_sha256_internal(payload_bytes);
}

pub fn pm_man_bind(man: PmManifest, payload_bytes: String) -> PmManifest {
    return pm_manifest_bind_payload(man, payload_bytes);
}
