// # Package manifest records
//
// Logline: Hold SemVer, capability masks, and package ids as fixed-size DOD structs.
//
// Setup: Flat Data-Oriented Design memory layout is defined for zero-copy package metadata.
//
// Beats:
//   1. Encode SemVer as three u32 fields.
//   2. Encode Caps as a u64 bitmask.
//   3. Pair PackageId hashes with version, caps, and checksum.

// This file strictly adheres to dod_layout principles:
// - Zero-copy operations
// - No ambient heap allocations (e.g., no Strings, no Lists)
// - Fixed-size data structures suited for data-oriented design

// SemVer implemented with u32 to avoid heap allocations
pub type SemVer = struct {
    major: u32,
    minor: u32,
    patch: u32,
};

// Caps implemented using a u64 bitmask for capabilities
pub type Caps = struct {
    mask: u64,
};

pub type PackageId = struct {
    vendor_hash: u64,
    name_hash: u64,
};

pub type Manifest = struct {
    id: PackageId,
    version: SemVer,
    capabilities: Caps,
    checksum: u64,
};
