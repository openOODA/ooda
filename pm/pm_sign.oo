// # Local HMAC sign and verify for manifests
//
// Logline: Sign name+version+sha256 with crypto_hmac_sha256_internal. Tamper fails closed.
//
// Setup: Default key is ooda-local-pm. No network.
//
// Beats:
//   1. Build the signed payload string.
//   2. HMAC-SHA256 hex of that payload.
//   3. Verify by recomputing. Empty sig is a miss.

pub fn pm_sign_payload(name: String, version: String, sha: String) -> String {
    return name + "@" + version + "#" + sha;
}

pub fn pm_sign(key: String, name: String, version: String, sha: String) -> String {
    let mut k: String = key;
    if k == "" {
        k = "ooda-local-pm";
    }
    return crypto_hmac_sha256_internal(k, pm_sign_payload(name, version, sha));
}

pub fn pm_sign_ok(key: String, name: String, version: String, sha: String, sig: String) -> Bool {
    if sig == "" {
        return false;
    }
    let want: String = pm_sign(key, name, version, sha);
    return want == sig;
}
