// # On-disk manifest fields
//
// Logline: Read key=value manifests used by the file-backed vendor.
//
// Setup: Imports pm_resolve. Payload SHA-256 is computed from bytes, not djb2.
//
// Beats:
//   1. Parse name, version, deps, caps, payload keys.
//   2. SemVer satisfy via pm_semver_sat.
//   3. Hash payload bytes with crypto_sha256_internal.

import "pm_core.oo";
import "pm_resolve.oo";

pub fn pm_manifest_name(text: String) -> String {
    return pm_kv(text, "name");
}

pub fn pm_manifest_version(text: String) -> String {
    return pm_kv(text, "version");
}

pub fn pm_manifest_deps(text: String) -> String {
    return pm_kv(text, "deps");
}

pub fn pm_manifest_caps(text: String) -> Int {
    return pm_int(pm_kv(text, "caps"));
}

pub fn pm_payload_sha(payload: String) -> String {
    return pm_sha256(payload);
}
