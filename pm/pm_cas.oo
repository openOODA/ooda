// # Content-addressed install dest
//
// Logline: Compute the CAS directory from payload SHA-256 and refuse traversal dest segments.
//
// Setup: Pure. crypto_sha256_internal hashes payload bytes. No filesystem and no network.
//
// Beats:
//   1. Name the CAS directory as the SHA-256 of the payload.
//   2. Form the install dest .ooda_modules/cas/<sha256>/.
//   3. Refuse package names and dest segments that carry .. / \ or an absolute path.

pub fn pm_cas_dir_name(payload: String) -> String {
    return crypto_sha256_internal(payload);
}

pub fn pm_cas_install_dest(payload: String) -> String {
    return ".ooda_modules/cas/" + pm_cas_dir_name(payload) + "/";
}

pub fn pm_cas_segment_ok(seg: String) -> Bool {
    if chars_len(seg) == 0 {
        return false;
    }
    if seg == "." {
        return false;
    }
    if seg == ".." {
        return false;
    }
    if str_index_of(seg, "..") >= 0 {
        return false;
    }
    if str_index_of(seg, "/") >= 0 {
        return false;
    }
    if str_index_of(seg, "\\") >= 0 {
        return false;
    }
    if str_slice(seg, 0, 1) == "/" {
        return false;
    }
    if str_slice(seg, 0, 1) == "\\" {
        return false;
    }
    if str_index_of(seg, ":") >= 0 {
        return false;
    }
    return true;
}

pub fn pm_cas_pkg_name_ok(name: String) -> Bool {
    return pm_cas_segment_ok(name);
}

pub fn pm_cas_dest_ok(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n == 0 {
        return false;
    }
    let first: String = str_slice(path, 0, 1);
    if first == "/" {
        return false;
    }
    if first == "\\" {
        return false;
    }
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let mut sep: Bool = false;
        if i == n {
            sep = true;
        } else {
            let ch: String = char_at(path, i);
            if ch == "/" {
                sep = true;
            }
            if ch == "\\" {
                return false;
            }
        }
        if sep {
            let seg: String = str_slice(path, start, i);
            if pm_cas_segment_ok(seg) == false {
                return false;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

pub fn pm_cas_prefix_ok(dest_dir: String) -> Bool {
    if dest_dir == "" {
        return true;
    }
    if dest_dir == "." {
        return true;
    }
    if str_index_of(dest_dir, "..") >= 0 {
        return false;
    }
    if str_index_of(dest_dir, "\\") >= 0 {
        return false;
    }
    if str_slice(dest_dir, 0, 1) == "/" {
        return true;
    }
    return pm_cas_dest_ok(dest_dir);
}

pub fn pm_cas_join_rel(dest_dir: String, rel: String) -> String {
    if dest_dir == "" {
        return rel;
    }
    if dest_dir == "." {
        return rel;
    }
    return dest_dir + "/" + rel;
}

pub fn pm_cas_join_install(dest_dir: String, payload: String) -> String {
    let rel: String = ".ooda_modules/cas/" + pm_cas_dir_name(payload);
    return pm_cas_join_rel(dest_dir, rel);
}
