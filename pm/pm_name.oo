// # Package name gate
//
// Logline: Refuse empty, dotted, traversed, and absolute package names before any path is joined.
//
// Setup: Pure character checks. No filesystem, network, or capability.
//
// Beats:
//   1. Reject empty, ".", and ".." names.
//   2. Reject any `/`, `\`, or `..` substring.
//   3. Reject absolute paths, including drive-letter forms.

pub fn pm_name_ok(name: String) -> Bool {
    if name == "" {
        return false;
    }
    if name == "." {
        return false;
    }
    if name == ".." {
        return false;
    }
    if str_index_of(name, "/") >= 0 {
        return false;
    }
    if str_index_of(name, "\\") >= 0 {
        return false;
    }
    if str_index_of(name, "..") >= 0 {
        return false;
    }
    if str_slice(name, 0, 1) == "/" {
        return false;
    }
    if str_slice(name, 0, 1) == "\\" {
        return false;
    }
    let n: Int = chars_len(name);
    if n >= 2 {
        if char_at(name, 1) == ":" {
            return false;
        }
    }
    return true;
}
