// # Package manager manifest types
//
// Logline: Define SemVer, package identity, capability constraints, dependency records, and lockfile structures.
//
// Setup: Core data structures for package resolution, manifest parsing, and deterministic locking.
//
// Beats:
//   1. Define PmSemVer, PmPackageId, and PmCaps structures.
//   2. Define PmDependency, PmManifest, and PmResolveNode structures.
//   3. Define PmResolveResult and PmLockfile deterministic records with constructors.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub type PmSemVer = struct {
    major: Int,
    minor: Int,
    patch: Int,
    is_valid: Bool,
};

pub type PmPackageId = struct {
    vendor_hash: Int,
    name_hash: Int,
    name: String,
    vendor: String,
};

pub type PmCaps = struct {
    mask: Int,
};

pub type PmDependency = struct {
    name: String,
    vendor: String,
    constraint_op: String,
    req_major: Int,
    req_minor: Int,
    req_patch: Int,
    is_wildcard: Bool,
    granted_caps: Int,
};

pub type PmManifest = struct {
    name: String,
    vendor: String,
    version: PmSemVer,
    version_str: String,
    required_caps: Int,
    checksum: String,
    dependencies: List[PmDependency],
    is_valid: Bool,
};

pub type PmResolveNode = struct {
    name: String,
    vendor: String,
    version: PmSemVer,
    version_str: String,
    granted_caps: Int,
    parent_name: String,
    depth: Int,
};

pub type PmResolveResult = struct {
    success: Bool,
    error_code: Int,
    error_msg: String,
    nodes: List[PmResolveNode],
    total_nodes: Int,
};

pub type PmLockEntry = struct {
    name: String,
    vendor: String,
    version_str: String,
    major: Int,
    minor: Int,
    patch: Int,
    granted_caps: Int,
    checksum: String,
    depth: Int,
};

pub type PmLockfile = struct {
    manifest_name: String,
    manifest_version: String,
    entries: List[PmLockEntry],
    total_entries: Int,
    generated_at: Int,
    lock_hash: String,
    is_locked: Bool,
};

// -------------------------------------------------------------------
// Constructors and Default Helpers
// -------------------------------------------------------------------

pub fn pm_semver_new(major: Int, minor: Int, patch: Int) -> PmSemVer {
    let mut valid = true;
    if major < 0 {
        valid = false;
    }
    if minor < 0 {
        valid = false;
    }
    if patch < 0 {
        valid = false;
    }
    return PmSemVer {
        major: major,
        minor: minor,
        patch: patch,
        is_valid: valid,
    };
}

pub fn pm_semver_empty() -> PmSemVer {
    return PmSemVer {
        major: 0,
        minor: 0,
        patch: 0,
        is_valid: false,
    };
}

pub fn pm_dependency_new(
    name: String,
    vendor: String,
    op: String,
    major: Int,
    minor: Int,
    patch: Int,
    is_wildcard: Bool,
    granted_caps: Int
) -> PmDependency {
    return PmDependency {
        name: name,
        vendor: vendor,
        constraint_op: op,
        req_major: major,
        req_minor: minor,
        req_patch: patch,
        is_wildcard: is_wildcard,
        granted_caps: granted_caps,
    };
}

pub fn pm_manifest_empty() -> PmManifest {
    let empty_deps: List[PmDependency] = [];
    return PmManifest {
        name: "",
        vendor: "",
        version: pm_semver_empty(),
        version_str: "",
        required_caps: 0,
        checksum: "",
        dependencies: empty_deps,
        is_valid: false,
    };
}

pub fn pm_lockfile_empty() -> PmLockfile {
    let empty_entries: List[PmLockEntry] = [];
    return PmLockfile {
        manifest_name: "",
        manifest_version: "",
        entries: empty_entries,
        total_entries: 0,
        generated_at: 0,
        lock_hash: "",
        is_locked: false,
    };
}
