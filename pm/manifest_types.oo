// # Package manager manifest types
//
// Logline: Hold SemVer, dependencies, resolve nodes, and lock entries as typed records.
//
// Setup: In-memory model is structs. On-disk text is key=value. No List[String] stand-ins.
//
// Beats:
//   1. PmManifest.dependencies is List[PmDependency].
//   2. PmResolveResult.nodes is List[PmResolveNode].
//   3. PmLockfile.entries is List[PmLockEntry].

type PmSemVer = struct {
    major: Int,
    minor: Int,
    patch: Int,
    is_valid: Bool
};

type PmDependency = struct {
    name: String,
    vendor: String,
    constraint_op: String,
    req_major: Int,
    req_minor: Int,
    req_patch: Int,
    is_wildcard: Bool,
    granted_caps: Int
};

type PmManifest = struct {
    name: String,
    vendor: String,
    version: PmSemVer,
    version_str: String,
    required_caps: Int,
    checksum: String,
    dependencies: List[PmDependency],
    is_valid: Bool
};

type PmResolveNode = struct {
    name: String,
    vendor: String,
    version: PmSemVer,
    version_str: String,
    granted_caps: Int,
    parent_name: String,
    depth: Int
};

type PmResolveResult = struct {
    success: Bool,
    error_code: Int,
    error_msg: String,
    nodes: List[PmResolveNode],
    total_nodes: Int
};

type PmLockEntry = struct {
    name: String,
    vendor: String,
    version_str: String,
    major: Int,
    minor: Int,
    patch: Int,
    granted_caps: Int,
    checksum: String,
    depth: Int
};

type PmLockfile = struct {
    manifest_name: String,
    manifest_version: String,
    entries: List[PmLockEntry],
    total_entries: Int,
    generated_at: Int,
    lock_hash: String,
    is_locked: Bool
};

pub fn pm_semver_new(major: Int, minor: Int, patch: Int) -> PmSemVer {
    let mut valid = true;
    if major < 0 {
        valid = false;
    }
    if minor < 0 {
        valid = false;
    }
    if patch < 0 {
        valid = false;
    }
    return PmSemVer {
        major: major,
        minor: minor,
        patch: patch,
        is_valid: valid
    };
}

pub fn pm_semver_empty() -> PmSemVer {
    return PmSemVer {
        major: 0,
        minor: 0,
        patch: 0,
        is_valid: false
    };
}

pub fn pm_dependency_new(
    name: String,
    vendor: String,
    constraint_op: String,
    req_major: Int,
    req_minor: Int,
    req_patch: Int,
    is_wildcard: Bool,
    granted_caps: Int
) -> PmDependency {
    return PmDependency {
        name: name,
        vendor: vendor,
        constraint_op: constraint_op,
        req_major: req_major,
        req_minor: req_minor,
        req_patch: req_patch,
        is_wildcard: is_wildcard,
        granted_caps: granted_caps
    };
}

pub fn pm_manifest_empty() -> PmManifest {
    let empty_ver: PmSemVer = pm_semver_empty();
    let empty_deps: List[PmDependency] = list_new();
    return PmManifest {
        name: "",
        vendor: "",
        version: empty_ver,
        version_str: "0.0.0",
        required_caps: 0,
        checksum: "",
        dependencies: empty_deps,
        is_valid: false
    };
}

pub fn pm_lockfile_empty() -> PmLockfile {
    let empty_entries: List[PmLockEntry] = list_new();
    return PmLockfile {
        manifest_name: "",
        manifest_version: "",
        entries: empty_entries,
        total_entries: 0,
        generated_at: 0,
        lock_hash: "",
        is_locked: false
    };
}

pub fn pm_resolve_result_empty() -> PmResolveResult {
    let empty_nodes: List[PmResolveNode] = list_new();
    return PmResolveResult {
        success: false,
        error_code: 0,
        error_msg: "",
        nodes: empty_nodes,
        total_nodes: 0
    };
}

pub fn pm_record(name: String, version: String, caps: String, deps: String) -> String {
    return name + "|" + version + "|" + caps + "|" + deps;
}
