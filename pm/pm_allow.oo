// # Git URL allow-list
//
// Logline: Clone only prefixes listed in ingest.allow, ooda.pkg allow=, or github.com/.
//
// Setup: Comma or newline prefixes. registry.openooda.org is never allowed.
//
// Beats:
//   1. Default prefix is github.com/.
//   2. A url is allowed when it starts with a prefix or the host after :// does.
//   3. The live registry host is always a miss.

fn pm_pfx_bare(pfx: String) -> String {
    let n: Int = chars_len(pfx);
    if n < 1 {
        return pfx;
    }
    if char_at(pfx, n - 1) == "/" {
        return str_slice(pfx, 0, n - 1);
    }
    return pfx;
}

fn pm_url_host(url: String) -> String {
    if chars_len(url) >= 4 {
        if str_slice(url, 0, 4) == "git@" {
            let rest: String = str_slice(url, 4, chars_len(url));
            let c: Int = str_index_of(rest, ":");
            if c < 0 {
                return rest;
            }
            return str_slice(rest, 0, c);
        }
    }
    let at: Int = str_index_of(url, "://");
    if at < 0 {
        return url;
    }
    let rest: String = str_slice(url, at + 3, chars_len(url));
    let sl: Int = str_index_of(rest, "/");
    let cl: Int = str_index_of(rest, ":");
    let mut end: Int = chars_len(rest);
    if sl >= 0 {
        if sl < end {
            end = sl;
        }
    }
    if cl >= 0 {
        if cl < end {
            end = cl;
        }
    }
    return str_slice(rest, 0, end);
}

fn pm_url_pfx(url: String, pfx: String) -> Bool {
    let pn: Int = chars_len(pfx);
    if pn < 1 {
        return false;
    }
    if chars_len(url) >= pn {
        if str_slice(url, 0, pn) == pfx {
            return true;
        }
    }
    let host: String = pm_url_host(url);
    let bare: String = pm_pfx_bare(pfx);
    if host == bare {
        return true;
    }
    if chars_len(host) >= pn {
        if str_slice(host, 0, pn) == pfx {
            return true;
        }
    }
    return false;
}

pub fn pm_allow_default() -> String {
    return "github.com/\n";
}

pub fn pm_url_allowed(allow: String, url: String) -> Bool {
    if url == "" {
        return false;
    }
    if str_index_of(url, "registry.openooda.org") >= 0 {
        return false;
    }
    let text: String = allow + pm_allow_default();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let mut sep: Bool = false;
        if i == n {
            sep = true;
        } else {
            let c: String = char_at(text, i);
            if c == "\n" {
                sep = true;
            } else {
                if c == "," {
                    sep = true;
                }
            }
        }
        if sep {
            if i > start {
                let pfx: String = str_slice(text, start, i);
                if pfx == "" {
                    let _p: String = pfx;
                } else {
                    if pm_url_pfx(url, pfx) {
                        return true;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}
