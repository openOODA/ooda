// # ooda.pkg and complete lock proof
//
// Logline: Prove key=value parse, CapName lock lines, sort, and live SHA-256.
//
// Setup: In-memory ooda.pkg text. crypto_sha256_internal. No hard-coded digest hex.
//
// Beats:
//   1. Parse name, version, deps, and caps from ooda.pkg text.
//   2. Build complete name@version#sha256#CapName pins and reject a short lock line.
//   3. Same pins hash equal after reorder; tamper changes the digest.

import "pkg_parse.oo";
import "pkg_lock.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let text: String = pkg_emit("app", "1.0.0", "hello@^1.0.0,world@^1.0.0", "FsRead");
    if pkg_ok(text) == false {
        fail("pkg_ok");
    }
    if pkg_name(text) != "app" {
        fail("name");
    }
    if pkg_version(text) != "1.0.0" {
        fail("version");
    }
    if pkg_deps(text) != "hello@^1.0.0,world@^1.0.0" {
        fail("deps");
    }
    if pkg_caps(text) != "FsRead" {
        fail("caps");
    }
    if pkg_file() != "ooda.pkg" {
        fail("file");
    }
    if pkg_cap_name("1") != "FsRead" {
        fail("cap map");
    }
    println("ooda.pkg parse");
    let sha_a: String = crypto_sha256_internal("hello-body");
    let sha_b: String = crypto_sha256_internal("world-body");
    if chars_len(sha_a) != 64 {
        fail("sha len");
    }
    let la: String = pkg_lock_line("hello", "1.0.0", sha_a, "FsRead");
    let lb: String = pkg_lock_from_pkg("name=world\nversion=1.0.0\ndeps=\ncaps=1\n", sha_b);
    if pkg_lock_complete(la) == false {
        fail("complete a");
    }
    if pkg_lock_complete(lb) == false {
        fail("complete b");
    }
    if pkg_lock_cap(la) != "FsRead" {
        fail("cap field");
    }
    if pkg_lock_complete("hello@1.0.0#" + sha_a) {
        fail("incomplete missing CapName");
    }
    if pkg_lock_complete("hello@1.0.0#dead#FsRead") {
        fail("incomplete short sha");
    }
    println("lock complete");
    let first: String = lb + "\n" + la + "\n";
    let second: String = la + "\n" + lb + "\n";
    let sorted: String = pkg_lock_sort(first);
    if pkg_lock_text_ok(sorted) == false {
        fail("sorted text");
    }
    let h1: String = pkg_lock_digest(first);
    let h2: String = pkg_lock_digest(second);
    if h1 != h2 {
        fail("order digest");
    }
    if chars_len(h1) != 64 {
        fail("digest len");
    }
    let bad: String = pkg_lock_line("hello", "1.0.0", crypto_sha256_internal("TAMPER"), "FsRead") + "\n" + lb + "\n";
    if pkg_lock_match(first, bad) {
        fail("tamper");
    }
    println("lock sort/hash");
    println("pkg_lock_proof: PASSED");
}
