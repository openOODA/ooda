// # Package dependency resolve
//
// Logline: Match version constraints and reject capability escalation on flat DOD records.
//
// Setup: Re-export dependency resolution and constraint checking from resolve_tree.
//
// Beats:
//   1. Re-export SemVer constraint checking.
//   2. Validate capability escalation.
//   3. Solve dependency trees under capability bounds.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./resolve_tree.oo";

pub fn validate_capability_escalation(requested_caps: Int, granted_caps: Int) -> Bool {
    return pm_validate_capability_escalation(requested_caps, granted_caps);
}

pub fn check_version_constraint(actual: &PmSemVer, dep: &PmDependency) -> Bool {
    return pm_semver_satisfies(actual, dep);
}

pub fn resolve_graph(root: &PmManifest, registry: List[PmManifest], max_depth: Int) -> PmResolveResult {
    return pm_resolve_tree(root, registry, max_depth);
}
