// # SemVer dependency tree
//
// Logline: Resolve a root and every transitive dep from a file-backed catalog.
//
// Setup: Uses resolve.oo pick. Catalog is name|version|caps|deps. No HTTP.
//
// Beats:
//   1. Pick the root, then enqueue each comma-separated dep.
//   2. Recurse with a depth bound and skip names already chosen.
//   3. Fail closed on a missing name or capability escalation.
//
// residual: no fetch of registry.openooda.org

import "./resolve.oo";
import "./pm_core.oo";

fn tree_fail(code: String) -> String {
    return code;
}

fn tree_seen(out: String, name: String) -> Bool {
    return str_index_of(out, name + "@") >= 0;
}

fn tree_expand(
    catalog: String,
    deps: String,
    parent_caps: Int,
    out: String,
    queue: List[String],
    depths: List[Int],
    next_depth: Int
) -> String {
    let dn: Int = chars_len(deps);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut acc: String = out;
    let mut q: List[String] = queue;
    let mut ds: List[Int] = depths;
    while i <= dn {
        if i == dn || char_at(deps, i) == "," {
            let tok: String = str_slice(deps, start, i);
            if tok != "" {
                if str_index_of(tok, "@") < 1 {
                    return tree_fail("err dep");
                }
                let dname: String = dep_name(tok);
                if pm_name_ok(dname) == false {
                    return tree_fail("err name");
                }
                let dgrant: Int = dep_grant(tok, parent_caps);
                if pm_caps_ok(parent_caps, dgrant) == false {
                    return tree_fail("err caps");
                }
                if tree_seen(acc, dname) == false {
                    let dline: String = resolve_pick(catalog, dname, dep_spec(tok));
                    if dline == "" {
                        return tree_fail("err missing");
                    }
                    let dcaps: Int = pm_int(rec_field(dline, 2));
                    if pm_caps_ok(dgrant, dcaps) == false {
                        return tree_fail("err caps");
                    }
                    acc = acc + " " + dname + "@" + rec_field(dline, 1);
                    q = list_push(q, dline);
                    ds = list_push(ds, next_depth);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

pub fn pm_resolve_tree(catalog: String, name: String, parent_caps: Int) -> String {
    if pm_name_ok(name) == false {
        return "err name";
    }
    let root: String = resolve_pick(catalog, name, "*");
    if root == "" {
        return "err missing";
    }
    let rcaps: Int = pm_int(rec_field(root, 2));
    if pm_caps_ok(parent_caps, rcaps) == false {
        return "err caps";
    }
    let mut out: String = name + "@" + rec_field(root, 1);
    let mut queue: List[String] = list_new();
    let mut depths: List[Int] = list_new();
    queue = list_push(queue, root);
    depths = list_push(depths, 0);
    let mut head: Int = 0;
    while head < list_len(queue) {
        let cur: String = list_get(queue, head);
        let depth: Int = list_get(depths, head);
        if depth >= 16 {
            return "err depth";
        }
        let expanded: String = tree_expand(
            catalog,
            rec_field(cur, 3),
            parent_caps,
            out,
            queue,
            depths,
            depth + 1
        );
        if str_index_of(expanded, "err ") == 0 {
            return expanded;
        }
        out = expanded;
        head = head + 1;
    }
    return "ok " + out;
}
