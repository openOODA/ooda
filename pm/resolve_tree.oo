// # Package dependency tree resolver
//
// Logline: Solve recursive SemVer dependency trees, prevent capability escalation, and build resolution nodes.
//
// Setup: Imports manifest_parse. Solves deterministic package graph satisfying SemVer and capability bounds.
//
// Beats:
//   1. Check capability rights containment and prevent unauthorized capability escalation.
//   2. Search candidate packages in registry and pick the highest satisfying SemVer release.
//   3. Recursively resolve dependency subtrees with depth limiting and deterministic ordering.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.
import "./manifest_parse.oo";

pub fn pm_validate_capability_escalation(requested_caps: Int, granted_caps: Int) -> Bool {
    let mut req = requested_caps;
    let mut granted = granted_caps;
    let mut bit = 0;
    while bit < 8 {
        let r_bit = req % 2;
        let g_bit = granted % 2;
        if r_bit == 1 && g_bit == 0 {
            return false; // Escalation: requested capability not granted
        }
        req = req / 2;
        granted = granted / 2;
        bit = bit + 1;
    }
    return true;
}

pub fn pm_find_best_candidate(
    registry: List[PmManifest],
    dep: &PmDependency,
    caller_caps: Int
) -> Result[PmManifest, String] {
    let count: Int = list_len(registry);
    let mut i: Int = 0;
    let mut found_match: Bool = false;
    let mut best_manifest: PmManifest = pm_manifest_empty();

    // Check parent does not grant capabilities it lacks
    if pm_validate_capability_escalation(dep.granted_caps, caller_caps) == false {
        return Err("Parent delegates capabilities it does not possess");
    }

    while i < count {
        let cand: PmManifest = list_get(registry, i);
        if cand.name == dep.name && cand.vendor == dep.vendor {
            if pm_semver_satisfies(&cand.version, dep) {
                // Capability escalation check on candidate's own requirements
                if pm_validate_capability_escalation(cand.required_caps, dep.granted_caps) {
                    if found_match == false {
                        best_manifest = cand;
                        found_match = true;
                    } else {
                        // Pick higher SemVer
                        let cmp_ver = pm_semver_compare(&cand.version, &best_manifest.version);
                        if cmp_ver == 1 {
                            best_manifest = cand;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    if found_match == false {
        let dv = dep.vendor;
    let dn = dep.name;
    return Err("No satisfying candidate found for dependency " + dv + "/" + dn);
    }
    return Ok(best_manifest);
}

pub fn pm_resolve_tree(
    root: &PmManifest,
    registry: List[PmManifest],
    max_depth: Int
) -> PmResolveResult {
    let mut out_nodes: List[PmResolveNode] = [];
    let root_node = PmResolveNode {
        name: root.name,
        vendor: root.vendor,
        version: root.version,
        version_str: root.version_str,
        granted_caps: root.required_caps,
        parent_name: "root",
        depth: 0,
    };
    out_nodes = list_push(out_nodes, root_node);

    let mut queue_manifests: List[PmManifest] = [];
    let mut queue_parents: List[String] = [];
    let mut queue_depths: List[Int] = [];

    queue_manifests = list_push(queue_manifests, *root);
    queue_parents = list_push(queue_parents, "root");
    queue_depths = list_push(queue_depths, 0);

    let mut head: Int = 0;
    while head < list_len(queue_manifests) {
        let cur_man: PmManifest = list_get(queue_manifests, head);
        let cur_depth: Int = list_get(queue_depths, head);

        if cur_depth >= max_depth {
            let empty_res: List[PmResolveNode] = [];
            return PmResolveResult {
                success: false,
                error_code: 101,
                error_msg: "Max dependency resolution depth exceeded (possible cycle)",
                nodes: empty_res,
                total_nodes: 0,
            };
        }

        let deps: List[PmDependency] = cur_man.dependencies;
        let n_deps: Int = list_len(deps);
        let mut d_idx: Int = 0;

        while d_idx < n_deps {
            let dep: PmDependency = list_get(deps, d_idx);
            let cand_res = pm_find_best_candidate(registry, &dep, cur_man.required_caps);
            let cand: PmManifest = match cand_res {
                Ok(c) => c,
                Err(e) => {
                    let empty_res: List[PmResolveNode] = [];
                    return PmResolveResult {
                        success: false,
                        error_code: 102,
                        error_msg: e,
                        nodes: empty_res,
                        total_nodes: 0,
                    };
                }
            };

            let node = PmResolveNode {
                name: cand.name,
                vendor: cand.vendor,
                version: cand.version,
                version_str: cand.version_str,
                granted_caps: dep.granted_caps,
                parent_name: cur_man.name,
                depth: cur_depth + 1,
            };
            out_nodes = list_push(out_nodes, node);

            queue_manifests = list_push(queue_manifests, cand);
            queue_parents = list_push(queue_parents, cur_man.name);
            queue_depths = list_push(queue_depths, cur_depth + 1);

            d_idx = d_idx + 1;
        }

        head = head + 1;
    }

    return PmResolveResult {
        success: true,
        error_code: 0,
        error_msg: "",
        nodes: out_nodes,
        total_nodes: list_len(out_nodes),
    };
}