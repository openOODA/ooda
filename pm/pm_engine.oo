// # Lock engine
//
// Logline: Hash sorted name@version#sha256#CapName lock lines and write them only through helpers.
//
// Setup: Imports pm_lock. crypto_sha256_internal. No hard-coded hex. Proofs hash in memory.
//
// Beats:
//   1. Hash lock text after sorting the lines.
//   2. Same payload matches; a tampered checksum does not.
//   3. CLI writes .ooda_modules/lock only via pm_engine_write_lock.

import "pm_lock.oo";

pub fn pm_engine_lock_hash(entries: String) -> String {
    return pm_lock_digest(entries);
}

pub fn pm_engine_lock_ok(a: String, b: String) -> Bool {
    return pm_lock_match(a, b);
}

pub fn pm_engine_write_lock(sys: &SysCap, root: String, text: String) -> Result[Bool, String] {
    return pm_lock_write_cli(sys, root, text);
}

pub fn pm_engine_write_lock_fs(fs: &FsCap, root: String, text: String) -> Result[Bool, String] {
    return pm_lock_write_text(fs, root, text);
}

pub fn pm_engine_lock_unit() -> Bool {
    if pm_lock_unit_match() == false {
        return false;
    }
    if pm_lock_unit_tamper() == false {
        return false;
    }
    if pm_lock_unit_order() == false {
        return false;
    }
    return true;
}


