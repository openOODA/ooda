// # Native LSP stdio JSON-RPC loop
//
// Logline: Reads Content-Length or JSON-object frames from a buffer and replies until shutdown.
//
// Setup: Uses lsp_jsonrpc framing and lsp_server dispatch. Stdin is oo_read_stdin.
//
// Beats:
//   1. Skip whitespace and take one Content-Length frame or one JSON object.
//   2. Dispatch each body and append framed replies.
//   3. Stop on shutdown, exit, empty input, or 256 messages.
//
// residual: not a live editor incremental reader; batch stdin or file.

import "lsp_types.oo";
import "lsp_jsonrpc.oo";
import "lsp_server.oo";

fn lsp_skip_ws(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
        } else {
            return i;
        }
    }
    return i;
}

fn lsp_take_json_object(s: String) -> LspFrame {
    let n: Int = chars_len(s);
    if n == 0 {
        return lsp_frame_none();
    }
    if char_at(s, 0) != "{" {
        return lsp_frame_none();
    }
    let mut depth: Int = 0;
    let mut i: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc {
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return lsp_frame_take(str_slice(s, 0, i + 1), str_slice(s, i + 1, n));
            }
        }
        i = i + 1;
    }
    return lsp_frame_none();
}

pub fn lsp_jsonrpc_take_message(buf: String) -> LspFrame {
    let n: Int = chars_len(buf);
    let i: Int = lsp_skip_ws(buf);
    if i >= n {
        return lsp_frame_none();
    }
    let tail: String = str_slice(buf, i, n);
    if str_starts_with(tail, "Content-Length:") {
        let clen: Int = lsp_jsonrpc_parse_content_length(tail);
        let crlf: Int = str_index_of(tail, "\r\n\r\n");
        let lf: Int = str_index_of(tail, "\n\n");
        let mut sep: Int = 0 - 1;
        let mut sepn: Int = 0;
        if crlf >= 0 {
            sep = crlf;
            sepn = 4;
        }
        if lf >= 0 {
            if sep < 0 || lf < sep {
                sep = lf;
                sepn = 2;
            }
        }
        if sep < 0 {
            return lsp_frame_none();
        }
        let start: Int = sep + sepn;
        let tlen: Int = chars_len(tail);
        if clen < 1 {
            return lsp_frame_none();
        }
        if start + clen > tlen {
            return lsp_frame_none();
        }
        return lsp_frame_take(str_slice(tail, start, start + clen), str_slice(tail, start + clen, tlen));
    }
    return lsp_take_json_object(tail);
}

pub fn lsp_server_process_stream(raw: String) -> String {
    let mut buf: String = raw;
    let mut out: String = "";
    let mut n: Int = 0;
    while n < 256 {
        n = n + 1;
        let fr: LspFrame = lsp_jsonrpc_take_message(buf);
        if !lsp_frame_is_ok(&fr) {
            return out;
        }
        buf = lsp_frame_rest(&fr);
        let f_body: String = lsp_frame_body(&fr);
        if chars_len(f_body) == 0 {
            continue;
        }
        let resp: String = lsp_server_process_message(f_body);
        if chars_len(resp) > 0 {
            out = out + resp;
        }
        let method: String = lsp_jsonrpc_extract_method(f_body);
        if method == "shutdown" || method == "exit" {
            return out;
        }
    }
    return out;
}

pub fn lsp_serve() {
    let raw: String = oo_read_stdin();
    let out: String = lsp_server_process_stream(raw);
    println(out);
}
