// # Native LSP Code Completion Engine
//
// Logline: Computes autocomplete suggestions for keywords, capabilities, builtin types, and standard library routines.
//
// Setup: Imports lsp_types.oo for completion item structures and kind enumerations.
//
// Beats:
//   1. Maintain lookup catalogs of keywords, capabilities, types, and standard library functions.
//   2. Filter suggestions by symbol prefix matching.
//   3. Construct completion items with detailed type and capability metadata.
//   4. Serialize completion result sets to JSON array structures.

import "lsp_types.oo";

pub fn lsp_comp_kind_keyword() -> Int { return 14; }
pub fn lsp_comp_kind_function() -> Int { return 3; }
pub fn lsp_comp_kind_capability() -> Int { return 25; }
pub fn lsp_comp_kind_type() -> Int { return 7; }
pub fn lsp_comp_kind_snippet() -> Int { return 15; }

pub fn lsp_comp_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn lsp_completion_item_to_json(label: String, kind: Int, detail: String, doc: String, ins: String) -> String {
    let esc_label: String = lsp_comp_escape(label);
    let esc_detail: String = lsp_comp_escape(detail);
    let esc_doc: String = lsp_comp_escape(doc);
    let esc_ins: String = lsp_comp_escape(ins);
    let kind_str: String = kind.to_string();

    return "{\"label\":\"" + esc_label + "\",\"kind\":" + kind_str + ",\"detail\":\"" + esc_detail + "\",\"documentation\":\"" + esc_doc + "\",\"insertText\":\"" + esc_ins + "\"}";
}

pub fn lsp_completions_to_json(items: List[String]) -> String {
    let n: Int = list_len(items);
    let mut body: String = "";
    let mut i: Int = 0;
    while i < n {
        let it_json: String = list_get(items, i);
        if i > 0 {
            body = body + ",";
        }
        body = body + it_json;
        i = i + 1;
    }
    return "{\"isIncomplete\":false,\"items\":[" + body + "]}";
}

pub fn lsp_str_starts_with(s: String, prefix: String) -> Bool {
    let slen: Int = chars_len(s);
    let plen: Int = chars_len(prefix);
    if plen == 0 {
        return true;
    }
    if slen < plen {
        return false;
    }
    let mut i: Int = 0;
    while i < plen {
        if char_at(s, i) != char_at(prefix, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn lsp_completion_resolve(prefix: String) -> List[String] {
    let mut out: List[String] = list_new();

    // Capabilities (kind 25)
    let kcap: Int = 25;
    if lsp_str_starts_with("&FsCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&FsCap", kcap, "Capability", "Full filesystem read/write capability.", "&FsCap"));
    }
    if lsp_str_starts_with("&FsReadCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&FsReadCap", kcap, "Capability", "Read-only filesystem capability.", "&FsReadCap"));
    }
    if lsp_str_starts_with("&FsWriteCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&FsWriteCap", kcap, "Capability", "Write-only filesystem capability.", "&FsWriteCap"));
    }
    if lsp_str_starts_with("&SysCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&SysCap", kcap, "Capability", "System command execution capability.", "&SysCap"));
    }
    if lsp_str_starts_with("&EnvCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&EnvCap", kcap, "Capability", "Environment variable capability.", "&EnvCap"));
    }
    if lsp_str_starts_with("&NetCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&NetCap", kcap, "Capability", "Network socket capability.", "&NetCap"));
    }
    if lsp_str_starts_with("&TimeCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&TimeCap", kcap, "Capability", "System timer capability.", "&TimeCap"));
    }
    if lsp_str_starts_with("&RandCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&RandCap", kcap, "Capability", "Random entropy capability.", "&RandCap"));
    }
    if lsp_str_starts_with("&AllocCap", prefix) {
        out = list_push(out, lsp_completion_item_to_json("&AllocCap", kcap, "Capability", "Memory allocator capability.", "&AllocCap"));
    }

    // Keywords (kind 14)
    let kkw: Int = 14;
    if lsp_str_starts_with("fn", prefix) {
        out = list_push(out, lsp_completion_item_to_json("fn", kkw, "Keyword", "Declare a function.", "fn "));
    }
    if lsp_str_starts_with("pub", prefix) {
        out = list_push(out, lsp_completion_item_to_json("pub", kkw, "Keyword", "Export public visibility.", "pub "));
    }
    if lsp_str_starts_with("let", prefix) {
        out = list_push(out, lsp_completion_item_to_json("let", kkw, "Keyword", "Declare immutable binding.", "let "));
    }
    if lsp_str_starts_with("mut", prefix) {
        out = list_push(out, lsp_completion_item_to_json("mut", kkw, "Keyword", "Mutable binding modifier.", "mut "));
    }
    if lsp_str_starts_with("struct", prefix) {
        out = list_push(out, lsp_completion_item_to_json("struct", kkw, "Keyword", "Define struct record.", "struct "));
    }
    if lsp_str_starts_with("type", prefix) {
        out = list_push(out, lsp_completion_item_to_json("type", kkw, "Keyword", "Define type alias.", "type "));
    }
    if lsp_str_starts_with("import", prefix) {
        out = list_push(out, lsp_completion_item_to_json("import", kkw, "Keyword", "Import module.", "import "));
    }
    if lsp_str_starts_with("match", prefix) {
        out = list_push(out, lsp_completion_item_to_json("match", kkw, "Keyword", "Pattern match.", "match "));
    }
    if lsp_str_starts_with("if", prefix) {
        out = list_push(out, lsp_completion_item_to_json("if", kkw, "Keyword", "Conditional branch.", "if "));
    }
    if lsp_str_starts_with("else", prefix) {
        out = list_push(out, lsp_completion_item_to_json("else", kkw, "Keyword", "Else branch.", "else "));
    }
    if lsp_str_starts_with("while", prefix) {
        out = list_push(out, lsp_completion_item_to_json("while", kkw, "Keyword", "While loop.", "while "));
    }
    if lsp_str_starts_with("return", prefix) {
        out = list_push(out, lsp_completion_item_to_json("return", kkw, "Keyword", "Return value.", "return "));
    }
    if lsp_str_starts_with("verify", prefix) {
        out = list_push(out, lsp_completion_item_to_json("verify", kkw, "Keyword", "Formal proof block.", "verify "));
    }

    // Builtins (kind 3) and Types (kind 7)
    let kfn: Int = 3;
    let kty: Int = 7;
    if lsp_str_starts_with("Int", prefix) {
        out = list_push(out, lsp_completion_item_to_json("Int", kty, "Type", "Signed 64-bit integer.", "Int"));
    }
    if lsp_str_starts_with("String", prefix) {
        out = list_push(out, lsp_completion_item_to_json("String", kty, "Type", "UTF-8 string.", "String"));
    }
    if lsp_str_starts_with("Bool", prefix) {
        out = list_push(out, lsp_completion_item_to_json("Bool", kty, "Type", "Boolean type.", "Bool"));
    }
    if lsp_str_starts_with("List", prefix) {
        out = list_push(out, lsp_completion_item_to_json("List", kty, "Type", "Dynamic array container.", "List["));
    }
    if lsp_str_starts_with("Result", prefix) {
        out = list_push(out, lsp_completion_item_to_json("Result", kty, "Type", "Result monad.", "Result["));
    }
    if lsp_str_starts_with("println", prefix) {
        out = list_push(out, lsp_completion_item_to_json("println", kfn, "Builtin", "Print string to stdout.", "println("));
    }
    if lsp_str_starts_with("read_file", prefix) {
        out = list_push(out, lsp_completion_item_to_json("read_file", kfn, "Builtin", "Read file contents.", "read_file("));
    }
    if lsp_str_starts_with("write_file", prefix) {
        out = list_push(out, lsp_completion_item_to_json("write_file", kfn, "Builtin", "Write to file.", "write_file("));
    }

    return out;
}
