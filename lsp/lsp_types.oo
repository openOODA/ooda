// # Language Server Protocol Data Types
//
// Logline: Defines core protocol data structures for positions, ranges, diagnostics, completions, and server state.
//
// Setup: Pure record definitions and structural constructor functions for LSP entities.
//
// Beats:
//   1. Declare positional, range, and diagnostic structures.
//   2. Declare completion, hover, request, and response records.
//   3. Declare server lifecycle state model.
//   4. Implement type constructors and initialization routines.

type LspPosition = struct {
    line: Int,
    col: Int
};

type LspRange = struct {
    start_line: Int,
    start_col: Int,
    end_line: Int,
    end_col: Int
};

type LspDiagnostic = struct {
    start_line: Int,
    start_col: Int,
    end_line: Int,
    end_col: Int,
    severity: Int,
    code: String,
    message: String,
    source: String
};

type LspCompletionItem = struct {
    label: String,
    kind: Int,
    detail: String,
    documentation: String,
    insert_text: String
};

type LspHover = struct {
    contents: String,
    start_line: Int,
    start_col: Int,
    end_line: Int,
    end_col: Int
};

type LspRequest = struct {
    id: String,
    method: String,
    params: String
};

type LspResponse = struct {
    id: String,
    result: String,
    error_code: Int,
    error_msg: String,
    is_error: Bool
};

type LspServerState = struct {
    is_initialized: Bool,
    is_shutdown: Bool,
    root_uri: String,
    open_docs_count: Int,
    total_requests: Int
};

type LspFrame = struct {
    body: String,
    rest: String,
    ok: Bool
};

type LspCodeAction = struct {
    title: String,
    kind: String,
    edit: String
};

pub fn lsp_position_new(line: Int, col: Int) -> LspPosition {
    return LspPosition {
        line: line,
        col: col
    };
}

pub fn lsp_range_new(sl: Int, sc: Int, el: Int, ec: Int) -> LspRange {
    return LspRange {
        start_line: sl,
        start_col: sc,
        end_line: el,
        end_col: ec
    };
}

pub fn lsp_diagnostic_new(sl: Int, sc: Int, el: Int, ec: Int, sev: Int, code: String, msg: String, src: String) -> LspDiagnostic {
    return LspDiagnostic {
        start_line: sl,
        start_col: sc,
        end_line: el,
        end_col: ec,
        severity: sev,
        code: code,
        message: msg,
        source: src
    };
}

pub fn lsp_completion_item_new(label: String, kind: Int, detail: String, doc: String, ins: String) -> LspCompletionItem {
    return LspCompletionItem {
        label: label,
        kind: kind,
        detail: detail,
        documentation: doc,
        insert_text: ins
    };
}

pub fn lsp_hover_new(contents: String, sl: Int, sc: Int, el: Int, ec: Int) -> LspHover {
    return LspHover {
        contents: contents,
        start_line: sl,
        start_col: sc,
        end_line: el,
        end_col: ec
    };
}

pub fn lsp_request_new(id: String, method: String, params: String) -> LspRequest {
    return LspRequest {
        id: id,
        method: method,
        params: params
    };
}

pub fn lsp_response_ok(id: String, result: String) -> LspResponse {
    return LspResponse {
        id: id,
        result: result,
        error_code: 0,
        error_msg: "",
        is_error: false
    };
}

pub fn lsp_response_err(id: String, code: Int, msg: String) -> LspResponse {
    return LspResponse {
        id: id,
        result: "null",
        error_code: code,
        error_msg: msg,
        is_error: true
    };
}

pub fn lsp_server_state_new() -> LspServerState {
    return LspServerState {
        is_initialized: false,
        is_shutdown: false,
        root_uri: "",
        open_docs_count: 0,
        total_requests: 0
    };
}

pub fn lsp_frame_none() -> LspFrame {
    return LspFrame {
        body: "",
        rest: "",
        ok: false
    };
}

pub fn lsp_frame_take(body: String, rest: String) -> LspFrame {
    return LspFrame {
        body: body,
        rest: rest,
        ok: true
    };
}

pub fn lsp_frame_body(fr: &LspFrame) -> String {
    return fr.body;
}

pub fn lsp_frame_rest(fr: &LspFrame) -> String {
    return fr.rest;
}

pub fn lsp_frame_is_ok(fr: &LspFrame) -> Bool {
    return fr.ok;
}

pub fn lsp_code_action_new(title: String, kind: String, edit: String) -> LspCodeAction {
    return LspCodeAction {
        title: title,
        kind: kind,
        edit: edit
    };
}

pub fn lsp_code_action_title(a: &LspCodeAction) -> String {
    return a.title;
}

pub fn lsp_code_action_kind(a: &LspCodeAction) -> String {
    return a.kind;
}

pub fn lsp_code_action_edit(a: &LspCodeAction) -> String {
    return a.edit;
}

pub fn lsp_types_action_new(title: String, kind: String, edit: String) -> LspCodeAction {
    return lsp_code_action_new(title, kind, edit);
}
