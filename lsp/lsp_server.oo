// # Native LSP Server Request Dispatcher
//
// Logline: Manages server lifecycle, capability negotiation, and routes protocol requests to handlers.
//
// Setup: Imports lsp_types, jsonrpc, diagnostics, completion, hover, and code_action modules.
//
// Beats:
//   1. Initialize server state and negotiate LSP protocol capabilities.
//   2. Dispatch initialize, initialized, shutdown, and exit lifecycle events.
//   3. Dispatch completion, hover, definition, code action, and document sync requests.
//   4. Formulate JSON-RPC 2.0 response and notification payloads.

import "lsp/lsp_types.oo";
import "lsp/lsp_jsonrpc.oo";
import "lsp/lsp_diagnostics.oo";
import "lsp/lsp_completion.oo";
import "lsp/lsp_hover.oo";
import "lsp/lsp_code_action.oo";

pub fn lsp_server_capabilities_json() -> String {
    return "{\"capabilities\":{\"textDocumentSync\":1,\"completionProvider\":{\"resolveProvider\":true,\"triggerCharacters\":[\".\",\"&\",\":\"]},\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true}}";
}

pub fn lsp_server_handle_initialize(id: String, root_uri: String) -> String {
    let caps: String = lsp_server_capabilities_json();
    return lsp_jsonrpc_make_response(id, caps);
}

pub fn lsp_server_handle_shutdown(id: String) -> String {
    return lsp_jsonrpc_make_response(id, "null");
}

pub fn lsp_server_handle_completion(id: String, prefix: String) -> String {
    let mut items: List[String] = list_new();
    items = lsp_completion_resolve(prefix);
    let json_items: String = lsp_completions_to_json(items);
    return lsp_jsonrpc_make_response(id, json_items);
}

pub fn lsp_server_handle_hover(id: String, symbol: String, line: Int, col: Int) -> String {
    let h: LspHover = lsp_hover_resolve(symbol, line, col);
    return lsp_hover_response_json(id, h);
}

pub fn lsp_server_handle_definition(id: String, uri: String, line: Int, col: Int) -> String {
    let target_uri: String = if chars_len(uri) > 0 { uri } else { "file:///ooda.oo" };
    let end_col: Int = col + 2;
    let res: String = "{\"uri\":\"" + target_uri + "\",\"range\":{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + col.to_string() + "},\"end\":{\"line\":" + line.to_string() + ",\"character\":" + end_col.to_string() + "}}}";
    return lsp_jsonrpc_make_response(id, res);
}

pub fn lsp_server_handle_code_action(id: String, uri: String, code: String, line: Int, col: Int) -> String {
    let err_code: String = if chars_len(code) > 0 { code } else { "E_CAP" };
    let actions: List[LspCodeAction] = lsp_code_action_resolve(err_code, uri, line, col);
    let json_actions: String = lsp_code_actions_to_json(actions, uri, line, col);
    return lsp_jsonrpc_make_response(id, json_actions);
}

pub fn lsp_server_handle_did_open(uri: String, src: String) -> String {
    let mut diags: List[String] = list_new();
    diags = lsp_parse_compiler_output(src);
    let params: String = lsp_diags_to_publish_json(uri, diags);
    return lsp_jsonrpc_make_notification("textDocument/publishDiagnostics", params);
}

pub fn lsp_server_dispatch_request(method: String, id: String, params: String) -> String {
    if method == "initialize" {
        let uri: String = lsp_jsonrpc_extract_string(params, "rootUri");
        return lsp_server_handle_initialize(id, uri);
    }
    if method == "shutdown" {
        return lsp_server_handle_shutdown(id);
    }
    if method == "textDocument/completion" {
        let pfx: String = lsp_jsonrpc_extract_string(params, "prefix");
        return lsp_server_handle_completion(id, pfx);
    }
    if method == "textDocument/hover" {
        let sym: String = lsp_jsonrpc_extract_string(params, "symbol");
        return lsp_server_handle_hover(id, sym, 0, 0);
    }
    if method == "textDocument/definition" {
        let uri2: String = lsp_jsonrpc_extract_string(params, "uri");
        return lsp_server_handle_definition(id, uri2, 0, 0);
    }
    if method == "textDocument/codeAction" {
        let uri3: String = lsp_jsonrpc_extract_string(params, "uri");
        let code3: String = lsp_jsonrpc_extract_string(params, "code");
        return lsp_server_handle_code_action(id, uri3, code3, 0, 0);
    }
    if method == "textDocument/didOpen" {
        let uri: String = lsp_jsonrpc_extract_string(params, "uri");
        let txt: String = lsp_jsonrpc_extract_string(params, "text");
        return lsp_server_handle_did_open(uri, txt);
    }
    if method == "textDocument/didChange" || method == "initialized" || method == "exit" {
        return "";
    }
    return lsp_jsonrpc_make_error(id, 0 - 32601, "Method not found: " + method);
}

pub fn lsp_server_process_message(raw_body: String) -> String {
    let method: String = lsp_jsonrpc_extract_method(raw_body);
    let id: String = lsp_jsonrpc_extract_id(raw_body);
    let params: String = lsp_jsonrpc_extract_params(raw_body);
    let resp: String = lsp_server_dispatch_request(method, id, params);
    if chars_len(resp) == 0 {
        return "";
    }
    return lsp_jsonrpc_frame(resp);
}
