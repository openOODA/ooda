// # Native LSP Hover Documentation Engine
//
// Logline: Resolves symbol documentation, type signatures, and capability requirements for hover requests.
//
// Setup: Imports lsp_types.oo for hover data structures and range records.
//
// Beats:
//   1. Provide documentation resolution for language keywords and contracts.
//   2. Provide documentation resolution for object capabilities and privilege models.
//   3. Provide documentation resolution for built-in types and standard functions.
//   4. Format resolved documentation into LSP hover JSON responses.

import "lsp_types.oo";

pub fn lsp_hover_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn lsp_hover_lookup(sym: String) -> String {
    if sym == "FsCap" || sym == "&FsCap" {
        return "### &FsCap (Filesystem Capability)\nProvides read and write access to the host filesystem. Required by `read_file`, `write_file`, `path_exists`.";
    }
    if sym == "FsReadCap" || sym == "&FsReadCap" {
        return "### &FsReadCap (Read-Only Filesystem Capability)\nProvides read-only access to filesystem inspection and reads.";
    }
    if sym == "FsWriteCap" || sym == "&FsWriteCap" {
        return "### &FsWriteCap (Write-Only Filesystem Capability)\nProvides write access to filesystem updates and file creation.";
    }
    if sym == "SysCap" || sym == "&SysCap" {
        return "### &SysCap (System Execution Capability)\nAuthorizes subprocess execution and shell commands via `sys_exec`. Default-deny.";
    }
    if sym == "EnvCap" || sym == "&EnvCap" {
        return "### &EnvCap (Environment Capability)\nAuthorizes reading and modifying process environment variables via `env_get` and `env_set`.";
    }
    if sym == "NetCap" || sym == "&NetCap" {
        return "### &NetCap (Network Socket Capability)\nAuthorizes creation and I/O on TCP, UDP, and TLS sockets.";
    }
    if sym == "TimeCap" || sym == "&TimeCap" {
        return "### &TimeCap (Time Capability)\nAuthorizes access to real-time wall clocks and timers via `now_ms` and `sleep_ms`.";
    }
    if sym == "RandCap" || sym == "&RandCap" {
        return "### &RandCap (Random Entropy Capability)\nAuthorizes access to cryptographically secure random number generators.";
    }
    if sym == "AllocCap" || sym == "&AllocCap" {
        return "### &AllocCap (Allocator Capability)\nAuthorizes low-level explicit memory allocation and buffer management.";
    }
    if sym == "ThreadCap" || sym == "&ThreadCap" {
        return "### &ThreadCap (Concurrency Capability)\nAuthorizes spawning background OS threads and actor isolation contexts.";
    }
    if sym == "GpuCap" || sym == "&GpuCap" {
        return "### &GpuCap (GPU Kernel Capability)\nAuthorizes compiling and dispatching kernels to GPU/NPU accelerators.";
    }
    if sym == "UnsafeFFICap" || sym == "&UnsafeFFICap" {
        return "### &UnsafeFFICap (C FFI Capability)\nAuthorizes direct invocations to external dynamic C ABI functions.";
    }
    if sym == "fn" {
        return "### `fn` Keyword\nDeclares a function with typed parameters, capabilities, and return values.";
    }
    if sym == "pub" {
        return "### `pub` Keyword\nExports a function, struct, or type with public module visibility.";
    }
    if sym == "struct" {
        return "### `struct` Keyword\nDefines a structured record type with named, strongly-typed fields.";
    }
    if sym == "type" {
        return "### `type` Keyword\nDeclares a named type alias or struct definition.";
    }
    if sym == "let" {
        return "### `let` Keyword\nBinds an immutable variable within lexical scope.";
    }
    if sym == "mut" {
        return "### `mut` Keyword\nSpecifies that a variable binding or reference is mutable.";
    }
    if sym == "import" {
        return "### `import` Statement\nLoads symbols and definitions from another `.oo` source module.";
    }
    if sym == "match" {
        return "### `match` Expression\nPerforms pattern matching on variants such as `Ok(v)` / `Err(e)`.";
    }
    if sym == "verify" {
        return "### `verify` Block\nSpecifies a formal verification block checked at compile-time.";
    }
    if sym == "requires" {
        return "### `requires` Contract Clause\nSpecifies a precondition that must evaluate to true prior to function body execution.";
    }
    if sym == "ensures" {
        return "### `ensures` Contract Clause\nSpecifies a postcondition guarantee that holds upon function exit.";
    }
    if sym == "println" {
        return "### `println(msg: String)`\nPrints string followed by newline to stdout. Ambience allowed (no cap needed).";
    }
    if sym == "read_file" {
        return "### `read_file(fs: &FsCap, path: String) -> Result[String, String]`\nReads file contents into an owned String result.";
    }
    if sym == "write_file" {
        return "### `write_file(fs: &FsCap, path: String, content: String) -> Result[Int, String]`\nWrites string content to target file path.";
    }
    if sym == "sys_exec" {
        return "### `sys_exec(sys: &SysCap, cmd: String, ...) -> Result[Int, String]`\nExecutes command synchronously using system privilege.";
    }
    if sym == "Int" {
        return "### `Int` Primitive Type\nSigned 64-bit two's complement integer.";
    }
    if sym == "String" {
        return "### `String` Primitive Type\nImmutable, UTF-8 encoded text string.";
    }
    if sym == "Bool" {
        return "### `Bool` Primitive Type\nBoolean logical value (`true` or `false`).";
    }
    if sym == "List" {
        return "### `List[T]` Container Type\nHomogeneous dynamic collection indexed by integer position.";
    }
    if sym == "Result" {
        return "### `Result[T, E]` Monad Type\nEncapsulates either success `Ok(T)` or failure `Err(E)`.";
    }
    return "";
}

pub fn lsp_hover_resolve(symbol: String, line: Int, col: Int) -> LspHover {
    let doc: String = lsp_hover_lookup(symbol);
    let slen: Int = chars_len(symbol);
    return lsp_hover_new(doc, line, col, line, col + slen);
}

pub fn lsp_hover_to_json(h: LspHover) -> String {
    if chars_len(h.contents) == 0 {
        return "null";
    }
    let esc_doc: String = lsp_hover_escape(h.contents);
    let sl = h.start_line;
    let sc = h.start_col;
    let el = h.end_line;
    let ec = h.end_col;
    let sl_str = sl.to_string();
    let sc_str = sc.to_string();
    let el_str = el.to_string();
    let ec_str = ec.to_string();

    return "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + esc_doc + "\"},\"range\":{\"start\":{\"line\":" + sl_str + ",\"character\":" + sc_str + "},\"end\":{\"line\":" + el_str + ",\"character\":" + ec_str + "}}}";
}

pub fn lsp_hover_response_json(id: String, h: LspHover) -> String {
    let res: String = lsp_hover_to_json(h);
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + res + "}";
}
