// # JSON-RPC 2.0 Framing and Codec
//
// Logline: Encodes and decodes JSON-RPC 2.0 messages with Content-Length headers for stream transport.
//
// Setup: Pure string manipulation and JSON-RPC 2.0 envelope framing.
//
// Beats:
//   1. Frame payloads with standard Content-Length headers and delimiters.
//   2. Parse Content-Length header integers and extract payload slices.
//   3. Construct standard JSON-RPC 2.0 success and error response envelopes.
//   4. Extract request IDs, methods, and parameters from JSON payloads.

pub fn lsp_jsonrpc_frame(payload: String) -> String {
    let len: Int = chars_len(payload);
    let len_str: String = len.to_string();
    return "Content-Length: " + len_str + "\r\n\r\n" + payload;
}

pub fn lsp_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10 + 0; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v;
}

pub fn lsp_jsonrpc_parse_content_length(header: String) -> Int {
    let prefix: String = "Content-Length: ";
    let plen: Int = chars_len(prefix);
    let hlen: Int = chars_len(header);
    if hlen < plen {
        return 0;
    }
    let mut i: Int = 0;
    let mut starts_with_prefix: Bool = true;
    while i < plen {
        if char_at(header, i) != char_at(prefix, i) {
            starts_with_prefix = false;
        }
        i = i + 1;
    }
    if !starts_with_prefix {
        return 0;
    }
    let mut val_str: String = "";
    while i < hlen {
        let c: String = char_at(header, i);
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            val_str = val_str + c;
        } else {
            if c != "\r" && c != "\n" && c != " " {
                break;
            }
        }
        i = i + 1;
    }
    if chars_len(val_str) == 0 {
        return 0;
    }
    return lsp_parse_int(val_str);
}

pub fn lsp_jsonrpc_make_response(id: String, result_json: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result_json + "}";
}

pub fn lsp_jsonrpc_make_error(id: String, code: Int, msg: String) -> String {
    let code_str: String = code.to_string();
    let escaped_msg: String = lsp_jsonrpc_escape(msg);
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + code_str + ",\"message\":\"" + escaped_msg + "\"}}";
}

pub fn lsp_jsonrpc_make_notification(method: String, params_json: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params_json + "}";
}

pub fn lsp_jsonrpc_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn lsp_jsonrpc_extract_string(json: String, key: String) -> String {
    let pattern: String = "\"" + key + "\":\"";
    let pat_len: Int = chars_len(pattern);
    let json_len: Int = chars_len(json);
    if json_len <= pat_len {
        return "";
    }
    let mut idx: Int = 0 - 1;
    let mut i: Int = 0;
    while i <= json_len - pat_len {
        let mut match_ok: Bool = true;
        let mut j: Int = 0;
        while j < pat_len {
            if char_at(json, i + j) != char_at(pattern, j) {
                match_ok = false;
            }
            j = j + 1;
        }
        if match_ok {
            idx = i;
            break;
        }
        i = i + 1;
    }
    if idx < 0 {
        return "";
    }
    let start_pos: Int = idx + pat_len;
    let mut end_pos: Int = start_pos;
    while end_pos < json_len {
        let c: String = char_at(json, end_pos);
        if c == "\"" {
            if end_pos > start_pos {
                if char_at(json, end_pos - 1) != "\\" {
                    break;
                }
            } else {
                break;
            }
        }
        end_pos = end_pos + 1;
    }
    return str_slice(json, start_pos, end_pos);
}

pub fn lsp_jsonrpc_extract_id(json: String) -> String {
    let str_id: String = lsp_jsonrpc_extract_string(json, "id");
    if chars_len(str_id) > 0 {
        return "\"" + str_id + "\"";
    }
    let pattern: String = "\"id\":";
    let pat_len: Int = chars_len(pattern);
    let json_len: Int = chars_len(json);
    let mut i: Int = 0;
    while i <= json_len - pat_len {
        let mut match_ok: Bool = true;
        let mut j: Int = 0;
        while j < pat_len {
            if char_at(json, i + j) != char_at(pattern, j) {
                match_ok = false;
            }
            j = j + 1;
        }
        if match_ok {
            let start_pos: Int = i + pat_len;
            let mut end_pos: Int = start_pos;
            while end_pos < json_len {
                let c: String = char_at(json, end_pos);
                if c == "," || c == "}" || c == " " || c == "\n" || c == "\r" {
                    break;
                }
                end_pos = end_pos + 1;
            }
            return str_slice(json, start_pos, end_pos);
        }
        i = i + 1;
    }
    return "0";
}

pub fn lsp_jsonrpc_extract_method(json: String) -> String {
    return lsp_jsonrpc_extract_string(json, "method");
}

pub fn lsp_jsonrpc_extract_params(json: String) -> String {
    let pattern: String = "\"params\":";
    let pat_len: Int = chars_len(pattern);
    let json_len: Int = chars_len(json);
    let mut i: Int = 0;
    while i <= json_len - pat_len {
        let mut match_ok: Bool = true;
        let mut j: Int = 0;
        while j < pat_len {
            if char_at(json, i + j) != char_at(pattern, j) {
                match_ok = false;
            }
            j = j + 1;
        }
        if match_ok {
            let start_pos: Int = i + pat_len;
            let mut end_pos: Int = json_len;
            if char_at(json, json_len - 1) == "}" {
                end_pos = json_len - 1;
            }
            return str_slice(json, start_pos, end_pos);
        }
        i = i + 1;
    }
    return "{}";
}
