// # Native LSP Diagnostic Publisher
//
// Logline: Transforms compiler diagnostics and token errors into LSP publishDiagnostics notifications.
//
// Setup: Imports lsp_types.oo for diagnostic records and severity definitions.
//
// Beats:
//   1. Map diagnostic codes to standard LSP severity levels.
//   2. Parse compiler tab-separated error lines into structured diagnostics.
//   3. Serialize individual diagnostic structures to JSON format.
//   4. Package file diagnostics into textDocument/publishDiagnostics notifications.

import "lsp_types.oo";

pub fn lsp_diag_severity_error() -> Int {
    return 1;
}

pub fn lsp_diag_severity_warning() -> Int {
    return 2;
}

pub fn lsp_diag_severity_info() -> Int {
    return 3;
}

pub fn lsp_diag_severity_hint() -> Int {
    return 4;
}

pub fn lsp_diag_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + " ";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn lsp_diag_to_json(d: LspDiagnostic) -> String {
    let sl = d.start_line;
    let sc = d.start_col;
    let el = d.end_line;
    let ec = d.end_col;
    let sev = d.severity;
    let sl_str = sl.to_string();
    let sc_str = sc.to_string();
    let el_str = el.to_string();
    let ec_str = ec.to_string();
    let sev_str = sev.to_string();
    let esc_code: String = lsp_diag_escape(d.code);
    let esc_msg: String = lsp_diag_escape(d.message);
    let esc_src: String = lsp_diag_escape(d.source);

    return "{\"range\":{\"start\":{\"line\":" + sl_str + ",\"character\":" + sc_str + "},\"end\":{\"line\":" + el_str + ",\"character\":" + ec_str + "}},\"severity\":" + sev_str + ",\"code\":\"" + esc_code + "\",\"source\":\"" + esc_src + "\",\"message\":\"" + esc_msg + "\"}";
}

pub fn lsp_diags_to_publish_json(uri: String, diags: List[String]) -> String {
    let esc_uri: String = lsp_diag_escape(uri);
    let n: Int = list_len(diags);
    let mut arr_body: String = "";
    let mut i: Int = 0;
    while i < n {
        let d_json: String = list_get(diags, i);
        if i > 0 {
            arr_body = arr_body + ",";
        }
        arr_body = arr_body + d_json;
        i = i + 1;
    }
    return "{\"uri\":\"" + esc_uri + "\",\"diagnostics\":[" + arr_body + "]}";
}

pub fn lsp_parse_compiler_err_line(err_line: String) -> String {
    let n: Int = chars_len(err_line);
    let mut parts: List[String] = list_new();
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(err_line, i);
        if c == "\t" {
            parts = list_push(parts, cur);
            cur = "";
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    if chars_len(cur) > 0 {
        parts = list_push(parts, cur);
    }
    let pcount: Int = list_len(parts);
    if pcount >= 3 {
        let kind: String = list_get(parts, 1);
        let full_msg: String = list_get(parts, 2);
        let mut code: String = "E_OTHER";
        if kind == "type" { code = "E_TC"; }
        else if kind == "capability" { code = "E_CAP"; }
        else if kind == "parse" { code = "E_PARSE"; }
        else if kind == "lex" { code = "E_LEX"; }
        else if kind == "load" { code = "E_LOAD"; }
        else if kind == "residual" { code = "E_RESIDUAL"; }

        let mut sev: Int = 3;
        if code == "E_CAP" || code == "E_TC" || code == "E_PARSE" || code == "E_LEX" || code == "E_LOAD" || code == "E_BUILD" || code == "E_BACKEND" || code == "E_EMIT" {
            sev = 1;
        } else if code == "E_RESIDUAL" || code == "E_CONTRACT" || code == "E_SECRET" || code == "E_MAX_CYCLES" {
            sev = 2;
        }
        let d: LspDiagnostic = lsp_diagnostic_new(0, 0, 0, 80, sev, code, full_msg, "oodac");
        return lsp_diag_to_json(d);
    }
    let d2: LspDiagnostic = lsp_diagnostic_new(0, 0, 0, 80, 1, "E_CHECK", err_line, "oodac");
    return lsp_diag_to_json(d2);
}

pub fn lsp_parse_compiler_output(output: String) -> List[String] {
    let mut diags: List[String] = list_new();
    let n: Int = chars_len(output);
    let mut cur_line: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(output, i);
        if c == "\n" {
            if chars_len(cur_line) > 0 {
                let d_json: String = lsp_parse_compiler_err_line(cur_line);
                diags = list_push(diags, d_json);
                cur_line = "";
            }
        } else {
            if c != "\r" {
                cur_line = cur_line + c;
            }
        }
        i = i + 1;
    }
    if chars_len(cur_line) > 0 {
        let d_json: String = lsp_parse_compiler_err_line(cur_line);
        diags = list_push(diags, d_json);
    }
    return diags;
}
