// # Native Language Server Protocol Facade
//
// Logline: Unified entrypoint and public interface for the openOODA native Language Server Protocol engine.
//
// Setup: Re-exports types, jsonrpc framing, diagnostics, completions, hover, and server dispatchers.
//
// Beats:
//   1. Import core protocol subsystems and state machine modules.
//   2. Expose high-level lifecycle, framing, and dispatch entrypoints.
//   3. Expose query APIs for diagnostics, completions, and hover documentation.
//   4. Provide engine verification markers and version reporting.

import "lsp_types.oo";
import "lsp_jsonrpc.oo";
import "lsp_diagnostics.oo";
import "lsp_completion.oo";
import "lsp_hover.oo";
import "lsp_server.oo";

pub fn lsp_engine_init() -> LspServerState {
    return lsp_server_state_new();
}

pub fn lsp_frame_message(payload: String) -> String {
    return lsp_jsonrpc_frame(payload);
}

pub fn lsp_process_message(raw_body: String) -> String {
    return lsp_server_process_message(raw_body);
}

pub fn lsp_query_completion(prefix: String) -> String {
    let mut items: List[String] = list_new();
    items = lsp_completion_resolve(prefix);
    return lsp_completions_to_json(items);
}

pub fn lsp_query_hover(symbol: String, line: Int, col: Int) -> String {
    let h: LspHover = lsp_hover_resolve(symbol, line, col);
    return lsp_hover_to_json(h);
}

pub fn lsp_publish_diagnostics(uri: String, compiler_output: String) -> String {
    let mut diags: List[String] = list_new();
    diags = lsp_parse_compiler_output(compiler_output);
    return lsp_diags_to_publish_json(uri, diags);
}

pub fn lsp_version() -> String {
    return "0.191.0-alpha";
}

pub fn shim_marker_lsp_server() -> Bool {
    let resp: String = lsp_server_handle_initialize("1", "file:///workspace");
    return chars_len(resp) > 0;
}

pub fn shim_marker_lsp_completion() -> Int {
    let mut items: List[String] = list_new();
    items = lsp_completion_resolve("&Fs");
    return list_len(items);
}

pub fn shim_marker_lsp_hover() -> Bool {
    let h: LspHover = lsp_hover_resolve("FsCap", 0, 0);
    return chars_len(h.contents) > 0;
}

pub fn shim_marker_lsp_diagnostics() -> Int {
    let mut diags: List[String] = list_new();
    diags = lsp_parse_compiler_output("ERR\ttype\tType mismatch at 10:5: expected Int");
    return list_len(diags);
}
