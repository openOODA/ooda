// # LSP Code Action and Quick-Fix Engine
//
// Logline: Generates automated quick-fix transformations and code action envelopes from diagnostic errors.
//
// Setup: Maps openOODA compiler diagnostics to one-click repair operations.
//
// Beats:
//   1. Resolve diagnostic error codes (E_CAP, E_PARSE, E_IMP, E_MUST, E_TC).
//   2. Formulate corresponding code action titles and edits.
//   3. Serialize CodeAction results to JSON-RPC 2.0 payloads.

import "lsp/lsp_types.oo";

pub fn lsp_code_action_resolve(code: String, uri: String, line: Int, col: Int) -> List[LspCodeAction] {
    let mut actions: List[LspCodeAction] = list_new();

    if code == "E_CAP" {
        let title: String = "Fix: Add required &Cap parameter";
        let edit: String = "&SysCap";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    } else if code == "E_PARSE" {
        let title: String = "Fix: Insert missing closing brace";
        let edit: String = "}";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    } else if code == "E_IMP" {
        let title: String = "Fix: Insert missing import statement";
        let edit: String = "import \"std/result.oo\";";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    } else if code == "E_MUST" {
        let title: String = "Fix: Handle Result with match let";
        let edit: String = "match let r = ";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    } else if code == "E_TC" {
        let title: String = "Fix: Add let binding";
        let edit: String = "let ";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    } else {
        let title: String = "Fix: Apply standard openOODA repair";
        let edit: String = "";
        actions = list_push(actions, lsp_code_action_new(title, "quickfix", edit));
    }

    return actions;
}

pub fn lsp_code_action_to_json(action: &LspCodeAction, uri: String, line: Int, col: Int) -> String {
    let ttl: String = lsp_code_action_title(action);
    let knd: String = lsp_code_action_kind(action);
    let edt: String = lsp_code_action_edit(action);
    let mut out: String = "{\"title\":\"" + ttl + "\",\"kind\":\"" + knd + "\",";
    out = out + "\"isPreferred\":true,";
    out = out + "\"edit\":{\"changes\":{\"" + uri + "\":[";
    out = out + "{\"range\":{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + col.to_string() + "},";
    out = out + "\"end\":{\"line\":" + line.to_string() + ",\"character\":" + col.to_string() + "}},";
    out = out + "\"newText\":\"" + edt + "\"}]}}}";
    return out;
}

pub fn lsp_code_actions_to_json(actions: List[LspCodeAction], uri: String, line: Int, col: Int) -> String {
    let mut out: String = "[";
    let n: Int = list_len(actions);
    let mut i: Int = 0;
    while i < n {
        if i > 0 {
            out = out + ",";
        }
        let act: LspCodeAction = list_get(actions, i);
        out = out + lsp_code_action_to_json(&act, uri, line, col);
        i = i + 1;
    }
    out = out + "]";
    return out;
}
