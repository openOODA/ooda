// ===================================================================
// Self-Hosted openOODA Lexer & Tokenizer prototype in OODA (.oo)
// ===================================================================

pub fn tokenize_keyword(word: String) -> String
    requires word.len() > 0
    ensures result.len() > 0
{
    return match word {
        "fn"       => "KEYWORD_FN",
        "pub"      => "KEYWORD_PUB",
        "requires" => "KEYWORD_REQUIRES",
        "ensures"  => "KEYWORD_ENSURES",
        "verify"   => "KEYWORD_VERIFY",
        _          => "IDENTIFIER",
    };
}

verify tokenize_keyword {
    assert_eq!(tokenize_keyword("fn"), "KEYWORD_FN");
    assert_eq!(tokenize_keyword("requires"), "KEYWORD_REQUIRES");
    assert_eq!(tokenize_keyword("my_var"), "IDENTIFIER");
}

pub fn main() {
    println("Tokenizing 'fn':       ", tokenize_keyword("fn"));
    println("Tokenizing 'requires': ", tokenize_keyword("requires"));
    println("Tokenizing 'my_var':   ", tokenize_keyword("my_var"));
}
