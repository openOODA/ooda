// ===================================================================
// Design by Contract & Refinement Types in OODA (.oo)
// ===================================================================
// Note: `type Port = Int where …` is fail-closed (not implemented).
// Use requires / ensures for enforceable contracts today.

pub fn divide(a: Float, b: Float) -> Float
    requires b != 0.0
    ensures result * b == a
{
    return a / b;
}

verify divide {
    assert_eq!(divide(10.0, 2.0), 5.0);
    assert_eq!(divide(9.0, 3.0), 3.0);
}
