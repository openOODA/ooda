// ===================================================================
// Design by Contract & Refinement Types in OODA (.oo)
// ===================================================================

type Port = Int where 1..=65535;

pub fn divide(a: Float, b: Float) -> Result[Float, String]
    requires b != 0.0
    ensures match result {
        Ok(val) => val * b == a,
        Err(_)  => true,
    }
{
    if b == 0.0 {
        return Err("Division by zero");
    }
    return Ok(a / b);
}

verify divide {
    assert_eq!(divide(10.0, 2.0), Ok(5.0));
    assert_is_err!(divide(5.0, 0.0));
}
