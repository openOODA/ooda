// ===================================================================
// Capability-Based Security in OODA (.oo)
// ===================================================================

// Pure function: CANNOT access network or file system
pub fn sanitize_username(raw: String) -> String {
    return raw.trim().to_lowercase();
}

// Security-Sensitive Function: Requires explicit NetCap handle
pub fn fetch_user_profile(net: &NetCap, user_id: u64) -> Result[String, String] {
    let url = "https://api.example.com/users/" + user_id.to_string();
    let response = net.get(url)?;
    return Ok(response.body);
}

// Security-Sensitive Function: Requires explicit FsCap handle
pub fn log_event(fs: &FsCap, message: String) -> Result[Void, String] {
    fs.write_file("app.log", message)?;
    return Ok(());
}
