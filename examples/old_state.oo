// Postcondition state snapshotting via `old(x)` (v0.27.0+).
//
// `old(x)` captures the value of parameter `x` at function entry.
// In an `ensures` clause, `result == old(x) + 1` is a contract:
//   "the return value equals the input plus one".
//
// This file exercises:
//   1. `old(x)` reads the entry-time value, not the current value.
//   2. Multiple `old()` reads in one `ensures` clause (via a
//      `match` against a `Result`).
//   3. `verify` blocks immediately after each function.

pub fn increment(x: Int) -> Int
    requires x >= 0
    ensures result == old(x) + 1
{
    return x + 1;
}

verify increment {
    assert_eq!(increment(0), 1);
    assert_eq!(increment(99), 100);
}

pub fn swap_in_place(a: Int, b: Int) -> Result[Int, String]
    requires a >= 0
    requires b >= 0
    ensures match result {
        Ok(v) => v == old(a) + old(b),
        Err(_) => true,
    }
{
    if b > 100 {
        return Err("b too large");
    }
    return Ok(a + b);
}

verify swap_in_place {
    let r = swap_in_place(10, 20);
    assert_eq!(r.is_ok(), true);
    if r.is_ok() {
        let v = match r { Ok(v) => v, Err(_) => 0 };
        assert_eq!(v, 30);
    }
    let r2 = swap_in_place(1, 200);
    assert_eq!(r2.is_err(), true);
}

pub fn main() {
    let r1 = increment(41);
    println(r1);

    let r2 = swap_in_place(3, 4);
    if r2.is_ok() {
        println(7);
    } else {
        println(0);
    }
}