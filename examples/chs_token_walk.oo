// M0 integration golden: read a path from argv, walk characters, emit kind tags.
// Usage: ooda run examples/chs_token_walk.oo -- /path/to/source.oo
//
// Token kinds (int tags): 1=alpha, 2=digit, 3=space, 0=other
// Not a full lexer — proves FS + List + string walk + argv for CHS bootstrap.

pub fn main(fs: &FsCap, args: List[String]) {
    if list_len(args) < 1 {
        println("usage: ooda run chs_token_walk.oo -- <path>");
        return;
    }
    let path = list_get(args, 0);
    let content_r = read_file(path);
    if content_r.is_err() {
        let e = match content_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println(e);
        return;
    }
    let src = match content_r {
        Ok(s) => s,
        Err(msg) => msg,
    };
    let n = chars_len(src);
    let mut i = 0;
    let mut kinds = list_new();
    while i < n {
        let ch = char_at(src, i);
        let k = if char_is_alpha(ch) {
            1
        } else if char_is_digit(ch) {
            2
        } else if char_is_space(ch) {
            3
        } else {
            0
        };
        kinds = list_push(kinds, k);
        i = i + 1;
    }
    println(list_len(kinds));
    if list_len(kinds) > 0 {
        println(list_get(kinds, 0));
    }
}
