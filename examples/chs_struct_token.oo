// M0 CHS: named struct records + field access (arena-friendly Token shape).
type Token = struct {
    kind: Int,
    line: Int,
    col: Int,
    text: String
};

pub fn main() {
    let t = Token { kind: 1, line: 1, col: 1, text: "fn" };
    println(t.kind);
    println(t.line);
    println(t.col);
    println(t.text);
}
