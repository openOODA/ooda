// M0 CHS: real FsCap disk I/O (not std stubs).
pub fn main(fs: &FsCap) {
    let path = "/tmp/ooda_chs_fs_roundtrip.txt";
    let w = write_file(path, "chs-m0-ok");
    if w.is_ok() {
        let r = read_file(path);
        if r.is_ok() {
            let body = match r {
                Ok(s) => s,
                Err(e) => e,
            };
            println(body);
        } else {
            let e = match r {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println(e);
        }
    } else {
        let e = match w {
            Ok(_) => "ok",
            Err(msg) => msg,
        };
        println(e);
    }
}
