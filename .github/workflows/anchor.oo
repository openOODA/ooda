// # .github/workflows — Anchor for Agents
//
// Logline: Front door for the ooda CI gate.
//
// Setup: Sovereign workflow anchor for CI governance locks.
//
// Beats:
//   1. ci.yml runs the 4 governance locks and qa probes.
//   2. Anchors only; no executable code.
//   3. Retain CI workflow references for automated validation.
//   4. Validate gate definitions across release pipelines.
//   5. Expose workflow identifier tags for tooling.

pub fn ooda_ci_workflow_path() -> String {
    return ".github/workflows/ci.yml";
}
