# GBNF Grammar Specification for OODA (.oo) Language
# Enables 100% syntactically valid code generation on 8GB VRAM GPUs (llama.cpp, ollama, vLLM)

root ::= program

program ::= (item)*

item ::= fn_def | struct_def | type_alias

fn_def ::= ("pub ")? "fn " identifier "(" param_list? ")" (" -> " type_name)? contract_spec? block

contract_spec ::= ("\n    requires " expr)* ("\n    ensures " expr)*

param_list ::= param (", " param)*
param ::= identifier ": " ("&")? type_name

type_name ::= "Int" | "Float" | "String" | "Bool" | "NetCap" | "FsCap" | "SysCap" | "EnvCap" | identifier

block ::= " {\n" statement_list "}"

statement_list ::= (statement ";\n")*

statement ::= return_stmt | let_stmt | expr_stmt

return_stmt ::= "return " expr
let_stmt ::= "let " ("mut ")? identifier " = " expr
expr_stmt ::= expr

expr ::= primary_expr

primary_expr ::= identifier | number | string_lit | call_expr

call_expr ::= identifier "(" (expr (", " expr)*)? ")"

identifier ::= [a-zA-Z_][a-zA-Z0-9_]*
number ::= [0-9]+ ("." [0-9]+)?
string_lit ::= "\"" [^"]* "\""
