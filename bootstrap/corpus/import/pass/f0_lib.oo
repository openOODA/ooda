// # Digit-zero helper module
//
// Logline: Exports zero_helper from a module whose name contains digit 0.
//
// Setup: multi_digit0.oo imports this file; 0 must not look like NUL (R2).
//
// Beats:
//   1. Name the module with a digit 0.
//   2. Export zero_helper returning 0.
//   3. Stay importable without a false NUL reject.
//
// multi-import: module name contains digit 0 (R2 false-NUL regression rail)
pub fn zero_helper() -> Int {
    return 0;
}
