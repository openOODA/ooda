// # Import a sibling helper
//
// Logline: Imports lib and typechecks a cross-module call.
//
// Setup: lib.oo exports helper.
//
// Beats:
//   1. Import lib.oo.
//   2. Call helper into an Int.
//   3. Print the value.
//
// multi-file import pass: loads lib.oo and typechecks cross-module call
import "lib.oo";

pub fn main() {
    let x: Int = helper();
    println(x);
}
