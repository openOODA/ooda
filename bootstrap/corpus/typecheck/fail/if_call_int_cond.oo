// # If on an int call
//
// Logline: Uses an Int-returning call as an if condition.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Test if g().
//   3. Fail the non-bool condition.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    if g() {
        println(1);
    }
}
