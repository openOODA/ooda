// # Assign a bool through an Int alias
//
// Logline: Writes true into a mutable T when T is Int.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Alias T to Int.
//   2. Bind mut x: T = 1.
//   3. Assign x = true.

type T = Int;
pub fn main() {
    let mut x: T = 1;
    x = true;
}
