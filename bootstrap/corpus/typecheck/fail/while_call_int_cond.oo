// # Reject Int while condition
//
// Logline: A while condition that is an Int-returning call must fail typecheck.
//
// Setup: while requires Bool; g returns Int.
//
// Beats:
//   1. Define g as Int.
//   2. Write while g().
//   3. Typecheck must reject the condition.

pub fn g() -> Int {
    return 0;
}
pub fn main() {
    while g() {
        break;
    }
}
