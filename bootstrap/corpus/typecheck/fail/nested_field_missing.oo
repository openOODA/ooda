// # Missing nested field
//
// Logline: Reads o.inner.not_a_field.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Take o: Outer.
//   3. Access a field that is not there.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn test_fn(o: Outer) -> Int {
    return o.inner.not_a_field;
}
fn main() -> Int {
    return 0;
}
