// # Reject call return type
//
// Logline: Returning an Int call from a String function must fail typecheck.
//
// Setup: g returns Int; f claims String.
//
// Beats:
//   1. Define g as Int.
//   2. Return g() from f: String.
//   3. Typecheck must reject the call.

pub fn g() -> Int {
    return 1;
}
pub fn f() -> String {
    return g();
}
pub fn main() {}
