// # Reject float mod by zero
//
// Logline: Float literal modulo by zero must fail closed as ERR_DIV0.
//
// Setup: FLOAT lex is on; both operands are 0.0-capable floats.
//
// Beats:
//   1. Write 5.0 % 0.0.
//   2. Typecheck sees a zero divisor.
//   3. The program must fail closed.

pub fn main() {
    let x = 5.0 % 0.0;
}
