// # Reject Int for String ann
//
// Logline: Binding an Int variable to a String annotation must fail typecheck.
//
// Setup: x is inferred Int; y claims String.
//
// Beats:
//   1. Bind x to 1.
//   2. Write let y: String = x.
//   3. Typecheck must reject the init.

pub fn main() {
    let x = 1;
    let y: String = x;
}
