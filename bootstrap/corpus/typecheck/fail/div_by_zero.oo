// # Divide by zero
//
// Logline: Divides 1 / 0 so const integer division fails closed.
//
// Setup: oodac R1 typecheck must reject this program.
//
// Beats:
//   1. Open main.
//   2. Bind x to 1 / 0.
//   3. Fail closed on div0.
//
// Const integer division by zero — oodac R1 must fail-closed.
pub fn main() {
    let x = 1 / 0;
}
