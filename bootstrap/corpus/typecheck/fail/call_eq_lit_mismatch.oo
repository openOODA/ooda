// # Compare an int call to true
//
// Logline: Uses == between an Int call and a bool literal.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Compare g() == true.
//   3. Fail the compare types.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g() == true;
}
