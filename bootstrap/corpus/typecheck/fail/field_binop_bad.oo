// # Add a field to a string
//
// Logline: Adds Point.x to a string literal.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Point with Int fields.
//   2. Bind p.
//   3. Evaluate p.x + "a".

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: 1, y: 2 };
    let s = p.x + "a";
}
