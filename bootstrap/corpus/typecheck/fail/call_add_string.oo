// # Add a call to a string
//
// Logline: Adds an Int call result to a string literal.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Call g() + "a".
//   3. Fail the mixed add.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g() + "a";
}
