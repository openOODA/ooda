// # Annotate a field chain as Outer
//
// Logline: Binds o.inner.v into a let annotated Outer.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Bind a nested struct.
//   3. Annotate the Int field chain as Outer.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn main() -> Int {
    let o = Outer { inner: Inner { v: 1 } };
    let x: Outer = o.inner.v;
    return 0;
}
