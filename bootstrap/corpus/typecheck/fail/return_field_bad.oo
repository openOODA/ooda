// # Reject Int field as String
//
// Logline: Returning Point.x (Int) from a String function must fail typecheck.
//
// Setup: Point.x is Int; g claims String.
//
// Beats:
//   1. Build a Point literal.
//   2. Return p.x from g: String.
//   3. Typecheck must reject the field.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn g() -> String {
    let p = Point { x: 1, y: 2 };
    return p.x;
}
pub fn main() {}
