// # Reject minus on Bool call
//
// Logline: Unary minus on a Bool-returning call must fail typecheck.
//
// Setup: Minus requires a number; g returns Bool.
//
// Beats:
//   1. Define g as Bool.
//   2. Write -g().
//   3. Typecheck must reject the operand.

pub fn g() -> Bool {
    return true;
}
pub fn main() {
    let x = -g();
}
