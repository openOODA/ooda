// # Reject minus on Bool var
//
// Logline: Unary minus on a Bool variable must fail typecheck.
//
// Setup: Minus requires a number; x is inferred Bool.
//
// Beats:
//   1. Bind x to true.
//   2. Write -x.
//   3. Typecheck must reject the operand.

pub fn main() {
    let x = true;
    let y = -x;
}
