// # Match an unbound name
//
// Logline: Uses no_such in an Ok arm so the name is unbound.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Bind r as Ok(1).
//   2. Match Ok to no_such.
//   3. Fail the missing name.

pub fn main() {
    let r: Result[Int, Int] = Ok(1);
    let s = match r {
        Ok(v) => no_such,
        Err(e) => e,
    };
}
