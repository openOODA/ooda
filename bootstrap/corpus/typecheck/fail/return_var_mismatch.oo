// # Reject Int var as String
//
// Logline: Returning an Int local from a String function must fail typecheck.
//
// Setup: x is inferred Int; f claims String.
//
// Beats:
//   1. Bind x to 1.
//   2. Return x from f: String.
//   3. Typecheck must reject the variable.

pub fn f() -> String {
    let x = 1;
    return x;
}
pub fn main() {}
