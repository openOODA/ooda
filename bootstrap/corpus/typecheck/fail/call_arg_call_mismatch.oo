// # Pass an int call as a string
//
// Logline: Feeds g() into f when f wants a String.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Declare f taking String.
//   3. Call f(g()).

pub fn g() -> Int {
    return 1;
}
pub fn f(a: String) {}
pub fn main() {
    f(g());
}
