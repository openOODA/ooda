// # Reject string in Int field
//
// Logline: A Point literal with x: "hi" must fail typecheck.
//
// Setup: Point.x is Int.
//
// Beats:
//   1. Declare Point with Int fields.
//   2. Write x: "hi".
//   3. Typecheck must reject the field init.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: "hi", y: 2 };
}
