// # Assign a string var to a mut int
//
// Logline: Writes a String local into a mutable Int.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Bind mut x: Int = 1.
//   2. Bind y to "a".
//   3. Assign x = y.

pub fn main() {
    let mut x: Int = 1;
    let y = "a";
    x = y;
}
