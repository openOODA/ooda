// # Pass an annotated field as a string
//
// Logline: Passes an annotated Point.x into a String parameter.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Point and f taking String.
//   2. Bind p with a Point annotation.
//   3. Call f(p.x).

type Point = struct {
    x: Int,
    y: Int,
};
pub fn f(a: String) {}
pub fn main() {
    let p: Point = Point { x: 1, y: 2 };
    f(p.x);
}
