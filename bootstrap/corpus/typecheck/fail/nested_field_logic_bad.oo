// # And a nested int field with true
//
// Logline: Uses && between o.inner.v and true.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Take o: Outer.
//   3. Test o.inner.v && true.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn test_fn(o: Outer) -> Int {
    if o.inner.v && true {
        return 1;
    }
    return 0;
}
fn main() -> Int {
    return 0;
}
