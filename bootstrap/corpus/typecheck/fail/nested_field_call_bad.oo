// # Pass a nested field as a string
//
// Logline: Passes o.inner.v into a String parameter.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Inner, Outer, and f taking String.
//   2. Bind a nested struct.
//   3. Call f(o.inner.v).

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
pub fn f(a: String) {}
pub fn main() {
    let o = Outer { inner: Inner { v: 1 } };
    f(o.inner.v);
}
