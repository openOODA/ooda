// # Pass a bound int call as a string
//
// Logline: Binds g() then passes that Int into a String parameter.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int and f taking String.
//   2. Bind x from g().
//   3. Call f(x).

pub fn g() -> Int {
    return 1;
}
pub fn f(a: String) {}
pub fn main() {
    let x = g();
    f(x);
}
