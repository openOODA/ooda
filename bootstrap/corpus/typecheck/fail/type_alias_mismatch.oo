// # Reject Bool for Int alias
//
// Logline: Binding true to a local typed as alias T = Int must fail typecheck.
//
// Setup: T names Int.
//
// Beats:
//   1. Alias T to Int.
//   2. Write let x: T = true.
//   3. Typecheck must reject the Bool init.

pub fn main() {
    type T = Int;
    let x: T = true;
}
