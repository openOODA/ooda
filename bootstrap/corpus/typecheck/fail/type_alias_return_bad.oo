// # Reject Bool for Int alias return
//
// Logline: Returning true from a function typed as alias T = Int must fail typecheck.
//
// Setup: T names Int; f claims T.
//
// Beats:
//   1. Alias T to Int.
//   2. Return true from f.
//   3. Typecheck must reject the Bool.

type T = Int;
pub fn f() -> T {
    return true;
}
pub fn main() {}
