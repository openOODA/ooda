// # Pass two int calls as int and string
//
// Logline: Feeds two Int calls into f(Int, String).
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g and h returning Int.
//   2. Declare f taking Int and String.
//   3. Call f(g(), h()).

pub fn g() -> Int { return 1; }
pub fn h() -> Int { return 2; }
pub fn f(a: Int, b: String) {}
pub fn main() {
    f(g(), h());
}
