// # And an int var with a bool
//
// Logline: Uses && between an Int local and a Bool local.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Bind a to 1.
//   2. Bind b to true.
//   3. Evaluate a && b.

pub fn main() {
    let a = 1;
    let b = true;
    let c = a && b;
}
