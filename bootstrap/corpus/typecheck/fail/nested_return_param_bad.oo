// # Reject nested field return type
//
// Logline: Returning a nested Int field from a String function must fail typecheck.
//
// Setup: Outer.inner.v is Int; g claims String.
//
// Beats:
//   1. Define Inner and Outer structs.
//   2. Return o.inner.v from a String function.
//   3. Typecheck must reject the mismatch.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn g(o: Outer) -> String {
    return o.inner.v;
}
fn main() -> Int {
    return 0;
}
