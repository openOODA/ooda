// # Reject Bool for Int alias param
//
// Logline: Passing true into a parameter typed as alias T = Int must fail typecheck.
//
// Setup: T names Int; f takes T.
//
// Beats:
//   1. Alias T to Int.
//   2. Call f(true).
//   3. Typecheck must reject the Bool argument.

type T = Int;
pub fn f(a: T) {}
pub fn main() {
    f(true);
}
