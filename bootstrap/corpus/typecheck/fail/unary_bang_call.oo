// # Reject bang on Int call
//
// Logline: Logical not on an Int-returning call must fail typecheck.
//
// Setup: Bang requires Bool; g returns Int.
//
// Beats:
//   1. Define g as Int.
//   2. Write !g().
//   3. Typecheck must reject the operand.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = !g();
}
