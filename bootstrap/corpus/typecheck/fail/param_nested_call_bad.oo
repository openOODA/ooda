// # Reject nested field as String arg
//
// Logline: Passing a nested Int field into a String parameter must fail typecheck.
//
// Setup: f wants String; o.inner.v is Int.
//
// Beats:
//   1. Define Inner and Outer structs.
//   2. Call f with o.inner.v.
//   3. Typecheck must reject the argument.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn f(a: String) {}
fn g(o: Outer) {
    f(o.inner.v);
}
fn main() -> Int {
    return 0;
}
