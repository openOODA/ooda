// # Rebind an int call as a string
//
// Logline: Binds g() then assigns that Int into a String annotation.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Bind x from g().
//   3. Bind let y: String = x.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g();
    let y: String = x;
}
