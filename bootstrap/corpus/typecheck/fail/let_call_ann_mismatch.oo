// # Annotate int with a string call
//
// Logline: Binds a String call into a let annotated Int.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning String.
//   2. Bind let x: Int = g().
//   3. Fail the annotation.

pub fn g() -> String {
    return "a";
}
pub fn main() {
    let x: Int = g();
}
