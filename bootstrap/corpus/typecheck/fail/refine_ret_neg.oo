// # Reject negative refined return
//
// Logline: Returning -1 from Int[0..10] must fail closed.
//
// Setup: Refined return is inclusive 0..10; minus-int is out of range.
//
// Beats:
//   1. Declare f as Int[0..10].
//   2. Return -1.
//   3. Typecheck must reject the value.

pub fn f() -> Int[0..10] {
    return -1;
}
pub fn main() {
    let x = f();
}
