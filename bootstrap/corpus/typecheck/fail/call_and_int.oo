// # And an int call with true
//
// Logline: Uses && between an Int call and a bool.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Evaluate g() && true.
//   3. Fail the logic types.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g() && true;
}
