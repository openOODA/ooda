// # Contains with no needle
//
// Logline: Calls contains with no argument so arity fails.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Bind x to "hi".
//   2. Call x.contains().
//   3. Fail the missing needle.

pub fn main() {
    let x = "hi";
    println(x.contains());
}
