// # Field on an int call
//
// Logline: Reads .foo on an Int-returning call.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning Int.
//   2. Access g().foo.
//   3. Fail the field on Int.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    println(g().foo);
}
