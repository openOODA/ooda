// # Compare a string call to an int
//
// Logline: Uses < between a String call and 1.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning String.
//   2. Compare g() < 1.
//   3. Fail the compare types.

pub fn g() -> String {
    return "a";
}
pub fn main() {
    let x = g() < 1;
}
