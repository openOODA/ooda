// # Add a nested field to a string
//
// Logline: Adds o.inner.v to a string literal.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Take o: Outer.
//   3. Return o.inner.v + "a".

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn test_fn(o: Outer) -> Int {
    return o.inner.v + "a";
}
fn main() -> Int {
    return 0;
}
