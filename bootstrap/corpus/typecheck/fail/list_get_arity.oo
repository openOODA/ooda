// # List get with one argument
//
// Logline: Calls list_get with only the list so arity fails.
//
// Setup: list_get expects two arguments.
//
// Beats:
//   1. Bind an empty List[Int].
//   2. Call list_get(xs).
//   3. Fail the missing index.
//
// list_get expects 2 args
pub fn main() {
    let xs: List[Int] = list_new();
    let y = list_get(xs);
}
