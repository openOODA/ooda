// # Wrong argument type
//
// Logline: Passes a string into a function that takes Int.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare f with an Int parameter.
//   2. Call f with "hi".
//   3. Fail the argument type.

pub fn f(a: Int) {}
pub fn main() { f("hi"); }
