// # Reject integer mod by zero
//
// Logline: Constant integer modulo by zero must fail closed as ERR_DIV0.
//
// Setup: Both operands are integer literals.
//
// Beats:
//   1. Write 5 % 0.
//   2. Typecheck sees a zero divisor.
//   3. The program must fail closed.

pub fn main() {
    let x = 5 % 0;
}
