// # Assign through an immutable point
//
// Logline: Writes p.x when p is not mut.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Define Point with Int fields.
//   2. Bind an immutable Point.
//   3. Assign p.x = 3.

type Point = struct {
    x: Int,
    y: Int,
};
fn main() -> Int {
    let p = Point { x: 1, y: 2 };
    p.x = 3;
    return 0;
}
