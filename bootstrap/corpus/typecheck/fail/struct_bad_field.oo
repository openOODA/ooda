// # Reject missing struct field
//
// Logline: Reading Point.z when Point has only x and y must fail typecheck.
//
// Setup: Point defines x and y only.
//
// Beats:
//   1. Build a Point literal.
//   2. Print p.z.
//   3. Typecheck must reject the field.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: 1, y: 2 };
    println(p.z);
}
