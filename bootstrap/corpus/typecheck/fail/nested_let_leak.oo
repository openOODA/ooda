// # Leaked nested let
//
// Logline: Uses x after it is bound only inside an if.
//
// Setup: Nested let must not leak; oodac must fail like stage-0.
//
// Beats:
//   1. Bind x inside if true.
//   2. Print x after the block.
//   3. Fail the leaked name.
//
// Nested let must not leak; oodac must fail like stage-0.
pub fn main() {
    if true {
        let x = 1;
    }
    println(x);
}
