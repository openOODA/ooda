// # Float divide by zero
//
// Logline: Divides 1.0 / 0.0 so float div0 fails closed.
//
// Setup: Requires FLOAT lex plus the div0 check.
//
// Beats:
//   1. Open main.
//   2. Bind x to 1.0 / 0.0.
//   3. Fail closed on float div0.
//
// Float literal /0.0 — requires FLOAT lex + div0 check.
pub fn main() {
    let x = 1.0 / 0.0;
}
