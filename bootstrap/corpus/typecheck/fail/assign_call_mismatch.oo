// # Assign a string to an int
//
// Logline: Assigns a String call result into a mutable Int.
//
// Setup: oodac typecheck must reject this program.
//
// Beats:
//   1. Declare g returning String.
//   2. Bind mut x as Int.
//   3. Assign x from g().

pub fn g() -> String {
    return "a";
}
pub fn main() {
    let mut x: Int = 1;
    x = g();
}
