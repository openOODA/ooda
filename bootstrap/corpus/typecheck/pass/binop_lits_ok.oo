// # Accept homogeneous lit binops
//
// Logline: Same-type literal plus and less-than must typecheck.
//
// Setup: Int+Int, String+String, and Int<Int are product ops.
//
// Beats:
//   1. Add two Ints and two Strings.
//   2. Compare two Ints.
//   3. Typecheck must accept the slice.

pub fn main() {
    let x: Int = 1 + 2;
    let s: String = "a" + "b";
    let b: Bool = 1 < 2;
    println(x);
}
