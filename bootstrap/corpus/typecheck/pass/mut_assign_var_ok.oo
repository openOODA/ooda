// # Accept mut assign from var
//
// Logline: Assigning an Int local into a mut Int must typecheck.
//
// Setup: x is mut Int; y is inferred Int.
//
// Beats:
//   1. Bind mut x and y.
//   2. Store x = y.
//   3. Typecheck must accept the store.

pub fn main() {
    let mut x: Int = 1;
    let y = 2;
    x = y;
    println(x);
}
