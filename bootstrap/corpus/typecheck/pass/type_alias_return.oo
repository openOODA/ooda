// # Accept Int alias return
//
// Logline: Returning 1 from a function typed as alias T = Int must typecheck.
//
// Setup: T names Int.
//
// Beats:
//   1. Alias T to Int.
//   2. Return 1 from f: T.
//   3. Typecheck must accept the value.

type T = Int;
pub fn f() -> T {
    return 1;
}
pub fn main() {
    let x = f();
    println(x);
}
