// # Accept call less-than Int
//
// Logline: Comparing an Int-returning call with less-than must typecheck.
//
// Setup: g returns Int; < on Int is product.
//
// Beats:
//   1. Define g as Int.
//   2. Write g() < 2.
//   3. Typecheck must accept the compare.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g() < 2;
    println(x);
}
