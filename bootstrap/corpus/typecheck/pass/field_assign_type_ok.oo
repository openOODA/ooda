// # Accept Int field assign
//
// Logline: Assigning an Int literal into Point.x must typecheck.
//
// Setup: Point.x is mut Int on a mut Point.
//
// Beats:
//   1. Build a mut Point.
//   2. Store 3 into p.x.
//   3. Typecheck must accept the field store.

type Point = struct {
    x: Int,
    y: Int,
};
fn main() -> Int {
    let mut p = Point { x: 1, y: 2 };
    p.x = 3;
    return 0;
}
