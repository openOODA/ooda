// # Accept Int alias param
//
// Logline: Passing 1 into a parameter typed as alias T = Int must typecheck.
//
// Setup: T names Int.
//
// Beats:
//   1. Alias T to Int.
//   2. Call f(1).
//   3. Typecheck must accept the argument.

type T = Int;
pub fn f(a: T) {
    println(a);
}
pub fn main() {
    f(1);
}
