// # Accept Result match bind
//
// Logline: Matching Result[String, String] and binding both arms must typecheck.
//
// Setup: r is Ok("hi"); both arms yield String.
//
// Beats:
//   1. Build an Ok Result.
//   2. Match Ok(v) and Err(e).
//   3. Typecheck must accept the bind.

pub fn main() {
    let r: Result[String, String] = Ok("hi");
    let s = match r {
        Ok(v) => v,
        Err(e) => e,
    };
    println(s);
}
