// # Accept nested field plus
//
// Logline: Adding one to Outer.inner.v must typecheck.
//
// Setup: Nested field v is Int.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Return o.inner.v + 1.
//   3. Typecheck must accept the binop.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn test_fn(o: Outer) -> Int {
    return o.inner.v + 1;
}
fn main() -> Int {
    return 0;
}
