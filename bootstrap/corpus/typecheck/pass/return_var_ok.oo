// # Accept Int var return
//
// Logline: Returning an Int local from an Int function must typecheck.
//
// Setup: x is inferred Int.
//
// Beats:
//   1. Bind x to 1.
//   2. Return x from f: Int.
//   3. Typecheck must accept the variable.

pub fn f() -> Int {
    let x = 1;
    return x;
}
pub fn main() {
    let y = f();
    println(y);
}
