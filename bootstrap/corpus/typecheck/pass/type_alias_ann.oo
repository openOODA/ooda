// # Accept Int alias annotation
//
// Logline: Binding 1 to a local typed as alias T = Int must typecheck.
//
// Setup: T names Int.
//
// Beats:
//   1. Alias T to Int.
//   2. Write let x: T = 1.
//   3. Typecheck must accept the bind.

type T = Int;
pub fn main() {
    let x: T = 1;
    println(x);
}
