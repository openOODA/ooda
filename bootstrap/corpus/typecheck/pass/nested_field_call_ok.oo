// # Accept nested field as arg
//
// Logline: Passing Outer.inner.v into an Int parameter must typecheck.
//
// Setup: f takes Int; nested v is Int.
//
// Beats:
//   1. Build nested Outer.
//   2. Call f(o.inner.v).
//   3. Typecheck must accept the argument.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
pub fn f(a: Int) {}
pub fn main() {
    let o = Outer { inner: Inner { v: 1 } };
    f(o.inner.v);
}
