// # Accept assign from Int call
//
// Logline: Assigning an Int-returning call to a mut Int must typecheck.
//
// Setup: g returns Int; x is mut Int.
//
// Beats:
//   1. Define g as Int.
//   2. Assign x = g().
//   3. Typecheck must accept the store.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let mut x: Int = 0;
    x = g();
    println(x);
}
