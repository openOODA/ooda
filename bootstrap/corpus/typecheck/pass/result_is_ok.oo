// # Accept Result is_ok
//
// Logline: Calling is_ok on Result[String, String] as an if condition must typecheck.
//
// Setup: r is Ok("hi"); is_ok is Bool.
//
// Beats:
//   1. Build an Ok Result.
//   2. Write if r.is_ok().
//   3. Typecheck must accept the method.

pub fn main() {
    let r: Result[String, String] = Ok("hi");
    if r.is_ok() {
        println("ok");
    }
}
