// # Accept Int field plus
//
// Logline: Adding one to Point.x must typecheck.
//
// Setup: Point.x is Int.
//
// Beats:
//   1. Build a Point.
//   2. Add 1 to p.x.
//   3. Typecheck must accept the binop.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: 1, y: 2 };
    let s = p.x + 1;
}
