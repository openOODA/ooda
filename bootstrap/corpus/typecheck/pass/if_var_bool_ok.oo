// # Accept Bool var in if
//
// Logline: An if condition that is a Bool local must typecheck.
//
// Setup: x is inferred Bool.
//
// Beats:
//   1. Bind x to true.
//   2. Write if x.
//   3. Typecheck must accept the condition.

pub fn main() {
    let x = true;
    if x {
        println(1);
    }
}
