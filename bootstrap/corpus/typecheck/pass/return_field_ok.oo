// # Accept Int field return
//
// Logline: Returning Point.x from an Int function must typecheck.
//
// Setup: Point.x is Int.
//
// Beats:
//   1. Build a Point.
//   2. Return p.x.
//   3. Typecheck must accept the field.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn g() -> Int {
    let p = Point { x: 1, y: 2 };
    return p.x;
}
pub fn main() {}
