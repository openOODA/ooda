// # Accept annotated Int call
//
// Logline: Binding an Int-returning call to let x: Int must typecheck.
//
// Setup: g returns Int.
//
// Beats:
//   1. Define g as Int.
//   2. Write let x: Int = g().
//   3. Typecheck must accept the bind.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x: Int = g();
    println(x);
}
