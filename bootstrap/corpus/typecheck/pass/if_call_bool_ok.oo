// # Accept Bool call in if
//
// Logline: An if condition that is a Bool-returning call must typecheck.
//
// Setup: g returns Bool.
//
// Beats:
//   1. Define g as Bool.
//   2. Write if g().
//   3. Typecheck must accept the condition.

pub fn g() -> Bool {
    return true;
}
pub fn main() {
    if g() {
        println(1);
    }
}
