// # Accept Int var as arg
//
// Logline: Passing an Int local into an Int parameter must typecheck.
//
// Setup: f takes Int; x is inferred Int.
//
// Beats:
//   1. Define f.
//   2. Call f(x).
//   3. Typecheck must accept the argument.

pub fn f(a: Int) {
    println(a);
}
pub fn main() {
    let x = 1;
    f(x);
}
