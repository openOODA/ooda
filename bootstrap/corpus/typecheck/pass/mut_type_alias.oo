// # Accept mut Int alias assign
//
// Logline: Assigning 2 into a mut local typed as alias T = Int must typecheck.
//
// Setup: T names Int.
//
// Beats:
//   1. Alias T to Int.
//   2. Store x = 2.
//   3. Typecheck must accept the store.

type T = Int;
pub fn main() {
    let mut x: T = 1;
    x = 2;
    println(x);
}
