// # Accept two-arg call
//
// Logline: Calling f(Int, String) with 1 and "hi" must typecheck.
//
// Setup: Parameter types match the literals.
//
// Beats:
//   1. Declare f(a: Int, b: String).
//   2. Call f(1, "hi").
//   3. Typecheck must accept both args.

pub fn f(a: Int, b: String) {}
pub fn main() {
    f(1, "hi");
}
