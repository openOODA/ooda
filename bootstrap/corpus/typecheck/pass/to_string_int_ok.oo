// # Accept Int to_string
//
// Logline: Calling 42.to_string() must typecheck as String.
//
// Setup: Int.to_string is a product method.
//
// Beats:
//   1. Call 42.to_string().
//   2. Print the result.
//   3. Typecheck must accept the method.

pub fn main() {
    let s = 42.to_string();
    println(s);
}
