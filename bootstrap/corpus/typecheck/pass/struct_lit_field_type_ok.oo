// # Accept matching Point lit
//
// Logline: A Point literal with Int x and y must typecheck.
//
// Setup: Field types match the inits.
//
// Beats:
//   1. Declare Point.
//   2. Write Point { x: 1, y: 2 }.
//   3. Typecheck must accept the literal.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: 1, y: 2 };
}
