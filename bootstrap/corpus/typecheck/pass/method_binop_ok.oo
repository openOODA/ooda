// # Accept method as String/Int
//
// Logline: Int.to_string and String.len used as binop operands must typecheck.
//
// Setup: to_string is String; len is Int; concat and plus are product.
//
// Beats:
//   1. Concat n.to_string() and 0.to_string().
//   2. Add xs.len() + 1.
//   3. Typecheck must accept both sides.

pub fn main() {
    let n: Int = 42;
    let s: String = "n=" + n.to_string();
    println(s);
    let t: String = n.to_string() + "!";
    println(t);
    let u: String = "k=" + 0.to_string();
    println(u);
    let xs = "hi";
    let mut z = 0;
    z = xs.len() + 1;
    println(z.to_string());
}
