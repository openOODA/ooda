// Method call as binop operand: n.to_string() is String, not Int.
// Also pure-lit receiver: 0.to_string() → String in concat.
pub fn main() {
    let n: Int = 42;
    let s: String = "n=" + n.to_string();
    println(s);
    let t: String = n.to_string() + "!";
    println(t);
    let u: String = "k=" + 0.to_string();
    println(u);
    let xs = "hi";
    let mut z = 0;
    z = xs.len() + 1;
    println(z.to_string());
}
