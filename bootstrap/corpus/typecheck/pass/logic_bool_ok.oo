// # Accept Bool and-or
//
// Logline: true && false and true || false must typecheck.
//
// Setup: && and || take Bool operands.
//
// Beats:
//   1. Bind x to &&.
//   2. Bind y to ||.
//   3. Typecheck must accept both ops.

pub fn main() {
    let x = true && false;
    let y = true || false;
    println(x);
}
