// # Accept Int call return
//
// Logline: Returning an Int-returning call from an Int function must typecheck.
//
// Setup: g and f both return Int.
//
// Beats:
//   1. Define g as Int.
//   2. Return g() from f.
//   3. Typecheck must accept the call.

pub fn g() -> Int {
    return 1;
}
pub fn f() -> Int {
    return g();
}
pub fn main() {
    let x = f();
    println(x);
}
