// # Accept Int var annotation
//
// Logline: Binding an inferred Int local to let y: Int must typecheck.
//
// Setup: x is inferred Int.
//
// Beats:
//   1. Bind x to 1.
//   2. Write let y: Int = x.
//   3. Typecheck must accept the bind.

pub fn main() {
    let x = 1;
    let y: Int = x;
    println(y);
}
