// # Accept bang on Bool call
//
// Logline: Logical not on a Bool-returning call must typecheck.
//
// Setup: g returns Bool.
//
// Beats:
//   1. Define g as Bool.
//   2. Write !g().
//   3. Typecheck must accept the unary.

pub fn g() -> Bool {
    return false;
}
pub fn main() {
    let x = !g();
    println(x);
}
