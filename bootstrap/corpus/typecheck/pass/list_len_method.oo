// # Accept list len method
//
// Logline: Calling .len() on a List[String] must typecheck.
//
// Setup: list_new yields List[String]; .len is Int.
//
// Beats:
//   1. Build an empty string list.
//   2. Bind n = xs.len().
//   3. Typecheck must accept the method.

pub fn main() {
    let xs: List[String] = list_new();
    let n = xs.len();
    println(n);
}
