// # Accept mut lit assigns
//
// Logline: Assigning matching literals into mut Int and mut Bool must typecheck.
//
// Setup: x is mut Int; b is mut Bool.
//
// Beats:
//   1. Bind mut x and mut b.
//   2. Store 2 and false.
//   3. Typecheck must accept both stores.

pub fn main() {
    let mut x: Int = 1;
    x = 2;
    let mut b = true;
    b = false;
    println(x);
}
