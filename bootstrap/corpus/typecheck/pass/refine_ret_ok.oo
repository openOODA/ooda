// # Accept in-range refined return
//
// Logline: Returning 5 from Int[0..10] must typecheck.
//
// Setup: 5 sits inside the inclusive refined range.
//
// Beats:
//   1. Declare f as Int[0..10].
//   2. Return 5.
//   3. Typecheck must accept the value.

pub fn f() -> Int[0..10] {
    return 5;
}
pub fn main() {
    let x = f();
}
