// # Accept nested field return
//
// Logline: Returning Outer.inner.v from an Int function must typecheck.
//
// Setup: Nested field v is Int.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Return o.inner.v.
//   3. Typecheck must accept the field.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn g(o: Outer) -> Int {
    return o.inner.v;
}
fn main() -> Int {
    return 0;
}
