// # Accept call as Int arg
//
// Logline: Passing an Int-returning call into an Int parameter must typecheck.
//
// Setup: g returns Int; f takes Int.
//
// Beats:
//   1. Define g and f.
//   2. Call f(g()).
//   3. Typecheck must accept the nested call.

pub fn g() -> Int {
    return 1;
}
pub fn f(a: Int) {
    println(a);
}
pub fn main() {
    f(g());
}
