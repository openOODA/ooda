// # Accept nested field compare
//
// Logline: Comparing Outer.inner.v with && bounds must typecheck.
//
// Setup: Nested v is Int; > and < yield Bool.
//
// Beats:
//   1. Define Inner and Outer.
//   2. Test v > 0 && v < 100.
//   3. Typecheck must accept the condition.

type Inner = struct {
    v: Int,
};
type Outer = struct {
    inner: Inner,
};
fn test_fn(o: Outer) -> Int {
    if o.inner.v > 0 && o.inner.v < 100 {
        return 1;
    }
    return 0;
}
fn main() -> Int {
    return 0;
}
