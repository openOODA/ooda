// # Accept Point field read
//
// Logline: Printing Point.x must typecheck.
//
// Setup: Point defines Int x and y.
//
// Beats:
//   1. Build a Point.
//   2. Print p.x.
//   3. Typecheck must accept the field.

type Point = struct {
    x: Int,
    y: Int,
};
pub fn main() {
    let p = Point { x: 1, y: 2 };
    println(p.x);
}
