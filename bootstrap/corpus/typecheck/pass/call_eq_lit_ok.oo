// # Accept call equals Int lit
//
// Logline: Comparing an Int-returning call to an Int literal must typecheck.
//
// Setup: g returns Int; == on Int is product.
//
// Beats:
//   1. Define g as Int.
//   2. Write g() == 1.
//   3. Typecheck must accept the compare.

pub fn g() -> Int {
    return 1;
}
pub fn main() {
    let x = g() == 1;
    println(x);
}
