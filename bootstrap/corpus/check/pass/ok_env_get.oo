// # ok env get
//
// Logline: Check-pass fixture that grants env_get through an EnvCap token.
//
// Beats:
//   1. ok takes env: &EnvCap.
//   2. env_get is called with that token.
//   3. Check must accept the env read.

pub fn ok(env: &EnvCap) {
    let r = env_get(env, "HOME");
}
pub fn main() {}
