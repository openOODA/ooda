// # ok sys exec
//
// Logline: Check-pass fixture that grants a multi-arg sys_exec through SysCap.
//
// Beats:
//   1. ok takes sys: &SysCap.
//   2. sys_exec is called with sh -c true.
//   3. Check must accept the sealed exec.

pub fn ok(sys: &SysCap) {
    let r = sys_exec(sys, "sh", "-c", "true");
}
pub fn main() {}
