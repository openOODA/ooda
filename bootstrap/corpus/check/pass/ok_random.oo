// # ok random
//
// Logline: Check-pass fixture that grants random through a RandCap token.
//
// Beats:
//   1. roll takes r: &RandCap.
//   2. random is called with that token.
//   3. Check must accept the entropy call.

pub fn roll(r: &RandCap) -> Int {
    return random(r);
}
pub fn main() {}
