// # ok file size
//
// Logline: Check-pass fixture that grants file_size through an FsCap token.
//
// Beats:
//   1. ok takes fs: &FsCap.
//   2. file_size is called with that token.
//   3. Check must accept the size query.

pub fn ok(fs: &FsCap) {
    let n = file_size(fs, "README.md");
    println(n);
}
