// # ok sys spawn
//
// Logline: Check-pass fixture that grants sys_spawn through a SysCap token.
//
// Beats:
//   1. ok takes sys: &SysCap.
//   2. sys_spawn is called with that token.
//   3. Check must accept the sealed spawn.

pub fn ok(sys: &SysCap) {
    let r = sys_spawn(sys, "true");
}
pub fn main() {}
