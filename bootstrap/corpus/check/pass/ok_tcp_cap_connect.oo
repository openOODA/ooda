// # ok tcp cap connect
//
// Logline: Check-pass fixture that grants tcp_connect through a precise TcpCap token.
//
// Beats:
//   1. ok takes tcp: &TcpCap.
//   2. tcp_connect is called with that token.
//   3. Check must accept the granular grant.

pub fn ok(tcp: &TcpCap) {
    let r = tcp_connect(tcp, "127.0.0.1", 1);
}
pub fn main() {}
