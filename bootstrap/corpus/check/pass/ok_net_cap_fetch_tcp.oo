// # ok net cap fetch tcp
//
// Logline: Check-pass fixture that lets legacy NetCap authorize both fetch and tcp_connect.
//
// Beats:
//   1. ok takes net: &NetCap.
//   2. fetch and tcp_connect both receive that token.
//   3. Check must accept the supersede grant.

pub fn ok(net: &NetCap) {
    let a = fetch(net, "http://example.invalid");
    let b = tcp_connect(net, "127.0.0.1", 1);
}
pub fn main() {}
