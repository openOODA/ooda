// # ok alloc bytes
//
// Logline: Check-pass fixture that grants alloc_bytes through an AllocCap token.
//
// Beats:
//   1. grab takes a: &AllocCap and n: Int.
//   2. alloc_bytes is called with that token.
//   3. Check must accept the sealed alloc.

pub fn grab(a: &AllocCap, n: Int) -> Int {
    return alloc_bytes(a, n);
}
pub fn main() {}
