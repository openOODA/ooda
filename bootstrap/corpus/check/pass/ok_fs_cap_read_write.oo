// # ok fs cap read write
//
// Logline: Check-pass fixture that lets legacy FsCap authorize both read_file and write_file.
//
// Beats:
//   1. ok takes fs: &FsCap.
//   2. read_file and write_file both receive that token.
//   3. Check must accept the supersede grant.

pub fn ok(fs: &FsCap) {
    let r = read_file(fs, "/tmp/x");
    let w = write_file(fs, "/tmp/x", "hi");
}
pub fn main() {}
