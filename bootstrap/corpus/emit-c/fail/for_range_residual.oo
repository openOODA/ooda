// # for range residual
//
// Logline: Emit-c fail fixture whose for-range bounds are idents rather than INT..INT literals.
//
// Beats:
//   1. main binds lo and hi as lets.
//   2. A for loop walks lo..hi.
//   3. Lowering must leave non-INT bounds residual.

pub fn main() {
    let lo = 0;
    let hi = 3;
    let mut s = 0;
    for i in lo..hi {
        s = s + i;
    }
    println(s);
}
