// # cap magic int forge
//
// Logline: Emit-c fail fixture that forges an FsCap with a magic integer token.
//
// Beats:
//   1. main takes no capability params.
//   2. write_file is called with a literal magic int.
//   3. Lowering must refuse the forged token.

pub fn main() {
    let r = write_file(1330595411, "/tmp/x", "FORGED");
}
