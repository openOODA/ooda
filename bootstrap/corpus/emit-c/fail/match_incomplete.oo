// # match incomplete
//
// Logline: Emit-c fail fixture whose match has an Ok arm and no Err arm.
//
// Beats:
//   1. main binds an Ok Result.
//   2. match covers only Ok(v).
//   3. Emit must fail closed on the incomplete match.

pub fn main() {
    let r: Result[String, String] = Ok("hi");
    match r {
        Ok(v) => println(v),
    }
}
