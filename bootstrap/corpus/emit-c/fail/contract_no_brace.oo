// # contract no brace
//
// Logline: Emit-c fail fixture that follows a requires clause with another fn instead of a body brace.
//
// Beats:
//   1. bad declares requires a >= 0.
//   2. other starts before any LBRACE.
//   3. Emit must fail closed on the contract.

pub fn bad(a: Int) -> Int
    requires a >= 0
pub fn other() {
    return 0;
}
