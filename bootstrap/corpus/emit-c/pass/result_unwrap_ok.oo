// # Unwrap an Ok result
//
// Logline: Unwraps a successful Result and prints the string payload.
//
// Setup: make_ok returns Ok("hi").
//
// Beats:
//   1. Build an Ok result.
//   2. Unwrap it into a String.
//   3. Print the payload.
//
// pass: Result.unwrap() on Ok returns payload
pub fn make_ok() -> Result[String, String] {
    return Ok("hi");
}

pub fn main() {
    let r: Result[String, String] = make_ok();
    let s: String = r.unwrap();
    println(s);
}
