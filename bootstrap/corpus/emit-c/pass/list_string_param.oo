// # Pass a list of strings
//
// Logline: Emits C for a List[String] parameter that uses slist get and len.
//
// Setup: show takes List[String]; main builds a one-element list and calls it.
//
// Beats:
//   1. Declare show on a string list and print len then the first item.
//   2. Build xs with list_new and list_push.
//   3. Call show so emit lowers slist helpers.
//
// pass: List[String] param → OoSList; list_get/len use slist
pub fn show(toks: List[String]) {
    println(list_len(toks));
    if list_len(toks) > 0 {
        println(list_get(toks, 0));
    }
}

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    show(xs);
}
