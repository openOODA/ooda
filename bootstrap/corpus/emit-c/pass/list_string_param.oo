// pass: List[String] param → OoSList; list_get/len use slist
pub fn show(toks: List[String]) {
    println(list_len(toks));
    if list_len(toks) > 0 {
        println(list_get(toks, 0));
    }
}

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    show(xs);
}
