// # Ok and Err results
//
// Logline: Builds Ok and Err strings, probes is_ok/is_err, and matches payloads.
//
// Setup: make_ok and make_err return Result[String, String].
//
// Beats:
//   1. Return Ok("hi") and Err("boom") from helpers.
//   2. Match an Ok result after is_ok and print the value.
//   3. Match an Err result after is_err and print the message.
//
// pass: Ok/Err → OoResS; is_ok/is_err; match .val
pub fn make_ok() -> Result[String, String] {
    return Ok("hi");
}

pub fn make_err() -> Result[String, String] {
    return Err("boom");
}

pub fn main() {
    let r: Result[String, String] = make_ok();
    if r.is_ok() {
        let s = match r {
            Ok(v) => v,
            Err(e) => e,
        };
        println(s);
    }
    let e: Result[String, String] = make_err();
    if e.is_err() {
        let msg = match e {
            Ok(v) => v,
            Err(m) => m,
        };
        println(msg);
    }
}
