// # Write to a full device
//
// Logline: Writes to /dev/full and prints TORN_ERR when the Result is Err.
//
// Setup: main holds FsCap; /dev/full must be Err not torn Ok (C2).
//
// Beats:
//   1. Call write_file on /dev/full.
//   2. Print TORN_OK if the Result is Ok.
//   3. Print TORN_ERR on the expected failure.
//
// pass: /dev/full must be Err not torn Ok (C2) — program prints TORN_ERR
pub fn main(fs: &FsCap) {
    let r = write_file(fs, "/dev/full", "payload-that-should-fail");
    if r.is_ok() {
        println("TORN_OK");
    } else {
        println("TORN_ERR");
    }
}
