// # Unwrap a void Ok
//
// Logline: Unwraps a successful write_file Result and prints a marker.
//
// Setup: main holds FsCap; write target is /tmp/ooda_unwrap_v_rail.txt (H1).
//
// Beats:
//   1. Write a one-byte file.
//   2. Unwrap the void Ok.
//   3. Print unwrapped-v.
//
// pass: unwrap on write_file OoResV Ok (H1)
pub fn main(fs: &FsCap) {
    let w = write_file(fs, "/tmp/ooda_unwrap_v_rail.txt", "x");
    let x = w.unwrap();
    println("unwrapped-v");
}
