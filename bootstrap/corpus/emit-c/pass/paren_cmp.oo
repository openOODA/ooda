// # Compare a parenthesized sum
//
// Logline: Groups (ri + 1) < rn so addition binds before the comparison.
//
// Setup: A while loop walks ri from 0 toward rn.
//
// Beats:
//   1. Loop while ri is less than rn.
//   2. Print ri when (ri + 1) is still below rn.
//   3. Increment ri each pass.
//
// pass: (ri + 1) < rn paren grouping
pub fn main() {
    let mut ri = 0;
    let rn = 3;
    while ri < rn {
        if (ri + 1) < rn {
            println(ri);
        }
        ri = ri + 1;
    }
}
