// # call method to string
//
// Logline: Emit-c pass fixture that binds 42.to_string and prints the resulting String.
//
// Beats:
//   1. main binds x to 42.
//   2. x.to_string is stored as s.
//   3. println prints that string.

pub fn main() {
    let x = 42;
    let s: String = x.to_string();
    println(s);
}
