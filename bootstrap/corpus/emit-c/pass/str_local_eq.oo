// # Compare a local string
//
// Logline: Binds a String from a helper and compares it with oo_str_eq.
//
// Setup: tag returns "OK".
//
// Beats:
//   1. Call tag into a String local.
//   2. Compare s == "OK".
//   3. Print 1 on match and 0 otherwise.
//
// pass: String local from field_at-like call uses oo_str_eq
pub fn tag() -> String {
    return "OK";
}

pub fn main() {
    let s: String = tag();
    if s == "OK" {
        println(1);
    } else {
        println(0);
    }
}
