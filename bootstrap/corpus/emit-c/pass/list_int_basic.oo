// # list int basic
//
// Logline: Emit-c pass fixture that builds a two-int list and prints length and first item.
//
// Beats:
//   1. main creates a list and pushes 10 and 20.
//   2. list_len is printed.
//   3. list_get of index 0 is printed.

pub fn main() {
    let mut xs = list_new();
    xs = list_push(xs, 10);
    xs = list_push(xs, 20);
    println(list_len(xs));
    println(list_get(xs, 0));
}
