// # Bind a Result match
//
// Logline: Lets a string from Result match arms that bind Ok and Err payloads.
//
// Setup: Both Ok and Err results are matched in the same main.
//
// Beats:
//   1. Match Ok("hi") and print the payload.
//   2. Match Err("boom") and print the error or a literal.
//   3. Prove let-form match lowers both arms.
//
// pass: let-binding match on Result with arm payload binds + different Ok/Err exprs
pub fn main() {
    let ok_r: Result[String, String] = Ok("hi");
    let s = match ok_r {
        Ok(v) => v,
        Err(e) => e,
    };
    println(s);
    let err_r: Result[String, String] = Err("boom");
    let t = match err_r {
        Ok(v) => "ok",
        Err(e) => e,
    };
    println(t);
}
