// # fn ret string
//
// Logline: Emit-c pass fixture that returns a String from hi and prints the bound value.
//
// Beats:
//   1. hi returns the literal hi.
//   2. main binds that String as s.
//   3. println prints s.

pub fn hi() -> String {
    return "hi";
}

pub fn main() {
    let s: String = hi();
    println(s);
}
