// # fn contracts add
//
// Logline: Emit-c pass fixture that adds two non-negative ints under requires and ensures clauses.
//
// Beats:
//   1. add requires a >= 0 and b >= 0.
//   2. ensures result >= 0 and the body returns a + b.
//   3. main prints add(20, 22).

pub fn add(a: Int, b: Int) -> Int
    requires a >= 0
    requires b >= 0
    ensures result >= 0
{
    return a + b;
}

pub fn main() {
    let x = add(20, 22);
    println(x);
}
