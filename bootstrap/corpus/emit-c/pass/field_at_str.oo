// pass: field_at returns OoStr; bind + == work
pub fn field_decode3(raw: String) -> String {
    return raw;
}

pub fn field_at(line: String, which: Int) -> String {
    let n = chars_len(line);
    if n == 0 {
        return "";
    }
    let mut field = 0;
    let mut start = 0;
    let mut i = 0;
    while i < n {
        let ch = char_at(line, i);
        if ch == "\t" {
            if field == which {
                if start > i {
                    return "";
                }
                let raw = str_slice(line, start, i);
                if which == 3 {
                    return field_decode3(raw);
                }
                return raw;
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if field == which {
        let raw2 = str_slice(line, start, n);
        return raw2;
    }
    return "";
}

pub fn main() {
    let line = "KW_IF\t1\t2\thello";
    let k = field_at(line, 0);
    if k == "KW_IF" {
        println(field_at(line, 3));
    }
}
