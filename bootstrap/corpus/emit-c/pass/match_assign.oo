// # Assign from a Result match
//
// Logline: Assigns a mutable string from match arms on an Err result.
//
// Setup: Backend-C assign-form match uses arm expressions (H2).
//
// Beats:
//   1. Bind a mutable empty string and an Err result.
//   2. Assign s from match Ok versus Err arm literals.
//   3. Print the chosen arm.
//
// pass: assign-form match uses arm exprs (H2)
pub fn main() {
    let mut s = "";
    let r: Result[String, String] = Err("boom");
    s = match r {
        Ok(v) => "OK_ARM",
        Err(e) => "ERR_ARM",
    };
    println(s);
}
