// # ensures complex
//
// Logline: Emit-c pass fixture whose fancy helper carries a complex ensures clause and still emits.
//
// Beats:
//   1. fancy requires result == x + 1.
//   2. The body returns x + 1.
//   3. main prints fancy(1).

pub fn fancy(x: Int) -> Int
    ensures result == x + 1
{
    return x + 1;
}
pub fn main() {
    println(fancy(1));
}
