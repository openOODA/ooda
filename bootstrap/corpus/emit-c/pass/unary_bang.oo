// # Unary not and negate
//
// Logline: Emits unary ! on a bool call and unary - on an integer.
//
// Setup: is_zero compares its argument to 0.
//
// Beats:
//   1. Print 1 when !is_zero(1).
//   2. Print 2 when is_zero(0) so the ! branch is false.
//   3. Print -5 from unary minus.
//
// pass: unary ! and unary -
pub fn is_zero(x: Int) -> Bool {
    return x == 0;
}

pub fn main() {
    let x = 0;
    if !is_zero(1) {
        println(1);
    }
    if !is_zero(0) {
        println(0);
    } else {
        println(2);
    }
    let y = -5;
    println(y);
}
