// # Complex requires clause
//
// Logline: Emits a function whose requires clause is a compound comparison.
//
// Setup: M19 complex requires must fail-closed at emit, not silent best-effort.
//
// Beats:
//   1. Declare fancy with requires x > 0 && x < 10.
//   2. Return x when the contract holds.
//   3. Call fancy(1) from main and print it.
//
// M19: complex requires must fail-closed at emit (not silent best-effort)
pub fn fancy(x: Int) -> Int
    requires x > 0 && x < 10
{
    return x;
}
pub fn main() {
    println(fancy(1));
}
