// # list pack get
//
// Logline: Emit-c pass fixture that returns a packed List[String] and reads both items with list_get.
//
// Beats:
//   1. make_pack builds a two-string list.
//   2. main binds prep from that helper.
//   3. list_get of 0 and 1 is printed.

pub fn make_pack() -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "a");
    r = list_push(r, "b");
    return r;
}

pub fn main() {
    let prep: List[String] = make_pack();
    let x = list_get(prep, 0);
    let y = list_get(prep, 1);
    println(x);
    println(y);
}
