// pass: List[String] pack from helper → list_get is slist not ilist
pub fn make_pack() -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "a");
    r = list_push(r, "b");
    return r;
}

pub fn main() {
    let prep: List[String] = make_pack();
    let x = list_get(prep, 0);
    let y = list_get(prep, 1);
    println(x);
    println(y);
}
