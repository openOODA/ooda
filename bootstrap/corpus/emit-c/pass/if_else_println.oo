// # if else println
//
// Logline: Emit-c pass fixture that branches on x == 1 and prints one or other.
//
// Beats:
//   1. main binds x to 1.
//   2. An if/else compares x == 1.
//   3. println prints the taken branch.

pub fn main() {
    let x = 1;
    if x == 1 {
        println("one");
    } else {
        println("other");
    }
}
