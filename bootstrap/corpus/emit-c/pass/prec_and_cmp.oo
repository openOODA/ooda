// # And after comparison
//
// Logline: Keeps && looser than < and > so both comparisons run first.
//
// Setup: a is 1 and b is 5.
//
// Beats:
//   1. Bind a and b.
//   2. Test a < 3 && b > 0.
//   3. Print 1 on true and 0 on false.
//
// pass: && binds looser than < / >
pub fn main() {
    let a = 1;
    let b = 5;
    if a < 3 && b > 0 {
        println(1);
    } else {
        println(0);
    }
}
