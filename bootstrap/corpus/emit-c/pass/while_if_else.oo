// # While with if else
//
// Logline: Loops a counter and branches on equality inside the body.
//
// Setup: x starts at 0 and stops before 3.
//
// Beats:
//   1. Enter the while while x < 3.
//   2. Print one when x is 1 else other.
//   3. Increment x each pass.

pub fn main() {
    let mut x = 0;
    while x < 3 {
        if x == 1 {
            println("one");
        } else {
            println("other");
        }
        x = x + 1;
    }
}
