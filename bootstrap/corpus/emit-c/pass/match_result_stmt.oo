// # Statement match on Result
//
// Logline: Matches a Result as a statement and prints the Ok or Err payload.
//
// Setup: Backend-C statement match on Result Ok/Err.
//
// Beats:
//   1. Bind r as Ok("hello").
//   2. Match r and print the arm payload.
//   3. Lower statement match without an assignment.
//
// pass: statement match on Result Ok/Err (Backend-C lowered)
pub fn main() {
    let r: Result[String, String] = Ok("hello");
    match r {
        Ok(v) => println(v),
        Err(e) => println(e),
    }
}
