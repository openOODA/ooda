// # Or after equality
//
// Logline: Keeps || looser than == so identifier checks do not become a bool compare.
//
// Setup: char_is_alpha and char_is_digit exist.
//
// Beats:
//   1. Accept "a" when it is alpha or equals underscore.
//   2. Accept "1" when it is digit, alpha, or underscore.
//   3. Print 1 then 2 when both checks pass.
//
// pass: || binds looser than ==  → (alpha || (ch == "_")) not (alpha || ch) == "_"
pub fn main() {
    let ch = "a";
    if char_is_alpha(ch) || ch == "_" {
        println(1);
    } else {
        println(0);
    }
    let d = "1";
    if char_is_digit(d) || char_is_alpha(d) || d == "_" {
        println(2);
    }
}
