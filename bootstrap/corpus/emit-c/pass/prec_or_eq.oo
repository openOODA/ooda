// pass: || binds looser than ==  → (alpha || (ch == "_")) not (alpha || ch) == "_"
pub fn main() {
    let ch = "a";
    if char_is_alpha(ch) || ch == "_" {
        println(1);
    } else {
        println(0);
    }
    let d = "1";
    if char_is_digit(d) || char_is_alpha(d) || d == "_" {
        println(2);
    }
}
