// # let ident copy
//
// Logline: Emit-c pass fixture that copies a char_at String through a bare IDENT let.
//
// Beats:
//   1. ch is char_at of the first letter.
//   2. mut num copies ch and concatenates the next char.
//   3. println prints the copied string.

pub fn main() {
    let ch = char_at("ab", 0);
    let mut num = ch;
    num = num + char_at("ab", 1);
    println(num);
}
