// # call nested
//
// Logline: Emit-c pass fixture that calls a user pick helper with a nested binop index.
//
// Beats:
//   1. pick returns list_get(toks, i).
//   2. main builds a two-string list.
//   3. pick is called with 0 + 1 and printed.

pub fn pick(toks: List[String], i: Int) -> String {
    return list_get(toks, i);
}

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    xs = list_push(xs, "yo");
    let s: String = pick(xs, 0 + 1);
    println(s);
}
