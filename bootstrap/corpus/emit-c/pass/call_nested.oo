// pass: nested field_at(list_get(...), n) and multi-arg user fn
pub fn pick(toks: List[String], i: Int) -> String {
    return list_get(toks, i);
}

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    xs = list_push(xs, "yo");
    let s: String = pick(xs, 0 + 1);
    println(s);
}
