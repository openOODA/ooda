// # if expr let
//
// Logline: Emit-c pass fixture that binds y from a chained if/else-if expression.
//
// Beats:
//   1. main binds mutable i to 3.
//   2. y is an if i > 5 / else if i > 2 / else expr.
//   3. println prints y.

pub fn main() {
    let mut i = 3;
    let y = if i > 5 {
        9
    } else if i > 2 {
        i
    } else {
        0
    };
    println(y);
}
