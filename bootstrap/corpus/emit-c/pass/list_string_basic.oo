// # list string basic
//
// Logline: Emit-c pass fixture that builds a two-string list and prints length and both items.
//
// Beats:
//   1. main creates a typed List[String].
//   2. "a" and "b" are pushed.
//   3. list_len and both list_get calls are printed.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    println(list_len(xs));
    println(list_get(xs, 0));
    println(list_get(xs, 1));
}
