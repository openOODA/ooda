// # cap runtime read
//
// Logline: Emit-c pass fixture that reads a fixture path through a main-injected FsCap token.
//
// Beats:
//   1. main takes fs: &FsCap.
//   2. read_file is called on fixtures/hello.oo.
//   3. The Result branch prints ok or err.

pub fn main(fs: &FsCap) {
    let path = "fixtures/hello.oo";
    let r = read_file(fs, path);
    if r.is_ok() {
        println("ok");
    } else {
        println("err");
    }
}
