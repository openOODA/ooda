// # for range int
//
// Logline: Emit-c pass fixture that sums a for-range over INT..INT literals.
//
// Beats:
//   1. main binds a mutable sum.
//   2. A for loop walks 0..5.
//   3. println prints the accumulated s.

pub fn main() {
    let mut s = 0;
    for i in 0..5 {
        s = s + i;
    }
    println(s);
}
