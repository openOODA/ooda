// # call arg binop
//
// Logline: Emit-c pass fixture that passes a binop index into list_get as one argument.
//
// Beats:
//   1. main builds a two-string list.
//   2. list_get is called with i + 1.
//   3. Emit must treat the index as a single expr.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    let i = 0;
    println(list_get(xs, i + 1));
    println(list_len(xs));
}
