// # Lex a requires clause
//
// Logline: Tokenizes a greet function whose contract uses name.len().
//
// Setup: Used as a lex/pass fixture.
//
// Beats:
//   1. Declare greet taking a String.
//   2. Require name.len() > 0.
//   3. Return name.

pub fn greet(name: String) -> String
    requires name.len() > 0
{
    return name;
}
