#!/usr/bin/env bash
# Why not .oo: this starts gcc and the seed (first compiler). RULES 1.13 host exception.
# job: official in-repo pure multi-module oodac rebuild (emit each .oo, link once)
# in:  <main.oo> <out_bin>
# out: native binary via emit-c + gcc + chs_rt only
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
oodac_abs() {
  local p="$1"
  if [[ -e "$p" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  elif [[ -d "$(dirname "$p")" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  else
    echo "$p"
  fi
}
MAIN="$(oodac_abs "${1:?main.oo}")"
OUT="$(oodac_abs "${2:?out_bin}")"
OODAC_BIN="${OODAC_BIN:-$ROOT/oodac/oodac}"
if [[ ! -x "$OODAC_BIN" ]]; then
  if [[ -x "$ROOT/oodac_bin" ]]; then OODAC_BIN="$ROOT/oodac_bin"
  elif [[ -x "$ROOT/bootstrap/seed/oodac" ]]; then OODAC_BIN="$ROOT/bootstrap/seed/oodac"
  elif [[ -x "$ROOT/oodac/oodac" ]]; then OODAC_BIN="$ROOT/oodac/oodac"
  elif [[ -x "$ROOT/oodac/main" ]]; then OODAC_BIN="$ROOT/oodac/main"
  else echo "ERR_NO_OODAC" >&2; exit 1; fi
fi
oodac_is_cli() {
  grep -a -q 'pure .oo product CLI' "$1" 2>/dev/null
}
oodac_is_compiler() {
  grep -a -q 'oodac: usage:' "$1" 2>/dev/null
}
# bin/ooda copied onto oodac/oodac execs itself on check (fork bomb).
if oodac_is_cli "$OODAC_BIN"; then
  echo "ERR_OODAC_IS_CLI $OODAC_BIN" >&2
  exit 1
fi
TMP="${TMPDIR:-.ooda-cache/ooda-tmp}/oodac_pure_$$"
mkdir -p "$TMP"
if [[ ! -f "$MAIN" && -f "$ROOT/$MAIN" ]]; then MAIN="$ROOT/$MAIN"; fi
if [[ ! -f "$MAIN" ]]; then echo "ERR_MISSING $MAIN" >&2; exit 1; fi
DIR="$(cd "$(dirname "$MAIN")" && pwd)"
BASE="$(basename "$MAIN")"
MAIN_ABS="$DIR/$BASE"
# Collect modules (DFS, cycle/missing fail-closed). Order: deps first, main last.
MODS=()
declare -A SEEN=()
declare -A STACK=()
collect() {
  local path="$1"
  local abs
  if [[ "$path" = /* ]]; then abs="$path"
  else abs="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
  fi
  if [[ -n "${STACK[$abs]:-}" ]]; then echo "ERR_IMPORT_CYCLE $abs" >&2; exit 1; fi
  if [[ -n "${SEEN[$abs]:-}" ]]; then return 0; fi
  if [[ ! -f "$abs" ]]; then
    local rel="${path#$dir/}"
    local fname="$(basename "$abs")"
    if [[ -f "$ROOT/$rel" ]]; then abs="$ROOT/$rel"
    elif [[ -f "$ROOT/std/$rel" ]]; then abs="$ROOT/std/$rel"
    elif [[ -n "${OODA_STD:-}" && -f "${OODA_STD}/$fname" ]]; then abs="${OODA_STD}/$fname"
    elif [[ -f "$ROOT/std/$fname" ]]; then abs="$ROOT/std/$fname"
    elif [[ -f "std/$fname" ]]; then abs="$(pwd)/std/$fname"
    elif [[ -f "../std/$fname" ]]; then abs="$(pwd)/../std/$fname"
    else echo "ERR_MISSING $abs" >&2; exit 1; fi
  fi
  STACK[$abs]=1
  local dir
  dir="$(cd "$(dirname "$abs")" && pwd)"
  local imp
  while IFS= read -r imp; do
    [[ -z "$imp" ]] && continue
    if [[ "$imp" = /* ]]; then
      collect "$imp"
    else
      collect "$dir/$imp"
    fi
  done < <(grep -E '^import "' "$abs" 2>/dev/null | sed -n 's/^import "\(.*\)";.*/\1/p' || true)
  unset "STACK[$abs]"
  SEEN[$abs]=1
  MODS+=("$abs")
}
collect "$MAIN_ABS"

# Same tree → same input_fp. Not a bit-identical product binary claim.
PURE_INPUT_FP="$(
  {
    for src in "${MODS[@]}"; do
      if [[ "$src" == "$ROOT/"* ]]; then
        rel="${src#"$ROOT"/}"
      else
        rel="$(basename "$src")"
      fi
      printf '%s\0' "$rel"
      cat -- "$src"
    done
  } | sha256sum | awk '{print $1}'
)"
echo "pure_build: input_fp=$PURE_INPUT_FP"
if [[ -n "${PURE_BUILD_FP_OUT:-}" ]]; then
  printf '%s\n' "$PURE_INPUT_FP" >"$PURE_BUILD_FP_OUT"
fi

# Check gate unless PURE_SKIP_CHECK=1. Official path leaves that unset.
if [[ "${PURE_SKIP_CHECK:-}" != "1" ]]; then
  nmods=${#MODS[@]}
  # Small trees: 60+2*nmods, cap 180s. Large nmods (oodac/main.oo ~174):
  # cold check is ~523s on this host; 180s cannot finish.
  ck_to=$((60 + nmods * 2))
  if [[ $nmods -gt 80 ]]; then
    ck_to=900
  elif [[ $ck_to -gt 180 ]]; then
    ck_to=180
  fi
  run_main_check() {
    echo "pure_build: check host=$OODAC_BIN nmods=$nmods timeout=${ck_to}s"
    set +e
    timeout "$ck_to" "$OODAC_BIN" check "$MAIN_ABS" >"$TMP/main_check.out" 2>"$TMP/main_check.err"
    main_ck=$?
    set -e
  }
  run_main_check
  TREE_HOST="$ROOT/oodac/oodac"
  if [[ $main_ck -ne 0 ]]; then
    if [[ -x "$TREE_HOST" ]] && [[ "$(oodac_abs "$OODAC_BIN")" != "$(oodac_abs "$TREE_HOST")" ]]; then
      if oodac_is_cli "$TREE_HOST"; then
        echo "ERR_OODAC_IS_CLI $TREE_HOST" >&2
        exit 1
      fi
      if oodac_is_compiler "$TREE_HOST"; then
        echo "pure_build: host-fallback $TREE_HOST (prior host could not check)"
        OODAC_BIN="$TREE_HOST"
        run_main_check
      fi
    fi
  fi
  if [[ $main_ck -eq 124 ]]; then
    echo "ERR_CHECK_TIMEOUT $MAIN_ABS (nmods=$nmods timeout=${ck_to}s)" >&2
    exit 1
  fi
  if [[ $main_ck -ne 0 ]]; then
    echo "ERR_CHECK $MAIN_ABS" >&2
    cat "$TMP/main_check.err" "$TMP/main_check.out" >&2 || true
    exit 1
  fi
fi

FN_DEF='^(void|int|long long|double|float|bool|char|OoStr|OoSList|OoIList|OoFList|OoResS|OoResV|OoResI|OoResB|OoResF|CapToken|[A-Za-z_][A-Za-z0-9_]*)\s+[A-Za-z0-9_].*\)\s*\{'
EMIT_CACHE="${OODAC_EMIT_CACHE:-$ROOT/.ooda-cache/oodac_emit}"
mkdir -p "$EMIT_CACHE"
MCS=()
emit_skip=0
for src in "${MODS[@]}"; do
  mc="$TMP/$(echo "$src" | tr '/.' '__').c"
  src_hash="$(sha256sum -- "$src" | awk '{print $1}')"
  cache_c="$EMIT_CACHE/${src_hash}.c"
  if [[ -s "$cache_c" ]] && grep -qE "$FN_DEF" "$cache_c" && ! grep -qE $'^ERR\tc_emit' "$cache_c"; then
    cp -f "$cache_c" "$mc"
    emit_skip=$((emit_skip + 1))
  else
    OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 timeout 600 "$OODAC_BIN" emit-c "$src" >"$mc" || true
    if [[ -s "$mc" ]] && grep -qE "$FN_DEF" "$mc" && ! grep -qE $'^ERR\tc_emit' "$mc"; then
      cp -f "$mc" "$cache_c"
    fi
  fi
  if [[ ! -s "$mc" ]] || ! grep -qE "$FN_DEF" "$mc"; then
    echo "ERR_EMIT $src" >&2
    exit 1
  fi
  if grep -qE $'^ERR\tc_emit' "$mc"; then
    echo "ERR_EMIT_LINE $src" >&2
    grep -E $'^ERR\tc_emit' "$mc" >&2 || true
    exit 1
  fi
  MCS+=("$mc")
done
echo "pure_build: emit_cache skip=$emit_skip of ${#MODS[@]}"

awk '/^(#line 1 "|#ifndef OO_FN_)/{exit} {print}' "${MCS[0]}" >"$TMP/preamble.c"
# First definition of each symbol wins (import doubles).
python3 - "$TMP" "${MCS[@]}" <<'PY'
import re, sys
from pathlib import Path
tmp = Path(sys.argv[1])
mcs = [Path(p) for p in sys.argv[2:]]
protos: list[str] = []
bodies: list[str] = []
seen: set[str] = set()
for mc in sorted(mcs):
    text = mc.read_text(errors="replace").splitlines(keepends=True)
    i = 0
    n = len(text)
    while i < n:
        if text[i].lstrip().startswith("#ifndef OO_FN_"):
            name = text[i].rstrip().split("OO_FN_")[1]
            j = i + 1
            if_depth = 1
            while j < n and if_depth > 0:
                l = text[j].lstrip()
                if l.startswith("#ifndef ") or l.startswith("#ifdef ") or l.startswith("#if "):
                    if_depth += 1
                elif l.startswith("#endif"):
                    if_depth -= 1
                j += 1
            body_lines = [re.sub(r"\b\d+__", "", l) for l in text[i+2:j-1]]
            if name not in seen and len(body_lines) > 0:
                seen.add(name)
                sig_line = ""
                for bl in body_lines:
                    if bl.lstrip().startswith("#") or bl.lstrip().startswith("//"):
                        continue
                    sig_line = bl
                    break
                if sig_line:
                    protos.append(re.sub(r"\b\d+__", "", sig_line.rstrip()[:-1].rstrip()) + ";\n")
                    bodies.extend(body_lines)
                    bodies.append("\n\n")
            i = j
        elif text[i].lstrip().startswith("int main(") or text[i].lstrip().startswith("int main ("):
            if "main" not in seen:
                seen.add("main")
                protos.append("int main(int argc, char **argv);\n")
                bodies.extend([re.sub(r"\b\d+__", "", l) for l in text[i:]])
                bodies.append("\n\n")
            break
        else:
            i += 1
(tmp / "protos.c").write_text("".join(protos))

# Inject full struct definitions and list helpers into preamble
real_structs = {}
real_retains = {}
for mc in mcs:
    content = mc.read_text(errors="replace")
    for m in re.finditer(r'typedef struct (\w+) \{ (?!long long _pad;)(.*?)\} \1;', content, re.DOTALL):
        ty = m.group(1)
        if ty not in real_structs:
            real_structs[ty] = m.group(0)
    for m in re.finditer(r'static void oo_retain_(\w+)\(\1 v\) \{(.*?)\}', content, re.DOTALL):
        ty = m.group(1)
        if ty not in real_retains:
            real_retains[ty] = m.group(0)

preamble_file = tmp / "preamble.c"
preamble_text = preamble_file.read_text(errors="replace")

# Strip stubs from preamble_text
for ty in real_structs:
    preamble_text = re.sub(r'#ifndef OO_TY_' + ty + r'.*?#endif\s+#endif\s*', '', preamble_text, flags=re.DOTALL)
    preamble_text = re.sub(r'#ifndef OO_TY_' + ty + r'.*?#endif\s*', '', preamble_text, flags=re.DOTALL)
    preamble_text = re.sub(r'#ifndef OO_FWD_' + ty + r'.*?#endif\s*', '', preamble_text, flags=re.DOTALL)
    preamble_text = re.sub(r'#ifndef OO_HAVE_OoL_' + ty + r'.*?#endif\s*', '', preamble_text, flags=re.DOTALL)
    preamble_text = re.sub(r'#ifndef OO_FNS_OoL_' + ty + r'.*?#endif\s*', '', preamble_text, flags=re.DOTALL)
    preamble_text = re.sub(r'typedef struct ' + ty + r' \{ long long _pad; \} ' + ty + r';\s*', '', preamble_text)
    preamble_text = re.sub(r'typedef struct ' + ty + r' ' + ty + r';\s*', '', preamble_text)
    preamble_text = re.sub(r'static void oo_retain_' + ty + r'\(' + ty + r' v\) \{ \}\s*', '', preamble_text)

# Build type section in correct dependency order
fwd_decls = []
list_decls = []
struct_defs = []
list_fns = []

for ty in real_structs:
    fwd_decls.append(f"#ifndef OO_FWD_{ty}\n#define OO_FWD_{ty}\ntypedef struct {ty} {ty};\n#endif")

for ty in real_structs:
    list_decls.append(f"#ifndef OO_HAVE_OoL_{ty}\n#define OO_HAVE_OoL_{ty}\ntypedef struct {{ {ty} *data; long long len; long long cap; }} OoL_{ty};\n#endif")

for ty, sdef in real_structs.items():
    struct_defs.append(f"#ifndef OO_TY_{ty}\n#define OO_TY_{ty}\n#define OO_TY_RES_{ty}\n{sdef}\n")
    if ty in real_retains:
        struct_defs.append(f"{real_retains[ty]}\n")
    else:
        struct_defs.append(f"static inline void oo_retain_{ty}({ty} v) {{ }}\n")
    struct_defs.append(f"typedef struct {{ int ok; {ty} val; OoStr err; }} OoRes_{ty};\n#endif\n")

for ty in real_structs:
    list_fns.append(f"#ifndef OO_FNS_OoL_{ty}\n#define OO_FNS_OoL_{ty}\n")
    list_fns.append(f"static inline OoL_{ty} oo_l_{ty}_new(void) {{ OoL_{ty} l; l.data=0; l.len=0; l.cap=0; return l; }}\n")
    list_fns.append(f"static inline long long oo_l_{ty}_len(OoL_{ty} l) {{ return l.len; }}\n")
    list_fns.append(f"static inline {ty} oo_l_{ty}_get(OoL_{ty} l, long long i) {{ if (i<0||i>=l.len) {{ fprintf(stderr,\"ERR\\tolist_get OOB\\n\"); exit(1); }} return l.data[i]; }}\n")
    list_fns.append(f"static inline OoL_{ty} oo_l_{ty}_set(OoL_{ty} l, long long i, {ty} v) {{ if (i<0||i>=l.len) {{ fprintf(stderr,\"ERR\\tolist_set OOB\\n\"); exit(1); }} l.data[i] = v; return l; }}\n")
    list_fns.append(f"static inline OoL_{ty} oo_l_{ty}_push(OoL_{ty} l, {ty} v) {{ OoL_{ty} n; long long ncap = l.cap ? l.cap : 8; while (ncap < l.len + 1) ncap = ncap * 2; n.data = ({ty}*)malloc(sizeof({ty})*(size_t)ncap); if (!n.data) {{ fprintf(stderr, \"ERR\\tc_emit\\theap allocation failed\\n\"); exit(1); }} if (l.data && l.len > 0) memcpy(n.data, l.data, (size_t)l.len*sizeof({ty})); n.data[l.len] = v; n.len = l.len + 1; n.cap = ncap; return n; }}\n")
    list_fns.append(f"static inline void oo_retain_OoL_{ty}(OoL_{ty} v) {{ }}\n")
    list_fns.append("#endif\n")

type_section = "\n".join(fwd_decls) + "\n\n" + "\n".join(list_decls) + "\n\n" + "\n".join(struct_defs) + "\n\n" + "\n".join(list_fns)

preamble_text = preamble_text + "\n" + type_section + "\n"
preamble_file.write_text(preamble_text)

(tmp / "bodies.c").write_text("".join(bodies))
print(f"pure_build: unique_fns={len(seen)} from_modules={len(mcs)}", flush=True)
PY

# Extra runtime decls: seed/old emit-c preamble can omit names current c_emit_*.oo lowers to.
# Mirror oodac/c_emit_preamble.oo println prototypes (skip python_embed_internal).
echo "long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void); long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);" >> "$TMP/preamble.c"
