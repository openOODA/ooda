#!/usr/bin/env bash
# Why not .oo: this starts gcc and the seed (first compiler). RULES 1.13 host exception.
# job: official in-repo pure multi-module oodac rebuild (emit each .oo, link once)
# in:  <main.oo> <out_bin>
# out: native binary via emit-c + gcc + chs_rt only
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
oodac_abs() {
  local p="$1"
  if [[ -e "$p" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  elif [[ -d "$(dirname "$p")" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  else
    echo "$p"
  fi
}
MAIN="$(oodac_abs "${1:?main.oo}")"
OUT="$(oodac_abs "${2:?out_bin}")"
OODAC_BIN="${OODAC_BIN:-$ROOT/oodac/oodac}"
if [[ ! -x "$OODAC_BIN" ]]; then
  if [[ -x "$ROOT/oodac_bin" ]]; then OODAC_BIN="$ROOT/oodac_bin"
  elif [[ -x "$ROOT/bootstrap/seed/oodac" ]]; then OODAC_BIN="$ROOT/bootstrap/seed/oodac"
  elif [[ -x "$ROOT/oodac/oodac" ]]; then OODAC_BIN="$ROOT/oodac/oodac"
  elif [[ -x "$ROOT/oodac/main" ]]; then OODAC_BIN="$ROOT/oodac/main"
  else echo "ERR_NO_OODAC" >&2; exit 1; fi
fi
oodac_is_cli() {
  grep -a -q 'pure .oo product CLI' "$1" 2>/dev/null
}
oodac_is_compiler() {
  grep -a -q 'oodac: usage:' "$1" 2>/dev/null
}
# bin/ooda copied onto oodac/oodac execs itself on check (fork bomb).
if oodac_is_cli "$OODAC_BIN"; then
  echo "ERR_OODAC_IS_CLI $OODAC_BIN" >&2
  exit 1
fi
TMP="${TMPDIR:-.ooda-cache/ooda-tmp}/oodac_pure_$$"
mkdir -p "$TMP"
if [[ ! -f "$MAIN" && -f "$ROOT/$MAIN" ]]; then MAIN="$ROOT/$MAIN"; fi
if [[ ! -f "$MAIN" ]]; then echo "ERR_MISSING $MAIN" >&2; exit 1; fi
DIR="$(cd "$(dirname "$MAIN")" && pwd)"
BASE="$(basename "$MAIN")"
MAIN_ABS="$DIR/$BASE"
# Collect modules (DFS, cycle/missing fail-closed). Order: deps first, main last.
MODS=()
declare -A SEEN=()
declare -A STACK=()
collect() {
  local path="$1"
  local abs
  if [[ "$path" = /* ]]; then abs="$path"
  else abs="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
  fi
  if [[ -n "${STACK[$abs]:-}" ]]; then echo "ERR_IMPORT_CYCLE $abs" >&2; exit 1; fi
  if [[ -n "${SEEN[$abs]:-}" ]]; then return 0; fi
  if [[ ! -f "$abs" ]]; then
    local fname="$(basename "$abs")"
    if [[ -n "${OODA_STD:-}" && -f "${OODA_STD}/$fname" ]]; then abs="${OODA_STD}/$fname"
    elif [[ -f "$ROOT/std/$fname" ]]; then abs="$ROOT/std/$fname"
    elif [[ -f "std/$fname" ]]; then abs="$(pwd)/std/$fname"
    elif [[ -f "../std/$fname" ]]; then abs="$(pwd)/../std/$fname"
    else echo "ERR_MISSING $abs" >&2; exit 1; fi
  fi
  STACK[$abs]=1
  local dir
  dir="$(cd "$(dirname "$abs")" && pwd)"
  local imp
  while IFS= read -r imp; do
    [[ -z "$imp" ]] && continue
    if [[ "$imp" = /* ]]; then
      collect "$imp"
    else
      collect "$dir/$imp"
    fi
  done < <(grep -E '^import "' "$abs" 2>/dev/null | sed -n 's/^import "\(.*\)";.*/\1/p' || true)
  unset "STACK[$abs]"
  SEEN[$abs]=1
  MODS+=("$abs")
}
collect "$MAIN_ABS"

# Same tree → same input_fp. Not a bit-identical product binary claim.
PURE_INPUT_FP="$(
  {
    for src in "${MODS[@]}"; do
      if [[ "$src" == "$ROOT/"* ]]; then
        rel="${src#"$ROOT"/}"
      else
        rel="$(basename "$src")"
      fi
      printf '%s\0' "$rel"
      cat -- "$src"
    done
  } | sha256sum | awk '{print $1}'
)"
echo "pure_build: input_fp=$PURE_INPUT_FP"
if [[ -n "${PURE_BUILD_FP_OUT:-}" ]]; then
  printf '%s\n' "$PURE_INPUT_FP" >"$PURE_BUILD_FP_OUT"
fi

# Check gate unless PURE_SKIP_CHECK=1. Official path leaves that unset.
if [[ "${PURE_SKIP_CHECK:-}" != "1" ]]; then
  nmods=${#MODS[@]}
  # Small trees: 60+2*nmods, cap 180s. Large nmods (oodac/main.oo ~174):
  # cold check is ~523s on this host; 180s cannot finish.
  ck_to=$((60 + nmods * 2))
  if [[ $nmods -gt 80 ]]; then
    ck_to=900
  elif [[ $ck_to -gt 180 ]]; then
    ck_to=180
  fi
  run_main_check() {
    echo "pure_build: check host=$OODAC_BIN nmods=$nmods timeout=${ck_to}s"
    set +e
    timeout "$ck_to" "$OODAC_BIN" check "$MAIN_ABS" >"$TMP/main_check.out" 2>"$TMP/main_check.err"
    main_ck=$?
    set -e
  }
  run_main_check
  TREE_HOST="$ROOT/oodac/oodac"
  if [[ $main_ck -ne 0 ]]; then
    if [[ -x "$TREE_HOST" ]] && [[ "$(oodac_abs "$OODAC_BIN")" != "$(oodac_abs "$TREE_HOST")" ]]; then
      if oodac_is_cli "$TREE_HOST"; then
        echo "ERR_OODAC_IS_CLI $TREE_HOST" >&2
        exit 1
      fi
      if oodac_is_compiler "$TREE_HOST"; then
        echo "pure_build: host-fallback $TREE_HOST (prior host could not check)"
        OODAC_BIN="$TREE_HOST"
        run_main_check
      fi
    fi
  fi
  if [[ $main_ck -eq 124 ]]; then
    echo "ERR_CHECK_TIMEOUT $MAIN_ABS (nmods=$nmods timeout=${ck_to}s)" >&2
    exit 1
  fi
  if [[ $main_ck -ne 0 ]]; then
    echo "ERR_CHECK $MAIN_ABS" >&2
    cat "$TMP/main_check.err" "$TMP/main_check.out" >&2 || true
    exit 1
  fi
fi

FN_DEF='^(void|int|long long|double|float|bool|char|OoStr|OoSList|OoIList|OoFList|OoResS|OoResV|OoResI|OoResB|OoResF|CapToken|[A-Za-z_][A-Za-z0-9_]*)\s+[A-Za-z0-9_].*\)\s*\{'
EMIT_CACHE="${OODAC_EMIT_CACHE:-$ROOT/.ooda-cache/oodac_emit}"
mkdir -p "$EMIT_CACHE"
MCS=()
emit_skip=0
for src in "${MODS[@]}"; do
  mc="$TMP/$(echo "$src" | tr '/.' '__').c"
  src_hash="$(sha256sum -- "$src" | awk '{print $1}')"
  cache_c="$EMIT_CACHE/${src_hash}.c"
  if [[ -s "$cache_c" ]] && grep -qE "$FN_DEF" "$cache_c" && ! grep -qE $'^ERR\tc_emit' "$cache_c"; then
    cp -f "$cache_c" "$mc"
    emit_skip=$((emit_skip + 1))
  else
    OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 timeout 600 "$OODAC_BIN" emit-c "$src" >"$mc" || true
    if [[ -s "$mc" ]] && grep -qE "$FN_DEF" "$mc" && ! grep -qE $'^ERR\tc_emit' "$mc"; then
      cp -f "$mc" "$cache_c"
    fi
  fi
  if [[ ! -s "$mc" ]] || ! grep -qE "$FN_DEF" "$mc"; then
    echo "ERR_EMIT $src" >&2
    exit 1
  fi
  if grep -qE $'^ERR\tc_emit' "$mc"; then
    echo "ERR_EMIT_LINE $src" >&2
    grep -E $'^ERR\tc_emit' "$mc" >&2 || true
    exit 1
  fi
  MCS+=("$mc")
done
echo "pure_build: emit_cache skip=$emit_skip of ${#MODS[@]}"

awk "/$FN_DEF/{exit} {print}" "${MCS[0]}" >"$TMP/preamble.c"
# First definition of each symbol wins (import doubles).
python3 - "$TMP" "${MCS[@]}" <<'PY'
import re, sys
from pathlib import Path
tmp = Path(sys.argv[1])
mcs = [Path(p) for p in sys.argv[2:]]
fn_start = re.compile(
    r"^(void|int|long long|double|float|bool|char|OoStr|OoSList|OoIList|OoFList|OoResS|OoResV|OoResI|OoResB|OoResF|CapToken|[A-Za-z_][A-Za-z0-9_]*)\s+([A-Za-z0-9_]+)\s*\(.*\)\s*\{\s*$"
)
protos: list[str] = []
bodies: list[str] = []
seen: set[str] = set()
for mc in mcs:
    text = mc.read_text(errors="replace").splitlines(keepends=True)
    i = 0
    n = len(text)
    while i < n:
        m = fn_start.match(text[i].rstrip("\n"))
        if not m:
            i += 1
            continue
        name = re.sub(r"^\d+__", "", m.group(2))
        j = i + 1
        while j < n and not fn_start.match(text[j].rstrip("\n")):
            j += 1
        chunk = [
            re.sub(r"\b\d+__", "", line)
            for line in text[i:j]
            if not line.startswith("#ifndef OO_FN_")
            and not line.startswith("#define OO_FN_")
            and line.rstrip() != "#endif"
        ]
        if name not in seen:
            seen.add(name)
            line = re.sub(r"\b\d+__", "", text[i].rstrip())
            if line.endswith("{"):
                line = line[:-1].rstrip() + ";"
            protos.append(line + "\n")
            bodies.extend(chunk)
        i = j
(tmp / "protos.c").write_text("".join(protos))
MAX_LINES = 200
bodies_c_content = []
part = 0
lines = 0
chunk = []
for line in bodies:
    chunk.append(line)
    lines += 1
    if lines >= MAX_LINES and line.rstrip() == "}":
        (tmp / f"bodies_{part}.c").write_text("".join(chunk))
        bodies_c_content.append(f'#include "bodies_{part}.c"\n')
        part += 1
        chunk = []
        lines = 0
if chunk:
    (tmp / f"bodies_{part}.c").write_text("".join(chunk))
    bodies_c_content.append(f'#include "bodies_{part}.c"\n')
(tmp / "bodies.c").write_text("".join(bodies_c_content))
print(f"pure_build: unique_fns={len(seen)} from_modules={len(mcs)}", flush=True)
PY

# Extra runtime decls: seed/old emit-c preamble can omit names current c_emit_*.oo lowers to.
