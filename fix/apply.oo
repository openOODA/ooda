// # Structural E_CAP and E_TC edits
//
// Logline: Insert a missing cap token or a missing let from a check error line.
//
// Setup: fix_text helpers are imported. Edits are string inserts only.
//
// Beats:
//   1. apply_ecap adds pname to a bare sealed call and a &Cap param.
//   2. apply_etc inserts let name = 0; at the start of the enclosing fn body.
//   3. Both refuse when the pattern is not found.

import "text.oo";

fn cap_param_name(cap: String) -> String {
    if cap == "NetCap" { return "net"; }
    if cap == "HttpCap" { return "http"; }
    if cap == "TcpCap" { return "tcp"; }
    if cap == "UdpCap" { return "udp"; }
    if cap == "BindCap" { return "bind"; }
    if cap == "FsCap" { return "fs"; }
    if cap == "FsReadCap" { return "fsr"; }
    if cap == "FsWriteCap" { return "fsw"; }
    if cap == "SysCap" { return "sys"; }
    if cap == "EnvCap" { return "env"; }
    if cap == "TimeCap" { return "time"; }
    if cap == "RandCap" { return "rand"; }
    if cap == "AllocCap" { return "alloc"; }
    return "";
}

fn is_id_char(c: String) -> Bool {
    if char_is_alpha(c) || char_is_digit(c) || c == "_" { return true; }
    return false;
}

pub fn apply_ecap(text: String, op: String, cap: String) -> String {
    let pname: String = cap_param_name(cap);
    if pname == "" { println("ERR\tfix\tunknown cap " + cap); process_exit(1); }
    let n = chars_len(text);
    let opl = chars_len(op);
    if opl == 0 { println("ERR\tfix\tno bare " + op + "( call"); process_exit(1); }
    let mut ins_pos = -1;
    let mut from = 0;
    while from + opl <= n {
        if str_slice(text, from, from + opl) == op {
            let at = from;
            let after = at + opl;
            let mut skip_match = false;
            if at > 0 {
                if is_id_char(char_at(text, at - 1)) { skip_match = true; }
            }
            if !skip_match {
                let mut p = after;
                while p < n {
                    if char_is_space(char_at(text, p)) { p = p + 1; } else { break; }
                }
                if p < n && char_at(text, p) == "(" {
                    let mut q = p + 1;
                    while q < n {
                        if char_is_space(char_at(text, q)) { q = q + 1; } else { break; }
                    }
                    let mut q_end = q;
                    while q_end < n {
                        if is_id_char(char_at(text, q_end)) { q_end = q_end + 1; } else { break; }
                    }
                    let id: String = str_slice(text, q, q_end);
                    if id != "" {
                        let mut r = q_end;
                        while r < n {
                            if char_is_space(char_at(text, r)) { r = r + 1; } else { break; }
                        }
                        if r < n && char_at(text, r) == "," { skip_match = true; }
                    }
                    if !skip_match { ins_pos = p + 1; break; }
                }
            }
        }
        from = from + 1;
    }
    if ins_pos < 0 { println("ERR\tfix\tno bare " + op + "( call"); process_exit(1); }
    let text2: String = str_slice(text, 0, ins_pos) + pname + ", " + str_slice(text, ins_pos, n);
    let t2n = chars_len(text2);
    let mut fnp = -1;
    let mut fi = ins_pos;
    if fi >= t2n { fi = t2n - 1; }
    while fi >= 0 {
        if fi + 2 < t2n && str_slice(text2, fi, fi + 2) == "fn" {
            if fi == 0 || !is_id_char(char_at(text2, fi - 1)) { fnp = fi; break; }
        }
        if fi == 0 { break; }
        fi = fi - 1;
    }
    if fnp < 0 { println("ERR\tfix\tno enclosing fn"); process_exit(1); }
    let mut rp = -1;
    let mut lp0 = -1;
    let mut fpos = fnp;
    while fpos < t2n {
        if char_at(text2, fpos) == "(" { lp0 = fpos; break; }
        fpos = fpos + 1;
    }
    if lp0 >= 0 {
        let mut depth = 0;
        let mut k = lp0;
        while k < t2n {
            let c: String = char_at(text2, k);
            if c == "(" { depth = depth + 1; }
            else if c == ")" { depth = depth - 1; if depth == 0 { rp = k; break; } }
            k = k + 1;
        }
    }
    if rp < 0 { println("ERR\tfix\tno fn params"); process_exit(1); }
    let header: String = str_slice(text2, fnp, rp + 1);
    let hn = chars_len(header);
    let capn = chars_len(cap);
    let mut hi = 0;
    while hi + capn <= hn {
        if str_slice(header, hi, hi + capn) == cap { return text2; }
        hi = hi + 1;
    }
    let inner: String = str_slice(text2, fnp, rp);
    let mut lp = -1;
    let inlen = chars_len(inner);
    let mut ij = 0;
    while ij < inlen {
        if char_at(inner, ij) == "(" { lp = ij; break; }
        ij = ij + 1;
    }
    let params: String = str_slice(inner, lp + 1, inlen);
    let mut newp: String = pname + ": &" + cap;
    let mut pt = 0;
    let plen = chars_len(params);
    while pt < plen {
        if char_is_space(char_at(params, pt)) { pt = pt + 1; } else { break; }
    }
    if pt < plen { newp = params + ", " + newp; }
    let new_header: String = str_slice(inner, 0, lp + 1) + newp + ")";
    return str_slice(text2, 0, fnp) + new_header + str_slice(text2, rp + 1, t2n);
}

pub fn apply_etc(text: String, name: String, line_no: Int) -> String {
    let let_tag = "let " + name + " ";
    let lt_n = chars_len(let_tag);
    let text_n = chars_len(text);
    let mut ti = 0;
    while ti + lt_n <= text_n {
        if str_slice(text, ti, ti + lt_n) == let_tag { println("ERR\tfix\tlet " + name + " already present"); process_exit(1); }
        ti = ti + 1;
    }
    let mut at = 0;
    if line_no > 1 {
        let mut cur_line = 1;
        let mut li = 0;
        while li < text_n {
            if char_at(text, li) == "\n" {
                cur_line = cur_line + 1;
                if cur_line == line_no { at = li + 1; break; }
            }
            li = li + 1;
        }
    }
    let mut fnp = -1;
    let mut fi = at;
    if fi >= text_n { fi = text_n - 1; }
    while fi >= 0 {
        if fi + 2 < text_n && str_slice(text, fi, fi + 2) == "fn" {
            if fi == 0 || !is_id_char(char_at(text, fi - 1)) { fnp = fi; break; }
        }
        if fi == 0 { break; }
        fi = fi - 1;
    }
    if fnp < 0 { println("ERR\tfix\tno enclosing fn"); process_exit(1); }
    let mut rp = -1;
    let mut lp0 = -1;
    let mut fpos = fnp;
    while fpos < text_n {
        if char_at(text, fpos) == "(" { lp0 = fpos; break; }
        fpos = fpos + 1;
    }
    if lp0 >= 0 {
        let mut depth = 0;
        let mut k = lp0;
        while k < text_n {
            let c: String = char_at(text, k);
            if c == "(" { depth = depth + 1; }
            else if c == ")" { depth = depth - 1; if depth == 0 { rp = k; break; } }
            k = k + 1;
        }
    }
    if rp < 0 { println("ERR\tfix\tno fn params"); process_exit(1); }
    let mut brace = -1;
    let mut bj = rp;
    while bj < text_n {
        if char_at(text, bj) == "{" { brace = bj; break; }
        bj = bj + 1;
    }
    if brace < 0 { println("ERR\tfix\tno fn body"); process_exit(1); }
    let ins_str: String = "\n    let " + name + " = 0;";
    return str_slice(text, 0, brace + 1) + ins_str + str_slice(text, brace + 1, text_n);
}

pub fn apply_eparse(text: String) -> String {
    let n = chars_len(text);
    let mut i = 0;
    let mut opens = 0;
    let mut closes = 0;
    let mut in_str = false;
    while i < n {
        let c: String = char_at(text, i);
        if in_str {
            if c == "\\" { i = i + 2; continue; }
            if c == "\"" { in_str = false; }
            i = i + 1;
            continue;
        }
        if c == "\"" { in_str = true; i = i + 1; continue; }
        if c == "/" && i + 1 < n && char_at(text, i + 1) == "/" {
            while i < n {
                if char_at(text, i) == "\n" { break; }
                i = i + 1;
            }
            continue;
        }
        if c == "{" { opens = opens + 1; }
        if c == "}" { closes = closes + 1; }
        i = i + 1;
    }
    if opens <= closes { println("ERR\tfix\tcannot balance braces"); process_exit(1); }
    let mut out: String = text;
    let mut k = closes;
    while k < opens { out = out + "}"; k = k + 1; }
    return out;
}
