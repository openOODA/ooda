// # Drive ooda patch in the product CLI
//
// Logline: Replace one named function body from a body file without shell-eval.
//
// Setup: FsReadCap reads the target and body. FsWriteCap writes through write_file. ProcessCap checks symlinks. No scripts import.
//
// Beats:
//   1. Parse path, --replace-fn NAME, and --with BODYFILE.
//   2. Reject empty, absolute, or `..` paths. Require both files.
//   3. Find a unique fn NAME, splice the trimmed body, and write.

import "text.oo";

fn fail(msg: String, code: Int) {
    println("ERR\tpatch\t" + msg);
    process_exit(code);
}

fn is_ws(c: String) -> Bool {
    return c == " " || c == "\t" || c == "\n";
}

fn trim_s(s: String) -> String {
    let n: Int = chars_len(s);
    let mut a: Int = 0;
    let mut b: Int = n;
    while a < n {
        if is_ws(char_at(s, a)) { a = a + 1; } else { break; }
    }
    while b > a {
        if is_ws(char_at(s, b - 1)) { b = b - 1; } else { break; }
    }
    return str_slice(s, a, b);
}

fn indent_line(line: String) -> String {
    let ln: Int = chars_len(line);
    if ln == 0 { return line; }
    if ln >= 4 {
        if str_slice(line, 0, 4) == "    " { return line; }
    }
    return "    " + line;
}

fn format_body(body: String) -> String {
    let mut b_str: String = trim_s(body);
    let bn: Int = chars_len(b_str);
    if bn >= 2 {
        if char_at(b_str, 0) == "{" {
            if char_at(b_str, bn - 1) == "}" { b_str = trim_s(str_slice(b_str, 1, bn - 1)); }
        }
    }
    let mut out: String = "\n";
    let blen: Int = chars_len(b_str);
    let mut ls: Int = 0;
    let mut i: Int = 0;
    while i < blen {
        if char_at(b_str, i) == "\n" {
            let line: String = str_slice(b_str, ls, i);
            out = out + indent_line(line) + "\n";
            ls = i + 1;
        }
        i = i + 1;
    }
    if ls < blen {
        let last: String = str_slice(b_str, ls, blen);
        out = out + indent_line(last) + "\n";
    }
    return out;
}

fn replace_named(text: String, name: String, body: String) -> String {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut hits: Int = 0;
    let mut open_b: Int = -1;
    let mut close_b: Int = -1;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\"" {
            let mut sj: Int = i + 1;
            while sj < n {
                let sc: String = char_at(text, sj);
                if sc == "\\" { sj = sj + 2; continue; }
                if sc == "\"" { i = sj + 1; break; }
                sj = sj + 1;
            }
            if sj >= n { i = n; }
            continue;
        }
        if c == "/" {
            if i + 1 < n {
                if char_at(text, i + 1) == "/" {
                    while i < n {
                        if char_at(text, i) == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        let mut p: Int = i;
        if p + 3 <= n && str_slice(text, p, p + 3) == "pub" {
            let mut can_pub = true;
            if p > 0 {
                let prev: String = char_at(text, p - 1);
                if char_is_alpha(prev) || char_is_digit(prev) || prev == "_" { can_pub = false; }
            }
            if can_pub && p + 3 < n {
                let next: String = char_at(text, p + 3);
                if char_is_alpha(next) || char_is_digit(next) || next == "_" { can_pub = false; }
            }
            if can_pub {
                p = p + 3;
                while p < n {
                    if is_ws(char_at(text, p)) { p = p + 1; } else { break; }
                }
            }
        }
        let mut is_fn = false;
        if p + 2 <= n && str_slice(text, p, p + 2) == "fn" {
            let mut can_fn = true;
            if p > 0 {
                let prev2: String = char_at(text, p - 1);
                if char_is_alpha(prev2) || char_is_digit(prev2) || prev2 == "_" { can_fn = false; }
            }
            if can_fn && p + 2 < n {
                let next2: String = char_at(text, p + 2);
                if char_is_alpha(next2) || char_is_digit(next2) || next2 == "_" { can_fn = false; }
            }
            if can_fn { is_fn = true; }
        }
        if !is_fn { i = i + 1; continue; }
        let mut q: Int = p + 2;
        while q < n {
            if is_ws(char_at(text, q)) { q = q + 1; } else { break; }
        }
        let namelen = chars_len(name);
        if q + namelen > n || str_slice(text, q, q + namelen) != name { i = i + 1; continue; }
        if q + namelen < n {
            let next3: String = char_at(text, q + namelen);
            if char_is_alpha(next3) || char_is_digit(next3) || next3 == "_" { i = i + 1; continue; }
        }
        let mut rp: Int = q + namelen;
        while rp < n {
            if is_ws(char_at(text, rp)) { rp = rp + 1; } else { break; }
        }
        if rp >= n || char_at(text, rp) != "(" { i = i + 1; continue; }
        let mut depth_p: Int = 0;
        let mut pj: Int = rp;
        let mut afterp: Int = -1;
        while pj < n {
            let pc: String = char_at(text, pj);
            if pc == "(" { depth_p = depth_p + 1; }
            else if pc == ")" {
                depth_p = depth_p - 1;
                if depth_p == 0 { afterp = pj + 1; break; }
            }
            pj = pj + 1;
        }
        if afterp < 0 { i = i + 1; continue; }
        let mut bk: Int = afterp;
        let mut brace_pos: Int = -1;
        while bk < n {
            if char_at(text, bk) == "{" { brace_pos = bk; break; }
            bk = bk + 1;
        }
        if brace_pos < 0 { i = i + 1; continue; }
        let mut depth_b: Int = 0;
        let mut bj: Int = brace_pos;
        let mut afterb: Int = -1;
        while bj < n {
            let bc: String = char_at(text, bj);
            if bc == "{" { depth_b = depth_b + 1; }
            else if bc == "}" {
                depth_b = depth_b - 1;
                if depth_b == 0 { afterb = bj + 1; break; }
            }
            bj = bj + 1;
        }
        if afterb < 0 { i = i + 1; continue; }
        hits = hits + 1;
        open_b = brace_pos;
        close_b = afterb - 1;
        i = afterb;
    }
    if hits == 0 { fail("function not found: " + name, 1); return ""; }
    if hits > 1 { fail("ambiguous function: " + name, 1); return ""; }
    let inner: String = format_body(body);
    return str_slice(text, 0, open_b + 1) + inner + str_slice(text, close_b, n);
}

pub fn run_ooda_patch(fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) {
    let mut path: String = "";
    let mut name: String = "";
    let mut withf: String = "";
    let mut i: Int = 0;
    let alen: Int = list_len(args);
    while i < alen {
        let a: String = list_get(args, i);
        if a == "--replace-fn" {
            i = i + 1;
            if i >= alen { fail("--replace-fn needs name", 2); }
            name = list_get(args, i);
        } else if a == "--with" {
            i = i + 1;
            if i >= alen { fail("--with needs body file", 2); }
            withf = list_get(args, i);
        } else if chars_len(a) > 0 {
            if str_slice(a, 0, 1) != "-" {
                if path == "" { path = a; }
            }
        }
        i = i + 1;
    }
    if path == "" { fail("missing file", 2); }
    if name == "" || withf == "" { fail("need --replace-fn NAME --with BODYFILE", 2); }
    if path_bad(path) { fail("bad path: " + path, 2); }
    if path_bad(withf) { fail("bad path: " + withf, 2); }
    if !path_exists(fr, path) { fail("file not found: " + path, 2); }
    if !path_exists(fr, withf) { fail("file not found: " + withf, 2); }
    let tr: Result[String, String] = read_file(fr, path);
    if !tr.is_ok() { fail("cannot read " + path, 2); }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let br: Result[String, String] = read_file(fr, withf);
    if !br.is_ok() { fail("cannot read " + withf, 2); }
    let body: String = match br { Ok(s) => s, Err(m) => m };
    let next: String = replace_named(text, name, body);
    write_src(fr, fw, env, path, next);
    println("OK\tpatch\treplaced " + name + " in " + path);
    process_exit(0);
}
