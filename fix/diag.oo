// # Shared helpers for ooda fix
//
// Logline: Capture oodac check output and classify diagnostic markers.
//
// Setup: ProcessCap runs oodac check. No shell redirection or TTY probes.
//
// Beats:
//   1. check_text runs oodac check and returns stdout or stderr directly.
//   2. classify maps check text to ecap, etc, eparse, eimp, or emust.

import "text.oo";

fn digit_val(c: String) -> Int {
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    return 0;
}

fn is_digit_char(c: String) -> Bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
        return true;
    }
    return false;
}

pub fn fix_parse_int_digits(s: String) -> Int {
    let n = chars_len(s);
    let mut i = 0;
    let mut v = 0;
    while i < n {
        let c: String = char_at(s, i);
        if is_digit_char(c) {
            v = v * 10 + digit_val(c);
        }
        i = i + 1;
    }
    if v <= 0 {
        return 1;
    }
    return v;
}

pub fn check_text(proc: &ProcessCap, oodac: String, path: String) -> String {
    let r: Result[String, String] = sys_exec(proc, oodac, "check", path);
    return match r { Ok(s) => s, Err(e) => e };
}

pub fn classify(log: String) -> String {
    if find_sub(log, "unused Result") >= 0 || find_sub(log, "must-use") >= 0 || find_sub(log, "do not discard") >= 0 {
        return "emust";
    }
    if find_sub(log, "ERR\tcapability\t") >= 0 || find_sub(log, "E_CAP") >= 0 {
        return "ecap";
    }
    if find_sub(log, "undefined variable '") >= 0 || find_sub(log, "ERR\ttype\t") >= 0 || find_sub(log, "E_TC") >= 0 {
        return "etc";
    }
    if find_sub(log, "ERR\tparse\t") >= 0 {
        return "eparse";
    }
    if find_sub(log, "ERR\timport\t") >= 0 {
        return "eimp";
    }
    return "";
}
