// # Insert a missing import
//
// Logline: Infer an import path from a check log and splice it into the source.
//
// Setup: fix_text helpers and path_exists under FsReadCap are in scope.
//
// Beats:
//   1. Read a missing-import path from the check log.
//   2. Else map an undefined name to name.oo or std/name.oo when that file exists.
//   3. Insert import "spec"; after an existing import or at the top.

import "text.oo";

pub fn infer_import_spec(fr: &FsReadCap, log: String) -> String {
    let mark: String = "relative probes (dir/std/../std/../../std/../../../std): ";
    let ml = chars_len(mark);
    let logn = chars_len(log);
    let mut at = -1;
    let mut i = 0;
    while i + ml <= logn {
        if str_slice(log, i, i + ml) == mark { at = i; break; }
        i = i + 1;
    }
    if at >= 0 {
        let start: Int = at + ml;
        let mut end: Int = start;
        while end < logn {
            let c: String = char_at(log, end);
            if c == "\n" || c == "\t" { break; }
            end = end + 1;
        }
        if end > start { return str_slice(log, start, end); }
    }
    let left = "undefined variable '";
    let ll = chars_len(left);
    let mut la = -1;
    let mut j = 0;
    while j + ll <= logn {
        if str_slice(log, j, j + ll) == left { la = j; break; }
        j = j + 1;
    }
    if la >= 0 {
        let lstart = la + ll;
        let mut lb = -1;
        let mut k = lstart;
        while k < logn {
            if char_at(log, k) == "'" { lb = k; break; }
            k = k + 1;
        }
        if lb >= 0 {
            let name: String = str_slice(log, lstart, lb);
            if name != "" {
                if path_exists(fr, name + ".oo") { return name + ".oo"; }
                if path_exists(fr, "std/" + name + ".oo") { return "std/" + name + ".oo"; }
            }
        }
    }
    return "";
}

pub fn apply_eimp(text: String, spec: String) -> String {
    if spec == "" { println("ERR\tfix\tno import spec"); process_exit(1); }
    let line: String = "import \"" + spec + "\";\n";
    let pat = "import \"" + spec + "\"";
    let patl = chars_len(pat);
    let textn = chars_len(text);
    let mut i = 0;
    while i + patl <= textn {
        if str_slice(text, i, i + patl) == pat {
            println("ERR\tfix\timport already present");
            process_exit(1);
        }
        i = i + 1;
    }
    let imp_pat = "\nimport \"";
    let ipl = chars_len(imp_pat);
    let mut at = -1;
    let mut j = 0;
    while j + ipl <= textn {
        if str_slice(text, j, j + ipl) == imp_pat { at = j; break; }
        j = j + 1;
    }
    if at >= 0 { return str_slice(text, 0, at + 1) + line + str_slice(text, at + 1, textn); }
    return line + text;
}
