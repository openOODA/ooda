import "std/os/env.oo";

// # String helpers for ooda fix
//
// Logline: Find a substring, take a slice between marks, and test identifier characters.
//
// Setup: FsReadCap/FsWriteCap/EnvCap for write_src; char_at, chars_len, and str_slice are product builtins.
//
// Beats:
//   1. find_sub returns the first index or -1.
//   2. between returns the text after a start mark until an end mark.
//   3. ident helpers classify one character.

pub fn find_sub(s: String, sub: String) -> Int {
    let n = chars_len(s);
    let m = chars_len(sub);
    if m == 0 { return 0; }
    if m > n { return 0 - 1; }
    let mut i = 0;
    while i + m <= n {
        if str_slice(s, i, i + m) == sub { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn find_sub_from(s: String, sub: String, start: Int) -> Int {
    let n = chars_len(s);
    let m = chars_len(sub);
    if m == 0 { return start; }
    if start < 0 || start + m > n { return 0 - 1; }
    let mut i = start;
    while i + m <= n {
        if str_slice(s, i, i + m) == sub { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn between(s: String, left: String, right: String) -> String {
    let n = chars_len(s);
    let nl = chars_len(left);
    let nr = chars_len(right);
    if nl == 0 || nr == 0 { return ""; }
    let mut a: Int = 0 - 1;
    let mut i = 0;
    while i + nl <= n {
        if str_slice(s, i, i + nl) == left { a = i; break; }
        i = i + 1;
    }
    if a < 0 { return ""; }
    let start = a + nl;
    let mut b: Int = 0 - 1;
    let mut j = start;
    while j + nr <= n {
        if str_slice(s, j, j + nr) == right { b = j; break; }
        j = j + 1;
    }
    if b < 0 { return ""; }
    return str_slice(s, start, b);
}

pub fn is_ident_start(c: String) -> Bool {
    if char_is_alpha(c) || c == "_" { return true; }
    return false;
}

pub fn is_ident_char(c: String) -> Bool {
    if char_is_alpha(c) || char_is_digit(c) || c == "_" { return true; }
    return false;
}

pub fn skip_ws(s: String, pos: Int) -> Int {
    let n = chars_len(s);
    let mut i = pos;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1; } else { break; }
    }
    return i;
}

pub fn read_ident(s: String, pos: Int) -> String {
    let n = chars_len(s);
    if pos < 0 || pos >= n { return ""; }
    let c0: String = char_at(s, pos);
    if !char_is_alpha(c0) && c0 != "_" { return ""; }
    let mut i = pos + 1;
    while i < n {
        let c: String = char_at(s, i);
        if char_is_alpha(c) || char_is_digit(c) || c == "_" { i = i + 1; } else { break; }
    }
    return str_slice(s, pos, i);
}

pub fn line_start_at(s: String, line_no: Int) -> Int {
    if line_no <= 1 { return 0; }
    let n = chars_len(s);
    let mut line = 1;
    let mut i = 0;
    while i < n {
        if char_at(s, i) == "\n" {
            line = line + 1;
            if line == line_no { return i + 1; }
        }
        i = i + 1;
    }
    return 0;
}

pub fn is_ident_name(s: String) -> Bool {
    let n = chars_len(s);
    if n < 1 { return false; }
    let c0: String = char_at(s, 0);
    if !char_is_alpha(c0) && c0 != "_" { return false; }
    let mut i = 1;
    while i < n {
        let c: String = char_at(s, i);
        if !char_is_alpha(c) && !char_is_digit(c) && c != "_" { return false; }
        i = i + 1;
    }
    return true;
}

pub fn path_bad(p: String) -> Bool {
    if p == "" { return true; }
    if str_slice(p, 0, 1) == "/" { return true; }
    let n = chars_len(p);
    let mut i = 0;
    while i + 2 <= n {
        if str_slice(p, i, i + 2) == ".." { return true; }
        i = i + 1;
    }
    return false;
}

pub fn path_policy(p: String) -> Bool {
    let n = chars_len(p);
    let tag = "/.config/ooda/";
    let tn = chars_len(tag);
    let mut i = 0;
    while i + tn <= n {
        if str_slice(p, i, i + tn) == tag { return true; }
        i = i + 1;
    }
    let mut j = n;
    while j > 0 {
        if char_at(p, j - 1) == "/" { break; }
        j = j - 1;
    }
    let b: String = str_slice(p, j, n);
    if b == "SOUL.md" || b == "soul.md" || b == ".bashrc" || b == "ooda.lock" { return true; }
    let bn = chars_len(b);
    if bn >= 10 && str_slice(b, bn - 10, bn) == ".agent.pin" { return true; }
    return false;
}

pub fn write_src(fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, path: String, next: String) {
    let cwd_r: Result[String, String] = env_get(env, "PWD");
    if !cwd_r.is_ok() { println("ERR\tfix\tPWD not in environment"); process_exit(1); }
    let mut cwd: String = match cwd_r { Ok(s) => s, Err(_) => "" };
    let cn = chars_len(cwd);
    if cn > 0 && char_at(cwd, cn - 1) == "\n" { cwd = str_slice(cwd, 0, cn - 1); }
    if cwd == "" { println("ERR\tfix\tempty cwd for write_file"); process_exit(1); }
    if path_bad(path) { println("ERR\tfix\tbad path"); process_exit(2); }
    if path_policy(path) { println("ERR\tfix\tpolicy path"); process_exit(2); }
    if !path_exists(fr, cwd) { println("ERR\tfix\tcwd unreachable"); process_exit(2); }
    let abs: String = cwd + "/" + path;
    let wr = write_file(fw, abs, next);
    if wr.is_err() {
        let m: String = match wr { Ok(_) => "", Err(e) => e };
        println("ERR\tfix\t" + m);
        process_exit(1);
    }
}

pub fn log_stem(p: String) -> String {
    let n = chars_len(p);
    let mut i = 0;
    let mut out = ".ooda-cache/ooda-tmp/fix-";
    while i < n {
        let c: String = char_at(p, i);
        if c == "/" || c == "." { out = out + "_"; } else { out = out + c; }
        i = i + 1;
    }
    return out;
}
