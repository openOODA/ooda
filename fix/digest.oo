// # SHA-256 digest of a file
//
// Logline: Print the sha256 of a given file via crypto_sha256_internal.
//
// Setup: FsReadCap reads the file. No shell, no fallback.
//
// Beats:
//   1. Require a file path after the command; print usage when missing.
//   2. Hash file bytes with crypto_sha256_internal when readable.
//   3. Fail closed if the file is missing or the hash is not 64 hex digits.

pub fn run_ooda_digest(fr: &FsReadCap, args: List[String]) {
    let mut path: String = "";
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    if path == "" {
        println("usage: ooda digest <file>");
        return;
    }
    if !path_exists(fr, path) {
        println("ooda digest: unreadable file: " + path);
        return;
    }
    let tr: Result[String, String] = read_file(fr, path);
    if !tr.is_ok() {
        println("ooda digest: cannot read: " + path);
        return;
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let h: String = crypto_sha256_internal(text);
    if chars_len(h) == 64 {
        println(h);
        return;
    }
    println("ooda digest: hash failed for: " + path);
}
