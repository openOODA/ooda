// # E_MUST unused Result structural fix
//
// Logline: Wrap a discarded Result call in if call.is_err() { process_exit(1); }.
//
// Setup: fix_text line helpers. Edits are string replaces only.
//
// Beats:
//   1. Find name( on the error line.
//   2. Walk to the matching ); statement end.
//   3. Replace name(...); with if name(...).is_err() { process_exit(1); }.

import "text.oo";

pub fn apply_emust(text: String, name: String, line_no: Int) -> String {
    let nl = chars_len(name);
    if nl == 0 { println("ERR\tfix\tempty must-use name"); process_exit(1); }
    let c0 = char_at(name, 0);
    if !char_is_alpha(c0) && c0 != "_" { println("ERR\tfix\tbad must-use name"); process_exit(1); }
    let textn = chars_len(text);
    let mut at = 0;
    if line_no > 1 {
        let mut cur_line = 1;
        let mut li = 0;
        while li < textn {
            if char_at(text, li) == "\n" {
                cur_line = cur_line + 1;
                if cur_line == line_no { at = li + 1; break; }
            }
            li = li + 1;
        }
    }
    let mut start = -1;
    let mut round = 0;
    while round < 2 {
        let mut scan = at;
        if round == 1 { scan = 0; }
        while scan + nl <= textn {
            if str_slice(text, scan, scan + nl) == name {
                let hit = scan;
                let mut skip_match = false;
                if hit > 0 {
                    let prev = char_at(text, hit - 1);
                    if char_is_alpha(prev) || char_is_digit(prev) || prev == "_" { skip_match = true; }
                }
                if !skip_match {
                    let mut p = hit + nl;
                    while p < textn {
                        if char_is_space(char_at(text, p)) { p = p + 1; } else { break; }
                    }
                    if p < textn && char_at(text, p) == "(" {
                        let mut depth = 0;
                        let mut k = p;
                        while k < textn {
                            let c: String = char_at(text, k);
                            if c == "(" { depth = depth + 1; }
                            else if c == ")" {
                                depth = depth - 1;
                                if depth == 0 {
                                    let mut q = k + 1;
                                    while q < textn {
                                        if char_is_space(char_at(text, q)) { q = q + 1; } else { break; }
                                    }
                                    if q < textn && char_at(text, q) == ";" {
                                        start = hit;
                                        break;
                                    }
                                }
                            }
                            k = k + 1;
                        }
                        if start >= 0 { break; }
                    }
                }
            }
            scan = scan + 1;
        }
        if start >= 0 { break; }
        round = round + 1;
    }
    if start < 0 { println("ERR\tfix\tno discarded " + name + "( call"); process_exit(1); }
    let mut lp = -1;
    let mut si = start;
    while si < textn {
        if char_at(text, si) == "(" { lp = si; break; }
        si = si + 1;
    }
    if lp < 0 { println("ERR\tfix\tno statement end for " + name); process_exit(1); }
    let mut depth2 = 0;
    let mut k2 = lp;
    let mut semi = -1;
    while k2 < textn {
        let c: String = char_at(text, k2);
        if c == "(" { depth2 = depth2 + 1; }
        else if c == ")" {
            depth2 = depth2 - 1;
            if depth2 == 0 {
                let mut q2 = k2 + 1;
                while q2 < textn {
                    if char_is_space(char_at(text, q2)) { q2 = q2 + 1; } else { break; }
                }
                if q2 < textn && char_at(text, q2) == ";" { semi = q2; break; }
            }
        }
        k2 = k2 + 1;
    }
    if semi < 0 { println("ERR\tfix\tno statement end for " + name); process_exit(1); }
    let call: String = str_slice(text, start, semi);
    let wrapped: String = "if " + call + ".is_err() { process_exit(1); }";
    return str_slice(text, 0, start) + wrapped + str_slice(text, semi + 1, textn);
}
