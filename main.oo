// # Ooda Main — argv Router
//
// Logline: Parse argv under the ooda binary and dispatch to one of the 4 in-process subdirs (build, fix, fmt, token) or spawn one of the 3 external binaries (opm, lsp, mcp).
//
// Setup: argv[0] is the subcommand. argv[1..] (rest) are its args. Handlers see rest only. Spawn requires OODACODEX. No PATH.
//
// Beats:
//   1. The 4 in-process subdirs: build, fix, fmt, token.
//   2. The 3 spawn entries: opm, lsp, mcp. Bin path is $OODACODEX/bin/<name> only.
//   3. spawn() fails closed when OODACODEX is unset, the name is unsafe, or the bin is missing.
//   4. Unknown subcommand prints help and returns Err.

import "build/ANCHOR.oo";
import "fix/ANCHOR.oo";
import "fmt/ANCHOR.oo";
import "token/ANCHOR.oo";
import "std/fs/process/cmd.oo";
import "std/fs/file/path.oo";
import "std/fs/process/env.oo";


fn print_help() {
    println("ooda — openOODA tactical toolchain CLI");
    println("usage: ooda <subcommand> [args]");
    println("");
    println("in-process subcommands:");
    println("  build, run, gen, test, install, bench, init, context, health, fix, digest, fmt, token");
    println("");
    println("external packages (spawned; require OODACODEX):");
    println("  opm <subcmd>  — package manager");
    println("  lsp           — LSP server over stdio JSON-RPC");
    println("  mcp           — MCP server over stdio JSON-RPC");
    println("");
    println("see `ooda <subcommand> --help` for per-subcommand help.");
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if list_len(args) < 1 {
        print_help();
        return Err("ooda: missing subcommand");
    }
    let sub: String = list_get(args, 0);
    let rest: List[String] = list_slice(args, 1, list_len(args));

    if sub == "build"   { run_oodac_build(fs_r, fs_w, sys, env, rest); return Ok(0); }
    if sub == "run"     { run_oodac_run(fs_r, fs_w, sys, env, rest); return Ok(0); }
    if sub == "gen"     { run_ooda_gen(fs_w, rest); return Ok(0); }
    if sub == "test"    { run_ooda_test(fs_r, fs_w, sys, env, time, rest); return Ok(0); }
    if sub == "install" { run_ooda_install_cmd(fs_r, sys, env, fs_w, rest); return Ok(0); }
    if sub == "bench"   { run_ooda_bench(fs_r, sys, env, time, rest); return Ok(0); }
    if sub == "context" { run_ooda_context(fs_r, rest); return Ok(0); }
    if sub == "health"  { run_ooda_health(fs_r, env, rest); return Ok(0); }
    if sub == "init" {
        let name: String = if list_len(rest) > 0 { list_get(rest, 0) } else { "myproject" };
        let r: Result[String, String] = cli_init_project(fs_r, fs_w, name);
        if r.is_err() {
            let e: String = match r { Ok(_) => "", Err(m) => m };
            return Err(e);
        }
        let msg: String = match r { Ok(m) => m, Err(_) => "" };
        println(msg);
        return Ok(0);
    }

    if sub == "fix"    { run_ooda_fix(fs_r, fs_w, sys, env, rest); return Ok(0); }
    if sub == "digest" { run_ooda_digest(fs_r, rest); return Ok(0); }

    if sub == "fmt" { return Ok(run_ooda_fmt(fs_r, fs_w, alloc, rest)); }

    if sub == "token" { run_ooda_token(fs_r, sys, time, fs_w, rest); return Ok(0); }

    if sub == "opm" { return spawn(fs_r, env, sys, "opm", rest); }
    if sub == "lsp" { return spawn(fs_r, env, sys, "lsp", rest); }
    if sub == "mcp" { return spawn(fs_r, env, sys, "mcp", rest); }

    print_help();
    return Err("ooda: unknown subcommand: " + sub);
}
