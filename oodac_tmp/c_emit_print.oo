// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: lower CHS expr tokens to C snippets (list/string builtins)
// in:  toks + start pos (at first expr token)
// out: via side-effect helpers; c_emit_expr_c returns C text, advances via c_emit_expr_end
// stage: emit

// Map known call names to C runtime (empty string = unknown).

pub fn c_emit_println(toks: List[String], pos: Int, n: Int, env: String) -> Int {
    let mut p = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }
    let mut cont = true;
    while cont {
        if p >= n || field_at(list_get(toks, p), 0) == "RPAREN" {
            cont = false;
            break;
        }
        let pr = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(pr, 0));
        let arg = list_get(pr, 1);
        let mut is_str = c_expr_is_str_env(arg, env);
        let mut is_bool = false;
        if chars_len(arg) >= 10 && char_at(arg, 3) == "c" && char_at(arg, 4) == "h" && char_at(arg, 5) == "a" {
            if char_at(arg, 8) == "i" { is_bool = true; is_str = false; }
        }
        if is_str {
            println("  oo_print_str(" + arg + ");");
        } else if is_bool {
            println("  oo_print_bool(" + arg + ");");
        } else {
            println("  oo_print_int(" + arg + ");");
        }
        if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
            p = p + 1;
        } else {
            cont = false;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    println("  oo_println();");
    return p;
}


