// job: Backend-C emission from tokens (floor: runtime/chs_rt)
// stage: emit
// package: backend-c — see bootstrap/FLOOR.md
// in: source/toks + list-kind env; out: printed C

pub fn c_emit_stream(src: String) {
    c_emit_stream_mode(src, "all");
}

pub fn c_emit_stream_mode(src: String, mode: String) {
    if mode == "all" || mode == "preamble" {
        c_emit_preamble();
    }
    if mode == "preamble" {
        return;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    // Program-level: __fr__name=T for String-returning fns (println bare calls).
    let mut fn_env = "";
    
    if mode == "all" {
        while pos < n {
            let k = field_at(list_get(toks, pos), 0);
            if k == "EOF" {
                pos = n;
            } else if k == "KW_PUB" || k == "KW_FN" {
                let fr: List[String] = c_emit_fn_mode(toks, pos, n, fn_env, "protos");
                pos = parse_int(list_get(fr, 0));
                fn_env = list_get(fr, 1);
            } else if k == "KW_VERIFY" {
                pos = c_emit_skip_verify(toks, pos, n);
            } else if k == "KW_TYPE" || k == "KW_IMPORT" {
                pos = skip_until_semi(toks, pos);
            } else {
                println("ERR\tc_emit\tunexpected " + k);
                process_exit(1);
            }
        }
        pos = 0;
    }
    
    let mut bmode = mode;
    if mode == "all" { bmode = "bodies"; }
    
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let fr: List[String] = c_emit_fn_mode(toks, pos, n, fn_env, bmode);
            pos = parse_int(list_get(fr, 0));
            fn_env = list_get(fr, 1);
        } else if k == "KW_VERIFY" {
            pos = c_emit_skip_verify(toks, pos, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            println("ERR\tc_emit\tunexpected " + k);
            process_exit(1);
        }
    }
}

// returns [new_pos_str, env]
pub fn c_emit_block(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut e = env;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    e = c_env_push_scope(e);
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            e = c_emit_scope_exit(e);
            p = p + 1;
            break;
        }
        let st = c_emit_stmt(toks, p, n, e);
        p = parse_int(list_get(st, 0));
        e = list_get(st, 1);
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, e);
    return out;
}
