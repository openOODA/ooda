// job: call in binop context; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_call_binop_lits(toks: List[String]) {
    let n = list_len(toks);
    let ret_table = build_fn_ret_table(toks);
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if is_type_binop(k) {
            // skip order/eq (handled elsewhere) for clearer messages — still use combine for all
            // pattern: IDENT LPAREN RPAREN OP LIT
            if i >= 3 {
                if field_at(list_get(toks, i - 3), 0) == "IDENT" {
                    if field_at(list_get(toks, i - 2), 0) == "LPAREN" {
                        if field_at(list_get(toks, i - 1), 0) == "RPAREN" {
                            if i + 1 < n {
                                let rty = lit_token_type(field_at(list_get(toks, i + 1), 0));
                                if rty != "" {
                                    let cname = field_at(list_get(toks, i - 3), 3);
                                    let got = resolve_type_alias(ret_table, cname);
                                    if got != cname {
                                        let gty = resolve_type_alias(aliases, got);
                                        let comb = combine_binop_types(k, gty, rty);
                                        if comb == "ERR_BINOP" {
                                            let line = field_at(list_get(toks, i), 1);
                                            let col = field_at(list_get(toks, i), 2);
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": incompatible operand types for binary operator"
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // pattern: LIT OP IDENT LPAREN RPAREN
            if i > 0 {
                if i + 3 < n {
                    let lty = lit_token_type(field_at(list_get(toks, i - 1), 0));
                    if lty != "" {
                        if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                            if field_at(list_get(toks, i + 2), 0) == "LPAREN" {
                                if field_at(list_get(toks, i + 3), 0) == "RPAREN" {
                                    let cname = field_at(list_get(toks, i + 1), 3);
                                    let got = resolve_type_alias(ret_table, cname);
                                    if got != cname {
                                        let gty = resolve_type_alias(aliases, got);
                                        let comb = combine_binop_types(k, lty, gty);
                                        if comb == "ERR_BINOP" {
                                            let line = field_at(list_get(toks, i), 1);
                                            let col = field_at(list_get(toks, i), 2);
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": incompatible operand types for binary operator"
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Fail-closed: `g() && true` when g returns non-Bool.
