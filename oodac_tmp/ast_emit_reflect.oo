// job: ast reflect emission
// in: source toks; out: printed json reflect

pub fn ast_emit_reflect(src: String, filter_sym: String) {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    let mut found = false;
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let is_pub = (k == "KW_PUB");
            let mut fn_pos = pos;
            if is_pub { fn_pos = fn_pos + 1; }
            if fn_pos < n && field_at(list_get(toks, fn_pos), 0) == "KW_FN" {
                if fn_pos + 1 < n && field_at(list_get(toks, fn_pos + 1), 0) == "IDENT" {
                    let fn_name = field_at(list_get(toks, fn_pos + 1), 3);
                    if filter_sym != "" && fn_name == filter_sym {
                        found = true;
                    }
                }
            }
            pos = emit_fn_reflect(toks, pos, n, is_pub, filter_sym);
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            let mut vname = "";
            if pos < n { 
                if field_at(list_get(toks, pos), 0) == "IDENT" { 
                    vname = field_at(list_get(toks, pos), 3);
                    pos = pos + 1; 
                } 
            }
            if vname != "" {
                if filter_sym == "" || vname == filter_sym {
                    if filter_sym != "" && vname == filter_sym { found = true; }
                    println("{\"kind\":\"verify\",\"name\":\"" + vname + "\"}");
                }
            }
            if pos < n { if field_at(list_get(toks, pos), 0) == "LBRACE" { pos = skip_balanced(toks, pos); } }
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
    if filter_sym != "" && !found {
        println("ERR\treflect\tsymbol not found: " + filter_sym);
        process_exit(1);
    }
}

pub fn emit_fn_reflect(toks: List[String], pos0: Int, n: Int, is_pub: Bool, filter_sym: String) -> Int {
    let mut pos = pos0;
    let mut pub_str = "false";
    if is_pub { pub_str = "true"; }
    
    if field_at(list_get(toks, pos), 0) == "KW_PUB" {
        pos = pos + 1;
    }
    if field_at(list_get(toks, pos), 0) != "KW_FN" {
        return pos;
    }
    pos = pos + 1;
    let name = field_at(list_get(toks, pos), 3);
    pos = pos + 1; // name
    pos = pos + 1; // (
    let mut params = "[";
    let mut caps = "[";
    let mut first_p = true;
    let mut first_c = true;
    
    while pos < n {
        let pk = field_at(list_get(toks, pos), 0);
        if pk == "RPAREN" {
            pos = pos + 1;
            break;
        }
        if pk == "COMMA" {
            pos = pos + 1;
        } else if pk == "AMP" {
            pos = pos + 1;
            let pname = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                pos = pos + 1;
                let mut pty = field_at(list_get(toks, pos), 3);
                if pty == "FsCap" || pty == "NetCap" || pty == "SysCap" || pty == "EnvCap" {
                    if !first_c { caps = caps + ","; }
                    caps = caps + "\"" + pty + "\"";
                    first_c = false;
                }
                pos = pos + 1;
                while pos < n {
                    let nk = field_at(list_get(toks, pos), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    pos = pos + 1;
                }
            }
        } else if pk == "IDENT" {
            let pname = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            let mut pty = "";
            if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                pos = pos + 1;
                if pos < n && field_at(list_get(toks, pos), 0) == "AMP" {
                    pty = "&";
                    pos = pos + 1;
                }
                while pos < n {
                    let nk = field_at(list_get(toks, pos), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    pty = pty + field_at(list_get(toks, pos), 3);
                    pos = pos + 1;
                }
            }
            if pty == "&FsCap" || pty == "FsCap" || pty == "&NetCap" || pty == "NetCap" || pty == "&SysCap" || pty == "SysCap" || pty == "&EnvCap" || pty == "EnvCap" {
                let mut cname = pty;
                if str_slice(cname, 0, 1) == "&" { cname = str_slice(cname, 1, chars_len(cname)); }
                if !first_c { caps = caps + ","; }
                caps = caps + "\"" + cname + "\"";
                first_c = false;
            }
            if !first_p { params = params + ","; }
            first_p = false;
            params = params + "{\"name\":\"" + pname + "\",\"type\":\"" + pty + "\"}";
        } else {
            pos = pos + 1;
        }
    }
    params = params + "]";
    caps = caps + "]";
    
    let mut ret_ty = "";
    if pos < n && field_at(list_get(toks, pos), 0) == "ARROW" {
        pos = pos + 1;
        while pos < n {
            let rk = field_at(list_get(toks, pos), 0);
            if rk == "LBRACE" || rk == "KW_REQUIRES" || rk == "KW_ENSURES" { break; }
            ret_ty = ret_ty + field_at(list_get(toks, pos), 3);
            pos = pos + 1;
        }
    }
    
    let mut reqs = "[";
    let mut enss = "[";
    let mut first_r = true;
    let mut first_e = true;
    
    while pos < n {
        let bk = field_at(list_get(toks, pos), 0);
        if bk == "LBRACE" {
            pos = skip_balanced(toks, pos);
            break;
        } else if bk == "KW_REQUIRES" {
            pos = pos + 1;
            let mut c = "";
            while pos < n {
                let nk = field_at(list_get(toks, pos), 0);
                if nk == "KW_REQUIRES" || nk == "KW_ENSURES" || nk == "LBRACE" { break; }
                let val = field_at(list_get(toks, pos), 3);
                if c != "" { c = c + " "; }
                c = c + val;
                pos = pos + 1;
            }
            if !first_r { reqs = reqs + ","; }
            reqs = reqs + "\"" + c + "\"";
            first_r = false;
        } else if bk == "KW_ENSURES" {
            pos = pos + 1;
            let mut c = "";
            while pos < n {
                let nk = field_at(list_get(toks, pos), 0);
                if nk == "KW_REQUIRES" || nk == "KW_ENSURES" || nk == "LBRACE" { break; }
                let val = field_at(list_get(toks, pos), 3);
                if c != "" { c = c + " "; }
                c = c + val;
                pos = pos + 1;
            }
            if !first_e { enss = enss + ","; }
            enss = enss + "\"" + c + "\"";
            first_e = false;
        } else {
            pos = pos + 1;
        }
    }
    reqs = reqs + "]";
    enss = enss + "]";
    
    let mut ret_json = "null";
    if ret_ty != "" { ret_json = "\"" + ret_ty + "\""; }
    
    if filter_sym == "" || name == filter_sym {
        println("{\"kind\":\"fn\",\"name\":\"" + name + "\",\"pub\":" + pub_str + ",\"params\":" + params + ",\"ret\":" + ret_json + ",\"requires\":" + reqs + ",\"ensures\":" + enss + ",\"caps\":" + caps + "}");
    }
    
    return pos;
}
