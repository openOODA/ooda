// job: check return type vs expected; stage: typecheck

pub fn ann_check_return(toks: List[String], i: Int, n: Int, in_fn: Bool, expected_ret: String, lit_env: String, struct_table: String, line: String, col: String) {
    if in_fn {
        if expected_ret != "" {
            if i + 1 < n {
                let ik = field_at(list_get(toks, i + 1), 0);
                let mut rty = lit_token_type(ik);
                if rty == "" {
                    if ik == "IDENT" {
                        let mut re = i + 1;
                        let mut cont_r = true;
                        while cont_r {
                            if re >= n {
                                cont_r = false;
                            } else {
                                if field_at(list_get(toks, re), 0) == "SEMI" {
                                    cont_r = false;
                                } else {
                                    re = re + 1;
                                }
                            }
                        }
                        if is_field_chain_span(toks, i + 1, re) {
                            let fty = field_chain_type(
                                toks,
                                i + 1,
                                re,
                                lit_env,
                                struct_table
                            );
                            if fty != "" {
                                rty = fty;
                            }
                        }
                        if rty == "" {
                            if i + 2 < n {
                                if field_at(list_get(toks, i + 2), 0) == "SEMI" {
                                    let rn = field_at(list_get(toks, i + 1), 3);
                                    let got = resolve_type_alias(lit_env, rn);
                                    if got != rn {
                                        rty = got;
                                    }
                                }
                            }
                        }
                    }
                }
                if rty != "" {
                    if !types_compatible(expected_ret, rty) {
                        println(
                            "ERR\ttype\tType error at "
                                + line
                                + ":"
                                + col
                                + ": return type "
                                + rty
                                + " does not match declared "
                                + expected_ret
                        );
                        process_exit(1);
                    }
                }
            }
        }
    }
}
