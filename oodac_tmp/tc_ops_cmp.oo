// job: cmp and rejected operators; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_cmp_numeric_lits(toks: List[String]) {
    let n = list_len(toks);
    let lit_env = build_pure_lit_env(toks);
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        let mut is_ord = false;
        if k == "LT" {
            is_ord = true;
        } else if k == "GT" {
            is_ord = true;
        } else if k == "LTE" {
            is_ord = true;
        } else if k == "GTE" {
            is_ord = true;
        }
        if is_ord {
            if i > 0 {
                if i + 1 < n {
                    let lty = atom_type_with_env(toks, i - 1, lit_env);
                    let rty = atom_type_with_env(toks, i + 1, lit_env);
                    if lty != "" {
                        if rty != "" {
                            let line = field_at(list_get(toks, i), 1);
                            let col = field_at(list_get(toks, i), 2);
                            let mut ok = false;
                            if lty == "Int" {
                                if rty == "Int" {
                                    ok = true;
                                }
                            }
                            if lty == "Float" {
                                if rty == "Float" {
                                    ok = true;
                                }
                            }
                            if !ok {
                                println(
                                    "ERR\ttype\tType error at "
                                        + line
                                        + ":"
                                        + col
                                        + ": comparison requires matching numeric types (both Int or both Float), found "
                                        + lty
                                        + " and "
                                        + rty
                                );
                                process_exit(1);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// `1 << 2` / `1 >> 2` tokenize as LT LT / GT GT — fail-closed (stage-0 parse fails).
pub fn typecheck_reject_shift_ops(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    while i + 1 < n {
        let k = field_at(list_get(toks, i), 0);
        let k2 = field_at(list_get(toks, i + 1), 0);
        let mut is_shift = false;
        let mut op = "";
        if k == "LT" {
            if k2 == "LT" {
                is_shift = true;
                op = "<<";
            }
        }
        if k == "GT" {
            if k2 == "GT" {
                is_shift = true;
                op = ">>";
            }
        }
        if is_shift {
            if i > 0 {
                if i + 2 < n {
                    let pk = field_at(list_get(toks, i - 1), 0);
                    let nk = field_at(list_get(toks, i + 2), 0);
                    if is_value_token_kind(pk) {
                        if is_value_token_kind(nk) {
                            let line = field_at(list_get(toks, i), 1);
                            let col = field_at(list_get(toks, i), 2);
                            println(
                                "ERR\ttype\tType error at "
                                    + line
                                    + ":"
                                    + col
                                    + ": unsupported operator '"
                                    + op
                                    + "' (no shift ops in R1 check)"
                            );
                            process_exit(1);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Binary `&` / `|` (not `&&` / `||`) are not R1 product ops — fail-closed.
// Skip type-position `&Cap` (AMP after COLON or as sole param marker).
pub fn typecheck_reject_amp_pipe_binop(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "AMP" || k == "PIPE" {
            let mut bin = false;
            if i > 0 {
                if i + 1 < n {
                    let pk = field_at(list_get(toks, i - 1), 0);
                    let nk = field_at(list_get(toks, i + 1), 0);
                    if is_value_token_kind(pk) {
                        if is_value_token_kind(nk) {
                            bin = true;
                        }
                    }
                }
            }
            if bin {
                let line = field_at(list_get(toks, i), 1);
                let col = field_at(list_get(toks, i), 2);
                let op = field_at(list_get(toks, i), 3);
                println(
                    "ERR\ttype\tType error at "
                        + line
                        + ":"
                        + col
                        + ": unsupported operator '"
                        + op
                        + "' (use && / || for logic; no bitwise ops in R1 check)"
                );
                process_exit(1);
            }
        }
        i = i + 1;
    }
}

// Pure-lit / lit-env `&&` / `||`: both sides must be Bool when known.
