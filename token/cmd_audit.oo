// # ooda token audit helper
//
// Logline: Scans directory for .oo files, checks verbose headers and monoreads, outputs human or JSON report.
//
// Setup: Imports token_optimizer, caps_audit, and json_envelope. Pure .oo.
//
// Beats:
//   1. Scan directory for .oo files.
//   2. Run optimization checks.
//   3. Emit JSON envelope or human report.

import "std/app/agent/token/token_optimizer.oo";
import "std/app/agent/token/caps_audit.oo";
import "std/app/agent/token/json_envelope.oo";

pub fn cmd_token_audit_run(fr: &FsReadCap, dir: String, human: Bool) {
    let entries: List[String] = oo_fs_read_dir(fr, dir);
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    let mut files_scanned: Int = 0;
    let mut report: OptimizationReport = optimization_report_new();
    while i < n {
        let name: String = list_get(entries, i);
        if str_ends_with(name, ".oo") {
            let full: String = dir + "/" + name;
            let tr: Result[String, String] = read_file(fr, full);
            if tr.is_ok() {
                let text: String = tr.unwrap();
                let mut lines: List[String] = list_new();
                let len_t: Int = chars_len(text);
                let mut j: Int = 0;
                let mut start: Int = 0;
                while j < len_t {
                    if char_at(text, j) == "\n" {
                        lines = list_push(lines, str_slice(text, start, j));
                        start = j + 1;
                    }
                    j = j + 1;
                }
                report = optimization_check_verbose_headers(report, full, lines);
                report = optimization_check_monolithic_reads(report, full, lines, 256);
                report = optimization_check_redundant_diags(report, full, lines);
                files_scanned = files_scanned + 1;
            }
        }
        i = i + 1;
    }
    report = optimization_finalize(report, files_scanned);
    if human {
        println("ooda token audit: " + dir);
        println("-----------------");
        let rep_str: String = optimization_format_report(report);
        println(rep_str);
        return;
    }
    let body: String = "{\"dir\":\"" + json_escape(dir) + "\",\"files_scanned\":" + files_scanned.to_string() + ",\"suggestions\":" + (report).suggestions_count.to_string() + ",\"tokens_wasted\":" + (report).total_tokens_wasted.to_string() + "}";
    let out: String = envelope_wrap("audit", "main", 0, body);
    println(out);
}

pub fn cmd_token_self_audit_run(fr: &FsReadCap, dir: String, human: Bool) {
    let entries: List[String] = oo_fs_read_dir(fr, dir);
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    let mut report: CapsAuditReport = caps_audit_report_new();
    while i < n {
        let name: String = list_get(entries, i);
        if str_ends_with(name, ".oo") {
            let full: String = dir + "/" + name;
            let tr: Result[String, String] = read_file(fr, full);
            if tr.is_ok() {
                let text: String = tr.unwrap();
                let mut lines: List[String] = list_new();
                let len_t: Int = chars_len(text);
                let mut j: Int = 0;
                let mut start: Int = 0;
                while j < len_t {
                    if char_at(text, j) == "\n" {
                        lines = list_push(lines, str_slice(text, start, j));
                        start = j + 1;
                    }
                    j = j + 1;
                }
                report = caps_audit_check_file(report, full, lines);
            }
        }
        i = i + 1;
    }
    if human {
        println("ooda token self_audit: " + dir);
        println("------------------------");
        let rep_str: String = caps_audit_format_report(report);
        println(rep_str);
        return;
    }
    let findings_count: Int = (report).missing_count + (report).unused_count + (report).no_header_count;
    let body: String = "{\"dir\":\"" + json_escape(dir) + "\",\"files_scanned\":" + (report).files_scanned.to_string() + ",\"functions_scanned\":" + (report).functions_scanned.to_string() + ",\"missing\":" + (report).missing_count.to_string() + ",\"no_header\":" + (report).no_header_count.to_string() + ",\"findings\":" + findings_count.to_string() + "}";
    let out: String = envelope_wrap("self_audit", "main", 0, body);
    println(out);
}
