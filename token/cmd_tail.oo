// # Tail mode: read a JSONL file and emit the strict parse stats
//
// Logline: Read a JSONL file from disk and emit strict parse stats as a versioned JSON envelope.
//
// Setup: FsCap reads the file. Pure .oo — covers W8 tail mode for now (full streaming is residual).
//
// Beats:
//   1. Read the JSONL file once.
//   2. Run the strict parser on the full text.
//   3. Emit a versioned JSON envelope with lines_total, lines_parsed, lines_failed.

import "std/app/agent/token/jsonl_strict.oo";
import "std/app/agent/token/json_envelope.oo";

pub fn run_ooda_token_tail(fr: &FsReadCap, args: List[String]) {
    if list_len(args) < 1 {
        let m: String = "{\"ok\":false,\"error\":\"usage: ooda token tail <file.jsonl>\"}\n";
        println(m);
        return;
    }
    let path: String = list_get(args, 0);
    let tr: Result[String, String] = read_file(fr, path);
    if tr.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot read: " + path + "\"}\n";
        println(m);
        return;
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let stats: ParseStats = jsonl_strict_parse_transcript(text);
    let mut body: String = "{";
    body = body + "\"file\":\"" + json_escape(path) + "\"";
    body = body + ",\"lines_total\":" + (stats).lines_total.to_string();
    body = body + ",\"lines_parsed\":" + (stats).lines_parsed.to_string();
    body = body + ",\"lines_failed\":" + (stats).lines_failed.to_string();
    let errs: List[String] = (stats).errors;
    let nerr: Int = list_len(errs);
    body = body + ",\"error_count\":" + nerr.to_string();
    body = body + "}";
    let out: String = envelope_wrap("tail", "default", 0, body);
    println(out);
}
