// # Extra token status, audit, and heatmap helpers
//
// Logline: Hold ledger status-from-file, directory audit, and heatmap text so cmd_token.oo stays under 256 lines.
//
// Setup: FsCap reads .oo sources and jsonl ledgers. Imports token_opt telemetry, optimizer, heatmap, and envelope.
//
// Beats:
//   1. Summarize a jsonl token ledger as human or JSON status.
//   2. Audit a directory of .oo files for optimizer findings.
//   3. Render a heatmap string over .oo names.

import "std/compile/token_opt/token_telemetry.oo";
import "std/compile/token_opt/json_envelope.oo";
import "std/compile/token_opt/tool_heatmap.oo";
import "std/compile/token_opt/baseline.oo";

pub fn parse_int_local(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { acc = acc * 10; }
        else if c == "1" { acc = acc * 10 + 1; }
        else if c == "2" { acc = acc * 10 + 2; }
        else if c == "3" { acc = acc * 10 + 3; }
        else if c == "4" { acc = acc * 10 + 4; }
        else if c == "5" { acc = acc * 10 + 5; }
        else if c == "6" { acc = acc * 10 + 6; }
        else if c == "7" { acc = acc * 10 + 7; }
        else if c == "8" { acc = acc * 10 + 8; }
        else if c == "9" { acc = acc * 10 + 9; }
        else { return acc; }
        i = i + 1;
    }
    return acc;
}

pub fn cmd_token_status_from_file(fr: &FsReadCap, path: String, human: Bool) {
    let tr: Result[String, String] = read_file(fr, path);
    if tr.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot read: " + path + "\"}\n";
        println(m);
        return;
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let mut ledger: SessionTokenLedger = session_token_ledger_new(path);
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut idx: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let raw: String = str_slice(text, start, i);
                let prompt_b: Int = chars_len(raw);
                let mut m: TokenTurnMetric = token_turn_metric_zero(idx, "INGEST");
                m = token_turn_metric_record(m, prompt_b, 0, 0, 0, 0, 0);
                ledger = session_ledger_ingest(ledger, m);
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let total: Int = session_ledger_total_tokens(ledger);
    let b: BaselineRecord = baseline_load_default(fr);
    let eff: Int = (b).efficiency_milli;
    let eff_x10: Int = eff / 1000;
    let eff_frac: Int = (eff - (eff_x10 * 1000)) / 100;
    if human {
        println("ooda token status (from " + path + ")");
        println("--------------------------------");
        println("session:           " + path);
        println("prompt_tokens:     " + (ledger).total_prompt_tokens.to_string());
        println("completion_tokens: " + (ledger).total_completion_tokens.to_string());
        println("tool_payload:      " + (ledger).total_tool_payload_bytes.to_string() + " bytes");
        println("thinking_ms:       " + (ledger).total_thinking_ms.to_string());
        let eff_line: String = "efficiency:        " + eff_x10.to_string() + "." + eff_frac.to_string() + "x (" + (b).source + ")";
        println(eff_line);
        return;
    }
    let mut body: String = "{";
    body = body + "\"session\":\"" + json_escape(path) + "\"";
    body = body + ",\"prompt_tokens\":" + (ledger).total_prompt_tokens.to_string();
    body = body + ",\"completion_tokens\":" + (ledger).total_completion_tokens.to_string();
    body = body + ",\"tool_payload_bytes\":" + (ledger).total_tool_payload_bytes.to_string();
    body = body + ",\"thinking_ms\":" + (ledger).total_thinking_ms.to_string();
    body = body + ",\"total_tokens\":" + total.to_string();
    body = body + ",\"efficiency_milli\":" + eff.to_string();
    body = body + ",\"efficiency_source\":\"" + (b).source + "\"";
    body = body + "}";
    let out: String = envelope_wrap("status", path, 0, body);
    println(out);
}

pub fn cmd_token_heatmap_text(fr: &FsReadCap, dir: String) -> String {
    let entries: List[String] = oo_fs_read_dir(fr, dir);
    let n: Int = list_len(entries);
    let mut h: Heatmap = heatmap_new(20);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(entries, i);
        if str_ends_with(name, ".oo") {
            let b: Int = name.len() * 40;
            let e: HeatmapEntry = heatmap_entry_new(name, 1, b);
            h = heatmap_ingest(h, e);
        }
        i = i + 1;
    }
    let sorted: Heatmap = heatmap_sort_desc(h);
    let final_h: Heatmap = heatmap_finalize(sorted);
    return heatmap_render(final_h);
}
