// # ooda token enforce --max-tokens
//
// Logline: Active budget tripwire: ingest a jsonl ledger, run budget_check, return ARMED (within cap) or TRIPPED (over cap).
//
// Setup: Pure .oo. FsCap reads the ledger. Flag-only CLI: --max-tokens / --max-prompt / --max-total / --cost-micro. A positional <file> may accompany the flags.
//
// Beats:
//   1. Parse --max-tokens / --max-prompt / --max-total / --cost-micro (flags required).
//   2. Read the jsonl ledger, accumulate prompt_tokens via session_ledger_ingest.
//   3. Build a BudgetCap, run budget_check, emit a decision envelope.
//   4. JSON default; --human prints a human tripwire report.

import "std/compile/token_opt/budget_enforce.oo";
import "std/compile/token_opt/json_envelope.oo";
import "std/compile/token_opt/token_telemetry.oo";

fn enforce_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { acc = acc * 10; }
        else if c == "1" { acc = acc * 10 + 1; }
        else if c == "2" { acc = acc * 10 + 2; }
        else if c == "3" { acc = acc * 10 + 3; }
        else if c == "4" { acc = acc * 10 + 4; }
        else if c == "5" { acc = acc * 10 + 5; }
        else if c == "6" { acc = acc * 10 + 6; }
        else if c == "7" { acc = acc * 10 + 7; }
        else if c == "8" { acc = acc * 10 + 8; }
        else if c == "9" { acc = acc * 10 + 9; }
        else { return acc; }
        i = i + 1;
    }
    return acc;
}

fn enforce_admit_str(b: Bool) -> String {
    if b { return "true"; }
    return "false";
}

pub fn cmd_token_enforce_budget_v2(fr: &FsReadCap, args: List[String], human: Bool) {
    let mut src: String = "";
    let mut max_p: Int = 0;
    let mut max_t: Int = 0;
    let mut cost: Int = 0;
    let mut saw_flag: Bool = false;
    let mut i: Int = 2;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--max-tokens" {
            if i + 1 < list_len(args) {
                i = i + 1;
                let val_str: String = list_get(args, i);
                max_p = enforce_parse_int(val_str);
                max_t = max_p;
                saw_flag = true;
            }
        } else if a == "--max-prompt" {
            if i + 1 < list_len(args) {
                i = i + 1;
                let val_str: String = list_get(args, i);
                max_p = enforce_parse_int(val_str);
                saw_flag = true;
            }
        } else if a == "--max-total" {
            if i + 1 < list_len(args) {
                i = i + 1;
                let val_str: String = list_get(args, i);
                max_t = enforce_parse_int(val_str);
                saw_flag = true;
            }
        } else if a == "--cost-micro" {
            if i + 1 < list_len(args) {
                i = i + 1;
                let val_str: String = list_get(args, i);
                cost = enforce_parse_int(val_str);
                saw_flag = true;
            }
        } else if str_slice(a, 0, 1) != "-" {
            if src == "" { src = a; }
        }
        i = i + 1;
    }
    if !saw_flag {
        let m: String = "{\"ok\":false,\"error\":\"usage: ooda token enforce --max-tokens N [--max-prompt P --max-total T --cost-micro C] [<file.jsonl>]}\n";
        println(m);
        return;
    }
    if max_t < max_p { max_t = max_p; }
    if src == "" {
        let m: String = "{\"ok\":false,\"error\":\"enforce: missing <file> or --max-tokens\"}\n";
        println(m);
        return;
    }
    if !path_exists(fr, src) {
        let m: String = "{\"ok\":false,\"error\":\"enforce: file not found: " + json_escape(src) + "\"}\n";
        println(m);
        return;
    }
    let tr: Result[String, String] = read_file(fr, src);
    if tr.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"enforce: cannot read: " + json_escape(src) + "\"}\n";
        println(m);
        return;
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let mut ledger: SessionTokenLedger = session_token_ledger_new(src);
    let text_len: Int = chars_len(text);
    let mut start: Int = 0;
    let mut k: Int = 0;
    let mut idx: Int = 0;
    while k <= text_len {
        if k == text_len || char_at(text, k) == "\n" {
            if k > start {
                let raw: String = str_slice(text, start, k);
                let prompt_b: Int = chars_len(raw);
                let mut m: TokenTurnMetric = token_turn_metric_zero(idx, "ENFORCE");
                m = token_turn_metric_record(m, prompt_b, 0, 0, 0, 0, 0);
                ledger = session_ledger_ingest(ledger, m);
                idx = idx + 1;
            }
            start = k + 1;
        }
        k = k + 1;
    }
    let cap: BudgetCap = budget_cap_new(max_p, max_t, cost);
    let decision: BudgetDecision = budget_check(cap, ledger.total_prompt_tokens, ledger.total_completion_tokens);
    if human {
        println("ooda token enforce: " + src);
        println("---------------------");
        println("max_prompt_tokens:        " + max_p.to_string());
        println("max_total_tokens:         " + max_t.to_string());
        println("estimated_prompt_tokens:  " + (decision).estimated_prompt_tokens.to_string());
        println("estimated_total_tokens:   " + (decision).estimated_total_tokens.to_string());
        if (decision).admit {
            println("tripwire:                 ARMED (within budget)");
            println("headroom_tokens:          " + (decision).headroom_tokens.to_string());
        } else {
            println("tripwire:                 TRIPPED");
            println("reason:                   " + (decision).reason);
            println("shortfall_tokens:         " + (decision).shortfall_tokens.to_string());
        }
        return;
    }
    let tripped: String = if (decision).admit { "armed" } else { "tripped" };
    let out: String = "{\"src\":\"" + json_escape(src) + "\",\"max_prompt_tokens\":" + max_p.to_string() + ",\"max_total_tokens\":" + max_t.to_string() + ",\"admit\":" + enforce_admit_str((decision).admit) + ",\"reason\":\"" + (decision).reason + "\",\"headroom\":" + (decision).headroom_tokens.to_string() + ",\"shortfall\":" + (decision).shortfall_tokens.to_string() + ",\"estimated_prompt\":" + (decision).estimated_prompt_tokens.to_string() + ",\"estimated_total\":" + (decision).estimated_total_tokens.to_string() + ",\"tripwire\":\"" + tripped + "\"}\n";
    println(out);
}
