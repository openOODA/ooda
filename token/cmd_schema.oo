// # Emit LLM tool-use manifest for ooda token
//
// Logline: Print the OpenAI, Anthropic, and raw JSON Schema manifests so any agent framework can register the ooda token surface.
//
// Setup: Pure .oo CLI subcommand. FsReadCap not required — emits static text.
//
// Beats:
//   1. Read the target filter (openai, anthropic, raw, or all).
//   2. Delegate to the shared schema_manifest module.
//   3. Print JSON to stdout.

import "std/app/agent/token/schema_manifest.oo";

pub fn run_ooda_token_schema(args: List[String]) {
    let mut target: String = "all";
    let mut caps: String = "";
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "openai" { target = "openai"; }
        if a == "anthropic" { target = "anthropic"; }
        if a == "raw" { target = "raw"; }
        if a == "--capabilities" && i + 1 < list_len(args) {
            i = i + 1;
            caps = list_get(args, i);
        }
        if a == "--format=json" || a == "--format=human" {
        }
        i = i + 1;
    }
    if caps == "read" {
        println("{\"name\":\"ooda_token\",\"format\":\"json\",\"commands\":[\"status\",\"query\",\"ask\",\"schema\"]}");
        return;
    }
    if caps == "write" {
        println("{\"name\":\"ooda_token\",\"format\":\"json\",\"commands\":[\"status\",\"query\",\"ask\",\"schema\",\"fix\",\"snapshot\",\"audit\",\"report\"]}");
        return;
    }
    if caps == "all" {
        println("{\"name\":\"ooda_token\",\"format\":\"json\",\"commands\":[\"status\",\"query\",\"ask\",\"schema\",\"fix\",\"snapshot\",\"audit\",\"report\",\"diff\",\"tail\",\"ingest\",\"enforce\",\"heatmap\"]}");
        return;
    }
    if target == "openai" {
        let m: String = schema_openai_manifest();
        println(m);
        return;
    }
    if target == "anthropic" {
        let m: String = schema_anthropic_manifest();
        println(m);
        return;
    }
    if target == "raw" {
        let m: String = schema_raw_manifest();
        println(m);
        return;
    }
    let mut out: String = "{\"openai\":";
    out = out + schema_openai_manifest();
    out = out + ",\"anthropic\":";
    out = out + schema_anthropic_manifest();
    out = out + ",\"raw\":";
    out = out + schema_raw_manifest();
    out = out + "}\n";
    println(out);
}
