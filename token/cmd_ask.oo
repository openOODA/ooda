// # Natural-language ask wrapper for the token ledger
//
// Logline: Take a human question, do deterministic keyword routing, and return selector + value + one-line gloss as a JSON envelope.
//
// Setup: Pure .oo CLI subcommand — Chronos (Mcode #2) LLM ask layer.
//
// Beats:
//   1. Define AskResult structure.
//   2. Route keywords to a known selector.
//   3. Resolve the selector and return selector, value, value_type, human, and a confidence hint.

import "std/app/agent/token/json_envelope.oo";
import "std/app/agent/token/baseline.oo";

// ## CAPs
//
//   FsCap:    read baseline record from .ooda-cache/ooda-token-baseline.ovl
//   (no other caps; pure keyword routing, no I/O)

pub type AskResult = struct {
    question: String,
    matched: Bool,
    selector: String,
    value: String,
    value_type: String,
    human: String,
    confidence: String,
    baseline_source: String
};

pub fn ask_result_new(
    q: String,
    matched: Bool,
    sel: String,
    val: String,
    vtype: String,
    h: String,
    conf: String,
    src: String
) -> AskResult {
    return AskResult {
        question: q,
        matched: matched,
        selector: sel,
        value: val,
        value_type: vtype,
        human: h,
        confidence: conf,
        baseline_source: src
    };
}

pub fn ask_contains(haystack: String, needle: String) -> Bool {
    let hn: Int = chars_len(haystack);
    let nn: Int = chars_len(needle);
    if nn == 0 {
        return true;
    }
    if nn > hn {
        return false;
    }
    let mut i: Int = 0;
    while i + nn <= hn {
        if str_slice(haystack, i, i + nn) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn ask_is_word_char(c: String) -> Bool {
    if c == "a" { return true; }
    if c == "b" { return true; }
    if c == "c" { return true; }
    if c == "d" { return true; }
    if c == "e" { return true; }
    if c == "f" { return true; }
    if c == "g" { return true; }
    if c == "h" { return true; }
    if c == "i" { return true; }
    if c == "j" { return true; }
    if c == "k" { return true; }
    if c == "l" { return true; }
    if c == "m" { return true; }
    if c == "n" { return true; }
    if c == "o" { return true; }
    if c == "p" { return true; }
    if c == "q" { return true; }
    if c == "r" { return true; }
    if c == "s" { return true; }
    if c == "t" { return true; }
    if c == "u" { return true; }
    if c == "v" { return true; }
    if c == "w" { return true; }
    if c == "x" { return true; }
    if c == "y" { return true; }
    if c == "z" { return true; }
    if c == "A" { return true; }
    if c == "B" { return true; }
    if c == "C" { return true; }
    if c == "D" { return true; }
    if c == "E" { return true; }
    if c == "F" { return true; }
    if c == "G" { return true; }
    if c == "H" { return true; }
    if c == "I" { return true; }
    if c == "J" { return true; }
    if c == "K" { return true; }
    if c == "L" { return true; }
    if c == "M" { return true; }
    if c == "N" { return true; }
    if c == "O" { return true; }
