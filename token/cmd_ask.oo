    return false;
}

pub fn ask_is_word_at(haystack: String, needle: String, pos: Int) -> Bool {
    let nn: Int = chars_len(needle);
    if str_slice(haystack, pos, pos + nn) != needle {
        return false;
    }
    if pos > 0 {
        let prev: String = char_at(haystack, pos - 1);
        if ask_is_word_char(prev) {
            return false;
        }
    }
    let hn: Int = chars_len(haystack);
    let end_char: String = char_at(haystack, pos + nn);
    if ask_is_word_char(end_char) {
        return false;
    }
    return true;
}

pub fn ask_word_contains(haystack: String, needle: String) -> Bool {
    let hn: Int = chars_len(haystack);
    let nn: Int = chars_len(needle);
    if nn == 0 {
        return true;
    }
    if nn > hn {
        return false;
    }
    let mut i: Int = 0;
    while i + nn <= hn {
        if ask_is_word_at(haystack, needle, i) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn ask_route(question: String, baseline: BaselineRecord) -> AskResult {
    let q: String = question;
    let src: String = (baseline).source;
    let eff: Int = (baseline).efficiency_milli;
    if ask_word_contains(q, "efficiency") {
        let eff_x10: Int = eff / 1000;
        let eff_frac: Int = (eff - (eff_x10 * 1000)) / 100;
        let human: String = "Baseline " + eff_x10.to_string() + "." + eff_frac.to_string() + "x reduction vs naive monolith simulation (" + src + ").";
        return ask_result_new(q, true, "total.efficiency_multiplier", eff.to_string(), "int_milli", human, "high", src);
    }
    if ask_word_contains(q, "saved") {
        return ask_result_new(q, true, "total.tokens_saved", "0", "int", "Tokens saved (per-run value must be supplied by the ingest pipeline; ask-only path returns 0).", "high", src);
    }
    if ask_word_contains(q, "completion") {
        return ask_result_new(q, true, "total.completion_tokens", "0", "int", "Total completion tokens in this session.", "medium", src);
    }
    if ask_word_contains(q, "prompt") {
        return ask_result_new(q, true, "total.prompt_tokens", "0", "int", "Total prompt tokens in this session.", "medium", src);
    }
    if ask_word_contains(q, "tool") {
        return ask_result_new(q, true, "tools.list", "[]", "string", "Registered tool footprints. Empty until live ingest.", "medium", src);
    }
    if ask_word_contains(q, "session") {
        return ask_result_new(q, true, "session.id", "default", "string", "Current session id.", "low", src);
    }
    if ask_word_contains(q, "schema") || ask_word_contains(q, "version") {
        return ask_result_new(q, true, "session.schema_version", "1.0", "string", "Envelope schema version.", "high", src);
    }
    if ask_word_contains(q, "step") {
        return ask_result_new(q, true, "steps.count", "0", "int", "Number of transcript steps ingested.", "low", src);
    }
    return ask_result_new(q, false, "", "", "string", "no match. Try: efficiency, saved, prompt, completion, tools, session, schema, steps.", "none", src);
}

pub fn ask_format_envelope(a: AskResult) -> String {
    let mut body: String = "{";
    body = body + "\"question\":\"" + json_escape((a).question) + "\"";
    body = body + ",\"matched\":" + json_bool((a).matched);
    body = body + ",\"selector\":\"" + json_escape((a).selector) + "\"";
    body = body + ",\"value\":";
    if (a).value_type == "string" {
        body = body + json_str((a).value);
    } else {
        body = body + (a).value;
    }
    body = body + ",\"value_type\":\"" + (a).value_type + "\"";
    body = body + ",\"human\":\"" + json_escape((a).human) + "\"";
    body = body + ",\"confidence\":\"" + (a).confidence + "\"";
    body = body + ",\"baseline_source\":\"" + json_escape((a).baseline_source) + "\"";
    body = body + "}";
    return envelope_wrap("ask", "default", 0, body);
}

pub fn run_ooda_token_ask(fr: &FsReadCap, args: List[String]) {
    if list_len(args) < 1 {
        let m: String = "{\"ok\":false,\"error\":\"missing question\"}\n";
        println(m);
        return;
    }
    let q: String = list_get(args, 0);
    let b: BaselineRecord = baseline_load_default(fr);
    let r: AskResult = ask_route(q, b);
    println(ask_format_envelope(r));
}
