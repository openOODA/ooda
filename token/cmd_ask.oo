    if c == "Q" { return true; }
    if c == "R" { return true; }
    if c == "S" { return true; }
    if c == "T" { return true; }
    if c == "U" { return true; }
    if c == "V" { return true; }
    if c == "W" { return true; }
    if c == "X" { return true; }
