// # ooda token report --markdown
//
// Logline: Emit a publication-ready cost report as a GitHub-flavored markdown table; baseline-aware, pricing-aware, source-cited.
//
// Setup: Pure .oo. FsCap reads the baseline. Pricing is the env/file/default loader. Cost projection is from cost_project.oo.
//
// Beats:
//   1. Load the baseline and the pricing; read efficiency_milli and source.
//   2. Compute the cost projection; compute daily/monthly/annual savings and payback.
//   3. Emit a markdown document with three sections: Baseline, Daily savings, Reproduction.
//   4. Cite honest limitations in the output (not hidden).

import "std/compile/token_opt/cost_project.oo";
import "std/compile/token_opt/baseline.oo";
import "std/compile/token_opt/pricing.oo";

pub fn cmd_token_report_markdown(fr: &FsReadCap, args: List[String]) {
    let inp: CostProjectionInputs = cost_projection_inputs_new(1804372, 1000, pricing_default(), 100);
    let pr: CostProjectionResult = cost_projection_compute(inp, pricing_default());
    let b: BaselineRecord = baseline_load_default(fr);
    let eff: Int = (b).efficiency_milli;
    let eff_x10: Int = eff / 1000;
    let eff_frac: Int = (eff - (eff_x10 * 1000)) / 100;
    let daily_saved: Int = (pr).daily_saved_micro;
    let annual_saved: Int = (pr).annual_saved_micro;
    let payback: Int = (pr).payback_days_x1000;
    let payback_x10: Int = payback / 1000;
    let payback_frac: Int = payback - (payback_x10 * 1000);
    println("# ooda token cost report");
    println("");
    println("> Generated by ooda token report --markdown. Source: openOODA RFC 0002 (token-telemetry).");
    println("");
    println("## Baseline");
    println("");
    println("| field              | value                                |");
    println("|--------------------|--------------------------------------|");
    let row_eff: String = "| efficiency        | " + eff_x10.to_string() + "." + eff_frac.to_string() + "x (" + (b).source + ")                    |";
    println(row_eff);
    let row_pr: String = "| pricing_name      | " + (pr).pricing_name + " (" + (pr).pricing_source + ")|";
    println(row_pr);
    let row_est: String = "| estimator_name    | " + (b).estimator_name + " (" + (b).estimator_bpt_x1000.to_string() + " bpt x1000)        |";
    println(row_est);
    println("");
    println("## Daily savings (per run, micro-units)");
    println("");
    println("| metric                     | value                          |");
    println("|----------------------------|--------------------------------|");
    let r1: String = "| tokens_saved_per_run       | " + (inp).tokens_saved_per_run.to_string() + " tokens                |";
    println(r1);
    let r2: String = "| daily_runs                 | " + (inp).runs_per_day.to_string() + " runs/day                  |";
    println(r2);
    let r3: String = "| daily_saved_micro          | " + daily_saved.to_string() + " micro                 |";
    println(r3);
    let r4: String = "| monthly_saved_micro        | " + (pr).monthly_saved_micro.to_string() + " micro                |";
    println(r4);
    let r5: String = "| annual_saved_micro         | " + annual_saved.to_string() + " micro                |";
    println(r5);
    let r6: String = "| run_cost_micro             | " + (inp).run_cost_micro.to_string() + " micro                  |";
    println(r6);
    let r7: String = "| payback_days               | " + payback_x10.to_string() + "." + payback_frac.to_string() + " days                       |";
    println(r7);
    println("");
    println("## Reproduction");
    println("");
    println("```sh");
    println("# Recompute this report:");
    println("$ ooda token report --markdown");
    println("$ ooda token calibrate fixtures/transcript_session_01.jsonl");
    println("$ ooda token query total.efficiency_multiplier");
    println("```");
    println("");
    println("## Honest limitations");
    println("");
    println("- tokens_saved_per_run is a demo input; calibrate with ooda token calibrate <file> for real numbers.");
    println("- 18500 efficiency is a default; the running estimator improves on every record_sample call.");
    println("- Run ooda token self_audit <dir> to catch CAPs / signature drift in your own toolchain.");
}
