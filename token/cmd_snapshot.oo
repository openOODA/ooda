// # ooda token snapshot subcommand
//
// Logline: Save the current SessionTokenLedger state to a .snap file under OODA_FS_WRITEDIR for later diff.
//
// Setup: FsCap reads source; FsWriteCap writes the snapshot. Pure .oo.
//
// Beats:
//   1. Read the JSONL file (or use the supplied ledger summary).
//   2. Build a SnapshotRecord with deterministic values.
//   3. Serialize and write to <file>.snap via write_file.
//   4. Emit a versioned JSON envelope confirming the write.

import "std/compile/token_opt/jsonl_strict.oo";
import "std/compile/token_opt/token_telemetry.oo";
import "std/compile/token_opt/ledger_persist.oo";
import "std/compile/token_opt/json_envelope.oo";

pub fn run_ooda_token_snapshot(fr: &FsReadCap, fw: &FsWriteCap, args: List[String]) {
    if list_len(args) < 2 {
        let m: String = "{\"ok\":false,\"error\":\"usage: ooda token snapshot <file.jsonl> <out.snap>\"}\n";
        println(m);
        return;
    }
    let src: String = list_get(args, 1);
    let out_path: String = list_get(args, 2);
    let tr: Result[String, String] = read_file(fr, src);
    if tr.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot read: " + src + "\"}\n";
        println(m);
        return;
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let mut ledger: SessionTokenLedger = session_token_ledger_new(src);
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut idx: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let raw: String = str_slice(text, start, i);
                let prompt_b: Int = chars_len(raw);
                let mut m: TokenTurnMetric = token_turn_metric_zero(idx, "SESSION");
                m = token_turn_metric_record(m, prompt_b, 0, 0, 0, 0, 0);
                ledger = session_ledger_ingest(ledger, m);
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let rec: SnapshotRecord = snapshot_record_new(
        src,
        (ledger).total_prompt_tokens,
        (ledger).total_completion_tokens,
        (ledger).total_tool_payload_bytes,
        (ledger).total_thinking_ms,
        (ledger).total_cost_micro,
        0
    );
    let body_text: String = snapshot_serialize(rec);
    let w: Result[Void, String] = write_file(fw, out_path, body_text);
    if w.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot write " + out_path + ": set OODA_FS_WRITEDIR\"}\n";
        println(m);
        return;
    }
    let mut body: String = "{";
    body = body + "\"ok\":true";
    body = body + ",\"snapshot\":\"" + json_escape(out_path) + "\"";
    body = body + ",\"session_id\":\"" + json_escape(src) + "\"";
    body = body + ",\"prompt_tokens\":" + (rec).prompt_tokens.to_string();
    body = body + ",\"completion_tokens\":" + (rec).completion_tokens.to_string();
    body = body + ",\"tool_payload_bytes\":" + (rec).tool_payload_bytes.to_string();
    body = body + "}";
    let out: String = envelope_wrap("snapshot", src, 0, body);
    println(out);
}
