// # Compare two persisted ledger snapshots
//
// Logline: Load two .ooda-cache/ooda-tmp/*.snap files and emit a regression-aware diff in JSON.
//
// Setup: FsReadCap reads the snapshot files. Pure .oo.
//
// Beats:
//   1. Read two snapshot files from disk.
//   2. Deserialize via ledger_persist.
//   3. Compute the numeric delta and regressed flag.
//   4. Emit a versioned JSON envelope.

import "std/app/agent/token/ledger_persist.oo";
import "std/app/agent/token/json_envelope.oo";

pub fn run_ooda_token_diff(fr: &FsReadCap, args: List[String]) {
    if list_len(args) < 2 {
        let m: String = "{\"ok\":false,\"error\":\"usage: ooda token diff <before.snap> <after.snap>\"}\n";
        println(m);
        return;
    }
    let before_path: String = list_get(args, 0);
    let after_path: String = list_get(args, 1);
    let rb: Result[String, String] = read_file(fr, before_path);
    let ra: Result[String, String] = read_file(fr, after_path);
    if rb.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot read before: " + before_path + "\"}\n";
        println(m);
        return;
    }
    if ra.is_err() {
        let m: String = "{\"ok\":false,\"error\":\"cannot read after: " + after_path + "\"}\n";
        println(m);
        return;
    }
    let btxt: String = match rb { Ok(s) => s, Err(m) => m };
    let atxt: String = match ra { Ok(s) => s, Err(m) => m };
    let b: SnapshotRecord = snapshot_deserialize(btxt);
    let a: SnapshotRecord = snapshot_deserialize(atxt);
    let d: SnapshotDiff = snapshot_diff(b, a);
    let mut body: String = "{";
    body = body + "\"before\":\"" + json_escape(before_path) + "\"";
    body = body + ",\"after\":\"" + json_escape(after_path) + "\"";
    body = body + ",\"session_id\":\"" + json_escape((d).session_id) + "\"";
    body = body + ",\"prompt_delta\":" + (d).prompt_delta.to_string();
    body = body + ",\"completion_delta\":" + (d).completion_delta.to_string();
    body = body + ",\"tool_payload_delta\":" + (d).tool_payload_delta.to_string();
    body = body + ",\"thinking_delta\":" + (d).thinking_delta.to_string();
    body = body + ",\"cost_delta\":" + (d).cost_delta.to_string();
    body = body + ",\"regressed\":";
    if (d).regressed { body = body + "true"; } else { body = body + "false"; }
    body = body + "}";
    let out: String = envelope_wrap("diff", (d).session_id, 0, body);
    println(out);
}
