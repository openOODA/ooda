pub fn shell_sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}
pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let path = "oodac/main.oo";
    let out = "test.bin";
    let build_sh = "set -e; OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\"; PBS=./scripts/oodac_pure_build.sh; [ -f \"$PBS\" ] || PBS=scripts/oodac_pure_build.sh; [ -f \"$PBS\" ] || PBS=ooda/scripts/oodac_pure_build.sh; [ -f \"$PBS\" ] || PBS=../ooda/scripts/oodac_pure_build.sh; if [ -n \"${OODA_SRC_ROOT:-}\" ] && [ -f \"${OODA_SRC_ROOT}/scripts/oodac_pure_build.sh\" ]; then PBS=\"${OODA_SRC_ROOT}/scripts/oodac_pure_build.sh\"; fi; sh \"$PBS\" " + shell_sq(path) + " " + shell_sq(out);
    sys_exec(sys, "sh", "-c", "printf '>>%s<<\n' \"$0\"", build_sh);
}
