+  # Strip seed-emitted retain/release (self-host residual).
+  sed -i "s/oo_str_release(.*);//g" "$TMP/all.c"
+  sed -i "s/oo_slist_release(.*);//g" "$TMP/all.c"
+  sed -i "s/oo_ilist_release(.*);//g" "$TMP/all.c"
+fi
 
