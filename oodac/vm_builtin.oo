// job: Builtin function execution for Interpreter (Bytecode VM)
// stage: vm

import "vm_val.oo";
import "vm_stack.oo";
import "vm_surface.oo";

pub fn is_vm_builtin(name: String) -> Bool {
    if name == "println" || name == "print" || name == "list_new" || name == "list_push"
        || name == "list_get" || name == "list_len" || name == "chars_len"
        || name == "char_at" || name == "str_slice" || name == "char_is_alpha"
        || name == "char_is_digit" || name == "to_string" || name == "parse_int"
        || name == "read_file" || name == "write_file" || name == "file_size"
        || name == "path_exists" || name == "oo_path_exists" || name == "process_exit"
    {
        return true;
    }
    if is_vm_surface(name) {
        return true;
    }
    return false;
}

pub fn vm_get_arg(args: List[String], idx: Int) -> String {
    let n = list_len(args);
    return list_get(args, n - 1 - idx);
}

pub fn exec_vm_builtin(fs: &FsCap, sys: &SysCap, name: String, argc: Int, stack: List[String]) -> List[String] {
    let mut args: List[String] = list_new();
    let mut st = stack;
    let mut i = 0;
    while i < argc {
        let top: String = stack_top(st);
        st = stack_pop(st);
        args = list_push(args, top);
        i = i + 1;
    }

    if name == "println" {
        let a0: String = vm_get_arg(args, 0);
        let s0: String = val_to_str(a0);
        println(s0);
        return stack_push(st, val_void());
    }
    if name == "print" {
        let a0: String = vm_get_arg(args, 0);
        let s0: String = val_to_str(a0);
        println(s0);
        return stack_push(st, val_void());
    }
    if name == "list_new" {
        return stack_push(st, "L:");
    }
    if name == "list_push" {
        let l_val = "" + vm_get_arg(args, 0);
        let elem = "" + vm_get_arg(args, 1);
        let mut p = "";
        if chars_len(l_val) >= 2 {
            p = str_slice(l_val, 2, chars_len(l_val));
        }
        let mut new_p = elem;
        if p != "" {
            new_p = p + "\t" + elem;
        }
        return stack_push(st, "L:" + new_p);
    }
    if name == "list_len" {
        let l_val = "" + vm_get_arg(args, 0);
        let mut p = "";
        if chars_len(l_val) >= 2 {
            p = str_slice(l_val, 2, chars_len(l_val));
        }
        if p == "" {
            return stack_push(st, val_int(0));
        }
        let mut count = 1;
        let mut k = 0;
        let n = chars_len(p);
        while k < n {
            if char_at(p, k) == "\t" {
                count = count + 1;
            }
            k = k + 1;
        }
        return stack_push(st, val_int(count));
    }
    if name == "list_get" {
        let l_val: String = vm_get_arg(args, 0);
        let target_idx = 0 + val_to_int(vm_get_arg(args, 1));
        let mut p: String = "";
        if chars_len(l_val) >= 2 {
            p = str_slice(l_val, 2, chars_len(l_val));
        }
        let mut cur_idx = 0;
        let mut start_pos = 0;
        let n = chars_len(p);
        let mut k = 0;
        while k <= n {
            let is_end = (k == n);
            let is_tab = if !is_end { char_at(p, k) == "\t" } else { false };
            if is_end || is_tab {
                if cur_idx == target_idx {
                    let elem = str_slice(p, start_pos, k);
                    if chars_len(elem) >= 2 && str_slice(elem, 1, 2) == ":" {
                        return stack_push(st, elem);
                    }
                    return stack_push(st, val_str(elem));
                }
                cur_idx = cur_idx + 1;
                start_pos = k + 1;
            }
            k = k + 1;
        }
        return stack_push(st, val_void());
    }
    if name == "chars_len" {
        let s: String = field_at(val_to_str(vm_get_arg(args, 0)), 0);
        return stack_push(st, val_int(chars_len(s)));
    }
    if name == "char_at" {
        let s: String = field_at(val_to_str(vm_get_arg(args, 0)), 0);
        let idx = 0 + val_to_int(vm_get_arg(args, 1));
        return stack_push(st, val_str(char_at(s, idx)));
    }
    if name == "str_slice" {
        let s: String = field_at(val_to_str(vm_get_arg(args, 0)), 0);
        let lo = 0 + val_to_int(vm_get_arg(args, 1));
        let hi = 0 + val_to_int(vm_get_arg(args, 2));
        return stack_push(st, val_str(str_slice(s, lo, hi)));
    }
    if name == "char_is_alpha" {
        let c: String = field_at(val_to_str(vm_get_arg(args, 0)), 0);
        let is_a: Bool = char_is_alpha(c);
        return stack_push(st, val_bool(is_a));
    }
    if name == "char_is_digit" {
        let c: String = field_at(val_to_str(vm_get_arg(args, 0)), 0);
        let is_d: Bool = char_is_digit(c);
        return stack_push(st, val_bool(is_d));
    }
    if name == "to_string" {
        let v: String = vm_get_arg(args, 0);
        return stack_push(st, val_str(val_to_str(v)));
    }
    if name == "parse_int" {
        let s = "" + val_to_str(vm_get_arg(args, 0));
        return stack_push(st, val_int(parse_int(s)));
    }
    if name == "read_file" {
        let path = "" + val_to_str(vm_get_arg(args, 0));
        let res = read_file(fs, path);
        let content = match res { Ok(txt) => txt, Err(_) => "" };
        return stack_push(st, val_str(content));
    }
    if name == "write_file" {
        let path = "" + val_to_str(vm_get_arg(args, 0));
        let content = "" + val_to_str(vm_get_arg(args, 1));
        write_file(fs, path, content);
        return stack_push(st, val_void());
    }
    if name == "file_size" {
        let path: String = "" + val_to_str(vm_get_arg(args, 0));
        return stack_push(st, val_int(file_size(fs, path)));
    }
    if name == "path_exists" || name == "oo_path_exists" {
        // Prefer path arg when cap is also pushed (fs, path); else single path.
        let mut path: String = "" + val_to_str(vm_get_arg(args, 0));
        if argc >= 2 {
            path = "" + val_to_str(vm_get_arg(args, 1));
        }
        let mut exists = 0;
        if path_exists(fs, path) { exists = 1; }
        return stack_push(st, val_bool(exists));
    }
    if name == "process_exit" {
        let code = 0 + val_to_int(vm_get_arg(args, 0));
        process_exit(code);
        return stack_push(st, val_void());
    }
    if is_vm_surface(name) {
        return exec_vm_surface(name, argc, args, st);
    }
    return stack_push(st, val_void());
}
