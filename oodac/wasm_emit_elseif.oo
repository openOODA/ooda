// # Detect const if / else-if / else println fold
//
// Logline: Returns the first true const-bool branch STRING, else the else STRING, when the body is only that chain of println(STRING) arms.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if KW_TRUE|KW_FALSE { println(STRING); } else-if arms then else { println(STRING); }.
//   3. Return the first true branch, or the else STRING. IDENT conditions miss.
//
// residual: runtime else-if stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wel_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wel_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wel_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n {
        return empty;
    }
    if wel_kind(toks, p) != "IDENT" || wel_text(toks, p) != "println" {
        return empty;
    }
    if wel_kind(toks, p + 1) != "LPAREN" || wel_kind(toks, p + 2) != "STRING" {
        return empty;
    }
    if wel_kind(toks, p + 3) != "RPAREN" {
        return empty;
    }
    let lit: String = wel_text(toks, p + 2);
    p = p + 4;
    if p < n && wel_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn wel_bool_arm(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p >= n {
        return empty;
    }
    let ck: String = wel_kind(toks, p);
    if ck != "KW_TRUE" && ck != "KW_FALSE" {
        return empty;
    }
    let mut is_true: String = "0";
    if ck == "KW_TRUE" {
        is_true = "1";
    }
    p = p + 1;
    if p >= n || wel_kind(toks, p) != "LBRACE" {
        return empty;
    }
    p = p + 1;
    let pr: List[String] = wel_one_str_println(toks, p, n);
    if list_len(pr) < 2 {
        return empty;
    }
    p = parse_int(list_get(pr, 1));
    if p >= n || wel_kind(toks, p) != "RBRACE" {
        return empty;
    }
    p = p + 1;
    let mut out: List[String] = list_new();
    out = list_push(out, is_true);
    out = list_push(out, list_get(pr, 0));
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_elseif(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wel_kind(toks, i) == "KW_FN" && wel_kind(toks, i + 1) == "IDENT" {
            if wel_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wel_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p >= n || wel_kind(toks, p) != "KW_IF" {
                    return "";
                }
                p = p + 1;
                let first: List[String] = wel_bool_arm(toks, p, n);
                if list_len(first) < 3 {
                    return "";
                }
                let mut taken: String = "";
                if list_get(first, 0) == "1" {
                    taken = list_get(first, 1);
                }
                p = parse_int(list_get(first, 2));
                let mut arms: Int = 1;
                while p + 1 < n && wel_kind(toks, p) == "KW_ELSE" && wel_kind(toks, p + 1) == "KW_IF" {
                    p = p + 2;
                    let arm: List[String] = wel_bool_arm(toks, p, n);
                    if list_len(arm) < 3 {
                        return "";
                    }
                    if chars_len(taken) <= 0 {
                        if list_get(arm, 0) == "1" {
                            taken = list_get(arm, 1);
                        }
                    }
                    p = parse_int(list_get(arm, 2));
                    arms = arms + 1;
                }
                if arms < 2 {
                    return "";
                }
                if p >= n || wel_kind(toks, p) != "KW_ELSE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wel_kind(toks, p) != "LBRACE" {
                    return "";
                }
                p = p + 1;
                let el: List[String] = wel_one_str_println(toks, p, n);
                if list_len(el) < 2 {
                    return "";
                }
                p = parse_int(list_get(el, 1));
                if p >= n || wel_kind(toks, p) != "RBRACE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wel_kind(toks, p) != "RBRACE" {
                    return "";
                }
                if chars_len(taken) > 0 {
                    return taken;
                }
                return list_get(el, 0);
            }
        }
        i = i + 1;
    }
    return "";
}
