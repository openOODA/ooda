// # Emit SysV fourth-arg String call
//
// Logline: Matches four-arg String passthrough of %rcx plus println(fn(STRING, STRING, STRING, STRING)) and emits lea rdi/rsi/rdx/rcx then call.
//
// Setup: tokenize_lines, x86_tok_k, x86_tok_t, x86_ascii_esc, and x86_emit_frame_enter/leave exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of its fourth String param.
//   2. Require main to be only println of that fn on four STRING args.
//   3. Emit mov %rcx,%rax; caller lea rdi+rsi+rdx+rcx, call, SYS_write from %rax.
//
// residual: 5-arg r8, 6-arg r9, Int args, and AArch64 stay later.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";
import "x86_emit_frame.oo";

fn x86_fth_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 23 >= n {
        return empty;
    }
    if x86_tok_k(toks, i) != "KW_FN" || x86_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = x86_tok_t(toks, i + 1);
    if nm == "main" || x86_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 3) != "IDENT" || x86_tok_k(toks, i + 4) != "COLON" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" || x86_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "COMMA" || x86_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "COLON" || x86_tok_k(toks, i + 9) != "IDENT" || x86_tok_t(toks, i + 9) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 10) != "COMMA" || x86_tok_k(toks, i + 11) != "IDENT" {
        return empty;
    }
    if x86_tok_k(toks, i + 12) != "COLON" || x86_tok_k(toks, i + 13) != "IDENT" || x86_tok_t(toks, i + 13) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 14) != "COMMA" || x86_tok_k(toks, i + 15) != "IDENT" {
        return empty;
    }
    let p4: String = x86_tok_t(toks, i + 15);
    if x86_tok_k(toks, i + 16) != "COLON" || x86_tok_k(toks, i + 17) != "IDENT" || x86_tok_t(toks, i + 17) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 18) != "RPAREN" || x86_tok_k(toks, i + 19) != "ARROW" {
        return empty;
    }
    if x86_tok_k(toks, i + 20) != "IDENT" || x86_tok_t(toks, i + 20) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 21) != "LBRACE" || x86_tok_k(toks, i + 22) != "KW_RETURN" {
        return empty;
    }
    if x86_tok_k(toks, i + 23) != "IDENT" || x86_tok_t(toks, i + 23) != p4 {
        return empty;
    }
    let mut p = i + 24;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    return o;
}

fn x86_fth_main_body(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 16 >= n {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" || x86_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 4) != "LBRACE" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" || x86_tok_t(toks, i + 5) != "println" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "LPAREN" || x86_tok_k(toks, i + 7) != "IDENT" || x86_tok_t(toks, i + 7) != fname {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "LPAREN" || x86_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let a1: String = x86_tok_t(toks, i + 9);
    if x86_tok_k(toks, i + 10) != "COMMA" || x86_tok_k(toks, i + 11) != "STRING" {
        return empty;
    }
    let a2: String = x86_tok_t(toks, i + 11);
    if x86_tok_k(toks, i + 12) != "COMMA" || x86_tok_k(toks, i + 13) != "STRING" {
        return empty;
    }
    let a3: String = x86_tok_t(toks, i + 13);
    if x86_tok_k(toks, i + 14) != "COMMA" || x86_tok_k(toks, i + 15) != "STRING" {
        return empty;
    }
    let a4: String = x86_tok_t(toks, i + 15);
    if x86_tok_k(toks, i + 16) != "RPAREN" {
        return empty;
    }
    if i + 17 >= n || x86_tok_k(toks, i + 17) != "RPAREN" {
        return empty;
    }
    let mut p = i + 18;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, a1);
    o = list_push(o, a2);
    o = list_push(o, a3);
    o = list_push(o, a4);
    return o;
}

pub fn x86_match_fth_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" {
            let nm: String = x86_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = x86_fth_shape(toks, n, i);
                if list_len(idn) >= 1 {
                    if chars_len(fname) > 0 { return empty; }
                    fname = list_get(idn, 0);
                }
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 {
        return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" {
            if x86_tok_t(toks, i + 1) == "main" {
                if list_len(found) >= 1 { return empty; }
                found = x86_fth_main_body(toks, n, i, fname);
                if list_len(found) < 5 { return empty; }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn x86_emit_fth_call(fname: String, a: String, b: String, c: String, d: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lstr0:");
    println("    .ascii \"" + x86_ascii_esc(a) + "\"");
    println(".Lstr1:");
    println("    .ascii \"" + x86_ascii_esc(b) + "\"");
    println(".Lstr2:");
    println("    .ascii \"" + x86_ascii_esc(c) + "\"");
    println(".Lstr3:");
    println("    .ascii \"" + x86_ascii_esc(d) + "\\n\"");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println("    .p2align 4");
    println(fname + ":");
    x86_emit_frame_enter();
    println("    mov %rcx, %rax");
    x86_emit_frame_leave();
    println("main:");
    println("_start:");
    println("    lea .Lstr0(%rip), %rdi");
    println("    lea .Lstr1(%rip), %rsi");
    println("    lea .Lstr2(%rip), %rdx");
    println("    lea .Lstr3(%rip), %rcx");
    println("    call " + fname);
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    let ln = chars_len(d) + 1;
    println("    mov $" + ln.to_string() + ", %rdx");
    println("    syscall");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
