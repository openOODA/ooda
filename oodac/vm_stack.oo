// # Grow and shrink the VM operand stack and locals
//
// Logline: Pushes, pops, and peeks tagged values on a list stack, and reads or writes a locals frame that pads missing slots with V:0.
//
// Setup: vm_val.oo is imported; an empty stack top is V:0; lists are rebuilt on pop and set.
//
// Beats:
//   1. stack_new, stack_push, stack_top, and stack_pop treat the last list slot as the top of the stack.
//   2. locals_new fills size slots with V:0; locals_get returns V:0 when the index is out of range.
//   3. locals_set replaces an in-range slot, or grows the frame with V:0 padding up to idx.

import "vm_val.oo";

pub fn stack_new() -> List[String] {
    return list_new();
}

pub fn stack_push(st: List[String], val: String) -> List[String] {
    return list_push(st, val);
}

pub fn stack_top(st: List[String]) -> String {
    let n = list_len(st);
    if n == 0 {
        return "V:0";
    }
    return list_get(st, n - 1);
}

pub fn stack_pop(st: List[String]) -> List[String] {
    let n = list_len(st);
    if n <= 1 {
        return list_new();
    }
    let mut out: List[String] = list_new();
    let mut i = 0;
    while i < n - 1 {
        out = list_push(out, list_get(st, i));
        i = i + 1;
    }
    return out;
}

pub fn locals_new(size: Int) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i = 0;
    while i < size {
        out = list_push(out, "V:0");
        i = i + 1;
    }
    return out;
}

pub fn locals_get(loc: List[String], idx: Int) -> String {
    if idx < 0 || idx >= list_len(loc) {
        return "V:0";
    }
    return list_get(loc, idx);
}

pub fn locals_set(loc: List[String], idx: Int, val: String) -> List[String] {
    let n = list_len(loc);
    let mut out: List[String] = list_new();
    let mut i = 0;
    if idx < n {
        while i < n {
            if i == idx {
                out = list_push(out, val);
            } else {
                out = list_push(out, list_get(loc, i));
            }
            i = i + 1;
        }
    } else {
        while i < n {
            out = list_push(out, list_get(loc, i));
            i = i + 1;
        }
        while i < idx {
            out = list_push(out, "V:0");
            i = i + 1;
        }
        out = list_push(out, val);
    }
    return out;
}
