// # Harvest helpers for emit-aarch64 println consts
//
// Logline: Resolves same-fn string and int binds and folds STRING plus IDENT chains.
//
// Setup: field_at exists. a64_collect_prints in aarch64_emit.oo calls these helpers.
//
// Beats:
//   1. Index the last same-fn string or int bind by name.
//   2. Fold a STRING plus STRING chain.
//   3. Mix STRING and bound IDENT pieces until RPAREN.
//
// residual: ALU, AAPCS calls, and product oodac dispatch stay later.

import "token_fmt.oo";

pub fn a64_bind_idx(names: List[String], name: String) -> Int {
    let n = list_len(names);
    let mut found = -1;
    let mut i = 0;
    while i < n {
        if list_get(names, i) == name {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

pub fn a64_tok_k(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

pub fn a64_tok_t(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn a64_str_after(toks: List[String], n: Int, j: Int) -> Int {
    let mut p = j + 1;
    while p + 1 < n {
        if a64_tok_k(toks, p) != "PLUS" {
            return p;
        }
        if a64_tok_k(toks, p + 1) != "STRING" {
            return p;
        }
        p = p + 2;
    }
    return p;
}

pub fn a64_str_fold(toks: List[String], n: Int, j: Int) -> String {
    let mut o: String = a64_tok_t(toks, j);
    let mut p = j + 1;
    while p + 1 < n {
        if a64_tok_k(toks, p) != "PLUS" {
            return o;
        }
        if a64_tok_k(toks, p + 1) != "STRING" {
            return o;
        }
        o = o + a64_tok_t(toks, p + 1);
        p = p + 2;
    }
    return o;
}

pub fn a64_mix_try(toks: List[String], n: Int, j: Int, names: List[String], vals: List[String], inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    let mut out = "";
    let mut p = j;
    let mut any = false;
    while p < n {
        let k: String = a64_tok_k(toks, p);
        if k == "STRING" {
            out = out + a64_tok_t(toks, p);
            any = true;
            p = p + 1;
        } else if k == "IDENT" {
            if p + 1 < n && a64_tok_k(toks, p + 1) == "LPAREN" {
                return empty;
            }
            let nm: String = a64_tok_t(toks, p);
            let sidx = a64_bind_idx(names, nm);
            if sidx >= 0 {
                out = out + list_get(vals, sidx);
                any = true;
                p = p + 1;
            } else {
                let iidx = a64_bind_idx(inames, nm);
                if iidx >= 0 && any {
                    out = out + list_get(ivals, iidx);
                    p = p + 1;
                } else {
                    return empty;
                }
            }
        } else {
            return empty;
        }
        if p < n && a64_tok_k(toks, p) == "PLUS" {
            p = p + 1;
        } else if p < n && a64_tok_k(toks, p) == "RPAREN" {
            if any {
                let mut one: List[String] = list_new();
                one = list_push(one, out);
                return one;
            }
            return empty;
        } else {
            return empty;
        }
    }
    return empty;
}
