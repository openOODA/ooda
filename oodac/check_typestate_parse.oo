// # Parse TYPESTATE directives
//
// Logline: Read // TYPESTATE lines from source into an env fragment.
//
// Setup: Source comments contain // TYPESTATE definitions and transitions.
//
// Beats:
//   1. Scan line-start TYPESTATE forms.
//   2. Write the env fragment.
//   3. Ignore unknown lines.

import "c_emit_env.oo";

// Line-start forms (leading space ok):
//   // TYPESTATE: Type State1 State2 ...
//   // TYPESTATE fn name: From -> To
//   // TYPESTATE fn name: -> To
// States are global names. Two machines must not share a state name.

pub fn ts_is_ident_char(c: String) -> Bool {
    if c == "_" { return true; }
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true; }
    if c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" { return true; }
    if c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" { return true; }
    if c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z" { return true; }
    if c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" { return true; }
    if c == "k" || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r" || c == "s" || c == "t" { return true; }
    if c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" { return true; }
    return false;
}

pub fn ts_skip_ws(s: String, i0: Int) -> Int {
    let n = chars_len(s);
    let mut i = i0;
    while i < n {
        let c = char_at(s, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    return i;
}

pub fn ts_read_ident(s: String, i0: Int) -> String {
    let n = chars_len(s);
    let mut i = i0;
    if i >= n { return ""; }
    if !ts_is_ident_char(char_at(s, i)) { return ""; }
    i = i + 1;
    while i < n {
        if ts_is_ident_char(char_at(s, i)) {
            i = i + 1;
        } else {
            break;
        }
    }
    return str_slice(s, i0, i);
}

pub fn ts_parse_fn_line(rest: String, env0: String) -> String {
    let n = chars_len(rest);
    let mut i: Int = ts_skip_ws(rest, 0);
    if i + 2 > n { return env0; }
    if str_slice(rest, i, i + 2) != "fn" { return env0; }
    i = ts_skip_ws(rest, i + 2);
    let fname = ts_read_ident(rest, i);
    if fname == "" {
        println("ERR\ttypestate\tneed fn name after TYPESTATE fn");
        process_exit(1);
    }
    i = ts_skip_ws(rest, i + chars_len(fname));
    if i >= n || char_at(rest, i) != ":" {
        println("ERR\ttypestate\tneed : after fn " + fname);
        process_exit(1);
    }
    i = ts_skip_ws(rest, i + 1);
    let mut from_st = "";
    if i >= n {
        println("ERR\ttypestate\tneed From -> To on fn " + fname);
        process_exit(1);
    }
    if i + 1 < n {
        if char_at(rest, i) == "-" && char_at(rest, i + 1) == ">" {
            from_st = "";
            i = ts_skip_ws(rest, i + 2);
        } else {
            from_st = ts_read_ident(rest, i);
            if from_st == "" {
                println("ERR\ttypestate\tneed From state on fn " + fname);
                process_exit(1);
            }
            i = ts_skip_ws(rest, i + chars_len(from_st));
            if i + 1 >= n || char_at(rest, i) != "-" || char_at(rest, i + 1) != ">" {
                println("ERR\ttypestate\tneed -> after From on fn " + fname);
                process_exit(1);
            }
            i = ts_skip_ws(rest, i + 2);
        }
    } else {
        println("ERR\ttypestate\tneed -> on fn " + fname);
        process_exit(1);
    }
    let to_st = ts_read_ident(rest, i);
    if to_st == "" {
        println("ERR\ttypestate\tneed To state on fn " + fname);
        process_exit(1);
    }
    let cur: String = c_env_get(env0, "__tscurm__");
    if cur == "" {
        println("ERR\ttypestate\tneed TYPESTATE: Type before fn " + fname);
        process_exit(1);
    }
    let mut from_full: String = "";
    if from_st != "" {
        from_full = cur + "#" + from_st;
        if c_env_get(env0, "__tss__" + from_full) != "1" {
            println("ERR\ttypestate\tunknown From state " + from_st + " on fn " + fname);
            process_exit(1);
        }
    }
    let to_full: String = cur + "#" + to_st;
    if c_env_get(env0, "__tss__" + to_full) != "1" {
        println("ERR\ttypestate\tunknown To state " + to_st + " on fn " + fname);
        process_exit(1);
    }
    return c_env_put(env0, "__tsf__" + fname, from_full + ">" + to_full);
}

pub fn ts_parse_machine_line(rest: String, env0: String) -> String {
    let mut i: Int = ts_skip_ws(rest, 0);
    let tname = ts_read_ident(rest, i);
    if tname == "" {
        println("ERR\ttypestate\tneed type name after TYPESTATE:");
        process_exit(1);
    }
    i = ts_skip_ws(rest, i + chars_len(tname));
    let n = chars_len(rest);
    let mut env = c_env_put(env0, "__tst__" + tname, "1");
    env = c_env_put(env, "__tscurm__", tname);
    let mut nstates = 0;
    while i < n {
        let st: String = ts_read_ident(rest, i);
        if st == "" { break; }
        let full: String = tname + "#" + st;
        if c_env_get(env, "__tss__" + full) == "1" {
            println("ERR\ttypestate\tstate name " + st + " used twice on " + tname);
            process_exit(1);
        }
        env = c_env_put(env, "__tss__" + full, "1");
        nstates = nstates + 1;
        i = ts_skip_ws(rest, i + chars_len(st));
    }
    if nstates < 2 {
        println("ERR\ttypestate\tmachine " + tname + " needs at least two states");
        process_exit(1);
    }
    return env;
}

pub fn ts_handle_line(line: String, env0: String) -> String {
    let ln = chars_len(line);
    let mut j: Int = ts_skip_ws(line, 0);
    if j + 2 > ln { return env0; }
    if str_slice(line, j, j + 2) != "//" { return env0; }
    j = ts_skip_ws(line, j + 2);
    let tag = "TYPESTATE";
    let tn = chars_len(tag);
    if j + tn > ln { return env0; }
    if str_slice(line, j, j + tn) != tag { return env0; }
    if j + tn < ln {
        if ts_is_ident_char(char_at(line, j + tn)) { return env0; }
    }
    let mut rstart: Int = ts_skip_ws(line, j + tn);
    if rstart < ln {
        if char_at(line, rstart) == ":" {
            return ts_parse_machine_line(str_slice(line, rstart + 1, ln), env0);
        }
    }
    let rest = str_slice(line, rstart, ln);
    let r0: Int = ts_skip_ws(rest, 0);
    if r0 + 2 <= chars_len(rest) {
        if str_slice(rest, r0, r0 + 2) == "fn" {
            if r0 + 2 < chars_len(rest) {
                if ts_is_ident_char(char_at(rest, r0 + 2)) { return env0; }
            }
            return ts_parse_fn_line(rest, env0);
        }
        if r0 + 3 <= chars_len(rest) {
            if str_slice(rest, r0, r0 + 3) == "end" {
                if r0 + 3 >= chars_len(rest) || !ts_is_ident_char(char_at(rest, r0 + 3)) {
                    return ts_parse_end_line(str_slice(rest, r0 + 3, chars_len(rest)), env0);
                }
            }
        }
    }
    return env0;
}

pub fn ts_parse_end_line(rest: String, env0: String) -> String {
    let cur: String = c_env_get(env0, "__tscurm__");
    if cur == "" {
        println("ERR\ttypestate\tneed TYPESTATE: Type before end");
        process_exit(1);
    }
    let i: Int = ts_skip_ws(rest, 0);
    let st: String = ts_read_ident(rest, i);
    if st == "" {
        println("ERR\ttypestate\tneed end state name");
        process_exit(1);
    }
    let full: String = cur + "#" + st;
    if c_env_get(env0, "__tss__" + full) != "1" {
        println("ERR\ttypestate\tunknown end state " + st);
        process_exit(1);
    }
    return c_env_put(env0, "__tsend__" + cur, full);
}

pub fn ts_parse_directives(src: String) -> String {
    let n = chars_len(src);
    let mut env = "";
    let mut i = 0;
    let mut line_start = 0;
    while i <= n {
        let at_end = i == n;
        let mut is_nl = false;
        if !at_end {
            if char_at(src, i) == "\n" { is_nl = true; }
        }
        if at_end || is_nl {
            env = ts_handle_line(str_slice(src, line_start, i), env);
            if at_end { return env; }
            line_start = i + 1;
        }
        i = i + 1;
    }
    return env;
}

pub fn ts_has_any_fn(env: String) -> Bool {
    let needle = "__tsf__";
    let nn = chars_len(needle);
    let n = chars_len(env);
    let mut i = 0;
    while i + nn <= n {
        if str_slice(env, i, i + nn) == needle { return true; }
        i = i + 1;
    }
    return false;
}
