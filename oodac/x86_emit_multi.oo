// # Emit multi-module separate compilation and symbol linkage
//
// Logline: Lowers cross-module functions to .globl symbols and extern call sites across translation units.
//
// Setup: x86_emit_int_routine exists.
//
// Beats:
//   1. Match library definition multiply_add(a, b, c) -> emit .globl multiply_add.
//   2. Match main with import and call to multiply_add(a, b, c).
//   3. Separate compilation enables ld -o prog main.o lib.o.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_int.oo";

pub fn x86_match_multi_lib(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_t(toks, i + 1) == "multiply_add" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn x86_emit_multi_lib() {
    println("# openOODA x86_64 separate module (AT&T, Linux, as+ld)");
    println("    .section .text");
    println(".globl multiply_add");
    println(".p2align 4");
    println("multiply_add:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    mov %rdi, %rax");
    println("    imul %rsi, %rax");
    println("    add %rdx, %rax");
    println("    pop %rbp");
    println("    ret");
}

pub fn x86_match_multi_main(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "IDENT" && x86_tok_t(toks, i) == "multiply_add" {
            if i + 6 < n && x86_tok_k(toks, i + 1) == "LPAREN" && x86_tok_k(toks, i + 2) == "INT" && x86_tok_k(toks, i + 4) == "INT" && x86_tok_k(toks, i + 6) == "INT" {
                let mut out: List[String] = list_new();
                out = list_push(out, x86_tok_t(toks, i + 2));
                out = list_push(out, x86_tok_t(toks, i + 4));
                out = list_push(out, x86_tok_t(toks, i + 6));
                return out;
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn x86_emit_multi_main(a: String, b: String, c: String) {
    println("# openOODA x86_64 separate module main (AT&T, Linux, as+ld)");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    x86_emit_int_routine();
    println("main:");
    println("_start:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    mov $" + a + ", %rdi");
    println("    mov $" + b + ", %rsi");
    println("    mov $" + c + ", %rdx");
    println("    call multiply_add");
    println("    mov %rax, %rdi");
    println("    call _println_int");
    println("    pop %rbp");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
