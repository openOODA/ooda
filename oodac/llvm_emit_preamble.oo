// package: backend-llvm — LLVM IR module preamble, target triple, and runtime declarations
// stage: emit

import "token_fmt.oo";

pub fn llvm_emit_preamble() {
    println("; ModuleID = 'openOODA'");
    println("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"");
    println("target triple = \"x86_64-unknown-linux-gnu\"");
    println("");
    println("%OoStrHeader = type { i32, i32 }");
    println("%OoListHeader = type { i32, i32 }");
    println("%OoStr = type { i8*, i64 }");
    println("%OoIList = type { i64*, i64, i64 }");
    println("%OoSList = type { %OoStr*, i64, i64 }");
    println("%OoResS = type { i32, %OoStr }");
    println("%OoResV = type { i32, %OoStr }");
    println("");
    println("declare void @oo_str_retain(%OoStr)");
    println("declare void @oo_str_release(%OoStr)");
    println("declare void @oo_ilist_retain(%OoIList)");
    println("declare void @oo_ilist_release(%OoIList)");
    println("declare void @oo_slist_retain(%OoSList)");
    println("declare void @oo_slist_release(%OoSList)");
    println("declare %OoStr @oo_str_lit(i8*)");
    println("declare %OoStr @oo_str_concat(%OoStr, %OoStr)");
    println("declare i64 @oo_str_byte_len(%OoStr)");
    println("declare i64 @oo_chars_len(%OoStr)");
    println("declare %OoStr @oo_char_at(%OoStr, i64)");
    println("declare %OoStr @oo_str_slice(%OoStr, i64, i64)");
    println("declare i32 @oo_str_contains(%OoStr, %OoStr)");
    println("declare i32 @oo_str_eq(%OoStr, %OoStr)");
    println("declare %OoStr @oo_int_to_str(i64)");
    println("declare i64 @oo_str_to_int(%OoStr)");
    println("declare %OoIList @oo_ilist_new()");
    println("declare %OoIList @oo_ilist_push(%OoIList, i64)");
    println("declare i64 @oo_ilist_get(%OoIList, i64)");
    println("declare i64 @oo_ilist_len(%OoIList)");
    println("declare %OoSList @oo_slist_new()");
    println("declare %OoSList @oo_slist_push(%OoSList, %OoStr)");
    println("declare %OoStr @oo_slist_get(%OoSList, i64)");
    println("declare i64 @oo_slist_len(%OoSList)");
    println("declare void @oo_print_str(%OoStr)");
    println("declare void @oo_eprint_str(%OoStr)");
    println("declare void @oo_print_int(i64)");
    println("declare void @oo_print_bool(i32)");
    println("declare void @oo_println()");
    println("declare void @oo_eprintln()");
    println("declare void @oo_process_exit(i64)");
    println("declare void @llvm.trap()");
    println("");
}
