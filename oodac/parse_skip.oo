// job: skip expr/primary without printing; stage: parse
// in: toks + pos; out: new pos

pub fn skip_expr_bp(toks: List[String], pos0: Int, min_bp: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    let k0: String = field_at(list_get(toks, pos), 0);
    if k0 == "BANG" || k0 == "MINUS" {
        pos = pos + 1;
        pos = skip_expr_bp(toks, pos, 100);
    } else {
        pos = skip_primary(toks, pos);
    }
    let mut cont = true;
    while cont {
        if pos >= n {
            cont = false;
        } else {
            let bp = 0 + bin_bp(field_at(list_get(toks, pos), 0));
            if bp == 0 || bp < min_bp {
                cont = false;
            } else {
                pos = pos + 1;
                pos = skip_expr_bp(toks, pos, bp + 1);
            }
        }
    }
    return pos;
}

pub fn skip_primary(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    let k: String = field_at(list_get(toks, pos), 0);
    if k == "INT" || k == "STRING" || k == "KW_TRUE" || k == "KW_FALSE" {
        return pos + 1;
    }
    if k == "IDENT" {
        pos = pos + 1;
        // calls / methods
        let mut cont = true;
        while cont {
            if pos >= n {
                cont = false;
            } else {
                let k2: String = field_at(list_get(toks, pos), 0);
                if k2 == "LPAREN" {
                    pos = pos + 1;
                    let mut depth = 0;
                    let mut c2 = true;
                    while c2 {
                        if pos >= n {
                            c2 = false;
                        } else {
                            let sk: String = field_at(list_get(toks, pos), 0);
                            if sk == "LPAREN" {
                                depth = depth + 1;
                            }
                            if sk == "RPAREN" {
                                if depth == 0 {
                                    pos = pos + 1;
                                    c2 = false;
                                } else {
                                    depth = depth - 1;
                                    pos = pos + 1;
                                }
                            } else {
                                pos = pos + 1;
                            }
                        }
                    }
                } else if k2 == "LBRACE" {
                    let mut is_struct = false;
                    let mut p2 = pos + 1;
                    if p2 < n {
                        let kk: String = field_at(list_get(toks, p2), 0);
                        if kk == "RBRACE" {
                            is_struct = true;
                        } else if kk == "IDENT" {
                            if p2 + 1 < n {
                                if field_at(list_get(toks, p2 + 1), 0) == "COLON" {
                                    is_struct = true;
                                }
                            }
                        }
                    }
                    if is_struct == false {
                        cont = false;
                    } else {

                    pos = pos + 1;
                    let mut depth_s = 0;
                    let mut c3 = true;
                    while c3 {
                        if pos >= n {
                            c3 = false;
                        } else {
                            let sk3: String = field_at(list_get(toks, pos), 0);
                            if sk3 == "LBRACE" {
                                depth_s = depth_s + 1;
                            }
                            if sk3 == "RBRACE" {
                                if depth_s == 0 {
                                    pos = pos + 1;
                                    c3 = false;
                                } else {
                                    depth_s = depth_s - 1;
                                    pos = pos + 1;
                                }
                            } else {
                                pos = pos + 1;
                            }
                        }
                    }
                    }
                } else if k2 == "DOT" {
                    pos = pos + 1;
                    if pos < n {
                        pos = pos + 1;
                    }
                    if pos < n {
                        if field_at(list_get(toks, pos), 0) == "LPAREN" {
                            // method call args — handled by loop
                            let _x = 0;
                        } else {
                            cont = false;
                        }
                    }
                } else {
                    cont = false;
                }
            }
        }
        return pos;
    }
    if k == "LPAREN" {
        pos = pos + 1;
        pos = skip_expr_bp(toks, pos, 0);
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "RPAREN" {
                pos = pos + 1;
            }
        }
        return pos;
    }
    if k == "KW_MATCH" {
        pos = pos + 1;
        pos = skip_expr_bp(toks, pos, 0);
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "LBRACE" {
                pos = skip_balanced(toks, pos);
            }
        }
        return pos;
    }
    if k == "KW_IF" {
        pos = pos + 1;
        pos = skip_expr_bp(toks, pos, 0);
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "LBRACE" {
                pos = skip_balanced(toks, pos);
            }
        }
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "KW_ELSE" {
                pos = pos + 1;
                if field_at(list_get(toks, pos), 0) == "KW_IF" {
                    pos = skip_expr_bp(toks, pos, 0);
                } else {
                    if field_at(list_get(toks, pos), 0) == "LBRACE" {
                        pos = skip_balanced(toks, pos);
                    }
                }
            }
        }
        return pos;
    }
    return pos + 1;
}

