// # Expand main and print the head
//
// Logline: Expands oodac/main.oo through load_expand and prints the first result string.
//
// Setup: load_import.oo is in scope; main receives fs, sys, and args; fs is the FsCap.
//
// Beats:
//   1. Call load_expand on oodac/main.oo with two tab strings.
//   2. Take the first element of the result list.
//   3. Print that string.

import "load_import.oo";
pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let res: List[String] = load_expand(fs, "oodac/main.oo", "\t", "\t");
    println(list_get(res, 0));
}
