// # Dijkstra Weakest Precondition Calculator
//
// Logline: Backwards substitution calculus deriving weakest preconditions from assignments and postconditions.
//
// Setup: Pure term substitution engine generating verification conditions WP(S, Q).
//
// Beats:
//   1. Define assignment transition descriptors (v <- c * x + k).
//   2. Perform backwards substitution into relational postconditions.
//   3. Formulate verification conditions P => WP(S, Q).
// RULES.oot 1.7: Under 256 lines.

import "smt_contract_parse.oo";

pub fn smt_wp_calc_assign_pack(var_name: String, rhs_var: String, coeff: Int, k: Int) -> String {
    let mut c: Int = coeff;
    if c == 0 && rhs_var != "" { c = 1; }
    return var_name + "\t" + rhs_var + "\t" + c.to_string() + "\t" + k.to_string();
}

pub fn smt_wp_calc_assign_target(a: String) -> String { return field_at(a, 0); }
pub fn smt_wp_calc_assign_rhs_var(a: String) -> String { return field_at(a, 1); }
pub fn smt_wp_calc_assign_coeff(a: String) -> Int { return parse_int(field_at(a, 2)); }
pub fn smt_wp_calc_assign_const(a: String) -> Int { return parse_int(field_at(a, 3)); }

pub fn smt_wp_calc_step(post: String, assign: String) -> String {
    let target: String = smt_wp_calc_assign_target(assign);
    let mut new_lhs: String = smt_contract_parse_lhs(post);
    let mut new_k: Int = smt_contract_parse_rhs_const(post);
    let mut new_rhs_var: String = smt_contract_parse_rhs_var(post);

    let p_rc: Int = smt_contract_parse_rhs_const(post);
    let a_rc: Int = smt_wp_calc_assign_const(assign);

    if smt_contract_parse_lhs(post) == target {
        let ar: String = smt_wp_calc_assign_rhs_var(assign);
        if ar != "" { new_lhs = ar; }
        new_k = p_rc - a_rc;
    }

    if smt_contract_parse_rhs_var(post) == target {
        let ar2: String = smt_wp_calc_assign_rhs_var(assign);
        if ar2 != "" { new_rhs_var = ar2; }
        new_k = p_rc + a_rc;
    }

    return smt_contract_parse_pack(
        smt_contract_parse_kind(post),
        new_lhs,
        smt_contract_parse_lhs_coeff(post),
        smt_contract_parse_op(post),
        new_k,
        new_rhs_var,
        smt_contract_parse_rhs_coeff(post),
        smt_contract_parse_line(post),
        smt_contract_parse_col(post),
        smt_contract_parse_is_const(post),
        smt_contract_parse_const_val(post)
    );
}

pub fn smt_wp_calc_derive(pre: String, assigns: List[String], post: String) -> String {
    let mut cur: String = post;
    let n: Int = list_len(assigns);
    let mut i: Int = n - 1;
    while i >= 0 {
        let st: String = list_get(assigns, i);
        cur = smt_wp_calc_step(cur, st);
        i = i - 1;
    }
    return cur;
}
