// # Reject assignment to an immutable let
//
// Logline: Collects let and let mut names, then errors when a later IDENT EQ writes a name that is only in the immutable set.
//
// Setup: field_at, binds_has, and tc_err_at exist; names live in tab-separated tables; field assignment and the let binding itself are skipped.
//
// Beats:
//   1. Walk KW_LET; a following KW_MUT records the IDENT in muts, otherwise in immut.
//   2. Walk IDENT EQ that is not after KW_LET, KW_MUT, or DOT.
//   3. If the name is in immut and not in muts, tc_err_at with the let mut hint.

pub fn typecheck_immut_assign(toks: List[String]) {
    let n = list_len(toks);
    let mut immut = "\t";
    let mut muts = "\t";
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_LET" {
            let mut p = i + 1;
            let mut is_mut = false;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    is_mut = true;
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let v: String = field_at(list_get(toks, p), 3);
                    if is_mut {
                        muts = muts + v + "\t";
                    } else {
                        immut = immut + v + "\t";
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "EQ" {
                    // skip let ... = and type ann =
                    let mut is_let = false;
                    if i > 0 {
                        let pk: String = field_at(list_get(toks, i - 1), 0);
                        if pk == "KW_LET" || pk == "KW_MUT" {
                            is_let = true;
                        }
                    }
                    // skip `name: Type =` param defaults — rare; skip if prev COLON path
                    let mut is_field = false;
                    if i > 0 {
                        if field_at(list_get(toks, i - 1), 0) == "DOT" {
                            is_field = true;
                        }
                    }
                    if !is_let && !is_field {
                        let name: String = field_at(list_get(toks, i), 3);
                        if binds_has(immut, name) {
                            if !binds_has(muts, name) {
                                tc_err_at(
                                    toks,
                                    i,
                                    "cannot assign to immutable variable '"
                                        + name
                                        + "'; use `let mut`"
                                );
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Lookup Type for "\tname:Type\t" env table. Returns "" if unknown.
