// job: immut assign reject; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_immut_assign(toks: List[String]) {
    let n = list_len(toks);
    let mut immut = "\t";
    let mut muts = "\t";
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "KW_LET" {
            let mut p = i + 1;
            let mut is_mut = false;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    is_mut = true;
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let v = field_at(list_get(toks, p), 3);
                    if is_mut {
                        muts = muts + v + "\t";
                    } else {
                        immut = immut + v + "\t";
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "EQ" {
                    // skip let ... = and type ann =
                    let mut is_let = false;
                    if i > 0 {
                        let pk = field_at(list_get(toks, i - 1), 0);
                        if pk == "KW_LET" || pk == "KW_MUT" {
                            is_let = true;
                        }
                    }
                    // skip `name: Type =` param defaults — rare; skip if prev COLON path
                    if !is_let {
                        let name = field_at(list_get(toks, i), 3);
                        if binds_has(immut, name) {
                            if !binds_has(muts, name) {
                                tc_err_at(
                                    toks,
                                    i,
                                    "cannot assign to immutable variable '"
                                        + name
                                        + "'; use `let mut`"
                                );
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Lookup Type for "\tname:Type\t" env table. Returns "" if unknown.
