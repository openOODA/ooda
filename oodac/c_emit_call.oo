// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: call args + method lowering for emit
// stage: emit
// returns packs [pos_str, c_text] or [pos, args, a0, a1]

// Last comma-separated C arg (sys_exec shell string is last).
pub fn c_sys_exec_last_arg(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return "oo_str_lit(\"\")";
    }
    let mut i = n;
    // walk back for last ", "
    while i > 0 {
        i = i - 1;
        if i + 1 < n {
            if char_at(args, i) == "," {
                // skip comma and following space
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        let mut out = "";
                        while j < n {
                            out = out + char_at(args, j);
                            j = j + 1;
                        }
                        return out;
                    }
                }
                return args;
            }
        }
    }
    return args;
}

// Drop first top-level arg: write_file(fs, path, content) → path, content.
pub fn c_args_drop_first(args: String) -> String {
    let n = chars_len(args);
    let mut i = 0;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if c == "(" {
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
        }
        if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        let mut out = "";
                        while j < n {
                            out = out + char_at(args, j);
                            j = j + 1;
                        }
                        return out;
                    }
                }
                return "";
            }
        }
        i = i + 1;
    }
    return args;
}

// Parse args starting AFTER LPAREN; stop at RPAREN. Each arg is a full expr.
pub fn c_emit_call_args(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut a0 = "";
    let mut a1 = "";
    let mut args = "";
    let mut first = true;
    let mut ac = 0;
    while p < n {
        let ak = field_at(list_get(toks, p), 0);
        if ak == "RPAREN" {
            p = p + 1;
            break;
        }
        if ak == "COMMA" {
            p = p + 1;
        } else {
            let pr = c_emit_expr_c(toks, p, n, env);
            p = parse_int(list_get(pr, 0));
            let a = list_get(pr, 1);
            if ac == 0 {
                a0 = a;
            }
            if ac == 1 {
                a1 = a;
            }
            ac = ac + 1;
            if first {
                args = a;
                first = false;
            } else {
                args = args + ", " + a;
            }
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, args);
    out = list_push(out, a0);
    out = list_push(out, a1);
    return out;
}

// pos at DOT after receiver primary text `recv`. Lowers .to_string/.contains/.len/.is_ok/.is_err
pub fn c_emit_method(toks: List[String], pos: Int, n: Int, env: String, recv: String) -> List[String] {
    let mut p = pos;
    // DOT
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        let mut bad: List[String] = list_new();
        bad = list_push(bad, p.to_string());
        bad = list_push(bad, recv);
        return bad;
    }
    let mname = field_at(list_get(toks, p), 3);
    p = p + 1;
    let mut margs = "";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        let ap = c_emit_call_args(toks, p, n, env);
        p = parse_int(list_get(ap, 0));
        margs = list_get(ap, 1);
    }
    let mut call = recv + "." + mname + "(" + margs + ")";
    if mname == "to_string" {
        call = "oo_int_to_str(" + recv + ")";
    }
    if mname == "contains" {
        call = "oo_str_contains(" + recv + ", " + margs + ")";
    }
    if mname == "len" {
        let rk = c_env_get(env, recv);
        if rk == "S" || rk == "I" {
            call = c_list_c_name("list_len", rk) + "(" + recv + ")";
        } else {
            call = "oo_chars_len(" + recv + ")";
        }
    }
    if mname == "is_ok" {
        call = "(" + recv + ".ok)";
    }
    if mname == "is_err" {
        call = "(!" + recv + ".ok)";
    }
    if mname == "unwrap" {
        call = "((" + recv + ".ok) ? (" + recv + ".val) : (oo_print_str(oo_str_lit(\"ERR\\tunwrap\")), oo_println(), oo_process_exit(1), " + recv + ".val))";
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, call);
    return out;
}
