// # Lower call arguments, methods, and index gets
//
// Logline: Collects C call arguments and lowers .method and [index] sugar to oo_* or list helpers, with the same secret guard as free calls.
//
// Setup: c_emit_expr_c, c_secret_emit_guard, c_env_get, c_list_c_name, and c_infer_list_kind exist; method pos is the DOT and index pos is the LBRACKET. Residual: flight-recorder wrap stays disabled.
//
// Beats:
//   1. c_emit_call_args walks arguments until RPAREN and returns pos, joined args, a0, a1, and a2.
//   2. c_emit_method reads the method name and optional args, runs c_secret_emit_guard, and lowers to_string, contains, len, is_ok, is_err, and unwrap.
//   3. c_emit_index_get emits list_get(base, idx) and may chain a following method.

pub fn c_emit_call_args(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut a0 = "";
    let mut a1 = "";
    let mut a2 = "";
    let mut args = "";
    let mut first = true;
    let mut ac = 0;
    while p < n {
        let ak: String = field_at(list_get(toks, p), 0);
        if ak == "RPAREN" {
            p = p + 1;
            break;
        }
        if ak == "COMMA" {
            p = p + 1;
        } else {
            let pr: List[String] = c_emit_expr_c(toks, p, n, env);
            p = parse_int(list_get(pr, 0));
            let a = list_get(pr, 1);
            if ac == 0 {
                a0 = a;
            }
            if ac == 1 {
                a1 = a;
            }
            if ac == 2 {
                a2 = a;
            }
            ac = ac + 1;
            if first {
                args = a;
                first = false;
            } else {
                args = args + ", " + a;
            }
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, args);
    out = list_push(out, a0);
    out = list_push(out, a1);
    out = list_push(out, a2);
    return out;
}

// pos at DOT after receiver primary text `recv`. Lowers .to_string/.contains/.len/.is_ok/.is_err
pub fn c_emit_method(toks: List[String], pos: Int, n: Int, env: String, recv: String) -> List[String] {
    let mut p = pos;
    // DOT
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        let mut bad: List[String] = list_new();
        bad = list_push(bad, p.to_string());
        bad = list_push(bad, recv);
        return bad;
    }
    let mname: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    let mut margs = "";
    let mut a0 = "";
    let mut a1 = "";
    let mut a2 = "";
    let mut call = recv + "." + mname;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        let ap: List[String] = c_emit_call_args(toks, p, n, env);
        p = parse_int(list_get(ap, 0));
        margs = list_get(ap, 1);
        a0 = list_get(ap, 2);
        a1 = list_get(ap, 3);
        a2 = list_get(ap, 4);
        call = recv + "." + mname + "(" + margs + ")";
    }
    // CRIT 2.2: method sinks must run the same secret guard as free calls
    c_secret_emit_guard(env, mname, a0, a1, a2, margs);
    if mname == "to_string" {
        call = "oo_int_to_str(" + recv + ")";
    }
    if mname == "contains" {
        call = "oo_str_contains(" + recv + ", " + margs + ")";
    }
    if mname == "len" {
        let rk: String = c_env_get(env, recv);
        if rk == "S" || rk == "I" {
            call = c_list_c_name("list_len", rk) + "(" + recv + ")";
        } else {
            call = "oo_chars_len(" + recv + ")";
        }
    }
    if mname == "is_ok" {
        call = "(" + recv + ".ok)";
    }
    if mname == "is_err" {
        call = "(!" + recv + ".ok)";
    }
    if mname == "unwrap" {
        // OoResS (.val) vs OoResV (no payload on Ok — empty str; Err via .err message)
        let rk: String = c_env_get(env, recv);
        if rk == "V" {
            call = "((" + recv + ".ok) ? (oo_str_lit(\"\")) : (oo_print_str(oo_str_lit(\"ERR\\tunwrap\")), oo_println(), oo_process_exit(1), oo_str_lit(\"\")))";
        } else {
            call = "((" + recv + ".ok) ? (" + recv + ".val) : (oo_print_str(oo_str_lit(\"ERR\\tunwrap\")), oo_println(), oo_process_exit(1), " + recv + ".val))";
        }
    }
    // CAP-G1/T4 residual: flight-recorder wrap disabled — incomplete preamble
    // redefines break sealed free-call lower / unknown-call annotation.
    // call = "(OO_FLIGHT_RECORDER_LOG(), " + call + ")";
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, call);
    return out;
}

// M166 path A: IDENT [ expr ] → list_get lower (array index sugar; not pointer arith).
// pos at LBRACKET; base is the list C expression (usually IDENT name).
pub fn c_emit_index_get(toks: List[String], pos: Int, n: Int, env: String, base: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let idx = list_get(pr, 1);
    if p < n && field_at(list_get(toks, p), 0) == "RBRACKET" {
        p = p + 1;
    }
    let lk: String = c_infer_list_kind(env, "list_get", base, idx);
    let cname: String = c_list_c_name("list_get", lk);
    let call = cname + "(" + base + ", " + idx + ")";
    if p < n && field_at(list_get(toks, p), 0) == "DOT" {
        return c_emit_method(toks, p, n, env, call);
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, call);
    return out;
}
