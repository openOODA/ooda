// # Detect eight println string statements
//
// Logline: Returns eight STRING texts joined by newlines when a function body is only eight println(STRING) statements.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept eight println(STRING) statements with optional semicolons.
//   3. Require RBRACE. IDENT or a ninth print misses.
//
// residual: nine prints and mixed IDENT stay dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn w8_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn w8_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn w8_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if w8_kind(toks, p) != "IDENT" || w8_text(toks, p) != "println" { return empty; }
    if w8_kind(toks, p + 1) != "LPAREN" || w8_kind(toks, p + 2) != "STRING" { return empty; }
    if w8_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = w8_text(toks, p + 2);
    p = p + 4;
    if p < n && w8_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn w8_take(toks: List[String], p0: Int, n: Int) -> List[String] {
    return w8_one_str_println(toks, p0, n);
}

pub fn wasm_fn_eight_println(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if w8_kind(toks, i) == "KW_FN" && w8_kind(toks, i + 1) == "IDENT" {
            if w8_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && w8_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                let mut acc: String = "";
                let mut k: Int = 0;
                while k < 8 {
                    let one: List[String] = w8_take(toks, p, n);
                    if list_len(one) < 2 { return ""; }
                    if k == 0 { acc = list_get(one, 0); } else { acc = acc + "\n" + list_get(one, 0); }
                    p = parse_int(list_get(one, 1));
                    k = k + 1;
                }
                if p < n && w8_kind(toks, p) == "RBRACE" { return acc; }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
