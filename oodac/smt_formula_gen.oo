// # SMT-LIB2 Formula Generator
//
// Logline: Generates standard SMT-LIB2 QF_LIA S-expressions from parsed contract clauses and verification conditions.
//
// Setup: Emits (set-logic QF_LIA), (declare-const ...), and (assert ...) formulas for SMT solvers.
//
// Beats:
//   1. Construct SMT-LIB2 script buffer with QF_LIA logic header.
//   2. Translate relational clauses into S-expression predicates.
//   3. Negate postconditions to formulate theorem refutation targets.
//   4. Emit complete SMT-LIB2 benchmark scripts.
// RULES.oot 1.7: Under 256 lines.

import "smt_contract_parse.oo";

pub fn smt_formula_gen_op_to_smt2(op: String) -> String {
    if op == "==" { return "="; }
    if op == "!=" { return "distinct"; }
    if op == ">" { return ">"; }
    if op == ">=" { return ">="; }
    if op == "<" { return "<"; }
    if op == "<=" { return "<="; }
    return "=";
}

pub fn smt_formula_gen_clause_sexpr(cl: String) -> String {
    let smt_op: String = smt_formula_gen_op_to_smt2(smt_contract_parse_op(cl));
    let mut lhs: String = smt_contract_parse_lhs(cl);
    let rc: Int = smt_contract_parse_rhs_const(cl);
    let mut rhs: String = rc.to_string();
    let rv: String = smt_contract_parse_rhs_var(cl);
    if rv != "" { rhs = rv; }
    if lhs == "" { lhs = "0"; }
    if smt_op == "distinct" {
        return "(distinct " + lhs + " " + rhs + ")";
    }
    return "(" + smt_op + " " + lhs + " " + rhs + ")";
}

pub fn smt_formula_gen_negated_sexpr(cl: String) -> String {
    let pos_sexpr: String = smt_formula_gen_clause_sexpr(cl);
    return "(not " + pos_sexpr + ")";
}

pub fn smt_formula_gen_build(decls: List[String], asserts: List[String], check_sat: Bool) -> String {
    let mut out: String = "(set-logic QF_LIA)\n";
    let n_decl: Int = list_len(decls);
    let mut i: Int = 0;
    while i < n_decl {
        let vname: String = list_get(decls, i);
        out = out + "(declare-const " + vname + " Int)\n";
        i = i + 1;
    }
    let n_ass: Int = list_len(asserts);
    i = 0;
    while i < n_ass {
        let ass_str: String = list_get(asserts, i);
        out = out + "(assert " + ass_str + ")\n";
        i = i + 1;
    }
    if check_sat {
        out = out + "(check-sat)\n(get-model)\n";
    }
    return out;
}
