// # Emit raw x86_64 decimal integer write
//
// Logline: Emits raw x86_64 itoa decimal conversion loop and sys_write for println(Int).
//
// Setup: tokenize_lines, x86_tok_k, and x86_tok_t exist in x86_emit_harv.oo.
//
// Beats:
//   1. Match main body containing println(INT) or println(-INT).
//   2. Emit standalone _println_int routine using div by 10 into stack buffer.
//   3. Emit _start calling _println_int and exiting with syscall 60.

import "token_fmt.oo";
import "x86_emit_harv.oo";

pub fn x86_match_int_write(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 4 < n && x86_tok_k(toks, p) == "LPAREN" && x86_tok_k(toks, p + 1) == "RPAREN" && x86_tok_k(toks, p + 2) == "LBRACE" && x86_tok_t(toks, p + 3) == "println" && x86_tok_k(toks, p + 4) == "LPAREN" {
                p = p + 5;
                let mut sign = "";
                if p < n && x86_tok_k(toks, p) == "MINUS" {
                    sign = "-";
                    p = p + 1;
                }
                if p < n && x86_tok_k(toks, p) == "INT" {
                    let num_str: String = sign + x86_tok_t(toks, p);
                    p = p + 1;
                    if p < n && x86_tok_k(toks, p) == "RPAREN" {
                        p = p + 1;
                        if p < n && x86_tok_k(toks, p) == "SEMI" { p = p + 1; }
                        if p < n && x86_tok_k(toks, p) == "RBRACE" {
                            let mut out: List[String] = list_new();
                            out = list_push(out, num_str);
                            return out;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn x86_emit_int_routine() {
    println(".globl _println_int");
    println(".p2align 4");
    println("_println_int:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $32, %rsp");
    println("    mov %rdi, %rax");
    println("    movb $10, -1(%rbp)");
    println("    lea -1(%rbp), %rcx");
    println("    mov $1, %r8");
    println("    test %rax, %rax");
    println("    jnz .Lpi_nonzero");
    println("    dec %rcx");
    println("    movb $48, (%rcx)");
    println("    inc %r8");
    println("    jmp .Lpi_write");
    println(".Lpi_nonzero:");
    println("    xor %r9, %r9");
    println("    test %rax, %rax");
    println("    jns .Lpi_loop");
    println("    neg %rax");
    println("    mov $1, %r9");
    println(".Lpi_loop:");
    println("    test %rax, %rax");
    println("    jz .Lpi_sign");
    println("    xor %rdx, %rdx");
    println("    mov $10, %r10");
    println("    div %r10");
    println("    add $48, %dl");
    println("    dec %rcx");
    println("    movb %dl, (%rcx)");
    println("    inc %r8");
    println("    jmp .Lpi_loop");
    println(".Lpi_sign:");
    println("    test %r9, %r9");
    println("    jz .Lpi_write");
    println("    dec %rcx");
    println("    movb $45, (%rcx)");
    println("    inc %r8");
    println(".Lpi_write:");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    println("    mov %rcx, %rsi");
    println("    mov %r8, %rdx");
    println("    syscall");
    println("    add $32, %rsp");
    println("    pop %rbp");
    println("    ret");
}

pub fn x86_emit_int_write(num_str: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    x86_emit_int_routine();
    println("main:");
    println("_start:");
    println("    mov $" + num_str + ", %rdi");
    println("    call _println_int");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
