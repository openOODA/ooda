// # Check a refined return INT
//
// Logline: When a fn has an Int[lo..hi] return bound, reject a literal return N or return -N that falls outside it.
//
// Setup: parse_int, field_at, list_get, list_len, println, and process_exit exist; typecheck_refinements calls this on KW_RETURN.
//
// Beats:
//   1. Return immediately when there is no captured bound or the next token is missing.
//   2. Read INT, or MINUS INT as a negative, from the tokens after return.
//   3. If the value is outside [ret_bound_min, ret_bound_max], print RefinementTypeViolation and process_exit(1).

pub fn refine_check_return(toks: List[String], i: Int, has_ret_bound: Bool, ret_bound_min: Int, ret_bound_max: Int) {
    if !has_ret_bound {
        return;
    }
    let n = list_len(toks);
    if i + 1 >= n {
        return;
    }
    let k1: String = field_at(list_get(toks, i + 1), 0);
    let mut val = 0;
    let mut ok = false;
    let mut line: String = field_at(list_get(toks, i + 1), 1);
    let mut col: String = field_at(list_get(toks, i + 1), 2);
    if k1 == "INT" {
        val = parse_int(field_at(list_get(toks, i + 1), 3));
        ok = true;
    } else if k1 == "MINUS" {
        if i + 2 < n {
            if field_at(list_get(toks, i + 2), 0) == "INT" {
                val = 0 - parse_int(field_at(list_get(toks, i + 2), 3));
                line = field_at(list_get(toks, i + 2), 1);
                col = field_at(list_get(toks, i + 2), 2);
                ok = true;
            }
        }
    }
    if ok {
        if val < ret_bound_min || val > ret_bound_max {
            println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
            process_exit(1);
        }
    }
}
