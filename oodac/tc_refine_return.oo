// job: check return INT against captured ret refinement; stage: typecheck
// in: toks + i + bounds; out: side-effect ERR/exit or none

pub fn refine_check_return(toks: List[String], i: Int, has_ret_bound: Bool, ret_bound_min: Int, ret_bound_max: Int) {
    if has_ret_bound {
        if i + 1 < list_len(toks) {
            if field_at(list_get(toks, i + 1), 0) == "INT" {
                let val = parse_int(field_at(list_get(toks, i + 1), 3));
                if val < ret_bound_min || val > ret_bound_max {
                    let line = field_at(list_get(toks, i + 1), 1);
                    let col = field_at(list_get(toks, i + 1), 2);
                    println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
                    process_exit(1);
                }
            }
        }
    }
}
