// # Emit SysV second-arg String call
//
// Logline: Matches two-arg String passthrough of %rsi plus println(fn(STRING, STRING)) and emits lea rdi/rsi then call.
//
// Setup: tokenize_lines, x86_tok_k, x86_tok_t, x86_ascii_esc, and x86_emit_frame_enter/leave exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of its second String param.
//   2. Require main to be only println of that fn on two STRING args.
//   3. Emit mov %rsi,%rax; caller lea rdi+rsi, call, SYS_write from %rax.
//
// residual: Int args, 3-arg rdx, and AArch64 stay later.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";
import "x86_emit_frame.oo";

fn x86_snd_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 15 >= n {
        return empty;
    }
    if x86_tok_k(toks, i) != "KW_FN" {
        return empty;
    }
    if x86_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = x86_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let p1: String = x86_tok_t(toks, i + 3);
    if x86_tok_k(toks, i + 4) != "COLON" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "COMMA" {
        return empty;
    }
    if x86_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    let p2: String = x86_tok_t(toks, i + 7);
    if x86_tok_k(toks, i + 8) != "COLON" {
        return empty;
    }
    if x86_tok_k(toks, i + 9) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 9) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 10) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 11) != "ARROW" {
        return empty;
    }
    if x86_tok_k(toks, i + 12) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 12) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 13) != "LBRACE" {
        return empty;
    }
    if x86_tok_k(toks, i + 14) != "KW_RETURN" {
        return empty;
    }
    if x86_tok_k(toks, i + 15) != "IDENT" {
        return empty;
    }
    let rn: String = x86_tok_t(toks, i + 15);
    if rn != p2 || rn == p1 {
        return empty;
    }
    let mut p = i + 16;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    return o;
}

fn x86_snd_main_body(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 13 >= n {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 4) != "LBRACE" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "println" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 7) != fname {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let a: String = x86_tok_t(toks, i + 9);
    if x86_tok_k(toks, i + 10) != "COMMA" {
        return empty;
    }
    if x86_tok_k(toks, i + 11) != "STRING" {
        return empty;
    }
    let b: String = x86_tok_t(toks, i + 11);
    if x86_tok_k(toks, i + 12) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 13) != "RPAREN" {
        return empty;
    }
    let mut p = i + 14;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, a);
    o = list_push(o, b);
    return o;
}

pub fn x86_match_snd_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 {
        return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 >= n || x86_tok_k(toks, i + 1) != "IDENT" {
                return empty;
            }
            let nm: String = x86_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = x86_snd_shape(toks, n, i);
                if list_len(idn) < 1 {
                    return empty;
                }
                if chars_len(fname) > 0 {
                    return empty;
                }
                fname = list_get(idn, 0);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 {
        return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" {
                if x86_tok_t(toks, i + 1) == "main" {
                    if list_len(found) >= 1 {
                        return empty;
                    }
                    found = x86_snd_main_body(toks, n, i, fname);
                    if list_len(found) < 3 {
                        return empty;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn x86_emit_snd_call(fname: String, a: String, b: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lstr0:");
    println("    .ascii \"" + x86_ascii_esc(a) + "\"");
    println(".Lstr1:");
    println("    .ascii \"" + x86_ascii_esc(b) + "\\n\"");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println("    .p2align 4");
    println(fname + ":");
    x86_emit_frame_enter();
    println("    mov %rsi, %rax");
    x86_emit_frame_leave();
    println("main:");
    println("_start:");
    println("    lea .Lstr0(%rip), %rdi");
    println("    lea .Lstr1(%rip), %rsi");
    println("    call " + fname);
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    let ln = chars_len(b) + 1;
    println("    mov $" + ln.to_string() + ", %rdx");
    println("    syscall");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
