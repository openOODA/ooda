// # Sovereign Direct Machine Code Build Router
//
// Logline: Routes CLI builds to in-process x86-64 ELF, AArch64 ELF, and pure WASM binary generators.
//
// Setup: fs and sys capabilities granted; compiles source to standalone binary without host toolchains.
//
// Beats:
//   1. Check if backend is a sovereign direct machine code target (x86_64-elf, aarch64, wasm).
//   2. Load source with imports.
//   3. Dispatch to matching binary generator.
//   4. Return true on success or false on failure.

import "load_import.oo";
import "x86_emit_elf.oo";
import "aarch64_emit_elf.oo";
import "wasm_direct_emit.oo";

pub fn is_sovereign_backend(backend: String) -> Bool {
    if backend == "x86_64-elf" || backend == "aarch64" || backend == "wasm" {
        return true;
    }
    return false;
}

pub fn run_build_sovereign(fs: &FsCap, sys: &SysCap, path: String, out: String, backend: String) -> Bool {
    let src: String = load_source_with_imports(fs, path);
    if backend == "x86_64-elf" {
        return x86_emit_direct_elf_binary(sys, src, out);
    }
    if backend == "aarch64" {
        return aarch64_emit_direct_elf_binary(sys, src, out);
    }
    if backend == "wasm" {
        return wasm_emit_direct_binary(sys, src, out);
    }
    return false;
}
