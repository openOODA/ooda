// job: Top-level AST-to-interpreter-bytecode emitter package entrypoint
// stage: emit

import "token_fmt.oo";
import "c_emit_skip.oo";
import "bc_emit_env.oo";
import "bc_emit_expr.oo";
import "bc_emit_stmt.oo";
import "bc_emit_surface.oo";

pub fn bc_emit_program(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    let mut program_bc: String = ".version 1.0";
    let mut label_ctr: Int = 0;

    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let fn_res: List[String] = bc_emit_function(toks, pos, n, label_ctr);
            pos = parse_int(list_get(fn_res, 0));
            label_ctr = parse_int(list_get(fn_res, 1));
            let fn_bc: String = list_get(fn_res, 2);
            program_bc = program_bc + "\n" + fn_bc;
        } else if k == "KW_VERIFY" {
            pos = c_emit_skip_verify(toks, pos, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else if k == "IDENT" && field_at(list_get(toks, pos), 3) == "struct" {
            pos = bc_skip_struct_def(toks, pos, n);
        } else {
            pos = pos + 1;
        }
    }

    return program_bc;
}

pub fn bc_emit_function(toks: List[String], pos: Int, n: Int, label_ctr: Int) -> List[String] {
    let mut p: Int = pos;
    let mut lc: Int = label_ctr;
    if field_at(list_get(toks, p), 0) == "KW_PUB" { p = p + 1; }
    if field_at(list_get(toks, p), 0) == "KW_FN" { p = p + 1; }

    let fn_name: String = field_at(list_get(toks, p), 3);
    p = p + 1; // consume fn name
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }

    let mut env: String = bc_env_new();
    let mut argc: Int = 0;

    while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
        let pk: String = field_at(list_get(toks, p), 0);
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname: String = field_at(list_get(toks, p), 3);
            p = p + 1;
            let env_res: List[String] = bc_env_add_var(env, pname);
            env = list_get(env_res, 1);
            argc = argc + 1;
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = c_emit_skip_type(toks, p, n);
            }
        } else {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }

    if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
        p = c_emit_skip_type(toks, p, n);
    }

    p = c_emit_skip_contracts(toks, p, n);

    let body_res: List[String] = bc_emit_block(toks, p, n, env, lc);
    p = parse_int(list_get(body_res, 0));
    env = list_get(body_res, 1);
    lc = parse_int(list_get(body_res, 2));
    let body_code: String = list_get(body_res, 3);

    let num_locals: Int = bc_env_count(env);
    let arity_str: String = argc.to_string();
    let locs_str: String = num_locals.to_string();
    let header: String = ".func " + fn_name + " arity=" + arity_str + " locals=" + locs_str;
    let mut fn_bc: Int = header;
    if body_code != "" {
        fn_bc = fn_bc + "\n" + body_code;
    }
    fn_bc = fn_bc + "\nRETURN\n.endfunc";

    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, lc.to_string());
    res = list_push(res, fn_bc);
    return res;
}
