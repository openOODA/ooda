// # Compiler AST Macro structures and registration
//
// Logline: Manages compiler-internal AST macro rules, token templates, hygiene tables, and node bindings.
//
// Setup: Pure record definitions, token slice helpers, and macro table descriptors.
//
// Beats:
//   1. Declare MacroDef and MacroTable structures for compiler expansion.
//   2. Implement macro definition registration and lookup.
//   3. Implement token template substitution and hygienic symbol generation.
//
// residual: Dynamic macro bytecode compilation requires JIT VM evaluation

pub type MacroDef = struct {
    name: String,
    params: List[String],
    template_tokens: List[String],
    is_hygienic: Bool,
};

pub type MacroTable = struct {
    defs: List[MacroDef],
    count: Int,
    gensym_seq: Int,
};

pub fn ast_macro_field_at(line: String, which: Int) -> String {
    let n: Int = chars_len(line);
    if n == 0 {
        return "";
    }
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(line, i);
        if ch == "\t" {
            if field == which {
                return str_slice(line, start, i);
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if field == which {
        return str_slice(line, start, n);
    }
    return "";
}

pub fn ast_macro_tok_line(kind: String, line: Int, col: Int, text: String) -> String {
    return kind + "\t" + line.to_string() + "\t" + col.to_string() + "\t" + text;
}

pub fn macro_table_new() -> MacroTable {
    let empty_defs: List[MacroDef] = list_new();
    return MacroTable {
        defs: empty_defs,
        count: 0,
        gensym_seq: 1,
    };
}

pub fn macro_def_new(name: String, params: List[String], tmpl: List[String]) -> MacroDef {
    return MacroDef {
        name: name,
        params: params,
        template_tokens: tmpl,
        is_hygienic: true,
    };
}

pub fn macro_table_add(tab: &mut MacroTable, mdef: MacroDef) -> Bool {
    let defs: List[MacroDef] = (*tab).defs;
    let n: Int = list_len(defs);
    let mut i: Int = 0;
    while i < n {
        let d: MacroDef = list_get(defs, i);
        if (d).name == (mdef).name {
            return false;
        }
        i = i + 1;
    }
    let updated: List[MacroDef] = list_push(defs, mdef);
    (*tab).defs = updated;
    (*tab).count = (*tab).count + 1;
    return true;
}

pub fn macro_table_find(tab: &MacroTable, name: String) -> Int {
    let defs: List[MacroDef] = (*tab).defs;
    let n: Int = list_len(defs);
    let mut i: Int = 0;
    while i < n {
        let d: MacroDef = list_get(defs, i);
        if (d).name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn macro_table_gensym(tab: &mut MacroTable, base_name: String) -> String {
    let seq: Int = (*tab).gensym_seq;
    (*tab).gensym_seq = seq + 1;
    return "__m_" + base_name + "_" + seq.to_string();
}

pub fn macro_substitute_tokens(tmpl: List[String], param_names: List[String], arg_val: String) -> List[String] {
    let n: Int = list_len(tmpl);
    let mut out: List[String] = list_new();
    let np: Int = list_len(param_names);
    let mut target_param: String = "";
    if np > 0 {
        target_param = list_get(param_names, 0);
    }
    let mut i: Int = 0;
    while i < n {
        let tok_line_str: String = list_get(tmpl, i);
        let k: String = ast_macro_field_at(tok_line_str, 0);
        let text: String = ast_macro_field_at(tok_line_str, 3);
        if k == "IDENT" && text == target_param && target_param != "" {
            let replaced: String = ast_macro_tok_line("LIT_INT", 1, 1, arg_val);
            out = list_push(out, replaced);
        } else {
            out = list_push(out, tok_line_str);
        }
        i = i + 1;
    }
    return out;
}
