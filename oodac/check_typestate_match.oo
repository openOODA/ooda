// # Join TYPESTATE match arms
//
// Logline: Walk each match arm from the pre-bind state, require a { } body after =>, and merge the results like if/else.
//
// Setup: ts_tok_line, ts_find_lbrace, ts_skip_braces, ts_tok_kind, ts_walk_span, and ts_merge_branch exist; the check walk calls this at a match keyword.
//
// Beats:
//   1. Find the match LBRACE, skip to its close, and start p just inside.
//   2. On FATARROW, require a following LBRACE or print ERR and exit; walk the arm from binds0 and merge into acc.
//   3. Return binds0 if no arm ran, else acc. ts_match_end is the index after the match braces.

pub fn ts_eval_match(toks: List[String], i: Int, hi: Int, env: String, binds0: String) -> String {
    let line: String = ts_tok_line(toks, i);
    let lb: Int = ts_find_lbrace(toks, i, hi);
    let mend: Int = ts_skip_braces(toks, lb);
    let mut p = lb + 1;
    let mut have = false;
    let mut acc: String = binds0;
    while p < mend - 1 {
        let k: String = ts_tok_kind(toks, p);
        if k == "FATARROW" {
            if p + 1 >= mend {
                println("ERR\ttypestate\tmatch arm needs a body at line " + line);
                process_exit(1);
            }
            let bk: String = ts_tok_kind(toks, p + 1);
            if bk != "LBRACE" {
                println("ERR\ttypestate\tmatch arm needs { } at line " + line);
                process_exit(1);
            }
            let end: Int = ts_skip_braces(toks, p + 1);
            let arm: String = ts_walk_span(toks, p + 2, end - 1, env, binds0);
            if !have {
                acc = arm;
                have = true;
            } else {
                acc = ts_merge_branch(binds0, acc, arm, line);
            }
            p = end;
        } else {
            p = p + 1;
        }
    }
    if !have { return binds0; }
    return acc;
}

pub fn ts_match_end(toks: List[String], i: Int, hi: Int) -> Int {
    let lb: Int = ts_find_lbrace(toks, i, hi);
    return ts_skip_braces(toks, lb);
}
