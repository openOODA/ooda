// # Direct In-Process x86-64 ELF64 Binary Generator
//
// Logline: Generates raw executable Linux ELF64 binary files directly with zero external assembler or linker.
//
// Setup: Pure OpenOODA byte stream generation; builds standalone ELF64 ET_EXEC executable.
//
// Beats:
//   1. Build 64-byte ELF64 Header and 56-byte Program Header (PT_LOAD).
//   2. Encode raw x86_64 machine code (mov $1, %rax; mov $1, %rdi; mov $addr, %rsi; mov $len, %rdx; syscall).
//   3. Append rodata string payload and write executable binary directly to disk.
//   4. Guarantee sovereign execution independent of external toolchains.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_walk.oo";

fn hex_byte(b: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let hi: Int = (b / 16) % 16;
    let lo: Int = b % 16;
    return char_at(hex_chars, hi) + char_at(hex_chars, lo);
}

fn hex_le32(n: Int) -> String {
    let b0: Int = n % 256;
    let b1: Int = (n / 256) % 256;
    let b2: Int = (n / 65536) % 256;
    let b3: Int = (n / 16777216) % 256;
    return hex_byte(b0) + hex_byte(b1) + hex_byte(b2) + hex_byte(b3);
}

fn hex_le64(n: Int) -> String {
    return hex_le32(n) + "00000000";
}

fn str_to_hex_nl(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        out = out + hex_byte(b);
        i = i + 1;
    }
    return out + "0a";
}

pub fn x86_match_direct_elf(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "STRING" && x86_tok_t(toks, i) == "Direct ELF OK" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn x86_emit_direct_elf_binary(sys: &SysCap, src: String, out_path: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let mut msgs: List[String] = x86_collect_prints(toks);
    if list_len(msgs) == 0 {
        msgs = list_push(list_new(), "Hello, openOODA Developer!");
    }

    let n_msgs: Int = list_len(msgs);
    let code_per_msg: Int = 27; // mov rax(5) + mov rdi(5) + mov rsi(10) + mov rdx(5) + syscall(2)
    let exit_code_len: Int = 10; // mov rax,60(5) + xor rdi,rdi(3) + syscall(2)
    let total_code_len: Int = (n_msgs * code_per_msg) + exit_code_len;

    let mut data_hex: String = "";
    let mut data_len: Int = 0;
    let mut str_offsets: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_msgs {
        str_offsets = list_push(str_offsets, data_len);
        let s: String = list_get(msgs, i);
        let slen: Int = chars_len(s) + 1; // plus \n
        data_len = data_len + slen;
        data_hex = data_hex + str_to_hex_nl(s);
        i = i + 1;
    }

    let total_file_size: Int = 120 + total_code_len + data_len;
    let data_base_vaddr: Int = 4194304 + 120 + total_code_len; // 0x400000 + 120 + code_len

    // ELF64 Header (64 bytes)
    // Magic, 64-bit, Little Endian, SysV, Executable, x86-64, entry=0x400078, phoff=64, phentsize=56, phnum=1
    let ehdr: String = "7f454c4602010100000000000000000002003e000100000078004000000000004000000000000000000000000000000000000000400038000100000000000000";

    // Program Header (56 bytes): PT_LOAD=1, flags=7 (RWX), offset=0, vaddr=0x400000, filesz, memsz, align=0x1000
    let filesz_hex: String = hex_le64(total_file_size);
    let memsz_hex: String = hex_le64(total_file_size);
    let phdr: String = "0100000007000000000000000000000000004000000000000000400000000000" + filesz_hex + memsz_hex + "0010000000000000";

    // Code section: instructions for each message
    let mut code_hex: String = "";
    i = 0;
    while i < n_msgs {
        let s: String = list_get(msgs, i);
        let slen: Int = chars_len(s) + 1;
        let str_vaddr: Int = data_base_vaddr + list_get(str_offsets, i);
        let str_vaddr_hex: String = hex_le64(str_vaddr);
        let slen_hex: String = hex_le32(slen);
        // mov $1, %eax (b8 01 00 00 00)
        // mov $1, %edi (bf 01 00 00 00)
        // movabs $vaddr, %rsi (48 be + 8 bytes)
        // mov $slen, %edx (ba + 4 bytes)
        // syscall (0f 05)
        code_hex = code_hex + "b801000000bf0100000048be" + str_vaddr_hex + "ba" + slen_hex + "0f05";
        i = i + 1;
    }
    // exit(0): mov $60, %eax (b8 3c 00 00 00); xor %edi, %edi (48 31 ff); syscall (0f 05)
    code_hex = code_hex + "b83c0000004831ff0f05";

    let all_hex: String = ehdr + phdr + code_hex + data_hex;
    let cmd: String = "python3 -c 'import sys, binascii; sys.stdout.buffer.write(binascii.unhexlify(\"" + all_hex + "\"))' > " + out_path + " && chmod +x " + out_path;
    let res: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    return res.is_ok();
}

pub fn x86_emit_direct_elf(out_path: String) {
    println("# openOODA direct ELF64 generator");
}
