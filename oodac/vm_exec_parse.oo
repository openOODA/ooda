// # Parse a bytecode program
//
// Logline: Splits a bytecode listing into instruction lines, function info rows, and label addresses.
//
// Setup: chars_len, char_at, str_slice, list_new, list_push, and parse_int exist; .func lines carry arity and locals; LABEL lines are not code.
//
// Beats:
//   1. parse_bytecode_code collects non-LABEL lines between .func and .endfunc.
//   2. parse_bytecode_fn_info stores name, start count, arity, and locals; parse_bytecode_labels maps fn:name to that count.
//   3. find_label_ip returns the tab-separated address for a target, or 0.

pub fn parse_bytecode_code(bc: String) -> List[String] {
    let bc_len = chars_len(bc);
    let mut code: List[String] = list_new();
    if bc_len == 0 {
        return code;
    }
    let mut line_start = 0;
    let mut cur_fn = "";
    let mut k = 0;
    while k <= bc_len {
        let is_end = (k == bc_len);
        let mut is_nl = false;
        if !is_end { if char_at(bc, k) == "\n" { is_nl = true; } }
        if is_end || is_nl {
            let line = str_slice(bc, line_start, k);
            line_start = k + 1;
            let l_len = chars_len(line);
            if l_len > 0 {
                if l_len >= 5 && str_slice(line, 0, 5) == ".func" {
                    let mut fn_name = "";
                    let mut sp = 6;
                    let line_n = chars_len(line);
                    let mut t_start = 6;
                    while sp <= line_n {
                        let e_tok = (sp == line_n);
                        let mut is_sp = false;
                        if !e_tok { if char_at(line, sp) == " " { is_sp = true; } }
                        if e_tok || is_sp {
                            fn_name = str_slice(line, t_start, sp);
                            break;
                        }
                        sp = sp + 1;
                    }
                    cur_fn = fn_name;
                } else if l_len >= 8 && str_slice(line, 0, 8) == ".endfunc" {
                    cur_fn = "";
                } else if cur_fn != "" {
                    if !(l_len >= 6 && str_slice(line, 0, 6) == "LABEL ") {
                        code = list_push(code, line);
                    }
                }
            }
        }
        k = k + 1;
    }
    return code;
}

pub fn parse_bytecode_fn_info(bc: String) -> List[String] {
    let bc_len = chars_len(bc);
    let mut fn_info: List[String] = list_new();
    if bc_len == 0 {
        return fn_info;
    }
    let mut line_start = 0;
    let mut cur_fn = "";
    let mut code_count = 0;
    let mut k = 0;
    while k <= bc_len {
        let is_end = (k == bc_len);
        let mut is_nl = false;
        if !is_end { if char_at(bc, k) == "\n" { is_nl = true; } }
        if is_end || is_nl {
            let line = str_slice(bc, line_start, k);
            line_start = k + 1;
            let l_len = chars_len(line);
            if l_len > 0 {
                if l_len >= 5 && str_slice(line, 0, 5) == ".func" {
                    let mut fn_name = "";
                    let mut arity = 0;
                    let mut locs = 0;
                    let mut sp = 6;
                    let mut tok_i = 0;
                    let line_n = chars_len(line);
                    let mut t_start = 6;
                    while sp <= line_n {
                        let e_tok = (sp == line_n);
                        let mut is_sp = false;
                        if !e_tok { if char_at(line, sp) == " " { is_sp = true; } }
                        if e_tok || is_sp {
                            let item = str_slice(line, t_start, sp);
                            t_start = sp + 1;
                            if tok_i == 0 { fn_name = item; }
                            else if chars_len(item) > 6 && str_slice(item, 0, 6) == "arity=" {
                                arity = parse_int(str_slice(item, 6, chars_len(item)));
                            } else if chars_len(item) > 7 && str_slice(item, 0, 7) == "locals=" {
                                locs = parse_int(str_slice(item, 7, chars_len(item)));
                            }
                            tok_i = tok_i + 1;
                        }
                        sp = sp + 1;
                    }
                    cur_fn = fn_name;
                    let c_s: String = code_count.to_string();
                    let a_s: String = arity.to_string();
                    let l_s: String = locs.to_string();
                    let info_entry: String = fn_name + "\t" + c_s + "\t" + a_s + "\t" + l_s;
                    fn_info = list_push(fn_info, info_entry);
                } else if l_len >= 8 && str_slice(line, 0, 8) == ".endfunc" {
                    cur_fn = "";
                } else if cur_fn != "" {
                    if !(l_len >= 6 && str_slice(line, 0, 6) == "LABEL ") {
                        code_count = code_count + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    return fn_info;
}

pub fn parse_bytecode_labels(bc: String) -> List[String] {
    let bc_len = chars_len(bc);
    let mut labels: List[String] = list_new();
    if bc_len == 0 {
        return labels;
    }
    let mut line_start = 0;
    let mut cur_fn = "";
    let mut code_count = 0;
    let mut k = 0;
    while k <= bc_len {
        let is_end = (k == bc_len);
        let mut is_nl = false;
        if !is_end { if char_at(bc, k) == "\n" { is_nl = true; } }
        if is_end || is_nl {
            let line = str_slice(bc, line_start, k);
            line_start = k + 1;
            let l_len = chars_len(line);
            if l_len > 0 {
                if l_len >= 5 && str_slice(line, 0, 5) == ".func" {
                    let mut fn_name = "";
                    let mut sp = 6;
                    let line_n = chars_len(line);
                    let mut t_start = 6;
                    while sp <= line_n {
                        let e_tok = (sp == line_n);
                        let mut is_sp = false;
                        if !e_tok { if char_at(line, sp) == " " { is_sp = true; } }
                        if e_tok || is_sp {
                            fn_name = str_slice(line, t_start, sp);
                            break;
                        }
                        sp = sp + 1;
                    }
                    cur_fn = fn_name;
                } else if l_len >= 8 && str_slice(line, 0, 8) == ".endfunc" {
                    cur_fn = "";
                } else if cur_fn != "" {
                    if l_len >= 6 && str_slice(line, 0, 6) == "LABEL " {
                        let lbl_name = str_slice(line, 6, l_len);
                        let c_s: String = code_count.to_string();
                        let lbl_entry: String = cur_fn + ":" + lbl_name + "\t" + c_s;
                        labels = list_push(labels, lbl_entry);
                    } else {
                        code_count = code_count + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    return labels;
}

pub fn find_label_ip(labels: List[String], target: String) -> Int {
    let n_lbl = list_len(labels);
    let mut li = 0;
    while li < n_lbl {
        let l_item = list_get(labels, li);
        let l_len = chars_len(l_item);
        let mut start_l = 0;
        let mut p_l = 0;
        let mut key = "";
        let mut target_i = 0;
        while p_l <= l_len {
            let e_l = (p_l == l_len);
            let mut is_t = false;
            if !e_l { if char_at(l_item, p_l) == "\t" { is_t = true; } }
            if e_l || is_t {
                let part = str_slice(l_item, start_l, p_l);
                if key == "" { key = part; } else { target_i = parse_int(part); }
                start_l = p_l + 1;
            }
            p_l = p_l + 1;
        }
        if key == target { return target_i; }
        li = li + 1;
    }
    return 0;
}
