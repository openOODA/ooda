// # Check TYPESTATE machines
//
// Logline: Parse TYPESTATE directives and walk the program, or return when no fn directive exists.
//
// Setup: check_typestate_tok, check_typestate_parse, and check_typestate_walk are imported; src is source text and toks are its tokens.
//
// Beats:
//   1. Parse source directives into env.
//   2. Return at once when env has no TYPESTATE fn.
//   3. Walk toks with that env; a bad transition prints ERR and exits.

import "check_typestate_tok.oo";
import "check_typestate_parse.oo";
import "check_typestate_walk.oo";

pub fn check_typestate(src: String, toks: List[String]) {
    let env: String = ts_parse_directives(src);
    if !ts_has_any_fn(env) {
        return;
    }
    ts_walk_program(toks, env);
}
