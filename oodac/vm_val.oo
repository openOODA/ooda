// job: Tagged dynamic value representation for Interpreter (Bytecode VM)
// stage: vm

pub fn val_int(n: Int) -> String {
    return "I:" + n.to_string();
}

pub fn val_str(s: String) -> String {
    return "S:" + s;
}

pub fn val_bool(b: Int) -> String {
    if b != 0 {
        return "B:true";
    }
    return "B:false";
}

pub fn val_void() -> String {
    return "V:0";
}

pub fn val_type(v: String) -> String {
    if chars_len(v) < 2 {
        return "V";
    }
    return str_slice(v, 0, 1);
}

pub fn val_to_int(v: String) -> Int {
    let t: String = "" + val_type(v);
    if t == "I" {
        let payload: String = str_slice(v, 2, chars_len(v));
        return parse_int(payload);
    }
    if t == "B" {
        if v == "B:true" {
            return 1;
        }
        return 0;
    }
    return 0;
}

pub fn val_to_str(v: String) -> String {
    let t: String = "" + val_type(v);
    if t == "S" || t == "I" {
        return str_slice(v, 2, chars_len(v));
    }
    if t == "B" {
        if v == "B:true" {
            return "true";
        }
        return "false";
    }
    if t == "V" {
        return "";
    }
    return v;
}

pub fn val_to_bool(v: String) -> Bool {
    let t: String = "" + val_type(v);
    if t == "B" {
        return v == "B:true";
    }
    if t == "I" {
        return val_to_int(v) != 0;
    }
    if t == "S" {
        return chars_len(val_to_str(v)) > 0;
    }
    return false;
}

pub fn val_is_truthy(v: String) -> Bool {
    return val_to_bool(v);
}
