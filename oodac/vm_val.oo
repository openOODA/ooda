// # Pack and unpack tagged VM values
//
// Logline: Encodes ints, strings, bools, and void as tagged strings and converts those tags back to Int, String, or Bool.
//
// Setup: constructors write I:, S:, B:true, B:false, or V:0; val_type reads the first character when the string is at least two characters long.
//
// Beats:
//   1. val_int, val_str, val_bool, and val_void build the tagged form.
//   2. val_type returns V for short strings, otherwise the first character.
//   3. val_to_int, val_to_str, val_to_bool, and val_is_truthy decode the tag or fall back to 0, empty, or false.

pub fn val_int(n: Int) -> String {
    return "I:" + n.to_string();
}

pub fn val_str(s: String) -> String {
    return "S:" + s;
}

pub fn val_bool(b: Int) -> String {
    if b != 0 {
        return "B:true";
    }
    return "B:false";
}

pub fn val_void() -> String {
    return "V:0";
}

pub fn val_type(v: String) -> String {
    if chars_len(v) < 2 {
        return "V";
    }
    return str_slice(v, 0, 1);
}

pub fn val_to_int(v: String) -> Int {
    let t = "" + val_type(v);
    if t == "I" {
        let payload = str_slice(v, 2, chars_len(v));
        return parse_int(payload);
    }
    if t == "B" {
        if v == "B:true" {
            return 1;
        }
        return 0;
    }
    return 0;
}

pub fn val_to_str(v: String) -> String {
    let t = "" + val_type(v);
    if t == "S" || t == "I" {
        return str_slice(v, 2, chars_len(v));
    }
    if t == "B" {
        if v == "B:true" {
            return "true";
        }
        return "false";
    }
    if t == "V" {
        return "";
    }
    return v;
}

pub fn val_to_bool(v: String) -> Bool {
    let t = "" + val_type(v);
    if t == "B" {
        return v == "B:true";
    }
    if t == "I" {
        return val_to_int(v) != 0;
    }
    if t == "S" {
        return chars_len(val_to_str(v)) > 0;
    }
    return false;
}

pub fn val_is_truthy(v: String) -> Bool {
    return val_to_bool(v);
}
