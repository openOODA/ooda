// # Navigate field chains
//
// Logline: Measure IDENT.field spans, type them from the struct table, and count method paren args.
//
// Setup: Struct definition tables and receiver aliases are available for member resolution.
//
// Beats:
//   1. field_chain_end walks IDENT (DOT IDENT)+ and stops before a method call.
//   2. field_chain_type hops the struct table from the receiver alias.
//   3. Count depth-aware paren args and look up known method arities.

import "tc_infer.oo";

pub fn field_chain_end(toks: List[String], start: Int) -> Int {
    let n = list_len(toks);
    if n > 1000 || start >= n { return 0; }
    if field_at(list_get(toks, start), 0) != "IDENT" { return 0; }
    let mut p = start + 1;
    let mut hops = 0;
    let mut cont = true;
    while cont {
        if p + 1 >= n {
            cont = false;
        } else if field_at(list_get(toks, p), 0) != "DOT" {
            cont = false;
        } else if field_at(list_get(toks, p + 1), 0) != "IDENT" {
            cont = false;
        } else if p + 2 < n && field_at(list_get(toks, p + 2), 0) == "LPAREN" {
            cont = false;
        } else {
            hops = hops + 1;
            p = p + 2;
        }
    }
    if hops < 1 { return 0; }
    return p;
}

pub fn field_access_type_at(toks: List[String], pos: Int, lit_env: String, struct_table: String) -> String {
    let n = list_len(toks);
    if pos + 2 >= n { return ""; }
    if field_at(list_get(toks, pos), 0) != "IDENT" || field_at(list_get(toks, pos + 1), 0) != "DOT" || field_at(list_get(toks, pos + 2), 0) != "IDENT" {
        return "";
    }
    let rname: String = field_at(list_get(toks, pos), 3);
    let fname: String = field_at(list_get(toks, pos + 2), 3);
    let cur_fn: String = get_cur_fn_at(toks, pos);
    let mut rty: String = "";
    if cur_fn != "" {
        rty = resolve_type_alias(lit_env, cur_fn + "." + rname);
        if rty == cur_fn + "." + rname { rty = ""; }
    }
    if rty == "" { rty = resolve_type_alias(lit_env, rname); }
    if rty == rname || rty == "" { return ""; }
    if !is_known_struct_type(struct_table, rty) { return ""; }
    return struct_field_type(struct_table, rty, fname);
}

pub fn field_chain_type(toks: List[String], start: Int, end: Int, lit_env: String, struct_table: String) -> String {
    let n = list_len(toks);
    if end > n || end < start + 3 { return ""; }
    if field_at(list_get(toks, start), 0) != "IDENT" || field_at(list_get(toks, start + 1), 0) != "DOT" { return ""; }
    let rname: String = field_at(list_get(toks, start), 3);
    let cur_fn: String = get_cur_fn_at(toks, start);
    let mut cur: String = "";
    if cur_fn != "" {
        cur = resolve_type_alias(lit_env, cur_fn + "." + rname);
        if cur == cur_fn + "." + rname { cur = ""; }
    }
    if cur == "" { cur = resolve_type_alias(lit_env, rname); }
    if cur == rname || cur == "" { return ""; }
    let mut p = start + 1;
    while p < end {
        if field_at(list_get(toks, p), 0) != "DOT" || p + 1 >= end || field_at(list_get(toks, p + 1), 0) != "IDENT" { return ""; }
        let fname: String = field_at(list_get(toks, p + 1), 3);
        if !is_known_struct_type(struct_table, cur) { return ""; }
        let next: String = struct_field_type(struct_table, cur, fname);
        if next == "" { return ""; }
        cur = next;
        p = p + 2;
    }
    return cur;
}

pub fn is_field_chain_span(toks: List[String], start: Int, end: Int) -> Bool {
    if end < start + 3 || field_at(list_get(toks, start), 0) != "IDENT" { return false; }
    let mut p = start + 1;
    let mut hops = 0;
    while p < end {
        if field_at(list_get(toks, p), 0) != "DOT" || p + 1 >= end || field_at(list_get(toks, p + 1), 0) != "IDENT" { return false; }
        hops = hops + 1;
        p = p + 2;
    }
    if hops < 1 { return false; }
    return p == end;
}

pub fn count_paren_args(toks: List[String], lparen: Int) -> Int {
    let n = list_len(toks);
    if lparen >= n || field_at(list_get(toks, lparen), 0) != "LPAREN" { return 0; }
    let mut p = lparen + 1;
    let mut depth = 1;
    let mut args = 0;
    let mut arg_start = p;
    while p < n {
        let kk: String = field_at(list_get(toks, p), 0);
        if kk == "LPAREN" { depth = depth + 1; }
        if kk == "RPAREN" {
            depth = depth - 1;
            if depth == 0 {
                if p > arg_start { args = args + 1; }
                return args;
            }
        }
        if kk == "COMMA" && depth == 1 {
            if p > arg_start { args = args + 1; }
            arg_start = p + 1;
        }
        p = p + 1;
    }
    return args;
}

pub fn method_expected_args(mname: String) -> Int {
    if mname == "len" || mname == "trim" || mname == "to_lowercase" || mname == "to_string" || mname == "is_ok" || mname == "is_err" || mname == "is_some" || mname == "is_none" || mname == "unwrap" {
        return 0;
    }
    if mname == "contains" || mname == "char_at" || mname == "push" { return 1; }
    if mname == "str_slice" { return 2; }
    return 0 - 1;
}

pub fn is_list_type_name(ty: String) -> Bool {
    if ty == "List" { return true; }
    if chars_len(ty) >= 5 && str_slice(ty, 0, 5) == "List[" { return true; }
    return false;
}

pub fn is_result_type_name(ty: String) -> Bool {
    if ty == "Result" { return true; }
    if chars_len(ty) >= 7 && str_slice(ty, 0, 7) == "Result[" { return true; }
    return false;
}
