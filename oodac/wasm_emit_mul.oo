// # Detect println of two integer literals multiplied
//
// Logline: Returns the decimal product when a function body is only println of INT times INT.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT STAR INT ) with optional semicolon, then RBRACE.
//   3. Return (left * right) decimal text. IDENT operands miss.
//
// residual: runtime IDENT mul stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wmu_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wmu_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wmu_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wmu_kind(toks, p) == "KW_LET" && wmu_kind(toks, p + 1) == "IDENT" && wmu_text(toks, p + 1) == name && wmu_kind(toks, p + 2) == "EQ" && wmu_kind(toks, p + 3) == "INT" { return wmu_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wmu_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wmu_kind(toks, pos) == "INT" { return wmu_text(toks, pos); }
    if wmu_kind(toks, pos) == "IDENT" {
        let name: String = wmu_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wmu_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wmu_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wmu_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wmu_kind(toks, i) == "KW_FN" && wmu_kind(toks, i + 1) == "IDENT" && wmu_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wmu_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wmu_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wmu_kind(toks, p) == "KW_LET" {
        while p < n && wmu_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wmu_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_println_mul(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wmu_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wmu_p(toks, n, f + 2);
    if p0 < 0 || p0 + 5 >= n { return ""; }
    if wmu_kind(toks, p0) != "IDENT" || wmu_text(toks, p0) != "println" { return ""; }
    if wmu_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    let ls: String = wmu_int_val(toks, p0 + 2, n);
    if chars_len(ls) <= 0 { return ""; }
    if wmu_kind(toks, p0 + 3) != "STAR" { return ""; }
    let rs: String = wmu_int_val(toks, p0 + 4, n);
    if chars_len(rs) <= 0 { return ""; }
    if wmu_kind(toks, p0 + 5) != "RPAREN" { return ""; }
    let left: Int = parse_int(ls);
    let right: Int = parse_int(rs);
    let val: Int = left * right;
    let mut p: Int = p0 + 6;
    if p < n && wmu_kind(toks, p) == "SEMI" { p = p + 1; }
    if p < n && wmu_kind(toks, p) == "RBRACE" { return val.to_string(); }
    return "";
}
