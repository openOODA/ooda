// # Lower Ok, match, and struct surface to bytecode
//
// Logline: Emit bytecode for Ok and Err wrappers, Result match, struct literals, and field get, and skip a top-level struct definition.
//
// Setup: token_fmt and bc_emit_env are imported; bc_emit_expr, parse_int, bc_env_add_var, and bc_next_label exist; the packed result is pos, env, label_ctr, code; bc_emit_expr is reached by pure-multi concat with no import to avoid a cycle.
//
// Beats:
//   1. Ok or Err emits the inner expr then CALL __ok or __err 1.
//   2. match emits the scrutinee, Ok and Err arms, JUMP_IF_FALSE, and STORE_LOCAL for the binds.
//   3. TypeName { f: e } pushes values and names then CALL __struct_new; field get is CALL __field_get 2; skip walks struct-def braces.

import "token_fmt.oo";
import "bc_emit_env.oo";

// Ok(e) / Err(e) → emit e + CALL __ok/__err 1
pub fn bc_emit_ok_err(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int, which: String) -> List[String] {
    let mut p = pos + 1;
    let mut e: String = env;
    let mut lc = label_ctr;
    let mut code: String = "";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        let arg: List[String] = bc_emit_expr(toks, p, n, e, lc);
        p = parse_int(list_get(arg, 0));
        e = list_get(arg, 1);
        lc = parse_int(list_get(arg, 2));
        code = list_get(arg, 3);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    }
    let mut call: String = "CALL __ok 1";
    if which == "Err" { call = "CALL __err 1"; }
    code = code + "\n" + call;
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

// match scrut { Ok(v) => expr, Err(e) => expr }
pub fn bc_emit_match_expr(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p = pos + 1;
    let mut e: String = env;
    let mut lc = label_ctr;
    let sc: List[String] = bc_emit_expr(toks, p, n, e, lc);
    p = parse_int(list_get(sc, 0));
    e = list_get(sc, 1);
    lc = parse_int(list_get(sc, 2));
    let sc_code: String = list_get(sc, 3);
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" { p = p + 1; }
    let mut ok_bind: String = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            ok_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" { p = p + 1; }
    let env_ok: List[String] = bc_env_add_var(e, ok_bind);
    let ok_slot: String = list_get(env_ok, 0);
    e = list_get(env_ok, 1);
    let ok_arm: List[String] = bc_emit_expr(toks, p, n, e, lc);
    p = parse_int(list_get(ok_arm, 0));
    e = list_get(ok_arm, 1);
    lc = parse_int(list_get(ok_arm, 2));
    let ok_code: String = list_get(ok_arm, 3);
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; }
    let mut err_bind: String = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            err_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" { p = p + 1; }
    let env_err: List[String] = bc_env_add_var(e, err_bind);
    let err_slot: String = list_get(env_err, 0);
    e = list_get(env_err, 1);
    let err_arm: List[String] = bc_emit_expr(toks, p, n, e, lc);
    p = parse_int(list_get(err_arm, 0));
    e = list_get(err_arm, 1);
    lc = parse_int(list_get(err_arm, 2));
    let err_code: String = list_get(err_arm, 3);
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let l_err_res: List[String] = bc_next_label(lc);
    let l_err: String = list_get(l_err_res, 0);
    lc = parse_int(list_get(l_err_res, 1));
    let l_end_res: List[String] = bc_next_label(lc);
    let l_end: String = list_get(l_end_res, 0);
    lc = parse_int(list_get(l_end_res, 1));
    let code: String = sc_code + "\nCALL __result_ok_keep 1\nJUMP_IF_FALSE " + l_err
        + "\nCALL __result_val 1\nSTORE_LOCAL " + ok_slot + "\n" + ok_code
        + "\nJUMP " + l_end + "\nLABEL " + l_err
        + "\nCALL __result_val 1\nSTORE_LOCAL " + err_slot + "\n" + err_code
        + "\nLABEL " + l_end;
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

// TypeName { f: e, ... }
pub fn bc_emit_struct_lit(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p = pos;
    let mut e: String = env;
    let mut lc = label_ctr;
    let tname: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" { p = p + 1; }
    let mut vals_code: String = "";
    let mut fields: String = "";
    let mut fcount = 0;
    while p < n && field_at(list_get(toks, p), 0) != "RBRACE" {
        if field_at(list_get(toks, p), 0) == "COMMA" {
            p = p + 1;
        } else if field_at(list_get(toks, p), 0) == "IDENT" {
            let fname: String = field_at(list_get(toks, p), 3);
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "COLON" { p = p + 1; }
            let vr: List[String] = bc_emit_expr(toks, p, n, e, lc);
            p = parse_int(list_get(vr, 0));
            e = list_get(vr, 1);
            lc = parse_int(list_get(vr, 2));
            let vc: String = list_get(vr, 3);
            if vals_code == "" { vals_code = vc; } else { vals_code = vals_code + "\n" + vc; }
            if fields == "" { fields = fname; } else { fields = fields + "," + fname; }
            fcount = fcount + 1;
        } else {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let argc = fcount + 2;
    let code: String = vals_code + "\nPUSH_STR " + fields + "\nPUSH_STR " + tname
        + "\nCALL __struct_new " + argc.to_string();
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

pub fn bc_emit_field_get(base_code: String, field: String) -> String {
    return base_code + "\nPUSH_STR " + field + "\nCALL __field_get 2";
}

// Skip top-level `struct Name { ... }`
pub fn bc_skip_struct_def(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos + 1;
    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
        p = p + 1;
    }
    let mut depth = 0;
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 { return p; }
        } else {
            p = p + 1;
        }
    }
    return p;
}
