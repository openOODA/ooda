// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: emit one statement; maintain list-kind env
// stage: emit
// returns [new_pos_str, env]

pub fn c_emit_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut e = env;
    let k = field_at(list_get(toks, p), 0);
    if k == "KW_IF" {
        p = p + 1;
        let pr = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pr, 0));
        println("if (" + list_get(pr, 1) + ") {");
        let br = c_emit_block(toks, p, n, e);
        p = parse_int(list_get(br, 0));
        e = list_get(br, 1);
        println("}");
        return c_pack_pos_env(p, e);
    }
    if k == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            println("else ");
            return c_pack_pos_env(p, e);
        }
        println("else {");
        let br2 = c_emit_block(toks, p, n, e);
        p = parse_int(list_get(br2, 0));
        e = list_get(br2, 1);
        println("}");
        return c_pack_pos_env(p, e);
    }
    if k == "KW_WHILE" {
        p = p + 1;
        let prw = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(prw, 0));
        println("while (" + list_get(prw, 1) + ") {");
        let brw = c_emit_block(toks, p, n, e);
        p = parse_int(list_get(brw, 0));
        e = list_get(brw, 1);
        println("}");
        return c_pack_pos_env(p, e);
    }
    if k == "KW_LET" || k == "KW_MUT" {
        return c_emit_let_stmt(toks, p, n, e);
    }
    if k == "KW_RETURN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            // bare return: main → return 0; else return;
            if c_env_get(e, "__main__") == "1" {
                println("  return 0;");
            } else {
                println("  return;");
            }
            p = p + 1;
            return c_pack_pos_env(p, e);
        }
        let prr = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(prr, 0));
        println("  return " + list_get(prr, 1) + ";");
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    if k == "IDENT" {
        return c_emit_ident_stmt(toks, p, n, e);
    }
    // Bare expression statement (if-expr arm: `9` / `i` without semi)
    if k == "INT" || k == "STRING" || k == "KW_TRUE" || k == "KW_FALSE"
        || k == "LPAREN" || k == "BANG" || k == "MINUS"
    {
        let prx = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(prx, 0));
        let asgn = c_env_get(e, "__asgn__");
        if asgn != "" {
            println("  " + asgn + " = " + list_get(prx, 1) + ";");
        } else {
            println("  " + list_get(prx, 1) + ";");
        }
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    // Range-for: KW_FOR IDENT in INT DOTDOT INT { body }
    // → for (long long i = lo; i < hi; i++) { body }. Else fail-closed residual.
    if k == "KW_FOR" {
        p = p + 1;
        if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
            println("ERR\tc_emit\tfor residual (expected loop IDENT)");
            process_exit(1);
        }
        let v = field_at(list_get(toks, p), 3);
        p = p + 1;
        if p >= n || field_at(list_get(toks, p), 0) != "IDENT"
            || field_at(list_get(toks, p), 3) != "in"
        {
            println("ERR\tc_emit\tfor residual (need 'in'; only INT..INT range-for)");
            process_exit(1);
        }
        p = p + 1;
        if p >= n || field_at(list_get(toks, p), 0) != "INT" {
            println("ERR\tc_emit\tfor residual (only INT..INT range lowered)");
            process_exit(1);
        }
        let lo = field_at(list_get(toks, p), 3);
        p = p + 1;
        if p >= n || field_at(list_get(toks, p), 0) != "DOTDOT" {
            println("ERR\tc_emit\tfor residual (expected .. between bounds)");
            process_exit(1);
        }
        p = p + 1;
        if p >= n || field_at(list_get(toks, p), 0) != "INT" {
            println("ERR\tc_emit\tfor residual (only INT..INT range lowered)");
            process_exit(1);
        }
        let hi = field_at(list_get(toks, p), 3);
        p = p + 1;
        println(
            "for (long long "
                + v
                + " = "
                + lo
                + "; "
                + v
                + " < "
                + hi
                + "; "
                + v
                + "++) {"
        );
        let brf = c_emit_block(toks, p, n, e);
        p = parse_int(list_get(brf, 0));
        e = list_get(brf, 1);
        println("}");
        return c_pack_pos_env(p, e);
    }
    if k == "KW_MATCH" {
        println("ERR\tc_emit\tmatch residual (stmt match not lowered; use if is_ok / is_err)");
        process_exit(1);
    }
    let start = p;
    while p < n {
        let sk = field_at(list_get(toks, p), 0);
        if sk == "SEMI" {
            p = p + 1;
            return c_pack_pos_env(p, e);
        }
        if sk == "RBRACE" {
            // stop before closing brace (do not consume)
            return c_pack_pos_env(p, e);
        }
        if sk == "LBRACE" {
            p = c_emit_skip_braces(toks, p, n);
            return c_pack_pos_env(p, e);
        }
        p = p + 1;
    }
    if p == start {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}

pub fn c_pack_pos_env(p: Int, e: String) -> List[String] {
    let mut o: List[String] = list_new();
    o = list_push(o, p.to_string());
    o = list_push(o, e);
    return o;
}
