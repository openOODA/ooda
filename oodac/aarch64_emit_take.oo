// # Take println and let consts for AArch64 harvest
//
// Logline: Records same-fn lets and lowers println STRING, int, minus, bool, and mix forms.
//
// Setup: a64_tok_k, a64_mix_try, and a64_neg_dec exist in aarch64_emit_harv.oo.
//
// Beats:
//   1. Record string and int lets without mixed leftover plus.
//   2. Take println INT, minus, true/false, or mix.
//   3. Refuse calls and unbound idents.
//
// residual: ALU plus and IDENT if stay leftover.

import "aarch64_emit_harv.oo";

pub fn a64_record_let(toks: List[String], n: Int, i: Int, bnames: List[String], bvals: List[String], inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    if i + 3 >= n {
        return empty;
    }
    if a64_tok_k(toks, i + 1) != "IDENT" || a64_tok_k(toks, i + 2) != "EQ" {
        return empty;
    }
    let nm: String = a64_tok_t(toks, i + 1);
    if a64_tok_k(toks, i + 3) == "STRING" {
        let after = a64_str_after(toks, n, i + 3);
        let mut mixed = false;
        if after < n && a64_tok_k(toks, after) == "PLUS" {
            mixed = true;
        }
        if !mixed {
            let mut out: List[String] = list_new();
            out = list_push(out, "s");
            out = list_push(out, nm);
            out = list_push(out, a64_str_fold(toks, n, i + 3));
            return out;
        }
    } else if a64_tok_k(toks, i + 3) == "INT" {
        let mut plus = false;
        if i + 4 < n && a64_tok_k(toks, i + 4) == "PLUS" {
            plus = true;
        }
        if !plus {
            let mut out: List[String] = list_new();
            out = list_push(out, "i");
            out = list_push(out, nm);
            out = list_push(out, a64_tok_t(toks, i + 3));
            return out;
        }
    } else if a64_tok_k(toks, i + 3) == "MINUS" {
        if i + 4 < n && a64_tok_k(toks, i + 4) == "INT" {
            let mut plus = false;
            if i + 5 < n && a64_tok_k(toks, i + 5) == "PLUS" {
                plus = true;
            }
            if !plus {
                let mut out: List[String] = list_new();
                out = list_push(out, "i");
                out = list_push(out, nm);
                out = list_push(out, "-" + a64_tok_t(toks, i + 4));
                return out;
            }
        }
    }
    return empty;
}

pub fn a64_take_println(toks: List[String], n: Int, i: Int, bnames: List[String], bvals: List[String], inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    if i > 0 && a64_tok_k(toks, i - 1) == "DOT" {
        return empty;
    }
    let mut j = i + 1;
    if j < n && a64_tok_k(toks, j) == "LPAREN" {
        j = j + 1;
    }
    if j < n && a64_tok_k(toks, j) == "INT" {
        if j + 1 < n && a64_tok_k(toks, j + 1) == "RPAREN" {
            let mut one: List[String] = list_new();
            one = list_push(one, a64_tok_t(toks, j));
            return one;
        }
        return empty;
    }
    if j < n && a64_tok_k(toks, j) == "KW_TRUE" {
        if j + 1 < n && a64_tok_k(toks, j + 1) == "RPAREN" {
            let mut one: List[String] = list_new();
            one = list_push(one, "true");
            return one;
        }
        return empty;
    }
    if j < n && a64_tok_k(toks, j) == "KW_FALSE" {
        if j + 1 < n && a64_tok_k(toks, j + 1) == "RPAREN" {
            let mut one: List[String] = list_new();
            one = list_push(one, "false");
            return one;
        }
        return empty;
    }
    if j < n && a64_tok_k(toks, j) == "MINUS" {
        if j + 1 < n && a64_tok_k(toks, j + 1) == "INT" {
            if j + 2 < n && a64_tok_k(toks, j + 2) == "RPAREN" {
                let mut one: List[String] = list_new();
                one = list_push(one, "-" + a64_tok_t(toks, j + 1));
                return one;
            }
            return empty;
        }
        if j + 1 < n && a64_tok_k(toks, j + 1) == "IDENT" {
            if j + 2 < n && a64_tok_k(toks, j + 2) == "LPAREN" {
                return empty;
            }
            if j + 2 < n && a64_tok_k(toks, j + 2) == "RPAREN" {
                let idx = a64_bind_idx(inames, a64_tok_t(toks, j + 1));
                if idx >= 0 {
                    let mut one: List[String] = list_new();
                    one = list_push(one, a64_neg_dec(list_get(ivals, idx)));
                    return one;
                }
            }
        }
        return empty;
    }
    if j < n && (a64_tok_k(toks, j) == "STRING" || a64_tok_k(toks, j) == "IDENT") {
        let got: List[String] = a64_mix_try(toks, n, j, bnames, bvals, inames, ivals);
        if list_len(got) >= 1 {
            return got;
        }
        if a64_tok_k(toks, j) == "IDENT" {
            if j + 1 < n && a64_tok_k(toks, j + 1) == "RPAREN" {
                let idx = a64_bind_idx(inames, a64_tok_t(toks, j));
                if idx >= 0 {
                    let mut one: List[String] = list_new();
                    one = list_push(one, list_get(ivals, idx));
                    return one;
                }
            }
        }
        return empty;
    }
    return empty;
}
