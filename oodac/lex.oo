// job: character-level lex validate; in: String; out: Ok("")|Err; stage: lex
pub fn lex_all(src: String) -> Result[String, String] {
    let n = chars_len(src);
    if n > 1048576 {
        return Err("source exceeds 1MiB limit");
    }
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    while i < n {
        let mut c2 = "";
        let mut j = 0;
        let mut nch = "";
        let ch = char_at(src, i);
        if ch == " " {
            i = i + 1;
            col = col + 1;
        } else if ch == "\t" {
            i = i + 1;
            col = col + 1;
        } else if ch == "\n" {
            i = i + 1;
            line = line + 1;
            col = 1;
        } else if ch == "/" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "/" {
                    i = i + 2;
                    col = col + 2;
                    let mut cont_c = true;
                    while cont_c {
                        if i >= n {
                            cont_c = false;
                        } else {
                            c2 = char_at(src, i);
                            if c2 == "\n" {
                                cont_c = false;
                            } else {
                                i = i + 1;
                                col = col + 1;
                            }
                        }
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "\"" {
            i = i + 1;
            col = col + 1;
            let mut cont_s = true;
            while cont_s {
                if i >= n {
                    return Err("Unterminated string");
                }
                c2 = char_at(src, i);
                if c2 == "\"" {
                    i = i + 1;
                    col = col + 1;
                    cont_s = false;
                } else if c2 == "\\" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
        } else if char_is_digit(ch) {
            i = i + 1;
            col = col + 1;
            let mut cont_d = true;
            while cont_d {
                if i >= n {
                    cont_d = false;
                } else {
                    c2 = char_at(src, i);
                    if char_is_digit(c2) {
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_d = false;
                    }
                }
            }
        } else if char_is_alpha(ch) || ch == "_" {
            i = i + 1;
            col = col + 1;
            let mut cont_id = true;
            while cont_id {
                if i >= n {
                    cont_id = false;
                } else {
                    c2 = char_at(src, i);
                    if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_id = false;
                    }
                }
            }
        } else if ch == "+" || ch == "*" || ch == "%" || ch == ":" || ch == ";" || ch == "," || ch == "?" || ch == "(" || ch == ")" || ch == "{" || ch == "}" || ch == "[" || ch == "]" {
            i = i + 1;
            col = col + 1;
        } else if ch == "-" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "=" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "!" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "<" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                // << before single LT; keep <=
                if nch == "<" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ">" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                // >> before single GT; keep >=
                if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "^" {
            // M167/M178 #56: single caret bitwise XOR (parity with token_scan_punct CARET)
            i = i + 1;
            col = col + 1;
        } else if ch == "&" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "&" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "|" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "|" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "." {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "." {
                    let k = j + 1;
                    if k < n {
                        let n2 = char_at(src, k);
                        if n2 == "=" {
                            i = i + 3;
                            col = col + 3;
                        } else {
                            i = i + 2;
                            col = col + 2;
                        }
                    } else {
                        i = i + 2;
                        col = col + 2;
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else {
            // FAIL CLOSED — never soft-skip unknown characters
            let ls: String = line.to_string();
            let cs: String = col.to_string();
            return Err("Unexpected character '" + ch + "' at " + ls + ":" + cs);
        }
    }
    return Ok("");
}
