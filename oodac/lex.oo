// # Validate source characters
//
// Logline: Walk source one character at a time and return Ok empty or Err on an unexpected character or BOM.
//
// Setup: Raw source string is loaded into memory for character validation.
//
// Beats:
//   1. Reject sources over 1MiB and a BOM that is not at the start.
//   2. Skip space, tab, newline, and // comments; scan strings, numbers, and idents.
//   3. Accept known punctuation pairs; return Err on any other character.

import "lex_scan.oo";

pub fn lex_all(src: String) -> Result[String, String] {
    let n = chars_len(src);
    if n > 1048576 {
        return Err("source exceeds 1MiB limit");
    }
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    while i < n {
        let mut c2 = "";
        let mut j = 0;
        let mut nch = "";
        let ch = char_at(src, i);
        // RFC 3629 UTF-8 compliance: Ignore Byte Order Mark (BOM) U+FEFF only at start
        if ch == "﻿" {
            if i == 0 {
                i = i + 1;
                col = col + 1;
            } else {
                let ls: String = line.to_string();
                let cs: String = col.to_string();
                return Err("Unexpected character BOM at " + ls + ":" + cs);
            }
        } else if ch == " " {
            i = i + 1;
            col = col + 1;
        } else if ch == "\t" {
            i = i + 1;
            col = col + 1;
        } else if ch == "\n" {
            i = i + 1;
            line = line + 1;
            col = 1;
        } else if ch == "/" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "/" {
                    i = i + 2;
                    col = col + 2;
                    let mut cont_c = true;
                    while cont_c {
                        if i >= n {
                            cont_c = false;
                        } else {
                            c2 = char_at(src, i);
                            if c2 == "\n" {
                                cont_c = false;
                            } else {
                                i = i + 1;
                                col = col + 1;
                            }
                        }
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "\"" {
            let sr: List[Int] = lex_scan_string(src, i, n, col);
            if list_len(sr) < 2 {
                return Err("Unterminated string");
            }
            i = list_get(sr, 0) + 0;
            col = list_get(sr, 1) + 0;
        } else if char_is_digit(ch) {
            let nr: List[Int] = lex_scan_number(src, i, n, col);
            i = list_get(nr, 0) + 0;
            col = list_get(nr, 1) + 0;
        } else if char_is_alpha(ch) || ch == "_" {
            let ir: List[Int] = lex_scan_ident(src, i, n, col);
            i = list_get(ir, 0) + 0;
            col = list_get(ir, 1) + 0;
        } else if ch == "+" || ch == "*" || ch == "%" || ch == ":" || ch == ";" || ch == "," || ch == "?" || ch == "(" || ch == ")" || ch == "{" || ch == "}" || ch == "[" || ch == "]" {
            i = i + 1;
            col = col + 1;
        } else if ch == "-" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "=" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "!" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "<" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                // << before single LT; keep <=
                if nch == "<" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ">" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                // >> before single GT; keep >=
                if nch == ">" {
                    i = i + 2;
                    col = col + 2;
                } else if nch == "=" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "^" {
            // M167/M178 #56: single caret bitwise XOR (parity with token_scan_punct CARET)
            i = i + 1;
            col = col + 1;
        } else if ch == "&" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "&" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "|" {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "|" {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "." {
            j = i + 1;
            if j < n {
                nch = char_at(src, j);
                if nch == "." {
                    let k = j + 1;
                    if k < n {
                        let n2 = char_at(src, k);
                        if n2 == "=" {
                            i = i + 3;
                            col = col + 3;
                        } else {
                            i = i + 2;
                            col = col + 2;
                        }
                    } else {
                        i = i + 2;
                        col = col + 2;
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                i = i + 1;
                col = col + 1;
            }
        } else {
            // FAIL CLOSED — never soft-skip unknown characters
            let ls: String = line.to_string();
            let cs: String = col.to_string();
            return Err("Unexpected character '" + ch + "' at " + ls + ":" + cs);
        }
    }
    return Ok("");
}
