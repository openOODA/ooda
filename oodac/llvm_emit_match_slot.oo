// # Statement-match payload slot helpers
//
// Logline: Names unique bind slots and maps Result compounds to Ok/Err payload LLVM types.
//
// Setup: Called from llvm_emit_match.oo. Does not import llvm_emit_expr.oo.
//
// Beats:
//   1. Map %OoResI/B/F Ok payloads to i64/i32/double.
//   2. Err of those compounds is field 2 %OoStr.
//   3. Zero-init a payload slot by LLVM type.

pub fn llvm_match_is_res(rty: String) -> Bool {
    if rty == "%OoResS" || rty == "%OoResV" || rty == "%OoResI" || rty == "%OoResB" || rty == "%OoResF" || rty == "%OoResLI" || rty == "%OoResLS" || rty == "%OoResLF" {
        return true;
    }
    if chars_len(rty) >= 7 {
        if str_slice(rty, 0, 7) == "%OoRes." { return true; }
    }
    return false;
}

pub fn llvm_match_pay_ty(rty: String, is_ok: Bool) -> String {
    if !is_ok {
        return "%OoStr";
    }
    if rty == "%OoResI" { return "i64"; }
    if rty == "%OoResB" { return "i32"; }
    if rty == "%OoResF" { return "double"; }
    if rty == "%OoResLI" { return "%OoIList"; }
    if rty == "%OoResLS" { return "%OoSList"; }
    if rty == "%OoResLF" { return "%OoFList"; }
    if chars_len(rty) >= 7 && str_slice(rty, 0, 7) == "%OoRes." {
        return "%struct." + str_slice(rty, 7, chars_len(rty));
    }
    return "%OoStr";
}

pub fn llvm_match_pay_idx(rty: String, is_ok: Bool) -> String {
    if !is_ok && (rty == "%OoResI" || rty == "%OoResB" || rty == "%OoResF" || rty == "%OoResLI" || rty == "%OoResLS" || rty == "%OoResLF" || (chars_len(rty) >= 7 && str_slice(rty, 0, 7) == "%OoRes.")) {
        return "2";
    }
    return "1";
}

pub fn llvm_match_zero_slot(pty: String, slot: String) {
    if pty == "i64" {
        println("  store i64 0, i64* %" + slot + ".slot, align 8");
    } else if pty == "i32" {
        println("  store i32 0, i32* %" + slot + ".slot, align 8");
    } else if pty == "double" {
        println("  store double 0.0, double* %" + slot + ".slot, align 8");
    } else if pty == "%OoIList" || pty == "%OoSList" || pty == "%OoFList" || (chars_len(pty) >= 8 && str_slice(pty, 0, 8) == "%struct.") {
        println("  store " + pty + " zeroinitializer, " + pty + "* %" + slot + ".slot, align 8");
    } else {
        println("  store %OoStr zeroinitializer, %OoStr* %" + slot + ".slot, align 8");
    }
}

pub fn llvm_seed_sum_ctors(env: List[String], toks: List[String], n: Int) -> List[String] {
    let mut e: List[String] = env;
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let mut p: Int = i;
        if k == "KW_PUB" && i + 1 < n {
            if field_at(list_get(toks, i + 1), 0) == "KW_TYPE" {
                p = i + 1;
            }
        }
        if field_at(list_get(toks, p), 0) == "KW_TYPE" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let ty: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "EQ" {
                    p = p + 1;
                }
                let mut has_pipe = false;
                let mut scan_p = p;
                while scan_p < n {
                    let sk: String = field_at(list_get(toks, scan_p), 0);
                    if sk == "SEMI" || sk == "LBRACE" || sk == "KW_FN" || sk == "KW_TYPE" {
                        break;
                    }
                    if sk == "PIPE" {
                        has_pipe = true;
                        break;
                    }
                    scan_p = scan_p + 1;
                }
                if has_pipe {
                    let mut tag: Int = 0;
                    while p < n {
                        let sk: String = field_at(list_get(toks, p), 0);
                        if sk == "SEMI" {
                            p = p + 1;
                            break;
                        }
                        if sk == "IDENT" {
                            let ctor: String = field_at(list_get(toks, p), 3);
                            p = p + 1;
                            let mut kind: String = "U";
                            if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                                p = p + 1;
                                if p < n && (field_at(list_get(toks, p), 0) == "IDENT" || field_at(list_get(toks, p), 0) == "KW_TYPE") {
                                    kind = field_at(list_get(toks, p), 3);
                                    p = p + 1;
                                }
                                let mut d: Int = 1;
                                while p < n && d > 0 {
                                    let ik: String = field_at(list_get(toks, p), 0);
                                    if ik == "LPAREN" { d = d + 1; }
                                    if ik == "RPAREN" { d = d - 1; }
                                    p = p + 1;
                                }
                            }
                            e = llvm_env_add_var(e, "__ctor__" + ctor, ty + ":" + tag.to_string() + ":" + kind);
                            tag = tag + 1;
                        } else {
                            p = p + 1;
                        }
                    }
                    i = p;
                } else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return e;
}
