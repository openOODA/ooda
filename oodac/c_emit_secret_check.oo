// # Check secret println and OS sinks
//
// Logline: Parse secret env and scan tokens for secret leaks to sealed sinks.
//
// Setup: c_parse_secret_env, c_secret_mark_returning_fns, c_secret_note_bare_alias, c_secret_prop_from_rhs, c_secret_note_lhs_assign, c_secret_resolve_alias, c_secret_refuse_sink_resolved, c_secret_scan_call, c_secret_is_sink_name, and c_secret_is_user_sink are in scope.
//
// Beats:
//   1. Parse secret directives and mark returning fns.
//   2. Walk let statements and assignments to update alias and taint propagation.
//   3. Refuse any secret identifiers reaching println or sealed OS sinks.

import "c_emit_secret.oo";
import "c_emit_secret_alias.oo";
import "c_emit_secret_prop.oo";
import "c_emit_ident.oo";

pub fn check_secret_println_sinks(src: String, toks: List[String]) {
    let mut env: String = c_parse_secret_env(src);
    // CRIT T1: mark secret-returning fns so call-site prop sees __fr_secret__.
    env = c_secret_mark_returning_fns(src, toks, env);
    if env == "" {
        return;
    }
    let n = list_len(toks);
    let mut i = 0;
    let mut cur_fn = "";
    let mut bd = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "IDENT" {
                cur_fn = field_at(list_get(toks, i + 1), 3);
            }
        } else if k == "LBRACE" {
            bd = bd + 1;
        } else if k == "RBRACE" {
            bd = bd - 1;
            if bd <= 0 {
                cur_fn = "";
                bd = 0;
            }
        }
        if k == "KW_LET" {
            let mut p = i + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let dest: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                let mut hunting = true;
                while hunting && p < n {
                    let kk: String = field_at(list_get(toks, p), 0);
                    if kk == "EQ" {
                        env = c_secret_note_bare_alias(toks, p + 1, n, env, dest);
                        env = c_secret_prop_from_rhs(toks, p + 1, n, env, dest);
                        hunting = false;
                    } else if kk == "SEMI" || kk == "LBRACE" || kk == "KW_LET" {
                        hunting = false;
                    } else {
                        p = p + 1;
                    }
                }
            }
        }
        if k == "IDENT" {
            let id: String = field_at(list_get(toks, i), 3);
            env = c_secret_note_lhs_assign(toks, i, n, env);
            let sid: String = c_secret_resolve_alias(env, id);
            if sid == "println" || sid == "eprintln" {
                if cur_fn != "" {
                    env = c_env_put(env, "__sec_sink__" + cur_fn, "1");
                }
                let mut p = i + 1;
                if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                    p = p + 1;
                }
                let mut in_args = true;
                let mut depth = 1;
                while in_args && p < n {
                    let tk: String = field_at(list_get(toks, p), 0);
                    if tk == "LPAREN" {
                        depth = depth + 1;
                        p = p + 1;
                    } else if tk == "RPAREN" {
                        depth = depth - 1;
                        if depth <= 0 {
                            in_args = false;
                        }
                        p = p + 1;
                    } else if tk == "IDENT" {
                        let mut full_path: String = field_at(list_get(toks, p), 3);
                        let mut q: Int = p + 1;
                        while q + 1 < n && field_at(list_get(toks, q), 0) == "DOT"
                            && field_at(list_get(toks, q + 1), 0) == "IDENT" {
                            full_path = full_path + "." + field_at(list_get(toks, q + 1), 3);
                            q = q + 2;
                        }
                        c_secret_refuse_sink_resolved(env, sid, full_path);
                        p = q;
                    } else {
                        p = p + 1;
                    }
                }
            }
            if sid == "write_file" || sid == "realloc" {
                c_secret_scan_call(env, toks, i + 1, n, 1, true, sid);
                c_secret_scan_call(env, toks, i + 1, n, 2, true, sid);
            } else if sid == "fetch" || sid == "env_get" || sid == "read_file" || sid == "path_exists" || sid == "file_size" || sid == "free_bytes" || sid == "alloc_bytes" || sid == "free" || sid == "malloc" || sid == "seed" || sid == "sleep_ms" {
                c_secret_scan_call(env, toks, i + 1, n, 1, true, sid);
            } else if sid == "process_exit" {
                c_secret_scan_call(env, toks, i + 1, n, 0, true, sid);
            } else if c_secret_is_sink_name(sid) {
                c_secret_scan_call(env, toks, i + 1, n, 1, false, sid);
            } else if c_secret_is_user_sink(env, sid) || c_secret_is_user_sink(env, id) {
                c_secret_scan_call(env, toks, i + 1, n, 0, false, sid);
            }
        }
        i = i + 1;
    }
}
