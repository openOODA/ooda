// # While Loop Interpretation Test 3
//
// Logline: Verifies while loop evaluation case 3.
//
// Setup: Direct while loop test.
//
// Beats:
//   1. Execute while loop iteration.

import "wasm_emit_interp_for.oo";
pub fn main() {
    let src: String = "// # Count in a while\npub fn main() { let mut i = 0; while i < 3 { i = i + 1; } let flag = !(i == 0); if flag == true {} let y = if i > 5 { 9 } else if i > 2 { i } else { 0 }; println(y); }";
    let out: String = wi_interp_for_main(src);
    println("out:" + out + ":end");
    println(out);
}
