// job: AST Expression-to-bytecode lowering for Interpreter Bytecode Emitter
import "token_fmt.oo";
import "bc_emit_env.oo";
import "bc_emit_surface.oo";
pub fn bc_emit_expr(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    return bc_emit_expr_bp(toks, pos, n, env, label_ctr, 0);
}
pub fn bc_emit_expr_bp(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int, min_bp: Int) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut lc: Int = label_ctr;
    let mut code: String = "";
    if p >= n {
        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, e);
        out = list_push(out, lc.to_string());
        out = list_push(out, "");
        return out;
    }

    let k0: String = field_at(list_get(toks, p), 0);
    if k0 == "BANG" || k0 == "MINUS" {
        p = p + 1;
        let sub: List[String] = bc_emit_expr_bp(toks, p, n, e, lc, 100);
        p = parse_int(list_get(sub, 0));
        e = list_get(sub, 1);
        lc = parse_int(list_get(sub, 2));
        let sub_code: String = list_get(sub, 3);
        let mut un_op: String = "NEG";
        if k0 == "BANG" { un_op = "NOT"; }
        code = sub_code + "\n" + un_op;
    } else {
        let prim: List[String] = bc_emit_primary(toks, p, n, e, lc);
        p = parse_int(list_get(prim, 0));
        e = list_get(prim, 1);
        lc = parse_int(list_get(prim, 2));
        code = list_get(prim, 3);
    }

    let mut cont: Bool = true;
    while cont {
        if p >= n {
            cont = false;
        } else {
            let k: String = field_at(list_get(toks, p), 0);
            let bp: Int = bin_bp(k);
            if bp == 0 || bp < min_bp {
                cont = false;
            } else {
                p = p + 1;
                let right: List[String] = bc_emit_expr_bp(toks, p, n, e, lc, bp + 1);
                p = parse_int(list_get(right, 0));
                e = list_get(right, 1);
                lc = parse_int(list_get(right, 2));
                let right_code: String = list_get(right, 3);
                let bin_inst: String = bc_bin_opcode(k);
                code = code + "\n" + right_code + "\n" + bin_inst;
            }
        }
    }

    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

pub fn bc_emit_primary(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut lc: Int = label_ctr;
    let mut code: String = "";

    let tok: String = list_get(toks, p);
    let k: String = field_at(tok, 0);
    let text: String = field_at(tok, 3);

    if k == "INT" {
        code = "PUSH_INT " + text;
        p = p + 1;
    } else if k == "STRING" {
        code = "PUSH_STR " + text;
        p = p + 1;
    } else if k == "KW_TRUE" {
        code = "PUSH_BOOL 1";
        p = p + 1;
    } else if k == "KW_FALSE" {
        code = "PUSH_BOOL 0";
        p = p + 1;
    } else if k == "LPAREN" {
        p = p + 1;
        let inner: List[String] = bc_emit_expr(toks, p, n, e, lc);
        p = parse_int(list_get(inner, 0));
        e = list_get(inner, 1);
        lc = parse_int(list_get(inner, 2));
        code = list_get(inner, 3);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    } else if k == "KW_MATCH" {
        let m: List[String] = bc_emit_match_expr(toks, p, n, e, lc);
        p = parse_int(list_get(m, 0));
        e = list_get(m, 1);
        lc = parse_int(list_get(m, 2));
        code = list_get(m, 3);
    } else if k == "IDENT" {
        let name: String = text;
        p = p + 1;
        if (name == "Ok" || name == "Err") && p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
            let oe: List[String] = bc_emit_ok_err(toks, p - 1, n, e, lc, name);
            p = parse_int(list_get(oe, 0));
            e = list_get(oe, 1);
            lc = parse_int(list_get(oe, 2));
            code = list_get(oe, 3);
        } else if p < n && field_at(list_get(toks, p), 0) == "LBRACE"
            && p + 2 < n && field_at(list_get(toks, p + 1), 0) == "IDENT"
            && field_at(list_get(toks, p + 2), 0) == "COLON"
        {
            // Struct lit TypeName { field: val } — not `if x {` (x then block)
            let sl: List[String] = bc_emit_struct_lit(toks, p - 1, n, e, lc);
            p = parse_int(list_get(sl, 0));
            e = list_get(sl, 1);
            lc = parse_int(list_get(sl, 2));
            code = list_get(sl, 3);
        } else if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
            p = p + 1; // consume LPAREN
            let mut argc: Int = 0;
            let mut args_code: String = "";
            while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
                if field_at(list_get(toks, p), 0) == "COMMA" {
                    p = p + 1;
                } else {
                    let arg_res: List[String] = bc_emit_expr(toks, p, n, e, lc);
                    p = parse_int(list_get(arg_res, 0));
                    e = list_get(arg_res, 1);
                    lc = parse_int(list_get(arg_res, 2));
                    let ac: String = list_get(arg_res, 3);
                    if args_code == "" { args_code = ac; } else { args_code = args_code + "\n" + ac; }
                    argc = argc + 1;
                }
            }
            if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
                p = p + 1;
            }
            let argc_str: String = argc.to_string();
            let call_inst: String = "CALL " + name + " " + argc_str;
            if args_code == "" { code = call_inst; } else { code = args_code + "\n" + call_inst; }
        } else {
            let slot: Int = bc_env_lookup(e, name);
            if slot >= 0 {
                let slot_str: String = slot.to_string();
                code = "LOAD_LOCAL " + slot_str;
            } else {
                code = "PUSH_INT 0";
            }
        }
        while p < n && field_at(list_get(toks, p), 0) == "DOT" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let fname: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                code = bc_emit_field_get(code, fname);
            }
        }
    } else if k == "KW_IF" {
        let if_res: List[String] = bc_emit_if_expr(toks, p, n, e, lc);
        p = parse_int(list_get(if_res, 0));
        e = list_get(if_res, 1);
        lc = parse_int(list_get(if_res, 2));
        code = list_get(if_res, 3);
    } else {
        code = "PUSH_INT 0";
        p = p + 1;
    }

    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

pub fn bc_emit_expr_block(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut lc: Int = label_ctr;
    let mut code: String = "PUSH_INT 0";
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) != "RBRACE" {
        let er: List[String] = bc_emit_expr(toks, p, n, e, lc);
        p = parse_int(list_get(er, 0));
        e = list_get(er, 1);
        lc = parse_int(list_get(er, 2));
        code = list_get(er, 3);
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
        while p < n && field_at(list_get(toks, p), 0) != "RBRACE" { p = p + 1; }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

pub fn bc_emit_if_expr(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut lc: Int = label_ctr;
    if p < n && field_at(list_get(toks, p), 0) == "KW_IF" { p = p + 1; }
    let cond_res: List[String] = bc_emit_expr(toks, p, n, e, lc);
    p = parse_int(list_get(cond_res, 0));
    e = list_get(cond_res, 1);
    lc = parse_int(list_get(cond_res, 2));
    let cond_code: String = list_get(cond_res, 3);
    let l_else_res: List[String] = bc_next_label(lc);
    let l_else: String = list_get(l_else_res, 0);
    lc = parse_int(list_get(l_else_res, 1));
    let l_end_res: List[String] = bc_next_label(lc);
    let l_end: String = list_get(l_end_res, 0);
    lc = parse_int(list_get(l_end_res, 1));
    let then_res: List[String] = bc_emit_expr_block(toks, p, n, e, lc);
    p = parse_int(list_get(then_res, 0));
    e = list_get(then_res, 1);
    lc = parse_int(list_get(then_res, 2));
    let then_code: String = list_get(then_res, 3);
    let mut else_code: String = "PUSH_INT 0";
    if p < n && field_at(list_get(toks, p), 0) == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            let elif_res: List[String] = bc_emit_if_expr(toks, p, n, e, lc);
            p = parse_int(list_get(elif_res, 0));
            e = list_get(elif_res, 1);
            lc = parse_int(list_get(elif_res, 2));
            else_code = list_get(elif_res, 3);
        } else {
            let eblk: List[String] = bc_emit_expr_block(toks, p, n, e, lc);
            p = parse_int(list_get(eblk, 0));
            e = list_get(eblk, 1);
            lc = parse_int(list_get(eblk, 2));
            else_code = list_get(eblk, 3);
        }
    }
    let code: String = cond_code + "\nJUMP_IF_FALSE " + l_else + "\n" + then_code + "\nJUMP " + l_end + "\nLABEL " + l_else + "\n" + else_code + "\nLABEL " + l_end;
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}
