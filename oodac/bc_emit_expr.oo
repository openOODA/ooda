// # Lower an expression to bytecode
//
// Logline: Pratt-parses a token expression into bytecode and returns the next pos, env, label counter, and code.
//
// Setup: token_fmt, bc_emit_env, bc_emit_surface, bc_emit_expr_2, and bc_emit_expr_if are imported; bc_emit_primary, bin_bp, and bc_bin_opcode exist; the packed result is pos, env, label_ctr, code.
//
// Beats:
//   1. bc_emit_expr calls bc_emit_expr_bp at min_bp 0; past n packs the cursor and empty code.
//   2. A BANG or MINUS recurses at binding power 100 and emits NOT or NEG; otherwise emit the primary.
//   3. While the next token has binding power at or above min_bp, emit the right side then the bin opcode.

import "token_fmt.oo";
import "bc_emit_env.oo";
import "bc_emit_surface.oo";
import "bc_emit_expr_2.oo";
import "bc_emit_expr_if.oo";

pub fn bc_emit_expr(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    return bc_emit_expr_bp(toks, pos, n, env, label_ctr, 0);
}

pub fn bc_emit_expr_bp(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int, min_bp: Int) -> List[String] {
    let mut p = pos;
    let mut e: String = env;
    let mut lc = label_ctr;
    let mut code: String = "";
    if p >= n {
        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, e);
        out = list_push(out, lc.to_string());
        out = list_push(out, "");
        return out;
    }

    let k0: String = field_at(list_get(toks, p), 0);
    if k0 == "BANG" || k0 == "MINUS" {
        p = p + 1;
        let sub: List[String] = bc_emit_expr_bp(toks, p, n, e, lc, 100);
        p = parse_int(list_get(sub, 0));
        e = list_get(sub, 1);
        lc = parse_int(list_get(sub, 2));
        let sub_code: String = list_get(sub, 3);
        let mut un_op: String = "NEG";
        if k0 == "BANG" { un_op = "NOT"; }
        code = sub_code + "\n" + un_op;
    } else {
        let prim: List[String] = bc_emit_primary(toks, p, n, e, lc);
        p = parse_int(list_get(prim, 0));
        e = list_get(prim, 1);
        lc = parse_int(list_get(prim, 2));
        code = list_get(prim, 3);
    }

    let mut cont = true;
    while cont {
        if p >= n {
            cont = false;
        } else {
            let k: String = field_at(list_get(toks, p), 0);
            let bp = 0 + bin_bp(k);
            if bp == 0 || bp < min_bp {
                cont = false;
            } else {
                p = p + 1;
                let right: List[String] = bc_emit_expr_bp(toks, p, n, e, lc, bp + 1);
                p = parse_int(list_get(right, 0));
                e = list_get(right, 1);
                lc = parse_int(list_get(right, 2));
                let right_code: String = list_get(right, 3);
                let bin_inst: String = bc_bin_opcode(k);
                code = code + "\n" + right_code + "\n" + bin_inst;
            }
        }
    }

    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}
