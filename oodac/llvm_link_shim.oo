// # LLVM link shims for CHS runtime names
//
// Logline: Text of _shim.ll: process_exit, path_exists, file_size, read_file, write_file, sys_exec.
//
// Setup: emit-mods writes this next to per-module IR. 24-byte C returns use sret.
//
// Beats:
//   1. process_exit truncates to libc exit.
//   2. Aggregates call oo_* via sret; sys_exec, read_file, path_exists, and file_size pass the caller cap.

pub fn llvm_link_shim_text() -> String {
    let mut s: String = "; oodac llvm runtime shims\n";
    s = s + "target triple = \"x86_64-unknown-linux-gnu\"\n";
    s = s + "%OoStr = type { i8*, i64 }\n%OoResS = type { i32, %OoStr }\n%OoResV = type { i32, %OoStr }\n";
    s = s + "declare void @exit(i32)\n";
    s = s + "declare i32 @oo_path_exists(i64, %OoStr)\n";
    s = s + "declare i64 @oo_file_size(i64, %OoStr)\n";
    s = s + "declare void @oo_read_file(%OoResS* sret(%OoResS), i64, %OoStr)\n";
    s = s + "declare void @oo_write_file(%OoResV* sret(%OoResV), i64, %OoStr, %OoStr)\n";
    s = s + "declare void @oo_sys_exec(%OoResS* sret(%OoResS), i64, i32, %OoStr*)\n";
    s = s + "define void @process_exit(i64 %c) {\n  %t = trunc i64 %c to i32\n  call void @exit(i32 %t)\n  unreachable\n}\n";
    s = s + "define i32 @path_exists(i64 %cap, %OoStr %p) {\n  %r = call i32 @oo_path_exists(i64 %cap, %OoStr %p)\n  ret i32 %r\n}\n";
    s = s + "define i64 @file_size(i64 %cap, %OoStr %p) {\n  %r = call i64 @oo_file_size(i64 %cap, %OoStr %p)\n  ret i64 %r\n}\n";
    s = s + "define %OoResS @read_file(i64 %cap, %OoStr %p) {\n  %slot = alloca %OoResS, align 8\n";
    s = s + "  call void @oo_read_file(%OoResS* sret(%OoResS) %slot, i64 %cap, %OoStr %p)\n";
    s = s + "  %r = load %OoResS, %OoResS* %slot, align 8\n  ret %OoResS %r\n}\n";
    s = s + "define %OoResS @write_file(i64 %cap, %OoStr %p, %OoStr %s) {\n  %vslot = alloca %OoResV, align 8\n";
    s = s + "  call void @oo_write_file(%OoResV* sret(%OoResV) %vslot, i64 %cap, %OoStr %p, %OoStr %s)\n";
    s = s + "  %v = load %OoResV, %OoResV* %vslot, align 8\n  %ok = extractvalue %OoResV %v, 0\n";
    s = s + "  %val = extractvalue %OoResV %v, 1\n  %t0 = insertvalue %OoResS undef, i32 %ok, 0\n";
    s = s + "  %t1 = insertvalue %OoResS %t0, %OoStr %val, 1\n  ret %OoResS %t1\n}\n";
    s = s + "define %OoResS @sys_exec(i64 %cap, %OoStr %a, %OoStr %b, %OoStr %c) {\n";
    s = s + "  %arr = alloca [3 x %OoStr], align 8\n";
    s = s + "  %p0 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 0\n";
    s = s + "  %p1 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 1\n";
    s = s + "  %p2 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 2\n";
    s = s + "  store %OoStr %a, %OoStr* %p0, align 8\n  store %OoStr %b, %OoStr* %p1, align 8\n";
    s = s + "  store %OoStr %c, %OoStr* %p2, align 8\n  %slot = alloca %OoResS, align 8\n";
    s = s + "  call void @oo_sys_exec(%OoResS* sret(%OoResS) %slot, i64 %cap, i32 3, %OoStr* %p0)\n";
    s = s + "  %r = load %OoResS, %OoResS* %slot, align 8\n  ret %OoResS %r\n}\n";
    return s;
}
