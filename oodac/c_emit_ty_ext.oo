// # Extend C type helpers past c_emit_ty
//
// Logline: Lowers a call result type, extracts a leading C callee name, types list_get from env, and infers list kind S or I.
//
// Setup: c_call_result_ty and c_env_get exist; split from c_emit_ty because emit drops fns after huge c_call_result_ty.
//
// Beats:
//   1. c_lower_result_ty uses c_call_result_ty or falls back to long long.
//   2. c_rhs_call_name walks to '('; c_list_get_result_ty types oo_flist_get, oo_l_Name_get, LF, and struct lists.
//   3. c_infer_list_kind uses __ann__, payload glyphs, or the first arg's env kind, default I.

pub fn c_lower_result_ty(name: String) -> String {
    let t: String = c_call_result_ty(name);
    if t != "" {
        return t;
    }
    return "long long";
}

// Leading call name of a C expr (before '('), else "".
pub fn c_rhs_call_name(rhs: String) -> String {
    let n = chars_len(rhs);
    let mut i = 0;
    while i < n {
        if char_at(rhs, i) == "(" {
            i = i + 1;
        } else {
            let mut j = i;
            while j < n {
                let c = char_at(rhs, j);
                if c == "(" {
                    if j > i {
                        let mut name = "";
                        let mut k = i;
                        while k < j {
                            name = name + char_at(rhs, k);
                            k = k + 1;
                        }
                        return name;
                    }
                    return "";
                }
                if c == " " || c == "," || c == ")" {
                    return "";
                }
                j = j + 1;
            }
            return "";
        }
    }
    return "";
}

// list_get / oo_flist_get / oo_l_Name_get: LF→double, OoL_Name/Name→Name, S→OoStr, I→i64.
pub fn c_list_get_result_ty(env: String, rhs: String) -> String {
    let cnm: String = c_rhs_call_name(rhs);
    if cnm == "oo_flist_get" {
        return "double";
    }
    let cn: Int = chars_len(cnm);
    if cn > 8 {
        if char_at(cnm, 0) == "o" {
            if char_at(cnm, 3) == "l" {
                if char_at(cnm, 4) == "_" {
                    if char_at(cnm, cn - 3) == "g" {
                        return str_slice(cnm, 5, cn - 4);
                    }
                }
            }
        }
    }
    let mut an = "";
    let mut qi = 0;
    let rn = chars_len(rhs);
    while qi < rn {
        if char_at(rhs, qi) == "(" {
            qi = qi + 1;
            while qi < rn {
                let c = char_at(rhs, qi);
                if c == "," || c == ")" {
                    qi = rn;
                } else {
                    an = an + c;
                    qi = qi + 1;
                }
            }
        } else {
            qi = qi + 1;
        }
    }
    let ak: String = c_env_get(env, an);
    if ak == "S" {
        return "OoStr";
    }
    if ak == "I" {
        return "long long";
    }
    if ak == "LF" {
        return "double";
    }
    if ak == "F" {
        return "double";
    }
    if chars_len(ak) > 4 {
        if char_at(ak, 0) == "O" {
            if char_at(ak, 1) == "o" {
                if char_at(ak, 2) == "L" {
                    if char_at(ak, 3) == "_" {
                        return str_slice(ak, 4, chars_len(ak));
                    }
                }
            }
        }
    }
    if chars_len(ak) > 1 {
        if ak != "T" {
            if ak != "R" {
                if ak != "V" {
                    return ak;
                }
            }
        }
    }
    if an == "toks" || an == "brw" || an == "mr" || an == "args" {
        return "OoStr";
    }
    return "long long";
}

pub fn c_infer_list_kind(env: String, op: String, a0: String, a1: String) -> String {
    let ann0: String = c_env_get(env, "__ann__");
    if op == "list_new" {
        if ann0 != "" {
            return ann0;
        }
        return "I";
    }
    if c_is_ll_kind(ann0) {
        return ann0;
    }
    let ka0: String = c_env_get(env, a0);
    if ka0 == "S" {
        return "S";
    }
    if ka0 == "I" {
        return "I";
    }
    if ka0 == "LF" {
        return "LF";
    }
    if c_is_ll_kind(ka0) {
        return ka0;
    }
    if op == "list_push" {
        if c_env_get(env, a1) == "T" {
            return "S";
        }
        // string payload → S (avoid cycle with c_expr_is_str)
        if chars_len(a1) >= 9 {
            if char_at(a1, 0) == "o" && char_at(a1, 3) == "s" {
                return "S";
            }
        }
    }
    if chars_len(a0) > 0 {
        let k0: String = c_env_get(env, a0);
        if k0 == "S" || k0 == "I" || k0 == "F" || k0 == "LF" {
            return k0;
        }
        if chars_len(k0) > 1 {
            if k0 != "T" {
                if k0 != "R" {
                    if k0 != "V" {
                        return k0;
                    }
                }
            }
        }
        if chars_len(a0) >= 9 {
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "l" && char_at(a0, 4) == "l" {
                if char_at(a0, 6) == "S" { return "S"; }
                if char_at(a0, 6) == "F" { return "LF"; }
                return "I";
            }
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "s" && char_at(a0, 4) == "l" {
                return "S";
            }
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "i" && char_at(a0, 4) == "l" {
                return "I";
            }
        }
    }
    let fld: String = c_expr_last_field(a0);
    if fld != "" {
        let fk: String = c_env_get(env, "__fldelem__" + fld);
        if fk != "" {
            return fk;
        }
    }
    return "I";
}

// Last `.name` in a C expr such as `(tree).nodes`. Empty if none.
pub fn c_expr_last_field(e: String) -> String {
    let n: Int = chars_len(e);
    if n < 3 {
        return "";
    }
    let mut i: Int = n - 1;
    while i >= 0 {
        if char_at(e, i) == " " {
            i = i - 1;
        } else {
            break;
        }
    }
    let end: Int = i + 1;
    while i >= 0 {
        let c: String = char_at(e, i);
        let b: Int = byte_at(c, 0);
        let mut ok: Bool = false;
        if c == "_" {
            ok = true;
        }
        if b >= 65 {
            if b <= 90 {
                ok = true;
            }
        }
        if b >= 97 {
            if b <= 122 {
                ok = true;
            }
        }
        if b >= 48 {
            if b <= 57 {
                ok = true;
            }
        }
        if !ok {
            break;
        }
        i = i - 1;
    }
    if i >= 0 {
        if char_at(e, i) == "." {
            if end > i + 1 {
                return str_slice(e, i + 1, end);
            }
        }
    }
    return "";
}
