// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: ty helpers split from c_emit_ty (emit drops fns after huge c_call_result_ty)
// stage: emit

pub fn c_lower_result_ty(name: String) -> String {
    let t: String = c_call_result_ty(name);
    if t != "" {
        return t;
    }
    return "long long";
}

// Leading call name of a C expr (before '('), else "".
pub fn c_rhs_call_name(rhs: String) -> String {
    let n = chars_len(rhs);
    let mut i = 0;
    while i < n {
        if char_at(rhs, i) == "(" {
            i = i + 1;
        } else {
            let mut j = i;
            while j < n {
                let c = char_at(rhs, j);
                if c == "(" {
                    if j > i {
                        let mut name = "";
                        let mut k = i;
                        while k < j {
                            name = name + char_at(rhs, k);
                            k = k + 1;
                        }
                        return name;
                    }
                    return "";
                }
                if c == " " || c == "," || c == ")" {
                    return "";
                }
                j = j + 1;
            }
            return "";
        }
    }
    return "";
}

// list_get(NAME, i) result type from env kind of NAME (S→OoStr, I→long long).
pub fn c_list_get_result_ty(env: String, rhs: String) -> String {
    let mut an = "";
    let mut qi = 0;
    let rn = chars_len(rhs);
    while qi < rn {
        if char_at(rhs, qi) == "(" {
            qi = qi + 1;
            while qi < rn {
                let c = char_at(rhs, qi);
                if c == "," || c == ")" {
                    qi = rn;
                } else {
                    an = an + c;
                    qi = qi + 1;
                }
            }
        } else {
            qi = qi + 1;
        }
    }
    let ak: String = c_env_get(env, an);
    if ak == "S" {
        return "OoStr";
    }
    if ak == "I" {
        return "long long";
    }
    if an == "toks" || an == "brw" || an == "mr" || an == "args" {
        return "OoStr";
    }
    return "long long";
}

pub fn c_infer_list_kind(env: String, op: String, a0: String, a1: String) -> String {
    if op == "list_new" {
        let ann: String = c_env_get(env, "__ann__");
        if ann == "S" || ann == "I" {
            return ann;
        }
        return "I";
    }
    if op == "list_push" {
        // string payload → S (avoid cycle with c_expr_is_str)
        if chars_len(a1) >= 9 {
            if char_at(a1, 0) == "o" && char_at(a1, 3) == "s" {
                return "S";
            }
        }
        if chars_len(a1) >= 2 {
            let last = char_at(a1, chars_len(a1) - 1);
            let prev = char_at(a1, chars_len(a1) - 2);
            if last == "L" && prev == "L" {
                return "I";
            }
        }
    }
    if chars_len(a0) > 0 {
        let k0: String = c_env_get(env, a0);
        if k0 == "S" || k0 == "I" {
            return k0;
        }
        if chars_len(a0) >= 9 {
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "s" && char_at(a0, 4) == "l" {
                return "S";
            }
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "i" && char_at(a0, 4) == "l" {
                return "I";
            }
        }
    }
    return "I";
}
