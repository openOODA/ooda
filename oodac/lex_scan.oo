// # Scan a string, number, or ident
//
// Logline: From a quote, digit, or ident start, walks the token and packs the next index and column, or an empty list for an unterminated string.
//
// Setup: char_at, char_is_digit, char_is_alpha, list_new, and list_push exist; n is chars_len(src); the caller already sits on the first character.
//
// Beats:
//   1. lex_scan_pack pushes i then col onto a fresh list.
//   2. A string skips the opening quote, eats escapes as two characters, and returns empty when the source ends before a close quote.
//   3. A number eats digits; an ident eats alpha, digit, or underscore; both pack the cursor.

fn lex_scan_pack(i: Int, col: Int) -> List[Int] {
    let mut r: List[Int] = list_new();
    r = list_push(r, i);
    r = list_push(r, col);
    return r;
}

pub fn lex_scan_string(src: String, pos: Int, n: Int, col0: Int) -> List[Int] {
    let mut i = pos + 1;
    let mut col = col0 + 1;
    let mut cont_s = true;
    while cont_s {
        if i >= n {
            let empty: List[Int] = list_new();
            return empty;
        }
        let c2 = char_at(src, i);
        if c2 == "\"" {
            i = i + 1;
            col = col + 1;
            cont_s = false;
        } else if c2 == "\\" {
            i = i + 2;
            col = col + 2;
        } else {
            i = i + 1;
            col = col + 1;
        }
    }
    return lex_scan_pack(i, col);
}

pub fn lex_scan_number(src: String, pos: Int, n: Int, col0: Int) -> List[Int] {
    let mut i = pos + 1;
    let mut col = col0 + 1;
    let mut cont_d = true;
    while cont_d {
        if i >= n {
            cont_d = false;
        } else {
            let c2 = char_at(src, i);
            if char_is_digit(c2) {
                i = i + 1;
                col = col + 1;
            } else {
                cont_d = false;
            }
        }
    }
    return lex_scan_pack(i, col);
}

pub fn lex_scan_ident(src: String, pos: Int, n: Int, col0: Int) -> List[Int] {
    let mut i = pos + 1;
    let mut col = col0 + 1;
    let mut cont_id = true;
    while cont_id {
        if i >= n {
            cont_id = false;
        } else {
            let c2 = char_at(src, i);
            if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                i = i + 1;
                col = col + 1;
            } else {
                cont_id = false;
            }
        }
    }
    return lex_scan_pack(i, col);
}
