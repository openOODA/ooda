// # Same-fn let binds for emit-x86 harvest
//
// Logline: Binds a same-fn string mix, const-int ALU, typed INT, or int alias.
//
// Setup: mix_try, alu_until SEMI, and skip COLON IDENT exist.
//
// Beats:
//   1. Mix string concat first.
//   2. Bind let-RHS ALU ending at SEMI (2*3 is 6, not 2).
//   3. Lone INT/minus only when the next token is not an ALU op.
//   4. IDENT+LPAREN stays unbound so leftover call-ident still ERRs.
//
// residual: SysV and greet-call lets stay later.

import "x86_emit_harv.oo";
import "x86_emit_alu.oo";

pub fn x86_apply_let(toks: List[String], n: Int, i: Int, bind_names: List[String], bind_vals: List[String], int_names: List[String], int_vals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    let mut ni = i + 1;
    if ni < n && x86_tok_k(toks, ni) == "KW_MUT" {
        ni = ni + 1;
    }
    if ni + 2 >= n || x86_tok_k(toks, ni) != "IDENT" {
        return empty;
    }
    let mut eqi = ni + 1;
    if eqi < n && x86_tok_k(toks, eqi) == "COLON" {
        eqi = eqi + 1;
        if eqi < n && x86_tok_k(toks, eqi) == "IDENT" {
            eqi = eqi + 1;
        }
    }
    if eqi >= n || x86_tok_k(toks, eqi) != "EQ" {
        return empty;
    }
    let nm: String = x86_tok_t(toks, ni);
    let rhs = eqi + 1;
    let lgot: List[String] = x86_mix_try(toks, n, rhs, bind_names, bind_vals, int_names, int_vals);
    if list_len(lgot) >= 1 {
        let mut o: List[String] = list_new();
        o = list_push(o, "S");
        o = list_push(o, nm);
        o = list_push(o, list_get(lgot, 0));
        return o;
    }
    let agot: List[String] = x86_alu_until(toks, n, rhs, int_names, int_vals, "SEMI");
    if list_len(agot) >= 1 {
        let mut o: List[String] = list_new();
        o = list_push(o, "I");
        o = list_push(o, nm);
        o = list_push(o, list_get(agot, 0));
        return o;
    }
    if x86_tok_k(toks, rhs) == "STRING" {
        let after = x86_str_after(toks, n, rhs);
        let mut mixed = false;
        if after < n {
            if x86_tok_k(toks, after) == "PLUS" {
                mixed = true;
            }
        }
        if !mixed {
            let mut o: List[String] = list_new();
            o = list_push(o, "S");
            o = list_push(o, nm);
            o = list_push(o, x86_str_fold(toks, n, rhs));
            return o;
        }
    }
    if x86_tok_k(toks, rhs) == "INT" {
        if rhs + 1 >= n || !x86_is_alu_op(x86_tok_k(toks, rhs + 1)) {
            let mut o: List[String] = list_new();
            o = list_push(o, "I");
            o = list_push(o, nm);
            o = list_push(o, x86_tok_t(toks, rhs));
            return o;
        }
    }
    if x86_tok_k(toks, rhs) == "MINUS" {
        if rhs + 1 < n && x86_tok_k(toks, rhs + 1) == "INT" {
            if rhs + 2 >= n || !x86_is_alu_op(x86_tok_k(toks, rhs + 2)) {
                let mut o: List[String] = list_new();
                o = list_push(o, "I");
                o = list_push(o, nm);
                o = list_push(o, x86_neg_dec(x86_tok_t(toks, rhs + 1)));
                return o;
            }
        }
    }
    if x86_tok_k(toks, rhs) == "IDENT" {
        if rhs + 1 >= n || x86_tok_k(toks, rhs + 1) != "LPAREN" {
            let iidx = x86_bind_idx(int_names, x86_tok_t(toks, rhs));
            if iidx >= 0 {
                let mut o: List[String] = list_new();
                o = list_push(o, "I");
                o = list_push(o, nm);
                o = list_push(o, list_get(int_vals, iidx));
                return o;
            }
        }
    }
    return empty;
}
