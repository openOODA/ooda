// # Detect const if true/false println fold
//
// Logline: Returns the taken-branch STRING when a function body is only if true or if false with one println(STRING) per branch.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if KW_TRUE or KW_FALSE then a println(STRING) branch and an else println(STRING) branch.
//   3. Return the taken STRING. IDENT or INT conditions miss.
//
// residual: runtime if, no-else, and INT==INT live in sibling emit files. while/match stay dummy.

import "token_fmt.oo";
import "tc_parse_int.oo";
fn wif_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wif_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wif_bool_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wif_kind(toks, p) == "KW_LET" && wif_kind(toks, p + 1) == "IDENT" && wif_text(toks, p + 1) == name {
            let k: String = wif_kind(toks, p + 2);
            if k == "EQ" {
                let vk: String = wif_kind(toks, p + 3);
                if vk == "KW_TRUE" || vk == "KW_FALSE" { return vk; }
                let vt: String = wif_text(toks, p + 3);
                if vt == "true" { return "KW_TRUE"; }
                if vt == "false" { return "KW_FALSE"; }
            }
        }
        p = p + 1;
    }
    return "";
}
fn wif_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wif_kind(toks, p) == "KW_LET" && wif_kind(toks, p + 1) == "IDENT" && wif_text(toks, p + 1) == name {
            if wif_kind(toks, p + 2) == "EQ" && wif_kind(toks, p + 3) == "INT" { return wif_text(toks, p + 3); }
        }
        p = p + 1;
    }
    return "";
}
fn wif_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wif_kind(toks, p) != "IDENT" || wif_text(toks, p) != "println" { return empty; }
    if wif_kind(toks, p + 1) != "LPAREN" || wif_kind(toks, p + 2) != "STRING" { return empty; }
    if wif_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wif_text(toks, p + 2);
    p = p + 4;
    if p < n && wif_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}
fn wif_resolve_bool(toks: List[String], lb: Int, lim: Int, kind: String, text: String) -> String {
    if kind == "KW_TRUE" { return "KW_TRUE"; }
    if kind == "KW_FALSE" { return "KW_FALSE"; }
    if kind == "IDENT" { return wif_bool_let(toks, lb, lim, text); }
    return "";
}
fn wif_resolve_int_text(toks: List[String], lb: Int, lim: Int, kind: String, text: String) -> String {
    if kind == "INT" { return text; }
    if kind == "IDENT" { return wif_int_let(toks, lb, lim, text); }
    return "";
}
pub fn wasm_fn_if_println(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wif_kind(toks, i) == "KW_FN" && wif_kind(toks, i + 1) == "IDENT" {
            if wif_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wif_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                let lbrace: Int = p;
                p = p + 1;
                while p + 3 < n && wif_kind(toks, p) == "KW_LET" {
                    while p < n && wif_kind(toks, p) != "SEMI" { p = p + 1; }
                    if p < n && wif_kind(toks, p) == "SEMI" { p = p + 1; }
                }
                if p + 2 >= n || wif_kind(toks, p) != "KW_IF" { return ""; }
                let cond_start: Int = p + 1;
                let mut q: Int = cond_start;
                let mut outer_take: Bool = false;
                let mut outer_ok: Bool = false;
                let mut q_next: Int = -1;
                if q < n && wif_kind(toks, q) == "BANG" {
                    q = q + 1;
                    if q < n {
                        let res: String = wif_resolve_bool(toks, lbrace, q, wif_kind(toks, q), wif_text(toks, q));
                        if res == "KW_TRUE" { outer_take = false; outer_ok = true; q_next = q + 1; }
                        else if res == "KW_FALSE" { outer_take = true; outer_ok = true; q_next = q + 1; }
                    }
                } else if q + 2 < n && (wif_kind(toks, q + 1) == "EQEQ" || wif_kind(toks, q + 1) == "NEQ") {
                    let op: String = wif_kind(toks, q + 1);
                    let ls: String = wif_resolve_bool(toks, lbrace, q, wif_kind(toks, q), wif_text(toks, q));
                    let rs: String = wif_resolve_bool(toks, lbrace, q, wif_kind(toks, q + 2), wif_text(toks, q + 2));
                    if ls != "" && rs != "" {
                        let eq: Bool = ls == rs;
                        if op == "EQEQ" { outer_take = eq; } else { outer_take = !eq; }
                        outer_ok = true; q_next = q + 3;
                    } else {
                        let li: String = wif_resolve_int_text(toks, lbrace, q, wif_kind(toks, q), wif_text(toks, q));
                        let ri: String = wif_resolve_int_text(toks, lbrace, q, wif_kind(toks, q + 2), wif_text(toks, q + 2));
                        if li != "" && ri != "" {
                            let eq2: Bool = li == ri;
                            if op == "EQEQ" { outer_take = eq2; } else { outer_take = !eq2; }
                            outer_ok = true; q_next = q + 3;
                        }
                    }
                } else if q < n {
                    let res2: String = wif_resolve_bool(toks, lbrace, q, wif_kind(toks, q), wif_text(toks, q));
                    if res2 == "KW_TRUE" { outer_take = true; outer_ok = true; q_next = q + 1; }
                    else if res2 == "KW_FALSE" { outer_take = false; outer_ok = true; q_next = q + 1; }
                }
                if !outer_ok { return ""; }
                q = q_next;
                if q >= n || wif_kind(toks, q) != "LBRACE" { return ""; }
                let after_outer_lbrace: Int = q + 1;
                let is_nested: Bool = after_outer_lbrace < n && wif_kind(toks, after_outer_lbrace) == "KW_IF";
                if is_nested {
                    let icond: Int = after_outer_lbrace + 1;
                    let mut inner_take: Bool = false;
                    let mut inner_ok: Bool = false;
                    let mut inner_next: Int = -1;
                    if icond < n && wif_kind(toks, icond) == "BANG" {
                        let res: String = wif_resolve_bool(toks, lbrace, icond, wif_kind(toks, icond + 1), wif_text(toks, icond + 1));
                        if res == "KW_TRUE" { inner_take = false; inner_ok = true; inner_next = icond + 2; }
                        else if res == "KW_FALSE" { inner_take = true; inner_ok = true; inner_next = icond + 2; }
                    } else if icond + 2 < n && (wif_kind(toks, icond + 1) == "EQEQ" || wif_kind(toks, icond + 1) == "NEQ") {
                        let op2: String = wif_kind(toks, icond + 1);
                        let lsb: String = wif_resolve_bool(toks, lbrace, icond, wif_kind(toks, icond), wif_text(toks, icond));
                        let rsb: String = wif_resolve_bool(toks, lbrace, icond, wif_kind(toks, icond + 2), wif_text(toks, icond + 2));
                        if lsb != "" && rsb != "" {
                            let eq: Bool = lsb == rsb;
                            if op2 == "EQEQ" { inner_take = eq; } else { inner_take = !eq; }
                            inner_ok = true; inner_next = icond + 3;
                        } else {
                            let li2: String = wif_resolve_int_text(toks, lbrace, icond, wif_kind(toks, icond), wif_text(toks, icond));
                            let ri2: String = wif_resolve_int_text(toks, lbrace, icond, wif_kind(toks, icond + 2), wif_text(toks, icond + 2));
                            if li2 != "" && ri2 != "" {
                                let eq2: Bool = li2 == ri2;
                                if op2 == "EQEQ" { inner_take = eq2; } else { inner_take = !eq2; }
                                inner_ok = true; inner_next = icond + 3;
                            }
                        }
                    } else if icond < n {
                        let res: String = wif_resolve_bool(toks, lbrace, icond, wif_kind(toks, icond), wif_text(toks, icond));
                        if res == "KW_TRUE" { inner_take = true; inner_ok = true; inner_next = icond + 1; }
                        else if res == "KW_FALSE" { inner_take = false; inner_ok = true; inner_next = icond + 1; }
                    }
                    if !inner_ok { return ""; }
                    if inner_next >= n || wif_kind(toks, inner_next) != "LBRACE" { return ""; }
                    let ith: List[String] = wif_one_str_println(toks, inner_next + 1, n);
                    if list_len(ith) < 2 { return ""; }
                    let after_ith: Int = parse_int(list_get(ith, 1));
                    if after_ith >= n || wif_kind(toks, after_ith) != "RBRACE" { return ""; }
                    let after_ith_r: Int = after_ith + 1;
                    if after_ith_r >= n || wif_kind(toks, after_ith_r) != "KW_ELSE" { return ""; }
                    if after_ith_r + 1 >= n || wif_kind(toks, after_ith_r + 1) != "LBRACE" { return ""; }
                    let iel: List[String] = wif_one_str_println(toks, after_ith_r + 2, n);
                    if list_len(iel) < 2 { return ""; }
                    let after_iel: Int = parse_int(list_get(iel, 1));
                    if after_iel >= n || wif_kind(toks, after_iel) != "RBRACE" { return ""; }
                    let after_inner_else: Int = after_iel + 1;
                    if after_inner_else >= n || wif_kind(toks, after_inner_else) != "RBRACE" { return ""; }
                    let after_inner_block: Int = after_inner_else + 1;
                    if after_inner_block >= n || wif_kind(toks, after_inner_block) != "KW_ELSE" { return ""; }
                    if after_inner_block + 1 >= n || wif_kind(toks, after_inner_block + 1) != "LBRACE" { return ""; }
                    let oel: List[String] = wif_one_str_println(toks, after_inner_block + 2, n);
                    if list_len(oel) < 2 { return ""; }
                    let after_oel: Int = parse_int(list_get(oel, 1));
                    if after_oel >= n || wif_kind(toks, after_oel) != "RBRACE" { return ""; }
                    if after_oel + 1 >= n || wif_kind(toks, after_oel + 1) != "RBRACE" { return ""; }
                    if !outer_take { return list_get(oel, 0); }
                    if inner_take { return list_get(ith, 0); }
                    return list_get(iel, 0);
                } else {
                    let th: List[String] = wif_one_str_println(toks, q + 1, n);
                    if list_len(th) < 2 { return ""; }
                    let after_th: Int = parse_int(list_get(th, 1));
                    if after_th >= n || wif_kind(toks, after_th) != "RBRACE" { return ""; }
                    if after_th + 1 >= n || wif_kind(toks, after_th + 1) != "KW_ELSE" { return ""; }
                    if after_th + 2 >= n || wif_kind(toks, after_th + 2) != "LBRACE" { return ""; }
                    let el: List[String] = wif_one_str_println(toks, after_th + 3, n);
                    if list_len(el) < 2 { return ""; }
                    let after_el: Int = parse_int(list_get(el, 1));
                    if after_el >= n || wif_kind(toks, after_el) != "RBRACE" { return ""; }
                    if after_el + 1 >= n || wif_kind(toks, after_el + 1) != "RBRACE" { return ""; }
                    if outer_take { return list_get(th, 0); }
                    return list_get(el, 0);
                }
            }
        }
        i = i + 1;
    }
    return "";
}
