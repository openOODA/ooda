// job: name bindings and env lookup; stage: typecheck
// in: binds/env strings; out: membership / types

pub fn binds_has(binds: String, name: String) -> Bool {
    let needle = "\t" + name + "\t";
    return binds.contains(needle);
}

// Scope-aware undefined-var: binds are "\tname@depth\t". RBRACE drops deeper binds.
// Fixes nested `if { let x = 1; } println(x);` silent OK (stage-0 fails).
pub fn scope_has(binds: String, name: String, max_depth: Int) -> Bool {
    let mut d = 0;
    while d <= max_depth {
        let needle = "\t" + name + "@" + d.to_string() + "\t";
        if binds.contains(needle) {
            return true;
        }
        d = d + 1;
    }
    return false;
}

pub fn drop_depth(binds: String, depth: Int) -> String {
    // Rebuild binds without entries for this depth (after RBRACE).
    // Format entries are \tname@d\t — scan and skip matches for @depth\t
    let marker = "@" + depth.to_string() + "\t";
    let mut out = "\t";
    let n = chars_len(binds);
    let mut i = 1; // skip leading tab
    while i < n {
        // find next tab-delimited entry start
        let mut j = i;
        while j < n {
            if char_at(binds, j) == "\t" {
                // entry is binds[i..j)
                let mut entry = "";
                let mut k = i;
                while k < j {
                    entry = entry + char_at(binds, k);
                    k = k + 1;
                }
                // keep if not ending with @depth
                if !entry.contains(marker) {
                    // also reject if entry is exactly name@depth without scanning contains false positives
                    // entry form name@d
                    out = out + entry + "\t";
                } else {
                    // only drop if suffix is exactly @depth
                    let elen = chars_len(entry);
                    let mlen = chars_len(marker) - 1; // without leading? marker is @d\t but entry has no trailing tab
                    // marker without trailing tab
                    let ms = "@" + depth.to_string();
                    let mslen = chars_len(ms);
                    if elen >= mslen {
                        let mut suffix = "";
                        let mut s = elen - mslen;
                        while s < elen {
                            suffix = suffix + char_at(entry, s);
                            s = s + 1;
                        }
                        if suffix == ms {
                            // drop
                            let _drop = 0;
                        } else {
                            out = out + entry + "\t";
                        }
                    } else {
                        out = out + entry + "\t";
                    }
                }
                j = j + 1;
                i = j;
            } else {
                j = j + 1;
            }
        }
        if j >= n {
            i = n;
        }
    }
    return out;
}

// Single-pass scoped undefined-var check.
pub fn env_lookup_type(env: String, name: String) -> String {
    let key = "\t" + name + ":";
    if !env.contains(key) {
        return "";
    }
    let tn = chars_len(env);
    let kn = chars_len(key);
    let mut pos = 0;
    while pos + kn <= tn {
        let mut m = true;
        let mut j = 0;
        while j < kn {
            if char_at(env, pos + j) != char_at(key, j) {
                m = false;
                j = kn;
            } else {
                j = j + 1;
            }
        }
        if m {
            let mut out = "";
            let mut p = pos + kn;
            while p < tn {
                let c = char_at(env, p);
                if c == "\t" {
                    return out;
                }
                out = out + c;
                p = p + 1;
            }
            return out;
        }
        pos = pos + 1;
    }
    return "";
}

// Fail-closed: `let mut x: Int = 1; x = "a";` and `x = y` when y is pure-lit typed.
pub fn is_mut_binding(toks: List[String], name: String) -> Bool {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_LET" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "KW_MUT" {
                    if i + 2 < n {
                        if field_at(list_get(toks, i + 2), 0) == "IDENT" {
                            if field_at(list_get(toks, i + 2), 3) == name {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Fail-closed: `p.x = "hi"` / `p.inner.n = v` — field type + mut root.
// Stage-0 rejects immut field assign and type mismatch; oodac must not silent-OK.
