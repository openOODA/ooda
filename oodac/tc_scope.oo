// # Bind names and look up types
//
// Logline: Test whether a name is bound and look up its type in the typecheck env.
//
// Setup: binds and env are string tables. Stage is typecheck.
//
// Beats:
//   1. binds_has looks for a tab-wrapped name.
//   2. Scope walk finds the live binding.
//   3. Types come from the env string.

pub fn binds_has(binds: String, name: String) -> Bool {
    let needle = "\t" + name + "\t";
    return binds.contains(needle);
}

// Scope-aware undefined-var: binds entries are "name@depth". RBRACE drops deeper binds.
// Fixes nested `if { let x = 1; } println(x);` silent OK (stage-0 fails).
pub fn scope_has(binds: List[String], name: String, max_depth: Int) -> Bool {
    let n = list_len(binds);
    let mut d = 0;
    while d <= max_depth {
        let needle = name + "@" + d.to_string();
        let mut i = 0;
        while i < n {
            if list_get(binds, i) == needle {
                return true;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    return false;
}

pub fn drop_depth(binds: List[String], depth: Int) -> List[String] {
    // Rebuild binds without entries for this depth (after RBRACE).
    // Entries are "name@d" — drop those whose suffix is exactly "@depth".
    let marker = "@" + depth.to_string();
    let n = list_len(binds);
    let mut out: List[String] = list_new();
    let mut i = 0;
    while i < n {
        let e: String = list_get(binds, i);
        if !str_ends_with(e, marker) {
            out = list_push(out, e);
        }
        i = i + 1;
    }
    return out;
}

// Single-pass scoped undefined-var check.
pub fn env_lookup_type(env: String, name: String) -> String {
    let key = "\t" + name + ":";
    if !env.contains(key) {
        return "";
    }
    let tn = chars_len(env);
    let kn = chars_len(key);
    let mut pos = 0;
    while pos + kn <= tn {
        let mut m = true;
        let mut j = 0;
        while j < kn {
            if char_at(env, pos + j) != char_at(key, j) {
                m = false;
                j = kn;
            } else {
                j = j + 1;
            }
        }
        if m {
            let mut out = "";
            let mut p = pos + kn;
            while p < tn {
                let c = char_at(env, p);
                if c == "\t" {
                    return out;
                }
                out = out + c;
                p = p + 1;
            }
            return out;
        }
        pos = pos + 1;
    }
    return "";
}

// Fail-closed: `let mut x: Int = 1; x = "a";` and `x = y` when y is pure-lit typed.
pub fn is_mut_binding(toks: List[String], name: String) -> Bool {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_LET" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "KW_MUT" {
                    if i + 2 < n {
                        if field_at(list_get(toks, i + 2), 0) == "IDENT" {
                            if field_at(list_get(toks, i + 2), 3) == name {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Fail-closed: `p.x = "hi"` / `p.inner.n = v` — field type + mut root.
// Stage-0 rejects immut field assign and type mismatch; oodac must not silent-OK.
