// # Emit path-A metamorphic C decoys
//
// Logline: Detects // METAMORPHIC: path-a markers and emits non-semantic decoy functions that diversify object layout without mutating assembly at runtime.
//
// Setup: Backend-C emit floor. Markers are line-start only. Decoys emit in bodies/all/full modes only. Residual DESIGN immune system (RAM re-mutation, ROP reshape) still refuse.
//
// Beats:
//   1. c_parse_metamorphic_path_a and c_parse_metamorphic_shuffle scan line-start METAMORPHIC directives.
//   2. c_meta_layout_emit_decoys is true for bodies/all/full family modes; c_emit_meta_banner prints once.
//   3. c_emit_meta_decoy prints one of four used/noinline static decoys capped at 64; the named wrapper comments the preceding fn.

// Line-start only. Returns true if file enables path-A layout decoys.
// Also true for `// METAMORPHIC: path-a-shuffle` (prefix match).
pub fn c_parse_metamorphic_path_a(src: String) -> Bool {
    let needle = "// " + "METAMORPHIC: path-a";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Line-start only. `// METAMORPHIC: path-a-shuffle` enables reverse fn order.
pub fn c_parse_metamorphic_shuffle(src: String) -> Bool {
    let needle = "// " + "METAMORPHIC: path-a-shuffle";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Mode gate: emit decoys once (body/all/full family). Never preamble or protos*.
pub fn c_meta_layout_emit_decoys(mode: String) -> Bool {
    if mode == "bodies" {
        return true;
    }
    if mode == "bodies_noarc" {
        return true;
    }
    if mode == "all" {
        return true;
    }
    if mode == "all_noarc" {
        return true;
    }
    if mode == "full" {
        return true;
    }
    return false;
}

// Banner once per TU when path-A layout decoys will actually emit.
pub fn c_emit_meta_banner() {
    println("/* OODA path-A metamorphic layout decoys enabled (emit-time only) */");
}

// Hard caps (memory auditor): max 64 decoys / TU; pad array ≤16 bytes.
pub fn c_meta_decoy_max() -> Int {
    return 64;
}

// Emit one non-semantic decoy. idx is 0-based sequence among top-level fns.
// Never called at runtime; exists only to diversify .text/.data layout.
// Body uses emit-sequence index only (no user strings / fptrs / exports).
pub fn c_emit_meta_decoy(idx: Int) {
    let mut safe = idx;
    if safe < 0 {
        return;
    }
    if safe >= c_meta_decoy_max() {
        println("/* ooda path-A metamorphic: decoy cap 64 reached (residual) */");
        return;
    }
    let id = safe.to_string();
    if id == "" {
        return;
    }
    // Style from idx%4 — weak layout diversity (not CFI).
    let style = safe - ((safe / 4) * 4);
    println("/* ooda path-A metamorphic layout decoy (not runtime mutation) */");
    println("#if defined(__GNUC__) || defined(__clang__)");
    println("__attribute__((used, noinline))");
    println("#endif");
    println("static void __oo_meta_decoy_" + id + "(void) {");
    if style == 0 {
        println("  volatile unsigned int __oo_meta_pad = " + id + "u;");
        println("  (void)__oo_meta_pad;");
    } else if style == 1 {
        println("  volatile unsigned char __oo_meta_buf[16];");
        println("  __oo_meta_buf[0] = (unsigned char)(" + id + ");");
        println("  (void)__oo_meta_buf[0];");
    } else if style == 2 {
        println("  volatile int __oo_meta_i = 0;");
        println("  while (__oo_meta_i < 1) { __oo_meta_i = __oo_meta_i + 1; }");
        println("  (void)__oo_meta_i;");
    } else {
        println("  volatile unsigned int __oo_meta_x = " + id + "u ^ 0xA5A5u;");
        println("  (void)__oo_meta_x;");
    }
    println("}");
}

// Named wrapper: comment ties decoy to preceding fn; body still index-only.
pub fn c_emit_meta_decoy_named(idx: Int, fn_name: String) {
    if fn_name != "" {
        println("/* path-A decoy after fn " + fn_name + " */");
    }
    c_emit_meta_decoy(idx);
}
