// package: backend-c — path-A metamorphic layout diversity (immune floor slice)
// stage: emit
//
// Path A (opt-in): source directive `// METAMORPHIC: path-a` enables emission of
// non-semantic C decoy functions between top-level fns so the exposed object
// layout differs from a build without the marker. Deterministic per source
// order (decoy index = emit order). Does NOT mutate assembly at runtime.
//
// Residual (DESIGN full immune system): continuous RAM re-mutation, ROP graph
// reshaping, metamorphic_emit/metamorphic_build free-names — still refuse.
// Tension: default product builds stay deterministic; path-a is explicit opt-in.

// Line-start only. Returns true if file enables path-A layout decoys.
pub fn c_parse_metamorphic_path_a(src: String) -> Bool {
    let needle = "// " + "METAMORPHIC: path-a";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Emit one non-semantic decoy. idx is 0-based sequence among top-level fns.
// Never called at runtime; exists only to diversify .text/.data layout.
pub fn c_emit_meta_decoy(idx: Int) {
    let id = idx.to_string();
    println("/* ooda path-A metamorphic layout decoy (not runtime mutation) */");
    println("static void __oo_meta_decoy_" + id + "(void) {");
    println("  volatile int __oo_meta_pad = " + id + ";");
    println("  (void)__oo_meta_pad;");
    println("}");
}
