// # Emit native looping while loop
//
// Logline: Lowers dynamic while loop with stack-backed counter, comparison branch, body write, and backward jmp.
//
// Setup: tokenize_lines, x86_tok_k, and x86_tok_t exist.
//
// Beats:
//   1. Match let mut x: Int = 0; while x < N { x = x + 1; println(MSG); }.
//   2. Allocate -8(%rbp), emit loop header, cmp, jge exit, body write, increment, backward jmp.
//   3. Deallocate stack and exit 0.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";

pub fn x86_match_while_loop(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 4 < n && x86_tok_k(toks, p) == "LPAREN" && x86_tok_k(toks, p + 1) == "RPAREN" && x86_tok_k(toks, p + 2) == "LBRACE" && x86_tok_k(toks, p + 3) == "KW_LET" && x86_tok_k(toks, p + 4) == "KW_MUT" {
                p = p + 5;
                if p >= n || x86_tok_k(toks, p) != "IDENT" { return empty; }
                let var_name: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "COLON" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != "Int" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "EQ" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "INT" { return empty; }
                let init_val: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "SEMI" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "KW_WHILE" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != var_name { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "LT" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "INT" { return empty; }
                let bound_val: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "LBRACE" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != var_name { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "EQ" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != var_name { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "PLUS" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "INT" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "SEMI" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != "println" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "LPAREN" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "STRING" { return empty; }
                let msg_str: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "RPAREN" { return empty; }
                p = p + 1;
                if p < n && x86_tok_k(toks, p) == "SEMI" { p = p + 1; }
                if p >= n || x86_tok_k(toks, p) != "RBRACE" { return empty; }
                let mut out: List[String] = list_new();
                out = list_push(out, init_val);
                out = list_push(out, bound_val);
                out = list_push(out, msg_str);
                return out;
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn x86_emit_while_loop(init_val: String, bound_val: String, msg: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lstr_loop:");
    println("    .ascii \"" + x86_ascii_esc(msg) + "\\n\"");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 4");
    println("main:");
    println("_start:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $16, %rsp");
    println("    movq $" + init_val + ", -8(%rbp)");
    println(".Lwhile_start_0:");
    println("    cmpq $" + bound_val + ", -8(%rbp)");
    println("    jge .Lwhile_end_0");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    println("    lea .Lstr_loop(%rip), %rsi");
    let ln = chars_len(msg) + 1;
    println("    mov $" + ln.to_string() + ", %rdx");
    println("    syscall");
    println("    addq $1, -8(%rbp)");
    println("    jmp .Lwhile_start_0");
    println(".Lwhile_end_0:");
    println("    add $16, %rsp");
    println("    pop %rbp");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
