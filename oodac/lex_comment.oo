// # Skip a line comment
//
// Logline: Walks from the two slashes to the next newline or the end of source and returns the packed index and column.
//
// Setup: char_at, list_new, and list_push exist; the caller already saw // at pos; n is the source length; col is the column of the first slash.
//
// Beats:
//   1. Seed i and c two past the slashes.
//   2. Advance one character at a time until the index hits n or char_at yields a newline.
//   3. Pack i then c onto a fresh list and return it.

pub fn lex_skip_line_comment(src: String, pos: Int, n: Int, col: Int) -> List[Int] {
    let mut i = pos + 2;
    let mut c = col + 2;
    let mut cont_c = true;
    while cont_c {
        if i >= n {
            cont_c = false;
        } else {
            let c2 = char_at(src, i);
            if c2 == "\n" {
                cont_c = false;
            } else {
                i = i + 1;
                c = c + 1;
            }
        }
    }
    let mut res: List[Int] = list_new();
    res = list_push(res, i);
    res = list_push(res, c);
    return res;
}
