// job: line comment lexing helper split from lex.oo

pub fn lex_skip_line_comment(src: String, pos: Int, n: Int, col: Int) -> List[Int] {
    let mut i: Int = pos + 2;
    let mut c: Int = col + 2;
    let mut cont_c: Bool = true;
    while cont_c {
        if i >= n {
            cont_c = false;
        } else {
            let c2: String = char_at(src, i);
            if c2 == "\n" {
                cont_c = false;
            } else {
                i = i + 1;
                c = c + 1;
            }
        }
    }
    let mut res: List[Int] = list_new();
    res = list_push(res, i);
    res = list_push(res, c);
    return res;
}
