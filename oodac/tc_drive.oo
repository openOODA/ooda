// # AST type-check driver for c_emit Phase A
//
// Logline: Walks an AstFile, dispatches per AstItem, and emits TcError records at the offending file:line, surfacing 593 of 1,208 c_emit-induced BLOCKED rows per audit/green/c_emit_refactor_phase_a.oot:1-3.
//
// Setup: Reads AstFile + AstItem/AstStmt/AstExpr from ooda/oodac/ast.oo:14-73 and Ty strings from ooda/oodac/ty.oo (parallel; stub import per spec §5). Two-pass walk: collect sigs, then check. C emit is not aborted (spec §5 step 2). Pin: v0.204.0-beta.
//
// Beats:
//   1. TcError: 5-field record (file, line, col, kind, msg) per spec §4 line 53.
//   2. tc_check: walk AstFile items, dispatch on ast_tag, return csv of errors.
//   3. tc_check_fn / tc_check_stmt / tc_check_expr: per-node rules per spec §4 (c_emit_refactor_phase_a.oot:55-69).
//   4. tc_env: name->Ty map; semicolon-delimited, mirrors c_emit_env.oo:14-50 pattern.
//   5. tc_report: prints one TC line per error (spec §5 reporting format).
//
// Notes: ≤ 256 lines; only .oo/.oot; ASD-STE100; cite file:line for every claim. ty.oo is a stub import. Driver is data-only — no c_emit_*.oo calls per spec §5 step 3. Phase A scope: per-fn env (params only); cross-statement scope is Phase B per spec §4.
import "ast.oo";
import "ty.oo";
// Returns the comma-separated args inside the outermost parens; "" when the node has no parens.
pub fn tc_args_of(node: String) -> String {
    let n: Int = str_len(node); let mut depth: Int = 0; let mut start: Int = 0; let mut i: Int = 0; let mut hit: Bool = false;
    while i < n {
        let c: String = str_char_at(node, i);
        if str_eq(c, "(") { if depth == 0 { start = i + 1; hit = true; } depth = depth + 1; }
        if str_eq(c, ")") { depth = depth - 1; if depth == 0 && hit { return str_substring(node, start, i); } }
        i = i + 1;
    }
    return "";
}
// Constructor for a TcError record: TcError(file,line,col,kind,msg). Per spec §4 line 53.
pub fn mk_tc_error(file: String, line: String, col: String, kind: String, msg: String) -> String {
    return "TcError(" + file + "," + line + "," + col + "," + kind + "," + msg + ")";
}
// Empty env: name->Ty map; semicolon-delimited; mirrors c_emit_env.oo:14.
pub fn tc_env_new() -> String { return ""; }
// Append-only put. Single-fn scope keeps env small; last-wins get handles shadowing.
pub fn tc_env_put(env: String, name: String, ty: String) -> String { return env + name + "=" + ty + ";"; }
// Last-wins get: returns the last "name=" value at a start-or-';'-boundary; mirrors c_emit_env.oo:14-50.
pub fn tc_env_get(env: String, name: String) -> String {
    let key: String = name + "="; let kn: Int = str_len(key); let en: Int = str_len(env); let mut found: String = ""; let mut i: Int = 0;
    while i + kn <= en {
        let at: Bool = i == 0 || str_eq(str_char_at(env, i - 1), ";");
        if at {
            let mut ok: Bool = true; let mut j: Int = 0;
            while j < kn { if !str_eq(str_char_at(env, i + j), str_char_at(key, j)) { ok = false; j = kn; } j = j + 1; }
            if ok {
                let s: Int = i + kn; let mut k: Int = s;
                while k < en && !str_eq(str_char_at(env, k), ";") { k = k + 1; }
                found = str_substring(env, s, k);
            }
        }
        i = i + 1;
    }
    return found;
}
// Appends a TcError to a csv list; "" sentinel short-circuits.
pub fn errs_add(errs: String, e: String) -> String {
    if str_eq(errs, "") { return e; }
    if str_eq(e, "") { return errs; }
    return errs + "," + e;
}
// Top-level entry. Walks AstFile items, dispatches per ast_tag, returns csv of TcError records.
pub fn tc_check(ast: String) -> String {
    if !str_eq(ast_tag(ast), "AstFile") { return ""; }
    let items: String = tc_args_of(ast); let n: Int = list_len_str(items);
    let mut sigs: String = tc_env_new(); let mut arities: String = tc_env_new(); let mut i: Int = 0;
    while i < n {
        let item: String = list_get_str(items, i);
        if str_eq(ast_tag(item), "AstFn") { let a: String = tc_args_of(item); let nm: String = list_get_str(a, 0); let ps: String = list_get_str(a, 1); let rt: String = list_get_str(a, 2); sigs = tc_env_put(sigs, nm, rt); arities = tc_env_put(arities, nm, str_from_int(list_len_str(ps))); }
        i = i + 1;
    }
    let mut errs: String = ""; i = 0;
    while i < n { let item: String = list_get_str(items, i); if str_eq(ast_tag(item), "AstFn") { errs = errs_add(errs, tc_check_fn(item, sigs, arities)); } i = i + 1; }
    return errs;
}
// Type-check a single AstFn: params, ret, body stmts, tail expr. Per spec §4 rules 3,4,5.
pub fn tc_check_fn(fn_node: String, sigs: String, arities: String) -> String {
    let a: String = tc_args_of(fn_node); let ret_ty: String = list_get_str(a, 2); let body: String = list_get_str(a, 4); let mut errs: String = ""; let mut env: String = tc_env_new();
    let params: String = list_get_str(a, 1); let np: Int = list_len_str(params); let mut pi: Int = 0;
    while pi < np { let pa: String = tc_args_of(list_get_str(params, pi)); let pn: String = list_get_str(pa, 0); let pt: String = list_get_str(pa, 1); if str_eq(pt, "TyUnit") { errs = errs_add(errs, mk_tc_error("", "0", "0", "param_ty", "param '" + pn + "' is TyUnit")); } env = tc_env_put(env, pn, pt); pi = pi + 1; }
    env = tc_env_put(env, "__ret__", ret_ty); env = tc_env_put(env, "__sigs__", sigs); env = tc_env_put(env, "__arities__", arities);
    let ba: String = tc_args_of(body); let stmts: String = list_get_str(ba, 0); let tail: String = list_get_str(ba, 1); let ns: Int = list_len_str(stmts); let mut si: Int = 0;
    while si < ns { errs = errs_add(errs, tc_check_stmt(list_get_str(stmts, si), env)); si = si + 1; }
    if !str_eq(tail, "") {
        let tty: String = tc_expr_ty(tail, env); let rty: String = tc_env_get(env, "__ret__");
        let bad: Bool = !str_eq(tty, "") && !str_eq(rty, "") && !str_eq(tty, rty) && !(str_eq(tty, "TyInt") && str_eq(rty, "TyFloat")) && !(str_eq(tty, "TyFloat") && str_eq(rty, "TyInt"));
        if bad { errs = errs_add(errs, mk_tc_error("", "0", "0", "ret_tail", "tail " + tty + " != ret " + rty)); }
    }
    return errs;
}
// Type-check a single AstStmt; returns csv of TcError records ("" if OK).
pub fn tc_check_stmt(stmt: String, env: String) -> String {
    let tag: String = ast_tag(stmt); let a: String = tc_args_of(stmt);
    if str_eq(tag, "SLet") {  // assignability: mirrors c_emit_let.oo:46-90.
        let nm: String = list_get_str(a, 0); let dty: String = list_get_str(a, 1); let rhs: String = list_get_str(a, 2); let mut errs: String = "";
        if !str_eq(tc_env_get(env, nm), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "dup_let", "name '" + nm + "' already bound")); }
        let rty: String = tc_expr_ty(rhs, env);
        let bad: Bool = !str_eq(rty, "") && !str_eq(dty, "") && !str_eq(rty, dty) && !(str_eq(rty, "TyInt") && str_eq(dty, "TyFloat")) && !(str_eq(rty, "TyFloat") && str_eq(dty, "TyInt"));
        if bad { errs = errs_add(errs, mk_tc_error("", "0", "0", "let_assign", "rhs " + rty + " not assignable to " + dty)); }
        return errs_add(errs, tc_check_expr(rhs, env));
    }
    if str_eq(tag, "SAssign") {
        let lhs: String = list_get_str(a, 0); let rhs: String = list_get_str(a, 1);
        let lty: String = tc_expr_ty(lhs, env); let rty: String = tc_expr_ty(rhs, env); let mut errs: String = "";
        if str_eq(lty, "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_assign", "lhs not in env")); }
        let bad: Bool = !str_eq(rty, "") && !str_eq(lty, "") && !str_eq(rty, lty) && !(str_eq(rty, "TyInt") && str_eq(lty, "TyFloat")) && !(str_eq(rty, "TyFloat") && str_eq(lty, "TyInt"));
        if bad { errs = errs_add(errs, mk_tc_error("", "0", "0", "assign_ty", "rhs " + rty + " not assignable to " + lty)); }
        return errs_add(errs, tc_check_expr(rhs, env));
    }
    if str_eq(tag, "SReturn") {
        let expr: String = list_get_str(a, 0); let ret_ty: String = tc_env_get(env, "__ret__");
        let ety: String = tc_expr_ty(expr, env); let mut errs: String = tc_check_expr(expr, env);
        let bad: Bool = !str_eq(ety, "") && !str_eq(ret_ty, "") && !str_eq(ety, ret_ty) && !(str_eq(ety, "TyInt") && str_eq(ret_ty, "TyFloat")) && !(str_eq(ety, "TyFloat") && str_eq(ret_ty, "TyInt"));
        if bad { errs = errs_add(errs, mk_tc_error("", "0", "0", "ret_ty", "return " + ety + " != fn ret " + ret_ty)); }
        return errs;
    }
    if str_eq(tag, "SWhile") {
        let cond: String = list_get_str(a, 0); let body: String = list_get_str(a, 1);
        let cty: String = tc_expr_ty(cond, env); let mut errs: String = tc_check_expr(cond, env);
        if !str_eq(cty, "") && !str_eq(cty, "TyBool") { errs = errs_add(errs, mk_tc_error("", "0", "0", "cond_ty", "while cond != TyBool")); }
        return errs_add(errs, tc_walk_block(body, env));
    }
    if str_eq(tag, "SFor") {
        let init: String = list_get_str(a, 0); let cond: String = list_get_str(a, 1); let step: String = list_get_str(a, 2); let body: String = list_get_str(a, 3); let mut errs: String = "";
        if !str_eq(init, "") { errs = errs_add(errs, tc_check_stmt(init, env)); }
        let cty: String = tc_expr_ty(cond, env);
        if !str_eq(cty, "") && !str_eq(cty, "TyBool") { errs = errs_add(errs, mk_tc_error("", "0", "0", "cond_ty", "for cond != TyBool")); }
        if !str_eq(step, "") { errs = errs_add(errs, tc_check_expr(step, env)); }
        return errs_add(errs, tc_walk_block(body, env));
    }
    if str_eq(tag, "SExpr") { return tc_check_expr(list_get_str(a, 0), env); }
    return "";
}
// Walks an AstBlock(stmts) used as a while/for/fn body — no tail-ty check.
pub fn tc_walk_block(block: String, env: String) -> String {
    let a: String = tc_args_of(block); let stmts: String = list_get_str(a, 0);
    let mut errs: String = ""; let n: Int = list_len_str(stmts); let mut i: Int = 0;
    while i < n { errs = errs_add(errs, tc_check_stmt(list_get_str(stmts, i), env)); i = i + 1; }
    return errs;
}
// Walks a comma-separated list of exprs and accumulates per-expr errors.
pub fn tc_walk_exprs(list: String, env: String) -> String {
    let mut errs: String = ""; let n: Int = list_len_str(list); let mut i: Int = 0;
    while i < n { errs = errs_add(errs, tc_check_expr(list_get_str(list, i), env)); i = i + 1; }
    return errs;
}
// Type-check a single AstExpr; returns csv of TcError records.
pub fn tc_check_expr(expr: String, env: String) -> String {
    let tag: String = ast_tag(expr); let a: String = tc_args_of(expr); let mut errs: String = "";
    if str_eq(tag, "EVar") { if str_eq(tc_env_get(env, list_get_str(a, 0)), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_var", "undefined variable '" + list_get_str(a, 0) + "'")); } return errs; }
    if str_eq(tag, "ECall") {  // call signature: mirrors c_emit_call_ty.oo:5-101.
        let callee: String = list_get_str(a, 0); let args: String = list_get_str(a, 1);
        if str_eq(tc_env_get(tc_env_get(env, "__sigs__"), callee), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_call", "callee '" + callee + "' unresolved")); }
        let decl: String = tc_env_get(tc_env_get(env, "__arities__"), callee); let actual: String = str_from_int(list_len_str(args));
        if !str_eq(decl, "") && !str_eq(decl, actual) { errs = errs_add(errs, mk_tc_error("", "0", "0", "call_arity", callee + " arity " + actual + " != " + decl)); }
        return errs_add(errs, tc_walk_exprs(args, env));
    }
    if str_eq(tag, "EMethod") {
        let recv: String = list_get_str(a, 0); let mname: String = list_get_str(a, 1); let margs: String = list_get_str(a, 2);
        let rt: String = tc_expr_ty(recv, env);
        if !str_eq(rt, "") && str_eq(tc_method_result_ty(rt, mname), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_method", "no method '" + mname + "' on " + rt)); }
        return errs_add(errs_add(errs, tc_check_expr(recv, env)), tc_walk_exprs(margs, env));
    }
    if str_eq(tag, "EField") {
        let rt: String = tc_expr_ty(list_get_str(a, 0), env); let sname: String = list_get_str(tc_args_of(rt), 0); let fname: String = list_get_str(a, 1);
        if str_eq(ast_tag(rt), "TyName") && str_eq(tc_env_get(env, "__struct__" + sname + "__" + fname), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_field", "no field '" + fname + "' on " + sname)); }
        return errs_add(errs, tc_check_expr(list_get_str(a, 0), env));
    }
    if str_eq(tag, "EArrow") {
        let rt: String = tc_expr_ty(list_get_str(a, 0), env); let rtag: String = ast_tag(rt);
        if !str_eq(rtag, "TyRef") && !str_eq(rtag, "TyRefMut") { errs = errs_add(errs, mk_tc_error("", "0", "0", "arrow_recv", "arrow recv " + rt + " not a pointer")); }
        return errs_add(errs, tc_check_expr(list_get_str(a, 0), env));
    }
    if str_eq(tag, "EIndex") {
        let bt: String = tc_expr_ty(list_get_str(a, 0), env); let it: String = tc_expr_ty(list_get_str(a, 1), env);
        if !str_eq(it, "") && !str_eq(it, "TyInt") { errs = errs_add(errs, mk_tc_error("", "0", "0", "index_ty", "index " + it + " != TyInt")); }
        if !str_eq(bt, "") && !str_eq(ast_tag(bt), "TyList") { errs = errs_add(errs, mk_tc_error("", "0", "0", "index_base", "index base " + bt + " not a list")); }
        return errs_add(errs_add(errs, tc_check_expr(list_get_str(a, 0), env)), tc_check_expr(list_get_str(a, 1), env));
    }
    if str_eq(tag, "EStructLit") {
        let sname: String = list_get_str(a, 0);
        if str_eq(tc_env_get(env, "__struct__" + sname), "") { errs = errs_add(errs, mk_tc_error("", "0", "0", "undef_struct", "unknown struct '" + sname + "'")); }
        return errs_add(errs, tc_walk_exprs(list_get_str(a, 1), env));
    }
    if str_eq(tag, "EIf") {
        let cond: String = list_get_str(a, 0); let te: String = list_get_str(a, 1); let ee: String = list_get_str(a, 2);
        let ct: String = tc_expr_ty(cond, env);
        if !str_eq(ct, "") && !str_eq(ct, "TyBool") { errs = errs_add(errs, mk_tc_error("", "0", "0", "cond_ty", "if cond != TyBool")); }
        let tt: String = tc_expr_ty(te, env); let et: String = tc_expr_ty(ee, env);
        if !str_eq(tt, "") && !str_eq(et, "") && !str_eq(tt, et) && !(str_eq(tt, "TyInt") && str_eq(et, "TyFloat")) && !(str_eq(tt, "TyFloat") && str_eq(et, "TyInt")) { errs = errs_add(errs, mk_tc_error("", "0", "0", "if_branch", "branches " + tt + " and " + et + " differ")); }
        errs = errs_add(errs, tc_check_expr(cond, env));
        errs = errs_add(errs, tc_check_expr(te, env));
        if !str_eq(ee, "") { errs = errs_add(errs, tc_check_expr(ee, env)); }
        return errs;
    }
    if str_eq(tag, "EMatch") { return errs_add(errs_add(errs, tc_check_expr(list_get_str(a, 0), env)), tc_walk_exprs(list_get_str(a, 1), env)); }
    if str_eq(tag, "EBinop") { return errs_add(errs_add(errs, tc_check_expr(list_get_str(a, 1), env)), tc_check_expr(list_get_str(a, 2), env)); }
    if str_eq(tag, "EUnop") { return errs_add(errs, tc_check_expr(list_get_str(a, 1), env)); }
    return errs;
}
// Method-dispatch table per spec §4 rule 2 + c_emit_call.oo:181-205 (.is_ok/.is_err/.unwrap).
pub fn tc_method_result_ty(recv_ty: String, mname: String) -> String {
    if str_eq(ast_tag(recv_ty), "TyList") && str_eq(mname, "len") { return "TyInt"; }
    if str_eq(ast_tag(recv_ty), "TyResult") && (str_eq(mname, "is_ok") || str_eq(mname, "is_err")) { return "TyBool"; }
    if str_eq(ast_tag(recv_ty), "TyResult") && str_eq(mname, "unwrap") { return list_get_str(tc_args_of(recv_ty), 0); }
    return "";
}
// Infer the Ty of an AstExpr; "" on miss. Drives assignability in stmt/expr checkers.
pub fn tc_expr_ty(expr: String, env: String) -> String {
    let tag: String = ast_tag(expr); let a: String = tc_args_of(expr);
    if str_eq(tag, "ELitInt") { return "TyInt"; }
    if str_eq(tag, "ELitFloat") { return "TyFloat"; }
    if str_eq(tag, "ELitStr") { return "TyStr"; }
    if str_eq(tag, "ELitBool") { return "TyBool"; }
    if str_eq(tag, "EVar") { return tc_env_get(env, list_get_str(a, 0)); }
    if str_eq(tag, "EBinop") {
        let op: String = list_get_str(a, 0); let lt: String = tc_expr_ty(list_get_str(a, 1), env); let rt: String = tc_expr_ty(list_get_str(a, 2), env);
        if str_eq(lt, "") || str_eq(rt, "") { return ""; }
        if str_eq(op, "+") || str_eq(op, "-") || str_eq(op, "*") || str_eq(op, "/") || str_eq(op, "%") {
            if str_eq(lt, "TyInt") && str_eq(rt, "TyInt") { return "TyInt"; }
            if str_eq(lt, "TyFloat") && str_eq(rt, "TyFloat") { return "TyFloat"; }
            if (str_eq(lt, "TyInt") && str_eq(rt, "TyFloat")) || (str_eq(lt, "TyFloat") && str_eq(rt, "TyInt")) { return lt; }
            return "";
        }
        if str_eq(op, "==") || str_eq(op, "!=") || str_eq(op, "<") || str_eq(op, "<=") || str_eq(op, ">") || str_eq(op, ">=") {
            if str_eq(lt, rt) || (str_eq(lt, "TyInt") && str_eq(rt, "TyFloat")) || (str_eq(lt, "TyFloat") && str_eq(rt, "TyInt")) { return "TyBool"; }
            return "";
        }
        if str_eq(op, "&&") || str_eq(op, "||") { if str_eq(lt, "TyBool") && str_eq(rt, "TyBool") { return "TyBool"; } }
        return "";
    }
    if str_eq(tag, "EUnop") { let op: String = list_get_str(a, 0); let xt: String = tc_expr_ty(list_get_str(a, 1), env); if str_eq(op, "-") { return xt; } if str_eq(op, "!") { return "TyBool"; } return xt; }
    if str_eq(tag, "ECall") { return tc_env_get(tc_env_get(env, "__sigs__"), list_get_str(a, 0)); }
    if str_eq(tag, "EMethod") { return tc_method_result_ty(tc_expr_ty(list_get_str(a, 0), env), list_get_str(a, 1)); }
    if str_eq(tag, "EField") { let rt: String = tc_expr_ty(list_get_str(a, 0), env); if str_eq(ast_tag(rt), "TyName") { return tc_env_get(env, "__struct__" + list_get_str(tc_args_of(rt), 0) + "__" + list_get_str(a, 1)); } return ""; }
    if str_eq(tag, "EArrow") {
        let rt: String = tc_expr_ty(list_get_str(a, 0), env); let rtag: String = ast_tag(rt);
        if str_eq(rtag, "TyRef") || str_eq(rtag, "TyRefMut") { let inner: String = list_get_str(tc_args_of(rt), 0); if str_eq(ast_tag(inner), "TyName") { return tc_env_get(env, "__struct__" + list_get_str(tc_args_of(inner), 0) + "__" + list_get_str(a, 1)); } }
        return "";
    }
    if str_eq(tag, "EIndex") { let bt: String = tc_expr_ty(list_get_str(a, 0), env); if str_eq(ast_tag(bt), "TyList") { return tc_args_of(bt); } return ""; }
    if str_eq(tag, "EStructLit") { return "TyName(" + list_get_str(a, 0) + ")"; }
    if str_eq(tag, "EIf") { return tc_expr_ty(list_get_str(a, 1), env); }
    if str_eq(tag, "EMatch") { return tc_expr_ty(list_get_str(a, 0), env); }
    if str_eq(tag, "EClosure") { return "TyUnit"; }
    return "";
}
// Print one TcError per line as `TC\t<file>:<line>:<col>\t<kind>\t<msg>`. Per spec §5 step 2.
pub fn tc_report(errs: String) {
    if str_eq(errs, "") { return; }
    let n: Int = list_len_str(errs); let mut i: Int = 0;
    while i < n {
        let e: String = list_get_str(errs, i); let a: String = tc_args_of(e);
        let line: String = "TC\t" + list_get_str(a, 0) + ":" + list_get_str(a, 1) + ":" + list_get_str(a, 2) + "\t" + list_get_str(a, 3) + "\t" + list_get_str(a, 4);
        println(line);
        i = i + 1;
    }
}
