import "llvm_emit_stmt.oo";
import "llvm_emit_fn.oo";
import "c_emit_secret.oo";

// Pre-scan fn signatures → "name=llvm_ty|…" for call return types
fn llvm_scan_fn_rets(toks: List[String], n: Int) -> String {
    let mut tab: String = "";
    let mut pos: Int = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let mut p: Int = pos;
            if field_at(list_get(toks, p), 0) == "KW_PUB" { p = p + 1; }
            if p < n && field_at(list_get(toks, p), 0) == "KW_FN" { p = p + 1; }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let fname: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                // skip params
                if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                    let mut depth: Int = 0;
                    while p < n {
                        let kk: String = field_at(list_get(toks, p), 0);
                        if kk == "LPAREN" { depth = depth + 1; }
                        if kk == "RPAREN" {
                            depth = depth - 1;
                            p = p + 1;
                            if depth == 0 { break; }
                        } else {
                            p = p + 1;
                        }
                    }
                }
                let mut rty: String = "void";
                if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
                    p = p + 1;
                    if p < n {
                        rty = field_at(list_get(toks, p), 3);
                        p = p + 1;
                    }
                }
                let mut lty: String = llvm_ty_map(rty);
                if fname == "main" { lty = "i32"; }
                tab = tab + fname + "=" + lty + "|";
            }
            pos = pos + 1;
        } else {
            pos = pos + 1;
        }
    }
    return tab;
}

pub fn llvm_emit_stream(src: String, no_preamble: Bool) {
    if !no_preamble {
        llvm_emit_preamble();
    }
    let toks: List[String] = tokenize_lines(src);
    // M129: Secret refuse on LLVM path (same dual-path as check / Backend-C)
    check_secret_println_sinks(src, toks);
    let n: Int = list_len(toks);
    let fntab: String = llvm_scan_fn_rets(toks, n);
    let mut pos: Int = 0;
    let mut str_c: String = "0";
    let mut str_t: String = "";
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let mut next_k: Int = k;
            if k == "KW_PUB" && pos + 1 < n {
                next_k = field_at(list_get(toks, pos + 1), 0);
            }
            if next_k == "KW_TYPE" {
                pos = llvm_emit_type_decl(toks, pos, n);
            } else {
                let fn_res: List[String] = llvm_emit_fn(toks, pos, n, str_c, str_t, fntab);
                pos = parse_int(list_get(fn_res, 0));
                str_c = list_get(fn_res, 1);
                str_t = list_get(fn_res, 2);
            }
        } else if k == "KW_TYPE" {
            pos = llvm_emit_type_decl(toks, pos, n);
        } else if k == "KW_VERIFY" {
            pos = llvm_skip_verify(toks, pos, n);
        } else if k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
    llvm_emit_str_pool(str_t);
}
