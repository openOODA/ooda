// package: backend-llvm — Direct textual LLVM IR codegen entrypoint
// stage: emit

import "token_fmt.oo";
import "check_caps.oo";
import "llvm_emit_preamble.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";
import "llvm_emit_arc.oo";
import "llvm_emit_call.oo";
import "llvm_emit_assert.oo";
import "llvm_emit_method.oo";
import "llvm_emit_expr.oo";
import "llvm_emit_let.oo";
import "llvm_emit_control.oo";
import "llvm_emit_block.oo";
import "llvm_emit_stmt.oo";
import "llvm_emit_fn.oo";

pub fn llvm_emit_stream(src: String, no_preamble: Bool) {
    if !no_preamble {
        llvm_emit_preamble();
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    // Module-level string pool (counter + accumulated global decls)
    let mut str_c: String = "0";
    let mut str_t: String = "";
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let mut next_k = k;
            if k == "KW_PUB" && pos + 1 < n {
                next_k = field_at(list_get(toks, pos + 1), 0);
            }
            if next_k == "KW_TYPE" {
                pos = llvm_emit_type_decl(toks, pos, n);
            } else {
                let fn_res: List[String] = llvm_emit_fn(toks, pos, n, str_c, str_t);
                pos = parse_int(list_get(fn_res, 0));
                str_c = list_get(fn_res, 1);
                str_t = list_get(fn_res, 2);
            }
        } else if k == "KW_TYPE" {
            pos = llvm_emit_type_decl(toks, pos, n);
        } else if k == "KW_VERIFY" {
            pos = llvm_skip_verify(toks, pos, n);
        } else if k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
    // Globals may appear after functions in LLVM IR; declare @.str.N here.
    llvm_emit_str_pool(str_t);
}
