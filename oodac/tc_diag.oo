// # Print a type error and exit
//
// Logline: Prints a tab-separated type error at LINE:COL and exits the process.
//
// Setup: field_at, list_len, list_get, println, and process_exit exist; token field 1 is line and field 2 is column.
//
// Beats:
//   1. Print ERR type Type error at LINE:COL: msg from given line, col, and msg, then process_exit(1).
//   2. When the token index is in range, read LINE:COL from fields 1 and 2.
//   3. Out-of-range index keeps 0:0; both helpers share tc_err_lc.
//
// residual: Issue #9 multi-module — load_import concatenates imported
// files into one expanded source, so lexer line numbers are expanded-
// stream offsets, not per-file local lines. Full per-file line/path
// needs load_import (or tokenize-per-file) change. Single-file checks
// (no imports expanded) already report local lines — path A floor.

pub fn tc_err_lc(line: String, col: String, msg: String) {
    println("ERR\ttype\tType error at " + line + ":" + col + ": " + msg);
    process_exit(1);
}

pub fn tc_err_at(toks: List[String], i: Int, msg: String) {
    let mut line = "0";
    let mut col = "0";
    let n = list_len(toks);
    if i >= 0 {
        if i < n {
            let tok = list_get(toks, i);
            line = field_at(tok, 1);
            col = field_at(tok, 2);
        }
    }
    tc_err_lc(line, col, msg);
}
