// # Detect const if INT != INT println with no else
//
// Logline: Returns the then STRING when a function body is only if INT NEQ INT with one println(STRING) and no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if INT NEQ INT then one println(STRING) branch and the function RBRACE.
//   3. Return the then STRING only when left != right. IDENT operands miss.
//
// residual: if 1 != x no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wnq_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wnq_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wnq_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wnq_kind(toks, p) != "IDENT" || wnq_text(toks, p) != "println" { return empty; }
    if wnq_kind(toks, p + 1) != "LPAREN" || wnq_kind(toks, p + 2) != "STRING" { return empty; }
    if wnq_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wnq_text(toks, p + 2);
    p = p + 4;
    if p < n && wnq_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_if_neq_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wnq_kind(toks, i) == "KW_FN" && wnq_kind(toks, i + 1) == "IDENT" {
            if wnq_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wnq_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 4 >= n || wnq_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                if p >= n || wnq_kind(toks, p) != "INT" { return ""; }
                let left: Int = parse_int(wnq_text(toks, p));
                p = p + 1;
                if p >= n || wnq_kind(toks, p) != "NEQ" { return ""; }
                p = p + 1;
                if p >= n || wnq_kind(toks, p) != "INT" { return ""; }
                let right: Int = parse_int(wnq_text(toks, p));
                p = p + 1;
                if p >= n || wnq_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wnq_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wnq_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wnq_kind(toks, p) != "RBRACE" { return ""; }
                if left != right { return list_get(th, 0); }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
