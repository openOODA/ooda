// # List Values Verification
//
// Logline: Verifies list value transformations and push operations.
//
// Setup: Direct list values verification.
//
// Beats:
//   1. Assert list element mutations and lengths.

import "wasm_emit_interp_list.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut xs = list_new(); xs = list_push(xs, 10); xs = list_push(xs, 20); xs = list_push(xs, 30); println(list_get(xs, 0)); println(list_get(xs, 1)); println(index_get(xs, 2)); println(xs[0]); println(xs[1]); println(xs[2]); }";
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    // find lb
    let mut i: Int = 0;
    let mut lb: Int = -1;
    while i < n {
        if wi_kind(toks, i) == "LBRACE" { lb = i; break; }
        i = i + 1;
    }
    if lb < 0 { println("no lb"); return; }
    let vals: List[String] = wi_list_values(toks, n, lb, n, "xs");
    println("vals len:" + list_len(vals).to_string());
    let mut j: Int = 0;
    while j < list_len(vals) {
        println("val:" + list_get(vals, j));
        j = j + 1;
    }
    let lenStr: String = wi_try_list_len(toks, 15, n, lb);
    println("lenStr:" + lenStr);
    let get0: String = wi_try_list_get(toks, 18, n, lb);
    println("get0:" + get0);
}
