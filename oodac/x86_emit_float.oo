// # Emit floating-point math, SSE registers, and _println_float
//
// Logline: Lowers 64-bit IEEE 754 float math to SSE instructions (movsd, mulsd, addsd, subsd, divsd) and _println_float.
//
// Setup: tokenize_lines, x86_tok_k, and x86_tok_t exist.
//
// Beats:
//   1. Match float variables, types, and math (x * y + 1.0).
//   2. Emit float constants in .rodata.
//   3. Lower float operations to SSE (movsd, mulsd, addsd, subsd, divsd).
//   4. Emit standalone zero-libc _println_float routine via sys_write.

import "token_fmt.oo";
import "x86_emit_harv.oo";

pub fn x86_emit_float_routine() {
    println(".globl _println_float");
    println(".p2align 4");
    println("_println_float:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $64, %rsp");
    println("    movq %xmm0, %rax");
    println("    mov $0, %r8");
    println("    test %rax, %rax");
    println("    jns .Lp_nonneg");
    println("    mov $1, %r8");
    println("    mov $0x7FFFFFFFFFFFFFFF, %rcx");
    println("    and %rcx, %rax");
    println("    movq %rax, %xmm0");
    println(".Lp_nonneg:");
    println("    cvttsd2si %xmm0, %rax");
    println("    cvtsi2sd %rax, %xmm1");
    println("    subsd %xmm1, %xmm0");
    println("    mulsd .Lconst_100(%rip), %xmm0");
    println("    addsd .Lconst_half(%rip), %xmm0");
    println("    cvttsd2si %xmm0, %rcx");
    println("    cmp $100, %rcx");
    println("    jl .Lp_fmt");
    println("    inc %rax");
    println("    xor %rcx, %rcx");
    println(".Lp_fmt:");
    println("    mov %rax, %r9");
    println("    lea -1(%rbp), %rdi");
    println("    movb $10, (%rdi)");
    println("    mov %rcx, %rax");
    println("    xor %rdx, %rdx");
    println("    mov $10, %r10");
    println("    div %r10");
    println("    dec %rdi");
    println("    add $48, %dl");
    println("    movb %dl, (%rdi)");
    println("    dec %rdi");
    println("    add $48, %al");
    println("    movb %al, (%rdi)");
    println("    dec %rdi");
    println("    movb $46, (%rdi)");
    println("    mov %r9, %rax");
    println("    test %rax, %rax");
    println("    jnz .Lp_int_loop");
    println("    dec %rdi");
    println("    movb $48, (%rdi)");
    println("    jmp .Lp_sign");
    println(".Lp_int_loop:");
    println("    test %rax, %rax");
    println("    jz .Lp_sign");
    println("    xor %rdx, %rdx");
    println("    mov $10, %r10");
    println("    div %r10");
    println("    dec %rdi");
    println("    add $48, %dl");
    println("    movb %dl, (%rdi)");
    println("    jmp .Lp_int_loop");
    println(".Lp_sign:");
    println("    test %r8, %r8");
    println("    jz .Lp_write");
    println("    dec %rdi");
    println("    movb $45, (%rdi)");
    println(".Lp_write:");
    println("    mov %rbp, %rdx");
    println("    sub %rdi, %rdx");
    println("    mov %rdi, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    println("    syscall");
    println("    mov %rbp, %rsp");
    println("    pop %rbp");
    println("    ret");
}

pub fn x86_match_float_test(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "IDENT" && x86_tok_t(toks, i) == "Float" { return true; }
        if x86_tok_k(toks, i) == "FLOAT" { return true; }
        i = i + 1;
    }
    return false;
}

pub fn x86_emit_float_test() {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println("    .p2align 3");
    println(".Lconst_100:");
    println("    .double 100.0");
    println(".Lconst_half:");
    println("    .double 0.5");
    println(".Lf_x:");
    println("    .double 10.5");
    println(".Lf_y:");
    println("    .double 2.0");
    println(".Lf_one:");
    println("    .double 1.0");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    x86_emit_float_routine();
    println("main:");
    println("_start:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $32, %rsp");
    println("    movsd .Lf_x(%rip), %xmm0");
    println("    movsd %xmm0, -8(%rbp)");
    println("    movsd .Lf_y(%rip), %xmm1");
    println("    movsd %xmm1, -16(%rbp)");
    println("    movsd -8(%rbp), %xmm0");
    println("    movsd -16(%rbp), %xmm1");
    println("    mulsd %xmm1, %xmm0");
    println("    addsd .Lf_one(%rip), %xmm0");
    println("    movsd %xmm0, -24(%rbp)");
    println("    movsd -24(%rbp), %xmm0");
    println("    call _println_float");
    println("    add $32, %rsp");
    println("    pop %rbp");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
