// package: backend-llvm — block { … } lowering
// stage: emit

pub fn llvm_emit_block(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p: Int = pos;
    let mut cur_env: List[String] = env;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        cur_env = llvm_env_push_scope(cur_env);
        
        p = p + 1;
    }

    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            cur_env = llvm_emit_ret_arc(cur_env);
            p = p + 1;
            break;
        }
        let st_res: List[String] = llvm_emit_stmt(toks, p, n, cur_env);
        p = parse_int(list_get(st_res, 0));
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(st_res, 1));
        cur_env = list_push(cur_env, list_get(st_res, 2));
        cur_env = list_push(cur_env, list_get(st_res, 3));
        cur_env = list_push(cur_env, list_get(st_res, 4));
        cur_env = list_push(cur_env, list_get(st_res, 5));
    }

    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
