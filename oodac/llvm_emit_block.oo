// # Lower a brace block to LLVM
//
// Logline: Walks statements inside a brace block, keeps the five-slot LLVM env in step, and returns the token after the close plus that env.
//
// Setup: field_at, list_get, list_push, list_new, and parse_int exist; llvm_env_push_scope, llvm_emit_ret_arc, and llvm_emit_stmt live in sibling emit files; toks rows start with kind; env is the five-slot LLVM emit env.
//
// Beats:
//   1. On LBRACE, push a scope and step past the brace.
//   2. Emit each statement until RBRACE and rebuild the env from the five slots the statement returns.
//   3. On RBRACE, emit return-arc cleanup unless the block already returned, then pack pos plus env.

import "llvm_emit_arc.oo";

pub fn llvm_emit_block(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos;
    let mut cur_env: List[String] = env;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        cur_env = llvm_env_push_scope(cur_env);
        
        p = p + 1;
    }

    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            // return already emitted ret + ARC. Do not emit after ret.
            if !llvm_env_vars_has(list_get(cur_env, 3), "__did_ret__") {
                cur_env = llvm_emit_scope_exit(cur_env);
            }
            p = p + 1;
            break;
        }
        let st_res: List[String] = llvm_emit_stmt(toks, p, n, cur_env);
        p = parse_int(list_get(st_res, 0));
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(st_res, 1));
        cur_env = list_push(cur_env, list_get(st_res, 2));
        cur_env = list_push(cur_env, list_get(st_res, 3));
        cur_env = list_push(cur_env, list_get(st_res, 4));
        cur_env = list_push(cur_env, list_get(st_res, 5));
    }

    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
