import "wasm_emit_interp.oo";
pub fn main() {
    let src: String = "// # Count in a while\npub fn main() { let mut i = 0; while i < 3 { i = i + 1; } let flag = true; if flag == true {} let y = if i > 5 { 9 } else if i > 2 { i } else { 0 }; println(y); }";
    let out: String = wasm_interp_main(src);
    println("wasm:" + out + ":end");
    println(out);
}
