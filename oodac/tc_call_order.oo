// # Check order compares on zero-arg calls
//
// Logline: Walks tokens and fail-closes when a zero-arg call is compared to a literal with a mismatched numeric type.
//
// Setup: build_fn_ret_table, lit_token_type, resolve_type_alias, field_at, println, and process_exit exist; type aliases come from type Name = Ident; only LT, GT, LTE, and GTE are checked.
//
// Beats:
//   1. Build the return table and a tab-separated type-alias map.
//   2. On an order token, match IDENT() ORD LIT and LIT ORD IDENT() when the call's resolved return type is known.
//   3. Both sides must be Int or both Float; otherwise print a Type error and process_exit(1).

pub fn typecheck_call_order_lits(toks: List[String]) {
    let n = list_len(toks);
    let ret_table: String = build_fn_ret_table(toks);
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname: String = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let mut is_ord = false;
        if k == "LT" {
            is_ord = true;
        } else if k == "GT" {
            is_ord = true;
        } else if k == "LTE" {
            is_ord = true;
        } else if k == "GTE" {
            is_ord = true;
        }
        if is_ord {
            // pattern: IDENT LPAREN RPAREN ORD LIT
            if i >= 3 {
                if field_at(list_get(toks, i - 3), 0) == "IDENT" {
                    if field_at(list_get(toks, i - 2), 0) == "LPAREN" {
                        if field_at(list_get(toks, i - 1), 0) == "RPAREN" {
                            if i + 1 < n {
                                let rty: String = lit_token_type(field_at(list_get(toks, i + 1), 0));
                                if rty != "" {
                                    let cname: String = field_at(list_get(toks, i - 3), 3);
                                    let got: String = resolve_type_alias(ret_table, cname);
                                    if got != cname {
                                        let gty: String = resolve_type_alias(aliases, got);
                                        let mut ok = false;
                                        if gty == "Int" {
                                            if rty == "Int" {
                                                ok = true;
                                            }
                                        }
                                        if gty == "Float" {
                                            if rty == "Float" {
                                                ok = true;
                                            }
                                        }
                                        if !ok {
                                            let line: String = field_at(list_get(toks, i), 1);
                                            let col: String = field_at(list_get(toks, i), 2);
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": comparison requires matching numeric types (both Int or both Float), found "
                                                    + gty
                                                    + " and "
                                                    + rty
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // pattern: LIT ORD IDENT LPAREN RPAREN
            if i > 0 {
                if i + 3 < n {
                    let lty: String = lit_token_type(field_at(list_get(toks, i - 1), 0));
                    if lty != "" {
                        if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                            if field_at(list_get(toks, i + 2), 0) == "LPAREN" {
                                if field_at(list_get(toks, i + 3), 0) == "RPAREN" {
                                    let cname: String = field_at(list_get(toks, i + 1), 3);
                                    let got: String = resolve_type_alias(ret_table, cname);
                                    if got != cname {
                                        let gty: String = resolve_type_alias(aliases, got);
                                        let mut ok = false;
                                        if lty == "Int" {
                                            if gty == "Int" {
                                                ok = true;
                                            }
                                        }
                                        if lty == "Float" {
                                            if gty == "Float" {
                                                ok = true;
                                            }
                                        }
                                        if !ok {
                                            let line: String = field_at(list_get(toks, i), 1);
                                            let col: String = field_at(list_get(toks, i), 2);
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": comparison requires matching numeric types (both Int or both Float), found "
                                                    + lty
                                                    + " and "
                                                    + gty
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Fail-closed: `g() == true` when g returns Int (zero-arg call vs pure lit).
