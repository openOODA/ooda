// job: type-driven main Cap grants (peel from c_emit_skip.oo)
// in:  encoded "name=suffix;name=suffix;"
// out: C grant statements on stdout
// stage: emit

// Names already declared by main ambient inject (legacy + CAP-G3 fixed set).
pub fn c_main_grant_ambient(name: String) -> Bool {
    if name == "fs" || name == "sys" || name == "env" || name == "net" { return true; }
    if name == "time" || name == "rand" || name == "alloc" || name == "ffi" { return true; }
    if name == "thread" || name == "gpu" { return true; }
    if name == "http" || name == "tcp" || name == "udp" || name == "bind" { return true; }
    if name == "fsread" || name == "fswrite" || name == "process" { return true; }
    if name == "sync" || name == "mem" || name == "sign" { return true; }
    if name == "audio" || name == "camera" || name == "usb" || name == "hid" { return true; }
    if name == "window" || name == "frame" { return true; }
    return false;
}

// CAP-G3: emit type-driven grants from encoded "name=suffix;name=suffix;".
// Ambient names rebind (type honesty); others declare long long (no undeclared C var).
pub fn c_emit_main_typed_cap_grants(mcap: String) {
    let mut mi: Int = 0;
    let mn: Int = chars_len(mcap);
    while mi < mn {
        let mut name = "";
        while mi < mn {
            let c = char_at(mcap, mi);
            if c == "=" {
                break;
            }
            name = name + c;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == "=" {
                mi = mi + 1;
            }
        }
        let mut suf = "";
        while mi < mn {
            let c2 = char_at(mcap, mi);
            if c2 == ";" {
                break;
            }
            suf = suf + c2;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == ";" {
                mi = mi + 1;
            }
        }
        if name != "" {
            if suf != "" {
                if c_main_grant_ambient(name) {
                    println("  " + name + " = oo_cap_grant_" + suf + "();");
                } else {
                    println("  long long " + name + " = oo_cap_grant_" + suf + "();");
                }
            }
        }
    }
}
