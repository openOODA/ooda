// # Emit type-driven main cap grants
//
// Logline: Walks an encoded name=suffix; map and prints C grant statements for each main cap.
//
// Setup: chars_len, char_at, and println exist; c_emit_fn captures mcap and calls c_emit_main_typed_cap_grants.
//
// Beats:
//   1. c_main_grant_ambient is true for the fixed ambient name set.
//   2. Split mcap on = and ; into name and suffix pairs.
//   3. Ambient names rebind with name = oo_cap_grant_suffix(); others declare long long.
//   4. c_cap_grant_suffix maps a cap type name to that suffix.

// Names already declared by main ambient inject (legacy + CAP-G3 fixed set).
pub fn c_main_grant_ambient(name: String) -> Bool {
    if name == "fs" || name == "sys" || name == "env" || name == "net" { return true; }
    if name == "time" || name == "rand" || name == "alloc" || name == "ffi" { return true; }
    if name == "thread" || name == "gpu" { return true; }
    if name == "http" || name == "tcp" || name == "udp" || name == "bind" { return true; }
    if name == "fsread" || name == "fswrite" || name == "process" { return true; }
    if name == "sync" || name == "mem" || name == "sign" { return true; }
    if name == "audio" || name == "camera" || name == "usb" || name == "hid" { return true; }
    if name == "window" || name == "frame" { return true; }
    return false;
}

// CAP-G3: emit type-driven grants from encoded "name=suffix;name=suffix;".
// Ambient names rebind (type honesty); others declare long long (no undeclared C var).
pub fn c_emit_main_typed_cap_grants(mcap: String) {
    let mut mi: Int = 0;
    let mn: Int = chars_len(mcap);
    while mi < mn {
        let mut name = "";
        while mi < mn {
            let c = char_at(mcap, mi);
            if c == "=" {
                break;
            }
            name = name + c;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == "=" {
                mi = mi + 1;
            }
        }
        let mut suf = "";
        while mi < mn {
            let c2 = char_at(mcap, mi);
            if c2 == ";" {
                break;
            }
            suf = suf + c2;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == ";" {
                mi = mi + 1;
            }
        }
        if name != "" {
            if suf != "" {
                if c_main_grant_ambient(name) {
                    println("  " + name + " = oo_cap_grant_" + suf + "();");
                } else {
                    println("  long long " + name + " = oo_cap_grant_" + suf + "();");
                }
            }
        }
    }
}

// CAP-G3: Ooda cap type → oo_cap_grant_<suffix> ("" if not a known grant).
pub fn c_cap_grant_suffix(tn: String) -> String {
    if tn == "HttpCap" { return "http"; }
    if tn == "TcpCap" { return "tcp"; }
    if tn == "UdpCap" { return "udp"; }
    if tn == "BindCap" { return "bind"; }
    if tn == "NetCap" { return "net"; }
    if tn == "FsReadCap" { return "fsread"; }
    if tn == "FsWriteCap" { return "fswrite"; }
    if tn == "FsCap" { return "fs"; }
    if tn == "SysCap" { return "sys"; }
    if tn == "EnvCap" { return "env"; }
    if tn == "TimeCap" { return "time"; }
    if tn == "RandCap" { return "rand"; }
    if tn == "AllocCap" { return "alloc"; }
    if tn == "MemCap" { return "mem"; }
    if tn == "UnsafeFFICap" || tn == "FfiCap" { return "ffi"; }
    if tn == "ThreadCap" { return "thread"; }
    if tn == "GpuCap" { return "gpu"; }
    if tn == "ProcessCap" { return "process"; }
    if tn == "SyncCap" { return "sync"; }
    if tn == "SignCap" { return "sign"; }
    if tn == "AudioCap" { return "audio"; }
    if tn == "CameraCap" { return "camera"; }
    if tn == "UsbCap" { return "usb"; }
    if tn == "HidCap" { return "hid"; }
    if tn == "WindowCap" { return "window"; }
    if tn == "FrameCap" { return "frame"; }
    return "";
}
