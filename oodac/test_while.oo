// # While Loop Interpretation Test
//
// Logline: Verifies while loop evaluation in interpreter.
//
// Setup: Direct while loop test.
//
// Beats:
//   1. Execute while loop iteration and assertions.

import "wasm_emit_interp_for.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut i = 0; while i < 3 { i = i + 1; } let flag = !(i == 0); let y = if i > 5 { 9 } else if i > 2 { i } else { 0 }; println(y); }";
    let out: String = wi_interp_for_main(src);
    println("out:" + out);
    println("len:" + chars_len(out).to_string());
}
