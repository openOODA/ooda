// # Simple List Verification
//
// Logline: Verifies fundamental list creation and retrieval.
//
// Setup: Direct list primitive verification.
//
// Beats:
//   1. Assert list creation and element indexing.

import "wasm_emit_interp_list.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut xs = list_new(); xs = list_push(xs, 10); xs = list_push(xs, 20); xs = list_push(xs, 30); println(list_get(xs, 0)); }";
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut lb: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if wi_kind(toks, i) == "LBRACE" { lb = i; break; }
        i = i + 1;
    }
    if lb < 0 { println("no lb"); return; }
    let vals: List[String] = wi_list_values(toks, n, lb, n, "xs");
    println("vals len:" + list_len(vals).to_string());
    let mut j: Int = 0;
    while j < list_len(vals) {
        println(list_get(vals, j));
        j = j + 1;
    }
    let g: String = wi_try_list_get(toks, 20, n, lb);
    println("get:" + g);
}
