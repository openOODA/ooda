// # Peek two-level list type kinds
//
// Logline: Reads List and List[List] type tokens and returns LF or LL_* kinds for later C names.
//
// Setup: Token stream sits on the outer List IDENT. field_at and list_get exist.
//
// Beats:
//   1. Reject a non-List token and default a bare List to S.
//   2. Map List[Float] to LF so F stays the Float scalar kind.
//   3. Map List[List[T]] to LL_I, LL_S, LL_F, or LL_Name and map a kind to its C type.
//
// residual: walkers still call c_peek_list_elem; deeper than two List layers is not peeked

fn c_list_leaf_kind(e: String) -> String {
    if e == "Int" {
        return "I";
    }
    if e == "String" {
        return "S";
    }
    if e == "Float" {
        return "F";
    }
    if e == "f64" {
        return "F";
    }
    return e;
}

// pos at type IDENT (e.g. List). Returns I, S, LF, LL_*, user name, or "".
pub fn c_peek_list_elem2(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "";
    }
    if field_at(list_get(toks, pos), 3) != "List" {
        return "";
    }
    let mut p: Int = pos + 1;
    if p >= n {
        return "S";
    }
    if field_at(list_get(toks, p), 0) != "LBRACKET" {
        return "S";
    }
    p = p + 1;
    if p >= n {
        return "S";
    }
    if field_at(list_get(toks, p), 0) != "IDENT" {
        return "S";
    }
    let e: String = field_at(list_get(toks, p), 3);
    if e == "List" {
        p = p + 1;
        if p >= n {
            return "LL_S";
        }
        if field_at(list_get(toks, p), 0) != "LBRACKET" {
            return "LL_S";
        }
        p = p + 1;
        if p >= n {
            return "LL_S";
        }
        if field_at(list_get(toks, p), 0) != "IDENT" {
            return "LL_S";
        }
        let e2: String = field_at(list_get(toks, p), 3);
        return "LL_" + c_list_leaf_kind(e2);
    }
    if e == "Float" {
        return "LF";
    }
    if e == "f64" {
        return "LF";
    }
    return c_list_leaf_kind(e);
}

pub fn c_is_ll_kind(k: String) -> Bool {
    if chars_len(k) < 4 {
        return false;
    }
    if char_at(k, 0) != "L" {
        return false;
    }
    if char_at(k, 1) != "L" {
        return false;
    }
    if char_at(k, 2) != "_" {
        return false;
    }
    return true;
}

pub fn c_reassign_nested_list(name: String, rhs: String) {
    println("  { OoLL_I __tmp = " + name + "; " + name + " = " + rhs + "; oo_ll_I_release(__tmp); }");
}

pub fn c_reassign_nested_kind(name: String, rhs: String, kind: String) {
    let suf: String = str_slice(kind, 3, chars_len(kind));
    let ty: String = "OoLL_" + suf;
    println("  { " + ty + " __tmp = " + name + "; " + name + " = " + rhs + "; oo_ll_" + suf + "_release(__tmp); }");
}

// C type for a list kind: I/S/LF → Oo*List, LL_I → OoLL_I, Name → OoL_Name.
pub fn c_list_kind_c_ty(k: String) -> String {
    if k == "I" {
        return "OoIList";
    }
    if k == "S" {
        return "OoSList";
    }
    if k == "F" {
        return "OoFList";
    }
    if k == "LF" {
        return "OoFList";
    }
    if chars_len(k) >= 4 {
        if char_at(k, 0) == "L" {
            if char_at(k, 1) == "L" {
                if char_at(k, 2) == "_" {
                    return "OoLL_" + str_slice(k, 3, chars_len(k));
                }
            }
        }
    }
    if k == "" {
        return "OoIList";
    }
    return "OoL_" + k;
}
