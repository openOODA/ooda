import "wasm_emit_add.oo";
import "wasm_emit_fold.oo";

pub fn main() {
    let s1: String = "pub fn main() { let x = 2; println(1 + x); }";
    let r1: String = wasm_fn_println_add(s1, "main");
    let s2: String = "pub fn main() { let x = 2; println(1 + x); }";
    let r2: String = wasm_fold_hello(s2);
    println("add=" + r1 + " fold=" + r2);
    if r1 == "3" && r2 == "3" { println("PASS"); } else { println("FAIL"); }
}
