// # Emit a WebAssembly binary from source
//
// Logline: Collects user fn names from tokens and writes a \0asm module with one dummy body per name.
//
// Setup: tokenize_lines walks src; oo_wasm_write_empty_module arms one dummy end body per call.
//
// Beats:
//   1. Tokenize the expanded source and count KW_FN rows.
//   2. Refuse a source with no function.
//   3. Arm the runtime writer once per user function so the code section is not empty.
//
// residual: each body is dummy end; WAT printers stay text; full expr lowering is not this product path.

import "token_fmt.oo";

fn wasm_collect_user_fn_names(src: String) -> List[String] {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    let mut names: List[String] = list_new();
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    names = list_push(names, field_at(list_get(toks, i + 1), 3));
                }
            }
        }
        i = i + 1;
    }
    return names;
}

pub fn wasm_emit_stream(src: String) {
    if chars_len(src) <= 0 {
        println("ERR\twasm\tempty");
        process_exit(1);
    }
    let names: List[String] = wasm_collect_user_fn_names(src);
    let n: Int = list_len(names);
    if n < 1 {
        println("ERR\twasm\tno_fn");
        process_exit(1);
    }
    let mut i = 0;
    while i < n {
        oo_wasm_write_empty_module();
        i = i + 1;
    }
}
