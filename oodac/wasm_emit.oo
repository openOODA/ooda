// # Emit a WebAssembly binary from source
//
// Logline: Collects user function names, notes each name, and sets a print body when the function is only a println literal.
//
// Setup: tokenize_lines walks src; oo_wasm_note_fn arms the flush; lit/ident/fold helpers live in sibling emit files.
//
// Beats:
//   1. Tokenize the expanded source and collect KW_FN ident names.
//   2. Refuse a source that is empty or has no function.
//   3. Note each fn; set a print body for lit, ident-let, strcat, two/three-println, int-lit, const-add, const-if, if-noelse, if-eq, or hello fold.
//
// residual: other functions keep dummy end; C emit stays the everyday path.

import "token_fmt.oo";
import "wasm_emit_lit.oo";
import "wasm_emit_ident.oo";
import "wasm_emit_fold.oo";
import "wasm_emit_strcat.oo";
import "wasm_emit_two.oo";
import "wasm_emit_three.oo";
import "wasm_emit_int.oo";
import "wasm_emit_add.oo";
import "wasm_emit_if.oo";
import "wasm_emit_if_noelse.oo";
import "wasm_emit_ifeq.oo";

fn wasm_collect_user_fn_names(src: String) -> List[String] {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    let mut names: List[String] = list_new();
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    names = list_push(names, field_at(list_get(toks, i + 1), 3));
                }
            }
        }
        i = i + 1;
    }
    return names;
}

pub fn wasm_emit_stream(src: String) {
    if chars_len(src) <= 0 {
        println("ERR\twasm\tempty");
        process_exit(1);
    }
    let names: List[String] = wasm_collect_user_fn_names(src);
    let n: Int = list_len(names);
    if n < 1 {
        println("ERR\twasm\tno_fn");
        process_exit(1);
    }
    let fold: String = wasm_fold_hello(src);
    let mut i = 0;
    while i < n {
        let name: String = list_get(names, i);
        oo_wasm_note_fn(name);
        if chars_len(fold) > 0 && name == "main" {
            oo_wasm_set_fn_print(fold);
        } else {
            let mut lit: String = wasm_fn_println_lit(src, name);
            if chars_len(lit) <= 0 {
                lit = wasm_fn_println_ident(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_println_strcat(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_two_println(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_three_println(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_println_int(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_println_add(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_if_println(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_if_noelse(src, name);
            }
            if chars_len(lit) <= 0 {
                lit = wasm_fn_if_eq(src, name);
            }
            if chars_len(lit) > 0 {
                oo_wasm_set_fn_print(lit);
            }
        }
        i = i + 1;
    }
}

