// # Emit a WebAssembly module from source
//
// Logline: Tokenizes source, prints the .wat preamble and string table, then walks tokens to emit each function and close the module.
//
// Setup: tokenize_lines and field_at exist; wasm_collect_strings, wasm_calc_heap_start, wasm_emit_preamble, wasm_emit_data_section, and wasm_emit_fn live in sibling files.
//
// Beats:
//   1. Tokenize src, collect string literals, compute heap start, and print preamble plus data.
//   2. Walk tokens: emit each pub or fn item; skip verify blocks, type lines, and import lines.
//   3. Print the closing module parenthesis.

import "token_fmt.oo";
import "wasm_emit_mem.oo";
import "wasm_emit_preamble.oo";
import "wasm_emit_primary.oo";
import "wasm_emit_expr.oo";
import "wasm_emit_stmt.oo";
import "wasm_emit_fn.oo";

fn wasm_skip_until_semi(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    while pos < n {
        if field_at(list_get(toks, pos), 0) == "SEMI" { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}

fn wasm_skip_balanced(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    let mut depth = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" { depth = depth + 1; }
        else if k == "RBRACE" {
            depth = depth - 1;
            if depth <= 0 { return pos + 1; }
        }
        pos = pos + 1;
    }
    return pos;
}

pub fn wasm_emit_stream(src: String) {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let str_tab: List[String] = wasm_collect_strings(toks, n);
    let heap_start = 0 + wasm_calc_heap_start(str_tab);
    wasm_emit_preamble(heap_start);
    wasm_emit_data_section(str_tab);
    let mut pos = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = wasm_emit_fn(toks, pos, n, str_tab);
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" { pos = pos + 1; }
            if pos < n && field_at(list_get(toks, pos), 0) == "LBRACE" { pos = wasm_skip_balanced(toks, pos); }
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = wasm_skip_until_semi(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
    println(")");
}
