// # Emit a WebAssembly binary module
//
// Logline: Writes a valid empty \0asm MVP module. Compiled source bytecode is residual.
//
// Setup: oo_wasm_write_empty_module lives in runtime/chs_rt_wasm.c and is in the preamble.
//
// Beats:
//   1. Product emit-wasm is a wasm binary (magic 00 61 73 6d).
//   2. The module is an empty _start hello header, not compiled src.
//   3. Sibling wasm_emit_* .wat printers stay residual text.

pub fn wasm_emit_stream(src: String) {
    if chars_len(src) < 0 {
        println("ERR\twasm\tempty");
        process_exit(1);
    }
    oo_wasm_write_empty_module();
}
