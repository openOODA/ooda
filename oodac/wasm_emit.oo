// # Emit a WebAssembly binary from source
//
// Logline: Collects user function names, notes each name, and sets a print body when the function is only a named const-print fold.
//
// Setup: tokenize_lines walks src; oo_wasm_note_fn arms the flush; print/if picks live in sibling files.
//
// Beats:
//   1. Tokenize the expanded source and collect KW_FN ident names.
//   2. Refuse a source that is empty or has no function.
//   3. Note each fn; set a print body for named const-print folds or hello fold.
//
// residual: other functions keep dummy end; C emit stays the everyday path.

import "token_fmt.oo";
import "wasm_emit_fold.oo";
import "wasm_emit_pick_print.oo";
import "wasm_emit_pick_if.oo";
import "wasm_emit_interp.oo";

fn wasm_collect_user_fn_names(src: String) -> List[String] {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    let mut names: List[String] = list_new();
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    names = list_push(names, field_at(list_get(toks, i + 1), 3));
                }
            }
        }
        i = i + 1;
    }
    return names;
}

pub fn wasm_emit_stream(src: String) {
    if chars_len(src) <= 0 {
        println("ERR\twasm\tempty");
        process_exit(1);
    }
    let names: List[String] = wasm_collect_user_fn_names(src);
    let n: Int = list_len(names);
    if n < 1 {
        println("ERR\twasm\tno_fn");
        process_exit(1);
    }
    let fold: String = wasm_fold_hello(src);
    let mut i = 0;
    while i < n {
        let name: String = list_get(names, i);
        oo_wasm_note_fn(name);
        if chars_len(fold) > 0 && name == "main" {
            oo_wasm_set_fn_print(fold);
        } else if name == "main" {
            let interp: String = wasm_interp_main(src);
            let mut is_multi: Bool = false;
            let mut trimmed_multi: String = "";
            let mut trimmed_single: String = "";
            if chars_len(interp) > 0 {
                let tlen: Int = chars_len(interp);
                let trimmed: String = if tlen > 0 && char_at(interp, tlen - 1) == "\n" { str_slice(interp, 0, tlen - 1) } else { interp };
                if chars_len(trimmed) > 0 {
                    let mut k: Int = 0;
                    let tn: Int = chars_len(trimmed);
                    while k < tn {
                        if char_at(trimmed, k) == "\n" { is_multi = true; k = tn; } else { k = k + 1; }
                    }
                    if is_multi {
                        trimmed_multi = trimmed;
                    } else {
                        trimmed_single = trimmed;
                    }
                }
            }
            let mut lit: String = wasm_try_print_fold(src, name);
            if chars_len(lit) <= 0 {
                lit = wasm_try_if_fold(src, name);
            }
            if chars_len(lit) > 0 {
                oo_wasm_set_fn_print(lit);
            } else if is_multi {
                oo_wasm_set_fn_print(trimmed_multi);
            } else if chars_len(trimmed_single) > 0 {
                oo_wasm_set_fn_print(trimmed_single);
            } else if chars_len(interp) > 0 {
                let tlen2: Int = chars_len(interp);
                let trimmed2: String = if tlen2 > 0 && char_at(interp, tlen2 - 1) == "\n" { str_slice(interp, 0, tlen2 - 1) } else { interp };
                if chars_len(trimmed2) > 0 { oo_wasm_set_fn_print(trimmed2); }
            }
        } else {
            let mut lit: String = wasm_try_print_fold(src, name);
            if chars_len(lit) <= 0 {
                lit = wasm_try_if_fold(src, name);
            }
            if chars_len(lit) > 0 {
                oo_wasm_set_fn_print(lit);
            }
        }
        i = i + 1;
    }
}
