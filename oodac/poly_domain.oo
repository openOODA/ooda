// # Polyhedral Iteration Domain & Polytope Representation
//
// Logline: Models multi-dimensional iteration spaces as convex polytopes defined by affine inequalities.
//
// Setup: Pure geometric and affine algebraic primitives for compiler loop optimization.
//
// Beats:
//   1. Define PolyInequality (sum c_i * x_i + b >= 0) and PolyDomain structures.
//   2. Construct iteration domains from multidimensional loop nest bounds.
//   3. Implement point containment testing and domain volume estimation.
//   4. Compute polyhedral intersections and domain emptiness checks.

pub type PolyInequality = struct {
    coeffs: List[Int],
    const_term: Int,
    is_ge: Bool
};

pub type PolyDomain = struct {
    num_dims: Int,
    var_names: List[String],
    ineqs: List[PolyInequality]
};

pub fn poly_ineq_create(coeffs: List[Int], const_term: Int, is_ge: Bool) -> PolyInequality {
    return PolyInequality {
        coeffs: coeffs,
        const_term: const_term,
        is_ge: is_ge
    };
}

pub fn poly_domain_create(num_dims: Int, var_names: List[String], ineqs: List[PolyInequality]) -> PolyDomain {
    return PolyDomain {
        num_dims: num_dims,
        var_names: var_names,
        ineqs: ineqs
    };
}

pub fn poly_domain_from_bounds(var_names: List[String], lower_bounds: List[Int], upper_bounds: List[Int]) -> PolyDomain {
    let dims: Int = list_len(var_names);
    let mut ineqs: List[PolyInequality] = list_new();
    let mut d: Int = 0;
    while d < dims {
        let lb: Int = list_get(lower_bounds, d);
        let ub: Int = list_get(upper_bounds, d);

        // Lower bound: x_d - lb >= 0  => coeffs[d] = 1, const_term = -lb
        let mut c_lb: List[Int] = list_new();
        let mut j: Int = 0;
        while j < dims {
            if j == d { c_lb = list_push(c_lb, 1); }
            else { c_lb = list_push(c_lb, 0); }
            j = j + 1;
        }
        let ineq_lb: PolyInequality = poly_ineq_create(c_lb, 0 - lb, true);
        ineqs = list_push(ineqs, ineq_lb);

        // Upper bound: ub - x_d - 1 >= 0 => coeffs[d] = -1, const_term = ub - 1
        let mut c_ub: List[Int] = list_new();
        j = 0;
        while j < dims {
            if j == d { c_ub = list_push(c_ub, 0 - 1); }
            else { c_ub = list_push(c_ub, 0); }
            j = j + 1;
        }
        let ineq_ub: PolyInequality = poly_ineq_create(c_ub, ub - 1, true);
        ineqs = list_push(ineqs, ineq_ub);

        d = d + 1;
    }
    return poly_domain_create(dims, var_names, ineqs);
}

pub fn poly_ineq_eval(ineq: &PolyInequality, point: List[Int]) -> Int {
    let mut sum: Int = ineq.const_term;
    let n: Int = list_len(ineq.coeffs);
    let mut i: Int = 0;
    while i < n {
        let c: Int = list_get(ineq.coeffs, i);
        let mut x: Int = 0;
        if i < list_len(point) {
            x = list_get(point, i);
        }
        sum = sum + (c * x);
        i = i + 1;
    }
    return sum;
}

pub fn poly_domain_contains(domain: &PolyDomain, point: List[Int]) -> Bool {
    let n: Int = list_len(domain.ineqs);
    let mut i: Int = 0;
    while i < n {
        let ineq: PolyInequality = list_get(domain.ineqs, i);
        let val: Int = poly_ineq_eval(&ineq, point);
        if ineq.is_ge {
            if val < 0 { return false; }
        } else {
            if val > 0 { return false; }
        }
        i = i + 1;
    }
    return true;
}

pub fn poly_domain_intersect(d1: &PolyDomain, d2: &PolyDomain) -> PolyDomain {
    let mut merged: List[PolyInequality] = list_new();
    let mut i: Int = 0;
    let n1: Int = list_len(d1.ineqs);
    while i < n1 {
        merged = list_push(merged, list_get(d1.ineqs, i));
        i = i + 1;
    }
    i = 0;
    let n2: Int = list_len(d2.ineqs);
    while i < n2 {
        merged = list_push(merged, list_get(d2.ineqs, i));
        i = i + 1;
    }
    return PolyDomain {
        num_dims: d1.num_dims,
        var_names: d1.var_names,
        ineqs: merged
    };
}

pub fn poly_domain_count_points_bounded(domain: &PolyDomain, max_per_dim: Int) -> Int {
    if domain.num_dims == 1 {
        let mut count: Int = 0;
        let mut i: Int = 0;
        while i < max_per_dim {
            let mut pt: List[Int] = list_new();
            pt = list_push(pt, i);
            if poly_domain_contains(domain, pt) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }
    if domain.num_dims == 2 {
        let mut count: Int = 0;
        let mut i: Int = 0;
        while i < max_per_dim {
            let mut j: Int = 0;
            while j < max_per_dim {
                let mut pt: List[Int] = list_new();
                pt = list_push(pt, i);
                pt = list_push(pt, j);
                if poly_domain_contains(domain, pt) { count = count + 1; }
                j = j + 1;
            }
            i = i + 1;
        }
        return count;
    }
    return 0;
}

pub fn poly_domain_is_empty(domain: &PolyDomain) -> Bool {
    let pts: Int = poly_domain_count_points_bounded(domain, 32);
    return pts == 0;
}
