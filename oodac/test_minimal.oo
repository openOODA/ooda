// # Probe skip after a return type
//
// Logline: Tokenize a tiny fn with an ARROW return type, print the C type, skip it, and print the next token.
//
// Setup: token_fmt, lex, token_stream, and c_emit_skip are imported; tokenize_lines, field_at, c_ty_at, and c_emit_skip_type exist.
//
// Beats:
//   1. Tokenize "pub fn foo() -> String {}".
//   2. Jump p to the ARROW token, print its kind, then c_ty_at and skip the type.
//   3. Print the index and kind after the skip.

import "token_fmt.oo";
import "lex.oo";
import "token_stream.oo";
import "c_emit_skip.oo";

pub fn main() {
    let src = "pub fn foo() -> String {}";
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut p = 0;
    
    p = 3;
    p = 5;
    
    println("At ARROW: token is " + field_at(list_get(toks, p), 0));
    
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            let ret_ty: String = c_ty_at(toks, p, n);
            println("ret_ty = " + ret_ty);
            p = c_emit_skip_type(toks, p, n);
        }
    }
    
    println("After skip_type: p is " + p.to_string() + " token is " + field_at(list_get(toks, p), 0));
}
