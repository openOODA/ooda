// # Fail closed on unused Result and missing return
//
// Logline: Reject Ok, Err, or Some used as a bare statement, and reject a non-Void function whose body has no return.
//
// Setup: field_at, list_get, list_len, println, and process_exit exist; toks rows are kind, line, col, text.
//
// Beats:
//   1. On IDENT Ok, Err, or Some followed by LPAREN, skip when the previous token is EQ or return.
//   2. When the matching RPAREN is followed by SEMI, print unused must-use and exit.
//   3. On KW_FN with ARROW to a non-Void IDENT, scan the body for KW_RETURN; a miss prints and exits.

pub fn typecheck_must_use_result(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            let name: String = field_at(list_get(toks, i), 3);
            if name == "Ok" || name == "Err" || name == "Some" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                        // skip if assigned: IDENT EQ Ok  or let ... = Ok
                        let mut assigned = false;
                        if i > 0 {
                            let pk: String = field_at(list_get(toks, i - 1), 0);
                            if pk == "EQ" || pk == "RETURN" || pk == "KW_RETURN" {
                                assigned = true;
                            }
                        }
                        // find if this call ends with SEMI as stmt: scan to matching RPAREN then SEMI
                        if !assigned {
                            let mut p = i + 1;
                            let mut depth = 0;
                            let mut cont = true;
                            while cont {
                                if p >= n {
                                    cont = false;
                                } else {
                                    let kk: String = field_at(list_get(toks, p), 0);
                                    if kk == "LPAREN" {
                                        depth = depth + 1;
                                    }
                                    if kk == "RPAREN" {
                                        depth = depth - 1;
                                        if depth == 0 {
                                            if p + 1 < n {
                                                if field_at(list_get(toks, p + 1), 0) == "SEMI" {
                                                    let line: String = field_at(list_get(toks, i), 1);
                                                    let col: String = field_at(list_get(toks, i), 2);
                                                    println(
                                                        "ERR\ttype\tType error at "
                                                            + line
                                                            + ":"
                                                            + col
                                                            + ": unused "
                                                            + name
                                                            + " value (must-use)"
                                                    );
                                                    process_exit(1);
                                                }
                                            }
                                            cont = false;
                                        }
                                    }
                                    p = p + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Fail if fn has `-> NonVoid` and body has no `return` (R1 incomplete: no if-path analysis).
pub fn typecheck_missing_return(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            let mut j = i + 1;
            let mut fname = "";
            if j < n {
                if field_at(list_get(toks, j), 0) == "IDENT" {
                    fname = field_at(list_get(toks, j), 3);
                    j = j + 1;
                }
            }
            let mut ret = "";
            let mut saw_arrow = false;
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk: String = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        saw_arrow = true;
                        j = j + 1;
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                ret = field_at(list_get(toks, j), 3);
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            // j at LBRACE
            if saw_arrow {
                if ret != "" {
                    if ret != "Void" {
                        // scan body until matching RBRACE for KW_RETURN
                        let mut depth = 0;
                        let mut p = j;
                        let mut has_ret = false;
                        let mut contb = true;
                        while contb {
                            if p >= n {
                                contb = false;
                            } else {
                                let bk: String = field_at(list_get(toks, p), 0);
                                if bk == "LBRACE" {
                                    depth = depth + 1;
                                }
                                if bk == "RBRACE" {
                                    depth = depth - 1;
                                    if depth == 0 {
                                        contb = false;
                                    }
                                }
                                if bk == "KW_RETURN" {
                                    if depth >= 1 {
                                        has_ret = true;
                                    }
                                }
                                p = p + 1;
                            }
                        }
                        if !has_ret {
                            let line: String = field_at(list_get(toks, i), 1);
                            let col: String = field_at(list_get(toks, i), 2);
                            println(
                                "ERR\ttype\tType error at "
                                    + line
                                    + ":"
                                    + col
                                    + ": function '"
                                    + fname
                                    + "' missing return (declared "
                                    + ret
                                    + ")"
                            );
                            process_exit(1);
                        }
                        i = p;
                    } else {
                        i = i + 1;
                    }
                } else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
}

// Encode "\tfname=N\t" for arity table (no heap maps).
