// # Fail-closed Result unwrap for call?
//
// Logline: Extracts the Ok payload of a Result and exits if the tag is Err.
//
// Setup: Called from Pratt after a QUESTION token. Product IR already defines @oo_process_exit.
//
// Beats:
//   1. Require a known Result compound.
//   2. Branch on the ok tag.
//   3. Exit on Err; yield the Ok payload type of that compound.

import "llvm_emit_env.oo";

pub fn llvm_emit_try(recv: String, rty: String, env: List[String]) -> List[String] {
    if rty != "%OoResI" && rty != "%OoResS" && rty != "%OoResB" && rty != "%OoResF" {
        println("ERR\tllvm_emit\ttry residual");
        process_exit(1);
    }
    let mut cur_env: List[String] = env;
    let g1: List[String] = llvm_gen_reg(cur_env);
    let tag: String = list_get(g1, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(g1, 1));
    cur_env = list_push(cur_env, list_get(g1, 2));
    cur_env = list_push(cur_env, list_get(g1, 3));
    cur_env = list_push(cur_env, list_get(g1, 4));
    cur_env = list_push(cur_env, list_get(g1, 5));
    let g2: List[String] = llvm_gen_reg(cur_env);
    let ok1: String = list_get(g2, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(g2, 1));
    cur_env = list_push(cur_env, list_get(g2, 2));
    cur_env = list_push(cur_env, list_get(g2, 3));
    cur_env = list_push(cur_env, list_get(g2, 4));
    cur_env = list_push(cur_env, list_get(g2, 5));
    let ok_lr: List[String] = llvm_gen_label("bb_try_ok", cur_env);
    let lbl_ok: String = list_get(ok_lr, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(ok_lr, 1));
    cur_env = list_push(cur_env, list_get(ok_lr, 2));
    cur_env = list_push(cur_env, list_get(ok_lr, 3));
    cur_env = list_push(cur_env, list_get(ok_lr, 4));
    cur_env = list_push(cur_env, list_get(ok_lr, 5));
    let er_lr: List[String] = llvm_gen_label("bb_try_err", cur_env);
    let lbl_err: String = list_get(er_lr, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(er_lr, 1));
    cur_env = list_push(cur_env, list_get(er_lr, 2));
    cur_env = list_push(cur_env, list_get(er_lr, 3));
    cur_env = list_push(cur_env, list_get(er_lr, 4));
    cur_env = list_push(cur_env, list_get(er_lr, 5));
    println("  " + tag + " = extractvalue " + rty + " " + recv + ", 0");
    println("  " + ok1 + " = icmp ne i32 " + tag + ", 0");
    println("  br i1 " + ok1 + ", label %" + lbl_ok + ", label %" + lbl_err);
    println(lbl_err + ":");
    println("  call void @oo_process_exit(i64 1)");
    println("  unreachable");
    println(lbl_ok + ":");
    let gp: List[String] = llvm_gen_reg(cur_env);
    let pay: String = list_get(gp, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(gp, 1));
    cur_env = list_push(cur_env, list_get(gp, 2));
    cur_env = list_push(cur_env, list_get(gp, 3));
    cur_env = list_push(cur_env, list_get(gp, 4));
    cur_env = list_push(cur_env, list_get(gp, 5));
    let mut pty = "%OoStr";
    if rty == "%OoResI" { pty = "i64"; }
    if rty == "%OoResB" { pty = "i32"; }
    if rty == "%OoResF" { pty = "double"; }
    println("  " + pay + " = extractvalue " + rty + " " + recv + ", 1");
    let mut out: List[String] = list_new();
    out = list_push(out, pay);
    out = list_push(out, pty);
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
