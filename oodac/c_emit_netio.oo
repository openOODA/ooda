// package: backend-c — emit floor
// job: M166 NetCap free-name lowers (tcp/udp slots + sock_raw residual)
// stage: emit
// returns C call snippet, or "" if not a net free call

pub fn c_emit_netio_call(t: String, a0: String, a1: String, args: String) -> String {
    if t == "tcp_bind" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_bind requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_bind(" + a0 + ", " + a1 + ")";
    }
    if t == "tcp_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_connect(" + args + ")";
    }
    if t == "bind_udp" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tbind_udp requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_bind_udp(" + a0 + ", " + a1 + ")";
    }
    if t == "tls_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttls_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tls_connect(" + args + ")";
    }
    // process-local fd slots: connect/bind → Ok("fd:N"); IO by Int slot
    if t == "tcp_write" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_write requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_write(" + args + ")";
    }
    if t == "tcp_read" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_read requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_read(" + args + ")";
    }
    if t == "udp_recv" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tudp_recv requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_udp_recv(" + args + ")";
    }
    if t == "tcp_close" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_close requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_close(" + a0 + ", " + a1 + ")";
    }
    if t == "sock_raw" || t == "raw_socket" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsock_raw requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_sock_raw(" + args + ")";
    }
    return "";
}
