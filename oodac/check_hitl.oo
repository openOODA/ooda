// job: HITL non-interactive deny-mode (path A product); stage: check
// in: source String; out: ERR+exit if // HITL: pause present
// residual: interactive harness / agent pause-resume / OODA_HITL_ALLOW product flag

// Line-start // HITL: pause → fail-closed in product check (CI deny-mode).
pub fn check_hitl_deny(src: String) {
    let n = chars_len(src);
    let mut i = 0;
    let mut line_start = true;
    while i < n {
        let c: String = char_at(src, i);
        if c == "\n" {
            line_start = true;
            i = i + 1;
        } else if line_start {
            // skip leading spaces/tabs
            if c == " " || c == "\t" {
                i = i + 1;
            } else if c == "/" {
                // // HITL: pause
                if i + 1 < n {
                    if char_at(src, i + 1) == "/" {
                        let rest: String = str_slice(src, i, n);
                        // match // HITL: pause (spaces flexible after //)
                        if diag_find_hitl_pause(rest) {
                            println(
                                "ERR\thitl\tnon-interactive deny: // HITL: pause is product deny-mode at check; interactive harness residual (HITL.md)"
                            );
                            process_exit(1);
                        }
                    }
                }
                line_start = false;
                i = i + 1;
            } else {
                line_start = false;
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
}

fn diag_find_hitl_pause(s: String) -> Bool {
    // s starts at //
    let n = chars_len(s);
    if n < 12 {
        return false;
    }
    if str_slice(s, 0, 2) != "//" {
        return false;
    }
    let mut i = 2;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    // HITL:
    if i + 5 > n {
        return false;
    }
    if str_slice(s, i, i + 5) != "HITL:" {
        return false;
    }
    i = i + 5;
    while i < n {
        let c2: String = char_at(s, i);
        if c2 == " " || c2 == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    if i + 5 > n {
        return false;
    }
    if str_slice(s, i, i + 5) == "pause" {
        return true;
    }
    return false;
}
