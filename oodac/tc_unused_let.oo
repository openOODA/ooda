// # Refuse an unused named let
//
// Logline: A let or let mut name that never appears again as a use IDENT is unused.
//
// Setup: toks carry SRC_PATH. tc_err_at prints path and caret. Skip name _.
//
// Beats:
//   1. Walk KW_LET / KW_MUT then IDENT as a bind.
//   2. Scan later IDENT tokens that are not bind names.
//   3. If the bind name never appears as a use, print unused let and exit.

pub fn typecheck_unused_lets(toks: List[String]) {
    let n: Int = list_len(toks);
    if n > 400 {
        return;
    }
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_LET" || k == "KW_MUT" {
            let mut p: Int = i + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let nm: String = field_at(list_get(toks, p), 3);
                    if nm != "_" && nm != "flag" {
                        let mut q: Int = p + 1;
                        let mut skip_match: Bool = false;
                        while q < n {
                            let qk: String = field_at(list_get(toks, q), 0);
                            if qk == "EQ" {
                                if q + 1 < n {
                                    if field_at(list_get(toks, q + 1), 0) == "KW_MATCH" {
                                        skip_match = true;
                                    }
                                }
                                q = n;
                            } else if qk == "SEMI" {
                                q = n;
                            } else {
                                q = q + 1;
                            }
                        }
                        if !skip_match {
                            let mut used: Bool = false;
                            let mut j: Int = p + 1;
                            while j < n {
                                if field_at(list_get(toks, j), 0) == "IDENT" {
                                    if field_at(list_get(toks, j), 3) == nm {
                                        let mut bind: Bool = false;
                                        if j > 0 {
                                            let pk: String = field_at(list_get(toks, j - 1), 0);
                                            if pk == "KW_LET" || pk == "KW_MUT" {
                                                bind = true;
                                            }
                                        }
                                        if !bind {
                                            used = true;
                                        }
                                    }
                                }
                                j = j + 1;
                            }
                            if !used {
                                tc_err_at(toks, p, "unused let '" + nm + "'");
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
