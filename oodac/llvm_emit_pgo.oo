// # Emit LLVM PGO branch weights and llvm.expect intrinsics
//
// Logline: Lowers profile-guided branch weights metadata and llvm.expect intrinsics for hot loops and capability check branches.
//
// Setup: println, list operations, string helpers, and LLVM emit environment exist.
//
// Beats:
//   1. Declare llvm.expect intrinsics for i1, i32, and i64.
//   2. Lower llvm.expect calls for hot loop conditions and capability check outcomes.
//   3. Lower !prof branch weight metadata tags for hot/cold conditional branches.
//   4. Emit the profile branch weights metadata pool for the module.

import "token_fmt.oo";
import "llvm_emit_env.oo";

pub fn llvm_pgo_expect_declares() {
    println("declare i1 @llvm.expect.i1(i1, i1)");
    println("declare i32 @llvm.expect.i32(i32, i32)");
    println("declare i64 @llvm.expect.i64(i64, i64)");
}

pub fn llvm_pgo_hot_weight() -> Int {
    return 10000;
}

pub fn llvm_pgo_cold_weight() -> Int {
    return 1;
}

pub fn llvm_pgo_branch_weight_tag(node_id: Int) -> String {
    return ", !prof !" + node_id.to_string();
}

pub fn llvm_pgo_loop_weight_tag() -> String {
    return ", !prof !0";
}

pub fn llvm_pgo_cap_weight_tag() -> String {
    return ", !prof !1";
}

pub fn llvm_pgo_expect_i1(cond_reg: String, expected: Int, env: List[String]) -> List[String] {
    let r_res: List[String] = llvm_gen_reg(env);
    let exp_reg: String = list_get(r_res, 0);
    let mut new_env: List[String] = list_new();
    new_env = list_push(new_env, list_get(r_res, 1));
    new_env = list_push(new_env, list_get(r_res, 2));
    new_env = list_push(new_env, list_get(r_res, 3));
    new_env = list_push(new_env, list_get(r_res, 4));
    new_env = list_push(new_env, list_get(r_res, 5));
    let exp_str: String = expected.to_string();
    println("  " + exp_reg + " = call i1 @llvm.expect.i1(i1 " + cond_reg + ", i1 " + exp_str + ")");
    let mut out: List[String] = list_new();
    out = list_push(out, exp_reg);
    out = list_push(out, list_get(new_env, 0));
    out = list_push(out, list_get(new_env, 1));
    out = list_push(out, list_get(new_env, 2));
    out = list_push(out, list_get(new_env, 3));
    out = list_push(out, list_get(new_env, 4));
    return out;
}

pub fn llvm_pgo_expect_i64(val_reg: String, expected: Int, env: List[String]) -> List[String] {
    let r_res: List[String] = llvm_gen_reg(env);
    let exp_reg: String = list_get(r_res, 0);
    let mut new_env: List[String] = list_new();
    new_env = list_push(new_env, list_get(r_res, 1));
    new_env = list_push(new_env, list_get(r_res, 2));
    new_env = list_push(new_env, list_get(r_res, 3));
    new_env = list_push(new_env, list_get(r_res, 4));
    new_env = list_push(new_env, list_get(r_res, 5));
    let exp_str: String = expected.to_string();
    println("  " + exp_reg + " = call i64 @llvm.expect.i64(i64 " + val_reg + ", i64 " + exp_str + ")");
    let mut out: List[String] = list_new();
    out = list_push(out, exp_reg);
    out = list_push(out, list_get(new_env, 0));
    out = list_push(out, list_get(new_env, 1));
    out = list_push(out, list_get(new_env, 2));
    out = list_push(out, list_get(new_env, 3));
    out = list_push(out, list_get(new_env, 4));
    return out;
}

pub fn llvm_pgo_expect_loop(cond_reg: String, env: List[String]) -> List[String] {
    return llvm_pgo_expect_i1(cond_reg, 1, env);
}

pub fn llvm_pgo_expect_cap(cond_reg: String, env: List[String]) -> List[String] {
    return llvm_pgo_expect_i1(cond_reg, 1, env);
}

pub fn llvm_pgo_emit_loop_branch(cond_reg: String, lbl_body: String, lbl_end: String) {
    println("  br i1 " + cond_reg + ", label %" + lbl_body + ", label %" + lbl_end + ", !prof !0");
}

pub fn llvm_pgo_emit_cap_branch(cond_reg: String, lbl_ok: String, lbl_trap: String) {
    println("  br i1 " + cond_reg + ", label %" + lbl_ok + ", label %" + lbl_trap + ", !prof !1");
}

pub fn llvm_pgo_metadata_node(node_id: Int, taken: Int, not_taken: Int) -> String {
    return "!" + node_id.to_string() + " = !{!\"branch_weights\", i32 " + taken.to_string() + ", i32 " + not_taken.to_string() + "}\n";
}

pub fn llvm_emit_pgo_pool(hot_weight: Int, cold_weight: Int) {
    println("; --- PGO Branch Weights Metadata ---");
    let hw_s: String = hot_weight.to_string();
    let cw_s: String = cold_weight.to_string();
    println("!0 = !{!\"branch_weights\", i32 " + hw_s + ", i32 " + cw_s + "}");
    println("!1 = !{!\"branch_weights\", i32 " + hw_s + ", i32 " + cw_s + "}");
    println("!2 = !{!\"branch_weights\", i32 " + cw_s + ", i32 " + hw_s + "}");
}

pub fn llvm_pgo_emit_hot_while_branch(cond_reg: String, lbl_body: String, lbl_end: String, env: List[String]) -> List[String] {
    let exp_res: List[String] = llvm_pgo_expect_loop(cond_reg, env);
    let exp_reg: String = list_get(exp_res, 0);
    let mut cur_env: List[String] = list_new();
    cur_env = list_push(cur_env, list_get(exp_res, 1));
    cur_env = list_push(cur_env, list_get(exp_res, 2));
    cur_env = list_push(cur_env, list_get(exp_res, 3));
    cur_env = list_push(cur_env, list_get(exp_res, 4));
    cur_env = list_push(cur_env, list_get(exp_res, 5));
    llvm_pgo_emit_loop_branch(exp_reg, lbl_body, lbl_end);
    return cur_env;
}

pub fn llvm_pgo_emit_hot_for_branch(cond_reg: String, lbl_body: String, lbl_end: String, env: List[String]) -> List[String] {
    let exp_res: List[String] = llvm_pgo_expect_loop(cond_reg, env);
    let exp_reg: String = list_get(exp_res, 0);
    let mut cur_env: List[String] = list_new();
    cur_env = list_push(cur_env, list_get(exp_res, 1));
    cur_env = list_push(cur_env, list_get(exp_res, 2));
    cur_env = list_push(cur_env, list_get(exp_res, 3));
    cur_env = list_push(cur_env, list_get(exp_res, 4));
    cur_env = list_push(cur_env, list_get(exp_res, 5));
    llvm_pgo_emit_loop_branch(exp_reg, lbl_body, lbl_end);
    return cur_env;
}

pub fn llvm_pgo_emit_cap_check(cap_val_reg: String, expected_mask: Int, lbl_ok: String, lbl_fail: String, env: List[String]) -> List[String] {
    let r1: List[String] = llvm_gen_reg(env);
    let and_reg: String = list_get(r1, 0);
    let mut e1: List[String] = list_new();
    e1 = list_push(e1, list_get(r1, 1));
    e1 = list_push(e1, list_get(r1, 2));
    e1 = list_push(e1, list_get(r1, 3));
    e1 = list_push(e1, list_get(r1, 4));
    e1 = list_push(e1, list_get(r1, 5));
    let mask_s: String = expected_mask.to_string();
    println("  " + and_reg + " = and i64 " + cap_val_reg + ", " + mask_s);

    let r2: List[String] = llvm_gen_reg(e1);
    let cmp_reg: String = list_get(r2, 0);
    let mut e2: List[String] = list_new();
    e2 = list_push(e2, list_get(r2, 1));
    e2 = list_push(e2, list_get(r2, 2));
    e2 = list_push(e2, list_get(r2, 3));
    e2 = list_push(e2, list_get(r2, 4));
    e2 = list_push(e2, list_get(r2, 5));
    println("  " + cmp_reg + " = icmp eq i64 " + and_reg + ", " + mask_s);

    let exp_res: List[String] = llvm_pgo_expect_cap(cmp_reg, e2);
    let exp_cond: String = list_get(exp_res, 0);
    let mut cur_env: List[String] = list_new();
    cur_env = list_push(cur_env, list_get(exp_res, 1));
    cur_env = list_push(cur_env, list_get(exp_res, 2));
    cur_env = list_push(cur_env, list_get(exp_res, 3));
    cur_env = list_push(cur_env, list_get(exp_res, 4));
    cur_env = list_push(cur_env, list_get(exp_res, 5));
    llvm_pgo_emit_cap_branch(exp_cond, lbl_ok, lbl_fail);
    return cur_env;
}
