// job: control-flow branch typing; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_control_flow_branches(toks: List[String]) {
    let n: Int = list_len(toks);
    let lit_env: String = build_pure_lit_env(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_WHILE" {
            let mut lbrace1: Int = i + 1;
            while lbrace1 < n {
                if field_at(list_get(toks, lbrace1), 0) == "LBRACE" {
                    break;
                }
                lbrace1 = lbrace1 + 1;
            }
            if lbrace1 < n {
                let mut rbrace1: Int = skip_balanced(toks, lbrace1);
                if rbrace1 > 0 {
                    rbrace1 = rbrace1 - 1;
                    let ty1: Int = infer_typed_expr_type_exact(toks, lbrace1 + 1, rbrace1, lit_env);
                    if ty1 != "" {
                        let line: String = field_at(list_get(toks, i), 1);
                        let col: String = field_at(list_get(toks, i), 2);
                        println("ERR\ttype\tType error at " + line + ":" + col + ": while loop body must return Void, found " + ty1);
                        process_exit(1);
                    }
                }
            }
        }

        if k == "KW_IF" {
            // Find LBRACE
            let mut lbrace1: Int = i + 1;
            while lbrace1 < n {
                if field_at(list_get(toks, lbrace1), 0) == "LBRACE" {
                    break;
                }
                lbrace1 = lbrace1 + 1;
            }
            if lbrace1 < n {
                // Find RBRACE
                let mut rbrace1: Int = skip_balanced(toks, lbrace1);
                if rbrace1 > 0 {
                    rbrace1 = rbrace1 - 1; // points to RBRACE
                    if rbrace1 + 1 >= n {
                        let ty1: Int = infer_typed_expr_type_exact(toks, lbrace1 + 1, rbrace1, lit_env);
                        if ty1 != "" {
                            let line: String = field_at(list_get(toks, i), 1);
                            let col: String = field_at(list_get(toks, i), 2);
                            println("ERR\ttype\tType error at " + line + ":" + col + ": if expression without else must return Void, found " + ty1);
                            process_exit(1);
                        }
                    }
                    if rbrace1 + 1 < n {
                        if field_at(list_get(toks, rbrace1 + 1), 0) != "KW_ELSE" {
                            let ty1: Int = infer_typed_expr_type_exact(toks, lbrace1 + 1, rbrace1, lit_env);
                            if ty1 != "" {
                                let line: String = field_at(list_get(toks, i), 1);
                                let col: String = field_at(list_get(toks, i), 2);
                                println("ERR\ttype\tType error at " + line + ":" + col + ": if expression without else must return Void, found " + ty1);
                                process_exit(1);
                            }
                        }
                        if field_at(list_get(toks, rbrace1 + 1), 0) == "KW_ELSE" {
                            if rbrace1 + 2 < n {
                                if field_at(list_get(toks, rbrace1 + 2), 0) == "LBRACE" {
                                    let lbrace2: Int = rbrace1 + 2;
                                    let mut rbrace2: Int = skip_balanced(toks, lbrace2);
                                    if rbrace2 > 0 {
                                        rbrace2 = rbrace2 - 1; // points to RBRACE
                                        // Now we have both blocks. Let's find the last expression in each block.
                                        let ty1: Int = infer_typed_expr_type_exact(toks, lbrace1 + 1, rbrace1, lit_env);
                                        let ty2: Int = infer_typed_expr_type_exact(toks, lbrace2 + 1, rbrace2, lit_env);
                                        if ty1 != "" {
                                            if ty2 != "" {
                                                if ty1 != ty2 {
                                                    let line: String = field_at(list_get(toks, i), 1);
                                                    let col: String = field_at(list_get(toks, i), 2);
                                                    println("ERR\ttype\tType error at " + line + ":" + col + ": if/else branches have incompatible types: " + ty1 + " and " + ty2);
                                                    process_exit(1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

