// # Detect println of two or more string literals
//
// Logline: Returns the joined text when a function body is only println of a STRING plus-chain.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept println ( STRING (PLUS STRING)+ ) with optional semicolon, then RBRACE.
//   3. Join those STRING texts. An IDENT in the chain misses.
//
// residual: runtime concat stays dummy end. Not a full WASM backend.

import "token_fmt.oo";

fn ws_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn ws_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_strcat(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if ws_kind(toks, i) == "KW_FN" && ws_kind(toks, i + 1) == "IDENT" {
            if ws_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && ws_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 2 >= n {
                    return "";
                }
                if ws_kind(toks, p) != "IDENT" || ws_text(toks, p) != "println" {
                    return "";
                }
                if ws_kind(toks, p + 1) != "LPAREN" {
                    return "";
                }
                p = p + 2;
                if p >= n || ws_kind(toks, p) != "STRING" {
                    return "";
                }
                let mut joined: String = ws_text(toks, p);
                let mut parts: Int = 1;
                p = p + 1;
                while p + 1 < n && ws_kind(toks, p) == "PLUS" {
                    if ws_kind(toks, p + 1) != "STRING" {
                        return "";
                    }
                    joined = joined + ws_text(toks, p + 1);
                    parts = parts + 1;
                    p = p + 2;
                }
                if parts < 2 {
                    return "";
                }
                if p >= n || ws_kind(toks, p) != "RPAREN" {
                    return "";
                }
                p = p + 1;
                if p < n && ws_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p < n && ws_kind(toks, p) == "RBRACE" {
                    return joined;
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
