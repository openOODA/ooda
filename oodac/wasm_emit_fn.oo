import "lex.oo";
import "token_fmt.oo";
import "wasm_emit_expr.oo";
import "wasm_emit_stmt.oo";

pub fn wasm_collect_fn_locals(toks: List[String], pos: Int, n: Int) -> String {
    let mut p = pos;
    let mut brace_depth = 0;
    let mut locals = "";
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            brace_depth = brace_depth + 1;
        } else if k == "RBRACE" {
            brace_depth = brace_depth - 1;
            if brace_depth <= 0 {
                break;
            }
        } else if k == "KW_LET" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" { p = p + 1; }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let vname = field_at(list_get(toks, p), 3);
                let mut vty = "i64";
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                    p = p + 1;
                    if p < n {
                        let tname = field_at(list_get(toks, p), 3);
                        if tname == "String" || tname == "Bool" { vty = "i32"; }
                        else if tname == "Float" { vty = "f64"; }
                    }
                }
                locals = locals + vname + ":" + vty + ";";
            }
        }
        p = p + 1;
    }
    return locals;
}

pub fn wasm_emit_fn(toks: List[String], pos: Int, n: Int, str_tab: List[String]) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" { p = p + 1; }
    if field_at(list_get(toks, p), 0) == "KW_FN" { p = p + 1; }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }

    let mut params_wat = "";
    let mut env = "";
    while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname = field_at(list_get(toks, p), 3);
            p = p + 1;
            let mut pty = "i64";
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "AMP" { p = p + 1; }
                if p < n {
                    let tn = field_at(list_get(toks, p), 3);
                    if tn == "String" || tn == "Bool" || tn == "List" { pty = "i32"; }
                    else if tn == "Float" { pty = "f64"; }
                    p = p + 1;
                }
                while p < n {
                    let nk = field_at(list_get(toks, p), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    p = p + 1;
                }
            }
            params_wat = params_wat + " (param $" + pname + " " + pty + ")";
            env = env + pname + ":" + pty + ";";
        } else {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }

    let mut ret_wat = "";
    if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
        p = p + 1;
        let mut rty = "i64";
        if p < n {
            let rtn = field_at(list_get(toks, p), 3);
            if rtn == "String" || rtn == "Bool" || rtn == "List" { rty = "i32"; }
            else if rtn == "Float" { rty = "f64"; }
            p = p + 1;
        }
        ret_wat = " (result " + rty + ")";
    }

    if fn_name == "main" {
        params_wat = "";
        println("  (export \"main\" (func $main))");
        println("  (export \"_start\" (func $main))");
    }

    println("  (func $" + fn_name + params_wat + ret_wat);

    if fn_name == "main" {
        println("    (local $fs i64)");
        println("    (local $sys i64)");
        println("    (local $env i64)");
        println("    (local $net i64)");
        env = env + "fs:i64;sys:i64;env:i64;net:i64;";
    }

    let locals_blob: String = wasm_collect_fn_locals(toks, p, n);
    let mut i = 0;
    let ln = chars_len(locals_blob);
    while i < ln {
        let mut j = i;
        while j < ln && char_at(locals_blob, j) != ";" { j = j + 1; }
        if j > i {
            let mut item = "";
            let mut k = i;
            while k < j { item = item + char_at(locals_blob, k); k = k + 1; }
            let mut colon_pos = -1;
            let mut m = 0;
            let iname_len = chars_len(item);
            while m < iname_len {
                if char_at(item, m) == ":" { colon_pos = m; }
                m = m + 1;
            }
            if colon_pos > 0 {
                let mut lname = "";
                let mut lty = "";
                let mut c1 = 0;
                while c1 < colon_pos { lname = lname + char_at(item, c1); c1 = c1 + 1; }
                let mut c2 = colon_pos + 1;
                while c2 < iname_len { lty = lty + char_at(item, c2); c2 = c2 + 1; }
                if wasm_env_lookup_ty(env, lname) == "i64" && lname != "main" {
                    println("    (local $" + lname + " " + lty + ")");
                    env = env + lname + ":" + lty + ";";
                }
            }
        }
        i = j + 1;
    }

    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" { p = p + 1; }

    if fn_name == "main" {
        println("    i64.const 1330595411");
        println("    local.set $fs");
        println("    i64.const 1330598745");
        println("    local.set $sys");
        println("    i64.const 1330595150");
        println("    local.set $env");
        println("    i64.const 1330597460");
        println("    local.set $net");
    }

    let br: List[String] = wasm_emit_block(toks, p, n, env, str_tab);
    p = parse_int(list_get(br, 0));
    println("  )");
    return p;
}
