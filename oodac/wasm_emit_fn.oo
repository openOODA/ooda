// # Emit one WebAssembly function
//
// Logline: Collects locals, prints a WAT func with params, result, and exports, seeds main capability constants, and emits the body.
//
// Setup: toks rows are kind, line, col, text; wasm_emit_block, wasm_emit_stmt, and wasm_env_lookup_ty are in scope.
//
// Beats:
//   1. wasm_collect_fn_locals walks the body and records let and for variables as name:ty in a semicolon blob.
//   2. wasm_emit_fn prints function signature, pub/main exports, and declares all non-param locals.
//   3. Main seeds capability constants, wasm_emit_block lowers the function body, and the func is closed.

import "tc_parse_int.oo";
import "token_fmt.oo";
import "wasm_emit_primary.oo";
import "wasm_emit_expr.oo";
import "wasm_emit_stmt.oo";

fn wasm_env_has(env: String, name: String) -> Bool {
    let target = name + ":";
    let n = chars_len(env);
    let tn = chars_len(target);
    let mut i = 0;
    while i + tn <= n {
        if i == 0 || char_at(env, i - 1) == ";" {
            let mut match_t = true;
            let mut k = 0;
            while k < tn {
                if char_at(env, i + k) != char_at(target, k) { match_t = false; }
                k = k + 1;
            }
            if match_t { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn wasm_collect_fn_locals(toks: List[String], pos: Int, n: Int) -> String {
    let mut p = pos;
    let mut depth = 0;
    let mut locals = "";
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" { depth = depth + 1; }
        else if k == "RBRACE" {
            depth = depth - 1;
            if depth <= 0 { break; }
        } else if k == "KW_LET" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" { p = p + 1; }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let vname: String = field_at(list_get(toks, p), 3);
                let mut vty = "i64";
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                    p = p + 1;
                    if p < n && field_at(list_get(toks, p), 0) == "AMP" { p = p + 1; }
                    if p < n {
                        let tn: String = field_at(list_get(toks, p), 3);
                        if tn == "String" || tn == "Bool" || tn == "List" { vty = "i32"; }
                        else if tn == "Float" { vty = "f64"; }
                    }
                } else if p < n && (field_at(list_get(toks, p), 0) == "EQ" || field_at(list_get(toks, p), 3) == "=") {
                    if p + 1 < n {
                        let ak: String = field_at(list_get(toks, p + 1), 0);
                        let at: String = field_at(list_get(toks, p + 1), 3);
                        if ak == "KW_TRUE" || ak == "KW_FALSE" || at == "true" || at == "false" || ak == "STRING" {
                            vty = "i32";
                        } else if ak == "FLOAT" {
                            vty = "f64";
                        } else if ak == "IDENT" {
                            let id_ty: String = wasm_env_lookup_ty(locals, at);
                            if id_ty == "i32" || id_ty == "f64" { vty = id_ty; }
                            else if at == "str_concat" || at == "to_string" { vty = "i32"; }
                        }
                    }
                }
                locals = locals + vname + ":" + vty + ";";
            }
        } else if k == "KW_FOR" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let fv: String = field_at(list_get(toks, p), 3);
                locals = locals + fv + ":i64;";
            }
        }
        p = p + 1;
    }
    return locals;
}

pub fn wasm_emit_fn(toks: List[String], pos: Int, n: Int, str_tab: List[String]) -> Int {
    let mut p = pos;
    let mut is_pub = false;
    if field_at(list_get(toks, p), 0) == "KW_PUB" { is_pub = true; p = p + 1; }
    if field_at(list_get(toks, p), 0) == "KW_FN" { p = p + 1; }
    let fn_name: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }

    let mut params_wat = "";
    let mut env = "";
    while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
        let pk: String = field_at(list_get(toks, p), 0);
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname: String = field_at(list_get(toks, p), 3);
            p = p + 1;
            let mut pty = "i64";
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "AMP" { p = p + 1; }
                if p < n {
                    let tn: String = field_at(list_get(toks, p), 3);
                    if tn == "String" || tn == "Bool" || tn == "List" { pty = "i32"; }
                    else if tn == "Float" { pty = "f64"; }
                    p = p + 1;
                }
                while p < n {
                    let nk: String = field_at(list_get(toks, p), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    p = p + 1;
                }
            }
            params_wat = params_wat + " (param $" + pname + " " + pty + ")";
            env = env + pname + ":" + pty + ";";
        } else {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }

    let mut ret_wat = "";
    if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
        p = p + 1;
        let mut rty = "i64";
        if p < n {
            let rtn: String = field_at(list_get(toks, p), 3);
            if rtn == "String" || rtn == "Bool" || rtn == "List" { rty = "i32"; }
            else if rtn == "Float" { rty = "f64"; }
            p = p + 1;
        }
        ret_wat = " (result " + rty + ")";
    }

    if fn_name == "main" {
        params_wat = "";
        println("  (export \"main\" (func $main))");
        println("  (export \"_start\" (func $main))");
    } else if is_pub {
        println("  (export \"" + fn_name + "\" (func $" + fn_name + "))");
    }

    println("  (func $" + fn_name + params_wat + ret_wat);

    if fn_name == "main" {
        println("    (local $fs i64)");
        println("    (local $sys i64)");
        println("    (local $env i64)");
        println("    (local $net i64)");
        println("    (local $p i64)");
        println("    (local $fw i64)");
        println("    (local $proc i64)");
        env = env + "fs:i64;sys:i64;env:i64;net:i64;p:i64;fw:i64;proc:i64;";
    }

    let locals_blob: String = wasm_collect_fn_locals(toks, p, n);
    let mut i = 0;
    let ln = chars_len(locals_blob);
    while i < ln {
        let mut j = i;
        while j < ln && char_at(locals_blob, j) != ";" { j = j + 1; }
        if j > i {
            let mut item = "";
            let mut k = i;
            while k < j { item = item + char_at(locals_blob, k); k = k + 1; }
            let iname_len = chars_len(item);
            let mut colon_pos = -1;
            let mut m = 0;
            while m < iname_len {
                if char_at(item, m) == ":" { colon_pos = m; }
                m = m + 1;
            }
            if colon_pos > 0 {
                let mut lname = "";
                let mut lty = "";
                let mut c1 = 0;
                while c1 < colon_pos { lname = lname + char_at(item, c1); c1 = c1 + 1; }
                let mut c2 = colon_pos + 1;
                while c2 < iname_len { lty = lty + char_at(item, c2); c2 = c2 + 1; }
                if !wasm_env_has(env, lname) && lname != "main" {
                    println("    (local $" + lname + " " + lty + ")");
                    env = env + lname + ":" + lty + ";";
                }
            }
        }
        i = j + 1;
    }

    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" { p = p + 1; }

    if fn_name == "main" {
        println("    i64.const 1330595411");
        println("    local.set $fs");
        println("    i64.const 1330598745");
        println("    local.set $sys");
        println("    i64.const 1330595150");
        println("    local.set $env");
        println("    i64.const 1330597460");
        println("    local.set $net");
        println("    i64.const 1330596944");
        println("    local.set $p");
        println("    i64.const 1330595960");
        println("    local.set $fw");
        println("    i64.const 1330597968");
        println("    local.set $proc");
    }

    let br: List[String] = wasm_emit_block(toks, p, n, env, str_tab);
    p = parse_int(list_get(br, 0));
    println("  )");
    return p;
}
