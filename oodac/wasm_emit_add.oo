// # Detect println of two integer literals added
//
// Logline: Returns the decimal sum when a function body is only println of INT plus INT.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT PLUS INT ) with optional semicolon, then RBRACE.
//   3. Return (left + right) decimal text. IDENT, FLOAT, and extra operands miss.
//
// residual: runtime IDENT add and i64 add bytecode stay dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wa_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wa_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_add(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wa_kind(toks, i) == "KW_FN" && wa_kind(toks, i + 1) == "IDENT" {
            if wa_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wa_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 5 >= n {
                    return "";
                }
                if wa_kind(toks, p) != "IDENT" || wa_text(toks, p) != "println" {
                    return "";
                }
                if wa_kind(toks, p + 1) != "LPAREN" {
                    return "";
                }
                if wa_kind(toks, p + 2) != "INT" {
                    return "";
                }
                if wa_kind(toks, p + 3) != "PLUS" {
                    return "";
                }
                if wa_kind(toks, p + 4) != "INT" {
                    return "";
                }
                if wa_kind(toks, p + 5) != "RPAREN" {
                    return "";
                }
                let left: Int = parse_int(wa_text(toks, p + 2));
                let right: Int = parse_int(wa_text(toks, p + 4));
                let sum: Int = left + right;
                p = p + 6;
                if p < n && wa_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p < n && wa_kind(toks, p) == "RBRACE" {
                    return sum.to_string();
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
