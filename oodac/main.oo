// openOODA oodac — real CHS frontend in .oo (lex + parse/AST dump + check)
// Commands: tokens|ast|check|build <file> [out]
// tokens/ast/check are implemented in this file (not host-only wrappers).
// build uses chs_build host for native emit (M4 hybrid).

import "lex.oo";
import "token_emit.oo";
import "token_fmt.oo";
import "check_caps.oo";
import "check_drive.oo";
import "parse_drive.oo";
import "parse_item.oo";
import "parse_expr.oo";
import "parse_skip.oo";
import "parse_method.oo";
import "tc_types_core.oo";
import "tc_scope.oo";
import "tc_tables.oo";
import "tc_names.oo";
import "tc_call_ret.oo";
import "tc_assign_immut.oo";
import "tc_assign_mut.oo";
import "tc_ops_unary.oo";
import "tc_ops_cmp.oo";
import "tc_ops_logic.oo";
import "tc_struct_method.oo";
import "tc_struct_assign.oo";
import "tc_struct_lit.oo";
import "tc_control_cond.oo";
import "tc_control_branch.oo";
import "tc_infer.oo";
import "tc_effects.oo";
import "tc_parse_int.oo";
import "c_emit.oo";
import "parse_stmt_nav.oo";
import "parse_stmt_dump.oo";
import "tc_call_arity.oo";
import "tc_call_util.oo";
import "tc_call_binop.oo";
import "tc_call_logic.oo";
import "tc_call_order.oo";
import "tc_call_eq.oo";
import "tc_call_let.oo";
import "tc_struct_tab1.oo";
import "tc_struct_chain.oo";

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        println("oodac: usage: tokens|ast|check|build|emit-c <file>");
        process_exit(2);
    }
    let cmd = list_get(args, 0);
    if list_len(args) < 2 {
        println("oodac: missing file argument");
        process_exit(2);
    }
    let path = list_get(args, 1);

    if cmd == "build" {
        let mut out = path + ".bin";
        if list_len(args) >= 3 {
            out = list_get(args, 2);
        }
        
        let c_path = path + ".c";
        
        // 1. Run oodac emit-c into .c file
        let emit_cmd = "ooda run oodac/main.oo -- emit-c " + path + " > " + c_path;
        let r1 = sys_exec(sys, "sh", "-c", emit_cmd);
        if r1.is_err() {
            let e = match r1 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
        
        // 2. Compile with gcc
        let r2 = sys_exec(sys, "gcc", "-O2", "-Iruntime", "runtime/chs_rt.c", c_path, "-Ltarget/debug", "-looda", "-lm", "-lpthread", "-o", out);
        
        if r2.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            let e = match r2 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
    }

    let src_r = read_file(fs, path);
    if src_r.is_err() {
        let e = match src_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tload\t" + e);
        process_exit(1);
    }
    let src = match src_r {
        Ok(s) => s,
        Err(msg) => msg,
    };

    if cmd == "emit-c" {
        c_emit_stream(src);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(src);
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(src);
        return;
    }
    if cmd == "check" {
        run_check_from_src(src);
        return;
    }
    println("oodac: unknown command");
    process_exit(2);
}
// ===== Token dump (emit KIND\tLINE\tCOL\tTEXT) — same as before, fail-closed =====

pub fn dump_tokens(src: String) {
    let probe = lex_all(src);
    if probe.is_err() {
        let e = match probe {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tlex\t" + e);
        process_exit(1);
    }
    let n = chars_len(src);
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    while i < n {
        let ch = char_at(src, i);
        if ch == " " {
            i = i + 1;
            col = col + 1;
        } else if ch == "\t" {
            i = i + 1;
            col = col + 1;
        } else if ch == "\n" {
            i = i + 1;
            line = line + 1;
            col = 1;
        } else if ch == "/" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "/" {
                    i = i + 2;
                    col = col + 2;
                    let mut cont_c = true;
                    while cont_c {
                        if i >= n {
                            cont_c = false;
                        } else {
                            let c2 = char_at(src, i);
                            if c2 == "\n" {
                                cont_c = false;
                            } else {
                                i = i + 1;
                                col = col + 1;
                            }
                        }
                    }
                } else {
                    emit_tok("SLASH", line, col, "/");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("SLASH", line, col, "/");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "\"" {
            let start_line = line;
            let start_col = col;
            i = i + 1;
            col = col + 1;
            let mut s = "";
            let mut cont_s = true;
            while cont_s {
                if i >= n {
                    println("ERR\tlex\tUnterminated string");
                    process_exit(1);
                }
                let c2 = char_at(src, i);
                if c2 == "\"" {
                    i = i + 1;
                    col = col + 1;
                    cont_s = false;
                } else if c2 == "\\" {
                    i = i + 1;
                    col = col + 1;
                    if i < n {
                        let e = char_at(src, i);
                        if e == "n" {
                            s = s + "\n";
                        } else if e == "t" {
                            s = s + "\t";
                        } else {
                            s = s + e;
                        }
                        i = i + 1;
                        col = col + 1;
                    }
                } else {
                    s = s + c2;
                    i = i + 1;
                    col = col + 1;
                }
            }
            emit_tok("STRING", start_line, start_col, s);
        } else if char_is_digit(ch) {
            let start_line = line;
            let start_col = col;
            let mut num = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_d = true;
            while cont_d {
                if i >= n {
                    cont_d = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_digit(c2) {
                        num = num + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_d = false;
                    }
                }
            }
            // Optional fractional part → FLOAT (R1: was INT DOT INT split, broke 1.0/0.0).
            if i < n {
                if char_at(src, i) == "." {
                    // Not range `..` — only single dot for float.
                    if i + 1 < n {
                        if char_at(src, i + 1) != "." {
                            if char_is_digit(char_at(src, i + 1)) {
                                num = num + ".";
                                i = i + 1;
                                col = col + 1;
                                let mut cont_f = true;
                                while cont_f {
                                    if i >= n {
                                        cont_f = false;
                                    } else {
                                        let c3 = char_at(src, i);
                                        if char_is_digit(c3) {
                                            num = num + c3;
                                            i = i + 1;
                                            col = col + 1;
                                        } else {
                                            cont_f = false;
                                        }
                                    }
                                }
                                emit_tok("FLOAT", start_line, start_col, num);
                                // skip the INT emit below
                                let mut skip_int = true;
                                if skip_int {
                                    // continue outer loop without INT
                                    let _si = 0;
                                }
                            } else {
                                emit_tok("INT", start_line, start_col, num);
                            }
                        } else {
                            emit_tok("INT", start_line, start_col, num);
                        }
                    } else {
                        emit_tok("INT", start_line, start_col, num);
                    }
                } else {
                    emit_tok("INT", start_line, start_col, num);
                }
            } else {
                emit_tok("INT", start_line, start_col, num);
            }
        } else if char_is_alpha(ch) || ch == "_" {
            let start_line = line;
            let start_col = col;
            let mut id = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_id = true;
            while cont_id {
                if i >= n {
                    cont_id = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                        id = id + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_id = false;
                    }
                }
            }
            emit_tok(keyword_kind(id), start_line, start_col, id);
        } else if ch == "+" {
            emit_tok("PLUS", line, col, "+");
            i = i + 1;
            col = col + 1;
        } else if ch == "-" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == ">" {
                    emit_tok("ARROW", line, col, "->");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("MINUS", line, col, "-");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("MINUS", line, col, "-");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "*" {
            emit_tok("STAR", line, col, "*");
            i = i + 1;
            col = col + 1;
        } else if ch == "=" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("EQEQ", line, col, "==");
                    i = i + 2;
                    col = col + 2;
                } else if nch == ">" {
                    emit_tok("FATARROW", line, col, "=>");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("EQ", line, col, "=");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("EQ", line, col, "=");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "!" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("NEQ", line, col, "!=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("BANG", line, col, "!");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("BANG", line, col, "!");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "<" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("LTE", line, col, "<=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("LT", line, col, "<");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("LT", line, col, "<");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ">" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("GTE", line, col, ">=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("GT", line, col, ">");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("GT", line, col, ">");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "&" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "&" {
                    emit_tok("ANDAND", line, col, "&&");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("AMP", line, col, "&");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("AMP", line, col, "&");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "|" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "|" {
                    emit_tok("OROR", line, col, "||");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("PIPE", line, col, "|");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("PIPE", line, col, "|");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ":" {
            emit_tok("COLON", line, col, ":");
            i = i + 1;
            col = col + 1;
        } else if ch == ";" {
            emit_tok("SEMI", line, col, ";");
            i = i + 1;
            col = col + 1;
        } else if ch == "," {
            emit_tok("COMMA", line, col, ",");
            i = i + 1;
            col = col + 1;
        } else if ch == "." {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "." {
                    let k = j + 1;
                    if k < n {
                        let n2 = char_at(src, k);
                        if n2 == "=" {
                            emit_tok("DOTDOTEQ", line, col, "..=");
                            i = i + 3;
                            col = col + 3;
                        } else {
                            emit_tok("DOTDOT", line, col, "..");
                            i = i + 2;
                            col = col + 2;
                        }
                    } else {
                        emit_tok("DOTDOT", line, col, "..");
                        i = i + 2;
                        col = col + 2;
                    }
                } else {
                    emit_tok("DOT", line, col, ".");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("DOT", line, col, ".");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "(" {
            emit_tok("LPAREN", line, col, "(");
            i = i + 1;
            col = col + 1;
        } else if ch == ")" {
            emit_tok("RPAREN", line, col, ")");
            i = i + 1;
            col = col + 1;
        } else if ch == "{" {
            emit_tok("LBRACE", line, col, "{");
            i = i + 1;
            col = col + 1;
        } else if ch == "}" {
            emit_tok("RBRACE", line, col, "}");
            i = i + 1;
            col = col + 1;
        } else if ch == "[" {
            emit_tok("LBRACKET", line, col, "[");
            i = i + 1;
            col = col + 1;
        } else if ch == "]" {
            emit_tok("RBRACKET", line, col, "]");
            i = i + 1;
            col = col + 1;
        } else if ch == "?" {
            emit_tok("QUESTION", line, col, "?");
            i = i + 1;
            col = col + 1;
        } else {
            println("ERR\tlex\tUnexpected character '" + ch + "' at " + line.to_string() + ":" + col.to_string());
            process_exit(1);
        }
    }
    emit_tok("EOF", line, col, "");
}

pub fn collect_tokens(src: String) -> List[String] {
    // Manual collection duplicate of dump_tokens without print — store lines
    let mut out: List[String] = list_new();
    let n = chars_len(src);
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    while i < n {
        let ch = char_at(src, i);
        if ch == " " || ch == "\t" {
            i = i + 1;
            col = col + 1;
        } else if ch == "\n" {
            i = i + 1;
            line = line + 1;
            col = 1;
        } else if ch == "/" {
            let j = i + 1;
            if j < n {
                if char_at(src, j) == "/" {
                    i = i + 2;
                    col = col + 2;
                    let mut cont_c = true;
                    while cont_c {
                        if i >= n {
                            cont_c = false;
                        } else {
                            if char_at(src, i) == "\n" {
                                cont_c = false;
                            } else {
                                i = i + 1;
                                col = col + 1;
                            }
                        }
                    }
                } else {
                    out = list_push(out, tok_line("SLASH", line, col, "/"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("SLASH", line, col, "/"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "\"" {
            let sl = line;
            let sc = col;
            i = i + 1;
            col = col + 1;
            let mut s = "";
            let mut cont_s = true;
            while cont_s {
                if i >= n {
                    cont_s = false;
                } else {
                    let c2 = char_at(src, i);
                    if c2 == "\"" {
                        i = i + 1;
                        col = col + 1;
                        cont_s = false;
                    } else if c2 == "\\" {
                        i = i + 1;
                        col = col + 1;
                        if i < n {
                            let e = char_at(src, i);
                            if e == "n" {
                                s = s + "\n";
                            } else if e == "t" {
                                s = s + "\t";
                            } else {
                                s = s + e;
                            }
                            i = i + 1;
                            col = col + 1;
                        }
                    } else {
                        s = s + c2;
                        i = i + 1;
                        col = col + 1;
                    }
                }
            }
            out = list_push(out, tok_line("STRING", sl, sc, s));
        } else if char_is_digit(ch) {
            let sl = line;
            let sc = col;
            let mut num = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_d = true;
            while cont_d {
                if i >= n {
                    cont_d = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_digit(c2) {
                        num = num + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_d = false;
                    }
                }
            }
            // Optional .digits → FLOAT (keep `..` range as separate tokens).
            let mut is_float = false;
            if i < n {
                if char_at(src, i) == "." {
                    if i + 1 < n {
                        if char_at(src, i + 1) != "." {
                            if char_is_digit(char_at(src, i + 1)) {
                                is_float = true;
                                num = num + ".";
                                i = i + 1;
                                col = col + 1;
                                let mut cont_f = true;
                                while cont_f {
                                    if i >= n {
                                        cont_f = false;
                                    } else {
                                        let c3 = char_at(src, i);
                                        if char_is_digit(c3) {
                                            num = num + c3;
                                            i = i + 1;
                                            col = col + 1;
                                        } else {
                                            cont_f = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if is_float {
                out = list_push(out, tok_line("FLOAT", sl, sc, num));
            } else {
                out = list_push(out, tok_line("INT", sl, sc, num));
            }
        } else if char_is_alpha(ch) || ch == "_" {
            let sl = line;
            let sc = col;
            let mut id = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_id = true;
            while cont_id {
                if i >= n {
                    cont_id = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                        id = id + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_id = false;
                    }
                }
            }
            out = list_push(out, tok_line(keyword_kind(id), sl, sc, id));
        } else if ch == "+" {
            out = list_push(out, tok_line("PLUS", line, col, "+"));
            i = i + 1;
            col = col + 1;
        } else if ch == "-" {
            if i + 1 < n {
                if char_at(src, i + 1) == ">" {
                    out = list_push(out, tok_line("ARROW", line, col, "->"));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("MINUS", line, col, "-"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("MINUS", line, col, "-"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "*" {
            out = list_push(out, tok_line("STAR", line, col, "*"));
            i = i + 1;
            col = col + 1;
        } else if ch == "=" {
            if i + 1 < n {
                let nch = char_at(src, i + 1);
                if nch == "=" {
                    out = list_push(out, tok_line("EQEQ", line, col, "=="));
                    i = i + 2;
                    col = col + 2;
                } else if nch == ">" {
                    out = list_push(out, tok_line("FATARROW", line, col, "=>"));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("EQ", line, col, "="));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("EQ", line, col, "="));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "!" {
            if i + 1 < n {
                if char_at(src, i + 1) == "=" {
                    out = list_push(out, tok_line("NEQ", line, col, "!="));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("BANG", line, col, "!"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("BANG", line, col, "!"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "<" {
            if i + 1 < n {
                if char_at(src, i + 1) == "=" {
                    out = list_push(out, tok_line("LTE", line, col, "<="));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("LT", line, col, "<"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("LT", line, col, "<"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ">" {
            if i + 1 < n {
                if char_at(src, i + 1) == "=" {
                    out = list_push(out, tok_line("GTE", line, col, ">="));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("GT", line, col, ">"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("GT", line, col, ">"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "&" {
            if i + 1 < n {
                if char_at(src, i + 1) == "&" {
                    out = list_push(out, tok_line("ANDAND", line, col, "&&"));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("AMP", line, col, "&"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("AMP", line, col, "&"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "|" {
            if i + 1 < n {
                if char_at(src, i + 1) == "|" {
                    out = list_push(out, tok_line("OROR", line, col, "||"));
                    i = i + 2;
                    col = col + 2;
                } else {
                    out = list_push(out, tok_line("PIPE", line, col, "|"));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("PIPE", line, col, "|"));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ":" {
            out = list_push(out, tok_line("COLON", line, col, ":"));
            i = i + 1;
            col = col + 1;
        } else if ch == ";" {
            out = list_push(out, tok_line("SEMI", line, col, ";"));
            i = i + 1;
            col = col + 1;
        } else if ch == "," {
            out = list_push(out, tok_line("COMMA", line, col, ","));
            i = i + 1;
            col = col + 1;
        } else if ch == "." {
            if i + 1 < n {
                if char_at(src, i + 1) == "." {
                    if i + 2 < n {
                        if char_at(src, i + 2) == "=" {
                            out = list_push(out, tok_line("DOTDOTEQ", line, col, "..="));
                            i = i + 3;
                            col = col + 3;
                        } else {
                            out = list_push(out, tok_line("DOTDOT", line, col, ".."));
                            i = i + 2;
                            col = col + 2;
                        }
                    } else {
                        out = list_push(out, tok_line("DOTDOT", line, col, ".."));
                        i = i + 2;
                        col = col + 2;
                    }
                } else {
                    out = list_push(out, tok_line("DOT", line, col, "."));
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                out = list_push(out, tok_line("DOT", line, col, "."));
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "(" {
            out = list_push(out, tok_line("LPAREN", line, col, "("));
            i = i + 1;
            col = col + 1;
        } else if ch == ")" {
            out = list_push(out, tok_line("RPAREN", line, col, ")"));
            i = i + 1;
            col = col + 1;
        } else if ch == "{" {
            out = list_push(out, tok_line("LBRACE", line, col, "{"));
            i = i + 1;
            col = col + 1;
        } else if ch == "}" {
            out = list_push(out, tok_line("RBRACE", line, col, "}"));
            i = i + 1;
            col = col + 1;
        } else if ch == "[" {
            out = list_push(out, tok_line("LBRACKET", line, col, "["));
            i = i + 1;
            col = col + 1;
        } else if ch == "]" {
            out = list_push(out, tok_line("RBRACKET", line, col, "]"));
            i = i + 1;
            col = col + 1;
        } else if ch == "?" {
            out = list_push(out, tok_line("QUESTION", line, col, "?"));
            i = i + 1;
            col = col + 1;
        } else {
            // unreachable if lex_all passed
            i = i + 1;
            col = col + 1;
        }
    }
    out = list_push(out, tok_line("EOF", line, col, ""));
    return out;
}

pub fn parse_primary_dump(toks: List[String], pos0: Int, depth: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    let pad = indent(depth);
    let k = field_at(list_get(toks, pos), 0);
    let line = field_at(list_get(toks, pos), 1);
    let col = field_at(list_get(toks, pos), 2);
    let text = field_at(list_get(toks, pos), 3);
    if k == "INT" {
        println(pad + "EXPR LIT int:" + text + " @" + line + ":" + col);
        return pos + 1;
    }
    if k == "STRING" {
        // escape for dump like stage-0
        println(pad + "EXPR LIT str:" + escape_dump(text) + " @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_TRUE" {
        println(pad + "EXPR LIT bool:true @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_FALSE" {
        println(pad + "EXPR LIT bool:false @" + line + ":" + col);
        return pos + 1;
    }
    if k == "IDENT" {
        // call or var or method
        let name = text;
        let nl = line;
        let nc = col;
        pos = pos + 1;
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "LPAREN" {
                pos = pos + 1;
                // count args
                let arg_start = pos;
                let mut argc = 0;
                let mut depth_a = 0;
                let mut scan = pos;
                let mut cont = true;
                while cont {
                    if scan >= n {
                        cont = false;
                    } else {
                        let sk = field_at(list_get(toks, scan), 0);
                        if sk == "LPAREN" {
                            depth_a = depth_a + 1;
                        }
                        if sk == "RPAREN" {
                            if depth_a == 0 {
                                cont = false;
                            } else {
                                depth_a = depth_a - 1;
                            }
                        }
                        if sk == "COMMA" {
                            if depth_a == 0 {
                                argc = argc + 1;
                            }
                        }
                        if cont {
                            scan = scan + 1;
                        }
                    }
                }
                // argc: if any tokens between, +1
                if pos < scan {
                    if field_at(list_get(toks, pos), 0) != "RPAREN" {
                        argc = argc + 1;
                    }
                }
                // method call uses span of RPAREN in stage-0 often — use call site of LPAREN-1
                let call_line = nl;
                let call_col = nc;
                // stage-0 uses span of call name end-ish — use last_span at RPAREN from examples:
                // EXPR CALL name=add argc=2 prop=false @15:23 — col of RPAREN-ish
                // We'll parse args first to get RPAREN span
                let mut args_pos = pos;
                // Print CALL header with temporary span, then args
                // Get RPAREN location by scanning
                let mut rp = pos;
                depth_a = 0;
                cont = true;
                while cont {
                    if rp >= n {
                        cont = false;
                    } else {
                        let sk = field_at(list_get(toks, rp), 0);
                        if sk == "LPAREN" {
                            depth_a = depth_a + 1;
                        }
                        if sk == "RPAREN" {
                            if depth_a == 0 {
                                cont = false;
                            } else {
                                depth_a = depth_a - 1;
                                rp = rp + 1;
                            }
                        } else {
                            rp = rp + 1;
                        }
                    }
                }
                let rl = field_at(list_get(toks, rp), 1);
                let rc = field_at(list_get(toks, rp), 2);
                println(pad + "EXPR CALL name=" + name + " argc=" + argc.to_string() + " prop=false @" + rl + ":" + rc);
                // parse each arg
                let mut ai = 0;
                while ai < argc {
                    pos = parse_expr_dump(toks, pos, depth + 1);
                    if field_at(list_get(toks, pos), 0) == "COMMA" {
                        pos = pos + 1;
                    }
                    ai = ai + 1;
                }
                if field_at(list_get(toks, pos), 0) == "RPAREN" {
                    pos = pos + 1;
                }
                // method: .name
                if pos < n {
                    if field_at(list_get(toks, pos), 0) == "DOT" {
                        // treat as method call wrapper — stage-0 uses Call(".m", [recv,...])
                        // For simplicity after call, if DOT, parse method
                        pos = parse_method_chain(toks, pos, depth, name);
                    }
                }
                return pos;
            }
        }

        if pos < n {
            let nxt = field_at(list_get(toks, pos), 0);
            if nxt == "LBRACE" {
                let mut is_struct = false;
                let mut p2 = pos + 1;
                if p2 < n {
                    let k2 = field_at(list_get(toks, p2), 0);
                    if k2 == "RBRACE" {
                        is_struct = true;
                    } else if k2 == "IDENT" {
                        if p2 + 1 < n {
                            if field_at(list_get(toks, p2 + 1), 0) == "COLON" {
                                is_struct = true;
                            }
                        }
                    }
                }
                if is_struct {
                    let sl = nl;
                    let sc = nc;
                    pos = pos + 1;
                    let mut argc = 0;
                    let mut scan = pos;
                    let mut cont_s = true;
                    while cont_s {
                        if scan >= n {
                            cont_s = false;
                        } else {
                            if field_at(list_get(toks, scan), 0) == "RBRACE" {
                                cont_s = false;
                            } else {
                                if field_at(list_get(toks, scan), 0) == "COLON" {
                                    argc = argc + 1;
                                    scan = scan + 1;
                                } else {
                                    scan = scan + 1;
                                }
                            }
                        }
                    }
                    println(pad + "EXPR STRUCTLIT name=" + name + " fields=" + argc.to_string() + " @" + sl + ":" + sc);
                    let mut fi = 0;
                    while fi < argc {
                        let fname = field_at(list_get(toks, pos), 3);
                        pos = pos + 1; 
                        pos = pos + 1; 
                        println(pad + "FIELD " + fname);
                        pos = parse_expr_dump(toks, pos, depth + 1);
                        if field_at(list_get(toks, pos), 0) == "COMMA" {
                            pos = pos + 1;
                        }
                        fi = fi + 1;
                    }
                    if field_at(list_get(toks, pos), 0) == "RBRACE" {
                        pos = pos + 1;
                    }
                    return pos;
                }
            }
        }
        // method without call on var: x.len()
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "DOT" {
                // VAR then method — stage-0: Call(".len", [var])
                // print VAR first then we'll handle DOT as method on previous — harder.
                // Print as CALL .method with receiver VAR child
                pos = parse_method_from_var(toks, pos0, depth);
                return pos;
            }
        }
        println(pad + "EXPR VAR " + name + " @" + nl + ":" + nc);
        return pos;
    }
    if k == "LPAREN" {
        pos = pos + 1;
        pos = parse_expr_dump(toks, pos, depth);
        if field_at(list_get(toks, pos), 0) == "RPAREN" {
            pos = pos + 1;
        }
        return pos;
    }
    if k == "KW_MATCH" {
        let ml = line;
        let mc = col;
        pos = pos + 1;
        let mut scan_pos = skip_expr_bp(toks, pos, 0);
        if field_at(list_get(toks, scan_pos), 0) == "LBRACE" {
            scan_pos = scan_pos + 1;
        }
        let mut arms = 0;
        let mut depth_b = 1;
        let mut cont_m = true;
        while cont_m {
            if scan_pos >= n { cont_m = false; }
            else {
                let sk = field_at(list_get(toks, scan_pos), 0);
                if sk == "LBRACE" { depth_b = depth_b + 1; }
                if sk == "RBRACE" {
                    depth_b = depth_b - 1;
                    if depth_b == 0 { cont_m = false; }
                }
                if sk == "FATARROW" {
                    if depth_b == 1 { arms = arms + 1; }
                }
                scan_pos = scan_pos + 1;
            }
        }
        println(pad + "EXPR MATCH arms=" + arms.to_string() + " @" + ml + ":" + mc);
        
        pos = parse_expr_dump(toks, pos, depth + 1);
        if field_at(list_get(toks, pos), 0) == "LBRACE" {
            pos = pos + 1;
        }
        let mut ai = 0;
        while ai < arms {
            let pat = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            let mut arg = "";
            if field_at(list_get(toks, pos), 0) == "LPAREN" {
                pos = pos + 1;
                arg = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
                if field_at(list_get(toks, pos), 0) == "RPAREN" { pos = pos + 1; }
            }
            if arg == "" {
                println(pad + "ARM[" + ai.to_string() + "] pat=" + pat);
            } else {
                println(pad + "ARM[" + ai.to_string() + "] pat=var:" + pat + "(" + arg + ")");
            }
            if field_at(list_get(toks, pos), 0) == "FATARROW" { pos = pos + 1; }
            pos = parse_expr_dump(toks, pos, depth + 1);
            if field_at(list_get(toks, pos), 0) == "COMMA" { pos = pos + 1; }
            ai = ai + 1;
        }
        if field_at(list_get(toks, pos), 0) == "RBRACE" { pos = pos + 1; }
        return pos;
    }
    if k == "KW_IF" {
        let il = line;
        let ic = col;
        pos = pos + 1;
        println(pad + "EXPR IF @" + il + ":" + ic);
        pos = parse_expr_dump(toks, pos, depth + 1);
        pos = parse_block_dump(toks, pos, depth + 1);
        if pos < n {
            if field_at(list_get(toks, pos), 0) == "KW_ELSE" {
                pos = pos + 1;
                println(pad + "ELSE");
                if field_at(list_get(toks, pos), 0) == "KW_IF" {
                    // else if as nested IF expr block
                    pos = parse_expr_dump(toks, pos, depth + 1);
                } else {
                    pos = parse_block_dump(toks, pos, depth + 1);
                }
            }
        }
        return pos;
    }
    // fallback skip one
    println(pad + "EXPR VAR " + text + " @" + line + ":" + col);
    return pos + 1;
}

pub fn typecheck_ann_and_return_lits(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    let mut expected_ret = "";
    let mut brace_depth = 0;
    let mut in_fn = false;
    // R1: `type T = Int;` alias table for annotation checks.
    let mut aliases = "\t";
    // Seed with params + lets (build_pure_lit_env) so `return o.inner.v` with
    // struct-typed params is fail-closed — was silent OK when lit_env was lets-only.
    let mut lit_env = build_pure_lit_env(toks);
    // Declared fn returns for `let x = g()` zero-arg binding into lit_env.
    let ret_table = build_fn_ret_table(toks);
    let struct_table = build_struct_field_table(toks);
    // Pass 0: collect type aliases (top-level token stream).
    let mut ai = 0;
    while ai < n {
        let ak = field_at(list_get(toks, ai), 0);
        if ak == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    let base = field_at(list_get(toks, ai + 3), 3);
                                    if base != "struct" {
                                        aliases = aliases + aname + ":" + base + "\t";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        let line = field_at(list_get(toks, i), 1);
        let col = field_at(list_get(toks, i), 2);

        // NOTE: OODA && does not short-circuit — never list_get in the same
        // expression as a bounds check (stack-safe sequential guards).
        let mut is_fn_head = false;
        if k == "KW_FN" {
            is_fn_head = true;
        } else {
            if k == "KW_PUB" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "KW_FN" {
                        is_fn_head = true;
                    }
                }
            }
        }
        if is_fn_head {
            // New function: capture return type after -> if present before body LBRACE.
            expected_ret = "";
            in_fn = true;
            brace_depth = 0;
            let mut j = i;
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        j = j + 1;
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                let raw_ret = field_at(list_get(toks, j), 3);
                                expected_ret = resolve_type_alias(aliases, raw_ret);
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        } else if k == "LBRACE" {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            if brace_depth == 0 {
                in_fn = false;
                expected_ret = "";
            }
            i = i + 1;
        } else if k == "KW_LET" {
            // let [mut] name [: Type] = init ;
            let mut p = i + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let vname = field_at(list_get(toks, p), 3);
                let vline = field_at(list_get(toks, p), 1);
                let vcol = field_at(list_get(toks, p), 2);
                p = p + 1;
                let mut ann_raw = "";
                let mut ann = "";
                if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                    p = p + 1;
                    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                        ann_raw = field_at(list_get(toks, p), 3);
                        ann = resolve_type_alias(aliases, ann_raw);
                        p = p + 1;
                    }
                }
                if p < n && field_at(list_get(toks, p), 0) == "EQ" {
                    p = p + 1;
                    if p < n {
                        // Pure lit / lit-env IDENT / binops / zero-arg call g().
                        let mut init_ty = infer_typed_expr_type(toks, p, lit_env);
                        // Field chain init: `let s: String = o.inner.v` — do not
                        // treat root type Outer as the whole expr (was silent OK
                        // when ann matched Outer).
                        if field_at(list_get(toks, p), 0) == "IDENT" {
                            let mut re = p;
                            let mut cont_i = true;
                            while cont_i {
                                if re >= n {
                                    cont_i = false;
                                } else {
                                    if field_at(list_get(toks, re), 0) == "SEMI" {
                                        cont_i = false;
                                    } else {
                                        re = re + 1;
                                    }
                                }
                            }
                            if is_field_chain_span(toks, p, re) {
                                let fty = field_chain_type(
                                    toks,
                                    p,
                                    re,
                                    lit_env,
                                    struct_table
                                );
                                if fty != "" {
                                    init_ty = fty;
                                }
                            }
                        }
                        if init_ty == "" {
                            if field_at(list_get(toks, p), 0) == "IDENT" {
                                if p + 2 < n {
                                    if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                        if field_at(list_get(toks, p + 2), 0) == "RPAREN" {
                                            let cname = field_at(list_get(toks, p), 3);
                                            let got = resolve_type_alias(ret_table, cname);
                                            if got != cname {
                                                init_ty = resolve_type_alias(aliases, got);
                                            }
                                        }
                                    }
                                }
                                // `let p = Point { ... }`
                                if init_ty == "" {
                                    if field_at(list_get(toks, p + 1), 0) == "LBRACE" {
                                        init_ty = field_at(list_get(toks, p), 3);
                                    }
                                }
                            }
                        }
                        if init_ty == "ERR_DIV0" {
                            println(
                                "ERR\ttype\tType error at "
                                    + vline
                                    + ":"
                                    + vcol
                                    + ": division by zero in initializer for '"
                                    + vname
                                    + "'"
                            );
                            process_exit(1);
                        }
                        if init_ty == "ERR_BINOP" {
                            println(
                                "ERR\ttype\tType error at "
                                    + vline
                                    + ":"
                                    + vcol
                                    + ": incompatible operand types in initializer for '"
                                    + vname
                                    + "'"
                            );
                            process_exit(1);
                        }
                        if init_ty != "" {
                            if ann != "" {
                                if !types_compatible(ann, init_ty) {
                                    println(
                                        "ERR\ttype\tType error at "
                                            + vline
                                            + ":"
                                            + vcol
                                            + ": let '"
                                            + vname
                                            + "' annotated as "
                                            + ann_raw
                                            + " but initializer has type "
                                            + init_ty
                                    );
                                    process_exit(1);
                                }
                                lit_env = lit_env + vname + ":" + ann + "\t";
                            } else {
                                lit_env = lit_env + vname + ":" + init_ty + "\t";
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else if k == "KW_RETURN" {
            if in_fn {
                if expected_ret != "" {
                    if i + 1 < n {
                        let ik = field_at(list_get(toks, i + 1), 0);
                        let mut rty = lit_token_type(ik);
                        // `return x` / `return p.x` / `return o.inner.v`
                        if rty == "" {
                            if ik == "IDENT" {
                                // Prefer field chain when next token is DOT.
                                let mut re = i + 1;
                                let mut cont_r = true;
                                while cont_r {
                                    if re >= n {
                                        cont_r = false;
                                    } else {
                                        if field_at(list_get(toks, re), 0) == "SEMI" {
                                            cont_r = false;
                                        } else {
                                            re = re + 1;
                                        }
                                    }
                                }
                                if is_field_chain_span(toks, i + 1, re) {
                                    let fty = field_chain_type(
                                        toks,
                                        i + 1,
                                        re,
                                        lit_env,
                                        struct_table
                                    );
                                    if fty != "" {
                                        rty = fty;
                                    }
                                }
                                // Bare `return x;` only when next token is SEMI —
                                // not `return o.inner.v + 1` (root type alone is a lie).
                                if rty == "" {
                                    if i + 2 < n {
                                        if field_at(list_get(toks, i + 2), 0) == "SEMI" {
                                            let rn = field_at(list_get(toks, i + 1), 3);
                                            let got = resolve_type_alias(lit_env, rn);
                                            if got != rn {
                                                rty = got;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if rty != "" {
                            if !types_compatible(expected_ret, rty) {
                                println(
                                    "ERR\ttype\tType error at "
                                        + line
                                        + ":"
                                        + col
                                        + ": return type "
                                        + rty
                                        + " does not match declared "
                                        + expected_ret
                                );
                                process_exit(1);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else {
            // Free binop: pure lit or lit-env IDENT operands — fail-closed.
            // e.g. `1 + "a"` and `let a=1; let b="x"; a + b;`
            let lty = atom_type_with_env(toks, i, lit_env);
            if lty != "" {
                if i + 2 < n {
                    let opk = field_at(list_get(toks, i + 1), 0);
                    if is_type_binop(opk) {
                        let rtok = list_get(toks, i + 2);
                        let rty = atom_type_with_env(toks, i + 2, lit_env);
                        if rty != "" {
                            // Const integer /0 and /0.0 — fail-closed (stage-0 parity).
                            if opk == "SLASH" {
                                if field_at(rtok, 3) == "0" {
                                    println(
                                        "ERR\ttype\tType error at "
                                            + line
                                            + ":"
                                            + col
                                            + ": integer division by zero"
                                    );
                                    process_exit(1);
                                }
                                if field_at(rtok, 3) == "0.0" {
                                    println(
                                        "ERR\ttype\tType error at "
                                            + line
                                            + ":"
                                            + col
                                            + ": float division by zero"
                                    );
                                    process_exit(1);
                                }
                            }
                            let comb = combine_binop_types(opk, lty, rty);
                            if comb == "ERR_BINOP" {
                                println(
                                    "ERR\ttype\tType error at "
                                        + line
                                        + ":"
                                        + col
                                        + ": incompatible operand types for binary operator"
                                );
                                process_exit(1);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
}

// Map literal token kinds to type names; "" = not a known literal.
pub fn typecheck_call_arg_lits(toks: List[String]) {
    let n = list_len(toks);
    // Resolve `type Alias = Base` so `f(a: T)` checks against Base.
    let mut aliases = "\t";
    // Declared returns for `let x = g()` / `f(g())`.
    let ret_table = build_fn_ret_table(toks);
    let struct_table = build_struct_field_table(toks);
    // Params + lets so `f(o.inner.v)` with struct-typed params fail-closed.
    let mut lit_env = build_pure_lit_env(toks);
    let mut ai = 0;
    while ai < n {
        let ak = field_at(list_get(toks, ai), 0);
        if ak == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    let base = field_at(list_get(toks, ai + 3), 3);
                                    // Keep struct type names out of simple aliases.
                                    if base != "struct" {
                                        aliases = aliases + aname + ":" + base + "\t";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if ak == "KW_LET" {
            let mut p = ai + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let vname = field_at(list_get(toks, p), 3);
                    p = p + 1;
                    let mut ann = "";
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "COLON" {
                            p = p + 1;
                            if p < n {
                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                    ann = resolve_type_alias(aliases, field_at(list_get(toks, p), 3));
                                    p = p + 1;
                                }
                            }
                        }
                    }
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "EQ" {
                            p = p + 1;
                            if p < n {
                                let mut ity = infer_typed_expr_type(toks, p, lit_env);
                                // Zero-arg call: let x = g();
                                if ity == "" {
                                    if field_at(list_get(toks, p), 0) == "IDENT" {
                                        if p + 2 < n {
                                            if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                                if field_at(list_get(toks, p + 2), 0) == "RPAREN" {
                                                    let cname = field_at(list_get(toks, p), 3);
                                                    let got = resolve_type_alias(ret_table, cname);
                                                    if got != cname {
                                                        ity = resolve_type_alias(aliases, got);
                                                    }
                                                }
                                            }
                                        }
                                        // `let p = Point { ... }`
                                        if ity == "" {
                                            if field_at(list_get(toks, p + 1), 0) == "LBRACE" {
                                                ity = field_at(list_get(toks, p), 3);
                                            }
                                        }
                                    }
                                }
                                if ity != "" {
                                    if ity != "ERR_DIV0" {
                                        if ity != "ERR_BINOP" {
                                            if ann != "" {
                                                lit_env = lit_env + vname + ":" + ann + "\t";
                                            } else {
                                                lit_env = lit_env + vname + ":" + ity + "\t";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let mut table = "\t";
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    let fname = field_at(list_get(toks, i + 1), 3);
                    let mut p = i + 2;
                    let mut cont = true;
                    while cont {
                        if p >= n {
                            cont = false;
                        } else {
                            if field_at(list_get(toks, p), 0) == "LPAREN" {
                                cont = false;
                            } else {
                                p = p + 1;
                            }
                        }
                    }
                    let mut types = "";
                    let mut depth = 0;
                    let mut cont2 = true;
                    while cont2 {
                        if p >= n {
                            cont2 = false;
                        } else {
                            let kk = field_at(list_get(toks, p), 0);
                            if kk == "LPAREN" {
                                depth = depth + 1;
                            }
                            if kk == "RPAREN" {
                                depth = depth - 1;
                                if depth == 0 {
                                    cont2 = false;
                                }
                            }
                            if depth == 1 {
                                if kk == "COLON" {
                                    if p + 1 < n {
                                        if field_at(list_get(toks, p + 1), 0) == "IDENT" {
                                            let raw = field_at(list_get(toks, p + 1), 3);
                                            types = types + resolve_type_alias(aliases, raw) + ",";
                                        } else {
                                            types = types + "_,";
                                        }
                                    }
                                }
                            }
                            p = p + 1;
                        }
                    }
                    table = table + fname + ":" + types + "\t";
                }
            }
        }
        i = i + 1;
    }
    // Pass 2: calls with lit args
    i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                    let mut skip = false;
                    if i > 0 {
                        let pk = field_at(list_get(toks, i - 1), 0);
                        if pk == "DOT" || pk == "KW_FN" {
                            skip = true;
                        }
                    }
                    if !skip {
                        let fname = field_at(list_get(toks, i), 3);
                        let line = field_at(list_get(toks, i), 1);
                        let col = field_at(list_get(toks, i), 2);
                        // find types in table
                        let key = "\t" + fname + ":";
                        if table.contains(key) {
                            // extract types string after key until \t
                            // manual scan
                            let tn = chars_len(table);
                            let kn = chars_len(key);
                            let mut pos = 0;
                            let mut found = false;
                            let mut types = "";
                            while pos + kn <= tn {
                                let mut m = true;
                                let mut j = 0;
                                while j < kn {
                                    if char_at(table, pos + j) != char_at(key, j) {
                                        m = false;
                                        j = kn;
                                    } else {
                                        j = j + 1;
                                    }
                                }
                                if m {
                                    found = true;
                                    let mut p = pos + kn;
                                    while p < tn {
                                        let c = char_at(table, p);
                                        if c == "\t" {
                                            p = tn;
                                        } else {
                                            types = types + c;
                                            p = p + 1;
                                        }
                                    }
                                    pos = tn;
                                } else {
                                    pos = pos + 1;
                                }
                            }
                            if found {
                                // parse call args that are pure single lits
                                let mut p = i + 2; // after LPAREN
                                let mut arg_i = 0;
                                let mut depth = 1;
                                let mut cont = true;
                                let mut arg_start = p;
                                while cont {
                                    if p >= n {
                                        cont = false;
                                    } else {
                                        let kk = field_at(list_get(toks, p), 0);
                                        if kk == "LPAREN" {
                                            depth = depth + 1;
                                        }
                                        if kk == "RPAREN" {
                                            depth = depth - 1;
                                            if depth == 0 {
                                                // finish last arg
                                                if p > arg_start {
                                                    let aty = resolve_arg_type(
                                                        toks,
                                                        arg_start,
                                                        p,
                                                        lit_env,
                                                        ret_table,
                                                        aliases,
                                                        struct_table
                                                    );
                                                    if aty != "" {
                                                        let ety = nth_csv(types, arg_i);
                                                        if ety != "" {
                                                            if ety != "_" {
                                                                if !types_compatible(ety, aty) {
                                                                    println(
                                                                        "ERR\ttype\tType error at "
                                                                            + line
                                                                            + ":"
                                                                            + col
                                                                            + ": argument "
                                                                            + arg_i.to_string()
                                                                            + " of '"
                                                                            + fname
                                                                            + "' expects "
                                                                            + ety
                                                                            + " but got "
                                                                            + aty
                                                                    );
                                                                    process_exit(1);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                cont = false;
                                            }
                                        }
                                        if kk == "COMMA" {
                                            if depth == 1 {
                                                let aty = resolve_arg_type(
                                                    toks,
                                                    arg_start,
                                                    p,
                                                    lit_env,
                                                    ret_table,
                                                    aliases,
                                                    struct_table
                                                );
                                                if aty != "" {
                                                    let ety = nth_csv(types, arg_i);
                                                    if ety != "" {
                                                        if ety != "_" {
                                                            if !types_compatible(ety, aty) {
                                                                println(
                                                                    "ERR\ttype\tType error at "
                                                                        + line
                                                                        + ":"
                                                                        + col
                                                                        + ": argument "
                                                                        + arg_i.to_string()
                                                                        + " of '"
                                                                        + fname
                                                                        + "' expects "
                                                                        + ety
                                                                        + " but got "
                                                                        + aty
                                                                );
                                                                process_exit(1);
                                                            }
                                                        }
                                                    }
                                                }
                                                arg_i = arg_i + 1;
                                                arg_start = p + 1;
                                            }
                                        }
                                        p = p + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Type of a call argument span [start, end): lit, lit-env IDENT, zero-arg call, or field access.
pub fn typecheck_refinements(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    
    let mut ret_bound_min = 0;
    let mut ret_bound_max = 0;
    let mut has_ret_bound = false;
    
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        
        if k == "KW_FN" {
            let mut j = i;
            let mut found = false;
            while j < n {
                if field_at(list_get(toks, j), 0) == "LBRACE" { break; }
                if field_at(list_get(toks, j), 0) == "ARROW" {
                    if j + 6 < n {
                        if field_at(list_get(toks, j+1), 3) == "Int" {
                            if field_at(list_get(toks, j+2), 0) == "LBRACKET" {
                                if field_at(list_get(toks, j+3), 0) == "INT" {
                                    if field_at(list_get(toks, j+4), 0) == "DOTDOT" {
                                        if field_at(list_get(toks, j+5), 0) == "INT" {
                                            if field_at(list_get(toks, j+6), 0) == "RBRACKET" {
                                                ret_bound_min = parse_int(field_at(list_get(toks, j+3), 3));
                                                ret_bound_max = parse_int(field_at(list_get(toks, j+5), 3));
                                                has_ret_bound = true;
                                                found = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                j = j + 1;
            }
            if !found { has_ret_bound = false; }
        }
        
        if k == "KW_RETURN" {
            if has_ret_bound {
                if i + 1 < n {
                    if field_at(list_get(toks, i+1), 0) == "INT" {
                        let val = parse_int(field_at(list_get(toks, i+1), 3));
                        if val < ret_bound_min || val > ret_bound_max {
                            let line = field_at(list_get(toks, i+1), 1);
                            let col = field_at(list_get(toks, i+1), 2);
                            println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
                            process_exit(1);
                        }
                    }
                }
            }
        }
        
        if k == "KW_LET" {
            if i + 10 < n {
                if field_at(list_get(toks, i+2), 0) == "COLON" {
                    if field_at(list_get(toks, i+3), 3) == "Int" {
                        if field_at(list_get(toks, i+4), 0) == "LBRACKET" {
                            if field_at(list_get(toks, i+5), 0) == "INT" {
                                if field_at(list_get(toks, i+6), 0) == "DOTDOT" {
                                    if field_at(list_get(toks, i+7), 0) == "INT" {
                                        if field_at(list_get(toks, i+8), 0) == "RBRACKET" {
                                            if field_at(list_get(toks, i+9), 0) == "EQ" {
                                                if field_at(list_get(toks, i+10), 0) == "INT" {
                                                    let min = parse_int(field_at(list_get(toks, i+5), 3));
                                                    let max = parse_int(field_at(list_get(toks, i+7), 3));
                                                    let mut val = parse_int(field_at(list_get(toks, i+10), 3));
                                                    
                                                    let mut end_tok = i + 10;
                                                    
                                                    if i + 12 < n {
                                                        let op = field_at(list_get(toks, i+11), 0);
                                                        if op == "PLUS" || op == "MINUS" || op == "STAR" || op == "SLASH" {
                                                            if field_at(list_get(toks, i+12), 0) == "INT" {
                                                                let val2 = parse_int(field_at(list_get(toks, i+12), 3));
                                                                if op == "PLUS" { val = val + val2; }
                                                                else if op == "MINUS" { val = val - val2; }
                                                                else if op == "STAR" { val = val * val2; }
                                                                else if op == "SLASH" {
                                                                    if val2 != 0 { val = val / val2; }
                                                                }
                                                                end_tok = i + 12;
                                                            }
                                                        }
                                                    }
                                                    
                                                    if val < min || val > max {
                                                        let line = field_at(list_get(toks, end_tok), 1);
                                                        let col = field_at(list_get(toks, end_tok), 2);
                                                        println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
                                                        process_exit(1);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }



        if k == "IDENT" {
            if i + 3 < n {
                if field_at(list_get(toks, i+1), 0) == "LPAREN" {
                    if field_at(list_get(toks, i+2), 0) == "INT" {
                        if field_at(list_get(toks, i+3), 0) == "RPAREN" {
                            let call_name = field_at(list_get(toks, i), 3);
                            let arg_val = parse_int(field_at(list_get(toks, i+2), 3));
                            
                            // scan for function def
                            let mut scan = 0;
                            while scan < n {
                                if field_at(list_get(toks, scan), 0) == "KW_FN" {
                                    if scan + 11 < n {
                                        if field_at(list_get(toks, scan+1), 3) == call_name {
                                            if field_at(list_get(toks, scan+2), 0) == "LPAREN" {
                                                if field_at(list_get(toks, scan+4), 0) == "COLON" {
                                                    if field_at(list_get(toks, scan+5), 3) == "Int" {
                                                        if field_at(list_get(toks, scan+6), 0) == "LBRACKET" {
                                                            if field_at(list_get(toks, scan+7), 0) == "INT" {
                                                                if field_at(list_get(toks, scan+8), 0) == "DOTDOT" {
                                                                    if field_at(list_get(toks, scan+9), 0) == "INT" {
                                                                        if field_at(list_get(toks, scan+10), 0) == "RBRACKET" {
                                                                            let p_min = parse_int(field_at(list_get(toks, scan+7), 3));
                                                                            let p_max = parse_int(field_at(list_get(toks, scan+9), 3));
                                                                            if arg_val < p_min || arg_val > p_max {
                                                                                let line = field_at(list_get(toks, i+2), 1);
                                                                                let col = field_at(list_get(toks, i+2), 2);
                                                                                println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
                                                                                process_exit(1);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                scan = scan + 1;
                            }
                        }
                    }
                }
            }
        }

        if k == "IDENT" {
            let func_name = field_at(list_get(toks, i), 3);
            if func_name == "char_at" {
                if i + 5 < n {
                    if field_at(list_get(toks, i+1), 0) == "LPAREN" {
                        if field_at(list_get(toks, i+2), 0) == "STRING" {
                            if field_at(list_get(toks, i+3), 0) == "COMMA" {
                                if field_at(list_get(toks, i+4), 0) == "INT" {
                                    if field_at(list_get(toks, i+5), 0) == "RPAREN" {
                                        let s = field_at(list_get(toks, i+2), 3);
                                        let idx = parse_int(field_at(list_get(toks, i+4), 3));
                                        let length = chars_len(s);
                                        if idx < 0 || idx >= length {
                                            let line = field_at(list_get(toks, i), 1);
                                            let col = field_at(list_get(toks, i), 2);
                                            println("ERR\ttype\tType error at " + line + ":" + col + ": char_at index out of bounds");
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if func_name == "str_slice" {
                if i + 7 < n {
                    if field_at(list_get(toks, i+1), 0) == "LPAREN" {
                        if field_at(list_get(toks, i+2), 0) == "STRING" {
                            if field_at(list_get(toks, i+3), 0) == "COMMA" {
                                if field_at(list_get(toks, i+4), 0) == "INT" {
                                    if field_at(list_get(toks, i+5), 0) == "COMMA" {
                                        if field_at(list_get(toks, i+6), 0) == "INT" {
                                            if field_at(list_get(toks, i+7), 0) == "RPAREN" {
                                                let s = field_at(list_get(toks, i+2), 3);
                                                let start_idx = parse_int(field_at(list_get(toks, i+4), 3));
                                                let end_idx = parse_int(field_at(list_get(toks, i+6), 3));
                                                let length = chars_len(s);
                                                if start_idx < 0 || end_idx > length || start_idx > end_idx {
                                                    let line = field_at(list_get(toks, i), 1);
                                                    let col = field_at(list_get(toks, i), 2);
                                                    println("ERR\ttype\tType error at " + line + ":" + col + ": str_slice out of bounds");
                                                    process_exit(1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if k == "IDENT" {
            if i + 2 < n {
                if field_at(list_get(toks, i+1), 0) == "EQ" {
                    if field_at(list_get(toks, i+2), 0) == "INT" {
                        let target_var = field_at(list_get(toks, i), 3);
                        let val = parse_int(field_at(list_get(toks, i+2), 3));
                        
                        let mut j = i - 1;
                        while j >= 0 {
                            if field_at(list_get(toks, j), 0) == "KW_LET" {
                                let mut off = 1;
                                if j + 1 < i {
                                    if field_at(list_get(toks, j+1), 0) == "KW_MUT" {
                                        off = 2;
                                    }
                                }
                                if j + off + 9 < i {
                                    if field_at(list_get(toks, j+off), 3) == target_var {
                                        if field_at(list_get(toks, j+off+1), 0) == "COLON" {
                                            if field_at(list_get(toks, j+off+2), 3) == "Int" {
                                                if field_at(list_get(toks, j+off+3), 0) == "LBRACKET" {
                                                    if field_at(list_get(toks, j+off+4), 0) == "INT" {
                                                        if field_at(list_get(toks, j+off+5), 0) == "DOTDOT" {
                                                            if field_at(list_get(toks, j+off+6), 0) == "INT" {
                                                                if field_at(list_get(toks, j+off+7), 0) == "RBRACKET" {
                                                                    let min = parse_int(field_at(list_get(toks, j+off+4), 3));
                                                                    let max = parse_int(field_at(list_get(toks, j+off+6), 3));
                                                                    if val < min || val > max {
                                                                        let line = field_at(list_get(toks, i+2), 1);
                                                                        let col = field_at(list_get(toks, i+2), 2);
                                                                        println("ERR\ttype\tType error at " + line + ":" + col + ": RefinementTypeViolation");
                                                                        process_exit(1);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        break;
                                    }
                                }
                            }
                            j = j - 1;
                        }
                    }
                }
            }
        }
        
        i = i + 1;
    }
}


