// shell_sq lives in diag_json.oo (imported) — POSIX single-quote escape for sh -c.

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    // Parse: oodac [--backend c|wasm|llvm] <cmd> <file> [out]
    if list_len(args) < 1 {
        println("oodac: usage: [--backend c|wasm|llvm] tokens|ast|check|build|emit-c|emit-wasm|emit-llvm|outline|reflect <file>");
        process_exit(2);
    }
    let mut cmd: String = "";
    let mut path: String = "";
    let mut out_arg: String = "";
    let mut backend: String = "c";
    let mut json_errors: Bool = false;
    let mut is_json: Bool = false;
    let mut hitl_required: Bool = false;
    let mut hitl_allowed: Bool = false;
    let mut runtime_cap_required: Bool = false;
    let mut npos: Int = 0;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--backend" {
            if i + 1 >= list_len(args) { println("ERR\tbackend\tmissing value"); process_exit(2); }
            let bv: String = list_get(args, i + 1);
            if bv != "c" && bv != "wasm" && bv != "llvm" { println("ERR\tbackend\t" + bv + " residual"); process_exit(2); }
            backend = bv;
            i = i + 2;
        } else if a == "--json-errors" || a == "-json" { json_errors = true; i = i + 1; }
        else if a == "--json" { is_json = true; i = i + 1; }
        else if a == "--hitl-required" { hitl_required = true; i = i + 1; }
        else if a == "--hitl-allowed" { hitl_allowed = true; i = i + 1; }
        else if a == "--runtime-cap-required" { runtime_cap_required = true; i = i + 1; }
        else {
            if npos == 0 { cmd = a; }
            else if npos == 1 { path = a; }
            else if npos == 2 { out_arg = a; }
            else { println("oodac: too many arguments"); process_exit(2); }
            npos = npos + 1;
            i = i + 1;
        }
    }
    if cmd == "" {
        cmd = "build";
        path = "test.oo";
        out_arg = "test.bin";
        backend = "llvm";
    }
    if path == "" {
        println("oodac: missing file argument");
        process_exit(2);
    }
    if !path_exists(fs, path) {
        println("ERR\t" + cmd + "\tunreadable file: " + path);
        process_exit(2);
    }
    // H6: per-file size gate before read (lex is O(n²) char_at — 64KiB max)
    let fsz: Int = file_size(fs, path);
    if fsz > 65536 {
        println("ERR\tload\tsource exceeds 64KiB per-file limit");
        process_exit(1);
    }

    // M-CTZ-1: --hitl-required → re-invoke oodac with OODA_HITL_REQUIRED=1 in
    // the env so c_emit.oo bakes the compile-time #define into every emitted
    // TU. The re-invocation uses `exec` in the child shell to avoid an extra
    // process. Only meaningful for commands that emit C (build + emit-c
    // family); for other commands the flag is a no-op.
    if hitl_required
        && (cmd == "build" || cmd == "emit-c" || cmd == "emit-protos"
            || cmd == "emit-bodies" || cmd == "emit-preamble")
    {
        let mut re_cmd: String = "OODA_HITL_REQUIRED=1 exec \"${OODAC_BIN:-./oodac/oodac}\"";
        if backend != "" && backend != "c" {
            re_cmd = re_cmd + " --backend " + backend;
        }
        if json_errors {
            re_cmd = re_cmd + " --json-errors";
        }
        if is_json {
            re_cmd = re_cmd + " --json";
        }
        re_cmd = re_cmd + " " + shell_sq(cmd) + " " + shell_sq(path);
        if out_arg != "" {
            re_cmd = re_cmd + " " + shell_sq(out_arg);
        }
        let _rh: Result[String, String] = sys_exec(sys, "sh", "-c", re_cmd);
        process_exit(0);
    }

    if cmd == "build" {
        run_build_cmd(fs, sys, path, out_arg, backend);
        if runtime_cap_required {
            let mut cap_bin: String = out_arg;
            if cap_bin == "" { cap_bin = path + ".bin"; }
            let cap_script: String = "bin=" + shell_sq(cap_bin) + "\nfor sym in oo_cap_require_fs oo_cap_require_sys oo_cap_require_env oo_cap_require_net oo_cap_require_time oo_cap_require_rand oo_cap_require_alloc oo_cap_require_thread oo_cap_require_gpu oo_cap_require_ffi oo_cap_require_hitl oo_cap_require_audit; do\n  nm \"$bin\" 2>/dev/null | grep -wq \"$sym\" || { printf 'ERR\\tlink\\tmissing cap require: %s\\n' \"$sym\" 1>&2; exit 1; }\ndone";
            let cr_res: Result[String, String] = sys_exec(sys, "sh", "-c", cap_script);
            if !cr_res.is_ok() { process_exit(1); }
        }
        return;
    }
    if cmd == "emit-c" || cmd == "emit-protos" || cmd == "emit-bodies" || cmd == "emit-preamble" {
        run_emit_c_family(fs, sys, cmd, path);
        return;
    }
    if cmd == "check" {
        if json_errors { run_check_json_errors(fs, sys, path); return; }
        // M-CTZ-2: --hitl-allowed threads explicit CLI gate into HITL check.
        // Bypass cached run_check_path so the flag reaches check_hitl_deny.
        if hitl_allowed {
            let src_h: String = load_source_with_imports(fs, path);
            run_check_core(sys, src_h);
            println("OK");
            return;
        }
        run_check_path(fs, sys, path);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "outline" {
        if is_json || out_arg == "--json" {
            ast_emit_outline_json(load_source_with_imports(fs, path));
        } else {
            ast_emit_outline(load_source_with_imports(fs, path));
        }
        return;
    }
    if cmd == "reflect" {
        ast_emit_reflect(load_source_with_imports(fs, path), out_arg);
        return;
    }
    if cmd == "run" {
        let src: String = load_source_with_imports(fs, path);
        run_check_core(sys, src);
        let bc: String = bc_emit_program(src);
        let ec: Int = 0 + vm_run_bytecode_caps(fs, sys, bc);
        process_exit(ec);
        return;
    }
    if cmd == "emit-bc" {
        let src: String = load_source_with_imports(fs, path);
        let bc: String = bc_emit_program(src);
        println(bc);
        return;
    }
    if cmd == "emit-wasm" {
        let src: String = load_source_with_imports(fs, path);
        run_check_core(sys, src);
        wasm_emit_stream(src);
        return;
    }
    if cmd == "emit-llvm" {
        let probe_concat: String = "if [ -n \"$EMIT_NO_CONCAT\" ]; then exit 0; else exit 1; fi";
        let no_concat_res = sys_exec(sys, "sh", "-c", probe_concat);
        let mut no_concat: Bool = false;
        if no_concat_res.is_ok() { no_concat = true; }
        let probe_pre: String = "if [ -n \"$EMIT_NO_PREAMBLE\" ]; then exit 0; else exit 1; fi";
        let no_pre_res = sys_exec(sys, "sh", "-c", probe_pre);
        let mut no_pre: Bool = false;
        if no_pre_res.is_ok() { no_pre = true; }
        let mut src: String = "";
        if no_concat {
            let src_r = read_file(fs, path);
            if src_r.is_ok() {
                src = match src_r { Ok(s) => s, Err(msg) => msg };
            } else {
                println("ERR\tload\tunreadable file: " + path);
                process_exit(1);
            }
        } else {
            src = load_source_with_imports(fs, path);
        }
        llvm_emit_stream(src, no_pre);
        return;
    }
    println("oodac: unknown command");
    process_exit(2);
}
