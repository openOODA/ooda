// openOODA oodac — CHS self-host frontend (M1–M5)
// Commands (argv): tokens <file> | ast <file> | check <file> | build <file>
// Token/AST dump formats match `ooda dump` (stage-0 canonical).

pub fn main(fs: &FsCap, args: List[String]) {
    if list_len(args) < 1 {
        println("oodac: usage: tokens|ast|check|build <file>");
        return;
    }
    let cmd = list_get(args, 0);
    if list_len(args) < 2 {
        println("oodac: missing file argument");
        return;
    }
    let path = list_get(args, 1);

    // tokens: real oodac lexer in .oo (M1), compared to stage-0 dump
    if cmd == "tokens" {
        let src_r = read_file(path);
        if src_r.is_err() {
            let e = match src_r {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\ttokens\t" + e);
            return;
        }
        let src = match src_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        dump_tokens(src);
        return;
    }

    // ast/check: exact stage-0 dumps via host_* (same code path as `ooda dump`)
    if cmd == "ast" {
        let d = host_ast_dump(path);
        print_dump(d);
        return;
    }
    if cmd == "check" {
        let d = host_check(path);
        print_dump(d);
        return;
    }

    // build: real CHS native compile (load+cap+type+C+gcc) via chs_build host
    // Optional out path as argv[2]; default "<src>.bin" next to CWD.
    if cmd == "build" {
        // Avoid if-expression for String (C backend lowers if-expr to int).
        let mut out = path + ".bin";
        if list_len(args) >= 3 {
            out = list_get(args, 2);
        }
        let r = chs_build(path, out);
        if r.is_ok() {
            println("OK\tbuild\t" + out);
        } else {
            let e = match r {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
        }
        return;
    }
    println("oodac: unknown command (use tokens|ast|check|build)");
}

// Print a multi-line dump string produced by host_* (already ends with newline).
pub fn print_dump(d: String) {
    // println adds a trailing newline; strip one if already present to avoid blank line.
    let n = chars_len(d);
    if n > 0 {
        let last = char_at(d, n - 1);
        if last == "\n" {
            // print without extra — use write via println of content without final nl
            if n > 1 {
                println(str_slice(d, 0, n - 1));
            }
        } else {
            println(d);
        }
    }
}

// ---- token dump (parity with `ooda dump tokens`) ----

pub fn dump_tokens(src: String) {
    let n = chars_len(src);
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    while i < n {
        let ch = char_at(src, i);
        if ch == " " {
            i = i + 1;
            col = col + 1;
        } else if ch == "\t" {
            i = i + 1;
            col = col + 1;
        } else if ch == "\n" {
            i = i + 1;
            line = line + 1;
            col = 1;
        } else if ch == "/" {
            // note: do not match "\\r" as carriage-return — OODA string escapes
            // currently treat "\\r" like "r", which would skip every letter r.
            // line comment //
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "/" {
                    i = i + 2;
                    col = col + 2;
                    let mut cont_c = true;
                    while cont_c {
                        if i >= n {
                            cont_c = false;
                        } else {
                            let c2 = char_at(src, i);
                            if c2 == "\n" {
                                cont_c = false;
                            } else {
                                i = i + 1;
                                col = col + 1;
                            }
                        }
                    }
                } else {
                    emit_tok("SLASH", line, col, "/");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("SLASH", line, col, "/");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "\"" {
            let start_line = line;
            let start_col = col;
            i = i + 1;
            col = col + 1;
            let mut s = "";
            let mut cont_s = true;
            while cont_s {
                if i >= n {
                    cont_s = false;
                } else {
                    let c2 = char_at(src, i);
                    if c2 == "\"" {
                        i = i + 1;
                        col = col + 1;
                        cont_s = false;
                    } else {
                        s = s + c2;
                        i = i + 1;
                        col = col + 1;
                    }
                }
            }
            emit_tok("STRING", start_line, start_col, s);
        } else if char_is_digit(ch) {
            let start_line = line;
            let start_col = col;
            let mut num = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_d = true;
            while cont_d {
                if i >= n {
                    cont_d = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_digit(c2) {
                        num = num + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_d = false;
                    }
                }
            }
            emit_tok("INT", start_line, start_col, num);
        } else if char_is_alpha(ch) || ch == "_" {
            let start_line = line;
            let start_col = col;
            let mut id = ch;
            i = i + 1;
            col = col + 1;
            let mut cont_id = true;
            while cont_id {
                if i >= n {
                    cont_id = false;
                } else {
                    let c2 = char_at(src, i);
                    if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                        id = id + c2;
                        i = i + 1;
                        col = col + 1;
                    } else {
                        cont_id = false;
                    }
                }
            }
            let kind = keyword_kind(id);
            emit_tok(kind, start_line, start_col, id);
        } else if ch == "+" {
            emit_tok("PLUS", line, col, "+");
            i = i + 1;
            col = col + 1;
        } else if ch == "-" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == ">" {
                    emit_tok("ARROW", line, col, "->");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("MINUS", line, col, "-");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("MINUS", line, col, "-");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "*" {
            emit_tok("STAR", line, col, "*");
            i = i + 1;
            col = col + 1;
        } else if ch == "=" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("EQEQ", line, col, "==");
                    i = i + 2;
                    col = col + 2;
                } else if nch == ">" {
                    emit_tok("FATARROW", line, col, "=>");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("EQ", line, col, "=");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("EQ", line, col, "=");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "!" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("NEQ", line, col, "!=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("BANG", line, col, "!");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("BANG", line, col, "!");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "<" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("LTE", line, col, "<=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("LT", line, col, "<");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("LT", line, col, "<");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ">" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "=" {
                    emit_tok("GTE", line, col, ">=");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("GT", line, col, ">");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("GT", line, col, ">");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "&" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "&" {
                    emit_tok("ANDAND", line, col, "&&");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("AMP", line, col, "&");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("AMP", line, col, "&");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "|" {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "|" {
                    emit_tok("OROR", line, col, "||");
                    i = i + 2;
                    col = col + 2;
                } else {
                    emit_tok("PIPE", line, col, "|");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("PIPE", line, col, "|");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == ":" {
            emit_tok("COLON", line, col, ":");
            i = i + 1;
            col = col + 1;
        } else if ch == ";" {
            emit_tok("SEMI", line, col, ";");
            i = i + 1;
            col = col + 1;
        } else if ch == "," {
            emit_tok("COMMA", line, col, ",");
            i = i + 1;
            col = col + 1;
        } else if ch == "." {
            let j = i + 1;
            if j < n {
                let nch = char_at(src, j);
                if nch == "." {
                    let k = j + 1;
                    if k < n {
                        let n2 = char_at(src, k);
                        if n2 == "=" {
                            emit_tok("DOTDOTEQ", line, col, "..=");
                            i = i + 3;
                            col = col + 3;
                        } else {
                            emit_tok("DOTDOT", line, col, "..");
                            i = i + 2;
                            col = col + 2;
                        }
                    } else {
                        emit_tok("DOTDOT", line, col, "..");
                        i = i + 2;
                        col = col + 2;
                    }
                } else {
                    emit_tok("DOT", line, col, ".");
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                emit_tok("DOT", line, col, ".");
                i = i + 1;
                col = col + 1;
            }
        } else if ch == "(" {
            emit_tok("LPAREN", line, col, "(");
            i = i + 1;
            col = col + 1;
        } else if ch == ")" {
            emit_tok("RPAREN", line, col, ")");
            i = i + 1;
            col = col + 1;
        } else if ch == "{" {
            emit_tok("LBRACE", line, col, "{");
            i = i + 1;
            col = col + 1;
        } else if ch == "}" {
            emit_tok("RBRACE", line, col, "}");
            i = i + 1;
            col = col + 1;
        } else if ch == "[" {
            emit_tok("LBRACKET", line, col, "[");
            i = i + 1;
            col = col + 1;
        } else if ch == "]" {
            emit_tok("RBRACKET", line, col, "]");
            i = i + 1;
            col = col + 1;
        } else if ch == "?" {
            emit_tok("QUESTION", line, col, "?");
            i = i + 1;
            col = col + 1;
        } else {
            // unknown — skip one char (lex error soft)
            i = i + 1;
            col = col + 1;
        }
    }
    emit_tok("EOF", line, col, "");
}

pub fn emit_tok(kind: String, line: Int, col: Int, text: String) {
    // KIND\tLINE\tCOL\tTEXT
    println(kind + "\t" + line.to_string() + "\t" + col.to_string() + "\t" + text);
}

pub fn keyword_kind(id: String) -> String {
    if id == "fn" {
        return "KW_FN";
    }
    if id == "pub" {
        return "KW_PUB";
    }
    if id == "let" {
        return "KW_LET";
    }
    if id == "mut" {
        return "KW_MUT";
    }
    if id == "import" {
        return "KW_IMPORT";
    }
    if id == "requires" {
        return "KW_REQUIRES";
    }
    if id == "ensures" {
        return "KW_ENSURES";
    }
    if id == "verify" {
        return "KW_VERIFY";
    }
    if id == "if" {
        return "KW_IF";
    }
    if id == "else" {
        return "KW_ELSE";
    }
    if id == "match" {
        return "KW_MATCH";
    }
    if id == "while" {
        return "KW_WHILE";
    }
    if id == "return" {
        return "KW_RETURN";
    }
    if id == "type" {
        return "KW_TYPE";
    }
    if id == "where" {
        return "KW_WHERE";
    }
    if id == "true" {
        return "KW_TRUE";
    }
    if id == "false" {
        return "KW_FALSE";
    }
    return "IDENT";
}

// AST dump / check / build are implemented via host_* and chs_build builtins
// (same Rust stage-0 paths as `ooda dump` / `ooda build --target c`).
