pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        println("oodac: usage: tokens|ast|check|build|emit-c <file>");
        process_exit(2);
    }
    let cmd = list_get(args, 0);
    if list_len(args) < 2 {
        println("oodac: missing file argument");
        process_exit(2);
    }
    let path = list_get(args, 1);

    if cmd == "build" {
        let mut out = path + ".bin";
        if list_len(args) >= 3 {
            out = list_get(args, 2);
        }
        let c_path = path + ".c";
        // Full shell program (sys_exec → system(last) only).
        // 1) Pure emit-c + gcc (stage-1 self-emit) for small CHS programs.
        // 2) If emit empty/fails: stage-0 host build when $OODA set (compiler recompile).
        let build_sh = "set -e; path=\""
            + path
            + "\"; out=\""
            + out
            + "\"; c_path=\""
            + c_path
            + "\"; rm -f \"$c_path\"; "
            + "if [ -n \"$OODAC_BIN\" ] && [ -x \"$OODAC_BIN\" ]; then "
            + "timeout 45 \"$OODAC_BIN\" emit-c \"$path\" > \"$c_path\" 2>/dev/null || true; "
            + "elif [ -x ./oodac/oodac ]; then "
            + "timeout 45 ./oodac/oodac emit-c \"$path\" > \"$c_path\" 2>/dev/null || true; "
            + "elif [ -x ./oodac/main ]; then "
            + "timeout 45 ./oodac/main emit-c \"$path\" > \"$c_path\" 2>/dev/null || true; "
            + "fi; "
            + "if [ -s \"$c_path\" ] && grep -qE 'int main|void oo_' \"$c_path\" 2>/dev/null; then "
            + "gcc -O2 -Iruntime runtime/chs_rt.c \"$c_path\" -lm -o \"$out\" && echo OK_PURE && exit 0; "
            + "fi; "
            + "if [ -n \"$OODA\" ] && [ -x \"$OODA\" ]; then "
            + "\"$OODA\" build --target c \"$path\" && "
            + "base=\"${path%.oo}\"; "
            + "if [ -x \"$base\" ]; then cp -f \"$base\" \"$out\"; echo OK_HOST; exit 0; fi; "
            + "fi; "
            + "echo FAIL_BUILD >&2; exit 1";
        let r2 = sys_exec(sys, "sh", "-c", build_sh);
        if r2.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            let e = match r2 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
    }

    let src_r = read_file(fs, path);
    if src_r.is_err() {
        let e = match src_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tload\t" + e);
        process_exit(1);
    }
    let mut src = match src_r {
        Ok(s) => s,
        Err(msg) => msg,
    };

    if cmd == "emit-c" {
        // Concat imports to temp file then read (native system() cannot capture stdout).
        let concat_tmp = path + ".concat.oo";
        let concat_cmd = "sh scripts/oodac_concat.sh \""
            + path
            + "\" > \""
            + concat_tmp
            + "\" 2>/dev/null";
        let r_concat = sys_exec(sys, "sh", "-c", concat_cmd);
        if r_concat.is_ok() {
            let cr = read_file(fs, concat_tmp);
            if cr.is_ok() {
                src = match cr {
                    Ok(s) => s,
                    Err(e) => src,
                };
            }
        }
        c_emit_stream(src);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(src);
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(src);
        return;
    }
    if cmd == "check" {
        run_check_from_src(src);
        return;
    }
    println("oodac: unknown command");
    process_exit(2);
}
