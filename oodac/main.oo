pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let a: List[String] = parse_cli_argv(fs, sys, args);
    let cmd: String = list_get(a, 0);
    let path: String = list_get(a, 1);
    let out_arg: String = list_get(a, 2);
    let backend: String = list_get(a, 3);
    let json_errors: Bool = list_get(a, 4) == "1";
    let is_json: Bool = list_get(a, 5) == "1";
    let target_triple: String = list_get(a, 6);
    let runtime_cap_required: Bool = list_get(a, 7) == "1";
    let opt_level: String = list_get(a, 8);
    let lto: Bool = list_len(a) > 9 && list_get(a, 9) == "1";
    let release: Bool = list_len(a) > 10 && list_get(a, 10) == "1";
    let is_dbg: Bool = list_len(a) > 11 && list_get(a, 11) == "1";
    let pgo_gen: Bool = list_len(a) > 12 && list_get(a, 12) == "1";
    let mut pgo_use: String = "";
    if list_len(a) > 13 { pgo_use = list_get(a, 13); }
    let mut sanitizers: String = "";
    if list_len(a) > 14 { sanitizers = list_get(a, 14); }

    if !json_errors {
        let _clr: Result[String, String] = sys_exec(sys, "sh", "-c", "rm -f .ooda-cache/ooda-tmp/json_errors.arm");
    }
    if cmd == "build" {
        run_build_san(fs, sys, path, out_arg, backend, opt_level, lto, release, is_dbg, false, target_triple, pgo_gen, pgo_use, sanitizers);
        if runtime_cap_required {
            let mut cap_bin: String = out_arg;
            if cap_bin == "" { cap_bin = path + ".bin"; }
            let cap_script: String = "bin=" + shell_sq(cap_bin) + "\nfor sym in oo_cap_require_fs oo_cap_require_sys oo_cap_require_env oo_cap_require_net oo_cap_require_time oo_cap_require_rand oo_cap_require_alloc oo_cap_require_thread oo_cap_require_gpu oo_cap_require_ffi oo_cap_require_audit; do\n  nm \"$bin\" 2>/dev/null | grep -wq \"$sym\" || { printf 'ERR\\tlink\\tmissing cap require: %s\\n' \"$sym\" 1>&2; exit 1; }\ndone";
            let cr_res: Result[String, String] = sys_exec(sys, "sh", "-c", cap_script);
            if !cr_res.is_ok() { process_exit(1); }
        }
        return;
    }
    if cmd == "emit-c" || cmd == "emit-protos" || cmd == "emit-bodies" || cmd == "emit-preamble" {
        run_emit_c_family(fs, sys, cmd, path);
        return;
    }
    if cmd == "check" {
        if json_errors { run_check_json_errors(fs, sys, path); return; }
        run_check_path(fs, sys, path);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "outline" {
        if is_json || out_arg == "--json" {
            ast_emit_outline_json(load_source_with_imports(fs, path));
        } else {
            ast_emit_outline(load_source_with_imports(fs, path));
        }
        return;
    }
    if cmd == "reflect" {
        ast_emit_reflect(load_source_with_imports(fs, path), out_arg);
        return;
    }
    if cmd == "run" {
        run_check_path(fs, sys, path);
        run_build_san(fs, sys, path, out_arg, backend, opt_level, lto, release, is_dbg, true, target_triple, pgo_gen, pgo_use, sanitizers);
        let mut bin = path + ".bin";
        if out_arg != "" { bin = out_arg; }
        let ran: Result[String, String] = sys_exec(sys, bin);
        if !ran.is_ok() { process_exit(1); }
        return;
    }
    if cmd == "emit-bc" {
        let src: String = load_source_with_imports(fs, path);
        let bc: String = bc_emit_program(src);
        println(bc);
        return;
    }
    if cmd == "emit-wasm" {
        let src: String = load_source_with_imports(fs, path);
        run_check_core(sys, src);
        wasm_emit_stream(src);
        return;
    }
    if cmd == "emit-llvm" { run_emit_llvm_san(fs, sys, path, backend, is_dbg, target_triple, sanitizers); return; }
    if cmd == "emit-graph" { run_print_llvm_graph(fs, path); return; }
    if cmd == "emit-fntab" { run_print_llvm_fntab(fs, path); return; }
    if cmd == "emit-mods" { run_emit_llvm_mods(fs, sys, path, out_arg); return; }
    if cmd == "emit-x86" { run_emit_x86(fs, path); return; }
    if cmd == "eval" { run_ooda_eval(fs, sys, args); return; }
    if cmd == "repl" { run_ooda_repl(fs, sys, args); return; }
    println("oodac: unknown command");
    process_exit(2);
}
