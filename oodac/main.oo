pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        println("oodac: usage: tokens|ast|check|build|emit-c <file>");
        process_exit(2);
    }
    let cmd = list_get(args, 0);
    if list_len(args) < 2 {
        println("oodac: missing file argument");
        process_exit(2);
    }
    let path = list_get(args, 1);

    if cmd == "build" {
        let mut out = path + ".bin";
        if list_len(args) >= 3 {
            out = list_get(args, 2);
        }
        let c_path = path + ".c";
        // Prefer self-host binary (OODAC_BIN / oodac/oodac) over stage-0 `ooda run`.
        // Pure CHS smoke must not require rustc or libooda on the link line.
        let emit_cmd = "if [ -n \"$OODAC_BIN\" ] && [ -x \"$OODAC_BIN\" ]; then \"$OODAC_BIN\" emit-c "
            + path
            + " > "
            + c_path
            + "; elif [ -x ./oodac/oodac ]; then ./oodac/oodac emit-c "
            + path
            + " > "
            + c_path
            + "; elif [ -x ./oodac/main ]; then ./oodac/main emit-c "
            + path
            + " > "
            + c_path
            + "; else ooda run oodac/main.oo -- emit-c "
            + path
            + " > "
            + c_path
            + "; fi";
        let r1 = sys_exec(sys, "sh", "-c", emit_cmd);
        if r1.is_err() {
            let e = match r1 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
        // C backend sys_exec only runs cargs.last() via system(3) — full shell line required.
        // Pure CHS: gcc + chs_rt only (no libooda). Host-FFI programs need stage-0.
        let gcc_cmd = "gcc -O2 -Iruntime runtime/chs_rt.c \""
            + c_path
            + "\" -lm -o \""
            + out
            + "\"";
        let r2 = sys_exec(sys, "sh", "-c", gcc_cmd);
        if r2.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            let e = match r2 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
    }

    let src_r = read_file(fs, path);
    if src_r.is_err() {
        let e = match src_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tload\t" + e);
        process_exit(1);
    }
    let mut src = match src_r {
        Ok(s) => s,
        Err(msg) => msg,
    };

    if cmd == "emit-c" {
        // Concat imports to temp file then read (native system() cannot capture stdout).
        let concat_tmp = path + ".concat.oo";
        let concat_cmd = "sh scripts/oodac_concat.sh \""
            + path
            + "\" > \""
            + concat_tmp
            + "\" 2>/dev/null";
        let r_concat = sys_exec(sys, "sh", "-c", concat_cmd);
        if r_concat.is_ok() {
            let cr = read_file(fs, concat_tmp);
            if cr.is_ok() {
                src = match cr {
                    Ok(s) => s,
                    Err(e) => src,
                };
            }
        }
        c_emit_stream(src);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(src);
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(src);
        return;
    }
    if cmd == "check" {
        run_check_from_src(src);
        return;
    }
    println("oodac: unknown command");
    process_exit(2);
}
