pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    // Parse: oodac [--backend c] <cmd> [--backend c] <file> [out]
    // Only Backend-C today; other backends fail-closed (bootstrap/FLOOR.md).
    if list_len(args) < 1 {
        println("oodac: usage: [--backend c] tokens|ast|check|build|emit-c <file>");
        process_exit(2);
    }
    let mut cmd = "";
    let mut path = "";
    let mut out_arg = "";
    let mut json_errors = false;
    let mut npos = 0;
    let mut i = 0;
    while i < list_len(args) {
        let a = list_get(args, i);
        if a == "--backend" {
            if i + 1 >= list_len(args) {
                println("ERR\tbackend\tmissing value (only c)");
                process_exit(2);
            }
            let bv = list_get(args, i + 1);
            if bv != "c" {
                println("ERR\tbackend\t" + bv + " residual (only c; see bootstrap/FLOOR.md)");
                process_exit(2);
            }
            i = i + 2;
        } else if a == "--json-errors" || a == "-json" {
            json_errors = true;
            i = i + 1;
        } else {
            if npos == 0 {
                cmd = a;
            } else if npos == 1 {
                path = a;
            } else if npos == 2 {
                out_arg = a;
            } else {
                println("oodac: too many arguments");
                process_exit(2);
            }
            npos = npos + 1;
            i = i + 1;
        }
    }
    if cmd == "" {
        println("oodac: usage: [--backend c] tokens|ast|check|build|emit-c <file>");
        process_exit(2);
    }
    if path == "" {
        println("oodac: missing file argument");
        process_exit(2);
    }

    if cmd == "build" {
        let mut out = path + ".bin";
        if out_arg != "" {
            out = out_arg;
        }
        let c_path = path + ".c";
        // PURE ONLY — Backend-C link recipe (no host soft-pass).
        // Multi-import: scripts/oodac_pure_build.sh. Single-file: emit-c + gcc.
        let build_sh = "set -e; path=\""
            + path
            + "\"; out=\""
            + out
            + "\"; "
            + "if grep -qE '^import ' \"$path\" 2>/dev/null; then "
            + "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" sh scripts/oodac_pure_build.sh \"$path\" \"$out\"; "
            + "exit $?; fi; "
            + "c_path=\""
            + c_path
            + "\"; rm -f \"$c_path\"; "
            + "EM=\"${OODAC_BIN:-}\"; "
            + "if [ -z \"$EM\" ] || [ ! -x \"$EM\" ]; then "
            + "if [ -x ./oodac/oodac ]; then EM=./oodac/oodac; "
            + "elif [ -x ./oodac/main ]; then EM=./oodac/main; "
            + "else echo ERR_NO_OODAC >&2; exit 1; fi; fi; "
            + "EMIT_NO_CONCAT=1 timeout 60 \"$EM\" emit-c \"$path\" > \"$c_path\" 2>/dev/null || true; "
            + "if [ ! -s \"$c_path\" ] || ! grep -qE 'int main|void ' \"$c_path\"; then "
            + "echo ERR_EMPTY_EMIT >&2; exit 1; fi; "
            + "if grep -qE $'^ERR\\tc_emit' \"$c_path\"; then echo ERR_EMIT >&2; exit 1; fi; "
            + "gcc -O2 -Iruntime runtime/chs_rt.c \"$c_path\" -lm -o \"$out\"; "
            + "test -x \"$out\"; echo OK_PURE";
        let r2 = sys_exec(sys, "sh", "-c", build_sh);
        if r2.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            let e = match r2 {
                Ok(s) => s,
                Err(msg) => msg,
            };
            println("ERR\tbuild\t" + e);
            process_exit(1);
        }
    }

    // tokens|ast|check: in-tree multi-file import expand (cycle/missing fail-closed)
    if cmd == "check" {
        if json_errors {
            run_check_json_errors(fs, sys, path);
            return;
        }
        run_check_from_src(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "tokens" {
        dump_tokens(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "ast" {
        dump_ast_from_src(load_source_with_imports(fs, path));
        return;
    }
    if cmd == "emit-c" {
        // Honesty: expand imports by default (bare emit-c of multi-file must not
        // produce incomplete C). EMIT_NO_CONCAT=1 → single file only (pure multi).
        let probe = "if [ -n \"$EMIT_NO_CONCAT\" ]; then exit 0; else exit 1; fi";
        let no_concat = sys_exec(sys, "sh", "-c", probe);
        let mut src = "";
        if no_concat.is_ok() {
            let src_r = read_file(fs, path);
            if src_r.is_err() {
                let e = match src_r {
                    Ok(s) => s,
                    Err(msg) => msg,
                };
                println("ERR\tload\t" + e);
                process_exit(1);
            }
            src = match src_r {
                Ok(s) => s,
                Err(msg) => msg,
            };
        } else {
            src = load_source_with_imports(fs, path);
        }
        c_emit_stream(src);
        return;
    }
    println("oodac: unknown command");
    process_exit(2);
}

