// job: token helpers for TYPESTATE walk; stage: check

pub fn ts_tok_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

pub fn ts_tok_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn ts_tok_line(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 1);
}

pub fn ts_skip_braces(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    let mut depth = 0;
    while pos < n {
        let k: String = ts_tok_kind(toks, pos);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" {
            depth = depth - 1;
            if depth == 0 { return pos + 1; }
        }
        pos = pos + 1;
    }
    return n;
}

pub fn ts_skip_semi(toks: List[String], i0: Int, hi: Int) -> Int {
    let mut i = i0;
    while i < hi {
        let k: String = ts_tok_kind(toks, i);
        if k == "SEMI" { return i + 1; }
        if k == "LBRACE" {
            i = ts_skip_braces(toks, i);
        } else {
            i = i + 1;
        }
    }
    return hi;
}

pub fn ts_after_ident(toks: List[String], i: Int) -> Int {
    let n = list_len(toks);
    if i + 1 < n {
        if ts_tok_kind(toks, i + 1) == "LPAREN" { return i + 2; }
        if ts_tok_kind(toks, i + 1) == "DOT" { return i + 4; }
    }
    return i + 1;
}
