// # Refuse discarded Result-returning calls
//
// Logline: A known Result call used as a trailing semicolon statement is unused.
//
// Setup: c_is_res_s_call and c_is_res_v_call exist. Ok Err Some are checked elsewhere.
//
// Beats:
//   1. Skip names that are assigned or returned.
//   2. Walk to the matching RPAREN.
//   3. If the next token is SEMI, print unused Result and exit.

pub fn typecheck_must_use_calls(toks: List[String]) {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "IDENT" {
            let name: String = field_at(list_get(toks, i), 3);
            let mut hit: Bool = false;
            if name != "Ok" {
                if name != "Err" {
                    if name != "Some" {
                        if c_is_res_s_call(name) {
                            hit = true;
                        }
                        if c_is_res_v_call(name) {
                            hit = true;
                        }
                    }
                }
            }
            if hit {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                        let mut assigned = false;
                        if i > 0 {
                            let pk: String = field_at(list_get(toks, i - 1), 0);
                            if pk == "EQ" || pk == "RETURN" || pk == "KW_RETURN" {
                                assigned = true;
                            }
                        }
                        if !assigned {
                            let mut p = i + 1;
                            let mut depth = 0;
                            let mut cont = true;
                            while cont {
                                if p >= n {
                                    cont = false;
                                } else {
                                    let kk: String = field_at(list_get(toks, p), 0);
                                    if kk == "LPAREN" {
                                        depth = depth + 1;
                                    }
                                    if kk == "RPAREN" {
                                        depth = depth - 1;
                                        if depth == 0 {
                                            if p + 1 < n {
                                                if field_at(list_get(toks, p + 1), 0) == "SEMI" {
                                                    let line: String = field_at(list_get(toks, i), 1);
                                                    let col: String = field_at(list_get(toks, i), 2);
                                                    println(
                                                        "ERR\ttype\tType error at "
                                                            + line
                                                            + ":"
                                                            + col
                                                            + ": unused Result (must-use; do not discard "
                                                            + name
                                                            + ")"
                                                    );
                                                    process_exit(1);
                                                }
                                            }
                                            cont = false;
                                        }
                                    }
                                    p = p + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
