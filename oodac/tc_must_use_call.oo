// # Refuse discarded Result-returning calls
//
// Logline: A known Result call used as a trailing semicolon statement is unused.
//
// Setup: c_is_res_s_call and c_is_res_v_call exist. Ok Err Some are checked elsewhere. tc_err_at prints path and caret.
//
// Beats:
//   1. Skip names that are assigned or returned.
//   2. Walk to the matching RPAREN.
//   3. If the next token is SEMI, tc_err_at unused Result.

fn tab_has(tab: String, name: String) -> Bool {
    let needle: String = "\t" + name + "\t";
    let n: Int = chars_len(tab);
    let m: Int = chars_len(needle);
    if m > n {
        return false;
    }
    let mut i: Int = 0;
    while i + m <= n {
        if str_slice(tab, i, i + m) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn typecheck_must_use_calls(toks: List[String]) {
    let n: Int = list_len(toks);
    let mut res_fns: String = "\t";
    let mut u: Int = 0;
    while u < n {
        if field_at(list_get(toks, u), 0) == "KW_FN" {
            if u + 1 < n {
                if field_at(list_get(toks, u + 1), 0) == "IDENT" {
                    let fnm: String = field_at(list_get(toks, u + 1), 3);
                    let mut v: Int = u + 2;
                    while v < n {
                        let vk: String = field_at(list_get(toks, v), 0);
                        if vk == "LBRACE" {
                            break;
                        }
                        if vk == "ARROW" {
                            if v + 1 < n {
                                if field_at(list_get(toks, v + 1), 3) == "Result" {
                                    res_fns = res_fns + fnm + "\t";
                                }
                            }
                        }
                        v = v + 1;
                    }
                }
            }
        }
        u = u + 1;
    }
    let mut i: Int = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "IDENT" {
            let name: String = field_at(list_get(toks, i), 3);
            let mut hit: Bool = false;
            if name != "Ok" {
                if name != "Err" {
                    if name != "Some" {
                        if c_is_res_s_call(name) {
                            hit = true;
                        }
                        if c_is_res_v_call(name) {
                            hit = true;
                        }
                        if tab_has(res_fns, name) {
                            hit = true;
                        }
                    }
                }
            }
            if hit {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                        let mut assigned = false;
                        if i > 0 {
                            let pk: String = field_at(list_get(toks, i - 1), 0);
                            if pk == "EQ" || pk == "RETURN" || pk == "KW_RETURN" {
                                assigned = true;
                            }
                        }
                        if !assigned {
                            let mut p = i + 1;
                            let mut depth = 0;
                            let mut cont = true;
                            while cont {
                                if p >= n {
                                    cont = false;
                                } else {
                                    let kk: String = field_at(list_get(toks, p), 0);
                                    if kk == "LPAREN" {
                                        depth = depth + 1;
                                    }
                                    if kk == "RPAREN" {
                                        depth = depth - 1;
                                        if depth == 0 {
                                            if p + 1 < n {
                                                if field_at(list_get(toks, p + 1), 0) == "SEMI" {
                                                    tc_err_at(
                                                        toks,
                                                        i,
                                                        "unused Result (must-use; do not discard "
                                                            + name
                                                            + ")"
                                                    );
                                                }
                                            }
                                            cont = false;
                                        }
                                    }
                                    p = p + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
