// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: C preamble (includes + runtime decls) for emit-c
// in:  none
// out: printed C headers
// stage: emit

pub fn c_emit_preamble() {
    println("#include <stdio.h>");
    println("#include <stdlib.h>");
    println("#include <string.h>");
    println("#include <stdbool.h>");
    println("#include <stddef.h>");
    println("#include <unistd.h>");
    println("/* runtime decls (defined in chs_rt.c) */");
    println("typedef struct { char *data; long long len; } OoStr;");
    println("typedef struct { long long *data; long long len; long long cap; } OoIList;");
    println("typedef struct { OoStr *data; long long len; long long cap; } OoSList;");
    println("typedef struct { int ok; OoStr val; } OoResS;");
    println("typedef struct { int ok; OoStr err; } OoResV;");
    println("OoStr oo_str_lit(const char*); OoStr oo_str_concat(OoStr,OoStr);");
    println("long long oo_str_byte_len(OoStr); long long oo_chars_len(OoStr);");
    println("OoStr oo_char_at(OoStr,long long); OoStr oo_str_slice(OoStr,long long,long long);");
    println("int oo_str_contains(OoStr,OoStr);");
    println("int oo_char_is_digit(OoStr); int oo_char_is_alpha(OoStr); int oo_char_is_space(OoStr);");
    println("OoIList oo_ilist_new(void); OoIList oo_ilist_push(OoIList,long long); void oo_ilist_free(OoIList);");
    println("long long oo_ilist_get(OoIList,long long); long long oo_ilist_len(OoIList);");
    println("void oo_str_retain(OoStr); void oo_str_release(OoStr);");
    println("void oo_slist_retain(OoSList); void oo_slist_release(OoSList);");
    println("void oo_ilist_retain(OoIList); void oo_ilist_release(OoIList);");
    println("OoSList oo_slist_new(void); OoSList oo_slist_push(OoSList,OoStr); void oo_slist_free(OoSList);");
    println("OoStr oo_slist_get(OoSList,long long); long long oo_slist_len(OoSList);");
    // Process-local caps: no fixed forgeable magic ints (R1).
    println("long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void);");
    println("long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);");
    println("long long oo_cap_grant_time(void); long long oo_cap_grant_rand(void);");
    println("long long oo_cap_grant_alloc(void); long long oo_cap_grant_ffi(void);");
    println("long long oo_cap_grant_thread(void); long long oo_cap_grant_gpu(void);");
    println("OoResS oo_dlopen(long long,OoStr); OoResS oo_dlsym(long long,OoStr,OoStr);");
    println("OoResS oo_dlclose(long long,OoStr);");
    println("OoStr crypto_md5_internal(OoStr); OoStr crypto_sha1_internal(OoStr);");
    println("OoStr crypto_aes_encrypt_internal(OoStr,OoStr);");
    println("long long oo_byte_at(OoStr,long long); long long oo_bytes_len(OoStr);");
    println("OoStr oo_byte_slice(OoStr,long long,long long); int oo_bytes_eq(OoStr,OoStr);");
    println("OoStr oo_bytes_from_str(OoStr); OoStr oo_bytes_concat(OoStr,OoStr);");
    println("OoIList oo_bytes_new(void); OoIList oo_bytes_push(OoIList,long long);");
    println("long long oo_bytes_get(OoIList,long long); OoStr oo_bytes_to_str(OoIList);");
    println("OoResS oo_tcp_bind(long long,long long); OoResS oo_tcp_connect(long long,OoStr,long long);");
    println("OoResS oo_bind_udp(long long,long long); OoResS oo_tls_connect(long long,OoStr,long long);");
    println("OoResS oo_tcp_write(long long,long long,OoStr); OoResS oo_tcp_read(long long,long long,long long);");
    println("OoResS oo_udp_recv(long long,long long,long long); OoResS oo_tcp_close(long long,long long);");
    println("OoResS oo_sock_raw(long long,long long);");
    println("OoResS oo_sys_spawn(long long,OoStr); OoResS oo_sys_wait(long long,long long);");
    println("OoResS oo_sys_kill(long long,long long,long long);");
    println("OoResS oo_sys_epoll_create(long long,long long); OoResS oo_sys_inotify_init(long long);");
    println("OoResS oo_sys_prctl(long long,long long);");
    println("OoResS oo_mutex_lock(long long,long long); OoResS oo_mutex_unlock(long long,long long);");
    println("OoResS oo_thread_spawn(long long,OoStr); OoResS oo_thread_join(long long,long long);");
    println("OoResS oo_thread_join_s(long long,OoStr); OoResS oo_gpu_launch(long long,OoStr);");
    println("OoResS oo_channel_new(long long); OoResS oo_channel_send(long long,long long,OoStr);");
    println("OoResS oo_channel_recv(long long,long long);");
    println("OoResS oo_actor_spawn(long long,OoStr); OoResS oo_actor_send(long long,long long,OoStr);");
    println("OoResS oo_actor_recv(long long,long long);");
    println("const char *oo_process_policy_getenv(const char*);");
    println("OoResS oo_verify_human(long long,long long,OoStr);");
    println("long long oo_now_ms(long long); void oo_sleep_ms(long long,long long);");
    println("long long oo_random(long long); void oo_seed(long long,long long);");
    println("long long oo_alloc_bytes(long long,long long); void oo_free_bytes(long long,long long);");
    println("long long oo_meta_epoch(void);");
    println("long long oo_meta_mix(long long);");
    println("int oo_meta_is_path_a(void);");
    println("void oo_meta_decoy_touch(void);");
    println("void oo_cap_require(long long,long long,const char*);");
    println("OoResS oo_read_file(long long,OoStr); OoResV oo_write_file(long long,OoStr,OoStr);");
    println("int oo_path_exists(long long,OoStr); long long oo_file_size(long long,OoStr); OoResS oo_env_get(long long,OoStr);");
    println("OoResS oo_sys_exec(long long,int,OoStr*); OoResS oo_sys_exec1(long long,OoStr);");
    println("OoResS oo_fetch(long long,OoStr);");
    println("void oo_print_str(OoStr); void oo_eprint_str(OoStr); void oo_print_int(long long); void oo_print_bool(int); void oo_print_double(double); void oo_println(void); void oo_eprintln(void);");
    println("double oo_sin(double); double oo_cos(double); double oo_ln(double);");
    println("double oo_exp(double); double oo_sqrt(double); double oo_pow(double,double);");
    println("int oo_str_eq(OoStr,OoStr); int oo_str_contains(OoStr,OoStr);");
    println("OoStr oo_int_to_str(long long); OoStr oo_str_trim(OoStr); OoStr oo_str_to_lowercase(OoStr);");
    println("OoStr oo_str_to_uppercase(OoStr); int oo_str_starts_with(OoStr,OoStr); int oo_str_ends_with(OoStr,OoStr);");
    println("long long oo_str_index_of(OoStr,OoStr); OoStr oo_str_repeat(OoStr,long long);");
    println("#define Some(v) (v)");
    println("#define None 0");
    println("typedef struct { long long kind; OoStr text; } Token;");
    println("static inline long long oo_str_to_int(OoStr s) { return s.data ? atoll(s.data) : 0LL; }");
    println("static inline long long oo_str_len(OoStr s) { return s.data ? (long long)strlen(s.data) : 0LL; }");
    println("static inline void oo_process_exit(long long c) { exit((int)c); }");
    println("static inline void oo_assert_eq_str(OoStr a, OoStr b) { if (!oo_str_eq(a, b)) { fprintf(stderr, \"Assertion failed: assert_eq\\n\"); exit(1); } }");
    println("static inline void oo_assert_eq_long(long long a, long long b) { if (a != b) { fprintf(stderr, \"Assertion failed: assert_eq\\n\"); exit(1); } }");
    println("static inline void oo_assert_eq_double(double a, double b) { if (a != b) { fprintf(stderr, \"Assertion failed: assert_eq\\n\"); exit(1); } }");
    // M161: Result[String,String] / OoResS structural equality for assert_eq / verify
    println("static inline int oo_res_eq(OoResS a, OoResS b) { return a.ok == b.ok && oo_str_eq(a.val, b.val); }");
    println("static inline void oo_assert_eq_ress(OoResS a, OoResS b) { if (!oo_res_eq(a, b)) { fprintf(stderr, \"Assertion failed: assert_eq\\n\"); exit(1); } }");
    println("#define oo_assert_eq(a, b) _Generic((a), OoStr: oo_assert_eq_str, OoResS: oo_assert_eq_ress, double: oo_assert_eq_double, float: oo_assert_eq_double, default: oo_assert_eq_long)((a), (b))");
    println("#define assert_eq(a, b) oo_assert_eq(a, b)");
    println("static inline void oo_assert_ne_str(OoStr a, OoStr b) { if (oo_str_eq(a, b)) { fprintf(stderr, \"Assertion failed: assert_ne\\n\"); exit(1); } }");
    println("static inline void oo_assert_ne_long(long long a, long long b) { if (a == b) { fprintf(stderr, \"Assertion failed: assert_ne\\n\"); exit(1); } }");
    println("static inline void oo_assert_ne_double(double a, double b) { if (a == b) { fprintf(stderr, \"Assertion failed: assert_ne\\n\"); exit(1); } }");
    println("static inline void oo_assert_ne_ress(OoResS a, OoResS b) { if (oo_res_eq(a, b)) { fprintf(stderr, \"Assertion failed: assert_ne\\n\"); exit(1); } }");
    println("#define oo_assert_ne(a, b) _Generic((a), OoStr: oo_assert_ne_str, OoResS: oo_assert_ne_ress, double: oo_assert_ne_double, float: oo_assert_ne_double, default: oo_assert_ne_long)((a), (b))");
    println("#define assert_ne(a, b) oo_assert_ne(a, b)");
    println("#define oo_assert(a) do { if (!(a)) { fprintf(stderr, \"Assertion failed: assert\\n\"); exit(1); } } while(0)");
    println("#define assert(a) oo_assert(a)");
    println("OoStr crypto_sha256_internal(OoStr); OoStr crypto_hmac_sha256_internal(OoStr,OoStr);");
    println("OoResS json_parse_internal(OoStr); OoStr json_stringify_internal(OoStr);");
    println("OoStr async_spawn_internal(long long,OoStr); OoResS async_join_internal(long long,OoStr);");
    println("OoResS python_embed_internal(long long,OoStr);");
    println("static inline void oo_seccomp_init(void) {");
    println("  struct sock_filter filter[] = {");
    println("    BPF_STMT(BPF_LD | BPF_W | BPF_ABS, (offsetof(struct seccomp_data, arch))),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 1, 0),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_STMT(BPF_LD | BPF_W | BPF_ABS, (offsetof(struct seccomp_data, nr))),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_execve, 0, 1),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_execveat, 0, 1),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_fork, 0, 1),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_vfork, 0, 1),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_ptrace, 0, 1),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),");
    println("    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW)");
    println("  };");
    println("  struct sock_fprog prog = { .len = (unsigned short)(sizeof(filter)/sizeof(filter[0])), .filter = filter };");
    println("  prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);");
    println("  prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &prog);");
    println("}");
}
