// # SysV stack frame for emit-x86 callees
//
// Logline: Prints AT&T enter as push/mov and leave as pop/ret for SysV callees.
//
// Setup: println exists. Callers wrap callee bodies; no imports.
//
// Beats:
//   1. Enter: push %rbp then mov %rsp, %rbp.
//   2. Leave: pop %rbp then ret. Do not emit leave or libc.
//
// residual: red zone, extra spills stay later.

pub fn x86_emit_frame_enter() {
    println("    push %rbp");
    println("    mov %rsp, %rbp");
}

pub fn x86_emit_frame_leave() {
    println("    pop %rbp");
    println("    ret");
}
