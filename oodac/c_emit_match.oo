// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: lower match on Result (OoResS / OoResV) to if (ok) / else
// stage: emit
// Forms: match r { Ok(x) => { ... } Err(e) => { ... } }
//        let n = match r { Ok(x) => expr Err(e) => expr };
// Arm separators: optional COMMA after each arm. Fail-closed if shape wrong.
// Match-assign (decl=0): put_last (M23) + reassign_arc so prior string released.
fn c_match_skip_comma(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
        p = p + 1;
    }
    return p;
}

// pos at KW_MATCH. Returns [new_pos, env].
pub fn c_emit_match_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let scrut = list_get(pr, 1);
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACE" {
        println("ERR\tc_emit\tmatch: expected { after scrutinee");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" || field_at(list_get(toks, p), 3) != "Ok" {
        println("ERR\tc_emit\tmatch: expected Ok(...) arm first");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Ok(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" { ok_bind = field_at(list_get(toks, p), 3); p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Ok(...)");
        process_exit(1);
    }
    p = p + 1;
    // Result kind: R = OoResS (.val both arms), V = OoResV (.err on Err)
    let mut rkind = "R";
    if c_env_get(env, scrut) == "V" {
        rkind = "V";
    }
    println("  {");
    if rkind == "V" {
        println("  OoResV __m = " + scrut + ";");
    } else {
        println("  OoResS __m = " + scrut + ";");
    }
    println("  if (__m.ok) {");
    if rkind == "V" {
        println("    (void)0; /* Ok arm: no payload on OoResV */");
    } else {
        println("    OoStr " + ok_bind + " = __m.val;");
    }
    let mut eok: String = env;
    if rkind != "V" {
        eok = c_env_put(env, ok_bind, "T");
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br: List[String] = c_emit_block(toks, p, n, eok);
        p = parse_int(list_get(br, 0));
    } else {
        let st: List[String] = c_emit_stmt(toks, p, n, eok);
        p = parse_int(list_get(st, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    // Err arm
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT"
        || field_at(list_get(toks, p), 3) != "Err"
    {
        println("ERR\tc_emit\tmatch: expected Err(...) arm");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Err(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        err_bind = field_at(list_get(toks, p), 3);
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
        p = p + 1;
    }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Err(...)");
        process_exit(1);
    }
    p = p + 1;
    if rkind == "V" {
        println("    OoStr " + err_bind + " = __m.err;");
    } else {
        println("    OoStr " + err_bind + " = __m.val;");
    }
    let eerr: String = c_env_put(env, err_bind, "T");
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br2: List[String] = c_emit_block(toks, p, n, eerr);
        p = parse_int(list_get(br2, 0));
    } else {
        let st2: List[String] = c_emit_stmt(toks, p, n, eerr);
        p = parse_int(list_get(st2, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" {
        p = p + 1;
    }
    return c_pack_pos_env(p, env);
}

// name = match r { ... } — assign form (name already declared).
pub fn c_emit_match_assign(name: String, toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_match_let_core(name, toks, pos, n, env, 0);
}

// let name = match r { Ok(a) => expr Err(b) => expr };
pub fn c_emit_match_let(name: String, toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_match_let_core(name, toks, pos, n, env, 1);
}

// decl: 1 → `OoStr name;`; 0 → assign into existing name.
pub fn c_emit_match_let_core(
    name: String,
    toks: List[String],
    pos: Int,
    n: Int,
    env: String,
    decl: Int
) -> List[String] {
    let mut p = pos + 1;
    let mut e: String = env;
    let pr_m: List[String] = c_emit_expr_c(toks, p, n, e);
    p = parse_int(list_get(pr_m, 0));
    let scrut = list_get(pr_m, 1);
    let mut rkind = "R";
    if c_env_get(e, scrut) == "V" {
        rkind = "V";
    }
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACE" {
        println("ERR\tc_emit\tmatch-let expected {");
        process_exit(1);
    }
    p = p + 1;
    let arm1: String = field_at(list_get(toks, p), 3);
    if p >= n || (arm1 != "Ok" && arm1 != "Some") {
        println("ERR\tc_emit\tmatch-let expected Ok or Some");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            ok_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" {
        p = p + 1;
    }
    let is_some = (arm1 == "Some");
    if decl == 1 {
        if is_some || c_env_get(e, "__ret_int__") == "1" {
            println("  long long " + name + ";");
        } else {
            println("  OoStr " + name + ";");
        }
    }
    println("  {");
    if is_some {
        println("  long long __ml = " + scrut + ";");
        println("  if (__ml != 0) {");
        println("    long long " + ok_bind + " = __ml;");
    } else {
        if rkind == "V" {
            println("  OoResV __ml = " + scrut + ";");
        } else {
            println("  OoResS __ml = " + scrut + ";");
        }
        println("  if (__ml.ok) {");
    }
    let mut eok = e;
    if !is_some && rkind != "V" {
        println("    OoStr " + ok_bind + " = __ml.val;");
        eok = c_env_put(e, ok_bind, "T");
    }
    let pr_ok: List[String] = c_emit_expr_c(toks, p, n, eok);
    p = parse_int(list_get(pr_ok, 0));
    let mut okx = list_get(pr_ok, 1);
    if c_env_get(e, "__ret_int__") == "1" && !is_some { okx = "oo_str_to_int(" + okx + ")"; }
    if decl == 0 { c_emit_reassign_arc(name, okx, eok); } else { println("    " + name + " = " + okx + ";"); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    let arm2: String = field_at(list_get(toks, p), 3);
    if p >= n || (arm2 != "Err" && arm2 != "None") {
        println("ERR\tc_emit\tmatch-let expected Err or None");
        process_exit(1);
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            err_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" {
        p = p + 1;
    }
    if !is_some {
        if rkind == "V" {
            println("    OoStr " + err_bind + " = __ml.err;");
        } else {
            println("    OoStr " + err_bind + " = __ml.val;");
        }
    }
    let eerr: String = c_env_put(e, err_bind, "T");
    let pr_er: List[String] = c_emit_expr_c(toks, p, n, eerr);
    p = parse_int(list_get(pr_er, 0));
    if decl == 0 { c_emit_reassign_arc(name, list_get(pr_er, 1), eerr); } else { println("    " + name + " = " + list_get(pr_er, 1) + ";"); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let mut nk = "T";
    if is_some { nk = "I"; }
    if decl == 1 { e = c_env_put(e, name, nk); } else { e = c_env_put_last(e, name, nk); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    return c_pack_pos_env(p, e);
}
