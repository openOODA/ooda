// # AST parser and c_emit integration shim
// Logline: Walk tokens once into typed AstFile, hand to tc_check, emit C unchanged.
// Setup: Token rows kind|line|col|text. AST at ast.oo:14-73, Ty at ty.oo:20-31.
// Beats: 1. parse_ty consumes primitives, generic brackets, references. 2. ast_parse walks top items.
//        3. parse_item/parse_fn_body/parse_stmt/parse_expr cover bodies. 4. Pratt parse_expr.
// Notes: <= 256 lines; only .oo/.oot; ASD-STE100; all while loops check p < n to prevent EOF loops.
import "ast.oo";
import "ty.oo";
import "tc_drive.oo";
import "token_fmt.oo";
fn pa_pos(r: String) -> Int { return parse_int(str_slice(r, 0, str_index_of(r, "	"))); }
fn pa_val(r: String) -> String { let i: Int = str_index_of(r, "	"); return str_slice(r, i + 1, chars_len(r)); }
fn pa_pack(p: Int, v: String) -> String { return p.to_string() + "	" + v; }
fn binop_lbp(k: String) -> Int {
    if k == "EQ" { return 1; } if k == "OROR" { return 2; } if k == "ANDAND" { return 3; } if k == "EQEQ" || k == "NEQ" || k == "NE" { return 4; }
    if k == "LT" || k == "GT" || k == "LTE" || k == "GTE" { return 5; } if k == "PLUS" || k == "MINUS" { return 6; } if k == "STAR" || k == "SLASH" || k == "PERCENT" { return 7; }
    return 0;
}
fn op_name(k: String) -> String {
    if k == "PLUS" { return "Add"; } if k == "MINUS" { return "Sub"; } if k == "STAR" { return "Mul"; } if k == "SLASH" { return "Div"; } if k == "PERCENT" { return "Mod"; }
    if k == "EQEQ" { return "Eq"; } if k == "NEQ" || k == "NE" { return "Neq"; } if k == "LT" { return "Lt"; } if k == "LTE" { return "Lte"; } if k == "GT" { return "Gt"; }
    if k == "GTE" { return "Gte"; } if k == "ANDAND" { return "And"; } if k == "OROR" { return "Or"; } if k == "EQ" { return "Assign"; } return "Add";
}
fn parse_ty(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n { return pa_pack(p, mk_ty_name("_err_")); }
    let k0: String = c_tokk(toks, p); let t0: String = c_tokt(toks, p);
    if k0 == "AMP" {
        p = p + 1; let is_mut: Bool = p < n && c_tokk(toks, p) == "KW_MUT"; if is_mut { p = p + 1; }
        let pt: String = parse_ty(p, n, toks); p = pa_pos(pt);
        let ref_node: String = if is_mut { mk_ty_ref_mut(pa_val(pt)) } else { mk_ty_ref(pa_val(pt)) };
        return pa_pack(p, ref_node);
    }
    if k0 == "IDENT" {
        p = p + 1;
        if t0 == "Int" { return pa_pack(p, mk_ty_int()); } if t0 == "Float" || t0 == "f64" { return pa_pack(p, mk_ty_float()); } if t0 == "Bool" { return pa_pack(p, mk_ty_bool()); } if t0 == "String" { return pa_pack(p, mk_ty_str()); }
        if t0 == "List" {
            let mut elem: String = mk_ty_str();
            if p < n && c_tokk(toks, p) == "LBRACKET" { p = p + 1; let pt: String = parse_ty(p, n, toks); p = pa_pos(pt); elem = pa_val(pt); if p < n && c_tokk(toks, p) == "RBRACKET" { p = p + 1; } }
            return pa_pack(p, mk_ty_list(elem));
        }
        if t0 == "Result" {
            let mut ok_t: String = mk_ty_str(); let mut err_t: String = mk_ty_str();
            if p < n && c_tokk(toks, p) == "LBRACKET" {
                p = p + 1; let pt1: String = parse_ty(p, n, toks); p = pa_pos(pt1); ok_t = pa_val(pt1);
                if p < n && c_tokk(toks, p) == "COMMA" { p = p + 1; }
                if p < n && c_tokk(toks, p) != "RBRACKET" { let pt2: String = parse_ty(p, n, toks); p = pa_pos(pt2); err_t = pa_val(pt2); }
                if p < n && c_tokk(toks, p) == "RBRACKET" { p = p + 1; }
            }
            return pa_pack(p, mk_ty_result(ok_t, err_t));
        }
        if t0 == "Option" {
            if p < n && c_tokk(toks, p) == "LBRACKET" { p = p + 1; let pt: String = parse_ty(p, n, toks); p = pa_pos(pt); if p < n && c_tokk(toks, p) == "RBRACKET" { p = p + 1; } }
            return pa_pack(p, mk_ty_name("Option"));
        }
        if p < n && c_tokk(toks, p) == "LBRACKET" {
            p = p + 1; let mut depth: Int = 1;
            while p < n && depth > 0 { let k: String = c_tokk(toks, p); if k == "LBRACKET" { depth = depth + 1; } if k == "RBRACKET" { depth = depth - 1; } p = p + 1; }
        }
        return pa_pack(p, mk_ty_name(t0));
    }
    return pa_pack(p + 1, mk_ty_name("_err_"));
}
pub fn ast_parse(toks: List[String]) -> String {
    let n: Int = list_len(toks); let mut p: Int = 0; let mut items: String = "";
    while p < n {
        if c_tokk(toks, p) == "EOF" { p = n; } else {
            let pr: String = parse_item(p, n, toks); let next_p: Int = pa_pos(pr);
            if next_p > p { p = next_p; } else { p = p + 1; }
            if items == "" { items = pa_val(pr); } else { items = items + "," + pa_val(pr); }
        }
    }
    return mk_file(items);
}
fn parse_item(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n { return pa_pack(p, ""); }
    let k: String = c_tokk(toks, p);
    if k == "KW_IMPORT" {
        p = p + 2; if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        let imp_path: String = if p0 + 1 < n { c_tokt(toks, p0 + 1) } else { "" };
        return pa_pack(p, mk_import(imp_path));
    }
    if k == "KW_TYPE" {
        p = p + 1; let nm: String = if p < n { c_tokt(toks, p) } else { "" }; if p < n { p = p + 1; }
        let mut fld: String = "";
        while p < n && (c_tokk(toks, p) == "EQ" || c_tokt(toks, p) == "struct") { p = p + 1; }
        if p < n && c_tokk(toks, p) == "LBRACE" {
            p = p + 1;
            while p < n && c_tokk(toks, p) != "RBRACE" {
                if c_tokk(toks, p) == "COMMA" { p = p + 1; }
                if p < n && c_tokk(toks, p) != "RBRACE" {
                    let fnm: String = c_tokt(toks, p); p = p + 1; if p < n && c_tokk(toks, p) == "COLON" { p = p + 1; }
                    let pt: String = parse_ty(p, n, toks); p = pa_pos(pt); let fe: String = mk_field(fnm, pa_val(pt));
                    if fld == "" { fld = fe; } else { fld = fld + "," + fe; }
                }
            }
            if p < n && c_tokk(toks, p) == "RBRACE" { p = p + 1; }
        } else { while p < n && c_tokk(toks, p) != "SEMI" { p = p + 1; } }
        if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        return pa_pack(p, mk_type(nm, fld));
    }
    if k == "KW_PUB" && p + 1 < n && c_tokk(toks, p + 1) == "KW_FN" { return parse_fn_item_ast(p + 2, n, toks); }
    if k == "KW_FN" { return parse_fn_item_ast(p + 1, n, toks); }
    if k == "KW_TRAIT" || k == "KW_IMPL" || k == "KW_VERIFY" {
        while p < n && c_tokk(toks, p) != "LBRACE" { p = p + 1; }
        if p < n && c_tokk(toks, p) == "LBRACE" {
            p = p + 1; let mut depth: Int = 1;
            while p < n && depth > 0 { let k2: String = c_tokk(toks, p); if k2 == "LBRACE" { depth = depth + 1; } if k2 == "RBRACE" { depth = depth - 1; } p = p + 1; }
        }
        let mut item_node: String = mk_verify("EVar(_)");
        if k == "KW_TRAIT" { item_node = mk_trait("", ""); } else if k == "KW_IMPL" { item_node = mk_impl("", "", ""); }
        return pa_pack(p, item_node);
    }
    return pa_pack(p + 1, "");
}
fn parse_fn_item_ast(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n { return pa_pack(p, mk_fn("_err_", "", mk_ty_unit(), "", mk_block("", mk_sempty()))); }
    let fnm: String = c_tokt(toks, p); p = p + 1; if p < n && c_tokk(toks, p) == "LPAREN" { p = p + 1; }
    let mut params: String = "";
    while p < n && c_tokk(toks, p) != "RPAREN" {
        if c_tokk(toks, p) == "COMMA" { p = p + 1; }
        if p < n && c_tokk(toks, p) != "RPAREN" {
            if c_tokk(toks, p) == "AMP" { p = p + 1; } if c_tokk(toks, p) == "KW_MUT" { p = p + 1; }
            let pname: String = if p < n { c_tokt(toks, p) } else { "" }; if p < n { p = p + 1; }
            if p < n && c_tokk(toks, p) == "COLON" { p = p + 1; }
            let pt: String = parse_ty(p, n, toks); p = pa_pos(pt); let pe: String = mk_param(pname, pa_val(pt));
            if params == "" { params = pe; } else { params = params + "," + pe; }
        }
    }
    if p < n && c_tokk(toks, p) == "RPAREN" { p = p + 1; }
    let mut ret: String = mk_ty_unit();
    if p < n && c_tokk(toks, p) == "ARROW" { p = p + 1; let rt: String = parse_ty(p, n, toks); p = pa_pos(rt); ret = pa_val(rt); }
    while p < n && c_tokk(toks, p) != "LBRACE" && c_tokk(toks, p) != "SEMI" { p = p + 1; }
    let mut body_ast: String = mk_block("", mk_sempty());
    if p < n && c_tokk(toks, p) == "LBRACE" { let pb: String = parse_fn_body(p, n, toks); p = pa_pos(pb); body_ast = pa_val(pb); } else if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
    return pa_pack(p, mk_fn(fnm, params, ret, "", body_ast));
}
fn parse_fn_body(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n || c_tokk(toks, p) != "LBRACE" { return pa_pack(p, mk_block("", mk_sempty())); }
    p = p + 1; let mut stmts: String = "";
    while p < n && c_tokk(toks, p) != "RBRACE" {
        let ps: String = parse_stmt(p, n, toks); let next_p: Int = pa_pos(ps);
        if next_p > p { p = next_p; } else { p = p + 1; }
        if stmts == "" { stmts = pa_val(ps); } else { stmts = stmts + "," + pa_val(ps); }
    }
    if p < n && c_tokk(toks, p) == "RBRACE" { p = p + 1; }
    return pa_pack(p, mk_block(stmts, mk_sempty()));
}
fn parse_stmt(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n { return pa_pack(p, mk_sempty()); }
    let k: String = c_tokk(toks, p);
    if k == "KW_LET" {
        p = p + 1; let is_mut: Bool = p < n && c_tokk(toks, p) == "KW_MUT"; if is_mut { p = p + 1; }
        let nm: String = if p < n { c_tokt(toks, p) } else { "" }; if p < n { p = p + 1; }
        let mut ty: String = "";
        if p < n && c_tokk(toks, p) == "COLON" { p = p + 1; let pt: String = parse_ty(p, n, toks); p = pa_pos(pt); ty = pa_val(pt); }
        if p < n && c_tokk(toks, p) == "EQ" { p = p + 1; }
        let pr: String = parse_expr(p, n, toks, 0); p = pa_pos(pr); if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        let slet_node: String = if is_mut { mk_slet_mut(nm, ty, pa_val(pr)) } else { mk_slet(nm, ty, pa_val(pr)) };
        return pa_pack(p, slet_node);
    }
    if k == "KW_RETURN" {
        p = p + 1; if p < n && c_tokk(toks, p) == "SEMI" { return pa_pack(p + 1, mk_sreturn("")); }
        let pr2: String = parse_expr(p, n, toks, 0); p = pa_pos(pr2); if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        return pa_pack(p, mk_sreturn(pa_val(pr2)));
    }
    if k == "KW_WHILE" {
        p = p + 1; let pc: String = parse_expr(p, n, toks, 0); p = pa_pos(pc);
        let pb: String = parse_fn_body(p, n, toks); p = pa_pos(pb); return pa_pack(p, mk_swhile(pa_val(pc), pa_val(pb)));
    }
    if k == "KW_BREAK" { p = p + 1; if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; } return pa_pack(p, mk_sbreak()); } if k == "KW_CONTINUE" { p = p + 1; if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; } return pa_pack(p, mk_scontinue()); }
    if k != "SEMI" {
        let pe: String = parse_expr(p, n, toks, 0); p = pa_pos(pe); if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        return pa_pack(p, mk_sexpr(pa_val(pe)));
    }
    return pa_pack(p + 1, mk_sempty());
}
fn parse_expr(p0: Int, n: Int, toks: List[String], min_bp: Int) -> String {
    let mut p: Int = p0; let mut lhs: String = ""; if p >= n { return pa_pack(p, mk_evar("_eof_")); }
    let k0: String = c_tokk(toks, p);
    if k0 == "BANG" || k0 == "MINUS" {
        let op_s: String = if k0 == "BANG" { "Not" } else { "Neg" };
        p = p + 1; let pr: String = parse_expr(p, n, toks, 8); p = pa_pos(pr); lhs = mk_eunop(op_s, pa_val(pr));
    } else { let pp: String = parse_atom(p, n, toks); p = pa_pos(pp); lhs = pa_val(pp); }
    let mut cont: Bool = true;
    while p < n && cont {
        let k: String = c_tokk(toks, p);
        if k == "LPAREN" {
            p = p + 1; let ar: String = parse_expr_list(p, n, toks, "RPAREN"); p = pa_pos(ar);
            if p < n && c_tokk(toks, p) == "RPAREN" { p = p + 1; }
            lhs = mk_ecall(lhs, pa_val(ar));
        } else if k == "DOT" {
            p = p + 1; let mn: String = if p < n { c_tokt(toks, p) } else { "" }; if p < n { p = p + 1; }
            if p < n && c_tokk(toks, p) == "LPAREN" {
                p = p + 1; let mr: String = parse_expr_list(p, n, toks, "RPAREN"); p = pa_pos(mr);
                if p < n && c_tokk(toks, p) == "RPAREN" { p = p + 1; }
                lhs = mk_emethod(lhs, mn, pa_val(mr));
            } else { lhs = mk_efield(lhs, mn); }
        } else if k == "LBRACKET" {
            p = p + 1; let pi: String = parse_expr(p, n, toks, 0); p = pa_pos(pi); if p < n && c_tokk(toks, p) == "RBRACKET" { p = p + 1; }
            lhs = mk_eindex(lhs, pa_val(pi));
        } else { cont = false; }
    }
    cont = true;
    while p < n && cont {
        let k: String = c_tokk(toks, p); let lbp: Int = binop_lbp(k);
        if lbp == 0 || lbp < min_bp { cont = false; }
        else {
            let mut rbp: Int = lbp + 1; if k == "EQ" { rbp = lbp; }
            p = p + 1; let pr3: String = parse_expr(p, n, toks, rbp); p = pa_pos(pr3);
            lhs = mk_ebinop(op_name(k), lhs, pa_val(pr3));
        }
    }
    return pa_pack(p, lhs);
}
fn parse_atom(p0: Int, n: Int, toks: List[String]) -> String {
    let mut p: Int = p0; if p >= n { return pa_pack(p, mk_evar("_eof_")); }
    let k0: String = c_tokk(toks, p); let t0: String = c_tokt(toks, p);
    if k0 == "INT" { return pa_pack(p + 1, mk_eint(t0)); } if k0 == "FLOAT" { return pa_pack(p + 1, mk_efloat(t0)); } if k0 == "STRING" { return pa_pack(p + 1, mk_estr(t0)); } if k0 == "KW_TRUE" { return pa_pack(p + 1, mk_ebool("true")); } if k0 == "KW_FALSE" { return pa_pack(p + 1, mk_ebool("false")); }
    if k0 == "KW_IF" {
        p = p + 1; let pc: String = parse_expr(p, n, toks, 0); p = pa_pos(pc);
        let pt: String = parse_fn_body(p, n, toks); p = pa_pos(pt); let mut el: String = "";
        if p < n && c_tokk(toks, p) == "KW_ELSE" { p = p + 1; let pe2: String = parse_expr(p, n, toks, 0); p = pa_pos(pe2); el = pa_val(pe2); }
        return pa_pack(p, mk_eif(pa_val(pc), pa_val(pt), el));
    }
    if k0 == "LPAREN" {
        p = p + 1; let pg: String = parse_expr(p, n, toks, 0); p = pa_pos(pg);
        if p < n && c_tokk(toks, p) == "RPAREN" { p = p + 1; }
        return pa_pack(p, pa_val(pg));
    }
    if k0 == "IDENT" {
        let id_name: String = t0; p = p + 1;
        if p < n && c_tokk(toks, p) == "LBRACE" {
            p = p + 1; while p < n && c_tokk(toks, p) != "RBRACE" { p = p + 1; }
            if p < n && c_tokk(toks, p) == "RBRACE" { p = p + 1; }
            return pa_pack(p, mk_estruct_lit(id_name, ""));
        }
        return pa_pack(p, mk_evar(id_name));
    }
    return pa_pack(p + 1, mk_evar("_err_"));
}
fn parse_expr_list(p0: Int, n: Int, toks: List[String], stop_kind: String) -> String {
    let mut p: Int = p0; let mut s: String = "";
    while p < n && c_tokk(toks, p) != stop_kind {
        if c_tokk(toks, p) == "COMMA" { p = p + 1; }
        if p < n && c_tokk(toks, p) != stop_kind {
            let pe: String = parse_expr(p, n, toks, 0); let next_p: Int = pa_pos(pe);
            if next_p > p { p = next_p; } else { p = p + 1; }
            if s == "" { s = pa_val(pe); } else { s = s + "," + pa_val(pe); }
        }
    }
    return pa_pack(p, s);
}
pub fn ast_drive(src: String, toks: List[String], mode: String, path: String) {
    let ast: String = ast_parse(toks); tc_check(ast);
}
