// # Scan an identifier or keyword
//
// Logline: If the cursor sits on a letter or underscore, eat the rest of the name and pack it as a keyword kind or IDENT.
//
// Setup: chars_len, char_at, char_is_alpha, char_is_digit, list_new, pack_tok, and keyword_kind exist; lex_step calls this after ws, string, and number miss.
//
// Beats:
//   1. Past the end or a non-start character returns an empty list.
//   2. Eat alpha, digit, or underscore one character at a time while the cursor stays in range.
//   3. Pack the span with keyword_kind(id) and return it.

import "token_emit.oo";

pub fn try_scan_ident(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    let ch = char_at(src, i0);
    if !(char_is_alpha(ch) || ch == "_") {
        return list_new();
    }
    let sl = line0;
    let sc = col0;
    let mut i = i0 + 1;
    let mut col = col0 + 1;
    let mut line = line0;
    let mut cont_id = true;
    while cont_id {
        if i >= n {
            cont_id = false;
        } else {
            let c2 = char_at(src, i);
            if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                i = i + 1;
                col = col + 1;
            } else {
                cont_id = false;
            }
        }
    }
    let id: String = str_slice(src, i0, i);
    return pack_tok(i, line, col, keyword_kind(id), id, sl, sc);
}
