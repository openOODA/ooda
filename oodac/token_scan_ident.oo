// job: scan ident/keyword token; stage: tokens
// in: cursor at alpha/_; out: empty or TOK pack

pub fn try_scan_ident(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n: Int = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    let ch: String = char_at(src, i0);
    if !(char_is_alpha(ch) || ch == "_") {
        return list_new();
    }
    let sl: Int = line0;
    let sc: Int = col0;
    let mut i: Int = i0;
    let mut col: Int = col0;
    let mut line: Int = line0;
    let mut id: Int = ch;
    i = i + 1;
    col = col + 1;
    let mut cont_id: Bool = true;
    while cont_id {
        if i >= n {
            cont_id = false;
        } else {
            let c2: String = char_at(src, i);
            if char_is_alpha(c2) || char_is_digit(c2) || c2 == "_" {
                id = id + c2;
                i = i + 1;
                col = col + 1;
            } else {
                cont_id = false;
            }
        }
    }
    return pack_tok(i, line, col, keyword_kind(id), id, sl, sc);
}
