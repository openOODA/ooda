// # Build a source file to a native, LLVM, or bitcode binary
//
// Logline: Emits C, LLVM IR, bitcode (.bc), or x86_64 .s, then links via lld/clang/gcc/ld.
//
// Setup: load_expand, shell_sq, sys_exec, and process_exit exist; backend is x86, llvm, c, or bc.
//
// Beats:
//   1. When out_arg is empty, binary path is path.bin; .bc outputs trigger direct llvm-as/clang bitcode emission.
//   2. On x86, emit-x86 to a temp .s and as+ld it. On llvm/bc, emit-llvm and compile to .bc or link via clang/lld.
//   3. On native, expand imports, emit preamble then protos then bodies, link via clang/lld or gcc runtime.

import "load_import.oo";
import "diag_json.oo";
import "c_emit_helpers.oo";
import "c_emit.oo";
import "cli_build_cc.oo";
import "cli_build_sovereign.oo";

// OPEN-71: deterministic gcc flags for bit-identical rebuilds.
pub fn gcc_repro_flags() -> String {
    return "-frandom-seed=0 -Wl,--build-id=none";
}

pub fn run_build_san(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String, sanitizers: String) {
    let mut out = path + ".bin";
    if out_arg != "" { out = out_arg; }

    if is_sovereign_backend(backend) {
        let sov_ok: Bool = run_build_sovereign(fs, sys, path, out, backend);
        if sov_ok {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\t" + backend + " failed");
            process_exit(1);
        }
    }

    let mut is_bc = false;
    if backend == "bc" { is_bc = true; }

    if chars_len(out) >= 3 && str_slice(out, chars_len(out) - 3, chars_len(out)) == ".bc" { is_bc = true; }

    if backend == "x86" {
        let tmp_s = out + ".tmp.s";
        let tmp_o = out + ".tmp.o";
        let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-$(readlink -f /proc/$PPID/exe)}}\" && $OODAC_BIN emit-x86 " + shell_sq(path) + " > " + shell_sq(tmp_s));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-x86 failed"); process_exit(1); }
        let r_as: Result[String, String] = sys_exec(sys, "sh", "-c", "as --64 -o " + shell_sq(tmp_o) + " " + shell_sq(tmp_s));
        if !r_as.is_ok() { println("ERR\tbuild\tas failed"); process_exit(1); }
        let r_ld: Result[String, String] = sys_exec(sys, "sh", "-c", "ld -o " + shell_sq(out) + " " + shell_sq(tmp_o));
        if r_ld.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tld failed");
            process_exit(1);
        }
    }

    if backend == "llvm" || is_bc {
        let tmp_ll = out + ".tmp.ll";
        let probe_dbg = "if [ -n \"$OODA_DEBUG\" ] || [ -n \"$DEBUG\" ] || [ \"$OODA_LLVM_DEBUG\" = \"1\" ]; then exit 0; else exit 1; fi";
        let dbg_res = sys_exec(sys, "sh", "-c", probe_dbg);
        let mut is_dbg = is_debug;
        if dbg_res.is_ok() { is_dbg = true; }
        let mut dbg_flag = "";
        let mut clang_dbg = "";
        if is_dbg {
            dbg_flag = " -g";
            clang_dbg = "-g ";
        }
        let mut tr_flag = "";
        let mut clang_tr = "";
        if target_triple != "" {
            tr_flag = " --target-triple=" + target_triple;
            clang_tr = "--target=" + target_triple + " ";
        }
        let mut san_str = sanitizers;
        let san_probe = "if [ -n \"$OODA_SANITIZE\" ]; then echo \"$OODA_SANITIZE\"; elif [ -n \"$SANITIZE\" ]; then echo \"$SANITIZE\"; elif [ -n \"$OODA_FSANITIZE\" ]; then echo \"$OODA_FSANITIZE\"; fi";
        let san_res = sys_exec(sys, "sh", "-c", san_probe);
        if san_str == "" && san_res.is_ok() {
            san_str = match san_res { Ok(s) => str_trim(s), Err(e) => "" };
        }
        let mut san_flags = "";
        let mut clang_san = "";
        if str_index_of(san_str, "address") >= 0 {
            san_flags = san_flags + " -fsanitize=address";
            clang_san = clang_san + "-fsanitize=address ";
        }
        if str_index_of(san_str, "thread") >= 0 {
            san_flags = san_flags + " -fsanitize=thread";
            clang_san = clang_san + "-fsanitize=thread ";
        }
        if str_index_of(san_str, "undefined") >= 0 {
            san_flags = san_flags + " -fsanitize=undefined";
            clang_san = clang_san + "-fsanitize=undefined ";
        }
        if str_index_of(san_str, "fuzzer") >= 0 {
            san_flags = san_flags + " -fsanitize=fuzzer";
            clang_san = clang_san + "-fsanitize=fuzzer ";
        }
        let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-$(readlink -f /proc/$PPID/exe)}}\" && $OODAC_BIN emit-llvm" + dbg_flag + tr_flag + san_flags + " " + shell_sq(path) + " > " + shell_sq(tmp_ll));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-llvm failed"); process_exit(1); }

        if is_bc {
            let bc_cmd = "if command -v llvm-as >/dev/null 2>&1; then llvm-as " + shell_sq(tmp_ll) + " -o " + shell_sq(out) + "; elif command -v clang >/dev/null 2>&1; then clang -c -emit-llvm -Wno-override-module -x ir " + shell_sq(tmp_ll) + " -o " + shell_sq(out) + "; else exit 1; fi";
            let r_bc: Result[String, String] = sys_exec(sys, "sh", "-c", bc_cmd);
            if r_bc.is_ok() {
                println("OK\tbuild\t" + out);
                return;
            } else {
                println("ERR\tbuild\tbitcode assembly failed");
                process_exit(1);
            }
        }

        let mut opt_flag: String = opt;
        if opt_flag == "" {
            if release { opt_flag = "-O2"; }
            else { opt_flag = "-O0"; }
        }
        let mut lto_flags: String = "";
        if lto {
            lto_flags = "-flto=thin -Wl,--gc-sections";
        }
        let mut pgo_flags: String = "";
        if pgo_gen {
            pgo_flags = "-fprofile-generate";
        } else if pgo_use != "" {
            pgo_flags = "-fprofile-use=" + pgo_use;
        }
        let clang_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; OO_OPT=\"${OODA_OPT:-" + opt_flag + "}\"; if [ -z \"$OO_OPT\" ]; then if [ \"${OODA_RELEASE:-0}\" = \"1\" ]; then OO_OPT=\"-O2\"; else OO_OPT=\"-O0\"; fi; fi; OO_LTO=\"${OODA_LTO:-}\"; OO_LTO_FLAGS=\"" + lto_flags + "\"; if [ \"$OO_LTO\" = \"1\" ]; then OO_LTO_FLAGS=\"-flto=thin -Wl,--gc-sections\"; fi; OO_PGO=\"${OODA_PGO_FLAGS:-" + pgo_flags + "}\"; if [ -n \"$OODA_PGO_GEN\" ] || [ \"${OODA_PROFILE_GENERATE:-0}\" = \"1\" ]; then OO_PGO=\"-fprofile-generate\"; elif [ -n \"$OODA_PGO_USE\" ]; then OO_PGO=\"-fprofile-use=$OODA_PGO_USE\"; fi; OO_SAN=\"${OODA_SAN_FLAGS:-" + clang_san + "}\"; OO_LLD=\"\"; if [ -n \"$OODA_USE_LLD\" ] || [ \"${OODA_LLD:-0}\" = \"1\" ] || command -v ld.lld >/dev/null 2>&1 || command -v lld >/dev/null 2>&1 || command -v lld-link >/dev/null 2>&1; then if command -v lld-link >/dev/null 2>&1 && [ -n \"" + target_triple + "\" ]; then OO_LLD=\"-fuse-ld=lld-link\"; else OO_LLD=\"-fuse-ld=lld\"; fi; fi; clang " + clang_dbg + clang_tr + "$OO_OPT $OO_LTO_FLAGS $OO_PGO $OO_SAN $OO_LLD -Wno-override-module -Wno-unused-command-line-argument -Iruntime $OO_SSL_C " + shell_sq(tmp_ll) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
        let r_clang: Result[String, String] = sys_exec(sys, "sh", "-c", clang_cmd);
        if r_clang.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tclang compilation failed");
            process_exit(1);
        }
    }

    let le_res: List[String] = load_expand(fs, path, list_new(), list_new());
    let n_le = list_len(le_res);
    let mut mods: List[String] = list_new();
    let mut i = 0;
    while i + 1 < n_le {
        mods = list_push(mods, list_get(le_res, i));
        i = i + 1;
    }

    let tmp_all_c = out + ".tmp.c";
    let mut host: String = "./oodac/oodac";
    let hp: String = ".ooda-cache/ooda-tmp/oodac_host";
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache/ooda-tmp && readlink -f /proc/$PPID/exe | tr -d '\\n' > " + hp);
    if wr.is_ok() {
        let rr: Result[String, String] = read_file(fs, hp);
        if rr.is_ok() {
            host = match rr { Ok(s) => s, Err(e) => e };
        }
    }
    if host == "" { host = "./oodac/oodac"; }
    let stamp: String = oo_file_stamp(host);
    let mut stamp_s: String = stamp;
    let col: Int = str_index_of(stamp, ":");
    if col >= 0 {
        stamp_s = str_slice(stamp, 0, col) + "_" + str_slice(stamp, col + 1, chars_len(stamp));
    }

    let r_pre: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-preamble " + shell_sq(path) + " > " + shell_sq(tmp_all_c));
    if !r_pre.is_ok() { println("ERR\tbuild\tpreamble failed"); process_exit(1); }

    let cdir: String = ".ooda-cache/oodac_emit";
    let _mk: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p " + cdir);
    let pre_c: String = cdir + "/preamble_" + stamp_s + ".c";
    let r_cp: Result[String, String] = sys_exec(sys, "sh", "-c", "cp " + shell_sq(tmp_all_c) + " " + shell_sq(pre_c));
    if !r_cp.is_ok() { println("ERR\tbuild\tpreamble cache failed"); process_exit(1); }
    let mut skip: Int = 0;
    let nmods: Int = list_len(mods);
    let mut pbs: List[String] = list_new();
    let mut j = 0;
    while j < nmods {
        let m = list_get(mods, j);
        let hp2: String = ".ooda-cache/ooda-tmp/mod_sha";
        let wrh: Result[String, String] = sys_exec(sys, "sh", "-c", "sha256sum -- " + shell_sq(m) + " | awk '{printf \"%s\", $1}' > " + hp2);
        let mut h: String = "";
        if wrh.is_ok() {
            let rr: Result[String, String] = read_file(fs, hp2);
            if rr.is_ok() {
                h = match rr { Ok(s) => s, Err(e) => e };
            }
        }
        let cf: String = cdir + "/" + stamp_s + "_" + h + ".pb.c";
        let mut hit: Bool = false;
        if h != "" {
            if path_exists(fs, cf) { hit = true; }
        }
        if !hit {
            let r_pro: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && env -u PURE_NO_ARC -u OODA_PURE_NO_ARC OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-protos " + shell_sq(m) + " > " + shell_sq(cf));
            if !r_pro.is_ok() { println("ERR\tbuild\tprotos failed on " + m); process_exit(1); }
            let r_bod: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-bodies " + shell_sq(m) + " >> " + shell_sq(cf));
            if !r_bod.is_ok() { println("ERR\tbuild\tbodies failed on " + m); process_exit(1); }
        } else {
            skip = skip + 1;
        }
        pbs = list_push(pbs, cf);
        let rcat: Result[String, String] = sys_exec(sys, "sh", "-c", "cat " + shell_sq(cf) + " >> " + shell_sq(tmp_all_c));
        if !rcat.is_ok() { println("ERR\tbuild\tcache cat failed on " + m); process_exit(1); }
        j = j + 1;
    }
    if !quiet {
        println("emit_cache skip=" + skip.to_string() + " of " + nmods.to_string());
    }
    run_native_cc(fs, sys, pbs, pre_c, out, gcc_repro_flags(), quiet);
    if !quiet {
        println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
    }
}

pub fn run_build_debug_pgo(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String) {
    run_build_san(fs, sys, path, out_arg, backend, opt, lto, release, is_debug, quiet, target_triple, pgo_gen, pgo_use, "");
}

pub fn run_build_debug(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String) {
    run_build_san(fs, sys, path, out_arg, backend, opt, lto, release, is_debug, quiet, target_triple, false, "", "");
}

pub fn run_build_opt(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, quiet: Bool, target_triple: String) {
    run_build_debug(fs, sys, path, out_arg, backend, opt, lto, release, false, quiet, target_triple);
}

pub fn run_build_cmd(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, quiet: Bool) {
    run_build_opt(fs, sys, path, out_arg, backend, "", false, false, quiet, "");
}
