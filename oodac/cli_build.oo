// job: oodac CLI build command
// in:  FsCap + SysCap + argv
// out: process exit
// stage: cli

import "load_import.oo";
import "diag_json.oo";
import "c_emit.oo";

pub fn run_build_cmd(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String) {
    let mut out = path + ".bin";
    if out_arg != "" { out = out_arg; }

    if backend == "llvm" {
        let tmp_ll = out + ".tmp.ll";
        let r_emit = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" && $OODAC_BIN emit-llvm " + shell_sq(path) + " > " + shell_sq(tmp_ll));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-llvm failed"); process_exit(1); }
        let clang_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; clang -O0 -Wno-override-module -Wno-unused-command-line-argument -Iruntime $OO_SSL_C " + shell_sq(tmp_ll) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
        let r_clang = sys_exec(sys, "sh", "-c", clang_cmd);
        if r_clang.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tclang compilation failed");
            process_exit(1);
        }
    }

    // NEW NATIVE BUILD!
    // 1. Collect dependencies
    let le_res: List[String] = load_expand(fs, path, "\t", "\t");
    let deps_str = list_get(le_res, 0);
    let mut n = chars_len(deps_str);
    let mut mods: List[String] = list_new();
    let mut i = 0;
    let mut cmod = "";
    while i < n {
        let ch = char_at(deps_str, i);
        if ch == "\t" {
            if chars_len(cmod) > 0 { mods = list_push(mods, cmod); }
            cmod = "";
        } else {
            cmod = cmod + ch;
        }
        i = i + 1;
    }
    if chars_len(cmod) > 0 { mods = list_push(mods, cmod); }

    let tmp_all_c = out + ".tmp.c";
    
    let r_pre = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" && $OODAC_BIN emit-preamble " + shell_sq(path) + " > " + shell_sq(tmp_all_c));
    if !r_pre.is_ok() { println("ERR\tbuild\tpreamble failed"); process_exit(1); }

    let mut j = 0;
    while j < list_len(mods) {
        let m = list_get(mods, j);
        let r_pro = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" && EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-protos " + shell_sq(m) + " >> " + shell_sq(tmp_all_c));
        if !r_pro.is_ok() { println("ERR\tbuild\tprotos failed on " + m); process_exit(1); }
        j = j + 1;
    }

    j = 0;
    while j < list_len(mods) {
        let m = list_get(mods, j);
        let r_bod = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" && EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-bodies " + shell_sq(m) + " >> " + shell_sq(tmp_all_c));
        if !r_bod.is_ok() { println("ERR\tbuild\tbodies failed on " + m); process_exit(1); }
        j = j + 1;
    }

    // chs_rt.c is the unity TU (#include of str/list/sys/fs/…); do not also link pieces
    // TLS: -lssl -lcrypto only when OO_HAVE_OPENSSL=1 (else residual; fail-closed)
    let gcc_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; gcc -O2 -Iruntime $OO_SSL_C " + shell_sq(tmp_all_c) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
    let r_gcc = sys_exec(sys, "sh", "-c", gcc_cmd);
    if r_gcc.is_ok() {
        println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
        return;
    } else {
        println("ERR\tbuild\tgcc linking failed");
        process_exit(1);
    }
}
