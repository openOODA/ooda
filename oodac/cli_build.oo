// # Build a source file to a native or LLVM binary
//
// Logline: Emits C or LLVM for the source and its imports, then links runtime C into the output binary.
//
// Setup: load_expand, shell_sq, sys_exec, and process_exit exist; backend is llvm or native; out_arg may be empty.
//
// Beats:
//   1. When out_arg is empty, the binary path is path.bin.
//   2. On llvm, emit-llvm to a temp .ll and clang it with runtime/chs_rt.c, or exit 1.
//   3. On native, expand imports, emit preamble then protos then bodies, gcc-link chs_rt.c, or exit 1.

import "load_import.oo";
import "diag_json.oo";
import "c_emit_helpers.oo";
import "c_emit.oo";

pub fn run_build_cmd(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String) {
    let mut out = path + ".bin";
    if out_arg != "" { out = out_arg; }

    if backend == "llvm" {
        let tmp_ll = out + ".tmp.ll";
        let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./oodac/oodac}\" && $OODAC_BIN emit-llvm " + shell_sq(path) + " > " + shell_sq(tmp_ll));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-llvm failed"); process_exit(1); }
        let clang_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; clang -O0 -Wno-override-module -Wno-unused-command-line-argument -Iruntime $OO_SSL_C " + shell_sq(tmp_ll) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
        let r_clang: Result[String, String] = sys_exec(sys, "sh", "-c", clang_cmd);
        if r_clang.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tclang compilation failed");
            process_exit(1);
        }
    }

    // NEW NATIVE BUILD!
    // 1. Collect dependencies via load_expand (List stack/done; last elem = body).
    let le_res: List[String] = load_expand(fs, path, list_new(), list_new());
    let n_le = list_len(le_res);
    let mut mods: List[String] = list_new();
    // done paths are indices 0..n_le-2; body at n_le-1 (unused here).
    let mut i = 0;
    while i + 1 < n_le {
        mods = list_push(mods, list_get(le_res, i));
        i = i + 1;
    }

    let tmp_all_c = out + ".tmp.c";
    
    let r_pre: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./oodac/oodac}}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-preamble " + shell_sq(path) + " > " + shell_sq(tmp_all_c));
    if !r_pre.is_ok() { println("ERR\tbuild\tpreamble failed"); process_exit(1); }

    let mut j = 0;
    while j < list_len(mods) {
        let m = list_get(mods, j);
        println("BUILD MOD: " + m);
        let r_pro: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./oodac/oodac}}\" && env -u PURE_NO_ARC -u OODA_PURE_NO_ARC OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-protos " + shell_sq(m) + " >> " + shell_sq(tmp_all_c));
        if !r_pro.is_ok() { println("ERR\tbuild\tprotos failed on " + m); process_exit(1); }
        j = j + 1;
    }

    j = 0;
    while j < list_len(mods) {
        let m = list_get(mods, j);
        let r_bod: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./oodac/oodac}}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-bodies " + shell_sq(m) + " >> " + shell_sq(tmp_all_c));
        if !r_bod.is_ok() { println("ERR\tbuild\tbodies failed on " + m); process_exit(1); }
        j = j + 1;
    }

    // chs_rt.c is the unity TU (#include of str/list/sys/fs/…); do not also link pieces
    // TLS: auto-link libssl.so.3 when present (headers optional; local decls in chs_rt_tls.c)
    let gcc_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-}\" = \"0\" ]; then true; elif [ -e /usr/lib64/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/usr/lib64/libssl.so.3 /usr/lib64/libcrypto.so.3\"; elif [ -e /lib64/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/lib64/libssl.so.3 /lib64/libcrypto.so.3\"; elif [ -e /usr/lib/x86_64-linux-gnu/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3\"; elif [ \"${OO_HAVE_OPENSSL:-}\" = \"1\" ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; OODA_SRC_ROOT=\"${OODA_SRC_ROOT:-.}\"; gcc -O2 -I\"$OODA_SRC_ROOT/runtime\" $OO_SSL_C " + shell_sq(tmp_all_c) + " \"$OODA_SRC_ROOT/runtime/chs_rt.c\" -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
    let r_gcc: Result[String, String] = sys_exec(sys, "sh", "-c", gcc_cmd);
    if r_gcc.is_ok() {
        println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
        return;
    } else {
        println("ERR\tbuild\tgcc linking failed");
        process_exit(1);
    }
}
