// # Build a source file to a native or LLVM binary
//
// Logline: Emits C, LLVM, or standalone x86_64 .s for the source, then links with gcc, clang, or as+ld.
//
// Setup: load_expand, shell_sq, sys_exec, and process_exit exist; backend is x86, llvm, or native; out_arg may be empty; emit uses ${OODAC_BIN:-${OODA_COMPILER:-./oodac_bin}}, never the product CLI.
//
// Beats:
//   1. When out_arg is empty, the binary path is path.bin.
//   2. On x86, emit-x86 to a temp .s and as+ld it (no emit-c). On llvm, emit-llvm + clang + chs_rt.c.
//   3. On native, expand imports, emit preamble then protos then bodies, gcc-link chs_rt.c, or exit 1.

import "load_import.oo";
import "diag_json.oo";
import "c_emit_helpers.oo";
import "c_emit.oo";
import "cli_build_cc.oo";

// OPEN-71: deterministic gcc flags for bit-identical rebuilds.
pub fn gcc_repro_flags() -> String {
    return "-frandom-seed=0 -Wl,--build-id=none";
}

pub fn run_build_cmd(fs: &FsCap, sys: &SysCap, path: String, out_arg: String, backend: String, quiet: Bool) {
    let mut out = path + ".bin";
    if out_arg != "" { out = out_arg; }

    if backend == "x86" {
        let tmp_s = out + ".tmp.s";
        let tmp_o = out + ".tmp.o";
        let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-$(readlink -f /proc/$PPID/exe)}}\" && $OODAC_BIN emit-x86 " + shell_sq(path) + " > " + shell_sq(tmp_s));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-x86 failed"); process_exit(1); }
        let r_as: Result[String, String] = sys_exec(sys, "sh", "-c", "as --64 -o " + shell_sq(tmp_o) + " " + shell_sq(tmp_s));
        if !r_as.is_ok() { println("ERR\tbuild\tas failed"); process_exit(1); }
        let r_ld: Result[String, String] = sys_exec(sys, "sh", "-c", "ld -o " + shell_sq(out) + " " + shell_sq(tmp_o));
        if r_ld.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tld failed");
            process_exit(1);
        }
    }

    if backend == "llvm" {
        let tmp_ll = out + ".tmp.ll";
        let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-$(readlink -f /proc/$PPID/exe)}}\" && $OODAC_BIN emit-llvm " + shell_sq(path) + " > " + shell_sq(tmp_ll));
        if !r_emit.is_ok() { println("ERR\tbuild\temit-llvm failed"); process_exit(1); }
        let clang_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; clang -O0 -Wno-override-module -Wno-unused-command-line-argument -Iruntime $OO_SSL_C " + shell_sq(tmp_ll) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
        let r_clang: Result[String, String] = sys_exec(sys, "sh", "-c", clang_cmd);
        if r_clang.is_ok() {
            println("OK\tbuild\t" + out);
            return;
        } else {
            println("ERR\tbuild\tclang compilation failed");
            process_exit(1);
        }
    }

    // NEW NATIVE BUILD!
    // 1. Collect dependencies via load_expand (List stack/done; last elem = body).
    let le_res: List[String] = load_expand(fs, path, list_new(), list_new());
    let n_le = list_len(le_res);
    let mut mods: List[String] = list_new();
    // done paths are indices 0..n_le-2; body at n_le-1 (unused here).
    let mut i = 0;
    while i + 1 < n_le {
        mods = list_push(mods, list_get(le_res, i));
        i = i + 1;
    }

    let tmp_all_c = out + ".tmp.c";
    let mut host: String = "./oodac/oodac";
    let hp: String = ".ooda-cache/ooda-tmp/oodac_host";
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache/ooda-tmp && readlink -f /proc/$PPID/exe | tr -d '\\n' > " + hp);
    if wr.is_ok() {
        let rr: Result[String, String] = read_file(fs, hp);
        if rr.is_ok() {
            host = match rr { Ok(s) => s, Err(e) => e };
        }
    }
    if host == "" {
        host = "./oodac/oodac";
    }
    // Mix host size:mtime into emit-cache names so another ELF cannot reuse C.
    let stamp: String = oo_file_stamp(host);
    let mut stamp_s: String = stamp;
    let col: Int = str_index_of(stamp, ":");
    if col >= 0 {
        stamp_s = str_slice(stamp, 0, col) + "_" + str_slice(stamp, col + 1, chars_len(stamp));
    }

    let r_pre: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-preamble " + shell_sq(path) + " > " + shell_sq(tmp_all_c));
    if !r_pre.is_ok() { println("ERR\tbuild\tpreamble failed"); process_exit(1); }

    let cdir: String = ".ooda-cache/oodac_emit";
    let _mk: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p " + cdir);
    let pre_c: String = cdir + "/preamble_" + stamp_s + ".c";
    let r_cp: Result[String, String] = sys_exec(sys, "sh", "-c", "cp " + shell_sq(tmp_all_c) + " " + shell_sq(pre_c));
    if !r_cp.is_ok() { println("ERR\tbuild\tpreamble cache failed"); process_exit(1); }
    let mut skip: Int = 0;
    let nmods: Int = list_len(mods);
    let mut pbs: List[String] = list_new();
    let mut j = 0;
    while j < nmods {
        let m = list_get(mods, j);
        let hp2: String = ".ooda-cache/ooda-tmp/mod_sha";
        let wrh: Result[String, String] = sys_exec(sys, "sh", "-c", "sha256sum -- " + shell_sq(m) + " | awk '{printf \"%s\", $1}' > " + hp2);
        let mut h: String = "";
        if wrh.is_ok() {
            let rr: Result[String, String] = read_file(fs, hp2);
            if rr.is_ok() {
                h = match rr { Ok(s) => s, Err(e) => e };
            }
        }
        let cf: String = cdir + "/" + stamp_s + "_" + h + ".pb.c";
        let mut hit: Bool = false;
        if h != "" {
            if path_exists(fs, cf) {
                hit = true;
            }
        }
        if !hit {
            let r_pro: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && env -u PURE_NO_ARC -u OODA_PURE_NO_ARC OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-protos " + shell_sq(m) + " > " + shell_sq(cf));
            if !r_pro.is_ok() { println("ERR\tbuild\tprotos failed on " + m); process_exit(1); }
            let r_bod: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-bodies " + shell_sq(m) + " >> " + shell_sq(cf));
            if !r_bod.is_ok() { println("ERR\tbuild\tbodies failed on " + m); process_exit(1); }
        } else {
            skip = skip + 1;
        }
        pbs = list_push(pbs, cf);
        let rcat: Result[String, String] = sys_exec(sys, "sh", "-c", "cat " + shell_sq(cf) + " >> " + shell_sq(tmp_all_c));
        if !rcat.is_ok() { println("ERR\tbuild\tcache cat failed on " + m); process_exit(1); }
        j = j + 1;
    }
    if !quiet {
        println("emit_cache skip=" + skip.to_string() + " of " + nmods.to_string());
    }
    run_native_cc(fs, sys, pbs, pre_c, out, gcc_repro_flags(), quiet);
    if !quiet {
        println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
    }
}
