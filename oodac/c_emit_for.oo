// # Emit for-range and for-in
//
// Logline: Lowers for i in lo..hi and for x in xs to C for-loops.
//
// Setup: c_emit_block, c_env_get, c_list_c_name, and c_pack_pos_env exist.
//
// Beats:
//   1. After in, a lone IDENT plus brace is collection for-in.
//   2. INT or IDENT then DOTDOT then INT or IDENT is a range-for.
//   3. Body uses c_emit_block; optional __mc__ fuel.

pub fn c_for_bound(toks: List[String], pos: Int, n: Int) -> List[String] {
    let mut o: List[String] = list_new();
    if pos >= n {
        println("ERR\tc_emit\tfor residual (missing bound)");
        process_exit(1);
    }
    let k: String = c_tokk(toks, pos);
    if k == "INT" {
        o = list_push(o, (pos + 1).to_string());
        o = list_push(o, c_tokt(toks, pos));
        return o;
    }
    if k == "IDENT" {
        o = list_push(o, (pos + 1).to_string());
        o = list_push(o, c_tokt(toks, pos));
        return o;
    }
    println("ERR\tc_emit\tfor residual (bound must be INT or IDENT)");
    process_exit(1);
    return o;
}

pub fn c_emit_for_in_list(
    toks: List[String],
    pos: Int,
    n: Int,
    env: String,
    v: String,
    xs: String
) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut kind: String = c_env_get(e, xs);
    if kind == "" || kind == "I" {
        kind = "I";
    }
    let ln: String = c_list_c_name("list_len", kind);
    let gt: String = c_list_c_name("list_get", kind);
    let mut ety: String = "long long";
    if kind == "S" || kind == "T" {
        ety = "OoStr";
    }
    if kind == "F" || kind == "LF" {
        ety = "double";
    }
    let ix: String = "__fi_" + v;
    let hn: String = "__fn_" + v;
    println("{");
    println("  long long " + ix + " = 0;");
    println("  long long " + hn + " = " + ln + "(" + xs + ");");
    c_emit_src_line(toks, pos, e);
    println("  for (; " + ix + " < " + hn + "; " + ix + "++) {");
    println("    " + ety + " " + v + " = " + gt + "(" + xs + ", " + ix + ");");
    let mc: String = c_env_get(e, "__mc__");
    if mc != "" {
        c_emit_while_fuel_check(mc);
    }
    let br: List[String] = c_emit_block(toks, p, n, e);
    p = parse_int(list_get(br, 0));
    e = list_get(br, 1);
    println("  }");
    println("}");
    return c_pack_pos_env(p, e);
}

pub fn c_emit_for_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos + 1;
    let mut e: String = env;
    if p >= n || c_tokk(toks, p) != "IDENT" {
        println("ERR\tc_emit\tfor residual (expected loop IDENT)");
        process_exit(1);
    }
    let v: String = c_tokt(toks, p);
    p = p + 1;
    if p >= n || c_tokk(toks, p) != "IDENT"
        || c_tokt(toks, p) != "in"
    {
        println("ERR\tc_emit\tfor residual (need 'in')");
        process_exit(1);
    }
    p = p + 1;
    if p < n && c_tokk(toks, p) == "IDENT" {
        if p + 1 < n && c_tokk(toks, p + 1) == "LBRACE" {
            let xs: String = c_tokt(toks, p);
            p = p + 1;
            return c_emit_for_in_list(toks, p, n, e, v, xs);
        }
    }
    let lo_p: List[String] = c_for_bound(toks, p, n);
    p = parse_int(list_get(lo_p, 0));
    let lo: String = list_get(lo_p, 1);
    if p >= n || c_tokk(toks, p) != "DOTDOT" {
        println("ERR\tc_emit\tfor residual (expected .. between bounds)");
        process_exit(1);
    }
    p = p + 1;
    let hi_p: List[String] = c_for_bound(toks, p, n);
    p = parse_int(list_get(hi_p, 0));
    let hi: String = list_get(hi_p, 1);
    let mc_for: String = c_env_get(e, "__mc__");
    c_emit_src_line(toks, pos, e);
    println(
        "for (long long "
            + v
            + " = "
            + lo
            + "; "
            + v
            + " < "
            + hi
            + "; "
            + v
            + "++) {"
    );
    if mc_for != "" {
        c_emit_while_fuel_check(mc_for);
    }
    let brf: List[String] = c_emit_block(toks, p, n, e);
    p = parse_int(list_get(brf, 0));
    e = list_get(brf, 1);
    println("}");
    return c_pack_pos_env(p, e);
}
