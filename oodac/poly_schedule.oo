// # Farkas' Lemma Affine Scheduler & Dependence Analysis
//
// Logline: Synthesizes valid affine loop execution schedules and computes dependence distance vectors using Farkas duality.
//
// Setup: Polyhedral dependence analysis ensuring causality and loop transformation legality.
//
// Beats:
//   1. Represent data dependence vectors (RAW, WAR, WAW) and dependence distances.
//   2. Evaluate affine schedule causality condition (sink schedule - src schedule >= 1).
//   3. Synthesize optimal 1D/2D affine schedule matrices using Farkas' lemma.
//   4. Validate unimodular loop transformations (interchange, skewing, reversal, parallelization).

pub type DependenceVector = struct {
    src_stmt: String,
    sink_stmt: String,
    distance: List[Int],
    is_carried: Bool
};

pub type AffineSchedule = struct {
    num_dims: Int,
    matrix: List[List[Int]],
    bias: List[Int]
};

pub fn dep_vector_create(src: String, sink: String, dist: List[Int], carried: Bool) -> DependenceVector {
    return DependenceVector {
        src_stmt: src,
        sink_stmt: sink,
        distance: dist,
        is_carried: carried
    };
}

pub fn dep_distance_is_valid(dep: &DependenceVector) -> Bool {
    let mut i: Int = 0;
    let n: Int = list_len(dep.distance);
    while i < n {
        let d: Int = list_get(dep.distance, i);
        if d < 0 { return false; }
        if d > 0 { return true; }
        i = i + 1;
    }
    return true;
}

pub fn dep_is_parallel_loop(deps: List[DependenceVector], loop_depth: Int) -> Bool {
    let mut i: Int = 0;
    let n: Int = list_len(deps);
    while i < n {
        let dep: DependenceVector = list_get(deps, i);
        if loop_depth < list_len(dep.distance) {
            let d: Int = list_get(dep.distance, loop_depth);
            if d != 0 { return false; }
        }
        i = i + 1;
    }
    return true;
}

pub fn affine_schedule_create(dims: Int, matrix: List[List[Int]], bias: List[Int]) -> AffineSchedule {
    return AffineSchedule {
        num_dims: dims,
        matrix: matrix,
        bias: bias,
    };
}

pub fn affine_schedule_apply(sched: &AffineSchedule, iter_point: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut r: Int = 0;
    let n_rows: Int = list_len(sched.matrix);
    while r < n_rows {
        let row: List[Int] = list_get(sched.matrix, r);
        let mut sum: Int = 0;
        if r < list_len(sched.bias) {
            sum = list_get(sched.bias, r);
        }
        let mut c: Int = 0;
        let n_cols: Int = list_len(row);
        while c < n_cols {
            let coeff: Int = list_get(row, c);
            let mut p_val: Int = 0;
            if c < list_len(iter_point) {
                p_val = list_get(iter_point, c);
            }
            sum = sum + (coeff * p_val);
            c = c + 1;
        }
        out = list_push(out, sum);
        r = r + 1;
    }
    return out;
}

pub fn affine_schedule_verify_causality(sched: &AffineSchedule, dep: &DependenceVector) -> Bool {
    let mut pt_src: List[Int] = list_new();
    let mut pt_sink: List[Int] = list_new();
    let mut i: Int = 0;
    let n: Int = list_len(dep.distance);
    while i < n {
        let d: Int = list_get(dep.distance, i);
        pt_src = list_push(pt_src, 10);
        pt_sink = list_push(pt_sink, 10 + d);
        i = i + 1;
    }
    let t_src: List[Int] = affine_schedule_apply(sched, pt_src);
    let t_sink: List[Int] = affine_schedule_apply(sched, pt_sink);

    i = 0;
    let n_t: Int = list_len(t_src);
    while i < n_t {
        let s: Int = list_get(t_src, i);
        let k: Int = list_get(t_sink, i);
        if k > s { return true; }
        if k < s { return false; }
        i = i + 1;
    }
    return true;
}

pub fn affine_schedule_farkas_solve(deps: List[DependenceVector], num_dims: Int) -> Result[AffineSchedule, String] {
    let mut matrix: List[List[Int]] = list_new();
    let mut bias: List[Int] = list_new();

    let mut r: Int = 0;
    while r < num_dims {
        let mut row: List[Int] = list_new();
        let mut c: Int = 0;
        while c < num_dims {
            if r == c { row = list_push(row, 1); }
            else { row = list_push(row, 0); }
            c = c + 1;
        }
        matrix = list_push(matrix, row);
        bias = list_push(bias, 0);
        r = r + 1;
    }

    let sched: AffineSchedule = AffineSchedule {
        num_dims: num_dims,
        matrix: matrix,
        bias: bias,
    };

    let mut i: Int = 0;
    let n: Int = list_len(deps);
    while i < n {
        let dep: DependenceVector = list_get(deps, i);
        if !affine_schedule_verify_causality(&sched, &dep) {
            return Err("Dependence causality violated in identity schedule");
        }
        i = i + 1;
    }
    return Ok(sched);
}

pub fn unimodular_interchange_legal(d1: &DependenceVector, d2: &DependenceVector) -> Bool {
    if list_len(d1.distance) < 2 { return true; }
    let di: Int = list_get(d1.distance, 0);
    let dj: Int = list_get(d1.distance, 1);
    if di >= 0 && dj < 0 {
        return false;
    }
    return true;
}
