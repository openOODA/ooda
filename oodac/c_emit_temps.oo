// # Bind emit-C string temps
//
// Logline: Names which String-producing calls must bind to __tN locals so ARC can release them at scope exit.
//
// Setup: oodac is single-threaded. Process state lives in chs_rt_emit_tmp.c. Those C functions are builtins, not Ooda wrappers.
//
// Beats:
//   1. Emit calls oo_emit_tmp_reset, enter, leave, own, release_all_print, and bind as free names.
//   2. Bind field_at, tok_line, concat, and list_get or index_get only when the C call is oo_slist_get.
//   3. own takes the last temp when let or return keeps that pointer.

pub fn c_expr_is_emit_tmp(s: String) -> Bool {
    let n = chars_len(s);
    if n < 4 {
        return false;
    }
    if char_at(s, 0) != "_" || char_at(s, 1) != "_" || char_at(s, 2) != "t" {
        return false;
    }
    let mut i = 3;
    while i < n {
        if !char_is_digit(char_at(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn c_is_oo_slist_get_call(call: String) -> Bool {
    let pre = "oo_slist_get(";
    let n = chars_len(call);
    let pn = chars_len(pre);
    if n < pn {
        return false;
    }
    let mut i = 0;
    while i < pn {
        if char_at(call, i) != char_at(pre, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn c_should_bind_str_temp(name: String, call: String) -> Bool {
    if name == "field_at" || name == "tok_line" || name == "concat" {
        return true;
    }
    if name == "list_get" || name == "index_get" {
        return c_is_oo_slist_get_call(call);
    }
    return false;
}

pub fn c_bind_str_temp_if(name: String, call: String) -> String {
    if c_should_bind_str_temp(name, call) {
        return oo_emit_tmp_bind(call);
    }
    return call;
}
