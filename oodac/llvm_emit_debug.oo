// # Emit LLVM DWARF debug metadata
//
// Logline: Generates DWARF debug metadata nodes for compile units, subprograms, basic types, files, and line locations.
//
// Setup: Emits !DICompileUnit, !DISubprogram, !DILocation, !DIBasicType, and !DIFile metadata when debug mode is enabled.
//
// Beats:
//   1. Check whether debug mode is enabled and initialize debug environment state.
//   2. Allocate DISubprogram metadata nodes for functions and attach debug function tags.
//   3. Allocate DILocation metadata nodes for statements and instructions.
//   4. Emit the complete DWARF metadata pool at the end of the module.

import "token_fmt.oo";
import "llvm_emit_env.oo";

pub fn llvm_debug_enabled(env: List[String]) -> Bool {
    return llvm_env_get_var_ty(env, "__dbg_on__") == "1";
}

pub fn llvm_debug_sp_node(dbg_next: String, fn_name: String, fn_line: Int, ret_ty: String) -> List[String] {
    let mut next_val = 20;
    if dbg_next != "" { next_val = parse_int(dbg_next); }
    let sp_id = next_val;
    let next_id = sp_id + 1;
    let ls: String = fn_line.to_string();
    let id_s: String = sp_id.to_string();
    let node_text: String = "!" + id_s + " = distinct !DISubprogram(name: \"" + fn_name + "\", scope: !1, file: !1, line: " + ls + ", type: !6, scopeLine: " + ls + ", flags: DIFlagPrototyped, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !15)\n";
    let mut res: List[String] = list_new();
    res = list_push(res, next_id.to_string());
    res = list_push(res, id_s);
    res = list_push(res, node_text);
    return res;
}

pub fn llvm_debug_loc_node(dbg_next: String, line: Int, col: Int, sp_node: String) -> List[String] {
    let mut next_val = 20;
    if dbg_next != "" { next_val = parse_int(dbg_next); }
    let loc_id = next_val;
    let next_id = loc_id + 1;
    let ls: String = line.to_string();
    let cs: String = col.to_string();
    let id_s: String = loc_id.to_string();
    let node_text: String = "!" + id_s + " = !DILocation(line: " + ls + ", column: " + cs + ", scope: !" + sp_node + ")\n";
    let mut res: List[String] = list_new();
    res = list_push(res, next_id.to_string());
    res = list_push(res, id_s);
    res = list_push(res, node_text);
    return res;
}

pub fn llvm_debug_fn_enter(env: List[String], sp_node: String, dbg_next: String, dbg_meta: String) -> List[String] {
    let mut cur: List[String] = env;
    cur = llvm_env_add_var(cur, "__dbg_on__", "1");
    cur = llvm_env_add_var(cur, "__dbg_sp__", sp_node);
    cur = llvm_env_add_var(cur, "__dbg_next__", dbg_next);
    cur = llvm_env_add_var(cur, "__dbg_meta__", dbg_meta);
    return cur;
}

pub fn llvm_debug_unpack_env(env: List[String]) -> List[String] {
    let mut res: List[String] = list_new();
    res = list_push(res, llvm_env_get_var_ty(env, "__dbg_meta__"));
    res = list_push(res, llvm_env_get_var_ty(env, "__dbg_next__"));
    return res;
}

pub fn llvm_debug_loc_alloc(env: List[String], line: Int, col: Int) -> List[String] {
    if !llvm_debug_enabled(env) {
        let mut no_res: List[String] = list_new();
        no_res = list_push(no_res, "");
        no_res = list_push(no_res, list_get(env, 0));
        no_res = list_push(no_res, list_get(env, 1));
        no_res = list_push(no_res, list_get(env, 2));
        no_res = list_push(no_res, list_get(env, 3));
        no_res = list_push(no_res, list_get(env, 4));
        return no_res;
    }
    let sp_node: String = llvm_env_get_var_ty(env, "__dbg_sp__");
    let cur_next: String = llvm_env_get_var_ty(env, "__dbg_next__");
    let cur_meta: String = llvm_env_get_var_ty(env, "__dbg_meta__");
    let loc_pair: List[String] = llvm_debug_loc_node(cur_next, line, col, sp_node);
    let next_id: String = list_get(loc_pair, 0);
    let loc_id: String = list_get(loc_pair, 1);
    let node_text: String = list_get(loc_pair, 2);
    let tag: String = ", !dbg !" + loc_id;
    let mut new_env: List[String] = env;
    new_env = llvm_env_add_var(new_env, "__dbg_next__", next_id);
    new_env = llvm_env_add_var(new_env, "__dbg_meta__", cur_meta + node_text);
    let mut res: List[String] = list_new();
    res = list_push(res, tag);
    res = list_push(res, list_get(new_env, 0));
    res = list_push(res, list_get(new_env, 1));
    res = list_push(res, list_get(new_env, 2));
    res = list_push(res, list_get(new_env, 3));
    res = list_push(res, list_get(new_env, 4));
    return res;
}

pub fn llvm_debug_loc_tok(env: List[String], tok: String) -> List[String] {
    if !llvm_debug_enabled(env) {
        let mut no_res: List[String] = list_new();
        no_res = list_push(no_res, "");
        no_res = list_push(no_res, list_get(env, 0));
        no_res = list_push(no_res, list_get(env, 1));
        no_res = list_push(no_res, list_get(env, 2));
        no_res = list_push(no_res, list_get(env, 3));
        no_res = list_push(no_res, list_get(env, 4));
        return no_res;
    }
    let line: Int = parse_int(field_at(tok, 1));
    let col: Int = parse_int(field_at(tok, 2));
    return llvm_debug_loc_alloc(env, line, col);
}

pub fn llvm_emit_debug_pool(path: String, dbg_meta: String) {
    let mut file_p: String = path;
    if file_p == "" { file_p = "openOODA.oo"; }
    let dir_p: String = ".";

    println("; --- DWARF Debug Metadata ---");
    println("!llvm.dbg.cu = !{!0}");
    println("!llvm.module.flags = !{!2, !3, !4, !5}");
    println("!llvm.ident = !{!16}");
    println("");
    println("!0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: \"oodac\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false, nameTableKind: None)");
    println("!1 = !DIFile(filename: \"" + file_p + "\", directory: \"" + dir_p + "\")");
    println("!2 = !{i32 7, !\"Dwarf Version\", i32 5}");
    println("!3 = !{i32 2, !\"Debug Info Version\", i32 3}");
    println("!4 = !{i32 1, !\"wchar_size\", i32 4}");
    println("!5 = !{i32 7, !\"frame-pointer\", i32 2}");
    println("!6 = !DISubroutineType(types: !7)");
    println("!7 = !{!8}");
    println("!8 = !DIBasicType(name: \"int64\", size: 64, encoding: DW_ATE_signed)");
    println("!9 = !DIBasicType(name: \"int32\", size: 32, encoding: DW_ATE_signed)");
    println("!10 = !DIBasicType(name: \"double\", size: 64, encoding: DW_ATE_float)");
    println("!11 = !DIBasicType(name: \"bool\", size: 8, encoding: DW_ATE_boolean)");
    println("!12 = !DIBasicType(name: \"char\", size: 8, encoding: DW_ATE_signed_char)");
    println("!15 = !{}");
    println("!16 = !{!\"oodac openOODA compiler\"}");
    println("");
    if dbg_meta != "" {
        println(dbg_meta);
    }
}
