// # Lower Ok and Err constructors
//
// Logline: Build an OoResS or OoResV compound from Ok or Err using the current fn return kind.
//
// Setup: c_env_get and c_expr_is_str_env exist. Result[Void] is V. Ok(void) has no payload.
//
// Beats:
//   1. Result[Void] Ok is ok=1 and an empty err string.
//   2. Result[Void] Err is ok=0 and the message.
//   3. Result[String] Ok keeps the string payload. Unmatched non-string Ok is OoResI.

// Result[T, Int] after the comma. pos sits on the Result IDENT.
pub fn c_result_e_is_int(toks: List[String], pos: Int, n: Int) -> Bool {
    let mut p: Int = pos + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACKET" {
        return false;
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        return false;
    }
    let first: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if first == "List" {
        if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
            let mut d: Int = 1;
            p = p + 1;
            while p < n && d > 0 {
                let k: String = field_at(list_get(toks, p), 0);
                if k == "LBRACKET" {
                    d = d + 1;
                }
                if k == "RBRACKET" {
                    d = d - 1;
                }
                p = p + 1;
            }
        }
    }
    if p >= n || field_at(list_get(toks, p), 0) != "COMMA" {
        return false;
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        return false;
    }
    return field_at(list_get(toks, p), 3) == "Int";
}

pub fn c_lower_ok_err(name: String, args: String, env: String) -> String {
    let rv: String = c_env_get(env, "__ret__");
    let rct: String = c_env_get(env, "__ret_c_ty__");
    let mut nm: String = name;
    let mut ag: String = args;
    if nm == "Some" {
        nm = "Ok";
    }
    if nm == "None" {
        nm = "Err";
        ag = "oo_str_lit(\"\")";
    }
    if nm == "Ok" {
        if rv == "V" {
            return "((OoResV){1, oo_str_lit(\"\")})";
        }
        if rv == "RII" {
            return "((OoResII){1, " + ag + ", 0})";
        }
        if rv == "RI" {
            return "((OoResI){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RB" {
            return "((OoResB){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RF" {
            return "((OoResF){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RLI" {
            return "((OoResLI){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RLS" {
            return "((OoResLS){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RLF" {
            return "((OoResLF){1, " + ag + ", oo_str_lit(\"\")})";
        }
        if rv == "RN" {
            if rct != "" {
                return "((" + rct + "){1, " + ag + ", oo_str_lit(\"\")})";
            }
        }
        if rv == "R" {
            return "((OoResS){1, " + ag + "})";
        }
        if ag == "void" {
            return "((OoResS){1, oo_str_lit(\"\")})";
        }
        if c_expr_is_str_env(ag, env) {
            return "((OoResS){1, " + ag + "})";
        }
        return "((OoResI){1, " + ag + ", oo_str_lit(\"\")})";
    }
    if nm == "Err" {
        if rv == "V" {
            return "((OoResV){0, " + ag + "})";
        }
        if rv == "RII" {
            return "((OoResII){0, 0, " + ag + "})";
        }
        if rv == "RI" {
            return "((OoResI){0, 0, " + ag + "})";
        }
        if rv == "RB" {
            return "((OoResB){0, 0, " + ag + "})";
        }
        if rv == "RF" {
            return "((OoResF){0, 0.0, " + ag + "})";
        }
        if rv == "RLI" {
            return "((OoResLI){0, oo_ilist_new(), " + ag + "})";
        }
        if rv == "RLS" {
            return "((OoResLS){0, oo_slist_new(), " + ag + "})";
        }
        if rv == "RLF" {
            return "((OoResLF){0, oo_flist_new(), " + ag + "})";
        }
        if rv == "RN" {
            if rct != "" {
                return "((" + rct + "){0, {0}, " + ag + "})";
            }
        }
        return "((OoResS){0, " + ag + "})";
    }
    return "";
}

pub fn result_ok_payload_type(rty: String) -> String {
    let n: Int = chars_len(rty);
    if n < 8 {
        return "String";
    }
    if str_slice(rty, 0, 7) != "Result[" {
        return "String";
    }
    let mut i: Int = 7;
    let mut name: String = "";
    while i < n {
        let c: String = char_at(rty, i);
        if c == "," {
            break;
        }
        if c == "]" {
            break;
        }
        name = name + c;
        i = i + 1;
    }
    if name == "Void" {
        return "Void";
    }
    if name == "List" {
        return str_slice(rty, 7, n - 1);
    }
    if name == "" {
        return "String";
    }
    return name;
}

pub fn c_try_unwrap(call: String, env: String, fname: String) -> String {
    let mut qty: String = c_env_get(env, "__frty__" + fname);
    if qty == "" {
        qty = "OoResS";
        let rk: String = c_env_get(env, "__ret__");
        if rk == "RI" {
            qty = "OoResI";
        }
    }
    return "({ " + qty + " __q = " + call + "; if (!__q.ok) { fprintf(stderr, \"ERR\\ttry\\n\"); exit(1); } __q.val; })";
}
