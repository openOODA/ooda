// # Emit ARC scope releases
//
// Logline: Tracks {; scope frames in the C env and prints oo_*_release calls on scope exit.
//
// Setup: Backend-C floor. env is {; frames and name=kind; T S I LF release; LL_* and multi-char user lists release; F never; __no_arc__ and __formal__ suppress.
//
// Beats:
//   1. c_env_push_scope appends a {; frame; c_is_formal_param reads __formal__name.
//   2. c_emit_scope_exit walks the last frame backward, prints unique non-formal releases, and pops the frame.
//   3. c_emit_all_scope_releases walks every name; c_emit_local_releases slices from the first {; for early return.

pub fn c_env_push_scope(env: String) -> String {
    return env + "{;";
}

pub fn c_is_formal_param(env: String, name: String) -> Int {
    if c_env_get(env, "__formal__" + name) == "1" {
        return 1;
    }
    return 0;
}

// Read kind text after `=` through `;`. Returns [pos_after_semi, kind].
pub fn c_env_take_kind(s: String, p0: Int) -> List[String] {
    let n: Int = chars_len(s);
    let mut p: Int = p0;
    let mut kind: String = "";
    while p < n {
        if char_at(s, p) == ";" {
            break;
        }
        kind = kind + char_at(s, p);
        p = p + 1;
    }
    if p < n {
        p = p + 1;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, p.to_string());
    o = list_push(o, kind);
    return o;
}

// Print-ready release for one kind. F is Float scalar (never). LF is List[Float].
pub fn c_arc_kind_release(kind: String, name: String) -> String {
    if kind == "T" { return "oo_str_release(" + name + "); "; }
    if kind == "S" { return "oo_slist_release(" + name + "); "; }
    if kind == "I" { return "oo_ilist_release(" + name + "); "; }
    if kind == "LF" { return "oo_flist_release(" + name + "); "; }
    if kind == "F" { return ""; }
    let kn = chars_len(kind);
    if kn >= 3 {
        if char_at(kind, 0) == "L" {
            if char_at(kind, 1) == "L" {
                if char_at(kind, 2) == "_" {
                    let mut suf = "";
                    let mut si = 3;
                    while si < kn {
                        suf = suf + char_at(kind, si);
                        si = si + 1;
                    }
                    return "oo_ll_" + suf + "_release(" + name + "); ";
                }
            }
        }
    }
    return "";
}

pub fn c_emit_scope_exit(env: String) -> String {
    let elen = chars_len(env);
    let mut last_idx = -1;
    let mut i = 0;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            last_idx = i;
        }
        i = i + 1;
    }
    if last_idx < 0 {
        return env;
    }
    let top_frame = str_slice(env, last_idx + 2, elen);
    let flen = chars_len(top_frame);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < flen {
        let ch = char_at(top_frame, p);
        if ch == "=" {
            let tk: List[String] = c_env_take_kind(top_frame, p + 1);
            p = parse_int(list_get(tk, 0));
            names = list_push(names, name);
            kinds = list_push(kinds, list_get(tk, 1));
            name = "";
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    let mut out = "  ";
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                // skip
            } else if c_env_get(env, "__no_arc__") != "1" {
                out = out + c_arc_kind_release(kind, name_var);
            }
        }
        i_name = i_name - 1;
    }
    if chars_len(out) > 2 {
        println(out);
    }
    return str_slice(env, 0, last_idx);
}

pub fn c_emit_all_scope_releases(env: String) {
    let elen = chars_len(env);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < elen {
        let ch = char_at(env, p);
        if ch == "{" {
            name = "";
            p = p + 1;
            if p < elen && char_at(env, p) == ";" {
                p = p + 1;
            }
        } else if ch == "=" {
            let tk: List[String] = c_env_take_kind(env, p + 1);
            p = parse_int(list_get(tk, 0));
            names = list_push(names, name);
            kinds = list_push(kinds, list_get(tk, 1));
            name = "";
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    let mut out = "  ";
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                // skip
            } else if c_env_get(env, "__no_arc__") != "1" {
                out = out + c_arc_kind_release(kind, name_var);
            }
        }
        i_name = i_name - 1;
    }
    if chars_len(out) > 2 {
        println(out);
    }
}

// Body locals only: skip pre-scope params/meta (first `{;`). Safe for early return.
pub fn c_emit_local_releases(env: String) {
    let elen = chars_len(env);
    let mut i = 0;
    let mut start = -1;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            start = i;
            i = elen;
        } else {
            i = i + 1;
        }
    }
    if start < 0 {
        return;
    }
    c_emit_all_scope_releases(str_slice(env, start, elen));
}
