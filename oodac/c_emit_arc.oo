// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: ARC / RAII scope frame tracking & lifetime release emission
// stage: emit
// (empty line to preserve line numbers)
pub fn c_env_push_scope(env: String) -> String {
    return env + "{;";
}

pub fn c_is_formal_param(env: String, name: String) -> Int {
    if c_env_get(env, "__formal__" + name) == "1" {
        return 1;
    }
    return 0;
}

pub fn c_emit_scope_exit(env: String) -> String {
    let elen = chars_len(env);
    let mut last_idx = -1;
    let mut i = 0;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            last_idx = i;
        }
        i = i + 1;
    }
    if last_idx < 0 {
        return env;
    }
    let top_frame = str_slice(env, last_idx + 2, elen);
    let flen = chars_len(top_frame);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < flen {
        let ch = char_at(top_frame, p);
        if ch == "=" {
            if p + 1 < flen {
                let kind = char_at(top_frame, p + 1);
                names = list_push(names, name);
                kinds = list_push(kinds, kind);
            }
            name = "";
            p = p + 2;
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    let mut out = "  ";
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                // skip
            } else if c_env_get(env, "__no_arc__") != "1" {
                if kind == "T" { out = out + "oo_str_release(" + name_var + "); "; }
                if kind == "S" { out = out + "oo_slist_release(" + name_var + "); "; }
                if kind == "I" { out = out + "oo_ilist_release(" + name_var + "); "; }
            }
        }
        i_name = i_name - 1;
    }
    if chars_len(out) > 2 {
        println(out);
    }
    return str_slice(env, 0, last_idx);
}

pub fn c_emit_all_scope_releases(env: String) {
    let elen = chars_len(env);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < elen {
        let ch = char_at(env, p);
        if ch == "{" {
            name = "";
            p = p + 1;
            if p < elen && char_at(env, p) == ";" {
                p = p + 1;
            }
        } else if ch == "=" {
            if p + 1 < elen {
                let kind = char_at(env, p + 1);
                names = list_push(names, name);
                kinds = list_push(kinds, kind);
            }
            name = "";
            p = p + 2;
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    let mut out = "  ";
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                // skip
            } else if c_env_get(env, "__no_arc__") != "1" {
                if kind == "T" { out = out + "oo_str_release(" + name_var + "); "; }
                if kind == "S" { out = out + "oo_slist_release(" + name_var + "); "; }
                if kind == "I" { out = out + "oo_ilist_release(" + name_var + "); "; }
            }
        }
        i_name = i_name - 1;
    }
    if chars_len(out) > 2 {
        println(out);
    }
}

// Body locals only: skip pre-scope params/meta (first `{;`). Safe for early return.
pub fn c_emit_local_releases(env: String) {
    let elen = chars_len(env);
    let mut i = 0;
    let mut start = -1;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            start = i;
            i = elen;
        } else {
            i = i + 1;
        }
    }
    if start < 0 {
        return;
    }
    c_emit_all_scope_releases(str_slice(env, start, elen));
}
