// # Detect const if BOOL || BOOL println with no else
//
// Logline: Returns the then STRING when a function body is only if KW_TRUE/KW_FALSE OROR KW_TRUE/KW_FALSE with one println(STRING) and no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if BOOL OROR BOOL then one println(STRING) branch and the function RBRACE.
//   3. Return the then STRING when either side is KW_TRUE. IDENT operands miss.
//
// residual: if true || x no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wone_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wone_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wone_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wone_kind(toks, p) != "IDENT" || wone_text(toks, p) != "println" { return empty; }
    if wone_kind(toks, p + 1) != "LPAREN" || wone_kind(toks, p + 2) != "STRING" { return empty; }
    if wone_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wone_text(toks, p + 2);
    p = p + 4;
    if p < n && wone_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn wone_is_bool(k: String) -> Bool {
    if k == "KW_TRUE" { return true; }
    if k == "KW_FALSE" { return true; }
    return false;
}

pub fn wasm_fn_if_or_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wone_kind(toks, i) == "KW_FN" && wone_kind(toks, i + 1) == "IDENT" {
            if wone_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wone_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 4 >= n || wone_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let lk: String = wone_kind(toks, p);
                if !wone_is_bool(lk) { return ""; }
                p = p + 1;
                if p >= n || wone_kind(toks, p) != "OROR" { return ""; }
                p = p + 1;
                let rk: String = wone_kind(toks, p);
                if !wone_is_bool(rk) { return ""; }
                let take_then: Bool = lk == "KW_TRUE" || rk == "KW_TRUE";
                p = p + 1;
                if p >= n || wone_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wone_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wone_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wone_kind(toks, p) != "RBRACE" { return ""; }
                if take_then { return list_get(th, 0); }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
