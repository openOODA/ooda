// # Extra-emit WASM const-print println/arith pick
//
// Logline: Tries named println and arith const-print folds; empty string means miss.
//
// Setup: Sibling wasm_emit_*.oo detectors. fname is the user function name.
//
// Beats:
//   1. Try STRING/ident/strcat single and strcat multi 3-17 and N-println folds through seventeen.
//   2. Try int/bool and INT arith folds including unary minus.
//   3. Return the first non-empty fold text.
//
// residual: IDENT and mixed forms stay dummy in the caller.

import "wasm_emit_lit.oo";
import "wasm_emit_ident.oo";
import "wasm_emit_strcat.oo";
import "wasm_emit_two.oo";
import "wasm_emit_three.oo";
import "wasm_emit_four.oo";
import "wasm_emit_five.oo";
import "wasm_emit_six.oo";
import "wasm_emit_seven.oo";
import "wasm_emit_eight.oo";
import "wasm_emit_nine.oo";
import "wasm_emit_ten.oo";
import "wasm_emit_eleven.oo";
import "wasm_emit_twelve.oo";
import "wasm_emit_thirteen.oo";
import "wasm_emit_fourteen.oo";
import "wasm_emit_fifteen.oo";
import "wasm_emit_sixteen.oo";
import "wasm_emit_seventeen.oo";
import "wasm_emit_int.oo";
import "wasm_emit_bool.oo";
import "wasm_emit_add.oo";
import "wasm_emit_add3.oo";
import "wasm_emit_sub.oo";
import "wasm_emit_mul.oo";
import "wasm_emit_div.oo";
import "wasm_emit_mod.oo";
import "wasm_emit_neg.oo";

pub fn wasm_try_print_fold(src: String, name: String) -> String {
    let mut lit: String = wasm_fn_println_lit(src, name);
    if chars_len(lit) <= 0 { lit = wasm_fn_println_ident(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_strcat(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_strcat_multi(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_two_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_three_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_four_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_five_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_six_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_seven_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_eight_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_nine_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_ten_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_eleven_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_twelve_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_thirteen_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_fourteen_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_fifteen_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_sixteen_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_seventeen_println(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_int(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_bool(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_add(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_add3(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_sub(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_mul(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_div(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_mod(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_println_neg(src, name); }
    return lit;
}
