// # Emit mutable local in stack frame
//
// Logline: Lowers let mut x: Int, reassignment x = V2, and println(x) into stack slots and itoa write.
//
// Setup: tokenize_lines, x86_tok_k, x86_tok_t, and x86_emit_int_routine exist.
//
// Beats:
//   1. Match let mut ident: Int = v1; ident = v2; println(ident).
//   2. Allocate -8(%rbp) slot, store v1, store v2, load -8(%rbp) into %rdi.
//   3. Call _println_int, deallocate stack frame, and exit 0.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_int.oo";

pub fn x86_match_mut_local(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" && i + 1 < n && x86_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 3 < n && x86_tok_k(toks, p) == "LPAREN" && x86_tok_k(toks, p + 1) == "RPAREN" && x86_tok_k(toks, p + 2) == "LBRACE" && x86_tok_k(toks, p + 3) == "KW_LET" {
                p = p + 4;
                if p >= n || x86_tok_k(toks, p) != "KW_MUT" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" { return empty; }
                let var_name: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "COLON" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != "Int" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "EQ" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "INT" { return empty; }
                let v1: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "SEMI" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != var_name { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "EQ" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "INT" { return empty; }
                let v2: String = x86_tok_t(toks, p);
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "SEMI" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != "println" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "LPAREN" { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "IDENT" || x86_tok_t(toks, p) != var_name { return empty; }
                p = p + 1;
                if p >= n || x86_tok_k(toks, p) != "RPAREN" { return empty; }
                p = p + 1;
                if p < n && x86_tok_k(toks, p) == "SEMI" { p = p + 1; }
                if p >= n || x86_tok_k(toks, p) != "RBRACE" { return empty; }
                let mut out: List[String] = list_new();
                out = list_push(out, v1);
                out = list_push(out, v2);
                return out;
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn x86_emit_mut_local(v1: String, v2: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    x86_emit_int_routine();
    println("main:");
    println("_start:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $8, %rsp");
    println("    movq $" + v1 + ", -8(%rbp)");
    println("    movq $" + v2 + ", -8(%rbp)");
    println("    movq -8(%rbp), %rdi");
    println("    call _println_int");
    println("    add $8, %rsp");
    println("    pop %rbp");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
