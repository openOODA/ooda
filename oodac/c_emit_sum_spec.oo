// # User sum spec fields
//
// Logline: Parse Name:tag:kind from a ctor env spec and scan for PIPE.
//
// Setup: spec is Ty:tag or Ty:tag:I|S|U. toks are token rows.
//
// Beats:
//   1. Type is the prefix before the first colon.
//   2. Tag is the field after the first colon.
//   3. Payload kind is I when missing, else the last field.

pub fn c_sum_ty_of(spec: String) -> String {
    let n: Int = chars_len(spec);
    let mut i: Int = 0;
    while i < n {
        if char_at(spec, i) == ":" {
            return str_slice(spec, 0, i);
        }
        i = i + 1;
    }
    return spec;
}

pub fn c_sum_tag_of(spec: String) -> String {
    let n: Int = chars_len(spec);
    let mut i: Int = 0;
    while i < n {
        if char_at(spec, i) == ":" {
            let rest: String = str_slice(spec, i + 1, n);
            let m: Int = chars_len(rest);
            let mut j: Int = 0;
            while j < m {
                if char_at(rest, j) == ":" {
                    return str_slice(rest, 0, j);
                }
                j = j + 1;
            }
            return rest;
        }
        i = i + 1;
    }
    return "0";
}

pub fn c_sum_pay_of(spec: String) -> String {
    let n: Int = chars_len(spec);
    let mut col: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(spec, i) == ":" {
            col = col + 1;
            if col == 2 {
                return str_slice(spec, i + 1, n);
            }
        }
        i = i + 1;
    }
    return "I";
}

pub fn c_sum_has_pipe(toks: List[String], pos: Int, n: Int) -> Bool {
    let mut p: Int = pos;
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "SEMI" || k == "LBRACE" || k == "KW_FN" || k == "KW_TYPE" {
            return false;
        }
        if k == "PIPE" {
            return true;
        }
        p = p + 1;
    }
    return false;
}
