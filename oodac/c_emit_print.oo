// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: lower CHS expr tokens to C snippets (list/string builtins)
// in:  toks + start pos (at first expr token)
// out: via side-effect helpers; c_emit_expr_c returns C text, advances via c_emit_expr_end
// stage: emit

// Map known call names to C runtime (empty string = unknown).

pub fn c_emit_println(toks: List[String], pos: Int, n: Int, env: String) -> Int {
    let mut p: Int = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }
    let mut cont: Bool = true;
    while cont {
        if p >= n || field_at(list_get(toks, p), 0) == "RPAREN" {
            cont = false;
            break;
        }
        let mut sp: Int = p;
        while sp < n {
            let sk: String = field_at(list_get(toks, sp), 0);
            if sk == "COMMA" || sk == "RPAREN" || sk == "SEMI" {
                break;
            }
            if sk == "IDENT" {
                let sn: String = field_at(list_get(toks, sp), 3);
                if c_env_get(env, "__sec__" + sn) == "1" {
                    c_secret_refuse_println_ident(env, sn);
                }
            }
            sp = sp + 1;
        }
        let pr: List[String] = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(pr, 0));
        let arg: String = list_get(pr, 1);
        let mut is_str: Bool = c_expr_is_str_env(arg, env);
        let mut is_bool: Bool = false;
        if chars_len(arg) >= 10 && char_at(arg, 3) == "c" && char_at(arg, 4) == "h" && char_at(arg, 5) == "a" {
            if char_at(arg, 8) == "i" { is_bool = true; is_str = false; }
        }
        // M166: double Float / oo_* math / float lits → %g
        let mut is_dbl: Bool = false;
        if c_env_get(env, arg) == "F" {
            is_dbl = true;
        }
        if !is_dbl {
            let cnm: String = c_rhs_call_name(arg);
            if cnm != "" {
                if c_call_result_ty(cnm) == "double" {
                    is_dbl = true;
                }
            }
        }
        if !is_dbl {
            let c0: String = char_at(arg, 0);
            if c0 == "-" || char_is_digit(c0) {
                let mut di: Int = 1;
                let an: Int = chars_len(arg);
                while di < an {
                    if char_at(arg, di) == "." {
                        is_dbl = true;
                    }
                    di = di + 1;
                }
            }
        }
        if is_str {
            println("  oo_print_str(" + arg + ");");
        } else if is_bool {
            println("  oo_print_bool(" + arg + ");");
        } else if is_dbl {
            println("  oo_print_double(" + arg + ");");
        } else {
            println("  oo_print_int(" + arg + ");");
        }
        if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
            p = p + 1;
        } else {
            cont = false;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    println("  oo_println();");
    return p;
}


