// # Release LLVM ARC values
//
// Logline: Emits LLVM release calls for ARC locals at scope exit and on return, then returns the updated env.
//
// Setup: Backend-LLVM emit. env[3] is the vars string with {; frames of name:ty; llvm_ty_is_arc, llvm_ty_map, and llvm_gen_reg are in scope.
//
// Beats:
//   1. llvm_emit_scope_exit finds the last {; frame, releases each ARC name, and pops that frame from vars.
//   2. String, Int list, and String list each get their oo_*_release call.
//   3. llvm_emit_ret_arc walks from the first {; frame and releases every remaining ARC local before return.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";

// Latest binding of name wins. Skip a shadowed type or a slot already released.
fn llvm_arc_slot(env: List[String], vname: String, vty: String, seen: String) -> String {
    let left: String = llvm_ty_map(llvm_env_get_var_ty(env, vname));
    let right: String = llvm_ty_map(vty);
    if left == right {
        let slot: String = llvm_env_slot(env, vname);
        let mark: String = ";" + slot + ";";
        let sn = chars_len(seen);
        let mn = chars_len(mark);
        let mut si = 0;
        while si + mn <= sn {
            if str_slice(seen, si, si + mn) == mark {
                return "";
            }
            si = si + 1;
        }
        return slot;
    }
    return "";
}

pub fn llvm_emit_scope_exit(env: List[String]) -> List[String] {
    let vars = list_get(env, 3);
    let n = chars_len(vars);
    let mut last_scope = -1;
    let mut i = 0;
    while i < n - 1 {
        if char_at(vars, i) == "{" && char_at(vars, i + 1) == ";" {
            last_scope = i;
        }
        i = i + 1;
    }
    if last_scope < 0 {
        return env;
    }

    let frame = str_slice(vars, last_scope + 2, n);
    let new_vars = str_slice(vars, 0, last_scope);

    // Parse variable declarations in current frame: name:ty;
    let fn_len = chars_len(frame);
    let mut cur_env = env;
    let mut seen: String = ";";
    let mut entry = "";
    let mut j = 0;
    while j <= fn_len {
        let at_end = j == fn_len;
        let mut c = ";";
        if !at_end {
            c = char_at(frame, j);
        }
        if c == ";" || at_end {
            if entry != "" {
                let elen = chars_len(entry);
                let mut colon_pos = -1;
                let mut k = 0;
                while k < elen {
                    if char_at(entry, k) == ":" {
                        colon_pos = k;
                    }
                    k = k + 1;
                }
                if colon_pos > 0 {
                    let vname = str_slice(entry, 0, colon_pos);
                    let vty = str_slice(entry, colon_pos + 1, elen);
                    let skip_meta = chars_len(vname) >= 2 && str_slice(vname, 0, 2) == "__";
                    let mut rel: String = "";
                    if !skip_meta {
                        if llvm_ty_is_arc(vty) {
                            rel = llvm_arc_slot(cur_env, vname, vty, seen);
                        }
                    }
                    if rel != "" {
                        seen = seen + ";" + rel + ";";
                        let lty: String = llvm_ty_map(vty);
                        let reg_res: List[String] = llvm_gen_reg(cur_env);
                        let treg = list_get(reg_res, 0);
                        let r_c = list_get(reg_res, 1);
                        let l_c = list_get(reg_res, 2);
                        let s_c = list_get(reg_res, 3);
                        let v_s = list_get(reg_res, 4);
                        let st_t = list_get(reg_res, 5);

                        let mut next_env: List[String] = list_new();
                        next_env = list_push(next_env, r_c);
                        next_env = list_push(next_env, l_c);
                        next_env = list_push(next_env, s_c);
                        next_env = list_push(next_env, v_s);
                        next_env = list_push(next_env, st_t);
                        cur_env = next_env;

                        if lty == "%OoStr" {
                            println("  " + treg + " = load " + lty + ", " + lty + "* %" + rel + ".slot, align 8");
                            println("  call void @oo_str_release(%OoStr " + treg + ")");
                        } else if lty == "%OoIList" {
                            println("  call void @oo_ilist_release(%OoIList* byval(%OoIList) %" + rel + ".slot)");
                        } else if lty == "%OoSList" {
                            println("  call void @oo_slist_release(%OoSList* byval(%OoSList) %" + rel + ".slot)");
                        } else if lty == "%OoFList" {
                            println("  call void @oo_flist_release(%OoFList* byval(%OoFList) %" + rel + ".slot)");
                        } else if lty == "%OoLL_I" {
                            println("  call void @oo_ll_I_release(%OoLL_I* byval(%OoLL_I) %" + rel + ".slot)");
                        } else if lty == "%OoLL_S" {
                            println("  call void @oo_ll_S_release(%OoLL_S* byval(%OoLL_S) %" + rel + ".slot)");
                        } else if lty == "%OoLL_F" {
                            println("  call void @oo_ll_F_release(%OoLL_F* byval(%OoLL_F) %" + rel + ".slot)");
                        }
                    }
                }
            }
            entry = "";
            j = j + 1;
        } else {
            entry = entry + c;
            j = j + 1;
        }
    }

    let mut out: List[String] = list_new();
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, new_vars);
    out = list_push(out, list_get(cur_env, 4));
    return out;
}


pub fn llvm_emit_ret_arc(env: List[String]) -> List[String] {
    let vars = list_get(env, 3);
    let n = chars_len(vars);
    let mut first_scope = -1;
    let mut i = 0;
    while i < n - 1 {
        if char_at(vars, i) == "{" && char_at(vars, i + 1) == ";" {
            first_scope = i;
            i = n;
        } else {
            i = i + 1;
        }
    }
    if first_scope < 0 {
        return env;
    }
    let frame = str_slice(vars, first_scope + 2, n);
    let fn_len = chars_len(frame);
    let mut cur_env = env;
    let mut seen2: String = ";";
    let mut entry = "";
    let mut j = 0;
    while j <= fn_len {
        let at_end = j == fn_len;
        let mut c = ";";
        if !at_end {
            c = char_at(frame, j);
        }
        if c == ";" || at_end {
            if entry != "" && entry != "{" {
                let elen = chars_len(entry);
                let mut colon_pos = -1;
                let mut k = 0;
                while k < elen {
                    if char_at(entry, k) == ":" {
                        colon_pos = k;
                    }
                    k = k + 1;
                }
                if colon_pos > 0 {
                    let vname = str_slice(entry, 0, colon_pos);
                    let vty = str_slice(entry, colon_pos + 1, elen);
                    let skip_meta2 = chars_len(vname) >= 2 && str_slice(vname, 0, 2) == "__";
                    let mut rel2: String = "";
                    if !skip_meta2 {
                        if llvm_ty_is_arc(vty) {
                            rel2 = llvm_arc_slot(cur_env, vname, vty, seen2);
                        }
                    }
                    if rel2 != "" {
                        seen2 = seen2 + ";" + rel2 + ";";
                        let lty: String = llvm_ty_map(vty);
                        let reg_res: List[String] = llvm_gen_reg(cur_env);
                        let treg: String = list_get(reg_res, 0);
                        cur_env = list_new();
                        cur_env = list_push(cur_env, list_get(reg_res, 1));
                        cur_env = list_push(cur_env, list_get(reg_res, 2));
                        cur_env = list_push(cur_env, list_get(reg_res, 3));
                        cur_env = list_push(cur_env, list_get(reg_res, 4));
                        cur_env = list_push(cur_env, list_get(reg_res, 5));
                        if lty == "%OoStr" {
                            println("  " + treg + " = load " + lty + ", " + lty + "* %" + rel2 + ".slot, align 8");
                            println("  call void @oo_str_release(%OoStr " + treg + ")");
                        } else if lty == "%OoIList" {
                            println("  call void @oo_ilist_release(%OoIList* byval(%OoIList) %" + rel2 + ".slot)");
                        } else if lty == "%OoSList" {
                            println("  call void @oo_slist_release(%OoSList* byval(%OoSList) %" + rel2 + ".slot)");
                        } else if lty == "%OoFList" {
                            println("  call void @oo_flist_release(%OoFList* byval(%OoFList) %" + rel2 + ".slot)");
                        } else if lty == "%OoLL_I" {
                            println("  call void @oo_ll_I_release(%OoLL_I* byval(%OoLL_I) %" + rel2 + ".slot)");
                        } else if lty == "%OoLL_S" {
                            println("  call void @oo_ll_S_release(%OoLL_S* byval(%OoLL_S) %" + rel2 + ".slot)");
                        } else if lty == "%OoLL_F" {
                            println("  call void @oo_ll_F_release(%OoLL_F* byval(%OoLL_F) %" + rel2 + ".slot)");
                        }
                    }
                }
            }
            entry = "";
        } else {
            entry = entry + c;
        }
        j = j + 1;
    }
    return cur_env;
}
