// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: lower CHS expr tokens to C snippets (primary + expr); stage: emit
// returns [new_pos_str, c_text]; env = "name=S;..." for list kind.
pub fn c_emit_pack2(pos_s: String, text: String) -> List[String] {
    let mut o: List[String] = list_new();
    o = list_push(o, pos_s);
    o = list_push(o, text);
    return o;
}
pub fn c_emit_primary_c(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let k = field_at(list_get(toks, p), 0);
    let t = field_at(list_get(toks, p), 3);
    let p1 = p + 1;
    if k == "INT" {
        return c_emit_pack2(p1.to_string(), t + "LL");
    }
    // FLOAT token → C double literal (IEEE Float; no decimal type)
    if k == "FLOAT" {
        return c_emit_pack2(p1.to_string(), t);
    }
    if k == "STRING" {
        return c_emit_pack2(p1.to_string(), "oo_str_lit(\"" + c_escape_str_text(t) + "\")");
    }
    if k == "KW_TRUE" {
        return c_emit_pack2(p1.to_string(), "1");
    }
    if k == "KW_FALSE" {
        return c_emit_pack2(p1.to_string(), "0");
    }
    // Grouping: (expr) — required for (ri + 1) < rn and field_at emit
    if k == "LPAREN" {
        p = p + 1;
        let pr = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(pr, 0));
        let inner = list_get(pr, 1);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
        return c_emit_pack2(p.to_string(), "(" + inner + ")");
    }
    // Unary ! and - (prefix at primary position)
    if k == "BANG" || t == "!" {
        p = p + 1;
        let pru = c_emit_primary_c(toks, p, n, env);
        p = parse_int(list_get(pru, 0));
        return c_emit_pack2(p.to_string(), "(!" + list_get(pru, 1) + ")");
    }
    if k == "MINUS" || t == "-" {
        p = p + 1;
        let prm = c_emit_primary_c(toks, p, n, env);
        p = parse_int(list_get(prm, 0));
        return c_emit_pack2(p.to_string(), "(-" + list_get(prm, 1) + ")");
    }
    if k == "IDENT" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "DOT" {
            return c_emit_method(toks, p, n, env, t);
        }
        if c_is_struct_lit_lbrace(toks, p, n) {
            p = p + 1;
            let mut fields = "";
            let mut first_f = true;
            while p < n && field_at(list_get(toks, p), 0) != "RBRACE" {
                if field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; }
                let fname = field_at(list_get(toks, p), 3);
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "COLON" { p = p + 1; }
                let prf = c_emit_expr_c(toks, p, n, env);
                p = parse_int(list_get(prf, 0));
                let fval = list_get(prf, 1);
                if first_f {
                    fields = "." + fname + " = " + fval;
                    first_f = false;
                } else {
                    fields = fields + ", ." + fname + " = " + fval;
                }
            }
            if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
            return c_emit_pack2(p.to_string(), "((" + t + "){ " + fields + " })");
        }
        if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
            p = p + 1;
            let ap = c_emit_call_args(toks, p, n, env);
            p = parse_int(list_get(ap, 0));
            let args = list_get(ap, 1);
            let a0 = list_get(ap, 2);
            let a1 = list_get(ap, 3);
            let a2g = list_get(ap, 4);
            c_secret_emit_guard(env, t, a0, a1, a2g, args);
            let mut cname = c_lower_call_name(t);
            // index_get → list_get (M166 free-name alias)
            let mut list_op = t;
            if t == "index_get" { list_op = "list_get"; }
            if list_op == "list_new" || list_op == "list_push" || list_op == "list_get" || list_op == "list_len" {
                cname = c_list_c_name(list_op, c_infer_list_kind(env, list_op, a0, a1));
            }
            // Result constructors → OoResS compound (ok=1 Ok, ok=0 Err; val holds payload)
            let mut call = t + "(" + args + ")";
            if t == "Ok" {
                if c_expr_is_str_env(args, env) {
                    call = "((OoResS){1, " + args + "})";
                } else {
                    call = "((OoResS){1, oo_int_to_str(" + args + ")})";
                }
            } else if t == "Err" {
                call = "((OoResS){0, " + args + "})";
            } else if t == "meta_epoch" {
                // Path-A metamorphic floor: process-local epoch (0-arg).
                call = "oo_meta_epoch()";
            } else if t == "meta_mix" {
                call = "oo_meta_mix(" + args + ")";
            } else if t == "meta_is_path_a" {
                call = "oo_meta_is_path_a()";
            } else if t == "meta_decoy_touch" {
                call = "(oo_meta_decoy_touch(), 0)";
            } else if t == "process_exit" {
                // process_exit(code) → oo_process_exit(code)
                call = "oo_process_exit(" + args + ")";
            } else if t == "read_file" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tread_file requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_read_file(" + a0 + ", " + a1 + ")";
            } else if t == "write_file" {
                // write_file(fs, path, content) — pass cap IDENT only
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\twrite_file requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_write_file(" + args + ")";
            } else if t == "path_exists" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tpath_exists requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_path_exists(" + a0 + ", " + a1 + ")";
            } else if t == "file_size" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tfile_size requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_file_size(" + a0 + ", " + a1 + ")";
            } else if t == "env_get" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tenv_get requires &EnvCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_env_get(" + a0 + ", " + a1 + ")";
            } else if t == "sys_exec" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tsys_exec requires &SysCap as first arg (not int/lit)");
                    process_exit(1);
                }
                let rest = c_args_drop_first(args);
                if rest == "" {
                    println("ERR\tc_emit\tsys_exec requires program argv");
                    process_exit(1);
                }
                call = "oo_sys_exec(" + a0 + ", (int)(sizeof((OoStr[]){" + rest
                    + "})/sizeof(OoStr)), (OoStr[]){" + rest + "})";
            } else if t == "fetch" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tfetch requires &NetCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_fetch(" + a0 + ", " + a1 + ")";
            } else if t == "now_ms" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tnow_ms requires &TimeCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_now_ms(" + a0 + ")";
            } else if t == "sleep_ms" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tsleep_ms requires &TimeCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_sleep_ms(" + a0 + ", " + a1 + ")";
            } else if t == "random" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\trandom requires &RandCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_random(" + a0 + ")";
            } else if t == "seed" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tseed requires &RandCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_seed(" + a0 + ", " + a1 + "), 0)";
            } else if t == "alloc_bytes" || t == "malloc" {
                // M17/M166: alloc_bytes|malloc(alloc, n) — cap IDENT first; process-local only
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\t" + t + " requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_alloc_bytes(" + a0 + ", " + a1 + ")";
            } else if t == "free_bytes" || t == "free" {
                // M166: free(alloc, p) aliases free_bytes → oo_free_bytes
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\t" + t + " requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_free_bytes(" + a0 + ", " + a1 + "), 0)";
            } else if t == "realloc" {
                // M166 path A: realloc(alloc, p, n) = free p then alloc n (quota token, not OS realloc)
                if a1 == "" || a2g == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\trealloc requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_free_bytes(" + a0 + ", " + a1 + "), oo_alloc_bytes(" + a0 + ", " + a2g + "))";
            } else if is_sealed_net(t) && c_emit_libfloor_call(t, a0, a1, args) == "" {
                // residual net free names only; libfloor path A handled next
                println("ERR\tc_emit\tnet residual: sealed op '" + t + "' not lowered (fail-closed)");
                process_exit(1);
            } else if c_emit_libfloor_call(t, a0, a1, args) != "" {
                call = c_emit_libfloor_call(t, a0, a1, args);
            } else if is_sealed_ffi(t) {
                println("ERR\tc_emit\tffi residual: sealed op '" + t + "' not lowered (no host/C TCB lower)");
                process_exit(1);
            } else if cname != "" {
                call = cname + "(" + args + ")";
            }
            call = "(OO_FLIGHT_RECORDER_LOG(), " + call + ")";
            if p < n && field_at(list_get(toks, p), 0) == "DOT" {
                return c_emit_method(toks, p, n, env, call);
            }
            return c_emit_pack2(p.to_string(), call);
        }
        // M166: xs[i] → list_get (LBRACKET sugar)
        if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
            return c_emit_index_get(toks, p, n, env, t);
        }
        return c_emit_pack2(p.to_string(), t);
    }
    let p_end = p + 1;
    return c_emit_pack2(p_end.to_string(), t);
}
