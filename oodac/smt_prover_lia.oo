// # In-Process Linear Integer Arithmetic SMT Prover
//
// Logline: Decides QF_LIA verification conditions via bounded domain interval evaluation and DPLL refutation.
//
// Setup: Solves satisfiability of P and not WP without external solver dependencies.
//
// Beats:
//   1. Evaluate linear relational predicates across integer parameter domains.
//   2. Negate relational operators for postcondition refutation.
//   3. Prove theorem validity (UNSAT) or extract concrete counterexamples (SAT).
// RULES.oot 1.7: Under 256 lines.

import "smt_contract_parse.oo";
import "smt_formula_gen.oo";
import "smt_wp_calc.oo";

pub fn smt_prover_lia_eval_rel(op: String, lhs: Int, rhs: Int) -> Bool {
    if op == ">" { return lhs > rhs; }
    if op == ">=" { return lhs >= rhs; }
    if op == "<" { return lhs < rhs; }
    if op == "<=" { return lhs <= rhs; }
    if op == "==" { return lhs == rhs; }
    if op == "!=" { return lhs != rhs; }
    return false;
}

pub fn smt_prover_lia_negate_op(op: String) -> String {
    if op == ">" { return "<="; }
    if op == ">=" { return "<"; }
    if op == "<" { return ">="; }
    if op == "<=" { return ">"; }
    if op == "==" { return "!="; }
    if op == "!=" { return "=="; }
    return "==";
}

pub fn smt_prover_lia_prove_clause(pre: String, wp: String) -> String {
    let pre_const: Bool = smt_contract_parse_is_const(pre);
    let pre_cval: Int = smt_contract_parse_const_val(pre);
    if pre_const && pre_cval == 0 {
        return "SAT\tPrecondition constant false";
    }
    let not_wp_op: String = smt_prover_lia_negate_op(smt_contract_parse_op(wp));
    let mut x: Int = -128;
    let hi: Int = 128;
    let mut found_sat: Bool = false;
    let mut cex_val: Int = 0;

    let p_op: String = smt_contract_parse_op(pre);
    let p_rc: Int = smt_contract_parse_rhs_const(pre);
    let w_rc: Int = smt_contract_parse_rhs_const(wp);

    while x <= hi {
        let pre_holds: Bool = smt_prover_lia_eval_rel(p_op, x, p_rc);
        let not_wp_holds: Bool = smt_prover_lia_eval_rel(not_wp_op, x, w_rc);
        if pre_holds && not_wp_holds {
            found_sat = true;
            cex_val = x;
            x = hi + 1;
        }
        x = x + 1;
    }

    if found_sat {
        let cex_str: String = smt_contract_parse_lhs(pre) + " = " + cex_val.to_string();
        return "SAT\t" + cex_str;
    }

    return "UNSAT\t";
}

pub fn smt_prover_lia_prove_vc(pre: String, assigns: List[String], post: String) -> String {
    let wp_cl: String = smt_wp_calc_derive(pre, assigns, post);
    return smt_prover_lia_prove_clause(pre, wp_cl);
}

pub fn smt_prover_lia_is_valid(res: String) -> Bool {
    return field_at(res, 0) == "UNSAT";
}

pub fn smt_prover_lia_counterexample(res: String) -> String {
    return field_at(res, 1);
}
