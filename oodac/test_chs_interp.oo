// # CHS Interpreter Probe
//
// Logline: Probes CHS interpreter evaluation.
//
// Setup: Imports chs_interp.
//
// Beats:
//   1. Probe CHS interpreter main execution.

import "wasm_emit_interp.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut xs = list_new(); xs = list_push(xs, 10); xs = list_push(xs, 20); println(list_len(xs)); println(list_get(xs, 0)); println(list_get(xs, 1)); let s = \"fn\"; println(chars_len(s)); println(char_at(s, 0)); println(char_at(s, 1)); println(str_slice(s, 0, 2)); println(char_is_alpha(char_at(s, 0))); }";
    let out: String = wasm_interp_main(src);
    println("OUT:" + out);
    println("OUT_LEN:" + out.chars_len().to_string());
}
