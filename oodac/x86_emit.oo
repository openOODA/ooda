// # Emit Linux x86_64 AT&T assembly
//
// Logline: Folds hello.oo, emits SysV identity/rsi/cat/greet calls, or harvests println consts.
//
// Setup: fold, id/rsi/str matchers, collect_prints, and x86_emit_linux64 exist.
//
// Beats:
//   1. Tokenize and refuse secret sinks.
//   2. Fold hello.oo greet if the RBRACE-tight shape matches.
//   3. Else emit SysV identity, two-arg rsi, cat bump, or greet call.
//   4. Else harvest println consts.
//
// residual: Int args, 3-arg rdx, looping while, and AArch64 stay later.

import "token_fmt.oo";
import "c_emit_secret_check.oo";
import "x86_emit_fold.oo";
import "x86_emit_fn.oo";
import "x86_emit_rsi.oo";
import "x86_emit_rdx.oo";
import "x86_emit_rcx.oo";
import "x86_emit_r89.oo";
import "x86_emit_str.oo";
import "x86_emit_greet.oo";
import "x86_emit_walk.oo";
import "x86_emit_sys.oo";

pub fn x86_emit_stream(src: String) {
    if chars_len(src) == 0 {
        println("ERR\tx86_emit\tempty");
        process_exit(1);
    }
    let toks: List[String] = tokenize_lines(src);
    check_secret_println_sinks(src, toks);
    let fold: String = x86_fold_hello(src);
    if chars_len(fold) > 0 {
        let mut one: List[String] = list_new();
        one = list_push(one, fold);
        x86_emit_linux64(one);
        return;
    }
    let idc: List[String] = x86_match_id_call(src);
    if list_len(idc) >= 2 {
        x86_emit_id_call(list_get(idc, 0), list_get(idc, 1));
        return;
    }
    let snd: List[String] = x86_match_snd_call(src);
    if list_len(snd) >= 3 {
        x86_emit_snd_call(list_get(snd, 0), list_get(snd, 1), list_get(snd, 2));
        return;
    }
    let thd: List[String] = x86_match_thd_call(src);
    if list_len(thd) >= 4 {
        x86_emit_thd_call(list_get(thd, 0), list_get(thd, 1), list_get(thd, 2), list_get(thd, 3));
        return;
    }
    let fth: List[String] = x86_match_fth_call(src);
    if list_len(fth) >= 5 {
        x86_emit_fth_call(list_get(fth, 0), list_get(fth, 1), list_get(fth, 2), list_get(fth, 3), list_get(fth, 4));
        return;
    }
    let f5: List[String] = x86_match_5th_call(src);
    if list_len(f5) >= 6 {
        x86_emit_5th_call(list_get(f5, 0), list_get(f5, 1), list_get(f5, 2), list_get(f5, 3), list_get(f5, 4), list_get(f5, 5));
        return;
    }
    let f6: List[String] = x86_match_6th_call(src);
    if list_len(f6) >= 7 {
        x86_emit_6th_call(list_get(f6, 0), list_get(f6, 1), list_get(f6, 2), list_get(f6, 3), list_get(f6, 4), list_get(f6, 5), list_get(f6, 6));
        return;
    }
    let cat: List[String] = x86_match_cat_call(src);
    if list_len(cat) >= 3 {
        x86_emit_cat_call(list_get(cat, 0), list_get(cat, 1), list_get(cat, 2));
        return;
    }
    let gr: List[String] = x86_match_greet_call(src);
    if list_len(gr) >= 4 {
        x86_emit_greet_call(list_get(gr, 0), list_get(gr, 1), list_get(gr, 2), list_get(gr, 3));
        return;
    }
    let msgs: List[String] = x86_collect_prints(toks);
    x86_emit_linux64(msgs);
}
