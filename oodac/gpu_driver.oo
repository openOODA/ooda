// # Sovereign Unified GPU Driver & Dispatch Router
//
// Logline: Routes kernel emission and dispatch across Apple Metal, Vulkan SPIR-V, and CUDA PTX backends.
//
// Setup: Pure hardware abstraction interface requiring GpuCap token for kernel dispatch and buffer binding.
//
// Beats:
//   1. Define GpuBackendTarget, GpuBufferDesc, and GpuGridDim configurations.
//   2. Validate buffer bindings, threadgroup dimensions, and memory alignments.
//   3. Route kernel compilation to Metal, SPIR-V, or PTX based on target triple.
//   4. Verify kernel dispatch execution under GpuCap capability token.

import "gpu_metal.oo";
import "gpu_spirv.oo";
import "gpu_ptx.oo";

pub type GpuBackendTarget = struct {
    name: String,
    is_binary: Bool,
    default_ext: String
};

pub type GpuBufferDesc = struct {
    name: String,
    size_bytes: Int,
    binding: Int,
    is_output: Bool
};

pub type GpuGridDim = struct {
    grid_x: Int,
    grid_y: Int,
    grid_z: Int,
    block_x: Int,
    block_y: Int,
    block_z: Int,
    shared_mem_bytes: Int
};

pub type GpuKernelArtifact = struct {
    target_name: String,
    kernel_name: String,
    code: String,
    is_binary: Bool,
    word_count: Int
};

pub fn gpu_target_metal() -> GpuBackendTarget {
    return GpuBackendTarget { name: "metal", is_binary: false, default_ext: ".metal" };
}

pub fn gpu_target_spirv() -> GpuBackendTarget {
    return GpuBackendTarget { name: "spirv", is_binary: true, default_ext: ".spv" };
}

pub fn gpu_target_ptx() -> GpuBackendTarget {
    return GpuBackendTarget { name: "ptx", is_binary: false, default_ext: ".ptx" };
}

pub fn gpu_grid_dim_1d(threads: Int, block_size: Int) -> GpuGridDim {
    let mut bs: Int = block_size;
    if bs <= 0 { bs = 64; }
    let gx: Int = (threads + bs - 1) / bs;
    return GpuGridDim {
        grid_x: gx,
        grid_y: 1,
        grid_z: 1,
        block_x: bs,
        block_y: 1,
        block_z: 1,
        shared_mem_bytes: 0
    };
}

pub fn gpu_grid_dim_2d(width: Int, height: Int, tile_w: Int, tile_h: Int) -> GpuGridDim {
    let mut tw: Int = tile_w;
    let mut th: Int = tile_h;
    if tw <= 0 { tw = 16; }
    if th <= 0 { th = 16; }
    let gx: Int = (width + tw - 1) / tw;
    let gy: Int = (height + th - 1) / th;
    return GpuGridDim {
        grid_x: gx,
        grid_y: gy,
        grid_z: 1,
        block_x: tw,
        block_y: th,
        block_z: 1,
        shared_mem_bytes: tw * th * 4 * 2
    };
}

pub fn gpu_compile_kernel_source(target: String, kernel_name: String, op_type: String) -> Result[GpuKernelArtifact, String] {
    if target == "metal" || target == "msl" {
        let mut src: String = "";
        if op_type == "vec_add" {
            src = metal_emit_vec_add_kernel(kernel_name);
        }
        if op_type == "matmul" {
            src = metal_emit_matmul_kernel(kernel_name, 16);
        }
        if op_type == "rms_norm" {
            src = metal_emit_rms_norm_kernel(kernel_name, 0.00001);
        }
        if op_type == "attention" {
            src = metal_emit_attention_kernel(kernel_name, 64);
        }
        if chars_len(src) == 0 {
            return Err("Unknown op_type for metal: " + op_type);
        }
        return Ok(GpuKernelArtifact {
            target_name: "metal",
            kernel_name: kernel_name,
            code: src,
            is_binary: false,
            word_count: chars_len(src)
        });
    }
    if target == "spirv" || target == "vulkan" {
        let mut words: List[Int] = list_new();
        if op_type == "vec_add" {
            words = spirv_build_vector_add_kernel();
        }
        if op_type == "matmul" {
            words = spirv_build_matmul_kernel();
        }
        if op_type == "dot" || op_type == "attention" {
            words = spirv_build_dot_product_kernel();
        }
        if list_len(words) == 0 {
            return Err("Unknown op_type for spirv: " + op_type);
        }
        let hex: String = spirv_words_to_hex(words);
        return Ok(GpuKernelArtifact {
            target_name: "spirv",
            kernel_name: kernel_name,
            code: hex,
            is_binary: true,
            word_count: list_len(words)
        });
    }
    if target == "ptx" || target == "cuda" {
        let mut src: String = "";
        if op_type == "vec_add" {
            src = ptx_emit_vec_add_kernel(kernel_name, "sm_90");
        }
        if op_type == "matmul" {
            src = ptx_emit_matmul_kernel(kernel_name, "sm_90");
        }
        if op_type == "rms_norm" {
            src = ptx_emit_rms_norm_kernel(kernel_name, "sm_90");
        }
        if op_type == "attention" {
            src = ptx_emit_attention_kernel(kernel_name, "sm_90");
        }
        if chars_len(src) == 0 {
            return Err("Unknown op_type for ptx: " + op_type);
        }
        return Ok(GpuKernelArtifact {
            target_name: "ptx",
            kernel_name: kernel_name,
            code: src,
            is_binary: false,
            word_count: chars_len(src)
        });
    }
    return Err("Unsupported GPU target: " + target);
}

pub fn gpu_dispatch_verify(gpu: &GpuCap, artifact: &GpuKernelArtifact, grid: &GpuGridDim, buffers: List[GpuBufferDesc]) -> Result[Bool, String] {
    if grid.grid_x <= 0 || grid.block_x <= 0 {
        return Err("Invalid GPU grid dimensions");
    }
    if list_len(buffers) == 0 {
        return Err("No buffers bound for GPU dispatch");
    }
    if artifact.word_count <= 0 {
        return Err("Empty kernel artifact payload");
    }
    return Ok(true);
}
