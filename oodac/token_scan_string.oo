// job: scan string literal; stage: tokens
// in: cursor at "; out: empty or TOK/ERR pack (uses pack_* from token_scan_ws)

pub fn try_scan_string(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    if char_at(src, i0) != "\"" {
        return list_new();
    }
    let sl = line0;
    let sc = col0;
    let mut i = i0 + 1;
    let mut line = line0;
    let mut col = col0 + 1;
    let mut s = "";
    let mut cont_s = true;
    while cont_s {
        if i >= n {
            return pack_err("Unterminated string");
        }
        let c2 = char_at(src, i);
        if c2 == "\"" {
            i = i + 1;
            col = col + 1;
            cont_s = false;
        } else if c2 == "\\" {
            i = i + 1;
            col = col + 1;
            if i < n {
                let e = char_at(src, i);
                if e == "n" {
                    s = s + "\n";
                } else if e == "t" {
                    s = s + "\t";
                } else {
                    s = s + e;
                }
                i = i + 1;
                col = col + 1;
            }
        } else {
            if c2 == "\n" {
                line = line + 1;
                col = 1;
                s = s + c2;
                i = i + 1;
            } else {
                s = s + c2;
                i = i + 1;
                col = col + 1;
            }
        }
    }
    return pack_tok(i, line, col, "STRING", s, sl, sc);
}
