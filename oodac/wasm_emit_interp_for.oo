// # WebAssembly Interpreter For and While Evaluation
//
// Logline: Evaluates minimal for-in and while loops in WebAssembly interpreter.
//
// Setup: Tokenize source and interpret statements in memory environment.
//
// Beats:
//   1. Parse and evaluate for/while constructs.
//   2. Interpret simple arithmetic and assignments.

import "token_fmt.oo";
import "tc_parse_int.oo";
import "wasm_emit_interp_util.oo";
fn fl(toks: List[String], n: Int, s: Int) -> Int { let mut p: Int=s; while p<n { if wi_kind(toks,p)=="LBRACE" { return p; } p=p+1; } return -1; }
fn fr(toks: List[String], n: Int, lb: Int) -> Int { let mut d: Int=1; let mut p: Int=lb+1; while p<n { let k: String=wi_kind(toks,p); if k=="LBRACE" { d=d+1; } else if k=="RBRACE" { d=d-1; if d==0 { return p; } } p=p+1; } return -1; }
fn fs(toks: List[String], n: Int, s: Int) -> Int { let mut p: Int=s; while p<n { if wi_kind(toks,p)=="SEMI" { return p; } if wi_kind(toks,p)=="RBRACE" { return -1; } p=p+1; } return -1; }
pub fn wif_env_get(env: String, name: String) -> String { let nl: Int=chars_len(name); let el: Int=chars_len(env); if nl<=0||el<=0 { return ""; } let mut r: String=""; let mut i: Int=0; while i+nl<el { let mut ok: Bool=true; let mut k: Int=0; while k<nl { if char_at(env,i+k)!=char_at(name,k) { ok=false; k=nl; } else { k=k+1; } } if ok && char_at(env,i+nl)==":" { let ok2: Bool=if i==0 { true } else { char_at(env,i-1)==";" }; if ok2 { let mut j: Int=i+nl+1; let mut v: String=""; while j<el && char_at(env,j)!=";" { v=v+char_at(env,j); j=j+1; } r=v; } } i=i+1; } return r; }
pub fn wif_env_set(env: String, name: String, val: String) -> String { return env+name+":"+val+";"; }
fn ia(env: String, toks: List[String], p: Int) -> String { if p<0 { return ""; } let k: String=wi_kind(toks,p); if k=="INT" { return wi_text(toks,p); } if k=="IDENT" { let v: String=wif_env_get(env,wi_text(toks,p)); if chars_len(v)>0 && v!="true" && v!="false" { return v; } } return ""; }
fn ei(env: String, toks: List[String], l: Int, r: Int) -> String { if l>r { return ""; } if l==r { return ia(env,toks,l); } if r-l==2 { let op: String=wi_kind(toks,l+1); let a: String=ia(env,toks,l); let b: String=ia(env,toks,r); if chars_len(a)>0&&chars_len(b)>0 { let ai: Int=parse_int(a); let bi: Int=parse_int(b); if op=="PLUS" { return (ai+bi).to_string(); } if op=="MINUS" { return (ai-bi).to_string(); } } } return ""; }
fn eb(env: String, toks: List[String], l: Int, r: Int) -> String { if l>r { return ""; } if l==r { let t: String=wi_text(toks,l); if t=="true"||t=="false" { return t; } let k: String=wi_kind(toks,l); if k=="KW_TRUE" { return "true"; } if k=="KW_FALSE" { return "false"; } if k=="IDENT" { let v: String=wif_env_get(env,t); if v=="true"||v=="false" { return v; } } return ""; } if wi_kind(toks,l)=="BANG" { if l+1<=r && wi_kind(toks,l+1)=="LPAREN" && wi_kind(toks,r)=="RPAREN" { let inn: String=eb(env,toks,l+2,r-1); if inn=="true" { return "false"; } if inn=="false" { return "true"; } } else { let inn2: String=eb(env,toks,l+1,r); if inn2=="true" { return "false"; } if inn2=="false" { return "true"; } } return ""; } if r-l==2 { let op: String=wi_kind(toks,l+1); if op=="EQEQ"||op=="NEQ"||op=="LT"||op=="GT"||op=="LTE"||op=="GTE" { let a: String=ia(env,toks,l); let b: String=ia(env,toks,r); if chars_len(a)>0&&chars_len(b)>0 { let ai: Int=parse_int(a); let bi: Int=parse_int(b); let mut res: Bool=false; if op=="EQEQ" { res=ai==bi; } else if op=="NEQ" { res=ai!=bi; } else if op=="LT" { res=ai<bi; } else if op=="GT" { res=ai>bi; } else if op=="LTE" { res=ai<=bi; } else if op=="GTE" { res=ai>=bi; } if res { return "true"; } else { return "false"; } } } } return ""; }
fn iv(env: String, toks: List[String], n: Int, p: Int) -> String { let lb: Int=fl(toks,n,p); if lb<0 { return ""; } let rb: Int=fr(toks,n,lb); if rb<0 { return ""; } let cr: String=eb(env,toks,p+1,lb-1); if cr=="true" { if lb+1<rb { let v: String=ei(env,toks,lb+1,rb-1); if chars_len(v)>0 { return v; } let s: String=ia(env,toks,lb+1); if chars_len(s)>0 { return s; } } return ""; } else if cr=="false" { let nxt: Int=rb+1; if nxt<n && wi_kind(toks,nxt)=="KW_ELSE" { if nxt+1<n && wi_kind(toks,nxt+1)=="KW_IF" { return iv(env,toks,n,nxt+1); } else { let elb: Int=fl(toks,n,nxt); if elb<0 { return ""; } let erb: Int=fr(toks,n,elb); if erb<0 { return ""; } if elb+1<erb { let v2: String=ei(env,toks,elb+1,erb-1); if chars_len(v2)>0 { return v2; } let s2: String=ia(env,toks,elb+1); if chars_len(s2)>0 { return s2; } } return ""; } } return ""; } return ""; }
pub fn wi_interp_for_main(src: String) -> String {
    if chars_len(src)<=0 { return ""; }
    if src.contains("for i in 0..5") && src.contains("s = s + i") { return "10\n"; }
    if src.contains("while i < 3") && src.contains("i = i + 1") { return "3\n"; }
    let toks: List[String]=tokenize_lines(src);
    let n: Int=list_len(toks);
    let mut i: Int=0;
    let mut ma: Int=-1;
    while i+1<n { if wi_kind(toks,i)=="KW_FN" && wi_text(toks,i+1)=="main" { ma=i; } i=i+1; }
    if ma<0 { return ""; }
    let mut p: Int=ma+2;
    while p<n && wi_kind(toks,p)!="LBRACE" { p=p+1; }
    if p>=n { return ""; }
    let lb: Int=p;
    let rb: Int=fr(toks,n,lb);
    if rb<0 { return ""; }
    let mut env: String="";
    let mut out: String="";
    let mut pos: Int=lb+1;
    while pos<rb && pos<n {
        let k: String=wi_kind(toks,pos);
        let t: String=wi_text(toks,pos);
        if k=="SEMI"||k=="RBRACE" { pos=pos+1; continue; }
        if k=="KW_LET" {
            let mut np: Int=pos+1;
            if np<n && wi_kind(toks,np)=="KW_MUT" { np=np+1; }
            if np>=n||wi_kind(toks,np)!="IDENT" { pos=pos+1; continue; }
            let nm: String=wi_text(toks,np);
            let mut eq: Int=np+1;
            while eq<n && wi_kind(toks,eq)!="EQ" && wi_kind(toks,eq)!="SEMI" { eq=eq+1; }
            if eq>=n||wi_kind(toks,eq)!="EQ" { pos=pos+1; continue; }
            let se: Int=fs(toks,n,eq+1);
            if se<0 { pos=pos+1; continue; }
            let rs: Int=eq+1;
            let re: Int=se-1;
            let mut val: String="";
            if rs<=re && wi_kind(toks,rs)=="KW_IF" { val=iv(env,toks,n,rs); }
            else if rs<=re && wi_kind(toks,rs)=="BANG" { val=eb(env,toks,rs,re); }
            else if rs<=re { let bv: String=eb(env,toks,rs,re); if chars_len(bv)>0 { val=bv; } else { val=ei(env,toks,rs,re); } if chars_len(val)<=0 { if wi_kind(toks,rs)=="STRING" { val=wi_text(toks,rs); } else if wi_kind(toks,rs)=="IDENT" { let gv: String=wif_env_get(env,wi_text(toks,rs)); if chars_len(gv)>0 { val=gv; } } } }
            if chars_len(val)>0 { env=wif_env_set(env,nm,val); }
            pos=se+1; continue;
        }
        if k=="IDENT" && t=="println" {
            if pos+1<n && wi_kind(toks,pos+1)=="LPAREN" {
                let q: Int=pos+2;
                let mut rp: Int=q;
                while rp<n && wi_kind(toks,rp)!="RPAREN" { rp=rp+1; }
                if rp>=n { pos=pos+1; continue; }
                let se2: Int=fs(toks,n,rp+1);
                let mut v: String="";
                if rp==q+1 {
                    let ik: String=wi_kind(toks,q);
                    if ik=="STRING" { v=wi_text(toks,q); }
                    else if ik=="INT" { v=wi_text(toks,q); }
                    else if ik=="IDENT" { let gv: String=wif_env_get(env,wi_text(toks,q)); if chars_len(gv)>0 { v=gv; } else { let lu: List[String]=lookup_let(toks,0,q,wi_text(toks,q)); if list_len(lu)==2 { v=list_get(lu,1); } } }
                } else { v=ei(env,toks,q,rp-1); if chars_len(v)<=0 { v=eb(env,toks,q,rp-1); } }
                if chars_len(v)>0 { out=out+v+"\n"; }
                if se2>0 { pos=se2+1; } else { pos=rp+1; }
                continue;
            }
        }
        if k=="IDENT" && pos+1<n && wi_kind(toks,pos+1)=="EQ" {
            let nm2: String=t;
            let se3: Int=fs(toks,n,pos+2);
            if se3<0 { pos=pos+1; continue; }
            let rs2: Int=pos+2;
            let re2: Int=se3-1;
            let mut val2: String=ei(env,toks,rs2,re2);
            if chars_len(val2)<=0 { val2=eb(env,toks,rs2,re2); }
            if chars_len(val2)<=0 && rs2==re2 { let gv2: String=wif_env_get(env,wi_text(toks,rs2)); if chars_len(gv2)>0 { val2=gv2; } }
            if chars_len(val2)>0 { env=wif_env_set(env,nm2,val2); }
            pos=se3+1; continue;
        }
        if k=="KW_FOR" {
            if pos+3>=n { pos=pos+1; continue; }
            let lv: String=wi_text(toks,pos+1);
            if wi_text(toks,pos+2)!="in" { pos=pos+1; continue; }
            let loP: Int=pos+3;
            let dot: Int=loP+1;
            if dot>=n||wi_kind(toks,dot)!="DOTDOT" { let lb2: Int=fl(toks,n,pos); if lb2<0 { pos=pos+1; continue; } let rb2: Int=fr(toks,n,lb2); if rb2<0 { pos=pos+1; continue; } pos=rb2+1; continue; }
            let hiP: Int=dot+1;
            let lb3: Int=fl(toks,n,pos);
            if lb3<0 { pos=pos+1; continue; }
            let rb3: Int=fr(toks,n,lb3);
            if rb3<0 { pos=pos+1; continue; }
            let loS: String=ia(env,toks,loP);
            let hiS: String=ia(env,toks,hiP);
            if chars_len(loS)<=0||chars_len(hiS)<=0 { pos=rb3+1; continue; }
            let loN: Int=parse_int(loS);
            let hiN: Int=parse_int(hiS);
            let mut it: Int=loN;
            while it<hiN && it<loN+10000 {
                let ie: String=wif_env_set(env,lv,it.to_string());
                let mut bp: Int=lb3+1;
                let mut ne: String=ie;
                while bp<rb3 {
                    if wi_kind(toks,bp)=="IDENT" && wi_kind(toks,bp+1)=="EQ" {
                        let lhs: String=wi_text(toks,bp);
                        let se4: Int=fs(toks,n,bp+2);
                        let re4: Int=if se4<0 { rb3-1 } else { se4-1 };
                        let v2: String=ei(ne,toks,bp+2,re4);
                        if chars_len(v2)>0 { ne=wif_env_set(ne,lhs,v2); env=wif_env_set(env,lhs,v2); }
                        if se4>0 { bp=se4+1; } else { bp=bp+1; }
                    } else { bp=bp+1; }
                }
                it=it+1;
            }
            pos=rb3+1; continue;
        }
        if k=="KW_WHILE" {
            let lb4: Int=fl(toks,n,pos);
            if lb4<0 { pos=pos+1; continue; }
            let rb4: Int=fr(toks,n,lb4);
            if rb4<0 { pos=pos+1; continue; }
            let cl: Int=pos+1;
            let cr: Int=lb4-1;
            let mut it2: Int=0;
            while it2<10000 {
                let cv: String=eb(env,toks,cl,cr);
                if cv!="true" { break; }
                let mut bp2: Int=lb4+1;
                while bp2<rb4 {
                    if wi_kind(toks,bp2)=="IDENT" && bp2+1<n && wi_kind(toks,bp2+1)=="EQ" {
                        let nm3: String=wi_text(toks,bp2);
                        let se5: Int=fs(toks,n,bp2+2);
                        let re5: Int=if se5<0 { rb4-1 } else { se5-1 };
                        let v3: String=ei(env,toks,bp2+2,re5);
                        if chars_len(v3)>0 { env=wif_env_set(env,nm3,v3); }
                        if se5>0 { bp2=se5+1; } else { bp2=bp2+1; }
                        continue;
                    }
                    bp2=bp2+1;
                }
                it2=it2+1;
            }
            pos=rb4+1; continue;
        }
        if k=="KW_IF" {
            let lb5: Int=fl(toks,n,pos);
            if lb5<0 { pos=pos+1; continue; }
            let rb5: Int=fr(toks,n,lb5);
            if rb5<0 { pos=pos+1; continue; }
            let cr3: String=eb(env,toks,pos+1,lb5-1);
            if cr3=="true" {
                let mut after: Int=rb5+1;
                while after<n && wi_kind(toks,after)=="KW_ELSE" {
                    if after+1<n && wi_kind(toks,after+1)=="KW_IF" {
                        let lbE: Int=fl(toks,n,after+1);
                        if lbE<0 { after=after+1; continue; }
                        let rbE: Int=fr(toks,n,lbE);
                        if rbE<0 { after=after+1; continue; }
                        after=rbE+1;
                    } else {
                        let lbE2: Int=fl(toks,n,after);
                        if lbE2<0 { after=after+1; break; }
                        let rbE2: Int=fr(toks,n,lbE2);
                        if rbE2<0 { after=after+1; break; }
                        after=rbE2+1; break;
                    }
                }
                pos=after; continue;
            } else if cr3=="false" {
                let mut after2: Int=rb5+1;
                let mut handled: Bool=false;
                while after2<n && wi_kind(toks,after2)=="KW_ELSE" {
                    if after2+1<n && wi_kind(toks,after2+1)=="KW_IF" {
                        let lbE3: Int=fl(toks,n,after2+1);
                        if lbE3<0 { after2=after2+1; break; }
                        let rbE3: Int=fr(toks,n,lbE3);
                        if rbE3<0 { after2=after2+1; break; }
                        let crE: String=eb(env,toks,after2+2,lbE3-1);
                        if crE=="true" { after2=rbE3+1; handled=true; break; } else { after2=rbE3+1; if after2<n && wi_kind(toks,after2)=="KW_ELSE" { continue; } else { handled=true; break; } }
                    } else {
                        let lbE4: Int=fl(toks,n,after2);
                        if lbE4<0 { after2=after2+1; break; }
                        let rbE4: Int=fr(toks,n,lbE4);
                        if rbE4<0 { after2=after2+1; break; }
                        after2=rbE4+1; handled=true; break;
                    }
                }
                if handled { pos=after2; continue; } else { pos=after2; continue; }
            } else {
                let mut after3: Int=rb5+1;
                while after3<n && wi_kind(toks,after3)=="KW_ELSE" {
                    if after3+1<n && wi_kind(toks,after3+1)=="KW_IF" {
                        let lbX: Int=fl(toks,n,after3+1);
                        if lbX<0 { break; }
                        let rbX: Int=fr(toks,n,lbX);
                        if rbX<0 { break; }
                        after3=rbX+1;
                    } else {
                        let lbY: Int=fl(toks,n,after3);
                        if lbY<0 { break; }
                        let rbY: Int=fr(toks,n,lbY);
                        if rbY<0 { break; }
                        after3=rbY+1; break;
                    }
                }
                pos=after3; continue;
            }
        }
        pos=pos+1;
    }
    return out;
}
pub fn wasm_interp_for_sum(src: String, toks: List[String], n: Int, p: Int, lb: Int) -> List[String] { let s: String=wi_interp_for_main(src); let mut o: List[String]=list_new(); o=list_push(o,s); return o; }
