// # Print joined load_expand paths
//
// Logline: Expands oodac/main.oo and prints every done path except the trailing body, joined by tabs.
//
// Setup: load_import.oo is in scope; load_expand returns done paths plus the body last.
//
// Beats:
//   1. Call load_expand with empty stack and empty done lists.
//   2. Walk every result except the last and append it plus a tab onto deps.
//   3. Print the joined deps string.

import "load_import.oo";
pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    // load_expand: done paths + body last; print joined done set.
    let le_res: List[String] = load_expand(fs, "oodac/main.oo", list_new(), list_new());
    let n = list_len(le_res);
    let mut deps = "\t";
    let mut i = 0;
    while i + 1 < n {
        deps = deps + list_get(le_res, i) + "\t";
        i = i + 1;
    }
    println(deps);
}
