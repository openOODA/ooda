import "load_import.oo";
pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    // load_expand: done paths + body last; print joined done set.
    let le_res: List[String] = load_expand(fs, "oodac/main.oo", list_new(), list_new());
    let n = list_len(le_res);
    let mut deps = "\t";
    let mut i = 0;
    while i + 1 < n {
        deps = deps + list_get(le_res, i) + "\t";
        i = i + 1;
    }
    println(deps);
}
