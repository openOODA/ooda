// # Detect println of a same-fn string let
//
// Logline: Returns the literal when a function body is only let x = STRING; println(x);.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only let IDENT = STRING ; println ( that IDENT ) ; then RBRACE.
//   3. Return the STRING. Extra statements miss.
//
// residual: concat, Result, match, and call? stay dummy end.

import "token_fmt.oo";

fn wi_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wi_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_ident(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wi_kind(toks, i) == "KW_FN" && wi_kind(toks, i + 1) == "IDENT" {
            if wi_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wi_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p >= n || wi_kind(toks, p) != "KW_LET" {
                    return "";
                }
                p = p + 1;
                if p >= n || wi_kind(toks, p) != "IDENT" {
                    return "";
                }
                let vname: String = wi_text(toks, p);
                p = p + 1;
                if p >= n || wi_kind(toks, p) != "EQ" {
                    return "";
                }
                p = p + 1;
                if p >= n || wi_kind(toks, p) != "STRING" {
                    return "";
                }
                let lit: String = wi_text(toks, p);
                p = p + 1;
                if p < n && wi_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p + 3 >= n {
                    return "";
                }
                if wi_kind(toks, p) != "IDENT" || wi_text(toks, p) != "println" {
                    return "";
                }
                if wi_kind(toks, p + 1) != "LPAREN" {
                    return "";
                }
                if wi_kind(toks, p + 2) != "IDENT" || wi_text(toks, p + 2) != vname {
                    return "";
                }
                if wi_kind(toks, p + 3) != "RPAREN" {
                    return "";
                }
                p = p + 4;
                if p < n && wi_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p < n && wi_kind(toks, p) == "RBRACE" {
                    return lit;
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
