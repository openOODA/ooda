// # Lower binary operations to LLVM
//
// Logline: Evaluates operator precedences and emits integer, floating-point, and string binary operations in LLVM IR.
//
// Setup: llvm_gen_reg and token formatting tools are in scope.
//
// Beats:
//   1. Rank operator precedence for Pratt parsing.
//   2. Lower float binary operations and comparisons.
//   3. Lower integer arithmetic, bitwise shifts, comparisons, and string concatenation/equality.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";

pub fn llvm_binop_prec(op_k: String) -> Int {
    if op_k == "OROR" { return 1; }
    if op_k == "ANDAND" { return 2; }
    if op_k == "PIPE" { return 3; }
    if op_k == "CARET" || op_k == "BXOR" { return 4; }
    if op_k == "AMP" { return 5; }
    if op_k == "EQEQ" || op_k == "NEQ" || op_k == "LT" || op_k == "LTE" || op_k == "GT" || op_k == "GTE" { return 6; }
    if op_k == "LSHIFT" || op_k == "RSHIFT" { return 7; }
    if op_k == "PLUS" || op_k == "MINUS" { return 8; }
    if op_k == "STAR" || op_k == "SLASH" || op_k == "PERCENT" { return 9; }
    return 0;
}

pub fn llvm_apply_binop(op_k: String, lhs_val: String, lhs_ty: String, rhs_val: String, env: List[String]) -> List[String] {
    let mut cur_env: List[String] = env;
    let reg_res: List[String] = llvm_gen_reg(cur_env);
    let mut treg: String = list_get(reg_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_res, 1));
    cur_env = list_push(cur_env, list_get(reg_res, 2));
    cur_env = list_push(cur_env, list_get(reg_res, 3));
    cur_env = list_push(cur_env, list_get(reg_res, 4));
    cur_env = list_push(cur_env, list_get(reg_res, 5));

    let mut out_ty = "i64";
    if lhs_ty == "double" {
        if op_k == "PLUS" { println("  " + treg + " = fadd double " + lhs_val + ", " + rhs_val); out_ty = "double"; }
        else if op_k == "MINUS" { println("  " + treg + " = fsub double " + lhs_val + ", " + rhs_val); out_ty = "double"; }
        else if op_k == "STAR" { println("  " + treg + " = fmul double " + lhs_val + ", " + rhs_val); out_ty = "double"; }
        else if op_k == "SLASH" { println("  " + treg + " = fdiv double " + lhs_val + ", " + rhs_val); out_ty = "double"; }
        else if op_k == "PERCENT" { println("  " + treg + " = frem double " + lhs_val + ", " + rhs_val); out_ty = "double"; }
        else {
            let mut f_inst = "oeq";
            if op_k == "NEQ" { f_inst = "one"; } else if op_k == "LT" { f_inst = "olt"; }
            else if op_k == "LTE" { f_inst = "ole"; } else if op_k == "GT" { f_inst = "ogt"; }
            else if op_k == "GTE" { f_inst = "oge"; }
            let reg2: List[String] = llvm_gen_reg(cur_env);
            let treg2: String = list_get(reg2, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg2, 1));
            cur_env = list_push(cur_env, list_get(reg2, 2));
            cur_env = list_push(cur_env, list_get(reg2, 3));
            cur_env = list_push(cur_env, list_get(reg2, 4));
            cur_env = list_push(cur_env, list_get(reg2, 5));
            println("  " + treg + " = fcmp " + f_inst + " double " + lhs_val + ", " + rhs_val);
            println("  " + treg2 + " = zext i1 " + treg + " to i32");
            treg = treg2;
            out_ty = "i32";
        }
    } else if op_k == "PLUS" {
        if lhs_ty == "%OoStr" {
            println("  " + treg + " = call %OoStr @oo_str_concat(%OoStr " + lhs_val + ", %OoStr " + rhs_val + ")");
            out_ty = "%OoStr";
        } else { println("  " + treg + " = add i64 " + lhs_val + ", " + rhs_val); }
    } else if op_k == "MINUS" { println("  " + treg + " = sub i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "STAR" { println("  " + treg + " = mul i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "SLASH" { println("  " + treg + " = sdiv i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "PERCENT" { println("  " + treg + " = srem i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "AMP" { println("  " + treg + " = and i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "PIPE" { println("  " + treg + " = or i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "CARET" || op_k == "BXOR" { println("  " + treg + " = xor i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "LSHIFT" { println("  " + treg + " = shl i64 " + lhs_val + ", " + rhs_val); }
    else if op_k == "RSHIFT" { println("  " + treg + " = ashr i64 " + lhs_val + ", " + rhs_val); }
    else {
        let mut inst = "eq";
        if op_k == "NEQ" { inst = "ne"; } else if op_k == "LT" { inst = "slt"; }
        else if op_k == "LTE" { inst = "sle"; } else if op_k == "GT" { inst = "sgt"; }
        else if op_k == "GTE" { inst = "sge"; }
        if lhs_ty == "%OoStr" {
            println("  " + treg + " = call i32 @oo_str_eq(%OoStr " + lhs_val + ", %OoStr " + rhs_val + ")");
        } else {
            let reg2: List[String] = llvm_gen_reg(cur_env);
            let treg2: String = list_get(reg2, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg2, 1));
            cur_env = list_push(cur_env, list_get(reg2, 2));
            cur_env = list_push(cur_env, list_get(reg2, 3));
            cur_env = list_push(cur_env, list_get(reg2, 4));
            cur_env = list_push(cur_env, list_get(reg2, 5));
            println("  " + treg + " = icmp " + inst + " i64 " + lhs_val + ", " + rhs_val);
            println("  " + treg2 + " = zext i1 " + treg + " to i32");
            treg = treg2;
        }
        out_ty = "i32";
    }

    let mut out: List[String] = list_new();
    out = list_push(out, treg);
    out = list_push(out, out_ty);
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
