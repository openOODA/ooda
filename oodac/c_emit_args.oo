// # C call-arg helpers
//
// Logline: Classify call args: cap lits, last arg, and drop-first for C emit.
//
// Setup: Call argument strings are parsed for capability and literal classification.
//
// Beats:
//   1. Classify unwrap expressions on the right-hand side.
//   2. Inspect capability literals and last argument positions.
//   3. Handle drop-first calling conventions.

pub fn c_rhs_is_unwrap(rhs: String) -> Bool {
    let n = chars_len(rhs);
    if n < 24 {
        return false;
    }
    if char_at(rhs, 0) != "(" || char_at(rhs, 1) != "(" {
        return false;
    }
    let mut i = 0;
    while i + 6 < n {
        if char_at(rhs, i) == "u" && char_at(rhs, i + 1) == "n" {
            if char_at(rhs, i + 2) == "w" && char_at(rhs, i + 3) == "r" {
                if char_at(rhs, i + 4) == "a" && char_at(rhs, i + 5) == "p" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Product ints lower as NNNLL — magic-int cap forge must not pass emit.
pub fn c_arg_is_int_lit(a: String) -> Bool {
    let n = chars_len(a);
    if n < 3 || char_at(a, n - 1) != "L" || char_at(a, n - 2) != "L" {
        return false;
    }
    let c0 = char_at(a, 0);
    if c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" { return true; }
    if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" { return true; }
    return false;
}

// Sealed first arg must be a bare cap IDENT (fs/sys/env/param), not lit/call.
pub fn c_arg_is_cap_ident(a: String) -> Bool {
    let n = chars_len(a);
    if n == 0 {
        return false;
    }
    if c_arg_is_int_lit(a) {
        return false;
    }
    let mut i = 0;
    while i < n {
        let c = char_at(a, i);
        if c == "(" || c == ")" || c == " " || c == "," || c == "\"" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Last top-level C arg (sys_exec shell string is last). String-aware: commas
// inside "..." / escapes do not split (audit residual close).
pub fn c_sys_exec_last_arg(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return "oo_str_lit(\"\")";
    }
    let mut last_start = 0;
    let mut i = 0;
    let mut in_str = false;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "(" {
            depth = depth + 1;
            i = i + 1;
        } else if c == ")" {
            depth = depth - 1;
            i = i + 1;
        } else if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        last_start = j;
                        j = n;
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    // CRIT 7.2: one str_slice for the last arg span — no per-char OoStr thrash.
    // Runtime: product oodac T c_sys_exec_last_arg calls oo_str_slice×1, 0 concat,
    // no char[N]. chs_rt has no copy (oo_sys_exec is fork+execvp, other ABI).
    if last_start >= n {
        return args;
    }
    let out = str_slice(args, last_start, n);
    if out == "" {
        return args;
    }
    return out;
}

// Drop first top-level arg: write_file(fs, path, content) → path, content.
pub fn c_args_drop_first(args: String) -> String {
    let n = chars_len(args);
    let mut i = 0;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if c == "(" {
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
        }
        if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        // Same as last-arg: slice remainder once (no per-char concat).
                        return str_slice(args, j, n);
                    }
                }
                return "";
            }
        }
        i = i + 1;
    }
    return args;
}

// Strip CR from C-level argv source. Fixes CR-in-argv bug (8.6):
// argv must not contain CR (codepoint 13) at runtime. Forms:
//   (1) bare CR byte 13 (CRLF source) — NOT Ooda "\r" (that matches letter r)
//   (2) 2-char C escape `\r` from c_escape_str_text on real CR
// CRITICAL: never test c == "\r" — Ooda "\r" == letter r and would strip every 'r'
// (oo_str_lit → oo_st_lit, "true" → "tue") and break ProcessCap sys_exec emit.
pub fn c_args_strip_cr(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return args;
    }
    // 8.6: keep-run str_slice (not per-char). Filter is not one span.
    let mut out = "";
    let mut i = 0;
    let mut run = 0;
    while i < n {
        let c = char_at(args, i);
        // Bare CR only (byte 13). Letter r is byte 114 — must pass through.
        let mut cut = 0;
        if byte_at(c, 0) == 13 {
            cut = 1;
        }
        if c == "\\" && (i + 1) < n && char_at(args, i + 1) == "r" {
            cut = 2;
        }
        if cut > 0 {
            if i > run {
                out = out + str_slice(args, run, i);
            }
            i = i + cut;
            run = i;
        } else {
            i = i + 1;
        }
    }
    if run == 0 {
        return args;
    }
    if run < n {
        out = out + str_slice(args, run, n);
    }
    return out;
}

// Count top-level C args (string-aware commas). Used for sys_exec argv arity.
pub fn c_count_top_args(args: String) -> Int {
    let n = chars_len(args);
    if n == 0 {
        return 0;
    }
    let mut count = 1;
    let mut i = 0;
    let mut in_str = false;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "(" {
            depth = depth + 1;
            i = i + 1;
        } else if c == ")" {
            depth = depth - 1;
            i = i + 1;
        } else if c == "," {
            if depth == 0 {
                count = count + 1;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return count;
}
