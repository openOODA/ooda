// package: backend-c — emit floor
// job: C call-arg helpers (cap lit, last arg, drop first)
// stage: emit

pub fn c_rhs_is_unwrap(rhs: String) -> Bool {
    let n = chars_len(rhs);
    if n < 24 {
        return false;
    }
    if char_at(rhs, 0) != "(" || char_at(rhs, 1) != "(" {
        return false;
    }
    let mut i = 0;
    while i + 6 < n {
        if char_at(rhs, i) == "u" && char_at(rhs, i + 1) == "n" {
            if char_at(rhs, i + 2) == "w" && char_at(rhs, i + 3) == "r" {
                if char_at(rhs, i + 4) == "a" && char_at(rhs, i + 5) == "p" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Product ints lower as NNNLL — magic-int cap forge must not pass emit.
pub fn c_arg_is_int_lit(a: String) -> Bool {
    let n = chars_len(a);
    if n < 3 {
        return false;
    }
    if char_at(a, n - 1) != "L" {
        return false;
    }
    if char_at(a, n - 2) != "L" {
        return false;
    }
    let c0 = char_at(a, 0);
    if c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
        return true;
    }
    if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
        return true;
    }
    return false;
}

// Sealed first arg must be a bare cap IDENT (fs/sys/env/param), not lit/call.
pub fn c_arg_is_cap_ident(a: String) -> Bool {
    let n = chars_len(a);
    if n == 0 {
        return false;
    }
    if c_arg_is_int_lit(a) {
        return false;
    }
    let mut i = 0;
    while i < n {
        let c = char_at(a, i);
        if c == "(" || c == ")" || c == " " || c == "," || c == "\"" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Last top-level C arg (sys_exec shell string is last). String-aware: commas
// inside "..." / escapes do not split (audit residual close).
pub fn c_sys_exec_last_arg(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return "oo_str_lit(\"\")";
    }
    let mut last_start = 0;
    let mut i = 0;
    let mut in_str = false;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "(" {
            depth = depth + 1;
            i = i + 1;
        } else if c == ")" {
            depth = depth - 1;
            i = i + 1;
        } else if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        last_start = j;
                        j = n;
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    let mut out = "";
    let mut j = last_start;
    while j < n {
        out = out + char_at(args, j);
        j = j + 1;
    }
    if out == "" {
        return args;
    }
    return out;
}

// Drop first top-level arg: write_file(fs, path, content) → path, content.
pub fn c_args_drop_first(args: String) -> String {
    let n = chars_len(args);
    let mut i = 0;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if c == "(" {
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
        }
        if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        let mut out = "";
                        while j < n {
                            out = out + char_at(args, j);
                            j = j + 1;
                        }
                        return out;
                    }
                }
                return "";
            }
        }
        i = i + 1;
    }
    return args;
}

// Parse args starting AFTER LPAREN; stop at RPAREN. Each arg is a full expr.
