// # Emit zero-libc sys_mmap native heap allocator
//
// Logline: Emits standalone x86_64 dynamic heap allocator using Linux syscall 9 (mmap).
//
// Setup: tokenize_lines, x86_tok_k, and x86_tok_t exist.
//
// Beats:
//   1. Emit .Lheap_ptr and .Lheap_end in .bss.
//   2. Emit oo_x86_alloc routine (8-byte alignment, 64KB page expansion via sys_mmap).
//   3. Provide x86_emit_heap_allocator() for inclusion in generated assembly.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_int.oo";

pub fn x86_emit_heap_allocator() {
    println(".globl oo_x86_alloc");
    println(".p2align 4");
    println("oo_x86_alloc:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    add $7, %rdi");
    println("    and $-8, %rdi");
    println("    mov .Lheap_ptr(%rip), %rax");
    println("    mov .Lheap_end(%rip), %rdx");
    println("    mov %rax, %rcx");
    println("    add %rdi, %rcx");
    println("    cmp %rdx, %rcx");
    println("    jle .Lalloc_fit");
    println("    push %rdi");
    println("    mov $9, %rax");
    println("    xor %rdi, %rdi");
    println("    mov $65536, %rsi");
    println("    mov $3, %rdx");
    println("    mov $34, %r10");
    println("    mov $-1, %r8");
    println("    xor %r9, %r9");
    println("    syscall");
    println("    pop %rdi");
    println("    mov %rax, .Lheap_ptr(%rip)");
    println("    add $65536, %rax");
    println("    mov %rax, .Lheap_end(%rip)");
    println("    mov .Lheap_ptr(%rip), %rax");
    println("    mov %rax, %rcx");
    println("    add %rdi, %rcx");
    println(".Lalloc_fit:");
    println("    mov %rcx, .Lheap_ptr(%rip)");
    println("    pop %rbp");
    println("    ret");
}

pub fn x86_emit_heap_bss() {
    println("    .section .bss");
    println("    .p2align 3");
    println(".Lheap_ptr:");
    println("    .quad 0");
    println(".Lheap_end:");
    println("    .quad 0");
}

pub fn x86_match_heap_test(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "IDENT" && x86_tok_t(toks, i) == "heap_alloc_test" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn x86_emit_heap_test() {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    x86_emit_heap_bss();
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    x86_emit_heap_allocator();
    x86_emit_int_routine();
    println("main:");
    println("_start:");
    println("    mov $16, %rdi");
    println("    call oo_x86_alloc");
    println("    movq $77, 0(%rax)");
    println("    movq $88, 8(%rax)");
    println("    movq 0(%rax), %rdi");
    println("    call _println_int");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
