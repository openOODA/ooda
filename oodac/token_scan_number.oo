// job: scan INT/FLOAT token; stage: tokens
// in: cursor at digit; out: empty or TOK pack

pub fn try_scan_number(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n: Int = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    let ch: String = char_at(src, i0);
    if !char_is_digit(ch) {
        return list_new();
    }
    let sl: Int = line0;
    let sc: Int = col0;
    let mut i: Int = i0;
    let mut col: Int = col0;
    let mut line: Int = line0;
    let mut num: Int = ch;
    i = i + 1;
    col = col + 1;
    let mut cont_d: Bool = true;
    while cont_d {
        if i >= n {
            cont_d = false;
        } else {
            let c2: String = char_at(src, i);
            if char_is_digit(c2) {
                num = num + c2;
                i = i + 1;
                col = col + 1;
            } else {
                cont_d = false;
            }
        }
    }
    if i < n {
        if char_at(src, i) == "." {
            if i + 1 < n {
                if char_at(src, i + 1) != "." {
                    if char_is_digit(char_at(src, i + 1)) {
                        num = num + ".";
                        i = i + 1;
                        col = col + 1;
                        let mut cont_f: Bool = true;
                        while cont_f {
                            if i >= n {
                                cont_f = false;
                            } else {
                                let c3: String = char_at(src, i);
                                if char_is_digit(c3) {
                                    num = num + c3;
                                    i = i + 1;
                                    col = col + 1;
                                } else {
                                    cont_f = false;
                                }
                            }
                        }
                        return pack_tok(i, line, col, "FLOAT", num, sl, sc);
                    }
                }
            }
        }
    }
    return pack_tok(i, line, col, "INT", num, sl, sc);
}
