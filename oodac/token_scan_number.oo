// # Scan an integer or float
//
// Logline: If the cursor sits on a digit, eat the rest of the number and pack it as INT, or FLOAT when a fractional part follows a single dot.
//
// Setup: chars_len, char_at, char_is_digit, list_new, and pack_tok exist; lex_step calls this after ws and string miss.
//
// Beats:
//   1. Past the end or a non-digit returns an empty list.
//   2. Eat digits, then a single "." only when the next character is a digit (not "..").
//   3. Pack FLOAT after a fractional loop, otherwise pack INT.

pub fn try_scan_number(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    let ch = char_at(src, i0);
    if !char_is_digit(ch) {
        return list_new();
    }
    let sl = line0;
    let sc = col0;
    let mut i = i0;
    let mut col = col0;
    let mut line = line0;
    let mut num = ch;
    i = i + 1;
    col = col + 1;
    let mut cont_d = true;
    while cont_d {
        if i >= n {
            cont_d = false;
        } else {
            let c2 = char_at(src, i);
            if char_is_digit(c2) {
                num = num + c2;
                i = i + 1;
                col = col + 1;
            } else {
                cont_d = false;
            }
        }
    }
    if i < n {
        if char_at(src, i) == "." {
            if i + 1 < n {
                if char_at(src, i + 1) != "." {
                    if char_is_digit(char_at(src, i + 1)) {
                        num = num + ".";
                        i = i + 1;
                        col = col + 1;
                        let mut cont_f = true;
                        while cont_f {
                            if i >= n {
                                cont_f = false;
                            } else {
                                let c3 = char_at(src, i);
                                if char_is_digit(c3) {
                                    num = num + c3;
                                    i = i + 1;
                                    col = col + 1;
                                } else {
                                    cont_f = false;
                                }
                            }
                        }
                        return pack_tok(i, line, col, "FLOAT", num, sl, sc);
                    }
                }
            }
        }
    }
    return pack_tok(i, line, col, "INT", num, sl, sc);
}
