// # sret for 24-byte Result[Void] and Result[String]
//
// Logline: %OoResV and %OoResS are 24 bytes; x86-64 returns only rax+rdx, so emit sret define, store-ret, and call with debug and sanitizer attachments.
//
// Setup: Called from llvm_emit_fn, llvm_emit_stmt, and llvm_emit_call. Runtime read_file stays by-value declare.
//
// Beats:
//   1. llvm_ty_needs_sret is true for %OoResV and %OoResS.
//   2. define void @f(%OoResS* sret(%OoResS) %__sret) with optional sanitizer and !dbg attachments.
//   3. store into %__sret then ret void; user callers alloca, call, and load.

pub fn llvm_ty_needs_sret(t: String) -> Bool {
    if t == "%OoResV" || t == "%OoResS" || t == "%OoResI" || t == "%OoResB" || t == "%OoResF" {
        return true;
    }
    return false;
}

pub fn llvm_sret_user_call(fn_name: String, lty: String) -> Bool {
    if llvm_ty_needs_sret(lty) {
        if fn_name == "read_file" || fn_name == "write_file" || fn_name == "process_exec" || fn_name == "sys_exec" || fn_name == "lex_item" {
            return false;
        }
        return true;
    }
    return false;
}

pub fn llvm_emit_fn_define(fn_name: String, llvm_ret_ty: String, param_sig: String) {
    llvm_emit_fn_define_san(fn_name, llvm_ret_ty, param_sig, "", "");
}

pub fn llvm_emit_fn_define_dbg(fn_name: String, llvm_ret_ty: String, param_sig: String, sp_node: String) {
    llvm_emit_fn_define_san(fn_name, llvm_ret_ty, param_sig, sp_node, "");
}

pub fn llvm_emit_fn_define_san(fn_name: String, llvm_ret_ty: String, param_sig: String, sp_node: String, san_attrs: String) {
    let mut dbg_attr = "";
    if sp_node != "" { dbg_attr = " !dbg !" + sp_node; }
    let mut sattrs = san_attrs;
    if sattrs != "" && char_at(sattrs, 0) != " " { sattrs = " " + sattrs; }
    if llvm_ty_needs_sret(llvm_ret_ty) {
        let mut ps: String = llvm_ret_ty + "* sret(" + llvm_ret_ty + ") %__sret";
        if param_sig != "" { ps = ps + ", " + param_sig; }
        println("define void @" + fn_name + "(" + ps + ")" + sattrs + dbg_attr + " {");
    } else {
        println("define " + llvm_ret_ty + " @" + fn_name + "(" + param_sig + ")" + sattrs + dbg_attr + " {");
    }
}

pub fn llvm_emit_sret_ret(ty: String, val: String) {
    println("  store " + ty + " " + val + ", " + ty + "* %__sret, align 8");
    println("  ret void");
}

pub fn llvm_emit_sret_ret_dbg(ty: String, val: String, dbg_tag: String) {
    println("  store " + ty + " " + val + ", " + ty + "* %__sret, align 8" + dbg_tag);
    println("  ret void" + dbg_tag);
}

pub fn llvm_emit_fn_default_ret(llvm_ret_ty: String) {
    llvm_emit_fn_default_ret_dbg(llvm_ret_ty, "");
}

pub fn llvm_emit_fn_default_ret_dbg(llvm_ret_ty: String, dbg_tag: String) {
    if llvm_ty_needs_sret(llvm_ret_ty) {
        llvm_emit_sret_ret_dbg(llvm_ret_ty, "zeroinitializer", dbg_tag);
    } else if llvm_ret_ty == "i32" {
        println("  ret i32 0" + dbg_tag);
    } else if llvm_ret_ty == "i64" {
        println("  ret i64 0" + dbg_tag);
    } else if llvm_ret_ty == "double" {
        println("  ret double 0.0" + dbg_tag);
    } else if llvm_ret_ty == "void" || llvm_ret_ty == "" {
        println("  ret void" + dbg_tag);
    } else {
        println("  ret " + llvm_ret_ty + " zeroinitializer" + dbg_tag);
    }
}

pub fn llvm_emit_sret_call(treg: String, lty: String, call_name: String, args_str: String) {
    println("  " + treg + ".sret = alloca " + lty + ", align 8");
    if args_str != "" {
        println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + treg + ".sret, " + args_str + ")");
    } else {
        println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + treg + ".sret)");
    }
    println("  " + treg + " = load " + lty + ", " + lty + "* " + treg + ".sret, align 8");
}
