// # Detect a println-only function body
//
// Logline: Returns the string literal when a named function body is only println of that literal.
//
// Setup: tokenize_lines and field_at exist; STRING text is the unquoted body.
//
// Beats:
//   1. Walk tokens until KW_FN plus IDENT matches fname.
//   2. Skip the header to the opening brace.
//   3. Accept only println ( STRING ) with an optional semicolon, then the close brace.
//
// residual: greet, locals, and non-literal println stay empty.

import "token_fmt.oo";

fn wasm_tok_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wasm_tok_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_lit(src: String, fname: String) -> String {
    if chars_len(src) <= 0 {
        return "";
    }
    if chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wasm_tok_kind(toks, i) == "KW_FN" {
            if wasm_tok_kind(toks, i + 1) == "IDENT" {
                if wasm_tok_text(toks, i + 1) == fname {
                    let mut p: Int = i + 2;
                    while p < n {
                        if wasm_tok_kind(toks, p) == "LBRACE" {
                            p = p + 1;
                            if p + 3 >= n {
                                return "";
                            }
                            if wasm_tok_kind(toks, p) != "IDENT" {
                                return "";
                            }
                            if wasm_tok_text(toks, p) != "println" {
                                return "";
                            }
                            if wasm_tok_kind(toks, p + 1) != "LPAREN" {
                                return "";
                            }
                            if wasm_tok_kind(toks, p + 2) != "STRING" {
                                return "";
                            }
                            if wasm_tok_kind(toks, p + 3) != "RPAREN" {
                                return "";
                            }
                            let lit: String = wasm_tok_text(toks, p + 2);
                            p = p + 4;
                            if p < n {
                                if wasm_tok_kind(toks, p) == "SEMI" {
                                    p = p + 1;
                                }
                            }
                            if p < n {
                                if wasm_tok_kind(toks, p) == "RBRACE" {
                                    return lit;
                                }
                            }
                            return "";
                        }
                        p = p + 1;
                    }
                    return "";
                }
            }
        }
        i = i + 1;
    }
    return "";
}
