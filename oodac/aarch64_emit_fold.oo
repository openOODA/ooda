// # Fold the hello.oo greet shape for AArch64
//
// Logline: Returns the const greet+concat message when source matches fixtures/hello.oo.
//
// Setup: tokenize_lines and field_at exist. STRING text is the unquoted body.
//
// Beats:
//   1. Find fn greet whose return is STRING + IDENT + STRING.
//   2. Find fn main and the greet(STRING) call inside it.
//   3. Return prefix + argument + suffix, or empty when the shape does not match.
//
// residual: general heap strings, AAPCS calls, and product oodac dispatch stay later.

import "token_fmt.oo";

fn a64f_k(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn a64f_t(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn a64f_find_fn(toks: List[String], n: Int, fname: String) -> Int {
    let mut i = 0;
    while i + 1 < n {
        if a64f_k(toks, i) == "KW_FN" {
            if a64f_k(toks, i + 1) == "IDENT" {
                if a64f_t(toks, i + 1) == fname {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn a64f_skip_lbrace(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    while p < n {
        if a64f_k(toks, p) == "LBRACE" {
            return p;
        }
        p = p + 1;
    }
    return -1;
}

fn a64f_greet_param(toks: List[String], n: Int, g: Int) -> String {
    let mut p = g + 2;
    while p < n {
        if a64f_k(toks, p) == "LPAREN" {
            if p + 1 < n && a64f_k(toks, p + 1) == "IDENT" {
                return a64f_t(toks, p + 1);
            }
            return "";
        }
        if a64f_k(toks, p) == "LBRACE" {
            return "";
        }
        p = p + 1;
    }
    return "";
}

fn a64f_greet_parts(toks: List[String], n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let g = a64f_find_fn(toks, n, "greet");
    if g < 0 {
        return empty;
    }
    let pname: String = a64f_greet_param(toks, n, g);
    if chars_len(pname) <= 0 {
        return empty;
    }
    let br = a64f_skip_lbrace(toks, g, n);
    if br < 0 {
        return empty;
    }
    let mut p = br + 1;
    while p < n && a64f_k(toks, p) != "KW_RETURN" && a64f_k(toks, p) != "RBRACE" {
        p = p + 1;
    }
    if p + 5 >= n || a64f_k(toks, p) != "KW_RETURN" {
        return empty;
    }
    if a64f_k(toks, p + 1) != "STRING" || a64f_k(toks, p + 2) != "PLUS" {
        return empty;
    }
    if a64f_k(toks, p + 3) != "IDENT" || a64f_t(toks, p + 3) != pname {
        return empty;
    }
    if a64f_k(toks, p + 4) != "PLUS" || a64f_k(toks, p + 5) != "STRING" {
        return empty;
    }
    let pre: String = a64f_t(toks, p + 1);
    let suf: String = a64f_t(toks, p + 5);
    p = p + 6;
    if p < n && a64f_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64f_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut parts: List[String] = list_new();
    parts = list_push(parts, pre);
    parts = list_push(parts, suf);
    return parts;
}

fn a64f_main_arg(toks: List[String], n: Int) -> String {
    let m = a64f_find_fn(toks, n, "main");
    if m < 0 {
        return "";
    }
    let br = a64f_skip_lbrace(toks, m, n);
    if br < 0 {
        return "";
    }
    let mut p = br + 1;
    if p >= n || a64f_k(toks, p) != "KW_LET" {
        return "";
    }
    p = p + 1;
    if p >= n || a64f_k(toks, p) != "IDENT" {
        return "";
    }
    let vname: String = a64f_t(toks, p);
    p = p + 1;
    if p >= n || a64f_k(toks, p) != "EQ" {
        return "";
    }
    p = p + 1;
    if p + 3 >= n {
        return "";
    }
    if a64f_k(toks, p) != "IDENT" || a64f_t(toks, p) != "greet" {
        return "";
    }
    if a64f_k(toks, p + 1) != "LPAREN" || a64f_k(toks, p + 2) != "STRING" {
        return "";
    }
    if a64f_k(toks, p + 3) != "RPAREN" {
        return "";
    }
    let arg: String = a64f_t(toks, p + 2);
    p = p + 4;
    if p < n && a64f_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p + 3 >= n {
        return "";
    }
    if a64f_k(toks, p) != "IDENT" || a64f_t(toks, p) != "println" {
        return "";
    }
    if a64f_k(toks, p + 1) != "LPAREN" {
        return "";
    }
    if a64f_k(toks, p + 2) != "IDENT" || a64f_t(toks, p + 2) != vname {
        return "";
    }
    if a64f_k(toks, p + 3) != "RPAREN" {
        return "";
    }
    p = p + 4;
    if p < n && a64f_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64f_k(toks, p) != "RBRACE" {
        return "";
    }
    return arg;
}

pub fn aarch64_fold_hello(src: String) -> String {
    if chars_len(src) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let parts: List[String] = a64f_greet_parts(toks, n);
    if list_len(parts) < 2 {
        return "";
    }
    let arg: String = a64f_main_arg(toks, n);
    if chars_len(arg) <= 0 {
        return "";
    }
    return list_get(parts, 0) + arg + list_get(parts, 1);
}
