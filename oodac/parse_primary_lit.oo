// # Dump Literal Primaries
//
// Logline: Print an EXPR LIT line for INT, STRING, true, or false at pos0 and return the next token, or return -1.
//
// Setup: toks rows are kind, line, col, text; pos0 is the current token; indent and escape_dump are in scope.
//
// Beats:
//   1. Read kind, span, and text at pos0 under the dump indent.
//   2. On INT or STRING, print EXPR LIT and return pos + 1.
//   3. On KW_TRUE or KW_FALSE, print EXPR LIT bool and return pos + 1.
//   4. Return -1 when the token is not a literal.

pub fn parse_primary_try_lit(toks: List[String], pos0: Int, depth: Int) -> Int {
    let pos = pos0;
    let pad: String = indent(depth);
    let k: String = field_at(list_get(toks, pos), 0);
    let line: String = field_at(list_get(toks, pos), 1);
    let col: String = field_at(list_get(toks, pos), 2);
    let text: String = field_at(list_get(toks, pos), 3);
    if k == "INT" {
        println(pad + "EXPR LIT int:" + text + " @" + line + ":" + col);
        return pos + 1;
    }
    if k == "STRING" {
        println(pad + "EXPR LIT str:" + escape_dump(text) + " @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_TRUE" {
        println(pad + "EXPR LIT bool:true @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_FALSE" {
        println(pad + "EXPR LIT bool:false @" + line + ":" + col);
        return pos + 1;
    }
    return -1;
}
