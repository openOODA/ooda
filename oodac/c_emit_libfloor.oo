// package: backend-c — emit floor
// job: M161 library free-name lowers (net/sys/thread/gpu/crypto path A)
// stage: emit
// returns C call snippet, or "" if name not a libfloor free call

// t = callee name; a0/a1 = first two arg C texts; args = full comma-joined args
pub fn c_emit_libfloor_call(t: String, a0: String, a1: String, args: String) -> String {
    if t == "tcp_bind" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_bind requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_bind(" + a0 + ", " + a1 + ")";
    }
    if t == "tcp_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_connect(" + args + ")";
    }
    if t == "bind_udp" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tbind_udp requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_bind_udp(" + a0 + ", " + a1 + ")";
    }
    if t == "tls_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttls_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tls_connect(" + args + ")";
    }
    if t == "sys_spawn" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_spawn requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_spawn(" + a0 + ", " + a1 + ")";
    }
    if t == "sys_wait" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_wait requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_wait(" + a0 + ", " + a1 + ")";
    }
    if t == "sys_kill" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_kill requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_kill(" + args + ")";
    }
    if t == "mutex_lock" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tmutex_lock requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_mutex_lock(" + a0 + ", " + a1 + ")";
    }
    if t == "mutex_unlock" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tmutex_unlock requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_mutex_unlock(" + a0 + ", " + a1 + ")";
    }
    if t == "thread_spawn" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tthread_spawn requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_thread_spawn(" + a0 + ", " + a1 + ")";
    }
    if t == "gpu_launch" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tgpu_launch requires &GpuCap first arg");
            process_exit(1);
        }
        return "oo_gpu_launch(" + a0 + ", " + a1 + ")";
    }
    if t == "crypto_md5_internal" {
        return "crypto_md5_internal(" + args + ")";
    }
    if t == "crypto_sha1_internal" {
        return "crypto_sha1_internal(" + args + ")";
    }
    if t == "crypto_aes_encrypt_internal" {
        return "crypto_aes_encrypt_internal(" + args + ")";
    }
    return "";
}
