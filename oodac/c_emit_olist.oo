// # Emit per-struct list helpers
//
// Logline: Print OoL_Name typedef and new/push/get/set/len for List[Name].
//
// Setup: Name* needs a forward Name; fns need a complete Name (sizeof). malloc is in the preamble.
//
// Beats:
//   1. Forward-decl Name; typedef OoL_Name as a growable Name* array (once).
//   2. Emit new, len, get, set, and push after Name is complete (once).
//   3. Get and set exit on out of range. No recurse into elem types.

pub fn c_emit_olist_fwd(name: String) {
    println("#ifndef OO_FWD_" + name);
    println("#define OO_FWD_" + name);
    println("typedef struct " + name + " " + name + ";");
    println("#endif");
}

pub fn c_emit_olist_ty(name: String) {
    let L: String = "OoL_" + name;
    println("#ifndef OO_HAVE_" + L);
    println("#define OO_HAVE_" + L);
    println("typedef struct { " + name + " *data; long long len; long long cap; } " + L + ";");
    println("#endif");
}

// List[Name] / List[OtherUser] on a struct: OoL_* must exist before the field type.
// Does not re-enter type aliases (self-ref would hang). ifndef: never twice.
pub fn c_emit_olist_prep(name: String, elem: String) {
    if elem == "I" || elem == "S" || elem == "F" || elem == "" {
        return;
    }
    if elem == "List" {
        return;
    }
    c_emit_olist_fwd(name);
    c_emit_olist_ty(name);
}

pub fn c_emit_olist_fns(name: String) {
    let L: String = "OoL_" + name;
    let pfx: String = "oo_l_" + name;
    println("#ifndef OO_FNS_" + L);
    println("#define OO_FNS_" + L);
    println("static " + L + " " + pfx + "_new(void) { " + L + " l; l.data=0; l.len=0; l.cap=0; return l; }");
    println("static long long " + pfx + "_len(" + L + " l) { return l.len; }");
    println("static " + name + " " + pfx + "_get(" + L + " l, long long i) {");
    println("  if (i<0||i>=l.len) { fprintf(stderr,\"ERR\\tolist_get OOB\\n\"); exit(1); }");
    println("  return l.data[i]; }");
    println("static " + L + " " + pfx + "_set(" + L + " l, long long i, " + name + " v) {");
    println("  if (i<0||i>=l.len) { fprintf(stderr,\"ERR\\tolist_set OOB\\n\"); exit(1); }");
    println("  l.data[i] = v; return l; }");
    println("static " + L + " " + pfx + "_push(" + L + " l, " + name + " v) {");
    println("  " + L + " n; long long ncap = l.cap ? l.cap : 8;");
    println("  while (ncap < l.len + 1) ncap = ncap * 2;");
    println("  n.data = (" + name + "*)malloc(sizeof(" + name + ")*(size_t)ncap);");
    println("  if (!n.data) abort();");
    println("  if (l.data && l.len > 0) memcpy(n.data, l.data, (size_t)l.len*sizeof(" + name + "));");
    println("  n.data[l.len] = v; n.len = l.len + 1; n.cap = ncap; return n; }");
    println("#endif");
}

pub fn c_emit_olist_helpers(name: String) {
    c_emit_olist_ty(name);
    c_emit_olist_fns(name);
}

// Record List field and param names so list_len((tree).nodes) can pick OoL_*.
pub fn c_list_field_env(toks: List[String], env0: String) -> String {
    let n: Int = list_len(toks);
    let mut e: String = env0;
    let mut i: Int = 0;
    while i + 4 < n {
        let k0: String = field_at(list_get(toks, i), 0);
        if k0 == "IDENT" {
            if field_at(list_get(toks, i + 1), 0) == "COLON" {
                if field_at(list_get(toks, i + 2), 0) == "IDENT" {
                    if field_at(list_get(toks, i + 2), 3) == "List" {
                        if field_at(list_get(toks, i + 3), 0) == "LBRACKET" {
                            if field_at(list_get(toks, i + 4), 0) == "IDENT" {
                                let fname: String = field_at(list_get(toks, i), 3);
                                let elem: String = field_at(list_get(toks, i + 4), 3);
                                let mut kind: String = elem;
                                if elem == "Int" {
                                    kind = "I";
                                }
                                if elem == "String" {
                                    kind = "S";
                                }
                                if elem == "Float" {
                                    kind = "F";
                                }
                                if elem == "f64" {
                                    kind = "F";
                                }
                                e = c_env_put(e, "__fldelem__" + fname, kind);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return e;
}
