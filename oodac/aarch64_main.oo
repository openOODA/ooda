// # Side driver for emit-aarch64
//
// Logline: Reads one .oo path and prints Linux AArch64 GAS without touching product oodac dispatch.
//
// Setup: Built to oodac/oodac.aarch64 via product emit-c + gcc. Does not overwrite oodac/oodac.
//
// Beats:
//   1. Parse emit-aarch64 <file> or a bare file path.
//   2. Refuse a missing, unreadable, or oversized source.
//   3. Stream AArch64 assembly to stdout.
//
// residual: Product oodac/oodac --backend aarch64 and emit-aarch64 dispatch stay later.

import "aarch64_emit.oo";

fn a64_usage() {
    println("oodac: usage: emit-aarch64 <file>");
    process_exit(2);
}

fn a64_path_from_args(args: List[String]) -> String {
    let n = list_len(args);
    if n < 1 {
        a64_usage();
    }
    let a0: String = list_get(args, 0);
    if a0 == "emit-aarch64" {
        if n < 2 {
            a64_usage();
        }
        return list_get(args, 1);
    }
    if a0 == "--backend" {
        if n < 3 {
            a64_usage();
        }
        if list_get(args, 1) != "aarch64" {
            println("ERR\tbackend\t" + list_get(args, 1) + " residual");
            process_exit(2);
        }
        if list_get(args, 2) == "emit-aarch64" {
            if n < 4 {
                a64_usage();
            }
            return list_get(args, 3);
        }
        return list_get(args, 2);
    }
    return a0;
}

pub fn main(fs: &FsCap, args: List[String]) {
    let path: String = a64_path_from_args(args);
    if !path_exists(fs, path) {
        println("ERR\temit-aarch64\tunreadable file: " + path);
        process_exit(1);
    }
    let fsz: Int = file_size(fs, path);
    if fsz > 65536 {
        println("ERR\tload\tsource exceeds 64KiB per-file limit");
        process_exit(1);
    }
    let src_r: Result[String, String] = read_file(fs, path);
    if src_r.is_err() {
        println("ERR\tload\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match src_r { Ok(s) => s, Err(e) => e };
    aarch64_emit_stream(src);
}
