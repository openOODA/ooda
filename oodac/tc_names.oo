// # Reject undefined names
//
// Logline: Walk tokens and bind fn, let, param, match, and for names in a List, then fail on an IDENT that is neither known nor in scope.
//
// Setup: is_known_name, scope_has, drop_depth, and tc_err_at exist. Binds are "name@depth" List entries. extra_binds is a tab-separated string at the API.
//
// Beats:
//   1. Split extra_binds on tabs into the binds List and pre-bind every fn name at depth 0.
//   2. On LBRACE raise depth; on RBRACE drop that depth and step down; on KW_LET and bind-site IDENTs push name@depth.
//   3. On a use IDENT, fail if the name is not known and not in scope. get_builtin_ret_type and get_builtin_arg_types return the small builtin type tables.

import "tc_names_known.oo";

// Bound names are "name@depth" entries in a List (was one big String: the
// append/scan/rebuild churn was quadratic — 30 GB / 50s on large inputs).
// extra_binds: pre-seeded "\tfoo@0\tbar@0\t" (external modules for modular check).
pub fn typecheck_undefined_vars(toks: List[String]) {
    typecheck_undefined_vars_ext(toks, "");
}

pub fn typecheck_undefined_vars_ext(toks: List[String], extra_binds: String) {
    let n = list_len(toks);
    // depth 0: fn names + params always visible in file scope for simplicity
    // extra_binds stays a String at the API boundary (check_drive.oo caller);
    // split it on tabs once into the List form used below. Inline scan (not
    // str_split) so this stays buildable with the current stage host.
    let mut binds: List[String] = list_new();
    let en = chars_len(extra_binds);
    let mut cur = "";
    let mut si = 0;
    while si < en {
        let c: String = char_at(extra_binds, si);
        if c == "\t" {
            if chars_len(cur) > 0 {
                binds = list_push(binds, cur);
                cur = "";
            }
        } else {
            cur = cur + c;
        }
        si = si + 1;
    }
    if chars_len(cur) > 0 {
        binds = list_push(binds, cur);
    }
    let mut depth = 0;
    let mut i = 0;
    // Pre-bind all fn names at depth 0
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    let fname: String = field_at(list_get(toks, i + 1), 3);
                    binds = list_push(binds, fname + "@0");
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "LBRACE" {
            depth = depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            binds = drop_depth(binds, depth);
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
        } else if k == "KW_LET" {
            let mut p = i + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let vname: String = field_at(list_get(toks, p), 3);
                    let ds: String = depth.to_string();
                    binds = list_push(binds, vname + "@" + ds);
                }
            }
            i = i + 1;
        } else if k == "IDENT" {
            let name: String = field_at(list_get(toks, i), 3);
            let mut is_bind = false;
            // param name: ( name : or , name :
            // struct field / struct-lit field: { name : or , name :
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "COLON" {
                    if i > 0 {
                        let pk: String = field_at(list_get(toks, i - 1), 0);
                        if pk == "LPAREN" || pk == "COMMA" || pk == "LBRACE"
                            || pk == "KW_MUT"
                        {
                            is_bind = true;
                            let ds: String = depth.to_string();
                            binds = list_push(binds, name + "@" + ds);
                        }
                    }
                }
            }
            // `Point { ... }` struct constructor — type name, not a variable use.
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "LBRACE" {
                    is_bind = true;
                }
            }
            // match Ok(x)
            if i > 0 {
                if field_at(list_get(toks, i - 1), 0) == "LPAREN" {
                    if i >= 2 {
                        let ctor: String = field_at(list_get(toks, i - 2), 3);
                        if ctor == "Ok" || ctor == "Err" || ctor == "Some" {
                            is_bind = true;
                            let ds: String = depth.to_string();
                            binds = list_push(binds, name + "@" + ds);
                        }
                    }
                }
            }
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "FATARROW" {
                    is_bind = true;
                    let ds: String = depth.to_string();
                    binds = list_push(binds, name + "@" + ds);
                }
            }
            if i > 0 {
                let pk: String = field_at(list_get(toks, i - 1), 0);
                if pk == "KW_FN" || pk == "KW_LET" || pk == "KW_MUT" || pk == "KW_TYPE" {
                    is_bind = true;
                }
                if pk == "COLON" || pk == "ARROW" || pk == "LBRACKET" || pk == "AMP" {
                    is_bind = true;
                }
                if pk == "DOT" {
                    is_bind = true;
                }
                // `for i in ...` — i is a loop bind (KW_FOR; legacy IDENT "for" too).
                if pk == "KW_FOR" {
                    is_bind = true;
                    let ds: String = depth.to_string();
                    binds = list_push(binds, name + "@" + ds);
                }
                if pk == "IDENT" {
                    let pn: String = field_at(list_get(toks, i - 1), 3);
                    if pn == "for" {
                        is_bind = true;
                        let ds: String = depth.to_string();
                        binds = list_push(binds, name + "@" + ds);
                    }
                }
            }
            if !is_bind {
                if !is_known_name(name) {
                    if !scope_has(binds, name, depth) {
                        tc_err_at(
                            toks,
                            i,
                            "undefined variable '" + name + "'"
                        );
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
}

// Check call args that are pure lits against declared param types (R1).
// Table: "\tfname:T0,T1,\t" where Ti is Int/String/Bool/Float/_ 

pub fn get_builtin_ret_type(name: String) -> String {
    if name == "str_split" || name == "oo_fs_read_dir" || name == "oo_sys_args" {
        return "List[String]";
    }
    if name == "str_trim" {
        return "String";
    }
    if name == "oo_fs_is_dir" || name == "oo_file_size" || name == "oo_path_exists" {
        return "Bool";
    }
    return "";
}

pub fn get_builtin_arg_types(name: String) -> String {
    if name == "str_split" {
        return "String,String";
    }
    if name == "str_trim" {
        return "String";
    }
    if name == "oo_fs_read_dir" {
        return "&FsReadCap,String";
    }
    if name == "oo_fs_is_dir" {
        return "&FsReadCap,String";
    }
    if name == "oo_sys_args" {
        return "&ProcessCap";
    }
    return "";
}
