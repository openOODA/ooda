// # Detect println of unary-minus integer literal
//
// Logline: Returns signed decimal text when a function body is only println of MINUS INT|IDENT.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( MINUS INT|IDENT ) with optional semicolon, then RBRACE.
//   3. Return "-" plus magnitude or negated IDENT int. IDENT resolved via let INT lookup.
//
// residual: runtime unary-minus stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wng_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wng_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wng_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wng_kind(toks, p) == "KW_LET" && wng_kind(toks, p + 1) == "IDENT" && wng_text(toks, p + 1) == name && wng_kind(toks, p + 2) == "EQ" && wng_kind(toks, p + 3) == "INT" { return wng_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wng_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wng_kind(toks, pos) == "INT" { return wng_text(toks, pos); }
    if wng_kind(toks, pos) == "IDENT" {
        let name: String = wng_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wng_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wng_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wng_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wng_kind(toks, i) == "KW_FN" && wng_kind(toks, i + 1) == "IDENT" && wng_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wng_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wng_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wng_kind(toks, p) == "KW_LET" {
        while p < n && wng_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wng_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_println_neg(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wng_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wng_p(toks, n, f + 2);
    if p0 < 0 || p0 + 4 >= n { return ""; }
    if wng_kind(toks, p0) != "IDENT" || wng_text(toks, p0) != "println" { return ""; }
    if wng_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    if wng_kind(toks, p0 + 2) != "MINUS" { return ""; }
    let vs: String = wng_int_val(toks, p0 + 3, n);
    if chars_len(vs) <= 0 { return ""; }
    if wng_kind(toks, p0 + 4) != "RPAREN" { return ""; }
    let mut p: Int = p0 + 5;
    if p < n && wng_kind(toks, p) == "SEMI" { p = p + 1; }
    if p < n && wng_kind(toks, p) == "RBRACE" { return (0 - parse_int(vs)).to_string(); }
    return "";
}
