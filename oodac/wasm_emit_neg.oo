// # Detect println of unary-minus integer literal
//
// Logline: Returns signed decimal text when a function body is only println of MINUS INT.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( MINUS INT ) with optional semicolon, then RBRACE.
//   3. Return "-" plus the INT digits. IDENT operand misses.
//
// residual: runtime IDENT unary-minus stays dummy end.

import "token_fmt.oo";

fn wng_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wng_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_neg(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wng_kind(toks, i) == "KW_FN" && wng_kind(toks, i + 1) == "IDENT" {
            if wng_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wng_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 4 >= n { return ""; }
                if wng_kind(toks, p) != "IDENT" || wng_text(toks, p) != "println" { return ""; }
                if wng_kind(toks, p + 1) != "LPAREN" { return ""; }
                if wng_kind(toks, p + 2) != "MINUS" { return ""; }
                if wng_kind(toks, p + 3) != "INT" { return ""; }
                if wng_kind(toks, p + 4) != "RPAREN" { return ""; }
                let digits: String = wng_text(toks, p + 3);
                p = p + 5;
                if p < n && wng_kind(toks, p) == "SEMI" { p = p + 1; }
                if p < n && wng_kind(toks, p) == "RBRACE" {
                    return "-" + digits;
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
