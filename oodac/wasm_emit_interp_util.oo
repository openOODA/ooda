// # WASM interpreter shared helpers
//
// Logline: Shared wi_kind/wi_text/find_fn_ret/lookup_let/eval helpers for wasm_interp_main.
//
// Setup: tokenize_lines + field_at exist; tc_parse_int exists for parse_int.
// Beats:
//   1. wi_kind/wi_text wrap field_at.
//   2. find_fn_ret scans fn return literal.
//   3. lookup_let/eval_int/eval_str resolve let bindings.

import "token_fmt.oo";
import "tc_parse_int.oo";

pub fn wi_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
pub fn wi_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }

pub fn find_fn_ret(toks: List[String], n: Int, fname: String, want: String) -> String {
    let mut i: Int = 0;
    while i + 1 < n {
        if wi_kind(toks, i) == "KW_FN" && wi_text(toks, i + 1) == fname {
            let mut p: Int = i + 2;
            while p < n && wi_kind(toks, p) != "LBRACE" { p = p + 1; }
            if p >= n { return ""; } p = p + 1;
            while p + 1 < n {
                if wi_kind(toks, p) == "KW_RETURN" {
                    if want == "INT" && wi_kind(toks, p + 1) == "INT" { return wi_text(toks, p + 1); }
                    if want == "STRING" && wi_kind(toks, p + 1) == "STRING" { return wi_text(toks, p + 1); }
                    if want == "BOOL" && (wi_text(toks, p + 1) == "true" || wi_text(toks, p + 1) == "false") { return wi_text(toks, p + 1); }
                }
                if wi_kind(toks, p) == "RBRACE" { return ""; }
                p = p + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

pub fn lookup_let(toks: List[String], lb: Int, lim: Int, name: String) -> List[String] {
    let mut p: Int = lb + 1;
    let mut out: List[String] = list_new();
    while p + 3 < lim {
        if wi_kind(toks, p) == "KW_LET" && wi_text(toks, p + 1) == name {
            if wi_kind(toks, p + 2) == "EQ" {
                if wi_kind(toks, p + 3) == "INT" { out = list_push(out, "INT"); out = list_push(out, wi_text(toks, p + 3)); return out; }
                if wi_kind(toks, p + 3) == "STRING" { out = list_push(out, "STRING"); out = list_push(out, wi_text(toks, p + 3)); return out; }
                if wi_kind(toks, p + 3) == "IDENT" {
                    let fnm: String = wi_text(toks, p + 3);
                    if p + 5 < lim && wi_kind(toks, p + 4) == "LPAREN" && wi_kind(toks, p + 5) == "RPAREN" {
                        let r1: String = find_fn_ret(toks, list_len(toks), fnm, "INT");
                        if chars_len(r1) > 0 { out = list_push(out, "INT"); out = list_push(out, r1); return out; }
                        let r2: String = find_fn_ret(toks, list_len(toks), fnm, "STRING");
                        if chars_len(r2) > 0 { out = list_push(out, "STRING"); out = list_push(out, r2); return out; }
                        let r3: String = find_fn_ret(toks, list_len(toks), fnm, "BOOL");
                        if chars_len(r3) > 0 { out = list_push(out, "BOOL"); out = list_push(out, r3); return out; }
                    }
                    if wi_kind(toks, p + 3) == "IDENT" {
                        let other: String = wi_text(toks, p + 3);
                        let inner: List[String] = lookup_let(toks, lb, p, other);
                        if list_len(inner) == 2 { return inner; }
                    }
                }
                if (wi_text(toks, p + 3) == "true" || wi_text(toks, p + 3) == "false") { out = list_push(out, "BOOL"); out = list_push(out, wi_text(toks, p + 3)); return out; }
            }
        }
        p = p + 1;
    }
    return out;
}

pub fn eval_int(toks: List[String], pos: Int, n: Int, lb: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wi_kind(toks, pos) == "INT" { return wi_text(toks, pos); }
    if wi_kind(toks, pos) == "IDENT" {
        let v: List[String] = lookup_let(toks, lb, pos, wi_text(toks, pos));
        if list_len(v) == 2 && list_get(v, 0) == "INT" { return list_get(v, 1); }
    }
    return "";
}

pub fn eval_str(toks: List[String], pos: Int, n: Int, lb: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wi_kind(toks, pos) == "STRING" { return wi_text(toks, pos); }
    if wi_kind(toks, pos) == "IDENT" {
        let v: List[String] = lookup_let(toks, lb, pos, wi_text(toks, pos));
        if list_len(v) == 2 && list_get(v, 0) == "STRING" { return list_get(v, 1); }
    }
    return "";
}
