// # Emit a C block
//
// Logline: Walk a brace block and return the new pos and env.
//
// Setup: Token list and emission environment are positioned at the start of a block.
//
// Beats:
//   1. Enter the block.
//   2. Lower statements inside; exit if a statement does not advance.
//   3. Return [new_pos, env].

pub fn c_emit_block(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let mut iter: Int = 0;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    e = c_env_push_scope(e);
    oo_emit_tmp_enter();
    while p < n {
        iter = iter + 1;
        if iter > n + 100 {
            println("ERR\tc_emit\thang guard exceeded at pos " + p.to_string());
            process_exit(1);
        }
        let k: String = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            e = c_emit_scope_exit(e);
            oo_emit_tmp_leave();
            p = p + 1;
            break;
        }
        let prev: Int = p;
        let st: List[String] = c_emit_stmt(toks, p, n, e);
        p = parse_int(list_get(st, 0));
        e = list_get(st, 1);
        if p == prev {
            println("ERR\tc_emit\tno progress at " + k + " pos " + p.to_string());
            process_exit(1);
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, e);
    return out;
}

// M-CTZ-1: text of the 1-indexed line in src (no trailing \n).
// byte_at is O(1); char_at walks UTF-8 from index 0 (O(i) per call).
pub fn c_line_text_at(src: String, line_num: Int) -> String {
    if line_num <= 0 {
        return "";
    }
    let mut cur: Int = 1;
    let mut i: Int = 0;
    while cur < line_num {
        let b: Int = byte_at(src, i);
        if b < 0 {
            return "";
        }
        if b == 10 {
            cur = cur + 1;
        }
        i = i + 1;
    }
    let start: Int = i;
    let mut j: Int = start;
    while byte_at(src, j) != 10 && byte_at(src, j) >= 0 {
        j = j + 1;
    }
    return str_slice(src, start, j);
}

// True iff the (trimmed) line carries a secret-name directive.
// Used by the __fr_secret__<fn> pre-pass.
pub fn c_is_secret_directive_line(s: String) -> Bool {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 32 || b == 9 {
            i = i + 1;
        } else {
            break;
        }
    }
    if i + 1 >= n {
        return false;
    }
    if byte_at(s, i) != 47 || byte_at(s, i + 1) != 47 {
        return false;
    }
    i = i + 2;
    while i < n {
        let b2: Int = byte_at(s, i);
        if b2 == 32 || b2 == 9 {
            i = i + 1;
        } else {
            break;
        }
    }
    if i + 8 > n {
        return false;
    }
    if byte_at(s, i) != 83 || byte_at(s, i + 1) != 69 || byte_at(s, i + 2) != 67
        || byte_at(s, i + 3) != 82 || byte_at(s, i + 4) != 69 || byte_at(s, i + 5) != 84
        || byte_at(s, i + 6) != 58 {
        return false;
    }
    let fc: Int = byte_at(s, i + 7);
    if fc != 32 && fc != 9 {
        return false;
    }
    return true;
}

// Append file toks, drop the per-file EOF row.
pub fn c_toks_append_file(dst: List[String], src: List[String]) -> List[String] {
    let n: Int = list_len(src);
    let mut out: List[String] = dst;
    let mut i: Int = 0;
    while i < n {
        let row: String = list_get(src, i);
        if field_at(row, 0) != "EOF" {
            out = list_push(out, row);
        }
        i = i + 1;
    }
    return out;
}

pub fn c_toks_append_eof(dst: List[String]) -> List[String] {
    return list_push(dst, tok_line("EOF", 1, 1, ""));
}

pub fn c_emit_builtin(name: String, args: String) -> String {
    if name == "str_split" { return "str_split(" + args + ")"; }
    if name == "str_trim" { return "str_trim(" + args + ")"; }
    if name == "fs_read_dir" { return "fs_read_dir(" + args + ")"; }
    if name == "fs_remove_file" { return "oo_fs_remove_file(" + args + ")"; }
    if name == "fs_rmdir" { return "oo_fs_rmdir(" + args + ")"; }
    if name == "fs_mkdir" { return "oo_fs_mkdir(" + args + ")"; }
    if name == "fs_is_dir" { return "fs_is_dir(" + args + ")"; }
    if name == "sys_args" { return "sys_args(" + args + ")"; }
    return "";
}

pub fn c_emit_src_line(toks: List[String], pos: Int, env: String) {
    if pos < 0 {
        return;
    }
    let fl: String = field_at(list_get(toks, pos), 1);
    let fp: String = c_env_get(env, "__file__");
    if fl == "" {
        return;
    }
    if fp == "" {
        return;
    }
    println("#line " + fl + " \"" + fp + "\"");
}
