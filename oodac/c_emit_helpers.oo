// # Emit a C block
//
// Logline: Walk a brace block and return the new pos and env.
//
// Setup: Token list and emission environment are positioned at the start of a block.
//
// Beats:
//   1. Enter the block.
//   2. Lower statements inside.
//   3. Return [new_pos, env].

pub fn c_emit_block(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    e = c_env_push_scope(e);
    oo_emit_tmp_enter();
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            e = c_emit_scope_exit(e);
            oo_emit_tmp_leave();
            p = p + 1;
            break;
        }
        let st: List[String] = c_emit_stmt(toks, p, n, e);
        p = parse_int(list_get(st, 0));
        e = list_get(st, 1);
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, e);
    return out;
}

// M-CTZ-1: return the text of the 1-indexed line in src (without trailing \n).
pub fn c_line_text_at(src: String, line_num: Int) -> String {
    let slen: Int = chars_len(src);
    let mut cur_line: Int = 1;
    let mut i: Int = 0;
    if line_num <= 0 {
        return "";
    }
    if line_num == 1 {
        let mut j: Int = 0;
        while j < slen && char_at(src, j) != "\n" {
            j = j + 1;
        }
        return str_slice(src, 0, j);
    }
    while i < slen {
        if char_at(src, i) == "\n" {
            cur_line = cur_line + 1;
            if cur_line == line_num {
                let start: Int = i + 1;
                let mut j: Int = start;
                while j < slen && char_at(src, j) != "\n" {
                    j = j + 1;
                }
                return str_slice(src, start, j);
            }
        }
        i = i + 1;
    }
    return "";
}

// True iff the (trimmed) line carries a `// SECRET:` directive.
// Used by the __fr_secret__<fn> pre-pass.
pub fn c_is_secret_directive_line(s: String) -> Bool {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    if i + 1 >= n {
        return false;
    }
    if char_at(s, i) != "/" || char_at(s, i + 1) != "/" {
        return false;
    }
    i = i + 2;
    while i < n {
        let c2: String = char_at(s, i);
        if c2 == " " || c2 == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    let rest: String = str_slice(s, i, n);
    let rn: Int = chars_len(rest);
    if rn < 8 {
        return false;
    }
    if char_at(rest, 0) != "S" || char_at(rest, 1) != "E" || char_at(rest, 2) != "C"
        || char_at(rest, 3) != "R" || char_at(rest, 4) != "E" || char_at(rest, 5) != "T"
        || char_at(rest, 6) != ":" {
        return false;
    }
    if rn == 7 {
        return false;
    }
    let fc: String = char_at(rest, 7);
    if fc != " " && fc != "\t" {
        return false;
    }
    return true;
}

pub fn c_emit_builtin(name: String, args: String) -> String {
    if name == "str_split" { return "str_split(" + args + ")"; }
    if name == "str_trim" { return "str_trim(" + args + ")"; }
    if name == "fs_read_dir" { return "fs_read_dir(" + args + ")"; }
    if name == "fs_remove_file" { return "oo_fs_remove_file(" + args + ")"; }
    if name == "fs_rmdir" { return "oo_fs_rmdir(" + args + ")"; }
    if name == "fs_mkdir" { return "oo_fs_mkdir(" + args + ")"; }
    if name == "fs_is_dir" { return "fs_is_dir(" + args + ")"; }
    if name == "sys_args" { return "sys_args(" + args + ")"; }
    return "";
}
