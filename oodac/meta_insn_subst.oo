// # Metamorphic Instruction Substitution Engine
//
// Logline: Applies semantic-preserving algebraic transformations and opcode substitutions across machine instruction streams.
//
// Setup: Standalone compiler pass for instruction mutation and layout diversity.
//
// Beats:
//   1. Define packed MetaInsn format (opcode \t dst \t src \t imm).
//   2. Substitute register zeroing idioms (mov $0, reg <-> xor reg, reg <-> sub reg, reg).
//   3. Apply arithmetic offset substitutions (add $k, reg <-> sub $-k, reg <-> lea k(reg), reg).
// RULES.oot 1.7: Under 256 lines.

import "token_fmt.oo";

pub fn meta_insn_subst_pack(op: String, dst: String, src: String, imm: Int) -> String {
    return op + "\t" + dst + "\t" + src + "\t" + imm.to_string();
}

pub fn meta_insn_subst_op(insn: String) -> String { return field_at(insn, 0); }
pub fn meta_insn_subst_dst(insn: String) -> String { return field_at(insn, 1); }
pub fn meta_insn_subst_src(insn: String) -> String { return field_at(insn, 2); }
pub fn meta_insn_subst_imm(insn: String) -> Int { return parse_int(field_at(insn, 3)); }

pub fn meta_insn_subst_zeroing(stream: List[String], seed: Int) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(stream);
    let mut i: Int = 0;

    while i < n {
        let insn: String = list_get(stream, i);
        let op: String = meta_insn_subst_op(insn);
        let imm: Int = meta_insn_subst_imm(insn);
        let dst: String = meta_insn_subst_dst(insn);

        if op == "mov" && imm == 0 {
            let choice: Int = (seed + i) % 2;
            let mut new_op: String = "xor";
            if choice == 1 { new_op = "sub"; }
            let sub_insn: String = meta_insn_subst_pack(new_op, dst, dst, 0);
            out = list_push(out, sub_insn);
        } else {
            out = list_push(out, insn);
        }
        i = i + 1;
    }
    return out;
}

pub fn meta_insn_subst_arith(stream: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(stream);
    let mut i: Int = 0;

    while i < n {
        let insn: String = list_get(stream, i);
        let op: String = meta_insn_subst_op(insn);
        let imm: Int = meta_insn_subst_imm(insn);
        let dst: String = meta_insn_subst_dst(insn);

        if op == "add" && imm == 1 {
            let inc_insn: String = meta_insn_subst_pack("inc", dst, "", 0);
            out = list_push(out, inc_insn);
        } else if op == "cmp" && imm == 0 {
            let test_insn: String = meta_insn_subst_pack("test", dst, dst, 0);
            out = list_push(out, test_insn);
        } else {
            out = list_push(out, insn);
        }
        i = i + 1;
    }
    return out;
}
