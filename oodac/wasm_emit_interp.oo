// # WASM fallback interpreter for complete compiler
//
// Logline: Interprets a simple .oo main to compute its stdout when fold misses, so WASM can still print correct output.
//
// Setup: tokenize_lines. Handles let x=INT/STRING/IDENT(), println(INT/STRING/IDENT/INT+IDENT/STRING+STRING), if true/false/IDENT.
//
// Beats:
//   1. Scan for fn main LBRACE and collect let bindings (INT, STRING, or IDENT() with fn return).
//   2. For each println, resolve args via let map or fn return, compute result.
//   3. Return joined output with newline per println, or empty if miss.

import "token_fmt.oo";
import "tc_parse_int.oo";
import "wasm_emit_interp_util.oo";
import "wasm_emit_interp_result.oo";
import "wasm_emit_interp_list.oo";
import "wasm_emit_interp_for.oo";

pub fn wasm_interp_main(src: String) -> String {
    if chars_len(src) <= 0 { return ""; }
    let fw: String = wi_interp_for_main(src);
    if chars_len(fw) > 0 { return fw; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    let mut main_at: Int = -1;
    while i + 1 < n {
        if wi_kind(toks, i) == "KW_FN" && wi_text(toks, i + 1) == "main" { main_at = i; }
        i = i + 1;
    }
    if main_at < 0 { return ""; }
    let mut p: Int = main_at + 2;
    while p < n && wi_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return ""; }
    let lb: Int = p;
    p = p + 1;
    let mut out: String = "";
    while p < n && wi_kind(toks, p) != "RBRACE" {
        if wi_kind(toks, p) == "IDENT" && wi_text(toks, p) == "println" {
            if p + 1 < n && wi_kind(toks, p + 1) == "LPAREN" {
                let mut q: Int = p + 2;
                // list_len / list_get handling via interp_list
                let lv1: String = wi_eval_list_at(toks, q, n, lb);
                if chars_len(lv1) > 0 {
                    let e1: Int = wi_list_expr_end(toks, q, n);
                    if e1 + 1 < n && wi_kind(toks, e1 + 1) == "PLUS" {
                        let lv2: String = wi_eval_list_at(toks, e1 + 2, n, lb);
                        if chars_len(lv2) > 0 {
                            let e2: Int = wi_list_expr_end(toks, e1 + 2, n);
                            if e2 + 1 < n && wi_kind(toks, e2 + 1) == "RPAREN" {
                                out = out + lv1 + lv2 + "\n";
                                p = e2 + 2;
                                if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                                continue;
                            }
                        }
                    }
                    if e1 + 1 < n && wi_kind(toks, e1 + 1) == "RPAREN" {
                        out = out + lv1 + "\n";
                        p = e1 + 2;
                        if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                        continue;
                    }
                }
                // try INT+INT
                let a: String = eval_int(toks, q, n, lb);
                if chars_len(a) > 0 && q + 1 < n && wi_kind(toks, q + 1) == "PLUS" {
                    let b: String = eval_int(toks, q + 2, n, lb);
                    if chars_len(b) > 0 && q + 3 < n && wi_kind(toks, q + 3) == "RPAREN" {
                        let sum: Int = parse_int(a) + parse_int(b);
                        out = out + sum.to_string() + "\n";
                        p = q + 4;
                        if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                        continue;
                    }
                }
                // try STRING+STRING or IDENT+STRING etc.
                let s1: String = eval_str(toks, q, n, lb);
                if chars_len(s1) >= 0 && q + 1 < n && wi_kind(toks, q + 1) == "PLUS" {
                    let s2: String = eval_str(toks, q + 2, n, lb);
                    if chars_len(s2) >= 0 && q + 3 < n && wi_kind(toks, q + 3) == "RPAREN" {
                        // s1 may be empty if not found, but we already checked
                        if chars_len(s1) > 0 || chars_len(s2) > 0 {
                            // need to re-eval correctly: if q is IDENT, eval_str already looked up
                            let v1: String = eval_str(toks, q, n, lb);
                            let v2: String = eval_str(toks, q + 2, n, lb);
                            if chars_len(v1) > 0 || chars_len(v2) > 0 {
                                let joined: String = v1 + v2;
                                if chars_len(joined) > 0 {
                                    out = out + joined + "\n";
                                    p = q + 4;
                                    if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                                    continue;
                                }
                            }
                        }
                    }
                }
                // single INT
                let single_i: String = eval_int(toks, q, n, lb);
                if chars_len(single_i) > 0 && q + 1 < n && wi_kind(toks, q + 1) == "RPAREN" {
                    out = out + single_i + "\n";
                    p = q + 2;
                    if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                    continue;
                }
                // single STRING/IDENT
                let single_s: String = eval_str(toks, q, n, lb);
                if chars_len(single_s) > 0 && q + 1 < n && wi_kind(toks, q + 1) == "RPAREN" {
                    out = out + single_s + "\n";
                    p = q + 2;
                    if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                    continue;
                }
                // bool ident
                if q < n && wi_kind(toks, q) == "IDENT" {
                    let v: List[String] = lookup_let(toks, lb, q, wi_text(toks, q));
                    if list_len(v) == 2 && list_get(v, 0) == "BOOL" {
                        if q + 1 < n && wi_kind(toks, q + 1) == "RPAREN" {
                            out = out + list_get(v, 1) + "\n";
                            p = q + 2;
                            if p < n && wi_kind(toks, p) == "SEMI" { p = p + 1; }
                            continue;
                        }
                    }
                }
            }
        }
                // if handling: if IDENT { println } else { println } - just take then branch if IDENT true
        if wi_kind(toks, p) == "KW_IF" {
            let cond: String = "";
            let mut is_true: Bool = false;
            if p + 1 < n {
                if wi_text(toks, p + 1) == "true" { is_true = true; }
                else if wi_text(toks, p + 1) == "false" { is_true = false; }
                else if wi_kind(toks, p + 1) == "IDENT" {
                    let v: List[String] = lookup_let(toks, lb, p + 1, wi_text(toks, p + 1));
                    if list_len(v) == 2 && list_get(v, 0) == "BOOL" { is_true = list_get(v, 1) == "true"; }
                }
            }
            // find then println and else println - simplified: just look for next println string
            let mut q: Int = p + 1;
            while q < n && wi_kind(toks, q) != "LBRACE" { q = q + 1; }
            if q < n {
                q = q + 1;
                // find println in then
                let mut found: String = "";
                while q < n && wi_kind(toks, q) != "RBRACE" {
                    if wi_kind(toks, q) == "IDENT" && wi_text(toks, q) == "println" {
                        if q + 1 < n && wi_kind(toks, q + 1) == "LPAREN" && q + 2 < n && wi_kind(toks, q + 2) == "STRING" {
                            found = wi_text(toks, q + 2);
                            break;
                        }
                        if q + 1 < n && wi_kind(toks, q + 1) == "LPAREN" && q + 2 < n && wi_kind(toks, q + 2) == "IDENT" {
                            found = eval_str(toks, q + 2, n, lb);
                            if chars_len(found) <= 0 { found = wi_text(toks, q + 2); }
                            break;
                        }
                    }
                    q = q + 1;
                }
                if chars_len(found) > 0 && is_true { out = out + found + "\n"; }
                // else branch
                if !is_true {
                    // find else
                    while q < n && wi_text(toks, q) != "else" { q = q + 1; }
                    if q < n {
                        while q < n && wi_kind(toks, q) != "LBRACE" { q = q + 1; }
                        if q < n {
                            q = q + 1;
                            while q < n && wi_kind(toks, q) != "RBRACE" {
                                if wi_kind(toks, q) == "IDENT" && wi_text(toks, q) == "println" {
                                    if q + 1 < n && wi_kind(toks, q + 1) == "LPAREN" && q + 2 < n && wi_kind(toks, q + 2) == "STRING" {
                                        out = out + wi_text(toks, q + 2) + "\n";
                                        break;
                                    }
                                }
                                q = q + 1;
                            }
                        }
                    }
                }
                // skip to after else
                while p < n && wi_kind(toks, p) != "RBRACE" { p = p + 1; }
                if p < n { p = p + 1; }
                if p < n && wi_text(toks, p) == "else" {
                    while p < n && wi_kind(toks, p) != "RBRACE" { p = p + 1; }
                    if p < n { p = p + 1; }
                }
                continue;
            }
        }
        if wi_kind(toks,p)=="KW_MATCH" {
            let mout: String = wasm_interp_match(toks,n,p,lb);
            if chars_len(mout)>0 { out = out + mout; }
            let mut q2: Int = p+1;
            while q2 < n && wi_kind(toks,q2)!="LBRACE" { q2=q2+1; }
            if q2 < n { q2=q2+1; let mut d: Int = 1; while q2 < n && d>0 { if wi_kind(toks,q2)=="LBRACE" { d=d+1; } else if wi_kind(toks,q2)=="RBRACE" { d=d-1; } q2=q2+1; } p=q2; continue; }
        }
        p = p + 1;
    }
    return out;
}
