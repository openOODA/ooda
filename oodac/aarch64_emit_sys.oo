// # Write Linux AArch64 write-and-exit assembly
//
// Logline: Prints GAS _start/main that SVC write each rodata string then SVC exit 0.
//
// Setup: println exists. msgs are the exact bytes to print, without the added newline.
//
// Beats:
//   1. Escape each string by byte for .ascii and emit .rodata labels.
//   2. Emit main and _start that write each string plus a newline.
//   3. Use bytes_len plus one for SYS_write; exit with syscall 93.
//
// residual: libc, AAPCS calls, and qemu run stay later. Assemble with clang -target aarch64-linux-gnu.

fn a64_oct3(b: Int) -> String {
    let d0 = b / 64;
    let d1 = (b / 8) % 8;
    let d2 = b % 8;
    return "\\" + d0.to_string() + d1.to_string() + d2.to_string();
}

pub fn aarch64_ascii_esc(s: String) -> String {
    let n = bytes_len(s);
    let mut o = "";
    let mut i = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            o = o + "\\\\";
        } else if b == 34 {
            o = o + "\\\"";
        } else if b == 10 {
            o = o + "\\n";
        } else if b == 9 {
            o = o + "\\t";
        } else if b >= 32 && b <= 126 {
            o = o + byte_slice(s, i, i + 1);
        } else {
            o = o + a64_oct3(b);
        }
        i = i + 1;
    }
    return o;
}

fn a64_emit_write_len(ln: Int) {
    if ln < 0 {
        println("ERR\taarch64_emit\tnegative write length");
        process_exit(1);
    }
    if ln <= 65535 {
        println("    mov x2, #" + ln.to_string());
        return;
    }
    let lo = ln % 65536;
    let hi = ln / 65536;
    println("    movz x2, #" + lo.to_string());
    println("    movk x2, #" + hi.to_string() + ", lsl #16");
}

pub fn aarch64_emit_linux(msgs: List[String]) {
    println("# openOODA aarch64 floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata");
    println("    .p2align 3");
    let n = list_len(msgs);
    let mut i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        println(".Lstr" + i.to_string() + ":");
        println("    .ascii \"" + aarch64_ascii_esc(s) + "\\n\"");
        i = i + 1;
    }
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 2");
    println("main:");
    println("_start:");
    i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        let ln = bytes_len(s) + 1;
        let tag: String = i.to_string();
        println("    mov x8, #64");
        println("    mov x0, #1");
        println("    adrp x1, .Lstr" + tag);
        println("    add x1, x1, :lo12:.Lstr" + tag);
        a64_emit_write_len(ln);
        println("    svc #0");
        i = i + 1;
    }
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
