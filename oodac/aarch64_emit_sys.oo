// # Write Linux AArch64 write-and-exit assembly
//
// Logline: Prints GAS _start/main that SVC write each rodata string then SVC exit 0.
//
// Setup: println exists. msgs are the exact bytes to print, without the added newline.
//
// Beats:
//   1. Escape each string for .ascii and emit .rodata labels.
//   2. Emit main and _start that write each string plus a newline.
//   3. Exit with AArch64 Linux syscall 93.
//
// residual: libc, AAPCS calls, and qemu run stay later. Assemble with clang -target aarch64-linux-gnu.

pub fn aarch64_ascii_esc(s: String) -> String {
    let n = chars_len(s);
    let mut o = "";
    let mut i = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            o = o + "\\\\";
        } else if c == "\"" {
            o = o + "\\\"";
        } else if c == "\n" {
            o = o + "\\n";
        } else if c == "\t" {
            o = o + "\\t";
        } else {
            o = o + c;
        }
        i = i + 1;
    }
    return o;
}

pub fn aarch64_emit_linux(msgs: List[String]) {
    println("# openOODA aarch64 floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata");
    println("    .p2align 3");
    let n = list_len(msgs);
    let mut i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        println(".Lstr" + i.to_string() + ":");
        println("    .ascii \"" + aarch64_ascii_esc(s) + "\\n\"");
        i = i + 1;
    }
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 2");
    println("main:");
    println("_start:");
    i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        let ln = chars_len(s) + 1;
        let tag: String = i.to_string();
        println("    mov x8, #64");
        println("    mov x0, #1");
        println("    adrp x1, .Lstr" + tag);
        println("    add x1, x1, :lo12:.Lstr" + tag);
        println("    mov x2, #" + ln.to_string());
        println("    svc #0");
        i = i + 1;
    }
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
