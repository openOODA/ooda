// job: if/while condition literal types; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_if_while_lit_cond(toks: List[String]) {
    let n = list_len(toks);
    let lit_env = build_pure_lit_env(toks);
    let struct_table = build_struct_field_table(toks);
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        let mut is_cond = false;
        if k == "KW_WHILE" {
            let mut lbrace1 = i + 1;
            while lbrace1 < n {
                if field_at(list_get(toks, lbrace1), 0) == "LBRACE" {
                    break;
                }
                lbrace1 = lbrace1 + 1;
            }
            if lbrace1 < n {
                let mut rbrace1 = skip_balanced(toks, lbrace1);
                if rbrace1 > 0 {
                    rbrace1 = rbrace1 - 1;
                    let ty1 = infer_typed_expr_type_exact(toks, lbrace1 + 1, rbrace1, lit_env);
                    if ty1 != "" {
                        let line = field_at(list_get(toks, i), 1);
                        let col = field_at(list_get(toks, i), 2);
                        println("ERR\ttype\tType error at " + line + ":" + col + ": while loop body must return Void, found " + ty1);
                        process_exit(1);
                    }
                }
            }
        }

        if k == "KW_IF" {
            is_cond = true;
        } else if k == "KW_WHILE" {
            is_cond = true;
        }
        if is_cond {
            if i + 2 < n {
                // Full expression condition up to LBRACE (if pure/resolvable).
                let mut end_idx = i + 1;
                let mut search_cont = true;
                while search_cont {
                    if end_idx >= n {
                        search_cont = false;
                    } else {
                        if field_at(list_get(toks, end_idx), 0) == "LBRACE" {
                            search_cont = false;
                        } else {
                            end_idx = end_idx + 1;
                        }
                    }
                }
                if end_idx < n {
                    let cty = infer_typed_expr_type_exact(toks, i + 1, end_idx, lit_env);
                    if cty != "" {
                        if cty != "Bool" {
                            let line = field_at(list_get(toks, i), 1);
                            let col = field_at(list_get(toks, i), 2);
                            let mut w = "if";
                            if k == "KW_WHILE" {
                                w = "while";
                            }
                            println(
                                "ERR\ttype\tType error at "
                                    + line
                                    + ":"
                                    + col
                                    + ": '"
                                    + w
                                    + "' condition must be Bool, found "
                                    + cty
                            );
                            process_exit(1);
                        }
                    }
                }
                // Field-chain condition: `if o.inner.v {` must be Bool.
                // Binop form: `if o.inner.v == false {` / `!= true` — chain before
                // EQEQ/NEQ; resolve field_chain_type, combine, require Bool.
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    let end = field_chain_end(toks, i + 1);
                    if end > 0 {
                        if end < n {
                            let ek = field_at(list_get(toks, end), 0);
                            let mut cond_ty = "";
                            if ek == "LBRACE" {
                                cond_ty = field_chain_type(
                                    toks,
                                    i + 1,
                                    end,
                                    lit_env,
                                    struct_table
                                );
                            } else if ek == "EQEQ" || ek == "NEQ" {
                                // Chain appears before EQEQ/NEQ in this condition.
                                let fty = field_chain_type(
                                    toks,
                                    i + 1,
                                    end,
                                    lit_env,
                                    struct_table
                                );
                                if fty != "" {
                                    let mut rty = atom_type_with_env(
                                        toks,
                                        end + 1,
                                        lit_env
                                    );
                                    if rty == "" {
                                        rty = field_access_type_at(
                                            toks,
                                            end + 1,
                                            lit_env,
                                            struct_table
                                        );
                                    }
                                    if rty != "" {
                                        let comb = combine_binop_types(
                                            ek,
                                            fty,
                                            rty
                                        );
                                        if comb == "ERR_BINOP" {
                                            // Fail-closed: mismatched compare in cond.
                                            let line = field_at(
                                                list_get(toks, i),
                                                1
                                            );
                                            let col = field_at(
                                                list_get(toks, i),
                                                2
                                            );
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": incompatible operand types for binary operator"
                                            );
                                            process_exit(1);
                                        } else {
                                            cond_ty = comb;
                                        }
                                    }
                                }
                            }
                            if cond_ty != "" {
                                if cond_ty != "Bool" {
                                    let line = field_at(list_get(toks, i), 1);
                                    let col = field_at(list_get(toks, i), 2);
                                    let mut w = "if";
                                    if k == "KW_WHILE" {
                                        w = "while";
                                    }
                                    println(
                                        "ERR\ttype\tType error at "
                                            + line
                                            + ":"
                                            + col
                                            + ": '"
                                            + w
                                            + "' condition must be Bool, found "
                                            + cond_ty
                                    );
                                    process_exit(1);
                                }
                            }
                        }
                    }
                }
                // Zero-arg call condition: `if g() {` / `while g() {`
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    if field_at(list_get(toks, i + 2), 0) == "LPAREN" {
                        if i + 4 < n {
                            if field_at(list_get(toks, i + 3), 0) == "RPAREN" {
                                if field_at(list_get(toks, i + 4), 0) == "LBRACE" {
                                    let cname = field_at(list_get(toks, i + 1), 3);
                                    let ret_table = build_fn_ret_table(toks);
                                    let got = resolve_type_alias(ret_table, cname);
                                    if got != cname {
                                        if got != "Bool" {
                                            let line = field_at(list_get(toks, i), 1);
                                            let col = field_at(list_get(toks, i), 2);
                                            let mut w = "if";
                                            if k == "KW_WHILE" {
                                                w = "while";
                                            }
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": '"
                                                    + w
                                                    + "' condition must be Bool, found "
                                                    + got
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Infer type of a pure literal expression chain starting at pos0.
// Returns "" if non-pure (vars/calls), "ERR_BINOP" if known-bad mix,
// or Int/String/Bool/Float for successful pure chains.
