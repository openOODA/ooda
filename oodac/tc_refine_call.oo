// # Check a refined call argument
//
// Logline: When a one-INT call matches a fn whose first param is Int[lo..hi], reject an argument outside that range.
//
// Setup: parse_int, field_at, list_get, list_len, and tc_err_at exist; typecheck_refinements calls this on IDENT.
//
// Beats:
//   1. Match IDENT LPAREN INT RPAREN and parse the argument.
//   2. Scan for KW_FN with the same name and a first param Int[lo..hi].
//   3. If the argument is outside [p_min, p_max], tc_err_at RefinementTypeViolation.

pub fn refine_check_call_arg(toks: List[String], i: Int) {
    let n = list_len(toks);
    if i + 3 < n {
        if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
            if field_at(list_get(toks, i + 2), 0) == "INT" {
                if field_at(list_get(toks, i + 3), 0) == "RPAREN" {
                    let call_name: String = field_at(list_get(toks, i), 3);
                    let arg_val = 0 + parse_int(field_at(list_get(toks, i + 2), 3));
                    let mut scan = 0;
                    while scan < n {
                        if field_at(list_get(toks, scan), 0) == "KW_FN" {
                            if scan + 11 < n {
                                if field_at(list_get(toks, scan + 1), 3) == call_name {
                                    if field_at(list_get(toks, scan + 2), 0) == "LPAREN" {
                                        if field_at(list_get(toks, scan + 4), 0) == "COLON" {
                                            if field_at(list_get(toks, scan + 5), 3) == "Int" {
                                                if field_at(list_get(toks, scan + 6), 0) == "LBRACKET" {
                                                    if field_at(list_get(toks, scan + 7), 0) == "INT" {
                                                        if field_at(list_get(toks, scan + 8), 0) == "DOTDOT" {
                                                            if field_at(list_get(toks, scan + 9), 0) == "INT" {
                                                                if field_at(list_get(toks, scan + 10), 0) == "RBRACKET" {
                                                                    let p_min = 0 + parse_int(field_at(list_get(toks, scan + 7), 3));
                                                                    let p_max = 0 + parse_int(field_at(list_get(toks, scan + 9), 3));
                                                                    if arg_val < p_min || arg_val > p_max {
                                                                        tc_err_at(toks, i + 2, "RefinementTypeViolation");
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        scan = scan + 1;
                    }
                }
            }
        }
    }
}
