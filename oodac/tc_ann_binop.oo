// # Fail closed on a typed binary operator
//
// Logline: When both operands have types, reject divide or modulo by literal zero and reject an operator that cannot combine those types.
//
// Setup: operand_type_with_env, operand_end, is_type_binop, combine_binop_types, field_at, println, and process_exit exist; lit_env is the literal/name type table.
//
// Beats:
//   1. Read the left type at i; if empty, return.
//   2. At the operator, if it is SLASH or PERCENT and the right token is INT or FLOAT 0 or 0.0, print a type error and exit.
//   3. combine_binop_types that yields ERR_BINOP prints incompatible operand types and exits.

pub fn ann_check_binop(toks: List[String], i: Int, n: Int, lit_env: String, line: String, col: String) {
            let lty: String = operand_type_with_env(toks, i, lit_env);
            if lty != "" {
                let lend: Int = 0 + operand_end(toks, i);
                if lend < n {
                    let opk: String = field_at(list_get(toks, lend), 0);
                    if is_type_binop(opk) {
                        if lend + 1 < n {
                            let rpos: Int = lend + 1;
                            let rtok: String = list_get(toks, rpos);
                            let rty: String = operand_type_with_env(toks, rpos, lit_env);
                            if rty != "" {
                                if opk == "SLASH" {
                                    let rk: String = field_at(rtok, 0);
                                    if rk == "INT" || rk == "FLOAT" {
                                        if field_at(rtok, 3) == "0" {
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": integer division by zero"
                                            );
                                            process_exit(1);
                                        }
                                        if field_at(rtok, 3) == "0.0" {
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": float division by zero"
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                                if opk == "PERCENT" {
                                    let rk: String = field_at(rtok, 0);
                                    if rk == "INT" || rk == "FLOAT" {
                                        if field_at(rtok, 3) == "0" {
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": integer modulo by zero"
                                            );
                                            process_exit(1);
                                        }
                                        if field_at(rtok, 3) == "0.0" {
                                            println(
                                                "ERR\ttype\tType error at "
                                                    + line
                                                    + ":"
                                                    + col
                                                    + ": float modulo by zero"
                                            );
                                            process_exit(1);
                                        }
                                    }
                                }
                                let comb: String = combine_binop_types(opk, lty, rty);
                                if comb == "ERR_BINOP" {
                                    println(
                                        "ERR\ttype\tType error at "
                                            + line
                                            + ":"
                                            + col
                                            + ": incompatible operand types for binary operator"
                                    );
                                    process_exit(1);
                                }
                            }
                        }
                    }
                }
            }
        }
