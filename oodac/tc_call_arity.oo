// # Check call arity
//
// Logline: Build a name-to-arity table from fn headers and refuse a call whose argument count does not match.
//
// Setup: Tokenized source items and function headers are loaded for arity table construction.
//
// Beats:
//   1. Seed CHS builtin arities so list_get and list_push cannot silent-OK.
//   2. Pass 1 counts IDENT: params on each KW_FN header and appends fname=argc.
//   3. Pass 2 counts args on IDENT( that is not a method or def and exits on a mismatch.

pub fn arity_get(table: String, fname: String) -> Int {
    // return -1 if missing
    let mut i = 0;
    let n = chars_len(table);
    let key = "\t" + fname + "=";
    // linear scan for key
    let kn = chars_len(key);
    while i + kn <= n {
        let mut matchk = true;
        let mut j = 0;
        while j < kn {
            if char_at(table, i + j) != char_at(key, j) {
                matchk = false;
                j = kn;
            } else {
                j = j + 1;
            }
        }
        if matchk {
            let mut p = i + kn;
            let mut num = 0;
            let mut cont = true;
            while cont {
                if p >= n {
                    cont = false;
                } else {
                    let c = char_at(table, p);
                    if char_is_digit(c) {
                        // digit value
                        if c == "0" { num = num * 10 + 0; }
                        if c == "1" { num = num * 10 + 1; }
                        if c == "2" { num = num * 10 + 2; }
                        if c == "3" { num = num * 10 + 3; }
                        if c == "4" { num = num * 10 + 4; }
                        if c == "5" { num = num * 10 + 5; }
                        if c == "6" { num = num * 10 + 6; }
                        if c == "7" { num = num * 10 + 7; }
                        if c == "8" { num = num * 10 + 8; }
                        if c == "9" { num = num * 10 + 9; }
                        p = p + 1;
                    } else {
                        cont = false;
                    }
                }
            }
            return num;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn typecheck_call_arity(toks: List[String]) {
    let n = list_len(toks);
    // Seed CHS builtins so list_get(xs) / list_push arity cannot silent-OK.
    let mut table = "\tlist_new=0\tlist_push=2\tlist_get=2\tlist_len=1\t"
        + "index_get=2\t"
        + "list_new_int=0\tlist_push_int=2\tlist_get_int=2\t"
        + "chars_len=1\tchar_at=2\tstr_slice=3\t"
        + "char_is_digit=1\tchar_is_alpha=1\tchar_is_space=1\t"
        + "byte_at=2\tord=1\tbit_xor=2\tbytes_len=1\tbyte_slice=3\tbytes_eq=2\t"
        + "bytes_from_str=1\tbytes_concat=2\t"
        + "bytes_new=0\tbytes_push=2\tbytes_get=2\tbytes_to_str=1\t"
        + "str_starts_with=2\tstr_ends_with=2\tstr_index_of=2\t"
        + "str_repeat=2\tstr_to_uppercase=1\t"
        + "sin=1\tcos=1\tln=1\texp=1\tsqrt=1\tpow=2\t"
        + "alloc_bytes=2\tfree_bytes=2\tmalloc=2\tfree=2\trealloc=3\t"
        + "println=1\tprocess_exit=1\tto_string=1\tmeta_epoch=0\tmeta_mix=1\tmeta_is_path_a=0\tmeta_decoy_touch=0\tenv_get=2\t";
    // Pass 1: fn name → param count
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                    let fname: String = field_at(list_get(toks, i + 1), 3);
                    let mut p = i + 2;
                    // skip to LPAREN
                    let mut cont = true;
                    while cont {
                        if p >= n {
                            cont = false;
                        } else {
                            if field_at(list_get(toks, p), 0) == "LPAREN" {
                                cont = false;
                            } else {
                                p = p + 1;
                            }
                        }
                    }
                    // count params: IDENTs that precede COLON at depth 1
                    let mut argc = 0;
                    let mut depth = 0;
                    let mut cont2 = true;
                    while cont2 {
                        if p >= n {
                            cont2 = false;
                        } else {
                            let kk: String = field_at(list_get(toks, p), 0);
                            if kk == "LPAREN" {
                                depth = depth + 1;
                            }
                            if kk == "RPAREN" {
                                depth = depth - 1;
                                if depth == 0 {
                                    cont2 = false;
                                }
                            }
                            if depth == 1 {
                                if kk == "IDENT" {
                                    if p + 1 < n {
                                        if field_at(list_get(toks, p + 1), 0) == "COLON" {
                                            argc = argc + 1;
                                        }
                                    }
                                }
                            }
                            p = p + 1;
                        }
                    }
                    let argc_s: String = argc.to_string();
                    table = table + fname + "=" + argc_s + "\t";
                }
            }
        }
        i = i + 1;
    }
    // Pass 2: calls
    i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                    // not after DOT (method)
                    let mut is_method = false;
                    if i > 0 {
                        if field_at(list_get(toks, i - 1), 0) == "DOT" {
                            is_method = true;
                        }
                    }
                    // not fn definition name
                    let mut is_def = false;
                    if i > 0 {
                        if field_at(list_get(toks, i - 1), 0) == "KW_FN" {
                            is_def = true;
                        }
                    }
                    if !is_method {
                        if !is_def {
                            let fname: String = field_at(list_get(toks, i), 3);
                            let line: String = field_at(list_get(toks, i), 1);
                            let col: String = field_at(list_get(toks, i), 2);
                            let expect = 0 + arity_get(table, fname);
                            if expect >= 0 {
                                // count args
                                let mut p = i + 1;
                                let mut depth = 0;
                                let mut argc = 0;
                                let mut saw_arg = false;
                                let mut cont = true;
                                while cont {
                                    if p >= n {
                                        cont = false;
                                    } else {
                                        let kk: String = field_at(list_get(toks, p), 0);
                                        if kk == "LPAREN" {
                                            depth = depth + 1;
                                            if depth == 1 {
                                                saw_arg = false;
                                            }
                                        } else if kk == "RPAREN" {
                                            if depth == 1 {
                                                if saw_arg {
                                                    argc = argc + 1;
                                                }
                                                cont = false;
                                            }
                                            depth = depth - 1;
                                        } else if kk == "COMMA" {
                                            if depth == 1 {
                                                argc = argc + 1;
                                                saw_arg = false;
                                            }
                                        } else {
                                            if depth == 1 {
                                                if kk != "LPAREN" {
                                                    saw_arg = true;
                                                }
                                            }
                                        }
                                        p = p + 1;
                                    }
                                }
                                if fname == "println" {
                                    if argc < 1 {
                                        println("ERR\ttype\tType error at " + line + ":" + col + ": function 'println' expects at least 1 argument");
                                        process_exit(1);
                                    }
                                } else if argc != expect {
                                    let exp_s: String = expect.to_string();
                                    let got_s: String = argc.to_string();
                                    println(
                                        "ERR\ttype\tType error at "
                                            + line
                                            + ":"
                                            + col
                                            + ": function '"
                                            + fname
                                            + "' expects "
                                            + exp_s
                                            + " argument(s) but got "
                                            + got_s
                                    );
                                    process_exit(1);
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Fail assign to non-mut let: `let x = 1; x = 2;`
