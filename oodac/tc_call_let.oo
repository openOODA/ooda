// # Typecheck let from a call
//
// Logline: Annotate a let from a call init using the return table of every loaded module.
//
// Setup: ret_table comes from the load_import expanded stream. call_ret_type_at handles any arity.
//
// Beats:
//   1. Walk annotated and unannotated lets whose init is a call.
//   2. Hit cap_builtin_ret first; else look up the callee return type.
//   3. Fail closed on a type miss when an annotation is present.
//
// residual: ret_table built on first non-cap miss, not at entry

import "lex.oo";
import "token_fmt.oo";
import "tc_tables_ret.oo";

pub fn typecheck_let_ann_call_init(toks: List[String]) {
    let n = list_len(toks);
    let mut ret_table: String = "";
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname: String = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let mut i = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_LET" {
            let mut p = i + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let vname: String = field_at(list_get(toks, p), 3);
                    let vline: String = field_at(list_get(toks, p), 1);
                    let vcol: String = field_at(list_get(toks, p), 2);
                    p = p + 1;
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "COLON" {
                            p = p + 1;
                            if p < n {
                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                    let mut ann: String = resolve_type_alias(aliases, field_at(list_get(toks, p), 3));
                                    p = p + 1;
                                    if p < n {
                                        ann = tc_read_result_ann(ann, toks, p);
                                        p = tc_skip_brackets(toks, p);
                                    }
                                    if p < n {
                                        if field_at(list_get(toks, p), 0) == "EQ" {
                                            p = p + 1;
                                            if p < n {
                                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                                    if p + 1 < n {
                                                        if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                                            let mut gty: String = cap_builtin_ret(
                                                                field_at(list_get(toks, p), 3)
                                                            );
                                                            if gty != "" {
                                                                gty = resolve_type_alias(aliases, gty);
                                                            } else {
                                                                if ret_table == "" {
                                                                    ret_table = build_fn_ret_table(toks);
                                                                }
                                                                gty = call_ret_type_at(
                                                                    toks,
                                                                    p,
                                                                    ret_table,
                                                                    aliases
                                                                );
                                                            }
                                                            if gty != "" {
                                                                if !types_compatible(ann, gty) {
                                                                    tc_err_at(
                                                                        toks,
                                                                        i,
                                                                        "let '"
                                                                            + vname
                                                                            + "' annotated as "
                                                                            + ann
                                                                            + " but initializer has type "
                                                                            + gty
                                                                    );
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else if field_at(list_get(toks, p), 0) == "EQ" {
                            p = p + 1;
                            if p < n {
                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                    if p + 1 < n {
                                        if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                            let gty: String = cap_builtin_ret(
                                                field_at(list_get(toks, p), 3)
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Collect pure-lit / annotated-lit let bindings into "\tname:Type\t".
