// job: let ann from call init; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_let_ann_call_init(toks: List[String]) {
    let n = list_len(toks);
    let ret_table = build_fn_ret_table(toks);
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let mut i = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_LET" {
            let mut p = i + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    let vname = field_at(list_get(toks, p), 3);
                    let vline = field_at(list_get(toks, p), 1);
                    let vcol = field_at(list_get(toks, p), 2);
                    p = p + 1;
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "COLON" {
                            p = p + 1;
                            if p < n {
                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                    let ann = resolve_type_alias(aliases, field_at(list_get(toks, p), 3));
                                    p = p + 1;
                                    if p < n {
                                        if field_at(list_get(toks, p), 0) == "EQ" {
                                            p = p + 1;
                                            if p + 2 < n {
                                                if field_at(list_get(toks, p), 0) == "IDENT" {
                                                    if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                                        if field_at(list_get(toks, p + 2), 0) == "RPAREN" {
                                                            let cname = field_at(list_get(toks, p), 3);
                                                            let got = resolve_type_alias(ret_table, cname);
                                                            if got != cname {
                                                                let gty = resolve_type_alias(aliases, got);
                                                                if !types_compatible(ann, gty) {
                                                                    println(
                                                                        "ERR\ttype\tType error at "
                                                                            + vline
                                                                            + ":"
                                                                            + vcol
                                                                            + ": let '"
                                                                            + vname
                                                                            + "' annotated as "
                                                                            + ann
                                                                            + " but initializer has type "
                                                                            + gty
                                                                    );
                                                                    process_exit(1);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Collect pure-lit / annotated-lit let bindings into "\tname:Type\t".
