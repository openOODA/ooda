// # Nested List[List[Int]] list_set helper in IR
//
// Logline: Defines oo_ll_I_set in the module so nested list_set clang-links with chs_rt only.
//
// Setup: Called from llvm_emit_stream after the preamble. malloc is not required; set is in-place.
//
// Beats:
//   1. Bounds-check i against len; trap on OOB.
//   2. Store the inner %OoIList at data[i].
//   3. Copy the outer aggregate to the sret slot.

pub fn llvm_emit_ll_I_set_def() {
    println("define void @oo_ll_I_set(%OoLL_I* sret(%OoLL_I) %out, %OoLL_I* byval(%OoLL_I) %l, i64 %i, %OoIList* byval(%OoIList) %v) {");
    println("  %dp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 0");
    println("  %data = load %OoIList*, %OoIList** %dp, align 8");
    println("  %lp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 1");
    println("  %len = load i64, i64* %lp, align 8");
    println("  %cp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 2");
    println("  %cap = load i64, i64* %cp, align 8");
    println("  %ok = icmp ult i64 %i, %len");
    println("  br i1 %ok, label %okb, label %oob");
    println("oob:");
    println("  call void @llvm.trap()");
    println("  unreachable");
    println("okb:");
    println("  %raw = bitcast %OoIList* %data to i8*");
    println("  %hdr8 = getelementptr inbounds i8, i8* %raw, i64 -8");
    println("  %hdr = bitcast i8* %hdr8 to %OoListHeader*");
    println("  %rcp = getelementptr inbounds %OoListHeader, %OoListHeader* %hdr, i32 0, i32 0");
    println("  %rc = load i32, i32* %rcp, align 4");
    println("  %nrc = add i32 %rc, 1");
    println("  store i32 %nrc, i32* %rcp, align 4");
    println("  call void @oo_ilist_retain(%OoIList* byval(%OoIList) %v)");
    println("  %ep = getelementptr inbounds %OoIList, %OoIList* %data, i64 %i");
    println("  %vv = load %OoIList, %OoIList* %v, align 8");
    println("  store %OoIList %vv, %OoIList* %ep, align 8");
    println("  %odp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 0");
    println("  store %OoIList* %data, %OoIList** %odp, align 8");
    println("  %olp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 1");
    println("  store i64 %len, i64* %olp, align 8");
    println("  %ocp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 2");
    println("  store i64 %cap, i64* %ocp, align 8");
    println("  ret void");
    println("}");
}
