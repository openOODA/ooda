// # Skip whitespace and line comments
//
// Logline: If the cursor sits on space, tab, newline, or a // line comment, consume it and pack a SKIP step.
//
// Setup: chars_len, char_at, list_new, and list_push exist; lex_step tries this first; pack_tok and pack_err are also used by sibling scanners.
//
// Beats:
//   1. pack_skip, pack_tok, and pack_err emit the shared SKIP, TOK, and ERR lists.
//   2. Space or tab advances one column and returns pack_skip.
//   3. Newline advances the line, resets the column to 1, and returns pack_skip.
//   4. A // comment eats characters until newline or end of source, then returns pack_skip.
//   5. Past the end, a lone slash, or any other character returns an empty list.

pub fn pack_skip(i: Int, line: Int, col: Int) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "SKIP");
    r = list_push(r, i.to_string());
    r = list_push(r, line.to_string());
    r = list_push(r, col.to_string());
    return r;
}

pub fn pack_tok(i: Int, line: Int, col: Int, kind: String, text: String, sl: Int, sc: Int) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "TOK");
    r = list_push(r, i.to_string());
    r = list_push(r, line.to_string());
    r = list_push(r, col.to_string());
    r = list_push(r, kind);
    r = list_push(r, text);
    r = list_push(r, sl.to_string());
    r = list_push(r, sc.to_string());
    return r;
}

pub fn pack_err(msg: String) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "ERR");
    r = list_push(r, msg);
    return r;
}

pub fn try_scan_ws(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n {
        return list_new();
    }
    let ch = char_at(src, i0);
    let mut i = i0;
    let mut line = line0;
    let mut col = col0;
    if ch == " " || ch == "\t" {
        while i < n {
            let w = char_at(src, i);
            if w == " " || w == "\t" {
                i = i + 1;
                col = col + 1;
            } else {
                break;
            }
        }
        return pack_skip(i, line, col);
    }
    if ch == "\n" {
        i = i + 1;
        line = line + 1;
        col = 1;
        return pack_skip(i, line, col);
    }
    if ch == "/" {
        let j = i + 1;
        if j < n {
            if char_at(src, j) == "/" {
                i = i + 2;
                col = col + 2;
                let mut cont_c = true;
                while cont_c {
                    if i >= n {
                        cont_c = false;
                    } else {
                        if char_at(src, i) == "\n" {
                            cont_c = false;
                        } else {
                            i = i + 1;
                            col = col + 1;
                        }
                    }
                }
                return pack_skip(i, line, col);
            }
        }
    }
    return list_new();
}
