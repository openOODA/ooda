// # Emit a let binding as C
//
// Logline: Lower let or let mut to a C declaration, infer the type from annotation or RHS, and record env and secret marks.
//
// Setup: Backend-C floor. c_peek_list_elem, c_ty_at, c_emit_skip_type, c_emit_match_let, c_emit_stmt, c_emit_expr_c, c_emit_let_untyped_ty, c_struct_lit_ty_name, c_rhs_is_unwrap, c_env_put, c_secret_try_record_alias_rhs, c_secret_prop_from_rhs, c_emit_let_alias_retain, and c_pack_pos_env exist; untyped inference lives in c_emit_let_ext.oo.
//
// Beats:
//   1. Skip let or mut, read the name and optional annotation, fail closed on an empty RHS, and hand match or if to those emitters.
//   2. Emit the RHS, then choose lty from annotation, untyped inference, a struct-lit name, or Ok, Err, and unwrap heuristics.
//   3. Put T, R, V, F, S, I, or LF in env; print a C decl once (__decl__/formal) and assign on a same-block re-let.

pub fn c_emit_let_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let k: String = field_at(list_get(toks, p), 0);
    if k == "KW_LET" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
            p = p + 1;
        }
    }
    let name: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    let mut ann_kind: String = "";
    let mut ann_ty: String = "";
    if p < n && field_at(list_get(toks, p), 0) == "COLON" {
        p = p + 1;
        ann_kind = c_peek_list_elem2(toks, p, n);
        ann_ty = c_ty_at(toks, p, n);
        p = c_emit_skip_type(toks, p, n);
    }
    if p < n && field_at(list_get(toks, p), 0) == "EQ" {
        p = p + 1;
    }
    // H5: incomplete `let x =` / empty RHS — fail-closed (no `x = ;`)
    if p >= n {
        println("ERR\tc_emit\tincomplete let RHS");
        process_exit(1);
    }
    let rk0: String = field_at(list_get(toks, p), 0);
    if rk0 == "SEMI" || rk0 == "RBRACE" || rk0 == "EOF" {
        println("ERR\tc_emit\tincomplete let RHS");
        process_exit(1);
    }
    if p < n && field_at(list_get(toks, p), 0) == "KW_MATCH" {
        return c_emit_match_let(name, toks, p, n, e);
    }
    // if-expression: let y = if c { a } else if d { b } else { e };
    if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
        let mut lty: String = "long long";
        if ann_ty != "" && ann_ty != "void" {
            lty = ann_ty;
        }
        if c_env_get(e, "__decl__" + name) == "" && c_env_get(e, "__formal__" + name) == "" {
            println("  " + lty + " " + name + ";");
            e = c_env_put(e, "__decl__" + name, "1");
        }
        let mut ea: String = c_env_put(e, "__asgn__", name);
        let mut guard: Int = 0;
        while guard < 32 {
            if p >= n {
                break;
            }
            let kk: String = field_at(list_get(toks, p), 0);
            if kk != "KW_IF" && kk != "KW_ELSE" {
                break;
            }
            let st: List[String] = c_emit_stmt(toks, p, n, ea);
            p = parse_int(list_get(st, 0));
            ea = list_get(st, 1);
            guard = guard + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    let mut env_rhs: String = e;
    if ann_kind != "" {
        env_rhs = c_env_put(e, "__ann__", ann_kind);
    }
    let rkind: String = c_result_ret_kind(ann_ty);
    if rkind != "" {
        env_rhs = c_env_put(env_rhs, "__ret__", rkind);
        env_rhs = c_env_put(env_rhs, "__ret_c_ty__", ann_ty);
    }
    // M53: capture RHS start for bare-IDENT secret assign-prop
    let rhs_pos: Int = p;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env_rhs);
    p = parse_int(list_get(pr, 0));
    let mut rhs: String = list_get(pr, 1);
    oo_emit_tmp_own(rhs);
    let mut lty: String = "long long";
    let mut bind_kind: String = ann_kind;
    // Annotation wins when present (String/Int/Bool/List/Result)
    if ann_ty != "" && ann_ty != "void" {
        lty = ann_ty;
        if ann_ty == "OoSList" {
            bind_kind = "S";
            if rhs == "oo_ilist_new()" {
                rhs = "oo_slist_new()";
            }
        }
        if ann_ty == "OoIList" {
            bind_kind = "I";
        }
        if ann_ty == "OoFList" {
            bind_kind = "LF";
            if rhs == "oo_ilist_new()" {
                rhs = "oo_flist_new()";
            }
        }
        if ann_ty == "OoLL_I" {
            bind_kind = "LL_I";
            if rhs == "oo_ilist_new()" {
                rhs = "oo_ll_I_new()";
            }
        }
        if ann_ty == "OoLL_S" {
            bind_kind = "LL_S";
        }
        if ann_ty == "OoLL_F" {
            bind_kind = "LL_F";
        }
        if chars_len(ann_ty) > 4 {
            if char_at(ann_ty, 0) == "O" && char_at(ann_ty, 1) == "o" && char_at(ann_ty, 2) == "L" && char_at(ann_ty, 3) == "_" {
                bind_kind = ann_kind;
                if rhs == "oo_ilist_new()" || rhs == "oo_slist_new()" {
                    rhs = "oo_l_" + ann_kind + "_new()";
                }
            }
        }
    } else if ann_kind == "S" {
        lty = "OoSList";
        if rhs == "oo_ilist_new()" {
            rhs = "oo_slist_new()";
        }
    } else if ann_kind == "I" {
        lty = "OoIList";
    } else {
        let inf: List[String] = c_emit_let_untyped_ty(rhs, e);
        lty = list_get(inf, 0);
        let bk: String = list_get(inf, 1);
        if bk != "" {
            bind_kind = bk;
        }
        // M168: untyped struct lit `((Name){ ... })` → bind as Name
        let sty: String = c_struct_lit_ty_name(rhs);
        if sty != "" {
            lty = sty;
        }
    }
    // M172: ann Int must not win over clear free-name / concat / bare T RHS
    // (M169 SEGV-avoid mistyped :Int on String → pure dual long long vs OoStr)
    if ann_ty == "" && lty == "long long" {
        let inf2: List[String] = c_emit_let_untyped_ty(rhs, e);
        let u: String = list_get(inf2, 0);
        if u != "long long" && u != "" {
            lty = u;
            let bk2: String = list_get(inf2, 1);
            if bk2 != "" {
                bind_kind = bk2;
            }
        }
    }
    // Result: Ok/Err → OoResS (R); write_file → OoResV (V) for match/unwrap.
    // Do not clobber user struct-lit types (e.g. `((Tree){...})` — char2 is 'T' of Tree).
    // Only apply Token/Ok heuristics when lty still default numeric.
    if lty == "long long" && chars_len(rhs) >= 9 {
        if char_at(rhs, 0) == "(" && char_at(rhs, 2) == "O" {
            if chars_len(rhs) > 8 && char_at(rhs, 7) == "I" { lty = "OoResI"; } else { lty = "OoResS"; }
        } else if char_at(rhs, 0) == "(" && char_at(rhs, 2) == "T" {
            // `((Token){...})` only — require "Token" prefix after `(("
            if chars_len(rhs) >= 8 && char_at(rhs, 3) == "o" && char_at(rhs, 4) == "k"
                && char_at(rhs, 5) == "e" && char_at(rhs, 6) == "n" {
                lty = "Token";
            }
        }
    }
    if chars_len(rhs) >= 12 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "w" && char_at(rhs, 4) == "r" {
            lty = "OoResV";
        }
    }
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "r" && char_at(rhs, 4) == "e" {
            if char_at(rhs, 7) == "f" || char_at(rhs, 7) == "g" {
                lty = "OoResS";
            }
        }
    }
    if c_rhs_is_unwrap(rhs) {
        if ann_ty == "" {
            lty = "OoStr";
        }
        if ann_ty == "void" {
            lty = "OoStr";
        }
    }
    // User typedefs may be one character (type S = struct). Empty only.
    if lty == "" {
        lty = "long long";
    }
    if lty == "OoStr" {
        e = c_env_put(e, name, "T");
    } else if lty == "OoResS" {
        e = c_env_put(e, name, "R");
    } else if lty == "OoResV" {
        e = c_env_put(e, name, "V");
    } else if lty == "OoResI" {
        e = c_env_put(e, name, "RI");
    } else if lty == "OoResII" {
        e = c_env_put(e, name, "RII");
    } else if lty == "OoResB" {
        e = c_env_put(e, name, "RB");
    } else if lty == "OoResF" {
        e = c_env_put(e, name, "RF");
    } else if lty == "OoResLI" {
        e = c_env_put(e, name, "RLI");
    } else if lty == "OoResLS" {
        e = c_env_put(e, name, "RLS");
    } else if lty == "OoResLF" {
        e = c_env_put(e, name, "RLF");
    } else if chars_len(lty) > 5 {
        if str_slice(lty, 0, 5) == "OoRes" {
            e = c_env_put(e, name, lty);
        } else if bind_kind != "" {
            e = c_env_put(e, name, bind_kind);
        }
    } else if lty == "double" {
        e = c_env_put(e, name, "F");
    } else if bind_kind == "S" || bind_kind == "I" || bind_kind == "F" {
        e = c_env_put(e, name, bind_kind);
    } else if bind_kind != "" {
        e = c_env_put(e, name, bind_kind);
    }
    // CRIT 2.4: let f = println|tcp_write → __alias__f for emit-time guard
    e = c_secret_try_record_alias_rhs(toks, rhs_pos, n, e, name);
    e = c_secret_prop_from_rhs(toks, rhs_pos, n, e, name);
    // Same-block second let: C forbids redecl (HEAD match_extract_span `ms`).
    let mut already: String = c_env_get(e, "__decl__" + name);
    if already == "" {
        already = c_env_get(e, "__formal__" + name);
    }
    if already != "" {
        println("  " + name + " = " + rhs + ";");
    } else {
        println("  " + lty + " " + name + " = " + rhs + ";");
        e = c_env_put(e, "__decl__" + name, "1");
    }
    c_emit_let_alias_retain(name, rhs, lty, e);
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}
