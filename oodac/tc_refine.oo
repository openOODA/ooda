// # Drive refinement checks
//
// Logline: Walk the token stream once and apply return, let, call, string-builtin, and assign refinement checks.
//
// Setup: refine_capture_fn_ret_bound, refine_check_return, refine_check_let, refine_check_call_arg, refine_check_str_builtins, refine_check_assign, refine_check_smt, and parse_int exist.
//
// Beats:
//   1. Bail out when the token list is longer than 1000.
//   2. On KW_FN, capture or clear the Int[lo..hi] return bound.
//   3. On KW_RETURN, KW_LET, or IDENT, call the matching refine_check_* helper.

import "tc_refine_smt.oo";

pub fn typecheck_refinements(toks: List[String]) {
    refine_check_smt(toks);
    let n = list_len(toks);
    if n > 1000 {
        return;
    }
    let mut i = 0;
    let mut ret_bound_min = 0;
    let mut ret_bound_max = 0;
    let mut has_ret_bound = false;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            let b: List[String] = refine_capture_fn_ret_bound(toks, i);
            if list_get(b, 0) == "1" {
                has_ret_bound = true;
                ret_bound_min = parse_int(list_get(b, 1));
                ret_bound_max = parse_int(list_get(b, 2));
            } else {
                has_ret_bound = false;
            }
        }
        if k == "KW_RETURN" {
            refine_check_return(toks, i, has_ret_bound, ret_bound_min, ret_bound_max);
        }
        if k == "KW_LET" {
            refine_check_let(toks, i);
        }
        if k == "IDENT" {
            refine_check_call_arg(toks, i);
            refine_check_str_builtins(toks, i);
            refine_check_assign(toks, i);
        }
        i = i + 1;
    }
}
