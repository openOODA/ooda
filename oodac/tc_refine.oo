// job: drive refinement checks over token stream; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_refinements(toks: List[String]) {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    let mut ret_bound_min: Int = 0;
    let mut ret_bound_max: Int = 0;
    let mut has_ret_bound: Bool = false;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            let b: List[String] = refine_capture_fn_ret_bound(toks, i);
            if list_get(b, 0) == "1" {
                has_ret_bound = true;
                ret_bound_min = parse_int(list_get(b, 1));
                ret_bound_max = parse_int(list_get(b, 2));
            } else {
                has_ret_bound = false;
            }
        }
        if k == "KW_RETURN" {
            refine_check_return(toks, i, has_ret_bound, ret_bound_min, ret_bound_max);
        }
        if k == "KW_LET" {
            refine_check_let(toks, i);
        }
        if k == "IDENT" {
            refine_check_call_arg(toks, i);
            refine_check_str_builtins(toks, i);
            refine_check_assign(toks, i);
        }
        i = i + 1;
    }
}
