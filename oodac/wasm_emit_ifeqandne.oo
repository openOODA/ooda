// # Detect const if INT==INT && INT==INT println with no else
//
// Logline: Returns the then STRING when a function body is only if INT EQEQ INT ANDAND INT EQEQ INT with one println(STRING) and no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if INT == INT && INT == INT then one println(STRING) and the function RBRACE.
//   3. Return the then STRING only when both pairs are equal. IDENT operands miss.
//
// residual: if 1 == x && 2 == 2 no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wean_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wean_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wean_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wean_kind(toks, p) != "IDENT" || wean_text(toks, p) != "println" { return empty; }
    if wean_kind(toks, p + 1) != "LPAREN" || wean_kind(toks, p + 2) != "STRING" { return empty; }
    if wean_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wean_text(toks, p + 2);
    p = p + 4;
    if p < n && wean_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_if_eq_and_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wean_kind(toks, i) == "KW_FN" && wean_kind(toks, i + 1) == "IDENT" {
            if wean_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wean_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 8 >= n || wean_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "INT" { return ""; }
                let a: Int = parse_int(wean_text(toks, p));
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "EQEQ" { return ""; }
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "INT" { return ""; }
                let b: Int = parse_int(wean_text(toks, p));
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "ANDAND" { return ""; }
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "INT" { return ""; }
                let c: Int = parse_int(wean_text(toks, p));
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "EQEQ" { return ""; }
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "INT" { return ""; }
                let d: Int = parse_int(wean_text(toks, p));
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wean_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wean_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wean_kind(toks, p) != "RBRACE" { return ""; }
                if a == b && c == d { return list_get(th, 0); }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
