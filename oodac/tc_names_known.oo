// job: builtin/keyword known-name table; stage: typecheck
// in: name; out: Bool
// used by typecheck_undefined_vars_ext (tc_names.oo)

pub fn is_known_name(name: String) -> Bool {
    if name == "println" || name == "eprintln" { return true; }
    if name == "assert_eq" { return true; }
    if name == "assert_ne" { return true; }
    if name == "assert" { return true; }
    if name == "list_new" { return true; }
    if name == "list_push" { return true; }
    if name == "list_get" { return true; }
    if name == "list_len" { return true; }
    if name == "list_new_int" { return true; }
    if name == "list_push_int" { return true; }
    if name == "list_get_int" { return true; }
    if name == "chars_len" { return true; }
    if name == "char_at" { return true; }
    if name == "str_slice" { return true; }
    if name == "char_is_digit" { return true; }
    if name == "char_is_alpha" { return true; }
    if name == "char_is_space" { return true; }
    if name == "read_file" { return true; }
    if name == "write_file" { return true; }
    if name == "path_exists" { return true; }
    if name == "file_size" { return true; }
    if name == "fetch" { return true; }
    // HIGH 6.1: env_set is sealed EnvCap (check_cap_util); setenv/unsetenv
    // are product SECRETSINK aliases. Known so check reaches secret refuse.
    if name == "env_get" || name == "env_set" || name == "setenv" || name == "unsetenv" { return true; }
    if name == "sys_exec" { return true; }
    // M12: time / entropy sealed builtins
    if name == "now_ms" { return true; }
    if name == "sleep_ms" { return true; }
    if name == "random" { return true; }
    if name == "seed" { return true; }
    // M17: explicit AllocCap helpers (list_new stays ambient)
    if name == "alloc_bytes" { return true; }
    if name == "free_bytes" { return true; }
    // M166 AllocCap aliases + process + residual free names
    if name == "malloc" || name == "free" || name == "realloc" || name == "process_exit" || name == "chs_build" { return true; }
    if is_sealed_ffi(name) || name == "UnsafeFFICap" || is_residual_forbidden(name) { return true; }
    if name == "to_string" || name == "len" || name == "ord" || name == "bit_xor" || name == "index_get" || name == "verify_human" || name == "meta_epoch" || name == "meta_mix" || name == "meta_is_path_a" || name == "meta_decoy_touch" { return true; }
    if name == "crypto_sha256_internal" || name == "crypto_hmac_sha256_internal"
        || name == "crypto_md5_internal" || name == "crypto_sha1_internal"
        || name == "crypto_aes_encrypt_internal" { return true; }
    if name == "tcp_bind" || name == "tcp_connect" || name == "bind_udp" || name == "tls_connect"
        || name == "tcp_write" || name == "tcp_read" || name == "udp_recv" || name == "tcp_close"
        || name == "sock_raw" || name == "raw_socket" { return true; }
    if name == "byte_at" || name == "bytes_len" || name == "byte_slice" || name == "bytes_eq"
        || name == "bytes_from_str" || name == "bytes_concat" || name == "bytes_new"
        || name == "bytes_push" || name == "bytes_get" || name == "bytes_to_str" { return true; }
    if name == "str_starts_with" || name == "str_ends_with" || name == "str_index_of"
        || name == "str_repeat" || name == "str_to_uppercase" || name == "str_split" || name == "str_trim" || name == "oo_fs_read_dir" || name == "oo_fs_remove_file" || name == "oo_fs_mkdir" { return true; }
    if name == "sin" || name == "cos" || name == "ln" || name == "exp" || name == "sqrt" || name == "pow" { return true; }
    if name == "sys_spawn" || name == "sys_wait" || name == "sys_kill"
        || name == "sys_epoll_create" || name == "sys_inotify_init" || name == "sys_prctl" { return true; }
    if name == "oo_fs_is_dir" || name == "oo_sys_args" { return true; }
    if name == "oo_str_eq" || name == "match_rparen" || name == "oo_file_size" || name == "oo_read_file" || name == "oo_write_file" || name == "oo_path_exists" || name == "oo_env_get" || name == "oo_sys_exec" { return true; }
    if name == "mutex_lock" || name == "mutex_unlock" || name == "thread_spawn" || name == "thread_join" || name == "gpu_launch" { return true; }
    if name == "channel_new" || name == "channel_send" || name == "channel_recv"
        || name == "actor_spawn" || name == "actor_send" || name == "actor_recv" { return true; }
    if name == "json_parse_internal" || name == "json_stringify_internal"
        || name == "async_spawn_internal" || name == "async_join_internal" || name == "python_embed_internal" { return true; }
    // Control keywords lexed as IDENT in R1 — not variables.
    if name == "break" || name == "continue" || name == "return" || name == "for" || name == "in" { return true; }
    if name == "else" || name == "match" || name == "if" || name == "while" || name == "loop" { return true; }
    if name == "type" || name == "mut" || name == "let" || name == "fn" || name == "pub" { return true; }
    if name == "struct" || name == "impl" || name == "use" || name == "import" || name == "as" { return true; }
    if name == "where" || name == "verify" { return true; }
    if name == "Int" || name == "String" || name == "Bool" || name == "Float" || name == "Void" { return true; }
    if name == "NetCap" || name == "FsCap" || name == "GpuCap" || name == "ThreadCap" { return true; }
    if name == "EnvCap" || name == "SysCap" || name == "TimeCap" || name == "RandCap" || name == "AllocCap" { return true; }
    if name == "Option" { return true; }
    if name == "Result" { return true; }
    if name == "List" { return true; }
    if name == "list" { return true; }
    if name == "Ok" { return true; }
    if name == "Err" { return true; }
    if name == "Some" { return true; }
    if name == "None" { return true; }
    if name == "true" { return true; }
    if name == "false" { return true; }
    // Contract surface: ensures/requires may reference result / old
    if name == "result" { return true; }
    if name == "old" { return true; }
    if name == "self" { return true; }
    return false;
}
