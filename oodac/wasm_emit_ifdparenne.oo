// # Detect const if ((true)) println with no else
//
// Logline: Returns the then STRING when a function body is only if ((KW_TRUE)) with one println(STRING) and no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if LPAREN LPAREN KW_TRUE/KW_FALSE RPAREN RPAREN then one println(STRING) and the function RBRACE.
//   3. Return the then STRING only when KW_TRUE. IDENT inside parens misses.
//
// residual: if ((x)) no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wdpr_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wdpr_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wdpr_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wdpr_kind(toks, p) != "IDENT" || wdpr_text(toks, p) != "println" { return empty; }
    if wdpr_kind(toks, p + 1) != "LPAREN" || wdpr_kind(toks, p + 2) != "STRING" { return empty; }
    if wdpr_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wdpr_text(toks, p + 2);
    p = p + 4;
    if p < n && wdpr_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_if_dparen_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wdpr_kind(toks, i) == "KW_FN" && wdpr_kind(toks, i + 1) == "IDENT" {
            if wdpr_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wdpr_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 6 >= n || wdpr_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "LPAREN" { return ""; }
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "LPAREN" { return ""; }
                p = p + 1;
                let ck: String = wdpr_kind(toks, p);
                if ck != "KW_TRUE" && ck != "KW_FALSE" { return ""; }
                let take_then: Bool = ck == "KW_TRUE";
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "RPAREN" { return ""; }
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "RPAREN" { return ""; }
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wdpr_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wdpr_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wdpr_kind(toks, p) != "RBRACE" { return ""; }
                if take_then { return list_get(th, 0); }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
