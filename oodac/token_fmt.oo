// job: token line encoding/decoding helpers; stage: tokens
// in: token fields or source; out: List[String] or field String

pub fn tokenize_lines(src: String) -> List[String] {
    let probe = lex_all(src);
    if probe.is_err() {
        let e = match probe {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tlex\t" + e);
        process_exit(1);
    }
    return collect_tokens(src);
}

pub fn tok_line(kind: String, line: Int, col: Int, text: String) -> String {
    return kind + "\t" + line.to_string() + "\t" + col.to_string() + "\t" + text;
}

pub fn field_at(line: String, which: Int) -> String {
    // split by tab: 0=kind 1=line 2=col 3=text (text may be empty)
    let n = chars_len(line);
    let mut start = 0;
    let mut idx = 0;
    let mut i = 0;
    while i <= n {
        let at_end = i == n;
        let is_tab = false;
        let mut ch = "";
        if !at_end {
            ch = char_at(line, i);
        }
        if at_end || ch == "\t" {
            if idx == which {
                return str_slice(line, start, i);
            }
            idx = idx + 1;
            start = i + 1;
        }
        if at_end {
            i = n + 1;
        } else {
            i = i + 1;
        }
    }
    return "";
}

