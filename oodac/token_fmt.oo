// job: token line encoding/decoding helpers; stage: tokens
// in: token fields or source; out: List[String] or field String

pub fn tokenize_lines(src: String) -> List[String] {
    let probe: Int = lex_all(src);
    if probe.is_err() {
        let e = match probe {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tlex\t" + e);
        process_exit(1);
    }
    return collect_tokens(src);
}

// Encode tab/newline so TSV token lines stay 4 fields.
pub fn tok_line(kind: String, line: Int, col: Int, text: String) -> String {
    let mut enc: String = "";
    let tn: Int = chars_len(text);
    let mut ti: Int = 0;
    while ti < tn {
        let c: String = char_at(text, ti);
        if c == "\t" {
            enc = enc + "\\t";
        } else if c == "\n" {
            enc = enc + "\\n";
        } else if c == "\\" {
            enc = enc + "\\\\";
        } else {
            enc = enc + c;
        }
        ti = ti + 1;
    }
    let ls: String = line.to_string();
    let cs: String = col.to_string();
    return kind + "\t" + ls + "\t" + cs + "\t" + enc;
}

// Decode field 3 escapes produced by tok_line.
pub fn field_decode3(raw: String) -> String {
    let rn: Int = chars_len(raw);
    let mut out: String = "";
    let mut ri: Int = 0;
    while ri < rn {
        let c: String = char_at(raw, ri);
        if c == "\\" {
            if (ri + 1) < rn {
                let nch: String = char_at(raw, ri + 1);
                if nch == "t" {
                    out = out + "\t";
                    ri = ri + 2;
                } else if nch == "n" {
                    out = out + "\n";
                    ri = ri + 2;
                } else if nch == "\\" {
                    out = out + "\\";
                    ri = ri + 2;
                } else {
                    out = out + c;
                    ri = ri + 1;
                }
            } else {
                out = out + c;
                ri = ri + 1;
            }
        } else {
            out = out + c;
            ri = ri + 1;
        }
    }
    return out;
}

pub fn field_at(line: String, which: Int) -> String {
    // Find the which-th tab-separated field (0..3). Safe on empty.
    let n: Int = chars_len(line);
    if n == 0 {
        return "";
    }
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(line, i);
        if ch == "\t" {
            if field == which {
                if start > i {
                    return "";
                }
                let raw: String = str_slice(line, start, i);
                if which == 3 {
                    return field_decode3(raw);
                }
                return raw;
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    // last field (no trailing tab)
    if field == which {
        if start > n {
            return "";
        }
        let raw2: String = str_slice(line, start, n);
        if which == 3 {
            return field_decode3(raw2);
        }
        return raw2;
    }
    return "";
}
