// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: list-kind env map for emit (get/put last-wins)
// stage: emit
// env format: "name=S;name2=I;" or "name=val;" (val until ';')
// kinds: S=List[String] I=List[Int] T=OoStr R/V=Result F=double Float; also __asgn__=ident

// Last match at start or after ';' ("s=" must not hit inside "xs=S;").
// Put replaces, so usually one binding; last-wins get is belt-and-suspenders.
pub fn c_env_get(env: String, name: String) -> String {
    let key: Int = name + "=";
    let kn: Int = chars_len(key);
    let en: Int = chars_len(env);
    let mut i: Int = 0;
    let mut found: String = "";
    while i + kn <= en {
        let mut at_bound: Bool = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok: Bool = true;
            let mut j: Int = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut val: String = "";
                let mut k: Int = i + kn;
                while k < en {
                    let c: String = char_at(env, k);
                    if c == ";" {
                        k = en;
                    } else {
                        val = val + c;
                        k = k + 1;
                    }
                }
                found = val;
            }
        }
        i = i + 1;
    }
    return found;
}

// Replace only inside the topmost `{;` frame. Outer same-name bindings stay
// so nested shadow (`let x` in bare block) appends and scope_exit frees inner only.
// Same-frame re-put still replaces in place (keeps kind for list push etc.).
pub fn c_env_put(env: String, name: String, kind: String) -> String {
    let key: Int = name + "=";
    let kn: Int = chars_len(key);
    let en: Int = chars_len(env);
    let mut last_scope: Int = 0;
    let mut si: Int = 0;
    while si + 1 < en {
        if char_at(env, si) == "{" && char_at(env, si + 1) == ";" {
            last_scope = si + 2;
        }
        si = si + 1;
    }
    let mut out: String = "";
    let mut i: Int = 0;
    let mut replaced: Bool = false;
    while i < en {
        let mut at_bound: Bool = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        let mut did: Bool = false;
        if !replaced && i >= last_scope && at_bound && i + kn <= en {
            let mut ok: Bool = true;
            let mut j: Int = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                out = out + name + "=" + kind + ";";
                i = i + kn;
                while i < en {
                    let c: String = char_at(env, i);
                    i = i + 1;
                    if c == ";" {
                        break;
                    }
                }
                replaced = true;
                did = true;
            }
        }
        if did == false {
            out = out + char_at(env, i);
            i = i + 1;
        }
    }
    if replaced {
        return out;
    }
    return out + name + "=" + kind + ";";
}

// Reassign: update the last binding of name in any frame (matches c_env_get).
// Must not append into the top frame when name is outer — that made while/if
// bodies scope_exit-release mut vars each iteration (UAF under free).
pub fn c_env_put_last(env: String, name: String, kind: String) -> String {
    let key: Int = name + "=";
    let kn: Int = chars_len(key);
    let en: Int = chars_len(env);
    let mut last_i: Int = -1;
    let mut i: Int = 0;
    while i + kn <= en {
        let mut at_bound: Bool = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok: Bool = true;
            let mut j: Int = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                last_i = i;
            }
        }
        i = i + 1;
    }
    if last_i < 0 {
        return env + name + "=" + kind + ";";
    }
    let mut out: String = str_slice(env, 0, last_i);
    out = out + name + "=" + kind + ";";
    let mut k: Int = last_i + kn;
    while k < en {
        let c: String = char_at(env, k);
        k = k + 1;
        if c == ";" {
            break;
        }
    }
    if k < en {
        out = out + str_slice(env, k, en);
    }
    return out;
}
