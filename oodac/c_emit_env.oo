// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: list-kind env map for emit (get/put last-wins)
// stage: emit
// env format: "name=S;name2=I;" or "name=val;" (val until ';')
// kinds: S=List[String] I=List[Int] T=OoStr R/V=Result; also __asgn__=ident

// Last match at start or after ';' ("s=" must not hit inside "xs=S;").
// Put replaces, so usually one binding; last-wins get is belt-and-suspenders.
pub fn c_env_get(env: String, name: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut i = 0;
    let mut found = "";
    while i + kn <= en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut val = "";
                let mut k = i + kn;
                while k < en {
                    let c = char_at(env, k);
                    if c == ";" {
                        k = en;
                    } else {
                        val = val + c;
                        k = k + 1;
                    }
                }
                found = val;
            }
        }
        i = i + 1;
    }
    return found;
}

// Last-wins in-place: replace existing name=…; at its position (keeps scope
// frame). Drop-and-append moved outer locals into if-blocks, so scope_exit
// released them and lost kind — later list_push defaulted to I (ilist).
// New names still append (bind into current frame).
pub fn c_env_put(env: String, name: String, kind: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut out = "";
    let mut i = 0;
    let mut replaced = false;
    while i < en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        let mut did = false;
        if at_bound && i + kn <= en {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                // Replace value in place; skip old value until ';'
                out = out + name + "=" + kind + ";";
                i = i + kn;
                while i < en {
                    let c = char_at(env, i);
                    i = i + 1;
                    if c == ";" {
                        break;
                    }
                }
                replaced = true;
                did = true;
            }
        }
        if did == false {
            out = out + char_at(env, i);
            i = i + 1;
        }
    }
    if replaced {
        return out;
    }
    return out + name + "=" + kind + ";";
}
