// # Encode the WebAssembly string table
//
// Logline: Hex-encodes bytes, collects STRING literals, lays them out from offset 1024, and emits a data section plus the heap start.
//
// Setup: token_fmt.oo is imported; field_at, list_get, chars_len, char_at, and println exist; each string is a 12-byte header plus text plus NUL, padded to 4 bytes.
//
// Beats:
//   1. wasm_hex_nibble, wasm_hex_byte, wasm_encode_u32_le, and wasm_encode_str_bytes write little-endian hex escape sequences.
//   2. wasm_collect_strings uniques STRING texts; wasm_str_offset and wasm_calc_heap_start walk that layout from 1024 and round the heap to 4096.
//   3. wasm_emit_data_section prints (data (i32.const 1024) "...") and returns the same heap start.
//
// residual: WAT data hex printer is unused on emit-wasm; product path is dummy-end \0asm.

import "token_fmt.oo";

pub fn wasm_hex_nibble(n: Int) -> String {
    if n == 0 { return "0"; } if n == 1 { return "1"; } if n == 2 { return "2"; }
    if n == 3 { return "3"; } if n == 4 { return "4"; } if n == 5 { return "5"; }
    if n == 6 { return "6"; } if n == 7 { return "7"; } if n == 8 { return "8"; }
    if n == 9 { return "9"; } if n == 10 { return "a"; } if n == 11 { return "b"; }
    if n == 12 { return "c"; } if n == 13 { return "d"; } if n == 14 { return "e"; }
    return "f";
}

pub fn wasm_hex_byte(b: Int) -> String {
    let mut v = b;
    if v < 0 { v = v + 256; }
    let v16 = v / 16;
    let hi = v16 - (v16 / 16) * 16;
    let lo = v - v16 * 16;
    return "\\" + wasm_hex_nibble(hi) + wasm_hex_nibble(lo);
}

pub fn wasm_encode_u32_le(v: Int) -> String {
    let v256 = v / 256;
    let b0 = v - v256 * 256;
    let v65k = v / 65536;
    let b1 = v256 - (v256 / 256) * 256;
    let v16m = v / 16777216;
    let b2 = v65k - (v65k / 256) * 256;
    let b3 = v16m - (v16m / 256) * 256;
    let h0: String = wasm_hex_byte(b0);
    let h1: String = wasm_hex_byte(b1);
    let h2: String = wasm_hex_byte(b2);
    let h3: String = wasm_hex_byte(b3);
    let s01: String = h0 + h1;
    let s23: String = h2 + h3;
    return s01 + s23;
}

pub fn wasm_encode_str_bytes(s: String) -> String {
    let n = chars_len(s);
    let mut i = 0;
    let mut out = "";
    while i < n {
        let c = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\0a"; }
        else if c == "\t" { out = out + "\\09"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn wasm_collect_strings(toks: List[String], n: Int) -> List[String] {
    let mut str_tab: List[String] = list_new();
    let mut pos = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "STRING" {
            let txt: String = field_at(list_get(toks, pos), 3);
            let mut i = 0;
            let mut found = false;
            while i < list_len(str_tab) {
                if list_get(str_tab, i) == txt {
                    found = true;
                }
                i = i + 1;
            }
            if !found {
                str_tab = list_push(str_tab, txt);
            }
        }
        pos = pos + 1;
    }
    return str_tab;
}

pub fn wasm_str_offset(str_tab: List[String], text: String) -> Int {
    let mut cur_offset = 1024;
    let mut i = 0;
    while i < list_len(str_tab) {
        let s = list_get(str_tab, i);
        if s == text {
            return cur_offset;
        }
        let slen = chars_len(s);
        let raw_bytes = 12 + slen + 1;
        let padded = ((raw_bytes + 3) / 4) * 4;
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    return 1024;
}

pub fn wasm_calc_heap_start(str_tab: List[String]) -> Int {
    let mut cur_offset = 1024;
    let mut i = 0;
    while i < list_len(str_tab) {
        let s = list_get(str_tab, i);
        let slen = chars_len(s);
        let raw_bytes = 12 + slen + 1;
        let padded = ((raw_bytes + 3) / 4) * 4;
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    let mut heap_start = 4096;
    if cur_offset > 4096 {
        heap_start = ((cur_offset + 4095) / 4096) * 4096;
    }
    return heap_start;
}

pub fn wasm_emit_data_section(str_tab: List[String]) -> Int {
    let mut data_payload = "";
    let mut cur_offset = 1024;
    let mut i = 0;
    while i < list_len(str_tab) {
        let s = list_get(str_tab, i);
        let slen = chars_len(s);
        let h_len: String = wasm_encode_u32_le(slen);
        let h_one: String = wasm_encode_u32_le(1);
        let h_two: String = h_len + h_len;
        let hdr: String = h_two + h_one;
        let body: String = wasm_encode_str_bytes(s) + "\\00";
        data_payload = data_payload + hdr + body;
        let raw_bytes = 12 + slen + 1;
        let padded = ((raw_bytes + 3) / 4) * 4;
        let pad_extra = padded - raw_bytes;
        let mut k = 0;
        while k < pad_extra {
            data_payload = data_payload + "\\00";
            k = k + 1;
        }
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    if data_payload != "" {
        println("  (data (i32.const 1024) \"" + data_payload + "\")");
    }
    let mut heap_start = 4096;
    if cur_offset > 4096 {
        heap_start = ((cur_offset + 4095) / 4096) * 4096;
    }
    return heap_start;
}
