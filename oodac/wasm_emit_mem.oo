import "token_fmt.oo";

pub fn wasm_hex_nibble(n: Int) -> String {
    if n == 0 { return "0"; } if n == 1 { return "1"; } if n == 2 { return "2"; }
    if n == 3 { return "3"; } if n == 4 { return "4"; } if n == 5 { return "5"; }
    if n == 6 { return "6"; } if n == 7 { return "7"; } if n == 8 { return "8"; }
    if n == 9 { return "9"; } if n == 10 { return "a"; } if n == 11 { return "b"; }
    if n == 12 { return "c"; } if n == 13 { return "d"; } if n == 14 { return "e"; }
    return "f";
}

pub fn wasm_hex_byte(b: Int) -> String {
    let mut v: Int = b;
    if v < 0 { v = v + 256; }
    let v16: Int = v / 16;
    let hi: Int = v16 - (v16 / 16) * 16;
    let lo: Int = v - v16 * 16;
    return "\\" + wasm_hex_nibble(hi) + wasm_hex_nibble(lo);
}

pub fn wasm_encode_u32_le(v: Int) -> String {
    let v256: Int = v / 256;
    let b0: Int = v - v256 * 256;
    let v65k: Int = v / 65536;
    let b1: Int = v256 - (v256 / 256) * 256;
    let v16m: Int = v / 16777216;
    let b2: Int = v65k - (v65k / 256) * 256;
    let b3: Int = v16m - (v16m / 256) * 256;
    let h0: String = wasm_hex_byte(b0);
    let h1: String = wasm_hex_byte(b1);
    let h2: String = wasm_hex_byte(b2);
    let h3: String = wasm_hex_byte(b3);
    let s01: String = h0 + h1;
    let s23: String = h2 + h3;
    return s01 + s23;
}

pub fn wasm_encode_str_bytes(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut out: String = "";
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\0a"; }
        else if c == "\t" { out = out + "\\09"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn wasm_collect_strings(toks: List[String], n: Int) -> List[String] {
    let mut str_tab: List[String] = list_new();
    let mut pos: Int = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "STRING" {
            let txt: String = field_at(list_get(toks, pos), 3);
            let mut i: Int = 0;
            let mut found: Bool = false;
            while i < list_len(str_tab) {
                if list_get(str_tab, i) == txt {
                    found = true;
                }
                i = i + 1;
            }
            if !found {
                str_tab = list_push(str_tab, txt);
            }
        }
        pos = pos + 1;
    }
    return str_tab;
}

pub fn wasm_str_offset(str_tab: List[String], text: String) -> Int {
    let mut cur_offset: Int = 1024;
    let mut i: Int = 0;
    while i < list_len(str_tab) {
        let s: String = list_get(str_tab, i);
        if s == text {
            return cur_offset;
        }
        let slen: Int = chars_len(s);
        let raw_bytes: Int = 12 + slen + 1;
        let padded: Int = ((raw_bytes + 3) / 4) * 4;
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    return 1024;
}

pub fn wasm_calc_heap_start(str_tab: List[String]) -> Int {
    let mut cur_offset: Int = 1024;
    let mut i: Int = 0;
    while i < list_len(str_tab) {
        let s: String = list_get(str_tab, i);
        let slen: Int = chars_len(s);
        let raw_bytes: Int = 12 + slen + 1;
        let padded: Int = ((raw_bytes + 3) / 4) * 4;
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    let mut heap_start: Int = 4096;
    if cur_offset > 4096 {
        heap_start = ((cur_offset + 4095) / 4096) * 4096;
    }
    return heap_start;
}

pub fn wasm_emit_data_section(str_tab: List[String]) -> Int {
    let mut data_payload: String = "";
    let mut cur_offset: Int = 1024;
    let mut i: Int = 0;
    while i < list_len(str_tab) {
        let s: String = list_get(str_tab, i);
        let slen: Int = chars_len(s);
        let h_len: String = wasm_encode_u32_le(slen);
        let h_one: String = wasm_encode_u32_le(1);
        let h_two: String = h_len + h_len;
        let hdr: String = h_two + h_one;
        let body: Int = wasm_encode_str_bytes(s) + "\\00";
        data_payload = data_payload + hdr + body;
        let raw_bytes: Int = 12 + slen + 1;
        let padded: Int = ((raw_bytes + 3) / 4) * 4;
        let pad_extra: Int = padded - raw_bytes;
        let mut k: Int = 0;
        while k < pad_extra {
            data_payload = data_payload + "\\00";
            k = k + 1;
        }
        cur_offset = cur_offset + padded;
        i = i + 1;
    }
    if data_payload != "" {
        println("  (data (i32.const 1024) \"" + data_payload + "\")");
    }
    let mut heap_start: Int = 4096;
    if cur_offset > 4096 {
        heap_start = ((cur_offset + 4095) / 4096) * 4096;
    }
    return heap_start;
}
