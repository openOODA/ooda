// # Compile-Time Path Refinement Typechecker
//
// Logline: Validates Path["pattern"] capability refinement types statically against literal assignments.
//
// Setup: field_at, list_get, list_len, and tc_err_at exist; called from typecheck_refinements.
//
// Beats:
//   1. Detect Path["pattern"] type annotations in let bindings and parameters.
//   2. Match string literal assignments against capability path globs.
//   3. Reject unauthorized path literals fail-closed with RefinementPathViolation.
//   4. Enforce compile-time least-privilege capability boundaries.

import "tc_diag.oo";

pub fn refine_path_glob_match(pattern: String, path: String) -> Bool {
    let pat_len: Int = chars_len(pattern);
    let path_len: Int = chars_len(path);
    if pat_len == 0 {
        return path_len == 0;
    }
    if pattern == "*" {
        return true;
    }
    if str_ends_with(pattern, "/*") {
        let prefix: String = str_slice(pattern, 0, pat_len - 2);
        let pre_len: Int = chars_len(prefix);
        if path_len < pre_len {
            return false;
        }
        let cand: String = str_slice(path, 0, pre_len);
        if cand == prefix {
            return true;
        }
        return false;
    }
    if str_ends_with(pattern, "*") {
        let prefix: String = str_slice(pattern, 0, pat_len - 1);
        let pre_len: Int = chars_len(prefix);
        if path_len < pre_len {
            return false;
        }
        let cand: String = str_slice(path, 0, pre_len);
        if cand == prefix {
            return true;
        }
        return false;
    }
    return pattern == path;
}

pub fn refine_check_path_let(toks: List[String], i: Int) {
    let n: Int = list_len(toks);
    if i + 8 < n {
        if field_at(list_get(toks, i + 2), 0) == "COLON" {
            let ty_name: String = field_at(list_get(toks, i + 3), 3);
            if ty_name == "Path" {
                if field_at(list_get(toks, i + 4), 0) == "LBRACKET" {
                    if field_at(list_get(toks, i + 5), 0) == "STRING" {
                        let pat: String = field_at(list_get(toks, i + 5), 3);
                        if field_at(list_get(toks, i + 6), 0) == "RBRACKET" {
                            if field_at(list_get(toks, i + 7), 0) == "EQ" {
                                if field_at(list_get(toks, i + 8), 0) == "STRING" {
                                    let lit: String = field_at(list_get(toks, i + 8), 3);
                                    if !refine_path_glob_match(pat, lit) {
                                        tc_err_at(toks, i + 8, "RefinementPathViolation");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
