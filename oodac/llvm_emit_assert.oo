// # Lower assert builtins to LLVM
//
// Logline: Emits icmp or structural Result compare for assert, assert_eq, and assert_ne, then branches to trap or continue.
//
// Setup: llvm_emit_expr, llvm_gen_reg, and llvm_gen_label exist; env is the five-slot LLVM emit env; toks start at the builtin name.
//
// Beats:
//   1. Skip bang and open paren, emit the first expression, and for assert compare an i64 against zero.
//   2. For assert_eq and assert_ne, emit the second expression and compare %OoResS by ok-bit and string, or icmp the two values.
//   3. Close the paren, branch to assert_ok or assert_fail, trap on fail, and pack void plus pos plus env.

pub fn llvm_emit_builtin_assert(fn_name: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "BANG" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }

    let e1_res: List[String] = llvm_emit_expr(toks, p, n, env);
    let r1: String = list_get(e1_res, 0);
    let ty1: String = list_get(e1_res, 1);
    p = parse_int(list_get(e1_res, 2));

    let mut cur_env: List[String] = list_new();
    cur_env = list_push(cur_env, list_get(e1_res, 3));
    cur_env = list_push(cur_env, list_get(e1_res, 4));
    cur_env = list_push(cur_env, list_get(e1_res, 5));
    cur_env = list_push(cur_env, list_get(e1_res, 6));
    cur_env = list_push(cur_env, list_get(e1_res, 7));

    let mut cmp_reg = "";
    cmp_reg = r1;
    if fn_name == "assert" {
        if ty1 == "i64" {
            let reg_res: List[String] = llvm_gen_reg(cur_env);
            cmp_reg = list_get(reg_res, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_res, 1));
            cur_env = list_push(cur_env, list_get(reg_res, 2));
            cur_env = list_push(cur_env, list_get(reg_res, 3));
            cur_env = list_push(cur_env, list_get(reg_res, 4));
            cur_env = list_push(cur_env, list_get(reg_res, 5));
            println("  " + cmp_reg + " = icmp ne i64 " + r1 + ", 0");
        }
    } else {
        if p < n && field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; }
        let e2_res: List[String] = llvm_emit_expr(toks, p, n, cur_env);
        let r2: String = list_get(e2_res, 0);
        let ty2: String = list_get(e2_res, 1);
        p = parse_int(list_get(e2_res, 2));

        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(e2_res, 3));
        cur_env = list_push(cur_env, list_get(e2_res, 4));
        cur_env = list_push(cur_env, list_get(e2_res, 5));
        cur_env = list_push(cur_env, list_get(e2_res, 6));
        cur_env = list_push(cur_env, list_get(e2_res, 7));

        let reg_res: List[String] = llvm_gen_reg(cur_env);
        cmp_reg = list_get(reg_res, 0);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_res, 1));
        cur_env = list_push(cur_env, list_get(reg_res, 2));
        cur_env = list_push(cur_env, list_get(reg_res, 3));
        cur_env = list_push(cur_env, list_get(reg_res, 4));
        cur_env = list_push(cur_env, list_get(reg_res, 5));

        let mut op = "eq";
        if fn_name == "assert_ne" { op = "ne"; }
        // M161: structural Result / %OoResS compare (not icmp on aggregate)
        if ty1 == "%OoResS" || ty2 == "%OoResS" {
            let reg_ok1: List[String] = llvm_gen_reg(cur_env);
            let ok1 = list_get(reg_ok1, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_ok1, 1));
            cur_env = list_push(cur_env, list_get(reg_ok1, 2));
            cur_env = list_push(cur_env, list_get(reg_ok1, 3));
            cur_env = list_push(cur_env, list_get(reg_ok1, 4));
            cur_env = list_push(cur_env, list_get(reg_ok1, 5));
            println("  " + ok1 + " = extractvalue %OoResS " + r1 + ", 0");
            let reg_ok2: List[String] = llvm_gen_reg(cur_env);
            let ok2 = list_get(reg_ok2, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_ok2, 1));
            cur_env = list_push(cur_env, list_get(reg_ok2, 2));
            cur_env = list_push(cur_env, list_get(reg_ok2, 3));
            cur_env = list_push(cur_env, list_get(reg_ok2, 4));
            cur_env = list_push(cur_env, list_get(reg_ok2, 5));
            println("  " + ok2 + " = extractvalue %OoResS " + r2 + ", 0");
            let reg_okc: List[String] = llvm_gen_reg(cur_env);
            let okc = list_get(reg_okc, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_okc, 1));
            cur_env = list_push(cur_env, list_get(reg_okc, 2));
            cur_env = list_push(cur_env, list_get(reg_okc, 3));
            cur_env = list_push(cur_env, list_get(reg_okc, 4));
            cur_env = list_push(cur_env, list_get(reg_okc, 5));
            println("  " + okc + " = icmp eq i32 " + ok1 + ", " + ok2);
            let reg_v1: List[String] = llvm_gen_reg(cur_env);
            let v1 = list_get(reg_v1, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_v1, 1));
            cur_env = list_push(cur_env, list_get(reg_v1, 2));
            cur_env = list_push(cur_env, list_get(reg_v1, 3));
            cur_env = list_push(cur_env, list_get(reg_v1, 4));
            cur_env = list_push(cur_env, list_get(reg_v1, 5));
            println("  " + v1 + " = extractvalue %OoResS " + r1 + ", 1");
            let reg_v2: List[String] = llvm_gen_reg(cur_env);
            let v2 = list_get(reg_v2, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_v2, 1));
            cur_env = list_push(cur_env, list_get(reg_v2, 2));
            cur_env = list_push(cur_env, list_get(reg_v2, 3));
            cur_env = list_push(cur_env, list_get(reg_v2, 4));
            cur_env = list_push(cur_env, list_get(reg_v2, 5));
            println("  " + v2 + " = extractvalue %OoResS " + r2 + ", 1");
            let reg_call: List[String] = llvm_gen_reg(cur_env);
            let sc_call = list_get(reg_call, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_call, 1));
            cur_env = list_push(cur_env, list_get(reg_call, 2));
            cur_env = list_push(cur_env, list_get(reg_call, 3));
            cur_env = list_push(cur_env, list_get(reg_call, 4));
            cur_env = list_push(cur_env, list_get(reg_call, 5));
            println("  " + sc_call + " = call i32 @oo_str_eq(%OoStr " + v1 + ", %OoStr " + v2 + ")");
            let reg_sc: List[String] = llvm_gen_reg(cur_env);
            let sc = list_get(reg_sc, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_sc, 1));
            cur_env = list_push(cur_env, list_get(reg_sc, 2));
            cur_env = list_push(cur_env, list_get(reg_sc, 3));
            cur_env = list_push(cur_env, list_get(reg_sc, 4));
            cur_env = list_push(cur_env, list_get(reg_sc, 5));
            println("  " + sc + " = icmp ne i32 " + sc_call + ", 0");
            let reg_and: List[String] = llvm_gen_reg(cur_env);
            cmp_reg = list_get(reg_and, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_and, 1));
            cur_env = list_push(cur_env, list_get(reg_and, 2));
            cur_env = list_push(cur_env, list_get(reg_and, 3));
            cur_env = list_push(cur_env, list_get(reg_and, 4));
            cur_env = list_push(cur_env, list_get(reg_and, 5));
            if op == "eq" {
                println("  " + cmp_reg + " = and i1 " + okc + ", " + sc);
            } else {
                let reg_or: List[String] = llvm_gen_reg(cur_env);
                let nok = list_get(reg_or, 0);
                cur_env = list_new();
                cur_env = list_push(cur_env, list_get(reg_or, 1));
                cur_env = list_push(cur_env, list_get(reg_or, 2));
                cur_env = list_push(cur_env, list_get(reg_or, 3));
                cur_env = list_push(cur_env, list_get(reg_or, 4));
                cur_env = list_push(cur_env, list_get(reg_or, 5));
                println("  " + nok + " = xor i1 " + okc + ", true");
                let reg_ns: List[String] = llvm_gen_reg(cur_env);
                let nsc = list_get(reg_ns, 0);
                cur_env = list_new();
                cur_env = list_push(cur_env, list_get(reg_ns, 1));
                cur_env = list_push(cur_env, list_get(reg_ns, 2));
                cur_env = list_push(cur_env, list_get(reg_ns, 3));
                cur_env = list_push(cur_env, list_get(reg_ns, 4));
                cur_env = list_push(cur_env, list_get(reg_ns, 5));
                println("  " + nsc + " = xor i1 " + sc + ", true");
                let reg_or2: List[String] = llvm_gen_reg(cur_env);
                cmp_reg = list_get(reg_or2, 0);
                cur_env = list_new();
                cur_env = list_push(cur_env, list_get(reg_or2, 1));
                cur_env = list_push(cur_env, list_get(reg_or2, 2));
                cur_env = list_push(cur_env, list_get(reg_or2, 3));
                cur_env = list_push(cur_env, list_get(reg_or2, 4));
                cur_env = list_push(cur_env, list_get(reg_or2, 5));
                println("  " + cmp_reg + " = or i1 " + nok + ", " + nsc);
            }
        } else if ty1 == "%OoStr" || ty2 == "%OoStr" {
            let reg_call: List[String] = llvm_gen_reg(cur_env);
            let seq = list_get(reg_call, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_call, 1));
            cur_env = list_push(cur_env, list_get(reg_call, 2));
            cur_env = list_push(cur_env, list_get(reg_call, 3));
            cur_env = list_push(cur_env, list_get(reg_call, 4));
            cur_env = list_push(cur_env, list_get(reg_call, 5));
            println("  " + seq + " = call i32 @oo_str_eq(%OoStr " + r1 + ", %OoStr " + r2 + ")");
            let reg_c: List[String] = llvm_gen_reg(cur_env);
            cmp_reg = list_get(reg_c, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_c, 1));
            cur_env = list_push(cur_env, list_get(reg_c, 2));
            cur_env = list_push(cur_env, list_get(reg_c, 3));
            cur_env = list_push(cur_env, list_get(reg_c, 4));
            cur_env = list_push(cur_env, list_get(reg_c, 5));
            if op == "eq" {
                println("  " + cmp_reg + " = icmp ne i32 " + seq + ", 0");
            } else {
                println("  " + cmp_reg + " = icmp eq i32 " + seq + ", 0");
            }
        } else if ty1 == "double" || ty2 == "double" {
            let mut f_op = "oeq";
            if op == "ne" { f_op = "one"; }
            println("  " + cmp_reg + " = fcmp " + f_op + " double " + r1 + ", " + r2);
        } else {
            println("  " + cmp_reg + " = icmp " + op + " " + ty1 + " " + r1 + ", " + r2);
        }
    }

    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }

    let lbl_ok_res: List[String] = llvm_gen_label("assert_ok", cur_env);
    let lbl_ok = list_get(lbl_ok_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(lbl_ok_res, 1));
    cur_env = list_push(cur_env, list_get(lbl_ok_res, 2));
    cur_env = list_push(cur_env, list_get(lbl_ok_res, 3));
    cur_env = list_push(cur_env, list_get(lbl_ok_res, 4));
    cur_env = list_push(cur_env, list_get(lbl_ok_res, 5));

    let lbl_fail_res: List[String] = llvm_gen_label("assert_fail", cur_env);
    let lbl_fail = list_get(lbl_fail_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(lbl_fail_res, 1));
    cur_env = list_push(cur_env, list_get(lbl_fail_res, 2));
    cur_env = list_push(cur_env, list_get(lbl_fail_res, 3));
    cur_env = list_push(cur_env, list_get(lbl_fail_res, 4));
    cur_env = list_push(cur_env, list_get(lbl_fail_res, 5));

    println("  br i1 " + cmp_reg + ", label %" + lbl_ok + ", label %" + lbl_fail);
    println(lbl_fail + ":");
    println("  call void @llvm.trap()");
    println("  unreachable");
    println(lbl_ok + ":");

    let mut out: List[String] = list_new();
    out = list_push(out, "");
    out = list_push(out, "void");
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}

