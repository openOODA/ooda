// # Lower list_* calls to LLVM sret/byval
//
// Logline: Emits list_new, list_push, list_len, and list_get with System V sret/byval for 24-byte aggregates and returns treg, lty, and the five env slots.
//
// Setup: llvm_gen_reg exists; lty is %OoIList or %OoSList; env is the five-slot LLVM emit env; args_vals and args_tys are already lowered.
//
// Beats:
//   1. list_new allocas an sret slot, calls the ctor, and loads the aggregate.
//   2. list_push stores the list byval, allocas sret, calls with i64 or %OoStr, and loads.
//   3. Else store the list byval; list_len calls i64 and list_get calls lty with the index.

import "llvm_emit_list_set.oo";

// Returns [treg, lty, env0..env4]
pub fn llvm_emit_list_call(
    fn_name: String,
    call_name: String,
    lty: String,
    args_vals: List[String],
    args_tys: List[String],
    env: List[String]
) -> List[String] {
    let mut cur_env: List[String] = env;
    let mut treg: String = "";
    let nty: Int = list_len(args_tys);
    let mut a0: String = "";
    if nty > 0 { a0 = list_get(args_tys, 0); }
    if fn_name == "list_new" {
        if !llvm_ty_is_list(lty) { lty = "%OoSList"; }
        if lty == "%OoIList" { call_name = "oo_ilist_new"; }
        if lty == "%OoSList" { call_name = "oo_slist_new"; }
        if lty == "%OoFList" { call_name = "oo_flist_new"; }
        if lty == "%OoLL_I" { call_name = "oo_ll_I_new"; }
        if lty == "%OoLL_S" { call_name = "oo_ll_S_new"; }
        if lty == "%OoLL_F" { call_name = "oo_ll_F_new"; }
        if llvm_ty_is_olist(lty) { call_name = "oo_l_" + str_slice(lty, 5, chars_len(lty)) + "_new"; }
    }
    if fn_name == "list_push" {
        if a0 == "%OoLL_I" { lty = "%OoLL_I"; call_name = "oo_ll_I_push"; }
        else if a0 == "%OoLL_S" { lty = "%OoLL_S"; call_name = "oo_ll_S_push"; }
        else if a0 == "%OoLL_F" { lty = "%OoLL_F"; call_name = "oo_ll_F_push"; }
        else if a0 == "%OoFList" { lty = "%OoFList"; call_name = "oo_flist_push"; }
        else if a0 == "%OoSList" { lty = "%OoSList"; call_name = "oo_slist_push"; }
        else if llvm_ty_is_olist(a0) {
            lty = a0;
            call_name = "oo_l_" + str_slice(a0, 5, chars_len(a0)) + "_push";
        } else { lty = "%OoIList"; call_name = "oo_ilist_push"; }
    }
    if fn_name == "list_set" {
        if a0 == "%OoSList" {
            lty = "%OoSList";
            call_name = "oo_slist_set";
        } else if a0 == "%OoFList" {
            lty = "%OoFList";
            call_name = "oo_flist_set";
        } else if a0 == "%OoIList" || a0 == "" {
            lty = "%OoIList";
            call_name = "oo_ilist_set";
        } else if a0 == "%OoLL_I" {
            lty = "%OoLL_I";
            call_name = "oo_ll_I_set";
        } else if llvm_ty_is_olist(a0) {
            lty = a0;
            call_name = "oo_l_" + str_slice(a0, 5, chars_len(a0)) + "_set";
        } else {
            println("ERR\tllvm_emit\tlist_set residual");
            process_exit(1);
        }
    }
    if fn_name == "list_len" {
        lty = "i64";
        call_name = "oo_ilist_len";
        if a0 == "%OoSList" { call_name = "oo_slist_len"; }
        if a0 == "%OoFList" { call_name = "oo_flist_len"; }
        if a0 == "%OoLL_I" { call_name = "oo_ll_I_len"; }
        if a0 == "%OoLL_S" { call_name = "oo_ll_S_len"; }
        if a0 == "%OoLL_F" { call_name = "oo_ll_F_len"; }
        if llvm_ty_is_olist(a0) { call_name = "oo_l_" + str_slice(a0, 5, chars_len(a0)) + "_len"; }
    }
    if fn_name == "list_get" {
        if a0 == "%OoLL_I" { lty = "%OoIList"; call_name = "oo_ll_I_get"; }
        else if a0 == "%OoLL_S" { lty = "%OoSList"; call_name = "oo_ll_S_get"; }
        else if a0 == "%OoLL_F" { lty = "%OoFList"; call_name = "oo_ll_F_get"; }
        else if a0 == "%OoFList" { lty = "double"; call_name = "oo_flist_get"; }
        else if a0 == "%OoSList" { lty = "%OoStr"; call_name = "oo_slist_get"; }
        else if llvm_ty_is_olist(a0) {
            lty = "%struct." + str_slice(a0, 5, chars_len(a0));
            call_name = "oo_l_" + str_slice(a0, 5, chars_len(a0)) + "_get";
        } else { lty = "i64"; call_name = "oo_ilist_get"; }
    }
    if fn_name == "list_new" {
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let rnum: String = list_get(reg_res, 0);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_res, 1));
        cur_env = list_push(cur_env, list_get(reg_res, 2));
        cur_env = list_push(cur_env, list_get(reg_res, 3));
        cur_env = list_push(cur_env, list_get(reg_res, 4));
        cur_env = list_push(cur_env, list_get(reg_res, 5));
        let slot: String = rnum + ".lslot";
        println("  " + slot + " = alloca " + lty + ", align 8");
        println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + slot + ")");
        let reg_ld: List[String] = llvm_gen_reg(cur_env);
        treg = list_get(reg_ld, 0);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_ld, 1));
        cur_env = list_push(cur_env, list_get(reg_ld, 2));
        cur_env = list_push(cur_env, list_get(reg_ld, 3));
        cur_env = list_push(cur_env, list_get(reg_ld, 4));
        cur_env = list_push(cur_env, list_get(reg_ld, 5));
        println("  " + treg + " = load " + lty + ", " + lty + "* " + slot + ", align 8");
    } else if fn_name == "list_push" {
        let list_val = list_get(args_vals, 0);
        let elem_val = list_get(args_vals, 1);
        let reg_in: List[String] = llvm_gen_reg(cur_env);
        let in_slot: String = list_get(reg_in, 0) + ".byv";
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_in, 1));
        cur_env = list_push(cur_env, list_get(reg_in, 2));
        cur_env = list_push(cur_env, list_get(reg_in, 3));
        cur_env = list_push(cur_env, list_get(reg_in, 4));
        cur_env = list_push(cur_env, list_get(reg_in, 5));
        println("  " + in_slot + " = alloca " + lty + ", align 8");
        println("  store " + lty + " " + list_val + ", " + lty + "* " + in_slot + ", align 8");
        let reg_out: List[String] = llvm_gen_reg(cur_env);
        let out_slot: String = list_get(reg_out, 0) + ".sret";
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_out, 1));
        cur_env = list_push(cur_env, list_get(reg_out, 2));
        cur_env = list_push(cur_env, list_get(reg_out, 3));
        cur_env = list_push(cur_env, list_get(reg_out, 4));
        cur_env = list_push(cur_env, list_get(reg_out, 5));
        println("  " + out_slot + " = alloca " + lty + ", align 8");
        let mut ety: String = "i64";
        if lty == "%OoFList" { ety = "double"; }
        if lty == "%OoSList" { ety = "%OoStr"; }
        if lty == "%OoLL_I" { ety = "%OoIList"; }
        if lty == "%OoLL_S" { ety = "%OoSList"; }
        if lty == "%OoLL_F" { ety = "%OoFList"; }
        if llvm_ty_is_olist(lty) { ety = "%struct." + str_slice(lty, 5, chars_len(lty)); }
        if ety == "%OoIList" || ety == "%OoSList" || ety == "%OoFList" || (chars_len(ety) >= 8 && str_slice(ety, 0, 8) == "%struct.") {
            let reg_el: List[String] = llvm_gen_reg(cur_env);
            let el_slot: String = list_get(reg_el, 0) + ".elv";
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(reg_el, 1));
            cur_env = list_push(cur_env, list_get(reg_el, 2));
            cur_env = list_push(cur_env, list_get(reg_el, 3));
            cur_env = list_push(cur_env, list_get(reg_el, 4));
            cur_env = list_push(cur_env, list_get(reg_el, 5));
            println("  " + el_slot + " = alloca " + ety + ", align 8");
            println("  store " + ety + " " + elem_val + ", " + ety + "* " + el_slot + ", align 8");
            println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + out_slot + ", " + lty + "* byval(" + lty + ") " + in_slot + ", " + ety + "* byval(" + ety + ") " + el_slot + ")");
        } else {
            println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + out_slot + ", " + lty + "* byval(" + lty + ") " + in_slot + ", " + ety + " " + elem_val + ")");
        }
        let reg_ld: List[String] = llvm_gen_reg(cur_env);
        treg = list_get(reg_ld, 0);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_ld, 1));
        cur_env = list_push(cur_env, list_get(reg_ld, 2));
        cur_env = list_push(cur_env, list_get(reg_ld, 3));
        cur_env = list_push(cur_env, list_get(reg_ld, 4));
        cur_env = list_push(cur_env, list_get(reg_ld, 5));
        println("  " + treg + " = load " + lty + ", " + lty + "* " + out_slot + ", align 8");
    } else if fn_name == "list_set" {
        let packed: List[String] = llvm_emit_list_set(call_name, lty, args_vals, cur_env);
        treg = list_get(packed, 0);
        lty = list_get(packed, 1);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(packed, 2));
        cur_env = list_push(cur_env, list_get(packed, 3));
        cur_env = list_push(cur_env, list_get(packed, 4));
        cur_env = list_push(cur_env, list_get(packed, 5));
        cur_env = list_push(cur_env, list_get(packed, 6));
    } else {
        let list_val = list_get(args_vals, 0);
        let list_ty = list_get(args_tys, 0);
        let reg_in: List[String] = llvm_gen_reg(cur_env);
        let in_slot: String = list_get(reg_in, 0) + ".byv";
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_in, 1));
        cur_env = list_push(cur_env, list_get(reg_in, 2));
        cur_env = list_push(cur_env, list_get(reg_in, 3));
        cur_env = list_push(cur_env, list_get(reg_in, 4));
        cur_env = list_push(cur_env, list_get(reg_in, 5));
        println("  " + in_slot + " = alloca " + list_ty + ", align 8");
        println("  store " + list_ty + " " + list_val + ", " + list_ty + "* " + in_slot + ", align 8");
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        treg = list_get(reg_res, 0);
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(reg_res, 1));
        cur_env = list_push(cur_env, list_get(reg_res, 2));
        cur_env = list_push(cur_env, list_get(reg_res, 3));
        cur_env = list_push(cur_env, list_get(reg_res, 4));
        cur_env = list_push(cur_env, list_get(reg_res, 5));
        if fn_name == "list_len" {
            println("  " + treg + " = call i64 @" + call_name + "(" + list_ty + "* byval(" + list_ty + ") " + in_slot + ")");
        } else if lty == "i64" || lty == "double" || lty == "%OoStr" {
            let idx = list_get(args_vals, 1);
            println("  " + treg + " = call " + lty + " @" + call_name + "(" + list_ty + "* byval(" + list_ty + ") " + in_slot + ", i64 " + idx + ")");
        } else {
            let idx = list_get(args_vals, 1);
            let os: String = treg + ".sret";
            println("  " + os + " = alloca " + lty + ", align 8");
            println("  call void @" + call_name + "(" + lty + "* sret(" + lty + ") " + os + ", " + list_ty + "* byval(" + list_ty + ") " + in_slot + ", i64 " + idx + ")");
            println("  " + treg + " = load " + lty + ", " + lty + "* " + os + ", align 8");
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, treg);
    out = list_push(out, lty);
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
