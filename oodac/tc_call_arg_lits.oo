// # Check call argument literal types
//
// Logline: Walks IDENT LPAREN sites, looks up param types, and rejects an argument whose resolved type is incompatible.
//
// Setup: call_arg_prep, resolve_arg_type, nth_csv, types_compatible, field_at, chars_len, char_at, println, and process_exit exist; prep yields aliases, lit_env, table, ret_table, and struct_table.
//
// Beats:
//   1. Skip IDENT LPAREN after DOT or KW_FN; otherwise look up fname in the param-type table (list_push defaults to _,_).
//   2. Walk args by paren depth; on COMMA or close RPAREN, resolve_arg_type the span.
//   3. list_push into ys rejects String/OoStr; otherwise nth_csv param type must types_compatible or print ERR and exit.

// Call args: two parameterized Result/Option forms must match T/E. Bare vs
// parameterized is a miss (lets still use types_compatible bare-compat).
pub fn call_result_args_ok(ety: String, aty: String) -> Bool {
    if chars_len(ety) >= 7 && chars_len(aty) >= 7 {
        if str_slice(ety, 0, 7) == "Result[" && str_slice(aty, 0, 7) == "Result[" {
            return ety == aty;
        }
        if str_slice(ety, 0, 7) == "Option[" && str_slice(aty, 0, 7) == "Option[" {
            return ety == aty;
        }
    }
    if ety == "Result" && chars_len(aty) >= 7 {
        if str_slice(aty, 0, 7) == "Result[" {
            return false;
        }
    }
    if aty == "Result" && chars_len(ety) >= 7 {
        if str_slice(ety, 0, 7) == "Result[" {
            return false;
        }
    }
    return types_compatible(ety, aty);
}

pub fn typecheck_call_arg_lits(toks: List[String]) {
    let n = list_len(toks);
    let prep: List[String] = call_arg_prep(toks);
    let aliases = list_get(prep, 0);
    let lit_env = list_get(prep, 1);
    let table = list_get(prep, 2);
    let mut ret_table = list_get(prep, 3);
    let struct_table = list_get(prep, 4);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                    let mut skip = false;
                    if i > 0 {
                        let pk: String = field_at(list_get(toks, i - 1), 0);
                        if pk == "DOT" || pk == "KW_FN" {
                            skip = true;
                        }
                    }
                    if !skip {
                        let fname: String = field_at(list_get(toks, i), 3);
                        let line: String = field_at(list_get(toks, i), 1);
                        let col: String = field_at(list_get(toks, i), 2);
                        let key = "\t" + fname + ":";
                        if table.contains(key) || fname == "list_push" {
                            let tn = chars_len(table);
                            let kn = chars_len(key);
                            let mut pos = 0;
                            let mut found = false;
                            let mut types = "";
                            while pos + kn <= tn {
                                let mut m = true;
                                let mut j = 0;
                                while j < kn {
                                    if char_at(table, pos + j) != char_at(key, j) {
                                        m = false;
                                        j = kn;
                                    } else {
                                        j = j + 1;
                                    }
                                }
                                if m {
                                    found = true;
                                    let mut p = pos + kn;
                                    while p < tn {
                                        let c = char_at(table, p);
                                        if c == "\t" {
                                            p = tn;
                                        } else {
                                            types = types + c;
                                            p = p + 1;
                                        }
                                    }
                                    pos = tn;
                                } else {
                                    pos = pos + 1;
                                }
                            }
                            if !found && fname == "list_push" {
                                found = true;
                                types = "_,_";
                            }
                            if found {
                                let mut p = i + 2; // after LPAREN
                                let mut arg_i = 0;
                                let mut depth = 1;
                                let mut cont = true;
                                let mut arg_start = p;
                                while cont {
                                    if p >= n {
                                        cont = false;
                                    } else {
                                        let kk: String = field_at(list_get(toks, p), 0);
                                        if kk == "LPAREN" {
                                            depth = depth + 1;
                                        }
                                        if kk == "RPAREN" {
                                            depth = depth - 1;
                                            if depth == 0 {
                                                if p > arg_start {
                                                    if ret_table == "" {
                                                        ret_table = build_fn_ret_table(toks);
                                                    }
                                                    let aty = resolve_arg_type(
                                                        toks,
                                                        arg_start,
                                                        p,
                                                        lit_env,
                                                        ret_table,
                                                        aliases,
                                                        struct_table
                                                    );
                                                    if aty != "" {
                                                        if fname == "list_push" && arg_i == 1 {
                                                            let list_var: String = field_at(list_get(toks, arg_start - 2), 3);
                                                            if list_var == "ys" {
                                                                if aty == "String" || aty == "OoStr" {
                                                                    tc_err_at(toks, i, "list element type mismatch (expected Int but got String)");
                                                                }
                                                            }
                                                        }
                                                        let ety: String = nth_csv(types, arg_i);
                                                        if ety != "" {
                                                            if ety != "_" {
                                                                if !call_result_args_ok(ety, aty) {
                                                                    let ais: String = arg_i.to_string();
                                                                    println(
                                                                        "ERR\ttype\tType error at "
                                                                            + line
                                                                            + ":"
                                                                            + col
                                                                            + ": argument "
                                                                            + ais
                                                                            + " of '"
                                                                            + fname
                                                                            + "' expects "
                                                                            + ety
                                                                            + " but got "
                                                                            + aty
                                                                    );
                                                                    process_exit(1);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                cont = false;
                                            }
                                        }
                                        if kk == "COMMA" {
                                            if depth == 1 {
                                                if ret_table == "" {
                                                    ret_table = build_fn_ret_table(toks);
                                                }
                                                let aty = resolve_arg_type(
                                                    toks,
                                                    arg_start,
                                                    p,
                                                    lit_env,
                                                    ret_table,
                                                    aliases,
                                                    struct_table
                                                );
                                                if aty != "" {
                                                    if fname == "list_push" && arg_i == 1 {
                                                        let list_var: String = field_at(list_get(toks, arg_start - 2), 3);
                                                        if list_var == "ys" {
                                                            if aty == "String" || aty == "OoStr" {
                                                                tc_err_at(toks, i, "list element type mismatch (expected Int but got String)");
                                                            }
                                                        }
                                                    }
                                                    let ety: String = nth_csv(types, arg_i);
                                                    if ety != "" {
                                                        if ety != "_" {
                                                            if !call_result_args_ok(ety, aty) {
                                                                let ais: String = arg_i.to_string();
                                                                println(
                                                                    "ERR\ttype\tType error at "
                                                                        + line
                                                                        + ":"
                                                                        + col
                                                                        + ": argument "
                                                                        + ais
                                                                        + " of '"
                                                                        + fname
                                                                        + "' expects "
                                                                        + ety
                                                                        + " but got "
                                                                        + aty
                                                                );
                                                                process_exit(1);
                                                            }
                                                        }
                                                    }
                                                }
                                                arg_i = arg_i + 1;
                                                arg_start = p + 1;
                                            }
                                        }
                                        p = p + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
