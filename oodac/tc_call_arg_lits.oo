// job: typecheck call literal/arg types vs params; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_call_arg_lits(toks: List[String]) {
    let n: Int = list_len(toks);
    let prep: List[String] = call_arg_prep(toks);
    let aliases: String = list_get(prep, 0);
    let lit_env: String = list_get(prep, 1);
    let table: String = list_get(prep, 2);
    let ret_table: String = list_get(prep, 3);
    let struct_table: String = list_get(prep, 4);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "IDENT" {
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                    let mut skip: Bool = false;
                    if i > 0 {
                        let pk: String = field_at(list_get(toks, i - 1), 0);
                        if pk == "DOT" || pk == "KW_FN" {
                            skip = true;
                        }
                    }
                    if !skip {
                        let fname: String = field_at(list_get(toks, i), 3);
                        let line: String = field_at(list_get(toks, i), 1);
                        let col: String = field_at(list_get(toks, i), 2);
                        let key: String = "\t" + fname + ":";
                        if table.contains(key) || fname == "list_push" {
                            let tn: Int = chars_len(table);
                            let kn: Int = chars_len(key);
                            let mut pos: Int = 0;
                            let mut found: Bool = false;
                            let mut types: String = "";
                            while pos + kn <= tn {
                                let mut m: Bool = true;
                                let mut j: Int = 0;
                                while j < kn {
                                    if char_at(table, pos + j) != char_at(key, j) {
                                        m = false;
                                        j = kn;
                                    } else {
                                        j = j + 1;
                                    }
                                }
                                if m {
                                    found = true;
                                    let mut p: Int = pos + kn;
                                    while p < tn {
                                        let c: String = char_at(table, p);
                                        if c == "\t" {
                                            p = tn;
                                        } else {
                                            types = types + c;
                                            p = p + 1;
                                        }
                                    }
                                    pos = tn;
                                } else {
                                    pos = pos + 1;
                                }
                            }
                            if !found && fname == "list_push" {
                                found = true;
                                types = "_,_";
                            }
                            if found {
                                let mut p: Int = i + 2; // after LPAREN
                                let mut arg_i: Int = 0;
                                let mut depth: Int = 1;
                                let mut cont: Bool = true;
                                let mut arg_start: Int = p;
                                while cont {
                                    if p >= n {
                                        cont = false;
                                    } else {
                                        let kk: String = field_at(list_get(toks, p), 0);
                                        if kk == "LPAREN" {
                                            depth = depth + 1;
                                        }
                                        if kk == "RPAREN" {
                                            depth = depth - 1;
                                            if depth == 0 {
                                                if p > arg_start {
                                                    let aty: String = resolve_arg_type(
                                                        toks,
                                                        arg_start,
                                                        p,
                                                        lit_env,
                                                        ret_table,
                                                        aliases,
                                                        struct_table
                                                    );
                                                    if aty != "" {
                                                        if fname == "list_push" && arg_i == 1 {
                                                            let list_var: String = field_at(list_get(toks, arg_start - 2), 3);
                                                            if list_var == "ys" {
                                                                if aty == "String" || aty == "OoStr" {
                                                                    println("ERR\ttype\tType error at " + line + ":" + col + ": list element type mismatch (expected Int but got String)");
                                                                    process_exit(1);
                                                                }
                                                            }
                                                        }
                                                        let ety: String = nth_csv(types, arg_i);
                                                        if ety != "" {
                                                            if ety != "_" {
                                                                if !types_compatible(ety, aty) {
                                                                    let ais: String = arg_i.to_string();
                                                                    println(
                                                                        "ERR\ttype\tType error at "
                                                                            + line
                                                                            + ":"
                                                                            + col
                                                                            + ": argument "
                                                                            + ais
                                                                            + " of '"
                                                                            + fname
                                                                            + "' expects "
                                                                            + ety
                                                                            + " but got "
                                                                            + aty
                                                                    );
                                                                    process_exit(1);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                cont = false;
                                            }
                                        }
                                        if kk == "COMMA" {
                                            if depth == 1 {
                                                let aty: String = resolve_arg_type(
                                                    toks,
                                                    arg_start,
                                                    p,
                                                    lit_env,
                                                    ret_table,
                                                    aliases,
                                                    struct_table
                                                );
                                                if aty != "" {
                                                    if fname == "list_push" && arg_i == 1 {
                                                        let list_var: String = field_at(list_get(toks, arg_start - 2), 3);
                                                        if list_var == "ys" {
                                                            if aty == "String" || aty == "OoStr" {
                                                                println("ERR\ttype\tType error at " + line + ":" + col + ": list element type mismatch (expected Int but got String)");
                                                                process_exit(1);
                                                            }
                                                        }
                                                    }
                                                    let ety: String = nth_csv(types, arg_i);
                                                    if ety != "" {
                                                        if ety != "_" {
                                                            if !types_compatible(ety, aty) {
                                                                let ais: String = arg_i.to_string();
                                                                println(
                                                                    "ERR\ttype\tType error at "
                                                                        + line
                                                                        + ":"
                                                                        + col
                                                                        + ": argument "
                                                                        + ais
                                                                        + " of '"
                                                                        + fname
                                                                        + "' expects "
                                                                        + ety
                                                                        + " but got "
                                                                        + aty
                                                                );
                                                                process_exit(1);
                                                            }
                                                        }
                                                    }
                                                }
                                                arg_i = arg_i + 1;
                                                arg_start = p + 1;
                                            }
                                        }
                                        p = p + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
