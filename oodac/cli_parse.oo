// # Parse oodac CLI argv
//
// Logline: Walks argv for backend, flags, and positionals, then packs cmd, path, out, backend, and four flag slots or exits.
//
// Setup: path_exists, file_size, shell_sq, sys_exec, and process_exit exist; main.oo imports this file and must keep that barrel.
//
// Beats:
//   1. Scan flags then cmd, path, and out; an empty cmd defaults to llvm build of test.oo.
//   2. Require a readable path under 64KiB or exit.
//   3. Pack eight slots: cmd, path, out, backend, json-errors, json, unused, runtime-cap.

pub fn parse_cli_argv(fs: &FsCap, sys: &SysCap, args: List[String]) -> List[String] {
    // Parse: oodac [--backend c|wasm|llvm] <cmd> <file> [out]
    if list_len(args) < 1 {
        println("oodac: usage: [--backend c|wasm|llvm] tokens|ast|check|build|run|emit-c|emit-wasm|emit-llvm|outline|reflect <file>");
        process_exit(2);
    }
    let mut cmd: String = "";
    let mut path: String = "";
    let mut out_arg: String = "";
    let mut backend: String = "c";
    let mut json_errors: Bool = false;
    let mut is_json: Bool = false;
    let mut runtime_cap_required: Bool = false;
    let mut npos: Int = 0;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--backend" {
            if i + 1 >= list_len(args) { println("ERR\tbackend\tmissing value"); process_exit(2); }
            let bv: String = list_get(args, i + 1);
            if bv != "c" && bv != "wasm" && bv != "llvm" { println("ERR\tbackend\t" + bv + " residual"); process_exit(2); }
            backend = bv;
            i = i + 2;
        } else if a == "--json-errors" || a == "-json" { json_errors = true; i = i + 1; }
        else if a == "--json" { is_json = true; i = i + 1; }
        else if a == "--runtime-cap-required" { runtime_cap_required = true; i = i + 1; }
        else {
            if npos == 0 { cmd = a; }
            else if npos == 1 { path = a; }
            else if npos == 2 { out_arg = a; }
            else { println("oodac: too many arguments"); process_exit(2); }
            npos = npos + 1;
            i = i + 1;
        }
    }
    if cmd == "" {
        cmd = "build";
        path = "test.oo";
        out_arg = "test.bin";
        backend = "llvm";
    }
    if path == "" {
        println("oodac: missing file argument");
        process_exit(2);
    }
    if !path_exists(fs, path) {
        println("ERR\t" + cmd + "\tunreadable file: " + path);
        process_exit(2);
    }
    // H6: per-file size gate before read (lex is O(n²) char_at — 64KiB max)
    let fsz: Int = file_size(fs, path);
    if fsz > 65536 {
        println("ERR\tload\tsource exceeds 64KiB per-file limit");
        process_exit(1);
    }

    let mut packed: List[String] = list_new();
    packed = list_push(packed, cmd);
    packed = list_push(packed, path);
    packed = list_push(packed, out_arg);
    packed = list_push(packed, backend);
    let mut f_je: String = "0";
    if json_errors { f_je = "1"; }
    let mut f_js: String = "0";
    if is_json { f_js = "1"; }
    let mut f_rc: String = "0";
    if runtime_cap_required { f_rc = "1"; }
    packed = list_push(packed, f_je);
    packed = list_push(packed, f_js);
    packed = list_push(packed, "0");
    packed = list_push(packed, f_rc);
    return packed;
}
