// # Parse integer text for refinements
//
// Logline: Turn signed digit text into an Int for refinement bounds.
//
// Setup: chars_len and char_at exist; refine walks token lexemes and calls parse_int.
//
// Beats:
//   1. A leading "-" sets sign to -1 and starts at index 1.
//   2. Each digit 0-9 folds into v as v*10+n through the if/else ladder.
//   3. Return v * sign.

pub fn parse_int(s: String) -> Int {
    let n = chars_len(s);
    let mut v = 0;
    let mut i = 0;
    let mut sign = 1;
    if n > 0 {
        if char_at(s, 0) == "-" {
            sign = -1;
            i = 1;
        }
    }
    while i < n {
        let c = char_at(s, i);
        if c == "0" { v = v * 10 + 0; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v * sign;
}
