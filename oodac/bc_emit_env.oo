// job: Local variable slot environment and label generator for Interpreter Bytecode Emitter
// stage: emit

pub fn bc_env_new() -> String {
    return "";
}

pub fn bc_env_lookup(env: String, name: String) -> Int {
    let n = chars_len(env);
    if n == 0 {
        return -1;
    }
    let mut slot = 0;
    let mut start_pos = 0;
    let mut k = 0;
    while k <= n {
        let is_end = (k == n);
        let mut is_tab: Bool = false;
        if !is_end {
            if char_at(env, k) == "\t" {
                is_tab = true;
            }
        }
        if is_end || is_tab {
            let item = str_slice(env, start_pos, k);
            if item == name {
                return slot;
            }
            slot = slot + 1;
            start_pos = k + 1;
        }
        k = k + 1;
    }
    return -1;
}

pub fn bc_env_add_var(env: String, name: String) -> List[String] {
    let existing = bc_env_lookup(env, name);
    let mut res: List[String] = list_new();
    if existing >= 0 {
        res = list_push(res, existing.to_string());
        res = list_push(res, env);
        return res;
    }
    let count = bc_env_count(env);
    let mut new_env = name;
    if chars_len(env) > 0 {
        new_env = env + "\t" + name;
    }
    res = list_push(res, count.to_string());
    res = list_push(res, new_env);
    return res;
}

pub fn bc_env_count(env: String) -> Int {
    let n = chars_len(env);
    if n == 0 {
        return 0;
    }
    let mut count = 1;
    let mut k = 0;
    while k < n {
        if char_at(env, k) == "\t" {
            count = count + 1;
        }
        k = k + 1;
    }
    return count;
}

pub fn bc_next_label(counter: Int) -> List[String] {
    let mut res: List[String] = list_new();
    res = list_push(res, "L" + counter.to_string());
    let next_c = counter + 1;
    res = list_push(res, next_c.to_string());
    return res;
}

pub fn bc_bin_opcode(k: String) -> String {
    if k == "PLUS" { return "ADD"; }
    if k == "MINUS" { return "SUB"; }
    if k == "STAR" { return "MUL"; }
    if k == "SLASH" { return "DIV"; }
    if k == "PERCENT" { return "MOD"; }
    if k == "EQEQ" { return "EQ"; }
    if k == "NEQ" { return "NE"; }
    if k == "LT" { return "LT"; }
    if k == "LTE" { return "LE"; }
    if k == "GT" { return "GT"; }
    if k == "GTE" { return "GE"; }
    if k == "ANDAND" { return "AND"; }
    if k == "OROR" { return "OR"; }
    // M166 Int bitops (VM eval path)
    if k == "AMP" { return "BAND"; }
    if k == "PIPE" { return "BOR"; }
    if k == "CARET" || k == "BXOR" { return "BXOR"; }
    if k == "LSHIFT" { return "SHL"; }
    if k == "RSHIFT" { return "SHR"; }
    return "ADD";
}
