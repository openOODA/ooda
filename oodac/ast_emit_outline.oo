// job: ast outline emission
// in: source toks; out: printed outline

pub fn ast_emit_outline(src: String) {
    // PROBE: empty source must fail-closed (no silent agent OK)
    if chars_len(src) == 0 {
        println("ERR\toutline\tempty source");
        process_exit(1);
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    // Only EOF / no real tokens → fail-closed
    if n <= 1 {
        println("ERR\toutline\tempty source");
        process_exit(1);
    }
    let mut pos = 0;
    let mut saw_pub = false;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" {
            saw_pub = true;
            pos = emit_fn_outline(toks, pos, n, true);
        } else if k == "KW_FN" {
            pos = emit_fn_outline(toks, pos, n, false);
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            if pos < n { if field_at(list_get(toks, pos), 0) == "IDENT" { pos = pos + 1; } }
            if pos < n { if field_at(list_get(toks, pos), 0) == "LBRACE" { pos = skip_balanced(toks, pos); } }
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            // skip over top-level garbage silently for outline
            pos = pos + 1;
        }
    }
    // No pub fn → empty agent surface is fail-closed (parse-only outline claims API list)
    if !saw_pub {
        println("ERR\toutline\tno pub fn");
        process_exit(1);
    }
}

pub fn emit_fn_outline(toks: List[String], pos0: Int, n: Int, is_pub: Bool) -> Int {
    let mut pos = pos0;
    if field_at(list_get(toks, pos), 0) == "KW_PUB" {
        pos = pos + 1;
    }
    if field_at(list_get(toks, pos), 0) != "KW_FN" {
        return pos;
    }
    pos = pos + 1;
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1; // name
    pos = pos + 1; // (
    let mut params = "";
    let mut caps = "";
    let mut first = true;
    while pos < n {
        let pk: String = field_at(list_get(toks, pos), 0);
        if pk == "RPAREN" {
            pos = pos + 1;
            break;
        }
        if pk == "COMMA" {
            pos = pos + 1;
        } else if pk == "AMP" {
            pos = pos + 1;
            let pname: String = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                pos = pos + 1;
                let mut pty: String = field_at(list_get(toks, pos), 3);
                if pty == "FsCap" || pty == "NetCap" || pty == "SysCap" || pty == "EnvCap" || pty == "TimeCap" || pty == "RandCap" || pty == "AllocCap" || pty == "GpuCap" || pty == "ThreadCap" {
                    if caps != "" { caps = caps + ","; }
                    caps = caps + pty;
                }
                pos = pos + 1;
                while pos < n {
                    let nk: String = field_at(list_get(toks, pos), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    pos = pos + 1;
                }
            }
        } else if pk == "IDENT" {
            let pname: String = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            let mut pty = "";
            if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                pos = pos + 1;
                if pos < n && field_at(list_get(toks, pos), 0) == "AMP" {
                    pty = "&";
                    pos = pos + 1;
                }
                while pos < n {
                    let nk: String = field_at(list_get(toks, pos), 0);
                    if nk == "COMMA" || nk == "RPAREN" { break; }
                    pty = pty + field_at(list_get(toks, pos), 3);
                    pos = pos + 1;
                }
            }
            if pty == "&FsCap" || pty == "FsCap" || pty == "&NetCap" || pty == "NetCap" || pty == "&SysCap" || pty == "SysCap" || pty == "&EnvCap" || pty == "EnvCap" || pty == "&TimeCap" || pty == "TimeCap" || pty == "&RandCap" || pty == "RandCap" || pty == "&AllocCap" || pty == "AllocCap" || pty == "&GpuCap" || pty == "GpuCap" || pty == "&ThreadCap" || pty == "ThreadCap" || pty == "ThreadCap" {
                let mut cname = pty;
                if str_slice(cname, 0, 1) == "&" { cname = str_slice(cname, 1, chars_len(cname)); }
                if caps != "" { caps = caps + ","; }
                caps = caps + cname;
            }
            if !first { params = params + ", "; }
            first = false;
            params = params + pname;
            if pty != "" { params = params + ": " + pty; }
        } else {
            pos = pos + 1;
        }
    }
    let mut ret_ty = "";
    if pos < n && field_at(list_get(toks, pos), 0) == "ARROW" {
        pos = pos + 1;
        while pos < n {
            let rk: String = field_at(list_get(toks, pos), 0);
            if rk == "LBRACE" || rk == "KW_REQUIRES" || rk == "KW_ENSURES" { break; }
            ret_ty = ret_ty + field_at(list_get(toks, pos), 3);
            pos = pos + 1;
        }
    }
    if is_pub {
        let mut line = "pub fn " + name + "(" + params + ")";
        if ret_ty != "" { line = line + " -> " + ret_ty; }
        if caps != "" { line = line + " caps=" + caps; }
        println(line);
    }
    
    // skip requires/ensures/body
    while pos < n {
        let bk: String = field_at(list_get(toks, pos), 0);
        if bk == "LBRACE" {
            pos = skip_balanced(toks, pos);
            break;
        }
        pos = pos + 1;
    }
    return pos;
}

pub fn ast_emit_outline_json(src: String) {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    let mut fns_str = "[";
    let mut vers_str = "[";
    let mut first_f = true;
    let mut first_v = true;

    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            if k == "KW_PUB" { pos = pos + 1; }
            if pos < n && field_at(list_get(toks, pos), 0) == "KW_FN" {
                pos = pos + 1;
                if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                    let fname: String = field_at(list_get(toks, pos), 3);
                    if !first_f { fns_str = fns_str + ","; }
                    fns_str = fns_str + "\"" + fname + "\"";
                    first_f = false;
                }
            }
            while pos < n {
                let tk: String = field_at(list_get(toks, pos), 0);
                if tk == "LBRACE" {
                    pos = skip_balanced(toks, pos);
                    break;
                }
                pos = pos + 1;
            }
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                let vname: String = field_at(list_get(toks, pos), 3);
                if !first_v { vers_str = vers_str + ","; }
                vers_str = vers_str + "\"" + vname + "\"";
                first_v = false;
                pos = pos + 1;
            }
            if pos < n && field_at(list_get(toks, pos), 0) == "LBRACE" {
                pos = skip_balanced(toks, pos);
            }
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
    fns_str = fns_str + "]";
    vers_str = vers_str + "]";
    println("{\"functions\":" + fns_str + ",\"verifies\":" + vers_str + "}");
}
