// # Lower if expressions and blocks
//
// Logline: Emits bytecode for a brace expression block or an if/else expression and returns pos, env, label counter, and code.
//
// Setup: token_fmt, bc_emit_env, and bc_emit_surface are imported; bc_emit_expr and bc_next_label exist; a missing else pushes PUSH_INT 0.
//
// Beats:
//   1. A block skips LBRACE, emits one expression, skips a SEMI and the rest of the body, then skips RBRACE.
//   2. An if eats KW_IF, emits the condition, allocates else and end labels, then emits the then block.
//   3. Else if recurses; else emits a block; the join is JUMP_IF_FALSE, then JUMP, else, and end labels.

import "token_fmt.oo";
import "bc_emit_env.oo";
import "bc_emit_surface.oo";

pub fn bc_emit_expr_block(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p = pos;
    let mut e: String = env;
    let mut lc = label_ctr;
    let mut code: String = "PUSH_INT 0";
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) != "RBRACE" {
        let er: List[String] = bc_emit_expr(toks, p, n, e, lc);
        p = parse_int(list_get(er, 0));
        e = list_get(er, 1);
        lc = parse_int(list_get(er, 2));
        code = list_get(er, 3);
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
        while p < n && field_at(list_get(toks, p), 0) != "RBRACE" { p = p + 1; }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}

pub fn bc_emit_if_expr(toks: List[String], pos: Int, n: Int, env: String, label_ctr: Int) -> List[String] {
    let mut p = pos;
    let mut e: String = env;
    let mut lc = label_ctr;
    if p < n && field_at(list_get(toks, p), 0) == "KW_IF" { p = p + 1; }
    let cond_res: List[String] = bc_emit_expr(toks, p, n, e, lc);
    p = parse_int(list_get(cond_res, 0));
    e = list_get(cond_res, 1);
    lc = parse_int(list_get(cond_res, 2));
    let cond_code: String = list_get(cond_res, 3);
    let l_else_res: List[String] = bc_next_label(lc);
    let l_else: String = list_get(l_else_res, 0);
    lc = parse_int(list_get(l_else_res, 1));
    let l_end_res: List[String] = bc_next_label(lc);
    let l_end: String = list_get(l_end_res, 0);
    lc = parse_int(list_get(l_end_res, 1));
    let then_res: List[String] = bc_emit_expr_block(toks, p, n, e, lc);
    p = parse_int(list_get(then_res, 0));
    e = list_get(then_res, 1);
    lc = parse_int(list_get(then_res, 2));
    let then_code: String = list_get(then_res, 3);
    let mut else_code: String = "PUSH_INT 0";
    if p < n && field_at(list_get(toks, p), 0) == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            let elif_res: List[String] = bc_emit_if_expr(toks, p, n, e, lc);
            p = parse_int(list_get(elif_res, 0));
            e = list_get(elif_res, 1);
            lc = parse_int(list_get(elif_res, 2));
            else_code = list_get(elif_res, 3);
        } else {
            let eblk: List[String] = bc_emit_expr_block(toks, p, n, e, lc);
            p = parse_int(list_get(eblk, 0));
            e = list_get(eblk, 1);
            lc = parse_int(list_get(eblk, 2));
            else_code = list_get(eblk, 3);
        }
    }
    let code: String = cond_code + "\nJUMP_IF_FALSE " + l_else + "\n" + then_code + "\nJUMP " + l_end + "\nLABEL " + l_else + "\n" + else_code + "\nLABEL " + l_end;
    let mut res: List[String] = list_new();
    res = list_push(res, p.to_string());
    res = list_push(res, e);
    res = list_push(res, lc.to_string());
    res = list_push(res, code);
    return res;
}
