// # Propagate secret taint on emit
//
// Logline: Marks functions that return secrets and walks an assignment RHS to set or clear dest taint.
//
// Setup: c_emit_secret_prop_scan is imported; c_env_get, c_env_put, c_secret_tok_is_sec, c_line_text_at, and c_is_secret_directive_line exist; field and method taint live in c_emit_ident.oo.
//
// Beats:
//   1. Walk each top-level fn; if the body or return touches __sec__ or __fr_secret__ and the return is String or a secret local, set __fr_secret__name.
//   2. Walk the RHS with brace depth, recurse LPAREN groups through the scan at depth 1, and taint dest on a secret IDENT.
//   3. A clean RHS clears sticky __sec__ dest unless dest is a __secref__ directive root.

import "c_emit_secret_prop_scan.oo";

// Pre-pass: for each top-level fn, if body touches secrets and returns
// String (or returns a secret-tagged local), set __fr_secret__fn=1.
pub fn c_secret_mark_returning_fns(src: String, toks: List[String], env: String) -> String {
    let n = list_len(toks);
    let mut e: String = env;
    let mut pre_pos: Int = 0;
    while pre_pos < n {
        let k: String = field_at(list_get(toks, pre_pos), 0);
        if k == "KW_PUB" || k == "KW_FN" {
            let mut p: Int = pre_pos;
            if k == "KW_PUB" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "KW_FN" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let fn_name: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                    let mut depth: Int = 1;
                    p = p + 1;
                    while p < n && depth > 0 {
                        let pk: String = field_at(list_get(toks, p), 0);
                        if pk == "LPAREN" {
                            depth = depth + 1;
                        } else if pk == "RPAREN" {
                            depth = depth - 1;
                        }
                        p = p + 1;
                    }
                }
                let mut ret_str: Bool = false;
                if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
                    p = p + 1;
                    if p < n {
                        let ret_ty: String = field_at(list_get(toks, p), 3);
                        if ret_ty == "String" {
                            ret_str = true;
                        }
                        p = p + 1;
                    }
                }
                let mut has_secret: Bool = false;
                let mut ret_secret: Bool = false;
                // fn name itself SECRET-tagged (// SECRET: get_secret)
                if c_env_get(e, "__sec__" + fn_name) == "1" {
                    has_secret = true;
                }
                if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
                    let body_first: Int = parse_int(field_at(list_get(toks, p), 1));
                    let mut bd: Int = 1;
                    p = p + 1;
                    while p < n && bd > 0 {
                        let bk: String = field_at(list_get(toks, p), 0);
                        if bk == "LBRACE" {
                            bd = bd + 1;
                        } else if bk == "RBRACE" {
                            bd = bd - 1;
                            if bd == 0 {
                                break;
                            }
                        } else if bk == "IDENT" {
                            let sn: String = field_at(list_get(toks, p), 3);
                            if c_env_get(e, "__sec__" + sn) == "1" {
                                has_secret = true;
                            }
                            // multi-hop: callee already marked secret-returning
                            if p + 1 < n {
                                if field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                    if c_env_get(e, "__fr_secret__" + sn) == "1" {
                                        has_secret = true;
                                    }
                                }
                            }
                        } else if bk == "KW_RETURN" {
                            let mut r: Int = p + 1;
                            while r < n {
                                let rk: String = field_at(list_get(toks, r), 0);
                                if rk == "SEMI" || rk == "RBRACE" {
                                    break;
                                }
                                if rk == "IDENT" {
                                    let rn: String = field_at(list_get(toks, r), 3);
                                    if c_env_get(e, "__sec__" + rn) == "1" {
                                        has_secret = true;
                                        ret_secret = true;
                                    }
                                    if c_env_get(e, "__fr_secret__" + rn) == "1" {
                                        has_secret = true;
                                        ret_secret = true;
                                    }
                                }
                                r = r + 1;
                            }
                        }
                        p = p + 1;
                    }
                    let body_last: Int = parse_int(field_at(list_get(toks, p), 1));
                    let mut li: Int = body_first;
                    while li <= body_last {
                        let lt: String = c_line_text_at(src, li);
                        if c_is_secret_directive_line(lt) {
                            has_secret = true;
                        }
                        li = li + 1;
                    }
                    if has_secret {
                        if ret_str || ret_secret {
                            e = c_env_put(e, "__fr_secret__" + fn_name, "1");
                        }
                    }
                }
                pre_pos = p;
            } else {
                pre_pos = pre_pos + 1;
            }
        } else {
            pre_pos = pre_pos + 1;
        }
    }
    return e;
}

// Walk RHS from pos: taint dest if secret IDENT / secret-returning call /
// nested call args (f(g(secret))) / field path (__sec__recv.field).
// Clears sticky taint when assignment is clean. Brace-balances LBRACE
// (if/match arms scanned). LPAREN groups recurse via scan (depth ≤ 64).
pub fn c_secret_prop_from_rhs(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    let mut i = pos;
    let mut is_secret = false;
    let mut brace_depth = 0;
    // Struct literal detection: Name { field: val, ... }
    if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" && pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "LBRACE" {
        env = c_env_put(env, "__is_struct__" + dest, "1");
        let mut sp = pos + 2;
        let mut sbd = 1;
        while sp < n && sbd > 0 {
            let skk: String = field_at(list_get(toks, sp), 0);
            if skk == "LBRACE" {
                sbd = sbd + 1;
                sp = sp + 1;
            } else if skk == "RBRACE" {
                sbd = sbd - 1;
                if sbd == 0 { break; }
                sp = sp + 1;
            } else if sbd == 1 && skk == "IDENT" && sp + 1 < n && field_at(list_get(toks, sp + 1), 0) == "COLON" {
                let cur_field: String = field_at(list_get(toks, sp), 3);
                sp = sp + 2;
                let mut fd = 0;
                let mut field_is_sec = false;
                while sp < n {
                    let fk: String = field_at(list_get(toks, sp), 0);
                    if fk == "LBRACE" || fk == "LPAREN" || fk == "LBRACKET" { fd = fd + 1; }
                    else if fk == "RBRACE" || fk == "RPAREN" || fk == "RBRACKET" {
                        if fd == 0 { break; }
                        fd = fd - 1;
                    } else if fk == "COMMA" && fd == 0 {
                        break;
                    }
                    if fk == "IDENT" && c_secret_tok_is_sec(toks, sp, n, env) {
                        field_is_sec = true;
                    }
                    sp = sp + 1;
                }
                if field_is_sec {
                    env = c_env_put(env, "__sec__" + dest + "." + cur_field, "1");
                    is_secret = true;
                } else {
                    env = c_env_put(env, "__sec__" + dest + "." + cur_field, "0");
                }
            } else {
                sp = sp + 1;
            }
        }
        if is_secret {
            return c_env_put(env, "__sec__" + dest, "1");
        }
        return env;
    }
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "SEMI" && brace_depth == 0 {
            break;
        }
        if k == "KW_LET" && brace_depth == 0 {
            break;
        }
        if k == "LBRACE" {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            if brace_depth == 0 {
                break;
            }
            brace_depth = brace_depth - 1;
            i = i + 1;
        } else if k == "LPAREN" {
            let mut pd = 1;
            let mut j = i + 1;
            while j < n && pd > 0 {
                let kk: String = field_at(list_get(toks, j), 0);
                if kk == "LPAREN" {
                    pd = pd + 1;
                } else if kk == "RPAREN" {
                    pd = pd - 1;
                }
                j = j + 1;
            }
            // Recurse interior only (set-only; no sticky-clear). rec_depth=1.
            // Exclusive end = RPAREN index (j - 1); interior is [i+1, j-1).
            env = c_secret_prop_from_rhs_scan(toks, i + 1, j - 1, n, env, dest, 1);
            if c_env_get(env, "__sec__" + dest) == "1" {
                is_secret = true;
            }
            i = j;
        } else {
            if k == "IDENT" {
                if c_secret_tok_is_sec(toks, i, n, env) {
                    is_secret = true;
                }
            }
            i = i + 1;
        }
    }
    if is_secret {
        return c_env_put(env, "__sec__" + dest, "1");
    }
    // Clear sticky taint on clean rebind (only "1" counts as secret).
    // Never wipe // SECRET: directive roots (__secref__). dest may be dotted.
    if c_env_get(env, "__sec__" + dest) == "1" {
        if c_env_get(env, "__secref__" + dest) != "1" {
            return c_env_put(env, "__sec__" + dest, "0");
        }
    }
    return env;
}

// c_secret_resolve_name + c_secret_note_bare_alias live in c_emit_secret_alias.oo
// Nested LPAREN scan: c_secret_prop_from_rhs_scan in c_emit_secret_prop_scan.oo
