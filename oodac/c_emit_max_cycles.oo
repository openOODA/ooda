// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: path A MaxCycles — parse file-level MAX_CYCLES N; while fuel helpers
// stage: emit
// residual: not OS cgroup; for-loops / attr MaxCycles not lowered here

// Scan source for line-start directive MAX_CYCLES with positive N.
// N>0 → return decimal string. N==0 / invalid digits after marker → fail-closed.
// Absent marker → "" (no fuel; opt-in).
// Match only after newline (or file start) so self-host sources can mention the
// directive in docs/strings without tripping fail-closed mid-line.
pub fn c_parse_max_cycles(src: String) -> String {
    // Split so contiguous directive text never appears in this module source.
    let needle = "// " + "MAX_CYCLES:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        // Line-start only (self-host safe)
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let mut num = "";
                while k < sn {
                    let c = char_at(src, k);
                    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
                        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
                    {
                        num = num + c;
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                // Attack: silent zero N / invalid — never treat as "no marker"
                if num == "" {
                    println("ERR\tmax_cycles\tinvalid N (need positive int after directive)");
                    process_exit(1);
                }
                let n = parse_int(num);
                if n <= 0 {
                    println("ERR\tmax_cycles\tzero N fail-closed (need N>0)");
                    process_exit(1);
                }
                return num;
            }
        }
        i = i + 1;
    }
    return "";
}

// M58: counter is per-fn (`long long __oo_mc = 0` at fn entry). Open only the while.
pub fn c_emit_while_fuel_open(cond: String) {
    println("while (" + cond + ") {");
}

// Increment + exceed check: count > N → ERR max_cycles exceeded + exit 1.
pub fn c_emit_while_fuel_check(mc: String) {
    println("  __oo_mc = __oo_mc + 1;");
    println("  if (__oo_mc > " + mc + ") {");
    println("    oo_print_str(oo_str_lit(\"ERR\\tmax_cycles\\texceeded\"));");
    println("    oo_println();");
    println("    oo_process_exit(1);");
    println("  }");
}

pub fn c_emit_while_fuel_close() {
    println("}");
}
