// # Fold the hello.oo greet shape for emit-wasm
//
// Logline: Returns the const greet line when source matches hello.oo main, else empty.
//
// Setup: tokenize_lines and field_at exist. STRING text is the unquoted body.
//
// Beats:
//   1. Find fn greet whose body is return STRING + param + STRING.
//   2. Require main to be only let x = greet("..."); println(x);.
//   3. Return prefix + main's greet arg + suffix. Extra println misses.
//
// residual: general concat stays dummy end. Not a full WASM backend.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wf_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wf_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wf_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wf_kind(toks, p) == "KW_LET" && wf_kind(toks, p + 1) == "IDENT" && wf_text(toks, p + 1) == name && wf_kind(toks, p + 2) == "EQ" && wf_kind(toks, p + 3) == "INT" { return wf_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wf_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wf_kind(toks, pos) == "INT" { return wf_text(toks, pos); }
    if wf_kind(toks, pos) == "IDENT" {
        let name: String = wf_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wf_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wf_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wf_find_fn(toks: List[String], n: Int, fname: String) -> Int {
    let mut i = 0;
    while i + 1 < n {
        if wf_kind(toks, i) == "KW_FN" && wf_kind(toks, i + 1) == "IDENT" && wf_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wf_skip_lbrace(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    while p < n {
        if wf_kind(toks, p) == "LBRACE" { return p; }
        p = p + 1;
    }
    return -1;
}
fn wf_greet_param(toks: List[String], n: Int, g: Int) -> String {
    let mut p = g + 2;
    while p < n {
        if wf_kind(toks, p) == "LPAREN" {
            if p + 1 < n && wf_kind(toks, p + 1) == "IDENT" { return wf_text(toks, p + 1); }
            return "";
        }
        if wf_kind(toks, p) == "LBRACE" { return ""; }
        p = p + 1;
    }
    return "";
}
fn wf_greet_parts(toks: List[String], n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let g = wf_find_fn(toks, n, "greet");
    if g < 0 { return empty; }
    let pname: String = wf_greet_param(toks, n, g);
    if chars_len(pname) <= 0 { return empty; }
    let br = wf_skip_lbrace(toks, g, n);
    if br < 0 { return empty; }
    let mut p = br + 1;
    while p < n && wf_kind(toks, p) != "KW_RETURN" && wf_kind(toks, p) != "RBRACE" { p = p + 1; }
    if p + 5 >= n || wf_kind(toks, p) != "KW_RETURN" { return empty; }
    if wf_kind(toks, p + 1) != "STRING" || wf_kind(toks, p + 2) != "PLUS" { return empty; }
    if wf_kind(toks, p + 3) != "IDENT" || wf_text(toks, p + 3) != pname { return empty; }
    if wf_kind(toks, p + 4) != "PLUS" || wf_kind(toks, p + 5) != "STRING" { return empty; }
    let mut parts: List[String] = list_new();
    parts = list_push(parts, wf_text(toks, p + 1));
    parts = list_push(parts, wf_text(toks, p + 5));
    p = p + 6;
    if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
    if p >= n || wf_kind(toks, p) != "RBRACE" { return empty; }
    return parts;
}
fn wf_main_greet_arg(toks: List[String], n: Int) -> String {
    let m = wf_find_fn(toks, n, "main");
    if m < 0 { return ""; }
    let br = wf_skip_lbrace(toks, m, n);
    if br < 0 { return ""; }
    let mut p = br + 1;
    if p >= n || wf_kind(toks, p) != "KW_LET" { return ""; }
    p = p + 1;
    if p >= n || wf_kind(toks, p) != "IDENT" { return ""; }
    let vname: String = wf_text(toks, p);
    p = p + 1;
    if p >= n || wf_kind(toks, p) != "EQ" { return ""; }
    p = p + 1;
    if p + 3 >= n { return ""; }
    if wf_kind(toks, p) != "IDENT" || wf_text(toks, p) != "greet" { return ""; }
    if wf_kind(toks, p + 1) != "LPAREN" || wf_kind(toks, p + 2) != "STRING" { return ""; }
    if wf_kind(toks, p + 3) != "RPAREN" { return ""; }
    let arg: String = wf_text(toks, p + 2);
    p = p + 4;
    if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
    if p + 3 >= n { return ""; }
    if wf_kind(toks, p) != "IDENT" || wf_text(toks, p) != "println" { return ""; }
    if wf_kind(toks, p + 1) != "LPAREN" { return ""; }
    if wf_kind(toks, p + 2) != "IDENT" || wf_text(toks, p + 2) != vname { return ""; }
    if wf_kind(toks, p + 3) != "RPAREN" { return ""; }
    p = p + 4;
    if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
    if p >= n || wf_kind(toks, p) != "RBRACE" { return ""; }
    return arg;
}
fn wf_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wf_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wf_kind(toks, p) == "KW_LET" {
        while p < n && wf_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}
fn wf_fold_arith(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wf_find_fn(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wf_p(toks, n, f + 2);
    if p0 < 0 { return ""; }
    if wf_kind(toks, p0) != "IDENT" || wf_text(toks, p0) != "println" { return ""; }
    if p0 + 1 >= n || wf_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    if p0 + 4 < n && wf_kind(toks, p0 + 2) != "MINUS" {
        let ls: String = wf_int_val(toks, p0 + 2, n);
        if chars_len(ls) > 0 {
            let op: String = wf_kind(toks, p0 + 3);
            let rs: String = wf_int_val(toks, p0 + 4, n);
            if chars_len(rs) > 0 && wf_kind(toks, p0 + 5) == "RPAREN" {
                let mut p: Int = p0 + 6;
                if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
                if p < n && wf_kind(toks, p) == "RBRACE" {
                    let left: Int = parse_int(ls);
                    let right: Int = parse_int(rs);
                    if op == "PLUS" { return (left + right).to_string(); }
                    if op == "MINUS" { return (left - right).to_string(); }
                    if op == "STAR" { return (left * right).to_string(); }
                    if op == "SLASH" {
                        if right == 0 { return ""; }
                        return (left / right).to_string();
                    }
                    if op == "PERCENT" {
                        if right == 0 { return ""; }
                        return (left % right).to_string();
                    }
                }
            }
        }
        if p0 + 7 < n {
            let a: String = wf_int_val(toks, p0 + 2, n);
            let b: String = wf_int_val(toks, p0 + 4, n);
            let c: String = wf_int_val(toks, p0 + 6, n);
            if chars_len(a) > 0 && chars_len(b) > 0 && chars_len(c) > 0 {
                if wf_kind(toks, p0 + 3) == "PLUS" && wf_kind(toks, p0 + 5) == "PLUS" && wf_kind(toks, p0 + 7) == "RPAREN" {
                    let mut p: Int = p0 + 8;
                    if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
                    if p < n && wf_kind(toks, p) == "RBRACE" {
                        return (parse_int(a) + parse_int(b) + parse_int(c)).to_string();
                    }
                }
            }
        }
    } else if p0 + 4 < n && wf_kind(toks, p0 + 2) == "MINUS" {
        let vs: String = wf_int_val(toks, p0 + 3, n);
        if chars_len(vs) > 0 && wf_kind(toks, p0 + 4) == "RPAREN" {
            let mut p: Int = p0 + 5;
            if p < n && wf_kind(toks, p) == "SEMI" { p = p + 1; }
            if p < n && wf_kind(toks, p) == "RBRACE" {
                return (0 - parse_int(vs)).to_string();
            }
        }
    }
    return "";
}
pub fn wasm_fold_hello(src: String) -> String {
    if chars_len(src) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let parts: List[String] = wf_greet_parts(toks, n);
    if list_len(parts) >= 2 {
        let arg: String = wf_main_greet_arg(toks, n);
        if chars_len(arg) > 0 { return list_get(parts, 0) + arg + list_get(parts, 1); }
    }
    let arith: String = wf_fold_arith(src, "main");
    if chars_len(arith) > 0 { return arith; }
    return "";
}
