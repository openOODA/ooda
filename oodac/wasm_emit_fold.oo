// # Fold the hello.oo greet shape for emit-wasm
//
// Logline: Returns the const greet line when source matches hello.oo main, else empty.
//
// Setup: tokenize_lines and field_at exist. STRING text is the unquoted body.
//
// Beats:
//   1. Find fn greet whose body is return STRING + param + STRING.
//   2. Require main to be only let x = greet("..."); println(x);.
//   3. Return prefix + main's greet arg + suffix. Extra println misses.
//
// residual: general concat stays dummy end. Not a full WASM backend.

import "token_fmt.oo";

fn wf_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wf_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wf_find_fn(toks: List[String], n: Int, fname: String) -> Int {
    let mut i = 0;
    while i + 1 < n {
        if wf_kind(toks, i) == "KW_FN" {
            if wf_kind(toks, i + 1) == "IDENT" {
                if wf_text(toks, i + 1) == fname {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn wf_skip_lbrace(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    while p < n {
        if wf_kind(toks, p) == "LBRACE" {
            return p;
        }
        p = p + 1;
    }
    return -1;
}

fn wf_greet_param(toks: List[String], n: Int, g: Int) -> String {
    let mut p = g + 2;
    while p < n {
        if wf_kind(toks, p) == "LPAREN" {
            if p + 1 < n && wf_kind(toks, p + 1) == "IDENT" {
                return wf_text(toks, p + 1);
            }
            return "";
        }
        if wf_kind(toks, p) == "LBRACE" {
            return "";
        }
        p = p + 1;
    }
    return "";
}

fn wf_greet_parts(toks: List[String], n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let g = wf_find_fn(toks, n, "greet");
    if g < 0 {
        return empty;
    }
    let pname: String = wf_greet_param(toks, n, g);
    if chars_len(pname) <= 0 {
        return empty;
    }
    let br = wf_skip_lbrace(toks, g, n);
    if br < 0 {
        return empty;
    }
    let mut p = br + 1;
    while p < n && wf_kind(toks, p) != "KW_RETURN" && wf_kind(toks, p) != "RBRACE" {
        p = p + 1;
    }
    if p + 5 >= n || wf_kind(toks, p) != "KW_RETURN" {
        return empty;
    }
    if wf_kind(toks, p + 1) != "STRING" || wf_kind(toks, p + 2) != "PLUS" {
        return empty;
    }
    if wf_kind(toks, p + 3) != "IDENT" || wf_text(toks, p + 3) != pname {
        return empty;
    }
    if wf_kind(toks, p + 4) != "PLUS" || wf_kind(toks, p + 5) != "STRING" {
        return empty;
    }
    let mut parts: List[String] = list_new();
    parts = list_push(parts, wf_text(toks, p + 1));
    parts = list_push(parts, wf_text(toks, p + 5));
    p = p + 6;
    if p < n && wf_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || wf_kind(toks, p) != "RBRACE" {
        return empty;
    }
    return parts;
}

fn wf_main_greet_arg(toks: List[String], n: Int) -> String {
    let m = wf_find_fn(toks, n, "main");
    if m < 0 {
        return "";
    }
    let br = wf_skip_lbrace(toks, m, n);
    if br < 0 {
        return "";
    }
    let mut p = br + 1;
    if p >= n || wf_kind(toks, p) != "KW_LET" {
        return "";
    }
    p = p + 1;
    if p >= n || wf_kind(toks, p) != "IDENT" {
        return "";
    }
    let vname: String = wf_text(toks, p);
    p = p + 1;
    if p >= n || wf_kind(toks, p) != "EQ" {
        return "";
    }
    p = p + 1;
    if p + 3 >= n {
        return "";
    }
    if wf_kind(toks, p) != "IDENT" || wf_text(toks, p) != "greet" {
        return "";
    }
    if wf_kind(toks, p + 1) != "LPAREN" || wf_kind(toks, p + 2) != "STRING" {
        return "";
    }
    if wf_kind(toks, p + 3) != "RPAREN" {
        return "";
    }
    let arg: String = wf_text(toks, p + 2);
    p = p + 4;
    if p < n && wf_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p + 3 >= n {
        return "";
    }
    if wf_kind(toks, p) != "IDENT" || wf_text(toks, p) != "println" {
        return "";
    }
    if wf_kind(toks, p + 1) != "LPAREN" {
        return "";
    }
    if wf_kind(toks, p + 2) != "IDENT" || wf_text(toks, p + 2) != vname {
        return "";
    }
    if wf_kind(toks, p + 3) != "RPAREN" {
        return "";
    }
    p = p + 4;
    if p < n && wf_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || wf_kind(toks, p) != "RBRACE" {
        return "";
    }
    return arg;
}

pub fn wasm_fold_hello(src: String) -> String {
    if chars_len(src) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let parts: List[String] = wf_greet_parts(toks, n);
    if list_len(parts) < 2 {
        return "";
    }
    let arg: String = wf_main_greet_arg(toks, n);
    if chars_len(arg) <= 0 {
        return "";
    }
    return list_get(parts, 0) + arg + list_get(parts, 1);
}
