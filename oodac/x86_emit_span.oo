// # Const-int span and mix-paren for emit-x86
//
// Logline: Folds an ALU atom chain to a value plus width, and STRING plus a paren group.
//
// Setup: x86_alu_atom, x86_dec_op, x86_is_alu_op, and x86_alu_try exist in alu.
//
// Beats:
//   1. Span INT/ident/paren ALU ops until a non-op.
//   2. Mix n= plus (1+2) into n=3.
//
// residual: C precedence stays later.

import "x86_emit_harv.oo";
import "x86_emit_alu.oo";

pub fn x86_alu_span(toks: List[String], n: Int, j: Int, inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    let left: List[String] = x86_alu_atom(toks, n, j, inames, ivals);
    if list_len(left) < 2 {
        return empty;
    }
    let w: List[Int] = x86_parse_dec(list_get(left, 1));
    if list_len(w) < 1 {
        return empty;
    }
    let mut acc: String = list_get(left, 0);
    let mut e = j + list_get(w, 0);
    while e < n && x86_is_alu_op(x86_tok_k(toks, e)) {
        let more: List[String] = x86_alu_atom(toks, n, e + 1, inames, ivals);
        if list_len(more) < 2 {
            return empty;
        }
        let wm: List[Int] = x86_parse_dec(list_get(more, 1));
        if list_len(wm) < 1 {
            return empty;
        }
        let nxt: List[String] = x86_dec_op(acc, list_get(more, 0), x86_tok_k(toks, e));
        if list_len(nxt) < 1 {
            return empty;
        }
        acc = list_get(nxt, 0);
        e = e + 1 + list_get(wm, 0);
    }
    let mut o: List[String] = list_new();
    o = list_push(o, acc);
    o = list_push(o, (e - j).to_string());
    return o;
}

pub fn x86_mix_paren(toks: List[String], n: Int, j: Int, inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    if j >= n || x86_tok_k(toks, j) != "STRING" {
        return empty;
    }
    if j + 2 >= n {
        return empty;
    }
    if x86_tok_k(toks, j + 1) != "PLUS" {
        return empty;
    }
    if x86_tok_k(toks, j + 2) != "LPAREN" {
        return empty;
    }
    let agot: List[String] = x86_alu_try(toks, n, j + 2, inames, ivals);
    if list_len(agot) < 1 {
        return empty;
    }
    let mut one: List[String] = list_new();
    one = list_push(one, x86_tok_t(toks, j) + list_get(agot, 0));
    return one;
}

pub fn x86_cmp_take(ck: String, a: String, b: String) -> List[String] {
    let empty: List[String] = list_new();
    let mut one: List[String] = list_new();
    if ck == "EQEQ" {
        if a == b {
            one = list_push(one, "1");
        } else {
            one = list_push(one, "0");
        }
        return one;
    }
    if ck == "NEQ" {
        if a == b {
            one = list_push(one, "0");
        } else {
            one = list_push(one, "1");
        }
        return one;
    }
    let pa: List[Int] = x86_parse_dec(a);
    let pb: List[Int] = x86_parse_dec(b);
    if list_len(pa) < 1 || list_len(pb) < 1 {
        return empty;
    }
    let va = list_get(pa, 0);
    let vb = list_get(pb, 0);
    let mut t = false;
    if ck == "GT" {
        t = va > vb;
    } else if ck == "LT" {
        t = va < vb;
    } else if ck == "GTE" {
        t = va > vb || va == vb;
    } else if ck == "LTE" {
        t = va < vb || va == vb;
    } else {
        return empty;
    }
    if t {
        one = list_push(one, "1");
    } else {
        one = list_push(one, "0");
    }
    return one;
}
