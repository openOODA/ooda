// # Shuffle top-level C fn emit
//
// Logline: Reverse top-level function emit order for bodies and full modes when path-A shuffle is set, then plant a decoy after each function.
//
// Setup: token_fmt, c_emit_skip, c_emit_meta, c_emit_fn, lex, token_stream, c_emit_env, and c_emit_arc are imported. Types and imports stay in the existing pre-pass. Caller invokes this only for bodies/full-like modes.
//
// Beats:
//   1. Collect top-level KW_PUB/KW_FN starts by skipping each function without emitting.
//   2. Reverse that start list and emit each function in that order via c_emit_fn_mode.
//   3. After each emit, plant a named decoy when the function name is known.
//
// residual: not runtime assembly mutation; protos mode stays source order

import "token_fmt.oo";
import "c_emit_skip.oo";
import "c_emit_meta.oo";
import "c_emit_fn.oo";
import "lex.oo";
import "token_stream.oo";
import "c_emit_env.oo";
import "c_emit_arc.oo";

// IDENT name of top-level fn starting at pos (KW_PUB or KW_FN).
pub fn c_drive_fn_name_at(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    if p >= n {
        return "";
    }
    if c_tokk(toks, p) == "KW_PUB" {
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "KW_FN" {
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "IDENT" {
        return c_tokt(toks, p);
    }
    return "";
}

// Skip one top-level fn (no emit) so collectors do not double-hit KW_FN after KW_PUB.
pub fn c_drive_skip_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && c_tokk(toks, p) == "KW_PUB" {
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "KW_FN" {
        p = p + 1;
    }
    if p < n {
        p = p + 1;
    }
    while p < n {
        if c_tokk(toks, p) == "RPAREN" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "ARROW" {
        p = p + 1;
        p = c_emit_skip_type(toks, p, n);
    }
    p = c_emit_skip_contracts(toks, p, n);
    p = c_emit_skip_braces(toks, p, n);
    p = c_emit_skip_verify(toks, p, n);
    return p;
}

// Collect top-level fn start positions (same surface as c_emit_stream_mode loop).
pub fn c_drive_collect_fn_starts(toks: List[String], n: Int) -> List[Int] {
    let mut starts: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let k: String = c_tokk(toks, i);
        if k == "EOF" {
            i = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            starts = list_push(starts, i);
            i = c_drive_skip_fn(toks, i, n);
        } else if k == "KW_VERIFY" {
            i = c_emit_skip_verify(toks, i, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            i = skip_until_semi(toks, i);
        } else {
            i = i + 1;
        }
    }
    return starts;
}

// Reverse List[Int] (path-A-shuffle order diversity).
pub fn c_drive_reverse_ints(xs: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let m: Int = list_len(xs);
    let mut ri: Int = m - 1;
    while ri >= 0 {
        out = list_push(out, list_get(xs, ri));
        ri = ri - 1;
    }
    return out;
}

// After each top-level fn: prefer named decoy API.
pub fn c_drive_after_fn(meta_idx: Int, fn_name: String) {
    if fn_name != "" {
        c_emit_meta_decoy_named(meta_idx, fn_name);
    } else {
        c_emit_meta_decoy(meta_idx);
    }
}

// Two-pass: reverse top-level fn emit order; returns updated fn_env as [env].
// Caller must only invoke for bodies/full-like modes when path-a-shuffle is set.
pub fn c_emit_meta_drive_shuffle(toks: List[String], n: Int, fn_env: String, mode: String) -> List[String] {
    let starts: List[Int] = c_drive_collect_fn_starts(toks, n);
    let order: List[Int] = c_drive_reverse_ints(starts);
    let mut e: String = fn_env;
    let mut meta_idx: Int = 0;
    let mut j: Int = 0;
    let m: Int = list_len(order);
    while j < m {
        let spos: Int = list_get(order, j);
        let fname: String = c_drive_fn_name_at(toks, spos, n);
        let fr: List[String] = c_emit_fn_mode(toks, spos, n, e, mode);
        e = list_get(fr, 1);
        c_drive_after_fn(meta_idx, fname);
        meta_idx = meta_idx + 1;
        j = j + 1;
    }
    let mut env_list: List[String] = list_new();
    env_list = list_push(env_list, e);
    return env_list;
}
