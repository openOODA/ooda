// # Metamorphic Opaque Predicate Synthesis
//
// Logline: Synthesizes algebraic invariant opaque predicates (quadratic residues, parity invariants) to confound disassemblers.
//
// Setup: Generates always-true and always-false control flow guards with unreachable trap blocks.
//
// Beats:
//   1. Synthesize always-true parity invariants (x * (x + 1) % 2 == 0).
//   2. Synthesize always-false quadratic non-residues ((7*y^2 - 1) % 7 == (x^2) % 7).
//   3. Emit machine code branch templates for x86-64 and AArch64.
// RULES.oot 1.7: Under 256 lines.

pub fn meta_opaque_pred_even_product(reg: String, label: String) -> String {
    let expr: String = "(" + reg + " * (" + reg + " + 1)) & 1 == 0";
    return "even_product\t1\t" + expr + "\t" + label;
}

pub fn meta_opaque_pred_mod7_residue(reg_x: String, reg_y: String, label: String) -> String {
    let expr: String = "(7 * " + reg_y + "^2 - 1) % 7 != (" + reg_x + "^2) % 7";
    return "mod7_non_residue\t1\t" + expr + "\t" + label;
}

pub fn meta_opaque_pred_emit_x86(pred_kind: String, expr: String, label: String) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "/* opaque true predicate: " + expr + " */");
    out = list_push(out, "mov %rax, %rcx");
    out = list_push(out, "inc %rcx");
    out = list_push(out, "imul %rax, %rcx");
    out = list_push(out, "test $1, %rcx");
    out = list_push(out, "jnz " + label);
    return out;
}
