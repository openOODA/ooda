// # Bind user-sum constructor names
//
// Logline: type Name = A | B(Int) contributes A and B as depth-0 names for check.
//
// Setup: toks are the program. Struct types and aliases without `|` add nothing.
//
// Beats:
//   1. Walk KW_TYPE. Skip `= struct` and `{`.
//   2. On `|` variants, record each top-level IDENT.
//   3. Payload names inside () are not constructors.

pub fn sum_ctor_tab(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    let mut out: String = "\t";
    let mut i: Int = 0;
    while i + 3 < n {
        if field_at(list_get(toks, i), 0) == "KW_TYPE" {
            if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                if field_at(list_get(toks, i + 2), 0) == "EQ" {
                    if field_at(list_get(toks, i + 3), 3) != "struct" {
                        let mut p: Int = i + 3;
                        let mut pipes: Int = 0;
                        let mut pd: Int = 0;
                        let mut acc: String = "\t";
                        while p < n {
                            let pk: String = field_at(list_get(toks, p), 0);
                            if pk == "SEMI" {
                                break;
                            }
                            if pk == "LBRACE" {
                                acc = "\t";
                                pipes = 0;
                                break;
                            }
                            if pk == "LPAREN" {
                                pd = pd + 1;
                            }
                            if pk == "RPAREN" {
                                if pd > 0 {
                                    pd = pd - 1;
                                }
                            }
                            if pk == "PIPE" && pd == 0 {
                                pipes = pipes + 1;
                            }
                            if pk == "IDENT" && pd == 0 {
                                acc = acc + field_at(list_get(toks, p), 3) + "\t";
                            }
                            p = p + 1;
                        }
                        if pipes > 0 {
                            out = out + acc;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn bind_sum_ctors(toks: List[String], binds: List[String]) -> List[String] {
    let tab: String = sum_ctor_tab(toks);
    let mut out: List[String] = binds;
    let n: Int = chars_len(tab);
    let mut i: Int = 1;
    let mut cur: String = "";
    while i < n {
        let ch: String = char_at(tab, i);
        if ch == "\t" {
            if cur != "" {
                out = list_push(out, cur + "@0");
            }
            cur = "";
        } else {
            cur = cur + ch;
        }
        i = i + 1;
    }
    return out;
}

pub fn is_user_sum_ctor(tab: String, name: String) -> Bool {
    if name == "" {
        return false;
    }
    return tab.contains("\t" + name + "\t");
}
