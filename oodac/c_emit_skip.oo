// # Skip types and map C types
//
// Logline: Map type tokens to C names and skip types, braces, contracts, and verify blocks.
//
// Setup: Type expressions and contract blocks are ready for emission skipping.
//
// Beats:
//   1. Peek List elem and map c_ty_at.
//   2. Skip type, braces, contracts, and verify.
//   3. Cap grant suffixes live in c_emit_skip_grant.oo.

import "c_emit_skip_grant.oo";
import "c_emit_skip_peek.oo";

pub fn c_skip_amp_mut(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n {
        if field_at(list_get(toks, p), 0) == "AMP" {
            p = p + 1;
        }
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "KW_MUT" {
            p = p + 1;
        }
    }
    return p;
}

// pos at type IDENT (e.g. List); returns S, I, or "" for non-List.
pub fn c_peek_list_elem(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "";
    }
    if field_at(list_get(toks, pos), 3) != "List" {
        return "";
    }
    let mut p: Int = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            let e: String = field_at(list_get(toks, p), 3);
            if e == "Int" {
                return "I";
            }
            if e == "String" {
                return "S";
            }
            if e == "Float" || e == "f64" { return "F"; }
            return e;
        }
    }
    return "S";
}

// Map type token at pos → C type (params / returns / let ann).
pub fn c_ty_at(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "void";
    }
    if field_at(list_get(toks, pos), 0) == "AMP" {
        // &List[T] / &String / &Int / &Result is the inner C type, not `List*`.
        let inner: Int = c_skip_amp_mut(toks, pos, n);
        if inner < n {
            if field_at(list_get(toks, inner), 0) == "IDENT" {
                let tn: String = field_at(list_get(toks, inner), 3);
                if tn == "List" || tn == "String" || tn == "Int" || tn == "Bool" || tn == "Float" || tn == "f64" || tn == "Result" || tn == "Option" {
                    return c_ty_at(toks, inner, n);
                }
            }
        }
        return c_ref_c_ty(toks, pos, n);
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "void";
    }
    let tn: String = field_at(list_get(toks, pos), 3);
    if tn == "String" {
        return "OoStr";
    }
    if tn == "Int" {
        return "long long";
    }
    if tn == "Bool" {
        return "int";
    }
    if tn == "Float" || tn == "f64" {
        return "double";
    }
    if tn == "List" {
        let lk: String = c_peek_list_elem2(toks, pos, n);
        if lk == "I" {
            return "OoIList";
        }
        if lk == "S" {
            return "OoSList";
        }
        if lk == "F" {
            return "OoFList";
        }
        if lk == "LF" {
            return "OoFList";
        }
        if lk == "LL_I" {
            return "OoLL_I";
        }
        if lk == "LL_S" {
            return "OoLL_S";
        }
        if lk == "LL_F" {
            return "OoLL_F";
        }
        return "OoL_" + lk;
    }
    if tn == "Result" {
        return c_result_c_ty(toks, pos, n);
    }
    if tn == "Option" {
        return c_option_c_ty(toks, pos, n);
    }
    if c_cap_grant_suffix(tn) != "" {
        return "long long";
    }
    if tn == "HitlCap" || tn == "AuditCap" || tn == "IoCap" {
        return "long long";
    }
    return tn;
}

pub fn c_emit_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    p = c_skip_amp_mut(toks, p, n);
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        let mut depth: Int = 1;
        p = p + 1;
        while p < n && depth > 0 {
            let k: String = field_at(list_get(toks, p), 0);
            if k == "LBRACKET" {
                depth = depth + 1;
            }
            if k == "RBRACKET" {
                depth = depth - 1;
            }
            p = p + 1;
        }
    }
    return p;
}

// Skip brace-balanced region starting at LBRACE (or find next LBRACE).
pub fn c_emit_skip_braces(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
        p = p + 1;
    }
    if p >= n {
        return p;
    }
    let mut depth: Int = 0;
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 {
                return p;
            }
        } else {
            p = p + 1;
        }
    }
    return p;
}

// Skip requires/ensures until LBRACE. Fail-closed on mid-clause item / missing brace.
pub fn c_emit_skip_contracts(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    let mut cont: Bool = true;
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            cont = false;
        } else if k == "KW_REQUIRES" || k == "KW_ENSURES" || (k == "IDENT" && field_at(list_get(toks, p), 3) == "spec") {
            p = p + 1;
            let mut in_clause: Bool = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated before LBRACE");
                    process_exit(1);
                }
                let k2: String = field_at(list_get(toks, p), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "IDENT" && field_at(list_get(toks, p), 3) == "spec" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY"
                    || k2 == "KW_TYPE" || k2 == "EOF"
                {
                    println("ERR\tc_emit\tcontract clause garbage before body");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY"
            || k == "KW_TYPE" || k == "EOF"
        {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    return p;
}

pub fn c_emit_skip_verify(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && field_at(list_get(toks, p), 0) == "KW_VERIFY" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
            p = c_emit_skip_braces(toks, p, n);
        }
    }
    return p;
}
