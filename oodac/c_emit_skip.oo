// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: skip types/braces; list-kind env for emit
// stage: emit
// env format: "name=S;name2=I;"  S=List[String] I=List[Int]

// Match only at start or after ';' so "s=" does not hit inside "xs=S;".
pub fn c_env_get(env: String, name: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut i = 0;
    while i + kn <= en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                if i + kn < en {
                    return char_at(env, i + kn);
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn c_env_put(env: String, name: String, kind: String) -> String {
    return env + name + "=" + kind + ";";
}

// pos at type IDENT (e.g. List); returns S, I, or "" for non-List.
pub fn c_peek_list_elem(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "";
    }
    if field_at(list_get(toks, pos), 3) != "List" {
        return "";
    }
    let mut p = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            let e = field_at(list_get(toks, p), 3);
            if e == "Int" {
                return "I";
            }
            if e == "String" {
                return "S";
            }
        }
    }
    // bare List → string lists (oodac token packs)
    return "S";
}

// Map type token at pos → C type (params / returns / let ann).
pub fn c_ty_at(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "void";
    }
    if field_at(list_get(toks, pos), 0) == "AMP" {
        return "int";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "void";
    }
    let tn = field_at(list_get(toks, pos), 3);
    if tn == "String" {
        return "OoStr";
    }
    if tn == "Int" {
        return "long long";
    }
    if tn == "Bool" {
        return "int";
    }
    if tn == "List" {
        let lk = c_peek_list_elem(toks, pos, n);
        if lk == "I" {
            return "OoIList";
        }
        return "OoSList";
    }
    // Result[String,String] and friends → OoResS (runtime CHS shape)
    if tn == "Result" {
        return "OoResS";
    }
    // Unknown / alias: fail soft as long long (still better than void for returns)
    return "long long";
}

pub fn c_emit_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "AMP" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        let mut depth = 1;
        p = p + 1;
        while p < n && depth > 0 {
            let k = field_at(list_get(toks, p), 0);
            if k == "LBRACKET" {
                depth = depth + 1;
            }
            if k == "RBRACKET" {
                depth = depth - 1;
            }
            p = p + 1;
        }
    }
    return p;
}

// Skip brace-balanced region starting at LBRACE (or find next LBRACE).

pub fn c_emit_skip_braces(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
        p = p + 1;
    }
    if p >= n {
        return p;
    }
    let mut depth = 0;
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 {
                return p;
            }
        } else {
            p = p + 1;
        }
    }
    return p;
}


