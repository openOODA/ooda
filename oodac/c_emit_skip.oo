// job: skip types and brace regions during emit
// stage: emit

pub fn c_emit_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "AMP" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        let mut depth = 1;
        p = p + 1;
        while p < n && depth > 0 {
            let k = field_at(list_get(toks, p), 0);
            if k == "LBRACKET" {
                depth = depth + 1;
            }
            if k == "RBRACKET" {
                depth = depth - 1;
            }
            p = p + 1;
        }
    }
    return p;
}

// Skip brace-balanced region starting at LBRACE (or find next LBRACE).

pub fn c_emit_skip_braces(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
        p = p + 1;
    }
    if p >= n {
        return p;
    }
    let mut depth = 0;
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 {
                return p;
            }
        } else {
            p = p + 1;
        }
    }
    return p;
}


