// # Fingerprint source for the check cache
//
// Logline: Maps source text to a short digest the check cache stores as a key.
//
// Setup: crypto_sha256_internal, chars_len, and str_slice exist; check_mod keys .ooda-cache/check with the result.
//
// Beats:
//   1. An empty string returns empty000 so nothing is hashed.
//   2. A digest of sixteen characters or more is cropped to its first sixteen.
//   3. A shorter nonempty digest is returned as-is.
//   4. An empty digest falls back to L plus the source character length.

pub fn content_hash(s: String) -> String {
    if chars_len(s) == 0 {
        return "empty000";
    }
    let digest: String = crypto_sha256_internal(s);
    let n = chars_len(digest);
    if n >= 16 {
        let head: String = str_slice(digest, 0, 16);
        return head;
    }
    if n > 0 {
        return digest;
    }
    return "L" + chars_len(s).to_string();
}
