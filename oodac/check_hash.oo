// # Fingerprint source for the check cache
//
// Logline: Maps source text and path stamps to short digests the check cache stores as keys.
//
// Setup: crypto_sha256_internal, oo_file_stamp, chars_len, char_at, and str_slice exist; check_mod keys .ooda-cache/check with the result.
//
// Beats:
//   1. An empty string returns empty000 so nothing is hashed.
//   2. A digest of sixteen characters or more is cropped to its first sixteen.
//   3. check_paths_listing writes path tab stamp lines; check_listing_fresh restats each line.
//
// residual: RAM-cold typecheck stays ~523s; disk-warm new-process uses g_ stamp snapshot.

pub fn content_hash(s: String) -> String {
    if chars_len(s) == 0 {
        return "empty000";
    }
    let digest: String = crypto_sha256_internal(s);
    let n = chars_len(digest);
    if n >= 16 {
        let head: String = str_slice(digest, 0, 16);
        return head;
    }
    if n > 0 {
        return digest;
    }
    return "L" + chars_len(s).to_string();
}

pub fn check_paths_listing(paths: List[String]) -> String {
    let np = list_len(paths);
    let mut out: String = "";
    let mut i = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let st: String = oo_file_stamp(pth);
        out = out + pth + "\t" + st + "\n";
        i = i + 1;
    }
    return out;
}

pub fn check_listing_fresh(listing: String) -> Bool {
    let n = bytes_len(listing);
    if n == 0 {
        return false;
    }
    let mut i = 0;
    let mut start = 0;
    let mut saw = false;
    while i <= n {
        let at_end = i == n;
        let mut nl = at_end;
        if !at_end {
            if byte_at(listing, i) == 10 {
                nl = true;
            }
        }
        if nl {
            if i > start {
                let line: String = str_slice(listing, start, i);
                let ln = bytes_len(line);
                let mut tab = 0;
                let mut got = false;
                let mut k = 0;
                while k < ln {
                    if byte_at(line, k) == 9 {
                        tab = k;
                        got = true;
                        k = ln;
                    } else {
                        k = k + 1;
                    }
                }
                if !got {
                    return false;
                }
                if tab < 1 {
                    return false;
                }
                let pth: String = str_slice(line, 0, tab);
                let old: String = str_slice(line, tab + 1, ln);
                let now: String = oo_file_stamp(pth);
                if now == "0:0" {
                    return false;
                }
                if now != old {
                    return false;
                }
                saw = true;
            }
            if at_end {
                i = n + 1;
            } else {
                i = i + 1;
                start = i;
            }
        } else {
            i = i + 1;
        }
    }
    return saw;
}
