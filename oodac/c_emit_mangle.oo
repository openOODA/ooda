// # Mangle a C function name by source file
//
// Logline: Return a C identifier that is unique per (source file, fn name) pair so two .oo files may both define `pub fn X` without the C linker complaining about redefinition.
//
// Setup: name is the source-level fn name; path is the source file path string. main is never mangled.
//
// Beats:
//   1. If name is "main", return it unchanged (C requires the single entry point be named main).
//   2. Take the basename of path (text after the last '/') and drop the trailing ".oo" extension.
//   3. Replace any remaining '/' or '.' in the basename with '_'.
//   4. Return "<sanitized_basename>__<name>".

pub fn c_mangle_fn_name(name: String, path: String) -> String {
    if name == "main" {
        return name;
    }
    // Find last '/' to slice off the basename.
    let plen: Int = chars_len(path);
    let mut base_start: Int = 0;
    let mut i: Int = 0;
    while i < plen {
        if char_at(path, i) == "/" {
            base_start = i + 1;
        }
        i = i + 1;
    }
    let mut base: String = str_slice(path, base_start, plen);
    // Drop the ".oo" extension.
    let blen: Int = chars_len(base);
    if blen >= 3 {
        if char_at(base, blen - 3) == "." {
            base = str_slice(base, 0, blen - 3);
        }
    }
    // Replace '/' and '.' with '_' (paranoid; basename usually has neither now).
    let mut out: String = "";
    let blen2: Int = chars_len(base);
    let mut k: Int = 0;
    while k < blen2 {
        let c: String = char_at(base, k);
        if c == "/" {
            out = out + "_";
        } else if c == "." {
            out = out + "_";
        } else {
            out = out + c;
        }
        k = k + 1;
    }
    return out + "__" + name;
}
