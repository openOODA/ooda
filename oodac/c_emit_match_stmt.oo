// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: lower match on Result (OoResS / OoResV) to if (ok) / else
// stage: emit

pub fn c_emit_match_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let scrut = list_get(pr, 1);
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACE" {
        println("ERR\tc_emit\tmatch: expected { after scrutinee");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" || field_at(list_get(toks, p), 3) != "Ok" {
        println("ERR\tc_emit\tmatch: expected Ok(...) arm first");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Ok(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" { ok_bind = field_at(list_get(toks, p), 3); p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Ok(...)");
        process_exit(1);
    }
    p = p + 1;
    // Result kind: R = OoResS (.val both arms), V = OoResV (.err on Err)
    let mut rkind = "R";
    if c_env_get(env, scrut) == "V" {
        rkind = "V";
    }
    println("  {");
    if rkind == "V" {
        println("  OoResV __m = " + scrut + ";");
    } else {
        println("  OoResS __m = " + scrut + ";");
    }
    println("  if (__m.ok) {");
    if rkind == "V" {
        println("    (void)0; /* Ok arm: no payload on OoResV */");
    } else {
        println("    OoStr " + ok_bind + " = __m.val;");
    }
    let mut eok: String = env;
    if rkind != "V" {
        eok = c_env_put(env, ok_bind, "T");
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br: List[String] = c_emit_block(toks, p, n, eok);
        p = parse_int(list_get(br, 0));
    } else {
        let st: List[String] = c_emit_stmt(toks, p, n, eok);
        p = parse_int(list_get(st, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    // Err arm
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT"
        || field_at(list_get(toks, p), 3) != "Err"
    {
        println("ERR\tc_emit\tmatch: expected Err(...) arm");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Err(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        err_bind = field_at(list_get(toks, p), 3);
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
        p = p + 1;
    }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Err(...)");
        process_exit(1);
    }
    p = p + 1;
    if rkind == "V" {
        println("    OoStr " + err_bind + " = __m.err;");
    } else {
        println("    OoStr " + err_bind + " = __m.val;");
    }
    let eerr: String = c_env_put(env, err_bind, "T");
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br2: List[String] = c_emit_block(toks, p, n, eerr);
        p = parse_int(list_get(br2, 0));
    } else {
        let st2: List[String] = c_emit_stmt(toks, p, n, eerr);
        p = parse_int(list_get(st2, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" {
        p = p + 1;
    }
    return c_pack_pos_env(p, env);
}
