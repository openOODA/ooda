// # Lower a Result match to C if/else
//
// Logline: Emits Ok/Some then Err/None arms as if (__m.ok) / else, binding payload from OoResS, OoResV, or OoResI.
//
// Setup: toks sit on KW_MATCH; c_emit_expr_c, c_emit_block, c_emit_stmt, c_match_skip_comma, c_pack_pos_env, c_env_get, and c_env_put exist; env V=OoResV, RI=OoResI, else OoResS.
//
// Beats:
//   1. Emit the scrutinee, require Ok/Some(bind) =>, and pick R, V, or RI from env, __ret__, or __respay__.
//   2. Open if (__m.ok), bind the Ok payload (long long val for RI), emit the arm, and skip a trailing comma.
//   3. Require Err/None(bind) =>, bind the Err payload (.err on V/RI), emit the arm, close braces, and pack pos plus env.

// R=OoResS V=OoResV RI=OoResI. Named scrut first; __respay__ if set; __ret__ on call results.
pub fn c_match_rkind(env: String, scrut: String) -> String {
    let sk: String = c_env_get(env, scrut);
    if sk == "V" {
        return "V";
    }
    if sk == "RI" {
        return "RI";
    }
    if sk == "RII" {
        return "RII";
    }
    if sk == "RLI" {
        return "RLI";
    }
    if sk == "RB" {
        return "RB";
    }
    if sk == "RF" {
        return "RF";
    }
    if sk == "RLS" {
        return "RLS";
    }
    if sk == "RLF" {
        return "RLF";
    }
    if chars_len(sk) > 5 {
        if str_slice(sk, 0, 5) == "OoRes" {
            return sk;
        }
    }
    let rp: String = c_env_get(env, "__respay__");
    if rp == "RI" {
        return "RI";
    }
    if rp == "I" {
        return "RI";
    }
    if sk == "R" {
        return "R";
    }
    if c_env_get(env, "__ret__") == "RI" {
        return "RI";
    }
    if c_env_get(env, "__ret__") == "RII" {
        return "RII";
    }
    return "R";
}

pub fn c_emit_match_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let scrut = list_get(pr, 1);
    if p >= n || c_tokk(toks, p) != "LBRACE" {
        println("ERR\tc_emit\tmatch: expected { after scrutinee");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || c_tokk(toks, p) != "IDENT" {
        println("ERR\tc_emit\tmatch: expected Ok(...) arm first");
        process_exit(1);
    }
    if c_tokt(toks, p) != "Ok" {
        if c_tokt(toks, p) != "Some" {
            println("ERR\tc_emit\tmatch: expected Ok(...) arm first");
            process_exit(1);
        }
    }
    p = p + 1;
    if p >= n || c_tokk(toks, p) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Ok(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && c_tokk(toks, p) == "IDENT" { ok_bind = c_tokt(toks, p); p = p + 1; }
    if p < n && c_tokk(toks, p) == "RPAREN" { p = p + 1; }
    if p >= n || c_tokk(toks, p) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Ok(...)");
        process_exit(1);
    }
    p = p + 1;
    // Result kind: R = OoResS (.val both arms), V = OoResV (.err on Err), RI = OoResI
    let rkind: String = c_match_rkind(env, scrut);
    println("  {");
    if rkind == "V" {
        println("  OoResV __m = " + scrut + ";");
    } else if rkind == "RI" {
        println("  OoResI __m = " + scrut + ";");
    } else if rkind == "RII" {
        println("  OoResII __m = " + scrut + ";");
    } else if rkind == "RLI" {
        println("  OoResLI __m = " + scrut + ";");
    } else if rkind == "RB" {
        println("  OoResB __m = " + scrut + ";");
    } else if rkind == "RF" {
        println("  OoResF __m = " + scrut + ";");
    } else if rkind == "RLS" {
        println("  OoResLS __m = " + scrut + ";");
    } else if rkind == "RLF" {
        println("  OoResLF __m = " + scrut + ";");
    } else if chars_len(rkind) > 5 {
        if str_slice(rkind, 0, 5) == "OoRes" {
            println("  " + rkind + " __m = " + scrut + ";");
        } else {
            println("  OoResS __m = " + scrut + ";");
        }
    } else {
        println("  OoResS __m = " + scrut + ";");
    }
    c_emit_src_line(toks, pos, env);
    println("  if (__m.ok) {");
    if rkind == "V" {
        println("    (void)0; /* Ok arm: no payload on OoResV */");
    } else if rkind == "RI" || rkind == "RII" {
        println("    long long " + ok_bind + " = __m.val;");
    } else if rkind == "RLI" {
        println("    OoIList " + ok_bind + " = __m.val;");
    } else if rkind == "RB" {
        println("    int " + ok_bind + " = __m.val;");
    } else if rkind == "RF" {
        println("    double " + ok_bind + " = __m.val;");
    } else if rkind == "RLS" {
        println("    OoSList " + ok_bind + " = __m.val;");
    } else if rkind == "RLF" {
        println("    OoFList " + ok_bind + " = __m.val;");
    } else if chars_len(rkind) > 6 {
        if str_slice(rkind, 0, 6) == "OoRes_" {
            println("    " + str_slice(rkind, 6, chars_len(rkind)) + " " + ok_bind + " = __m.val;");
        } else {
            println("    OoStr " + ok_bind + " = __m.val;");
        }
    } else {
        println("    OoStr " + ok_bind + " = __m.val;");
    }
    let mut eok: String = env;
    if rkind == "R" {
        eok = c_env_put(env, ok_bind, "T");
    }
    oo_emit_tmp_enter();
    if p < n && c_tokk(toks, p) == "LBRACE" {
        let br: List[String] = c_emit_block(toks, p, n, eok);
        p = parse_int(list_get(br, 0));
    } else {
        let st: List[String] = c_emit_stmt(toks, p, n, eok);
        p = parse_int(list_get(st, 0));
    }
    oo_emit_tmp_leave();
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    // Err arm
    if p >= n || c_tokk(toks, p) != "IDENT" {
        println("ERR\tc_emit\tmatch: expected Err(...) arm");
        process_exit(1);
    }
    let a2: String = c_tokt(toks, p);
    if a2 != "Err" {
        if a2 != "None" {
            println("ERR\tc_emit\tmatch: expected Err(...) arm");
            process_exit(1);
        }
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && c_tokk(toks, p) == "LPAREN" {
        p = p + 1;
        if p < n && c_tokk(toks, p) == "IDENT" {
            err_bind = c_tokt(toks, p);
            p = p + 1;
        }
        if p < n && c_tokk(toks, p) == "RPAREN" {
            p = p + 1;
        }
    }
    if p >= n || c_tokk(toks, p) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Err(...)");
        process_exit(1);
    }
    p = p + 1;
    if rkind == "R" {
        println("    OoStr " + err_bind + " = __m.val;");
    } else if rkind == "RII" {
        println("    long long " + err_bind + " = __m.err;");
    } else {
        println("    OoStr " + err_bind + " = __m.err;");
    }
    let mut eerr: String = c_env_put(env, err_bind, "T");
    if rkind == "RII" {
        eerr = env;
    }
    oo_emit_tmp_enter();
    if p < n && c_tokk(toks, p) == "LBRACE" {
        let br2: List[String] = c_emit_block(toks, p, n, eerr);
        p = parse_int(list_get(br2, 0));
    } else {
        let st2: List[String] = c_emit_stmt(toks, p, n, eerr);
        p = parse_int(list_get(st2, 0));
    }
    oo_emit_tmp_leave();
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && c_tokk(toks, p) == "RBRACE" {
        p = p + 1;
    }
    return c_pack_pos_env(p, env);
}
