// # Detect List[Int] bindings by name
//
// Logline: A let name annotated List[Int] is an Int list for list_push checks.
//
// Setup: toks are the check stream. name is the first list_push argument IDENT.
//
// Beats:
//   1. Walk KW_LET / KW_MUT then IDENT.
//   2. Require COLON List [ Int ].
//   3. Return true when the name matches.

pub fn tc_name_is_int_list(toks: List[String], name: String) -> Bool {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_LET" || k == "KW_MUT" {
            let mut p: Int = i + 1;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    p = p + 1;
                }
            }
            if p < n {
                if field_at(list_get(toks, p), 0) == "IDENT" {
                    if field_at(list_get(toks, p), 3) == name {
                        p = p + 1;
                        if p < n {
                            if field_at(list_get(toks, p), 0) == "COLON" {
                                p = p + 1;
                                if p < n {
                                    if field_at(list_get(toks, p), 0) == "IDENT" {
                                        if field_at(list_get(toks, p), 3) == "List" {
                                            p = p + 1;
                                            if p < n {
                                                if field_at(list_get(toks, p), 0) == "LBRACKET" {
                                                    p = p + 1;
                                                    if p < n {
                                                        if field_at(list_get(toks, p), 0) == "IDENT" {
                                                            if field_at(list_get(toks, p), 3) == "Int" {
                                                                return true;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}
