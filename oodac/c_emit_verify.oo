// # Emit verify blocks as GCC constructors
//
// Logline: Lower verify Name { stmts } to a constructor that runs only when OODA_TEST is set.
//
// Setup: c_emit_block exists. ooda test sets OODA_TEST=1 on the child. ooda run does not.
//
// Beats:
//   1. If the token is not KW_VERIFY, return pos unchanged.
//   2. Read the optional name and emit a constructor that returns unless getenv("OODA_TEST").
//   3. Emit the block, print OK verify, and close the function.

pub fn c_emit_verify_ctor(toks: List[String], pos: Int, n: Int, fn_env: String) -> Int {
    let mut p: Int = pos;
    if p >= n {
        return p;
    }
    if field_at(list_get(toks, p), 0) != "KW_VERIFY" {
        return p;
    }
    p = p + 1;
    let mut vname: String = "anon";
    if p < n {
        if field_at(list_get(toks, p), 0) == "IDENT" {
            vname = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
    }
    if p >= n {
        return c_emit_skip_verify(toks, pos, n);
    }
    if field_at(list_get(toks, p), 0) != "LBRACE" {
        return c_emit_skip_verify(toks, pos, n);
    }
    let ps: String = pos.to_string();
    let cname: String = "__oo_verify_" + vname + "_" + ps;
    println("");
    println("static void " + cname + "(void) __attribute__((constructor));");
    println("static void " + cname + "(void) {");
    println("  const char *__oot = getenv(\"OODA_TEST\");");
    println("  if (__oot == NULL || __oot[0] == 0) { return; }");
    let br: List[String] = c_emit_block(toks, p, n, fn_env);
    p = parse_int(list_get(br, 0));
    println("  fprintf(stdout, \"OK verify\\n\");");
    println("}");
    return p;
}
