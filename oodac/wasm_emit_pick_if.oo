// # Extra-emit WASM const-print if pick
//
// Logline: Tries named const-if print folds; empty string means miss.
//
// Setup: Sibling wasm_emit_if*.oo detectors. fname is the user function name.
//
// Beats:
//   1. Try true/false, no-else, compare, else-if, not, and, or.
//   2. Try paren bool/INT compare and nested const if.
//   3. Return the first non-empty taken-branch text.
//
// residual: IDENT bool via wif_bool_let now handled in wasm_emit_if.

import "wasm_emit_if.oo";
import "wasm_emit_if_noelse.oo";
import "wasm_emit_iffalse.oo";
import "wasm_emit_ifeq.oo";
import "wasm_emit_neq.oo";
import "wasm_emit_iflt.oo";
import "wasm_emit_ifgt.oo";
import "wasm_emit_iflte.oo";
import "wasm_emit_ifgte.oo";
import "wasm_emit_elseif.oo";
import "wasm_emit_ifnot.oo";
import "wasm_emit_ifand.oo";
import "wasm_emit_ifor.oo";
import "wasm_emit_ifparen.oo";
import "wasm_emit_ifeqne.oo";
import "wasm_emit_ifnest.oo";
import "wasm_emit_ifpeq.oo";
import "wasm_emit_neqne.oo";
import "wasm_emit_ltne.oo";
import "wasm_emit_gtne.oo";
import "wasm_emit_ltene.oo";
import "wasm_emit_gtene.oo";
import "wasm_emit_ifpneq.oo";
import "wasm_emit_ifplt.oo";
import "wasm_emit_ifpgt.oo";
import "wasm_emit_ifplte.oo";
import "wasm_emit_ifpgte.oo";
import "wasm_emit_ifnotne.oo";
import "wasm_emit_ifandne.oo";
import "wasm_emit_iforne.oo";
import "wasm_emit_ifparenne.oo";
import "wasm_emit_ifpeqne.oo";
import "wasm_emit_ifpneqne.oo";
import "wasm_emit_ifpltne.oo";
import "wasm_emit_ifpgtne.oo";
import "wasm_emit_ifpltene.oo";
import "wasm_emit_ifpgtene.oo";
import "wasm_emit_ifpandne.oo";
import "wasm_emit_ifporne.oo";
import "wasm_emit_ifpnotne.oo";
import "wasm_emit_ifnestne.oo";
import "wasm_emit_ifeqandne.oo";
import "wasm_emit_ifeqorne.oo";
import "wasm_emit_ifpeqandne.oo";
import "wasm_emit_ifpeqorne.oo";
import "wasm_emit_ifnoteqne.oo";
import "wasm_emit_ifdparenne.oo";
import "wasm_emit_ifneqandne.oo";
import "wasm_emit_ifpnoteqne.oo";
import "wasm_emit_ifneqorne.oo";
import "wasm_emit_ifpneqandne.oo";
import "wasm_emit_ifltandne.oo";

pub fn wasm_try_if_fold(src: String, name: String) -> String {
    let mut lit: String = wasm_fn_if_println(src, name);
    if chars_len(lit) <= 0 { lit = wasm_fn_if_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_false_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_eq(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_neq(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_lt(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_gt(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_lte(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_gte(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_elseif(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_not(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_and(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_or(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_eq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_nest(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_eq(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_neq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_lt_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_gt_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_lte_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_gte_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_neq(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_lt(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_gt(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_lte(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_gte(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_not_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_or_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_eq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_neq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_lt_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_gt_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_lte_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_gte_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_or_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_not_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_nest_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_eq_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_eq_or_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_eq_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_eq_or_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_not_eq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_dparen_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_neq_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_not_eq_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_neq_or_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_paren_neq_and_noelse(src, name); }
    if chars_len(lit) <= 0 { lit = wasm_fn_if_lt_and_noelse(src, name); }
    return lit;
}
