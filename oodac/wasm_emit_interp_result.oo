// # WASM Result/Option/sum interpreter
// Logline: Resolves Result/Option/sum tags and match arms for wasm dummy.
// Setup: tokenize_lines + wi_kind/wi_text + lookup_let exist.
// Beats:
//   1. Find fn tag via return Ok/Err/Some/None or sum.
//   2. Lookup let tag for var.
//   3. Match scrutinee tag then find println in taken arm.
import "token_fmt.oo";
import "tc_parse_int.oo";
import "wasm_emit_interp_util.oo";
fn fr_tag(toks: List[String], n: Int, fname: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i+1 < n {
        if wi_kind(toks,i)=="KW_FN" && wi_text(toks,i+1)==fname {
            let mut p: Int = i+2;
            while p < n && wi_kind(toks,p)!="LBRACE" { p=p+1; }
            if p>=n { return out; } p=p+1;
            while p+1 < n {
                if wi_kind(toks,p)=="KW_RETURN" {
                    if wi_kind(toks,p+1)=="IDENT" {
                        let tag: String = wi_text(toks,p+1);
                        if p+2 < n && wi_kind(toks,p+2)=="LPAREN" {
                            if p+3 < n && wi_kind(toks,p+3)=="RPAREN" { out=list_push(out,tag); out=list_push(out,""); return out; }
                            if p+3 < n {
                                let k: String = wi_kind(toks,p+3);
                                if k=="STRING" || k=="INT" || k=="FLOAT" || k=="KW_TRUE" || k=="KW_FALSE" || k=="IDENT" {
                                    let mut pay: String = wi_text(toks,p+3);
                                    if pay=="true" || pay=="false" || k=="KW_TRUE" || k=="KW_FALSE" {
                                        if pay=="true" || wi_text(toks,p+3)=="true" { pay="true"; } else { pay="false"; }
                                    }
                                    out=list_push(out,tag); out=list_push(out,pay); return out;
                                }
                            }
                        } else {
                            out=list_push(out,tag); out=list_push(out,""); return out;
                        }
                    }
                }
                if wi_kind(toks,p)=="RBRACE" { return out; }
                p=p+1;
            }
        }
        i=i+1;
    }
    return out;
}
fn lk_tag(toks: List[String], lb: Int, lim: Int, name: String) -> List[String] {
    let mut p: Int = lb+1;
    let mut out: List[String] = list_new();
    while p+3 < lim {
        if wi_kind(toks,p)=="KW_LET" && wi_text(toks,p+1)==name && wi_kind(toks,p+2)=="EQ" {
            if wi_kind(toks,p+3)=="IDENT" {
                let tag: String = wi_text(toks,p+3);
                if p+4 < lim && wi_kind(toks,p+4)=="LPAREN" {
                    if p+5 < lim && wi_kind(toks,p+5)=="RPAREN" { out=list_push(out,tag); out=list_push(out,""); return out; }
                    if p+5 < lim {
                        let k2: String = wi_kind(toks,p+5);
                        if k2=="STRING" || k2=="INT" || k2=="FLOAT" || k2=="KW_TRUE" || k2=="KW_FALSE" || k2=="IDENT" {
                            let mut pay2: String = wi_text(toks,p+5);
                            if wi_kind(toks,p+5)=="KW_TRUE" || pay2=="true" { pay2="true"; } else if wi_kind(toks,p+5)=="KW_FALSE" || pay2=="false" { pay2="false"; }
                            else if k2=="IDENT" {
                                let v: List[String] = lookup_let(toks,lb,p+5,pay2);
                                if list_len(v)==2 { pay2=list_get(v,1); }
                            }
                            out=list_push(out,tag); out=list_push(out,pay2); return out;
                        }
                    }
                } else {
                    if p+4 < lim && wi_kind(toks,p+4)=="LPAREN" && wi_kind(toks,p+5)=="RPAREN" {
                        let r: List[String] = fr_tag(toks,list_len(toks),tag);
                        if list_len(r)==2 { return r; }
                    }
                    let r2: List[String] = fr_tag(toks,list_len(toks),tag);
                    if list_len(r2)==2 { return r2; }
                    out=list_push(out,tag); out=list_push(out,""); return out;
                }
            }
        }
        p=p+1;
    }
    return out;
}
fn scr_tag(toks: List[String], n: Int, p: Int, lb: Int) -> List[String] {
    let mut out: List[String] = list_new();
    if p+1 >= n { return out; }
    let k1: String = wi_kind(toks,p+1);
    let t1: String = wi_text(toks,p+1);
    if k1=="IDENT" {
        if p+2 < n && wi_kind(toks,p+2)=="LPAREN" {
            let mut rp: Int = p+2;
            while rp < n && wi_kind(toks,rp)!="RPAREN" { rp=rp+1; }
            if rp < n {
                let mut lbr: Int = rp+1;
                while lbr < n && wi_kind(toks,lbr)!="LBRACE" && wi_kind(toks,lbr)!="COMMA" && wi_kind(toks,lbr)!="SEMI" { lbr=lbr+1; }
                if lbr < n && wi_kind(toks,lbr)=="LBRACE" {
                    let ft: List[String] = fr_tag(toks,n,t1);
                    if list_len(ft)==2 { return ft; }
                    if rp==p+3 { out=list_push(out,t1); out=list_push(out,""); return out; }
                    if p+3 < n {
                        let pk: String = wi_kind(toks,p+3);
                        if pk=="STRING" || pk=="INT" || pk=="FLOAT" || pk=="KW_TRUE" || pk=="KW_FALSE" || pk=="IDENT" {
                            let mut pay: String = wi_text(toks,p+3);
                            out=list_push(out,t1); out=list_push(out,pay); return out;
                        }
                    }
                    out=list_push(out,t1); out=list_push(out,""); return out;
                }
            }
        }
        let lk: List[String] = lk_tag(toks,lb,n,t1);
        if list_len(lk)==2 { return lk; }
        let ft2: List[String] = fr_tag(toks,n,t1);
        if list_len(ft2)==2 { return ft2; }
    }
    return out;
}
fn arm_out(toks: List[String], n: Int, lb: Int, tag: String, pay: String, mpos: Int) -> String {
    let mut lbr: Int = mpos+1;
    while lbr < n && wi_kind(toks,lbr)!="LBRACE" { lbr=lbr+1; }
    if lbr>=n { return ""; }
    let mut rbr: Int = lbr+1;
    let mut d: Int = 1;
    while rbr < n && d>0 { if wi_kind(toks,rbr)=="LBRACE" { d=d+1; } else if wi_kind(toks,rbr)=="RBRACE" { d=d-1; } rbr=rbr+1; }
    rbr=rbr-1;
    let mut cur: Int = lbr+1;
    while cur < rbr {
        if wi_kind(toks,cur)!="IDENT" { cur=cur+1; continue; }
        let pat: String = wi_text(toks,cur);
        let mut bind: String = "";
        let mut ap: Int = cur+1;
        if ap < rbr && wi_kind(toks,ap)=="LPAREN" {
            if ap+1 < rbr && wi_kind(toks,ap+1)=="IDENT" { bind=wi_text(toks,ap+1); }
            while ap < rbr && wi_kind(toks,ap)!="RPAREN" { ap=ap+1; }
            if ap < rbr { ap=ap+1; }
        }
        while ap < rbr && wi_kind(toks,ap)!="FATARROW" && wi_text(toks,ap)!="=>" { ap=ap+1; }
        if ap>=rbr { cur=cur+1; continue; }
        ap=ap+1;
        let mut arm_end: Int = ap;
        while arm_end < rbr && wi_kind(toks,arm_end)!="COMMA" {
            if wi_kind(toks,arm_end)=="LBRACE" { let mut dd: Int=1; arm_end=arm_end+1; while arm_end < rbr && dd>0 { if wi_kind(toks,arm_end)=="LBRACE" {dd=dd+1;} else if wi_kind(toks,arm_end)=="RBRACE" {dd=dd-1;} arm_end=arm_end+1; } } else { arm_end=arm_end+1; }
        }
        if pat==tag {
            let mut q: Int = ap;
            while q < arm_end {
                if wi_kind(toks,q)=="IDENT" && wi_text(toks,q)=="println" && q+1 < arm_end && wi_kind(toks,q+1)=="LPAREN" {
                    if q+2 < arm_end {
                        let ak: String = wi_kind(toks,q+2);
                        let at: String = wi_text(toks,q+2);
                        if ak=="STRING" { return at+"\n"; }
                        if ak=="INT" || ak=="FLOAT" { return at+"\n"; }
                        if ak=="KW_TRUE" || at=="true" { return "true\n"; }
                        if ak=="KW_FALSE" || at=="false" { return "false\n"; }
                        if ak=="IDENT" {
                            if q+3 < arm_end && wi_kind(toks,q+3)=="DOT" {
                                let v2: List[String] = lookup_let(toks,lb,q+2,at);
                                if list_len(v2)==2 { return list_get(v2,1)+"\n"; }
                                let e2: String = eval_str(toks,q+2,n,lb);
                                if chars_len(e2)>0 { return e2+"\n"; }
                                let e3: String = eval_int(toks,q+2,n,lb);
                                if chars_len(e3)>0 { return e3+"\n"; }
                                return at+"\n";
                            }
                            let v: List[String] = lookup_let(toks,lb,q+2,at);
                            if list_len(v)==2 { return list_get(v,1)+"\n"; }
                            let es: String = eval_str(toks,q+2,n,lb);
                            if chars_len(es)>0 { return es+"\n"; }
                            let ei: String = eval_int(toks,q+2,n,lb);
                            if chars_len(ei)>0 { return ei+"\n"; }
                            if chars_len(pay)>0 { return pay+"\n"; }
                            return at+"\n";
                        }
                    }
                }
                q=q+1;
            }
            return "";
        }
        cur=arm_end+1;
    }
    return "";
}
pub fn wasm_interp_match(toks: List[String], n: Int, p: Int, lb: Int) -> String {
    let mut q: Int = p-1;
    while q > lb {
        if wi_kind(toks,q)=="SEMI" || wi_kind(toks,q)=="RBRACE" || wi_kind(toks,q)=="LBRACE" { break; }
        if wi_kind(toks,q)=="KW_LET" { return ""; }
        q = q-1;
    }
    let tp: List[String] = scr_tag(toks,n,p,lb);
    if list_len(tp)!=2 { return ""; }
    let tag: String = list_get(tp,0);
    let mut pay: String = list_get(tp,1);
    return arm_out(toks,n,lb,tag,pay,p);
}
pub fn wasm_interp_result_out(toks: List[String], n: Int, lb: Int, p: Int) -> String { return wasm_interp_match(toks,n,p,lb); }
