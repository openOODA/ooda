// # Detect nested const if true println fold
//
// Logline: Returns the taken inner STRING when a function body is only if BOOL { if BOOL { println } else { println } } else { println }.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept outer if KW_TRUE/KW_FALSE wrapping an inner if KW_TRUE/KW_FALSE with else, then an outer else.
//   3. Return inner then, inner else, or outer else. IDENT conditions miss.
//
// residual: nested IDENT if stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wns_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wns_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wns_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wns_kind(toks, p) != "IDENT" || wns_text(toks, p) != "println" { return empty; }
    if wns_kind(toks, p + 1) != "LPAREN" || wns_kind(toks, p + 2) != "STRING" { return empty; }
    if wns_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wns_text(toks, p + 2);
    p = p + 4;
    if p < n && wns_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn wns_is_bool(k: String) -> Bool {
    if k == "KW_TRUE" { return true; }
    if k == "KW_FALSE" { return true; }
    return false;
}

pub fn wasm_fn_if_nest(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wns_kind(toks, i) == "KW_FN" && wns_kind(toks, i + 1) == "IDENT" {
            if wns_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wns_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 2 >= n || wns_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let ok: String = wns_kind(toks, p);
                if !wns_is_bool(ok) { return ""; }
                let outer_t: Bool = ok == "KW_TRUE";
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                if p + 2 >= n || wns_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let ik: String = wns_kind(toks, p);
                if !wns_is_bool(ik) { return ""; }
                let inner_t: Bool = ik == "KW_TRUE";
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let ith: List[String] = wns_one_str_println(toks, p, n);
                if list_len(ith) < 2 { return ""; }
                p = parse_int(list_get(ith, 1));
                if p >= n || wns_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "KW_ELSE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let iel: List[String] = wns_one_str_println(toks, p, n);
                if list_len(iel) < 2 { return ""; }
                p = parse_int(list_get(iel, 1));
                if p >= n || wns_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "KW_ELSE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let oel: List[String] = wns_one_str_println(toks, p, n);
                if list_len(oel) < 2 { return ""; }
                p = parse_int(list_get(oel, 1));
                if p >= n || wns_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wns_kind(toks, p) != "RBRACE" { return ""; }
                if !outer_t { return list_get(oel, 0); }
                if inner_t { return list_get(ith, 0); }
                return list_get(iel, 0);
            }
        }
        i = i + 1;
    }
    return "";
}
