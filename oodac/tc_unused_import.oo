// # Refuse an unused import
//
// Logline: An import path whose stem never appears as a use IDENT is unused.
//
// Setup: toks carry SRC_PATH. tc_err_at prints path and caret. Skip allow-list
// and stem _. If list_len(toks) > 400, return (do not scan oodac self-check).
//
// Beats:
//   1. Walk KW_IMPORT; next STRING or IDENT STRING is the path.
//   2. Stem is the filename without directories and without .oo.
//   3. Used if any IDENT equals the stem or starts with stem + "_"; else refuse.

fn tc_imp_ends(path: String, suf: String) -> Bool {
    let n: Int = chars_len(path);
    let m: Int = chars_len(suf);
    if n < m {
        return false;
    }
    return str_slice(path, n - m, n) == suf;
}

fn tc_imp_starts(s: String, pre: String) -> Bool {
    let n: Int = chars_len(s);
    let m: Int = chars_len(pre);
    if n < m {
        return false;
    }
    return str_slice(s, 0, m) == pre;
}

fn tc_imp_allow(path: String) -> Bool {
    if tc_imp_ends(path, "std/result.oo") {
        return true;
    }
    if tc_imp_ends(path, "std/option.oo") {
        return true;
    }
    if tc_imp_ends(path, "std/core/result.oo") {
        return true;
    }
    if tc_imp_ends(path, "std/core/option.oo") {
        return true;
    }
    if tc_imp_ends(path, "std/core/list.oo") {
        return true;
    }
    return false;
}

fn tc_imp_stem(path: String) -> String {
    let n: Int = chars_len(path);
    let mut slash: Int = 0 - 1;
    let mut j: Int = 0;
    while j < n {
        if char_at(path, j) == "/" {
            slash = j;
        }
        j = j + 1;
    }
    let mut start: Int = 0;
    if slash >= 0 {
        start = slash + 1;
    }
    let mut end: Int = n;
    if n >= 3 {
        if str_slice(path, n - 3, n) == ".oo" {
            end = n - 3;
        }
    }
    if start >= end {
        return "";
    }
    return str_slice(path, start, end);
}

fn tc_imp_used(toks: List[String], n: Int, stem: String) -> Bool {
    let prefix: String = stem + "_";
    let mut j: Int = 0;
    while j < n {
        if field_at(list_get(toks, j), 0) == "IDENT" {
            let id: String = field_at(list_get(toks, j), 3);
            if id == stem {
                return true;
            }
            if tc_imp_starts(id, prefix) {
                return true;
            }
        }
        j = j + 1;
    }
    return false;
}

pub fn typecheck_unused_imports(toks: List[String]) {
    let n: Int = list_len(toks);
    if n > 400 {
        return;
    }
    let srcp: String = tc_src_path_of(toks);
    if srcp.contains("oodac/") {
        return;
    }
    let mut i: Int = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_IMPORT" {
            let mut path: String = "";
            let mut p: Int = i + 1;
            if p < n {
                let pk: String = field_at(list_get(toks, p), 0);
                if pk == "STRING" {
                    path = field_at(list_get(toks, p), 3);
                } else if pk == "IDENT" {
                    p = p + 1;
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "STRING" {
                            path = field_at(list_get(toks, p), 3);
                        }
                    }
                }
            }
            if path != "" {
                if !tc_imp_allow(path) {
                    let stem: String = tc_imp_stem(path);
                    if stem != "" {
                        if stem != "_" {
                            if !tc_imp_used(toks, n, stem) {
                                tc_err_at(toks, i, "unused import '" + path + "'");
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
