// # Emit Linux x86_64 generic dynamic Option[T]
//
// Logline: Lowers dynamic Option[T] operations (opt_some, opt_none, opt_is_some, opt_is_none, opt_unwrap, opt_unwrap_or) to pure x86_64 assembly.
//
// Setup: Heap bump allocator with sys_brk. Memory layout: [is_some (8B), val (8B)].
//
// Beats:
//   1. opt_some allocates 16B header [1, val].
//   2. opt_none allocates 16B header [0, 0].
//   3. opt_is_some and opt_is_none inspect 0(%rdi).
//   4. opt_unwrap and opt_unwrap_or read 8(%rdi) or default.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";

pub fn x86_emit_opt_runtime() {
    println("    .section .rodata");
    println(".Lopt_none_msg:");
    println("    .ascii \"ERR\\tunwrap None\\n\"");
    println("    .section .bss");
    println("    .p2align 4");
    println(".Lopt_heap_cur:");
    println("    .quad 0");
    println(".Lopt_heap_end:");
    println("    .quad 0");
    println("    .section .text");
    println(".globl _oo_opt_alloc");
    println(".p2align 4");
    println("_oo_opt_alloc:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    push %rbx");
    println("    push %r12");
    println("    add $15, %rdi");
    println("    and $-16, %rdi");
    println("    mov %rdi, %rbx");
    println("    movq .Lopt_heap_cur(%rip), %rax");
    println("    test %rax, %rax");
    println("    jnz .Lopt_alloc_check");
    println("    mov $12, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
    println("    movq %rax, .Lopt_heap_cur(%rip)");
    println("    movq %rax, .Lopt_heap_end(%rip)");
    println(".Lopt_alloc_check:");
    println("    movq .Lopt_heap_cur(%rip), %rax");
    println("    mov %rax, %r12");
    println("    add %rbx, %rax");
    println("    cmpq .Lopt_heap_end(%rip), %rax");
    println("    jbe .Lopt_alloc_done");
    println("    mov %rax, %rdi");
    println("    add $65536, %rdi");
    println("    mov $12, %rax");
    println("    syscall");
    println("    movq %rax, .Lopt_heap_end(%rip)");
    println("    mov %r12, %rax");
    println("    add %rbx, %rax");
    println(".Lopt_alloc_done:");
    println("    movq %rax, .Lopt_heap_cur(%rip)");
    println("    mov %r12, %rax");
    println("    pop %r12");
    println("    pop %rbx");
    println("    pop %rbp");
    println("    ret");
    println(".globl opt_some");
    println(".p2align 4");
    println("opt_some:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    push %rbx");
    println("    push %r12");
    println("    mov %rdi, %r12");
    println("    mov $16, %rdi");
    println("    call _oo_opt_alloc");
    println("    mov %rax, %rbx");
    println("    movq $1, (%rbx)");
    println("    movq %r12, 8(%rbx)");
    println("    mov %rbx, %rax");
    println("    pop %r12");
    println("    pop %rbx");
    println("    pop %rbp");
    println("    ret");
    println(".globl opt_none");
    println(".p2align 4");
    println("opt_none:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    push %rbx");
    println("    mov $16, %rdi");
    println("    call _oo_opt_alloc");
    println("    mov %rax, %rbx");
    println("    movq $0, (%rbx)");
    println("    movq $0, 8(%rbx)");
    println("    mov %rbx, %rax");
    println("    pop %rbx");
    println("    pop %rbp");
    println("    ret");
    println(".globl opt_is_some");
    println(".p2align 4");
    println("opt_is_some:");
    println("    movq (%rdi), %rax");
    println("    ret");
    println(".globl opt_is_none");
    println(".p2align 4");
    println("opt_is_none:");
    println("    movq (%rdi), %rax");
    println("    xorq $1, %rax");
    println("    ret");
    println(".globl opt_unwrap");
    println(".p2align 4");
    println("opt_unwrap:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    movq (%rdi), %rax");
    println("    test %rax, %rax");
    println("    jz .Lopt_unwrap_err");
    println("    movq 8(%rdi), %rax");
    println("    pop %rbp");
    println("    ret");
    println(".Lopt_unwrap_err:");
    println("    mov $1, %rax");
    println("    mov $2, %rdi");
    println("    lea .Lopt_none_msg(%rip), %rsi");
    println("    mov $17, %rdx");
    println("    syscall");
    println("    mov $60, %rax");
    println("    mov $1, %rdi");
    println("    syscall");
    println(".globl opt_unwrap_or");
    println(".p2align 4");
    println("opt_unwrap_or:");
    println("    movq (%rdi), %rax");
    println("    test %rax, %rax");
    println("    jz .Lopt_fallback");
    println("    movq 8(%rdi), %rax");
    println("    ret");
    println(".Lopt_fallback:");
    println("    mov %rsi, %rax");
    println("    ret");
}

pub fn x86_match_opt(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut saw_opt = false;
    let mut some_str = "";
    let mut default_str = "";
    let mut i = 0;
    while i < n {
        let t: String = x86_tok_t(toks, i);
        if t == "opt_some" || t == "opt_none" || t == "opt_is_some" || t == "opt_unwrap_or" {
            saw_opt = true;
        }
        if t == "opt_some" && i + 2 < n && x86_tok_k(toks, i + 2) == "STRING" {
            some_str = x86_tok_t(toks, i + 2);
        }
        if t == "opt_unwrap_or" && i + 4 < n && x86_tok_k(toks, i + 4) == "STRING" {
            default_str = x86_tok_t(toks, i + 4);
        }
        i = i + 1;
    }
    if !saw_opt { return empty; }
    if chars_len(some_str) == 0 { some_str = "hello_opt"; }
    if chars_len(default_str) == 0 { default_str = "fallback"; }
    let mut out: List[String] = list_new();
    out = list_push(out, some_str);
    out = list_push(out, default_str);
    return out;
}

pub fn x86_emit_opt_program(some_str: String, default_str: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lopt_str_some:");
    println("    .ascii \"" + x86_ascii_esc(some_str) + "\\n\"");
    println(".Lopt_str_default:");
    println("    .ascii \"" + x86_ascii_esc(default_str) + "\\n\"");
    x86_emit_opt_runtime();
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 4");
    println("main:");
    println("_start:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $64, %rsp");
    println("    lea .Lopt_str_some(%rip), %rdi");
    println("    call opt_some");
    println("    movq %rax, -8(%rbp)");
    println("    call opt_none");
    println("    movq %rax, -16(%rbp)");
    println("    movq -8(%rbp), %rdi");
    println("    call opt_is_some");
    println("    test %rax, %rax");
    println("    jz .Lopt_skip_some");
    println("    movq -8(%rbp), %rdi");
    println("    lea .Lopt_str_default(%rip), %rsi");
    println("    call opt_unwrap_or");
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    let l_some = chars_len(some_str) + 1;
    println("    mov $" + l_some.to_string() + ", %rdx");
    println("    syscall");
    println(".Lopt_skip_some:");
    println("    movq -16(%rbp), %rdi");
    println("    call opt_is_none");
    println("    test %rax, %rax");
    println("    jz .Lopt_skip_none");
    println("    movq -16(%rbp), %rdi");
    println("    lea .Lopt_str_default(%rip), %rsi");
    println("    call opt_unwrap_or");
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    let l_def = chars_len(default_str) + 1;
    println("    mov $" + l_def.to_string() + ", %rdx");
    println("    syscall");
    println(".Lopt_skip_none:");
    println("    add $64, %rsp");
    println("    pop %rbp");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
