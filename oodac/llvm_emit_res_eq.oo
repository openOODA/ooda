// # Compare two %OoResI values
//
// Logline: Equality of Int Results uses the ok tag and the i64 payload, not a String Result helper.
//
// Setup: Called from llvm_apply_binop on EQEQ/NEQ when both sides are %OoResI.
//
// Beats:
//   1. Extract tags and i64 Ok payloads.
//   2. And tag-equal with payload-equal.
//   3. Invert for !=. Yield i32.

import "llvm_emit_env.oo";

fn llvm_req_env(src: List[String]) -> List[String] {
    let mut e: List[String] = list_new();
    e = list_push(e, list_get(src, 1));
    e = list_push(e, list_get(src, 2));
    e = list_push(e, list_get(src, 3));
    e = list_push(e, list_get(src, 4));
    e = list_push(e, list_get(src, 5));
    return e;
}

pub fn llvm_apply_res_eq_i(op_k: String, lhs: String, rhs: String, env: List[String]) -> List[String] {
    let mut cur_env: List[String] = env;
    let g0: List[String] = llvm_gen_reg(cur_env);
    let tl: String = list_get(g0, 0);
    cur_env = llvm_req_env(g0);
    let g1: List[String] = llvm_gen_reg(cur_env);
    let tr: String = list_get(g1, 0);
    cur_env = llvm_req_env(g1);
    let g2: List[String] = llvm_gen_reg(cur_env);
    let te: String = list_get(g2, 0);
    cur_env = llvm_req_env(g2);
    let g3: List[String] = llvm_gen_reg(cur_env);
    let vl: String = list_get(g3, 0);
    cur_env = llvm_req_env(g3);
    let g4: List[String] = llvm_gen_reg(cur_env);
    let vr: String = list_get(g4, 0);
    cur_env = llvm_req_env(g4);
    let g5: List[String] = llvm_gen_reg(cur_env);
    let ve: String = list_get(g5, 0);
    cur_env = llvm_req_env(g5);
    let g6: List[String] = llvm_gen_reg(cur_env);
    let both: String = list_get(g6, 0);
    cur_env = llvm_req_env(g6);
    let g7: List[String] = llvm_gen_reg(cur_env);
    let outv: String = list_get(g7, 0);
    cur_env = llvm_req_env(g7);
    println("  " + tl + " = extractvalue %OoResI " + lhs + ", 0");
    println("  " + tr + " = extractvalue %OoResI " + rhs + ", 0");
    println("  " + te + " = icmp eq i32 " + tl + ", " + tr);
    println("  " + vl + " = extractvalue %OoResI " + lhs + ", 1");
    println("  " + vr + " = extractvalue %OoResI " + rhs + ", 1");
    println("  " + ve + " = icmp eq i64 " + vl + ", " + vr);
    let ge1: List[String] = llvm_gen_reg(cur_env);
    let el: String = list_get(ge1, 0);
    cur_env = llvm_req_env(ge1);
    let ge2: List[String] = llvm_gen_reg(cur_env);
    let er: String = list_get(ge2, 0);
    cur_env = llvm_req_env(ge2);
    let ge3: List[String] = llvm_gen_reg(cur_env);
    let es: String = list_get(ge3, 0);
    cur_env = llvm_req_env(ge3);
    let ge4: List[String] = llvm_gen_reg(cur_env);
    let e1: String = list_get(ge4, 0);
    cur_env = llvm_req_env(ge4);
    let ge5: List[String] = llvm_gen_reg(cur_env);
    let lok: String = list_get(ge5, 0);
    cur_env = llvm_req_env(ge5);
    let ge6: List[String] = llvm_gen_reg(cur_env);
    let pay: String = list_get(ge6, 0);
    cur_env = llvm_req_env(ge6);
    println("  " + el + " = extractvalue %OoResI " + lhs + ", 2");
    println("  " + er + " = extractvalue %OoResI " + rhs + ", 2");
    println("  " + es + " = call i32 @oo_str_eq(%OoStr " + el + ", %OoStr " + er + ")");
    println("  " + e1 + " = icmp ne i32 " + es + ", 0");
    println("  " + lok + " = icmp ne i32 " + tl + ", 0");
    println("  " + pay + " = select i1 " + lok + ", i1 " + ve + ", i1 " + e1);
    println("  " + both + " = and i1 " + te + ", " + pay);
    if op_k == "NEQ" {
        let gi: List[String] = llvm_gen_reg(cur_env);
        let inv: String = list_get(gi, 0);
        cur_env = llvm_req_env(gi);
        println("  " + inv + " = xor i1 " + both + ", true");
        println("  " + outv + " = zext i1 " + inv + " to i32");
    } else {
        println("  " + outv + " = zext i1 " + both + " to i32");
    }
    let mut out: List[String] = list_new();
    out = list_push(out, outv);
    out = list_push(out, "i32");
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
