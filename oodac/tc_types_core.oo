// # Resolve the typecheck type lattice
//
// Logline: Looks up type aliases, maps literal tokens to types, tests annotation compatibility, and combines binary-operator types.
//
// Setup: aliases is a tab-separated name:Type map; first match wins, so callers reset env per function; mixed arith and non-Int bitops return ERR_BINOP.
//
// Beats:
//   1. resolve_type_alias returns the bound type or the original name; lit_token_type maps INT, FLOAT, STRING, true, and false.
//   2. types_compatible is an exact match plus i64 to Int and f64 to Float.
//   3. is_type_binop lists arith, compare, and Int bitops; combine_binop_types returns String, Int, Float, Bool, or ERR_BINOP.

pub fn resolve_type_alias(aliases: String, ann: String) -> String {
    // Inline lookup (same format as env_lookup_type) to avoid any call-order edge.
    // First match: callers that append rebinds must reset env per function
    // (see lit_env_bind_fn_params) so earlier fn lets do not poison later fns.
    let key = "\t" + ann + ":";
    if !aliases.contains(key) {
        return ann;
    }
    let tn = chars_len(aliases);
    let kn = chars_len(key);
    let mut pos = 0;
    while pos + kn <= tn {
        let mut m = true;
        let mut j = 0;
        while j < kn {
            if char_at(aliases, pos + j) != char_at(key, j) {
                m = false;
                j = kn;
            } else {
                j = j + 1;
            }
        }
        if m {
            let mut out = "";
            let mut p = pos + kn;
            while p < tn {
                let c = char_at(aliases, p);
                if c == "\t" {
                    return out;
                }
                out = out + c;
                p = p + 1;
            }
            return out;
        }
        pos = pos + 1;
    }
    return ann;
}

pub fn lit_token_type(kind: String) -> String {
    if kind == "INT" {
        return "Int";
    }
    if kind == "FLOAT" {
        return "Float";
    }
    if kind == "STRING" {
        return "String";
    }
    if kind == "KW_TRUE" {
        return "Bool";
    }
    if kind == "KW_FALSE" {
        return "Bool";
    }
    return "";
}

// Annotation vs initializer: exact name match for Int/String/Bool/Float.
pub fn types_compatible(ann: String, got: String) -> Bool {
    if ann == got {
        return true;
    }
    if chars_len(ann) >= 4 && str_slice(ann, 0, 4) == "dyn " {
        return true;
    }
    // i64/f64 aliases used in some dumps
    if ann == "i64" && got == "Int" {
        return true;
    }
    if ann == "f64" && got == "Float" {
        return true;
    }
    // Bare Result/Option still matches a parameterized form (Ok/Err inference).
    // Two parameterized forms must match T/E exactly.
    if ann == "Result" && chars_len(got) >= 7 {
        if str_slice(got, 0, 7) == "Result[" {
            return true;
        }
    }
    if got == "Result" && chars_len(ann) >= 7 {
        if str_slice(ann, 0, 7) == "Result[" {
            return true;
        }
    }
    if ann == "Option" && chars_len(got) >= 7 {
        if str_slice(got, 0, 7) == "Option[" {
            return true;
        }
    }
    if got == "Option" && chars_len(ann) >= 7 {
        if str_slice(ann, 0, 7) == "Option[" {
            return true;
        }
    }
    return false;
}

// Binary operators that constrain operand types in the R1 lit slice.
pub fn is_type_binop(kind: String) -> Bool {
    if kind == "PLUS" { return true; }
    if kind == "MINUS" { return true; }
    if kind == "STAR" { return true; }
    if kind == "SLASH" { return true; }
    if kind == "PERCENT" { return true; }
    if kind == "EQEQ" { return true; }
    if kind == "NEQ" { return true; }
    if kind == "LT" { return true; }
    if kind == "GT" { return true; }
    if kind == "LTE" { return true; }
    if kind == "GTE" { return true; }
    // M166 Int bitwise: << >> & | ^ (not && ||; no float bitops)
    if kind == "LSHIFT" { return true; }
    if kind == "RSHIFT" { return true; }
    if kind == "AMP" { return true; }
    if kind == "PIPE" { return true; }
    if kind == "CARET" || kind == "BXOR" { return true; }
    return false;
}

// Combine left/right pure lit types under op. "ERR_BINOP" = hard fail.
// String + String → String (concat). Other mixed arith → ERR.
pub fn combine_binop_types(op: String, left: String, right: String) -> String {
    if op == "PLUS" {
        if left == "String" && right == "String" {
            return "String";
        }
        if left == "Int" && right == "Int" {
            return "Int";
        }
        if left == "Float" && right == "Float" {
            return "Float";
        }
        // Int+String / String+Int / Bool+… — refuse (matches stage-0 honesty)
        return "ERR_BINOP";
    }
    if op == "MINUS" || op == "STAR" || op == "SLASH" || op == "PERCENT" {
        if left == "Int" && right == "Int" {
            return "Int";
        }
        if left == "Float" && right == "Float" {
            return "Float";
        }
        return "ERR_BINOP";
    }
    // M166: Int-only bitops (residual: no float bit ops / rotate)
    if op == "LSHIFT" || op == "RSHIFT" || op == "AMP" || op == "PIPE"
        || op == "CARET" || op == "BXOR"
    {
        if left == "Int" && right == "Int" {
            return "Int";
        }
        return "ERR_BINOP";
    }
    // Comparisons: same type → Bool; mismatch → ERR
    if left == right {
        return "Bool";
    }
    return "ERR_BINOP";
}

// Builtins / type names that are never "undefined variables".
