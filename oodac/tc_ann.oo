// # Drive let return and binop checks
//
// Logline: Walks each function, binds annotated params into a fresh lit_env, then checks lets, returns, and free binops against that env.
//
// Setup: ann_prep, resolve_type_alias, ann_check_let, ann_check_return, and ann_check_binop exist; lit_env is a tab-separated name:type table reset on each fn head so cross-function reuse cannot poison checks.
//
// Beats:
//   1. On KW_FN or KW_PUB KW_FN, reset expected_ret and bind params via lit_env_bind_fn_params; read ARROW IDENT as expected_ret.
//   2. Track brace_depth; at depth 0 after RBRACE, clear in_fn and expected_ret.
//   3. KW_LET updates lit_env via ann_check_let; KW_RETURN calls ann_check_return; every other token calls ann_check_binop.

pub fn lit_env_bind_fn_params(toks: List[String], start: Int, aliases: String) -> String {
    let n = list_len(toks);
    let mut lit_env = "\t";
    let mut pi = start;
    let mut saw_fn = false;
    while pi < n {
        if field_at(list_get(toks, pi), 0) == "KW_FN" {
            saw_fn = true;
            pi = pi + 1;
            if pi < n {
                if field_at(list_get(toks, pi), 0) == "IDENT" {
                    pi = pi + 1;
                }
            }
            if pi < n {
                if field_at(list_get(toks, pi), 0) == "LPAREN" {
                    pi = pi + 1;
                }
            }
            let mut cont_p = true;
            while cont_p {
                if pi >= n {
                    cont_p = false;
                } else {
                    let kk: String = field_at(list_get(toks, pi), 0);
                    if kk == "RPAREN" {
                        cont_p = false;
                    } else if kk == "IDENT" {
                        let pname: String = field_at(list_get(toks, pi), 3);
                        pi = pi + 1;
                        if pi < n {
                            if field_at(list_get(toks, pi), 0) == "COLON" {
                                pi = pi + 1;
                                if pi < n {
                                    if field_at(list_get(toks, pi), 0) == "AMP" {
                                        pi = pi + 1;
                                    }
                                }
                                if pi < n {
                                    if field_at(list_get(toks, pi), 0) == "IDENT" {
                                        let pty: String = resolve_type_alias(
                                            aliases,
                                            field_at(list_get(toks, pi), 3)
                                        );
                                        lit_env = lit_env + pname + ":" + pty + "\t";
                                        pi = pi + 1;
                                        if pi < n {
                                            if field_at(list_get(toks, pi), 0) == "LBRACKET" {
                                                let mut depth = 0;
                                                let mut cont_g = true;
                                                while cont_g {
                                                    if pi >= n {
                                                        cont_g = false;
                                                    } else {
                                                        let gk: String = field_at(list_get(toks, pi), 0);
                                                        if gk == "LBRACKET" {
                                                            depth = depth + 1;
                                                        }
                                                        if gk == "RBRACKET" {
                                                            depth = depth - 1;
                                                            if depth == 0 {
                                                                pi = pi + 1;
                                                                cont_g = false;
                                                            } else {
                                                                pi = pi + 1;
                                                            }
                                                        } else {
                                                            pi = pi + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if pi < n {
                            if field_at(list_get(toks, pi), 0) == "COMMA" {
                                pi = pi + 1;
                            }
                        }
                    } else {
                        pi = pi + 1;
                    }
                }
            }
            return lit_env;
        }
        pi = pi + 1;
        if pi > start + 5 {
            if !saw_fn {
                return lit_env;
            }
        }
    }
    return lit_env;
}

pub fn typecheck_ann_and_return_lits(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    let mut expected_ret = "";
    let mut brace_depth = 0;
    let mut in_fn = false;
    let prep: List[String] = ann_prep(toks);
    let mut aliases = list_get(prep, 0);
    // Per-function env (reset on each fn head) — do not share lets across fns.
    let mut lit_env = "\t";
    let ret_table = list_get(prep, 2);
    let struct_table = list_get(prep, 3);
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let line: String = field_at(list_get(toks, i), 1);
        let col: String = field_at(list_get(toks, i), 2);
        let mut is_fn_head = false;
        if k == "KW_FN" {
            is_fn_head = true;
        } else {
            if k == "KW_PUB" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "KW_FN" {
                        is_fn_head = true;
                    }
                }
            }
        }
        if is_fn_head {
            expected_ret = "";
            in_fn = true;
            brace_depth = 0;
            lit_env = lit_env_bind_fn_params(toks, i, aliases);
            let mut j = i;
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk: String = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        j = j + 1;
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "AMP" {
                                j = j + 1;
                            }
                        }
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                let raw_ret: String = field_at(list_get(toks, j), 3);
                                expected_ret = resolve_type_alias(aliases, raw_ret);
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        } else if k == "LBRACE" {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            if brace_depth == 0 {
                in_fn = false;
                expected_ret = "";
            }
            i = i + 1;
        } else if k == "KW_LET" {
            lit_env = ann_check_let(toks, i, n, aliases, lit_env, ret_table, struct_table);
            i = i + 1;
        } else if k == "KW_RETURN" {
            ann_check_return(toks, i, n, in_fn, expected_ret, lit_env, struct_table, line, col);
            i = i + 1;
        } else {
            ann_check_binop(toks, i, n, lit_env, line, col);
            i = i + 1;
        }
    }
}
