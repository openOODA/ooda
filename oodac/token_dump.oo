// job: dump tokens to stdout (CLI tokens command); stage: tokens
// in: source; out: emit_tok lines or ERR

pub fn dump_tokens(src: String) {
    let probe: Result[String, String] = lex_all(src);
    if probe.is_err() {
        let e = match probe {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\tlex\t" + e);
        process_exit(1);
    }
    let n = chars_len(src);
    let mut i = 0;
    let mut line = 1;
    let mut col = 1;
    let mut cont = true;
    while cont {
        if i >= n {
            emit_tok("EOF", line, col, "");
            cont = false;
        } else {
            let p: List[String] = lex_step(src, i, line, col);
            let st = list_get(p, 0);
            if st == "ERR" {
                println("ERR\tlex\t" + list_get(p, 1));
                process_exit(1);
            } else if st == "SKIP" {
                i = parse_int(list_get(p, 1));
                line = parse_int(list_get(p, 2));
                col = parse_int(list_get(p, 3));
            } else {
                i = parse_int(list_get(p, 1));
                line = parse_int(list_get(p, 2));
                col = parse_int(list_get(p, 3));
                let kind = list_get(p, 4);
                let text = list_get(p, 5);
                let sl = 0 + parse_int(list_get(p, 6));
                let sc = 0 + parse_int(list_get(p, 7));
                if kind == "EOF" {
                    emit_tok("EOF", sl, sc, "");
                    cont = false;
                } else {
                    emit_tok(kind, sl, sc, text);
                }
            }
        }
    }
}
