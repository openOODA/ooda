// # Emit expr statement or assign
//
// Logline: Lowers an expression statement and keeps EQ so (*p).f = rhs writes.
//
// Setup: c_emit_stmt sees STAR or a bare primary. c_emit_expr_c stops before EQ.
//
// Beats:
//   1. Emit the left expression (unary deref plus DOT is an lvalue).
//   2. When the next token is EQ, emit C assign of the right expression.
//   3. Else print a bare expression statement or the __asgn__ bind.

pub fn c_emit_expr_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let prx: List[String] = c_emit_expr_c(toks, p, n, e);
    p = parse_int(list_get(prx, 0));
    let lhs: String = list_get(prx, 1);
    if p < n && c_tokk(toks, p) == "EQ" {
        p = p + 1;
        let pra: List[String] = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pra, 0));
        let rhs: String = list_get(pra, 1);
        oo_emit_tmp_own(rhs);
        c_emit_src_line(toks, pos, e);
        println("  " + lhs + " = " + rhs + ";");
        if p < n && c_tokk(toks, p) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    let asgn: String = c_env_get(e, "__asgn__");
    if asgn != "" {
        oo_emit_tmp_own(lhs);
        println("  " + asgn + " = " + lhs + ";");
    } else {
        println("  " + lhs + ";");
    }
    if p < n && c_tokk(toks, p) == "SEMI" {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}

pub fn c_emit_star_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_expr_stmt(toks, pos, n, env);
}
