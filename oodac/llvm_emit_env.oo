// package: backend-llvm — Environment state, SSA registers, basic block labels, & string pool counters
// stage: emit

import "token_fmt.oo";

pub fn llvm_env_new() -> List[String] {
    let mut env: List[String] = list_new();
    env = list_push(env, "0");  // 0: reg_counter
    env = list_push(env, "0");  // 1: label_counter
    env = list_push(env, "0");  // 2: str_counter
    env = list_push(env, "");   // 3: vars string
    env = list_push(env, "");   // 4: str_table string
    return env;
}

pub fn llvm_gen_reg(env: List[String]) -> List[String] {
    let r = 0 + parse_int(list_get(env, 0));
    let name: String = "%t" + r.to_string();
    let next_r = r + 1;
    let mut out_env: List[String] = list_new();
    out_env = list_push(out_env, next_r.to_string());
    out_env = list_push(out_env, list_get(env, 1));
    out_env = list_push(out_env, list_get(env, 2));
    out_env = list_push(out_env, list_get(env, 3));
    out_env = list_push(out_env, list_get(env, 4));

    let mut res_env: List[String] = list_new();
    res_env = list_push(res_env, name);
    res_env = list_push(res_env, next_r.to_string());
    res_env = list_push(res_env, list_get(env, 1));
    res_env = list_push(res_env, list_get(env, 2));
    res_env = list_push(res_env, list_get(env, 3));
    res_env = list_push(res_env, list_get(env, 4));
    return res_env;
}

pub fn llvm_gen_label(prefix: String, env: List[String]) -> List[String] {
    let l = 0 + parse_int(list_get(env, 1));
    let lbl: String = prefix + "_" + l.to_string();
    let next_l = l + 1;
    let mut res_env: List[String] = list_new();
    res_env = list_push(res_env, lbl);
    res_env = list_push(res_env, list_get(env, 0));
    res_env = list_push(res_env, next_l.to_string());
    res_env = list_push(res_env, list_get(env, 2));
    res_env = list_push(res_env, list_get(env, 3));
    res_env = list_push(res_env, list_get(env, 4));
    return res_env;
}

pub fn llvm_env_push_scope(env: List[String]) -> List[String] {
    let vars: String = list_get(env, 3) + "{;";
    let mut out: List[String] = list_new();
    out = list_push(out, list_get(env, 0));
    out = list_push(out, list_get(env, 1));
    out = list_push(out, list_get(env, 2));
    out = list_push(out, vars);
    out = list_push(out, list_get(env, 4));
    return out;
}

pub fn llvm_env_add_var(env: List[String], name: String, ty: String) -> List[String] {
    let vars: String = list_get(env, 3) + name + ":" + ty + ";";
    let mut out: List[String] = list_new();
    out = list_push(out, list_get(env, 0));
    out = list_push(out, list_get(env, 1));
    out = list_push(out, list_get(env, 2));
    out = list_push(out, vars);
    out = list_push(out, list_get(env, 4));
    return out;
}

pub fn llvm_env_get_var_ty(env: List[String], name: String) -> String {
    let vars: String = list_get(env, 3);
    let n = chars_len(vars);
    let pattern: String = name + ":";
    let plen = chars_len(pattern);
    let mut i = n - 1;
    while i >= 0 {
        if i + plen <= n {
            if str_slice(vars, i, i + plen) == pattern {
                let mut j = i + plen;
                let mut ty: String = "";
                while j < n {
                    let c: String = char_at(vars, j);
                    if c == ";" || c == "{" {
                        break;
                    }
                    ty = ty + c;
                    j = j + 1;
                }
                return ty;
            }
        }
        i = i - 1;
    }
    return "";
}

pub fn llvm_add_str_lit(s: String, env: List[String]) -> List[String] {
    let sc = 0 + parse_int(list_get(env, 2));
    let name: String = "@.str." + sc.to_string();
    let next_sc = sc + 1;
    
    // Process string escaping & byte length calculation
    let slen = chars_len(s);
    let mut byte_len = slen + 1; // including null terminator
    let mut esc_str: String = "";
    let mut i = 0;
    while i < slen {
        let c: String = char_at(s, i);
        if c == "\"" {
            esc_str = esc_str + "\\22";
        } else if c == "\\" {
            esc_str = esc_str + "\\5C";
        } else if c == "\n" {
            esc_str = esc_str + "\\0A";
        } else if c == "\t" {
            esc_str = esc_str + "\\09";
        } else {
            esc_str = esc_str + c;
        }
        i = i + 1;
    }
    esc_str = esc_str + "\\00";

    let decl: String = name + " = private unnamed_addr constant [" + byte_len.to_string() + " x i8] c\"" + esc_str + "\", align 1";
    let str_table: String = list_get(env, 4) + decl + "\n";

    let mut out: List[String] = list_new();
    out = list_push(out, name);
    out = list_push(out, byte_len.to_string());
    out = list_push(out, list_get(env, 0));
    out = list_push(out, list_get(env, 1));
    out = list_push(out, next_sc.to_string());
    out = list_push(out, list_get(env, 3));
    out = list_push(out, str_table);
    return out;
}

// True if vars blob contains name: (used for __did_ret__ sentinel).
pub fn llvm_env_vars_has(vars: String, name: String) -> Bool {
    let pattern: String = name + ":";
    let n = chars_len(vars);
    let plen = chars_len(pattern);
    let mut i = 0;
    while i + plen <= n {
        let mut ok = true;
        let mut j = 0;
        while j < plen {
            if char_at(vars, i + j) != char_at(pattern, j) {
                ok = false;
                j = plen;
            } else {
                j = j + 1;
            }
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Print accumulated string-pool globals (call at end of module stream).
pub fn llvm_emit_str_pool(str_table: String) {
    if str_table != "" {
        println("; string pool");
        println(str_table);
    }
}

// Inject module fn return table: "name=ty|" → vars __fnret__name:ty
pub fn llvm_env_seed_fnrets(env: List[String], fntab: String) -> List[String] {
    let mut cur: List[String] = env;
    let mut ent: String = "";
    let flen = chars_len(fntab);
    let mut i = 0;
    while i <= flen {
        let at_end = i == flen;
        let mut c = "|";
        if !at_end { c = char_at(fntab, i); }
        if c == "|" || at_end {
            if ent != "" {
                let elen = chars_len(ent);
                let mut eq = -1;
                let mut j = 0;
                while j < elen {
                    if char_at(ent, j) == "=" { eq = j; }
                    j = j + 1;
                }
                if eq > 0 {
                    let nm = str_slice(ent, 0, eq);
                    let ty = str_slice(ent, eq + 1, elen);
                    cur = llvm_env_add_var(cur, "__fnret__" + nm, ty);
                }
            }
            ent = "";
        } else {
            ent = ent + c;
        }
        i = i + 1;
    }
    return cur;
}
