// # Dump a program AST
//
// Logline: Tokenize source, print PROGRAM and each top-level item, or fail on an unexpected token.
//
// Setup: tokenize_lines and parse_fn_item exist. n_toks is list length. skip_balanced starts at LBRACE.
//
// Beats:
//   1. dump_ast_from_src and parse_and_print_ast walk tokens and print TYPEALIAS, IMPORT, or function items.
//   2. n_toks returns the token list length.
//   3. skip_balanced walks nested braces and fails closed on an unclosed block.

pub fn dump_ast_from_src(src: String) {
    parse_and_print_ast(src);
}

pub fn parse_and_print_ast(src: String) {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    println("PROGRAM");
    let mut item_idx = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = parse_fn_item(toks, pos, item_idx);
            item_idx = item_idx + 1;
        } else if k == "KW_TYPE" {
            let tl: String = field_at(list_get(toks, pos), 1);
            let tc: String = field_at(list_get(toks, pos), 2);
            pos = pos + 1; 
            let name: String = field_at(list_get(toks, pos), 3);
            pos = pos + 1; 
            pos = pos + 1; 
            
            let mut ty_str: String = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            if field_at(list_get(toks, pos), 0) == "LBRACE" {
                pos = pos + 1;
                ty_str = ty_str + ":" + name + "{";
                let mut cont_struct = true;
                while cont_struct {
                    if field_at(list_get(toks, pos), 0) == "RBRACE" {
                        cont_struct = false;
                        pos = pos + 1;
                    } else {
                        ty_str = ty_str + field_at(list_get(toks, pos), 3);
                        pos = pos + 1;
                    }
                }
            }
            
            if field_at(list_get(toks, pos - 1), 0) == "RBRACE" {
                ty_str = ty_str + "}";
            }
            let iis: String = item_idx.to_string();
            println("  ITEM[" + iis + "] TYPEALIAS name=" + name + " ty=" + ty_str);
            
            let mut cont_t = true;
            while cont_t {
                if pos >= n {
                    cont_t = false;
                } else {
                    let k2: String = field_at(list_get(toks, pos), 0);
                    if k2 == "RBRACE" {
                        pos = pos + 1;
                        cont_t = false;
                    } else if k2 == "SEMI" {
                        pos = pos + 1;
                        cont_t = false;
                    } else {
                        pos = pos + 1;
                    }
                }
            }
            item_idx = item_idx + 1;
        } else if k == "KW_IMPORT" {
            let iis: String = item_idx.to_string();
            pos = pos + 1;
            let mut path_str = "";
            let mut cont = true;
            while cont {
                if pos >= n {
                    cont = false;
                } else {
                    if field_at(list_get(toks, pos), 0) == "SEMI" {
                        pos = pos + 1;
                        cont = false;
                    } else {
                        path_str = path_str + field_at(list_get(toks, pos), 3);
                        pos = pos + 1;
                    }
                }
            }
            println("  ITEM[" + iis + "] IMPORT path=" + path_str);
            item_idx = item_idx + 1;
        } else {
            // unexpected top-level
            println("ERR\tparse\tunexpected token " + k);
            process_exit(1);
        }
    }
}

// Returns new pos after function item (including optional verify block skip)
pub fn n_toks(toks: List[String]) -> Int {
    return list_len(toks);
}

pub fn skip_balanced(toks: List[String], pos0: Int) -> Int {
    // pos0 at LBRACE
    let n = list_len(toks);
    let mut pos = pos0 + 1;
    let mut depth = 1;
    while pos < n {
        if depth == 0 {
            return pos;
        }
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
        }
        pos = pos + 1;
    }
    if depth != 0 {
        println("ERR\tparse\tunclosed brace");
        process_exit(1);
    }
    return pos;
}

// Dump block like stage-0; returns pos after RBRACE
