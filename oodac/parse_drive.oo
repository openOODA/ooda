// job: AST dump entry + token list length; stage: parse
// in: source; out: printed AST / n_toks

pub fn dump_ast_from_src(src: String) {
    parse_and_print_ast(src);
}

pub fn parse_and_print_ast(src: String) {
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    println("PROGRAM");
    let mut item_idx = 0;
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = parse_fn_item(toks, pos, item_idx);
            item_idx = item_idx + 1;
        } else if k == "KW_TYPE" {
            let tl = field_at(list_get(toks, pos), 1);
            let tc = field_at(list_get(toks, pos), 2);
            pos = pos + 1; 
            let name = field_at(list_get(toks, pos), 3);
            pos = pos + 1; 
            pos = pos + 1; 
            
            let mut ty_str = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            if field_at(list_get(toks, pos), 0) == "LBRACE" {
                pos = pos + 1;
                ty_str = ty_str + ":" + name + "{";
                let mut cont_struct = true;
                while cont_struct {
                    if field_at(list_get(toks, pos), 0) == "RBRACE" {
                        cont_struct = false;
                        pos = pos + 1;
                    } else {
                        ty_str = ty_str + field_at(list_get(toks, pos), 3);
                        pos = pos + 1;
                    }
                }
            }
            
            if field_at(list_get(toks, pos - 1), 0) == "RBRACE" {
                ty_str = ty_str + "}";
            }
            println("  ITEM[" + item_idx.to_string() + "] TYPEALIAS name=" + name + " ty=" + ty_str);
            
            let mut cont_t = true;
            while cont_t {
                if pos >= n {
                    cont_t = false;
                } else {
                    let k2 = field_at(list_get(toks, pos), 0);
                    if k2 == "RBRACE" {
                        pos = pos + 1;
                        cont_t = false;
                    } else if k2 == "SEMI" {
                        pos = pos + 1;
                        cont_t = false;
                    } else {
                        pos = pos + 1;
                    }
                }
            }
            item_idx = item_idx + 1;
        } else if k == "KW_IMPORT" {
            pos = pos + 1;
            let mut cont = true;
            while cont {
                if pos >= n {
                    cont = false;
                } else {
                    if field_at(list_get(toks, pos), 0) == "SEMI" {
                        pos = pos + 1;
                        cont = false;
                    } else {
                        pos = pos + 1;
                    }
                }
            }
        } else {
            // unexpected top-level
            println("ERR\tparse\tunexpected token " + k);
            process_exit(1);
        }
    }
}

// Returns new pos after function item (including optional verify block skip)
pub fn n_toks(toks: List[String]) -> Int {
    return list_len(toks);
}

pub fn skip_balanced(toks: List[String], pos0: Int) -> Int {
    // pos0 at LBRACE
    let n = list_len(toks);
    let mut pos = pos0 + 1;
    let mut depth = 1;
    while pos < n {
        if depth == 0 {
            return pos;
        }
        let k = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
        }
        pos = pos + 1;
    }
    return pos;
}

// Dump block like stage-0; returns pos after RBRACE
