// # Write Linux x86_64 write-and-exit assembly
//
// Logline: Prints AT&T _start/main that SYS_write each rodata string then SYS_exit 0.
//
// Setup: println exists. msgs are the exact bytes to print, without the added newline.
//
// Beats:
//   1. Escape each string for .ascii and emit .rodata labels.
//   2. Emit main and _start that write each string plus a newline.
//   3. Exit with syscall 60.
//
// residual: SysV calls and AArch64 stay later.

pub fn x86_ascii_esc(s: String) -> String {
    let n = chars_len(s);
    let mut o = "";
    let mut i = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            o = o + "\\\\";
        } else if c == "\"" {
            o = o + "\\\"";
        } else if c == "\n" {
            o = o + "\\n";
        } else if c == "\t" {
            o = o + "\\t";
        } else {
            o = o + c;
        }
        i = i + 1;
    }
    return o;
}

pub fn x86_emit_linux64(msgs: List[String]) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    let n = list_len(msgs);
    let mut i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        println(".Lstr" + i.to_string() + ":");
        println("    .ascii \"" + x86_ascii_esc(s) + "\\n\"");
        i = i + 1;
    }
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 4");
    println("main:");
    println("_start:");
    i = 0;
    while i < n {
        let s: String = list_get(msgs, i);
        let ln = chars_len(s) + 1;
        let tag: String = i.to_string();
        println("    mov $1, %rax");
        println("    mov $1, %rdi");
        println("    lea .Lstr" + tag + "(%rip), %rsi");
        println("    mov $" + ln.to_string() + ", %rdx");
        println("    syscall");
        i = i + 1;
    }
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
