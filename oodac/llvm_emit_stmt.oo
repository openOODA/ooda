// # Lower statements to LLVM
//
// Logline: Dispatches let, return, while, if, for, Result match, struct field mutation, and expression statements to LLVM IR emitters.
//
// Setup: llvm_emit_let_stmt, llvm_emit_ret_arc, llvm_emit_while_stmt, llvm_emit_if_stmt, llvm_emit_for_range_stmt, llvm_emit_match_stmt, and llvm_emit_expr are in scope.
//
// Beats:
//   1. Lower let and assign statements.
//   2. Lower return statements with scope ARC cleanup and main truncation.
//   3. Lower while, if, for, and Result match statements.
//   4. Lower struct field mutations (s.x = expr;) and expression statements.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";
import "llvm_emit_mem.oo";
import "llvm_emit_let.oo";
import "llvm_emit_control.oo";
import "llvm_emit_for.oo";
import "llvm_emit_arc.oo";
import "llvm_emit_block.oo";
import "llvm_emit_expr.oo";
import "llvm_emit_match.oo";

pub fn llvm_emit_stmt(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos;
    let mut cur_env: List[String] = env;
    let tok: String = list_get(toks, p);
    let k: String = field_at(tok, 0);

    if k == "KW_LET" {
        return llvm_emit_let_stmt(toks, p, n, cur_env);
    }

    if k == "KW_RETURN" {
        p = p + 1;
        let mut ret_val: String = "";
        let mut ret_ty: String = "void";

        if p < n && field_at(list_get(toks, p), 0) != "SEMI" && field_at(list_get(toks, p), 0) != "RBRACE" {
            let expr_res: List[String] = llvm_emit_expr(toks, p, n, cur_env);
            ret_val = list_get(expr_res, 0);
            ret_ty = list_get(expr_res, 1);
            p = parse_int(list_get(expr_res, 2));
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(expr_res, 3));
            cur_env = list_push(cur_env, list_get(expr_res, 4));
            cur_env = list_push(cur_env, list_get(expr_res, 5));
            cur_env = list_push(cur_env, list_get(expr_res, 6));
            cur_env = list_push(cur_env, list_get(expr_res, 7));
        }

        let is_main_str: String = llvm_env_get_var_ty(cur_env, "__is_main__");
        let fret: String = llvm_env_get_var_ty(cur_env, "__fnret_ty__");

        // Release all active ARC variables before return
        cur_env = llvm_emit_ret_arc(cur_env);

        if (is_main_str == "1" || fret == "i32") && ret_ty == "i64" {
            let trunc_res: List[String] = llvm_gen_reg(cur_env);
            let trunc_reg: String = list_get(trunc_res, 0);
            cur_env = list_new();
            cur_env = list_push(cur_env, list_get(trunc_res, 1));
            cur_env = list_push(cur_env, list_get(trunc_res, 2));
            cur_env = list_push(cur_env, list_get(trunc_res, 3));
            cur_env = list_push(cur_env, list_get(trunc_res, 4));
            cur_env = list_push(cur_env, list_get(trunc_res, 5));
            println("  " + trunc_reg + " = trunc i64 " + ret_val + " to i32");
            ret_val = trunc_reg;
            ret_ty = "i32";
        }

        if is_main_str == "1" && (ret_ty == "void" || ret_val == "") {
            println("  ret i32 0");
        } else if ret_ty == "void" || ret_val == "" {
            println("  ret void");
        } else {
            println("  ret " + ret_ty + " " + ret_val);
        }

        // Mark so llvm_emit_fn skips fallthrough ret (avoids double-ret)
        cur_env = llvm_env_add_var(cur_env, "__did_ret__", "1");

        if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }

        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, list_get(cur_env, 0));
        out = list_push(out, list_get(cur_env, 1));
        out = list_push(out, list_get(cur_env, 2));
        out = list_push(out, list_get(cur_env, 3));
        out = list_push(out, list_get(cur_env, 4));
        return out;
    }

    if k == "KW_WHILE" {
        return llvm_emit_while_stmt(toks, p, n, cur_env);
    }
    if k == "KW_IF" {
        return llvm_emit_if_stmt(toks, p, n, cur_env);
    }
    if k == "KW_FOR" {
        return llvm_emit_for_range_stmt(toks, p, n, cur_env);
    }
    if k == "KW_MATCH" {
        return llvm_emit_match_stmt(toks, p, n, cur_env);
    }

    if k == "IDENT" {
        let name: String = field_at(list_get(toks, p), 3);
        if name == "break" || name == "continue" {
            let mut tgt: String = llvm_env_get_var_ty(cur_env, "__while_end__");
            if name == "continue" {
                tgt = llvm_env_get_var_ty(cur_env, "__while_cond__");
            }
            if tgt != "" {
                println("  br label %" + tgt);
                cur_env = llvm_env_add_var(cur_env, "__did_ret__", "1");
            }
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
            let mut outb: List[String] = list_new();
            outb = list_push(outb, p.to_string());
            outb = list_push(outb, list_get(cur_env, 0));
            outb = list_push(outb, list_get(cur_env, 1));
            outb = list_push(outb, list_get(cur_env, 2));
            outb = list_push(outb, list_get(cur_env, 3));
            outb = list_push(outb, list_get(cur_env, 4));
            return outb;
        }
        if p + 3 < n {
            if field_at(list_get(toks, p + 1), 0) == "DOT" && field_at(list_get(toks, p + 3), 0) == "EQ" {
                let fname: String = field_at(list_get(toks, p + 2), 3);
                let stab: String = llvm_env_get_var_ty(cur_env, "__stab__");
                let vty: String = llvm_env_get_var_ty(cur_env, name);
                let mut sname: String = llvm_ty_map(vty);
                if chars_len(sname) >= 8 && str_slice(sname, 0, 8) == "%struct." {
                    sname = str_slice(sname, 8, chars_len(sname));
                }
                let fidx: Int = 0 + llvm_struct_field_idx(stab, sname, fname);
                let fty: String = llvm_struct_field_ty(stab, sname, fname);

                let rhs_res: List[String] = llvm_emit_expr(toks, p + 4, n, cur_env);
                let rhs_val: String = list_get(rhs_res, 0);
                p = parse_int(list_get(rhs_res, 2));
                cur_env = list_new();
                cur_env = list_push(cur_env, list_get(rhs_res, 3));
                cur_env = list_push(cur_env, list_get(rhs_res, 4));
                cur_env = list_push(cur_env, list_get(rhs_res, 5));
                cur_env = list_push(cur_env, list_get(rhs_res, 6));
                cur_env = list_push(cur_env, list_get(rhs_res, 7));

                let gep_res: List[String] = llvm_emit_struct_gep(sname, name, fidx, cur_env);
                let fptr: String = list_get(gep_res, 0);
                cur_env = list_new();
                cur_env = list_push(cur_env, list_get(gep_res, 1));
                cur_env = list_push(cur_env, list_get(gep_res, 2));
                cur_env = list_push(cur_env, list_get(gep_res, 3));
                cur_env = list_push(cur_env, list_get(gep_res, 4));
                cur_env = list_push(cur_env, list_get(gep_res, 5));

                println("  store " + fty + " " + rhs_val + ", " + fty + "* " + fptr + ", align 8");

                if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }

                let mut out_m: List[String] = list_new();
                out_m = list_push(out_m, p.to_string());
                out_m = list_push(out_m, list_get(cur_env, 0));
                out_m = list_push(out_m, list_get(cur_env, 1));
                out_m = list_push(out_m, list_get(cur_env, 2));
                out_m = list_push(out_m, list_get(cur_env, 3));
                out_m = list_push(out_m, list_get(cur_env, 4));
                return out_m;
            }
        }

        if p + 1 < n {
            if field_at(list_get(toks, p + 1), 0) == "EQ" {
                return llvm_emit_assign_stmt(name, toks, p + 1, n, cur_env);
            }
        }
    }

    let expr_res: List[String] = llvm_emit_expr(toks, p, n, cur_env);
    p = parse_int(list_get(expr_res, 2));
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(expr_res, 3));
    cur_env = list_push(cur_env, list_get(expr_res, 4));
    cur_env = list_push(cur_env, list_get(expr_res, 5));
    cur_env = list_push(cur_env, list_get(expr_res, 6));
    cur_env = list_push(cur_env, list_get(expr_res, 7));

    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }

    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
