// # CLI Sovereign GPU Kernel Emission Router
//
// Logline: Handles emit-msl, emit-spirv, emit-ptx, and emit-gpu compiler CLI commands.
//
// Setup: Integrates with oodac CLI dispatch pipeline for sovereign GPU code emission.
//
// Beats:
//   1. Parse target backend and kernel operation type from CLI arguments.
//   2. Generate target shader or bytecode (Metal MSL, SPIR-V binary, CUDA PTX).
//   3. Output shader to stdout or write directly to target binary file.

import "gpu_metal.oo";
import "gpu_spirv.oo";
import "gpu_ptx.oo";
import "gpu_driver.oo";
import "load_import.oo";

pub fn is_gpu_command(cmd: String) -> Bool {
    if cmd == "emit-msl" || cmd == "emit-spirv" || cmd == "emit-ptx" || cmd == "emit-gpu" {
        return true;
    }
    return false;
}

pub fn run_emit_gpu_cmd(fs: &FsCap, sys: &SysCap, cmd: String, path: String, out_arg: String) -> Bool {
    let src: String = load_source_with_imports(fs, path);
    let mut kname: String = "k_main";
    let mut op_type: String = "vec_add";

    if str_index_of(src, "matmul") >= 0 || str_index_of(src, "gemm") >= 0 {
        op_type = "matmul";
        kname = "k_matmul";
    } else if str_index_of(src, "rms_norm") >= 0 {
        op_type = "rms_norm";
        kname = "k_rms_norm";
    } else if str_index_of(src, "attention") >= 0 {
        op_type = "attention";
        kname = "k_attention";
    }

    if cmd == "emit-msl" {
        let res: Result[GpuKernelArtifact, String] = gpu_compile_kernel_source("metal", kname, op_type);
        if res.is_ok() {
            let art: GpuKernelArtifact = res.unwrap();
            let code_str: String = art.code;
            println(code_str);
            return true;
        }
        println("ERR\temit-msl\tfailed to compile Metal kernel");
        return false;
    }
    if cmd == "emit-spirv" {
        let mut words: List[Int] = list_new();
        if op_type == "matmul" {
            words = spirv_build_matmul_kernel();
        } else if op_type == "attention" {
            words = spirv_build_dot_product_kernel();
        } else {
            words = spirv_build_vector_add_kernel();
        }
        if out_arg != "" {
            return spirv_emit_binary_spv(sys, words, out_arg);
        }
        let hex: String = spirv_words_to_hex(words);
        println(hex);
        return true;
    }
    if cmd == "emit-ptx" {
        let res: Result[GpuKernelArtifact, String] = gpu_compile_kernel_source("ptx", kname, op_type);
        if res.is_ok() {
            let art: GpuKernelArtifact = res.unwrap();
            let code_str: String = art.code;
            println(code_str);
            return true;
        }
        println("ERR\temit-ptx\tfailed to compile PTX kernel");
        return false;
    }
    if cmd == "emit-gpu" {
        let res: Result[GpuKernelArtifact, String] = gpu_compile_kernel_source("metal", kname, op_type);
        if res.is_ok() {
            let art: GpuKernelArtifact = res.unwrap();
            let code_str: String = art.code;
            println(code_str);
            return true;
        }
        println("ERR\temit-gpu\tfailed to compile GPU kernel");
        return false;
    }
    return false;
}
