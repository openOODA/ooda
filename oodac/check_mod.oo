// job: modular + cached check driver; stage: check
// in: FsCap + SysCap + root path
// out: OK/ERR — skip unchanged via .ooda-cache/check (tree + per-module)

fn run_check_module_body(body: String) {
    if chars_len(body) == 0 {
        return;
    }
    if chars_len(body) > 1048576 {
        println("ERR\tcheck\tsource exceeds 1MiB expanded limit");
        process_exit(1);
    }
    // tokenize_lines already fail-closed on lex errors
    let toks: List[String] = tokenize_lines(body);
    let n: Int = list_len(toks);
    if n <= 1 {
        return;
    }
    let mut pos: Int = 0;
    let mut saw_fn: Bool = false;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            saw_fn = true;
            pos = check_function(toks, pos);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            println("ERR\tparse\tunexpected " + k);
            process_exit(1);
        }
    }
    if !saw_fn {
        return;
    }
}

pub fn run_check_path(fs: &FsCap, sys: &SysCap, path: String) {
    check_cache_ensure(fs, sys);
    let mods: List[String] = collect_module_paths(fs, path);
    let nmods: Int = list_len(mods);
    if nmods <= 12 {
        let src: String = load_source_with_imports(fs, path);
        let h: String = content_hash(src);
        let tk: String = check_cache_tree_key(h);
        if check_cache_hit(fs, tk) {
            println("OK");
            return;
        }
        run_check_core(sys, src);
        check_cache_put(fs, tk);
        println("OK");
        return;
    }
    // Pass 1: hash raw sources only (fast warm path).
    let mut tree: String = "";
    let mut hashes: List[String] = list_new();
    let mut raws: List[String] = list_new();
    let mut i: Int = 0;
    while i < nmods {
        let mp: String = list_get(mods, i);
        let rr: Int = read_file(fs, mp);
        if rr.is_err() {
            println("ERR\tcheck\tunreadable " + mp);
            process_exit(1);
        }
        let raw: String = rr.unwrap();
        let h: String = content_hash(raw);
        tree = tree + mp + ":" + h + ";";
        hashes = list_push(hashes, h);
        raws = list_push(raws, raw);
        i = i + 1;
    }
    let th: String = content_hash(tree);
    let tkey: String = check_cache_tree_key(th);
    if check_cache_hit(fs, tkey) {
        println("OK");
        return;
    }
    // Pass 2 (cold / dirty): parse only modules whose hash is uncached.
    let mut di: Int = 0;
    while di < nmods {
        let hv: String = list_get(hashes, di);
        let mk: String = check_cache_mod_key(hv);
        if !check_cache_hit(fs, mk) {
            let raw2: String = list_get(raws, di);
            let body2: String = strip_import_lines(raw2);
            run_check_module_body(body2);
            check_cache_put(fs, mk);
        }
        di = di + 1;
    }
    check_cache_put(fs, tkey);
    println("OK");
}
