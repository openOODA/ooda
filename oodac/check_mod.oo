// # Modular cached check driver
//
// Logline: Checks a path per module or as one cached tree and prints OK, skipping unchanged sources via .ooda-cache/check.
//
// Setup: Needs FsCap and SysCap; collect_module_paths, scan_fn_names, run_check_core_binds, oo_file_stamp, and the check_cache_* helpers are in scope.
//
// Beats:
//   1. A g_ listing whose path stamps still match prints OK without collect or typecheck.
//   2. More than one module: scan names once, then check only stamp-plus-binds misses.
//   3. One module: load the import tree, hit the content-hash cache, or run_check_core, put the tree key, and print OK.
//
// residual: RAM-cold typecheck stays ~523s; disk-warm new-process uses g_ stamp snapshot.

fn persist_graph(fs: &FsCap, sys: &SysCap, root: String, listing: String) {
    let tk: String = check_cache_tree_key(content_hash("dw1\n" + listing));
    check_cache_put(fs, sys, tk);
    check_cache_put_body(fs, sys, check_cache_graph_key(root), listing);
}

fn check_modules(fs: &FsCap, sys: &SysCap, paths: List[String]) {
    let np = list_len(paths);
    let mut names = "\t";
    let mut raws: List[String] = list_new();
    let mut i = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let rr = read_file(fs, pth);
        let mut raw: String = "";
        if !rr.is_err() {
            raw = match rr {
                Ok(s) => s,
                Err(msg) => msg,
            };
            names = names + scan_fn_names(raw);
        }
        raws = list_push(raws, raw);
        i = i + 1;
    }
    let binds: String = names_to_depth0_binds(names);
    let bh: String = content_hash(binds);
    i = 0;
    while i < np {
        let pth2: String = list_get(paths, i);
        let stamp: String = oo_file_stamp(pth2);
        let mk: String = check_cache_mod_key(content_hash(stamp + bh));
        if !check_cache_hit(fs, mk) {
            let raw2: String = list_get(raws, i);
            let body: String = strip_import_lines(raw2);
            if chars_len(body) > 0 {
                run_check_core_binds_path(sys, body, binds, pth2);
                check_cache_put(fs, sys, mk);
            }
        }
        i = i + 1;
    }
}

pub fn run_check_path(fs: &FsCap, sys: &SysCap, path: String) {
    check_cache_ensure(fs, sys);
    let listing: String = check_cache_read(fs, check_cache_graph_key(path));
    if check_listing_fresh(listing) {
        println("OK");
        return;
    }
    let paths: List[String] = collect_module_paths(fs, path);
    let np = list_len(paths);
    let roll: String = check_paths_listing(paths);
    if np > 1 {
        let tk: String = check_cache_tree_key(content_hash("dw1\n" + roll));
        if !check_cache_hit(fs, tk) {
            check_modules(fs, sys, paths);
        }
        persist_graph(fs, sys, path, roll);
        println("OK");
        return;
    }
    let src: String = load_source_with_imports(fs, path);
    let h: String = content_hash(src);
    let tk2: String = check_cache_tree_key(h);
    if check_cache_hit(fs, tk2) {
        persist_graph(fs, sys, path, roll);
        println("OK");
        return;
    }
    run_check_core_binds_path(sys, src, "\t", path);
    check_cache_put(fs, sys, tk2);
    persist_graph(fs, sys, path, roll);
    println("OK");
}
