// # Detect println of an integer literal
//
// Logline: Returns the decimal digits when a function body is only println of an INT token.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT ) with optional semicolon, then RBRACE.
//   3. Return the INT text. FLOAT and IDENT miss.
//
// residual: non-const ints stay dummy end. Const INT+INT lives in wasm_emit_add.oo.

import "token_fmt.oo";

fn wi_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wi_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_int(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wi_kind(toks, i) == "KW_FN" && wi_kind(toks, i + 1) == "IDENT" {
            if wi_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wi_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 3 >= n {
                    return "";
                }
                if wi_kind(toks, p) != "IDENT" || wi_text(toks, p) != "println" {
                    return "";
                }
                if wi_kind(toks, p + 1) != "LPAREN" {
                    return "";
                }
                if wi_kind(toks, p + 2) != "INT" {
                    return "";
                }
                if wi_kind(toks, p + 3) != "RPAREN" {
                    return "";
                }
                let digits: String = wi_text(toks, p + 2);
                p = p + 4;
                if p < n && wi_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p < n && wi_kind(toks, p) == "RBRACE" {
                    return digits;
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
