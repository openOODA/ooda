// # Match-expr ARC and String-Result gate
//
// Logline: Zero payload slots, move a bind-as-arm, and refuse non-String Result scrutinees.
//
// Setup: Called from llvm_emit_match_expr.oo. Do not import llvm_emit_expr.oo.
//
// Beats:
//   1. llvm_mex_is_str_result accepts Result, Result[String], and %OoResS.
//   2. llvm_mex_zero_slots stores zeroinitializer into both alloca slots.
//   3. llvm_mex_move_if_bind clears the slot when the arm value is that bind.

pub fn llvm_mex_is_str_result(ty: String) -> Bool {
    if ty == "Result" || ty == "%OoResS" || ty == "%OoResV" {
        return true;
    }
    if ty == "Result[String]" || ty == "Result[String,String]" {
        return true;
    }
    if ty == "Result[String, String]" {
        return true;
    }
    if chars_len(ty) >= 14 {
        if str_slice(ty, 0, 14) == "Result[String," {
            return true;
        }
    }
    return false;
}

pub fn llvm_mex_zero_slots(ok_slot: String, err_slot: String) {
    println("  store %OoStr zeroinitializer, %OoStr* %" + ok_slot + ".slot, align 8");
    println("  store %OoStr zeroinitializer, %OoStr* %" + err_slot + ".slot, align 8");
}

pub fn llvm_mex_move_if_bind(toks: List[String], pos: Int, bind: String, env: List[String]) {
    if pos < 0 {
        return;
    }
    let n = list_len(toks);
    if pos >= n {
        return;
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return;
    }
    if field_at(list_get(toks, pos), 3) != bind {
        return;
    }
    let slot: String = llvm_env_slot(env, bind);
    println("  store %OoStr zeroinitializer, %OoStr* %" + slot + ".slot, align 8");
}
