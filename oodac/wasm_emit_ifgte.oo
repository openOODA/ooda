// # Detect const if INT >= INT println fold
//
// Logline: Returns the taken-branch STRING when a function body is only if INT|IDENT >= INT|IDENT with one println(STRING) per branch.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if INT|IDENT GTE INT|IDENT then a println(STRING) branch and an else println(STRING) branch.
//   3. Return then when left >= right, else the else STRING. IDENT resolved via let INT lookup.
//
// residual: runtime compare stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wge_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wge_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wge_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wge_kind(toks, p) == "KW_LET" && wge_kind(toks, p + 1) == "IDENT" && wge_text(toks, p + 1) == name && wge_kind(toks, p + 2) == "EQ" && wge_kind(toks, p + 3) == "INT" { return wge_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wge_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wge_kind(toks, pos) == "INT" { return wge_text(toks, pos); }
    if wge_kind(toks, pos) == "IDENT" {
        let name: String = wge_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wge_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wge_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wge_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wge_kind(toks, p) != "IDENT" || wge_text(toks, p) != "println" { return empty; }
    if wge_kind(toks, p + 1) != "LPAREN" || wge_kind(toks, p + 2) != "STRING" { return empty; }
    if wge_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wge_text(toks, p + 2);
    p = p + 4;
    if p < n && wge_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}
fn wge_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wge_kind(toks, i) == "KW_FN" && wge_kind(toks, i + 1) == "IDENT" && wge_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wge_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wge_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wge_kind(toks, p) == "KW_LET" {
        while p < n && wge_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wge_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_if_gte(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wge_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wge_p(toks, n, f + 2);
    if p0 < 0 || p0 + 4 >= n { return ""; }
    if wge_kind(toks, p0) != "KW_IF" { return ""; }
    let ls: String = wge_int_val(toks, p0 + 1, n);
    if chars_len(ls) <= 0 { return ""; }
    if wge_kind(toks, p0 + 2) != "GTE" { return ""; }
    let rs: String = wge_int_val(toks, p0 + 3, n);
    if chars_len(rs) <= 0 { return ""; }
    if wge_kind(toks, p0 + 4) != "LBRACE" { return ""; }
    let left: Int = parse_int(ls);
    let right: Int = parse_int(rs);
    let take_then: Bool = left >= right;
    let th: List[String] = wge_one_str_println(toks, p0 + 5, n);
    if list_len(th) < 2 { return ""; }
    let mut p: Int = parse_int(list_get(th, 1));
    if p >= n || wge_kind(toks, p) != "RBRACE" { return ""; }
    p = p + 1;
    if p >= n || wge_kind(toks, p) != "KW_ELSE" { return ""; }
    p = p + 1;
    if p >= n || wge_kind(toks, p) != "LBRACE" { return ""; }
    p = p + 1;
    let el: List[String] = wge_one_str_println(toks, p, n);
    if list_len(el) < 2 { return ""; }
    p = parse_int(list_get(el, 1));
    if p >= n || wge_kind(toks, p) != "RBRACE" { return ""; }
    p = p + 1;
    if p >= n || wge_kind(toks, p) != "RBRACE" { return ""; }
    if take_then { return list_get(th, 0); }
    return list_get(el, 0);
}
