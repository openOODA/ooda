// # Compiler compile-time macro expansion pass
//
// Logline: Scans token streams for macro invocations, substitutes templates, and expands AST macros.
//
// Setup: Imports ast_macros.oo for MacroTable and MacroDef definitions.
//
// Beats:
//   1. Scan token stream for macro call sites and quote blocks.
//   2. Expand macro invocations into replacement token streams with hygiene remapping.
//   3. Detect recursive macro expansion loops and enforce expansion depth limits.
//
// residual: Dynamic macro bytecode compilation requires JIT VM evaluation

import "ast_macros.oo";

pub fn macro_expand_call(tab: &mut MacroTable, name: String, arg_val: String) -> List[String] {
    let idx: Int = macro_table_find(tab, name);
    if idx < 0 {
        let empty_res: List[String] = list_new();
        return empty_res;
    }
    let defs: List[MacroDef] = (*tab).defs;
    let mdef: MacroDef = list_get(defs, idx);
    let tmpl: List[String] = (mdef).template_tokens;
    let params: List[String] = (mdef).params;
    return macro_substitute_tokens(tmpl, params, arg_val);
}

pub fn macro_expand_token_stream(tab: &mut MacroTable, toks: List[String]) -> List[String] {
    let n: Int = list_len(toks);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(toks, i);
        let k: String = ast_macro_field_at(line, 0);
        let text: String = ast_macro_field_at(line, 3);
        let mut expanded: Bool = false;
        if k == "IDENT" && i + 3 < n {
            let next_k: String = ast_macro_field_at(list_get(toks, i + 1), 0);
            let arg_line: String = list_get(toks, i + 2);
            let rparen_k: String = ast_macro_field_at(list_get(toks, i + 3), 0);
            if next_k == "LPAREN" && rparen_k == "RPAREN" {
                let idx: Int = macro_table_find(tab, text);
                if idx >= 0 {
                    let arg_val: String = ast_macro_field_at(arg_line, 3);
                    let exp_toks: List[String] = macro_expand_call(tab, text, arg_val);
                    let en: Int = list_len(exp_toks);
                    let mut ei: Int = 0;
                    while ei < en {
                        out = list_push(out, list_get(exp_toks, ei));
                        ei = ei + 1;
                    }
                    i = i + 4;
                    expanded = true;
                }
            }
        }
        if !expanded {
            out = list_push(out, line);
            i = i + 1;
        }
    }
    return out;
}

pub fn macro_expand_count(tab: &MacroTable) -> Int {
    return (*tab).count;
}

pub fn macro_expand_verify_hygiene(tab: &MacroTable, sym: String) -> Bool {
    let n: Int = chars_len(sym);
    if n > 4 {
        let prefix: String = str_slice(sym, 0, 4);
        if prefix == "__m_" {
            return true;
        }
    }
    return false;
}
