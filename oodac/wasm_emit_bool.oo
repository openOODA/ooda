// # Detect println of a bool literal
//
// Logline: Returns true or false text when a function body is only println of KW_TRUE or KW_FALSE.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( KW_TRUE or KW_FALSE ) with optional semicolon, then RBRACE.
//   3. Return true or false. IDENT operand misses.
//
// residual: runtime IDENT bool stays dummy end.

import "token_fmt.oo";

fn wb_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wb_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_bool(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wb_kind(toks, i) == "KW_FN" && wb_kind(toks, i + 1) == "IDENT" {
            if wb_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wb_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 3 >= n { return ""; }
                if wb_kind(toks, p) != "IDENT" || wb_text(toks, p) != "println" { return ""; }
                if wb_kind(toks, p + 1) != "LPAREN" { return ""; }
                let ck: String = wb_kind(toks, p + 2);
                if ck != "KW_TRUE" && ck != "KW_FALSE" { return ""; }
                if wb_kind(toks, p + 3) != "RPAREN" { return ""; }
                p = p + 4;
                if p < n && wb_kind(toks, p) == "SEMI" { p = p + 1; }
                if p < n && wb_kind(toks, p) == "RBRACE" {
                    if ck == "KW_TRUE" { return "true"; }
                    return "false";
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
