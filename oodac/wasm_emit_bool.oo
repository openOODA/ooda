// # Detect println of a bool literal
//
// Logline: Returns true or false text when a function body is only println of KW_TRUE or KW_FALSE or IDENT bool.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( KW_TRUE|KW_FALSE|IDENT ) with optional semicolon, then RBRACE.
//   3. Return true or false. IDENT resolved via let bool lookup.
//
// residual: runtime bool stays dummy end.

import "token_fmt.oo";

fn wb_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wb_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wb_bool_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wb_kind(toks, p) == "KW_LET" && wb_kind(toks, p + 1) == "IDENT" && wb_text(toks, p + 1) == name && wb_kind(toks, p + 2) == "EQ" {
            let vk: String = wb_kind(toks, p + 3);
            if vk == "KW_TRUE" || vk == "KW_FALSE" { return vk; }
            let vt: String = wb_text(toks, p + 3);
            if vt == "true" { return "KW_TRUE"; }
            if vt == "false" { return "KW_FALSE"; }
        }
        p = p + 1;
    }
    return "";
}
fn wb_bool_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    let k: String = wb_kind(toks, pos);
    if k == "KW_TRUE" || k == "KW_FALSE" { return k; }
    if k == "IDENT" {
        let name: String = wb_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wb_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wb_bool_let(toks, lb, pos, name);
    }
    return "";
}
fn wb_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wb_kind(toks, i) == "KW_FN" && wb_kind(toks, i + 1) == "IDENT" && wb_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wb_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wb_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wb_kind(toks, p) == "KW_LET" {
        while p < n && wb_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wb_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_println_bool(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wb_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wb_p(toks, n, f + 2);
    if p0 < 0 || p0 + 3 >= n { return ""; }
    if wb_kind(toks, p0) != "IDENT" || wb_text(toks, p0) != "println" { return ""; }
    if wb_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    let ck: String = wb_bool_val(toks, p0 + 2, n);
    if ck != "KW_TRUE" && ck != "KW_FALSE" { return ""; }
    if wb_kind(toks, p0 + 3) != "RPAREN" { return ""; }
    let mut p: Int = p0 + 4;
    if p < n && wb_kind(toks, p) == "SEMI" { p = p + 1; }
    if p < n && wb_kind(toks, p) == "RBRACE" {
        if ck == "KW_TRUE" { return "true"; }
        return "false";
    }
    return "";
}
