// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: nested LPAREN / brace-balanced secret RHS scan (peel from c_emit_secret_prop.oo)
// stage: emit
// Set-only (never sticky-clear). rec_depth caps LPAREN recursion (max 64).
// end is exclusive upper bound (caller passes RPAREN index for group interior).
// Compound RHS like f(g(secret)) and f(if c { secret } else { y }) taint dest.

pub fn c_secret_prop_from_rhs_scan(toks: List[String], pos: Int, end: Int, env: String, dest: String, rec_depth: Int) -> String {
    let mut i = pos;
    let mut is_secret = false;
    let mut brace_depth = 0;
    while i < end {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "LBRACE" {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            i = i + 1;
        } else if k == "LPAREN" {
            let mut pd = 1;
            let mut j = i + 1;
            while j < end && pd > 0 {
                let kk: String = field_at(list_get(toks, j), 0);
                if kk == "LPAREN" {
                    pd = pd + 1;
                } else if kk == "RPAREN" {
                    pd = pd - 1;
                }
                j = j + 1;
            }
            // Dive into nested group under depth cap; else flat-walk IDENTs.
            if rec_depth < 64 {
                env = c_secret_prop_from_rhs_scan(toks, i + 1, j - 1, env, dest, rec_depth + 1);
            } else {
                let mut fi = i + 1;
                while fi < j - 1 {
                    if field_at(list_get(toks, fi), 0) == "IDENT" {
                        if c_secret_tok_is_sec(toks, fi, end, env) {
                            is_secret = true;
                        }
                    }
                    fi = fi + 1;
                }
            }
            if c_env_get(env, "__sec__" + dest) == "1" {
                is_secret = true;
            }
            // Always advance past matched group — guarantees progress.
            if j > i {
                i = j;
            } else {
                i = i + 1;
            }
        } else {
            if k == "IDENT" {
                if c_secret_tok_is_sec(toks, i, end, env) {
                    is_secret = true;
                }
            }
            i = i + 1;
        }
    }
    if is_secret {
        return c_env_put(env, "__sec__" + dest, "1");
    }
    return env;
}
