// # Scan a nested secret RHS
//
// Logline: Walks a brace-balanced, paren-grouped RHS and sets dest secret when any IDENT is already secret.
//
// Setup: field_at, list_get, c_secret_tok_is_sec, c_env_get, and c_env_put exist; end is exclusive; rec_depth caps LPAREN recursion at 64; the env is set-only and never sticky-clears.
//
// Beats:
//   1. Walk from pos to end, tracking brace depth on LBRACE and RBRACE.
//   2. On LPAREN, match the group and recurse when rec_depth is under 64, else flat-walk IDENTs; always advance past the group.
//   3. On IDENT, mark secret via c_secret_tok_is_sec; if dest is secret, put __sec__ plus dest as 1.

pub fn c_secret_prop_from_rhs_scan(toks: List[String], pos: Int, end: Int, n: Int, env: String, dest: String, rec_depth: Int) -> String {
    let mut i = pos;
    let mut is_secret = false;
    let mut brace_depth = 0;
    while i < end {
        let k: String = c_tokk(toks, i);
        if k == "LBRACE" {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if k == "RBRACE" {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            i = i + 1;
        } else if k == "LPAREN" {
            let mut pd = 1;
            let mut j = i + 1;
            while j < end && pd > 0 {
                let kk: String = c_tokk(toks, j);
                if kk == "LPAREN" {
                    pd = pd + 1;
                } else if kk == "RPAREN" {
                    pd = pd - 1;
                }
                j = j + 1;
            }
            // Dive into nested group under depth cap; else flat-walk IDENTs.
            if rec_depth < 64 {
                env = c_secret_prop_from_rhs_scan(toks, i + 1, j - 1, n, env, dest, rec_depth + 1);
            } else {
                let mut fi = i + 1;
                while fi < j - 1 {
                    if c_tokk(toks, fi) == "IDENT" {
                        if c_secret_tok_is_sec(toks, fi, n, env) {
                            is_secret = true;
                        }
                    }
                    fi = fi + 1;
                }
            }
            if c_env_get(env, "__sec__" + dest) == "1" {
                is_secret = true;
            }
            // Always advance past matched group — guarantees progress.
            if j > i {
                i = j;
            } else {
                i = i + 1;
            }
        } else {
            if k == "IDENT" {
                if c_secret_tok_is_sec(toks, i, n, env) {
                    is_secret = true;
                }
            }
            i = i + 1;
        }
    }
    if is_secret {
        return c_env_put(env, "__sec__" + dest, "1");
    }
    return env;
}
