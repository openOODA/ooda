// # Lower a method call to LLVM
//
// Logline: From the DOT after a receiver name, emits a load and, for to_string, a call to oo_int_to_str, then returns value, type, pos, and env.
//
// Setup: pos is the DOT after the receiver; field_at, list_get, list_push, list_new, and println exist; llvm_env_get_var_ty, llvm_ty_map, and llvm_gen_reg live in sibling emit files; env is the five-slot LLVM emit env.
//
// Beats:
//   1. Read the method name, skip empty parentheses, and load the receiver from %name.slot.
//   2. On to_string, call @oo_int_to_str and return the %OoStr register, pos, and env.
//   3. Any other method returns dummy 0 and i64 with the same pos and env.
//
// residual: only to_string is lowered; other methods return dummy 0 / i64

// pos at DOT after receiver name. Returns [val, ty, pos, env…]
pub fn llvm_emit_method(recv_name: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos + 1;
    let mname: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    }
    let mut cur_env: List[String] = env;
    let vty_ooda: String = llvm_env_get_var_ty(cur_env, recv_name);
    let lty: String = llvm_ty_map(vty_ooda);
    let reg_res: List[String] = llvm_gen_reg(cur_env);
    let treg: String = list_get(reg_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_res, 1));
    cur_env = list_push(cur_env, list_get(reg_res, 2));
    cur_env = list_push(cur_env, list_get(reg_res, 3));
    cur_env = list_push(cur_env, list_get(reg_res, 4));
    cur_env = list_push(cur_env, list_get(reg_res, 5));
    println("  " + treg + " = load " + lty + ", " + lty + "* %" + recv_name + ".slot, align 8");
    let reg_res2: List[String] = llvm_gen_reg(cur_env);
    let treg2: String = list_get(reg_res2, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_res2, 1));
    cur_env = list_push(cur_env, list_get(reg_res2, 2));
    cur_env = list_push(cur_env, list_get(reg_res2, 3));
    cur_env = list_push(cur_env, list_get(reg_res2, 4));
    cur_env = list_push(cur_env, list_get(reg_res2, 5));
    if mname == "to_string" {
        println("  " + treg2 + " = call %OoStr @oo_int_to_str(i64 " + treg + ")");
        let mut out: List[String] = list_new();
        out = list_push(out, treg2);
        out = list_push(out, "%OoStr");
        out = list_push(out, p.to_string());
        out = list_push(out, list_get(cur_env, 0));
        out = list_push(out, list_get(cur_env, 1));
        out = list_push(out, list_get(cur_env, 2));
        out = list_push(out, list_get(cur_env, 3));
        out = list_push(out, list_get(cur_env, 4));
        return out;
    }
    let mut bad: List[String] = list_new();
    bad = list_push(bad, "0");
    bad = list_push(bad, "i64");
    bad = list_push(bad, p.to_string());
    bad = list_push(bad, list_get(cur_env, 0));
    bad = list_push(bad, list_get(cur_env, 1));
    bad = list_push(bad, list_get(cur_env, 2));
    bad = list_push(bad, list_get(cur_env, 3));
    bad = list_push(bad, list_get(cur_env, 4));
    return bad;
}
