// # Detect const if BOOL && BOOL println fold
//
// Logline: Returns the taken-branch STRING when a function body is only if KW_TRUE/KW_FALSE ANDAND KW_TRUE/KW_FALSE with one println(STRING) per branch.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if BOOL ANDAND BOOL then a println(STRING) branch and an else println(STRING) branch.
//   3. Return then when both sides are KW_TRUE. IDENT operands miss.
//
// residual: runtime IDENT && stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wan_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wan_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wan_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wan_kind(toks, p) != "IDENT" || wan_text(toks, p) != "println" { return empty; }
    if wan_kind(toks, p + 1) != "LPAREN" || wan_kind(toks, p + 2) != "STRING" { return empty; }
    if wan_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wan_text(toks, p + 2);
    p = p + 4;
    if p < n && wan_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn wan_is_bool(k: String) -> Bool {
    if k == "KW_TRUE" { return true; }
    if k == "KW_FALSE" { return true; }
    return false;
}

pub fn wasm_fn_if_and(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wan_kind(toks, i) == "KW_FN" && wan_kind(toks, i + 1) == "IDENT" {
            if wan_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wan_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 4 >= n || wan_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let lk: String = wan_kind(toks, p);
                if !wan_is_bool(lk) { return ""; }
                p = p + 1;
                if p >= n || wan_kind(toks, p) != "ANDAND" { return ""; }
                p = p + 1;
                let rk: String = wan_kind(toks, p);
                if !wan_is_bool(rk) { return ""; }
                let take_then: Bool = lk == "KW_TRUE" && rk == "KW_TRUE";
                p = p + 1;
                if p >= n || wan_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wan_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wan_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wan_kind(toks, p) != "KW_ELSE" { return ""; }
                p = p + 1;
                if p >= n || wan_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let el: List[String] = wan_one_str_println(toks, p, n);
                if list_len(el) < 2 { return ""; }
                p = parse_int(list_get(el, 1));
                if p >= n || wan_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wan_kind(toks, p) != "RBRACE" { return ""; }
                if take_then { return list_get(th, 0); }
                return list_get(el, 0);
            }
        }
        i = i + 1;
    }
    return "";
}
