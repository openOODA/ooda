// job: cap bag + sealed name tables for check; stage: check
// in: names / op strings; out: bag membership + deny side-effect

// Bag of param names: "|fs|other|"
pub fn cap_bag_put(bag: String, name: String) -> String {
    return bag + "|" + name + "|";
}

pub fn cap_bag_has(bag: String, name: String) -> Bool {
    let needle = "|" + name + "|";
    let bn = chars_len(bag);
    let nn = chars_len(needle);
    if nn > bn {
        return false;
    }
    let mut i = 0;
    while i + nn <= bn {
        let mut j = 0;
        let mut ok = true;
        while j < nn {
            if char_at(bag, i + j) != char_at(needle, j) {
                ok = false;
                j = nn;
            } else {
                j = j + 1;
            }
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Deny sealed free/method call. kind: "FsCap"/"SysCap"/"EnvCap"/"NetCap"
pub fn cap_deny(fname: String, op: String, kind: String, line: String, col: String, why: String) {
    println(
        "ERR\tcapability\tSecurity Capability Violation: Function '"
            + fname
            + "' calls sealed effectful builtin '"
            + op
            + "' which requires a &"
            + kind
            + " "
            + why
            + " at line "
            + line
            + ", col "
            + col
            + ". Default-deny: grant the capability token explicitly."
    );
    process_exit(1);
}

// CAP-G1 Path-A: preferred Cap kind for sealed net op (not always NetCap).
// HttpCap: fetch/http_get/net_get/downloadData/query_remote_api/net_connect
// TcpCap:  tcp_connect/tcp_write/tcp_read/tcp_close/tls_connect
// BindCap: tcp_bind
// UdpCap:  bind_udp/udp_recv
// NetCap:  sock_raw/raw_socket only (no soft granular)
// Legacy: NetCap supersedes soft-granular preferred via cap_net_legacy_ok (DE2).
pub fn sealed_net_kind_of(name: String) -> String {
    if name == "fetch" { return "HttpCap"; }
    if name == "http_get" { return "HttpCap"; }
    if name == "net_get" { return "HttpCap"; }
    if name == "downloadData" { return "HttpCap"; }
    if name == "query_remote_api" { return "HttpCap"; }
    if name == "net_connect" { return "HttpCap"; }
    if name == "tcp_connect" { return "TcpCap"; }
    if name == "tcp_write" { return "TcpCap"; }
    if name == "tcp_read" { return "TcpCap"; }
    if name == "tcp_close" { return "TcpCap"; }
    if name == "tls_connect" { return "TcpCap"; }
    if name == "tcp_bind" { return "BindCap"; }
    if name == "bind_udp" { return "UdpCap"; }
    if name == "udp_recv" { return "UdpCap"; }
    if name == "sock_raw" { return "NetCap"; }
    if name == "raw_socket" { return "NetCap"; }
    return "";
}

pub fn is_sealed_net(name: String) -> Bool {
    return sealed_net_kind_of(name) != "";
}

// CAP-G1: soft-granular net preferred kinds (NetCap may supersede these).
pub fn is_soft_net_kind(kind: String) -> Bool {
    if kind == "HttpCap" { return true; }
    if kind == "TcpCap" { return true; }
    if kind == "UdpCap" { return true; }
    if kind == "BindCap" { return true; }
    return false;
}

// CAP-G1: NetCap supersedes soft-granular preferred (one-wave legacy).
// preferred = sealed_kind_of(op); granted_kind = a declared &Cap type name.
// Exact preferred match is caller's job. preferred==NetCap (sock_raw): false here.
pub fn cap_net_legacy_ok(preferred: String, granted_kind: String) -> Bool {
    if granted_kind != "NetCap" { return false; }
    return is_soft_net_kind(preferred);
}

// CAP-G1 bag: exact preferred OR NetCap legacy supersede.
// Replaces inverted "any granular satisfies NetCap" (HttpCap must not authorize tcp_bind).
pub fn cap_net_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(granted_bag, preferred) { return true; }
    if is_soft_net_kind(preferred) {
        if cap_bag_has(granted_bag, "NetCap") { return true; }
    }
    return false;
}

// CAP-G1 arg-flow names bag: preferred:id OR NetCap:id (legacy supersede).
pub fn cap_net_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true; }
    if is_soft_net_kind(preferred) {
        if cap_bag_has(names_bag, "NetCap:" + cap_id) { return true; }
    }
    return false;
}

// CAP-G2 Path-A: preferred fs kind (not always FsCap). Fail-closed: FsReadCap ↛ write.
// FsReadCap: read_file/fs_read/path_exists/file_size; FsWriteCap: write_file/fs_write.
// Legacy: FsCap supersedes soft-granular via cap_fs_granted_ok (DE2).
pub fn sealed_fs_kind_of(name: String) -> String {
    if name == "read_file" { return "FsReadCap"; }
    if name == "fs_read" { return "FsReadCap"; }
    if name == "path_exists" { return "FsReadCap"; }
    if name == "file_size" { return "FsReadCap"; }
    if name == "write_file" { return "FsWriteCap"; }
    if name == "fs_write" { return "FsWriteCap"; }
    return "";
}

// note: verify_human also needs FsCap (emit dual-cap); EnvCap sealed via is_sealed_env
pub fn is_sealed_fs(name: String) -> Bool {
    return sealed_fs_kind_of(name) != "";
}

// CAP-G2: soft-granular fs kinds (FsCap may supersede).
pub fn is_soft_fs_kind(kind: String) -> Bool {
    if kind == "FsReadCap" { return true; }
    if kind == "FsWriteCap" { return true; }
    return false;
}

// CAP-G2 bag: exact preferred OR FsCap legacy (FsReadCap must not authorize write).
pub fn cap_fs_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(granted_bag, preferred) { return true; }
    if is_soft_fs_kind(preferred) {
        if cap_bag_has(granted_bag, "FsCap") { return true; }
    }
    return false;
}

// CAP-G2 arg-flow: preferred:id OR FsCap:id (legacy supersede).
pub fn cap_fs_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true; }
    if is_soft_fs_kind(preferred) {
        if cap_bag_has(names_bag, "FsCap:" + cap_id) { return true; }
    }
    return false;
}

// CAP-G4: preferred Cap kind for sealed process/sys ops.
// ProcessCap: spawn/exec/wait/kill family (least privilege).
// SysCap: residual OS (python_embed, epoll, inotify, prctl, async_join) — hard SysCap only.
// Legacy supersede: SysCap satisfies ProcessCap preferred (one-wave compat).
pub fn sealed_sys_kind_of(name: String) -> String {
    if name == "sys_exec" { return "ProcessCap"; }
    if name == "exec" { return "ProcessCap"; }
    if name == "spawn_process" { return "ProcessCap"; }
    if name == "async_spawn_internal" { return "ProcessCap"; }
    if name == "sys_spawn" { return "ProcessCap"; }
    if name == "sys_wait" { return "ProcessCap"; }
    if name == "sys_kill" { return "ProcessCap"; }
    if name == "async_join" { return "SysCap"; }
    if name == "async_join_internal" { return "SysCap"; }
    if name == "python_embed" { return "SysCap"; }
    if name == "python_embed_internal" { return "SysCap"; }
    if name == "sys_epoll_create" { return "SysCap"; }
    if name == "sys_inotify_init" { return "SysCap"; }
    if name == "sys_prctl" { return "SysCap"; }
    return "";
}

pub fn is_sealed_sys(name: String) -> Bool {
    return sealed_sys_kind_of(name) != "";
}

// CAP-G4: ProcessCap is soft-granular (SysCap may supersede).
pub fn is_soft_sys_kind(kind: String) -> Bool {
    if kind == "ProcessCap" { return true; }
    return false;
}

// CAP-G4 bag: exact preferred OR SysCap legacy supersede for ProcessCap.
// ProcessCap alone must NOT unlock hard SysCap ops (python_embed, prctl, …).
pub fn cap_sys_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(granted_bag, preferred) { return true; }
    if is_soft_sys_kind(preferred) {
        if cap_bag_has(granted_bag, "SysCap") { return true; }
    }
    return false;
}

// CAP-G4 arg-flow: preferred:id OR SysCap:id when preferred is ProcessCap.
pub fn cap_sys_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false; }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true; }
    if is_soft_sys_kind(preferred) {
        if cap_bag_has(names_bag, "SysCap:" + cap_id) { return true; }
    }
    return false;
}

pub fn is_sealed_thread(name: String) -> Bool {
    if name == "mutex_lock" { return true; }
    if name == "mutex_unlock" { return true; }
    if name == "thread_spawn" { return true; }
    if name == "thread_join" { return true; }
    if name == "channel_new" { return true; }
    if name == "channel_send" { return true; }
    if name == "channel_recv" { return true; }
    // M165 path A: thin actor = joinable thread + private mailbox
    if name == "actor_spawn" { return true; }
    if name == "actor_send" { return true; }
    if name == "actor_recv" { return true; }
    return false;
}

pub fn is_sealed_gpu(name: String) -> Bool {
    if name == "gpu_launch" { return true; }
    return false;
}

pub fn is_sealed_env(name: String) -> Bool {
    if name == "env_get" { return true; }
    if name == "env_set" { return true; }
    if name == "getenv" { return true; }
    // ZT path A: verify_human needs EnvCap (FsCap also required at emit)
    if name == "verify_human" { return true; }
    return false;
}

// M12: wall clock / sleep (TimeCap)
pub fn is_sealed_time(name: String) -> Bool {
    if name == "now_ms" { return true; }
    if name == "sleep_ms" { return true; }
    return false;
}

// M12: OS entropy (RandCap)
pub fn is_sealed_rand(name: String) -> Bool {
    if name == "random" { return true; }
    if name == "seed" { return true; }
    return false;
}

// M17: explicit alloc helpers only (AllocCap) — not list_new / ambient CHS
// M166: malloc/free/realloc product aliases (same seal)
pub fn is_sealed_alloc(name: String) -> Bool {
    if name == "alloc_bytes" { return true; }
    if name == "free_bytes" { return true; }
    if name == "malloc" { return true; }
    if name == "free" { return true; }
    if name == "realloc" { return true; }
    return false;
}

// M152 Cap vs FFI path A: raw dlopen / host-FFI free names need &UnsafeFFICap
pub fn is_sealed_ffi(name: String) -> Bool {
    if name == "dlopen" { return true; }
    if name == "dlsym" { return true; }
    if name == "dlclose" { return true; }
    if name == "chs_build" { return true; }
    if name == "host_ast_dump" { return true; }
    if name == "host_check" { return true; }
    if name == "host_token_dump" { return true; }
    if name == "host_free" { return true; }
    if name == "ooda_host_ast_dump" { return true; }
    if name == "ooda_host_check" { return true; }
    if name == "ooda_host_token_dump" { return true; }
    if name == "ooda_host_chs_build" { return true; }
    if name == "ooda_host_free" { return true; }
    return false;
}

// Cap type names accepted after COLON+AMP in param lists
// M174 / Round 2.12: HitlCap + AuditCap first-class.
// V2 granular 2026-08-12: accept all CAPS.oot 27 caps (CAP-G1 needs Http/Tcp/Udp/Bind).
pub fn is_cap_type(t: String) -> Bool {
    if t == "NetCap" { return true; }
    if t == "FsCap" || t == "FsReadCap" || t == "FsWriteCap" { return true; }
    if t == "GpuCap" || t == "ThreadCap" { return true; }
    if t == "SysCap" { return true; }
    if t == "EnvCap" { return true; }
    if t == "TimeCap" { return true; }
    if t == "RandCap" { return true; }
    if t == "AllocCap" || t == "MemCap" { return true; }
    if t == "UnsafeFFICap" || t == "FfiCap" { return true; }
    if t == "HitlCap" { return true; }
    if t == "AuditCap" || t == "SignCap" { return true; }
    if t == "HttpCap" || t == "TcpCap" || t == "UdpCap" || t == "BindCap" { return true; }
    if t == "ProcessCap" || t == "SyncCap" { return true; }
    if t == "AudioCap" || t == "CameraCap" || t == "UsbCap" || t == "HidCap" { return true; }
    if t == "WindowCap" || t == "FrameCap" { return true; }
    return false;
}

// F02 / Round 2.4: walk __alias__ chain so rebinds resolve to sealed name.
pub fn c_arg_cap_type_resolved(env: String, name: String, param_types: String) -> String {
    let max_depth = 32;
    let mut cur = name;
    let mut depth = 0;
    while depth < max_depth {
        let kind: String = sealed_kind_of(cur);
        if kind != "" {
            return kind;
        }
        let next: String = c_env_get(env, "__alias__" + cur);
        if next == "" {
            return "";
        }
        cur = next;
        depth = depth + 1;
    }
    return "";
}

// Sealed free-call name → preferred Cap kind, or "" if not sealed.
// CAP-G1: net → HttpCap/TcpCap/UdpCap/BindCap/NetCap (sealed_net_kind_of).
// CAP-G2: fs  → FsReadCap/FsWriteCap (sealed_fs_kind_of); FsCap legacy supersede.
// CAP-G4: sys → ProcessCap for exec/spawn/wait/kill; SysCap for residual OS.
// check_caps: exact preferred; NetCap/FsCap/SysCap supersede via cap_*_granted_ok.
pub fn sealed_kind_of(name: String) -> String {
    let nk: String = sealed_net_kind_of(name);
    if nk != "" { return nk; }
    let fk: String = sealed_fs_kind_of(name);
    if fk != "" { return fk; }
    let sk: String = sealed_sys_kind_of(name);
    if sk != "" { return sk; }
    if is_sealed_env(name) { return "EnvCap"; }
    if is_sealed_time(name) { return "TimeCap"; }
    if is_sealed_rand(name) { return "RandCap"; }
    if is_sealed_alloc(name) { return "AllocCap"; }
    if is_sealed_ffi(name) { return "UnsafeFFICap"; }
    if is_sealed_thread(name) { return "ThreadCap"; }
    if is_sealed_gpu(name) { return "GpuCap"; }
    return "";
}
