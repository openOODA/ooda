// # AST node types for c_emit Phase A
//
// Logline: Typed AST representation that runs after tokenize_lines and before c_emit_stream_toks_at, giving the type-checker a structured view of the source and Phase C a target for template emit.
//
// Setup: 10 top-level node kinds, exhaustive over what c_emit_fn.oo, c_emit_let.oo, c_emit_call.oo, c_emit_struct.oo currently consume. Threaded through c_emit without rewriting any c_emit_*.oo in Phase A. Source analogues: c_emit_fn.oo:51-95, c_emit_let.oo:46-90, c_emit_call.oo:33-228, c_emit_struct.oo:15-113, c_emit.oo:79-197. Spec: openOODA/audit/green/c_emit_refactor_phase_a.oot §3.
//
// Beats:
//   1. Sum types (AstItem, AstStmt, AstExpr, AstTy) via String-tagged records.
//   2. Constructor helpers for each node kind.
//   3. Tag/arg/len helpers at the bottom for traversal.
//
// Notes: ≤ 256 lines; only `.oo`/`.oot`; ASD-STE100. Sums are String-tagged records (not native enums) to match the existing c_emit pattern. Helpers (ast_tag, ast_is, list_*) live at the bottom.

pub fn mk_file(items: String) -> String { return "AstFile(" + items + ")"; }
pub fn mk_import(path: String) -> String { return "AstImport(" + path + ")"; }
pub fn mk_type(name: String, fields: String) -> String { return "AstType(" + name + "," + fields + ")"; }
pub fn mk_fn(name: String, params: String, ret: String, contracts: String, body: String) -> String {
    return "AstFn(" + name + "," + params + "," + ret + "," + contracts + "," + body + ")";
}
pub fn mk_trait(name: String, methods: String) -> String { return "AstTrait(" + name + "," + methods + ")"; }
pub fn mk_impl(trait_name: String, ty: String, methods: String) -> String {
    return "AstImpl(" + trait_name + "," + ty + "," + methods + ")";
}
pub fn mk_verify(expr: String) -> String { return "AstVerify(" + expr + ")"; }
pub fn mk_param(name: String, ty: String) -> String { return "AstParam(" + name + "," + ty + ")"; }
pub fn mk_block(stmts: String, expr: String) -> String { return "AstBlock(" + stmts + "," + expr + ")"; }

pub fn mk_slet(name: String, ty: String, rhs: String) -> String { return "SLet(" + name + "," + ty + "," + rhs + ")"; }
pub fn mk_slet_mut(name: String, ty: String, rhs: String) -> String { return "SLetMut(" + name + "," + ty + "," + rhs + ")"; }
pub fn mk_sassign(lhs: String, rhs: String) -> String { return "SAssign(" + lhs + "," + rhs + ")"; }
pub fn mk_sexpr(expr: String) -> String { return "SExpr(" + expr + ")"; }
pub fn mk_swhile(cond: String, body: String) -> String { return "SWhile(" + cond + "," + body + ")"; }
pub fn mk_sfor(init: String, cond: String, step: String, body: String) -> String {
    return "SFor(" + init + "," + cond + "," + step + "," + body + ")";
}
pub fn mk_sreturn(expr: String) -> String { return "SReturn(" + expr + ")"; }
pub fn mk_sbreak() -> String { return "SBreak"; }
pub fn mk_scontinue() -> String { return "SContinue"; }
pub fn mk_sempty() -> String { return "SEmpty"; }

pub fn mk_eint(v: String) -> String { return "ELitInt(" + v + ")"; }
pub fn mk_efloat(v: String) -> String { return "ELitFloat(" + v + ")"; }
pub fn mk_estr(v: String) -> String { return "ELitStr(" + v + ")"; }
pub fn mk_ebool(v: String) -> String { return "ELitBool(" + v + ")"; }
pub fn mk_evar(name: String) -> String { return "EVar(" + name + ")"; }
pub fn mk_ebinop(op: String, l: String, r: String) -> String { return "EBinop(" + op + "," + l + "," + r + ")"; }
pub fn mk_eunop(op: String, x: String) -> String { return "EUnop(" + op + "," + x + ")"; }
pub fn mk_ecall(callee: String, args: String) -> String { return "ECall(" + callee + "," + args + ")"; }
pub fn mk_emethod(recv: String, name: String, args: String) -> String { return "EMethod(" + recv + "," + name + "," + args + ")"; }
pub fn mk_efield(recv: String, name: String) -> String { return "EField(" + recv + "," + name + ")"; }
pub fn mk_earrow(recv: String, name: String) -> String { return "EArrow(" + recv + "," + name + ")"; }
pub fn mk_eindex(base: String, idx: String) -> String { return "EIndex(" + base + "," + idx + ")"; }
pub fn mk_estruct_lit(name: String, fields: String) -> String { return "EStructLit(" + name + "," + fields + ")"; }
pub fn mk_eif(cond: String, then_e: String, else_e: String) -> String { return "EIf(" + cond + "," + then_e + "," + else_e + ")"; }
pub fn mk_ematch(scrut: String, arms: String) -> String { return "EMatch(" + scrut + "," + arms + ")"; }
pub fn mk_eclosure(params: String, body: String) -> String { return "EClosure(" + params + "," + body + ")"; }

pub fn mk_ty_int() -> String { return "TyInt"; }
pub fn mk_ty_float() -> String { return "TyFloat"; }
pub fn mk_ty_bool() -> String { return "TyBool"; }
pub fn mk_ty_str() -> String { return "TyStr"; }
pub fn mk_ty_unit() -> String { return "TyUnit"; }
pub fn mk_ty_list(elem: String) -> String { return "TyList(" + elem + ")"; }
pub fn mk_ty_result(ok: String, err: String) -> String { return "TyResult(" + ok + "," + err + ")"; }
pub fn mk_ty_name(n: String) -> String { return "TyName(" + n + ")"; }
pub fn mk_ty_cap(n: String) -> String { return "TyCap(" + n + ")"; }
pub fn mk_ty_ref(n: String) -> String { return "TyRef(" + n + ")"; }
pub fn mk_ty_ref_mut(n: String) -> String { return "TyRefMut(" + n + ")"; }

pub fn mk_field(name: String, ty: String) -> String { return "AstField(" + name + "," + ty + ")"; }
pub fn mk_resolved(ty: String, struct_name: String, fn_name: String) -> String {
    return "AstResolved(" + ty + "," + struct_name + "," + fn_name + ")";
}

pub fn ast_tag(node: String) -> String {
    let n: Int = chars_len(node);
    let mut i: Int = 0;
    while i < n {
        if char_at(node, i) == "(" {
            return str_slice(node, 0, i);
        }
        i = i + 1;
    }
    return node;
}

pub fn ast_is(node: String, tag: String) -> Bool {
    return ast_tag(node) == tag;
}

pub fn list_len_str(items: String) -> Int {
    if items == "" {
        return 0;
    }
    let n: Int = chars_len(items);
    let mut count: Int = 1;
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(items, i);
        if c == "(" { depth = depth + 1; }
        if c == ")" { depth = depth - 1; }
        if c == "," && depth == 0 { count = count + 1; }
        i = i + 1;
    }
    return count;
}

pub fn list_get_str(items: String, idx: Int) -> String {
    if items == "" {
        return "";
    }
    let n: Int = chars_len(items);
    let mut start: Int = 0;
    let mut count: Int = 0;
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(items, i);
        if c == "(" { depth = depth + 1; }
        if c == ")" { depth = depth - 1; }
        if c == "," && depth == 0 {
            if count == idx {
                return str_slice(items, start, i);
            }
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if count == idx {
        return str_slice(items, start, n);
    }
    return "";
}
