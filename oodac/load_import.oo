// job: multi-file import load; cycle/missing fail-closed; stage: load
// in:  FsCap + path
// out: expanded source String (process_exit on ERR)
// residual: emit-c multi-module may still use scripts/oodac_concat.sh (see BUILD_OUT)
// residual Issue #9: concat renumbers lines across imports — typecheck
//   reports expanded-stream LINE:COL, not per-file local. Fix needs
//   line_base / per-file tokenize or path markers in expanded source.
// residual OODA_STD_PATH: not read on product path A. load has FsCap only;
//   env_get needs EnvCap; process-policy getenv is C-runtime, not .oo here.
//   No absolute /home probes. Relative std probes only (see resolve below).

fn path_marker(path: String) -> String {
    return "\t" + path + "\t";
}

pub fn set_has(set: String, path: String) -> Bool {
    return set.contains(path_marker(path));
}

pub fn set_add(set: String, path: String) -> String {
    if set_has(set, path) {
        return set;
    }
    return set + path + "\t";
}

pub fn path_dirname(path: String) -> String {
    let n = chars_len(path);
    let mut found = false;
    let mut slash = 0;
    let mut j = 0;
    while j < n {
        if char_at(path, j) == "/" {
            found = true;
            slash = j;
        }
        j = j + 1;
    }
    if !found {
        return ".";
    }
    if slash == 0 {
        return "/";
    }
    return str_slice(path, 0, slash);
}

pub fn path_join(dir: String, name: String) -> String {
    if chars_len(name) > 0 {
        if char_at(name, 0) == "/" {
            return name;
        }
    }
    if dir == "." {
        return name;
    }
    if dir == "/" {
        return "/" + name;
    }
    return dir + "/" + name;
}

// Parse leading `import "name";` (same surface as scripts/oodac_concat.sh).
// Empty string = not an import line. Non-empty names are zero-trust checked
// via reject_bad_import_name before resolution.
pub fn parse_import_line(line: String) -> String {
    let n = chars_len(line);
    if n < 10 {
        return "";
    }
    if str_slice(line, 0, 7) != "import " {
        return "";
    }
    if char_at(line, 7) != "\"" {
        return "";
    }
    let mut i = 8;
    let mut name = "";
    while i < n {
        let c = char_at(line, i);
        if c == "\"" {
            if name == "" {
                return "";
            }
            return name;
        }
        name = name + c;
        i = i + 1;
    }
    return "";
}

// Fail-closed: relative module names only (no abs, home, parent, or slash tricks).
fn reject_bad_import_name(imp: String) {
    if chars_len(imp) == 0 {
        println("ERR\timport\tempty name");
        process_exit(1);
    }
    if char_at(imp, 0) == "/" {
        println("ERR\timport\tabsolute path rejected: " + imp);
        process_exit(1);
    }
    if char_at(imp, 0) == "~" {
        println("ERR\timport\thome path rejected: " + imp);
        process_exit(1);
    }
    if imp.contains("..") {
        println("ERR\timport\tpath escape rejected: " + imp);
        process_exit(1);
    }
    if imp.contains("\\") {
        println("ERR\timport\tbackslash path rejected: " + imp);
        process_exit(1);
    }
    let n = chars_len(imp);
    let mut j = 0;
    while j < n {
        if char_at(imp, j) == "\0" {
            println("ERR\timport\tNUL in name rejected");
            process_exit(1);
        }
        j = j + 1;
    }
}

// DFS expand: imports first (once), then body without import lines.
// stack / done encoded as "\tpath\tpath2\t".
// Returns [done', content].
fn load_expand(fs: &FsCap, path: String, stack: String, done: String) -> List[String] {
    let mut out: List[String] = list_new();
    if set_has(done, path) {
        out = list_push(out, done);
        out = list_push(out, "");
        return out;
    }
    if set_has(stack, path) {
        println("ERR\timport\tcycle involving " + path);
        process_exit(1);
    }
    let stack2: String = set_add(stack, path);
    let src_r = read_file(fs, path);
    if src_r.is_err() {
        let e: String = match src_r {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("ERR\timport\tmissing " + path + " (" + e + ")");
        process_exit(1);
    }
    let src: String = match src_r {
        Ok(s) => s,
        Err(msg) => msg,
    };
    let dir: String = path_dirname(path);
    let mut done_cur: String = done;
    let mut body: String = "";
    let mut line: String = "";
    let mut i = 0;
    let n = chars_len(src);
    while i <= n {
        let at_end = i == n;
        let mut c: String = "\n";
        if !at_end {
            c = char_at(src, i);
        }
        if c == "\n" || at_end {
            let imp: String = parse_import_line(line);
            if imp != "" {
                reject_bad_import_name(imp);
                // Relative-only std probes (no OODA_STD_PATH, no abs /home).
                // Extra probe via literal ../../../std — still relative-only.
                let mut ipath: String = path_join(dir, imp);
                let mut found = path_exists(fs, ipath);
                if !found {
                    if path_exists(fs, path_join("std", imp)) {
                        ipath = path_join("std", imp);
                        found = true;
                    } else if path_exists(fs, path_join("../std", imp)) {
                        ipath = path_join("../std", imp);
                        found = true;
                    } else if path_exists(fs, path_join("../../std", imp)) {
                        ipath = path_join("../../std", imp);
                        found = true;
                    } else if path_exists(fs, path_join("../../../std", imp)) {
                        ipath = path_join("../../../std", imp);
                        found = true;
                    }
                }
                if !found {
                    println(
                        "ERR\timport\tnot found after relative probes (dir/std/../std/../../std/../../../std): "
                            + imp
                    );
                    process_exit(1);
                }
                let sub: List[String] = load_expand(fs, ipath, stack2, done_cur);
                done_cur = list_get(sub, 0);
                body = body + list_get(sub, 1);
            } else {
                body = body + line;
                if !at_end {
                    body = body + "\n";
                }
            }
            line = "";
            if at_end {
                i = n + 1;
            } else {
                i = i + 1;
            }
        } else {
            line = line + c;
            i = i + 1;
        }
    }
    done_cur = set_add(done_cur, path);
    out = list_push(out, done_cur);
    out = list_push(out, body);
    return out;
}

// Product path: check|tokens|ast expand imports in-tree (fail-closed).
pub fn load_source_with_imports(fs: &FsCap, path: String) -> String {
    let r: List[String] = load_expand(fs, path, "\t", "\t");
    return list_get(r, 1);
}
