// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: CRIT 2.4 secret sink alias rebind (__alias__f = println|tcp_write|…)
// stage: emit
// Record let/assign aliases to known sinks; resolve callee for guard + check.

// Known free-call sink names (secret refuse surface). Keep in sync with
// check_secret_println_sinks / c_secret_emit_guard branches.
pub fn c_secret_is_sink_name(name: String) -> Bool {
    if name == "println" || name == "eprintln" || name == "print_err" || name == "log"
        || name == "fprintf" || name == "syslog" {
        return true;
    }
    if name == "write_file" || name == "fetch" || name == "sys_exec" {
        return true;
    }
    if name == "env_get" || name == "env_set" || name == "setenv" || name == "unsetenv" {
        return true;
    }
    if name == "read_file" || name == "path_exists" || name == "file_size" {
        return true;
    }
    if name == "process_exit" || name == "sleep_ms" || name == "seed" {
        return true;
    }
    if name == "alloc_bytes" || name == "free_bytes" || name == "malloc" || name == "free"
        || name == "realloc" {
        return true;
    }
    if name == "mmap" || name == "mprotect" || name == "shmat" || name == "pwrite"
        || name == "sendfile" || name == "splice" || name == "tee" {
        return true;
    }
    // Net / FFI friends (alias rebind surface)
    if name == "tcp_write" || name == "net_tcp_write" || name == "net_send" || name == "http_post"
        || name == "tcp_read" || name == "udp_recv" {
        return true;
    }
    if name == "dlopen" || name == "dlsym" || name == "dlclose" || name == "ffi_call"
        || name == "ffi_prep_cif" {
        return true;
    }
    return false;
}

// Walk __alias__ chain (depth-capped). Returns original name if no alias.
pub fn c_secret_resolve_alias(env: String, name: String) -> String {
    let mut cur: String = name;
    let mut i: Int = 0;
    while i < 16 {
        let next: String = c_env_get(env, "__alias__" + cur);
        if next != "" {
            cur = next;
            i = i + 1;
        } else {
            i = 16;
        }
    }
    return cur;
}

// True only when env marks name secret with exact "1" (DE1 clear uses "0").
pub fn c_secret_is_tainted(env: String, name: String) -> Bool {
    return c_env_get(env, "__sec__" + name) == "1";
}

// Record __alias__dest = rhs when rhs is a known sink OR already aliases one.
pub fn c_secret_record_alias_let(env: String, dest: String, rhs: String) -> String {
    if dest == "" || rhs == "" {
        return env;
    }
    if dest == rhs {
        return env;
    }
    let mut should: Bool = false;
    if c_secret_is_sink_name(rhs) {
        should = true;
    } else {
        let al: String = c_env_get(env, "__alias__" + rhs);
        if al != "" {
            should = true;
        } else {
            let resolved: String = c_secret_resolve_alias(env, rhs);
            if c_secret_is_sink_name(resolved) {
                should = true;
            }
        }
    }
    if should {
        return c_env_put(env, "__alias__" + dest, rhs);
    }
    return env;
}

// Clear function-alias binding on dest (clean / non-sink rebind).
pub fn c_secret_clear_alias(env: String, dest: String) -> String {
    if dest == "" {
        return env;
    }
    if c_env_get(env, "__alias__" + dest) != "" {
        return c_env_put(env, "__alias__" + dest, "");
    }
    return env;
}

// At RHS of let/assign: single bare IDENT → try record; else clear prior alias.
// Bare IDENT means next token is SEMI / RBRACE / EOF-ish (not LPAREN/DOT/call).
pub fn c_secret_try_record_alias_rhs(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
        let rhs: String = field_at(list_get(toks, pos), 3);
        let mut bare: Bool = true;
        if pos + 1 < n {
            let nk: String = field_at(list_get(toks, pos + 1), 0);
            // SEMI / RBRACE end the bare alias form. LPAREN starts a call.
            if nk == "LPAREN" || nk == "DOT" || nk == "LBRACKET" || nk == "COLON"
                || nk == "PLUS" || nk == "MINUS" || nk == "STAR" || nk == "SLASH"
                || nk == "EQ" || nk == "EQEQ" || nk == "NE" || nk == "LT" || nk == "GT"
                || nk == "AMP" || nk == "PIPE" || nk == "QUESTION" {
                bare = false;
            }
        }
        if bare {
            // Sink (or sink-alias) RHS → record; else drop stale function alias.
            let mut should: Bool = false;
            if c_secret_is_sink_name(rhs) {
                should = true;
            } else if c_env_get(env, "__alias__" + rhs) != "" {
                should = true;
            } else if c_secret_is_sink_name(c_secret_resolve_alias(env, rhs)) {
                should = true;
            }
            if should {
                return c_secret_record_alias_let(env, dest, rhs);
            }
            return c_secret_clear_alias(env, dest);
        }
    }
    return c_secret_clear_alias(env, dest);
}

// --- Compatibility names used by check walk / prop (CRIT 2.4) ---

// Same as c_secret_resolve_alias (check walk historically called resolve_name).
pub fn c_secret_resolve_name(env: String, name: String) -> String {
    return c_secret_resolve_alias(env, name);
}

// Bare IDENT RHS only: dest = other; → record sink alias when applicable.
// Called from check_secret_println_sinks on LET / assign.
pub fn c_secret_note_bare_alias(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    return c_secret_try_record_alias_rhs(toks, pos, n, env, dest);
}

// Explicit API name from sprint brief.
// c_secret_record_alias_let is the core; this is the toks-facing entry.
pub fn c_secret_record_alias_from_let(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    return c_secret_try_record_alias_rhs(toks, pos, n, env, dest);
}
