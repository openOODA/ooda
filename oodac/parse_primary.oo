// # Dispatch Primary Dump
//
// Logline: Try a literal, then IDENT, then a form, then print EXPR VAR and step one token.
//
// Setup: toks rows are kind, line, col, text; pos0 is the current token; parse_primary_try_lit, parse_primary_ident, and parse_primary_try_form are in scope.
//
// Beats:
//   1. Call parse_primary_try_lit; return when lit >= 0.
//   2. On IDENT, return parse_primary_ident.
//   3. Call parse_primary_try_form; return when form >= 0, else println EXPR VAR and return pos0 + 1.

pub fn parse_primary_dump(toks: List[String], pos0: Int, depth: Int) -> Int {
    let lit = 0 + parse_primary_try_lit(toks, pos0, depth);
    if lit >= 0 {
        return lit;
    }
    let k: String = field_at(list_get(toks, pos0), 0);
    if k == "IDENT" {
        return parse_primary_ident(toks, pos0, depth);
    }
    let form = 0 + parse_primary_try_form(toks, pos0, depth);
    if form >= 0 {
        return form;
    }
    let pad: String = indent(depth);
    let line: String = field_at(list_get(toks, pos0), 1);
    let col: String = field_at(list_get(toks, pos0), 2);
    let text: String = field_at(list_get(toks, pos0), 3);
    println(pad + "EXPR VAR " + text + " @" + line + ":" + col);
    return pos0 + 1;
}
