// # Metamorphic Instruction Scheduling Jitter
//
// Logline: Applies instruction dependency analysis, independent instruction reordering, and multi-byte neutral NOP padding.
//
// Setup: Randomizes instruction boundaries and alignment within basic blocks.
//
// Beats:
//   1. Configure jitter seeds and padding bounds.
//   2. Emit multi-byte non-destructive NOP padding variants.
//   3. Insert scheduling jitter NOP variants into instruction streams.
// RULES.oot 1.7: Under 256 lines.

import "meta_insn_subst.oo";

pub fn meta_sched_jitter_nop(bytes: Int) -> String {
    if bytes <= 1 { return "nop"; }
    if bytes == 2 { return "xchg %ax, %ax"; }
    if bytes == 3 { return "lea 0(%rax), %rax"; }
    if bytes == 4 { return "lea 0(%rax,%rax,1), %rax"; }
    return "nop";
}

pub fn meta_sched_jitter_apply(stream: List[String], seed: Int) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(stream);
    let mut i: Int = 0;

    while i < n {
        let insn: String = list_get(stream, i);
        out = list_push(out, insn);
        if (seed + i) % 3 == 0 {
            let nop_insn: String = meta_insn_subst_pack("nop", "", "", 0);
            out = list_push(out, nop_insn);
        }
        i = i + 1;
    }

    return out;
}
