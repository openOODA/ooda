// # Serve the on-disk check cache
//
// Logline: Maps a content key to a hit or a write under .ooda-cache/check so later checks skip work.
//
// Setup: path_exists and read_file take fs: &FsCap; sys_exec takes sys: &SysCap; mkdir is not native so ensure shells mkdir -p; empty keys never hit or write; write_file needs OODA_FS_WRITEDIR so puts stay on sh.
//
// Beats:
//   1. Root is .ooda-cache/check; a key path is that root plus slash plus key.
//   2. Ensure creates the root via sys_exec mkdir -p and returns quietly if the path exists or mkdir fails.
//   3. Hit is path_exists only (put writes OK); put_body writes a listing; keys mix the host ELF stamp (m_ / t_ts4_ / g_).

pub fn check_cache_root() -> String {
    return ".ooda-cache/check";
}

pub fn check_cache_path(key: String) -> String {
    let root: String = check_cache_root();
    return root + "/" + key;
}

pub fn check_cache_ensure(fs: &FsCap, sys: &SysCap) {
    let root: String = check_cache_root();
    if path_exists(fs, root) {
        return;
    }
    let r = sys_exec(sys, "mkdir", "-p", root);
    if r.is_err() {
        return;
    }
}

pub fn check_cache_hit(fs: &FsCap, key: String) -> Bool {
    if chars_len(key) == 0 {
        return false;
    }
    return path_exists(fs, check_cache_path(key));
}

pub fn check_cache_read(fs: &FsCap, key: String) -> String {
    if chars_len(key) == 0 {
        return "";
    }
    let p: String = check_cache_path(key);
    if !path_exists(fs, p) {
        return "";
    }
    let rr = read_file(fs, p);
    if rr.is_err() {
        return "";
    }
    return rr.unwrap();
}

pub fn check_cache_put(fs: &FsCap, sys: &SysCap, key: String) {
    if chars_len(key) == 0 {
        return;
    }
    let p: String = check_cache_path(key);
    let root: String = check_cache_root();
    let cmd: String = "mkdir -p " + root + " && printf 'OK\\n' > " + p;
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if wr.is_err() {
        return;
    }
}

pub fn check_cache_put_body(fs: &FsCap, sys: &SysCap, key: String, body: String) {
    if chars_len(key) == 0 {
        return;
    }
    if chars_len(body) == 0 {
        return;
    }
    if body.contains("'") {
        return;
    }
    let p: String = check_cache_path(key);
    let root: String = check_cache_root();
    let cmd: String = "mkdir -p " + root + " && printf '%s' '" + body + "' > " + p;
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if wr.is_err() {
        return;
    }
}

pub fn check_cache_ident() -> String {
    let st: String = oo_file_stamp("/proc/self/exe");
    if st == "0:0" {
        return "";
    }
    return "ts4\nexe:" + st;
}

pub fn check_cache_mod_key(h: String) -> String {
    let id: String = check_cache_ident();
    if chars_len(id) == 0 {
        return "";
    }
    return "m_" + content_hash(id + "\n" + h);
}

pub fn check_cache_tree_key(h: String) -> String {
    let id: String = check_cache_ident();
    if chars_len(id) == 0 {
        return "";
    }
    return "t_ts4_" + content_hash(id + "\n" + h);
}

pub fn check_cache_graph_key(root: String) -> String {
    let id: String = check_cache_ident();
    if chars_len(id) == 0 {
        return "";
    }
    return "g_" + content_hash(id + "\n" + root);
}
