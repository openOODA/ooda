// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: emit IDENT stmts (println/assert/assign/expr)
// stage: emit

pub fn c_emit_ident_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut e = env;
    let id = field_at(list_get(toks, p), 3);
    if id == "println" {
        p = c_emit_println(toks, p, n, e);
        return c_pack_pos_env(p, e);
    }
    if id == "assert_eq" || id == "assert_ne" || id == "assert" {
        let mut p1 = p + 1;
        if p1 < n && field_at(list_get(toks, p1), 0) == "BANG" { p1 = p1 + 1; }
        if p1 < n && field_at(list_get(toks, p1), 0) == "LPAREN" {
            p1 = p1 + 1;
            let pr1 = c_emit_expr_c(toks, p1, n, e);
            p1 = parse_int(list_get(pr1, 0));
            let arg1 = list_get(pr1, 1);
            if id == "assert" {
                if p1 < n && field_at(list_get(toks, p1), 0) == "RPAREN" { p1 = p1 + 1; }
                println("  oo_assert(" + arg1 + ");");
            } else {
                if p1 < n && field_at(list_get(toks, p1), 0) == "COMMA" { p1 = p1 + 1; }
                let pr2 = c_emit_expr_c(toks, p1, n, e);
                p1 = parse_int(list_get(pr2, 0));
                let arg2 = list_get(pr2, 1);
                if p1 < n && field_at(list_get(toks, p1), 0) == "RPAREN" { p1 = p1 + 1; }
                if id == "assert_eq" {
                    println("  oo_assert_eq(" + arg1 + ", " + arg2 + ");");
                } else {
                    println("  oo_assert_ne(" + arg1 + ", " + arg2 + ");");
                }
            }
            if p1 < n && field_at(list_get(toks, p1), 0) == "SEMI" { p1 = p1 + 1; }
            return c_pack_pos_env(p1, e);
        }
    }
    // M168 path A: field assign `recv.field = rhs` (was silent `recv.field;`)
    if p + 3 < n && field_at(list_get(toks, p + 1), 0) == "DOT"
        && field_at(list_get(toks, p + 2), 0) == "IDENT"
        && field_at(list_get(toks, p + 3), 0) == "EQ" {
        let fname = field_at(list_get(toks, p + 2), 3);
        let lhs = id + "." + fname;
        p = p + 4;
        let pra = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pra, 0));
        let rhs = list_get(pra, 1);
        println("  " + lhs + " = " + rhs + ";");
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    if p + 1 < n && field_at(list_get(toks, p + 1), 0) == "EQ" {
        let name = id;
        p = p + 2;
        // assign match: full arm lower (not silent .val)
        if p < n && field_at(list_get(toks, p), 0) == "KW_MATCH" {
            return c_emit_match_assign(name, toks, p, n, e);
        }
        let rhs_pos = p;
        let pra = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pra, 0));
        let rhs = list_get(pra, 1);
        // Refine kind in the *existing* frame (put_last). Never top-append —
        // that pulled outer muts into while/if frames and released them each iter.
        if chars_len(rhs) >= 12 {
            if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                if chars_len(rhs) >= 14 && char_at(rhs, 9) == "g" {
                    e = c_env_put_last(e, name, "T");
                } else {
                    e = c_env_put_last(e, name, "S");
                }
            }
            if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                e = c_env_put_last(e, name, "I");
            }
        }
        e = c_secret_prop_from_rhs(toks, rhs_pos, n, e, name);
        c_emit_reassign_arc(name, rhs, e);
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    let pr2 = c_emit_expr_c(toks, p, n, e);
    p = parse_int(list_get(pr2, 0));
    let asgn = c_env_get(e, "__asgn__");
    if asgn != "" {
        println("  " + asgn + " = " + list_get(pr2, 1) + ";");
    } else {
        println("  " + list_get(pr2, 1) + ";");
    }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}
