// # Lower binary expressions to WebAssembly
//
// Logline: Applies operator precedence to binary arithmetic, bitwise shifts, comparisons, and logic into WAT instructions.
//
// Setup: token_fmt, tc_parse_int, and wasm_emit_primary are imported; parse_int, field_at, list_get, and list_push exist; env maps name:ty.
//
// Beats:
//   1. Handle leading parenthesized sub-expressions or primary expressions.
//   2. wasm_emit_expr_prec recursively climbs precedence and lowers right operands.
//   3. Emit typed WAT instructions for arithmetic, bitwise, comparison, and logic expressions.

import "tc_parse_int.oo";
import "token_fmt.oo";
import "wasm_emit_mem.oo";
import "wasm_emit_primary.oo";

pub fn wasm_emit_expr_prec(toks: List[String], pos: Int, n: Int, min_prec: Int, env: String, str_tab: List[String]) -> List[String] {
    let mut p = pos;
    let mut ty = "i64";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        let er_lp: List[String] = wasm_emit_expr(toks, p + 1, n, env, str_tab);
        p = parse_int(list_get(er_lp, 0));
        ty = list_get(er_lp, 1);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    } else {
        let pr: List[String] = wasm_emit_primary(toks, p, n, env, str_tab);
        p = parse_int(list_get(pr, 0));
        ty = list_get(pr, 1);
    }
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        let t: String = field_at(list_get(toks, p), 3);
        let mut prec = 0;
        if k == "OROR" || k == "BARBAR" || t == "||" { prec = 1; }
        else if k == "ANDAND" || k == "AMPAMP" || t == "&&" { prec = 2; }
        else if k == "PIPE" || t == "|" { prec = 3; }
        else if k == "CARET" || t == "^" { prec = 4; }
        else if k == "AMP" || t == "&" { prec = 5; }
        else if k == "EQEQ" || k == "NEQ" || k == "LT" || k == "LTE" || k == "GT" || k == "GTE"
            || t == "==" || t == "!=" || t == "<" || t == "<=" || t == ">" || t == ">=" {
            prec = 6;
        } else if k == "LSHIFT" || k == "RSHIFT" || t == "<<" || t == ">>" { prec = 7; }
        else if k == "PLUS" || k == "MINUS" || t == "+" || t == "-" { prec = 8; }
        else if k == "STAR" || k == "SLASH" || k == "PERCENT" || t == "*" || t == "/" || t == "%" { prec = 9; }
        if prec < min_prec || prec == 0 { break; }
        if (prec == 1 || prec == 2) && ty == "i64" {
            println("    i32.wrap_i64");
            ty = "i32";
        }
        p = p + 1;
        let pr2: List[String] = wasm_emit_expr_prec(toks, p, n, prec + 1, env, str_tab);
        p = parse_int(list_get(pr2, 0));
        let ty2: String = list_get(pr2, 1);
        if k == "PLUS" || t == "+" {
            if ty == "i32" && ty2 == "i32" { println("    call $str_concat"); ty = "i32"; }
            else if ty == "f64" { println("    f64.add"); ty = "f64"; }
            else { println("    i64.add"); ty = "i64"; }
        } else if k == "MINUS" || t == "-" {
            if ty == "f64" { println("    f64.sub"); ty = "f64"; }
            else { println("    i64.sub"); ty = "i64"; }
        } else if k == "STAR" || t == "*" {
            if ty == "f64" { println("    f64.mul"); ty = "f64"; }
            else { println("    i64.mul"); ty = "i64"; }
        } else if k == "SLASH" || t == "/" {
            if ty == "f64" { println("    f64.div"); ty = "f64"; }
            else { println("    i64.div_s"); ty = "i64"; }
        } else if k == "PERCENT" || t == "%" { println("    i64.rem_s"); ty = "i64"; }
        else if k == "AMP" || t == "&" { println("    i64.and"); ty = "i64"; }
        else if k == "PIPE" || t == "|" { println("    i64.or"); ty = "i64"; }
        else if k == "CARET" || t == "^" { println("    i64.xor"); ty = "i64"; }
        else if k == "LSHIFT" || t == "<<" { println("    i64.shl"); ty = "i64"; }
        else if k == "RSHIFT" || t == ">>" { println("    i64.shr_s"); ty = "i64"; }
        else if k == "EQEQ" || t == "==" {
            if ty == "i32" && ty2 == "i32" { println("    call $str_eq"); }
            else if ty == "f64" { println("    f64.eq"); }
            else if ty == "i32" { println("    i32.eq"); }
            else { println("    i64.eq"); }
            ty = "i32";
        } else if k == "NEQ" || t == "!=" {
            if ty == "i32" && ty2 == "i32" { println("    call $str_eq"); println("    i32.eqz"); }
            else if ty == "f64" { println("    f64.ne"); }
            else if ty == "i32" { println("    i32.ne"); }
            else { println("    i64.ne"); }
            ty = "i32";
        } else if k == "LT" || t == "<" {
            if ty == "f64" { println("    f64.lt"); }
            else if ty == "i32" { println("    i32.lt_s"); }
            else { println("    i64.lt_s"); }
            ty = "i32";
        } else if k == "LTE" || t == "<=" {
            if ty == "f64" { println("    f64.le"); }
            else if ty == "i32" { println("    i32.le_s"); }
            else { println("    i64.le_s"); }
            ty = "i32";
        } else if k == "GT" || t == ">" {
            if ty == "f64" { println("    f64.gt"); }
            else if ty == "i32" { println("    i32.gt_s"); }
            else { println("    i64.gt_s"); }
            ty = "i32";
        } else if k == "GTE" || t == ">=" {
            if ty == "f64" { println("    f64.ge"); }
            else if ty == "i32" { println("    i32.ge_s"); }
            else { println("    i64.ge_s"); }
            ty = "i32";
        } else if k == "ANDAND" || k == "AMPAMP" || t == "&&" {
            if ty2 == "i64" { println("    i32.wrap_i64"); }
            println("    i32.and");
            ty = "i32";
        } else if k == "OROR" || k == "BARBAR" || t == "||" {
            if ty2 == "i64" { println("    i32.wrap_i64"); }
            println("    i32.or");
            ty = "i32";
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, ty);
    return out;
}

pub fn wasm_emit_expr(toks: List[String], pos: Int, n: Int, env: String, str_tab: List[String]) -> List[String] {
    return wasm_emit_expr_prec(toks, pos, n, 1, env, str_tab);
}
