import "token_fmt.oo";
import "wasm_emit_mem.oo";

pub fn wasm_env_lookup_ty(env: String, name: String) -> String {
    let target = name + ":";
    let n = chars_len(env);
    let tn = chars_len(target);
    let mut i = 0;
    while i + tn <= n {
        let mut match_t = true;
        let mut k = 0;
        while k < tn {
            if char_at(env, i + k) != char_at(target, k) {
                match_t = false;
            }
            k = k + 1;
        }
        if match_t {
            let mut j = i + tn;
            let mut ty = "";
            while j < n && char_at(env, j) != ";" {
                ty = ty + char_at(env, j);
                j = j + 1;
            }
            return ty;
        }
        i = i + 1;
    }
    return "i64";
}

pub fn wasm_emit_primary(toks: List[String], pos: Int, n: Int, env: String, str_tab: List[String]) -> List[String] {
    let mut p = pos;
    let k: String = field_at(list_get(toks, p), 0);
    let t: String = field_at(list_get(toks, p), 3);
    if k == "INT" || k == "NUMBER" {
        println("    i64.const " + t);
        let mut out: List[String] = list_new();
        let p1 = p + 1;
        out = list_push(out, p1.to_string());
        out = list_push(out, "i64");
        return out;
    }
    if k == "FLOAT" {
        println("    f64.const " + t);
        let mut outf: List[String] = list_new();
        let p1 = p + 1;
        outf = list_push(outf, p1.to_string());
        outf = list_push(outf, "f64");
        return outf;
    }
    if k == "STRING" {
        let off = 0 + wasm_str_offset(str_tab, t);
        println("    i32.const " + off.to_string());
        let mut outs: List[String] = list_new();
        let p1 = p + 1;
        outs = list_push(outs, p1.to_string());
        outs = list_push(outs, "i32");
        return outs;
    }
    if k == "KW_TRUE" {
        println("    i32.const 1");
        let mut outt: List[String] = list_new();
        let p1 = p + 1;
        outt = list_push(outt, p1.to_string());
        outt = list_push(outt, "i32");
        return outt;
    }
    if k == "KW_FALSE" {
        println("    i32.const 0");
        let mut outb: List[String] = list_new();
        let p1 = p + 1;
        outb = list_push(outb, p1.to_string());
        outb = list_push(outb, "i32");
        return outb;
    }
    if k == "BANG" || t == "!" {
        p = p + 1;
        let pr: List[String] = wasm_emit_primary(toks, p, n, env, str_tab);
        p = parse_int(list_get(pr, 0));
        println("    i32.eqz");
        let mut outu: List[String] = list_new();
        outu = list_push(outu, p.to_string());
        outu = list_push(outu, "i32");
        return outu;
    }
    if k == "MINUS" || t == "-" {
        p = p + 1;
        let prm: List[String] = wasm_emit_primary(toks, p, n, env, str_tab);
        p = parse_int(list_get(prm, 0));
        println("    i64.const -1");
        println("    i64.mul");
        let mut outm: List[String] = list_new();
        outm = list_push(outm, p.to_string());
        outm = list_push(outm, "i64");
        return outm;
    }
    if k == "LPAREN" {
        p = p + 1;
        let pr2: List[String] = wasm_emit_expr(toks, p, n, env, str_tab);
        p = parse_int(list_get(pr2, 0));
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
        return pr2;
    }
    if k == "IDENT" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
            p = p + 1;
            while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
                if field_at(list_get(toks, p), 0) == "COMMA" {
                    p = p + 1;
                } else {
                    let ar: List[String] = wasm_emit_expr(toks, p, n, env, str_tab);
                    p = parse_int(list_get(ar, 0));
                }
            }
            if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
            println("    call $" + t);
            let mut outc: List[String] = list_new();
            outc = list_push(outc, p.to_string());
            outc = list_push(outc, "i64");
            return outc;
        }
        println("    local.get $" + t);
        let vty: String = wasm_env_lookup_ty(env, t);
        let mut outv: List[String] = list_new();
        outv = list_push(outv, p.to_string());
        outv = list_push(outv, vty);
        return outv;
    }
    let mut out_expr: List[String] = list_new();
    let p1 = p + 1;
    out_expr = list_push(out_expr, p1.to_string());
    out_expr = list_push(out_expr, "i64");
    return out_expr;
}

pub fn wasm_emit_expr(toks: List[String], pos: Int, n: Int, env: String, str_tab: List[String]) -> List[String] {
    let mut pr: List[String] = wasm_emit_primary(toks, pos, n, env, str_tab);
    let mut p = 0 + parse_int(list_get(pr, 0));
    let mut ty: String = list_get(pr, 1);
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        let t: String = field_at(list_get(toks, p), 3);
        if k == "PLUS" || k == "MINUS" || k == "STAR" || k == "SLASH"
            || k == "EQ" || k == "NE" || k == "LT" || k == "LE" || k == "GT" || k == "GE"
            || k == "AMPAMP" || k == "BARBAR" || t == "+" || t == "-" || t == "*" || t == "/"
            || t == "==" || t == "!=" || t == "<" || t == "<=" || t == ">" || t == ">=" || t == "&&" || t == "||"
        {
            p = p + 1;
            let pr2: List[String] = wasm_emit_primary(toks, p, n, env, str_tab);
            p = parse_int(list_get(pr2, 0));
            if k == "PLUS" || t == "+" { println("    i64.add"); ty = "i64"; }
            else if k == "MINUS" || t == "-" { println("    i64.sub"); ty = "i64"; }
            else if k == "STAR" || t == "*" { println("    i64.mul"); ty = "i64"; }
            else if k == "SLASH" || t == "/" { println("    i64.div_s"); ty = "i64"; }
            else if k == "EQ" || t == "==" { println("    i64.eq"); ty = "i32"; }
            else if k == "NE" || t == "!=" { println("    i64.ne"); ty = "i32"; }
            else if k == "LT" || t == "<" { println("    i64.lt_s"); ty = "i32"; }
            else if k == "LE" || t == "<=" { println("    i64.le_s"); ty = "i32"; }
            else if k == "GT" || t == ">" { println("    i64.gt_s"); ty = "i32"; }
            else if k == "GE" || t == ">=" { println("    i64.ge_s"); ty = "i32"; }
            else if k == "AMPAMP" || t == "&&" { println("    i32.and"); ty = "i32"; }
            else if k == "BARBAR" || t == "||" { println("    i32.or"); ty = "i32"; }
        } else {
            break;
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, ty);
    return out;
}
