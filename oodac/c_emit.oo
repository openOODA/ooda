// # Drive C emission
//
// Logline: Tokenize source and emit C preamble, type aliases, and functions, with metamorphic pre-passes.
//
// Setup: Source string is expanded and verified before C code generation.
//
// Beats:
//   1. Print the preamble, MAX_CYCLES, SECRET env, and returning-fn secret marks.
//   2. Pre-pass String returns into fn_env; emit type aliases.
//   3. Walk pub/fn items (optional shuffle), skip verify/type/import, else ERR and exit.

pub fn c_emit_stream(src: String) {
    c_emit_stream_mode(src, "full");
}

// OPEN-70: after preamble, emit #include <hdr> for import "….h" / import_c("….h").
pub fn c_emit_c_headers(src: String) {
    let mut seen: String = "\t";
    seen = c_emit_c_headers_scan(src, "import " + "\"", seen);
    seen = c_emit_c_headers_scan(src, "import_c(" + "\"", seen);
}

pub fn c_emit_c_headers_scan(src: String, pre: String, seen: String) -> String {
    let mut s: String = seen;
    let sn: Int = chars_len(src);
    let pn: Int = chars_len(pre);
    let mut i: Int = 0;
    while i + pn <= sn {
        let mut ok: Bool = true;
        let mut j: Int = 0;
        while j < pn {
            if char_at(src, i + j) != char_at(pre, j) {
                ok = false;
                j = pn;
            } else {
                j = j + 1;
            }
        }
        if ok {
            let start: Int = i + pn;
            let mut k: Int = start;
            while k < sn && char_at(src, k) != "\"" {
                k = k + 1;
            }
            if k < sn {
                let name: String = str_slice(src, start, k);
                let nn: Int = chars_len(name);
                if nn >= 2 && char_at(name, nn - 2) == "." && char_at(name, nn - 1) == "h" {
                    let key: String = "\t" + name + "\t";
                    if !s.contains(key) {
                        s = s + name + "\t";
                        println("#include <" + name + ">");
                    }
                }
            }
            i = k + 1;
        } else {
            i = i + 1;
        }
    }
    return s;
}

pub fn c_emit_stream_mode(src: String, mode: String) {
    if mode != "protos" && mode != "protos_noarc" && mode != "bodies" && mode != "bodies_noarc" {
        c_emit_preamble();
        // full / all / preamble: product path needs #includes from .h imports
        if mode == "full" || mode == "full_noarc" || mode == "all" || mode == "all_noarc"
            || mode == "preamble" || mode == "preamble_noarc" {
            c_emit_c_headers(src);
        }
    }
    if mode == "preamble" || mode == "preamble_noarc" { return; }
    
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    // Program-level: __fr__name=T for String-returning fns (println bare calls).
    let mut fn_env: String = "";
    // Path A: MAX_CYCLES — env marker is 1-char ("Y") so ARC env parser stays sound;
    // budget N is OO_MC_LIMIT macro (multi-digit must not live as c_env value).
    let mc: String = c_parse_max_cycles(src);
    if mc != "" {
        fn_env = c_env_put(fn_env, "__mc__", "Y");
        if mode != "protos" && mode != "protos_noarc" {
            println("#define OO_MC_LIMIT " + mc);
            println("static long long __oo_mc = 0;");
        }
    }
    // Path A: file-level SECRET name tags → __sec__name=1 for println bare-IDENT refuse.
    let sec_env: String = c_parse_secret_env(src);
    if sec_env != "" {
        fn_env = fn_env + sec_env;
    }
    // DE2.1+PV2.1: shared __fr_secret__ mark (emit + check). Requires sec_env merge
    // first so file-level SECRET names are visible when marking fns.
    fn_env = c_secret_mark_returning_fns(src, toks, fn_env);
    check_secret_println_sinks(src, toks);
    // M168 path A: emit C typedefs for `type Name = struct {..}` / simple aliases
    // (before fns so Point/Box params and lits compile). Residual: List[Struct] not product.
    // Product build uses emit-preamble + emit-protos + emit-bodies: aliases must land in
    // protos (not only full/all). Skip bodies so multi-step build does not double-typedef.
    if mode != "bodies" && mode != "bodies_noarc" && mode != "preamble" && mode != "preamble_noarc" {
        c_emit_type_aliases(toks);
    }
    // Pre-pass: collect all fn return types to populate fn_env with __fr__ flags
    // (secret returning-fn marks already applied via c_secret_mark_returning_fns).
    // Must still brace-skip each body so nested KW_FN/idents are not re-scanned.
    let mut pre_pos: Int = 0;
    while pre_pos < n {
        let k: String = field_at(list_get(toks, pre_pos), 0);
        if k == "KW_PUB" || k == "KW_FN" {
            let mut p: Int = pre_pos;
            if k == "KW_PUB" { p = p + 1; }
            p = p + 1;
            let fn_name: String = field_at(list_get(toks, p), 3);
            p = p + 1;
            p = p + 1;
            while p < n {
                if field_at(list_get(toks, p), 0) == "RPAREN" {
                    p = p + 1;
                    break;
                }
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "ARROW" {
                p = p + 1;
                if p < n {
                    let ret_ty: String = field_at(list_get(toks, p), 3);
                    if ret_ty == "String" {
                        fn_env = c_env_put(fn_env, "__fr__" + fn_name, "T");
                    }
                }
                // Advance to body LBRACE (multi-token ret types: List[String], etc.)
                while p < n {
                    let rk: String = field_at(list_get(toks, p), 0);
                    if rk == "LBRACE" {
                        break;
                    }
                    if rk == "KW_FN" || rk == "KW_PUB" || rk == "KW_TYPE" || rk == "SEMI" {
                        break;
                    }
                    p = p + 1;
                }
            }
            // Skip body so next top-level item is found correctly (no secret walk here).
            if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
                let mut bd: Int = 1;
                p = p + 1;
                while p < n && bd > 0 {
                    let bk: String = field_at(list_get(toks, p), 0);
                    if bk == "LBRACE" {
                        bd = bd + 1;
                    } else if bk == "RBRACE" {
                        bd = bd - 1;
                        if bd == 0 { break; }
                    }
                    p = p + 1;
                }
            }
            pre_pos = p;
        } else {
            pre_pos = pre_pos + 1;
        }
    }

    // Path-A metamorphic layout: opt-in via `// METAMORPHIC: path-a` (see c_emit_meta.oo).
    // Default OFF so product builds stay layout-stable / reproducible. Residual:
    // full runtime assembly mutation (metamorphic_emit) remains free-name refuse.
    // CRITICAL: multi-pass protos+bodies must not double-emit decoys — gate via
    // c_meta_layout_emit_decoys (bodies/all/full only).
    // path-a-shuffle: reverse top-level fn emit order (two-pass; bodies only).
    let meta_layout: Bool = c_parse_metamorphic_path_a(src);
    let meta_shuffle: Bool = c_parse_metamorphic_shuffle(src);
    let mut meta_idx: Int = 0;
    let mut meta_emit: Bool = false;
    if meta_layout {
        if c_meta_layout_emit_decoys(mode) {
            meta_emit = true;
        }
    }
    if meta_emit {
        c_emit_meta_banner();
    }

    // Creative path-A-shuffle: collect top-level fn starts, reverse, emit by seek.
    // Types/imports already handled in pre-pass; only reorder function emission.
    if meta_emit {
        if meta_shuffle {
            let dr: List[String] = c_emit_meta_drive_shuffle(toks, n, fn_env, mode);
            fn_env = list_get(dr, 0);
            pos = n;
        }
    }

    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            let fname: String = c_drive_fn_name_at(toks, pos, n);
            let fr: List[String] = c_emit_fn_mode(toks, pos, n, fn_env, mode);
            pos = parse_int(list_get(fr, 0));
            fn_env = list_get(fr, 1);
            // Decoys after each top-level fn (body-mode only; layout diversity).
            // c_emit_meta_decoy / c_emit_meta_decoy_named via c_drive_after_fn.
            if meta_emit {
                c_drive_after_fn(meta_idx, fname);
                meta_idx = meta_idx + 1;
            }
        } else if k == "KW_VERIFY" {
            pos = c_emit_verify_ctor(toks, pos, n, fn_env);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else if k == "IDENT" {
            let nm: String = field_at(list_get(toks, pos), 3);
            if nm == "trait" {
                pos = skip_trait_or_impl(toks, pos);
            } else if nm == "impl" {
                let ir: List[String] = c_emit_impl_methods(toks, pos, n, fn_env, mode);
                pos = parse_int(list_get(ir, 0));
                fn_env = list_get(ir, 1);
            } else {
                println("ERR\tc_emit\tunexpected " + k);
                process_exit(1);
            }
        } else {
            println("ERR\tc_emit\tunexpected " + k);
            process_exit(1);
        }
    }
}

