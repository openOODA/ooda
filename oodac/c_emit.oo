// job: C code emission from tokens; stage: emit
// in: source/toks; out: printed C

pub fn c_emit_stream(src: String) {
    c_emit_preamble();
    
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = c_emit_fn(toks, pos, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            println("ERR\tc_emit\tunexpected " + k);
            process_exit(1);
        }
    }
}

pub fn c_emit_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    
    // LPAREN
    p = p + 1;
    
    // Skip params for now
    while p < n {
        if field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    
    // Check for return type arrow
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 2; 
        }
    }
    
    if fn_name == "main" {
        println("");
        println("int main(int argc, char **argv) {");
        p = c_emit_block(toks, p, n);
        println("  return 0;");
        println("}");
    } else {
        println("");
        println("void " + fn_name + "() {");
        p = c_emit_block(toks, p, n);
        println("}");
    }
    
    return p;
}

pub fn c_emit_block(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            p = p + 1;
            break;
        }
        p = c_emit_stmt(toks, p, n);
    }
    return p;
}

pub fn c_emit_stmt(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let k = field_at(list_get(toks, p), 0);
    
    if k == "KW_IF" {
        p = p + 1;
        let mut cond = "if (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    
    if k == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            println("else ");
            return p;
        }
        println("else {");
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    
    if k == "KW_WHILE" {
        p = p + 1;
        let mut cond = "while (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }

    if k == "KW_LET" || k == "KW_MUT" {
        let mut expr = "";
        if k == "KW_LET" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            expr = "long long "; // Default to long long, python patches will fix Strings
        }
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    
    if k == "KW_RETURN" {
        p = p + 1;
        let mut expr = "return ";
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    
    if k == "IDENT" {
        let id = field_at(list_get(toks, p), 3);
        if id == "println" {
            p = p + 1; // IDENT
            p = p + 1; // LPAREN
            let text = field_at(list_get(toks, p), 3);
            p = p + 1; // STRING
            p = p + 1; // RPAREN
            p = p + 1; // SEMI
            println("  oo_print_str(oo_str_lit(\"" + text + "\"));");
            println("  oo_println();");
            return p;
        }
        
        // General assignment or call
        let mut expr = "";
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    
    // Fallback: skip to semicolon
    while p < n {
        if field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    return p;
}

pub fn c_emit_preamble() {
    println("#include <stdio.h>");
    println("#include <stdlib.h>");
    println("#include <string.h>");
    println("#include <stdbool.h>");
    println("#include <stddef.h>");
    println("#include <unistd.h>");
    println("/* runtime decls (defined in chs_rt.c) */");
    println("typedef struct { char *data; long long len; } OoStr;");
    println("typedef struct { long long *data; long long len; long long cap; } OoIList;");
    println("typedef struct { OoStr *data; long long len; long long cap; } OoSList;");
    println("typedef struct { int ok; OoStr val; } OoResS;");
    println("typedef struct { int ok; OoStr err; } OoResV;");
    println("OoStr oo_str_lit(const char*); OoStr oo_str_concat(OoStr,OoStr);");
    println("long long oo_str_byte_len(OoStr); long long oo_chars_len(OoStr);");
    println("OoStr oo_char_at(OoStr,long long); OoStr oo_str_slice(OoStr,long long,long long);");
    println("int oo_str_contains(OoStr,OoStr);");
    println("int oo_char_is_digit(OoStr); int oo_char_is_alpha(OoStr); int oo_char_is_space(OoStr);");
    println("OoIList oo_ilist_new(void); OoIList oo_ilist_push(OoIList,long long);");
    println("long long oo_ilist_get(OoIList,long long); long long oo_ilist_len(OoIList);");
    println("OoSList oo_slist_new(void); OoSList oo_slist_push(OoSList,OoStr);");
    println("OoStr oo_slist_get(OoSList,long long); long long oo_slist_len(OoSList);");
    println("OoResS oo_read_file(OoStr); OoResV oo_write_file(OoStr,OoStr); int oo_path_exists(OoStr); long long oo_file_size(OoStr); OoResS oo_env_get(OoStr);");
    println("void oo_print_str(OoStr); void oo_print_int(long long); void oo_print_bool(int); void oo_println(void);");
    println("int oo_str_eq(OoStr,OoStr); int oo_str_contains(OoStr,OoStr);");
    println("OoStr oo_int_to_str(long long); OoStr oo_str_trim(OoStr); OoStr oo_str_to_lowercase(OoStr);");
    println("char *ooda_host_ast_dump(const char *path);");
    println("char *ooda_host_check(const char *path);");
    println("char *ooda_host_token_dump(const char *path);");
    println("int ooda_host_chs_build(const char *src, const char *out_bin);");
    println("void ooda_host_free(char *p);");
    println("OoStr oo_host_ast_dump(OoStr path);");
    println("OoStr oo_host_check(OoStr path);");
    println("OoStr oo_host_token_dump(OoStr path);");
    println("OoResS oo_chs_build(OoStr src, OoStr out_bin);");
}
