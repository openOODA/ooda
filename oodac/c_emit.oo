// job: C code emission from tokens; stage: emit
// in: source/toks; out: printed C
// (preamble lives in c_emit_preamble.oo)

pub fn c_emit_stream(src: String) {
    c_emit_preamble();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = c_emit_fn(toks, pos, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            println("ERR\tc_emit\tunexpected " + k);
            process_exit(1);
        }
    }
}

pub fn c_emit_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    p = p + 1;
    while p < n {
        if field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 2;
        }
    }
    if fn_name == "main" {
        println("");
        println("int main(int argc, char **argv) {");
        p = c_emit_block(toks, p, n);
        println("  return 0;");
        println("}");
    } else {
        println("");
        println("void " + fn_name + "() {");
        p = c_emit_block(toks, p, n);
        println("}");
    }
    return p;
}

pub fn c_emit_block(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            p = p + 1;
            break;
        }
        p = c_emit_stmt(toks, p, n);
    }
    return p;
}

pub fn c_emit_println(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos + 1;
    p = p + 1;
    let arg_k = field_at(list_get(toks, p), 0);
    let arg_t = field_at(list_get(toks, p), 3);
    p = p + 1;
    p = p + 1;
    p = p + 1;
    if arg_k == "STRING" {
        println("  oo_print_str(oo_str_lit(\"" + arg_t + "\"));");
    } else if arg_k == "INT" {
        println("  oo_print_int(" + arg_t + ");");
    } else if arg_k == "IDENT" {
        println("  oo_print_int(" + arg_t + ");");
    } else {
        println("ERR\tc_emit\tprintln unsupported arg " + arg_k);
        process_exit(1);
    }
    println("  oo_println();");
    return p;
}

pub fn c_emit_stmt(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let k = field_at(list_get(toks, p), 0);
    if k == "KW_IF" {
        p = p + 1;
        let mut cond = "if (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            println("else ");
            return p;
        }
        println("else {");
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_WHILE" {
        p = p + 1;
        let mut cond = "while (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_LET" || k == "KW_MUT" {
        let mut expr = "";
        if k == "KW_LET" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            expr = "long long ";
        }
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    if k == "KW_RETURN" {
        p = p + 1;
        let mut expr = "return ";
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    if k == "IDENT" {
        let id = field_at(list_get(toks, p), 3);
        if id == "println" {
            return c_emit_println(toks, p, n);
        }
        let mut expr = "";
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    while p < n {
        if field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    return p;
}
