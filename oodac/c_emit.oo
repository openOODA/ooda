// job: C code emission from tokens; stage: emit
// in: source/toks; out: printed C
// (preamble lives in c_emit_preamble.oo)

pub fn c_emit_stream(src: String) {
    c_emit_preamble();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut pos = 0;
    while pos < n {
        let k = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "KW_PUB" || k == "KW_FN" {
            pos = c_emit_fn(toks, pos, n);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            pos = skip_until_semi(toks, pos);
        } else {
            println("ERR\tc_emit\tunexpected " + k);
            process_exit(1);
        }
    }
}

pub fn c_emit_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    p = p + 1;
    while p < n {
        if field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
            break;
        }
        p = p + 1;
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            p = c_emit_skip_type(toks, p, n);
        }
    }
    if fn_name == "main" {
        println("");
        println("int main(int argc, char **argv) {");
        p = c_emit_block(toks, p, n);
        println("  return 0;");
        println("}");
    } else {
        println("");
        // void name() — params erased; full signatures residual for pure self-host
        println("void " + fn_name + "() {");
        p = c_emit_block(toks, p, n);
        println("}");
    }
    return p;
}

// Skip a type: Ident | Ident[T,...] | &Ident | nested brackets.
pub fn c_emit_block(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "LBRACE" {
        p = p + 1;
    }
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "RBRACE" {
            p = p + 1;
            break;
        }
        p = c_emit_stmt(toks, p, n);
    }
    return p;
}

pub fn c_emit_stmt(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let k = field_at(list_get(toks, p), 0);
    if k == "KW_IF" {
        p = p + 1;
        let mut cond = "if (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_ELSE" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
            println("else ");
            return p;
        }
        println("else {");
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_WHILE" {
        p = p + 1;
        let mut cond = "while (";
        while p < n {
            if field_at(list_get(toks, p), 0) == "LBRACE" { break; }
            cond = cond + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        cond = cond + ") {";
        println(cond);
        p = c_emit_block(toks, p, n);
        println("}");
        return p;
    }
    if k == "KW_LET" || k == "KW_MUT" {
        if k == "KW_LET" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
        }
        let name = field_at(list_get(toks, p), 3);
        p = p + 1;
        // optional : Type
        if p < n && field_at(list_get(toks, p), 0) == "COLON" {
            p = p + 1;
            p = c_emit_skip_type(toks, p, n);
        }
        if p < n && field_at(list_get(toks, p), 0) == "EQ" {
            p = p + 1;
        }
        // match expr — skip balanced braces (not fully lowered yet)
        if p < n && field_at(list_get(toks, p), 0) == "KW_MATCH" {
            p = c_emit_skip_braces(toks, p, n);
            println("  /* match skipped in emit for " + name + " */");
            if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
                p = p + 1;
            }
            return p;
        }
        let pr = c_emit_primary_c(toks, p, n);
        p = parse_int(list_get(pr, 0));
        let rhs = list_get(pr, 1);
        let mut lty = "long long";
        if chars_len(rhs) >= 9 {
            if char_at(rhs, 0) == "o" {
                if char_at(rhs, 3) == "i" {
                    lty = "OoIList";
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
                    lty = "OoStr";
                }
                if char_at(rhs, 3) == "c" && char_at(rhs, 4) == "h" && char_at(rhs, 8) == "a" {
                    lty = "OoStr";
                }
            }
        }
        println("  " + lty + " " + name + " = " + rhs + ";");
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return p;
    }
    if k == "KW_RETURN" {
        p = p + 1;
        let mut expr = "return ";
        while p < n {
            if field_at(list_get(toks, p), 0) == "SEMI" { break; }
            expr = expr + field_at(list_get(toks, p), 3) + " ";
            p = p + 1;
        }
        println(expr + ";");
        p = p + 1;
        return p;
    }
    if k == "IDENT" {
        let id = field_at(list_get(toks, p), 3);
        if id == "println" {
            return c_emit_println(toks, p, n);
        }
        // assign: name = expr;
        if p + 1 < n && field_at(list_get(toks, p + 1), 0) == "EQ" {
            let name = id;
            p = p + 2;
            let pr = c_emit_primary_c(toks, p, n);
            p = parse_int(list_get(pr, 0));
            let rhs = list_get(pr, 1);
            println("  " + name + " = " + rhs + ";");
            if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
                p = p + 1;
            }
            return p;
        }
        let pr2 = c_emit_primary_c(toks, p, n);
        p = parse_int(list_get(pr2, 0));
        println("  " + list_get(pr2, 1) + ";");
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return p;
    }
    // for / match / unknown: skip braces or to semi (always advance ≥1)
    if k == "KW_FOR" || k == "KW_MATCH" {
        return c_emit_skip_braces(toks, p, n);
    }
    let start = p;
    while p < n {
        let sk = field_at(list_get(toks, p), 0);
        if sk == "SEMI" {
            p = p + 1;
            return p;
        }
        if sk == "LBRACE" {
            return c_emit_skip_braces(toks, p, n);
        }
        p = p + 1;
    }
    if p == start {
        p = p + 1;
    }
    return p;
}
