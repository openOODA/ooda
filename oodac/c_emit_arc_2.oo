// # Emit ARC releases part 2
//
// Logline: Emit return-path ARC releases for the current scope frame.
//
// Setup: Backend-C floor. env holds __main__ and scope marks.
//
// Beats:
//   1. main may full-release args; other fns never free params.
//   2. Walk the return value and emit drops.
//   3. Leave the env consistent.

pub fn c_emit_ret_arc(env: String, mut ret_val: String) {
    // main owns args (pre-scope S) — full release OK; non-main never free params.
    if c_env_get(env, "__main__") == "1" {
        c_emit_all_scope_releases(env);
        println("  return 0;");
        return;
    }
    if ret_val == "" || ret_val == "void" {
        c_emit_local_releases(env);
        println("  return;");
        return;
    }
    let k: String = c_env_get(env, ret_val);
    if k == "T" || k == "S" || k == "I" {
        let mut rty = "OoStr";
        if k == "S" { rty = "OoSList"; }
        if k == "I" { rty = "OoIList"; }
        println("  " + rty + " __ret_val = " + ret_val + ";");
        if c_env_get(env, "__no_arc__") != "1" {
            if k == "T" { println("  oo_str_retain(__ret_val);"); }
            if k == "S" { println("  oo_slist_retain(__ret_val);"); }
            if k == "I" { println("  oo_ilist_retain(__ret_val);"); }
        }
        c_emit_local_releases(env);
        println("  return __ret_val;");
        return;
    }
    // All other non-void: stash expr into __ret_val BEFORE local releases (no UAF).
    let mut rty2 = "long long";
    if c_env_get(env, "__ret_str__") == "1" { rty2 = "OoStr"; }
    let ret_kind: String = c_env_get(env, "__ret__");
    if ret_kind == "S" { rty2 = "OoSList"; }
    if ret_kind == "I" { rty2 = "OoIList"; }
    if ret_kind == "R" { rty2 = "OoResS"; }
    if ret_kind == "V" { rty2 = "OoResV"; }
    // M170: prefer explicit C return type from fn signature (user structs)
    let rct: String = c_env_get(env, "__ret_c_ty__");
    if rct != "" && rct != "void" {
        rty2 = rct;
    }
    println("  " + rty2 + " __ret_val = " + ret_val + ";");
    c_emit_local_releases(env);
    println("  return __ret_val;");
}

pub fn c_emit_reassign_arc(name: String, rhs: String, env: String) {
    let k: String = c_env_get(env, name);
    let rk: String = c_env_get(env, rhs);
    if k == "T" {
        let mut out = "  ";
        if rk == "T" && c_env_get(env, "__no_arc__") != "1" { out = out + "oo_str_retain(" + rhs + "); "; }
        if c_env_get(env, "__no_arc__") != "1" {
            out = out + "{ OoStr __tmp = " + name + "; " + name + " = " + rhs + "; oo_str_release(__tmp); }";
        } else {
            out = out + name + " = " + rhs + ";";
        }
        println(out);
    } else if k == "S" {
        let mut out = "  ";
        if rk == "S" && c_env_get(env, "__no_arc__") != "1" { out = out + "oo_slist_retain(" + rhs + "); "; }
        if c_env_get(env, "__no_arc__") != "1" {
            out = out + "{ OoSList __tmp = " + name + "; " + name + " = " + rhs + "; oo_slist_release(__tmp); }";
        } else {
            out = out + name + " = " + rhs + ";";
        }
        println(out);
    } else if k == "I" {
        let mut out = "  ";
        if rk == "I" && c_env_get(env, "__no_arc__") != "1" { out = out + "oo_ilist_retain(" + rhs + "); "; }
        if c_env_get(env, "__no_arc__") != "1" {
            out = out + "{ OoIList __tmp = " + name + "; " + name + " = " + rhs + "; oo_ilist_release(__tmp); }";
        } else {
            out = out + name + " = " + rhs + ";";
        }
        println(out);
    } else {
        println("  " + name + " = " + rhs + ";");
    }
}

// After `let name = rhs` when rhs is a named ARC value (env T/S/I).
pub fn c_emit_let_alias_retain(name: String, rhs: String, lty: String, env: String) {
    if lty != "OoStr" && lty != "OoSList" && lty != "OoIList" {
        return;
    }
    let rk: String = c_env_get(env, rhs);
    if rk != "T" && rk != "S" && rk != "I" {
        return;
    }
    if c_env_get(env, "__no_arc__") != "1" {
        if lty == "OoStr" {
            println("  oo_str_retain(" + name + ");");
        }
        if lty == "OoSList" {
            println("  oo_slist_retain(" + name + ");");
        }
        if lty == "OoIList" {
            println("  oo_ilist_retain(" + name + ");");
        }
    }
}
