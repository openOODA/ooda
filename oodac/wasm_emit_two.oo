// # Detect two println string statements
//
// Logline: Returns two STRING texts joined by a newline when a function body is only two println(STRING) statements.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept println(STRING) then println(STRING) with optional semicolons.
//   3. Require RBRACE. A non-STRING second print misses.
//
// residual: four prints and mixed concat stay dummy end. Three-STRING lives in wasm_emit_three.oo.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn w2_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn w2_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn w2_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n {
        return empty;
    }
    if w2_kind(toks, p) != "IDENT" || w2_text(toks, p) != "println" {
        return empty;
    }
    if w2_kind(toks, p + 1) != "LPAREN" || w2_kind(toks, p + 2) != "STRING" {
        return empty;
    }
    if w2_kind(toks, p + 3) != "RPAREN" {
        return empty;
    }
    let lit: String = w2_text(toks, p + 2);
    p = p + 4;
    if p < n && w2_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_two_println(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if w2_kind(toks, i) == "KW_FN" && w2_kind(toks, i + 1) == "IDENT" {
            if w2_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && w2_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                let a: List[String] = w2_one_str_println(toks, p, n);
                if list_len(a) < 2 {
                    return "";
                }
                p = parse_int(list_get(a, 1));
                let b: List[String] = w2_one_str_println(toks, p, n);
                if list_len(b) < 2 {
                    return "";
                }
                p = parse_int(list_get(b, 1));
                if p < n && w2_kind(toks, p) == "RBRACE" {
                    return list_get(a, 0) + "\n" + list_get(b, 0);
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
