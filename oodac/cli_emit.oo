// # Run the emit-c family
//
// Logline: Turns emit-c family, emit-llvm, or emit-x86 into streamed C, LLVM IR, or x86_64 .s for one source path.
//
// Setup: load_import, c_emit, llvm_emit, and x86_emit are imported. Caps are FsCap and SysCap.
//
// Beats:
//   1. Map cmd to mode all/preamble/protos/bodies and append _noarc when PURE_NO_ARC is set.
//   2. When EMIT_NO_CONCAT is set, read the file and call c_emit_stream_mode once, or fail unreadable.
//   3. Otherwise emit preamble if needed, load imports, then stream protos and/or bodies.
//   4. emit-llvm with --backend llvm reads one file (oodac self-host IR). emit-x86 writes .s.

import "load_import.oo";
import "diag_json.oo";
import "c_emit_helpers.oo";
import "c_emit.oo";
import "check_drive.oo";
import "llvm_emit.oo";
import "x86_emit.oo";

pub fn run_emit_c_family(fs: &FsCap, sys: &SysCap, cmd: String, path: String) {
    let probe = "if [ -n \"$EMIT_NO_CONCAT\" ] || [ -n \"$OODA_EMIT_NO_CONCAT\" ]; then exit 0; else exit 1; fi";
    let no_concat = sys_exec(sys, "sh", "-c", probe);
    let arc_probe = "if [ \"$PURE_NO_ARC\" = \"1\" ] || [ \"$OODA_PURE_NO_ARC\" = \"1\" ]; then exit 0; else exit 1; fi";
    let no_arc_res = sys_exec(sys, "sh", "-c", arc_probe);
    let mut no_arc = false;
    if no_arc_res.is_ok() { no_arc = true; }
    
    let mut m = "";
    if cmd == "emit-preamble" {
        m = "preamble";
    } else if cmd == "emit-protos" {
        m = "protos";
    } else if cmd == "emit-bodies" {
        m = "bodies";
    } else {
        m = "all";
    }
    if no_arc { m = m + "_noarc"; }
    
    if no_concat.is_ok() {
        let src_r = read_file(fs, path);
        if src_r.is_ok() {
            let src = match src_r { Ok(s) => s, Err(msg) => msg };
            c_emit_stream_mode(src, m);
        } else {
            println("ERR\tload\tunreadable file: " + path);
            process_exit(1);
        }
    } else {
        // Full program emit without giant string concatenation
        if m == "all" || m == "all_noarc" || m == "preamble" || m == "preamble_noarc" {
            c_emit_stream_mode("", "preamble");
            if m == "preamble" || m == "preamble_noarc" { return; }
        }
        
        let src: String = load_source_with_imports(fs, path);
        let mut p_mode = "protos";
        let mut b_mode = "bodies";
        if no_arc { p_mode = "protos_noarc"; b_mode = "bodies_noarc"; }
        
        if m == "all" || m == "all_noarc" || m == "protos" || m == "protos_noarc" {
            c_emit_stream_mode(src, p_mode);
        }
        if m == "all" || m == "all_noarc" || m == "bodies" || m == "bodies_noarc" {
            c_emit_stream_mode(src, b_mode);
        }
    }
}

pub fn run_emit_llvm(fs: &FsCap, sys: &SysCap, path: String, backend: String) {
    let probe_concat = "if [ -n \"$EMIT_NO_CONCAT\" ] || [ -n \"$OODA_EMIT_NO_CONCAT\" ]; then exit 0; else exit 1; fi";
    let no_concat_res = sys_exec(sys, "sh", "-c", probe_concat);
    let mut no_concat = false;
    if no_concat_res.is_ok() { no_concat = true; }
    if backend == "llvm" { no_concat = true; }
    let probe_pre = "if [ -n \"$EMIT_NO_PREAMBLE\" ] || [ -n \"$OODA_EMIT_NO_PREAMBLE\" ]; then exit 0; else exit 1; fi";
    let no_pre_res = sys_exec(sys, "sh", "-c", probe_pre);
    let mut no_pre = false;
    if no_pre_res.is_ok() { no_pre = true; }
    let mut src = "";
    if no_concat {
        let src_r = read_file(fs, path);
        if src_r.is_ok() {
            src = match src_r { Ok(s) => s, Err(msg) => msg };
        } else {
            println("ERR\tload\tunreadable file: " + path);
            process_exit(1);
        }
        llvm_emit_stream(src, no_pre);
        return;
    }
    src = load_source_with_imports(fs, path);
    run_check_core(sys, src);
    llvm_emit_stream(src, no_pre);
}

pub fn run_emit_x86(fs: &FsCap, path: String) {
    let src_r = read_file(fs, path);
    if src_r.is_err() {
        println("ERR\tload\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match src_r { Ok(s) => s, Err(msg) => msg };
    x86_emit_stream(src);
}
