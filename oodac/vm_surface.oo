// # VM surface builtins
//
// Logline: Run Result Ok/Err and struct lit/field builtins on the VM stack.
//
// Setup: vm_val and vm_stack are imported. Stage is vm.
//
// Beats:
//   1. Pull args from the stack.
//   2. Build Ok, Err, or a struct value.
//   3. Push the result.

import "vm_val.oo";
import "vm_stack.oo";

fn surface_arg(args: List[String], idx: Int) -> String {
    let n = list_len(args);
    return list_get(args, n - 1 - idx);
}

pub fn is_vm_surface(name: String) -> Bool {
    if name == "__ok" || name == "__err" || name == "__result_ok_keep"
        || name == "__result_val" || name == "__struct_new" || name == "__field_get"
    {
        return true;
    }
    return false;
}

pub fn exec_vm_surface(name: String, argc: Int, args: List[String], stack: List[String]) -> List[String] {
    let mut st = stack;
    if name == "__ok" {
        let v: String = surface_arg(args, 0);
        return stack_push(st, "R:1:" + v);
    }
    if name == "__err" {
        let v: String = surface_arg(args, 0);
        return stack_push(st, "R:0:" + v);
    }
    if name == "__result_ok_keep" {
        let r: String = surface_arg(args, 0);
        let mut okb = 0;
        if chars_len(r) >= 4 && str_slice(r, 0, 4) == "R:1:" { okb = 1; }
        st = stack_push(st, r);
        return stack_push(st, val_bool(okb));
    }
    if name == "__result_val" {
        let r: String = surface_arg(args, 0);
        if chars_len(r) >= 4 && str_slice(r, 0, 2) == "R:" {
            return stack_push(st, str_slice(r, 4, chars_len(r)));
        }
        return stack_push(st, r);
    }
    if name == "__struct_new" {
        // push order: v1..vk, fields_csv, type_name → arg0=v1 … arg(k-1)=vk, arg(k)=fields, arg(k+1)=name
        let tname: String = val_to_str(surface_arg(args, argc - 1));
        let fields: String = val_to_str(surface_arg(args, argc - 2));
        let mut enc = "U:" + tname;
        let mut fi = 0;
        let flen = chars_len(fields);
        let mut start = 0;
        let mut fidx = 0;
        while fi <= flen {
            let end = (fi == flen);
            let mut is_comma = false;
            if !end { if char_at(fields, fi) == "," { is_comma = true; } }
            if end || is_comma {
                let fname = str_slice(fields, start, fi);
                let v: String = surface_arg(args, fidx);
                enc = enc + "\t" + fname + "=" + v;
                fidx = fidx + 1;
                start = fi + 1;
            }
            fi = fi + 1;
        }
        return stack_push(st, enc);
    }
    if name == "__field_get" {
        // push order: struct, field_name → arg0=struct, arg1=field
        let s: String = "" + surface_arg(args, 0);
        let fname: String = val_to_str(surface_arg(args, 1));
        let key = fname + "=";
        let kn = chars_len(key);
        let sn = chars_len(s);
        let mut i = 0;
        while i + kn <= sn {
            let mut at = false;
            if i == 0 { at = true; }
            else if char_at(s, i - 1) == "\t" { at = true; }
            if at {
                let mut ok = true;
                let mut j = 0;
                while j < kn {
                    if char_at(s, i + j) != char_at(key, j) { ok = false; j = kn; }
                    else { j = j + 1; }
                }
                if ok {
                    let mut k = i + kn;
                    let mut val = "";
                    while k < sn {
                        if char_at(s, k) == "\t" { k = sn; }
                        else { val = val + char_at(s, k); k = k + 1; }
                    }
                    return stack_push(st, val);
                }
            }
            i = i + 1;
        }
        return stack_push(st, val_void());
    }
    return stack_push(st, val_void());
}
