// # Emit one-arg SysV identity String call
//
// Logline: Matches identity String passthrough plus println(fn(STRING)) and emits lea %rdi then call.
//
// Setup: tokenize_lines, x86_tok_k, x86_tok_t, and x86_ascii_esc exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of its String param.
//   2. Require main to be only println of that fn on a STRING.
//   3. Emit identity mov %rdi,%rax; caller lea, call, SYS_write from %rax.
//
// residual: Int args, 3-arg rdx, and AArch64 stay later.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";
import "x86_emit_frame.oo";

fn x86_id_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 12 >= n {
        return empty;
    }
    if x86_tok_k(toks, i) != "KW_FN" {
        return empty;
    }
    if x86_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = x86_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let pn: String = x86_tok_t(toks, i + 3);
    if x86_tok_k(toks, i + 4) != "COLON" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 7) != "ARROW" {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 8) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 9) != "LBRACE" {
        return empty;
    }
    if x86_tok_k(toks, i + 10) != "KW_RETURN" {
        return empty;
    }
    if x86_tok_k(toks, i + 11) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 11) != pn {
        return empty;
    }
    let mut p = i + 12;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    o = list_push(o, pn);
    return o;
}

fn x86_id_main_body(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 12 >= n {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 4) != "LBRACE" {
        return empty;
    }
    if x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "println" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 7) != fname {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let arg: String = x86_tok_t(toks, i + 9);
    if x86_tok_k(toks, i + 10) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 11) != "RPAREN" {
        return empty;
    }
    let mut p = i + 12;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, arg);
    return o;
}

pub fn x86_match_id_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 {
        return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 >= n || x86_tok_k(toks, i + 1) != "IDENT" {
                return empty;
            }
            let nm: String = x86_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = x86_id_shape(toks, n, i);
                if list_len(idn) < 2 {
                    return empty;
                }
                if chars_len(fname) > 0 {
                    return empty;
                }
                fname = list_get(idn, 0);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 {
        return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" {
                if x86_tok_t(toks, i + 1) == "main" {
                    if list_len(found) >= 1 {
                        return empty;
                    }
                    found = x86_id_main_body(toks, n, i, fname);
                    if list_len(found) < 2 {
                        return empty;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn x86_emit_id_call(fname: String, arg: String) {
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lstr0:");
    println("    .ascii \"" + x86_ascii_esc(arg) + "\\n\"");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println("    .p2align 4");
    println(fname + ":");
    x86_emit_frame_enter();
    println("    mov %rdi, %rax");
    x86_emit_frame_leave();
    println("main:");
    println("_start:");
    println("    lea .Lstr0(%rip), %rdi");
    println("    call " + fname);
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    let ln = chars_len(arg) + 1;
    println("    mov $" + ln.to_string() + ", %rdx");
    println("    syscall");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
