// # Parse import lines and paths
//
// Logline: Parses an import "name" line, normalizes and joins paths, and rejects empty, absolute, home, escape, and backslash names.
//
// Setup: Tab-delimited sets still serve check_collect path walk; process_exit on empty import name; load_import.oo calls these helpers.
//
// Beats:
//   1. set_has, set_add, and list_has test membership; path_normalize strips leading ./ and duplicate slashes.
//   2. path_dirname and path_join build relative paths; parse_import_line extracts the quoted name and fails on empty.
//   3. reject_bad_import_name rejects /, ~, .., and backslash.

// String-set helpers (tab-delimited) — still used by check_collect.oo path walk.
fn path_marker(path: String) -> String {
    return "\t" + path + "\t";
}

pub fn set_has(set: String, path: String) -> Bool {
    return set.contains(path_marker(path));
}

pub fn set_add(set: String, path: String) -> String {
    if set_has(set, path) {
        return set;
    }
    return set + path + "\t";
}

pub fn list_has(lst: List[String], val: String) -> Bool {
    let n = list_len(lst);
    let mut i = 0;
    while i < n {
        if list_get(lst, i) == val { return true; }
        i = i + 1;
    }
    return false;
}

pub fn path_normalize(path: String) -> String {
    let mut clean_name = path;
    let mut cleaning = true;
    while cleaning {
        let n = chars_len(clean_name);
        if n >= 2 {
            if str_slice(clean_name, 0, 2) == "./" {
                clean_name = str_slice(clean_name, 2, n);
            } else {
                cleaning = false;
            }
        } else {
            cleaning = false;
        }
    }
    let mut out = "";
    let mut i = 0;
    let n2 = chars_len(clean_name);
    let mut last_was_slash = false;
    while i < n2 {
        let c = char_at(clean_name, i);
        if c == "/" {
            if !last_was_slash {
                out = out + c;
                last_was_slash = true;
            }
        } else {
            out = out + c;
            last_was_slash = false;
        }
        i = i + 1;
    }
    return out;
}

pub fn path_dirname(path: String) -> String {
    let n = chars_len(path);
    let mut found = false;
    let mut slash = 0;
    let mut j = 0;
    while j < n {
        if char_at(path, j) == "/" {
            found = true;
            slash = j;
        }
        j = j + 1;
    }
    if !found {
        return ".";
    }
    if slash == 0 {
        return "/";
    }
    return str_slice(path, 0, slash);
}

pub fn path_join(dir: String, name: String) -> String {
    if chars_len(name) > 0 {
        if char_at(name, 0) == "/" {
            return name;
        }
    }
    if dir == "." {
        return name;
    }
    if dir == "/" {
        return "/" + name;
    }
    return dir + "/" + name;
}

pub fn parse_import_line(line: String) -> String {
    let n = chars_len(line);
    if n < 10 {
        return "";
    }
    if str_slice(line, 0, 7) != "import " {
        return "";
    }
    if char_at(line, 7) != "\"" {
        return "";
    }
    let mut i = 8;
    let mut name = "";
    while i < n {
        let c = char_at(line, i);
        if c == "\"" {
            // `import "";` is an import line with empty name — fail-closed (R2 peer).
            // Non-import lines never reach here (prefix / quote checks above).
            if name == "" {
                println("ERR\timport\tempty name");
                process_exit(1);
            }
            return name;
        }
        name = name + c;
        i = i + 1;
    }
    return "";
}

pub fn reject_bad_import_name(imp: String) {
    if chars_len(imp) == 0 {
        println("ERR\timport\tempty name");
        process_exit(1);
    }
    if char_at(imp, 0) == "/" {
        println("ERR\timport\tabsolute path rejected: " + imp);
        process_exit(1);
    }
    if char_at(imp, 0) == "~" {
        println("ERR\timport\thome path rejected: " + imp);
        process_exit(1);
    }
    if imp.contains("..") {
        println("ERR\timport\tpath escape rejected: " + imp);
        process_exit(1);
    }
    if imp.contains("\\") {
        println("ERR\timport\tbackslash path rejected: " + imp);
        process_exit(1);
    }
    let ni: Int = chars_len(imp);
    if ni >= 2 {
        if char_at(imp, ni - 2) == "." {
            if char_at(imp, ni - 1) == "h" {
                println("ERR\timport\tC header residual: " + imp);
                process_exit(1);
            }
        }
    }
    // R2 path-A: do NOT scan for "\0". token_scan_string only escapes \n/\t,
    // so "\0" lexes as digit '0' and any prior char_at=="\0" check false-rejected
    // import names containing '0' (f0.oo, mod10.oo). OO String is C-backed —
    // embedded NUL cannot appear mid-name. See corpus/import/pass/multi_digit0.oo.
}
