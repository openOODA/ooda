// # Product type_state_check at check time
//
// Logline: Compare const have/need strings on type_state_check and typestate_assert.
//
// Setup: field_at, list_get, list_len, println, and process_exit exist.
//
// Beats:
//   1. type_state_check(name, have, need) with three STRING lits compares have to need.
//   2. typestate_assert(have, need) does the same compare.
//   3. Non-const args stay for runtime; mismatch prints ERR typestate.

fn ts_prod_str_lit(toks: List[String], i: Int) -> String {
    if i >= list_len(toks) { return ""; }
    if field_at(list_get(toks, i), 0) != "STRING" { return ""; }
    return field_at(list_get(toks, i), 3);
}

fn ts_prod_refuse(fname: String, name: String, have: String, need: String, line: String) {
    println("ERR\ttypestate\t" + fname + " needs " + need + " have " + have + " on " + name + " at line " + line);
    process_exit(1);
}

fn ts_prod_check_one(toks: List[String], i: Int, fname: String) {
    let n = list_len(toks);
    if i + 1 >= n { return; }
    if field_at(list_get(toks, i + 1), 0) != "LPAREN" { return; }
    let line: String = field_at(list_get(toks, i), 1);
    let mut p = i + 2;
    if fname == "typestate_assert" {
        let have: String = ts_prod_str_lit(toks, p);
        if have == "" { return; }
        p = p + 1;
        if p < n { if field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; } }
        let need: String = ts_prod_str_lit(toks, p);
        if need == "" { return; }
        if have != need {
            ts_prod_refuse(fname, "_", have, need, line);
        }
        return;
    }
    let name: String = ts_prod_str_lit(toks, p);
    if name == "" { return; }
    p = p + 1;
    if p < n { if field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; } }
    let have2: String = ts_prod_str_lit(toks, p);
    if have2 == "" { return; }
    p = p + 1;
    if p < n { if field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; } }
    let need2: String = ts_prod_str_lit(toks, p);
    if need2 == "" { return; }
    if have2 != need2 {
        ts_prod_refuse(fname, name, have2, need2, line);
    }
}

pub fn ts_check_product_calls(toks: List[String]) {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "IDENT" {
            let name: String = field_at(list_get(toks, i), 3);
            if name == "type_state_check" || name == "typestate_assert" {
                ts_prod_check_one(toks, i, name);
            }
        }
        i = i + 1;
    }
}
