// # Print the WebAssembly module preamble
//
// Logline: Prints the opening module, WASI imports, memory, heap global, data literals, print helpers, and memory operations.
//
// Setup: println and to_string exist; heap_start is the first free i32 after the string table that wasm_emit_stream computed.
//
// Beats:
//   1. Open the module, import WASI preview1 fd_write and proc_exit, export memory, and set mutable $heap.
//   2. Plant newline and bool literals, and emit $alloc, $str_len, $str_ptr, $println_str, and $print_str.
//   3. Emit $str_concat, $str_eq, $i64_to_string, $println_i64, and $println_bool runtime helpers.
//
// residual: WAT text helpers stay unused on emit-wasm; product path is dummy-end \0asm.

pub fn wasm_emit_preamble(heap_start: Int) {
    println("(module");
    println("  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))");
    println("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))");
    println("  (memory (export \"memory\") 1)");
    println("  (global $heap (mut i32) (i32.const " + heap_start.to_string() + "))");
    println("  (data (i32.const 64) \"\\0a\")");
    println("  (data (i32.const 72) \"\\04\\00\\00\\00\\04\\00\\00\\00\\01\\00\\00\\00true\\00\\00\\00\\00\")");
    println("  (data (i32.const 96) \"\\05\\00\\00\\00\\05\\00\\00\\00\\01\\00\\00\\00false\\00\\00\\00\")");
    println("  (func $alloc (export \"alloc\") (param $size i32) (result i32)");
    println("    (local $ptr i32)");
    println("    global.get $heap");
    println("    local.set $ptr");
    println("    global.get $heap");
    println("    local.get $size");
    println("    i32.const 3");
    println("    i32.add");
    println("    i32.const -4");
    println("    i32.and");
    println("    i32.add");
    println("    global.set $heap");
    println("    local.get $ptr");
    println("  )");
    println("  (func $str_len (export \"str_len\") (param $str_ptr i32) (result i32)");
    println("    local.get $str_ptr");
    println("    i32.load");
    println("  )");
    println("  (func $str_ptr (export \"str_ptr\") (param $str_ptr i32) (result i32)");
    println("    local.get $str_ptr");
    println("    i32.const 12");
    println("    i32.add");
    println("  )");
    println("  (func $println_str (param $str_ptr i32)");
    println("    (local $len i32)");
    println("    (local $buf i32)");
    println("    local.get $str_ptr");
    println("    i32.load");
    println("    local.set $len");
    println("    local.get $str_ptr");
    println("    i32.const 12");
    println("    i32.add");
    println("    local.set $buf");
    println("    i32.const 20");
    println("    local.get $buf");
    println("    i32.store");
    println("    i32.const 24");
    println("    local.get $len");
    println("    i32.store");
    println("    i32.const 28");
    println("    i32.const 64");
    println("    i32.store");
    println("    i32.const 32");
    println("    i32.const 1");
    println("    i32.store");
    println("    i32.const 1");
    println("    i32.const 20");
    println("    i32.const 2");
    println("    i32.const 16");
    println("    call $fd_write");
    println("    drop");
    println("  )");
    println("  (func $print_str (param $str_ptr i32)");
    println("    (local $len i32)");
    println("    (local $buf i32)");
    println("    local.get $str_ptr");
    println("    i32.load");
    println("    local.set $len");
    println("    local.get $str_ptr");
    println("    i32.const 12");
    println("    i32.add");
    println("    local.set $buf");
    println("    i32.const 20");
    println("    local.get $buf");
    println("    i32.store");
    println("    i32.const 24");
    println("    local.get $len");
    println("    i32.store");
    println("    i32.const 1");
    println("    i32.const 20");
    println("    i32.const 1");
    println("    i32.const 16");
    println("    call $fd_write");
    println("    drop");
    println("  )");
    println("  (func $str_concat (param $s1 i32) (param $s2 i32) (result i32)");
    println("    (local $len1 i32) (local $len2 i32) (local $tot i32) (local $res i32) (local $i i32)");
    println("    local.get $s1");
    println("    i32.load");
    println("    local.set $len1");
    println("    local.get $s2");
    println("    i32.load");
    println("    local.set $len2");
    println("    local.get $len1");
    println("    local.get $len2");
    println("    i32.add");
    println("    local.set $tot");
    println("    local.get $tot");
    println("    i32.const 16");
    println("    i32.add");
    println("    call $alloc");
    println("    local.set $res");
    println("    local.get $res");
    println("    local.get $tot");
    println("    i32.store");
    println("    local.get $res");
    println("    i32.const 4");
    println("    i32.add");
    println("    local.get $tot");
    println("    i32.store");
    println("    local.get $res");
    println("    i32.const 8");
    println("    i32.add");
    println("    i32.const 1");
    println("    i32.store");
    println("    i32.const 0");
    println("    local.set $i");
    println("    (block $done1 (loop $copy1");
    println("      local.get $i local.get $len1 i32.ge_u br_if $done1");
    println("      local.get $res i32.const 12 i32.add local.get $i i32.add");
    println("      local.get $s1 i32.const 12 i32.add local.get $i i32.add i32.load8_u i32.store8");
    println("      local.get $i i32.const 1 i32.add local.set $i br $copy1))");
    println("    i32.const 0");
    println("    local.set $i");
    println("    (block $done2 (loop $copy2");
    println("      local.get $i local.get $len2 i32.ge_u br_if $done2");
    println("      local.get $res i32.const 12 i32.add local.get $len1 i32.add local.get $i i32.add");
    println("      local.get $s2 i32.const 12 i32.add local.get $i i32.add i32.load8_u i32.store8");
    println("      local.get $i i32.const 1 i32.add local.set $i br $copy2))");
    println("    local.get $res i32.const 12 i32.add local.get $tot i32.add i32.const 0 i32.store8");
    println("    local.get $res");
    println("  )");
    println("  (func $str_eq (param $s1 i32) (param $s2 i32) (result i32)");
    println("    (local $len1 i32) (local $len2 i32) (local $i i32)");
    println("    local.get $s1 local.get $s2 i32.eq if i32.const 1 return end");
    println("    local.get $s1 i32.load local.set $len1");
    println("    local.get $s2 i32.load local.set $len2");
    println("    local.get $len1 local.get $len2 i32.ne if i32.const 0 return end");
    println("    i32.const 0 local.set $i");
    println("    (block $done_cmp (loop $cmp_loop");
    println("      local.get $i local.get $len1 i32.ge_u br_if $done_cmp");
    println("      local.get $s1 i32.const 12 i32.add local.get $i i32.add i32.load8_u");
    println("      local.get $s2 i32.const 12 i32.add local.get $i i32.add i32.load8_u i32.ne");
    println("      if i32.const 0 return end");
    println("      local.get $i i32.const 1 i32.add local.set $i br $cmp_loop))");
    println("    i32.const 1");
    println("  )");
    println("  (func $i64_to_string (param $val i64) (result i32)");
    println("    (local $is_neg i32) (local $v i64) (local $buf_ptr i32) (local $pos i32)");
    println("    (local $len i32) (local $res i32) (local $i i32) (local $digit i32)");
    println("    local.get $val i64.const 0 i64.eq if");
    println("      i32.const 16 call $alloc local.set $res");
    println("      local.get $res i32.const 1 i32.store");
    println("      local.get $res i32.const 4 i32.add i32.const 1 i32.store");
    println("      local.get $res i32.const 8 i32.add i32.const 1 i32.store");
    println("      local.get $res i32.const 12 i32.add i32.const 48 i32.store8");
    println("      local.get $res i32.const 13 i32.add i32.const 0 i32.store8");
    println("      local.get $res return");
    println("    end");
    println("    local.get $val local.set $v");
    println("    i32.const 0 local.set $is_neg");
    println("    local.get $v i64.const 0 i64.lt_s if");
    println("      i32.const 1 local.set $is_neg");
    println("      i64.const 0 local.get $v i64.sub local.set $v");
    println("    end");
    println("    i32.const 128 local.set $buf_ptr");
    println("    i32.const 30 local.set $pos");
    println("    (block $done_digits (loop $digit_loop");
    println("      local.get $v i64.const 0 i64.le_s br_if $done_digits");
    println("      local.get $v i64.const 10 i64.rem_u i32.wrap_i64 i32.const 48 i32.add local.set $digit");
    println("      local.get $buf_ptr local.get $pos i32.add local.get $digit i32.store8");
    println("      local.get $pos i32.const 1 i32.sub local.set $pos");
    println("      local.get $v i64.const 10 i64.div_u local.set $v br $digit_loop))");
    println("    local.get $is_neg if");
    println("      local.get $buf_ptr local.get $pos i32.add i32.const 45 i32.store8");
    println("      local.get $pos i32.const 1 i32.sub local.set $pos");
    println("    end");
    println("    i32.const 30 local.get $pos i32.sub local.set $len");
    println("    local.get $len i32.const 16 i32.add call $alloc local.set $res");
    println("    local.get $res local.get $len i32.store");
    println("    local.get $res i32.const 4 i32.add local.get $len i32.store");
    println("    local.get $res i32.const 8 i32.add i32.const 1 i32.store");
    println("    i32.const 0 local.set $i");
    println("    (block $done_copy (loop $copy_loop");
    println("      local.get $i local.get $len i32.ge_u br_if $done_copy");
    println("      local.get $res i32.const 12 i32.add local.get $i i32.add");
    println("      local.get $buf_ptr local.get $pos i32.add i32.const 1 i32.add local.get $i i32.add i32.load8_u i32.store8");
    println("      local.get $i i32.const 1 i32.add local.set $i br $copy_loop))");
    println("    local.get $res i32.const 12 i32.add local.get $len i32.add i32.const 0 i32.store8");
    println("    local.get $res");
    println("  )");
    println("  (func $println_i64 (param $val i64)");
    println("    local.get $val call $i64_to_string call $println_str");
    println("  )");
    println("  (func $println_bool (param $b i32)");
    println("    local.get $b if i32.const 72 call $println_str else i32.const 96 call $println_str end");
    println("  )");
}
