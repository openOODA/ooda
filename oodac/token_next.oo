// job: one lexer step → pack; stage: tokens
// in: src + cursor; out: SKIP/TOK/ERR pack (never empty at valid cursor)

pub fn lex_step(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n {
        return pack_tok(i0, line0, col0, "EOF", "", line0, col0);
    }
    let r0 = try_scan_ws(src, i0, line0, col0);
    if list_len(r0) > 0 {
        return r0;
    }
    let r1 = try_scan_string(src, i0, line0, col0);
    if list_len(r1) > 0 {
        return r1;
    }
    let r2 = try_scan_number(src, i0, line0, col0);
    if list_len(r2) > 0 {
        return r2;
    }
    let r3 = try_scan_ident(src, i0, line0, col0);
    if list_len(r3) > 0 {
        return r3;
    }
    let r4 = try_scan_punct(src, i0, line0, col0);
    if list_len(r4) > 0 {
        return r4;
    }
    let ch = char_at(src, i0);
    return pack_err("Unexpected character '" + ch + "' at " + line0.to_string() + ":" + col0.to_string());
}

pub fn pack_status(p: List[String]) -> String {
    return list_get(p, 0);
}

pub fn pack_i(p: List[String]) -> Int {
    return parse_int(list_get(p, 1));
}

pub fn pack_line(p: List[String]) -> Int {
    return parse_int(list_get(p, 2));
}

pub fn pack_col(p: List[String]) -> Int {
    return parse_int(list_get(p, 3));
}
