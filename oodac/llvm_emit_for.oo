// package: backend-llvm — range-for statement lowering
// stage: emit

// for IDENT in INT..INT { body }. Else fail-closed residual.
pub fn llvm_emit_for_range_stmt(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos;
    let mut cur_env: List[String] = env;
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        println("ERR\tllvm_emit\tfor residual (expected loop IDENT)");
        process_exit(1);
    }
    let v: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" || field_at(list_get(toks, p), 3) != "in" {
        println("ERR\tllvm_emit\tfor residual (need 'in'; only INT..INT range-for)");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "INT" {
        println("ERR\tllvm_emit\tfor residual (only INT..INT range lowered)");
        process_exit(1);
    }
    let lo: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "DOTDOT" {
        println("ERR\tllvm_emit\tfor residual (expected .. between bounds)");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "INT" {
        println("ERR\tllvm_emit\tfor residual (only INT..INT range lowered)");
        process_exit(1);
    }
    let hi: String = field_at(list_get(toks, p), 3);
    p = p + 1;

    println("  %" + v + ".slot = alloca i64, align 8");
    println("  store i64 " + lo + ", i64* %" + v + ".slot, align 8");
    cur_env = llvm_env_add_var(cur_env, v, "i64");

    let lbl_cond_res: List[String] = llvm_gen_label("bb_for_cond", cur_env);
    let lbl_cond: String = list_get(lbl_cond_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(lbl_cond_res, 1));
    cur_env = list_push(cur_env, list_get(lbl_cond_res, 2));
    cur_env = list_push(cur_env, list_get(lbl_cond_res, 3));
    cur_env = list_push(cur_env, list_get(lbl_cond_res, 4));
    cur_env = list_push(cur_env, list_get(lbl_cond_res, 5));

    let lbl_body_res: List[String] = llvm_gen_label("bb_for_body", cur_env);
    let lbl_body: String = list_get(lbl_body_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(lbl_body_res, 1));
    cur_env = list_push(cur_env, list_get(lbl_body_res, 2));
    cur_env = list_push(cur_env, list_get(lbl_body_res, 3));
    cur_env = list_push(cur_env, list_get(lbl_body_res, 4));
    cur_env = list_push(cur_env, list_get(lbl_body_res, 5));

    let lbl_end_res: List[String] = llvm_gen_label("bb_for_end", cur_env);
    let lbl_end: String = list_get(lbl_end_res, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(lbl_end_res, 1));
    cur_env = list_push(cur_env, list_get(lbl_end_res, 2));
    cur_env = list_push(cur_env, list_get(lbl_end_res, 3));
    cur_env = list_push(cur_env, list_get(lbl_end_res, 4));
    cur_env = list_push(cur_env, list_get(lbl_end_res, 5));

    println("  br label %" + lbl_cond);
    println(lbl_cond + ":");
    let reg_i: List[String] = llvm_gen_reg(cur_env);
    let i_reg: String = list_get(reg_i, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_i, 1));
    cur_env = list_push(cur_env, list_get(reg_i, 2));
    cur_env = list_push(cur_env, list_get(reg_i, 3));
    cur_env = list_push(cur_env, list_get(reg_i, 4));
    cur_env = list_push(cur_env, list_get(reg_i, 5));
    println("  " + i_reg + " = load i64, i64* %" + v + ".slot, align 8");
    let reg_cmp: List[String] = llvm_gen_reg(cur_env);
    let cmp_reg: String = list_get(reg_cmp, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_cmp, 1));
    cur_env = list_push(cur_env, list_get(reg_cmp, 2));
    cur_env = list_push(cur_env, list_get(reg_cmp, 3));
    cur_env = list_push(cur_env, list_get(reg_cmp, 4));
    cur_env = list_push(cur_env, list_get(reg_cmp, 5));
    println("  " + cmp_reg + " = icmp slt i64 " + i_reg + ", " + hi);
    println("  br i1 " + cmp_reg + ", label %" + lbl_body + ", label %" + lbl_end);

    println(lbl_body + ":");
    let block_res: List[String] = llvm_emit_block(toks, p, n, cur_env);
    p = parse_int(list_get(block_res, 0));
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(block_res, 1));
    cur_env = list_push(cur_env, list_get(block_res, 2));
    cur_env = list_push(cur_env, list_get(block_res, 3));
    cur_env = list_push(cur_env, list_get(block_res, 4));
    cur_env = list_push(cur_env, list_get(block_res, 5));

    let reg_i2: List[String] = llvm_gen_reg(cur_env);
    let i2: String = list_get(reg_i2, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_i2, 1));
    cur_env = list_push(cur_env, list_get(reg_i2, 2));
    cur_env = list_push(cur_env, list_get(reg_i2, 3));
    cur_env = list_push(cur_env, list_get(reg_i2, 4));
    cur_env = list_push(cur_env, list_get(reg_i2, 5));
    let reg_n: List[String] = llvm_gen_reg(cur_env);
    let inext: String = list_get(reg_n, 0);
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(reg_n, 1));
    cur_env = list_push(cur_env, list_get(reg_n, 2));
    cur_env = list_push(cur_env, list_get(reg_n, 3));
    cur_env = list_push(cur_env, list_get(reg_n, 4));
    cur_env = list_push(cur_env, list_get(reg_n, 5));
    println("  " + i2 + " = load i64, i64* %" + v + ".slot, align 8");
    println("  " + inext + " = add i64 " + i2 + ", 1");
    println("  store i64 " + inext + ", i64* %" + v + ".slot, align 8");
    println("  br label %" + lbl_cond);
    println(lbl_end + ":");

    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
