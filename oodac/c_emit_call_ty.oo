// # Call result type classification
//
// Logline: Classifies known call names into C result types to prevent massive || expression chains.

pub fn c_is_res_s_call(name: String) -> Bool {
    if name == "Ok" || name == "Err" || name == "lex_all" || name == "read_file" { return true; }
    if name == "sys_exec" || name == "process_exec" || name == "oo_sys_exec1" || name == "oo_sys_exec" || name == "oo_read_file" { return true; }
    if name == "env_get" || name == "oo_env_get" || name == "chs_build" { return true; }
    if name == "json_parse_internal" || name == "async_join_internal" || name == "python_embed_internal" { return true; }
    if name == "oo_fetch" || name == "oo_dlopen" || name == "oo_dlsym" || name == "oo_dlclose" || name == "dlsym" || name == "dlclose" { return true; }
    if name == "oo_tcp_bind" || name == "oo_tcp_connect" || name == "oo_bind_udp" || name == "oo_tls_connect" { return true; }
    if name == "tcp_bind" || name == "tcp_connect" || name == "bind_udp" || name == "tls_connect" { return true; }
    if name == "oo_tcp_write" || name == "oo_tcp_read" || name == "oo_udp_recv" || name == "oo_tcp_close" || name == "oo_sock_raw" { return true; }
    if name == "tcp_write" || name == "tcp_read" || name == "udp_recv" || name == "tcp_close" || name == "sock_raw" || name == "raw_socket" { return true; }
    if name == "oo_mutex_lock" || name == "oo_mutex_unlock" || name == "oo_thread_spawn" || name == "oo_thread_join" || name == "oo_thread_join_s" || name == "oo_gpu_launch" { return true; }
    if name == "oo_channel_new" || name == "oo_channel_send" || name == "oo_channel_recv" { return true; }
    if name == "oo_actor_spawn" || name == "oo_actor_send" || name == "oo_actor_recv" { return true; }
    if name == "mutex_lock" || name == "mutex_unlock" || name == "thread_spawn" || name == "thread_join" || name == "gpu_launch" { return true; }
    if name == "channel_new" || name == "channel_send" || name == "channel_recv" { return true; }
    if name == "actor_spawn" || name == "actor_send" || name == "actor_recv" { return true; }
    if name == "oo_sys_spawn" || name == "oo_sys_wait" || name == "oo_sys_kill" { return true; }
    if name == "sys_spawn" || name == "sys_wait" || name == "sys_kill" { return true; }
    if name == "oo_sys_epoll_create" || name == "oo_sys_inotify_init" || name == "oo_sys_prctl" { return true; }
    if name == "sys_epoll_create" || name == "sys_inotify_init" || name == "sys_prctl" { return true; }
    if name == "net_request" || name == "fs_write_then_read" || name == "parse" { return true; }
    if name == "load_model" || name == "join_task" || name == "fetch" || name == "dlopen" { return true; }
    if name == "oo_rlimit_set_mem_mb" || name == "oo_rlimit_set_nofile" || name == "oo_rlimit_set_cpu_sec" || name == "oo_landlock_restrict"
        || name == "landlock_restrict" || name == "oo_dns_resolve" || name == "oo_dns_resolve_ipv4"
        || name == "oo_arena_create" || name == "arena_create"
        || name == "oo_arena_alloc" || name == "arena_alloc"
        || name == "oo_arena_reset" || name == "arena_reset"
        || name == "oo_actor_restart" || name == "actor_restart"
        || name == "oo_otp_supervise" || name == "otp_supervise"
        || name == "oo_cap_rpc_send" || name == "cap_rpc_send"
        || name == "oo_cap_rpc_recv" || name == "cap_rpc_recv" { return true; }
    return false;
}

pub fn c_is_res_v_call(name: String) -> Bool {
    if name == "write_file" || name == "oo_write_file" || name == "fs_write_file" { return true; }
    if name == "fs_mkdir" || name == "oo_fs_mkdir" || name == "fs_remove_file" || name == "oo_fs_remove_file" { return true; }
    if name == "fs_rmdir" || name == "oo_fs_rmdir" || name == "oo_fs_hardlink" || name == "oo_fs_symlink" { return true; }
    if name == "scenario" || name == "check" || name == "sh_mkdir_p" || name == "sh_clean" || name == "sh_copy" { return true; }
    if name == "fs_copy_file" || name == "fs_mkdir_p" || name == "fs_copy_tree" { return true; }
    return false;
}

pub fn c_is_slist_call(name: String) -> Bool {
    if name == "lex_step" || name == "pack_tok" || name == "pack_err" || name == "pack_skip" { return true; }
    if name == "tokenize_lines" || name == "collect_tokens" || name == "try_scan_ws" || name == "try_scan_string" { return true; }
    if name == "try_scan_number" || name == "try_scan_ident" || name == "try_scan_punct" { return true; }
    if name == "ann_prep" || name == "call_arg_prep" || name == "c_emit_primary_c" || name == "c_emit_expr_c" { return true; }
    if name == "c_emit_expr_prec" || name == "c_emit_call_args" || name == "c_emit_method" || name == "c_pack_pos_env" { return true; }
    if name == "c_emit_block" || name == "c_emit_match_stmt" || name == "c_emit_match_let" || name == "c_emit_stmt" { return true; }
    if name == "c_emit_let_stmt" || name == "c_emit_ident_stmt" || name == "refine_capture_fn_ret_bound" || name == "refine_capture_call_bound" { return true; }
    if name == "collect_module_paths" || name == "collect_expand" || name == "load_expand" { return true; }
    return false;
}

pub fn c_is_ilist_call(name: String) -> Bool {
    if name == "list_new" || name == "list_push" || name == "gen_list_int_val" { return true; }
    if name == "bytes_new" || name == "oo_bytes_new" || name == "bytes_push" || name == "oo_bytes_push" { return true; }
    return false;
}

pub fn c_is_i64_call(name: String) -> Bool {
    if name == "chars_len" || name == "list_len" || name == "parse_int"
        || name == "landlock_is_available" || name == "oo_landlock_is_available" { return true; }
    if name == "oo_slist_len" || name == "oo_ilist_len" || name == "oo_chars_len" { return true; }
    if name == "c_count_top_args" || name == "method_call_end" || name == "operand_end" || name == "c_binop_prec" { return true; }
    if name == "skip_until_semi" || name == "skip_balanced" || name == "skip_primary" { return true; }
    if name == "c_emit_fn" || name == "c_emit_skip_type" || name == "c_emit_skip_braces" || name == "c_emit_skip_contracts" { return true; }
    if name == "c_emit_contracts_runtime" || name == "c_emit_skip_verify" || name == "check_function" { return true; }
    if name == "print_expr_bp" || name == "parse_expr_bp" || name == "file_size" { return true; }
    if name == "bc_env_lookup" || name == "bc_env_count" || name == "byte_at" || name == "oo_byte_at" { return true; }
    if name == "ord" || name == "bit_xor" || name == "oo_ord" || name == "meta_epoch" || name == "oo_meta_epoch" { return true; }
    if name == "bytes_len" || name == "oo_bytes_len" || name == "bytes_get" || name == "oo_bytes_get" { return true; }
    if name == "str_index_of" || name == "oo_str_index_of" || name == "alloc_bytes" || name == "oo_alloc_bytes" { return true; }
    if name == "malloc" || name == "realloc" || name == "free_bytes" || name == "free" { return true; }
    if name == "soa_layout" || name == "dod_layout" || name == "checkpoint" || name == "rollback" { return true; }
    if name == "oo_import_c" || name == "import_c" || name == "oo_ffi_gen" || name == "ffi_gen"
        || name == "oo_lto_xlang_link" || name == "lto_xlang_link" { return true; }
    return false;
}

pub fn c_is_f64_call(name: String) -> Bool {
    if name == "sin" || name == "cos" || name == "ln" || name == "exp" || name == "sqrt" || name == "pow" { return true; }
    if name == "oo_sin" || name == "oo_cos" || name == "oo_ln" || name == "oo_exp" || name == "oo_sqrt" || name == "oo_pow" { return true; }
    return false;
}

pub fn c_is_i32_call(name: String) -> Bool {
    if name == "char_is_alpha" || name == "char_is_digit" || name == "char_is_space" || name == "str_contains" { return true; }
    if name == "c_expr_is_str" || name == "c_expr_is_str_env" || name == "c_is_binop" { return true; }
    if name == "is_sealed_net" || name == "is_sealed_fs" || name == "is_sealed_sys" || name == "is_sealed_env" { return true; }
    if name == "set_has" || name == "path_exists" || name == "check_cache_hit" { return true; }
    if name == "c_try_emit_requires_clause" || name == "c_requires_clause_is_simple" || name == "c_has_simple_ensures" || name == "c_ensures_clause_is_simple" { return true; }
    if name == "bytes_eq" || name == "oo_bytes_eq" || name == "str_starts_with" || name == "oo_str_starts_with" || name == "str_ends_with" || name == "oo_str_ends_with"
        || name == "cap_attenuate_ok" || name == "oo_cap_attenuate_ok" { return true; }
    return false;
}

pub fn c_is_str_call(name: String) -> Bool {
