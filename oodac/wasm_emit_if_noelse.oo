// # Detect const if-true println with no else
//
// Logline: Returns the then STRING when a function body is only if true with one println(STRING) and no else.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if KW_TRUE then one println(STRING) branch and the function RBRACE.
//   3. KW_FALSE, an IDENT condition, and extra statements miss.
//
// residual: if-false without else, runtime if, and else branches stay dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wne_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wne_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wne_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n {
        return empty;
    }
    if wne_kind(toks, p) != "IDENT" || wne_text(toks, p) != "println" {
        return empty;
    }
    if wne_kind(toks, p + 1) != "LPAREN" || wne_kind(toks, p + 2) != "STRING" {
        return empty;
    }
    if wne_kind(toks, p + 3) != "RPAREN" {
        return empty;
    }
    let lit: String = wne_text(toks, p + 2);
    p = p + 4;
    if p < n && wne_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_if_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wne_kind(toks, i) == "KW_FN" && wne_kind(toks, i + 1) == "IDENT" {
            if wne_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wne_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 2 >= n || wne_kind(toks, p) != "KW_IF" {
                    return "";
                }
                p = p + 1;
                if p >= n || wne_kind(toks, p) != "KW_TRUE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wne_kind(toks, p) != "LBRACE" {
                    return "";
                }
                p = p + 1;
                let th: List[String] = wne_one_str_println(toks, p, n);
                if list_len(th) < 2 {
                    return "";
                }
                p = parse_int(list_get(th, 1));
                if p >= n || wne_kind(toks, p) != "RBRACE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wne_kind(toks, p) != "RBRACE" {
                    return "";
                }
                return list_get(th, 0);
            }
        }
        i = i + 1;
    }
    return "";
}
