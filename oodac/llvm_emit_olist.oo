// # Emit List[struct] helpers in LLVM IR
//
// Logline: Defines %OoL.Name and oo_l_Name new/len/get/push so List[Node] clang-links with chs_rt only.
//
// Setup: Called from llvm_emit_type_decl after %struct.Name. malloc and memcpy are declared in the preamble.
//
// Beats:
//   1. Typedef %OoL.Name as { %struct.Name*, i64, i64 }.
//   2. new stores zero; len loads field 1; get GEP+load or trap.
//   3. push mallocs, copies old elems, stores the new struct, and writes the aggregate.

pub fn llvm_emit_olist_helpers(name: String) {
    let L: String = "%OoL." + name;
    let S: String = "%struct." + name;
    let pfx: String = "oo_l_" + name;
    println(L + " = type { " + S + "*, i64, i64 }");
    println("define void @" + pfx + "_new(" + L + "* sret(" + L + ") %out) {");
    println("  store " + L + " zeroinitializer, " + L + "* %out, align 8");
    println("  ret void");
    println("}");
    println("define i64 @" + pfx + "_len(" + L + "* byval(" + L + ") %l) {");
    println("  %p = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 1");
    println("  %n = load i64, i64* %p, align 8");
    println("  ret i64 %n");
    println("}");
    println("define void @" + pfx + "_get(" + S + "* sret(" + S + ") %out, " + L + "* byval(" + L + ") %l, i64 %i) {");
    println("  %dp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 0");
    println("  %data = load " + S + "*, " + S + "** %dp, align 8");
    println("  %lp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 1");
    println("  %len = load i64, i64* %lp, align 8");
    println("  %ok = icmp ult i64 %i, %len");
    println("  br i1 %ok, label %okb, label %oob");
    println("oob:");
    println("  call void @llvm.trap()");
    println("  unreachable");
    println("okb:");
    println("  %ep = getelementptr inbounds " + S + ", " + S + "* %data, i64 %i");
    println("  %v = load " + S + ", " + S + "* %ep, align 8");
    println("  store " + S + " %v, " + S + "* %out, align 8");
    println("  ret void");
    println("}");
    println("define void @" + pfx + "_set(" + L + "* sret(" + L + ") %out, " + L + "* byval(" + L + ") %l, i64 %i, " + S + "* byval(" + S + ") %v) {");
    println("  %dp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 0");
    println("  %data = load " + S + "*, " + S + "** %dp, align 8");
    println("  %lp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 1");
    println("  %len = load i64, i64* %lp, align 8");
    println("  %cp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 2");
    println("  %cap = load i64, i64* %cp, align 8");
    println("  %ok = icmp ult i64 %i, %len");
    println("  br i1 %ok, label %okb, label %oob");
    println("oob:");
    println("  call void @llvm.trap()");
    println("  unreachable");
    println("okb:");
    println("  %ep = getelementptr inbounds " + S + ", " + S + "* %data, i64 %i");
    println("  %vv = load " + S + ", " + S + "* %v, align 8");
    println("  store " + S + " %vv, " + S + "* %ep, align 8");
    println("  %odp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 0");
    println("  store " + S + "* %data, " + S + "** %odp, align 8");
    println("  %olp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 1");
    println("  store i64 %len, i64* %olp, align 8");
    println("  %ocp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 2");
    println("  store i64 %cap, i64* %ocp, align 8");
    println("  ret void");
    println("}");
    println("define void @" + pfx + "_push(" + L + "* sret(" + L + ") %out, " + L + "* byval(" + L + ") %l, " + S + "* byval(" + S + ") %v) {");
    println("  %dp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 0");
    println("  %data = load " + S + "*, " + S + "** %dp, align 8");
    println("  %lp = getelementptr inbounds " + L + ", " + L + "* %l, i32 0, i32 1");
    println("  %len = load i64, i64* %lp, align 8");
    println("  %nlen = add i64 %len, 1");
    println("  %sz1 = getelementptr inbounds " + S + ", " + S + "* null, i32 1");
    println("  %esz = ptrtoint " + S + "* %sz1 to i64");
    println("  %ncap = add i64 %nlen, 7");
    println("  %bytes = mul i64 %esz, %ncap");
    println("  %raw = call i8* @malloc(i64 %bytes)");
    println("  %nd = bitcast i8* %raw to " + S + "*");
    println("  %has = icmp ne " + S + "* %data, null");
    println("  br i1 %has, label %cpy, label %nocpy");
    println("cpy:");
    println("  %oldb = mul i64 %esz, %len");
    println("  %src = bitcast " + S + "* %data to i8*");
    println("  %_ = call i8* @memcpy(i8* %raw, i8* %src, i64 %oldb)");
    println("  br label %nocpy");
    println("nocpy:");
    println("  %slot = getelementptr inbounds " + S + ", " + S + "* %nd, i64 %len");
    println("  %vv = load " + S + ", " + S + "* %v, align 8");
    println("  store " + S + " %vv, " + S + "* %slot, align 8");
    println("  %odp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 0");
    println("  store " + S + "* %nd, " + S + "** %odp, align 8");
    println("  %olp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 1");
    println("  store i64 %nlen, i64* %olp, align 8");
    println("  %ocp = getelementptr inbounds " + L + ", " + L + "* %out, i32 0, i32 2");
    println("  store i64 %ncap, i64* %ocp, align 8");
    println("  ret void");
    println("}");
}
