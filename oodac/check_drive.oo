// # Orchestrate the check command
//
// Logline: Tokenize expanded source, walk top-level items, then run secret and type checks and print OK or ERR.
//
// Setup: extra_binds is imported fn names as "\tfoo@0\t". run_check_core is the quiet emit gate (no OK line).
//
// Beats:
//   1. run_check_from_src runs the core walk and prints OK.
//   2. run_check_core_binds rejects empty or oversize source, tokenizes once, and walks KW_PUB/KW_FN/KW_TYPE/KW_IMPORT with a hang guard.
//   3. After the walk it runs secret sinks, typecheck slices, and residual free-name deny.
//
import "tc_unused_let.oo";
import "tc_unused_import.oo";

// OPEN-12: np>1 checks each file body with import lines kept as blanks so LINE:COL is per source file.

pub fn run_check_from_src(sys: &SysCap, src: String) {
    run_check_core(sys, src);
    println("OK");
}

pub fn run_check_core(sys: &SysCap, src: String) {
    run_check_core_binds(sys, src, "\t");
}

pub fn run_check_core_binds_path(sys: &SysCap, src: String, extra_binds: String, path: String) {
    run_check_core_binds_at(sys, src, extra_binds, path);
}

// extra_binds: imported fn names as "\tfoo@0\t" (P7 modular large graphs).
pub fn run_check_core_binds(sys: &SysCap, src: String, extra_binds: String) {
    run_check_core_binds_at(sys, src, extra_binds, "");
}

fn toks_with_src_path(toks: List[String], path: String) -> List[String] {
    if path == "" {
        return toks;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, "SRC_PATH\t0\t0\t" + path);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(toks, i));
        i = i + 1;
    }
    return out;
}

pub fn run_check_core_binds_at(sys: &SysCap, src: String, extra_binds: String, path: String) {
    if chars_len(src) == 0 {
        println("ERR\tcheck\tempty");
        process_exit(1);
    }
    // H6: expanded source bound (import concat); per-file is 64KiB at load
    if chars_len(src) > 1048576 {
        println("ERR\tcheck\tsource exceeds 1MiB expanded limit");
        process_exit(1);
    }
    // I17: tokenize_lines already lex_all + fail-closed (token_fmt.oo).
    // A second lex_all here doubled cost on every np>12 module. Do not re-lex.
    let toks: List[String] = toks_with_src_path(tokenize_lines(src), path);
    // Must parse as a program (at least one fn or we allow empty items only if type/import)
    let n = list_len(toks);
    if n <= 1 {
        println("ERR\tcheck\tno_fn");
        process_exit(1);
    }
    // Walk functions and sealed effects
    // F26 DE2 harden: hang guard — ensure while pos < n always advances (no pos++ missing on error paths).
    // Cyclic imports: delegated to load_import.oo / check_collect.oo (set_has(stack) cycle fail-closed); run_check_from_src does not loop.
    let mut pos = 0;
    let mut saw_fn = false;
    let mut iter = 0;
    while pos < n {
        iter = iter + 1;
        if iter > n + 100 {
            println("ERR\tcheck\thang guard exceeded at pos " + pos.to_string());
            process_exit(1);
        }
        let prev_pos = pos;
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" {
            pos = n;
        } else if k == "SRC_PATH" {
            pos = pos + 1;
        } else if k == "KW_PUB" || k == "KW_FN" {
            saw_fn = true;
            pos = check_function(toks, pos);
        } else if k == "KW_TYPE" || k == "KW_IMPORT" {
            // Skip `type Alias = Base;` / import lines to SEMI (was infinite-walk → no_fn).
            pos = skip_until_semi(toks, pos);
        } else if k == "IDENT" {
            let nm: String = field_at(list_get(toks, pos), 3);
            if nm == "trait" || nm == "impl" {
                pos = skip_trait_or_impl(toks, pos);
            } else {
                tc_parse_unexp_at(toks, pos, k);
            }
        } else {
            tc_parse_unexp_at(toks, pos, k);
        }
        if pos == prev_pos {
            println("ERR\tcheck\tno progress at " + k + " pos " + pos.to_string());
            process_exit(1);
        }
    }
    if !saw_fn {
        println("ERR\tcheck\tno_fn");
        process_exit(1);
    }
    // HIGH 6.1: SECRET refuse before typecheck so unlowered SECRETSINK
    // names (env_set/setenv/unsetenv) still dual-path refuse (not type-first).
    check_secret_println_sinks(src, toks);
    // R1 typecheck slice (real .oo): annotated let + return literals — fail-closed.
    // Stage-0 previously type-failed while oodac printed OK (honesty D↑).
    typecheck_ann_and_return_lits(toks);
    // R1 expand: undefined variables (bound = fn params + let names + fn names + builtins).
    typecheck_undefined_vars_ext(toks, extra_binds);
    typecheck_unused_lets(toks);
    typecheck_unused_imports(toks);
    // R1 expand: call arity vs declared params; assign to immutable let.
    typecheck_call_arity(toks);
    typecheck_immut_assign(toks);
    // R1: mut assign pure-lit RHS must match annotated/init type (was silent OK).
    typecheck_mut_assign_types(toks);
    // R1: unary `!` on non-Bool pure lit (e.g. `!1`) fail-closed.
    typecheck_unary_bang_lit(toks);
    // R1: unary `-` requires numeric pure lit (not String/Bool).
    typecheck_unary_minus_lit(toks);
    // R1: ordering compares require numeric matching types (not String/String).
    typecheck_cmp_numeric_lits(toks);
    // R1: `if`/`while` pure-lit condition must be Bool.
    typecheck_if_while_lit_cond(toks);
    typecheck_control_flow_branches(toks);
    // R1: `&&` / `||` pure-lit operands must be Bool (stage-0 parity).
    typecheck_logic_binop_lits(toks);
    // M166: << >> & | ^ are product Int bitops (typed via is_type_binop).
    typecheck_missing_return(toks);
    typecheck_refinements(toks);
    check_typestate(src, toks);
    typecheck_must_use_result(toks);
    typecheck_must_use_calls(toks);
    typecheck_match_exhaustive(toks);
    typecheck_call_arg_lits(toks);
    // R1: `return g()` / `x = g()` when g has declared return type (zero-arg lit-return fns).
    typecheck_return_and_assign_calls(toks);
    // R1: `let x: Ann = g()` zero-arg call init vs annotation.
    typecheck_let_ann_call_init(toks);
    // R1: g() == lit / lit == g() when declared return known.
    typecheck_call_eq_lits(toks);
    // R1: g() < lit / lit < g() — order needs matching numeric types.
    typecheck_call_order_lits(toks);
    // R1: g() + lit / g() && lit when return known.
    typecheck_call_binop_lits(toks);
    typecheck_call_logic_lits(toks);
    // R1: field/method on known receivers (x.foo, x.len() on Int) fail-closed.
    typecheck_field_method(toks);
    // R1: field access types into binops (p.x + "a") fail-closed.
    typecheck_field_binop_uses(toks);
    // R1: struct lit field init types fail-closed (`Point { x: "hi" }`).
    typecheck_struct_lit_inits(toks);
    // R1: field assign `p.x = v` types + immut root fail-closed.
    typecheck_field_assign(toks);
    // M153: residual DESIGN free-name path A — default-deny unshipped moonshot APIs.
    check_residual_free_calls(toks);
}

