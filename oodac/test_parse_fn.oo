pub fn main() {
    let toks: List[String] = tokenize_lines("pub fn foo() -> String {}");
    let n = list_len(toks);
    let fr: List[String] = c_emit_fn_mode(toks, 0, n, "", "bodies");
    println("Done! pos = " + list_get(fr, 0));
}
