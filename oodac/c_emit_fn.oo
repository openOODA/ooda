// # Emit one C function
//
// Logline: Lower a fn from toks into a C prototype or body, update the fn env, and return the next token index plus that env.
//
// Setup: c_ty_at, c_peek_type_name, c_cap_grant_suffix, c_emit_skip_type, c_emit_block, c_lower_contracts, and c_emit_skip_verify exist. fn_env carries __fr__name=T for String returns. mode is all, bodies, protos, or a *_noarc variant.
//
// Beats:
//   1. Parse the name, params, cap grants, and return type; record formal types in env.
//   2. In protos mode, print a prototype for non-main, skip the body, and return.
//   3. Emit main with ambient grants or a named fn with contracts and the block; release locals; return [pos, out_fn].

// returns [new_pos_str, updated_fn_env]; fn_env carries __fr__name=T for String rets
pub fn c_emit_fn(toks: List[String], pos: Int, n: Int, fn_env: String) -> List[String] {
    return c_emit_fn_mode(toks, pos, n, fn_env, "all");
}

pub fn c_emit_fn_mode(toks: List[String], pos: Int, n: Int, fn_env: String, mode: String) -> List[String] {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    p = p + 1;
    let mut plist = "";
    let mut first = true;
    // CAP-G3: type-driven main grants encoded as "name=suffix;name=suffix;"
    let mut mcap = "";
    // Inherit prior fn String-return map so println(make(..)) sees OoStr.
    let mut env = fn_env;
    let mut out_fn = fn_env;
    while p < n {
        let pk: String = field_at(list_get(toks, p), 0);
        if pk == "RPAREN" {
            p = p + 1;
            break;
        }
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname: String = field_at(list_get(toks, p), 3);
            p = p + 1;
            let mut pty = "long long";
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                // CAP-G3: capture Ooda type before c_ty_at collapses &Cap → long long
                let ooda_tn: String = c_peek_type_name(toks, p, n);
                let gsf: String = c_cap_grant_suffix(ooda_tn);
                if gsf != "" {
                    mcap = mcap + pname + "=" + gsf + ";";
                }
                pty = c_ty_at(toks, p, n);
                if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                    let tn: String = field_at(list_get(toks, p), 3);
                    if tn == "List" {
                        let lk: String = c_peek_list_elem(toks, p, n);
                        env = c_env_put(env, pname, lk);
                    }
                    if tn == "String" {
                        env = c_env_put(env, pname, "T");
                    }
                    if tn == "Float" || tn == "f64" {
                        env = c_env_put(env, pname, "F");
                    }
                }
                p = c_emit_skip_type(toks, p, n);
            }
            env = c_env_put(env, "__formal__" + pname, "1");
            if chars_len(pty) > 1 {
                if char_at(pty, chars_len(pty) - 1) == "*" {
                    env = c_env_put(env, "__ptr__" + pname, "1");
                }
            }
            if first {
                plist = pty + " " + pname;
                first = false;
            } else {
                plist = plist + ", " + pty + " " + pname;
            }
        } else {
            p = p + 1;
        }
    }
    let mut ret_ty = "void";
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            ret_ty = c_ty_at(toks, p, n);
            if ret_ty == "OoSList" {
                env = c_env_put(env, "__ann__", "S");
                env = c_env_put(env, "__ret__", "S");
            }
            if ret_ty == "OoIList" {
                env = c_env_put(env, "__ann__", "I");
                env = c_env_put(env, "__ret__", "I");
            }
            if ret_ty == "OoFList" {
                env = c_env_put(env, "__ann__", "F");
                env = c_env_put(env, "__ret__", "F");
            }
            if chars_len(ret_ty) > 4 {
                if char_at(ret_ty, 0) == "O" && char_at(ret_ty, 3) == "_" {
                    let lk: String = c_peek_list_elem(toks, p, n);
                    if lk != "" && lk != "I" && lk != "S" && lk != "F" {
                        env = c_env_put(env, "__ann__", lk);
                    }
                }
            }
            if ret_ty == "long long" || ret_ty == "int" {
                env = c_env_put(env, "__ret_int__", "1");
            }
            if ret_ty == "OoStr" {
                env = c_env_put(env, "__ret_str__", "1");
                // Register for later call-sites (and recursive println).
                out_fn = c_env_put(out_fn, "__fr__" + fn_name, "T");
                env = c_env_put(env, "__fr__" + fn_name, "T");
            }
            env = c_result_bind_fn_env(env, ret_ty);
            // M170: user struct / alias return types (Cell, Box, Tree, …) for ret_arc stash
            if ret_ty != "void" && ret_ty != "" {
                env = c_env_put(env, "__ret_c_ty__", ret_ty);
            }
            p = c_emit_skip_type(toks, p, n);
        }
    }
    
    if mode == "protos" || mode == "protos_noarc" {
        if fn_name != "main" {
            let mut sig = ret_ty + " " + fn_name;
            if first {
                sig = sig + "(void)";
            } else {
                sig = sig + "(" + plist + ")";
            }
            println(sig + ";");
        }
        p = c_emit_skip_contracts(toks, p, n);
        p = c_emit_skip_braces(toks, p, n);
        p = c_emit_skip_verify(toks, p, n);
        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, out_fn);
        return out;
    }

    if fn_name == "main" {
        env = c_env_put(env, "args", "S");
        env = c_env_put(env, "__main__", "1");
        env = c_env_push_scope(env);
        if mode == "all" || mode == "bodies" || mode == "all_noarc" || mode == "bodies_noarc" {
            println("");
            let fl: String = field_at(list_get(toks, pos), 1);
            if fl != "" {
                println("#line " + fl);
            }
            println("int main(int argc, char **argv) {");
            oo_emit_tmp_reset();
            println("  long long fs = oo_cap_grant_fs(); long long sys = oo_cap_grant_sys(); long long env = oo_cap_grant_env(); long long net = oo_cap_grant_net();");
            println("  long long time = oo_cap_grant_time(); long long rand = oo_cap_grant_rand(); long long alloc = oo_cap_grant_alloc();");
            println("  long long ffi = oo_cap_grant_ffi();");
            println("  long long thread = oo_cap_grant_thread(); long long gpu = oo_cap_grant_gpu();");
            // CAP-G3: granular net/fs + process ambient inject (fixed names match common param idents)
            println("  long long http = oo_cap_grant_http(); long long tcp = oo_cap_grant_tcp();");
            println("  long long udp = oo_cap_grant_udp(); long long bind = oo_cap_grant_bind();");
            println("  long long fsread = oo_cap_grant_fsread(); long long fswrite = oo_cap_grant_fswrite();");
            println("  long long process = oo_cap_grant_process();");
            // CAP-G3: type-driven grants for main(&Cap) params — arbitrary names (h: &HttpCap)
            // rebind ambient when type is more precise (fs: &FsReadCap → grant_fsread).
            c_emit_main_typed_cap_grants(mcap);
            println("  OoSList args = oo_slist_new();");
            println("  { int ai; for (ai = 1; ai < argc; ai++) {");
            println("    args = oo_slist_push(args, oo_str_lit(argv[ai]));");
            println("  } }");
            // M126: shared static __oo_mc — debit call entry (main)
            if c_env_get(env, "__mc__") != "" {
                c_emit_while_fuel_check(c_env_get(env, "__mc__"));
            }
        }
        p = c_lower_contracts(toks, p, n);
        let br: List[String] = c_emit_block(toks, p, n, env);
        p = parse_int(list_get(br, 0));
        let benv = list_get(br, 1);
        if mode == "all" || mode == "bodies" || mode == "all_noarc" || mode == "bodies_noarc" {
            if mode == "all" || mode == "bodies" {
                c_emit_all_scope_releases(benv);
            }
            println("  return 0;");
            println("}");
        }
    } else {
        if mode == "all" || mode == "bodies" || mode == "all_noarc" || mode == "bodies_noarc" {
            println("");
            let mut sig = ret_ty + " " + fn_name;
            if first {
                sig = sig + "(void)";
            } else {
                sig = sig + "(" + plist + ")";
            }
            let fl2: String = field_at(list_get(toks, pos), 1);
            if fl2 != "" {
                println("#line " + fl2);
            }
            println(sig + " {");
            oo_emit_tmp_reset();
            // M126: call-entry fuel on shared static (recursion debits; no per-fn reset)
            if c_env_get(env, "__mc__") != "" {
                c_emit_while_fuel_check(c_env_get(env, "__mc__"));
            }
            // M112: ensures clauses checked via macro
        }
        if c_has_simple_ensures(toks, p, n) {
            env = c_env_put(env, "__ens__", "1");
        }
        env = c_env_push_scope(env);
        p = c_lower_contracts(toks, p, n);
        env = c_env_push_scope(env);
        let br2: List[String] = c_emit_block(toks, p, n, env);
        p = parse_int(list_get(br2, 0));
        let benv2 = list_get(br2, 1);
        if mode == "all" || mode == "bodies" || mode == "all_noarc" || mode == "bodies_noarc" {
            // Fall-through: locals only (params are caller-owned; all_scope freed them).
            if mode == "all" || mode == "bodies" {
                c_emit_local_releases(benv2);
            }
            println("}");
        }
    }
    if mode == "all" || mode == "bodies" || mode == "all_noarc" || mode == "bodies_noarc" {
        p = c_emit_verify_ctor(toks, p, n, out_fn);
    } else {
        p = c_emit_skip_verify(toks, p, n);
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, out_fn);
    return out;
}
