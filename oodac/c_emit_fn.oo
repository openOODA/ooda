// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: emit one function; contracts: c_lower_contracts + ensures on return
// stage: emit

// returns [new_pos_str, updated_fn_env]; fn_env carries __fr__name=T for String rets
pub fn c_emit_fn(toks: List[String], pos: Int, n: Int, fn_env: String) -> List[String] {
    return c_emit_fn_mode(toks, pos, n, fn_env, "all");
}

pub fn c_emit_fn_mode(toks: List[String], pos: Int, n: Int, fn_env: String, mode: String) -> List[String] {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    p = p + 1;
    let mut plist = "";
    let mut first = true;
    // Inherit prior fn String-return map so println(make(..)) sees OoStr.
    let mut env = fn_env;
    let mut out_fn = fn_env;
    while p < n {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "RPAREN" {
            p = p + 1;
            break;
        }
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname = field_at(list_get(toks, p), 3);
            p = p + 1;
            let mut pty = "long long";
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                pty = c_ty_at(toks, p, n);
                if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                    let tn = field_at(list_get(toks, p), 3);
                    if tn == "List" {
                        let lk = c_peek_list_elem(toks, p, n);
                        if lk == "I" {
                            env = c_env_put(env, pname, "I");
                        } else {
                            env = c_env_put(env, pname, "S");
                        }
                    }
                    if tn == "String" {
                        env = c_env_put(env, pname, "T");
                    }
                }
                p = c_emit_skip_type(toks, p, n);
            }
            env = c_env_put(env, "__formal__" + pname, "1");
            if first {
                plist = pty + " " + pname;
                first = false;
            } else {
                plist = plist + ", " + pty + " " + pname;
            }
        } else {
            p = p + 1;
        }
    }
    let mut ret_ty = "void";
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            ret_ty = c_ty_at(toks, p, n);
            if ret_ty == "OoSList" {
                env = c_env_put(env, "__ann__", "S");
                env = c_env_put(env, "__ret__", "S");
            }
            if ret_ty == "OoIList" {
                env = c_env_put(env, "__ann__", "I");
                env = c_env_put(env, "__ret__", "I");
            }
            if ret_ty == "long long" || ret_ty == "int" {
                env = c_env_put(env, "__ret_int__", "1");
            }
            if ret_ty == "OoStr" {
                env = c_env_put(env, "__ret_str__", "1");
                // Register for later call-sites (and recursive println).
                out_fn = c_env_put(out_fn, "__fr__" + fn_name, "T");
                env = c_env_put(env, "__fr__" + fn_name, "T");
            }
            if ret_ty == "OoResS" {
                env = c_env_put(env, "__ret__", "R");
            }
            if ret_ty == "OoResV" {
                env = c_env_put(env, "__ret__", "V");
            }
            p = c_emit_skip_type(toks, p, n);
        }
    }
    
    if mode == "protos" {
        if fn_name != "main" {
            let mut sig = ret_ty + " " + fn_name;
            if first {
                sig = sig + "(void)";
            } else {
                sig = sig + "(" + plist + ")";
            }
            println(sig + ";");
        }
        p = c_emit_skip_contracts(toks, p, n);
        p = c_emit_skip_braces(toks, p, n);
        p = c_emit_skip_verify(toks, p, n);
        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, out_fn);
        return out;
    }

    if fn_name == "main" {
        env = c_env_put(env, "args", "S");
        env = c_env_put(env, "__main__", "1");
        env = c_env_push_scope(env);
        if mode == "all" || mode == "bodies" {
            println("");
            println("int main(int argc, char **argv) {");
            println("  long long fs = oo_cap_grant_fs(); long long sys = oo_cap_grant_sys(); long long env = oo_cap_grant_env(); long long net = oo_cap_grant_net();");
            println("  OoSList args = oo_slist_new();");
            println("  { int ai; for (ai = 1; ai < argc; ai++) {");
            println("    args = oo_slist_push(args, oo_str_lit(argv[ai]));");
            println("  } }");
        }
        p = c_lower_contracts(toks, p, n);
        let br = c_emit_block(toks, p, n, env);
        p = parse_int(list_get(br, 0));
        let benv = list_get(br, 1);
        if mode == "all" || mode == "bodies" {
            c_emit_all_scope_releases(benv);
            println("  return 0;");
            println("}");
        }
    } else {
        if mode == "all" || mode == "bodies" {
            println("");
            let mut sig = ret_ty + " " + fn_name;
            if first {
                sig = sig + "(void)";
            } else {
                sig = sig + "(" + plist + ")";
            }
            println(sig + " {");
            println("  int __oo_ens_mode = 0; long long __oo_ens_rhs = 0;");
        }
        if c_has_simple_ensures(toks, p, n) {
            env = c_env_put(env, "__ens__", "1");
        }
        env = c_env_push_scope(env);
        p = c_lower_contracts(toks, p, n);
        let br2 = c_emit_block(toks, p, n, env);
        p = parse_int(list_get(br2, 0));
        let benv2 = list_get(br2, 1);
        if mode == "all" || mode == "bodies" {
            // Fall-through: locals only (params are caller-owned; all_scope freed them).
            c_emit_local_releases(benv2);
            println("}");
        }
    }
    p = c_emit_skip_verify(toks, p, n);
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, out_fn);
    return out;
}
