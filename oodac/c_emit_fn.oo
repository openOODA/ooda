// job: emit one function from tokens
// stage: emit

pub fn c_emit_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if field_at(list_get(toks, p), 0) == "KW_PUB" {
        p = p + 1;
    }
    if field_at(list_get(toks, p), 0) == "KW_FN" {
        p = p + 1;
    }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1;
    // LPAREN
    p = p + 1;
    // Params: name : Type , ...
    let mut plist = "";
    let mut first = true;
    while p < n {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "RPAREN" {
            p = p + 1;
            break;
        }
        if pk == "COMMA" {
            p = p + 1;
        } else if pk == "IDENT" {
            let pname = field_at(list_get(toks, p), 3);
            p = p + 1;
            let mut pty = "long long";
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "AMP" {
                    pty = "int";
                    p = c_emit_skip_type(toks, p, n);
                } else if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                    let tn = field_at(list_get(toks, p), 3);
                    if tn == "String" {
                        pty = "OoStr";
                    }
                    if tn == "Int" {
                        pty = "long long";
                    }
                    if tn == "Bool" {
                        pty = "int";
                    }
                    if tn == "List" {
                        pty = "OoSList";
                    }
                    p = c_emit_skip_type(toks, p, n);
                } else {
                    p = c_emit_skip_type(toks, p, n);
                }
            }
            if first {
                plist = pty + " " + pname;
                first = false;
            } else {
                plist = plist + ", " + pty + " " + pname;
            }
        } else {
            p = p + 1;
        }
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            p = c_emit_skip_type(toks, p, n);
        }
    }
    if fn_name == "main" {
        println("");
        println("int main(int argc, char **argv) {");
        p = c_emit_block(toks, p, n);
        println("  return 0;");
        println("}");
    } else {
        println("");
        if first {
            println("void " + fn_name + "(void) {");
        } else {
            println("void " + fn_name + "(" + plist + ") {");
        }
        p = c_emit_block(toks, p, n);
        println("}");
    }
    return p;
}

// Skip a type: Ident | Ident[T,...] | &Ident | nested brackets.
