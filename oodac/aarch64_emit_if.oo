// # Skip and classify const if for AArch64 harvest
//
// Logline: Classifies if true/false/other and skips braced then/else so IDENT if cannot emit both arms.
//
// Setup: a64_tok_k exists in aarch64_emit_harv.oo. Used only by aarch64_emit.oo.
//
// Beats:
//   1. Fold true/false/INT compares and -INT OP INT only when LBRACE follows.
//   2. Skip a matched brace block.
//   3. Skip a full if/else tree for leftover conds.
//
// residual: IDENT cond, &&/|| tails, chained ==, lead0 INT, overflowing INT, and -IDENT stay leftover.

import "aarch64_emit_harv.oo";

fn a64_int_digits(s: String) -> Int {
    let n = bytes_len(s);
    if n < 1 {
        return -1;
    }
    if n > 1 && byte_at(s, 0) == 48 {
        return -1;
    }
    let mut v = 0;
    let mut i = 0;
    while i < n {
        let d = byte_at(s, i) - 48;
        if d < 0 {
            return -1;
        }
        if d > 9 {
            return -1;
        }
        if v > 922337203685477580 {
            return -1;
        }
        if v == 922337203685477580 && d > 7 {
            return -1;
        }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

fn a64_cmp_fold(op: String, av: Int, bv: Int) -> String {
    if op == "EQEQ" || op == "EQ" {
        if av == bv { return "true"; }
        return "false";
    }
    if op == "NEQ" {
        if av == bv { return "false"; }
        return "true";
    }
    if op == "LT" {
        if av < bv { return "true"; }
        return "false";
    }
    if op == "GT" {
        if av > bv { return "true"; }
        return "false";
    }
    if op == "LTE" {
        if av < bv { return "true"; }
        if av == bv { return "true"; }
        return "false";
    }
    if op == "GTE" {
        if av > bv { return "true"; }
        if av == bv { return "true"; }
        return "false";
    }
    return "other";
}

fn a64_at_lbrace(toks: List[String], n: Int, p: Int) -> Bool {
    if p >= n {
        return false;
    }
    if a64_tok_k(toks, p) == "LBRACE" {
        return true;
    }
    return false;
}

pub fn a64_if_cond(toks: List[String], n: Int, i: Int) -> String {
    if i + 1 >= n {
        return "other";
    }
    let k: String = a64_tok_k(toks, i + 1);
    if k == "KW_TRUE" {
        if a64_at_lbrace(toks, n, i + 2) {
            return "true";
        }
        return "other";
    }
    if k == "KW_FALSE" {
        if a64_at_lbrace(toks, n, i + 2) {
            return "false";
        }
        return "other";
    }
    if k == "BANG" {
        if i + 2 < n && a64_at_lbrace(toks, n, i + 3) {
            if a64_tok_k(toks, i + 2) == "KW_TRUE" {
                return "false";
            }
            if a64_tok_k(toks, i + 2) == "KW_FALSE" {
                return "true";
            }
        }
        return "other";
    }
    if k == "MINUS" {
        if i + 5 < n && a64_tok_k(toks, i + 2) == "INT" && a64_tok_k(toks, i + 4) == "INT" && a64_at_lbrace(toks, n, i + 5) {
            let av0 = a64_int_digits(a64_tok_t(toks, i + 2));
            let bv0 = a64_int_digits(a64_tok_t(toks, i + 4));
            if av0 < 0 || bv0 < 0 {
                return "other";
            }
            return a64_cmp_fold(a64_tok_k(toks, i + 3), 0 - av0, bv0);
        }
        return "other";
    }
    if i + 3 < n && k == "INT" && a64_tok_k(toks, i + 3) == "INT" && a64_at_lbrace(toks, n, i + 4) {
        let av = a64_int_digits(a64_tok_t(toks, i + 1));
        let bv = a64_int_digits(a64_tok_t(toks, i + 3));
        if av < 0 || bv < 0 {
            return "other";
        }
        return a64_cmp_fold(a64_tok_k(toks, i + 2), av, bv);
    }
    return "other";
}

pub fn a64_after_if_head(toks: List[String], n: Int, i: Int) -> Int {
    if i + 1 >= n {
        return i + 1;
    }
    let k: String = a64_tok_k(toks, i + 1);
    if k == "KW_TRUE" || k == "KW_FALSE" {
        return i + 2;
    }
    if k == "BANG" {
        if i + 2 < n && (a64_tok_k(toks, i + 2) == "KW_TRUE" || a64_tok_k(toks, i + 2) == "KW_FALSE") {
            return i + 3;
        }
    }
    if k == "MINUS" {
        if i + 4 < n && a64_tok_k(toks, i + 2) == "INT" && a64_tok_k(toks, i + 4) == "INT" {
            return i + 5;
        }
    }
    if i + 3 < n && k == "INT" {
        if a64_tok_k(toks, i + 3) == "INT" {
            let op: String = a64_tok_k(toks, i + 2);
            if op == "EQEQ" || op == "EQ" || op == "NEQ" || op == "LT" || op == "GT" || op == "LTE" || op == "GTE" {
                return i + 4;
            }
        }
    }
    return i + 1;
}

pub fn a64_ilist_last(xs: List[Int]) -> Int {
    let n = list_len(xs);
    if n < 1 {
        return -1;
    }
    return list_get(xs, n - 1);
}

pub fn a64_ilist_pop(xs: List[Int]) -> List[Int] {
    let n = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut i = 0;
    while i + 1 < n {
        out = list_push(out, list_get(xs, i));
        i = i + 1;
    }
    return out;
}

pub fn a64_skip_braced(toks: List[String], n: Int, p0: Int) -> Int {
    let mut p = p0;
    if p >= n || a64_tok_k(toks, p) != "LBRACE" {
        return p;
    }
    let mut d = 0;
    while p < n {
        let k: String = a64_tok_k(toks, p);
        if k == "LBRACE" {
            d = d + 1;
        }
        if k == "RBRACE" {
            d = d - 1;
            if d <= 0 {
                return p + 1;
            }
        }
        p = p + 1;
    }
    return p;
}

pub fn a64_skip_if(toks: List[String], n: Int, i: Int) -> Int {
    let mut p = i + 1;
    while p < n && a64_tok_k(toks, p) != "LBRACE" {
        p = p + 1;
    }
    if p < n && a64_tok_k(toks, p) == "LBRACE" {
        p = a64_skip_braced(toks, n, p);
    }
    if p < n && a64_tok_k(toks, p) == "KW_ELSE" {
        p = p + 1;
        if p < n && a64_tok_k(toks, p) == "KW_IF" {
            return a64_skip_if(toks, n, p);
        }
        if p < n && a64_tok_k(toks, p) == "LBRACE" {
            return a64_skip_braced(toks, n, p);
        }
    }
    return p;
}

pub fn a64_skip_else(toks: List[String], n: Int, i: Int) -> Int {
    let mut p = i;
    if p < n && a64_tok_k(toks, p) == "KW_ELSE" {
        p = p + 1;
    }
    if p < n && a64_tok_k(toks, p) == "KW_IF" {
        return a64_skip_if(toks, n, p);
    }
    if p < n && a64_tok_k(toks, p) == "LBRACE" {
        return a64_skip_braced(toks, n, p);
    }
    return p;
}

pub fn a64_after_false_then(toks: List[String], n: Int, i: Int) -> Int {
    let mut p = i + 1;
    while p < n && a64_tok_k(toks, p) != "LBRACE" {
        p = p + 1;
    }
    if p < n && a64_tok_k(toks, p) == "LBRACE" {
        p = a64_skip_braced(toks, n, p);
    }
    if p < n && a64_tok_k(toks, p) == "KW_ELSE" {
        p = p + 1;
        if p < n && a64_tok_k(toks, p) == "KW_IF" {
            return p;
        }
        return p;
    }
    return p;
}
