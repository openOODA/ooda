// # Peek type names and struct-lit braces
//
// Logline: Names the type after optional &mut and tells struct-lit braces from blocks.
//
// Setup: Token kinds AMP and KW_MUT sit before a type IDENT.
//
// Beats:
//   1. Skip AMP and KW_MUT.
//   2. Return the IDENT type name.
//   3. Treat {} or { ident: as a struct literal.

pub fn c_is_struct_lit_lbrace(toks: List[String], pos: Int, n: Int) -> Bool {
    if pos >= n {
        return false;
    }
    if c_tokk(toks, pos) != "LBRACE" {
        return false;
    }
    let p2: Int = pos + 1;
    if p2 >= n {
        return false;
    }
    let k2: String = c_tokk(toks, p2);
    if k2 == "RBRACE" {
        return true;
    }
    if k2 == "IDENT" {
        if p2 + 1 < n {
            if c_tokk(toks, p2 + 1) == "COLON" {
                return true;
            }
        }
    }
    return false;
}

pub fn c_peek_type_name(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    let mut p: Int = pos;
    if p < n {
        if c_tokk(toks, p) == "AMP" {
            p = p + 1;
        }
    }
    if p < n {
        if c_tokk(toks, p) == "KW_MUT" {
            p = p + 1;
        }
    }
    if p < n && c_tokk(toks, p) == "IDENT" {
        return c_tokt(toks, p);
    }
    return "";
}
