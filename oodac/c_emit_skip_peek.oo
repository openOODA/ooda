// # Peek type names and struct-lit braces
//
// Logline: Names the type after optional &mut and tells struct-lit braces from blocks.
//
// Setup: Token kinds AMP and KW_MUT sit before a type IDENT.
//
// Beats:
//   1. Skip AMP and KW_MUT.
//   2. Return the IDENT type name.
//   3. Treat {} or { ident: as a struct literal.

pub fn c_is_struct_lit_lbrace(toks: List[String], pos: Int, n: Int) -> Bool {
    if pos >= n {
        return false;
    }
    if field_at(list_get(toks, pos), 0) != "LBRACE" {
        return false;
    }
    let p2: Int = pos + 1;
    if p2 >= n {
        return false;
    }
    let k2: String = field_at(list_get(toks, p2), 0);
    if k2 == "RBRACE" {
        return true;
    }
    if k2 == "IDENT" {
        if p2 + 1 < n {
            if field_at(list_get(toks, p2 + 1), 0) == "COLON" {
                return true;
            }
        }
    }
    return false;
}

pub fn c_peek_type_name(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    let mut p: Int = pos;
    if p < n {
        if field_at(list_get(toks, p), 0) == "AMP" {
            p = p + 1;
        }
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "KW_MUT" {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        return field_at(list_get(toks, p), 3);
    }
    return "";
}
