// # Compiler module
//
// Logline: One oodac stage owns a small job and hands a typed result to the next stage.
//
// Setup: Imports are siblings in oodac/. Most stages take no caps.
//
// Beats:
//   1. Name the stage job in the title and logline.
//   2. Public function does the work and returns Ok or Err.
//   3. Private helpers stay in this file.

import "<sibling>.oo";

// Probe a sibling; fail closed on Err.
pub fn <name>(args) -> Ret {
    let probe: Result[String, String] = <sibling_call>;
    if probe.is_err() { return <err>; }
    return <ok>;
}

fn <helper>(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut i = pos0;
    while i < n { i = i + 1; }
    return i;
}
