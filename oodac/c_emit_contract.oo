// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: simple requires/ensures runtime; stage: emit

fn c_contract_op(k: String) -> String {
    if k == "GTE" { return ">="; }
    if k == "LTE" { return "<="; }
    if k == "GT" { return ">"; }
    if k == "LT" { return "<"; }
    if k == "EQEQ" { return "=="; }
    if k == "NEQ" { return "!="; }
    return "";
}

fn c_contract_op_mode(k: String) -> Int {
    if k == "GTE" { return 1; }
    if k == "LTE" { return 2; }
    if k == "GT" { return 3; }
    if k == "LT" { return 4; }
    if k == "EQEQ" { return 5; }
    if k == "NEQ" { return 6; }
    return 0;
}

fn c_try_emit_requires_clause(toks: List[String], start: Int, end: Int) -> Bool {
    if start >= end { return false; }
    let mut cond: String = "";
    let mut i = start;
    while i < end {
        let k = field_at(list_get(toks, i), 0);
        let txt = field_at(list_get(toks, i), 3);
        let op: String = c_contract_op(k);
        if op != "" {
            cond = cond + " " + op + " ";
        } else if k == "AMPAMP" || k == "LOGAND" || txt == "&&" {
            cond = cond + " && ";
        } else if k == "INT" || k == "FLOAT" {
            cond = cond + txt;
        } else if k == "IDENT" {
            if i + 2 < end && field_at(list_get(toks, i + 1), 0) == "DOT" && field_at(list_get(toks, i + 2), 3) == "len" {
                cond = cond + "oo_str_len(" + txt + ")";
                i = i + 4;
            } else {
                cond = cond + txt;
            }
        } else if k == "DOT" {
            cond = cond + ".";
        } else if k == "LPAREN" || k == "RPAREN" {
            cond = cond + txt;
        } else {
            cond = cond + " " + txt + " ";
        }
        i = i + 1;
    }
    if cond == "" { return false; }
    let msg: String = "ERR\\tcontract\\tPrecondition violation: requires " + cond;
    println("  if (!(" + cond + ")) {");
    println("    fprintf(stderr, \"" + msg + "\\n\");");
    println("    oo_process_exit(1);");
    println("  }");
    return true;
}

// M9: exact simple shape `result OP lit|ident` (3 tokens). Complex → false.
fn c_ensures_clause_is_simple(toks: List[String], start: Int, end: Int) -> Bool {
    if start + 3 != end { return false; }
    if field_at(list_get(toks, start), 0) != "IDENT" { return false; }
    if field_at(list_get(toks, start), 3) != "result" { return false; }
    if c_contract_op_mode(field_at(list_get(toks, start + 1), 0)) == 0 { return false; }
    let rk: String = field_at(list_get(toks, start + 2), 0);
    if rk == "INT" || rk == "IDENT" { return true; }
    return false;
}

fn c_try_emit_ensures_setup(toks: List[String], start: Int, end: Int) -> Bool {
    if !c_ensures_clause_is_simple(toks, start, end) { return false; }
    let mode = c_contract_op_mode(field_at(list_get(toks, start + 1), 0));
    let right: String = field_at(list_get(toks, start + 2), 3);
    let mode_s: String = mode.to_string();
    println("  __oo_ens_mode = " + mode_s + ";");
    println("  __oo_ens_rhs = " + right + ";");
    return true;
}

pub fn c_lower_ensures_return(expr: String) {
    println("  { long long __result = " + expr + ";");
    println("    if (__oo_ens_mode == 1 && !(__result >= __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 2 && !(__result <= __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 3 && !(__result > __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 4 && !(__result < __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 5 && !(__result == __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 6 && !(__result != __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __result; }");
}

pub fn c_lower_ensures_return_str(expr: String) {
    println("  { OoStr __res_str = " + expr + "; long long __result = oo_str_len(__res_str);");
    println("    if (__oo_ens_mode == 1 && !(__result >= __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 2 && !(__result <= __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 3 && !(__result > __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 4 && !(__result < __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 5 && !(__result == __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    if (__oo_ens_mode == 6 && !(__result != __oo_ens_rhs)) {");
    println("      oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __res_str; }");
}

pub fn c_lower_contracts(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let mut cont = true;
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            cont = false;
        } else if k == "KW_REQUIRES" {
            let clause_start = p + 1;
            p = p + 1;
            let mut in_clause = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated");
                    process_exit(1);
                }
                let k2 = field_at(list_get(toks, p), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY" || k2 == "KW_TYPE" || k2 == "EOF" {
                    println("ERR\tc_emit\tcontract clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let _r = c_try_emit_requires_clause(toks, clause_start, p);
        } else if k == "KW_ENSURES" {
            let e_start = p + 1;
            p = p + 1;
            let mut in_e = true;
            while in_e {
                if p >= n {
                    println("ERR\tc_emit\tensures clause truncated");
                    process_exit(1);
                }
                let k3 = field_at(list_get(toks, p), 0);
                if k3 == "KW_REQUIRES" || k3 == "KW_ENSURES" || k3 == "LBRACE" {
                    in_e = false;
                } else if k3 == "KW_FN" || k3 == "KW_PUB" || k3 == "KW_VERIFY" || k3 == "KW_TYPE" || k3 == "EOF" {
                    println("ERR\tc_emit\tensures clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            // M9: simple ensures only; complex fail-closed at emit
            if !c_ensures_clause_is_simple(toks, e_start, p) {
                println("ERR\tc_emit\tensures residual");
                process_exit(1);
            }
            let _s = c_try_emit_ensures_setup(toks, e_start, p);
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY" || k == "KW_TYPE" || k == "EOF" {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    return p;
}

// Alias for older call sites / agent merges
pub fn c_emit_contracts_runtime(toks: List[String], pos: Int, n: Int) -> Int {
    return c_lower_contracts(toks, pos, n);
}

pub fn c_has_simple_ensures(toks: List[String], pos: Int, n: Int) -> Bool {
    let mut p = pos;
    let mut found = false;
    while p < n {
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            return found;
        }
        if k == "KW_ENSURES" {
            let e_start = p + 1;
            let mut end = e_start;
            while end < n {
                let k2 = field_at(list_get(toks, end), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    break;
                }
                end = end + 1;
            }
            if !c_ensures_clause_is_simple(toks, e_start, end) {
                return false;
            }
            found = true;
            p = end;
        } else {
            p = p + 1;
        }
    }
    return found;
}
