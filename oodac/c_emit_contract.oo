// # Lower requires and ensures to C
//
// Logline: Walks fn-header contract clauses, emits runtime requires checks, and defines OO_ENS_CHECK so return sites can verify ensures.
//
// Setup: field_at, list_get, println, and process_exit exist; c_contract_expr maps tokens to a C expr and returns ERROR on residual ops; result in ensures becomes __result; c_emit_contracts_runtime aliases c_lower_contracts.
//
// Beats:
//   1. c_contract_expr concatenates idents, lits, and boolean/arithmetic ops; result becomes __result.
//   2. c_lower_contracts walks requires/ensures/caps until LBRACE; requires emit if-not-exit; ensures AND into OO_ENS_CHECK.
//   3. Return helpers wrap the result, run OO_ENS_CHECK, and exit on failure; c_has_simple_ensures is true when every ensures clause lowers.

fn c_contract_expr(toks: List[String], start: Int, end: Int) -> String {
    let mut out = "";
    let mut i = start;
    while i < end {
        let tok = list_get(toks, i);
        let k: String = field_at(tok, 0);
        let v: String = field_at(tok, 3);
        let mut adv: Int = 1;
        if k == "IDENT" {
            if v == "result" {
                out = out + "__result ";
            } else {
                let mut used_len: Bool = false;
                if i + 4 < end {
                    let k1: String = c_tokk(toks, i + 1);
                    let k2: String = c_tokk(toks, i + 2);
                    let v2: String = c_tokt(toks, i + 2);
                    let k3: String = c_tokk(toks, i + 3);
                    let k4: String = c_tokk(toks, i + 4);
                    if k1 == "DOT" {
                        if k2 == "IDENT" {
                            if v2 == "len" {
                                if k3 == "LPAREN" {
                                    if k4 == "RPAREN" {
                                        out = out + "oo_chars_len(" + v + ") ";
                                        adv = 5;
                                        used_len = true;
                                    }
                                }
                            }
                        }
                    }
                }
                if !used_len {
                    out = out + v + " ";
                }
            }
        } else if k == "INT" || k == "FLOAT" {
            out = out + v + " ";
        } else if k == "KW_TRUE" {
            out = out + "1 ";
        } else if k == "KW_FALSE" {
            out = out + "0 ";
        } else if k == "LPAREN" {
            out = out + "( ";
        } else if k == "RPAREN" {
            out = out + ") ";
        } else if k == "ANDAND" {
            out = out + "&& ";
        } else if k == "PIPEPIPE" || k == "OROR" {
            out = out + "|| ";
        } else if k == "BANG" {
            out = out + "! ";
        } else if k == "EQEQ" {
            out = out + "== ";
        } else if k == "NEQ" {
            out = out + "!= ";
        } else if k == "GT" {
            out = out + "> ";
        } else if k == "LT" {
            out = out + "< ";
        } else if k == "GTE" {
            out = out + ">= ";
        } else if k == "LTE" {
            out = out + "<= ";
        } else if k == "PLUS" {
            out = out + "+ ";
        } else if k == "MINUS" {
            out = out + "- ";
        } else if k == "STAR" {
            out = out + "* ";
        } else if k == "SLASH" {
            out = out + "/ ";
        } else if k == "PERCENT" {
            out = out + "% ";
        } else {
            return "ERROR";
        }
        i = i + adv;
    }
    return out;
}

pub fn c_lower_ensures_return(expr: String) {
    println("  { long long __result = " + expr + ";");
    println("    if (__builtin_expect(!(OO_ENS_CHECK(__result)), 0)) {");
    println("        oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __result; }");
}

pub fn c_lower_ensures_return_str(expr: String) {
    println("  { OoStr __res_str = " + expr + "; long long __result = oo_chars_len(__res_str);");
    println("    if (__builtin_expect(!(OO_ENS_CHECK(__result)), 0)) {");
    println("        oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __res_str; }");
}


pub fn c_lower_contracts(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let mut cont = true;
    let mut ens_conds = "";
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k: String = c_tokk(toks, p);
        if k == "LBRACE" {
            cont = false;
        } else if k == "IDENT" && c_tokt(toks, p) == "caps" {
            p = p + 1;
            if p < n && c_tokk(toks, p) == "EQ" { p = p + 1; }
            if p < n && c_tokk(toks, p) == "IDENT" { p = p + 1; }
        } else if k == "IDENT" && c_tokt(toks, p) == "spec" {
            p = p + 1;
            let mut in_s = true;
            while in_s {
                if p >= n {
                    println("ERR\tc_emit\tspec clause truncated");
                    process_exit(1);
                }
                let ks: String = c_tokk(toks, p);
                if ks == "KW_REQUIRES" || ks == "KW_ENSURES" || ks == "LBRACE" {
                    in_s = false;
                } else if ks == "IDENT" && c_tokt(toks, p) == "spec" {
                    in_s = false;
                } else if ks == "KW_FN" || ks == "KW_PUB" || ks == "KW_VERIFY" || ks == "KW_TYPE" || ks == "EOF" {
                    println("ERR\tc_emit\tspec clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
        } else if k == "KW_REQUIRES" {
            let clause_start = p + 1;
            p = p + 1;
            let mut in_clause = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated");
                    process_exit(1);
                }
                let k2: String = c_tokk(toks, p);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY" || k2 == "KW_TYPE" || k2 == "EOF" {
                    println("ERR\tc_emit\tcontract clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let expr: String = c_contract_expr(toks, clause_start, p);
            if expr == "ERROR" {
                println("ERR\tc_emit\trequires residual");
                process_exit(1);
            }
            println("  if (__builtin_expect(!(" + expr + "), 0)) {");
            println("    oo_print_str(oo_str_lit(\"ERR\\tcontract\\trequires\"));");
            println("    oo_println();");
            println("    oo_process_exit(1);");
            println("  }");

        } else if k == "KW_ENSURES" {
            let e_start = p + 1;
            p = p + 1;
            let mut in_e = true;
            while in_e {
                if p >= n {
                    println("ERR\tc_emit\tensures clause truncated");
                    process_exit(1);
                }
                let k3: String = c_tokk(toks, p);
                if k3 == "KW_REQUIRES" || k3 == "KW_ENSURES" || k3 == "LBRACE" {
                    in_e = false;
                } else if k3 == "KW_FN" || k3 == "KW_PUB" || k3 == "KW_VERIFY" || k3 == "KW_TYPE" || k3 == "EOF" {
                    println("ERR\tc_emit\tensures clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let expr: String = c_contract_expr(toks, e_start, p);
            if expr == "ERROR" {
                println("ERR\tc_emit\tensures residual");
                process_exit(1);
            }
            if ens_conds != "" { ens_conds = ens_conds + " && "; }
            ens_conds = ens_conds + "(" + expr + ")";
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY" || k == "KW_TYPE" || k == "EOF" {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    if ens_conds != "" {
        println("#undef OO_ENS_CHECK");
        println("#define OO_ENS_CHECK(__result) (" + ens_conds + ")");
    }
    return p;
}

pub fn c_emit_contracts_runtime(toks: List[String], pos: Int, n: Int) -> Int {
    return c_lower_contracts(toks, pos, n);
}

pub fn c_has_simple_ensures(toks: List[String], pos: Int, n: Int) -> Bool {
    let mut p = pos;
    let mut found = false;
    while p < n {
        let k: String = c_tokk(toks, p);
        if k == "LBRACE" {
            return found;
        }
        if k == "KW_ENSURES" {
            let e_start = p + 1;
            let mut end = e_start;
            while end < n {
                let k2: String = c_tokk(toks, end);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    break;
                }
                end = end + 1;
            }
            let expr: String = c_contract_expr(toks, e_start, end);
            if expr == "ERROR" { return false; }
            found = true;
            p = end;
        } else {
            p = p + 1;
        }
    }
    return found;
}
