// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: lower simple `requires` to runtime checks; skip residual ensures
// stage: emit
// honesty: simple IDENT OP INT/IDENT requires enforced; ensures still residual

// Map compare token kind → C operator text.
fn c_contract_op(k: String) -> String {
    if k == "GTE" { return ">="; }
    if k == "LTE" { return "<="; }
    if k == "GT" { return ">"; }
    if k == "LT" { return "<"; }
    if k == "EQEQ" { return "=="; }
    if k == "NEQ" { return "!="; }
    return "";
}

// Emit one requires check if form is IDENT OP (INT|IDENT); else fail-closed residual note via skip-only.
// Returns true if a check was emitted.
fn c_try_emit_requires_clause(toks: List[String], start: Int, end: Int) -> Bool {
    // start points at first token of clause (after KW_REQUIRES)
    if start >= end {
        return false;
    }
    if field_at(list_get(toks, start), 0) != "IDENT" {
        return false;
    }
    if start + 2 >= end {
        return false;
    }
    let left: String = field_at(list_get(toks, start), 3);
    let opk: String = field_at(list_get(toks, start + 1), 0);
    let op: String = c_contract_op(opk);
    if op == "" {
        return false;
    }
    let rk: String = field_at(list_get(toks, start + 2), 0);
    let mut right: String = "";
    if rk == "INT" {
        right = field_at(list_get(toks, start + 2), 3);
    } else if rk == "IDENT" {
        right = field_at(list_get(toks, start + 2), 3);
    } else {
        return false;
    }
    // Only accept exact 3-token clauses (no trailing junk)
    if start + 3 != end {
        return false;
    }
    let line1: String = "  if (!(" + left + " " + op + " " + right + ")) {";
    let msg: String = "ERR\tcontract\trequires " + left + " " + op + " " + right;
    let line2: String = "    oo_print_str(oo_str_lit(\"" + msg + "\"));";
    println(line1);
    println(line2);
    println("    oo_println();");
    println("    oo_process_exit(1);");
    println("  }");
    return true;
}

// From pos at first contract or LBRACE: emit runtime requires, advance to LBRACE.
// Complex requires / all ensures: skipped (not silent — still no enforcement).
// Fail-closed same as c_emit_skip_contracts on structural garbage.
pub fn c_emit_contracts_runtime(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let mut cont = true;
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            cont = false;
        } else if k == "KW_REQUIRES" {
            let clause_start = p + 1;
            p = p + 1;
            let mut in_clause = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated before LBRACE");
                    process_exit(1);
                }
                let k2 = field_at(list_get(toks, p), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY"
                    || k2 == "KW_TYPE" || k2 == "EOF"
                {
                    println("ERR\tc_emit\tcontract clause garbage before body");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let _emitted = c_try_emit_requires_clause(toks, clause_start, p);
            // complex requires: skip without check (residual) — not silent OK on violated simple form
        } else if k == "KW_ENSURES" {
            // residual: ensures not runtime-lowered yet
            p = p + 1;
            let mut in_e = true;
            while in_e {
                if p >= n {
                    println("ERR\tc_emit\tensures clause truncated before LBRACE");
                    process_exit(1);
                }
                let k3 = field_at(list_get(toks, p), 0);
                if k3 == "KW_REQUIRES" || k3 == "KW_ENSURES" || k3 == "LBRACE" {
                    in_e = false;
                } else if k3 == "KW_FN" || k3 == "KW_PUB" || k3 == "KW_VERIFY"
                    || k3 == "KW_TYPE" || k3 == "EOF"
                {
                    println("ERR\tc_emit\tensures clause garbage before body");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY"
            || k == "KW_TYPE" || k == "EOF"
        {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    return p;
}
