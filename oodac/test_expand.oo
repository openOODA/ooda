// # Print first load_expand result
//
// Logline: Expands oodac/main.oo and prints the first string in the result list.
//
// Setup: load_import.oo is in scope; load_expand needs an FsCap named fs.
//
// Beats:
//   1. Import load_import.oo.
//   2. Call load_expand on oodac/main.oo with two tab strings.
//   3. Print list_get of index 0.

import "load_import.oo";
pub fn main() {
    let r: List[String] = load_expand(fs, "oodac/main.oo", "\t", "\t");
    println(list_get(r, 0));
}
