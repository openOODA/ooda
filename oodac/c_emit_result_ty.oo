// # Map Result[T] to a C Result typedef
//
// Logline: Picks OoResI, OoResB, OoResF, list Results, or OoRes_Name from Result type tokens.
//
// Setup: c_peek_list_elem exists. Void and String stay OoResV and OoResS.
//
// Beats:
//   1. Read the Ok payload IDENT after Result[.
//   2. Map Void, String, Int, Bool, Float, and List to fixed C types.
//   3. Map a user name to OoRes_Name. Kind letters are RI not I.

pub fn c_result_c_ty(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "OoResS";
    }
    let mut p: Int = pos + 1;
    if p >= n {
        return "OoResS";
    }
    if field_at(list_get(toks, p), 0) != "LBRACKET" {
        return "OoResS";
    }
    p = p + 1;
    if p >= n {
        return "OoResS";
    }
    if field_at(list_get(toks, p), 0) != "IDENT" {
        return "OoResS";
    }
    let e: String = field_at(list_get(toks, p), 3);
    if e == "Void" {
        return "OoResV";
    }
    if e == "String" {
        return "OoResS";
    }
    if e == "Int" {
        if c_result_e_is_int(toks, pos, n) {
            return "OoResII";
        }
        let mut ep: Int = p + 1;
        if ep < n && field_at(list_get(toks, ep), 0) == "COMMA" {
            ep = ep + 1;
            if ep < n && field_at(list_get(toks, ep), 0) == "IDENT" {
                let en: String = field_at(list_get(toks, ep), 3);
                if en != "String" {
                    println("ERR\tc_emit\tResult E residual");
                    process_exit(1);
                    return "";
                }
            }
        }
        return "OoResI";
    }
    if e == "Bool" {
        return "OoResB";
    }
    if e == "Float" {
        return "OoResF";
    }
    if e == "f64" {
        return "OoResF";
    }
    if e == "List" {
        let lk: String = c_peek_list_elem(toks, p, n);
        if lk == "I" {
            return "OoResLI";
        }
        if lk == "S" {
            return "OoResLS";
        }
        if lk == "F" {
            return "OoResLF";
        }
        if lk == "LF" {
            return "OoResLF";
        }
        println("ERR\tc_emit\tResult[List[...]] residual");
        process_exit(1);
        return "";
    }
    if e == "Option" || e == "Result" {
        println("ERR\tc_emit\tResult[Option|Result] residual");
        process_exit(1);
        return "";
    }
    return "OoRes_" + e;
}

pub fn c_option_c_ty(toks: List[String], pos: Int, n: Int) -> String {
    return c_result_c_ty(toks, pos, n);
}

pub fn c_ref_c_ty(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    if p >= n {
        return "long long";
    }
    if field_at(list_get(toks, p), 0) != "AMP" {
        return "long long";
    }
    p = p + 1;
    if p < n {
        if field_at(list_get(toks, p), 0) == "KW_MUT" {
            p = p + 1;
        }
    }
    if p >= n {
        return "long long";
    }
    if field_at(list_get(toks, p), 0) != "IDENT" {
        return "long long";
    }
    let tn: String = field_at(list_get(toks, p), 3);
    if c_cap_grant_suffix(tn) != "" {
        return "long long";
    }
    if tn == "HitlCap" {
        return "long long";
    }
    if tn == "AuditCap" {
        return "long long";
    }
    return tn + "*";
}

pub fn c_emit_unary_c(toks: List[String], pos: Int, n: Int, env: String, k: String) -> List[String] {
    let mut p: Int = pos + 1;
    if k == "AMP" {
        if p < n {
            if field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
        }
    }
    let mut pre: String = "!";
    if k == "AMP" {
        pre = "&";
    }
    if k == "STAR" {
        pre = "*";
    }
    let mut inner: String = "";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        let prg: List[String] = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(prg, 0));
        inner = list_get(prg, 1);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    } else {
        let pru: List[String] = c_emit_primary_c(toks, p, n, env);
        p = parse_int(list_get(pru, 0));
        inner = list_get(pru, 1);
    }
    let wrapped: String = "(" + pre + inner + ")";
    if p < n {
        if field_at(list_get(toks, p), 0) == "DOT" {
            return c_emit_method(toks, p, n, env, wrapped);
        }
    }
    return c_emit_pack2(p.to_string(), wrapped);
}

pub fn c_frty_note(fn_env: String, fn_name: String, toks: List[String], p: Int, n: Int) -> String {
    let rty: String = c_ty_at(toks, p, n);
    let mut e: String = fn_env;
    if rty != "" {
        if rty != "void" {
            e = c_env_put(e, "__frty__" + fn_name, rty);
        }
    }
    if p < n {
        if field_at(list_get(toks, p), 0) == "IDENT" {
            if field_at(list_get(toks, p), 3) == "String" {
                e = c_env_put(e, "__fr__" + fn_name, "T");
            }
        }
    }
    return e;
}

pub fn c_result_ret_kind(cty: String) -> String {
    if cty == "OoResV" {
        return "V";
    }
    if cty == "OoResS" {
        return "R";
    }
    if cty == "OoResI" {
        return "RI";
    }
    if cty == "OoResII" {
        return "RII";
    }
    if cty == "OoResB" {
        return "RB";
    }
    if cty == "OoResF" {
        return "RF";
    }
    if cty == "OoResLI" {
        return "RLI";
    }
    if cty == "OoResLS" {
        return "RLS";
    }
    if cty == "OoResLF" {
        return "RLF";
    }
    if chars_len(cty) > 6 {
        if char_at(cty, 0) == "O" {
            if char_at(cty, 4) == "s" {
                if char_at(cty, 5) == "_" {
                    return "RN";
                }
            }
        }
    }
    return "";
}

pub fn c_result_bind_fn_env(env: String, ret_ty: String) -> String {
    let rk: String = c_result_ret_kind(ret_ty);
    if rk == "" {
        return env;
    }
    return c_env_put(env, "__ret__", rk);
}
