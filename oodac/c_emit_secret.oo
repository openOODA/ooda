// # Refuse secret sinks
//
// Logline: Tag SECRET values and refuse println, write_file, fetch, sys_exec, process_exec, env_get.
//
// Setup: Secret variables and sink definitions are tagged in the emission environment.
//
// Beats:
//   1. Track secret tags in env.
//   2. Refuse listed sinks.
//   3. Fail closed.
//
// residual: other OS sinks, #[Secret] attr, full IFC

// Line-start // SECRET: <ident> → env fragment "__sec__name=1;"
pub fn c_parse_secret_env(src: String) -> String {
    let needle = "// " + "SECRET:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut env = "";
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 || char_at(src, i - 1) == "\n" {
            at_line = true;
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let start = k;
                while k < sn {
                    let c = char_at(src, k);
                    let is_al = c == "_" || c == "a" || c == "b" || c == "c" || c == "d"
                        || c == "e" || c == "f" || c == "g" || c == "h" || c == "i"
                        || c == "j" || c == "k" || c == "l" || c == "m" || c == "n"
                        || c == "o" || c == "p" || c == "q" || c == "r" || c == "s"
                        || c == "t" || c == "u" || c == "v" || c == "w" || c == "x"
                        || c == "y" || c == "z" || c == "A" || c == "B" || c == "C"
                        || c == "D" || c == "E" || c == "F" || c == "G" || c == "H"
                        || c == "I" || c == "J" || c == "K" || c == "L" || c == "M"
                        || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R"
                        || c == "S" || c == "T" || c == "U" || c == "V" || c == "W"
                        || c == "X" || c == "Y" || c == "Z" || c == "0" || c == "1"
                        || c == "2" || c == "3" || c == "4" || c == "5" || c == "6"
                        || c == "7" || c == "8" || c == "9";
                    if is_al {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let name = str_slice(src, start, k);
                if name == "" {
                    println("ERR\tsecret\tinvalid name (need ident after SECRET directive)");
                    process_exit(1);
                }
                env = c_env_put(env, "__sec__" + name, "1");
                // Directive root: sticky-clear must not wipe // SECRET: names.
                env = c_env_put(env, "__secref__" + name, "1");
                i = k;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return env;
}

pub fn c_secret_refuse_println_ident(env: String, name: String) {
    if c_env_get(env, "__sec__" + name) == "1" {
        println("ERR\tsecret\tprintln sink refuses SECRET " + name);
        process_exit(1);
    }
    let n = chars_len(name);
    let mut last_dot: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if char_at(name, i) == "." {
            last_dot = i;
        }
        i = i + 1;
    }
    if last_dot > 0 {
        let parent = str_slice(name, 0, last_dot);
        let leaf = str_slice(name, last_dot + 1, n);
        if c_env_get(env, "__sec__" + parent) == "1" && c_env_get(env, "__sec__" + leaf) == "1" {
            println("ERR\tsecret\tprintln sink refuses SECRET " + name);
            process_exit(1);
        }
    }
}

// sink = write_file | fetch | sys_exec
pub fn c_secret_refuse_sink_ident(env: String, sink: String, name: String) {
    if c_env_get(env, "__sec__" + name) == "1" {
        println("ERR\tsecret\t" + sink + " sink refuses SECRET " + name);
        process_exit(1);
    }
    let n = chars_len(name);
    let mut last_dot: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if char_at(name, i) == "." {
            last_dot = i;
        }
        i = i + 1;
    }
    if last_dot > 0 {
        let parent = str_slice(name, 0, last_dot);
        let leaf = str_slice(name, last_dot + 1, n);
        if c_env_get(env, "__sec__" + parent) == "1" && c_env_get(env, "__sec__" + leaf) == "1" {
            println("ERR\tsecret\t" + sink + " sink refuses SECRET " + name);
            process_exit(1);
        }
    }
}

// eq_only: refuse only when argi == want; else refuse any argi >= want (sys_exec argv).
// Require LPAREN — bare `let w = write_file` must not scan the rest of the file.
pub fn c_secret_scan_call(env: String, toks: List[String], start: Int, n: Int, want: Int, eq_only: Bool, sink: String) {
    let mut p = start;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        return;
    }
    p = p + 1;
    let mut argi = 0;
    let mut in_args = true;
    let mut depth = 1;
    while in_args && p < n {
        let kk: String = field_at(list_get(toks, p), 0);
        if kk == "LPAREN" {
            depth = depth + 1;
            p = p + 1;
        } else if kk == "RPAREN" {
            depth = depth - 1;
            if depth <= 0 {
                in_args = false;
            }
            p = p + 1;
        } else if kk == "COMMA" {
            if depth == 1 {
                argi = argi + 1;
            }
            p = p + 1;
        } else if kk == "IDENT" {
            let mut full_path: String = field_at(list_get(toks, p), 3);
            let mut q: Int = p + 1;
            while q + 1 < n && field_at(list_get(toks, q), 0) == "DOT"
                && field_at(list_get(toks, q + 1), 0) == "IDENT" {
                full_path = full_path + "." + field_at(list_get(toks, q + 1), 3);
                q = q + 2;
            }
            if eq_only {
                if argi == want {
                    c_secret_refuse_sink_resolved(env, sink, full_path);
                }
            } else {
                if argi >= want {
                    c_secret_refuse_sink_resolved(env, sink, full_path);
                }
            }
            p = q;
        } else {
            p = p + 1;
        }
    }
}

// check_secret_println_sinks lives in c_emit_secret_check.oo
// c_secret_prop_from_rhs + c_secret_mark_returning_fns live in c_emit_secret_prop.oo
