// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: path A Secret — parse file-level SECRET name; println bare-IDENT refuse
// stage: emit
// residual: not interproc / assign-prop / NetCap / attr Secret / non-println sinks

// Line-start // SECRET: <ident> → env fragment "__sec__name=1;" (may be multi).
// Split needle so contiguous directive text never appears in this module source.
// Empty name after marker → fail-closed (not silent ignore).
pub fn c_parse_secret_env(src: String) -> String {
    let needle = "// " + "SECRET:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut env = "";
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let mut name = "";
                while k < sn {
                    let c = char_at(src, k);
                    let is_al = c == "_" || c == "a" || c == "b" || c == "c" || c == "d"
                        || c == "e" || c == "f" || c == "g" || c == "h" || c == "i"
                        || c == "j" || c == "k" || c == "l" || c == "m" || c == "n"
                        || c == "o" || c == "p" || c == "q" || c == "r" || c == "s"
                        || c == "t" || c == "u" || c == "v" || c == "w" || c == "x"
                        || c == "y" || c == "z" || c == "A" || c == "B" || c == "C"
                        || c == "D" || c == "E" || c == "F" || c == "G" || c == "H"
                        || c == "I" || c == "J" || c == "K" || c == "L" || c == "M"
                        || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R"
                        || c == "S" || c == "T" || c == "U" || c == "V" || c == "W"
                        || c == "X" || c == "Y" || c == "Z" || c == "0" || c == "1"
                        || c == "2" || c == "3" || c == "4" || c == "5" || c == "6"
                        || c == "7" || c == "8" || c == "9";
                    if is_al {
                        name = name + c;
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                if name == "" {
                    println("ERR\tsecret\tinvalid name (need ident after SECRET directive)");
                    process_exit(1);
                }
                env = c_env_put(env, "__sec__" + name, "1");
                i = k;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return env;
}

// Path A: bare IDENT at println is refused if tagged secret in env.
// Call only when token is IDENT and not a call (caller checks next kind).
pub fn c_secret_refuse_println_ident(env: String, name: String) {
    if c_env_get(env, "__sec__" + name) == "1" {
        println("ERR\tsecret\tprintln sink refuses SECRET " + name);
        process_exit(1);
    }
}

// M55/M60 check dual-path: path A names + path B bare-IDENT assign-prop sim.
// Residual: concat/call/field taint still emit-only (no full IFC at check).
pub fn check_secret_println_sinks(src: String, toks: List[String]) {
    let mut env: String = c_parse_secret_env(src);
    if env == "" {
        return;
    }
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        // let [mut] dest … = rhs
        if k == "KW_LET" {
            let mut p = i + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let dest: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                let mut hunting = true;
                while hunting && p < n {
                    let kk = field_at(list_get(toks, p), 0);
                    if kk == "EQ" {
                        env = c_secret_prop_from_rhs(toks, p + 1, n, env, dest);
                        hunting = false;
                    } else if kk == "SEMI" || kk == "LBRACE" || kk == "KW_LET" {
                        hunting = false;
                    } else {
                        p = p + 1;
                    }
                }
            }
        }
        // dest = rhs (not println)
        if k == "IDENT" {
            let id: String = field_at(list_get(toks, i), 3);
            if id != "println" && i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "EQ" {
                    env = c_secret_prop_from_rhs(toks, i + 2, n, env, id);
                }
            }
            if id == "println" {
                let mut p = i + 1;
                if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                    p = p + 1;
                }
                let mut in_args = true;
                while in_args && p < n {
                    if field_at(list_get(toks, p), 0) == "RPAREN" {
                        in_args = false;
                    } else if field_at(list_get(toks, p), 0) == "IDENT" {
                        let nm: String = field_at(list_get(toks, p), 3);
                        if c_env_get(env, "__sec__" + nm) == "1" {
                            println("ERR\tsecret\tprintln sink refuses SECRET " + nm);
                            process_exit(1);
                        }
                        p = p + 1;
                    } else {
                        p = p + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
}

// Path B: Interprocedural + concat (any IDENT in RHS propagates)
pub fn c_secret_prop_from_rhs(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    let mut i = pos;
    let mut is_secret = false;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        if k == "SEMI" || k == "LBRACE" || k == "RBRACE" || k == "KW_LET" {
            break;
        }
        if k == "IDENT" {
            let sn: String = field_at(list_get(toks, i), 3);
            if c_env_get(env, "__sec__" + sn) == "1" {
                is_secret = true;
            }
        }
        i = i + 1;
    }
    if is_secret {
        return c_env_put(env, "__sec__" + dest, "1");
    }
    return env;
}
