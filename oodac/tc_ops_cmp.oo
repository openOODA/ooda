// job: cmp numeric lit types; stage: typecheck
// in: toks; out: ERR/OK
// M166: bitops In (reject_shift/amp_pipe removed)

pub fn typecheck_cmp_numeric_lits(toks: List[String]) {
    let n = list_len(toks);
    let lit_env = build_pure_lit_env(toks);
    let mut i = 0;
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        let mut is_ord = false;
        if k == "LT" {
            is_ord = true;
        } else if k == "GT" {
            is_ord = true;
        } else if k == "LTE" {
            is_ord = true;
        } else if k == "GTE" {
            is_ord = true;
        }
        if is_ord {
            if i > 0 {
                if i + 1 < n {
                    let lty = atom_type_with_env(toks, i - 1, lit_env);
                    let rty = atom_type_with_env(toks, i + 1, lit_env);
                    if lty != "" {
                        if rty != "" {
                            let line = field_at(list_get(toks, i), 1);
                            let col = field_at(list_get(toks, i), 2);
                            let mut ok = false;
                            if lty == "Int" {
                                if rty == "Int" {
                                    ok = true;
                                }
                            }
                            if lty == "Float" {
                                if rty == "Float" {
                                    ok = true;
                                }
                            }
                            if !ok {
                                println(
                                    "ERR\ttype\tType error at "
                                        + line
                                        + ":"
                                        + col
                                        + ": comparison requires matching numeric types (both Int or both Float), found "
                                        + lty
                                        + " and "
                                        + rty
                                );
                                process_exit(1);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// M166: << >> & | ^ are product Int bitops (LSHIFT/RSHIFT/AMP/PIPE/CARET).
// Residual: no float bit ops, no rotate. Type-position &Cap is not a binop.
// (Former R1 reject_shift / reject_amp_pipe removed — ops are In.)

// Pure-lit / lit-env `&&` / `||`: both sides must be Bool when known.
