// # Check comparison numeric lit types
//
// Logline: Walks tokens and exits on an ordered compare whose known literal sides are not both Int or both Float.
//
// Setup: list_len, list_get, field_at, build_pure_lit_env, atom_type_with_env, println, and process_exit exist; toks rows are kind, line, col, text; LT GT LTE GTE are the ordered ops.
//
// Beats:
//   1. Build the pure literal env once, then walk every token.
//   2. On LT, GT, LTE, or GTE, type both neighbors when the index has a left and a right token.
//   3. Matching Int or matching Float is ok; any other known pair prints a type error with path and caret.
//
// residual: no float bit ops, no rotate. Type-position &Cap is not a binop.

pub fn typecheck_cmp_numeric_lits(toks: List[String]) {
    let n = list_len(toks);
    let lit_env: String = build_pure_lit_env(toks);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let mut is_ord = false;
        if k == "LT" {
            is_ord = true;
        } else if k == "GT" {
            is_ord = true;
        } else if k == "LTE" {
            is_ord = true;
        } else if k == "GTE" {
            is_ord = true;
        }
        if is_ord {
            if i > 0 {
                if i + 1 < n {
                    let lty: String = atom_type_with_env(toks, i - 1, lit_env);
                    let rty: String = atom_type_with_env(toks, i + 1, lit_env);
                    if lty != "" {
                        if rty != "" {
                            let mut ok = false;
                            if lty == "Int" {
                                if rty == "Int" {
                                    ok = true;
                                }
                            }
                            if lty == "Float" {
                                if rty == "Float" {
                                    ok = true;
                                }
                            }
                            if !ok {
                                tc_err_at(
                                    toks,
                                    i,
                                    "comparison requires matching numeric types (both Int or both Float), found "
                                        + lty
                                        + " and "
                                        + rty
                                );
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}

// M166: << >> & | ^ are product Int bitops (LSHIFT/RSHIFT/AMP/PIPE/CARET).
// Residual: no float bit ops, no rotate. Type-position &Cap is not a binop.
// (Former R1 reject_shift / reject_amp_pipe removed — ops are In.)

// Pure-lit / lit-env `&&` / `||`: both sides must be Bool when known.
