// # For Loop Parser Probe
//
// Logline: Probes for loop range and collection parsing.
//
// Setup: Direct parser test probe.
//
// Beats:
//   1. Probe for-in AST construction.

import "wasm_emit_interp_for.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut s = 0; for i in 0..5 { s = s + i; } println(s); }";
    let out: String = wi_interp_for_main(src);
    println("out:" + out);
    println("len:" + chars_len(out).to_string());
}
