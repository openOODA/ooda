// # Emit SysV bump concat of two STRING args
//
// Logline: Matches return a+b and println(cat(STRING, STRING)) then copies into a 4096-byte .bss bump.
//
// Setup: tokenize_lines, tok helpers, ascii_esc, and frame enter/leave exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of param1 plus param2.
//   2. Require main to be only println of that fn on two STRING args.
//   3. Copy both strings plus newline into .Lbuf; overflow above 4096 ERRs.
//
// residual: 3-arg rdx, heap beyond 4096, and AArch64 stay later.

import "token_fmt.oo";
import "x86_emit_harv.oo";
import "x86_emit_sys.oo";
import "x86_emit_frame.oo";

fn x86_cat_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 17 >= n {
        return empty;
    }
    if x86_tok_k(toks, i) != "KW_FN" || x86_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = x86_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" || x86_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let p1: String = x86_tok_t(toks, i + 3);
    if x86_tok_k(toks, i + 4) != "COLON" || x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 6) != "COMMA" || x86_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    let p2: String = x86_tok_t(toks, i + 7);
    if x86_tok_k(toks, i + 8) != "COLON" || x86_tok_k(toks, i + 9) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 9) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 10) != "RPAREN" || x86_tok_k(toks, i + 11) != "ARROW" {
        return empty;
    }
    if x86_tok_k(toks, i + 12) != "IDENT" || x86_tok_t(toks, i + 12) != "String" {
        return empty;
    }
    if x86_tok_k(toks, i + 13) != "LBRACE" || x86_tok_k(toks, i + 14) != "KW_RETURN" {
        return empty;
    }
    if x86_tok_k(toks, i + 15) != "IDENT" || x86_tok_t(toks, i + 15) != p1 {
        return empty;
    }
    if x86_tok_k(toks, i + 16) != "PLUS" || x86_tok_k(toks, i + 17) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 17) != p2 {
        return empty;
    }
    let mut p = i + 18;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    return o;
}

fn x86_cat_main(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 13 >= n {
        return empty;
    }
    if x86_tok_k(toks, i + 2) != "LPAREN" || x86_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 4) != "LBRACE" || x86_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if x86_tok_t(toks, i + 5) != "println" || x86_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if x86_tok_k(toks, i + 7) != "IDENT" || x86_tok_t(toks, i + 7) != fname {
        return empty;
    }
    if x86_tok_k(toks, i + 8) != "LPAREN" || x86_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let a: String = x86_tok_t(toks, i + 9);
    if x86_tok_k(toks, i + 10) != "COMMA" || x86_tok_k(toks, i + 11) != "STRING" {
        return empty;
    }
    let b: String = x86_tok_t(toks, i + 11);
    if x86_tok_k(toks, i + 12) != "RPAREN" || x86_tok_k(toks, i + 13) != "RPAREN" {
        return empty;
    }
    let mut p = i + 14;
    if p < n && x86_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || x86_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, a);
    o = list_push(o, b);
    return o;
}

pub fn x86_match_cat_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 {
        return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 >= n || x86_tok_k(toks, i + 1) != "IDENT" {
                return empty;
            }
            let nm: String = x86_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = x86_cat_shape(toks, n, i);
                if list_len(idn) < 1 {
                    return empty;
                }
                if chars_len(fname) > 0 {
                    return empty;
                }
                fname = list_get(idn, 0);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 {
        return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_FN" {
            if i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" {
                if x86_tok_t(toks, i + 1) == "main" {
                    if list_len(found) >= 1 {
                        return empty;
                    }
                    found = x86_cat_main(toks, n, i, fname);
                    if list_len(found) < 3 {
                        return empty;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn x86_emit_cat_call(fname: String, a: String, b: String) {
    let la = chars_len(a);
    let lb = chars_len(b);
    if la + lb + 1 > 4096 {
        println("ERR\tx86_emit\tx86 buf");
        process_exit(1);
    }
    println("# openOODA x86_64 product floor (AT&T, Linux, as+ld)");
    println("    .section .rodata");
    println(".Lstr0:");
    println("    .ascii \"" + x86_ascii_esc(a) + "\"");
    println(".Lstr1:");
    println("    .ascii \"" + x86_ascii_esc(b) + "\"");
    println("    .section .bss");
    println("    .p2align 4");
    println(".Lbuf:");
    println("    .skip 4096");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println(".Lcpy:");
    println("    test %rcx, %rcx");
    println("    jz .Lcpy_done");
    println(".Lcpy_loop:");
    println("    movb (%rsi), %al");
    println("    movb %al, (%rdi)");
    println("    inc %rsi");
    println("    inc %rdi");
    println("    dec %rcx");
    println("    jnz .Lcpy_loop");
    println(".Lcpy_done:");
    println("    ret");
    println(fname + ":");
    x86_emit_frame_enter();
    println("    mov %rdi, %r8");
    println("    mov %rsi, %r9");
    println("    lea .Lbuf(%rip), %rdi");
    println("    mov %r8, %rsi");
    println("    mov $" + la.to_string() + ", %rcx");
    println("    call .Lcpy");
    println("    mov %r9, %rsi");
    println("    mov $" + lb.to_string() + ", %rcx");
    println("    call .Lcpy");
    println("    movb $10, (%rdi)");
    println("    lea .Lbuf(%rip), %rax");
    x86_emit_frame_leave();
    println("main:");
    println("_start:");
    println("    lea .Lstr0(%rip), %rdi");
    println("    lea .Lstr1(%rip), %rsi");
    println("    call " + fname);
    println("    mov %rax, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    println("    mov $" + (la + lb + 1).to_string() + ", %rdx");
    println("    syscall");
    println("    mov $60, %rax");
    println("    xor %rdi, %rdi");
    println("    syscall");
}
