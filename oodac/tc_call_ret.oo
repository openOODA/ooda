// job: return/assign of call results; stage: typecheck
// in: toks; out: ERR/OK

pub fn typecheck_return_and_assign_calls(toks: List[String]) {
    let n = list_len(toks);
    let mut ret_table = build_fn_ret_table(toks);
    // Resolve type aliases in ret table values
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let lit_env = build_pure_lit_env(toks);
    let mut_env = lit_env; // mut types also in pure-lit env when annotated/init known
    // rebuild mut-only for assign targets
    let mut mut_only = "\t";
    let mut mi = 0;
    while mi < n {
        if field_at(list_get(toks, mi), 0) == "KW_LET" {
            let mut p = mi + 1;
            let mut is_mut = false;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    is_mut = true;
                    p = p + 1;
                }
            }
            if is_mut {
                if p < n {
                    if field_at(list_get(toks, p), 0) == "IDENT" {
                        let v = field_at(list_get(toks, p), 3);
                        let ty = resolve_type_alias(lit_env, v);
                        // lit_env stores name:Type; resolve_type_alias on name returns Type if present
                        if ty != v {
                            mut_only = mut_only + v + ":" + ty + "\t";
                        }
                    }
                }
            }
        }
        mi = mi + 1;
    }
    // Walk: return IDENT LPAREN RPAREN; IDENT EQ IDENT LPAREN RPAREN
    let mut i = 0;
    let mut expected_ret = "";
    while i < n {
        let k = field_at(list_get(toks, i), 0);
        let mut is_fn_head = false;
        if k == "KW_FN" {
            is_fn_head = true;
        } else {
            if k == "KW_PUB" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "KW_FN" {
                        is_fn_head = true;
                    }
                }
            }
        }
        if is_fn_head {
            expected_ret = "";
            let mut j = i;
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        j = j + 1;
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                expected_ret = resolve_type_alias(aliases, field_at(list_get(toks, j), 3));
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        } else if k == "KW_RETURN" {
            if expected_ret != "" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                        if i + 2 < n {
                            if field_at(list_get(toks, i + 2), 0) == "LPAREN" {
                                if i + 3 < n {
                                    if field_at(list_get(toks, i + 3), 0) == "RPAREN" {
                                        let cname = field_at(list_get(toks, i + 1), 3);
                                        let got = resolve_type_alias(ret_table, cname);
                                        if got != cname {
                                            let gty = resolve_type_alias(aliases, got);
                                            if !types_compatible(expected_ret, gty) {
                                                let line = field_at(list_get(toks, i), 1);
                                                let col = field_at(list_get(toks, i), 2);
                                                println(
                                                    "ERR\ttype\tType error at "
                                                        + line
                                                        + ":"
                                                        + col
                                                        + ": return type "
                                                        + gty
                                                        + " does not match declared "
                                                        + expected_ret
                                                );
                                                process_exit(1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else if k == "IDENT" {
            // mut assign: name = call()
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "EQ" {
                    let mut is_let = false;
                    if i > 0 {
                        let pk = field_at(list_get(toks, i - 1), 0);
                        if pk == "KW_LET" || pk == "KW_MUT" {
                            is_let = true;
                        }
                    }
                    if !is_let {
                        let vname = field_at(list_get(toks, i), 3);
                        let vty = resolve_type_alias(mut_only, vname);
                        if vty != vname {
                            if i + 2 < n {
                                if field_at(list_get(toks, i + 2), 0) == "IDENT" {
                                    if i + 3 < n {
                                        if field_at(list_get(toks, i + 3), 0) == "LPAREN" {
                                            if i + 4 < n {
                                                if field_at(list_get(toks, i + 4), 0) == "RPAREN" {
                                                    let cname = field_at(list_get(toks, i + 2), 3);
                                                    let got = resolve_type_alias(ret_table, cname);
                                                    if got != cname {
                                                        let gty = resolve_type_alias(aliases, got);
                                                        if !types_compatible(vty, gty) {
                                                            let line = field_at(list_get(toks, i), 1);
                                                            let col = field_at(list_get(toks, i), 2);
                                                            println(
                                                                "ERR\ttype\tType error at "
                                                                    + line
                                                                    + ":"
                                                                    + col
                                                                    + ": cannot assign "
                                                                    + gty
                                                                    + " to '"
                                                                    + vname
                                                                    + "' of type "
                                                                    + vty
                                                            );
                                                            process_exit(1);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
}

// Fail-closed: `g() + "a"` / `"a" + g()` arithmetic/concat with zero-arg call.
