// # Typecheck return and assign calls
//
// Logline: Checks that return f(...); and name = f(...) match the declared return or mut binding type.
//
// Setup: toks rows are kind, line, col, text; build_fn_ret_table is lazy on first non-cap miss; call_ret_type_at, types_compatible, and tc_err_at exist; cap_builtin_ret short-circuits env_get/oo_env_get and similar.
//
// Beats:
//   1. Collect type aliases and mut-only names from let mut bindings.
//   2. On each fn head, remember the ARROW return type; on return IDENT LPAREN ... SEMI, compare the call type to it.
//   3. On IDENT EQ IDENT LPAREN that is not a let, compare the call type to the mut binding.

pub fn typecheck_return_and_assign_calls(toks: List[String]) {
    let n = list_len(toks);
    let mut ret_table: String = "";
    // Resolve type aliases in ret table values
    let mut aliases = "\t";
    let mut ai = 0;
    while ai < n {
        if field_at(list_get(toks, ai), 0) == "KW_TYPE" {
            if ai + 1 < n {
                if field_at(list_get(toks, ai + 1), 0) == "IDENT" {
                    let aname: String = field_at(list_get(toks, ai + 1), 3);
                    if ai + 2 < n {
                        if field_at(list_get(toks, ai + 2), 0) == "EQ" {
                            if ai + 3 < n {
                                if field_at(list_get(toks, ai + 3), 0) == "IDENT" {
                                    aliases = aliases + aname + ":" + field_at(list_get(toks, ai + 3), 3) + "\t";
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1;
    }
    let lit_env: String = build_pure_lit_env(toks);
    let mut_env = lit_env; // mut types also in pure-lit env when annotated/init known
    // rebuild mut-only for assign targets
    let mut mut_only = "\t";
    let mut mi = 0;
    while mi < n {
        if field_at(list_get(toks, mi), 0) == "KW_LET" {
            let mut p = mi + 1;
            let mut is_mut = false;
            if p < n {
                if field_at(list_get(toks, p), 0) == "KW_MUT" {
                    is_mut = true;
                    p = p + 1;
                }
            }
            if is_mut {
                if p < n {
                    if field_at(list_get(toks, p), 0) == "IDENT" {
                        let v: String = field_at(list_get(toks, p), 3);
                        let ty: String = resolve_type_alias(lit_env, v);
                        // lit_env stores name:Type; resolve_type_alias on name returns Type if present
                        if ty != v {
                            mut_only = mut_only + v + ":" + ty + "\t";
                        }
                    }
                }
            }
        }
        mi = mi + 1;
    }
    // Walk: return call(…); IDENT = call(…) — any arity free calls (multi-import ret_table).
    let mut i = 0;
    let mut expected_ret = "";
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let mut is_fn_head = false;
        if k == "KW_FN" {
            is_fn_head = true;
        } else {
            if k == "KW_PUB" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "KW_FN" {
                        is_fn_head = true;
                    }
                }
            }
        }
        if is_fn_head {
            expected_ret = "";
            let mut j = i;
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk: String = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        j = j + 1;
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                expected_ret = resolve_type_alias(aliases, field_at(list_get(toks, j), 3));
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        } else if k == "KW_RETURN" {
            if expected_ret != "" {
                if i + 1 < n {
                    if field_at(list_get(toks, i + 1), 0) == "IDENT" {
                        if i + 2 < n {
                            if field_at(list_get(toks, i + 2), 0) == "LPAREN" {
                                // Only `return f(...);`. `return f() != ""` is Bool, not f's ret.
                                let rp = match_rparen(toks, i + 2);
                                let mut semi_after = false;
                                if rp >= 0 {
                                    if rp + 1 < n {
                                        if field_at(list_get(toks, rp + 1), 0) == "SEMI" {
                                            semi_after = true;
                                        }
                                    }
                                }
                                if semi_after {
                                    let mut gty: String = cap_builtin_ret(
                                        field_at(list_get(toks, i + 1), 3)
                                    );
                                    if gty != "" {
                                        gty = resolve_type_alias(aliases, gty);
                                    } else {
                                        if ret_table == "" {
                                            ret_table = build_fn_ret_table(toks);
                                        }
                                        gty = call_ret_type_at(
                                            toks,
                                            i + 1,
                                            ret_table,
                                            aliases
                                        );
                                    }
                                    if gty != "" {
                                        if !types_compatible(expected_ret, gty) {
                                            tc_err_at(
                                                toks,
                                                i,
                                                "return type "
                                                    + gty
                                                    + " does not match declared "
                                                    + expected_ret
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else if k == "IDENT" {
            // mut assign: name = call(…)
            if i + 1 < n {
                if field_at(list_get(toks, i + 1), 0) == "EQ" {
                    let mut is_let = false;
                    if i > 0 {
                        let pk: String = field_at(list_get(toks, i - 1), 0);
                        if pk == "KW_LET" || pk == "KW_MUT" {
                            is_let = true;
                        }
                    }
                    if !is_let {
                        let vname: String = field_at(list_get(toks, i), 3);
                        let vty: String = resolve_type_alias(mut_only, vname);
                        if vty != vname {
                            if i + 2 < n {
                                if field_at(list_get(toks, i + 2), 0) == "IDENT" {
                                    if i + 3 < n {
                                        if field_at(list_get(toks, i + 3), 0) == "LPAREN" {
                                            let mut gty: String = cap_builtin_ret(
                                                field_at(list_get(toks, i + 2), 3)
                                            );
                                            if gty != "" {
                                                gty = resolve_type_alias(aliases, gty);
                                            } else {
                                                if ret_table == "" {
                                                    ret_table = build_fn_ret_table(toks);
                                                }
                                                gty = call_ret_type_at(
                                                    toks,
                                                    i + 2,
                                                    ret_table,
                                                    aliases
                                                );
                                            }
                                            if gty != "" {
                                                if !types_compatible(vty, gty) {
                                                    tc_err_at(
                                                        toks,
                                                        i,
                                                        "cannot assign "
                                                            + gty
                                                            + " to '"
                                                            + vname
                                                            + "' of type "
                                                            + vty
                                                    );
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
}

// Cap-bound free names: fixed first-IDENT ret. Skips ret_table scan and match_rparen.
pub fn cap_builtin_ret(name: String) -> String {
    if name == "env_get" || name == "oo_env_get"
        || name == "read_file" || name == "oo_read_file"
        || name == "write_file" || name == "oo_write_file"
        || name == "fs_read_file" || name == "fs_write_file"
        || name == "fetch" || name == "sys_exec" || name == "oo_sys_exec"
        || name == "fs_mkdir" || name == "oo_fs_mkdir"
        || name == "fs_remove_file" || name == "oo_fs_remove_file"
    {
        return "Result";
    }
    if name == "path_exists" || name == "oo_path_exists"
        || name == "fs_path_exists" || name == "fs_is_dir"
        || name == "oo_fs_is_dir"
    {
        return "Bool";
    }
    if name == "file_size" || name == "oo_file_size"
        || name == "fs_file_size" || name == "now_ms"
    {
        return "Int";
    }
    if name == "process_args" || name == "oo_sys_args"
        || name == "fs_walk" || name == "fs_read_dir"
        || name == "oo_fs_read_dir"
    {
        return "List";
    }
    return "";
}

// Fail-closed: `g() + "a"` / `"a" + g()` arithmetic/concat with zero-arg call.
