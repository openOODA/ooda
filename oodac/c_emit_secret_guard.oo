// package: backend-c — emit floor
// job: emit-time secret sink guards
// stage: emit
// Emit-time secret guards for sealed sinks (a0/a1/a2 are C arg texts).

// Define helpers BEFORE c_secret_emit_guard so pure multi C emit has a
// visible declaration at the call site (no implicit-function-declaration).

// Resolve arg name through __alias__ then refuse if final is SECRET ("1" only).
pub fn c_secret_refuse_sink_resolved(env: String, t: String, name: String) {
    let cur: String = c_secret_resolve_alias(env, name);
    c_secret_refuse_sink_ident(env, t, cur);
}

// CRIT 7.1: walk C arg text for bare idents; refuse SECRET (alias-resolved).
// Skip string literals, // line comments, and /* */ block comments (2.7).
// Ident spans via str_slice once per token — no per-char OoStr thrash.
pub fn c_guard_scan_idents(env: String, sink: String, args: String) {
    let n = chars_len(args);
    let mut i = 0;
    let mut in_str = false;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "/" && i + 1 < n {
            // HIGH 2.7: skip // line and /* */ block comments (not bare /).
            let n1 = char_at(args, i + 1);
            if n1 == "/" {
                i = i + 2;
                while i < n {
                    let d = char_at(args, i);
                    if d == "\n" {
                        break;
                    }
                    i = i + 1;
                }
            } else if n1 == "*" {
                i = i + 2;
                let mut in_blk = true;
                while in_blk && i < n {
                    if char_at(args, i) == "*" && i + 1 < n {
                        if char_at(args, i + 1) == "/" {
                            i = i + 2;
                            in_blk = false;
                        } else {
                            i = i + 1;
                        }
                    } else {
                        i = i + 1;
                    }
                }
            } else {
                i = i + 1;
            }
        } else {
            let is_start = c == "_"
                || c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f"
                || c == "g" || c == "h" || c == "i" || c == "j" || c == "k" || c == "l"
                || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r"
                || c == "s" || c == "t" || c == "u" || c == "v" || c == "w" || c == "x"
                || c == "y" || c == "z" || c == "A" || c == "B" || c == "C" || c == "D"
                || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J"
                || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P"
                || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V"
                || c == "W" || c == "X" || c == "Y" || c == "Z";
            if is_start {
                let start = i;
                i = i + 1;
                while i < n {
                    let d = char_at(args, i);
                    let is_cont = d == "_"
                        || d == "a" || d == "b" || d == "c" || d == "d" || d == "e" || d == "f"
                        || d == "g" || d == "h" || d == "i" || d == "j" || d == "k" || d == "l"
                        || d == "m" || d == "n" || d == "o" || d == "p" || d == "q" || d == "r"
                        || d == "s" || d == "t" || d == "u" || d == "v" || d == "w" || d == "x"
                        || d == "y" || d == "z" || d == "A" || d == "B" || d == "C" || d == "D"
                        || d == "E" || d == "F" || d == "G" || d == "H" || d == "I" || d == "J"
                        || d == "K" || d == "L" || d == "M" || d == "N" || d == "O" || d == "P"
                        || d == "Q" || d == "R" || d == "S" || d == "T" || d == "U" || d == "V"
                        || d == "W" || d == "X" || d == "Y" || d == "Z"
                        || d == "0" || d == "1" || d == "2" || d == "3" || d == "4"
                        || d == "5" || d == "6" || d == "7" || d == "8" || d == "9";
                    if is_cont {
                        i = i + 1;
                    } else {
                        break;
                    }
                }
                // One slice per ident span (O(token) once), not O(token²) concat.
                let name = str_slice(args, start, i);
                c_secret_refuse_sink_resolved(env, sink, name);
            } else {
                i = i + 1;
            }
        }
    }
}

pub fn c_secret_emit_guard(env: String, t: String, a0: String, a1: String, a2: String, args: String) {
    // CRIT 2.4: resolve callee alias so `let f = tcp_write; f(secret)` is a sink.
    let sink: String = c_secret_resolve_alias(env, t);
    if sink == "read_file" || sink == "path_exists" || sink == "file_size" || sink == "env_get" || sink == "env_set" || sink == "fetch" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
    }
    if sink == "write_file" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_resolved(env, sink, a2);
        }
    }
    if sink == "sys_exec" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_resolved(env, sink, a2);
        }
        let last = c_sys_exec_last_arg(args);
        if last != "" && c_arg_is_cap_ident(last) {
            c_secret_refuse_sink_resolved(env, sink, last);
        }
    }
    if sink == "sleep_ms" || sink == "seed" || sink == "alloc_bytes" || sink == "free_bytes"
        || sink == "malloc" || sink == "free" || sink == "realloc" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
        if sink == "realloc" && a2 != "" {
            c_secret_refuse_sink_resolved(env, sink, a2);
        }
    }
    if sink == "process_exit" {
        if a0 != "" {
            c_secret_refuse_sink_resolved(env, sink, a0);
        }
    }
    // CRIT 2.3 / HIGH 6.1: env + OS/mmap sinks (cap-first → scan a1/a2)
    if sink == "setenv" || sink == "env_set" || sink == "unsetenv" || sink == "mmap"
        || sink == "mprotect" || sink == "shmat" || sink == "pwrite" || sink == "sendfile"
        || sink == "splice" || sink == "tee" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_resolved(env, sink, a2);
        }
    }
    // Net / FFI payload sinks (alias-resolved); a1/a2 then full args (6.2)
    if sink == "tcp_write" || sink == "net_tcp_write" || sink == "net_send" || sink == "http_post"
        || sink == "tcp_read" || sink == "udp_recv" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_resolved(env, sink, a2);
        }
    }
    if sink == "dlopen" || sink == "dlsym" || sink == "dlclose" || sink == "ffi_call"
        || sink == "ffi_prep_cif" {
        if a1 != "" {
            c_secret_refuse_sink_resolved(env, sink, a1);
        }
    }
    // CRIT/HIGH 2.5 + 6.2: after a0/a1/a2, scan full joined arg text for every sealed sink.
    // println/write_file/fetch/net/FFI kept; extends read_file/sys_exec/env/OS sinks too.
    if args != "" {
        if sink == "read_file" || sink == "path_exists" || sink == "file_size" || sink == "env_get"
            || sink == "env_set" || sink == "fetch" || sink == "write_file" || sink == "sys_exec"
            || sink == "sleep_ms" || sink == "seed" || sink == "alloc_bytes" || sink == "free_bytes"
            || sink == "malloc" || sink == "free" || sink == "realloc" || sink == "process_exit"
            || sink == "setenv" || sink == "unsetenv" || sink == "mmap" || sink == "mprotect"
            || sink == "shmat" || sink == "pwrite" || sink == "sendfile" || sink == "splice"
            || sink == "tee" || sink == "tcp_write" || sink == "net_tcp_write" || sink == "net_send"
            || sink == "http_post" || sink == "tcp_read" || sink == "udp_recv" || sink == "dlopen"
            || sink == "dlsym" || sink == "dlclose" || sink == "ffi_call" || sink == "ffi_prep_cif"
            || sink == "println" || sink == "eprintln" || sink == "print_err" || sink == "log"
            || sink == "fprintf" || sink == "syslog" {
            c_guard_scan_idents(env, sink, args);
        }
    }
}
