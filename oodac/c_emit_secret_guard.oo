// package: backend-c — emit floor
// job: emit-time secret sink guards
// stage: emit
// Emit-time secret guards for sealed sinks (a0/a1/a2 are C arg texts).
pub fn c_secret_emit_guard(env: String, t: String, a0: String, a1: String, a2: String, args: String) {
    if t == "read_file" || t == "path_exists" || t == "file_size" || t == "env_get" || t == "fetch" {
        if a1 != "" {
            c_secret_refuse_sink_ident(env, t, a1);
        }
    }
    if t == "write_file" {
        if a1 != "" {
            c_secret_refuse_sink_ident(env, t, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_ident(env, t, a2);
        }
    }
    if t == "sys_exec" {
        if a1 != "" {
            c_secret_refuse_sink_ident(env, t, a1);
        }
        if a2 != "" {
            c_secret_refuse_sink_ident(env, t, a2);
        }
        let last = c_sys_exec_last_arg(args);
        if last != "" && c_arg_is_cap_ident(last) {
            c_secret_refuse_sink_ident(env, t, last);
        }
    }
    if t == "sleep_ms" || t == "seed" || t == "alloc_bytes" || t == "free_bytes" {
        if a1 != "" {
            c_secret_refuse_sink_ident(env, t, a1);
        }
    }
    if t == "process_exit" {
        if a0 != "" {
            c_secret_refuse_sink_ident(env, t, a0);
        }
    }
}

