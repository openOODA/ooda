// # Lower let x = match to LLVM
//
// Logline: Allocates the let slot, binds __asgn__, and emits a statement match that stores each arm value.
//
// Setup: Called from llvm_emit_let when the RHS is KW_MATCH. llvm_emit_match_stmt writes the asgn slot.
//
// Beats:
//   1. Map the annotation to an LLVM type (default i64).
//   2. Alloca a unique slot and set __asgn__.
//   3. Emit the match and clear __asgn__.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";
import "llvm_emit_match.oo";

pub fn llvm_emit_let_match(name: String, ann_ty: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut final_ty: String = "i64";
    if ann_ty != "" { final_ty = llvm_ty_map(ann_ty); }
    if final_ty == "void" || final_ty == "" { final_ty = "i64"; }
    let mut cur_env: List[String] = env;
    let irc: Int = parse_int(list_get(cur_env, 0));
    let inrc: Int = irc + 1;
    let slot: String = name + "." + irc.to_string();
    let mut ibump: List[String] = list_new();
    ibump = list_push(ibump, inrc.to_string());
    ibump = list_push(ibump, list_get(cur_env, 1));
    ibump = list_push(ibump, list_get(cur_env, 2));
    ibump = list_push(ibump, list_get(cur_env, 3));
    ibump = list_push(ibump, list_get(cur_env, 4));
    cur_env = llvm_env_add_var(ibump, "__slot__" + name, slot);
    println("  %" + slot + ".slot = alloca " + final_ty + ", align 8");
    if final_ty == "i64" {
        println("  store i64 0, i64* %" + slot + ".slot, align 8");
    } else if final_ty == "i32" {
        println("  store i32 0, i32* %" + slot + ".slot, align 8");
    }
    cur_env = llvm_env_add_var(cur_env, name, final_ty);
    cur_env = llvm_env_add_var(cur_env, "__asgn__", name);
    let ms: List[String] = llvm_emit_match_stmt(toks, pos, n, cur_env);
    let mut p = parse_int(list_get(ms, 0));
    cur_env = list_new();
    cur_env = list_push(cur_env, list_get(ms, 1));
    cur_env = list_push(cur_env, list_get(ms, 2));
    cur_env = list_push(cur_env, list_get(ms, 3));
    cur_env = list_push(cur_env, list_get(ms, 4));
    cur_env = list_push(cur_env, list_get(ms, 5));
    cur_env = llvm_env_add_var(cur_env, "__asgn__", "");
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
