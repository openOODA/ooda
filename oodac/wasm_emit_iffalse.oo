// # Detect const if-false println with no else
//
// Logline: Returns a newline body when a function is only if false with one println(STRING) and no else, so fd_write exists and the skipped STRING is not printed.
//
// Setup: tokenize_lines and field_at exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if KW_FALSE then one println(STRING) branch, then the function RBRACE.
//   3. Return a single newline. IDENT, KW_TRUE, else, and extra statements miss.
//
// residual: runtime if stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wff_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wff_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wff_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n {
        return empty;
    }
    if wff_kind(toks, p) != "IDENT" || wff_text(toks, p) != "println" {
        return empty;
    }
    if wff_kind(toks, p + 1) != "LPAREN" || wff_kind(toks, p + 2) != "STRING" {
        return empty;
    }
    if wff_kind(toks, p + 3) != "RPAREN" {
        return empty;
    }
    let lit: String = wff_text(toks, p + 2);
    p = p + 4;
    if p < n && wff_kind(toks, p) == "SEMI" {
        p = p + 1;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

pub fn wasm_fn_if_false_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wff_kind(toks, i) == "KW_FN" && wff_kind(toks, i + 1) == "IDENT" {
            if wff_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wff_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 2 >= n || wff_kind(toks, p) != "KW_IF" {
                    return "";
                }
                p = p + 1;
                if p >= n || wff_kind(toks, p) != "KW_FALSE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wff_kind(toks, p) != "LBRACE" {
                    return "";
                }
                p = p + 1;
                let th: List[String] = wff_one_str_println(toks, p, n);
                if list_len(th) < 2 {
                    return "";
                }
                p = parse_int(list_get(th, 1));
                if p >= n || wff_kind(toks, p) != "RBRACE" {
                    return "";
                }
                p = p + 1;
                if p >= n || wff_kind(toks, p) != "RBRACE" {
                    return "";
                }
                return "\n";
            }
        }
        i = i + 1;
    }
    return "";
}
