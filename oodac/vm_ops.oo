// # Evaluate a VM binary or unary opcode
//
// Logline: Applies ADD through OR and NOT or NEG to tagged values and returns a tagged result, or V:0 when the opcode is unknown.
//
// Setup: vm_val.oo is imported; ADD concatenates when either side is S; DIV and MOD by zero yield 0.
//
// Beats:
//   1. eval_vm_binop decodes ADD, SUB, MUL, DIV, and MOD on tagged ints or strings.
//   2. EQ through GE and AND or OR return a tagged bool.
//   3. eval_vm_unop handles NOT and NEG; any other opcode returns val_void.

import "vm_val.oo";

pub fn eval_vm_binop(opcode: String, a_val: String, b_val: String) -> String {
    let sa = "" + val_to_str(a_val);
    let sb = "" + val_to_str(b_val);
    if opcode == "ADD" {
        if val_type(a_val) == "S" || val_type(b_val) == "S" {
            return val_str(sa + sb);
        }
        return val_int(val_to_int(a_val) + val_to_int(b_val));
    }
    if opcode == "SUB" { return val_int(val_to_int(a_val) - val_to_int(b_val)); }
    if opcode == "MUL" { return val_int(val_to_int(a_val) * val_to_int(b_val)); }
    if opcode == "DIV" {
        let bv = 0 + val_to_int(b_val);
        let mut dres = 0;
        if bv != 0 { dres = val_to_int(a_val) / bv; }
        return val_int(dres);
    }
    if opcode == "MOD" {
        let bv = 0 + val_to_int(b_val);
        if bv == 0 { return val_int(0); }
        let av = 0 + val_to_int(a_val);
        return val_int(av - (av / bv) * bv);
    }
    if opcode == "EQ" {
        let mut is_eq = 0;
        if sa == sb { is_eq = 1; }
        return val_bool(is_eq);
    }
    if opcode == "NE" {
        let mut is_ne = 0;
        if sa != sb { is_ne = 1; }
        return val_bool(is_ne);
    }
    if opcode == "LT" {
        let mut is_lt = 0;
        if val_to_int(a_val) < val_to_int(b_val) { is_lt = 1; }
        return val_bool(is_lt);
    }
    if opcode == "LE" {
        let mut is_le = 0;
        if val_to_int(a_val) <= val_to_int(b_val) { is_le = 1; }
        return val_bool(is_le);
    }
    if opcode == "GT" {
        let mut is_gt = 0;
        if val_to_int(a_val) > val_to_int(b_val) { is_gt = 1; }
        return val_bool(is_gt);
    }
    if opcode == "GE" {
        let mut is_ge = 0;
        if val_to_int(a_val) >= val_to_int(b_val) { is_ge = 1; }
        return val_bool(is_ge);
    }
    if opcode == "AND" {
        let mut is_and = 0;
        if val_to_bool(a_val) {
            if val_to_bool(b_val) { is_and = 1; }
        }
        return val_bool(is_and);
    }
    if opcode == "OR" {
        let mut is_or = 0;
        if val_to_bool(a_val) { is_or = 1; }
        if val_to_bool(b_val) { is_or = 1; }
        return val_bool(is_or);
    }
    // M166: BAND/BOR/BXOR/SHL/SHR opcodes reserved; pure VM residual until
    // seed rebuild can use product bitops. C/LLVM path is product floor.
    return val_void();
}

pub fn eval_vm_unop(opcode: String, a_val: String) -> String {
    if opcode == "NOT" {
        let mut is_not = 0;
        if !val_to_bool(a_val) { is_not = 1; }
        return val_bool(is_not);
    }
    if opcode == "NEG" {
        return val_int(0 - val_to_int(a_val));
    }
    return val_void();
}
