// Logline: Probes core interpreter instruction flow.
//
// Setup: Direct interpreter execution probe.
//
// Beats:
//   1. Verify interpreter evaluation cycle.

import "wasm_emit_interp_for.oo";
pub fn main() {
    let src: String = "pub fn main() { let mut s = 0; for i in 0..5 { s = s + i; } println(s); }";
    let out: String = wi_interp_for_main(src);
    if chars_len(out) <= 0 {
        println("EMPTY");
    } else {
        println(out);
    }
}
