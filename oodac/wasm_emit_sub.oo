// # Detect println of two integer literals subtracted
//
// Logline: Returns the decimal difference when a function body is only println of INT minus INT.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT MINUS INT ) with optional semicolon, then RBRACE.
//   3. Return (left - right) decimal text. IDENT operands miss.
//
// residual: runtime IDENT sub stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wsu_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wsu_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wsu_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wsu_kind(toks, p) == "KW_LET" && wsu_kind(toks, p + 1) == "IDENT" && wsu_text(toks, p + 1) == name && wsu_kind(toks, p + 2) == "EQ" && wsu_kind(toks, p + 3) == "INT" { return wsu_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wsu_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wsu_kind(toks, pos) == "INT" { return wsu_text(toks, pos); }
    if wsu_kind(toks, pos) == "IDENT" {
        let name: String = wsu_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wsu_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wsu_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wsu_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wsu_kind(toks, i) == "KW_FN" && wsu_kind(toks, i + 1) == "IDENT" && wsu_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wsu_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wsu_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wsu_kind(toks, p) == "KW_LET" {
        while p < n && wsu_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wsu_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_println_sub(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wsu_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wsu_p(toks, n, f + 2);
    if p0 < 0 || p0 + 5 >= n { return ""; }
    if wsu_kind(toks, p0) != "IDENT" || wsu_text(toks, p0) != "println" { return ""; }
    if wsu_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    let ls: String = wsu_int_val(toks, p0 + 2, n);
    if chars_len(ls) <= 0 { return ""; }
    if wsu_kind(toks, p0 + 3) != "MINUS" { return ""; }
    let rs: String = wsu_int_val(toks, p0 + 4, n);
    if chars_len(rs) <= 0 { return ""; }
    if wsu_kind(toks, p0 + 5) != "RPAREN" { return ""; }
    let diff: Int = parse_int(ls) - parse_int(rs);
    let mut p: Int = p0 + 6;
    if p < n && wsu_kind(toks, p) == "SEMI" { p = p + 1; }
    if p < n && wsu_kind(toks, p) == "RBRACE" { return diff.to_string(); }
    return "";
}
