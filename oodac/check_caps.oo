// job: sealed-effect capability check on fn items; stage: check
// in: token list + pos; out: pos after fn; DESIGN caps pillar
// F01: sealed call must pass cap-typed arg (not only declare &Cap param)
// helpers: check_cap_util.oo (is_cap_type / sealed_kind_of / bags)

pub fn skip_until_semi(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    while pos < n {
        if field_at(list_get(toks, pos), 0) == "SEMI" {
            return pos + 1;
        }
        pos = pos + 1;
    }
    return pos;
}

// Check one function for sealed-effect capability violations. Returns pos after fn.
pub fn check_function(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0;
    if field_at(list_get(toks, pos), 0) == "KW_PUB" {
        pos = pos + 1;
    }
    pos = pos + 1;
    let fname = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    pos = pos + 1;
    // granted kinds: "|FsCap|…|"; arg-flow names: "|FsCap:fs|…|"
    let mut granted = "";
    let mut names = "";
    // Scan params: grant ONLY COLON+AMP+Cap; record param IDENT for arg-flow seal
    let mut cont = true;
    let mut after_colon = false;
    let mut after_amp = false;
    let mut bracket_depth = 0;
    let mut last_param = "";
    while cont {
        if pos >= n {
            cont = false;
        } else {
            let k = field_at(list_get(toks, pos), 0);
            if k == "RPAREN" {
                cont = false;
            } else if k == "COMMA" {
                after_colon = false;
                after_amp = false;
                last_param = "";
                pos = pos + 1;
            } else if k == "COLON" {
                after_colon = true;
                after_amp = false;
                pos = pos + 1;
            } else if k == "LBRACKET" {
                bracket_depth = bracket_depth + 1;
                pos = pos + 1;
            } else if k == "RBRACKET" {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
                pos = pos + 1;
            } else if k == "AMP" {
                if after_colon && bracket_depth == 0 {
                    after_amp = true;
                }
                pos = pos + 1;
            } else if k == "IDENT" {
                let t = field_at(list_get(toks, pos), 3);
                if after_amp && bracket_depth == 0 {
                    if is_cap_type(t) {
                        granted = cap_bag_put(granted, t);
                        if last_param != "" {
                            names = cap_bag_put(names, t + ":" + last_param);
                        }
                    }
                    after_amp = false;
                    after_colon = false;
                } else if after_colon && bracket_depth == 0 {
                    after_colon = false;
                } else if !after_colon && bracket_depth == 0 {
                    last_param = t;
                }
                pos = pos + 1;
            } else {
                pos = pos + 1;
            }
        }
    }
    if field_at(list_get(toks, pos), 0) == "RPAREN" {
        pos = pos + 1;
    }
    while pos < n {
        if field_at(list_get(toks, pos), 0) == "LBRACE" {
            let body_start = pos + 1;
            let body_end = 0 + skip_balanced(toks, pos) - 1;
            let mut i = body_start;
            while i < body_end {
                let k = field_at(list_get(toks, i), 0);
                let text = field_at(list_get(toks, i), 3);
                if k == "IDENT" {
                    if i + 1 < n {
                        if field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                            let kind: String = sealed_kind_of(text);
                            if kind != "" {
                                let line: String = field_at(list_get(toks, i), 1);
                                let col: String = field_at(list_get(toks, i), 2);
                                // CAP-G1 path-A: prefer K from sealed_kind_of; accept bag has K
                                // OR legacy NetCap supersede for granular net kinds. Reject wrong granular
                                // (e.g. only HttpCap for tcp_bind). No "any granular_ok for NetCap" fail-open.
                                if !cap_bag_has(granted, kind) {
                                    let mut grant_ok = false;
                                    if kind == "HttpCap" || kind == "TcpCap" || kind == "UdpCap" || kind == "BindCap" {
                                        if cap_bag_has(granted, "NetCap") { grant_ok = true; }
                                    }
                                    if kind == "FsReadCap" || kind == "FsWriteCap" {
                                        if cap_bag_has(granted, "FsCap") { grant_ok = true; }
                                    }
                                    if kind == "FsCap" {
                                        if text == "read_file" || text == "fs_read" || text == "path_exists" || text == "file_size" {
                                            if cap_bag_has(granted, "FsReadCap") { grant_ok = true; }
                                        }
                                        if text == "write_file" || text == "fs_write" {
                                            if cap_bag_has(granted, "FsWriteCap") { grant_ok = true; }
                                        }
                                    }
                                    if !grant_ok {
                                        cap_deny(
                                            fname,
                                            text,
                                            kind,
                                            line,
                                            col,
                                            "parameter, but none was declared"
                                        );
                                    }
                                }
                                let mut cap_id: String = "";
                                let mut ok_form = false;
                                if i >= 2 {
                                    if field_at(list_get(toks, i - 1), 0) == "DOT" {
                                        if field_at(list_get(toks, i - 2), 0) == "IDENT" {
                                            cap_id = field_at(list_get(toks, i - 2), 3);
                                            ok_form = true;
                                        }
                                    }
                                }
                                if !ok_form {
                                    let apos = i + 2;
                                    if apos < n {
                                        if field_at(list_get(toks, apos), 0) == "IDENT" {
                                            cap_id = field_at(list_get(toks, apos), 3);
                                            ok_form = true;
                                        }
                                    }
                                }
                                // Arg-flow: K:cap_id OR NetCap:cap_id (legacy supersede)
                                let bag_key: String = kind + ":" + cap_id;
                                let mut has_name = cap_bag_has(names, bag_key);
                                if kind == "HttpCap" || kind == "TcpCap" || kind == "UdpCap" || kind == "BindCap" {
                                    if cap_bag_has(names, "NetCap:" + cap_id) { has_name = true; }
                                }
                                if kind == "FsReadCap" || kind == "FsWriteCap" {
                                    if cap_bag_has(names, "FsCap:" + cap_id) { has_name = true; }
                                }
                                if kind == "FsCap" {
                                    if text == "read_file" || text == "fs_read" || text == "path_exists" || text == "file_size" {
                                        if cap_bag_has(names, "FsReadCap:" + cap_id) { has_name = true; }
                                    }
                                    if text == "write_file" || text == "fs_write" {
                                        if cap_bag_has(names, "FsWriteCap:" + cap_id) { has_name = true; }
                                    }
                                }
                                if !ok_form || !has_name {
                                    cap_deny(
                                        fname,
                                        text,
                                        kind,
                                        line,
                                        col,
                                        "as first argument (or method receiver), but call does not pass a matching cap token"
                                    );
                                }
                            }
                        }
                    }
                }
                i = i + 1;
            }
            pos = skip_balanced(toks, pos);
            if pos < n {
                if field_at(list_get(toks, pos), 0) == "KW_VERIFY" {
                    pos = pos + 1;
                    if pos < n {
                        if field_at(list_get(toks, pos), 0) == "IDENT" {
                            pos = pos + 1;
                        }
                    }
                    if pos < n {
                        if field_at(list_get(toks, pos), 0) == "LBRACE" {
                            pos = skip_balanced(toks, pos);
                        }
                    }
                }
            }
            return pos;
        }
        pos = pos + 1;
    }
    return pos;
}
