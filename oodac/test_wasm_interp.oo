// # WebAssembly Interpreter Test
//
// Logline: Verifies wasm interpreter execution.
//
// Setup: Imports wasm interpreter engine.
//
// Beats:
//   1. Execute wasm bytecode in interpreter.

import "wasm_emit_interp.oo";
pub fn main() {
    let src1: String = "pub fn main() { let flag = true; println(flag); }";
    let out1: String = wasm_interp_main(src1);
    println("out1:" + out1);
    let src2: String = "pub fn main() { println(true); }";
    let out2: String = wasm_interp_main(src2);
    println("out2:" + out2);
}
