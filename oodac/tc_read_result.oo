// # Read Result and Option type args
//
// Logline: Collect Result and Option bracket args so typecheck stores T/E, not only the base name.
//
// Setup: toks rows are kind, line, col, text; pos is at LBRACKET after the type IDENT.
//
// Beats:
//   1. tc_skip_brackets walks nested [ ] and returns the index after the match.
//   2. tc_bracket_type_text packs IDENT, COMMA, and nested bracket text.
//   3. tc_read_result_ann appends that text only when the base is Result or Option.

pub fn tc_skip_brackets(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut p = pos0;
    if p >= n {
        return p;
    }
    if field_at(list_get(toks, p), 0) != "LBRACKET" {
        return p;
    }
    let mut depth = 0;
    let mut cont_g = true;
    while cont_g {
        if p >= n {
            cont_g = false;
        } else {
            let gk: String = field_at(list_get(toks, p), 0);
            if gk == "LBRACKET" {
                depth = depth + 1;
            }
            if gk == "RBRACKET" {
                depth = depth - 1;
                if depth == 0 {
                    p = p + 1;
                    cont_g = false;
                } else {
                    p = p + 1;
                }
            } else {
                p = p + 1;
            }
        }
    }
    return p;
}

pub fn tc_bracket_type_text(toks: List[String], pos0: Int) -> String {
    let n = list_len(toks);
    let mut p = pos0;
    let mut depth = 0;
    let mut out = "";
    let mut cont_g = true;
    while cont_g {
        if p >= n {
            cont_g = false;
        } else {
            let gk: String = field_at(list_get(toks, p), 0);
            if gk == "LBRACKET" {
                depth = depth + 1;
                out = out + "[";
            }
            if gk == "RBRACKET" {
                depth = depth - 1;
                out = out + "]";
                if depth == 0 {
                    cont_g = false;
                }
            } else {
                if gk == "IDENT" {
                    out = out + field_at(list_get(toks, p), 3);
                }
                if gk == "COMMA" {
                    out = out + ", ";
                }
            }
            p = p + 1;
        }
    }
    return out;
}

pub fn tc_read_result_ann(base: String, toks: List[String], pos: Int) -> String {
    if base != "Result" {
        if base != "Option" {
            return base;
        }
    }
    let n = list_len(toks);
    if pos >= n {
        return base;
    }
    if field_at(list_get(toks, pos), 0) != "LBRACKET" {
        return base;
    }
    return base + tc_bracket_type_text(toks, pos);
}
