// # Detect println of three integer literals added
//
// Logline: Returns the decimal sum when a function body is only println of INT plus INT plus INT.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT PLUS INT PLUS INT ) with optional semicolon, then RBRACE.
//   3. Return the sum as decimal text. IDENT operands miss.
//
// residual: runtime IDENT add stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wa3_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wa3_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn wasm_fn_println_add3(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 {
        return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wa3_kind(toks, i) == "KW_FN" && wa3_kind(toks, i + 1) == "IDENT" {
            if wa3_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wa3_kind(toks, p) != "LBRACE" {
                    p = p + 1;
                }
                if p >= n {
                    return "";
                }
                p = p + 1;
                if p + 7 >= n {
                    return "";
                }
                if wa3_kind(toks, p) != "IDENT" || wa3_text(toks, p) != "println" {
                    return "";
                }
                if wa3_kind(toks, p + 1) != "LPAREN" {
                    return "";
                }
                if wa3_kind(toks, p + 2) != "INT" || wa3_kind(toks, p + 3) != "PLUS" {
                    return "";
                }
                if wa3_kind(toks, p + 4) != "INT" || wa3_kind(toks, p + 5) != "PLUS" {
                    return "";
                }
                if wa3_kind(toks, p + 6) != "INT" || wa3_kind(toks, p + 7) != "RPAREN" {
                    return "";
                }
                let a: Int = parse_int(wa3_text(toks, p + 2));
                let b: Int = parse_int(wa3_text(toks, p + 4));
                let c: Int = parse_int(wa3_text(toks, p + 6));
                let sum: Int = a + b + c;
                p = p + 8;
                if p < n && wa3_kind(toks, p) == "SEMI" {
                    p = p + 1;
                }
                if p < n && wa3_kind(toks, p) == "RBRACE" {
                    return sum.to_string();
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
