// # Detect println of three integer literals added
//
// Logline: Returns the decimal sum when a function body is only println of INT|IDENT plus INT|IDENT plus INT|IDENT.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept only println ( INT|IDENT PLUS INT|IDENT PLUS INT|IDENT ) with optional semicolon, then RBRACE.
//   3. Return the sum as decimal text. IDENT resolved via let INT lookup.
//
// residual: runtime add stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wa3_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn wa3_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn wa3_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if wa3_kind(toks, p) == "KW_LET" && wa3_kind(toks, p + 1) == "IDENT" && wa3_text(toks, p + 1) == name && wa3_kind(toks, p + 2) == "EQ" && wa3_kind(toks, p + 3) == "INT" { return wa3_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn wa3_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if wa3_kind(toks, pos) == "INT" { return wa3_text(toks, pos); }
    if wa3_kind(toks, pos) == "IDENT" {
        let name: String = wa3_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && wa3_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return wa3_int_let(toks, lb, pos, name);
    }
    return "";
}
fn wa3_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if wa3_kind(toks, i) == "KW_FN" && wa3_kind(toks, i + 1) == "IDENT" && wa3_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn wa3_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && wa3_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && wa3_kind(toks, p) == "KW_LET" {
        while p < n && wa3_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && wa3_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_println_add3(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = wa3_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = wa3_p(toks, n, f + 2);
    if p0 < 0 || p0 + 7 >= n { return ""; }
    if wa3_kind(toks, p0) != "IDENT" || wa3_text(toks, p0) != "println" { return ""; }
    if wa3_kind(toks, p0 + 1) != "LPAREN" { return ""; }
    let a: String = wa3_int_val(toks, p0 + 2, n);
    if chars_len(a) <= 0 { return ""; }
    if wa3_kind(toks, p0 + 3) != "PLUS" { return ""; }
    let b: String = wa3_int_val(toks, p0 + 4, n);
    if chars_len(b) <= 0 { return ""; }
    if wa3_kind(toks, p0 + 5) != "PLUS" { return ""; }
    let c: String = wa3_int_val(toks, p0 + 6, n);
    if chars_len(c) <= 0 { return ""; }
    if wa3_kind(toks, p0 + 7) != "RPAREN" { return ""; }
    let sum: Int = parse_int(a) + parse_int(b) + parse_int(c);
    let mut p: Int = p0 + 8;
    if p < n && wa3_kind(toks, p) == "SEMI" { p = p + 1; }
    if p < n && wa3_kind(toks, p) == "RBRACE" { return sum.to_string(); }
    return "";
}
