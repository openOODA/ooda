// # Metamorphic Compilation Pass Driver
//
// Logline: Orchestrates metamorphic instruction substitution, register permutation, opaque predicate injection, and scheduling jitter.
//
// Setup: Unified metamorphic binary diversification driver for native code generation.
//
// Beats:
//   1. Apply multi-stage metamorphic pipeline over instruction streams.
//   2. Report diversification metrics and mutation counts.
//   3. Preserve binary semantic equivalence while breaking static signatures.
// RULES.oot 1.7: Under 256 lines.

import "meta_insn_subst.oo";
import "meta_reg_permute.oo";
import "meta_opaque_pred.oo";
import "meta_sched_jitter.oo";

pub fn meta_drive_pass_run(stream: List[String], seed: Int) -> List[String] {
    let s1: List[String] = meta_insn_subst_zeroing(stream, seed);
    let s2: List[String] = meta_insn_subst_arith(s1);
    let s3: List[String] = meta_sched_jitter_apply(s2, seed);
    return s3;
}

pub fn meta_drive_pass_count_mutations(orig: List[String], mut_stream: List[String]) -> Int {
    let n1: Int = list_len(orig);
    let n2: Int = list_len(mut_stream);
    let mut diff: Int = n2 - n1;
    if diff < 0 { diff = 0 - diff; }
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < n1 && i < n2 {
        if list_get(orig, i) != list_get(mut_stream, i) {
            changed = changed + 1;
        }
        i = i + 1;
    }
    return changed + diff;
}
