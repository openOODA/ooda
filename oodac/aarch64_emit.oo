// # Emit Linux AArch64 GAS assembly
//
// Logline: Harvests println string literals from fn main only and writes freestanding AArch64 .s.
//
// Setup: tokenize_lines and aarch64_emit_linux exist. This file does not import x86, wasm, llvm, or c_emit.
//
// Beats:
//   1. Tokenize the source and require fn main.
//   2. Collect println("...") literals only inside the main body.
//   3. Refuse leftover println forms and write the Linux AArch64 program.
//
// residual: greet fold, ident binds, const int, ALU, and product oodac dispatch stay later.

import "token_fmt.oo";
import "aarch64_emit_sys.oo";

fn a64_k(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn a64_t(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn a64_println_ok(toks: List[String], n: Int, i: Int) -> Bool {
    if i > 0 && a64_k(toks, i - 1) == "DOT" {
        return false;
    }
    let mut j = i + 1;
    if j < n && a64_k(toks, j) == "LPAREN" {
        j = j + 1;
    } else {
        return false;
    }
    if j < n && a64_k(toks, j) == "STRING" {
        if j + 1 < n && a64_k(toks, j + 1) == "RPAREN" {
            return true;
        }
    }
    return false;
}

fn a64_println_text(toks: List[String], n: Int, i: Int) -> String {
    let mut j = i + 1;
    if j < n && a64_k(toks, j) == "LPAREN" {
        j = j + 1;
    }
    if j < n && a64_k(toks, j) == "STRING" {
        return a64_t(toks, j);
    }
    return "";
}

fn a64_collect_prints(toks: List[String]) -> List[String] {
    let n = list_len(toks);
    let mut msgs: List[String] = list_new();
    let mut saw_main = false;
    let mut leftover = false;
    let mut await_main_brace = false;
    let mut in_main = false;
    let mut depth = 0;
    let mut i = 0;
    while i < n {
        let k: String = a64_k(toks, i);
        if k == "KW_FN" {
            if i + 1 < n && a64_k(toks, i + 1) == "IDENT" {
                if a64_t(toks, i + 1) == "main" {
                    saw_main = true;
                    await_main_brace = true;
                }
            }
        }
        if await_main_brace && k == "LBRACE" {
            in_main = true;
            depth = 1;
            await_main_brace = false;
            i = i + 1;
        } else {
            if in_main {
                if k == "LBRACE" {
                    depth = depth + 1;
                }
                if k == "RBRACE" {
                    depth = depth - 1;
                    if depth <= 0 {
                        in_main = false;
                        depth = 0;
                    }
                }
            }
            if k == "IDENT" && a64_t(toks, i) == "println" {
                if in_main && a64_println_ok(toks, n, i) {
                    msgs = list_push(msgs, a64_println_text(toks, n, i));
                } else {
                    leftover = true;
                }
            }
            i = i + 1;
        }
    }
    if !saw_main {
        println("ERR\taarch64_emit\tresidual: need fn main");
        process_exit(1);
    }
    if leftover {
        println("ERR\taarch64_emit\tleftover println");
        process_exit(1);
    }
    if list_len(msgs) < 1 {
        println("ERR\taarch64_emit\tresidual: need println(\"...\") (not emit-c)");
        process_exit(1);
    }
    return msgs;
}

pub fn aarch64_emit_stream(src: String) {
    if chars_len(src) == 0 {
        println("ERR\taarch64_emit\tempty");
        process_exit(1);
    }
    let toks: List[String] = tokenize_lines(src);
    let msgs: List[String] = a64_collect_prints(toks);
    aarch64_emit_linux(msgs);
}
