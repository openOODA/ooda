// # Generate contract-fuzzer values
//
// Logline: Steps a deterministic LCG and builds Int, Bool, String, and List[Int] values from a seed.
//
// Setup: chars_len, char_at, list_new, and list_push exist; callers pass a seed and domain bounds.
//
// Beats:
//   1. prng_step maps 0 to 42 then does LCG and returns a nonnegative 31-bit state.
//   2. gen_int_val hits min, max, 0, or a remainder in the span; gen_bool_val is the parity of one step.
//   3. gen_string_val and gen_list_int_val pick a length from the seed and fill alphanumerics or ints.

pub fn prng_step(st: Int) -> Int {
    let mut s = st;
    if s == 0 { s = 42; }
    let raw = s * 1103515245 + 12345;
    let next_st = raw - (raw / 2147483648) * 2147483648;
    if next_st < 0 { return -next_st; }
    return next_st;
}

pub fn gen_int_val(st: Int, min_v: Int, max_v: Int) -> Int {
    let abs_raw = 0 + prng_step(st);
    let choice = abs_raw - (abs_raw / 10) * 10;
    if choice == 0 { return min_v; }
    if choice == 1 { return max_v; }
    if choice == 2 && min_v <= 0 && max_v >= 0 { return 0; }
    let span = max_v - min_v + 1;
    if span <= 0 { return min_v; }
    let rem = abs_raw - (abs_raw / span) * span;
    return min_v + rem;
}

pub fn gen_bool_val(st: Int) -> Bool {
    let abs_raw = 0 + prng_step(st);
    let v = abs_raw - (abs_raw / 2) * 2;
    return v != 0;
}

pub fn gen_string_val(st: Int, max_len: Int) -> String {
    let abs_raw = 0 + prng_step(st);
    let mod_span = max_len + 1;
    let len = abs_raw - (abs_raw / mod_span) * mod_span;
    let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    let num_chars = chars_len(chars);
    let mut out_str = "";
    let mut i = 0;
    let mut cur_st = abs_raw;
    while i < len {
        cur_st = prng_step(cur_st);
        let idx = cur_st - (cur_st / num_chars) * num_chars;
        out_str = out_str + char_at(chars, idx);
        i = i + 1;
    }
    return out_str;
}

pub fn gen_list_int_val(st: Int, max_len: Int, min_v: Int, max_v: Int) -> List[Int] {
    let abs_raw = 0 + prng_step(st);
    let mod_span = max_len + 1;
    let len = abs_raw - (abs_raw / mod_span) * mod_span;
    let mut lst: List[Int] = list_new();
    let mut i = 0;
    let mut cur_st = abs_raw;
    while i < len {
        cur_st = prng_step(cur_st);
        lst = list_push(lst, gen_int_val(cur_st, min_v, max_v));
        i = i + 1;
    }
    return lst;
}
