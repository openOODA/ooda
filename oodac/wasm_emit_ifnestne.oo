// # Detect nested const if true println with no else
//
// Logline: Returns the inner STRING when a function body is only if BOOL { if BOOL { println(STRING) } } with no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept outer if KW_TRUE wrapping an inner if KW_TRUE with one println and three RBRACE.
//   3. Return the inner STRING only when both conditions are KW_TRUE. IDENT conditions miss.
//
// residual: nested if x no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn wnsn_kind(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

fn wnsn_text(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

fn wnsn_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if wnsn_kind(toks, p) != "IDENT" || wnsn_text(toks, p) != "println" { return empty; }
    if wnsn_kind(toks, p + 1) != "LPAREN" || wnsn_kind(toks, p + 2) != "STRING" { return empty; }
    if wnsn_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = wnsn_text(toks, p + 2);
    p = p + 4;
    if p < n && wnsn_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}

fn wnsn_is_bool(k: String) -> Bool {
    if k == "KW_TRUE" { return true; }
    if k == "KW_FALSE" { return true; }
    return false;
}

pub fn wasm_fn_if_nest_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 1 < n {
        if wnsn_kind(toks, i) == "KW_FN" && wnsn_kind(toks, i + 1) == "IDENT" {
            if wnsn_text(toks, i + 1) == fname {
                let mut p: Int = i + 2;
                while p < n && wnsn_kind(toks, p) != "LBRACE" { p = p + 1; }
                if p >= n { return ""; }
                p = p + 1;
                if p + 2 >= n || wnsn_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let ok: String = wnsn_kind(toks, p);
                if !wnsn_is_bool(ok) { return ""; }
                let outer_t: Bool = ok == "KW_TRUE";
                p = p + 1;
                if p >= n || wnsn_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                if p + 2 >= n || wnsn_kind(toks, p) != "KW_IF" { return ""; }
                p = p + 1;
                let ik: String = wnsn_kind(toks, p);
                if !wnsn_is_bool(ik) { return ""; }
                let inner_t: Bool = ik == "KW_TRUE";
                p = p + 1;
                if p >= n || wnsn_kind(toks, p) != "LBRACE" { return ""; }
                p = p + 1;
                let th: List[String] = wnsn_one_str_println(toks, p, n);
                if list_len(th) < 2 { return ""; }
                p = parse_int(list_get(th, 1));
                if p >= n || wnsn_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wnsn_kind(toks, p) != "RBRACE" { return ""; }
                p = p + 1;
                if p >= n || wnsn_kind(toks, p) != "RBRACE" { return ""; }
                if outer_t && inner_t { return list_get(th, 0); }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}
