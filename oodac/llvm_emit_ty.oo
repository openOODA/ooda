// # Map Ooda types onto LLVM IR
//
// Logline: Turns an Ooda type name into an LLVM IR type string, identifies floating-point types, and names which types need ARC retain and release.
//
// Setup: chars_len, str_slice, and char_at exist; callers pass names such as Int, Float, String, List[Int], Result, Void, or a struct name.
//
// Beats:
//   1. llvm_ty_map sends ints and capabilities to i64, Float to double, Bool to i32, String to %OoStr, lists and Result to their %Oo types, and Void to void.
//   2. A name that already starts with % is returned as-is; any other name becomes %struct.Name.
//   3. llvm_ty_is_arc is true for %OoStr, %OoIList, and %OoSList; llvm_ty_is_float is true for double.

import "token_fmt.oo";

pub fn llvm_ty_map(t: String) -> String {
    if t == "Int" || t == "int" || t == "long long" || t == "i64" || t == "FsCap" || t == "FsReadCap" || t == "FsWriteCap" || t == "SysCap" || t == "ProcessCap" || t == "EnvCap" || t == "NetCap" || t == "TimeCap" || t == "RandCap" || t == "AllocCap" || t == "GpuCap" || t == "ThreadCap" || t == "ArenaCap" || t == "UnsafeFFICap" {
        return "i64";
    }
    if t == "Float" || t == "float" || t == "f64" || t == "double" {
        return "double";
    }
    if t == "Bool" || t == "bool" || t == "i32" {
        return "i32";
    }
    if t == "String" || t == "str" || t == "OoStr" {
        return "%OoStr";
    }
    if t == "List[Int]" || t == "OoIList" || t == "List" || t == "List[String]" || t == "OoSList" || t == "List[Float]" || t == "OoFList" || t == "List[List[Int]]" || t == "List[List[String]]" || t == "List[List[Float]]" || t == "%OoLL_I" || t == "%OoLL_S" || t == "%OoLL_F" || (chars_len(t) >= 4 && str_slice(t, 0, 4) == "List") {
        return llvm_ty_list(t);
    }
    if t == "Result" || t == "%OoResS" || t == "%OoResI" || t == "%OoResV" || t == "%OoResB" || t == "%OoResF" || t == "%OoResLI" || t == "%OoResLS" || t == "%OoResLF" || (chars_len(t) >= 6 && str_slice(t, 0, 6) == "Result") {
        return llvm_ty_result(t);
    }
    if t == "Option" || (chars_len(t) >= 6 && str_slice(t, 0, 6) == "Option") {
        return llvm_ty_option(t);
    }
    if t == "Void" || t == "void" { return "void"; }
    if t == "" { return "i64"; }
    if chars_len(t) >= 4 && str_slice(t, 0, 4) == "dyn " {
        return "%dyn." + str_slice(t, 4, chars_len(t));
    }
    if chars_len(t) > 0 && (char_at(t, 0) == "%" || char_at(t, 0) == "<") { return t; }
    return "%struct." + t;
}

pub fn llvm_ty_is_arc(t: String) -> Bool {
    let lty: String = llvm_ty_map(t);
    return lty == "%OoStr" || lty == "%OoIList" || lty == "%OoSList" || lty == "%OoFList" || lty == "%OoLL_I" || lty == "%OoLL_S" || lty == "%OoLL_F";
}

pub fn llvm_ty_list(t: String) -> String {
    if t == "List[Int]" || t == "OoIList" || t == "List" { return "%OoIList"; }
    if t == "List[String]" || t == "OoSList" { return "%OoSList"; }
    if t == "List[Float]" || t == "OoFList" { return "%OoFList"; }
    if t == "List[List[Int]]" || t == "%OoLL_I" || t == "OoLL_I" { return "%OoLL_I"; }
    if t == "List[List[String]]" || t == "%OoLL_S" || t == "OoLL_S" { return "%OoLL_S"; }
    if t == "List[List[Float]]" || t == "%OoLL_F" || t == "OoLL_F" { return "%OoLL_F"; }
    if chars_len(t) >= 10 && str_slice(t, 0, 10) == "List[List[" {
        println("ERR\tllvm_emit\tList residual");
        process_exit(1);
        return "";
    }
    if chars_len(t) >= 6 && str_slice(t, 0, 5) == "List[" {
        let inner: String = str_slice(t, 5, chars_len(t) - 1);
        if inner != "Int" && inner != "String" && inner != "Float" && inner != "Bool" && inner != "Void" {
            if chars_len(inner) < 4 || str_slice(inner, 0, 4) != "List" {
                return "%OoL." + inner;
            }
        }
    }
    if chars_len(t) >= 5 && str_slice(t, 0, 5) == "%OoL." {
        return t;
    }
    if chars_len(t) >= 4 && str_slice(t, 0, 4) == "List" {
        return "%OoSList";
    }
    return t;
}

pub fn llvm_ty_is_olist(t: String) -> Bool {
    if chars_len(t) >= 6 {
        if str_slice(t, 0, 5) == "%OoL." { return true; }
    }
    return false;
}

pub fn llvm_ty_is_list(t: String) -> Bool {
    return t == "%OoIList" || t == "%OoSList" || t == "%OoFList" || t == "%OoLL_I" || t == "%OoLL_S" || t == "%OoLL_F" || llvm_ty_is_olist(t);
}

pub fn llvm_ty_is_float(t: String) -> Bool {
    let lty: String = llvm_ty_map(t);
    return lty == "double";
}

pub fn llvm_ty_result(t: String) -> String {
    if t == "%OoResI" { return "%OoResI"; }
    if t == "%OoResB" { return "%OoResB"; }
    if t == "%OoResF" { return "%OoResF"; }
    if t == "%OoResV" { return "%OoResV"; }
    if t == "%OoResS" || t == "Result" { return "%OoResS"; }
    if t == "%OoResLI" { return "%OoResLI"; }
    if t == "%OoResLS" { return "%OoResLS"; }
    if t == "%OoResLF" { return "%OoResLF"; }
    if t == "Result[Int]" || t == "Result[Int,String]" || t == "Result[Int, String]" {
        return "%OoResI";
    }
    if t == "Result[Bool]" || t == "Result[Bool,String]" || t == "Result[Bool, String]" {
        return "%OoResB";
    }
    if t == "Result[Float]" || t == "Result[Float,String]" || t == "Result[Float, String]" {
        return "%OoResF";
    }
    if t == "Result[String]" || t == "Result[String,String]" || t == "Result[String, String]" {
        return "%OoResS";
    }
    if t == "Result[Void]" || t == "Result[Void,String]" || t == "Result[Void, String]" {
        return "%OoResV";
    }
    if t == "Result[List[Int]]" || t == "Result[List[Int],String]" || t == "Result[List[Int], String]" {
        return "%OoResLI";
    }
    if t == "Result[List[String]]" || t == "Result[List[String],String]" || t == "Result[List[String], String]" {
        return "%OoResLS";
    }
    if t == "Result[List[Float]]" || t == "Result[List[Float],String]" || t == "Result[List[Float], String]" {
        return "%OoResLF";
    }
    if chars_len(t) >= 7 && str_slice(t, 0, 7) == "%OoRes." {
        return t;
    }
    if chars_len(t) >= 7 && str_slice(t, 0, 7) == "Result[" {
        return llvm_ty_result_user(t);
    }
    println("ERR\tllvm_emit\tResult residual");
    process_exit(1);
    return "";
}

pub fn llvm_ty_result_user(t: String) -> String {
    let inner: String = str_slice(t, 7, chars_len(t) - 1);
    if chars_len(inner) >= 4 && str_slice(inner, 0, 4) == "List" {
        println("ERR\tllvm_emit\tResult residual");
        process_exit(1);
        return "";
    }
    let mut uname: String = inner;
    let n: Int = chars_len(inner);
    let mut i: Int = 0;
    while i < n {
        if char_at(inner, i) == "," {
            uname = str_slice(inner, 0, i);
            i = n;
        }
        i = i + 1;
    }
    if uname == "" || uname == "Int" || uname == "Bool" || uname == "Float" || uname == "String" || uname == "Void" {
        println("ERR\tllvm_emit\tResult residual");
        process_exit(1);
        return "";
    }
    return "%OoRes." + uname;
}

pub fn llvm_ty_option(t: String) -> String {
    if t == "Option[Int]" || t == "Option[int]" {
        return "%OoResI";
    }
    if t == "Option[String]" || t == "Option[str]" {
        return "%OoResS";
    }
    if t == "Option[Bool]" || t == "Option[bool]" {
        return "%OoResB";
    }
    if t == "Option[Float]" || t == "Option[float]" {
        return "%OoResF";
    }
    println("ERR\tllvm_emit\tOption residual");
    process_exit(1);
    return "";
}

pub fn llvm_ty_ok_res(expect: String, payload_ty: String) -> String {
    let mut kind: String = expect;
    if chars_len(kind) >= 7 && str_slice(kind, 0, 7) == "%OoRes." {
        return kind;
    }
    if kind != "%OoResI" && kind != "%OoResB" && kind != "%OoResF" && kind != "%OoResS" && kind != "%OoResV" && kind != "%OoResLI" && kind != "%OoResLS" && kind != "%OoResLF" && kind != "" {
        if kind == "Result" || (chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "Result") {
            kind = llvm_ty_result(kind);
        } else if kind == "Option" || (chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "Option") {
            kind = llvm_ty_option(kind);
        }
    }
    if kind == "%OoResI" || kind == "%OoResB" || kind == "%OoResF" || kind == "%OoResS" || kind == "%OoResV" || kind == "%OoResLI" || kind == "%OoResLS" || kind == "%OoResLF" {
        return kind;
    }
    if payload_ty == "i64" { return "%OoResI"; }
    if payload_ty == "i32" { return "%OoResB"; }
    if payload_ty == "double" { return "%OoResF"; }
    if payload_ty == "%OoStr" { return "%OoResS"; }
    if payload_ty == "%OoIList" { return "%OoResLI"; }
    if payload_ty == "%OoSList" { return "%OoResLS"; }
    if payload_ty == "%OoFList" { return "%OoResLF"; }
    if chars_len(payload_ty) >= 8 && str_slice(payload_ty, 0, 8) == "%struct." {
        return "%OoRes." + str_slice(payload_ty, 8, chars_len(payload_ty));
    }
    if kind != "" { return llvm_ty_result(kind); }
    println("ERR\tllvm_emit\tOk/Err residual");
    process_exit(1);
    return "";
}

pub fn llvm_ty_eat_generic(base: String, toks: List[String], pos: Int, n: Int) -> List[String] {
    let mut p = pos;
    let mut ty: String = base;
    let mut out: List[String] = list_new();
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACKET" {
        out = list_push(out, p.to_string());
        out = list_push(out, ty);
        return out;
    }
    p = p + 1;
    let mut inner: String = "";
    if p < n && (field_at(list_get(toks, p), 0) == "IDENT" || field_at(list_get(toks, p), 0) == "KW_TYPE") {
        inner = field_at(list_get(toks, p), 3);
        p = p + 1;
    }
    if inner != "" && p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        p = p + 1;
        if p < n && (field_at(list_get(toks, p), 0) == "IDENT" || field_at(list_get(toks, p), 0) == "KW_TYPE") {
            inner = inner + "[" + field_at(list_get(toks, p), 3) + "]";
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RBRACKET" { p = p + 1; }
    }
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
        p = p + 1;
        if p < n && (field_at(list_get(toks, p), 0) == "IDENT" || field_at(list_get(toks, p), 0) == "KW_TYPE") {
            inner = inner + ", " + field_at(list_get(toks, p), 3);
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RBRACKET" { p = p + 1; }
    if inner != "" { ty = base + "[" + inner + "]"; }
    out = list_push(out, p.to_string());
    out = list_push(out, ty);
    return out;
}
