// # Detect const if INT==INT println with no else
//
// Logline: Returns the then STRING when a function body is only if INT|IDENT EQEQ INT|IDENT with one println(STRING) and no else.
//
// Setup: tokenize_lines, field_at, and parse_int exist. fname is the user function name.
//
// Beats:
//   1. Find KW_FN plus IDENT fname and skip to the body brace.
//   2. Accept if INT|IDENT EQEQ INT|IDENT then one println(STRING) branch and the function RBRACE.
//   3. Return the then STRING only when left equals right. IDENT resolved via let INT lookup.
//
// residual: unequal no-else stays dummy end.

import "token_fmt.oo";
import "tc_parse_int.oo";

fn weqn_kind(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 0); }
fn weqn_text(toks: List[String], i: Int) -> String { return field_at(list_get(toks, i), 3); }
fn weqn_int_let(toks: List[String], lb: Int, lim: Int, name: String) -> String {
    let mut p: Int = lb + 1;
    while p + 3 < lim {
        if weqn_kind(toks, p) == "KW_LET" && weqn_kind(toks, p + 1) == "IDENT" && weqn_text(toks, p + 1) == name && weqn_kind(toks, p + 2) == "EQ" && weqn_kind(toks, p + 3) == "INT" { return weqn_text(toks, p + 3); }
        p = p + 1;
    }
    return "";
}
fn weqn_int_val(toks: List[String], pos: Int, n: Int) -> String {
    if pos < 0 || pos >= n { return ""; }
    if weqn_kind(toks, pos) == "INT" { return weqn_text(toks, pos); }
    if weqn_kind(toks, pos) == "IDENT" {
        let name: String = weqn_text(toks, pos);
        let mut lb: Int = pos;
        while lb >= 0 && weqn_kind(toks, lb) != "LBRACE" { lb = lb - 1; }
        if lb < 0 { return ""; }
        return weqn_int_let(toks, lb, pos, name);
    }
    return "";
}
fn weqn_one_str_println(toks: List[String], p0: Int, n: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut p = p0;
    if p + 3 >= n { return empty; }
    if weqn_kind(toks, p) != "IDENT" || weqn_text(toks, p) != "println" { return empty; }
    if weqn_kind(toks, p + 1) != "LPAREN" || weqn_kind(toks, p + 2) != "STRING" { return empty; }
    if weqn_kind(toks, p + 3) != "RPAREN" { return empty; }
    let lit: String = weqn_text(toks, p + 2);
    p = p + 4;
    if p < n && weqn_kind(toks, p) == "SEMI" { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, lit);
    out = list_push(out, p.to_string());
    return out;
}
fn weqn_find(toks: List[String], n: Int, fname: String) -> Int {
    let mut i: Int = 0;
    while i + 1 < n {
        if weqn_kind(toks, i) == "KW_FN" && weqn_kind(toks, i + 1) == "IDENT" && weqn_text(toks, i + 1) == fname { return i; }
        i = i + 1;
    }
    return -1;
}
fn weqn_p(toks: List[String], n: Int, start: Int) -> Int {
    let mut p: Int = start;
    while p < n && weqn_kind(toks, p) != "LBRACE" { p = p + 1; }
    if p >= n { return -1; }
    p = p + 1;
    while p + 3 < n && weqn_kind(toks, p) == "KW_LET" {
        while p < n && weqn_kind(toks, p) != "SEMI" { p = p + 1; }
        if p < n && weqn_kind(toks, p) == "SEMI" { p = p + 1; }
    }
    return p;
}

pub fn wasm_fn_if_eq_noelse(src: String, fname: String) -> String {
    if chars_len(src) <= 0 || chars_len(fname) <= 0 { return ""; }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let f: Int = weqn_find(toks, n, fname);
    if f < 0 { return ""; }
    let p0: Int = weqn_p(toks, n, f + 2);
    if p0 < 0 || p0 + 4 >= n { return ""; }
    if weqn_kind(toks, p0) != "KW_IF" { return ""; }
    let ls: String = weqn_int_val(toks, p0 + 1, n);
    if chars_len(ls) <= 0 { return ""; }
    if weqn_kind(toks, p0 + 2) != "EQEQ" { return ""; }
    let rs: String = weqn_int_val(toks, p0 + 3, n);
    if chars_len(rs) <= 0 { return ""; }
    if weqn_kind(toks, p0 + 4) != "LBRACE" { return ""; }
    let left: Int = parse_int(ls);
    let right: Int = parse_int(rs);
    let th: List[String] = weqn_one_str_println(toks, p0 + 5, n);
    if list_len(th) < 2 { return ""; }
    let mut p: Int = parse_int(list_get(th, 1));
    if p >= n || weqn_kind(toks, p) != "RBRACE" { return ""; }
    p = p + 1;
    if p >= n || weqn_kind(toks, p) != "RBRACE" { return ""; }
    if left == right { return list_get(th, 0); }
    return "";
}
