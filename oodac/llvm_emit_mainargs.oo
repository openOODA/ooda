// # Fill LLVM main args from argv
//
// Logline: After alloca of main's args slot, construct an OoSList from sys_argv[1..argc].
//
// Setup: Called from llvm_emit_fn when the param is args or argv. %sys_argc and %sys_argv are live.
//
// Beats:
//   1. sret oo_slist_new into %name.slot.
//   2. Loop i from 1 to argc-1, oo_str_lit each argv[i], slist_push.

pub fn llvm_emit_main_args(pn: String) {
    println("  call void @oo_slist_new(%OoSList* sret(%OoSList) %" + pn + ".slot)");
    println("  %" + pn + ".ai = alloca i32, align 4");
    println("  store i32 1, i32* %" + pn + ".ai, align 4");
    println("  br label %" + pn + ".args_loop");
    println(pn + ".args_loop:");
    println("  %" + pn + ".aiv = load i32, i32* %" + pn + ".ai, align 4");
    println("  %" + pn + ".more = icmp slt i32 %" + pn + ".aiv, %sys_argc");
    println("  br i1 %" + pn + ".more, label %" + pn + ".args_body, label %" + pn + ".args_done");
    println(pn + ".args_body:");
    println("  %" + pn + ".ai64 = sext i32 %" + pn + ".aiv to i64");
    println("  %" + pn + ".ap = getelementptr inbounds i8*, i8** %sys_argv, i64 %" + pn + ".ai64");
    println("  %" + pn + ".cstr = load i8*, i8** %" + pn + ".ap, align 8");
    println("  %" + pn + ".astr = call %OoStr @oo_str_lit(i8* %" + pn + ".cstr)");
    println("  %" + pn + ".in = alloca %OoSList, align 8");
    println("  %" + pn + ".cur = load %OoSList, %OoSList* %" + pn + ".slot, align 8");
    println("  store %OoSList %" + pn + ".cur, %OoSList* %" + pn + ".in, align 8");
    println("  %" + pn + ".out = alloca %OoSList, align 8");
    println("  call void @oo_slist_push(%OoSList* sret(%OoSList) %" + pn + ".out, %OoSList* byval(%OoSList) %" + pn + ".in, %OoStr %" + pn + ".astr)");
    println("  %" + pn + ".nxt = load %OoSList, %OoSList* %" + pn + ".out, align 8");
    println("  store %OoSList %" + pn + ".nxt, %OoSList* %" + pn + ".slot, align 8");
    println("  %" + pn + ".ain = add i32 %" + pn + ".aiv, 1");
    println("  store i32 %" + pn + ".ain, i32* %" + pn + ".ai, align 4");
    println("  br label %" + pn + ".args_loop");
    println(pn + ".args_done:");
}
