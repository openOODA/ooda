// # Emit C typedefs for type aliases
//
// Logline: Map type Name = struct {..} and simple aliases to C typedefs, and extract a struct-lit type name from a cast.
//
// Setup: field_at, list_get, skip_until_semi, c_peek_list_elem, c_emit_skip_type, c_emit_skip_braces, chars_len, char_at, and byte_at exist.
//
// Beats:
//   1. c_struct_field_c_ty maps String, Int, Bool, Float, List, Result, and user names to C types.
//   2. c_emit_one_type_alias prints typedef struct Name { fields } Name; List[user] gets OoL_* first; c_emit_seen_ty / c_emit_mark_ty dedupe typedefs across files.
//   3. c_emit_type_aliases walks top-level KW_TYPE with a hang guard; c_struct_lit_ty_name reads ((Name){...}).
//
// residual: no List[List[T]]; no &mut T product; not full generics

// Map field type tokens at pos → C field type (Int/String/List/user).
pub fn c_struct_field_c_ty(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "long long";
    }
    if c_tokk(toks, pos) == "AMP" {
        return "long long";
    }
    if c_tokk(toks, pos) != "IDENT" {
        return "long long";
    }
    let tn: String = c_tokt(toks, pos);
    if tn == "String" {
        return "OoStr";
    }
    if tn == "Int" || tn == "Bool" {
        return "long long";
    }
    if tn == "Float" || tn == "f64" {
        return "double";
    }
    if tn == "List" {
        return c_list_kind_c_ty(c_peek_list_elem2(toks, pos, n));
    }
    if tn == "Result" {
        return c_result_c_ty(toks, pos, n);
    }
    // user type name / alias (must have been emitted earlier or is Int alias)
    return tn;
}

// Emit one `type Name = ...;` as C typedef. pos at KW_TYPE. Returns [new_pos, seen_state].
pub fn c_emit_one_type_alias(toks: List[String], pos: Int, n: Int, seen_state: String) -> List[String] {
    let mut seen: String = seen_state;
    let mut p: Int = pos;
    if p < n && c_tokk(toks, p) == "KW_TYPE" { p = p + 1; }
    if p >= n || c_tokk(toks, p) != "IDENT" { return list_push(list_push(list_new(), skip_until_semi(toks, pos).to_string()), seen); }
    let name: String = c_tokt(toks, p);
    if c_emit_seen_ty(seen, name) { return list_push(list_push(list_new(), skip_until_semi(toks, pos).to_string()), seen); }
    seen = c_emit_mark_ty(seen, name);
    p = p + 1;
    if p < n && c_tokk(toks, p) == "EQ" { p = p + 1; }
    // type Name = struct { f: T, ... };
    if p < n && c_tokk(toks, p) == "IDENT" && c_tokt(toks, p) == "struct" {
        p = p + 1;
        if p < n && c_tokk(toks, p) == "LBRACE" { p = p + 1; }
        let mut body: String = "";
        let mut retain: String = "";
        let mut first: Bool = true;
        while p < n && c_tokk(toks, p) != "RBRACE" {
            if c_tokk(toks, p) == "COMMA" { p = p + 1; }
            if p >= n || c_tokk(toks, p) != "IDENT" { break; }
            let fname: String = c_tokt(toks, p);
            p = p + 1;
            if p < n && c_tokk(toks, p) == "COLON" { p = p + 1; }
            // C type text (String) — M169 :Int mistype forced long long vs OoStr on pure dual
            let fty: String = c_struct_field_c_ty(toks, p, n);
            if p < n && c_tokk(toks, p) == "IDENT" { if c_tokt(toks, p) == "List" { c_emit_olist_prep(name, c_peek_list_elem(toks, p, n)); } }
            p = c_emit_skip_type(toks, p, n);
            if first {
                body = fty + " " + fname + ";";
                first = false;
            } else {
                body = body + " " + fty + " " + fname + ";";
            }
            if fty == "OoStr" { retain = retain + " oo_str_retain(v." + fname + ");"; }
            if fty == "OoSList" { retain = retain + " oo_slist_retain(v." + fname + ");"; }
            if fty == "OoIList" { retain = retain + " oo_ilist_retain(v." + fname + ");"; }
        }
        if p < n && c_tokk(toks, p) == "RBRACE" { p = p + 1; }
        if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
        println("#ifndef OO_TY_" + name);
        println("#define OO_TY_" + name);
        println("typedef struct " + name + " { " + body + " } " + name + ";");
        println("static void oo_retain_" + name + "(" + name + " v) {" + retain + " }");
        println("#ifndef OO_TY_RES_" + name);
        println("#define OO_TY_RES_" + name);
        println("typedef struct { int ok; " + name + " val; OoStr err; } OoRes_" + name + ";");
        println("#endif");
        println("#endif");
        c_emit_olist_helpers(name);
        return list_push(list_push(list_new(), p.to_string()), seen);
    }
    let after_sum: Int = c_try_emit_sum_alias(toks, p, n, name);
    if after_sum != p { return list_push(list_push(list_new(), after_sum.to_string()), seen); }
    // type Name = Int | String | Float | List[...] | Other
    let simple: String = c_struct_field_c_ty(toks, p, n);
    // avoid `typedef Point Point` for unresolved self — use long long fallback only if empty
    let mut cty: String = simple;
    if cty == name { cty = "long long"; }
    println("#ifndef OO_TY_" + name);
    println("#define OO_TY_" + name);
    println("typedef " + cty + " " + name + ";");
    println("#ifndef OO_TY_RES_" + name);
    println("#define OO_TY_RES_" + name);
    println("typedef struct { int ok; " + name + " val; OoStr err; } OoRes_" + name + ";");
    println("#endif");
    println("#endif");
    return list_push(list_push(list_new(), skip_until_semi(toks, pos).to_string()), seen);
}

// Emit all top-level type aliases before functions.
pub fn c_emit_type_aliases(toks: List[String]) {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    let mut seen: String = "";
    let mut iter: Int = 0;
    while i < n {
        iter = iter + 1;
        if iter > n + 100 {
            println("ERR\tc_emit\thang guard exceeded at pos " + i.to_string());
            process_exit(1);
        }
        let prev: Int = i;
        let k: String = c_tokk(toks, i);
        let mut pub_ty: Bool = k == "KW_PUB" && i + 1 < n && c_tokk(toks, i + 1) == "KW_TYPE";
        if k == "KW_TYPE" {
            let r: List[String] = c_emit_one_type_alias(toks, i, n, seen);
            i = parse_int(list_get(r, 0));
            seen = list_get(r, 1);
        } else if pub_ty {
            let r: List[String] = c_emit_one_type_alias(toks, i + 1, n, seen);
            i = parse_int(list_get(r, 0));
            seen = list_get(r, 1);
        } else if k == "KW_FN" || k == "KW_PUB" {
            // Prototype `fn greet();` must not swallow the next type's `{`.
            i = i + 1;
            while i < n {
                let kk: String = c_tokk(toks, i);
                if kk == "SEMI" { i = i + 1; break; }
                if kk == "LBRACE" { i = c_emit_skip_braces(toks, i, n); break; }
                if kk == "KW_TYPE" || kk == "EOF" { break; }
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
        if i == prev {
            println("ERR\tc_emit\tno progress at KW_TYPE");
            process_exit(1);
        }
    }
}

// Extract type name from struct-lit C text: ((Name){ ... })
// Only [A-Za-z0-9_] — do not treat `((a * 7LL)+…)` as type name (pure dual-green).
pub fn c_struct_lit_ty_name(rhs: String) -> String {
    if chars_len(rhs) < 6 {
        return "";
    }
    if char_at(rhs, 0) != "(" || char_at(rhs, 1) != "(" {
        return "";
    }
    let mut i: Int = 2;
    let n: Int = chars_len(rhs);
    let mut name: String = "";
    while i < n {
        let c: String = char_at(rhs, i);
        if c == ")" {
            break;
        }
        if c == " " {
            i = i + 1;
        } else {
            // identifier only; operators mean this is not a struct lit cast
            // Use byte_at (Int) for ranges — String `c >= "A"` does not lower to C.
            let b: Int = byte_at(c, 0);
            let mut ok: Bool = false;
            if c == "_" { ok = true; }
            if b >= 65 && b <= 90 { ok = true; }
            if b >= 97 && b <= 122 { ok = true; }
            if b >= 48 && b <= 57 { ok = true; }
            if !ok {
                return "";
            }
            name = name + c;
            i = i + 1;
        }
    }
    if chars_len(name) < 1 {
        return "";
    }
    let first_b: Int = byte_at(char_at(name, 0), 0);
    if first_b < 65 || first_b > 90 {
        return "";
    }
    if i < n && char_at(rhs, i) == ")" {
        i = i + 1;
        while i < n && char_at(rhs, i) == " " {
            i = i + 1;
        }
        if i >= n || char_at(rhs, i) != "{" {
            return "";
        }
    } else {
        return "";
    }
    return name;
}

// Is name in space-separated seen set? State form: " name1 name2 ... " (with boundary spaces).
pub fn c_emit_seen_ty(state: String, name: String) -> Bool {
    let n: String = " " + name + " ";
    let hn: Int = chars_len(state);
    let nn: Int = chars_len(n);
    let mut i: Int = 0;
    while i <= hn - nn {
        let mut ok: Bool = true;
        let mut j: Int = 0;
        while j < nn && ok {
            if char_at(state, i + j) != char_at(n, j) { ok = false; } else { j = j + 1; }
        }
        if ok { return true; }
        i = i + 1;
    }
    return false;
}

// Add name to seen set (idempotent); returns new state in " n1 n2 ... " form.
pub fn c_emit_mark_ty(state: String, name: String) -> String {
    if c_emit_seen_ty(state, name) { return state; }
    return state + " " + name + " ";
}
