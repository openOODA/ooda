// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: untyped bind type inference helpers split from c_emit_let
// stage: emit
// M167: free-name short-circuit before mega c_call_result_ty (stale hosts SEGV)

pub fn c_emit_let_untyped_ty(rhs: String, e: String) -> List[String] {
    let mut lty: String = "long long";
    let mut bind_kind: String = "";
    let mut crt: String = "";
    let mut is_num: Bool = false;
    if chars_len(rhs) > 0 {
        let c0: String = char_at(rhs, 0);
        if c0 == "-" || c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
            is_num = true;
        }
        if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
            is_num = true;
        }
    }
    // oo_str_lit/concat prefix, or nested concat anywhere
    let mut is_str_expr: Bool = false;
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
            if char_at(rhs, 7) == "l" || char_at(rhs, 7) == "c" { is_str_expr = true; }
        }
    }
    if !is_str_expr && chars_len(rhs) >= 13 && rhs.contains("oo_str_concat") {
        is_str_expr = true;
    }
    if is_num && rhs.contains(".") {
        lty = "double";
        bind_kind = "F";
    } else if is_num {
        lty = "long long";
    } else if is_str_expr {
        lty = "OoStr";
        bind_kind = "T";
    } else {
        let cnm: String = c_rhs_call_name(rhs);
        if cnm == "list_new" || cnm == "oo_ilist_new"
            || cnm == "bytes_new" || cnm == "oo_bytes_new"
            || cnm == "list_push" || cnm == "oo_ilist_push"
            || cnm == "bytes_push" || cnm == "oo_bytes_push" {
            crt = "OoIList";
        }
        if cnm == "bytes_get" || cnm == "oo_bytes_get" {
            crt = "long long";
        }
        if cnm == "bytes_to_str" || cnm == "oo_bytes_to_str"
            || cnm == "bytes_from_str" || cnm == "oo_bytes_from_str"
            || cnm == "bytes_concat" || cnm == "oo_bytes_concat" {
            crt = "OoStr";
        }
        if cnm == "oo_slist_new" || cnm == "oo_slist_push" {
            crt = "OoSList";
        }
        if cnm == "oo_ilist_get" {
            crt = "long long";
        }
        if cnm == "oo_slist_get" {
            crt = "OoStr";
        }
        if cnm == "list_get" {
            crt = c_list_get_result_ty(e, rhs);
        }
        if cnm == "list_len" || cnm == "oo_ilist_len" || cnm == "oo_slist_len" {
            crt = "long long";
        }
        if cnm == "chars_len" || cnm == "oo_chars_len" || cnm == "parse_int" {
            crt = "long long";
        }
        // M167 Int free names (avoid mega-table SEGV on stale hosts after rebuild)
        if cnm == "len" || cnm == "byte_at" || cnm == "oo_byte_at" || cnm == "ord" || cnm == "meta_epoch"
            || cnm == "oo_meta_epoch" || cnm == "meta_mix" || cnm == "oo_meta_mix"
            || cnm == "meta_is_path_a" || cnm == "oo_meta_is_path_a"
            || cnm == "bit_xor" || cnm == "bytes_len" || cnm == "oo_bytes_len"
            || cnm == "alloc_bytes" || cnm == "oo_alloc_bytes" || cnm == "malloc"
            || cnm == "realloc" || cnm == "now_ms" || cnm == "oo_now_ms"
            || cnm == "random" || cnm == "oo_random" {
            crt = "long long";
        }
        if cnm == "sin" || cnm == "cos" || cnm == "ln" || cnm == "exp"
            || cnm == "sqrt" || cnm == "pow"
            || cnm == "oo_sin" || cnm == "oo_cos" || cnm == "oo_ln"
            || cnm == "oo_exp" || cnm == "oo_sqrt" || cnm == "oo_pow" {
            crt = "double";
        }
        if cnm == "char_at" || cnm == "str_slice" || cnm == "int_to_str" || cnm == "to_string" {
            crt = "OoStr";
        }
        if cnm == "oo_char_at" || cnm == "oo_str_slice" || cnm == "oo_int_to_str" {
            crt = "OoStr";
        }
        if cnm == "oo_str_concat" || cnm == "oo_str_lit" {
            crt = "OoStr";
        }
        // M171: token/check free names that hit SEGV via mega c_call_result_ty on tip hosts
        if cnm == "field_at" || cnm == "field_decode3" || cnm == "tok_line" || cnm == "keyword_kind"
            || cnm == "cap_bag_put" || cnm == "sealed_kind_of" || cnm == "path_join"
            || cnm == "path_dirname" || cnm == "path_marker" || cnm == "set_add"
            || cnm == "parse_import_line" || cnm == "content_hash" || cnm == "check_cache_root"
            || cnm == "check_cache_path" || cnm == "check_cache_mod_key" || cnm == "check_cache_tree_key"
            || cnm == "strip_import_lines" || cnm == "scan_fn_names" || cnm == "c_env_get"
            || cnm == "c_env_put" || cnm == "c_env_put_last" || cnm == "c_ty_at"
            || cnm == "c_peek_list_elem" || cnm == "c_escape_str_text" || cnm == "shell_sq" {
            crt = "OoStr";
        }
        if cnm == "is_cap_type" || cnm == "is_sealed_net" || cnm == "is_sealed_fs"
            || cnm == "is_sealed_sys" || cnm == "is_sealed_env" || cnm == "is_sealed_alloc"
            || cnm == "is_sealed_ffi" || cnm == "is_sealed_time" || cnm == "is_sealed_rand"
            || cnm == "is_sealed_thread" || cnm == "is_sealed_gpu" || cnm == "set_has"
            || cnm == "cap_bag_has" || cnm == "path_exists" || cnm == "oo_path_exists" || cnm == "check_cache_hit" {
            crt = "int";
        }
        if cnm == "skip_until_semi" || cnm == "skip_balanced" || cnm == "skip_primary"
            || cnm == "check_function" || cnm == "file_size" || cnm == "c_emit_skip_type"
            || cnm == "c_emit_skip_braces" || cnm == "c_emit_skip_contracts"
            || cnm == "c_emit_skip_verify" {
            crt = "long long";
        }
        // pack / scan / emit helpers → List[String]
        if cnm == "lex_step" || cnm == "pack_tok" || cnm == "pack_err" || cnm == "pack_skip"
            || cnm == "try_scan_ws" || cnm == "try_scan_string" || cnm == "try_scan_number"
            || cnm == "try_scan_ident" || cnm == "try_scan_punct"
            || cnm == "c_emit_expr_c" || cnm == "c_emit_stmt" || cnm == "c_pack_pos_env" {
            crt = "OoSList";
        }
        // Result-returning sealed / host calls (untyped let must not default to long long)
        if cnm == "read_file" || cnm == "oo_read_file" || cnm == "env_get" || cnm == "oo_env_get"
            || cnm == "sys_exec" || cnm == "oo_sys_exec1" || cnm == "oo_sys_exec"
            || cnm == "fetch" || cnm == "oo_fetch" || cnm == "lex_all" || cnm == "chs_build"
            || cnm == "dlopen" || cnm == "oo_dlopen" || cnm == "dlsym" || cnm == "oo_dlsym"
            || cnm == "Ok" || cnm == "Err" {
            crt = "OoResS";
        }
        // Soft path: compound oo_sys_exec(...) when c_rhs_call_name misses nested sizeof
        if crt == "" && chars_len(rhs) >= 10 && rhs.contains("oo_sys_exec") {
            crt = "OoResS";
        }
        if crt == "" && chars_len(rhs) >= 10 && rhs.contains("oo_read_file") {
            crt = "OoResS";
        }
        if cnm == "write_file" || cnm == "oo_write_file" {
            crt = "OoResV";
        }
        if cnm == "load_source_with_imports" || cnm == "bc_emit_program" || cnm == "wasm_emit_program"
            || cnm == "bc_env_new" || cnm == "c_parse_max_cycles" || cnm == "c_parse_secret_env" {
            crt = "OoStr";
        }
        // Typecheck / env String returns (pure multi: no cross-module __fr__ map)
        if cnm == "resolve_type_alias" || cnm == "env_lookup_var" || cnm == "env_lookup_fn_line" || cnm == "lit_token_type" || cnm == "indent"
            || cnm == "atom_type_with_env" || cnm == "field_chain_type" || cnm == "field_access_type_at"
            || cnm == "infer_typed_expr_type" || cnm == "infer_typed_expr_type_exact"
            || cnm == "combine_binop_types" || cnm == "method_result_type" || cnm == "env_lookup_type"
            || cnm == "operand_type_with_env" || cnm == "resolve_arg_type" || cnm == "struct_field_type"
            || cnm == "build_fn_ret_table" || cnm == "build_pure_lit_env" || cnm == "build_struct_field_table"
            || cnm == "c_rhs_call_name" || cnm == "c_struct_field_c_ty" || cnm == "c_call_result_ty"
            || cnm == "c_lower_call_name" || cnm == "c_list_c_name" || cnm == "c_list_get_result_ty"
            || cnm == "c_ty_at" || cnm == "nth_csv" || cnm == "bin_op_name" || cnm == "c_emit_scope_exit"
            || cnm == "c_env_push_scope" || cnm == "llvm_ty_map" || cnm == "llvm_env_get_var_ty"
            || cnm == "infer_pure_lit_expr_type" || cnm == "lit_env_bind_fn_params"
            || cnm == "c_infer_list_kind" || cnm == "c_args_drop_first" || cnm == "c_sys_exec_last_arg"
            || cnm == "c_binop_apply" || cnm == "c_emit_libfloor_call" || cnm == "c_emit_netio_call"
            || cnm == "c_emit_sys_call" || cnm == "c_emit_index_get" || cnm == "c_emit_pack2" {
            crt = "OoStr";
        }
        if cnm == "load_expand" || cnm == "collect_module_paths" || cnm == "collect_expand"
            || cnm == "tokenize_lines" || cnm == "collect_tokens" || cnm == "c_emit_block"
            || cnm == "c_emit_call_args" || cnm == "c_emit_primary_c" || cnm == "tokenize_lines"
            || cnm == "c_emit_expr_prec" || cnm == "call_arg_prep" || cnm == "ann_prep"
            || cnm == "refine_capture_fn_ret_bound" {
            crt = "OoSList";
        }
        if cnm == "struct_fields_blob" {
            crt = "OoStr";
        }
        if cnm != "" && crt == "" {
            let fr: String = c_env_get(e, "__fr__" + cnm);
            if fr == "T" {
                crt = "OoStr";
            } else if fr == "S" {
                crt = "OoSList";
            } else if fr == "I" {
                crt = "OoIList";
            }
        }
        // M171: no mega c_call_result_ty (SEGV); unknown free call → Int default
        // superseded by annotation-required fail-closed at emit stage
        if cnm != "" && crt == "" {
            println("ERR\tc_emit\tunknown free call needs annotation\t" + cnm);
            process_exit(1);
        }
        if crt != "" {
            lty = crt;
            if crt == "OoSList" {
                bind_kind = "S";
            }
            if crt == "OoIList" {
                bind_kind = "I";
            }
            if crt == "double" {
                bind_kind = "F";
            }
            if crt == "OoResS" {
                bind_kind = "R";
            }
            if crt == "OoResV" {
                bind_kind = "V";
            }
            if crt == "OoStr" {
                bind_kind = "T";
            }
        } else {
            // bare IDENT: env kind T→OoStr (also S/I/R/V/F)
            let ek: String = c_env_get(e, rhs);
            if ek == "T" {
                lty = "OoStr";
                bind_kind = "T";
            } else if ek == "S" {
                lty = "OoSList";
                bind_kind = "S";
            } else if ek == "I" {
                lty = "OoIList";
                bind_kind = "I";
            } else if ek == "R" {
                lty = "OoResS";
                bind_kind = "R";
            } else if ek == "V" {
                lty = "OoResV";
                bind_kind = "V";
            } else if ek == "F" {
                lty = "double";
                bind_kind = "F";
            } else if chars_len(rhs) >= 9 && char_at(rhs, 0) == "o" {
                if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                    lty = "OoIList";
                    bind_kind = "I";
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                    if chars_len(rhs) >= 11 && char_at(rhs, 9) == "g" {
                        lty = "OoStr";
                        bind_kind = "T";
                    } else {
                        lty = "OoSList";
                        bind_kind = "S";
                    }
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
                if char_at(rhs, 3) == "c" && char_at(rhs, 4) == "h" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
            }
        }
    }
    let mut res: List[String] = list_new();
    res = list_push(res, lty);
    res = list_push(res, bind_kind);
    return res;
}
