// # Infer an untyped let bind type
//
// Logline: From an untyped RHS string and env, pick a C type and bind kind, short-circuiting known free names before the mega result table.
//
// Setup: char_at, chars_len, c_rhs_call_name, c_list_get_result_ty, c_env_get, c_emit_let_untyped_crt, println, and process_exit exist; c_emit_let_ext_crt.oo holds the MOVE crt tables; unknown free calls fail closed.
//
// Beats:
//   1. Detect numeric literals (optional leading minus) and oo_str_lit/concat as Float, Int, or OoStr.
//   2. Else map the RHS call name to a crt type via the free-name table, then c_emit_let_untyped_crt, then __fr__ env.
//   3. Unknown free call prints ERR and exits; else set bind kind T/S/I/F/R/V or fall back to a bare IDENT env kind.

import "c_emit_let_ext_crt.oo";

pub fn c_emit_let_untyped_ty(rhs: String, e: String) -> List[String] {
    let mut lty: String = "long long";
    let mut bind_kind: String = "";
    let mut crt: String = "";
    let mut is_num: Bool = false;
    if chars_len(rhs) > 0 {
        let c0: String = char_at(rhs, 0);
        if c0 == "-" || c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
            is_num = true;
        }
        if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
            is_num = true;
        }
    }
    // oo_str_lit/concat prefix, or nested concat anywhere
    let mut is_str_expr: Bool = false;
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
            if char_at(rhs, 7) == "l" || char_at(rhs, 7) == "c" { is_str_expr = true; }
        }
    }
    if !is_str_expr && chars_len(rhs) >= 13 && rhs.contains("oo_str_concat") {
        is_str_expr = true;
    }
    if is_num && rhs.contains(".") {
        lty = "double";
        bind_kind = "F";
    } else if is_num {
        lty = "long long";
    } else if is_str_expr {
        lty = "OoStr";
        bind_kind = "T";
    } else {
        let cnm: String = c_rhs_call_name(rhs);
        if cnm == "list_new" || cnm == "oo_ilist_new"
            || cnm == "bytes_new" || cnm == "oo_bytes_new"
            || cnm == "list_push" || cnm == "oo_ilist_push"
            || cnm == "bytes_push" || cnm == "oo_bytes_push" {
            crt = "OoIList";
        }
        if cnm == "bytes_get" || cnm == "oo_bytes_get" {
            crt = "long long";
        }
        if cnm == "bytes_to_str" || cnm == "oo_bytes_to_str"
            || cnm == "bytes_from_str" || cnm == "oo_bytes_from_str"
            || cnm == "bytes_concat" || cnm == "oo_bytes_concat" {
            crt = "OoStr";
        }
        if cnm == "oo_slist_new" || cnm == "oo_slist_push" {
            crt = "OoSList";
        }
        if cnm == "oo_ilist_get" {
            crt = "long long";
        }
        if cnm == "oo_slist_get" {
            crt = "OoStr";
        }
        if cnm == "list_get" {
            crt = c_list_get_result_ty(e, rhs);
        }
        if cnm == "list_len" || cnm == "oo_ilist_len" || cnm == "oo_slist_len" {
            crt = "long long";
        }
        if cnm == "chars_len" || cnm == "oo_chars_len" || cnm == "parse_int" || cnm == "ts_skip_ws" || cnm == "ts_skip_braces" || cnm == "ts_find_lbrace" || cnm == "ts_if_end" || cnm == "ts_skip_semi" || cnm == "ts_after_ident" {
            crt = "long long";
        }
        // M167 Int free names (avoid mega-table SEGV on stale hosts after rebuild)
        if cnm == "len" || cnm == "byte_at" || cnm == "oo_byte_at" || cnm == "ord" || cnm == "meta_epoch"
            || cnm == "oo_meta_epoch" || cnm == "meta_mix" || cnm == "oo_meta_mix"
            || cnm == "meta_is_path_a" || cnm == "oo_meta_is_path_a"
            || cnm == "bit_xor" || cnm == "bytes_len" || cnm == "oo_bytes_len"
            || cnm == "alloc_bytes" || cnm == "oo_alloc_bytes" || cnm == "malloc"
            || cnm == "realloc" || cnm == "now_ms" || cnm == "oo_now_ms"
            || cnm == "random" || cnm == "oo_random" {
            crt = "long long";
        }
        if cnm == "sin" || cnm == "cos" || cnm == "ln" || cnm == "exp"
            || cnm == "sqrt" || cnm == "pow"
            || cnm == "oo_sin" || cnm == "oo_cos" || cnm == "oo_ln"
            || cnm == "oo_exp" || cnm == "oo_sqrt" || cnm == "oo_pow" {
            crt = "double";
        }
        if cnm == "char_at" || cnm == "str_slice" || cnm == "int_to_str" || cnm == "to_string" {
            crt = "OoStr";
        }
        if cnm == "oo_char_at" || cnm == "oo_str_slice" || cnm == "oo_int_to_str" {
            crt = "OoStr";
        }
        if cnm == "oo_str_concat" || cnm == "oo_str_lit" {
            crt = "OoStr";
        }
        // M167 smoke floor: try_scan_* stay here (pack/emit rest in crt helper)
        if cnm == "try_scan_ws" || cnm == "try_scan_string" || cnm == "try_scan_number"
            || cnm == "try_scan_ident" || cnm == "try_scan_punct" {
            crt = "OoSList";
        }
        if crt == "" {
            crt = c_emit_let_untyped_crt(cnm, rhs);
        }
        if cnm != "" && crt == "" {
            let fr: String = c_env_get(e, "__fr__" + cnm);
            if fr == "T" {
                crt = "OoStr";
            } else if fr == "S" {
                crt = "OoSList";
            } else if fr == "I" {
                crt = "OoIList";
            }
        }
        // M171: no mega c_call_result_ty (SEGV); unknown free call → Int default
        // superseded by annotation-required fail-closed at emit stage
        if cnm != "" && crt == "" {
            println("ERR\tc_emit\tunknown free call needs annotation\t" + cnm);
            process_exit(1);
        }
        if crt != "" {
            lty = crt;
            if crt == "OoSList" {
                bind_kind = "S";
            }
            if crt == "OoIList" {
                bind_kind = "I";
            }
            if crt == "double" {
                bind_kind = "F";
            }
            if crt == "OoResS" {
                bind_kind = "R";
            }
            if crt == "OoResV" {
                bind_kind = "V";
            }
            if crt == "OoStr" {
                bind_kind = "T";
            }
        } else {
            // bare IDENT: env kind T→OoStr (also S/I/R/V/F)
            let ek: String = c_env_get(e, rhs);
            if ek == "T" {
                lty = "OoStr";
                bind_kind = "T";
            } else if ek == "S" {
                lty = "OoSList";
                bind_kind = "S";
            } else if ek == "I" {
                lty = "OoIList";
                bind_kind = "I";
            } else if ek == "R" {
                lty = "OoResS";
                bind_kind = "R";
            } else if ek == "V" {
                lty = "OoResV";
                bind_kind = "V";
            } else if ek == "F" {
                lty = "double";
                bind_kind = "F";
            } else if chars_len(rhs) >= 9 && char_at(rhs, 0) == "o" {
                if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                    lty = "OoIList";
                    bind_kind = "I";
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                    if chars_len(rhs) >= 11 && char_at(rhs, 9) == "g" {
                        lty = "OoStr";
                        bind_kind = "T";
                    } else {
                        lty = "OoSList";
                        bind_kind = "S";
                    }
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
                if char_at(rhs, 3) == "c" && char_at(rhs, 4) == "h" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
            }
        }
    }
    let mut res: List[String] = list_new();
    res = list_push(res, lty);
    res = list_push(res, bind_kind);
    return res;
}
