// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: untyped bind type inference helpers split from c_emit_let
// stage: emit
// M167: free-name short-circuit before mega c_call_result_ty (stale hosts SEGV)

pub fn c_emit_let_untyped_ty(rhs: String, e: String) -> List[String] {
    let mut lty = "long long";
    let mut bind_kind = "";
    let mut crt = "";
    let mut is_num = false;
    if chars_len(rhs) > 0 {
        let c0 = char_at(rhs, 0);
        if c0 == "-" || c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
            is_num = true;
        }
        if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
            is_num = true;
        }
    }
    let mut is_str_expr = false;
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
            if char_at(rhs, 7) == "l" || char_at(rhs, 7) == "c" {
                is_str_expr = true;
            }
        }
    }
    if is_num && rhs.contains(".") {
        lty = "double";
        bind_kind = "F";
    } else if is_num {
        lty = "long long";
    } else if is_str_expr {
        lty = "OoStr";
    } else {
        let cnm = c_rhs_call_name(rhs);
        if cnm == "list_new" || cnm == "oo_ilist_new"
            || cnm == "bytes_new" || cnm == "oo_bytes_new"
            || cnm == "list_push" || cnm == "oo_ilist_push"
            || cnm == "bytes_push" || cnm == "oo_bytes_push" {
            crt = "OoIList";
        }
        if cnm == "bytes_get" || cnm == "oo_bytes_get" {
            crt = "long long";
        }
        if cnm == "bytes_to_str" || cnm == "oo_bytes_to_str"
            || cnm == "bytes_from_str" || cnm == "oo_bytes_from_str"
            || cnm == "bytes_concat" || cnm == "oo_bytes_concat" {
            crt = "OoStr";
        }
        if cnm == "oo_slist_new" || cnm == "oo_slist_push" {
            crt = "OoSList";
        }
        if cnm == "oo_ilist_get" {
            crt = "long long";
        }
        if cnm == "oo_slist_get" {
            crt = "OoStr";
        }
        if cnm == "list_get" {
            crt = c_list_get_result_ty(e, rhs);
        }
        if cnm == "list_len" || cnm == "oo_ilist_len" || cnm == "oo_slist_len" {
            crt = "long long";
        }
        if cnm == "chars_len" || cnm == "oo_chars_len" || cnm == "parse_int" {
            crt = "long long";
        }
        // M167 Int free names (avoid mega-table SEGV on stale hosts after rebuild)
        if cnm == "len" || cnm == "byte_at" || cnm == "oo_byte_at" || cnm == "ord"
            || cnm == "bit_xor" || cnm == "bytes_len" || cnm == "oo_bytes_len"
            || cnm == "alloc_bytes" || cnm == "oo_alloc_bytes" || cnm == "malloc"
            || cnm == "realloc" || cnm == "now_ms" || cnm == "oo_now_ms"
            || cnm == "random" || cnm == "oo_random" {
            crt = "long long";
        }
        if cnm == "sin" || cnm == "cos" || cnm == "ln" || cnm == "exp"
            || cnm == "sqrt" || cnm == "pow"
            || cnm == "oo_sin" || cnm == "oo_cos" || cnm == "oo_ln"
            || cnm == "oo_exp" || cnm == "oo_sqrt" || cnm == "oo_pow" {
            crt = "double";
        }
        if cnm == "char_at" || cnm == "str_slice" || cnm == "int_to_str" || cnm == "to_string" {
            crt = "OoStr";
        }
        if cnm == "oo_char_at" || cnm == "oo_str_slice" || cnm == "oo_int_to_str" {
            crt = "OoStr";
        }
        if cnm == "oo_str_concat" || cnm == "oo_str_lit" {
            crt = "OoStr";
        }
        // pack / scan / emit helpers → List[String]
        if cnm == "lex_step" || cnm == "pack_tok" || cnm == "pack_err" || cnm == "pack_skip"
            || cnm == "try_scan_ws" || cnm == "try_scan_string" || cnm == "try_scan_number"
            || cnm == "try_scan_ident" || cnm == "try_scan_punct"
            || cnm == "c_emit_expr_c" || cnm == "c_emit_stmt" || cnm == "c_pack_pos_env" {
            crt = "OoSList";
        }
        if cnm != "" && crt == "" {
            let fr = c_env_get(e, "__fr__" + cnm);
            if fr == "T" {
                crt = "OoStr";
            } else if fr == "S" {
                crt = "OoSList";
            } else if fr == "I" {
                crt = "OoIList";
            }
        }
        if cnm != "" && crt == "" {
            crt = c_call_result_ty(cnm);
        }
        // unknown free call → Int default (never leave lty empty)
        if cnm != "" && crt == "" {
            crt = "long long";
        }
        if crt != "" {
            lty = crt;
            if crt == "OoSList" {
                bind_kind = "S";
            }
            if crt == "OoIList" {
                bind_kind = "I";
            }
            if crt == "double" {
                bind_kind = "F";
            }
        } else {
            let ek = c_env_get(e, rhs);
            if ek == "T" {
                lty = "OoStr";
            } else if ek == "S" {
                lty = "OoSList";
                bind_kind = "S";
            } else if ek == "I" {
                lty = "OoIList";
                bind_kind = "I";
            } else if chars_len(rhs) >= 9 && char_at(rhs, 0) == "o" {
                if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                    lty = "OoIList";
                    bind_kind = "I";
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                    if chars_len(rhs) >= 11 && char_at(rhs, 9) == "g" {
                        lty = "OoStr";
                    } else {
                        lty = "OoSList";
                        bind_kind = "S";
                    }
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
                    lty = "OoStr";
                }
                if char_at(rhs, 3) == "c" && char_at(rhs, 4) == "h" {
                    lty = "OoStr";
                }
            }
        }
    }
    let mut res: List[String] = list_new();
    res = list_push(res, lty);
    res = list_push(res, bind_kind);
    return res;
}
