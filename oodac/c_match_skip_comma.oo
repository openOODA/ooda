// # Skip a comma after a match binding
//
// Logline: If the token at pos is COMMA, step one; otherwise return pos.
//
// Setup: toks rows are kind, line, col, text; field_at and list_get exist; match emit calls this after a binding name.
//
// Beats:
//   1. Copy pos into p.
//   2. If p is in range and the kind is COMMA, increment p.
//   3. Return p.

pub fn c_match_skip_comma(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
        p = p + 1;
    }
    return p;
}
