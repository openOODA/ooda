// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: lower match on Result (OoResS / OoResV) to if (ok) / else
// stage: emit

pub fn c_match_skip_comma(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
        p = p + 1;
    }
    return p;
}
