// # Map call names to C result types
//
// Logline: Lowers a few string free names, picks slist vs ilist C names, and returns the C result type of a known call.
//
// Setup: emit uses these when lowering a call; empty means unknown or a special form such as Ok/Err.
//
// Beats:
//   1. c_lower_call_name maps chars_len, char_at, str_slice, char_is_*, and str_contains to oo_* and leaves pack_* as-is.
//   2. c_list_c_name maps list_new, push, get, set, and len onto slist, ilist, flist, oo_l_Name_*, or oo_ll_*.
//   3. c_call_result_ty returns OoResS, OoResV, OoStr, OoIList, OoSList, long long, double, or int for known names, else empty.

import "c_emit_call_ty.oo";

pub fn c_lower_call_name(name: String) -> String {
    if name == "chars_len" {
        return "oo_chars_len";
    }
    if name == "char_at" {
        return "oo_char_at";
    }
    if name == "str_slice" {
        return "oo_str_slice";
    }
    if name == "char_is_alpha" {
        return "oo_char_is_alpha";
    }
    if name == "char_is_digit" {
        return "oo_char_is_digit";
    }
    if name == "char_is_space" {
        return "oo_char_is_space";
    }
    if name == "str_contains" {
        return "oo_str_contains";
    }
    if name == "tok_line" {
        return "oo_tok_line";
    }
    if name == "pack_skip" || name == "pack_tok" || name == "pack_err" {
        return name;
    }
    // Ok/Err lowered specially in primary (not via cname)
    return "";
}

pub fn c_list_c_name(op: String, kind: String) -> String {
    let mut k = kind;
    if k == "" {
        k = "I";
    }
    if k == "LF" {
        k = "F";
    }
    if chars_len(k) >= 4 {
        if char_at(k, 0) == "L" {
            if char_at(k, 1) == "L" {
                if char_at(k, 2) == "_" {
                    let pfx: String = "oo_ll_" + str_slice(k, 3, chars_len(k));
                    if op == "list_new" {
                        return pfx + "_new";
                    }
                    if op == "list_push" {
                        return pfx + "_push";
                    }
                    if op == "list_get" {
                        return pfx + "_get";
                    }
                    if op == "list_len" {
                        return pfx + "_len";
                    }
                    if op == "list_set" {
                        return pfx + "_set";
                    }
                    return "";
                }
            }
        }
    }
    if k != "S" && k != "I" && k != "F" {
        let pfx: String = "oo_l_" + k;
        if op == "list_new" {
            return pfx + "_new";
        }
        if op == "list_push" {
            return pfx + "_push";
        }
        if op == "list_get" {
            return pfx + "_get";
        }
        if op == "list_len" {
            return pfx + "_len";
        }
        if op == "list_set" {
            return pfx + "_set";
        }
        return "";
    }
    if op == "list_new" {
        if k == "S" {
            return "oo_slist_new";
        }
        if k == "F" {
            return "oo_flist_new";
        }
        return "oo_ilist_new";
    }
    if op == "list_push" {
        if k == "S" {
            return "oo_slist_push";
        }
        if k == "F" {
            return "oo_flist_push";
        }
        return "oo_ilist_push";
    }
    if op == "list_get" {
        if k == "S" {
            return "oo_slist_get";
        }
        if k == "F" {
            return "oo_flist_get";
        }
        return "oo_ilist_get";
    }
    if op == "list_len" {
        if k == "S" {
            return "oo_slist_len";
        }
        if k == "F" {
            return "oo_flist_len";
        }
        return "oo_ilist_len";
    }
    if op == "list_set" {
        if k == "S" {
            return "oo_slist_set";
        }
        if k == "F" {
            return "oo_flist_set";
        }
        return "oo_ilist_set";
    }
    return "";
}

// C type for known call results ("" = unknown).
pub fn c_call_result_ty(name: String) -> String {
    if c_is_res_s_call(name) {
        return "OoResS";
    }
    if c_is_res_v_call(name) {
        return "OoResV";
    }
    if c_is_str_call(name) {
        return "OoStr";
    }
    if c_is_ilist_call(name) {
        return "OoIList";
    }
    if c_is_slist_call(name) {
        return "OoSList";
    }
    if c_is_i64_call(name) {
        return "long long";
    }
    if c_is_f64_call(name) {
        return "double";
    }
    if c_is_i32_call(name) {
        return "int";
    }
    return "";
}
