// package: backend-c — emit floor (see bootstrap/FLOOR.md)
// job: call name lower + result C types for emit
// stage: emit

pub fn c_lower_call_name(name: String) -> String {
    if name == "chars_len" {
        return "oo_chars_len";
    }
    if name == "char_at" {
        return "oo_char_at";
    }
    if name == "str_slice" {
        return "oo_str_slice";
    }
    if name == "char_is_alpha" {
        return "oo_char_is_alpha";
    }
    if name == "char_is_digit" {
        return "oo_char_is_digit";
    }
    if name == "char_is_space" {
        return "oo_char_is_space";
    }
    if name == "str_contains" {
        return "oo_str_contains";
    }
    if name == "pack_skip" || name == "pack_tok" || name == "pack_err" {
        return name;
    }
    // Ok/Err lowered specially in primary (not via cname)
    return "";
}

pub fn c_list_c_name(op: String, kind: String) -> String {
    let mut k = kind;
    if k != "S" {
        k = "I";
    }
    if op == "list_new" {
        if k == "S" {
            return "oo_slist_new";
        }
        return "oo_ilist_new";
    }
    if op == "list_push" {
        if k == "S" {
            return "oo_slist_push";
        }
        return "oo_ilist_push";
    }
    if op == "list_get" {
        if k == "S" {
            return "oo_slist_get";
        }
        return "oo_ilist_get";
    }
    if op == "list_len" {
        if k == "S" {
            return "oo_slist_len";
        }
        return "oo_ilist_len";
    }
    return "";
}

// C type for known call results ("" = unknown).
pub fn c_call_result_ty(name: String) -> String {
    if name == "Ok" || name == "Err" || name == "lex_all" || name == "read_file"
        || name == "sys_exec" || name == "oo_sys_exec1" || name == "oo_sys_exec" || name == "oo_read_file"
        || name == "env_get" || name == "oo_env_get" || name == "chs_build"
        || name == "json_parse_internal" || name == "async_join_internal"
        || name == "python_embed_internal" || name == "oo_fetch" || name == "oo_dlopen"
        || name == "net_request" || name == "fs_write_then_read" || name == "parse"
        || name == "load_model" || name == "join_task" || name == "fetch" || name == "dlopen"
        || name == "parse_valid_json" || name == "run_async_pipeline"
        || name == "load_llama_model" || name == "secure_file_access" || name == "check_result"
        || name == "run_concurrent_work" || name == "roundtrip" || name == "parse_malformed_returns_err"
    {
        return "OoResS";
    }
    if name == "write_file" || name == "oo_write_file" {
        return "OoResV";
    }
    if name == "char_at" || name == "str_slice" || name == "field_at"
        || name == "field_decode3" || name == "keyword_kind" || name == "tok_line"
        || name == "pack_status" || name == "escape_dump" || name == "nth_csv"
        || name == "bin_op_name" || name == "resolve_type_alias"
        || name == "resolve_arg_type" || name == "lit_token_type"
        || name == "atom_type_with_env" || name == "env_lookup_type"
        || name == "operand_type_with_env" || name == "method_result_type"
        || name == "combine_binop_types" || name == "infer_pure_lit_expr_type"
        || name == "infer_typed_expr_type" || name == "infer_typed_expr_type_exact"
        || name == "struct_field_type" || name == "struct_fields_blob"
        || name == "field_access_type_at" || name == "field_chain_type"
        || name == "indent" || name == "drop_depth" || name == "ann_check_let"
        || name == "build_fn_ret_table" || name == "build_pure_lit_env"
        || name == "build_struct_field_table" || name == "c_env_get"
    {
        return "OoStr";
    }
    if name == "c_env_put" || name == "c_list_c_name" || name == "c_ty_at"
        || name == "c_peek_list_elem" || name == "c_call_result_ty"
        || name == "c_rhs_call_name" || name == "c_lower_call_name"
        || name == "c_escape_str_text" || name == "c_infer_list_kind"
        || name == "c_binop_apply" || name == "c_sys_exec_last_arg"
        || name == "c_args_drop_first" || name == "load_source_with_imports"
        || name == "path_dirname" || name == "path_join" || name == "path_marker"
        || name == "set_add" || name == "parse_import_line" || name == "c_contract_op"
        || name == "crypto_sha256_internal" || name == "crypto_hmac_sha256_internal"
        || name == "json_stringify_internal" || name == "async_spawn_internal"
        || name == "test_sha256_empty" || name == "test_json_parse" || name == "test_async_spawn"
        || name == "stringify" || name == "sha256" || name == "hmac_sha256" || name == "sha256_abc" || name == "sha256_empty" || name == "hmac_rfc_vector"
        || name == "gen_string_val" || name == "bc_env_new" || name == "bc_emit_program" || name == "wasm_emit_program" || name == "wasm_emit_stream" || name == "wasm_mem_str_lit"
        || name == "content_hash" || name == "check_cache_root" || name == "check_cache_path"
        || name == "check_cache_mod_key" || name == "check_cache_tree_key"
        || name == "strip_import_lines" || name == "scan_fn_names" || name == "names_to_depth0_binds"
        || name == "parse_import_line"
    {
        return "OoStr";
    }
    if name == "list_new" || name == "list_push" || name == "gen_list_int_val" {
        return "OoIList";
    }
    // List[String] packs / multi-value returns used across oodac
    if name == "lex_step" || name == "pack_tok" || name == "pack_err"
        || name == "pack_skip" || name == "tokenize_lines" || name == "collect_tokens"
        || name == "try_scan_ws" || name == "try_scan_string" || name == "try_scan_number"
        || name == "try_scan_ident" || name == "try_scan_punct"
        || name == "ann_prep" || name == "call_arg_prep"
        || name == "c_emit_primary_c" || name == "c_emit_expr_c"
        || name == "c_emit_expr_prec" || name == "c_emit_call_args"
        || name == "c_emit_method" || name == "c_pack_pos_env"
        || name == "c_emit_block" || name == "c_emit_match_stmt" || name == "c_emit_match_let" || name == "c_emit_stmt"
        || name == "c_emit_let_stmt" || name == "c_emit_ident_stmt"
        || name == "refine_capture_fn_ret_bound" || name == "refine_capture_call_bound"
        || name == "collect_module_paths" || name == "collect_expand" || name == "load_expand"
    {
        return "OoSList";
    }
    if name == "chars_len" || name == "list_len" || name == "parse_int"
        || name == "oo_slist_len" || name == "oo_ilist_len" || name == "oo_chars_len"
        || name == "c_count_top_args" || name == "method_call_end" || name == "operand_end"
        || name == "c_binop_prec" || name == "skip_until_semi"
        || name == "skip_balanced" || name == "skip_primary"
        || name == "c_emit_fn" || name == "c_emit_skip_type"
        || name == "c_emit_skip_braces" || name == "c_emit_skip_contracts"
        || name == "c_emit_contracts_runtime"
        || name == "c_emit_skip_verify" || name == "check_function"
        || name == "print_expr_bp" || name == "parse_expr_bp"
        || name == "file_size" || name == "bc_env_lookup" || name == "bc_env_count"
    {
        return "long long";
    }
    // list_get: infer from lowered oo_slist_get vs oo_ilist_get in let (not name alone)
    if name == "char_is_alpha" || name == "char_is_digit" || name == "char_is_space"
        || name == "str_contains" || name == "c_expr_is_str" || name == "c_expr_is_str_env"
        || name == "c_is_binop" || name == "is_sealed_net" || name == "is_sealed_fs"
        || name == "is_sealed_sys" || name == "is_sealed_env"
        || name == "set_has" || name == "path_exists"
        || name == "c_try_emit_requires_clause" || name == "c_requires_clause_is_simple"
        || name == "c_has_simple_ensures" || name == "c_ensures_clause_is_simple"
        || name == "check_cache_hit"
    {
        return "int";
    }
    return "";
}
