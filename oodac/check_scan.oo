// # Scan fn names without tokenize
//
// Logline: Char-walks module source for depth-0 fn names, skipping comments and strings so fake names cannot seed extra_binds.
//
// Setup: chars_len and char_at exist; tokenize_lines is grepped out of this path (Darwin 1.8GiB RSS / 120s on 150 modules); seed emit cannot lower .contains so this file is char-walk only.
//
// Beats:
//   1. Skip // comments and "strings" so comment or string text cannot seed names.
//   2. On a standalone fn keyword, collect the following ident into a tab-separated name table.
//   3. names_to_depth0_binds maps "\tfoo\tbar\t" to "\tfoo@0\tbar@0\t" for typecheck_undefined_vars_ext.
//
// residual: shared sig tables not wired

fn scan_charset_has(set: String, c: String) -> Bool {
    let n = chars_len(set);
    let mut i = 0;
    while i < n {
        if char_at(set, i) == c {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn scan_is_ident_start(c: String) -> Bool {
    return scan_charset_has("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c);
}

fn scan_has_name(names: String, fname: String) -> Bool {
    let marker: String = "\t" + fname + "\t";
    let nn = chars_len(names);
    let mn = chars_len(marker);
    if mn > nn {
        return false;
    }
    let mut i = 0;
    while i + mn <= nn {
        let mut j = 0;
        let mut ok = true;
        while j < mn {
            if char_at(names, i + j) != char_at(marker, j) {
                ok = false;
                j = mn;
            } else {
                j = j + 1;
            }
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn scan_is_ident_char(c: String) -> Bool {
    if scan_is_ident_start(c) {
        return true;
    }
    return scan_charset_has("0123456789", c);
}

fn scan_skip_line_comment(src: String, n: Int, i0: Int) -> Int {
    let mut i = i0;
    while i < n {
        if char_at(src, i) == "\n" {
            return i;
        }
        i = i + 1;
    }
    return i;
}

fn scan_skip_string(src: String, n: Int, i0: Int) -> Int {
    let mut i = i0;
    while i < n {
        let q = char_at(src, i);
        if q == "\\" {
            i = i + 2;
        } else if q == "\"" {
            return i + 1;
        } else {
            i = i + 1;
        }
    }
    return i;
}

pub fn scan_fn_names(src: String) -> String {
    let mut names: String = "\t";
    let n = chars_len(src);
    let mut i = 0;
    while i < n {
        let c = char_at(src, i);
        if c == "/" {
            if i + 1 < n {
                if char_at(src, i + 1) == "/" {
                    i = scan_skip_line_comment(src, n, i + 2);
                } else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            i = scan_skip_string(src, n, i + 1);
        } else if c == "f" {
            let mut is_fn = false;
            if i + 1 < n {
                if char_at(src, i + 1) == "n" {
                    let mut prev_ok = true;
                    if i > 0 {
                        if scan_is_ident_char(char_at(src, i - 1)) {
                            prev_ok = false;
                        }
                    }
                    let mut next_ok = true;
                    if i + 2 < n {
                        if scan_is_ident_char(char_at(src, i + 2)) {
                            next_ok = false;
                        }
                    }
                    if prev_ok {
                        if next_ok {
                            is_fn = true;
                        }
                    }
                }
            }
            if is_fn {
                let mut j = i + 2;
                while j < n {
                    let w = char_at(src, j);
                    if w == " " || w == "\t" {
                        j = j + 1;
                    } else {
                        break;
                    }
                }
                if j < n {
                    if scan_is_ident_start(char_at(src, j)) {
                        let fn0 = j;
                        while j < n {
                            if scan_is_ident_char(char_at(src, j)) {
                                j = j + 1;
                            } else {
                                break;
                            }
                        }
                        let fname: String = str_slice(src, fn0, j);
                        if !scan_has_name(names, fname) {
                            names = names + fname + "\t";
                        }
                    }
                }
                i = j;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return names;
}

pub fn names_to_depth0_binds(names: String) -> String {
    let mut binds = "\t";
    let n = chars_len(names);
    let mut i = 0;
    let mut start = 0;
    while i < n {
        if char_at(names, i) == "\t" {
            if i > start {
                binds = binds + str_slice(names, start, i) + "@0\t";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if i > start {
        binds = binds + str_slice(names, start, i) + "@0\t";
    }
    return binds;
}
