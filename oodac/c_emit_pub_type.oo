// # Skip `pub type Name = …;` in the fn-return pre-pass
//
// Logline: Brace-aware skipper so c_emit.oo's fn-return pre-pass does not read struct fields as fn params.
//
// Setup: c_tokk lives in token_fmt.oo. c_emit_walk.oo has c_skip_type_decl for the walker, but it is a private fn and the pre-pass in c_emit.oo duplicates the skip; this pub fn is the canonical version.
//
// Beats:
//   1. Skip KW_PUB, KW_TYPE, IDENT (name) and look for LBRACE / SEMI / EOF.
//   2. Brace-balanced: when RBRACE closes the struct body, eat the trailing SEMI.
//   3. EOF safety: stop without eating past the end.

pub fn c_skip_pub_type_def(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && c_tokk(toks, p) == "KW_PUB" { p = p + 1; }
    if p < n && c_tokk(toks, p) == "KW_TYPE" { p = p + 1; }
    if p < n && c_tokk(toks, p) == "IDENT" { p = p + 1; }
    let mut depth: Int = 0;
    let mut seen_brace: Bool = false;
    while p < n {
        let tk: String = c_tokk(toks, p);
        if tk == "LBRACE" {
            depth = depth + 1;
            seen_brace = true;
            p = p + 1;
        } else if tk == "RBRACE" {
            if depth > 0 { depth = depth - 1; }
            p = p + 1;
            if seen_brace && depth == 0 {
                if p < n && c_tokk(toks, p) == "SEMI" { p = p + 1; }
                return p;
            }
        } else if tk == "SEMI" {
            if depth == 0 { return p + 1; }
            p = p + 1;
        } else if tk == "EOF" {
            return p;
        } else {
            p = p + 1;
        }
    }
    return p;
}
