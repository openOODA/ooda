// # Lower expressions to LLVM
//
// Logline: Emits a primary or Pratt-parsed binop as LLVM IR and returns value, type, pos, and env.
//
// Setup: sibling llvm_emit_* helpers; env is the five-slot emit env.
//
// Beats:
//   1. Primary: lits, calls, methods including contains and dyn trait calls, fields, parens, unary.
//   2. Pratt binops via llvm_apply_binop.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";
import "llvm_emit_mem.oo";
import "llvm_emit_call.oo";
import "llvm_emit_assert.oo";
import "llvm_emit_method.oo";
import "llvm_emit_binop.oo";
import "llvm_emit_match_expr.oo";
import "llvm_emit_result.oo";
import "llvm_emit_try.oo";
import "c_emit_sum_spec.oo";
import "llvm_emit_trait.oo";
import "llvm_emit_trait_call.oo";

fn llvm_pack_env5(s: List[String], b: Int) -> List[String] {
    let mut e: List[String] = list_new();
    e = list_push(e, list_get(s, b)); e = list_push(e, list_get(s, b + 1));
    e = list_push(e, list_get(s, b + 2)); e = list_push(e, list_get(s, b + 3));
    e = list_push(e, list_get(s, b + 4)); return e;
}

fn llvm_out_val(val: String, ty: String, p: Int, env: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, val); out = list_push(out, ty); out = list_push(out, p.to_string());
    out = list_push(out, list_get(env, 0)); out = list_push(out, list_get(env, 1));
    out = list_push(out, list_get(env, 2)); out = list_push(out, list_get(env, 3));
    out = list_push(out, list_get(env, 4)); return out;
}

fn llvm_dyn_arg_call(ttab: String, tname: String, mname: String, target: String, toks: List[String], start_p: Int, n: Int, env: List[String]) -> List[String] {
    let mut ap = start_p;
    let mut cur_env = env;
    let mut arg_vals: List[String] = list_new();
    let mut arg_tys: List[String] = list_new();
    while ap < n && field_at(list_get(toks, ap), 0) != "RPAREN" {
        if field_at(list_get(toks, ap), 0) == "COMMA" { ap = ap + 1; }
        let ar: List[String] = llvm_emit_expr(toks, ap, n, cur_env);
        arg_vals = list_push(arg_vals, list_get(ar, 0));
        arg_tys = list_push(arg_tys, list_get(ar, 1));
        ap = parse_int(list_get(ar, 2));
        cur_env = llvm_pack_env5(ar, 3);
    }
    if ap < n && field_at(list_get(toks, ap), 0) == "RPAREN" { ap = ap + 1; }
    return llvm_emit_dyn_call(ttab, tname, mname, target, arg_vals, arg_tys, ap, cur_env);
}

fn llvm_emit_slit(txt: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let stab: String = llvm_env_get_var_ty(env, "__stab__");
    let mut cur_env: List[String] = env;
    let reg_res: List[String] = llvm_gen_reg(cur_env);
    let t_slot: String = list_get(reg_res, 0) + ".slit";
    cur_env = llvm_pack_env5(reg_res, 1);
    println("  " + t_slot + " = alloca %struct." + txt + ", align 8");
    let mut p_lit = pos + 2;
    while p_lit < n && field_at(list_get(toks, p_lit), 0) != "RBRACE" {
        if field_at(list_get(toks, p_lit), 0) == "COMMA" { p_lit = p_lit + 1; }
        if p_lit >= n || field_at(list_get(toks, p_lit), 0) != "IDENT" { break; }
        let fname: String = field_at(list_get(toks, p_lit), 3); p_lit = p_lit + 1;
        if p_lit < n && field_at(list_get(toks, p_lit), 0) == "COLON" { p_lit = p_lit + 1; }
        let f_val_res: List[String] = llvm_emit_expr(toks, p_lit, n, cur_env);
        let f_val: String = list_get(f_val_res, 0);
        let f_ty: String = list_get(f_val_res, 1);
        p_lit = parse_int(list_get(f_val_res, 2));
        cur_env = llvm_pack_env5(f_val_res, 3);
        let fidx: Int = 0 + llvm_struct_field_idx(stab, txt, fname);
        let reg_gep: List[String] = llvm_gen_reg(cur_env);
        let fptr: String = list_get(reg_gep, 0);
        cur_env = llvm_pack_env5(reg_gep, 1);
        println("  " + fptr + " = getelementptr inbounds %struct." + txt + ", %struct." + txt + "* " + t_slot + ", i32 0, i32 " + fidx.to_string());
        println("  store " + f_ty + " " + f_val + ", " + f_ty + "* " + fptr + ", align 8");
    }
    if p_lit < n && field_at(list_get(toks, p_lit), 0) == "RBRACE" { p_lit = p_lit + 1; }
    let reg_ld: List[String] = llvm_gen_reg(cur_env);
    let t_val: String = list_get(reg_ld, 0);
    cur_env = llvm_pack_env5(reg_ld, 1);
    println("  " + t_val + " = load %struct." + txt + ", %struct." + txt + "* " + t_slot + ", align 8");
    return llvm_out_val(t_val, "%struct." + txt, p_lit, cur_env);
}

pub fn llvm_emit_primary(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let tok: String = list_get(toks, pos);
    let k: String = field_at(tok, 0);
    let txt: String = field_at(tok, 3);
    let mut cur_env: List[String] = env;
    if k == "INT" { return llvm_out_val(txt, "i64", pos + 1, env); }
    if k == "FLOAT" { return llvm_out_val(txt, "double", pos + 1, env); }
    if k == "KW_TRUE" { return llvm_out_val("1", "i32", pos + 1, env); }
    if k == "KW_FALSE" { return llvm_out_val("0", "i32", pos + 1, env); }
    if k == "STRING" {
        let str_res: List[String] = llvm_add_str_lit(txt, cur_env);
        let sconst: String = list_get(str_res, 0);
        let slen: String = list_get(str_res, 1);
        cur_env = llvm_pack_env5(str_res, 2);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        println("  " + treg + " = call %OoStr @oo_str_lit(i8* getelementptr inbounds ([" + slen + " x i8], [" + slen + " x i8]* " + sconst + ", i64 0, i64 0))");
        return llvm_out_val(treg, "%OoStr", pos + 1, cur_env);
    }
    if k == "IDENT" {
        if txt == "println" || txt == "print" || txt == "eprintln" { return llvm_emit_builtin_println(toks, pos, n, env); }
        if txt == "assert" || txt == "assert_eq" || txt == "assert_ne" { return llvm_emit_builtin_assert(txt, toks, pos, n, env); }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "LPAREN" {
            let cr: List[String] = llvm_emit_call_expr(txt, toks, pos, n, env);
            let cp = 0 + parse_int(list_get(cr, 2));
            if cp < n && field_at(list_get(toks, cp), 0) == "DOT" {
                return llvm_emit_method_val(list_get(cr, 0), list_get(cr, 1), toks, cp, n, llvm_pack_env5(cr, 3));
            }
            return cr;
        }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "LBRACE" {
            let p2 = pos + 2;
            if p2 < n && (field_at(list_get(toks, p2), 0) == "RBRACE" || (p2 + 1 < n && field_at(list_get(toks, p2 + 1), 0) == "COLON")) {
                return llvm_emit_slit(txt, toks, pos, n, cur_env);
            }
        }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "DOT" {
            let vty: String = llvm_env_get_var_ty(env, txt);
            let lty: String = llvm_ty_map(vty);
            let is_meth = pos + 3 < n && field_at(list_get(toks, pos + 3), 0) == "LPAREN";
            if chars_len(lty) >= 5 && str_slice(lty, 0, 5) == "%dyn." && is_meth {
                let g: List[String] = llvm_gen_reg(cur_env);
                let treg: String = list_get(g, 0);
                cur_env = llvm_pack_env5(g, 1);
                println("  " + treg + " = load " + lty + ", " + lty + "* %" + llvm_env_slot(cur_env, txt) + ".slot, align 8");
                return llvm_dyn_arg_call(llvm_scan_traits(toks, n), str_slice(lty, 5, chars_len(lty)), field_at(list_get(toks, pos + 2), 3), treg, toks, pos + 4, n, cur_env);
            }
            if is_meth && field_at(list_get(toks, pos + 2), 3) == "contains" {
                let gld: List[String] = llvm_gen_reg(cur_env);
                let rv: String = list_get(gld, 0);
                cur_env = llvm_pack_env5(gld, 1);
                println("  " + rv + " = load " + lty + ", " + lty + "* %" + llvm_env_slot(cur_env, txt) + ".slot, align 8");
                let ar: List[String] = llvm_emit_expr(toks, pos + 4, n, cur_env);
                let mut ap = 0 + parse_int(list_get(ar, 2));
                cur_env = llvm_pack_env5(ar, 3);
                if ap < n && field_at(list_get(toks, ap), 0) == "RPAREN" { ap = ap + 1; }
                let gc: List[String] = llvm_gen_reg(cur_env);
                let crv: String = list_get(gc, 0);
                cur_env = llvm_pack_env5(gc, 1);
                println("  " + crv + " = call i32 @oo_str_contains(%OoStr " + rv + ", %OoStr " + list_get(ar, 0) + ")");
                return llvm_out_val(crv, "i32", ap, cur_env);
            }
            if chars_len(lty) >= 8 && str_slice(lty, 0, 8) == "%struct." && !is_meth {
                let f_res: List[String] = llvm_emit_struct_field_get(txt, field_at(list_get(toks, pos + 2), 3), cur_env);
                return llvm_out_val(list_get(f_res, 0), list_get(f_res, 1), pos + 3, llvm_pack_env5(f_res, 2));
            }
            return llvm_emit_method(txt, toks, pos + 1, n, env);
        }
        if txt == "None" { return llvm_emit_none(pos + 1, env); }
        if txt == "void" { return llvm_out_val("zeroinitializer", "void", pos + 1, env); }
        let ctor: String = llvm_env_get_var_ty(env, "__ctor__" + txt);
        if ctor != "" {
            let reg: List[String] = llvm_gen_reg(cur_env);
            let tr: String = list_get(reg, 0);
            cur_env = llvm_pack_env5(reg, 1);
            println("  " + tr + " = insertvalue %struct." + c_sum_ty_of(ctor) + " zeroinitializer, i32 " + c_sum_tag_of(ctor) + ", 0");
            return llvm_out_val(tr, "%struct." + c_sum_ty_of(ctor), pos + 1, cur_env);
        }
        let lty: String = llvm_ty_map(llvm_env_get_var_ty(env, txt));
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        println("  " + treg + " = load " + lty + ", " + lty + "* %" + llvm_env_slot(cur_env, txt) + ".slot, align 8");
        return llvm_out_val(treg, lty, pos + 1, cur_env);
    }
    if k == "LPAREN" {
        let sub_res: List[String] = llvm_emit_expr(toks, pos + 1, n, env);
        let mut p = 0 + parse_int(list_get(sub_res, 2));
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
        return llvm_out_val(list_get(sub_res, 0), list_get(sub_res, 1), p, llvm_pack_env5(sub_res, 3));
    }
    if k == "MINUS" {
        let sub: List[String] = llvm_emit_primary(toks, pos + 1, n, env);
        let sv: String = list_get(sub, 0);
        let sty: String = list_get(sub, 1);
        let reg_res: List[String] = llvm_gen_reg(llvm_pack_env5(sub, 3));
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        let p = 0 + parse_int(list_get(sub, 2));
        if sty == "double" { println("  " + treg + " = fsub double 0.0, " + sv); return llvm_out_val(treg, "double", p, cur_env); }
        println("  " + treg + " = sub i64 0, " + sv);
        return llvm_out_val(treg, "i64", p, cur_env);
    }
    if k == "KW_MATCH" { return llvm_emit_match_expr(toks, pos, n, env); }
    if k == "BANG" {
        let sub: List[String] = llvm_emit_primary(toks, pos + 1, n, env);
        let sv: String = list_get(sub, 0);
        let sty: String = list_get(sub, 1);
        cur_env = llvm_pack_env5(sub, 3);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        let reg2: List[String] = llvm_gen_reg(cur_env);
        let treg2: String = list_get(reg2, 0);
        cur_env = llvm_pack_env5(reg2, 1);
        if sty == "i32" { println("  " + treg + " = icmp eq i32 " + sv + ", 0"); }
        else { println("  " + treg + " = icmp eq i64 " + sv + ", 0"); }
        println("  " + treg2 + " = zext i1 " + treg + " to i32");
        let p = 0 + parse_int(list_get(sub, 2));
        return llvm_out_val(treg2, "i32", p, cur_env);
    }
    return llvm_out_val("0", "i64", pos + 1, env);
}

pub fn llvm_emit_expr_prec(toks: List[String], pos: Int, n: Int, env: List[String], min_prec: Int) -> List[String] {
    let lhs0: List[String] = llvm_emit_primary(toks, pos, n, env);
    let mut lhs_val: String = list_get(lhs0, 0);
    let mut lhs_ty: String = list_get(lhs0, 1);
    let mut p = 0 + parse_int(list_get(lhs0, 2));
    let mut cur_env: List[String] = llvm_pack_env5(lhs0, 3);
    let mut guard = 0;
    while guard < 64 {
        if p >= n { return llvm_out_val(lhs_val, lhs_ty, p, cur_env); }
        let op_k: String = field_at(list_get(toks, p), 0);
        if op_k == "QUESTION" {
            let tr: List[String] = llvm_emit_try(lhs_val, lhs_ty, cur_env);
            lhs_val = list_get(tr, 0); lhs_ty = list_get(tr, 1); p = p + 1; cur_env = llvm_pack_env5(tr, 2);
        } else if op_k == "DOT" {
            if chars_len(lhs_ty) >= 5 && str_slice(lhs_ty, 0, 5) == "%dyn." {
                let dcall: List[String] = llvm_dyn_arg_call(llvm_scan_traits(toks, n), str_slice(lhs_ty, 5, chars_len(lhs_ty)), field_at(list_get(toks, p + 1), 3), lhs_val, toks, p + 3, n, cur_env);
                lhs_val = list_get(dcall, 0); lhs_ty = list_get(dcall, 1); p = parse_int(list_get(dcall, 2)); cur_env = llvm_pack_env5(dcall, 3);
            } else {
                let meth: List[String] = llvm_emit_method_val(lhs_val, lhs_ty, toks, p, n, cur_env);
                lhs_val = list_get(meth, 0); lhs_ty = list_get(meth, 1); p = parse_int(list_get(meth, 2)); cur_env = llvm_pack_env5(meth, 3);
            }
        } else {
            let prec = 0 + llvm_binop_prec(op_k);
            if prec < min_prec { return llvm_out_val(lhs_val, lhs_ty, p, cur_env); }
            p = p + 1;
            let rhs: List[String] = llvm_emit_expr_prec(toks, p, n, cur_env, prec + 1);
            let rhs_val: String = list_get(rhs, 0); p = parse_int(list_get(rhs, 2)); cur_env = llvm_pack_env5(rhs, 3);
            let applied: List[String] = llvm_apply_binop(op_k, lhs_val, lhs_ty, rhs_val, list_get(rhs, 1), cur_env);
            lhs_val = list_get(applied, 0); lhs_ty = list_get(applied, 1); cur_env = llvm_pack_env5(applied, 2);
        }
        guard = guard + 1;
    }
    return llvm_out_val(lhs_val, lhs_ty, p, cur_env);
}

pub fn llvm_emit_expr(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    return llvm_emit_expr_prec(toks, pos, n, env, 1);
}
