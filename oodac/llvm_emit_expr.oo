// # Lower expressions to LLVM
//
// Logline: Emits a primary or Pratt-parsed binop as LLVM IR and returns value, type, pos, and the five-slot env.
//
// Setup: llvm_gen_reg, llvm_add_str_lit, llvm_env_get_var_ty, llvm_ty_map, llvm_emit_builtin_println, llvm_emit_builtin_assert, llvm_emit_call_expr, and llvm_emit_method exist.
//
// Beats:
//   1. llvm_emit_slit allocates and initializes struct literals via GEP stores.
//   2. llvm_emit_primary lowers ints, floats, bools, strings, calls, methods, struct fields, loads, parens, unary minus, and bang.
//   3. llvm_emit_expr_prec applies binops at min_prec via llvm_apply_binop; llvm_emit_expr starts at precedence 1.

import "token_fmt.oo";
import "llvm_emit_ty.oo";
import "llvm_emit_env.oo";
import "llvm_emit_mem.oo";
import "llvm_emit_call.oo";
import "llvm_emit_assert.oo";
import "llvm_emit_method.oo";
import "llvm_emit_binop.oo";

fn llvm_pack_env5(src: List[String], base: Int) -> List[String] {
    let mut e: List[String] = list_new();
    e = list_push(e, list_get(src, base));
    e = list_push(e, list_get(src, base + 1));
    e = list_push(e, list_get(src, base + 2));
    e = list_push(e, list_get(src, base + 3));
    e = list_push(e, list_get(src, base + 4));
    return e;
}

fn llvm_out_val(val: String, ty: String, p: Int, env: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, val);
    out = list_push(out, ty);
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(env, 0));
    out = list_push(out, list_get(env, 1));
    out = list_push(out, list_get(env, 2));
    out = list_push(out, list_get(env, 3));
    out = list_push(out, list_get(env, 4));
    return out;
}

fn llvm_emit_slit(txt: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let stab: String = llvm_env_get_var_ty(env, "__stab__");
    let mut cur_env: List[String] = env;
    let reg_res: List[String] = llvm_gen_reg(cur_env);
    let t_slot: String = list_get(reg_res, 0) + ".slit";
    cur_env = llvm_pack_env5(reg_res, 1);
    println("  " + t_slot + " = alloca %struct." + txt + ", align 8");
    let mut p_lit = pos + 2;
    while p_lit < n && field_at(list_get(toks, p_lit), 0) != "RBRACE" {
        if field_at(list_get(toks, p_lit), 0) == "COMMA" { p_lit = p_lit + 1; }
        if p_lit >= n || field_at(list_get(toks, p_lit), 0) != "IDENT" { break; }
        let fname: String = field_at(list_get(toks, p_lit), 3);
        p_lit = p_lit + 1;
        if p_lit < n && field_at(list_get(toks, p_lit), 0) == "COLON" { p_lit = p_lit + 1; }
        let f_val_res: List[String] = llvm_emit_expr(toks, p_lit, n, cur_env);
        let f_val: String = list_get(f_val_res, 0);
        let f_ty: String = list_get(f_val_res, 1);
        p_lit = parse_int(list_get(f_val_res, 2));
        cur_env = llvm_pack_env5(f_val_res, 3);
        let fidx: Int = 0 + llvm_struct_field_idx(stab, txt, fname);
        let reg_gep: List[String] = llvm_gen_reg(cur_env);
        let fptr: String = list_get(reg_gep, 0);
        cur_env = llvm_pack_env5(reg_gep, 1);
        println("  " + fptr + " = getelementptr inbounds %struct." + txt + ", %struct." + txt + "* " + t_slot + ", i32 0, i32 " + fidx.to_string());
        println("  store " + f_ty + " " + f_val + ", " + f_ty + "* " + fptr + ", align 8");
    }
    if p_lit < n && field_at(list_get(toks, p_lit), 0) == "RBRACE" { p_lit = p_lit + 1; }
    let reg_ld: List[String] = llvm_gen_reg(cur_env);
    let t_val: String = list_get(reg_ld, 0);
    cur_env = llvm_pack_env5(reg_ld, 1);
    println("  " + t_val + " = load %struct." + txt + ", %struct." + txt + "* " + t_slot + ", align 8");
    return llvm_out_val(t_val, "%struct." + txt, p_lit, cur_env);
}

pub fn llvm_emit_primary(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let tok: String = list_get(toks, pos);
    let k: String = field_at(tok, 0);
    let txt: String = field_at(tok, 3);
    let mut cur_env: List[String] = env;
    if k == "INT" { return llvm_out_val(txt, "i64", pos + 1, env); }
    if k == "FLOAT" { return llvm_out_val(txt, "double", pos + 1, env); }
    if k == "KW_TRUE" || k == "KW_FALSE" {
        let mut bval: String = "0";
        if k == "KW_TRUE" { bval = "1"; }
        return llvm_out_val(bval, "i32", pos + 1, env);
    }
    if k == "STRING" {
        let str_res: List[String] = llvm_add_str_lit(txt, cur_env);
        let sconst: String = list_get(str_res, 0);
        let slen: String = list_get(str_res, 1);
        cur_env = llvm_pack_env5(str_res, 2);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        println("  " + treg + " = call %OoStr @oo_str_lit(i8* getelementptr inbounds ([" + slen + " x i8], [" + slen + " x i8]* " + sconst + ", i64 0, i64 0))");
        return llvm_out_val(treg, "%OoStr", pos + 1, cur_env);
    }
    if k == "IDENT" {
        if txt == "println" || txt == "print" || txt == "eprintln" { return llvm_emit_builtin_println(toks, pos, n, env); }
        if txt == "assert" || txt == "assert_eq" || txt == "assert_ne" { return llvm_emit_builtin_assert(txt, toks, pos, n, env); }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "LPAREN" { return llvm_emit_call_expr(txt, toks, pos + 1, n, env); }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "LBRACE" {
            let p2 = pos + 2;
            if p2 < n && (field_at(list_get(toks, p2), 0) == "RBRACE" || (p2 + 1 < n && field_at(list_get(toks, p2 + 1), 0) == "COLON")) {
                return llvm_emit_slit(txt, toks, pos, n, cur_env);
            }
        }
        if pos + 1 < n && field_at(list_get(toks, pos + 1), 0) == "DOT" {
            let vty_ooda: String = llvm_env_get_var_ty(env, txt);
            let lty: String = llvm_ty_map(vty_ooda);
            let is_struct = chars_len(lty) >= 8 && str_slice(lty, 0, 8) == "%struct.";
            let is_meth = pos + 3 < n && field_at(list_get(toks, pos + 3), 0) == "LPAREN";
            if is_struct && !is_meth {
                let fname: String = field_at(list_get(toks, pos + 2), 3);
                let f_res: List[String] = llvm_emit_struct_field_get(txt, fname, cur_env);
                let fval: String = list_get(f_res, 0);
                let fty: String = list_get(f_res, 1);
                cur_env = llvm_pack_env5(f_res, 2);
                return llvm_out_val(fval, fty, pos + 3, cur_env);
            }
            return llvm_emit_method(txt, toks, pos + 1, n, env);
        }
        let vty_ooda: String = llvm_env_get_var_ty(env, txt);
        let lty: String = llvm_ty_map(vty_ooda);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        println("  " + treg + " = load " + lty + ", " + lty + "* %" + txt + ".slot, align 8");
        return llvm_out_val(treg, lty, pos + 1, cur_env);
    }
    if k == "LPAREN" {
        let sub_res: List[String] = llvm_emit_expr(toks, pos + 1, n, env);
        let r_val: String = list_get(sub_res, 0);
        let r_ty: String = list_get(sub_res, 1);
        let mut p = 0 + parse_int(list_get(sub_res, 2));
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
        cur_env = llvm_pack_env5(sub_res, 3);
        return llvm_out_val(r_val, r_ty, p, cur_env);
    }
    if k == "MINUS" {
        let sub: List[String] = llvm_emit_primary(toks, pos + 1, n, env);
        let sv: String = list_get(sub, 0);
        let sty: String = list_get(sub, 1);
        cur_env = llvm_pack_env5(sub, 3);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        if sty == "double" {
            println("  " + treg + " = fsub double 0.0, " + sv);
            let p = 0 + parse_int(list_get(sub, 2));
            return llvm_out_val(treg, "double", p, cur_env);
        }
        println("  " + treg + " = sub i64 0, " + sv);
        let p = 0 + parse_int(list_get(sub, 2));
        return llvm_out_val(treg, "i64", p, cur_env);
    }
    if k == "BANG" {
        let sub: List[String] = llvm_emit_primary(toks, pos + 1, n, env);
        let sv: String = list_get(sub, 0);
        let sty: String = list_get(sub, 1);
        cur_env = llvm_pack_env5(sub, 3);
        let reg_res: List[String] = llvm_gen_reg(cur_env);
        let treg: String = list_get(reg_res, 0);
        cur_env = llvm_pack_env5(reg_res, 1);
        let reg2: List[String] = llvm_gen_reg(cur_env);
        let treg2: String = list_get(reg2, 0);
        cur_env = llvm_pack_env5(reg2, 1);
        if sty == "i32" { println("  " + treg + " = icmp eq i32 " + sv + ", 0"); }
        else { println("  " + treg + " = icmp eq i64 " + sv + ", 0"); }
        println("  " + treg2 + " = zext i1 " + treg + " to i32");
        let p = 0 + parse_int(list_get(sub, 2));
        return llvm_out_val(treg2, "i32", p, cur_env);
    }
    return llvm_out_val("0", "i64", pos + 1, env);
}

pub fn llvm_emit_expr_prec(toks: List[String], pos: Int, n: Int, env: List[String], min_prec: Int) -> List[String] {
    let lhs0: List[String] = llvm_emit_primary(toks, pos, n, env);
    let mut lhs_val: String = list_get(lhs0, 0);
    let mut lhs_ty: String = list_get(lhs0, 1);
    let mut p = 0 + parse_int(list_get(lhs0, 2));
    let mut cur_env: List[String] = llvm_pack_env5(lhs0, 3);
    let mut guard = 0;
    while guard < 64 {
        if p >= n { return llvm_out_val(lhs_val, lhs_ty, p, cur_env); }
        let op_k: String = field_at(list_get(toks, p), 0);
        let prec = 0 + llvm_binop_prec(op_k);
        if prec < min_prec { return llvm_out_val(lhs_val, lhs_ty, p, cur_env); }
        p = p + 1;
        let rhs: List[String] = llvm_emit_expr_prec(toks, p, n, cur_env, prec + 1);
        let rhs_val: String = list_get(rhs, 0);
        p = parse_int(list_get(rhs, 2));
        cur_env = llvm_pack_env5(rhs, 3);
        let applied: List[String] = llvm_apply_binop(op_k, lhs_val, lhs_ty, rhs_val, cur_env);
        lhs_val = list_get(applied, 0);
        lhs_ty = list_get(applied, 1);
        cur_env = llvm_pack_env5(applied, 2);
        guard = guard + 1;
    }
    return llvm_out_val(lhs_val, lhs_ty, p, cur_env);
}

pub fn llvm_emit_expr(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    return llvm_emit_expr_prec(toks, pos, n, env, 1);
}
