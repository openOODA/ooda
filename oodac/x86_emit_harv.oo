// # Harvest helpers for emit-x86 println consts
//
// Logline: Resolves same-fn binds, negates const decimal digits, and mixes string plus int text.
//
// Setup: field_at exists. x86_collect_prints in x86_emit_walk.oo calls these helpers.
//
// Beats:
//   1. Index the last same-fn string or int bind by name.
//   2. Fold a STRING plus STRING chain.
//   3. Negate const digits; a leading minus becomes unsigned.
//   4. mix_try appends INT, minus digits, or an int bind next to a string; SEMI ends a let.
//
// residual: greet-call lets, SysV, and AArch64 stay later. ALU lives in x86_emit_alu.oo.

import "token_fmt.oo";

pub fn x86_bind_idx(names: List[String], name: String) -> Int {
    let n = list_len(names);
    let mut found = -1;
    let mut i = 0;
    while i < n {
        if list_get(names, i) == name {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

pub fn x86_tok_k(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 0);
}

pub fn x86_tok_t(toks: List[String], i: Int) -> String {
    return field_at(list_get(toks, i), 3);
}

pub fn x86_str_after(toks: List[String], n: Int, j: Int) -> Int {
    let mut p = j + 1;
    while p + 1 < n {
        if x86_tok_k(toks, p) != "PLUS" {
            return p;
        }
        if x86_tok_k(toks, p + 1) != "STRING" {
            return p;
        }
        p = p + 2;
    }
    return p;
}

pub fn x86_str_fold(toks: List[String], n: Int, j: Int) -> String {
    let mut o: String = x86_tok_t(toks, j);
    let mut p = j + 1;
    while p + 1 < n {
        if x86_tok_k(toks, p) != "PLUS" {
            return o;
        }
        if x86_tok_k(toks, p + 1) != "STRING" {
            return o;
        }
        o = o + x86_tok_t(toks, p + 1);
        p = p + 2;
    }
    return o;
}

pub fn x86_neg_dec(s: String) -> String {
    if chars_len(s) <= 0 {
        return "0";
    }
    if char_at(s, 0) == "-" {
        let n = chars_len(s);
        let mut o = "";
        let mut i = 1;
        while i < n {
            o = o + char_at(s, i);
            i = i + 1;
        }
        if chars_len(o) <= 0 {
            return "0";
        }
        return o;
    }
    if s == "0" {
        return "0";
    }
    return "-" + s;
}

fn x86_mix_num_ok(toks: List[String], n: Int, p: Int, any: Bool) -> Bool {
    if p + 2 < n {
        if x86_tok_k(toks, p + 1) == "PLUS" {
            if x86_tok_k(toks, p + 2) == "INT" {
                return false;
            }
        }
    }
    if any {
        return true;
    }
    if p + 2 >= n {
        return false;
    }
    if x86_tok_k(toks, p + 1) != "PLUS" {
        return false;
    }
    return x86_tok_k(toks, p + 2) == "STRING";
}

pub fn x86_mix_try(toks: List[String], n: Int, j: Int, names: List[String], vals: List[String], inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    let mut out = "";
    let mut p = j;
    let mut any = false;
    while p < n {
        let k: String = x86_tok_k(toks, p);
        if k == "STRING" {
            out = out + x86_tok_t(toks, p);
            any = true;
            p = p + 1;
        } else if k == "IDENT" {
            if p + 1 < n && x86_tok_k(toks, p + 1) == "LPAREN" {
                return empty;
            }
            let nm: String = x86_tok_t(toks, p);
            let sidx = x86_bind_idx(names, nm);
            if sidx >= 0 {
                out = out + list_get(vals, sidx);
                any = true;
                p = p + 1;
            } else {
                let iidx = x86_bind_idx(inames, nm);
                if iidx < 0 || !x86_mix_num_ok(toks, n, p, any) {
                    return empty;
                }
                out = out + list_get(ivals, iidx);
                any = true;
                p = p + 1;
            }
        } else if k == "INT" {
            if !x86_mix_num_ok(toks, n, p, any) {
                return empty;
            }
            out = out + x86_tok_t(toks, p);
            any = true;
            p = p + 1;
        } else if k == "MINUS" {
            if p + 1 >= n {
                return empty;
            }
            let nk: String = x86_tok_k(toks, p + 1);
            let mut digits = "";
            let mut adv = 2;
            if nk == "INT" {
                digits = x86_neg_dec(x86_tok_t(toks, p + 1));
            } else if nk == "IDENT" {
                if p + 2 < n && x86_tok_k(toks, p + 2) == "LPAREN" {
                    return empty;
                }
                let nidx = x86_bind_idx(inames, x86_tok_t(toks, p + 1));
                if nidx < 0 {
                    return empty;
                }
                digits = x86_neg_dec(list_get(ivals, nidx));
            } else {
                return empty;
            }
            if p + adv + 1 < n {
                if x86_tok_k(toks, p + adv) == "PLUS" {
                    if x86_tok_k(toks, p + adv + 1) == "INT" {
                        return empty;
                    }
                }
            }
            if !any {
                if p + adv + 1 >= n {
                    return empty;
                }
                if x86_tok_k(toks, p + adv) != "PLUS" {
                    return empty;
                }
                if x86_tok_k(toks, p + adv + 1) != "STRING" {
                    return empty;
                }
            }
            out = out + digits;
            any = true;
            p = p + adv;
        } else {
            return empty;
        }
        if p < n && x86_tok_k(toks, p) == "PLUS" {
            p = p + 1;
        } else if p < n && x86_tok_k(toks, p) == "RPAREN" {
            if any {
                let mut one: List[String] = list_new();
                one = list_push(one, out);
                return one;
            }
            return empty;
        } else if p < n && x86_tok_k(toks, p) == "SEMI" {
            if any {
                let mut one: List[String] = list_new();
                one = list_push(one, out);
                return one;
            }
            return empty;
        } else {
            return empty;
        }
    }
    return empty;
}
