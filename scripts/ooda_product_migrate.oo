// # OODA Product Migrate
//
// Logline: ooda migrate stays FAIL-CLOSED — the prior sed let→let mut rewrite silently destroyed immutability (SPRINT #14).
// Beats: detect --json | print ERR resp | exit 1.

import "std/scenario.oo";
import "std/sh.oo";

const MSG: String = "ooda migrate is disabled (SPRINT Issue #14). Prior sed let->let mut was unsafe. Use ooda fix / manual edit; back up first if you rewrite yourself.";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "ooda migrate fail-closed residual");

    // when: --json flag is present, emit a JSON error
    // and: otherwise emit ERR\tmigrate + stderr
    // then: exit 1 unconditionally
    let args = match process_exec(p, "echo \"$@\"") { Ok(s) => s, Err(_) => "" };
    expect_clean(p, "echo \"$args\" | grep -q -- '--json' || true");

    println("{\"error\":\"E_MIGRATE_DISABLED\",\"msg\":\"" + MSG + "\",\"changed\":false,\"let_mut_fixes\":0}");
    println("ERR\tmigrate\t" + MSG);
    println("ooda_product_migrate: PASSED (fail-closed)");
}
