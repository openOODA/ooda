// ===================================================================
// OODA Product Migrate
// ===================================================================
// job: ooda product CLI migrate backend — FAIL-CLOSED residual
// in:  args (ignored for rewrite; only diagnostics)
// out: stderr honesty + non-zero exit (RULES §1.3)
//
// SPRINT Issue #14: previous implementation ran
//   sed -i 's/\blet X =/let mut X =/g'
// which silently destroyed immutability. Disabled until a real AST codemod
// lands (ooda fix / edition engine). Do not re-enable soft sed.

import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    // Check for --json in arguments
    let args = process_args(p);
    let mut json_mode = false;
    let mut i = 1;
    while i < list_len(args) {
        if list_get(args, i) == "--json" {
            json_mode = true;
        }
        i = i + 1;
    }
    
    let msg = "ooda migrate is disabled (SPRINT Issue #14). Prior sed let->let mut was unsafe. Use ooda fix / manual edit; back up first if you rewrite yourself.";
    
    if json_mode {
        println("{\"error\":\"E_MIGRATE_DISABLED\",\"msg\":\"" + msg + "\",\"changed\":false,\"let_mut_fixes\":0}");
    } else {
        println("ERR\tmigrate\t" + msg);
    }
    
    process_exit(1);
}

fn process_args(p: &ProcessCap) -> List[String] {
    let mut args: List[String] = list_new();
    return args;
}
