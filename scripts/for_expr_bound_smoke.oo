// # For Loop Range Bounds and Collection Iteration Smoke
// Logline: Verify for loop range bounds (0..n, 0..len), for-in collection iteration, and element extraction on List[Int], List[String], and List[Name] compile with GCC and execute cleanly.
// Setup: cwd is ooda/. Product oodac and runtime/chs_rt.c exist.
// Beats: 1. emit-c lowers range loops and collection iteration to C for loops | 2. GCC compiles emitted code | 3. execute binary and assert boundary ranges (0..0, 0..1, 0..N) and element extractions

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/for_expr_bound";

    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    // Beat 1: Create fixture exercising range for and for-in iteration
    let for_src = tmpd + "/for_fixture.oo";
    let w1 = process_exec(p, "printf 'pub type Point = struct {\\n    x: Int,\\n    y: Int,\\n};\\n\\npub fn sum_range(n: Int) -> Int {\\n    let mut sum: Int = 0;\\n    for i in 0..n {\\n        sum = sum + i;\\n    }\\n    return sum;\\n}\\n\\npub fn sum_dyn_upper(n: Int) -> Int {\\n    let mut sum: Int = 0;\\n    for i in 0..(n - 1) {\\n        sum = sum + i;\\n    }\\n    return sum;\\n}\\n\\npub fn sum_dyn_both(start: Int, end: Int) -> Int {\\n    let mut sum: Int = 0;\\n    for i in (start + 1)..(end - 1) {\\n        sum = sum + i;\\n    }\\n    return sum;\\n}\\n\\npub fn sum_dyn_len(xs: List[Int]) -> Int {\\n    let mut sum: Int = 0;\\n    for i in 0..(list_len(xs) - 1) {\\n        sum = sum + list_get(xs, i);\\n    }\\n    return sum;\\n}\\n\\npub fn sum_list_ints(xs: List[Int]) -> Int {\\n    let mut total: Int = 0;\\n    for val in xs {\\n        total = total + val;\\n    }\\n    return total;\\n}\\n\\npub fn concat_list_strs(xs: List[String]) -> String {\\n    let mut out: String = \"\";\\n    let n: Int = list_len(xs);\\n    for i in 0..n {\\n        let s: String = list_get(xs, i);\\n        out = out + s;\\n    }\\n    return out;\\n}\\n\\npub fn sum_points(pts: List[Point]) -> Int {\\n    let mut total: Int = 0;\\n    let n: Int = list_len(pts);\\n    for i in 0..n {\\n        let p: Point = list_get(pts, i);\\n        total = total + p.x + p.y;\\n    }\\n    return total;\\n}\\n\\npub fn main() {\\n    let s0: Int = sum_range(0);\\n    if s0 != 0 { process_exit(1); }\\n    let s1: Int = sum_range(1);\\n    if s1 != 0 { process_exit(1); }\\n    let s5: Int = sum_range(5);\\n    if s5 != 10 { process_exit(1); }\\n\\n    let d1: Int = sum_dyn_upper(5);\\n    if d1 != 6 { process_exit(1); }\\n    let d2: Int = sum_dyn_both(1, 5);\\n    if d2 != 5 { process_exit(1); }\\n\\n    let mut ints: List[Int] = list_new();\\n    ints = list_push(ints, 10);\\n    ints = list_push(ints, 20);\\n    ints = list_push(ints, 30);\\n    let int_sum: Int = sum_list_ints(ints);\\n    if int_sum != 60 { process_exit(1); }\\n\\n    let d3: Int = sum_dyn_len(ints);\\n    if d3 != 30 { process_exit(1); }\\n\\n    let mut words: List[String] = list_new();\\n    words = list_push(words, \"Open\");\\n    words = list_push(words, \"OODA\");\\n    let joined: String = concat_list_strs(words);\\n    if joined != \"OpenOODA\" { process_exit(1); }\\n\\n    let mut pts: List[Point] = list_new();\\n    pts = list_push(pts, Point { x: 1, y: 2 });\\n    pts = list_push(pts, Point { x: 3, y: 4 });\\n    let pt_sum: Int = sum_points(pts);\\n    if pt_sum != 10 { process_exit(1); }\\n\\n    println(\"for_expr_bound: OK\");\\n}\\n' > " + for_src);
    if w1.is_err() { fail("write for_fixture.oo"); }

    let emit_res = process_exec(p, oodac + " emit-c " + for_src + " > " + tmpd + "/for.c 2> " + tmpd + "/for.err");
    if emit_res.is_err() { fail("emit-c for_fixture.oo"); }

    // Verify emitted C contains for loops
    let chk_for = process_exec(p, "grep -qE 'for \\(long long .+ = 0' " + tmpd + "/for.c");
    if chk_for.is_err() { fail("range for loop lowering missing in emitted C"); }

    // Beat 2: Compile with GCC
    let gcc_res = process_exec(p, "gcc -O2 -Iruntime runtime/chs_rt.c " + tmpd + "/for.c -lm -ldl -lpthread -o " + tmpd + "/for.bin");
    if gcc_res.is_err() { fail("gcc compile for_expr"); }

    // Beat 3: Run binary and verify output
    let run_res = process_exec(p, tmpd + "/for.bin > " + tmpd + "/for.out 2>&1");
    if run_res.is_err() { fail("run for_expr binary"); }

    let chk_out = process_exec(p, "grep -q 'for_expr_bound: OK' " + tmpd + "/for.out");
    if chk_out.is_err() { fail("for_expr output mismatch"); }

    println("for_expr_bound_smoke: PASSED");
}
