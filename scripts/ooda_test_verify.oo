// # OODA Test Verify
//
// Logline: pure-path `ooda test` — typecheck then run verify / contract fuzz harness; pure bash harness gen + emit-c + gcc only (M50); --fuzz [iters] / --seed / --verbose; fail-closed on check or build failure.
//
// Setup: Process capability and test fixtures available.
//
// Beats: arg parse (--fuzz, --seed, --verbose) | oodac check gate | harness gen | emit-c + gcc | run + OK verify.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ooda test_verify (pure path)");

    when "arg parse --fuzz [iters] / --seed / --verbose" {
    and  "oodac check gate fail-closed" {
    and  "verify / fuzz harness gen (ooda_verify_pure / ooda_fuzz_pure)" {
    and  "emit-c + oo_*_release decls inject + gcc -O2 + chs_rt" {
    and  "harness run; OK verify or FAIL on ensure violation" {
    then "ooda_test_verify PASSED" { } } } } }

    expect_present(fs, root + "/scripts/ooda_test_verify.sh");
    expect_substring(fs, root + "/scripts/ooda_test_verify.sh", "--fuzz");
    expect_substring(fs, root + "/scripts/ooda_test_verify.sh", "--seed");
    expect_substring(fs, root + "/scripts/ooda_test_verify.sh", "ooda_fuzz_pure.sh");
    expect_substring(fs, root + "/scripts/ooda_test_verify.sh", "ooda_verify_pure.sh");
    expect_substring(fs, root + "/scripts/ooda_test_verify.sh", "oo_slist_retain");
    expect_clean(p, "test -x " + oodac);
    println("ooda_test_verify: PASSED (pure verify/fuzz wired)");
}
