// # CHS Parity
//
// Logline: product pure CLI and pure oodac emit identical token/ast/check digests across the CHS corpus.
// Setup: oodac/oodac prebuilt; pure OODA optional (falls back to oodac for product CLI).
//
// Beats: tokens pass/fail | ast structure | check pass/fail | typecheck fail-closed | drift | host spine absent.

import "std/scenario.oo";
import "std/sh.oo";

const ROOT_TOK: String = "bootstrap/corpus/lex/pass";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "CHS token parity product≡oodac");

    when "lex pass corpus" {
        and  "ast structure corpus" {
        and  "check pass/fail corpus" {
        and  "typecheck fail-closed + drift" {
        then "no host spine modules reappear" {
        } } } }

    check(p, "for f in " + root + "/" + ROOT_TOK + "/*.oo " + root + "/fixtures/hello.oo " + root + "/fixtures/int_main.oo " + root + "/fixtures/while_count.oo; do "
        + root + "/scripts/chs_parity_lib.sh \"$f\" 2>/dev/null && echo OK_tokens || echo FAIL_tokens; done | grep -cE '^OK_tokens' | awk '{ if ($1>=4) exit 0; exit 1 }'", within: 60);

    check(p, "for f in " + root + "/bootstrap/corpus/parse/pass/*.oo " + root + "/bootstrap/corpus/check/pass/ok_main.oo; do "
        + root + "/scripts/chs_parity_lib.sh \"$f\" 2>/dev/null && echo OK_ast || echo FAIL_ast; done | grep -cE '^OK_ast' | awk '{ if ($1>=1) exit 0; exit 1 }'", within: 60);

    check(p, "source " + root + "/scripts/chs_parity_lib.sh && compare_check " + root + "/bootstrap/corpus/check/pass/ok_main.oo pass", within: 30);
    check(p, "source " + root + "/scripts/chs_parity_lib.sh && compare_check " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo fail", within: 30);

    expect_clean(p, "for f in " + root + "/bootstrap/corpus/typecheck/fail/*.oo; do "
        + "b=" + tmpd + "/tc_oodac.txt; rc=$(" + root + "/oodac/oodac check \"$f\" >\"$b\" 2>\"$b.err\"); "
        + "if [[ $rc -ne 0 ]] && grep -qiE 'ERR' \"$b\" \"$b.err\"; then echo OK_tc; else echo FAIL_tc; fi; done | grep -c FAIL_tc | awk '{ if ($1==0) exit 0; exit 1 }'");

    expect_clean(p, "! diff -q <(echo 'KW_FAKE 1 1 x') <(" + root + "/oodac/oodac tokens " + root + "/fixtures/int_main.oo 2>/dev/null | grep $'\\t') >/dev/null");
    expect_absent(fs, root + "/src/lexer");
    expect_absent(fs, root + "/src/typecheck");
    expect_absent(fs, root + "/src/codegen_c");

    println("chs_parity: PASSED");
}