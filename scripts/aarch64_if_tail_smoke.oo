// # emit-aarch64 if-cond tail lock
//
// Logline: Side emit-aarch64 folds if true==false, if true&&false, and if 1==1==0 without THEN.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. Each cond writes _start and does not emit THEN.
//   3. clang -target aarch64-linux-gnu -c is ARM aarch64.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn emit_none(p: &ProcessCap, fs: &FsReadCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if check(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail(tag + " emit"); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail(tag + " ERR"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(tag + " no _start"); }
    if expect_clean(p, "! grep -qF 'THEN' " + sfile).is_err() { fail(tag + " emitted THEN"); }
    if check(p, "clang -target aarch64-linux-gnu -c " + sfile + " -o " + sfile + ".o", 15).is_err() { fail(tag + " assemble"); }
    if expect_clean(p, "file " + sfile + ".o | grep -q 'ARM aarch64'").is_err() { fail(tag + " not ARM"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    let aarch64_side_src = fx + "aarch64_if_true_and.oo";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 if-cond tails").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x /usr/bin/clang").is_err() { fail("no clang"); }
    ensure_aarch64_side(p, root, prod, side);
    emit_none(p, fs, side, fx + "aarch64_if_true_eq.oo", tmpd + "/a64_teq.s", tmpd + "/a64_teq.err", "true_eq");
    emit_none(p, fs, side, fx + "aarch64_if_true_and.oo", tmpd + "/a64_tand.s", tmpd + "/a64_tand.err", "true_and");
    emit_none(p, fs, side, fx + "aarch64_if_eqeqeq.oo", tmpd + "/a64_eee.s", tmpd + "/a64_eee.err", "eqeqeq");
    println("aarch64_if_tail_smoke: PASSED");
}
