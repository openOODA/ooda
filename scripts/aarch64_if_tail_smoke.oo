// # emit-aarch64 incomplete if-cond leftover lock
//
// Logline: Side emit-aarch64 fail-closes if true==false, if true&&false, and if 1==1==0 with no _start.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only. Residual cond tails are leftover.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. Each incomplete-cond fixture prints ERR aarch64_emit.
//   3. Refuse a successful _start that omitted the tail.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn refuse(p: &ProcessCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if process_exec(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail(tag + " wrote _start");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() { fail(tag + " no ERR"); }
    if expect_clean(p, "grep -q aarch64_emit " + sfile + " " + serr).is_err() { fail(tag + " no aarch64_emit"); }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() { fail(tag + " silent omit"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 incomplete if-cond leftover").is_err() { fail("scenario"); }
    if expect_present(fs, fx + "aarch64_if_true_eq.oo").is_err() { fail("no true_eq"); }
    if expect_present(fs, fx + "aarch64_if_true_and.oo").is_err() { fail("no true_and"); }
    if expect_present(fs, fx + "aarch64_if_eqeqeq.oo").is_err() { fail("no eqeqeq"); }
    ensure_aarch64_side(p, root, prod, side);
    refuse(p, side, fx + "aarch64_if_true_eq.oo", tmpd + "/a64_teq.s", tmpd + "/a64_teq.err", "true_eq");
    refuse(p, side, fx + "aarch64_if_true_and.oo", tmpd + "/a64_tand.s", tmpd + "/a64_tand.err", "true_and");
    refuse(p, side, fx + "aarch64_if_eqeqeq.oo", tmpd + "/a64_eee.s", tmpd + "/a64_eee.err", "eqeqeq");
    println("aarch64_if_tail_smoke: PASSED");
}
