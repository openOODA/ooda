import "oodac/token_fmt.oo";
import "oodac/llvm_emit_arc.oo";
import "oodac/llvm_emit_env.oo";

pub fn main() {
    let mut lenv: List[String] = llvm_env_new();
    lenv = llvm_env_add_var(lenv, "n", "i64");
    println("after n: " + list_get(lenv, 3));
    lenv = llvm_env_push_scope(lenv);
    println("after push: " + list_get(lenv, 3));
    lenv = llvm_env_add_var(lenv, "__did_ret__", "i64");
    println("after ret: " + list_get(lenv, 3));
    lenv = llvm_emit_scope_exit(lenv);
    println("after pop: " + list_get(lenv, 3));
}
