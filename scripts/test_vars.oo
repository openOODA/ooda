import "oodac/token_fmt.oo";
import "oodac/llvm_emit_arc.oo";
import "oodac/llvm_emit_env.oo";

pub fn main() {
    let mut env = llvm_env_new();
    env = llvm_env_add_var(env, "n", "i64");
    println("after n: " + list_get(env, 3));
    env = llvm_env_push_scope(env);
    println("after push: " + list_get(env, 3));
    env = llvm_env_add_var(env, "__did_ret__", "i64");
    println("after ret: " + list_get(env, 3));
    env = llvm_emit_scope_exit(env);
    println("after pop: " + list_get(env, 3));
}
