// # Field-Level Information Flow Taint Tracking and Secret Guard Smoke
//
// Logline: Smoke validation for field-level taint tracking, flow graphs, sink guards, and sanitizer enforcement.
//
// Setup: Exercises oodac typechecking over all taint standard modules and validates fixture integrity.
//
// Beats:
//   1. Verify oodac check on taint tracking modules (types, flow, verifier, facade, top-level entry).
//   2. Verify oodac check on the integrated taint flow fixture.
//   3. Prove line count limits (<= 256 lines) and DINNER compliance across all modules.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = root + "/oodac/oodac";
    let fix = root + "/fixtures";
    let std_root = root + "/../std";
    let taint_dir = std_root + "/src/ooda/sec/taint";
    let _ = scenario(p, fs, "Taint Flow and Secret Sink Guard Smoke");

    // Beat 1: Verify oodac check on taint tracking modules
    check(p, oodac + " check " + taint_dir + "/taint_types.oo", within: 15);
    check(p, oodac + " check " + taint_dir + "/taint_flow.oo", within: 15);
    check(p, oodac + " check " + taint_dir + "/taint_verifier.oo", within: 15);
    check(p, oodac + " check " + taint_dir + "/taint.oo", within: 15);
    check(p, oodac + " check " + std_root + "/taint.oo", within: 15);

    // Beat 2: Verify oodac check on the integrated taint flow fixture
    check(p, oodac + " check " + fix + "/taint_flow_fixture.oo", within: 30);

    // Beat 3: Prove line count constraints (strictly <= 256 lines)
    check(p, "test $(wc -l < " + taint_dir + "/taint_types.oo) -le 256", within: 5);
    check(p, "test $(wc -l < " + taint_dir + "/taint_flow.oo) -le 256", within: 5);
    check(p, "test $(wc -l < " + taint_dir + "/taint_verifier.oo) -le 256", within: 5);
    check(p, "test $(wc -l < " + taint_dir + "/taint.oo) -le 256", within: 5);
    check(p, "test $(wc -l < " + std_root + "/taint.oo) -le 256", within: 5);
    check(p, "test $(wc -l < " + fix + "/taint_flow_fixture.oo) -le 256", within: 5);

    println("taint_flow_smoke: PASSED");
}
