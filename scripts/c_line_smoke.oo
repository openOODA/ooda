// # emit-c writes #line for gdb
//
// Logline: EMIT_NO_CONCAT emit-c of hello.oo stamps #line 1 with the path and #line N before main.
//
// Setup: cwd is ooda/. Product oodac/oodac. gcc -g is the debugger path; this lock is the directive text.
//
// Beats:
//   1. #line 1 contains hello.oo.
//   2. A #line N sits immediately above int main.
//   3. No ERR c_emit.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp";
    let hello = "fixtures/hello.oo";
    let c = tmpd + "/c_line_hello.c";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if !path_exists(fs, hello) { fail("no hello"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c " + hello + " > " + c).is_err() {
        fail("emit-c");
    }
    if process_exec(p, "test -s " + c + " && ! grep -qE '^ERR.c_emit' " + c).is_err() {
        fail("empty or ERR");
    }
    if process_exec(p, "grep -qE '^#line 1 \".*hello.oo\"' " + c).is_err() {
        fail("no #line 1 path");
    }
    if process_exec(p, "awk '/^int main/{exit !p} /^#line [0-9]+/{p=1}' " + c).is_err() {
        fail("no #line before main");
    }
    if process_exec(p, "awk 'f&&/^#line [0-9]+ \".*hello.oo\"/{found=1} /^int main/{f=1} END{exit !found}' " + c).is_err() {
        fail("no stmt #line after main");
    }
    println("c_line_smoke: PASSED");
}
