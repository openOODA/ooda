// # Emit a fuzz harness and run it
//
// Logline: Seed a corpus, write a harness, then oodac check and run it.
//
// Setup: ProcessCap and FsReadCap. oodac/oodac must exist. cwd is the product root.
//
// Beats:
//   1. Step a PRNG and count a 20-node valid/invalid split.
//   2. Write a harness with valid and invalid targets plus main.
//   3. Fail closed if write, grep, check, or run fails.
//
// residual: no source AST requires/ensures parse; synthetic emit only

import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";

fn die_res(msg: String) {
    println("ERR residual: " + msg);
    process_exit(1);
}

pub fn prng_step(st: Int) -> Int {
    let mut s: Int = st;
    if s == 0 { s = 42; }
    let raw: Int = s * 1103515245 + 12345;
    let next_st: Int = raw - (raw / 2147483648) * 2147483648;
    if next_st < 0 { return -next_st; }
    return next_st;
}

pub fn gen_int_val(st: Int, min_v: Int, max_v: Int) -> Int {
    let abs_raw: Int = prng_step(st);
    let choice: Int = abs_raw - (abs_raw / 10) * 10;
    if choice == 0 { return min_v; }
    if choice == 1 { return max_v; }
    if choice == 2 && min_v <= 0 && max_v >= 0 { return 0; }
    let span: Int = max_v - min_v + 1;
    if span <= 0 { return min_v; }
    let rem: Int = abs_raw - (abs_raw / span) * span;
    return min_v + rem;
}

pub fn build_corpus_counts(seed: Int, total_count: Int) -> Int {
    let mut st: Int = seed;
    let mut i: Int = 0;
    let mut valid_count: Int = 0;
    let mut invalid_count: Int = 0;
    while i < total_count {
        st = prng_step(st);
        let make_valid: Bool = (i - (i / 2) * 2) == 0;
        if make_valid {
            valid_count = valid_count + 1;
        } else {
            invalid_count = invalid_count + 1;
        }
        i = i + 1;
    }
    if valid_count + invalid_count != total_count { return 0 - 1; }
    if valid_count == 0 || invalid_count == 0 { return 0 - 1; }
    return valid_count * 1000 + invalid_count;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if process_exec(p, "mkdir -p .ooda-cache/ooda-tmp").is_err() { die_res("mkdir"); }
    let mut oodac: String = "oodac/oodac";
    if process_exec(p, "test -x oodac/oodac").is_err() {
        oodac = "./oodac/oodac";
        if process_exec(p, "test -x ./oodac/oodac").is_err() { die_res("oodac missing"); }
    }
    if !fs_path_exists(fs, oodac) { die_res("oodac missing"); }

    let packed: Int = build_corpus_counts(42, 20);
    if packed < 0 { die_res("corpus counts"); }
    let valid_count: Int = packed / 1000;
    let invalid_count: Int = packed - valid_count * 1000;
    let seed_int: Int = gen_int_val(101, 0, 10);

    let outp: String = ".ooda-cache/ooda-tmp/fuzz_emit_sample.oo";
    let wcmd: String = "printf '%s\\n' "
        + "'// generated by ooda_fuzz_emit.oo seed=" + seed_int.to_string() + "' "
        + "'pub fn fuzz_target_valid(x: Int) -> Int {' "
        + "'    return x + 1;' "
        + "'}' "
        + "'pub fn fuzz_target_invalid(x: Int) -> Int {' "
        + "'    return x - 1;' "
        + "'}' "
        + "'pub fn main() {' "
        + "'    let r: Int = fuzz_target_valid(10);' "
        + "'    println(\"fuzz_emit_run \" + r.to_string());' "
        + "'}' "
        + "> " + outp;
    if process_exec(p, wcmd).is_err() { die_res("write emit"); }
    if process_exec(p, "test -f " + outp).is_err() { die_res("emit missing"); }
    if process_exec(p, "grep -q fuzz_target_valid " + outp).is_err() { die_res("valid fn"); }
    if process_exec(p, "grep -q fuzz_target_invalid " + outp).is_err() { die_res("invalid fn"); }
    if process_exec(p, "grep -q 'pub fn main' " + outp).is_err() { die_res("emit main"); }
    if process_exec(p, oodac + " check " + outp).is_err() { die_res("check emit"); }
    if process_exec(p, oodac + " run " + outp + " .ooda-cache/ooda-tmp/fuzz_emit_bin").is_err() {
        die_res("run emit");
    }

    println("ooda_fuzz_emit: PASSED (corpus count=20 valid=" + valid_count.to_string()
        + " invalid=" + invalid_count.to_string() + ")");
}
