// # OPEN-68 import fntab lock
//
// Logline: Single-file emit-llvm of oodac/main.oo types parse_cli_argv as a string list.
//
// Setup: cwd is ooda/. OODAC may point at a side rebuild. Tree oodac is the default.
//
// Beats:
//   1. --backend llvm emit-llvm oodac/main.oo.
//   2. The parse_cli_argv call returns %OoSList, not i64.
//   3. Clang-link of full oodac remains residual.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let mut oodac = "./oodac/oodac";
    if path_exists(fs, tmpd + "/oodac_fntab") {
        oodac = tmpd + "/oodac_fntab";
    }
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if !path_exists(fs, "oodac/main.oo") { fail("no main.oo"); }
    if !path_exists(fs, "oodac/cli_emit.oo") { fail("no cli_emit"); }
    if process_exec(p, "grep -q 'llvm_import_fntab' oodac/cli_emit.oo").is_err() {
        fail("source missing llvm_import_fntab");
    }
    let ll = tmpd + "/open68_fntab.ll";
    let err = tmpd + "/open68_fntab.err";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " --backend llvm emit-llvm oodac/main.oo > " + ll + " 2> " + err).is_err() {
        fail("emit-llvm");
    }
    if process_exec(p, "grep -q 'call %OoSList @parse_cli_argv' " + ll).is_err() {
        fail("parse_cli_argv not %OoSList");
    }
    if process_exec(p, "grep -q 'call i64 @parse_cli_argv' " + ll).is_ok() {
        fail("parse_cli_argv still i64");
    }
    println("open68_fntab_smoke: clang link of full oodac is residual");
    println("open68_fntab_smoke: PASSED");
}
