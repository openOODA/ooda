// # Slice 1 body honesty scanner
//
// Logline: Scans Slice 1 .oo bodies for dummy alive, destub, untyped let, and header-lie defects and prints whole-tree debt.
//
// Setup: SysCap runs a body walk from ooda/. Notes and catalog files are not proof.
//
// Beats:
//   1. Walk Slice 1 result, option, str, byte, and core files.
//   2. Count dummy alive, destub, is_valid true, untyped let, process_exit, and header-lie.
//   3. Print whole-tree std counts as debt and fail closed if Slice 1 is dirty.

pub fn std_qa_honesty_cmd() -> String {
    let s1: String = "std/result.oo std/option.oo std/str.oo std/byte.oo std/core/crypto.oo std/core/json.oo std/core/list.oo std/core/option.oo std/core/result.oo std/core/str.oo";
    let awk: String = "awk '"
        + "function flush(){ if(fn==\"\")return; spec=0; if(hdr~/RFC|FIPS|NIST|Miller|Groth16|Kyber|ML-KEM|pairing|gzip|SHA|NTT/)spec=1;"
        + " stand=0; if(body~/[Dd]estub/||body~/is_valid[ \\t]*=[ \\t]*true/||body~/fake_k/||body~/_alive[ \\t]*\\([^)]*\\)[ \\t]*->[ \\t]*Int[ \\t]*\\{[ \\t]*return[ \\t]+1/)stand=1;"
        + " if(body~/crypto_sha256_internal/&&body!~/[Dd]estub/&&body!~/is_valid[ \\t]*=[ \\t]*true/&&body!~/fake_k/)stand=0;"
        + " if(spec&&stand)hl++; fn=\"\"; hdr=\"\"; body=\"\" }"
        + " FNR==1{flush(); fn=FILENAME}"
        + " FNR<=25{hdr=hdr $0 \"\\n\"}"
        + " {raw=$0; sub(\"//.*\",\"\",raw); if(raw~/^[ \\t]*let([ \\t]+mut)?[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*=/)ut++;"
        + " if($0~/[Dd]estub/)ds++; if($0~/is_valid[ \\t]*=[ \\t]*true/)iv++; if($0~/process_exit[ \\t]*\\(/)pe++;"
        + " if($0~/_alive[ \\t]*\\([^)]*\\)[ \\t]*->[ \\t]*Int[ \\t]*\\{[ \\t]*return[ \\t]+1/)al++; body=body $0 \"\\n\"}"
        + " END{flush(); printf \"%d %d %d %d %d %d\\n\",ut+0,ds+0,al+0,iv+0,pe+0,hl+0}'";
    return "echo 'std_qa_honesty slice1_paths " + s1 + "'; "
        + "s1='" + s1 + "'; "
        + "set -- $(" + awk + " $s1); "
        + "echo std_qa_honesty slice1 untyped_let=$1 destub=$2 alive=$3 is_valid_true=$4 process_exit=$5 header_lie=$6; "
        + "s1u=$1; s1d=$2; s1a=$3; s1i=$4; s1p=$5; s1h=$6; "
        + "set -- $(" + awk + " $(find std -name '*.oo' -print)); "
        + "echo std_qa_honesty tree untyped_let=$1 destub=$2 alive=$3 is_valid_true=$4 process_exit=$5 header_lie=$6; "
        + "echo std_qa_honesty tree_debt_not_pass; "
        + "if [ $((s1u+s1d+s1a+s1i+s1p+s1h)) -gt 0 ]; then echo 'std_qa_honesty: FAIL slice1'; exit 1; fi; "
        + "echo 'std_qa_honesty: PASS slice1'";
}

pub fn main(sys: &SysCap) {
    let cmd: String = std_qa_honesty_cmd();
    let res: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    match res {
        Ok(msg) => {
            println(msg);
        }
        Err(err) => {
            println(err);
            println("std_qa_honesty: FAIL slice1");
            process_exit(1);
        }
    }
}
