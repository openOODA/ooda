// # Standard library compliance QA master
//
// Logline: Runs Slice 1 honesty, SHA and slice locks, and each M4 smoke twice and exits nonzero if any child fails.
//
// Setup: ProcessCap launches ./bin/ooda from ooda/. Layer A or B red does not skip M4 twice-runs.
//
// Beats:
//   1. Run std_qa_honesty on Slice 1.
//   2. Run std_qa_sha256 and std_qa_slice1.
//   3. Run each of the four M4 smokes twice.
//   4. Exit 1 if any required child failed.

fn std_qa_master_run(p: &ProcessCap, label: String, rel: String) -> Int {
    println("std_qa_master run " + label);
    let cmd: String = "./bin/ooda run " + rel + " 2>&1";
    let r: Result[String, String] = process_exec(p, cmd);
    match r {
        Ok(s) => {
            println(s);
            println("std_qa_master child_ok " + label);
            return 0;
        }
        Err(e) => {
            println(e);
            println("std_qa_master child_fail " + label);
            return 1;
        }
    }
}

pub fn main(p: &ProcessCap) {
    let mut miss: Int = 0;
    miss = miss + std_qa_master_run(p, "honesty", "scripts/std_qa/std_qa_honesty.oo");
    miss = miss + std_qa_master_run(p, "sha256", "scripts/std_qa/std_qa_sha256.oo");
    miss = miss + std_qa_master_run(p, "slice1", "scripts/std_qa/std_qa_slice1.oo");
    miss = miss + std_qa_master_run(p, "m4_crypto_zk_1", "scripts/smoke_m4_crypto_zk.oo");
    miss = miss + std_qa_master_run(p, "m4_crypto_zk_2", "scripts/smoke_m4_crypto_zk.oo");
    miss = miss + std_qa_master_run(p, "m4_wire_codecs_1", "scripts/smoke_m4_wire_codecs.oo");
    miss = miss + std_qa_master_run(p, "m4_wire_codecs_2", "scripts/smoke_m4_wire_codecs.oo");
    miss = miss + std_qa_master_run(p, "m4_quant_finance_1", "scripts/smoke_m4_quant_finance.oo");
    miss = miss + std_qa_master_run(p, "m4_quant_finance_2", "scripts/smoke_m4_quant_finance.oo");
    miss = miss + std_qa_master_run(p, "m4_prove_m4_1", "scripts/prove_m4_expansion_smoke.oo");
    miss = miss + std_qa_master_run(p, "m4_prove_m4_2", "scripts/prove_m4_expansion_smoke.oo");
    if miss > 0 {
        println("std_qa_master: FAIL count " + miss.to_string());
        process_exit(1);
    }
    println("std_qa_master: PASS");
}
