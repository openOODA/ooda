// # Slice 1 list parse and byte locks
//
// Logline: Drives shipped list_first, list_last, parse_int, and byte_in_range and fails closed on hostile input.
//
// Setup: Imports std/core/list.oo, std/str.oo, and std/byte.oo. Run from ooda/.
//
// Beats:
//   1. Empty list_first and list_last must be Err with ERR tab.
//   2. Non-digit parse_int must be Err, not zero.
//   3. Byte value 256 is out of range; 0 and 255 are in range.

import "std/core/list.oo";
import "std/str.oo";
import "std/byte.oo";

fn std_qa_slice1_note(msg: String) {
    println("FAIL std_qa_slice1 " + msg);
}

pub fn std_qa_slice1_err_tab(msg: String) -> Bool {
    return msg.contains("ERR\t");
}

pub fn main() {
    let mut miss: Int = 0;
    let xs0: List[Int] = list_new();
    let fe: Result[Int, String] = list_first(xs0);
    match fe {
        Ok(v) => {
            std_qa_slice1_note("list_first empty Ok " + v.to_string());
            miss = miss + 1;
        }
        Err(e) => {
            if !std_qa_slice1_err_tab(e) {
                std_qa_slice1_note("list_first empty need ERR tab got " + e);
                miss = miss + 1;
            }
        }
    }
    let le: Result[Int, String] = list_last(xs0);
    match le {
        Ok(v) => {
            std_qa_slice1_note("list_last empty Ok " + v.to_string());
            miss = miss + 1;
        }
        Err(e) => {
            if !std_qa_slice1_err_tab(e) {
                std_qa_slice1_note("list_last empty need ERR tab got " + e);
                miss = miss + 1;
            }
        }
    }
    let mut xs1: List[Int] = list_new();
    xs1 = list_push(xs1, 7);
    let fo: Result[Int, String] = list_first(xs1);
    match fo {
        Ok(v) => {
            if v != 7 {
                std_qa_slice1_note("list_first want 7");
                miss = miss + 1;
            }
        }
        Err(e) => {
            std_qa_slice1_note("list_first 7 Err " + e);
            miss = miss + 1;
        }
    }
    let lo: Result[Int, String] = list_last(xs1);
    match lo {
        Ok(v) => {
            if v != 7 {
                std_qa_slice1_note("list_last want 7");
                miss = miss + 1;
            }
        }
        Err(e) => {
            std_qa_slice1_note("list_last 7 Err " + e);
            miss = miss + 1;
        }
    }
    if byte_in_range(256) {
        std_qa_slice1_note("byte 256 in range");
        miss = miss + 1;
    }
    if !byte_in_range(0) {
        std_qa_slice1_note("byte 0 out of range");
        miss = miss + 1;
    }
    if !byte_in_range(255) {
        std_qa_slice1_note("byte 255 out of range");
        miss = miss + 1;
    }
    let parsed: Int = parse_int("abc");
    std_qa_slice1_note("parse_int abc returned Int " + parsed.to_string() + " need Err ERR tab parse_int");
    miss = miss + 1;
    if miss > 0 {
        println("std_qa_slice1: FAIL count " + miss.to_string());
        process_exit(1);
    }
    println("std_qa_slice1: PASS");
}
