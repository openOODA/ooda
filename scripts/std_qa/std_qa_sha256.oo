// # SHA-256 FIPS 180-4 lock
//
// Logline: Compares live sha256 of empty text and of abc to the FIPS 180-4 hex strings.
//
// Setup: Import std/crypto/sha256.oo. Call product sha256. No SysCap.
//
// Beats:
//   1. Call sha256 on empty text. Length is 64. Digest equals the empty FIPS hex.
//   2. Call sha256 on abc. Length is 64. Digest equals the abc FIPS hex.
//   3. The two digests differ. Print std_qa_sha256 PASS. Exit 1 on fail.

import "std/crypto/sha256.oo";

fn fail_sha256(mark: String) {
    println("FAIL " + mark);
    process_exit(1);
}

fn std_qa_sha256() {
    let want_empty: String = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    let want_abc: String = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    let got_empty: String = sha256("");
    let got_abc: String = sha256("abc");
    let n_empty: Int = chars_len(got_empty);
    let n_abc: Int = chars_len(got_abc);
    if n_empty != 64 {
        fail_sha256("std_qa_sha256 empty length");
    }
    if n_abc != 64 {
        fail_sha256("std_qa_sha256 abc length");
    }
    if got_empty != want_empty {
        fail_sha256("std_qa_sha256 empty digest");
    }
    if got_abc != want_abc {
        fail_sha256("std_qa_sha256 abc digest");
    }
    if got_empty == got_abc {
        fail_sha256("std_qa_sha256 digests equal");
    }
    println("std_qa_sha256: PASS");
}

pub fn main() {
    std_qa_sha256();
}
