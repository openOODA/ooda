// # emit-x86 two println lock
//
// Logline: emit-x86 of fixtures/x86_twoprint.oo assembles and prints 1 then hi via as and ld.
//
// Setup: cwd is ooda/. GNU as and ld are on PATH. Host is x86_64. Product oodac/oodac.
//
// Beats:
//   1. emit-x86 fixtures/x86_twoprint.oo writes _start, main, syscall, and is not C.
//   2. as --64 and ld produce a binary whose stdout is 1 then hi, two lines.
//   3. Repeat emit+as+ld+run; both runs print 1 then hi.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld_two(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_twoprint_" + tag + ".s";
    let serr = tmpd + "/x86_twoprint_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86 " + tag);
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(".s missing _start " + tag); }
    if expect_substring(fs, sfile, "main:").is_err() { fail(".s missing main " + tag); }
    if expect_substring(fs, sfile, "syscall").is_err() { fail(".s missing syscall " + tag); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(".s looks like emit-c " + tag);
    }
    let obj = tmpd + "/x86_twoprint_" + tag + ".o";
    let bin = tmpd + "/x86_twoprint_" + tag + ".bin";
    let out = tmpd + "/x86_twoprint_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    if expect_clean(p, "head -n 1 " + out + " | grep -qx 1").is_err() { fail("line 1 not 1 " + tag); }
    if expect_clean(p, "sed -n '2p' " + out + " | grep -qx hi").is_err() { fail("line 2 not hi " + tag); }
    if expect_clean(p, "sed -n '$=' " + out + " | grep -qx 2").is_err() { fail("not 2 lines " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 two println").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_twoprint.oo";
    if expect_present(fs, src).is_err() { fail("no x86_twoprint.oo"); }
    emit_as_ld_two(p, fs, oodac, src, tmpd, "r1");
    emit_as_ld_two(p, fs, oodac, src, tmpd, "r2");
    println("x86_twoprint_smoke: PASSED");
}
