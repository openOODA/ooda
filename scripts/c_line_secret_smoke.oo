// # SECRET-concat emit-c stamps #line for entry and import
//
// Logline: Default emit-c of a two-file SECRET: program names both .oo paths.
//
// Setup: cwd is ooda/. Product oodac/oodac. No EMIT_NO_CONCAT on the pair.
//
// Beats:
//   1. #line 1 contains c_line_secret_main.oo.
//   2. #line 1 contains c_line_secret_lib.oo.
//   3. EMIT_NO_CONCAT hello still has #line 1 hello.oo and #line before main.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/c_line_secret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " emit-c fixtures/c_line_secret_main.oo > " + tmpd +
        "/secret_multi.c").is_err() {
        fail("emit secret multi");
    }
    if process_exec(p, "grep -qE '^#line 1 \".*c_line_secret_main.oo\"' " + tmpd +
        "/secret_multi.c && grep -qE '^#line 1 \".*c_line_secret_lib.oo\"' " + tmpd +
        "/secret_multi.c").is_err() {
        fail("missing dual #line 1");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/hello.oo > " + tmpd + "/hello.c").is_err() {
        fail("emit hello");
    }
    if process_exec(p, "grep -qE '^#line 1 \".*hello.oo\"' " + tmpd +
        "/hello.c && awk '/^int main/{exit !p} /^#line [0-9]+/{p=1}' " + tmpd +
        "/hello.c").is_err() {
        fail("hello #line");
    }
    println("c_line_secret_smoke: PASSED");
}
