// # Time & Entropy Floor Walks The Caps
// Logline: caps_matrix_smoke + time_rand_runtime stay green under oodac + bin/ooda.
// Setup: oodac/oodac built; bin/ooda present; sub-script .sh files on disk.
// Beats: 1. exec caps_matrix_smoke.sh | 2. exec time_rand_runtime_smoke.sh | 3. both PASS

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA",      root + "/bin/ooda").unwrap_or("");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — both binaries resolvable
    fails = fails + tally(expect_quiet(p, "test -x " + oodac), "oodac binary");
    fails = fails + tally(expect_quiet(p, "test -x " + ooda),  "bin/ooda binary");

    // and — sub-scripts run (sub-script .sh files are Wave-1, kept on disk for CI)
    fails = fails + tally(check(p, "bash " + root + "/scripts/caps_matrix_smoke.sh >/dev/null 2>&1", 120), "caps_matrix_smoke.sh");
    fails = fails + tally(check(p, "bash " + root + "/scripts/time_rand_runtime_smoke.sh >/dev/null 2>&1", 60), "time_rand_runtime_smoke.sh");

    // then — wrap-up
    if fails > 0 { println("time_entropy_product_floor_smoke: FAILED"); process_exit(1); }
    println("time_entropy_product_floor_smoke: PASSED");
}
