import "std/test.oo";
import "std/os/process.oo";
import "std/os/cmd.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    let oodac = "./oodac/oodac"; 
    let tmp_dir = "/tmp/ooda-tmp";

    // Setup temp dir for test artifacts
    let mut mkdir: List[String] = cmd_new("mkdir");
    mkdir = cmd_arg(mkdir, "-p");
    mkdir = cmd_arg(mkdir, tmp_dir);
    let mkdir_res: Result[String, String] = cmd_execute(mkdir, p);

    // 1. Check pure std modules
    let mut modules: List[String] = list_new();
    modules = list_push(modules, "result.oo");
    modules = list_push(modules, "str.oo");
    modules = list_push(modules, "option.oo");

    let mut i = 0;
    while i < list_len(modules) {
        let m = list_get(modules, i);
        let mut c: List[String] = cmd_new(oodac);
        c = cmd_arg(c, "check");
        c = cmd_arg(c, "std/" + m);
        
        let res: Result[String, String] = cmd_execute(c, p);
        tr = test_assert(tr, "check std/" + m, res.is_ok());
        i = i + 1;
    }

    // 2. Build and run fixtures
    let mut fixtures: List[String] = list_new();
    fixtures = list_push(fixtures, "std_result_main");
    fixtures = list_push(fixtures, "std_str_main");
    fixtures = list_push(fixtures, "std_option_main");

    let mut j = 0;
    while j < list_len(fixtures) {
        let f = list_get(fixtures, j);
        let bin_path = tmp_dir + "/" + f;

        let mut b: List[String] = cmd_new(oodac);
        b = cmd_arg(b, "build");
        b = cmd_arg(b, "fixtures/" + f + ".oo");
        b = cmd_arg(b, bin_path);
        
        let b_res: Result[String, String] = cmd_execute(b, p);
        tr = test_assert(tr, "build fixtures/" + f + ".oo", b_res.is_ok());

        if b_res.is_ok() {
            let mut r: List[String] = cmd_new(bin_path);
            let r_res: Result[String, String] = cmd_execute(r, p);
            tr = test_assert(tr, "run fixtures/" + f + ".oo", r_res.is_ok());
        }
        
        j = j + 1;
    }

    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
}
