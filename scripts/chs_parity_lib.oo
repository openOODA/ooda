// # CHS Parity Lib Walks Product ≡ Pure
// Logline: product CLI and pure oodac agree on tokens / ast / check across pass + fail fixtures.
// Setup: oodac/oodac + bin/ooda built; oodac emits tokens|ast|check; python3 + diff available.
// Beats: 1. tokens parity pass + fail-closed | 2. ast parity | 3. check parity pass + fail-closed

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA",      root + "/bin/ooda").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — tokens parity on int_main.oo
    let _w1 = process_exec(p, "rm -f " + tmpd + "/tok_a.txt " + tmpd + "/tok_b.txt " + tmpd + "/tok_a.err " + tmpd + "/tok_b.err; " +
        "if [ -x " + ooda + " ]; then " + ooda + " tokens " + root + "/fixtures/int_main.oo > " + tmpd + "/tok_a.txt 2> " + tmpd + "/tok_a.err; ra=$?; else " + oodac + " tokens " + root + "/fixtures/int_main.oo > " + tmpd + "/tok_a.txt 2> " + tmpd + "/tok_a.err; ra=$?; fi; " +
        oodac + " tokens " + root + "/fixtures/int_main.oo > " + tmpd + "/tok_b.txt 2> " + tmpd + "/tok_b.err; rb=$?; " +
        "grep $'\\t' " + tmpd + "/tok_a.txt > " + tmpd + "/tok_a.f 2>/dev/null; grep $'\\t' " + tmpd + "/tok_b.txt > " + tmpd + "/tok_b.f 2>/dev/null; mv " + tmpd + "/tok_a.f " + tmpd + "/tok_a.txt 2>/dev/null; mv " + tmpd + "/tok_b.f " + tmpd + "/tok_b.txt 2>/dev/null; " +
        "if [ \"$ra\" -ne 0 ] || [ \"$rb\" -ne 0 ]; then echo TOK_FAIL_EXIT > " + tmpd + "/tok_parity.log; else diff -q " + tmpd + "/tok_a.txt " + tmpd + "/tok_b.txt >/dev/null && echo TOK_OK > " + tmpd + "/tok_parity.log || echo TOK_FAIL_DIFF >> " + tmpd + "/tok_parity.log; fi");
    fails   = fails + tally(expect_quiet(p, "grep -q 'TOK_OK' " + tmpd + "/tok_parity.log"),                "tokens product≡oodac");

    // and — tokens fail-closed on bad_char
    let _w2 = process_exec(p, "rm -f " + tmpd + "/fail_a.txt " + tmpd + "/fail_b.txt; " +
        "if [ -x " + ooda + " ]; then " + ooda + " tokens " + root + "/bootstrap/corpus/lex/fail/bad_char.oo > " + tmpd + "/fail_a.txt 2> " + tmpd + "/fail_a.err; ra=$?; else " + oodac + " tokens " + root + "/bootstrap/corpus/lex/fail/bad_char.oo > " + tmpd + "/fail_a.txt 2> " + tmpd + "/fail_a.err; ra=$?; fi; " +
        oodac + " tokens " + root + "/bootstrap/corpus/lex/fail/bad_char.oo > " + tmpd + "/fail_b.txt 2> " + tmpd + "/fail_b.err; rb=$?; " +
        "if [ \"$ra\" -eq 0 ] || [ \"$rb\" -eq 0 ]; then echo TOK_FAIL_ACCEPT > " + tmpd + "/tok_fail.log; elif grep -qE 'ERR.lex|Unexpected character' " + tmpd + "/fail_a.txt " + tmpd + "/fail_a.err " + tmpd + "/fail_b.txt " + tmpd + "/fail_b.err 2>/dev/null; then echo TOK_FAIL_OK > " + tmpd + "/tok_fail.log; else echo TOK_FAIL_NO_ERR > " + tmpd + "/tok_fail.log; fi");
    fails   = fails + tally(expect_quiet(p, "grep -q 'TOK_FAIL_OK' " + tmpd + "/tok_fail.log"),             "tokens fail-closed (product+oodac)");

    // and — ast parity with normalized indentation (python)
    let _w3 = process_exec(p, "rm -f " + tmpd + "/ast_a.txt " + tmpd + "/ast_b.txt; " +
        "if [ -x " + ooda + " ]; then " + ooda + " ast " + root + "/fixtures/int_main.oo > " + tmpd + "/ast_a.txt 2> " + tmpd + "/ast_a.err; ra=$?; else " + oodac + " ast " + root + "/fixtures/int_main.oo > " + tmpd + "/ast_a.txt 2> " + tmpd + "/ast_a.err; ra=$?; fi; " +
        oodac + " ast " + root + "/fixtures/int_main.oo > " + tmpd + "/ast_b.txt 2> " + tmpd + "/ast_b.err; rb=$?; " +
        "if [ \"$ra\" -ne 0 ] || [ \"$rb\" -ne 0 ]; then echo AST_FAIL_EXIT > " + tmpd + "/ast_parity.log; else python3 -c \"import re,sys; p=sys.argv[1]; lines=[re.sub(r' @[0-9]+:[0-9]+','',L) for L in open(p).read().splitlines()]; out=[]; i=0; " +
        "while i < len(lines): " +
        "  if i+1 < len(lines): a,b=lines[i],lines[i+1]; ia,ib=len(a)-len(a.lstrip(' ')),len(b)-len(b.lstrip(' ')); " +
        "    if ia==ib and 'EXPR BIN' in b and 'EXPR' in a and 'BIN' not in a: " +
        "      j=i+2; kids=[]; " +
        "      while j < len(lines) and len(lines[j])-len(lines[j].lstrip(' ')) > ib: kids.append(lines[j]); j+=1; " +
        "      pad=' '*ia; left=re.sub(r'^ +',pad+'  ',a); out.append(b); out.append(left); out.extend(kids); i=j; continue; " +
        "  out.append(lines[i]); i+=1; " +
        "sys.stdout.write('\\n'.join(out)+('\\n' if out else ''))\" " + tmpd + "/ast_a.txt > " + tmpd + "/ast_a.n; " +
        "python3 -c \"import re,sys; p=sys.argv[1]; lines=[re.sub(r' @[0-9]+:[0-9]+','',L) for L in open(p).read().splitlines()]; out=[]; i=0; " +
        "while i < len(lines): " +
        "  if i+1 < len(lines): a,b=lines[i],lines[i+1]; ia,ib=len(a)-len(a.lstrip(' ')),len(b)-len(b.lstrip(' ')); " +
        "    if ia==ib and 'EXPR BIN' in b and 'EXPR' in a and 'BIN' not in a: " +
        "      j=i+2; kids=[]; " +
        "      while j < len(lines) and len(lines[j])-len(lines[j].lstrip(' ')) > ib: kids.append(lines[j]); j+=1; " +
        "      pad=' '*ia; left=re.sub(r'^ +',pad+'  ',a); out.append(b); out.append(left); out.extend(kids); i=j; continue; " +
        "  out.append(lines[i]); i+=1; " +
        "sys.stdout.write('\\n'.join(out)+('\\n' if out else ''))\" " + tmpd + "/ast_b.txt > " + tmpd + "/ast_b.n; " +
        "diff -q " + tmpd + "/ast_a.n " + tmpd + "/ast_b.n >/dev/null && echo AST_OK > " + tmpd + "/ast_parity.log || echo AST_FAIL >> " + tmpd + "/ast_parity.log");
    let _w4 = process_exec(p, "cat " + tmpd + "/ast_parity.log 2>/dev/null; true");
    fails   = fails + tally(expect_quiet(p, "grep -q 'AST_OK' " + tmpd + "/ast_parity.log"),                 "ast product≡oodac");

    // then — check parity pass + fail-closed
    let _w5 = process_exec(p, "rm -f " + tmpd + "/chk_a.txt " + tmpd + "/chk_b.txt; " +
        "if [ -x " + ooda + " ]; then " + ooda + " check " + root + "/bootstrap/corpus/check/pass/ok_main.oo > " + tmpd + "/chk_a.txt 2> " + tmpd + "/chk_a.err; ra=$?; else " + oodac + " check " + root + "/bootstrap/corpus/check/pass/ok_main.oo > " + tmpd + "/chk_a.txt 2> " + tmpd + "/chk_a.err; ra=$?; fi; " +
        oodac + " check " + root + "/bootstrap/corpus/check/pass/ok_main.oo > " + tmpd + "/chk_b.txt 2> " + tmpd + "/chk_b.err; rb=$?; " +
        "sa=$(grep -hE '^(OK|ERR)' " + tmpd + "/chk_a.txt " + tmpd + "/chk_a.err 2>/dev/null | head -1 | tr -d '\\r'); " +
        "sb=$(grep -hE '^(OK|ERR)' " + tmpd + "/chk_b.txt " + tmpd + "/chk_b.err 2>/dev/null | head -1 | tr -d '\\r'); " +
        "if [ \"$ra\" -ne 0 ] || [ \"$rb\" -ne 0 ] || [ \"$sa\" != OK* ] || [ \"$sb\" != OK* ]; then echo CHK_FAIL_PASS > " + tmpd + "/chk_parity.log; else echo CHK_PASS_OK > " + tmpd + "/chk_parity.log; fi");
    fails   = fails + tally(expect_quiet(p, "grep -q 'CHK_PASS_OK' " + tmpd + "/chk_parity.log"),            "check pass product≡oodac");

    if fails > 0 { println("chs_parity_lib: FAILED"); process_exit(1); }
    println("chs_parity_lib: PASSED");
}
