// # Std Markup Path A Walks The Pure Path
// Logline: toml/yaml/xml/json_schema check + honesty residual + multi-build fixture prints residual markers.
// Setup: oodac + std/markup/{toml,yaml,xml,json_schema}.oo + fixtures/std_markup_main.oo + gcc.
// Beats: 1. check each module | 2. honesty residual marker | 3. build + run fixture

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "std markup path A");

    // when — check toml/yaml/xml/json_schema modules
    let mods = ["toml.oo", "yaml.oo", "xml.oo", "json_schema.oo"];
    let mut i: Int = 0;
    while i < 4 {
        let m = mods[i];
        let _ = process_exec(p, oodac + " check " + root + "/std/markup/" + m + " > " + tmpd + "/mk_ck_" + m + ".out 2> " + tmpd + "/mk_ck_" + m + ".err; echo rc=$? >> " + tmpd + "/mk_ck_" + m + ".out");
        let _ = check(p, "tail -1 " + tmpd + "/mk_ck_" + m + ".out | grep -q 'rc=0'", 5);
        i = i + 1;
    }

    // and — honesty: no DESIGN-done / full-parser claims + residual marker
    i = 0;
    while i < 4 {
        let m = mods[i];
        let f = root + "/std/markup/" + m;
        let _ = expect_clean(p, "grep -qiE 'full (XML|YAML|TOML|JSON Schema) parser|DESIGN.?done' " + f);
        let _ = expect_quiet(p, "grep -qiE 'Not full|UNIMPLEMENTED_RESIDUAL|NOT product|not full' " + f);
        i = i + 1;
    }

    // then — build + run fixture (name<TAB>ada, toml-residual, yaml-residual, xml strip yo, etc.)
    let fix = root + "/fixtures/std_markup_main.oo";
    let bin = tmpd + "/std_markup_main";
    let _ = process_exec(p, "OODAC_BIN='" + oodac + "' " + oodac + " build " + fix + " " + bin + " > " + tmpd + "/mk_b.out 2> " + tmpd + "/mk_b.err");
    let _ = process_exec(p, "(" + bin + "; echo rc=$?) > " + tmpd + "/mk_r.out 2>&1");
    let _ = check(p, "tail -1 " + tmpd + "/mk_r.out | grep -q 'rc=0'", 5);
    let _ = check(p, "grep -q $'name\\tada' " + tmpd + "/mk_r.out && grep -q 'toml-residual' " + tmpd + "/mk_r.out && grep -q 'yaml-residual' " + tmpd + "/mk_r.out && grep -Fxq 'yo' " + tmpd + "/mk_r.out && grep -q 'xml-residual' " + tmpd + "/mk_r.out && grep -q 'js-empty' " + tmpd + "/mk_r.out && grep -q 'js-residual' " + tmpd + "/mk_r.out && grep -q 'js-validate-deny' " + tmpd + "/mk_r.out", 5);

    println("std_markup_smoke: PASSED");
}
