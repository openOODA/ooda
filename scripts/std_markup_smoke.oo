// # Std Markup Path A Walks The Pure Path
// Logline: toml/yaml/xml/json_schema check + honesty residual + multi-build fixture prints residual markers.
// Setup: oodac + std/markup/{toml,yaml,xml,json_schema}.oo + fixtures/std_markup_main.oo + gcc.
// Beats: 1. check each module | 2. honesty residual marker | 3. build + run fixture

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd: String = ".ooda-cache/ooda-tmp/std_markup";
    let oodac: String = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { process_exit(1); }
    if scenario(p, fs, "std markup path A").is_err() { process_exit(1); }

    // when — check toml/yaml/xml/json_schema modules
    let mut mods: List[String] = list_new();
    mods = list_push(mods, "toml.oo");
    mods = list_push(mods, "yaml.oo");
    mods = list_push(mods, "xml.oo");
    mods = list_push(mods, "json_schema.oo");
    let mut i: Int = 0;
    while i < 4 {
        let m: String = list_get(mods, i);
        if process_exec(p, oodac + " check std/markup/" + m + " > " + tmpd + "/mk_ck_" + m + ".out 2> " + tmpd + "/mk_ck_" + m + ".err; echo rc=$? >> " + tmpd + "/mk_ck_" + m + ".out").is_err() { process_exit(1); }
        if check(p, "tail -1 " + tmpd + "/mk_ck_" + m + ".out | grep -q 'rc=0'", 5).is_err() { process_exit(1); }
        i = i + 1;
    }

    // and — honesty: no DESIGN-done / full-parser claims + residual marker
    i = 0;
    while i < 4 {
        let m: String = list_get(mods, i);
        let f: String = "std/markup/" + m;
        if expect_clean(p, "! grep -qiE 'full (XML|YAML|TOML|JSON Schema) parser|DESIGN.?done' " + f).is_err() { process_exit(1); }
        if expect_quiet(p, "grep -qiE 'Not full|UNIMPLEMENTED_RESIDUAL|NOT product|not full' " + f).is_err() { process_exit(1); }
        i = i + 1;
    }

    // then — build + run fixture (name<TAB>ada, toml-residual, yaml-residual, xml strip yo, etc.)
    let fix: String = "fixtures/std_markup_main.oo";
    let bin: String = tmpd + "/std_markup_main";
    if process_exec(p, "OODAC_BIN='" + oodac + "' " + oodac + " build " + fix + " " + bin + " > " + tmpd + "/mk_b.out 2> " + tmpd + "/mk_b.err").is_err() { process_exit(1); }
    if process_exec(p, "(" + bin + "; echo rc=$?) > " + tmpd + "/mk_r.out 2>&1").is_err() { process_exit(1); }
    if check(p, "tail -1 " + tmpd + "/mk_r.out | grep -q 'rc=0'", 5).is_err() { process_exit(1); }
    if check(p, "grep -q $'name\\tada' " + tmpd + "/mk_r.out && grep -q 'toml-residual' " + tmpd + "/mk_r.out && grep -q 'yaml-residual' " + tmpd + "/mk_r.out && grep -Fxq 'yo' " + tmpd + "/mk_r.out && grep -q 'xml-residual' " + tmpd + "/mk_r.out && grep -q 'js-empty' " + tmpd + "/mk_r.out && grep -q 'js-residual' " + tmpd + "/mk_r.out && grep -q 'js-validate-deny' " + tmpd + "/mk_r.out", 5).is_err() { process_exit(1); }

    println("std_markup_smoke: PASSED");
}
