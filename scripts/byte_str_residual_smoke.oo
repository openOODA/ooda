// ===================================================================
// Byte/Str Residual Smoke
// ===================================================================
// job: Byte / &str residual honesty — not DESIGN-done; string value-copy remains
// in:  bootstrap/BYTE_STR.oot, fixtures/byte_str_marker.oo, std/byte.oo
// out: exit 0 if doc markers and residual wording present

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let doc_path = root + "/bootstrap/BYTE_STR.oot";
    let fix_path = root + "/fixtures/byte_str_marker.oo";
    let std_path = root + "/std/byte.oo";
    let marker = "BYTE_STR_RESIDUAL_ALPHA";
    let fixline = "BYTE_STR: residual";
    let script_name = "byte_str_residual_smoke.sh";
    let tmpdir = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    
    // Doc exists
    let doc_exists = cmd_exec(p, "test -f " + doc_path);
    tr = test_assert(tr, "doc file exists", doc_exists.is_ok());
    
    if !doc_exists.is_ok() {
        test_summary(tr);
        process_exit(1);
    }
    
    // Marker check
    let check_marker = cmd_exec(p, "grep -q " + marker + " " + doc_path);
    tr = test_assert(tr, "doc marker " + marker, check_marker.is_ok());
    
    // &str borrow residual
    let check_str_borrow = cmd_exec(p, "grep -qE 'native.*&str|&str.*borrow|borrowed string' " + doc_path);
    tr = test_assert(tr, "doc names &str borrow residual", check_str_borrow.is_ok());
    
    // Byte arrays residual
    let check_byte_arrays = cmd_exec(p, "grep -qiE 'Byte array|byte arrays|List\[Byte\]' " + doc_path);
    tr = test_assert(tr, "doc names Byte arrays residual", check_byte_arrays.is_ok());
    
    // String value-copy remains
    let check_value_copy = cmd_exec(p, "grep -qiE 'value-copy|value copy|OoStr' " + doc_path);
    tr = test_assert(tr, "doc states string value-copy remains", check_value_copy.is_ok());
    
    // Must not claim DESIGN-done / product-green Byte/&str
    let no_claim_res = cmd_exec(p, "test -z \"$(grep -nEi 'Byte.*fully shipped|&str.*product green|native &str (is |shipped)|Byte arrays (shipped|enforced)' " + doc_path + " 2>/dev/null | grep -viE 'not |residual|do not|never|no ')\"");
    tr = test_assert(tr, "doc does not claim Byte/&str product-green", no_claim_res.is_ok());
    
    // Fail-closed residual wording
    let check_fail_closed = cmd_exec(p, "grep -qiE 'fail-closed residual|Fail-closed residual' " + doc_path);
    tr = test_assert(tr, "fail-closed residual wording", check_fail_closed.is_ok());
    
    // Non-claims section
    let check_non_claims = cmd_exec(p, "grep -qiE 'do **not** claim|What we do **not** claim' " + doc_path);
    tr = test_assert(tr, "non-claims section", check_non_claims.is_ok());
    
    // Fixture check
    let fix_exists = cmd_exec(p, "test -f " + fix_path);
    tr = test_assert(tr, "fixture file exists", fix_exists.is_ok());
    
    if fix_exists.is_ok() {
        let check_fixline = cmd_exec(p, "grep -q \"" + fixline + "\" " + fix_path);
        tr = test_assert(tr, "fixture marker " + fixline, check_fixline.is_ok());
    }
    
    // std/byte.oo checks
    let std_exists = cmd_exec(p, "test -f " + std_path);
    tr = test_assert(tr, "std/byte.oo present", std_exists.is_ok());
    
    if std_exists.is_ok() {
        let check_byte_alias = cmd_exec(p, "grep -qE 'type Byte = Int' " + std_path);
        tr = test_assert(tr, "std Byte alias is Int convention", check_byte_alias.is_ok());
        
        let check_byte_residual = cmd_exec(p, "grep -qiE 'residual:' " + std_path);
        tr = test_assert(tr, "std/byte.oo documents residual", check_byte_residual.is_ok());
        
        // Optional oodac check
        let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
        let oodac_exists = cmd_exec(p, "test -x " + oodac);
        if oodac_exists.is_ok() {
            let oodac_res = cmd_exec(p, oodac + " check " + std_path + " >" + tmpdir + "/byte_str_std_ck.out 2>" + tmpdir + "/byte_str_std_ck.err");
            if oodac_res.is_ok() {
                tr = test_assert(tr, "oodac check std/byte.oo", true);
            } else {
                // Check for expected undefined variable errors (Path A free names)
                let check_undefined = cmd_exec(p, "grep -qE 'undefined variable' " + tmpdir + "/byte_str_std_ck.out " + tmpdir + "/byte_str_std_ck.err 2>/dev/null");
                if check_undefined.is_ok() {
                    tr = test_assert(tr, "skip oodac check (pre path-A free-name oodac)", true);
                } else {
                    tr = test_assert(tr, "oodac check std/byte.oo failed", false);
                }
            }
        }
    }
    
    // Dual-claim scan
    let dual_claim = cmd_exec(p, "grep -rn --include='*.oot' --exclude='BYTE_STR.oot' --exclude-dir=dist -E 'native &str (shipped|enforced)|Byte arrays (shipped|enforced)|Byte primitive (shipped|enforced)' " + root + "/bootstrap 2>/dev/null | grep -vE 'not |residual|not-started|no false' | head -5 || true");
    if dual_claim.is_ok() {
        let dual_claim_content = trim(dual_claim.unwrap());
        if str_len(dual_claim_content) > 0 {
            tr = test_assert(tr, "no false Byte/&str shipped claims in bootstrap residual surface", false);
        } else {
            tr = test_assert(tr, "no false Byte/&str shipped claims in bootstrap residual surface", true);
        }
    }
    
    // ci_product wire
    let check_ci = cmd_exec(p, "grep -q '" + script_name + "' " + root + "/scripts/ci_product.sh");
    tr = test_assert(tr, "ci_product wire", check_ci.is_ok());
    
    // RESIDUAL_PACKS index
    let check_packs = cmd_exec(p, "grep -q 'BYTE_STR.oot' " + root + "/bootstrap/RESIDUAL_PACKS.oot 2>/dev/null");
    tr = test_assert(tr, "RESIDUAL_PACKS index", check_packs.is_ok());
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("byte_str_residual_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
