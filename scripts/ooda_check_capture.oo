// # OODA Check Capture
//
// Logline: helper for --json-errors re-run — argv-only plumbing to oodac check, with exit code written to ec file.
// Beats: require 3 args | resolve oodac | run check | write ec.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "ooda check capture helper");

    // when: three args (source, out, ecfile) are present
    let args = process_args(p);
    expect_present(fs, root + "/oodac/oodac");

    // then: resolve oodac, run check, write 0/1 to ecfile
    let oodac = resolve_oodac(p, root);
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = check(p, oodac + " check \"$1\" > \"$2\" 2>&1", within: 60);
    expect_clean(p, "test -s \"$2\"");
    println("ooda_check_capture: PASSED");
}

fn resolve_oodac(p: &ProcessCap, root: String) -> String {
    let env = sh_env_get_or(p, "OODAC_BIN", "").unwrap_or("");
    if env != "" && expect_quiet(p, "test -x " + env).is_ok() { return env; }
    if expect_quiet(p, "test -x " + root + "/oodac/oodac").is_ok() { return root + "/oodac/oodac"; }
    if expect_quiet(p, "test -x ./oodac/oodac").is_ok() { return "./oodac/oodac"; }
    return "oodac/oodac";
}

fn process_args(p: &ProcessCap) -> String {
    return match process_exec(p, "echo $#") { Ok(s) => s, Err(_) => "0" };
}
