// # S710 Parse Secret Env Smoke
//
// Logline: 7.10 c_parse_secret_env — bare SECRET IDENT at println refuses, two SECRET names both refuse per-name, invalid empty name refuses.
// Beats: ident refuses | two names per-name | empty name invalid.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/s710_parse_secret_env";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + FIX);
    let _ = scenario(p, fs, "S710 parse secret env");

    // when: ephemeral fixtures for parse rails
    let _ = write_fix(p, root + "/" + FIX);

    // and: bare SECRET IDENT at println fails-closed
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/println_ident.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // then: two SECRET names both refuse with their name (a and b)
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/two_names_a.oo +\" 2>&1 | grep -qE 'ERR\tsecret.*a'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/two_names_b.oo +\" 2>&1 | grep -qE 'ERR\tsecret.*b'");

    // and: empty name after `// SECRET:` is invalid
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/empty_name.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    println("s710_parse_secret_env_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/println_ident.oo <<'EOF'\n// 7.10 path-A: bare SECRET IDENT at println must refuse\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; println(tok); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/two_names_a.oo <<'EOF'\n// 7.10 path-A: two SECRET tags; sink on first name must refuse\n// SECRET: a\n// SECRET: b\npub fn main() { let a = \"x\"; let b = \"y\"; println(a); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/two_names_b.oo <<'EOF'\n// 7.10 path-A: two SECRET tags; sink on second name must refuse\n// SECRET: a\n// SECRET: b\npub fn main() { let a = \"x\"; let b = \"y\"; println(b); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/empty_name.oo <<'EOF'\n// 7.10 path-A: empty SECRET name (spaces only) must refuse invalid name\n// SECRET:   \npub fn main() { println(1); }\nEOF");
}
