// # Prove ROADMAP Open 14 through 59 at the honest product floor
//
// Logline: Fail closed on each named proof. Residual rows must refuse, not pretend.
//
// Setup: cwd is ooda/. Tree oodac and bin/ooda. gcc for C floors.
//
// Beats:
//   1. Compiler and CLI floors 14-27.
//   2. Runtime C floors for wasm, rlimit, landlock, writedir.
//   3. Residual commands and residual free names.

import "std/scenario.oo";
import "std/sh.oo";

fn need(p: &ProcessCap, cmd: String, msg: String) {
    if expect_clean(p, cmd).is_err() {
        println("FAIL " + msg);
        process_exit(1);
    }
}

fn need_fail(p: &ProcessCap, cmd: String, msg: String) {
    if expect_clean(p, "! " + cmd).is_err() {
        println("FAIL " + msg);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    let ooda = root + "/bin/ooda";
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "OPEN-14..59 prove").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() {
        println("FAIL no oodac");
        process_exit(1);
    }

    need(p, "test -f " + root + "/cli/fix_imp.oo", "OPEN-14 source");
    need(p, "grep -q infer_import_spec " + root + "/cli/fix_imp.oo", "OPEN-14 infer");
    need(p, "grep -q apply_eimp " + root + "/cli/fix_drive.oo", "OPEN-14 drive");

    need(p, oodac + " check --json-errors " + root + "/fixtures/open_user_res_disc.oo 2>&1 | grep -q '\"path\":\"fixtures/open_user_res_disc.oo\"'", "OPEN-15 path");

    need(p, oodac + " check " + root + "/fixtures/open_user_res_disc.oo 2>&1 | grep -q 'do not discard boom'", "OPEN-16 boom");
    need(p, oodac + " check " + root + "/fixtures/open_match_star.oo 2>&1 | grep -q 'non-exhaustive'", "OPEN-17 star");

    need(p, "grep -q ci_open_run.oo " + root + "/scripts/ci_product_rails.oo", "OPEN-18 rails");
    need(p, "test -f " + root + "/scripts/ci_open_run.oo", "OPEN-18 script");

    need(p, "grep -q '245 seconds' " + root + "/../openOODA/ROADMAP.oot", "OPEN-19 time");
    need(p, "grep -q '178 modules' " + root + "/../openOODA/ROADMAP.oot", "OPEN-19 mods");

    need(p, "grep -q 'if q != \"\"' " + root + "/oodac/cli_build.oo", "OPEN-20 quiet");
    need(p, oodac + " run " + root + "/fixtures/hello.oo 2>&1 | grep -q 'Hello'", "OPEN-20 hello");
    need(p, "! " + oodac + " run " + root + "/fixtures/hello.oo 2>&1 | grep -q 'BUILD MOD'", "OPEN-20 no BUILD MOD");

    need(p, "grep -q getcwd " + root + "/runtime/chs_rt_fs.c", "OPEN-21 getcwd");

    need(p, oodac + " check " + root + "/fixtures/open_import_c.oo 2>&1 | grep -qE 'C header residual|import'", "OPEN-22 header");

    if expect_quiet(p, "test -x " + ooda).is_ok() {
        need(p, ooda + " context 2>&1 | grep -q residual", "OPEN-23");
        need(p, ooda + " digest 2>&1 | grep -q residual", "OPEN-24");
        need(p, ooda + " health 2>&1 | grep -q residual", "OPEN-25");
        need(p, ooda + " pkg 2>&1 | grep -q beta-out", "OPEN-26");
        need(p, ooda + " add 2>&1 | grep -q residual", "OPEN-27");
        need(p, ooda + " lsp 2>&1 | grep -q beta-out", "OPEN-40");
    }

    need(p, "grep -q oo_wasm_write_empty_module " + root + "/runtime/chs_rt_wasm.c", "OPEN-28 writer");
    need(p, "grep -q setrlimit " + root + "/runtime/chs_rt_rlimit.c", "OPEN-35 setrlimit");
    need(p, "grep -q landlock_restrict_self " + root + "/runtime/chs_rt_landlock.c", "OPEN-34 restrict");

    need(p, oodac + " check " + root + "/fixtures/open_macro.oo 2>&1 | grep -q AST_MACROS", "OPEN-56");
    need(p, oodac + " check " + root + "/fixtures/open_hot_reload.oo 2>&1 | grep -q HOT_RELOAD", "OPEN-57");
    need(p, oodac + " check " + root + "/fixtures/residual_gpu_fail.oo 2>&1 | grep -q GPU_NPU", "OPEN-58");
    need(p, oodac + " check " + root + "/fixtures/open_bare_metal.oo 2>&1 | grep -q BARE_METAL", "OPEN-59");
    need(p, oodac + " check " + root + "/fixtures/open_otp.oo 2>&1 | grep -q OTP_SUPERVISION", "OPEN-54");
    need(p, oodac + " check " + root + "/fixtures/open_match_unann.oo 2>&1 | grep -q 'non-exhaustive'", "OPEN-17 unann");
    need(p, oodac + " check " + root + "/fixtures/residual_lsp_fail.oo 2>&1 | grep -q NATIVE_LSP", "OPEN-40 name");
    need(p, oodac + " check " + root + "/fixtures/residual_lto_fail.oo 2>&1 | grep -q LTO_XLANG", "OPEN-32");
    need(p, oodac + " check " + root + "/fixtures/residual_hot_reload_fail.oo 2>&1 | grep -q HOT_RELOAD", "OPEN-57 alt");
    need(p, oodac + " check " + root + "/fixtures/secret_struct_literal_field_fail.oo 2>&1 | grep -q SECRET", "OPEN-36 fail");
    need(p, oodac + " check " + root + "/fixtures/secret_nested_struct_clean_pass.oo 2>&1 | grep -q '^OK'", "OPEN-36 clean");
    need(p, "grep -q hmac_sha256 " + root + "/std/core/crypto.oo", "OPEN-38/44 hmac");
    need(p, "grep -q 'not under 10 seconds' " + root + "/../openOODA/SHIPPED.oot", "OPEN-29 residual named");

    println("open46_prove: PASSED");
}