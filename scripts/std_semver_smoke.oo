// # Std Semver Smoke
//
// Logline: Verify std/semver.oo typechecks, respects residual boundaries, and compiles standard fixtures.
//
// Setup: oodac compiler binary, std/semver.oo, and std_semver_main fixture exist on disk.
//
// Beats:
//   1. Run typecheck against std/semver.oo to verify standard library cleanliness.
//   2. Validate semver module documentation to ensure honesty on prerelease and build metadata.
//   3. Build and execute std_semver_main fixture to verify runtime semver parsing.
import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, root + "/" + ".ooda-cache/ooda-tmp/std_semver");
    let _     = scenario(p, fs, "std semver pure floor");

    // when — std/semver.oo typechecks
    let sem = root + "/" + "std/semver.oo";
    let _ = process_exec(p, oodac + " check " + sem + " > " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/sem_ck.out 2> " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/sem_ck.err");
    let _ = expect_quiet(p, "grep -qE '^OK' " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/sem_ck.out");

    // and — residual honesty: no false full-semver claim
    let _ = expect_clean(p, "grep -qiE 'full semver DESIGN|prerelease fully|build metadata fully' " + sem);
    let _ = expect_quiet(p, "grep -qiE 'prerelease|build' " + sem + " && grep -qiE 'residual|NOT accepted|not accepted' " + sem);

    // then — build + run fixture
    let bin = root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/std_semver_main";
    let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/" + "fixtures/std_semver_main.oo" + " " + bin + " > " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/b.out 2> " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/b.err");
    let _ = process_exec(p, bin + " > " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/r.out 2> " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/r.err");
    let _ = expect_quiet(p, "grep -q 'semver-ok' " + root + "/" + ".ooda-cache/ooda-tmp/std_semver" + "/r.out");

    println("std_semver_smoke: PASSED");
}