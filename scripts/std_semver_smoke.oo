// # Std Semver Smoke
// Logline: std/semver.oo check + multi-build fixture; residual honesty on prerelease/build metadata.
import "std/scenario.oo";
import "std/sh.oo";

const TMP: String = ".ooda-cache/ooda-tmp/std_semver";
const SEMVER: String = "std/semver.oo";
const FIX: String = "fixtures/std_semver_main.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, root + "/" + TMP);
    let _     = scenario(p, fs, "std semver pure floor");

    // when — std/semver.oo typechecks
    let sem = root + "/" + SEMVER;
    let _ = process_exec(p, oodac + " check " + sem + " > " + root + "/" + TMP + "/sem_ck.out 2> " + root + "/" + TMP + "/sem_ck.err");
    let _ = expect_quiet(p, "grep -qE '^OK' " + root + "/" + TMP + "/sem_ck.out");

    // and — residual honesty: no false full-semver claim
    let _ = expect_clean(p, "grep -qiE 'full semver DESIGN|prerelease fully|build metadata fully' " + sem);
    let _ = expect_quiet(p, "grep -qiE 'prerelease|build' " + sem + " && grep -qiE 'residual|NOT accepted|not accepted' " + sem);

    // then — build + run fixture
    let bin = root + "/" + TMP + "/std_semver_main";
    let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/" + FIX + " " + bin + " > " + root + "/" + TMP + "/b.out 2> " + root + "/" + TMP + "/b.err");
    let _ = process_exec(p, bin + " > " + root + "/" + TMP + "/r.out 2> " + root + "/" + TMP + "/r.err");
    let _ = expect_quiet(p, "grep -q 'semver-ok' " + root + "/" + TMP + "/r.out");

    println("std_semver_smoke: PASSED");
}