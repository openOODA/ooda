// # Std Semver Smoke
//
// Logline: Verify std/semver.oo typechecks, respects residual boundaries, and compiles standard fixtures.
//
// Setup: oodac compiler binary, std/semver.oo, and std_semver_main fixture exist on disk.
//
// Beats:
//   1. Run typecheck against std/semver.oo to verify standard library cleanliness.
//   2. Validate semver module documentation to ensure honesty on prerelease and build metadata.
//   3. Build and execute std_semver_main fixture to verify runtime semver parsing.
import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd: String = ".ooda-cache/ooda-tmp/std_semver";
    let oodac: String = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { process_exit(1); }
    if scenario(p, fs, "std semver pure floor").is_err() { process_exit(1); }

    // when — std/semver.oo typechecks
    let sem: String = "std/semver.oo";
    if process_exec(p, oodac + " check " + sem + " > " + tmpd + "/sem_ck.out 2> " + tmpd + "/sem_ck.err").is_err() { process_exit(1); }
    if expect_quiet(p, "grep -qE '^OK' " + tmpd + "/sem_ck.out").is_err() { process_exit(1); }

    // and — residual honesty: no false full-semver claim
    if expect_clean(p, "! grep -qiE 'full semver DESIGN|prerelease fully|build metadata fully' " + sem).is_err() { process_exit(1); }
    if expect_quiet(p, "grep -qiE 'prerelease|build' " + sem + " && grep -qiE 'residual|NOT accepted|not accepted' " + sem).is_err() { process_exit(1); }

    // then — build + run fixture
    let fix: String = "fixtures/std_semver_main.oo";
    let bin: String = tmpd + "/std_semver_main";
    if process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + fix + " " + bin + " > " + tmpd + "/b.out 2> " + tmpd + "/b.err").is_err() { process_exit(1); }
    if process_exec(p, bin + " > " + tmpd + "/r.out 2> " + tmpd + "/r.err").is_err() { process_exit(1); }
    if expect_quiet(p, "grep -q 'semver-ok' " + tmpd + "/r.out").is_err() { process_exit(1); }

    println("std_semver_smoke: PASSED");
}