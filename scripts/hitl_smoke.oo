// # Human-in-the-Loop Harness and Step-Pause Smoke
//
// Logline: Smoke validation for HITL approval gates, timeout enforcement, session audit, and step-pause execution.
//
// Setup: Exercises oodac typechecking over all HITL standard modules and validates fixture integrity.
//
// Beats:
//   1. Verify oodac check on HITL modules (types, gate, session, facade, top-level entry).
//   2. Verify oodac check on the integrated hitl_fixture.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = root + "/oodac/oodac";
    let std_root = root + "/../std";
    let _ = scenario(p, fs, "HITL Harness and Step-Pause Smoke");

    // Beat 1: Check HITL modules
    check(p, oodac + " check " + std_root + "/src/ooda/hitl/hitl_types.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/hitl/hitl_gate.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/hitl/hitl_session.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/hitl/hitl.oo", within: 15);
    check(p, oodac + " check " + std_root + "/hitl.oo", within: 15);

    // Beat 2: Check Integrated HITL Fixture
    check(p, oodac + " check " + root + "/fixtures/hitl_fixture.oo", within: 30);

    println("hitl_smoke: PASSED");
}
