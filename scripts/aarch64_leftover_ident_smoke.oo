// # emit-aarch64 leftover ident honesty lock
//
// Logline: Side emit-aarch64 of leftover ident (call result) prints ERR and does not emit a silent omit.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only. Product oodac does not dispatch emit-aarch64.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. leftover ident (call result, not a string let) must ERR aarch64_emit.
//   3. Refuse a successful _start .s that omitted the leftover print.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn refuse_silent(p: &ProcessCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if process_exec(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail(tag + " successful .s omitted leftover println");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() {
        fail(tag + " no ERR");
    }
    if expect_clean(p, "grep -q aarch64_emit " + sfile + " " + serr).is_err() {
        fail(tag + " no aarch64_emit");
    }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() {
        fail(tag + " silent omit .s");
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 leftover ident honesty").is_err() { fail("scenario"); }
    if expect_present(fs, root + "/fixtures/aarch64_leftover_ident.oo").is_err() {
        fail("no leftover ident fixture");
    }
    ensure_aarch64_side(p, root, prod, side);
    refuse_silent(p, side, root + "/fixtures/aarch64_leftover_ident.oo", tmpd + "/aarch64_leftover.s", tmpd + "/aarch64_leftover.err", "ident");
    println("aarch64_leftover_ident_smoke: PASSED");
}
