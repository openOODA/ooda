// # emit-x86 dynamic Option[T] smoke test
//
// Logline: emit-x86 of fixtures/x86_opt.oo assembles via GNU as and ld, executes opt_some/none/is_some/is_none/unwrap_or, and verifies output.
//
// Setup: Native execution smoke test harness.
//
// Beats:
//   1. Initialize state parameters and validate preconditions.
//   2. Execute primary algorithmic transformation.
//   3. Return fail-closed results with deterministic error handling.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 dynamic option lowering").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_opt.oo";
    if expect_present(fs, src).is_err() { fail("no x86_opt.oo"); }

    let sfile = tmpd + "/x86_opt.s";
    let serr = tmpd + "/x86_opt.err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86");
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s"); }
    if expect_substring(fs, sfile, "opt_some").is_err() { fail(".s missing opt_some"); }
    if expect_substring(fs, sfile, "opt_none").is_err() { fail(".s missing opt_none"); }
    if expect_substring(fs, sfile, "opt_is_some").is_err() { fail(".s missing opt_is_some"); }
    if expect_substring(fs, sfile, "opt_unwrap_or").is_err() { fail(".s missing opt_unwrap_or"); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() { fail(".s looks like emit-c"); }

    let obj = tmpd + "/x86_opt.o";
    let bin = tmpd + "/x86_opt.bin";
    let out = tmpd + "/x86_opt.out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as"); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld"); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run"); }
    if expect_substring(fs, out, "hello_opt").is_err() { fail("out missing hello_opt"); }
    if expect_substring(fs, out, "fallback").is_err() { fail("out missing fallback"); }

    println("x86_opt_smoke: PASSED");
}
