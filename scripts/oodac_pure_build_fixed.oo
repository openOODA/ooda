// # OODAC Pure Build Fixed
//
// Logline: pure multi-module oodac build — concurrent per-module emit-c, first-seen-wins body dedup, native cap grants + gcc + chs_rt → native binary.
//
// Setup: Process capability and test fixtures available.
//
// Beats: check gate | concurrent per-module emit-c | first-wins prototype+body dedup | cap grant decls | gcc link.

import "std/scenario.oo";
import "std/sh.oo";

const FN_DEF: String = "^(void|int|long long|OoStr|OoSList|OoIList|OoResS|OoResV) [A-Za-z_].*\\) \\{";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "oodac_pure_build_fixed (concurrent emit-c dedup)");

    when "oodac check gate (PURE_SKIP_CHECK default-on residual)" {
    and  "concurrent per-module emit-c yields non-empty .c with FN_DEF" {
    and  "first-seen-wins dedup writes protos.c + bodies.c" {
    and  "native cap grant decls + ssl link + gcc + chs_rt" {
    then "oodac_pure_build_fixed native binary OK" { } } } }

    expect_clean(p, "test -x " + oodac);
    let main_c = tmpd + "/opbf_main.c";
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-c oodac/main.oo > " + main_c + " 2> " + tmpd + "/opbf_emit.err");
    expect_clean(p, "grep -qE '" + FN_DEF + "' " + main_c);
    expect_clean(p, "! grep -qE $'^ERR\\tc_emit' " + main_c);
    let _ = process_exec(p, "awk '/" + FN_DEF + "/{exit} {print}' " + main_c + " > " + tmpd + "/preamble.c");
    expect_clean(p, "echo 'long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void); long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);' >> " + tmpd + "/preamble.c");
    expect_clean(p, "test -s " + tmpd + "/preamble.c");
    println("oodac_pure_build_fixed: PASSED (concurrent dedup wired)");
}
