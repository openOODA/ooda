// # Library emit-c health matrix
//
// Logline: Verifies a complete timeout-30 emit-c matrix for every ooda/std library file except prove/.
//
// Setup: cwd is ooda/. Matrix at .ooda-cache/ooda-tmp/std_emit_matrix.txt from shard emit-c.
//
// Beats:
//   1. Library file list and matrix exist.
//   2. Line counts match.
//   3. Every matrix status is OK, ERR, TIMEOUT, or SEGV.

import "std/scenario.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if scenario(p, fs, "std emit health").is_err() { fail("scenario"); }
    let listf: String = ".ooda-cache/ooda-tmp/std_lib_files.txt";
    let outp: String = ".ooda-cache/ooda-tmp/std_emit_matrix.txt";
    if !path_exists(fs, listf) { fail("no library list"); }
    if !path_exists(fs, outp) { fail("no matrix"); }
    if process_exec(p, "sh -c 'test $(grep -c . " + listf + ") -eq $(grep -c . " +
        outp + ")'").is_err() {
        fail("matrix count mismatch");
    }
    if process_exec(p, "sh -c 'cut -f1 " + outp +
        " | sort > .ooda-cache/ooda-tmp/mat_paths.txt && sort " + listf +
        " > .ooda-cache/ooda-tmp/lib_paths.txt && cmp -s .ooda-cache/ooda-tmp/mat_paths.txt .ooda-cache/ooda-tmp/lib_paths.txt'").is_err() {
        fail("matrix paths != library list");
    }
    if process_exec(p, "sh -c '! cut -f2 " + outp +
        " | grep -vE \"^(OK|ERR|TIMEOUT|SEGV)$\" | grep -q .'").is_err() {
        fail("bad status token");
    }
    println("std_emit_health: PASSED");
}
