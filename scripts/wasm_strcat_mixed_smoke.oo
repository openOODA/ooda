// # Hostile ident-plus-string strcat lock
//
// Logline: emit-wasm of ident+STRING println must not print a folded invented join.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_strcat_mixed.oo.
//   2. ERR or dummy empty stdout is honest.
//   3. Sole invented join Hello, mixed! on stdout or bytes fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm strcat mixed ident").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_strcat_mixed.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_strcat_mixed.wasm";
    let errf = tmpd + "/wasm_strcat_mixed.err";
    let out = tmpd + "/wasm_strcat_mixed.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_strcat_mixed.oo > " + wasm + " 2>" + errf).is_err() {
        if expect_quiet(p, "grep -q ERR " + errf).is_ok() {
            println("wasm_strcat_mixed_smoke: PASSED");
            return;
        }
    }
    if expect_quiet(p, "grep -qE '^ERR' " + errf + " " + wasm).is_ok() {
        println("wasm_strcat_mixed_smoke: PASSED");
        return;
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() {
            println("wasm_strcat_mixed_smoke: PASSED");
            return;
        }
        if expect_quiet(p, "test ! -s " + out).is_ok() {
            println("wasm_strcat_mixed_smoke: PASSED");
            return;
        }
        if expect_quiet(p, "grep -q 'Hello, mixed!' " + out).is_ok() {
            fail("folded ident+STRING concat");
        }
    } else if sh_which(p, "wasmtime").is_ok() {
        if check(p, "wasmtime " + wasm + " > " + out, 15).is_err() {
            println("wasm_strcat_mixed_smoke: PASSED");
            return;
        }
        if expect_quiet(p, "test ! -s " + out).is_ok() {
            println("wasm_strcat_mixed_smoke: PASSED");
            return;
        }
        if expect_quiet(p, "grep -q 'Hello, mixed!' " + out).is_ok() {
            fail("folded ident+STRING concat");
        }
    } else {
        if expect_quiet(p, "grep -a -q 'Hello, mixed!' " + wasm).is_ok() {
            fail("folded ident+STRING bytes");
        }
    }
    println("wasm_strcat_mixed_smoke: PASSED");
}
