// # Fuzz Int Depth Smoke
//
// Logline: M3 pure Int-domain depth rails — add / mul / abs / clamp / domain pass; explicit fail fixture is fail-closed.
// Setup: pure bin/ooda prebuilt; fixtures/fuzz_int_*.oo.
//
// Beats: resolve ooda | add/mul/abs/clamp/domain pass | fail fixture non-zero.

import "std/scenario.oo";
import "std/sh.oo";

const INT_FIXTURES: List[String] = [
    "fixtures/fuzz_int_add.oo",
    "fixtures/fuzz_int_mul.oo",
    "fixtures/fuzz_int_abs.oo",
    "fixtures/fuzz_int_clamp.oo",
    "fixtures/fuzz_int_domain.oo"
];

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M3 pure Int-domain depth rails");

    expect_quiet(p, "test -x " + ooda);

    when "depth fixtures run under `ooda test --fuzz 20`" {
    then "pass rails exit 0 and fail rail exits non-zero" {
    } }

    let mut i: Int = 0;
    let n: Int = 5;
    while i < n {
        let rel: String = list_get(INT_FIXTURES, i);
        check(p, "timeout 60 " + ooda + " test " + root + "/" + rel + " --fuzz 20 > " + tmpd + "/fuzz_" + rel + ".out 2> " + tmpd + "/fuzz_" + rel + ".err", within: 90);
        i = i + 1;
    }
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_int_fail.oo --fuzz 20 > " + tmpd + "/fuzz_fail.out 2> " + tmpd + "/fuzz_fail.err");
    println("fuzz_int_depth_smoke: PASSED");
}