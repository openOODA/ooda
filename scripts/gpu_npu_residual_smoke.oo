// # GPU NPU Residual Stays Honest
//
// Logline: Verify bootstrap/GPU_NPU.oot maintains residual markers and CI wiring without unverified claims.
//
// Setup: GPU_NPU.oot document, gpu_npu_marker fixture, and ci_product.sh exist on disk.
//
// Beats:
//   1. Verify GPU_NPU.oot exists with GPU_NPU_RESIDUAL_ALPHA and fail-closed phrasing.
//   2. Check gpu_npu_marker.oo fixture contains the expected residual marker line.
//   3. Confirm ci_product.sh wires gpu_npu_residual_smoke into the test suite.
import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/GPU_NPU.oot";
const FIX: String = "ooda/fixtures/gpu_npu_marker.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let _     = scenario(p, fs, "gpu npu residual honesty");

    // when — doc + marker + no product-green claim
    let _ = expect_present(fs, root + "/" + DOC);
    let _ = expect_substring(fs, root + "/" + DOC, "GPU_NPU_RESIDUAL_ALPHA");
    let _ = expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + DOC + " | grep -viE 'not |residual|do not|never|no '");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);

    // then — fixture + ci wire
    let _ = expect_present(fs, root + "/" + FIX);
    let _ = expect_substring(fs, root + "/" + FIX, "GPU_NPU: residual");
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "gpu_npu_residual_smoke");

    println("gpu_npu_residual_smoke: PASSED");
}