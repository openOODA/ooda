// # emit-x86 hello.oo greet lock
//
// Logline: emit-x86 of fixtures/hello.oo assembles and prints Hello, openOODA Developer! via as and ld.
//
// Setup: cwd is ooda/. GNU as and ld are on PATH. Host is x86_64. Product oodac/oodac.
//
// Beats:
//   1. emit-x86 fixtures/hello.oo writes _start, main, syscall, and is not C.
//   2. as --64 and ld produce a binary.
//   3. The binary prints Hello, openOODA Developer! and exits 0.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 hello greet fold").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let hello = root + "/fixtures/hello.oo";
    if expect_present(fs, hello).is_err() { fail("no hello.oo"); }

    let sfile = tmpd + "/x86_hello.s";
    let serr = tmpd + "/x86_hello.err";
    if check(p, oodac + " emit-x86 " + hello + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86");
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(".s missing _start"); }
    if expect_substring(fs, sfile, "main:").is_err() { fail(".s missing main"); }
    if expect_substring(fs, sfile, "syscall").is_err() { fail(".s missing syscall"); }
    if expect_substring(fs, sfile, "Hello, openOODA Developer!").is_err() { fail(".s missing greet line"); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() { fail(".s looks like emit-c"); }

    let obj = tmpd + "/x86_hello.o";
    let bin = tmpd + "/x86_hello.bin";
    let out = tmpd + "/x86_hello.out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as"); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld"); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run"); }
    if expect_clean(p, "grep -qx 'Hello, openOODA Developer!' " + out).is_err() { fail("stdout not greet line"); }

    println("x86_hello_smoke: PASSED");
}
