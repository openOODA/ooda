// # Crypto MD5/SHA-1 Smoke
//
// Logline: Path A MD5/SHA-1 emit + link + run produce NIST vectors; AES is STUB_FAIL_CLOSED residual.
//
// Setup: Process capability and test fixtures available.
//
// Beats: std wrappers check | vector fixture lowers internal_* | run → MD5/SHA-1 hex | chs_rt_hash AES stub.

import "std/scenario.oo";
import "std/sh.oo";

const MD5_EMPTY: String = "d41d8cd98f00b204e9800998ecf8427e";
const MD5_HELLO: String = "5d41402abc4b2a76b9719d911017c592";
const SHA1_EMPTY: String = "da39a3ee5e6b4b0d3255bfef95601890afd80709";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "crypto MD5/SHA-1 path A");

    // when std wrappers (md5/sha1/crypto) parse under oodac check
    check(p, oodac + " check ooda/std/hash/md5.oo", within: 30);
    check(p, oodac + " check ooda/std/hash/sha1.oo", within: 30);
    check(p, oodac + " check ooda/std/core/crypto.oo", within: 30);

    // and vector fixture lowers real internal_* call sites
    expect_present(fs, "ooda/fixtures/crypto_md5_sha1_vectors.oo");
    let c_vec = tmpd + "/crypto_vec.c";
    let _ = process_exec(p, oodac + " emit-c ooda/fixtures/crypto_md5_sha1_vectors.oo > " + c_vec + " 2> " + tmpd + "/crypto_vec.err");
    expect_substring(fs, c_vec, "crypto_md5_internal");
    expect_substring(fs, c_vec, "crypto_sha1_internal");
    expect_substring(fs, c_vec, "crypto_aes_encrypt_internal");

    // then build + run yields NIST vectors and AES residual
    let bin = tmpd + "/crypto_vec.bin";
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + c_vec + " -o " + bin + " -lm -ldl -lpthread", within: 60);
    let out = match process_exec(p, "timeout 5 " + bin) { Ok(s) => s, Err(_) => "" };
    let lines = str_split(out, "\n");
    expect_equal(pick(lines, 0), MD5_EMPTY);
    expect_equal(pick(lines, 1), MD5_HELLO);
    expect_equal(pick(lines, 2), SHA1_EMPTY);
    expect_equal(pick(lines, 3), "STUB_FAIL_CLOSED");

    // and runtime AES stub present (residual honesty)
    expect_substring(fs, root + "/runtime/chs_rt_hash.c", "STUB_FAIL_CLOSED");
    println("crypto_md5_sha1_smoke: PASSED");
}

fn pick(lines: List[String], i: Int) -> String {
    let n = list_len(lines);
    if i >= n { return ""; }
    return list_get(lines, i);
}