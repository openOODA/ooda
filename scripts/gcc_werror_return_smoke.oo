// # Product gcc refuses missing returns
//
// Logline: Product gcc_cmd has -Werror=return-type and -O2; hello still runs.
//
// Setup: cwd is ooda/. Product oodac/oodac. Flags match cli_build.oo.
//
// Beats:
//   1. Product strings contain -Werror=return-type and gcc -O2.
//   2. emit-c hello plus those flags plus chs_rt links.
//   3. The binary prints the greeting.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/gcc_werror_return";
    let c = tmpd + "/hello.c";
    let bin = tmpd + "/hello.bin";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "strings " + oodac +
        " | grep -q -- '-Werror=return-type'").is_err() {
        fail("no Werror return-type");
    }
    if process_exec(p, "strings " + oodac + " | grep -q 'gcc -O2'").is_err() {
        fail("no -O2");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/hello.oo > " + c).is_err() {
        fail("emit-c");
    }
    if process_exec(p, "gcc -O2 -g -Werror=implicit-function-declaration -Werror=return-type -frandom-seed=0 -Wl,--build-id=none -Iruntime " +
        c + " runtime/chs_rt.c -lm -ldl -lpthread -o " + bin).is_err() {
        fail("gcc");
    }
    if process_exec(p, bin + " | grep -q 'Hello, openOODA Developer!'").is_err() {
        fail("run");
    }
    println("gcc_werror_return_smoke: PASSED");
}
