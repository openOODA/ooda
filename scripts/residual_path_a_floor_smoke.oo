// # Residual Path A Floor Smoke
//
// Logline: every PM residual free-name call is check-refused with ERR\tresidual, plain main still passes, and --json-errors emits E_RESIDUAL.
//
// Setup: Process capability and test fixtures available.
// Beats: each residual_*_fail refuses | plain main OK | product refuses | json E_RESIDUAL.

import "std/scenario.oo";
import "std/sh.oo";

const RESIDUALS: List[String] = [
    "residual_checkpoint_fail", "residual_hive_fuzz_fail", "residual_hot_reload_fail",
    "residual_shadow_fail", "residual_metamorphic_fail", "residual_holo_fail",
    "residual_gpu_fail", "residual_bare_metal_fail", "residual_macro_fail",
    "residual_typestate_fail", "residual_dod_fail", "residual_telepathic_fail",
    "residual_lsp_fail", "residual_callgraph_fail", "residual_ffigen_fail",
    "residual_lto_fail", "residual_toolchain_fail", "residual_playground_fail",
    "residual_meta_vs_det_fail",
];

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "residual path A floor");

    // when: each residual_*_fail fixture is check-refused
    for base in RESIDUALS {
        let fix = root + "/ooda/fixtures/" + base + ".oo";
        expect_present(fs, fix);
        expect_clean(p, "!" + oodac + " check " + fix + " 2>&1 | grep -qE 'ERR\tresidual|Residual product refuse'");
    }

    // and: plain main still passes
    let okfx = root + "/ooda/fixtures/residual_path_a_ok.oo";
    expect_present(fs, okfx);
    check(p, oodac + " check " + okfx, within: 30);

    // then: --json-errors emits E_RESIDUAL for one fixture
    expect_clean(p, oodac + " check " + root + "/ooda/fixtures/residual_checkpoint_fail.oo --json-errors 2>&1 | grep -qE '\"code\":\"E_RESIDUAL\"'");

    println("residual_path_a_floor_smoke: PASSED");
}
