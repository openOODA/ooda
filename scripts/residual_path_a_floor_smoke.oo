// # Residual Path A Floor Smoke
//
// Logline: every PM residual free-name call is check-refused with ERR residual, plain main still passes, and --json-errors emits E_RESIDUAL.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Each residual_*_fail fixture is present and check-refused.
//   2. Plain residual_path_a_ok still passes oodac check.
//   3. --json-errors emits E_RESIDUAL for residual_checkpoint_fail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "residual path A floor");

    let mut residuals: List[String] = list_new();
    residuals = list_push(residuals, "residual_checkpoint_fail");
    residuals = list_push(residuals, "residual_hive_fuzz_fail");
    residuals = list_push(residuals, "residual_hot_reload_fail");
    residuals = list_push(residuals, "residual_shadow_fail");
    residuals = list_push(residuals, "residual_metamorphic_fail");
    residuals = list_push(residuals, "residual_holo_fail");
    residuals = list_push(residuals, "residual_gpu_fail");
    residuals = list_push(residuals, "residual_bare_metal_fail");
    residuals = list_push(residuals, "residual_macro_fail");
    residuals = list_push(residuals, "residual_typestate_fail");
    residuals = list_push(residuals, "residual_dod_fail");
    residuals = list_push(residuals, "residual_telepathic_fail");
    residuals = list_push(residuals, "residual_lsp_fail");
    residuals = list_push(residuals, "residual_callgraph_fail");
    residuals = list_push(residuals, "residual_ffigen_fail");
    residuals = list_push(residuals, "residual_lto_fail");
    residuals = list_push(residuals, "residual_toolchain_fail");
    residuals = list_push(residuals, "residual_playground_fail");
    residuals = list_push(residuals, "residual_meta_vs_det_fail");

    // when: each residual_*_fail fixture is check-refused
    let n: Int = list_len(residuals);
    let mut i: Int = 0;
    while i < n {
        let base: String = list_get(residuals, i);
        let fix: String = root + "/ooda/fixtures/" + base + ".oo";
        expect_present(fs, fix);
        expect_clean(p, "!" + oodac + " check " + fix + " 2>&1 | grep -qE 'ERR\tresidual|Residual product refuse'");
        i = i + 1;
    }

    // and: plain main still passes
    let okfx: String = root + "/ooda/fixtures/residual_path_a_ok.oo";
    expect_present(fs, okfx);
    check(p, oodac + " check " + okfx, within: 30);

    // then: product ooda check --json-errors is live (oodac --json-errors is not required)
    expect_clean(p, ooda + " check " + root + "/ooda/fixtures/residual_checkpoint_fail.oo --json-errors 2>&1 | grep -qE '\"code\":\"E_RESIDUAL\"|Residual product refuse'");

    println("residual_path_a_floor_smoke: PASSED");
}
