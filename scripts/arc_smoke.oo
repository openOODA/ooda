// # ARC M2 fixture smoke
//
// Logline: Prove the ARC fixture directory and a compiler exist so emit-c plus gcc can run later.
//
// Setup: Caps are injected. Fixtures live under fixtures/arc_smoke.
//
// Beats:
//   1. Resolve oodac or seed.
//   2. Prove runtime C and the fixture dir.
//   3. Print PASSED.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let _fw: &FsWriteCap = fw;
    let oodac = "oodac/oodac";
    let seed = "bootstrap/seed/oodac";
    let dir = "fixtures/arc_smoke";
    let rt = "runtime/chs_rt.c";
    let _ = scenario(p, fs, "ARC M2 fixture smoke");

    // when a compiler exists
    // and the ARC fixture dir is present
    // then arc_smoke can emit later

    if expect_quiet(p, "test -x " + oodac).is_err() {
        expect_quiet(p, "test -x " + seed);
    }
    expect_present(fs, rt);
    expect_present(fs, dir);
    println("arc_smoke: PASSED");
}
