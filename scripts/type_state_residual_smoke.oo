// # Type State Residual Stays Honest
// Logline: bootstrap/TYPE_STATE.oot and marker fixture stay on the residual rail.
// Setup: bootstrap/TYPE_STATE.oot and fixtures/typestate_marker.oo on disk.
// Beats: 1. doc marker present | 2. no shipped-without-residual claim | 3. ci_product wire intact

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let doc   = root + "/bootstrap/TYPE_STATE.oot";
    let fix   = root + "/fixtures/typestate_marker.oo";
    let label = "type_state_residual_smoke";

    let _ = scenario(p, fs, "type state residual");

    // when — doc present + marker
    let _ = expect_present(fs, doc);
    let _ = expect_quiet(p, "grep -q TYPE_STATE_RESIDUAL_ALPHA " + doc);
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + doc);

    // and — fixture + marker line
    let _ = expect_present(fs, fix);
    let _ = expect_quiet(p, "grep -q 'TYPE_STATE: residual' " + fix);

    // then — ban shipped-without-residual claim + ci wire
    let claim = "grep -nEi 'fully shipped|enforced in product|sandbox is live' " + doc + " 2>/dev/null | grep -viE 'not |residual|do not|never|no '";
    let _     = expect_quiet(p, "test -z \"$(" + claim + ")\"");

    let dual = "grep -rn --include='*.oot' -E 'shipped as enforced|fully sealed shipped' " + root + "/bootstrap 2>/dev/null | grep -v TYPE_STATE.oot | grep -vi residual | head -5 || true";
    let _    = expect_quiet(p, "test -z \"$(" + dual + ")\"");

    let _    = expect_quiet(p, "grep -q '" + label + "' " + root + "/scripts/ci_product.sh");

    println(label + ": PASSED");
}
