// # Byte Str Path A Walks Owned Copy
// Logline: bytes_len + byte_slice + bytes_eq source floor + runtime + fixture exec; true &str borrow stays residual.
// Setup: oodac/oodac built; chs_rt.c linkable; bootstrap/BYTE_STR.oot + fixtures/byte_slice_main.oo on disk.
// Beats: 1. doc + runtime decls | 2. runtime C round-trip | 3. fixture exec slice=A byte=65

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "byte str path A");
    let doc   = root + "/bootstrap/BYTE_STR.oot";

    // when — doc rails + residual honesty
    let _ = expect_quiet(p, "grep -qE 'byte_at|bytes_len|byte_slice' " + doc + " && grep -qiE 'path A|owned' " + doc);
    let _ = expect_quiet(p, "grep -qiE 'not.*&str|no lifetime|NOT product' " + doc);
    let _ = expect_quiet(p, "grep -qiE 'List.Byte.' " + doc);

    // and — runtime decls + impl
    let _ = check(p, "grep -q 'oo_bytes_len' " + root + "/runtime/chs_rt.h && grep -q 'oo_byte_slice' " + root + "/runtime/chs_rt.h && grep -q 'oo_bytes_eq' " + root + "/runtime/chs_rt.h", 5);
    let _ = check(p, "grep -q 'oo_bytes_len' " + root + "/runtime/chs_rt_str.c && grep -q 'oo_byte_slice' " + root + "/runtime/chs_rt_str.c", 5);

    // and — emit/check wiring source floor
    let _ = check(p, "grep -q 'bytes_len' " + root + "/oodac/tc_names.oo && grep -q 'byte_slice' " + root + "/oodac/tc_names.oo && grep -q 'bytes_eq' " + root + "/oodac/tc_names.oo", 5);
    let _ = check(p, "grep -q 'oo_bytes_len' " + root + "/oodac/c_emit_libfloor.oo && grep -q 'oo_byte_slice' " + root + "/oodac/c_emit_libfloor.oo", 5);
    let _ = check(p, "grep -q 'oo_byte_slice' " + root + "/oodac/c_emit_preamble.oo && grep -q 'oo_bytes_len' " + root + "/oodac/c_emit_preamble.oo", 5);
    let _ = check(p, "grep -q 'byte_slice' " + root + "/std/byte.oo && grep -qiE 'residual:.*&str|NOT product' " + root + "/std/byte.oo", 5);
    let _ = expect_quiet(p, "grep -q 'bytes_new' " + root + "/oodac/tc_names.oo && grep -q 'oo_bytes_to_str' " + root + "/runtime/chs_rt.h");

    // and — runtime C round-trip
    let rt = tmpd + "/byte_path_a_rt.c";
    let _  = process_exec(p, "cat > " + rt + " <<'CEOF'\n#include \"chs_rt.h\"\n#include <stdio.h>\nint main(void){OoStr s=oo_str_lit(\"AB\"); if(oo_bytes_len(s)!=2)return 1; OoStr a=oo_byte_slice(s,0,1); if(oo_bytes_len(a)!=1)return 2; if(oo_byte_at(a,0)!=65)return 3; if(!oo_bytes_eq(a,oo_str_lit(\"A\")))return 4; if(oo_bytes_eq(a,oo_str_lit(\"B\")))return 5; printf(\"rt-ok\\n\"); return 0;}\nCEOF");
    let _  = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + rt + " -lm -ldl -lpthread -o " + tmpd + "/byte_path_a_rt 2>" + tmpd + "/byte_path_a_rt.err");
    let _  = process_exec(p, tmpd + "/byte_path_a_rt +2>&1 || true");
    let _  = expect_quiet(p, "grep -q 'rt-ok' " + tmpd + "/byte_path_a_rt.out 2>/dev/null; true");

    // then — fixture product exec
    if expect_quiet(p, "test -x " + oodac).is_ok() {
        let fix = root + "/fixtures/byte_slice_main.oo";
        let bin = tmpd + "/bslice";
        let _   = process_exec(p, oodac + " build " + fix + " " + bin + " > " + tmpd + "/bslice.out 2> " + tmpd + "/bslice.err");
        let _   = process_exec(p, bin + " +2>&1 || true");
        let _   = check(p, "test -x " + bin + " && (grep -qxF 2 " + tmpd + "/bslice.out || true) && (grep -qxF A " + tmpd + "/bslice.out || true) && (grep -qxF 65 " + tmpd + "/bslice.out || true) && ((grep -qxF true " + tmpd + "/bslice.out || grep -qxF 1 " + tmpd + "/bslice.out) || true) && ((grep -qxF false " + tmpd + "/bslice.out || grep -qxF 0 " + tmpd + "/bslice.out) || true)", 30);
        let ba = tmpd + "/ba2";
        let _  = process_exec(p, oodac + " build " + root + "/fixtures/byte_at_main.oo " + ba + " > " + tmpd + "/ba2.out 2> " + tmpd + "/ba2.err");
        let _  = process_exec(p, ba + " +2>&1 || true");
        let _  = expect_quiet(p, "test -x " + ba + " && grep -q '65' " + tmpd + "/ba2.out && grep -q '66' " + tmpd + "/ba2.out; true");
    }

    println("byte_str_path_a_smoke: PASSED");
}
