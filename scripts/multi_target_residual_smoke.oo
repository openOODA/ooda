// # Multi Target Residual Smoke
//
// Logline: bootstrap/MULTI_TARGET.oot names the residual marker, fail-closed framing, and the ci script wires it.
// Beats: marker | residual wording | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/MULTI_TARGET.oot";
const MARKER: String = "MULTI_TARGET_RESIDUAL_ALPHA";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "multi target residual honesty");

    // when: doc carries the marker and residual wording
    expect_present(fs, DOC);
    expect_substring(fs, DOC, MARKER);
    expect_clean(p, "grep -qiE 'fail-closed residual|Fail-closed residual|not claim|not product' " + DOC);

    // then: ci_product.sh references this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "multi_target_residual_smoke");
    println("multi_target_residual_smoke: PASSED");
}
