// # Multi-Target Residual Smoke
//
// Logline: bootstrap/MULTI_TARGET.oot carries the residual marker, fail-closed wording, and is wired into ci_product.
//
// Setup: Process capability and test fixtures available.
//
// Beats: doc + marker | fail-closed residual wording | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "multi-target residual honesty");

    // when "doc + residual marker present" {
    // and  "fail-closed residual wording" {
    // and  "ci_product wires this script" {
    // then "multi_target_residual_smoke PASSED" { } } }

    expect_present(fs, "bootstrap/MULTI_TARGET.oot");
    expect_substring(fs, "bootstrap/MULTI_TARGET.oot", "MULTI_TARGET_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fail-closed residual|Fail-closed residual|not claim|not product' " + "bootstrap/MULTI_TARGET.oot");
    expect_substring(fs, root + "/scripts/ci_product.sh", "multi_target_residual_smoke");
    println("multi_target_residual_smoke: PASSED");
}
