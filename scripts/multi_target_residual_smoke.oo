// ===================================================================
// Multi Target Residual Smoke
// ===================================================================

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let script_name = "multi_target_residual_smoke";
    
    // Check for marker
    let check_marker = cmd_exec(p, "grep -q MULTI_TARGET_RESIDUAL_ALPHA " + root + "/bootstrap/MULTI_TARGET.oot");
    tr = test_assert(tr, "MULTI_TARGET.oot contains marker", check_marker.is_ok());
    
    // Check for residual wording
    let check_residual = cmd_exec(p, "grep -qiE 'fail-closed residual|Fail-closed residual|not claim|not product' " + root + "/bootstrap/MULTI_TARGET.oot");
    tr = test_assert(tr, "MULTI_TARGET.oot contains residual description", check_residual.is_ok());
    
    // Check ci_product.sh reference
    let check_ci = cmd_exec(p, "grep -q '" + script_name + "' " + root + "/scripts/ci_product.sh");
    tr = test_assert(tr, "ci_product.sh references " + script_name, check_ci.is_ok());
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("multi_target_residual_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
