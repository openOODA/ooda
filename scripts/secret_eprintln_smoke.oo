// ===================================================================
// Secret Eprintln Smoke
// ===================================================================
// job: Phase 2: Secret eprintln sink depth (M160)
// in:  oodac/oodac
// out: exit 0 if eprintln secret checks pass

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
    let tmpdir = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    
    // Check oodac exists
    let oodac_exists = cmd_exec(p, "test -x " + oodac);
    if !oodac_exists.is_ok() {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    
    // Setup temp dir
    let mkdir_res = cmd_exec(p, "mkdir -p " + tmpdir);
    if !mkdir_res.is_ok() {
        println("FAIL: cannot create temp dir " + tmpdir);
        process_exit(1);
    }
    
    // 1) eprintln SECRET refuse
    let se_f_out = tmpdir + "/se_f.out";
    let se_f_err = tmpdir + "/se_f.err";
    let se_f_res = cmd_exec(p, oodac + " check " + root + "/fixtures/secret_eprintln_fail.oo >" + se_f_out + " 2>" + se_f_err);
    if !se_f_res.is_ok() {
        let check_err = cmd_exec(p, "grep -qE $'ERR\\tsecret' " + se_f_out + " " + se_f_err + " 2>/dev/null");
        tr = test_assert(tr, "eprintln SECRET refuse", check_err.is_ok());
    } else {
        tr = test_assert(tr, "eprintln fail should refuse", false);
    }
    
    // 2) eprintln public pass
    let se_p_out = tmpdir + "/se_p.out";
    let se_p_err = tmpdir + "/se_p.err";
    let se_p_res = cmd_exec(p, oodac + " check " + root + "/fixtures/secret_eprintln_pass.oo >" + se_p_out + " 2>" + se_p_err);
    if se_p_res.is_ok() {
        let check_ok = cmd_exec(p, "grep -qE '^OK' " + se_p_out);
        tr = test_assert(tr, "eprintln public pass", check_ok.is_ok());
    } else {
        tr = test_assert(tr, "eprintln pass should OK", false);
    }
    
    // 3) println secret still works (no regression)
    let se_old_out = tmpdir + "/se_old.out";
    let se_old_err = tmpdir + "/se_old.err";
    let se_old_res = cmd_exec(p, oodac + " check " + root + "/fixtures/secret_sink_fail.oo >" + se_old_out + " 2>" + se_old_err);
    if !se_old_res.is_ok() {
        tr = test_assert(tr, "println secret still refuse", true);
    } else {
        tr = test_assert(tr, "println secret regression", false);
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("secret_eprintln_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
