// # Secret Eprintln Smoke
//
// Logline: Verify compiler secret tracking rejects secret sinks in eprintln and maintains println protection.
//
// Setup: oodac compiler binary and secret sink fixtures exist on disk.
//
// Beats:
//   1. Check secret_eprintln_fail fixture to verify secret values in eprintln are refused.
//   2. Check secret_eprintln_pass fixture to verify non-secret values in eprintln are accepted.
//   3. Check secret_sink_fail fixture to ensure println secret sink protections remain active.
import "std/scenario.oo";
import "std/sh.oo";

const TMP: String = ".ooda-cache/ooda-tmp/secret_eprintln";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, root + "/" + TMP);
    let _     = scenario(p, fs, "secret eprintln sink depth");

    // when — eprintln SECRET refuse
    let se_f = root + "/" + TMP + "/se_f.out";
    let se_e = root + "/" + TMP + "/se_f.err";
    let _ = process_exec(p, oodac + " check " + root + "/fixtures/secret_eprintln_fail.oo >" + se_f + " 2>" + se_e);
    let _ = expect_clean(p, "!" + oodac + " check " + root + "/fixtures/secret_eprintln_fail.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // and — eprintln public pass
    let se_p = root + "/" + TMP + "/se_p.out";
    let _ = process_exec(p, oodac + " check " + root + "/fixtures/secret_eprintln_pass.oo >" + se_p + " 2>" + root + "/" + TMP + "/se_p.err");
    let _ = expect_quiet(p, "grep -qE '^OK' " + se_p);

    // then — println secret still refuses (no regression)
    let _ = expect_clean(p, "!" + oodac + " check " + root + "/fixtures/secret_sink_fail.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    println("secret_eprintln_smoke: PASSED");
}