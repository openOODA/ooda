// # emit-x86 dynamic List[T] smoke test
//
// Logline: emit-x86 of fixtures/x86_list.oo assembles via GNU as and ld, executes list_new/push/get/len, and verifies output.
//
// Beats:
//   1. emit-x86 produces .s with list_new, list_push, list_get, and list_len routines.
//   2. as --64 and ld link standalone pure executable without libc.
//   3. Execution verifies 20 elements, first element 100, last element 119.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 dynamic list lowering").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_list.oo";
    if expect_present(fs, src).is_err() { fail("no x86_list.oo"); }

    let sfile = tmpd + "/x86_list.s";
    let serr = tmpd + "/x86_list.err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86");
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s"); }
    if expect_substring(fs, sfile, "list_new").is_err() { fail(".s missing list_new"); }
    if expect_substring(fs, sfile, "list_push").is_err() { fail(".s missing list_push"); }
    if expect_substring(fs, sfile, "list_get").is_err() { fail(".s missing list_get"); }
    if expect_substring(fs, sfile, "list_len").is_err() { fail(".s missing list_len"); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() { fail(".s looks like emit-c"); }

    let obj = tmpd + "/x86_list.o";
    let bin = tmpd + "/x86_list.bin";
    let out = tmpd + "/x86_list.out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as"); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld"); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run"); }
    if expect_substring(fs, out, "20").is_err() { fail("out missing length 20"); }
    if expect_substring(fs, out, "100").is_err() { fail("out missing first elem 100"); }
    if expect_substring(fs, out, "119").is_err() { fail("out missing last elem 119"); }

    println("x86_list_smoke: PASSED");
}
