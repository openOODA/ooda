// # emit-x86 while loop that actually loops lock
//
// Logline: Lock emit-x86 output against the named regression scenario with one command-line assert per smoke.
//
// Setup: Native execution smoke test harness.
//
// Beats:
//   1. Initialize state parameters and validate preconditions.
//   2. Execute primary algorithmic transformation.
//   3. Return fail-closed results with deterministic error handling.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) { println("FAIL " + msg); process_exit(1); }
fn pick_oodac(p: &ProcessCap, root: String) -> String { return root + "/oodac/oodac"; }

fn emit_as_ld(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_while_loop_" + tag + ".s";
    let serr = tmpd + "/x86_while_loop_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail("emit-x86 " + tag); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_clean(p, "grep -q 'cmpq $2, -8(%rbp)' " + sfile).is_err() { fail("no loop cmp " + tag); }
    if expect_clean(p, "grep -q 'jmp .Lwhile_start_0' " + sfile).is_err() { fail("no loop jmp " + tag); }
    let obj = tmpd + "/x86_while_loop_" + tag + ".o";
    let bin = tmpd + "/x86_while_loop_" + tag + ".bin";
    let out = tmpd + "/x86_while_loop_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    let count_cmd = "grep -c '^loop$' " + out + " | grep -qx 2";
    if expect_clean(p, count_cmd).is_err() { fail("stdout did not loop twice " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 while loop that actually loops").is_err() { fail("scenario"); }
    let oodac = pick_oodac(p, root);
    let src = root + "/fixtures/x86_while_loop.oo";
    emit_as_ld(p, fs, oodac, src, tmpd, "r1");
    println("x86_while_loop_smoke: PASSED");
}
