// # Base64 Encoding Floor C Emission Smoke
// Logline: Verify oodac emit-c on std/encoding/base64.oo completes within 30-second timeout budget and emits complete function bodies.
// Setup: cwd is ooda/. Product oodac and std/encoding/base64.oo exist.
// Beats: 1. emit-c std/encoding/base64.oo within 30-second budget | 2. verify complete function bodies are emitted | 3. verify GCC compilation of emitted C

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let b64_src = "std/encoding/base64.oo";
    let tmpd = ".ooda-cache/ooda-tmp/encoding_emit";

    if !path_exists(fs, oodac) { fail("no oodac"); }
    if !path_exists(fs, b64_src) { fail("no std/encoding/base64.oo"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    // Beat 1: emit-c with timeout 30
    let out_c = tmpd + "/base64.c";
    let out_err = tmpd + "/base64.err";

    let emit_res = process_exec(p, "timeout 30 " + oodac + " emit-c " + b64_src + " > " + out_c + " 2> " + out_err);
    if emit_res.is_err() { fail("emit-c timeout or failed on base64.oo"); }

    // Beat 2: Verify full function bodies are emitted (not stubbed or skipped)
    let chk_encode = process_exec(p, "grep -qE 'OoStr base64_encode\\(OoStr s\\) \\{' " + out_c);
    if chk_encode.is_err() { fail("base64_encode body missing in emitted C"); }

    let chk_decode = process_exec(p, "grep -qE 'OoResS base64_decode\\(OoStr s\\) \\{' " + out_c);
    if chk_decode.is_err() { fail("base64_decode body missing in emitted C"); }

    let chk_valid = process_exec(p, "grep -qE 'int base64_is_valid\\(OoStr s\\) \\{' " + out_c);
    if chk_valid.is_err() { fail("base64_is_valid body missing in emitted C"); }

    let chk_custom = process_exec(p, "grep -qE 'OoStr base64_encode_custom\\(OoStr s, Base64Config cfg\\) \\{' " + out_c);
    if chk_custom.is_err() { fail("base64_encode_custom body missing in emitted C"); }

    // Beat 3: Verify GCC compilation of emitted C code
    let gcc_res = process_exec(p, "gcc -c -O2 -Iruntime " + out_c + " -o " + tmpd + "/base64.o");
    if gcc_res.is_err() { fail("gcc compilation failed on emitted base64.c"); }

    println("encoding_emit_smoke: PASSED");
}
