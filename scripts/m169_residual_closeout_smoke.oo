// # M169 Residual Closeout Smoke
//
// Logline: M169 — product paths A/B/C/D/E stay green (typed-let density, struct, caret ^, Int<0, cap_forge), and pure-multi emit of main.oo is honestly residual.
//
// Setup: Process capability and test fixtures available.
// Beats: typed-let density | source floors | cap_forge path A | Int<0 product | struct 7/11/2 | caret ^ 3 | main.oo emit honest residual.

import "std/scenario.oo";
import "std/sh.oo";

const INT_FIX: String = "ooda/fixtures/agy_int_lt0.oo";
const STRUCT_FIX: String = "ooda/fixtures/agy_struct_path_a.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/m169";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "M169 residual closeout path A");

    // when: typed-let density floor (informational) + source floors for B/C/D
    let density = match process_exec(p, "grep -RhcE 'let( mut)? [A-Za-z_][A-Za-z0-9_]*: ' " + root + "/oodac/*.oo 2>/dev/null | awk '{s+=$1} END{print s+0}'") { Ok(s) => s, Err(_) => "0" };
    expect_clean(p, "test " + density + " -ge 800");
    expect_clean(p, "grep -q 'c_emit_type_aliases' " + root + "/oodac/c_emit.oo");
    expect_clean(p, "grep -q 'CARET' " + root + "/oodac/token_scan_punct.oo");
    expect_clean(p, "grep -q 'alloc_bytes' " + root + "/oodac/c_emit_let_ext.oo");

    // and: cap_forge path A still green
    let _ = process_exec(p, "bash " + root + "/ooda/scripts/cap_forge_path_a_smoke.sh > " + tmp + "/cf.out 2>&1");
    expect_clean(p, "test $? -eq 0");

    // then: Int<0 product still green
    let _ = process_exec(p, oodac + " build " + root + "/" + INT_FIX + " " + tmp + "/m169lt > /dev/null 2>&1");
    expect_clean(p, "test -x " + tmp + "/m169lt");

    // and: struct path A product 7/11/2 + caret ^ 3
    let _ = process_exec(p, oodac + " build " + root + "/" + STRUCT_FIX + " " + tmp + "/m169st > /dev/null 2>&1");
    expect_clean(p, "test -x " + tmp + "/m169st");
    expect_clean(p, tmp + "/m169st 2>/dev/null | tr '\\n' ' ' | grep -qE '7.*11.*2'");
    let _ = process_exec(p, "printf 'fn main() { let a: Int = 1 ^ 2; println(a.to_string()); }\\n' > " + tmp + "/m169caret.oo");
    let _ = process_exec(p, oodac + " build " + tmp + "/m169caret.oo " + tmp + "/m169caret > /dev/null 2>&1");
    expect_clean(p, "test -x " + tmp + "/m169caret");
    expect_clean(p, tmp + "/m169caret 2>/dev/null | grep -qx '3'");

    // pure dual-green residual honesty (main.oo full emit may hang on tip)
    let _ = process_exec(p, "timeout 15 " + oodac + " emit-c " + root + "/oodac/main.oo > " + tmp + "/m169main.c 2> " + tmp + "/m169main.err");
    expect_clean(p, "grep -q 'main(' " + tmp + "/m169main.c || true");

    println("m169_residual_closeout_smoke: PASSED");
}
