// # OODA Fuzz Pure Arity
//
// Logline: per-target arity helpers for the pure contract fuzz — Int / Bool / String / List[Int] gates; multi-arg require all-typed for the chosen domain (fail-closed on arity ≥2 wrong-typed).
//
// Setup: Process capability and test fixtures available.
//
// Beats: arity probe | all-int gate | all-bool gate | all-string gate | all-list gate | arity fail-closed.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "fuzz pure arity helpers");

    when "arity probe scans (pub )fn signature" {
    and  "all-int / all-bool / all-string / all-list gates" {
    and  "arity ≥2 in unknown domain fail-closed" {
    and  "arity 0 target fail-closed" {
    then "ooda_fuzz_pure_arity PASSED" { } } } }

    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_fn_arity");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_fn_params_all_int");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_fn_params_all_bool");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_fn_params_all_string");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_fn_params_all_list");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fuzz_check_arity");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_arity.sh", "fail-closed");
    expect_present(fs, root + "/scripts/ooda_fuzz_pure.sh");
    println("ooda_fuzz_pure_arity: PASSED (arity helpers catalogued)");
}
