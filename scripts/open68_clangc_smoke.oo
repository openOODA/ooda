// # OPEN-68 clang -c lock for oodac main IR
//
// Logline: Emit-llvm of oodac/main.oo types sys_exec as %OoResS and clang -c accepts the IR.
//
// Setup: cwd is ooda/. Prefer side ELF .ooda-cache/ooda-tmp/oodac_clangc. Host clang exists.
//
// Beats:
//   1. --backend llvm emit-llvm oodac/main.oo with the proof ELF.
//   2. IR has call %OoResS @sys_exec and no call i64 @sys_exec.
//   3. clang -c on that IR exits 0. A rewritten i64 call makes clang -c fail.
// residual: clang link of full oodac is not this lock.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let mut oodac = tmpd + "/oodac_clangc";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = tmpd + "/oodac_fntab";
    }
    if process_exec(p, "test -x " + oodac).is_err() {
        fail("no side proof oodac");
    }
    if !path_exists(fs, "oodac/main.oo") { fail("no main.oo"); }
    if !path_exists(fs, "oodac/llvm_fntab.oo") { fail("no llvm_fntab"); }
    if process_exec(p, "grep -q 'sys_exec=%OoResS' oodac/llvm_fntab.oo").is_err() {
        fail("source missing builtin Result fntab");
    }
    if process_exec(p, "grep -q 'llvm_builtin_fntab' oodac/llvm_emit.oo").is_err() {
        fail("emit path does not consult builtin fntab");
    }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    let ll = tmpd + "/open68_clangc.ll";
    let err = tmpd + "/open68_clangc.err";
    let obj = tmpd + "/open68_clangc.o";
    if process_exec(p, oodac + " --backend llvm emit-llvm oodac/main.oo > " + ll + " 2> " + err).is_err() {
        fail("emit-llvm");
    }
    if process_exec(p, "grep -q 'call %OoResS @sys_exec' " + ll).is_err() {
        fail("sys_exec not %OoResS");
    }
    if process_exec(p, "grep -q 'call i64 @sys_exec' " + ll).is_ok() {
        fail("sys_exec still i64");
    }
    if process_exec(p, "clang -O0 -Wno-override-module -c " + ll + " -o " + obj + " 2> " + tmpd + "/open68_clangc.clang").is_err() {
        fail("clang -c");
    }
    if process_exec(p, "test -s " + obj).is_err() {
        fail("empty object");
    }

    let bad = tmpd + "/open68_clangc_hostile.ll";
    let badobj = tmpd + "/open68_clangc_hostile.o";
    if process_exec(p, "sed 's/call %OoResS @sys_exec/call i64 @sys_exec/' " + ll + " > " + bad).is_err() {
        fail("hostile copy");
    }
    if process_exec(p, "grep -q 'call i64 @sys_exec' " + bad).is_err() {
        fail("hostile missing i64 rewrite");
    }
    if process_exec(p, "clang -O0 -Wno-override-module -c " + bad + " -o " + badobj + " 2> " + tmpd + "/open68_clangc_hostile.clang").is_ok() {
        fail("hostile clang -c still succeeded");
    }
    if process_exec(p, "grep -qi 'error:' " + tmpd + "/open68_clangc_hostile.clang").is_err() {
        fail("hostile log missing type error");
    }

    println("open68_clangc_smoke: clang -c of oodac/main.oo IR ok");
    println("open68_clangc_smoke: full oodac clang-link residual");
    println("open68_clangc_smoke: PASSED");
}
