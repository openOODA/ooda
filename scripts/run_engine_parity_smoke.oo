// # Run Engine Parity Smoke
//
// Logline: M11 — `--engine native` and `--engine bc` produce identical output for shared fixtures, bad engines fail-closed, `--engine` without value fails.
//
// Setup: Process capability and test fixtures available.
// Beats: bad engines fail-closed | missing value fail-closed | parity native ≡ bc | default ≡ native.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "run engine parity native ≡ bc");

    // when: bad engines fail-closed (invalid name + missing value)
    expect_clean(p, "!" + ooda + " run --engine bogon oods/fixtures/chs_hello.oo 2>&1 | grep -qiE 'invalid engine|ERR'");
    expect_clean(p, "!" + ooda + " run --engine 2>&1");

    // then: native ≡ bc ≡ default for shared fixtures
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "oods/fixtures/chs_hello.oo");
    xs = list_push(xs, "oods/fixtures/while_count.oo");
    xs = list_push(xs, "oods/fixtures/for_range.oo");

    let mut i: Int = 0;
    while i < list_len(xs) {
        let item = list_get(xs, i);
        expect_clean(p, "test -f " + root + "/" + item);
        check(p, ooda + " run --engine native " + root + "/" + item, within: 30);
        check(p, ooda + " run --engine bc " + root + "/" + item, within: 30);
        check(p, ooda + " run " + root + "/" + item, within: 30);
        i = i + 1;
    }

    println("run_engine_parity_smoke: PASSED");
}
