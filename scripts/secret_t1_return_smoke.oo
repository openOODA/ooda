// # Secret T1 Return Smoke
//
// Logline: T1 zero-trust depth — function-return SECRET refuses, alias-rebind SECRET refuses, alias-rebind clean allows (sticky cleared), if-taint refuses / clean allows.
//
// Setup: Process capability and test fixtures available.
// Beats: function return | alias rebind | if-taint.

import "std/scenario.oo";
import "std/sh.oo";

const REQ: List[String] = [
    "secret_function_return_fail", "secret_function_return_pass",
    "secret_alias_rebind_fail", "secret_alias_rebind_pass",
    "secret_if_taint_fail", "secret_if_taint_pass",
];

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "secret T1 return");

    // when: every T1 fixture is present
    for base in REQ {
        expect_present(fs, root + "/ooda/fixtures/" + base + ".oo");
    }

    // and: function-return + alias-rebind-pass + if-taint-fail refuse
    expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/secret_function_return_fail.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/secret_alias_rebind_pass.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/secret_if_taint_fail.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // then: pass fixtures do not raise ERR\tsecret
    expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/secret_function_return_pass.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/secret_if_taint_pass.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "secret_t1_return_smoke");
    println("secret_t1_return_smoke: PASSED");
}
