// # Fixed-Point Referee
//
// Logline: pure seed builds stage-1, stage-1 real-builds CHS smoke, seed builds stage-2, s1≡s2 token digests match, no OK_HOST.
// Setup: prebuilt pure SEED_OODAC (bootstrap/seed/oodac or oodac/oodac); bwrap available; gcc.
//
// Beats: seed resolves | stage-1 builds + OK_PURE | stage-1 smoke runs | stage-2 builds | s1≡s2 token digests | drift demo would fail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("") + "/fp";
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "M5 fixed-point pure seed → stage-1 ≡ stage-2");

    expect_present(fs, root + "/oodac/main.oo");
    expect_present(fs, root + "/fixtures/chs_list_string.oo");
    expect_present(fs, root + "/fixtures/int_main.oo");

    when "seed resolves (env or repo path)" {
    and  "seed builds stage-1 with OK_PURE / no OK_HOST" {
    and  "stage-1 real-builds CHS smoke to `2` output" {
    and  "seed builds stage-2; bit-identical or new bytes; OK_PURE" {
    and  "s1 ≡ s2 token digests (sha256 over tab-prefixed lines)" {
    and  "drift would-fail demo" {
    then "fixed_point PASSED" {
    } } } } } }

    let seed: String = match sh_env_get_or(p, "SEED_OODAC", root + "/bootstrap/seed/oodac") { Ok(s) => s, Err(_) => "" };
    if seed == "" {
        expect_quiet(p, "test -x " + root + "/oodac/oodac");
        seed = root + "/oodac/oodac";
    }
    expect_quiet(p, "test -x " + seed);

    let seed_copy: String = tmpd + "/fp_seed_oodac";
    check(p, "cp -a " + seed + " " + seed_copy + " && chmod +x " + seed_copy, within: 30);

    let stage1: String = root + "/oodac/oodac";
    let stage2: String = root + "/oodac/oodac2";
    check(p, "(cd " + root + " && env -u OODA OODAC_BIN=" + seed_copy + " bwrap --bind / / --dev /dev --proc /proc --bind " + tmpd + " /tmp " + seed_copy + " build " + root + "/oodac/main.oo " + stage1 + ") > " + tmpd + "/seed_build_s1.txt 2>&1", within: 600);
    expect_clean(p, "! grep -q 'OK_HOST' " + tmpd + "/seed_build_s1.txt");
    expect_clean(p, "grep -qE 'OK_PURE|OK_PURE_MULTI|OK\\tbuild' " + tmpd + "/seed_build_s1.txt");

    let smoke: String = tmpd + "/chs_smoke_real";
    check(p, "(cd " + root + " && " + stage1 + " build " + root + "/fixtures/chs_list_string.oo " + smoke + ") > " + tmpd + "/stage1_build_smoke.txt 2>&1", within: 60);
    expect_clean(p, "test -x " + smoke + " && " + smoke + " 2>&1 | tr -d '\\r' | grep -q '2'");

    check(p, "(cd " + root + " && env -u OODA OODAC_BIN=" + seed_copy + " bwrap --bind / / --dev /dev --proc /proc --bind " + tmpd + " /tmp " + seed_copy + " build " + root + "/oodac/main.oo " + stage2 + ") > " + tmpd + "/stage1_build_oodac.txt 2>&1", within: 600);
    expect_clean(p, "! grep -q 'OK_HOST' " + tmpd + "/stage1_build_oodac.txt");
    expect_clean(p, "grep -qE 'OK_PURE|OK_PURE_MULTI|OK_PURE_NATIVE' " + tmpd + "/stage1_build_oodac.txt");

    check(p, stage1 + " tokens " + root + "/fixtures/int_main.oo > " + tmpd + "/s1_tok.txt 2>&1", within: 30);
    check(p, stage2 + " tokens " + root + "/fixtures/int_main.oo > " + tmpd + "/s2_tok.txt 2>&1", within: 30);
    expect_clean(p, "grep $'\\t' " + tmpd + "/s1_tok.txt | sha256sum | awk '{print $1}' > " + tmpd + "/fp_s1.sha");
    expect_clean(p, "grep $'\\t' " + tmpd + "/s2_tok.txt | sha256sum | awk '{print $1}' > " + tmpd + "/fp_s2.sha");
    expect_clean(p, "diff -q " + tmpd + "/fp_s1.sha " + tmpd + "/fp_s2.sha");

    expect_clean(p, "! diff -q " + tmpd + "/fp_s1.sha <(echo deadbeef)");
    println("fixed_point: PASSED");
}