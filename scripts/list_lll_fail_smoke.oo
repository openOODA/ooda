// # Triple List emit is fail-closed
//
// Logline: emit-c refuses List[List[List[Int]]] and still runs list_ll_int_smoke.
//
// Setup: cwd is ooda/. Product oodac/oodac. gcc -O2 plus chs_rt is the run path.
//
// Beats:
//   1. emit-c of list_lll_int_fail.oo is ERR c_emit and has no OoLLL_ typedef.
//   2. list_ll_int_smoke emit+gcc+run prints PASSED.
//   3. Two-deep List stays product.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/list_lll";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/list_lll_int_fail.oo > " + tmpd + "/fail.c 2> " +
        tmpd + "/fail.err; true").is_err() {
        fail("emit fail");
    }
    if process_exec(p, "grep -qE '^ERR.c_emit' " + tmpd + "/fail.c " + tmpd +
        "/fail.err && ! grep -qE 'OoLLL_' " + tmpd + "/fail.c").is_err() {
        fail("triple List not residual");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/list_ll_int_smoke.oo > " + tmpd + "/ll.c && gcc -O2 -Iruntime runtime/chs_rt.c " +
        tmpd + "/ll.c -lm -ldl -lpthread -o " + tmpd + "/ll.bin && " + tmpd +
        "/ll.bin | grep -q 'list_ll_int_smoke: PASSED'").is_err() {
        fail("list_ll");
    }
    println("list_lll_fail_smoke: PASSED");
}
