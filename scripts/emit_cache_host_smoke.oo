// # User oodac build emit-cache mixes host ELF stamp
//
// Logline: Cache names mix host size:mtime with the source sha so another compiler ELF cannot reuse C.
//
// Setup: cwd is ooda/. Isolated .ooda-cache/ooda-tmp/c_lane/oodac.c1 if present, else product oodac/oodac. Native build of fixtures/c_line_main.oo.
//
// Beats:
//   1. Cold build prints emit_cache skip= and the binary prints 2.
//   2. Warm rebuild skip is at least 1 of 2.
//   3. ls of .ooda-cache/oodac_emit is not sha256sum(module).pb.c; a planted old-style name is a different path and a miss.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut oodac = ".ooda-cache/ooda-tmp/c_lane/oodac.c1";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = "./oodac/oodac";
    }
    let tmpd = ".ooda-cache/ooda-tmp/emit_cache_host";
    let cdir = ".ooda-cache/oodac_emit";
    let bin = "fixtures/c_line_main.oo.bin";
    let lib = "fixtures/c_line_lib.oo";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "rm -f " + bin + " " + bin + ".tmp.c").is_err() {
        fail("rm");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/cold.out").is_err() {
        fail("cold build");
    }
    if process_exec(p, "grep -q 'emit_cache skip=' " + tmpd +
        "/cold.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("cold run");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/warm.out").is_err() {
        fail("warm build");
    }
    if process_exec(p, "grep -qE 'emit_cache skip=[1-9]' " + tmpd +
        "/warm.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("warm skip");
    }
    if process_exec(p, "h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); test \"$h\" != \"\" && ls " + cdir +
        " | grep -q '_'\"$h\"'\\.pb\\.c'").is_err() {
        fail("key not stamped");
    }
    if process_exec(p, "h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); printf 'FAKE\\n' > " + cdir +
        "/$h.pb.c; ls " + cdir + " | grep -q '_'\"$h\"'\\.pb\\.c' && test -f " +
        cdir + "/$h.pb.c").is_err() {
        fail("plant path");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/plant.out").is_err() {
        fail("plant build");
    }
    if process_exec(p, "grep -qE 'emit_cache skip=[1-9]' " + tmpd +
        "/plant.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("plant still skip");
    }
    if process_exec(p, "h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); rm -f " + cdir +
        "/*_\"$h\".pb.c; " + oodac + " build fixtures/c_line_main.oo > " +
        tmpd + "/miss.out").is_err() {
        fail("miss build");
    }
    if process_exec(p, "grep -q 'emit_cache skip=1' " + tmpd +
        "/miss.out && h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); ls " + cdir +
        " | grep -q '_'\"$h\"'\\.pb\\.c' && ! grep -q FAKE " + cdir +
        "/*_\"$h\".pb.c && " + bin + " | grep -q '^2$'").is_err() {
        fail("old-style miss");
    }
    if process_exec(p, "h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); rm -f " + cdir + "/$h.pb.c").is_err() {
        fail("cleanup plant");
    }
    println("emit_cache_host_smoke: PASSED");
}
