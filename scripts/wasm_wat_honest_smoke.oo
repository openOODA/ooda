// # Wasm binary honest smoke
//
// Logline: emit-wasm of hello.oo is a WebAssembly binary starting with \0asm, not .wat text.
//
// Setup: oodac/oodac built; fixtures/hello.oo on disk.
//
// Beats:
//   1. emit-wasm hello.oo writes a non-empty module.
//   2. First bytes are wasm magic 00 61 73 6d.
//   3. The file is not a (module text document.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = match sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac") { Ok(s) => s, Err(_) => root + "/oodac/oodac" };
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm binary honest").is_err() { println("FAIL scenario"); process_exit(1); }
    let hello = root + "/fixtures/hello.oo";
    let wasm = tmpd + "/wat_honest.wasm";
    if expect_present(fs, hello).is_err() { println("FAIL no hello"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }
    if process_exec(p, oodac + " emit-wasm " + hello + " > " + wasm + " 2>" + tmpd + "/wat_honest.err").is_err() {
        println("FAIL emit-wasm");
        process_exit(1);
    }
    if expect_present(fs, wasm).is_err() { println("FAIL no wasm"); process_exit(1); }
    if check(p, "test -s " + wasm, 5).is_err() { println("FAIL empty"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N4 " + wasm + " | grep -q '00 61 73 6d'").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() {
        println("FAIL still wat");
        process_exit(1);
    }
    println("wasm_wat_honest_smoke: PASSED");
}
