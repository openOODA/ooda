// # Wasm WAT Honest Smoke
//
// Logline: emit-wasm of hello.oo (or chs_hello.oo) is WebAssembly text with (module, not a wasm binary.
//
// Setup: oodac/oodac built; fixtures/hello.oo and fixtures/chs_hello.oo on disk.
//
// Beats:
//   1. emit-wasm hello.oo (fallback chs_hello.oo) writes a non-empty .wat.
//   2. Grep the wat for (module.
//   3. Fail if the file starts with wasm magic \0asm.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "wasm wat honest");

    let hello = root + "/fixtures/hello.oo";
    let chs   = root + "/fixtures/chs_hello.oo";
    let wat   = tmpd + "/wat_honest.wat";

    let _ = expect_present(fs, hello);
    let _ = expect_present(fs, chs);
    let _ = expect_quiet(p, "test -x " + oodac);

    let _ = process_exec(p, oodac + " emit-wasm " + hello + " > " + wat + " 2>" + tmpd + "/wat_honest.err || " + oodac + " emit-wasm " + chs + " > " + wat + " 2>>" + tmpd + "/wat_honest.err");
    let _ = expect_present(fs, wat);
    let _ = check(p, "test -s " + wat, 5);

    let _ = expect_quiet(p, "grep -q '(module' " + wat);
    let _ = expect_quiet(p, "! od -An -tx1 -N4 " + wat + " | grep -q '00 61 73 6d'");

    println("wasm_wat_honest_smoke: PASSED");
}
