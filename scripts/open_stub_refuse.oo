// # OPEN stub refuse (source honesty)
//
// Logline: Fail closed when product sources still ship known no-op stubs that fake PASS.
//
// Setup: cwd is ooda/. Grep only — never exec oodac. Caps from the runner.
//
// Beats:
//   1. c_emit_sys.oo must not lower import_c to (0 /* import_c */).
//   2. chs_rt_vision.c must not puts("PASSED") from emit_ptx / emit_spirv.
//   3. chs_rt_arena.c oo_soa_layout must not return 1 for every nonempty name.
//   4. fixtures/open82_typestate.oo must not define a local fn type_state_check.
//   5. fixtures/open74_enclave.oo must refuse name-only measurement (FAIL name_only
//      or real sha256 inequality vs the identity string).

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    if scenario(p, fs, "open stub refuse source honesty").is_err() {
        println("FAIL scenario");
        process_exit(1);
    }

    let sys = root + "/oodac/c_emit_sys.oo";
    let vision = root + "/runtime/chs_rt_vision.c";
    let arena = root + "/runtime/chs_rt_arena.c";
    let fx82 = root + "/fixtures/open82_typestate.oo";
    let fx74 = root + "/fixtures/open74_enclave.oo";

    if expect_present(fs, sys).is_err() { println("FAIL missing c_emit_sys.oo"); process_exit(1); }
    if expect_present(fs, vision).is_err() { println("FAIL missing chs_rt_vision.c"); process_exit(1); }
    if expect_present(fs, arena).is_err() { println("FAIL missing chs_rt_arena.c"); process_exit(1); }
    if expect_present(fs, fx82).is_err() { println("FAIL missing open82_typestate.oo"); process_exit(1); }
    if expect_present(fs, fx74).is_err() { println("FAIL missing open74_enclave.oo"); process_exit(1); }

    // OPEN-70: import_c must not be a comment-only zero stub in the C emitter.
    if expect_clean(p, "! grep -qF '(0 /* import_c */)' " + sys).is_err() {
        println("FAIL c_emit_sys still has (0 /* import_c */) stub");
        process_exit(1);
    }

    // OPEN-91: host shader helpers must not print PASSED themselves.
    if expect_clean(p, "! grep -qF 'puts(\"PASSED\")' " + vision).is_err() {
        println("FAIL chs_rt_vision puts(PASSED) stub");
        process_exit(1);
    }

    // OPEN-85: oo_soa_layout must not accept any nonempty name with bare return 1.
    if expect_clean(p, "! grep -A6 'long long oo_soa_layout' " + arena + " | grep -qE 'return 1'").is_err() {
        println("FAIL oo_soa_layout still return 1 for nonempty name");
        process_exit(1);
    }

    // OPEN-82: fixture must call product type_state_check, not redefine it.
    if expect_clean(p, "! grep -qE '^[[:space:]]*fn type_state_check' " + fx82).is_err() {
        println("FAIL open82 defines local fn type_state_check");
        process_exit(1);
    }

    // OPEN-74: refuse name-only enclave measurement (hash identity or explicit FAIL).
    // Accept FAIL name_only / FAIL name-only, or sha256 compare that rejects name-only.
    if expect_clean(p, "grep -qE 'FAIL name[_-]only' " + fx74 + " || (grep -qiE 'sha256|crypto_sha256' " + fx74 + " && grep -qE '!=|== name_only' " + fx74 + ")").is_err() {
        println("FAIL open74 missing FAIL name_only or sha256 inequality");
        process_exit(1);
    }

    println("open_stub_refuse: PASSED");
}
