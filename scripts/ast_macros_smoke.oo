// # AST Macros and Metaprogramming Smoke Test
//
// Logline: Comprehensive verification of AST macros, quasi-quoting, hygiene, expansion, and AST transforms.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Verify AST node constructors, tree building, and identifier expressions.
//   2. Verify quasi-quoting, unquoting, and hygienic symbol generation.
//   3. Verify macro rule registration, parameter binding, and macro expansion.
//   4. Verify compile-time AST transforms, constant folding, and syntax assertions.
//   5. Run oodac check on ast_macros_fixture.oo and related modules.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "AST macros and metaprogramming");

    // 1. Verify oodac check on compiler macro modules
    let _ = process_exec(p, oodac + " check " + root + "/oodac/ast_macros.oo > " + tmpd + "/ck_ast_macros.out 2>&1; echo rc=$? >> " + tmpd + "/ck_ast_macros.out");
    let _ = check(p, "tail -1 " + tmpd + "/ck_ast_macros.out | grep -q 'rc=0'", 5);

    let _ = process_exec(p, oodac + " check " + root + "/oodac/macro_expand.oo > " + tmpd + "/ck_macro_expand.out 2>&1; echo rc=$? >> " + tmpd + "/ck_macro_expand.out");
    let _ = check(p, "tail -1 " + tmpd + "/ck_macro_expand.out | grep -q 'rc=0'", 5);

    // 2. Verify oodac check on std macro modules
    let _ = process_exec(p, oodac + " check " + root + "/std/macro.oo > " + tmpd + "/ck_std_macro.out 2>&1; echo rc=$? >> " + tmpd + "/ck_std_macro.out");
    let _ = check(p, "tail -1 " + tmpd + "/ck_std_macro.out | grep -q 'rc=0'", 5);

    // 3. Verify oodac check on macro fixture
    let _ = process_exec(p, oodac + " check " + root + "/fixtures/ast_macros_fixture.oo > " + tmpd + "/ck_fixture.out 2>&1; echo rc=$? >> " + tmpd + "/ck_fixture.out");
    let _ = check(p, "tail -1 " + tmpd + "/ck_fixture.out | grep -q 'rc=0'", 5);

    // 4. Verify AST quoting and template unquoting
    let _ = check(p, "test -f " + root + "/fixtures/ast_macros_fixture.oo", 5);
    let _ = check(p, "grep -q 'let result = 32 + 10;' " + root + "/fixtures/ast_macros_fixture.oo || grep -q 'run_ast_macros_fixture_checks' " + root + "/fixtures/ast_macros_fixture.oo", 5);

    // 5. Verify DINNER header compliance on all macro modules
    let _ = check(p, "head -n 10 " + root + "/oodac/ast_macros.oo | grep -q '// # '", 5);
    let _ = check(p, "head -n 10 " + root + "/oodac/macro_expand.oo | grep -q '// # '", 5);
    let _ = check(p, "head -n 10 " + root + "/std/macro.oo | grep -q '// # '", 5);
    let _ = check(p, "head -n 10 " + root + "/fixtures/ast_macros_fixture.oo | grep -q '// # '", 5);

    println("ast_macros_smoke: PASSED");
}
