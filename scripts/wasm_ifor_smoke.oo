// # emit-wasm const if false || true println lock
//
// Logline: Product emit-wasm of wasm_if_or.oo prints or-then and not or-else.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_if_or.oo and require \0asm magic.
//   2. The file is not WAT.
//   3. wasmtime prints or-then and not or-else.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm if or println").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_if_or.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_if_or.wasm";
    let out = tmpd + "/wasm_if_or.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_if_or.oo > " + wasm + " 2>" + tmpd + "/wasm_if_or.err").is_err() {
        fail("emit-wasm");
    }
    if expect_present(fs, wasm).is_err() { fail("no wasm"); }
    if check(p, "test -s " + wasm, 5).is_err() { fail("empty"); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() { fail("magic"); }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() { fail("still wat"); }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "test -s " + out).is_err() { fail("dummy empty"); }
        if expect_quiet(p, "grep -q or-then " + out).is_err() { fail("no or-then"); }
        if expect_quiet(p, "grep -q or-else " + out).is_ok() { fail("or-else printed"); }
    } else {
        if expect_quiet(p, "grep -a -q fd_write " + wasm).is_err() { fail("no fd_write"); }
        if expect_quiet(p, "grep -a -q or-then " + wasm).is_err() { fail("no or-then bytes"); }
    }
    println("wasm_ifor_smoke: PASSED");
}
