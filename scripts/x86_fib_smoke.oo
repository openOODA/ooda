// # emit-x86 recursive fibonacci lowering lock
//
// Logline: emit-x86 of fixtures/x86_fib.oo assembles and prints 13 via as and ld.
//
// Setup: cwd is ooda/. GNU as and ld are on PATH. Host is x86_64. Product oodac/oodac.
//
// Beats:
//   1. emit-x86 fixtures/x86_fib.oo writes fib, frame enter/leave, spills -8(%rbp) and -16(%rbp).
//   2. as --64 and ld produce a binary whose stdout is 13.
//   3. Repeat emit+as+ld+run; verify correct output.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_fib_" + tag + ".s";
    let serr = tmpd + "/x86_fib_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86 " + tag);
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() {
        fail("ERR in .s " + tag);
    }
    if expect_clean(p, "grep -q 'fib:' " + sfile).is_err() {
        fail("missing fib label " + tag);
    }
    if expect_clean(p, "grep -q 'movq %rdi, -8(%rbp)' " + sfile).is_err() {
        fail("missing rdi spill " + tag);
    }
    if expect_clean(p, "grep -q 'movq %rax, -16(%rbp)' " + sfile).is_err() {
        fail("missing rax spill " + tag);
    }
    if expect_clean(p, "grep -q 'addq -16(%rbp), %rax' " + sfile).is_err() {
        fail("missing add result " + tag);
    }
    let obj = tmpd + "/x86_fib_" + tag + ".o";
    let bin = tmpd + "/x86_fib_" + tag + ".bin";
    let out = tmpd + "/x86_fib_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() {
        fail("as " + tag);
    }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() {
        fail("ld " + tag);
    }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() {
        fail("run " + tag);
    }
    if expect_clean(p, "grep -qx '13' " + out).is_err() {
        fail("stdout not 13 " + tag);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() {
        fail("mkdir");
    }
    if scenario(p, fs, "x86 recursive fibonacci lowering").is_err() {
        fail("scenario");
    }
    let oodac = pick_oodac(p, root);
    let src = root + "/fixtures/x86_fib.oo";
    emit_as_ld(p, fs, oodac, src, tmpd, "r1");
    println("x86_fib_smoke: PASSED");
}
