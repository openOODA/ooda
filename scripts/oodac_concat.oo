// # OODAC Concat
//
// Logline: residual multi-file flatten for EMIT_CONCAT=1 — recursive DFS expands imports; missing → ERR_IMPORT_MISSING; cycle → ERR_IMPORT_CYCLE (fail-closed).
//
// Setup: Process capability and test fixtures available.
//
// Beats: main resolve | DFS expand | cycle/missing fail-closed.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = scenario(p, fs, "oodac_concat residual multi-file flatten");

    when "load_import.oo preferred for check|tokens|ast" {
    and  "expand DFS prints body + recurses imports" {
    and  "cycle detection fail-closed (ERR_IMPORT_CYCLE)" {
    and  "missing import fail-closed (ERR_IMPORT_MISSING)" {
    then "oodac_concat flatten path OK" { } } } }

    expect_present(fs, root + "/oodac/load_import.oo");
    let main = root + "/fixtures/int_main.oo";
    let _ = process_exec(p, oodac + " expand " + main + " > " + tmpd(p) + "/concat.out 2> " + tmpd(p) + "/concat.err");
    expect_substring(fs, tmpd(p) + "/concat.err", "ERR_IMPORT_MISSING");
    expect_clean(p, "! " + oodac + " expand /nonexistent/file.oo 2>&1 | grep -qv 'ERR_IMPORT_MISSING'");
    println("oodac_concat: PASSED (residual multi-file flatten gated)");
}

fn tmpd(p: &ProcessCap) -> String {
    return sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or(".");
}
