// # emit-aarch64 if-cond boundary lock
//
// Logline: Side emit-aarch64 folds lead0 INT, overflowing INT, and IDENT LT and clang assembles ARM aarch64.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. 00==0 writes EQ, 10<=010 writes LE, overflow writes GE, x<2 writes YES.
//   3. clang -target aarch64-linux-gnu -c is ARM aarch64.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn emit_has(p: &ProcessCap, fs: &FsReadCap, side: String, src: String, sfile: String, serr: String, needle: String, tag: String) {
    if check(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail(tag + " emit"); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail(tag + " ERR"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(tag + " no _start"); }
    if expect_substring(fs, sfile, needle).is_err() { fail(tag + " no " + needle); }
    if check(p, "clang -target aarch64-linux-gnu -c " + sfile + " -o " + sfile + ".o", 15).is_err() { fail(tag + " assemble"); }
    if expect_clean(p, "file " + sfile + ".o | grep -q 'ARM aarch64'").is_err() { fail(tag + " not ARM"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    let aarch64_side_src = fx + "aarch64_if_eq00.oo";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 if-cond boundary").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x /usr/bin/clang").is_err() { fail("no clang"); }
    ensure_aarch64_side(p, root, prod, side);
    emit_has(p, fs, side, fx + "aarch64_if_eq00.oo", tmpd + "/a64_eq00.s", tmpd + "/a64_eq00.err", "EQ", "eq00");
    emit_has(p, fs, side, fx + "aarch64_if_lte010.oo", tmpd + "/a64_lte010.s", tmpd + "/a64_lte010.err", "LE", "lte010");
    emit_has(p, fs, side, fx + "aarch64_if_ovf.oo", tmpd + "/a64_ovf.s", tmpd + "/a64_ovf.err", "GE", "ovf");
    if expect_clean(p, "! grep -qF 'BAD' " + tmpd + "/a64_ovf.s").is_err() { fail("ovf emitted BAD"); }
    emit_has(p, fs, side, fx + "aarch64_iflt_ident.oo", tmpd + "/a64_iflti.s", tmpd + "/a64_iflti.err", "YES", "iflt_ident");
    println("aarch64_if_bound_smoke: PASSED");
}
