// # emit-aarch64 if-cond boundary leftover lock
//
// Logline: Side emit-aarch64 fail-closes lead0 INT compare, overflowing INT compare, and IDENT LT with no _start.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. Each boundary fixture prints ERR aarch64_emit.
//   3. Refuse a successful _start that omitted or mis-folded the cond.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn refuse(p: &ProcessCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if process_exec(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail(tag + " wrote _start");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() { fail(tag + " no ERR"); }
    if expect_clean(p, "grep -q aarch64_emit " + sfile + " " + serr).is_err() { fail(tag + " no aarch64_emit"); }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() { fail(tag + " silent omit"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 if-cond boundary leftover").is_err() { fail("scenario"); }
    if expect_present(fs, fx + "aarch64_if_eq00.oo").is_err() { fail("no eq00"); }
    if expect_present(fs, fx + "aarch64_if_lte010.oo").is_err() { fail("no lte010"); }
    if expect_present(fs, fx + "aarch64_if_ovf.oo").is_err() { fail("no ovf"); }
    if expect_present(fs, fx + "aarch64_iflt_ident.oo").is_err() { fail("no iflt_ident"); }
    ensure_aarch64_side(p, root, prod, side);
    refuse(p, side, fx + "aarch64_if_eq00.oo", tmpd + "/a64_eq00.s", tmpd + "/a64_eq00.err", "eq00");
    refuse(p, side, fx + "aarch64_if_lte010.oo", tmpd + "/a64_lte010.s", tmpd + "/a64_lte010.err", "lte010");
    refuse(p, side, fx + "aarch64_if_ovf.oo", tmpd + "/a64_ovf.s", tmpd + "/a64_ovf.err", "ovf");
    refuse(p, side, fx + "aarch64_iflt_ident.oo", tmpd + "/a64_iflti.s", tmpd + "/a64_iflti.err", "iflt_ident");
    println("aarch64_if_bound_smoke: PASSED");
}
