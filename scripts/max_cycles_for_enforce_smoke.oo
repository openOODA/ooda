// # Max Cycles For Enforce Smoke
//
// Logline: M54 path B — range-for gets body fuel (not the for header) and ERR\tmax_cycles on tight N; doc carries path B + OS isolation residual.
//
// Setup: Process capability and test fixtures available.
// Beats: pass for-fixture body fuel | fail for-fixture ERR | doc path B + OS residual | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const PASS: String = "ooda/fixtures/max_cycles_for_pass.oo";
const FAIL: String = "ooda/fixtures/max_cycles_for_fail.oo";
const DOC: String = "ooda/bootstrap/MAX_CYCLES.oot";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/mc_for";
    let _ = sh_mkdir_p(fw, tmp);
    let rt = root + "/ooda/runtime";
    let _ = scenario(p, fs, "max cycles path B range-for fuel");

    // when: pass for-fixture emits body fuel (NOT in the for header)
    let c_p = tmp + "/mcf_pass.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + PASS + " > " + c_p + " 2>/dev/null");
    expect_substring(fs, c_p, "__oo_mc");
    expect_clean(p, "! grep -E 'for[[:space:]]*\\([^)]*__oo_mc' " + c_p);

    // and: run under N
    check(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + c_p + " -o " + c_p + ".bin -lm", within: 30);
    expect_clean(p, "timeout 3 " + c_p + ".bin 2>&1 | grep -qE '3'");

    // then: fail for-fixture non-zero + ERR max_cycles
    let c_f = tmp + "/mcf_fail.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + FAIL + " > " + c_f + " 2>/dev/null");
    check(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + c_f + " -o " + c_f + ".bin -lm", within: 30);
    expect_clean(p, "! timeout 3 " + c_f + ".bin 2>&1 | grep -qiE 'max_cycles'");

    // and: doc carries path B + OS residual
    expect_present(fs, DOC);
    expect_clean(p, "grep -qE 'path B|range-for' " + root + "/" + DOC);
    expect_clean(p, "grep -qE 'cgroup|not OS' " + root + "/" + DOC);

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_for_enforce_smoke");
    println("max_cycles_for_enforce_smoke: PASSED");
}
