// # Residual Packs Index Smoke
//
// Logline: every script listed in bootstrap/RESIDUAL_PACKS.oot exists and exits 0; the index carries ≥20 RESIDUAL_ALPHA markers.
// Beats: count markers ≥ 20 | every listed script bash-exits 0 | path-a floor carries.

import "std/scenario.oo";
import "std/sh.oo";

const INDEX: String = "ooda/bootstrap/RESIDUAL_PACKS.oot";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "residual packs index honesty");

    // when: pack index doc exists and names ≥20 RESIDUAL_ALPHA domains
    expect_present(fs, root + "/" + INDEX);
    expect_clean(p, "test \"$(grep -c '_RESIDUAL_ALPHA' " + INDEX + ")\" -ge 20");

    // then: every listed *_residual_smoke.sh exists and exits 0
    let _ = check(p, "for s in $(grep -oE '[a-z0-9_]+_residual_smoke\\.sh' " + INDEX + " | sort -u); do test -f " + root + "/ooda/scripts/$s && bash " + root + "/ooda/scripts/$s >/dev/null; done", within: 600);

    // and: path-A floor carries
    expect_clean(p, "test -f " + root + "/ooda/scripts/residual_path_a_floor_smoke.sh");
    println("residual_packs_index_smoke: PASSED");
}
