// ===================================================================
// Residual Packs Index Smoke Test
// ===================================================================
// Prove authorized residual packs exist and their listed smokes pass.
// Does not run unrelated *_residual_smoke.sh (e.g. F26 harness).

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    
    // Check RESIDUAL_PACKS.oot exists
    let check_file = cmd_exec(p, "test -f " + root + "/bootstrap/RESIDUAL_PACKS.oot");
    tr = test_assert(tr, "RESIDUAL_PACKS.oot exists", check_file.is_ok());
    
    // Count RESIDUAL_ALPHA markers
    let count_res = cmd_exec(p, "grep -c '_RESIDUAL_ALPHA' " + root + "/bootstrap/RESIDUAL_PACKS.oot || echo 0");
    let n = if count_res.is_ok() { parse_int(count_res.unwrap()) } else { 0 };
    tr = test_assert(tr, "at least 20 RESIDUAL_ALPHA markers", n >= 20);
    
    // Run each listed residual smoke script
    let list_res = cmd_exec(p, "grep -oE '`[a-z0-9_]+_residual_smoke\\.sh`' " + root + "/bootstrap/RESIDUAL_PACKS.oot | tr -d '`' | sort -u");
    if list_res.is_ok() {
        let scripts_str = list_res.unwrap();
        let scripts = split_lines(scripts_str);
        let mut i = 0;
        while i < list_len(scripts) {
            let script = trim(list_get(scripts, i));
            if str_len(script) > 0 {
                let s = "scripts/" + script;
                let check_exists = cmd_exec(p, "test -f " + root + "/" + s);
                if !check_exists.is_ok() {
                    println("FAIL missing " + s);
                    tr = test_assert(tr, "script " + s + " exists", false);
                } else {
                    let run_res = cmd_exec(p, "bash " + root + "/" + s + " >/dev/null 2>&1");
                    if !run_res.is_ok() {
                        println("FAIL " + s);
                        tr = test_assert(tr, s + " passes", false);
                    }
                }
            }
            i = i + 1;
        }
    }
    
    // Check residual_path_a_floor_smoke.sh
    let floor_check = cmd_exec(p, "test -f " + root + "/scripts/residual_path_a_floor_smoke.sh");
    if floor_check.is_ok() {
        let floor_res = cmd_exec(p, "bash " + root + "/scripts/residual_path_a_floor_smoke.sh >/dev/null 2>&1");
        tr = test_assert(tr, "residual_path_a_floor_smoke.sh passes", floor_res.is_ok());
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("residual_packs_index_smoke: PASSED (" + n.to_string() + " packs indexed)");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}

fn split_lines(s: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let len = str_len(s);
    let mut i = 0;
    let mut current = "";
    while i < len {
        let c = str_char_at(s, i);
        if c == "\n" {
            if str_len(current) > 0 {
                lines = list_push(lines, current);
                current = "";
            }
        } else {
            current = current + c;
        }
        i = i + 1;
    }
    if str_len(current) > 0 {
        lines = list_push(lines, current);
    }
    return lines;
}

fn parse_int(s: String) -> Int {
    let mut num = 0;
    let mut i = 0;
    let len = str_len(s);
    while i < len {
        let c = str_char_at(s, i);
        if c >= "0" && c <= "9" {
            num = num * 10 + (c.to_int() - "0".to_int());
        }
        i = i + 1;
    }
    return num;
}
