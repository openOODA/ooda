// # List-element mismatch prints path and caret
//
// Logline: Cache-cold check of list_push(ys, String) shows ERR type, path, the call, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_list_elem.oo prints ERR type, list element type mismatch, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo and tc_println_arity.oo still have --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/list_elem_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_list_elem.oo > " + tmpd +
        "/le.out; echo $? > " + tmpd + "/le.ec; true").is_err() {
        fail("check list elem");
    }
    if process_exec(p, "grep -q 'list element type mismatch' " + tmpd +
        "/le.out && grep -q 'tc_list_elem.oo' " + tmpd +
        "/le.out && grep -Fq -- '-->' " + tmpd + "/le.out && grep -q '\\^' " +
        tmpd + "/le.out && ! grep -qE '^OK' " + tmpd +
        "/le.out && test \"$(cat " + tmpd + "/le.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_println_arity.oo > " + tmpd +
        "/pr.out; echo $? > " + tmpd + "/pr.ec; true").is_err() {
        fail("check println");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/pr.out && grep -q '\\^' " +
        tmpd + "/pr.out && test \"$(cat " + tmpd + "/pr.ec)\" -ne 0").is_err() {
        fail("println caret");
    }
    println("list_elem_caret_smoke: PASSED");
}
