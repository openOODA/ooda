// # Stock store add, search, and registry list smoke
//
// Logline: Prove bare add, search, and registry list against the stock store.
//
// Setup: cwd is ooda/. ./bin/ooda exists. Network used for search and stock add.
//
// Beats:
//   1. registry lists the stock origin.
//   2. remove stock refuses. http add refuses.
//   3. search hello names hello. bare add hello installs.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn run(p: &ProcessCap, cmd: String, outp: String) {
    let sh: String = "mkdir -p .ooda-cache/ooda-tmp; export OODA_FS_WRITEDIR=\"$(pwd)\"; " + cmd + " > " + outp + " 2>&1; echo rc=$? >> " + outp;
    if process_exec(p, sh).is_err() {
        fail("exec " + cmd);
    }
}

fn want(p: &ProcessCap, cmd: String, needle: String) {
    let outp: String = ".ooda-cache/ooda-tmp/pm_store.txt";
    run(p, cmd, outp);
    if process_exec(p, "grep -q '" + needle + "' " + outp).is_err() {
        fail("missing " + needle);
    }
}

pub fn main(p: &ProcessCap) {
    if process_exec(p, "test -x ./bin/ooda").is_err() {
        fail("no bin/ooda");
    }
    want(p, "./bin/ooda registry", "https://registry.openooda.org");
    want(p, "./bin/ooda registry remove https://registry.openooda.org", "ERR\tregistry\tstock");
    want(p, "./bin/ooda registry add http://example.com", "ERR\tregistry\tallow");
    want(p, "./bin/ooda search hello", "hello");
    if process_exec(p, "test -f .ooda_modules/lock").is_ok() {
        if process_exec(p, "cp .ooda_modules/lock .ooda-cache/ooda-tmp/lock.smoke").is_err() {
            fail("stash lock");
        }
        if process_exec(p, "rm -f .ooda_modules/lock").is_err() {
            fail("clear lock");
        }
    }
    want(p, "./bin/ooda add hello", "ooda add: installed hello cas=");
    if process_exec(p, "test -f .ooda-cache/ooda-tmp/lock.smoke").is_ok() {
        if process_exec(p, "mv .ooda-cache/ooda-tmp/lock.smoke .ooda_modules/lock").is_err() {
            fail("restore lock");
        }
    }
    println("pm_store_search_smoke: PASSED");
}
