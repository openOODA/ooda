// # Patch AST Honesty
//
// Logline: Product patch is cli/patch_drive.oo run_ooda_patch with --replace-fn; this file does not reimplement patch.
//
// Setup: ProcessCap and FsReadCap are injected. Cwd is the ooda product root.
//
// Beats:
//   1. Prove cli/patch_drive.oo is present.
//   2. Prove that file holds run_ooda_patch and --replace-fn.
//   3. Prove leftover scripts/ooda_patch.py is absent.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let drive = "cli/patch_drive.oo";
    let _ = scenario(p, fs, "patch ast honesty");

    if expect_present(fs, drive).is_err() {
        println("FAIL missing cli/patch_drive.oo");
        process_exit(1);
    }
    if expect_substring(fs, drive, "run_ooda_patch").is_err() {
        println("FAIL run_ooda_patch missing in cli/patch_drive.oo");
        process_exit(1);
    }
    if expect_substring(fs, drive, "--replace-fn").is_err() {
        println("FAIL --replace-fn missing in cli/patch_drive.oo");
        process_exit(1);
    }
    if expect_absent(fs, "scripts/ooda_patch.py").is_err() {
        println("FAIL leftover scripts/ooda_patch.py");
        process_exit(1);
    }
    println("PASSED");
}
