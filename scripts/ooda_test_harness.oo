// # Run .oo tests fail-closed
//
// Logline: Check then run each .oo target and exit 1 on the first failed exec.
//
// Setup: ProcessCap and FsReadCap. oodac/oodac must exist. cwd is the product root.
//
// Beats:
//   1. Resolve oodac and collect CLI targets or the default runnable fixtures.
//   2. Refuse .sh, .py, and missing paths.
//   3. oodac check then oodac run each .oo file.
//   4. Never mark a failed run as pass; process_exit(1) on failure.
//
// residual: verify-block scan and emit live in ooda_test_scan; this file only runs programs

import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";

fn die_res(msg: String) {
    println("ERR residual: " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if process_exec(p, "mkdir -p .ooda-cache/ooda-tmp").is_err() { die_res("mkdir"); }
    let mut oodac: String = "oodac/oodac";
    if process_exec(p, "test -x oodac/oodac").is_err() {
        oodac = "./oodac/oodac";
        if process_exec(p, "test -x ./oodac/oodac").is_err() { die_res("oodac missing"); }
    }
    if !fs_path_exists(fs, oodac) { die_res("oodac missing"); }

    let mut targets: List[String] = list_new();
    let cli: List[String] = process_args(p);
    let ncli: Int = list_len(cli);
    let mut arg_idx: Int = 0;
    while arg_idx < ncli {
        let a: String = list_get(cli, arg_idx);
        if !str_is_empty(a) && !str_ends_with(a, ".bin") {
            targets = list_push(targets, a);
        }
        arg_idx = arg_idx + 1;
    }

    if list_len(targets) == 0 {
        targets = list_push(targets, "fixtures/hello.oo");
    }

    println("=== OODA Pure Test Runner Harness ===");
    let num_targets: Int = list_len(targets);
    if num_targets == 0 { die_res("no test targets"); }
    println("Executing " + num_targets.to_string() + " test target(s)...");

    let mut passed: Int = 0;
    let mut i: Int = 0;
    while i < num_targets {
        let target: String = list_get(targets, i);
        if str_ends_with(target, ".sh") || str_ends_with(target, ".py") {
            die_res("refused " + target);
        }
        if !str_ends_with(target, ".oo") {
            die_res("not a .oo test: " + target);
        }
        if !fs_path_exists(fs, target) { die_res("missing " + target); }

        let check_res = process_exec(p, oodac + " check " + target + " >.ooda-cache/ooda-tmp/harness_check.out 2>.ooda-cache/ooda-tmp/harness_check.err");
        if check_res.is_err() {
            die_res("check failed: " + target);
        }
        let run_res = process_exec(p, oodac + " run " + target + " .ooda-cache/ooda-tmp/harness_bin >.ooda-cache/ooda-tmp/harness_run.out 2>.ooda-cache/ooda-tmp/harness_run.err");
        if run_res.is_err() {
            die_res("run failed: " + target);
        }
        println("PASS: " + target);
        passed = passed + 1;
        i = i + 1;
    }

    println("");
    println("Test Summary:");
    println("  Passed: " + passed.to_string());
    println("  Failed: 0");
    println("TEST SUITE PASSED");
}
