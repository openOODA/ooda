// # emit-x86 floating point math and SSE register lowering smoke test
//
// Logline: emit-x86 of fixtures/x86_float.oo assembles via GNU as and ld, executes float math (10.5 * 2.0 + 1.0), and verifies 22.00 output.
//
// Beats:
//   1. emit-x86 produces .s with _println_float and SSE instructions (movsd, mulsd, addsd).
//   2. as --64 and ld link standalone pure executable without libc.
//   3. Execution verifies float result 22.00.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld_float(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_float_" + tag + ".s";
    let serr = tmpd + "/x86_float_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86 " + tag);
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(".s missing _start " + tag); }
    if expect_substring(fs, sfile, "main:").is_err() { fail(".s missing main " + tag); }
    if expect_substring(fs, sfile, "_println_float").is_err() { fail(".s missing _println_float " + tag); }
    if expect_substring(fs, sfile, "mulsd").is_err() { fail(".s missing mulsd " + tag); }
    if expect_substring(fs, sfile, "addsd").is_err() { fail(".s missing addsd " + tag); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(".s looks like emit-c " + tag);
    }
    let obj = tmpd + "/x86_float_" + tag + ".o";
    let bin = tmpd + "/x86_float_" + tag + ".bin";
    let out = tmpd + "/x86_float_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    if expect_clean(p, "grep -qx '22.00' " + out).is_err() { fail("stdout not 22.00 " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 float math and SSE lowering").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_float.oo";
    if expect_present(fs, src).is_err() { fail("no x86_float.oo"); }
    emit_as_ld_float(p, fs, oodac, src, tmpd, "r1");
    emit_as_ld_float(p, fs, oodac, src, tmpd, "r2");
    println("x86_float_smoke: PASSED");
}
