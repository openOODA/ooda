// # Wasm Math Smoke
//
// Logline: Lowers arithmetic, bitwise shifts, and comparison operators to WebAssembly text and verifies execution via wasmtime.
//
// Setup: oodac emit-wasm and wasmtime runtime are available in the test environment.
//
// Beats:
//   1. Emit math expressions covering full arithmetic and bitwise logic into a .wat module.
//   2. Run the compiled WebAssembly module with wasmtime WASI runtime.
//   3. Assert that arithmetic and bitwise evaluation match expected results.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "wasm math smoke");

    let src = tmpd + "/math_wasm.oo";
    let wat = tmpd + "/math_wasm.wat";
    let rout = tmpd + "/math_run.out";

    let _ = process_exec(p, "printf 'pub fn main() {\\n    let a = 20;\\n    let b = 6;\\n    let sum = a + b;\\n    let diff = a - b;\\n    let prod = a * b;\\n    let div = a / b;\\n    let rem = a %% b;\\n    if sum == 26 && diff == 14 && prod == 120 && div == 3 && rem == 2 { println(\"ARITHMETIC_OK\"); } else { println(\"ARITHMETIC_FAIL\"); }\\n    let x = 12;\\n    let y = 10;\\n    let band = x & y;\\n    let bor = x | y;\\n    let bxor = x ^ y;\\n    let shl = 1 << 4;\\n    let shr = 32 >> 2;\\n    if band == 8 && bor == 14 && bxor == 6 && shl == 16 && shr == 8 { println(\"BITWISE_OK\"); } else { println(\"BITWISE_FAIL\"); }\\n}\\n' > " + src);
    let _ = process_exec(p, oodac + " emit-wasm " + src + " > " + wat);
    let _ = expect_present(fs, wat);

    let have_wt = expect_quiet(p, "command -v wasmtime").is_ok();
    if have_wt {
        let _ = process_exec(p, "wasmtime run " + wat + " > " + rout + " 2>" + tmpd + "/math_run.err");
    } else {
        println("ERR_NO_WASMTIME: wasmtime required");
    }

    let _ = expect_quiet(p, "grep -q 'ARITHMETIC_OK' " + rout);
    let _ = expect_quiet(p, "grep -q 'BITWISE_OK' " + rout);

    println("wasm_math_smoke: PASSED");
}
