// # Leftover Walk SEMI and RBRACE Fail-Closed Smoke
// Logline: Verify stray top-level SEMI, unmatched RBRACE, and unexpected top-level residual items fail closed with structured ERR c_emit diagnostics and exit code 1 without process abort (exit 134).
// Setup: cwd is ooda/. Product oodac exists.
// Beats: 1. stray SEMI fails closed with ERR c_emit residual: stray SEMI | 2. unmatched RBRACE fails closed with ERR c_emit residual: unmatched RBRACE | 3. stray top-level expression fails closed with ERR c_emit residual

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/walk_semi";

    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    // Beat 1: Stray SEMI at top level
    let semi_src = tmpd + "/stray_semi.oo";
    let w1 = process_exec(p, "printf 'pub fn f() {}\\n;\\n' > " + semi_src);
    if w1.is_err() { fail("write stray_semi.oo"); }

    let emit1 = process_exec(p, oodac + " emit-c " + semi_src + " > " + tmpd + "/semi.c 2> " + tmpd + "/semi.err; echo rc=$? > " + tmpd + "/semi.rc");
    if emit1.is_err() { fail("execute stray semi emit"); }

    let chk_semi = process_exec(p, "grep -qE 'ERR.c_emit.residual: stray SEMI' " + tmpd + "/semi.c " + tmpd + "/semi.err");
    if chk_semi.is_err() { fail("stray SEMI did not emit structured residual error"); }

    let chk_rc1 = process_exec(p, "grep -q 'rc=1' " + tmpd + "/semi.rc");
    if chk_rc1.is_err() { fail("stray SEMI exit code was not 1"); }

    // Beat 2: Unmatched RBRACE at top level
    let rbrace_src = tmpd + "/unmatched_rbrace.oo";
    let w2 = process_exec(p, "printf 'pub fn f() {}\\n}\\n' > " + rbrace_src);
    if w2.is_err() { fail("write unmatched_rbrace.oo"); }

    let emit2 = process_exec(p, oodac + " emit-c " + rbrace_src + " > " + tmpd + "/rbrace.c 2> " + tmpd + "/rbrace.err; echo rc=$? > " + tmpd + "/rbrace.rc");
    if emit2.is_err() { fail("execute unmatched rbrace emit"); }

    let chk_rbrace = process_exec(p, "grep -qE 'ERR.c_emit.residual: unmatched RBRACE' " + tmpd + "/rbrace.c " + tmpd + "/rbrace.err");
    if chk_rbrace.is_err() { fail("unmatched RBRACE did not emit structured residual error"); }

    let chk_rc2 = process_exec(p, "grep -q 'rc=1' " + tmpd + "/rbrace.rc");
    if chk_rc2.is_err() { fail("unmatched RBRACE exit code was not 1"); }

    // Beat 3: Stray top-level expression
    let expr_src = tmpd + "/stray_expr.oo";
    let w3 = process_exec(p, "printf 'pub fn f() {}\\n42\\n' > " + expr_src);
    if w3.is_err() { fail("write stray_expr.oo"); }

    let emit3 = process_exec(p, oodac + " emit-c " + expr_src + " > " + tmpd + "/expr.c 2> " + tmpd + "/expr.err; echo rc=$? > " + tmpd + "/expr.rc");
    if emit3.is_err() { fail("execute stray expr emit"); }

    let chk_expr = process_exec(p, "grep -qE 'ERR.c_emit.residual' " + tmpd + "/expr.c " + tmpd + "/expr.err");
    if chk_expr.is_err() { fail("stray expression did not emit structured residual error"); }

    let chk_rc3 = process_exec(p, "grep -q 'rc=1' " + tmpd + "/expr.rc");
    if chk_rc3.is_err() { fail("stray expression exit code was not 1"); }

    println("c_walk_semi_smoke: PASSED");
}
