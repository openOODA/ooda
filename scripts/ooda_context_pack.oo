// # OODA Context Pack
//
// Logline: token-minimal file/symbol orient pack — outline always; reflect if available; optional symbol slice (max 40 lines); never dumps whole >80 line files without --force-source.
//
// Setup: Process capability and test fixtures available.
//
// Beats: tokens estimate | outline | reflect | symbol slice.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ooda context_pack");

    // when "OODAC_BIN resolves" {
    // and  "outline path resolves signatures only" {
    // and  "reflect path resolves caps + sigs JSON" {
    // and  "full source skipped for >80 line files" {
    // then "ooda_context_pack PASSED" { } } } }

    expect_clean(p, "test -x " + oodac);
    let target = root + "/oodac/main.oo";
    expect_present(fs, target);
    check(p, "timeout 20 " + oodac + " outline " + target + " > " + tmpd + "/ocp_outline 2> " + tmpd + "/ocp_err", within: 25);
    expect_clean(p, "test -s " + tmpd + "/ocp_outline");
    let _ = process_exec(p, "timeout 20 " + oodac + " reflect " + target + " > " + tmpd + "/ocp_reflect 2> " + tmpd + "/ocp_reflect.err || true");
    let _ = expect_present(fs, tmpd + "/ocp_reflect");
    println("ooda_context_pack: PASSED");
}
