// # DoD Layout Residual Smoke
//
// Logline: bootstrap/DOD_LAYOUT.oot carries the residual marker, fail-closed wording, and no dual-claim.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Verify bootstrap document and residual marker presence.
//   2. Assert no dual-claim and verify fail-closed residual wording.
//   3. Verify fixture marker and CI script pipeline wiring.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "DOD layout residual honesty");

    // when doc + marker present
    expect_present(fs, "ooda/bootstrap/DOD_LAYOUT.oot");
    expect_substring(fs, "ooda/bootstrap/DOD_LAYOUT.oot", "DOD_LAYOUT_RESIDUAL_ALPHA");

    // and doc does not claim "shipped/enforced/live" without residual qualifier
    expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + "ooda/bootstrap/DOD_LAYOUT.oot" + " | grep -viE 'not |residual|do not|never|no '");

    // then fail-closed residual wording
    expect_clean(p, "grep -qiE 'fail-closed residual' " + "ooda/bootstrap/DOD_LAYOUT.oot");

    // and fixture carries the marker line
    expect_present(fs, "ooda/fixtures/dod_marker.oo");
    expect_substring(fs, "ooda/fixtures/dod_marker.oo", "DOD: residual");

    // and dual-claim scan: bootstrap/ has no shipped-as-enforced w/o residual
    expect_clean(p, "! grep -rn --include='*.oot' -E 'shipped as enforced|fully sealed shipped' ooda/bootstrap 2>/dev/null | grep -v DOD_LAYOUT | grep -vi residual | head -5");

    // then ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "dod_layout_residual_smoke");
    println("dod_layout_residual_smoke: PASSED");
}