// # User oodac build compiles modules to cached .o files
//
// Logline: Isolated (or product) oodac build of c_line_main writes stamp_sha.o, prints cc_cache, and the binary prints 2.
//
// Setup: cwd is ooda/. Isolated .ooda-cache/ooda-tmp/c_lane/oodac.c1 if executable, else ./oodac/oodac.
//
// Beats:
//   1. Cold build prints emit_cache and cc_cache; the binary prints 2.
//   2. Warm rebuild cc_cache skip is at least 1 of 2.
//   3. .o files exist under .ooda-cache/oodac_emit for the stamped keys.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut oodac = ".ooda-cache/ooda-tmp/c_lane/oodac.c1";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = "./oodac/oodac";
    }
    let tmpd = ".ooda-cache/ooda-tmp/user_build_obj";
    let cdir = ".ooda-cache/oodac_emit";
    let bin = "fixtures/c_line_main.oo.bin";
    let lib = "fixtures/c_line_lib.oo";
    let mainf = "fixtures/c_line_main.oo";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "rm -f " + bin + " " + bin + ".tmp.c " + cdir +
        "/*.o").is_err() {
        fail("rm");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/cold.out").is_err() {
        fail("cold build");
    }
    if process_exec(p, "grep -q 'emit_cache skip=' " + tmpd +
        "/cold.out && grep -q 'cc_cache skip=' " + tmpd +
        "/cold.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("cold run");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/warm.out").is_err() {
        fail("warm build");
    }
    if process_exec(p, "grep -qE 'cc_cache skip=[1-9]' " + tmpd +
        "/warm.out && grep -q 'emit_cache skip=' " + tmpd +
        "/warm.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("warm skip");
    }
    if process_exec(p, "h=$(sha256sum -- " + lib +
        " | awk '{print $1}'); test \"$h\" != \"\" && ls " + cdir +
        " | grep -q '_'\"$h\"'\\.o'").is_err() {
        fail("lib .o not stamped");
    }
    if process_exec(p, "h=$(sha256sum -- " + mainf +
        " | awk '{print $1}'); test \"$h\" != \"\" && ls " + cdir +
        " | grep -q '_'\"$h\"'\\.o'").is_err() {
        fail("main .o not stamped");
    }
    println("user_build_obj_smoke: PASSED");
}
