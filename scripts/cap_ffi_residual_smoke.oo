// # Cap FFI Residual Stays Honest On The Doc
// Logline: bootstrap/CAP_FFI.oot carries CAP_FFI_RESIDUAL_ALPHA + fail-closed wording; no "FFI fully sealed shipped" claims.
// Setup: bootstrap/CAP_FFI.oot + fixtures/ffi_marker.oo + cap_ffi_residual_smoke.sh wire on disk.
// Beats: 1. doc marker + residual wording | 2. ban false "fully sealed/enforced shipped" | 3. ceiling + ci wire

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);
    let doc   = root + "/bootstrap/CAP_FFI.oot";
    let fix   = root + "/fixtures/ffi_marker.oo";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — doc rails
    fails = fails + tally(expect_quiet(p, "grep -q 'CAP_FFI_RESIDUAL_ALPHA' " + doc),                     "doc marker CAP_FFI_RESIDUAL_ALPHA");
    fails = fails + tally(expect_quiet(p, "grep -qE 'do not seal|do NOT seal|do \\*\\*NOT\\*\\* seal' " + doc + " && grep -qE 'C FFI|dlopen|raw pointer' " + doc), "doc denies process-local seal over C FFI");
    fails = fails + tally(expect_quiet(p, "grep -qE 'DESIGN tension|tension residual' " + doc),            "doc names DESIGN tension residual");
    fails = fails + tally(expect_quiet(p, "grep -q '&UnsafeFFICap' " + doc),                               "doc names &UnsafeFFICap surface");
    fails = fails + tally(expect_quiet(p, "grep -q 'CAP_FFI_PATH_A_ALPHA' " + doc),                        "doc marker CAP_FFI_PATH_A_ALPHA");
    fails = fails + tally(expect_quiet(p, "grep -qE 'oo_cap_grant_ffi|process-local.*ffi|Process-local FFI token' " + doc), "doc names process-local FFI token");
    fails = fails + tally(expect_quiet(p, "grep -qE 'Fail-closed residual|fail-closed residual' " + doc),  "doc states fail-closed residual");

    // and — forbid false shipped claims
    let banned = "grep -nE '(ships|implements|enforces|provides) (full )?(FFI (sandbox|seal)|sealed FFI)|FFI (sandbox|boundary) is (shipped|enforced|product.?green)|FFI fully (sealed|enforced) shipped' " + doc;
    fails    = fails + tally(check(p, "test -z \"$(" + banned + ")\"", 10),                              "doc does not claim FFI fully sealed/enforced shipped");
    fails    = fails + tally(check(p, "grep -qiE 'FFI fully (sealed|enforced) shipped|OS dlopen isolation (shipped|enforced)|full C TCB seal shipped' " + doc + " && echo banned; true | grep -q .", 10), "doc does not claim full sandbox shipped");
    fails    = fails + tally(check(p, "grep -rn --include='*.oot' --exclude='CAP_FFI.oot' --exclude-dir=dist -E 'FFI fully (sealed|enforced)|FFI sandbox (shipped|enforced|green)' " + root + "/bootstrap 2>/dev/null | grep -vE 'not |residual|do NOT' | grep -q . && echo bad || true", 10), "no false FFI sealed claims elsewhere");

    // and — fixture marker line
    fails = fails + tally(expect_quiet(p, "test -f " + fix + " && grep -qE '// FFI:[[:space:]]*residual' " + fix), "fixture ffi_marker.oo has // FFI: residual");

    // and — ceiling + product truth: STATIC_CAPS, CAPS_MATRIX, check_cap_util, runtime grant
    fails = fails + tally(expect_quiet(p, "grep -qE 'CAP_FFI|do not.*seal C FFI|C FFI' " + root + "/bootstrap/STATIC_CAPS.oot"), "STATIC_CAPS Cap/FFI residual");
    fails = fails + tally(expect_quiet(p, "grep -qE 'CAP_FFI|do not.*seal C|interop' " + root + "/bootstrap/CAPS_MATRIX.oot"),     "CAPS_MATRIX Cap/FFI residual");
    fails = fails + tally(expect_quiet(p, "grep -q 'UnsafeFFICap' " + root + "/oodac/check_cap_util.oo"),   "check path A UnsafeFFICap");
    fails = fails + tally(expect_quiet(p, "grep -rq 'oo_cap_grant_ffi' " + root + "/runtime/"),            "runtime oo_cap_grant_ffi");
    fails = fails + tally(check(p, "grep -rn --include='*.c' -E 'OS dlopen isolation shipped|full C TCB sealed' " + root + "/runtime/ 2>/dev/null | head -1 | grep -q . && echo bad || true", 10), "runtime does not overclaim");

    // then — ci_product wires
    fails = fails + tally(expect_quiet(p, "grep -q 'cap_ffi_residual_smoke.sh' " + root + "/scripts/ci_product.sh"), "ci wires cap_ffi_residual");
    fails = fails + tally(check(p, "grep -q 'cap_ffi_product_floor_smoke.sh' " + root + "/scripts/ci_product.sh || grep -q 'cap_ffi_product_floor_smoke' " + root + "/scripts/caps_product_floor_smoke.sh", 5), "ci wires cap_ffi_product_floor");

    if fails > 0 { println("cap_ffi_residual_smoke: FAILED"); process_exit(1); }
    println("cap_ffi_residual_smoke: PASSED");
}
