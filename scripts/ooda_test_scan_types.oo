// # OODA Test Scan Types & Block Scanner
//
// Logline: Data records, block parsing, and harness codegen for standalone test verification.
//
// Setup: Imports parse utilities to extract assertion records from verify blocks and generate main() wrapper.
//
// Beats:
//   1. Define AssertItem and VerifyScan records and constructors.
//   2. scan_verify_block parses verify block bodies into assertion records.
//   3. emit_harness generates standalone main() verify harness.

import "ooda_test_parse_util.oo";

pub type AssertItem = struct {
    kind: String,
    a: String,
    b: String,
    vname: String,
    aidx: Int
};

pub type VerifyScan = struct {
    fns: List[String],
    asserts: List[AssertItem],
    verify_count: Int
};

pub fn assert_item_new(kind: String, a: String, b: String, vname: String, aidx: Int) -> AssertItem {
    return AssertItem {
        kind: kind,
        a: a,
        b: b,
        vname: vname,
        aidx: aidx
    };
}

pub fn scan_verify_block(b: String, vname: String, mut asserts: List[AssertItem]) -> List[AssertItem] {
    let blen = chars_len(b);
    let mut pos = 0;
    let mut aidx = 0;
    while pos < blen {
        pos = skip_ws(b, pos, blen);
        if pos >= blen {
            break;
        }
        if pos + 2 <= blen && str_slice(b, pos, pos + 2) == "//" {
            while pos < blen && char_at(b, pos) != "\n" {
                pos = pos + 1;
            }
            continue;
        }
        let mut kind = "";
        if pos + 10 <= blen && str_slice(b, pos, pos + 10) == "assert_eq!" {
            let after = skip_ws(b, pos + 10, blen);
            if after < blen && char_at(b, after) == "(" {
                kind = "eq";
                pos = after;
            }
        }
        if kind == "" && pos + 10 <= blen && str_slice(b, pos, pos + 10) == "assert_ne!" {
            let after = skip_ws(b, pos + 10, blen);
            if after < blen && char_at(b, after) == "(" {
                kind = "ne";
                pos = after;
            }
        }
        if kind == "" && pos + 7 <= blen && str_slice(b, pos, pos + 7) == "assert!" {
            let after = skip_ws(b, pos + 7, blen);
            if after < blen && char_at(b, after) == "(" {
                kind = "assert";
                pos = after;
            }
        }
        if kind == "" && match_kw(b, pos, blen, "let") >= 0 {
            let mut end_semi = 0 - 1;
            let mut si = pos;
            while si < blen {
                if char_at(b, si) == ";" { end_semi = si; break; }
                si = si + 1;
            }
            if end_semi != 0 - 1 {
                let stmt = str_slice(b, pos, end_semi + 1);
                let it = assert_item_new("stmt", stmt, "", vname, aidx);
                asserts = list_push(asserts, it);
                pos = end_semi + 1;
                continue;
            } else {
                println("ERR\ttest_scan\tverify " + vname + ": unclosed let statement");
                process_exit(1);
            }
        }
        if kind == "" {
            let snippet_len = if pos + 48 <= blen { 48 } else { blen - pos };
            let snippet = str_slice(b, pos, pos + snippet_len);
            println("ERR\ttest_scan\tverify " + vname + ": only assert_eq!/assert_ne!/assert! (" + snippet + ")");
            process_exit(1);
        }
        let end_paren = bal(b, pos, "(", ")");
        if end_paren < 0 {
            println("ERR\ttest_scan\tverify " + vname + ": unbalanced assert paren");
            process_exit(1);
        }
        let inner = str_slice(b, pos + 1, end_paren - 1);
        aidx = aidx + 1;
        if kind == "assert" {
            let expr = trim_ws(inner);
            if chars_len(expr) == 0 {
                println("ERR\ttest_scan\tverify " + vname + ": empty assert!");
                process_exit(1);
            }
            let it = assert_item_new(kind, expr, "", vname, aidx);
            asserts = list_push(asserts, it);
        } else {
            let pair = parse_assert_eq_args(inner);
            if list_len(pair) < 2 {
                println("ERR\ttest_scan\tverify " + vname + ": assert_eq needs two args");
                process_exit(1);
            }
            let lhs = list_get(pair, 0);
            let rhs = list_get(pair, 1);
            let it = assert_item_new(kind, lhs, rhs, vname, aidx);
            asserts = list_push(asserts, it);
        }
        pos = end_paren;
        pos = skip_ws(b, pos, blen);
        if pos < blen && char_at(b, pos) == ";" {
            pos = pos + 1;
        }
    }
    return asserts;
}

pub fn emit_harness(fns: List[String], asserts: List[AssertItem]) -> String {
    let mut out = "// generated by ooda_test_harness — do not edit\n";
    let n_fns = list_len(fns);
    let mut i = 0;
    while i < n_fns {
        let f = list_get(fns, i);
        out = out + f;
        if !str_ends_with(f, "\n") {
            out = out + "\n";
        }
        i = i + 1;
    }
    out = out + "\npub fn main() {\n";
    let mut cur_vname = "";
    let mut real_assert_count = 0;
    let n_asserts = list_len(asserts);
    let mut j = 0;
    while j < n_asserts {
        let item = list_get(asserts, j);
        let kind = (item).kind;
        let a = (item).a;
        let b = (item).b;
        let vname = (item).vname;
        let aidx = (item).aidx;
        if vname != cur_vname {
            out = out + "    // verify " + vname + "\n";
            cur_vname = vname;
        }
        if kind == "stmt" {
            out = out + "    " + a + "\n";
        } else if kind == "eq" {
            real_assert_count = real_assert_count + 1;
            out = out + "    if " + a + " != " + b + " {\n";
            out = out + "        println(\"FAIL assert_eq " + vname + "#\" + aidx.to_string());\n";
            out = out + "        process_exit(1);\n";
            out = out + "    }\n";
        } else if kind == "ne" {
            real_assert_count = real_assert_count + 1;
            out = out + "    if " + a + " == " + b + " {\n";
            out = out + "        println(\"FAIL assert_ne " + vname + "#\" + aidx.to_string());\n";
            out = out + "        process_exit(1);\n";
            out = out + "    }\n";
        } else {
            real_assert_count = real_assert_count + 1;
            out = out + "    if !(" + a + ") {\n";
            out = out + "        println(\"FAIL assert " + vname + "#\" + aidx.to_string());\n";
            out = out + "        process_exit(1);\n";
            out = out + "    }\n";
        }
        j = j + 1;
    }
    out = out + "    println(\"OK verify (\" + real_assert_count.to_string() + \" asserts)\");\n";
    out = out + "}\n";
    return out;
}
