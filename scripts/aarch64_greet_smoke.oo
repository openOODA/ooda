// # emit-aarch64 hello.oo greet fold lock
//
// Logline: Side emit-aarch64 of fixtures/hello.oo writes Hello, openOODA Developer! and clang assembles ARM aarch64.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only. Fold must match greet+concat, not emit-c.
//
// Beats:
//   1. Rebuild the side ELF when aarch64_*.oo is newer.
//   2. emit-aarch64 writes _start, svc, and the folded greet line.
//   3. clang -target aarch64-linux-gnu -c is ARM aarch64.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let src = root + "/fixtures/hello.oo";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 greet fold").is_err() { fail("scenario"); }
    if expect_present(fs, src).is_err() { fail("no hello.oo"); }
    if expect_quiet(p, "test -x /usr/bin/clang").is_err() { fail("no clang"); }
    ensure_aarch64_side(p, root, prod, side);
    let sfile = tmpd + "/aarch64_greet.s";
    let serr = tmpd + "/aarch64_greet.err";
    if check(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail("emit"); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail("no _start"); }
    if expect_substring(fs, sfile, "svc #0").is_err() { fail("no svc"); }
    if expect_substring(fs, sfile, "Hello, openOODA Developer!").is_err() { fail("no greet line"); }
    if expect_clean(p, "! grep -qE '#include|chs_rt|syscall|%rax' " + sfile).is_err() { fail("wrong backend"); }
    if check(p, "clang -target aarch64-linux-gnu -c " + sfile + " -o " + tmpd + "/aarch64_greet.o", 15).is_err() { fail("assemble"); }
    if expect_clean(p, "file " + tmpd + "/aarch64_greet.o | grep -q 'ARM aarch64'").is_err() { fail("not ARM"); }
    println("aarch64_greet_smoke: PASSED");
}
