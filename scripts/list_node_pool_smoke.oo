// # Named emit+gcc+run lock for List[struct] node pool
//
// Logline: timeout 20 emit-c of list_node_pool must exit 0, emit OoL_Item, and run PASSED.
//
// Setup: cwd is ooda/. Isolated .ooda-cache/ooda-tmp/c_lane/oodac.c1 if executable, else ./oodac/oodac.
//
// Beats:
//   1. timeout 20 emit-c of fixtures/list_node_pool.oo exits 0 (hang lock).
//   2. Emitted C contains OoL_Item (or OoL_Node).
//   3. gcc + run prints list_node_pool: PASSED.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut oodac = ".ooda-cache/ooda-tmp/c_lane/oodac.c1";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = "./oodac/oodac";
    }
    let tmpd = ".ooda-cache/ooda-tmp/list_node_pool";
    let src = "fixtures/list_node_pool.oo";
    let c = tmpd + "/pool.c";
    let err = tmpd + "/pool.err";
    let bin = tmpd + "/pool.bin";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "timeout 20 env OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " +
        oodac + " emit-c " + src + " > " + c + " 2> " + err).is_err() {
        fail("emit-c timeout or fail");
    }
    if process_exec(p, "test -s " + c + " && ! grep -qE '^ERR' " + c + " " +
        err).is_err() {
        fail("emit-c ERR");
    }
    if process_exec(p, "grep -qE 'OoL_Item|OoL_Node' " + c).is_err() {
        fail("no OoL_Item or OoL_Node");
    }
    if process_exec(p, "gcc -O2 -Iruntime runtime/chs_rt.c " + c +
        " -lm -ldl -lpthread -o " + bin).is_err() {
        fail("gcc");
    }
    if process_exec(p, bin + " | grep -q 'list_node_pool: PASSED'").is_err() {
        fail("run");
    }
    if process_exec(p, oodac + " build " + src + " > " + tmpd +
        "/b.out").is_err() {
        fail("oodac build");
    }
    if process_exec(p, src + ".bin | grep -q 'list_node_pool: PASSED'").is_err() {
        fail("build run");
    }
    println("list_node_pool_smoke: PASSED");
}
