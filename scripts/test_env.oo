pub fn main(env_cap: &EnvCap) {
    // In openOODA, capabilities like EnvCap are injected into main() by the runtime.
    // There is no explicit `let env_cap = env_cap_new();` needed.
    let r = env_get(env_cap, "HOME");
    let s = match r {
        Ok(v) => v,
        Err(e) => e,
    };
    println(s);
}
