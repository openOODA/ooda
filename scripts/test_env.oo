// # HOME via EnvCap
//
// Logline: Read HOME from the injected EnvCap and print the value or error.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Call env_get on HOME.
//   2. Unwrap Ok or Err to a string.
//   3. Print that string.

pub fn main(env_cap: &EnvCap) {
    // In openOODA, capabilities like EnvCap are injected into main() by the runtime.
    // There is no explicit `let env_cap = env_cap_new();` needed.
    let r = env_get(env_cap, "HOME");
    let s = match r {
        Ok(v) => v,
        Err(e) => e
    };
    println(s);
}
