// # OODA Verify Pure
//
// Logline: pure verify harness generator (assert_eq! / assert_ne! / assert! / let statements; no Python) — strips requires/ensures, scans verify blocks, emits harness .oo with FAIL/OK labels; empty harness = check-only success.
//
// Setup: Process capability and test fixtures available.
//
// Beats: requires/ensures strip | verify block parse | assert_eq/ne/assert/let | harness .oo emit.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "ooda_verify_pure harness generator");

    when "requires/ensures stripped before scan" {
    and  "verify blocks scanned (assert_eq! / assert_ne! / assert! / let)" {
    and  "fail-closed on unsupported top-level (no Python eval)" {
    and  "harness .oo emits FAIL/OK labels + process_exit(1)" {
    and  "no verify blocks → check-only success (empty harness)" {
    then "ooda_verify_pure PASSED" { } } } } }

    expect_present(fs, root + "/scripts/ooda_verify_pure.sh");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "assert_eq!");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "assert_ne!");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "assert!");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "requires");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "ensures");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "check-only");
    expect_substring(fs, root + "/scripts/ooda_verify_pure.sh", "process_exit(1)");
    println("ooda_verify_pure: PASSED (assert harness generator catalogued)");
}
