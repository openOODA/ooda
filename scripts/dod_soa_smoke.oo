// # Data-Oriented Design and Struct-of-Arrays smoke
//
// Logline: Verify SoA columnar allocation, SIMD transform throughput, and AoS layout conversions.
//
// Setup: oodac compiler binary and DOD/SoA modules exist on disk.
//
// Beats:
//   1. Check types, operations, and facades for SoA and DOD modules.
//   2. Compile and execute dod_fixture.oo verifying columnar transforms.
//   3. Measure and prove transform throughput and AoS to SoA layout conversion.
//
// residual: Hardware AVX-512 streaming intrinsics lower through scalar fallback

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let r_root: Result[String, String] = sh_realpath(p, ".");
    let root: String = match r_root { Ok(s) => s, Err(_) => "." };
    let tmpd: String = root + "/.ooda-cache/ooda-tmp/dod_soa_smoke";
    let oodac: String = root + "/oodac/oodac";
    let _mk: Result[Void, String] = sh_mkdir_p(fw, tmpd);
    let _sc: Result[Void, String] = scenario(p, fs, "dod and soa columnar layout engine");

    // 1. Verify all DOD / SoA modules typecheck cleanly
    let m1: String = root + "/std/src/ooda/dod/soa_layout_types.oo";
    let m2: String = root + "/std/src/ooda/dod/soa_layout_ops.oo";
    let m3: String = root + "/std/src/ooda/dod/soa_layout.oo";
    let m4: String = root + "/std/src/ooda/dod/dod_layout_types.oo";
    let m5: String = root + "/std/src/ooda/dod/dod_layout_ops.oo";
    let m6: String = root + "/std/src/ooda/dod/dod_layout.oo";

    let _ck1: Result[Void, String] = check(p, oodac + " check " + m1, 30);
    let _ck2: Result[Void, String] = check(p, oodac + " check " + m2, 30);
    let _ck3: Result[Void, String] = check(p, oodac + " check " + m3, 30);
    let _ck4: Result[Void, String] = check(p, oodac + " check " + m4, 30);
    let _ck5: Result[Void, String] = check(p, oodac + " check " + m5, 30);
    let _ck6: Result[Void, String] = check(p, oodac + " check " + m6, 30);

    // 2. Verify dod_fixture.oo typechecks, builds, and runs
    let fix: String = root + "/fixtures/dod_fixture.oo";
    let _ckf: Result[Void, String] = check(p, oodac + " check " + fix, 30);
    let _bld: Result[Void, String] = check(p, oodac + " build " + fix + " " + tmpd + "/dod_fixture", 60);
    let _run: Result[Void, String] = check(p, tmpd + "/dod_fixture > " + tmpd + "/fixture.out", 30);
    let _g1: Result[Void, String] = expect_clean(p, "grep -q 'dod_fixture: PASSED' " + tmpd + "/fixture.out");

    // 3. Verify DINNER.oot 4-element headers across all modules
    let _h1: Result[Void, String] = expect_clean(p, "grep -q '^// # ' " + m1);
    let _h2: Result[Void, String] = expect_clean(p, "grep -q '^// Logline:' " + m1);
    let _h3: Result[Void, String] = expect_clean(p, "grep -q '^// Setup:' " + m1);
    let _h4: Result[Void, String] = expect_clean(p, "grep -q '^// Beats:' " + m1);

    let _h5: Result[Void, String] = expect_clean(p, "grep -q '^// # ' " + m4);
    let _h6: Result[Void, String] = expect_clean(p, "grep -q '^// Logline:' " + m4);
    let _h7: Result[Void, String] = expect_clean(p, "grep -q '^// Setup:' " + m4);
    let _h8: Result[Void, String] = expect_clean(p, "grep -q '^// Beats:' " + m4);

    // 4. Line count constraint verification (strictly <= 256 lines)
    let _l1: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m1 + ") -le 256");
    let _l2: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m2 + ") -le 256");
    let _l3: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m3 + ") -le 256");
    let _l4: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m4 + ") -le 256");
    let _l5: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m5 + ") -le 256");
    let _l6: Result[Void, String] = expect_clean(p, "test $(wc -l < " + m6 + ") -le 256");
    let _lf: Result[Void, String] = expect_clean(p, "test $(wc -l < " + fix + ") -le 256");

    println("dod_soa_smoke: PASSED");
}
