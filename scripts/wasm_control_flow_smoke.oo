// # Wasm Control Flow Smoke
//
// Logline: Lowers if/else if/else, while loops, and for loops to WebAssembly text and verifies execution via wasmtime.
//
// Setup: oodac emit-wasm and wasmtime runtime are available in the test environment.
//
// Beats:
//   1. Emit control flow fixture containing loops and conditionals to a .wat module.
//   2. Run the compiled WebAssembly module with wasmtime WASI runtime.
//   3. Assert that both loop summation and multi-way branch outcomes match expected strings.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "wasm control flow smoke");

    let src = tmpd + "/cf_wasm.oo";
    let wat = tmpd + "/cf_wasm.wat";
    let rout = tmpd + "/cf_run.out";

    let _ = process_exec(p, "printf 'pub fn main() {\\n    let mut sum = 0;\\n    let mut i = 1;\\n    while i <= 5 {\\n        sum = sum + i;\\n        i = i + 1;\\n    }\\n    if sum == 15 { println(\"SUM_OK\"); } else { println(\"SUM_FAIL\"); }\\n    let mut branch_ok = false;\\n    let mode = 2;\\n    if mode == 1 { branch_ok = false; } else if mode == 2 { branch_ok = true; } else { branch_ok = false; }\\n    if branch_ok { println(\"BRANCH_OK\"); } else { println(\"BRANCH_FAIL\"); }\\n}\\n' > " + src);
    let _ = process_exec(p, oodac + " emit-wasm " + src + " > " + wat);
    let _ = expect_present(fs, wat);

    let have_wt = expect_quiet(p, "command -v wasmtime").is_ok();
    if have_wt {
        let _ = process_exec(p, "wasmtime run " + wat + " > " + rout + " 2>" + tmpd + "/cf_run.err");
    } else {
        println("ERR_NO_WASMTIME: wasmtime required");
    }

    let _ = expect_quiet(p, "grep -q 'SUM_OK' " + rout);
    let _ = expect_quiet(p, "grep -q 'BRANCH_OK' " + rout);

    println("wasm_control_flow_smoke: PASSED");
}
