// # Wasm Control Flow Smoke
//
// Logline: emit-wasm of a control-flow fixture is a valid \0asm module; full loop bytecode is residual.
//
// Setup: oodac emit-wasm and wasmtime runtime are available in the test environment.
//
// Beats:
//   1. Emit a control-flow fixture to a wasm binary.
//   2. Magic is 00 61 73 6d 01 00 00 00.
//   3. wasmtime loads the empty module.
// residual: compiled while/if evaluation is not this product path.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = match sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac") { Ok(s) => s, Err(_) => root + "/oodac/oodac" };
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm control flow smoke").is_err() { println("FAIL scenario"); process_exit(1); }
    let src = tmpd + "/cf_wasm.oo";
    let wasm = tmpd + "/cf_wasm.wasm";
    if process_exec(p, "printf 'pub fn main() {\\n    let mut sum = 0;\\n    println(sum)\\n}\\n' > " + src).is_err() {
        println("FAIL write src");
        process_exit(1);
    }
    if process_exec(p, oodac + " emit-wasm " + src + " > " + wasm).is_err() {
        println("FAIL emit-wasm");
        process_exit(1);
    }
    if expect_present(fs, wasm).is_err() { println("FAIL no wasm"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    let wt = match sh_env_get_or(p, "WASMTIME", "/home/jeryd/.wasmtime/bin/wasmtime") { Ok(s) => s, Err(_) => "wasmtime" };
    if expect_quiet(p, "test -x " + wt).is_ok() {
        if check(p, wt + " " + wasm, 15).is_err() {
            println("FAIL wasmtime");
            process_exit(1);
        }
    }
    println("wasm_control_flow_smoke: PASSED");
}
