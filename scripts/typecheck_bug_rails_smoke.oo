// # Typecheck Bug Rails Stay Green Or Fail-Closed
// Logline: pass/* passes typecheck; fail/* refuses with Type error; xfail residuals documented.
// Setup: oodac/oodac built; fixtures/typecheck_bugs/{pass,fail} + fixtures/xfail on disk.
// Beats: 1. pass/*.oo exit 0 + ^OK | 2. fail/*.oo refuses with Type error | 3. xfail residuals noted

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let passd = root + "/fixtures/typecheck_bugs/pass";
    let faild = root + "/fixtures/typecheck_bugs/fail";
    let xfail = root + "/fixtures/xfail";
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — every pass/*.oo must OK and have no ^ERR
    let pass_list = sh_realpath(p, passd).unwrap_or(passd);
    let _w1       = process_exec(p, "ls -1 " + passd + "/*.oo > " + tmpd + "/pass.lst 2>/dev/null || true");
    fails         = fails + tally(check(p, "for f in $(cat " + tmpd + "/pass.lst); do " + oodac + " check \"$f\" 2>&1 | grep -qE '^OK' || exit 1; done", 120), "pass/* OK markers");
    fails         = fails + tally(check(p, "for f in $(cat " + tmpd + "/pass.lst); do " + oodac + " check \"$f\" 2>&1 | grep -qE '^ERR' && exit 1; done", 120), "pass/* no ERR markers");

    // and — every fail/*.oo must refuse with Type error
    let _w2 = process_exec(p, "ls -1 " + faild + "/*.oo > " + tmpd + "/fail.lst 2>/dev/null || true");
    fails   = fails + tally(check(p, "for f in $(cat " + tmpd + "/fail.lst); do " + oodac + " check \"$f\" 2>&1 | grep -qiE 'ERR|Type error' || exit 1; done", 120), "fail/* ERR markers");

    // then — xfail residuals are documented, not silent
    let dup = xfail + "/dup_import_names/shim.oo";
    let srp = xfail + "/same_param_name/repro.oo";
    fails = fails + tally(expect_quiet(p, "test -f " + dup + " || test -f " + srp + " || true"), "xfail directory present");
    println("NOTE xfail residuals document dup_import_names + same_param_name (Issue #10)");

    if fails > 0 { println("typecheck_bug_rails_smoke: FAILED"); process_exit(1); }
    println("typecheck_bug_rails_smoke: PASSED");
}
