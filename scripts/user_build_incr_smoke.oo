// # User oodac build skips emit on a warm cache
//
// Logline: Second build of c_line_main skips at least one module and still prints 2.
//
// Setup: cwd is ooda/. Product oodac/oodac. Native build only.
//
// Beats:
//   1. Cold build writes a binary that prints 2 and an emit_cache skip line.
//   2. Warm rebuild skip is at least 1 of 2.
//   3. strings still have gcc -O2.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/user_build_incr";
    let bin = "fixtures/c_line_main.oo.bin";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "rm -f " + bin + " " + bin + ".tmp.c").is_err() {
        fail("rm");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/cold.out").is_err() {
        fail("cold build");
    }
    if process_exec(p, "grep -q 'emit_cache skip=' " + tmpd +
        "/cold.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("cold run");
    }
    if process_exec(p, oodac + " build fixtures/c_line_main.oo > " + tmpd +
        "/warm.out").is_err() {
        fail("warm build");
    }
    if process_exec(p, "grep -qE 'emit_cache skip=[1-9]' " + tmpd +
        "/warm.out && " + bin + " | grep -q '^2$'").is_err() {
        fail("warm skip");
    }
    if process_exec(p, "strings " + oodac + " | grep -q 'gcc -O2'").is_err() {
        fail("no -O2");
    }
    println("user_build_incr_smoke: PASSED");
}
