// # PM Mint Smoke
//
// Logline: Smoke validation for Package Manager SemVer dependency resolution and Capability Mint Authority.
//
// Setup: Exercises oodac typechecking over all PM and Capability Mint modules and validates fixture integrity.
//
// Beats:
//   1. Verify oodac check on core PM modules (types, parser, resolver, unpacker, engine).
//   2. Verify oodac check on Capability Mint modules (types, authority, token, verify, shim).
//   3. Verify oodac check on the integrated pm_mint_fixture.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = root + "/oodac/oodac";
    let _ = scenario(p, fs, "PM and Mint Capability Integrity Smoke");

    // Beat 1: Check PM modules
    check(p, oodac + " check " + root + "/pm/manifest_types.oo", within: 15);
    check(p, oodac + " check " + root + "/pm/manifest_parse.oo", within: 15);
    check(p, oodac + " check " + root + "/pm/resolve_tree.oo", within: 15);
    check(p, oodac + " check " + root + "/pm/archive_unpack.oo", within: 15);
    check(p, oodac + " check " + root + "/pm/pm_engine.oo", within: 15);

    // Beat 2: Check Capability Mint modules
    check(p, oodac + " check " + root + "/../std/src/ooda/sec/mint/mint_types.oo", within: 15);
    check(p, oodac + " check " + root + "/../std/src/ooda/sec/mint/mint_authority.oo", within: 15);
    check(p, oodac + " check " + root + "/../std/src/ooda/sec/mint/mint_token.oo", within: 15);
    check(p, oodac + " check " + root + "/../std/src/ooda/sec/mint/mint_verify.oo", within: 15);
    check(p, oodac + " check " + root + "/../std/src/ooda/sec/mint/mint.oo", within: 15);

    // Beat 3: Check Integrated PM Mint Fixture
    check(p, oodac + " check " + root + "/fixtures/pm_mint_fixture.oo", within: 30);

    println("pm_mint_smoke: PASSED");
}
