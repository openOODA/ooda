// # Refuse a product CLI used as oodac
//
// Logline: Pick a compiler path and fail closed if those bytes are the product CLI.
//
// Setup: ProcessCap runs grep -a. FsReadCap sees oodac_bin, seed, and oodac/oodac.
//
// Beats:
//   1. Prefer oodac_bin, then seed, then oodac/oodac.
//   2. Refuse "pure .oo product CLI" (fork bomb if check execs that file).
//   3. Require "oodac: usage:" so a random ELF is not treated as oodac.

import "std/os/process.oo";

pub fn pick_compiler(fs: &FsReadCap, root: String) -> String {
    let mut base = root;
    if base == "" { base = "."; }
    if path_exists(fs, base + "/oodac_bin") { return base + "/oodac_bin"; }
    if path_exists(fs, base + "/bootstrap/seed/oodac") { return base + "/bootstrap/seed/oodac"; }
    if path_exists(fs, base + "/oodac/oodac") { return base + "/oodac/oodac"; }
    return "";
}

pub fn refuse_oodac_cli(p: &ProcessCap, path: String) {
    if path == "" {
        println("ERR_OODAC_NOT_COMPILER empty");
        process_exit(1);
    }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' " + path).is_ok() {
        println("ERR_OODAC_IS_CLI " + path);
        process_exit(1);
    }
    if process_exec(p, "grep -a -q 'oodac: usage:' " + path).is_err() {
        println("ERR_OODAC_NOT_COMPILER " + path);
        process_exit(1);
    }
}
