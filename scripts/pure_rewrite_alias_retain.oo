// # Pure Rewrite Alias Retain
//
// Logline: Seed softener: inject ARC retain after OoStr/list alias bindings (let x = y) to prevent double-release.
//
// Setup: Pure string/AST rewriter; callable as a library function or standalone script with Process/Fs capabilities.
//
// Beats:
//   1. Scan lines for alias bindings of ARC types (OoStr, OoSList, OoIList).
//   2. Skip __tmp temporaries and self-assignments.
//   3. Inject corresponding retain call immediately following the binding.
//   4. Verify transformation with built-in scenario test cases.

import "std/scenario.oo";
import "std/sh.oo";
import "std/str.oo";

pub fn inject_alias_retains(t: String) -> String {
    if str_contains(t, "alias retain softener") {
        return t;
    }
    let n = chars_len(t);
    let mut out = "";
    let mut line_start = 0;
    while line_start < n {
        let mut line_end = line_start;
        while line_end < n && char_at(t, line_end) != "\n" {
            line_end = line_end + 1;
        }
        let line = str_slice(t, line_start, line_end);
        let transformed = rewrite_alias_line(line);
        out = out + transformed;
        if line_end < n {
            out = out + "\n";
            line_start = line_end + 1;
        } else {
            line_start = line_end;
        }
    }
    return out;
}

fn rewrite_alias_line(line: String) -> String {
    let ln = chars_len(line);
    let mut idx = 0;
    while idx < ln && (char_at(line, idx) == " " || char_at(line, idx) == "\t") {
        idx = idx + 1;
    }
    let indent = str_slice(line, 0, idx);
    let rem = str_slice(line, idx, ln);
    let mut ret_fn = "";
    if str_starts_with(rem, "OoStr") {
        ret_fn = "oo_str_retain";
        idx = idx + 5;
    } else if str_starts_with(rem, "OoSList") {
        ret_fn = "oo_slist_retain";
        idx = idx + 7;
    } else if str_starts_with(rem, "OoIList") {
        ret_fn = "oo_ilist_retain";
        idx = idx + 7;
    } else {
        return line;
    }

    if idx >= ln || (char_at(line, idx) != " " && char_at(line, idx) != "\t") {
        return line;
    }
    while idx < ln && (char_at(line, idx) == " " || char_at(line, idx) == "\t") {
        idx = idx + 1;
    }

    if idx >= ln {
        return line;
    }
    let name_start = idx;
    let c0 = char_at(line, idx);
    if !(char_is_alpha(c0) || c0 == "_") {
        return line;
    }
    while idx < ln {
        let c = char_at(line, idx);
        if char_is_alpha(c) || char_is_digit(c) || c == "_" {
            idx = idx + 1;
        } else {
            break;
        }
    }
    let name = str_slice(line, name_start, idx);

    while idx < ln && (char_at(line, idx) == " " || char_at(line, idx) == "\t") {
        idx = idx + 1;
    }
    if idx >= ln || char_at(line, idx) != "=" {
        return line;
    }
    idx = idx + 1;

    while idx < ln && (char_at(line, idx) == " " || char_at(line, idx) == "\t") {
        idx = idx + 1;
    }
    if idx >= ln {
        return line;
    }
    let rhs_start = idx;
    let r0 = char_at(line, idx);
    if !(char_is_alpha(r0) || r0 == "_") {
        return line;
    }
    while idx < ln {
        let c = char_at(line, idx);
        if char_is_alpha(c) || char_is_digit(c) || c == "_" {
            idx = idx + 1;
        } else {
            break;
        }
    }
    let rhs = str_slice(line, rhs_start, idx);

    while idx < ln && (char_at(line, idx) == " " || char_at(line, idx) == "\t") {
        idx = idx + 1;
    }
    if idx >= ln || char_at(line, idx) != ";" {
        return line;
    }
    idx = idx + 1;

    while idx < ln {
        let c = char_at(line, idx);
        if c != " " && c != "\t" && c != "\r" {
            return line;
        }
        idx = idx + 1;
    }

    if str_starts_with(name, "__tmp") || name == rhs {
        return line;
    }

    return line + "\n" + indent + ret_fn + "(" + name + "); /* alias retain softener */";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let _ = scenario(p, fs, "pure_rewrite_alias_retain smoke and unit verification");

    let t1 = "    OoStr a = b;\n";
    let r1 = inject_alias_retains(t1);
    assert_eq!(str_contains(r1, "oo_str_retain(a); /* alias retain softener */"), true);

    let t2 = "    OoSList list_a = list_b;\n";
    let r2 = inject_alias_retains(t2);
    assert_eq!(str_contains(r2, "oo_slist_retain(list_a); /* alias retain softener */"), true);

    let t3 = "    OoIList num_a = num_b;\n";
    let r3 = inject_alias_retains(t3);
    assert_eq!(str_contains(r3, "oo_ilist_retain(num_a); /* alias retain softener */"), true);

    let t4 = "    OoStr __tmp = b;\n";
    let r4 = inject_alias_retains(t4);
    assert_eq!(str_contains(r4, "alias retain softener"), false);

    let t5 = "    OoStr a = a;\n";
    let r5 = inject_alias_retains(t5);
    assert_eq!(str_contains(r5, "alias retain softener"), false);

    println("pure_rewrite_alias_retain: PASSED");
}
