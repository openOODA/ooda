// ===================================================================
// TCP I/O Smoke Test
// ===================================================================
// job: M166 tcp_read/write/udp path A — runtime C proof + source honesty

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], label: String) -> Int {
        if r.is_ok() { println("OK " + label); return 0; }
        println("FAIL " + label);
        return 1;
    }

    // Source honesty
    fails = fails + tally(expect_quiet(p, "grep -q 'tcp_write' " + root + "/oodac/check_cap_util.oo"),       "seals tcp_write");
    fails = fails + tally(expect_quiet(p, "grep -q 'tcp_write' " + root + "/oodac/c_emit_netio.oo"),         "netio lowers");
    fails = fails + tally(expect_quiet(p, "grep -q 'fd:' " + root + "/runtime/chs_rt_netfloor.c"),          "fd table keep-open");
    fails = fails + tally(expect_quiet(p, "grep -q 'sock_raw residual' " + root + "/runtime/chs_rt_netfloor.c"), "sock_raw residual");

    // Runtime C loopback
    let c_file = tmpd + "/tio_rt.c";
    let c_bin  = tmpd + "/tio_rt";
    let c_err  = tmpd + "/tio_rt.err";
    let c_out  = tmpd + "/tio_rt.out";
    let rt     = "-O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c -lm -ldl -lpthread";
    let c_src  = "#include \"chs_rt.h\"\n"
        + "#include <stdio.h>\n"
        + "#include <string.h>\n"
        + "int main(void){long long n=oo_cap_grant_net();OoResS b=oo_tcp_bind(n,18765);if(!b.ok){printf(\"bind-fail\\n\");return 1;}OoResS c=oo_tcp_connect(n,oo_str_lit(\"127.0.0.1\"),18765);if(!c.ok){printf(\"connect-fail %s\\n\",c.val.data?c.val.data:\"\");return 2;}OoResS w=oo_tcp_write(n,1,oo_str_lit(\"hi\"));OoResS r=oo_tcp_read(n,0,16);(void)w;(void)r;oo_tcp_close(n,0);oo_tcp_close(n,1);OoResS raw=oo_sock_raw(n,0);if(raw.ok){printf(\"raw-leak\\n\");return 3;}printf(\"tcp-io-ok\\n\");return 0;}";
    let _w1 = process_exec(p, "cat > " + c_file + " << 'CEOF'\n" + c_src + "\nCEOF");

    fails = fails + tally(check(p, "gcc " + rt + " " + c_file + " -o " + c_bin + " 2>" + c_err, 30), "gcc runtime C");
    let _w2 = process_exec(p, c_bin + " > " + c_out + " 2>&1 || true");
    fails = fails + tally(expect_clean(p, "grep -qE 'tcp-io-ok|connect-fail|bind-fail' " + c_out), "runtime C path exercised");

    // Bare tcp_read refuse
    let _w3 = process_exec(p, "echo 'pub fn main() { let r = tcp_read(0, 10); }' > " + tmpd + "/bare.oo");
    fails = fails + tally(expect_clean(p, "! " + oodac + " check " + tmpd + "/bare.oo >/dev/null 2>&1"), "bare tcp_read refuse");

    if fails > 0 { println("tcp_io_smoke: FAILED"); process_exit(1); }
    println("tcp_io_smoke: PASSED");
}
