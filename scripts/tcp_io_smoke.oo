// # TCP I/O Smoke
//
// Logline: M166 tcp_read/write/udp path A — runtime C loopback proves cap seal + source honesty.
//
// Setup: oodac/oodac built; runtime/ has chs_rt.h; gcc on PATH.
//
// Beats:
//   1. Source honesty: tcp_write seals in check_cap_util.oo; fd: + sock_raw residual in chs_rt_netfloor.c.
//   2. Runtime C loopback: oo_tcp_bind/connect/write/read close; oo_sock_raw residual deny.
//   3. Bare tcp_read in a tiny main.oo is refused by oodac check.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "tcp io path A");

    // when "tcp_write sealed in check_cap_util.oo" {
    // and  "fd: + sock_raw residual present in chs_rt_netfloor.c" {
    // and  "runtime C loopback tcp-io-ok (or bind/connect-fail)" {
    // and  "bare tcp_read in tiny main.oo refused by oodac check" {
    // then "tcp io PASSED" { } } } }

    let _ = expect_quiet(p, "grep -q 'tcp_write' " + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'tcp_write' " + root + "/oodac/c_emit_netio.oo");
    let _ = expect_quiet(p, "grep -q 'fd:' " + root + "/runtime/chs_rt_netfloor.c");
    let _ = expect_quiet(p, "grep -q 'sock_raw residual' " + root + "/runtime/chs_rt_netfloor.c");

    let c_file = tmpd + "/tio_rt.c";
    let c_bin  = tmpd + "/tio_rt";
    let c_err  = tmpd + "/tio_rt.err";
    let c_out  = tmpd + "/tio_rt.out";
    let rt     = "-O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c -lm -ldl -lpthread";
    let c_src  = "#include \"chs_rt.h\"\n"
        + "#include <stdio.h>\n"
        + "#include <string.h>\n"
        + "int main(void){long long n=oo_cap_grant_net();OoResS b=oo_tcp_bind(n,18765);if(!b.ok){printf(\"bind-fail\\n\");return 1;}OoResS c=oo_tcp_connect(n,oo_str_lit(\"127.0.0.1\"),18765);if(!c.ok){printf(\"connect-fail %s\\n\",c.val.data?c.val.data:\"\");return 2;}OoResS w=oo_tcp_write(n,1,oo_str_lit(\"hi\"));OoResS r=oo_tcp_read(n,0,16);(void)w;(void)r;oo_tcp_close(n,0);oo_tcp_close(n,1);OoResS raw=oo_sock_raw(n,0);if(raw.ok){printf(\"raw-leak\\n\");return 3;}printf(\"tcp-io-ok\\n\");return 0;}";
    let _ = expect_quiet(p, "cat > " + c_file + " << 'CEOF'\n" + c_src + "\nCEOF");

    let _ = check(p, "gcc " + rt + " " + c_file + " -o " + c_bin + " 2>" + c_err, within: 30);
    let _ = process_exec(p, c_bin + " > " + c_out + " 2>&1 || true");
    let _ = expect_clean(p, "grep -qE 'tcp-io-ok|connect-fail|bind-fail' " + c_out);

    let _ = expect_quiet(p, "echo 'pub fn main() { let r = tcp_read(0, 10); }' > " + tmpd + "/bare.oo");
    let _ = expect_clean(p, "! " + oodac + " check " + tmpd + "/bare.oo >/dev/null 2>&1");

    println("tcp_io_smoke: PASSED");
}
