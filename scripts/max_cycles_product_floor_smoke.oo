// # Max Cycles Product Floor Smoke
//
// Logline: All MaxCycles path-A rails (enforce, for, shared, recursion, multi-digit, residual) run green under ooda + oodac.
//
// Setup: Process capability and test fixtures available.
// Beats: ooda + oodac on PATH | six sub-smokes run | product floor holds.

import "std/scenario.oo";
import "std/sh.oo";

const RAILS: List[String] = [
    "max_cycles_enforce_smoke.oo",
    "max_cycles_for_enforce_smoke.oo",
    "max_cycles_shared_smoke.oo",
    "max_cycles_recursion_smoke.oo",
    "max_cycles_multi_digit_smoke.oo"
];

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = scenario(p, fs, "max cycles product floor rails");

    // when: ooda + oodac are present and the rail scripts exist
    expect_clean(p, "test -x " + root + "/ooda/bin/ooda");
    expect_clean(p, "test -x " + oodac);

    // and: each rail script runs green
    let mut i: Int = 0;
    let n: Int = list_len(RAILS);
    while i < n {
        let rail = list_get(RAILS, i);
        expect_clean(p, "test -f " + root + "/ooda/scripts/" + rail);
        let _ = process_exec(p, "OODAC_BIN=" + oodac + " bash " + root + "/ooda/scripts/" + rail + " > /tmp/" + rail + ".out 2>&1");
        expect_clean(p, "test $? -eq 0");
        i = i + 1;
    }

    println("max_cycles_product_floor_smoke: PASSED");
}
