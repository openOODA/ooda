// # Secret Taint Residual Smoke
//
// Logline: M22/M52 — doc carries SECRET_TAINT_RESIDUAL_ALPHA, denies taint-tracking-as-product, names NetCap/non-println residual, and the fixture has SECRET markers.
// Beats: doc marker | no shipped-claim | NetCap/non-println residual | path A println | dual-claim scan.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/SECRET_TAINT.oot";
const FIX: String = "ooda/fixtures/secret_marker.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "secret taint residual honesty");

    // when: doc + residual marker
    expect_present(fs, root + "/" + DOC);
    expect_substring(fs, root + "/" + DOC, "SECRET_TAINT_RESIDUAL_ALPHA");

    // and: doc does not claim taint tracking shipped/enforced
    expect_clean(p, "! grep -nE '(ships|implements|enforces|provides) (static )?taint|taint (analysis|tracking) is (shipped|enforced|product)' " + root + "/" + DOC);

    // then: doc names NetCap / non-println residual + path A println
    expect_clean(p, "grep -qE 'NetCap|non-println' " + root + "/" + DOC);
    expect_clean(p, "grep -qE 'println.*refus|bare.IDENT|path A' " + root + "/" + DOC);

    // and: fixture carries SECRET directive
    expect_present(fs, root + "/" + FIX);
    expect_clean(p, "grep -qE '// SECRET:[[:space:]]*[[:alnum:]_]+' " + root + "/" + FIX);

    // dual-claim scan: bootstrap does not claim full static taint shipped elsewhere
    expect_clean(p, "! grep -rn --include='*.oot' --exclude='SECRET_TAINT.oot' -E 'taint tracking (shipped|enforced)|static taint (shipped|enforced|green)' " + root + "/ooda/bootstrap 2>/dev/null | grep -vE 'not |residual|no false' | head -1");

    println("secret_taint_residual_smoke: PASSED");
}
