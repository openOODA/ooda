// # Native LSP Residual Smoke
//
// Logline: bootstrap/NATIVE_LSP.oot carries residual marker, no shipped-as-enforced claim, fail-closed wording; ci_product wires it.
//
// Setup: Process capability and test fixtures available.
//
// Beats: doc + marker | non-shipped claim scan | fail-closed wording | fixture marker | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "native LSP residual honesty");

    // when "doc + residual marker present" {
    // and  "doc does not claim product-green enforce" {
    // and  "fail-closed residual wording present" {
    // and  "fixture marker line present" {
    // and  "ci_product wires this script" {
    // then "native_lsp_residual_smoke PASSED" { } } } } }

    expect_present(fs, "bootstrap/NATIVE_LSP.oot");
    expect_substring(fs, "bootstrap/NATIVE_LSP.oot", "NATIVE_LSP_RESIDUAL_ALPHA");
    expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + "bootstrap/NATIVE_LSP.oot" + " | grep -viE 'not |residual|do not|never|no '");
    expect_clean(p, "grep -qiE 'fail-closed residual|Fail-closed residual' " + "bootstrap/NATIVE_LSP.oot");
    expect_substring(fs, "fixtures/lsp_marker.oo", "LSP: residual");
    expect_substring(fs, root + "/scripts/ci_product.sh", "native_lsp_residual_smoke");
    println("native_lsp_residual_smoke: PASSED");
}
