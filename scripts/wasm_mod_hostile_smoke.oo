// # Hostile ident mod fold lock
//
// Logline: emit-wasm of println(8 % x) must not print only 2.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_mod_hostile.oo.
//   2. ERR or dummy empty stdout is honest.
//   3. Sole 2 on stdout fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn refuse_two_only(p: &ProcessCap, path: String) {
    if expect_quiet(p, "test ! -s " + path).is_ok() { return; }
    if expect_quiet(p, "grep -q 2 " + path).is_ok() { fail("rem-only"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm mod ident hostile").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_mod_hostile.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_mod_hostile.wasm";
    let errf = tmpd + "/wasm_mod_hostile.err";
    let out = tmpd + "/wasm_mod_hostile.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_mod_hostile.oo > " + wasm + " 2>" + errf).is_err() {
        if expect_quiet(p, "grep -q ERR " + errf).is_ok() {
            println("wasm_mod_hostile_smoke: PASSED");
            return;
        }
    }
    if expect_quiet(p, "grep -qE '^ERR' " + errf + " " + wasm).is_ok() {
        println("wasm_mod_hostile_smoke: PASSED");
        return;
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() {
            println("wasm_mod_hostile_smoke: PASSED");
            return;
        }
        refuse_two_only(p, out);
    } else {
        refuse_two_only(p, wasm);
    }
    println("wasm_mod_hostile_smoke: PASSED");
}
