// # Bytes Buffer Floor Walks List[Int] 0..255
// Logline: bytes_new/push/get/to_str/from_str/concat source floor + runtime + fixture product exec.
// Setup: oodac/oodac built; chs_rt.c linkable; bootstrap/BYTE_STR.oot on disk.
// Beats: 1. doc + runtime decls | 2. runtime C round-trip | 3. fixture exec push/get/to_str/concat

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);
    let doc   = root + "/bootstrap/BYTE_STR.oot";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — doc rails + residual honesty
    fails = fails + tally(expect_quiet(p, "grep -qE 'bytes_new|bytes_push|bytes_to_str' " + doc + " && grep -qiE 'List.Int..0..255|Byte buffer' " + doc), "doc path A Byte buffer");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'not.*List.Byte.|List.Byte..*not product|List.Byte. ABI' " + doc), "doc List[Byte] residual");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'not.*&str|no lifetime|NOT product' " + doc), "doc &str residual honesty");
    fails = fails + tally(expect_quiet(p, "grep -qE 'bytes_from_str|bytes_concat' " + doc), "doc bytes_from_str/concat");

    // when — runtime decls + impl
    fails = fails + tally(check(p, "grep -q 'oo_bytes_new' " + root + "/runtime/chs_rt.h && grep -q 'oo_bytes_push' " + root + "/runtime/chs_rt.h && grep -q 'oo_bytes_to_str' " + root + "/runtime/chs_rt.h", 5), "runtime decls M164");
    fails = fails + tally(check(p, "grep -q 'oo_bytes_to_str' " + root + "/runtime/chs_rt_str.c && grep -q 'oo_bytes_push' " + root + "/runtime/chs_rt_str.c", 5), "runtime impl M164");

    // and — emit/check wiring source floor
    fails = fails + tally(check(p, "grep -q 'bytes_new' " + root + "/oodac/tc_names.oo && grep -q 'bytes_to_str' " + root + "/oodac/tc_names.oo && grep -q 'bytes_from_str' " + root + "/oodac/tc_names.oo", 5), "tc_names M164");
    fails = fails + tally(check(p, "grep -q 'oo_bytes_new' " + root + "/oodac/c_emit_libfloor.oo && grep -q 'oo_bytes_to_str' " + root + "/oodac/c_emit_libfloor.oo", 5), "c_emit_libfloor M164");
    fails = fails + tally(check(p, "grep -q 'bytes_new=0' " + root + "/oodac/tc_call_arity.oo && grep -q 'bytes_push=2' " + root + "/oodac/tc_call_arity.oo", 5), "tc_call_arity M164");
    fails = fails + tally(check(p, "grep -q 'bytes_new\\|byte_buf_new' " + root + "/std/byte.oo && grep -qiE 'List.Int|0..255' " + root + "/std/byte.oo", 5), "std/byte.oo wrappers + residual");

    // and — runtime C round-trip
    let rt = tmpd + "/bytes_buf_rt.c";
    let _w1 = process_exec(p, "cat > " + rt + " <<'CEOF'\n#include \"chs_rt.h\"\n#include <stdio.h>\nint main(void){OoIList bs=oo_bytes_new(); bs=oo_bytes_push(bs,65); bs=oo_bytes_push(bs,300); if(oo_bytes_get(bs,0)!=65)return 1; if(oo_bytes_get(bs,1)!=255)return 2; if(oo_bytes_get(bs,9)!=-1)return 3; OoStr s=oo_bytes_to_str(bs); if(oo_bytes_len(s)!=2)return 4; if(oo_byte_at(s,0)!=65)return 5; OoStr v=oo_bytes_from_str(oo_str_lit(\"AB\")); if(!oo_bytes_eq(v,oo_str_lit(\"AB\")))return 7; OoStr c=oo_bytes_concat(oo_str_lit(\"A\"),oo_str_lit(\"B\")); if(!oo_bytes_eq(c,oo_str_lit(\"AB\")))return 8; printf(\"rt-ok\\n\"); return 0;}\nCEOF");
    let _w2 = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + rt + " -lm -ldl -lpthread -o " + tmpd + "/bytes_buf_rt 2>" + tmpd + "/bytes_buf_rt.err");
    let _w3 = process_exec(p, tmpd + "/bytes_buf_rt +2>&1 || true");
    fails   = fails + tally(expect_quiet(p, "grep -q 'rt-ok' " + tmpd + "/bytes_buf_rt.out 2>/dev/null; true"), "runtime C bytes buffer");

    // then — fixture product exec
    if expect_quiet(p, "test -x " + oodac).is_ok() {
        let fix = root + "/fixtures/bytes_buffer_main.oo";
        let bin = tmpd + "/bbuf";
        let _w4 = process_exec(p, oodac + " build " + fix + " " + bin + " > " + tmpd + "/bbuf.out 2> " + tmpd + "/bbuf.err");
        let _w5 = process_exec(p, bin + " +2>&1 || true");
        fails   = fails + tally(check(p, "test -x " + bin + " && for v in 65 66 -1 AB 2; do grep -qxF \"$v\" " + tmpd + "/bbuf.out; done && (grep -qxF true " + tmpd + "/bbuf.out || grep -qxF 1 " + tmpd + "/bbuf.out)", 30), "fixture push/get/to_str/from_str/concat");
    }

    if fails > 0 { println("bytes_buffer_smoke: FAILED"); process_exit(1); }
    println("bytes_buffer_smoke: PASSED");
}
