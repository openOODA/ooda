// # Bytes Buffer Floor Walks List[Int] 0..255
// Logline: bytes_new/push/get/to_str/from_str/concat source floor + runtime + fixture product exec.
// Setup: oodac/oodac built; chs_rt.c linkable; fixtures on disk.
// Beats: 1. doc + runtime decls | 2. runtime C round-trip | 3. fixture exec push/get/to_str/concat

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "bytes buffer");

    // residual truth is openOODA/SHIPPED.oot and ROADMAP.oot

    // when — runtime decls + impl
    let _ = check(p, "grep -q 'oo_bytes_new' " + root + "/runtime/chs_rt.h && grep -q 'oo_bytes_push' " + root + "/runtime/chs_rt.h && grep -q 'oo_bytes_to_str' " + root + "/runtime/chs_rt.h", 5);
    let _ = check(p, "grep -q 'oo_bytes_to_str' " + root + "/runtime/chs_rt_str.c && grep -q 'oo_bytes_push' " + root + "/runtime/chs_rt_str.c", 5);

    // and — emit/check wiring source floor
    let _ = check(p, "grep -q 'bytes_new' " + root + "/oodac/tc_names.oo && grep -q 'bytes_to_str' " + root + "/oodac/tc_names.oo && grep -q 'bytes_from_str' " + root + "/oodac/tc_names.oo", 5);
    let _ = check(p, "grep -q 'oo_bytes_new' " + root + "/oodac/c_emit_libfloor.oo && grep -q 'oo_bytes_to_str' " + root + "/oodac/c_emit_libfloor.oo", 5);
    let _ = check(p, "grep -q 'bytes_new=0' " + root + "/oodac/tc_call_arity.oo && grep -q 'bytes_push=2' " + root + "/oodac/tc_call_arity.oo", 5);
    let _ = check(p, "grep -q 'bytes_new\\|byte_buf_new' " + root + "/std/byte.oo && grep -qiE 'List.Int|0..255' " + root + "/std/byte.oo", 5);

    // and — runtime C round-trip
    let rt = tmpd + "/bytes_buf_rt.c";
    let _  = process_exec(p, "cat > " + rt + " <<'CEOF'\n#include \"chs_rt.h\"\n#include <stdio.h>\nint main(void){OoIList bs=oo_bytes_new(); bs=oo_bytes_push(bs,65); bs=oo_bytes_push(bs,300); if(oo_bytes_get(bs,0)!=65)return 1; if(oo_bytes_get(bs,1)!=255)return 2; if(oo_bytes_get(bs,9)!=-1)return 3; OoStr s=oo_bytes_to_str(bs); if(oo_bytes_len(s)!=2)return 4; if(oo_byte_at(s,0)!=65)return 5; OoStr v=oo_bytes_from_str(oo_str_lit(\"AB\")); if(!oo_bytes_eq(v,oo_str_lit(\"AB\")))return 7; OoStr c=oo_bytes_concat(oo_str_lit(\"A\"),oo_str_lit(\"B\")); if(!oo_bytes_eq(c,oo_str_lit(\"AB\")))return 8; printf(\"rt-ok\\n\"); return 0;}\nCEOF");
    let _  = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + rt + " -lm -ldl -lpthread -o " + tmpd + "/bytes_buf_rt 2>" + tmpd + "/bytes_buf_rt.err");
    let _  = process_exec(p, tmpd + "/bytes_buf_rt +2>&1 || true");
    let _  = expect_quiet(p, "grep -q 'rt-ok' " + tmpd + "/bytes_buf_rt.out 2>/dev/null; true");

    // then — fixture product exec
    if expect_quiet(p, "test -x " + oodac).is_ok() {
        let fix = root + "/fixtures/bytes_buffer_main.oo";
        let bin = tmpd + "/bbuf";
        let _   = process_exec(p, oodac + " build " + fix + " " + bin + " > " + tmpd + "/bbuf.out 2> " + tmpd + "/bbuf.err");
        let _   = process_exec(p, bin + " +2>&1 || true");
        let _   = check(p, "test -x " + bin + " && for v in 65 66 -1 AB 2; do grep -qxF \"$v\" " + tmpd + "/bbuf.out; done && (grep -qxF true " + tmpd + "/bbuf.out || grep -qxF 1 " + tmpd + "/bbuf.out)", 30);
    }

    println("bytes_buffer_smoke: PASSED");
}
