// # Distributed Actor and Concurrency Channel Verification Suite
//
// Logline: Verify type-safety, DINNER compliance, line-count constraints, oodac compilation, and binary execution of actor and channel modules.
//
// Setup: oodac compiler binary built; std/src/ooda/ actor and concurrency modules on disk; fixtures/actor_channel_fixture.oo present.
//
// Beats:
//   1. Check type-safety across actor and concurrency channel standard library modules.
//   2. Validate DINNER headers and strictly <= 256 line count constraints across all source files.
//   3. Compile and execute actor_channel_fixture binary, proving lifecycle, supervision, and throughput.
//   4. Verify zero-copy sequence masking, priority mailboxes, and OneForOne restart semantics.
//   5. Output test summary and emit final PASSED certification.
//
// residual: Multi-node distributed clustering and hugetlbfs shared-memory channels lower through OS network fabric

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let std_r = sh_realpath(p, root + "/../std").unwrap_or(root + "/../std");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, fs, "actor and concurrency channels");

    // Beat 1: Check type safety of actor modules
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/actor/actor_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/actor/actor_mailbox.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/actor/actor_supervision.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/actor/actor_router.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/actor/actor.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/actor.oo", 10);

    // Beat 2: Check type safety of concurrency channel modules
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/concurrency/channel_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/concurrency/ring_buffer.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/concurrency/channel_select.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/concurrency/channel.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/concurrency.oo", 10);

    // Beat 3: Validate line count constraints (strictly <= 256 lines)
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/actor/actor_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/actor/actor_mailbox.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/actor/actor_supervision.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/actor/actor_router.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/actor/actor.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/concurrency/channel_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/concurrency/ring_buffer.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/concurrency/channel_select.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/concurrency/channel.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/fixtures/actor_channel_fixture.oo) -le 256", 5);

    // Beat 4: Check, compile, and execute end-to-end fixture
    let fix = root + "/fixtures/actor_channel_fixture.oo";
    let _ = check(p, oodac + " check " + fix, 10);
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmpd + "/act_chan.c 2> " + tmpd + "/act_chan.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/act_chan.c " + tmpd + "/act_chan.err 2>/dev/null", 15);
    let _ = process_exec(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/act_chan.c -lm -ldl -lpthread -o " + tmpd + "/act_chan.bin 2>" + tmpd + "/act_chan_gcc.err");
    let _ = process_exec(p, tmpd + "/act_chan.bin > " + tmpd + "/act_chan.out 2>&1");
    let _ = check(p, "grep -qx 'ACTOR_LIFECYCLE_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'MAILBOX_PRIORITY_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'SUPERVISOR_RESTART_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'ROUTER_DISPATCH_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'RING_BUFFER_ZERO_COPY_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'CHANNEL_SELECT_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'THROUGHPUT_BURST_OK' " + tmpd + "/act_chan.out", 10);
    let _ = check(p, "grep -qx 'ACTOR_CHANNEL_FIXTURE_ALL_PASSED' " + tmpd + "/act_chan.out", 10);

    // Beat 5: DINNER header verification
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/actor/actor.oo", 5);
    let _ = check(p, "grep -qE '^// Logline: ' " + std_r + "/src/ooda/actor/actor.oo", 5);
    let _ = check(p, "grep -qE '^// Setup: ' " + std_r + "/src/ooda/actor/actor.oo", 5);
    let _ = check(p, "grep -qE '^// Beats:' " + std_r + "/src/ooda/actor/actor.oo", 5);
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/concurrency/channel.oo", 5);

    println("actor_channel_smoke: PASSED");
}
