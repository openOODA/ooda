// # list_push String into xs prints path and caret
//
// Logline: Cache-cold check of list_push(xs, String) shows list element mismatch, path, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac. Name is xs, not ys.
//
// Beats:
//   1. tc_list_elem_xs.oo prints list element type mismatch, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_list_elem.oo (ys) still refuses.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/list_elem_any";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_list_elem_xs.oo > " + tmpd +
        "/xs.out; echo $? > " + tmpd + "/xs.ec; true").is_err() {
        fail("check xs");
    }
    if process_exec(p, "grep -q 'list element type mismatch' " + tmpd +
        "/xs.out && grep -q 'tc_list_elem_xs.oo' " + tmpd +
        "/xs.out && grep -Fq -- '-->' " + tmpd + "/xs.out && grep -q '\\^' " +
        tmpd + "/xs.out && ! grep -qE '^OK' " + tmpd +
        "/xs.out && test \"$(cat " + tmpd + "/xs.ec)\" -ne 0").is_err() {
        fail("no xs caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_list_elem.oo > " + tmpd +
        "/ys.out; echo $? > " + tmpd + "/ys.ec; true").is_err() {
        fail("check ys");
    }
    if process_exec(p, "grep -q 'list element type mismatch' " + tmpd +
        "/ys.out && grep -q 'tc_list_elem.oo' " + tmpd +
        "/ys.out && ! grep -qE '^OK' " + tmpd +
        "/ys.out && test \"$(cat " + tmpd + "/ys.ec)\" -ne 0").is_err() {
        fail("ys lost");
    }
    println("list_elem_any_smoke: PASSED");
}
