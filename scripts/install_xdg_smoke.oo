// # XDG checkout install smoke
//
// Logline: install.oo copies ooda, oodac, std, and runtime under a write root.
//
// Setup: cwd is ooda/. Tree oodac/oodac and bin/ooda exist. Write root is tmp.
//
// Beats:
//   1. Run install.oo with OODA_FS_WRITEDIR in tmp.
//   2. Require ooda, oodac, oo, env, receipt, std, runtime.
//   3. Refuse when OODA_FS_WRITEDIR is unset.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn want(p: &ProcessCap, cmd: String, tag: String) {
    if process_exec(p, cmd).is_err() {
        fail(tag);
    }
}

pub fn main(p: &ProcessCap) {
    let work: String = "$(pwd)/.ooda-cache/ooda-tmp/install_xdg";
    want(p, "test -x ./oodac/oodac", "no oodac");
    want(p, "test -x ./bin/ooda", "no bin/ooda");
    want(p, "test -f install/install.oo", "no install.oo");
    want(p, "rm -rf " + work + " && mkdir -p " + work, "work dir");
    if process_exec(p, "env -u OODA_FS_WRITEDIR OODA_CHECKOUT=\"$PWD\" ./oodac/oodac run install/install.oo > " + work + "/nounset.out 2>&1").is_ok() {
        fail("unset write root must fail");
    }
    want(p, "grep -q 'OODA_FS_WRITEDIR' " + work + "/nounset.out", "unset message");
    want(p, "OODA_POLICY_WRITE=1 OODA_FS_WRITEDIR=" + work + " OODA_CHECKOUT=\"$PWD\" ./oodac/oodac run install/install.oo > " + work + "/ok.out 2>&1", "install run");
    want(p, "grep -q 'install_xdg: PASSED' " + work + "/ok.out", "passed line");
    want(p, "test -x " + work + "/.local/bin/ooda", "ooda bin");
    want(p, "test -x " + work + "/.local/bin/oodac", "oodac bin");
    want(p, "test -x " + work + "/.local/bin/oo", "oo alias");
    want(p, "test -f " + work + "/.config/ooda/env", "env");
    want(p, "test -f " + work + "/.local/share/ooda/share/INSTALL_RECEIPT.txt", "receipt");
    want(p, "test -d " + work + "/.local/share/ooda/std", "std");
    want(p, "test -d " + work + "/.local/share/ooda/runtime", "runtime");
    want(p, "grep -q 'version=v0.207.0' " + work + "/.local/share/ooda/share/INSTALL_RECEIPT.txt", "pin");
    println("install_xdg_smoke: PASSED");
}
