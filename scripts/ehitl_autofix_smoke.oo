// # EHITL Auto-Fix Smoke
//
// Logline: E_HITL bounded auto-fix removes the exact `// HITL: pause` line and clears E_HITL on re-check; E_CAP-only and free-form comments are not touched.
// Setup: oodac/oodac prebuilt; ooda_apply_fix.py + ooda_apply_ehitl_fix.py; fixtures/hitl_pause_fail.oo.
//
// Beats: before E_HITL | apply exits 0 and exact pause line removed | after no E_HITL | E_CAP-only fail-closed | free-form comment not tripped | product CLI fixes pause line.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "E_HITL bounded auto-fix floor");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/hitl_pause_fail.oo");
    expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo");

    when "hitl_pause_fail triggers E_HITL (deny without --hitl-allowed)" {
    and  "apply removes exact `// HITL: pause` line" {
    and  "after check no longer has E_HITL" {
    and  "ehitl-only on E_CAP-only fail-closed" {
    and  "free-form HITL comment does not trip check" {
    and  "product CLI fixes E_HITL on pause line" {
    then "E_HITL auto-fix path green" {
    } } } } } }

    let work: String = match sh_tempfile(p, "-d " + tmpd + " -t ehitl_XXXXXX") { Ok(s) => s, Err(_) => tmpd + "/ehitl_work" };
    let _ = sh_clean(p, work);
    let _ = sh_mkdir_p(fw, work);
    check(p, "cp " + root + "/fixtures/hitl_pause_fail.oo " + work + "/h.oo", within: 5);
    expect_clean(p, "! env -u OODA_HITL_ALLOW -u OODA_HITL_AUTO_APPROVE " + oodac + " check " + work + "/h.oo --json-errors > " + work + "/before.json 2> " + work + "/before.err");

    check(p, "python3 " + root + "/scripts/ooda_apply_fix.py " + work + "/h.oo > " + work + "/apply.out 2> " + work + "/apply.err", within: 30);
    expect_clean(p, "! grep -qE '^[[:space:]]*// HITL: pause[[:space:]]*$' " + work + "/h.oo");

    check(p, oodac + " check " + work + "/h.oo --json-errors > " + work + "/after.json 2> " + work + "/after.err", within: 30);
    expect_clean(p, "! grep -q '\"code\": \"E_HITL\"' " + work + "/after.json");

    check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo " + work + "/cap.oo && ! python3 " + root + "/scripts/ooda_apply_ehitl_fix.py " + work + "/cap.oo > " + work + "/na.out 2> " + work + "/na.err", within: 30);

    check(p, "printf '// not a pause: HITL: pause mid-doc only\\npub fn main() {\\n    println(0);\\n}\\n' > " + work + "/safe.oo", within: 5);
    check(p, oodac + " check " + work + "/safe.oo > " + work + "/safe.out 2> " + work + "/safe.err", within: 30);

    expect_quiet(p, "test -x " + ooda);
    check(p, "cp " + root + "/fixtures/hitl_pause_fail.oo " + work + "/cli.oo && " + ooda + " fix " + work + "/cli.oo > " + work + "/cli.out 2> " + work + "/cli.err", within: 60);
    expect_clean(p, "! grep -qE '^[[:space:]]*// HITL: pause[[:space:]]*$' " + work + "/cli.oo");

    let _ = sh_clean(p, work);
    println("ehitl_autofix_smoke: PASSED");
}