// # Adversarial Probe: Tier 3 Mutation Engine Stress
//
// Logline: Hostile verification probe testing AST mutation operators, mutant kill detection, and threshold enforcement (<95% rejection).
//
// Setup: ProcessCap granted to inject synthetic mutant models and assert strict gate rejection on sub-95% kill rates.
//
// Beats:
//   1. Verify operator mutation functions invert relational, arithmetic, logical, and boundary operators.
//   2. Verify mutant evaluation oracle detects mutations and survives on equality.
//   3. Probe tier3_run_campaign rejecting suites with kill rate < 95% (94%, 50%, 0%).
//   4. Probe tier3_run_campaign accepting suites with kill rate >= 95% (95%, 99%, 100%).
//   5. Probe boundary error conditions (total <= 0, killed < 0, killed > total).

import "std/prove/tier3_mutation_sweep.oo";

fn assert_err(label: String, is_err: Bool) {
    if !is_err {
        println("FAIL: " + label + " expected Err but got Ok");
        process_exit(1);
    }
}

fn assert_ok(label: String, is_ok: Bool) {
    if !is_ok {
        println("FAIL: " + label + " expected Ok but got Err");
        process_exit(1);
    }
}

fn test_mutation_operators() {
    // Relational
    let op_lt: String = tier3_mutate_relational("<");
    if op_lt != "<=" { println("FAIL: mutate <"); process_exit(1); }
    let op_lte: String = tier3_mutate_relational("<=");
    if op_lte != "<" { println("FAIL: mutate <="); process_exit(1); }
    let op_gt: String = tier3_mutate_relational(">");
    if op_gt != ">=" { println("FAIL: mutate >"); process_exit(1); }
    let op_gte: String = tier3_mutate_relational(">=");
    if op_gte != ">" { println("FAIL: mutate >="); process_exit(1); }
    let op_eq: String = tier3_mutate_relational("==");
    if op_eq != "!=" { println("FAIL: mutate =="); process_exit(1); }
    let op_neq: String = tier3_mutate_relational("!=");
    if op_neq != "==" { println("FAIL: mutate !="); process_exit(1); }

    // Arithmetic
    let op_add: String = tier3_mutate_arithmetic("+");
    if op_add != "-" { println("FAIL: mutate +"); process_exit(1); }
    let op_sub: String = tier3_mutate_arithmetic("-");
    if op_sub != "+" { println("FAIL: mutate -"); process_exit(1); }
    let op_mul: String = tier3_mutate_arithmetic("*");
    if op_mul != "/" { println("FAIL: mutate *"); process_exit(1); }
    let op_div: String = tier3_mutate_arithmetic("/");
    if op_div != "*" { println("FAIL: mutate /"); process_exit(1); }

    // Logical
    let op_and: String = tier3_mutate_logical("&&");
    if op_and != "||" { println("FAIL: mutate &&"); process_exit(1); }
    let op_or: String = tier3_mutate_logical("||");
    if op_or != "&&" { println("FAIL: mutate ||"); process_exit(1); }
    let op_not: String = tier3_mutate_logical("!");
    if op_not != "id" { println("FAIL: mutate !"); process_exit(1); }

    // Boundary
    let b0: Int = tier3_mutate_boundary(0);
    if b0 != -1 { println("FAIL: mutate boundary 0"); process_exit(1); }
    let b10: Int = tier3_mutate_boundary(10);
    if b10 != 11 { println("FAIL: mutate boundary 10"); process_exit(1); }
}

fn test_mutant_evaluation() {
    let killed: Bool = tier3_evaluate_mutant(10, 20);
    if !killed { println("FAIL: evaluate_mutant should detect difference"); process_exit(1); }

    let survived: Bool = tier3_evaluate_mutant(10, 10);
    if survived { println("FAIL: evaluate_mutant should return false for identical values"); process_exit(1); }
}

fn test_kill_rate_rejection_below_95() {
    // 94 out of 100 (94% kill rate -> MUST FAIL)
    let r94: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 94);
    match r94 { Ok(_) => { assert_err("kill_rate_94_pct", false); }, Err(_) => { assert_err("kill_rate_94_pct", true); } }

    // 50 out of 100 (50% kill rate -> MUST FAIL)
    let r50: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 50);
    match r50 { Ok(_) => { assert_err("kill_rate_50_pct", false); }, Err(_) => { assert_err("kill_rate_50_pct", true); } }

    // 0 out of 100 (0% kill rate -> MUST FAIL)
    let r0: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 0);
    match r0 { Ok(_) => { assert_err("kill_rate_0_pct", false); }, Err(_) => { assert_err("kill_rate_0_pct", true); } }

    // 949 out of 1000 (94.9% kill rate -> MUST FAIL)
    let r949: Result[Tier3MutationReport, String] = tier3_run_campaign(1000, 949);
    match r949 { Ok(_) => { assert_err("kill_rate_949_per_1000", false); }, Err(_) => { assert_err("kill_rate_949_per_1000", true); } }
}

fn test_kill_rate_acceptance_ge_95() {
    // 95 out of 100 (95% -> PASS)
    let r95: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 95);
    match r95 {
        Ok(rep) => {
            assert_ok("kill_rate_95_pct", rep.is_tier3_certified && rep.kill_rate_percent == 95 && rep.surviving_mutants == 5);
        },
        Err(_) => { assert_ok("kill_rate_95_pct", false); }
    }

    // 100 out of 100 (100% -> PASS)
    let r100: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 100);
    match r100 {
        Ok(rep) => {
            assert_ok("kill_rate_100_pct", rep.is_tier3_certified && rep.kill_rate_percent == 100 && rep.surviving_mutants == 0);
        },
        Err(_) => { assert_ok("kill_rate_100_pct", false); }
    }
}

fn test_invalid_campaign_bounds() {
    // total <= 0
    let r_zero_tot: Result[Tier3MutationReport, String] = tier3_run_campaign(0, 0);
    match r_zero_tot { Ok(_) => { assert_err("campaign_total_zero", false); }, Err(_) => { assert_err("campaign_total_zero", true); } }

    let r_neg_tot: Result[Tier3MutationReport, String] = tier3_run_campaign(-10, 0);
    match r_neg_tot { Ok(_) => { assert_err("campaign_total_neg", false); }, Err(_) => { assert_err("campaign_total_neg", true); } }

    // killed < 0 or killed > total
    let r_neg_k: Result[Tier3MutationReport, String] = tier3_run_campaign(100, -1);
    match r_neg_k { Ok(_) => { assert_err("campaign_killed_neg", false); }, Err(_) => { assert_err("campaign_killed_neg", true); } }

    let r_ov_k: Result[Tier3MutationReport, String] = tier3_run_campaign(100, 101);
    match r_ov_k { Ok(_) => { assert_err("campaign_killed_overflow", false); }, Err(_) => { assert_err("campaign_killed_overflow", true); } }
}

pub fn main(p: &ProcessCap) {
    println("--- probe_m2_tier3_mutation_adversarial: starting ---");
    test_mutation_operators();
    println("  [PASS] AST Mutation operators verified across relational/arithmetic/logical/boundary");
    test_mutant_evaluation();
    println("  [PASS] Mutant detection oracle correctly detects defect differences");
    test_kill_rate_rejection_below_95();
    println("  [PASS] Kill rate threshold <95% strictly rejected (94%, 50%, 0%)");
    test_kill_rate_acceptance_ge_95();
    println("  [PASS] Kill rate threshold >=95% accepted with exact surviving count");
    test_invalid_campaign_bounds();
    println("  [PASS] Invalid campaign total/killed bounds strictly fail-closed");
    println("probe_m2_tier3_mutation_adversarial: PASSED");
}
