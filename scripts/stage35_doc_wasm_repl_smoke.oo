// # openOODA Stage 35 Master Integration Smoke Suite
//
// Logline: Comprehensive integration proof verifying Pure .oo Static Documentation Compiler & WASM REPL Playground.
//
// Setup: Exercises documentation parsing, ASD-STE100 validation, doc example extraction, and WASM REPL sandboxed evaluation under ProcessCap.
//
// Beats:
//   1. Static Doc Compiler: verify module documentation metadata extraction and Markdown/HTML rendering.
//   2. ASD-STE100 Validator: verify technical English compliance checks and sentence metrics.
//   3. Documentation Example Extractor: verify code block extraction and verification scoring.
//   4. WebAssembly REPL Playground Engine: verify sandbox session creation and interactive snippet evaluation.

import "std/doc/doc_compiler.oo";
import "std/doc/ste100_validator.oo";
import "std/doc/example_extractor.oo";
import "std/wasm_repl/wasm_repl_engine.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA Stage 35: Pure .oo Static Documentation & WASM REPL");
    println("===================================================================");

    // -------------------------------------------------------------
    // Part I: Static Documentation Compiler
    // -------------------------------------------------------------
    let doc: DocCompilerModule = doc_compiler_module_new("Memory Arena", "High speed bump allocation.", "Requires AllocCap.", 4, 12);
    let md: String = doc_compiler_render_markdown(doc);
    let html: String = doc_compiler_render_html(doc);

    if md == "" || html == "" {
        println("FAIL: Stage 35 documentation rendering produced empty output");
        process_exit(1);
    }
    println("  [PASS] 1. Static Documentation Compiler (Markdown & HTML Generation Verified)");

    // -------------------------------------------------------------
    // Part II: ASD-STE100 English Validator
    // -------------------------------------------------------------
    let ste_res: Ste100ValidatorResult = ste100_validator_check(120, 10, 0);
    let ste_pass: Bool = ste_res.is_ste100_compliant;
    let avg_words: Int = ste_res.average_words_per_sentence;

    if !ste_pass || avg_words > 20 {
        println("FAIL: Stage 35 STE-100 validation failed");
        process_exit(1);
    }
    println("  [PASS] 2. ASD-STE100 English Validator (Clarity & Length Invariants Verified)");

    // -------------------------------------------------------------
    // Part III: Documentation Example Extractor
    // -------------------------------------------------------------
    let ex: ExampleExtractorItem = example_extractor_item_new("std/mem/arena.oo", 42, "let a = arena_new(1024);", "OK");
    let is_v: Bool = example_extractor_verify(ex);
    let ex_pct: Int = example_extractor_coverage(10, 10);

    if !is_v || ex_pct != 100 {
        println("FAIL: Stage 35 doc example extractor verification failed");
        process_exit(1);
    }
    println("  [PASS] 3. Documentation Example Extractor (100% Executable Beat Examples)");

    // -------------------------------------------------------------
    // Part IV: WebAssembly REPL Playground Engine
    // -------------------------------------------------------------
    let sess: WasmReplEngineSession = wasm_repl_engine_session_new(1, 1048576);
    let r_res: WasmReplEngineResult = wasm_repl_engine_evaluate(&sess, "let x: Int = 42; println(x);");
    let r_ok: Bool = r_res.is_success;
    let r_out: String = r_res.output_text;

    if !r_ok || r_out == "" {
        println("FAIL: Stage 35 WASM REPL sandbox evaluation failed");
        process_exit(1);
    }
    println("  [PASS] 4. WebAssembly REPL Playground Engine (Sandboxed Live Evaluation Verified)");

    println("stage35_doc_wasm_repl_smoke: PASSED");
}
