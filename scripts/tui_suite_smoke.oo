// # Dedicated Sovereign TUI Suite Smoke Test
//
// Logline: End-to-end verification of TUI buffers, double-buffered diff rendering, flexbox layout, and Elm architecture.
//
// Setup: Validates openOODA std/tui capabilities on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify TuiBuffer allocation, cell manipulation, and rectangular area clipping.
//   2. Verify double-buffered diff rendering generating minimal ANSI cursor jumps.
//   3. Verify Flexbox layout distribution across rectangular screen domains.
//   4. Verify Elm architecture (Model-View-Update) state transitions.

import "std/tui/tui_buffer.oo";
import "std/tui/tui_cell.oo";
import "std/tui/tui_renderer.oo";
import "std/tui/layout_flex.oo";
import "std/tui/tui_elm_arch.oo";
import "std/tui/kitty_graphics.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA TUI Suite Dedicated Integration Smoke");
    println("===================================================================");

    // 1. Buffer & Cell Canvas Operations
    let mut buf: TuiBuffer = tui_buffer_new(20, 10);
    let area: BufferArea = buffer_area_new(2, 2, 10, 4);
    let fill_cell: TuiCell = tui_cell_new(35, 2, 0); // '#' = 35
    buf = tui_buffer_fill_rect(buf, area, fill_cell);

    let cell_inside: TuiCell = tui_buffer_get_cell(buf, 3, 3);
    let cell_outside: TuiCell = tui_buffer_get_cell(buf, 0, 0);

    if cell_inside.ch != 35 || cell_outside.ch != 32 {
        println("FAIL: TUI Buffer cell retrieval or fill mismatch");
        process_exit(1);
    }
    println("  [PASS] 1. TUI Screen Buffer Allocation & Spatial Area Clipping");

    // 2. Double-Buffered Diff Rendering
    let buf_prev: TuiBuffer = tui_buffer_new(10, 5);
    let mut buf_next: TuiBuffer = tui_buffer_new(10, 5);
    let dirty_cell: TuiCell = tui_cell_new(88, 1, 0); // 'X' = 88
    buf_next = tui_buffer_set_cell(buf_next, 5, 2, dirty_cell);

    let diff_ansi: String = tui_render_diff(buf_prev, buf_next);
    if !str_contains(diff_ansi, "\x1b[3;6H") || !str_contains(diff_ansi, "X") {
        println("FAIL: TUI diff rendering failed to emit localized cursor sequence");
        process_exit(1);
    }
    println("  [PASS] 2. Double-Buffered Diff Rendering & ANSI Delta Optimization");

    // 3. Flexbox Layout Calculation
    let bounds: BufferArea = buffer_area_new(0, 0, 100, 20);
    let mut flex: FlexContainer = flex_container_new(bounds, 0, 0);
    let item1: FlexItem = flex_item_new(10, 100, 1);
    let item2: FlexItem = flex_item_new(10, 100, 3);
    flex_container_add_item(&mut flex, item1);
    flex_container_add_item(&mut flex, item2);
    let areas: List[BufferArea] = flex_layout_compute_row(&flex);

    let a0: BufferArea = list_get(areas, 0);
    let a1: BufferArea = list_get(areas, 1);
    if a0.width != 25 || a1.width != 75 {
        println("FAIL: Flexbox layout computation mismatch (expected widths 25 and 75)");
        process_exit(1);
    }
    println("  [PASS] 3. Flexbox Constraint Layout & Proportional Space Division");

    // 4. Elm Architecture Framework
    let model0: TuiElmArchModel = tui_elm_arch_init();
    let msg: TuiElmArchMsg = TuiElmArchMsg { msg_type: "increment", key_code: 0, payload: "" };
    let model1: TuiElmArchModel = tui_elm_arch_update(model0, msg);
    let view_str: String = tui_elm_arch_view(model1);

    if model1.counter != 1 || !str_contains(view_str, "Counter: 1") {
        println("FAIL: Elm Architecture Model-View-Update loop mismatch");
        process_exit(1);
    }
    println("  [PASS] 4. Elm Architecture Framework (Model-View-Update Cycle)");

    println("tui_suite_smoke: PASSED");
}
