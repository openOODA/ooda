// # Max Cycles Enforce Smoke
//
// Logline: M48 path A — while-loop fuel lands __oo_mc, runs under N, and ERR\\tmax_cycles on tight N.
// Beats: pass run | fail ERR | zero-N fail-closed | doc path A wording | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const PASS: String = "ooda/fixtures/max_cycles_pass.oo";
const FAIL: String = "ooda/fixtures/max_cycles_fail.oo";
const ZERO: String = "ooda/fixtures/max_cycles_zero.oo";
const DOC: String = "ooda/bootstrap/MAX_CYCLES.oot";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "max cycles path A while fuel");

    // when: pass fixture emits a while with __oo_mc and runs under N
    let c_p = root + "/.ooda-cache/ooda-tmp/mc_pass.c";
    let _ = process_exec(p, oodac + " emit-c " + PASS + " > " + c_p + " 2>/dev/null");
    expect_substring(fs, c_p, "__oo_mc");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_p + " -o " + c_p + ".bin -lm", within: 30);
    expect_clean(p, "timeout 3 " + c_p + ".bin 2>&1 | grep -qE '3'");

    // and: fail fixture exits non-zero with ERR\tmax_cycles under tight N
    let c_f = root + "/.ooda-cache/ooda-tmp/mc_fail.c";
    let _ = process_exec(p, oodac + " emit-c " + FAIL + " > " + c_f + " 2>/dev/null");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_f + " -o " + c_f + ".bin -lm", within: 30);
    expect_clean(p, "! timeout 3 " + c_f + ".bin 2>&1 | grep -qE 'ERR\tmax_cycles'");

    // then: zero N is fail-closed (native ERR or inject non-zero)
    expect_clean(p, oodac + " emit-c " + ZERO + " 2>&1 | grep -qE 'ERR\tmax_cycles' || ! " + oodac + " emit-c " + ZERO + " >/dev/null 2>&1");

    // and: doc carries path A while fuel wording + denials
    expect_present(fs, DOC);
    expect_substring(fs, DOC, "path A");
    expect_clean(p, "grep -qE 'cgroup|not OS' " + DOC);
    expect_clean(p, "! grep -nE 'names only|named marker only' " + DOC + " 2>/dev/null | grep -viE 'attribute|residual' | head -1");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_enforce_smoke");
    println("max_cycles_enforce_smoke: PASSED");
}
