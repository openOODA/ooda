// # Max Cycles Enforce Smoke
//
// Logline: M48 path A — while-loop fuel lands in __oo_mc, runs the pass under N, fails the tight-N fixture with ERR\tmax_cycles, and the zero-N fixture is fail-closed.
//
// Setup: Process capability and test fixtures available.
// Beats: pass run under N | fail ERR\tmax_cycles | zero-N fail-closed | doc path A naming | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/mc_enforce";
    let _ = sh_mkdir_p(fw, tmp);
    let rt = root + "/ooda/runtime";
    let _ = scenario(p, fs, "max cycles path A while fuel");

    // when: pass fixture emits a while with __oo_mc and runs under N
    let c_p = tmp + "/mc_pass.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_pass.oo" + " > " + c_p + " 2>/dev/null");
    expect_clean(p, "grep -qE '__oo_mc' " + c_p);
    expect_clean(p, "! grep -qE 'for[[:space:]]*\\([^)]*__oo_mc' " + c_p);
    check(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + c_p + " -o " + c_p + ".bin -lm", within: 30);
    expect_clean(p, "timeout 3 " + c_p + ".bin 2>&1 | grep -qE '3'");

    // and: fail fixture exits non-zero with ERR\tmax_cycles under tight N
    let c_f = tmp + "/mc_fail.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_fail.oo" + " > " + c_f + " 2>/dev/null");
    check(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + c_f + " -o " + c_f + ".bin -lm", within: 30);
    expect_clean(p, "! timeout 3 " + c_f + ".bin 2>&1 | grep -qE 'ERR\\tmax_cycles'");

    // then: zero N is fail-closed (native ERR or inject rail)
    let z_raw = tmp + "/mc_zero_raw.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_zero.oo" + " > " + z_raw + " 2> " + tmp + "/mc_zero.err");
    expect_clean(p, "grep -qE $'ERR\\tmax_cycles' " + z_raw + " " + tmp + "/mc_zero.err || ! [ -s " + z_raw + " ]");

    // and: doc carries path A while fuel wording + denials
    expect_present(fs, "ooda/bootstrap/MAX_CYCLES.oot");
    expect_substring(fs, "ooda/bootstrap/MAX_CYCLES.oot", "path A");
    expect_clean(p, "grep -qE 'cgroup|not OS' " + root + "/" + "ooda/bootstrap/MAX_CYCLES.oot");
    expect_clean(p, "! grep -nE 'names only|named marker only' " + root + "/" + "ooda/bootstrap/MAX_CYCLES.oot" + " 2>/dev/null | grep -viE 'attribute|residual' | head -1");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_enforce_smoke");
    println("max_cycles_enforce_smoke: PASSED");
}
