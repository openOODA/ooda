// # Residual CLI commands fail closed
//
// Logline: context, digest, health, pkg, and add exit nonzero with residual text.
//
// Setup: Product bin/ooda. OPEN-23..27.
//
// Beats:
//   1. Each residual command is refused.
//   2. Help does not sell them as product.
//   3. Print PASSED.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let ooda = root + "/bin/ooda";
    let sc: Result[Void, String] = scenario(p, fs, "residual cmds");
    if sc.is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + ooda).is_err() {
        println("FAIL no ooda");
        process_exit(1);
    }
    if expect_clean(p, ooda + " context 2>&1 | grep -q residual").is_err() {
        println("FAIL context");
        process_exit(1);
    }
    if expect_clean(p, ooda + " digest 2>&1 | grep -q residual").is_err() {
        println("FAIL digest");
        process_exit(1);
    }
    if expect_clean(p, ooda + " health 2>&1 | grep -q residual").is_err() {
        println("FAIL health");
        process_exit(1);
    }
    if expect_clean(p, ooda + " add 2>&1 | grep -q residual").is_err() {
        println("FAIL add");
        process_exit(1);
    }
    if expect_clean(p, ooda + " pkg 2>&1 | grep -q beta-out").is_err() {
        println("FAIL pkg");
        process_exit(1);
    }
    println("open_residual_cmds_smoke: PASSED");
}
