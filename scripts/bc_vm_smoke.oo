// # Bytecode VM smoke
//
// Logline: emit-bc at least three BC-subset fixtures and run them on the interpreter, not JIT.
//
// Setup: oodac/oodac built; fixtures on disk.
//
// Beats:
//   1. Resolve oodac and a temp dir.
//   2. emit-bc each fixture to bytecode.
//   3. Run on the interpreter and match stdout.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or(".ooda-cache/ooda-tmp");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("oodac/oodac");
    let work  = tmpd + "/bc_vm_smoke";
    let _     = sh_mkdir_p(fw, work);
    let _     = scenario(p, fs, "bytecode vm interpreter");

    // when: oodac and BC-subset fixtures are present
    let _ = expect_present(fs, "fixtures/chs_hello.oo");
    let _ = expect_present(fs, "fixtures/while_count.oo");
    let _ = expect_present(fs, "fixtures/for_range.oo");
    let _ = expect_present(fs, "fixtures/bc_arith_ops.oo");
    let _ = expect_present(fs, "fixtures/bc_unary_not.oo");

    // and: emit-bc writes interpreter bytecode (not JIT)
    let _ = check(p, oodac + " emit-bc fixtures/chs_hello.oo > " + work + "/chs_hello.bc", within: 20);
    let _ = check(p, oodac + " emit-bc fixtures/while_count.oo > " + work + "/while_count.bc", within: 20);
    let _ = check(p, oodac + " emit-bc fixtures/for_range.oo > " + work + "/for_range.bc", within: 20);
    let _ = check(p, oodac + " emit-bc fixtures/bc_arith_ops.oo > " + work + "/bc_arith_ops.bc", within: 20);
    let _ = check(p, oodac + " emit-bc fixtures/bc_unary_not.oo > " + work + "/bc_unary_not.bc", within: 20);
    let _ = expect_present(fs, work + "/chs_hello.bc");
    let _ = expect_present(fs, work + "/while_count.bc");
    let _ = expect_present(fs, work + "/for_range.bc");
    let _ = expect_present(fs, work + "/bc_arith_ops.bc");
    let _ = expect_present(fs, work + "/bc_unary_not.bc");

    // then: oodac run on the interpreter matches expected stdout
    let _ = check(p, oodac + " run fixtures/chs_hello.oo", within: 20);
    let _ = check(p, oodac + " run fixtures/while_count.oo", within: 20);
    let _ = check(p, oodac + " run fixtures/for_range.oo", within: 20);
    let _ = check(p, oodac + " run fixtures/bc_arith_ops.oo", within: 20);
    let _ = check(p, oodac + " run fixtures/bc_unary_not.oo", within: 20);
    let _ = expect_clean(p, oodac + " run fixtures/chs_hello.oo 2>&1 | tr -d '\\r' | grep -qx '1'");
    let _ = expect_clean(p, oodac + " run fixtures/while_count.oo 2>&1 | tr -d '\\r' | grep -qx '3'");
    let _ = expect_clean(p, oodac + " run fixtures/for_range.oo 2>&1 | tr -d '\\r' | grep -qx '10'");
    let _ = expect_clean(p, oodac + " run fixtures/bc_arith_ops.oo 2>&1 | tr -d '\\r' | grep -qx '4'");
    let _ = expect_clean(p, oodac + " run fixtures/bc_unary_not.oo 2>&1 | tr -d '\\r' | grep -qx '1'");

    println("bc_vm_smoke: PASSED (bytecode interpreter — not JIT)");
}
