// # ECAP Auto-Fix Smoke
//
// Logline: E_CAP bounded auto-fix turns a no_cap_fetch.oo into a NetCap-bound fetch(net,...) and clears E_CAP on re-check.
// Setup: oodac/oodac prebuilt; ooda_apply_ecap_fix.{sh,py}; corpus/no_cap_*.oo.
//
// Beats: before E_CAP | apply exits 0 | after no E_CAP + structural NetCap/fetch(net, | non-applicable parse fail-closed | product CLI fixes FsCap/read_file(fs,).

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "E_CAP bounded auto-fix floor");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo");
    expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_read_file.oo");
    expect_present(fs, root + "/bootstrap/corpus/parse/fail/missing_brace.oo");

    when "no_cap_fetch triggers E_CAP" {
    and  "apply turns fetch into NetCap/fetch(net," {
    and  "after check has no E_CAP" {
    and  "parse failure is not auto-fixed" {
    and  "product CLI adds FsCap + read_file(fs," {
    then "E_CAP auto-fix path green" {
    } } } } }

    let work: String = match sh_tempfile(p, "-d " + tmpd + " -t ecap_XXXXXX") { Ok(s) => s, Err(_) => tmpd + "/ecap_work" };
    let _ = sh_clean(p, work);
    let _ = sh_mkdir_p(fw, work);
    check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo " + work + "/fetch.oo", within: 5);
    expect_clean(p, "!" + oodac + " check " + work + "/fetch.oo --json-errors > " + work + "/before.json 2> " + work + "/before.err");
    expect_clean(p, "grep -q E_CAP " + work + "/before.json " + work + "/before.err 2>/dev/null");

    check(p, "bash " + root + "/scripts/ooda_apply_ecap_fix.sh " + work + "/fetch.oo > " + work + "/apply.out 2> " + work + "/apply.err", within: 30);
    expect_substring(fs, work + "/fetch.oo", "NetCap");
    expect_substring(fs, work + "/fetch.oo", "fetch(net,");

    check(p, oodac + " check " + work + "/fetch.oo --json-errors > " + work + "/after.json 2> " + work + "/after.err", within: 30);
    expect_clean(p, "! grep -q '\"code\": \"E_CAP\"' " + work + "/after.json");

    check(p, "cp " + root + "/bootstrap/corpus/parse/fail/missing_brace.oo " + work + "/parse.oo && ! bash " + root + "/scripts/ooda_apply_ecap_fix.sh " + work + "/parse.oo > " + work + "/na.out 2> " + work + "/na.err", within: 30);

    expect_quiet(p, "test -x " + ooda);
    check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_read_file.oo " + work + "/read.oo", within: 5);
    check(p, ooda + " fix " + work + "/read.oo > " + work + "/cli.out 2> " + work + "/cli.err", within: 60);
    expect_substring(fs, work + "/read.oo", "FsCap");
    expect_substring(fs, work + "/read.oo", "read_file(fs,");
    check(p, oodac + " check " + work + "/read.oo --json-errors > " + work + "/read_after.json 2> " + work + "/read_after.err", within: 30);
    expect_clean(p, "! grep -q '\"code\": \"E_CAP\"' " + work + "/read_after.json");

    let _ = sh_clean(p, work);
    println("ecap_autofix_smoke: PASSED");
}