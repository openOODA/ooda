// # ECAP Auto-Fix Smoke
//
// Logline: Live ooda fix --yes adds HttpCap or FsReadCap and clears E_CAP on re-check.
//
// Setup: oodac/oodac and a product ooda binary. No .sh and no .py apply path.
//
// Beats:
//   1. no_cap_fetch is E_CAP. ooda fix --yes writes HttpCap and fetch(http,.
//   2. Re-check is OK. A parse-fail file is not claimed fixed.
//   3. no_cap_read_file becomes FsReadCap and read_file(fsr,.

import "std/scenario.oo";
import "std/sh.oo";

fn pick_ooda(p: &ProcessCap, root: String) -> String {
    let envb = match sh_env_get_or(p, "OODA", "") { Ok(s) => s, Err(_) => "" };
    if envb != "" {
        if expect_quiet(p, "test -x " + envb).is_ok() { return envb; }
    }
    let n1 = "/tmp/ooda_cli_native";
    if expect_quiet(p, "test -x " + n1).is_ok() { return n1; }
    let n2 = "/tmp/ooda_cli";
    if expect_quiet(p, "test -x " + n2).is_ok() { return n2; }
    let bin = root + "/bin/ooda";
    if expect_quiet(p, "test -x " + bin).is_ok() { return bin; }
    return bin;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = match sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac") { Ok(s) => s, Err(_) => root + "/oodac/oodac" };
    let ooda = pick_ooda(p, root);
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "E_CAP live ooda fix");

    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }
    if expect_quiet(p, "test -x " + ooda).is_err() { println("FAIL no ooda"); process_exit(1); }
    if expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo").is_err() {
        println("FAIL missing no_cap_fetch"); process_exit(1);
    }
    if expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_read_file.oo").is_err() {
        println("FAIL missing no_cap_read_file"); process_exit(1);
    }
    if expect_present(fs, root + "/bootstrap/corpus/parse/fail/missing_brace.oo").is_err() {
        println("FAIL missing missing_brace"); process_exit(1);
    }

    let work = tmpd + "/ecap_work";
    let _ = sh_clean(fw, fs, work);
    if sh_mkdir_p(fw, work).is_err() { println("FAIL mkdir"); process_exit(1); }

    if check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo " + work + "/fetch.oo", within: 5).is_err() {
        println("FAIL copy fetch"); process_exit(1);
    }
    if expect_clean(p, "! " + oodac + " check " + work + "/fetch.oo > " + work + "/before.out 2> " + work + "/before.err").is_err() {
        println("FAIL fetch should not check clean"); process_exit(1);
    }
    if expect_clean(p, "grep -q capability " + work + "/before.out " + work + "/before.err").is_err() {
        println("FAIL fetch not E_CAP"); process_exit(1);
    }
    if check(p, "OODA_FS_WRITEDIR=" + root + " " + ooda + " fix " + work + "/fetch.oo --yes > " + work + "/apply.out 2> " + work + "/apply.err", within: 60).is_err() {
        println("FAIL ooda fix fetch"); process_exit(1);
    }
    if expect_substring(fs, work + "/fetch.oo", "HttpCap").is_err() {
        println("FAIL HttpCap missing"); process_exit(1);
    }
    if expect_substring(fs, work + "/fetch.oo", "fetch(http,").is_err() {
        println("FAIL fetch(http, missing"); process_exit(1);
    }
    if check(p, oodac + " check " + work + "/fetch.oo > " + work + "/after.out 2> " + work + "/after.err", within: 30).is_err() {
        println("FAIL fetch recheck"); process_exit(1);
    }
    if expect_clean(p, "grep -q '^OK' " + work + "/after.out").is_err() {
        println("FAIL fetch not OK after fix"); process_exit(1);
    }

    if check(p, "cp " + root + "/bootstrap/corpus/parse/fail/missing_brace.oo " + work + "/parse.oo", within: 5).is_err() {
        println("FAIL copy parse"); process_exit(1);
    }
    if expect_clean(p, "! " + ooda + " fix " + work + "/parse.oo --yes > " + work + "/na.out 2> " + work + "/na.err").is_err() {
        println("FAIL parse-fail should not apply"); process_exit(1);
    }

    if check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_read_file.oo " + work + "/read.oo", within: 5).is_err() {
        println("FAIL copy read"); process_exit(1);
    }
    if check(p, "OODA_FS_WRITEDIR=" + root + " " + ooda + " fix " + work + "/read.oo --yes > " + work + "/cli.out 2> " + work + "/cli.err", within: 60).is_err() {
        println("FAIL ooda fix read"); process_exit(1);
    }
    if expect_substring(fs, work + "/read.oo", "FsReadCap").is_err() {
        println("FAIL FsReadCap missing"); process_exit(1);
    }
    if expect_substring(fs, work + "/read.oo", "read_file(fsr,").is_err() {
        println("FAIL read_file(fsr, missing"); process_exit(1);
    }
    if check(p, oodac + " check " + work + "/read.oo > " + work + "/read_after.out 2> " + work + "/read_after.err", within: 30).is_err() {
        println("FAIL read recheck"); process_exit(1);
    }
    if expect_clean(p, "grep -q '^OK' " + work + "/read_after.out").is_err() {
        println("FAIL read not OK after fix"); process_exit(1);
    }

    let _ = sh_clean(fw, fs, work);
    println("ecap_autofix_smoke: PASSED");
}
