// # Tensor Path A Holds Flat
// Logline: std/math/tensor.oo uses flat List[Int]; runtime rebuild matches 7 9 0 6.
// Setup: oodac/oodac built; std/math/tensor.oo on disk; fixtures/tensor_path_a.oo present.
// Beats: 1. std/math/tensor.oo helpers + honesty | 2. fixture oodac check OK | 3. runtime flat tensor rebuild

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let std   = root + "/std/math/tensor.oo";
    let fix   = root + "/fixtures/tensor_path_a.oo";
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — std/math/tensor.oo helpers + honesty
    fails = fails + tally(expect_present(p, std),                                              "std/math/tensor.oo exists");
    fails = fails + tally(expect_quiet(p, "grep -q 'tensor_new' " + std),                      "helper tensor_new");
    fails = fails + tally(expect_quiet(p, "grep -q 'tensor_get' " + std),                      "helper tensor_get");
    fails = fails + tally(expect_quiet(p, "grep -q 'tensor_set' " + std),                      "helper tensor_set");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'flat|row-major|List\\[Int\\]' " + std),  "flat / row-major / List[Int]");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'residual|nested|List\\[List|ndarray' " + std), "residual honesty wording");

    // and — oodac check std + fixture
    fails = fails + tally(check(p, oodac + " check " + std + " 2>&1 | grep -qE '^OK'", 30),     "check std/math/tensor.oo");
    fails = fails + tally(check(p, oodac + " check " + fix + " 2>&1 | grep -qE '^OK'", 30),     "check tensor_path_a fixture");

    // then — emit-c lowers, runtime rebuild 7 9 0 6
    let cfile = tmpd + "/tens.c";
    let cbout = tmpd + "/tens.out";
    let _w1   = process_exec(p, oodac + " emit-c " + fix + " > " + cfile + " 2>" + tmpd + "/tens.err");
    let bin   = tmpd + "/tens.bin";
    let _w2   = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + cfile + " -o " + bin + " -lm -ldl -lpthread 2>" + tmpd + "/tens.gcc");
    let _w3   = process_exec(p, bin + " > " + cbout + " 2>&1 || true");
    fails     = fails + tally(expect_quiet(p, "tr '\\n' ' ' < " + cbout + " | grep -qE '7.*9.*0.*6'"), "runtime flat tensor get/set rebuild");

    if fails > 0 { println("tensor_path_a_smoke: FAILED"); process_exit(1); }
    println("tensor_path_a_smoke: PASSED");
}
