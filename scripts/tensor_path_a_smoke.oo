// # Tensor Path A Holds Flat
// Logline: std/math/tensor.oo uses flat List[Int]; runtime rebuild matches 7 9 0 6.
// Setup: oodac/oodac built; std/math/tensor.oo on disk; fixtures/tensor_path_a.oo present.
// Beats: 1. std/math/tensor.oo helpers + honesty | 2. fixture oodac check OK | 3. runtime flat tensor rebuild

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let std   = root + "/std/math/tensor.oo";
    let fix   = root + "/fixtures/tensor_path_a.oo";
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "tensor path A flat");

    // when — std/math/tensor.oo helpers + honesty
    let _ = expect_present(fs, std);
    let _ = expect_quiet(p, "grep -q 'tensor_new' " + std);
    let _ = expect_quiet(p, "grep -q 'tensor_get' " + std);
    let _ = expect_quiet(p, "grep -q 'tensor_set' " + std);
    let _ = expect_quiet(p, "grep -qiE 'flat|row-major|List\\[Int\\]' " + std);
    let _ = expect_quiet(p, "grep -qiE 'residual|nested|List\\[List|ndarray' " + std);

    // and — oodac check std + fixture
    let _ = check(p, oodac + " check " + std + " 2>&1 | grep -qE '^OK'", 30);
    let _ = check(p, oodac + " check " + fix + " 2>&1 | grep -qE '^OK'", 30);

    // then — emit-c lowers, runtime rebuild 7 9 0 6
    let cfile = tmpd + "/tens.c";
    let cbout = tmpd + "/tens.out";
    let _     = process_exec(p, oodac + " emit-c " + fix + " > " + cfile + " 2>" + tmpd + "/tens.err");
    let bin   = tmpd + "/tens.bin";
    let _     = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + cfile + " -o " + bin + " -lm -ldl -lpthread 2>" + tmpd + "/tens.gcc");
    let _     = process_exec(p, bin + " > " + cbout + " 2>&1 || true");
    let _     = expect_quiet(p, "tr '\\n' ' ' < " + cbout + " | grep -qE '7.*9.*0.*6'");

    println("tensor_path_a_smoke: PASSED");
}
