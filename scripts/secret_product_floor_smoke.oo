// ===================================================================
// Secret Product Floor Smoke
// ===================================================================
// job: Secret path A product floor (alpha)
// in:  oodac/oodac
// out: exit 0 if all sub-tests pass

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
    
    // Check oodac exists
    let oodac_exists = cmd_exec(p, "test -x " + oodac);
    if !oodac_exists.is_ok() {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    
    // Run sub-tests
    let sub_tests = [
        "secret_sink_enforce_smoke.sh",
        "secret_taint_residual_smoke.sh"
    ];
    
    for test in sub_tests {
        let test_path = root + "/scripts/" + test;
        let test_check = cmd_exec(p, "test -f " + test_path);
        
        if !test_check.is_ok() {
            println("SKIP missing " + test);
            continue;
        }
        
        let run_res = cmd_exec(p, "bash \"" + test_path + "\" 2>&1");
        if run_res.is_ok() {
            tr = test_assert(tr, "=== " + test + " ===", true);
        } else {
            tr = test_assert(tr, "FAIL " + test, false);
        }
    }
    
    // LLVM dual-path
    // Test secret_sink_fail refuses
    let llvm_fail_res = cmd_exec(p, oodac + " emit-llvm " + root + "/fixtures/secret_sink_fail.oo 2>&1");
    if !llvm_fail_res.is_ok() {
        let output = llvm_fail_res.unwrap();
        let check_err = cmd_exec(p, "echo \"" + output + "\" | grep -qE $'ERR\\tsecret'");
        tr = test_assert(tr, "llvm secret_sink_fail refuses", check_err.is_ok());
    } else {
        tr = test_assert(tr, "llvm secret_sink_fail", false);
    }
    
    // Test secret_sink_pass succeeds
    let llvm_pass_res = cmd_exec(p, oodac + " emit-llvm " + root + "/fixtures/secret_sink_pass.oo 2>&1");
    if llvm_pass_res.is_ok() {
        tr = test_assert(tr, "llvm secret_sink_pass", true);
    } else {
        tr = test_assert(tr, "llvm secret_sink_pass", false);
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("secret_product_floor_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
