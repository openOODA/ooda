// # Secret Product Floor Smoke
//
// Logline: Verify secret sink enforcement, taint tracking scripts, and emit-llvm secret sink rails.
//
// Setup: oodac compiler binary and secret test fixtures exist on disk.
//
// Beats:
//   1. Run secret sink enforcement and secret taint residual smoke scripts.
//   2. Run emit-llvm against secret_sink_fail fixture to verify compiler rejection.
//   3. Run emit-llvm against secret_sink_pass fixture to verify successful code generation.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = scenario(p, fs, "secret product floor");

    // when — sub-scripts run (Wave-1, kept on disk for CI)
    let _ = check(p, "bash " + root + "/scripts/secret_sink_enforce_smoke.sh >/dev/null 2>&1", 120);
    let _ = check(p, "bash " + root + "/scripts/secret_taint_residual_smoke.sh >/dev/null 2>&1", 60);

    // and — emit-llvm dual-path: fail refuses, pass OK
    let _ = expect_clean(p, "!" + oodac + " emit-llvm " + root + "/fixtures/secret_sink_fail.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    let _ = expect_quiet(p, oodac + " emit-llvm " + root + "/fixtures/secret_sink_pass.oo +\" 2>&1 | grep -qE '^OK'");

    println("secret_product_floor_smoke: PASSED");
}