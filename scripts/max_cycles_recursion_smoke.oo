// # Max Cycles Recursion Smoke
//
// Logline: M126 recursion — the shared static __oo_mc counter is debited at every call entry, not reset per fn.
// Beats: pass run | fail ERR | static shared counter | no per-fn reset | OO_MC_LIMIT macro.

import "std/scenario.oo";
import "std/sh.oo";

const PASS: String = "ooda/fixtures/max_cycles_recursion_pass.oo";
const FAIL: String = "ooda/fixtures/max_cycles_recursion_fail.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA_BIN", root + "/bin/ooda").unwrap_or("");
    let oodac = root + "/oodac/oodac";
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "max cycles recursion shared fuel");

    // when: pass recursion runs under budget
    let p_bin = root + "/.ooda-cache/ooda-tmp/mc_rec_pass.bin";
    let _ = process_exec(p, ooda + " build " + PASS + " -o " + p_bin + " >/dev/null 2>/dev/null");
    expect_clean(p, "timeout 5 " + p_bin + " 2>&1 | grep -qE 'OK|pass|under'");

    // and: fail recursion exits non-zero with ERR\tmax_cycles\texceeded
    let f_bin = root + "/.ooda-cache/ooda-tmp/mc_rec_fail.bin";
    let _ = process_exec(p, ooda + " build " + FAIL + " -o " + f_bin + " >/dev/null 2>/dev/null");
    expect_clean(p, "! timeout 5 " + f_bin + " 2>&1 | grep -qE 'ERR\tmax_cycles\texceeded|max_cycles'");

    // then: native emit uses static shared counter, no per-fn reset
    let raw = root + "/.ooda-cache/ooda-tmp/mc_raw.c";
    let _ = process_exec(p, oodac + " emit-c " + FAIL + " > " + raw + " 2>/dev/null");
    expect_substring(fs, raw, "static long long __oo_mc");
    expect_clean(p, "! grep -E '^[[:space:]]*long long __oo_mc = 0;' " + raw);
    expect_substring(fs, raw, "OO_MC_LIMIT");

    println("max_cycles_recursion_smoke: PASSED");
}
