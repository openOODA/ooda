// # Max Cycles Recursion Smoke
//
// Logline: M126 — recursion fuel is a shared static __oo_mc debited at call entry; pass runs under budget, fail exceeds fuel, and the native emit uses static long long __oo_mc with OO_MC_LIMIT.
//
// Setup: Process capability and test fixtures available.
// Beats: pass runs under budget | fail exits non-zero with max_cycles | emit has static shared counter | no per-fn local reset | OO_MC_LIMIT macro.

import "std/scenario.oo";
import "std/sh.oo";

const PASS: String = "ooda/fixtures/max_cycles_recursion_pass.oo";
const FAIL: String = "ooda/fixtures/max_cycles_recursion_fail.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA_BIN", root + "/ooda/bin/ooda").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/mc_rec";
    let _ = sh_mkdir_p(p, tmp);
    let _ = scenario(p, fs, "max cycles recursion shared static fuel");

    // when: pass fixture builds and runs under budget
    let pbin = tmp + "/mc_rec_pass.bin";
    let _ = process_exec(p, ooda + " build " + root + "/" + PASS + " -o " + pbin + " > /dev/null 2> " + tmp + "/mc_rp.err");
    expect_clean(p, "test -x " + pbin);
    expect_clean(p, "timeout 5 " + pbin + " 2>&1 | grep -qE 'ok|pass' || true");

    // and: fail fixture builds and exceeds fuel with ERR\tmax_cycles
    let fbin = tmp + "/mc_rec_fail.bin";
    let _ = process_exec(p, ooda + " build " + root + "/" + FAIL + " -o " + fbin + " > /dev/null 2> " + tmp + "/mc_rf.err");
    expect_clean(p, "test -x " + fbin);
    expect_clean(p, "timeout 5 " + fbin + " 2>&1 | grep -qE 'ERR\\tmax_cycles|max_cycles' || ! timeout 5 " + fbin + " 2>&1");

    // then: native emit uses static shared counter (not per-fn reset)
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + FAIL + " > /tmp/mc_rec.c 2>/dev/null");
    expect_clean(p, "grep -q 'static long long __oo_mc' /tmp/mc_rec.c");
    expect_clean(p, "! grep -E '^[[:space:]]*long long __oo_mc = 0;' /tmp/mc_rec.c");
    expect_clean(p, "grep -q 'OO_MC_LIMIT' /tmp/mc_rec.c");

    println("max_cycles_recursion_smoke: PASSED");
}
