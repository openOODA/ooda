// # OODA Patch
//
// Logline: product ooda patch — structured replace_fn only, never shell-evals the patch body; dispatches to ooda_patch.py.
//
// Setup: Process capability and test fixtures available.
// Beats: resolve oodac | confirm python script | forward args to python3.

import "std/scenario.oo";
import "std/sh.oo";

const PY: String = "ooda/scripts/ooda_patch.py";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "ooda patch dispatcher");

    // when: oodac resolves and the python dispatcher exists
    expect_clean(p, "test -f " + root + "/" + PY);
    expect_quiet(p, "test -x " + oodac + " || test -x ./oodac/oodac || test -x oodac/oodac");

    // then: forward all args to python3 (no shell-eval)
    let _ = check(p, "python3 " + root + "/" + PY + " \"$@\"", within: 60);
    println("ooda_patch: PASSED");
}
