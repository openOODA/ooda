// # OODA Patch Honesty
//
// Logline: Product patch is cli/patch_drive.oo. There is no ooda_patch.py hop.
//
// Setup: ProcessCap and FsReadCap. Cwd is the ooda product root.
//
// Beats:
//   1. cli/patch_drive.oo holds run_ooda_patch and --replace-fn.
//   2. scripts/ooda_patch.py is absent.
//   3. This file does not exec python3.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "ooda patch honesty");
    if expect_present(fs, "cli/patch_drive.oo").is_err() {
        println("FAIL missing cli/patch_drive.oo");
        process_exit(1);
    }
    if expect_substring(fs, "cli/patch_drive.oo", "run_ooda_patch").is_err() {
        println("FAIL run_ooda_patch missing");
        process_exit(1);
    }
    if expect_substring(fs, "cli/patch_drive.oo", "--replace-fn").is_err() {
        println("FAIL --replace-fn missing");
        process_exit(1);
    }
    if expect_absent(fs, "scripts/ooda_patch.py").is_err() {
        println("FAIL leftover scripts/ooda_patch.py");
        process_exit(1);
    }
    println("ooda_patch: PASSED");
}
