// # sh_arg_ok Gates Shell Metacharacters
//
// Logline: sh_arg_ok accepts a simple relative path and rejects semicolon, and-and, and command-substitution payloads.
//
// Setup: std/sh.oo exports pub fn sh_arg_ok(s: String) -> Bool.
//
// Beats:
//   1. Accept tmp/foo.
//   2. Reject foo; rm -rf /.
//   3. Reject foo && bar and $(id).

import "std/sh.oo";
import "std/test.oo";
import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    let _cap: &ProcessCap = p;

    // when a relative path has no metacharacters
    tr = test_assert(tr, "tmp/foo is ok", sh_arg_ok("tmp/foo"));

    // and a semicolon chain is rejected
    tr = test_assert(tr, "semicolon injection is not ok", !sh_arg_ok("foo; rm -rf /"));

    // and a conjunctive chain is rejected
    tr = test_assert(tr, "and-and injection is not ok", !sh_arg_ok("foo && bar"));

    // then command substitution is rejected
    tr = test_assert(tr, "command substitution is not ok", !sh_arg_ok("$(id)"));

    test_summary(tr);
    let failed = tr.failed;
    if failed > 0 {
        process_exit(1);
    }
    println("sh_arg_ok_smoke: PASSED");
}
