// # OODA Apply Fix CLI Honesty
//
// Logline: Product CLI apply is cli/fix_drive.oo run_ooda_fix with --yes; this file does not reimplement apply.
//
// Setup: ProcessCap and FsReadCap are injected. Cwd is the ooda product root.
//
// Beats:
//   1. Prove cli/fix_drive.oo is present.
//   2. Prove that file holds run_ooda_fix and --yes.
//   3. Prove scripts/ooda_apply_fix.py is absent.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let drive = "cli/fix_drive.oo";
    let _ = scenario(p, fs, "ooda apply fix cli honesty");

    if expect_present(fs, drive).is_err() {
        println("FAIL missing cli/fix_drive.oo");
        process_exit(1);
    }
    if expect_substring(fs, drive, "run_ooda_fix").is_err() {
        println("FAIL run_ooda_fix missing in cli/fix_drive.oo");
        process_exit(1);
    }
    if expect_substring(fs, drive, "--yes").is_err() {
        println("FAIL --yes missing in cli/fix_drive.oo");
        process_exit(1);
    }
    if expect_absent(fs, "scripts/ooda_apply_fix.py").is_err() {
        println("FAIL leftover scripts/ooda_apply_fix.py");
        process_exit(1);
    }
    println("PASSED");
}
