// # emit-x86 real greet call lock
//
// Logline: emit-x86 of fixtures/x86_greet_call.oo calls greet and prints Hello, World! via as and ld.
//
// Setup: cwd is ooda/. GNU as and ld are on PATH. Host is x86_64. Product oodac/oodac.
//
// Beats:
//   1. emit-x86 writes lea %rdi, call greet, bump copy, and is not C.
//   2. as --64 and ld produce a binary whose stdout is Hello, World!.
//   3. hello.oo fold still has no call greet. Repeat the greet run twice.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_greet_call_" + tag + ".s";
    let serr = tmpd + "/x86_greet_call_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail("emit-x86 " + tag); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_clean(p, "grep -q 'call greet' " + sfile).is_err() { fail("no call greet " + tag); }
    if expect_clean(p, "grep -q '%rdi' " + sfile).is_err() { fail("no rdi " + tag); }
    if expect_clean(p, "grep -q '.skip 4096' " + sfile).is_err() { fail("no skip 4096 " + tag); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(".s looks like emit-c " + tag);
    }
    let obj = tmpd + "/x86_greet_call_" + tag + ".o";
    let bin = tmpd + "/x86_greet_call_" + tag + ".bin";
    let out = tmpd + "/x86_greet_call_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    if expect_clean(p, "grep -qx 'Hello, World!' " + out).is_err() { fail("stdout not greet " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 greet real call").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_greet_call.oo";
    if expect_present(fs, src).is_err() { fail("no x86_greet_call.oo"); }
    emit_as_ld(p, fs, oodac, src, tmpd, "r1");
    emit_as_ld(p, fs, oodac, src, tmpd, "r2");
    let hello = root + "/fixtures/hello.oo";
    if expect_present(fs, hello).is_err() { fail("no hello.oo"); }
    let hs = tmpd + "/x86_hello_fold.s";
    let he = tmpd + "/x86_hello_fold.err";
    if check(p, oodac + " emit-x86 " + hello + " > " + hs + " 2>" + he, 30).is_err() { fail("hello emit"); }
    if expect_clean(p, "! grep -q 'call greet' " + hs).is_err() { fail("hello fold loosened"); }
    if expect_substring(fs, hs, "Hello, openOODA Developer!").is_err() { fail("hello fold missed"); }
    println("x86_greet_call_smoke: PASSED");
}
