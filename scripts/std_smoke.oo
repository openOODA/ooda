// ===================================================================
// Std Smoke Test
// ===================================================================
// job: pure std modules check + multi-build fixtures
// in:  oodac, std/, fixtures/std_*_main.oo
// out: exit 0 if std is real on pure path

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_oodac(p, root);
    let tmp = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    
    if str_len(oodac) == 0 {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    
    let mkdir_res = cmd_exec(p, "mkdir -p " + tmp);
    if !mkdir_res.is_ok() {
        println("Cannot create tmp dir");
        process_exit(1);
    }
    
    // Check pure std modules
    let modules = list_new();
    modules = list_push(modules, "result.oo");
    modules = list_push(modules, "str.oo");
    modules = list_push(modules, "option.oo");
    
    let mut i = 0;
    while i < list_len(modules) {
        let m = list_get(modules, i);
        let out_file = tmp + "/std_ck_" + m + ".out";
        let err_file = tmp + "/std_ck_" + m + ".err";
        
        let check_res = cmd_exec(p, oodac + " check " + root + "/std/" + m + " >" + out_file + " 2>" + err_file);
        if check_res.is_ok() {
            println("OK check std/" + m);
            tr = test_assert(tr, "check std/" + m, true);
        } else {
            println("FAIL check std/" + m);
            tr = test_assert(tr, "check std/" + m, false);
        }
        i = i + 1;
    }
    
    // Build and run fixtures
    let fixtures = list_new();
    fixtures = list_push(fixtures, "std_result_main.oo");
    fixtures = list_push(fixtures, "std_str_main.oo");
    fixtures = list_push(fixtures, "std_option_main.oo");
    
    let mut j = 0;
    while j < list_len(fixtures) {
        let f = list_get(fixtures, j);
        let bin_name = str_replace(f, ".oo", "");
        let bin_path = tmp + "/" + bin_name;
        let out_file = tmp + "/std_b_" + f + ".out";
        let err_file = tmp + "/std_b_" + f + ".err";
        let run_out = tmp + "/std_r_" + f + ".out";
        let run_err = tmp + "/std_r_" + f + ".err";
        
        // Build
        let build_res = cmd_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/" + f + " " + bin_path + " >" + out_file + " 2>" + err_file);
        
        if !build_res.is_ok() {
            println("FAIL build fixtures/" + f);
            tr = test_assert(tr, "build fixtures/" + f, false);
        } else {
            let check_exec = cmd_exec(p, "test -x " + bin_path);
            if !check_exec.is_ok() {
                println("FAIL build fixtures/" + f + " (not executable)");
                tr = test_assert(tr, "build fixtures/" + f + " executable", false);
            } else {
                // Run
                let run_res = cmd_exec(p, bin_path + " >" + run_out + " 2>" + run_err);
                if run_res.is_ok() {
                    println("OK build+run fixtures/" + f);
                    tr = test_assert(tr, "build+run fixtures/" + f, true);
                } else {
                    println("FAIL run fixtures/" + f);
                    tr = test_assert(tr, "run fixtures/" + f, false);
                }
            }
        }
        j = j + 1;
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        println("std_smoke: FAILED");
        process_exit(1);
    }
    
    println("std_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_oodac(p: &ProcessCap, root: String) -> String {
    let env_val = get_env(p, "OODAC_BIN", "");
    if str_len(env_val) > 0 {
        return env_val;
    }
    return root + "/oodac/oodac";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
