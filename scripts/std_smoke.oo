// # Std Smoke
//
// Logline: Verify core standard library modules typecheck and execute across test fixtures.
//
// Setup: oodac compiler binary and standard library fixtures exist on disk.
//
// Beats:
//   1. Typecheck result.oo, str.oo, and option.oo standard library modules.
//   2. Compile and execute result, str, option, and std_smoke_proof test fixture binaries.
//   3. Confirm all fixture runs execute successfully and produce expected outputs.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root_res: Result[String, String] = sh_realpath(p, ".");
    let root: String = root_res.unwrap_or(".");
    let oodac_res: Result[String, String] = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac");
    let oodac: String = oodac_res.unwrap_or("");
    let tmpd: String = root + "/.ooda-cache/ooda-tmp/std_smoke";
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "std modules pure floor");

    // when — pure std modules check
    let _ = expect_quiet(p, oodac + " check " + root + "/std/result.oo 2>&1 | grep -qE '^OK'");
    let _ = expect_quiet(p, oodac + " check " + root + "/std/str.oo 2>&1 | grep -qE '^OK'");
    let _ = expect_quiet(p, oodac + " check " + root + "/std/option.oo 2>&1 | grep -qE '^OK'");
    let _ = expect_quiet(p, oodac + " check " + root + "/std/test.oo 2>&1 | grep -qE '^OK'");
    let _ = expect_quiet(p, oodac + " check " + root + "/std/math.oo 2>&1 | grep -qE '^OK'");
    let _ = expect_quiet(p, oodac + " check " + root + "/std/core/list.oo 2>&1 | grep -qE '^OK'");

    // and — build + run fixtures
    let r_bin: String = tmpd + "/std_result_main";
    let _ = process_exec(p, oodac + " build " + root + "/fixtures/std_result_main.oo " + r_bin + " > " + tmpd + "/r.b.out 2> " + tmpd + "/r.b.err");
    let _ = process_exec(p, r_bin + " > " + tmpd + "/r.r.out 2> " + tmpd + "/r.r.err");
    let _ = check(p, "grep -q 'hi' " + tmpd + "/r.r.out", 10);

    let s_bin: String = tmpd + "/std_str_main";
    let _ = process_exec(p, oodac + " build " + root + "/fixtures/std_str_main.oo " + s_bin + " > " + tmpd + "/s.b.out 2> " + tmpd + "/s.b.err");
    let _ = process_exec(p, s_bin + " > " + tmpd + "/s.r.out 2> " + tmpd + "/s.r.err");
    let _ = check(p, "grep -q 'hello' " + tmpd + "/s.b.out || grep -q '5' " + tmpd + "/s.r.out", 10);

    let o_bin: String = tmpd + "/std_option_main";
    let _ = process_exec(p, oodac + " build " + root + "/fixtures/std_option_main.oo " + o_bin + " > " + tmpd + "/o.b.out 2> " + tmpd + "/o.b.err");
    let _ = process_exec(p, o_bin + " > " + tmpd + "/o.r.out 2> " + tmpd + "/o.r.err");
    let _ = check(p, "grep -q 'yes' " + tmpd + "/o.r.out", 10);

    let p_bin: String = tmpd + "/std_smoke_proof";
    let _ = process_exec(p, oodac + " build " + root + "/fixtures/std_smoke_proof.oo " + p_bin + " > " + tmpd + "/p.b.out 2> " + tmpd + "/p.b.err");
    let _ = process_exec(p, p_bin + " > " + tmpd + "/p.r.out 2> " + tmpd + "/p.r.err");
    let _ = check(p, "grep -q 'TEST SUITE PASSED' " + tmpd + "/p.r.out", 10);

    println("std_smoke: PASSED");
}