// # Std Smoke
// Logline: pure std modules check + multi-build fixtures — result/str/option pure floor.
import "std/scenario.oo";
import "std/sh.oo";

const TMP: String = ".ooda-cache/ooda-tmp/std_smoke";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, root + "/" + TMP);
    let _     = scenario(p, fs, "std modules pure floor");

    // when — pure std modules check
    for m in ["result.oo", "str.oo", "option.oo"] {
        let _ = expect_quiet(p, oodac + " check " + root + "/std/" + m + " +\" 2>&1 | grep -qE '^OK'");
    }

    // and — build + run fixtures
    for f in ["std_result_main.oo", "std_str_main.oo", "std_option_main.oo"] {
        let bin = root + "/" + TMP + "/" + str_replace(f, ".oo", "");
        let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/" + f + " " + bin + " > " + root + "/" + TMP + "/" + f + ".b.out 2> " + root + "/" + TMP + "/" + f + ".b.err");
        let _ = process_exec(p, bin + " > " + root + "/" + TMP + "/" + f + ".r.out 2> " + root + "/" + TMP + "/" + f + ".r.err");
    }

    println("std_smoke: PASSED");
}