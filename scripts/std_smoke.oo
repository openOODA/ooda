// # Std Smoke
//
// Logline: Verify core standard library modules typecheck and execute across test fixtures.
//
// Setup: oodac compiler binary and standard library fixtures exist on disk.
//
// Beats:
//   1. Typecheck result.oo, str.oo, and option.oo standard library modules.
//   2. Compile and execute result, str, and option test fixture binaries.
//   3. Confirm all fixture runs execute successfully and produce expected outputs.
import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, root + "/" + ".ooda-cache/ooda-tmp/std_smoke");
    let _     = scenario(p, fs, "std modules pure floor");

    // when — pure std modules check
    for m in ["result.oo", "str.oo", "option.oo"] {
        let _ = expect_quiet(p, oodac + " check " + root + "/std/" + m + " +\" 2>&1 | grep -qE '^OK'");
    }

    // and — build + run fixtures
    for f in ["std_result_main.oo", "std_str_main.oo", "std_option_main.oo"] {
        let bin = root + "/" + ".ooda-cache/ooda-tmp/std_smoke" + "/" + str_replace(f, ".oo", "");
        let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/" + f + " " + bin + " > " + root + "/" + ".ooda-cache/ooda-tmp/std_smoke" + "/" + f + ".b.out 2> " + root + "/" + ".ooda-cache/ooda-tmp/std_smoke" + "/" + f + ".b.err");
        let _ = process_exec(p, bin + " > " + root + "/" + ".ooda-cache/ooda-tmp/std_smoke" + "/" + f + ".r.out 2> " + root + "/" + ".ooda-cache/ooda-tmp/std_smoke" + "/" + f + ".r.err");
    }

    println("std_smoke: PASSED");
}