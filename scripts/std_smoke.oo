// # Std Smoke
//
// Logline: Verify core standard library modules typecheck and execute across test fixtures.
//
// Setup: oodac compiler binary and standard library fixtures exist on disk.
//
// Beats:
//   1. Typecheck result.oo, str.oo, and option.oo standard library modules.
//   2. Compile and execute result, str, option, and std_smoke_proof test fixture binaries.
//   3. Confirm all fixture runs execute successfully and produce expected outputs.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let oodac: String = "./oodac/oodac";
    let tmpd: String = ".ooda-cache/ooda-tmp/std_smoke";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { process_exit(1); }
    if scenario(p, fs, "std modules pure floor").is_err() { process_exit(1); }

    // when — pure std modules check
    if expect_quiet(p, oodac + " check std/result.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }
    if expect_quiet(p, oodac + " check std/str.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }
    if expect_quiet(p, oodac + " check std/option.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }
    if expect_quiet(p, oodac + " check std/test.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }
    if expect_quiet(p, oodac + " check std/math.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }
    if expect_quiet(p, oodac + " check std/core/list.oo 2>&1 | grep -qE '^OK'").is_err() { process_exit(1); }

    // and — build + run fixtures
    let r_bin: String = tmpd + "/std_result_main";
    if process_exec(p, oodac + " build fixtures/std_result_main.oo " + r_bin + " > " + tmpd + "/r.b.out 2> " + tmpd + "/r.b.err").is_err() { process_exit(1); }
    if process_exec(p, r_bin + " > " + tmpd + "/r.r.out 2> " + tmpd + "/r.r.err").is_err() { process_exit(1); }
    if check(p, "grep -q 'hi' " + tmpd + "/r.r.out", 10).is_err() { process_exit(1); }

    let s_bin: String = tmpd + "/std_str_main";
    if process_exec(p, oodac + " build fixtures/std_str_main.oo " + s_bin + " > " + tmpd + "/s.b.out 2> " + tmpd + "/s.b.err").is_err() { process_exit(1); }
    if process_exec(p, s_bin + " > " + tmpd + "/s.r.out 2> " + tmpd + "/s.r.err").is_err() { process_exit(1); }
    if check(p, "grep -q 'hello' " + tmpd + "/s.b.out || grep -q '5' " + tmpd + "/s.r.out", 10).is_err() { process_exit(1); }

    let o_bin: String = tmpd + "/std_option_main";
    if process_exec(p, oodac + " build fixtures/std_option_main.oo " + o_bin + " > " + tmpd + "/o.b.out 2> " + tmpd + "/o.b.err").is_err() { process_exit(1); }
    if process_exec(p, o_bin + " > " + tmpd + "/o.r.out 2> " + tmpd + "/o.r.err").is_err() { process_exit(1); }
    if check(p, "grep -q 'yes' " + tmpd + "/o.r.out", 10).is_err() { process_exit(1); }

    let p_bin: String = tmpd + "/std_smoke_proof";
    if process_exec(p, oodac + " build fixtures/std_smoke_proof.oo " + p_bin + " > " + tmpd + "/p.b.out 2> " + tmpd + "/p.b.err").is_err() { process_exit(1); }
    if process_exec(p, p_bin + " > " + tmpd + "/p.r.out 2> " + tmpd + "/p.r.err").is_err() { process_exit(1); }
    if check(p, "grep -q 'TEST SUITE PASSED' " + tmpd + "/p.r.out", 10).is_err() { process_exit(1); }

    println("std_smoke: PASSED");
}