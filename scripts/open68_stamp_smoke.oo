// # OPEN-68 stamp-walk lock
//
// Logline: Side LLVM-linked oodac stamp-walks hello twice and refuses OK when hello is no longer the same file.
//
// Setup: cwd is ooda/. Proof ELF is .ooda-cache/ooda-tmp/oodac_stamp.
//
// Beats:
//   1. Source has no listing_fresh stub and no shim cap re-grant.
//   2. ELF check fixtures/hello.oo prints OK twice.
//   3. An invalid hello must not print OK. Restore the fixture.
// residual: C emit plus gcc remains the product path. Not gcc-parity.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let elf = tmpd + "/oodac_stamp";
    if process_exec(p, "test -x " + elf).is_err() { fail("no side proof oodac_stamp"); }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if !path_exists(fs, "oodac/check_hash.oo") { fail("no check_hash"); }
    if process_exec(p, "grep -q llvm_emit_listing_fresh_stub oodac/llvm_emit_fn.oo").is_ok() {
        fail("stub hook still in llvm_emit_fn");
    }
    if process_exec(p, "grep -q 'ret i32 1' oodac/llvm_link_shim.oo").is_ok() {
        fail("stub still in shim");
    }
    if process_exec(p, "grep -q oo_cap_grant_sys oodac/llvm_link_shim.oo").is_ok() {
        fail("shim still grants sys");
    }
    if process_exec(p, "grep -F -q '(...)' oodac/llvm_fntab.oo").is_ok() {
        fail("fntab still emits variadic declare");
    }
    if process_exec(p, "grep -q byte_at oodac/check_hash.oo").is_err() {
        fail("stamp walk gutted");
    }

    let helper = tmpd + "/oodac_stamp_gcc";
    if process_exec(p, "test -x " + helper).is_ok() {
        let _plant = process_exec(p, "timeout 30 " + helper + " check fixtures/hello.oo >/dev/null");
    }
    if process_exec(p, "timeout 20 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'").is_err() {
        fail("linked check hello");
    }
    if process_exec(p, "timeout 20 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'").is_err() {
        fail("linked check hello 2");
    }

    let bak = tmpd + "/hello_stamp.bak";
    if process_exec(p, "cp fixtures/hello.oo " + bak).is_err() { fail("bak"); }
    if process_exec(p, "printf '\\nfn bad() { let x: Int = \"no\"; }\\n' >> fixtures/hello.oo").is_err() {
        let _r1 = process_exec(p, "cp " + bak + " fixtures/hello.oo");
        fail("mutate hello");
    }
    let stale_ok = process_exec(p, "timeout 20 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'");
    if process_exec(p, "cp " + bak + " fixtures/hello.oo").is_err() { fail("restore hello"); }
    if stale_ok.is_ok() { fail("changed hello still OK"); }

    println("open68_stamp_smoke: linked stamp-walk hello OK twice");
    println("open68_stamp_smoke: C emit plus gcc remains product");
    println("open68_stamp_smoke: PASSED");
}
