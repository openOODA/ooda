// # LLVM Smoke Residual Smoke
//
// Logline: bootstrap/LLVM_SMOKE.oot carries the LLVM_SMOKE_RESIDUAL_ALPHA marker, a fail-closed residual sentence, and ci_product wires this script.
//
// Setup: Process capability and test fixtures available.
// Beats: doc marker | fail-closed wording | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "llvm smoke residual honesty");

    // when: doc carries the residual marker + fail-closed wording
    expect_present(fs, "ooda/bootstrap/LLVM_SMOKE.oot");
    expect_substring(fs, "ooda/bootstrap/LLVM_SMOKE.oot", "LLVM_SMOKE_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'not.*production floor|smoke depth|Fail-closed residual|fail-closed residual' " + root + "/" + "ooda/bootstrap/LLVM_SMOKE.oot");

    // then: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "llvm_smoke_residual_smoke");

    println("llvm_smoke_residual_smoke: PASSED");
}
