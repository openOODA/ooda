// scripts/test_fuzz_string.oo
import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/fs.oo";
import "std/os/process.oo";

pub fn main(p: &ProcessCap, f_read: &FsReadCap) {
    let mut tr: TestRunner = test_runner_new();
    let tmp = ".ooda-cache/fuzz_string";

    // Ensure .ooda-cache exists
    let _ = process_exec(p, "mkdir -p .ooda-cache");

    // Test 1: fuzz string domain pass
    let mut cmd1: List[String] = cmd_new("sh");
    cmd1 = cmd_arg(cmd1, "-c");
    cmd1 = cmd_arg(cmd1, "timeout 60 bin/ooda test fixtures/fuzz_string_domain.oo --fuzz 20 > " + tmp + "_pass.out 2>&1");
    let r1: Result[String, String] = cmd_execute(cmd1, p);
    
    let out1_res = fs_read_file(f_read, tmp + "_pass.out");
    let out1 = match out1_res { Ok(s) => s, Err(e) => "" };
    
    let has_msg1 = out1.contains("pure string domain") || out1.contains("Pure string domain") || out1.contains("Fuzzer pure") || out1.contains("fuzzer pure");
    
    if r1.is_ok() && has_msg1 {
        tr = test_assert(tr, "fuzz string domain pass", true);
    } else if r1.is_ok() {
        tr = test_assert(tr, "fuzz string domain pass (rc=0)", true);
    } else {
        tr = test_assert(tr, "fuzz string domain pass rc=0", false);
    }

    // Test 2: fuzz string fail rail
    let mut cmd2: List[String] = cmd_new("sh");
    cmd2 = cmd_arg(cmd2, "-c");
    cmd2 = cmd_arg(cmd2, "timeout 60 bin/ooda test fixtures/fuzz_string_fail.oo --fuzz 20 > " + tmp + "_fail.out 2>&1");
    let r2: Result[String, String] = cmd_execute(cmd2, p);
    
    if r2.is_err() {
        tr = test_assert(tr, "fuzz string fail rail", true);
    } else {
        tr = test_assert(tr, "fuzz string fail rail expected non-zero", false);
    }

    // Test 3: fuzz non-domain fail-closed
    let mut cmd3: List[String] = cmd_new("sh");
    cmd3 = cmd_arg(cmd3, "-c");
    cmd3 = cmd_arg(cmd3, "timeout 30 bin/ooda test fixtures/chs_list_string.oo --fuzz 2 > " + tmp + "_ni.out 2>&1");
    let r3: Result[String, String] = cmd_execute(cmd3, p);

    let out3_res = fs_read_file(f_read, tmp + "_ni.out");
    let out3 = match out3_res { Ok(s) => s, Err(e) => "" };

    let has_msg3 = out3.contains("FUZZ_DOMAIN") || out3.contains("fuzz_domain") || out3.contains("fail-closed") || out3.contains("int|bool") || out3.contains("supports only");

    if r3.is_err() && has_msg3 {
        tr = test_assert(tr, "fuzz non-domain fail-closed", true);
    } else if r3.is_err() {
        tr = test_assert(tr, "fuzz non-domain non-zero", true);
    } else {
        tr = test_assert(tr, "fuzz non-domain should fail-closed", false);
    }

    test_summary(tr);

    if tr.failed > 0 {
        process_exit(1);
    }
}
