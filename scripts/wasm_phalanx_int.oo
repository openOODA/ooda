// # Wasm Phalanx Integration
//
// Logline: emit-wasm of hello holds magic and matches itself; print-hi must be a WASI Hello module or the bar is not proved.
//
// Setup: cwd is ooda/. oodac/oodac exists. fixtures/hello.oo exists. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/hello.oo writes a module whose first bytes are 00 61 73 6d.
//   2. emit-wasm fixtures/wasm_print_hi.oo requires magic and a WASI Hello body; missing or dummy fails closed.
//   3. Two emit-wasm of hello are byte-identical under cmp.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm phalanx int").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }

    let hello = "fixtures/hello.oo";
    if expect_present(fs, hello).is_err() { println("FAIL no hello"); process_exit(1); }
    let ha = tmpd + "/int_hello_a.wasm";
    let hb = tmpd + "/int_hello_b.wasm";
    if process_exec(p, oodac + " emit-wasm " + hello + " > " + ha + " 2>" + tmpd + "/int_hello_a.err").is_err() {
        println("FAIL emit-wasm hello");
        process_exit(1);
    }
    if expect_present(fs, ha).is_err() { println("FAIL no hello wasm"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N4 " + ha + " | grep -q '00 61 73 6d'").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    println("INT hello-magic: PASS");

    if process_exec(p, oodac + " emit-wasm " + hello + " > " + hb + " 2>" + tmpd + "/int_hello_b.err").is_err() {
        println("FAIL emit-wasm hello b");
        process_exit(1);
    }
    if expect_quiet(p, "cmp -s " + ha + " " + hb).is_err() {
        println("FAIL not identical");
        process_exit(1);
    }
    println("INT hello-cmp: PASS");

    let hi_src = "fixtures/wasm_print_hi.oo";
    if expect_present(fs, hi_src).is_err() {
        println("INT: NOT PROVED");
        process_exit(1);
    }
    let hi = tmpd + "/int_print_hi.wasm";
    let hi_out = tmpd + "/int_print_hi.out";
    if process_exec(p, oodac + " emit-wasm " + hi_src + " > " + hi + " 2>" + tmpd + "/int_print_hi.err").is_err() {
        println("FAIL emit-wasm print-hi");
        process_exit(1);
    }
    if expect_present(fs, hi).is_err() { println("FAIL no print-hi wasm"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N4 " + hi + " | grep -q '00 61 73 6d'").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        require_hello(p, home_wt, hi, hi_out);
    } else if sh_which(p, "wasmtime").is_ok() {
        require_hello(p, "wasmtime", hi, hi_out);
    }
    if expect_quiet(p, "grep -aq fd_write " + hi).is_err() {
        println("INT: NOT PROVED");
        process_exit(1);
    }
    if expect_quiet(p, "grep -aq wasi_snapshot_preview1 " + hi).is_err() {
        println("INT: NOT PROVED");
        process_exit(1);
    }
    if expect_quiet(p, "od -An -tx1 " + hi + " | tr -s ' \\n' ' ' | grep -q '0a 04 01 02 00 0b'").is_ok() {
        println("INT: NOT PROVED");
        process_exit(1);
    }
    println("INT print-hi: PASS");
    println("wasm_phalanx_int: PASSED");
}

fn require_hello(p: &ProcessCap, wt: String, wasm: String, out: String) {
    if check(p, wt + " " + wasm + " > " + out, 15).is_err() {
        println("FAIL wasmtime");
        process_exit(1);
    }
    if expect_quiet(p, "grep -q Hello " + out).is_err() {
        println("INT: NOT PROVED");
        process_exit(1);
    }
}
