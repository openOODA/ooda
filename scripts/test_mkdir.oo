// # Mkdir mock workspace
//
// Logline: Create the PM mock directory under FsWriteCap and print OK or ERR.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Call fs_mkdir on the mock path.
//   2. Print ERR and the message on failure.
//   3. Print OK on success.

import "std/os/fs.oo";
pub fn main(fsR: &FsReadCap, fsW: &FsWriteCap) {
    let r = fs_mkdir(fsW, "/home/jeryd/Projects/openOODA/ooda/test_pm_mock_dir");
    if r.is_err() {
        println("ERR: " + r.unwrap_err());
    } else {
        println("OK");
    }
}
