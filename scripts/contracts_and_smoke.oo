// ===================================================================
// Contracts And Smoke
// ===================================================================
// job: Simple && contracts product floor (Phase 1) — runtime pass/fail
// in:  oodac/oodac
// out: exit 0 if all contract tests pass

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
    let tmpdir = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    
    // Check oodac exists
    let oodac_exists = cmd_exec(p, "test -x " + oodac);
    if !oodac_exists.is_ok() {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    
    // Setup temp dir
    let mkdir_res = cmd_exec(p, "mkdir -p " + tmpdir);
    if !mkdir_res.is_ok() {
        println("FAIL: cannot create temp dir " + tmpdir);
        process_exit(1);
    }
    
    // Pass: && requires/ensures
    let cand_pass = tmpdir + "/cand_pass";
    let build_pass_res = cmd_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/complex_contract_pass.oo " + cand_pass + " >" + tmpdir + "/cand_b.out 2>" + tmpdir + "/cand_b.err");
    
    if build_pass_res.is_ok() && cmd_exec(p, "test -x " + cand_pass).is_ok() {
        let run_res = cmd_exec(p, cand_pass + " 2>&1");
        if run_res.is_ok() {
            let output = run_res.unwrap();
            if str_contains(output, "7") {
                tr = test_assert(tr, "&& contract pass runs (7)", true);
            } else {
                tr = test_assert(tr, "&& pass out=" + output, false);
            }
        }
    } else {
        tr = test_assert(tr, "build complex_contract_pass", false);
    }
    
    // Fail requires
    let cand_rfail = tmpdir + "/cand_rfail";
    let build_rfail_res = cmd_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/complex_contract_req_fail.oo " + cand_rfail + " >" + tmpdir + "/cand_b.out 2>" + tmpdir + "/cand_b.err");
    
    if build_rfail_res.is_ok() && cmd_exec(p, "test -x " + cand_rfail).is_ok() {
        let run_res = cmd_exec(p, cand_rfail + " 2>&1");
        if !run_res.is_ok() {
            let output = run_res.unwrap();
            if str_contains(output, "contract") || str_contains(output, "requires") {
                tr = test_assert(tr, "&& requires fail-closed", true);
            } else {
                tr = test_assert(tr, "req fail out=" + output, false);
            }
        } else {
            tr = test_assert(tr, "&& requires should fail-closed", false);
        }
    } else {
        tr = test_assert(tr, "build complex_contract_req_fail", false);
    }
    
    // Multi-clause still green
    let mc_log = tmpdir + "/cand_mc.log";
    let mc_res = cmd_exec(p, "bash \"" + root + "/scripts/contracts_multi_clause_smoke.sh\" >" + mc_log + " 2>&1");
    if mc_res.is_ok() {
        tr = test_assert(tr, "multi_clause still green", true);
    } else {
        tr = test_assert(tr, "multi_clause", false);
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("contracts_and_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
