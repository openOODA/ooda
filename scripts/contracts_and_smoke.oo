// # Contracts And Smoke
// Logline: complex_contract_pass runs (prints 7); complex_contract_req_fail refuses; multi_clause still green.
import "std/scenario.oo";
import "std/sh.oo";

const TMP: String = ".ooda-cache/ooda-tmp/contracts_and";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, root + "/" + TMP);
    let _     = scenario(p, fs, "contracts && product floor");

    // when — pass fixture builds and runs (prints 7)
    let pass = root + "/" + TMP + "/cand_pass";
    let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/complex_contract_pass.oo " + pass + " > " + root + "/" + TMP + "/b.out 2> " + root + "/" + TMP + "/b.err");
    let _ = expect_quiet(p, "test -x " + pass + " && " + pass + " 2>&1 | grep -q 7");

    // and — req fail refuses with contract wording
    let rfail = root + "/" + TMP + "/cand_rfail";
    let _ = process_exec(p, "OODAC_BIN=" + oodac + " " + oodac + " build " + root + "/fixtures/complex_contract_req_fail.oo " + rfail + " > " + root + "/" + TMP + "/b.out 2> " + root + "/" + TMP + "/b.err");
    let _ = expect_clean(p, "!" + rfail + " 2>&1 | head -1 | grep -qiE 'contract|requires'");

    // then — multi_clause still green
    let _ = check(p, "bash " + root + "/scripts/contracts_multi_clause_smoke.sh >/dev/null 2>&1", 120);

    println("contracts_and_smoke: PASSED");
}