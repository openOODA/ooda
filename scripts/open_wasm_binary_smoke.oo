// # OPEN-28 wasm binary smoke
//
// Logline: Runtime writes a valid empty \0asm module. gcc writer, magic, and file(1) prove it.
//
// Setup: cwd is ooda/. runtime/chs_rt_wasm.c and gcc exist. od and file are on PATH.
//
// Beats:
//   1. gcc a tiny C main that calls oo_wasm_write_empty_module.
//   2. First eight bytes are 00 61 73 6d 01 00 00 00.
//   3. file(1) names it a WebAssembly binary module.
// residual: compiled bytecode of src is not this product path.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "open wasm binary").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_present(fs, root + "/runtime/chs_rt_wasm.c").is_err() {
        println("FAIL no chs_rt_wasm.c");
        process_exit(1);
    }
    if expect_clean(p, "grep -q oo_wasm_write_empty_module " + root + "/runtime/chs_rt_wasm.c").is_err() {
        println("FAIL no writer");
        process_exit(1);
    }
    let cfile = tmpd + "/open_wasm_writer.c";
    let bin = tmpd + "/open_wasm_writer.bin";
    let wasm = tmpd + "/empty.wasm";
    let wr: String = "printf '%s\\n' '#include \"chs_rt.h\"' 'int main(void) { oo_wasm_write_empty_module(); return 0; }' > " + cfile;
    if process_exec(p, wr).is_err() {
        println("FAIL write c");
        process_exit(1);
    }
    let gcc: String = "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + cfile + " -o " + bin + " -lm -ldl -lpthread";
    if check(p, gcc, 30).is_err() {
        println("FAIL gcc writer");
        process_exit(1);
    }
    if check(p, bin + " > " + wasm, 10).is_err() {
        println("FAIL run writer");
        process_exit(1);
    }
    if expect_clean(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    if expect_clean(p, "file " + wasm + " | grep -qi WebAssembly").is_err() {
        println("FAIL file");
        process_exit(1);
    }
    println("open_wasm_binary_smoke: PASSED");
}
