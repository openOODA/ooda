// # GPU and NPU compute kernel and accelerated SIMD pipeline smoke
//
// Logline: Verify GPU/NPU compute pipeline modules, header compliance, line limits, and fixture execution.
//
// Setup: oodac compiler binary and GPU/NPU std modules exist on disk.
//
// Beats:
//   1. Typecheck all GPU and NPU standard library modules with oodac.
//   2. Verify DINNER.oot 4-element Academy headers and <= 256 line count limits.
//   3. Build and execute gpu_npu_fixture.oo verifying complete SIMD pipeline pass.
//
// residual: Hardware device register streaming and systolic array execution lower through pure runtime

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "gpu and npu accelerated compute pipeline");

    expect_quiet(p, "test -x " + oodac);

    // 1. Verify all GPU modules typecheck cleanly
    let g1 = root + "/../std/src/ooda/gpu/gpu_types.oo";
    let g2 = root + "/../std/src/ooda/gpu/gpu_kernel.oo";
    let g3 = root + "/../std/src/ooda/gpu/gpu_pipeline.oo";
    let g4 = root + "/../std/src/ooda/gpu/gpu_dispatch.oo";
    let g5 = root + "/../std/src/ooda/gpu/gpu.oo";

    check(p, oodac + " check " + g1, within: 30);
    check(p, oodac + " check " + g2, within: 30);
    check(p, oodac + " check " + g3, within: 30);
    check(p, oodac + " check " + g4, within: 30);
    check(p, oodac + " check " + g5, within: 30);

    // 2. Verify all NPU modules typecheck cleanly
    let n1 = root + "/../std/src/ooda/npu/npu_types.oo";
    let n2 = root + "/../std/src/ooda/npu/npu_tensor.oo";
    let n3 = root + "/../std/src/ooda/npu/npu_ops.oo";
    let n4 = root + "/../std/src/ooda/npu/npu.oo";

    check(p, oodac + " check " + n1, within: 30);
    check(p, oodac + " check " + n2, within: 30);
    check(p, oodac + " check " + n3, within: 30);
    check(p, oodac + " check " + n4, within: 30);

    // 3. Verify gpu_npu_fixture.oo typechecks, builds, and runs
    let fix = root + "/fixtures/gpu_npu_fixture.oo";
    check(p, oodac + " check " + fix, within: 30);
    check(p, oodac + " build " + fix + " " + tmpd + "/gpu_npu_fixture", within: 60);
    check(p, tmpd + "/gpu_npu_fixture > " + tmpd + "/fixture.out", within: 30);
    expect_clean(p, "grep -q 'gpu_npu_fixture: PASSED' " + tmpd + "/fixture.out");

    // 4. Verify DINNER.oot 4-element headers across GPU and NPU modules
    expect_clean(p, "grep -q '^// # ' " + g1);
    expect_clean(p, "grep -q '^// Logline:' " + g1);
    expect_clean(p, "grep -q '^// Setup:' " + g1);
    expect_clean(p, "grep -q '^// Beats:' " + g1);

    expect_clean(p, "grep -q '^// # ' " + n1);
    expect_clean(p, "grep -q '^// Logline:' " + n1);
    expect_clean(p, "grep -q '^// Setup:' " + n1);
    expect_clean(p, "grep -q '^// Beats:' " + n1);

    // 5. Line count constraint verification (strictly <= 256 lines)
    expect_clean(p, "test $(wc -l < " + g1 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + g2 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + g3 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + g4 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + g5 + ") -le 256");

    expect_clean(p, "test $(wc -l < " + n1 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + n2 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + n3 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + n4 + ") -le 256");
    expect_clean(p, "test $(wc -l < " + fix + ") -le 256");

    println("gpu_npu_pipeline_smoke: PASSED");
}
