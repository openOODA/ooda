// # Wasm pay/mod buffer fail-closed smoke
//
// Logline: A name longer than 63 is truncated, and emit_n must refuse when psz or mlen would pass pay 24000 or mod 28000.
//
// Setup: cwd is ooda/. gcc and runtime/chs_rt_wasm.c exist. This smoke does not rebuild oodac.
//
// Beats:
//   1. Confirm name truncate, scan 1 MiB refuse, pay 24000, and mod 28000.
//   2. gcc one driver that includes wasm.c and print.c as one unit.
//   3. 80-byte name is 63 A bytes; 30000-byte print does not crash; n=4096 writes at most 28000.
//   4. Fail closed if emit writers have no length guard.
// residual: FN_CAP 4096 does not fit a real module; overflow prints ERR wasm buf.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmp_in = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => "" };
    let mut tmpd = ".ooda-cache/ooda-tmp";
    if chars_len(tmp_in) > 0 { tmpd = tmp_in; }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm buf fail closed").is_err() { println("FAIL scenario"); process_exit(1); }

    let wasm_c = root + "/runtime/chs_rt_wasm.c";
    let print_c = root + "/runtime/chs_rt_wasm_print.c";
    if expect_present(fs, wasm_c).is_err() { println("FAIL no chs_rt_wasm.c"); process_exit(1); }
    let mut files = wasm_c;
    if expect_quiet(p, "test -f " + print_c).is_ok() { files = wasm_c + " " + print_c; }

    if expect_clean(p, "grep -q 'pay\\[24000\\]' " + files).is_err() {
        println("FAIL no pay[24000]");
        process_exit(1);
    }
    if expect_clean(p, "grep -q 'mod\\[28000\\]' " + files).is_err() {
        println("FAIL no mod[28000]");
        process_exit(1);
    }
    if expect_clean(p, "grep -q 'len >= OO_WASM_NAME_MAX' " + files).is_err() {
        println("FAIL name not truncated");
        process_exit(1);
    }
    if expect_clean(p, "grep -q 'sz > 1048576' " + files).is_err() {
        println("FAIL scan has no 1MiB refuse");
        process_exit(1);
    }

    let g1 = "grep -qE 'if[^{]*24000|if[^{]*28000' " + files;
    let g2 = "grep -qE 'if[^{]*sizeof *\\( *pay|if[^{]*sizeof *\\( *mod|if[^{]*sizeof pay|if[^{]*sizeof mod' " + files;
    let g3 = "grep -qE 'if[^{]*OO_WASM_PAY|if[^{]*OO_WASM_MOD' " + files;
    let g4 = "grep -qE 'if[^{]*\\*n[^{]*cap|if[^{]*oo_wasm_lim|if[^{]*oo_wasm_ovf' " + files;
    if expect_clean(p, g1 + " || " + g2 + " || " + g3 + " || " + g4).is_err() {
        println("FAIL emit_n writes with no length guard");
        process_exit(1);
    }

    prove_gcc_caps(p, root, files, tmpd);
    println("wasm_buf_smoke: PASSED");
}

fn prove_gcc_caps(p: &ProcessCap, root: String, files: String, tmpd: String) {
    let cfile = tmpd + "/wasm_buf_drv.c";
    let bin = tmpd + "/wasm_buf_drv.bin";
    let outn = tmpd + "/wasm_buf_name.wasm";
    let outp = tmpd + "/wasm_buf_print.wasm";
    let outk = tmpd + "/wasm_buf_n4096.wasm";
    let bbb = tmpd + "/wasm_buf_24k_b";
    let wr = "printf '%s\\n' '#include \"chs_rt_wasm.c\"' '#include \"chs_rt_wasm_print.c\"' 'int main(int argc, char **argv) {' 'char b[96]; static char p[30001]; int i; OoStr s; OoStr nm;' 'if (argc > 1 && argv[1][0] == 80) {' 'for (i = 0; i < 30000; i++) p[i] = 66; p[30000] = 0;' 'nm.data = \"main\"; nm.len = 4; oo_wasm_note_fn(nm);' 's.data = p; s.len = 30000; oo_wasm_set_fn_print(s);' 'oo_wasm_write_source_module(1); return 0; }' 'if (argc > 1 && argv[1][0] == 78) { oo_wasm_write_source_module(4096); return 0; }' 'for (i = 0; i < 80; i++) b[i] = 65; b[80] = 0; s.data = b; s.len = 80;' 'oo_wasm_note_fn(s); oo_wasm_write_source_module(1); return 0; }' > " + cfile;
    if process_exec(p, wr).is_err() { println("FAIL write drv"); process_exit(1); }
    if check(p, "gcc -O0 -I" + root + "/runtime " + cfile + " -o " + bin, 30).is_err() {
        println("FAIL gcc drv");
        process_exit(1);
    }
    if check(p, bin + " > " + outn, 10).is_err() { println("FAIL run name"); process_exit(1); }
    let a63 = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
    let a64 = a63 + "A";
    if expect_quiet(p, "grep -a -q '" + a63 + "' " + outn).is_err() {
        println("FAIL name not 63");
        process_exit(1);
    }
    if expect_quiet(p, "! grep -a -q '" + a64 + "' " + outn).is_err() {
        println("FAIL name overflowed 63");
        process_exit(1);
    }
    if expect_quiet(p, "test -f " + root + "/runtime/chs_rt_wasm_print.c").is_ok() {
        if expect_clean(p, "grep -qE 'OO_WASM_PBUF|OO_WASM_PRINT|PRINT_MAX' " + files + " || grep -nA40 oo_wasm_set_fn_print " + files + " | grep -qE '24000|28000|PBUF|sizeof|len >'").is_err() {
            println("FAIL set_fn_print has no print cap");
            process_exit(1);
        }
        if expect_clean(p, bin + " P > " + outp + " 2>" + tmpd + "/print.err; test $? -lt 128").is_err() {
            println("FAIL long print crashed");
            process_exit(1);
        }
        if expect_quiet(p, "grep -q $'ERR\\twasm\\tbuf' " + outp).is_err() {
            println("FAIL long print not ERR wasm buf");
            process_exit(1);
        }
        if expect_quiet(p, "od -An -tx1 -N4 " + outp + " | grep -q '00 61 73 6d'").is_ok() {
            println("FAIL long print still wrote a module");
            process_exit(1);
        }
        if expect_clean(p, "test $(wc -c < " + outp + ") -le 28000").is_err() {
            println("FAIL long print wrote past mod[28000]");
            process_exit(1);
        }
        if process_exec(p, "dd if=/dev/zero bs=24000 count=1 2>/dev/null | tr '\\0' 'B' > " + bbb).is_err() {
            println("FAIL make 24k B");
            process_exit(1);
        }
        if expect_quiet(p, "! grep -a -F -f " + bbb + " " + outp).is_err() {
            println("FAIL long print not truncated or refused");
            process_exit(1);
        }
    }
    if expect_clean(p, bin + " N > " + outk + " 2>" + tmpd + "/n4096.err; test $? -lt 128").is_err() {
        println("FAIL n=4096 crashed");
        process_exit(1);
    }
    if expect_clean(p, "test $(wc -c < " + outk + ") -le 28000").is_err() {
        println("FAIL n=4096 wrote past mod[28000]");
        process_exit(1);
    }
    if expect_quiet(p, "grep -q $'ERR\\twasm\\tbuf' " + outk).is_err() {
        println("FAIL n=4096 not ERR wasm buf");
        process_exit(1);
    }
    if expect_quiet(p, "od -An -tx1 -N4 " + outk + " | grep -q '00 61 73 6d'").is_ok() {
        println("FAIL n=4096 still wrote a module");
        process_exit(1);
    }
}
