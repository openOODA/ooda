// # Smoke Test for Ruby on Rails-Style ooda gen Scaffolding
//
// Logline: Verify generation of domain modules, capability services, and locked smoke tests.
//
// Setup: Executes cmd_gen generator routines and verifies output templates under SysCap and FsCap.
//
// Beats:
//   1. Verify module generator creates valid template with Academy headers.
//   2. Verify service generator creates valid lifecycle template.
//   3. Verify test generator creates pre-wired smoke test locks.
//   4. Execute CLI gen workflow and verify generated files.

import "cli/cmd_gen.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main(fs: &FsCap, sys: &SysCap) {
    // 1. Template generation verification
    let mod_tmpl: String = cmd_gen_module_template("Account");
    if str_index_of(mod_tmpl, "// # Domain Module for Account") < 0 {
        fail_smoke("missing Academy header in module template");
    }
    if str_index_of(mod_tmpl, "pub type Account = struct") < 0 {
        fail_smoke("missing Account struct definition");
    }

    let svc_tmpl: String = cmd_gen_service_template("Order");
    if str_index_of(svc_tmpl, "// # Capability Service for Order") < 0 {
        fail_smoke("missing Academy header in service template");
    }
    if str_index_of(svc_tmpl, "pub fn Order_service_create") < 0 {
        fail_smoke("missing Order service constructor");
    }

    let test_tmpl: String = cmd_gen_test_template("Payment");
    if str_index_of(test_tmpl, "// # Smoke Test Suite for Payment") < 0 {
        fail_smoke("missing Academy header in test template");
    }
    if str_index_of(test_tmpl, "OK: Payment_SMOKE_PASSED") < 0 {
        fail_smoke("missing Payment smoke pass message");
    }

    // 2. CLI dispatch tests
    let mut args1: List[String] = list_new();
    args1 = list_push(args1, "gen");
    args1 = list_push(args1, "module");
    args1 = list_push(args1, "UserSession");
    cmd_gen_run(fs, sys, args1);

    if !path_exists(fs, "src/UserSession.oo") {
        fail_smoke("src/UserSession.oo was not created");
    }

    let mut args2: List[String] = list_new();
    args2 = list_push(args2, "gen");
    args2 = list_push(args2, "service");
    args2 = list_push(args2, "Auth");
    cmd_gen_run(fs, sys, args2);

    if !path_exists(fs, "src/Auth_service.oo") {
        fail_smoke("src/Auth_service.oo was not created");
    }

    let mut args3: List[String] = list_new();
    args3 = list_push(args3, "gen");
    args3 = list_push(args3, "test");
    args3 = list_push(args3, "SmokeCheck");
    cmd_gen_run(fs, sys, args3);

    if !path_exists(fs, "tests/test_SmokeCheck.oo") {
        fail_smoke("tests/test_SmokeCheck.oo was not created");
    }

    // Clean up temporary generated files
    let cr: Result[String, String] = sys_exec(sys, "sh", "-c", "rm -f src/UserSession.oo src/Auth_service.oo tests/test_SmokeCheck.oo");
    if cr.is_err() {
        fail_smoke("cleanup failed");
    }

    println("OK: CLI_GEN_SMOKE_PASSED");
}
