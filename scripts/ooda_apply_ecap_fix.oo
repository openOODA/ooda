// # OODA Apply Ecap Fix
//
// Logline: dispatches to scripts/ooda_apply_fix.py for the bounded E_CAP / E_TC / E_HITL structural auto-fix — no shell-eval of diagnostics.
// Beats: resolve oodac | ensure tmpdir | exec python3 with args.

import "std/scenario.oo";
import "std/sh.oo";

const PY: String = "ooda/scripts/ooda_apply_fix.py";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "ooda apply ecap fix dispatcher");

    // when: oodac resolve lands (env, repo, or cwd) and dispatcher exists
    expect_clean(p, "test -f " + root + "/" + PY);
    expect_quiet(p, "test -x " + oodac + " || test -x ./oodac/oodac || test -x oodac/oodac");

    // then: hand off to python3 with whatever diagnostic args were passed
    let _ = check(p, "python3 " + root + "/" + PY + " \"$@\"", within: 60);
    println("ooda_apply_ecap_fix: PASSED");
}
