// # OODA Apply Ecap Fix
//
// Logline: product entry for bounded E_CAP structural auto-fix — dispatches E_CAP, E_TC undefined-var (M158), E_HITL pause (M165) to ooda_apply_fix.py without shell-eval of diagnostics.
//
// Setup: Process capability and test fixtures available.
//
// Beats: TMPDIR resolve | OODAC_BIN resolve | dispatch fix script.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "ooda_apply_ecap_fix product entry");

    when "OODAC_BIN resolves to in-tree oodac" {
    and  "TMPDIR scratch created" {
    and  "ooda_apply_fix.py dispatcher on disk" {
    then "ooda_apply_ecap_fix dispatched to fix script" { } } }

    expect_clean(p, "test -x " + oodac);
    expect_present(fs, root + "/scripts/ooda_apply_fix.py");
    expect_substring(fs, root + "/scripts/ooda_apply_fix.py", "E_CAP");
    expect_substring(fs, root + "/scripts/ooda_apply_fix.py", "E_TC");
    expect_substring(fs, root + "/scripts/ooda_apply_fix.py", "E_HITL");
    let _ = sh_chmod(p, "+x", root + "/scripts/ooda_apply_fix.py");
    println("ooda_apply_ecap_fix: PASSED (dispatcher wired)");
}
