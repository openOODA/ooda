// ===================================================================
// OODA Apply E_CAP Fix
// ===================================================================
// Product entry: bounded E_CAP structural auto-fix (no shell-eval of diagnostics)
// Dispatcher: E_CAP, E_TC undefined-var (M158), E_HITL pause (M165)

import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let root = get_root(p);
    
    // Set up OODAC_BIN if not set
    let oodac_bin = get_env(p, "OODAC_BIN", "");
    if str_len(oodac_bin) == 0 {
        if check_executable(p, root + "/oodac/oodac") {
            set_env(p, "OODAC_BIN", root + "/oodac/oodac");
        } else if check_executable(p, "./oodac/oodac") {
            set_env(p, "OODAC_BIN", "./oodac/oodac");
        }
    }
    
    // Set TMPDIR
    let tmpdir = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    let _ = cmd_exec(p, "mkdir -p " + tmpdir);
    
    // Execute the Python dispatcher
    let args = process_args(p);
    let mut cmd = "python3 " + root + "/scripts/ooda_apply_fix.py";
    let mut i = 1;
    while i < list_len(args) {
        cmd = cmd + " " + list_get(args, i);
        i = i + 1;
    }
    
    let res = cmd_exec(p, cmd);
    if !res.is_ok() {
        process_exit(1);
    }
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn set_env(p: &ProcessCap, key: String, value: String) {
    let _ = cmd_exec(p, "export " + key + "=" + value);
}

fn check_executable(p: &ProcessCap, path: String) -> Bool {
    let res = cmd_exec(p, "test -x " + path);
    return res.is_ok();
}

fn process_args(p: &ProcessCap) -> List[String] {
    // This would use sys_args in real openOODA
    // For now, return a dummy list
    let mut args: List[String] = list_new();
    return args;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
