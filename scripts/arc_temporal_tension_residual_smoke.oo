// Residual Smoke Test: arc_temporal_tension

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let script_name = "arc_temporal_tension_residual_smoke";
    
    // Check doc exists
    let check_doc = cmd_exec(p, "test -f " + root + "/bootstrap/ARC_TEMPORAL_TENSION.oot");
    tr = test_assert(tr, "doc file exists", check_doc.is_ok());
    
    // Check marker
    let check_marker = cmd_exec(p, "grep -q ARC_TEMPORAL_TENSION_RESIDUAL_ALPHA " + root + "/bootstrap/ARC_TEMPORAL_TENSION.oot");
    tr = test_assert(tr, "doc contains marker", check_marker.is_ok());
    
    // Check fail-closed residual wording
    let check_failclosed = cmd_exec(p, "grep -qiE 'fail-closed residual|Fail-closed residual' " + root + "/bootstrap/ARC_TEMPORAL_TENSION.oot");
    tr = test_assert(tr, "doc contains fail-closed residual", check_failclosed.is_ok());
    
    // Check non-claims wording
    let check_noclaims = cmd_exec(p, "grep -qiE 'do .* claim|What we do .* claim|not claim' " + root + "/bootstrap/ARC_TEMPORAL_TENSION.oot");
    tr = test_assert(tr, "doc contains non-claims", check_noclaims.is_ok());
    
    // Check fixture exists and has marker
    let check_fix = cmd_exec(p, "test -f " + root + "/fixtures/arc_temporal_tension_marker.oo");
    let check_fixline = cmd_exec(p, "grep -q 'ARC_TEMPORAL_TENSION: residual' " + root + "/fixtures/arc_temporal_tension_marker.oo");
    tr = test_assert(tr, "fixture exists with marker", check_fix.is_ok() && check_fixline.is_ok());
    
    // Check ci_product.sh reference
    let check_ci = cmd_exec(p, "grep -q '" + script_name + "' " + root + "/scripts/ci_product.sh");
    tr = test_assert(tr, "ci_product.sh references script", check_ci.is_ok());
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println(script_name + ": PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
