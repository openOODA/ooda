// # C If Expression Lowering and Execution Smoke
// Logline: Verify if expressions in pure value, let binding, return position, and compound arithmetic contexts lower to valid C ternary forms, compile with GCC, and execute cleanly.
// Setup: cwd is ooda/. Product oodac and runtime/chs_rt.c exist.
// Beats: 1. emit-c lowers if expressions to C ternary expressions | 2. GCC compiles emitted code | 3. execute binary and assert all branch values and arithmetic combinations evaluate correctly

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/c_if_expr";

    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    // Beat 1: Create fixture exercising if expressions in let, return, and binary ops
    let if_src = tmpd + "/if_expr_fixture.oo";
    let w1 = process_exec(p, "printf 'pub fn pick_val(flag: Bool) -> Int {\\n    return if flag { 42 } else { 99 };\\n}\\n\\npub fn pick_str(flag: Bool) -> String {\\n    return if flag { \"branch_true\" } else { \"branch_false\" };\\n}\\n\\npub fn check_res_param(r: Result[Int]) -> Int {\\n    let v: Int = match r {\\n        Ok(val) => val,\\n        Err(e) => -1,\\n    };\\n    return v;\\n}\\n\\npub fn main() {\\n    let n1: Int = if true { 100 } else { 200 };\\n    let n2: Int = if false { 100 } else { 200 };\\n    if n1 != 100 || n2 != 200 { process_exit(1); }\\n\\n    let s1: String = if true { \"left\" } else { \"right\" };\\n    let s2: String = if false { \"left\" } else { \"right\" };\\n    if s1 != \"left\" || s2 != \"right\" { process_exit(1); }\\n\\n    let r1: Int = pick_val(true);\\n    let r2: Int = pick_val(false);\\n    if r1 != 42 || r2 != 99 { process_exit(1); }\\n\\n    let ps1: String = pick_str(true);\\n    let ps2: String = pick_str(false);\\n    if ps1 != \"branch_true\" || ps2 != \"branch_false\" { process_exit(1); }\\n\\n    let flag_a: Bool = true;\\n    let flag_b: Bool = false;\\n    let total: Int = (if flag_a { 10 } else { 20 }) + (if flag_b { 30 } else { 40 });\\n    if total != 50 { process_exit(1); }\\n\\n    let res_let: Result[Int] = if flag_a { Ok(88) } else { Err(\"err\") };\\n    let unwrapped_let: Int = match res_let {\\n        Ok(v) => v,\\n        Err(e) => 0,\\n    };\\n    if unwrapped_let != 88 { process_exit(1); }\\n\\n    let ok_val: Result[Int] = Ok(77);\\n    let res_p1: Int = check_res_param(ok_val);\\n    if res_p1 != 77 { process_exit(1); }\\n    let err_val: Result[Int] = Err(\"bad\");\\n    let res_p2: Int = check_res_param(err_val);\\n    if res_p2 != -1 { process_exit(1); }\\n\\n    println(\"c_if_expr: OK\");\\n}\\n' > " + if_src);
    if w1.is_err() { fail("write if_expr_fixture.oo"); }

    let emit_res = process_exec(p, oodac + " emit-c " + if_src + " > " + tmpd + "/if.c 2> " + tmpd + "/if.err");
    if emit_res.is_err() { fail("emit-c if_expr_fixture.oo"); }

    // Verify emitted C contains ternary operator
    let chk_ternary = process_exec(p, "grep -qE '\\? .+: .+' " + tmpd + "/if.c");
    if chk_ternary.is_err() { fail("ternary operator missing in emitted C"); }

    // Beat 2: Compile with GCC
    let gcc_res = process_exec(p, "gcc -O2 -Iruntime runtime/chs_rt.c " + tmpd + "/if.c -lm -ldl -lpthread -o " + tmpd + "/if.bin");
    if gcc_res.is_err() { fail("gcc compile if_expr"); }

    // Beat 3: Run binary and verify output
    let run_res = process_exec(p, tmpd + "/if.bin > " + tmpd + "/if.out 2>&1");
    if run_res.is_err() { fail("run if_expr binary"); }

    let chk_out = process_exec(p, "grep -q 'c_if_expr: OK' " + tmpd + "/if.out");
    if chk_out.is_err() { fail("if_expr output mismatch"); }

    println("c_if_expr_smoke: PASSED");
}
