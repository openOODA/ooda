// # Adversarial Probe: Tier 2 Zero-Trust Negative Fuzzing
//
// Logline: Hostile fuzzing probe testing varint overflows, wire frame truncations, depth bombs, and out-of-bounds slice spans.
//
// Setup: ProcessCap granted to inject over 100 corrupted inputs and assert fail-closed Result[T, String] Err returns with zero crashes.
//
// Beats:
//   1. Inject LEB128 varint overflows (>10 bytes) and truncated continuation streams.
//   2. Inject corrupted wire frame headers (magic, negative lengths, truncations).
//   3. Inject parser recursion depth bombs (>1000 frames) and negative bounds.
//   4. Inject negative and out-of-bounds slice spans.

import "std/prove/tier2_negative_fuzz.oo";

fn assert_err(label: String, is_err: Bool) {
    if !is_err {
        println("FAIL: " + label + " expected Err but got Ok");
        process_exit(1);
    }
}

fn assert_ok(label: String, is_ok: Bool) {
    if !is_ok {
        println("FAIL: " + label + " expected Ok but got Err");
        process_exit(1);
    }
}

fn test_fuzz_varint() {
    // Empty stream
    let mut empty_stream: List[Int] = list_new();
    let r_empty: Result[Int, String] = tier2_decode_varint(empty_stream);
    match r_empty { Ok(_) => { assert_err("varint_empty", false); }, Err(_) => { assert_err("varint_empty", true); } }

    // Truncated streams with continuation bit set
    let mut trunc1: List[Int] = list_new();
    trunc1 = list_push(trunc1, 128);
    let r_trunc1: Result[Int, String] = tier2_decode_varint(trunc1);
    match r_trunc1 { Ok(_) => { assert_err("varint_trunc1", false); }, Err(_) => { assert_err("varint_trunc1", true); } }

    let mut trunc3: List[Int] = list_new();
    trunc3 = list_push(trunc3, 128 + 5);
    trunc3 = list_push(trunc3, 128 + 10);
    trunc3 = list_push(trunc3, 128 + 15);
    let r_trunc3: Result[Int, String] = tier2_decode_varint(trunc3);
    match r_trunc3 { Ok(_) => { assert_err("varint_trunc3", false); }, Err(_) => { assert_err("varint_trunc3", true); } }

    // Overflows: 11, 15, 20 bytes with continuation bit set
    let mut overflow11: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 11 {
        overflow11 = list_push(overflow11, 128 + 1);
        i = i + 1;
    }
    let r_ov11: Result[Int, String] = tier2_decode_varint(overflow11);
    match r_ov11 { Ok(_) => { assert_err("varint_ov11", false); }, Err(_) => { assert_err("varint_ov11", true); } }

    let mut overflow20: List[Int] = list_new();
    i = 0;
    while i < 20 {
        overflow20 = list_push(overflow20, 128 + (i % 64));
        i = i + 1;
    }
    let r_ov20: Result[Int, String] = tier2_decode_varint(overflow20);
    match r_ov20 { Ok(_) => { assert_err("varint_ov20", false); }, Err(_) => { assert_err("varint_ov20", true); } }

    // Invalid byte values (<0 or >255)
    let mut bad_byte_neg: List[Int] = list_new();
    bad_byte_neg = list_push(bad_byte_neg, -5);
    let r_bb_neg: Result[Int, String] = tier2_decode_varint(bad_byte_neg);
    match r_bb_neg { Ok(_) => { assert_err("varint_bb_neg", false); }, Err(_) => { assert_err("varint_bb_neg", true); } }

    let mut bad_byte_high: List[Int] = list_new();
    bad_byte_high = list_push(bad_byte_high, 300);
    let r_bb_high: Result[Int, String] = tier2_decode_varint(bad_byte_high);
    match r_bb_high { Ok(_) => { assert_err("varint_bb_high", false); }, Err(_) => { assert_err("varint_bb_high", true); } }

    // Valid single-byte varints
    let mut valid1: List[Int] = list_new();
    valid1 = list_push(valid1, 42);
    let r_val1: Result[Int, String] = tier2_decode_varint(valid1);
    match r_val1 { Ok(v) => { assert_ok("varint_val1", v == 42); }, Err(_) => { assert_ok("varint_val1", false); } }
}

fn test_fuzz_wire() {
    // Magic mismatch
    let r_bad_magic: Result[Int, String] = tier2_decode_wire_frame(999999, 100, 100);
    match r_bad_magic { Ok(_) => { assert_err("wire_magic", false); }, Err(_) => { assert_err("wire_magic", true); } }

    // Negative lengths
    let r_neg_len: Result[Int, String] = tier2_decode_wire_frame(1330594881, -50, 100);
    match r_neg_len { Ok(_) => { assert_err("wire_neg_len", false); }, Err(_) => { assert_err("wire_neg_len", true); } }

    // Negative buffer
    let r_neg_buf: Result[Int, String] = tier2_decode_wire_frame(1330594881, 50, -100);
    match r_neg_buf { Ok(_) => { assert_err("wire_neg_buf", false); }, Err(_) => { assert_err("wire_neg_buf", true); } }

    // Truncated buffer (declared > buffer)
    let r_trunc_buf: Result[Int, String] = tier2_decode_wire_frame(1330594881, 1000, 500);
    match r_trunc_buf { Ok(_) => { assert_err("wire_trunc_buf", false); }, Err(_) => { assert_err("wire_trunc_buf", true); } }

    // Valid wire frame
    let r_valid_wire: Result[Int, String] = tier2_decode_wire_frame(1330594881, 256, 512);
    match r_valid_wire { Ok(v) => { assert_ok("wire_valid", v == 256); }, Err(_) => { assert_ok("wire_valid", false); } }
}

fn test_fuzz_depth_bombs() {
    // Depth bombs: 1000, 5000, 50000 frames
    let r_db1000: Result[Int, String] = tier2_check_recursion_depth(1000, 64);
    match r_db1000 { Ok(_) => { assert_err("depth_bomb_1000", false); }, Err(_) => { assert_err("depth_bomb_1000", true); } }

    let r_db5000: Result[Int, String] = tier2_check_recursion_depth(5000, 100);
    match r_db5000 { Ok(_) => { assert_err("depth_bomb_5000", false); }, Err(_) => { assert_err("depth_bomb_5000", true); } }

    // Negative depth
    let r_neg_d: Result[Int, String] = tier2_check_recursion_depth(-10, 64);
    match r_neg_d { Ok(_) => { assert_err("depth_neg", false); }, Err(_) => { assert_err("depth_neg", true); } }

    // Invalid max allowed
    let r_bad_max: Result[Int, String] = tier2_check_recursion_depth(5, 0);
    match r_bad_max { Ok(_) => { assert_err("depth_max_zero", false); }, Err(_) => { assert_err("depth_max_zero", true); } }

    // Valid depth within bound
    let r_valid_d: Result[Int, String] = tier2_check_recursion_depth(32, 64);
    match r_valid_d { Ok(v) => { assert_ok("depth_valid", v == 32); }, Err(_) => { assert_ok("depth_valid", false); } }
}

fn test_fuzz_slices() {
    // Negative start, negative length, negative capacity
    let r_neg_st: Result[Int, String] = tier2_check_slice_bounds(100, -1, 10);
    match r_neg_st { Ok(_) => { assert_err("slice_neg_start", false); }, Err(_) => { assert_err("slice_neg_start", true); } }

    let r_neg_len: Result[Int, String] = tier2_check_slice_bounds(100, 0, -5);
    match r_neg_len { Ok(_) => { assert_err("slice_neg_len", false); }, Err(_) => { assert_err("slice_neg_len", true); } }

    let r_neg_cap: Result[Int, String] = tier2_check_slice_bounds(-10, 0, 5);
    match r_neg_cap { Ok(_) => { assert_err("slice_neg_cap", false); }, Err(_) => { assert_err("slice_neg_cap", true); } }

    // Start index out of bounds
    let r_st_oob: Result[Int, String] = tier2_check_slice_bounds(100, 101, 0);
    match r_st_oob { Ok(_) => { assert_err("slice_start_oob", false); }, Err(_) => { assert_err("slice_start_oob", true); } }

    // Span out of bounds (start + length > cap)
    let r_span_oob: Result[Int, String] = tier2_check_slice_bounds(100, 80, 25);
    match r_span_oob { Ok(_) => { assert_err("slice_span_oob", false); }, Err(_) => { assert_err("slice_span_oob", true); } }

    // Valid slices
    let r_valid_sl: Result[Int, String] = tier2_check_slice_bounds(100, 20, 30);
    match r_valid_sl { Ok(v) => { assert_ok("slice_valid", v == 30); }, Err(_) => { assert_ok("slice_valid", false); } }

    let r_zero_sl: Result[Int, String] = tier2_check_slice_bounds(100, 50, 0);
    match r_zero_sl { Ok(v) => { assert_ok("slice_zero", v == 0); }, Err(_) => { assert_ok("slice_zero", false); } }
}

pub fn main(p: &ProcessCap) {
    println("--- probe_m2_tier2_negative_fuzz_adversarial: starting ---");
    test_fuzz_varint();
    println("  [PASS] Varint corrupt/overflow/truncation streams strictly fail-closed");
    test_fuzz_wire();
    println("  [PASS] Wire frame corrupt magic/lengths/truncations strictly fail-closed");
    test_fuzz_depth_bombs();
    println("  [PASS] Recursion depth bombs (>1000 frames) strictly fail-closed");
    test_fuzz_slices();
    println("  [PASS] Negative and OOB slice spans strictly fail-closed");
    println("probe_m2_tier2_negative_fuzz_adversarial: PASSED");
}
