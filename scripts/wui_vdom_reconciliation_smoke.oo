// # Dedicated WUI Virtual DOM Reconciliation Smoke Test
//
// Logline: End-to-end verification of Virtual DOM creation, tree diffing reconciliation, patch serialization, and component generation.
//
// Setup: Validates openOODA std/wui VDOM engine on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify Virtual DOM tree construction via declarative DSL builders (h_div, h_button, h_text).
//   2. Verify tree reconciliation diffing generating surgical replacement, prop update, and text patches.
//   3. Verify child list mutations (append_child and remove_child diffing).
//   4. Verify patch JSON serialization and reusable WUI component generation.

import "std/wui/wui_vnode.oo";
import "std/wui/wui_vdom_builder.oo";
import "std/wui/wui_patch.oo";
import "std/wui/wui_diff.oo";
import "std/wui/wui_patch_serializer.oo";
import "std/wui/wui_components.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA WUI Virtual DOM & Reconciliation Smoke");
    println("===================================================================");

    // 1. Declarative VDOM Tree Construction
    let mut root_props: List[VProp] = list_new();
    root_props = list_push(root_props, prop_id("app-root"));
    root_props = list_push(root_props, prop_class("theme-dark"));

    let mut children0: List[VNode] = list_new();
    let mut empty_p0: List[VProp] = list_new();
    let mut p_ch0: List[VNode] = list_new();
    p_ch0 = list_push(p_ch0, h_text("Hello World"));
    let text_item0: VNode = h_p(empty_p0, p_ch0);
    children0 = list_push(children0, text_item0);
    let vtree0: VNode = h_div(root_props, children0);

    let prop_res: Result[String, String] = vnode_get_prop(&vtree0, "id");
    match prop_res {
        Ok(id_val) => {
            if id_val != "app-root" || list_len(vtree0.children) != 1 {
                println("FAIL: VDOM root node attribute or child count mismatch");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL: VDOM property lookup failed: " + e);
            process_exit(1);
        }
    }
    println("  [PASS] 1. Declarative VDOM Tree Construction & Attribute Inspection");

    // 2. Tree Reconciliation Diffing (Text & Attribute Mutators)
    let mut updated_props: List[VProp] = list_new();
    updated_props = list_push(updated_props, prop_id("app-root"));
    updated_props = list_push(updated_props, prop_class("theme-light")); // Changed class

    let mut children1: List[VNode] = list_new();
    let mut empty_p1: List[VProp] = list_new();
    let mut p_ch1: List[VNode] = list_new();
    p_ch1 = list_push(p_ch1, h_text("Updated Content"));
    let text_item1: VNode = h_p(empty_p1, p_ch1);
    children1 = list_push(children1, text_item1);
    let vtree1: VNode = h_div(updated_props, children1);

    let patches: List[Patch] = vdom_diff(&vtree0, &vtree1, "0");
    let n_patches: Int = list_len(patches);

    if n_patches < 2 {
        println("FAIL: VDOM diff failed to detect prop update and text change");
        process_exit(1);
    }
    println("  [PASS] 2. Subtree Reconciliation (Attribute Updates & Text Modifications)");

    // 3. Child Append & Structural Modifications
    let mut children2: List[VNode] = list_new();
    children2 = list_push(children2, text_item1);
    let extra_btn: VNode = wui_button("Submit", "submit_form");
    children2 = list_push(children2, extra_btn);
    let vtree2: VNode = h_div(updated_props, children2);

    let struct_patches: List[Patch] = vdom_diff(&vtree1, &vtree2, "0");
    let n_struct: Int = list_len(struct_patches);
    if n_struct != 1 {
        println("FAIL: VDOM diff failed to emit single append_child patch for structural addition");
        process_exit(1);
    }

    let p0: Patch = list_get(struct_patches, 0);
    if (p0).patch_type != 3 { // 3: AppendChild
        println("FAIL: Emitted patch is not AppendChild (expected type 3)");
        process_exit(1);
    }
    println("  [PASS] 3. Structural Node Insertion & Append Child Diffing");

    // 4. Patch Serialization & Component Assembly
    let patch_json: String = patch_serialize_json(struct_patches);
    if !str_contains(patch_json, "{\"t\":3") {
        println("FAIL: Patch JSON serialization formatting mismatch");
        process_exit(1);
    }

    let modal: VNode = wui_modal("Alert Dialog", true, h_text("Confirm Action"));
    let badge: VNode = wui_badge("Active", "bg-green");
    if modal.node_kind != 1 || badge.node_kind != 1 {
        println("FAIL: Reusable WUI component instantiation mismatch");
        process_exit(1);
    }
    println("  [PASS] 4. JSON Patch Stream Serialization & Component Library Assembly");

    println("wui_vdom_reconciliation_smoke: PASSED");
}
