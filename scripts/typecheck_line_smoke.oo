// # Typecheck Line Stays Local
// Logline: single-file type errors report line < 50 (small), near the offending line.
// Setup: oodac/oodac built; typecheck/fail fixtures on disk.
// Beats: 1. corpus fail has small line | 2. probe keeps let-ann mismatch line local | 3. multi-import residual

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "typecheck line local");

    // when — single-file fail fixtures: line must be local (<50)
    let cf = root + "/bootstrap/corpus/typecheck/fail";
    let _  = expect_present(fs, cf);
    let _  = process_exec(p, "ls -1 " + cf + "/*.oo > " + tmpd + "/tc_line.lst 2>/dev/null || true");
    let _  = check(p, "for f in $(cat " + tmpd + "/tc_line.lst); do n=$(" + oodac + " check \"$f\" 2>&1 | sed -n 's/.*Type error at \\([0-9]\\+\\):.*/\\1/p' | head -1); [ -n \"$n\" ] && [ \"$n\" -lt 50 ] || exit 1; done", 60);

    // and — ad-hoc probe: let ann mismatch on line 3 keeps line local
    let probe = tmpd + "/tc_line_probe.oo";
    let pout  = tmpd + "/tc_probe.out";
    let perr  = tmpd + "/tc_probe.err";
    let _     = process_exec(p, "printf '// line 1\\nfn main() {\\n    let x: Int = \"hi\";\\n}\\n' > " + probe);
    let _     = process_exec(p, oodac + " check " + probe + " > " + pout + " 2> " + perr);
    let _     = expect_quiet(p, "cat " + pout + " " + perr + " | grep -E 'Type error at [0-9]+:'");
    let _     = check(p, "cat " + pout + " " + perr + " | sed -n 's/.*Type error at \\([0-9]\\+\\):.*/\\1/p' | head -1 | xargs -I{} test {} -lt 50", 30);

    // then — residual documented
    println("RESIDUAL: multi-import expanded LINE offsets — see oodac/tc_diag.oo");

    println("typecheck_line_smoke: PASSED");
}
