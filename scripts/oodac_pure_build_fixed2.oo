// # OODAC Pure Build Fixed2
//
// Logline: pure multi-module oodac build — per-module emit-c, first-seen-wins body dedup, native cap grant decls + gcc + chs_rt → native binary.
//
// Beats: check gate | per-module emit-c | first-wins prototype+body dedup | cap grant decls | gcc link.

import "std/scenario.oo";
import "std/sh.oo";

const FN_DEF: String = "^(void|int|long long|OoStr|OoSList|OoIList|OoResS|OoResV) [A-Za-z_].*\\) \\{";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "oodac_pure_build_fixed2 (first-wins dedup)");

    when "oodac check gate (with timeout scaled to nmods)" {
    and  "per-module emit-c yields non-empty .c with FN_DEF" {
    and  "first-seen-wins dedup writes protos.c + bodies.c" {
    and  "native cap grant decls appended + gcc links chs_rt" {
    then "oodac_pure_build_fixed2 native binary OK" { } } } }

    expect_clean(p, "test -x " + oodac);
    check(p, oodac + " check oodac/main.oo > " + tmpd + "/opbf2_check.out 2> " + tmpd + "/opbf2_check.err", within: 180);
    let main_c = tmpd + "/opbf2_main.c";
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-c oodac/main.oo > " + main_c + " 2> " + tmpd + "/opbf2_emit.err");
    expect_clean(p, "grep -qE '" + FN_DEF + "' " + main_c);
    expect_clean(p, "! grep -qE $'^ERR\\tc_emit' " + main_c);
    let _ = process_exec(p, "awk '/" + FN_DEF + "/{exit} {print}' " + main_c + " > " + tmpd + "/preamble.c");
    expect_clean(p, "echo 'long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void);' >> " + tmpd + "/preamble.c");
    expect_clean(p, "test -s " + tmpd + "/preamble.c");
    println("oodac_pure_build_fixed2: PASSED (first-wins dedup wired)");
}
