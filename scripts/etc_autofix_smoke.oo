// # ETC Auto-Fix Smoke
//
// Logline: E_TC undefined-var bounded auto-fix inserts `let no_such_var = 0` and clears E_TC on re-check; E_CAP-only is not touched.
// Setup: oodac/oodac prebuilt; ooda_apply_etc_fix.py; corpus/typecheck/fail/undefined_var.oo.
//
// Beats: before E_TC | apply inserts structural let | after no E_TC for no_such_var | etc-only on E_CAP fail-closed | product CLI inserts let.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "E_TC undefined-var bounded auto-fix");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/bootstrap/corpus/typecheck/fail/undefined_var.oo");
    expect_present(fs, root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo");

    // when "undefined_var.oo triggers E_TC" {
    // and  "apply inserts `let no_such_var = 0`" {
    // and  "after no E_TC for no_such_var" {
    // and  "etc-only on E_CAP-only fail-closed" {
    // and  "product CLI fixes E_TC" {
    // then "E_TC auto-fix path green" {

    let work: String = match sh_tempfile(p, "-d " + tmpd + " -t etc_XXXXXX") { Ok(s) => s, Err(_) => tmpd + "/etc_work" };
    let _ = sh_clean(fw, fs, work);
    let _ = sh_mkdir_p(fw, work);
    check(p, "cp " + root + "/bootstrap/corpus/typecheck/fail/undefined_var.oo " + work + "/u.oo", within: 5);
    check(p, "!" + oodac + " check " + work + "/u.oo --json-errors > " + work + "/before.json 2> " + work + "/before.err", within: 30);

    check(p, "bash " + root + "/scripts/ooda_apply_ecap_fix.sh " + work + "/u.oo > " + work + "/apply.out 2> " + work + "/apply.err", within: 30);
    expect_substring(fs, work + "/u.oo", "let no_such_var = 0");

    check(p, oodac + " check " + work + "/u.oo --json-errors > " + work + "/after.json 2> " + work + "/after.err", within: 30);
    expect_clean(p, "! grep -q '\"code\": \"E_TC\".*no_such_var\\|\"no_such_var\".*E_TC' " + work + "/after.json");

    check(p, "cp " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo " + work + "/cap.oo && ! python3 " + root + "/scripts/ooda_apply_etc_fix.py " + work + "/cap.oo > " + work + "/na.out 2> " + work + "/na.err", within: 30);

    expect_quiet(p, "test -x " + ooda);
    check(p, "cp " + root + "/bootstrap/corpus/typecheck/fail/undefined_var.oo " + work + "/cli.oo && " + ooda + " fix " + work + "/cli.oo > " + work + "/cli.out 2> " + work + "/cli.err", within: 60);
    expect_substring(fs, work + "/cli.oo", "let no_such_var = 0");

    let _ = sh_clean(fw, fs, work);
    println("etc_autofix_smoke: PASSED");
}