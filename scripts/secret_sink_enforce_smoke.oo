// # Secret Sink Enforce Smoke
//
// Logline: M52/M53/M128/M131 — every secret sink refuses on IDENT (println / write_file / fetch / sys_exec / env_get / read_file / process_exit) and assigns work, plain fixtures pass.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Every floor fixture is present on disk.
//   2. Each fail fixture refuses emit-c with ERR secret.
//   3. SECRET_TAINT.oot names the sinks; ci_product.oo wires this rail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "secret sink enforce");

    let mut floor: List[String] = list_new();
    floor = list_push(floor, "secret_sink_fail");
    floor = list_push(floor, "secret_sink_pass");
    floor = list_push(floor, "secret_write_file_fail");
    floor = list_push(floor, "secret_write_file_pass");
    floor = list_push(floor, "secret_fetch_fail");
    floor = list_push(floor, "secret_fetch_pass");
    floor = list_push(floor, "secret_sys_exec_fail");
    floor = list_push(floor, "secret_sys_exec_pass");
    floor = list_push(floor, "secret_env_get_fail");
    floor = list_push(floor, "secret_env_get_pass");
    floor = list_push(floor, "secret_read_file_fail");
    floor = list_push(floor, "secret_read_file_pass");
    floor = list_push(floor, "secret_process_exit_fail");
    floor = list_push(floor, "secret_process_exit_pass");

    let mut fails: List[String] = list_new();
    fails = list_push(fails, "secret_sink_fail");
    fails = list_push(fails, "secret_write_file_fail");
    fails = list_push(fails, "secret_fetch_fail");
    fails = list_push(fails, "secret_sys_exec_fail");
    fails = list_push(fails, "secret_env_get_fail");
    fails = list_push(fails, "secret_read_file_fail");
    fails = list_push(fails, "secret_process_exit_fail");

    // when: every floor fixture is present
    let n_floor: Int = list_len(floor);
    let mut i: Int = 0;
    while i < n_floor {
        let base: String = list_get(floor, i);
        expect_present(fs, root + "/ooda/fixtures/" + base + ".oo");
        i = i + 1;
    }

    // and: each fail fixture refuses with ERR\tsecret on emit-c
    let n_fail: Int = list_len(fails);
    let mut j: Int = 0;
    while j < n_fail {
        let fail_base: String = list_get(fails, j);
        expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/" + fail_base + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
        j = j + 1;
    }

    // then: doc carries residual marker + names the sinks
    expect_present(fs, root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_substring(fs, root + "/ooda/bootstrap/SECRET_TAINT.oot", "SECRET_TAINT_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fetch' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_clean(p, "grep -qiE 'write_file' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_clean(p, "grep -qiE 'sys_exec' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");

    expect_substring(fs, root + "/ooda/scripts/ci_product.oo", "secret_sink_enforce_smoke");
    println("secret_sink_enforce_smoke: PASSED");
}
