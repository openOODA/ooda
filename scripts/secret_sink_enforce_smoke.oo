// # Secret Sink Enforce Smoke
//
// Logline: M52/M53/M128/M131 — every secret sink refuses on IDENT (println / write_file / fetch / sys_exec / env_get / read_file / process_exit) and assigns work, plain fixtures pass.
// Beats: floor fixtures present | ident refuses | plain passes | doc honest | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const FLOOR: List[String] = [
    "secret_sink_fail", "secret_sink_pass",
    "secret_write_file_fail", "secret_write_file_pass",
    "secret_fetch_fail", "secret_fetch_pass",
    "secret_sys_exec_fail", "secret_sys_exec_pass",
    "secret_env_get_fail", "secret_env_get_pass",
    "secret_read_file_fail", "secret_read_file_pass",
    "secret_process_exit_fail", "secret_process_exit_pass",
];

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "secret sink enforce");

    // when: every floor fixture is present
    for base in FLOOR {
        expect_present(fs, root + "/ooda/fixtures/" + base + ".oo");
    }

    // and: each fail fixture refuses with ERR\tsecret on emit-c
    for base in ["secret_sink_fail", "secret_write_file_fail", "secret_fetch_fail",
                 "secret_sys_exec_fail", "secret_env_get_fail", "secret_read_file_fail",
                 "secret_process_exit_fail"] {
        expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/" + base + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    }

    // then: doc carries residual marker + names the sinks
    expect_present(fs, root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_substring(fs, root + "/ooda/bootstrap/SECRET_TAINT.oot", "SECRET_TAINT_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fetch' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_clean(p, "grep -qiE 'write_file' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");
    expect_clean(p, "grep -qiE 'sys_exec' " + root + "/ooda/bootstrap/SECRET_TAINT.oot");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "secret_sink_enforce_smoke");
    println("secret_sink_enforce_smoke: PASSED");
}
