// # Max Cycles Residual Smoke
//
// Logline: M48 residual — doc names path A while fuel, denies OS envelope, and the marker/fix round-trip is honest; no leftover names-only product claim.
//
// Setup: Process capability and test fixtures available.
// Beats: marker | no OS-isolation claim | path A while fuel wording | names-only scan | fixture + ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/MAX_CYCLES.oot";
const FIX: String = "ooda/fixtures/max_cycles_marker.oo";
const MARKER: String = "MAX_CYCLES_RESIDUAL_ALPHA";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "max cycles residual honesty");

    // when: doc carries the residual marker
    expect_present(fs, DOC);
    expect_substring(fs, DOC, MARKER);

    // and: doc denies OS CPU isolation
    expect_clean(p, "! grep -nE '(enforced by|uses|ships|via|implements) (cgroup|cpulimit|RLIMIT_CPU)' " + root + "/" + DOC);
    expect_clean(p, "grep -qE 'cgroup|RLIMIT|not OS' " + root + "/" + DOC);

    // then: doc states path A while fuel
    expect_clean(p, "grep -qE 'path A|while fuel|__oo_mc|max_cycles_fuel_inject' " + root + "/" + DOC);

    // and: no leftover names-only product claim
    expect_clean(p, "! grep -nE 'names only|named marker only|named surface only' " + root + "/" + DOC + " 2>/dev/null | grep -viE 'attribute|residual|was M21' | head -1");

    // fixture + marker
    expect_present(fs, FIX);
    expect_clean(p, "grep -qE '// MAX_CYCLES:[[:space:]]*[0-9]+' " + root + "/" + FIX);
    expect_clean(p, "! grep -qiE 'Not enforced|no Backend-C loop fuel' " + root + "/" + FIX);

    // ci wire
    expect_clean(p, "grep -q 'max_cycles_enforce_smoke.sh' " + root + "/ooda/scripts/ci_product.sh || grep -q 'max_cycles_smoke.sh' " + root + "/ooda/scripts/ci_product.sh");
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_residual_smoke.sh");

    // doc keeps residual non-claims surface
    expect_clean(p, "grep -qE 'for|#[MaxCycles]|cgroup' " + root + "/" + DOC);

    println("max_cycles_residual_smoke: PASSED");
}
