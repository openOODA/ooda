// # Process exec product path
//
// Logline: Prove process_exec on the product path: check prints OK, emit-c lowers to oo_sys_exec, gcc and run print ok.
//
// Setup: OODAC_BIN is a host that emits C. Fixture is fixtures/emit_tmp/process_exec_match.oo. Caps are injected.
//
// Beats:
//   1. oodac check of the fixture prints OK.
//   2. emit-c C contains oo_sys_exec (process_exec lowers to sh -c).
//   3. gcc with runtime/chs_rt.c; run stdout contains ok.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "process_exec product path");

    let fix = root + "/fixtures/emit_tmp/process_exec_match.oo";
    let rt = root + "/runtime";

    let _ = process_exec(p, oodac + " check " + fix + " > " + tmp + "/pe_prod_check.out 2>" + tmp + "/pe_prod_check.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/pe_prod_check.out " + tmp + "/pe_prod_check.err");
    expect_clean(p, "grep -qE $'^OK' " + tmp + "/pe_prod_check.out");

    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmp + "/pe_prod.c 2>" + tmp + "/pe_prod.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/pe_prod.c " + tmp + "/pe_prod.err");
    expect_substring(fs, tmp + "/pe_prod.c", "oo_sys_exec(p,");
    expect_substring(fs, tmp + "/pe_prod.c", "oo_str_lit(\"sh\")");
    expect_substring(fs, tmp + "/pe_prod.c", "oo_str_lit(\"-c\")");

    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/pe_prod.c -o " + tmp + "/pe_prod.bin -lm");
    expect_clean(p, tmp + "/pe_prod.bin 2>&1 | grep -qx ok");

    println("process_exec_product_smoke: PASSED");
}
