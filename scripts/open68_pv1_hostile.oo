// # OPEN-68 PV1 hostile mutate
//
// Logline: A side LLVM-linked oodac must not print OK after hello is mutated, and match-expr must not be an empty-string stub.
//
// Setup: cwd is ooda/. ELF is .ooda-cache/ooda-tmp/oodac_llvm or oodac_stamp. Wipe g_*. Restore hello.
//
// Beats:
//   1. Refuse a KW_MATCH zeroinitializer stub in llvm_emit_expr.oo.
//   2. Wipe g_* and append invalid source to hello.
//   3. Drive ELF check. Require no ^OK. Restore hello.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let mut elf = tmpd + "/oodac_llvm";
    if process_exec(p, "test -x " + elf).is_err() {
        elf = tmpd + "/oodac_stamp";
    }
    if process_exec(p, "test -x " + elf).is_err() { fail("no LLVM ELF"); }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if process_exec(p, "grep -n 'return llvm_out_val(\"zeroinitializer\"' oodac/llvm_emit_expr.oo").is_ok() {
        fail("match expr still stubbed");
    }
    if process_exec(p, "mkdir -p .ooda-cache/check " + tmpd + "/open68_pv1").is_err() { fail("mkdir"); }
    if process_exec(p, "rm -f .ooda-cache/check/g_*").is_err() { fail("wipe g_"); }
    let bak = tmpd + "/open68_pv1/hello.bak";
    if process_exec(p, "cp fixtures/hello.oo " + bak).is_err() { fail("bak"); }
    if process_exec(p, "printf '\\nfn bad() { let x: Int = \"no\"; }\\n' >> fixtures/hello.oo").is_err() {
        let _r = process_exec(p, "cp " + bak + " fixtures/hello.oo");
        fail("mutate");
    }
    let _ran = process_exec(p, "timeout 60 " + elf + " check fixtures/hello.oo > " + tmpd + "/open68_pv1/bad.out 2>" + tmpd + "/open68_pv1/bad.err");
    let had_ok = process_exec(p, "grep -qE '^OK' " + tmpd + "/open68_pv1/bad.out " + tmpd + "/open68_pv1/bad.err");
    if process_exec(p, "cp " + bak + " fixtures/hello.oo").is_err() { fail("restore"); }
    if had_ok.is_ok() { fail("mutated hello still OK"); }
    println("open68_pv1_hostile: mutated hello refused");
    println("open68_pv1_hostile: PASSED");
}
