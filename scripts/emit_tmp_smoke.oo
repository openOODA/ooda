// # Emit unnamed String temps
//
// Logline: Prove field_at and list_get bind to __tN, if/else stays one unit, while rebinds, and a literal needle stays text.
//
// Setup: OODAC_BIN is a host that emits temps. Fixtures live under fixtures/emit_tmp/.
//
// Beats:
//   1. Source has bind, own, while (1), and no skip_root or C-string hoist.
//   2. emit-c of four fixtures matches the C shape.
//   3. gcc and run print the expected lines.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "emit unnamed String temps");

    expect_clean(p, "grep -q 'oo_emit_tmp_bind' " + root + "/oodac/c_emit_temps.oo");
    expect_clean(p, "grep -q 'oo_emit_tmp_own' " + root + "/oodac/c_emit_let.oo");
    expect_clean(p, "grep -q 'while (1)' " + root + "/oodac/c_emit_stmt.oo");
    expect_clean(p, "! grep -n skip_root " + root + "/oodac/*.oo " + root + "/runtime/chs_rt_emit_tmp.c");
    expect_clean(p, "! grep -n 'c_hoist' " + root + "/oodac/*.oo");

    let fix = root + "/fixtures/emit_tmp";
    let rt = root + "/runtime";

    let _ = process_exec(p, oodac + " emit-c " + fix + "/if_else_field.oo > " + tmp + "/et_if.c 2>" + tmp + "/et_if.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_if.c " + tmp + "/et_if.err");
    expect_clean(p, "! awk '/^}/{p=1} p&&/else/{if(/oo_str_release/) f=1} /else/{p=0} END{exit f?0:1}' " + tmp + "/et_if.c");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_if.c -o " + tmp + "/et_if.bin -lm");
    expect_clean(p, tmp + "/et_if.bin 2>&1 | grep -qx A");

    let _ = process_exec(p, oodac + " emit-c " + fix + "/while_get.oo > " + tmp + "/et_w.c 2>" + tmp + "/et_w.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_w.c " + tmp + "/et_w.err");
    expect_substring(fs, tmp + "/et_w.c", "while (1)");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_w.c -o " + tmp + "/et_w.bin -lm");
    expect_clean(p, tmp + "/et_w.bin 2>&1 | grep -qx 3");

    let _ = process_exec(p, oodac + " emit-c " + fix + "/let_field.oo > " + tmp + "/et_let.c 2>" + tmp + "/et_let.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_let.c " + tmp + "/et_let.err");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_let.c -o " + tmp + "/et_let.bin -lm");
    expect_clean(p, tmp + "/et_let.bin 2>&1 | grep -qx hi");

    let _ = process_exec(p, oodac + " emit-c " + fix + "/lit_needle.oo > " + tmp + "/et_lit.c 2>" + tmp + "/et_lit.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_lit.c " + tmp + "/et_lit.err");
    expect_substring(fs, tmp + "/et_lit.c", "oo_slist_get(");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_lit.c -o " + tmp + "/et_lit.bin -lm");
    expect_clean(p, tmp + "/et_lit.bin 2>&1 | grep -q 'oo_slist_get('");

    let _ = process_exec(p, oodac + " emit-c " + fix + "/parse_get.oo > " + tmp + "/et_pg.c 2>" + tmp + "/et_pg.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_pg.c " + tmp + "/et_pg.err");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_pg.c -o " + tmp + "/et_pg.bin -lm");
    expect_clean(p, tmp + "/et_pg.bin 2>&1 | grep -qx 2");

    let _ = process_exec(p, oodac + " emit-c " + fix + "/concat_unnamed.oo > " + tmp + "/et_cat.c 2>" + tmp + "/et_cat.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/et_cat.c " + tmp + "/et_cat.err");
    expect_substring(fs, tmp + "/et_cat.c", "oo_str_concat");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/et_cat.c -o " + tmp + "/et_cat.bin -lm");
    expect_clean(p, tmp + "/et_cat.bin 2>&1 | tr '\\n' ' ' | grep -q 'hello'");

    println("emit_tmp_smoke: PASSED");
}
