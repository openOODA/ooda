// # emit-x86 match expression and tagged union lowering smoke lock
//
// Logline: emit-x86 of fixtures/x86_match.oo verifies pure x86_64 match lowering, assembles, links, and runs.
//
// Setup: Pure x86_64 as and ld on Linux. Checks tag extraction, case labels, payload binding, and join.
//
// Beats:
//   1. Initialize state parameters and validate preconditions.
//   2. Execute primary algorithmic transformation.
//   3. Return fail-closed results with deterministic error handling.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld_match(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_match_" + tag + ".s";
    let serr = tmpd + "/x86_match_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail("emit-x86 " + tag);
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(".s missing _start " + tag); }
    if expect_substring(fs, sfile, "main:").is_err() { fail(".s missing main " + tag); }
    if expect_substring(fs, sfile, "0(%rax)").is_err() { fail(".s missing 0(%rax) tag extraction " + tag); }
    if expect_substring(fs, sfile, "8(%rax)").is_err() { fail(".s missing 8(%rax) payload binding " + tag); }
    if expect_substring(fs, sfile, ".Lmatch_case_1").is_err() { fail(".s missing .Lmatch_case_1 " + tag); }
    if expect_substring(fs, sfile, ".Lmatch_case_2").is_err() { fail(".s missing .Lmatch_case_2 " + tag); }
    if expect_substring(fs, sfile, ".Lmatch_default").is_err() { fail(".s missing .Lmatch_default " + tag); }
    if expect_substring(fs, sfile, ".Lmatch_end").is_err() { fail(".s missing .Lmatch_end " + tag); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(".s looks like emit-c " + tag);
    }
    let obj = tmpd + "/x86_match_" + tag + ".o";
    let bin = tmpd + "/x86_match_" + tag + ".bin";
    let out = tmpd + "/x86_match_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    if expect_clean(p, "grep -qx '42' " + out).is_err() { fail("stdout not 42 " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 match expression and tagged union lowering").is_err() { fail("scenario"); }
    let oodac = pick_oodac(p, root);
    let src = root + "/fixtures/x86_match.oo";
    emit_as_ld_match(p, fs, oodac, src, tmpd, "r1");
    emit_as_ld_match(p, fs, oodac, src, tmpd, "r2");
    println("x86_match_smoke: PASSED");
}
