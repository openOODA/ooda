import "std/os/fs.oo";
import "std/result.oo";

pub fn main(fs: &FsReadCap, fsW: &FsWriteCap) {
    println("Testing fs_mkdir...");
    let mkdir_res = fs_mkdir(fsW, "test_fs_mut_dir");
    if mkdir_res.is_ok() {
        println("mkdir success");
    } else {
        println("mkdir failed");
    }

    println("Testing write_file...");
    let write_res = fs_write_file(fsW, "test_fs_mut_dir/file.txt", "test");
    if write_res.is_ok() {
        println("write success");
    } else {
        println("write failed");
    }

    println("Testing fs_remove_file...");
    let rm_res = fs_remove_file(fsW, "test_fs_mut_dir/file.txt");
    if rm_res.is_ok() {
        println("rm file success");
    } else {
        println("rm file failed");
    }

    let rm_dir_res = fs_remove_file(fsW, "test_fs_mut_dir");
    if rm_dir_res.is_ok() {
        println("rm dir success");
    } else {
        println("rm dir failed");
    }
}
