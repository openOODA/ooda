// # QA Matrix Residual Smoke
//
// Logline: bootstrap/QA_MATRIX.oot carries the residual marker, fail-closed wording, and non-claims; the fixture wires it via ci_product.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker | fail-closed | non-claims | fixture | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "qa matrix residual honesty");

    // when: doc + marker + fail-closed + non-claims
    expect_present(fs, "ooda/bootstrap/QA_MATRIX.oot");
    expect_substring(fs, "ooda/bootstrap/QA_MATRIX.oot", "QA_MATRIX_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + "ooda/bootstrap/QA_MATRIX.oot");
    expect_clean(p, "grep -qiE 'do \\*\\*not\\*\\* claim|not claim' " + "ooda/bootstrap/QA_MATRIX.oot");

    // then: fixture marker line
    expect_present(fs, "ooda/fixtures/qa_marker.oo");
    expect_substring(fs, "ooda/fixtures/qa_marker.oo", "QA: residual");

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "qa_matrix_residual_smoke");
    println("qa_matrix_residual_smoke: PASSED");
}
