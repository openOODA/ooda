// # S71 Guard Scan Smoke
//
// Logline: 7.1 c_guard_scan_idents — bare SECRET IDENT at println/write_file fails-closed, string literal spelling does not raise FP.
//
// Setup: Process capability and test fixtures available.
// Beats: ident refuses | write_file payload refuses | string literal OK.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/" + ".ooda-cache/ooda-tmp/s71_guard_scan");
    let _ = scenario(p, fs, "S71 guard scan idents");

    // when: ephemeral fixtures for guard rails
    let _ = write_fix(p, root + "/" + ".ooda-cache/ooda-tmp/s71_guard_scan");

    // and: bare SECRET IDENT at println + write_file fails-closed
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + ".ooda-cache/ooda-tmp/s71_guard_scan" + "/println_ident.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + ".ooda-cache/ooda-tmp/s71_guard_scan" + "/write_file_payload.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // then: string literal spelling does not raise false positive
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + ".ooda-cache/ooda-tmp/s71_guard_scan" + "/println_string_lit.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    println("s71_guard_scan_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/println_ident.oo <<'EOF'\n// 7.1 path-A: bare SECRET IDENT at println must refuse\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; println(tok); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/write_file_payload.oo <<'EOF'\n// 7.1 path-A: SECRET payload IDENT at write_file must refuse\n// SECRET: tok\npub fn main(fs: &FsCap) { let tok = \"s3cret\"; let r = write_file(fs, \"/tmp/s71_guard_scan_should_not_write\", tok); println(1); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/println_string_lit.oo <<'EOF'\n// 7.1 path-A: println(\"tok\") is a string literal, not IDENT\n// SECRET: tok\npub fn main() { println(\"tok\"); }\nEOF");
}
