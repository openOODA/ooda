// # Compiler Binary Is Not The Product CLI
//
// Logline: Scan the first present oodac path with grep -a and refuse a product-CLI copy so check never fork-bombs.
//
// Setup: cwd is ooda/. ProcessCap and FsReadCap. Never exec oodac check.
//
// Beats:
//   1. Pick oodac/oodac, else oodac_bin, else bootstrap/seed/oodac.
//   2. Fail closed if the bytes contain "pure .oo product CLI".
//   3. Print OK if the bytes contain "oodac: usage:".

import "std/scenario.oo";
import "std/os/process.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(fs: &FsReadCap) -> String {
    if path_exists(fs, "oodac/oodac") { return "oodac/oodac"; }
    if path_exists(fs, "oodac_bin") { return "oodac_bin"; }
    if path_exists(fs, "bootstrap/seed/oodac") { return "bootstrap/seed/oodac"; }
    return "";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if scenario(p, fs, "compiler vs CLI").is_err() { fail("scenario"); }
    let cand = pick_oodac(fs);
    if cand == "" {
        fail("no oodac/oodac, oodac_bin, or bootstrap/seed/oodac");
    }
    // Scan only. Exec of a CLI copy as oodac check is a fork bomb.
    if process_exec(p, "grep -a -q 'pure .oo product CLI' " + cand).is_ok() {
        fail("ERR_OODAC_IS_CLI " + cand);
    }
    if process_exec(p, "grep -a -q 'oodac: usage:' " + cand).is_err() {
        fail("no compiler usage string in " + cand);
    }
    println("OK compiler " + cand);
    println("compiler_vs_cli_smoke: PASSED");
}
