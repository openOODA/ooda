// # AGY Lang Blockers Settle Under Path A
// Logline: struct typedef + Int<0 + List[Struct] + field assign — source floor green; product exec where host permits.
// Setup: oodac/oodac + fixtures/agy_int_lt0.oo + fixtures/agy_struct_path_a.oo + runtime on disk.
// Beats: 1. struct typedef floor | 2. line budget <256 | 3. Int<0 product | 4. struct path A check + exec

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, "agy lang blockers");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — struct typedef + field-assign source floor
    fails = fails + tally(check(p, "grep -q 'c_emit_type_aliases' " + root + "/oodac/c_emit.oo && grep -q 'c_emit_one_type_alias' " + root + "/oodac/c_emit_struct.oo && grep -q 'import \"c_emit_struct.oo\"' " + root + "/oodac/main.oo", 5), "struct typedef emit source floor");
    fails = fails + tally(check(p, "grep -qE 'field assign|recv\\.field|DOT' " + root + "/oodac/c_emit_ident.oo", 5), "field assign path A");
    fails = fails + tally(check(p, "grep -q 'return tn;' " + root + "/oodac/c_emit_skip.oo", 5), "c_ty_at returns user type names");

    // and — line budget on touched files (<=256)
    let files = ["oodac/c_emit_struct.oo", "oodac/c_emit_ident.oo", "oodac/c_emit.oo", "oodac/c_emit_skip.oo", "oodac/main.oo"];
    let mut i: Int = 0;
    while i < 5 {
        let f = root + "/" + files[i];
        fails = fails + tally(check(p, "test $(wc -l <'" + f + "' | tr -d ' ') -le 256", 5), files[i] + " line budget");
        i = i + 1;
    }

    // then — Int<0 product
    let fx0 = root + "/fixtures/agy_int_lt0.oo";
    let _w1 = process_exec(p, oodac + " check " + fx0 + " > " + tmpd + "/lt0.ck 2> " + tmpd + "/lt0.cke");
    fails   = fails + tally(expect_quiet(p, "grep -qE '^OK' " + tmpd + "/lt0.ck"), "check Int < 0");
    let _w2 = process_exec(p, oodac + " build " + fx0 + " " + tmpd + "/lt0.bin > " + tmpd + "/lt0.b 2> " + tmpd + "/lt0.be");
    let _w3 = process_exec(p, tmpd + "/lt0.bin > " + tmpd + "/lt0.r 2>&1");
    fails   = fails + tally(check(p, "grep -qx -- '-1' " + tmpd + "/lt0.r && grep -qx -- '0' " + tmpd + "/lt0.r && grep -qx -- '1' " + tmpd + "/lt0.r", 5), "product Int < 0 runtime");

    // then — struct path A: check + typedef emit + exec 7/11/2
    let fxs = root + "/fixtures/agy_struct_path_a.oo";
    let _w4 = process_exec(p, oodac + " check " + fxs + " > " + tmpd + "/st.ck 2> " + tmpd + "/st.cke");
    fails   = fails + tally(expect_quiet(p, "grep -qE '^OK' " + tmpd + "/st.ck"), "check struct path A");
    let _w5 = process_exec(p, oodac + " emit-c " + fxs + " > " + tmpd + "/st.c 2> " + tmpd + "/st.err");
    fails   = fails + tally(check(p, "grep -qE 'typedef struct \\{[^}]+\\} Box;' " + tmpd + "/st.c && grep -qE 'typedef struct \\{[^}]+\\} Cell;' " + tmpd + "/st.c", 5), "emit user struct typedefs Box/Cell");
    let _w6 = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/st.c -lm -ldl -lpthread -o " + tmpd + "/st.bin 2>" + tmpd + "/st.gcc");
    let _w7 = process_exec(p, tmpd + "/st.bin > " + tmpd + "/st.r 2>&1");
    fails   = fails + tally(check(p, "grep -qx '7' " + tmpd + "/st.r && grep -qx '11' " + tmpd + "/st.r && grep -qx '2' " + tmpd + "/st.r", 5), "struct path A runtime 7/11/2");

    if fails > 0 { println("agy_lang_blockers_smoke: FAILED"); process_exit(1); }
    println("agy_lang_blockers_smoke: PASSED");
}
