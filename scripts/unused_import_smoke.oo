// # Unused import prints path and caret
//
// Logline: Cache-cold check of a dead import shows unused import, path, and ^; used import is OK.
//
// Setup: cwd is ooda/. Isolated .ooda-cache/ooda-tmp/c_lane/oodac.c1 if executable, else ./oodac/oodac.
//
// Beats:
//   1. tc_unused_import.oo prints unused import, --> path, and ^; no OK.
//   2. tc_used_import.oo prints OK.
//   3. fixtures/option_int_smoke.oo still OK (prelude import / match).

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut oodac = ".ooda-cache/ooda-tmp/c_lane/oodac.c1";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = "./oodac/oodac";
    }
    let tmpd = ".ooda-cache/ooda-tmp/unused_import";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_unused_import.oo > " + tmpd +
        "/d.out; echo $? > " + tmpd + "/d.ec; true").is_err() {
        fail("check dead");
    }
    if process_exec(p, "grep -q \"unused import\" " + tmpd +
        "/d.out && grep -q 'tc_unused_import.oo' " + tmpd +
        "/d.out && grep -Fq -- '-->' " + tmpd + "/d.out && grep -q '\\^' " +
        tmpd + "/d.out && ! grep -qE '^OK' " + tmpd +
        "/d.out && test \"$(cat " + tmpd + "/d.ec)\" -ne 0").is_err() {
        fail("no unused caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_used_import.oo > " + tmpd +
        "/u.out; echo $? > " + tmpd + "/u.ec; true").is_err() {
        fail("check used");
    }
    if process_exec(p, "grep -qE '^OK' " + tmpd + "/u.out && test \"$(cat " +
        tmpd + "/u.ec)\" -eq 0").is_err() {
        fail("used not OK");
    }
    if process_exec(p, oodac + " check fixtures/option_int_smoke.oo > " + tmpd +
        "/m.out; echo $? > " + tmpd + "/m.ec; true").is_err() {
        fail("check match");
    }
    if process_exec(p, "grep -qE '^OK' " + tmpd + "/m.out && test \"$(cat " +
        tmpd + "/m.ec)\" -eq 0").is_err() {
        fail("match not OK");
    }
    println("unused_import_smoke: PASSED");
}
