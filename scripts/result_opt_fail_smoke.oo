// # Nested Result[Option] emit is fail-closed
//
// Logline: emit-c refuses Result[Option[Int], String] and still runs Result[Int] and Option[Int] locks.
//
// Setup: cwd is ooda/. Product oodac/oodac. gcc -O2 plus chs_rt is the run path.
//
// Beats:
//   1. emit-c of result_opt_int_fail.oo is ERR c_emit and has no OoRes_Option type use.
//   2. emit-c + gcc -O2 + run result_int_smoke.oo prints PASSED.
//   3. emit-c + gcc -O2 + run option_int_smoke.oo prints PASSED.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/result_opt";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/result_opt_int_fail.oo > " + tmpd + "/fail.c 2> " +
        tmpd + "/fail.err; true").is_err() {
        fail("emit fail fixture");
    }
    if process_exec(p, "grep -qE '^ERR.c_emit' " + tmpd + "/fail.c " + tmpd +
        "/fail.err && ! grep -qE 'OoRes_Option' " + tmpd + "/fail.c").is_err() {
        fail("nested Result not residual");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/result_int_smoke.oo > " + tmpd + "/ri.c && gcc -O2 -Iruntime runtime/chs_rt.c " +
        tmpd + "/ri.c -lm -ldl -lpthread -o " + tmpd + "/ri.bin && " + tmpd +
        "/ri.bin | grep -q 'result_int_smoke: PASSED'").is_err() {
        fail("result_int");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/option_int_smoke.oo > " + tmpd + "/oi.c && gcc -O2 -Iruntime runtime/chs_rt.c " +
        tmpd + "/oi.c -lm -ldl -lpthread -o " + tmpd + "/oi.bin && " + tmpd +
        "/oi.bin | grep -q 'option_int_smoke: PASSED'").is_err() {
        fail("option_int");
    }
    println("result_opt_fail_smoke: PASSED");
}
