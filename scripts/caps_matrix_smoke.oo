// # Caps Matrix Walks Fs Sys Env Net Time Rand
// Logline: corpus deny/allow + product CLI deny + emit fail-closed without cap + runtime + forge deny across 7 families.
// Setup: oodac/oodac + bin/ooda built; bootstrap/corpus/check/{pass,fail}/ fixtures on disk; chs_rt.c linkable.
// Beats: 1. corpus deny/allow + product deny | 2. emit fail-closed + runtime | 3. forge zero + classic magic

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA",      root + "/bin/ooda").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "caps matrix");
    let passd = root + "/bootstrap/corpus/check/pass";
    let faild = root + "/bootstrap/corpus/check/fail";

    // when — corpus deny (every fail fixture)
    let _ = process_exec(p, "fail=0; for f in " + faild + "/*.oo; do [ -f \"$f\" ] || continue; base=$(basename \"$f\"); " + oodac + " check \"$f\" > " + tmpd + "/cm_${base}.out 2> " + tmpd + "/cm_${base}.err; rc=$?; if [ \"$rc\" -eq 0 ]; then fail=1; echo FAIL_CORPUS \"$base\"; elif ! grep -qE 'capability|ERR' " + tmpd + "/cm_${base}.out " + tmpd + "/cm_${base}.err 2>/dev/null; then fail=1; echo FAIL_CORPUS_ERR \"$base\"; fi; done; echo \"$fail\" > " + tmpd + "/cm_fail_count");
    let _ = check(p, "test \"$(cat " + tmpd + "/cm_fail_count 2>/dev/null || echo 1)\" -eq 0", 30);

    // and — corpus allow (every pass fixture)
    let _ = process_exec(p, "fail=0; for f in " + passd + "/*.oo; do [ -f \"$f\" ] || continue; base=$(basename \"$f\"); " + oodac + " check \"$f\" > " + tmpd + "/cm_p_${base}.out 2> " + tmpd + "/cm_p_${base}.err; rc=$?; if [ \"$rc\" -ne 0 ] || ! grep -qE '^OK' " + tmpd + "/cm_p_${base}.out; then fail=1; echo FAIL_PASS \"$base\"; fi; done; echo \"$fail\" > " + tmpd + "/cm_pass_count");
    let _ = check(p, "test \"$(cat " + tmpd + "/cm_pass_count 2>/dev/null || echo 1)\" -eq 0", 30);

    // and — product CLI deny across 7 families
    if expect_quiet(p, "test -x " + ooda).is_ok() {
        let mut i: Int = 0;
        let bases = ["no_cap_read_file", "no_cap_write_file", "no_cap_path_exists", "no_cap_file_size", "no_cap_sys_exec", "no_cap_env_get", "no_cap_fetch", "no_cap_now_ms", "no_cap_sleep_ms", "no_cap_random", "no_cap_seed", "no_cap_alloc_bytes"];
        while i < 12 {
            let base = bases[i];
            let f = faild + "/" + base + ".oo";
            let _ = process_exec(p, "test -f " + f + " && (" + ooda + " check " + f + " > " + tmpd + "/cm_prod_" + base + ".out 2> " + tmpd + "/cm_prod_" + base + ".err; rc=$?; if [ \"$rc\" -eq 0 ]; then echo 1 > " + tmpd + "/cm_prod_" + base + ".fail; else echo 0 > " + tmpd + "/cm_prod_" + base + ".fail; fi) || echo skip > " + tmpd + "/cm_prod_" + base + ".fail");
            let _ = check(p, "test \"$(cat " + tmpd + "/cm_prod_" + base + ".fail 2>/dev/null)\" != 1", 10);
            i = i + 1;
        }
    }

    // and — emit fail-closed: fetch without NetCap arg, now_ms without TimeCap arg
    let _ = process_exec(p, "printf 'pub fn main(net: &NetCap) { let r = fetch(\"http://example.invalid\"); }\\n' > " + tmpd + "/cm_net.oo");
    let _ = process_exec(p, oodac + " emit-c " + tmpd + "/cm_net.oo > " + tmpd + "/cm_net.c 2> " + tmpd + "/cm_net.err");
    let _ = check(p, "grep -qE 'ERR.c_emit..fetch requires|net residual' " + tmpd + "/cm_net.c " + tmpd + "/cm_net.err 2>/dev/null || test \"$(grep -c '^OK' " + tmpd + "/cm_net.c 2>/dev/null || echo 0)\" -eq 0", 10);
    let _ = process_exec(p, "printf 'pub fn main(time: &TimeCap) { let n = now_ms(1); }\\n' > " + tmpd + "/cm_time_bad.oo");
    let _ = process_exec(p, oodac + " emit-c " + tmpd + "/cm_time_bad.oo > " + tmpd + "/cm_time_bad.c 2> " + tmpd + "/cm_time_bad.err");
    let _ = check(p, "grep -qE 'ERR.c_emit..now_ms requires' " + tmpd + "/cm_time_bad.c " + tmpd + "/cm_time_bad.err 2>/dev/null || test \"$(grep -c '^OK' " + tmpd + "/cm_time_bad.c 2>/dev/null || echo 0)\" -eq 0", 10);

    // then — runtime Fs write+read prints fs-ok; forge zero deny
    let fsp = tmpd + "/cm_fs_round.txt";
    let _  = process_exec(p, "printf 'pub fn main(fs: &FsCap) { let w = write_file(fs, \"" + fsp + "\", \"caps-matrix-ok\"); if w.is_ok() { let r = read_file(fs, \"" + fsp + "\"); if r.is_ok() { println(\"fs-ok\"); } } }\\n' > " + tmpd + "/cm_fs.oo");
    let _  = process_exec(p, oodac + " emit-c " + tmpd + "/cm_fs.oo > " + tmpd + "/cm_fs.c 2> " + tmpd + "/cm_fs.err");
    let _  = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/cm_fs.c -o " + tmpd + "/cm_fs.bin -lm");
    let _  = process_exec(p, tmpd + "/cm_fs.bin +2>&1 || true");
    let _  = check(p, "test -x " + tmpd + "/cm_fs.bin && grep -q 'fs-ok' " + tmpd + "/cm_fs.bin.out 2>/dev/null", 30);

    println("caps_matrix_smoke: PASSED");
}
