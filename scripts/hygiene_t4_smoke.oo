// # Hygiene T4 Smoke
//
// Logline: T4 hygiene / supply-chain debris gate — oodac.bak* is gitignored; no patch_awk / boot_dbg / cap-strip debug scripts unless documented residual; tc_control_cond has no DBG_/DEBUG println.
// Setup: ooda tree (git + source); no compiler required.
//
// Beats: self bash -n | bak binaries gitignored | no patch_awk / boot_dbg / cap-strip scripts | tc_control_cond no DBG_/DEBUG.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "T4 hygiene / supply-chain debris gate");

    expect_present(fs, root + "/oodac/tc_control_cond.oo");

    when "self bash -n (syntax gate)" {
    and  "oodac/oodac.bak* gitignored if present" {
    and  "no patch_awk / boot_dbg / cap-strip scripts (or documented residual)" {
    and  "tc_control_cond has no DBG_/DEBUG println (ERR\\ttype OK)" {
    then "hygiene T4 green" {
    } } } }

    check(p, "bash -n " + root + "/scripts/hygiene_t4_smoke.sh", within: 10);

    let mut bak_files: Int = 0;
    for f in ["oodac/oodac.bak", "oodac/oodac.bak.1"] {
        if expect_present(fs, root + "/" + f).is_ok() { bak_files = bak_files + 1; }
    }
    if bak_files > 0 {
        expect_clean(p, "! git -C " + root + " ls-files --error-unmatch oodac/oodac.bak oodac/oodac.bak.* 2>/dev/null");
        expect_clean(p, "git -C " + root + " check-ignore oodac/oodac.bak oodac/oodac.bak.* 2>/dev/null || grep -qE 'oodac\\.bak' " + root + "/.gitignore");
    }

    expect_clean(p, "! find " + root + " \\( -path '*/.git/*' -o -path '*/dist/*' -o -path '*/target/*' -o -path '*/.agents/*' -o -path '*/.ooda-cache/*' \\) -prune -o -type f \\( -name 'patch_awk.sh' -o -name 'patch_awk' -o -name '*boot_dbg*' -o -name '*cap_strip*' -o -name '*strip_cap*' -o -name '*cap-strip*' \\) -print 2>/dev/null | grep -q .");

    expect_clean(p, "! grep -nE 'DBG_|DEBUG' " + root + "/oodac/tc_control_cond.oo 2>/dev/null | grep -vE 'ERR\\\\ttype' | grep -q .");

    println("hygiene_t4_smoke: PASSED");
}