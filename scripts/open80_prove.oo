// # Prove OPEN-80 org std AES emit gcc run
//
// Logline: Emit C, compile with gcc, and run std/prove_open80.oo of destubbed crypto/aes.oo.
//
// Setup: cwd is ooda/. oodac/oodac and runtime/chs_rt.c exist. import crypto/aes.oo resolves via ../std/.
//
// Beats:
//   1. Require destubbed org aes and the prove fixture.
//   2. emit-c + gcc + run prove_open80.oo.
//   3. Require open80: PASSED.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    let srcp = root + "/../std/prove_open80.oo";
    let aes = root + "/../std/crypto/aes.oo";
    if sh_mkdir_p(fw, tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "OPEN-80 org std aes emit gcc run").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, srcp).is_err() { fail("missing prove_open80.oo"); }
    if expect_present(fs, aes).is_err() { fail("missing crypto/aes.oo"); }
    if expect_clean(p, "grep -q crypto_aes_encrypt_internal " + aes).is_err() { fail("aes still stub"); }
    if expect_clean(p, "grep -q aes_encrypt " + srcp).is_err() { fail("prove missing aes_encrypt"); }

    let c: String = tmpd + "/open80.c";
    let bin: String = tmpd + "/open80.bin";
    let out: String = tmpd + "/open80.out";
    if check(p, oodac + " emit-c " + srcp + " > " + c + " 2> " + tmpd + "/open80.err", within: 30).is_err() {
        fail("emit");
    }
    if expect_clean(p, "grep -q 'main(' " + c).is_err() { fail("no main"); }
    if expect_clean(p, "! grep -qE '^ERR\\tc_emit' " + c).is_err() { fail("emit ERR"); }
    if expect_clean(p, "grep -q crypto_aes_encrypt_internal " + c).is_err() { fail("emit missing aes internal"); }
    let gcc: String = "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + c + " -o " + bin + " -lm -ldl -lpthread";
    if check(p, gcc, within: 30).is_err() { fail("gcc"); }
    if check(p, "timeout 30 " + bin + " > " + out + " 2>&1", within: 40).is_err() { fail("run"); }
    if expect_clean(p, "grep -q 'open80: PASSED' " + out).is_err() { fail("needle open80: PASSED"); }
    if expect_clean(p, "! grep -q STUB_FAIL_CLOSED " + out).is_err() { fail("aes residual stub"); }
    println("open80_prove: PASSED");
}
