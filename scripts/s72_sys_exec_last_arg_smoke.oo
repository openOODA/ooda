// # S72 Sys Exec Last Arg Smoke
//
// Logline: 7.2 c_sys_exec_last_arg — bare SECRET IDENT as last sys_exec argv fails-closed; quoted last arg with commas + secret spelling does not raise FP.
// Beats: ident refuses | quoted last arg OK.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/s72_sys_exec_last_arg";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + FIX);
    let _ = scenario(p, fs, "S72 sys_exec last arg");

    // when: ephemeral fixtures for last-arg rails
    let _ = write_fix(p, root + "/" + FIX);

    // and: bare SECRET IDENT as last sys_exec argv fails-closed
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/sys_exec_last_ident.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // then: quoted last arg with commas + SECRET spelling does not raise FP
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/sys_exec_last_quoted.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    println("s72_sys_exec_last_arg_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/sys_exec_last_ident.oo <<'EOF'\n// 7.2 path-A: bare SECRET IDENT as last sys_exec argv must refuse\n// SECRET: tok\npub fn main(sys: &SysCap) { let tok = \"s3cret\"; let r = sys_exec(sys, \"sh\", \"-c\", tok); println(1); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/sys_exec_last_quoted.oo <<'EOF'\n// 7.2 path-A: last argv is a string literal (commas + SECRET spelling) — no FP\n// SECRET: tok\npub fn main(sys: &SysCap) { let r = sys_exec(sys, \"sh\", \"-c\", \"echo hello, tok, SECRET\"); println(1); }\nEOF");
}
