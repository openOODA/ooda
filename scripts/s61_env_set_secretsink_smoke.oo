// # S61 Env Set Secret Sink Smoke
//
// Logline: 6.1 env_set SECRETSINK — bare SECRET IDENT at env_set fails-closed, string literal spelling does not raise a false positive.
//
// Setup: Process capability and test fixtures available.
// Beats: env_set ident refuses | string literal OK | setenv/unsetenv rail when product names them.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/s61_env_set_secretsink";
const PROD_GUARD: String = "ooda/oodac/c_emit_secret_guard.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + FIX);
    let _ = scenario(p, fs, "S61 env_set SECRETSINK");

    // when: ephemeral fixtures for each rail
    let _ = write_fix(p, root + "/" + FIX);

    // and: env_set ident fails-closed (emit-c + check)
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/env_set_ident.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " check " + root + "/" + FIX + "/env_set_ident.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // then: string literal does not raise false positive
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/env_set_string_lit.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // and: setenv/unsetenv rail when product names them
    expect_clean(p, "grep -qE 'sink == \"setenv\"|sid == \"setenv\"' " + root + "/" + PROD_GUARD + " || echo soft-skip");

    println("s61_env_set_secretsink_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/env_set_ident.oo <<'EOF'\n// 6.1 path-A: bare SECRET IDENT at env_set must refuse\n// SECRET: tok\npub fn main(envc: &EnvCap) { let tok = \"s3cret\"; let r = env_set(envc, \"KEY\", tok); println(1); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/env_set_string_lit.oo <<'EOF'\n// 6.1 path-A: env_set(..., \"tok\") is a string literal\n// SECRET: tok\npub fn main(envc: &EnvCap) { let r = env_set(envc, \"KEY\", \"tok\"); println(1); }\nEOF");
}
