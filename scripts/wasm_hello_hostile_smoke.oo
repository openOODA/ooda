// # Hostile hello extra println lock
//
// Logline: emit-wasm of greet plus println other must not be a greet-only print module.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_hello_hostile.oo.
//   2. ERR wasm is honest and passes.
//   3. A module must include other or print nothing; greet-only stdout fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm hello hostile extra print").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_hello_hostile.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_hello_hostile.wasm";
    let errf = tmpd + "/wasm_hello_hostile.err";
    let out = tmpd + "/wasm_hello_hostile.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_hello_hostile.oo > " + wasm + " 2>" + errf).is_err() {
        if expect_quiet(p, "grep -q ERR " + errf).is_ok() {
            println("wasm_hello_hostile_smoke: PASSED");
            return;
        }
    }
    if expect_quiet(p, "grep -qE '^ERR' " + errf + " " + wasm).is_ok() {
        println("wasm_hello_hostile_smoke: PASSED");
        return;
    }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        fail("magic");
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q 'Hello, openOODA Developer!' " + out).is_ok() {
            if expect_quiet(p, "grep -q other " + out).is_err() {
                fail("greet-only print");
            }
        }
    } else {
        if expect_quiet(p, "grep -a -q 'Hello, openOODA Developer!' " + wasm).is_ok() {
            if expect_quiet(p, "grep -a -q other " + wasm).is_err() {
                fail("greet-only bytes");
            }
        }
    }
    println("wasm_hello_hostile_smoke: PASSED");
}
