// # JSON error rails
//
// Logline: Drive oodac check JSON mode on pass and fail corpus files and assert the error arrays.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Check a passing main and expect an empty errors array.
//   2. Check cap, undef, parse, and secret fails.
//   3. Assert each rail's JSON carries the expected error.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/str.oo";

// Helper to extract the process output string (stdout/stderr) from the Result
fn get_out(r: Result[String, String]) -> String {
    return match r {
        Ok(x) => x,
        Err(y) => y,
    };
}

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();

    let ooda = "bin/ooda";
    let oodac = "oodac/oodac";
    let pass_f = "bootstrap/corpus/check/pass/ok_main.oo";
    let cap_f = "bootstrap/corpus/check/fail/no_cap_fetch.oo";
    let undef_f = "bootstrap/corpus/typecheck/fail/undefined_var.oo";
    let parse_f = "bootstrap/corpus/parse/fail/missing_brace.oo";
    let secret_f = "fixtures/secret_sink_fail.oo";

    // 1. pass: empty errors array
    let mut cmd1: List[String] = cmd_new(oodac);
    cmd1 = cmd_arg(cmd1, "check");
    cmd1 = cmd_arg(cmd1, pass_f);
    cmd1 = cmd_arg(cmd1, "--json-errors");
    
    let r1: Result[String, String] = cmd_execute(cmd1, p);
    tr = test_assert(tr, "oodac pass exit=0", r1.is_ok());
    let out1 = get_out(r1);
    tr = test_assert(tr, "oodac check --json-errors pass -> []", str_contains(out1, "[]"));

    // 2. fail: capability
    let mut cmd2: List[String] = cmd_new(oodac);
    cmd2 = cmd_arg(cmd2, "check");
    cmd2 = cmd_arg(cmd2, cap_f);
    cmd2 = cmd_arg(cmd2, "--json-errors");
    
    let r2: Result[String, String] = cmd_execute(cmd2, p);
    tr = test_assert(tr, "oodac cap should fail", r2.is_err());
    let out2 = get_out(r2);
    tr = test_assert(tr, "oodac check --json-errors cap -> E_CAP", str_contains(out2, "\"E_CAP\""));
    tr = test_assert(tr, "oodac check --json-errors cap -> fix_hint", str_contains(out2, "\"fix_hint\""));
    tr = test_assert(tr, "oodac check --json-errors cap -> suggested_fix", str_contains(out2, "\"suggested_fix\""));
    tr = test_assert(tr, "oodac check --json-errors cap -> kind", str_contains(out2, "CapabilitySecurityViolation"));

    // 3. fail: undefined var
    let mut cmd3: List[String] = cmd_new(oodac);
    cmd3 = cmd_arg(cmd3, "check");
    cmd3 = cmd_arg(cmd3, undef_f);
    cmd3 = cmd_arg(cmd3, "--json-errors");
    
    let r3: Result[String, String] = cmd_execute(cmd3, p);
    tr = test_assert(tr, "oodac undef should fail", r3.is_err());
    let out3 = get_out(r3);
    tr = test_assert(tr, "oodac check --json-errors undef -> E_TC", str_contains(out3, "\"E_TC\""));
    tr = test_assert(tr, "oodac check --json-errors undef -> fix_hint", str_contains(out3, "\"fix_hint\""));

    // 4. fail: parse
    let mut cmd4: List[String] = cmd_new(oodac);
    cmd4 = cmd_arg(cmd4, "check");
    cmd4 = cmd_arg(cmd4, parse_f);
    cmd4 = cmd_arg(cmd4, "--json-errors");
    
    let r4: Result[String, String] = cmd_execute(cmd4, p);
    tr = test_assert(tr, "oodac parse should fail", r4.is_err());
    let out4 = get_out(r4);
    tr = test_assert(tr, "oodac check --json-errors parse -> E_PARSE", str_contains(out4, "\"E_PARSE\""));
    tr = test_assert(tr, "oodac check --json-errors parse -> fix_hint", str_contains(out4, "\"fix_hint\""));

    // 5. product CLI forwards: ooda pass
    let mut cmd5: List[String] = cmd_new(ooda);
    cmd5 = cmd_arg(cmd5, "check");
    cmd5 = cmd_arg(cmd5, pass_f);
    cmd5 = cmd_arg(cmd5, "--json-errors");
    
    let r5: Result[String, String] = cmd_execute(cmd5, p);
    tr = test_assert(tr, "ooda check --json-errors pass exit=0", r5.is_ok());
    let out5 = get_out(r5);
    tr = test_assert(tr, "ooda check --json-errors forwards (pass)", str_contains(out5, "[]"));

    // 6. product CLI forwards: ooda cap
    let mut cmd6: List[String] = cmd_new(ooda);
    cmd6 = cmd_arg(cmd6, "check");
    cmd6 = cmd_arg(cmd6, cap_f);
    cmd6 = cmd_arg(cmd6, "--json-errors");
    
    let r6: Result[String, String] = cmd_execute(cmd6, p);
    tr = test_assert(tr, "ooda cap should fail", r6.is_err());
    let out6 = get_out(r6);
    tr = test_assert(tr, "ooda check --json-errors cap -> E_CAP", str_contains(out6, "\"E_CAP\""));
    tr = test_assert(tr, "ooda check --json-errors cap -> fix_hint", str_contains(out6, "\"fix_hint\""));

    // 7. -json alias on oodac
    let mut cmd7: List[String] = cmd_new(oodac);
    cmd7 = cmd_arg(cmd7, "check");
    cmd7 = cmd_arg(cmd7, cap_f);
    cmd7 = cmd_arg(cmd7, "-json");
    
    let r7: Result[String, String] = cmd_execute(cmd7, p);
    tr = test_assert(tr, "oodac -json alias should fail on cap", r7.is_err());
    let out7 = get_out(r7);
    tr = test_assert(tr, "oodac -json alias -> E_CAP", str_contains(out7, "\"E_CAP\""));

    // 8. Secret path
    let mut cmd8: List[String] = cmd_new(oodac);
    cmd8 = cmd_arg(cmd8, "check");
    cmd8 = cmd_arg(cmd8, "--json-errors");
    cmd8 = cmd_arg(cmd8, secret_f);
    
    let r8: Result[String, String] = cmd_execute(cmd8, p);
    tr = test_assert(tr, "oodac secret json should fail", r8.is_err());
    let out8 = get_out(r8);
    tr = test_assert(tr, "oodac check --json-errors secret -> E_SECRET", str_contains(out8, "\"E_SECRET\""));
    tr = test_assert(tr, "oodac check --json-errors secret -> fix_hint", str_contains(out8, "\"fix_hint\""));

    test_summary(tr);
}
