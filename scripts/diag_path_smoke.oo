// # Check prints path and local line:col
//
// Logline: Cache-cold check of Int="hi" names the .oo path; sum_miss_arm still needs Off.
//
// Setup: cwd is ooda/. Product oodac/oodac. Check runs from a temp dir so cache cannot reprint OK.
//
// Beats:
//   1. tc_int_hi.oo ERR type includes Type error at with line under 50 and the path.
//   2. sum_miss_arm.oo needs Off and does not print OK.
//   3. Both checks exit non-zero.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/diag_path";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -q 'Type error at 13:' " + tmpd + "/hi.out").is_err() {
        fail("no local line");
    }
    if process_exec(p, "grep -q 'tc_int_hi.oo' " + tmpd + "/hi.out && test \"$(cat " +
        tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("no path");
    }
    if process_exec(p, oodac + " check fixtures/sum_miss_arm.oo > " + tmpd +
        "/miss.out; echo $? > " + tmpd + "/miss.ec; true").is_err() {
        fail("check miss");
    }
    if process_exec(p, "grep -q 'non-exhaustive match: Flag needs Off' " + tmpd +
        "/miss.out && ! grep -qE '^OK' " + tmpd + "/miss.out && test \"$(cat " +
        tmpd + "/miss.ec)\" -ne 0").is_err() {
        fail("miss Off");
    }
    println("diag_path_smoke: PASSED");
}
