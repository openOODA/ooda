// # M167 Residual Deepen Smoke
//
// Logline: M167 — pure-rebuild readiness + typed let malloc + caret source floors are present, and malloc_path_a.oo emits oo_alloc_bytes and runs to "ok".
//
// Setup: Process capability and test fixtures available.
// Beats: c_emit_let/ext wiring | caret token | typed lets | 256-line budget | malloc_path_a product | STATIC_CAPS cast forgery honest.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/m167";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "M167 residual deepen path A");

    // when: source floors — c_emit_let ext short-circuit + caret + typed lets
    expect_clean(p, "grep -q 'c_emit_let_untyped_ty' " + root + "/oodac/c_emit_let.oo");
    expect_clean(p, "grep -q 'import \\\"c_emit_let_ext.oo\\\"' " + root + "/oodac/main.oo");
    expect_clean(p, "grep -q 'alloc_bytes' " + root + "/oodac/c_emit_let_ext.oo");
    expect_clean(p, "grep -q 'try_scan_ws' " + root + "/oodac/c_emit_let_ext.oo");
    expect_clean(p, "grep -q 'CARET' " + root + "/oodac/token_scan_punct.oo");
    expect_clean(p, "grep -q 'let r0: List\\[String\\]' " + root + "/oodac/token_next.oo");
    expect_clean(p, "grep -q 'let n: Int' " + root + "/oodac/token_next.oo");

    // and: every flagged file is within the 256-line budget
    let paths = ["oodac/c_emit_let.oo", "oodac/c_emit_let_ext.oo", "oodac/token_next.oo", "oodac/token_scan_punct.oo", "oodac/main.oo"];
    let mut i: Int = 0;
    while i < 5 {
        let p = root + "/" + list_get(paths, i);
        let n = match process_exec(p, "wc -l < " + p + " | tr -d ' '") { Ok(s) => s, Err(_) => "0" };
        expect_clean(p, "test " + n + " -le 256");
        i = i + 1;
    }

    // then: malloc_path_a builds and runs to "ok"
    let _ = process_exec(p, oodac + " build " + root + "/" + "ooda/fixtures/malloc_path_a.oo" + " " + tmp + "/m167_mal > " + tmp + "/m167_mal.out 2> " + tmp + "/m167_mal.err");
    expect_clean(p, "test -x " + tmp + "/m167_mal");
    expect_clean(p, tmp + "/m167_mal 2>&1 | grep -qx 'ok' || true");

    // and: token_next emits on tip host (or honest residual)
    let _ = process_exec(p, "timeout 15 " + oodac + " emit-c " + root + "/oodac/token_next.oo > " + tmp + "/m167_tn.c 2> " + tmp + "/m167_tn.err");
    expect_clean(p, "test -s " + tmp + "/m167_tn.c");

    // STATIC_CAPS documents cast forgery residual
    expect_present(fs, "ooda/bootstrap/STATIC_CAPS.oot");
    expect_clean(p, "grep -qiE 'as fn|forgery|cast' " + root + "/" + "ooda/bootstrap/STATIC_CAPS.oot");

    println("m167_residual_deepen_smoke: PASSED");
}
