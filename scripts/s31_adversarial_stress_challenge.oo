// # Stage 31 Adversarial Stress & Empirical Challenge Suite
//
// Logline: Exhaustive adversarial challenge harness stress-testing Level 2 mutation operators, fault injection traps, boundary conditions, and zero-happy-path audits.
//
// Setup: Invoked by Stage 31 Empirical Challenger under ProcessCap to independently verify mathematical correctness and fail-closed trapping.
//
// Beats:
//   1. Stress test Level 2 mutation operators with edge tokens, unknown symbols, dual-site compounds, and 64-bit boundary integers.
//   2. Stress test mutation score calculator across exact boundary percentages (94%, 95%, 0%, 100%) and certification gate enforcement.
//   3. Stress test fault injection generators across negative slices, inverted bounds, OOB indices, capability tokens, and Byzantine mutations.
//   4. Stress test fault trap evaluator with non-fail-closed vectors to verify escape detection.
//   5. Stress test zero-happy-path domain validator and auditor against degenerate domain suites (zero negative probes, low kill rate, negative counts).
// RULES.oot 1.4: Adversarial test verification.
// RULES.oot 1.7: Strictly under 256 lines.

import "test/mutation_l2.oo";
import "test/fault_injection.oo";
import "test/adversarial_probe.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" Stage 31 Empirical Challenge: Level 2 Mutation & Fault Injection");
    println("===================================================================");

    // -------------------------------------------------------------
    // Challenge 1: Mutation Operators & Boundary Integers
    // -------------------------------------------------------------
    // 1.1 Relational operator mutations & unknown fallback
    if l2_mutate_relational("<") != "<=" { println("FAIL: C1.1 < -> <="); process_exit(1); }
    if l2_mutate_relational("<=") != "<" { println("FAIL: C1.1 <= -> <"); process_exit(1); }
    if l2_mutate_relational(">") != ">=" { println("FAIL: C1.1 > -> >="); process_exit(1); }
    if l2_mutate_relational(">=") != ">" { println("FAIL: C1.1 >= -> >"); process_exit(1); }
    if l2_mutate_relational("==") != "!=" { println("FAIL: C1.1 == -> !="); process_exit(1); }
    if l2_mutate_relational("!=") != "==" { println("FAIL: C1.1 != -> =="); process_exit(1); }
    if l2_mutate_relational("===") != "===" { println("FAIL: C1.1 unrecognized relational token"); process_exit(1); }
    if l2_mutate_relational("") != "" { println("FAIL: C1.1 empty token"); process_exit(1); }

    // 1.2 Arithmetic operator mutations & unknown fallback
    if l2_mutate_arithmetic("+") != "-" { println("FAIL: C1.2 + -> -"); process_exit(1); }
    if l2_mutate_arithmetic("-") != "+" { println("FAIL: C1.2 - -> +"); process_exit(1); }
    if l2_mutate_arithmetic("*") != "/" { println("FAIL: C1.2 * -> /"); process_exit(1); }
    if l2_mutate_arithmetic("/") != "*" { println("FAIL: C1.2 / -> *"); process_exit(1); }
    if l2_mutate_arithmetic("%") != "*" { println("FAIL: C1.2 % -> *"); process_exit(1); }
    if l2_mutate_arithmetic("**") != "**" { println("FAIL: C1.2 unrecognized arithmetic token"); process_exit(1); }

    // 1.3 Logical operator mutations & unknown fallback
    if l2_mutate_logical("&&") != "||" { println("FAIL: C1.3 && -> ||"); process_exit(1); }
    if l2_mutate_logical("||") != "&&" { println("FAIL: C1.3 || -> &&"); process_exit(1); }
    if l2_mutate_logical("!") != "id" { println("FAIL: C1.3 ! -> id"); process_exit(1); }
    if l2_mutate_logical("and") != "and" { println("FAIL: C1.3 unrecognized logical token"); process_exit(1); }

    // 1.4 Boundary integer mutations (0, -1, INT_MAX, INT_MIN)
    if l2_mutate_boundary_int(0, 1) != 1 { println("FAIL: C1.4 int 0 + 1"); process_exit(1); }
    if l2_mutate_boundary_int(0, -1) != -1 { println("FAIL: C1.4 int 0 - 1"); process_exit(1); }
    if l2_mutate_boundary_int(0, 0) != -1 { println("FAIL: C1.4 int 0 perturbation"); process_exit(1); }
    if l2_mutate_boundary_int(-1, 1) != 0 { println("FAIL: C1.4 int -1 + 1"); process_exit(1); }
    if l2_mutate_boundary_int(-1, -1) != -2 { println("FAIL: C1.4 int -1 - 1"); process_exit(1); }
    if l2_mutate_boundary_int(-1, 0) != 0 { println("FAIL: C1.4 int -1 reset"); process_exit(1); }
    if l2_mutate_boundary_int(2147483647, 1) != 2147483648 { println("FAIL: C1.4 INT32_MAX + 1"); process_exit(1); }
    if l2_mutate_boundary_int(2147483647, -1) != 2147483646 { println("FAIL: C1.4 INT32_MAX - 1"); process_exit(1); }

    // 1.5 Compound 2x AST Mutants
    let c2x: L2Mutant = l2_mutate_compound_2x(99, 120, "x == y", "x != y", "a + b", "a - b");
    if !c2x.is_compound_2x || c2x.mutant_id != 99 || c2x.target_line != 120 {
        println("FAIL: C1.5 compound 2x mutant properties");
        process_exit(1);
    }
    if c2x.original_expr != "x == y ; a + b" || c2x.mutated_expr != "x != y ; a - b" {
        println("FAIL: C1.5 compound 2x mutant expressions");
        process_exit(1);
    }
    println("  [CHALLENGE PASS] 1. Level 2 Mutation Operators & Boundary Integers");

    // -------------------------------------------------------------
    // Challenge 2: Score Calculator & Gate Certification Oracle
    // -------------------------------------------------------------
    let s_zero: L2MutationScore = l2_calculate_score(0, 0);
    if s_zero.score_percentage != 0 || s_zero.is_l2_certified { println("FAIL: C2 score zero"); process_exit(1); }
    if l2_assert_gate_passed(s_zero).is_ok() { println("FAIL: C2 zero gate must fail"); process_exit(1); }

    let s_94: L2MutationScore = l2_calculate_score(100, 94);
    if s_94.score_percentage != 94 || s_94.is_l2_certified { println("FAIL: C2 score 94%"); process_exit(1); }
    if l2_assert_gate_passed(s_94).is_ok() { println("FAIL: C2 94% gate must fail"); process_exit(1); }

    let s_95: L2MutationScore = l2_calculate_score(100, 95);
    if s_95.score_percentage != 95 || !s_95.is_l2_certified { println("FAIL: C2 score 95%"); process_exit(1); }
    if l2_assert_gate_passed(s_95).is_err() { println("FAIL: C2 95% gate must pass"); process_exit(1); }

    let s_500_94: L2MutationScore = l2_calculate_score(500, 474);
    if s_500_94.score_percentage != 94 || s_500_94.is_l2_certified { println("FAIL: C2 474/500 score"); process_exit(1); }

    let s_500_95: L2MutationScore = l2_calculate_score(500, 475);
    if s_500_95.score_percentage != 95 || !s_500_95.is_l2_certified { println("FAIL: C2 475/500 score"); process_exit(1); }

    println("  [CHALLENGE PASS] 2. Score Calculation & 95% Certification Gate");

    // -------------------------------------------------------------
    // Challenge 3: Fault Injection Vectors & Fail-Closed Trap Oracle
    // -------------------------------------------------------------
    let s_bounds_neg: List[Int] = fault_corrupt_slice_bounds(-5, 10, 20);
    if list_len(s_bounds_neg) != 2 || list_get(s_bounds_neg, 0) != 15 || list_get(s_bounds_neg, 1) != 10 {
        println("FAIL: C3 negative slice corruption");
        process_exit(1);
    }

    let oob_pos: Int = fault_corrupt_memory_index(0, 1024);
    if oob_pos != 1088 { println("FAIL: C3 memory index positive OOB"); process_exit(1); }

    let oob_neg: Int = fault_corrupt_memory_index(-10, 1024);
    if oob_neg != -1 { println("FAIL: C3 memory index negative OOB"); process_exit(1); }

    let cap_inv: Int = fault_corrupt_cap_token(42);
    if cap_inv != -43 { println("FAIL: C3 capability token bit inversion"); process_exit(1); }

    let cap_neg_inv: Int = fault_corrupt_cap_token(-5);
    if cap_neg_inv != 0 { println("FAIL: C3 capability negative token reset"); process_exit(1); }

    let byz_root: String = fault_corrupt_state_root("0x_genesis_root_hash");
    if byz_root != "0x_tampered_byzantine_state_root" { println("FAIL: C3 Byzantine state root"); process_exit(1); }

    // Verify fault trap fail-closed oracle
    let v_pass: FaultVector = fault_vector_new(1, "std/mem", "oob", "payload");
    if fault_evaluate_trap(v_pass).is_err() { println("FAIL: C3 fault trap expected fail-closed"); process_exit(1); }

    let v_escape: FaultVector = fault_vector_escape(2, "std/mem", "oob", "payload");
    let escape_res: Result[Bool, String] = fault_evaluate_trap(v_escape);
    if escape_res.is_ok() {
        println("FAIL: C3 fault trap must detect escape when expected_fail_closed is false");
        process_exit(1);
    }

    // Verify resilience aggregation
    let f_rep_low: FaultInjectionReport = fault_report_aggregate(100, 94);
    if f_rep_low.is_hardened || f_rep_low.resilience_percentage != 94 || f_rep_low.unhandled_faults != 6 {
        println("FAIL: C3 low resilience report");
        process_exit(1);
    }

    let f_rep_high: FaultInjectionReport = fault_report_aggregate(100, 95);
    if !f_rep_high.is_hardened || f_rep_high.resilience_percentage != 95 || f_rep_high.unhandled_faults != 5 {
        println("FAIL: C3 high resilience report");
        process_exit(1);
    }

    println("  [CHALLENGE PASS] 3. Fault Injection Vectors & Fail-Closed Trap Oracle");

    // -------------------------------------------------------------
    // Challenge 4: Zero Happy-Path Auditor & Degenerate Domain Detection
    // -------------------------------------------------------------
    // 4.1 Degenerate Domain: 0 negative probes
    let p_zero_neg: StdDomainProbe = adversarial_probe_create_domain("std/degenerate_zero", 100, 0, 0);
    if !p_zero_neg.has_zero_happy_path_violation {
        println("FAIL: C4.1 zero negative probe violation flag not set");
        process_exit(1);
    }
    let val_zero_res: Result[Bool, String] = adversarial_probe_validate_domain(p_zero_neg);
    if val_zero_res.is_ok() {
        println("FAIL: C4.1 zero negative probe validation must return Err");
        process_exit(1);
    }

    // 4.2 Degenerate Domain: Negative negative probe count
    let p_neg_cnt: StdDomainProbe = adversarial_probe_create_domain("std/degenerate_neg_cnt", 100, -1, 0);
    if !p_neg_cnt.has_zero_happy_path_violation {
        println("FAIL: C4.2 negative probe count violation flag not set");
        process_exit(1);
    }
    let val_neg_res: Result[Bool, String] = adversarial_probe_validate_domain(p_neg_cnt);
    if val_neg_res.is_ok() {
        println("FAIL: C4.2 negative probe count validation must return Err");
        process_exit(1);
    }

    // 4.3 Degenerate Domain: Low kill rate (94% < 95%)
    let p_low_kill: StdDomainProbe = adversarial_probe_create_domain("std/degenerate_low_kill", 100, 100, 94);
    if p_low_kill.has_zero_happy_path_violation {
        println("FAIL: C4.3 low kill rate domain has no zero-probe violation flag");
        process_exit(1);
    }
    let val_low_res: Result[Bool, String] = adversarial_probe_validate_domain(p_low_kill);
    if val_low_res.is_ok() {
        println("FAIL: C4.3 low kill rate domain must fail validation with Err");
        process_exit(1);
    }

    // 4.4 Boundary Compliant Domain: Exactly 95% kill rate
    let p_exact_95: StdDomainProbe = adversarial_probe_create_domain("std/exact_95", 100, 100, 95);
    let val_95_res: Result[Bool, String] = adversarial_probe_validate_domain(p_exact_95);
    if val_95_res.is_err() {
        println("FAIL: C4.4 exactly 95% domain must pass validation");
        process_exit(1);
    }

    // 4.5 Full Audit Harness with Degenerate Injection
    let mut bad_suite: List[StdDomainProbe] = adversarial_probe_generate_domain_suite();
    bad_suite = list_push(bad_suite, p_zero_neg);
    let bad_audit: DomainAuditReport = adversarial_probe_audit_all(bad_suite);
    let bad_app: Bool = bad_audit.is_audit_approved;
    let bad_comp: Int = bad_audit.compliant_domains;
    let bad_tot: Int = bad_audit.total_domains;
    if bad_app || bad_comp != 6 || bad_tot != 7 {
        println("FAIL: C4.5 audit_all must reject suite containing degenerate zero-negative domain");
        process_exit(1);
    }

    let mut low_suite: List[StdDomainProbe] = adversarial_probe_generate_domain_suite();
    low_suite = list_push(low_suite, p_low_kill);
    let low_audit: DomainAuditReport = adversarial_probe_audit_all(low_suite);
    let low_app: Bool = low_audit.is_audit_approved;
    let low_comp: Int = low_audit.compliant_domains;
    let low_tot: Int = low_audit.total_domains;
    if low_app || low_comp != 6 || low_tot != 7 {
        println("FAIL: C4.5 audit_all must reject suite containing low-kill domain");
        process_exit(1);
    }

    println("  [CHALLENGE PASS] 4. Zero Happy-Path Auditor & Degenerate Domain Detection");

    println("===================================================================");
    println("s31_adversarial_stress_challenge: ALL EMPIRICAL CHALLENGES PASSED");
}
