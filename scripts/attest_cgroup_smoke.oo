// # Attestation and cgroup v2 verification smoke
//
// Logline: Smoke runner verifying hardware attestation, entropy health, monotonic clock, and cgroup quotas.
//
// Setup: Imports attest and cgroup facades, runs basic smoke tests to ensure compiler and runtime sanity.
//
// Beats:
//   1. Verify PCR bank extension and composite digest hashing.
//   2. Verify NIST SP 800-90B RCT health check on pseudo-random sequence.
//   3. Verify cgroups v2 memory and CPU quota configuration.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "src/ooda/sec/attest/attest.oo";
import "src/ooda/os/cgroup/cgroup.oo";

pub fn main() {
    let mut bank: PcrBank = pcr_bank_empty("smoke_sha256", "SHA256");
    bank = pcr_bank_extend(bank, 0, "smoke_meas_0");
    if chars_len(bank.digest) == 0 {
        println("FAIL: PCR bank empty digest");
        process_exit(1);
    }

    let mut samples: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        samples = list_push(samples, (i * 17) % 256);
        i = i + 1;
    }
    let rct: Result[Int, String] = entropy_rct_test(samples, 8);
    if rct.is_err() {
        println("FAIL: RCT test failed on valid sample");
        process_exit(1);
    }

    let mut quota: CgroupQuota = cgroup_quota_create("smoke_cg", "/sys/fs/cgroup/smoke_cg", 1048576, 10000, 100000, 32);
    let audit: Result[String, String] = cgroup_quota_audit_process(quota, 500000, 10, 2, 8);
    if audit.is_err() {
        println("FAIL: Cgroup quota audit failed");
        process_exit(1);
    }

    println("attest_cgroup_smoke: OK");
}
