// # Hardware attestation and cgroups v2 resource smoke
//
// Logline: Smoke validation for TPM quotes, entropy health checks, monotonic time, and cgroups v2 quotas.
//
// Setup: Exercises oodac typechecking over all Attest and Cgroup standard modules and validates fixture integrity.
//
// Beats:
//   1. Verify oodac check on Hardware Attestation modules (types, tpm_quote, entropy_health, monotonic_time, attest).
//   2. Verify oodac check on Cgroups v2 and OS Resource Quotas modules (types, cgroup_v2, rlimit_quota, cgroup).
//   3. Verify oodac check on the integrated attest_cgroup_fixture.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = root + "/oodac/oodac";
    let std_root = root + "/../std";
    let _ = scenario(p, fs, "Hardware Attestation and Cgroups Quotas Smoke");

    // Beat 1: Check Hardware Attestation modules
    check(p, oodac + " check " + std_root + "/src/ooda/sec/attest/attest_types.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/attest/tpm_quote.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/attest/entropy_health.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/attest/monotonic_time.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/attest/attest.oo", within: 15);

    // Beat 2: Check Cgroups v2 & OS Resource Quota modules
    check(p, oodac + " check " + std_root + "/src/ooda/os/cgroup/cgroup_types.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/os/cgroup/cgroup_v2.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/os/cgroup/rlimit_quota.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/os/cgroup/cgroup.oo", within: 15);

    // Beat 3: Check Integrated Attestation & Cgroup Fixture
    check(p, oodac + " check " + root + "/fixtures/attest_cgroup_fixture.oo", within: 30);

    println("attest_cgroup_smoke: PASSED");
}
