// # Cap G3 Grant Inject Lowers Per-Cap Main
// Logline: main(http: &HttpCap) injects oo_cap_grant_http; same for fsread/tcp; combined main injects all three.
// Setup: oodac/oodac built; oodac/c_emit_fn.oo + c_emit_preamble.oo on disk.
// Beats: 1. c_emit_fn static markers | 2. single-cap main inject | 3. combined main inject

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — static c_emit_fn markers
    fails = fails + tally(check(p, "grep -q 'oo_cap_grant_http' " + root + "/oodac/c_emit_fn.oo && grep -q 'oo_cap_grant_fsread' " + root + "/oodac/c_emit_fn.oo && grep -q 'oo_cap_grant_tcp' " + root + "/oodac/c_emit_fn.oo", 5), "c_emit_fn grant_http/fsread/tcp");
    fails = fails + tally(expect_quiet(p, "grep -q 'oo_cap_grant_http' " + root + "/oodac/c_emit_preamble.oo && grep -q 'oo_cap_grant_fsread' " + root + "/oodac/c_emit_preamble.oo; true"), "c_emit_preamble granular decls (soft)");

    // and — single-cap main inject
    let _w1 = process_exec(p, "printf 'pub fn main(http: &HttpCap) {}\\n' > " + tmpd + "/cap_g3_http.oo");
    let _w2 = process_exec(p, "printf 'pub fn main(fsread: &FsReadCap) {}\\n' > " + tmpd + "/cap_g3_fsread.oo");
    let _w3 = process_exec(p, "printf 'pub fn main(tcp: &TcpCap) {}\\n' > " + tmpd + "/cap_g3_tcp.oo");

    let mut k: Int = 0;
    let bases  = ["cap_g3_http", "cap_g3_fsread", "cap_g3_tcp"];
    let pats   = ["oo_cap_grant_http", "oo_cap_grant_fsread", "oo_cap_grant_tcp"];
    let labels = ["main(http: &HttpCap)", "main(fsread: &FsReadCap)", "main(tcp: &TcpCap)"];
    while k < 3 {
        let _w = process_exec(p, oodac + " emit-c " + tmpd + "/" + bases[k] + ".oo > " + tmpd + "/" + bases[k] + ".c 2> " + tmpd + "/" + bases[k] + ".err");
        fails  = fails + tally(check(p, "! grep -qE '^ERR' " + tmpd + "/" + bases[k] + ".c 2>/dev/null && grep -qE '" + pats[k] + "' " + tmpd + "/" + bases[k] + ".c", 30), "emit-c " + labels[k]);
        k = k + 1;
    }

    // then — combined main injects all three grants
    let _w4 = process_exec(p, "printf 'pub fn main(http: &HttpCap, fsread: &FsReadCap, tcp: &TcpCap) {}\\n' > " + tmpd + "/cap_g3_all.oo");
    let _w5 = process_exec(p, oodac + " emit-c " + tmpd + "/cap_g3_all.oo > " + tmpd + "/cap_g3_all.c 2> " + tmpd + "/cap_g3_all.err");
    fails   = fails + tally(check(p, "! grep -qE '^ERR' " + tmpd + "/cap_g3_all.c 2>/dev/null && grep -q 'oo_cap_grant_http' " + tmpd + "/cap_g3_all.c + " + tmpd + "/cap_g3_all.c | grep -q 'oo_cap_grant_fsread' && grep -q 'oo_cap_grant_tcp' " + tmpd + "/cap_g3_all.c", 30), "emit-c multi HttpCap+FsReadCap+TcpCap grants");

    // soft — ci_product wire
    fails = fails + tally(expect_quiet(p, "grep -q 'cap_g3_grant_inject_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true"), "ci_product wire (soft)");

    if fails > 0 { println("cap_g3_grant_inject_smoke: FAILED"); process_exit(1); }
    println("cap_g3_grant_inject_smoke: PASSED");
}
