// # Cap G3 Grant Inject Lowers Per-Cap Main
// Logline: main(http: &HttpCap) injects oo_cap_grant_http; same for fsread/tcp; combined main injects all three.
// Setup: oodac/oodac built; oodac/c_emit_fn.oo + c_emit_preamble.oo on disk.
// Beats: 1. c_emit_fn static markers | 2. single-cap main inject | 3. combined main inject

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "cap g3 grant inject");

    // when — static c_emit_fn markers
    let _ = check(p, "grep -q 'oo_cap_grant_http' " + root + "/oodac/c_emit_fn.oo && grep -q 'oo_cap_grant_fsread' " + root + "/oodac/c_emit_fn.oo && grep -q 'oo_cap_grant_tcp' " + root + "/oodac/c_emit_fn.oo", 5);
    let _ = expect_quiet(p, "grep -q 'oo_cap_grant_http' " + root + "/oodac/c_emit_preamble.oo && grep -q 'oo_cap_grant_fsread' " + root + "/oodac/c_emit_preamble.oo; true");

    // and — single-cap main inject
    let _ = process_exec(p, "printf 'pub fn main(http: &HttpCap) {}\\n' > " + tmpd + "/cap_g3_http.oo");
    let _ = process_exec(p, "printf 'pub fn main(fsread: &FsReadCap) {}\\n' > " + tmpd + "/cap_g3_fsread.oo");
    let _ = process_exec(p, "printf 'pub fn main(tcp: &TcpCap) {}\\n' > " + tmpd + "/cap_g3_tcp.oo");

    let mut k: Int = 0;
    let bases = ["cap_g3_http", "cap_g3_fsread", "cap_g3_tcp"];
    let pats  = ["oo_cap_grant_http", "oo_cap_grant_fsread", "oo_cap_grant_tcp"];
    while k < 3 {
        let _ = process_exec(p, oodac + " emit-c " + tmpd + "/" + bases[k] + ".oo > " + tmpd + "/" + bases[k] + ".c 2> " + tmpd + "/" + bases[k] + ".err");
        let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/" + bases[k] + ".c 2>/dev/null && grep -qE '" + pats[k] + "' " + tmpd + "/" + bases[k] + ".c", 30);
        k = k + 1;
    }

    // then — combined main injects all three grants
    let _ = process_exec(p, "printf 'pub fn main(http: &HttpCap, fsread: &FsReadCap, tcp: &TcpCap) {}\\n' > " + tmpd + "/cap_g3_all.oo");
    let _ = process_exec(p, oodac + " emit-c " + tmpd + "/cap_g3_all.oo > " + tmpd + "/cap_g3_all.c 2> " + tmpd + "/cap_g3_all.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/cap_g3_all.c 2>/dev/null && grep -q 'oo_cap_grant_http' " + tmpd + "/cap_g3_all.c + " + tmpd + "/cap_g3_all.c | grep -q 'oo_cap_grant_fsread' && grep -q 'oo_cap_grant_tcp' " + tmpd + "/cap_g3_all.c", 30);

    // soft — ci_product wire
    let _ = expect_quiet(p, "grep -q 'cap_g3_grant_inject_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true");

    println("cap_g3_grant_inject_smoke: PASSED");
}
