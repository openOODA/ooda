// ===================================================================
// Max Cycles Multi-Digit Smoke Test
// ===================================================================
// M138: multi-digit // MAX_CYCLES: N lands in emit (N=50 fixture)

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_oodac(p, root);
    let fix = root + "/fixtures/max_cycles_recursion_pass.oo";
    
    // Check fixture has multi-digit MAX_CYCLES
    let check_fix = cmd_exec(p, "grep -qE 'MAX_CYCLES:[[:space:]]*[0-9]{2,}' " + fix);
    tr = test_assert(tr, "fixture has multi-digit MAX_CYCLES", check_fix.is_ok());
    
    // Emit C and check for OO_MC_LIMIT 50
    let emit_res = cmd_exec(p, oodac + " emit-c " + fix + " 2>&1");
    tr = test_assert(tr, "emit-c succeeds", emit_res.is_ok());
    
    if emit_res.is_ok() {
        let output = emit_res.unwrap();
        let check_limit = str_contains(output, "#define OO_MC_LIMIT 50");
        tr = test_assert(tr, "output contains OO_MC_LIMIT 50", check_limit);
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("OK max_cycles multi-digit N=50 in emit");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_oodac(p: &ProcessCap, root: String) -> String {
    let oodac_bin = get_env(p, "OODAC_BIN", "");
    if str_len(oodac_bin) > 0 {
        return oodac_bin;
    }
    return root + "/oodac/oodac";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
