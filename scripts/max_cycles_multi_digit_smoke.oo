// # Max Cycles Multi Digit Smoke
//
// Logline: M138 — multi-digit // MAX_CYCLES: N (N=50) lands in emit as #define OO_MC_LIMIT 50.
// Beats: fixture has multi-digit N | emit-c succeeds | OO_MC_LIMIT 50.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = "ooda/fixtures/max_cycles_recursion_pass.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = scenario(p, fs, "max cycles multi-digit N=50 in emit");

    // when: fixture holds a multi-digit // MAX_CYCLES: N
    expect_present(fs, FIX);
    expect_clean(p, "grep -qE 'MAX_CYCLES:[[:space:]]*[0-9]{2,}' " + root + "/" + FIX);

    // and: emit-c succeeds and writes #define OO_MC_LIMIT 50
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + FIX + " > /tmp/mcm.c 2>&1");
    expect_clean(p, "grep -q '#define OO_MC_LIMIT 50' /tmp/mcm.c");

    println("max_cycles_multi_digit_smoke: PASSED");
}
