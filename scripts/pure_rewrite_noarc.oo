// # Pure Rewrite Noarc
//
// Logline: PURE_NO_ARC=1 helper: string-safe ARC retain/release stripper and stub injector for self-hosted oodac.
//
// Setup: Pure string/C AST rewriter; callable as a library function or standalone script with Process/Fs capabilities.
//
// Beats:
//   1. Walk C source tracking string/char literals and escape sequences.
//   2. Strip oo_*_retain/release invocations outside string literals to /*noarc*/;.
//   3. Simplify ARC temporary reassign blocks.
//   4. Inject ARC and capability stub prototypes if absent.
//   5. Verify transformations with built-in scenario test cases.

import "std/scenario.oo";
import "std/sh.oo";
import "std/str.oo";
import "std/os/fs.oo";

pub fn strip_arc_calls_string_safe(t: String) -> String {
    let mut out = "";
    let n = chars_len(t);
    let mut i = 0;
    let mut in_str = false;
    let mut in_chr = false;
    let mut escape = false;

    while i < n {
        let ch = char_at(t, i);
        if escape {
            out = out + ch;
            escape = false;
            i = i + 1;
        } else if in_str {
            out = out + ch;
            if ch == "\\" {
                escape = true;
            } else if ch == "\"" {
                in_str = false;
            }
            i = i + 1;
        } else if in_chr {
            out = out + ch;
            if ch == "\\" {
                escape = true;
            } else if ch == "'" {
                in_chr = false;
            }
            i = i + 1;
        } else if ch == "\"" {
            in_str = true;
            out = out + ch;
            i = i + 1;
        } else if ch == "'" {
            in_chr = true;
            out = out + ch;
            i = i + 1;
        } else {
            let is_arc = is_arc_call_at(t, i, n);
            if is_arc {
                let mut j = i;
                while j < n && char_at(t, j) != "(" {
                    j = j + 1;
                }
                if j >= n {
                    out = out + ch;
                    i = i + 1;
                } else {
                    let mut depth = 1;
                    let mut k = j + 1;
                    while k < n && depth > 0 {
                        let c = char_at(t, k);
                        if c == "\"" {
                            k = k + 1;
                            while k < n {
                                let sc = char_at(t, k);
                                if sc == "\\" {
                                    k = k + 2;
                                } else if sc == "\"" {
                                    k = k + 1;
                                    break;
                                } else {
                                    k = k + 1;
                                }
                            }
                        } else {
                            if c == "(" { depth = depth + 1; }
                            else if c == ")" { depth = depth - 1; }
                            k = k + 1;
                        }
                    }
                    while k < n && (char_at(t, k) == " " || char_at(t, k) == "\t") {
                        k = k + 1;
                    }
                    if k < n && char_at(t, k) == ";" {
                        k = k + 1;
                    }
                    out = out + "/*noarc*/;";
                    i = k;
                }
            } else {
                out = out + ch;
                i = i + 1;
            }
        }
    }

    return clean_noarc_reassign_blocks(out);
}

fn is_arc_call_at(t: String, i: Int, n: Int) -> Bool {
    let rem = str_slice(t, i, n);
    if str_starts_with(rem, "oo_str_release")
        || str_starts_with(rem, "oo_str_retain")
        || str_starts_with(rem, "oo_slist_release")
        || str_starts_with(rem, "oo_slist_retain")
        || str_starts_with(rem, "oo_ilist_release")
        || str_starts_with(rem, "oo_ilist_retain")
    {
        return true;
    }
    return false;
}

fn clean_noarc_reassign_blocks(s: String) -> String {
    let mut res = s;
    let tys: List[String] = list_new();
    let tys2 = list_push(list_push(list_push(tys, "OoStr"), "OoSList"), "OoIList");
    let mut ti = 0;
    while ti < 3 {
        let ty = list_get(tys2, ti);
        let prefix = "{ " + ty + " __tmp = ";
        let suffix = "/*noarc*/; }";
        let alt_suffix = "/*noarc*/;}";
        res = simplify_reassign_pattern(res, prefix, suffix);
        res = simplify_reassign_pattern(res, prefix, alt_suffix);
        ti = ti + 1;
    }
    return res;
}

fn simplify_reassign_pattern(s: String, prefix: String, suffix: String) -> String {
    let mut current = s;
    let mut out = "";
    let plen = chars_len(prefix);
    let slen = chars_len(suffix);
    while true {
        let idx = str_index_of(current, prefix);
        if idx < 0 {
            out = out + current;
            break;
        }
        let after_prefix = idx + plen;
        let s_idx = str_index_of(str_slice(current, after_prefix, chars_len(current)), suffix);
        if s_idx < 0 {
            out = out + current;
            break;
        }
        let block_body = str_slice(current, after_prefix, after_prefix + s_idx);
        let semi_idx = str_index_of(block_body, ";");
        if semi_idx > 0 {
            let var_name = str_slice(block_body, 0, semi_idx);
            let rest = str_slice(block_body, semi_idx + 1, chars_len(block_body));
            let eq_idx = str_index_of(rest, "=");
            if eq_idx > 0 {
                let rest_semi = str_index_of(rest, ";");
                if rest_semi > eq_idx {
                    let rhs = str_slice(rest, eq_idx + 1, rest_semi);
                    out = out + str_slice(current, 0, idx) + "{ " + var_name + " =" + rhs + "; }";
                    current = str_slice(current, after_prefix + s_idx + slen, chars_len(current));
                    continue;
                }
            }
        }
        out = out + str_slice(current, 0, idx + plen);
        current = str_slice(current, after_prefix, chars_len(current));
    }
    return out;
}

pub fn apply_pure_no_arc(fw: &FsWriteCap, fr: &FsReadCap, path: String) {
    let read_res = fs_read_file(fr, path);
    if read_res.is_err() {
        return;
    }
    let mut t = match read_res { Ok(s) => s, Err(_) => "" };
    t = strip_arc_calls_string_safe(t);
    let decls = "void oo_str_retain(OoStr); void oo_str_release(OoStr);\n"
        + "void oo_slist_retain(OoSList); void oo_slist_release(OoSList);\n"
        + "void oo_ilist_retain(OoIList); void oo_ilist_release(OoIList);\n"
        + "long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void);\n"
        + "long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);\n"
        + "void oo_cap_require(long long,long long,const char*);\n"
        + "OoResS oo_sys_exec(long long,int,OoStr*); OoResS oo_sys_exec1(long long,OoStr);\n"
        + "OoResS oo_fetch(long long,OoStr);\n";
    let sub_len = 8000;
    let t_len = chars_len(t);
    let check_len = if t_len < sub_len { t_len } else { sub_len };
    let t_prefix = str_slice(t, 0, check_len);
    if !str_contains(t_prefix, "void oo_str_retain") {
        let needle = "typedef struct { int ok; OoStr err; } OoResV;";
        if str_contains(t, needle) {
            t = str_replace(t, needle, needle + "\n" + decls);
        } else {
            t = decls + t;
        }
    }
    let _ = fs_write_file(fw, path, t);
    println("pure_rewrite: PURE_NO_ARC=1 (ARC stripped)");
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let _ = scenario(p, fs, "pure_rewrite_noarc smoke and unit verification");

    let c_code = "void f(OoStr s) {\n    oo_str_retain(s);\n    const char* msg = \"oo_str_release(s);\";\n    oo_str_release(s);\n}\n";
    let res = strip_arc_calls_string_safe(c_code);
    assert_eq!(str_contains(res, "/*noarc*/;"), true);
    assert_eq!(str_contains(res, "\"oo_str_release(s);\""), true);

    let reassign_block = "{ OoStr __tmp = s; s = new_val; /*noarc*/; }";
    let res2 = clean_noarc_reassign_blocks(reassign_block);
    assert_eq!(str_contains(res2, "{ s = new_val; }"), true);

    println("pure_rewrite_noarc: PASSED");
}
