// # Merkle state store and metamorphic layout smoke
//
// Logline: Smoke validation for in-memory Merkle DAG state stores and metamorphic decoy memory layouts.
//
// Setup: Exercises oodac typechecking across Merkle DAG modules, metamorphic security modules, and end-to-end fixtures.
//
// Beats:
//   1. Verify oodac check on Merkle DAG store modules (types, tree, proof, dag, facade).
//   2. Verify oodac check on Metamorphic Decoy Layout modules (types, pad, layout, facade).
//   3. Verify oodac check on the integrated merkle_meta_fixture.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = root + "/oodac/oodac";
    let fix = root + "/fixtures";
    let std_root = root + "/../std";
    let _ = scenario(p, fs, "Merkle State and Metamorphic Layout Smoke");

    // Beat 1: Verify Merkle DAG modules
    check(p, oodac + " check " + std_root + "/src/ooda/merkle/merkle_types.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/merkle/merkle_tree.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/merkle/merkle_proof.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/merkle/merkle_dag.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/merkle/merkle.oo", within: 15);

    // Beat 2: Verify Metamorphic Decoy Layout modules
    check(p, oodac + " check " + std_root + "/src/ooda/sec/metamorphic/meta_types.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/metamorphic/meta_pad.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/metamorphic/meta_layout.oo", within: 15);
    check(p, oodac + " check " + std_root + "/src/ooda/sec/metamorphic/meta.oo", within: 15);

    // Beat 3: Verify Integrated Merkle Metamorphic Fixture
    check(p, oodac + " check " + fix + "/merkle_meta_fixture.oo", within: 30);

    println("merkle_meta_smoke: PASSED");
}
