// # EBNF residual tags
//
// Logline: ooda.ebnf names TraitDecl as residual and keeps string import as product.
//
// Setup: OPEN-13. File is ooda/ooda.ebnf.
//
// Beats:
//   1. RESIDUAL and TraitDecl both appear.
//   2. TraitDecl is not a bare product Item.
//   3. Product import is a string literal.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let ebnf = root + "/ooda.ebnf";
    let sc: Result[Void, String] = scenario(p, fs, "open13 ebnf");
    if sc.is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_present(fs, ebnf).is_err() {
        println("FAIL no ebnf");
        process_exit(1);
    }
    if expect_substring(fs, ebnf, "RESIDUAL").is_err() {
        println("FAIL no RESIDUAL tag");
        process_exit(1);
    }
    if expect_substring(fs, ebnf, "TraitDecl").is_err() {
        println("FAIL TraitDecl not named");
        process_exit(1);
    }
    if expect_clean(p, "grep -n 'RESIDUAL TraitDecl' " + ebnf).is_err() {
        println("FAIL TraitDecl not residual-tagged");
        process_exit(1);
    }
    if expect_substring(fs, ebnf, "import\" StringLiteral").is_err() {
        if expect_substring(fs, ebnf, "\"import\" StringLiteral").is_err() {
            println("FAIL product import is not a string");
            process_exit(1);
        }
    }
    if expect_clean(p, "! grep -E '^Item\\s*::=.*TraitDecl' " + ebnf).is_err() {
        println("FAIL TraitDecl still a product Item");
        process_exit(1);
    }
    println("open13_ebnf_smoke: PASSED");
}
