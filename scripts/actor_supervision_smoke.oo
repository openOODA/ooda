// # OTP Actor Supervision Tree Smoke Test
//
// Logline: Validates OneForOne, OneForAll, RestForOne restart strategies, sub-millisecond thread recovery, and intensity escalation under ThreadCap.
//
// Setup: Exercises actor supervision hierarchies, child worker failures, and fault containment under ThreadCap.
//
// Beats:
//   1. Test OneForOne recovery: crashed worker restarts while siblings remain untouched.
//   2. Test OneForAll recovery: crashed worker triggers simultaneous restart of all siblings.
//   3. Test RestForOne recovery: crashed worker triggers restart of downstream siblings only.
//   4. Test restart intensity rate-limiting and escalation on rapid crash loops.
// RULES.oot 1.4: Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "actor/strategy.oo";
import "actor/worker.oo";
import "actor/supervisor_tree.oo";
import "actor/supervisor.oo";

pub fn main(thread: &ThreadCap) {
    println("=== Running Actor Supervision Smoke Tests ===");

    // Beat 1: OneForOne Strategy
    let strat_141: RestartStrategy = strategy_one_for_one(3, 5);
    let mut sup1: SupervisorTree = supervisor_create("sup_one_for_one", strat_141);
    sup1 = supervisor_add_worker(sup1, child_spec_new("worker_a", 0, 1000, false, 0), "init_a");
    sup1 = supervisor_add_worker(sup1, child_spec_new("worker_b", 0, 1000, false, 1), "init_b");
    sup1 = supervisor_add_worker(sup1, child_spec_new("worker_c", 0, 1000, false, 2), "init_c");

    let s1_res: Result[SupervisorTree, String] = supervisor_start_all(thread, sup1);
    if s1_res.is_err() { process_exit(1); }
    sup1 = match s1_res { Ok(s) => s, Err(_) => sup1 };

    let crash1: Result[SupervisorTree, String] = supervisor_handle_crash(thread, sup1, "worker_a", "sigsegv", 100);
    if crash1.is_err() { process_exit(1); }
    sup1 = match crash1 { Ok(s) => s, Err(_) => sup1 };

    let st_a: String = supervisor_get_child_status(sup1, "worker_a");
    let st_b: String = supervisor_get_child_status(sup1, "worker_b");
    if st_a != "running" || st_b != "running" {
        println("FAIL: OneForOne worker status mismatch");
        process_exit(1);
    }

    // Beat 2: OneForAll Strategy
    let strat_all: RestartStrategy = strategy_one_for_all(3, 5);
    let mut sup2: SupervisorTree = supervisor_create("sup_one_for_all", strat_all);
    sup2 = supervisor_add_worker(sup2, child_spec_new("w1", 0, 1000, false, 0), "s1");
    sup2 = supervisor_add_worker(sup2, child_spec_new("w2", 0, 1000, false, 1), "s2");
    let s2_res: Result[SupervisorTree, String] = supervisor_start_all(thread, sup2);
    if s2_res.is_err() { process_exit(1); }
    sup2 = match s2_res { Ok(s) => s, Err(_) => sup2 };

    let crash2: Result[SupervisorTree, String] = supervisor_handle_crash(thread, sup2, "w1", "panic", 200);
    if crash2.is_err() { process_exit(1); }
    sup2 = match crash2 { Ok(s) => s, Err(_) => sup2 };

    // Beat 3: RestForOne Strategy
    let strat_rest: RestartStrategy = strategy_rest_for_one(3, 5);
    let mut sup3: SupervisorTree = supervisor_create("sup_rest_for_one", strat_rest);
    sup3 = supervisor_add_worker(sup3, child_spec_new("w_first", 0, 1000, false, 0), "state_0");
    sup3 = supervisor_add_worker(sup3, child_spec_new("w_mid", 0, 1000, false, 1), "state_1");
    sup3 = supervisor_add_worker(sup3, child_spec_new("w_last", 0, 1000, false, 2), "state_2");
    let s3_res: Result[SupervisorTree, String] = supervisor_start_all(thread, sup3);
    if s3_res.is_err() { process_exit(1); }
    sup3 = match s3_res { Ok(s) => s, Err(_) => sup3 };

    let crash3: Result[SupervisorTree, String] = supervisor_handle_crash(thread, sup3, "w_mid", "timeout", 300);
    if crash3.is_err() { process_exit(1); }
    sup3 = match crash3 { Ok(s) => s, Err(_) => sup3 };

    // Beat 4: Restart Intensity Limit Escalation
    let mut hist: RestartHistory = restart_history_new();
    hist = restart_history_record(hist, 400);
    hist = restart_history_record(hist, 401);
    hist = restart_history_record(hist, 402);
    hist = restart_history_record(hist, 403);
    let allowed: Bool = restart_history_check_intensity(hist, 3, 5, 404);
    if allowed {
        println("FAIL: expected intensity limit to reject 4th crash within window");
        process_exit(1);
    }

    println("actor_supervision_smoke: PASSED");
}
