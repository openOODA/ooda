import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    let mut r: TestRunner = test_runner_new();

    // Run max_cycles_enforce_smoke.sh
    let mut cmd1: List[String] = cmd_new("bash");
    cmd1 = cmd_arg(cmd1, "scripts/max_cycles_enforce_smoke.sh");
    let res1: Result[String, String] = cmd_execute(cmd1, p);
    r = test_assert(r, "max_cycles_enforce_smoke.sh", res1.is_ok());

    // Run max_cycles_residual_smoke.sh
    let mut cmd2: List[String] = cmd_new("bash");
    cmd2 = cmd_arg(cmd2, "scripts/max_cycles_residual_smoke.sh");
    let res2: Result[String, String] = cmd_execute(cmd2, p);
    r = test_assert(r, "max_cycles_residual_smoke.sh", res2.is_ok());

    // Print summary
    test_summary(r);
    
    // Exit with status 1 if any tests failed
    if r.failed > 0 {
        process_exit(1);
    }
}
