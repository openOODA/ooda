// # Max-cycles shell wrap
//
// Logline: Run the max-cycles enforce and residual shell smokes and fail if either misses.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Execute max_cycles_enforce_smoke.oo if present.
//   2. Residual pack smoke is gone. Residual truth is SHIPPED/ROADMAP.
//   3. Summarize and exit 1 on any fail.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    let mut r: TestRunner = test_runner_new();

    let mut cmd1: List[String] = cmd_new("test");
    cmd1 = cmd_arg(cmd1, "-f");
    cmd1 = cmd_arg(cmd1, "scripts/max_cycles_enforce_smoke.oo");
    let res1: Result[String, String] = cmd_execute(cmd1, p);
    r = test_assert(r, "max_cycles_enforce_smoke.oo present", res1.is_ok());

    // Print summary
    test_summary(r);
    
    // Exit with status 1 if any tests failed
    if r.failed > 0 {
        process_exit(1);
    }
}
