// # Test Compile Multi-Stage Build
// Logline: seed → stage1_noarc → oodac → arc_smoke multi-stage bootstrap.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _    = scenario(p, fs, "test compile multi-stage");

    // when — stage 1: seed builds stage1_noarc (PURE_NO_ARC=1)
    let _ = check(p, "PURE_NO_ARC=1 PURE_SKIP_CHECK=1 OODAC_BIN=" + root + "/bootstrap/seed/oodac bash " + root + "/scripts/my_pure_build.sh oodac/main.oo " + root + "/oodac/stage1_noarc", 600);

    // and — stage 2: stage1_noarc builds oodac (PURE_NO_ARC=0)
    let _ = check(p, "PURE_NO_ARC=0 PURE_SKIP_CHECK=1 OODAC_BIN=" + root + "/oodac/stage1_noarc bash " + root + "/scripts/my_pure_build.sh oodac/main.oo " + root + "/oodac/oodac", 600);

    // then — arc_smoke against full oodac
    let _ = check(p, "OODAC_BIN=" + root + "/oodac/oodac bash " + root + "/scripts/arc_smoke.sh", 120);

    println("test_compile: PASSED");
}