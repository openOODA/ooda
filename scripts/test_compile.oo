// ===================================================================
// Test Compile Script
// ===================================================================
// Multi-stage build test: seed → stage1_noarc → oodac → arc_smoke

import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let root = get_root(p);
    
    println("=== STAGE 1: seed builds stage1_noarc (PURE_NO_ARC=1) ===");
    let stage1_cmd = "PURE_NO_ARC=1 PURE_SKIP_CHECK=1 OODAC_BIN=" + root + "/bootstrap/seed/oodac bash " + root + "/scripts/my_pure_build.sh oodac/main.oo " + root + "/oodac/stage1_noarc";
    let stage1_res = cmd_exec(p, stage1_cmd);
    if !stage1_res.is_ok() {
        println("FAIL STAGE 1");
        process_exit(1);
    }
    
    println("=== STAGE 2: stage1_noarc builds oodac (PURE_NO_ARC=0) ===");
    let stage2_cmd = "PURE_NO_ARC=0 PURE_SKIP_CHECK=1 OODAC_BIN=" + root + "/oodac/stage1_noarc bash " + root + "/scripts/my_pure_build.sh oodac/main.oo " + root + "/oodac/oodac";
    let stage2_res = cmd_exec(p, stage2_cmd);
    if !stage2_res.is_ok() {
        println("FAIL STAGE 2");
        process_exit(1);
    }
    
    println("=== arc_smoke.sh ===");
    let arc_cmd = "OODAC_BIN=" + root + "/oodac/oodac bash " + root + "/scripts/arc_smoke.sh";
    let arc_res = cmd_exec(p, arc_cmd);
    if !arc_res.is_ok() {
        println("FAIL arc_smoke");
        process_exit(1);
    }
    
    println("DONE!");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
