// # Bitwise Ops Floor Walks Tokens To Runtime
// Logline: << >> & | ^ + ord path A source floor + C runtime + product exec values.
// Setup: oodac/oodac built; fixtures/bitwise_ops.oo + oodac/{token_scan_punct,c_emit_ops,parse_expr}.oo on disk.
// Beats: 1. token/emit/parse rails | 2. runtime C via oo_byte_at | 3. product exec outputs 8/4/0/255/240/19/15/65/66/-1

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — token/emit/parse markers
    fails = fails + tally(expect_quiet(p, "grep -q 'LSHIFT' " + root + "/oodac/token_scan_punct.oo && grep -q 'RSHIFT' " + root + "/oodac/token_scan_punct.oo"), "token LSHIFT/RSHIFT");
    fails = fails + tally(expect_quiet(p, "grep -q 'AMP' " + root + "/oodac/token_scan_punct.oo && grep -q 'PIPE' " + root + "/oodac/token_scan_punct.oo"), "token AMP/PIPE");
    fails = fails + tally(expect_quiet(p, "grep -q 'CARET' " + root + "/oodac/token_scan_punct.oo"),    "token CARET");
    fails = fails + tally(expect_quiet(p, "grep -q 'LSHIFT' " + root + "/oodac/c_emit_ops.oo && grep -q 'AMP' " + root + "/oodac/c_emit_ops.oo"), "c_emit_ops bit ops");
    fails = fails + tally(expect_quiet(p, "grep -q 'bit_xor' " + root + "/oodac/c_emit_libfloor.oo && grep -q 'bit_xor=2' " + root + "/oodac/tc_call_arity.oo"), "bit_xor free name");
    fails = fails + tally(expect_quiet(p, "grep -q 'LSHIFT' " + root + "/oodac/parse_expr.oo && grep -q 'BitAnd' " + root + "/oodac/parse_expr.oo"), "parse_expr bin_bp");
    fails = fails + tally(expect_quiet(p, "grep -q 'name == \"ord\"' " + root + "/oodac/c_emit_ty.oo && grep -q 'oo_byte_at(' " + root + "/oodac/c_emit_libfloor.oo"), "ord free name wiring");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'no float bit|no rotate|residual' " + root + "/bootstrap/BYTE_STR.oot"), "BYTE_STR residual wording");
    fails = fails + tally(expect_quiet(p, "grep -qE '<<|>>|&|.|^' " + root + "/ooda.ebnf"), "ooda.ebnf bitops");

    // and — runtime C bit + ord via oo_byte_at
    let rt = tmpd + "/bitwise_ops_rt.c";
    let _w1 = process_exec(p, "cat > " + rt + " <<'CEOF'\n#include \"chs_rt.h\"\n#include <stdio.h>\nint main(void){if((1LL<<3)!=8)return 1;if((16LL>>2)!=4)return 2;if((0xF0LL&0x0FLL)!=0)return 3;if((0xF0LL|0x0FLL)!=255)return 4;if((0xFFLL^0x0FLL)!=240)return 5;if(oo_byte_at(oo_str_lit(\"A\"),0)!=65)return 6;if(oo_byte_at(oo_str_lit(\"\"),0)!=-1)return 7;printf(\"rt-ok\\n\");return 0;}\nCEOF");
    let _w2 = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + rt + " -lm -ldl -lpthread -o " + tmpd + "/bitwise_ops_rt 2>" + tmpd + "/bitwise_ops_rt.err");
    let _w3 = process_exec(p, tmpd + "/bitwise_ops_rt +2>&1 || true");
    fails   = fails + tally(expect_quiet(p, "grep -q 'rt-ok' " + tmpd + "/bitwise_ops_rt.out 2>/dev/null; true"), "runtime C bit + ord");

    // then — product exec values
    if expect_quiet(p, "test -x " + oodac).is_ok() {
        let fix = root + "/fixtures/bitwise_ops.oo";
        let bin = tmpd + "/bitwise_ops";
        let _w4 = process_exec(p, oodac + " build " + fix + " " + bin + " > " + tmpd + "/bitops_build.out 2> " + tmpd + "/bitops_build.err");
        let _w5 = process_exec(p, bin + " +2>&1 || true");
        let mut good: Int = 1;
        let mut i: Int = 0;
        let vals = ["8", "4", "0", "255", "240", "19", "15", "65", "66", "-1"];
        while i < 10 {
            if !expect_quiet(p, "grep -qxF " + vals[i] + " " + tmpd + "/bitwise_ops.out 2>/dev/null; true").is_ok() { good = 0; }
            i = i + 1;
        }
        fails = fails + tally(check(p, "test " + good.to_string() + " -eq 1", 30), "bitwise_ops fixture values");
    }

    if fails > 0 { println("bitwise_ops_smoke: FAILED"); process_exit(1); }
    println("bitwise_ops_smoke: PASSED");
}
