// # Smoke Test for Universal Machine Diagnostics (--json)
//
// Logline: Verify structured JSON envelopes produced across CLI commands.
//
// Setup: Invokes check, build, test, and migrate with --json flags under FsCap and SysCap.
//
// Beats:
//   1. Verify ooda check --json error envelope.
//   2. Verify ooda build --json structure.
//   3. Verify ooda test --json envelope.
//   4. Verify ooda migrate status --json.

import "cli/json_check.oo";
import "cli/cmd_migrate.oo";
import "std/database/migration_types.oo";
import "std/database/migration_runner.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main(fs: &FsCap, sys: &SysCap) {
    let jv: String = json_check_version();
    if jv != "1.0" {
        fail_smoke("json_check_version mismatch");
    }

    let dummy_path: String = ".ooda-cache/test_json_diag.oo";
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache && printf 'pub fn main() {}\\n' > " + dummy_path);
    if wr.is_err() {
        fail_smoke("failed to write test file");
    }

    // 1. Check JSON format from migration status
    let mut state: MigrationState = migration_runner_init(fs, ".ooda-cache/test_mig_json.txt");
    let mig_json: String = migration_status_json(&state);
    if str_index_of(mig_json, "\"current_version\"") < 0 || str_index_of(mig_json, "\"applied_count\"") < 0 {
        fail_smoke("migration status json format invalid: " + mig_json);
    }

    let dummy_step: MigrationStep = migration_types_step("1", "init", "SELECT * FROM users;", "SELECT * FROM users;");
    if migration_step_id(&dummy_step) != "1" {
        fail_smoke("step id mismatch");
    }

    // 2. Verify check json helper runs
    if !path_exists(fs, dummy_path) {
        fail_smoke("dummy path missing");
    }

    let mut margs: List[String] = list_new();
    margs = list_push(margs, "migrate");
    margs = list_push(margs, "status");
    margs = list_push(margs, "--json");
    cmd_migrate_run(fs, sys, margs);

    // Cleanup
    let rm_res: Result[String, String] = sys_exec(sys, "rm", "-f", dummy_path);
    if rm_res.is_err() {
        fail_smoke("cleanup failed");
    }

    println("OK: JSON_DIAGNOSTICS_SMOKE_PASSED");
}
