// # Product std is ooda/std
//
// Logline: Product resolution is in-tree ooda/std. Org std/src is not product.
//
// Setup: cwd is ooda/. load_import.oo and SHIPPED.oot are on disk.
//
// Beats:
//   1. ooda/std exists and has more than ten .oo files.
//   2. load_import probes std and ../std, not org std/src.
//   3. SHIPPED names ooda/std and says std/src is not product.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let sc: Result[Void, String] = scenario(p, fs, "product std honesty");
    if sc.is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -d " + root + "/std").is_err() {
        println("FAIL no ooda/std");
        process_exit(1);
    }
    if expect_clean(p, "test $(find " + root + "/std -name '*.oo' | wc -l) -gt 10").is_err() {
        println("FAIL ooda/std too small");
        process_exit(1);
    }
    if expect_substring(fs, root + "/oodac/load_import.oo", "std").is_err() {
        println("FAIL load_import has no std probe");
        process_exit(1);
    }
    if expect_clean(p, "! grep -n 'std/src' " + root + "/oodac/load_import.oo").is_err() {
        println("FAIL load_import mentions std/src");
        process_exit(1);
    }
    let shipped = root + "/../openOODA/SHIPPED.oot";
    if expect_present(fs, shipped).is_err() {
        println("FAIL no SHIPPED");
        process_exit(1);
    }
    if expect_substring(fs, shipped, "ooda/std").is_err() {
        println("FAIL SHIPPED missing ooda/std");
        process_exit(1);
    }
    if expect_substring(fs, shipped, "std/src").is_err() {
        println("FAIL SHIPPED does not name std/src");
        process_exit(1);
    }
    println("std_product_honesty_smoke: PASSED");
}
