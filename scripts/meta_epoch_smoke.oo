// # Meta Epoch Smoke
//
// Logline: oo_meta_epoch() returns non-zero and stable within a process, but differs across two re-spawned processes (fresh process = fresh epoch).
//
// Setup: Process capability and test fixtures available.
// Beats: write harness | gcc+run twice | parse epoch=n | cross-process epochs differ.

import "std/scenario.oo";
import "std/sh.oo";

const HARNESS_C: String = ".ooda-cache/ooda-tmp/meta_epoch_harness.c";
const HARNESS_BIN: String = ".ooda-cache/ooda-tmp/meta_epoch_harness";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "meta epoch cross-process");

    // when: harness C file is written and gnu-linked with chs_rt
    let _ = process_exec(p, "cat > " + tmp + "/meta_epoch_harness.c <<'C'\n#include \"chs_rt.h\"\n#include <stdio.h>\nint main(void) {\n  long long a = oo_meta_epoch();\n  long long b = oo_meta_epoch();\n  long long m = oo_meta_mix(42);\n  if (a == 0 || a != b) { fprintf(stderr, \"epoch fail\\n\"); return 1; }\n  if (m == 0) { fprintf(stderr, \"mix fail\\n\"); return 1; }\n  printf(\"OK epoch=%lld mix=%lld\\n\", (long long)a, (long long)m);\n  return 0;\n}\nC");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + tmp + "/meta_epoch_harness.c " + root + "/ooda/runtime/chs_rt.c -lm -ldl -lpthread -o " + tmp + "/meta_epoch_harness", within: 30);

    // and: two runs each produce a parseable epoch value
    let out1 = match process_exec(p, tmp + "/meta_epoch_harness") { Ok(s) => s, Err(_) => "" };
    let out2 = match process_exec(p, tmp + "/meta_epoch_harness") { Ok(s) => s, Err(_) => "" };
    expect_clean(p, "echo '" + out1 + "' | grep -qE 'epoch=(-?[0-9]+)'");
    expect_clean(p, "echo '" + out2 + "' | grep -qE 'epoch=(-?[0-9]+)'");

    // then: cross-process epochs differ
    let e1 = pick_field(out1, "epoch=");
    let e2 = pick_field(out2, "epoch=");
    expect_clean(p, "test \"" + e1 + "\" != \"" + e2 + "\"");

    println("meta_epoch_smoke: PASSED");
}

fn pick_field(s: String, key: String) -> String {
    let i = str_index_of(s, key);
    if i < 0 { return ""; }
    let start = i + chars_len(key);
    let rest = str_slice(s, start, chars_len(s));
    let mut j: Int = 0;
    let n = chars_len(rest);
    while j < n {
        if char_at(rest, j) == " " || char_at(rest, j) == "\n" { break; }
        j = j + 1;
    }
    return str_slice(rest, 0, j);
}
