// # Hostile two-println mixed concat lock
//
// Logline: emit-wasm of keep-me plus mixed concat must not print only keep-me.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_two_println_hostile.oo.
//   2. ERR or dummy empty stdout is honest.
//   3. Sole keep-me on stdout (dropped second print) fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm two println hostile").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_two_println_hostile.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_two_println_hostile.wasm";
    let errf = tmpd + "/wasm_two_println_hostile.err";
    let out = tmpd + "/wasm_two_println_hostile.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_two_println_hostile.oo > " + wasm + " 2>" + errf).is_err() {
        if expect_quiet(p, "grep -q ERR " + errf).is_ok() {
            println("wasm_two_println_hostile_smoke: PASSED");
            return;
        }
    }
    if expect_quiet(p, "grep -qE '^ERR' " + errf + " " + wasm).is_ok() {
        println("wasm_two_println_hostile_smoke: PASSED");
        return;
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() {
            println("wasm_two_println_hostile_smoke: PASSED");
            return;
        }
        refuse_keep_me_only(p, out, false);
    } else if sh_which(p, "wasmtime").is_ok() {
        if check(p, "wasmtime " + wasm + " > " + out, 15).is_err() {
            println("wasm_two_println_hostile_smoke: PASSED");
            return;
        }
        refuse_keep_me_only(p, out, false);
    } else {
        refuse_keep_me_only(p, wasm, true);
    }
    println("wasm_two_println_hostile_smoke: PASSED");
}

fn refuse_keep_me_only(p: &ProcessCap, path: String, bytes: Bool) {
    if bytes == false {
        if expect_quiet(p, "test ! -s " + path).is_ok() {
            return;
        }
    }
    let mut gkeep = "grep -q keep-me ";
    let mut gxno = "grep -q xno ";
    if bytes {
        gkeep = "grep -a -q keep-me ";
        gxno = "grep -a -q xno ";
    }
    if expect_quiet(p, gkeep + path).is_ok() {
        if expect_quiet(p, gxno + path).is_err() {
            fail("first-line-only");
        }
    }
}
