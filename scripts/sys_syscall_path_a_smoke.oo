// # Syscall Path A Seals The Capability
// Logline: sys_epoll/inotify/prctl lower through SysCap with residual Err under forge.
// Setup: oodac/oodac built; chs_rt.c linkable.
// Beats: 1. seal + lower present | 2. runtime residual Err path | 3. forge zero deny

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "syscall path A");

    // when — source honesty: seals, lowers, runtime residual
    let _ = expect_quiet(p, "grep -q 'sys_epoll_create' "   + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'sys_inotify_init' "  + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'sys_prctl' "          + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'oo_sys_epoll_create' "+ root + "/oodac/c_emit_sys.oo");
    let _ = expect_quiet(p, "grep -q 'oo_sys_inotify_init' "+ root + "/oodac/c_emit_sys.oo");
    let _ = expect_quiet(p, "grep -q 'oo_sys_prctl' "       + root + "/oodac/c_emit_sys.oo");
    let _ = expect_quiet(p, "grep -q 'oo_sys_epoll_create' "+ root + "/runtime/chs_rt_libfloor.c");

    // and — bare refuse + fixture check
    let bare = tmpd + "/sys_bare.oo";
    let _    = process_exec(p, "printf 'pub fn main() { let r = sys_epoll_create(0); }\\n' > " + bare);
    let _    = check(p, "!" + oodac + " check " + bare + " >/dev/null 2>&1", 30);
    let fix  = root + "/fixtures/sys_syscall_path_a.oo";
    let _    = check(p, oodac + " check " + fix + " 2>&1 | grep -qE '^OK'", 30);

    // then — emit-c lowers, runtime residual Err path
    let cfile = tmpd + "/sys.c";
    let cbout = tmpd + "/sys.out";
    let _     = process_exec(p, oodac + " emit-c " + fix + " > " + cfile + " 2>" + tmpd + "/sys.err");
    let _     = expect_quiet(p, "grep -qE 'oo_sys_epoll_create\\(sys' " + cfile);
    let _     = expect_quiet(p, "grep -qE 'oo_sys_inotify_init\\(sys' " + cfile);
    let _     = expect_quiet(p, "grep -qE 'oo_sys_prctl\\(sys' "         + cfile);
    let _     = expect_quiet(p, "grep -q 'oo_cap_grant_sys' "            + cfile);

    let bin = tmpd + "/sys.bin";
    let _   = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + cfile + " -o " + bin + " -lm -ldl -lpthread 2>" + tmpd + "/sys.gcc");
    let _   = process_exec(p, bin + " > " + cbout + " 2>&1 || true");
    let _   = expect_clean(p, "grep -qE 'epoll-residual-ok|inotify-residual-ok|prctl-residual-ok' " + cbout);

    println("sys_syscall_path_a_smoke: PASSED");
}
