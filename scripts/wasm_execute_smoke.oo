// # Wasm Execute Prints Hi
// Logline: emit-wasm + wasmtime (or wasm3 + wat2wasm) prints "hi" via WASI fd_write.
// Setup: oodac/oodac built; wasmtime or wasm3+wat2wasm on PATH.
// Beats: 1. emit-wasm produces .wat | 2. wasm runtime exits 0 | 3. stdout matches "hi"

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA_BIN",   root + "/bin/ooda").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — emit "hi" fixture as .wat
    let src  = tmpd + "/hello_wasm.oo";
    let wat  = tmpd + "/hello_wasm.wat";
    let wasm = tmpd + "/hello_wasm.wasm";
    let rout = tmpd + "/run.out";
    let _w1  = process_exec(p, "printf 'pub fn main() {\\n    println(\"hi\")\\n}\\n' > " + src);
    let _w2  = process_exec(p, "test -x " + oodac + " && " + oodac + " emit-wasm " + src + " > " + wat + " || " + ooda + " build --target wasm " + src + " -o " + wat);
    fails    = fails + tally(expect_present(p, wat),                                         "emit-wasm produced .wat");
    fails    = fails + tally(expect_quiet(p, "grep -q 'module' "                + wat), "module keyword");
    fails    = fails + tally(expect_quiet(p, "grep -q 'wasi_snapshot_preview1' " + wat), "wasi import");
    fails    = fails + tally(expect_quiet(p, "grep -q 'fd_write' "               + wat), "fd_write import");
    fails    = fails + tally(expect_quiet(p, "grep -q '_start' "                 + wat), "_start export");

    // and — wasmtime OR wasm3+wat2wasm executes; stdout == "hi"
    let have_wt = expect_quiet(p, "command -v wasmtime").is_ok();
    let have_3  = expect_quiet(p, "command -v wasm3").is_ok();
    let have_w2w = expect_quiet(p, "command -v wat2wasm").is_ok();
    if have_wt {
        let _w3 = process_exec(p, "timeout 15 wasmtime run --wasm-features=all " + wat + " > " + rout + " 2>" + tmpd + "/run.err");
        if !expect_present(p, rout).is_ok() { let _w3b = process_exec(p, "timeout 15 wasmtime " + wat + " > " + rout + " 2>" + tmpd + "/run.err"); }
    } else if have_3 && have_w2w {
        let _w4 = process_exec(p, "wat2wasm " + wat + " -o " + wasm + " && timeout 15 wasm3 " + wasm + " > " + rout + " 2>" + tmpd + "/run.err");
    } else {
        println("ERR_NO_WASMTIME: need wasmtime (prefer) or wasm3+wat2wasm");
        process_exit(1);
    }

    // then — stdout matches "hi"
    fails = fails + tally(expect_quiet(p, "tr -d '\\r' < " + rout + " | sed -e 's/[[:space:]]*$//' | grep -qx hi"), "stdout == \"hi\"");

    if fails > 0 { println("wasm_execute_smoke: FAILED"); process_exit(1); }
    println("wasm_execute_smoke: PASSED");
}
