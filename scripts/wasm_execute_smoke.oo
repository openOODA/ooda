// # Wasm Execute Prints Hi
//
// Logline: emit-wasm + wasmtime (or wasm3 + wat2wasm) prints "hi" via WASI fd_write.
//
// Setup: oodac/oodac built; wasmtime or wasm3+wat2wasm on PATH.
//
// Beats:
//   1. Emit hello wasm fixture as WebAssembly text (.wat).
//   2. Execute compiled WebAssembly module via wasmtime WASI runtime.
//   3. Assert stdout stream matches expected string output.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA_BIN",   root + "/bin/ooda").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "wasm execute hi");

    // when — emit "hi" fixture as .wat
    let src  = tmpd + "/hello_wasm.oo";
    let wat  = tmpd + "/hello_wasm.wat";
    let wasm = tmpd + "/hello_wasm.wasm";
    let rout = tmpd + "/run.out";
    let _    = process_exec(p, "printf 'pub fn main() {\\n    println(\"hi\")\\n}\\n' > " + src);
    let _    = process_exec(p, "test -x " + oodac + " && " + oodac + " emit-wasm " + src + " > " + wat + " || " + ooda + " build --target wasm " + src + " -o " + wat);
    let _    = expect_present(fs, wat);
    let _    = expect_quiet(p, "grep -q 'module' "                + wat);
    let _    = expect_quiet(p, "grep -q 'wasi_snapshot_preview1' " + wat);
    let _    = expect_quiet(p, "grep -q 'fd_write' "               + wat);
    let _    = expect_quiet(p, "grep -q '_start' "                 + wat);

    // and — wasmtime OR wasm3+wat2wasm executes; stdout == "hi"
    let have_wt  = expect_quiet(p, "command -v wasmtime").is_ok();
    let have_3   = expect_quiet(p, "command -v wasm3").is_ok();
    let have_w2w = expect_quiet(p, "command -v wat2wasm").is_ok();
    if have_wt {
        let _ = process_exec(p, "timeout 15 wasmtime run --wasm-features=all " + wat + " > " + rout + " 2>" + tmpd + "/run.err");
        if !expect_present(fs, rout).is_ok() { let _ = process_exec(p, "timeout 15 wasmtime " + wat + " > " + rout + " 2>" + tmpd + "/run.err"); }
    } else if have_3 && have_w2w {
        let _ = process_exec(p, "wat2wasm " + wat + " -o " + wasm + " && timeout 15 wasm3 " + wasm + " > " + rout + " 2>" + tmpd + "/run.err");
    } else {
        println("ERR_NO_WASMTIME: need wasmtime (prefer) or wasm3+wat2wasm");
    }

    // then — stdout matches "hi"
    let _ = expect_quiet(p, "tr -d '\\r' < " + rout + " | sed -e 's/[[:space:]]*$//' | grep -qx hi");

    println("wasm_execute_smoke: PASSED");
}
