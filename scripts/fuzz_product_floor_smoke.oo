// # Fuzz Product Floor Smoke
//
// Logline: Verify comprehensive fuzz test suite across integer, boolean, string, list, and multi-arg domains.
//
// Setup: ooda binary and individual domain fuzz smoke scripts exist on disk.
//
// Beats:
//   1. Verify ooda binary exists and is executable.
//   2. Execute integer depth, boolean, and string domain fuzz smoke test suites.
//   3. Execute list and multi-arg domain fuzz smoke test suites to verify floor stability.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _    = scenario(p, fs, "fuzz product floor");
    let _    = expect_quiet(p, "test -x " + ooda);

    // when — all sub-script smokes stay green
    let _ = check(p, "bash " + root + "/scripts/fuzz_int_depth_smoke.sh >/dev/null 2>&1", 120);
    let _ = check(p, "bash " + root + "/scripts/fuzz_bool_smoke.sh >/dev/null 2>&1", 120);
    let _ = check(p, "bash " + root + "/scripts/fuzz_string_smoke.sh >/dev/null 2>&1", 120);
    let _ = check(p, "bash " + root + "/scripts/fuzz_list_smoke.sh >/dev/null 2>&1", 120);
    let _ = check(p, "bash " + root + "/scripts/fuzz_multi_arg_smoke.sh >/dev/null 2>&1", 120);

    println("fuzz_product_floor_smoke: PASSED");
}