// # Raw gcc binary compare of emit-c hello
//
// Logline: emit-c writes fixtures/hello.oo twice, gcc builds both files without strip or repro flags, and cmp finds equal binaries.
//
// Setup: cwd is ooda/. Tree oodac/oodac emits C. gcc and runtime/chs_rt.c exist.
//
// Beats:
//   1. emit-c hello twice onto one C path so gcc sees the same file name.
//   2. gcc each emit without strip, without SOURCE_DATE_EPOCH, and without -frandom-seed.
//   3. cmp -s the two binaries. Print PASSED.
// residual: strip plus SOURCE_DATE_EPOCH remains the OPEN-71 lock.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no tree oodac"); }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if !path_exists(fs, "runtime/chs_rt.c") { fail("no chs_rt"); }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' " + oodac).is_ok() {
        fail("oodac is pure .oo product CLI");
    }
    if process_exec(p, "grep -a -q 'oodac: usage:' " + oodac).is_err() {
        fail("oodac missing oodac: usage:");
    }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }

    let cpath = tmpd + "/open53_hello.c";
    let b1 = tmpd + "/open53_a.bin";
    let b2 = tmpd + "/open53_b.bin";
    let e1 = tmpd + "/open53_a.err";
    let e2 = tmpd + "/open53_b.err";
    if process_exec(p, "timeout 60 " + oodac + " emit-c fixtures/hello.oo > " + cpath + " 2> " + e1).is_err() {
        fail("emit-c a");
    }
    if process_exec(p, "grep -qE '^ERR' " + cpath + " " + e1).is_ok() { fail("ERR in emit-c a"); }
    if process_exec(p, "env -u SOURCE_DATE_EPOCH gcc -O2 -Iruntime runtime/chs_rt.c " + cpath + " -lm -ldl -lpthread -o " + b1).is_err() {
        fail("gcc a");
    }
    if process_exec(p, "timeout 60 " + oodac + " emit-c fixtures/hello.oo > " + cpath + " 2> " + e2).is_err() {
        fail("emit-c b");
    }
    if process_exec(p, "grep -qE '^ERR' " + cpath + " " + e2).is_ok() { fail("ERR in emit-c b"); }
    if process_exec(p, "env -u SOURCE_DATE_EPOCH gcc -O2 -Iruntime runtime/chs_rt.c " + cpath + " -lm -ldl -lpthread -o " + b2).is_err() {
        fail("gcc b");
    }
    if process_exec(p, "test -x " + b1 + " && test -x " + b2).is_err() { fail("bins"); }
    if process_exec(p, "cmp -s " + b1 + " " + b2).is_err() {
        fail("gcc binaries differ");
    }

    println("open53_gcc_cmp_smoke: PASSED");
}
