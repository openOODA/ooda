// # Confidential Hardware Enclaves Dedicated Smoke Test
//
// Logline: Comprehensive smoke proof verifying AMD SEV-SNP, Intel SGX DCAP, AWS Nitro, universal attestation, and memory sealing.
//
// Setup: Exercises confidential hardware enclaves standard library modules under EnclaveCap.
//
// Beats:
//   1. Verify AMD SEV-SNP report decoding, VMPL privilege levels, and launch digest validation.
//   2. Verify Intel SGX/TDX DCAP Quote parsing, MRENCLAVE/MRSIGNER checks, and debug lockout.
//   3. Verify AWS Nitro Enclave COSE Sign1 PCR0-PCR4 measurement and signature checks.
//   4. Verify universal remote attestation engine across all 3 platforms with freshness challenges.
//   5. Verify hardware memory sealing, anti-replay sequence checking, and tamper detection.
// RULES.oot 1.4: Pure capability-gated execution.
// RULES.oot 1.7: Strictly under 256 lines.

import "enclave/enclave_types.oo";
import "enclave/sev_snp.oo";
import "enclave/intel_sgx.oo";
import "enclave/nitro.oo";
import "enclave/attestation.oo";
import "enclave/enclave.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA Stage 15: Confidential Hardware Enclaves Smoke");
    println("===================================================================");

    // 1. AMD SEV-SNP Driver
    let snp_rep: SnpReport = snp_report_new("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "NONCE_SNP_01", 2, 0, false);
    let pol_snp: SnpPolicy = snp_policy_new(false, false, true, 1);
    let snp_pol_res: Result[Bool, String] = snp_report_verify_policy(snp_rep, pol_snp);
    if snp_pol_res.is_err() { println("FAIL: snp policy verify"); process_exit(1); }
    let snp_sig_ok: Bool = snp_report_verify_signature(snp_rep, "VCEK_CERT_PUBKEY_VALID");
    if !snp_sig_ok { println("FAIL: snp signature verify"); process_exit(1); }
    println("  [PASS] 1. AMD SEV-SNP Hardware Attestation & Policy");

    // 2. Intel SGX / TDX Driver
    let sgx_q: SgxQuote = sgx_quote_new("MRENCLAVE_SHA256_CODE_V1", "MRSIGNER_OODA_ROOT_PUBKEY", "NONCE_SGX_01", 3, false);
    let sgx_v_res: Result[Bool, String] = sgx_quote_verify(sgx_q, "MRENCLAVE_SHA256_CODE_V1", "MRSIGNER_OODA_ROOT_PUBKEY", "NONCE_SGX_01");
    if sgx_v_res.is_err() { println("FAIL: sgx quote verify"); process_exit(1); }
    let sgx_dbg: SgxQuote = sgx_quote_new("MRENCLAVE_SHA256_CODE_V1", "MRSIGNER_OODA_ROOT_PUBKEY", "NONCE_SGX_01", 3, true);
    let sgx_dbg_res: Result[Bool, String] = sgx_quote_verify(sgx_dbg, "MRENCLAVE_SHA256_CODE_V1", "MRSIGNER_OODA_ROOT_PUBKEY", "NONCE_SGX_01");
    if sgx_dbg_res.is_ok() { println("FAIL: sgx debug quote should be rejected"); process_exit(1); }
    println("  [PASS] 2. Intel SGX DCAP Quote & Debug Lockout");

    // 3. AWS Nitro Enclaves Driver
    let pcrs: NitroPcrs = nitro_pcrs_new("PCR0_EIF_HASH_AABB", "PCR1_KERNEL_HASH", "PCR2_RAMDISK_HASH", "PCR3_IAM_HASH", "PCR4_INST_HASH");
    let nitro_doc: NitroAttestationDoc = nitro_doc_new(pcrs, "NONCE_NITRO_01", "USER_METADATA_OODA");
    let nit_v_res: Result[Bool, String] = nitro_doc_verify_pcrs(nitro_doc, "PCR0_EIF_HASH_AABB", "NONCE_NITRO_01");
    if nit_v_res.is_err() { println("FAIL: nitro doc verify"); process_exit(1); }
    println("  [PASS] 3. AWS Nitro Enclaves COSE Sign1 & PCR Validation");

    // 4. Universal Remote Attestation Engine
    let att_pol: AttestationPolicy = attestation_policy_new(2, "MRENCLAVE_SHA256_CODE_V1", "MRSIGNER_OODA_ROOT_PUBKEY", 2, true);
    let raw_sgx: String = "SGX_DCAP_QUOTE:3|3|0|MRENCLAVE_SHA256_CODE_V1|MRSIGNER_OODA_ROOT_PUBKEY|NONCE_UNIV_77";
    let ev: AttestationEvidence = AttestationEvidence {
        platform: 2,
        raw_quote: raw_sgx,
        nonce_challenge: "NONCE_UNIV_77",
        timestamp_ms: 1724240000000
    };
    let att_res: VerificationResult = attestation_verify(ev, att_pol, "NONCE_UNIV_77");
    let att_valid: Bool = att_res.is_valid;
    if !att_valid { println("FAIL: universal attestation verify: " + att_res.error_code); process_exit(1); }
    println("  [PASS] 4. Universal Remote Attestation Engine & Nonce Freshness");

    // 5. Memory Sealing under EnclaveCap
    let cap: EnclaveCap = enclave_cap_new(1, enclave_perm_all(), 0);
    let blob: SealedBlob = enclave_seal(cap, "CONFIDENTIAL_KEY_MATERIAL_OODA", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", sealing_policy_measurement(), 101);
    let blob_v: Bool = blob.is_valid;
    if !blob_v { println("FAIL: enclave seal"); process_exit(1); }

    let unseal_res: Result[String, String] = enclave_unseal(cap, blob, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", 101);
    if unseal_res.is_err() { println("FAIL: enclave unseal"); process_exit(1); }
    let secret: String = match unseal_res { Ok(s) => s, Err(_) => "" };
    if !(secret == "CONFIDENTIAL_KEY_MATERIAL_OODA") { println("FAIL: unsealed secret mismatch"); process_exit(1); }

    let replay_res: Result[String, String] = enclave_unseal(cap, blob, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", 102);
    if replay_res.is_ok() { println("FAIL: replay sequence mismatch should be rejected"); process_exit(1); }

    let tampered: Bool = sealed_blob_is_tampered(blob);
    if tampered { println("FAIL: pristine blob flagged as tampered"); process_exit(1); }
    println("  [PASS] 5. Hardware Memory Sealing & Anti-Replay Verification");

    println("===================================================================");
    println("enclave_smoke: PASSED");
}
