// # Pause-Free Epoch GC and Zero-Fragmentation Arena Verification Suite
//
// Logline: Verify type-safety, DINNER compliance, line-count constraints, oodac compilation, and binary execution of memory manager.
//
// Setup: oodac compiler binary built; std/src/ooda/mm modules on disk; fixtures/epoch_gc_fixture.oo present.
//
// Beats:
//   1. Check type-safety across mm standard library modules and std/mm.oo entry point.
//   2. Validate DINNER headers and strictly <= 256 line count constraints across all source files.
//   3. Compile and execute epoch_gc_fixture binary, proving epoch progression and zero-fragmentation.
//   4. Verify lock-free safe reclamation, slab recycling, and 0 ppm fragmentation ratio.
//   5. Output test summary and emit final PASSED certification.
//
// residual: Lock-free atomic sequence pointers lower through C FFI barriers

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let std_r = sh_realpath(p, root + "/../std").unwrap_or(root + "/../std");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, fs, "pause-free epoch gc and zero-fragmentation arena pool");

    // Beat 1: Check type safety of mm modules and std entry point
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/mm/mm_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/mm/epoch_gc.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/mm/arena_pool.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/mm/mm.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/mm.oo", 10);

    // Beat 2: Validate line count constraints (strictly <= 256 lines)
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/mm/mm_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/mm/epoch_gc.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/mm/arena_pool.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/mm/mm.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/mm.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/fixtures/epoch_gc_fixture.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/scripts/epoch_gc_smoke.oo) -le 256", 5);

    // Beat 3: Check, compile, and execute end-to-end fixture
    let fix = root + "/fixtures/epoch_gc_fixture.oo";
    let _ = check(p, oodac + " check " + fix, 10);
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmpd + "/epoch_gc.c 2> " + tmpd + "/epoch_gc.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/epoch_gc.c " + tmpd + "/epoch_gc.err 2>/dev/null", 15);
    let _ = process_exec(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/epoch_gc.c -lm -ldl -lpthread -o " + tmpd + "/epoch_gc.bin 2>" + tmpd + "/epoch_gc_gcc.err");
    let _ = process_exec(p, tmpd + "/epoch_gc.bin > " + tmpd + "/epoch_gc.out 2>&1");
    let _ = check(p, "grep -qx 'EPOCH_INIT_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'ARENA_ALLOC_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'EPOCH_PIN_DEFERRED_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'EPOCH_ADVANCE_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'EBR_RECLAIM_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'ZERO_FRAGMENTATION_OK' " + tmpd + "/epoch_gc.out", 10);
    let _ = check(p, "grep -qx 'EPOCH_GC_FIXTURE_ALL_PASSED' " + tmpd + "/epoch_gc.out", 10);

    // Beat 4: DINNER header verification
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/mm/mm.oo", 5);
    let _ = check(p, "grep -qE '^// Logline: ' " + std_r + "/src/ooda/mm/mm.oo", 5);
    let _ = check(p, "grep -qE '^// Setup: ' " + std_r + "/src/ooda/mm/mm.oo", 5);
    let _ = check(p, "grep -qE '^// Beats:' " + std_r + "/src/ooda/mm/mm.oo", 5);
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/mm.oo", 5);

    println("epoch_gc_smoke: PASSED");
}
