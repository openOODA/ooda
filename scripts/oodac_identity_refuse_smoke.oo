// # Refuse CLI path as oodac
//
// Logline: Call refuse_oodac_cli on bin/ooda and exit 1 with ERR_OODAC_IS_CLI.
//
// Setup: cwd is ooda/. bin/ooda is the product CLI. Never exec oodac check.
//
// Beats:
//   1. Require bin/ooda.
//   2. refuse_oodac_cli must fail closed.
//   3. Reaching PASSED means the lock did not fire.

import "scripts/oodac_identity.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if !path_exists(fs, "bin/ooda") {
        println("FAIL missing bin/ooda");
        process_exit(1);
    }
    refuse_oodac_cli(p, "bin/ooda");
    println("FAIL refuse_oodac_cli accepted the product CLI");
    process_exit(1);
}
