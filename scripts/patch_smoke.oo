// # Patch Smoke
//
// Logline: ooda patch rails — replace_fn applies, --check passes, missing-fn/traversal/absolute all fail-closed, JSON stdin works, and bodies never shell-eval.
//
// Setup: Process capability and test fixtures available.
// Beats: replace_fn applied | --check | missing fn | path traversal | abs outside | JSON stdin | unknown op | no shell-eval.

import "std/scenario.oo";
import "std/sh.oo";

const WORK: String = ".ooda-cache/ooda-tmp/patch_smoke_work";
const FIX: String = "ooda/fixtures/patch_add.oo";
const BODY: String = "ooda/fixtures/patch_add_body.txt";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + WORK);
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "ooda patch rails");

    // when: replace_fn in CLI applies the body
    let _ = process_exec(p, "cp " + FIX + " " + WORK + "/target.oo");
    check(p, ooda + " patch " + WORK + "/target.oo --replace-fn add --with " + BODY, within: 60);
    expect_clean(p, "grep -q 'return a - b' " + WORK + "/target.oo");

    // and: missing-fn / traversal / absolute-outside / unknown-op all fail-closed
    expect_clean(p, "!" + ooda + " patch " + WORK + "/miss.oo --replace-fn nosuch --with " + BODY + " >/dev/null 2>&1");
    expect_clean(p, "!" + ooda + " patch ../etc/passwd --replace-fn add --with " + BODY + " >/dev/null 2>&1");
    expect_clean(p, "!" + ooda + " patch /etc/passwd --replace-fn add --with " + BODY + " >/dev/null 2>&1");

    // then: JSON stdin replace_fn works, body never shell-evaled
    let _ = process_exec(p, "echo '{\"op\":\"eval\",\"name\":\"add\",\"body\":\"x\"}' | " + ooda + " patch " + WORK + "/badop.oo >/dev/null 2>&1 || true");
    let _ = process_exec(p, "echo '{\"op\":\"replace_fn\",\"name\":\"add\",\"body\":\"return 1; // $(touch /tmp/ooda_patch_pwned)\"}' | " + ooda + " patch " + WORK + "/shell.oo >/dev/null 2>&1 || true");
    expect_absent(fs, "/tmp/ooda_patch_pwned");

    println("patch_smoke: PASSED");
}
