// # Patch Smoke
//
// Logline: Live ooda patch replaces one function body and refuses bad paths.
//
// Setup: Product ooda binary. Fixtures live under fixtures/, not ooda/fixtures/.
//
// Beats:
//   1. replace_fn add writes return a - b from the body file.
//   2. Missing function, .. traversal, and absolute paths fail closed.
//   3. No JSON-stdin product path; leftover pwn files must stay absent.

import "std/scenario.oo";
import "std/sh.oo";

fn pick_ooda(p: &ProcessCap, root: String) -> String {
    let envb = match sh_env_get_or(p, "OODA", "") { Ok(s) => s, Err(_) => "" };
    if envb != "" {
        if expect_quiet(p, "test -x " + envb).is_ok() { return envb; }
    }
    let n1 = "/tmp/ooda_cli_native";
    if expect_quiet(p, "test -x " + n1).is_ok() { return n1; }
    let n2 = "/tmp/ooda_cli";
    if expect_quiet(p, "test -x " + n2).is_ok() { return n2; }
    return root + "/bin/ooda";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let ooda = pick_ooda(p, root);
    let work = ".ooda-cache/ooda-tmp/patch_smoke_work";
    let _ = sh_mkdir_p(fw, ".ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "ooda patch rails");

    if expect_quiet(p, "test -x " + ooda).is_err() { println("FAIL no ooda"); process_exit(1); }
    if expect_present(fs, "fixtures/patch_add.oo").is_err() { println("FAIL fixtures/patch_add.oo"); process_exit(1); }
    if expect_present(fs, "fixtures/patch_add_body.txt").is_err() { println("FAIL body"); process_exit(1); }

    let _ = sh_clean(fw, fs, work);
    if sh_mkdir_p(fw, work).is_err() { println("FAIL mkdir"); process_exit(1); }
    if check(p, "cp fixtures/patch_add.oo " + work + "/target.oo", within: 5).is_err() {
        println("FAIL copy target"); process_exit(1);
    }
    if check(p, "OODA_FS_WRITEDIR=" + root + " " + ooda + " patch " + work + "/target.oo --replace-fn add --with fixtures/patch_add_body.txt", within: 60).is_err() {
        println("FAIL replace_fn"); process_exit(1);
    }
    if expect_clean(p, "grep -q 'return a - b' " + work + "/target.oo").is_err() {
        println("FAIL body not applied"); process_exit(1);
    }

    if check(p, "cp fixtures/patch_add.oo " + work + "/miss.oo", within: 5).is_err() {
        println("FAIL copy miss"); process_exit(1);
    }
    if expect_clean(p, "! " + ooda + " patch " + work + "/miss.oo --replace-fn nosuch --with fixtures/patch_add_body.txt").is_err() {
        println("FAIL missing-fn should fail"); process_exit(1);
    }
    if expect_clean(p, "! " + ooda + " patch ../etc/passwd --replace-fn add --with fixtures/patch_add_body.txt").is_err() {
        println("FAIL traversal should fail"); process_exit(1);
    }
    if expect_clean(p, "! " + ooda + " patch /etc/passwd --replace-fn add --with fixtures/patch_add_body.txt").is_err() {
        println("FAIL absolute should fail"); process_exit(1);
    }
    if expect_absent(fs, "/tmp/ooda_patch_pwned").is_err() {
        println("FAIL pwn file exists"); process_exit(1);
    }

    let _ = sh_clean(fw, fs, work);
    println("patch_smoke: PASSED");
}
