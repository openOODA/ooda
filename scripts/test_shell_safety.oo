// # Shell safety rails
//
// Logline: Resolve ooda and oodac from the tree and run the shell-safety probes.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Find the repo root that holds bin/ooda.
//   2. Point at ooda and oodac.
//   3. Run the safety cases under those binaries.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";
import "std/result.oo";
import "std/os/env.oo";

pub fn main(p_cap: &ProcessCap, fsr_cap: &FsReadCap, fsw_cap: &FsWriteCap, env_cap: &EnvCap) {
    let mut tr: TestRunner = test_runner_new();

    // Determine root directory to resolve binaries based on where the script was run
    let mut root: String = ".";
    let root_bin: Bool = fs_path_exists(fsr_cap, "bin/ooda");
    if root_bin {
        root = ".";
    } else {
        let root_bin_up: Bool = fs_path_exists(fsr_cap, "../bin/ooda");
        if root_bin_up {
            root = "..";
        }
    }

    let ooda_bin: String = root + "/bin/ooda";
    let oodac_bin: String = root + "/oodac/oodac";

    // Obtain or fallback the temporary directory, and strip trailing newlines
    let tmpdir_res: Result[String, String] = env_get(env_cap, "TMPDIR");
    let tmpdir: String = match tmpdir_res { Ok(v) => v, Err(e) => ".ooda-cache/ooda-tmp" };
    let _1: Result[Void, String] = fs_mkdir(fsw_cap, tmpdir);

    // --- 1) product ooda check: double-quote break must NOT create marker ---
    let m1: String = tmpdir + "/ooda_shell_safety_marker_prod";
    let _2: Result[Void, String] = fs_remove_file(fsw_cap, m1);

    let mut cmd1: List[String] = cmd_new(ooda_bin);
    cmd1 = cmd_arg(cmd1, "check");
    cmd1 = cmd_arg(cmd1, root + "/fixtures/int_main.oo\"; touch '" + m1 + "'; echo \"");

    let _3: Result[String, String] = cmd_execute(cmd1, p_cap);

    let m1_exists: Bool = fs_path_exists(fsr_cap, m1);
    tr = test_assert(tr, "product check quote-break no marker", m1_exists == false);
    let _4: Result[Void, String] = fs_remove_file(fsw_cap, m1);

    // --- 2) product ooda check: dollar/backtick noise must NOT create marker ---
    let m2: String = tmpdir + "/ooda_shell_safety_marker_dq";
    let _5: Result[Void, String] = fs_remove_file(fsw_cap, m2);

    let mut cmd2: List[String] = cmd_new(ooda_bin);
    cmd2 = cmd_arg(cmd2, "check");
    cmd2 = cmd_arg(cmd2, root + "/fixtures/int_main.oo$(touch " + m2 + ")");

    let _6: Result[String, String] = cmd_execute(cmd2, p_cap);

    let m2_exists: Bool = fs_path_exists(fsr_cap, m2);
    tr = test_assert(tr, "product check dollar-paren no marker", m2_exists == false);
    let _7: Result[Void, String] = fs_remove_file(fsw_cap, m2);

    // --- 3) oodac build: quote-break path must NOT create marker ---
    let m3: String = tmpdir + "/ooda_shell_safety_marker_build";
    let out3: String = tmpdir + "/ss_build_out";
    let _8: Result[Void, String] = fs_remove_file(fsw_cap, m3);

    let mut cmd3: List[String] = cmd_new(oodac_bin);
    cmd3 = cmd_arg(cmd3, "build");
    cmd3 = cmd_arg(cmd3, root + "/fixtures/int_main.oo\"; touch '" + m3 + "'; echo \"");
    cmd3 = cmd_arg(cmd3, out3);

    let _9: Result[String, String] = cmd_execute(cmd3, p_cap);

    let m3_exists: Bool = fs_path_exists(fsr_cap, m3);
    tr = test_assert(tr, "oodac build quote-break no marker", m3_exists == false);
    let _10: Result[Void, String] = fs_remove_file(fsw_cap, m3);
    let _11: Result[Void, String] = fs_remove_file(fsw_cap, out3);

    // --- 4) honest control: normal product check still works ---
    let mut cmd4: List[String] = cmd_new(ooda_bin);
    cmd4 = cmd_arg(cmd4, "check");
    cmd4 = cmd_arg(cmd4, root + "/fixtures/int_main.oo");

    let res4: Result[String, String] = cmd_execute(cmd4, p_cap);
    tr = test_assert(tr, "normal product check still works", res4.is_ok());

    test_summary(tr);
}
