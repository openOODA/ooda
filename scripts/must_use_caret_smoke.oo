// # Must-use type error prints path and caret
//
// Logline: Cache-cold check of Ok(1); shows ERR type, path, the Ok, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_must_use_ok_stmt.oo prints unused Ok value (must-use), --> path, and ^.
//   2. Exit is non-zero and there is no OK. tc_must_use_discard.oo also has --> and ^.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/must_use_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_must_use_ok_stmt.oo > " + tmpd +
        "/ok.out; echo $? > " + tmpd + "/ok.ec; true").is_err() {
        fail("check ok");
    }
    if process_exec(p, "grep -q 'unused Ok value (must-use)' " + tmpd +
        "/ok.out && grep -q 'tc_must_use_ok_stmt.oo' " + tmpd +
        "/ok.out && grep -Fq -- '-->' " + tmpd + "/ok.out && grep -q '\\^' " +
        tmpd + "/ok.out && ! grep -qE '^OK' " + tmpd +
        "/ok.out && test \"$(cat " + tmpd + "/ok.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_must_use_discard.oo > " + tmpd +
        "/d.out; echo $? > " + tmpd + "/d.ec; true").is_err() {
        fail("check discard");
    }
    if process_exec(p, "grep -q 'unused Result (must-use; do not discard boom)' " +
        tmpd + "/d.out && grep -q 'tc_must_use_discard.oo' " + tmpd +
        "/d.out && grep -Fq -- '-->' " + tmpd + "/d.out && grep -q '\\^' " +
        tmpd + "/d.out && ! grep -qE '^OK' " + tmpd +
        "/d.out && test \"$(cat " + tmpd + "/d.ec)\" -ne 0").is_err() {
        fail("no discard caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("must_use_caret_smoke: PASSED");
}
