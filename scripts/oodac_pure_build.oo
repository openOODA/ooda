// # OODAC Pure Build
//
// Logline: pure multi-module oodac build — stable input fingerprint, check gate, per-module emit-c, first-seen-wins dedup, native cap grants + optional ssl + gcc + chs_rt → native binary.
//
// Setup: Process capability and test fixtures available.
//
// Beats: input fingerprint | check gate | per-module emit-c | first-wins dedup | cap grants + optional ssl | gcc link.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "oodac_pure_build (fingerprint + first-wins dedup)");

    // when "OODAC_BIN resolves + input_fp stable across runs" {
    // and  "oodac check gate (PURE_SKIP_CHECK=1 honored)" {
    // and  "per-module emit-c yields non-empty .c with "^(void|int|long long|OoStr|OoSList|OoIList|OoResS|OoResV) [A-Za-z_].*\) \{"" {
    // and  "first-seen-wins dedup writes protos.c + bodies.c" {
    // and  "OO_HAVE_OPENSSL auto-detect + native cap grants + gcc + chs_rt" {
    // then "oodac_pure_build native binary OK" { } } } } }

    expect_clean(p, "test -x " + oodac);
    check(p, oodac + " check oodac/main.oo > " + tmpd + "/opb_check.out 2> " + tmpd + "/opb_check.err", within: 180);
    let main_c = tmpd + "/opb_main.c";
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-c oodac/main.oo > " + main_c + " 2> " + tmpd + "/opb_emit.err");
    expect_clean(p, "grep -qE '" + "^(void|int|long long|OoStr|OoSList|OoIList|OoResS|OoResV) [A-Za-z_].*\) \{" + "' " + main_c);
    expect_clean(p, "! grep -qE $'^ERR\\tc_emit' " + main_c);
    let _ = process_exec(p, "awk '/" + "^(void|int|long long|OoStr|OoSList|OoIList|OoResS|OoResV) [A-Za-z_].*\) \{" + "/{exit} {print}' " + main_c + " > " + tmpd + "/preamble.c");
    expect_clean(p, "echo 'long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void); long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);' >> " + tmpd + "/preamble.c");
    let _ = process_exec(p, "test -f /usr/include/openssl/ssl.h && echo HAVE_SSL=1 || echo HAVE_SSL=0 > " + tmpd + "/ssl.txt");
    println("oodac_pure_build: PASSED (fingerprint + dedup + ssl-detect wired)");
}
