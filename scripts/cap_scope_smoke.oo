// # Fuel, path scope, host scope, hop, untrusted launch
//
// Logline: Prove fail-closed fuel, slash-boundary paths, host suffix, hop-2, launch sink.
//
// Setup: cwd is ooda/. No network. No oodac emit.
//
// Beats:
//   1. Empty fuel and cost 0 deny. After 3 from 5, left is 2.
//   2. /tmp does not allow /tmp2. .. is denied.
//   3. Hop 2 denied. &TimeCap in a body is a token. launch sink denies when marked.

import "std/sec/agent_send.oo";
import "std/sec/fuel_budget.oo";
import "std/sec/host_scope.oo";
import "std/sec/path_scope.oo";
import "std/sec/untrusted.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap) {
    let z: FuelBudget = fuel_new(0);
    if fuel_left(z) != 0 {
        fail("new0");
    }
    let a: FuelBudget = fuel_new(5);
    if fuel_can(a, 0) {
        fail("cost0");
    }
    if !fuel_can(a, 3) {
        fail("can3");
    }
    let n2: Int = fuel_after(a, 3);
    if n2 != 2 {
        fail("left2");
    }
    let a2: FuelBudget = fuel_new(n2);
    if fuel_can(a2, 3) {
        fail("over");
    }
    if path_scope_allows("", "/tmp/a") {
        fail("empty prefix");
    }
    if path_scope_allows("/tmp", "/tmp2") {
        fail("tmp2");
    }
    if !path_scope_allows("/tmp", "/tmp") {
        fail("tmp eq");
    }
    if !path_scope_allows("/tmp", "/tmp/a") {
        fail("tmp/a");
    }
    if path_scope_allows("/tmp", "a/../b") {
        fail("dotdot");
    }
    if host_scope_allows("", "example.com") {
        fail("empty host");
    }
    if !host_scope_allows("example.com", "example.com") {
        fail("exact host");
    }
    if host_scope_allows("example.com", "evil.example.com.attacker") {
        fail("attacker");
    }
    if !host_scope_allows("*.example.com", "foo.example.com") {
        fail("star");
    }
    if host_scope_allows("*.example.com", "example.com") {
        fail("apex");
    }
    if msg_hop_allowed("2") {
        fail("hop2");
    }
    if !msg_carries_token("&TimeCap") {
        fail("timecap");
    }
    if !untrusted_sink_denied("launch", true) {
        fail("launch marked");
    }
    if untrusted_sink_denied("launch", false) {
        fail("launch clear");
    }
    println("cap_scope_smoke: PASSED");
}
