// # Fuel, path scope, host scope, hop, untrusted launch
//
// Logline: Prove fail-closed fuel, slash-boundary paths, host suffix, hop-2, launch sink.
//
// Setup: cwd is ooda/. No network. No oodac emit.
//
// Beats:
//   1. Empty fuel and cost 0 deny. After 3 from 5, left is 2. Denied after is -1.
//   2. /tmp does not allow /tmp2 or /tmpevil. /tmp/ allows /tmp/a. Join refuses .. and absolute.
//   3. Empty hop and hop 2 denied. Any &NameCap is a token. launch sink denies when marked.

import "std/sec/agent_send.oo";
import "std/sec/fuel_budget.oo";
import "std/sec/host_scope.oo";
import "std/sec/path_scope.oo";
import "std/sec/untrusted.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap) {
    let z: FuelBudget = fuel_new(0);
    if fuel_left(z) != 0 {
        fail("new0");
    }
    let a: FuelBudget = fuel_new(5);
    if fuel_can(a, 0) {
        fail("cost0");
    }
    if !fuel_can(a, 3) {
        fail("can3");
    }
    let n2: Int = fuel_after(a, 3);
    if n2 != 2 {
        fail("left2");
    }
    let a2: FuelBudget = fuel_new(n2);
    if fuel_can(a2, 3) {
        fail("over");
    }
    if fuel_after(z, 1) != -1 {
        fail("deny empty");
    }
    if fuel_after(a, 0) != -1 {
        fail("deny cost0");
    }
    if fuel_after(a, 6) != -1 {
        fail("deny over");
    }
    if path_scope_allows("", "/tmp/a") {
        fail("empty prefix");
    }
    if path_scope_allows("/tmp", "/tmp2") {
        fail("tmp2");
    }
    if path_scope_allows("/tmp", "/tmpevil") {
        fail("tmpevil");
    }
    if path_scope_allows("/tmp", "/tmp/foo/%2e%2e/etc") {
        fail("pct");
    }
    if !untrusted_sink_denied("unknown", true) {
        fail("unknown sink");
    }
    if !path_scope_allows("/tmp", "/tmp") {
        fail("tmp eq");
    }
    if !path_scope_allows("/tmp", "/tmp/a") {
        fail("tmp/a");
    }
    if !path_scope_allows("/tmp/", "/tmp/a") {
        fail("tmp/ slash");
    }
    if path_scope_allows("/tmp", "a/../b") {
        fail("dotdot");
    }
    if path_scope_allows("..", "/tmp/a") {
        fail("prefix ..");
    }
    if path_scope_allows("/tmp", "/tmp\\x") {
        fail("backslash");
    }
    let jdot: Result[String, String] = path_scope_join("/tmp", "..");
    if !jdot.is_err() {
        fail("join ..");
    }
    let jesc: Result[String, String] = path_scope_join("/tmp", "../evil");
    if !jesc.is_err() {
        fail("join ../evil");
    }
    let jabs: Result[String, String] = path_scope_join("/tmp", "/etc/passwd");
    if !jabs.is_err() {
        fail("join abs");
    }
    if host_scope_allows("", "example.com") {
        fail("empty host");
    }
    if !host_scope_allows("example.com", "example.com") {
        fail("exact host");
    }
    if host_scope_allows("example.com", "evil.example.com.attacker") {
        fail("attacker");
    }
    if !host_scope_allows("*.example.com", "foo.example.com") {
        fail("star");
    }
    if host_scope_allows("*.example.com", "example.com") {
        fail("apex");
    }
    if host_scope_allows("*.example.com", "EXAMPLE.com") {
        fail("apex fold");
    }
    if !host_scope_allows("example.com", "Example.COM") {
        fail("case");
    }
    if host_scope_allows("*.example.com", "evil.example.com.attacker") {
        fail("star attacker");
    }
    if !host_scope_allows("*.example.com", "FOO.example.com") {
        fail("star case");
    }
    let uh: String = host_scope_from_url("https://Foo.Example.COM:443/x");
    if !host_scope_allows("*.example.com", uh) {
        fail("url host");
    }
    if !host_scope_allows("example.com", uh) {
        if !host_scope_allows("Foo.Example.COM", uh) {
            fail("url fold-or-exact");
        }
    }
    let v6: String = host_scope_from_url("http://[::1]/x");
    if v6 != "[::1]" {
        fail("ipv6");
    }
    let v6p: String = host_scope_from_url("https://[2001:db8::1]:443/x");
    if v6p != "[2001:db8::1]" {
        fail("ipv6 port");
    }
    if msg_hop_allowed("2") {
        fail("hop2");
    }
    if msg_hop_allowed("") {
        fail("hop empty");
    }
    if !msg_hop_allowed("0") {
        fail("hop0");
    }
    if !msg_hop_allowed("1") {
        fail("hop1");
    }
    if !msg_carries_token("&TimeCap") {
        fail("timecap");
    }
    if !msg_carries_token("&HttpCap") {
        fail("httpcap");
    }
    if !msg_carries_token("&FsCap") {
        fail("fscap");
    }
    if !msg_carries_token("&HitlCap") {
        fail("hitl");
    }
    if !msg_carries_token("&UnsafeFFICap") {
        fail("ffi");
    }
    if !msg_carries_token("&BindCap") {
        fail("bind");
    }
    if !msg_carries_token("oo_cap_grant") {
        fail("grant");
    }
    if msg_carries_token("no token here") {
        fail("plain");
    }
    if !untrusted_sink_denied("launch", true) {
        fail("launch marked");
    }
    if untrusted_sink_denied("launch", false) {
        fail("launch clear");
    }
    let pr: Result[String, String] = path_scope_read("/tmp", "/tmp/a");
    if pr.is_err() {
        fail("read ok");
    }
    let prb: Result[String, String] = path_scope_read("/tmp", "/tmp2");
    if !prb.is_err() {
        fail("read tmp2");
    }
    if !host_scope_ok_url("*.example.com", "https://Foo.Example.COM:443/x") {
        fail("ok url");
    }
    if host_scope_ok_url("example.com", "https://evil.example.com/x") {
        fail("ok url evil");
    }
    if process_exec(p, "grep -q 'return path_scope_allows' std/sec/sys/landlock_engine.oo").is_err() {
        fail("landlock prefix");
    }
    if process_exec(p, "grep -q 'return path_scope_allows' std/sec/sys/audit_engine.oo").is_err() {
        fail("audit prefix");
    }
    println("cap_scope_smoke: PASSED");
}
