// # Check prints source line and caret
//
// Logline: Cache-cold check of Int="hi" shows ERR type, path, the let x line, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_int_hi.oo prints ERR type, --> path, a line with let x, and ^.
//   2. Line of the error stays under 50.
//   3. sum_miss_arm still needs Off and does not print OK.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/diag_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -q 'Type error at 13:' " + tmpd + "/hi.out").is_err() {
        fail("no local line");
    }
    if process_exec(p, "grep -q 'tc_int_hi.oo' " + tmpd + "/hi.out && grep -q 'let x' " +
        tmpd + "/hi.out && grep -q '\\^' " + tmpd + "/hi.out && test \"$(cat " +
        tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/sum_miss_arm.oo > " + tmpd +
        "/miss.out; echo $? > " + tmpd + "/miss.ec; true").is_err() {
        fail("check miss");
    }
    if process_exec(p, "grep -q 'non-exhaustive match: Flag needs Off' " + tmpd +
        "/miss.out && ! grep -qE '^OK' " + tmpd + "/miss.out && test \"$(cat " +
        tmpd + "/miss.ec)\" -ne 0").is_err() {
        fail("miss Off");
    }
    println("diag_caret_smoke: PASSED");
}
