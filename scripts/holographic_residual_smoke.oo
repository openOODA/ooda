// ===================================================================
// Holographic Residual Smoke Residual Smoke
// ===================================================================
// job: residual honesty smoke — generated pack
// in:  bootstrap/HOLOGRAPHIC.oot, fixtures/holographic_marker.oo
// out: exit 0 if doc markers and residual wording present

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let doc_path = root + "/bootstrap/HOLOGRAPHIC.oot";
    let fix_path = root + "/fixtures/holographic_marker.oo";
    let marker = "HOLOGRAPHIC_RESIDUAL_ALPHA";
    let fixline = "HOLOGRAPHIC: residual";
    let script_name = "holographic_residual_smoke";
    
    // Doc exists
    let doc_exists = cmd_exec(p, "test -f " + doc_path);
    tr = test_assert(tr, "doc file exists", doc_exists.is_ok());
    
    if !doc_exists.is_ok() {
        test_summary(tr);
        process_exit(1);
    }
    
    // Marker check
    let check_marker = cmd_exec(p, "grep -q " + marker + " " + doc_path);
    tr = test_assert(tr, "doc marker " + marker, check_marker.is_ok());
    
    // Must not claim shipped without residual
    let no_claim_res = cmd_exec(p, "test -z \"$(grep -nEi 'fully shipped|enforced in product|sandbox is live' " + doc_path + " 2>/dev/null | grep -viE 'not |residual|do not|never|no ')\"");
    tr = test_assert(tr, "doc does not claim product-green enforce", no_claim_res.is_ok());
    
    // Fail-closed residual wording
    let check_fail_closed = cmd_exec(p, "grep -qiE 'fail-closed residual|Fail-closed residual' " + doc_path);
    tr = test_assert(tr, "fail-closed residual wording", check_fail_closed.is_ok());
    
    // Fixture check
    let fix_exists = cmd_exec(p, "test -f " + fix_path);
    tr = test_assert(tr, "fixture file exists", fix_exists.is_ok());
    
    if fix_exists.is_ok() {
        let check_fixline = cmd_exec(p, "grep -q \"" + fixline + "\" " + fix_path);
        tr = test_assert(tr, "fixture marker " + fixline, check_fixline.is_ok());
    }
    
    // Dual-claim scan residual surface
    let dual_claim = cmd_exec(p, "grep -rn --include='*.oot' -E 'shipped as enforced|fully sealed shipped' " + root + "/bootstrap 2>/dev/null | grep -v \"" + doc_path + "\" | grep -vi residual | head -5 || true");
    if dual_claim.is_ok() {
        let dual_claim_content = trim(dual_claim.unwrap());
        if str_len(dual_claim_content) > 0 {
            tr = test_assert(tr, "no dual-claim on residual surface", false);
        } else {
            tr = test_assert(tr, "no dual-claim on residual surface", true);
        }
    }
    
    // ci_product wire
    let check_ci = cmd_exec(p, "grep -q '" + script_name + "' " + root + "/scripts/ci_product.sh");
    tr = test_assert(tr, "ci_product wire", check_ci.is_ok());
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("holographic_residual_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
