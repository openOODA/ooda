// # EBNF Align Residual Stays Honest
//
// Logline: Verify bootstrap/EBNF_ALIGN.oot preserves residual markers, fixture consistency, and CI integration.
//
// Setup: EBNF_ALIGN.oot document, ebnf_align_marker fixture, and ci_product.sh exist on disk.
//
// Beats:
//   1. Verify EBNF_ALIGN.oot exists with EBNF_ALIGN_RESIDUAL_ALPHA and non-claim phrasing.
//   2. Check ebnf_align_marker.oo fixture contains the residual marker line.
//   3. Confirm ci_product.sh wires ebnf_align_residual_smoke into the test suite.
import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/EBNF_ALIGN.oot";
const FIX: String = "ooda/fixtures/ebnf_align_marker.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _    = scenario(p, fs, "ebnf align residual");

    // when — doc + marker + fail-closed + non-claims
    let _ = expect_present(fs, root + "/" + DOC);
    let _ = expect_substring(fs, root + "/" + DOC, "EBNF_ALIGN_RESIDUAL_ALPHA");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);
    let _ = expect_quiet(p, "grep -qiE 'do .* claim|not claim' " + root + "/" + DOC);

    // then — fixture + ci wire
    let _ = expect_present(fs, root + "/" + FIX);
    let _ = expect_substring(fs, root + "/" + FIX, "EBNF_ALIGN: residual");
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "ebnf_align_residual_smoke");

    println("ebnf_align_residual_smoke: PASSED");
}