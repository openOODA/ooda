// # Native CLI Hello Surface
//
// Logline: Native ooda check, outline, and dump tokens run hello, and residual digest fails closed without ERR_NO_PRODUCT_SCRIPT.
//
// Setup: $OODA or /tmp/ooda_cli or bin/ooda; fixtures/hello.oo on disk.
//
// Beats:
//   1. ooda check hello prints OK.
//   2. ooda outline hello prints pub greet and main.
//   3. ooda dump tokens hello emits token kinds.
//   4. ooda digest exits nonzero without ERR_NO_PRODUCT_SCRIPT.

import "std/os/process.oo";

fn must_ok(r: Result[String, String], tag: String) {
    if r.is_err() {
        println("FAIL " + tag);
        process_exit(1);
    }
}

fn must_err(r: Result[String, String], tag: String) {
    if r.is_ok() {
        println("FAIL " + tag);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap) {
    let mut ooda = "./bin/ooda";
    if process_exec(p, "test -x /tmp/ooda_cli_native").is_ok() {
        ooda = "/tmp/ooda_cli_native";
    } else if process_exec(p, "test -x /tmp/ooda_cli").is_ok() {
        ooda = "/tmp/ooda_cli";
    }
    let hello = "fixtures/hello.oo";
    let work = ".ooda-cache/ooda-tmp/cli_native_work";

    // when native ooda is on disk
    must_ok(process_exec(p, "test -x " + ooda), "ooda binary");
    must_ok(process_exec(p, "test -f " + hello), "fixtures/hello.oo");
    must_ok(process_exec(p, "mkdir -p " + work), "work dir");

    // and ooda check hello
    must_ok(process_exec(p, ooda + " check " + hello + " > " + work + "/check.out 2> " + work + "/check.err"), "ooda check hello");
    must_ok(process_exec(p, "grep -q '^OK' " + work + "/check.out"), "check OK");
    must_ok(process_exec(p, "! grep -q ERR_NO_PRODUCT_SCRIPT " + work + "/check.out " + work + "/check.err"), "check not product_sh");

    // and ooda outline hello
    must_ok(process_exec(p, ooda + " outline " + hello + " > " + work + "/outline.out 2> " + work + "/outline.err"), "ooda outline hello");
    must_ok(process_exec(p, "grep -q 'pub fn greet' " + work + "/outline.out"), "outline greet");
    must_ok(process_exec(p, "grep -q 'pub fn main' " + work + "/outline.out"), "outline main");
    must_ok(process_exec(p, "! grep -q ERR_NO_PRODUCT_SCRIPT " + work + "/outline.out " + work + "/outline.err"), "outline not product_sh");

    // and ooda dump tokens hello
    must_ok(process_exec(p, ooda + " dump tokens " + hello + " > " + work + "/tok.out 2> " + work + "/tok.err"), "ooda dump tokens hello");
    must_ok(process_exec(p, "grep -q KW_PUB " + work + "/tok.out"), "dump tokens KW_PUB");
    must_ok(process_exec(p, "! grep -q ERR_NO_PRODUCT_SCRIPT " + work + "/tok.out " + work + "/tok.err"), "dump tokens not product_sh");

    // then residual digest exits nonzero without ERR_NO_PRODUCT_SCRIPT
    must_err(process_exec(p, ooda + " digest > " + work + "/digest.out 2> " + work + "/digest.err"), "digest nonzero");
    must_ok(process_exec(p, "! grep -q ERR_NO_PRODUCT_SCRIPT " + work + "/digest.out " + work + "/digest.err"), "digest not product_sh");

    println("cli_native_smoke: PASSED");
}
