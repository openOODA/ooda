// # openOODA Stage 42 Master Integration Smoke Suite
//
// Logline: Comprehensive integration proof verifying Sovereign 10k Stdlib Expansion for Media, Codecs & Vision vertical.
//
// Setup: Exercises PNG image decoding, FLAC audio parsing, spatial convolution filtering, and Sobel edge detection under ProcessCap.
//
// Beats:
//   1. PNG Image Codec: verify IHDR parsing, uncompressed buffer sizing, and Paeth predictor calculations.
//   2. FLAC Audio Codec: verify stream metadata parsing, duration calculation, and audio bandwidth estimation.
//   3. Spatial Image Convolution: verify Gaussian blur and sharpen kernel generation and pixel filtering.
//   4. Sobel Edge Detection: verify gradient magnitude calculations and threshold classification.

import "std/multimedia/png_codec.oo";
import "std/multimedia/flac_audio.oo";
import "std/media_dsp/spatial_convolution.oo";
import "std/media_dsp/edge_detector.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA Stage 42: Sovereign 10k Stdlib — Media & Codecs");
    println("===================================================================");

    // -------------------------------------------------------------
    // Part I: PNG Image Codec
    // -------------------------------------------------------------
    let png_hdr: PngCodecHeader = png_codec_header_new(1920, 1080, 8, 6);
    let buf_size: Int = png_codec_uncompressed_bytes(png_hdr);
    let paeth_val: Int = png_codec_paeth_predictor(100, 105, 102);
    let valid_hdr: Bool = png_hdr.is_valid_header;

    if !valid_hdr || buf_size != 8294400 || paeth_val != 102 {
        println("FAIL: Stage 42 PNG codec verification failed");
        process_exit(1);
    }
    println("  [PASS] 1. PNG Image Codec (IHDR Headers & Paeth Predictor Verified)");

    // -------------------------------------------------------------
    // Part II: FLAC Lossless Audio Codec
    // -------------------------------------------------------------
    let flac_info: FlacAudioStreamInfo = flac_audio_stream_info_new(48000, 2, 24, 2880000);
    let duration_s: Int = flac_audio_duration_seconds(flac_info);
    let bps: Int = flac_audio_bytes_per_second(flac_info);

    if duration_s != 60 || bps != 288000 {
        println("FAIL: Stage 42 FLAC audio codec verification failed");
        process_exit(1);
    }
    println("  [PASS] 2. FLAC Audio Codec (Stream Info & Bitrate Calculation)");

    // -------------------------------------------------------------
    // Part III: Spatial Image Convolution
    // -------------------------------------------------------------
    let g_kern: SpatialConvolutionKernel = spatial_convolution_gaussian_3x3();
    let filtered_px: Int = spatial_convolution_apply_pixel(g_kern, 1600);

    if filtered_px != 100 || g_kern.scale_divisor != 16 {
        println("FAIL: Stage 42 spatial convolution filtering failed");
        process_exit(1);
    }
    println("  [PASS] 3. Spatial Image Convolution (2D Gaussian Filter Kernels)");

    // -------------------------------------------------------------
    // Part IV: Sobel Edge Detection
    // -------------------------------------------------------------
    let edge_res: EdgeDetectorResult = edge_detector_sobel_gradient(30, 40, 50);
    let is_edge: Bool = edge_res.is_edge;
    let mag: Int = edge_res.magnitude;

    if !is_edge || mag != 250 {
        println("FAIL: Stage 42 Sobel edge detector failed");
        process_exit(1);
    }
    println("  [PASS] 4. Sobel Edge Detection (Gradient Magnitudes & Binary Feature Maps)");

    println("stage42_media_codecs_smoke: PASSED");
}
