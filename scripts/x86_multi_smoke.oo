// # emit-x86 multi-module separate compilation and linkage lock

// Logline: Lock emit-x86 output against the named regression scenario with one command-line assert per smoke.
import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) { println("FAIL " + msg); process_exit(1); }
fn pick_oodac(p: &ProcessCap, root: String) -> String { return root + "/oodac/oodac"; }

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 multi-module separate compilation").is_err() { fail("scenario"); }
    let oodac = pick_oodac(p, root);
    let lib_src = root + "/fixtures/x86_multi_lib.oo";
    let main_src = root + "/fixtures/x86_multi_main.oo";
    let lib_s = tmpd + "/x86_lib.s";
    let main_s = tmpd + "/x86_main.s";
    let lib_o = tmpd + "/x86_lib.o";
    let main_o = tmpd + "/x86_main.o";
    let bin = tmpd + "/x86_multi.bin";
    let out = tmpd + "/x86_multi.out";
    if check(p, oodac + " emit-x86 " + lib_src + " > " + lib_s, 30).is_err() { fail("emit lib"); }
    if check(p, oodac + " emit-x86 " + main_src + " > " + main_s, 30).is_err() { fail("emit main"); }
    if check(p, "as --64 -o " + lib_o + " " + lib_s, 10).is_err() { fail("as lib"); }
    if check(p, "as --64 -o " + main_o + " " + main_s, 10).is_err() { fail("as main"); }
    if check(p, "ld -o " + bin + " " + main_o + " " + lib_o, 10).is_err() { fail("ld multi"); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run multi"); }
    if expect_clean(p, "grep -qx '42' " + out).is_err() { fail("stdout not 42"); }
    println("x86_multi_smoke: PASSED");
}
