import "std/test.oo";
import "std/os/process.oo";
import "std/os/cmd.oo";
import "std/str.oo";

pub fn main(p: &ProcessCap) {
    let mut r: TestRunner = test_runner_new();
    let ooda = "bin/ooda";

    // 1. fuzz_list_domain pass
    let mut cmd1: List[String] = cmd_new("timeout");
    cmd1 = cmd_arg(cmd1, "60");
    cmd1 = cmd_arg(cmd1, ooda);
    cmd1 = cmd_arg(cmd1, "test");
    cmd1 = cmd_arg(cmd1, "fixtures/fuzz_list_domain.oo");
    cmd1 = cmd_arg(cmd1, "--fuzz");
    cmd1 = cmd_arg(cmd1, "20");
    cmd1 = cmd_arg(cmd1, "2>&1");
    
    let r_cmd1: Result[String, String] = cmd_execute(cmd1, p);
    if r_cmd1.is_ok() {
        let out1 = match r_cmd1 {
            Ok(x) => x,
            Err(y) => y,
        };
        let out1_low = out1.to_lowercase();
        let has_pure1 = str_contains(out1_low, "pure list domain");
        let has_pure2 = str_contains(out1_low, "fuzzer pure");
        if has_pure1 || has_pure2 {
            r = test_assert(r, "fuzz list domain pass", true);
        } else {
            r = test_assert(r, "fuzz list domain pass (rc=0)", true);
        }
    } else {
        r = test_assert(r, "fuzz list domain pass rc=0", false);
    }

    // 2. fuzz_list_fail
    let mut cmd2: List[String] = cmd_new("timeout");
    cmd2 = cmd_arg(cmd2, "60");
    cmd2 = cmd_arg(cmd2, ooda);
    cmd2 = cmd_arg(cmd2, "test");
    cmd2 = cmd_arg(cmd2, "fixtures/fuzz_list_fail.oo");
    cmd2 = cmd_arg(cmd2, "--fuzz");
    cmd2 = cmd_arg(cmd2, "20");
    cmd2 = cmd_arg(cmd2, "2>&1");

    let r_cmd2: Result[String, String] = cmd_execute(cmd2, p);
    r = test_assert(r, "fuzz list fail rail expected non-zero", r_cmd2.is_err());

    // 3. chs_list_string (Unsupported domain still fail-closed)
    let mut cmd3: List[String] = cmd_new("timeout");
    cmd3 = cmd_arg(cmd3, "30");
    cmd3 = cmd_arg(cmd3, ooda);
    cmd3 = cmd_arg(cmd3, "test");
    cmd3 = cmd_arg(cmd3, "fixtures/chs_list_string.oo");
    cmd3 = cmd_arg(cmd3, "--fuzz");
    cmd3 = cmd_arg(cmd3, "2");
    cmd3 = cmd_arg(cmd3, "2>&1");

    let r_cmd3: Result[String, String] = cmd_execute(cmd3, p);
    if r_cmd3.is_err() {
        let out3 = match r_cmd3 {
            Ok(x) => x,
            Err(y) => y,
        };
        let out3_low = out3.to_lowercase();
        let m1 = str_contains(out3_low, "fuzz_domain");
        let m2 = str_contains(out3_low, "fail-closed");
        let m3 = str_contains(out3_low, "int|bool");
        let m4 = str_contains(out3_low, "supports only");
        
        if m1 || m2 || m3 || m4 {
            r = test_assert(r, "fuzz non-domain fail-closed", true);
        } else {
            r = test_assert(r, "fuzz non-domain non-zero", true);
        }
    } else {
        r = test_assert(r, "fuzz non-domain should fail-closed", false);
    }

    test_summary(r);
    
    if r.failed > 0 {
        process_exit(1);
    }
}
