// # Residual Honesty Walks The Surface Scan
// Logline: no Python/--fuzz or strip-default half-truth banners + ooda_test_verify wires + bootstrap default pure.
// Setup: README.md + bootstrap/*.oot + scripts/ooda_test_verify.sh + bootstrap_no_cargo.sh + p3/product smokes on disk.
// Beats: 1. half-truth scan | 2. ooda_test_verify wires | 3. bootstrap default + ci rails clean

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _v0  = scenario(p, "residual honesty");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — collect hits into a temp file
    let hits = root + "/.ooda-cache/ooda-tmp/residual_hits";
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _w1 = process_exec(p, "{ grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'Python residual;' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'Python residual)' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'Python residual,' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'Python residual —' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'harness is Python residual' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'harness still Python' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'strip until M2' README.md bootstrap scripts qa 2>/dev/null; grep -rn --include='*.md' --include='*.sh' --exclude='RELEASE_NOTES*' --exclude='residual_honesty_smoke.sh' --exclude-dir=dist --exclude-dir=.git -e 'default \\`\\`\\`PURE_NO_ARC=1\\`\\`\\`' README.md bootstrap scripts qa 2>/dev/null; } > " + hits);

    // and — drop allowlisted future-goal lines + assert empty
    let _w2 = process_exec(p, "grep -v 'Broader types / multi-param without Python residual' " + hits + " | grep -v 'not Python residual' | grep -v 'no Python residual' | grep -v 'without Python residual' > " + hits + ".f; mv " + hits + ".f " + hits);
    fails = fails + tally(check(p, "! test -s " + hits, 10), "no stale Python/--fuzz or strip-default claims");

    // and — ooda_test_verify wires
    fails = fails + tally(check(p, "grep -q 'ooda_fuzz_pure.sh' " + root + "/scripts/ooda_test_verify.sh", 5), "ooda_test_verify wires ooda_fuzz_pure.sh");
    fails = fails + tally(check(p, "grep -q 'ooda_verify_pure.sh' " + root + "/scripts/ooda_test_verify.sh", 5), "ooda_test_verify wires ooda_verify_pure.sh");

    // and — no Python harness / pure multi build on critical path (ignore comments)
    fails = fails + tally(check(p, "! grep -vE '^[[:space:]]*#' " + root + "/scripts/ooda_test_verify.sh | grep -nE 'python3|[[:space:]]ooda_test_harness\\.py|oodac_pure_build\\.sh'", 5), "ooda_test_verify has no Python / pure multi build on critical path");

    // then — bootstrap default PURE_NO_ARC=0
    fails = fails + tally(check(p, "grep -q 'PURE_NO_ARC=\"${PURE_NO_ARC:-0}\"' " + root + "/scripts/bootstrap_no_cargo.sh", 5), "bootstrap default PURE_NO_ARC=0");

    // then — p3 / product smokes have no Python residual pass banners
    fails = fails + tally(check(p, "! grep -nE 'pass \\\".*Python residual' " + root + "/scripts/p3_no_cargo_smoke.sh " + root + "/scripts/product_pure_dispatch_smoke.sh", 5), "p3/product smokes have no Python residual pass banners");

    if fails > 0 { println("residual_honesty_smoke: FAILED"); process_exit(1); }
    println("residual_honesty_smoke: PASSED");
}
