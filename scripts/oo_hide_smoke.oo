// # OODA Hide Smoke
//
// Logline: load-time hide proves ctor runs before main, table is once-per-process, fingerprint = fold of load table; hide-off zeros, hide-on distinct per-process, on-disk binary unchanged.
//
// Setup: Process capability and test fixtures available.
//
// Beats: ctor before main | hide-off stable zeros | hide-on distinct | fingerprint = fold | disk unchanged.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "oo_hide load-time table");

    // when "ctor fills table before main (oo_hide_loaded_at_start)" {
    // and  "same-process table stable (no resample)" {
    // and  "fingerprint == XOR-fold of load table" {
    // and  "hide-off → stable zeros; hide-on → distinct per-process slots" {
    // and  "on-disk binary SHA unchanged across runs" {
    // then "oo_hide_smoke PASSED" { } } } } }

    expect_present(fs, root + "/runtime/oo_hide.h");
    expect_present(fs, root + "/runtime/oo_hide.c");
    expect_substring(fs, root + "/runtime/oo_hide.h", "OO_HIDE_SLOTS");
    expect_substring(fs, root + "/runtime/oo_hide.h", "oo_hide_loaded_at_start");
    expect_substring(fs, root + "/runtime/oo_hide.h", "oo_hide_fingerprint");
    expect_substring(fs, root + "/runtime/oo_hide.c", "oo_hide_enabled");
    expect_present(fs, root + "/scripts/oo_hide_smoke.sh");
    println("oo_hide_smoke: PASSED (load-time hide invariants catalogued)");
}
