// # Char-at microbenchmark
//
// Logline: Read one character ten million times and print Done.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Hold a short literal string.
//   2. Loop char_at on index 2 ten million times.
//   3. Print Done.

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let s = "abcdefg";
    let mut i = 0;
    while i < 10000000 {
        let ch = char_at(s, 2);
        i = i + 1;
    }
    println("Done!");
}
