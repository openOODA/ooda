// # emit-x86 bound int plus honesty lock
//
// Logline: emit-x86 of fixtures/x86_int_add_bind.oo prints ERR x86_emit and does not write 12.
//
// Setup: cwd is ooda/. Product oodac/oodac. Fold misses. a plus b is not ALU and not digit-strcat.
//
// Beats:
//   1. emit-x86 bound int plus fixture.
//   2. Require ERR and x86_emit on stdout or stderr.
//   3. Refuse _start and refuse .ascii 12.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 bound int plus honesty").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_int_add_bind.oo";
    if expect_present(fs, src).is_err() { fail("no x86_int_add_bind.oo"); }

    let sfile = tmpd + "/x86_int_add.s";
    let serr = tmpd + "/x86_int_add.err";
    if process_exec(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail("successful .s for a+b");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() { fail("no ERR"); }
    if expect_clean(p, "grep -q x86_emit " + sfile + " " + serr).is_err() { fail("no x86_emit"); }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() { fail("silent omit .s"); }
    if expect_clean(p, "! grep -qE '\\.ascii \\\"12' " + sfile).is_err() { fail("digit-strcat 12"); }

    println("x86_int_add_bind_smoke: PASSED");
}
