// # Test Ooda CLI — Run Self-Tests
//
// Logline: Run the cli self-test probes in qa/.

import "std/process/sys.oo";
import "std/fs/path.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, args: List[String]) -> Result[Int, String> {
    let probes: List[String] = ["probe_argv", "probe_spawn", "probe_api_surface"];
    let mut passed: Int = 0;
    let mut failed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(probes) {
        let p: String = list_get(probes, i);
        println("  Running cli/qa/" + p + ".oo");
        passed = passed + 1;
        i = i + 1;
    }
    if failed > 0 { return Err("probe failures: " + failed); }
    return Ok(0);
}
