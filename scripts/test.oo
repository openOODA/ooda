// # Test Ooda CLI — Run Self-Tests Twice
//
// Logline: Run each qa probe twice under OODA_COMPILER. Fail closed on the first miss.
//
// Setup: Requires OODA_COMPILER. ProcessCap execs oodac run. Double-run law.

import "std/fs/process/cmd.oo";
import "build/find_compiler.oo";
import "build/host_run.oo";

fn run_probe_twice(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let r1: Result[String, String] = sys_exec(p, oodac, "run", path);
    if r1.is_err() {
        let e: String = match r1 { Ok(_) => "", Err(m) => m };
        return Err("probe fail run1 " + path + ": " + e);
    }
    let r2: Result[String, String] = sys_exec(p, oodac, "run", path);
    if r2.is_err() {
        let e: String = match r2 { Ok(_) => "", Err(m) => m };
        return Err("probe fail run2 " + path + ": " + e);
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let oodac: String = find_oodac(fs_r, env);
    refuse_cli(p, oodac);
    let probes: List[String] = list_new();
    let mut ps: List[String] = list_push(probes, "qa/probe_argv.oo");
    ps = list_push(ps, "qa/probe_spawn.oo");
    ps = list_push(ps, "qa/probe_api_surface.oo");
    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path);
        if r.is_err() { return r; }
        i = i + 1;
    }
    return Ok(0);
}
