// # Stage 14 Adversarial SMT Contract Prover Stress Harness
//
// Logline: Adversarially stresses compile-time SMT theorem prover with relational operators, multi-step WPs, and violating contracts.
//
// Setup: Validates fail-closed refutation, counterexample extraction, and SMT-LIB2 script generation across operators.
//
// Beats:
//   1. Stress-test all relational operators across valid and invalid theorems.
//   2. Derive multi-step sequential Dijkstra weakest preconditions.
//   3. Assert fail-closed rejection and counterexample generation for invalid contracts.
//   4. Verify SMT-LIB2 QF_LIA script synthesis and negation semantics.
// RULES.oot 1.7: Under 256 lines.

import "ooda/oodac/smt_contract_parse.oo";
import "ooda/oodac/smt_formula_gen.oo";
import "ooda/oodac/smt_wp_calc.oo";
import "ooda/oodac/smt_prover_lia.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("FAIL: " + msg);
        process_exit(1);
    }
}

fn test_valid_theorem(pre_op: String, pre_k: Int, add_k: Int, post_op: String, post_k: Int, desc: String) {
    let pre: String = smt_contract_parse_pack("requires", "x", 1, pre_op, pre_k, "", 0, "1", "1", false, 0);
    let post: String = smt_contract_parse_pack("ensures", "x", 1, post_op, post_k, "", 0, "2", "1", false, 0);
    let mut assigns: List[String] = list_new();
    assigns = list_push(assigns, smt_wp_calc_assign_pack("x", "x", 1, add_k));
    let res: String = smt_prover_lia_prove_vc(pre, assigns, post);
    let is_valid: Bool = smt_prover_lia_is_valid(res);
    assert_true(is_valid, "Expected valid theorem for " + desc + " got " + res);
}

fn test_invalid_theorem(pre_op: String, pre_k: Int, add_k: Int, post_op: String, post_k: Int, desc: String) {
    let pre: String = smt_contract_parse_pack("requires", "x", 1, pre_op, pre_k, "", 0, "1", "1", false, 0);
    let post: String = smt_contract_parse_pack("ensures", "x", 1, post_op, post_k, "", 0, "2", "1", false, 0);
    let mut assigns: List[String] = list_new();
    assigns = list_push(assigns, smt_wp_calc_assign_pack("x", "x", 1, add_k));
    let res: String = smt_prover_lia_prove_vc(pre, assigns, post);
    let is_valid: Bool = smt_prover_lia_is_valid(res);
    assert_true(!is_valid, "Expected invalid theorem (SAT) for " + desc + " but prover returned UNSAT");
    let cex: String = smt_prover_lia_counterexample(res);
    assert_true(chars_len(cex) > 0, "Expected non-empty counterexample for " + desc);
}

pub fn main() {
    println("=== Running Adversarial SMT Prover Challenge Suite ===");

    // Beat 1: Valid theorem proofs across all relational operators
    test_valid_theorem(">", 0, 5, ">", 5, "x > 0; x+=5 => x > 5");
    test_valid_theorem(">=", 10, -3, ">=", 7, "x >= 10; x-=3 => x >= 7");
    test_valid_theorem("<", 20, 10, "<", 30, "x < 20; x+=10 => x < 30");
    test_valid_theorem("<=", 5, -2, "<=", 3, "x <= 5; x-=2 => x <= 3");
    test_valid_theorem("==", 42, 8, "==", 50, "x == 42; x+=8 => x == 50");
    test_valid_theorem("!=", 0, 0, "!=", 0, "x != 0; x+=0 => x != 0");
    println("  [PASS] 1. Valid contract theorems verified across all relational operators");

    // Beat 2: Multi-step sequential WP derivation
    let pre_multi: String = smt_contract_parse_pack("requires", "x", 1, ">", 10, "", 0, "10", "1", false, 0);
    let post_multi: String = smt_contract_parse_pack("ensures", "z", 1, ">=", 20, "", 0, "13", "1", false, 0);
    let mut assigns_multi: List[String] = list_new();
    assigns_multi = list_push(assigns_multi, smt_wp_calc_assign_pack("y", "x", 1, 5));
    assigns_multi = list_push(assigns_multi, smt_wp_calc_assign_pack("z", "y", 1, 4));
    let derived_wp: String = smt_wp_calc_derive(pre_multi, assigns_multi, post_multi);
    assert_true(smt_contract_parse_lhs(derived_wp) == "x", "WP target variable mismatch");
    assert_true(smt_contract_parse_rhs_const(derived_wp) == 11, "WP constant calculation mismatch");
    let res_multi: String = smt_prover_lia_prove_clause(pre_multi, derived_wp);
    assert_true(smt_prover_lia_is_valid(res_multi), "Multi-step WP theorem failed to prove valid");
    println("  [PASS] 2. Multi-step Dijkstra weakest precondition derivation verified");

    // Beat 3: Adversarial invalid/violating contracts (fail-closed rejection)
    test_invalid_theorem(">", 0, 1, ">", 50, "x > 0; x+=1 => x > 50 (UNSOUND)");
    test_invalid_theorem(">=", 0, -5, ">=", 0, "x >= 0; x-=5 => x >= 0 (UNSOUND)");
    test_invalid_theorem("<", 10, 5, "<", 5, "x < 10; x+=5 => x < 5 (UNSOUND)");
    test_invalid_theorem("<=", 10, 10, "<=", 5, "x <= 10; x+=10 => x <= 5 (UNSOUND)");
    test_invalid_theorem("==", 10, 0, "==", 20, "x == 10; x+=0 => x == 20 (UNSOUND)");
    test_invalid_theorem("!=", 10, 0, "==", 5, "x != 10; x+=0 => x == 5 (UNSOUND)");
    println("  [PASS] 3. Fail-closed counterexample refutation on invalid contracts verified");

    // Beat 4: SMT-LIB2 script generator and constant false preconditions
    let pre_false: String = smt_contract_parse_pack("requires", "x", 1, "==", 0, "", 0, "1", "1", true, 0);
    let post_any: String = smt_contract_parse_pack("ensures", "x", 1, ">", 10, "", 0, "2", "1", false, 0);
    let res_false: String = smt_prover_lia_prove_clause(pre_false, post_any);
    assert_true(!smt_prover_lia_is_valid(res_false), "Constant false precondition should yield SAT rejection");

    let mut decls: List[String] = list_new();
    decls = list_push(decls, "a");
    decls = list_push(decls, "b");
    let mut asserts: List[String] = list_new();
    asserts = list_push(asserts, "(> a 0)");
    asserts = list_push(asserts, "(< b 10)");
    let smt_script: String = smt_formula_gen_build(decls, asserts, true);
    assert_true(chars_len(smt_script) > 50, "SMT-LIB2 benchmark generation failed");
    println("  [PASS] 4. SMT-LIB2 script generation and false precondition rejection verified");

    println("stage14_adversarial_smt: PASSED");
}
