// # Launch --exec smoke
//
// Logline: Ingest runme, prove path-only launch, then prove --exec prints LAUNCH_EXEC_OK.
//
// Setup: cwd is the worktree. bin/ooda must exist. OODA_FS_WRITEDIR is $PWD. Hang budget 10s on --exec.
//
// Beats:
//   1. Fail if bin/ooda is missing. Ingest fixtures/pm_launch_exec.
//   2. launch runme has no LAUNCH_EXEC_OK. timeout 10 launch --exec runme has it.
//   3. --exec nosuchpkg or --exec `..` is non-zero and has no LAUNCH_EXEC_OK.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn capture(p: &ProcessCap, cmd: String) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/pm_lex.txt";
    let sh: String = "mkdir -p .ooda-cache/ooda-tmp; export OODA_FS_WRITEDIR=\"$(pwd)\"; " + cmd + " > " + outp + " 2>&1; echo rc=$? >> " + outp;
    if process_exec(p, sh).is_err() {
        fail("exec " + cmd);
    }
    return outp;
}

fn want(p: &ProcessCap, cmd: String, needle: String) {
    let outp: String = capture(p, cmd);
    if process_exec(p, "grep -q '" + needle + "' " + outp).is_err() {
        fail("missing " + needle);
    }
}

fn want_no(p: &ProcessCap, needle: String) {
    let outp: String = ".ooda-cache/ooda-tmp/pm_lex.txt";
    if process_exec(p, "grep -q '" + needle + "' " + outp).is_ok() {
        fail("unexpected " + needle);
    }
}

fn want_bad(p: &ProcessCap, cmd: String, needle: String) {
    want(p, cmd, needle);
    let outp: String = ".ooda-cache/ooda-tmp/pm_lex.txt";
    if process_exec(p, "grep -q '^rc=0$' " + outp).is_ok() {
        fail("zero rc");
    }
    want_no(p, "LAUNCH_EXEC_OK");
    want_no(p, "ooda launch: ok");
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if !path_exists(fs, "bin/ooda") {
        fail("no bin/ooda");
    }
    want(p, "./bin/ooda ingest --from fixtures/pm_launch_exec", "ooda ingest: installed runme cas=");
    want(p, "./bin/ooda launch runme", "ooda launch: ok");
    want_no(p, "LAUNCH_EXEC_OK");
    want(p, "timeout 10 ./bin/ooda launch --exec runme", "LAUNCH_EXEC_OK");
    want_bad(p, "./bin/ooda launch --exec nosuchpkg", "not installed");
    want_bad(p, "./bin/ooda launch --exec ..", "refuse name");
    let c_res: Result[String, String] = process_exec(p, "rm -f .ooda_modules/cas/*/*.bin .ooda_modules/cas/*/*.tmp.c");
    match c_res {
        Ok(_) => {},
        Err(_) => {}
    }
    println("pm_launch_exec_smoke: PASSED");
}
