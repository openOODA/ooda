// # OODAC LLVM Build
//
// Logline: pure multi-module oodac build emits LLVM IR, links with clang + chs_rt once, returns native binary (no stage-0 host).
//
// Beats: env resolve | oodac check gate | per-module emit-llvm | main patch | clang link.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "oodac LLVM build pure multi-module");

    when "OODAC_BIN resolves" {
    and  "oodac check gate passes" {
    and  "per-module emit-llvm yields IR (no preamble on tail)" {
    and  "clang links chs_rt + all.ll into native binary" {
    then "oodac_llvm_build native binary OK" { } } } }

    expect_clean(p, "test -x " + oodac);
    check(p, oodac + " check oodac/main.oo > " + tmpd + "/ollb_check.out 2> " + tmpd + "/ollb_check.err", within: 90);
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-llvm oodac/main.oo > " + tmpd + "/all.ll 2> " + tmpd + "/all.err");
    expect_substring(fs, tmpd + "/all.ll", "@main(");
    let _ = process_exec(p, "test ! -z \"$(grep -c 'define' " + tmpd + "/all.ll)\"");
    expect_clean(p, "test -s " + tmpd + "/all.ll");
    check(p, "clang -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/all.ll -lm -o " + tmpd + "/all.bin", within: 60);
    expect_clean(p, "test -x " + tmpd + "/all.bin");
    println("oodac_llvm_build: OK_LLVM_MULTI");
}
