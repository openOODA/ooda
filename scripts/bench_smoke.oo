// # Product ooda bench smoke
//
// Logline: Run rebuilt ./bin/ooda bench and prove check milliseconds, refuses, and a check-fail --run refuse.
//
// Setup: ProcessCap. cwd is the worktree root. ./bin/ooda must exist. hello.oo and bootstrap/corpus/check/fail/no_cap_now_ms.oo are on disk. Hang budget is 30 seconds on hello.
//
// Beats:
//   1. Fail if ./bin/ooda is missing.
//   2. bench fixtures/hello.oo exits 0, stdout has check and ms, and never ooda bench: ok.
//   3. bench with no file exits nonzero and never prints ooda bench: ok.
//   4. bench missing_no_such.oo exits nonzero and never prints ooda bench: ok.
//   5. bench --run of a check-fail fixture exits nonzero and never prints a run line.
//   6. Print bench_smoke: PASSED.

import "std/os/process.oo";

fn must_ok(r: Result[String, String], tag: String) {
    if r.is_err() {
        println("FAIL " + tag);
        process_exit(1);
    }
}

fn must_err(r: Result[String, String], tag: String) {
    if r.is_ok() {
        println("FAIL " + tag);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap) {
    let ooda = "./bin/ooda";
    let hello = "fixtures/hello.oo";
    let work = ".ooda-cache/ooda-tmp/bench_smoke";

    // when the product binary is on disk
    must_ok(process_exec(p, "test -x " + ooda), "no bin/ooda");
    must_ok(process_exec(p, "mkdir -p " + work), "work dir");

    // and bench hello (hang budget 30s)
    must_ok(process_exec(p, "timeout 30 " + ooda + " bench " + hello + " > " + work + "/hello.out 2> " + work + "/hello.err"), "hello exit");
    must_ok(process_exec(p, "grep -q 'ooda bench: check ' " + work + "/hello.out"), "hello check");
    must_ok(process_exec(p, "grep -q ms " + work + "/hello.out"), "hello ms");
    must_ok(process_exec(p, "! grep -q 'ooda bench: ok' " + work + "/hello.out " + work + "/hello.err"), "hello no ok");

    // and bench with no file
    must_err(process_exec(p, ooda + " bench > " + work + "/none.out 2> " + work + "/none.err"), "no-file exit");
    must_ok(process_exec(p, "! grep -q 'ooda bench: ok' " + work + "/none.out " + work + "/none.err"), "no-file no ok");

    // then bench a missing file
    must_err(process_exec(p, ooda + " bench missing_no_such.oo > " + work + "/miss.out 2> " + work + "/miss.err"), "missing exit");
    must_ok(process_exec(p, "! grep -q 'ooda bench: ok' " + work + "/miss.out " + work + "/miss.err"), "missing no ok");

    // then bench --run of a known check-fail fixture
    let bad = "bootstrap/corpus/check/fail/no_cap_now_ms.oo";
    must_err(process_exec(p, ooda + " bench --run " + bad + " > " + work + "/fail.out 2> " + work + "/fail.err"), "fail-check exit");
    must_ok(process_exec(p, "grep -q 'ooda bench: check failed' " + work + "/fail.out"), "fail-check said failed");
    must_ok(process_exec(p, "! grep -q 'ooda bench: run ' " + work + "/fail.out " + work + "/fail.err"), "fail-check no run");
    must_ok(process_exec(p, "! grep -q 'ooda bench: ok' " + work + "/fail.out " + work + "/fail.err"), "fail-check no ok");

    println("bench_smoke: PASSED");
}
