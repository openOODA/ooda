// # Fuzz Multi-Arg Smoke
//
// Logline: M49 multi-arg fuzz — Int arity-2/3 pass and fail-closed; arity≥4 pass; weak non-Int multi-arg fail-closed; Bool/String/List multi-arg rails.
// Setup: pure bin/ooda prebuilt; fixtures/fuzz_int_multi* / fuzz_*_multi*.oo.
//
// Beats: arity-2 Int pass/fail | arity-3 Int pass/fail | arity≥4 pass | weak non-Int fail-closed | Bool/String/List multi-arg rails | single-arg regression.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M49 multi-arg fuzz rails");

    expect_quiet(p, "test -x " + ooda);

    // when "Int arity-2 / arity-3 pass and fail rails" {
    // and  "arity≥4 pass and weak non-Int fail-closed" {
    // and  "Bool / String / List multi-arg rails + single-arg regression" {
    // then "fuzz multi-arg floor green" {

    check(p, "timeout 60 " + ooda + " test " + root + "/" + "fixtures/fuzz_int_multi_add.oo" + " --fuzz 20 > " + tmpd + "/a2p.out 2> " + tmpd + "/a2p.err", within: 90);
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/" + "fixtures/fuzz_int_multi_fail.oo" + " --fuzz 20 > " + tmpd + "/a2f.out 2> " + tmpd + "/a2f.err");
    check(p, "timeout 60 " + ooda + " test " + root + "/" + "fixtures/fuzz_int_multi3_add.oo" + " --fuzz 20 > " + tmpd + "/a3p.out 2> " + tmpd + "/a3p.err", within: 90);
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/" + "fixtures/fuzz_int_multi3_fail.oo" + " --fuzz 20 > " + tmpd + "/a3f.out 2> " + tmpd + "/a3f.err");
    check(p, "timeout 30 " + ooda + " test " + root + "/fixtures/fuzz_int_multi_arity4.oo --fuzz 5 > " + tmpd + "/a4.out 2> " + tmpd + "/a4.err", within: 60);

    check(p, "timeout 30 " + ooda + " test " + root + "/fixtures/fuzz_int_multi_weak.oo --fuzz 5 > " + tmpd + "/wk.out 2> " + tmpd + "/wk.err", within: 60);
    expect_clean(p, "grep -qiE 'all Int params|multi-arg|fail-closed' " + tmpd + "/wk.out " + tmpd + "/wk.err");

    check(p, "timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_bool_multi_and.oo --fuzz 20 > " + tmpd + "/bp.out 2> " + tmpd + "/bp.err", within: 90);
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_bool_multi_fail.oo --fuzz 20 > " + tmpd + "/bf.out 2> " + tmpd + "/bf.err");
    check(p, "timeout 30 " + ooda + " test " + root + "/fixtures/fuzz_bool_multi_weak.oo --fuzz 5 > " + tmpd + "/bw.out 2> " + tmpd + "/bw.err", within: 60);

    check(p, "timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_string_multi_id.oo --fuzz 20 > " + tmpd + "/sp.out 2> " + tmpd + "/sp.err", within: 90);
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_string_multi_fail.oo --fuzz 20 > " + tmpd + "/sf.out 2> " + tmpd + "/sf.err");
    check(p, "timeout 30 " + ooda + " test " + root + "/fixtures/fuzz_string_multi_weak.oo --fuzz 5 > " + tmpd + "/sw.out 2> " + tmpd + "/sw.err", within: 60);

    check(p, "timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_list_multi_id.oo --fuzz 20 > " + tmpd + "/lp.out 2> " + tmpd + "/lp.err", within: 90);
    expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_list_multi_fail.oo --fuzz 20 > " + tmpd + "/lf.out 2> " + tmpd + "/lf.err");
    check(p, "timeout 30 " + ooda + " test " + root + "/fixtures/fuzz_list_multi_weak.oo --fuzz 5 > " + tmpd + "/lw.out 2> " + tmpd + "/lw.err", within: 60);

    check(p, "timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_int_add.oo --fuzz 10 > " + tmpd + "/sng.out 2> " + tmpd + "/sng.err", within: 90);
    println("fuzz_multi_arg_smoke: PASSED");
}