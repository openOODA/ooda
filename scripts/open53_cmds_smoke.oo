// # LLVM-linked oodac usage command surface
//
// Logline: A side LLVM-linked oodac runs each usage command on fixtures/hello.oo and emit-x86 on fixtures/open69_hello.oo.
//
// Setup: cwd is ooda/. Proof ELF is .ooda-cache/ooda-tmp/oodac_llvm, or oodac_stamp if that file is the LLVM ELF.
//
// Beats:
//   1. Pick the LLVM ELF. Require oodac: usage:. Refuse a pure .oo product CLI.
//   2. Drive tokens, ast, check, build, run, emit-c, emit-wasm, emit-llvm, outline, and reflect on hello.
//   3. Drive emit-x86 on open69_hello. Print PASSED.
// residual: C emit plus gcc remains the product path.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let d = tmpd + "/open53_cmds";
    let mut elf = tmpd + "/oodac_llvm";
    if process_exec(p, "test -x " + elf).is_err() {
        elf = tmpd + "/oodac_stamp";
    }
    if process_exec(p, "test -x " + elf).is_err() {
        fail("no LLVM ELF oodac_llvm or oodac_stamp");
    }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if !path_exists(fs, "fixtures/open69_hello.oo") { fail("no open69_hello"); }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' " + elf).is_ok() {
        fail("ELF is pure .oo product CLI");
    }
    if process_exec(p, "grep -a -q 'oodac: usage:' " + elf).is_err() {
        fail("ELF missing oodac: usage:");
    }
    if process_exec(p, "mkdir -p " + d).is_err() { fail("mkdir"); }

    let env = "OODAC_BIN=" + elf + " OODA_COMPILER=" + elf + " ";
    let hello = "fixtures/hello.oo";
    let text = "for c in tokens ast check outline reflect; do "
        + "timeout 60 " + elf + " $c " + hello + " > " + d + "/$c.out 2>" + d + "/$c.err || exit 1; "
        + "if grep -qE '^ERR' " + d + "/$c.out " + d + "/$c.err 2>/dev/null; then exit 1; fi; "
        + "done";
    if process_exec(p, text).is_err() { fail("text cmds"); }
    if process_exec(p, "grep -q KW_PUB " + d + "/tokens.out").is_err() { fail("tokens"); }
    if process_exec(p, "grep -q PROGRAM " + d + "/ast.out").is_err() { fail("ast"); }
    if process_exec(p, "grep -qE '^OK' " + d + "/check.out").is_err() { fail("check"); }
    if process_exec(p, "grep -q greet " + d + "/outline.out").is_err() { fail("outline"); }
    if process_exec(p, "grep -q greet " + d + "/reflect.out").is_err() { fail("reflect"); }

    let bin = d + "/hello.bin";
    if process_exec(p, env + "timeout 90 " + elf + " build " + hello + " " + bin + " > " + d + "/build.out 2>" + d + "/build.err").is_err() {
        fail("build");
    }
    if process_exec(p, "test -x " + bin).is_err() { fail("build bin"); }
    if process_exec(p, env + "timeout 90 " + elf + " run " + hello + " " + d + "/hello_run.bin > " + d + "/run.out 2>" + d + "/run.err").is_err() {
        fail("run");
    }
    if process_exec(p, "grep -q Hello " + d + "/run.out").is_err() { fail("run Hello"); }

    if process_exec(p, "timeout 60 " + elf + " emit-c " + hello + " > " + d + "/hello.c 2>" + d + "/emitc.err").is_err() {
        fail("emit-c");
    }
    if process_exec(p, "grep -qE '^ERR' " + d + "/hello.c " + d + "/emitc.err").is_ok() { fail("emit-c ERR"); }
    if process_exec(p, "grep -qE 'int main|OoStr|chs_rt' " + d + "/hello.c").is_err() { fail("emit-c body"); }

    if process_exec(p, "timeout 60 " + elf + " emit-llvm " + hello + " > " + d + "/hello.ll 2>" + d + "/emitll.err").is_err() {
        fail("emit-llvm");
    }
    if process_exec(p, "grep -qE '^ERR' " + d + "/hello.ll " + d + "/emitll.err").is_ok() { fail("emit-llvm ERR"); }
    if process_exec(p, "grep -qE 'define |@greet|@main' " + d + "/hello.ll").is_err() { fail("emit-llvm body"); }

    if process_exec(p, "timeout 60 " + elf + " emit-wasm " + hello + " > " + d + "/hello.wasm 2>" + d + "/emitw.err").is_err() {
        fail("emit-wasm");
    }
    if process_exec(p, "od -An -tx1 -N4 " + d + "/hello.wasm | grep -q '00 61 73 6d'").is_err() {
        fail("emit-wasm magic");
    }

    let xs = "fixtures/open69_hello.oo";
    if process_exec(p, "timeout 60 " + elf + " emit-x86 " + xs + " > " + d + "/hello.s 2>" + d + "/emitx.err").is_err() {
        fail("emit-x86");
    }
    if process_exec(p, "grep -qE '^ERR' " + d + "/hello.s " + d + "/emitx.err").is_ok() { fail("emit-x86 ERR"); }
    if process_exec(p, "grep -q _start " + d + "/hello.s").is_err() { fail("emit-x86 _start"); }
    if process_exec(p, "grep -q Hello " + d + "/hello.s").is_err() { fail("emit-x86 Hello"); }

    println("open53_cmds_smoke: PASSED");
}
