// # Time And Rand Sleep At Runtime
// Logline: sleep_ms under TimeCap + seed under RandCap emit, link, and print OK markers.
// Setup: oodac/oodac built; chs_rt.c linkable.
// Beats: 1. emit sleep lowers oo_sleep_ms | 2. emit seed lowers oo_seed | 3. both binaries print OK

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "time and rand runtime");

    // when — sleep_ms under TimeCap
    let sleep_oo  = tmpd + "/tr_sleep.oo";
    let sleep_c   = tmpd + "/tr_sleep.c";
    let sleep_bin = tmpd + "/tr_sleep.bin";
    let sleep_out = tmpd + "/tr_sleep.out";
    let _         = process_exec(p, "printf 'pub fn main(time: &TimeCap) {\\n    sleep_ms(time, 1);\\n    println(\"sleep-ok\");\\n}\\n' > " + sleep_oo);
    let _         = process_exec(p, oodac + " emit-c " + sleep_oo + " > " + sleep_c + " 2>" + tmpd + "/tr_sleep.err");
    let _         = expect_quiet(p, "grep -q oo_sleep_ms " + sleep_c);
    let _         = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + sleep_c + " -o " + sleep_bin + " -lm 2>" + tmpd + "/tr_sleep.gcc");
    let _         = process_exec(p, sleep_bin + " > " + sleep_out + " 2>&1 || true");
    let _         = expect_quiet(p, "grep -q sleep-ok " + sleep_out);

    // and — seed under RandCap
    let seed_oo  = tmpd + "/tr_seed.oo";
    let seed_c   = tmpd + "/tr_seed.c";
    let seed_bin = tmpd + "/tr_seed.bin";
    let seed_out = tmpd + "/tr_seed.out";
    let _        = process_exec(p, "printf 'pub fn main(rand: &RandCap) {\\n    seed(rand, 42);\\n    println(\"seed-ok\");\\n}\\n' > " + seed_oo);
    let _        = process_exec(p, oodac + " emit-c " + seed_oo + " > " + seed_c + " 2>" + tmpd + "/tr_seed.err");
    let _        = expect_quiet(p, "grep -q oo_seed " + seed_c);
    let _        = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + seed_c + " -o " + seed_bin + " -lm 2>" + tmpd + "/tr_seed.gcc");
    let _        = process_exec(p, seed_bin + " > " + seed_out + " 2>&1 || true");
    let _        = expect_quiet(p, "grep -q seed-ok " + seed_out);

    println("time_rand_runtime_smoke: PASSED");
}
