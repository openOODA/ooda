// ===================================================================
// Time & Rand Runtime Smoke Test
// ===================================================================
// Runtime sleep_ms + seed (grant inject names: time / rand; link chs_rt.c only)

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let oodac = get_oodac(p, root);
    let tmp = get_env(p, "TMPDIR", ".ooda-cache/ooda-tmp");
    
    if str_len(oodac) == 0 {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    
    let mkdir_res = cmd_exec(p, "mkdir -p " + tmp);
    if !mkdir_res.is_ok() {
        println("Cannot create tmp dir");
        process_exit(1);
    }
    
    let rt = "-O0 -I\"" + root + "/runtime\" \"" + root + "/runtime/chs_rt.c\"";
    
    // Test sleep_ms under TimeCap
    let sleep_oo = tmp + "/tr_sleep.oo";
    let sleep_c = tmp + "/tr_sleep.c";
    let sleep_err = tmp + "/tr_sleep.err";
    let sleep_bin = tmp + "/tr_sleep.bin";
    let sleep_gcc = tmp + "/tr_sleep.gcc";
    
    let write_sleep = cmd_exec(p, "cat >\"" + sleep_oo + "\" <<'OO'\npub fn main(time: &TimeCap) {\n    sleep_ms(time, 1);\n    println(\"sleep-ok\");\n}\nOO");
    if !write_sleep.is_ok() {
        println("Cannot write sleep test");
        process_exit(1);
    }
    
    let emit_sleep = cmd_exec(p, oodac + " emit-c " + sleep_oo + " >" + sleep_c + " 2>" + sleep_err);
    tr = test_assert(tr, "emit sleep", emit_sleep.is_ok());
    
    if emit_sleep.is_ok() {
        let check_sleep_fn = cmd_exec(p, "grep -q oo_sleep_ms " + sleep_c);
        tr = test_assert(tr, "sleep.c contains oo_sleep_ms", check_sleep_fn.is_ok());
        
        let gcc_sleep = cmd_exec(p, "gcc " + rt + " " + sleep_c + " -o " + sleep_bin + " -lm 2>" + sleep_gcc);
        tr = test_assert(tr, "gcc compile sleep", gcc_sleep.is_ok());
        
        if gcc_sleep.is_ok() {
            let run_sleep = cmd_exec(p, sleep_bin + " 2>&1");
            if run_sleep.is_ok() {
                let output = run_sleep.unwrap();
                let check_out = str_contains(output, "sleep-ok");
                tr = test_assert(tr, "runtime sleep_ms under TimeCap", check_out);
            } else {
                tr = test_assert(tr, "sleep binary runs", false);
            }
        } else {
            let _ = cmd_exec(p, "cat " + sleep_gcc);
        }
    }
    
    // Test seed under RandCap
    let seed_oo = tmp + "/tr_seed.oo";
    let seed_c = tmp + "/tr_seed.c";
    let seed_err = tmp + "/tr_seed.err";
    let seed_bin = tmp + "/tr_seed.bin";
    let seed_gcc = tmp + "/tr_seed.gcc";
    
    let write_seed = cmd_exec(p, "cat >\"" + seed_oo + "\" <<'OO'\npub fn main(rand: &RandCap) {\n    seed(rand, 42);\n    println(\"seed-ok\");\n}\nOO");
    if !write_seed.is_ok() {
        println("Cannot write seed test");
        process_exit(1);
    }
    
    let emit_seed = cmd_exec(p, oodac + " emit-c " + seed_oo + " >" + seed_c + " 2>" + seed_err);
    tr = test_assert(tr, "emit seed", emit_seed.is_ok());
    
    if emit_seed.is_ok() {
        let check_seed_fn = cmd_exec(p, "grep -q oo_seed " + seed_c);
        tr = test_assert(tr, "seed.c contains oo_seed", check_seed_fn.is_ok());
        
        let gcc_seed = cmd_exec(p, "gcc " + rt + " " + seed_c + " -o " + seed_bin + " -lm 2>" + seed_gcc);
        tr = test_assert(tr, "gcc compile seed", gcc_seed.is_ok());
        
        if gcc_seed.is_ok() {
            let run_seed = cmd_exec(p, seed_bin + " 2>&1");
            if run_seed.is_ok() {
                let output = run_seed.unwrap();
                let check_out = str_contains(output, "seed-ok");
                tr = test_assert(tr, "runtime seed under RandCap", check_out);
            } else {
                tr = test_assert(tr, "seed binary runs", false);
            }
        } else {
            let _ = cmd_exec(p, "cat " + seed_gcc);
        }
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("OK time_rand_runtime_smoke");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_oodac(p: &ProcessCap, root: String) -> String {
    let env_val = get_env(p, "OODAC_BIN", "");
    if str_len(env_val) > 0 {
        return env_val;
    }
    return root + "/oodac/oodac";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
