// # Wasm n-strcat-literal WASI lock
//
// Logline: emit-wasm of wasm_strcat3_lit.oo is a \0asm module whose main prints Hello, n-join!.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional; WASI names are required if it is missing.
//
// Beats:
//   1. emit-wasm fixtures/wasm_strcat3_lit.oo to a tmp wasm.
//   2. First eight bytes are 00 61 73 6d 01 00 00 00 and the file is not WAT.
//   3. If wasmtime exists, run the module and require stdout to contain Hello, n-join!.
//   4. If wasmtime is missing, require fd_write and Hello, n-join! in the bytes.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() {
        println("FAIL mkdir");
        process_exit(1);
    }
    if scenario(p, fs, "wasm strcat n").is_err() { println("FAIL scenario"); process_exit(1); }
    let src = "fixtures/wasm_strcat3_lit.oo";
    let wasm = tmpd + "/wasm_strcat3_lit.wasm";
    let out = tmpd + "/wasm_strcat3_lit.out";
    if expect_present(fs, src).is_err() { println("FAIL no fixture"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }
    if process_exec(p, oodac + " emit-wasm " + src + " > " + wasm + " 2>" + tmpd + "/wasm_strcat3_lit.err").is_err() {
        println("FAIL emit-wasm");
        process_exit(1);
    }
    if expect_present(fs, wasm).is_err() { println("FAIL no wasm"); process_exit(1); }
    if check(p, "test -s " + wasm, 5).is_err() { println("FAIL empty"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() {
        println("FAIL still wat");
        process_exit(1);
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() {
            println("FAIL wasmtime");
            process_exit(1);
        }
        if expect_quiet(p, "grep -q 'Hello, n-join!' " + out).is_err() {
            println("FAIL no print");
            process_exit(1);
        }
    } else {
        if expect_quiet(p, "grep -a -q fd_write " + wasm).is_err() {
            println("FAIL no fd_write");
            process_exit(1);
        }
        if expect_quiet(p, "grep -a -q 'Hello, n-join!' " + wasm).is_err() {
            println("FAIL no n-join bytes");
            process_exit(1);
        }
    }
    println("wasm_strcat_n_smoke: PASSED");
}
