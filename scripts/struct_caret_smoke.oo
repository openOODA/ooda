// # Struct no-field type error prints path and caret
//
// Logline: Cache-cold check of p.nope shows ERR type, path, the field, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_struct_nofield.oo prints has no field, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/struct_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_struct_nofield.oo > " + tmpd +
        "/s.out; echo $? > " + tmpd + "/s.ec; true").is_err() {
        fail("check nofield");
    }
    if process_exec(p, "grep -q 'has no field' " + tmpd +
        "/s.out && grep -q 'tc_struct_nofield.oo' " + tmpd +
        "/s.out && grep -Fq -- '-->' " + tmpd + "/s.out && grep -q '\\^' " +
        tmpd + "/s.out && ! grep -qE '^OK' " + tmpd +
        "/s.out && test \"$(cat " + tmpd + "/s.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("struct_caret_smoke: PASSED");
}
