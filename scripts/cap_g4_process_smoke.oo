// # Cap G4 Process Prefers ProcessCap For Exec
// Logline: sealed_sys_kind_of maps sys_exec→ProcessCap; ProcessCap ↛ sys_prctl; SysCap supersedes sys_prctl.
// Setup: oodac/oodac built; corpus fixtures + scripts/ci_product.sh on disk.
// Beats: 1. static CAP-G4 markers | 2. deny ProcessCap+sys_prctl / allow ProcessCap+sys_exec | 3. corpus + ci wire

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "cap g4 process preferred");

    // when — static CAP-G4 markers
    let _ = expect_quiet(p, "grep -q 'sealed_sys_kind_of' " + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'return \"ProcessCap\"' " + root + "/oodac/check_cap_util.oo");
    let _ = expect_quiet(p, "grep -q 'oo_cap_require_process' " + root + "/runtime/chs_rt_sys.c");

    // and — deny ProcessCap+sys_prctl; allow ProcessCap+sys_exec, SysCap+sys_exec, SysCap+sys_prctl
    let mut di: Int = 0;
    while di < 1 {
        let _ = process_exec(p, "printf 'fn main(p: &ProcessCap) { let _ = sys_prctl(p, 0); }\\n' > " + tmpd + "/process_prctl.oo && " + oodac + " check " + tmpd + "/process_prctl.oo > " + tmpd + "/process_prctl.out 2> " + tmpd + "/process_prctl.err");
        let _ = check(p, "grep -qiE 'ERR|Capability|cap' " + tmpd + "/process_prctl.out " + tmpd + "/process_prctl.err 2>/dev/null", 10);
        di = di + 1;
    }
    let mut ai: Int = 0;
    let allows = ["fn main(p: &ProcessCap) { let _ = sys_exec(p, \"true\"); }", "fn main(sys: &SysCap) { let _ = sys_exec(sys, \"true\"); }", "fn main(sys: &SysCap) { let _ = sys_prctl(sys, 0); }"];
    let al_lab = ["process_exec", "sys_exec", "sys_prctl"];
    while ai < 3 {
        let _ = process_exec(p, "printf '%s\\n' '" + allows[ai] + "' > " + tmpd + "/" + al_lab[ai] + ".oo && " + oodac + " check " + tmpd + "/" + al_lab[ai] + ".oo > " + tmpd + "/" + al_lab[ai] + ".out 2> " + tmpd + "/" + al_lab[ai] + ".err");
        let _ = check(p, "! grep -qiE 'Capability Violation|requires a &' " + tmpd + "/" + al_lab[ai] + ".out " + tmpd + "/" + al_lab[ai] + ".err 2>/dev/null && grep -qE '^OK' " + tmpd + "/" + al_lab[ai] + ".out", 10);
        ai = ai + 1;
    }

    // then — corpus pass/fail
    let mut pi: Int = 0;
    let passes = ["ok_process_cap_sys_exec.oo", "ok_sys_cap_sys_exec.oo"];
    while pi < 2 {
        let f = root + "/bootstrap/corpus/check/pass/" + passes[pi];
        let _ = process_exec(p, oodac + " check " + f + " > " + tmpd + "/" + passes[pi] + ".out 2> " + tmpd + "/" + passes[pi] + ".err");
        let _ = check(p, "grep -qE '^OK' " + tmpd + "/" + passes[pi] + ".out", 10);
        pi = pi + 1;
    }
    let _ = process_exec(p, oodac + " check " + root + "/bootstrap/corpus/check/fail/wrong_granular_process_for_prctl.oo > " + tmpd + "/wrong_granular_process_for_prctl.out 2> " + tmpd + "/wrong_granular_process_for_prctl.err");
    let _ = check(p, "grep -qiE 'ERR|Capability|cap' " + tmpd + "/wrong_granular_process_for_prctl.out " + tmpd + "/wrong_granular_process_for_prctl.err 2>/dev/null", 10);

    // soft — ci_product wire
    let _ = expect_quiet(p, "grep -q 'cap_g4_process_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true");

    println("cap_g4_process_smoke: PASSED");
}
