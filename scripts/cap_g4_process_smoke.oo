// # Cap G4 Process Prefers ProcessCap For Exec
// Logline: sealed_sys_kind_of maps sys_exec→ProcessCap; ProcessCap ↛ sys_prctl; SysCap supersedes sys_prctl.
// Setup: oodac/oodac built; corpus fixtures + scripts/ci_product.sh on disk.
// Beats: 1. static CAP-G4 markers | 2. deny ProcessCap+sys_prctl / allow ProcessCap+sys_exec | 3. corpus + ci wire

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — static CAP-G4 markers
    fails = fails + tally(expect_quiet(p, "grep -q 'sealed_sys_kind_of' " + root + "/oodac/check_cap_util.oo"), "sealed_sys_kind_of");
    fails = fails + tally(expect_quiet(p, "grep -q 'return \"ProcessCap\"' " + root + "/oodac/check_cap_util.oo"), "sys_exec ProcessCap preferred");
    fails = fails + tally(expect_quiet(p, "grep -q 'oo_cap_require_process' " + root + "/runtime/chs_rt_sys.c"), "runtime require_process");

    // and — deny ProcessCap+sys_prctl; allow ProcessCap+sys_exec, SysCap+sys_exec, SysCap+sys_prctl
    let mut i: Int = 0;
    let denies = ["fn main(p: &ProcessCap) { let _ = sys_prctl(p, 0); }"];
    let allows = ["fn main(p: &ProcessCap) { let _ = sys_exec(p, \"true\"); }", "fn main(sys: &SysCap) { let _ = sys_exec(sys, \"true\"); }", "fn main(sys: &SysCap) { let _ = sys_prctl(sys, 0); }"];
    let dn_lab = ["process_prctl"];
    let al_lab = ["process_exec", "sys_exec", "sys_prctl"];

    let mut di: Int = 0;
    while di < 1 {
        let _w = process_exec(p, "printf '%s\\n' '" + denies[di] + "' > " + tmpd + "/" + dn_lab[di] + ".oo && " + oodac + " check " + tmpd + "/" + dn_lab[di] + ".oo > " + tmpd + "/" + dn_lab[di] + ".out 2> " + tmpd + "/" + dn_lab[di] + ".err");
        fails  = fails + tally(check(p, "grep -qiE 'ERR|Capability|cap' " + tmpd + "/" + dn_lab[di] + ".out " + tmpd + "/" + dn_lab[di] + ".err 2>/dev/null", 10), "deny " + dn_lab[di]);
        di = di + 1;
    }
    let mut ai: Int = 0;
    while ai < 3 {
        let _w = process_exec(p, "printf '%s\\n' '" + allows[ai] + "' > " + tmpd + "/" + al_lab[ai] + ".oo && " + oodac + " check " + tmpd + "/" + al_lab[ai] + ".oo > " + tmpd + "/" + al_lab[ai] + ".out 2> " + tmpd + "/" + al_lab[ai] + ".err");
        fails  = fails + tally(check(p, "! grep -qiE 'Capability Violation|requires a &' " + tmpd + "/" + al_lab[ai] + ".out " + tmpd + "/" + al_lab[ai] + ".err 2>/dev/null && grep -qE '^OK' " + tmpd + "/" + al_lab[ai] + ".out", 10), "allow " + al_lab[ai]);
        ai = ai + 1;
    }

    // then — corpus pass/fail
    let mut pi: Int = 0;
    let passes = ["ok_process_cap_sys_exec.oo", "ok_sys_cap_sys_exec.oo"];
    while pi < 2 {
        let f = root + "/bootstrap/corpus/check/pass/" + passes[pi];
        let _w = process_exec(p, oodac + " check " + f + " > " + tmpd + "/" + passes[pi] + ".out 2> " + tmpd + "/" + passes[pi] + ".err");
        fails  = fails + tally(check(p, "grep -qE '^OK' " + tmpd + "/" + passes[pi] + ".out", 10), "corpus " + passes[pi]);
        pi = pi + 1;
    }
    let mut fi: Int = 0;
    let fails_arr = ["wrong_granular_process_for_prctl.oo"];
    while fi < 1 {
        let f = root + "/bootstrap/corpus/check/fail/" + fails_arr[fi];
        let _w = process_exec(p, oodac + " check " + f + " > " + tmpd + "/" + fails_arr[fi] + ".out 2> " + tmpd + "/" + fails_arr[fi] + ".err");
        fails  = fails + tally(check(p, "grep -qiE 'ERR|Capability|cap' " + tmpd + "/" + fails_arr[fi] + ".out " + tmpd + "/" + fails_arr[fi] + ".err 2>/dev/null", 10), "corpus deny " + fails_arr[fi]);
        fi = fi + 1;
    }

    // soft — ci_product wire
    fails = fails + tally(expect_quiet(p, "grep -q 'cap_g4_process_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true"), "ci_product wire (soft)");

    if fails > 0 { println("cap_g4_process_smoke: FAILED"); process_exit(1); }
    println("cap_g4_process_smoke: PASSED");
}
