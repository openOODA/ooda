// # emit-wasm if-false no-else skip lock
//
// Logline: Product emit-wasm of wasm_iffalse_noelse.oo has fd_write and does not print skip-me.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_iffalse_noelse.oo and require \0asm magic.
//   2. The file is not WAT and names fd_write.
//   3. skip-me is absent from stdout. Dummy empty without fd_write fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm if false noelse").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_iffalse_noelse.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_iffalse_noelse.wasm";
    let out = tmpd + "/wasm_iffalse_noelse.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_iffalse_noelse.oo > " + wasm + " 2>" + tmpd + "/wasm_iffalse_noelse.err").is_err() {
        fail("emit-wasm");
    }
    if expect_present(fs, wasm).is_err() { fail("no wasm"); }
    if check(p, "test -s " + wasm, 5).is_err() { fail("empty"); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        fail("magic");
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() { fail("still wat"); }
    if expect_quiet(p, "grep -a -q fd_write " + wasm).is_err() { fail("dummy empty"); }
    if expect_quiet(p, "grep -a -q skip-me " + wasm).is_ok() { fail("skip-me bytes"); }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q skip-me " + out).is_ok() { fail("skip-me"); }
    }
    println("wasm_iffalse_noelse_smoke: PASSED");
}
