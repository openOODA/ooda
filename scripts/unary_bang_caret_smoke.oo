// # Unary bang type error prints path and caret
//
// Logline: Cache-cold check of !1 shows ERR type, path, the bang, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_unary_bang.oo prints unary '!' requires Bool, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/unary_bang_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_unary_bang.oo > " + tmpd +
        "/u.out; echo $? > " + tmpd + "/u.ec; true").is_err() {
        fail("check bang");
    }
    if process_exec(p, "grep -q \"unary '!' requires Bool\" " + tmpd +
        "/u.out && grep -q 'tc_unary_bang.oo' " + tmpd +
        "/u.out && grep -Fq -- '-->' " + tmpd + "/u.out && grep -q '\\^' " +
        tmpd + "/u.out && ! grep -qE '^OK' " + tmpd +
        "/u.out && test \"$(cat " + tmpd + "/u.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("unary_bang_caret_smoke: PASSED");
}
