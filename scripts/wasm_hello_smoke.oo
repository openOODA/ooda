// # emit-wasm hello.oo greet lock
//
// Logline: Product emit-wasm of fixtures/hello.oo is a \0asm module that prints the greet line.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/hello.oo and require magic 00 61 73 6d 01 00 00 00.
//   2. The file is not WAT.
//   3. wasmtime prints Hello, openOODA Developer! or the bytes name fd_write and the greet text.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm hello greet fold").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/hello.oo").is_err() { fail("no hello"); }
    let wasm = tmpd + "/wasm_hello.wasm";
    let out = tmpd + "/wasm_hello.out";
    if process_exec(p, oodac + " emit-wasm fixtures/hello.oo > " + wasm + " 2>" + tmpd + "/wasm_hello.err").is_err() {
        fail("emit-wasm");
    }
    if expect_present(fs, wasm).is_err() { fail("no wasm"); }
    if check(p, "test -s " + wasm, 5).is_err() { fail("empty"); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        fail("magic");
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() { fail("still wat"); }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q 'Hello, openOODA Developer!' " + out).is_err() { fail("no greet print"); }
    } else if sh_which(p, "wasmtime").is_ok() {
        if check(p, "wasmtime " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q 'Hello, openOODA Developer!' " + out).is_err() { fail("no greet print"); }
    } else {
        if expect_quiet(p, "grep -a -q fd_write " + wasm).is_err() { fail("no fd_write"); }
        if expect_quiet(p, "grep -a -q 'Hello, openOODA Developer!' " + wasm).is_err() { fail("no greet bytes"); }
    }
    println("wasm_hello_smoke: PASSED");
}
