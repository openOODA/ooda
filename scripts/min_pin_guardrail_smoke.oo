// # Smoke Test for Toolchain min_pin Guardrails
//
// Logline: Verify toolchain SemVer min_pin validation and fail-closed compatibility guardrails.
//
// Setup: Pure OODA unit assertions for pm_pin_min_ok and pkg_parse_min_pin.
//
// Beats:
//   1. Verify exact toolchain pin match succeeds.
//   2. Verify older package min_pin on current toolchain succeeds.
//   3. Verify future incompatible toolchain min_pin fails closed.
//   4. Verify manifest parser correctly extracts min_pin key.

import "cli/pm_pin.oo";
import "cli/pkg_parse.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main() {
    let cur_ver: String = "0.206.0";

    // 1. Exact match with v prefix and without v prefix
    if !pm_pin_min_ok("v0.206.0", cur_ver) {
        fail_smoke("v0.206.0 should be accepted on 0.206.0");
    }
    if !pm_pin_min_ok("0.206.0", cur_ver) {
        fail_smoke("0.206.0 should be accepted on 0.206.0");
    }

    // 2. Older min_pin
    if !pm_pin_min_ok("v0.205.0", cur_ver) {
        fail_smoke("v0.205.0 should be accepted on 0.206.0");
    }
    if !pm_pin_min_ok("0.1.0", cur_ver) {
        fail_smoke("0.1.0 should be accepted on 0.206.0");
    }

    // 3. Incompatible future min_pin (must fail closed)
    if pm_pin_min_ok("v0.207.0", cur_ver) {
        fail_smoke("v0.207.0 must be rejected on 0.206.0");
    }
    if pm_pin_min_ok("v1.0.0", cur_ver) {
        fail_smoke("v1.0.0 must be rejected on 0.206.0");
    }

    // 4. Empty min_pin is accepted for backwards compatibility
    if !pm_pin_min_ok("", cur_ver) {
        fail_smoke("empty min_pin should be accepted");
    }

    // 5. Manifest parsing
    let sample_manifest: String = "name=sample\nversion=1.0.0\nmin_pin=v0.206.0\ncaps=FsRead\n";
    let extracted_pin: String = pkg_parse_min_pin(sample_manifest);
    if extracted_pin != "v0.206.0" {
        fail_smoke("pkg_parse_min_pin failed to extract min_pin from manifest text");
    }

    println("OK: MIN_PIN_GUARDRAIL_SMOKE_PASSED");
}
