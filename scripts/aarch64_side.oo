// # Rebuild the isolated emit-aarch64 side ELF
//
// Logline: Builds oodac/oodac.aarch64 from aarch64_main.oo when the ELF is missing or older than sources.
//
// Setup: cwd is ooda/. Product oodac/oodac is the host only. Does not overwrite oodac/oodac.
//
// Beats:
//   1. Refuse a product CLI used as the host.
//   2. Rebuild the side ELF when it is missing or any aarch64_*.oo is newer.
//   3. Require emit-aarch64 usage strings and delete the gcc temp.

import "std/scenario.oo";
import "std/sh.oo";

fn a64_side_fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn ensure_aarch64_side(p: &ProcessCap, root: String, prod: String, side: String) {
    if expect_quiet(p, "test -x " + prod).is_err() {
        a64_side_fail("no tree oodac");
    }
    if expect_quiet(p, "grep -a -q 'pure .oo product CLI' " + prod).is_ok() {
        a64_side_fail("host oodac is the product CLI");
    }
    let e = root + "/oodac/aarch64_emit.oo";
    let es = root + "/oodac/aarch64_emit_sys.oo";
    let m = root + "/oodac/aarch64_main.oo";
    let mut stale = false;
    if expect_quiet(p, "test -x " + side).is_err() {
        stale = true;
    }
    if expect_quiet(p, "test " + e + " -nt " + side).is_ok() {
        stale = true;
    }
    if expect_quiet(p, "test " + es + " -nt " + side).is_ok() {
        stale = true;
    }
    if expect_quiet(p, "test " + m + " -nt " + side).is_ok() {
        stale = true;
    }
    if stale {
        let tmpc = side + ".tmp.c";
        if check(p, prod + " build " + root + "/oodac/aarch64_main.oo " + side, 180).is_err() {
            a64_side_fail("build side oodac.aarch64");
        }
        if process_exec(p, "rm -f " + tmpc).is_err() {
            a64_side_fail("rm side tmp.c");
        }
    }
    if expect_quiet(p, "test -x " + side).is_err() {
        a64_side_fail("no side oodac.aarch64");
    }
    if expect_quiet(p, "grep -a -q 'pure .oo product CLI' " + side).is_ok() {
        a64_side_fail("side ELF is the product CLI");
    }
    if expect_quiet(p, "grep -a -q 'oodac: usage: emit-aarch64' " + side).is_err() {
        a64_side_fail("side ELF is not emit-aarch64");
    }
}
