// # Contracts Complex Residual Stays Honest
//
// Logline: Verify bootstrap/CONTRACTS_COMPLEX.oot maintains fail-closed residual documentation and CI wiring.
//
// Setup: CONTRACTS_COMPLEX.oot document and ci_product.sh script exist on disk.
//
// Beats:
//   1. Check CONTRACTS_COMPLEX.oot exists on disk.
//   2. Verify CONTRACTS_COMPLEX_RESIDUAL_ALPHA marker and fail-closed residual phrasing.
//   3. Confirm ci_product.sh wires contracts_complex_residual_smoke into the build suite.
import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/CONTRACTS_COMPLEX.oot";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _    = scenario(p, fs, "contracts complex residual");

    // when — doc carries marker + residual wording
    let _ = expect_present(fs, root + "/" + DOC);
    let _ = expect_substring(fs, root + "/" + DOC, "CONTRACTS_COMPLEX_RESIDUAL_ALPHA");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual|not claim|not product' " + root + "/" + DOC);

    // then — ci wires the smoke
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "contracts_complex_residual_smoke");

    println("contracts_complex_residual_smoke: PASSED");
}