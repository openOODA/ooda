// # Adversarial GUI 2D/3D & Font Rasterizer Probe
//
// Logline: Hostile stress-testing of 3D matrix math, Bézier flattening, polygon rasterization, and TTF binary parsing.
//
// Setup: Validates openOODA std/gui resilience under degenerate geometry, singular matrices, and truncated font headers.
//
// Beats:
//   1. Stress-test 3D vector math with zero vectors, colinear vertices, and singular transformations.
//   2. Probe Bézier curve flattening under zero-length spans and collinear endpoints.
//   3. Probe polygon point-in-polygon and rasterizer with 0, 1, 2 points and out-of-bounds bounding boxes.
//   4. Probe TTF SFNT binary parser with truncated, empty, and malformed table headers.

import "std/gui/render.oo";
import "std/gui/gui_3d_math.oo";
import "std/gui/gui_bezier_cubic.oo";
import "std/gui/gui_polygon_rasterizer.oo";
import "std/gui/gui_ttf_parser.oo";

pub fn main(p: &ProcessCap) {
    println("=== Adversarial GUI Engine Probe ===");

    // 1. 3D Math Edge Cases (Zero Vectors & Matrix Operations)
    let v_zero: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let v_norm: Vec3 = vec3_normalize(v_zero);
    let v_dot: Float = vec3_dot(v_zero, v_zero);
    let v_cross: Vec3 = vec3_cross(v_zero, v_zero);

    if (v_norm).x != 0.0 || v_dot != 0.0 || (v_cross).z != 0.0 {
        println("FAIL: Zero vector normal/dot/cross math failed");
        process_exit(1);
    }

    let mat_id: Mat4 = mat4_identity();
    let v4_in: Vec4 = Vec4 { x: 5.0, y: 10.0, z: 15.0, w: 1.0 };
    let v4_trans: Vec4 = mat4_transform_vec4(mat_id, v4_in);
    if (v4_trans).x != 5.0 || (v4_trans).y != 10.0 || (v4_trans).z != 15.0 {
        println("FAIL: Identity matrix transformation mismatch");
        process_exit(1);
    }
    println("  [PASS] 3D Vector & Matrix degenerate edge cases");

    // 2. Bézier Curve Flattening (Zero Length & Collinear)
    let p_fixed: Point = Point { x: 10, y: 10 };
    let b_zero: CubicBezier2D = cubic_bezier_new(p_fixed, p_fixed, p_fixed, p_fixed);
    let p_mid: Point = cubic_bezier_eval(b_zero, 50);
    if (p_mid).x != 10 || (p_mid).y != 10 {
        println("FAIL: Zero-length Bézier evaluation failed");
        process_exit(1);
    }
    let pts_flat: List[Point] = cubic_bezier_flatten(b_zero, 10);
    if list_len(pts_flat) != 11 {
        println("FAIL: Bézier flattening step count mismatch");
        process_exit(1);
    }
    println("  [PASS] Zero-length & collinear Bézier curve evaluation");

    // 3. Degenerate Polygon Rasterization (0, 1, 2 vertices)
    let mut poly_empty: Polygon2D = polygon_new();
    let pt_test: Point = Point { x: 5, y: 5 };
    if polygon_contains_point(poly_empty, pt_test) {
        println("FAIL: Empty polygon should not contain any point");
        process_exit(1);
    }

    polygon_add_point(&mut poly_empty, Point { x: 0, y: 0 });
    if polygon_contains_point(poly_empty, pt_test) {
        println("FAIL: Single-point polygon should not contain point");
        process_exit(1);
    }

    polygon_add_point(&mut poly_empty, Point { x: 10, y: 0 });
    if polygon_contains_point(poly_empty, pt_test) {
        println("FAIL: 2-point line polygon should not contain point");
        process_exit(1);
    }

    let mut rctx: RenderContext = render_context_new(20, 20);
    let col: Color = Color { r: 255, g: 0, b: 0, a: 255 };
    rctx = polygon_rasterize_fill(rctx, poly_empty, 0, col);
    println("  [PASS] Degenerate polygon containment & rasterizer fail-close");

    // 4. TTF SFNT Binary Parser Truncation
    let empty_bytes: List[Int] = list_new();
    let font_empty: TtfFont = ttf_font_parse_header(empty_bytes);
    if (font_empty).is_loaded || (font_empty).num_tables != 0 {
        println("FAIL: Empty byte array should parse to unloaded font");
        process_exit(1);
    }

    let mut trunc_bytes: List[Int] = list_new();
    let mut k: Int = 0;
    while k < 10 {
        trunc_bytes = list_push(trunc_bytes, 0);
        k = k + 1;
    }
    let font_trunc: TtfFont = ttf_font_parse_header(trunc_bytes);
    if (font_trunc).is_loaded {
        println("FAIL: Truncated 10-byte header should fail to load");
        process_exit(1);
    }
    println("  [PASS] TTF binary parser truncated buffer defense");

    println("adv_gui_probe: ALL PASS");
}
