// # emit-wasm two-println WASI lock
//
// Logline: Product emit-wasm of wasm_two_println.oo is a \0asm module whose main prints line-a then line-b.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_two_println.oo and require magic 00 61 73 6d 01 00 00 00.
//   2. The file is not WAT.
//   3. wasmtime prints line-a and line-b in that order or the bytes name fd_write and both texts in order.

import "std/scenario.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn require_both_ordered(p: &ProcessCap, path: String, kind: String) {
    if expect_quiet(p, "grep -a -q line-a " + path).is_err() { fail("no line-a " + kind); }
    if expect_quiet(p, "grep -a -q line-b " + path).is_err() { fail("no line-b " + kind); }
    if expect_quiet(p, "awk 'BEGIN{RS=\"\\0\"} {s=s $0} END{ia=index(s,\"line-a\"); ib=index(s,\"line-b\"); exit (ia>0 && ib>0 && ia<ib)?0:1}' " + path).is_err() {
        fail("order");
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm two println").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_two_println.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_two_println.wasm";
    let out = tmpd + "/wasm_two_println.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_two_println.oo > " + wasm + " 2>" + tmpd + "/wasm_two_println.err").is_err() {
        fail("emit-wasm");
    }
    if expect_present(fs, wasm).is_err() { fail("no wasm"); }
    if check(p, "test -s " + wasm, 5).is_err() { fail("empty"); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        fail("magic");
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() { fail("still wat"); }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        require_both_ordered(p, out, "print");
    } else {
        if expect_quiet(p, "grep -a -q fd_write " + wasm).is_err() { fail("no fd_write"); }
        require_both_ordered(p, wasm, "bytes");
    }
    println("wasm_two_println_smoke: PASSED");
}
