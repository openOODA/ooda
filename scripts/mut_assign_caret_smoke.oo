// # Mut-assign type error prints path and caret
//
// Logline: Cache-cold check of x = "a" on mut Int shows ERR type, path, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_mut_assign.oo prints cannot assign, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/mut_assign_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_mut_assign.oo > " + tmpd +
        "/m.out; echo $? > " + tmpd + "/m.ec; true").is_err() {
        fail("check mut");
    }
    if process_exec(p, "grep -q 'cannot assign' " + tmpd +
        "/m.out && grep -q 'tc_mut_assign.oo' " + tmpd +
        "/m.out && grep -Fq -- '-->' " + tmpd + "/m.out && grep -q '\\^' " +
        tmpd + "/m.out && ! grep -qE '^OK' " + tmpd +
        "/m.out && test \"$(cat " + tmpd + "/m.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("mut_assign_caret_smoke: PASSED");
}
