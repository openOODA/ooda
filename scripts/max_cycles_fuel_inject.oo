// # Max Cycles Fuel Inject
//
// Logline: M48 path A — inject Backend-C while fuel from // MAX_CYCLES: N into <in.c> producing <out.c>; zero/invalid N is refused with ERR\tmax_cycles.
// Beats: extract N | decline zero N | land while-body fuel | no for-loop fuel | marker-only TU honesty.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmp = root + "/.ooda-cache/ooda-tmp/mc_fuel_inject";
    let _ = sh_mkdir_p(p, tmp);
    let _ = scenario(p, fs, "max cycles fuel inject: while-body from // MAX_CYCLES");

    // when: a fixture with // MAX_CYCLES: 5 + a real C while loop lands the fuel
    let src = tmp + "/mci.oo";
    let inc = tmp + "/mci.c";
    let outc = tmp + "/mci_out.c";
    let _ = process_exec(p, "cat > " + src + " <<'EOF'\n// MAX_CYCLES: 5\nEOF");
    let _ = process_exec(p, "cat > " + inc + " <<'EOF'\n#include <stdio.h>\nint main(void) {\n  int i = 0;\n  while (i < 3) {\n    printf(\"%d\\n\", i);\n    i = i + 1;\n  }\n  return 0;\n}\nEOF");
    let inj = root + "/ooda/scripts/max_cycles_fuel_inject.sh";
    check(p, "bash " + inj + " " + src + " " + inc + " " + outc, within: 30);

    // then: out.c carries __oo_mc_fuel-- in the while body, not in a for header
    expect_substring(fs, outc, "__oo_mc_fuel");
    expect_clean(p, "grep -qE '__oo_mc_fuel--' " + outc);
    expect_clean(p, "! grep -E 'for[[:space:]]*\\([^)]*__oo_mc' " + outc);

    // and: zero N is refused (non-zero exit + ERR\tmax_cycles)
    let zsrc = tmp + "/mci_zero.oo";
    let _ = process_exec(p, "cat > " + zsrc + " <<'EOF'\n// MAX_CYCLES: 0\nEOF");
    let _ = process_exec(p, "bash " + inj + " " + zsrc + " " + inc + " " + tmp + "/mci_zero.c 2> " + tmp + "/zerr");
    expect_clean(p, "test $? -ne 0");
    expect_clean(p, "grep -qE $'ERR\\tmax_cycles' " + tmp + "/zerr");

    // and: marker-only TU (no while) drops the static honesty marker and does not crash
    let nosrc = tmp + "/mci_no.oo";
    let _ = process_exec(p, "cat > " + nosrc + " <<'EOF'\n// MAX_CYCLES: 7\nEOF");
    let noinc = tmp + "/mci_no.c";
    let noout = tmp + "/mci_no_out.c";
    let _ = process_exec(p, "cat > " + noinc + " <<'EOF'\nint main(void) { return 0; }\nEOF");
    let _ = process_exec(p, "bash " + inj + " " + nosrc + " " + noinc + " " + noout);
    expect_clean(p, "grep -q 'MAX_CYCLES path A: N=7' " + noout);

    println("max_cycles_fuel_inject: PASSED");
}
