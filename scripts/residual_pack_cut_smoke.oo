// # Residual Pack Cut Honesty
//
// Logline: Honesty-pack .oot files are gone from ooda/bootstrap. Seed, rebuild, and corpus remain.
//
// Setup: ProcessCap and FsReadCap. Cwd is the ooda product root.
//
// Beats:
//   1. No top-level ooda/bootstrap/*.oot pack files.
//   2. seed/oodac, oodac_pure_build, and corpus/check/fail/no_cap_fetch.oo remain.
//   3. SHIPPED.oot and ROADMAP.oot exist. HITL is not a std module.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "residual pack cut");

    if expect_clean(p, "! ls bootstrap/*.oot 2>/dev/null | grep -q .").is_err() {
        println("FAIL leftover ooda/bootstrap/*.oot packs");
        process_exit(1);
    }
    if expect_present(fs, "bootstrap/seed/oodac").is_err() {
        println("FAIL missing seed");
        process_exit(1);
    }
    if expect_present(fs, "bootstrap/oodac_pure_build").is_err() {
        println("FAIL missing oodac_pure_build");
        process_exit(1);
    }
    if expect_present(fs, "bootstrap/corpus/check/fail/no_cap_fetch.oo").is_err() {
        println("FAIL missing check corpus");
        process_exit(1);
    }
    if expect_present(fs, "../openOODA/SHIPPED.oot").is_err() {
        if expect_present(fs, "openOODA/SHIPPED.oot").is_err() {
            println("FAIL missing SHIPPED.oot");
            process_exit(1);
        }
    }
    if expect_present(fs, "../openOODA/ROADMAP.oot").is_err() {
        if expect_present(fs, "openOODA/ROADMAP.oot").is_err() {
            println("FAIL missing ROADMAP.oot");
            process_exit(1);
        }
    }
    if expect_absent(fs, "std/hitl.oo").is_err() {
        println("FAIL std/hitl.oo returned");
        process_exit(1);
    }
    println("residual_pack_cut_smoke: PASSED");
}
