// # Meta vs Det Residual Smoke
//
// Logline: bootstrap/META_VS_DET.oot carries the residual marker, fail-closed wording, no "shipped" claim, and the fixture marker line.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker | no product-green claim | fail-closed wording | fixture marker | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "meta_vs_det residual honesty");

    // when: doc + marker + no product-green claim
    expect_present(fs, "ooda/bootstrap/META_VS_DET.oot");
    expect_substring(fs, "ooda/bootstrap/META_VS_DET.oot", "META_VS_DET_RESIDUAL_ALPHA");
    expect_clean(p, "grep -nEi 'fully shipped|enforced in product|sandbox is live' " + "ooda/bootstrap/META_VS_DET.oot" + " | grep -viE 'not |residual|do not|never|no '");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + "ooda/bootstrap/META_VS_DET.oot");

    // then: fixture carries the marker line
    expect_present(fs, "ooda/fixtures/meta_vs_det_marker.oo");
    expect_substring(fs, "ooda/fixtures/meta_vs_det_marker.oo", "META_VS_DET: residual");

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "meta_vs_det_residual_smoke");
    println("meta_vs_det_residual_smoke: PASSED");
}
