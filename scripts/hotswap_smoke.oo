// # Live Process Code Hot-Swapping Verification Suite
//
// Logline: Verify type-safety, DINNER compliance, line-count constraints, oodac compilation, and binary execution of hotswap engine.
//
// Setup: oodac compiler binary built; std/src/ooda/hotswap modules on disk; fixtures/hotswap_fixture.oo present.
//
// Beats:
//   1. Check type-safety across hotswap standard library modules and std/hotswap.oo entry point.
//   2. Validate DINNER headers and strictly <= 256 line count constraints across all source files.
//   3. Compile and execute hotswap_fixture binary, proving live symbol swapping, schema migration, and rollback.
//   4. Verify atomic pointer redirection, capability gating, and state checksum consistency.
//   5. Output test summary and emit final PASSED certification.
//
// residual: Dynamic kernel symbol relocation and trampolines lower through native ELF relocators

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let std_r = sh_realpath(p, root + "/../std").unwrap_or(root + "/../std");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, fs, "live process code hot-swapping and schema migration engine");

    // Beat 1: Check type safety of hotswap modules
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/hotswap/hotswap_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/hotswap/state_migrate.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/hotswap/symbol_patch.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/hotswap/hotswap.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/hotswap.oo", 10);

    // Beat 2: Validate line count constraints (strictly <= 256 lines)
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/hotswap/hotswap_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/hotswap/state_migrate.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/hotswap/symbol_patch.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/hotswap/hotswap.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/hotswap.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/fixtures/hotswap_fixture.oo) -le 256", 5);

    // Beat 3: Check, compile, and execute end-to-end fixture
    let fix = root + "/fixtures/hotswap_fixture.oo";
    let _ = check(p, oodac + " check " + fix, 10);
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmpd + "/hotswap.c 2> " + tmpd + "/hotswap.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/hotswap.c " + tmpd + "/hotswap.err 2>/dev/null", 15);
    let _ = process_exec(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/hotswap.c -lm -ldl -lpthread -o " + tmpd + "/hotswap.bin 2>" + tmpd + "/hotswap_gcc.err");
    let _ = process_exec(p, tmpd + "/hotswap.bin > " + tmpd + "/hotswap.out 2>&1");
    let _ = check(p, "grep -qx 'HOTSWAP_INIT_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_CAP_VERIFIED_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_SCHEMA_V1_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_MIGRATION_V2_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_SYMBOL_PATCH_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_EXECUTION_V2_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_FAULT_TRIGGER_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_ROLLBACK_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_STATE_CONSISTENCY_OK' " + tmpd + "/hotswap.out", 10);
    let _ = check(p, "grep -qx 'HOTSWAP_FIXTURE_ALL_PASSED' " + tmpd + "/hotswap.out", 10);

    // Beat 4: DINNER header verification
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/hotswap/hotswap.oo", 5);
    let _ = check(p, "grep -qE '^// Logline: ' " + std_r + "/src/ooda/hotswap/hotswap.oo", 5);
    let _ = check(p, "grep -qE '^// Setup: ' " + std_r + "/src/ooda/hotswap/hotswap.oo", 5);
    let _ = check(p, "grep -qE '^// Beats:' " + std_r + "/src/ooda/hotswap/hotswap.oo", 5);
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/hotswap.oo", 5);

    println("hotswap_smoke: PASSED");
}
