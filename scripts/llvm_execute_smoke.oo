// # LLVM Execute Smoke
//
// Logline: emit-llvm produces IR with oo_print_int + i64 42, and clang compiles+runs it to stdout 42; multi-binop 2+3*4=14 + 10%3=1 too.
//
// Setup: Process capability, oodac, runtime, and clang on PATH.
//
// Beats:
//   1. Tiny int fixture emits IR with define + i64 42 + oo_print_int.
//   2. clang + chs_rt compiles and run stdout is 42.
//   3. Multi-binop + modulo IR has mul/add/srem and run stdout is 14 then 1.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let rt = root + "/runtime";
    let tmp = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let clang = sh_which(p, "clang").unwrap_or("clang");
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "llvm execute: emit IR + clang + run + multi-binop");

    // when tiny int fixture emits IR with define + i64 42 + oo_print_int
    check(p, "printf 'pub fn main() {\\n    println(42)\\n}\\n' > " + tmp + "/llvm_hello.oo", within: 5);
    check(p, oodac + " emit-llvm " + tmp + "/llvm_hello.oo > " + tmp + "/llvm_hello.ll 2>&1", within: 30);
    expect_substring(fs, tmp + "/llvm_hello.ll", "define ");
    expect_substring(fs, tmp + "/llvm_hello.ll", "i64 42");
    expect_substring(fs, tmp + "/llvm_hello.ll", "oo_print_int");

    // and clang compiles+links with chs_rt
    if chars_len(clang) == 0 {
        println("ERR_NO_LLVM: need clang on PATH");
        return;
    }
    check(p, clang + " -O0 -Wno-override-module -Wno-unused-command-line-argument -I " + rt + " " + tmp + "/llvm_hello.ll " + rt + "/chs_rt.c -o " + tmp + "/llvm_hello.bin -lm", within: 60);

    // then run stdout matches 42
    expect_clean(p, tmp + "/llvm_hello.bin 2>&1 | tr -d '\\r' | grep -qx '42'");

    // and multi-binop + modulo — 2+3*4=14, 10%3=1
    check(p, "printf 'pub fn main() {\\n    let x = 2 + 3 * 4;\\n    println(x);\\n    let w = 10 % 3;\\n    println(w);\\n}\\n' > " + tmp + "/llvm_binop.oo", within: 5);
    check(p, oodac + " emit-llvm " + tmp + "/llvm_binop.oo > " + tmp + "/llvm_binop.ll 2>&1", within: 30);
    expect_substring(fs, tmp + "/llvm_binop.ll", "mul i64");
    expect_substring(fs, tmp + "/llvm_binop.ll", "add i64");
    expect_substring(fs, tmp + "/llvm_binop.ll", "srem i64");
    check(p, clang + " -O0 -Wno-override-module -Wno-unused-command-line-argument -I " + rt + " " + tmp + "/llvm_binop.ll " + rt + "/chs_rt.c -o " + tmp + "/llvm_binop.bin -lm", within: 60);
    expect_clean(p, tmp + "/llvm_binop.bin 2>&1 | tr -d '\\r' | grep -qx '14'");
    expect_clean(p, tmp + "/llvm_binop.bin 2>&1 | tr -d '\\r' | grep -qx '1'");

    println("llvm_execute_smoke: PASSED");
}
