// # Pure Build Fingerprint Smoke
//
// Logline: two pure multi builds of the same tree produce the same input_fp; editing a module source changes the fingerprint.
// Beats: pure build twice | equal fp | mutate source | fp changes.

import "std/scenario.oo";
import "std/sh.oo";

const MAIN: String = "ooda/bootstrap/corpus/import/pass/multi_ok.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "pure build input_fp fingerprint");

    expect_present(fs, root + "/" + MAIN);
    expect_clean(p, "test -x " + root + "/ooda/scripts/oodac_pure_build.sh");

    // when: pure multi builds twice, both emit non-empty input_fp
    let _ = check(p, "PURE_BUILD_FP_OUT=/tmp/fp1 bash " + root + "/ooda/scripts/oodac_pure_build.sh " + root + "/" + MAIN + " /tmp/bin1", within: 180);
    let _ = check(p, "PURE_BUILD_FP_OUT=/tmp/fp2 bash " + root + "/ooda/scripts/oodac_pure_build.sh " + root + "/" + MAIN + " /tmp/bin2", within: 180);

    // then: fingerprints are equal (stable across builds)
    expect_clean(p, "tr -d ' \\t\\r\\n' </tmp/fp1 > /tmp/fp1.c; grep -qE '^[0-9a-f]{64}$' /tmp/fp1.c");
    expect_clean(p, "tr -d ' \\t\\r\\n' </tmp/fp2 > /tmp/fp2.c; grep -qE '^[0-9a-f]{64}$' /tmp/fp2.c");
    expect_clean(p, "diff /tmp/fp1.c /tmp/fp2.c");

    // and: editing a source module changes the fingerprint
    let _ = process_exec(p, "cp " + root + "/ooda/bootstrap/corpus/import/pass/lib.oo /tmp/lib.oo");
    let _ = check(p, "PURE_BUILD_FP_OUT=/tmp/fp3 bash " + root + "/ooda/scripts/oodac_pure_build.sh " + root + "/" + MAIN + " /tmp/bin3", within: 180);
    let _ = process_exec(p, "echo '// m20-fp-touch' >> /tmp/lib.oo; cp /tmp/lib.oo " + root + "/ooda/bootstrap/corpus/import/pass/lib.oo");
    let _ = check(p, "PURE_BUILD_FP_OUT=/tmp/fp4 bash " + root + "/ooda/scripts/oodac_pure_build.sh " + root + "/" + MAIN + " /tmp/bin4", within: 180);
    expect_clean(p, "! diff /tmp/fp3 /tmp/fp4");

    println("pure_build_fp_smoke: PASSED");
}
