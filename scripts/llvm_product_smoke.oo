// # LLVM product path
//
// Logline: Prove emit-llvm, clang link with chs_rt, and run of fixtures/int_main.oo prints 42.
//
// Setup: OODAC_BIN emits LLVM IR. clang is on PATH. Caps are injected.
//
// Beats:
//   1. emit-llvm of int_main.oo has no ERR line.
//   2. clang -O0 links runtime/chs_rt.c to a binary.
//   3. Run prints 42.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "LLVM product path");

    let fix = root + "/fixtures/int_main.oo";
    let rt = root + "/runtime";
    let ll = tmp + "/int_main.ll";
    let bin = tmp + "/int_main_llvm.bin";

    let _ = process_exec(p, oodac + " emit-llvm " + fix + " > " + ll + " 2>" + tmp + "/int_main.ll.err");
    expect_clean(p, "! grep -qE $'^ERR' " + ll + " " + tmp + "/int_main.ll.err");
    expect_clean(p, "clang -O0 -Wno-override-module -I" + rt + " " + ll + " " + rt + "/chs_rt.c -lm -ldl -lpthread -o " + bin);
    expect_clean(p, bin + " 2>&1 | grep -qx 42");

    let hello = root + "/fixtures/hello.oo";
    let hll = tmp + "/hello.ll";
    let hbin = tmp + "/hello_llvm.bin";
    let _ = process_exec(p, oodac + " emit-llvm " + hello + " > " + hll + " 2>" + tmp + "/hello.ll.err");
    expect_clean(p, "! grep -qE $'^ERR' " + hll + " " + tmp + "/hello.ll.err");
    expect_clean(p, "clang -O0 -Wno-override-module -I" + rt + " " + hll + " " + rt + "/chs_rt.c -lm -ldl -lpthread -o " + hbin);
    expect_clean(p, hbin + " 2>&1 | grep -q 'Hello, openOODA Developer!'");

    println("llvm_product_smoke: PASSED");
}
