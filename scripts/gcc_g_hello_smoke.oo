// # Product gcc -g -O2 maps dwarf to hello.oo
//
// Logline: emit-c plus the product gcc -O2 -g flags produce a hello binary whose dwarf names hello.oo.
//
// Setup: cwd is ooda/. Product oodac/oodac. Flags match cli_build.oo gcc_cmd.
//
// Beats:
//   1. Product strings contain gcc -O2 -g.
//   2. emit-c hello + gcc -O2 -g dwarf names fixtures/hello.oo.
//   3. That binary prints the greeting.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/gcc_g";
    let c = tmpd + "/hello.c";
    let bin = tmpd + "/hello.bin";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "strings " + oodac + " | grep -q 'gcc -O2 -g'").is_err() {
        fail("no -g in gcc_cmd");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/hello.oo > " + c).is_err() {
        fail("emit-c");
    }
    if process_exec(p, "gcc -O2 -g -frandom-seed=0 -Wl,--build-id=none -Iruntime " +
        c + " runtime/chs_rt.c -lm -ldl -lpthread -o " + bin).is_err() {
        fail("gcc");
    }
    if process_exec(p, "readelf --debug-dump=decodedline " + bin +
        " 2>/dev/null | grep -q fixtures/hello.oo || objdump -WL " + bin +
        " 2>/dev/null | grep -q fixtures/hello.oo").is_err() {
        fail("dwarf");
    }
    if process_exec(p, bin + " | grep -q 'Hello, openOODA Developer!'").is_err() {
        fail("run");
    }
    println("gcc_g_hello_smoke: PASSED");
}
