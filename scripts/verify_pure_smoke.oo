// # Verify Pure Stays On The Critical Path
// Logline: ooda_verify_pure.sh wires assert_eq/assert_ne/assert; no python3 on the path.
// Setup: bin/ooda or oodac product path; fixtures/verify_{pass,fail}.oo on disk.
// Beats: 1. ooda_test_verify wires pure + no python | 2. verify_pass OK | 3. verify_fail refuses

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — ooda_test_verify.sh wires ooda_verify_pure.sh + no python
    fails = fails + tally(expect_quiet(p, "grep -q 'ooda_verify_pure.sh' " + root + "/scripts/ooda_test_verify.sh"), "ooda_test_verify wires pure");
    let no_py = "grep -vE '^[[:space:]]*#' " + root + "/scripts/ooda_test_verify.sh | grep -nE 'python3|ooda_test_harness\\.py|oodac_pure_build\\.sh' 2>/dev/null";
    fails    = fails + tally(expect_quiet(p, "test -z \"$(" + no_py + ")\""),                                                          "no python on critical path");

    // and — verify_pass / verify_fail product rails
    let vpout = tmpd + "/vp.out";
    let _w1   = process_exec(p, ooda + " test " + root + "/fixtures/verify_pass.oo > " + vpout + " 2>" + tmpd + "/vp.err");
    fails     = fails + tally(expect_quiet(p, "grep -q 'OK verify' " + vpout),                                                          "verify_pass product OK");

    let vfout = tmpd + "/vf.out";
    let _w2   = process_exec(p, ooda + " test " + root + "/fixtures/verify_fail.oo > " + vfout + " 2>" + tmpd + "/vf.err");
    fails     = fails + tally(expect_clean(p, "test \"$(" + ooda + " test " + root + "/fixtures/verify_fail.oo >/dev/null 2>&1; echo $?)\" -ne 0"), "verify_fail product refuses");

    // then — assert_ne + assert! on inline fixture
    let vne  = tmpd + "/vne.oo";
    let vnout = tmpd + "/vne.out";
    let _w3   = process_exec(p, "printf 'pub fn add(a: Int, b: Int) -> Int { return a + b; }\\nverify add {\\n    assert_ne!(add(1, 1), 3);\\n    assert!(add(2, 2) == 4);\\n}\\npub fn main() { println(1); }\\n' > " + vne);
    let _w4   = process_exec(p, ooda + " test " + vne + " > " + vnout + " 2>" + tmpd + "/vne.err");
    fails     = fails + tally(expect_quiet(p, "grep -q 'OK verify' " + vnout),                                                          "assert_ne + assert! verify");

    if fails > 0 { println("verify_pure_smoke: FAILED"); process_exit(1); }
    println("verify_pure_smoke: PASSED");
}
