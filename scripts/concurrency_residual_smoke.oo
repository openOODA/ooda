// # Concurrency Residual Stays Honest
//
// Logline: Verify bootstrap/CONCURRENCY.oot carries residual markers and CI wiring without false claims.
//
// Setup: CONCURRENCY.oot doc, concurrency_marker fixture, and ci_product.sh script exist on disk.
//
// Beats:
//   1. Verify CONCURRENCY.oot exists with marker and fail-closed wording without shipped claims.
//   2. Check concurrency_marker.oo fixture contains the expected residual marker line.
//   3. Confirm ci_product.sh wires concurrency_residual_smoke into the test suite.
import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let _     = scenario(p, fs, "concurrency residual honesty");

    // when — doc + marker + no product-green claim
    let _ = expect_present(fs, root + "/" + "ooda/bootstrap/CONCURRENCY.oot");
    let _ = expect_substring(fs, root + "/" + "ooda/bootstrap/CONCURRENCY.oot", "CONCURRENCY_RESIDUAL_ALPHA");
    let _ = expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + "ooda/bootstrap/CONCURRENCY.oot" + " | grep -viE 'not |residual|do not|never|no '");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + root + "/" + "ooda/bootstrap/CONCURRENCY.oot");

    // then — fixture + ci wire
    let _ = expect_present(fs, root + "/" + "ooda/fixtures/concurrency_marker.oo");
    let _ = expect_substring(fs, root + "/" + "ooda/fixtures/concurrency_marker.oo", "CONCURRENCY: residual");
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "concurrency_residual_smoke");

    println("concurrency_residual_smoke: PASSED");
}