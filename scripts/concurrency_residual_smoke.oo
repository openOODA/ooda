// # Concurrency Residual Stays Honest
// Logline: bootstrap/CONCURRENCY.oot carries marker + fail-closed residual; fixture marker present; ci wired.
import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/CONCURRENCY.oot";
const FIX: String = "ooda/fixtures/concurrency_marker.oo";
const MARKER: String = "CONCURRENCY_RESIDUAL_ALPHA";
const FIXLINE: String = "CONCURRENCY: residual";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let _     = scenario(p, fs, "concurrency residual honesty");

    // when — doc + marker + no product-green claim
    let _ = expect_present(fs, root + "/" + DOC);
    let _ = expect_substring(fs, root + "/" + DOC, MARKER);
    let _ = expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + DOC + " | grep -viE 'not |residual|do not|never|no '");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);

    // then — fixture + ci wire
    let _ = expect_present(fs, root + "/" + FIX);
    let _ = expect_substring(fs, root + "/" + FIX, FIXLINE);
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "concurrency_residual_smoke");

    println("concurrency_residual_smoke: PASSED");
}