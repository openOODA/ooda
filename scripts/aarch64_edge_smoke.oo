// # emit-aarch64 hello-blind edge lock
//
// Logline: Side emit-aarch64 fail-closes outside-main, empty, and no-main, and writes byte-correct multi/utf8/escape .s.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only. clang assembles the success cases.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. outside-main, empty, and no-main must ERR and must not write _start.
//   3. multi, utf8 é (mov x2, #3), and escape (mov x2, #13) assemble as ARM aarch64.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn refuse_start(p: &ProcessCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if process_exec(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail(tag + " wrote _start");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() {
        fail(tag + " no ERR");
    }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() {
        fail(tag + " silent omit .s");
    }
}

fn emit_ok(p: &ProcessCap, fs: &FsReadCap, side: String, src: String, sfile: String, serr: String, tag: String) {
    if check(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr, 30).is_err() {
        fail(tag + " emit");
    }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail(tag + " ERR"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(tag + " no _start"); }
    if expect_substring(fs, sfile, "svc #0").is_err() { fail(tag + " no svc"); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(tag + " looks like emit-c");
    }
    if expect_clean(p, "! grep -qE 'syscall|%rax|as --64' " + sfile).is_err() {
        fail(tag + " looks like x86_64");
    }
}

fn assemble(p: &ProcessCap, sfile: String, obj: String, tag: String) {
    if check(p, "clang -target aarch64-linux-gnu -c " + sfile + " -o " + obj, 15).is_err() {
        fail(tag + " clang assemble");
    }
    if expect_clean(p, "file " + obj + " | grep -q 'ARM aarch64'").is_err() {
        fail(tag + " not ARM aarch64");
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 hello-blind edges").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x /usr/bin/clang").is_err() { fail("no clang"); }
    ensure_aarch64_side(p, root, prod, side);

    refuse_start(p, side, fx + "aarch64_outside_main.oo", tmpd + "/a64_out.s", tmpd + "/a64_out.err", "outside");
    refuse_start(p, side, fx + "aarch64_empty.oo", tmpd + "/a64_empty.s", tmpd + "/a64_empty.err", "empty");
    refuse_start(p, side, fx + "aarch64_nomain.oo", tmpd + "/a64_nomain.s", tmpd + "/a64_nomain.err", "nomain");

    emit_ok(p, fs, side, fx + "aarch64_multi.oo", tmpd + "/a64_multi.s", tmpd + "/a64_multi.err", "multi");
    if expect_substring(fs, tmpd + "/a64_multi.s", ".Lstr0:").is_err() { fail("multi no Lstr0"); }
    if expect_substring(fs, tmpd + "/a64_multi.s", ".Lstr1:").is_err() { fail("multi no Lstr1"); }
    assemble(p, tmpd + "/a64_multi.s", tmpd + "/a64_multi.o", "multi");

    emit_ok(p, fs, side, fx + "aarch64_utf8.oo", tmpd + "/a64_utf8.s", tmpd + "/a64_utf8.err", "utf8");
    if expect_substring(fs, tmpd + "/a64_utf8.s", "mov x2, #3").is_err() { fail("utf8 wrong write length"); }
    if expect_clean(p, "! grep -q 'mov x2, #2' " + tmpd + "/a64_utf8.s").is_err() {
        fail("utf8 still chars_len");
    }
    assemble(p, tmpd + "/a64_utf8.s", tmpd + "/a64_utf8.o", "utf8");

    emit_ok(p, fs, side, fx + "aarch64_esc.oo", tmpd + "/a64_esc.s", tmpd + "/a64_esc.err", "esc");
    if expect_substring(fs, tmpd + "/a64_esc.s", "mov x2, #13").is_err() { fail("esc wrong write length"); }
    if expect_substring(fs, tmpd + "/a64_esc.s", "say \\\"hi\\\" \\\\ok").is_err() { fail("esc .ascii"); }
    assemble(p, tmpd + "/a64_esc.s", tmpd + "/a64_esc.o", "esc");

    println("aarch64_edge_smoke: PASSED");
}
