// # Secret T2 Depth Smoke
//
// Logline: T2 scan depth — field / method / multi-arg / multi-name SECRET sinks refuse, comment-skip ignores mid-line `// SECRET:` mentions.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Every T2 fixture is present on disk.
//   2. Field / method / multi-arg / multi-name fail fixtures refuse emit-c.
//   3. Pass fixtures and mid-line comment-skip stay clean; ci_product.oo wires this rail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "secret T2 depth");

    let mut req: List[String] = list_new();
    req = list_push(req, "secret_field_assign_fail");
    req = list_push(req, "secret_field_assign_pass");
    req = list_push(req, "secret_method_return_fail");
    req = list_push(req, "secret_method_return_pass");
    req = list_push(req, "secret_call_arg_fail");
    req = list_push(req, "secret_multi_arg_println_fail");
    req = list_push(req, "secret_multi_name_fail");
    req = list_push(req, "secret_multi_name_pass");
    req = list_push(req, "secret_midline_safe");

    let mut refuse: List[String] = list_new();
    refuse = list_push(refuse, "secret_field_assign_fail");
    refuse = list_push(refuse, "secret_method_return_fail");
    refuse = list_push(refuse, "secret_call_arg_fail");
    refuse = list_push(refuse, "secret_multi_arg_println_fail");
    refuse = list_push(refuse, "secret_multi_name_fail");

    let mut allow: List[String] = list_new();
    allow = list_push(allow, "secret_field_assign_pass");
    allow = list_push(allow, "secret_method_return_pass");
    allow = list_push(allow, "secret_multi_name_pass");
    allow = list_push(allow, "secret_midline_safe");

    // when: every T2 fixture is present
    let n_req: Int = list_len(req);
    let mut i: Int = 0;
    while i < n_req {
        let base: String = list_get(req, i);
        expect_present(fs, root + "/ooda/fixtures/" + base + ".oo");
        i = i + 1;
    }

    // and: field / method / multi-arg / multi-name refuse
    let n_refuse: Int = list_len(refuse);
    let mut j: Int = 0;
    while j < n_refuse {
        let fail_base: String = list_get(refuse, j);
        expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/" + fail_base + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
        j = j + 1;
    }

    // then: pass fixtures + comment-skip do not raise ERR\tsecret
    let n_allow: Int = list_len(allow);
    let mut k: Int = 0;
    while k < n_allow {
        let pass_base: String = list_get(allow, k);
        expect_clean(p, "!" + oodac + " emit-c " + root + "/ooda/fixtures/" + pass_base + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
        k = k + 1;
    }

    // and: mid-line `// SECRET:` is not a directive
    expect_clean(p, "! grep -qE '^[[:space:]]*// SECRET:[[:space:]]*[[:alnum:]_]+' " + root + "/ooda/fixtures/secret_midline_safe.oo");

    expect_substring(fs, root + "/ooda/scripts/ci_product.oo", "secret_t2_depth_smoke");
    println("secret_t2_depth_smoke: PASSED");
}
