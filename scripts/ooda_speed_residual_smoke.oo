// # OODA Speed Residual Smoke
//
// Logline: bootstrap/OODA_SPEED.oot carries the residual marker, fail-closed wording, and non-claims; the fixture wires it via ci_product.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker | fail-closed | non-claims | fixture | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "ooda speed residual honesty");

    // when: doc + marker + fail-closed + non-claims
    expect_present(fs, "ooda/bootstrap/OODA_SPEED.oot");
    expect_substring(fs, "ooda/bootstrap/OODA_SPEED.oot", "OODA_SPEED_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + "ooda/bootstrap/OODA_SPEED.oot");
    expect_clean(p, "grep -qiE 'do \\*\\*not\\*\\* claim|not claim' " + "ooda/bootstrap/OODA_SPEED.oot");

    // then: fixture marker line
    expect_present(fs, "ooda/fixtures/ooda_speed_marker.oo");
    expect_substring(fs, "ooda/fixtures/ooda_speed_marker.oo", "OODA_SPEED: residual");

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "ooda_speed_residual_smoke");
    println("ooda_speed_residual_smoke: PASSED");
}
