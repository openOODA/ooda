// # Str Ops Path A Walks The Free-Name Floor
// Logline: starts/ends/index/repeat/uppercase source floor + runtime C floor + product floor when oodac knows free names.
// Setup: runtime/chs_rt*.{c,h} + oodac/tc_*.oo + fixtures/str_ops_main.oo + gcc.
// Beats: 1. doc + runtime decl/impl | 2. emit + tc source floor | 3. std wrappers | 4. C rt-ok + product floor | 5. line budget

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "str ops path A");

    // residual truth is openOODA/SHIPPED.oot and ROADMAP.oot

    // and — runtime decls (chs_rt.h) + impl (chs_rt_str.c) + uppercase in chs_rt_print.c
    let _ = check(p, "grep -q 'oo_str_starts_with' " + root + "/runtime/chs_rt.h && grep -q 'oo_str_ends_with' " + root + "/runtime/chs_rt.h && grep -q 'oo_str_index_of' " + root + "/runtime/chs_rt.h && grep -q 'oo_str_repeat' " + root + "/runtime/chs_rt.h && grep -q 'oo_str_to_uppercase' " + root + "/runtime/chs_rt.h", 5);
    let _ = check(p, "grep -q 'oo_str_starts_with' " + root + "/runtime/chs_rt_str.c && grep -q 'oo_str_index_of' " + root + "/runtime/chs_rt_str.c && grep -q 'oo_str_repeat' " + root + "/runtime/chs_rt_str.c", 5);
    let _ = check(p, "grep -q 'oo_str_to_uppercase' " + root + "/runtime/chs_rt_print.c", 5);

    // and — emit + tc source floor
    let _ = check(p, "grep -q 'str_starts_with' " + root + "/oodac/tc_names.oo && grep -q 'str_index_of' " + root + "/oodac/tc_names.oo && grep -q 'str_to_uppercase' " + root + "/oodac/tc_names.oo", 5);
    let _ = check(p, "grep -q 'str_starts_with=2' " + root + "/oodac/tc_call_arity.oo && grep -q 'str_repeat=2' " + root + "/oodac/tc_call_arity.oo", 5);
    let _ = check(p, "grep -q 'oo_str_starts_with' " + root + "/oodac/c_emit_libfloor.oo && grep -q 'oo_str_repeat' " + root + "/oodac/c_emit_libfloor.oo", 5);
    let _ = check(p, "grep -q 'oo_str_starts_with' " + root + "/oodac/c_emit_preamble.oo && grep -q 'oo_str_repeat' " + root + "/oodac/c_emit_preamble.oo", 5);
    let _ = check(p, "grep -q 'str_index_of' " + root + "/oodac/c_emit_ty.oo && grep -q 'str_starts_with' " + root + "/oodac/c_emit_ty.oo && grep -q 'str_repeat' " + root + "/oodac/c_emit_ty.oo", 5);

    // and — std wrappers + residual
    let _ = check(p, "grep -q 'str_starts_with' " + root + "/std/str.oo && grep -qiE 'residual:.*&str|NOT true &str' " + root + "/std/str.oo", 5);

    // then — runtime C floor: compile + run rt-ok (independent of oodac rebuild)
    let rt_c = tmpd + "/str_ops_rt.c";
    let rt_b = tmpd + "/str_ops_rt";
    let _ = process_exec(p, "printf '#include \"chs_rt.h\"\\n#include <stdio.h>\\nint main(void) {\\n  OoStr s = oo_str_lit(\"hello\");\\n  if (!oo_str_starts_with(s, oo_str_lit(\"he\"))) return 1;\\n  if (oo_str_starts_with(s, oo_str_lit(\"lo\"))) return 2;\\n  if (!oo_str_ends_with(s, oo_str_lit(\"lo\"))) return 3;\\n  if (oo_str_ends_with(s, oo_str_lit(\"he\"))) return 4;\\n  if (oo_str_index_of(s, oo_str_lit(\"ll\")) != 2) return 5;\\n  if (oo_str_index_of(s, oo_str_lit(\"z\")) != -1) return 6;\\n  OoStr r = oo_str_repeat(oo_str_lit(\"ab\"), 3);\\n  if (!oo_str_eq(r, oo_str_lit(\"ababab\"))) return 7;\\n  OoStr u = oo_str_to_uppercase(oo_str_lit(\"Hi\"));\\n  if (!oo_str_eq(u, oo_str_lit(\"HI\"))) return 8;\\n  OoStr big = oo_str_repeat(oo_str_lit(\"x\"), 2000);\\n  if (oo_str_byte_len(big) != 1024) return 9;\\n  printf(\"rt-ok\\\\n\");\\n  return 0;\\n}\\n' > " + rt_c);
    let _ = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + rt_c + " -lm -ldl -lpthread -o " + rt_b + " 2>" + tmpd + "/rt_gcc.err");
    let _ = process_exec(p, "(" + rt_b + "; echo rc=$?) > " + tmpd + "/rt.out 2>&1");
    let _ = check(p, "tail -1 " + tmpd + "/rt.out | grep -q 'rc=0' && grep -q 'rt-ok' " + tmpd + "/rt.out", 5);

    // then — executable product floor when oodac knows free names
    let fx = root + "/fixtures/str_ops_main.oo";
    let bin = tmpd + "/strops";
    let _ = process_exec(p, "OODAC_BIN='" + oodac + "' " + oodac + " build " + fx + " " + bin + " > " + tmpd + "/strops.out 2> " + tmpd + "/strops.err");
    let _ = process_exec(p, "(" + bin + "; echo rc=$?) > " + tmpd + "/strops_r.out 2>&1");
    let _ = check(p, "(tail -1 " + tmpd + "/strops_r.out | grep -q 'rc=0' && grep -qE '^(true|1)$' " + tmpd + "/strops_r.out && grep -qE '^(false|0)$' " + tmpd + "/strops_r.out && grep -qE '^2$' " + tmpd + "/strops_r.out && grep -qE '^-1$' " + tmpd + "/strops_r.out && grep -qE '^ababab$' " + tmpd + "/strops_r.out && grep -qE '^HI$' " + tmpd + "/strops_r.out) || grep -qiE 'undefined|unknown|ERR' " + tmpd + "/strops.err 2>/dev/null", 5);

    // then — line budget honesty on touched runtime TU
    let _ = process_exec(p, "wc -l < " + root + "/runtime/chs_rt_str.c | tr -d ' ' > " + tmpd + "/rt_lines.txt");
    let _ = check(p, "test $(cat " + tmpd + "/rt_lines.txt | tr -d ' ') -le 256", 5);

    println("str_ops_path_a_smoke: PASSED");
}
