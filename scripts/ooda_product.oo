// # OODA Product
//
// Logline: product CLI backend — argv-only dispatcher (no eval of user strings); modes: forward / build / em / migrate / context / digest / health / err-digest / pack / run / test / patch / fix / add|install / outline|reflect; EM resolves OODAC_BIN via env then known seeds.
//
// Beats: env normalize | EM resolve | mode dispatch (argv-only) | every listed mode present.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "ooda product CLI backend dispatcher");

    when "OODAC_BIN / OODA_BIN / OODA_SRC_ROOT readlink-resolved" {
    and  "EM resolves via env + tree + seed" {
    and  "every mode present (forward/build/em/migrate/context/digest/health/err-digest/pack/run/test/patch/fix/add|install/outline|reflect)" {
    and  "argv-only (no eval of user strings)" {
    then "ooda_product PASSED" { } } } }

    expect_present(fs, root + "/scripts/ooda_product.sh");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "forward");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "build");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "migrate");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "err-digest");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "outline");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "reflect");
    expect_substring(fs, root + "/scripts/ooda_product.sh", "bootstrap/seed/oodac");
    println("ooda_product: PASSED (all modes catalogued)");
}
