// # OODA Product Honesty
//
// Logline: Product CLI is cli/main.oo. scripts/ooda_product.sh is gone.
//
// Setup: ProcessCap and FsReadCap. Cwd is the ooda product root.
//
// Beats:
//   1. cli/main.oo dispatches check, build, run, patch, and fix.
//   2. scripts/ooda_product.sh is absent.
//   3. Residual digest is named residual in help text.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "ooda product CLI honesty");
    if expect_present(fs, "cli/main.oo").is_err() {
        println("FAIL missing cli/main.oo");
        process_exit(1);
    }
    if expect_substring(fs, "cli/main.oo", "run_oodac_check").is_err() {
        println("FAIL native check dispatch missing");
        process_exit(1);
    }
    if expect_substring(fs, "cli/main.oo", "run_ooda_fix").is_err() {
        println("FAIL native fix dispatch missing");
        process_exit(1);
    }
    if expect_substring(fs, "cli/main.oo", "run_ooda_patch").is_err() {
        println("FAIL native patch dispatch missing");
        process_exit(1);
    }
    if expect_substring(fs, "cli/main.oo", "residual command").is_err() {
        println("FAIL residual fail-closed missing");
        process_exit(1);
    }
    if expect_absent(fs, "scripts/ooda_product.sh").is_err() {
        println("FAIL leftover scripts/ooda_product.sh");
        process_exit(1);
    }
    println("ooda_product: PASSED");
}
