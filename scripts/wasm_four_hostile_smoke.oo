// # Hostile IDENT fourth println lock
//
// Logline: emit-wasm of three STRING prints plus println(IDENT) must not print only a four-string join.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. wasmtime is optional.
//
// Beats:
//   1. emit-wasm fixtures/wasm_four_hostile.oo.
//   2. ERR or dummy empty stdout is honest.
//   3. Sole fold-me or invented line-a/line-b/line-c/fold-me join fails.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm four ident hostile").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_four_hostile.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_four_hostile.wasm";
    let errf = tmpd + "/wasm_four_hostile.err";
    let out = tmpd + "/wasm_four_hostile.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_four_hostile.oo > " + wasm + " 2>" + errf).is_err() {
        if expect_quiet(p, "grep -q ERR " + errf).is_ok() {
            println("wasm_four_hostile_smoke: PASSED");
            return;
        }
    }
    if expect_quiet(p, "grep -qE '^ERR' " + errf + " " + wasm).is_ok() {
        println("wasm_four_hostile_smoke: PASSED");
        return;
    }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() {
            println("wasm_four_hostile_smoke: PASSED");
            return;
        }
        refuse_fold_or_join(p, out);
    } else {
        refuse_fold_or_join(p, wasm);
    }
    println("wasm_four_hostile_smoke: PASSED");
}

fn refuse_fold_or_join(p: &ProcessCap, path: String) {
    if expect_quiet(p, "test ! -s " + path).is_ok() {
        return;
    }
    if expect_quiet(p, "grep -q fold-me " + path).is_ok() {
        if expect_quiet(p, "grep -q other " + path).is_err() {
            fail("fold-me-only");
        }
    }
    if expect_quiet(p, "grep -q line-a " + path).is_ok() {
        if expect_quiet(p, "grep -q line-b " + path).is_ok() {
            if expect_quiet(p, "grep -q line-c " + path).is_ok() {
                if expect_quiet(p, "grep -q fold-me " + path).is_ok() {
                    fail("invented join");
                }
            }
        }
    }
}
