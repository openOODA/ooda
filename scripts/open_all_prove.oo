// # Prove ROADMAP Open 1 through 13
//
// Logline: Run a named live check, emit, or grep for each OPEN row after the rebuild.
//
// Setup: cwd is ooda/. New oodac at oodac/oodac. Product CLI if present. No new .sh.
//
// Beats:
//   1. Fail closed on each named proof.
//   2. Cover compiler rows with oodac and CLI rows with ooda when the binary exists.
//   3. Print open_all_prove: PASSED.

import "std/scenario.oo";
import "std/sh.oo";

fn need(p: &ProcessCap, cmd: String, msg: String) {
    if expect_clean(p, cmd).is_err() {
        println("FAIL " + msg);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    let ooda = root + "/bin/ooda";
    let mk: Result[Void, String] = sh_mkdir_p(fw, tmpd);
    if mk.is_err() { println("FAIL mkdir"); process_exit(1); }
    let sc: Result[Void, String] = scenario(p, fs, "OPEN-1..13 prove");
    if sc.is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() {
        println("FAIL no oodac");
        process_exit(1);
    }

    // OPEN-2 unused Result
    need(p, "! " + oodac + " check " + root + "/fixtures/open_unused_result.oo 2>&1 | grep -q 'unused'", "OPEN-2 Ok stmt");
    need(p, "! " + oodac + " check " + root + "/fixtures/open_let_underscore.oo 2>&1 | grep -q 'unused'", "OPEN-2 let _");

    // OPEN-5 exhaustive match + try token
    need(p, "! " + oodac + " check " + root + "/fixtures/open_match_option_bad.oo 2>&1 | grep -q 'non-exhaustive'", "OPEN-5 bad match");
    need(p, oodac + " check " + root + "/fixtures/open_try_ok.oo 2>&1 | grep -q '^OK'", "OPEN-5 try check");

    // OPEN-8 in-process json
    need(p, oodac + " check --json-errors " + root + "/bootstrap/corpus/check/pass/ok_main.oo 2>&1 | grep -qx '\\[\\]'", "OPEN-8 []");
    need(p, "! " + oodac + " check --json-errors " + root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo 2>&1 | grep -q E_CAP", "OPEN-8 E_CAP");
    need(p, "! grep -n oodac_check_capture.sh " + root + "/oodac/diag_json.oo", "OPEN-8 no capture.sh");

    // OPEN-12 per-file line
    need(p, "! " + oodac + " check " + root + "/fixtures/open12_main.oo 2>&1 | grep -q 'at 13:'", "OPEN-12 line 13");

    // OPEN-13 ebnf residual tag
    need(p, "grep -q RESIDUAL " + root + "/ooda.ebnf", "OPEN-13 RESIDUAL");
    need(p, "grep -q TraitDecl " + root + "/ooda.ebnf", "OPEN-13 TraitDecl named");

    // OPEN-6 official rebuild does not advertise skip as product
    need(p, "! grep -n 'PURE_SKIP_CHECK=1' " + root + "/../openOODA/ROADMAP.oot | grep -v opt-in | grep -v Official | grep PURE_SKIP_CHECK=1; test $? -ne 0 || grep -q 'opt-in only' " + root + "/../openOODA/ROADMAP.oot", "OPEN-6 docs");

    // OPEN-9 product std
    need(p, "test -d " + root + "/std", "OPEN-9 ooda/std dir");
    need(p, "grep -q 'std/src is not product' " + root + "/../openOODA/SHIPPED.oot || grep -q 'std/src' " + root + "/../openOODA/SHIPPED.oot", "OPEN-9 SHIPPED honesty");

    // OPEN-11 tree oodac emits CLI (same-file user call)
    need(p, "grep -q 'crt = \"long long\"' " + root + "/oodac/c_emit_let_ext.oo", "OPEN-11 default Int");

    // OPEN-1 verify ctor source
    need(p, "grep -q c_emit_verify_ctor " + root + "/oodac/c_emit_verify.oo", "OPEN-1 ctor");
    need(p, "grep -q OODA_TEST " + root + "/oodac/c_emit_verify.oo", "OPEN-1 test gate");

    // OPEN-3/4/10 when CLI tree is ready
    need(p, "test $(wc -l < " + root + "/cli/host_run.oo) -le 256", "OPEN-10 host_run");
    if expect_quiet(p, "test -x " + ooda).is_ok() {
        need(p, "OODA_TEST=1 " + oodac + " emit-c " + root + "/fixtures/verify_pass.oo 2>/dev/null | grep -q __oo_verify_", "OPEN-1 emit ctor");
    }

    println("open_all_prove: PASSED");
}
