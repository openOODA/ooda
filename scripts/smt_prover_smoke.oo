// # SMT Contract Theorem Prover Smoke Test
//
// Logline: Validates SMT-LIB2 formula generation, Dijkstra weakest precondition derivation, and LIA refutation proving.
//
// Setup: Standalone smoke test verifying compile-time contract decision procedures and counterexample extraction.
//
// Beats:
//   1. Generate SMT-LIB2 QF_LIA S-expressions from relational predicates.
//   2. Derive Dijkstra weakest precondition WP(S, Q) for arithmetic steps.
//   3. Prove theorem validity (UNSAT refutation) for true invariant.
//   4. Detect counterexample (SAT model) for false invariant.
// RULES.oot 1.7: Under 256 lines.

import "ooda/oodac/smt_contract_parse.oo";
import "ooda/oodac/smt_formula_gen.oo";
import "ooda/oodac/smt_wp_calc.oo";
import "ooda/oodac/smt_prover_lia.oo";

pub fn main() {
    println("=== Running SMT Contract Prover Smoke Tests ===");

    // Beat 1: SMT Formula Generation
    let mut decls: List[String] = list_new();
    decls = list_push(decls, "x");
    let mut asserts: List[String] = list_new();
    asserts = list_push(asserts, "(> x 0)");
    let smt_text: String = smt_formula_gen_build(decls, asserts, true);
    if chars_len(smt_text) == 0 {
        println("FAIL: empty SMT-LIB2 text");
        process_exit(1);
    }

    // Beat 2: WP Derivation
    let pre: String = smt_contract_parse_pack("requires", "x", 1, ">", 0, "", 0, "10", "5", false, 0);
    let post: String = smt_contract_parse_pack("ensures", "y", 1, ">", 1, "", 0, "11", "5", false, 0);

    let mut assigns: List[String] = list_new();
    assigns = list_push(assigns, smt_wp_calc_assign_pack("y", "x", 1, 2));

    let wp_cl: String = smt_wp_calc_derive(pre, assigns, post);
    if smt_contract_parse_lhs(wp_cl) != "x" || smt_contract_parse_rhs_const(wp_cl) != -1 {
        println("FAIL: WP calculation mismatch");
        process_exit(1);
    }

    // Beat 3: Valid Theorem (UNSAT refutation)
    let solve_valid: String = smt_prover_lia_prove_clause(pre, wp_cl);
    let valid_ok: Bool = smt_prover_lia_is_valid(solve_valid);
    if !valid_ok {
        println("FAIL: Expected theorem to be proved valid (UNSAT)");
        process_exit(1);
    }

    // Beat 4: Invalid Theorem (SAT Counterexample)
    let bad_post: String = smt_contract_parse_pack("ensures", "z", 1, ">", 100, "", 0, "12", "5", false, 0);

    let mut bad_assigns: List[String] = list_new();
    bad_assigns = list_push(bad_assigns, smt_wp_calc_assign_pack("z", "x", 1, 0));

    let solve_bad: String = smt_prover_lia_prove_vc(pre, bad_assigns, bad_post);
    let bad_ok: Bool = smt_prover_lia_is_valid(solve_bad);
    if bad_ok {
        println("FAIL: Expected invalid theorem to produce SAT counterexample");
        process_exit(1);
    }

    println("smt_prover_smoke: PASSED");
}
