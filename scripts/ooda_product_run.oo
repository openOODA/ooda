// # OODA Product Run
//
// Logline: product `run` engine dispatch — `bc` → oodac run; `native` → oodac build --backend c + exec (fail-closed on bad engine/build); `--` separates program args from ooda flags.
//
// Setup: Process capability and test fixtures available.
//
// Beats: EM resolve | --engine bc|native | file required | native build + exec | rc propagate.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ooda product_run engine dispatch");

    // when "EM resolves to oodac" {
    // and  "--engine bc|native parses; -- separates prog args" {
    // and  "native path: build --backend c then exec with rc propagate" {
    // and  "bad engine → ERR run invalid engine" {
    // then "ooda_product_run PASSED" { } } } }

    expect_present(fs, root + "/scripts/ooda_product_run.sh");
    expect_substring(fs, root + "/scripts/ooda_product_run.sh", "--engine");
    expect_substring(fs, root + "/scripts/ooda_product_run.sh", "native");
    expect_substring(fs, root + "/scripts/ooda_product_run.sh", "build --backend c");
    expect_substring(fs, root + "/scripts/ooda_product_run.sh", "invalid engine");
    expect_clean(p, "test -x " + oodac);
    println("ooda_product_run: PASSED (engine dispatch catalogued)");
}
