// # Unary minus and logic leftover print path and caret
//
// Logline: Cache-cold check of -"hi" and 1 && true shows ERR type, path, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_unary_minus_str.oo prints unary '-' requires number, --> path, and ^.
//   2. tc_logic_int.oo prints logical operator requires Bool, --> path, and ^.
//   3. Exit is non-zero and there is no OK. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/ops_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_unary_minus_str.oo > " + tmpd +
        "/m.out; echo $? > " + tmpd + "/m.ec; true").is_err() {
        fail("check minus");
    }
    if process_exec(p, "grep -q \"unary '-' requires number\" " + tmpd +
        "/m.out && grep -q 'tc_unary_minus_str.oo' " + tmpd +
        "/m.out && grep -Fq -- '-->' " + tmpd + "/m.out && grep -q '\\^' " +
        tmpd + "/m.out && ! grep -qE '^OK' " + tmpd +
        "/m.out && test \"$(cat " + tmpd + "/m.ec)\" -ne 0").is_err() {
        fail("no minus caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_logic_int.oo > " + tmpd +
        "/l.out; echo $? > " + tmpd + "/l.ec; true").is_err() {
        fail("check logic");
    }
    if process_exec(p, "grep -q 'logical operator requires Bool' " + tmpd +
        "/l.out && grep -q 'tc_logic_int.oo' " + tmpd +
        "/l.out && grep -Fq -- '-->' " + tmpd + "/l.out && grep -q '\\^' " +
        tmpd + "/l.out && ! grep -qE '^OK' " + tmpd +
        "/l.out && test \"$(cat " + tmpd + "/l.ec)\" -ne 0").is_err() {
        fail("no logic caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("ops_caret_smoke: PASSED");
}
