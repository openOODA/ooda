// # Cold LLVM hello check without a planted listing
//
// Logline: A side LLVM-linked oodac checks fixtures/hello.oo after the g_ listing files are removed and refuses OK when hello changes.
//
// Setup: cwd is ooda/. Proof ELF is .ooda-cache/ooda-tmp/oodac_llvm, or oodac_stamp if that file is the LLVM ELF.
//
// Beats:
//   1. Pick the LLVM ELF. Require oodac: usage:. Refuse a pure .oo product CLI.
//   2. Delete .ooda-cache/check/g_*. Do not plant with gcc oodac check. ELF check of hello prints OK twice.
//   3. Change hello. Check must not print OK. Restore the fixture.
// residual: C emit plus gcc remains the product path.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let mut elf = tmpd + "/oodac_llvm";
    if process_exec(p, "test -x " + elf).is_err() {
        elf = tmpd + "/oodac_stamp";
    }
    if process_exec(p, "test -x " + elf).is_err() {
        fail("no LLVM ELF oodac_llvm or oodac_stamp");
    }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' " + elf).is_ok() {
        fail("ELF is pure .oo product CLI");
    }
    if process_exec(p, "grep -a -q 'oodac: usage:' " + elf).is_err() {
        fail("ELF missing oodac: usage:");
    }

    // Cold listing: drop g_* first. Do not run gcc oodac check to plant.
    if process_exec(p, "rm -f .ooda-cache/check/g_*").is_err() {
        fail("rm g_ listing");
    }
    if process_exec(p, "timeout 60 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'").is_err() {
        fail("cold check hello");
    }
    if process_exec(p, "timeout 60 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'").is_err() {
        fail("second check hello");
    }

    let bak = tmpd + "/hello_open53.bak";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "cp fixtures/hello.oo " + bak).is_err() { fail("bak"); }
    if process_exec(p, "printf '\\nfn bad() { let x: Int = \"no\"; }\\n' >> fixtures/hello.oo").is_err() {
        let _r1 = process_exec(p, "cp " + bak + " fixtures/hello.oo");
        fail("mutate hello");
    }
    let stale_ok = process_exec(p, "timeout 60 " + elf + " check fixtures/hello.oo 2>&1 | grep -qE '^OK'");
    if process_exec(p, "cp " + bak + " fixtures/hello.oo").is_err() { fail("restore hello"); }
    if stale_ok.is_ok() { fail("changed hello still OK"); }

    println("open53_cold_hello_smoke: PASSED");
}
