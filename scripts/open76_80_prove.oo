// # Prove OPEN-76 through OPEN-80 emit gcc run
//
// Logline: Emit C, compile with gcc, and run the five product fixtures.
//
// Setup: cwd is ooda/. oodac/oodac and runtime/chs_rt.c exist.
//
// Beats:
//   1. Emit and gcc each named fixture.
//   2. Run and require the PASSED needle.
//   3. Prove org std/prove_open80.oo the same way.

import "std/scenario.oo";
import "std/sh.oo";

fn one(p: &ProcessCap, fs: &FsReadCap, root: String, tmpd: String, oodac: String, srcp: String, tag: String, needle: String) {
    let c: String = tmpd + "/" + tag + ".c";
    let bin: String = tmpd + "/" + tag + ".bin";
    if expect_present(fs, srcp).is_err() {
        println("FAIL missing " + srcp);
        process_exit(1);
    }
    if check(p, oodac + " emit-c " + srcp + " > " + c + " 2> " + tmpd + "/" + tag + ".err", within: 30).is_err() {
        println("FAIL emit " + tag);
        process_exit(1);
    }
    if expect_clean(p, "grep -q 'main(' " + c).is_err() {
        println("FAIL no main in " + tag);
        process_exit(1);
    }
    if expect_clean(p, "! grep -qE '^ERR\\tc_emit' " + c).is_err() {
        println("FAIL emit ERR " + tag);
        process_exit(1);
    }
    let gcc: String = "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + c + " -o " + bin + " -lm";
    if check(p, gcc, within: 30).is_err() {
        println("FAIL gcc " + tag);
        process_exit(1);
    }
    if expect_clean(p, bin + " 2>&1 | grep -q " + needle).is_err() {
        println("FAIL run " + tag);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "OPEN-76..80 emit gcc run").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() {
        println("FAIL no oodac");
        process_exit(1);
    }
    one(p, fs, root, tmpd, oodac, root + "/fixtures/open76_fd_stream.oo", "open76", "'open76: PASSED'");
    one(p, fs, root, tmpd, oodac, root + "/fixtures/open77_aes.oo", "open77", "'open77: PASSED'");
    one(p, fs, root, tmpd, oodac, root + "/fixtures/open78_base64.oo", "open78", "'open78: PASSED'");
    one(p, fs, root, tmpd, oodac, root + "/fixtures/open79_regex_dfa.oo", "open79", "'open79: PASSED'");
    one(p, fs, root, tmpd, oodac, root + "/../std/prove_open80.oo", "open80", "'open80: PASSED'");
    println("open76_80_prove: PASSED");
}
