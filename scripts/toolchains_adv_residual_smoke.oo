// # Toolchains Adv Residual Stays Honest
// Logline: bootstrap/TOOLCHAINS_ADV.oot and marker fixture stay on the residual rail.
// Setup: bootstrap/TOOLCHAINS_ADV.oot and fixtures/toolchains_marker.oo on disk.
// Beats: 1. doc marker present | 2. no shipped-without-residual claim | 3. ci_product wire intact

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let doc   = root + "/bootstrap/TOOLCHAINS_ADV.oot";
    let fix   = root + "/fixtures/toolchains_marker.oo";
    let label = "toolchains_adv_residual_smoke";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — doc present + marker
    fails = fails + tally(expect_present(p, doc),                                              "doc exists");
    fails = fails + tally(expect_quiet(p, "grep -q TOOLCHAINS_ADV_RESIDUAL_ALPHA " + doc),     "doc marker TOOLCHAINS_ADV_RESIDUAL_ALPHA");
    fails = fails + tally(expect_quiet(p, "grep -qiE 'fail-closed residual' " + doc),          "fail-closed residual wording");

    // and — fixture + marker line
    fails = fails + tally(expect_present(p, fix),                                              "fixture exists");
    fails = fails + tally(expect_quiet(p, "grep -q 'TOOLCHAINS: residual' " + fix),            "fixture marker line");

    // then — ban shipped-without-residual claim + ci wire
    let claim = "grep -nEi 'fully shipped|enforced in product|sandbox is live' " + doc + " 2>/dev/null | grep -viE 'not |residual|do not|never|no '";
    fails    = fails + tally(expect_quiet(p, "test -z \"$(" + claim + ")\""),                  "no shipped-without-residual claim");

    let dual = "grep -rn --include='*.oot' -E 'shipped as enforced|fully sealed shipped' " + root + "/bootstrap 2>/dev/null | grep -v TOOLCHAINS_ADV.oot | grep -vi residual | head -5 || true";
    fails   = fails + tally(expect_quiet(p, "test -z \"$(" + dual + ")\""),                    "no dual-claim on residual surface");

    fails = fails + tally(expect_quiet(p, "grep -q '" + label + "' " + root + "/scripts/ci_product.sh"), "ci_product wire");

    if fails > 0 { println(label + ": FAILED"); process_exit(1); }
    println(label + ": PASSED");
}
