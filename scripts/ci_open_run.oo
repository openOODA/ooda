// # Named emit, gcc, and run set
//
// Logline: Emit C, compile with gcc, and run a named fixture set. Check-only is not this proof.
//
// Setup: cwd is ooda/. oodac/oodac and runtime/chs_rt.c exist.
//
// Beats:
//   1. Emit hello, int_main, and open_ci_add.
//   2. gcc each translation unit against chs_rt.c.
//   3. Run the binaries and require the expected output.

import "std/scenario.oo";
import "std/sh.oo";

fn one(p: &ProcessCap, fs: &FsReadCap, root: String, tmpd: String, oodac: String, src: String, needle: String) {
    let base: String = src;
    let c: String = tmpd + "/" + base + ".c";
    let bin: String = tmpd + "/" + base + ".bin";
    let srcp: String = root + "/fixtures/" + src + ".oo";
    if expect_present(fs, srcp).is_err() {
        println("FAIL missing " + srcp);
        process_exit(1);
    }
    if check(p, oodac + " emit-c " + srcp + " > " + c + " 2> " + tmpd + "/" + base + ".err", within: 30).is_err() {
        println("FAIL emit " + src);
        process_exit(1);
    }
    if expect_clean(p, "grep -q 'main(' " + c).is_err() {
        println("FAIL no main in " + src);
        process_exit(1);
    }
    if expect_clean(p, "! grep -qE '^ERR\\tc_emit' " + c).is_err() {
        println("FAIL emit ERR " + src);
        process_exit(1);
    }
    let gcc: String = "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + c + " -o " + bin + " -lm";
    if check(p, gcc, within: 30).is_err() {
        println("FAIL gcc " + src);
        process_exit(1);
    }
    if expect_clean(p, bin + " 2>&1 | grep -q " + needle).is_err() {
        println("FAIL run " + src);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    let mk: Result[Void, String] = sh_mkdir_p(fw, tmpd);
    if mk.is_err() { println("FAIL mkdir"); process_exit(1); }
    let sc: Result[Void, String] = scenario(p, fs, "ci_open_run emit gcc run");
    if sc.is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() {
        println("FAIL no oodac");
        process_exit(1);
    }
    one(p, fs, root, tmpd, oodac, "hello", "Hello");
    one(p, fs, root, tmpd, oodac, "int_main", "42");
    one(p, fs, root, tmpd, oodac, "open_ci_add", "5");
    println("ci_open_run: PASSED");
}
