// # List Index Path A Smoke
//
// Logline: M166 path A — list_get/product + index_get alias + LBRACKET sugar wire up to oo_ilist_get and run six-line product (10 20 30 10 20 30).
//
// Setup: Process capability and test fixtures available.
// Beats: source floor | list_get product | index sugar check | emit list_index | runtime six lines.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = "ooda/fixtures/list_index.oo";
const C_GET: String = ".ooda-cache/ooda-tmp/li_get.c";
const C_LI: String = ".ooda-cache/ooda-tmp/li.c";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "list index path A: list_get + index_get + LBRACKET");

    // when: source floor — index sugar + index_get + arity seed
    expect_clean(p, "grep -q 'c_emit_index_get' " + root + "/oodac/c_emit_call.oo");
    expect_clean(p, "grep -q 'LBRACKET' " + root + "/oodac/c_emit_lower.oo");
    expect_clean(p, "grep -q 'index_get' " + root + "/oodac/tc_names.oo");
    expect_clean(p, "grep -q 'index_get=2' " + root + "/oodac/tc_call_arity.oo");

    // and: list_get-only fixture emits oo_ilist_get and runs as 42
    let _ = process_exec(p, "cat > " + tmp + "/li_get.oo <<'EOF'\npub fn main() {\n    let mut xs: List[Int] = list_new();\n    xs = list_push(xs, 42);\n    println(list_get(xs, 0));\n}\nEOF");
    let _ = process_exec(p, oodac + " emit-c " + tmp + "/li_get.oo > " + tmp + "/li_get.c 2>/dev/null");
    expect_substring(fs, tmp + "/li_get.c", "oo_ilist_get");
    let _ = sh_mkdir_p(fw, tmp);
    let _ = process_exec(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + tmp + "/li_get.c -o " + tmp + "/li_get.bin -lm 2>/dev/null");
    expect_clean(p, tmp + "/li_get.bin 2>&1 | grep -qx '42'");

    // then: full fixture emits oo_ilist_get and runs six lines
    expect_present(fs, FIX);
    check(p, oodac + " emit-c " + FIX + " > " + tmp + "/li.c 2>/dev/null", within: 30);
    expect_clean(p, "! grep -qE $'^ERR\\t' " + tmp + "/li.c");
    expect_substring(fs, tmp + "/li.c", "oo_ilist_get");
    expect_clean(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + tmp + "/li.c -o " + tmp + "/li.bin -lm 2>/dev/null");
    expect_clean(p, tmp + "/li.bin 2>&1 | tr '\\n' ' ' | grep -qE '10.*20.*30.*10.*20.*30'");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "list_index_path_a_smoke");
    println("list_index_path_a_smoke: PASSED");
}
