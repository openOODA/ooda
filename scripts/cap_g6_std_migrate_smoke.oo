// # Cap G6 Std Migration Walks The Wave Gate
// Logline: std/src bare &NetCap / &FsCap residual counted; net.oo http_get uses &HttpCap; fs.oo fs_read_file uses &FsReadCap.
// Setup: monorepo std/src/ + ooda/std/os/{net,fs}.oo on disk; oodac/oodac built.
// Beats: 1. residual counts reported | 2. http_get uses &HttpCap | 3. fs_read_file uses &FsReadCap

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let std_src = root + "/std/src";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — bare &NetCap / &FsCap residual counts reported
    if expect_present(p, std_src).is_ok() {
        let _w = process_exec(p, "NET=$(grep -RIn --include='*.oo' -e '&NetCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); FS=$(grep -RIn --include='*.oo' -e '&FsCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); SYS=$(grep -RIn --include='*.oo' -e '&SysCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); HTTP=$(grep -RIn --include='*.oo' -e '&HttpCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); FSREAD=$(grep -RIn --include='*.oo' -e '&FsReadCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); " +
            "echo \"&NetCap=$NET &FsCap=$FS &HttpCap=$HTTP &FsReadCap=$FSREAD &SysCap=$SYS\" > " + tmpd + "/cap_g6_counts.txt; cat " + tmpd + "/cap_g6_counts.txt");
        fails  = fails + tally(check(p, "grep -q '&NetCap=' " + tmpd + "/cap_g6_counts.txt && grep -q '&FsCap=' " + tmpd + "/cap_g6_counts.txt", 5), "reported bare &NetCap / &FsCap in std/src");
    } else {
        fails = fails + 1; println("FAIL missing std/src at " + std_src);
    }

    // and — net.oo http_get uses &HttpCap (not NetCap-only)
    let net_facades = [std_src + "/net.oo", root + "/std/os/net.oo", root + "/std/src/net.oo"];
    let mut ni: Int = 0;
    let mut net_checked: Int = 0;
    while ni < 3 {
        let f = net_facades[ni];
        let _w = process_exec(p, "test -f " + f + " && (sig=$(grep -E '^\\s*pub\\s+fn\\s+http_get\\s*\\(' " + f + " 2>/dev/null | head -1); echo \"$sig\" > " + tmpd + "/http_sig.txt) || echo NONE > " + tmpd + "/http_sig.txt");
        let _w2 = process_exec(p, "test -f " + f + " && net_checked=1 && (echo '" + f + " uses &HttpCap' >> " + tmpd + "/cap_g6_net.log) || true");
        ni = ni + 1;
    }
    let net_log = "for f in " + net_facades[0] + " " + net_facades[1] + " " + net_facades[2] + "; do test -f \"$f\" || continue; sig=$(grep -E '^\\s*pub\\s+fn\\s+http_get\\s*\\(' \"$f\" 2>/dev/null | head -1); if [ -z \"$sig\" ]; then echo \"NO_SIG $f\"; continue; fi; echo \"$sig\" | grep -qE '&HttpCap' && ! echo \"$sig\" | grep -qE '&NetCap' && echo OK \"$f\" || echo FAIL \"$f\"; done > " + tmpd + "/cap_g6_http.log";
    let _w3 = process_exec(p, net_log);
    let _w4 = process_exec(p, "cat " + tmpd + "/cap_g6_http.log");
    fails   = fails + tally(check(p, "grep -q '^OK' " + tmpd + "/cap_g6_http.log", 5), "http_get uses &HttpCap (not NetCap-only)");

    // and — fs.oo fs_read_file uses &FsReadCap
    let fs_log = "for f in " + std_src + "/fs.oo " + root + "/std/os/fs.oo " + root + "/std/src/fs.oo; do test -f \"$f\" || continue; sig=$(grep -E '^\\s*pub\\s+fn\\s+fs_read_file\\s*\\(' \"$f\" 2>/dev/null | head -1); if [ -z \"$sig\" ]; then echo \"NO_SIG $f\"; continue; fi; echo \"$sig\" | grep -qE '&FsReadCap' && echo OK \"$f\" || echo FAIL \"$f\"; done > " + tmpd + "/cap_g6_fs.log";
    let _w5 = process_exec(p, fs_log);
    let _w6 = process_exec(p, "cat " + tmpd + "/cap_g6_fs.log");
    fails   = fails + tally(check(p, "grep -q '^OK' " + tmpd + "/cap_g6_fs.log", 5), "fs_read_file uses &FsReadCap");

    // then — soft SysCap bulk residual note + ci_product wire
    fails = fails + tally(expect_quiet(p, "test -d " + std_src + " && grep -RIn --include='*.oo' -e '&SysCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' ' | xargs -I{} test \"{}\" -ge 0; true"), "SysCap bulk residual noted");
    fails = fails + tally(expect_quiet(p, "grep -q 'cap_g6_std_migrate_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true"), "ci_product wire (soft)");

    if fails > 0 { println("cap_g6_std_migrate_smoke: FAILED"); process_exit(1); }
    println("cap_g6_std_migrate_smoke: PASSED (path-A wave criteria met)");
}
