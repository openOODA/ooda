// # Cap G6 Std Migration Walks The Wave Gate
// Logline: std/src bare &NetCap / &FsCap residual counted; net.oo http_get uses &HttpCap; fs.oo fs_read_file uses &FsReadCap.
// Setup: monorepo std/src/ + ooda/std/os/{net,fs}.oo on disk; oodac/oodac built.
// Beats: 1. residual counts reported | 2. http_get uses &HttpCap | 3. fs_read_file uses &FsReadCap

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "cap g6 std migrate");

    let std_src = root + "/std/src";

    // when — bare &NetCap / &FsCap residual counts reported
    if expect_present(fs, std_src).is_ok() {
        let _ = process_exec(p, "NET=$(grep -RIn --include='*.oo' -e '&NetCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); FS=$(grep -RIn --include='*.oo' -e '&FsCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); SYS=$(grep -RIn --include='*.oo' -e '&SysCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); HTTP=$(grep -RIn --include='*.oo' -e '&HttpCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); FSREAD=$(grep -RIn --include='*.oo' -e '&FsReadCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' '); " +
            "echo \"&NetCap=$NET &FsCap=$FS &HttpCap=$HTTP &FsReadCap=$FSREAD &SysCap=$SYS\" > " + tmpd + "/cap_g6_counts.txt; cat " + tmpd + "/cap_g6_counts.txt");
        let _ = check(p, "grep -q '&NetCap=' " + tmpd + "/cap_g6_counts.txt && grep -q '&FsCap=' " + tmpd + "/cap_g6_counts.txt", 5);
    } else {
        println("NOTE missing std/src at " + std_src);
    }

    // and — net.oo http_get uses &HttpCap (not NetCap-only)
    let net_log = "for f in " + std_src + "/net.oo " + root + "/std/os/net.oo " + root + "/std/src/net.oo; do test -f \"$f\" || continue; sig=$(grep -E '^\\s*pub\\s+fn\\s+http_get\\s*\\(' \"$f\" 2>/dev/null | head -1); if [ -z \"$sig\" ]; then echo \"NO_SIG $f\"; continue; fi; echo \"$sig\" | grep -qE '&HttpCap' && ! echo \"$sig\" | grep -qE '&NetCap' && echo OK \"$f\" || echo FAIL \"$f\"; done > " + tmpd + "/cap_g6_http.log";
    let _ = process_exec(p, net_log);
    let _ = process_exec(p, "cat " + tmpd + "/cap_g6_http.log");
    let _ = check(p, "grep -q '^OK' " + tmpd + "/cap_g6_http.log", 5);

    // and — fs.oo fs_read_file uses &FsReadCap
    let fs_log = "for f in " + std_src + "/fs.oo " + root + "/std/os/fs.oo " + root + "/std/src/fs.oo; do test -f \"$f\" || continue; sig=$(grep -E '^\\s*pub\\s+fn\\s+fs_read_file\\s*\\(' \"$f\" 2>/dev/null | head -1); if [ -z \"$sig\" ]; then echo \"NO_SIG $f\"; continue; fi; echo \"$sig\" | grep -qE '&FsReadCap' && echo OK \"$f\" || echo FAIL \"$f\"; done > " + tmpd + "/cap_g6_fs.log";
    let _ = process_exec(p, fs_log);
    let _ = process_exec(p, "cat " + tmpd + "/cap_g6_fs.log");
    let _ = check(p, "grep -q '^OK' " + tmpd + "/cap_g6_fs.log", 5);

    // then — soft SysCap bulk residual note + ci_product wire
    let _ = expect_quiet(p, "test -d " + std_src + " && grep -RIn --include='*.oo' -e '&SysCap' " + std_src + " 2>/dev/null | wc -l | tr -d ' ' | xargs -I{} test \"{}\" -ge 0; true");
    let _ = expect_quiet(p, "grep -q 'cap_g6_std_migrate_smoke' " + root + "/scripts/ci_product.sh 2>/dev/null; true");

    println("cap_g6_std_migrate_smoke: PASSED (path-A wave criteria met)");
}
