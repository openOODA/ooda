// # Dedicated Sovereign CLI Suite Smoke Test
//
// Logline: End-to-end verification of declarative command parsing, ANSI styling, interactive prompts, and shell completion.
//
// Setup: Validates openOODA std/cli capabilities on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify command hierarchy, option registration, token parsing, and flag/int value extraction.
//   2. Verify interactive prompt formatters and response parsers.
//   3. Verify ANSI 16-color, 256-color, TrueColor RGB styling, and box frame layouts.
//   4. Verify dynamic Bash, Zsh, and Fish completion generation.

import "std/cli/cli_arg_parser.oo";
import "std/cli/cli_style.oo";
import "std/cli/cli_prompt.oo";
import "std/cli/cli_completion.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA CLI Suite Dedicated Integration Smoke");
    println("===================================================================");

    // 1. Declarative CLI Parser & Token Analysis
    let mut root_cmd: CliCommand = cli_command_new("ooda", "v1.0.0", "openOODA Sovereign Compiler");
    let opt_v: CliOption = cli_option_flag("v", "verbose", "Enable verbose diagnostics");
    let opt_p: CliOption = cli_option_value("p", "port", "HTTP listen port", "8080", false);
    cli_command_add_option(&mut root_cmd, opt_v);
    cli_command_add_option(&mut root_cmd, opt_p);

    let mut sub_build: CliCommand = cli_command_new("build", "v1.0.0", "Build project target");
    let pos_target: CliPositional = cli_positional_new("target", "Target file path", true, "");
    cli_command_add_positional(&mut sub_build, pos_target);
    cli_command_add_subcommand(&mut root_cmd, sub_build);

    let mut test_args: List[String] = list_new();
    test_args = list_push(test_args, "--verbose");
    test_args = list_push(test_args, "build");
    test_args = list_push(test_args, "main.oo");

    let parse_res: Result[CliParsedArgs, String] = cli_parse(&root_cmd, test_args);
    match parse_res {
        Ok(parsed) => {
            let has_v: Bool = cli_args_has_flag(parsed, "verbose");
            let pos0: String = cli_args_get_pos_or(parsed, 0, "");
            let pos1: String = cli_args_get_pos_or(parsed, 1, "");
            if !has_v || pos0 != "build" || pos1 != "main.oo" {
                println("FAIL: CLI argument parsing verification failed");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL: Unexpected CLI parse error: " + e);
            process_exit(1);
        }
    }
    println("  [PASS] 1. Declarative Command Parsing & Token Evaluation");

    // 2. Interactive Prompts
    let p_txt: String = cli_prompt_text_format("Enter username", "admin");
    let p_conf_yes: Bool = cli_prompt_parse_confirm("y", false);
    let p_conf_no: Bool = cli_prompt_parse_confirm("no", true);
    let p_sel: Result[Int, String] = cli_prompt_parse_select("2", 4);

    let mut sel_ok: Bool = false;
    match p_sel {
        Ok(idx) => { if idx == 1 { sel_ok = true; } }
        Err(e) => { sel_ok = false; }
    }

    if p_txt == "" || !p_conf_yes || p_conf_no || !sel_ok {
        println("FAIL: CLI prompt engine verification failed");
        process_exit(1);
    }
    println("  [PASS] 2. Interactive Prompts & Response Validation");

    // 3. ANSI Styling & Layout Engine
    let c_rgb: CliColor = cli_color_rgb(100, 200, 50);
    let mut style_rich: CliTextStyle = cli_style_new();
    style_rich = cli_style_fg(style_rich, c_rgb);
    style_rich = cli_style_bold(style_rich, true);
    let styled_str: String = cli_style_apply(style_rich, "SOVEREIGN_SYSTEMS");
    let pad_str: String = cli_style_pad_left("42", 5);
    let div_str: String = cli_style_divider(10, "=");

    if styled_str == "" || pad_str != "   42" || div_str != "==========" {
        println("FAIL: CLI styling & layout verification failed");
        process_exit(1);
    }
    println("  [PASS] 3. 24-Bit TrueColor ANSI Styling & Layout Dividers");

    // 4. Shell Completion Generation
    let comp_gen: CliCompletionGenerator = cli_completion_generator_new("ooda", "build test", "--verbose --port");
    let bash_script: String = cli_completion_render_bash(comp_gen);
    let zsh_script: String = cli_completion_render_zsh(comp_gen);
    let fish_script: String = cli_completion_render_fish(comp_gen);

    if bash_script == "" || zsh_script == "" || fish_script == "" {
        println("FAIL: Shell completion generation failed");
        process_exit(1);
    }
    println("  [PASS] 4. Multi-Shell Completion Generation (Bash, Zsh, Fish)");

    println("cli_suite_smoke: PASSED");
}
