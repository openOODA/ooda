// # Parse unexpected prints path and caret
//
// Logline: Check of a top-level INT prints ERR parse unexpected, path:line:col, the line, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac. Run the same check twice.
//
// Beats:
//   1. parse_unexp.oo prints ERR parse unexpected, -->, the digit, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. A second check writes the same marks.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/parse_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/parse_unexp.oo > " + tmpd +
        "/a.out; echo $? > " + tmpd + "/a.ec; true").is_err() {
        fail("check a");
    }
    if process_exec(p, oodac + " check fixtures/parse_unexp.oo > " + tmpd +
        "/b.out; echo $? > " + tmpd + "/b.ec; true").is_err() {
        fail("check b");
    }
    if process_exec(p, "grep -q $'ERR\\tparse\\tunexpected' " + tmpd +
        "/a.out && grep -Fq -- '-->' " + tmpd + "/a.out && grep -q 'parse_unexp.oo' " +
        tmpd + "/a.out && grep -q ':' " + tmpd + "/a.out && grep -q '1' " +
        tmpd + "/a.out && grep -q '\\^' " + tmpd +
        "/a.out && ! grep -qE '^OK' " + tmpd +
        "/a.out && test \"$(cat " + tmpd + "/a.ec)\" -ne 0").is_err() {
        fail("no parse caret");
    }
    if process_exec(p, "grep -q $'ERR\\tparse\\tunexpected' " + tmpd +
        "/b.out && grep -Fq -- '-->' " + tmpd + "/b.out && grep -q '\\^' " +
        tmpd + "/b.out && ! grep -qE '^OK' " + tmpd +
        "/b.out && test \"$(cat " + tmpd + "/b.ec)\" -ne 0 && cmp -s " +
        tmpd + "/a.out " + tmpd + "/b.out").is_err() {
        fail("second disagree");
    }
    println("parse_caret_smoke: PASSED");
}
