// # Std Archive Magic-Detect Walks The Pure Path
// Logline: tar/zip/gzip check + honesty residual marker + multi-build fixture prints tar/zip/gzip/not-tar detected.
// Setup: oodac + std/archive/{tar,zip,gzip}.oo + fixtures/std_archive_main.oo + gcc on disk.
// Beats: 1. check each module | 2. honesty residual marker | 3. build + run fixture magic-detect

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd: String = ".ooda-cache/ooda-tmp/std_archive";
    let oodac: String = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { process_exit(1); }
    if scenario(p, fs, "std archive").is_err() { process_exit(1); }

    // when — check tar/zip/gzip modules
    let mut i: Int = 0;
    let mut mods: List[String] = list_new();
    mods = list_push(mods, "tar.oo");
    mods = list_push(mods, "zip.oo");
    mods = list_push(mods, "gzip.oo");
    while i < 3 {
        let m: String = list_get(mods, i);
        if process_exec(p, oodac + " check std/archive/" + m + " > " + tmpd + "/arch_ck_" + m + ".out 2> " + tmpd + "/arch_ck_" + m + ".err; echo rc=$? >> " + tmpd + "/arch_ck_" + m + ".out").is_err() { process_exit(1); }
        if check(p, "tail -1 " + tmpd + "/arch_ck_" + m + ".out | grep -q 'rc=0'", 5).is_err() { process_exit(1); }
        i = i + 1;
    }

    // and — honesty residual: no forbidden decompress claims + residual marker present
    i = 0;
    while i < 3 {
        let m: String = list_get(mods, i);
        let f: String = "std/archive/" + m;
        if expect_clean(p, "! grep -qiE 'stub_decompressed|full decompress|DESIGN.?done' " + f).is_err() { process_exit(1); }
        if expect_quiet(p, "grep -qiE 'decompress NOT product|full tar|full zip|full gzip' " + f).is_err() { process_exit(1); }
        i = i + 1;
    }

    // then — build + run fixture (tar/zip/gzip-detected + not-tar)
    let fix: String = "fixtures/std_archive_main.oo";
    let bin: String = tmpd + "/std_archive_main";
    if process_exec(p, "OODAC_BIN='" + oodac + "' " + oodac + " build " + fix + " " + bin + " > " + tmpd + "/arch_b.out 2> " + tmpd + "/arch_b.err").is_err() { process_exit(1); }
    if process_exec(p, "(" + bin + "; echo rc=$?) > " + tmpd + "/arch_r.out 2>&1").is_err() { process_exit(1); }
    if check(p, "tail -1 " + tmpd + "/arch_r.out | grep -q 'rc=0' && grep -q 'tar-detected' " + tmpd + "/arch_r.out && grep -q 'zip-detected' " + tmpd + "/arch_r.out && grep -q 'gzip-detected' " + tmpd + "/arch_r.out && grep -q 'not-tar' " + tmpd + "/arch_r.out", 5).is_err() { process_exit(1); }

    println("std_archive_smoke: PASSED");
}
