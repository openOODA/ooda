// # Std Archive Magic-Detect Walks The Pure Path
// Logline: tar/zip/gzip check + honesty residual marker + multi-build fixture prints tar/zip/gzip/not-tar detected.
// Setup: oodac + std/archive/{tar,zip,gzip}.oo + fixtures/std_archive_main.oo + gcc on disk.
// Beats: 1. check each module | 2. honesty residual marker | 3. build + run fixture magic-detect

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "std archive");

    // when — check tar/zip/gzip modules
    let mut i: Int = 0;
    let mods = ["tar.oo", "zip.oo", "gzip.oo"];
    while i < 3 {
        let m = mods[i];
        let _ = process_exec(p, oodac + " check " + root + "/std/archive/" + m + " > " + tmpd + "/arch_ck_" + m + ".out 2> " + tmpd + "/arch_ck_" + m + ".err; echo rc=$? >> " + tmpd + "/arch_ck_" + m + ".out");
        let _ = check(p, "tail -1 " + tmpd + "/arch_ck_" + m + ".out | grep -q 'rc=0'", 5);
        i = i + 1;
    }

    // and — honesty residual: no forbidden decompress claims + residual marker present
    i = 0;
    while i < 3 {
        let m = mods[i];
        let f = root + "/std/archive/" + m;
        let _ = expect_clean(p, "grep -qiE 'stub_decompressed|full decompress|DESIGN.?done' " + f);
        let _ = expect_quiet(p, "grep -qiE 'decompress NOT product|full tar|full zip|full gzip' " + f);
        i = i + 1;
    }

    // then — build + run fixture (tar/zip/gzip-detected + not-tar)
    let fix = root + "/fixtures/std_archive_main.oo";
    let bin = tmpd + "/std_archive_main";
    let _ = process_exec(p, "OODAC_BIN='" + oodac + "' " + oodac + " build " + fix + " " + bin + " > " + tmpd + "/arch_b.out 2> " + tmpd + "/arch_b.err");
    let _ = process_exec(p, "(" + bin + "; echo rc=$?) > " + tmpd + "/arch_r.out 2>&1");
    let _ = check(p, "tail -1 " + tmpd + "/arch_r.out | grep -q 'rc=0' && grep -q 'tar-detected' " + tmpd + "/arch_r.out && grep -q 'zip-detected' " + tmpd + "/arch_r.out && grep -q 'gzip-detected' " + tmpd + "/arch_r.out && grep -q 'not-tar' " + tmpd + "/arch_r.out", 5);

    println("std_archive_smoke: PASSED");
}
