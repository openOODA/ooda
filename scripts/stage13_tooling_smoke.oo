// # Master Smoke Test for Stage 13 Package Ecosystem & Developer Tooling
//
// Logline: Comprehensive end-to-end verification of all Stage 13 developer tooling capabilities.
//
// Setup: Invokes registry bot, min_pin guardrail, code generator, migrations, and LSP engine.
//
// Beats:
//   1. Verify min_pin compatibility guardrails (v0.208.0).
//   2. Verify ooda gen code generation (module, service, test).
//   3. Verify reversible database schema migrations (up, redo, rollback, status JSON).
//   4. Verify package registry verification bot.
//   5. Verify LSP server lifecycle, completions, hover, definition, and quick-fix actions.

import "cli/cmd_gen.oo";
import "cli/cmd_pm_bot.oo";
import "cli/pm_pin.oo";
import "lsp/lsp_server.oo";
import "lsp/lsp_code_action.oo";
import "std/database/migration_types.oo";
import "std/database/migration_runner.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main(fs: &FsCap, sys: &SysCap) {
    println("=== Running Stage 13 Developer Tooling Master Smoke Harness ===");

    // 1. Deliverable 2: Toolchain min_pin Guardrail
    if !pm_pin_min_ok("v0.208.0", "0.208.0") {
        fail_smoke("min_pin v0.208.0 should be compatible with 0.208.0");
    }
    if pm_pin_min_ok("v0.208.0", "0.208.0") {
        fail_smoke("min_pin v0.208.0 should be rejected by 0.208.0");
    }
    println("  [1/5] Toolchain min_pin Guardrail: OK");

    // 2. Deliverable 3: Ruby on Rails-Style ooda gen Scaffolding
    let mod_tmpl: String = cmd_gen_template("module", "AuthEngine");
    if str_index_of(mod_tmpl, "AuthEngine") < 0 || str_index_of(mod_tmpl, "AuthEngine_new") < 0 {
        fail_smoke("ooda gen module template missing headers or new function");
    }
    let svc_tmpl: String = cmd_gen_template("service", "PaymentGateway");
    if str_index_of(svc_tmpl, "PaymentGateway") < 0 || str_index_of(svc_tmpl, "PaymentGateway_service_create") < 0 {
        fail_smoke("ooda gen service template invalid");
    }
    let tst_tmpl: String = cmd_gen_template("test", "UserAuth");
    if str_index_of(tst_tmpl, "UserAuth_SMOKE_PASSED") < 0 {
        fail_smoke("ooda gen test template invalid");
    }
    println("  [2/5] ooda gen Scaffolding Engine: OK");

    // 3. Deliverable 4: Reversible Database Schema Migrations Engine
    let test_journal: String = ".ooda-cache/stage13_mig_journal.txt";
    let cr0: Result[String, String] = sys_exec(sys, "sh", "-c", "rm -rf .ooda-cache/stage13_mig_journal.txt");
    if cr0.is_err() { fail_smoke("failed to clear test journal"); }

    let mut m_state: MigrationState = migration_runner_init(fs, test_journal);
    let step1: MigrationStep = migration_types_step("1", "create_table", "SELECT * FROM t;", "SELECT * FROM t;");
    let res_up: MigrationResult = migration_apply_up(fs, sys, &mut m_state, step1);
    if !migration_result_is_ok(&res_up) {
        fail_smoke("migration up failed: " + migration_result_msg(&res_up));
    }
    if migration_state_cnt(&m_state) != 1 {
        fail_smoke("migration state count mismatch after up");
    }
    let res_redo: MigrationResult = migration_redo(fs, sys, &mut m_state, step1);
    if !migration_result_is_ok(&res_redo) {
        fail_smoke("migration redo failed");
    }
    let res_down: MigrationResult = migration_rollback(fs, sys, &mut m_state, step1);
    if !migration_result_is_ok(&res_down) {
        fail_smoke("migration rollback failed");
    }
    if migration_state_cnt(&m_state) != 0 {
        fail_smoke("migration state count should be 0 after rollback");
    }
    println("  [3/5] Reversible Database Schema Migrations: OK");

    // 4. Deliverable 1: Package Registry Verification Bot
    let mut reg_dir: String = "../registry";
    if !path_exists(fs, reg_dir) { reg_dir = "registry"; }
    let v_hello: String = cmd_pm_bot_verify(fs, sys, reg_dir, "hello");
    if str_slice(v_hello, 0, 3) != "ok|" {
        fail_smoke("registry bot verification of hello failed: " + v_hello);
    }
    println("  [4/5] Live Verified Package Registry Bot: OK");

    // 5. Deliverables 6 & 7: Full LSP Server & Quick Fixes
    let init_req: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///tmp\"}}";
    let init_resp: String = lsp_server_process_message(init_req);
    if str_index_of(init_resp, "\"codeActionProvider\":true") < 0 {
        fail_smoke("LSP server initialize missing codeActionProvider");
    }
    let ca_req: String = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/codeAction\",\"params\":{\"uri\":\"file:///test.oo\",\"code\":\"E_CAP\"}}";
    let ca_resp: String = lsp_server_process_message(ca_req);
    if str_index_of(ca_resp, "Fix: Add required &Cap parameter") < 0 {
        fail_smoke("LSP quick fix missing E_CAP action: " + ca_resp);
    }
    println("  [5/5] Full LSP Server & Code Action Engine: OK");

    println("OK: STAGE13_TOOLING_SMOKE_PASSED");
}
