// # HITL Residual Smoke
//
// Logline: M24 HITL residual honesty — no interactive harness / not agent pause-resume; doc carries residual marker and explicit denial; no false "shipped/enforced" claim in bootstrap residual surface.
// Setup: bootstrap/HITL.oot + fixtures/hitl_marker.oo present.
//
// Beats: doc + marker | explicit interactive-HITL denial | agent pause/resume denial | fail-closed residual wording | fixture marker | no false shipped claim | fixture marker present.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "M24 HITL residual honesty");

    expect_present(fs, root + "/" + "ooda/bootstrap/HITL.oot");
    expect_present(fs, root + "/" + "ooda/fixtures/hitl_marker.oo");

    // when "doc carries HITL_RESIDUAL_ALPHA marker" {
    // and  "doc denies interactive HITL harness explicitly" {
    // and  "doc denies agent pause/resume product" {
    // and  "doc states fail-closed residual" {
    // and  "fixture carries `// HITL: pause` marker" {
    // and  "bootstrap residual surface has no false shipped/enforced claim" {
    // then "HITL residual green" {

    expect_substring(fs, root + "/" + "ooda/bootstrap/HITL.oot", "HITL_RESIDUAL_ALPHA");
    expect_clean(p, "! grep -nEi '(ships|implements|enforces|provides) (interactive )?HITL|HITL (harness|testing) is (shipped|enforced|product.?green)' " + root + "/" + "ooda/bootstrap/HITL.oot");
    expect_clean(p, "grep -qE 'No.*interactive HITL|no interactive HITL|not.*interactive harness' " + root + "/" + "ooda/bootstrap/HITL.oot");
    expect_clean(p, "grep -qE 'Not.*agent pause|not agent pause|no.*agent pause/resume' " + root + "/" + "ooda/bootstrap/HITL.oot");
    expect_clean(p, "! grep -qiE 'HITL harness is (shipped|enforced|green)|verify_human is (shipped|enforced)' " + root + "/" + "ooda/bootstrap/HITL.oot");
    expect_substring(fs, root + "/" + "ooda/fixtures/hitl_marker.oo", "// HITL:");
    expect_clean(p, "grep -qiE 'Fail-closed residual|fail-closed residual' " + root + "/" + "ooda/bootstrap/HITL.oot");
    expect_clean(p, "! grep -rn --include='*.oot' --exclude='HITL.oot' -E 'HITL (shipped|enforced)|human-in-the-loop (shipped|enforced|green)' " + root + "/ooda/bootstrap 2>/dev/null | grep -vE 'not |residual|not-started|no false' | grep -q .");

    println("hitl_residual_smoke: PASSED");
}