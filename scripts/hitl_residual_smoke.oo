// # HITL residual honesty
//
// Logline: HITL is not product. Fail if std/hitl.oo or the ehitl python fixer return.
//
// Setup: ProcessCap. Cwd is the ooda product root. SHIPPED names the human loop.
//
// Beats:
//   1. std/hitl.oo is absent.
//   2. scripts/ooda_apply_ehitl_fix.py is absent.
//   3. SHIPPED.oot says HITL is not product.

import "std/scenario.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "HITL residual honesty");
    if expect_absent(fs, "std/hitl.oo").is_err() {
        println("FAIL std/hitl.oo still present");
        process_exit(1);
    }
    if expect_absent(fs, "scripts/ooda_apply_ehitl_fix.py").is_err() {
        println("FAIL leftover ooda_apply_ehitl_fix.py");
        process_exit(1);
    }
    if expect_substring(fs, "../openOODA/SHIPPED.oot", "HITL is not product").is_err() {
        if expect_substring(fs, "openOODA/SHIPPED.oot", "HITL is not product").is_err() {
            println("FAIL SHIPPED must say HITL is not product");
            process_exit(1);
        }
    }
    println("hitl_residual_smoke: PASSED");
}
