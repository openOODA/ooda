// # OODAC Check Capture
//
// Logline: helper for --json-errors re-run — argv-only oodac check, captures stdout + exit code, never evals diagnostics.
//
// Setup: Process capability and test fixtures available.
//
// Beats: EM resolve | argv-safe check capture | rc file write.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = scenario(p, fs, "oodac_check_capture helper");

    when "OODAC_BIN resolvable to a real oodac" {
    and  "argv-only check captures stdout + rc" {
    then "oodac_check_capture PASSED" { } }

    expect_present(fs, root + "/oodac/oodac");
    let _ = expect_clean(p, "test -x " + oodac);
    let out = tmpd(p) + "/occ.out";
    let rc  = tmpd(p) + "/occ.rc";
    let src = root + "/oodac/main.oo";
    check(p, oodac + " check " + src + " > " + out + " 2>&1; echo $? > " + rc, within: 180);
    expect_present(fs, rc);
    expect_present(fs, out);
    println("oodac_check_capture: PASSED");
}

fn tmpd(p: &ProcessCap) -> String {
    return sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or(".");
}
