// ===================================================================
// OODAC Check Capture Helper
// ===================================================================
// helper for --json-errors re-run (argv only; no complex quoting)
// args: $1=source $2=out $3=ecfile

import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let args = process_args(p);
    
    if list_len(args) < 4 {
        // Not enough arguments: source, out, ecfile
        process_exit(0);
    }
    
    let source = list_get(args, 1);
    let out_file = list_get(args, 2);
    let ec_file = list_get(args, 3);
    
    // Find OODAC_BIN
    let oodac = get_oodac(p);
    
    if str_len(oodac) == 0 {
        // No oodac found, write error
        let _ = cmd_exec(p, "echo ERR_NO_OODAC >\"" + out_file + "\"");
        let _ = cmd_exec(p, "echo 1 >\"" + ec_file + "\"");
        process_exit(0);
    }
    
    // Run oodac check with redirects
    let cmd = oodac + " check \"" + source + "\" >\"" + out_file + "\" 2>&1";
    let res = cmd_exec(p, cmd);
    
    // Write exit code to ec_file
    let ec = if res.is_ok() { "0" } else { "1" };
    let _ = cmd_exec(p, "echo " + ec + " >\"" + ec_file + "\"");
    
    process_exit(0);
}

fn get_oodac(p: &ProcessCap) -> String {
    let oodac_bin = get_env(p, "OODAC_BIN", "");
    if str_len(oodac_bin) > 0 {
        if check_executable(p, oodac_bin) {
            return oodac_bin;
        }
    }
    
    if check_executable(p, "./oodac/oodac") {
        return "./oodac/oodac";
    }
    
    if check_executable(p, "oodac/oodac") {
        return "oodac/oodac";
    }
    
    return "";
}

fn process_args(p: &ProcessCap) -> List[String] {
    // Use sys_args to get command line arguments
    // For now, use a shell-based approach
    let res = cmd_exec(p, "echo $@");
    if res.is_ok() {
        let raw = res.unwrap();
        return split_args(raw);
    }
    let mut empty: List[String] = list_new();
    return empty;
}

fn split_args(s: String) -> List[String] {
    let mut args: List[String] = list_new();
    let len = str_len(s);
    let mut i = 0;
    let mut current = "";
    let mut in_quote = false;
    
    while i < len {
        let c = str_char_at(s, i);
        if c == "\"" {
            in_quote = !in_quote;
        } else if c == " " && !in_quote {
            if str_len(current) > 0 {
                args = list_push(args, current);
                current = "";
            }
        } else {
            current = current + c;
        }
        i = i + 1;
    }
    
    if str_len(current) > 0 {
        args = list_push(args, current);
    }
    
    return args;
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn check_executable(p: &ProcessCap, path: String) -> Bool {
    let res = cmd_exec(p, "test -x " + path);
    return res.is_ok();
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
