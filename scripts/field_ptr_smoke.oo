// # Named emit+gcc+run lock for parenthesized &T field load
//
// Logline: Isolated emit-c of field_ptr_smoke must use ->, gcc, and print field_ptr: PASSED.
//
// Setup: cwd is ooda/. Isolated .ooda-cache/ooda-tmp/c_lane/oodac.c1 if executable, else ./oodac/oodac.
//
// Beats:
//   1. emit-c of fixtures/field_ptr_smoke.oo exits 0.
//   2. Emitted C contains ->x (pointer field, not value .).
//   3. gcc + run prints field_ptr: PASSED.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut oodac = ".ooda-cache/ooda-tmp/c_lane/oodac.c1";
    if process_exec(p, "test -x " + oodac).is_err() {
        oodac = "./oodac/oodac";
    }
    let tmpd = ".ooda-cache/ooda-tmp/field_ptr";
    let src = "fixtures/field_ptr_smoke.oo";
    let c = tmpd + "/fp.c";
    let err = tmpd + "/fp.err";
    let bin = tmpd + "/fp.bin";
    if process_exec(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "timeout 20 env OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " +
        oodac + " emit-c " + src + " > " + c + " 2> " + err).is_err() {
        fail("emit-c timeout or fail");
    }
    if process_exec(p, "test -s " + c + " && ! grep -qE '^ERR' " + c + " " +
        err).is_err() {
        fail("emit-c ERR");
    }
    if process_exec(p, "grep -qF -- '->x' " + c).is_err() {
        fail("no ->x");
    }
    if process_exec(p, "gcc -O2 -Iruntime runtime/chs_rt.c " + c +
        " -lm -ldl -lpthread -o " + bin).is_err() {
        fail("gcc");
    }
    if process_exec(p, bin + " | grep -q 'field_ptr: PASSED'").is_err() {
        fail("run");
    }
    println("field_ptr_smoke: PASSED");
}
