// # Contracts Native Smoke
//
// Logline: native Backend-C contracts — pass fixtures print 42, fails trip non-zero with contract/ensures/requires needle.
//
// Setup: Process capability and test fixtures available.
//
// Beats: pass→42 | hello body | fail ERR/non-zero | build→42 | req/ens pass+fail | multi-clause sub-smoke.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "native contracts smoke");

    build_run(p, fs, root, lower(p, oodac, tmpd, "ooda/bootstrap/corpus/emit-c/pass/fn_contracts_add.oo", "fn_c"), tmpd + "/fn_c.bin", "42");
    build_run(p, fs, root, lower(p, oodac, tmpd, "ooda/fixtures/int_main.oo", "im"), tmpd + "/im.bin", "42");
    expect_substring(fs, lower(p, oodac, tmpd, "ooda/fixtures/hello.oo", "hello"), "OoStr greet");

    let c_fail = tmpd + "/contracts_fail.c";
    let _ = process_exec(p, oodac + " emit-c ooda/bootstrap/corpus/emit-c/fail/contract_no_brace.oo > " + c_fail + " 2> " + tmpd + "/contracts_fail.err");
    expect_clean(p, "grep -qE '^ERR\\tc_emit' " + c_fail + " " + tmpd + "/contracts_fail.err || ! cat " + c_fail + " >/dev/null 2>&1");

    check(p, "rm -f /tmp/im_contracts && " + oodac + " build ooda/fixtures/int_main.oo /tmp/im_contracts", within: 60);
    expect_clean(p, "/tmp/im_contracts | grep -q '42'");

    cond(p, fs, root, oodac, tmpd, "ooda/fixtures/requires_simple.oo", "rq", "3", "if (!(;", true);
    cond(p, fs, root, oodac, tmpd, "ooda/fixtures/requires_fail.oo", "rf", "", "contract|requires", false);
    cond(p, fs, root, oodac, tmpd, "ooda/fixtures/ensures_simple.oo", "ens", "2", "__oo_ens_mode", true);
    cond(p, fs, root, oodac, tmpd, "ooda/fixtures/ensures_fail.oo", "ef", "", "contract|ensures", false);

    check(p, "ooda/scripts/contracts_multi_clause_smoke.oo", within: 30);
    println("contracts_native_smoke: PASSED");
}

fn lower(p: &ProcessCap, oodac: String, tmpd: String, src: String, tag: String) -> String {
    let c = tmpd + "/contracts_" + tag + ".c";
    let _ = process_exec(p, oodac + " emit-c " + src + " > " + c + " 2> " + tmpd + "/contracts_" + tag + ".err");
    return c;
}

fn cond(p: &ProcessCap, fs: &FsReadCap, root: String, oodac: String, tmpd: String, src: String, tag: String, expect_out: String, needle: String, pass: Bool) {
    if !fs_path_exists(fs, src) { return; }
    let c = lower(p, oodac, tmpd, src, tag);
    expect_substring(fs, c, needle);
    let bin = tmpd + "/" + tag + ".bin";
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + c + " -o " + bin + " -lm", within: 30);
    let pipe = if pass { "timeout 3 " + bin + " | grep -qE '" + expect_out + "'" } else { "! timeout 3 " + bin + " 2>&1 | grep -qiE '" + needle + "'" };
    expect_clean(p, pipe);
}

fn build_run(p: &ProcessCap, fs: &FsReadCap, root: String, src_c: String, bin: String, expect_out: String) {
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + src_c + " -o " + bin + " -lm", within: 30);
    expect_clean(p, "timeout 3 " + bin + " | grep -qE '" + expect_out + "'");
}