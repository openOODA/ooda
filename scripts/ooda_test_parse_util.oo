// # OODA Test Parse Util
//
// Logline: Pure parsing utilities for openOODA test scanning (whitespace skipping, keyword matching, balanced delimiter tracking, and assert argument parsing).
//
// Setup: Pure string and character inspection without runtime I/O or capabilities.
//
// Beats:
//   1. skip_ws advances past whitespace characters.
//   2. match_kw matches an exact keyword bounded by non-identifier characters.
//   3. skip_balanced and bal track matched delimiter pairs across string literals and escapes.
//   4. parse_assert_eq_args splits binary assertion arguments at top-level commas.
//   5. scan_ident, find_sub, trim_ws, and trim_right_newlines provide token extraction.

pub type AssertItem = struct {
    kind: String,
    a: String,
    b: String,
    vname: String,
    aidx: Int
};

pub type VerifyScan = struct {
    fns: List[String],
    asserts: List[AssertItem],
    verify_count: Int
};

pub fn trim_ws(s: String) -> String {
    let n = chars_len(s);
    if n == 0 { return ""; }
    let mut start = 0;
    while start < n {
        let c = char_at(s, start);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { start = start + 1; } else { break; }
    }
    if start >= n { return ""; }
    let mut end_idx = n;
    while end_idx > start {
        let c2 = char_at(s, end_idx - 1);
        if c2 == " " || c2 == "\t" || c2 == "\r" || c2 == "\n" { end_idx = end_idx - 1; } else { break; }
    }
    return str_slice(s, start, end_idx);
}

pub fn trim_right_newlines(s: String) -> String {
    let mut n = chars_len(s);
    while n > 0 {
        let c = char_at(s, n - 1);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { n = n - 1; } else { break; }
    }
    return str_slice(s, 0, n);
}

pub fn skip_ws(text: String, j0: Int, n: Int) -> Int {
    let mut j = j0;
    while j < n {
        let c = char_at(text, j);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { j = j + 1; } else { return j; }
    }
    return j;
}

pub fn match_kw(text: String, j: Int, n: Int, kw: String) -> Int {
    let kw_len = chars_len(kw);
    if j + kw_len > n { return 0 - 1; }
    let sub = str_slice(text, j, j + kw_len);
    if sub == kw {
        let end_pos = j + kw_len;
        if end_pos >= n { return end_pos; }
        let c = char_at(text, end_pos);
        if char_is_alpha(c) || char_is_digit(c) || c == "_" { return 0 - 1; }
        return end_pos;
    }
    return 0 - 1;
}

pub fn find_sub(text: String, sub: String, start_pos: Int) -> Int {
    let sub_len = chars_len(sub);
    let n = chars_len(text);
    if sub_len == 0 { return start_pos; }
    let mut i = start_pos;
    while i + sub_len <= n {
        if str_slice(text, i, i + sub_len) == sub { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn scan_ident(text: String, i0: Int, n: Int) -> String {
    if i0 >= n { return ""; }
    let c0 = char_at(text, i0);
    if !(char_is_alpha(c0) || c0 == "_") { return ""; }
    let mut i = i0 + 1;
    while i < n {
        let c = char_at(text, i);
        if char_is_alpha(c) || char_is_digit(c) || c == "_" {
            i = i + 1;
        } else {
            return str_slice(text, i0, i);
        }
    }
    return str_slice(text, i0, i);
}

pub fn skip_balanced(text: String, j0: Int, n: Int, open_c: String, close_c: String) -> Int {
    if j0 >= n || char_at(text, j0) != open_c { return 0 - 1; }
    let mut j = j0;
    let mut depth = 0;
    let mut in_str = false;
    let mut esc = false;
    while j < n {
        let c = char_at(text, j);
        if in_str {
            if esc { esc = false; }
            else if c == "\\" { esc = true; }
            else if c == "\"" { in_str = false; }
            j = j + 1;
        } else if c == "\"" {
            in_str = true;
            j = j + 1;
        } else if c == open_c {
            depth = depth + 1;
            j = j + 1;
        } else if c == close_c {
            depth = depth - 1;
            j = j + 1;
            if depth == 0 { return j; }
        } else {
            j = j + 1;
        }
    }
    return 0 - 1;
}

pub fn skip_paren_group(text: String, j: Int, n: Int) -> Int {
    return skip_balanced(text, j, n, "(", ")");
}

pub fn bal(s: String, j0: Int, open_c: String, close_c: String) -> Int {
    return skip_balanced(s, j0, chars_len(s), open_c, close_c);
}

pub fn parse_assert_eq_args(inner: String) -> List[String] {
    let mut depth = 0;
    let mut in_str = false;
    let mut esc = false;
    let n = chars_len(inner);
    let mut k = 0;
    while k < n {
        let c = char_at(inner, k);
        if in_str {
            if esc { esc = false; }
            else if c == "\\" { esc = true; }
            else if c == "\"" { in_str = false; }
        } else if c == "\"" {
            in_str = true;
        } else if c == "(" || c == "[" || c == "{" {
            depth = depth + 1;
        } else if c == ")" || c == "]" || c == "}" {
            depth = depth - 1;
        } else if c == "," && depth == 0 {
            let lhs = trim_ws(str_slice(inner, 0, k));
            let rhs = trim_ws(str_slice(inner, k + 1, n));
            if chars_len(lhs) == 0 || chars_len(rhs) == 0 { return list_new(); }
            let mut res: List[String] = list_new();
            res = list_push(res, lhs);
            res = list_push(res, rhs);
            return res;
        }
        k = k + 1;
    }
    return list_new();
}
