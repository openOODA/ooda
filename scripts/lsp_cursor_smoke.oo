// # Cursor-aware ooda lsp lock
//
// Logline: Check and run the cursor hover probe so add is not confused with main.
//
// Setup: cwd is ooda/. Tree oodac and fixtures/lsp_cursor_probe.oo exist.
//
// Beats:
//   1. oodac check of the probe is OK.
//   2. ooda run of the probe prints PASSED.
//   3. Helpers live in cli/lsp_ident.oo.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let ooda = "./bin/ooda";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if !path_exists(fs, ooda) { fail("no ooda"); }
    if !path_exists(fs, "cli/lsp_ident.oo") { fail("no lsp_ident"); }
    if !path_exists(fs, "fixtures/lsp_cursor_probe.oo") { fail("no probe"); }
    if process_exec(p, oodac + " check fixtures/lsp_cursor_probe.oo 2>&1 | grep -qE '^OK'").is_err() {
        fail("probe check");
    }
    if process_exec(p, ooda + " run ./fixtures/lsp_cursor_probe.oo 2>&1 | grep -q 'lsp_cursor_probe: PASSED'").is_err() {
        fail("probe run");
    }
    println("lsp_cursor_smoke: PASSED");
}
