// # Shadow State Residual Smoke
//
// Logline: bootstrap/SHADOW_STATE.oot carries the residual marker, fail-closed wording, no "shipped" claim, and the fixture marker line.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker | no product-green claim | fail-closed wording | fixture marker | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/SHADOW_STATE.oot";
const MARKER: String = "SHADOW_STATE_RESIDUAL_ALPHA";
const FIX: String = "ooda/fixtures/shadow_marker.oo";
const FIXLINE: String = "SHADOW: residual";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "shadow state residual honesty");

    // when: doc + marker + no product-green claim
    expect_present(fs, root + "/" + DOC);
    expect_substring(fs, root + "/" + DOC, MARKER);
    expect_clean(p, "grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + DOC + " | grep -viE 'not |residual|do not|never|no '");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);

    // then: fixture carries the marker line
    expect_present(fs, root + "/" + FIX);
    expect_substring(fs, root + "/" + FIX, FIXLINE);

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "shadow_state_residual_smoke");
    println("shadow_state_residual_smoke: PASSED");
}
