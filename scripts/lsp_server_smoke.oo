// # Smoke Test for Full Language Server Protocol (LSP) Server
//
// Logline: Verify LSP initialize, completion, hover, definition, codeAction, and lifecycle handlers.
//
// Setup: Exercises lsp_server dispatcher and JSON-RPC replies under &FsCap and &SysCap.
//
// Beats:
//   1. Verify initialize response advertises full capabilities.
//   2. Verify completion and hover responses.
//   3. Verify definition resolution.
//   4. Verify code action generation and quick-fix mapping.
//   5. Verify shutdown and exit lifecycle handling.

import "lsp/lsp_types.oo";
import "lsp/lsp_server.oo";
import "lsp/lsp_code_action.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main() {
    // 1. Initialize
    let init_req: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///project\"}}";
    let init_resp: String = lsp_server_process_message(init_req);
    if str_index_of(init_resp, "\"codeActionProvider\":true") < 0 {
        fail_smoke("initialize missing codeActionProvider: " + init_resp);
    }
    if str_index_of(init_resp, "\"hoverProvider\":true") < 0 {
        fail_smoke("initialize missing hoverProvider");
    }
    if str_index_of(init_resp, "\"definitionProvider\":true") < 0 {
        fail_smoke("initialize missing definitionProvider");
    }

    // 2. Completion
    let comp_req: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/completion\",\"params\":{\"prefix\":\"Sys\"}}";
    let comp_resp: String = lsp_server_process_message(comp_req);
    if str_index_of(comp_resp, "SysCap") < 0 {
        fail_smoke("completion missing SysCap: " + comp_resp);
    }

    // 3. Hover
    let hover_req: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/hover\",\"params\":{\"symbol\":\"SysCap\"}}";
    let hover_resp: String = lsp_server_process_message(hover_req);
    if str_index_of(hover_resp, "SysCap") < 0 {
        fail_smoke("hover missing SysCap documentation: " + hover_resp);
    }

    // 4. Definition
    let def_req: String = "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/definition\",\"params\":{\"uri\":\"file:///src/main.oo\"}}";
    let def_resp: String = lsp_server_process_message(def_req);
    if str_index_of(def_resp, "\"uri\":\"file:///src/main.oo\"") < 0 {
        fail_smoke("definition missing target URI: " + def_resp);
    }

    // 5. Code Action (Quick Fix)
    let ca_req: String = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/codeAction\",\"params\":{\"uri\":\"file:///src/main.oo\",\"code\":\"E_CAP\"}}";
    let ca_resp: String = lsp_server_process_message(ca_req);
    if str_index_of(ca_resp, "Fix: Add required &Cap parameter") < 0 {
        fail_smoke("codeAction missing E_CAP fix title: " + ca_resp);
    }

    // 6. Direct Code Action Resolver tests
    let parse_actions: List[LspCodeAction] = lsp_code_action_resolve("E_PARSE", "file:///a.oo", 10, 5);
    if list_len(parse_actions) < 1 {
        fail_smoke("expected action for E_PARSE");
    }
    let imp_actions: List[LspCodeAction] = lsp_code_action_resolve("E_IMP", "file:///a.oo", 1, 1);
    if list_len(imp_actions) < 1 {
        fail_smoke("expected action for E_IMP");
    }

    let custom_act: LspCodeAction = lsp_types_action_new("custom", "quickfix", "");
    if lsp_code_action_title(&custom_act) != "custom" {
        fail_smoke("custom action title mismatch");
    }

    // 7. Shutdown
    let shut_req: String = "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"shutdown\",\"params\":{}}";
    let shut_resp: String = lsp_server_process_message(shut_req);
    if str_index_of(shut_resp, "\"result\":null") < 0 {
        fail_smoke("shutdown response should return null result");
    }

    println("OK: LSP_SERVER_SMOKE_PASSED");
}
