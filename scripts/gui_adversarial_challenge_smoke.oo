// # GUI Adversarial Challenge Stress Harness
//
// Logline: Adversarial stress testing of 3D perspective matrix math, polygon clipping boundaries, and anti-aliasing edge cases.
//
// Setup: Stress-tests std/gui mathematical invariants, boundary conditions, and degenerate geometry on live binary execution.
//
// Beats:
//   1. Stress-test 3D perspective matrix inversion, determinant, and identity roundtrips under extreme aspect ratios and FOV angles.
//   2. Stress-test polygon rasterizer with negative coordinates, out-of-bounds bounding boxes, and degenerate/collinear polygons.
//   3. Stress-test Xiaolin Wu line rasterization and subpixel circle rasterizer with zero-length, vertical, and out-of-bounds lines.
//   4. Stress-test alpha blending color clamp arithmetic across negative and overflow alpha channels.

import "std/gui/render.oo";
import "std/gui/gui_3d_math.oo";
import "std/gui/gui_polygon_rasterizer.oo";
import "std/gui/gui_antialiasing.oo";

pub fn mat4_perspective_inverse(fov_rad: Float, aspect: Float, near_z: Float, far_z: Float) -> Mat4 {
    let half_fov: Float = fov_rad * 0.5;
    let tan_half: Float = math_sin(half_fov) / math_cos(half_fov);
    let f: Float = 1.0 / tan_half;
    let range: Float = near_z - far_z;
    let a: Float = (far_z + near_z) / range;
    let b: Float = (2.0 * far_z * near_z) / range;

    return Mat4 {
        m00: aspect / f, m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: 1.0 / f, m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: 0.0, m23: 0.0 - 1.0,
        m30: 0.0, m31: 0.0, m32: 1.0 / b, m33: a / b
    };
}

pub fn float_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA GUI Adversarial Challenge Stress Suite");
    println("===================================================================");

    // 1. 3D Perspective Matrix Inversion & Invariant Verification
    let fov: Float = 1.047197; // 60 deg
    let aspect: Float = 1.777778; // 16:9
    let near: Float = 0.1;
    let far: Float = 100.0;

    let p_mat: Mat4 = mat4_perspective(fov, aspect, near, far);
    let p_inv: Mat4 = mat4_perspective_inverse(fov, aspect, near, far);
    let p_prod: Mat4 = mat4_mul(p_mat, p_inv);

    let err00: Float = float_abs(p_prod.m00 - 1.0);
    let err11: Float = float_abs(p_prod.m11 - 1.0);
    let err22: Float = float_abs(p_prod.m22 - 1.0);
    let err33: Float = float_abs(p_prod.m33 - 1.0);
    let err01: Float = float_abs(p_prod.m01);
    let err23: Float = float_abs(p_prod.m23);

    if err00 > 0.0001 || err11 > 0.0001 || err22 > 0.0001 || err33 > 0.0001 || err01 > 0.0001 || err23 > 0.0001 {
        println("FAIL: 3D Perspective Matrix Inversion P * P^-1 != Identity");
        process_exit(1);
    }

    // Test extreme perspective parameters (near-zero aspect ratio, narrow FOV)
    let p_ext: Mat4 = mat4_perspective(0.1, 0.01, 0.001, 1000.0);
    let p_ext_inv: Mat4 = mat4_perspective_inverse(0.1, 0.01, 0.001, 1000.0);
    let p_ext_prod: Mat4 = mat4_mul(p_ext, p_ext_inv);
    if float_abs(p_ext_prod.m00 - 1.0) > 0.001 || float_abs(p_ext_prod.m33 - 1.0) > 0.001 {
        println("FAIL: Extreme perspective matrix inversion roundtrip failed");
        process_exit(1);
    }
    println("  [PASS] 1. 3D Perspective Matrix Inversion & Extreme Parameter Invariants");

    // 2. Polygon Rasterizer Boundary Clipping & Degenerate Geometries
    let mut rctx: RenderContext = render_context_new(64, 64);
    let c_red: Color = color_new(255, 0, 0, 255);

    // Empty / 0-point polygon
    let poly_empty: Polygon2D = polygon_new();
    rctx = polygon_rasterize_fill(rctx, poly_empty, 0, c_red);
    rctx = polygon_rasterize_stroke(rctx, poly_empty, 1, c_red);

    // 1-point and 2-point degenerate polygons
    let mut poly_1pt: Polygon2D = polygon_new();
    polygon_add_point(&mut poly_1pt, point_new(10, 10));
    rctx = polygon_rasterize_fill(rctx, poly_1pt, 0, c_red);
    rctx = polygon_rasterize_stroke(rctx, poly_1pt, 1, c_red);

    let mut poly_2pt: Polygon2D = polygon_new();
    polygon_add_point(&mut poly_2pt, point_new(10, 10));
    polygon_add_point(&mut poly_2pt, point_new(20, 20));
    rctx = polygon_rasterize_fill(rctx, poly_2pt, 0, c_red);
    rctx = polygon_rasterize_stroke(rctx, poly_2pt, 1, c_red);

    // Negative coordinates polygon (entirely outside canvas top-left)
    let mut poly_neg: Polygon2D = polygon_new();
    polygon_add_point(&mut poly_neg, point_new(-50, -50));
    polygon_add_point(&mut poly_neg, point_new(-10, -50));
    polygon_add_point(&mut poly_neg, point_new(-10, -10));
    polygon_add_point(&mut poly_neg, point_new(-50, -10));
    rctx = polygon_rasterize_fill(rctx, poly_neg, 0, c_red);
    rctx = polygon_rasterize_stroke(rctx, poly_neg, 1, c_red);

    // Out-of-bounds polygon (partially clipping canvas [0..64, 0..64])
    let mut poly_clip: Polygon2D = polygon_new();
    polygon_add_point(&mut poly_clip, point_new(-20, -20));
    polygon_add_point(&mut poly_clip, point_new(32, -20));
    polygon_add_point(&mut poly_clip, point_new(32, 32));
    polygon_add_point(&mut poly_clip, point_new(-20, 32));
    rctx = polygon_rasterize_fill(rctx, poly_clip, 0, c_red);

    // Check pixel at (10, 10) inside clipped polygon vs (50, 50) outside
    let pix_in: Color = render_get_pixel(rctx, 10, 10);
    let pix_out: Color = render_get_pixel(rctx, 50, 50);
    if (pix_in).r != 255 || (pix_out).r != 0 {
        println("FAIL: Polygon boundary clipping rasterization failed");
        process_exit(1);
    }
    println("  [PASS] 2. Polygon Rasterizer Boundary Clipping & Degenerate Safeguards");

    // 3. Anti-Aliasing Edge Cases: Zero-length, Vertical/Horizontal, and Subpixel Radii
    let c_white: Color = color_new(255, 255, 255, 255);
    let c_black: Color = color_new(0, 0, 0, 255);

    // Zero-length line (p0 == p1)
    rctx = aa_draw_line_xiaolin_wu(rctx, point_new(5, 5), point_new(5, 5), c_white);

    // Purely horizontal and purely vertical AA lines
    rctx = aa_draw_line_xiaolin_wu(rctx, point_new(0, 20), point_new(63, 20), c_white);
    rctx = aa_draw_line_xiaolin_wu(rctx, point_new(20, 0), point_new(20, 63), c_white);

    // Out-of-bounds line spanning from negative to positive
    rctx = aa_draw_line_xiaolin_wu(rctx, point_new(-100, -100), point_new(200, 200), c_white);

    // Zero and negative radius circles
    rctx = aa_draw_circle(rctx, point_new(32, 32), 0, c_white);
    rctx = aa_draw_circle(rctx, point_new(32, 32), -10, c_white);

    // Circle centered outside canvas
    rctx = aa_draw_circle(rctx, point_new(-10, -10), 15, c_white);

    println("  [PASS] 3. Anti-Aliasing Edge Cases (Zero-length, Orthogonal, Negative Radius)");

    // 4. Alpha Blending Boundary Clamping
    let blend_neg: Color = color_blend_alpha(c_black, c_white, -500);
    let blend_ovf: Color = color_blend_alpha(c_black, c_white, 1000);
    let blend_zero: Color = color_blend_alpha(c_black, c_white, 0);
    let blend_max: Color = color_blend_alpha(c_black, c_white, 255);

    if (blend_neg).r != 0 || (blend_zero).r != 0 || (blend_ovf).r != 255 || (blend_max).r != 255 {
        println("FAIL: Color alpha blending boundary clamp failed");
        process_exit(1);
    }
    println("  [PASS] 4. Fractional Alpha Blending Boundary Arithmetic & Clamping");

    println("gui_adversarial_challenge_smoke: PASSED (ALL CHECKS GREEN)");
}
