// # TLS Path A Handshakes Or Forges Closed
// Logline: bare tls_connect refuses; product emit lowers oo_tls_connect; forge zero is denied.
// Setup: oodac/oodac built; chs_rt.c linkable; optional libssl.so.3 for product path.
// Beats: 1. bare refuse | 2. emit lowers oo_tls_connect | 3. forge zero deny

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "TLS path A");

    // when — bare tls_connect refused
    let bare = tmpd + "/tls_bare.oo";
    let _    = process_exec(p, "printf 'pub fn main() { let r = tls_connect(\"example.com\", 443); }\\n' > " + bare);
    let _    = check(p, "!" + oodac + " check " + bare + " >/dev/null 2>&1", 30);

    // then — emit fixture lowers oo_tls_connect
    let fix   = root + "/fixtures/tls_path_a_msg.oo";
    let cfile = tmpd + "/tls_m.c";
    let _     = process_exec(p, oodac + " emit-c " + fix + " > " + cfile + " 2>" + tmpd + "/tls_m.err");
    let _     = expect_quiet(p, "grep -q 'oo_tls_connect' " + cfile);
    let _     = expect_quiet(p, "grep -q 'libssl.so.3' " + root + "/scripts/oodac_pure_build.sh");
    let _     = expect_quiet(p, "grep -q 'OO_HAVE_OPENSSL' " + root + "/oodac/cli_build.oo");

    // then — forge zero deny
    let zfile = tmpd + "/tls_z.c";
    let zbin  = tmpd + "/tls_z.bin";
    let zout  = tmpd + "/tls_z.out";
    let _     = process_exec(p, "sed -E 's/long long net = oo_cap_grant_net\\(\\)/long long net = 0LL/' " + cfile + " > " + zfile);
    let _     = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + zfile + " -o " + zbin + " -lm -ldl -lpthread 2>/dev/null");
    let _     = process_exec(p, zbin + " > " + zout + " 2>&1 ; echo rc=$?");
    let _     = expect_clean(p, "head -1 " + zout + " | grep -qE 'ERR[\\t ]*cap'");

    println("tls_path_a_smoke: PASSED");
}
