// # TLS Path A Handshakes Or Forges Closed
// Logline: bare tls_connect refuses; product emit lowers oo_tls_connect; forge zero is denied.
// Setup: oodac/oodac built; chs_rt.c linkable; optional libssl.so.3 for product path.
// Beats: 1. bare refuse | 2. emit lowers oo_tls_connect | 3. forge zero deny

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — OpenSSL detect (informational, product path uses it when present)
    let have_ossl = expect_quiet(p, "test -e /usr/lib64/libssl.so.3 -o -e /lib64/libssl.so.3 -o -e /usr/lib/x86_64-linux-gnu/libssl.so.3").is_ok();
    if have_ossl { println("OK OpenSSL lib present"); } else { println("OK OpenSSL absent (residual path)"); }

    // and — bare tls_connect refused
    let bare = tmpd + "/tls_bare.oo";
    let _w1  = process_exec(p, "printf 'pub fn main() { let r = tls_connect(\"example.com\", 443); }\\n' > " + bare);
    fails    = fails + tally(check(p, "!" + oodac + " check " + bare + " >/dev/null 2>&1", 30), "bare tls_connect refused");

    // then — emit fixture lowers oo_tls_connect
    let fix   = root + "/fixtures/tls_path_a_msg.oo";
    let cfile = tmpd + "/tls_m.c";
    let _w2   = process_exec(p, oodac + " emit-c " + fix + " > " + cfile + " 2>" + tmpd + "/tls_m.err");
    fails     = fails + tally(expect_quiet(p, "grep -q 'oo_tls_connect' " + cfile),                              "emit lowers oo_tls_connect");
    fails     = fails + tally(expect_quiet(p, "grep -q 'libssl.so.3' " + root + "/scripts/oodac_pure_build.sh"),  "build recipes link OpenSSL");
    fails     = fails + tally(expect_quiet(p, "grep -q 'OO_HAVE_OPENSSL' " + root + "/oodac/cli_build.oo"),      "oodac/cli_build.oo OO_HAVE_OPENSSL");

    // then — forge zero deny
    let zfile = tmpd + "/tls_z.c";
    let zbin  = tmpd + "/tls_z.bin";
    let zout  = tmpd + "/tls_z.out";
    let _w3   = process_exec(p, "sed -E 's/long long net = oo_cap_grant_net\\(\\)/long long net = 0LL/' " + cfile + " > " + zfile);
    let _w4   = process_exec(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + zfile + " -o " + zbin + " -lm -ldl -lpthread 2>/dev/null");
    let _w5   = process_exec(p, zbin + " > " + zout + " 2>&1 ; echo rc=$?");
    fails     = fails + tally(expect_clean(p, "head -1 " + zout + " | grep -qE 'ERR[\\t ]*cap'"), "zero Net forge deny");

    if fails > 0 { println("tls_path_a_smoke: FAILED"); process_exit(1); }
    println("tls_path_a_smoke: PASSED");
}
