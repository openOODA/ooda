// # Outline Reflect Walks The Parse Rails
// Logline: outline pub+caps / reflect contracts / unreadable exit 2 / bad symbol exit 1 — every rail green.
// Setup: bin/ooda (OODA) built; fixtures/outline_reflect_pass.oo on disk.
// Beats: 1. outline pass + --json | 2. outline unreadable exit 2 | 3. reflect contracts + filter | 4. reflect fail rails

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let _v0  = sh_mkdir_p(fw, tmpd);
    let _v1  = scenario(p, fs, "outline reflect rails");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    let fix = root + "/fixtures/outline_reflect_pass.oo";

    // when — outline pass (pub+caps only, no private, no contracts)
    let _w1 = process_exec(p, ooda + " outline " + fix + " > " + tmpd + "/or_ol.out 2> " + tmpd + "/or_ol.err");
    fails   = fails + tally(check(p, "grep -q 'pub fn scale(x: Int) -> Int' " + tmpd + "/or_ol.out && grep -q 'pub fn touch(fs: &FsCap, path: String) -> String caps=FsCap' " + tmpd + "/or_ol.out && grep -q 'pub fn main(sys: &SysCap) caps=SysCap' " + tmpd + "/or_ol.out && ! grep -q 'hidden' " + tmpd + "/or_ol.out && ! grep -qE 'requires|ensures|verify' " + tmpd + "/or_ol.out", 5), "outline pass compact pub+caps");

    // and — outline --json
    let _w2 = process_exec(p, ooda + " outline " + fix + " --json > " + tmpd + "/or_ol_j.out 2> " + tmpd + "/or_ol_j.err");
    fails   = fails + tally(check(p, "grep -q '\"functions\":' " + tmpd + "/or_ol_j.out && grep -q '\"verifies\":' " + tmpd + "/or_ol_j.out", 5), "outline --json");

    // and — outline fail: unreadable (exit 2)
    let miss_o = tmpd + "/no_such_outline.oo";
    let _w3 = process_exec(p, ooda + " outline " + miss_o + " > " + tmpd + "/or_ol_miss.out 2> " + tmpd + "/or_ol_miss.err; echo rc=$? >> " + tmpd + "/or_ol_miss.out");
    fails   = fails + tally(check(p, "grep -q 'rc=2' " + tmpd + "/or_ol_miss.out && grep -qE 'ERR.*outline.*unreadable file:' " + tmpd + "/or_ol_miss.out " + tmpd + "/or_ol_miss.err 2>/dev/null", 5), "outline unreadable exit 2");

    // then — reflect pass (contracts + caps + verify + private)
    let _w4 = process_exec(p, ooda + " reflect " + fix + " > " + tmpd + "/or_rf.out 2> " + tmpd + "/or_rf.err");
    fails   = fails + tally(check(p, "grep -q '\"kind\":\"fn\"' " + tmpd + "/or_rf.out && grep -q '\"name\":\"scale\"' " + tmpd + "/or_rf.out && grep -q 'x >= 0' " + tmpd + "/or_rf.out && grep -q 'result >= x' " + tmpd + "/or_rf.out && grep -q '\"caps\":\\[\"FsCap\"\\]' " + tmpd + "/or_rf.out && grep -q '\"kind\":\"verify\",\"name\":\"scale\"' " + tmpd + "/or_rf.out && grep -q '\"name\":\"hidden\"' " + tmpd + "/or_rf.out", 5), "reflect pass contracts+caps+verify");

    // and — reflect symbol filter
    let _w5 = process_exec(p, ooda + " reflect " + fix + " scale > " + tmpd + "/or_sym.out 2> " + tmpd + "/or_sym.err");
    fails   = fails + tally(check(p, "grep -q '\"name\":\"scale\"' " + tmpd + "/or_sym.out && ! grep -q '\"name\":\"main\"' " + tmpd + "/or_sym.out", 5), "reflect symbol filter");

    // and — reflect fail: bad symbol (exit 1)
    let _w6 = process_exec(p, ooda + " reflect " + fix + " no_such_symbol_xyz > " + tmpd + "/or_bs.out 2> " + tmpd + "/or_bs.err; echo rc=$? >> " + tmpd + "/or_bs.out");
    fails   = fails + tally(check(p, "grep -q 'rc=1' " + tmpd + "/or_bs.out && grep -qE 'ERR.*reflect.*symbol not found: no_such_symbol_xyz' " + tmpd + "/or_bs.out " + tmpd + "/or_bs.err 2>/dev/null", 5), "reflect unknown symbol exit 1");

    // and — reflect fail: unreadable (exit 2)
    let miss_r = tmpd + "/no_such_reflect.oo";
    let _w7 = process_exec(p, ooda + " reflect " + miss_r + " > " + tmpd + "/or_rf_miss.out 2> " + tmpd + "/or_rf_miss.err; echo rc=$? >> " + tmpd + "/or_rf_miss.out");
    fails   = fails + tally(check(p, "grep -q 'rc=2' " + tmpd + "/or_rf_miss.out && grep -qE 'ERR.*reflect.*unreadable file:' " + tmpd + "/or_rf_miss.out " + tmpd + "/or_rf_miss.err 2>/dev/null", 5), "reflect unreadable exit 2");

    if fails > 0 { println("outline_reflect_smoke: FAILED"); process_exit(1); }
    println("outline_reflect_smoke: PASSED");
}
