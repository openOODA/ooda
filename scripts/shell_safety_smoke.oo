// # Shell Safety Smoke
//
// Logline: shell composition safety — quote-break paths and `$(…)` noise never run side effects; normal product check still runs.
//
// Setup: Process capability and test fixtures available.
// Beats: product quote-break no marker | product $\u2026 no marker | build quote-break no marker | normal check works.

import "std/scenario.oo";
import "std/sh.oo";

const TMP: String = ".ooda-cache/ooda-tmp/shell_safety";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let ooda = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, root + "/" + TMP);
    let _ = scenario(p, fs, "shell composition safety");

    // when: product check with quote-break does not create a marker file
    let m1 = root + "/" + TMP + "/marker_prod";
    let _ = process_exec(p, "rm -f " + m1);
    let _ = process_exec(p, "OODA_QUOTED=\"foo\\\"; touch " + m1 + "; echo x\" " + ooda + " check oods/fixtures/int_main.oo >/dev/null 2>&1 || true");
    expect_absent(fs, m1);

    // and: product check with `$(…)` does not create a marker file
    let m2 = root + "/" + TMP + "/marker_dq";
    let _ = process_exec(p, "rm -f " + m2);
    let _ = process_exec(p, "OODA_DQ=\"foo\\$(touch " + m2 + ")\" " + ooda + " check oods/fixtures/int_main.oo >/dev/null 2>&1 || true");
    expect_absent(fs, m2);

    // then: oodac build with quote-break does not create a marker file
    let m3 = root + "/" + TMP + "/marker_build";
    let _ = process_exec(p, "rm -f " + m3);
    let _ = process_exec(p, "rm -f " + root + "/" + TMP + "/bin_build");
    let _ = process_exec(p, "OODAC_QUOTED=\"foo\\\"; touch " + m3 + "; echo x\" " + oodac + " build oods/fixtures/int_main.oo " + root + "/" + TMP + "/bin_build >/dev/null 2>&1 || true");
    expect_absent(fs, m3);

    // and: normal product check still works
    check(p, ooda + " check oods/fixtures/int_main.oo", within: 30);

    println("shell_safety_smoke: PASSED");
}
