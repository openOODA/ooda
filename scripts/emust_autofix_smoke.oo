// # E_MUST Auto-Fix Smoke
//
// Logline: Live ooda fix --yes wraps a discarded Result call and clears must-use.
//
// Setup: oodac/oodac and product bin/ooda. open_discard_write.oo is the seed.
//
// Beats:
//   1. Discarded write_file is E_MUST. fix --yes wraps is_err.
//   2. Re-check is OK.
//   3. A boom() discard also clears after fix.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    let ooda = "./bin/ooda";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if !path_exists(fs, "oodac/oodac") { fail("no oodac"); }
    if !path_exists(fs, "bin/ooda") { fail("no ooda"); }
    if !path_exists(fs, "fixtures/open_discard_write.oo") { fail("no discard fixture"); }

    let work = tmpd + "/emust_work";
    if process_exec(p, "rm -rf " + work + " && mkdir -p " + work).is_err() { fail("work"); }
    if process_exec(p, "cp fixtures/open_discard_write.oo " + work + "/w.oo").is_err() {
        fail("copy w");
    }
    if process_exec(p, "! " + oodac + " check " + work + "/w.oo > " + work + "/before.out 2> " + work + "/before.err").is_err() {
        fail("w should fail check");
    }
    if process_exec(p, "grep -q 'unused Result' " + work + "/before.out " + work + "/before.err").is_err() {
        fail("w not E_MUST");
    }
    if process_exec(p, "OODA_FS_WRITEDIR=\"$(pwd)\" " + ooda + " fix " + work + "/w.oo --yes > " + work + "/apply.out 2> " + work + "/apply.err").is_err() {
        fail("ooda fix w");
    }
    if process_exec(p, "grep -q 'E_MUST' " + work + "/apply.out " + work + "/apply.err").is_err() {
        fail("apply did not say E_MUST");
    }
    if process_exec(p, "grep -q 'is_err()' " + work + "/w.oo").is_err() {
        fail("is_err missing");
    }
    if process_exec(p, oodac + " check " + work + "/w.oo > " + work + "/after.out 2> " + work + "/after.err").is_err() {
        fail("w recheck");
    }
    if process_exec(p, "grep -qE '^OK' " + work + "/after.out").is_err() {
        fail("w not OK after fix");
    }

    if process_exec(p, "printf '%s\\n' 'pub fn boom() -> Result[Int, String] { return Err(\"x\"); }' 'pub fn main() { boom(); }' > " + work + "/b.oo").is_err() {
        fail("write b");
    }
    if process_exec(p, "OODA_FS_WRITEDIR=\"$(pwd)\" " + ooda + " fix " + work + "/b.oo --yes > " + work + "/b.out 2> " + work + "/b.err").is_err() {
        fail("ooda fix b");
    }
    if process_exec(p, oodac + " check " + work + "/b.oo > " + work + "/b_after.out 2> " + work + "/b_after.err").is_err() {
        fail("b recheck");
    }
    if process_exec(p, "grep -qE '^OK' " + work + "/b_after.out").is_err() {
        fail("b not OK after fix");
    }

    println("emust_autofix_smoke: PASSED");
}
