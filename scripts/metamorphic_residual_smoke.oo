// # Metamorphic Residual Smoke
//
// Logline: bootstrap/METAMORPHIC.oot carries the METAMORPHIC_RESIDUAL_ALPHA marker, fail-closed wording, no "shipped" claim, and the fixture marker line.
// Beats: doc + marker | no product-green claim | fail-closed wording | fixture marker | dual-claim scan | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/METAMORPHIC.oot";
const MARKER: String = "METAMORPHIC_RESIDUAL_ALPHA";
const FIX: String = "ooda/fixtures/metamorphic_marker.oo";
const FIXLINE: String = "METAMORPHIC: residual";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "metamorphic residual honesty");

    // when: doc + marker + no product-green claim
    expect_present(fs, DOC);
    expect_substring(fs, DOC, MARKER);
    expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + DOC + " 2>/dev/null | grep -viE 'not |residual|do not|never|no ' | head -1");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);

    // and: fixture carries the marker line
    expect_present(fs, FIX);
    expect_substring(fs, FIX, FIXLINE);

    // then: no dual-claim on the residual surface (other *.oot files)
    expect_clean(p, "! grep -rn --include='*.oot' -E 'shipped as enforced|fully sealed shipped' " + root + "/ooda/bootstrap 2>/dev/null | grep -v METAMORPHIC.oot | grep -vi residual | head -3");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "metamorphic_residual_smoke");
    println("metamorphic_residual_smoke: PASSED");
}
