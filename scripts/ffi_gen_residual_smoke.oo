// # FFI Gen Residual Stays Honest
//
// Logline: Verify bootstrap/FFI_GEN.oot maintains residual markers and CI wiring without unverified claims.
//
// Setup: FFI_GEN.oot document, ffi_gen_marker fixture, and ci_product.sh exist on disk.
//
// Beats:
//   1. Verify FFI_GEN.oot exists with FFI_GEN_RESIDUAL_ALPHA and fail-closed residual phrasing.
//   2. Check ffi_gen_marker.oo fixture contains the expected residual marker line.
//   3. Confirm ci_product.sh wires ffi_gen_residual_smoke into the test suite.
import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/FFI_GEN.oot";
const FIX: String = "ooda/fixtures/ffi_gen_marker.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let _     = scenario(p, fs, "ffi gen residual honesty");

    // when — doc + marker + no product-green claim
    let _ = expect_present(fs, root + "/" + DOC);
    let _ = expect_substring(fs, root + "/" + DOC, "FFI_GEN_RESIDUAL_ALPHA");
    let _ = expect_clean(p, "! grep -nEi 'fully shipped|enforced in product|sandbox is live' " + root + "/" + DOC + " | grep -viE 'not |residual|do not|never|no '");
    let _ = expect_quiet(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);

    // then — fixture + ci wire
    let _ = expect_present(fs, root + "/" + FIX);
    let _ = expect_substring(fs, root + "/" + FIX, "FFI_GEN: residual");
    let _ = expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "ffi_gen_residual_smoke");

    println("ffi_gen_residual_smoke: PASSED");
}