// # Leftover call-arity prints path and caret
//
// Logline: Cache-cold check of f() with one declared arg shows ERR type, path, the call, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac. Not println.
//
// Beats:
//   1. tc_arity_miss.oo prints ERR type, argument(s) but got, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_println_arity.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/arity_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_arity_miss.oo > " + tmpd +
        "/a.out; echo $? > " + tmpd + "/a.ec; true").is_err() {
        fail("check arity");
    }
    if process_exec(p, "grep -q 'argument(s) but got' " + tmpd +
        "/a.out && grep -q 'tc_arity_miss.oo' " + tmpd +
        "/a.out && grep -Fq -- '-->' " + tmpd + "/a.out && grep -q '\\^' " +
        tmpd + "/a.out && ! grep -qE '^OK' " + tmpd +
        "/a.out && test \"$(cat " + tmpd + "/a.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_println_arity.oo > " + tmpd +
        "/pr.out; echo $? > " + tmpd + "/pr.ec; true").is_err() {
        fail("check println");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/pr.out && grep -q '\\^' " +
        tmpd + "/pr.out && test \"$(cat " + tmpd + "/pr.ec)\" -ne 0").is_err() {
        fail("println caret");
    }
    println("arity_caret_smoke: PASSED");
}
