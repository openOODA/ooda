// # C Emit Walks Pass + Fail Fixture Rails
// Logline: corpus emit-c pass fixtures emit + gcc + run; fail fixtures produce ERR\tc_emit or non-zero exit.
// Setup: oodac/oodac built; bootstrap/seed/oodac as fallback; bootstrap/corpus/emit-c/{pass,fail}/ on disk.
// Beats: 1. pass fixtures emit+gcc+run | 2. fail fixtures emit ERR\tc_emit or non-zero | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "c emit rails");
    let passd = root + "/bootstrap/corpus/emit-c/pass";
    let faild = root + "/bootstrap/corpus/emit-c/fail";

    // when — pass fixtures: emit (try oodac, fallback seed), strip rocket noise, gcc, run with timeout
    let _ = process_exec(p, "fail=0; pass=0; " +
        "for src in " + passd + "/*.oo; do [ -f \"$src\" ] || continue; [[ \"$src\" == *.concat.oo ]] && continue; base=$(basename \"$src\" .oo); " +
        "c=" + tmpd + "/emit_${base}.c; bin=" + tmpd + "/emit_${base}.bin; " +
        "rc=$(" + oodac + " emit-c \"$src\" > \"$c\" 2>" + tmpd + "/emit_${base}.err; echo $?); " +
        "if [ \"$rc\" -ne 0 ] || [ ! -s \"$c\" ]; then " + root + "/bootstrap/seed/oodac emit-c \"$src\" > \"$c\" 2>" + tmpd + "/emit_${base}.err; rc=$?; fi; " +
        "if [ \"$rc\" -ne 0 ]; then echo FAIL_EMIT \"$base\" >> " + tmpd + "/emit_pass.log; fail=1; continue; fi; " +
        "if grep -qE '^ERR' \"$c\"; then echo FAIL_ERR \"$base\" >> " + tmpd + "/emit_pass.log; fail=1; continue; fi; " +
        "grep -v '🚀|Running main' \"$c\" > \"${c}.clean\" 2>/dev/null || true; mv \"${c}.clean\" \"$c\" 2>/dev/null || true; " +
        "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c \"$c\" -o \"$bin\" -lm 2>" + tmpd + "/emit_${base}.gcc; " +
        "if ! timeout 3 \"$bin\" >/dev/null 2>" + tmpd + "/emit_${base}.run; then echo FAIL_RUN \"$base\" >> " + tmpd + "/emit_pass.log; fail=1; continue; fi; " +
        "echo OK \"$base\" >> " + tmpd + "/emit_pass.log; pass=$((pass+1)); done; " +
        "echo \"$pass\" > " + tmpd + "/emit_pass_n; echo \"$fail\" > " + tmpd + "/emit_pass_fail");
    let _ = process_exec(p, "cat " + tmpd + "/emit_pass.log");
    let _ = check(p, "test -s " + tmpd + "/emit_pass_n && test \"$(cat " + tmpd + "/emit_pass_n)\" -ge 1 && test \"$(cat " + tmpd + "/emit_pass_fail)\" -eq 0", 60);

    // and — fail fixtures: emit must produce ERR\tc_emit or non-zero exit
    let _ = process_exec(p, "fail=0; nfail=0; " +
        "for src in " + faild + "/*.oo; do [ -f \"$src\" ] || continue; [[ \"$src\" == *.concat.oo ]] && continue; base=$(basename \"$src\" .oo); " +
        "c=" + tmpd + "/emit_fail_${base}.c; e=" + tmpd + "/emit_fail_${base}.err; " +
        "rc=$(" + oodac + " emit-c \"$src\" > \"$c\" 2> \"$e\"; echo $?); " +
        "if grep -qE '^ERR.c_emit' \"$c\" \"$e\" 2>/dev/null; then nfail=$((nfail+1)); continue; fi; " +
        "if [ \"$rc\" -ne 0 ]; then nfail=$((nfail+1)); continue; fi; " +
        "echo FAIL \"$base\" >> " + tmpd + "/emit_fail.log; fail=1; done; " +
        "echo \"$nfail\" > " + tmpd + "/emit_fail_n; echo \"$fail\" > " + tmpd + "/emit_fail_flag");
    let _ = process_exec(p, "cat " + tmpd + "/emit_fail.log");
    let _ = check(p, "test -s " + tmpd + "/emit_fail_n && test \"$(cat " + tmpd + "/emit_fail_n)\" -ge 1 && test \"$(cat " + tmpd + "/emit_fail_flag)\" -eq 0", 60);

    println("c_emit_smoke: PASSED");
}
