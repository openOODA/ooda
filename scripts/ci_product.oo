// # CI Product Rails
//
// Logline: Local product rails stay green: no host cargo, a shadowed PATH, a pure tree, then every named rail and fixed_point.
//
// Setup: cwd is the product root. oodac/oodac is built. gcc and bash exist.
//
// Beats:
//   1. Product scripts do not invoke cargo or rustc.
//   2. Shadow PATH, RS=0, no Cargo.toml, no src/.
//   3. oodac check bootstrap, named rails, fixed_point, release.
//
// residual: prebuilt oodac required; remote GHA not proven

import "std/scenario.oo";
import "std/sh.oo";
import "scripts/ci_product_rails.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root_raw = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let root = str_replace(str_replace(root_raw, "\n", ""), "\r", "");
    let tmpd_raw = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let tmpd = str_replace(str_replace(tmpd_raw, "\n", ""), "\r", "");
    if !sh_arg_ok(root) || !sh_arg_ok(tmpd) {
        println("FAIL root or tmpd unsafe");
        process_exit(1);
    }
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ci_product local product rails");

    // when product scripts stay clean of host cargo/rustc
    // and PATH shadow intercepts cargo
    // and the tree has no .rs, Cargo.toml, or src/
    // and bootstrap plus every named rail plus fixed_point plus release pass oodac check
    // then ci_product PASSED

    let mut fails: Int = 0;
    let oodac = root + "/oodac/oodac";
    let boot = root + "/scripts/bootstrap_no_cargo.oo";
    let fp = root + "/scripts/fixed_point.oo";
    let rel = root + "/scripts/release.oo";
    if !sh_arg_ok(oodac) || !sh_arg_ok(boot) || !sh_arg_ok(fp) || !sh_arg_ok(rel) {
        println("FAIL script path unsafe");
        process_exit(1);
    }
    if expect_clean(p, "! grep -nE '^[[:space:]]*(cargo|rustc)([[:space:]]|$)' " + boot + " " + fp + " " + rel + " | grep -vE 'grep|comment|#'").is_err() {
        println("FAIL product script invokes host toolchain");
        fails = fails + 1;
    } else {
        println("OK product scripts clean");
    }

    let shadow: String = tmpd + "/ci_product_shadow";
    if !sh_arg_ok(shadow) {
        println("FAIL shadow path unsafe");
        process_exit(1);
    }
    let _ = sh_mkdir_p(fw, shadow);
    let mk = "printf '%s\\n' '#!/bin/sh' 'echo ERR_SHADOW_CARGO >&2' 'exit 99' > " + shadow + "/cargo && printf '%s\\n' '#!/bin/sh' 'echo ERR_SHADOW_RUSTC >&2' 'exit 99' > " + shadow + "/rustc && chmod +x " + shadow + "/cargo " + shadow + "/rustc";
    if check(p, mk, within: 10).is_err() {
        println("FAIL shadow install");
        process_exit(1);
    }
    if expect_quiet(p, "PATH=" + shadow + ":/usr/bin:/bin env -u OODA cargo version >/dev/null 2>&1").is_ok() {
        println("FAIL host toolchain shadow did not intercept");
        fails = fails + 1;
    } else {
        println("OK host toolchain shadowed");
    }

    if expect_quiet(p, "test -z \"$(find " + root + " -name '*.rs' -not -path '*/.git/*' -not -path '*/target/*' -not -path '*/.ooda-cache/*' 2>/dev/null)\"").is_err() {
        println("FAIL RS != 0");
        fails = fails + 1;
    } else {
        println("OK product tree purity: RS=0");
    }
    if expect_absent(fs, root + "/Cargo.toml").is_err() {
        println("FAIL Cargo.toml present");
        fails = fails + 1;
    } else {
        println("OK no Cargo.toml");
    }
    if expect_quiet(p, "test ! -d " + root + "/src").is_err() {
        println("FAIL src/ present");
        fails = fails + 1;
    } else {
        println("OK no src/");
    }

    fails = fails + check_oo_rail(p, fs, oodac, shadow, boot, tmpd, "ci_boot", "bootstrap_no_cargo.oo");
    fails = fails + ci_run_product_rails(p, root, tmpd);
    let fp_n: Int = check_oo_rail(p, fs, oodac, shadow, fp, tmpd, "ci_fp", "fixed_point.oo");
    fails = fails + fp_n;
    if fp_n == 0 {
        if expect_clean(p, "! grep -q OK_HOST " + tmpd + "/ci_fp.out").is_err() {
            println("FAIL OK_HOST in fixed_point log");
            fails = fails + 1;
        } else {
            println("OK no OK_HOST in fixed_point log");
        }
    }
    fails = fails + check_oo_rail(p, fs, oodac, shadow, rel, tmpd, "ci_rel", "release.oo");

    if expect_clean(p, "! grep -rqE 'ERR_SHADOW_CARGO|ERR_SHADOW_RUSTC' " + tmpd + "/ci_ 2>/dev/null").is_err() {
        println("FAIL a rail tried to invoke host toolchain");
        fails = fails + 1;
    } else {
        println("OK no rail invoked host toolchain");
    }

    if fails > 0 {
        println("ci_product: FAILED");
        process_exit(1);
    }
    println("ci_product: PASSED");
    println("residual: prebuilt oodac required; remote GHA not proven");
}

fn check_oo_rail(p: &ProcessCap, fs: &FsReadCap, oodac: String, shadow: String, path: String, tmpd: String, log: String, tag: String) -> Int {
    if expect_present(fs, path).is_err() {
        println("FAIL missing " + tag);
        return 1;
    }
    let outp: String = tmpd + "/" + log + ".out";
    let errp: String = tmpd + "/" + log + ".err";
    if !sh_arg_ok(outp) || !sh_arg_ok(errp) {
        println("FAIL " + tag + " log unsafe");
        return 1;
    }
    let cmd: String = "PATH=" + shadow + ":/usr/bin:/bin " + oodac + " check " + path + " >" + outp + " 2>" + errp;
    if check(p, cmd, within: 180).is_err() {
        println("FAIL oodac check " + tag);
        return 1;
    }
    println("OK oodac check " + tag);
    return 0;
}
