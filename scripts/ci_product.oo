// # CI Product
//
// Logline: product rails stay green when run as the local pre-product suite under cargo-shadow PATH.
// Setup: prebuilt SEED_OODAC (bootstrap/seed/oodac or tree oodac); gcc + bash available.
//
// Beats: no host toolchain in scripts | shadow intercepts cargo | tree pure (no .rs, no Cargo.toml) | every listed rail passes | fixed_point green + no OK_HOST.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(p, tmpd);
    let _ = scenario(p, fs, "ci_product local product rails");

    when "product scripts clean of host toolchain" {
    and  "shadow intercepts cargo/rustc" {
    and  "tree is pure (no .rs, no Cargo.toml)" {
    and  "bootstrap_no_cargo under shadow" {
    and  "every listed rail exits 0" {
    and  "fixed_point green + no OK_HOST" {
    then "ci_product PASSED" {
    } } } } } }

    expect_clean(p, "! grep -nE '^[[:space:]]*(cargo|rustc)([[:space:]]|$)' " + root + "/scripts/bootstrap_no_cargo.sh " + root + "/scripts/fixed_point.sh " + root + "/scripts/release.sh + | grep -vE '^[^:]*:\\s*#'");

    let shadow: String = tmpd + "/ci_shadow";
    let _ = sh_mkdir_p(p, shadow);
    check(p, "printf '#!/bin/sh\\necho ERR_SHADOW\\nexit 99\\n' > " + shadow + "/cargo && printf '#!/bin/sh\\necho ERR_SHADOW\\nexit 99\\n' > " + shadow + "/rustc && chmod +x " + shadow + "/cargo " + shadow + "/rustc", within: 10);

    expect_quiet(p, "PATH=" + shadow + ":/usr/bin:/bin env -u OODA cargo version >/dev/null 2>&1 || true");
    expect_quiet(p, "! PATH=" + shadow + ":/usr/bin:/bin env -u OODA cargo version >/dev/null 2>&1");
    expect_present(fs, root + "/.gitignore");

    expect_quiet(p, "test -z \"$(find " + root + " -name '*.rs' -not -path '*/.git/*' -not -path '*/target/*' -not -path '*/.ooda-cache/*' 2>/dev/null)\"");
    expect_absent(fs, root + "/Cargo.toml");
    expect_absent(fs, root + "/src");

    let seed: String = match sh_env_get_or(p, "SEED_OODAC", root + "/bootstrap/seed/oodac") { Ok(s) => s, Err(_) => "" };
    check(p, "SEED_OODAC=" + seed + " PATH=" + shadow + ":/usr/bin:/bin " + root + "/scripts/bootstrap_no_cargo.sh > " + tmpd + "/ci_boot.out 2> " + tmpd + "/ci_boot.err", within: 600);

    check(p, root + "/scripts/fixed_point.sh > " + tmpd + "/ci_fp.out 2> " + tmpd + "/ci_fp.err", within: 600);
    expect_clean(p, "! grep -q 'OK_HOST' " + tmpd + "/ci_fp.out");
    expect_clean(p, "! grep -rq 'ERR_SHADOW' " + tmpd + "/ci_boot.out " + tmpd + "/ci_boot.err " + tmpd + "/ci_fp.out " + tmpd + "/ci_fp.err 2>/dev/null");

    println("ci_product: PASSED");
}