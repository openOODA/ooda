// # Wasm Caps Hold The Surface
//
// Logline: emit-wasm of a fixture with Fs+Sys caps writes a \0asm module wasmtime can run.
//
// Setup: oodac/oodac built; wasmtime on PATH or WASMTIME.
//
// Beats:
//   1. Compile a capability-bearing fixture to a wasm binary.
//   2. Verify magic \0asm version 1.
//   3. Execute empty _start via wasmtime.
// residual: cap lowering into wasm locals is not this product path.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = match sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac") { Ok(s) => s, Err(_) => root + "/oodac/oodac" };
    let wasmtime = match sh_env_get_or(p, "WASMTIME", "/home/jeryd/.wasmtime/bin/wasmtime") { Ok(s) => s, Err(_) => "wasmtime" };
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm caps surface").is_err() { println("FAIL scenario"); process_exit(1); }
    let src = tmpd + "/test_wasm_caps.oo";
    let wasm = tmpd + "/test_wasm_caps.wasm";
    if process_exec(p, "printf 'fn main(fs: &FsCap, sys: &SysCap) {\\n    let a = 1;\\n}\\n' > " + src).is_err() {
        println("FAIL write src");
        process_exit(1);
    }
    if process_exec(p, oodac + " emit-wasm " + src + " > " + wasm + " 2>" + tmpd + "/emit.err").is_err() {
        println("FAIL emit-wasm");
        process_exit(1);
    }
    if expect_present(fs, wasm).is_err() { println("FAIL no wasm"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N4 " + wasm + " | grep -q '00 61 73 6d'").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    if expect_quiet(p, "test -x " + wasmtime).is_ok() {
        if check(p, "test -s " + wasm + " && " + wasmtime + " " + wasm, 30).is_err() {
            println("FAIL wasmtime");
            process_exit(1);
        }
    }
    println("wasm_caps_smoke: PASSED");
}
