// # Wasm Caps Hold The Surface
// Logline: emit-wasm of a fixture with Fs+Sys caps lowers cleanly and wasmtime runs _start.
// Setup: oodac/oodac built; ~/.wasmtime/bin/wasmtime on PATH.
// Beats: 1. emit-wasm produces .wat | 2. wasmtime runs _start | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root   = sh_realpath(p, ".").unwrap_or(".");
    let tmpd   = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac  = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let wasmtime = sh_env_get_or(p, "WASMTIME", "/root/.wasmtime/bin/wasmtime").unwrap_or("");
    let _v0    = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — compile the caps fixture to .wat
    let src  = tmpd + "/test_wasm_caps.oo";
    let wat  = tmpd + "/test_wasm_caps.wat";
    let _w1  = process_exec(p, "printf 'fn main(fs: &FsCap, sys: &SysCap) {\\n    let a = 1;\\n}\\n' > " + src);
    let _w2  = process_exec(p, oodac + " emit-wasm " + src + " > " + wat + " 2>" + tmpd + "/emit.err");
    fails    = fails + tally(expect_present(p, wat), "emit-wasm produced .wat");
    fails    = fails + tally(expect_quiet(p, "grep -q '^ *(module' " + wat + " || grep -q '(module' " + wat), ".wat has module");

    // and — wasmtime runs _start
    let _w3 = process_exec(p, wasmtime + " " + wat + " --invoke _start > " + tmpd + "/run.out +" 2>" + tmpd + "/run.err");
    fails   = fails + tally(check(p, "test -s " + wat + " && " + wasmtime + " " + wat + " --invoke _start", 30), "wasmtime --invoke _start");

    // then — wrap-up
    if fails > 0 { println("wasm_caps_smoke: FAILED"); process_exit(1); }
    println("wasm_caps_smoke: PASSED");
}
