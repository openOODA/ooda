// ===================================================================
// WASM Caps Smoke Test
// ===================================================================

import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let root = get_root(p);
    let tmp = root + "/oodac_tmp";
    
    let mkdir_res = cmd_exec(p, "mkdir -p " + tmp);
    if !mkdir_res.is_ok() {
        println("Cannot create tmp dir");
        process_exit(1);
    }
    
    let oodac = root + "/oodac/oodac";
    
    // Check compiler exists
    let check_res = cmd_exec(p, "test -f " + oodac);
    if !check_res.is_ok() {
        println("Compiler not found at " + oodac + ". Please build it first.");
        process_exit(1);
    }
    
    // Write test file
    let test_file = tmp + "/test_wasm_caps.oo";
    let write_res = cmd_exec(p, "cat << 'OO' > \"" + test_file + "\"
fn main(fs: &FsCap, sys: &SysCap) {
    let a = 1;
}
OO");
    if !write_res.is_ok() {
        println("Cannot write test file");
        process_exit(1);
    }
    
    // Emit WASM
    let wat_file = tmp + "/test_wasm_caps.wat";
    let emit_res = cmd_exec(p, oodac + " emit-wasm " + test_file + " > " + wat_file);
    if !emit_res.is_ok() {
        println("emit-wasm failed");
        process_exit(1);
    }
    
    // Run with wasmtime
    let wasmtime = "~/.wasmtime/bin/wasmtime";
    let run_res = cmd_exec(p, wasmtime + " " + wat_file + " --invoke _start");
    if !run_res.is_ok() {
        println("wasmtime run failed");
        process_exit(1);
    }
    
    println("WASM CAPS SMOKE OK");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
