// # Wasm Caps Hold The Surface
//
// Logline: emit-wasm of a fixture with Fs+Sys caps lowers cleanly and wasmtime runs _start.
//
// Setup: oodac/oodac built; wasmtime on PATH.
//
// Beats:
//   1. Compile capability-bearing fixture to WebAssembly text.
//   2. Verify module lowered cleanly with Fs and Sys capability signatures.
//   3. Execute _start entry point via wasmtime.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root   = sh_realpath(p, ".").unwrap_or(".");
    let tmpd   = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac  = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let wasmtime = sh_env_get_or(p, "WASMTIME", "/root/.wasmtime/bin/wasmtime").unwrap_or("");
    let _      = sh_mkdir_p(fw, tmpd);
    let _      = scenario(p, fs, "wasm caps surface");

    // when — compile the caps fixture to .wat
    let src  = tmpd + "/test_wasm_caps.oo";
    let wat  = tmpd + "/test_wasm_caps.wat";
    let _    = process_exec(p, "printf 'fn main(fs: &FsCap, sys: &SysCap) {\\n    let a = 1;\\n}\\n' > " + src);
    let _    = process_exec(p, oodac + " emit-wasm " + src + " > " + wat + " 2>" + tmpd + "/emit.err");
    let _    = expect_present(fs, wat);
    let _    = expect_quiet(p, "grep -q '^ *(module' " + wat + " || grep -q '(module' " + wat);

    // and — wasmtime runs _start
    let _    = process_exec(p, wasmtime + " " + wat + " --invoke _start > " + tmpd + "/run.out 2>" + tmpd + "/run.err");
    let _    = check(p, "test -s " + wat + " && " + wasmtime + " " + wat + " --invoke _start", 30);

    println("wasm_caps_smoke: PASSED");
}
