// ===================================================================
// Max Cycles Smoke Test
// ===================================================================
// job: M48 MaxCycles path A product smoke (delegates to enforce + residual rails)
// in:  max_cycles_enforce_smoke + max_cycles_residual_smoke
// out: exit 0 if both green

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    
    let scripts = list_new();
    scripts = list_push(scripts, "max_cycles_enforce_smoke.sh");
    scripts = list_push(scripts, "max_cycles_residual_smoke.sh");
    
    let mut i = 0;
    while i < list_len(scripts) {
        let script = list_get(scripts, i);
        println("=== Running " + script + " ===");
        let res = cmd_exec(p, "bash " + root + "/scripts/" + script);
        if res.is_ok() {
            println("OK " + script);
            tr = test_assert(tr, script, true);
        } else {
            println("FAIL " + script);
            tr = test_assert(tr, script, false);
        }
        i = i + 1;
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        println("max_cycles_smoke: FAILED");
        process_exit(1);
    }
    
    println("max_cycles_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
