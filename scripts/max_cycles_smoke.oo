// # Max Cycles Smoke
//
// Logline: M48 MaxCycles path A product smoke — delegates to enforce + residual rails and exits 0 only if both green.
// Beats: enforce rail | residual rail | both exit 0.

import "std/scenario.oo";
import "std/sh.oo";

const RAILS: List[String] = [
    "max_cycles_enforce_smoke.sh",
    "max_cycles_residual_smoke.sh"
];

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "max cycles path A product smoke");

    // when: each rail script is present and runs green
    let mut i: Int = 0;
    let n: Int = list_len(RAILS);
    while i < n {
        let rail = list_get(RAILS, i);
        expect_clean(p, "test -f " + root + "/ooda/scripts/" + rail);
        let _ = process_exec(p, "bash " + root + "/ooda/scripts/" + rail + " > /tmp/" + rail + ".out 2>&1");
        expect_clean(p, "test $? -eq 0");
        i = i + 1;
    }

    println("max_cycles_smoke: PASSED");
}
