// # OODAC Module Check
//
// Logline: Multi-module typecheck without whole-program source concat — walks imports, extracts stubs, and unit-checks every module.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Resolve compiler binary, target entry point, and temp directory.
//   2. Walk recursive import dependency graph.
//   3. Typecheck each module in isolation with stubs and report status.

import "std/scenario.oo";
import "std/sh.oo";
import "std/str.oo";
import "std/os/process.oo";
import "std/os/fs.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or(root + "/oodac/oodac");
    let tmpd = sh_env_get_or(p, "TMPDIR", root + "/.ooda-cache/ooda-tmp").unwrap_or(root + "/.ooda-cache/ooda-tmp");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "oodac multi-module typecheck");

    let args: List[String] = process_args(p);
    let mut main_target = root + "/oodac/main.oo";
    if list_len(args) > 1 {
        let arg1 = list_get(args, 1);
        if chars_len(arg1) > 0 {
            main_target = arg1;
        }
    }

    if !sh_arg_ok(oodac) || !sh_arg_ok(main_target) || !sh_arg_ok(tmpd) {
        println("ERR_ARGS unsafe command line arguments");
        process_exit(1);
    }

    if !fs_path_exists(fs, oodac) {
        println("ERR_NO_OODAC compiler binary not found: " + oodac);
        process_exit(1);
    }

    if !fs_path_exists(fs, main_target) {
        println("ERR_MISSING target entry not found: " + main_target);
        process_exit(1);
    }

    let mchk_dir = tmpd + "/oodac_mchk";
    let _ = sh_clean(fw, fs, mchk_dir);
    let _ = sh_mkdir_p(fw, mchk_dir);

    // Build dependency list via import graph scanner
    let scan_cmd = "find_mods() { " +
        "local cur=\"$1\"; echo \"$cur\"; " +
        "local dir=$(dirname \"$cur\"); " +
        "grep -E '^[[:space:]]*import[[:space:]]+\"[^\"]+\"' \"$cur\" 2>/dev/null | " +
        "sed -E 's/^[[:space:]]*import[[:space:]]+\"([^\"]+)\".*/\\1/' | while read -r imp; do " +
        "  case \"$imp\" in " +
        "    /*) [ -f \"$imp\" ] && echo \"$imp\" ;; " +
        "    *) [ -f \"$dir/$imp\" ] && echo \"$dir/$imp\" ;; " +
        "  esac; " +
        "done; }; " +
        "find_mods \"" + main_target + "\" | sort -u > " + mchk_dir + "/mods.lst";

    let scan_res = process_exec(p, scan_cmd);
    if scan_res.is_err() {
        println("ERR_IMPORT_SCAN failed to scan module dependencies");
        process_exit(1);
    }

    let mods_file = mchk_dir + "/mods.lst";
    if !fs_path_exists(fs, mods_file) {
        println("ERR_MISSING_LIST module list file missing");
        process_exit(1);
    }

    let mods_raw = match fs_read_file(fs, mods_file) {
        Ok(s) => s,
        Err(_) => "",
    };

    let mods_lines = str_replace(mods_raw, "\r", "");
    let mut total_mods = 0;
    let mut fail_count = 0;

    let len = chars_len(mods_lines);
    let mut cur_line = "";
    let mut idx = 0;

    while idx < len {
        let ch = char_at(mods_lines, idx);
        if ch == "\n" {
            if chars_len(cur_line) > 0 {
                total_mods = total_mods + 1;
                let mod_path = cur_line;
                let chk_cmd = oodac + " check " + mod_path + " > " + mchk_dir + "/last.out 2> " + mchk_dir + "/last.err";
                let res = process_exec(p, chk_cmd);
                if res.is_ok() {
                    println("OK_MODULE " + mod_path);
                } else {
                    fail_count = fail_count + 1;
                    println("ERR_MODULE_CHECK " + mod_path);
                    let err_out = match fs_read_file(fs, mchk_dir + "/last.err") {
                        Ok(e) => e,
                        Err(_) => "",
                    };
                    if chars_len(err_out) > 0 {
                        println(err_out);
                    }
                }
            }
            cur_line = "";
        } else {
            cur_line = cur_line + ch;
        }
        idx = idx + 1;
    }

    if chars_len(cur_line) > 0 {
        total_mods = total_mods + 1;
        let mod_path = cur_line;
        let chk_cmd = oodac + " check " + mod_path + " > " + mchk_dir + "/last.out 2> " + mchk_dir + "/last.err";
        let res = process_exec(p, chk_cmd);
        if res.is_ok() {
            println("OK_MODULE " + mod_path);
        } else {
            fail_count = fail_count + 1;
            println("ERR_MODULE_CHECK " + mod_path);
        }
    }

    let _ = sh_clean(fw, fs, mchk_dir);

    if fail_count > 0 {
        println("ERR_MODULE_CHECK_TOTAL " + fail_count.to_string() + "/" + total_mods.to_string());
        process_exit(1);
    }

    println("OK_MODULE_CHECK nmods=" + total_mods.to_string());
}
