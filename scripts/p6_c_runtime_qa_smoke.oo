// # P6 Walks The C-Runtime Adversarial Floor
// Logline: sys execvp-not-system + clearenv + FFI dlopen + writedir marker + live T3 family.
// Setup: runtime/chs_rt_sys.c + chs_rt_ffi.c + chs_rt_fs.c + scripts/runtime_zt_t3_smoke.sh on disk.
// Beats: 1. sys execvp-not-system | 2. clearenv + OODA env filter | 3. FFI dlopen + writedir | 4. live T3 smoke

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _v0  = sh_mkdir_p(fw, tmpd);
    let _v1  = scenario(p, "p6 c-runtime adversarial");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    let sys  = root + "/runtime/chs_rt_sys.c";
    let ffi  = root + "/runtime/chs_rt_ffi.c";
    let fs   = root + "/runtime/chs_rt_fs.c";

    // when — sys: execvp present; no system(3) outside comments
    fails = fails + tally(check(p, "grep -q 'execvp' " + sys + " && ! grep -vE '^\\s*/\\*|^\\s*\\*' " + sys + " | grep -qE '[^a-z_]system\\s*\\('", 5), "no system(3); execvp present");

    // and — clearenv + OODA_/OO_ env filter markers
    fails = fails + tally(check(p, "grep -q 'clearenv' " + sys + " && grep -qE 'OODA_|OO_' " + sys, 5), "exec env filter markers");

    // and — FFI dlopen/dlsym present
    fails = fails + tally(check(p, "grep -qE 'dlopen|dlsym' " + ffi, 5), "FFI surface dlopen/dlsym");

    // and — FS writedir fail-closed marker
    fails = fails + tally(check(p, "grep -q 'OODA_FS_WRITEDIR' " + fs, 5), "FS writedir fail-closed marker");

    // then — live T3 smoke (if script present)
    fails = fails + tally(check(p, "test -x " + root + "/scripts/runtime_zt_t3_smoke.sh && timeout 60 bash " + root + "/scripts/runtime_zt_t3_smoke.sh > " + tmpd + "/p6_t3.out 2> " + tmpd + "/p6_t3.err; echo rc=$? >> " + tmpd + "/p6_t3.out && grep -q 'rc=0' " + tmpd + "/p6_t3.out", 65), "runtime_zt_t3_smoke exit 0");

    if fails > 0 { println("p6_c_runtime_qa_smoke: FAILED"); process_exit(1); }
    println("p6_c_runtime_qa_smoke: ALL OK");
    println("RESIDUAL: not a full memory fuzzer / ASAN campaign — adversarial wave later");
}
