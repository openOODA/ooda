// # Max Cycles Shared Smoke
//
// Logline: M58 — two whiles in one fn share a single __oo_mc counter; mixed while+for and nested fns share the same budget; helper-fn recursion debits the call entry.
//
// Setup: Process capability and test fixtures available.
// Beats: shared_pass runs under budget | shared_fail exceeds shared budget | mixed while+for pass+fail | nested_fail shared | helper_fail non-main fn fuel.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/mc_shared";
    let _ = sh_mkdir_p(fw, tmp);
    let rt = root + "/ooda/runtime";
    let _ = scenario(p, fs, "max cycles shared per-fn fuel budget");

    // when: shared_pass runs under budget and emits __oo_mc init
    let cp = tmp + "/mcs_pass.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_shared_pass.oo" + " > " + cp + " 2> " + tmp + "/mcs_pass.err");
    expect_clean(p, "grep -E 'long long __oo_mc = 0' " + cp);
    expect_clean(p, "! grep -qE $'^ERR\\t' " + cp);
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + cp + " -o " + tmp + "/mcs_pass.bin -lm");
    expect_clean(p, "timeout 3 " + tmp + "/mcs_pass.bin 2>&1 | grep -qE '4'");

    // and: shared_fail exceeds the combined budget
    let cf = tmp + "/mcs_fail.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_shared_fail.oo" + " > " + cf + " 2> " + tmp + "/mcs_fail.err");
    expect_clean(p, "grep -E 'long long __oo_mc = 0' " + cf);
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + cf + " -o " + tmp + "/mcs_fail.bin -lm");
    expect_clean(p, "! timeout 3 " + tmp + "/mcs_fail.bin 2>&1 | grep -qiE 'max_cycles' || ! timeout 3 " + tmp + "/mcs_fail.bin 2>&1");

    // then: mixed while + for pass+fail share the same counter
    let cmp = tmp + "/mcs_mixp.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_mixed_pass.oo" + " > " + cmp + " 2> " + tmp + "/mcs_mixp.err");
    expect_clean(p, "grep -E 'long long __oo_mc = 0' " + cmp);
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + cmp + " -o " + tmp + "/mcs_mixp.bin -lm");
    expect_clean(p, "timeout 3 " + tmp + "/mcs_mixp.bin 2>&1 | grep -qE '4'");

    let cmf = tmp + "/mcs_mixf.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_mixed_fail.oo" + " > " + cmf + " 2> " + tmp + "/mcs_mixf.err");
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + cmf + " -o " + tmp + "/mcs_mixf.bin -lm");
    expect_clean(p, "! timeout 3 " + tmp + "/mcs_mixf.bin 2>&1 | grep -qiE 'max_cycles' || ! timeout 3 " + tmp + "/mcs_mixf.bin 2>&1");

    // and: nested_fail + helper_fail share the same budget across fns
    let cnf = tmp + "/mcs_nest.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_nested_fail.oo" + " > " + cnf + " 2> " + tmp + "/mcs_nest.err");
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + cnf + " -o " + tmp + "/mcs_nest.bin -lm");
    expect_clean(p, "! timeout 3 " + tmp + "/mcs_nest.bin 2>&1 | grep -qiE 'max_cycles' || ! timeout 3 " + tmp + "/mcs_nest.bin 2>&1");

    let chf = tmp + "/mcs_help.c";
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/max_cycles_helper_fail.oo" + " > " + chf + " 2> " + tmp + "/mcs_help.err");
    let _ = process_exec(p, "gcc -O0 -I " + rt + " " + rt + "/chs_rt.c " + chf + " -o " + tmp + "/mcs_help.bin -lm");
    expect_clean(p, "! timeout 3 " + tmp + "/mcs_help.bin 2>&1 | grep -qiE 'max_cycles' || ! timeout 3 " + tmp + "/mcs_help.bin 2>&1");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_shared_smoke");
    println("max_cycles_shared_smoke: PASSED");
}
