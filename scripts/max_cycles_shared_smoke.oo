// # Max Cycles Shared Smoke
//
// Logline: M58 — two loops in one fn (and mixed while+for) share a single per-fn fuel counter, not per-loop resets.
// Beats: shared_pass run | shared_fail ERR | mixed_pass 4 | mixed_fail ERR | nested+helper.

import "std/scenario.oo";
import "std/sh.oo";

const PASS: String = "ooda/fixtures/max_cycles_shared_pass.oo";
const FAIL: String = "ooda/fixtures/max_cycles_shared_fail.oo";
const MIX_P: String = "ooda/fixtures/max_cycles_mixed_pass.oo";
const MIX_F: String = "ooda/fixtures/max_cycles_mixed_fail.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "max cycles shared per-fn fuel");

    // when: shared_pass emits once-init __oo_mc and runs to 4
    let c_p = root + "/.ooda-cache/ooda-tmp/mcs_pass.c";
    let _ = process_exec(p, oodac + " emit-c " + PASS + " > " + c_p + " 2>/dev/null");
    expect_clean(p, "grep -cE 'long long __oo_mc = 0' " + c_p + " | grep -qE '^[1-9]'");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_p + " -o " + c_p + ".bin -lm", within: 30);
    expect_clean(p, "timeout 3 " + c_p + ".bin 2>&1 | grep -qE '4'");

    // and: shared_fail exceeds combined budget with ERR
    let c_f = root + "/.ooda-cache/ooda-tmp/mcs_fail.c";
    let _ = process_exec(p, oodac + " emit-c " + FAIL + " > " + c_f + " 2>/dev/null");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_f + " -o " + c_f + ".bin -lm", within: 30);
    expect_clean(p, "! timeout 3 " + c_f + ".bin 2>&1 | grep -qiE 'max_cycles'");

    // then: mixed while+for share the same counter (pass=4, fail=ERR)
    let c_mp = root + "/.ooda-cache/ooda-tmp/mcs_mixp.c";
    let _ = process_exec(p, oodac + " emit-c " + MIX_P + " > " + c_mp + " 2>/dev/null");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_mp + " -o " + c_mp + ".bin -lm", within: 30);
    expect_clean(p, "timeout 3 " + c_mp + ".bin 2>&1 | grep -qE '4'");

    let c_mf = root + "/.ooda-cache/ooda-tmp/mcs_mixf.c";
    let _ = process_exec(p, oodac + " emit-c " + MIX_F + " > " + c_mf + " 2>/dev/null");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + root + "/ooda/runtime/chs_rt.c " + c_mf + " -o " + c_mf + ".bin -lm", within: 30);
    expect_clean(p, "! timeout 3 " + c_mf + ".bin 2>&1 | grep -qiE 'max_cycles'");

    // ci wire
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "max_cycles_shared_smoke");
    println("max_cycles_shared_smoke: PASSED");
}
