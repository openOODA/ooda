// # Std Split Residual Smoke
//
// Logline: bootstrap/STD_SPLIT.oot carries the residual marker, fail-closed wording, and non-claims; the fixture wires it via ci_product.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker | fail-closed | non-claims | fixture | ci wire.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "std split residual honesty");

    // when: doc + marker + fail-closed + non-claims
    expect_present(fs, root + "/" + "ooda/bootstrap/STD_SPLIT.oot");
    expect_substring(fs, root + "/" + "ooda/bootstrap/STD_SPLIT.oot", "STD_SPLIT_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fail-closed residual' " + root + "/" + "ooda/bootstrap/STD_SPLIT.oot");
    expect_clean(p, "grep -qiE 'do \\*\\*not\\*\\* claim|not claim' " + root + "/" + "ooda/bootstrap/STD_SPLIT.oot");

    // then: fixture marker line
    expect_present(fs, root + "/" + "ooda/fixtures/std_split_marker.oo");
    expect_substring(fs, root + "/" + "ooda/fixtures/std_split_marker.oo", "STD_SPLIT: residual");

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "std_split_residual_smoke");
    println("std_split_residual_smoke: PASSED");
}
