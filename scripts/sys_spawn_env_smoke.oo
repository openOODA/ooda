// # sys_spawn env filter
//
// Logline: Prove spawn child drops HOME and keeps a reset PATH.
//
// Setup: OODAC_BIN emits C. HOME is set in the child-runner env.
//
// Beats:
//   1. emit-c of fixtures/sys_spawn_env.oo has no ERR.
//   2. gcc links chs_rt.
//   3. HOME=/tmp/leak run prints FILTERED and PATHOK, not LEAK.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "sys_spawn env filter");

    let fix = root + "/fixtures/sys_spawn_env.oo";
    let rt = root + "/runtime";
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmp + "/sp_env.c 2>" + tmp + "/sp_env.err");
    expect_clean(p, "! grep -qE $'^ERR' " + tmp + "/sp_env.c " + tmp + "/sp_env.err");
    expect_clean(p, "gcc -O0 -I" + rt + " " + rt + "/chs_rt.c " + tmp + "/sp_env.c -lm -ldl -lpthread -o " + tmp + "/sp_env.bin");
    expect_clean(p, "HOME=/tmp/should_not_leak " + tmp + "/sp_env.bin 2>&1 | grep -qx FILTERED");
    expect_clean(p, "HOME=/tmp/should_not_leak " + tmp + "/sp_env.bin 2>&1 | grep -qx PATHOK");
    expect_clean(p, "! HOME=/tmp/should_not_leak " + tmp + "/sp_env.bin 2>&1 | grep -q LEAK");
    println("sys_spawn_env_smoke: PASSED");
}
