// # Memory Quota Product Floor Smoke
//
// Logline: PM 3.3 — the three alpha memory-quota sub-smokes (alloc cap, list quota, malloc path A) all pass.
//
// Setup: Process capability and test fixtures available.
// Beats: alloc cap | list quota | malloc path A.

import "std/scenario.oo";
import "std/sh.oo";

const SUBS: List[String] = [
    "alloc_cap_smoke.sh",
    "list_quota_smoke.sh",
    "malloc_path_a_smoke.sh",
];

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = scenario(p, fs, "memory quota product floor");

    // when: each sub-smoke script exits 0
    for sub in SUBS {
        check(p, "bash " + root + "/ooda/scripts/" + sub, within: 180);
    }

    println("memory_quota_product_floor_smoke: PASSED");
}
