// # Leftover cond and return type print path and caret
//
// Logline: Cache-cold check of if 1 and return "no" shows ERR type, path, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac. Fail corpus lives under bootstrap/.
//
// Beats:
//   1. if_int_cond.oo prints ERR type, condition must be Bool, --> path, and ^.
//   2. return_type_mismatch.oo prints does not match declared, --> path, and ^.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/type_caret_batch";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac +
        " check bootstrap/corpus/typecheck/fail/if_int_cond.oo > " + tmpd +
        "/if.out; echo $? > " + tmpd + "/if.ec; true").is_err() {
        fail("check if");
    }
    if process_exec(p, "grep -q 'condition must be Bool' " + tmpd +
        "/if.out && grep -q 'if_int_cond.oo' " + tmpd +
        "/if.out && grep -Fq -- '-->' " + tmpd + "/if.out && grep -q '\\^' " +
        tmpd + "/if.out && ! grep -qE '^OK' " + tmpd +
        "/if.out && test \"$(cat " + tmpd + "/if.ec)\" -ne 0").is_err() {
        fail("if caret");
    }
    if process_exec(p, oodac +
        " check bootstrap/corpus/typecheck/fail/return_type_mismatch.oo > " +
        tmpd + "/ret.out; echo $? > " + tmpd + "/ret.ec; true").is_err() {
        fail("check ret");
    }
    if process_exec(p, "grep -q 'does not match declared' " + tmpd +
        "/ret.out && grep -q 'return_type_mismatch.oo' " + tmpd +
        "/ret.out && grep -Fq -- '-->' " + tmpd + "/ret.out && grep -q '\\^' " +
        tmpd + "/ret.out && ! grep -qE '^OK' " + tmpd +
        "/ret.out && test \"$(cat " + tmpd + "/ret.ec)\" -ne 0").is_err() {
        fail("ret caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("type_caret_class_batch_smoke: PASSED");
}
