// # In-Memory Time-Travel Undo RAM Verification Suite
//
// Logline: Verify type-safety, DINNER compliance, line-count constraints, oodac compilation, and binary execution of undo engine.
//
// Setup: oodac compiler binary built; std/src/ooda/undo modules on disk; fixtures/undo_ram_fixture.oo present.
//
// Beats:
//   1. Check type-safety across undo standard library modules and std/undo.oo entry point.
//   2. Validate DINNER headers and strictly <= 256 line count constraints across all source files.
//   3. Compile and execute undo_ram_fixture binary, proving state snapshotting, delta capture, and rollbacks.
//   4. Verify cyclic ring buffer wrap-around, instant state restoration, and memory checksum consistency.
//   5. Output test summary and emit final PASSED certification.
//
// residual: Hardware MMU dirty-page tracking lowers through kernel uffd subsystem

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let std_r = sh_realpath(p, root + "/../std").unwrap_or(root + "/../std");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, fs, "time-travel undo ram and snapshot engine");

    // Beat 1: Check type safety of undo modules
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/undo/undo_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/undo/undo_journal.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/undo/undo_engine.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/undo/undo.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/undo.oo", 10);

    // Beat 2: Validate line count constraints (strictly <= 256 lines)
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/undo/undo_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/undo/undo_journal.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/undo/undo_engine.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/undo/undo.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/undo.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/fixtures/undo_ram_fixture.oo) -le 256", 5);

    // Beat 3: Check, compile, and execute end-to-end fixture
    let fix = root + "/fixtures/undo_ram_fixture.oo";
    let _ = check(p, oodac + " check " + fix, 10);
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmpd + "/undo_ram.c 2> " + tmpd + "/undo_ram.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/undo_ram.c " + tmpd + "/undo_ram.err 2>/dev/null", 15);
    let _ = process_exec(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/undo_ram.c -lm -ldl -lpthread -o " + tmpd + "/undo_ram.bin 2>" + tmpd + "/undo_ram_gcc.err");
    let _ = process_exec(p, tmpd + "/undo_ram.bin > " + tmpd + "/undo_ram.out 2>&1");
    let _ = check(p, "grep -qx 'UNDO_INIT_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_SNAPSHOT_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_MUTATE_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_ROLLBACK_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_CONSISTENCY_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_RING_WRAP_OK' " + tmpd + "/undo_ram.out", 10);
    let _ = check(p, "grep -qx 'UNDO_RAM_FIXTURE_ALL_PASSED' " + tmpd + "/undo_ram.out", 10);

    // Beat 4: DINNER header verification
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/undo/undo.oo", 5);
    let _ = check(p, "grep -qE '^// Logline: ' " + std_r + "/src/ooda/undo/undo.oo", 5);
    let _ = check(p, "grep -qE '^// Setup: ' " + std_r + "/src/ooda/undo/undo.oo", 5);
    let _ = check(p, "grep -qE '^// Beats:' " + std_r + "/src/ooda/undo/undo.oo", 5);
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/undo.oo", 5);

    println("undo_ram_smoke: PASSED");
}
