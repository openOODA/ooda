// # User-sum underscore covers leftover arms
//
// Logline: Check OK on Flag On|_; Option-only _ still refuses.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. sum_wild_ok.oo prints OK.
//   2. open_match_star.oo does not print OK.
//   3. Both stay under check, not emit.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/sum_wild";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/sum_wild_ok.oo > " + tmpd +
        "/ok.out; echo $? > " + tmpd + "/ok.ec").is_err() {
        fail("check wild");
    }
    if process_exec(p, "grep -qE '^OK' " + tmpd + "/ok.out && test \"$(cat " +
        tmpd + "/ok.ec)\" -eq 0").is_err() {
        fail("wild not OK");
    }
    if process_exec(p, oodac + " check fixtures/open_match_star.oo > " + tmpd +
        "/star.out; echo $? > " + tmpd + "/star.ec; true").is_err() {
        fail("check star");
    }
    if process_exec(p, "! grep -qE '^OK' " + tmpd + "/star.out && test \"$(cat " +
        tmpd + "/star.ec)\" -ne 0").is_err() {
        fail("star not refused");
    }
    println("sum_wild_smoke: PASSED");
}
