// # emit-x86 let-bound const-int ALU lock
//
// Logline: emit-x86 of fixtures/x86_let_mul.oo assembles and prints 6 via as and ld.
//
// Setup: cwd is ooda/. GNU as and ld are on PATH. Host is x86_64. Product oodac/oodac.
//
// Beats:
//   1. emit-x86 writes _start, syscall, and is not C.
//   2. as --64 and ld produce a binary whose stdout is 6, not 2.
//   3. Repeat emit+as+ld+run; both runs print 6.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn emit_as_ld(p: &ProcessCap, fs: &FsReadCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_let_mul_" + tag + ".s";
    let serr = tmpd + "/x86_let_mul_" + tag + ".err";
    if check(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail("emit-x86 " + tag); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail("ERR in .s " + tag); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(".s missing _start " + tag); }
    if expect_substring(fs, sfile, "syscall").is_err() { fail(".s missing syscall " + tag); }
    if expect_clean(p, "! grep -qE '#include|int main\\(|chs_rt|OoStr ' " + sfile).is_err() {
        fail(".s looks like emit-c " + tag);
    }
    if expect_substring(fs, sfile, ".ascii \"6").is_err() { fail("missing ascii 6 " + tag); }
    if expect_clean(p, "! grep -q '.ascii \\\"2' " + sfile).is_err() { fail("bound first literal 2 " + tag); }
    let obj = tmpd + "/x86_let_mul_" + tag + ".o";
    let bin = tmpd + "/x86_let_mul_" + tag + ".bin";
    let out = tmpd + "/x86_let_mul_" + tag + ".out";
    if check(p, "as --64 -o " + obj + " " + sfile, 10).is_err() { fail("as " + tag); }
    if check(p, "ld -o " + bin + " " + obj, 10).is_err() { fail("ld " + tag); }
    if check(p, bin + " > " + out + " 2>&1", 5).is_err() { fail("run " + tag); }
    if expect_clean(p, "grep -qx 6 " + out).is_err() { fail("stdout not 6 " + tag); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 let bound mul").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let src = root + "/fixtures/x86_let_mul.oo";
    if expect_present(fs, src).is_err() { fail("no x86_let_mul.oo"); }
    emit_as_ld(p, fs, oodac, src, tmpd, "r1");
    emit_as_ld(p, fs, oodac, src, tmpd, "r2");
    println("x86_let_mul_smoke: PASSED");
}
