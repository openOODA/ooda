// # Contract Fuzzing and Ghost-State Verification Smoke
//
// Logline: Verify contract fuzzer generators, boundary value exploration, and ghost-state snapshot rollback.
//
// Setup: Process, read, and write capabilities available.
//
// Beats:
//   1. Check all fuzz and proofs standard library modules and fixtures.
//   2. Build and run contract fuzz fixture verifying requires/ensures execution.
//   3. Verify boundary fuzzing, counterexample generation, and ghost-state rollback properties.
//
// residual: Dynamic symbolic execution hooks connect to SMT backend solver

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "Contract fuzzing and ghost state verification");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/contract_fuzz_fixture.oo");
    expect_present(fs, root + "/../std/src/ooda/fuzz/fuzz.oo");
    expect_present(fs, root + "/../std/src/ooda/proofs/ghost_state.oo");

    // 1. Check all fuzz standard library files
    check(p, oodac + " check " + root + "/../std/src/ooda/fuzz/fuzz_types.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/fuzz/fuzz_generator.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/fuzz/fuzz_mutator.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/fuzz/fuzz_engine.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/fuzz/fuzz.oo", within: 30);

    // 2. Check all ghost state standard library files
    check(p, oodac + " check " + root + "/../std/src/ooda/proofs/ghost_state_types.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/proofs/ghost_state_ops.oo", within: 30);
    check(p, oodac + " check " + root + "/../std/src/ooda/proofs/ghost_state.oo", within: 30);

    // 3. Build and execute the contract fuzz fixture
    let fix_bin: String = tmpd + "/contract_fuzz_fixture_bin";
    check(p, oodac + " build " + root + "/fixtures/contract_fuzz_fixture.oo " + fix_bin + " > " + tmpd + "/fix_b.out 2> " + tmpd + "/fix_b.err", within: 60);
    expect_clean(p, "test -x " + fix_bin);
    expect_clean(p, "out=$(" + fix_bin + " 2>&1) && echo \"$out\" | grep -q '30' && echo \"$out\" | grep -q '100' && echo \"$out\" | grep -q '400'");

    println("contract_fuzz_smoke: PASSED");
}
