// # Release Ooda CLI — Build, Test, Verify
//
// Logline: Run build, then the qa probes twice, then the surface verify. Fail closed on the first miss.
//
// Setup: Requires OODA_COMPILER. ProcessCap execs oodac.

import "std/fs/process/cmd.oo";
import "build/find_compiler.oo";
import "build/host_run.oo";

fn run_or_err(p: &ProcessCap, oodac: String, file: String) -> Result[Int, String] {
    let r: Result[String, String] = sys_exec(p, oodac, "run", file);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err(file + ": " + e);
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let oodac: String = find_oodac(fs_r, env);
    refuse_cli(p, oodac);
    println("Release: step 1/3 build");
    let b: Result[String, String] = sys_exec(p, oodac, "build", "main.oo");
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("build: " + e);
    }
    println("Release: step 2/3 test");
    let t: Result[Int, String] = run_or_err(p, oodac, "scripts/test.oo");
    if t.is_err() { return t; }
    println("Release: step 3/3 verify");
    let v: Result[Int, String] = run_or_err(p, oodac, "scripts/verify.oo");
    if v.is_err() { return v; }
    return Ok(0);
}
