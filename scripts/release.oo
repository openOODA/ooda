// # Release Packager Rails
//
// Logline: Release packager rails hold without packing dist: pin or residual default, executable binaries, no cargo/rustc invoke, dress hook named, no Cargo.toml.
//
// Setup: cwd is the product root; bin/ooda and oodac/oodac are built; scripts/release.sh remains the tarball packer.
//
// Beats:
//   1. Pin install/BOOTSTRAP_PIN or residual default 0.187.0-alpha.
//   2. bin/ooda, oodac/oodac, and scripts/release.sh present.
//   3. No cargo/rustc command, dress hook named, no Cargo.toml.
//
// residual: tarball+sha256 pack stays scripts/release.sh until native copy exists

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let pin = "install/BOOTSTRAP_PIN";
    let ooda = "bin/ooda";
    let oodac = "oodac/oodac";
    let rel = "scripts/release.sh";
    let cargo_toml = "Cargo.toml";
    let _ = scenario(p, fs, "release packager rails");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when pin file present or residual default lives in release.sh
    // and bin/ooda and oodac/oodac are executable
    // and release.sh is present and never invokes cargo/rustc
    // and dress hook install_dress_rehearsal is named
    // then no Cargo.toml in the product root

    if !sh_arg_ok(pin) || !sh_arg_ok(ooda) || !sh_arg_ok(oodac) || !sh_arg_ok(rel) || !sh_arg_ok(cargo_toml) {
        println("FAIL sh_arg_ok path");
        process_exit(1);
    }

    let pin_here = expect_present(fs, pin);
    if pin_here.is_ok() {
        fails = fails + tally(pin_here, "install/BOOTSTRAP_PIN");
    } else {
        fails = fails + tally(expect_substring(fs, rel, "0.187.0-alpha"), "residual pin default");
    }

    fails = fails + tally(expect_quiet(p, "test -x " + ooda), "bin/ooda executable");
    fails = fails + tally(expect_quiet(p, "test -x " + oodac), "oodac/oodac executable");
    fails = fails + tally(expect_present(fs, rel), "scripts/release.sh present");

    let no_host = "! grep -nE '^[[:space:]]*(cargo|rustc)([[:space:]]|$)' " + rel + " | grep -vE 'grep|comment|#'";
    fails = fails + tally(expect_clean(p, no_host), "release.sh never invokes cargo/rustc");
    fails = fails + tally(expect_substring(fs, rel, "install_dress_rehearsal"), "dress hook named");
    fails = fails + tally(expect_absent(fs, cargo_toml), "no Cargo.toml");

    if fails > 0 {
        println("release.oo: FAILED");
        process_exit(1);
    }
    println("release.oo: PASSED");
}
