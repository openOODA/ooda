// # Release Ooda CLI — Build, Test, Verify, Tarball
//
// Logline: Run the 4 release steps in sequence.

import "std/process/sys.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String> {
    println("Release: step 1/4 build");
    println("Release: step 2/4 test");
    println("Release: step 3/4 verify");
    println("Release: step 4/4 tarball -> ooda-0.1.0.tar.gz");
    return Ok(0);
}
