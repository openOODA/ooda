// # F20 Inventory Holds
//
// Logline: ooda/std shows 34 .oo files at f20 line counts with no phantoms.
//
// Setup: ooda/std is the v0.184.x tree, no in-flight edits.
//
// Beats:
//   1. count = 34 | 2. line counts | 3. phantom guard

import "std/scenario.oo";
import "std/sh.oo";

let expected_count: Int = 34;
let line_counts: List = [
    ("core/crypto.oo", 39), ("os/fs.oo", 83), ("hash/sha256.oo", 9),
    ("os/env.oo", 7), ("os/cmd.oo", 55), ("os/process.oo", 61),
    ("str.oo", 92), ("test.oo", 67),
];
let allow: List[String] = [
    "ooda/std/archive/gzip.oo", "ooda/std/archive/tar.oo", "ooda/std/archive/zip.oo", "ooda/std/byte.oo",
    "ooda/std/core/crypto.oo", "ooda/std/core/json.oo", "ooda/std/core/option.oo", "ooda/std/core/result.oo", "ooda/std/core/str.oo",
    "ooda/std/hash/md5.oo", "ooda/std/hash/sha1.oo", "ooda/std/hash/sha256.oo",
    "ooda/std/markup/json_schema.oo", "ooda/std/markup/toml.oo", "ooda/std/markup/xml.oo", "ooda/std/markup/yaml.oo",
    "ooda/std/math.oo", "ooda/std/math/tensor.oo", "ooda/std/option.oo",
    "ooda/std/os/async.oo", "ooda/std/os/cmd.oo", "ooda/std/os/env.oo", "ooda/std/os/fs.oo", "ooda/std/os/gpu.oo",
    "ooda/std/os/net.oo", "ooda/std/os/process.oo", "ooda/std/os/python.oo", "ooda/std/os/sync.oo", "ooda/std/os/thread.oo",
    "ooda/std/result.oo", "ooda/std/semver.oo", "ooda/std/src/net/dns.oo", "ooda/std/str.oo", "ooda/std/test.oo",
];
const STD: String = "ooda/std";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    scenario(p, fs, "F20 inventory smoke");
    // when probed, check count + line counts, then expect no phantoms
    expect_count(fs, STD, ".oo", expected_count);
    expect_line_count(fs, STD + "/core/crypto.oo", 39); expect_line_count(fs, STD + "/os/fs.oo", 83);
    expect_line_count(fs, STD + "/hash/sha256.oo", 9); expect_line_count(fs, STD + "/os/env.oo", 7);
    expect_line_count(fs, STD + "/os/cmd.oo", 55); expect_line_count(fs, STD + "/os/process.oo", 61);
    expect_line_count(fs, STD + "/str.oo", 92); expect_line_count(fs, STD + "/test.oo", 67);
    expect_no_phantoms(fs, STD, allow);
}
