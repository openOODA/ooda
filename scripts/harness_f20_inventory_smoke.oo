// # F20 Inventory Holds
//
// Logline: ooda/std shows 39 .oo files at current line counts with no phantoms.
//
// Setup: ooda/std is the live tree. Caps are injected.
//
// Beats:
//   1. count = 39.
//   2. line-count samples (current wc).
//   3. phantom guard: .oo on disk not in allowlist.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let STD: String = "ooda/std";
    let EXPECTED: Int = 39;
    let ALLOW: List[String] = [
        "ooda/std/archive/gzip.oo", "ooda/std/archive/tar.oo", "ooda/std/archive/zip.oo", "ooda/std/byte.oo",
        "ooda/std/core/crypto.oo", "ooda/std/core/json.oo", "ooda/std/core/option.oo", "ooda/std/core/result.oo", "ooda/std/core/str.oo",
        "ooda/std/hash/md5.oo", "ooda/std/hash/sha1.oo", "ooda/std/hash/sha256.oo",
        "ooda/std/macro.oo",
        "ooda/std/markup/json_schema.oo", "ooda/std/markup/toml.oo", "ooda/std/markup/xml.oo", "ooda/std/markup/yaml.oo",
        "ooda/std/math.oo", "ooda/std/math/tensor.oo", "ooda/std/net/http.oo", "ooda/std/option.oo",
        "ooda/std/os/async.oo", "ooda/std/os/cmd.oo", "ooda/std/os/env.oo", "ooda/std/os/fs.oo", "ooda/std/os/gpu.oo",
        "ooda/std/os/net.oo", "ooda/std/os/process.oo", "ooda/std/os/python.oo", "ooda/std/os/sync.oo", "ooda/std/os/thread.oo",
        "ooda/std/result.oo", "ooda/std/scenario.oo", "ooda/std/semver.oo", "ooda/std/sh.oo", "ooda/std/src/net/dns.oo",
        "ooda/std/str.oo", "ooda/std/_template.oo", "ooda/std/test.oo",
    ];
    let _ = scenario(p, fs, "F20 inventory smoke");

    // when inventory probed, 39 .oo files present
    // and current line-count invariants hold
    // then no phantom .oo outside allowlist

    expect_count(fs, STD, ".oo", EXPECTED);
    expect_line_count(fs, STD + "/core/crypto.oo", 45);
    expect_line_count(fs, STD + "/os/fs.oo", 197);
    expect_line_count(fs, STD + "/hash/sha256.oo", 17);
    expect_line_count(fs, STD + "/os/env.oo", 16);
    expect_line_count(fs, STD + "/os/cmd.oo", 62);
    expect_line_count(fs, STD + "/os/process.oo", 62);
    expect_line_count(fs, STD + "/str.oo", 131);
    expect_line_count(fs, STD + "/test.oo", 67);
    expect_no_phantoms(fs, STD, ALLOW);
    println("harness_f20_inventory_smoke: PASSED");
}
