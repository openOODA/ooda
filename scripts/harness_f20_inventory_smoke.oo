import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";
fn chk(p: &ProcessCap, dir: String, rel: String, want: String) -> Bool {
    let got = match process_exec(p, "wc -l <" + dir + "/" + rel + " | tr -d \" \\n\"") { Ok(s) => s, Err(e) => e };
    if str_eq(got, want) { println("OK lines " + rel + "=" + want); return true; }
    println("FAIL lines " + rel + " got=" + got + " want=" + want); return false;
}
pub fn main(p: &ProcessCap, fs: &FsReadCap, sys: &SysCap) {
    let dir = "ooda/std";
    let mut fails: Int = 0;
    let want = "archive/gzip.oo|archive/tar.oo|archive/zip.oo|byte.oo|core/crypto.oo|core/json.oo|core/option.oo|core/result.oo|core/str.oo|hash/md5.oo|hash/sha1.oo|hash/sha256.oo|markup/json_schema.oo|markup/toml.oo|markup/xml.oo|markup/yaml.oo|math.oo|math/tensor.oo|option.oo|os/async.oo|os/cmd.oo|os/env.oo|os/fs.oo|os/gpu.oo|os/net.oo|os/process.oo|os/python.oo|os/sync.oo|os/thread.oo|result.oo|semver.oo|src/net/dns.oo|str.oo|test.oo";
    let al = want.split("|");
    let n = list_len(al);
    let c = match process_exec(p, "find " + dir + " -name '*.oo' | wc -l | tr -d \" \\n\"") { Ok(s) => s, Err(e) => e };
    if str_eq(c, "34") { println("OK count=34"); } else { println("FAIL count=" + c + " (expected 34)"); fails = fails + 1; }
    let mut ok: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let rel = list_get(al, i);
        if fs_path_exists(fs, dir + "/" + rel) == false { println("FAIL missing " + rel); ok = false; }
        i = i + 1;
    }
    if ok { println("OK all 34 files exist"); } else { fails = fails + 1; }
    if chk(p, dir, "core/crypto.oo", "39") == false { fails = fails + 1; }
    if chk(p, dir, "os/fs.oo", "83") == false { fails = fails + 1; }
    if chk(p, dir, "hash/sha256.oo", "9") == false { fails = fails + 1; }
    if chk(p, dir, "os/env.oo", "7") == false { fails = fails + 1; }
    if chk(p, dir, "os/cmd.oo", "55") == false { fails = fails + 1; }
    if chk(p, dir, "os/process.oo", "61") == false { fails = fails + 1; }
    if chk(p, dir, "str.oo", "92") == false { fails = fails + 1; }
    if chk(p, dir, "test.oo", "67") == false { fails = fails + 1; }
    let _ = process_exec(p, "printf '%s\\n' '" + want + "' | tr '|' '\\n' | sort > /tmp/f20_allow.txt");
    let _ = process_exec(p, "find " + dir + " -name '*.oo' -printf '%P\\n' | sort > /tmp/f20_found.txt");
    let ph = match process_exec(p, "comm -23 /tmp/f20_found.txt /tmp/f20_allow.txt | tr -d '\\n'") { Ok(s) => s, Err(e) => e };
    if str_is_empty(ph) { println("OK no phantom files"); } else { println("FAIL phantom: " + ph); fails = fails + 1; }
    if fails > 0 { println("harness_f20_inventory_smoke: FAILED"); process_exit(1); }
    println("harness_f20_inventory_smoke: ALL OK");
}
