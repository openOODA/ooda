// # OPEN-60 Official Self-Host
//
// Logline: Seed or tree compiler checks and emits oodac/main.oo with check on; that binary checks the same tree.
//
// Setup: cwd is ooda/. bootstrap/oodac_pure_build exists. Do not overwrite oodac/oodac.
//
// Beats:
//   1. Refuse a CLI host (ERR_OODAC_IS_CLI).
//   2. Prefer seed; host-fallback is ./oodac/oodac when seed cannot check.
//   3. Official rebuild to oodac_official; that binary checks oodac/main.oo.
//
// Parent (from ooda/), check ON, no PURE_SKIP_CHECK:
//   OFF=/tmp/grok-goal-188cba2f8bdf/implementer/open60-92/oodac_official
//   mkdir -p "$(dirname "$OFF")"
//   if grep -a -q 'pure .oo product CLI' bootstrap/seed/oodac; then echo ERR_OODAC_IS_CLI; exit 1; fi
//   if grep -a -q 'oodac: usage:' bootstrap/seed/oodac; then
//     HOST=./bootstrap/seed/oodac
//   else
//     HOST=./oodac/oodac
//   fi
//   if grep -a -q 'pure .oo product CLI' "$HOST"; then echo ERR_OODAC_IS_CLI "$HOST"; exit 1; fi
//   env -u PURE_SKIP_CHECK OODAC_BIN="$HOST" bash bootstrap/oodac_pure_build oodac/main.oo "$OFF"
//   test -x "$OFF" && grep -a -q 'oodac: usage:' "$OFF"
//   ! grep -a -q 'pure .oo product CLI' "$OFF"
//   env -u PURE_SKIP_CHECK "$OFF" check oodac/main.oo
//   env -u PURE_SKIP_CHECK OODAC_BIN="$OFF" bash bootstrap/oodac_pure_build oodac/main.oo "${OFF}.gen2"

import "std/scenario.oo";
import "std/sh.oo";
import "scripts/oodac_identity.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let official = "/tmp/grok-goal-188cba2f8bdf/implementer/open60-92/oodac_official";
    let offdir = "/tmp/grok-goal-188cba2f8bdf/implementer/open60-92";
    let seed = root + "/bootstrap/seed/oodac";
    let tree = root + "/oodac/oodac";
    let builder = root + "/bootstrap/oodac_pure_build";
    if scenario(p, fs, "OPEN-60 official self-host").is_err() {
        println("FAIL scenario");
        process_exit(1);
    }
    if expect_present(fs, builder).is_err() {
        println("FAIL missing bootstrap/oodac_pure_build");
        process_exit(1);
    }
    if expect_present(fs, root + "/oodac/main.oo").is_err() {
        println("FAIL missing oodac/main.oo");
        process_exit(1);
    }
    if sh_mkdir_p(fw, offdir).is_err() {
        println("FAIL mkdir official dir");
        process_exit(1);
    }

    let host = pick_official_host(p, seed, tree);
    refuse_oodac_cli(p, host);
    if process_exec(p, "grep -a -q 'oodac: usage:' " + host).is_err() {
        println("ERR_OODAC_NOT_COMPILER " + host);
        process_exit(1);
    }
    println("open60_selfhost: host=" + host);
    println("open60_selfhost: official=" + official);

    let build1 = "cd " + root + " && env -u PURE_SKIP_CHECK OODAC_BIN=" + host
        + " bash " + builder + " " + root + "/oodac/main.oo " + official;
    if check(p, build1, within: 3600).is_err() {
        println("FAIL official rebuild");
        process_exit(1);
    }
    if expect_quiet(p, "test -x " + official).is_err() {
        println("FAIL official not executable");
        process_exit(1);
    }
    refuse_oodac_cli(p, official);
    if process_exec(p, "grep -a -q 'oodac: usage:' " + official).is_err() {
        println("ERR_OODAC_NOT_COMPILER " + official);
        process_exit(1);
    }

    let ck = "cd " + root + " && env -u PURE_SKIP_CHECK " + official + " check " + root + "/oodac/main.oo";
    if check(p, ck, within: 900).is_err() {
        println("FAIL official check oodac/main.oo");
        process_exit(1);
    }

    let gen2 = official + ".gen2";
    let build2 = "cd " + root + " && env -u PURE_SKIP_CHECK OODAC_BIN=" + official
        + " bash " + builder + " " + root + "/oodac/main.oo " + gen2;
    if check(p, build2, within: 3600).is_err() {
        println("FAIL gen2 rebuild");
        process_exit(1);
    }
    println("open60_selfhost: PASSED official=" + official + " gen2=" + gen2);
}

fn pick_official_host(p: &ProcessCap, seed: String, tree: String) -> String {
    if expect_quiet(p, "test -x " + seed).is_ok() {
        if process_exec(p, "grep -a -q 'pure .oo product CLI' " + seed).is_ok() {
            println("ERR_OODAC_IS_CLI " + seed);
            process_exit(1);
        }
        if process_exec(p, "grep -a -q 'oodac: usage:' " + seed).is_ok() {
            return seed;
        }
    }
    if expect_quiet(p, "test -x " + tree).is_ok() {
        if process_exec(p, "grep -a -q 'pure .oo product CLI' " + tree).is_ok() {
            println("ERR_OODAC_IS_CLI " + tree);
            process_exit(1);
        }
        if process_exec(p, "grep -a -q 'oodac: usage:' " + tree).is_ok() {
            return tree;
        }
    }
    println("ERR_NO_OODAC");
    process_exit(1);
    return "";
}
