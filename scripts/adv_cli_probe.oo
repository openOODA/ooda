// # Adversarial CLI Style, Prompt, and Completion Probe
//
// Logline: Hostile stress-testing of CLI ANSI truecolor styling, prompt parsers, and shell completion generators.
//
// Setup: Validates openOODA std/cli styling and completion engines under hostile and boundary inputs.
//
// Beats:
//   1. Stress-test ANSI 24-bit TrueColor and padding formatters on empty and boundary strings.
//   2. Probe interactive prompt parsers against malformed, out-of-range, and empty responses.
//   3. Probe Bash, Zsh, and Fish completion generators for empty and complex binary definitions.
//   4. Assert all prompt and completion fallbacks fail-close.

import "std/cli/cli_style.oo";
import "std/cli/cli_prompt.oo";
import "std/cli/cli_completion.oo";

pub fn main(p: &ProcessCap) {
    println("=== Adversarial CLI Engine Probe ===");

    // 1. Style and ANSI Engine Boundary Conditions
    let c_white: CliColor = cli_color_rgb(255, 255, 255);
    let mut st: CliTextStyle = cli_style_new();
    st = cli_style_fg(st, c_white);
    st = cli_style_underline(st, true);

    let styled_empty: String = cli_style_apply(st, "");
    if !str_contains(styled_empty, "\x1b[0m") {
        println("FAIL: Empty string styling must include reset code");
        process_exit(1);
    }

    let pad_neg: String = cli_style_pad_left("hello", -5);
    if pad_neg != "hello" {
        println("FAIL: Negative padding must return original string");
        process_exit(1);
    }

    let div_zero: String = cli_style_divider(0, "=");
    if div_zero != "" {
        println("FAIL: 0-length divider must return empty string");
        process_exit(1);
    }
    println("  [PASS] ANSI Styling & layout boundaries");

    // 2. Prompt Parser Hostile Fuzzing
    let conf_y: Bool = cli_prompt_parse_confirm("Y", false);
    let conf_yes: Bool = cli_prompt_parse_confirm("yes", false);
    let conf_1: Bool = cli_prompt_parse_confirm("1", false);
    let conf_true: Bool = cli_prompt_parse_confirm("true", false);
    let conf_garbage: Bool = cli_prompt_parse_confirm("maybe_later", true);

    println("conf_y: " + if conf_y { "T" } else { "F" });
    println("conf_yes: " + if conf_yes { "T" } else { "F" });
    println("conf_1: " + if conf_1 { "T" } else { "F" });
    println("conf_true: " + if conf_true { "T" } else { "F" });
    println("conf_garbage: " + if conf_garbage { "T" } else { "F" });

    if !conf_y || !conf_yes || !conf_1 || !conf_true || !conf_garbage {
        println("FAIL: Confirm prompt parsing mismatch");
        process_exit(1);
    }

    let sel_oob_high: Result[Int, String] = cli_prompt_parse_select("10", 3);
    let sel_oob_zero: Result[Int, String] = cli_prompt_parse_select("0", 3);
    let sel_alpha: Result[Int, String] = cli_prompt_parse_select("abc", 3);

    match sel_oob_high {
        Ok(v) => { println("FAIL: OOB high selection must fail"); process_exit(1); }
        Err(e) => {}
    }
    match sel_oob_zero {
        Ok(v) => { println("FAIL: Selection 0 must fail (1-based)"); process_exit(1); }
        Err(e) => {}
    }
    match sel_alpha {
        Ok(v) => { println("FAIL: Non-numeric selection must fail"); process_exit(1); }
        Err(e) => {}
    }
    println("  [PASS] Interactive prompt parser defensive validation");

    // 3. Multi-Shell Completion Generators
    let gen_empty: CliCompletionGenerator = cli_completion_generator_new("", "", "");
    let bash_out: String = cli_completion_render_bash(gen_empty);
    let zsh_out: String = cli_completion_render_zsh(gen_empty);
    let fish_out: String = cli_completion_render_fish(gen_empty);

    if !str_contains(bash_out, "complete -F") || !str_contains(zsh_out, "#compdef") || !str_contains(fish_out, "complete -c") {
        println("FAIL: Shell completion skeleton generation failed");
        process_exit(1);
    }
    println("  [PASS] Shell completion generator resilience");

    println("adv_cli_probe: ALL PASS");
}
