// # OPEN-52 stale leftover lock
//
// Logline: Fail closed when nine boards restate stale leftover words as present-tense product outside the closed log.
//
// Setup: cwd is ooda/. Boards dir is ../openOODA/. process_exec greps boards. C emit plus gcc remains product.
//
// Beats:
//   1. Eight boards contain none of the five stale present-tense tokens.
//   2. ROADMAP allows those tokens only after Closed stale-word or do not reopen, before the next ## heading.
//   3. ROADMAP still has RAM-cold 164s and 179 modules. Print that C emit plus gcc remains product.
// residual: C emit plus gcc remains the product path. Not gcc retired.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap) {
    let b = "../openOODA";
    if process_exec(p, "test -d " + b).is_err() {
        fail("boards dir ../openOODA/ missing");
    }

    let present = "test -f " + b + "/START.oot"
        + " && test -f " + b + "/RULES.oot"
        + " && test -f " + b + "/NORTHSTAR.oot"
        + " && test -f " + b + "/MOONSHOTS.oot"
        + " && test -f " + b + "/SHIPPED.oot"
        + " && test -f " + b + "/FORMAT.oot"
        + " && test -f " + b + "/SECURITY.oot"
        + " && test -f " + b + "/WORKFLOW.oot"
        + " && test -f " + b + "/ROADMAP.oot";
    if process_exec(p, present).is_err() {
        fail("a named board is missing");
    }

    let stale = "-e 523s -e '174 modules' -e 'No live registry'"
        + " -e 'AES still exits' -e 'Clang link of full oodac is next'";
    let eight = b + "/START.oot " + b + "/RULES.oot " + b + "/NORTHSTAR.oot "
        + b + "/MOONSHOTS.oot " + b + "/SHIPPED.oot " + b + "/FORMAT.oot "
        + b + "/SECURITY.oot " + b + "/WORKFLOW.oot";
    if process_exec(p, "grep -F -q " + stale + " " + eight).is_ok() {
        fail("stale present-tense token on a board outside the closed log");
    }
    if process_exec(p, "grep -F -q 523s " + b + "/SHIPPED.oot").is_ok() {
        fail("SHIPPED has present-tense 523s");
    }

    let win = "awk '"
        + "BEGIN { allow=0 } "
        + "/^## / && /Closed stale-word|do not reopen/ { allow=1; next } "
        + "/^### / && /Closed stale-word|do not reopen/ { allow=1; next } "
        + "/^## / { allow=0 } "
        + "allow==0 && /523s/ { exit 1 } "
        + "allow==0 && /174 modules/ { exit 1 } "
        + "allow==0 && /No live registry/ { exit 1 } "
        + "allow==0 && /AES still exits/ { exit 1 } "
        + "allow==0 && /Clang link of full oodac is next/ { exit 1 } "
        + "' " + b + "/ROADMAP.oot";
    if process_exec(p, win).is_err() {
        fail("ROADMAP stale token outside Closed stale-word / do not reopen window");
    }

    if process_exec(p, "grep -E -q 'RAM-cold.{0,80}164s' " + b + "/ROADMAP.oot").is_err() {
        fail("ROADMAP missing live RAM-cold 164s");
    }
    if process_exec(p, "grep -F -q '179 modules' " + b + "/ROADMAP.oot").is_err() {
        fail("ROADMAP missing live 179 modules");
    }

    println("open52_stale_smoke: C emit plus gcc remains product");
    println("open52_stale_smoke: PASSED");
}
