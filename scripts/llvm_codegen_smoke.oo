// # LLVM Codegen Smoke
//
// Logline: Proves the deepened LLVM IR backend across integer/float arithmetic, GEP struct access and mutation, ARC retain/release, and control flow.
//
// Setup: Process and filesystem capabilities available; clang or llc on PATH.
//
// Beats:
//   1. Check and emit LLVM IR for fixtures/llvm_fixture.oo.
//   2. Verify emitted IR contains expected arithmetic, float, GEP, ARC, and control flow instructions.
//   3. Compile with clang and chs_rt into a native binary.
//   4. Execute binary and verify stdout matches all milestone outputs.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root: String = sh_realpath(p, ".").unwrap_or(".");
    let oodac: String = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let rt: String = root + "/runtime";
    let tmp: String = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "llvm codegen smoke — arithmetic, structs, arc, control");

    expect_clean(p, "test -x " + oodac);

    // 1. Typecheck the fixture
    check(p, oodac + " check fixtures/llvm_fixture.oo > " + tmp + "/llvm_fix_check.out 2>&1", within: 30);

    // 2. Emit LLVM IR
    let fix_ll: String = tmp + "/llvm_fixture.ll";
    check(p, oodac + " emit-llvm fixtures/llvm_fixture.oo > " + fix_ll + " 2>&1", within: 30);

    // 3. Verify IR structure
    expect_substring(fs, fix_ll, "define ");
    expect_substring(fs, fix_ll, "%struct.Point = type");
    expect_substring(fs, fix_ll, "%struct.Cell = type");
    expect_substring(fs, fix_ll, "define double @calc_float");
    expect_substring(fs, fix_ll, "fadd double");
    expect_substring(fs, fix_ll, "fdiv double");
    expect_substring(fs, fix_ll, "getelementptr inbounds %struct.");
    expect_substring(fs, fix_ll, "bb_while_cond");
    expect_substring(fs, fix_ll, "bb_then");
    expect_substring(fs, fix_ll, "bb_else");
    expect_substring(fs, fix_ll, "oo_str_retain");
    expect_substring(fs, fix_ll, "oo_str_release");
    expect_substring(fs, fix_ll, "oo_ilist_push");

    // 4. Compile with clang + chs_rt
    let fix_bin: String = tmp + "/llvm_fixture.bin";
    check(p, "clang -O0 -Wno-override-module -Wno-unused-command-line-argument -I" + rt + " " + fix_ll + " " + rt + "/chs_rt.c -lm -ldl -lpthread -o " + fix_bin, within: 60);
    expect_clean(p, "test -x " + fix_bin);

    // 5. Execute and verify stdout
    let out_file: String = tmp + "/llvm_fixture.out";
    check(p, fix_bin + " > " + out_file + " 2>&1", within: 30);
    expect_substring(fs, out_file, "39");
    expect_substring(fs, out_file, "4");
    expect_substring(fs, out_file, "12");
    expect_substring(fs, out_file, "34");
    expect_substring(fs, out_file, "99");
    expect_substring(fs, out_file, "15");
    expect_substring(fs, out_file, "14");
    expect_substring(fs, out_file, "LLVM_FIXTURE_OK");
    expect_substring(fs, out_file, "2");
    expect_substring(fs, out_file, "100");
    expect_substring(fs, out_file, "200");

    println("llvm_codegen_smoke: PASSED");
}
