// # OODA Holo Smoke
//
// Logline: Merkle persist/load of a byte blob — round-trip persists bytes + SHA-256 root; tamper fails load; SHA-256 empty KAT matches; language `holo_persist` stays refused in product (residual).
//
// Setup: Process capability and test fixtures available.
//
// Beats: round-trip | root matches | tamper fails load | sha256 empty KAT | holo_persist refuse residual.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "oo_holo Merkle persist/load");

    when "path gate refuses ../evil, \"\", 0" {
    and  "persist + load round-trip yields same bytes + same root" {
    and  "flipped last byte → load fails" {
    and  "sha256 empty KAT matches e3b0c44..." {
    and  "language holo_persist still refused (HOLOGRAPHIC|residual in check)" {
    then "oo_holo_smoke PASSED" { } } } } }

    expect_present(fs, root + "/runtime/oo_holo.h");
    expect_present(fs, root + "/runtime/oo_holo.c");
    expect_present(fs, root + "/runtime/oo_sha256.c");
    expect_substring(fs, root + "/runtime/oo_holo.h", "oo_holo_persist");
    expect_substring(fs, root + "/runtime/oo_holo.h", "oo_holo_load");
    expect_substring(fs, root + "/runtime/oo_holo.h", "oo_holo_root");
    expect_substring(fs, root + "/runtime/oo_holo.h", "oo_holo_path_ok");
    expect_substring(fs, root + "/runtime/oo_holo.c", "oo_sha256");
    expect_present(fs, root + "/scripts/oo_holo_smoke.sh");
    println("oo_holo_smoke: PASSED (Merkle persist/load invariants catalogued)");
}
