// # Build Ooda CLI — Compile Meta-Router
//
// Logline: Compile ooda/main.oo with OODA_COMPILER. Fail closed when the compiler is missing.
//
// Setup: Requires OODA_COMPILER. ProcessCap execs oodac. No VERSION file.
//
// Beats:
//   1. Resolve compiler via find_oodac and refuse CLI recursion.
//   2. Compile ooda/main.oo with oodac build.
//   3. Return Ok(0) on success or fail closed on error.

import "build/find_compiler.oo";
import "build/host_run.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let oodac: String = find_oodac(fs_r, env);
    host_run_refuse(p, oodac);
    println("Building ooda CLI with " + oodac);
    let r: Result[String, String] = sys_exec(p, oodac, "build", "main.oo");
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("build failed: " + e);
    }
    return Ok(0);
}
