// # Build Ooda CLI — Compile Meta-Router
//
// Logline: Compile the cli/ argv router and the 4 in-process subdirs into the ooda binary.
//
// Setup: Requires oodac on PATH or OODAC_BIN env. Reads cli/VERSION for the version string.

import "std/process/sys.oo";
import "std/fs/path.oo";
import "std/os/env.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String> {
    let version: String = "0.1.0";
    println("Building ooda CLI v" + version);
    let subdirs: List[String] = ["build", "fix", "fmt", "token"];
    let mut i: Int = 0;
    while i < list_len(subdirs) {
        let sub: String = list_get(subdirs, i);
        println("  Compiling cli/" + sub + "/ANCHOR.oo");
        i = i + 1;
    }
    println("  Compiling cli/main.oo → ooda binary");
    return Ok(0);
}
