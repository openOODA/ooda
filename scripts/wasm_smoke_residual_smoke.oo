// # Wasm Smoke Residual Stays Honest
// Logline: bootstrap/WASM_SMOKE.oot keeps the residual rail marker; ci wires the smoke.
// Setup: bootstrap/WASM_SMOKE.oot + scripts/ci_product.sh on disk.
// Beats: 1. doc carries WASM_SMOKE_RESIDUAL_ALPHA | 2. fail-closed / smoke depth wording | 3. ci wires script

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let doc   = root + "/bootstrap/WASM_SMOKE.oot";
    let ci    = root + "/scripts/ci_product.sh";
    let label = "wasm_smoke_residual_smoke.sh";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — doc carries residual marker
    fails = fails + tally(expect_present(p, doc),                                                          "doc exists");
    fails = fails + tally(expect_quiet(p, "grep -q WASM_SMOKE_RESIDUAL_ALPHA " + doc),                   "doc marker WASM_SMOKE_RESIDUAL_ALPHA");

    // and — fail-closed / smoke depth residual wording
    fails = fails + tally(expect_quiet(p, "grep -qiE 'not.*production floor|smoke depth|Fail-closed residual|fail-closed residual' " + doc), "fail-closed / smoke-depth wording");

    // then — ci_product wire
    fails = fails + tally(expect_present(p, ci),                                                          "ci_product.sh exists");
    fails = fails + tally(expect_quiet(p, "grep -q '" + label + "' " + ci),                               "ci_product wires script");

    if fails > 0 { println("wasm_smoke_residual_smoke: FAILED"); process_exit(1); }
    println("wasm_smoke_residual_smoke: PASSED");
}
