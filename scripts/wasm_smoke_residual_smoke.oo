// # Wasm Smoke Residual Stays Honest
//
// Logline: bootstrap/WASM_SMOKE.oot keeps the residual rail marker; ci wires the smoke.
//
// Setup: bootstrap/WASM_SMOKE.oot + scripts/ci_product.sh on disk.
//
// Beats:
//   1. Verify document carries WASM_SMOKE_RESIDUAL_ALPHA marker.
//   2. Verify fail-closed and smoke depth residual wording.
//   3. Verify CI script wiring and pipeline integration.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let doc   = root + "/bootstrap/WASM_SMOKE.oot";
    let ci    = root + "/scripts/ci_product.sh";
    let label = "wasm_smoke_residual_smoke.sh";

    let _ = scenario(p, fs, "wasm smoke residual");

    // when — doc carries residual marker
    let _ = expect_present(fs, doc);
    let _ = expect_quiet(p, "grep -q WASM_SMOKE_RESIDUAL_ALPHA " + doc);

    // and — fail-closed / smoke depth residual wording
    let _ = expect_quiet(p, "grep -qiE 'not.*production floor|smoke depth|Fail-closed residual|fail-closed residual' " + doc);

    // then — ci_product wire
    let _ = expect_present(fs, ci);
    let _ = expect_quiet(p, "grep -q '" + label + "' " + ci);

    println("wasm_smoke_residual_smoke: PASSED");
}
