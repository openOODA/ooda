// # Bool domain fuzz
//
// Logline: Fuzz the bool domain fixture and the bool fail rail under a 60s timeout.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Run ooda test --fuzz 20 on fuzz_bool_domain.
//   2. Expect that run to pass.
//   3. Run the fail rail and expect an error.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    let mut r: TestRunner = test_runner_new();

    // 1. fuzz bool domain pass
    let mut cmd1: List[String] = cmd_new("timeout");
    cmd1 = cmd_arg(cmd1, "60");
    cmd1 = cmd_arg(cmd1, "bin/ooda");
    cmd1 = cmd_arg(cmd1, "test");
    cmd1 = cmd_arg(cmd1, "fixtures/fuzz_bool_domain.oo");
    cmd1 = cmd_arg(cmd1, "--fuzz");
    cmd1 = cmd_arg(cmd1, "20");

    let res1: Result[String, String] = cmd_execute(cmd1, p);
    r = test_assert(r, "fuzz bool domain pass", res1.is_ok());

    // 2. fuzz bool fail rail
    let mut cmd2: List[String] = cmd_new("timeout");
    cmd2 = cmd_arg(cmd2, "60");
    cmd2 = cmd_arg(cmd2, "bin/ooda");
    cmd2 = cmd_arg(cmd2, "test");
    cmd2 = cmd_arg(cmd2, "fixtures/fuzz_bool_fail.oo");
    cmd2 = cmd_arg(cmd2, "--fuzz");
    cmd2 = cmd_arg(cmd2, "20");

    let res2: Result[String, String] = cmd_execute(cmd2, p);
    r = test_assert(r, "fuzz bool fail rail", res2.is_err());

    // 3. fuzz non-domain fail-closed
    let mut cmd3: List[String] = cmd_new("timeout");
    cmd3 = cmd_arg(cmd3, "30");
    cmd3 = cmd_arg(cmd3, "bin/ooda");
    cmd3 = cmd_arg(cmd3, "test");
    cmd3 = cmd_arg(cmd3, "fixtures/chs_list_string.oo");
    cmd3 = cmd_arg(cmd3, "--fuzz");
    cmd3 = cmd_arg(cmd3, "2");

    let res3: Result[String, String] = cmd_execute(cmd3, p);
    r = test_assert(r, "fuzz non-domain fail-closed", res3.is_err());

    test_summary(r);
    
    if r.failed > 0 {
        process_exit(1);
    }
}
