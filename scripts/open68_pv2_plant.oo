// # OPEN-68 PV2 planted-listing refuse
//
// Logline: Cold LLVM check of hello must pass after wiping g_* and the Phase 1 smoke must not plant a listing with a gcc helper.
//
// Setup: cwd is ooda/. ELF is .ooda-cache/ooda-tmp/oodac_llvm or oodac_stamp.
//
// Beats:
//   1. Refuse ret i32 1 in the shim and a gcc plant helper in the Phase 1 smoke.
//   2. Wipe g_* listings.
//   3. Drive ELF check fixtures/hello.oo and require ^OK.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let mut elf = tmpd + "/oodac_llvm";
    if process_exec(p, "test -x " + elf).is_err() {
        elf = tmpd + "/oodac_stamp";
    }
    if process_exec(p, "test -x " + elf).is_err() { fail("no LLVM ELF"); }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if !path_exists(fs, "scripts/open68_cold_hello_smoke.oo") { fail("no phase1 smoke"); }
    if process_exec(p, "grep -q 'ret i32 1' oodac/llvm_link_shim.oo").is_ok() {
        fail("stub still in shim");
    }
    if process_exec(p, "grep -q oodac_stamp_gcc scripts/open68_cold_hello_smoke.oo").is_ok() {
        fail("phase1 smoke still plants via gcc helper");
    }
    if process_exec(p, "grep -q 'timeout 30 ' scripts/open68_cold_hello_smoke.oo").is_ok() {
        if process_exec(p, "grep -q plant scripts/open68_cold_hello_smoke.oo").is_ok() {
            fail("phase1 smoke still mentions plant");
        }
    }
    if process_exec(p, "mkdir -p .ooda-cache/check " + tmpd + "/open68_pv2").is_err() { fail("mkdir"); }
    if process_exec(p, "rm -f .ooda-cache/check/g_*").is_err() { fail("wipe g_"); }
    if process_exec(p, "ls .ooda-cache/check/g_* >/dev/null 2>&1").is_ok() {
        fail("g_ still present");
    }
    if process_exec(p, "timeout 60 " + elf + " check fixtures/hello.oo > " + tmpd + "/open68_pv2/c.out 2>" + tmpd + "/open68_pv2/c.err").is_err() {
        fail("check hello");
    }
    if process_exec(p, "grep -qE '^OK' " + tmpd + "/open68_pv2/c.out").is_err() {
        fail("cold check not OK");
    }
    println("open68_pv2_plant: cold check without plant");
    println("open68_pv2_plant: PASSED");
}
