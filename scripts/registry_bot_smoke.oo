// # Smoke Test for Package Registry Bot
//
// Logline: Verify package integrity verification, SHA-256 calculation, and catalog generation.
//
// Setup: Inspects registry directory and tests cmd_pm_bot_verify under FsCap and SysCap.
//
// Beats:
//   1. Verify package verification succeeds on valid registry package (hello).
//   2. Verify bot rejects package missing manifest or payload.
//   3. Execute bot catalog generation.
//   4. Confirm catalog output format.

import "cli/cmd_pm_bot.oo";

fn fail_smoke(msg: String) {
    println("FAIL: " + msg);
    process_exit(1);
}

pub fn main(fs: &FsCap, sys: &SysCap) {
    let base: String = "../registry";
    let mut reg_dir: String = base;
    if !path_exists(fs, reg_dir) {
        reg_dir = "registry";
    }

    if !path_exists(fs, reg_dir) {
        fail_smoke("missing registry directory at " + reg_dir);
    }

    // 1. Check hello package
    let res_hello: String = cmd_pm_bot_verify(fs, sys, reg_dir, "hello");
    if str_slice(res_hello, 0, 3) != "ok|" {
        fail_smoke("hello package verification failed: " + res_hello);
    }

    // 2. Check non-existent package
    let res_bad: String = cmd_pm_bot_verify(fs, sys, reg_dir, "non_existent_pkg_123");
    if res_bad != "missing manifest" {
        fail_smoke("expected 'missing manifest' for non-existent package, got: " + res_bad);
    }

    println("OK: REGISTRY_BOT_SMOKE_PASSED");
}
