// # Caps product floor
//
// Logline: Run the alpha caps product-floor seals and residual honesty checks.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Resolve ooda and oodac or exit.
//   2. Probe process-local seals.
//   3. Assert residual honesty on the floor.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let ooda = get_executable(p, root, "OODA", "bin/ooda");
    let oodac = get_executable(p, root, "OODAC_BIN", "oodac/oodac");
    
    if str_len(oodac) == 0 {
        println("ERR_NO_OODAC");
        process_exit(1);
    }
    if str_len(ooda) == 0 {
        println("ERR_NO_OODA");
        process_exit(1);
    }
    
    let scripts = list_new();
    scripts = list_push(scripts, "caps_matrix_smoke.sh");
    scripts = list_push(scripts, "alloc_cap_smoke.sh");
    scripts = list_push(scripts, "biometric_caps_residual_smoke.sh");
    scripts = list_push(scripts, "cap_ffi_product_floor_smoke.sh");
    
    let mut i = 0;
    while i < list_len(scripts) {
        let script = list_get(scripts, i);
        println("=== " + script + " ===");
        let res = cmd_exec(p, "bash " + root + "/scripts/" + script);
        if res.is_ok() {
            println("OK " + script);
            tr = test_assert(tr, script, true);
        } else {
            println("FAIL " + script);
            tr = test_assert(tr, script, false);
        }
        i = i + 1;
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        println("caps_product_floor_smoke: FAILED");
        process_exit(1);
    }
    
    println("caps_product_floor_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_executable(p: &ProcessCap, root: String, env_key: String, rel_path: String) -> String {
    let env_val = get_env(p, env_key, "");
    if str_len(env_val) > 0 && check_executable(p, env_val) {
        return env_val;
    }
    let full_path = root + "/" + rel_path;
    if check_executable(p, full_path) {
        return full_path;
    }
    return "";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return default;
}

fn check_executable(p: &ProcessCap, path: String) -> Bool {
    let res = cmd_exec(p, "test -x " + path);
    return res.is_ok();
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
