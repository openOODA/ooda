// # Prove ROADMAP Open 60 through 92
//
// Logline: Fail closed on each complete-oodac product proof. Residual refuse is not this row.
//
// Setup: cwd is ooda/. Tree oodac and bin/ooda. gcc for C floors. Named fixtures/openXX_*.oo.
//
// Beats:
//   1. CLI and backend rows prove live product. Residual or beta-out exit 2 is FAIL.
//   2. Language and std rows check+emit+gcc+run the named product fixture.
//   3. Print open60_92_prove: PASSED only when every OPEN-60..92 row is product.
//
// Parent (from ooda/), check ON, no PURE_SKIP_CHECK as proof:
//   export OODAC_BIN="${OODAC_BIN:-./oodac/oodac}"
//   export OODA_OPEN60_BIN="${OODA_OPEN60_BIN:-/tmp/grok-goal-188cba2f8bdf/implementer/open60-92/oodac_official}"
//   # optional slow-host: OODA_SKIP_OPEN67=1
//   "$OODAC_BIN" run scripts/open60_92_prove.oo
// residual: open_macro.oo / residual_*_fail.oo refuse rails are not product proof.

import "std/scenario.oo";
import "std/sh.oo";
import "scripts/oodac_identity.oo";
import "scripts/open60_92_prove_fx.oo";

fn row60(p: &ProcessCap, fs: &FsReadCap, root: String, tmpd: String, oodac: String, seed: String) -> Int {
    if expect_present(fs, root + "/scripts/open60_selfhost.oo").is_err() {
        println("FAIL OPEN-60 missing scripts/open60_selfhost.oo");
        return 1;
    }
    if expect_quiet(p, "test -x " + seed).is_ok() { refuse_oodac_cli(p, seed); } else { println("FAIL OPEN-60 seed"); return 1; }
    if need(p, "grep -q 'Check gate unless PURE_SKIP_CHECK' " + root + "/bootstrap/oodac_pure_build", "OPEN-60 skip gate") != 0 { return 1; }
    let fx: String = root + "/fixtures/open60.oo";
    if expect_present(fs, fx).is_ok() { return run_c(p, root, tmpd, oodac, fx, "PASSED", "", "600", "OPEN-60"); }
    let off = match sh_env_get_or(p, "OODA_OPEN60_BIN", "") { Ok(s) => s, Err(_) => "" };
    if off == "" { println("FAIL OPEN-60 run scripts/open60_selfhost.oo then set OODA_OPEN60_BIN"); return 1; }
    if off == seed || off == oodac { println("FAIL OPEN-60 official is host"); return 1; }
    refuse_oodac_cli(p, off);
    if chk(p, off, tmpd, root + "/fixtures/hello.oo", "OPEN-60 official") != 0 { return 1; }
    println("OK OPEN-60");
    return 0;
}

fn row67(p: &ProcessCap, root: String, oodac: String) -> Int {
    let skip = match sh_env_get_or(p, "OODA_SKIP_OPEN67", "") { Ok(s) => s, Err(_) => "" };
    if skip == "1" { println("SKIP OPEN-67"); return 0; }
    if check(p, "rm -rf " + root + "/.ooda-cache/check && timeout 10 " + oodac + " check " + root + "/oodac/main.oo >/dev/null 2>&1", within: 15).is_err() {
        println("SKIP OPEN-67 cold >10s");
        return 0;
    }
    println("OK OPEN-67");
    return 0;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let picked: String = pick_compiler(fs, root);
    let mut oodac = match sh_env_get_or(p, "OODAC_BIN", picked) { Ok(s) => s, Err(_) => picked };
    if oodac == "" { oodac = root + "/oodac/oodac"; }
    let ooda = root + "/bin/ooda";
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "OPEN-60..92 prove").is_err() { println("FAIL scenario"); process_exit(1); }
    refuse_oodac_cli(p, oodac);
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }

    let mut fails: Int = 0;
    fails = fails + row60(p, fs, root, tmpd, oodac, root + "/bootstrap/seed/oodac");
    fails = fails + cli_ok(p, ooda, tmpd, "context " + root + "/fixtures/hello.oo", "est_tokens", "OPEN-61");
    fails = fails + cli_ok(p, ooda, tmpd, "digest " + root + "/fixtures/hello.oo", "leave_off", "OPEN-62");
    fails = fails + cli_ok(p, ooda, tmpd, "health", "emit-c", "OPEN-63");
    fails = fails + cli_ok(p, ooda, tmpd, "pkg", "package", "OPEN-64");
    fails = fails + cli_ok(p, ooda, tmpd, "add " + root + "/test_pm_ws_add", "lock", "OPEN-65");
    fails = fails + row66(p, root, tmpd, oodac);
    fails = fails + row67(p, root, oodac);
    fails = fails + row68(p, fs, root, tmpd, oodac);
    fails = fails + row69(p, root, tmpd, oodac);
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open70_import_c.oo", "import_c", "OK", "OPEN-70");
    fails = fails + row71(p, fs, root, tmpd, oodac);
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open72_hmac_attenuate.oo", "cap_attenuate", "PASSED", "OPEN-72");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open73_kernel_seal.oo", "seal", "PASSED", "OPEN-73");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open74_enclave.oo", "enclave", "PASSED", "OPEN-74");
    fails = fails + row75(p, fs, root, tmpd, oodac);
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open76_fd_stream.oo", "stream", "PASSED", "OPEN-76");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open77_aes.oo", "aes_encrypt", "PASSED", "OPEN-77");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open78_base64.oo", "base64", "PASSED", "OPEN-78");
    if need(p, "grep -q base64 " + root + "/std/README.oot", "OPEN-78 tracked") != 0 { fails = fails + 1; }
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open79_regex_dfa.oo", "\\[\\]", "PASSED", "OPEN-79");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "../std/prove_open80.oo", "aes_encrypt", "PASSED", "OPEN-80");
    fails = fails + row81(p, fs, root, tmpd, oodac);
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open82_typestate.oo", "type_state_check", "PASSED", "OPEN-82");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open83_trait.oo", "trait", "1", "OPEN-83");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open84_arena_cap.oo", "ArenaCap", "PASSED", "OPEN-84");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open85_soa.oo", "soa_layout|dod_layout", "PASSED", "OPEN-85");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open86_checkpoint.oo", "checkpoint|rollback", "PASSED", "OPEN-86");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open87_otp.oo", "otp_supervise", "PASSED", "OPEN-87");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open88_cap_rpc.oo", "rpc", "PASSED", "OPEN-88");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open89_macro.oo", "ast_macro|macro_expand", "PASSED", "OPEN-89");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open90_hotswap.oo", "hot_reload|live_reload", "PASSED", "OPEN-90");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open91_gpu.oo", "emit_ptx|emit_spirv", "PASSED", "OPEN-91");
    fails = fails + fx_row(p, fs, root, tmpd, oodac, "fixtures/open92_bare.oo", "bare_metal_init", "PASSED", "OPEN-92");
    if fails > 0 { println("open60_92_prove: FAILED " + fails.to_string()); process_exit(1); }
    println("open60_92_prove: PASSED");
}
