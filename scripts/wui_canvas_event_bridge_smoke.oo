// # Dedicated WUI Canvas 2D & Event Bridge Smoke Test
//
// Logline: End-to-end verification of HTML5 Canvas 2D context recording, direct VDOM canvas rendering, browser event routing, and Elm-style app loop.
//
// Setup: Validates openOODA std/wui canvas graphics and interactive application pipeline on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify WuiCanvas2D context drawing commands (fill_rect, stroke_rect, fill_text) and serialization.
//   2. Verify direct Virtual DOM tree rasterization onto Canvas 2D rendering contexts.
//   3. Verify browser event bridge decoding and action tag routing.
//   4. Verify Elm-style Model-Update-View cycle and 60fps render scheduler timing.

import "std/wui/wui_vnode.oo";
import "std/wui/wui_canvas_context.oo";
import "std/wui/wui_canvas_renderer.oo";
import "std/wui/wui_event_bridge.oo";
import "std/wui/wui_event_router.oo";
import "std/wui/wui_app.oo";
import "std/wui/wui_scheduler.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA WUI Canvas 2D & Event Bridge Smoke");
    println("===================================================================");

    // 1. Canvas 2D Context Recording & Serialization
    let mut canvas: WuiCanvas2D = wui_canvas_new(400, 300);
    wui_canvas_set_fill_style(&mut canvas, "#1e1e1e");
    wui_canvas_fill_rect(&mut canvas, 0, 0, 400, 300);
    wui_canvas_set_stroke_style(&mut canvas, "#3a3a3a");
    wui_canvas_stroke_rect(&mut canvas, 10, 10, 380, 280);
    wui_canvas_fill_text(&mut canvas, "Sovereign WASM Canvas", 20, 30);

    let serialized_canvas: String = wui_canvas_serialize(&canvas);
    if !str_contains(serialized_canvas, "CANVAS_CMDS[3]") {
        println("FAIL: Canvas 2D command stream serialization mismatch");
        process_exit(1);
    }
    println("  [PASS] 1. Canvas 2D Drawing Operation Buffering & Serialization");

    // 2. Direct VDOM-to-Canvas 2D Rasterization
    let mut render_canvas: WuiCanvas2D = wui_canvas_new(500, 500);
    let mut empty_p: List[VProp] = list_new();
    let mut empty_c: List[VNode] = list_new();
    let mut vtree: VNode = vnode_element("div", "", empty_p, empty_c);
    vnode_add_child(&mut vtree, vnode_text("Header Text"));
    let mut btn_p: List[VProp] = list_new();
    let mut btn_c: List[VNode] = list_new();
    vnode_add_child(&mut vtree, vnode_element("button", "", btn_p, btn_c));

    wui_canvas_render_vdom(&mut render_canvas, &vtree, 0, 0, 500, 500);
    let n_render_cmds: Int = list_len((render_canvas).commands);
    if n_render_cmds < 3 {
        println("FAIL: Direct VDOM-to-Canvas rasterizer emitted insufficient commands");
        process_exit(1);
    }
    println("  [PASS] 2. Direct Virtual DOM-to-Canvas 2D Subtree Rasterization");

    // 3. Browser Event Bridge Decoding & Event Router
    let mut router: WuiEventRouter = wui_event_router_new();
    wui_event_router_bind(&mut router, "btn-inc", "click", "increment_counter");
    wui_event_router_bind(&mut router, "input-search", "input", "update_query");

    let ev_click: WuiBrowserEvent = wui_event_new("click", "btn-inc", 0, "", 120, 45);
    let ev_input: WuiBrowserEvent = wui_event_new("input", "input-search", 0, "openOODA", 0, 0);

    if !wui_event_is_click(&ev_click) || !wui_event_is_input(&ev_input) {
        println("FAIL: Browser event bridge classification failed");
        process_exit(1);
    }

    let route_res: Result[String, String] = wui_event_router_route(&router, &ev_click);
    match route_res {
        Ok(action) => {
            if action != "increment_counter" {
                println("FAIL: Event router action tag mapping mismatch");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL: Event routing lookup failed: " + e);
            process_exit(1);
        }
    }
    println("  [PASS] 3. Browser Event Decoding & Target Action Routing");

    // 4. Reactive Application Architecture & Scheduler
    let app_m0: WuiModel = wui_app_init();
    let msg_inc: WuiMsg = WuiMsg { msg_type: "increment", payload: "" };
    let app_m1: WuiModel = wui_app_update(app_m0, msg_inc);
    let vdom_out: VNode = wui_app_view(&app_m1);

    if (app_m1).counter != 1 || (vdom_out).node_kind != 1 {
        println("FAIL: Reactive WUI application model update or view rendering mismatch");
        process_exit(1);
    }

    let mut sched: WuiScheduler = wui_scheduler_new();
    wui_scheduler_mark_dirty(&mut sched);
    let render_due1: Bool = wui_scheduler_tick(&mut sched, 0); // First render (last_ts=0)
    let render_due2: Bool = wui_scheduler_tick(&mut sched, 5); // Throttled (<16ms)

    if !render_due1 || render_due2 {
        println("FAIL: WUI Animation Frame render scheduler throttling mismatch");
        process_exit(1);
    }
    println("  [PASS] 4. Elm-Style Application Architecture & 60fps Frame Scheduling");

    println("wui_canvas_event_bridge_smoke: PASSED");
}
