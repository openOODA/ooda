// # emit-c stamps #line before control and assign
//
// Logline: Default emit-c of c_line_ctrl.oo puts #line N ".oo" above if, while, for, match, and assign.
//
// Setup: cwd is ooda/. Product oodac/oodac. No EMIT_NO_CONCAT on the ctrl file.
//
// Beats:
//   1. #line sits immediately above if (, while (1), for (long long, if (__m.ok), and x =.
//   2. EMIT_NO_CONCAT hello still has #line 1 hello.oo and #line before main.
//   3. No ERR c_emit.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/c_line_ctrl";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " emit-c fixtures/c_line_ctrl.oo > " + tmpd +
        "/ctrl.c").is_err() {
        fail("emit ctrl");
    }
    if process_exec(p, "test -s " + tmpd + "/ctrl.c && ! grep -qE '^ERR.c_emit' " +
        tmpd + "/ctrl.c").is_err() {
        fail("empty or ERR");
    }
    if process_exec(p, "awk 'prev ~ /^#line [0-9]+ \".*\\.oo\"/ && $0 ~ /^if \\(/ && $0 !~ /__m/ {ok=1} {prev=$0} END{exit !ok}' " +
        tmpd + "/ctrl.c").is_err() {
        fail("no #line above if");
    }
    if process_exec(p, "awk 'prev ~ /^#line [0-9]+ \".*\\.oo\"/ && $0 ~ /^while \\(1\\)/ {ok=1} {prev=$0} END{exit !ok}' " +
        tmpd + "/ctrl.c").is_err() {
        fail("no #line above while");
    }
    if process_exec(p, "awk 'prev ~ /^#line [0-9]+ \".*\\.oo\"/ && $0 ~ /^for \\(long long/ {ok=1} {prev=$0} END{exit !ok}' " +
        tmpd + "/ctrl.c").is_err() {
        fail("no #line above for");
    }
    if process_exec(p, "awk 'prev ~ /^#line [0-9]+ \".*\\.oo\"/ && $0 ~ /if \\(__m\\.ok\\)/ {ok=1} {prev=$0} END{exit !ok}' " +
        tmpd + "/ctrl.c").is_err() {
        fail("no #line above match");
    }
    if process_exec(p, "awk 'prev ~ /^#line [0-9]+ \".*\\.oo\"/ && $0 ~ / x = / {ok=1} {prev=$0} END{exit !ok}' " +
        tmpd + "/ctrl.c").is_err() {
        fail("no #line above assign");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/hello.oo > " + tmpd + "/hello.c").is_err() {
        fail("emit hello");
    }
    if process_exec(p, "grep -qE '^#line 1 \".*hello.oo\"' " + tmpd +
        "/hello.c && awk '/^int main/{exit !p} /^#line [0-9]+/{p=1}' " + tmpd +
        "/hello.c").is_err() {
        fail("hello #line");
    }
    println("c_line_ctrl_smoke: PASSED");
}
