// # OODA Fuzz Pure Generators
//
// Logline: PRNG + domain emit helpers for the pure contract fuzz — prng_step, gen_int_val, gen_bool_val, gen_string_val, gen_list_int_val, list_eq_int; per-target sample/call emit (no Python).
//
// Beats: prng_step | int/bool/string/list gen | list_eq_int | per-target sample/call emit | body strip.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "fuzz pure generator helpers");

    when "PRNG step + per-domain gen helpers emitted" {
    and  "list_eq_int pure deep-eq (no OoIList == OoIList)" {
    and  "per-target sample/call emit (arity-aware)" {
    and  "body strip removes FUZZ_/requires/ensures/main" {
    then "ooda_fuzz_pure_gens PASSED" { } } } }

    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "prng_step");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "gen_int_val");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "gen_bool_val");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "gen_string_val");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "gen_list_int_val");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "list_eq_int");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "emit_fuzz_sample_let");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "emit_fuzz_call_let");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure_gens.sh", "fuzz_strip_body");
    println("ooda_fuzz_pure_gens: PASSED (gen helpers catalogued)");
}
