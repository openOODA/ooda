// # AI Native Floor Walks The Agent Loop
// Logline: outline + reflect + json-errors(E_CAP fix_hint) + patch replace_fn hold green.
// Setup: oodac/oodac + bin/ooda built; PM fixtures and corpus fail fixture on disk.
// Beats: 1. outline + reflect non-empty | 2. json-errors E_CAP fix_hint+kind | 3. patch replace_fn applied

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA",      root + "/bin/ooda").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let fix   = root + "/fixtures/chs_list_string.oo";
    let cap_f = root + "/bootstrap/corpus/check/fail/no_cap_fetch.oo";

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — outline + reflect both non-empty
    let _w1 = process_exec(p, ooda + " outline " + fix + " > " + tmpd + "/ai_outline.out 2> " + tmpd + "/ai_outline.err");
    fails   = fails + tally(expect_quiet(p, "test -s " + tmpd + "/ai_outline.out"),                       "outline non-empty");
    let _w2 = process_exec(p, ooda + " reflect " + fix + " > " + tmpd + "/ai_reflect.out 2> " + tmpd + "/ai_reflect.err");
    fails   = fails + tally(expect_quiet(p, "test -s " + tmpd + "/ai_reflect.out"),                       "reflect non-empty");

    // and — json-errors E_CAP + fix_hint + suggested_fix + kind
    let _w3 = process_exec(p, ooda + " check " + cap_f + " --json-errors > " + tmpd + "/ai_je.out 2> " + tmpd + "/ai_je.err");
    fails   = fails + tally(check(p, "python3 -c \"import json,sys; v=json.loads(open('" + tmpd + "/ai_je.out').read().strip().splitlines()[-1]); assert v[0]['code']=='E_CAP' and v[0]['kind']=='CapabilitySecurityViolation' and v[0].get('fix_hint') and v[0].get('suggested_fix')\"", 10), "json-errors E_CAP + fix_hint");

    // then — patch replace_fn applied (a - b)
    let work = tmpd + "/ai_patch";
    let _w4  = process_exec(p, "mkdir -p " + work + " && cp " + root + "/fixtures/patch_add.oo " + work + "/target.oo && cp " + root + "/fixtures/patch_add_body.txt " + work + "/body.txt");
    let rel_t = work + "/target.oo";
    let rel_b = work + "/body.txt";
    let _w5   = process_exec(p, ooda + " patch " + rel_t + " --replace-fn add --with " + rel_b + " > " + tmpd + "/ai_patch.out 2> " + tmpd + "/ai_patch.err");
    fails     = fails + tally(expect_quiet(p, "grep -q 'return a - b' " + rel_t),                          "patch replace_fn applied");

    // residual — telepathic free-name refuse
    let _w6 = process_exec(p, oodac + " check " + root + "/fixtures/residual_telepathic_fail.oo > " + tmpd + "/ai_tele.out 2> " + tmpd + "/ai_tele.err");
    fails   = fails + tally(check(p, "grep -qE 'ERR.residual|Residual product refuse' " + tmpd + "/ai_tele.out " + tmpd + "/ai_tele.err 2>/dev/null", 10), "telepathic residual refuse");

    if fails > 0 { println("ai_native_product_floor_smoke: FAILED"); process_exit(1); }
    println("ai_native_product_floor_smoke: PASSED");
}
