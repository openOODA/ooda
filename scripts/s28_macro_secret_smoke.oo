// # S28 Macro Secret Smoke
//
// Logline: 2.8 macro SECRET — when macros are residual, free-name calls refuse; when macros exist, SECRET ident in expanded body is fail-closed.
// Beats: probe macros | residual-refuse check | SECRET ident refuse | no-expand string body | emit-llvm no-expand.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/s28_macro_secret";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + FIX);
    let _ = scenario(p, fs, "S28 macro secret second-pass");

    // when: ephemeral fixtures for macro_expand / ast_macro / SECRET bodies
    let _ = write_fix(p, root + "/" + FIX);

    // and: macro free-name calls refuse (residual or syntax)
    expect_clean(p, "!" + oodac + " check " + root + "/" + FIX + "/macro_expand.oo +\" 2>&1 | grep -qE 'ERR\tresidual|ERR[[:space:]]+(parse|type|c_emit)|AST_MACROS'");
    expect_clean(p, "!" + oodac + " check " + root + "/" + FIX + "/ast_macro.oo +\" 2>&1 | grep -qE 'ERR\tresidual|ERR[[:space:]]+(parse|type|c_emit)|AST_MACROS'");

    // then: SECRET ident in macro-expanded body fails-closed
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/secret_macro_expand_body.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/secret_ast_macro_body.oo +\" 2>&1 | grep -qE 'ERR\tsecret'");

    // and: emit-llvm no-expand (named residual)
    expect_clean(p, "!" + oodac + " emit-llvm " + root + "/" + FIX + "/macro_expand.oo +\" 2>&1 | grep -qE '@macro_expand' || true");

    println("s28_macro_secret_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/macro_expand.oo <<'EOF'\npub fn main() { let r = macro_expand(\"m\"); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/ast_macro.oo <<'EOF'\npub fn main() { let r = ast_macro(\"m\"); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/secret_macro_expand_body.oo <<'EOF'\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; let r = macro_expand(\"println(tok)\"); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/secret_ast_macro_body.oo <<'EOF'\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; let r = ast_macro(\"println(tok)\"); }\nEOF");
}
