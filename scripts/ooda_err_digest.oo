// # Error Digest Tool
//
// Logline: compress gcc/oodac error logs into token-dense counts (top kinds, hot sites, samples) — no full dumps.
//
// Setup: optional log file arg; otherwise reads stdin.
//
// Beats:
//   1. Read input (file arg or stdin) into a tmp file.
//   2. Bail early if empty.
//   3. Run embedded Python: count error kinds, hot sites, samples.

import "std/scenario.oo";
import "std/sh.oo";

const PY_BODY: String = "import sys, re\nfrom collections import Counter\ndata = sys.stdin.read()\nlines = data.splitlines()\nkinds = Counter()\nsamples = []\nhits = Counter()\nkeepers = {'OoStr','OoSList','OoIList','OoResS','OoResV','long','int','void','struct','type'}\ndef repl(m):\n  t = m.group(0)\n  if t in keepers: return t\n  if t[0].islower() or t[0] == '_': return 'ID'\n  return 'Name'\nfor ln in lines:\n  if 'error:' in ln:\n    m = re.search(r'error:\\s*(.+)$', ln)\n    kind = m.group(1).strip() if m else ln.strip()\n    kind = re.sub(r\"'[^']*'\", \"'...\", kind)\n    kind = re.sub(r'\\b[A-Za-z_][A-Za-z0-9_]*\\b', repl, kind, count=3)\n    kinds[kind[:120]] += 1\n    if len(samples) < 8: samples.append(ln[:160])\n    fm = re.search(r'([^/\\s]+\\.[ch]):(\\d+)', ln)\n    if fm: hits[f'{fm.group(1)}:{fm.group(2)}'] += 1\n  elif '\\tERR' in ln or ln.startswith('ERR'):\n    kinds[ln.strip()[:80]] += 1\n    if len(samples) < 8: samples.append(ln[:160])\nnerr = sum(kinds.values())\nprint(f'err_digest errors={nerr} unique_kinds={len(kinds)}')\nprint('top_kinds:')\nfor k, v in kinds.most_common(12): print(f'  {v:4d}  {k}')\nif hits: print('hot_sites:')\nfor k, v in hits.most_common(8): print(f'  {v:4d}  {k}')\nif samples: print('samples:')\nfor s in samples: print(f'  | {s}')\n";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = sh_env_get_or(p, "TMPDIR", "/tmp").unwrap_or("/tmp");
    let pid = match process_exec(p, "echo $$") { Ok(s) => trim(s), Err(_) => "0" };
    let input_file = tmpd + "/ooda_err_digest_" + pid + ".in";
    let py_script = tmpd + "/ooda_err_digest_" + pid + ".py";

    let _ = scenario(p, fs, "error digest");

    when "input captured (file arg or stdin)" {
    and  "embedded Python parses errors and prints digest" {
    then "err_digest emits top kinds + hot sites + samples" { }

    let args = process_args(p);
    if list_len(args) > 1 {
        let arg = list_get(args, 1);
        expect_present(fs, arg);
        let _ = process_exec(p, "cat " + arg + " > " + input_file);
    } else {
        let _ = process_exec(p, "cat > " + input_file);
    }

    let is_empty = expect_clean(p, "! grep -qs '[^[:space:]]' " + input_file);
    if is_empty.is_ok() {
        println("err_digest: empty");
    } else {
        let _ = process_exec(p, "cat > " + py_script + " <<'PY'\n" + PY_BODY + "PY");
        let _ = check(p, "python3 " + py_script + " < " + input_file, within: 30);
    }

    let _ = sh_clean(fw, fs, py_script);
    let _ = sh_clean(fw, fs, input_file);
}

fn trim(s: String) -> String {
    let t = str_trim(s);
    if str_eq(t, "") { return "0"; }
    return t;
}
