// # Contracts Multi-Clause Smoke
//
// Logline: M51 multi-clause requires/ensures (≥2 AND ≥3) lower and run with expected verdicts.
//
// Setup: Process capability and test fixtures available.
//
// Beats: pass → ≥2 req + run=3 | req-fail → non-zero + needle | ens-fail → non-zero + needle | three → ≥3 + run=6.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = "ooda/fixtures/multi_clause_";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M51 multi-clause contracts");

    // when pass fixture lowers ≥2 requires and runs to 3
    let c1 = lower(p, oodac, tmpd, FIX + "pass.oo", "mc_pass");
    expect_present(fs, c1);
    check(p, "grep -cE 'if \\(!\\(' " + c1 + " | awk '{ if ($1>=2) exit 0; exit 1 }'", within: 10);
    expect_substring(fs, c1, "OO_ENS_CHECK");
    build_run(p, fs, root, c1, tmpd + "/multi_clause_pass.bin", "3");

    // and req-fail runs non-zero with contract/requires needle
    let c2 = lower(p, oodac, tmpd, FIX + "req_fail.oo", "mc_req_fail");
    run_fails_with(p, fs, root, c2, tmpd + "/multi_clause_req_fail.bin", "contract|requires");

    // and ens-fail runs non-zero with contract/ensures needle
    let c3 = lower(p, oodac, tmpd, FIX + "ens_fail.oo", "mc_ens_fail");
    expect_substring(fs, c3, "OO_ENS_CHECK");
    run_fails_with(p, fs, root, c3, tmpd + "/multi_clause_ens_fail.bin", "contract|ensures");

    // then three-clause depth when fixtures present
    if fs_path_exists(fs, FIX + "three.oo") {
        let c4 = lower(p, oodac, tmpd, FIX + "three.oo", "mc_three");
        check(p, "grep -cE 'if \\(!\\(' " + c4 + " | awk '{ if ($1>=3) exit 0; exit 1 }'", within: 10);
        build_run(p, fs, root, c4, tmpd + "/multi_clause_three.bin", "6");
    }
    if fs_path_exists(fs, FIX + "three_req_fail.oo") {
        run_fails_with(p, fs, root, lower(p, oodac, tmpd, FIX + "three_req_fail.oo", "mc_three_fail"), tmpd + "/multi_clause_three_req_fail.bin", "contract|requires");
    }
    println("contracts_multi_clause_smoke: PASSED");
}

fn lower(p: &ProcessCap, oodac: String, tmpd: String, src: String, tag: String) -> String {
    let c = tmpd + "/" + tag + ".c";
    let _ = process_exec(p, oodac + " emit-c " + src + " > " + c + " 2> " + tmpd + "/" + tag + ".err");
    return c;
}

fn build_run(p: &ProcessCap, fs: &FsReadCap, root: String, src_c: String, bin: String, expect_out: String) {
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + src_c + " -o " + bin + " -lm", within: 30);
    expect_clean(p, "timeout 3 " + bin + " | grep -qE '" + expect_out + "'");
}

fn run_fails_with(p: &ProcessCap, fs: &FsReadCap, root: String, src_c: String, bin: String, needle: String) {
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + src_c + " -o " + bin + " -lm", within: 30);
    expect_clean(p, "! timeout 3 " + bin + " 2>&1 | grep -qiE '" + needle + "'");
}