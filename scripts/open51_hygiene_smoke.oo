// # OPEN-51 hygiene lock
//
// Logline: Fail closed when the host-lint leftovers remain: tamper fixture, oversized library_status, or python3 tamper call.
//
// Setup: cwd is ooda/. process_exec for test, grep, and wc. C emit plus gcc remains product.
//
// Beats:
//   1. Refuse leftover pm_launch_tamper.py at both path spellings.
//   2. Index library_status.oot exists; every library_status*.oot has wc -l <= 256.
//   3. HEAD class counts: org 3046/1015, prod 188/214, wave 3/2. Destub rewrite fails.
// residual: C emit plus gcc remains the product path. Not gcc retired.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap) {
    if process_exec(p, "test -e ../ooda/fixtures/pm_launch_tamper.py").is_ok() {
        fail("pm_launch_tamper.py exists");
    }
    if process_exec(p, "test -e ooda/fixtures/pm_launch_tamper.py").is_ok() {
        fail("pm_launch_tamper.py exists");
    }
    if process_exec(p, "test -e fixtures/pm_launch_tamper.py").is_ok() {
        fail("pm_launch_tamper.py exists");
    }

    if process_exec(p, "test -e ../openOODA/audit/library_status.oot || test -e openOODA/audit/library_status.oot").is_err() {
        fail("missing library_status.oot index");
    }

    let wc_cmd = "found=0; "
        + "for f in ../openOODA/audit/library_status*.oot openOODA/audit/library_status*.oot; do "
        + "[ -f \"$f\" ] || continue; found=1; "
        + "n=$(wc -l < \"$f\" | tr -d ' '); "
        + "case \"$n\" in ''|*[!0-9]*) exit 1 ;; esac; "
        + "if [ \"$n\" -gt 256 ]; then exit 1; fi; "
        + "done; [ \"$found\" -eq 1 ]";
    if process_exec(p, wc_cmd).is_err() {
        fail("library_status*.oot wc -l > 256 or none found");
    }

    if process_exec(p, "grep -F -q 'python3 fixtures/pm_launch_tamper.py' ../qa/pm_extract_spine.oo").is_ok() {
        fail("qa still calls python3 fixtures/pm_launch_tamper.py");
    }
    if process_exec(p, "grep -F -q 'python3 fixtures/pm_launch_tamper.py' qa/pm_extract_spine.oo").is_ok() {
        fail("qa still calls python3 fixtures/pm_launch_tamper.py");
    }

    let cls = "A=../openOODA/audit; "
        + "op=$(grep -h '^- proved' $A/library_status_org_*.oot | wc -l | tr -d ' '); "
        + "or=$(grep -h '^- residual' $A/library_status_org_*.oot | wc -l | tr -d ' '); "
        + "pp=$(grep -h '^- proved' $A/library_status_prod_*.oot | wc -l | tr -d ' '); "
        + "pr=$(grep -h '^- residual' $A/library_status_prod_*.oot | wc -l | tr -d ' '); "
        + "wp=$(grep -c '^- proved' $A/library_status.oot | tr -d ' '); "
        + "wr=$(grep -c '^- residual' $A/library_status.oot | tr -d ' '); "
        + "test \"$op\" = 3046 && test \"$or\" = 1015 && test \"$pp\" = 188 && test \"$pr\" = 214 "
        + "&& test \"$wp\" = 3 && test \"$wr\" = 2";
    if process_exec(p, cls).is_err() {
        fail("inventory class counts are not HEAD 3046/1015 org, 188/214 prod, wave 3/2");
    }
    if process_exec(p, "grep -F -q 'serial destub restored' ../openOODA/audit/library_status.oot").is_ok() {
        fail("wave rows destub-rewritten");
    }

    println("open51_hygiene_smoke: C emit plus gcc remains product");
    println("open51_hygiene_smoke: PASSED");
}
