// # oodac build hello dwarf names hello.oo
//
// Logline: Product oodac build of hello.oo records fixtures/hello.oo in dwarf, not only tmp.c.
//
// Setup: cwd is ooda/. Product oodac/oodac is the inner emit host. gcc stays -O2.
//
// Beats:
//   1. oodac build writes fixtures/hello.oo.bin.
//   2. readelf/objdump names fixtures/hello.oo (not only *.tmp.c).
//   3. The binary prints the greeting. Product strings still have gcc -O2.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let bin = "fixtures/hello.oo.bin";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "strings " + oodac + " | grep -q 'gcc -O2'").is_err() {
        fail("no -O2");
    }
    if process_exec(p, "rm -f " + bin + " " + bin + ".tmp.c && " + oodac +
        " build fixtures/hello.oo").is_err() {
        fail("build");
    }
    if !path_exists(fs, bin) { fail("no bin"); }
    if process_exec(p, "readelf --debug-dump=decodedline " + bin +
        " 2>/dev/null | grep -q fixtures/hello.oo || objdump -WL " + bin +
        " 2>/dev/null | grep -q fixtures/hello.oo").is_err() {
        fail("dwarf");
    }
    if process_exec(p, bin + " | grep -q 'Hello, openOODA Developer!'").is_err() {
        fail("run");
    }
    println("oodac_build_dwarf_smoke: PASSED");
}
