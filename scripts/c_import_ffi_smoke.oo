// # Smoke test for C Header Import and Capability-Encased FFI Shims
//
// Logline: Verify C header AST parsing, struct layout mapping, policy gates, and zero-cost capability-encased FFI shims.
//
// Setup: oodac compiler binary built; FFI standard library modules and fixtures on disk.
//
// Beats:
//   1. Verify FFI standard library modules pass compile-time typecheck.
//   2. Verify top-level std/ffi.oo facade passes compile-time typecheck.
//   3. Verify c_import_ffi_fixture passes compile-time check.
//   4. Confirm capability rejection when foreign calls lack required capability tokens.
//
// residual: Dynamic libffi argument marshaling exits closed

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let fix = root + "/fixtures";
    let std_root = sh_env_get_or(p, "STD_ROOT", root + "/../std").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "c header import and capability-encased ffi shims");

    // when — FFI stdlib modules pass typecheck
    let ffi_dir = std_root + "/src/ooda/ffi";
    let _ = check(p, oodac + " check " + ffi_dir + "/ffi_types.oo >/dev/null 2>&1", 30);
    let _ = check(p, oodac + " check " + ffi_dir + "/c_header_parse.oo >/dev/null 2>&1", 30);
    let _ = check(p, oodac + " check " + ffi_dir + "/ffi_shim_gen.oo >/dev/null 2>&1", 30);
    let _ = check(p, oodac + " check " + ffi_dir + "/ffi.oo >/dev/null 2>&1", 30);

    // and — top-level std facade passes typecheck
    let _ = check(p, oodac + " check " + std_root + "/ffi.oo >/dev/null 2>&1", 30);

    // and — end-to-end fixture passes compile-time check
    let _ = check(p, oodac + " check " + fix + "/c_import_ffi_fixture.oo >/dev/null 2>&1", 30);

    // then — invalid foreign call without capability token is rejected
    let bad_fixture = tmpd + "/bad_bare_ffi_call.oo";
    let _ = process_exec(p, "printf 'pub fn rogue() { let r = dlopen(\"libunsafe.so\"); }\\npub fn main() {}\\n' > " + bad_fixture);
    let _ = check(p, "test \"$(" + oodac + " check " + bad_fixture + " >/dev/null 2>&1; echo $?)\" -ne 0", 30);

    println("c_import_ffi_smoke: PASSED");
}
