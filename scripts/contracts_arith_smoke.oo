// # Contracts Arithmetic Smoke
//
// Logline: M165 Path A simple arith (+ / >) and ||+&& compound requires lower + run; failures exit non-zero with contract/requires message.
// Setup: oodac/oodac prebuilt; fixtures/contract_arith_*.oo + bootstrap/CONTRACTS_COMPLEX.oot.
//
// Beats: pass run → 1 and 3 | req-fail non-zero with needle | or_and fail non-zero with needle | residual honesty (no quantifiers/old-state claim).

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M165 contracts arith path A");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/contract_arith_pass.oo");
    expect_present(fs, root + "/fixtures/contract_arith_req_fail.oo");
    expect_present(fs, root + "/fixtures/contract_arith_or_and_fail.oo");
    expect_present(fs, root + "/bootstrap/CONTRACTS_COMPLEX.oot");

    // when "pass fixture builds + runs to 1 and 3" {
    // and  "req-fail exits non-zero with contract|requires needle" {
    // and  "or_and fail exits non-zero with needle" {
    // then "CONTRACTS_COMPLEX residual honesty (no quantifiers/old-state)" {

    let bp: String = tmpd + "/carith_pass";
    check(p, oodac + " build " + root + "/fixtures/contract_arith_pass.oo " + bp + " > " + tmpd + "/carith_b.out 2> " + tmpd + "/carith_b.err", within: 60);
    expect_clean(p, "test -x " + bp);
    expect_clean(p, "out=$(" + bp + " 2>&1) && echo \"$out\" | grep -q '1' && echo \"$out\" | grep -q '3'");

    let br: String = tmpd + "/carith_rfail";
    check(p, oodac + " build " + root + "/fixtures/contract_arith_req_fail.oo " + br + " > " + tmpd + "/carith_b.out 2> " + tmpd + "/carith_b.err", within: 60);
    expect_clean(p, "! " + br + " 2>&1 | grep -qiE 'contract|requires'");

    let bo: String = tmpd + "/carith_oafail";
    check(p, oodac + " build " + root + "/fixtures/contract_arith_or_and_fail.oo " + bo + " > " + tmpd + "/carith_b.out 2> " + tmpd + "/carith_b.err", within: 60);
    expect_clean(p, "! " + bo + " 2>&1 | grep -qiE 'contract|requires'");

    expect_substring(fs, root + "/bootstrap/CONTRACTS_COMPLEX.oot", "CONTRACTS_COMPLEX_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'NO quantifier|no quantifier|not claim.*quantif|quantifiers' " + root + "/bootstrap/CONTRACTS_COMPLEX.oot");
    expect_clean(p, "grep -qiE 'old-state|old state' " + root + "/bootstrap/CONTRACTS_COMPLEX.oot");

    println("contracts_arith_smoke: PASSED");
}