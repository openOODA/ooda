// # JSON Errors Smoke
//
// Logline: Live ooda check --json-errors prints [] on pass and E_CAP on a no-cap fetch.
//
// Setup: Product ooda binary. No python3. No oodac_check_capture.sh.
//
// Beats:
//   1. Capture helper .sh files are absent.
//   2. ok_main --json-errors is [] and exit 0.
//   3. no_cap_fetch --json-errors contains E_CAP and fix_hint.

import "std/scenario.oo";
import "std/sh.oo";

fn pick_ooda(p: &ProcessCap, root: String) -> String {
    let envb = match sh_env_get_or(p, "OODA", "") { Ok(s) => s, Err(_) => "" };
    if envb != "" {
        if expect_quiet(p, "test -x " + envb).is_ok() { return envb; }
    }
    if expect_quiet(p, "test -x /tmp/ooda_cli_native").is_ok() { return "/tmp/ooda_cli_native"; }
    if expect_quiet(p, "test -x /tmp/ooda_cli").is_ok() { return "/tmp/ooda_cli"; }
    return root + "/bin/ooda";
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let ooda = pick_ooda(p, root);
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ooda check --json-errors");

    if expect_quiet(p, "test -x " + ooda).is_err() { println("FAIL no ooda"); process_exit(1); }
    if expect_absent(fs, "scripts/oodac_check_capture.sh").is_err() {
        println("FAIL leftover capture.sh"); process_exit(1);
    }
    if expect_present(fs, "bootstrap/corpus/check/pass/ok_main.oo").is_err() {
        println("FAIL missing ok_main"); process_exit(1);
    }
    if expect_present(fs, "bootstrap/corpus/check/fail/no_cap_fetch.oo").is_err() {
        println("FAIL missing no_cap_fetch"); process_exit(1);
    }

    let pass = "bootstrap/corpus/check/pass/ok_main.oo";
    let fail = "bootstrap/corpus/check/fail/no_cap_fetch.oo";
    if check(p, ooda + " check " + pass + " --json-errors > " + tmpd + "/je_ok.out 2> " + tmpd + "/je_ok.err", within: 30).is_err() {
        println("FAIL pass json-errors"); process_exit(1);
    }
    if expect_clean(p, "grep -qx '\\[\\]' " + tmpd + "/je_ok.out").is_err() {
        println("FAIL pass not []"); process_exit(1);
    }

    if expect_clean(p, "! " + ooda + " check " + fail + " --json-errors > " + tmpd + "/je_cap.out 2> " + tmpd + "/je_cap.err").is_err() {
        println("FAIL fetch should be nonzero"); process_exit(1);
    }
    if expect_clean(p, "grep -q E_CAP " + tmpd + "/je_cap.out").is_err() {
        println("FAIL missing E_CAP"); process_exit(1);
    }
    if expect_clean(p, "grep -q fix_hint " + tmpd + "/je_cap.out").is_err() {
        println("FAIL missing fix_hint"); process_exit(1);
    }
    if expect_clean(p, "grep -q CapabilitySecurityViolation " + tmpd + "/je_cap.out").is_err() {
        println("FAIL missing kind"); process_exit(1);
    }

    println("json_errors_smoke: PASSED");
}
