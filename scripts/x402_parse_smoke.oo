// # x402 v2 quote parse and spend-pin refuse
//
// Logline: Parse a fixture 402 quote and refuse spend without a pin.
//
// Setup: cwd is ooda/. No network. Caps are process and fs-read.
//
// Beats:
//   1. Status 402 is payment required. 200 is not.
//   2. Fixture quote is v2: payTo, amount, CAIP-2 network, resource.url.
//   3. Spend without pin is denied. Empty proof is denied.

import "std/net/x402.oo";
import "std/net/x402_spend.oo";
import "std/net/http_response.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if !x402_is_payment_required(402) {
        fail("402");
    }
    if x402_is_payment_required(200) {
        fail("200");
    }
    if http_response_reason(402) != "Payment Required" {
        fail("reason");
    }
    if x402_required_header_name() != "PAYMENT-REQUIRED" {
        fail("required header");
    }
    if x402_payment_header_name() != "PAYMENT-SIGNATURE" {
        fail("sig header");
    }
    if x402_response_header_name() != "PAYMENT-RESPONSE" {
        fail("resp header");
    }
    if !path_exists(fs, "fixtures/x402_quote.json") {
        fail("no fixture");
    }
    let raw: Result[String, String] = read_file(fs, "fixtures/x402_quote.json");
    if raw.is_err() {
        fail("read");
    }
    let body: String = match raw { Ok(s) => s, Err(m) => m };
    let q: X402Quote = x402_parse_quote(body);
    if q.version != 2 {
        fail("version");
    }
    if !x402_quote_ready(q) {
        fail("not ready");
    }
    if q.pay_to != "0xpayto" {
        fail("payTo");
    }
    if q.amount != "1000" {
        fail("amount");
    }
    if q.network != "eip155:8453" {
        fail("network");
    }
    if q.resource != "https://pay.example/resource" {
        fail("resource");
    }
    let built: String = x402_required_json("0xpayto", "1000", "eip155:8453", "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", "https://pay.example/resource");
    let q2: X402Quote = x402_parse_quote(built);
    if q2.pay_to != "0xpayto" {
        fail("roundtrip");
    }
    if q2.version != 2 {
        fail("built version");
    }
    let deny: Result[Bool, String] = x402_attach_or_deny("", "proof");
    if deny.is_ok() {
        fail("spend without pin");
    }
    let empty: Result[Bool, String] = x402_attach_or_deny("1", "");
    if empty.is_ok() {
        fail("empty proof");
    }
    let ok: Result[Bool, String] = x402_attach_or_deny("1", "proof");
    if ok.is_err() {
        fail("pin on");
    }
    if x402_payment_header_line("proof") != "PAYMENT-SIGNATURE: proof" {
        fail("header");
    }
    println("x402_parse_smoke: PASSED");
}
