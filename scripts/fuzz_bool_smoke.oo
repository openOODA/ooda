// # Fuzz Bool Smoke
// Logline: pure Bool-domain fuzz pass + fail rails; non-domain fail-closed; no python.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let ooda  = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "fuzz bool domain");

    // when — fuzz bool domain pass (rc 0)
    let _ = expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_bool_domain.oo --fuzz 20 +\" 2>&1 | head -1");

    // and — fuzz bool fail rail (non-zero)
    let _ = expect_quiet(p, "!" + ooda + " test " + root + "/fixtures/fuzz_bool_fail.oo --fuzz 20 +\" 2>&1");

    // then — non-domain fail-closed
    let _ = expect_clean(p, "!" + ooda + " test " + root + "/fixtures/chs_list_string.oo --fuzz 2 +\" 2>&1 | grep -qiE 'FUZZ_DOMAIN|fail-closed|supports only'");

    println("fuzz_bool_smoke: PASSED");
}