// # OODA Fuzz Pure
//
// Logline: pure contract fuzz harness — Int / Bool / String / List[Int] targets (no Python); FUZZ_DOMAIN / FUZZ_TARGET / FUZZ_REQUIRES / FUZZ_ENSURES markers drive arity-aware sample/call emit; fail-closed on arity ≥2 wrong-typed or no parameters.
//
// Setup: Process capability and test fixtures available.
//
// Beats: domain gate | target parse | requires/ensures keyed by fn | arity probe | harness emit + run.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = scenario(p, fs, "fuzz pure contract harness");

    // when "FUZZ_DOMAIN gate (int|bool|string|list_int→list)" {
    // and  "FUZZ_TARGET lines parsed (name [min max])" {
    // and  "FUZZ_REQUIRES / FUZZ_ENSURES keyed by fn (AND multi-//)" {
    // and  "arity probe + arity-check fail-closed" {
    // and  "harness .oo emitted, check + emit-c + gcc link" {
    // then "ooda_fuzz_pure PASSED" { } } } } }

    expect_present(fs, root + "/scripts/ooda_fuzz_pure.sh");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure.sh", "FUZZ_DOMAIN");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure.sh", "FUZZ_TARGET");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure.sh", "FUZZ_REQUIRES");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure.sh", "FUZZ_ENSURES");
    expect_substring(fs, root + "/scripts/ooda_fuzz_pure.sh", "list_int");
    expect_clean(p, "test -x " + oodac);
    println("ooda_fuzz_pure: PASSED (harness generator catalogued)");
}
