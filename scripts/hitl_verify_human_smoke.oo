// # HITL verify_human honesty smoke
//
// Logline: Fail if HITL product files remain; do not claim verify_human works.
//
// Setup: Runtime verify_human is leftover residual, not product.
//
// Beats:
//   1. Fail if std/hitl.oo is present.
//   2. Fail if check_hitl still denies.
//   3. Fail if ooda_apply_ehitl_fix.py is leftover.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = scenario(p, fs, "verify_human is leftover residual");

    if expect_clean(p, "test ! -f std/hitl.oo && test ! -f ooda/std/hitl.oo").is_err() {
        println("FAIL: std/hitl.oo still present");
        process_exit(1);
    }
    if expect_clean(p, "! grep -qE 'process_exit|non-interactive deny' oodac/check_hitl.oo ooda/oodac/check_hitl.oo 2>/dev/null").is_err() {
        println("FAIL: check_hitl still denies");
        process_exit(1);
    }
    if expect_clean(p, "test ! -f scripts/ooda_apply_ehitl_fix.py && test ! -f ooda/scripts/ooda_apply_ehitl_fix.py").is_err() {
        println("FAIL: leftover ooda_apply_ehitl_fix.py");
        process_exit(1);
    }

    println("hitl_verify_human_smoke: PASSED (HITL not product; human loop is ooda fix)");
}
