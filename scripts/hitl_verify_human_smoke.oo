// # HITL Verify-Human Smoke
//
// Logline: M165 Path A — verify_human is a free builtin (env-gated Result, not residual refuse), emits oo_verify_human, and runs with deny / auto-approve paths.
// Setup: oodac/oodac prebuilt; gcc; runtime/chs_rt_hitl.c; fixtures/hitl_verify_human.oo.
//
// Beats: residual table does not refuse | check OK | emit lowers oo_verify_human | runtime deny without allow | runtime auto-approve approved + log | runtime + preamble + tc_names wire.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M165 verify_human free builtin path A");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/hitl_verify_human.oo");

    // when "residual table does not refuse verify_human" {
    // and  "check accepts the free name" {
    // and  "emit lowers to oo_verify_human" {
    // and  "runtime deny without allow prints `denied`" {
    // and  "runtime auto-approve prints `approved` + logs HITL" {
    // and  "runtime + preamble + tc_names wire" {
    // then "verify_human path A green" {

    expect_clean(p, "! grep -qE 'name == \"verify_human\"' " + root + "/oodac/check_residual.oo");

    check(p, oodac + " check " + root + "/fixtures/hitl_verify_human.oo > " + tmpd + "/vh_ck.out 2> " + tmpd + "/vh_ck.err", within: 30);
    expect_clean(p, "grep -qE '^OK' " + tmpd + "/vh_ck.out");

    check(p, oodac + " emit-c " + root + "/fixtures/hitl_verify_human.oo > " + tmpd + "/vh.c 2> " + tmpd + "/vh.err", within: 30);
    expect_substring(fs, tmpd + "/vh.c", "oo_verify_human");
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/vh.c -o " + tmpd + "/vh.bin -lm -ldl -lpthread 2> " + tmpd + "/vh_gcc.err", within: 60);
    expect_quiet(p, "test -x " + tmpd + "/vh.bin");

    let out: String = match process_exec(p, tmpd + "/vh.bin 2> " + tmpd + "/vh_deny.err") { Ok(s) => s, Err(_) => "" };
    expect_clean(p, "echo \"" + out + "\" | grep -qx 'denied'");

    let out: String = match process_exec(p, "OODA_HITL_ALLOW=1 OODA_HITL_AUTO_APPROVE=1 " + tmpd + "/vh.bin 2> " + tmpd + "/vh_ok.err") { Ok(s) => s, Err(_) => "" };
    expect_clean(p, "echo \"" + out + "\" | grep -qx 'approved'");
    expect_clean(p, "grep -qiE 'Auto-approved|verify_human' " + tmpd + "/vh_ok.err");

    expect_substring(fs, root + "/runtime/chs_rt_hitl.c", "oo_verify_human");
    expect_substring(fs, root + "/runtime/chs_rt_hitl.c", "OODA_HITL_ALLOW");
    expect_substring(fs, root + "/runtime/chs_rt_hitl.c", "OODA_HITL_AUTO_APPROVE");
    expect_substring(fs, root + "/runtime/chs_rt.c", "chs_rt_hitl.c");
    expect_substring(fs, root + "/oodac/c_emit_preamble.oo", "oo_verify_human");
    expect_substring(fs, root + "/oodac/tc_names.oo", "verify_human");

    println("hitl_verify_human_smoke: PASSED");
}