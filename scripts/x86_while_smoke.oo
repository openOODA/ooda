// # emit-x86 while/for leftover honesty lock
//
// Logline: emit-x86 of while and for fixtures prints ERR x86_emit and does not emit a silent once.
//
// Setup: cwd is ooda/. Product oodac/oodac. Inner println must not become _start.
//
// Beats:
//   1. emit-x86 while true println once.
//   2. emit-x86 for-range println once.
//   3. Require ERR and refuse _start.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pick_oodac(p: &ProcessCap, root: String) -> String {
    return root + "/oodac/oodac";
}

fn leftover_err(p: &ProcessCap, oodac: String, src: String, tmpd: String, tag: String) {
    let sfile = tmpd + "/x86_" + tag + ".s";
    let serr = tmpd + "/x86_" + tag + ".err";
    if process_exec(p, oodac + " emit-x86 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() {
            fail(tag + " successful .s omitted leftover");
        }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() { fail(tag + " no ERR"); }
    if expect_clean(p, "grep -q x86_emit " + sfile + " " + serr).is_err() { fail(tag + " no x86_emit"); }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() { fail(tag + " silent omit"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "x86 while for leftover honesty").is_err() { fail("scenario"); }
    if expect_clean(p, "uname -m | grep -qx x86_64").is_err() { fail("host is not x86_64"); }
    let oodac = pick_oodac(p, root);
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    let w = root + "/fixtures/x86_while.oo";
    let f = root + "/fixtures/x86_for.oo";
    if expect_present(fs, w).is_err() { fail("no x86_while.oo"); }
    if expect_present(fs, f).is_err() { fail("no x86_for.oo"); }
    leftover_err(p, oodac, w, tmpd, "while");
    leftover_err(p, oodac, f, tmpd, "for");
    println("x86_while_smoke: PASSED");
}
