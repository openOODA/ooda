// # DNS UdpCap path-A
//
// Logline: Prove resolve_ipv4 prefers &UdpCap and is not a bare NetCap-only path.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Assert std/src/net/dns.oo exists.
//   2. Probe the UdpCap signature.
//   3. Exit 0 only when path-A holds.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let dns_path = root + "/std/src/net/dns.oo";
    let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
    let ci_product = root + "/scripts/ci_product.sh";
    
    // DNS file exists
    let dns_exists = cmd_exec(p, "test -f " + dns_path);
    tr = test_assert(tr, "DNS file exists", dns_exists.is_ok());
    
    if !dns_exists.is_ok() {
        test_summary(tr);
        process_exit(1);
    }
    
    // 1-2) Static: resolve_ipv4 uses &UdpCap (not bare NetCap-only)
    let resolve_sig = cmd_exec(p, "grep -E '^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]+resolve_ipv4[[:space:]]*(' " + dns_path + " 2>/dev/null | head -1 || true");
    if resolve_sig.is_ok() {
        let sig = trim(resolve_sig.unwrap());
        if str_len(sig) > 0 {
            if str_contains(sig, "&UdpCap") {
                if str_contains(sig, "&NetCap") {
                    tr = test_assert(tr, "resolve_ipv4 still mentions &NetCap", false);
                } else {
                    tr = test_assert(tr, "static resolve_ipv4 uses &UdpCap", true);
                }
            } else if str_contains(sig, "&NetCap") {
                tr = test_assert(tr, "resolve_ipv4 still NetCap-only", false);
            } else {
                tr = test_assert(tr, "resolve_ipv4 missing &UdpCap formal", false);
            }
        }
    }
    
    // 3) Residual honesty string present
    let honesty = "Residual: UDP socket DNS not implemented";
    let check_honesty = cmd_exec(p, "grep -qF \"" + honesty + "\" " + dns_path);
    tr = test_assert(tr, "residual honesty string present", check_honesty.is_ok());
    
    // Soft: comment honesty that real UDP DNS is not product yet
    let check_residual_comment = cmd_exec(p, "grep -qiE 'residual|not (product|implemented|lowered)' " + dns_path);
    tr = test_assert(tr, "residual commentary present", check_residual_comment.is_ok());
    
    // 4) Optional oodac check (soft if binary missing; hard when present)
    let oodac_exists = cmd_exec(p, "test -x " + oodac);
    if oodac_exists.is_ok() {
        let oodac_res = cmd_exec(p, oodac + " check " + dns_path + " 2>&1");
        tr = test_assert(tr, "oodac check dns.oo", oodac_res.is_ok());
    } else {
        tr = test_assert(tr, "oodac check residual (optional)", true);
    }
    
    // Soft: ci_product wire after cap_process_facade_smoke
    if cmd_exec(p, "test -f " + ci_product).is_ok() {
        let check_ci = cmd_exec(p, "grep -q 'cap_dns_udp_smoke' " + ci_product);
        if check_ci.is_ok() {
            let check_after = cmd_exec(p, "grep -A2 'cap_process_facade_smoke' " + ci_product + " 2>/dev/null | grep -q 'cap_dns_udp_smoke'");
            if check_after.is_ok() {
                tr = test_assert(tr, "ci_product wire after cap_process", true);
            } else {
                tr = test_assert(tr, "ci_product soft-wire present", true);
            }
        } else {
            tr = test_assert(tr, "ci_product soft-wire residual (optional)", true);
        }
    }
    
    test_summary(tr);
    
    if tr.failed > 0 {
        process_exit(1);
    }
    
    println("cap_dns_udp_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
