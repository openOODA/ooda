// # Spec Depth Residual Smoke
//
// Logline: bootstrap/SPEC_DEPTH.oot carries the residual marker, fail-closed wording, and non-claims; the fixture wires it via ci_product.
// Beats: doc + marker | fail-closed | non-claims | fixture | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/SPEC_DEPTH.oot";
const MARKER: String = "SPEC_DEPTH_RESIDUAL_ALPHA";
const FIX: String = "ooda/fixtures/spec_marker.oo";
const FIXLINE: String = "SPEC: residual";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "spec depth residual honesty");

    // when: doc + marker + fail-closed + non-claims
    expect_present(fs, root + "/" + DOC);
    expect_substring(fs, root + "/" + DOC, MARKER);
    expect_clean(p, "grep -qiE 'fail-closed residual' " + root + "/" + DOC);
    expect_clean(p, "grep -qiE 'do \\*\\*not\\*\\* claim|not claim' " + root + "/" + DOC);

    // then: fixture marker line
    expect_present(fs, root + "/" + FIX);
    expect_substring(fs, root + "/" + FIX, FIXLINE);

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "spec_depth_residual_smoke");
    println("spec_depth_residual_smoke: PASSED");
}
