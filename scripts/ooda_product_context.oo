// # OODA Product Context
//
// Logline: ooda product CLI context backend — JSON {symbol,file,context,outline,est_tokens}; token-minimal slice (≤40 lines) + outline when oodac present; never dumps whole modules into agent context.
//
// Setup: Process capability and test fixtures available.
//
// Beats: file resolve | outline (if oodac) | symbol slice ≤40 lines | JSON envelope.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "ooda product_context JSON backend");

    // when "file resolves (file.oo or file#symbol)" {
    // and  "outline hint resolves when oodac present" {
    // and  "symbol slice ≤40 lines (truncated on overflow)" {
    // and  "JSON envelope carries est_tokens + hint" {
    // then "ooda_product_context PASSED" { } } } }

    expect_present(fs, root + "/scripts/ooda_product_context.sh");
    expect_substring(fs, root + "/scripts/ooda_product_context.sh", "est_tokens");
    expect_substring(fs, root + "/scripts/ooda_product_context.sh", "outline");
    expect_substring(fs, root + "/scripts/ooda_product_context.sh", "context");
    let target = root + "/fixtures/int_main.oo";
    expect_present(fs, target);
    let out = tmpd + "/opc.json";
    check(p, "bash " + root + "/scripts/ooda_product_context.sh " + target + " main > " + out, within: 25);
    expect_substring(fs, out, "\"symbol\"");
    expect_substring(fs, out, "\"est_tokens");
    println("ooda_product_context: PASSED (JSON envelope emitted)");
}
