// # Typecheck Pass Corpus Stays Green
// Logline: every fixture under bootstrap/corpus/typecheck/pass/* passes oodac check.
// Setup: oodac/oodac built; bootstrap/corpus/typecheck/pass/* on disk.
// Beats: 1. pass corpus non-empty | 2. each fixture OK + no ERR | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let pd    = root + "/bootstrap/corpus/typecheck/pass";
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — pass corpus non-empty
    let _w1 = process_exec(p, "ls -1 " + pd + "/*.oo > " + tmpd + "/tc_pass.lst 2>/dev/null");
    fails   = fails + tally(expect_quiet(p, "test -s " + tmpd + "/tc_pass.lst"),                  "pass corpus non-empty");

    // and — every fixture: exit 0 + ^OK + no ^ERR
    fails = fails + tally(check(p, "for f in $(cat " + tmpd + "/tc_pass.lst); do out=" + oodac + " check \"$f\" 2>&1; rc=$?; [ \"$rc\" -eq 0 ] || exit 1; echo \"$out\" | grep -qE '^OK' || exit 1; echo \"$out\" | grep -qE '^ERR' && exit 1; done", 240), "pass corpus all OK");

    // then — wrap-up
    if fails > 0 { println("typecheck_pass_smoke: FAILED"); process_exit(1); }
    println("typecheck_pass_smoke: PASSED");
}
