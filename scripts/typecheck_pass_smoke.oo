// # Typecheck Pass Corpus Stays Green
// Logline: every fixture under bootstrap/corpus/typecheck/pass/* passes oodac check.
// Setup: oodac/oodac built; bootstrap/corpus/typecheck/pass/* on disk.
// Beats: 1. pass corpus non-empty | 2. each fixture OK + no ERR | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let pd    = root + "/bootstrap/corpus/typecheck/pass";
    let _     = sh_mkdir_p(fw, tmpd);
    let _     = scenario(p, fs, "typecheck pass corpus");

    // when — pass corpus non-empty
    let _ = process_exec(p, "ls -1 " + pd + "/*.oo > " + tmpd + "/tc_pass.lst 2>/dev/null");
    let _ = expect_quiet(p, "test -s " + tmpd + "/tc_pass.lst");

    // and — every fixture: exit 0 + ^OK + no ^ERR
    let _ = check(p, "for f in $(cat " + tmpd + "/tc_pass.lst); do out=" + oodac + " check \"$f\" 2>&1; rc=$?; [ \"$rc\" -eq 0 ] || exit 1; echo \"$out\" | grep -qE '^OK' || exit 1; echo \"$out\" | grep -qE '^ERR' && exit 1; done", 240);

    println("typecheck_pass_smoke: PASSED");
}
