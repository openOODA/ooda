// # Process args dump
//
// Logline: Print every process_args slot as arg[i]=value.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Read process_args from ProcessCap.
//   2. Walk the list by index.
//   3. Print each slot.

import "std/os/process.oo";

pub fn main(p: &ProcessCap) {
    let p_args: List[String] = process_args(p);
    let n: Int = list_len(p_args);
    let mut i: Int = 0;
    while i < n {
        println("arg[" + i.to_string() + "]=" + list_get(p_args, i));
        i = i + 1;
    }
}
