// # Package manager smoke
//
// Logline: Seed a mock registry and run install plus the other PM workspace rails.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Write mock pkg-a, pkg-b, and install manifest files.
//   2. Run the install rail.
//   3. Record each rail on the test runner.

import "std/os/fs.oo";
import "std/str.oo";
import "std/test.oo";
import "std/os/process.oo";

fn setup_mock_registry(fsW: &FsWriteCap, registry_path: String) {
    let _r1: Result[Void, String] = fs_mkdir(fsW, registry_path);
    let _r2: Result[Void, String] = fs_mkdir(fsW, registry_path + "/api");
    let _r3: Result[Void, String] = fs_mkdir(fsW, registry_path + "/api/v1");
    let _r4: Result[Void, String] = fs_write_file(fsW, registry_path + "/api/v1/pkg-a", "mock pkg-a data");
    let _r5: Result[Void, String] = fs_write_file(fsW, registry_path + "/api/v1/pkg-b", "mock pkg-b data");
    let _r6: Result[Void, String] = fs_mkdir(fsW, registry_path + "/api/v1/manifest");
    let _r7: Result[Void, String] = fs_write_file(fsW, registry_path + "/api/v1/manifest/install", "mock install manifest data");
}

pub fn main(p: &ProcessCap, fsR: &FsReadCap, fsW: &FsWriteCap) {
    let mut tr: TestRunner = test_runner_new();
    let root = "/home/jeryd/Projects/openOODA/ooda/";

    // --- Test 1: Install ---
    let registry_dir1 = root + "test_pm_mock_reg_inst";
    let workspace_dir1 = root + "test_pm_ws_inst";
    let cache_dir1 = root + "test_pm_cache_inst";

    let _m1: Result[Void, String] = fs_mkdir(fsW, workspace_dir1);
    let _m2: Result[Void, String] = fs_mkdir(fsW, cache_dir1);
    setup_mock_registry(fsW, registry_dir1);

    let svr1_cmd = "cd " + registry_dir1 + " && python3 -m http.server 8123";
    let _s1: Result[String, String] = process_exec(p, "sh -c \"" + svr1_cmd + " & sleep 1\"");

    let manifest_content1 = "name = \"test-workspace\"\nversion = \"1.0.0\"\n\n[dependencies]\npkg-a = \"1.0.0\"\npkg-b = \"1.0.0\"\n";
    let _w1: Result[Void, String] = fs_write_file(fsW, workspace_dir1 + "/package.oo", manifest_content1);

    let cmd1 = "cd " + workspace_dir1 + " && env -u OODA_FS_WRITEDIR OODA_FS_WRITEDIR=" + workspace_dir1 + " OODA_COMPILER=" + root + "oodac/oodac OODA_SRC_ROOT=" + root + " OODA_CACHE_DIR=" + cache_dir1 + " " + root + "bin/ooda install --registry http://127.0.0.1:8123";
    let install_res: Result[String, String] = process_exec(p, "sh -c \"" + cmd1 + "\"");
    tr = test_assert(tr, "ooda install command execution", install_res.is_ok());
    tr = test_assert(tr, "install manifest downloaded", fs_path_exists(fsR, workspace_dir1 + "/.ooda_modules/cas/manifest_install.json"));

    // --- Test 2: Add ---
    let registry_dir2 = root + "test_pm_mock_reg_add";
    let workspace_dir2 = root + "test_pm_ws_add";
    let cache_dir2 = root + "test_pm_cache_add";

    let _m3: Result[Void, String] = fs_mkdir(fsW, workspace_dir2);
    let _m4: Result[Void, String] = fs_mkdir(fsW, cache_dir2);
    setup_mock_registry(fsW, registry_dir2);

    let svr2_cmd = "cd " + registry_dir2 + " && python3 -m http.server 8124";
    let _s2: Result[String, String] = process_exec(p, "sh -c \"" + svr2_cmd + " & sleep 1\"");

    let manifest_content2 = "name = \"test-workspace\"\nversion = \"1.0.0\"\n\n[dependencies]\n";
    let _w2: Result[Void, String] = fs_write_file(fsW, workspace_dir2 + "/package.oo", manifest_content2);

    let cmd2 = "cd " + workspace_dir2 + " && env -u OODA_FS_WRITEDIR OODA_FS_WRITEDIR=" + workspace_dir2 + " OODA_COMPILER=" + root + "oodac/oodac OODA_SRC_ROOT=" + root + " OODA_CACHE_DIR=" + cache_dir2 + " " + root + "bin/ooda add pkg-a --registry http://127.0.0.1:8124";
    let add_res: Result[String, String] = process_exec(p, "sh -c \"" + cmd2 + "\"");
    tr = test_assert(tr, "ooda add command execution", add_res.is_ok());
    tr = test_assert(tr, "add pkg-a downloaded", fs_path_exists(fsR, workspace_dir2 + "/.ooda_modules/cas/pkg-a"));

    test_summary(tr);
}
