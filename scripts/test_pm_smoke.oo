import "fs.oo";
import "process.oo";
import "test.oo";
import "str.oo";

fn setup_mock_registry(fsW: &FsWriteCap, registry_path: String) {
    let _ = fs_mkdir(fsW, registry_path);
    let _ = fs_mkdir(fsW, registry_path + "/pkg-a");
    let _ = fs_mkdir(fsW, registry_path + "/pkg-a/1.0.0");
    let _ = fs_write_file(fsW, registry_path + "/pkg-a/1.0.0/manifest.oo", "name = \"pkg-a\"\nversion = \"1.0.0\"\n[dependencies]\npkg-b = \"1.0.0\"\n");

    let _ = fs_mkdir(fsW, registry_path + "/pkg-b");
    let _ = fs_mkdir(fsW, registry_path + "/pkg-b/1.0.0");
    let _ = fs_write_file(fsW, registry_path + "/pkg-b/1.0.0/manifest.oo", "name = \"pkg-b\"\nversion = \"1.0.0\"\n[dependencies]\n");
}

pub fn main(p: &ProcessCap, fsR: &FsReadCap, fsW: &FsWriteCap) {
    let mut tr = test_runner_new();
    
    // --- Test 1: Install ---
    let registry_dir = "test_pm_mock_reg_inst";
    let workspace_dir = "test_pm_ws_inst";
    let cache_dir = "test_pm_cache_inst";

    let _ = fs_mkdir(fsW, workspace_dir);
    let _ = fs_mkdir(fsW, cache_dir);
    setup_mock_registry(fsW, registry_dir);

    let manifest_content = "name = \"test-workspace\"\nversion = \"1.0.0\"\n\n[dependencies]\npkg-a = \"1.0.0\"\n";
    let _ = fs_write_file(fsW, workspace_dir + "/package.oo", manifest_content);

    // Call standalone binary oodac/ooda-pm
    let cmd = "cd " + workspace_dir + " && OODA_CACHE_DIR=../" + cache_dir + " ../oodac/ooda-pm install --registry ../" + registry_dir;
    let install_res = process_exec(p, cmd);
    tr = test_assert(tr, "ooda install command execution", install_res.is_ok());

    tr = test_assert(tr, "install lockfile generated", fs_path_exists(fsR, workspace_dir + "/ooda.lock"));
    tr = test_assert(tr, "install pkg-a downloaded", fs_path_exists(fsR, workspace_dir + "/ooda_modules/pkg-a"));
    tr = test_assert(tr, "install pkg-b downloaded", fs_path_exists(fsR, workspace_dir + "/ooda_modules/pkg-b"));


    // --- Test 2: Add ---
    let registry_dir2 = "test_pm_mock_reg_add";
    let workspace_dir2 = "test_pm_ws_add";
    let cache_dir2 = "test_pm_cache_add";

    let _ = fs_mkdir(fsW, workspace_dir2);
    let _ = fs_mkdir(fsW, cache_dir2);
    setup_mock_registry(fsW, registry_dir2);

    let manifest_content2 = "name = \"test-workspace\"\nversion = \"1.0.0\"\n\n[dependencies]\n";
    let _ = fs_write_file(fsW, workspace_dir2 + "/package.oo", manifest_content2);

    let cmd2 = "cd " + workspace_dir2 + " && OODA_CACHE_DIR=../" + cache_dir2 + " ../oodac/ooda-pm add pkg-a --registry ../" + registry_dir2;
    let add_res = process_exec(p, cmd2);
    tr = test_assert(tr, "ooda add command execution", add_res.is_ok());

    tr = test_assert(tr, "add lockfile generated", fs_path_exists(fsR, workspace_dir2 + "/ooda.lock"));
    tr = test_assert(tr, "add pkg-a downloaded", fs_path_exists(fsR, workspace_dir2 + "/ooda_modules/pkg-a"));

    let r_manifest = fs_read_file(fsR, workspace_dir2 + "/package.oo");
    let manifest_str = match r_manifest { Ok(s) => s, Err(_) => "" };
    tr = test_assert(tr, "manifest updated with pkg-a", str_contains(manifest_str, "pkg-a"));

    test_summary(tr);
}
