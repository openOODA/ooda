import std.fs;
import std.os;
import std.testing;

// Helper to create a mock registry environment
fn setup_mock_registry(registry_path: String) {
    // Scaffold dummy packages for testing
    fs.write_file(registry_path + "/pkg-a/1.0.0/manifest.oo", "{ name: 'pkg-a', version: '1.0.0', deps: { 'pkg-b': '1.0.0' } }");
    fs.write_file(registry_path + "/pkg-b/1.0.0/manifest.oo", "{ name: 'pkg-b', version: '1.0.0', deps: {} }");
}

fn test_end_to_end_resolution_and_install() {
    let test_env = testing.create_temp_env();
    let registry_dir = test_env.create_dir("mock_registry");
    let workspace_dir = test_env.create_dir("workspace");

    // 1. Setup Mock Registry
    setup_mock_registry(registry_dir);

    // 2. Setup Workspace Manifest
    let manifest_content = """
    name = "test-workspace"
    version = "1.0.0"

    [dependencies]
    pkg-a = "1.0.0"
    """;
    fs.write_file(workspace_dir + "/package.oo", manifest_content);

    // 3. Execute PM Install command
    // We pass an environment variable or flag to override the default registry URL
    let result = os.exec("ooda", ["pm", "install", "--registry", registry_dir], {
        cwd: workspace_dir,
        env: { "OODA_CACHE_DIR": test_env.create_dir("cache") }
    });

    // 4. Validate Exit Code
    testing.assert_eq(result.exit_code, 0, "Package manager install failed: " + result.stderr);

    // 5. Validate Lockfile Generation
    let lockfile_path = workspace_dir + "/ooda.lock";
    testing.assert(fs.exists(lockfile_path), "Lockfile was not generated.");
    
    let lockfile_content = fs.read_file(lockfile_path);
    testing.assert(lockfile_content.contains("pkg-a"), "Lockfile missing pkg-a");
    testing.assert(lockfile_content.contains("pkg-b"), "Lockfile missing transitive dependency pkg-b");

    // 6. Validate Downloaded Modules
    let modules_dir = workspace_dir + "/ooda_modules";
    testing.assert(fs.exists(modules_dir + "/pkg-a"), "pkg-a was not installed to workspace.");
    testing.assert(fs.exists(modules_dir + "/pkg-b"), "pkg-b was not installed to workspace.");

    test_env.cleanup();
}

// Run the smoke test
pub fn main() {
    testing.run([
        test_end_to_end_resolution_and_install,
    ]);
}
