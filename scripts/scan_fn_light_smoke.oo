// # Scan Fn Light Stays Token-Cheap
// Logline: scan_fn_names has no tokenize_lines + comment/string-skip + defined — 1.8 GiB RSS regress stays dead.
// Setup: oodac/check_scan.oo + oodac/check_collect.oo on disk (grep-only; no host rebuild needed).
// Beats: 1. extract scan_fn_names body | 2. no tokenize_lines | 3. comment/string skip | 4. defined somewhere

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _    = sh_mkdir_p(fw, tmpd);
    let _    = scenario(p, fs, "scan_fn light");

    let scan = root + "/oodac/check_scan.oo";
    let collect = root + "/oodac/check_collect.oo";

    // when — at least one file exists
    let _ = check(p, "test -f " + scan + " || test -f " + collect, 5);

    // and — bash -n sanity on this script (informational)
    let _ = expect_clean(p, "bash -n " + root + "/ooda/scripts/scan_fn_light_smoke.oo 2>/dev/null; true");

    // and — extract top-level scan_fn_names body (awk: stop at next fn)
    let body1 = tmpd + "/scan_body1.txt";
    let body2 = tmpd + "/scan_body2.txt";
    let _ = process_exec(p, "awk 'BEGIN{p=0} /^pub fn scan_fn_names\\(/ || /^fn scan_fn_names\\(/{p=1; print; next} p && (/^pub fn / || /^fn /){exit} p{print}' " + scan + " > " + body1 + " 2>/dev/null; true");
    let _ = process_exec(p, "awk 'BEGIN{p=0} /^pub fn scan_fn_names\\(/ || /^fn scan_fn_names\\(/{p=1; print; next} p && (/^pub fn / || /^fn /){exit} p{print}' " + collect + " > " + body2 + " 2>/dev/null; true");

    // then — body must not call tokenize_lines
    let _ = check(p, "test -s " + body1 + " && ! grep -q 'tokenize_lines' " + body1 + " || test ! -s " + body1, 5);
    let _ = check(p, "test -s " + body2 + " && ! grep -q 'tokenize_lines' " + body2 + " || test ! -s " + body2, 5);

    // and — comment-skip or string-skip near scan
    let _ = check(p, "grep -qE 'scan_skip_line_comment|scan_skip_string' " + scan + " || grep -qF '\"//\"' " + scan + " || grep -qF '\"\\\\\"' " + scan, 5);
    let _ = check(p, "grep -qE 'scan_skip_line_comment|scan_skip_string' " + collect + " || grep -qF '\"//\"' " + collect + " || grep -qF '\"\\\\\"' " + collect, 5);

    // then — defined at least once
    let _ = check(p, "test -s " + body1 + " || test -s " + body2, 5);

    println("scan_fn_light_smoke: ALL OK");
}
