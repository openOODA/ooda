// # ooda run product path
//
// Logline: Prove oodac run checks, emits C, gcc-links, and runs a fixture.
//
// Setup: OODAC_BIN is a host that implements run as check + emit + gcc + exec.
//
// Beats:
//   1. oodac check of the fixture prints OK.
//   2. oodac run of the fixture prints the hello line.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "ooda run product path");

    let fix = root + "/fixtures/hello.oo";
    let bin = tmp + "/hello_run.bin";
    expect_clean(p, oodac + " check " + fix);
    expect_clean(p, oodac + " run " + fix + " " + bin + " 2>&1 | grep -q 'Hello, openOODA Developer!'");
    println("ooda_run_product_smoke: PASSED");
}
