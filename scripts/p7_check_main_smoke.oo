// # P7 Check Main Smoke
//
// Logline: oodac check completes (no deadlock) on tiny fixture and oodac/main.oo.
//
// Beats: write tiny → expect present → check <8s → check oodac/main.oo <180s.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let fix = ".ooda-cache/ooda-tmp/p7_check_main";
    let tiny = fix + "/main.oo";
    let _ = sh_clean(p, fix);
    let _ = sh_mkdir_p(p, fix);
    let _ = match process_exec(p, "printf '%s\\n' 'pub fn main() {' '    let x = 1;' '}' > " + tiny) { Ok(s) => s, Err(_) => "" };

    let _ = scenario(p, fs, "p7 check main");
    let _ = expect_present(fs, tiny);
    let r1 = check(p, "oodac check " + tiny, within: 8);
    let r2 = check(p, "oodac check oodac/main.oo", within: 180);

    let _ = sh_clean(p, fix);

    if r1.is_err() || r2.is_err() {
        process_exit(1);
    }
    println("p7_check_main_smoke: ALL OK");
}