// # P7 Check Main Smoke
//
// Logline: oodac check completes (no deadlock) on a tiny fixture and on oodac/main.oo.
//
// Setup: oodac/oodac is built; oodac/main.oo is the path-A entry.
//
// Beats:
//   1. write tiny main.oo → expect_present → check oodac <8s.
//   2. check oodac/main.oo <180s.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/p7_check_main";
const TINY: String = FIX + "/main.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let _ = sh_clean(p, FIX);
    let _ = sh_mkdir_p(p, FIX);
    let _ = expect_quiet(p, "printf '%s\\n' 'pub fn main() {' '    let x = 1;' '}' > " + TINY);
    let _ = scenario(p, fs, "p7 check main");

    when "tiny main.oo fixture present" {
    and  "tiny check completes <8s" {
    and  "oodac/main.oo check completes <180s" {
    then "p7 check main PASSED" { } } }

    expect_present(fs, TINY);
    let r1 = check(p, "oodac check " + TINY, within: 8);
    let r2 = check(p, "oodac check oodac/main.oo", within: 180);

    let _ = sh_clean(p, FIX);

    if r1.is_err() || r2.is_err() {
        process_exit(1);
    }
    println("p7_check_main_smoke: ALL OK");
}
