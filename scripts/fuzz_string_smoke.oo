// # Fuzz String Smoke
//
// Logline: Verify String-domain fuzz testing executes pass and fail rails with fail-closed non-domain handling.
//
// Setup: ooda binary and fuzz_string fixtures exist on disk.
//
// Beats:
//   1. Execute fuzz testing over fuzz_string_domain fixture to verify successful passes.
//   2. Execute fuzz testing over fuzz_string_fail fixture to verify failure rail detection.
//   3. Execute fuzz testing against non-String fixtures to verify fail-closed domain rejection.
import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let ooda  = sh_env_get_or(p, "OODA", root + "/bin/ooda").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "fuzz string domain");

    // when — fuzz string domain pass (rc 0)
    let _ = expect_clean(p, "! timeout 60 " + ooda + " test " + root + "/fixtures/fuzz_string_domain.oo --fuzz 20 +\" 2>&1 | head -1");

    // and — fuzz string fail rail (non-zero)
    let _ = expect_quiet(p, "!" + ooda + " test " + root + "/fixtures/fuzz_string_fail.oo --fuzz 20 +\" 2>&1");

    // then — non-domain fail-closed
    let _ = expect_clean(p, "!" + ooda + " test " + root + "/fixtures/chs_list_string.oo --fuzz 2 +\" 2>&1 | grep -qiE 'FUZZ_DOMAIN|fail-closed|supports only'");

    println("fuzz_string_smoke: PASSED");
}