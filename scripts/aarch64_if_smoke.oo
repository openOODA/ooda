// # emit-aarch64 const if lock
//
// Logline: Side emit-aarch64 prints T from if true and if false-else, and refuses IDENT if without _start.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. if-true and if-false-else write _start and T, not F; clang assembles ARM aarch64.
//   3. IDENT if prints ERR and has no _start.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn emit_t(p: &ProcessCap, fs: &FsReadCap, side: String, src: String, sfile: String, serr: String, obj: String, tag: String) {
    if check(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr, 30).is_err() { fail(tag + " emit"); }
    if expect_clean(p, "! grep -qE '^ERR' " + sfile + " " + serr).is_err() { fail(tag + " ERR"); }
    if expect_substring(fs, sfile, "_start").is_err() { fail(tag + " no _start"); }
    if expect_substring(fs, sfile, "svc #0").is_err() { fail(tag + " no svc"); }
    if expect_substring(fs, sfile, "T").is_err() { fail(tag + " no T"); }
    if expect_clean(p, "! grep -qF '.ascii \"F\\n\"' " + sfile).is_err() { fail(tag + " emitted F"); }
    if expect_clean(p, "! grep -qE '#include|chs_rt|syscall|%rax' " + sfile).is_err() { fail(tag + " wrong backend"); }
    if check(p, "clang -target aarch64-linux-gnu -c " + sfile + " -o " + obj, 15).is_err() { fail(tag + " assemble"); }
    if expect_clean(p, "file " + obj + " | grep -q 'ARM aarch64'").is_err() { fail(tag + " not ARM"); }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let fx = root + "/fixtures/";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 const if").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x /usr/bin/clang").is_err() { fail("no clang"); }
    ensure_aarch64_side(p, root, prod, side);
    emit_t(p, fs, side, fx + "aarch64_if_true.oo", tmpd + "/a64_ift.s", tmpd + "/a64_ift.err", tmpd + "/a64_ift.o", "true");
    emit_t(p, fs, side, fx + "aarch64_if_false.oo", tmpd + "/a64_iff.s", tmpd + "/a64_iff.err", tmpd + "/a64_iff.o", "false");
    let bfile = tmpd + "/a64_ifi.s";
    let berr = tmpd + "/a64_ifi.err";
    if process_exec(p, side + " emit-aarch64 " + fx + "aarch64_if_ident.oo > " + bfile + " 2>" + berr).is_ok() {
        if expect_clean(p, "grep -q _start " + bfile).is_ok() { fail("ident wrote _start"); }
    }
    if expect_clean(p, "grep -qE 'ERR' " + bfile + " " + berr).is_err() { fail("ident no ERR"); }
    if expect_clean(p, "! grep -q _start " + bfile).is_err() { fail("ident silent omit"); }
    println("aarch64_if_smoke: PASSED");
}
