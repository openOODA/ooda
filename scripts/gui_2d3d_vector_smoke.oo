// # Dedicated GUI 2D/3D & Vector Graphics Smoke Test
//
// Logline: End-to-end verification of 3D math, camera, mesh, pipeline, Bézier curves, vector paths, polygon rasterizer, and anti-aliasing.
//
// Setup: Validates openOODA std/gui 2D/3D graphics engine on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify 3D vector arithmetic, 4x4 matrix multiplication, and perspective transformation.
//   2. Verify 3D camera view-projection, cube/pyramid mesh generation, and backface culling.
//   3. Verify cubic Bézier de Casteljau splitting, arc length, and vector path flattening.
//   4. Verify point-in-polygon ray casting, scanline filling, and Xiaolin Wu anti-aliasing blending.

import "std/gui/render.oo";
import "std/gui/gui_3d_math.oo";
import "std/gui/gui_3d_camera.oo";
import "std/gui/gui_3d_mesh.oo";
import "std/gui/gui_3d_pipeline.oo";
import "std/gui/gui_bezier_cubic.oo";
import "std/gui/gui_vector_path.oo";
import "std/gui/gui_polygon_rasterizer.oo";
import "std/gui/gui_antialiasing.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA GUI 2D/3D & Vector Engine Integration Smoke");
    println("===================================================================");

    // 1. 3D Vector & Matrix Transformations
    let va: Vec3 = vec3_new(1.0, 0.0, 0.0);
    let vb: Vec3 = vec3_new(0.0, 1.0, 0.0);
    let v_cross: Vec3 = vec3_cross(va, vb);
    let v_dot: Float = vec3_dot(va, vb);

    if (v_cross).z != 1.0 || v_dot != 0.0 {
        println("FAIL: 3D Vector cross/dot product mismatch");
        process_exit(1);
    }

    let m_ident: Mat4 = mat4_identity();
    let m_trans: Mat4 = mat4_translate(5.0, 10.0, 15.0);
    let m_comb: Mat4 = mat4_mul(m_ident, m_trans);

    if (m_comb).m03 != 5.0 || (m_comb).m13 != 10.0 || (m_comb).m23 != 15.0 {
        println("FAIL: 4x4 Matrix multiplication mismatch");
        process_exit(1);
    }
    println("  [PASS] 1. 3D Vector Math & 4x4 Matrix Transformations");

    // 2. 3D Camera, Mesh, & Rasterization Pipeline
    let eye: Vec3 = vec3_new(0.0, 0.0, 5.0);
    let target: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let cam: Camera3D = camera3d_new(eye, target, 60.0, 1.33);
    let mvp: Mat4 = camera3d_view_proj_matrix(cam);

    let cube: Mesh3D = mesh3d_make_cube(2.0, 255, 128, 0);
    let n_tris: Int = list_len((cube).triangles);
    if n_tris != 4 {
        println("FAIL: 3D Cube mesh triangle count mismatch (expected 4 front/back triangles)");
        process_exit(1);
    }

    let tri0: Triangle3D = list_get((cube).triangles, 0);
    let is_back: Bool = triangle3d_is_backface(tri0, Vec3 { x: 0.0, y: 0.0, z: 0.0 - 1.0 });
    if is_back {
        println("FAIL: 3D Triangle backface culling mismatch for front-facing triangle");
        process_exit(1);
    }

    let mut rctx3d: RenderContext3D = render_context3d_new(100, 100);
    let light: Vec3 = vec3_new(0.0, 0.0, 0.0 - 1.0);
    render_3d_draw_flat_shaded(&mut rctx3d, &cube, mvp, light);
    println("  [PASS] 2. 3D Camera View-Projection, Mesh Generation, & Software 3D Pipeline");

    // 3. Vector Path & Cubic Bézier Subdivision
    let pt0: Point = Point { x: 0, y: 0 };
    let pt1: Point = Point { x: 50, y: 100 };
    let pt2: Point = Point { x: 100, y: 100 };
    let pt3: Point = Point { x: 150, y: 0 };
    let cb: CubicBezier2D = cubic_bezier_new(pt0, pt1, pt2, pt3);

    let splits: List[CubicBezier2D] = cubic_bezier_split(cb, 50);
    if list_len(splits) != 2 {
        println("FAIL: Cubic Bézier de Casteljau split failed to return 2 sub-curves");
        process_exit(1);
    }

    let mut path: VectorPath = vector_path_new();
    vector_path_move_to(&mut path, 10, 10);
    vector_path_cubic_to(&mut path, 30, 80, 70, 80, 90, 10);
    vector_path_close(&mut path);

    let bounds: Rect = vector_path_bounds(&path);
    if ((bounds).origin).x != 10 || ((bounds).origin).y != 10 {
        println("FAIL: Vector path bounding box calculation mismatch");
        process_exit(1);
    }

    let flat_pts: List[Point] = vector_path_flatten(&path, 5);
    if list_len(flat_pts) < 5 {
        println("FAIL: Vector path curve flattening produced insufficient points");
        process_exit(1);
    }
    println("  [PASS] 3. Vector Path Compilation & Cubic Bézier Subdivision");

    // 4. Polygon Rasterizer & Xiaolin Wu Anti-Aliasing
    let mut poly: Polygon2D = polygon_new();
    polygon_add_point(&mut poly, Point { x: 10, y: 10 });
    polygon_add_point(&mut poly, Point { x: 50, y: 10 });
    polygon_add_point(&mut poly, Point { x: 50, y: 50 });
    polygon_add_point(&mut poly, Point { x: 10, y: 50 });

    let inside: Bool = polygon_contains_point(poly, Point { x: 30, y: 30 });
    let outside: Bool = polygon_contains_point(poly, Point { x: 5, y: 5 });
    if !inside || outside {
        println("FAIL: Point-in-polygon ray casting algorithm mismatch");
        process_exit(1);
    }

    let c_white: Color = Color { r: 255, g: 255, b: 255, a: 255 };
    let c_black: Color = Color { r: 0, g: 0, b: 0, a: 255 };
    let c_blend: Color = color_blend_alpha(c_black, c_white, 128);
    if (c_blend).r != 128 || (c_blend).g != 128 || (c_blend).b != 128 {
        println("FAIL: Alpha color blending arithmetic mismatch");
        process_exit(1);
    }

    let mut rctx2d: RenderContext = render_context_new(100, 100);
    rctx2d = polygon_rasterize_fill(rctx2d, poly, 0, c_white);
    rctx2d = aa_draw_line_xiaolin_wu(rctx2d, Point { x: 0, y: 0 }, Point { x: 99, y: 99 }, c_white);
    println("  [PASS] 4. Polygon Scanline Rasterizer & Xiaolin Wu Subpixel Anti-Aliasing");

    println("gui_2d3d_vector_smoke: PASSED");
}
