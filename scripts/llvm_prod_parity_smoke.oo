// # LLVM Prod Parity Smoke
//
// Logline: M119 — emit-llvm + llvm_link + run at -O0 and -O3 produce the same stdout as the Backend-C golden for CHS four + multi-module import.
//
// Setup: Process capability and test fixtures available.
// Beats: oodac + link + runtime present | five fixtures | Backend-C golden | LLVM O0/O3 match per fixture.

import "std/scenario.oo";
import "std/sh.oo";

const FIXTURES: List[String] = [
    "chs_hello|fixtures/chs_hello.oo|single",
    "while_count|fixtures/while_count.oo|single",
    "for_range|fixtures/for_range.oo|single",
    "chs_list_string|fixtures/chs_list_string.oo|single",
    "m119_multi|fixtures/m119_multi/main.oo|import"
];

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/llvm_prod_parity";
    let _ = sh_mkdir_p(p, tmp);
    let _ = scenario(p, fs, "M119 LLVM ↔ Backend-C parity at O0/O3");

    // when: oodac + llvm_link + runtime are all present
    expect_clean(p, "test -x " + oodac);
    expect_present(fs, root + "/ooda/scripts/llvm_link.sh");
    expect_present(fs, root + "/ooda/runtime/chs_rt.c");

    // and: each fixture runs under Backend-C (golden) and under LLVM at O0/O3 with matching stdout
    let mut i: Int = 0;
    let n: Int = list_len(FIXTURES);
    while i < n {
        let entry = list_get(FIXTURES, i);
        let name = pick_field(entry, "|", 0);
        let rel = pick_field(entry, "|", 1);
        let src = root + "/" + rel;
        expect_present(fs, src);

        // Backend-C golden
        let cbin = tmp + "/" + name + "_c.bin";
        let _ = process_exec(p, "PURE_SKIP_CHECK=1 OODAC_BIN=" + oodac + " bash " + root + "/ooda/scripts/my_pure_build.sh " + src + " " + cbin + " > " + tmp + "/c_build.out 2> " + tmp + "/c_build.err");
        expect_clean(p, "test -x " + cbin);
        let gold = match process_exec(p, cbin + " 2>/dev/null | tr -d '\\r'") { Ok(s) => s, Err(_) => "" };

        let mut opt_i: Int = 0;
        let opts = ["-O0", "-O3"];
        while opt_i < 2 {
            let opt = list_get(opts, opt_i);
            let ll = tmp + "/" + name + opt + ".ll";
            let lbin = tmp + "/" + name + opt + ".bin";
            check(p, "timeout 60 " + oodac + " emit-llvm " + src + " > " + ll + " 2> " + tmp + "/ll_emit.err", within: 60);
            expect_clean(p, "grep -q 'define ' " + ll);
            let _ = process_exec(p, "bash " + root + "/ooda/scripts/llvm_link.sh " + opt + " " + ll + " " + lbin);
            let got = match process_exec(p, lbin + " 2>/dev/null | tr -d '\\r'") { Ok(s) => s, Err(_) => "" };
            expect_clean(p, "test \"$got\" = \"" + gold + "\" || ! (echo got=$got gold=$gold)");
            opt_i = opt_i + 1;
        }
        i = i + 1;
    }

    println("llvm_prod_parity_smoke: PASSED");
}

fn pick_field(s: String, sep: String, idx: Int) -> String {
    let mut start: Int = 0;
    let mut cur: Int = 0;
    let mut end: Int = chars_len(s);
    let mut j: Int = 0;
    while j < end {
        if char_at(s, j) == sep {
            if cur == idx { return str_slice(s, start, j); }
            cur = cur + 1;
            start = j + 1;
        }
        j = j + 1;
    }
    if cur == idx { return str_slice(s, start, end); }
    return "";
}
