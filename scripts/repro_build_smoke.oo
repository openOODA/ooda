// # Reproducible Build Attestation Verification Suite
//
// Logline: Verify type-safety, DINNER compliance, line-count constraints, oodac compilation, and binary execution of repro engine.
//
// Setup: oodac compiler binary built; std/src/ooda/repro modules on disk; fixtures/repro_build_fixture.oo present.
//
// Beats:
//   1. Check type-safety across reproducible build standard library modules and std/repro.oo entry point.
//   2. Validate DINNER headers and strictly <= 256 line count constraints across all source files.
//   3. Compile and execute repro_build_fixture binary, proving canonical AST hashing and bit-identical verification.
//   4. Verify multi-compiler attestation convergence, divergence detection, and entropy leak elimination.
//   5. Output test summary and emit final PASSED certification.
//
// residual: Distributed threshold signature aggregation for multi-party decentralized attestation

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let std_r = sh_realpath(p, root + "/../std").unwrap_or(root + "/../std");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _v0   = sh_mkdir_p(fw, tmpd);
    let _v1   = scenario(p, fs, "canonical ast serialization and reproducible build attestation");

    // Beat 1: Check type safety of repro modules
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/repro/repro_types.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/repro/build_canonicalize.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/repro/repro_attest.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/src/ooda/repro/repro.oo", 10);
    let _ = check(p, oodac + " check " + std_r + "/repro.oo", 10);

    // Beat 2: Validate line count constraints (strictly <= 256 lines)
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/repro/repro_types.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/repro/build_canonicalize.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/repro/repro_attest.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/src/ooda/repro/repro.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + std_r + "/repro.oo) -le 256", 5);
    let _ = check(p, "test $(wc -l < " + root + "/fixtures/repro_build_fixture.oo) -le 256", 5);

    // Beat 3: Check, compile, and execute end-to-end fixture
    let fix = root + "/fixtures/repro_build_fixture.oo";
    let _ = check(p, oodac + " check " + fix, 10);
    let _ = process_exec(p, oodac + " emit-c " + fix + " > " + tmpd + "/repro_build.c 2> " + tmpd + "/repro_build.err");
    let _ = check(p, "! grep -qE '^ERR' " + tmpd + "/repro_build.c " + tmpd + "/repro_build.err 2>/dev/null", 15);
    let _ = process_exec(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/repro_build.c -lm -ldl -lpthread -o " + tmpd + "/repro_build.bin 2>" + tmpd + "/repro_build_gcc.err");
    let _ = process_exec(p, tmpd + "/repro_build.bin > " + tmpd + "/repro_build.out 2>&1");
    let _ = check(p, "grep -qx 'REPRO_MANIFEST_INIT_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_SANITY_POLICY_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_CANONICAL_AST_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_MULTI_ATTEST_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_BIT_IDENTICAL_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_DIVERGENCE_DETECT_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_ENTROPY_LEAK_DETECT_OK' " + tmpd + "/repro_build.out", 10);
    let _ = check(p, "grep -qx 'REPRO_BUILD_FIXTURE_ALL_PASSED' " + tmpd + "/repro_build.out", 10);

    // Beat 4: DINNER header verification
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/src/ooda/repro/repro.oo", 5);
    let _ = check(p, "grep -qE '^// Logline: ' " + std_r + "/src/ooda/repro/repro.oo", 5);
    let _ = check(p, "grep -qE '^// Setup: ' " + std_r + "/src/ooda/repro/repro.oo", 5);
    let _ = check(p, "grep -qE '^// Beats:' " + std_r + "/src/ooda/repro/repro.oo", 5);
    let _ = check(p, "grep -qE '^// # ' " + std_r + "/repro.oo", 5);

    println("repro_build_smoke: PASSED");
}
