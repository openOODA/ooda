// # emit-aarch64 parenthesized if leftover lock
//
// Logline: Side emit-aarch64 of if (true) prints ERR and does not write _start.
//
// Setup: cwd is ooda/. Drive oodac/oodac.aarch64 only.
//
// Beats:
//   1. Rebuild the side ELF when sources are newer.
//   2. emit-aarch64 leftover fixture.
//   3. Require ERR and refuse a successful _start.

import "std/scenario.oo";
import "std/sh.oo";
import "aarch64_side.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = ".ooda-cache/ooda-tmp";
    let prod = root + "/oodac/oodac";
    let side = root + "/oodac/oodac.aarch64";
    let src = root + "/fixtures/aarch64_ifparen.oo";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "aarch64 paren if leftover").is_err() { fail("scenario"); }
    if expect_present(fs, src).is_err() { fail("no ifparen fixture"); }
    ensure_aarch64_side(p, root, prod, side);
    let sfile = tmpd + "/aarch64_ifparen.s";
    let serr = tmpd + "/aarch64_ifparen.err";
    if process_exec(p, side + " emit-aarch64 " + src + " > " + sfile + " 2>" + serr).is_ok() {
        if expect_clean(p, "grep -q _start " + sfile).is_ok() { fail("paren if wrote _start"); }
    }
    if expect_clean(p, "grep -qE 'ERR' " + sfile + " " + serr).is_err() { fail("no ERR"); }
    if expect_clean(p, "grep -q aarch64_emit " + sfile + " " + serr).is_err() { fail("no aarch64_emit"); }
    if expect_clean(p, "! grep -q _start " + sfile).is_err() { fail("silent omit"); }
    println("aarch64_ifparen_smoke: PASSED");
}
