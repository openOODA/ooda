// # HITL Product Floor Smoke
//
// Logline: M157 HITL non-interactive deny-mode product floor — pause marker E_HITL, clean file OK, json-errors E_HITL, verify_human free builtin, residual smoke green.
// Setup: oodac/oodac prebuilt; fixtures/hitl_pause_{pass,fail}.oo + hitl_verify_human.oo.
//
// Beats: deny pause E_HITL | clean file OK | json-errors E_HITL payload | verify_human free builtin OK | hitl_residual_smoke sub-rail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_clean(fw, fs, root + "/.ooda-cache/check");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M157 HITL non-interactive deny-mode floor");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/hitl_pause_fail.oo");
    expect_present(fs, root + "/fixtures/hitl_pause_pass.oo");
    expect_present(fs, root + "/fixtures/hitl_verify_human.oo");

    when "pause marker triggers E_HITL (deny without --hitl-allowed)" {
    and  "clean file checks OK" {
    and  "json-errors payload carries E_HITL code" {
    and  "verify_human free builtin check OK" {
    and  "hitl_residual_smoke sub-rail green" {
    then "HITL product floor green" {
    } } } } }

    expect_clean(p, "! env -u OODA_HITL_ALLOW -u OODA_HITL_AUTO_APPROVE " + oodac + " check " + root + "/fixtures/hitl_pause_fail.oo > " + tmpd + "/hitl_f.out 2> " + tmpd + "/hitl_f.err");
    expect_clean(p, "grep -qE 'ERR\\thitl|non-interactive deny' " + tmpd + "/hitl_f.out " + tmpd + "/hitl_f.err");

    check(p, oodac + " check " + root + "/fixtures/hitl_pause_pass.oo > " + tmpd + "/hitl_p.out 2> " + tmpd + "/hitl_p.err", within: 30);
    expect_clean(p, "grep -qE '^OK' " + tmpd + "/hitl_p.out");

    expect_clean(p, "! env -u OODA_HITL_ALLOW -u OODA_HITL_AUTO_APPROVE " + oodac + " check " + root + "/fixtures/hitl_pause_fail.oo --json-errors > " + tmpd + "/hitl_j.out 2> " + tmpd + "/hitl_j.err");
    expect_clean(p, "grep -q '\"code\": \"E_HITL\"' " + tmpd + "/hitl_j.out");

    check(p, oodac + " check " + root + "/fixtures/hitl_verify_human.oo > " + tmpd + "/hitl_vh.out 2> " + tmpd + "/hitl_vh.err", within: 30);
    expect_clean(p, "grep -qE '^OK' " + tmpd + "/hitl_vh.out");

    check(p, root + "/scripts/hitl_residual_smoke.sh > " + tmpd + "/hitl_res.log 2>&1", within: 60);

    println("hitl_product_floor_smoke: PASSED");
}