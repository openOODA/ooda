// # Wasm Emit Hands Back A Module
// Logline: emit-wasm produces a complete .wat with module / wasi / fd_write / memory / _start.
// Setup: oodac/oodac or bin/ooda built.
// Beats: 1. emit-wasm produces .wat | 2. module + wasi + fd_write + memory + _start | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA_BIN",   root + "/bin/ooda").unwrap_or("");
    let _v0   = sh_mkdir_p(p, tmpd);

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when — emitter available + fixture present
    fails = fails + tally(expect_quiet(p, "test -x " + oodac + " || test -x " + ooda), "emitter binary");

    // and — emit-wasm produces .wat
    let src = tmpd + "/wasm_smoke_test.oo";
    let wat = tmpd + "/wasm_smoke_test.wat";
    let _w1 = process_exec(p, "printf 'pub fn main() {\\n    let msg: String = \"hello wasm smoke\"\\n    println(msg)\\n}\\n' > " + src);
    let _w2 = process_exec(p, "test -x " + ooda + " && " + ooda + " build --target wasm " + src + " -o " + wat + " || " + oodac + " emit-wasm " + src + " > " + wat);
    fails   = fails + tally(expect_present(p, wat), "emit-wasm produced .wat");

    // then — .wat is a complete module
    fails = fails + tally(expect_quiet(p, "grep -q 'module' "                + wat), "module keyword");
    fails = fails + tally(expect_quiet(p, "grep -q 'wasi_snapshot_preview1' " + wat), "wasi import");
    fails = fails + tally(expect_quiet(p, "grep -q 'fd_write' "               + wat), "fd_write import");
    fails = fails + tally(expect_quiet(p, "grep -q 'memory' "                 + wat), "memory declaration");
    fails = fails + tally(expect_quiet(p, "grep -q '_start' "                 + wat), "_start export");

    if fails > 0 { println("wasm_emit_smoke: FAILED"); process_exit(1); }
    println("wasm_emit_smoke: PASSED");
}
