// # Wasm Emit Hands Back A Module
//
// Logline: emit-wasm produces a \0asm binary with magic, version, and empty type/func/code.
//
// Setup: oodac/oodac or bin/ooda built.
//
// Beats:
//   1. Verify emit-wasm produces a WebAssembly binary.
//   2. Verify magic 00 61 73 6d 01 00 00 00.
//   3. file(1) names the output a wasm module.
// residual: full WASI hello bytecode is not this product path.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = match sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac") { Ok(s) => s, Err(_) => root + "/oodac/oodac" };
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "wasm emit").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }
    let src = tmpd + "/wasm_smoke_test.oo";
    let wasm = tmpd + "/wasm_smoke_test.wasm";
    if process_exec(p, "printf 'pub fn main() {\\n    println(\"hello wasm smoke\")\\n}\\n' > " + src).is_err() {
        println("FAIL write src");
        process_exit(1);
    }
    if process_exec(p, oodac + " emit-wasm " + src + " > " + wasm).is_err() {
        println("FAIL emit-wasm");
        process_exit(1);
    }
    if expect_present(fs, wasm).is_err() { println("FAIL no wasm"); process_exit(1); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        println("FAIL magic");
        process_exit(1);
    }
    if expect_quiet(p, "file " + wasm + " | grep -qi WebAssembly").is_err() {
        println("FAIL file");
        process_exit(1);
    }
    println("wasm_emit_smoke: PASSED");
}
