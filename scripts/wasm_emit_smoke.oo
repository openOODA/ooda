// # Wasm Emit Hands Back A Module
// Logline: emit-wasm produces a complete .wat with module / wasi / fd_write / memory / _start.
// Setup: oodac/oodac or bin/ooda built.
// Beats: 1. emit-wasm produces .wat | 2. module + wasi + fd_write + memory + _start | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let ooda  = sh_env_get_or(p, "OODA_BIN",   root + "/bin/ooda").unwrap_or("");
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "wasm emit");

    // when — emitter available + fixture present
    let _ = expect_quiet(p, "test -x " + oodac + " || test -x " + ooda);

    // and — emit-wasm produces .wat
    let src = tmpd + "/wasm_smoke_test.oo";
    let wat = tmpd + "/wasm_smoke_test.wat";
    let _   = process_exec(p, "printf 'pub fn main() {\\n    let msg: String = \"hello wasm smoke\"\\n    println(msg)\\n}\\n' > " + src);
    let _   = process_exec(p, "test -x " + ooda + " && " + ooda + " build --target wasm " + src + " -o " + wat + " || " + oodac + " emit-wasm " + src + " > " + wat);
    let _   = expect_present(fs, wat);

    // then — .wat is a complete module
    let _ = expect_quiet(p, "grep -q 'module' "                + wat);
    let _ = expect_quiet(p, "grep -q 'wasi_snapshot_preview1' " + wat);
    let _ = expect_quiet(p, "grep -q 'fd_write' "               + wat);
    let _ = expect_quiet(p, "grep -q 'memory' "                 + wat);
    let _ = expect_quiet(p, "grep -q '_start' "                 + wat);

    println("wasm_emit_smoke: PASSED");
}
