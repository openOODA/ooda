// # Alpha PM product floors
//
// Logline: Run product-floor umbrellas and the key partial-floor rails for a PM alpha pass.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Resolve ooda and oodac.
//   2. Export them for subprocess smokes.
//   3. Run each floor rail and fail the runner on any miss.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/core/str.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    let root = get_root(p);
    let ooda = get_env(p, "OODA", root + "/bin/ooda");
    let oodac = get_env(p, "OODAC_BIN", root + "/oodac/oodac");
    
    // Export for subprocesses
    let env_ooda = cmd_exec(p, "export OODA=\"" + ooda + "\"");
    let env_oodac = cmd_exec(p, "export OODAC_BIN=\"" + oodac + "\"");
    
    let scripts = [
        "caps_product_floor_smoke.sh",
        "cap_ffi_product_floor_smoke.sh",
        "residual_path_a_floor_smoke.sh",
        "time_entropy_product_floor_smoke.sh",
        "memory_quota_product_floor_smoke.sh",
        "max_cycles_product_floor_smoke.sh",
        "secret_product_floor_smoke.sh",
        "fuzz_product_floor_smoke.sh",
        "contracts_native_smoke.sh",
        "contracts_multi_clause_smoke.sh",
        "contracts_complex_residual_smoke.sh",
        "json_errors_smoke.sh",
        "ai_native_product_floor_smoke.sh",
        "hitl_product_floor_smoke.sh",
        "cap_ffi_runtime_smoke.sh",
        "ecap_autofix_smoke.sh",
        "secret_eprintln_smoke.sh",
        "contracts_and_smoke.sh",
        "contracts_arith_smoke.sh",
        "etc_autofix_smoke.sh",
        "ehitl_autofix_smoke.sh",
        "patch_smoke.sh",
        "ast_autofix_residual_smoke.sh",
        "arc_smoke.sh",
        "arc_temporal_tension_residual_smoke.sh",
        "pure_build_fp_smoke.sh",
        "llvm_prod_parity_smoke.sh",
        "llvm_execute_smoke.sh",
        "llvm_fail_closed_smoke.sh",
        "wasm_emit_smoke.sh",
        "wasm_execute_smoke.sh",
        "wasm_smoke_residual_smoke.sh",
        "ooda_speed_residual_smoke.sh",
        "ebnf_align_residual_smoke.sh",
        "residual_packs_index_smoke.sh",
        "residual_honesty_smoke.sh"
    ];
    
    let mut fail = false;
    
    for script in scripts {
        let script_path = root + "/scripts/" + script;
        let script_check = cmd_exec(p, "test -f " + script_path);
        
        if !script_check.is_ok() {
            println("SKIP missing " + script);
            continue;
        }
        
        // Run the script via bash
        let run_res = cmd_exec(p, "bash \"" + script_path + "\" >/tmp/alpha_pm_" + script + ".log 2>&1");
        if !run_res.is_ok() {
            tr = test_assert(tr, "FAIL " + script, false);
            fail = true;
        } else {
            tr = test_assert(tr, "=== " + script + " ===", true);
        }
    }
    
    test_summary(tr);
    
    if fail {
        process_exit(1);
    }
    
    println("alpha_pm_floors_smoke: PASSED");
}

fn get_root(p: &ProcessCap) -> String {
    let res = cmd_exec(p, "cd \"$(cd \"$(dirname \"$0\")/..\" && pwd)\" && pwd");
    if res.is_ok() {
        return trim(res.unwrap());
    }
    return ".";
}

fn get_env(p: &ProcessCap, key: String, default: String) -> String {
    let res = cmd_exec(p, "echo ${" + key + ":-" + default + "}");
    if res.is_ok() {
        let val = res.unwrap();
        let trimmed = trim(val);
        if str_len(trimmed) > 0 {
            return trimmed;
        }
    }
    return default;
}

fn cmd_exec(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn trim(s: String) -> String {
    let len = str_len(s);
    let mut start = -1;
    let mut end = -1;
    let mut i = 0;
    while i < len {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            start = i;
            break;
        }
        i = i + 1;
    }
    if start < 0 {
        return "";
    }
    i = len - 1;
    while i >= start {
        let c = str_char_at(s, i);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            end = i;
            break;
        }
        i = i - 1;
    }
    if end >= start {
        let result = str_sub(s, start, end + 1);
        return str_replace(result, "\r", "");
    }
    return "";
}
