// # Result[Int, Bool] emit is fail-closed
//
// Logline: emit-c refuses Result[Int, Bool] and still runs result_int_smoke.
//
// Setup: cwd is ooda/. Product oodac/oodac. gcc -O2 plus chs_rt is the run path.
//
// Beats:
//   1. emit-c of result_e_bool_fail.oo is ERR c_emit.
//   2. It does not emit a Bool-E typedef.
//   3. result_int_smoke still emit+gcc+run PASSED.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/result_e_bool";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/result_e_bool_fail.oo > " + tmpd + "/fail.c 2> " +
        tmpd + "/fail.err; true").is_err() {
        fail("emit fail");
    }
    if process_exec(p, "grep -qE '^ERR.c_emit' " + tmpd + "/fail.c " + tmpd +
        "/fail.err").is_err() {
        fail("not residual");
    }
    if process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac +
        " emit-c fixtures/result_int_smoke.oo > " + tmpd + "/ri.c && gcc -O2 -Iruntime runtime/chs_rt.c " +
        tmpd + "/ri.c -lm -ldl -lpthread -o " + tmpd + "/ri.bin && " + tmpd +
        "/ri.bin | grep -q 'result_int_smoke: PASSED'").is_err() {
        fail("result_int");
    }
    println("result_e_bool_fail_smoke: PASSED");
}
