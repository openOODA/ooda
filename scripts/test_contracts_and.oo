// # Contract && smoke
//
// Logline: Build and run the && requires/ensures fixtures and assert pass versus fail.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Build each contract fixture to a cache binary.
//   2. Run the pass case and expect success.
//   3. Run the fail rails and expect a nonzero exit.

import "std/test.oo";
import "std/os/process.oo";
import "std/result.oo";
import "std/str.oo";

// Helper to run oodac build and check if output binary is executable
fn build_run(p: &ProcessCap, src: String, bin: String) -> Bool {
    let cmd = "oodac/oodac build " + src + " " + bin + " >.ooda-cache/cand_b.out 2>.ooda-cache/cand_b.err";
    let res = process_exec(p, cmd);
    if res.is_ok() {
        let check = process_exec(p, "test -x " + bin);
        return check.is_ok();
    }
    return false;
}

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();
    
    // Ensure cache directory exists for build outputs
    let _ = process_exec(p, "mkdir -p .ooda-cache");

    // 1. pass: && requires/ensures
    if build_run(p, "fixtures/complex_contract_pass.oo", ".ooda-cache/cand_pass") {
        let run_res = process_exec(p, ".ooda-cache/cand_pass 2>&1");
        
        // Extract the output string whether Ok or Err
        let out_str = match run_res {
            Ok(v) => v,
            Err(e) => e,
        };
        
        if str_contains(out_str, "7") {
            tr = test_assert(tr, "&& contract pass runs (7)", true);
        } else {
            tr = test_assert(tr, "&& pass out=" + out_str, false);
        }
    } else {
        tr = test_assert(tr, "build complex_contract_pass", false);
    }
    
    // 2. fail requires
    if build_run(p, "fixtures/complex_contract_req_fail.oo", ".ooda-cache/cand_rfail") {
        let run_res = process_exec(p, ".ooda-cache/cand_rfail 2>&1");
        
        let out_str = match run_res {
            Ok(v) => v,
            Err(e) => e,
        };
        
        let rc_fail = run_res.is_err();
        let has_contract = str_contains(out_str, "contract");
        let has_requires = str_contains(out_str, "requires");
        
        if rc_fail && (has_contract || has_requires) {
            tr = test_assert(tr, "&& requires fail-closed", true);
        } else {
            tr = test_assert(tr, "req fail out=" + out_str, false);
        }
    } else {
        tr = test_assert(tr, "build complex_contract_req_fail", false);
    }
    
    // 3. multi-clause still green
    let mc_res = process_exec(p, "bash scripts/contracts_multi_clause_smoke.sh >.ooda-cache/cand_mc.log 2>&1");
    if mc_res.is_ok() {
        tr = test_assert(tr, "multi_clause still green", true);
    } else {
        tr = test_assert(tr, "multi_clause", false);
    }
    
    // Print the test suite summary
    test_summary(tr);
}
