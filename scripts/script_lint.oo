// # Script Lint
//
// Logline: Walk every ooda/scripts/*.oo and enforce academy-award title, logline, beats, line-count, and exec-call rules.
//
// Setup: Caller is the academy; each rule is a shell probe (wc, head, grep, awk).
//
// Beats:
//   1. Walk ooda/scripts/*.oo via fs_read_dir.
//   2. Probe each rule per file and buffer any violation.
//   3. Print summary; fail fast if any rule trips.

import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let mut fails: Int = 0;
    let mut total: Int = 0;
    let mut viols: List[String] = list_new();
    let files = fs_read_dir(fs, "ooda/scripts");
    let n = list_len(files);
    let mut i: Int = 0;
    while i < n {
        let f = list_get(files, i);
        let is_oo = str_ends_with(f, ".oo");
        if is_oo == false { i = i + 1; continue; }
        total = total + 1;
        let path = "ooda/scripts/" + f;
        let t = match process_exec(p, "head -1 '" + path + "' | grep -q '^// #' && echo ok") { Ok(s) => s, Err(_) => "" };
        if t != "ok" { viols = list_push(viols, "  - " + f + ": missing title block (line 1)"); fails = fails + 1; }
        let l = match process_exec(p, "head -10 '" + path + "' | grep -q 'Logline:' && echo ok") { Ok(s) => s, Err(_) => "" };
        if l != "ok" { viols = list_push(viols, "  - " + f + ": missing Logline: in first 10 lines"); fails = fails + 1; }
        let b = match process_exec(p, "head -15 '" + path + "' | grep -q 'Beats:' && echo ok") { Ok(s) => s, Err(_) => "" };
        if b != "ok" { viols = list_push(viols, "  - " + f + ": missing Beats: in first 15 lines"); fails = fails + 1; }
        let x = match process_exec(p, "awk '/^pub fn main/{m=1;next} m && /^}/{m=0;next} !m && /process_exec/{print \"bad\";exit}' '" + path + "'") { Ok(s) => s, Err(_) => "" };
        if x == "bad" { viols = list_push(viols, "  - " + f + ": process_exec outside main"); fails = fails + 1; }
        let lc = match process_exec(p, "wc -l <'" + path + "' | awk '{exit ($1>256)}'") { Ok(_) => "ok", Err(_) => "bad" };
        if lc == "bad" {
            let nstr = match process_exec(p, "wc -l <'" + path + "' | tr -d \" \\n\"") { Ok(s) => s, Err(_) => "?" };
            viols = list_push(viols, "  - " + f + ": line count " + nstr + " > 256");
            fails = fails + 1;
        }
        i = i + 1;
    }
    println("script_lint: checking " + total.to_string() + " scripts...");
    let pass = total - fails;
    println("script_lint: \u2713 " + pass.to_string() + " scripts pass");
    if fails > 0 {
        println("script_lint: \u2717 " + fails.to_string() + " scripts fail:");
        let m = list_len(viols);
        let mut j: Int = 0;
        while j < m {
            println(list_get(viols, j));
            j = j + 1;
        }
        process_exit(1);
    }
    println("script_lint: ALL OK");
}
