// # Math Trig Smoke
//
// Logline: M166 path A — sin/cos/ln/exp/sqrt/pow are wired through the runtime C and lowered from .oo source.
// Beats: doc+marker | runtime symbols | tc/c_emit wiring | runtime C sin/cos/sqrt guard.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/MATH_TRIG.oot";
const MARKER: String = "MATH_TRIG_PATH_A_ALPHA";
const RT_HDR: String = "ooda/runtime/chs_rt.h";
const RT_MATH: String = "ooda/runtime/chs_rt_math.c";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "math trig path A sin/cos/ln/exp/sqrt/pow");

    // when doc carries marker + path A free names + IEEE double
    expect_present(fs, DOC);
    expect_substring(fs, DOC, MARKER);
    expect_clean(p, "grep -qE 'sin\\(|cos\\(|ln\\(|exp\\(|sqrt\\(|pow\\(' " + DOC);
    expect_clean(p, "grep -qiE 'IEEE|double' " + DOC);

    // and runtime exports the per-op symbol table
    expect_clean(p, "grep -q 'oo_sin' " + RT_HDR);
    expect_clean(p, "grep -q 'oo_pow' " + RT_HDR);
    expect_clean(p, "grep -q 'oo_print_double' " + RT_HDR);
    expect_clean(p, "grep -q 'chs_rt_math.c' ooda/runtime/chs_rt.c");
    expect_clean(p, "grep -q 'oo_print_double' " + RT_MATH);

    // then runtime C harness proves sin/cos/sqrt/ln/exp/pow to 1e-12
    let tmp = root + "/.ooda-cache/ooda-tmp/math_trig_rt";
    let _ = sh_mkdir_p(p, root + "/.ooda-cache/ooda-tmp");
    let _ = process_exec(p, "cat > " + tmp + ".c <<'CEOF'\n#include \"chs_rt.h\"\n#include <math.h>\n#include <stdio.h>\nstatic int near(double a, double b, double eps) { double d = a - b; if (d < 0) d = -d; return d <= eps; }\nint main(void) { if (!near(oo_sin(0.0), 0.0, 1e-12)) return 1; if (!near(oo_cos(0.0), 1.0, 1e-12)) return 2; if (!near(oo_sqrt(4.0), 2.0, 1e-12)) return 3; if (!near(oo_ln(1.0), 0.0, 1e-12)) return 4; if (!near(oo_exp(0.0), 1.0, 1e-12)) return 5; if (!near(oo_pow(2.0, 3.0), 8.0, 1e-12)) return 6; oo_print_double(oo_cos(0.0)); oo_println(); printf(\"rt-ok\\n\"); return 0; }\nCEOF");
    check(p, "gcc -O0 -I " + root + "/ooda/runtime " + tmp + ".c " + root + "/ooda/runtime/chs_rt.c -lm -ldl -lpthread -o " + tmp, within: 30);
    expect_clean(p, tmp + " 2>&1 | grep -q 'rt-ok'");

    println("math_trig_smoke: PASSED");
}
