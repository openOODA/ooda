// # Refine leftover type errors print path and caret
//
// Logline: Cache-cold check of char_at / arg miss shows ERR type, path, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. Locked fixture prints the refine message, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo still has --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/refine_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_refine_char_at.oo > " + tmpd +
        "/ca.out; echo $? > " + tmpd + "/ca.ec; true").is_err() {
        fail("check char_at");
    }
    if process_exec(p, "grep -q 'char_at index out of bounds' " + tmpd +
        "/ca.out && grep -q 'tc_refine_char_at.oo' " + tmpd +
        "/ca.out && grep -Fq -- '-->' " + tmpd + "/ca.out && grep -q '\\^' " +
        tmpd + "/ca.out && ! grep -qE '^OK' " + tmpd +
        "/ca.out && test \"$(cat " + tmpd + "/ca.ec)\" -ne 0").is_err() {
        fail("no char_at caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_arg_type_miss.oo > " + tmpd +
        "/arg.out; echo $? > " + tmpd + "/arg.ec; true").is_err() {
        fail("check arg");
    }
    if process_exec(p, "grep -q \"argument 0 of 'f' expects Int but got String\" " +
        tmpd + "/arg.out && grep -q 'tc_arg_type_miss.oo' " + tmpd +
        "/arg.out && grep -Fq -- '-->' " + tmpd + "/arg.out && grep -q '\\^' " +
        tmpd + "/arg.out && ! grep -qE '^OK' " + tmpd +
        "/arg.out && test \"$(cat " + tmpd + "/arg.ec)\" -ne 0").is_err() {
        fail("no arg caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("refine_caret_smoke: PASSED");
}
