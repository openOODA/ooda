// # Emit Health Matrix
//
// Logline: per-module oodac emit-c STATUS matrix (OK/SEGV/TIMEOUT/EC<n>) with compact one-line entries.
//
// Setup: oodac/oodac built; EMIT_TIMEOUT (default 12s) per module; runs over oodac/*.oo sorted.
//
// Beats:
//   1. Validate OODAC_BIN; collect oodac/*.oo sorted.
//   2. Per module: emit-c with timeout; classify rc → OK|TIMEOUT|SEGV|EC<n>.
//   3. Verdict: SEGV/ERR → exit 1; TIMEOUT → exit 2; all OK → exit 0.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let to = sh_env_get_or(p, "EMIT_TIMEOUT", "12").unwrap_or("12");
    let err_base = sh_env_get_or(p, "TMPDIR", "/tmp").unwrap_or("/tmp") + "/ooda_emit_health";

    expect_quiet(p, "test -x " + oodac);
    let _ = scenario(p, fs, "emit health matrix");

    // when "OODAC_BIN resolvable + module list collected" {
    // and  "each module emits within EMIT_TIMEOUT" {
    // then "compact OK/SEGV/TIMEOUT/EC matrix" { }

    let mut n_ok = 0; let mut n_segv = 0; let mut n_to = 0; let mut n_err = 0; let mut bad = "";
    let mods_raw = match process_exec(p, "ls " + root + "/oodac/*.oo 2>/dev/null | sort") { Ok(s) => s, Err(_) => "" };
    let parts = str_split(mods_raw, "\n");
    let n = list_len(parts);
    let mut i = 0;
    while i < n {
        let f = list_get(parts, i);
        if str_is_empty(trim(f)) { i = i + 1; continue; }
        let base = strip_oo(match sh_basename(p, f) { Ok(s) => s, Err(_) => f });
        let out = err_base + "_" + base + ".c";
        let err = err_base + "_" + base + ".err";
        let emit = "timeout " + to + " env OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 "
                 + oodac + " emit-c " + f + " > " + out + " 2>" + err + "; echo $?";
        let raw = match process_exec(p, emit) { Ok(s) => s, Err(_) => "-1\n" };
        let ec = last_line(trim(raw));
        let lines = match process_exec(p, "wc -l < " + out + " 2>/dev/null | tr -d ' ' || echo 0") { Ok(s) => trim(s), Err(_) => "0" };
        let mut st = "EC" + ec;
        if ec == "0" { st = "OK"; n_ok = n_ok + 1; }
        else if ec == "124" { st = "TIMEOUT"; n_to = n_to + 1; }
        else if ec == "139" || ec == "134" { st = "SEGV"; n_segv = n_segv + 1; }
        else { n_err = n_err + 1; }
        if st != "OK" { if bad != "" { bad = bad + " "; } bad = bad + base + ":" + st; }
        println(st + " " + base + " lines=" + lines);
        let _ = sh_clean(fw, fs, out);
        i = i + 1;
    }
    let _ = sh_clean(fw, fs, err_base + "*.err");

    println("---");
    println("summary ok=" + n_ok.to_string() + " segv=" + n_segv.to_string()
        + " timeout=" + n_to.to_string() + " err=" + n_err.to_string() + " total=" + n.to_string());
    if bad != "" { println("bad " + bad); }
    if n_segv > 0 || n_err > 0 { process_exit(1); }
    if n_to > 0 { process_exit(2); }
}

fn strip_oo(s: String) -> String {
    if ends_with(s, ".oo") { return str_sub(s, 0, str_len(s) - 3); }
    return s;
}

fn last_line(s: String) -> String {
    let parts = str_split(s, "\n");
    let n = list_len(parts);
    if n == 0 { return ""; }
    return list_get(parts, n - 1);
}
