// # Metamorphic Path A Smoke
//
// Logline: Path-A metamorphic floor — bootstrap/METAMORPHIC.oot carries the marker + fail-closed wording, residual free-names still refuse at check, and emit-c of a path-a fixture lands __oo_meta_decoy_ with a 64-cap on 70 fns.
//
// Setup: Process capability and test fixtures available.
// Beats: doc + marker + fail-closed wording | source floor (parser + decoy + runtime epoch) | live emit path-a has decoys | no-marker twin has zero decoys | 64-cap on 70 fns.

import "std/scenario.oo";
import "std/sh.oo";


pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmp = root + "/.ooda-cache/ooda-tmp/metamorphic_path_a";
    let _ = sh_mkdir_p(fw, tmp);
    let _ = scenario(p, fs, "metamorphic path A: layout decoys + meta_epoch");

    // when: doc + marker + fail-closed wording + path-a directive + meta_epoch documented
    expect_present(fs, "ooda/bootstrap/METAMORPHIC.oot");
    expect_substring(fs, "ooda/bootstrap/METAMORPHIC.oot", "METAMORPHIC_RESIDUAL_ALPHA");
    expect_clean(p, "grep -qiE 'fail-closed residual|Fail-closed residual' " + root + "/" + "ooda/bootstrap/METAMORPHIC.oot");
    expect_clean(p, "grep -q 'METAMORPHIC: path-a' " + root + "/" + "ooda/bootstrap/METAMORPHIC.oot");
    expect_clean(p, "grep -q 'meta_epoch' " + root + "/" + "ooda/bootstrap/METAMORPHIC.oot");

    // and: residual free-names still refuse at check
    expect_present(fs, "ooda/fixtures/residual_metamorphic_fail.oo");
    let _ = process_exec(p, oodac + " check " + root + "/" + "ooda/fixtures/residual_metamorphic_fail.oo" + " > " + tmp + "/fail_check.out 2>&1");
    expect_clean(p, "grep -qiE 'residual|METAMORPHIC' " + tmp + "/fail_check.out");

    // then: source floor — emit parser + decoy wiring + runtime epoch + meta in umbrella
    expect_clean(p, "grep -q 'c_parse_metamorphic_path_a' " + root + "/oodac/c_emit_meta.oo");
    expect_clean(p, "grep -q 'c_emit_meta_decoy' " + root + "/oodac/c_emit.oo");
    expect_clean(p, "grep -q 'oo_meta_epoch' " + root + "/ooda/runtime/chs_rt_meta.c");
    expect_clean(p, "grep -q 'chs_rt_meta.c' " + root + "/ooda/runtime/chs_rt.c");
    check(p, "gcc -c -O2 -I" + root + "/ooda/runtime -Wall -Wextra -Werror " + root + "/ooda/runtime/chs_rt_meta.c -o " + tmp + "/chs_rt_meta.o", within: 30);

    // and: emit-c path-a produces __oo_meta_decoy_
    let _ = process_exec(p, oodac + " emit-c " + root + "/" + "ooda/fixtures/metamorphic_path_a.oo" + " > " + tmp + "/meta_pa.c 2> " + tmp + "/meta_pa.err");
    expect_clean(p, "grep -q '__oo_meta_decoy_' " + tmp + "/meta_pa.c");

    // and: no-marker twin has zero decoys
    let off = tmp + "/metamorphic_path_a_off.oo";
    let _ = process_exec(p, "cat > " + off + " <<'EOF'\npub fn helper_a() {\n    return 1;\n}\npub fn helper_b() {\n    return 2;\n}\npub fn main() {\n    let e = meta_epoch();\n    if e == 0 { process_exit(1); }\n    println(helper_a() + helper_b());\n}\nEOF");
    let _ = process_exec(p, oodac + " emit-c " + off + " > " + tmp + "/meta_off.c 2> " + tmp + "/meta_off.err");
    expect_clean(p, "! grep -q '__oo_meta_decoy_' " + tmp + "/meta_off.c");

    // then: 70-fns + main cap → exactly 64 decoy symbols
    let cap = tmp + "/metamorphic_path_a_cap70.oo";
    let _ = process_exec(p, "printf '// METAMORPHIC: path-a\\n' > " + cap);
    let mut i: Int = 0;
    while i < 70 {
        let _ = process_exec(p, "printf 'pub fn f" + i.to_string() + "() { }\\n' >> " + cap);
        i = i + 1;
    }
    let _ = process_exec(p, "printf 'pub fn main() { }\\n' >> " + cap);
    let _ = process_exec(p, oodac + " emit-c " + cap + " > " + tmp + "/meta_cap.c 2> " + tmp + "/meta_cap.err");
    let nd = match process_exec(p, "grep -c 'static void __oo_meta_decoy_' " + tmp + "/meta_cap.c || true") { Ok(s) => s, Err(_) => "0" };
    expect_clean(p, "test " + nd + " -eq 64");
    expect_clean(p, "! grep -nE '__oo_meta_buf\\[(1[7-9]|[2-9][0-9]|[0-9]{3,})\\]' " + tmp + "/meta_cap.c");

    // ci wire
    expect_clean(p, "grep -q 'metamorphic_path_a_smoke.sh' " + root + "/ooda/scripts/ci_product.sh || grep -q 'metamorphic_residual_smoke' " + root + "/ooda/scripts/ci_product.sh");

    println("metamorphic_path_a_smoke: PASSED");
}
