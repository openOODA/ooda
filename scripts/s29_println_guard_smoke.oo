// # S29 Println Guard Smoke
//
// Logline: 2.9 println guard — bare SECRET IDENT at println fails-closed, string literal with same spelling does not raise a false positive.
//
// Setup: Process capability and test fixtures available.
// Beats: ident refuses | string literal OK | grouped-later refuses | group+plus refuses | grouped public OK.

import "std/scenario.oo";
import "std/sh.oo";

const FIX: String = ".ooda-cache/ooda-tmp/s29_println_guard";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(p, root + "/" + FIX);
    let _ = scenario(p, fs, "S29 println guard");

    // when: ephemeral fixtures for each rail
    let _ = write_fix(p, root + "/" + FIX);

    // and: bare SECRET IDENT at println fail-closed (emit-c + check)
    for src in ["println_ident", "println_grouped_later", "println_groupplus"] {
        expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/" + src + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
        expect_clean(p, "!" + oodac + " check " + root + "/" + FIX + "/" + src + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    }

    // then: string literal + grouped public do not raise false positive
    for src in ["println_string_lit", "println_grouped_public"] {
        expect_clean(p, "!" + oodac + " emit-c " + root + "/" + FIX + "/" + src + ".oo +\" 2>&1 | grep -qE 'ERR\tsecret'");
    }

    println("s29_println_guard_smoke: PASSED");
}

fn write_fix(p: &ProcessCap, fix: String) {
    let _ = process_exec(p, "cat > " + fix + "/println_ident.oo <<'EOF'\n// 2.9 path-A: bare SECRET IDENT at println must refuse\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; println(tok); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/println_string_lit.oo <<'EOF'\n// 2.9 path-A: println(\"tok\") is a string literal, not IDENT\n// SECRET: tok\npub fn main() { println(\"tok\"); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/println_grouped_later.oo <<'EOF'\n// 2.9 path-A: println((1), tok) must refuse (not stop at first RPAREN)\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; println((1), tok); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/println_groupplus.oo <<'EOF'\n// 2.9 path-A: println((\"x\") + tok) must refuse\n// SECRET: tok\npub fn main() { let tok = \"s3cret\"; println((\"x\") + tok); }\nEOF");
    let _ = process_exec(p, "cat > " + fix + "/println_grouped_public.oo <<'EOF'\n// 2.9 path-A: println((1), 2) is public grouping\n// SECRET: tok\npub fn main() { println((1), 2); }\nEOF");
}
