// # User-sum match exhaust is fail-closed
//
// Logline: Check refuses a missing Flag/Color/Either arm and accepts a full Flag match.
//
// Setup: cwd is ooda/. Product oodac/oodac. Run check from a temp dir so cache cannot reprint OK.
//
// Beats:
//   1. sum_miss_arm needs Off. sum_miss_mid needs Yellow. sum_payload_miss needs B.
//   2. sum_all_arms prints OK.
//   3. No miss fixture prints OK.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/sum_exhaust";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/sum_miss_arm.oo > " + tmpd +
        "/miss.out; echo $? > " + tmpd + "/miss.ec").is_err() {
        fail("check miss");
    }
    if process_exec(p, "grep -q 'non-exhaustive match: Flag needs Off' " + tmpd +
        "/miss.out && ! grep -qE '^OK' " + tmpd + "/miss.out && test \"$(cat " +
        tmpd + "/miss.ec)\" -ne 0").is_err() {
        fail("miss Off");
    }
    if process_exec(p, oodac + " check fixtures/sum_miss_mid.oo > " + tmpd +
        "/mid.out; true").is_err() {
        fail("check mid");
    }
    if process_exec(p, "grep -q 'Color needs Yellow' " + tmpd +
        "/mid.out && ! grep -qE '^OK' " + tmpd + "/mid.out").is_err() {
        fail("miss Yellow");
    }
    if process_exec(p, oodac + " check fixtures/sum_payload_miss.oo > " + tmpd +
        "/pay.out; true").is_err() {
        fail("check pay");
    }
    if process_exec(p, "grep -q 'Either needs B' " + tmpd +
        "/pay.out && ! grep -q 'needs n' " + tmpd + "/pay.out && ! grep -qE '^OK' " +
        tmpd + "/pay.out").is_err() {
        fail("miss B");
    }
    if process_exec(p, oodac + " check fixtures/sum_all_arms.oo > " + tmpd +
        "/all.out; echo $? > " + tmpd + "/all.ec").is_err() {
        fail("check all");
    }
    if process_exec(p, "grep -qE '^OK' " + tmpd + "/all.out && test \"$(cat " +
        tmpd + "/all.ec)\" -eq 0").is_err() {
        fail("all arms");
    }
    println("sum_exhaust_smoke: PASSED");
}
