// # Contract arithmetic smoke
//
// Logline: Build arithmetic requires fixtures and check pass, require-fail, and ensure-fail rails.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Build contract_arith_pass and expect the printed values.
//   2. Build the require-fail fixture and expect a failed run.
//   3. Build the ensure-fail fixture and expect a failed run.

import "std/test.oo";
import "std/os/cmd.oo";
import "std/os/process.oo";
import "std/str.oo";

pub fn main(p: &ProcessCap) {
    let mut r: TestRunner = test_runner_new();
    let tmp = ".cache/ooda-tmp";
    
    // Setup tmp dir
    let _ = process_exec(p, "mkdir -p " + tmp);
    let oodac = "oodac/oodac";

    // test 1: pass: x + 1 > 0 and (a>0||b>0)&&c>=0
    let b1 = process_exec(p, oodac + " build fixtures/contract_arith_pass.oo " + tmp + "/carith_pass > " + tmp + "/carith_b.out 2> " + tmp + "/carith_b.err");
    r = test_assert(r, "build contract_arith_pass", b1.is_ok());
    if b1.is_ok() {
        let r1 = process_exec(p, tmp + "/carith_pass 2>&1");
        let out1 = match r1 {
            Ok(x) => x,
            Err(y) => y
        };
        let ok1 = r1.is_ok() && str_contains(out1, "1") && str_contains(out1, "3");
        r = test_assert(r, "arith requires pass (shifted=1, any_pos=3)", ok1);
    }

    // test 2: fail: x + 1 > 0 with x=-1
    let b2 = process_exec(p, oodac + " build fixtures/contract_arith_req_fail.oo " + tmp + "/carith_rfail > " + tmp + "/carith_b.out 2> " + tmp + "/carith_b.err");
    r = test_assert(r, "build contract_arith_req_fail", b2.is_ok());
    if b2.is_ok() {
        let r2 = process_exec(p, tmp + "/carith_rfail 2>&1");
        let out2 = match r2 {
            Ok(x) => x,
            Err(y) => y
        };
        let ok2 = r2.is_err() && (str_contains(out2, "contract") || str_contains(out2, "requires"));
        r = test_assert(r, "arith requires fail-closed", ok2);
    }

    // test 3: fail: (a>0||b>0)&&c>=0 with c=-1
    let b3 = process_exec(p, oodac + " build fixtures/contract_arith_or_and_fail.oo " + tmp + "/carith_oafail > " + tmp + "/carith_b.out 2> " + tmp + "/carith_b.err");
    r = test_assert(r, "build contract_arith_or_and_fail", b3.is_ok());
    if b3.is_ok() {
        let r3 = process_exec(p, tmp + "/carith_oafail 2>&1");
        let out3 = match r3 {
            Ok(x) => x,
            Err(y) => y
        };
        let ok3 = r3.is_err() && (str_contains(out3, "contract") || str_contains(out3, "requires"));
        r = test_assert(r, "||+&& requires fail-closed", ok3);
    }

    // Residual truth is openOODA/SHIPPED.oot and ROADMAP.oot.

    // Print summary
    test_summary(r);
    
    // Exit with status 1 if any tests failed
    if r.failed > 0 {
        process_exit(1);
    }
}
