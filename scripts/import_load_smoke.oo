// # Import Load Smoke
//
// Logline: import load honesty rails — in-tree multi-file check pass; digit-0 module name without false NUL reject; missing + cycle fail-closed across oodac check, oodac_concat, and pure_build.
// Setup: oodac/oodac prebuilt; bootstrap/corpus/import/{pass,fail}/...; scripts/oodac_concat.sh + oodac_pure_build.sh.
//
// Beats: multi_ok pass | multi_digit0 pass + no false NUL | missing fail-closed (check + concat + pure_build) | cycle fail-closed (check + concat + pure_build).

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "import load honesty rails");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/bootstrap/corpus/import/pass/multi_ok.oo");
    expect_present(fs, root + "/bootstrap/corpus/import/pass/multi_digit0.oo");
    expect_present(fs, root + "/bootstrap/corpus/import/fail/missing.oo");
    expect_present(fs, root + "/bootstrap/corpus/import/fail/cycle_a.oo");

    // when "in-tree multi-file check passes (multi_ok, multi_digit0)" {
    // and  "digit-0 module name is not falsely NUL-rejected" {
    // and  "missing import fail-closed across check + concat + pure_build" {
    // and  "import cycle fail-closed across check + concat + pure_build" {
    // then "import load smoke green" {

    check(p, oodac + " check " + root + "/bootstrap/corpus/import/pass/multi_ok.oo > " + tmpd + "/imp_ok.out 2> " + tmpd + "/imp_ok.err", within: 30);
    expect_clean(p, "grep -q '^OK' " + tmpd + "/imp_ok.out");

    check(p, oodac + " check " + root + "/bootstrap/corpus/import/pass/multi_digit0.oo > " + tmpd + "/imp_d0.out 2> " + tmpd + "/imp_d0.err", within: 30);
    expect_clean(p, "grep -q '^OK' " + tmpd + "/imp_d0.out");
    expect_clean(p, "! grep -q 'NUL' " + tmpd + "/imp_d0.out " + tmpd + "/imp_d0.err");

    expect_clean(p, "!" + oodac + " check " + root + "/bootstrap/corpus/import/fail/missing.oo > " + tmpd + "/imp_miss.out 2> " + tmpd + "/imp_miss.err");
    expect_clean(p, "! " + oodac + " check " + root + "/bootstrap/corpus/import/fail/cycle_a.oo > " + tmpd + "/imp_cyc.out 2> " + tmpd + "/imp_cyc.err");
    expect_clean(p, "cat " + tmpd + "/imp_miss.out " + tmpd + "/imp_miss.err " + tmpd + "/imp_cyc.out " + tmpd + "/imp_cyc.err | grep -qiE 'ERR[[:space:]]+import|ERR_IMPORT_MISSING|ERR_IMPORT_CYCLE|missing|cycle'");

    expect_clean(p, "! sh " + root + "/scripts/oodac_concat.sh " + root + "/bootstrap/corpus/import/fail/missing.oo > " + tmpd + "/cat_miss.out 2> " + tmpd + "/cat_miss.err");
    expect_clean(p, "grep -qE 'ERR_IMPORT_MISSING|missing' " + tmpd + "/cat_miss.err");
    expect_clean(p, "! sh " + root + "/scripts/oodac_concat.sh " + root + "/bootstrap/corpus/import/fail/cycle_a.oo > " + tmpd + "/cat_cyc.out 2> " + tmpd + "/cat_cyc.err");
    expect_clean(p, "grep -qE 'ERR_IMPORT_CYCLE|cycle' " + tmpd + "/cat_cyc.err");

    expect_clean(p, "! OODAC_BIN=" + oodac + " sh " + root + "/scripts/oodac_pure_build.sh " + root + "/bootstrap/corpus/import/fail/missing.oo " + tmpd + "/imp_miss.bin > " + tmpd + "/pb_miss.out 2> " + tmpd + "/pb_miss.err");
    expect_clean(p, "grep -qE 'ERR_MISSING|ERR_IMPORT' " + tmpd + "/pb_miss.err " + tmpd + "/pb_miss.out");
    expect_clean(p, "! OODAC_BIN=" + oodac + " sh " + root + "/scripts/oodac_pure_build.sh " + root + "/bootstrap/corpus/import/fail/cycle_a.oo " + tmpd + "/imp_cyc.bin > " + tmpd + "/pb_cyc.out 2> " + tmpd + "/pb_cyc.err");
    expect_clean(p, "grep -qE 'ERR_IMPORT_CYCLE|cycle' " + tmpd + "/pb_cyc.err " + tmpd + "/pb_cyc.out");

    println("import_load_smoke: PASSED");
}