import "std/os/process.oo";
import "std/os/cmd.oo";
import "std/test.oo";

pub fn main(p: &ProcessCap) {
    let mut tr: TestRunner = test_runner_new();

    let mut cmd1: List[String] = cmd_new("bash");
    cmd1 = cmd_arg(cmd1, "scripts/alloc_cap_smoke.sh");
    let res1: Result[String, String] = cmd_execute(cmd1, p);
    tr = test_assert(tr, "alloc_cap_smoke.sh", res1.is_ok());

    let mut cmd2: List[String] = cmd_new("bash");
    cmd2 = cmd_arg(cmd2, "scripts/list_quota_smoke.sh");
    let res2: Result[String, String] = cmd_execute(cmd2, p);
    tr = test_assert(tr, "list_quota_smoke.sh", res2.is_ok());

    let mut cmd3: List[String] = cmd_new("bash");
    cmd3 = cmd_arg(cmd3, "scripts/malloc_path_a_smoke.sh");
    let res3: Result[String, String] = cmd_execute(cmd3, p);
    tr = test_assert(tr, "malloc_path_a_smoke.sh", res3.is_ok());

    test_summary(tr);

    if tr.failed > 0 {
        process_exit(1);
    }
}
