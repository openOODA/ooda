// # While-body type error prints path and caret
//
// Logline: Cache-cold check of while { 1 } shows ERR type, path, the while line, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_while_void.oo prints ERR type, while loop body must return Void, --> path, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo and tc_println_arity.oo still have --> and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/while_void_caret";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_while_void.oo > " + tmpd +
        "/w.out; echo $? > " + tmpd + "/w.ec; true").is_err() {
        fail("check while");
    }
    if process_exec(p, "grep -q 'while loop body must return Void' " + tmpd +
        "/w.out && grep -q 'tc_while_void.oo' " + tmpd +
        "/w.out && grep -Fq -- '-->' " + tmpd + "/w.out && grep -q '\\^' " +
        tmpd + "/w.out && ! grep -qE '^OK' " + tmpd +
        "/w.out && test \"$(cat " + tmpd + "/w.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q '\\^' " +
        tmpd + "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_println_arity.oo > " + tmpd +
        "/pr.out; echo $? > " + tmpd + "/pr.ec; true").is_err() {
        fail("check println");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/pr.out && grep -q '\\^' " +
        tmpd + "/pr.out && test \"$(cat " + tmpd + "/pr.ec)\" -ne 0").is_err() {
        fail("println caret");
    }
    println("while_void_caret_smoke: PASSED");
}
