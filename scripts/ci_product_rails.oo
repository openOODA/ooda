// # CI Product Rail Roster
//
// Logline: Name every local product rail from ci_product.sh and run each after an arg gate.
//
// Setup: Callers pass &ProcessCap, product root, and a temp dir. Caps are injected.
//
// Beats:
//   1. Build the 132 rail names as a list.
//   2. Gate each path with sh_arg_ok.
//   3. Fail-count missing or nonzero rails.
//
// residual: rails still execute the .sh files; this file is the roster + runner

import "std/sh.oo";
import "std/scenario.oo";

