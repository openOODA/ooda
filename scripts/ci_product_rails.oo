pub fn ci_run_product_rails(p: &ProcessCap, root: String, tmpd: String) -> Int {
    if !sh_arg_ok(root) {
        println("FAIL rails root unsafe");
        return 1;
    }
    if !sh_arg_ok(tmpd) {
        println("FAIL rails tmpd unsafe");
        return 1;
    }
    let names: List[String] = ci_rail_names();
    let n: Int = list_len(names);
    let mut fails: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let rail: String = list_get(names, i);
        let path: String = root + "/scripts/" + rail;
        if !sh_arg_ok(path) {
            println("FAIL rail unsafe " + rail);
            fails = fails + 1;
        } else {
            if expect_quiet(p, "test -f " + path).is_err() {
                println("FAIL missing rail " + rail);
                fails = fails + 1;
            } else {
                let _ = expect_quiet(p, "chmod +x " + path);
                let outp: String = tmpd + "/ci_" + rail + ".out";
                let errp: String = tmpd + "/ci_" + rail + ".err";
                if !sh_arg_ok(outp) || !sh_arg_ok(errp) {
                    println("FAIL rail log unsafe " + rail);
                    fails = fails + 1;
                } else {
                    let run: String = path + " >" + outp + " 2>" + errp;
                    if process_exec(p, run).is_err() {
                        println("FAIL " + rail);
                        fails = fails + 1;
                    } else {
                        println("OK " + rail);
                    }
                }
            }
        }
        i = i + 1;
    }
    return fails;
}
