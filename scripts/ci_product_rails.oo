// # CI Product Rail Roster
//
// Logline: Name every local product rail as a sibling .oo and oodac check each after an arg gate.
//
// Setup: Callers pass &ProcessCap, product root, and a temp dir. Caps are injected.
//
// Beats:
//   1. Build the product rail names as a list.
//   2. Gate each path with sh_arg_ok.
//   3. oodac check each .oo; fail-count missing or nonzero.
//
// residual: .sh files will be deleted; rails are .oo checks

import "std/sh.oo";
import "std/scenario.oo";

