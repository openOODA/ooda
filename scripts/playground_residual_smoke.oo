// # Playground Residual Smoke
//
// Logline: bootstrap/PLAYGROUND.oot carries the residual marker, fail-closed wording, and non-claims; the fixture wires it via ci_product.
// Beats: doc + marker | fail-closed | non-claims | fixture | ci wire.

import "std/scenario.oo";
import "std/sh.oo";

const DOC: String = "ooda/bootstrap/PLAYGROUND.oot";
const MARKER: String = "PLAYGROUND_RESIDUAL_ALPHA";
const FIX: String = "ooda/fixtures/playground_marker.oo";
const FIXLINE: String = "PLAYGROUND: residual";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let _ = scenario(p, fs, "playground residual honesty");

    // when: doc + marker + fail-closed + non-claims
    expect_present(fs, DOC);
    expect_substring(fs, DOC, MARKER);
    expect_clean(p, "grep -qiE 'fail-closed residual' " + DOC);
    expect_clean(p, "grep -qiE 'do \\*\\*not\\*\\* claim|not claim' " + DOC);

    // then: fixture marker line
    expect_present(fs, FIX);
    expect_substring(fs, FIX, FIXLINE);

    // and: ci_product wires this script
    expect_substring(fs, root + "/ooda/scripts/ci_product.sh", "playground_residual_smoke");
    println("playground_residual_smoke: PASSED");
}
