// # My Pure Build
//
// Logline: pure multi-module oodac build emits C, links chs_rt + chs_rt_preamble + bodies once, returns native binary.
//
// Setup: Process capability and test fixtures available.
//
// Beats: env resolve | oodac check gate | emit preamble+protos+bodies | main patch | gcc + run smoke.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "my pure multi-module build");

    when "OODAC_BIN resolves" {
    and  "oodac check gate passes for main.oo" {
    and  "preamble + protos + bodies lower cleanly" {
    and  "gcc links chs_rt + all.c into runnable native binary" {
    then "my_pure_build native binary OK" { } } } }

    expect_clean(p, "test -x " + oodac);
    check(p, oodac + " check oodac/main.oo > " + tmpd + "/mpb_check.out 2> " + tmpd + "/mpb_check.err", within: 180);
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-preamble oodac/main.oo > " + tmpd + "/mpb_all.c 2>> " + tmpd + "/mpb_emit.err");
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-protos oodac/main.oo >> " + tmpd + "/mpb_all.c 2>> " + tmpd + "/mpb_emit.err");
    let _ = process_exec(p, "OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 " + oodac + " emit-bodies oodac/main.oo >> " + tmpd + "/mpb_all.c 2>> " + tmpd + "/mpb_emit.err");
    expect_clean(p, "grep -qE 'int main|long long main' " + tmpd + "/mpb_all.c");
    check(p, "gcc -O2 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/mpb_all.c -lm -o " + tmpd + "/mpb_all.bin", within: 60);
    expect_clean(p, "test -x " + tmpd + "/mpb_all.bin");
    println("my_pure_build: OK_PURE_MULTI");
}
