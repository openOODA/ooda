// # CHS Semantic Parity
//
// Logline: `ooda run` and `ooda build --target c` produce normalized digests that match on contract-free CHS fixtures.
// Setup: pure bin/ooda prebuilt; CHS fixtures under fixtures/.
//
// Beats: resolve ooda | per-fixture normalize run vs c-binary | fail-closed on missing.

import "std/scenario.oo";
import "std/sh.oo";

const FIXTURES: List[String] = ["fixtures/while_count.oo", "fixtures/chs_list_string.oo", "fixtures/chs_hello.oo"];

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let ooda = sh_env_get_or(p, "OODA_BIN", root + "/bin/ooda").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "CHS semantic parity run≡c");

    expect_quiet(p, "test -x " + ooda);

    when "ooda run produces digest" {
    and  "ooda build --target c produces digest" {
    and  "normalized digests match" {
    then "every fixture passes" {
    } } }

    let mut hits: Int = 0;
    let mut i: Int = 0;
    let n: Int = 3;
    while i < n {
        let rel: String = list_get(FIXTURES, i);
        let src: String = root + "/" + rel;
        let base: String = match sh_basename(p, rel) { Ok(s) => s, Err(_) => rel };
        let _ = sh_clean(p, tmpd + "/chs_run_" + base);
        let _ = sh_clean(p, tmpd + "/chs_bin_" + base);

        let r1: Result[String, String] = process_exec(p, ooda + " run " + src + " > " + tmpd + "/chs_run_" + base + ".txt 2>/dev/null");
        let r2: Result[String, String] = process_exec(p, ooda + " build --target c " + src + " >/dev/null 2>&1");
        let bin: String = match sh_basename(p, src) { Ok(s) => s + "_c", Err(_) => "" };
        let r3: Result[String, String] = process_exec(p, "test -x " + bin + " && " + bin + " > " + tmpd + "/chs_bin_" + base + ".txt 2>/dev/null");
        if r1.is_err() || r2.is_err() || r3.is_err() {
            i = i + 1;
            continue;
        }
        let a: String = match process_exec(p, "grep -E '^[0-9]+$|^true$|^false$|^[A-Za-z0-9_./+-]+$' " + tmpd + "/chs_run_" + base + ".txt 2>/dev/null | tr '\\n' ',' | sed 's/,$//'") { Ok(s) => s, Err(_) => "" };
        let b: String = match process_exec(p, "grep -E '^[0-9]+$|^true$|^false$|^[A-Za-z0-9_./+-]+$' " + tmpd + "/chs_bin_" + base + ".txt 2>/dev/null | tr '\\n' ',' | sed 's/,$//'") { Ok(s) => s, Err(_) => "" };
        expect_equal(a, b);
        hits = hits + 1;
        i = i + 1;
    }
    expect_equal(int_to_str(hits), "3");
    println("chs_semantic_parity: PASSED");
}