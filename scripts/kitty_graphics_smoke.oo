// # Dedicated Kitty Graphics Protocol Smoke Test
//
// Logline: End-to-end verification of Kitty terminal graphics encoder, GPU VRAM caching, chunked streaming, and half-block fallback.
//
// Setup: Validates openOODA std/tui/kitty_graphics capabilities on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify KittyImage and KittyPlacement construction and direct display command emission.
//   2. Verify GPU VRAM image caching (a=t) and cached image placement (a=p).
//   3. Verify chunked payload streaming for large base64 data (m=1/m=0 chunk markers).
//   4. Verify terminal capability detection and 24-bit TrueColor Unicode half-block fallback rasterization.

import "std/tui/kitty_graphics.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA TUI Kitty Graphics Protocol Integration Smoke");
    println("===================================================================");

    // 1. Direct Display Command Emission
    let img_direct: KittyImage = kitty_image_new_rgba(1, 64, 64, "iVBORw0KGgoAAAANSUhEUg==");
    let place_direct: KittyPlacement = kitty_placement_new(1, 0, 0, 10, 5);
    let direct_cmd: String = kitty_encode_transmit_and_display(img_direct, place_direct);

    if !str_contains(direct_cmd, "\x1b_Ga=T,f=32,s=64,v=64,c=10,r=5;iVBORw0KGgoAAAANSUhEUg==\x1b\\") {
        println("FAIL: Kitty direct display encoding mismatch");
        process_exit(1);
    }
    println("  [PASS] 1. Direct High-Resolution Transmission & Display Encoding");

    // 2. GPU VRAM Caching & Eviction Commands
    let img_cache: KittyImage = kitty_image_new_rgb(42, 128, 128, "AQIDBAUGBwgJCgsMDQ4PEA==");
    let cache_cmd: String = kitty_encode_transmit_cache(img_cache);
    let place_cached: KittyPlacement = kitty_placement_new(42, 5, 2, 20, 10);
    let disp_cached_cmd: String = kitty_encode_display_cached(place_cached);
    let del_cmd: String = kitty_encode_delete_image(42);
    let del_all_cmd: String = kitty_encode_delete_all();

    if !str_contains(cache_cmd, "a=t,i=42,f=24,s=128,v=128") || !str_contains(disp_cached_cmd, "a=p,i=42,c=20,r=10") {
        println("FAIL: Kitty GPU VRAM caching commands mismatch");
        process_exit(1);
    }
    if !str_contains(del_cmd, "a=d,d=i,i=42") || !str_contains(del_all_cmd, "a=d,d=a") {
        println("FAIL: Kitty cache eviction commands mismatch");
        process_exit(1);
    }
    println("  [PASS] 2. GPU VRAM Image Caching (a=t), Placement (a=p), and Eviction (a=d)");

    // 3. Chunked Streaming (>4096 bytes)
    let mut large_payload: String = "";
    let mut k: Int = 0;
    while k < 500 {
        large_payload = large_payload + "ABCDEFGH";
        k = k + 1;
    } // 4000 chars

    let img_chunked: KittyImage = kitty_image_new_png(99, large_payload);
    let chunks: List[String] = kitty_encode_chunked_stream(img_chunked, 1000);
    let n_chunks: Int = list_len(chunks);

    if n_chunks != 4 {
        println("FAIL: Kitty chunked stream slicing mismatch: expected 4 chunks");
        process_exit(1);
    }

    let chunk0: String = list_get(chunks, 0);
    let chunk3: String = list_get(chunks, 3);
    if !str_contains(chunk0, "m=1") || !str_contains(chunk3, "m=0") {
        println("FAIL: Kitty chunked stream markers mismatch (m=1/m=0)");
        process_exit(1);
    }
    println("  [PASS] 3. 4KB Chunked Payload Streaming with Continuation Markers");

    // 4. Terminal Detection & Half-Block Fallback
    let is_kitty: Bool = kitty_detect_support("xterm-kitty", "", "1");
    let is_ghostty: Bool = kitty_detect_support("xterm-256color", "Ghostty", "");
    let is_plain: Bool = kitty_detect_support("dumb", "", "");

    if !is_kitty || !is_ghostty || is_plain {
        println("FAIL: Kitty terminal capability detection mismatch");
        process_exit(1);
    }

    let mut pixels: List[PixelRgb] = list_new();
    let p_red: PixelRgb = PixelRgb { r: 255, g: 0, b: 0 };
    let p_blue: PixelRgb = PixelRgb { r: 0, g: 0, b: 255 };
    pixels = list_push(pixels, p_red);
    pixels = list_push(pixels, p_blue);

    let fallback_art: String = kitty_render_halfblock_fallback(pixels, 1, 2);
    if !str_contains(fallback_art, "▀") || !str_contains(fallback_art, "38;2;255;0;0") || !str_contains(fallback_art, "48;2;0;0;255") {
        println("FAIL: Unicode half-block fallback rasterization mismatch");
        process_exit(1);
    }
    println("  [PASS] 4. Terminal Capability Detection & TrueColor Half-Block Fallback (▀/▄)");

    println("kitty_graphics_smoke: PASSED");
}
