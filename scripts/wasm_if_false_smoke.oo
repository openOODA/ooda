// # emit-wasm if-false else println lock
//
// Logline: Product emit-wasm of wasm_if_false.oo prints else-yes and does not print then-no.
//
// Setup: cwd is ooda/. Drive ./oodac/oodac only. Do not use oodac.wasm4. wasmtime is required.
//
// Beats:
//   1. emit-wasm fixtures/wasm_if_false.oo and require \0asm magic.
//   2. The file is not WAT.
//   3. wasmtime stdout contains else-yes and does not contain then-no.

import "std/scenario.oo";
import "std/sh.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if scenario(p, fs, "wasm if false else").is_err() { fail("scenario"); }
    if expect_quiet(p, "test -x " + oodac).is_err() { fail("no oodac"); }
    if expect_present(fs, "fixtures/wasm_if_false.oo").is_err() { fail("no fixture"); }
    let wasm = tmpd + "/wasm_if_false.wasm";
    let out = tmpd + "/wasm_if_false.out";
    if process_exec(p, oodac + " emit-wasm fixtures/wasm_if_false.oo > " + wasm + " 2>" + tmpd + "/wasm_if_false.err").is_err() {
        fail("emit-wasm");
    }
    if expect_present(fs, wasm).is_err() { fail("no wasm"); }
    if check(p, "test -s " + wasm, 5).is_err() { fail("empty"); }
    if expect_quiet(p, "od -An -tx1 -N8 " + wasm + " | tr -d ' \\n' | grep -q 0061736d01000000").is_err() {
        fail("magic");
    }
    if expect_quiet(p, "! grep -q '(module' " + wasm).is_err() { fail("still wat"); }
    let home_wt = "/home/jeryd/.wasmtime/bin/wasmtime";
    if expect_quiet(p, "test -x " + home_wt).is_ok() {
        if check(p, home_wt + " " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q else-yes " + out).is_err() { fail("no else-yes"); }
        if expect_quiet(p, "! grep -q then-no " + out).is_err() { fail("then-no"); }
    } else if sh_which(p, "wasmtime").is_ok() {
        if check(p, "wasmtime " + wasm + " > " + out, 15).is_err() { fail("wasmtime"); }
        if expect_quiet(p, "grep -q else-yes " + out).is_err() { fail("no else-yes"); }
        if expect_quiet(p, "! grep -q then-no " + out).is_err() { fail("then-no"); }
    } else {
        fail("no wasmtime");
    }
    println("wasm_if_false_smoke: PASSED");
}
