// # GPU Path A Smoke
//
// Logline: M165 GPU Path A — noop Ok, cpu:add fallthrough, device launch residual Err; no CUDA/OpenCL/Vulkan device product; emit_ptx free-name refused.
// Setup: oodac/oodac prebuilt; gcc; runtime/chs_rt_libfloor.c with noop/cpu-fallthrough/device-residual strings.
//
// Beats: runtime honesty + no GPU dispatch | emit_ptx residual refuse | fixture checks + lowers oo_gpu_launch + runs noop/cpu/device residual | forge zero GpuCap deny.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "M165 GPU Path A noop/cpu-fallthrough/device-residual");

    expect_quiet(p, "test -x " + oodac);
    expect_present(fs, root + "/fixtures/gpu_path_a.oo");

    when "runtime honesty: noop + cpu fallthrough + device residual" {
    and  "no GPU device dispatch product (cudaLaunch / clEnqueue / vkCmdDispatch)" {
    and  "emit_ptx free-name is residual refuse" {
    and  "fixture checks + lowers oo_gpu_launch + runs noop/cpu/device" {
    and  "forge zero GpuCap deny" {
    then "gpu path A green" {
    } } } } }

    expect_substring(fs, root + "/runtime/chs_rt_libfloor.c", "gpu residual: no device shaders");
    expect_substring(fs, root + "/runtime/chs_rt_libfloor.c", "gpu-noop");
    expect_substring(fs, root + "/runtime/chs_rt_libfloor.c", "cpu fallthrough");
    expect_clean(p, "! grep -nE 'cudaLaunch|clEnqueue|vkCmdDispatch' " + root + "/runtime/chs_rt_libfloor.c");

    check(p, "printf 'pub fn main() { let r = emit_ptx(\"k\"); }\\n' > " + tmpd + "/gpu_ptx.oo", within: 5);
    expect_clean(p, "!" + oodac + " check " + tmpd + "/gpu_ptx.oo > " + tmpd + "/gpu_ptx.out 2> " + tmpd + "/gpu_ptx.err");
    expect_clean(p, "grep -qE 'ERR\\tresidual|Residual product refuse|emit_ptx' " + tmpd + "/gpu_ptx.out " + tmpd + "/gpu_ptx.err 2>/dev/null");

    check(p, oodac + " check " + root + "/fixtures/gpu_path_a.oo > " + tmpd + "/gpa_ck.out 2> " + tmpd + "/gpa_ck.err", within: 30);
    expect_clean(p, "grep -qE '^OK' " + tmpd + "/gpa_ck.out");

    check(p, oodac + " emit-c " + root + "/fixtures/gpu_path_a.oo > " + tmpd + "/gpa.c 2> " + tmpd + "/gpa.err", within: 30);
    expect_substring(fs, tmpd + "/gpa.c", "oo_gpu_launch(gpu");
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/gpa.c -o " + tmpd + "/gpa.bin -lm -ldl -lpthread 2> " + tmpd + "/gpa.gcc", within: 60);
    expect_quiet(p, "test -x " + tmpd + "/gpa.bin");
    let out: String = match process_exec(p, tmpd + "/gpa.bin 2>&1") { Ok(s) => s, Err(_) => "" };
    expect_clean(p, "echo \"" + out + "\" | grep -q 'noop-ok'");
    expect_clean(p, "echo \"" + out + "\" | grep -q 'cpu-ok'");
    expect_clean(p, "echo \"" + out + "\" | grep -q 'device-residual-ok'");

    check(p, "sed -E 's/long long gpu = oo_cap_grant_gpu\\(\\)/long long gpu = 0LL/' " + tmpd + "/gpa.c > " + tmpd + "/gpa_z.c", within: 5);
    check(p, "gcc -O0 -I" + root + "/runtime " + root + "/runtime/chs_rt.c " + tmpd + "/gpa_z.c -o " + tmpd + "/gpa_z.bin -lm -ldl -lpthread 2>/dev/null", within: 60);
    expect_clean(p, "!" + tmpd + "/gpa_z.bin 2>&1 | grep -qE 'noop-ok|cpu-ok|device-residual-ok'");

    println("gpu_path_a_smoke: PASSED");
}