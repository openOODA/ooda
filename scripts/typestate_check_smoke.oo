// job: prove type-state check on three fixtures
// host glue: this file must spawn oodac, which .oo cannot be

pub fn main(sys: &SysCap, fs: &FsReadCap) {
    let bin = "/tmp/oodac_ts";
    let okp = "fixtures/typestate_ok.oo";
    let bad = "fixtures/typestate_bad_order.oo";
    let br = "fixtures/typestate_if_blocked.oo";

    let r0 = sys_exec(sys, bin, "check", okp);
    if !r0.is_ok() {
        println("ERR\ttypestate_smoke\tok fixture failed check");
        process_exit(1);
    }

    let r1 = sys_exec(sys, bin, "check", bad);
    if r1.is_ok() {
        println("ERR\ttypestate_smoke\tbad_order should refuse");
        process_exit(1);
    }

    let r2 = sys_exec(sys, bin, "check", br);
    if r2.is_ok() {
        println("ERR\ttypestate_smoke\tif_blocked should refuse");
        process_exit(1);
    }

    println("typestate_check_smoke: ALL OK");
}
