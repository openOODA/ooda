// # Typestate Rails Hold Both Sides
// Logline: typestate_ok fixtures pass typecheck; typestate_*_bad fixtures are rejected.
// Setup: oodac/oodac built; fixtures/typestate_*.oo on disk.
// Beats: 1. ok fixtures exit 0 | 2. bad fixtures refuse | 3. wrap-up

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let root  = sh_realpath(p, ".").unwrap_or(".");
    let tmpd  = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let oodac = sh_env_get_or(p, "OODAC_BIN", root + "/oodac/oodac").unwrap_or("");
    let fix   = root + "/fixtures";
    let _     = sh_mkdir_p(p, tmpd);
    let _     = scenario(p, fs, "typestate rails");

    // when — every typestate_ok*.oo passes typecheck
    let _ = expect_present(fs, fix);
    let _ = process_exec(p, "ls -1 " + fix + "/typestate_ok*.oo " + fix + "/typestate_if_join_ok*.oo " + fix + "/typestate_while_ok*.oo " + fix + "/typestate_callee_*_ok*.oo " + fix + "/typestate_alias_*.oo " + fix + "/typestate_match_*_ok*.oo " + fix + "/typestate_end_ok*.oo " + fix + "/typestate_two_*.oo " + fix + "/typestate_method_*.oo " + fix + "/typestate_cross_*.oo " + fix + "/typestate_paren_call_ok*.oo > " + tmpd + "/ts_ok.lst 2>/dev/null || true");
    let _ = check(p, "for f in $(cat " + tmpd + "/ts_ok.lst); do " + oodac + " check \"$f\" >/dev/null 2>&1 || exit 1; done", 60);

    // and — every typestate_*_bad*.oo refuses
    let _ = process_exec(p, "ls -1 " + fix + "/typestate_*_bad*.oo " + fix + "/typestate_if_blocked.oo " + fix + "/typestate_field_arg.oo " + fix + "/typestate_match_blocked.oo " + fix + "/typestate_match_alias_root_bad.oo " + fix + "/typestate_callee_send_bad*.oo " + fix + "/typestate_file_open_as_sock_bad*.oo " + fix + "/typestate_fn_no_arrow.oo " + fix + "/typestate_return_send.oo > " + tmpd + "/ts_bad.lst 2>/dev/null || true");
    let _ = check(p, "for f in $(cat " + tmpd + "/ts_bad.lst); do " + oodac + " check \"$f\" >/dev/null 2>&1 && exit 1; done", 60);

    println("typestate_check_smoke: PASSED");
}
