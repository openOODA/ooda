// # OPEN-71 bit-identical gcc binaries
//
// Logline: emit-c and gcc fixtures/hello.oo twice with SOURCE_DATE_EPOCH=0, strip, and cmp.
//
// Setup: cwd is ooda/. oodac/oodac, runtime/chs_rt.c, and gcc exist.
//
// Beats:
//   1. Confirm gcc_repro_flags in cli_build.oo.
//   2. emit-c hello.oo twice; gcc each with repro flags.
//   3. strip both binaries and require cmp equal.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = match sh_realpath(p, ".") { Ok(s) => s, Err(_) => "." };
    let tmpd = match sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp") { Ok(s) => s, Err(_) => ".ooda-cache/ooda-tmp" };
    let oodac = root + "/oodac/oodac";
    if sh_mkdir_p(fw, tmpd).is_err() { println("FAIL mkdir"); process_exit(1); }
    if scenario(p, fs, "open71 bit-identical gcc").is_err() { println("FAIL scenario"); process_exit(1); }
    if expect_quiet(p, "test -x " + oodac).is_err() { println("FAIL no oodac"); process_exit(1); }
    if expect_clean(p, "grep -q gcc_repro_flags " + root + "/oodac/cli_build.oo").is_err() {
        println("FAIL no gcc_repro_flags");
        process_exit(1);
    }
    if expect_clean(p, "grep -q frandom-seed " + root + "/oodac/cli_build.oo").is_err() {
        println("FAIL no frandom-seed");
        process_exit(1);
    }

    let src = root + "/fixtures/hello.oo";
    let c1 = tmpd + "/open71_a.c";
    let c2 = tmpd + "/open71_b.c";
    let b1 = tmpd + "/open71_a.bin";
    let b2 = tmpd + "/open71_b.bin";
    if check(p, oodac + " emit-c " + src + " > " + c1 + " 2> " + tmpd + "/open71_a.err", 30).is_err() {
        println("FAIL emit a");
        process_exit(1);
    }
    if check(p, oodac + " emit-c " + src + " > " + c2 + " 2> " + tmpd + "/open71_b.err", 30).is_err() {
        println("FAIL emit b");
        process_exit(1);
    }
    if expect_clean(p, "cmp -s " + c1 + " " + c2).is_err() {
        println("FAIL emit-c not identical");
        process_exit(1);
    }

    // Must match oodac/cli_build.oo gcc_repro_flags() plus -O2 and -Iruntime.
    let gcc_repro_flags = "-frandom-seed=0 -Wl,--build-id=none";
    let flags = "-O2 " + gcc_repro_flags + " -I" + root + "/runtime ";
    let gcc1 = "SOURCE_DATE_EPOCH=0 gcc " + flags + root + "/runtime/chs_rt.c " + c1 + " -lm -ldl -lpthread -o " + b1;
    let gcc2 = "SOURCE_DATE_EPOCH=0 gcc " + flags + root + "/runtime/chs_rt.c " + c2 + " -lm -ldl -lpthread -o " + b2;
    if check(p, gcc1, 60).is_err() { println("FAIL gcc a"); process_exit(1); }
    if check(p, gcc2, 60).is_err() { println("FAIL gcc b"); process_exit(1); }
    if check(p, "strip " + b1 + " " + b2, 10).is_err() { println("FAIL strip"); process_exit(1); }
    if expect_clean(p, "cmp -s " + b1 + " " + b2).is_err() {
        println("FAIL binaries differ");
        process_exit(1);
    }
    println("open71_bit_identical: PASSED");
}
