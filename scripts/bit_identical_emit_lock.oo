// # Bit-identical emit lock
//
// Logline: Two emits of the same source are byte-identical for C, LLVM, and wasm.
//
// Setup: cwd is ooda/. Tree oodac exists. Extends OPEN-33 emit-c and OPEN-71 hello.
//
// Beats:
//   1. emit-c twice for hello, int_main, and open_ci_add; cmp equal.
//   2. emit-llvm twice for fixtures/hello.oo; cmp equal.
//   3. emit-wasm twice for fixtures/hello.oo; cmp equal and \0asm magic.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn emit_cmp(p: &ProcessCap, oodac: String, tmpd: String, src: String, backend: String, tag: String) {
    let a = tmpd + "/" + tag + "_a.out";
    let b = tmpd + "/" + tag + "_b.out";
    let ea = tmpd + "/" + tag + "_a.err";
    let eb = tmpd + "/" + tag + "_b.err";
    if process_exec(p, oodac + " " + backend + " " + src + " > " + a + " 2> " + ea).is_err() {
        fail("emit a " + tag);
    }
    if process_exec(p, oodac + " " + backend + " " + src + " > " + b + " 2> " + eb).is_err() {
        fail("emit b " + tag);
    }
    if process_exec(p, "grep -qE '^ERR' " + a + " " + ea).is_ok() {
        fail("ERR in a " + tag);
    }
    if process_exec(p, "cmp -s " + a + " " + b).is_err() {
        fail("not identical " + tag);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let tmpd = ".ooda-cache/ooda-tmp";
    let oodac = "./oodac/oodac";
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if !path_exists(fs, "oodac/oodac") { fail("no oodac"); }
    if !path_exists(fs, "fixtures/hello.oo") { fail("no hello"); }
    if !path_exists(fs, "fixtures/int_main.oo") { fail("no int_main"); }
    if !path_exists(fs, "fixtures/open_ci_add.oo") { fail("no open_ci_add"); }

    emit_cmp(p, oodac, tmpd, "fixtures/hello.oo", "emit-c", "bic_hello_c");
    emit_cmp(p, oodac, tmpd, "fixtures/int_main.oo", "emit-c", "bic_int_c");
    emit_cmp(p, oodac, tmpd, "fixtures/open_ci_add.oo", "emit-c", "bic_add_c");

    emit_cmp(p, oodac, tmpd, "fixtures/hello.oo", "emit-llvm", "bic_hello_ll");
    if process_exec(p, "grep -qE '@main|define ' " + tmpd + "/bic_hello_ll_a.out").is_err() {
        fail("llvm missing define");
    }

    emit_cmp(p, oodac, tmpd, "fixtures/hello.oo", "emit-wasm", "bic_hello_wasm");
    if process_exec(p, "od -An -tx1 -N4 " + tmpd + "/bic_hello_wasm_a.out | grep -q '00 61 73 6d'").is_err() {
        fail("wasm magic");
    }

    println("bit_identical_emit_lock: PASSED");
}
