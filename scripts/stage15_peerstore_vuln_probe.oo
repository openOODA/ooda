// # Stage 15 PeerStore State Loss Vulnerability & Remediation Probe
//
// Logline: Verifies state and score retention when SwarmPeer is stored in PeerStore and asserts banned peer rejection.
//
// Setup: Confirms that banned peer state is accurately preserved and connection is rejected.
//
// Beats:
//   1. Penalize peer reputation to BANNED state.
//   2. Add banned peer to SwarmNode peer store.
//   3. Assert that peer retains BANNED state and score in PeerStore.
//   4. Assert that swarm_connect_peer rejects connection to banned peer.
// RULES.oot 1.4: Pure empirical verification probe.
// RULES.oot 1.7: Strictly under 256 lines.

import "net/swarm_peer.oo";
import "net/swarm.oo";

pub fn main(net: &NetCap) {
    println("===================================================================");
    println(" Stage 15 Empirical Bug Probe: PeerStore State Loss & Banned Connect");
    println("===================================================================");

    let p_init: SwarmPeer = swarm_peer_new("QmAttackerNode", "192.168.1.100", 9000);
    let p_banned: SwarmPeer = swarm_peer_record_failure(p_init, 110);
    println("1. Directly checked peer state: " + p_banned.state + " (score: " + p_banned.score.to_string() + ")");

    let init_node: SwarmNode = swarm_node_create(net, "QmRootNode", 9000);
    let l_res: Result[SwarmNode, String] = swarm_node_listen(net, init_node);
    let mut node: SwarmNode = init_node;
    match l_res {
        Ok(n) => { node = n; },
        Err(e) => { process_exit(1); }
    }

    let node_with_peer: SwarmNode = swarm_add_peer(net, node, p_banned);
    let peer_from_store: SwarmPeer = peer_store_find(node_with_peer.peer_store, "QmAttackerNode");
    println("2. Peer retrieved from store state: " + peer_from_store.state + " (score: " + peer_from_store.score.to_string() + ")");

    if !(peer_from_store.state == "BANNED") || peer_from_store.score != -60 {
        println("FAIL: PeerStore discarded BANNED state or score");
        process_exit(1);
    }

    let conn_res: Result[SwarmNode, String] = swarm_connect_peer(net, node_with_peer, "QmAttackerNode");
    if conn_res.is_ok() {
        println("SECURITY FAILURE: swarm_connect_peer successfully connected to BANNED peer");
        process_exit(1);
    }
    println("Connection rejected");
    println("  [PASS] PeerStore BANNED state preserved and connection rejected");
    println("===================================================================");
}
