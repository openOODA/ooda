// # Seed Pure Multi Stays Cold And Honest
//
// Logline: Rebuild oodac from seed bootstrap to a side path and verify check functionality or residual honesty.
//
// Setup: Seed bootstrap binary or SEED_OODAC environment variable and build scripts exist on disk.
//
// Beats:
//   1. Locate seed compiler binary or skip execution when absent.
//   2. Rebuild oodac to an isolated side destination path using the pure build script.
//   3. Verify the generated binary checks pass fixtures or confirm documented residual marker.
import "std/scenario.oo";
import "std/sh.oo";

const RESIDUAL_DOC: String = "ooda/bootstrap/SEED_PURE_MULTI.oot";
const RESIDUAL_MARKER: String = "ACTIVE: RESIDUAL_SEED_PURE_MULTI";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root      = sh_realpath(p, ".").unwrap_or(".");
    let tmpd      = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let main_src  = root + "/oodac/main.oo";
    let pure      = root + "/scripts/oodac_pure_build.sh";
    let out_bin   = tmpd + "/oodac_from_seed";
    let residual  = root + "/" + RESIDUAL_DOC;
    let _         = sh_mkdir_p(fw, tmpd);
    let _         = scenario(p, fs, "seed pure multi");

    // when — resolve seed (SEED_OODAC env wins; repo path is fallback)
    let env_seed = sh_env_get_or(p, "SEED_OODAC", "").unwrap_or("");
    let seed     = "";
    if env_seed != "" {
        if expect_quiet(p, "test -x " + env_seed).is_ok() { seed = env_seed; }
    } else if expect_quiet(p, "test -x " + root + "/bootstrap/seed/oodac").is_ok() {
        seed = root + "/bootstrap/seed/oodac";
    }

    if seed == "" {
        println("seed_pure_multi_smoke: SKIP (no bootstrap/seed/oodac and no SEED_OODAC)");
        return;
    }

    let _ = expect_quiet(p, "test -f " + main_src);
    let _ = expect_quiet(p, "test -f " + pure);

    // then — cold rebuild to side path (never clobber oodac/oodac)
    let _ = process_exec(p, "cd " + root + " && env -u OODA OODAC_BIN='" + seed + "' bash " + pure + " " + main_src + " " + out_bin + " > " + tmpd + "/b.out 2> " + tmpd + "/b.err");
    let build_ok = expect_quiet(p, "test -x " + out_bin);

    // and — side binary must check a simple pass fixture
    let _ = process_exec(p, "timeout 30 " + out_bin + " check " + root + "/bootstrap/corpus/check/pass/ok_main.oo > " + tmpd + "/c.out 2> " + tmpd + "/c.err");
    let check_ok = expect_quiet(p, "grep -qE '^OK' " + tmpd + "/c.out");

    // residual honesty path — if build/check fails but doc carries marker, that's honest
    let residual_ok = expect_quiet(p, "test -f " + residual + " && grep -qE '^" + RESIDUAL_MARKER + "' " + residual);

    if build_ok.is_ok() && check_ok.is_ok() {
        println("seed_pure_multi_smoke: PASSED (seed=" + seed + " side=" + out_bin + ")");
        return;
    }
    if residual_ok.is_ok() {
        println("RESIDUAL_SEED_PURE_MULTI");
        println("seed_pure_multi_smoke: residual honesty (build_ok=" + build_ok.to_string() + " check_ok=" + check_ok.to_string() + ")");
        return;
    }
    println("seed_pure_multi: build_ok=" + build_ok.to_string() + " check_ok=" + check_ok.to_string() + " residual not documented");
}