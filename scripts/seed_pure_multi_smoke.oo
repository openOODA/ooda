// # Seed Pure Multi Stays Cold And Honest
//
// Logline: Seed bootstrap binary and oodac/main.oo stay on disk; do not exec deleted oodac_pure_build.sh.
//
// Setup: bootstrap/seed/oodac or SEED_OODAC, and oodac/main.oo on disk.
//
// Beats:
//   1. Locate seed compiler binary or skip when absent.
//   2. expect_present oodac/main.oo.
//   3. test -x seed when present.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap) {
    let root = sh_realpath(p, ".").unwrap_or(".");
    let tmpd = sh_env_get_or(p, "TMPDIR", ".ooda-cache/ooda-tmp").unwrap_or("");
    let main_src = root + "/oodac/main.oo";
    let repo_seed = root + "/bootstrap/seed/oodac";
    let _ = sh_mkdir_p(fw, tmpd);
    let _ = scenario(p, fs, "seed pure multi");

    // when seed resolves (SEED_OODAC env wins; repo path is fallback)
    let env_seed = sh_env_get_or(p, "SEED_OODAC", "").unwrap_or("");
    let seed = resolve_seed(p, env_seed, repo_seed);

    // and oodac/main.oo is present
    expect_present(fs, main_src);

    // then test -x seed, or honest skip
    if seed == "" {
        println("seed_pure_multi_smoke: SKIP (no bootstrap/seed/oodac and no SEED_OODAC)");
        return;
    }
    expect_present(fs, seed);
    expect_quiet(p, "test -x " + seed);
    println("seed_pure_multi_smoke: PASSED (seed=" + seed + ")");
}

fn resolve_seed(p: &ProcessCap, env_seed: String, repo_seed: String) -> String {
    if env_seed != "" {
        if expect_quiet(p, "test -x " + env_seed).is_ok() {
            return env_seed;
        }
    }
    if expect_quiet(p, "test -x " + repo_seed).is_ok() {
        return repo_seed;
    }
    return "";
}
