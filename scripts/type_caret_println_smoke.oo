// # println arity prints path and caret
//
// Logline: Cache-cold check of println() shows ERR type, path, the call line, and ^.
//
// Setup: cwd is ooda/. Product oodac/oodac.
//
// Beats:
//   1. tc_println_arity.oo prints ERR type, --> path, println, and ^.
//   2. Exit is non-zero and there is no OK.
//   3. tc_int_hi.oo still has -->, let x, and ^.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let oodac = "./oodac/oodac";
    let tmpd = ".ooda-cache/ooda-tmp/type_caret_println";
    if !path_exists(fs, oodac) { fail("no oodac"); }
    if process_exec(p, "mkdir -p " + tmpd).is_err() { fail("mkdir"); }
    if process_exec(p, oodac + " check fixtures/tc_println_arity.oo > " + tmpd +
        "/pr.out; echo $? > " + tmpd + "/pr.ec; true").is_err() {
        fail("check println");
    }
    if process_exec(p, "grep -q 'ERR.ttype' " + tmpd + "/pr.out || grep -q $'ERR\\ttype' " +
        tmpd + "/pr.out").is_err() {
        fail("no ERR type");
    }
    if process_exec(p, "grep -q 'tc_println_arity.oo' " + tmpd +
        "/pr.out && grep -Fq -- '-->' " + tmpd + "/pr.out && grep -q 'println' " +
        tmpd + "/pr.out && grep -q '\\^' " + tmpd +
        "/pr.out && ! grep -qE '^OK' " + tmpd +
        "/pr.out && test \"$(cat " + tmpd + "/pr.ec)\" -ne 0").is_err() {
        fail("no caret");
    }
    if process_exec(p, oodac + " check fixtures/tc_int_hi.oo > " + tmpd +
        "/hi.out; echo $? > " + tmpd + "/hi.ec; true").is_err() {
        fail("check hi");
    }
    if process_exec(p, "grep -Fq -- '-->' " + tmpd + "/hi.out && grep -q 'let x' " +
        tmpd + "/hi.out && grep -q '\\^' " + tmpd +
        "/hi.out && test \"$(cat " + tmpd + "/hi.ec)\" -ne 0").is_err() {
        fail("hi caret");
    }
    println("type_caret_println_smoke: PASSED");
}
