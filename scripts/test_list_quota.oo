// # List quota rails
//
// Logline: Build list-quota fixtures and run them under a tiny ambient budget.
//
// Setup: Process capability and test fixtures available.
//
// Beats:
//   1. Build the fail fixture with the ambient quota unset.
//   2. Run it under a tiny budget and expect failure.
//   3. Build and run the pass fixture.

import "std/os/process.oo";
import "std/os/cmd.oo";
import "std/test.oo";
import "std/str.oo";

pub fn main(p: &ProcessCap) {
    println("--- M125 list quota ---");
    let mut tr: TestRunner = test_runner_new();

    let ooda = "bin/ooda";
    let fail_src = "fixtures/list_quota_fail.oo";
    let pass_src = "fixtures/list_quota_pass.oo";
    
    let tmp = ".list_quota_tmp";
    let r_mkdir: Result[String, String] = process_exec(p, "mkdir -p " + tmp);

    // Fail case: build under default quota, run with tiny budget
    let t_bin1 = tmp + "/list_quota_fail.bin";
    let r_rm1: Result[String, String] = process_exec(p, "rm -f " + t_bin1);
    
    let mut cmd_b1: List[String] = cmd_new("env");
    cmd_b1 = cmd_arg(cmd_b1, "-u");
    cmd_b1 = cmd_arg(cmd_b1, "OO_LIST_AMBIENT_QUOTA");
    cmd_b1 = cmd_arg(cmd_b1, ooda);
    cmd_b1 = cmd_arg(cmd_b1, "build");
    cmd_b1 = cmd_arg(cmd_b1, fail_src);
    cmd_b1 = cmd_arg(cmd_b1, "-o");
    cmd_b1 = cmd_arg(cmd_b1, t_bin1);
    
    let r_b1: Result[String, String] = cmd_execute(cmd_b1, p);
    tr = test_assert(tr, "list_quota_fail.oo build", r_b1.is_ok());

    let mut cmd_r1: List[String] = cmd_new("env");
    cmd_r1 = cmd_arg(cmd_r1, "OO_LIST_AMBIENT_QUOTA=256");
    cmd_r1 = cmd_arg(cmd_r1, "timeout");
    cmd_r1 = cmd_arg(cmd_r1, "5");
    cmd_r1 = cmd_arg(cmd_r1, "./" + t_bin1);

    let r_r1: Result[String, String] = cmd_execute(cmd_r1, p);
    let out1 = match r_r1 {
        Ok(x) => x,
        Err(y) => y
    };
    
    let failed_as_expected = r_r1.is_err() && str_contains(out1, "ambient List memory quota exceeded");
    tr = test_assert(tr, "list_quota_fail.oo aborted with quota exceeded", failed_as_expected);

    // Pass case: run with tiny ambient + AllocCap raise inside program
    let t_bin2 = tmp + "/list_quota_pass.bin";
    let r_rm2: Result[String, String] = process_exec(p, "rm -f " + t_bin2);
    
    let mut cmd_b2: List[String] = cmd_new("env");
    cmd_b2 = cmd_arg(cmd_b2, "-u");
    cmd_b2 = cmd_arg(cmd_b2, "OO_LIST_AMBIENT_QUOTA");
    cmd_b2 = cmd_arg(cmd_b2, ooda);
    cmd_b2 = cmd_arg(cmd_b2, "build");
    cmd_b2 = cmd_arg(cmd_b2, pass_src);
    cmd_b2 = cmd_arg(cmd_b2, "-o");
    cmd_b2 = cmd_arg(cmd_b2, t_bin2);
    
    let r_b2: Result[String, String] = cmd_execute(cmd_b2, p);
    tr = test_assert(tr, "list_quota_pass.oo build", r_b2.is_ok());

    let mut cmd_r2: List[String] = cmd_new("env");
    cmd_r2 = cmd_arg(cmd_r2, "OO_LIST_AMBIENT_QUOTA=256");
    cmd_r2 = cmd_arg(cmd_r2, "timeout");
    cmd_r2 = cmd_arg(cmd_r2, "5");
    cmd_r2 = cmd_arg(cmd_r2, "./" + t_bin2);

    let r_r2: Result[String, String] = cmd_execute(cmd_r2, p);
    let out2 = match r_r2 {
        Ok(x) => x,
        Err(y) => y
    };
    
    let passed_as_expected = r_r2.is_ok() && str_contains(out2, "50");
    tr = test_assert(tr, "list_quota_pass.oo under raised ceiling", passed_as_expected);

    // Cleanup and summary
    let r_rm3: Result[String, String] = process_exec(p, "rm -rf " + tmp);

    test_summary(tr);
}
