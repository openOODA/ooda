# GitHub Linguist Language Recognition for openOODA (.oo)
*.oo linguist-detectable=true
*.oo linguist-language=Rust
*.oot linguist-documentation=true

# Mark C runtime glue, bootstrap seed, and caches as vendored/generated
runtime/** linguist-vendored=true
bootstrap/** linguist-vendored=true
*.c linguist-vendored=true
*.h linguist-vendored=true
.ooda-cache/** linguist-generated=true
fixtures/** linguist-documentation=true
