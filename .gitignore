# Hand-owned CHS runtime (umbrella + domain TUs). Keep exceptions explicit.
!runtime/chs_rt.c
!runtime/chs_rt_*.c
# Path-A immune / persist units (not chs_rt*.c — AGY owns those names).
!runtime/oo_hide.c
!runtime/oo_sha256.c
!runtime/oo_holo.c

