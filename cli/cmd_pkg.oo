// # Local package inventory
//
// Logline: Print ooda pkg: local and the .oo names in cwd.
//
// Setup: FsCap lists cwd. SysCap can list via ls. This is local, not a registry.
//
// Beats:
//   1. Print the local header.
//   2. Walk cwd for names ending in .oo.
//   3. Print each name and return.

import "host_run.oo";

fn pkg_is_oo(name: String) -> Bool {
    return str_ends_with(name, ".oo");
}

fn pkg_print_entries(entries: List[String]) -> Int {
    let n: Int = list_len(entries);
    let mut shown: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(entries, i);
        if pkg_is_oo(name) {
            println(name);
            shown = shown + 1;
        }
        i = i + 1;
    }
    return shown;
}

pub fn run_ooda_pkg(fs: &FsCap, sys: &SysCap, args: List[String]) {
    println("ooda pkg: local");
    let dir: String = ".";
    let entries: List[String] = oo_fs_read_dir(fs, dir);
    let shown: Int = pkg_print_entries(entries);
    if shown == 0 {
        if list_len(args) >= 0 {
            let outp: String = ".ooda-cache/ooda-tmp/pkg-list.txt";
            let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; ls -1 " + sq(dir) + " > " + sq(outp) + " 2>/dev/null; exit 0";
            let ign: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
            if ign.is_ok() {
                let ro: Result[String, String] = read_file(fs, outp);
                if ro.is_ok() {
                    let text: String = match ro { Ok(s) => s, Err(m) => m };
                    let tn: Int = chars_len(text);
                    let mut i: Int = 0;
                    let mut start: Int = 0;
                    while i <= tn {
                        if i == tn || char_at(text, i) == "\n" {
                            if i > start {
                                let line: String = str_slice(text, start, i);
                                if pkg_is_oo(line) {
                                    println(line);
                                }
                            }
                            start = i + 1;
                        }
                        i = i + 1;
                    }
                }
            }
        }
    }
}
