// # Inventory installed CAS packages
//
// Logline: Print the lock and CAS inventory from the product manager.
//
// Setup: Dispatches to cmd_pm. Not a live registry.
//
// Beats:
//   1. Print ooda pkg: cas.
//   2. Show lock package lines.
//   3. Leftover debug lists cwd .oo names after the inventory.

import "cmd_pm.oo";

fn pkg_debug_cwd(fs: &FsCap) {
    let entries: List[String] = oo_fs_read_dir(fs, ".");
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(entries, i);
        if str_ends_with(name, ".oo") {
            println(name);
        }
        i = i + 1;
    }
}

pub fn run_ooda_pkg(fs: &FsCap, sys: &SysCap, args: List[String]) {
    run_ooda_pm_pkg(fs, sys, args);
    pkg_debug_cwd(fs);
}
