// # Inventory installed CAS packages
//
// Logline: Print the lock and CAS inventory from the product manager.
//
// Setup: Dispatches to cmd_pm. Not a live registry. Not cwd test files.
//
// Beats:
//   1. Print ooda pkg: cas.
//   2. Show lock entries.
//   3. --json prints a machine object.

import "cmd_pm_pkg.oo";

pub fn run_ooda_pkg(fs: &FsCap, sys: &SysCap, args: List[String]) {
    run_ooda_pm_pkg(fs, sys, args);
}
