// # Git URL allow-list
//
// Logline: Clone only https or git@ hosts that match an exact prefix.
//
// Setup: Comma or newline prefixes. registry.openooda.org is never allowed.
//
// Beats:
//   1. Default prefix is github.com/.
//   2. http, git://, and userinfo lookalikes refuse before any clone.
//   3. A host matches a prefix only when the names are equal.

fn pm_pfx_bare(pfx: String) -> String {
    let n: Int = chars_len(pfx);
    if n < 1 {
        return pfx;
    }
    if char_at(pfx, n - 1) == "/" {
        return str_slice(pfx, 0, n - 1);
    }
    return pfx;
}

fn pm_all_digits(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n < 1 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        if char_is_digit(char_at(s, i)) {
            i = i + 1;
        } else {
            return false;
        }
    }
    return true;
}

fn pm_url_scheme_ok(url: String) -> Bool {
    let at: Int = str_index_of(url, "://");
    if at < 0 {
        return true;
    }
    if chars_len(url) >= 8 {
        if str_slice(url, 0, 8) == "https://" {
            return true;
        }
    }
    return false;
}

fn pm_url_host(url: String) -> String {
    if chars_len(url) >= 4 {
        if str_slice(url, 0, 4) == "git@" {
            let rest: String = str_slice(url, 4, chars_len(url));
            let c: Int = str_index_of(rest, ":");
            if c < 0 {
                return rest;
            }
            return str_slice(rest, 0, c);
        }
    }
    let at: Int = str_index_of(url, "://");
    if at < 0 {
        return url;
    }
    let rest: String = str_slice(url, at + 3, chars_len(url));
    let mut end: Int = chars_len(rest);
    let sl: Int = str_index_of(rest, "/");
    let h: Int = str_index_of(rest, "#");
    let q: Int = str_index_of(rest, "?");
    if sl >= 0 {
        if sl < end {
            end = sl;
        }
    }
    if h >= 0 {
        if h < end {
            end = h;
        }
    }
    if q >= 0 {
        if q < end {
            end = q;
        }
    }
    let auth: String = str_slice(rest, 0, end);
    let n: Int = chars_len(auth);
    let mut last: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if char_at(auth, i) == "@" {
            last = i;
        }
        i = i + 1;
    }
    let mut hostport: String = auth;
    if last >= 0 {
        hostport = str_slice(auth, last + 1, n);
    }
    let cl: Int = str_index_of(hostport, ":");
    if cl < 0 {
        return hostport;
    }
    let port: String = str_slice(hostport, cl + 1, chars_len(hostport));
    if pm_all_digits(port) {
        return str_slice(hostport, 0, cl);
    }
    return hostport;
}

fn pm_pfx_boundary(url: String, pn: Int) -> Bool {
    if chars_len(url) == pn {
        return true;
    }
    if chars_len(url) < pn {
        return false;
    }
    let c: String = char_at(url, pn);
    if c == "/" {
        return true;
    }
    if c == ":" {
        if str_index_of(url, "://") < 0 {
            return true;
        }
    }
    return false;
}

fn pm_url_pfx(url: String, pfx: String) -> Bool {
    let pn: Int = chars_len(pfx);
    if pn < 1 {
        return false;
    }
    if chars_len(url) >= pn {
        if str_slice(url, 0, pn) == pfx {
            if pm_pfx_boundary(url, pn) {
                return true;
            }
        }
    }
    let host: String = pm_url_host(url);
    let bare: String = pm_pfx_bare(pfx);
    if host == bare {
        return true;
    }
    return false;
}

pub fn pm_allow_default() -> String {
    return "github.com/\n";
}

pub fn pm_url_allowed(allow: String, url: String) -> Bool {
    if url == "" {
        return false;
    }
    if str_index_of(url, "registry.openooda.org") >= 0 {
        return false;
    }
    if !pm_url_scheme_ok(url) {
        return false;
    }
    let text: String = allow + pm_allow_default();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let mut sep: Bool = false;
        if i == n {
            sep = true;
        } else {
            let c: String = char_at(text, i);
            if c == "\n" {
                sep = true;
            } else {
                if c == "," {
                    sep = true;
                }
            }
        }
        if sep {
            if i > start {
                let pfx: String = str_slice(text, start, i);
                if pfx == "" {
                    let _p: String = pfx;
                } else {
                    if pm_url_pfx(url, pfx) {
                        return true;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}
