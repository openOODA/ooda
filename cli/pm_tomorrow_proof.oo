// # Tomorrow PM unit proofs
//
// Logline: Drive signed index, yank, license, pin header, replaces, overrides, and git pin.
//
// Setup: In-memory strings. Same-dir imports. No HTTP.
//
// Beats:
//   1. Index HMAC matches and tamper refuses.
//   2. Yank, license allow-list, replaces, overrides, and local git commit.
//   3. Lock v2 header parse. Package lines need @.

import "pm_index.oo";
import "pm_pin.oo";
import "pm_policy.oo";
import "pm_v2.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let idx: String = "hello|1.0.0|FsRead||abc\n";
    let sig: String = pm_index_sig(idx);
    if chars_len(sig) != 64 { fail("sig len"); }
    if !pm_index_ok(idx, sig) { fail("sig match"); }
    if pm_index_ok(idx, "TAMPER") { fail("sig tamper"); }
    if pm_index_ok("", sig) { fail("empty index"); }
    println("index sign/tamper");
    if !pm_yanked("tooyank@1.0.0\n", "tooyank", "1.0.0") { fail("yank hit"); }
    if pm_yanked("tooyank@1.0.0\n", "hello", "1.0.0") { fail("yank miss"); }
    println("yank");
    if !pm_license_ok("MIT,Apache-2.0", "MIT") { fail("lic mit"); }
    if pm_license_ok("MIT,Apache-2.0", "Proprietary") { fail("lic prop"); }
    if pm_license_ok("MIT", "") { fail("lic empty"); }
    if !pm_license_ok("", "Proprietary") { fail("lic open"); }
    println("license");
    if pm_replace_name("oldhello", "oldhello>hello") == "hello" {
        println("replace");
    } else {
        fail("replace");
    }
    if pm_override_ver("hello", "hello@1.0.0") == "1.0.0" {
        println("override");
    } else {
        fail("override");
    }
    if pm_git_name("git:gitfoo#abc123") == "gitfoo" {
        println("git name");
    } else {
        fail("git name");
    }
    if pm_git_commit("git:gitfoo#abc123") == "abc123" {
        println("git commit");
    } else {
        fail("git commit");
    }
    if !pm_git_ok("zzz", "abc123") { println("git miss"); } else { fail("git miss"); }
    if pm_git_ok("abc123\n", "abc123") { println("git ok"); } else { fail("git ok"); }
    let hdr: String = pm_lock_hdr("aaa", "bbb");
    if pm_hdr_val(hdr, "oodac") == "aaa" {
        println("pin hdr");
    } else {
        fail("pin hdr");
    }
    if pm_pin_ok(hdr, "aaa", "bbb") { println("pin ok"); } else { fail("pin ok"); }
    if pm_pin_ok(hdr, "NOPE", "bbb") { fail("pin miss"); }
    println("pin refuse");
    if pm_is_pkg_line("hello@1.0.0#x#FsRead") {
        println("pkg line");
    } else {
        fail("pkg line");
    }
    if pm_is_pkg_line("v2") { fail("hdr line"); }
    let roots: String = pm_dep_names("hello@^1.0.0,path:localfoo,git:gitfoo#abc123");
    if str_index_of(roots, "hello") < 0 { fail("deps hello"); }
    if str_index_of(roots, "localfoo") < 0 { fail("deps path"); }
    if str_index_of(roots, "gitfoo") < 0 { fail("deps git"); }
    println("dep names");
    println("pm_tomorrow_proof: PASSED");
}
