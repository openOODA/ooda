// # Allow-listed git clone for ingest
//
// Logline: Clone a pinned commit only when the url is on the allow-list.
//
// Setup: Host git under SysCap. Offline --from with a commit file does not clone.
//
// Beats:
//   1. Refuse registry.openooda.org and unknown prefixes.
//   2. git clone then checkout commit= and read HEAD.
//   3. HEAD must match or the caller sees err git.

import "cmd_pm_io.oo";
import "host_run.oo";
import "pm_allow.oo";
import "pm_resolve.oo";
import "pm_store.oo";
import "pm_v2.oo";

pub fn pm_load_allow(fs: &FsCap) -> String {
    let a: String = pm_slurp(fs, "ingest.allow");
    let b: String = pm_kv(pm_slurp(fs, "ooda.pkg"), "allow");
    return a + "\n" + b + "\n";
}

pub fn pm_git_clone_head(fs: &FsCap, sys: &SysCap, url: String, commit: String, dest: String) -> String {
    if !pm_url_allowed(pm_load_allow(fs), url) {
        return "err allow";
    }
    let headp: String = dest + "/.ooda-head";
    let cmd: String = "rm -rf " + sq(dest) + "; git clone -- " + sq(url) + " " + sq(dest) + " >/dev/null 2>&1; git -C " + sq(dest) + " checkout " + sq(commit) + " >/dev/null 2>&1; git -C " + sq(dest) + " rev-parse HEAD > " + sq(headp) + " 2>/dev/null; exit 0";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return "err git";
    }
    if !pm_git_ok(pm_slurp(fs, headp), commit) {
        return "err git";
    }
    return "ok";
}
