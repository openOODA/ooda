// # Add and remove extra HTTPS stores
//
// Logline: List stores, add a signed extra origin, or drop one.
//
// Setup: Stock is always listed. Extra add fetches catalog, minisig, and registry.pub.
//
// Beats:
//   1. registry with no verb lists stock plus extras.
//   2. add URL verifies minisign and pins the pubkey.
//   3. remove URL refuses the stock store.

import "cmd_pm_io.oo";
import "cmd_pm_reg.oo";
import "pm_reg.oo";
import "pm_regs.oo";

fn pm_regs_verb(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "add" || a == "remove" || a == "list" {
            return a;
        }
        i = i + 1;
    }
    return "list";
}

fn pm_regs_url_arg(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "pm" || a == "registry" || a == "add" || a == "remove" || a == "list" {
            i = i + 1;
        } else if str_slice(a, 0, 1) == "-" {
            i = i + 1;
        } else {
            return a;
        }
    }
    return "";
}

fn pm_regs_pin_pub(fs: &FsCap, sys: &SysCap, url: String, body: String) -> Bool {
    let path: String = pm_regs_key_path(fs, sys, url);
    if path == "" {
        return false;
    }
    let home: String = pm_regs_home(fs, sys);
    if home == "" {
        return false;
    }
    if !path_exists(fs, home) {
        let mk: Result[Void, String] = oo_fs_mkdir(fs, home);
        if mk.is_err() {
            return false;
        }
    }
    if !path_exists(fs, home + "/keys") {
        let mk2: Result[Void, String] = oo_fs_mkdir(fs, home + "/keys");
        if mk2.is_err() {
            return false;
        }
    }
    return write_file(fs, path, body).is_ok();
}

fn pm_regs_trust(fs: &FsCap, sys: &SysCap, url: String) -> String {
    if pm_reg_origin_ok(url) {
        return "ok stock";
    }
    if !pm_reg_https_ok(url) {
        return "err allow";
    }
    let dest: String = ".ooda-cache/ooda-tmp/regadd";
    let base: String = pm_reg_base(url);
    if !pm_reg_pull(fs, sys, base + "/catalog", dest, "catalog") {
        return "err fetch";
    }
    if !pm_reg_pull(fs, sys, base + "/index.minisig", dest, "index.minisig") {
        return "err fetch";
    }
    if !pm_reg_pull(fs, sys, base + "/registry.pub", dest, "registry.pub") {
        return "err minisign";
    }
    let vr: String = pm_reg_minisign_ok(fs, sys, dest + "/registry.pub", dest + "/catalog", dest + "/index.minisig");
    if vr != "ok" {
        return vr;
    }
    if !pm_regs_pin_pub(fs, sys, url, pm_slurp(fs, dest + "/registry.pub")) {
        return "err write";
    }
    return pm_regs_put(fs, sys, url);
}

pub fn run_ooda_pm_regs(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let op: String = pm_regs_verb(args);
    if op == "list" {
        let urls: String = pm_regs_urls(fs, sys);
        let n: Int = chars_len(urls);
        let mut start: Int = 0;
        let mut i: Int = 0;
        while i <= n {
            if i == n || char_at(urls, i) == "\n" {
                if i > start {
                    let one: String = str_slice(urls, start, i);
                    if pm_reg_origin_ok(one) {
                        println(one + "  (stock)");
                    } else {
                        println(one);
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return;
    }
    let url: String = pm_regs_url_arg(args);
    if url == "" {
        println("ERR\tregistry\tmissing url");
        println("usage: ooda registry add|remove https://host");
        process_exit(2);
    }
    if op == "add" {
        let r: String = pm_regs_trust(fs, sys, url);
        if str_slice(r, 0, 2) != "ok" {
            println("ERR\tregistry\t" + str_slice(r, 4, chars_len(r)));
            process_exit(2);
        }
        println("ooda registry: added " + url);
        return;
    }
    if op == "remove" {
        let r2: String = pm_regs_drop(fs, sys, url);
        if r2 != "ok" {
            println("ERR\tregistry\t" + str_slice(r2, 4, chars_len(r2)));
            process_exit(2);
        }
        println("ooda registry: removed " + url);
        return;
    }
    println("ERR\tregistry\tunknown command");
    process_exit(2);
}
