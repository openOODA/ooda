// # Product liveness for ooda health
//
// Logline: Print ooda health: ok and whether ./oodac/oodac exists.
//
// Setup: FsCap probes the compiler path. SysCap confirms it is executable.
//
// Beats:
//   1. Print the ok line.
//   2. Probe ./oodac/oodac and oodac/oodac.
//   3. Print yes or no and return.

pub fn run_ooda_health(fs: &FsCap, sys: &SysCap, args: List[String]) {
    println("ooda health: ok");
    let mut here: String = "no";
    if path_exists(fs, "./oodac/oodac") {
        here = "yes";
    }
    if path_exists(fs, "oodac/oodac") {
        here = "yes";
    }
    let xr: Result[String, String] = sys_exec(sys, "sh", "-c", "test -x ./oodac/oodac -o -x oodac/oodac");
    if xr.is_ok() {
        here = "yes";
    }
    if list_len(args) >= 0 {
        println("oodac/oodac: " + here);
    }
}
