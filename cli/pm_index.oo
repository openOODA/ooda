// # Signed file-backed vendor index
//
// Logline: HMAC the catalog index text so a tampered vendor index fails closed.
//
// Setup: Default key ooda-local-pm. Index lines are name|version|caps|deps|sha.
//
// Beats:
//   1. Sign the exact index body.
//   2. Verify by recomputing. Empty sig is a miss.
//   3. No HTTP. Not a live registry.

pub fn pm_index_key() -> String {
    return "ooda-local-pm";
}

pub fn pm_index_sig(body: String) -> String {
    return crypto_hmac_sha256_internal(pm_index_key(), body);
}

pub fn pm_index_ok(body: String, sig: String) -> Bool {
    if body == "" {
        return false;
    }
    if sig == "" {
        return false;
    }
    return pm_index_sig(body) == sig;
}

pub fn pm_index_line(name: String, ver: String, caps: String, deps: String, sha: String) -> String {
    return name + "|" + ver + "|" + caps + "|" + deps + "|" + sha;
}
