// # Dispatch the product ooda CLI
//
// Logline: Route argv under FsCap and SysCap. Product commands are native .oo.
//
// Setup: Check, build, run, test, dump, outline, reflect, patch, and fix call oodac or in-process drivers.
//
// Beats:
//   1. Print help and reject beta-out and residual commands.
//   2. Forward product cmds to host_run, patch_drive, or fix_drive.
//   3. Exit 2 on unknown command.

import "build_args.oo";
import "fix_drive.oo";
import "host_run.oo";
import "json_check.oo";
import "patch_drive.oo";
import "lsp_drive.oo";

fn print_help() {
    println("ooda 0.199.0-alpha — pure .oo product CLI");
    println("usage: ooda <cmd> …");
    println("  ooda check <file.oo> [--json-errors]");
    println("  ooda build <file.oo> [-o out] [--target c|native|llvm]");
    println("  ooda run <file.oo>");
    println("  ooda test <file.oo>                 # run verify/assert (OODA_TEST)");
    println("  ooda lsp [request.json]           # initialize/shutdown JSON-RPC (file or stdin)");
    println("beta-out: pkg bench");
    println("  ooda dump tokens|ast|check <file.oo>");
    println("  ooda outline <file.oo> [--json]");
    println("  ooda reflect <file.oo> [sym]");
    println("  ooda patch <file.oo> --replace-fn <n> --with <body>");
    println("  ooda fix <file.oo> [--yes]");
    println("residual: context digest health err-digest pkg add --fuzz --engine bc wasm");
}

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        print_help();
        process_exit(2);
    }
    let cmd = list_get(args, 0);

    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        println("ooda 0.199.0-alpha (pure .oo CLI)");
        return;
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help();
        return;
    }
    if cmd == "pkg" || cmd == "bench" {
        println("ERR\tcli\tbeta-out command: " + cmd);
        process_exit(2);
    }
    if cmd == "em" || cmd == "context" || cmd == "migrate"
        || cmd == "digest" || cmd == "health" || cmd == "err-digest"
        || cmd == "pack" || cmd == "context-pack" || cmd == "emit-health" || cmd == "errdigest"
        || cmd == "add" || cmd == "install" {
        println("ERR\tcli\tresidual command: " + cmd);
        process_exit(2);
    }

    if cmd == "check" {
        if list_len(args) < 2 { println("ooda check: missing file"); process_exit(2); }
        let mut path = "";
        let mut json = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" || a == "-json" || a == "--json" { json = true; }
            else if str_slice(a, 0, 1) != "-" { if path == "" { path = a; } }
            i = i + 1;
        }
        if path == "" { println("ooda check: missing file"); process_exit(2); }
        if !path_exists(fs, path) { println("ERR\tcheck\tunreadable file: " + path); process_exit(2); }
        if json {
            run_check_json(fs, sys, path);
            return;
        }
        run_oodac_check(fs, sys, path, false);
        return;
    }

    if cmd == "dump" {
        if list_len(args) < 3 { println("ooda dump: usage: dump tokens|ast|check <file>"); process_exit(2); }
        let kind = list_get(args, 1);
        if kind != "tokens" && kind != "ast" && kind != "check" { println("ooda dump: unknown kind (tokens|ast|check)"); process_exit(2); }
        let dpath: String = list_get(args, 2);
        if !path_exists(fs, dpath) {
            println("ERR\tdump\tunreadable file: " + dpath);
            process_exit(2);
        }
        let mut dargv: List[String] = list_new();
        dargv = list_push(dargv, kind);
        dargv = list_push(dargv, dpath);
        run_oodac(fs, sys, dargv);
        return;
    }

    if cmd == "test" {
        if list_len(args) < 2 { println("ooda test: missing file"); process_exit(2); }
        let mut tpath = "";
        let mut ti = 1;
        while ti < list_len(args) {
            let ta: String = list_get(args, ti);
            if ta == "--fuzz" || (chars_len(ta) >= 6 && str_slice(ta, 0, 6) == "--fuzz") {
                println("ERR\tcli\t--fuzz residual");
                process_exit(2);
            }
            if ta == "--engine" || (chars_len(ta) >= 8 && str_slice(ta, 0, 8) == "--engine") {
                println("ERR\tcli\t--engine on test residual");
                process_exit(2);
            }
            if str_slice(ta, 0, 1) != "-" {
                if tpath == "" { tpath = ta; }
            }
            ti = ti + 1;
        }
        if tpath == "" {
            println("ooda test: missing file");
            process_exit(2);
        }
        if !path_exists(fs, tpath) {
            println("ERR\ttest\tunreadable file: " + tpath);
            process_exit(2);
        }
        run_oodac_test(fs, sys, tpath);
        return;
    }

    if cmd == "build" {
        let bargs: List[String] = cli_build_args(args);
        run_oodac_build(fs, sys, bargs);
        return;
    }

    if cmd == "run" {
        let fwd: List[String] = cli_run_args(args);
        run_oodac_run(fs, sys, fwd);
        return;
    }

    if cmd == "outline" || cmd == "reflect" {
        if list_len(args) < 2 {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        let mut path = "";
        let mut json = false;
        let mut sym = "";
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json" || a == "-json" {
                json = true;
            } else if path == "" {
                path = a;
            } else if cmd == "reflect" && sym == "" {
                sym = a;
            }
            i = i + 1;
        }
        if path == "" {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        if !path_exists(fs, path) {
            println("ERR\t" + cmd + "\tunreadable file: " + path);
            process_exit(2);
        }
        let mut oargv: List[String] = list_new();
        if json {
            oargv = list_push(oargv, "--json");
        }
        oargv = list_push(oargv, cmd);
        oargv = list_push(oargv, path);
        if sym != "" {
            oargv = list_push(oargv, sym);
        }
        run_oodac(fs, sys, oargv);
        return;
    }
    if cmd == "patch" {
        if list_len(args) < 2 {
            println("ooda patch: missing file");
            process_exit(2);
        }
        let mut pargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            pargs = list_push(pargs, list_get(args, k));
            k = k + 1;
        }
        run_ooda_patch(fs, sys, pargs);
        return;
    }
    if cmd == "lsp" {
        let mut largs: List[String] = list_new();
        let mut lk = 1;
        while lk < list_len(args) {
            largs = list_push(largs, list_get(args, lk));
            lk = lk + 1;
        }
        run_ooda_lsp(fs, sys, largs);
        return;
    }
    if cmd == "fix" {
        if list_len(args) < 2 {
            println("ooda fix: missing file");
            process_exit(2);
        }
        let mut fargs: List[String] = list_new();
        let mut fk = 1;
        while fk < list_len(args) {
            fargs = list_push(fargs, list_get(args, fk));
            fk = fk + 1;
        }
        run_ooda_fix(fs, sys, fargs);
        return;
    }

    println("ooda: unknown command '" + cmd + "' (try help)");
    process_exit(2);
}
