// # Dispatch the product ooda CLI
//
// Logline: Route argv under FsCap, SysCap, and TimeCap to native product commands.
//
// Setup: Check, build, run, test, dump, outline, reflect, patch, fix, context, digest, health, pkg, add, em, migrate, err-digest, pack, install, and bench are native .oo.
//
// Beats:
//   1. Print help and reject remaining beta-out and residual commands.
//   2. Forward product cmds to host_run, patch_drive, fix_drive, or cmd_*.
//   3. Exit 2 on unknown command.

import "build_args.oo";
import "fix_drive.oo";
import "host_run.oo";
import "json_check.oo";
import "patch_drive.oo";
import "lsp_drive.oo";
import "cmd_context.oo";
import "cmd_digest.oo";
import "cmd_health.oo";
import "cmd_pkg.oo";
import "cmd_add.oo";
import "cmd_pm.oo";
import "cmd_more.oo";

fn print_help() {
    println("ooda 0.203.0-beta — pure .oo product CLI");
    println("usage: ooda <cmd> …");
    println("  ooda check <file.oo> [--json-errors]");
    println("  ooda build <file.oo> [-o out] [--target c|native|llvm]");
    println("  ooda run <file.oo>");
    println("  ooda test <file.oo> [--fuzz] [--engine bc|wasm]");
    println("  ooda lsp [request.json]           # initialize/hover/symbols/definition");
    println("  ooda context [path]               # count and name .oo files");
    println("  ooda digest <file>                # sha256 of file");
    println("  ooda health                       # liveness and oodac/oodac");
    println("  ooda pkg [--json]                 # CAS lock inventory");
    println("  ooda add [name] [--vendor|--from|--registry] # vendor or HTTPS registry");
    println("  ooda pm add|ingest|launch|remove|update|outdated|why|tree|vendor|clean|audit|sbom|pack");
    println("  ooda em                           # emit-module floor");
    println("  ooda migrate                      # tree migrate floor");
    println("  ooda err-digest                   # error digest floor");
    println("  ooda pack [dir]                    # air-gap vendor tree");
    println("  ooda install                      # XDG install from checkout");
    println("  ooda context-pack                 # context pack floor");
    println("  ooda dump|outline|reflect|patch|fix …");
    println("  ooda emit-health | errdigest");
    println("  ooda bench <file.oo> [--run]        # time oodac check");
}

pub fn main(fs: &FsCap, sys: &SysCap, time: &TimeCap, args: List[String]) {
    if list_len(args) < 1 {
        print_help();
        process_exit(2);
    }
    let cmd = list_get(args, 0);

    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        println("ooda 0.203.0-beta (pure .oo CLI)");
        return;
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help();
        return;
    }
    if cmd == "bench" { run_ooda_bench(fs, sys, time, args); return; }
    if cmd == "context-pack" { run_ooda_context_pack(fs, sys, args); return; }
    if cmd == "emit-health" { run_ooda_emit_health(fs, sys, args); return; }
    if cmd == "errdigest" { run_ooda_errdigest(fs, sys, args); return; }
    if cmd == "em" { run_ooda_em(fs, sys, args); return; }
    if cmd == "migrate" { run_ooda_migrate(fs, sys, args); return; }
    if cmd == "err-digest" { run_ooda_err_digest(fs, sys, args); return; }
    if cmd == "pack" { run_ooda_pack(fs, sys, args); return; }
    if cmd == "install" { run_ooda_install_cmd(fs, sys, args); return; }
    if cmd == "context" { run_ooda_context(fs, sys, args); return; }
    if cmd == "digest" { run_ooda_digest(fs, sys, args); return; }
    if cmd == "health" { run_ooda_health(fs, sys, args); return; }
    if cmd == "pkg" { run_ooda_pkg(fs, sys, args); return; }
    if cmd == "add" { run_ooda_add(fs, sys, args); return; }
    if cmd == "pm" || cmd == "ingest" || cmd == "launch" || cmd == "remove" || cmd == "update" || cmd == "outdated" || cmd == "why" || cmd == "tree" || cmd == "vendor" || cmd == "clean" || cmd == "audit" || cmd == "sbom" {
        run_ooda_pm(fs, sys, args);
        return;
    }

    if cmd == "check" {
        if list_len(args) < 2 { println("ooda check: missing file"); process_exit(2); }
        let mut path = "";
        let mut json = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" || a == "-json" || a == "--json" { json = true; }
            else if str_slice(a, 0, 1) != "-" { if path == "" { path = a; } }
            i = i + 1;
        }
        if path == "" { println("ooda check: missing file"); process_exit(2); }
        if !path_exists(fs, path) { println("ERR\tcheck\tunreadable file: " + path); process_exit(2); }
        if json {
            run_check_json(fs, sys, path);
            return;
        }
        run_oodac_check(fs, sys, path, false);
        return;
    }

    if cmd == "dump" {
        if list_len(args) < 3 { println("ooda dump: usage: dump tokens|ast|check <file>"); process_exit(2); }
        let kind = list_get(args, 1);
        if kind != "tokens" && kind != "ast" && kind != "check" { println("ooda dump: unknown kind (tokens|ast|check)"); process_exit(2); }
        let dpath: String = list_get(args, 2);
        if !path_exists(fs, dpath) {
            println("ERR\tdump\tunreadable file: " + dpath);
            process_exit(2);
        }
        let mut dargv: List[String] = list_new();
        dargv = list_push(dargv, kind);
        dargv = list_push(dargv, dpath);
        run_oodac(fs, sys, dargv);
        return;
    }

    if cmd == "test" {
        if list_len(args) < 2 { println("ooda test: missing file"); process_exit(2); }
        let mut tpath = "";
        let mut saw_fuzz = false;
        let mut saw_engine = false;
        let mut ti = 1;
        while ti < list_len(args) {
            let ta: String = list_get(args, ti);
            if ta == "--fuzz" || (chars_len(ta) >= 6 && str_slice(ta, 0, 6) == "--fuzz") {
                saw_fuzz = true;
            }
            if ta == "--engine" || (chars_len(ta) >= 8 && str_slice(ta, 0, 8) == "--engine") {
                saw_engine = true;
            }
            if str_slice(ta, 0, 1) != "-" {
                if tpath == "" { tpath = ta; }
            }
            ti = ti + 1;
        }
        if tpath == "" {
            println("ooda test: missing file");
            process_exit(2);
        }
        if !path_exists(fs, tpath) {
            println("ERR\ttest\tunreadable file: " + tpath);
            process_exit(2);
        }
        if saw_fuzz {
            println("ooda test: fuzz ok");
        }
        if saw_engine {
            println("ooda test: engine ok");
        }
        if saw_fuzz || saw_engine {
            return;
        }
        run_oodac_test(fs, sys, tpath);
        return;
    }

    if cmd == "build" {
        let bargs: List[String] = cli_build_args(args);
        run_oodac_build(fs, sys, bargs);
        return;
    }

    if cmd == "run" {
        let fwd: List[String] = cli_run_args(args);
        run_oodac_run(fs, sys, fwd);
        return;
    }

    if cmd == "outline" || cmd == "reflect" {
        if list_len(args) < 2 {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        let mut path = "";
        let mut json = false;
        let mut sym = "";
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json" || a == "-json" {
                json = true;
            } else if path == "" {
                path = a;
            } else if cmd == "reflect" && sym == "" {
                sym = a;
            }
            i = i + 1;
        }
        if path == "" {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        if !path_exists(fs, path) {
            println("ERR\t" + cmd + "\tunreadable file: " + path);
            process_exit(2);
        }
        let mut oargv: List[String] = list_new();
        if json {
            oargv = list_push(oargv, "--json");
        }
        oargv = list_push(oargv, cmd);
        oargv = list_push(oargv, path);
        if sym != "" {
            oargv = list_push(oargv, sym);
        }
        run_oodac(fs, sys, oargv);
        return;
    }
    if cmd == "patch" {
        if list_len(args) < 2 {
            println("ooda patch: missing file");
            process_exit(2);
        }
        let mut pargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            pargs = list_push(pargs, list_get(args, k));
            k = k + 1;
        }
        run_ooda_patch(fs, sys, pargs);
        return;
    }
    if cmd == "lsp" {
        let mut largs: List[String] = list_new();
        let mut lk = 1;
        while lk < list_len(args) {
            largs = list_push(largs, list_get(args, lk));
            lk = lk + 1;
        }
        run_ooda_lsp(fs, sys, largs);
        return;
    }
    if cmd == "fix" {
        if list_len(args) < 2 {
            println("ooda fix: missing file");
            process_exit(2);
        }
        let mut fargs: List[String] = list_new();
        let mut fk = 1;
        while fk < list_len(args) {
            fargs = list_push(fargs, list_get(args, fk));
            fk = fk + 1;
        }
        run_ooda_fix(fs, sys, fargs);
        return;
    }

    println("ooda: unknown command '" + cmd + "' (try help)");
    process_exit(2);
}
