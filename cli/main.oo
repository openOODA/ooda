// job: product ooda CLI (pure .oo — no Rust shell)
// in:  FsCap + SysCap + argv
// out: dispatch via scripts/ooda_product.sh with shell-safe quoting
// stage: cli
// security: every user arg single-quote escaped before sh -c

fn print_help() {
    println("ooda 0.182.1-alpha — pure .oo product CLI (no Rust)");
    println("usage: ooda version|check|dump|build|run|test|outline|reflect|patch …");
    println("  ooda check <file.oo> [--json-errors]");
    println("  ooda test|run|build|dump|outline|reflect|patch …");
    println("residual: --fuzz --release --emit-llvm wasm llvm; backend only c");
}

// POSIX single-quote escape for sh -c (safe vs $ ` " ;).
// Note: do not compare to "\n" lit — pure emit may not treat it as newline (false positives).
fn shell_sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

fn product_sh(sys: &SysCap, mode: String, args: List[String]) {
    let mut payload: String = shell_sq(mode);
    let mut i = 0;
    while i < list_len(args) {
        payload = payload + " " + shell_sq(list_get(args, i));
        i = i + 1;
    }
    let sh = "set -e; S=./scripts/ooda_product.sh; [ -x \"$S\" ] || S=scripts/ooda_product.sh; [ -x \"$S\" ] || S=ooda/scripts/ooda_product.sh; [ -x \"$S\" ] || S=../ooda/scripts/ooda_product.sh; if [ -n \"${OODA_SRC_ROOT:-}\" ] && [ -x \"${OODA_SRC_ROOT}/scripts/ooda_product.sh\" ]; then S=\"${OODA_SRC_ROOT}/scripts/ooda_product.sh\"; fi; [ -x \"$S\" ] || { echo ERR_NO_PRODUCT_SCRIPT >&2; exit 1; }; exec \"$S\" " + payload;
    let r = sys_exec(sys, "sh", "-c", sh);
    if r.is_ok() {
        return;
    }
    process_exit(1);
}

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        print_help();
        process_exit(2);
    }
    let cmd = list_get(args, 0);

    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        println("ooda 0.182.1-alpha (pure .oo CLI)");
        return;
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help();
        return;
    }
    if cmd == "lsp" || cmd == "pkg" || cmd == "bench" {
        println("ERR\tcli\tbeta-out command: " + cmd);
        process_exit(2);
    }

    if cmd == "em" || cmd == "context" || cmd == "migrate" {
        let mut subargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            subargs = list_push(subargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, cmd, subargs);
        return;
    }

    if cmd == "check" {
        if list_len(args) < 2 {
            println("ooda check: missing file");
            process_exit(2);
        }
        let mut path = "";
        let mut json = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" || a == "-json" {
                json = true;
            } else if str_slice(a, 0, 1) != "-" {
                if path == "" {
                    path = a;
                }
            }
            i = i + 1;
        }
        if path == "" {
            println("ooda check: missing file");
            process_exit(2);
        }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, "check");
        fwd = list_push(fwd, path);
        if json {
            fwd = list_push(fwd, "--json-errors");
        }
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "dump" {
        if list_len(args) < 3 {
            println("ooda dump: usage: dump tokens|ast|check <file>");
            process_exit(2);
        }
        let kind = list_get(args, 1);
        if kind != "tokens" && kind != "ast" && kind != "check" {
            println("ooda dump: unknown kind (tokens|ast|check)");
            process_exit(2);
        }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, kind);
        fwd = list_push(fwd, list_get(args, 2));
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "test" {
        if list_len(args) < 2 {
            println("ooda test: missing file");
            process_exit(2);
        }
        let mut targs: List[String] = list_new();
        let mut j = 1;
        while j < list_len(args) {
            let a = list_get(args, j);
            if a == "--fuzz" {
                println("ERR\tcli\t--fuzz residual");
                process_exit(2);
            }
            targs = list_push(targs, a);
            j = j + 1;
        }
        product_sh(sys, "test", targs);
        return;
    }

    if cmd == "build" {
        let mut target = "native";
        let mut file = "";
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--target" {
                i = i + 1;
                if i >= list_len(args) {
                    println("ooda build: --target needs value");
                    process_exit(2);
                }
                target = list_get(args, i);
            } else if a == "--backend" {
                i = i + 1;
                if i >= list_len(args) {
                    println("ERR\tbackend\tmissing value (only c)");
                    process_exit(2);
                }
                if list_get(args, i) != "c" {
                    println("ERR\tbackend\tresidual (only c)");
                    process_exit(2);
                }
            } else if a == "--release" || a == "--emit-llvm" || a == "--fuzz" {
                println("ERR\tcli\t" + a + " residual");
                process_exit(2);
            } else if str_slice(a, 0, 1) != "-" {
                file = a;
            }
            i = i + 1;
        }
        if file == "" {
            println("ooda build: missing file");
            process_exit(2);
        }
        if target == "llvm" {
            println("ERR\tcli\tbuild --target " + target + " residual");
            process_exit(2);
        }
        if target == "wasm" {
            println("ERR\tcli\ttarget wasm residual");
            process_exit(2);
        }
        if target != "c" && target != "chs" && target != "native" {
            println("ERR\tcli\tunknown target (use c|chs|native)");
            process_exit(2);
        }
        let mut bargs: List[String] = list_new();
        bargs = list_push(bargs, file);
        bargs = list_push(bargs, "--target");
        bargs = list_push(bargs, target);
        product_sh(sys, "build", bargs);
        return;
    }

    if cmd == "run" {
        if list_len(args) < 2 {
            println("ooda run: missing file");
            process_exit(2);
        }
        let mut rargs: List[String] = list_new();
        let mut i = 1;
        let mut skip_dd = false;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" {
                println("ERR\tcli\t--json-errors residual on pure run");
                process_exit(2);
            }
            if a == "--" && skip_dd == false {
                skip_dd = true;
            } else {
                rargs = list_push(rargs, a);
            }
            i = i + 1;
        }
        product_sh(sys, "run", rargs);
        return;
    }

    if cmd == "outline" || cmd == "reflect" || cmd == "patch" {
        let mut pargs: List[String] = list_new();
        let mut i = 1;
        while i < list_len(args) {
            pargs = list_push(pargs, list_get(args, i));
            i = i + 1;
        }
        if list_len(pargs) < 1 {
            println("ooda " + cmd + ": missing args");
            process_exit(2);
        }
        product_sh(sys, cmd, pargs);
        return;
    }

    println("ooda: unknown command '" + cmd + "' (try help)");
    process_exit(2);
}
