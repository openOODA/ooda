// job: product ooda CLI (pure .oo — no Rust shell)
// in:  FsCap + SysCap + argv
// out: dispatch via scripts/ooda_product.sh with shell-safe quoting
// stage: cli
// security: every user arg single-quote escaped before sh -c

import "product_sh.oo";
import "build_args.oo";

fn print_help() {
    println("ooda 0.186.0-alpha — pure .oo product CLI");
    println("usage: ooda <cmd> …");
    println("build/check:  check|build|run|test|dump|patch|fix");
    println("token-min:    outline|reflect|context|digest|health|err-digest");
    println("  ooda outline <file.oo>              # pub sigs only (~1% source)");
    println("  ooda reflect <file.oo> [sym]        # JSON caps+sig");
    println("  ooda context <file.oo[#sym]|file sym>  # outline+symbol slice JSON");
    println("  ooda digest [--emit-sample]         # session orient pack");
    println("  ooda health [mod…]                  # emit OK/SEGV matrix (no C)");
    println("  ooda err-digest [log|-]             # compress gcc/ERR logs");
    println("  ooda run [--engine bc|native] <file.oo>");
    println("  ooda check <file.oo> [--json-errors]");
    println("residual: --fuzz; wasm floor");
}

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        print_help();
        process_exit(2);
    }
    let cmd = list_get(args, 0);

    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        println("ooda 0.186.0-alpha (pure .oo CLI)");
        return;
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help();
        return;
    }
    if cmd == "lsp" || cmd == "pkg" || cmd == "bench" {
        println("ERR\tcli\tbeta-out command: " + cmd);
        process_exit(2);
    }

    // Product token-minimization (SPEC §12): context/outline/reflect/digest/health
    if cmd == "em" || cmd == "context" || cmd == "migrate"
        || cmd == "digest" || cmd == "health" || cmd == "err-digest"
        || cmd == "pack" || cmd == "context-pack" || cmd == "emit-health" || cmd == "errdigest" {
        let mut subargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            subargs = list_push(subargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, cmd, subargs);
        return;
    }

    if cmd == "add" || cmd == "install" {
        let mut subargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            subargs = list_push(subargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, cmd, subargs);
        return;
    }

    if cmd == "check" {
        if list_len(args) < 2 { println("ooda check: missing file"); process_exit(2); }
        let mut path = "";
        let mut json = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" || a == "-json" { json = true; }
            else if str_slice(a, 0, 1) != "-" { if path == "" { path = a; } }
            i = i + 1;
        }
        if path == "" { println("ooda check: missing file"); process_exit(2); }
        if !path_exists(fs, path) { println("ERR\tcheck\tunreadable file: " + path); process_exit(2); }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, "check");
        fwd = list_push(fwd, path);
        if json { fwd = list_push(fwd, "--json-errors"); }
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "dump" {
        if list_len(args) < 3 { println("ooda dump: usage: dump tokens|ast|check <file>"); process_exit(2); }
        let kind = list_get(args, 1);
        if kind != "tokens" && kind != "ast" && kind != "check" { println("ooda dump: unknown kind (tokens|ast|check)"); process_exit(2); }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, kind);
        fwd = list_push(fwd, list_get(args, 2));
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "test" {
        if list_len(args) < 2 { println("ooda test: missing file"); process_exit(2); }
        let mut targs: List[String] = list_new();
        let mut j = 1;
        while j < list_len(args) {
            let a = list_get(args, j);
            targs = list_push(targs, a);
            j = j + 1;
        }
        product_sh(sys, "test", targs);
        return;
    }

    if cmd == "build" {
        let bargs: List[String] = cli_build_args(args);
        product_sh(sys, "build", bargs);
        return;
    }

    if cmd == "run" {
        let fwd: List[String] = cli_run_args(args);
        product_sh(sys, "run", fwd);
        return;
    }

    if cmd == "outline" || cmd == "reflect" {
        // Mirror check path (extras as explicit flags — avoid generic
        // arg-copy loops that SEGV under current list/string ARC residual).
        if list_len(args) < 2 {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        let mut path = "";
        let mut json = false;
        let mut sym = "";
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json" || a == "-json" {
                json = true;
            } else if path == "" {
                path = a;
            } else if cmd == "reflect" && sym == "" {
                sym = a;
            }
            i = i + 1;
        }
        if path == "" {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        if !path_exists(fs, path) {
            println("ERR\t" + cmd + "\tunreadable file: " + path);
            process_exit(2);
        }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, cmd);
        fwd = list_push(fwd, path);
        if json {
            fwd = list_push(fwd, "--json");
        }
        if sym != "" {
            fwd = list_push(fwd, sym);
        }
        product_sh(sys, "forward", fwd);
        return;
    }
    if cmd == "patch" {
        if list_len(args) < 2 {
            println("ooda patch: missing file");
            process_exit(2);
        }
        let mut pargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            pargs = list_push(pargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, "patch", pargs);
        return;
    }
    // M155/M158/M165: bounded E_CAP + E_TC + E_HITL structural auto-fix (not free-form suggested_fix)
    if cmd == "fix" {
        if list_len(args) < 2 {
            println("ooda fix: missing file");
            process_exit(2);
        }
        let mut fargs: List[String] = list_new();
        let mut fk = 1;
        while fk < list_len(args) {
            fargs = list_push(fargs, list_get(args, fk));
            fk = fk + 1;
        }
        product_sh(sys, "fix", fargs);
        return;
    }

    println("ooda: unknown command '" + cmd + "' (try help)");
    process_exit(2);
}
