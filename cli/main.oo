// job: product ooda CLI (pure .oo — no Rust shell)
// in:  FsCap + SysCap + argv
// out: dispatch via scripts/ooda_product.sh with shell-safe quoting
// stage: cli
// security: every user arg single-quote escaped before sh -c

import "product_sh.oo";

fn print_help() {
    println("ooda 0.183.0-alpha — pure .oo product CLI");
    println("usage: ooda version|check|dump|build|run|test|outline|reflect|patch …");
    println("  ooda run [--engine bc|native] <file.oo>   (default native)");
    println("  ooda check <file.oo> [--json-errors]");
    println("  ooda build --target llvm [--release] <file.oo> [-o out]");
    println("residual: --fuzz; wasm floor; pure fuzz Int|Bool");
}

pub fn main(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 1 {
        print_help();
        process_exit(2);
    }
    let cmd = list_get(args, 0);

    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        println("ooda 0.183.0-alpha (pure .oo CLI)");
        return;
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help();
        return;
    }
    if cmd == "lsp" || cmd == "pkg" || cmd == "bench" {
        println("ERR\tcli\tbeta-out command: " + cmd);
        process_exit(2);
    }

    if cmd == "em" || cmd == "context" || cmd == "migrate" {
        let mut subargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            subargs = list_push(subargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, cmd, subargs);
        return;
    }

    if cmd == "check" {
        if list_len(args) < 2 { println("ooda check: missing file"); process_exit(2); }
        let mut path = "";
        let mut json = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json-errors" || a == "-json" { json = true; }
            else if str_slice(a, 0, 1) != "-" { if path == "" { path = a; } }
            i = i + 1;
        }
        if path == "" { println("ooda check: missing file"); process_exit(2); }
        if !path_exists(fs, path) { println("ERR\tcheck\tunreadable file: " + path); process_exit(2); }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, "check");
        fwd = list_push(fwd, path);
        if json { fwd = list_push(fwd, "--json-errors"); }
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "dump" {
        if list_len(args) < 3 { println("ooda dump: usage: dump tokens|ast|check <file>"); process_exit(2); }
        let kind = list_get(args, 1);
        if kind != "tokens" && kind != "ast" && kind != "check" { println("ooda dump: unknown kind (tokens|ast|check)"); process_exit(2); }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, kind);
        fwd = list_push(fwd, list_get(args, 2));
        product_sh(sys, "forward", fwd);
        return;
    }

    if cmd == "test" {
        if list_len(args) < 2 { println("ooda test: missing file"); process_exit(2); }
        let mut targs: List[String] = list_new();
        let mut j = 1;
        while j < list_len(args) {
            let a = list_get(args, j);
            targs = list_push(targs, a);
            j = j + 1;
        }
        product_sh(sys, "test", targs);
        return;
    }

    if cmd == "build" {
        let mut target: String = "native";
        let mut file: String = "";
        let mut out_path: String = "";
        let mut emit_llvm = false;
        let mut target_set = false;
        let mut verbose = false;
        let mut release = false;
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--target" {
                i = i + 1;
                if i >= list_len(args) { println("ooda build: --target needs value"); process_exit(2); }
                let tv = list_get(args, i);
                if (emit_llvm && tv != "llvm") || (target_set && target != tv) { println("ERR\tcli\tconflicting target flags"); process_exit(2); }
                target = tv;
                target_set = true;
            } else if str_slice(a, 0, 9) == "--target=" {
                let tv = str_slice(a, 9, chars_len(a));
                if (emit_llvm && tv != "llvm") || (target_set && target != tv) { println("ERR\tcli\tconflicting target flags"); process_exit(2); }
                target = tv;
                target_set = true;
            } else if a == "--emit-llvm" {
                if target_set && target != "llvm" { println("ERR\tcli\tconflicting target flags"); process_exit(2); }
                emit_llvm = true;
                target = "llvm";
                target_set = true;
            } else if a == "-o" {
                i = i + 1;
                if i >= list_len(args) { println("ooda build: -o needs value"); process_exit(2); }
                out_path = list_get(args, i);
            } else if str_slice(a, 0, 3) == "-o=" {
                out_path = str_slice(a, 3, chars_len(a));
            } else if a == "--verbose" {
                verbose = true;
            } else if a == "--backend" {
                i = i + 1;
                if i >= list_len(args) { println("ERR\tbackend\tmissing value"); process_exit(2); }
                let bv = list_get(args, i);
                if bv != "c" && bv != "llvm" && bv != "wasm" { println("ERR\tbackend\tresidual"); process_exit(2); }
            } else if a == "--release" {
                release = true;
            } else if a == "--fuzz" {
                println("ERR\tcli\t--fuzz residual");
                process_exit(2);
            } else if str_slice(a, 0, 1) != "-" {
                file = a;
            } else {
                println("ERR\tcli\tunsupported system feature: " + a);
                process_exit(2);
            }
            i = i + 1;
        }
        if file == "" { println("ooda build: missing file"); process_exit(2); }
        if target != "c" && target != "chs" && target != "native" && target != "llvm" && target != "wasm" {
            println("ERR\tcli\tinvalid target: " + target);
            process_exit(2);
        }
        if release && target != "llvm" {
            println("ERR\tcli\t--release only with --target llvm (or --emit-llvm)");
            process_exit(2);
        }
        let mut bargs: List[String] = list_new();
        bargs = list_push(bargs, file);
        bargs = list_push(bargs, "--target");
        bargs = list_push(bargs, target);
        if out_path != "" {
            bargs = list_push(bargs, "-o");
            bargs = list_push(bargs, out_path);
        }
        if verbose { bargs = list_push(bargs, "--verbose"); }
        if emit_llvm { bargs = list_push(bargs, "--emit-llvm"); }
        if release { bargs = list_push(bargs, "--release"); }
        product_sh(sys, "build", bargs);
        return;
    }

    if cmd == "run" {
        let fwd: List[String] = cli_run_args(args);
        product_sh(sys, "run", fwd);
        return;
    }

    if cmd == "outline" || cmd == "reflect" {
        // Mirror check path (extras as explicit flags — avoid generic
        // arg-copy loops that SEGV under current list/string ARC residual).
        if list_len(args) < 2 {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        let mut path = "";
        let mut json = false;
        let mut sym = "";
        let mut i = 1;
        while i < list_len(args) {
            let a = list_get(args, i);
            if a == "--json" || a == "-json" {
                json = true;
            } else if path == "" {
                path = a;
            } else if cmd == "reflect" && sym == "" {
                sym = a;
            }
            i = i + 1;
        }
        if path == "" {
            println("ooda " + cmd + ": missing file");
            process_exit(2);
        }
        if !path_exists(fs, path) {
            println("ERR\t" + cmd + "\tunreadable file: " + path);
            process_exit(2);
        }
        let mut fwd: List[String] = list_new();
        fwd = list_push(fwd, cmd);
        fwd = list_push(fwd, path);
        if json {
            fwd = list_push(fwd, "--json");
        }
        if sym != "" {
            fwd = list_push(fwd, sym);
        }
        product_sh(sys, "forward", fwd);
        return;
    }
    if cmd == "patch" {
        if list_len(args) < 2 {
            println("ooda patch: missing file");
            process_exit(2);
        }
        let mut pargs: List[String] = list_new();
        let mut k = 1;
        while k < list_len(args) {
            pargs = list_push(pargs, list_get(args, k));
            k = k + 1;
        }
        product_sh(sys, "patch", pargs);
        return;
    }

    println("ooda: unknown command '" + cmd + "' (try help)");
    process_exit(2);
}
