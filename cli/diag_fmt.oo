// # Visual Compiler Diagnostic Formatter
//
// Logline: Renders high-precision compiler diagnostics with source line context, line numbers, and caret pointers.
//
// Setup: Formats structured compiler errors into human-readable visual snippets with caret underlines.
//
// Beats:
//   1. Extract source line at specific line number.
//   2. Generate padding and caret underline pointing to column.
//   3. Render complete compiler diagnostic banner.
// RULES.oot 1.4: Pure text formatting, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.


pub fn extract_source_line(source_text: String, target_line_idx: Int) -> String {
    let mut cur_text: String = source_text;
    let mut current_line_num: Int = 1;

    while chars_len(cur_text) > 0 {
        let nl_pos: Int = str_index_of(cur_text, "\n");
        let mut text_line: String = cur_text;
        if nl_pos >= 0 {
            text_line = str_slice(cur_text, 0, nl_pos);
            cur_text = str_slice(cur_text, nl_pos + 1, chars_len(cur_text));
        } else {
            cur_text = "";
        }

        if current_line_num == target_line_idx {
            return text_line;
        }
        current_line_num = current_line_num + 1;
    }
    return "";
}

pub fn make_caret_line(col_num: Int, span_len: Int, note: String) -> String {
    let mut pad: String = "";
    let mut i: Int = 1;
    while i < col_num {
        pad = pad + " ";
        i = i + 1;
    }

    let mut carets: String = "^";
    let mut j: Int = 1;
    while j < span_len {
        carets = carets + "^";
        j = j + 1;
    }

    if chars_len(note) > 0 {
        return pad + carets + " " + note;
    }
    return pad + carets;
}

pub fn format_visual_diagnostic(source_body: String, file_path: String, line_no: Int, col_no: Int, err_code: String, msg: String) -> String {
    let raw_line: String = extract_source_line(source_body, line_no);
    let line_str: String = line_no.to_string();
    let col_str: String = col_no.to_string();
    let caret_str: String = make_caret_line(col_no, 1, msg);

    let mut out: String = "error[" + err_code + "]: " + msg + "\n";
    out = out + "  --> " + file_path + ":" + line_str + ":" + col_str + "\n";
    out = out + "   |\n";
    out = out + " " + line_str + " | " + raw_line + "\n";
    out = out + "   | " + caret_str + "\n";
    return out;
}
