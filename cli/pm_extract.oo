// # Fail-closed ar member walk
//
// Logline: Walk Unix ar members, refuse traversal and maintainer scripts, else extract.
//
// Setup: Magic is !<arch> then 60-byte headers. No dpkg. No rpm. No HTTP.
//
// Beats:
//   1. Refuse .., absolute names, and preinst/postinst/prerm/postrm.
//   2. A real ar extracts regular file bytes.
//   3. Unknown magic is err magic so ingest can stay blob-only.

import "pm_core.oo";

pub fn pm_member_ok(name: String) -> Bool {
    if name == "" {
        return false;
    }
    if str_index_of(name, "..") >= 0 {
        return false;
    }
    if str_slice(name, 0, 1) == "/" {
        return false;
    }
    if str_index_of(name, "\\") >= 0 {
        return false;
    }
    if str_index_of(name, "preinst") >= 0 {
        return false;
    }
    if str_index_of(name, "postinst") >= 0 {
        return false;
    }
    if str_index_of(name, "prerm") >= 0 {
        return false;
    }
    if str_index_of(name, "postrm") >= 0 {
        return false;
    }
    return true;
}

fn pm_rtrim_ar(s: String) -> String {
    let n: Int = chars_len(s);
    let mut e: Int = n;
    while e > 0 {
        let c: String = char_at(s, e - 1);
        if c == " " {
            e = e - 1;
        } else {
            if c == "/" {
                e = e - 1;
            } else {
                return str_slice(s, 0, e);
            }
        }
    }
    return "";
}

pub fn pm_ar_magic(body: String) -> Bool {
    if chars_len(body) < 8 {
        return false;
    }
    return str_slice(body, 0, 8) == "!<arch>\n";
}

pub fn pm_ar_walk(body: String) -> String {
    if !pm_ar_magic(body) {
        return "err magic";
    }
    let n: Int = chars_len(body);
    let mut i: Int = 8;
    let mut out: String = "";
    let mut saw: Bool = false;
    while i + 60 <= n {
        let raw: String = str_slice(body, i, i + 16);
        let nm: String = pm_rtrim_ar(raw);
        let szs: String = pm_rtrim_ar(str_slice(body, i + 48, i + 58));
        let sz: Int = pm_int(szs);
        i = i + 60;
        if i + sz > n {
            return "err magic";
        }
        if nm == "" {
            let _e: String = nm;
        } else {
            if !pm_member_ok(nm) {
                return "err path";
            }
            out = out + str_slice(body, i, i + sz);
            saw = true;
        }
        i = i + sz;
        if (sz - (sz / 2) * 2) == 1 {
            i = i + 1;
        }
    }
    if saw == false {
        return "err magic";
    }
    return "ok " + out;
}

pub fn pm_ar_find(body: String, prefix: String) -> String {
    if !pm_ar_magic(body) {
        return "";
    }
    let n: Int = chars_len(body);
    let pn: Int = chars_len(prefix);
    let mut i: Int = 8;
    let mut hit: String = "";
    while i + 60 <= n {
        let nm: String = pm_rtrim_ar(str_slice(body, i, i + 16));
        let sz: Int = pm_int(pm_rtrim_ar(str_slice(body, i + 48, i + 58)));
        i = i + 60;
        if i + sz > n {
            return "";
        }
        if nm == "" {
            let _e: String = nm;
        } else {
            if !pm_member_ok(nm) {
                return "err path";
            }
            if chars_len(nm) >= pn {
                if str_slice(nm, 0, pn) == prefix {
                    if hit == "" {
                        hit = str_slice(body, i, i + sz);
                    }
                }
            }
        }
        i = i + sz;
        if (sz - (sz / 2) * 2) == 1 {
            i = i + 1;
        }
    }
    return hit;
}
