// # Fetch a static HTTPS vendor into a local cache
//
// Logline: GET index and index.minisig. Verify minisign. Then add is file-backed.
//
// Setup: curl and minisign under SysCap. Pubkey is cli/registry.pub, not fetched.
//
// Beats:
//   1. Refuse a bad origin before any GET.
//   2. minisign -V must pass. Missing minisign or HMAC-only is not ok.
//   3. Fetch each index name's manifest and payload.

import "cmd_pm_io.oo";
import "host_run.oo";
import "pm_name.oo";
import "pm_reg.oo";
import "pm_resolve.oo";

pub fn pm_reg_pub_path() -> String {
    return "cli/registry.pub";
}

pub fn pm_reg_minisign_ok(fs: &FsCap, sys: &SysCap, pubp: String, msgp: String, sigp: String) -> String {
    if !path_exists(fs, pubp) {
        return "err minisign";
    }
    if !path_exists(fs, msgp) {
        return "err index";
    }
    if !path_exists(fs, sigp) {
        return "err index";
    }
    let rc: String = msgp + ".msrc";
    let cmd: String = "if command -v minisign >/dev/null 2>&1; then minisign -V -p " + sq(pubp) + " -m " + sq(msgp) + " -x " + sq(sigp) + " >/dev/null 2>&1; echo $? > " + sq(rc) + "; else echo 127 > " + sq(rc) + "; fi; exit 0";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return "err minisign";
    }
    let out: String = pm_slurp(fs, rc);
    if str_slice(out, 0, 3) == "127" {
        return "err minisign";
    }
    if str_slice(out, 0, 1) == "0" {
        if chars_len(out) == 1 {
            return "ok";
        }
        if char_at(out, 1) == "\n" {
            return "ok";
        }
    }
    return "err index";
}

fn pm_reg_pull(fs: &FsCap, sys: &SysCap, url: String, dir: String, leaf: String) -> Bool {
    if !pm_reg_rel_ok(leaf) {
        return false;
    }
    let dest: String = dir + "/" + leaf;
    let cmd: String = "mkdir -p " + sq(dir) + " && curl -fsS --max-time 30 -o " + sq(dest) + " -- " + sq(url) + "; exit 0";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return false;
    }
    if !path_exists(fs, dest) {
        return false;
    }
    if pm_slurp(fs, dest) == "" {
        return false;
    }
    return true;
}

fn pm_reg_fetch_pkg(fs: &FsCap, sys: &SysCap, base: String, dest: String, name: String) -> Bool {
    if !pm_name_ok(name) {
        return false;
    }
    let dir: String = dest + "/" + name;
    if !pm_reg_pull(fs, sys, base + "/" + name + "/manifest", dir, "manifest") {
        return false;
    }
    let man: String = pm_slurp(fs, dir + "/manifest");
    let mut pay: String = pm_kv(man, "payload");
    if pay == "" {
        pay = name + ".oo";
    }
    if !pm_reg_rel_ok(pay) {
        return false;
    }
    if !pm_reg_pull(fs, sys, base + "/" + name + "/" + pay, dir, pay) {
        return false;
    }
    let outl: String = pm_kv(man, "outline");
    if outl == "" {
        return true;
    }
    if !pm_reg_rel_ok(outl) {
        return true;
    }
    let _o: Bool = pm_reg_pull(fs, sys, base + "/" + name + "/" + outl, dir, outl);
    return true;
}

pub fn pm_reg_materialize(fs: &FsCap, sys: &SysCap, url: String, dest: String) -> String {
    if !pm_reg_origin_ok(url) {
        return "err allow";
    }
    let base: String = pm_reg_base(url);
    if !pm_reg_pull(fs, sys, base + "/catalog", dest, "catalog") {
        return "err fetch";
    }
    if !pm_reg_pull(fs, sys, base + "/index.minisig", dest, "index.minisig") {
        return "err fetch";
    }
    let vr: String = pm_reg_minisign_ok(fs, sys, pm_reg_pub_path(), dest + "/catalog", dest + "/index.minisig");
    if vr == "ok" {
        let _v: String = vr;
    } else {
        return vr;
    }
    let idx: String = pm_slurp(fs, dest + "/catalog");
    let _y: Bool = pm_reg_pull(fs, sys, base + "/yank", dest, "yank");
    let n: Int = chars_len(idx);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(idx, i) == "\n" {
            if i > start {
                let line: String = str_slice(idx, start, i);
                let nm: String = pm_line_field(line, 0);
                if nm != "" {
                    if !pm_reg_fetch_pkg(fs, sys, base, dest, nm) {
                        return "err fetch";
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "ok";
}
