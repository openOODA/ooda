// # Transitive file-backed catalog resolve
//
// Logline: Walk chain and diamond deps from a file-backed catalog and refuse bad path: names.
//
// Setup: Catalog lines are name|version|caps|deps. Imports pm_core. No HTTP.
//
// Beats:
//   1. Pick each name with its SemVer spec and enqueue comma-separated deps.
//   2. Keep one version per name on a diamond. Incompatible specs are a conflict.
//   3. path:name is a catalog row. Missing, traversal, extra caps fail closed.

import "pm_core.oo";

fn graph_pfx(s: String, p: String) -> Bool {
    let n: Int = chars_len(p);
    if chars_len(s) < n {
        return false;
    }
    return str_slice(s, 0, n) == p;
}

fn graph_field(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(line, i) == "|" {
            if field == idx {
                return str_slice(line, start, i);
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn graph_pick(catalog: String, name: String, spec: String) -> String {
    let n: Int = chars_len(catalog);
    let mut best: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(catalog, i) == "\n" {
            if i > start {
                let line: String = str_slice(catalog, start, i);
                if graph_field(line, 0) == name {
                    let ver: String = graph_field(line, 1);
                    if pm_semver_sat(ver, spec) {
                        if best == "" {
                            best = line;
                        } else {
                            if pm_semver_cmp(ver, graph_field(best, 1)) == 1 {
                                best = line;
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return best;
}

fn graph_cut(s: String, mark: String) -> String {
    let i: Int = str_index_of(s, mark);
    if i < 0 {
        return s;
    }
    return str_slice(s, 0, i);
}

fn graph_name(tok: String) -> String {
    let t: String = graph_cut(tok, "#");
    if graph_pfx(t, "path:") {
        return str_slice(t, 5, chars_len(t));
    }
    let at: Int = str_index_of(t, "@");
    if at < 1 {
        return t;
    }
    let rest: String = str_slice(t, at + 1, chars_len(t));
    if graph_pfx(rest, "path:") {
        return str_slice(rest, 5, chars_len(rest));
    }
    return str_slice(t, 0, at);
}

fn graph_spec(tok: String) -> String {
    let t: String = graph_cut(tok, "#");
    if graph_pfx(t, "path:") {
        return "*";
    }
    let at: Int = str_index_of(t, "@");
    if at < 1 {
        return "*";
    }
    let rest: String = str_slice(t, at + 1, chars_len(t));
    if graph_pfx(rest, "path:") {
        return "*";
    }
    if rest == "" {
        return "*";
    }
    return rest;
}

fn graph_grant(tok: String, fb: Int) -> Int {
    let h: Int = str_index_of(tok, "#");
    if h < 0 {
        return fb;
    }
    return pm_int(str_slice(tok, h + 1, chars_len(tok)));
}

fn graph_locked(out: String, name: String) -> String {
    let n: Int = chars_len(out);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(out, i) == " " {
            if i > start {
                let tok: String = str_slice(out, start, i);
                let at: Int = str_index_of(tok, "@");
                if at > 0 {
                    if str_slice(tok, 0, at) == name {
                        return str_slice(tok, at + 1, chars_len(tok));
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn graph_push(q: String, deps: String) -> String {
    if deps == "" {
        return q;
    }
    let n: Int = chars_len(deps);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut out: String = q;
    while i <= n {
        if i == n || char_at(deps, i) == "," {
            if i > start {
                let one: String = str_slice(deps, start, i);
                if one != "" {
                    out = out + one + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn pm_resolve_tree(catalog: String, name: String, parent_caps: Int) -> String {
    if pm_name_ok(name) == false {
        return "err name";
    }
    if str_index_of(name, "://") >= 0 {
        return "err name";
    }
    let mut q: String = name + "\n";
    let mut out: String = "";
    let mut steps: Int = 0;
    while steps < 32 {
        if q == "" {
            if out == "" {
                return "err missing";
            }
            return "ok " + out;
        }
        let nl: Int = str_index_of(q, "\n");
        let mut cur: String = q;
        if nl >= 0 {
            cur = str_slice(q, 0, nl);
            q = str_slice(q, nl + 1, chars_len(q));
        } else {
            q = "";
        }
        if cur != "" {
            if str_index_of(cur, "://") >= 0 {
                return "err name";
            }
            let nm: String = graph_name(cur);
            if pm_name_ok(nm) == false {
                return "err name";
            }
            let spec: String = graph_spec(cur);
            let grant: Int = graph_grant(cur, parent_caps);
            if pm_caps_ok(parent_caps, grant) == false {
                return "err caps";
            }
            let have: String = graph_locked(out, nm);
            if have != "" {
                if pm_semver_sat(have, spec) == false {
                    return "err conflict";
                }
            } else {
                let line: String = graph_pick(catalog, nm, spec);
                if line == "" {
                    return "err missing";
                }
                let ver: String = graph_field(line, 1);
                let mask: Int = pm_int(graph_field(line, 2));
                if pm_caps_ok(grant, mask) == false {
                    return "err caps";
                }
                if out == "" {
                    out = nm + "@" + ver;
                } else {
                    out = out + " " + nm + "@" + ver;
                }
                q = graph_push(q, graph_field(line, 3));
            }
        }
        steps = steps + 1;
    }
    return "err depth";
}
