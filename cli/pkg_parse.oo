// # Project ooda.pkg key=value
//
// Logline: Read name, version, deps, and caps from a project ooda.pkg file.
//
// Setup: On-disk text is key=value. Vendor manifest uses the same keys. No network.
//
// Beats:
//   1. Split lines and take the value after the first equals.
//   2. Expose name, version, deps, and caps, plus a writer for those four keys.
//   3. Map a caps field to a CapName and a parent grant mask.

import "pm_name.oo";

fn pkg_trim(s: String) -> String {
    let n: Int = chars_len(s);
    let mut a: Int = 0;
    let mut b: Int = n;
    while a < b {
        let c: String = char_at(s, a);
        if c == " " || c == "\t" || c == "\r" {
            a = a + 1;
        } else {
            break;
        }
    }
    while b > a {
        let c: String = char_at(s, b - 1);
        if c == " " || c == "\t" || c == "\r" {
            b = b - 1;
        } else {
            break;
        }
    }
    return str_slice(s, a, b);
}

fn pkg_eq(line: String) -> Int {
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    while i < n {
        if char_at(line, i) == "=" {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn pkg_kv(text: String, key: String) -> String {
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let raw: String = str_slice(text, start, i);
                let line: String = pkg_trim(raw);
                if line != "" {
                    if str_slice(line, 0, 1) != "#" {
                        let eq: Int = pkg_eq(line);
                        if eq > 0 {
                            let k: String = pkg_trim(str_slice(line, 0, eq));
                            if k == key {
                                return pkg_trim(str_slice(line, eq + 1, chars_len(line)));
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn pkg_name(text: String) -> String {
    return pkg_kv(text, "name");
}

pub fn pkg_version(text: String) -> String {
    return pkg_kv(text, "version");
}

pub fn pkg_deps(text: String) -> String {
    return pkg_kv(text, "deps");
}

pub fn pkg_caps(text: String) -> String {
    return pkg_kv(text, "caps");
}

pub fn pkg_min_pin(text: String) -> String {
    return pkg_kv(text, "min_pin");
}

pub fn pkg_parse_min_pin(text: String) -> String {
    return pkg_min_pin(text);
}

pub fn pkg_emit(name: String, version: String, deps: String, caps: String) -> String {
    return "name=" + name + "\nversion=" + version + "\nmin_pin=v0.208.0\ndeps=" + deps + "\ncaps=" + caps + "\n";
}

pub fn pkg_file() -> String {
    return "ooda.pkg";
}

pub fn pkg_ok(text: String) -> Bool {
    let name: String = pkg_name(text);
    if name == "" {
        return false;
    }
    if pm_name_ok(name) == false {
        return false;
    }
    let ver: String = pkg_version(text);
    let vn: Int = chars_len(ver);
    if vn < 5 {
        return false;
    }
    let mut i: Int = 0;
    let mut dots: Int = 0;
    while i < vn {
        if char_at(ver, i) == "." {
            dots = dots + 1;
        }
        i = i + 1;
    }
    return dots > 0;
}

pub fn pkg_cap_name(caps: String) -> String {
    if caps == "" { return "FsRead"; }
    if caps == "1" { return "FsRead"; }
    if caps == "2" { return "Net"; }
    if caps == "4" { return "Process"; }
    if caps == "8" { return "FsWrite"; }
    if caps == "FsRead" { return "FsRead"; }
    if caps == "FsWrite" { return "FsWrite"; }
    if caps == "Net" { return "Net"; }
    if caps == "Process" { return "Process"; }
    if caps == "FsCap" { return "FsRead"; }
    if caps == "FsReadCap" { return "FsRead"; }
    if caps == "FsWriteCap" { return "FsWrite"; }
    if caps == "SysCap" { return "Process"; }
    if caps == "ProcessCap" { return "Process"; }
    return caps;
}

pub fn pkg_caps_mask(text: String) -> Int {
    let c: String = pkg_cap_name(pkg_caps(text));
    if c == "FsRead" { return 1; }
    if c == "Net" { return 2; }
    if c == "Process" { return 4; }
    if c == "FsWrite" { return 8; }
    return 1;
}

pub fn pkg_read(fs: &FsCap, dir: String) -> String {
    let mut base: String = dir;
    if base == "" {
        base = ".";
    }
    let p1: String = base + "/ooda.pkg";
    if path_exists(fs, p1) {
        let r1: Result[String, String] = read_file(fs, p1);
        if r1.is_ok() {
            return match r1 { Ok(s) => s, Err(m) => m };
        }
    }
    let p2: String = base + "/manifest";
    if path_exists(fs, p2) {
        let r2: Result[String, String] = read_file(fs, p2);
        if r2.is_ok() {
            return match r2 { Ok(s) => s, Err(m) => m };
        }
    }
    return "";
}
