// # HTTPS registry origin rules
//
// Logline: Allow only https://registry.openooda.org as an add --registry origin.
//
// Setup: Pure string checks. No HTTP. Git allow-list is a different function.
//
// Beats:
//   1. Require https and host registry.openooda.org.
//   2. Refuse http, lookalikes, and extra origin paths.
//   3. Relative fetch paths must not traverse.

pub fn pm_reg_default() -> String {
    return "https://registry.openooda.org";
}

pub fn pm_reg_origin_ok(url: String) -> Bool {
    if chars_len(url) < 8 {
        return false;
    }
    if str_slice(url, 0, 8) == "https://" {
        let rest: String = str_slice(url, 8, chars_len(url));
        let sl: Int = str_index_of(rest, "/");
        let mut host: String = rest;
        let mut path: String = "";
        if sl >= 0 {
            host = str_slice(rest, 0, sl);
            path = str_slice(rest, sl, chars_len(rest));
        }
        if host == "registry.openooda.org" {
            if path == "" {
                return true;
            }
            if path == "/" {
                return true;
            }
            return false;
        }
        return false;
    }
    return false;
}

pub fn pm_reg_base(url: String) -> String {
    if pm_reg_origin_ok(url) {
        return pm_reg_default();
    }
    return "";
}

pub fn pm_reg_rel_ok(rel: String) -> Bool {
    if rel == "" {
        return false;
    }
    if str_index_of(rel, "..") >= 0 {
        return false;
    }
    if str_index_of(rel, "://") >= 0 {
        return false;
    }
    if char_at(rel, 0) == "/" {
        return false;
    }
    return true;
}
