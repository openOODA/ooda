// # HTTPS registry origin rules
//
// Logline: Name the stock origin and accept extra https hosts the user listed.
//
// Setup: Pure string checks. No HTTP. Git allow-list is a different function.
//
// Beats:
//   1. Require https and host registry.openooda.org.
//   2. Refuse http, lookalikes, and extra origin paths.
//   3. Relative fetch paths must not traverse.

pub fn pm_reg_default() -> String {
    return "https://registry.openooda.org";
}

pub fn pm_same(a: String, b: String) -> Bool {
    if chars_len(a) < chars_len(b) {
        return false;
    }
    if chars_len(b) < chars_len(a) {
        return false;
    }
    if chars_len(a) < 1 {
        return true;
    }
    let i: Int = str_index_of(a, b);
    if i < 0 {
        return false;
    }
    if i < 1 {
        return true;
    }
    return false;
}

pub fn pm_reg_host(url: String) -> String {
    if chars_len(url) < 8 {
        return "";
    }
    if str_slice(url, 0, 8) != "https://" {
        return "";
    }
    let rest: String = str_slice(url, 8, chars_len(url));
    let sl: Int = str_index_of(rest, "/");
    if sl < 0 {
        return rest;
    }
    return str_slice(rest, 0, sl);
}

pub fn pm_reg_https_ok(url: String) -> Bool {
    let host: String = pm_reg_host(url);
    if host == "" {
        return false;
    }
    if str_index_of(host, "@") >= 0 {
        return false;
    }
    if str_index_of(host, " ") >= 0 {
        return false;
    }
    if str_slice(url, 0, 8) != "https://" {
        return false;
    }
    let rest: String = str_slice(url, 8, chars_len(url));
    let sl: Int = str_index_of(rest, "/");
    let mut path: String = "";
    if sl >= 0 {
        path = str_slice(rest, sl, chars_len(rest));
    }
    if path == "" {
        return true;
    }
    if path == "/" {
        return true;
    }
    return false;
}

pub fn pm_reg_origin_ok(url: String) -> Bool {
    if !pm_reg_https_ok(url) {
        return false;
    }
    return pm_reg_host(url) == "registry.openooda.org";
}

pub fn pm_reg_base(url: String) -> String {
    if !pm_reg_https_ok(url) {
        return "";
    }
    return "https://" + pm_reg_host(url);
}

pub fn pm_reg_rel_ok(rel: String) -> Bool {
    if rel == "" {
        return false;
    }
    if str_index_of(rel, "..") >= 0 {
        return false;
    }
    if str_index_of(rel, "://") >= 0 {
        return false;
    }
    if char_at(rel, 0) == "/" {
        return false;
    }
    return true;
}
