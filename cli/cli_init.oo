// # Project Initialization and Scaffolding Handler
//
// Logline: Scaffolds standard OODA package layouts with manifests, test suites, and AI rules.
//
// Setup: Creates src/main.oo, tests/test_main.oo, ooda.pkg, and AI rule configurations under SysCap.
//
// Beats:
//   1. Resolve project name and create project directories.
//   2. Generate ooda.pkg manifest and starter source and test files.
//   3. Generate AI editor rules (.cursorrules, .windsurfrules).
//   4. Generate AI model instructions (CLAUDE.md, AGENTS.oot).

pub fn cli_init_project(sys: &SysCap, proj_name: String) -> Result[String, String] {
    if chars_len(proj_name) == 0 {
        return Err("E_INIT: missing project name");
    }

    let manifest_content: String = "name=" + proj_name + "\nversion=0.1.0\nmin_pin=v0.209.0\ndeps=\ncaps=FsRead\n";
    let main_content: String = "// # Main Entry Point for " + proj_name + "\n"
        + "//\n"
        + "// Logline: Starter application entry point for " + proj_name + ".\n"
        + "//\n"
        + "// Setup: Granted SysCap to run application logic.\n"
        + "//\n"
        + "// Beats:\n"
        + "//   1. Print welcome message.\n"
        + "\n"
        + "pub fn main(sys: &SysCap) {\n"
        + "    println(\"Hello from " + proj_name + "!\");\n"
        + "}\n";
    let test_content: String = "// # Test Suite for " + proj_name + "\n"
        + "//\n"
        + "// Logline: Starter unit tests for " + proj_name + ".\n"
        + "//\n"
        + "// Setup: Verifies basic logic.\n"
        + "//\n"
        + "// Beats:\n"
        + "//   1. Run basic arithmetic assertions.\n"
        + "\n"
        + "pub fn test_basic_addition() -> Bool {\n"
        + "    let sum: Int = 2 + 2;\n"
        + "    if sum == 4 {\n"
        + "        return true;\n"
        + "    }\n"
        + "    return false;\n"
        + "}\n"
        + "\n"
        + "pub fn main() {\n"
        + "    if !test_basic_addition() {\n"
        + "        println(\"FAIL: basic test\");\n"
        + "        process_exit(1);\n"
        + "    }\n"
        + "    println(\"OK: ALL_TESTS_PASSED\");\n"
        + "}\n";
    let cursor_content: String = "# openOODA AI Editor Rules\n1. Always use .oo file extension for code and .oot for documentation.\n2. Every .oo file must have a 4-element Academy header (Title, Logline, Setup, Beats).\n3. Strict <= 256 lines per file constraint.\n4. Mandatory explicit type annotations on every let statement (e.g. let x: Int = 0;).\n5. Zero trailing commas in struct definitions and struct literals.\n6. Return Result[T, String] with Err(\"...\") on failure; never panic.\n";
    let claude_content: String = "# CLAUDE.md - openOODA Project Instructions\n\n## Syntax Laws\n- Extension: .oo for code, .oot for documentation.\n- Header: 4-element Academy header required on all source files.\n- Line limit: strictly <= 256 lines per file.\n- Types: Always explicit let x: Type = val;.\n- Structs: No trailing commas in fields or initializers.\n";
    let windsurf_content: String = "# openOODA Windsurf Rules\n1. Pure .oo for executable logic; pure .oot for specifications.\n2. Mandatory 4-element Academy headers on all .oo source files.\n3. Maximum file budget: <= 256 lines.\n4. Strict explicit type annotations on every let.\n5. Zero struct trailing commas.\n";
    let agents_content: String = "# AGENTS.oot - Universal Autonomous AI Engineering Manual\n\nLogline: Zero-trust operating instructions for autonomous AI agents authoring openOODA systems.\n\nSetup: Follow all rules fail-closed. Never produce unverified code.\n\nBeats:\n  1. Pure .oo source files (<= 256 lines).\n  2. 4-Element Academy headers on every file.\n  3. Explicit type annotations on all variable bindings.\n  4. Zero trailing commas in structs.\n";

    let mkdir_cmd: String = "mkdir -p " + proj_name + "/src " + proj_name + "/tests";
    let r1 = sys_exec(sys, "sh", "-c", mkdir_cmd);
    if !r1.is_ok() {
        return Err("E_INIT: failed to create directories");
    }

    let w1_cmd: String = "cat <<'EOF' > " + proj_name + "/ooda.pkg\n" + manifest_content + "EOF";
    let r2 = sys_exec(sys, "sh", "-c", w1_cmd);
    if !r2.is_ok() {
        return Err("E_INIT: failed to write ooda.pkg");
    }

    let w2_cmd: String = "cat <<'EOF' > " + proj_name + "/src/main.oo\n" + main_content + "EOF";
    let r3 = sys_exec(sys, "sh", "-c", w2_cmd);
    if !r3.is_ok() {
        return Err("E_INIT: failed to write main.oo");
    }

    let w3_cmd: String = "cat <<'EOF' > " + proj_name + "/tests/test_main.oo\n" + test_content + "EOF";
    let r4 = sys_exec(sys, "sh", "-c", w3_cmd);
    if !r4.is_ok() {
        return Err("E_INIT: failed to write test_main.oo");
    }

    let w4_cmd: String = "cat <<'EOF' > " + proj_name + "/.cursorrules\n" + cursor_content + "EOF";
    let r5 = sys_exec(sys, "sh", "-c", w4_cmd);
    if !r5.is_ok() {
        return Err("E_INIT: failed to write .cursorrules");
    }

    let w5_cmd: String = "cat <<'EOF' > " + proj_name + "/CLAUDE.md\n" + claude_content + "EOF";
    let r6 = sys_exec(sys, "sh", "-c", w5_cmd);
    if !r6.is_ok() {
        return Err("E_INIT: failed to write CLAUDE.md");
    }

    let w6_cmd: String = "cat <<'EOF' > " + proj_name + "/.windsurfrules\n" + windsurf_content + "EOF";
    let r7 = sys_exec(sys, "sh", "-c", w6_cmd);
    if !r7.is_ok() {
        return Err("E_INIT: failed to write .windsurfrules");
    }

    let w7_cmd: String = "cat <<'EOF' > " + proj_name + "/AGENTS.oot\n" + agents_content + "EOF";
    let r8 = sys_exec(sys, "sh", "-c", w7_cmd);
    if !r8.is_ok() {
        return Err("E_INIT: failed to write AGENTS.oot");
    }

    return Ok("Created OODA project '" + proj_name + "' successfully.");
}
