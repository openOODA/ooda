// # Project Initialization and Scaffolding Handler
//
// Logline: Scaffolds standard OODA package layouts with ooda.pkg manifests and test suites.
//
// Setup: Creates src/main.oo, tests/test_main.oo, and ooda.pkg under SysCap.
//
// Beats:
//   1. Resolve project name and create project directories.
//   2. Generate ooda.pkg key=value name, version, deps, and caps.
//   3. Generate starter main.oo and test_main.oo.
// RULES.oot 1.4: Requires &SysCap for file creation.
// RULES.oot 1.7: Under 256 lines.


pub fn cli_init_project(sys: &SysCap, proj_name: String) -> Result[String, String] {
    if chars_len(proj_name) == 0 {
        return Err("E_INIT: missing project name");
    }

    let manifest_content: String = "name=" + proj_name + "\nversion=0.1.0\nmin_pin=v0.209.0\ndeps=\ncaps=FsRead\n";
    let main_content: String = "// # Main Entry Point for " + proj_name + "\n// Logline: Starter application for " + proj_name + ".\n\npub fn main(sys: &SysCap) {\n    println(\"Hello from " + proj_name + "!\");\n}\n";
    let test_content: String = "// # Test Suite for " + proj_name + "\n// Logline: Basic test suite.\n\npub fn test_basic_addition() -> Bool {\n    return 2 + 2 == 4;\n}\n\npub fn main() {\n    if !test_basic_addition() {\n        println(\"FAIL: basic test\");\n        process_exit(1);\n    }\n    println(\"OK: ALL_TESTS_PASSED\");\n}\n";

    let mkdir_cmd: String = "mkdir -p " + proj_name + "/src " + proj_name + "/tests";
    let r1 = sys_exec(sys, "sh", "-c", mkdir_cmd);
    if !r1.is_ok() {
        return Err("E_INIT: failed to create directories");
    }

    let w1_cmd: String = "cat <<'EOF' > " + proj_name + "/ooda.pkg\n" + manifest_content + "EOF";
    let r2 = sys_exec(sys, "sh", "-c", w1_cmd);
    if !r2.is_ok() {
        return Err("E_INIT: failed to write ooda.pkg");
    }

    let w2_cmd: String = "cat <<'EOF' > " + proj_name + "/src/main.oo\n" + main_content + "EOF";
    let r3 = sys_exec(sys, "sh", "-c", w2_cmd);
    if !r3.is_ok() {
        return Err("E_INIT: failed to write main.oo");
    }

    let w3_cmd: String = "cat <<'EOF' > " + proj_name + "/tests/test_main.oo\n" + test_content + "EOF";
    let r4 = sys_exec(sys, "sh", "-c", w3_cmd);
    if !r4.is_ok() {
        return Err("E_INIT: failed to write test_main.oo");
    }

    return Ok("Created OODA project '" + proj_name + "' successfully.");
}
