// # List .oo files for ooda context
//
// Logline: Print the count and names of .oo files in cwd or a given path.
//
// Setup: FsCap walks the path. SysCap can list via ls when the dir walk is empty.
//
// Beats:
//   1. Take an optional path after the command, else use cwd.
//   2. Count .oo names in that path.
//   3. Print the count then each name and return.

import "host_run.oo";

fn is_oo_name(name: String) -> Bool {
    return str_ends_with(name, ".oo");
}

fn oo_names_in(fs: &FsCap, dir: String) -> String {
    if is_oo_name(dir) {
        if path_exists(fs, dir) {
            return dir + "\n";
        }
    }
    let entries: List[String] = oo_fs_read_dir(fs, dir);
    let n: Int = list_len(entries);
    let mut acc: String = "";
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(entries, i);
        if is_oo_name(name) {
            acc = acc + name + "\n";
        }
        i = i + 1;
    }
    return acc;
}

fn ls_oo_names(fs: &FsCap, sys: &SysCap, dir: String) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/ctx-list.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; ls -1 " + sq(dir) + " > " + sq(outp) + " 2>/dev/null; exit 0";
    let ign: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if ign.is_err() {
        return "";
    }
    let ro: Result[String, String] = read_file(fs, outp);
    if !ro.is_ok() {
        return "";
    }
    let text: String = match ro { Ok(s) => s, Err(m) => m };
    return oo_filter_text(text);
}

fn oo_filter_text(text: String) -> String {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut start: Int = 0;
    let mut acc: String = "";
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if is_oo_name(line) {
                    acc = acc + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

fn count_nl(text: String) -> Int {
    let n: Int = chars_len(text);
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(text, i) == "\n" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

fn print_nl_names(text: String) {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                println(str_slice(text, start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

pub fn run_ooda_context(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut dir: String = ".";
    if list_len(args) >= 2 {
        let a: String = list_get(args, 1);
        if str_slice(a, 0, 1) != "-" {
            dir = a;
        }
    }
    if chars_len(dir) == 0 {
        dir = ".";
    }
    let mut names: String = oo_names_in(fs, dir);
    if names == "" {
        names = ls_oo_names(fs, sys, dir);
    }
    let n: Int = count_nl(names);
    println("ooda context: " + n.to_string());
    print_nl_names(names);
}
