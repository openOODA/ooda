// # File-backed catalog resolve
//
// Logline: Pick SemVer from a name|version|caps|deps catalog. No HTTP registry.
//
// Setup: Imports pm_core. Missing name and cap escalation fail closed.
//
// Beats:
//   1. Parse catalog lines and pick the highest satisfying version.
//   2. Resolve a root and one dep.
//   3. Read key=value manifest fields.

import "pm_caps.oo";
import "pm_core.oo";

fn pm_line_field(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(line, i) == "|" {
            if field == idx {
                return str_slice(line, start, i);
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn pm_find_best(catalog: String, name: String, spec: String) -> String {
    let n: Int = chars_len(catalog);
    let mut best: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(catalog, i) == "\n" {
            if i > start {
                let line: String = str_slice(catalog, start, i);
                let nm: String = pm_line_field(line, 0);
                let ver: String = pm_line_field(line, 1);
                if nm == name {
                    if pm_semver_sat(ver, spec) {
                        if best == "" {
                            best = line;
                        } else {
                            if pm_semver_cmp(ver, pm_line_field(best, 1)) == 1 {
                                best = line;
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return best;
}

pub fn pm_resolve(catalog: String, name: String, parent_caps: Int) -> String {
    if !pm_name_ok(name) {
        return "err name";
    }
    let root: String = pm_find_best(catalog, name, "*");
    if root == "" {
        return "err missing";
    }
    let rcaps: Int = pm_int(pm_line_field(root, 2));
    if !pm_caps_ok(parent_caps, rcaps) {
        return "err caps";
    }
    let mut out: String = name + "@" + pm_line_field(root, 1);
    let deps: String = pm_line_field(root, 3);
    if deps != "" {
        let at: Int = str_index_of(deps, "@");
        let hash: Int = str_index_of(deps, "#");
        if at < 1 {
            return "err dep";
        }
        let dname: String = str_slice(deps, 0, at);
        let mut dend: Int = chars_len(deps);
        if hash > at {
            dend = hash;
        }
        let dspec: String = str_slice(deps, at + 1, dend);
        let mut dgrant: Int = parent_caps;
        if hash > at {
            dgrant = pm_int(str_slice(deps, hash + 1, chars_len(deps)));
        }
        if !pm_name_ok(dname) {
            return "err name";
        }
        if !pm_caps_ok(parent_caps, dgrant) {
            return "err caps";
        }
        let dline: String = pm_find_best(catalog, dname, dspec);
        if dline == "" {
            return "err missing";
        }
        let dcaps: Int = pm_int(pm_line_field(dline, 2));
        if !pm_caps_ok(dgrant, dcaps) {
            return "err caps";
        }
        out = out + " " + dname + "@" + pm_line_field(dline, 1);
    }
    return "ok " + out;
}

pub fn pm_kv(text: String, key: String) -> String {
    let pat: String = key + "=";
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            let line: String = str_slice(text, start, i);
            if chars_len(line) >= chars_len(pat) {
                if str_slice(line, 0, chars_len(pat)) == pat {
                    return str_slice(line, chars_len(pat), chars_len(line));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}
