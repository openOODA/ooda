// # Transitive file-backed catalog resolve
//
// Logline: Walk deps, pick SemVer, refuse extra caps, missing names, and version conflicts.
//
// Setup: Catalog lines name|version|caps|deps|sha. No HTTP.
//
// Beats:
//   1. Resolve a root and every transitive dep.
//   2. Diamond: one world node. Conflict if two versions of one name.
//   3. path:name deps use a catalog row with that name.

import "pm_core.oo";
import "pm_caps.oo";

pub fn pm_line_field(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(line, i) == "|" {
            if field == idx {
                return str_slice(line, start, i);
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn pm_kv(text: String, key: String) -> String {
    let pat: String = key + "=";
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            let line: String = str_slice(text, start, i);
            if chars_len(line) >= chars_len(pat) {
                if str_slice(line, 0, chars_len(pat)) == pat {
                    return str_slice(line, chars_len(pat), chars_len(line));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn pm_find_best(catalog: String, name: String, spec: String) -> String {
    let n: Int = chars_len(catalog);
    let mut best: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(catalog, i) == "\n" {
            if i > start {
                let line: String = str_slice(catalog, start, i);
                if pm_line_field(line, 0) == name {
                    let ver: String = pm_line_field(line, 1);
                    if pm_semver_sat(ver, spec) {
                        if best == "" {
                            best = line;
                        } else {
                            if pm_semver_cmp(ver, pm_line_field(best, 1)) == 1 {
                                best = line;
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return best;
}

fn pm_locked_ver(lock: String, name: String) -> String {
    let n: Int = chars_len(lock);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(lock, i) == "\n" {
            if i > start {
                let line: String = str_slice(lock, start, i);
                let at: Int = str_index_of(line, "@");
                if at > 0 {
                    if str_slice(line, 0, at) == name {
                        let rest: String = str_slice(line, at + 1, chars_len(line));
                        let h: Int = str_index_of(rest, "#");
                        if h >= 0 {
                            return str_slice(rest, 0, h);
                        }
                        return rest;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn pm_push_deps(q: String, deps: String) -> String {
    if deps == "" {
        return q;
    }
    let n: Int = chars_len(deps);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut out: String = q;
    while i <= n {
        if i == n || char_at(deps, i) == "," {
            if i > start {
                let one: String = str_slice(deps, start, i);
                let mut nm: String = one;
                if str_slice(one, 0, 5) == "path:" {
                    nm = str_slice(one, 5, chars_len(one));
                } else {
                    let at: Int = str_index_of(one, "@");
                    if at > 0 {
                        nm = str_slice(one, 0, at);
                    }
                }
                out = out + nm + "\n";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn pm_resolve(catalog: String, name: String, parent_caps: Int) -> String {
    if !pm_name_ok(name) {
        return "err name";
    }
    let mut q: String = name + "\n";
    let mut lock: String = "";
    let mut steps: Int = 0;
    while steps < 32 {
        if q == "" {
            return "ok " + lock;
        }
        let nl: Int = str_index_of(q, "\n");
        let mut cur: String = q;
        if nl >= 0 {
            cur = str_slice(q, 0, nl);
            q = str_slice(q, nl + 1, chars_len(q));
        } else {
            q = "";
        }
        if cur != "" {
            if !pm_name_ok(cur) {
                return "err name";
            }
            let have: String = pm_locked_ver(lock, cur);
            let line: String = pm_find_best(catalog, cur, "*");
            if line == "" {
                return "err missing";
            }
            let ver: String = pm_line_field(line, 1);
            if have != "" {
                if have != ver {
                    return "err conflict";
                }
            } else {
                let mask: Int = pm_cap_parse(pm_line_field(line, 2));
                if !pm_caps_ok(parent_caps, mask) {
                    return "err caps";
                }
                let sha: String = pm_line_field(line, 4);
                lock = lock + cur + "@" + ver + "#" + sha + "#" + pm_cap_name(mask) + "\n";
                q = pm_push_deps(q, pm_line_field(line, 3));
            }
        }
        steps = steps + 1;
    }
    return "err depth";
}

pub fn pm_resolve_many(catalog: String, names: String, parent_caps: Int) -> String {
    let n: Int = chars_len(names);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut acc: String = "";
    let mut first: Bool = true;
    while i <= n {
        if i == n || char_at(names, i) == "," {
            if i > start {
                let one: String = str_slice(names, start, i);
                let r: String = pm_resolve(catalog, one, parent_caps);
                if str_slice(r, 0, 3) != "ok " {
                    return r;
                }
                let body: String = str_slice(r, 3, chars_len(r));
                if first {
                    acc = body;
                    first = false;
                } else {
                    acc = acc + body;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "ok " + acc;
}
