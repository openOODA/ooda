// # Add a local module into cwd
//
// Logline: Copy or write a named local module path into the current directory.
//
// Setup: SysCap copies or writes. No args prints usage and returns.
//
// Beats:
//   1. Print usage when no module path is given.
//   2. Copy an existing local file into cwd under its basename.
//   3. Else write a small local .oo leaf with that name.

import "host_run.oo";

fn add_base(p: String) -> String {
    let n: Int = chars_len(p);
    let mut i: Int = n;
    while i > 0 {
        if char_at(p, i - 1) == "/" {
            return str_slice(p, i, n);
        }
        i = i - 1;
    }
    return p;
}

fn add_dest(p: String) -> String {
    let b: String = add_base(p);
    if b == "" {
        return "added.oo";
    }
    if str_ends_with(b, ".oo") {
        return b;
    }
    return b + ".oo";
}

fn add_stub(name: String) -> String {
    return "// # Local module " + name + "\n"
        + "//\n"
        + "// Logline: Local module written by ooda add.\n"
        + "//\n"
        + "// Setup: File lives in the current directory.\n"
        + "//\n"
        + "// Beats:\n"
        + "//   1. The module path is local.\n"
        + "//   2. One function exists for check.\n"
        + "//   3. No network registry.\n"
        + "\n"
        + "pub fn added_ok() -> Bool {\n"
        + "    return true;\n"
        + "}\n";
}

pub fn run_ooda_add(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut src: String = "";
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if src == "" {
                src = a;
            }
        }
        i = i + 1;
    }
    if src == "" {
        println("usage: ooda add <local-module-path>");
        return;
    }
    let dest: String = add_dest(src);
    if path_exists(fs, src) {
        if src == dest || src == "./" + dest {
            println("ooda add: already local " + dest);
            return;
        }
        let cpcmd: String = "cp " + sq(src) + " " + sq(dest);
        let cpr: Result[String, String] = sys_exec(sys, "sh", "-c", cpcmd);
        if cpr.is_ok() {
            println("ooda add: copied " + src + " -> " + dest);
            return;
        }
        let tr: Result[String, String] = read_file(fs, src);
        if tr.is_ok() {
            let body: String = match tr { Ok(s) => s, Err(m) => m };
            let wcmd: String = "printf '%s' " + sq(body) + " > " + sq(dest);
            let wr: Result[String, String] = sys_exec(sys, "sh", "-c", wcmd);
            if wr.is_ok() {
                println("ooda add: copied " + src + " -> " + dest);
                return;
            }
        }
        println("ooda add: copy failed: " + src);
        return;
    }
    let stub: String = add_stub(dest);
    let w2: String = "printf '%s' " + sq(stub) + " > " + sq(dest);
    let wr2: Result[String, String] = sys_exec(sys, "sh", "-c", w2);
    if wr2.is_ok() {
        println("ooda add: wrote " + dest);
        return;
    }
    println("ooda add: write failed: " + dest);
}
