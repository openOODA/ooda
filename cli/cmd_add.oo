// # Add a package from a file-backed vendor
//
// Logline: Install a named package through the product manager into CAS.
//
// Setup: Dispatches to cmd_pm. Vendor path, not cwd stub, not HTTP.
//
// Beats:
//   1. Require a package name.
//   2. Resolve from the local vendor.
//   3. Write CAS and lock.

import "cmd_pm.oo";

pub fn run_ooda_add(fs: &FsCap, sys: &SysCap, args: List[String]) {
    run_ooda_pm_add(fs, sys, args);
}
