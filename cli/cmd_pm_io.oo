// # Shared PM command helpers
//
// Logline: Parse argv, slurp files, split lock fields, and escape JSON.
//
// Setup: FsCap. No HTTP. No org std.
//
// Beats:
//   1. Walk flags, options, and the first package name.
//   2. Split name@version#sha#caps lock fields.
//   3. Structured ERR and JSON string escape.

pub fn pm_die(cmd: String, msg: String) {
    println("ERR\t" + cmd + "\t" + msg);
    process_exit(2);
}

pub fn pm_flag(args: List[String], name: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(args) {
        if list_get(args, i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn pm_opt(args: List[String], name: String) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        if list_get(args, i) == name {
            if i + 1 < list_len(args) {
                return list_get(args, i + 1);
            }
        }
        i = i + 1;
    }
    return "";
}

fn pm_is_verb(a: String) -> Bool {
    if a == "add" || a == "pkg" || a == "pm" { return true; }
    if a == "remove" || a == "update" || a == "outdated" { return true; }
    if a == "why" || a == "tree" || a == "vendor" || a == "clean" { return true; }
    if a == "audit" || a == "sbom" || a == "pack" || a == "ingest" || a == "launch" { return true; }
    return false;
}

pub fn pm_arg_name(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--vendor" || a == "--from" || a == "--path" || a == "--registry" {
            i = i + 2;
        } else if pm_is_verb(a) {
            i = i + 1;
        } else if str_slice(a, 0, 1) != "-" {
            return a;
        } else {
            i = i + 1;
        }
    }
    return "";
}

pub fn pm_slurp(fs: &FsCap, path: String) -> String {
    if !path_exists(fs, path) {
        return "";
    }
    let rr: Result[String, String] = read_file(fs, path);
    if !rr.is_ok() {
        return "";
    }
    return match rr { Ok(s) => s, Err(m) => m };
}

pub fn pm_is_http(s: String) -> Bool {
    if str_index_of(s, "://") >= 0 {
        return true;
    }
    return str_index_of(s, "registry.openooda.org") >= 0;
}

pub fn pm_jesc(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\n"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn pm_tok_name(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 1 {
        return tok;
    }
    return str_slice(tok, 0, at);
}

pub fn pm_tok_ver(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 1 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return rest;
    }
    return str_slice(rest, 0, h);
}

pub fn pm_tok_sha(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 0 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return "";
    }
    let after: String = str_slice(rest, h + 1, chars_len(rest));
    let h2: Int = str_index_of(after, "#");
    if h2 < 0 {
        return after;
    }
    return str_slice(after, 0, h2);
}

pub fn pm_tok_cap(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 0 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return "";
    }
    let after: String = str_slice(rest, h + 1, chars_len(rest));
    let h2: Int = str_index_of(after, "#");
    if h2 < 0 {
        return "";
    }
    return str_slice(after, h2 + 1, chars_len(after));
}

pub fn pm_place(fs: &FsCap, sys: &SysCap, path: String, body: String) -> Bool {
    let wr: Result[Void, String] = write_file(fs, path, body);
    if wr.is_ok() {
        return true;
    }
    let _s: &SysCap = sys;
    return false;
}

pub fn pm_lock_json(lock: String) -> String {
    let n: Int = chars_len(lock);
    let mut out: String = "[";
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut first: Bool = true;
    while i <= n {
        if i == n || char_at(lock, i) == "\n" {
            if i > start {
                let line: String = str_slice(lock, start, i);
                if str_index_of(line, "@") >= 1 {
                    if first == false {
                        out = out + ",";
                    }
                    first = false;
                    out = out + "{\"name\":\"" + pm_jesc(pm_tok_name(line)) + "\",\"version\":\"" + pm_jesc(pm_tok_ver(line)) + "\",\"sha\":\"" + pm_jesc(pm_tok_sha(line)) + "\",\"caps\":\"" + pm_jesc(pm_tok_cap(line)) + "\"}";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out + "]";
}
