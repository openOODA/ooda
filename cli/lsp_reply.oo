// # Native LSP method replies
//
// Logline: Build initialize, hover, documentSymbol, definition, and completion JSON-RPC results.
//
// Setup: Used by lsp_drive. Dispatch on the method string only. Read a file:// uri.
//
// Beats:
//   1. initialize advertises hover, documentSymbol, definition, and completion (`&`).
//   2. hover / definition name the identifier under the cursor.
//   3. documentSymbol lists each fn. Completion is lsp_complete_result.

import "lsp_ident.oo";
import "lsp_complete.oo";

fn lsp_json_id(body: String) -> String {
    let key: String = "\"id\":";
    let at: Int = str_index_of(body, key);
    if at < 0 {
        return "1";
    }
    let n: Int = chars_len(body);
    let mut i: Int = at + chars_len(key);
    while i < n {
        let c: String = char_at(body, i);
        if c == " " {
            i = i + 1;
        } else {
            break;
        }
    }
    let start: Int = i;
    while i < n {
        let c2: String = char_at(body, i);
        if c2 == "0" || c2 == "1" || c2 == "2" || c2 == "3" || c2 == "4" || c2 == "5" || c2 == "6" || c2 == "7" || c2 == "8" || c2 == "9" {
            i = i + 1;
        } else {
            break;
        }
    }
    if i <= start {
        return "1";
    }
    return str_slice(body, start, i);
}

pub fn lsp_method(body: String) -> String {
    let key: String = "\"method\":\"";
    let at: Int = str_index_of(body, key);
    if at < 0 {
        return "";
    }
    let start: Int = at + chars_len(key);
    let n: Int = chars_len(body);
    let mut i: Int = start;
    while i < n {
        if char_at(body, i) == "\"" {
            return str_slice(body, start, i);
        }
        i = i + 1;
    }
    return "";
}

fn lsp_file_uri_path(body: String) -> String {
    let key: String = "file://";
    let at: Int = str_index_of(body, key);
    if at < 0 {
        return "";
    }
    let n: Int = chars_len(body);
    let start: Int = at + chars_len(key);
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(body, i);
        if c == "\"" {
            return str_slice(body, start, i);
        }
        i = i + 1;
    }
    return "";
}

fn lsp_next_fn(src: String, from: Int) -> Int {
    let key: String = "fn ";
    let tail: String = str_slice(src, from, chars_len(src));
    let at: Int = str_index_of(tail, key);
    if at < 0 {
        return 0 - 1;
    }
    return from + at;
}

fn lsp_fn_name_at(src: String, fn_at: Int) -> String {
    let n: Int = chars_len(src);
    let mut i: Int = fn_at + 3;
    while i < n {
        let c: String = char_at(src, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    let start: Int = i;
    while i < n {
        let c2: String = char_at(src, i);
        if c2 == "(" || c2 == " " || c2 == "\t" || c2 == "\n" {
            break;
        }
        i = i + 1;
    }
    if i <= start {
        return "main";
    }
    return str_slice(src, start, i);
}

fn lsp_first_fn(src: String) -> String {
    let at: Int = lsp_next_fn(src, 0);
    if at < 0 {
        return "main";
    }
    return lsp_fn_name_at(src, at);
}

fn lsp_load_src(fs: &FsCap, body: String) -> String {
    let p: String = lsp_file_uri_path(body);
    if p == "" {
        return "pub fn main() {\n}\n";
    }
    if !path_exists(fs, p) {
        return "pub fn main() {\n}\n";
    }
    let rr: Result[String, String] = read_file(fs, p);
    if !rr.is_ok() {
        return "pub fn main() {\n}\n";
    }
    return match rr { Ok(s) => s, Err(m) => m };
}

fn lsp_symbol_json(name: String) -> String {
    return "{\"name\":\"" + name + "\",\"kind\":12,\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"selectionRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}}";
}

fn lsp_ok(id: String, result: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}";
}

pub fn lsp_build_reply(fs: &FsCap, body: String) -> String {
    let method: String = lsp_method(body);
    let id: String = lsp_json_id(body);
    if method == "initialize" {
        let caps: String = "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"documentSymbolProvider\":true,\"definitionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\"&\"]}}}";
        return lsp_ok(id, caps);
    }
    if method == "textDocument/hover" {
        let src: String = lsp_load_src(fs, body);
        let line: Int = lsp_json_int(body, "\"line\":");
        let col: Int = lsp_json_int(body, "\"character\":");
        let mut name: String = lsp_ident_at(src, lsp_src_offset(src, line, col));
        if name == "" {
            name = lsp_first_fn(src);
        }
        let mut val: String = name;
        if lsp_fn_pos(src, name) >= 0 {
            val = "fn " + name;
        }
        return lsp_ok(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + val + "\"}}");
    }
    if method == "textDocument/documentSymbol" {
        let src2: String = lsp_load_src(fs, body);
        let mut items: String = "";
        let mut pos: Int = 0;
        let mut nsym: Int = 0;
        while nsym < 32 {
            let at: Int = lsp_next_fn(src2, pos);
            if at < 0 {
                nsym = 32;
            } else {
                let nm2: String = lsp_fn_name_at(src2, at);
                if items != "" {
                    items = items + ",";
                }
                items = items + lsp_symbol_json(nm2);
                pos = at + 3;
                nsym = nsym + 1;
            }
        }
        if items == "" {
            items = lsp_symbol_json("main");
        }
        return lsp_ok(id, "[" + items + "]");
    }
    if method == "textDocument/definition" {
        let src3: String = lsp_load_src(fs, body);
        let uri: String = lsp_file_uri_path(body);
        let mut u: String = "file:///ooda.oo";
        if uri != "" {
            u = "file://" + uri;
        }
        let line2: Int = lsp_json_int(body, "\"line\":");
        let col2: Int = lsp_json_int(body, "\"character\":");
        let want: String = lsp_ident_at(src3, lsp_src_offset(src3, line2, col2));
        let mut at: Int = lsp_fn_pos(src3, want);
        if at < 0 {
            at = lsp_fn_pos(src3, lsp_first_fn(src3));
        }
        let mut sl: Int = 0;
        let mut sc: Int = 0;
        if at >= 0 {
            sl = lsp_line_at(src3, at);
            sc = lsp_col_at(src3, at);
        }
        let ec: Int = sc + 2;
        return lsp_ok(id, "{\"uri\":\"" + u + "\",\"range\":{\"start\":{\"line\":" + sl.to_string() + ",\"character\":" + sc.to_string() + "},\"end\":{\"line\":" + sl.to_string() + ",\"character\":" + ec.to_string() + "}}}");
    }
    if method == "textDocument/completion" {
        return lsp_ok(id, lsp_complete_result(fs, body));
    }
    if method == "shutdown" {
        return lsp_ok(id, "null");
    }
    return "";
}
