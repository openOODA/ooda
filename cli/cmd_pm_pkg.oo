// # Inventory installed CAS packages
//
// Logline: Print the lock inventory. Never list cwd test_*.oo files.
//
// Setup: Reads .ooda_modules/lock. Not a live registry.
//
// Beats:
//   1. Print ooda pkg: cas then lock lines.
//   2. Empty lock prints ooda pkg: empty.
//   3. --json prints a packages array.

import "cmd_pm_cat.oo";
import "cmd_pm_io.oo";
import "pm_store.oo";

pub fn run_ooda_pm_pkg(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let root: String = pm_root_abs(fs, sys);
    let a: String = pm_slurp(fs, root + "/.ooda_modules/lock");
    let b: String = pm_slurp(fs, ".ooda_modules/lock");
    let lk: String = pm_first_nonempty(a, b);
    if pm_flag(args, "--json") || pm_flag(args, "-json") {
        println("{\"ok\":true,\"cmd\":\"pkg\",\"packages\":" + pm_lock_json(lk) + "}");
        return;
    }
    println("ooda pkg: cas");
    if lk == "" {
        println("ooda pkg: empty");
        return;
    }
    println(lk);
}
