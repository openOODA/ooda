// # File-backed product package commands
//
// Logline: Install and inventory named packages through PM CAS and lock.
//
// Setup: Default vendor is ../registry. No HTTP. Imports pm_resolve.
//
// Beats:
//   1. Load vendor manifests into a catalog.
//   2. Resolve, write .ooda_modules/cas/<sha256>/, write lock.
//   3. Inventory the lock. Refuse traversal names.

import "host_run.oo";
import "pm_resolve.oo";

fn pm_write(sys: &SysCap, path: String, body: String) -> Bool {
    let cmd: String = "mkdir -p $(dirname " + sq(path) + "); printf '%s' " + sq(body) + " > " + sq(path);
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    return r.is_ok();
}

fn pm_slurp(fs: &FsCap, path: String) -> String {
    if !path_exists(fs, path) {
        return "";
    }
    let rr: Result[String, String] = read_file(fs, path);
    if !rr.is_ok() {
        return "";
    }
    return match rr { Ok(s) => s, Err(m) => m };
}

fn pm_is_http(s: String) -> Bool {
    return str_index_of(s, "://") >= 0 || str_index_of(s, "registry.openooda.org") >= 0;
}

fn pm_pick_vendor(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--vendor" {
            if i + 1 < n { return list_get(args, i + 1); }
            return "";
        }
        i = i + 1;
    }
    return "../registry";
}

fn pm_pkg_name(args: List[String]) -> String {
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--vendor" {
            i = i + 2;
        } else if a == "add" || a == "pkg" || a == "pm" {
            i = i + 1;
        } else if str_slice(a, 0, 1) != "-" {
            return a;
        } else {
            i = i + 1;
        }
    }
    return "";
}

fn pm_refuse_net(args: List[String]) -> Bool {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--registry" {
            return true;
        }
        if str_index_of(a, "--registry=") >= 0 {
            return true;
        }
        if pm_is_http(a) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn pm_load_catalog(fs: &FsCap, sys: &SysCap, vendor: String) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/pm-vendors.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; ls -1 " + sq(vendor) + " > " + sq(outp) + " 2>/dev/null; exit 0";
    let ign: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if ign.is_err() {
        return "";
    }
    let names: String = pm_slurp(fs, outp);
    let n: Int = chars_len(names);
    let mut cat: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(names, i) == "\n" {
            if i > start {
                let nm: String = str_slice(names, start, i);
                if pm_name_ok(nm) {
                    let man: String = pm_slurp(fs, vendor + "/" + nm + "/manifest");
                    if man != "" {
                        cat = cat + nm + "|" + pm_kv(man, "version") + "|" + pm_kv(man, "caps") + "|" + pm_kv(man, "deps") + "\n";
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return cat;
}

fn pm_install_one(fs: &FsCap, sys: &SysCap, vendor: String, name: String) -> String {
    if !pm_name_ok(name) {
        return "";
    }
    let man: String = pm_slurp(fs, vendor + "/" + name + "/manifest");
    if man == "" {
        return "";
    }
    let mut payload_name: String = pm_kv(man, "payload");
    if payload_name == "" {
        payload_name = name + ".oo";
    }
    if !pm_name_ok(payload_name) {
        return "";
    }
    let body: String = pm_slurp(fs, vendor + "/" + name + "/" + payload_name);
    if body == "" {
        return "";
    }
    let sha: String = pm_cas_id(body);
    if chars_len(sha) != 64 {
        return "";
    }
    if !pm_write(sys, ".ooda_modules/cas/" + sha + "/" + payload_name, body) {
        return "";
    }
    return sha;
}

pub fn run_ooda_pm_add(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if pm_refuse_net(args) {
        println("ooda add: file vendor required");
        process_exit(2);
    }
    let name: String = pm_pkg_name(args);
    if name == "" {
        println("usage: ooda add <name> [--vendor path]");
        process_exit(2);
    }
    if !pm_name_ok(name) {
        println("ooda add: refuse name");
        process_exit(2);
    }
    let vendor: String = pm_pick_vendor(args);
    if vendor == "" || pm_is_http(vendor) {
        println("ooda add: file vendor required");
        process_exit(2);
    }
    if !path_exists(fs, vendor) {
        println("ooda add: missing vendor");
        process_exit(2);
    }
    let cat: String = pm_load_catalog(fs, sys, vendor);
    let res: String = pm_resolve(cat, name, 1);
    if str_slice(res, 0, 3) != "ok " {
        println("ooda add: " + res);
        process_exit(2);
    }
    let rest: String = str_slice(res, 3, chars_len(res));
    let mut lock: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    let rn: Int = chars_len(rest);
    while i <= rn {
        if i == rn || char_at(rest, i) == " " {
            if i > start {
                let tok: String = str_slice(rest, start, i);
                let at: Int = str_index_of(tok, "@");
                let mut pname: String = tok;
                if at > 0 {
                    pname = str_slice(tok, 0, at);
                }
                let sha: String = pm_install_one(fs, sys, vendor, pname);
                if sha == "" {
                    println("ooda add: install failed " + pname);
                    process_exit(2);
                }
                lock = lock + tok + "#" + sha + "\n";
                println("ooda add: installed " + pname + " cas=" + sha);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if !pm_write(sys, ".ooda_modules/lock", lock) {
        println("ooda add: lock write failed");
        process_exit(2);
    }
}

pub fn run_ooda_pm_pkg(fs: &FsCap, sys: &SysCap, args: List[String]) {
    println("ooda pkg: cas");
    let lock: String = pm_slurp(fs, ".ooda_modules/lock");
    if lock == "" {
        println("ooda pkg: empty");
        return;
    }
    println(lock);
    if list_len(args) < 0 {
        println("ooda pkg: empty");
    }
}

pub fn run_ooda_pm(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) < 2 {
        println("usage: ooda pm add|pkg …");
        process_exit(2);
    }
    let sub: String = list_get(args, 1);
    if sub == "add" {
        run_ooda_pm_add(fs, sys, args);
        return;
    }
    if sub == "pkg" {
        run_ooda_pm_pkg(fs, sys, args);
        return;
    }
    println("ooda pm: unknown " + sub);
    process_exit(2);
}
