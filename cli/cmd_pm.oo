// # Product package-manager dispatch
//
// Logline: Route ooda pm and top-level add/pkg/remove/update/tree commands.
//
// Setup: File-backed vendor. No live registry.
//
// Beats:
//   1. Parse the subcommand from argv.
//   2. Dispatch add, pkg, remove, update, outdated, why, tree, vendor, clean.
//   3. Unknown subcommand is ERR exit 2.

import "cmd_pm_add.oo";
import "cmd_pm_pkg.oo";
import "cmd_pm_ops.oo";
import "cmd_pm_tree.oo";

fn pm_sub(args: List[String]) -> String {
    if list_len(args) < 1 {
        return "";
    }
    let a0: String = list_get(args, 0);
    if a0 == "pm" {
        if list_len(args) < 2 {
            return "";
        }
        return list_get(args, 1);
    }
    return a0;
}

pub fn run_ooda_pm(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let sub: String = pm_sub(args);
    if sub == "add" { run_ooda_pm_add(fs, sys, args); return; }
    if sub == "pkg" { run_ooda_pm_pkg(fs, sys, args); return; }
    if sub == "remove" { run_ooda_pm_remove(fs, sys, args); return; }
    if sub == "update" { run_ooda_pm_update(fs, sys, args); return; }
    if sub == "outdated" { run_ooda_pm_outdated(fs, sys, args); return; }
    if sub == "why" { run_ooda_pm_why(fs, sys, args); return; }
    if sub == "tree" { run_ooda_pm_tree(fs, sys, args); return; }
    if sub == "vendor" { run_ooda_pm_vendor(fs, sys, args); return; }
    if sub == "clean" { run_ooda_pm_clean(fs, sys, args); return; }
    println("ERR\tpm\tunknown command (add|pkg|remove|update|outdated|why|tree|vendor|clean)");
    process_exit(2);
}
