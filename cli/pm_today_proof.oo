// # Today PM unit proofs
//
// Logline: Drive shipped resolve, path deps, lock identity, caps, and HMAC.
//
// Setup: In-memory catalog hello -> mid -> world and path:side. Same-dir imports.
//
// Beats:
//   1. Transitive three-node resolve. Re-resolve is byte-identical.
//   2. path:name joins the catalog. Extra caps and traversal refuse.
//   3. Lock hash match/tamper. HMAC differs on tamper.

import "pm_core.oo";
import "pm_resolve.oo";
import "pm_sign.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let cat: String = "world|1.0.0|FsRead||w\nmid|1.0.0|FsRead|world@^1.0.0#FsRead|m\nhello|1.0.0|FsRead|mid@^1.0.0#FsRead|h\nside|1.0.0|FsRead|path:world|s\nevil|1.0.0|Net||e\n";
    let r: String = pm_resolve(cat, "hello", pm_cap_parse("FsRead"));
    if str_slice(r, 0, 3) != "ok " {
        fail("resolve " + r);
    }
    if str_index_of(r, "hello@1.0.0") < 0 { fail("hello " + r); }
    if str_index_of(r, "mid@1.0.0") < 0 { fail("mid " + r); }
    if str_index_of(r, "world@1.0.0") < 0 { fail("world " + r); }
    println("resolve " + r);
    let r2: String = pm_resolve(cat, "hello", pm_cap_parse("FsRead"));
    if r == r2 {
        println("reresolve bytes");
    } else {
        fail("reresolve " + r2);
    }
    let rp: String = pm_resolve(cat, "side", pm_cap_parse("FsRead"));
    if str_slice(rp, 0, 3) != "ok " { fail("path " + rp); }
    if str_index_of(rp, "side@1.0.0") < 0 { fail("path side"); }
    if str_index_of(rp, "world@1.0.0") < 0 { fail("path world"); }
    println("path dep " + rp);
    let ev: String = pm_resolve(cat, "evil", pm_cap_parse("FsRead"));
    if str_index_of(ev, "err caps") < 0 { fail("evil " + ev); }
    println("caps refuse");
    if !pm_name_ok("hello") { fail("name hello"); }
    if pm_name_ok("..") { fail("dotdot"); }
    if pm_name_ok("a/b") { fail("slash"); }
    println("traversal refuse");
    let acc: String = "hello@1.0.0#abc#FsRead\nmid@1.0.0#def#FsRead\nworld@1.0.0#ghi#FsRead\n";
    if pm_lock_same(acc, acc) {
        println("lock same");
    } else {
        fail("lock match");
    }
    if pm_lock_same(acc, "hello@1.0.0#EVIL#FsRead\n") { fail("lock tamper"); }
    println("lock match/tamper");
    let sig: String = pm_sign("ooda-local-pm", "hello", "1.0.0", "abc");
    if chars_len(sig) != 64 { fail("sig len"); }
    if pm_sign_ok("ooda-local-pm", "hello", "1.0.0", "EVIL", sig) { fail("sig tamper"); }
    println("sig refuse");
    let many: String = pm_resolve_many(cat, "hello,side", pm_cap_parse("FsRead"));
    if str_slice(many, 0, 3) != "ok " { fail("diamond " + many); }
    println("diamond " + many);
    println("pm_today_proof: PASSED");
}
