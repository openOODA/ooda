// # Complete SHA-256 lock lines
//
// Logline: Build sorted name@version#sha256#CapName lines and hash them with crypto_sha256_internal.
//
// Setup: Imports pkg_parse and pm_lock. SHA-256 is live. No hard-coded digest.
//
// Beats:
//   1. Form one pin as name@version#sha256#CapName.
//   2. Accept a line only when name, SemVer, 64 hex, and CapName are all present.
//   3. Sort the pins and hash the sorted text.

import "pkg_parse.oo";
import "pm_lock.oo";
import "pm_name.oo";

fn pkg_find(s: String, ch: String, from: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = from;
    while i < n {
        if char_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn pkg_hex_ok(s: String) -> Bool {
    if chars_len(s) != 64 {
        return false;
    }
    let mut i: Int = 0;
    while i < 64 {
        let c: String = char_at(s, i);
        let mut ok: Bool = false;
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { ok = true; }
        if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { ok = true; }
        if c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" { ok = true; }
        if c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" { ok = true; }
        if ok == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pkg_cap_token_ok(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n < 2 {
        return false;
    }
    let a: Int = byte_at(s, 0);
    if a < 65 {
        return false;
    }
    if a > 90 {
        return false;
    }
    let mut i: Int = 1;
    while i < n {
        let b: Int = byte_at(s, i);
        let mut ok: Bool = false;
        if b >= 65 {
            if b <= 90 { ok = true; }
        }
        if b >= 97 {
            if b <= 122 { ok = true; }
        }
        if b >= 48 {
            if b <= 57 { ok = true; }
        }
        if ok == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn pkg_lock_line(name: String, ver: String, sha: String, cap: String) -> String {
    return name + "@" + ver + "#" + sha + "#" + cap;
}

pub fn pkg_lock_name(line: String) -> String {
    let at: Int = pkg_find(line, "@", 0);
    if at < 1 {
        return "";
    }
    return str_slice(line, 0, at);
}

pub fn pkg_lock_ver(line: String) -> String {
    let at: Int = pkg_find(line, "@", 0);
    if at < 1 {
        return "";
    }
    let h1: Int = pkg_find(line, "#", at + 1);
    if h1 < 0 {
        return "";
    }
    return str_slice(line, at + 1, h1);
}

pub fn pkg_lock_sha(line: String) -> String {
    let at: Int = pkg_find(line, "@", 0);
    if at < 1 {
        return "";
    }
    let h1: Int = pkg_find(line, "#", at + 1);
    if h1 < 0 {
        return "";
    }
    let h2: Int = pkg_find(line, "#", h1 + 1);
    if h2 < 0 {
        return "";
    }
    return str_slice(line, h1 + 1, h2);
}

pub fn pkg_lock_cap(line: String) -> String {
    let at: Int = pkg_find(line, "@", 0);
    if at < 1 {
        return "";
    }
    let h1: Int = pkg_find(line, "#", at + 1);
    if h1 < 0 {
        return "";
    }
    let h2: Int = pkg_find(line, "#", h1 + 1);
    if h2 < 0 {
        return "";
    }
    return str_slice(line, h2 + 1, chars_len(line));
}

pub fn pkg_lock_complete(line: String) -> Bool {
    if line == "" {
        return false;
    }
    let name: String = pkg_lock_name(line);
    if pm_name_ok(name) == false {
        return false;
    }
    let ver: String = pkg_lock_ver(line);
    if chars_len(ver) < 5 {
        return false;
    }
    if pkg_hex_ok(pkg_lock_sha(line)) == false {
        return false;
    }
    return pkg_cap_token_ok(pkg_lock_cap(line));
}

pub fn pkg_lock_text_ok(text: String) -> Bool {
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                if pkg_lock_complete(str_slice(text, start, i)) == false {
                    return false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

pub fn pkg_lock_sort(text: String) -> String {
    return pm_lock_sort_text(text);
}

pub fn pkg_lock_digest(text: String) -> String {
    return crypto_sha256_internal(pm_lock_sort_text(text));
}

pub fn pkg_lock_match(a: String, b: String) -> Bool {
    return pkg_lock_digest(a) == pkg_lock_digest(b);
}

pub fn pkg_lock_from_pkg(text: String, sha: String) -> String {
    return pkg_lock_line(pkg_name(text), pkg_version(text), sha, pkg_cap_name(pkg_caps(text)));
}
