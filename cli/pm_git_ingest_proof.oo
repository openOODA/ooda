// # Local git ingest unit proof
//
// Logline: Drive commit= and git:name#hash pins against a local commit file.
//
// Setup: In-memory strings. Same-dir imports. No clone. No HTTP.
//
// Beats:
//   1. Matching commit= and git:name#hash return ok.
//   2. A wrong or empty pin is err git.
//   3. Non-git origin and non-git deps skip the pin.

import "pm_git_ingest.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let man: String = "name=gitfoo\norigin=git\ncommit=abc123\n";
    if pm_git_want(man) == "abc123" {
        println("want commit=");
    } else {
        fail("want commit=");
    }
    if pm_git_want("git:gitfoo#abc123") == "abc123" {
        println("want git spec");
    } else {
        fail("want git spec");
    }
    if pm_git_want("git=git:gitfoo#abc123\n") == "abc123" {
        println("want git=");
    } else {
        fail("want git=");
    }
    if pm_git_want("commit=abc123\ngit=git:gitfoo#zzzzzz\n") == "abc123" {
        println("want commit wins");
    } else {
        fail("want commit wins");
    }
    if pm_git_ingest("abc123\n", man) == "ok" {
        println("ingest commit ok");
    } else {
        fail("ingest commit ok");
    }
    if pm_git_ingest("abc123", "git:gitfoo#abc123") == "ok" {
        println("ingest spec ok");
    } else {
        fail("ingest spec ok");
    }
    if pm_git_ingest("zzz", man) == "err git" {
        println("ingest miss");
    } else {
        fail("ingest miss");
    }
    if pm_git_ingest("abc123", "") == "err git" {
        println("ingest empty");
    } else {
        fail("ingest empty");
    }
    if pm_git_origin_ingest("dir", "zzz", man) == "ok" {
        println("origin skip");
    } else {
        fail("origin skip");
    }
    if pm_git_origin_ingest("git", "zzz", man) == "err git" {
        println("origin refuse");
    } else {
        fail("origin refuse");
    }
    if pm_git_spec_check("zzz", "hello@1.0.0") == "ok" {
        println("spec skip");
    } else {
        fail("spec skip");
    }
    if pm_git_spec_check("zzz", "git:gitfoo#abc123") == "err git" {
        println("spec refuse");
    } else {
        fail("spec refuse");
    }
    if pm_git_commit_path("fixtures/pm_gitfoo") == "fixtures/pm_gitfoo/commit" {
        println("commit path");
    } else {
        fail("commit path");
    }
    if pm_git_fixture_path("gitfoo") == "fixtures/pm_gitfoo/commit" {
        println("fixture path");
    } else {
        fail("fixture path");
    }
    println("pm_git_ingest_proof: PASSED");
}
