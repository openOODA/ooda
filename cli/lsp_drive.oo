// # Native ooda lsp multi-message JSON-RPC
//
// Logline: Read framed or bare JSON-RPC requests from a file or stdin and print a framed reply for each.
//
// Setup: initialize and shutdown. Multi-message stdio loop. Not the JS bridge.
//
// Beats:
//   1. Take a request file or oo_read_stdin.
//   2. Walk Content-Length frames or JSON objects until shutdown or empty.
//   3. Print a Content-Length frame per request.

import "fix_text.oo";

fn lsp_frame(payload: String) -> String {
    return "Content-Length: " + chars_len(payload).to_string() + "\n\n" + payload;
}

fn lsp_has(s: String, needle: String) -> Bool {
    return find_sub(s, needle) >= 0;
}

fn lsp_skip_ws(s: String, i0: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = i0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
        } else {
            return i;
        }
    }
    return i;
}

fn lsp_obj_end(s: String, start: Int) -> Int {
    let n: Int = chars_len(s);
    if start >= n {
        return 0 - 1;
    }
    if char_at(s, start) != "{" {
        return 0 - 1;
    }
    let mut depth: Int = 0;
    let mut i: Int = start;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc {
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn lsp_reply(body: String) -> String {
    if lsp_has(body, "shutdown") {
        return lsp_frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}");
    }
    if lsp_has(body, "exit") {
        return "";
    }
    if lsp_has(body, "initialize") {
        let caps: String = "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true}}";
        return lsp_frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":" + caps + "}");
    }
    return "";
}

fn lsp_serve_buf(raw: String) {
    let n: Int = chars_len(raw);
    let mut i: Int = 0;
    let mut msgs: Int = 0;
    while msgs < 256 {
        i = lsp_skip_ws(raw, i);
        if i >= n {
            return;
        }
        let rest: String = str_slice(raw, i, n);
        let mut body: String = "";
        if str_starts_with(rest, "Content-Length:") {
            let lf: Int = str_index_of(rest, "\n\n");
            let crlf: Int = str_index_of(rest, "\r\n\r\n");
            let mut sep: Int = lf;
            let mut sepn: Int = 2;
            if crlf >= 0 {
                if sep < 0 || crlf < sep {
                    sep = crlf;
                    sepn = 4;
                }
            }
            if sep < 0 {
                return;
            }
            let start: Int = sep + sepn;
            let end: Int = lsp_obj_end(rest, start);
            if end < 0 {
                return;
            }
            body = str_slice(rest, start, end);
            i = i + end;
        } else {
            let end2: Int = lsp_obj_end(raw, i);
            if end2 < 0 {
                return;
            }
            body = str_slice(raw, i, end2);
            i = end2;
        }
        if chars_len(body) == 0 {
            return;
        }
        let out: String = lsp_reply(body);
        if chars_len(out) > 0 {
            println(out);
        }
        msgs = msgs + 1;
        if lsp_has(body, "shutdown") || lsp_has(body, "exit") {
            return;
        }
    }
}

pub fn run_ooda_lsp(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut path = "";
    let mut i = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    let mut raw: String = "";
    if path == "" {
        raw = oo_read_stdin();
    } else {
        if !path_exists(fs, path) {
            println("ERR\tlsp\tunreadable file: " + path);
            process_exit(2);
        }
        let rawr: Result[String, String] = read_file(fs, path);
        if !rawr.is_ok() {
            println("ERR\tlsp\tcannot read " + path);
            process_exit(1);
        }
        raw = match rawr { Ok(s) => s, Err(m) => m };
    }
    lsp_serve_buf(raw);
}
