// # Native ooda lsp multi-message JSON-RPC
//
// Logline: Reply to each framed stdin request as it arrives. Do not wait for EOF.
//
// Setup: LanguageClient writes initialize and waits. File path is batch. Not the JS bridge.
//
// Beats:
//   1. Take a request file, or read one stdin chunk at a time.
//   2. Emit a Content-Length CRLF frame per complete request.
//   3. Stop on shutdown, exit, or stdin EOF.

import "host_run.oo";
import "lsp_reply.oo";

fn lsp_skip_ws(s: String, i0: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = i0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" {
            i = i + 1;
        } else {
            let b: Int = byte_at(c, 0);
            if b == 13 {
                i = i + 1;
            } else {
                return i;
            }
        }
    }
    return i;
}

fn lsp_obj_end(s: String, start: Int) -> Int {
    let n: Int = chars_len(s);
    if start >= n {
        return 0 - 1;
    }
    if char_at(s, start) != "{" {
        return 0 - 1;
    }
    let mut depth: Int = 0;
    let mut i: Int = start;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc {
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn lsp_msg_end(buf: String) -> Int {
    let n: Int = chars_len(buf);
    let i: Int = lsp_skip_ws(buf, 0);
    if i >= n {
        return 0 - 1;
    }
    let rest: String = str_slice(buf, i, n);
    if str_starts_with(rest, "Content-Length:") {
        let start: Int = str_index_of(rest, "{");
        if start < 0 {
            return 0 - 1;
        }
        let end: Int = lsp_obj_end(rest, start);
        if end < 0 {
            return 0 - 1;
        }
        return i + end;
    }
    if char_at(buf, i) == "{" {
        return lsp_obj_end(buf, i);
    }
    return 0 - 1;
}

fn lsp_msg_body(buf: String) -> String {
    let end: Int = lsp_msg_end(buf);
    if end < 0 {
        return "";
    }
    let i: Int = lsp_skip_ws(buf, 0);
    let rest: String = str_slice(buf, i, chars_len(buf));
    if str_starts_with(rest, "Content-Length:") {
        let start: Int = str_index_of(rest, "{");
        return str_slice(rest, start, lsp_obj_end(rest, start));
    }
    return str_slice(buf, i, end);
}

fn lsp_emit(sys: &SysCap, payload: String) {
    if chars_len(payload) == 0 {
        return;
    }
    let pfile: String = ".ooda-cache/ooda-tmp/lsp_payload.json";
    let py: String = "import sys\nd=open(sys.argv[1],'rb').read()\nh=('Content-Length: %d'%len(d)).encode('ascii')+bytes([13,10,13,10])\nsys.stdout.buffer.write(h+d)\n";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; printf '%s' " + sq(payload) + " > " + pfile + "; printf '%s' " + sq(py) + " > .ooda-cache/ooda-tmp/lsp_emit; python3 .ooda-cache/ooda-tmp/lsp_emit " + pfile;
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return;
    }
}

fn lsp_read_chunk(fs: &FsCap, sys: &SysCap) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/lsp_chunk.bin";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; dd bs=65536 count=1 of=.ooda-cache/ooda-tmp/lsp_chunk.bin status=none 2>/dev/null";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return "";
    }
    if !path_exists(fs, outp) {
        return "";
    }
    let rr: Result[String, String] = read_file(fs, outp);
    if !rr.is_ok() {
        return "";
    }
    return match rr { Ok(s) => s, Err(m) => m };
}

fn lsp_is_stop(body: String) -> Bool {
    let m: String = lsp_method(body);
    return m == "shutdown" || m == "exit";
}

fn lsp_pump(fs: &FsCap, sys: &SysCap, buf0: String) -> String {
    let mut buf: String = buf0;
    let mut n: Int = 0;
    while n < 256 {
        let body: String = lsp_msg_body(buf);
        if chars_len(body) == 0 {
            return buf;
        }
        let end: Int = lsp_msg_end(buf);
        buf = str_slice(buf, end, chars_len(buf));
        lsp_emit(sys, lsp_build_reply(fs, body));
        if lsp_is_stop(body) {
            return "STOP";
        }
        n = n + 1;
    }
    return buf;
}

fn lsp_serve_stdio(fs: &FsCap, sys: &SysCap) {
    let mut buf: String = "";
    let mut n: Int = 0;
    while n < 256 {
        buf = lsp_pump(fs, sys, buf);
        if buf == "STOP" {
            return;
        }
        let chunk: String = lsp_read_chunk(fs, sys);
        if chars_len(chunk) == 0 {
            return;
        }
        buf = buf + chunk;
        n = n + 1;
    }
}

fn lsp_serve_buf(fs: &FsCap, sys: &SysCap, raw: String) {
    let left: String = lsp_pump(fs, sys, raw);
    if left == "STOP" {
        return;
    }
}

pub fn run_ooda_lsp(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut path = "";
    let mut i = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    if path == "" {
        lsp_serve_stdio(fs, sys);
        return;
    }
    if !path_exists(fs, path) {
        println("ERR\tlsp\tunreadable file: " + path);
        process_exit(2);
    }
    let rawr: Result[String, String] = read_file(fs, path);
    if !rawr.is_ok() {
        println("ERR\tlsp\tcannot read " + path);
        process_exit(1);
    }
    let raw: String = match rawr { Ok(s) => s, Err(m) => m };
    lsp_serve_buf(fs, sys, raw);
}
