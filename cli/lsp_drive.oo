// # Native ooda lsp one-shot JSON-RPC
//
// Logline: Read one framed or bare JSON-RPC request from a file and print a framed response.
//
// Setup: initialize and shutdown only. Stdin pipes are residual. Not the JS bridge.
//
// Beats:
//   1. Require a request file path.
//   2. Dispatch initialize to capabilities and shutdown to null.
//   3. Print a Content-Length frame.

import "fix_text.oo";

fn lsp_frame(payload: String) -> String {
    return "Content-Length: " + chars_len(payload).to_string() + "\n\n" + payload;
}

fn lsp_has(s: String, needle: String) -> Bool {
    return find_sub(s, needle) >= 0;
}

pub fn run_ooda_lsp(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut path = "";
    let mut i = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    let mut raw: String = "";
    if path == "" {
        raw = oo_read_stdin();
    } else {
        if !path_exists(fs, path) {
            println("ERR\tlsp\tunreadable file: " + path);
            process_exit(2);
        }
        let rawr: Result[String, String] = read_file(fs, path);
        if !rawr.is_ok() {
            println("ERR\tlsp\tcannot read " + path);
            process_exit(1);
        }
        raw = match rawr { Ok(s) => s, Err(m) => m };
    }
    if lsp_has(raw, "shutdown") {
        let body: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}";
        println(lsp_frame(body));
        return;
    }
    if lsp_has(raw, "initialize") {
        let caps: String = "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true}}";
        let body: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":" + caps + "}";
        println(lsp_frame(body));
        return;
    }
    println("ERR\tlsp\tunsupported method");
    process_exit(1);
}
