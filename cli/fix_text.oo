// # String helpers for ooda fix
//
// Logline: Find a substring, take a slice between marks, and test identifier characters.
//
// Setup: char_at, chars_len, and str_slice are product builtins.
//
// Beats:
//   1. find_sub returns the first index or -1.
//   2. between returns the text after a start mark until an end mark.
//   3. ident helpers classify one character.

pub fn find_sub(s: String, sub: String) -> Int {
    let n = chars_len(s);
    let m = chars_len(sub);
    if m == 0 {
        return 0;
    }
    if m > n {
        return -1;
    }
    let mut i = 0;
    while i + m <= n {
        if str_slice(s, i, i + m) == sub {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn find_sub_from(s: String, sub: String, start: Int) -> Int {
    let n = chars_len(s);
    if start < 0 {
        return -1;
    }
    if start >= n {
        return -1;
    }
    let tail: String = str_slice(s, start, n);
    let at: Int = find_sub(tail, sub);
    if at < 0 {
        return -1;
    }
    return start + at;
}

pub fn between(s: String, left: String, right: String) -> String {
    let a: Int = find_sub(s, left);
    if a < 0 {
        return "";
    }
    let start = a + chars_len(left);
    let b: Int = find_sub_from(s, right, start);
    if b < 0 {
        return "";
    }
    return str_slice(s, start, b);
}

fn is_letter(c: String) -> Bool {
    return char_is_alpha(c);
}

pub fn is_ident_start(c: String) -> Bool {
    if is_letter(c) {
        return true;
    }
    if c == "_" {
        return true;
    }
    return false;
}

pub fn is_ident_char(c: String) -> Bool {
    if is_ident_start(c) {
        return true;
    }
    if char_is_digit(c) {
        return true;
    }
    return false;
}

pub fn skip_ws(s: String, pos: Int) -> Int {
    let n = chars_len(s);
    let mut i = pos;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
        } else {
            break;
        }
    }
    return i;
}

pub fn read_ident(s: String, pos: Int) -> String {
    let n = chars_len(s);
    if pos < 0 || pos >= n {
        return "";
    }
    if !is_ident_start(char_at(s, pos)) {
        return "";
    }
    let mut i = pos + 1;
    while i < n {
        if is_ident_char(char_at(s, i)) {
            i = i + 1;
        } else {
            break;
        }
    }
    return str_slice(s, pos, i);
}

pub fn line_start_at(s: String, line_no: Int) -> Int {
    if line_no <= 1 {
        return 0;
    }
    let n = chars_len(s);
    let mut line = 1;
    let mut i = 0;
    while i < n {
        if char_at(s, i) == "\n" {
            line = line + 1;
            if line == line_no {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

pub fn is_ident_name(s: String) -> Bool {
    let n = chars_len(s);
    if n < 1 { return false; }
    if !is_ident_start(char_at(s, 0)) { return false; }
    let mut i = 1;
    while i < n {
        if !is_ident_char(char_at(s, i)) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn path_bad(p: String) -> Bool {
    if p == "" { return true; }
    if str_slice(p, 0, 1) == "/" { return true; }
    if find_sub(p, "..") >= 0 { return true; }
    return false;
}

pub fn path_policy(p: String) -> Bool {
    if find_sub(p, "/.config/ooda/") >= 0 { return true; }
    if find_sub(p, "SOUL.md") >= 0 { return true; }
    if find_sub(p, "soul.md") >= 0 { return true; }
    if find_sub(p, ".bashrc") >= 0 { return true; }
    if find_sub(p, "ooda.lock") >= 0 { return true; }
    if find_sub(p, ".agent.pin") >= 0 { return true; }
    return false;
}

pub fn write_src(fs: &FsCap, sys: &SysCap, path: String, next: String) {
    let cwp: String = ".ooda-cache/ooda-tmp/ooda-cwd.txt";
    let mk: String = "mkdir -p .ooda-cache/ooda-tmp && pwd > .ooda-cache/ooda-tmp/ooda-cwd.txt";
    let pr: Result[String, String] = sys_exec(sys, "sh", "-c", mk);
    if pr.is_err() {
        println("ERR\tfix\tcannot resolve cwd for write_file");
        process_exit(1);
    }
    let rr: Result[String, String] = read_file(fs, cwp);
    if rr.is_err() {
        println("ERR\tfix\tcannot read cwd for write_file");
        process_exit(1);
    }
    let mut cwd: String = match rr { Ok(s) => s, Err(m) => m };
    let cn = chars_len(cwd);
    if cn > 0 {
        if char_at(cwd, cn - 1) == "\n" {
            cwd = str_slice(cwd, 0, cn - 1);
        }
    }
    if cwd == "" {
        println("ERR\tfix\tempty cwd for write_file");
        process_exit(1);
    }
    if path_policy(path) {
        println("ERR\tfix\tpolicy path");
        process_exit(2);
    }
    let abs: String = cwd + "/" + path;
    let wr = write_file(fs, abs, next);
    if wr.is_err() {
        println("ERR\tfix\twrite_file denied (set OODA_FS_WRITEDIR to an absolute dir that contains the file)");
        process_exit(1);
    }
}

pub fn log_stem(p: String) -> String {
    let n = chars_len(p);
    let mut i = 0;
    let mut out = ".ooda-cache/ooda-tmp/fix-";
    while i < n {
        let c: String = char_at(p, i);
        if c == "/" || c == "." {
            out = out + "_";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}
