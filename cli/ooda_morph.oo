// # Standalone Metamorphic AST Morpher CLI Entry Point
//
// Logline: Command-line driver for the Zero-Trust Metamorphic AST Morpher in openOODA.
//
// Setup: Dispatches morphing passes under Zero-Trust capabilities and outputs obfuscation telemetry.
//
// Beats:
//   1. Parse arguments for seed, flattening, opaque predicates, and capability enforcement.
//   2. Execute full AST morpher pipeline across function blocks and bytecode streams.
//   3. Output deterministic metamorphic entropy metrics and verification status.

import "std/security_defense/morph_cli.oo";

pub fn run_ooda_morph(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let _fs: &FsCap = fs;
    let _sys: &SysCap = sys;
    let exit_code: Int = morph_cli_execute(args);
    if exit_code != 0 {
        process_exit(exit_code);
    }
}

pub fn main() {
    let empty_args: List[String] = list_new();
    let code: Int = morph_cli_execute(empty_args);
    if code != 0 {
        process_exit(code);
    }
}
