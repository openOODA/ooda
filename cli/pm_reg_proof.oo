// # Registry origin and index proofs
//
// Logline: Drive shipped pm_reg_origin_ok, rel_ok, and index HMAC.
//
// Setup: Reads local vendor index under FsCap. No HTTP required.
//
// Beats:
//   1. Default origin allows. http and lookalikes deny.
//   2. Relative paths refuse .. and absolute names.
//   3. Local index verifies; tamper does not.

import "pm_index.oo";
import "pm_reg.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn slurp(fs: &FsCap, path: String) -> String {
    if !path_exists(fs, path) {
        return "";
    }
    let rr: Result[String, String] = read_file(fs, path);
    if !rr.is_ok() {
        return "";
    }
    return match rr { Ok(s) => s, Err(m) => m };
}

pub fn main(fs: &FsCap) {
    if !pm_reg_origin_ok(pm_reg_default()) { fail("default"); }
    if !pm_reg_origin_ok("https://registry.openooda.org/") { fail("slash"); }
    if pm_reg_origin_ok("http://registry.openooda.org") { fail("http"); }
    if pm_reg_origin_ok("https://registry.openooda.org.evil") { fail("dotevil"); }
    if pm_reg_origin_ok("https://evil.example/registry.openooda.org") { fail("embed"); }
    if pm_reg_origin_ok("https://registry.openooda.org/x") { fail("path"); }
    if pm_reg_origin_ok("https://notregistry.openooda.org") { fail("not"); }
    println("origin");
    if !pm_reg_rel_ok("hello/manifest") { fail("rel"); }
    if pm_reg_rel_ok("../evil") { fail("dotdot"); }
    if pm_reg_rel_ok("/abs") { fail("abs"); }
    if pm_reg_rel_ok("https://x") { fail("relurl"); }
    println("rel");
    let idx: String = slurp(fs, "../registry/index");
    let sig: String = slurp(fs, "../registry/index.sig");
    if !pm_index_ok(idx, sig) { fail("index"); }
    if pm_index_ok(idx + "x", sig) { fail("tamper"); }
    println("index");
    println("pm_reg_proof: PASSED");
}
