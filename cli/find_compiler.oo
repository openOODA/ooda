// # Find oodac and the source root
//
// Logline: Probe tree and XDG paths for a real compiler, never the product CLI.
//
// Setup: FsCap sees files. A copy of bin/ooda onto oodac/oodac is a fork bomb.
//
// Beats:
//   1. Reject basename ooda.
//   2. Probe checkout paths then XDG ~/.local/bin and ~/.local/share/ooda.
//   3. Map an installed oodac path to OODA_HOME for runtime/std.

fn take_compiler(fs: &FsCap, path: String) -> String {
    if !path_exists(fs, path) { return ""; }
    let n: Int = chars_len(path);
    if n >= 4 && str_slice(path, n - 4, n) == "ooda" {
        if n == 4 { return ""; }
        if str_slice(path, n - 5, n - 4) == "/" { return ""; }
    }
    return path;
}

fn ooda_key_path(fs: &FsCap, sys: &SysCap, key: String, tail: String) -> String {
    let out: String = "/tmp/ooda_key_path.txt";
    let cmd: String = "test -n \"$" + key + "\" && printf %s \"$" + key + tail + "\" > " + out;
    if sys_exec(sys, "sh", "-c", cmd).is_err() {
        return "";
    }
    let g: Result[String, String] = read_file(fs, out);
    if g.is_ok() {
        return match g { Ok(s) => s, Err(_) => "" };
    }
    return "";
}

pub fn find_oodac(fs: &FsCap, sys: &SysCap) -> String {
    let mut p: String = "";
    p = take_compiler(fs, "./oodac_bin");
    if p == "" { p = take_compiler(fs, "oodac_bin"); }
    if p == "" { p = take_compiler(fs, "./bootstrap/seed/oodac"); }
    if p == "" { p = take_compiler(fs, "bootstrap/seed/oodac"); }
    if p == "" { p = take_compiler(fs, "./oodac/oodac"); }
    if p == "" { p = take_compiler(fs, "oodac/oodac"); }
    if p == "" { p = take_compiler(fs, "ooda/oodac/oodac"); }
    if p == "" { p = take_compiler(fs, "../oodac/oodac"); }
    if p == "" { p = take_compiler(fs, "../ooda/oodac/oodac"); }
    if p == "" { p = take_compiler(fs, ooda_key_path(fs, sys, "OODA_HOME", "/oodac/oodac")); }
    if p == "" { p = take_compiler(fs, ooda_key_path(fs, sys, "OODA_SRC_ROOT", "/oodac/oodac")); }
    if p == "" { p = take_compiler(fs, "/home/jeryd/.local/bin/oodac"); }
    if p == "" { p = take_compiler(fs, "/home/jeryd/.local/share/ooda/oodac/oodac"); }
    if p == "" {
        println("ERR\tcli\tno oodac");
        process_exit(1);
    }
    return p;
}

pub fn find_src_root(oodac: String) -> String {
    let n: Int = chars_len(oodac);
    if n >= 17 {
        if str_slice(oodac, n - 17, n) == "/.local/bin/oodac" {
            return str_slice(oodac, 0, n - 17) + "/.local/share/ooda";
        }
    }
    if n >= 30 {
        if str_slice(oodac, n - 30, n) == "/.local/share/ooda/oodac/oodac" {
            return str_slice(oodac, 0, n - 30) + "/.local/share/ooda";
        }
    }
    if n >= 22 && str_slice(oodac, 0, 22) == "Projects/openOODA/ooda" {
        return "Projects/openOODA/ooda";
    }
    if n >= 8 && str_slice(oodac, 0, 8) == "../ooda/" { return "../ooda"; }
    if n >= 5 && str_slice(oodac, 0, 5) == "ooda/" { return "ooda"; }
    if n >= 3 && str_slice(oodac, 0, 3) == "../" { return ".."; }
    return ".";
}
