// # Shared helpers for ooda fix
//
// Logline: Classify check text, ask a person, and read oodac check output for fix.
//
// Setup: Used by fix_drive. SysCap runs shell. FsCap reads capture files.
//
// Beats:
//   1. refuse_symlink and check_text capture oodac check output.
//   2. ask_fix prompts on a TTY unless --yes.
//   3. classify maps check text to ecap, etc, eparse, eimp, or emust.

import "fix_text.oo";
import "host_run.oo";

pub fn refuse_symlink(sys: &SysCap, path: String) {
    let cmd: String = "if [ -L " + sq(path) + " ]; then exit 0; else exit 1; fi";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        println("ERR\tfix\tsymlink refused");
        process_exit(2);
    }
}

pub fn check_text(sys: &SysCap, fs: &FsCap, oodac: String, path: String) -> String {
    let stem: String = log_stem(path);
    let outp: String = stem + ".out";
    let errp: String = stem + ".err";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; " + sq(oodac) + " check " + sq(path) + " > " + sq(outp) + " 2> " + sq(errp) + "; exit 0";
    let ign: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if ign.is_ok() {
        let hold = 0;
        if hold != 0 { println(""); }
    }
    let mut acc: String = "";
    let ro: Result[String, String] = read_file(fs, outp);
    match ro {
        Ok(s) => { acc = acc + s; }
        Err(m) => {}
    }
    let re: Result[String, String] = read_file(fs, errp);
    match re {
        Ok(s2) => { acc = acc + "\n" + s2; }
        Err(m2) => {}
    }
    return acc;
}

fn digit_val(c: String) -> Int {
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    return 0;
}

fn is_digit_char(c: String) -> Bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
        return true;
    }
    return false;
}

pub fn parse_int_digits(s: String) -> Int {
    let n = chars_len(s);
    let mut i = 0;
    let mut v = 0;
    while i < n {
        let c: String = char_at(s, i);
        if is_digit_char(c) {
            v = v * 10 + digit_val(c);
        }
        i = i + 1;
    }
    if v <= 0 {
        return 1;
    }
    return v;
}

pub fn ask_fix(sys: &SysCap, path: String, what: String) -> Int {
    let msg: String = "ooda fix will change " + path + " (" + what + ").\nApply? [y/N] ";
    let cmd: String = "if [ -t 0 ]; then printf %s " + sq(msg) + " >&2; read ans; case \"$ans\" in y|Y|yes|YES) exit 0;; *) exit 1;; esac; else exit 2; fi";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        return 0;
    }
    let tty_check: Result[String, String] = sys_exec(sys, "sh", "-c", "if [ -t 0 ]; then exit 0; else exit 1; fi");
    if tty_check.is_ok() {
        return 1;
    }
    return 2;
}

pub fn classify(log: String) -> String {
    if find_sub(log, "unused Result") >= 0 || find_sub(log, "must-use") >= 0 || find_sub(log, "do not discard") >= 0 {
        return "emust";
    }
    if find_sub(log, "ERR\tcapability\t") >= 0 || find_sub(log, "E_CAP") >= 0 {
        return "ecap";
    }
    if find_sub(log, "undefined variable '") >= 0 || find_sub(log, "ERR\ttype\t") >= 0 || find_sub(log, "E_TC") >= 0 {
        return "etc";
    }
    if find_sub(log, "ERR\tparse\t") >= 0 {
        return "eparse";
    }
    if find_sub(log, "ERR\timport\t") >= 0 {
        return "eimp";
    }
    return "";
}
