// # File-backed package manager core
//
// Logline: Name, SemVer, caps, SHA-256 lock, and catalog resolve with no network.
//
// Setup: String catalog lines name|version|caps|deps. SHA-256 is crypto_sha256_internal.
//
// Beats:
//   1. Refuse traversal names. Refuse child caps the parent did not grant.
//   2. Pick the highest SemVer that satisfies = ^ ~ *.
//   3. Lock hash matches on the same payload and differs when tampered.

import "pm_caps.oo";
import "pm_lock.oo";
import "pm_name.oo";

pub fn pm_sha256(s: String) -> String {
    return crypto_sha256_internal(s);
}

pub fn pm_cas_id(payload: String) -> String {
    return crypto_sha256_internal(payload);
}

pub fn pm_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v;
}

pub fn pm_ver_at(ver: String, idx: Int) -> Int {
    let n: Int = chars_len(ver);
    let mut b: Int = 0 - 1;
    let mut c: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        if char_at(ver, i) == "." {
            if b < 0 {
                b = i;
            } else if c < 0 {
                c = i;
            }
        }
        i = i + 1;
    }
    if b < 0 {
        if idx == 0 { return pm_int(ver); }
        return 0;
    }
    if idx == 0 {
        return pm_int(str_slice(ver, 0, b));
    }
    if c < 0 {
        if idx == 1 { return pm_int(str_slice(ver, b + 1, n)); }
        return 0;
    }
    if idx == 1 {
        return pm_int(str_slice(ver, b + 1, c));
    }
    return pm_int(str_slice(ver, c + 1, n));
}

pub fn pm_semver_ok(s: String) -> Bool {
    if chars_len(s) < 5 {
        return false;
    }
    return str_index_of(s, ".") > 0;
}

pub fn pm_semver_cmp(left: String, right: String) -> Int {
    let mut w: Int = 0;
    while w < 3 {
        let x: Int = pm_ver_at(left, w);
        let y: Int = pm_ver_at(right, w);
        if x < y { return 0 - 1; }
        if x > y { return 1; }
        w = w + 1;
    }
    return 0;
}

pub fn pm_semver_sat(actual: String, spec: String) -> Bool {
    if spec == "*" || spec == "" {
        return true;
    }
    let mut op: String = "=";
    let mut req: String = spec;
    if str_slice(spec, 0, 1) == "^" {
        op = "^";
        req = str_slice(spec, 1, chars_len(spec));
    } else if str_slice(spec, 0, 1) == "~" {
        op = "~";
        req = str_slice(spec, 1, chars_len(spec));
    } else if str_slice(spec, 0, 1) == "=" {
        req = str_slice(spec, 1, chars_len(spec));
    }
    let cmp: Int = pm_semver_cmp(actual, req);
    if op == "=" {
        return cmp == 0;
    }
    if op == "~" {
        if pm_ver_at(actual, 0) != pm_ver_at(req, 0) { return false; }
        if pm_ver_at(actual, 1) != pm_ver_at(req, 1) { return false; }
        return cmp >= 0;
    }
    if op == "^" {
        if pm_ver_at(actual, 0) != pm_ver_at(req, 0) { return false; }
        return cmp >= 0;
    }
    return cmp == 0;
}

pub fn pm_lock_hash(entries: String) -> String {
    return pm_lock_digest(entries);
}

pub fn pm_lock_same(left: String, right: String) -> Bool {
    return pm_lock_match(left, right);
}
