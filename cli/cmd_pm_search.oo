// # Search every added HTTPS store
//
// Logline: Fetch each catalog and print names that match the query.
//
// Setup: Stock plus extras. Query is a substring of the package name. Empty query lists all.
//
// Beats:
//   1. Walk configured store URLs.
//   2. GET catalog. GET name/manifest for a pay= line when present.
//   3. Print name, version, caps, store, and pay if listed.

import "cmd_pm_io.oo";
import "cmd_pm_reg.oo";
import "pm_reg.oo";
import "pm_regs.oo";
import "pm_resolve.oo";

fn pm_search_query(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "pm" || a == "search" {
            i = i + 1;
        } else if str_slice(a, 0, 1) == "-" {
            i = i + 1;
        } else {
            return a;
        }
    }
    return "";
}

fn pm_search_hit(name: String, q: String) -> Bool {
    if q == "" {
        return true;
    }
    if str_index_of(name, q) >= 0 {
        return true;
    }
    return false;
}

pub fn run_ooda_pm_search(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let q: String = pm_search_query(args);
    let urls: String = pm_regs_urls(fs, sys);
    let n: Int = chars_len(urls);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut hits: Int = 0;
    let dest: String = ".ooda-cache/ooda-tmp/regsearch";
    while i <= n {
        if i == n || char_at(urls, i) == "\n" {
            if i > start {
                let url: String = str_slice(urls, start, i);
                let base: String = pm_reg_base(url);
                if base != "" {
                    if pm_reg_pull(fs, sys, base + "/catalog", dest, "catalog") {
                        let cat: String = pm_slurp(fs, dest + "/catalog");
                        let cn: Int = chars_len(cat);
                        let mut cs: Int = 0;
                        let mut ci: Int = 0;
                        while ci <= cn {
                            if ci == cn || char_at(cat, ci) == "\n" {
                                if ci > cs {
                                    let line: String = str_slice(cat, cs, ci);
                                    let nm: String = pm_line_field(line, 0);
                                    if nm != "" {
                                        if pm_search_hit(nm, q) {
                                            let mut extra: String = "";
                                            if pm_reg_pull(fs, sys, base + "/" + nm + "/manifest", dest, "man") {
                                                let man: String = pm_slurp(fs, dest + "/man");
                                                let pk: String = pm_kv(man, "pay");
                                                if pk != "" {
                                                    extra = "  pay=" + pk;
                                                }
                                            }
                                            println(nm + "  " + pm_line_field(line, 1) + "  " + pm_line_field(line, 2) + "  " + url + extra);
                                            hits = hits + 1;
                                        }
                                    }
                                }
                                cs = ci + 1;
                            }
                            ci = ci + 1;
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if hits == 0 {
        println("ooda search: no match");
        process_exit(1);
    }
}
