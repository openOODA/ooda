// # Local git recipe pin
//
// Logline: Accept a local git recipe only when the commit file matches commit= or git:name#hash.
//
// Setup: Reuses pm_git_ok and pm_git_commit. No clone. No network.
//
// Beats:
//   1. Read the want hash from commit= or a git:name#hash spec.
//   2. Compare the local commit file through pm_git_ok.
//   3. Wrong or empty pin is err git.

import "pm_resolve.oo";
import "pm_v2.oo";

pub fn pm_git_want(spec: String) -> String {
    let c: String = pm_kv(spec, "commit");
    if chars_len(c) > 0 {
        return c;
    }
    let g: String = pm_kv(spec, "git");
    if chars_len(g) > 0 {
        return pm_git_commit(g);
    }
    return pm_git_commit(spec);
}

pub fn pm_git_commit_path(dir: String) -> String {
    return dir + "/commit";
}

pub fn pm_git_fixture_path(name: String) -> String {
    return "fixtures/pm_" + name + "/commit";
}

pub fn pm_git_ingest(have: String, spec: String) -> String {
    if pm_git_ok(have, pm_git_want(spec)) {
        return "ok";
    }
    return "err git";
}

pub fn pm_git_origin_ingest(origin: String, have: String, spec: String) -> String {
    if origin == "git" {
        return pm_git_ingest(have, spec);
    }
    return "ok";
}

pub fn pm_git_spec_check(have: String, dep: String) -> String {
    if chars_len(dep) >= 4 {
        if str_slice(dep, 0, 4) == "git:" {
            return pm_git_ingest(have, dep);
        }
    }
    return "ok";
}
