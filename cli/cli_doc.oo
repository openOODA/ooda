// # Documentation Generator Handler
//
// Logline: Extracts markdown documentation from OODA source files and doc comments.
//
// Setup: Reads source comments (# Title, Logline, Beats, pub fn) under FsReadCap.
//
// Beats:
//   1. Scan source lines for markdown headers and doc tags.
//   2. Extract public function signatures.
//   3. Render structured markdown document.
// RULES.oot 1.4: Requires &FsReadCap for reading files.
// RULES.oot 1.7: Under 256 lines.


pub fn cli_generate_doc(src: String, file_name: String) -> String {
    let mut doc: String = "# API Documentation: " + file_name + "\n\n";
    let mut cur: String = src;

    while chars_len(cur) > 0 {
        let nl_pos: Int = str_index_of(cur, "\n");
        let mut line: String = cur;
        if nl_pos >= 0 {
            line = str_slice(cur, 0, nl_pos);
            cur = str_slice(cur, nl_pos + 1, chars_len(cur));
        } else {
            cur = "";
        }

        if str_starts_with(line, "// # ") {
            let title: String = str_slice(line, 5, chars_len(line));
            doc = doc + "## " + title + "\n\n";
        } else if str_starts_with(line, "// Logline: ") {
            let logline: String = str_slice(line, 12, chars_len(line));
            doc = doc + "> **Summary**: " + logline + "\n\n";
        } else if str_starts_with(line, "pub fn ") {
            let fn_sig: String = str_slice(line, 0, chars_len(line));
            doc = doc + "### `" + fn_sig + "`\n\n";
        }
    }
    return doc;
}
