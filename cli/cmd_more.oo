pub fn run_ooda_bench(fs: &FsCap, sys: &SysCap, time: &TimeCap, args: List[String]) {
    let mut path: String = "";
    let mut do_run: Bool = false;
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--run" {
            do_run = true;
        } else if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    if path == "" {
        println("usage: ooda bench <file.oo> [--run]");
        process_exit(2);
    }
    if !path_exists(fs, path) {
        println("ERR\tbench\tunreadable file: " + path);
        process_exit(2);
    }
    let oodac: String = find_oodac(fs);
    refuse_cli(sys, oodac);
    let src_root: String = find_src_root(oodac);
    let prefix: String = "OODA_SRC_ROOT=" + sq(src_root) + " OODA_COMPILER=" + sq(oodac) + " OODAC_BIN=" + sq(oodac) + " " + sq(oodac);
    let t0: Int = now_ms(time);
    let cr: Result[String, String] = sys_exec(sys, "sh", "-c", prefix + " check " + sq(path));
    let t1: Int = now_ms(time);
    let mut ms: Int = t1 - t0;
    if ms < 0 {
        ms = 0;
    }
    if cr.is_err() {
        println("ooda bench: check failed " + path);
        process_exit(1);
    }
    println("ooda bench: check " + path + " " + ms.to_string() + "ms");
    if do_run {
        let r0: Int = now_ms(time);
        let rr: Result[String, String] = sys_exec(sys, "sh", "-c", prefix + " run " + sq(path));
        let r1: Int = now_ms(time);
        let mut rms: Int = r1 - r0;
        if rms < 0 {
            rms = 0;
        }
        println("ooda bench: run " + path + " " + rms.to_string() + "ms");
        if rr.is_err() {
            process_exit(1);
        }
    }
}
