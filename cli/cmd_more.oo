pub fn run_ooda_pack(fs: &FsCap, sys: &SysCap, args: List[String]) {
    run_ooda_pm_pack(fs, sys, args);
}

pub fn run_ooda_install_cmd(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let oodac: String = find_oodac(fs, sys);
    refuse_cli(sys, oodac);
    let src_root: String = find_src_root(oodac);
    let inst: String = src_root + "/install/install.oo";
    if !path_exists(fs, inst) {
        println("ERR\tcli\tmissing installer at " + inst);
        process_exit(1);
    }
    let mut fwd: List[String] = list_new();
    fwd = list_push(fwd, "run");
    fwd = list_push(fwd, inst);
    let mut i: Int = 1;
    let n: Int = list_len(args);
    while i < n {
        fwd = list_push(fwd, list_get(args, i));
        i = i + 1;
    }
    run_oodac(fs, sys, fwd);
}

