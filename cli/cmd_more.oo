pub fn run_ooda_bench(fs: &FsCap, sys: &SysCap, time: &TimeCap, args: List[String]) {
    if list_len(args) < 2 {
        println("ERR\tcli\tusage: ooda bench <file.oo> [--run]");
        process_exit(2);
    }
    let target: String = list_get(args, 1);
    let do_run: Bool = list_len(args) >= 3 && list_get(args, 2) == "--run";

    let t0: Int = now_ms(time);
    let mut fwd_ck: List[String] = list_new();
    fwd_ck = list_push(fwd_ck, "check");
    fwd_ck = list_push(fwd_ck, target);
    let t1: Int = now_ms(time);
    let ck_ms: Int = t1 - t0;
    println("bench: check " + target + " " + ck_ms.to_string() + " ms");

    if do_run {
        let t2: Int = now_ms(time);
        let mut fwd_rn: List[String] = list_new();
        fwd_rn = list_push(fwd_rn, "run");
        fwd_rn = list_push(fwd_rn, target);
        let t3: Int = now_ms(time);
        let rn_ms: Int = t3 - t2;
        println("bench: run " + target + " " + rn_ms.to_string() + " ms");
    }
}
