// # Thin product floors for leftover CLI commands
//
// Logline: em, migrate, install, context-pack, emit-health, and errdigest print ok, pack writes an air-gap tree, and bench times oodac check.
//
// Setup: Dispatched from cli/main.oo. Bench takes TimeCap and a file. Install runs install/install.oo. Not the compiler.
//
// Beats:
//   1. em and migrate print ok.
//   2. install runs install/install.oo with OODA_CHECKOUT set to the tree.
//   3. pack forwards to the PM air-gap writer.
//   4. bench times oodac check and optional run with now_ms.

import "cmd_pm_pack.oo";
import "find_compiler.oo";
import "host_run.oo";

pub fn run_ooda_em(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) >= 1 {
        if path_exists(fs, ".") {
            println("ooda em: ok");
            return;
        }
    }
    println("ooda em: ok");
}

