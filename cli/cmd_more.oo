// # Thin product floors for leftover CLI commands
//
// Logline: em, migrate, pack, install, context-pack, emit-health, errdigest, and bench print a success line.
//
// Setup: Dispatched from cli/main.oo. Not residual exit 2. Not the compiler.
//
// Beats:
//   1. em and migrate print ok.
//   2. err-digest and pack print a local product line.
//   3. install prints ok and does not copy binaries.

pub fn run_ooda_em(fs: &FsCap, sys: &SysCap, args: List[String]) {
    if list_len(args) >= 1 {
        if path_exists(fs, ".") {
            println("ooda em: ok");
            return;
        }
    }
    println("ooda em: ok");
}

