// job: shell-safe product dispatch helpers for pure CLI
// stage: cli

// POSIX single-quote escape for sh -c (safe vs $ ` " ;).
fn shell_sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

fn product_sh(sys: &SysCap, mode: String, args: List[String]) {
    let mut payload: String = shell_sq(mode);
    let mut i = 0;
    while i < list_len(args) {
        payload = payload + " " + shell_sq(list_get(args, i));
        i = i + 1;
    }
    let sh = "set -e; S=./scripts/ooda_product.sh; [ -x \"$S\" ] || S=scripts/ooda_product.sh; [ -x \"$S\" ] || S=ooda/scripts/ooda_product.sh; [ -x \"$S\" ] || S=../ooda/scripts/ooda_product.sh; if [ -n \"${OODA_SRC_ROOT:-}\" ] && [ -x \"${OODA_SRC_ROOT}/scripts/ooda_product.sh\" ]; then S=\"${OODA_SRC_ROOT}/scripts/ooda_product.sh\"; fi; [ -x \"$S\" ] || { echo ERR_NO_PRODUCT_SCRIPT >&2; exit 1; }; exec \"$S\" " + payload;
    let r = sys_exec(sys, "sh", "-c", sh);
    // Always process_exit: return into main RAII double-frees concat temps.
    if r.is_ok() {
        process_exit(0);
    }
    process_exit(1);
}
