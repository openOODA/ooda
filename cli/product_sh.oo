// job: shell-safe product dispatch helpers for pure CLI
// stage: cli

// POSIX single-quote escape for sh -c (safe vs $ ` " ;).
fn shell_sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

// M11: parse run flags; return argv for product_sh starting with --engine …
pub fn cli_run_args(args: List[String]) -> List[String] {
    let mut engine = "native";
    let mut rargs: List[String] = list_new();
    let mut i = 1;
    let mut skip_dd = false;
    while i < list_len(args) {
        let a = list_get(args, i);
        if a == "--json-errors" {
            println("ERR\tcli\t--json-errors residual on pure run");
            process_exit(2);
        }
        if skip_dd == false && a == "--engine" {
            if i + 1 >= list_len(args) {
                println("ERR\tcli\t--engine needs value");
                process_exit(2);
            }
            engine = list_get(args, i + 1);
            i = i + 2;
        } else if skip_dd == false && chars_len(a) >= 9 && str_slice(a, 0, 9) == "--engine=" {
            engine = str_slice(a, 9, chars_len(a));
            i = i + 1;
        } else if a == "--" && skip_dd == false {
            skip_dd = true;
            i = i + 1;
        } else {
            rargs = list_push(rargs, a);
            i = i + 1;
        }
    }
    if engine != "bc" && engine != "native" {
        println("ERR\tcli\tinvalid engine: " + engine + " (want bc|native)");
        process_exit(2);
    }
    if list_len(rargs) < 1 {
        println("ooda run: missing file");
        process_exit(2);
    }
    let mut fwd: List[String] = list_new();
    fwd = list_push(fwd, "--engine");
    fwd = list_push(fwd, engine);
    let mut j = 0;
    while j < list_len(rargs) {
        fwd = list_push(fwd, list_get(rargs, j));
        j = j + 1;
    }
    return fwd;
}

fn product_sh(sys: &SysCap, mode: String, args: List[String]) {
    let mut payload: String = shell_sq(mode);
    let mut i = 0;
    while i < list_len(args) {
        payload = payload + " " + shell_sq(list_get(args, i));
        i = i + 1;
    }
    // Annotate String: untyped concat let SEGV'd tree oodac under PURE_NO_ARC (M2).
    let sh: String = "set -e; S=./scripts/ooda_product.sh; [ -x \"$S\" ] || S=scripts/ooda_product.sh; [ -x \"$S\" ] || S=ooda/scripts/ooda_product.sh; [ -x \"$S\" ] || S=../ooda/scripts/ooda_product.sh; if [ -n \"${OODA_SRC_ROOT:-}\" ] && [ -x \"${OODA_SRC_ROOT}/scripts/ooda_product.sh\" ]; then S=\"${OODA_SRC_ROOT}/scripts/ooda_product.sh\"; fi; [ -x \"$S\" ] || { echo ERR_NO_PRODUCT_SCRIPT >&2; exit 1; }; exec \"$S\" " + payload;
    let r = sys_exec(sys, "sh", "-c", sh);
    // Always process_exit: return into main RAII double-frees concat temps.
    if r.is_ok() {
        process_exit(0);
    }
    process_exit(1);
}
