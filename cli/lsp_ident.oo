// # Cursor identifier helpers for ooda lsp
//
// Logline: Read line and column from a JSON-RPC body and name the identifier there.
//
// Setup: Used by lsp_reply. Source is the buffer under hover or definition.
//
// Beats:
//   1. lsp_json_int reads a decimal after a key.
//   2. lsp_src_offset maps line and column to a byte offset.
//   3. lsp_ident_at expands the name under the offset.
//   4. lsp_fn_pos finds `fn name`; lsp_line_at and lsp_col_at map it back.

pub fn lsp_json_int(body: String, key: String) -> Int {
    let at: Int = str_index_of(body, key);
    if at < 0 {
        return 0;
    }
    let n: Int = chars_len(body);
    let mut i: Int = at + chars_len(key);
    while i < n {
        let c: String = char_at(body, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            break;
        }
    }
    let mut v: Int = 0;
    let mut any: Bool = false;
    while i < n {
        let d: String = char_at(body, i);
        if d == "0" || d == "1" || d == "2" || d == "3" || d == "4" || d == "5" || d == "6" || d == "7" || d == "8" || d == "9" {
            v = v * 10 + (byte_at(d, 0) - 48);
            any = true;
            i = i + 1;
        } else {
            break;
        }
    }
    if !any {
        return 0;
    }
    return v;
}

pub fn lsp_src_offset(src: String, line: Int, col: Int) -> Int {
    let n: Int = chars_len(src);
    let mut i: Int = 0;
    let mut ln: Int = 0;
    while i < n && ln < line {
        if char_at(src, i) == "\n" {
            ln = ln + 1;
        }
        i = i + 1;
    }
    let mut c: Int = 0;
    while i < n && c < col {
        if char_at(src, i) == "\n" {
            return i;
        }
        i = i + 1;
        c = c + 1;
    }
    return i;
}

fn lsp_is_ident_char(c: String) -> Bool {
    if c == "_" {
        return true;
    }
    let b: Int = byte_at(c, 0);
    if b >= 48 && b <= 57 {
        return true;
    }
    if b >= 65 && b <= 90 {
        return true;
    }
    if b >= 97 && b <= 122 {
        return true;
    }
    return false;
}

pub fn lsp_ident_at(src: String, off0: Int) -> String {
    let n: Int = chars_len(src);
    if n <= 0 {
        return "";
    }
    let mut off: Int = off0;
    if off < 0 {
        off = 0;
    }
    if off >= n {
        off = n - 1;
    }
    if !lsp_is_ident_char(char_at(src, off)) {
        if off > 0 && lsp_is_ident_char(char_at(src, off - 1)) {
            off = off - 1;
        } else {
            return "";
        }
    }
    let mut a: Int = off;
    while a > 0 && lsp_is_ident_char(char_at(src, a - 1)) {
        a = a - 1;
    }
    let mut b: Int = off + 1;
    while b < n && lsp_is_ident_char(char_at(src, b)) {
        b = b + 1;
    }
    return str_slice(src, a, b);
}

pub fn lsp_fn_pos(src: String, name: String) -> Int {
    if name == "" {
        return 0 - 1;
    }
    return str_index_of(src, "fn " + name);
}

pub fn lsp_line_at(src: String, pos: Int) -> Int {
    let n: Int = chars_len(src);
    let mut ln: Int = 0;
    let mut i: Int = 0;
    while i < pos && i < n {
        if char_at(src, i) == "\n" {
            ln = ln + 1;
        }
        i = i + 1;
    }
    return ln;
}

pub fn lsp_col_at(src: String, pos: Int) -> Int {
    let n: Int = chars_len(src);
    let mut col: Int = 0;
    let mut i: Int = 0;
    while i < pos && i < n {
        if char_at(src, i) == "\n" {
            col = 0;
        } else {
            col = col + 1;
        }
        i = i + 1;
    }
    return col;
}
