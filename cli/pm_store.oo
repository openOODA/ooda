// # write_file lock and CAS store
//
// Logline: Place lock and CAS bytes with fs_mkdir and write_file. No shell copies.
//
// Setup: Absolute paths under OODA_FS_WRITEDIR. cwd is discovered with pwd.
//
// Beats:
//   1. Resolve an absolute project root.
//   2. mkdir .ooda_modules and cas dirs.
//   3. write_file lock and payload. Fail closed on deny.

import "host_run.oo";

pub fn pm_root_abs(fs: &FsCap, sys: &SysCap) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/pm-cwd.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; pwd > .ooda-cache/ooda-tmp/pm-cwd.txt";
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_err() {
        return "";
    }
    if !path_exists(fs, outp) {
        return "";
    }
    let rr: Result[String, String] = read_file(fs, outp);
    if !rr.is_ok() {
        return "";
    }
    let mut s: String = match rr { Ok(t) => t, Err(m) => m };
    let n: Int = chars_len(s);
    if n > 0 {
        if char_at(s, n - 1) == "\n" {
            s = str_slice(s, 0, n - 1);
        }
    }
    return s;
}

fn pm_mkdir(fs: &FsCap, abs: String) -> Bool {
    if path_exists(fs, abs) {
        return true;
    }
    let mk: Result[Void, String] = oo_fs_mkdir(fs, abs);
    if mk.is_ok() {
        return true;
    }
    return path_exists(fs, abs);
}

pub fn pm_put(fs: &FsCap, abs: String, body: String) -> Bool {
    let wr: Result[Void, String] = write_file(fs, abs, body);
    return wr.is_ok();
}

pub fn pm_ensure_mod(fs: &FsCap, root: String) -> Bool {
    if !pm_mkdir(fs, root + "/.ooda_modules") {
        return false;
    }
    return pm_mkdir(fs, root + "/.ooda_modules/cas");
}

pub fn pm_put_lock(fs: &FsCap, root: String, lock: String) -> Bool {
    if !pm_ensure_mod(fs, root) {
        return false;
    }
    return pm_put(fs, root + "/.ooda_modules/lock", lock);
}

pub fn pm_put_cas(fs: &FsCap, root: String, sha: String, fname: String, body: String) -> Bool {
    if !pm_ensure_mod(fs, root) {
        return false;
    }
    let dir: String = root + "/.ooda_modules/cas/" + sha;
    if !pm_mkdir(fs, dir) {
        return false;
    }
    return pm_put(fs, dir + "/" + fname, body);
}

pub fn pm_put_vendor(fs: &FsCap, root: String, fname: String, body: String) -> Bool {
    let dir: String = root + "/vendor";
    if !pm_mkdir(fs, dir) {
        return false;
    }
    return pm_put(fs, dir + "/" + fname, body);
}
