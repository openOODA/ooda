// # Yank, advisory, and license policy
//
// Logline: Refuse yanked versions and licenses outside the project allow-list.
//
// Setup: yank and advisory are line files. licenses= on ooda.pkg is a comma list.
//
// Beats:
//   1. name@version or a bare name in yank is yanked.
//   2. A non-empty allow-list requires a listed license.
//   3. Advisory lines matching name@version are hits.

pub fn pm_yanked(text: String, name: String, ver: String) -> Bool {
    if name == "" {
        return false;
    }
    let want: String = name + "@" + ver;
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if line == want {
                    return true;
                }
                if line == name {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn pm_license_ok(allow: String, license: String) -> Bool {
    if allow == "" {
        return true;
    }
    if license == "" {
        return false;
    }
    let n: Int = chars_len(allow);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(allow, i) == "," {
            if i > start {
                if str_slice(allow, start, i) == license {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn pm_advisory_hit(text: String, name: String, ver: String) -> String {
    let want: String = name + "@" + ver;
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut out: String = "";
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if chars_len(line) >= chars_len(want) {
                    if str_slice(line, 0, chars_len(want)) == want {
                        if out != "" {
                            out = out + "\n";
                        }
                        out = out + line;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}
