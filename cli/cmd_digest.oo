// # SHA-256 digest of a file
//
// Logline: Print the sha256 of a given file via crypto_sha256_internal or sha256sum.
//
// Setup: FsCap reads the file. SysCap runs sha256sum when the builtin read fails.
//
// Beats:
//   1. Require a file path after the command; print usage when missing.
//   2. Hash file bytes with crypto_sha256_internal when readable.
//   3. Else run sha256sum under SysCap and print the hex.

import "host_run.oo";

fn digest_via_sum(fs: &FsCap, sys: &SysCap, path: String) -> String {
    let outp: String = ".ooda-cache/ooda-tmp/digest.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp; sha256sum " + sq(path) + " > " + sq(outp) + " 2>/dev/null; exit 0";
    let ign: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if ign.is_err() {
        return "";
    }
    let ro: Result[String, String] = read_file(fs, outp);
    if !ro.is_ok() {
        return "";
    }
    let text: String = match ro { Ok(s) => s, Err(m) => m };
    if chars_len(text) >= 64 {
        return str_slice(text, 0, 64);
    }
    return "";
}

pub fn run_ooda_digest(fs: &FsCap, sys: &SysCap, args: List[String]) {
    let mut path: String = "";
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    if path == "" {
        println("usage: ooda digest <file>");
        return;
    }
    if path_exists(fs, path) {
        let tr: Result[String, String] = read_file(fs, path);
        if tr.is_ok() {
            let text: String = match tr { Ok(s) => s, Err(m) => m };
            let h: String = crypto_sha256_internal(text);
            if chars_len(h) == 64 {
                println(h);
                return;
            }
        }
    }
    let h2: String = digest_via_sum(fs, sys, path);
    if chars_len(h2) == 64 {
        println(h2);
        return;
    }
    println("ooda digest: unreadable file: " + path);
}
