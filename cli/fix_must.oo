// # E_MUST unused Result structural fix
//
// Logline: Wrap a discarded Result call in if call.is_err() { process_exit(1); }.
//
// Setup: fix_text line helpers. Edits are string replaces only.
//
// Beats:
//   1. Find name( on the error line.
//   2. Walk to the matching ); statement end.
//   3. Replace name(...); with if name(...).is_err() { process_exit(1); }.

import "fix_text.oo";

fn find_discarded_call(text: String, name: String, from: Int) -> Int {
    let n = chars_len(text);
    let opl = chars_len(name);
    let mut at = from;
    while at < n {
        let hit: Int = find_sub_from(text, name, at);
        if hit < 0 {
            return -1;
        }
        if hit > 0 {
            if is_ident_char(char_at(text, hit - 1)) {
                at = hit + opl;
                continue;
            }
        }
        let after = hit + opl;
        let p: Int = skip_ws(text, after);
        if p >= n {
            return -1;
        }
        if char_at(text, p) != "(" {
            at = after;
            continue;
        }
        let mut depth = 0;
        let mut k = p;
        while k < n {
            let c: String = char_at(text, k);
            if c == "(" {
                depth = depth + 1;
            } else if c == ")" {
                depth = depth - 1;
                if depth == 0 {
                    let q: Int = skip_ws(text, k + 1);
                    if q < n {
                        if char_at(text, q) == ";" {
                            return hit;
                        }
                    }
                    at = after;
                    break;
                }
            }
            k = k + 1;
        }
        if k >= n {
            return -1;
        }
    }
    return -1;
}

fn call_end_semi(text: String, start: Int) -> Int {
    let n = chars_len(text);
    let p: Int = find_sub_from(text, "(", start);
    if p < 0 {
        return -1;
    }
    let mut depth = 0;
    let mut k = p;
    while k < n {
        let c: String = char_at(text, k);
        if c == "(" {
            depth = depth + 1;
        } else if c == ")" {
            depth = depth - 1;
            if depth == 0 {
                let q: Int = skip_ws(text, k + 1);
                if q < n {
                    if char_at(text, q) == ";" {
                        return q;
                    }
                }
                return -1;
            }
        }
        k = k + 1;
    }
    return -1;
}

pub fn apply_emust(text: String, name: String, line_no: Int) -> String {
    if chars_len(name) == 0 {
        println("ERR\tfix\tempty must-use name");
        process_exit(1);
    }
    if !is_ident_name(name) {
        println("ERR\tfix\tbad must-use name");
        process_exit(1);
    }
    let at: Int = line_start_at(text, line_no);
    let mut start: Int = find_discarded_call(text, name, at);
    if start < 0 {
        start = find_discarded_call(text, name, 0);
    }
    if start < 0 {
        println("ERR\tfix\tno discarded " + name + "( call");
        process_exit(1);
    }
    let semi: Int = call_end_semi(text, start);
    if semi < 0 {
        println("ERR\tfix\tno statement end for " + name);
        process_exit(1);
    }
    let call: String = str_slice(text, start, semi);
    let wrapped: String = "if " + call + ".is_err() { process_exit(1); }";
    return str_slice(text, 0, start) + wrapped + str_slice(text, semi + 1, chars_len(text));
}
