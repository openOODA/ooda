// # Start oodac from the product CLI
//
// Logline: Find the in-tree oodac binary and run a check without a product .sh file.
//
// Setup: FsCap sees the tree. SysCap starts oodac. Callers pass an existing path.
//
// Beats:
//   1. Probe known oodac locations.
//   2. Quote each token for sh -c.
//   3. Run check and keep oodac's exit code.

pub fn find_oodac(fs: &FsCap) -> String {
    if path_exists(fs, "./oodac/oodac") { return "./oodac/oodac"; }
    if path_exists(fs, "oodac/oodac") { return "oodac/oodac"; }
    if path_exists(fs, "ooda/oodac/oodac") { return "ooda/oodac/oodac"; }
    if path_exists(fs, "../oodac/oodac") { return "../oodac/oodac"; }
    if path_exists(fs, "./bootstrap/seed/oodac") { return "./bootstrap/seed/oodac"; }
    if path_exists(fs, "../ooda/oodac/oodac") { return "../ooda/oodac/oodac"; }
    if path_exists(fs, "Projects/openOODA/ooda/oodac/oodac") { return "Projects/openOODA/ooda/oodac/oodac"; }
    println("ERR\tcli\tno oodac");
    process_exit(1);
    return "";
}

pub fn sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

pub fn run_oodac(fs: &FsCap, sys: &SysCap, argv: List[String]) {
    let oodac: String = find_oodac(fs);
    let mut cmd: String = "OODAC_BIN=" + sq(oodac) + " " + sq(oodac);
    let mut i = 0;
    while i < list_len(argv) {
        cmd = cmd + " " + sq(list_get(argv, i));
        i = i + 1;
    }
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        process_exit(0);
    }
    process_exit(1);
}

pub fn run_oodac_check(fs: &FsCap, sys: &SysCap, path: String, json: Bool) {
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "check");
    argv = list_push(argv, path);
    if json {
        argv = list_push(argv, "--json-errors");
    }
    run_oodac(fs, sys, argv);
}

pub fn run_oodac_build(fs: &FsCap, sys: &SysCap, bargs: List[String]) {
    if list_len(bargs) < 1 {
        println("ooda build: missing file");
        process_exit(2);
    }
    let file: String = list_get(bargs, 0);
    if !path_exists(fs, file) {
        println("ERR\tbuild\tunreadable file: " + file);
        process_exit(2);
    }
    let mut target: String = "native";
    let mut out: String = "";
    let mut i = 1;
    while i < list_len(bargs) {
        let a: String = list_get(bargs, i);
        if a == "--target" {
            i = i + 1;
            if i < list_len(bargs) { target = list_get(bargs, i); }
        } else if a == "-o" {
            i = i + 1;
            if i < list_len(bargs) { out = list_get(bargs, i); }
        }
        i = i + 1;
    }
    if target == "wasm" {
        println("ERR\tcli\twasm target residual");
        process_exit(2);
    }
    let mut backend: String = "c";
    if target == "llvm" { backend = "llvm"; }
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "--backend");
    argv = list_push(argv, backend);
    argv = list_push(argv, "build");
    argv = list_push(argv, file);
    if out != "" {
        argv = list_push(argv, out);
    }
    run_oodac(fs, sys, argv);
}

// Parse ooda run argv. args[0] is the command. Residual --json-errors is refused.
pub fn cli_run_args(args: List[String]) -> List[String] {
    let mut engine = "native";
    let mut rargs: List[String] = list_new();
    let mut i = 1;
    let mut skip_dd = false;
    while i < list_len(args) {
        let a = list_get(args, i);
        if a == "--json-errors" {
            println("ERR\tcli\t--json-errors residual on pure run");
            process_exit(2);
        }
        if skip_dd == false && a == "--engine" {
            if i + 1 >= list_len(args) {
                println("ERR\tcli\t--engine needs value");
                process_exit(2);
            }
            engine = list_get(args, i + 1);
            i = i + 2;
        } else if skip_dd == false && chars_len(a) >= 9 && str_slice(a, 0, 9) == "--engine=" {
            engine = str_slice(a, 9, chars_len(a));
            i = i + 1;
        } else if a == "--" && skip_dd == false {
            skip_dd = true;
            i = i + 1;
        } else {
            rargs = list_push(rargs, a);
            i = i + 1;
        }
    }
    if engine != "bc" && engine != "native" {
        println("ERR\tcli\tinvalid engine: " + engine + " (want bc|native)");
        process_exit(2);
    }
    if list_len(rargs) < 1 {
        println("ooda run: missing file");
        process_exit(2);
    }
    let mut fwd: List[String] = list_new();
    fwd = list_push(fwd, "--engine");
    fwd = list_push(fwd, engine);
    let mut j = 0;
    while j < list_len(rargs) {
        if j == 1 {
            fwd = list_push(fwd, "--");
        }
        fwd = list_push(fwd, list_get(rargs, j));
        j = j + 1;
    }
    return fwd;
}

pub fn run_oodac_run(fs: &FsCap, sys: &SysCap, rargs: List[String]) {
    let mut engine: String = "native";
    let mut path: String = "";
    let mut i = 0;
    while i < list_len(rargs) {
        let a: String = list_get(rargs, i);
        if a == "--fuzz" || (chars_len(a) >= 6 && str_slice(a, 0, 6) == "--fuzz") {
            println("ERR\trun\t--fuzz residual");
            process_exit(2);
        }
        if a == "--engine" {
            i = i + 1;
            if i < list_len(rargs) { engine = list_get(rargs, i); }
        } else if a != "--" {
            if str_slice(a, 0, 1) != "-" {
                if path == "" { path = a; }
            }
        }
        i = i + 1;
    }
    if engine == "bc" {
        println("ERR\trun\t--engine bc residual");
        process_exit(2);
    }
    if path == "" {
        println("ooda run: missing file");
        process_exit(2);
    }
    if !path_exists(fs, path) {
        println("ERR\trun\tunreadable file: " + path);
        process_exit(2);
    }
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "run");
    argv = list_push(argv, path);
    run_oodac(fs, sys, argv);
}

pub fn run_oodac_test(fs: &FsCap, sys: &SysCap, path: String) {
    let oodac: String = find_oodac(fs);
    let cmd: String = "OODAC_BIN=" + sq(oodac) + " OODA_TEST=1 " + sq(oodac) + " run " + sq(path);
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        process_exit(0);
    }
    process_exit(1);
}
