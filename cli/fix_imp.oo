// # Insert a missing import
//
// Logline: Infer an import path from a check log and splice it into the source.
//
// Setup: fix_text helpers and path_exists are in scope.
//
// Beats:
//   1. Read a missing-import path from the check log.
//   2. Else map an undefined name to name.oo or std/name.oo when that file exists.
//   3. Insert import "spec"; after an existing import or at the top.

import "fix_text.oo";

pub fn infer_import_spec(fs: &FsCap, log: String) -> String {
    let mark: String = "relative probes (dir/std/../std/../../std/../../../std): ";
    let at: Int = find_sub(log, mark);
    if at >= 0 {
        let start: Int = at + chars_len(mark);
        let mut end: Int = start;
        let n: Int = chars_len(log);
        while end < n {
            let c: String = char_at(log, end);
            if c == "\n" || c == "\t" {
                break;
            }
            end = end + 1;
        }
        if end > start {
            return str_slice(log, start, end);
        }
    }
    let name: String = between(log, "undefined variable '", "'");
    if name == "" {
        return "";
    }
    if path_exists(fs, name + ".oo") {
        return name + ".oo";
    }
    if path_exists(fs, "std/" + name + ".oo") {
        return "std/" + name + ".oo";
    }
    return "";
}

pub fn apply_eimp(text: String, spec: String) -> String {
    if spec == "" {
        println("ERR\tfix\tno import spec");
        process_exit(1);
    }
    let line: String = "import \"" + spec + "\";\n";
    if find_sub(text, "import \"" + spec + "\"") >= 0 {
        println("ERR\tfix\timport already present");
        process_exit(1);
    }
    let at: Int = find_sub(text, "\nimport \"");
    if at >= 0 {
        return str_slice(text, 0, at + 1) + line + str_slice(text, at + 1, chars_len(text));
    }
    return line + text;
}
