# cli version and compat contract
#
# Format: NAME=MAJOR.MINOR.PATCH[-PRERELEASE]
# Bump MAJOR: incompatible API change (consumers must update imports)
# Bump MINOR: backwards-compatible feature (consumers continue to work)
# Bump PATCH: backwards-compatible bug fix
#
# cli refuses to run if any of the declared ranges is not satisfied.
# The api_surface field is a structural check: the loader asserts the
# cli ANCHOR.oo exposes exactly 4 public subdirs.

cli=0.2.0
opm=^0.7
opm_max=0.99.0
lsp=^0.5
lsp_max=0.99.0
mcp=^0.5
mcp_max=0.99.0
ooda=2.10.0
ooda_max=2.99.0
oodac=2.10.0
std=2.10.0
api_surface=4
