pub fn c_peek_list_elem(toks: List[String], pos: Int, n: Int) -> String { return "S"; }
pub fn c_ty_at(toks: List[String], pos: Int, n: Int) -> String { return "OoStr"; }
pub fn c_emit_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "AMP" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        let mut depth = 1; p = p + 1;
        while p < n && depth > 0 {
            let k = field_at(list_get(toks, p), 0);
            if k == "LBRACKET" { depth = depth + 1; }
            if k == "RBRACKET" { depth = depth - 1; }
            p = p + 1;
        }
    }
    return p;
}
pub fn test_parse(src: String) {
    let toks = tokenize_lines(src);
    let n = list_len(toks);
    let mut p = 0;
    if field_at(list_get(toks, p), 0) == "KW_PUB" { p = p + 1; }
    if field_at(list_get(toks, p), 0) == "KW_FN" { p = p + 1; }
    let fn_name = field_at(list_get(toks, p), 3);
    p = p + 1; p = p + 1;
    let mut first = true;
    println("before loop p=" + p.to_string() + " tok=" + field_at(list_get(toks, p), 0));
    while p < n {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "RPAREN" { p = p + 1; break; }
        if pk == "COMMA" { p = p + 1; }
        else if pk == "IDENT" {
            let pname = field_at(list_get(toks, p), 3);
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "COLON" {
                p = p + 1;
                p = c_emit_skip_type(toks, p, n);
            }
        } else { p = p + 1; }
    }
    println("after loop p=" + p.to_string() + " tok=" + field_at(list_get(toks, p), 0));
    if p < n {
        if field_at(list_get(toks, p), 0) == "ARROW" {
            p = p + 1;
            p = c_emit_skip_type(toks, p, n);
            println("after skip type p=" + p.to_string() + " tok=" + field_at(list_get(toks, p), 0));
        }
    }
}
pub fn main() {
    test_parse("pub fn foo() -> String { }");
}
