// # XDG checkout install
//
// Logline: Copy tree ooda and oodac onto the XDG bin and write config under HOME.
//
// Setup: ProcessCap runs mkdir/cp/chmod. FsWriteCap writes env and receipt. EnvCap reads HOME.
//
// Beats:
//   1. Resolve XDG paths. Require oodac/oodac and bin/ooda in the checkout.
//   2. Install both binaries to ~/.local/bin.
//   3. Write ~/.config/ooda/env and the data-home receipt.

import "install_art.oo";

fn home_or(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if r.is_ok() {
        return match r { Ok(s) => s, Err(_) => "" };
    }
    return "";
}

pub fn install_xdg(p: &ProcessCap, fw: &FsWriteCap, env: &EnvCap, checkout: String) {
    let home_user: String = home_or(env);
    if home_user == "" {
        say(p, "bad", "set OODA_FS_WRITEDIR to your home (XDG writes go under it)");
        process_exit(1);
    }
    let ooda_home: String = home_user + "/.local/share/ooda";
    let ooda_bin: String = home_user + "/.local/bin";
    let ooda_config: String = home_user + "/.config/ooda";
    let ooda_cache: String = home_user + "/.cache/ooda";
    let ooda_std: String = ooda_home + "/std";
    let cli_src: String = checkout + "/bin/ooda";
    let cc_src: String = checkout + "/oodac/oodac";
    say(p, "hd", "Decide · we will write (no prompt)");
    say(p, "dim", ooda_bin + "/ooda");
    say(p, "dim", ooda_bin + "/oodac");
    say(p, "dim", ooda_home);
    say(p, "dim", ooda_config + "/env");
    if process_exec(p, "test -x " + cli_src).is_err() {
        say(p, "bad", "missing " + cli_src);
        process_exit(1);
    }
    if process_exec(p, "test -x " + cc_src).is_err() {
        say(p, "bad", "missing " + cc_src);
        process_exit(1);
    }
    say(p, "hd", "Act · place the toolchain");
    if process_exec(p, "mkdir -p " + ooda_home + "/share/fixtures " + ooda_home + "/install " + ooda_bin + " " + ooda_config + " " + ooda_cache + "/downloads").is_err() {
        say(p, "bad", "mkdir");
        process_exit(1);
    }
    say(p, "ok", "XDG dirs");
    if process_exec(p, "cp -f " + cli_src + " " + ooda_bin + "/ooda").is_err() {
        say(p, "bad", "copy ooda");
        process_exit(1);
    }
    say(p, "ok", "CLI  " + ooda_bin + "/ooda");
    if process_exec(p, "cp -f " + cc_src + " " + ooda_bin + "/oodac").is_err() {
        say(p, "bad", "copy oodac");
        process_exit(1);
    }
    say(p, "ok", "oodac  " + ooda_bin + "/oodac");
    if process_exec(p, "cp -f " + cli_src + " " + ooda_bin + "/oo").is_err() {
        say(p, "dim", "oo alias skipped");
    }
    if process_exec(p, "chmod +x " + ooda_bin + "/ooda " + ooda_bin + "/oodac " + ooda_bin + "/oo").is_err() {
        say(p, "bad", "chmod");
        process_exit(1);
    }
    if process_exec(p, "rm -rf " + ooda_std).is_err() {
        say(p, "dim", "std slot busy");
    }
    if process_exec(p, "cp -a " + checkout + "/std " + ooda_std).is_err() {
        say(p, "bad", "copy product std");
        process_exit(1);
    }
    say(p, "ok", "std   " + ooda_std + "  (product ooda/std)");
    if process_exec(p, "rm -rf " + ooda_home + "/runtime").is_err() {
        say(p, "dim", "runtime slot");
    }
    if process_exec(p, "cp -a " + checkout + "/runtime " + ooda_home + "/runtime").is_err() {
        say(p, "bad", "copy runtime");
        process_exit(1);
    }
    say(p, "ok", "runtime  " + ooda_home + "/runtime");
    if process_exec(p, "mkdir -p " + ooda_home + "/oodac").is_err() {
        say(p, "bad", "mkdir home oodac");
        process_exit(1);
    }
    if process_exec(p, "cp -f " + cc_src + " " + ooda_home + "/oodac/oodac").is_err() {
        say(p, "bad", "copy home oodac");
        process_exit(1);
    }
    if process_exec(p, "chmod +x " + ooda_home + "/oodac/oodac").is_err() {
        say(p, "dim", "chmod home oodac");
    }
    if process_exec(p, "cp -f " + checkout + "/fixtures/hello.oo " + ooda_home + "/share/fixtures/hello.oo").is_err() {
        say(p, "dim", "hello fixture skipped");
    } else {
        say(p, "ok", "hello  " + ooda_home + "/share/fixtures/hello.oo");
    }
    let env_file: String = ooda_config + "/env";
    let body: String = "# openOODA XDG env — source from your shell profile\nexport OODA_HOME=\"" + ooda_home + "\"\nexport OODA_SRC_ROOT=\"" + ooda_home + "\"\nexport OODA_STD=\"" + ooda_std + "\"\nexport OODA_CONFIG=\"" + ooda_config + "\"\nexport OODA_CACHE=\"" + ooda_cache + "\"\nexport PATH=\"" + ooda_bin + ":$PATH\"\n";
    if write_file(fw, env_file, body).is_err() {
        say(p, "bad", "write env");
        process_exit(1);
    }
    say(p, "ok", "env   " + env_file);
    let receipt: String = "openOODA install receipt\nversion=v0.207.0\nsource=checkout-oo\noodac=" + ooda_bin + "/oodac\n";
    if write_file(fw, ooda_home + "/share/INSTALL_RECEIPT.txt", receipt).is_err() {
        say(p, "bad", "write receipt");
        process_exit(1);
    }
    say(p, "ok", "receipt under " + ooda_home + "/share");
    say(p, "hd", "Done");
    say(p, "ok", "install_xdg: PASSED");
}
