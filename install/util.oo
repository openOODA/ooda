// # Installer fail helpers
//
// Logline: Read a required file or print INSTALL FAILED and exit.
//
// Setup: FsCap is available for installer filesystem validation.
//
// Beats:
//   1. must_read unwraps read_file or fails the install.
//   2. err_str pulls the Err string from a Result.
//   3. fail_install prints the mark and process_exit(1).

pub fn must_read(fs: &FsCap, path: String) -> String {
    let r = read_file(fs, path);
    if r.is_err() {
        fail_install("read failed: " + path);
    }
    return match r {
        Ok(s) => s,
        Err(e) => e,
    };
}

pub fn err_str(r: Result[Void, String]) -> String {
    return match r {
        Ok(_) => "",
        Err(e) => e,
    };
}

// Overload-ish: Result[String,String] error extract via is_err path in callers
pub fn fail_install(msg: String) {
    println("");
    println("✖ INSTALL FAILED");
    println("  " + msg);
    println("");
    process_exit(1);
}
