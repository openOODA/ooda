// # Installer ink and banner
//
// Logline: Print ANSI color and the openOODA wordmark for the XDG installer.
//
// Setup: ProcessCap so printf can emit escapes. Unused Result is checked.
//
// Beats:
//   1. Set or clear a color.
//   2. Print the banner.
//   3. Print a labeled story line.

fn ink(p: &ProcessCap, code: String) {
    if process_exec(p, "printf %b '\\033[" + code + "m'").is_err() {
        let z = 0;
        if z != 0 { println(""); }
    }
}

pub fn ink_reset(p: &ProcessCap) {
    ink(p, "0");
}

pub fn ink_cyan(p: &ProcessCap) {
    ink(p, "1;38;5;51");
}

pub fn ink_violet(p: &ProcessCap) {
    ink(p, "1;38;5;141");
}

pub fn ink_ok(p: &ProcessCap) {
    ink(p, "1;38;5;82");
}

pub fn ink_dim(p: &ProcessCap) {
    ink(p, "38;5;244");
}

pub fn ink_warn(p: &ProcessCap) {
    ink(p, "1;38;5;214");
}

pub fn banner(p: &ProcessCap) {
    ink_cyan(p);
    println("");
    println("      ___  ___  ___   ___");
    println("     / _ \\/ _ \\/ _ | / _ \\");
    println("    / // / // / __ |/ // /");
    println("   /____/\\___/_/ |_/____/");
    ink_violet(p);
    println("        observe · orient · decide · act");
    ink_reset(p);
    println("");
}

pub fn say(p: &ProcessCap, kind: String, msg: String) {
    if kind == "ok" {
        ink_ok(p);
        println("  ✓  " + msg);
    }
    if kind == "do" {
        ink_cyan(p);
        println("  →  " + msg);
    }
    if kind == "dim" {
        ink_dim(p);
        println("      " + msg);
    }
    if kind == "hd" {
        ink_violet(p);
        println("");
        println("  " + msg);
    }
    if kind == "bad" {
        ink_warn(p);
        println("  ✖  " + msg);
    }
    ink_reset(p);
}
