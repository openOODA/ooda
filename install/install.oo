// ===================================================================
// openOODA Installer — written in OODA (.oo), not shell.
//
// This program is the *story* of how openOODA lands on a machine:
//   who we are, what we install, where files live, and how you run code.
//
// Required caps (honest capability security, even for the installer):
//   net  — download the release from GitHub
//   fs   — write under XDG paths
//   sys  — extract the release tarball (tar)
//   env  — read HOME / XDG_* / OODA_* overrides
//
// Run (after you have a stage-0 `ooda` binary):
//   ooda run install/install.oo
//
// First-time users use the tiny website *bootstrap* (shell) only to obtain
// `ooda`, then this program takes over. The bootstrap is Chapter 0; this is
// the book.
// ===================================================================

pub fn main(net: &NetCap, fs: &FsCap, sys: &SysCap, env: &EnvCap) {
    chapter0_preface();
    let layout = resolve_layout(env);
    chapter1_who_we_are();
    chapter2_layout_story(layout);
    chapter3_download_and_unpack(net, fs, sys, env, layout);
    chapter4_place_files(fs, layout);
    chapter5_config_and_path(fs, env, layout);
    chapter6_verify(fs, sys, layout);
    chapter7_what_you_have(layout);
    chapter8_next_steps(layout);
}

// ---------------------------------------------------------------------------
// Layout: XDG-correct paths (overridable via env)
// ---------------------------------------------------------------------------
//
//   OODA_HOME   data root     default: $XDG_DATA_HOME/ooda
//                              else:    $HOME/.local/share/ooda
//   OODA_BIN    binaries      default: $XDG_BIN_HOME
//                              else:    $HOME/.local/bin
//   OODA_CACHE  downloads     default: $XDG_CACHE_HOME/ooda
//                              else:    $HOME/.cache/ooda
//   OODA_CONFIG config/env    default: $XDG_CONFIG_HOME/ooda
//                              else:    $HOME/.config/ooda
//   OODA_STD    standard lib  default: $OODA_HOME/std
//   OODA_VERSION pin          default: v0.168.0-alpha
//
// We deliberately do *not* dump everything into ~/.ooda as a junk drawer.
// Data / config / cache / bin are separated the way modern Unix tools expect.
// ---------------------------------------------------------------------------

type Layout = struct {
    home: String,
    bin: String,
    cache: String,
    config: String,
    std: String,
    version: String,
    arch: String,
    repo: String
};

pub fn resolve_layout(env: &EnvCap) -> Layout {
    let home_user = env_or(env, "HOME", "");
    let xdg_data = env_or(env, "XDG_DATA_HOME", home_user + "/.local/share");
    let xdg_cache = env_or(env, "XDG_CACHE_HOME", home_user + "/.cache");
    let xdg_config = env_or(env, "XDG_CONFIG_HOME", home_user + "/.config");
    let xdg_bin = env_or(env, "XDG_BIN_HOME", home_user + "/.local/bin");

    let ooda_home = env_or(env, "OODA_HOME", xdg_data + "/ooda");
    let ooda_bin = env_or(env, "OODA_BIN", xdg_bin);
    let ooda_cache = env_or(env, "OODA_CACHE", xdg_cache + "/ooda");
    let ooda_config = env_or(env, "OODA_CONFIG", xdg_config + "/ooda");
    let ooda_std = env_or(env, "OODA_STD", ooda_home + "/std");
    let version = env_or(env, "OODA_VERSION", "v0.168.0-alpha");

    return Layout {
        home: ooda_home,
        bin: ooda_bin,
        cache: ooda_cache,
        config: ooda_config,
        std: ooda_std,
        version: version,
        arch: "linux-x86_64",
        repo: "openOODA/ooda"
    };
}

pub fn env_or(env: &EnvCap, key: String, fallback: String) -> String {
    let r = env_get(env, key);
    if r.is_ok() {
        let v = match r {
            Ok(s) => s,
            Err(e) => fallback,
        };
        if v == "" {
            return fallback;
        }
        return v;
    }
    return fallback;
}

