    println("");
    println("╔══════════════════════════════════════════════════════════════════╗");
    println("║           openOODA Installer  —  written in .oo                 ║");
    println("║     Observe · Orient · Decide · Act  —  on your machine          ║");
    println("╚══════════════════════════════════════════════════════════════════╝");
    println("");
    println("This is not a shell script dressed up as a product.");
    println("You are running an OODA program under capability security:");
    println("  • NetCap  — only for fetching the published release");
    println("  • FsCap   — only for writing your install tree");
    println("  • SysCap  — only for extracting the archive (tar)");
    println("  • EnvCap  — only for reading HOME / XDG / OODA_* settings");
    println("");
    println("If something fails, it fails with a real Result — no silent lies.");
    println("");
}

