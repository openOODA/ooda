// # Installer entry
//
// Logline: Resolve the XDG layout and walk installer chapters 0 through 8.
//
// Setup: Net, Fs, Sys, and Env capabilities are granted to the installer runner.
//
// Beats:
//   1. Import layout, util, and both chapter modules.
//   2. Resolve Layout from EnvCap.
//   3. Run preface through next-steps under Net, Fs, Sys, and Env caps.
import "layout.oo";
import "util.oo";
import "chapters_a.oo";
import "chapters_b.oo";

pub fn main(net: &NetCap, fs: &FsCap, sys: &SysCap, env: &EnvCap) {
    chapter0_preface();
    let layout = resolve_layout(env);
    chapter1_who_we_are();
    chapter2_layout_story(layout);
    chapter3_download_and_unpack(net, fs, sys, env, layout);
    chapter4_place_files(fs, layout);
    chapter5_config_and_path(fs, env, layout);
    chapter6_verify(fs, sys, layout);
    chapter7_what_you_have(layout);
    chapter8_next_steps(layout);
}
