    println("                   # OODA_STD already points here via env file");
    println("");
    println("  Re-run this installer anytime:");
    println("    ooda run " + layout.home + "/install/install.oo");
    println("    # or from a source checkout: ooda run install/install.oo");
    println("");
    println("  DESIGN.md remains the constitution. This installer only lands tools.");
    println("");
    println("════════════════════════════════════════════════════════════════════");
    println("  Install complete. Welcome to openOODA.");
    println("════════════════════════════════════════════════════════════════════");
    println("");
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

pub fn must_read(fs: &FsCap, path: String) -> String {
    let r = read_file(fs, path);
    if r.is_err() {
        fail_install("read failed: " + path);
    }
    return match r {
        Ok(s) => s,
        Err(e) => e,
    };
}

pub fn err_str(r: Result[Void, String]) -> String {
    return match r {
        Ok(_) => "",
        Err(e) => e,
    };
}

// Overload-ish: Result[String,String] error extract via is_err path in callers
pub fn fail_install(msg: String) {
    println("");
    println("✖ INSTALL FAILED");
    println("  " + msg);
    println("");
    process_exit(1);
}
