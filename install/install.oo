    println("── Chapter 1 · What is openOODA? ───────────────────────────────────");
    println("");
    println("openOODA is a capability-secure, contract-carrying systems language.");
    println("  • Source files end in .oo");
    println("  • DESIGN.md is the constitution (thesis), not marketing copy");
    println("  • Stage-0 host today is a Rust binary named `ooda`");
    println("  • Userland + installer + CHS tools grow in .oo");
    println("");
    println("This install gives you the stage-0 toolchain so you can:");
    println("  ooda run file.oo      — interpret");
    println("  ooda check file.oo    — type + capability gate");
    println("  ooda build file.oo    — native emit (C backend / LLVM subset)");
    println("  ooda dump …           — canonical dumps for tools & oodac");
    println("");
}

pub fn chapter2_layout_story(layout: Layout) {
    println("── Chapter 2 · Where files will live ───────────────────────────────");
    println("");
    println("We follow XDG Base Directory conventions so openOODA does not own");
    println("your entire home directory as a single opaque folder.");
    println("");
    println("  OODA_HOME    (data)   = " + layout.home);
    println("      bin/ is NOT here — binaries go on the user bin path");
    println("      std/              = standard library root (OODA_STD)");
    println("      share/            = VERSION, README, install receipt");
    println("");
    println("  OODA_BIN     (PATH)   = " + layout.bin);
    println("      ooda              = the stage-0 CLI (the only required binary)");
    println("");
    println("  OODA_CONFIG  (config) = " + layout.config);
    println("      env               = shell snippet: PATH + OODA_HOME + OODA_STD");
    println("");
    println("  OODA_CACHE   (cache)  = " + layout.cache);
    println("      downloads/        = release tarballs (safe to delete)");
    println("");
    println("  Pin / version         = " + layout.version);
    println("  Architecture          = " + layout.arch);
    println("  Release repo          = github.com/" + layout.repo);
    println("");
    println("Overrides (all optional):");
    println("  OODA_VERSION  OODA_HOME  OODA_BIN  OODA_CACHE  OODA_CONFIG  OODA_STD");
    println("");
}

pub fn chapter3_download_and_unpack(net: &NetCap, fs: &FsCap, sys: &SysCap, env: &EnvCap, layout: Layout) {
    println("── Chapter 3 · Fetch the sealed release ────────────────────────────");
    println("");

    let tag = layout.version;
    let asset = "ooda-" + tag + "-" + layout.arch + ".tar.gz";
    let url = "https://github.com/" + layout.repo + "/releases/download/" + tag + "/" + asset;
    let dl_dir = layout.cache + "/downloads";
    let tarball = dl_dir + "/" + asset;
    let extract_root = layout.cache + "/extract-" + tag;

    println("  Creating cache directories…");
    let m1 = mkdir_p(fs, dl_dir);
    if m1.is_err() {
        fail_install("could not create download cache: " + err_str(m1));
    }
    let m2 = mkdir_p(fs, extract_root);
    if m2.is_err() {
        fail_install("could not create extract dir: " + err_str(m2));
    }

    println("  URL:  " + url);
    println("  Dest: " + tarball);
    println("  Downloading with curl (HTTPS only) under NetCap…");
    let d = http_download(net, url, tarball);
    if d.is_err() {
        println("");
        println("  Download failed.");
        println("  " + err_str(d));
        println("  Check that " + tag + " exists at:");
        println("    https://github.com/" + layout.repo + "/releases");
        println("  Or pin another tag:  OODA_VERSION=vX.Y.Z-alpha ooda run install/install.oo");
        process_exit(1);
    }
    println("  Download complete.");
    println("");
    println("  Extracting with tar under SysCap…");
    let x = extract_tar_gz(sys, tarball, extract_root);
    if x.is_err() {
        fail_install("extract failed: " + err_str(x));
    }
    println("  Extract complete → " + extract_root);
    println("");

    // Stash paths for next chapter via files in cache (no globals)
    let w = write_file(fs, layout.cache + "/last_extract_root", extract_root);
    if w.is_err() {
        fail_install("could not record extract root");
    }
    let w2 = write_file(fs, layout.cache + "/last_tarball", tarball);
    if w2.is_err() {
        fail_install("could not record tarball path");
    }
}

pub fn chapter4_place_files(fs: &FsCap, layout: Layout) {
    println("── Chapter 4 · Place the toolchain ────────────────────────────────");
    println("");

    let extract_root = must_read(fs, layout.cache + "/last_extract_root");
    // Release layout (from scripts/release.sh):
    //   ooda-<tag>-linux-x86_64/bin/ooda
    //   ooda-<tag>-linux-x86_64/share/...
    //   ooda-<tag>-linux-x86_64/install/install.oo
    // Also accept legacy flat tarball with just `ooda` at top level.
    let tag = layout.version;
    let pkg = extract_root + "/ooda-" + tag + "-" + layout.arch;
    let mut bin_src = pkg + "/bin/ooda";
    if !path_exists(fs, bin_src) {
        bin_src = extract_root + "/ooda";
    }
    if !path_exists(fs, bin_src) {
        // tarball may nest one directory without our new layout
        bin_src = extract_root + "/ooda-" + tag + "-" + layout.arch + "/ooda";
    }
    if !path_exists(fs, bin_src) {
        fail_install("could not find `ooda` binary inside release under " + extract_root);
    }

    println("  Binary source:  " + bin_src);
    println("  Creating OODA_HOME tree…");
    if mkdir_p(fs, layout.home).is_err() {
        fail_install("mkdir OODA_HOME");
    }
    if mkdir_p(fs, layout.home + "/share").is_err() {
        fail_install("mkdir share");
    }
    if mkdir_p(fs, layout.home + "/share/fixtures").is_err() {
        fail_install("mkdir fixtures");
    }
    if mkdir_p(fs, layout.std).is_err() {
        fail_install("mkdir std");
    }
    if mkdir_p(fs, layout.bin).is_err() {
        fail_install("mkdir OODA_BIN");
    }
    if mkdir_p(fs, layout.config).is_err() {
        fail_install("mkdir OODA_CONFIG");
    }

    let bin_dst = layout.bin + "/ooda";
    println("  Installing binary → " + bin_dst);
    let c = copy_file(fs, bin_src, bin_dst);
    if c.is_err() {
        fail_install("copy binary: " + err_str(c));
    }
    let x = chmod_exec(fs, bin_dst);
    if x.is_err() {
        fail_install("chmod +x: " + err_str(x));
    }

    // VERSION + receipt
    match write_file(fs, layout.home + "/share/VERSION", layout.version + "\n") { Ok(_) => 0, Err(_) => 0 };
    let receipt = ""
        + "openOODA install receipt\n"
        + "version=" + layout.version + "\n"
        + "arch=" + layout.arch + "\n"
        + "ooda_home=" + layout.home + "\n"
        + "ooda_bin=" + layout.bin + "\n"
        + "ooda_std=" + layout.std + "\n"
        + "ooda_config=" + layout.config + "\n"
        + "ooda_cache=" + layout.cache + "\n"
        + "binary=" + bin_dst + "\n";
    match write_file(fs, layout.home + "/share/INSTALL_RECEIPT.txt", receipt) { Ok(_) => 0, Err(_) => 0 };

    // Copy install.oo into home for re-runs / storytelling on-box
    let install_src = pkg + "/install/install.oo";
    if path_exists(fs, install_src) {
        match mkdir_p(fs, layout.home + "/install") { Ok(_) => 0, Err(_) => 0 };
        match copy_file(fs, install_src, layout.home + "/install/install.oo") { Ok(_) => 0, Err(_) => 0 };
        println("  Installed installer source → " + layout.home + "/install/install.oo");
    }

    // Optional: share README from package
    let readme_src = pkg + "/share/README.md";
    if path_exists(fs, readme_src) {
        match copy_file(fs, readme_src, layout.home + "/share/README.md") { Ok(_) => 0, Err(_) => 0 };
    }

    println("  Toolchain files are in place.");
    println("");
}

pub fn chapter5_config_and_path(fs: &FsCap, env: &EnvCap, layout: Layout) {
    println("── Chapter 5 · Config & PATH ───────────────────────────────────────");
    println("");
    println("  Writing shell env file (source this from your profile)…");

    let env_file = layout.config + "/env";
    let body = ""
        + "# openOODA environment — generated by install/install.oo\n"
        + "# Source from ~/.bashrc or ~/.zshrc:\n"
        + "#   [ -f \"" + env_file + "\" ] && . \"" + env_file + "\"\n"
        + "\n"
        + "export OODA_HOME=\"" + layout.home + "\"\n"
        + "export OODA_STD=\"" + layout.std + "\"\n"
        + "export OODA_CONFIG=\"" + layout.config + "\"\n"
        + "export OODA_CACHE=\"" + layout.cache + "\"\n"
        + "export PATH=\"" + layout.bin + ":$PATH\"\n"
        + "\n"
        + "# Optional: pin updates\n"
        + "# export OODA_VERSION=\"" + layout.version + "\"\n";

    let w = write_file(fs, env_file, body);
    if w.is_err() {
        fail_install("write env file: " + err_str(w));
    }
    println("  Wrote " + env_file);
    println("");
    println("  Add to your shell startup (once):");
    println("    echo '[ -f \"" + env_file + "\" ] && . \"" + env_file + "\"' >> ~/.bashrc");
    println("    # or ~/.zshrc");
    println("");
    println("  Or for this session only:");
    println("    . \"" + env_file + "\"");
    println("");
}

pub fn chapter6_verify(fs: &FsCap, sys: &SysCap, layout: Layout) {
    println("── Chapter 6 · Verify ────────────────────────────────────────────────");
    println("");
    let bin = layout.bin + "/ooda";
    if !path_exists(fs, bin) {
        fail_install("binary missing after install: " + bin);
    }
    println("  Running: " + bin + " --version");
    let v = sys_exec(sys, bin, "--version");
    if v.is_ok() {
        let out = match v {
            Ok(s) => s,
            Err(e) => e,
        };
        println("  " + out);
    } else {
        let e = match v {
            Ok(s) => s,
            Err(msg) => msg,
        };
        println("  (version probe returned Err — binary is present; try PATH)");
        println("  " + e);
    }
    println("");
    println("  Receipt:  " + layout.home + "/share/INSTALL_RECEIPT.txt");
    println("  VERSION:  " + layout.home + "/share/VERSION");
    println("");
}

pub fn chapter7_what_you_have(layout: Layout) {
    println("── Chapter 7 · What you have now ────────────────────────────────────");
    println("");
    println("  ✓ stage-0 CLI     " + layout.bin + "/ooda");
    println("  ✓ data home       " + layout.home);
    println("  ✓ std slot        " + layout.std + "  (empty until you place/clone std)");
    println("  ✓ config env      " + layout.config + "/env");
    println("  ✓ download cache  " + layout.cache + "/downloads");
    println("");
    println("  Not installed (by design, until you opt in):");
    println("    • full git clone of openooda / fixtures");
    println("    • system-wide /usr/local (we stay in user XDG paths)");
    println("    • automatic shell profile edits (we write env; you source it)");
    println("");
}

