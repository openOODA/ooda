    println("── Chapter 8 · Next steps ───────────────────────────────────────────");
    println("");
    println("  1. Load env:    . \"" + layout.config + "/env\"");
    println("  2. Check tool:  ooda --version");
    println("  3. Clone demos: git clone https://github.com/" + layout.repo + ".git && cd ooda");
    println("  4. Run:         ooda run fixtures/while_count.oo");
