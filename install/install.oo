// # XDG install entry
//
// Logline: Tell the OODA story, then install tree ooda and oodac onto XDG paths.
//
// Setup: ProcessCap, FsWriteCap, EnvCap. OODA_FS_WRITEDIR must be HOME. No TTY prompts.
//
// Beats:
//   1. Banner and required env.
//   2. Resolve checkout and run install_xdg.
//   3. Point at ~/.config/ooda/env.
// residual: first machine with no compiler still needs bootstrap/oodac_pure_build.

import "install_art.oo";
import "install_xdg.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap, env: &EnvCap) {
    banner(p);
    say(p, "hd", "This is an OODA program, not a shell costume.");
    say(p, "dim", "It copies two binaries, writes XDG config, and stops.");
    say(p, "dim", "No yes/no. No network. You already named the write root.");
    println("");
    say(p, "hd", "Observe · what you must pass");
    say(p, "dim", "OODA_FS_WRITEDIR=$HOME     (write_file is fail-closed)");
    say(p, "dim", "OODA_CHECKOUT=$PWD         (this ooda tree)");
    say(p, "dim", "Need:  $OODA_CHECKOUT/bin/ooda");
    say(p, "dim", "Need:  $OODA_CHECKOUT/oodac/oodac");
    say(p, "dim", "Need:  $OODA_CHECKOUT/std  and  runtime  (language bits)");
    let cr: Result[String, String] = env_get(env, "OODA_CHECKOUT");
    let mut root: String = ".";
    if cr.is_ok() {
        root = match cr { Ok(s) => s, Err(_) => "." };
    }
    if root == "" {
        root = ".";
    }
    say(p, "hd", "Orient · checkout");
    say(p, "do", "using " + root);
    install_xdg(p, fw, env, root);
    say(p, "hd", "Next");
    say(p, "dim", ". ~/.config/ooda/env");
    say(p, "dim", "oodac     — compiler");
    say(p, "dim", "ooda      — CLI");
    println("");
}
