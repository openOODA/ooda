        || name == "field_access_type_at" || name == "field_chain_type"
        || name == "indent" || name == "drop_depth" || name == "ann_check_let"
        || name == "build_fn_ret_table" || name == "build_pure_lit_env"
        || name == "build_struct_field_table" || name == "c_env_get"
    {
        return "OoStr";
