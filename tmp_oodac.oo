        || name == "str_ends_with" || name == "oo_str_ends_with"
    {
        return "int";
    }
    return "";
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: ty helpers split from c_emit_ty (emit drops fns after huge c_call_result_ty)
// stage: emit

pub fn c_lower_result_ty(name: String) -> String {
    let t: String = c_call_result_ty(name);
    if t != "" {
        return t;
    }
    return "long long";
}

// Leading call name of a C expr (before '('), else "".
pub fn c_rhs_call_name(rhs: String) -> String {
    let n = chars_len(rhs);
    let mut i = 0;
    while i < n {
        if char_at(rhs, i) == "(" {
            i = i + 1;
        } else {
            let mut j = i;
            while j < n {
                let c = char_at(rhs, j);
                if c == "(" {
                    if j > i {
                        let mut name = "";
                        let mut k = i;
                        while k < j {
                            name = name + char_at(rhs, k);
                            k = k + 1;
                        }
                        return name;
                    }
                    return "";
                }
                if c == " " || c == "," || c == ")" {
                    return "";
                }
                j = j + 1;
            }
            return "";
        }
    }
    return "";
}

// list_get(NAME, i) result type from env kind of NAME (S→OoStr, I→long long).
pub fn c_list_get_result_ty(env: String, rhs: String) -> String {
    let mut an = "";
    let mut qi = 0;
    let rn = chars_len(rhs);
    while qi < rn {
        if char_at(rhs, qi) == "(" {
            qi = qi + 1;
            while qi < rn {
                let c = char_at(rhs, qi);
                if c == "," || c == ")" {
                    qi = rn;
                } else {
                    an = an + c;
                    qi = qi + 1;
                }
            }
        } else {
            qi = qi + 1;
        }
    }
    let ak: String = c_env_get(env, an);
    if ak == "S" {
        return "OoStr";
    }
    if ak == "I" {
        return "long long";
    }
    if an == "toks" || an == "brw" || an == "mr" || an == "args" {
        return "OoStr";
    }
    return "long long";
}

pub fn c_infer_list_kind(env: String, op: String, a0: String, a1: String) -> String {
    if op == "list_new" {
        let ann: String = c_env_get(env, "__ann__");
        if ann == "S" || ann == "I" {
            return ann;
        }
        return "I";
    }
    if op == "list_push" {
        // string payload → S (avoid cycle with c_expr_is_str)
        if chars_len(a1) >= 9 {
            if char_at(a1, 0) == "o" && char_at(a1, 3) == "s" {
                return "S";
            }
        }
        if chars_len(a1) >= 2 {
            let last = char_at(a1, chars_len(a1) - 1);
            let prev = char_at(a1, chars_len(a1) - 2);
            if last == "L" && prev == "L" {
                return "I";
            }
        }
    }
    if chars_len(a0) > 0 {
        let k0: String = c_env_get(env, a0);
        if k0 == "S" || k0 == "I" {
            return k0;
        }
        if chars_len(a0) >= 9 {
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "s" && char_at(a0, 4) == "l" {
                return "S";
            }
            if char_at(a0, 0) == "o" && char_at(a0, 3) == "i" && char_at(a0, 4) == "l" {
                return "I";
            }
        }
    }
    return "I";
}
// package: backend-c — emit floor
// job: C call-arg helpers (cap lit, last arg, drop first)
// stage: emit

pub fn c_rhs_is_unwrap(rhs: String) -> Bool {
    let n = chars_len(rhs);
    if n < 24 {
        return false;
    }
    if char_at(rhs, 0) != "(" || char_at(rhs, 1) != "(" {
        return false;
    }
    let mut i = 0;
    while i + 6 < n {
        if char_at(rhs, i) == "u" && char_at(rhs, i + 1) == "n" {
            if char_at(rhs, i + 2) == "w" && char_at(rhs, i + 3) == "r" {
                if char_at(rhs, i + 4) == "a" && char_at(rhs, i + 5) == "p" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Product ints lower as NNNLL — magic-int cap forge must not pass emit.
pub fn c_arg_is_int_lit(a: String) -> Bool {
    let n = chars_len(a);
    if n < 3 {
        return false;
    }
    if char_at(a, n - 1) != "L" {
        return false;
    }
    if char_at(a, n - 2) != "L" {
        return false;
    }
    let c0 = char_at(a, 0);
    if c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
        return true;
    }
    if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
        return true;
    }
    return false;
}

// Sealed first arg must be a bare cap IDENT (fs/sys/env/param), not lit/call.
pub fn c_arg_is_cap_ident(a: String) -> Bool {
    let n = chars_len(a);
    if n == 0 {
        return false;
    }
    if c_arg_is_int_lit(a) {
        return false;
    }
    let mut i = 0;
    while i < n {
        let c = char_at(a, i);
        if c == "(" || c == ")" || c == " " || c == "," || c == "\"" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Last top-level C arg (sys_exec shell string is last). String-aware: commas
// inside "..." / escapes do not split (audit residual close).
pub fn c_sys_exec_last_arg(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return "oo_str_lit(\"\")";
    }
    let mut last_start = 0;
    let mut i = 0;
    let mut in_str = false;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "(" {
            depth = depth + 1;
            i = i + 1;
        } else if c == ")" {
            depth = depth - 1;
            i = i + 1;
        } else if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        last_start = j;
                        j = n;
                    }
                }
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    // CRIT 7.2: one str_slice for the last arg span — no per-char OoStr thrash.
    // Runtime: product oodac T c_sys_exec_last_arg calls oo_str_slice×1, 0 concat,
    // no char[N]. chs_rt has no copy (oo_sys_exec is fork+execvp, other ABI).
    if last_start >= n {
        return args;
    }
    let out = str_slice(args, last_start, n);
    if out == "" {
        return args;
    }
    return out;
}

// Drop first top-level arg: write_file(fs, path, content) → path, content.
pub fn c_args_drop_first(args: String) -> String {
    let n = chars_len(args);
    let mut i = 0;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if c == "(" {
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
        }
        if c == "," {
            if depth == 0 {
                let mut j = i + 1;
                while j < n {
                    if char_at(args, j) == " " {
                        j = j + 1;
                    } else {
                        // Same as last-arg: slice remainder once (no per-char concat).
                        return str_slice(args, j, n);
                    }
                }
                return "";
            }
        }
        i = i + 1;
    }
    return args;
}

// Strip CR from C-level argv source. Fixes CR-in-argv bug (8.6):
// argv must not contain CR (codepoint 13) at runtime. Forms:
//   (1) bare CR byte 13 (CRLF source) — NOT Ooda "\r" (that matches letter r)
//   (2) 2-char C escape `\r` from c_escape_str_text on real CR
// CRITICAL: never test c == "\r" — Ooda "\r" == letter r and would strip every 'r'
// (oo_str_lit → oo_st_lit, "true" → "tue") and break ProcessCap sys_exec emit.
pub fn c_args_strip_cr(args: String) -> String {
    let n = chars_len(args);
    if n == 0 {
        return args;
    }
    // 8.6: keep-run str_slice (not per-char). Filter is not one span.
    let mut out = "";
    let mut i = 0;
    let mut run = 0;
    while i < n {
        let c = char_at(args, i);
        // Bare CR only (byte 13). Letter r is byte 114 — must pass through.
        let mut cut = 0;
        if byte_at(c, 0) == 13 {
            cut = 1;
        }
        if c == "\\" && (i + 1) < n && char_at(args, i + 1) == "r" {
            cut = 2;
        }
        if cut > 0 {
            if i > run {
                out = out + str_slice(args, run, i);
            }
            i = i + cut;
            run = i;
        } else {
            i = i + 1;
        }
    }
    if run == 0 {
        return args;
    }
    if run < n {
        out = out + str_slice(args, run, n);
    }
    return out;
}

// Count top-level C args (string-aware commas). Used for sys_exec argv arity.
pub fn c_count_top_args(args: String) -> Int {
    let n = chars_len(args);
    if n == 0 {
        return 0;
    }
    let mut count = 1;
    let mut i = 0;
    let mut in_str = false;
    let mut depth = 0;
    while i < n {
        let c = char_at(args, i);
        if in_str {
            if c == "\\" {
                if i + 1 < n {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if c == "\"" {
                in_str = false;
                i = i + 1;
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "(" {
            depth = depth + 1;
            i = i + 1;
        } else if c == ")" {
            depth = depth - 1;
            i = i + 1;
        } else if c == "," {
            if depth == 0 {
                count = count + 1;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return count;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: call args + method lowering for emit
// stage: emit
// helpers: c_emit_args.oo

pub fn c_emit_call_args(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let mut a0 = "";
    let mut a1 = "";
    let mut a2 = "";
    let mut args = "";
    let mut first = true;
    let mut ac = 0;
    while p < n {
        let ak: String = field_at(list_get(toks, p), 0);
        if ak == "RPAREN" {
            p = p + 1;
            break;
        }
        if ak == "COMMA" {
            p = p + 1;
        } else {
            let pr: List[String] = c_emit_expr_c(toks, p, n, env);
            p = parse_int(list_get(pr, 0));
            let a = list_get(pr, 1);
            if ac == 0 {
                a0 = a;
            }
            if ac == 1 {
                a1 = a;
            }
            if ac == 2 {
                a2 = a;
            }
            ac = ac + 1;
            if first {
                args = a;
                first = false;
            } else {
                args = args + ", " + a;
            }
        }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, args);
    out = list_push(out, a0);
    out = list_push(out, a1);
    out = list_push(out, a2);
    return out;
}

// pos at DOT after receiver primary text `recv`. Lowers .to_string/.contains/.len/.is_ok/.is_err
pub fn c_emit_method(toks: List[String], pos: Int, n: Int, env: String, recv: String) -> List[String] {
    let mut p = pos;
    // DOT
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" {
        let mut bad: List[String] = list_new();
        bad = list_push(bad, p.to_string());
        bad = list_push(bad, recv);
        return bad;
    }
    let mname: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    let mut margs = "";
    let mut a0 = "";
    let mut a1 = "";
    let mut a2 = "";
    let mut call = recv + "." + mname;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        let ap: List[String] = c_emit_call_args(toks, p, n, env);
        p = parse_int(list_get(ap, 0));
        margs = list_get(ap, 1);
        a0 = list_get(ap, 2);
        a1 = list_get(ap, 3);
        a2 = list_get(ap, 4);
        call = recv + "." + mname + "(" + margs + ")";
    }
    // CRIT 2.2: method sinks must run the same secret guard as free calls
    c_secret_emit_guard(env, mname, a0, a1, a2, margs);
    if mname == "to_string" {
        call = "oo_int_to_str(" + recv + ")";
    }
    if mname == "contains" {
        call = "oo_str_contains(" + recv + ", " + margs + ")";
    }
    if mname == "len" {
        let rk: String = c_env_get(env, recv);
        if rk == "S" || rk == "I" {
            call = c_list_c_name("list_len", rk) + "(" + recv + ")";
        } else {
            call = "oo_chars_len(" + recv + ")";
        }
    }
    if mname == "is_ok" {
        call = "(" + recv + ".ok)";
    }
    if mname == "is_err" {
        call = "(!" + recv + ".ok)";
    }
    if mname == "unwrap" {
        // OoResS (.val) vs OoResV (no payload on Ok — empty str; Err via .err message)
        let rk: String = c_env_get(env, recv);
        if rk == "V" {
            call = "((" + recv + ".ok) ? (oo_str_lit(\"\")) : (oo_print_str(oo_str_lit(\"ERR\\tunwrap\")), oo_println(), oo_process_exit(1), oo_str_lit(\"\")))";
        } else {
            call = "((" + recv + ".ok) ? (" + recv + ".val) : (oo_print_str(oo_str_lit(\"ERR\\tunwrap\")), oo_println(), oo_process_exit(1), " + recv + ".val))";
        }
    }
    // CAP-G1/T4 residual: flight-recorder wrap disabled — incomplete preamble
    // redefines break sealed free-call lower / unknown-call annotation.
    // call = "(OO_FLIGHT_RECORDER_LOG(), " + call + ")";
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, call);
    return out;
}

// M166 path A: IDENT [ expr ] → list_get lower (array index sugar; not pointer arith).
// pos at LBRACKET; base is the list C expression (usually IDENT name).
pub fn c_emit_index_get(toks: List[String], pos: Int, n: Int, env: String, base: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let idx = list_get(pr, 1);
    if p < n && field_at(list_get(toks, p), 0) == "RBRACKET" {
        p = p + 1;
    }
    let lk: String = c_infer_list_kind(env, "list_get", base, idx);
    let cname: String = c_list_c_name("list_get", lk);
    let call = cname + "(" + base + ", " + idx + ")";
    if p < n && field_at(list_get(toks, p), 0) == "DOT" {
        return c_emit_method(toks, p, n, env, call);
    }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, call);
    return out;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: lower CHS expr tokens to C snippets (primary + expr); stage: emit
// returns [new_pos_str, c_text]; env = "name=S;..." for list kind.
pub fn c_emit_pack2(pos_s: String, text: String) -> List[String] {
    let mut o: List[String] = list_new();
    o = list_push(o, pos_s);
    o = list_push(o, text);
    return o;
}
pub fn c_emit_primary_c(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos;
    let k: String = field_at(list_get(toks, p), 0);
    let t: String = field_at(list_get(toks, p), 3);
    let p1 = p + 1;
    if k == "INT" {
        return c_emit_pack2(p1.to_string(), t + "LL");
    }
    // FLOAT token → C double literal (IEEE Float; no decimal type)
    if k == "FLOAT" {
        return c_emit_pack2(p1.to_string(), t);
    }
    if k == "STRING" {
        return c_emit_pack2(p1.to_string(), "oo_str_lit(\"" + c_escape_str_text(t) + "\")");
    }
    if k == "KW_TRUE" {
        return c_emit_pack2(p1.to_string(), "1");
    }
    if k == "KW_FALSE" {
        return c_emit_pack2(p1.to_string(), "0");
    }
    // Grouping: (expr) — required for (ri + 1) < rn and field_at emit
    if k == "LPAREN" {
        p = p + 1;
        let pr: List[String] = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(pr, 0));
        let inner = list_get(pr, 1);
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
        return c_emit_pack2(p.to_string(), "(" + inner + ")");
    }
    // Unary ! and - (prefix at primary position)
    if k == "BANG" || t == "!" {
        p = p + 1;
        let pru: List[String] = c_emit_primary_c(toks, p, n, env);
        p = parse_int(list_get(pru, 0));
        return c_emit_pack2(p.to_string(), "(!" + list_get(pru, 1) + ")");
    }
    if k == "MINUS" || t == "-" {
        p = p + 1;
        let prm: List[String] = c_emit_primary_c(toks, p, n, env);
        p = parse_int(list_get(prm, 0));
        return c_emit_pack2(p.to_string(), "(-" + list_get(prm, 1) + ")");
    }
    if k == "IDENT" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "DOT" {
            return c_emit_method(toks, p, n, env, t);
        }
        if c_is_struct_lit_lbrace(toks, p, n) {
            p = p + 1;
            let mut fields = "";
            let mut first_f = true;
            while p < n && field_at(list_get(toks, p), 0) != "RBRACE" {
                if field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1; }
                let fname: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                if p < n && field_at(list_get(toks, p), 0) == "COLON" { p = p + 1; }
                let prf: List[String] = c_emit_expr_c(toks, p, n, env);
                p = parse_int(list_get(prf, 0));
                let fval = list_get(prf, 1);
                if first_f {
                    fields = "." + fname + " = " + fval;
                    first_f = false;
                } else {
                    fields = fields + ", ." + fname + " = " + fval;
                }
            }
            if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
            return c_emit_pack2(p.to_string(), "((" + t + "){ " + fields + " })");
        }
        if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
            p = p + 1;
            let ap: List[String] = c_emit_call_args(toks, p, n, env);
            p = parse_int(list_get(ap, 0));
            let args = list_get(ap, 1);
            let a0 = list_get(ap, 2);
            let a1 = list_get(ap, 3);
            let a2g = list_get(ap, 4);
            c_secret_emit_guard(env, t, a0, a1, a2g, args);
            let mut cname: String = c_lower_call_name(t);
            // index_get → list_get (M166 free-name alias)
            let mut list_op = t;
            if t == "index_get" { list_op = "list_get"; }
            if list_op == "list_new" || list_op == "list_push" || list_op == "list_get" || list_op == "list_len" {
                cname = c_list_c_name(list_op, c_infer_list_kind(env, list_op, a0, a1));
            }
            // Result constructors → OoResS compound (ok=1 Ok, ok=0 Err; val holds payload)
            let mut call = t + "(" + args + ")";
            if t == "Ok" {
                if c_expr_is_str_env(args, env) {
                    call = "((OoResS){1, " + args + "})";
                } else {
                    call = "((OoResS){1, oo_int_to_str(" + args + ")})";
                }
            } else if t == "Err" {
                call = "((OoResS){0, " + args + "})";
            } else if t == "meta_epoch" {
                // Path-A metamorphic floor: process-local epoch (0-arg).
                call = "oo_meta_epoch()";
            } else if t == "meta_mix" {
                call = "oo_meta_mix(" + args + ")";
            } else if t == "meta_is_path_a" {
                call = "oo_meta_is_path_a()";
            } else if t == "meta_decoy_touch" {
                call = "(oo_meta_decoy_touch(), 0)";
            } else if t == "process_exit" {
                // process_exit(code) → oo_process_exit(code)
                call = "oo_process_exit(" + args + ")";
            } else if t == "read_file" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tread_file requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_read_file(" + a0 + ", " + a1 + ")";
            } else if t == "write_file" {
                // write_file(fs, path, content) — pass cap IDENT only
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\twrite_file requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_write_file(" + args + ")";
            } else if t == "path_exists" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tpath_exists requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_path_exists(" + a0 + ", " + a1 + ")";
            } else if t == "file_size" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tfile_size requires &FsCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_file_size(" + a0 + ", " + a1 + ")";
            } else if t == "env_get" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tenv_get requires &EnvCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_env_get(" + a0 + ", " + a1 + ")";
            } else if t == "sys_exec" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tsys_exec requires &ProcessCap or &SysCap as first arg (not int/lit)");
                    process_exit(1);
                }
                let rest: String = c_args_drop_first(args);
                if rest == "" {
                    println("ERR\tc_emit\tsys_exec requires program argv");
                    process_exit(1);
                }
                call = "oo_sys_exec(" + a0 + ", (int)(sizeof((OoStr[]){" + c_args_strip_cr(rest)
                    + "})/sizeof(OoStr)), (OoStr[]){" + c_args_strip_cr(rest) + "})";
            } else if t == "fetch" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tfetch requires &NetCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_fetch(" + a0 + ", " + a1 + ")";
            } else if t == "now_ms" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tnow_ms requires &TimeCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_now_ms(" + a0 + ")";
            } else if t == "sleep_ms" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tsleep_ms requires &TimeCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_sleep_ms(" + a0 + ", " + a1 + ")";
            } else if t == "random" {
                if !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\trandom requires &RandCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_random(" + a0 + ")";
            } else if t == "seed" {
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\tseed requires &RandCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_seed(" + a0 + ", " + a1 + "), 0)";
            } else if t == "alloc_bytes" || t == "malloc" {
                // M17/M166: alloc_bytes|malloc(alloc, n) — cap IDENT first; process-local only
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\t" + t + " requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "oo_alloc_bytes(" + a0 + ", " + a1 + ")";
            } else if t == "free_bytes" || t == "free" {
                // M166: free(alloc, p) aliases free_bytes → oo_free_bytes
                if a1 == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\t" + t + " requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_free_bytes(" + a0 + ", " + a1 + "), 0)";
            } else if t == "realloc" {
                // M166 path A: realloc(alloc, p, n) = free p then alloc n (quota token, not OS realloc)
                if a1 == "" || a2g == "" || !c_arg_is_cap_ident(a0) {
                    println("ERR\tc_emit\trealloc requires &AllocCap as first arg (not int/lit)");
                    process_exit(1);
                }
                call = "(oo_free_bytes(" + a0 + ", " + a1 + "), oo_alloc_bytes(" + a0 + ", " + a2g + "))";
            } else if is_sealed_net(t) && c_emit_libfloor_call(t, a0, a1, args) == "" {
                // residual net free names only; libfloor path A handled next
                println("ERR\tc_emit\tnet residual: sealed op '" + t + "' not lowered (fail-closed)");
                process_exit(1);
            } else if c_emit_libfloor_call(t, a0, a1, args) != "" {
                call = c_emit_libfloor_call(t, a0, a1, args);
            } else if is_sealed_ffi(t) {
                println("ERR\tc_emit\tffi residual: sealed op '" + t + "' not lowered (no host/C TCB lower)");
                process_exit(1);
            } else if cname != "" {
                call = cname + "(" + args + ")";
            }
            // CAP-G1/T4 residual: flight-recorder wrap disabled (incomplete preamble).
            // call = "(OO_FLIGHT_RECORDER_LOG(), " + call + ")";
            if p < n && field_at(list_get(toks, p), 0) == "DOT" {
                return c_emit_method(toks, p, n, env, call);
            }
            return c_emit_pack2(p.to_string(), call);
        }
        // M166: xs[i] → list_get (LBRACKET sugar)
        if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
            return c_emit_index_get(toks, p, n, env, t);
        }
        return c_emit_pack2(p.to_string(), t);
    }
    let p_end = p + 1;
    return c_emit_pack2(p_end.to_string(), t);
}
// package: backend-c — emit floor
// job: M166 NetCap free-name lowers (tcp/udp slots + sock_raw residual)
// stage: emit
// returns C call snippet, or "" if not a net free call

pub fn c_emit_netio_call(t: String, a0: String, a1: String, args: String) -> String {
    if t == "tcp_bind" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_bind requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_bind(" + a0 + ", " + a1 + ")";
    }
    if t == "tcp_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_connect(" + args + ")";
    }
    if t == "bind_udp" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tbind_udp requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_bind_udp(" + a0 + ", " + a1 + ")";
    }
    if t == "tls_connect" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttls_connect requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tls_connect(" + args + ")";
    }
    // process-local fd slots: connect/bind → Ok("fd:N"); IO by Int slot
    if t == "tcp_write" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_write requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_write(" + args + ")";
    }
    if t == "tcp_read" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_read requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_read(" + args + ")";
    }
    if t == "udp_recv" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tudp_recv requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_udp_recv(" + args + ")";
    }
    if t == "tcp_close" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\ttcp_close requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_tcp_close(" + a0 + ", " + a1 + ")";
    }
    if t == "sock_raw" || t == "raw_socket" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsock_raw requires &NetCap first arg");
            process_exit(1);
        }
        return "oo_sock_raw(" + args + ")";
    }
    return "";
}
// package: backend-c — emit floor
// job: M166 SysCap free-name lowers (process residual + OS syscall seals)
// stage: emit
// returns C call snippet, or "" if not a sys free call
// residual honesty: epoll/inotify/prctl = require Sys then Err (not full async I/O)

pub fn c_emit_sys_call(t: String, a0: String, a1: String, args: String) -> String {
    if t == "sys_spawn" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_spawn requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_spawn(" + a0 + ", " + a1 + ")";
    }
    if t == "sys_wait" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_wait requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_wait(" + a0 + ", " + a1 + ")";
    }
    if t == "sys_kill" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_kill requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_kill(" + args + ")";
    }
    // M166 path A: sealed OS syscall stubs under SysCap (residual Err, not product async)
    if t == "sys_epoll_create" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_epoll_create requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_epoll_create(" + a0 + ", " + a1 + ")";
    }
    if t == "sys_inotify_init" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_inotify_init requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_inotify_init(" + a0 + ")";
    }
    if t == "sys_prctl" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tsys_prctl requires &SysCap first arg");
            process_exit(1);
        }
        return "oo_sys_prctl(" + a0 + ", " + a1 + ")";
    }
    return "";
}
// package: backend-c — emit floor
// job: M161 library free-name lowers (net/sys/thread/gpu/crypto path A)
// stage: emit
// returns C call snippet, or "" if name not a libfloor free call

// t = callee name; a0/a1 = first two arg C texts; args = full comma-joined args
pub fn c_emit_libfloor_call(t: String, a0: String, a1: String, args: String) -> String {
    // NetCap path A (M162/M166): tcp_*/bind_udp/tls/sock_raw → c_emit_netio.oo
    let netio: String = c_emit_netio_call(t, a0, a1, args);
    if netio != "" {
        return netio;
    }
    // SysCap path A: process residual + M166 OS syscall seals → c_emit_sys.oo
    let sysio: String = c_emit_sys_call(t, a0, a1, args);
    if sysio != "" {
        return sysio;
    }
    if t == "mutex_lock" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tmutex_lock requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_mutex_lock(" + a0 + ", " + a1 + ")";
    }
    if t == "mutex_unlock" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tmutex_unlock requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_mutex_unlock(" + a0 + ", " + a1 + ")";
    }
    if t == "thread_spawn" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tthread_spawn requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_thread_spawn(" + a0 + ", " + a1 + ")";
    }
    // Prefer Int slot: thread_join(thread, 0). String "tid:N" → oo_thread_join_s.
    if t == "thread_join" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tthread_join requires &ThreadCap first arg");
            process_exit(1);
        }
        // Int slot → oo_thread_join; string lit / OoStr expr → oo_thread_join_s
        if a1.contains("oo_str") || a1.contains("\"") {
            return "oo_thread_join_s(" + a0 + ", " + a1 + ")";
        }
        return "oo_thread_join(" + a0 + ", " + a1 + ")";
    }
    // M164: process-local channels under ThreadCap (Int slot preferred)
    if t == "channel_new" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tchannel_new requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_channel_new(" + a0 + ")";
    }
    if t == "channel_send" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tchannel_send requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_channel_send(" + args + ")";
    }
    if t == "channel_recv" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tchannel_recv requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_channel_recv(" + a0 + ", " + a1 + ")";
    }
    // M165 path A: thin actors under ThreadCap (joinable thread + mailbox)
    if t == "actor_spawn" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tactor_spawn requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_actor_spawn(" + a0 + ", " + a1 + ")";
    }
    if t == "actor_send" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tactor_send requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_actor_send(" + args + ")";
    }
    if t == "actor_recv" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tactor_recv requires &ThreadCap first arg");
            process_exit(1);
        }
        return "oo_actor_recv(" + a0 + ", " + a1 + ")";
    }
    // ZT path A: HITL requires &EnvCap + &FsCap (runtime require + policy env allowlist)
    if t == "verify_human" {
        if a1 == "" || !c_arg_is_cap_ident(a0) || !c_arg_is_cap_ident(a1) {
            println("ERR\tc_emit\tverify_human requires &EnvCap, &FsCap, msg");
            process_exit(1);
        }
        return "oo_verify_human(" + args + ")";
    }
    if t == "gpu_launch" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tgpu_launch requires &GpuCap first arg");
            process_exit(1);
        }
        return "oo_gpu_launch(" + a0 + ", " + a1 + ")";
    }
    // M156/M165: UnsafeFFICap — OS dlopen allowlist + dlsym/dlclose residual stubs
    if t == "dlopen" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tdlopen requires &UnsafeFFICap as first arg (not int/lit)");
            process_exit(1);
        }
        return "oo_dlopen(" + a0 + ", " + a1 + ")";
    }
    if t == "dlsym" {
        if !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tdlsym requires &UnsafeFFICap as first arg (not int/lit)");
            process_exit(1);
        }
        return "oo_dlsym(" + args + ")";
    }
    if t == "dlclose" {
        if a1 == "" || !c_arg_is_cap_ident(a0) {
            println("ERR\tc_emit\tdlclose requires &UnsafeFFICap as first arg (not int/lit)");
            process_exit(1);
        }
        return "oo_dlclose(" + a0 + ", " + a1 + ")";
    }
    if t == "crypto_md5_internal" {
        return "crypto_md5_internal(" + args + ")";
    }
    if t == "crypto_sha1_internal" {
        return "crypto_sha1_internal(" + args + ")";
    }
    if t == "crypto_aes_encrypt_internal" {
        return "crypto_aes_encrypt_internal(" + args + ")";
    }
    if t == "byte_at" {
        return "oo_byte_at(" + args + ")";
    }
    // M166: ord(s) = first byte 0..255, or -1 if empty (path A via byte_at)
    // M166: bit_xor(a,b) → (a^b) free name (caret token residual on some hosts)
    if t == "bit_xor" {
        return "(" + a0 + " ^ " + a1 + ")";
    }
    if t == "ord" {
        return "oo_byte_at(" + args + ", 0)";
    }
    if t == "bytes_len" {
        return "oo_bytes_len(" + args + ")";
    }
    if t == "byte_slice" {
        return "oo_byte_slice(" + args + ")";
    }
    if t == "bytes_eq" {
        return "oo_bytes_eq(" + args + ")";
    }
    // M164 path A: String byte view + List[Int] 0..255 buffer (not &str / List[Byte])
    if t == "bytes_from_str" {
        return "oo_bytes_from_str(" + args + ")";
    }
    if t == "bytes_concat" {
        return "oo_bytes_concat(" + args + ")";
    }
    if t == "bytes_new" {
        return "oo_bytes_new()";
    }
    if t == "bytes_push" {
        return "oo_bytes_push(" + args + ")";
    }
    if t == "bytes_get" {
        return "oo_bytes_get(" + args + ")";
    }
    if t == "bytes_to_str" {
        return "oo_bytes_to_str(" + args + ")";
    }
    // M165 path A: owned string ops (byte index; not &str borrow)
    if t == "str_starts_with" {
        return "oo_str_starts_with(" + args + ")";
    }
    if t == "str_ends_with" {
        return "oo_str_ends_with(" + args + ")";
    }
    if t == "str_index_of" {
        return "oo_str_index_of(" + args + ")";
    }
    if t == "str_repeat" {
        return "oo_str_repeat(" + args + ")";
    }
    if t == "str_to_uppercase" {
        return "oo_str_to_uppercase(" + args + ")";
    }
    // M166 path A: IEEE double math (Float → double; free names lower to oo_*)
    if t == "sin" { return "oo_sin(" + args + ")"; }
    if t == "cos" { return "oo_cos(" + args + ")"; }
    if t == "ln" { return "oo_ln(" + args + ")"; }
    if t == "exp" { return "oo_exp(" + args + ")"; }
    if t == "sqrt" { return "oo_sqrt(" + args + ")"; }
    if t == "pow" { return "oo_pow(" + args + ")"; }
    return "";
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: lower CHS expr tokens to C snippets (list/string builtins)
// in:  toks + start pos (at first expr token)
// out: via side-effect helpers; c_emit_expr_c returns C text, advances via c_emit_expr_end
// stage: emit

// Map known call names to C runtime (empty string = unknown).

pub fn c_emit_println(toks: List[String], pos: Int, n: Int, env: String) -> Int {
    let mut p = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" { p = p + 1; }
    let mut cont = true;
    while cont {
        if p >= n || field_at(list_get(toks, p), 0) == "RPAREN" {
            cont = false;
            break;
        }
        let mut sp = p;
        let mut d = 0;
        while sp < n {
            let sk: String = field_at(list_get(toks, sp), 0);
            if sk == "LPAREN" {
                d = d + 1;
            } else if sk == "RPAREN" {
                if d <= 0 {
                    break;
                }
                d = d - 1;
            } else if sk == "COMMA" || sk == "SEMI" {
                if d <= 0 {
                    break;
                }
            }
            if sk == "IDENT" {
                let sn: String = field_at(list_get(toks, sp), 3);
                if c_env_get(env, "__sec__" + sn) == "1" {
                    c_secret_refuse_println_ident(env, sn);
                }
            }
            sp = sp + 1;
        }
        let pr: List[String] = c_emit_expr_c(toks, p, n, env);
        p = parse_int(list_get(pr, 0));
        let arg = list_get(pr, 1);
        let mut is_str: Bool = c_expr_is_str_env(arg, env);
        let mut is_bool = false;
        if chars_len(arg) >= 10 && char_at(arg, 3) == "c" && char_at(arg, 4) == "h" && char_at(arg, 5) == "a" {
            if char_at(arg, 8) == "i" { is_bool = true; is_str = false; }
        }
        // M166: double Float / oo_* math / float lits → %g
        let mut is_dbl: Bool = false;
        if c_env_get(env, arg) == "F" {
            is_dbl = true;
        }
        if !is_dbl {
            let cnm: String = c_rhs_call_name(arg);
            if cnm != "" {
                if c_call_result_ty(cnm) == "double" {
                    is_dbl = true;
                }
            }
        }
        if !is_dbl {
            let c0 = char_at(arg, 0);
            if c0 == "-" || char_is_digit(c0) {
                let mut di = 1;
                let an = chars_len(arg);
                while di < an {
                    if char_at(arg, di) == "." {
                        is_dbl = true;
                    }
                    di = di + 1;
                }
            }
        }
        if is_str {
            println("  oo_print_str(" + arg + ");");
        } else if is_bool {
            println("  oo_print_bool(" + arg + ");");
        } else if is_dbl {
            println("  oo_print_double(" + arg + ");");
        } else {
            println("  oo_print_int(" + arg + ");");
        }
        if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
            p = p + 1;
        } else {
            cont = false;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    println("  oo_println();");
    return p;
}


// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: ARC / RAII scope frame tracking & lifetime release emission
// stage: emit
// (empty line to preserve line numbers)
pub fn c_env_push_scope(env: String) -> String {
    return env + "{;";
}

pub fn c_is_formal_param(env: String, name: String) -> Int {
    if c_env_get(env, "__formal__" + name) == "1" {
        return 1;
    }
    return 0;
}

pub fn c_emit_scope_exit(env: String) -> String {
    let elen = chars_len(env);
    let mut last_idx = -1;
    let mut i = 0;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            last_idx = i;
        }
        i = i + 1;
    }
    if last_idx < 0 {
        return env;
    }
    let top_frame = str_slice(env, last_idx + 2, elen);
    let flen = chars_len(top_frame);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < flen {
        let ch = char_at(top_frame, p);
        if ch == "=" {
            if p + 1 < flen {
                let kind = char_at(top_frame, p + 1);
                names = list_push(names, name);
                kinds = list_push(kinds, kind);
            }
            name = "";
            p = p + 2;
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                if kind == "T" { println("  /* no release formal " + name_var + " */"); }
                if kind == "S" { println("  /* no release formal " + name_var + " */"); }
                if kind == "I" { println("  /* no release formal " + name_var + " */"); }
            } else if c_env_get(env, "__no_arc__") != "1" {
                if kind == "T" { println("  oo_str_release(" + name_var + ");"); }
                if kind == "S" { println("  oo_slist_release(" + name_var + ");"); }
                if kind == "I" { println("  oo_ilist_release(" + name_var + ");"); }
            }
        }
        i_name = i_name - 1;
    }
    return str_slice(env, 0, last_idx);
}

pub fn c_emit_all_scope_releases(env: String) {
    let elen = chars_len(env);
    let mut p = 0;
    let mut name = "";
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < elen {
        let ch = char_at(env, p);
        if ch == "{" {
            name = "";
            p = p + 1;
            if p < elen && char_at(env, p) == ";" {
                p = p + 1;
            }
        } else if ch == "=" {
            if p + 1 < elen {
                let kind = char_at(env, p + 1);
                names = list_push(names, name);
                kinds = list_push(kinds, kind);
            }
            name = "";
            p = p + 2;
        } else {
            if ch != ";" {
                name = name + ch;
            }
            p = p + 1;
        }
    }
    
    let mut i_name = list_len(names) - 1;
    while i_name >= 0 {
        let name_var = list_get(names, i_name);
        let kind = list_get(kinds, i_name);
        let is_internal = chars_len(name_var) >= 2 && char_at(name_var, 0) == "_" && char_at(name_var, 1) == "_";
        if !is_internal && c_env_get(seen, name_var) == "" {
            seen = c_env_put(seen, name_var, "1");
            let is_formal = 0 + c_is_formal_param(env, name_var);
            if is_formal == 1 {
                if kind == "T" { println("  /* no release formal " + name_var + " */"); }
                if kind == "S" { println("  /* no release formal " + name_var + " */"); }
                if kind == "I" { println("  /* no release formal " + name_var + " */"); }
            } else if c_env_get(env, "__no_arc__") != "1" {
                if kind == "T" { println("  oo_str_release(" + name_var + ");"); }
                if kind == "S" { println("  oo_slist_release(" + name_var + ");"); }
                if kind == "I" { println("  oo_ilist_release(" + name_var + ");"); }
            }
        }
        i_name = i_name - 1;
    }
}

// Body locals only: skip pre-scope params/meta (first `{;`). Safe for early return.
pub fn c_emit_local_releases(env: String) {
    let elen = chars_len(env);
    let mut i = 0;
    let mut start = -1;
    while i + 1 < elen {
        if char_at(env, i) == "{" && char_at(env, i + 1) == ";" {
            start = i;
            i = elen;
        } else {
            i = i + 1;
        }
    }
    if start < 0 {
        return;
    }
    c_emit_all_scope_releases(str_slice(env, start, elen));
}

pub fn c_emit_ret_arc(env: String, mut ret_val: String) {
    // main owns args (pre-scope S) — full release OK; non-main never free params.
    if c_env_get(env, "__main__") == "1" {
        c_emit_all_scope_releases(env);
        println("  return 0;");
        return;
    }
    if ret_val == "" || ret_val == "void" {
        c_emit_local_releases(env);
        println("  return;");
        return;
    }
    let k: String = c_env_get(env, ret_val);
    if k == "T" || k == "S" || k == "I" {
        let mut rty = "OoStr";
        if k == "S" { rty = "OoSList"; }
        if k == "I" { rty = "OoIList"; }
        println("  " + rty + " __ret_val = " + ret_val + ";");
        if c_env_get(env, "__no_arc__") != "1" {
            if k == "T" { println("  oo_str_retain(__ret_val);"); }
            if k == "S" { println("  oo_slist_retain(__ret_val);"); }
            if k == "I" { println("  oo_ilist_retain(__ret_val);"); }
        }
        c_emit_local_releases(env);
        println("  return __ret_val;");
        return;
    }
    // All other non-void: stash expr into __ret_val BEFORE local releases (no UAF).
    let mut rty2 = "long long";
    if c_env_get(env, "__ret_str__") == "1" { rty2 = "OoStr"; }
    let ret_kind: String = c_env_get(env, "__ret__");
    if ret_kind == "S" { rty2 = "OoSList"; }
    if ret_kind == "I" { rty2 = "OoIList"; }
    if ret_kind == "R" { rty2 = "OoResS"; }
    if ret_kind == "V" { rty2 = "OoResV"; }
    // M170: prefer explicit C return type from fn signature (user structs)
    let rct: String = c_env_get(env, "__ret_c_ty__");
    if rct != "" && rct != "void" {
        rty2 = rct;
    }
    println("  " + rty2 + " __ret_val = " + ret_val + ";");
    c_emit_local_releases(env);
    println("  return __ret_val;");
}

pub fn c_emit_reassign_arc(name: String, rhs: String, env: String) {
    let k: String = c_env_get(env, name);
    let rk: String = c_env_get(env, rhs);
    if k == "T" {
        if rk == "T" && c_env_get(env, "__no_arc__") != "1" { println("  oo_str_retain(" + rhs + ");"); }
        if c_env_get(env, "__no_arc__") != "1" {
            println("  { OoStr __tmp = " + name + "; " + name + " = " + rhs + "; oo_str_release(__tmp); }");
        } else {
            println("  " + name + " = " + rhs + ";");
        }
    } else if k == "S" {
        if rk == "S" && c_env_get(env, "__no_arc__") != "1" { println("  oo_slist_retain(" + rhs + ");"); }
        if c_env_get(env, "__no_arc__") != "1" {
            println("  { OoSList __tmp = " + name + "; " + name + " = " + rhs + "; oo_slist_release(__tmp); }");
        } else {
            println("  " + name + " = " + rhs + ";");
        }
    } else if k == "I" {
        if rk == "I" && c_env_get(env, "__no_arc__") != "1" { println("  oo_ilist_retain(" + rhs + ");"); }
        if c_env_get(env, "__no_arc__") != "1" {
            println("  { OoIList __tmp = " + name + "; " + name + " = " + rhs + "; oo_ilist_release(__tmp); }");
        } else {
            println("  " + name + " = " + rhs + ";");
        }
    } else {
        println("  " + name + " = " + rhs + ";");
    }
}

// After `let name = rhs` when rhs is a named ARC value (env T/S/I).
pub fn c_emit_let_alias_retain(name: String, rhs: String, lty: String, env: String) {
    if lty != "OoStr" && lty != "OoSList" && lty != "OoIList" {
        return;
    }
    let rk: String = c_env_get(env, rhs);
    if rk != "T" && rk != "S" && rk != "I" {
        return;
    }
    if c_env_get(env, "__no_arc__") != "1" {
        if lty == "OoStr" {
            println("  oo_str_retain(" + name + ");");
        }
        if lty == "OoSList" {
            println("  oo_slist_retain(" + name + ");");
        }
        if lty == "OoIList" {
            println("  oo_ilist_retain(" + name + ");");
        }
    }
}

// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: untyped bind type inference helpers split from c_emit_let
// stage: emit
// M167: free-name short-circuit before mega c_call_result_ty (stale hosts SEGV)
// M171+ tc/env crt tables: c_emit_let_ext_crt.oo (MOVE, not DUP)
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: untyped-let crt name tables peeled from c_emit_let_ext (M171 + tc/env)
// stage: emit
// MOVE not DUP: field/cap/skip/Result/tc tables live only here

pub fn c_emit_let_untyped_crt(cnm: String, rhs: String) -> String {
    let mut crt: String = "";
    // M171: token/check free names that hit SEGV via mega c_call_result_ty on tip hosts
    if cnm == "field_at" || cnm == "field_decode3" || cnm == "tok_line" || cnm == "keyword_kind"
        || cnm == "cap_bag_put" || cnm == "sealed_kind_of" || cnm == "path_join"
        || cnm == "path_dirname" || cnm == "path_marker" || cnm == "set_add"
        || cnm == "parse_import_line" || cnm == "content_hash" || cnm == "check_cache_root"
        || cnm == "check_cache_path" || cnm == "check_cache_mod_key" || cnm == "check_cache_tree_key"
        || cnm == "strip_import_lines" || cnm == "scan_fn_names" || cnm == "c_env_get"
        || cnm == "c_env_put" || cnm == "c_env_put_last" || cnm == "c_ty_at"
        || cnm == "c_peek_list_elem" || cnm == "c_escape_str_text" || cnm == "shell_sq"
        || cnm == "path_normalize" {
        crt = "OoStr";
    }
    if cnm == "is_cap_type" || cnm == "is_sealed_net" || cnm == "is_sealed_fs"
        || cnm == "is_sealed_sys" || cnm == "is_sealed_env" || cnm == "is_sealed_alloc"
        || cnm == "is_sealed_ffi" || cnm == "is_sealed_time" || cnm == "is_sealed_rand"
        || cnm == "is_sealed_thread" || cnm == "is_sealed_gpu" || cnm == "set_has"
        || cnm == "cap_bag_has" || cnm == "path_exists" || cnm == "oo_path_exists" || cnm == "check_cache_hit"
        || cnm == "oo_str_eq" || cnm == "match_rparen" {
        crt = "int";
    }
    if cnm == "skip_until_semi" || cnm == "skip_balanced" || cnm == "skip_primary"
        || cnm == "check_function" || cnm == "file_size" || cnm == "oo_file_size" || cnm == "c_emit_skip_type"
        || cnm == "c_emit_skip_braces" || cnm == "c_emit_skip_contracts"
        || cnm == "c_emit_skip_verify" {
        crt = "long long";
    }
    // pack / emit helpers → List[String] (try_scan_* stay in c_emit_let_ext)
    if cnm == "lex_step" || cnm == "pack_tok" || cnm == "pack_err" || cnm == "pack_skip"
        || cnm == "c_emit_expr_c" || cnm == "c_emit_stmt" || cnm == "c_pack_pos_env" {
        crt = "OoSList";
    }
    // Result-returning sealed / host calls (untyped let must not default to long long)
    if cnm == "read_file" || cnm == "oo_read_file" || cnm == "env_get" || cnm == "oo_env_get"
        || cnm == "sys_exec" || cnm == "oo_sys_exec1" || cnm == "oo_sys_exec"
        || cnm == "fetch" || cnm == "oo_fetch" || cnm == "lex_all" || cnm == "chs_build"
        || cnm == "dlopen" || cnm == "oo_dlopen" || cnm == "dlsym" || cnm == "oo_dlsym"
        || cnm == "Ok" || cnm == "Err" {
        crt = "OoResS";
    }
    // Soft path: compound oo_sys_exec(...) when c_rhs_call_name misses nested sizeof
    if crt == "" && chars_len(rhs) >= 10 && rhs.contains("oo_sys_exec") {
        crt = "OoResS";
    }
    if crt == "" && chars_len(rhs) >= 10 && rhs.contains("oo_read_file") {
        crt = "OoResS";
    }
    if cnm == "write_file" || cnm == "oo_write_file" {
        crt = "OoResV";
    }
    if cnm == "load_source_with_imports" || cnm == "bc_emit_program" || cnm == "wasm_emit_program"
        || cnm == "bc_env_new" || cnm == "c_parse_max_cycles" || cnm == "c_parse_secret_env" {
        crt = "OoStr";
    }
    // Typecheck / env String returns (pure multi: no cross-module __fr__ map)
    if cnm == "resolve_type_alias" || cnm == "env_lookup_var" || cnm == "env_lookup_fn_line" || cnm == "lit_token_type" || cnm == "indent"
        || cnm == "atom_type_with_env" || cnm == "field_chain_type" || cnm == "field_access_type_at"
        || cnm == "infer_typed_expr_type" || cnm == "infer_typed_expr_type_exact"
        || cnm == "combine_binop_types" || cnm == "method_result_type" || cnm == "env_lookup_type"
        || cnm == "operand_type_with_env" || cnm == "resolve_arg_type" || cnm == "struct_field_type"
        || cnm == "build_fn_ret_table" || cnm == "build_pure_lit_env" || cnm == "build_struct_field_table"
        || cnm == "c_rhs_call_name" || cnm == "c_struct_field_c_ty" || cnm == "c_call_result_ty"
        || cnm == "c_lower_call_name" || cnm == "c_list_c_name" || cnm == "c_list_get_result_ty"
        || cnm == "c_ty_at" || cnm == "nth_csv" || cnm == "bin_op_name" || cnm == "c_emit_scope_exit"
        || cnm == "c_env_push_scope" || cnm == "llvm_ty_map" || cnm == "llvm_env_get_var_ty"
        || cnm == "infer_pure_lit_expr_type" || cnm == "lit_env_bind_fn_params"
        || cnm == "c_infer_list_kind" || cnm == "c_args_drop_first" || cnm == "c_sys_exec_last_arg"
        || cnm == "c_binop_apply" || cnm == "c_emit_libfloor_call" || cnm == "c_emit_netio_call"
        || cnm == "c_emit_sys_call" || cnm == "c_emit_index_get" || cnm == "c_emit_pack2" {
        crt = "OoStr";
    }
    if cnm == "load_expand" || cnm == "collect_module_paths" || cnm == "collect_expand"
        || cnm == "tokenize_lines" || cnm == "collect_tokens" || cnm == "c_emit_block"
        || cnm == "c_emit_call_args" || cnm == "c_emit_primary_c" || cnm == "tokenize_lines"
        || cnm == "c_emit_expr_prec" || cnm == "call_arg_prep" || cnm == "ann_prep"
        || cnm == "refine_capture_fn_ret_bound" {
        crt = "OoSList";
    }
    if cnm == "struct_fields_blob" {
        crt = "OoStr";
    }
    return crt;
}

pub fn c_emit_let_untyped_ty(rhs: String, e: String) -> List[String] {
    let mut lty: String = "long long";
    let mut bind_kind: String = "";
    let mut crt: String = "";
    let mut is_num: Bool = false;
    if chars_len(rhs) > 0 {
        let c0: String = char_at(rhs, 0);
        if c0 == "-" || c0 == "0" || c0 == "1" || c0 == "2" || c0 == "3" || c0 == "4" {
            is_num = true;
        }
        if c0 == "5" || c0 == "6" || c0 == "7" || c0 == "8" || c0 == "9" {
            is_num = true;
        }
    }
    // oo_str_lit/concat prefix, or nested concat anywhere
    let mut is_str_expr: Bool = false;
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
            if char_at(rhs, 7) == "l" || char_at(rhs, 7) == "c" { is_str_expr = true; }
        }
    }
    if !is_str_expr && chars_len(rhs) >= 13 && rhs.contains("oo_str_concat") {
        is_str_expr = true;
    }
    if is_num && rhs.contains(".") {
        lty = "double";
        bind_kind = "F";
    } else if is_num {
        lty = "long long";
    } else if is_str_expr {
        lty = "OoStr";
        bind_kind = "T";
    } else {
        let cnm: String = c_rhs_call_name(rhs);
        if cnm == "list_new" || cnm == "oo_ilist_new"
            || cnm == "bytes_new" || cnm == "oo_bytes_new"
            || cnm == "list_push" || cnm == "oo_ilist_push"
            || cnm == "bytes_push" || cnm == "oo_bytes_push" {
            crt = "OoIList";
        }
        if cnm == "bytes_get" || cnm == "oo_bytes_get" {
            crt = "long long";
        }
        if cnm == "bytes_to_str" || cnm == "oo_bytes_to_str"
            || cnm == "bytes_from_str" || cnm == "oo_bytes_from_str"
            || cnm == "bytes_concat" || cnm == "oo_bytes_concat" {
            crt = "OoStr";
        }
        if cnm == "oo_slist_new" || cnm == "oo_slist_push" {
            crt = "OoSList";
        }
        if cnm == "oo_ilist_get" {
            crt = "long long";
        }
        if cnm == "oo_slist_get" {
            crt = "OoStr";
        }
        if cnm == "list_get" {
            crt = c_list_get_result_ty(e, rhs);
        }
        if cnm == "list_len" || cnm == "oo_ilist_len" || cnm == "oo_slist_len" {
            crt = "long long";
        }
        if cnm == "chars_len" || cnm == "oo_chars_len" || cnm == "parse_int" {
            crt = "long long";
        }
        // M167 Int free names (avoid mega-table SEGV on stale hosts after rebuild)
        if cnm == "len" || cnm == "byte_at" || cnm == "oo_byte_at" || cnm == "ord" || cnm == "meta_epoch"
            || cnm == "oo_meta_epoch" || cnm == "meta_mix" || cnm == "oo_meta_mix"
            || cnm == "meta_is_path_a" || cnm == "oo_meta_is_path_a"
            || cnm == "bit_xor" || cnm == "bytes_len" || cnm == "oo_bytes_len"
            || cnm == "alloc_bytes" || cnm == "oo_alloc_bytes" || cnm == "malloc"
            || cnm == "realloc" || cnm == "now_ms" || cnm == "oo_now_ms"
            || cnm == "random" || cnm == "oo_random" {
            crt = "long long";
        }
        if cnm == "sin" || cnm == "cos" || cnm == "ln" || cnm == "exp"
            || cnm == "sqrt" || cnm == "pow"
            || cnm == "oo_sin" || cnm == "oo_cos" || cnm == "oo_ln"
            || cnm == "oo_exp" || cnm == "oo_sqrt" || cnm == "oo_pow" {
            crt = "double";
        }
        if cnm == "char_at" || cnm == "str_slice" || cnm == "int_to_str" || cnm == "to_string" {
            crt = "OoStr";
        }
        if cnm == "oo_char_at" || cnm == "oo_str_slice" || cnm == "oo_int_to_str" {
            crt = "OoStr";
        }
        if cnm == "oo_str_concat" || cnm == "oo_str_lit" {
            crt = "OoStr";
        }
        // M167 smoke floor: try_scan_* stay here (pack/emit rest in crt helper)
        if cnm == "try_scan_ws" || cnm == "try_scan_string" || cnm == "try_scan_number"
            || cnm == "try_scan_ident" || cnm == "try_scan_punct" {
            crt = "OoSList";
        }
        if crt == "" {
            crt = c_emit_let_untyped_crt(cnm, rhs);
        }
        if cnm != "" && crt == "" {
            let fr: String = c_env_get(e, "__fr__" + cnm);
            if fr == "T" {
                crt = "OoStr";
            } else if fr == "S" {
                crt = "OoSList";
            } else if fr == "I" {
                crt = "OoIList";
            }
        }
        // M171: no mega c_call_result_ty (SEGV); unknown free call → Int default
        // superseded by annotation-required fail-closed at emit stage
        if cnm != "" && crt == "" {
            println("ERR\tc_emit\tunknown free call needs annotation\t" + cnm);
            process_exit(1);
        }
        if crt != "" {
            lty = crt;
            if crt == "OoSList" {
                bind_kind = "S";
            }
            if crt == "OoIList" {
                bind_kind = "I";
            }
            if crt == "double" {
                bind_kind = "F";
            }
            if crt == "OoResS" {
                bind_kind = "R";
            }
            if crt == "OoResV" {
                bind_kind = "V";
            }
            if crt == "OoStr" {
                bind_kind = "T";
            }
        } else {
            // bare IDENT: env kind T→OoStr (also S/I/R/V/F)
            let ek: String = c_env_get(e, rhs);
            if ek == "T" {
                lty = "OoStr";
                bind_kind = "T";
            } else if ek == "S" {
                lty = "OoSList";
                bind_kind = "S";
            } else if ek == "I" {
                lty = "OoIList";
                bind_kind = "I";
            } else if ek == "R" {
                lty = "OoResS";
                bind_kind = "R";
            } else if ek == "V" {
                lty = "OoResV";
                bind_kind = "V";
            } else if ek == "F" {
                lty = "double";
                bind_kind = "F";
            } else if chars_len(rhs) >= 9 && char_at(rhs, 0) == "o" {
                if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                    lty = "OoIList";
                    bind_kind = "I";
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                    if chars_len(rhs) >= 11 && char_at(rhs, 9) == "g" {
                        lty = "OoStr";
                        bind_kind = "T";
                    } else {
                        lty = "OoSList";
                        bind_kind = "S";
                    }
                }
                if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "t" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
                if char_at(rhs, 3) == "c" && char_at(rhs, 4) == "h" {
                    lty = "OoStr";
                    bind_kind = "T";
                }
            }
        }
    }
    let mut res: List[String] = list_new();
    res = list_push(res, lty);
    res = list_push(res, bind_kind);
    return res;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: emit let/assign stmts; bind list-kind env
// stage: emit
// untyped ty inference: c_emit_let_ext.c_emit_let_untyped_ty

pub fn c_emit_let_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let k: String = field_at(list_get(toks, p), 0);
    if k == "KW_LET" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
            p = p + 1;
        }
    }
    let name: String = field_at(list_get(toks, p), 3);
    p = p + 1;
    let mut ann_kind: String = "";
    let mut ann_ty: String = "";
    if p < n && field_at(list_get(toks, p), 0) == "COLON" {
        p = p + 1;
        ann_kind = c_peek_list_elem(toks, p, n);
        ann_ty = c_ty_at(toks, p, n);
        p = c_emit_skip_type(toks, p, n);
    }
    if p < n && field_at(list_get(toks, p), 0) == "EQ" {
        p = p + 1;
    }
    // H5: incomplete `let x =` / empty RHS — fail-closed (no `x = ;`)
    if p >= n {
        println("ERR\tc_emit\tincomplete let RHS");
        process_exit(1);
    }
    let rk0: String = field_at(list_get(toks, p), 0);
    if rk0 == "SEMI" || rk0 == "RBRACE" || rk0 == "EOF" {
        println("ERR\tc_emit\tincomplete let RHS");
        process_exit(1);
    }
    if p < n && field_at(list_get(toks, p), 0) == "KW_MATCH" {
        return c_emit_match_let(name, toks, p, n, e);
    }
    // if-expression: let y = if c { a } else if d { b } else { e };
    if p < n && field_at(list_get(toks, p), 0) == "KW_IF" {
        let mut lty: String = "long long";
        if ann_ty != "" && ann_ty != "void" {
            lty = ann_ty;
        }
        println("  " + lty + " " + name + ";");
        let mut ea: String = c_env_put(e, "__asgn__", name);
        let mut guard: Int = 0;
        while guard < 32 {
            if p >= n {
                break;
            }
            let kk: String = field_at(list_get(toks, p), 0);
            if kk != "KW_IF" && kk != "KW_ELSE" {
                break;
            }
            let st: List[String] = c_emit_stmt(toks, p, n, ea);
            p = parse_int(list_get(st, 0));
            ea = list_get(st, 1);
            guard = guard + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    let mut env_rhs: String = e;
    if ann_kind == "S" || ann_kind == "I" {
        env_rhs = c_env_put(e, "__ann__", ann_kind);
    }
    // M53: capture RHS start for bare-IDENT secret assign-prop
    let rhs_pos: Int = p;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env_rhs);
    p = parse_int(list_get(pr, 0));
    let mut rhs: String = list_get(pr, 1);
    let mut lty: String = "long long";
    let mut bind_kind: String = ann_kind;
    // Annotation wins when present (String/Int/Bool/List/Result)
    if ann_ty != "" && ann_ty != "void" {
        lty = ann_ty;
        if ann_ty == "OoSList" {
            bind_kind = "S";
            if rhs == "oo_ilist_new()" {
                rhs = "oo_slist_new()";
            }
        }
        if ann_ty == "OoIList" {
            bind_kind = "I";
        }
    } else if ann_kind == "S" {
        lty = "OoSList";
        if rhs == "oo_ilist_new()" {
            rhs = "oo_slist_new()";
        }
    } else if ann_kind == "I" {
        lty = "OoIList";
    } else {
        let inf: List[String] = c_emit_let_untyped_ty(rhs, e);
        lty = list_get(inf, 0);
        let bk: String = list_get(inf, 1);
        if bk != "" {
            bind_kind = bk;
        }
        // M168: untyped struct lit `((Name){ ... })` → bind as Name
        let sty: String = c_struct_lit_ty_name(rhs);
        if sty != "" {
            lty = sty;
        }
    }
    // M172: ann Int must not win over clear free-name / concat / bare T RHS
    // (M169 SEGV-avoid mistyped :Int on String → pure dual long long vs OoStr)
    if lty == "long long" {
        let inf2: List[String] = c_emit_let_untyped_ty(rhs, e);
        let u: String = list_get(inf2, 0);
        if u != "long long" && u != "" {
            lty = u;
            let bk2: String = list_get(inf2, 1);
            if bk2 != "" {
                bind_kind = bk2;
            }
        }
    }
    // Result: Ok/Err → OoResS (R); write_file → OoResV (V) for match/unwrap.
    // Do not clobber user struct-lit types (e.g. `((Tree){...})` — char2 is 'T' of Tree).
    // Only apply Token/Ok heuristics when lty still default numeric.
    if lty == "long long" && chars_len(rhs) >= 9 {
        if char_at(rhs, 0) == "(" && char_at(rhs, 2) == "O" {
            lty = "OoResS";
        } else if char_at(rhs, 0) == "(" && char_at(rhs, 2) == "T" {
            // `((Token){...})` only — require "Token" prefix after `(("
            if chars_len(rhs) >= 8 && char_at(rhs, 3) == "o" && char_at(rhs, 4) == "k"
                && char_at(rhs, 5) == "e" && char_at(rhs, 6) == "n" {
                lty = "Token";
            }
        }
    }
    if chars_len(rhs) >= 12 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "w" && char_at(rhs, 4) == "r" {
            lty = "OoResV";
        }
    }
    if chars_len(rhs) >= 11 {
        if char_at(rhs, 0) == "o" && char_at(rhs, 3) == "r" && char_at(rhs, 4) == "e" {
            if char_at(rhs, 7) == "f" || char_at(rhs, 7) == "g" {
                lty = "OoResS";
            }
        }
    }
    if c_rhs_is_unwrap(rhs) {
        lty = "OoStr";
    }
    if chars_len(lty) < 3 {
        lty = "long long";
    }
    if lty == "OoStr" {
        e = c_env_put(e, name, "T");
    } else if lty == "OoResS" {
        e = c_env_put(e, name, "R");
    } else if lty == "OoResV" {
        e = c_env_put(e, name, "V");
    } else if lty == "double" {
        e = c_env_put(e, name, "F");
    } else if bind_kind == "S" || bind_kind == "I" {
        e = c_env_put(e, name, bind_kind);
    }
    // CRIT 2.4: let f = println|tcp_write → __alias__f for emit-time guard
    e = c_secret_try_record_alias_rhs(toks, rhs_pos, n, e, name);
    e = c_secret_prop_from_rhs(toks, rhs_pos, n, e, name);
    println("  " + lty + " " + name + " = " + rhs + ";");
    c_emit_let_alias_retain(name, rhs, lty, e);
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: emit IDENT stmts (println/assert/assign/expr) + T2 field assign taint
// stage: emit
//
// T2 field taint model (path A):
//   b.v = secret → __sec__b=1 AND __sec__b.v=1 (root + field path).
//   Root tag required: sink scanners only refuse bare IDENTs, so
//   println(b.v) refuses via IDENT b. Path tag covers let x = b.v.
//   Object taint sticky: clean field rebind does not clear __sec__root.
//   arr[i] = secret → __sec__arr=1 when index-assign form exists.
//   x = obj.m() → prop via __fr_secret__m / secret recv (c_secret_tok_is_sec).

// IDENT at i is secret-bearing: bare tag, free call, field path, or method.
// Field keys may use dots (__sec__root.f1.f2).
pub fn c_secret_tok_is_sec(toks: List[String], i: Int, n: Int, env: String) -> Bool {
    let sn: String = field_at(list_get(toks, i), 3);
    if c_env_get(env, "__sec__" + sn) == "1" {
        return true;
    }
    if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "LPAREN" {
        if c_env_get(env, "__fr_secret__" + sn) == "1" {
            return true;
        }
    }
    // Field path IDENT (DOT IDENT)* → __sec__root.f1.f2; method last.m(
    let mut path: String = sn;
    let mut t: Int = i + 1;
    let mut last_m: String = "";
    while t + 1 < n {
        if field_at(list_get(toks, t), 0) != "DOT" {
            break;
        }
        if field_at(list_get(toks, t + 1), 0) != "IDENT" {
            break;
        }
        last_m = field_at(list_get(toks, t + 1), 3);
        path = path + "." + last_m;
        if c_env_get(env, "__sec__" + path) == "1" {
            return true;
        }
        t = t + 2;
    }
    if last_m != "" && t < n && field_at(list_get(toks, t), 0) == "LPAREN" {
        if c_env_get(env, "__fr_secret__" + last_m) == "1" {
            return true;
        }
    }
    return false;
}

// Secret RHS of field assign → tag root + path (never clear root on clean).
pub fn c_secret_prop_field_assign(toks: List[String], pos: Int, n: Int, env: String, root: String, path: String) -> String {
    let e2: String = c_secret_prop_from_rhs(toks, pos, n, env, "__t2fp__");
    if c_env_get(e2, "__sec____t2fp__") == "1" {
        env = c_env_put(env, "__sec__" + root, "1");
        if path != "" {
            env = c_env_put(env, "__sec__" + path, "1");
        }
    }
    return env;
}

// Check walk: at IDENT i, note bare / field / index assign taint.
// Skips field-name tokens after DOT so `b.v = s` does not false-tag bare `v`.
pub fn c_secret_note_lhs_assign(toks: List[String], i: Int, n: Int, env: String) -> String {
    if i >= n || field_at(list_get(toks, i), 0) != "IDENT" {
        return env;
    }
    if i > 0 && field_at(list_get(toks, i - 1), 0) == "DOT" {
        return env;
    }
    let id: String = field_at(list_get(toks, i), 3);
    // Field assign: id (. IDENT)+ EQ rhs
    if i + 3 < n && field_at(list_get(toks, i + 1), 0) == "DOT" {
        let mut q: Int = i + 1;
        let mut path: String = id;
        let mut found: Bool = false;
        let mut rhs: Int = 0;
        while q + 1 < n && field_at(list_get(toks, q), 0) == "DOT"
            && field_at(list_get(toks, q + 1), 0) == "IDENT" {
            path = path + "." + field_at(list_get(toks, q + 1), 3);
            q = q + 2;
            if q < n && field_at(list_get(toks, q), 0) == "EQ" {
                found = true;
                rhs = q + 1;
                break;
            }
            if q >= n || field_at(list_get(toks, q), 0) != "DOT" {
                break;
            }
        }
        if found {
            return c_secret_prop_field_assign(toks, rhs, n, env, id, path);
        }
    }
    // Index assign: id [ ... ] = rhs → tag base list
    if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "LBRACKET" {
        let mut depth: Int = 1;
        let mut q: Int = i + 2;
        while q < n && depth > 0 {
            let kk: String = field_at(list_get(toks, q), 0);
            if kk == "LBRACKET" {
                depth = depth + 1;
            } else if kk == "RBRACKET" {
                depth = depth - 1;
            }
            q = q + 1;
        }
        if q < n && field_at(list_get(toks, q), 0) == "EQ" {
            let e2: String = c_secret_prop_from_rhs(toks, q + 1, n, env, "__t2ix__");
            if c_env_get(e2, "__sec____t2ix__") == "1" {
                return c_env_put(env, "__sec__" + id, "1");
            }
            return env;
        }
    }
    // Bare assign: id = rhs
    if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "EQ" {
        env = c_secret_note_bare_alias(toks, i + 2, n, env, id);
        return c_secret_prop_from_rhs(toks, i + 2, n, env, id);
    }
    return env;
}

pub fn c_emit_ident_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p: Int = pos;
    let mut e: String = env;
    let id: String = field_at(list_get(toks, p), 3);
    if id == "println" {
        p = c_emit_println(toks, p, n, e);
        return c_pack_pos_env(p, e);
    }
    if id == "assert_eq" || id == "assert_ne" || id == "assert" {
        let mut p1: Int = p + 1;
        if p1 < n && field_at(list_get(toks, p1), 0) == "BANG" { p1 = p1 + 1; }
        if p1 < n && field_at(list_get(toks, p1), 0) == "LPAREN" {
            p1 = p1 + 1;
            let pr1: List[String] = c_emit_expr_c(toks, p1, n, e);
            p1 = parse_int(list_get(pr1, 0));
            let arg1: String = list_get(pr1, 1);
            if id == "assert" {
                if p1 < n && field_at(list_get(toks, p1), 0) == "RPAREN" { p1 = p1 + 1; }
                println("  oo_assert(" + arg1 + ");");
            } else {
                if p1 < n && field_at(list_get(toks, p1), 0) == "COMMA" { p1 = p1 + 1; }
                let pr2: List[String] = c_emit_expr_c(toks, p1, n, e);
                p1 = parse_int(list_get(pr2, 0));
                let arg2: String = list_get(pr2, 1);
                if p1 < n && field_at(list_get(toks, p1), 0) == "RPAREN" { p1 = p1 + 1; }
                if id == "assert_eq" {
                    println("  oo_assert_eq(" + arg1 + ", " + arg2 + ");");
                } else {
                    println("  oo_assert_ne(" + arg1 + ", " + arg2 + ");");
                }
            }
            if p1 < n && field_at(list_get(toks, p1), 0) == "SEMI" { p1 = p1 + 1; }
            return c_pack_pos_env(p1, e);
        }
    }
    // M168 path A: field assign `recv.field = rhs` (was silent `recv.field;`)
    if p + 3 < n && field_at(list_get(toks, p + 1), 0) == "DOT"
        && field_at(list_get(toks, p + 2), 0) == "IDENT"
        && field_at(list_get(toks, p + 3), 0) == "EQ" {
        let fname: String = field_at(list_get(toks, p + 2), 3);
        // String: field path text (M169 mistyped Int → pure dual long long = oo_str_concat)
        let lhs: String = id + "." + fname;
        p = p + 4;
        // T2: secret RHS → tag __sec__root + __sec__root.field (emit env dual-path)
        let rhs_pos: Int = p;
        let pra: List[String] = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pra, 0));
        let rhs: String = list_get(pra, 1);
        e = c_secret_prop_field_assign(toks, rhs_pos, n, e, id, lhs);
        println("  " + lhs + " = " + rhs + ";");
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    if p + 1 < n && field_at(list_get(toks, p + 1), 0) == "EQ" {
        // assign target name is String (IDENT text), not Int
        let name: String = id;
        p = p + 2;
        // CRIT 2.4: record __alias__name when RHS is known sink (or sink alias);
        // clear on non-sink rebind so stale function aliases do not stick.
        e = c_secret_try_record_alias_rhs(toks, p, n, e, name);
        // assign match: full arm lower (not silent .val)
        if p < n && field_at(list_get(toks, p), 0) == "KW_MATCH" {
            return c_emit_match_assign(name, toks, p, n, e);
        }
        let rhs_pos: Int = p;
        let pra: List[String] = c_emit_expr_c(toks, p, n, e);
        p = parse_int(list_get(pra, 0));
        let rhs: String = list_get(pra, 1);
        // Refine kind in the *existing* frame (put_last). Never top-append —
        // that pulled outer muts into while/if frames and released them each iter.
        if chars_len(rhs) >= 12 {
            if char_at(rhs, 3) == "s" && char_at(rhs, 4) == "l" {
                if chars_len(rhs) >= 14 && char_at(rhs, 9) == "g" {
                    e = c_env_put_last(e, name, "T");
                } else {
                    e = c_env_put_last(e, name, "S");
                }
            }
            if char_at(rhs, 3) == "i" && char_at(rhs, 4) == "l" {
                if chars_len(rhs) < 14 || char_at(rhs, 9) != "g" {
                    e = c_env_put_last(e, name, "I");
                }
            }
        }
        e = c_secret_prop_from_rhs(toks, rhs_pos, n, e, name);
        c_emit_reassign_arc(name, rhs, e);
        if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
            p = p + 1;
        }
        return c_pack_pos_env(p, e);
    }
    let pr2: List[String] = c_emit_expr_c(toks, p, n, e);
    p = parse_int(list_get(pr2, 0));
    let asgn: String = c_env_get(e, "__asgn__");
    if asgn != "" {
        println("  " + asgn + " = " + list_get(pr2, 1) + ";");
    } else {
        println("  " + list_get(pr2, 1) + ";");
    }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    return c_pack_pos_env(p, e);
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: lower match on Result (OoResS / OoResV) to if (ok) / else
// stage: emit
// Forms: match r { Ok(x) => { ... } Err(e) => { ... } }
//        let n = match r { Ok(x) => expr Err(e) => expr };
// Arm separators: optional COMMA after each arm. Fail-closed if shape wrong.
// Match-assign (decl=0): put_last (M23) + reassign_arc so prior string released.
fn c_match_skip_comma(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" {
        p = p + 1;
    }
    return p;
}

// pos at KW_MATCH. Returns [new_pos, env].
pub fn c_emit_match_stmt(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    let mut p = pos + 1;
    let pr: List[String] = c_emit_expr_c(toks, p, n, env);
    p = parse_int(list_get(pr, 0));
    let scrut = list_get(pr, 1);
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACE" {
        println("ERR\tc_emit\tmatch: expected { after scrutinee");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT" || field_at(list_get(toks, p), 3) != "Ok" {
        println("ERR\tc_emit\tmatch: expected Ok(...) arm first");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Ok(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" { ok_bind = field_at(list_get(toks, p), 3); p = p + 1; }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" { p = p + 1; }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Ok(...)");
        process_exit(1);
    }
    p = p + 1;
    // Result kind: R = OoResS (.val both arms), V = OoResV (.err on Err)
    let mut rkind = "R";
    if c_env_get(env, scrut) == "V" {
        rkind = "V";
    }
    println("  {");
    if rkind == "V" {
        println("  OoResV __m = " + scrut + ";");
    } else {
        println("  OoResS __m = " + scrut + ";");
    }
    println("  if (__m.ok) {");
    if rkind == "V" {
        println("    (void)0; /* Ok arm: no payload on OoResV */");
    } else {
        println("    OoStr " + ok_bind + " = __m.val;");
    }
    let mut eok: String = env;
    if rkind != "V" {
        eok = c_env_put(env, ok_bind, "T");
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br: List[String] = c_emit_block(toks, p, n, eok);
        p = parse_int(list_get(br, 0));
    } else {
        let st: List[String] = c_emit_stmt(toks, p, n, eok);
        p = parse_int(list_get(st, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    // Err arm
    if p >= n || field_at(list_get(toks, p), 0) != "IDENT"
        || field_at(list_get(toks, p), 3) != "Err"
    {
        println("ERR\tc_emit\tmatch: expected Err(...) arm");
        process_exit(1);
    }
    p = p + 1;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        println("ERR\tc_emit\tmatch: expected Err(bind)");
        process_exit(1);
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        err_bind = field_at(list_get(toks, p), 3);
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
        p = p + 1;
    }
    if p >= n || field_at(list_get(toks, p), 0) != "FATARROW" {
        println("ERR\tc_emit\tmatch: expected => after Err(...)");
        process_exit(1);
    }
    p = p + 1;
    if rkind == "V" {
        println("    OoStr " + err_bind + " = __m.err;");
    } else {
        println("    OoStr " + err_bind + " = __m.val;");
    }
    let eerr: String = c_env_put(env, err_bind, "T");
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let br2: List[String] = c_emit_block(toks, p, n, eerr);
        p = parse_int(list_get(br2, 0));
    } else {
        let st2: List[String] = c_emit_stmt(toks, p, n, eerr);
        p = parse_int(list_get(st2, 0));
    }
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" {
        p = p + 1;
    }
    return c_pack_pos_env(p, env);
}

// name = match r { ... } — assign form (name already declared).
pub fn c_emit_match_assign(name: String, toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_match_let_core(name, toks, pos, n, env, 0);
}

// let name = match r { Ok(a) => expr Err(b) => expr };
pub fn c_emit_match_let(name: String, toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_match_let_core(name, toks, pos, n, env, 1);
}

// decl: 1 → `OoStr name;`; 0 → assign into existing name.
pub fn c_emit_match_let_core(
    name: String,
    toks: List[String],
    pos: Int,
    n: Int,
    env: String,
    decl: Int
) -> List[String] {
    let mut p = pos + 1;
    let mut e: String = env;
    let pr_m: List[String] = c_emit_expr_c(toks, p, n, e);
    p = parse_int(list_get(pr_m, 0));
    let scrut = list_get(pr_m, 1);
    let mut rkind = "R";
    if c_env_get(e, scrut) == "V" {
        rkind = "V";
    }
    if p >= n || field_at(list_get(toks, p), 0) != "LBRACE" {
        println("ERR\tc_emit\tmatch-let expected {");
        process_exit(1);
    }
    p = p + 1;
    let arm1: String = field_at(list_get(toks, p), 3);
    if p >= n || (arm1 != "Ok" && arm1 != "Some") {
        println("ERR\tc_emit\tmatch-let expected Ok or Some");
        process_exit(1);
    }
    p = p + 1;
    let mut ok_bind = "_ok";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            ok_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" {
        p = p + 1;
    }
    let is_some = (arm1 == "Some");
    if decl == 1 {
        if is_some || c_env_get(e, "__ret_int__") == "1" {
            println("  long long " + name + ";");
        } else {
            println("  OoStr " + name + ";");
        }
    }
    println("  {");
    if is_some {
        println("  long long __ml = " + scrut + ";");
        println("  if (__ml != 0) {");
        println("    long long " + ok_bind + " = __ml;");
    } else {
        if rkind == "V" {
            println("  OoResV __ml = " + scrut + ";");
        } else {
            println("  OoResS __ml = " + scrut + ";");
        }
        println("  if (__ml.ok) {");
    }
    let mut eok = e;
    if !is_some && rkind != "V" {
        println("    OoStr " + ok_bind + " = __ml.val;");
        eok = c_env_put(e, ok_bind, "T");
    }
    let pr_ok: List[String] = c_emit_expr_c(toks, p, n, eok);
    p = parse_int(list_get(pr_ok, 0));
    let mut okx = list_get(pr_ok, 1);
    if c_env_get(e, "__ret_int__") == "1" && !is_some { okx = "oo_str_to_int(" + okx + ")"; }
    if decl == 0 { c_emit_reassign_arc(name, okx, eok); } else { println("    " + name + " = " + okx + ";"); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" {
        p = p + 1;
    }
    p = c_match_skip_comma(toks, p, n);
    println("  } else {");
    let arm2: String = field_at(list_get(toks, p), 3);
    if p >= n || (arm2 != "Err" && arm2 != "None") {
        println("ERR\tc_emit\tmatch-let expected Err or None");
        process_exit(1);
    }
    p = p + 1;
    let mut err_bind = "_err";
    if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            err_bind = field_at(list_get(toks, p), 3);
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "RPAREN" {
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "FATARROW" {
        p = p + 1;
    }
    if !is_some {
        if rkind == "V" {
            println("    OoStr " + err_bind + " = __ml.err;");
        } else {
            println("    OoStr " + err_bind + " = __ml.val;");
        }
    }
    let eerr: String = c_env_put(e, err_bind, "T");
    let pr_er: List[String] = c_emit_expr_c(toks, p, n, eerr);
    p = parse_int(list_get(pr_er, 0));
    if decl == 0 { c_emit_reassign_arc(name, list_get(pr_er, 1), eerr); } else { println("    " + name + " = " + list_get(pr_er, 1) + ";"); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    p = c_match_skip_comma(toks, p, n);
    println("  }");
    println("  }");
    if p < n && field_at(list_get(toks, p), 0) == "RBRACE" { p = p + 1; }
    let mut nk = "T";
    if is_some { nk = "I"; }
    if decl == 1 { e = c_env_put(e, name, nk); } else { e = c_env_put_last(e, name, nk); }
    if p < n && field_at(list_get(toks, p), 0) == "SEMI" { p = p + 1; }
    return c_pack_pos_env(p, e);
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: path A MaxCycles — parse file-level MAX_CYCLES N; while/for + call-entry fuel
// stage: emit
// residual: not OS cgroup; not #[MaxCycles] grammar; not static WCET

// Scan source for line-start directive MAX_CYCLES with positive N.
// N>0 → return decimal string. N==0 / invalid digits after marker → fail-closed.
// Absent marker → "" (no fuel; opt-in).
// Match only after newline (or file start) so self-host sources can mention the
// directive in docs/strings without tripping fail-closed mid-line.
pub fn c_parse_max_cycles(src: String) -> String {
    // Split so contiguous directive text never appears in this module source.
    let needle = "// " + "MAX_CYCLES:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        // Line-start only (self-host safe)
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let mut num = "";
                while k < sn {
                    let c = char_at(src, k);
                    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
                        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
                    {
                        num = num + c;
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                // Attack: silent zero N / invalid — never treat as "no marker"
                if num == "" {
                    println("ERR\tmax_cycles\tinvalid N (need positive int after directive)");
                    process_exit(1);
                }
                let n = 0 + parse_int(num);
                if n <= 0 {
                    println("ERR\tmax_cycles\tzero N fail-closed (need N>0)");
                    process_exit(1);
                }
                return num;
            }
        }
        i = i + 1;
    }
    return "";
}

// M58/M126: counter is file-static `static long long __oo_mc` (shared). Open while.
pub fn c_emit_while_fuel_open(cond: String) {
    println("while (" + cond + ") {");
}

// Increment + exceed check vs OO_MC_LIMIT (set at TU start when MAX_CYCLES present).
// Used for while body, range-for body, and call-entry (recursion fuel).
// `mc` arg kept for call-site compat; budget is always the macro (1-char env marker only).
pub fn c_emit_while_fuel_check(mc: String) {
    println("  __oo_mc = __oo_mc + 1;");
    println("  if (__oo_mc > OO_MC_LIMIT) {");
    println("    oo_print_str(oo_str_lit(\"ERR\\tmax_cycles\\texceeded\"));");
    println("    oo_println();");
    println("    oo_process_exit(1);");
    println("  }");
    // silence unused if callers still pass N
    if mc == "" {
        println("  /* no mc */");
    }
}

pub fn c_emit_while_fuel_close() {
    println("}");
}
// package: backend-c — path-A metamorphic layout diversity (immune floor slice)
// stage: emit
//
// Path A (opt-in): source directive `// METAMORPHIC: path-a` enables emission of
// non-semantic C decoy functions after each top-level fn so the exposed object
// layout differs from a build without the marker. Deterministic per source
// order (decoy index = emit order). Does NOT mutate assembly at runtime.
//
// path-a-shuffle: `// METAMORPHIC: path-a-shuffle` also reverses top-level fn
// emit order (bodies/full only; drive in c_emit_meta_drive.oo).
//
// Residual (DESIGN full immune system): continuous RAM re-mutation, ROP graph
// reshaping, metamorphic_emit/metamorphic_build free-names — still refuse.
// Tension: default product builds stay deterministic; path-a is explicit opt-in.
//
// Multi-pass emit (emit-protos + emit-bodies): decoys emit in body/all/full
// modes only so static __oo_meta_decoy_N is not redefined in the same TU.

// Line-start only. Returns true if file enables path-A layout decoys.
// Also true for `// METAMORPHIC: path-a-shuffle` (prefix match).
pub fn c_parse_metamorphic_path_a(src: String) -> Bool {
    let needle = "// " + "METAMORPHIC: path-a";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Line-start only. `// METAMORPHIC: path-a-shuffle` enables reverse fn order.
pub fn c_parse_metamorphic_shuffle(src: String) -> Bool {
    let needle = "// " + "METAMORPHIC: path-a-shuffle";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Mode gate: emit decoys once (body/all/full family). Never preamble or protos*.
pub fn c_meta_layout_emit_decoys(mode: String) -> Bool {
    if mode == "bodies" {
        return true;
    }
    if mode == "bodies_noarc" {
        return true;
    }
    if mode == "all" {
        return true;
    }
    if mode == "all_noarc" {
        return true;
    }
    if mode == "full" {
        return true;
    }
    return false;
}

// Banner once per TU when path-A layout decoys will actually emit.
pub fn c_emit_meta_banner() {
    println("/* OODA path-A metamorphic layout decoys enabled (emit-time only) */");
}

// Hard caps (memory auditor): max 64 decoys / TU; pad array ≤16 bytes.
pub fn c_meta_decoy_max() -> Int {
    return 64;
}

// Emit one non-semantic decoy. idx is 0-based sequence among top-level fns.
// Never called at runtime; exists only to diversify .text/.data layout.
// Body uses emit-sequence index only (no user strings / fptrs / exports).
pub fn c_emit_meta_decoy(idx: Int) {
    let mut safe = idx;
    if safe < 0 {
        return;
    }
    if safe >= c_meta_decoy_max() {
        println("/* ooda path-A metamorphic: decoy cap 64 reached (residual) */");
        return;
    }
    let id = safe.to_string();
    if id == "" {
        return;
    }
    // Style from idx%4 — weak layout diversity (not CFI).
    let style = safe - ((safe / 4) * 4);
    println("/* ooda path-A metamorphic layout decoy (not runtime mutation) */");
    println("#if defined(__GNUC__) || defined(__clang__)");
    println("__attribute__((used, noinline))");
    println("#endif");
    println("static void __oo_meta_decoy_" + id + "(void) {");
    if style == 0 {
        println("  volatile unsigned int __oo_meta_pad = " + id + "u;");
        println("  (void)__oo_meta_pad;");
    } else if style == 1 {
        println("  volatile unsigned char __oo_meta_buf[16];");
        println("  __oo_meta_buf[0] = (unsigned char)(" + id + ");");
        println("  (void)__oo_meta_buf[0];");
    } else if style == 2 {
        println("  volatile int __oo_meta_i = 0;");
        println("  while (__oo_meta_i < 1) { __oo_meta_i = __oo_meta_i + 1; }");
        println("  (void)__oo_meta_i;");
    } else {
        println("  volatile unsigned int __oo_meta_x = " + id + "u ^ 0xA5A5u;");
        println("  (void)__oo_meta_x;");
    }
    println("}");
}

// Named wrapper: comment ties decoy to preceding fn; body still index-only.
pub fn c_emit_meta_decoy_named(idx: Int, fn_name: String) {
    if fn_name != "" {
        println("/* path-A decoy after fn " + fn_name + " */");
    }
    c_emit_meta_decoy(idx);
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: CRIT 2.4 secret sink alias rebind (__alias__f = println|tcp_write|…)
// stage: emit
// Record let/assign aliases to known sinks; resolve callee for guard + check.

// Known free-call sink names (secret refuse surface). Keep in sync with
// check_secret_println_sinks / c_secret_emit_guard branches.
pub fn c_secret_is_sink_name(name: String) -> Bool {
    if name == "println" || name == "eprintln" || name == "print_err" || name == "log"
        || name == "fprintf" || name == "syslog" {
        return true;
    }
    if name == "write_file" || name == "fetch" || name == "sys_exec" {
        return true;
    }
    if name == "env_get" || name == "env_set" || name == "setenv" || name == "unsetenv" {
        return true;
    }
    if name == "read_file" || name == "path_exists" || name == "file_size" {
        return true;
    }
    if name == "process_exit" || name == "sleep_ms" || name == "seed" {
        return true;
    }
    if name == "alloc_bytes" || name == "free_bytes" || name == "malloc" || name == "free"
        || name == "realloc" {
        return true;
    }
    if name == "mmap" || name == "mprotect" || name == "shmat" || name == "pwrite"
        || name == "sendfile" || name == "splice" || name == "tee" {
        return true;
    }
    // Net / FFI friends (alias rebind surface)
    if name == "tcp_write" || name == "net_tcp_write" || name == "net_send" || name == "http_post"
        || name == "tcp_read" || name == "udp_recv" {
        return true;
    }
    if name == "dlopen" || name == "dlsym" || name == "dlclose" || name == "ffi_call"
        || name == "ffi_prep_cif" {
        return true;
    }
    return false;
}

// Walk __alias__ chain (depth-capped). Returns original name if no alias.
pub fn c_secret_resolve_alias(env: String, name: String) -> String {
    let mut cur: String = name;
    let mut i: Int = 0;
    while i < 16 {
        let next: String = c_env_get(env, "__alias__" + cur);
        if next != "" {
            cur = next;
            i = i + 1;
        } else {
            i = 16;
        }
    }
    return cur;
}

// True only when env marks name secret with exact "1" (DE1 clear uses "0").
pub fn c_secret_is_tainted(env: String, name: String) -> Bool {
    return c_env_get(env, "__sec__" + name) == "1";
}

// Record __alias__dest = rhs when rhs is a known sink OR already aliases one.
pub fn c_secret_record_alias_let(env: String, dest: String, rhs: String) -> String {
    if dest == "" || rhs == "" {
        return env;
    }
    if dest == rhs {
        return env;
    }
    let mut should: Bool = false;
    if c_secret_is_sink_name(rhs) {
        should = true;
    } else {
        let al: String = c_env_get(env, "__alias__" + rhs);
        if al != "" {
            should = true;
        } else {
            let resolved: String = c_secret_resolve_alias(env, rhs);
            if c_secret_is_sink_name(resolved) {
                should = true;
            }
        }
    }
    if should {
        return c_env_put(env, "__alias__" + dest, rhs);
    }
    return env;
}

// Clear function-alias binding on dest (clean / non-sink rebind).
pub fn c_secret_clear_alias(env: String, dest: String) -> String {
    if dest == "" {
        return env;
    }
    if c_env_get(env, "__alias__" + dest) != "" {
        return c_env_put(env, "__alias__" + dest, "");
    }
    return env;
}

// At RHS of let/assign: single bare IDENT → try record; else clear prior alias.
// Bare IDENT means next token is SEMI / RBRACE / EOF-ish (not LPAREN/DOT/call).
pub fn c_secret_try_record_alias_rhs(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
        let rhs: String = field_at(list_get(toks, pos), 3);
        let mut bare: Bool = true;
        if pos + 1 < n {
            let nk: String = field_at(list_get(toks, pos + 1), 0);
            // SEMI / RBRACE end the bare alias form. LPAREN starts a call.
            if nk == "LPAREN" || nk == "DOT" || nk == "LBRACKET" || nk == "COLON"
                || nk == "PLUS" || nk == "MINUS" || nk == "STAR" || nk == "SLASH"
                || nk == "EQ" || nk == "EQEQ" || nk == "NE" || nk == "LT" || nk == "GT"
                || nk == "AMP" || nk == "PIPE" || nk == "QUESTION" {
                bare = false;
            }
        }
        if bare {
            // Sink (or sink-alias) RHS → record; else drop stale function alias.
            let mut should: Bool = false;
            if c_secret_is_sink_name(rhs) {
                should = true;
            } else if c_env_get(env, "__alias__" + rhs) != "" {
                should = true;
            } else if c_secret_is_sink_name(c_secret_resolve_alias(env, rhs)) {
                should = true;
            }
            if should {
                return c_secret_record_alias_let(env, dest, rhs);
            }
            return c_secret_clear_alias(env, dest);
        }
    }
    return c_secret_clear_alias(env, dest);
}

// --- Compatibility names used by check walk / prop (CRIT 2.4) ---

// Same as c_secret_resolve_alias (check walk historically called resolve_name).
pub fn c_secret_resolve_name(env: String, name: String) -> String {
    return c_secret_resolve_alias(env, name);
}

// Bare IDENT RHS only: dest = other; → record sink alias when applicable.
// Called from check_secret_println_sinks on LET / assign.
pub fn c_secret_note_bare_alias(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    return c_secret_try_record_alias_rhs(toks, pos, n, env, dest);
}

// Explicit API name from sprint brief.
// c_secret_record_alias_let is the core; this is the toks-facing entry.
pub fn c_secret_record_alias_from_let(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    return c_secret_try_record_alias_rhs(toks, pos, n, env, dest);
}

// 2.10: env key __sec_sink__<fn>=1 (not a magic callee name) or prefix opt-in.
pub fn c_secret_is_user_sink(env: String, name: String) -> Bool {
    if c_env_get(env, "__sec_sink__" + name) == "1" {
        return true;
    }
    if chars_len(name) >= 12 {
        if str_slice(name, 0, 12) == "__sec_sink__" {
            return true;
        }
    }
    return false;
}

// One-hop: formal IDENT appears in a sealed-sink call in the same fn body.
pub fn c_secret_mark_user_sinks(toks: List[String], env: String) -> String {
    let n = list_len(toks);
    let mut e: String = env;
    let mut i: Int = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) != "KW_FN" {
            i = i + 1;
        } else if i + 1 >= n || field_at(list_get(toks, i + 1), 0) != "IDENT" {
            i = i + 1;
        } else {
            let fn_name: String = field_at(list_get(toks, i + 1), 3);
            let mut p: Int = i + 2;
            let mut fenv: String = "";
            let mut prev: String = "";
            while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
                let pk: String = field_at(list_get(toks, p), 0);
                if pk == "IDENT" {
                    if prev == "LPAREN" || prev == "COMMA" {
                        fenv = c_env_put(fenv, "__f__" + field_at(list_get(toks, p), 3), "1");
                    }
                }
                prev = pk;
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
                let mut bd: Int = 1;
                p = p + 1;
                while p < n && bd > 0 {
                    let bk: String = field_at(list_get(toks, p), 0);
                    if bk == "LBRACE" {
                        bd = bd + 1;
                    } else if bk == "RBRACE" {
                        bd = bd - 1;
                    } else if bk == "IDENT" {
                        let sid: String = c_secret_resolve_alias(e, field_at(list_get(toks, p), 3));
                        if c_secret_is_sink_name(sid) {
                            if p + 1 < n && field_at(list_get(toks, p + 1), 0) == "LPAREN" {
                                let mut q: Int = p + 2;
                                let mut d: Int = 1;
                                while q < n && d > 0 {
                                    let qk: String = field_at(list_get(toks, q), 0);
                                    if qk == "LPAREN" {
                                        d = d + 1;
                                    } else if qk == "RPAREN" {
                                        d = d - 1;
                                    } else if qk == "IDENT" {
                                        if c_env_get(fenv, "__f__" + field_at(list_get(toks, q), 3)) == "1" {
                                            e = c_env_put(e, "__sec_sink__" + fn_name, "1");
                                        }
                                    }
                                    q = q + 1;
                                }
                            }
                        }
                    }
                    p = p + 1;
                }
                i = p;
            } else {
                i = i + 1;
            }
        }
    }
    return e;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: Secret tags + sink refuse (println, write_file, fetch, sys_exec, env_get)
// stage: emit
// residual: other OS sinks, #[Secret] attr, full IFC

// Line-start // SECRET: <ident> → env fragment "__sec__name=1;"
pub fn c_parse_secret_env(src: String) -> String {
    let needle = "// " + "SECRET:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut env = "";
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 {
            at_line = true;
        } else {
            if char_at(src, i - 1) == "\n" {
                at_line = true;
            }
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let start = k;
                while k < sn {
                    let c = char_at(src, k);
                    let is_al = c == "_" || c == "a" || c == "b" || c == "c" || c == "d"
                        || c == "e" || c == "f" || c == "g" || c == "h" || c == "i"
                        || c == "j" || c == "k" || c == "l" || c == "m" || c == "n"
                        || c == "o" || c == "p" || c == "q" || c == "r" || c == "s"
                        || c == "t" || c == "u" || c == "v" || c == "w" || c == "x"
                        || c == "y" || c == "z" || c == "A" || c == "B" || c == "C"
                        || c == "D" || c == "E" || c == "F" || c == "G" || c == "H"
                        || c == "I" || c == "J" || c == "K" || c == "L" || c == "M"
                        || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R"
                        || c == "S" || c == "T" || c == "U" || c == "V" || c == "W"
                        || c == "X" || c == "Y" || c == "Z" || c == "0" || c == "1"
                        || c == "2" || c == "3" || c == "4" || c == "5" || c == "6"
                        || c == "7" || c == "8" || c == "9";
                    if is_al {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let name = str_slice(src, start, k);
                if name == "" {
                    println("ERR\tsecret\tinvalid name (need ident after SECRET directive)");
                    process_exit(1);
                }
                env = c_env_put(env, "__sec__" + name, "1");
                // Directive root: sticky-clear must not wipe // SECRET: names.
                env = c_env_put(env, "__secref__" + name, "1");
                i = k;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return env;
}

pub fn c_secret_refuse_println_ident(env: String, name: String) {
    if c_env_get(env, "__sec__" + name) == "1" {
        println("ERR\tsecret\tprintln sink refuses SECRET " + name);
        process_exit(1);
    }
}

// sink = write_file | fetch | sys_exec
pub fn c_secret_refuse_sink_ident(env: String, sink: String, name: String) {
    if c_env_get(env, "__sec__" + name) == "1" {
        println("ERR\tsecret\t" + sink + " sink refuses SECRET " + name);
        process_exit(1);
    }
}

// eq_only: refuse only when argi == want; else refuse any argi >= want (sys_exec argv).
// Require LPAREN — bare `let w = write_file` must not scan the rest of the file.
pub fn c_secret_scan_call(env: String, toks: List[String], start: Int, n: Int, want: Int, eq_only: Bool, sink: String) {
    let mut p = start;
    if p >= n || field_at(list_get(toks, p), 0) != "LPAREN" {
        return;
    }
    p = p + 1;
    let mut argi = 0;
    let mut in_args = true;
    let mut depth = 1;
    while in_args && p < n {
        let kk: String = field_at(list_get(toks, p), 0);
        if kk == "LPAREN" {
            depth = depth + 1;
            p = p + 1;
        } else if kk == "RPAREN" {
            depth = depth - 1;
            if depth <= 0 {
                in_args = false;
            }
            p = p + 1;
        } else if kk == "COMMA" {
            if depth == 1 {
                argi = argi + 1;
            }
            p = p + 1;
        } else if kk == "IDENT" {
            let nm: String = field_at(list_get(toks, p), 3);
            if eq_only {
                if argi == want {
                    c_secret_refuse_sink_resolved(env, sink, nm);
                }
            } else {
                if argi >= want {
                    c_secret_refuse_sink_resolved(env, sink, nm);
                }
            }
            p = p + 1;
        } else {
            p = p + 1;
        }
    }
}

pub fn check_secret_println_sinks(src: String, toks: List[String]) {
    let mut env: String = c_parse_secret_env(src);
    // CRIT T1: mark secret-returning fns so call-site prop sees __fr_secret__.
    env = c_secret_mark_returning_fns(src, toks, env);
    if env == "" {
        return;
    }
    // Cheap 2.10: same tok walk. Do not call c_secret_mark_user_sinks.
    let n = list_len(toks);
    let mut i = 0;
    let mut cur_fn = "";
    let mut bd = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "IDENT" {
                cur_fn = field_at(list_get(toks, i + 1), 3);
            }
        } else if k == "LBRACE" {
            bd = bd + 1;
        } else if k == "RBRACE" {
            bd = bd - 1;
            if bd <= 0 {
                cur_fn = "";
                bd = 0;
            }
        }
        if k == "KW_LET" {
            let mut p = i + 1;
            if p < n && field_at(list_get(toks, p), 0) == "KW_MUT" {
                p = p + 1;
            }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
                let dest: String = field_at(list_get(toks, p), 3);
                p = p + 1;
                let mut hunting = true;
                while hunting && p < n {
                    let kk: String = field_at(list_get(toks, p), 0);
                    if kk == "EQ" {
                        // Peer2: let w = write_file → __alias__ so w(...) is a sink.
                        env = c_secret_note_bare_alias(toks, p + 1, n, env, dest);
                        env = c_secret_prop_from_rhs(toks, p + 1, n, env, dest);
                        hunting = false;
                    } else if kk == "SEMI" || kk == "LBRACE" || kk == "KW_LET" {
                        hunting = false;
                    } else {
                        p = p + 1;
                    }
                }
            }
        }
        if k == "IDENT" {
            let id: String = field_at(list_get(toks, i), 3);
            // T2: bare / field / index assign prop (no false tag of field name `v`).
            env = c_secret_note_lhs_assign(toks, i, n, env);
            // CRIT 2.4: resolve let f = println|tcp_write through __alias__ chain.
            let sid: String = c_secret_resolve_alias(env, id);
            if sid == "println" || sid == "eprintln" {
                if cur_fn != "" {
                    env = c_env_put(env, "__sec_sink__" + cur_fn, "1");
                }
                let mut p = i + 1;
                if p < n && field_at(list_get(toks, p), 0) == "LPAREN" {
                    p = p + 1;
                }
                let mut in_args = true;
                let mut depth = 1;
                while in_args && p < n {
                    let tk: String = field_at(list_get(toks, p), 0);
                    if tk == "LPAREN" {
                        depth = depth + 1;
                        p = p + 1;
                    } else if tk == "RPAREN" {
