    // M166: Float free names → double (IEEE; not decimal)
    if name == "sin" || name == "cos" || name == "ln" || name == "exp"
        || name == "sqrt" || name == "pow"
        || name == "oo_sin" || name == "oo_cos" || name == "oo_ln"
        || name == "oo_exp" || name == "oo_sqrt" || name == "oo_pow"
    {
        return "double";
