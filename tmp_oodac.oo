// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: list-kind env map for emit (get/put last-wins)
// stage: emit
// env format: "name=S;name2=I;" or "name=val;" (val until ';')
// kinds: S=List[String] I=List[Int] T=OoStr R/V=Result F=double Float; also __asgn__=ident

// Last match at start or after ';' ("s=" must not hit inside "xs=S;").
// Put replaces, so usually one binding; last-wins get is belt-and-suspenders.
pub fn c_env_get(env: String, name: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut i = 0;
    let mut found = "";
    while i + kn <= en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut val = "";
                let mut k = i + kn;
                while k < en {
                    let c = char_at(env, k);
                    if c == ";" {
                        k = en;
                    } else {
                        val = val + c;
                        k = k + 1;
                    }
                }
                found = val;
            }
        }
        i = i + 1;
    }
    return found;
}

// Replace only inside the topmost `{;` frame. Outer same-name bindings stay
// so nested shadow (`let x` in bare block) appends and scope_exit frees inner only.
// Same-frame re-put still replaces in place (keeps kind for list push etc.).
pub fn c_env_put(env: String, name: String, kind: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut last_scope = 0;
    let mut si = 0;
    while si + 1 < en {
        if char_at(env, si) == "{" && char_at(env, si + 1) == ";" {
            last_scope = si + 2;
        }
        si = si + 1;
    }
    let mut out = "";
    let mut i = 0;
    let mut replaced = false;
    while i < en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        let mut did = false;
        if !replaced && i >= last_scope && at_bound && i + kn <= en {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                out = out + name + "=" + kind + ";";
                i = i + kn;
                while i < en {
                    let c = char_at(env, i);
                    i = i + 1;
                    if c == ";" {
                        break;
                    }
                }
                replaced = true;
                did = true;
            }
        }
        if did == false {
            out = out + char_at(env, i);
            i = i + 1;
        }
    }
    if replaced {
        return out;
    }
    return out + name + "=" + kind + ";";
}

// Reassign: update the last binding of name in any frame (matches c_env_get).
// Must not append into the top frame when name is outer — that made while/if
// bodies scope_exit-release mut vars each iteration (UAF under free).
pub fn c_env_put_last(env: String, name: String, kind: String) -> String {
    let key = name + "=";
    let kn = chars_len(key);
    let en = chars_len(env);
    let mut last_i = -1;
    let mut i = 0;
    while i + kn <= en {
        let mut at_bound = false;
        if i == 0 {
            at_bound = true;
        } else if char_at(env, i - 1) == ";" {
            at_bound = true;
        }
        if at_bound {
            let mut ok = true;
            let mut j = 0;
            while j < kn {
                if char_at(env, i + j) != char_at(key, j) {
                    ok = false;
                    j = kn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                last_i = i;
            }
        }
        i = i + 1;
    }
    if last_i < 0 {
        return env + name + "=" + kind + ";";
    }
    let mut out = str_slice(env, 0, last_i);
    out = out + name + "=" + kind + ";";
    let mut k = last_i + kn;
    while k < en {
        let c = char_at(env, k);
        k = k + 1;
        if c == ";" {
            break;
        }
    }
    if k < en {
        out = out + str_slice(env, k, en);
    }
    return out;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: skip types/braces; c_ty_at / list elem peek (grants: c_emit_skip_grant.oo)
// stage: emit

// pos at type IDENT (e.g. List); returns S, I, or "" for non-List.
pub fn c_peek_list_elem(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "";
    }
    if field_at(list_get(toks, pos), 3) != "List" {
        return "";
    }
    let mut p: Int = pos + 1;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            let e: String = field_at(list_get(toks, p), 3);
            if e == "Int" {
                return "I";
            }
            if e == "String" {
                return "S";
            }
        }
    }
    return "S";
}

// Map type token at pos → C type (params / returns / let ann).
pub fn c_ty_at(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "void";
    }
    if field_at(list_get(toks, pos), 0) == "AMP" {
        return "long long";
    }
    if field_at(list_get(toks, pos), 0) != "IDENT" {
        return "void";
    }
    let tn: String = field_at(list_get(toks, pos), 3);
    if tn == "String" {
        return "OoStr";
    }
    if tn == "Int" {
        return "long long";
    }
    if tn == "Bool" {
        return "int";
    }
    if tn == "Float" || tn == "f64" {
        return "double";
    }
    if tn == "List" {
        let lk: String = c_peek_list_elem(toks, pos, n);
        if lk == "I" {
            return "OoIList";
        }
        return "OoSList";
    }
    if tn == "Result" {
        return "OoResS";
    }
    if c_cap_grant_suffix(tn) != "" {
        return "long long";
    }
    if tn == "HitlCap" || tn == "AuditCap" {
        return "long long";
    }
    return tn;
}

pub fn c_emit_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && field_at(list_get(toks, p), 0) == "AMP" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "LBRACKET" {
        let mut depth: Int = 1;
        p = p + 1;
        while p < n && depth > 0 {
            let k: String = field_at(list_get(toks, p), 0);
            if k == "LBRACKET" {
                depth = depth + 1;
            }
            if k == "RBRACKET" {
                depth = depth - 1;
            }
            p = p + 1;
        }
    }
    return p;
}

// Skip brace-balanced region starting at LBRACE (or find next LBRACE).
pub fn c_emit_skip_braces(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    while p < n && field_at(list_get(toks, p), 0) != "LBRACE" {
        p = p + 1;
    }
    if p >= n {
        return p;
    }
    let mut depth: Int = 0;
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            depth = depth + 1;
        }
        if k == "RBRACE" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 {
                return p;
            }
        } else {
            p = p + 1;
        }
    }
    return p;
}

// Skip requires/ensures until LBRACE. Fail-closed on mid-clause item / missing brace.
pub fn c_emit_skip_contracts(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    let mut cont: Bool = true;
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            cont = false;
        } else if k == "KW_REQUIRES" || k == "KW_ENSURES" {
            p = p + 1;
            let mut in_clause: Bool = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated before LBRACE");
                    process_exit(1);
                }
                let k2: String = field_at(list_get(toks, p), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY"
                    || k2 == "KW_TYPE" || k2 == "EOF"
                {
                    println("ERR\tc_emit\tcontract clause garbage before body");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY"
            || k == "KW_TYPE" || k == "EOF"
        {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    return p;
}

pub fn c_emit_skip_verify(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && field_at(list_get(toks, p), 0) == "KW_VERIFY" {
        p = p + 1;
        if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
            p = p + 1;
        }
        if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
            p = c_emit_skip_braces(toks, p, n);
        }
    }
    return p;
}

// True if toks[pos] is LBRACE of struct lit `{}` or `{ ident: ... }` (not block).
pub fn c_is_struct_lit_lbrace(toks: List[String], pos: Int, n: Int) -> Bool {
    if pos >= n {
        return false;
    }
    if field_at(list_get(toks, pos), 0) != "LBRACE" {
        return false;
    }
    let p2: Int = pos + 1;
    if p2 >= n {
        return false;
    }
    let k2: String = field_at(list_get(toks, p2), 0);
    if k2 == "RBRACE" {
        return true;
    }
    if k2 == "IDENT" {
        if p2 + 1 < n {
            if field_at(list_get(toks, p2 + 1), 0) == "COLON" {
                return true;
            }
        }
    }
    return false;
}

pub fn c_peek_type_name(toks: List[String], pos: Int, n: Int) -> String {
    if pos >= n {
        return "";
    }
    let mut p: Int = pos;
    if field_at(list_get(toks, p), 0) == "AMP" {
        p = p + 1;
    }
    if p < n && field_at(list_get(toks, p), 0) == "IDENT" {
        return field_at(list_get(toks, p), 3);
    }
    return "";
}

// CAP-G3: Ooda cap type → oo_cap_grant_<suffix> ("" if not a known grant).
pub fn c_cap_grant_suffix(tn: String) -> String {
    if tn == "HttpCap" { return "http"; }
    if tn == "TcpCap" { return "tcp"; }
    if tn == "UdpCap" { return "udp"; }
    if tn == "BindCap" { return "bind"; }
    if tn == "NetCap" { return "net"; }
    if tn == "FsReadCap" { return "fsread"; }
    if tn == "FsWriteCap" { return "fswrite"; }
    if tn == "FsCap" { return "fs"; }
    if tn == "SysCap" { return "sys"; }
    if tn == "EnvCap" { return "env"; }
    if tn == "TimeCap" { return "time"; }
    if tn == "RandCap" { return "rand"; }
    if tn == "AllocCap" { return "alloc"; }
    if tn == "MemCap" { return "mem"; }
    if tn == "UnsafeFFICap" || tn == "FfiCap" { return "ffi"; }
    if tn == "ThreadCap" { return "thread"; }
    if tn == "GpuCap" { return "gpu"; }
    if tn == "ProcessCap" { return "process"; }
    if tn == "SyncCap" { return "sync"; }
    if tn == "SignCap" { return "sign"; }
    if tn == "AudioCap" { return "audio"; }
    if tn == "CameraCap" { return "camera"; }
    if tn == "UsbCap" { return "usb"; }
    if tn == "HidCap" { return "hid"; }
    if tn == "WindowCap" { return "window"; }
    if tn == "FrameCap" { return "frame"; }
    return "";
}
// job: type-driven main Cap grants (peel from c_emit_skip.oo)
// in:  encoded "name=suffix;name=suffix;"
// out: C grant statements on stdout
// stage: emit

// Names already declared by main ambient inject (legacy + CAP-G3 fixed set).
pub fn c_main_grant_ambient(name: String) -> Bool {
    if name == "fs" || name == "sys" || name == "env" || name == "net" { return true; }
    if name == "time" || name == "rand" || name == "alloc" || name == "ffi" { return true; }
    if name == "thread" || name == "gpu" { return true; }
    if name == "http" || name == "tcp" || name == "udp" || name == "bind" { return true; }
    if name == "fsread" || name == "fswrite" || name == "process" { return true; }
    if name == "sync" || name == "mem" || name == "sign" { return true; }
    if name == "audio" || name == "camera" || name == "usb" || name == "hid" { return true; }
    if name == "window" || name == "frame" { return true; }
    return false;
}

// CAP-G3: emit type-driven grants from encoded "name=suffix;name=suffix;".
// Ambient names rebind (type honesty); others declare long long (no undeclared C var).
pub fn c_emit_main_typed_cap_grants(mcap: String) {
    let mut mi: Int = 0;
    let mn: Int = chars_len(mcap);
    while mi < mn {
        let mut name = "";
        while mi < mn {
            let c = char_at(mcap, mi);
            if c == "=" {
                break;
            }
            name = name + c;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == "=" {
                mi = mi + 1;
            }
        }
        let mut suf = "";
        while mi < mn {
            let c2 = char_at(mcap, mi);
            if c2 == ";" {
                break;
            }
            suf = suf + c2;
            mi = mi + 1;
        }
        if mi < mn {
            if char_at(mcap, mi) == ";" {
                mi = mi + 1;
            }
        }
        if name != "" {
            if suf != "" {
                if c_main_grant_ambient(name) {
                    println("  " + name + " = oo_cap_grant_" + suf + "();");
                } else {
                    println("  long long " + name + " = oo_cap_grant_" + suf + "();");
                }
            }
        }
    }
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: complex requires/ensures runtime (M112); stage: emit

fn c_contract_expr(toks: List[String], start: Int, end: Int) -> String {
    let mut out = "";
    let mut i = start;
    while i < end {
        let tok = list_get(toks, i);
        let k: String = field_at(tok, 0);
        let v: String = field_at(tok, 3);
        if k == "IDENT" {
            if v == "result" {
                out = out + "__result ";
            } else {
                out = out + v + " ";
            }
        } else if k == "INT" || k == "FLOAT" {
            out = out + v + " ";
        } else if k == "KW_TRUE" {
            out = out + "1 ";
        } else if k == "KW_FALSE" {
            out = out + "0 ";
        } else if k == "LPAREN" {
            out = out + "( ";
        } else if k == "RPAREN" {
            out = out + ") ";
        } else if k == "ANDAND" {
            out = out + "&& ";
        } else if k == "PIPEPIPE" || k == "OROR" {
            out = out + "|| ";
        } else if k == "BANG" {
            out = out + "! ";
        } else if k == "EQEQ" {
            out = out + "== ";
        } else if k == "NEQ" {
            out = out + "!= ";
        } else if k == "GT" {
            out = out + "> ";
        } else if k == "LT" {
            out = out + "< ";
        } else if k == "GTE" {
            out = out + ">= ";
        } else if k == "LTE" {
            out = out + "<= ";
        } else if k == "PLUS" {
            out = out + "+ ";
        } else if k == "MINUS" {
            out = out + "- ";
        } else if k == "STAR" {
            out = out + "* ";
        } else if k == "SLASH" {
            out = out + "/ ";
        } else if k == "PERCENT" {
            out = out + "% ";
        } else {
            return "ERROR";
        }
        i = i + 1;
    }
    return out;
}

pub fn c_lower_ensures_return(expr: String) {
    println("  { long long __result = " + expr + ";");
    println("    if (!(OO_ENS_CHECK(__result))) {");
    println("        oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __result; }");
}

pub fn c_lower_ensures_return_str(expr: String) {
    println("  { OoStr __res_str = " + expr + "; long long __result = oo_str_len(__res_str);");
    println("    if (!(OO_ENS_CHECK(__result))) {");
    println("        oo_print_str(oo_str_lit(\"ERR\\tcontract\\tensures\")); oo_println(); oo_process_exit(1); }");
    println("    return __res_str; }");
}

pub fn c_lower_contracts(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    let mut cont = true;
    let mut ens_conds = "";
    while cont {
        if p >= n {
            println("ERR\tc_emit\tcontract: missing LBRACE after fn header");
            process_exit(1);
        }
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            cont = false;
        } else if k == "IDENT" && field_at(list_get(toks, p), 3) == "caps" {
            p = p + 1;
            if p < n && field_at(list_get(toks, p), 0) == "EQ" { p = p + 1; }
            if p < n && field_at(list_get(toks, p), 0) == "IDENT" { p = p + 1; }
        } else if k == "KW_REQUIRES" {
            let clause_start = p + 1;
            p = p + 1;
            let mut in_clause = true;
            while in_clause {
                if p >= n {
                    println("ERR\tc_emit\tcontract clause truncated");
                    process_exit(1);
                }
                let k2: String = field_at(list_get(toks, p), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    in_clause = false;
                } else if k2 == "KW_FN" || k2 == "KW_PUB" || k2 == "KW_VERIFY" || k2 == "KW_TYPE" || k2 == "EOF" {
                    println("ERR\tc_emit\tcontract clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let expr: String = c_contract_expr(toks, clause_start, p);
            if expr == "ERROR" {
                println("ERR\tc_emit\trequires residual");
                process_exit(1);
            }
            println("  if (!(" + expr + ")) {");
            println("    oo_print_str(oo_str_lit(\"ERR\\tcontract\\trequires\"));");
            println("    oo_println();");
            println("    oo_process_exit(1);");
            println("  }");
        } else if k == "KW_ENSURES" {
            let e_start = p + 1;
            p = p + 1;
            let mut in_e = true;
            while in_e {
                if p >= n {
                    println("ERR\tc_emit\tensures clause truncated");
                    process_exit(1);
                }
                let k3: String = field_at(list_get(toks, p), 0);
                if k3 == "KW_REQUIRES" || k3 == "KW_ENSURES" || k3 == "LBRACE" {
                    in_e = false;
                } else if k3 == "KW_FN" || k3 == "KW_PUB" || k3 == "KW_VERIFY" || k3 == "KW_TYPE" || k3 == "EOF" {
                    println("ERR\tc_emit\tensures clause garbage");
                    process_exit(1);
                } else {
                    p = p + 1;
                }
            }
            let expr: String = c_contract_expr(toks, e_start, p);
            if expr == "ERROR" {
                println("ERR\tc_emit\tensures residual");
                process_exit(1);
            }
            if ens_conds != "" { ens_conds = ens_conds + " && "; }
            ens_conds = ens_conds + "(" + expr + ")";
        } else if k == "KW_FN" || k == "KW_PUB" || k == "KW_VERIFY" || k == "KW_TYPE" || k == "EOF" {
            println("ERR\tc_emit\texpected LBRACE after fn header");
            process_exit(1);
        } else {
            println("ERR\tc_emit\tunexpected " + k + " before fn body");
            process_exit(1);
        }
    }
    println("#undef OO_ENS_CHECK");
    if ens_conds == "" {
        println("#define OO_ENS_CHECK(__result) (1)");
    } else {
        println("#define OO_ENS_CHECK(__result) (" + ens_conds + ")");
    }
    return p;
}

// Alias for older call sites / agent merges
pub fn c_emit_contracts_runtime(toks: List[String], pos: Int, n: Int) -> Int {
    return c_lower_contracts(toks, pos, n);
}

pub fn c_has_simple_ensures(toks: List[String], pos: Int, n: Int) -> Bool {
    let mut p = pos;
    let mut found = false;
    while p < n {
        let k: String = field_at(list_get(toks, p), 0);
        if k == "LBRACE" {
            return found;
        }
        if k == "KW_ENSURES" {
            let e_start = p + 1;
            let mut end = e_start;
            while end < n {
                let k2: String = field_at(list_get(toks, end), 0);
                if k2 == "KW_REQUIRES" || k2 == "KW_ENSURES" || k2 == "LBRACE" {
                    break;
                }
                end = end + 1;
            }
            let expr: String = c_contract_expr(toks, e_start, end);
            if expr == "ERROR" { return false; }
            found = true;
            p = end;
        } else {
            p = p + 1;
        }
    }
    return found;
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: binop prec (||/&&/bit/cmp/arith) + expr emit; string helpers in c_emit_ops_str.oo
// stage: emit

// package: backend-c — string escape + str-detect helpers (split from c_emit_ops for line pressure)
// stage: emit

// C-string escape for emit. CRITICAL: Ooda source "\r"/"\b"/"\f"/"\v"/"\0"
// are NOT control literals — they match bare letters r/b/f/v/0 (see diag_json).
// Control chars must use byte_at codes. "\n" and "\t" are real (LF/TAB).
pub fn c_escape_ctrl_byte(b: Int) -> String {
    if b == 13 { return "\\r"; }
    if b == 8 { return "\\b"; }
    if b == 12 { return "\\f"; }
    if b == 11 { return "\\v"; }
    if b == 0 { return "\\0"; }
    return "";
}

pub fn c_escape_str_text(t: String) -> String {
    // Escapes: \\ " \n \t + real controls via byte (CR/BS/FF/VT/NUL)
    let n = chars_len(t);
    if n == 0 {
        return "";
    }
    if n == 1 {
        let c = char_at(t, 0);
        if c == "\n" {
            return "\\n";
        }
        if c == "\t" {
            return "\\t";
        }
        if c == "\"" {
            return "\\\"";
        }
        if c == "\\" {
            return "\\\\";
        }
        let esc: String = c_escape_ctrl_byte(byte_at(c, 0));
        if esc != "" {
            return esc;
        }
        return t;
    }
    let mut out = "";
    let mut i = 0;
    while i < n {
        let c = char_at(t, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            let esc2: String = c_escape_ctrl_byte(byte_at(c, 0));
            if esc2 != "" {
                out = out + esc2;
            } else {
                out = out + c;
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn c_expr_is_str(e: String) -> Bool {
    let cnm: String = c_rhs_call_name(e);
    if cnm != "" {
        if c_call_result_ty(cnm) == "OoStr" {
            return true;
        }
        // free-name digests / string helpers (table miss soft-path)
        if cnm == "crypto_md5_internal" || cnm == "crypto_sha1_internal"
            || cnm == "crypto_aes_encrypt_internal" || cnm == "crypto_sha256_internal"
            || cnm == "crypto_hmac_sha256_internal" {
            return true;
        }
    }
    // Result unwrap ternary often contains ".val" near the start of (m.ok)?(m.val)
    if chars_len(e) >= 8 {
        if char_at(e, 0) == "(" && char_at(e, 1) == "(" {
            // ((m.ok) ? (m.val) ...
            if char_at(e, 6) == "o" || char_at(e, 7) == "o" {
                return true;
            }
        }
    }
    if chars_len(e) < 6 {
        return false;
    }
    if char_at(e, 0) == "o" && char_at(e, 1) == "o" && char_at(e, 2) == "_" {
        if char_at(e, 3) == "s" && char_at(e, 4) == "t" {
            return true;
        }
        // oo_byte_slice / oo_bytes_to_str / oo_bytes_from_str / oo_bytes_concat (not len/at/eq)
        if char_at(e, 3) == "b" && char_at(e, 4) == "y" && char_at(e, 5) == "t" && char_at(e, 6) == "e" {
            if chars_len(e) >= 12 && char_at(e, 7) == "_" && char_at(e, 8) == "s" {
                return true;
            }
            if chars_len(e) >= 14 && char_at(e, 7) == "s" && char_at(e, 8) == "_" {
                let c9 = char_at(e, 9);
                if c9 == "t" || c9 == "f" || c9 == "c" {
                    return true;
                }
            }
        }
        if char_at(e, 3) == "s" && char_at(e, 4) == "l" {
            if chars_len(e) >= 11 && char_at(e, 9) == "g" {
                return true;
            }
        }
        if char_at(e, 3) == "c" && char_at(e, 4) == "h" {
            if chars_len(e) >= 10 && char_at(e, 8) == "a" {
                return true;
            }
        }
        if char_at(e, 3) == "i" && char_at(e, 4) == "n" {
            if chars_len(e) >= 12 && char_at(e, 7) == "t" {
                return true;
            }
        }
    }
    return false;
}

pub fn c_expr_is_str_env(e: String, env: String) -> Bool {
    if c_env_get(env, e) == "T" {
        return true;
    }
    // Bare call: println(make(1)) — __fr__name registered when fn returns String.
    let cnm: String = c_rhs_call_name(e);
    if cnm != "" {
        if c_env_get(env, "__fr__" + cnm) == "T" {
            return true;
        }
    }
    return c_expr_is_str(e);
}

// C-like prec (higher binds tighter): || < && < | < ^ < & < cmp < << >> < + - < * / %
// AMP/PIPE single-char = bitwise; ANDAND/OROR remain logic. No float bit ops / rotate.
pub fn c_binop_prec(opk: String, opt: String) -> Int {
    if opk == "OROR" || opt == "||" { return 1; }
    if opk == "ANDAND" || opt == "&&" { return 2; }
    if opk == "PIPE" || opt == "|" { return 3; }
    if opk == "CARET" || opk == "BXOR" || opt == "^" { return 4; }
    if opk == "AMP" || opt == "&" { return 5; }
    if opk == "EQEQ" || opk == "NE" || opk == "NEQ" || opk == "LT" || opk == "GT"
        || opk == "LE" || opk == "GE" || opk == "LTE" || opk == "GTE"
        || opt == "==" || opt == "!=" || opt == "<" || opt == ">" || opt == "<=" || opt == ">="
    {
        return 6;
    }
    if opk == "LSHIFT" || opk == "RSHIFT" || opt == "<<" || opt == ">>" { return 7; }
    if opk == "PLUS" || opk == "MINUS" || opt == "+" || opt == "-" { return 8; }
    if opk == "STAR" || opk == "SLASH" || opk == "PERCENT"
        || opt == "*" || opt == "/" || opt == "%"
    {
        return 9;
    }
    return 0;
}

pub fn c_is_binop(opk: String, opt: String) -> Bool {
    return c_binop_prec(opk, opt) > 0;
}

// Result/OoResS expression? env kind R or ((OoResS) compound.
pub fn c_expr_is_res_env(e: String, env: String) -> Bool {
    if c_env_get(env, e) == "R" {
        return true;
    }
    if chars_len(e) >= 9 {
        if str_slice(e, 0, 9) == "((OoResS)" {
            return true;
        }
    }
    return false;
}

// Build C text for left OP right (string == / + special-cased).
pub fn c_binop_apply(left: String, opk: String, opt: String, right: String, env: String) -> String {
    if (opk == "EQEQ" || opt == "==") && (c_expr_is_str_env(left, env) || c_expr_is_str_env(right, env)) {
        return "oo_str_eq(" + left + ", " + right + ")";
    }
    if (opk == "NE" || opk == "NEQ" || opt == "!=")
        && (c_expr_is_str_env(left, env) || c_expr_is_str_env(right, env))
    {
        return "(!oo_str_eq(" + left + ", " + right + "))";
    }
    // M161: Result structural == / != (verify harness assert_eq! rewrite)
    if (opk == "EQEQ" || opt == "==") && (c_expr_is_res_env(left, env) || c_expr_is_res_env(right, env)) {
        return "oo_res_eq(" + left + ", " + right + ")";
    }
    if (opk == "NE" || opk == "NEQ" || opt == "!=")
        && (c_expr_is_res_env(left, env) || c_expr_is_res_env(right, env))
    {
        return "(!oo_res_eq(" + left + ", " + right + "))";
    }
    // Map known kinds → C ops on long long (bit: << >> & | ^). opt is fallback.
    let mut op = opt;
    if opk == "PLUS" { op = "+"; }
    if opk == "MINUS" { op = "-"; }
    if opk == "EQEQ" { op = "=="; }
    if opk == "LT" { op = "<"; }
    if opk == "GT" { op = ">"; }
    if opk == "ANDAND" { op = "&&"; }
    if opk == "OROR" { op = "||"; }
    if opk == "NE" || opk == "NEQ" { op = "!="; }
    if opk == "LSHIFT" { op = "<<"; }
    if opk == "RSHIFT" { op = ">>"; }
    if opk == "AMP" { op = "&"; }
    if opk == "PIPE" { op = "|"; }
    if opk == "CARET" || opk == "BXOR" { op = "^"; }
    if (opk == "PLUS" || op == "+") && (c_expr_is_str_env(left, env) || c_expr_is_str_env(right, env)) {
        return "oo_str_concat(" + left + ", " + right + ")";
    }
    return "(" + left + " " + op + " " + right + ")";
}

// Pratt left-assoc: parse ops with prec >= min_prec; right side min = prec+1.
pub fn c_emit_expr_prec(toks: List[String], pos: Int, n: Int, env: String, min_prec: Int) -> List[String] {
    let mut pack: List[String] = c_emit_primary_c(toks, pos, n, env);
    let mut guard = 0;
    while guard < 64 {
        let mut p = 0 + parse_int(list_get(pack, 0));
        let left = list_get(pack, 1);
        if p >= n {
            return pack;
        }
        let opk: String = field_at(list_get(toks, p), 0);
        let opt: String = field_at(list_get(toks, p), 3);
        let prec = 0 + c_binop_prec(opk, opt);
        if prec < min_prec {
            return pack;
        }
        p = p + 1;
        let next_min = prec + 1;
        let pr: List[String] = c_emit_expr_prec(toks, p, n, env, next_min);
        p = parse_int(list_get(pr, 0));
        let right = list_get(pr, 1);
        let expr: String = c_binop_apply(left, opk, opt, right, env);
        let mut out: List[String] = list_new();
        out = list_push(out, p.to_string());
        out = list_push(out, expr);
        pack = out;
        guard = guard + 1;
    }
    return pack;
}

// Full expression with ||/&& vs == precedence (Pratt left-assoc).
pub fn c_emit_expr_c(toks: List[String], pos: Int, n: Int, env: String) -> List[String] {
    return c_emit_expr_prec(toks, pos, n, env, 1);
}

// Back-compat entry used by stmt/call paths.
pub fn c_emit_maybe_binop(toks: List[String], left_pack: List[String], n: Int, env: String) -> List[String] {
    // Unused by new expr_prec path; keep for safety if anything still calls it.
    let p0 = 0 + parse_int(list_get(left_pack, 0));
    return c_emit_expr_prec(toks, p0, n, env, 1);
}
// package: backend-c — emit floor (see bootstrap/FLOOR.oot)
// job: call name lower + result C types for emit
// stage: emit

pub fn c_lower_call_name(name: String) -> String {
    if name == "chars_len" {
        return "oo_chars_len";
    }
    if name == "char_at" {
        return "oo_char_at";
    }
    if name == "str_slice" {
        return "oo_str_slice";
    }
    if name == "char_is_alpha" {
        return "oo_char_is_alpha";
    }
    if name == "char_is_digit" {
        return "oo_char_is_digit";
    }
    if name == "char_is_space" {
        return "oo_char_is_space";
    }
    if name == "str_contains" {
        return "oo_str_contains";
    }
    if name == "pack_skip" || name == "pack_tok" || name == "pack_err" {
        return name;
    }
    // Ok/Err lowered specially in primary (not via cname)
    return "";
}

pub fn c_list_c_name(op: String, kind: String) -> String {
    let mut k = kind;
    if k != "S" {
        k = "I";
    }
    if op == "list_new" {
        if k == "S" {
            return "oo_slist_new";
        }
        return "oo_ilist_new";
    }
    if op == "list_push" {
        if k == "S" {
            return "oo_slist_push";
        }
        return "oo_ilist_push";
    }
    if op == "list_get" {
        if k == "S" {
            return "oo_slist_get";
        }
        return "oo_ilist_get";
    }
    if op == "list_len" {
        if k == "S" {
            return "oo_slist_len";
        }
        return "oo_ilist_len";
    }
    return "";
}

// C type for known call results ("" = unknown).
pub fn c_call_result_ty(name: String) -> String {
    if name == "Ok" || name == "Err" || name == "lex_all" || name == "read_file"
        || name == "sys_exec" || name == "oo_sys_exec1" || name == "oo_sys_exec" || name == "oo_read_file"
        || name == "env_get" || name == "oo_env_get" || name == "chs_build"
        || name == "json_parse_internal" || name == "async_join_internal"
        || name == "python_embed_internal" || name == "oo_fetch" || name == "oo_dlopen"
        || name == "oo_dlsym" || name == "oo_dlclose" || name == "dlsym" || name == "dlclose"
        || name == "oo_tcp_bind" || name == "oo_tcp_connect" || name == "oo_bind_udp" || name == "oo_tls_connect"
        || name == "tcp_bind" || name == "tcp_connect" || name == "bind_udp" || name == "tls_connect"
        || name == "oo_tcp_write" || name == "oo_tcp_read" || name == "oo_udp_recv" || name == "oo_tcp_close" || name == "oo_sock_raw"
        || name == "tcp_write" || name == "tcp_read" || name == "udp_recv" || name == "tcp_close" || name == "sock_raw" || name == "raw_socket"
        || name == "oo_mutex_lock" || name == "oo_mutex_unlock" || name == "oo_thread_spawn" || name == "oo_thread_join" || name == "oo_thread_join_s" || name == "oo_gpu_launch"
        || name == "oo_channel_new" || name == "oo_channel_send" || name == "oo_channel_recv"
        || name == "oo_actor_spawn" || name == "oo_actor_send" || name == "oo_actor_recv"
        || name == "oo_verify_human" || name == "verify_human"
        || name == "mutex_lock" || name == "mutex_unlock" || name == "thread_spawn" || name == "thread_join" || name == "gpu_launch"
        || name == "channel_new" || name == "channel_send" || name == "channel_recv"
        || name == "actor_spawn" || name == "actor_send" || name == "actor_recv"
        || name == "oo_sys_spawn" || name == "oo_sys_wait" || name == "oo_sys_kill"
        || name == "sys_spawn" || name == "sys_wait" || name == "sys_kill"
