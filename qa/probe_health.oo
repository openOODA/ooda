// # Ooda CLI health Probe — Context and Health Contracts
//
// Logline: Fail closed if health or context contracts are broken.
// Setup: FsReadCap+EnvCap. No spawn. Pure argv and health probe.
// Beats:
//   1. health must print ok and probe OODA_COMPILER.
//   2. context argv dir must handle . and src.
//   3. context names filter must keep .oo only.
//   4. health with and without compiler must not panic.

import "build/context.oo";
import "build/health.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    run_ooda_health(fs_r, env, args);
    if context_argv_dir(list_new()) != "." {
        return Err("context empty args must be .");
    }
    let mut one: List[String] = list_new();
    one = list_push(one, "src");
    if context_argv_dir(one) != "src" {
        return Err("context src must be src");
    }
    let mut llm: List[String] = list_new();
    llm = list_push(llm, "--llm");
    if context_argv_dir(llm) != "." {
        return Err("context --llm must be .");
    }
    let txt: String = "a.oo\nb.txt\nc.oo\n";
    let filtered: String = ctx_filter_text(txt);
    if filtered != "a.oo\nc.oo\n" {
        return Err("ctx_filter_text must keep .oo only");
    }
    if count_nl(filtered) != 2 {
        return Err("count_nl must be 2");
    }
    if count_nl("") != 0 {
        return Err("count_nl empty must be 0");
    }
    let names: String = ctx_names_in(fs_r, ".");
    let n: Int = count_nl(names);
    if n < 1 {
        return Err("ctx_names_in . must have at least 1 file");
    }
    println("probe: health and context contracts ok");
    return Ok(0);
}
