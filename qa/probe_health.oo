// # Ooda Router health Probe — Health Moved, Context Forwards
//
// Logline: Fail closed if health or context still run in-process in ooda/main.oo.
//
// Setup: FsReadCap. Reads main.oo. Does not import build/health.oo or build/context.oo.
//
// Beats:
//   1. build/health.oo and build/context.oo must be gone.
//   2. health must print moved and exit 2.
//   3. context must forward to cli.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "build/health.oo") { return Err("moved file build/health.oo"); }
    if path_exists(fs_r, "build/context.oo") { return Err("moved file build/context.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"build/health.oo\"") {
        return Err("main.oo must not import build/health.oo");
    }
    if str_contains(src, "import \"build/context.oo\"") {
        return Err("main.oo must not import build/context.oo");
    }
    if str_contains(src, "run_ooda_health") {
        return Err("main.oo must not call run_ooda_health in-process");
    }
    if !str_contains(src, "ooda: health moved") {
        return Err("health must be a moved verb");
    }
    if !str_contains(src, "if sub == \"context\"") {
        return Err("main.oo must forward context to cli");
    }
    println("probe: health moved, context forwards to cli");
    return Ok(0);
}
