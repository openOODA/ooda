// # Ooda CLI Target Function Scorecard Probe
//
// Logline: Verify function-level 1-10 Target scoring engine correctly rewards compliant functions and traps below-threshold defects.
//
// Setup: Pure evaluation of FunctionAuditCriteria across compliant and non-compliant test vectors.
//
// Beats:
//   1. Grade a fully-compliant primary function (10/10 score).
//   2. Grade a non-compliant function with missing caps and stubs.
//   3. Assert threshold gate passes on compliant function and fails closed on non-compliant function.
//   4. Verify error reporting format.

import "std/meta/test/target_score.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    // 1. Primary 10/10 function profile
    let perfect: FunctionAuditCriteria = target_criteria_new(true, true, true, true, true, true, true, true, true, true);
    let s10: Int = target_score_function(perfect);
    if s10 != 10 {
        return Err("Target score error: expected 10/10, got " + s10.to_string());
    }
    let r_pass: Result[Bool, String] = target_evaluate_threshold(s10, 8, "compute_sha256");
    if r_pass.is_err() {
        return Err("Target threshold failure on 10/10 function");
    }

    // 2. Broken/Defective function profile (missing caps, stubs, unhandled panics)
    let broken: FunctionAuditCriteria = target_criteria_new(false, false, false, false, false, false, false, false, false, false);
    let s0: Int = target_score_function(broken);
    if s0 != 0 {
        return Err("Target score error: expected 0/10, got " + s0.to_string());
    }
    let r_fail: Result[Bool, String] = target_evaluate_threshold(s0, 7, "lazy_mock_stub");
    if r_fail.is_ok() {
        return Err("Negative Trust Violation: 0/10 broken function accepted past 7/10 threshold");
    }

    // 3. Marginal function profile (5/10)
    let marginal: FunctionAuditCriteria = target_criteria_new(true, false, true, true, true, false, true, false, false, false);
    let s5: Int = target_score_function(marginal);
    if s5 != 5 {
        return Err("Target score error: expected 5/10, got " + s5.to_string());
    }
    let r_pass5: Result[Bool, String] = target_evaluate_threshold(s5, 5, "basic_helper");
    if r_pass5.is_err() {
        return Err("Target threshold failure on 5/10 function");
    }
    let r_fail5: Result[Bool, String] = target_evaluate_threshold(s5, 7, "basic_helper");
    if r_fail5.is_ok() {
        return Err("Negative Trust Violation: 5/10 function passed 7/10 gate");
    }

    println("probe: function-level target 1-10 scorecard ok");
    return Ok(0);
}
