// # Ooda Router swarm Probe — Moved off the Router
//
// Logline: Fail closed if swarm still runs in-process on the ooda router.
//
// Setup: FsReadCap. Reads main.oo. Does not spawn agents.
//
// Beats:
//   1. build/swarm.oo must be gone.
//   2. swarm must print moved and exit 2.
//   3. The moved text must name bb and ooda-tui.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "build/swarm.oo") { return Err("moved file build/swarm.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"build/swarm.oo\"") {
        return Err("main.oo must not import build/swarm.oo");
    }
    if !str_contains(src, "ooda: swarm moved") {
        return Err("swarm must be a moved verb");
    }
    if !str_contains(src, "bb swarm status") {
        return Err("swarm moved text must name bb swarm status");
    }
    if !str_contains(src, "ooda-tui") {
        return Err("swarm moved text must name ooda-tui");
    }
    println("probe: swarm moved off the router");
    return Ok(0);
}
