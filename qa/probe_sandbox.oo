// # Ooda Router sandbox Probe — Moved off the Router
//
// Logline: Fail closed if sandbox still runs in-process on the ooda router.
//
// Setup: FsReadCap. Reads main.oo. Does not invoke Landlock or eval.
//
// Beats:
//   1. build/sandbox.oo must be gone.
//   2. sandbox must print moved and exit 2.
//   3. The moved text must name bb and ooda-tui.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "build/sandbox.oo") { return Err("moved file build/sandbox.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"build/sandbox.oo\"") {
        return Err("main.oo must not import build/sandbox.oo");
    }
    if !str_contains(src, "ooda: sandbox moved") {
        return Err("sandbox must be a moved verb");
    }
    if !str_contains(src, "bb sandbox status") {
        return Err("sandbox moved text must name bb sandbox status");
    }
    if !str_contains(src, "ooda-tui") {
        return Err("sandbox moved text must name ooda-tui");
    }
    println("probe: sandbox moved off the router");
    return Ok(0);
}
