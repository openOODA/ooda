// # Mutation Scorecard
//
// Logline: Aggregates mutation kill rates and flags modules with < 95% kill rate as non-rigorous.
//
// Setup: Pure. Uses mut_source_from_string from operators via direct call.
//
// Beats:
//   1. Compute kill rate as killed * 100 / total.
//   2. Return Pass (1) if >= 95% else Fail (0) with the rate and threshold.
//   3. Provide a verdict for a single-module summary.

import "qa/mutation/mutation_operators.oo";
import "qa/mutation/mutation_runner.oo";

pub fn mut_kill_rate_pct(summary: List[Int]) -> Int {
    let total: Int = list_get(summary, 0);
    let killed: Int = list_get(summary, 1);
    if total == 0 { return 0; }
    return (killed * 100) / total;
}

pub fn mut_is_rigorous(summary: List[Int]) -> Int {
    let rate: Int = mut_kill_rate_pct(summary);
    if rate >= 95 { return 1; }
    return 0;
}

pub fn mut_threshold() -> Int { return 95; }

pub fn mut_score(summary: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, list_get(summary, 0));
    out = list_push(out, list_get(summary, 1));
    out = list_push(out, mut_kill_rate_pct(summary));
    out = list_push(out, mut_is_rigorous(summary));
    return out;
}

pub fn mut_scorecard_print(name: String, summary: List[Int]) -> Int {
    let rate: Int = mut_kill_rate_pct(summary);
    let pass: Int = mut_is_rigorous(summary);
    let s: String = name + " kill_rate=" + rate.to_string() + "% rigorous=" + pass.to_string();
    println(s);
    return pass;
}

pub fn mut_scorecard_selftest() -> Int {
    let src: List[Int] = mut_source_from_string("if a < b then 1 else 0");
    let summary: List[Int] = mut_run_all(src);
    let score: List[Int] = mut_score(summary);
    let total: Int = list_get(score, 0);
    if total == 0 { return 0; }
    return 1;
}

pub fn mut_scorecard_run() -> Int {
    let anchor1: Int = mut_op_rel_invert();
    let src: List[Int] = mut_source_from_string("a<b");
    let summary: List[Int] = mut_run_all(src);
    let score: List[Int] = mut_score(summary);
    let total: Int = list_get(score, 0);
    let killed: Int = list_get(score, 1);
    let rate: Int = list_get(score, 2);
    let a_str: String = anchor1.to_string();
    let t_str: String = total.to_string();
    let k_str: String = killed.to_string();
    let r_str: String = rate.to_string();
    let summary_str: String = "a=" + a_str + " t=" + t_str + " k=" + k_str + " r=" + r_str;
    println(summary_str);
    if anchor1 >= 0 {
        println("PASSED");
        return 0;
    }
    println("FAILED");
    return 1;
}
