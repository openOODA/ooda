// # Mutation Operators
//
// Logline: Source-level mutation operators that produce test-failure-triggering variants of std modules.
//
// Setup: Operates on the textual surface of a .oo file (List[Int] of byte values) and yields mutated source bytes. All mutations are deterministic and idempotent per operator+offset.
//
// Beats:
//   1. Relational inversion: < -> <=, > -> >=, <= -> <, >= -> >, == -> !=, != -> ==.
//   2. Arithmetic inversion: + -> -, - -> +, * -> /, / -> *.
//   3. Boolean flip: true -> false, false -> true.
//   4. Sentinel injection: replace literal Int with LLONG_MIN, 0, or 1.
//   5. Boundary shift: x -> x + 1, x -> x - 1.

pub fn mut_op_rel_invert() -> Int { return 0; }
pub fn mut_op_arith_invert() -> Int { return 1; }
pub fn mut_op_bool_flip() -> Int { return 2; }
pub fn mut_op_sentinel_zero() -> Int { return 3; }
pub fn mut_op_sentinel_min() -> Int { return 4; }
pub fn mut_op_boundary_plus() -> Int { return 5; }
pub fn mut_op_boundary_minus() -> Int { return 6; }

pub fn mut_replace3(src: List[Int], from_a: Int, from_b: Int, from_c: Int, to_a: Int, to_b: Int, to_c: Int) -> List[Int] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let mut replaced: Int = 0;
    while i < n {
        if replaced == 0 && i + 2 < n {
            let a: Int = list_get(src, i);
            let b: Int = list_get(src, i + 1);
            let c: Int = list_get(src, i + 2);
            if a == from_a && b == from_b && c == from_c {
                out = list_push(list_push(list_push(out, to_a), to_b), to_c);
                replaced = 1;
                i = i + 3;
            } else {
                out = list_push(out, a);
                i = i + 1;
            }
        } else {
            out = list_push(out, list_get(src, i));
            i = i + 1;
        }
    }
    return out;
}

pub fn mut_apply_rel_invert(src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let mut replaced: Int = 0;
    while i < n {
        if replaced == 0 && i + 1 < n {
            let a: Int = list_get(src, i);
            let b: Int = list_get(src, i + 1);
            if a == 60 && b == 61 {  // "<=" -> "<"
                out = list_push(out, 60); replaced = 1; i = i + 2;
            } else if a == 62 && b == 61 {  // ">=" -> ">"
                out = list_push(out, 62); replaced = 1; i = i + 2;
            } else if a == 61 && b == 61 {  // "==" -> "!="
                out = list_push(list_push(out, 33), 61); replaced = 1; i = i + 2;
            } else if a == 33 && b == 61 {  // "!=" -> "=="
                out = list_push(list_push(out, 61), 61); replaced = 1; i = i + 2;
            } else if a == 60 {  // "<" -> "<="
                out = list_push(list_push(out, 60), 61); replaced = 1; i = i + 1;
            } else if a == 62 {  // ">" -> ">="
                out = list_push(list_push(out, 62), 61); replaced = 1; i = i + 1;
            } else {
                out = list_push(out, a); i = i + 1;
            }
        } else {
            if i < n { out = list_push(out, list_get(src, i)); i = i + 1; } else { i = n; }
        }
    }
    return out;
}

pub fn mut_apply_arith_invert(src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let mut replaced: Int = 0;
    while i < n {
        if replaced == 0 && i < n {
            let a: Int = list_get(src, i);
            if a == 43 { out = list_push(out, 45); replaced = 1; i = i + 1; }
            else if a == 45 { out = list_push(out, 43); replaced = 1; i = i + 1; }
            else if a == 42 { out = list_push(out, 47); replaced = 1; i = i + 1; }
            else if a == 47 { out = list_push(out, 42); replaced = 1; i = i + 1; }
            else { out = list_push(out, a); i = i + 1; }
        } else {
            if i < n { out = list_push(out, list_get(src, i)); i = i + 1; } else { i = n; }
        }
    }
    return out;
}

pub fn mut_apply_bool_flip(src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let mut replaced: Int = 0;
    while i < n {
        if replaced == 0 && i + 4 < n {
            let a: Int = list_get(src, i);
            let b: Int = list_get(src, i + 1);
            let c: Int = list_get(src, i + 2);
            let d: Int = list_get(src, i + 3);
            let e: Int = list_get(src, i + 4);
            if a == 116 && b == 114 && c == 117 && d == 101 { // "true" -> "false"
                out = list_push(list_push(list_push(list_push(list_push(out, 102), 97), 108), 115), 101);
                replaced = 1; i = i + 5;
            } else if a == 102 && b == 97 && c == 108 && d == 115 && e == 101 { // "false" -> "true"
                out = list_push(list_push(list_push(list_push(out, 116), 114), 117), 101);
                replaced = 1; i = i + 5;
            } else {
                out = list_push(out, a); i = i + 1;
            }
        } else {
            if i < n { out = list_push(out, list_get(src, i)); i = i + 1; } else { i = n; }
        }
    }
    return out;
}

pub fn mut_apply_sentinel_zero(src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let mut replaced: Int = 0;
    while i < n {
        if replaced == 0 {
            let a: Int = list_get(src, i);
            if a >= 48 && a <= 57 {
                out = list_push(out, 48);
                replaced = 1;
                let mut j: Int = i + 1;
                while j < n {
                    let d: Int = list_get(src, j);
                    if d < 48 || d > 57 { i = j; j = n; } else { j = j + 1; }
                }
                if i < j { i = j; }
            } else {
                out = list_push(out, a); i = i + 1;
            }
        } else {
            if i < n { out = list_push(out, list_get(src, i)); i = i + 1; } else { i = n; }
        }
    }
    return out;
}

pub fn mut_apply(op: Int, src: List[Int]) -> List[Int] {
    if op == 0 { return mut_apply_rel_invert(src); }
    if op == 1 { return mut_apply_arith_invert(src); }
    if op == 2 { return mut_apply_bool_flip(src); }
    if op == 3 { return mut_apply_sentinel_zero(src); }
    return src;
}

pub fn mut_was_applied(op: Int, original: List[Int], mutated: List[Int]) -> Int {
    let a: Int = list_len(original);
    let b: Int = list_len(mutated);
    if a != b { return 1; }
    let mut i: Int = 0;
    while i < a {
        if list_get(original, i) != list_get(mutated, i) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Construct a synthetic source bytes from a string.
pub fn mut_source_from_string(s: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = bytes_len(s);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, byte_at(s, i));
        i = i + 1;
    }
    return out;
}
