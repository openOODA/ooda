// # Ooda Router eval/repl Probe — Moved to ooda-tui
//
// Logline: Fail closed if eval or repl still run in-process on the ooda router.
//
// Setup: FsReadCap. Reads main.oo. Does not spawn an evaluator.
//
// Beats:
//   1. build/eval.oo and build/repl.oo must be gone.
//   2. eval and repl must print moved and exit 2.
//   3. The moved text must name ooda-tui.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "build/eval.oo") { return Err("moved file build/eval.oo"); }
    if path_exists(fs_r, "build/repl.oo") { return Err("moved file build/repl.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"build/eval.oo\"") {
        return Err("main.oo must not import build/eval.oo");
    }
    if str_contains(src, "import \"build/repl.oo\"") {
        return Err("main.oo must not import build/repl.oo");
    }
    if !str_contains(src, "ooda: eval moved") {
        return Err("eval must be a moved verb");
    }
    if !str_contains(src, "ooda: repl moved") {
        return Err("repl must be a moved verb");
    }
    if !str_contains(src, "ooda-tui") {
        return Err("eval/repl moved text must name ooda-tui");
    }
    println("probe: eval and repl moved to ooda-tui");
    return Ok(0);
}
