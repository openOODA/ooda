// # CRIT1 Root FD Starvation
//
// Logline: Pin the ROOT-resolution FD-starvation repro so ooda check fails closed instead of printing a false OK.
//
// Setup: cwd is ooda/; qa/repro_crit1_fd_starvation_root.sh is the live repro; fixtures/chs_list_string.oo is the check target.
//
// Beats:
//   1. Gate repro, fixture, and ooda paths with sh_arg_ok.
//   2. Expect the .sh, the fixture, and an executable bin/ooda.
//   3. Expect ulimit -n 4, ERR_ROOT_INVALID, and the false-OK reject on the .sh.
//
// residual: live ulimit ROOT-resolution repro stays the .sh

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let repro = "qa/repro_crit1_fd_starvation_root.sh";
    let fixture = "fixtures/chs_list_string.oo";
    let ooda = "bin/ooda";
    let _ = scenario(p, fs, "CRIT1 root FD starvation");

    let mut fails: Int = 0;
    fn tally(r: Result[Void, String], tag: String) -> Int {
        if r.is_ok() { println("OK " + tag); return 0; }
        println("FAIL " + tag);
        return 1;
    }

    // when repro, fixture, and ooda present
    // and paths pass sh_arg_ok
    // then ooda check under ulimit -n 4 fails closed in the .sh

    if !sh_arg_ok(repro) || !sh_arg_ok(fixture) || !sh_arg_ok(ooda) {
        println("FAIL sh_arg_ok path");
        process_exit(1);
    }

    fails = fails + tally(expect_present(fs, repro), "root repro present");
    fails = fails + tally(expect_present(fs, fixture), "chs_list_string.oo present");
    fails = fails + tally(expect_quiet(p, "test -x " + ooda), "bin/ooda executable");

    fails = fails + tally(expect_substring(fs, repro, "ulimit -n 4"), "ulimit -n 4");
    fails = fails + tally(expect_substring(fs, repro, "chs_list_string.oo"), "check fixture named");
    fails = fails + tally(expect_substring(fs, repro, "ERR_ROOT_INVALID"), "ERR_ROOT_INVALID");
    fails = fails + tally(expect_substring(fs, repro, "Too many open files"), "Too many open files");
    fails = fails + tally(expect_substring(fs, repro, "false OK"), "false OK reject");

    if fails > 0 {
        println("repro_crit1_fd_starvation_root.oo: FAILED");
        process_exit(1);
    }
    println("repro_crit1_fd_starvation_root.oo: PASSED");
}
