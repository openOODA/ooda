// # Probe Honesty Tests
//
// Logline: Claims and docs honesty pack matches the real product surface on emit-llvm, fuzz, release residual, wasm, and oodac llvm backend.
//
// Setup: bin/ooda plus oodac/oodac or bootstrap/seed/oodac; qa/probe_honesty_tests.sh stays the rail.
//
// Beats:
//   1. Prove product binaries and the honesty fixture exist.
//   2. Gate the leftover honesty .sh path with sh_arg_ok.
//   3. Fail-closed run the honesty rail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let rail = "qa/probe_honesty_tests.sh";
    let ooda = "bin/ooda";
    let oodac = "oodac/oodac";
    let seed = "bootstrap/seed/oodac";
    let fix = "fixtures/chs_list_string.oo";
    let _ = scenario(p, fs, "probe honesty");

    // when product binaries and honesty fixture exist
    // and --emit-llvm is a product path
    // and --fuzz is an un-gated int-domain surface
    // and --release residual fail-closes at exit 2
    // and --target wasm plus oodac --backend llvm are product surfaces
    // then probe_honesty_tests PASSED

    if !sh_arg_ok(rail) || !sh_arg_ok(ooda) || !sh_arg_ok(oodac) || !sh_arg_ok(seed) || !sh_arg_ok(fix) {
        println("FAIL sh_arg_ok path");
        process_exit(1);
    }

    expect_present(fs, ooda);
    expect_quiet(p, "test -x " + ooda);
    if expect_present(fs, oodac).is_ok() {
        expect_quiet(p, "test -x " + oodac);
    } else {
        expect_present(fs, seed);
        expect_quiet(p, "test -x " + seed);
    }
    expect_present(fs, fix);
    expect_present(fs, rail);

    expect_substring(fs, rail, "--emit-llvm");
    expect_substring(fs, rail, "--fuzz");
    expect_substring(fs, rail, "--release residual");
    expect_substring(fs, rail, "--target wasm");
    expect_substring(fs, rail, "--backend llvm");

    let ran = process_exec(p, "bash " + rail);
    if ran.is_err() {
        println("probe_honesty_tests: FAILED");
        process_exit(1);
    }
    println("probe_honesty_tests: PASSED");
}
