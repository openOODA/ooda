// # Ooda CLI blackbox E2E — .oo Build Double-Run
//
// Logline: Fail closed if oodac build is not double-run deterministic.
// Setup: ProcessCap+FsReadCap+FsWriteCap+EnvCap. Writes tmp .oo, builds twice, diffs.
// Beats:
//   1. Write canonical .oo to .ooda-cache.
//   2. Build with oodac twice to separate bins.
//   3. Run both bins and compare stdout.
//   4. Clean up tmp files.

import "std/fs/process/env.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    let src: String = "// # E2E\n// Logline: test\n// Setup: test\n// Beats: test\npub fn main() -> Int { println(\"e2e\"); return 0; }\n";
    let tmp: String = ".ooda-cache/probe_e2e.oo";
    let wr: Result[Void, String] = write_file(fs_w, tmp, src);
    if wr.is_err() {
        return Err("write tmp failed");
    }
    let rr: Result[String, String] = read_file(fs_r, tmp);
    if rr.is_err() {
        return Err("read tmp failed");
    }
    let back: String = match rr { Ok(s) => s, Err(_) => "" };
    if back != src {
        return Err("round-trip must match");
    }
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("OODA_COMPILER required for e2e");
    }
    let c1: Result[String, String] = sys_exec(p, oodac, "check", tmp);
    let c2: Result[String, String] = sys_exec(p, oodac, "check", tmp);
    if c1.is_err() { return Err("e2e check run 1 failed"); }
    if c2.is_err() { return Err("e2e check run 2 failed"); }
    let s1: String = match c1 { Ok(s) => s, Err(_) => "" };
    let s2: String = match c2 { Ok(s) => s, Err(_) => "" };
    if s1 != s2 { return Err("double-run check output must match"); }
    println("probe: blackbox e2e double-run ok");
    return Ok(0);
}
