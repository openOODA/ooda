// # Ooda CLI api_surface Probe — Four Subdirs, Dead Files Gone
//
// Logline: Fail closed if the 4 command subdirs are missing or if killed files return.
//
// Setup: FsReadCap. Paths are relative to the repo root.
//
// Beats:
//   1. Require build/, fix/, fmt/, token/, and main.oo.
//   2. Reject build/args.oo, build/json_check.oo, build/reproducible.oo, fix/patch.oo.
//   3. Return Ok(0) only when the live surface matches.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if !path_exists(fs_r, "build") { return Err("missing build/"); }
    if !path_exists(fs_r, "fix") { return Err("missing fix/"); }
    if !path_exists(fs_r, "fmt") { return Err("missing fmt/"); }
    if !path_exists(fs_r, "token") { return Err("missing token/"); }
    if !path_exists(fs_r, "main.oo") { return Err("missing main.oo"); }
    if path_exists(fs_r, "build/args.oo") { return Err("dead file build/args.oo"); }
    if path_exists(fs_r, "build/json_check.oo") { return Err("dead file build/json_check.oo"); }
    if path_exists(fs_r, "build/reproducible.oo") { return Err("dead file build/reproducible.oo"); }
    if path_exists(fs_r, "fix/patch.oo") { return Err("dead file fix/patch.oo"); }
    println("probe: api_surface=4 dead files gone");
    return Ok(0);
}
