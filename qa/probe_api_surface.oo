// # Ooda Router api_surface Probe — Router Files Present, Moved Files Gone
//
// Logline: Fail closed if router files are missing or if handlers that moved to cli return.
//
// Setup: FsReadCap. Paths are relative to the repo root.
//
// Beats:
//   1. Require main.oo, build/spawn.oo, and placeholder build/, fix/, fmt/.
//   2. Reject dead files and handlers that moved to cli (test, gen, bench, digest).
//   3. Return Ok(0) only when the live surface matches the router.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if !path_exists(fs_r, "main.oo") { return Err("missing main.oo"); }
    if !path_exists(fs_r, "build") { return Err("missing build/"); }
    if !path_exists(fs_r, "build/spawn.oo") { return Err("missing build/spawn.oo"); }
    if !path_exists(fs_r, "fix") { return Err("missing fix/"); }
    if !path_exists(fs_r, "fmt") { return Err("missing fmt/"); }
    if path_exists(fs_r, "build/args.oo") { return Err("dead file build/args.oo"); }
    if path_exists(fs_r, "build/json_check.oo") { return Err("dead file build/json_check.oo"); }
    if path_exists(fs_r, "build/reproducible.oo") { return Err("dead file build/reproducible.oo"); }
    if path_exists(fs_r, "fix/patch.oo") { return Err("dead file fix/patch.oo"); }
    if path_exists(fs_r, "token/cmd_extra.oo") { return Err("dead file token/cmd_extra.oo"); }
    if path_exists(fs_r, "build/test.oo") { return Err("moved file build/test.oo"); }
    if path_exists(fs_r, "build/gen.oo") { return Err("moved file build/gen.oo"); }
    if path_exists(fs_r, "build/bench.oo") { return Err("moved file build/bench.oo"); }
    if path_exists(fs_r, "build/context.oo") { return Err("moved file build/context.oo"); }
    if path_exists(fs_r, "build/health.oo") { return Err("moved file build/health.oo"); }
    if path_exists(fs_r, "build/update.oo") { return Err("moved file build/update.oo"); }
    if path_exists(fs_r, "build/host_build.oo") { return Err("moved file build/host_build.oo"); }
    if path_exists(fs_r, "build/qa.oo") { return Err("moved file build/qa.oo"); }
    if path_exists(fs_r, "fix/digest.oo") { return Err("moved file fix/digest.oo"); }
    if path_exists(fs_r, "fmt/fmt.oo") { return Err("moved file fmt/fmt.oo"); }
    if path_exists(fs_r, "token/cmd_token.oo") { return Err("moved file token/cmd_token.oo"); }
    println("probe: api_surface=router files present, moved handlers gone");
    return Ok(0);
}
