// # Probe Lifecycle Tests
//
// Logline: Data lifecycle pack L1-L6 holds on compiled product binaries: handles close, torn writes fail, children reap, temps and patch scratch stay gone.
//
// Setup: bin/ooda plus oodac/oodac or bootstrap/seed/oodac; qa/probe_lifecycle_tests.sh stays the rail.
//
// Beats:
//   1. Prove product binaries and the lifecycle fixture exist.
//   2. Gate the leftover lifecycle .sh path with sh_arg_ok.
//   3. Fail-closed run the L1-L6 rail.

import "std/scenario.oo";
import "std/sh.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let rail = "qa/probe_lifecycle_tests.sh";
    let ooda = "bin/ooda";
    let oodac = "oodac/oodac";
    let seed = "bootstrap/seed/oodac";
    let fix = "fixtures/chs_list_string.oo";
    let _ = scenario(p, fs, "probe lifecycle");

    // when product binaries and lifecycle fixture exist
    // and L1 repeated check closes file handles
    // and L2 write_file on a full target returns Err
    // and L3 sys_exec reaps the child
    // and L4 ooda run plus L5 atomic patch leave no temps
    // then probe_lifecycle_tests PASSED

    if !sh_arg_ok(rail) || !sh_arg_ok(ooda) || !sh_arg_ok(oodac) || !sh_arg_ok(seed) || !sh_arg_ok(fix) {
        println("FAIL sh_arg_ok path");
        process_exit(1);
    }

    expect_present(fs, ooda);
    expect_quiet(p, "test -x " + ooda);
    if expect_present(fs, oodac).is_ok() {
        expect_quiet(p, "test -x " + oodac);
    } else {
        expect_present(fs, seed);
        expect_quiet(p, "test -x " + seed);
    }
    expect_present(fs, fix);
    expect_present(fs, rail);

    expect_substring(fs, rail, "repeated check");
    expect_substring(fs, rail, "TORN_SAFE");
    expect_substring(fs, rail, "SYS_REAPED");
    expect_substring(fs, rail, "ooda_run_");
    expect_substring(fs, rail, "atomic patch");

    let ran = process_exec(p, "bash " + rail);
    if ran.is_err() {
        println("probe_lifecycle_tests: FAILED");
        process_exit(1);
    }
    println("probe_lifecycle_tests: PASSED");
}
