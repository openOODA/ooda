// # Ooda Router fmt Probe — Fmt Forwards to cli
//
// Logline: Fail closed if fmt still lives in-process or help omits the cli forward.
//
// Setup: FsReadCap. Reads main.oo. Does not import fmt/fmt.oo (moved to cli).
//
// Beats:
//   1. fmt/fmt.oo must be gone.
//   2. main.oo must forward fmt through forward_to_cli.
//   3. router_help must list fmt among language verbs.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "fmt/fmt.oo") { return Err("moved file fmt/fmt.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"fmt/fmt.oo\"") {
        return Err("main.oo must not import fmt/fmt.oo");
    }
    if str_contains(src, "run_ooda_fmt") {
        return Err("main.oo must not call run_ooda_fmt in-process");
    }
    if !str_contains(src, "if sub == \"fmt\"") {
        return Err("main.oo must forward fmt to cli");
    }
    if !str_contains(src, "forward_to_cli") {
        return Err("main.oo must call forward_to_cli");
    }
    if !str_contains(src, "build, run, test, fmt,") {
        return Err("router_help must list fmt as a language CLI verb");
    }
    println("probe: fmt forwards to cli");
    return Ok(0);
}
