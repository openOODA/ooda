// # Ooda CLI fmt Probe — Idempotence and Traversal
//
// Logline: Fail closed if fmt is not idempotent or allows traversal.
// Setup: FsReadCap+FsWriteCap+AllocCap. Pure fmt_verify plus file probes. No shell.
// Beats:
//   1. fmt_verify_idempotent on canonical src must be true.
//   2. fmt_print must be idempotent.
//   3. Traversal path with .. must be rejected.
//   4. Non-.oo path must be rejected.

import "fmt/fmt.oo";
import "std/core/format/fmt_verify.oo";
import "std/core/format/fmt_printer.oo";
import "std/core/format/fmt_parser.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    let src: String = "// # Title\n// Logline: test\n// Setup: test\n// Beats: test\npub fn main() -> Int { return 0; }\n";
    if !fmt_verify_idempotent(src) {
        return Err("fmt idempotent must be true on canonical src");
    }
    let out: String = fmt_print(src);
    if out != src {
        if !fmt_verify_idempotent(out) {
            return Err("fmt re-print must stay idempotent");
        }
    }
    if !fmt_verify_identical(src, src) {
        return Err("identical src must verify");
    }
    if fmt_verify_identical(src, src + " ") {
        return Err("different src must not verify identical");
    }
    let tr_rc: Int = run_ooda_fmt(fs_r, fs_w, alloc, list_push(list_new(), "../evil.oo"));
    if tr_rc == 0 {
        return Err("fmt must reject traversal ../evil.oo");
    }
    let bad: String = "not_oo.txt";
    if str_ends_with(bad, ".oo") {
        return Err("non-.oo must not pass extension check");
    }
    let good: String = "good.oo";
    if !str_ends_with(good, ".oo") {
        return Err("good.oo must pass extension check");
    }
    let res: Int = run_ooda_fmt(fs_r, fs_w, alloc, list_new());
    if res != 1 {
        return Err("fmt with no args must return 1");
    }
    println("probe: fmt idempotence and traversal ok");
    return Ok(0);
}
