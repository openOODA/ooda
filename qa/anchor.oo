// # Ooda CLI QA Index — Anchor for Agents
//
// Logline: Index of the ooda router self-test probe drivers.
//
// Setup: Live router probes only.
//
// Beats:
//   1. probe_spawn.oo — OODACODEX bin path only. No PATH.
//   2. probe_api_surface.oo — 4 subdirs present.
//   3. probe_binary_parity.oo — user binary parity and fail-closed flags.
//   4. probe_blackbox_e2e.oo — oodac build double-run.
//   5. probe_target_fn.oo — function-level target scorecard.
//   6. probe_em_score.oo — performance model specific excess power.
//   7. suite.oo — runs every live probe twice.

import "suite.oo";
import "probe_spawn.oo";
import "probe_api_surface.oo";
import "probe_binary_parity.oo";
import "probe_blackbox_e2e.oo";
import "probe_target_fn.oo";
