// # QA spine: product CLI fix and patch refuse unsafe writes
//
// Logline: Drive shipped ooda fix and ooda patch so they refuse bad paths, symlinks, and unset writedir.
//
// Setup: cwd is ooda/. Seed is fixtures/qa_write_seed.oo. ProcessCap runs the CLI.
//
// Beats:
//   1. Scan bytes. bin/ooda is the product CLI.
//   2. fix refuses an absolute path, a dot-dot path, and a symlink.
//   3. Unset writedir denies the fix write. The seed file stays unchanged.
//   4. patch refuses an absolute path, a dot-dot path, a symlink, and unset writedir.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn want(p: &ProcessCap, cmd: String, needle: String) {
    let outp: String = ".ooda-cache/ooda-tmp/wg_one.txt";
    let sh: String = "mkdir -p .ooda-cache/ooda-tmp; " + cmd + " > " + outp + " 2>&1; echo rc=$? >> " + outp;
    if process_exec(p, sh).is_err() {
        fail("exec " + cmd);
    }
    if process_exec(p, "grep -q '" + needle + "' " + outp).is_err() {
        fail("missing " + needle);
    }
    if process_exec(p, "grep -q '^rc=0$' " + outp).is_ok() {
        fail("zero rc " + cmd);
    }
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if !path_exists(fs, "bin/ooda") {
        fail("no bin/ooda");
    }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' oodac/oodac").is_ok() {
        fail("ERR_OODAC_IS_CLI");
    }
    if process_exec(p, "grep -a -q 'pure .oo product CLI' bin/ooda").is_err() {
        fail("cli is not product CLI");
    }
    if !path_exists(fs, "fixtures/qa_write_seed.oo") {
        fail("no write seed");
    }
    want(p, "./bin/ooda fix /etc/passwd --yes", "ERR\tfix\tbad path");
    want(p, "./bin/ooda fix fixtures/../fixtures/hello.oo --yes", "ERR\tfix\tbad path");
    if process_exec(p, "ln -sfn ../../fixtures/hello.oo .ooda-cache/ooda-tmp/wg_link.oo").is_err() {
        fail("symlink");
    }
    want(p, "./bin/ooda fix .ooda-cache/ooda-tmp/wg_link.oo --yes", "ERR\tfix\tsymlink refused");
    if process_exec(p, "cp fixtures/qa_write_seed.oo .ooda-cache/ooda-tmp/wg_must.oo").is_err() {
        fail("copy seed");
    }
    want(p, "env -u OODA_FS_WRITEDIR ./bin/ooda fix .ooda-cache/ooda-tmp/wg_must.oo --yes", "ERR\tfix\twrite_file denied");
    if process_exec(p, "grep -q 'is_err()' .ooda-cache/ooda-tmp/wg_must.oo").is_ok() {
        fail("seed mutated");
    }
    want(p, "./bin/ooda patch /tmp/x.oo --replace-fn main --with fixtures/hello.oo", "ERR\tpatch\tbad path");
    want(p, "./bin/ooda patch fixtures/../fixtures/hello.oo --replace-fn main --with fixtures/hello.oo", "ERR\tpatch\tbad path");
    want(p, "./bin/ooda patch fixtures/hello.oo --replace-fn main --with /tmp/x.oo", "ERR\tpatch\tbad body path");
    want(p, "./bin/ooda patch fixtures/hello.oo --replace-fn main --with fixtures/../fixtures/hello.oo", "ERR\tpatch\tbad body path");
    want(p, "./bin/ooda patch .ooda-cache/ooda-tmp/wg_link.oo --replace-fn main --with fixtures/hello.oo", "ERR\tpatch\tsymlink refused");
    want(p, "./bin/ooda patch fixtures/hello.oo --replace-fn main --with .ooda-cache/ooda-tmp/wg_link.oo", "ERR\tpatch\tsymlink refused");
    if process_exec(p, "cp fixtures/patch_add.oo .ooda-cache/ooda-tmp/wg_patch.oo").is_err() {
        fail("copy patch");
    }
    want(p, "env -u OODA_FS_WRITEDIR ./bin/ooda patch .ooda-cache/ooda-tmp/wg_patch.oo --replace-fn add --with fixtures/patch_add_body.txt", "ERR\tfix\twrite_file denied");
    if process_exec(p, "grep -q 'return a + b' .ooda-cache/ooda-tmp/wg_patch.oo").is_err() {
        fail("patch target mutated");
    }
    println("qa write_gate_spine: PASSED");
}
