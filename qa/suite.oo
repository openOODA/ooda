// # Test Ooda CLI — Run Self-Tests Twice
//
// Logline: Run each live qa probe twice under OODA_COMPILER. Fail closed on miss.
//
// Setup: Double-run law. Resolves compiler via standard environment contract.
//
// Beats:
//   1. Resolve primary compiler binary.
//   2. Compile and execute each probe twice in fresh processes.
//   3. Clean up probe executables and fail closed on error.

import "std/fs/process/env.oo";
import "std/fs/file/path.oo";

fn run_probe_once(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let tmp_bin: String = path + ".tmp.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", "--backend", "c", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, "env", "OODA_COMPILER=" + oodac, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("exec fail " + path + ": " + e);
    }
    return Ok(0);
}

fn run_probe_twice(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let r1: Result[Int, String] = run_probe_once(p, oodac, path);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_probe_once(p, oodac, path);
    if r2.is_err() { return r2; }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }

    let mut ps: List[String] = list_new();
    ps = list_push(ps, "qa/probe_spawn.oo");
    ps = list_push(ps, "qa/probe_api_surface.oo");
    ps = list_push(ps, "qa/probe_blackbox_e2e.oo");
    ps = list_push(ps, "qa/probe_target_fn.oo");
    ps = list_push(ps, "qa/probe_em_score.oo");
    ps = list_push(ps, "qa/probe_binary_parity.oo");

    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path);
        if r.is_err() {
            let msg: String = match r { Ok(_) => "", Err(e) => e };
            println("ERR " + path + ": " + msg);
            return r;
        }
        i = i + 1;
    }
    println("ooda test suite: ALL PROBES PASSED (double-run identical)");
    return Ok(0);
}
