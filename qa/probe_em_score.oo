// # Boyd Performance model QA Gauge Probe
//
// Logline: Verify Performance model specific excess power computation and aerodynamic stall detection fail-closed.
//
// Setup: Imports std/meta/test/em_gauge.oo and evaluates high-thrust primary functions vs high-drag stalled functions.
//
// Beats:
//   1. Evaluate high-thrust primary profile and verify SUPERMANEUVERABLE rating.
//   2. Evaluate supercruise profile and verify SUPERCRUISE rating.
//   3. Evaluate aerodynamic stall where drag exceeds thrust and verify fail-closed detection.
//   4. Evaluate invalid zero-weight edge condition and verify division-by-zero protection.
//   5. Assert em_assert_not_stalled gate passes on primary profile and rejects stalled profile.

import "std/meta/test/em_gauge.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    // 1. Sovereign High-Thrust Profile (Thrust=1000, Drag=50, Weight=10, Velocity=100)
    let m_super: EmMetrics = em_gauge_metrics_new(1000, 50, 10, 100);
    let r_super: EmScoreResult = em_gauge_calculate(m_super);
    if r_super.is_stalled {
        return Err("E-M error: primary function flagged as stalled");
    }
    if r_super.specific_excess_power != 9500 {
        return Err("E-M error: expected Ps=9500, got " + r_super.specific_excess_power.to_string());
    }
    if r_super.rating != "SUPERMANEUVERABLE" {
        return Err("E-M error: expected SUPERMANEUVERABLE, got " + r_super.rating);
    }
    let gate_super: Result[Bool, String] = em_gauge_assert_not_stalled(r_super);
    if gate_super.is_err() {
        return Err("E-M gate error: primary function rejected by gate");
    }

    // 2. Supercruise Profile (Thrust=200, Drag=100, Weight=20, Velocity=100)
    let m_cruise: EmMetrics = em_gauge_metrics_new(200, 100, 20, 100);
    let r_cruise: EmScoreResult = em_gauge_calculate(m_cruise);
    if r_cruise.is_stalled {
        return Err("E-M error: supercruise function flagged as stalled");
    }
    if r_cruise.specific_excess_power != 500 {
        return Err("E-M error: expected Ps=500, got " + r_cruise.specific_excess_power.to_string());
    }
    if r_cruise.rating != "SUPERCRUISE" {
        return Err("E-M error: expected SUPERCRUISE, got " + r_cruise.rating);
    }

    // 3. High-Drag Aerodynamic Stall (Thrust=50, Drag=100, Weight=10, Velocity=100)
    let m_stall: EmMetrics = em_gauge_metrics_new(50, 100, 10, 100);
    let r_stall: EmScoreResult = em_gauge_calculate(m_stall);
    if !r_stall.is_stalled {
        return Err("Negative Trust Violation: High-drag function failed to trigger aerodynamic stall");
    }
    if r_stall.rating != "AERODYNAMIC_STALL" {
        return Err("E-M error: expected AERODYNAMIC_STALL rating, got " + r_stall.rating);
    }
    let gate_stall: Result[Bool, String] = em_gauge_assert_not_stalled(r_stall);
    if gate_stall.is_ok() {
        return Err("Negative Trust Violation: Stalled function bypassed em_assert_not_stalled gate");
    }

    // 4. Invalid Zero-Weight Boundary (Weight=0)
    let m_zero: EmMetrics = em_metrics_new(100, 10, 0, 100);
    let r_zero: EmScoreResult = em_calculate(m_zero);
    if !r_zero.is_stalled {
        return Err("Negative Trust Violation: Zero-weight vector failed to trigger stall");
    }
    if r_zero.rating != "INVALID_ZERO_WEIGHT" {
        return Err("E-M error: expected INVALID_ZERO_WEIGHT rating, got " + r_zero.rating);
    }

    println("probe: boyd e-m mathematical scorecard ok");
    return Ok(0);
}
