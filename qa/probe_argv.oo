// # Ooda Router argv Probe — Rest Slice and Moved Verbs
//
// Logline: Fail closed if main.oo keeps in-process digest/bench/gen or skips rest for cli.
//
// Setup: Reads main.oo. No imports of files that moved to cli.
//
// Beats:
//   1. main.oo must slice rest and call forward_to_cli for language verbs including qa.
//   2. main.oo must not call run_oodac_build or import build/test.oo, build/gen.oo, build/bench.oo.
//   3. digest, bench, and gen must be moved verbs. Those files must be gone.
//   4. suite.oo and ci.yml must not pass --backend c or emit-c.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if !str_contains(src, "list_slice(args, 1, list_len(args))") {
        return Err("main.oo must slice rest from argv[1..]");
    }
    if !str_contains(src, "forward_to_cli") {
        return Err("main.oo must forward language verbs to cli");
    }
    if !str_contains(src, "if sub == \"qa\"") {
        return Err("main.oo must forward qa to cli");
    }
    if str_contains(src, "run_oodac_build") {
        return Err("main.oo must not call run_oodac_build in-process");
    }
    if str_contains(src, "run_ooda_gen") {
        return Err("main.oo must not call run_ooda_gen in-process");
    }
    if str_contains(src, "run_ooda_digest") {
        return Err("main.oo must not call run_ooda_digest in-process");
    }
    if str_contains(src, "import \"build/test.oo\"") {
        return Err("main.oo must not import build/test.oo");
    }
    if str_contains(src, "import \"build/gen.oo\"") {
        return Err("main.oo must not import build/gen.oo");
    }
    if str_contains(src, "import \"build/bench.oo\"") {
        return Err("main.oo must not import build/bench.oo");
    }
    if str_contains(src, "import \"fix/digest.oo\"") {
        return Err("main.oo must not import fix/digest.oo");
    }
    if !str_contains(src, "ooda: digest moved") {
        return Err("digest must be a moved verb");
    }
    if !str_contains(src, "ooda: bench moved") {
        return Err("bench must be a moved verb");
    }
    if !str_contains(src, "ooda: gen moved") {
        return Err("gen must be a moved verb");
    }
    if path_exists(fs_r, "build/test.oo") { return Err("moved file build/test.oo"); }
    if path_exists(fs_r, "build/gen.oo") { return Err("moved file build/gen.oo"); }
    if path_exists(fs_r, "build/bench.oo") { return Err("moved file build/bench.oo"); }
    if path_exists(fs_r, "fix/digest.oo") { return Err("moved file fix/digest.oo"); }
    let sr: Result[String, String] = read_file(fs_r, "qa/suite.oo");
    if sr.is_err() { return Err("unreadable qa/suite.oo"); }
    let suite: String = match sr { Ok(s) => s, Err(_) => "" };
    if str_contains(suite, "--backend") {
        return Err("qa/suite.oo must not pass --backend (LLVM default)");
    }
    if str_contains(suite, "emit-c") {
        return Err("qa/suite.oo must not call emit-c");
    }
    let cr: Result[String, String] = read_file(fs_r, ".github/workflows/ci.yml");
    if cr.is_err() { return Err("unreadable .github/workflows/ci.yml"); }
    let ci: String = match cr { Ok(s) => s, Err(_) => "" };
    if str_contains(ci, "--backend c") {
        return Err("ci.yml must not pass --backend c (LLVM default)");
    }
    if str_contains(ci, "emit-c") {
        return Err("ci.yml must not call emit-c");
    }
    println("probe: argv router rest contract ok");
    return Ok(0);
}
