// # Ooda CLI argv Probe — Hostile Rest Contract
//
// Logline: Fail closed if handlers skip rest[0] or misparse crypto-agile digest arguments.
//
// Setup: Calls the live parse helpers and digest computation. Returns Err on miss.
//
// Beats:
//   1. test/digest/bench: verify argv file and flag extraction.
//   2. digest: verify multi-algo flag parsing and live digest computation.
//   3. gen/context/token: verify kind, name, dir, and subcommand extraction.

import "build/test.oo";
import "build/gen.oo";
import "build/bench.oo";
import "build/context.oo";
import "fix/digest.oo";
import "token/cmd_token.oo";

fn one(a: String) -> List[String] {
    let mut l: List[String] = list_new();
    return list_push(l, a);
}

fn two(a: String, b: String) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, a);
    return list_push(l, b);
}

fn three(a: String, b: String, c: String) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, a);
    l = list_push(l, b);
    return list_push(l, c);
}

fn make_1000_a() -> String {
    let mut s: String = "";
    let mut i: Int = 0;
    while i < 100 {
        s = s + "AAAAAAAAAA";
        i = i + 1;
    }
    return s;
}

fn check_digest(algo: String, text: String, exp: String) -> Result[Int, String] {
    let d: Result[String, String] = compute_digest(algo, text);
    if !d.is_ok() { return Err("compute_digest " + algo + " failed"); }
    let h: String = match d { Ok(s) => s, Err(_) => "" };
    if h != exp {
        return Err(algo + " vector mismatch: got " + h + " exp " + exp);
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if test_argv_file(one("foo.oo")) != "foo.oo" {
        return Err("test rest: foo.oo must be the file");
    }
    if test_argv_file(two("--json", "foo.oo")) != "foo.oo" {
        return Err("test rest: --json foo.oo must be the file");
    }
    if test_argv_file(list_new()) != "" {
        return Err("test rest: empty must miss");
    }
    if digest_argv_file(one("f.oo")) != "f.oo" {
        return Err("digest rest: f.oo must be the file");
    }
    if digest_argv_file(three("--algo", "blake3", "f.oo")) != "f.oo" {
        return Err("digest rest: --algo blake3 f.oo must be f.oo");
    }
    if digest_argv_file(two("--algo=sha512", "f.oo")) != "f.oo" {
        return Err("digest rest: --algo=sha512 f.oo must be f.oo");
    }
    if digest_argv_file(three("f.oo", "--algo", "sha3")) != "f.oo" {
        return Err("digest rest: f.oo --algo sha3 must be f.oo");
    }
    if digest_argv_algo(three("--algo", "blake3", "f.oo")) != "blake3" {
        return Err("digest algo: --algo blake3 f.oo must be blake3");
    }
    if digest_argv_algo(two("--algo=sha512", "f.oo")) != "sha512" {
        return Err("digest algo: --algo=sha512 f.oo must be sha512");
    }
    if digest_argv_algo(three("f.oo", "--algo", "sha3")) != "sha3" {
        return Err("digest algo: f.oo --algo sha3 must be sha3");
    }
    if digest_argv_algo(one("f.oo")) != "sha256" {
        return Err("digest algo: f.oo must be sha256");
    }
    if digest_argv_algo(three("--algo", "md5", "f.oo")) != "INVALID:md5" {
        return Err("digest algo: --algo md5 f.oo must be INVALID:md5");
    }
    let r1: Result[Int, String] = check_digest("sha256", "abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = check_digest("sha3", "abc", "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532");
    if r2.is_err() { return r2; }
    let r3: Result[Int, String] = check_digest("sha512", "abc", "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    if r3.is_err() { return r3; }
    let r4: Result[Int, String] = check_digest("blake3", "abc", "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85");
    if r4.is_err() { return r4; }

    let s_1000: String = make_1000_a();
    if bytes_len(s_1000) != 1000 { return Err("s_1000 len must be 1000"); }
    let r5: Result[Int, String] = check_digest("sha256", s_1000, "c2e686823489ced2017f6059b8b239318b6364f6dcd835d0a519105a1eadd6e4");
    if r5.is_err() { return r5; }
    let r6: Result[Int, String] = check_digest("sha3", s_1000, "9a0ad8e2b4dd2bba189511f7759bcff54e3455046303d3cf86cb0c1747224936");
    if r6.is_err() { return r6; }
    let r7: Result[Int, String] = check_digest("sha512", s_1000, "329c52ac62d1fe731151f2b895a00475445ef74f50b979c6f7bb7cae349328c1d4cb4f7261a0ab43f936a24b000651d4a824fcdd577f211aef8f806b16afe8af");
    if r7.is_err() { return r7; }
    let r8: Result[Int, String] = check_digest("blake3", s_1000, "f92ea1aabb86c16c96c1963ef472d3ecce3ff1d688c020069c18e1fd4cba81e9");
    if r8.is_err() { return r8; }

    let s_utf8: String = "Hello, 世界! 🚀 — openOODA";
    if bytes_len(s_utf8) != 32 { return Err("s_utf8 bytes_len must be 32"); }
    let r9: Result[Int, String] = check_digest("sha256", s_utf8, "8efe418192099662a39d02a2e7978a9f8542cfbbcce3aaee5338c3768c1c2de9");
    if r9.is_err() { return r9; }
    let r10: Result[Int, String] = check_digest("sha3", s_utf8, "28b8d78b687570cb8ef0b87c0c91073638fef8a73de7cbec34898c93697f6ec4");
    if r10.is_err() { return r10; }
    let r11: Result[Int, String] = check_digest("sha512", s_utf8, "d2165c02ecf8f51c6a0828e7da34d03fd041141d9a0aafafb95cb91656379739ab3c59ab9ff58a3aa24f5466b6d09f522c22b6df704b87fa0d363f678a18a679");
    if r11.is_err() { return r11; }
    let r12: Result[Int, String] = check_digest("blake3", s_utf8, "dd5e8e22a22cfd290f05b087069a2803f80802d0883d5ab1908dd1be5e40caef");
    if r12.is_err() { return r12; }

    let tmp_file: String = ".ooda-cache/probe_utf8.txt";
    let wr: Result[Void, String] = write_file(fs_w, tmp_file, s_utf8);
    if wr.is_err() { return Err("write_file tmp_file failed"); }
    let tr: Result[String, String] = read_file(fs_r, tmp_file);
    if tr.is_err() { return Err("read_file tmp_file failed"); }
    let s_read: String = match tr { Ok(s) => s, Err(_) => "" };
    let rf_b3: Result[Int, String] = check_digest("blake3", s_read, "dd5e8e22a22cfd290f05b087069a2803f80802d0883d5ab1908dd1be5e40caef");
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_file);
    if rf_b3.is_err() { return rf_b3; }
    if bench_argv_file(one("f.oo")) != "f.oo" {
        return Err("bench rest: f.oo must be the file");
    }
    if gen_argv_kind(two("module", "User")) != "module" {
        return Err("gen rest: kind must be module");
    }
    if gen_argv_name(two("module", "User")) != "User" {
        return Err("gen rest: name must be User");
    }
    if gen_argv_name(one("module")) != "" {
        return Err("gen rest: missing name must be empty");
    }
    if context_argv_dir(one("src")) != "src" {
        return Err("context rest: src must be the dir");
    }
    if token_argv_sub(one("status")) != "status" {
        return Err("token rest: status must be the subcommand");
    }
    if token_argv_sub(list_new()) != "" {
        return Err("token rest: empty must miss");
    }
    println("probe: argv rest contract ok");
    return Ok(0);
}
