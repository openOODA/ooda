// # Ooda CLI update Probe — Hostile Flag and Installer Contracts
//
// Logline: Fail closed if update mangles flags or trusts an unsafe installer.
// Setup: Calls the live parse helpers in build/update.oo. Pure compute. No exec. No network.
// Beats:
//   1. Empty args must be clean and select the canonical URL source.
//   2. Known flags must parse; unknown flags and positionals must Err.
//   3. --installer space and = forms must return the path; bare must Err.
//   4. Hostile installer paths (.., quotes, expansion, metachars) must Err.

import "build/update.oo";

fn one(a: String) -> List[String] {
    let mut l: List[String] = list_new();
    return list_push(l, a);
}

fn two(a: String, b: String) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, a);
    return list_push(l, b);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if update_canonical_url() != "https://openooda.org/install.sh" {
        return Err("canonical URL must be https://openooda.org/install.sh");
    }
    if update_argv_error(list_new()) != "" {
        return Err("empty update args must be clean");
    }
    if update_argv_installer(list_new()) != "" {
        return Err("empty update args must select no local installer");
    }
    if update_passthrough(list_new()) != "" {
        return Err("empty update args must pass no flags");
    }
    let mut flags: List[String] = list_new();
    flags = list_push(flags, "--dry-run");
    flags = list_push(flags, "--yes");
    flags = list_push(flags, "--no-modify-shell");
    if update_argv_error(flags) != "" {
        return Err("known update flags must be clean");
    }
    if !update_has_flag(flags, "--dry-run") {
        return Err("update --dry-run must be seen");
    }
    if !update_has_flag(flags, "--yes") {
        return Err("update --yes must be seen");
    }
    if update_has_flag(list_new(), "--yes") {
        return Err("empty args must not see --yes");
    }
    if update_has_flag(one("--YES"), "--yes") {
        return Err("update flags must be case sensitive");
    }
    let pt: String = update_passthrough(flags);
    if str_index_of(pt, "--dry-run") < 0 {
        return Err("passthrough must carry --dry-run");
    }
    if str_index_of(pt, "--yes") < 0 {
        return Err("passthrough must carry --yes");
    }
    if str_index_of(pt, "--no-modify-shell") < 0 {
        return Err("passthrough must carry --no-modify-shell");
    }
    if update_argv_installer(two("--installer", "/tmp/i.sh")) != "/tmp/i.sh" {
        return Err("space form must return the path");
    }
    if update_argv_installer(one("--installer=/tmp/i.sh")) != "/tmp/i.sh" {
        return Err("= form must return the path");
    }
    if update_argv_error(one("--installer")) == "" {
        return Err("bare --installer must Err");
    }
    if update_argv_error(one("--installer=")) == "" {
        return Err("empty --installer= must Err");
    }
    if update_argv_error(one("--bogus")) == "" {
        return Err("unknown update flag must Err");
    }
    if update_argv_error(one("oops")) == "" {
        return Err("positional update arg must Err");
    }
    if update_installer_unsafe("") == "" {
        return Err("empty installer path must be unsafe");
    }
    if update_installer_unsafe("../evil.sh") == "" {
        return Err(".. installer path must be unsafe");
    }
    if update_installer_unsafe("/tmp/a'b.sh") == "" {
        return Err("quoted installer path must be unsafe");
    }
    if update_installer_unsafe("/tmp/$X.sh") == "" {
        return Err("expansion installer path must be unsafe");
    }
    if update_installer_unsafe("/tmp/a;b.sh") == "" {
        return Err("metachar installer path must be unsafe");
    }
    if update_installer_unsafe("~/i.sh") == "" {
        return Err("tilde installer path must be unsafe");
    }
    if update_installer_unsafe("/tmp/i.sh") != "" {
        return Err("plain installer path must be safe");
    }
    let script0: String = update_fetch_script(list_new());
    if str_index_of(script0, "pipefail") < 0 {
        return Err("fetch script must set pipefail");
    }
    if str_index_of(script0, "curl -fsSL") < 0 {
        return Err("fetch script must curl -fsSL");
    }
    if str_index_of(script0, update_canonical_url()) < 0 {
        return Err("fetch script must use the canonical URL");
    }
    // New: post-Plan-v25 contracts — DNS pre-check, temp-file download,
    // mirror fallback, --installer escape-hatch mention, no broken pipe.
    if str_index_of(script0, "getent hosts openooda.org") < 0 {
        return Err("fetch script must pre-check DNS for openooda.org via getent");
    }
    if str_index_of(script0, "mktemp") < 0 {
        return Err("fetch script must download to a temp file (mktemp), not pipe-to-bash");
    }
    if str_index_of(script0, "trap 'rm -f \"$TMP\"' EXIT") < 0 {
        return Err("fetch script must trap EXIT to clean up the temp file");
    }
    if str_index_of(script0, "--connect-timeout 10") < 0 {
        return Err("fetch script must set a 10s connect timeout on curl");
    }
    if str_index_of(script0, "exec bash") < 0 {
        return Err("fetch script must exec the downloaded file (not invoke bash separately)");
    }
    if str_index_of(script0, update_mirror_url()) < 0 {
        return Err("fetch script must call update_mirror_url for fallback");
    }
    if str_index_of(script0, "raw.githubusercontent.com") < 0 {
        return Err("fetch script must reference the GitHub raw mirror URL");
    }
    if str_index_of(script0, "ooda update --installer") < 0 {
        return Err("fetch script must mention --installer as the escape hatch");
    }
    // Anti-regression: the old broken `curl | bash -s --` pattern must
    // be gone. Allow only inside comments (preceded by //).
    let pipe_pos: Int = str_index_of(script0, "| bash -s --");
    if pipe_pos >= 0 {
        // Check the line containing the pipe — if it's a comment, OK.
        let mut line_start: Int = 0;
        let mut i: Int = 0;
        while i < pipe_pos {
            if str_slice(script0, i, i + 1) == "\n" { line_start = i + 1; }
            i = i + 1;
        }
        let line: String = str_slice(script0, line_start, chars_len(script0));
        if str_index_of(line, "//") < 0 {
            return Err("fetch script must not contain the broken '| bash -s --' pattern (was: " + line + ")");
        }
    }
    let script1: String = update_fetch_script(flags);
    if str_index_of(script1, "--dry-run") < 0 {
        return Err("fetch script must carry passthrough flags");
    }
    if str_index_of(script1, "ooda update --installer") < 0 {
        return Err("fetch script (with passthrough flags) must still mention --installer");
    }
    // New: update_mirror_url is defined and returns the GitHub raw URL.
    let mirror: String = update_mirror_url();
    if mirror != "https://raw.githubusercontent.com/openOODA/install/main/install.sh" {
        return Err("mirror URL must be the GitHub raw install script");
    }
    println("probe: update flag and installer contracts ok");
    return Ok(0);
}
