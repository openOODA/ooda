// # Ooda Router update Probe — Update Forwards to cli
//
// Logline: Fail closed if update still lives in-process or help omits the cli forward.
//
// Setup: FsReadCap. Reads main.oo. Does not import build/update.oo (moved to cli).
//
// Beats:
//   1. build/update.oo must be gone.
//   2. main.oo must forward update and upgrade through forward_to_cli.
//   3. router_help must list update and upgrade among language verbs.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    if path_exists(fs_r, "build/update.oo") { return Err("moved file build/update.oo"); }
    let rr: Result[String, String] = read_file(fs_r, "main.oo");
    if rr.is_err() { return Err("unreadable main.oo"); }
    let src: String = match rr { Ok(s) => s, Err(_) => "" };
    if str_contains(src, "import \"build/update.oo\"") {
        return Err("main.oo must not import build/update.oo");
    }
    if str_contains(src, "run_ooda_update") {
        return Err("main.oo must not call run_ooda_update in-process");
    }
    if !str_contains(src, "if sub == \"update\" || sub == \"upgrade\"") {
        return Err("main.oo must forward update and upgrade to cli");
    }
    if !str_contains(src, "forward_to_cli") {
        return Err("main.oo must call forward_to_cli");
    }
    if !str_contains(src, "install, update, upgrade, init, qa") {
        return Err("router_help must list update and upgrade as language CLI verbs");
    }
    println("probe: update forwards to cli");
    return Ok(0);
}
