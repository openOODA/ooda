// # Ooda Router Binary Parity Probe
//
// Logline: Verify the installed ooda binary matches dist and the router help/version/moved surface.
//
// Setup: ProcessCap, FsReadCap, EnvCap. Spawns ~/.openooda/bin/ooda. No in-process digest/bench/gen.
//
// Beats:
//   1. Resolve the user binary and an optional dist artifact.
//   2. SHA-256 parity via sha256sum (not ooda digest).
//   3. version and help exit 0 with router text.
//   4. Moved verbs (digest, bench, gen, health, eval, repl, sandbox, swarm) exit 2.
//   5. Unknown subcommand exits 2.

import "std/fs/process/env.oo";

fn one(a: String) -> List[String] {
    let mut l: List[String] = list_new();
    return list_push(l, a);
}

fn exec_code(p: &ProcessCap, bin: String, argv: List[String]) -> Int {
    let r: Result[Int, String] = sys_exec_wait(p, bin, argv);
    return r.val;
}

fn assert_exit(p: &ProcessCap, bin: String, args: List[String], exp: Int, tag: String) -> Result[Int, String] {
    let code: Int = exec_code(p, bin, args);
    if code != exp {
        return Err("exit " + tag + ": expected " + exp.to_string() + ", got " + code.to_string());
    }
    return Ok(0);
}

fn first_field(s: String) -> String {
    let t: String = str_trim(s);
    let n: Int = chars_len(t);
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(t, i, i + 1);
        if c == " " || c == "\t" { return str_slice(t, 0, i); }
        i = i + 1;
    }
    return t;
}

fn sha_hex(p: &ProcessCap, path: String) -> Result[String, String] {
    let r: Result[String, String] = sys_exec(p, "sha256sum", path);
    if r.is_err() { return Err("sha256sum failed for " + path); }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let h: String = first_field(raw);
    if chars_len(h) != 64 { return Err("sha256sum output malformed: " + raw); }
    return Ok(h);
}

fn env_or_empty(env: &EnvCap, key: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    return match r { Ok(s) => s, Err(_) => "" };
}

fn bin_if_exists(fs_r: &FsReadCap, root: String) -> String {
    if root == "" { return ""; }
    let p: String = root + "/.openooda/bin/ooda";
    if path_exists(fs_r, p) { return p; }
    let p2: String = root + "/bin/ooda";
    if path_exists(fs_r, p2) { return p2; }
    return "";
}

fn resolve_bin(env: &EnvCap, fs_r: &FsReadCap) -> String {
    let a: String = bin_if_exists(fs_r, env_or_empty(env, "HOME"));
    if a != "" { return a; }
    let b: String = bin_if_exists(fs_r, env_or_empty(env, "OO_HOME"));
    if b != "" { return b; }
    return bin_if_exists(fs_r, env_or_empty(env, "OODA_HOME"));
}

fn dist_path(fs_r: &FsReadCap) -> String {
    if path_exists(fs_r, "dist/ooda") { return "dist/ooda"; }
    if path_exists(fs_r, "ooda/dist/ooda") { return "ooda/dist/ooda"; }
    if path_exists(fs_r, "dist/ooda-linux-x86_64") { return "dist/ooda-linux-x86_64"; }
    if path_exists(fs_r, "ooda/dist/ooda-linux-x86_64") { return "ooda/dist/ooda-linux-x86_64"; }
    return "";
}

fn check_parity(p: &ProcessCap, bin_path: String, dist: String) -> Result[Int, String] {
    if dist == "" { return Ok(0); }
    let hd1_res: Result[String, String] = sha_hex(p, bin_path);
    let hd2_res: Result[String, String] = sha_hex(p, dist);
    if hd1_res.is_err() || hd2_res.is_err() {
        return Err("Binary parity sha256sum failed");
    }
    let hd1: String = match hd1_res { Ok(s) => s, Err(_) => "" };
    let hd2: String = match hd2_res { Ok(s) => s, Err(_) => "" };
    if hd1 != hd2 {
        return Err("parity mismatch: " + bin_path + " != " + dist);
    }
    println("parity: " + bin_path + " == " + dist + " (" + hd1 + ")");
    return Ok(0);
}

fn out_or_err(r: Result[String, String]) -> String {
    if r.is_ok() {
        return match r { Ok(okv) => okv, Err(_) => "" };
    }
    return match r { Ok(_) => "", Err(errv) => errv };
}

fn check_help_version(p: &ProcessCap, bin: String) -> Result[Int, String] {
    let mut r: Result[Int, String] = assert_exit(p, bin, one("version"), 0, "version");
    if r.is_err() { return r; }
    let v_out: String = out_or_err(sys_exec(p, bin, "version"));
    if !str_contains(v_out, "ooda") || !str_contains(v_out, "router") {
        return Err("version stdout violation: " + v_out);
    }
    r = assert_exit(p, bin, one("help"), 0, "help");
    if r.is_err() { return r; }
    let h_out: String = out_or_err(sys_exec(p, bin, "help"));
    if !str_contains(h_out, "usage: ooda") {
        return Err("help stdout violation: " + h_out);
    }
    if !str_contains(h_out, "cli <sub>") {
        return Err("help missing language CLI forward: " + h_out);
    }
    return Ok(0);
}

fn check_moved(p: &ProcessCap, bin: String) -> Result[Int, String] {
    let mut r: Result[Int, String] = assert_exit(p, bin, one("digest"), 2, "digest");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("bench"), 2, "bench");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("gen"), 2, "gen");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("health"), 2, "health");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("eval"), 2, "eval");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("repl"), 2, "repl");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("sandbox"), 2, "sandbox");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("swarm"), 2, "swarm");
    if r.is_err() { return r; }
    r = assert_exit(p, bin, one("--bogus"), 2, "bogus");
    if r.is_err() { return r; }
    return Ok(0);
}

pub fn main(
    p: &ProcessCap,
    fs_r: &FsReadCap,
    sys: &SysCap,
    env: &EnvCap,
    time: &TimeCap,
    fs_w: &FsWriteCap,
    alloc: &AllocCap,
    args: List[String]
) -> Result[Int, String] {
    let bin_path: String = resolve_bin(env, fs_r);
    if bin_path == "" {
        println("ERR user binary not installed at ~/.openooda/bin/ooda");
        return Err("user binary not installed at ~/.openooda/bin/ooda");
    }
    let pr: Result[Int, String] = check_parity(p, bin_path, dist_path(fs_r));
    if pr.is_err() { return pr; }
    let hv: Result[Int, String] = check_help_version(p, bin_path);
    if hv.is_err() { return hv; }
    let mv: Result[Int, String] = check_moved(p, bin_path);
    if mv.is_err() { return mv; }
    println("probe: binary parity and router surface ok");
    return Ok(0);
}
