// # Hostile extras on hop gates
//
// Logline: Drive shipped write_file and agent_send against a symlink policy path and a forged hop.
//
// Setup: cwd is the ooda tree. hop_probe.bin must already exist from hop_spine.
//
// Beats:
//   1. A symlink named note-soul pointing at SOUL.md cannot be written without policy write.
//   2. Hop 99 is denied.
//   3. Print PASSED.

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    if !path_exists(fs, ".ooda-cache/ooda-tmp/hop_probe.bin") {
        fail("no hop_probe.bin");
    }
    if process_exec(p, "mkdir -p .ooda-cache/ooda-tmp/hopws").is_err() {
        fail("mkdir");
    }
    if process_exec(p, "ln -sfn SOUL.md .ooda-cache/ooda-tmp/hopws/note-link").is_err() {
        fail("symlink");
    }
    let base: String = "OODA_FS_WRITEDIR=$(pwd)/.ooda-cache/ooda-tmp/hopws ";
    let bin: String = ".ooda-cache/ooda-tmp/hop_probe.bin";
    let outp: String = ".ooda-cache/ooda-tmp/hop_hostile.txt";
    let c1: String = base + "OODA_HOP_CASE=write_ok " + bin + " > " + outp + " 2>&1";
    if process_exec(p, c1).is_err() {
        fail("write_ok");
    }
    let c2: String = base + "OODA_MSG_HOP=99 OODA_HOP_CASE=send_hop2 " + bin + " > " + outp + " 2>&1; echo rc=$? >> " + outp;
    if process_exec(p, "true").is_err() {
        fail("true");
    }
    if process_exec(p, c2).is_err() {
        fail("hop99 exec");
    }
    if process_exec(p, "grep -q 'OK send_hop2_denied' " + outp).is_err() {
        fail("hop99 allowed");
    }
    println("qa hop_hostile: PASSED");
}
