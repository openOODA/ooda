// # Ooda CLI spawn Probe — No PATH Fallback
//
// Logline: Fail closed if spawn forms a PATH name or accepts an empty OODACODEX.
//
// Setup: Calls spawn_codex_bin. Pure compute. No exec.
//
// Beats:
//   1. Empty codex must Err.
//   2. Traversal and slash in the name must Err.
//   3. A set codex must form $codex/bin/<name> and never the bare name.

import "build/spawn.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
    let e1: Result[String, String] = spawn_codex_bin("", "opm");
    if e1.is_ok() { return Err("empty OODACODEX must fail"); }
    let e2: Result[String, String] = spawn_codex_bin("/x", "../opm");
    if e2.is_ok() { return Err("traversal spawn name must fail"); }
    let e3: Result[String, String] = spawn_codex_bin("/x", "opm/bin");
    if e3.is_ok() { return Err("slash spawn name must fail"); }
    let e4: Result[String, String] = spawn_codex_bin("/x", "");
    if e4.is_ok() { return Err("empty spawn name must fail"); }
    let ok: Result[String, String] = spawn_codex_bin("/opt/codex", "opm");
    if ok.is_err() { return Err("set OODACODEX must form a bin path"); }
    let path: String = match ok { Ok(s) => s, Err(_) => "" };
    if path != "/opt/codex/bin/opm" {
        return Err("spawn path must be $OODACODEX/bin/<name>");
    }
    if path == "opm" { return Err("spawn must not use PATH"); }
    println("probe: spawn OODACODEX only ok");
    return Ok(0);
}
