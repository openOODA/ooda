(* Product grammar vs residual.
   Residual productions are tagged RESIDUAL and are not what `oodac check` accepts.
   OPEN-13: this file must not claim traits or :: imports as product. *)

Program           ::= { Item } ;
Item              ::= FunctionDecl | TypeDecl | ImportDecl ;

(* ------------------------------------------------------------------- *)
(* Declarations (product)                                              *)
(* ------------------------------------------------------------------- *)

ImportDecl        ::= "import" StringLiteral ";" ;

TypeDecl          ::= "type" Identifier "=" ( SumType | StructType ) ";" ;
SumType           ::= Variant { "|" Variant } ;
Variant           ::= Identifier [ "(" Type ")" ] ;
StructType        ::= "struct" "{" { FieldDecl } "}" ;
FieldDecl         ::= Identifier ":" Type [ "," ] ;

FunctionDecl      ::= [ "pub" ] "fn" Identifier "(" [ ParameterList ] ")" [ "->" Type ]
                      [ ContractSpec ]
                      Block
                      [ VerifyBlock ] ;

ParameterList     ::= Parameter { "," Parameter } ;
Parameter         ::= Identifier ":" [ "&" ] Type ;

ContractSpec      ::= { Precondition | Postcondition } ;
Precondition      ::= "requires" Expression ;
Postcondition     ::= "ensures" Expression ;

VerifyBlock       ::= "verify" Identifier "{" { Statement } "}" ;

(* ------------------------------------------------------------------- *)
(* Types                                                               *)
(* ------------------------------------------------------------------- *)

Type              ::= PrimitiveType | CustomType | OptionType | ResultType | CapabilityType ;
PrimitiveType     ::= "Int" | "Float" | "f64" | "String" | "Bool" | "Void" ;
CustomType        ::= Identifier ;
OptionType        ::= "Option" [ "[" Type "]" ] ;
ResultType        ::= "Result" "[" Type "," Type "]" ;
CapabilityType    ::= "NetCap" | "FsCap" | "FsReadCap" | "FsWriteCap" | "EnvCap" | "SysCap"
                    | "HttpCap" | "TcpCap" | "UdpCap" | "BindCap" | "TimeCap" | "RandCap"
                    | "AllocCap" | "ProcessCap" ;

(* ------------------------------------------------------------------- *)
(* Statements & Control Flow                                           *)
(* ------------------------------------------------------------------- *)

Block             ::= "{" { Statement } [ Expression ] "}" ;
Statement         ::= LetStmt | ReturnStmt | ExprStmt | WhileStmt | AssignStmt ;

LetStmt           ::= "let" [ "mut" ] Identifier [ ":" Type ] "=" Expression ";" ;
ReturnStmt        ::= "return" [ Expression ] ";" ;
ExprStmt          ::= Expression ";" ;
WhileStmt         ::= "while" Expression Block ;
AssignStmt        ::= Identifier "=" Expression ";" ;

(* ------------------------------------------------------------------- *)
(* Expressions                                                         *)
(* ------------------------------------------------------------------- *)

Expression        ::= IfExpr | MatchExpr | BinaryExpr | CallExpr | PrimaryExpr ;

IfExpr            ::= "if" Expression Block [ "else" ( Block | IfExpr ) ] ;
MatchExpr         ::= "match" Expression "{" { MatchArm } "}" ;
MatchArm          ::= Pattern "=>" ( Expression "," | Block ) ;
Pattern           ::= "Ok" "(" Identifier ")" | "Err" "(" Identifier ")"
                    | "Some" "(" Identifier ")" | "None" | Identifier [ "(" Identifier ")" ]
                    | Literal | "_" ;

BinaryExpr        ::= PrimaryExpr BinaryOp Expression ;
BinaryOp          ::= "+" | "-" | "*" | "/" | "%"
                    | "==" | "!=" | "<" | "<=" | ">" | ">="
                    | "&&" | "||"
                    | "&" | "|" | "^" | "<<" | ">>" ;

CallExpr          ::= PrimaryExpr "(" [ ArgList ] ")" [ "?" ] ;
ArgList           ::= Expression { "," Expression } ;

PrimaryExpr       ::= Literal | Identifier | ParenExpr ;
ParenExpr         ::= "(" Expression ")" ;

Literal           ::= IntLiteral | FloatLiteral | StringLiteral | BoolLiteral ;
IntLiteral        ::= [ "-" ] Digit { Digit } ;
FloatLiteral      ::= [ "-" ] Digit { Digit } "." Digit { Digit } ;
StringLiteral     ::= '"' { Character } '"' ;
BoolLiteral       ::= "true" | "false" ;

Identifier        ::= Letter { Letter | Digit | "_" } ;
Letter            ::= "a".."z" | "A".."Z" ;
Digit             ::= "0".."9" ;

(* ------------------------------------------------------------------- *)
(* RESIDUAL — named so check and this file stay honest. Not product.   *)
(* ------------------------------------------------------------------- *)

(* RESIDUAL TraitDecl *)
TraitDecl         ::= "trait" Identifier "{" { FunctionDecl } "}" ;
(* RESIDUAL import Identifier::Identifier *)
ImportPathDecl    ::= "import" Identifier "::" Identifier ";" ;
(* RESIDUAL RefinementType where *)
RefinementType    ::= Type "where" Expression ;
(* RESIDUAL Newtype *)
Newtype           ::= "newtype" Type ;
(* RESIDUAL SpecClause *)
SpecClause        ::= "spec" StringLiteral ;
(* RESIDUAL PrimitiveType u64 | i32 *)
ResidualIntType   ::= "u64" | "i32" ;
(* RESIDUAL range ops .. ..= *)
ResidualRangeOp   ::= ".." | "..=" ;
