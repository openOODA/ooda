// # Product prove std/protein_folding/cg_elastic_network_anm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/protein_folding/cg_elastic_network_anm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_elastic_network_anm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cg_elastic_network_anm: PASSED only if they match.

import "std/protein_folding/cg_elastic_network_anm.oo";

pub fn main() {
    let cg_elastic_network_anm_a = anm_calc_fluctuation(0.0, 0.0);
    let cg_elastic_network_anm_b = anm_calc_fluctuation(0.0, 0.0);
    if cg_elastic_network_anm_a != cg_elastic_network_anm_b {
        println("FAIL cg_elastic_network_anm");
        process_exit(1);
    }
    println("prod_ap_cg_elastic_network_anm: PASSED");
}
