// # Product prove std/enterprise/rbac.oo
//
// Logline: Fail-closed emit+gcc+run asserts rbac_engine_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/rbac.oo.
//
// Beats:
//   1. Call rbac_engine_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rbac: PASSED only if they match.

import "std/enterprise/rbac.oo";

pub fn main() {
    let a: RbacEngine = rbac_engine_init();
    let b: RbacEngine = rbac_engine_init();
    if (a).eval_count != (b).eval_count {
        println("FAIL rbac_engine_init");
        process_exit(1);
    }
    println("prod_g2_rbac: PASSED");
}
