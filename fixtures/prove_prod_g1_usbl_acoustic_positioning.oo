// # Product prove std/robotics_auv/usbl_acoustic_positioning.oo
//
// Logline: Fail-closed emit+gcc+run asserts usbl_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/usbl_acoustic_positioning.oo.
//
// Beats:
//   1. Call usbl_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_usbl_acoustic_positioning: PASSED only if they match.

import "std/robotics_auv/usbl_acoustic_positioning.oo";

pub fn main() {
    let a: UsblTransceiverConfig = usbl_config_default();
    let b: UsblTransceiverConfig = usbl_config_default();
    if a.carrier_frequency_hz != b.carrier_frequency_hz {
        println("FAIL usbl_config_default");
        process_exit(1);
    }
    println("prod_usbl_acoustic_positioning: PASSED");
}
