// # Product prove std/tda_topology/persistence_entropy_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistent_entropy_get_normalized is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_entropy_calc.oo.
//
// Beats:
//   1. Call persistent_entropy_get_normalized twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistence_entropy_calc: PASSED only if they match.

import "std/tda_topology/persistence_entropy_calc.oo";

pub fn main() {
    let persistence_entropy_calc_mark: Int = 0;
    if persistence_entropy_calc_mark != 0 {
        process_exit(1);
    }
    let persistence_entropy_calc_obj: PersistentEntropy = persistent_entropy_new();
    let persistence_entropy_calc_a: Float = persistent_entropy_get_normalized(&persistence_entropy_calc_obj);
    let persistence_entropy_calc_b: Float = persistent_entropy_get_normalized(&persistence_entropy_calc_obj);
    if persistence_entropy_calc_a != persistence_entropy_calc_b {
        println("FAIL persistent_entropy_get_normalized");
        process_exit(1);
    }
    println("prod_persistence_entropy_calc: PASSED");
}
