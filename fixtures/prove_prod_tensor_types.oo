// # Product prove std/ai_ml/tensor_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts tensor_types_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_types.oo.
//
// Beats:
//   1. Call tensor_types_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensor_types: PASSED only if they match.

import "std/ai_ml/tensor_types.oo";

pub fn main() {
    let a = tensor_types_marker();
    let b = tensor_types_marker();
    if a != b {
        println("FAIL tensor_types_marker");
        process_exit(1);
    }
    println("prod_tensor_types: PASSED");
}
