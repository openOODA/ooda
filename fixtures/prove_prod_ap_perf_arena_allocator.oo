// # Product prove std/perf/arena_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/arena_allocator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/arena_allocator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_arena_allocator: PASSED only if they match.

import "std/perf/arena_allocator.oo";

pub fn main() {
    let arena_allocator_a = bump_arena_create("x", 0);
    let arena_allocator_b = bump_arena_create("x", 0);
    let arena_allocator_va = bump_arena_used(arena_allocator_a);
    let arena_allocator_vb = bump_arena_used(arena_allocator_b);
    if arena_allocator_va != arena_allocator_vb {
        println("FAIL arena_allocator");
        process_exit(1);
    }
    println("prod_ap_arena_allocator: PASSED");
}
