// # Product prove std/fintech_l3_book/l3_market_order_sweep_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts sweep_order_intent_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_market_order_sweep_engine.oo.
//
// Beats:
//   1. Call sweep_order_intent_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_market_order_sweep_engine: PASSED only if they match.

import "std/fintech_l3_book/l3_market_order_sweep_engine.oo";

pub fn main() {
    let l3_market_order_sweep_engine_mark: Int = 0;
    if l3_market_order_sweep_engine_mark != 0 {
        process_exit(1);
    }
    let a: SweepOrderIntent = sweep_order_intent_new(0, "x", 0, 0, "x", 0);
    let b: SweepOrderIntent = sweep_order_intent_new(0, "x", 0, 0, "x", 0);
    if (a).taker_order_id != (b).taker_order_id {
        println("FAIL sweep_order_intent_new");
        process_exit(1);
    }
    println("prod_l3_market_order_sweep_engine: PASSED");
}
