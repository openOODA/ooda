// # Hostile IDENT eleventh println
//
// Logline: Print ten strings then IDENT x so emit-wasm must miss an eleven-string fold.
//
// Setup: One public main. Eleventh print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-j, then x.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println("line-g");
    println("line-h");
    println("line-i");
    println("line-j");
    println(x);
}
