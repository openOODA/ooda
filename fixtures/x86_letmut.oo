// # emit-x86 same-fn let-mut string print
//
// Logline: Bind mut s to hi and print s so emit-x86 can lower a same-fn let-mut string.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. Bind mut s to the hi string.
//   3. Print s.
//
// residual: mutation after bind stays later.

pub fn main() {
    let mut s = "hi";
    println(s);
}
