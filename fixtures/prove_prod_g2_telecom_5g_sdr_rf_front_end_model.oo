// # Product prove std/telecom_5g/sdr_rf_front_end_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_rf_friis_cascaded_noise_factor is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sdr_rf_front_end_model.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sdr_rf_friis_cascaded_noise_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sdr_rf_front_end_model: PASSED only if they match.

import "std/telecom_5g/sdr_rf_front_end_model.oo";

pub fn main() {
    let g2_a = sdr_rf_friis_cascaded_noise_factor(1.0, 1.0, 1.0);
    let g2_b = sdr_rf_friis_cascaded_noise_factor(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL sdr_rf_friis_cascaded_noise_factor");
        process_exit(1);
    }
    println("prod_g2_sdr_rf_front_end_model: PASSED");
}
