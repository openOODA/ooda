// # Product prove std/simd/simd_shuffle.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_shuffle_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/simd/simd_shuffle.oo.
//
// Beats:
//   1. Call simd_shuffle_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_simd_shuffle: PASSED only if it matches.

import "std/simd/simd_shuffle.oo";

pub fn main() {
    let a: Int = simd_shuffle_probe();
    if a != 0 {
        println("FAIL simd_shuffle_probe");
        process_exit(1);
    }
    println("prod_nc_simd_shuffle: PASSED");
}
