// # Product prove std/auto/fusion_track.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/fusion_track.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_track.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fusion_track: PASSED only if they match.

import "std/auto/fusion_track.oo";

pub fn main() {
    let fusion_track_a = fus_trk_new(0, 0);
    let fusion_track_b = fus_trk_new(0, 0);
    let fusion_track_va = fus_trk_hits(fusion_track_a);
    let fusion_track_vb = fus_trk_hits(fusion_track_b);
    if fusion_track_va != fusion_track_vb {
        println("FAIL fusion_track");
        process_exit(1);
    }
    println("prod_ap_fusion_track: PASSED");
}
