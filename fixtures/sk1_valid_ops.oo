// # Valid lit ops must stay OK
//
// Logline: Int plus, Bool and, and String plus must still typecheck.
//
// Setup: Isolated check. Every bind is printed so unused-let cannot fire.
//
// Beats:
//   1. Bind 1 + 2.
//   2. Bind true && false.
//   3. Bind "a" + "b" and print all three.

pub fn main() {
    let x = 1 + 2;
    let b = true && false;
    let s = "a" + "b";
    println(x);
    println(b);
    println(s);
}
