// # Product prove std/astrodynamics/launch_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts launch_az_deg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/launch_trajectory.oo.
//
// Beats:
//   1. Call launch_az_deg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_trajectory: PASSED only if they match.

import "std/astrodynamics/launch_trajectory.oo";

pub fn main() {
    let launch_trajectory_mark: Int = 0;
    if launch_trajectory_mark != 0 {
        process_exit(1);
    }
    let a: Int = launch_az_deg();
    let b: Int = launch_az_deg();
    if a != b {
        println("FAIL launch_az_deg");
        process_exit(1);
    }
    println("prod_launch_trajectory: PASSED");
}
