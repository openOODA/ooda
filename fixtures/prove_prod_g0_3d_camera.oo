// # Product prove std/3d/camera.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_get_position_z is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/camera.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call camera_get_position_z twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_camera: PASSED only if they match.

import "std/3d/camera.oo";

pub fn main() {
    let g0_oa: Camera = Camera { fov: 2, near_plane: 2, far_plane: 2, aspect_ratio: 2, x: 2, y: 2, z: 2, pitch: 2, yaw: 2, roll: 2 };
    let g0_ob: Camera = Camera { fov: 2, near_plane: 2, far_plane: 2, aspect_ratio: 2, x: 2, y: 2, z: 2, pitch: 2, yaw: 2, roll: 2 };
    let g0_a = camera_get_position_z(g0_oa);
    let g0_b = camera_get_position_z(g0_ob);
    if g0_a != g0_b {
        println("FAIL camera_get_position_z");
        process_exit(1);
    }
    println("prod_g0_camera: PASSED");
}
