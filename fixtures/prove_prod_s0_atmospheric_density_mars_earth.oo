// # Product prove std/space_propulsion/atmospheric_density_mars_earth.oo
//
// Logline: Fail-closed emit+gcc+run asserts atmosphere_earth_us76 value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/atmospheric_density_mars_earth.oo.
//
// Beats:
//   1. Call atmosphere_earth_us76 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_atmospheric_density_mars_earth: PASSED only if asserts hold.

import "std/space_propulsion/atmospheric_density_mars_earth.oo";

pub fn main() {
    let atmospheric_density_mars_earth_a: AtmosphereState = atmosphere_earth_us76(1.0);
    let atmospheric_density_mars_earth_b: AtmosphereState = atmosphere_earth_us76(1.0);
    if atmospheric_density_mars_earth_a.altitude_m != atmospheric_density_mars_earth_b.altitude_m {
        println("FAIL atmosphere_earth_us76");
        process_exit(1);
    }
    println("prod_atmospheric_density_mars_earth: PASSED");
}
