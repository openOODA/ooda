// # Product prove std/simd/simd_quat.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_quat_norm_sq is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_quat.oo.
//
// Beats:
//   1. Call simd_quat_norm_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_quat: PASSED only if they match.

import "std/simd/simd_quat.oo";

pub fn main() {
    let obj = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    let a = simd_quat_norm_sq(obj);
    let b = simd_quat_norm_sq(obj);
    if a != b {
        println("FAIL simd_quat_norm_sq");
        process_exit(1);
    }
    println("prod_simd_quat: PASSED");
}
