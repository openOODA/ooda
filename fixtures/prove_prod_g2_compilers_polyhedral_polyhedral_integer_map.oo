// # Product prove std/compilers_polyhedral/polyhedral_integer_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts basic_map_apply_point is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_integer_map.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call basic_map_apply_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_integer_map: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_integer_map.oo";

pub fn main() {
    let g2_oa = basic_integer_map_new(2, 2, 2);
    let g2_ob = basic_integer_map_new(2, 2, 2);
    let g2_la = basic_map_apply_point(g2_oa, list_new());
    let g2_lb = basic_map_apply_point(g2_ob, list_new());
    let g2_a = list_len(g2_la);
    let g2_b = list_len(g2_lb);
    if g2_a != g2_b {
        println("FAIL basic_map_apply_point");
        process_exit(1);
    }
    println("prod_g2_polyhedral_integer_map: PASSED");
}
