// # Product prove std/sec/ai/prompt_filter_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts prompt_redact_pii is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/ai/prompt_filter_stubs.oo.
//
// Beats:
//   1. Call prompt_redact_pii twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prompt_filter_stubs: PASSED only if they match.

import "std/sec/ai/prompt_filter_stubs.oo";

pub fn main() {
    let a = prompt_redact_pii("x");
    let b = prompt_redact_pii("x");
    if a != b {
        println("FAIL prompt_redact_pii");
        process_exit(1);
    }
    println("prod_prompt_filter_stubs: PASSED");
}
