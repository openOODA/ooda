// # Product prove std/media_dsp/aiff_audio_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/aiff_audio_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/aiff_audio_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aiff_audio_parser: PASSED only if they match.

import "std/media_dsp/aiff_audio_parser.oo";

pub fn main() {
    let aiff_audio_parser_a = aiff_decode_ieee_extended(0, 0);
    let aiff_audio_parser_b = aiff_decode_ieee_extended(0, 0);
    if aiff_audio_parser_a != aiff_audio_parser_b {
        println("FAIL aiff_audio_parser");
        process_exit(1);
    }
    println("prod_ap_aiff_audio_parser: PASSED");
}
