// # Product prove std/sec/sys/shadowstack_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadowstack_slot_cap is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/shadowstack_ops.oo.
//
// Beats:
//   1. Call shadowstack_slot_cap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shadowstack_ops: PASSED only if they match.

import "std/sec/sys/shadowstack_ops.oo";

pub fn main() {
    let a = shadowstack_slot_cap();
    let b = shadowstack_slot_cap();
    if a != b {
        println("FAIL shadowstack_slot_cap");
        process_exit(1);
    }
    println("prod_shadowstack_ops: PASSED");
}
