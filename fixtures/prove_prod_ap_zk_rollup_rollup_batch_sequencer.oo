// # Product prove std/zk_rollup/rollup_batch_sequencer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_batch_sequencer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_batch_sequencer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_batch_sequencer: PASSED only if they match.

import "std/zk_rollup/rollup_batch_sequencer.oo";

pub fn main() {
    let rollup_batch_sequencer_a = rollup_batch_header_new(0, 0, 0, 0, 0, 0);
    let rollup_batch_sequencer_b = rollup_batch_header_new(0, 0, 0, 0, 0, 0);
    if rollup_batch_sequencer_a.batch_number != rollup_batch_sequencer_b.batch_number {
        println("FAIL rollup_batch_sequencer");
        process_exit(1);
    }
    println("prod_ap_rollup_batch_sequencer: PASSED");
}
