// # Product prove std/web_ecosystem/jwt_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_clock_skew_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_verifier.oo.
//
// Beats:
//   1. Call jwt_clock_skew_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_jwt_verifier: PASSED only if asserts hold.

import "std/web_ecosystem/jwt_verifier.oo";

pub fn main() {
    let jwt_verifier_a: Int = jwt_clock_skew_default();
    let jwt_verifier_b: Int = jwt_clock_skew_default();
    if jwt_verifier_a != jwt_verifier_b {
        println("FAIL jwt_clock_skew_default");
        process_exit(1);
    }
    println("prod_jwt_verifier: PASSED");
}
