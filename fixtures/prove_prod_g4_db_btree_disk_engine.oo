// # Product prove std/database/btree_disk_engine.oo
//
// Logline: Fail-closed verification that B+ tree disk engine operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/database/btree_disk_engine.oo.
//
// Beats:
//   1. Initialize engine with root page and page size.
//   2. Insert key-value pairs deterministically.
//   3. Assert lookups retrieve matching inserted values.
//   4. Print prod_g4_db_btree_disk_engine: PASSED and exit 0.

import "std/database/btree_disk_engine.oo";

pub fn main() {
    let eng1: BTreeDiskEngine = btree_engine_init(1, 4096);
    let eng2: BTreeDiskEngine = btree_engine_init(1, 4096);

    let ins1: BTreeDiskEngine = btree_engine_insert(eng1, 10, 100);
    let ins2: BTreeDiskEngine = btree_engine_insert(eng2, 10, 100);

    let tot1: Int = btree_engine_total_inserts(ins1);
    let tot2: Int = btree_engine_total_inserts(ins2);
    if tot1 != tot2 || tot1 != 1 {
        println("FAIL btree_engine_total_inserts");
        process_exit(1);
    }

    let val1: Int = btree_engine_lookup(ins1, 10);
    let val2: Int = btree_engine_lookup(ins2, 10);
    if val1 != val2 || val1 != 100 {
        println("FAIL btree_engine_lookup");
        process_exit(1);
    }

    println("prod_g4_db_btree_disk_engine: PASSED");
    process_exit(0);
}
