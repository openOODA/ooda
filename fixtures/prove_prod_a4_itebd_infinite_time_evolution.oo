// # Product prove std/quantum_tensor_nets/itebd_infinite_time_evolution.oo
//
// Logline: Fail-closed emit+gcc+run asserts itebd_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/itebd_infinite_time_evolution.oo.
//
// Beats:
//   1. Call itebd_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_itebd_infinite_time_evolution: PASSED only if they match.

import "std/quantum_tensor_nets/itebd_infinite_time_evolution.oo";

pub fn main() {
    let itebd_infinite_time_evolution_mark: Int = 0;
    if itebd_infinite_time_evolution_mark != 0 {
        process_exit(1);
    }
    let a: ITebdConfig = itebd_config_default(0, 0.0);
    let b: ITebdConfig = itebd_config_default(0, 0.0);
    if (a).phys_dim != (b).phys_dim {
        println("FAIL itebd_config_default");
        process_exit(1);
    }
    println("prod_itebd_infinite_time_evolution: PASSED");
}
