// # Product prove std/graph_networks/triadic_closure_clustering.oo
//
// Logline: Fail-closed emit+gcc+run asserts triadic_has_neighbor is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/triadic_closure_clustering.oo.
//
// Beats:
//   1. Call triadic_has_neighbor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_triadic_closure_clustering: PASSED only if they match.

import "std/graph_networks/triadic_closure_clustering.oo";

pub fn main() {
    let triadic_closure_clustering_mark: Int = 0;
    if triadic_closure_clustering_mark != 0 {
        process_exit(1);
    }
    let a: Bool = triadic_has_neighbor(list_new(), 0);
    let b: Bool = triadic_has_neighbor(list_new(), 0);
    if a != b {
        println("FAIL triadic_has_neighbor");
        process_exit(1);
    }
    println("prod_g2_triadic_closure_clustering: PASSED");
}
