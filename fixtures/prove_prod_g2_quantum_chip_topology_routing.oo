// # Product prove std/quantum_advanced/quantum_chip_topology_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts chip_linear is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_chip_topology_routing.oo.
//
// Beats:
//   1. Call chip_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_chip_topology_routing: PASSED only if they match.

import "std/quantum_advanced/quantum_chip_topology_routing.oo";

pub fn main() {
    let quantum_chip_topology_routing_mark: Int = 0;
    if quantum_chip_topology_routing_mark != 0 {
        process_exit(1);
    }
    let a: ChipTopologyType = chip_linear();
    let b: ChipTopologyType = chip_linear();
    if (a).mode != (b).mode {
        println("FAIL chip_linear");
        process_exit(1);
    }
    println("prod_g2_quantum_chip_topology_routing: PASSED");
}
