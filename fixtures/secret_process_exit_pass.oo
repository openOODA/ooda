// # Allow a public process_exit code
//
// Logline: A non-secret code may reach process_exit while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Guard a public exit that does not run.
//   3. Print 1 so the pass rail still finishes.

// Secret allow non-secret: process_exit
// SECRET: token
pub fn main() {
    let token = 1;
    let public = 0;
    if public > 1 {
        process_exit(public);
    }
    println(1);
}
