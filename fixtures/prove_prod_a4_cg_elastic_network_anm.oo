// # Product prove std/protein_folding/cg_elastic_network_anm.oo
//
// Logline: Fail-closed emit+gcc+run asserts anm_calc_fluctuation is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_elastic_network_anm.oo.
//
// Beats:
//   1. Call anm_calc_fluctuation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cg_elastic_network_anm: PASSED only if they match.

import "std/protein_folding/cg_elastic_network_anm.oo";

pub fn main() {
    let cg_elastic_network_anm_mark: Int = 0;
    if cg_elastic_network_anm_mark != 0 {
        process_exit(1);
    }
    let a: Float = anm_calc_fluctuation(0.0, 0.0);
    let b: Float = anm_calc_fluctuation(0.0, 0.0);
    if a != b {
        println("FAIL anm_calc_fluctuation");
        process_exit(1);
    }
    println("prod_cg_elastic_network_anm: PASSED");
}
