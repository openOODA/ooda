// # Product prove std/quantum_topological/anyon_topological_spin_twist.oo
//
// Logline: Fail-closed emit+gcc+run asserts ribbon_balancing_phase_diff is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_topological_spin_twist.oo.
//
// Beats:
//   1. Call ribbon_balancing_phase_diff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_anyon_topological_spin_twist: PASSED only if they match.

import "std/quantum_topological/anyon_topological_spin_twist.oo";

pub fn main() {
    let anyon_topological_spin_twist_mark: Int = 0;
    if anyon_topological_spin_twist_mark != 0 {
        process_exit(1);
    }
    let a: Float = ribbon_balancing_phase_diff(0.0, 0.0, 0.0, 0.0);
    let b: Float = ribbon_balancing_phase_diff(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL ribbon_balancing_phase_diff");
        process_exit(1);
    }
    println("prod_g2_anyon_topological_spin_twist: PASSED");
}
