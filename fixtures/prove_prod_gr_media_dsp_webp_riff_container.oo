// # Product prove std/media_dsp/webp_riff_container.oo
//
// Logline: Fail-closed emit+gcc+run asserts webp_chunk_padded_size is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/webp_riff_container.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call webp_chunk_padded_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_webp_riff_container: PASSED only if they match.

import "std/media_dsp/webp_riff_container.oo";

pub fn main() {
    let g0_oa = webp_chunk_new("x", 0, 0);
    let g0_ob = webp_chunk_new("x", 0, 0);
    let g0_a = webp_chunk_padded_size(&g0_oa);
    let g0_b = webp_chunk_padded_size(&g0_ob);
    if g0_a != g0_b {
        println("FAIL webp_chunk_padded_size");
        process_exit(1);
    }
    println("prod_gr_webp_riff_container: PASSED");
}
