// # Product prove std/ai_multimodal/clip_similarity_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts clip_similarity_matrix_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/clip_similarity_matrix.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call clip_similarity_matrix_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_clip_similarity_matrix: PASSED only if they match.

import "std/ai_multimodal/clip_similarity_matrix.oo";

pub fn main() {
    let g0_a = clip_similarity_matrix_marker();
    let g0_b = clip_similarity_matrix_marker();
    if g0_a != g0_b {
        println("FAIL clip_similarity_matrix_marker");
        process_exit(1);
    }
    println("prod_gr_clip_similarity_matrix: PASSED");
}
