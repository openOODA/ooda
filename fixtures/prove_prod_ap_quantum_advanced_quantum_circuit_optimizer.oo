// # Product prove std/quantum_advanced/quantum_circuit_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/quantum_circuit_optimizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_circuit_optimizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_circuit_optimizer: PASSED only if they match.

import "std/quantum_advanced/quantum_circuit_optimizer.oo";

pub fn main() {
    let quantum_circuit_optimizer_a = circuit_merge_rotations_angle(0.0, 0.0);
    let quantum_circuit_optimizer_b = circuit_merge_rotations_angle(0.0, 0.0);
    if quantum_circuit_optimizer_a != quantum_circuit_optimizer_b {
        println("FAIL quantum_circuit_optimizer");
        process_exit(1);
    }
    println("prod_ap_quantum_circuit_optimizer: PASSED");
}
