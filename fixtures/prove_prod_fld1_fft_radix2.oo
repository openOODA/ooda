// # Product prove std/telecom/fft_radix2.oo
//
// Logline: Fail-closed emit+gcc+run asserts fft_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/fft_radix2.oo.
//
// Beats:
//   1. Call fft_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fft_radix2: PASSED only if they match.

import "std/telecom/fft_radix2.oo";

pub fn main() {
    let fft_radix2_mark: Int = 0;
    if fft_radix2_mark != 0 {
        process_exit(1);
    }
    let fft_radix2_a: Float = fft_pi();
    let fft_radix2_b: Float = fft_pi();
    if fft_radix2_a != fft_radix2_b {
        println("FAIL fft_pi");
        process_exit(1);
    }
    println("prod_fft_radix2: PASSED");
}
