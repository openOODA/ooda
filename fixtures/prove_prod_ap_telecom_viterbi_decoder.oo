// # Product prove std/telecom/viterbi_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/viterbi_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/viterbi_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_viterbi_decoder: PASSED only if they match.

import "std/telecom/viterbi_decoder.oo";

pub fn main() {
    let viterbi_decoder_a = viterbi_int_to_float(0);
    let viterbi_decoder_b = viterbi_int_to_float(0);
    if viterbi_decoder_a != viterbi_decoder_b {
        println("FAIL viterbi_decoder");
        process_exit(1);
    }
    println("prod_ap_viterbi_decoder: PASSED");
}
