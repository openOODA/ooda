// # Product prove std/protein_folding/cg_martini_forcefield.oo
//
// Logline: Fail-closed emit+gcc+run asserts martini_calc_epsilon is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_martini_forcefield.oo.
//
// Beats:
//   1. Call martini_calc_epsilon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cg_martini_forcefield: PASSED only if they match.

import "std/protein_folding/cg_martini_forcefield.oo";

pub fn main() {
    let cg_martini_forcefield_mark: Int = 0;
    if cg_martini_forcefield_mark != 0 {
        process_exit(1);
    }
    let a: Float = martini_calc_epsilon(0);
    let b: Float = martini_calc_epsilon(0);
    if a != b {
        println("FAIL martini_calc_epsilon");
        process_exit(1);
    }
    println("prod_g2_cg_martini_forcefield: PASSED");
}
