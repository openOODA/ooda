// # Product prove std/zk_rollup/rollup_fraud_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts fraud_dispute_init value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_fraud_proof.oo.
//
// Beats:
//   1. Call fraud_dispute_init twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rollup_fraud_proof: PASSED only if asserts hold.

import "std/zk_rollup/rollup_fraud_proof.oo";

pub fn main() {
    let rollup_fraud_proof_a = fraud_dispute_init(0, 0, 0, 0);
    let rollup_fraud_proof_b = fraud_dispute_init(0, 0, 0, 0);
    if rollup_fraud_proof_a.dispute_id != rollup_fraud_proof_b.dispute_id {
        println("FAIL fraud_dispute_init");
        process_exit(1);
    }
    println("prod_rollup_fraud_proof: PASSED");
}
