// # Product prove std/space_propulsion/launch_vehicle_mass_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/launch_vehicle_mass_budget.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/launch_vehicle_mass_budget.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_launch_vehicle_mass_budget: PASSED only if they match.

import "std/space_propulsion/launch_vehicle_mass_budget.oo";

pub fn main() {
    let launch_vehicle_mass_budget_a = stage_mass_inputs_default_booster();
    let launch_vehicle_mass_budget_b = stage_mass_inputs_default_booster();
    if launch_vehicle_mass_budget_a.propellant_capacity_kg != launch_vehicle_mass_budget_b.propellant_capacity_kg {
        println("FAIL launch_vehicle_mass_budget");
        process_exit(1);
    }
    println("prod_ap_launch_vehicle_mass_budget: PASSED");
}
