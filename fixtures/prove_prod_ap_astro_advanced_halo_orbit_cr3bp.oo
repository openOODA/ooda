    let halo_orbit_cr3bp_a = halo_libration();
    let halo_orbit_cr3bp_b = halo_libration();
    if halo_orbit_cr3bp_a != halo_orbit_cr3bp_b {
        println("FAIL halo_orbit_cr3bp");
