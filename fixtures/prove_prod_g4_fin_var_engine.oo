// # Product prove std/fin/var_engine.oo
//
// Logline: Fail-closed verification that financial Value at Risk calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_engine.oo.
//
// Beats:
//   1. Construct portfolio value representation.
//   2. Compute parametric Value at Risk and Expected Shortfall.
//   3. Assert deterministic VaR percentages and risk limits.
//   4. Print prod_g4_fin_var_engine: PASSED and exit 0.

import "std/fin/var_engine.oo";

pub fn main() {
    let probe1: Int = var_engine_probe();
    let probe2: Int = var_engine_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL var_engine_probe");
        process_exit(1);
    }

    let pv1: PortfolioValue = portfolio_value_new(1000000.0, 800000.0, 150000.0, 50000.0, 1.0, 0.015);
    let pv2: PortfolioValue = portfolio_value_new(1000000.0, 800000.0, 150000.0, 50000.0, 1.0, 0.015);

    let res1: VarResult = var_calculate_parametric(&pv1, 0.95, 10);
    let res2: VarResult = var_calculate_parametric(&pv2, 0.95, 10);

    if (res1).time_horizon_days != (res2).time_horizon_days || (res1).time_horizon_days != 10 {
        println("FAIL var_calculate_parametric horizon");
        process_exit(1);
    }
    if (res1).method_code != (res2).method_code || (res1).method_code != 1 {
        println("FAIL var_calculate_parametric method");
        process_exit(1);
    }
    if (res1).is_breached != (res2).is_breached || (res1).is_breached != false {
        println("FAIL var_calculate_parametric breach");
        process_exit(1);
    }

    let pnl1: Float = portfolio_total_pnl(pv1);
    let pnl2: Float = portfolio_total_pnl(pv2);
    if pnl1 != pnl2 || pnl1 != 200000.0 {
        println("FAIL portfolio_total_pnl");
        process_exit(1);
    }

    println("prod_g4_fin_var_engine: PASSED");
    process_exit(0);
}
