// # Product prove std/sec/crypto/falcon_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_batch_verifier_init value or determinism.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_engine.oo.
//
// Beats:
//   1. Call falcon_batch_verifier_init twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_falcon_engine: PASSED only if asserts hold.

import "std/sec/crypto/falcon_engine.oo";

pub fn main() {
    let falcon_engine_a = falcon_batch_verifier_init("x", 1);
    let falcon_engine_b = falcon_batch_verifier_init("x", 1);
    if falcon_engine_a.degree != falcon_engine_b.degree {
        println("FAIL falcon_batch_verifier_init");
        process_exit(1);
    }
    println("prod_falcon_engine: PASSED");
}
