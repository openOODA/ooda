// # Product prove std/grid/solar.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_math_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar.oo.
//
// Beats:
//   1. Call shim_marker_math_pi twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar: PASSED only if they match.

import "std/grid/solar.oo";

pub fn main() {
    let solar_mark: Int = 0;
    if solar_mark != 0 { process_exit(1); }
    let a: Float = shim_marker_math_pi();
    let b: Float = shim_marker_math_pi();
    if a != b { process_exit(1); }
    println("prod_solar: PASSED");
}
