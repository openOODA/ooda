// # Refuse secret ffi_call payload
//
// Logline: Pass a secret IDENT to ffi_call so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag payload as secret.
//   2. Call ffi_call with payload.
//   3. Print 1 after the call.
//
// T2-4c TP: ffi_call payload secret — must refuse (same net/FFI family)
// SECRET: payload
pub fn main(ffi: &UnsafeFFICap) {
    let payload = "secret-bytes";
    let r = ffi_call(ffi, payload);
    println(1);
}
