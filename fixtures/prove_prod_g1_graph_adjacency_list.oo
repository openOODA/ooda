// # Product prove std/graph_topology/graph_adjacency_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts adj_edge_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_adjacency_list.oo.
//
// Beats:
//   1. Call adj_edge_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_adjacency_list: PASSED only if they match.

import "std/graph_topology/graph_adjacency_list.oo";

pub fn main() {
    let a: AdjEdge = adj_edge_new(0, 0);
    let b: AdjEdge = adj_edge_new(0, 0);
    if a.target != b.target {
        println("FAIL adj_edge_new");
        process_exit(1);
    }
    println("prod_graph_adjacency_list: PASSED");
}
