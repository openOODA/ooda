// # Product prove std/quantum_open_systems/quantum_reservoir_computing.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_reservoir_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_reservoir_computing.oo.
//
// Beats:
//   1. Call quantum_reservoir_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_reservoir_computing: PASSED only if they match.

import "std/quantum_open_systems/quantum_reservoir_computing.oo";

pub fn main() {
    let quantum_reservoir_computing_mark: Int = 0;
    if quantum_reservoir_computing_mark != 0 {
        process_exit(1);
    }
    let a: QuantumReservoirConfig = quantum_reservoir_config_default();
    let b: QuantumReservoirConfig = quantum_reservoir_config_default();
    if (a).num_spins != (b).num_spins {
        println("FAIL quantum_reservoir_config_default");
        process_exit(1);
    }
    println("prod_quantum_reservoir_computing: PASSED");
}
