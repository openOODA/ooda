// # Hello World greet
//
// Logline: Greet a name and print the openOODA Developer hello.
//
// Beats:
//   1. greet concatenates Hello, name, and !.
//   2. verify checks World and OODA.
//   3. main prints greet("openOODA Developer").

pub fn greet(name: String) -> String {
    // M19: complex requires (name.len()) fail-closed at emit; use verify instead
    return "Hello, " + name + "!";
}

// Co-located verification block
verify greet {
    assert_eq!(greet("World"), "Hello, World!");
    assert_eq!(greet("OODA"), "Hello, OODA!");
}

pub fn main() {
    let message = greet("openOODA Developer");
    println(message);
}
