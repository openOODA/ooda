// # Product prove std/sync/lockfree_stack.oo
//
// Logline: Fail-closed emit+gcc+run asserts lockfree_stack_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/lockfree_stack.oo.
//
// Beats:
//   1. Call lockfree_stack_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lockfree_stack: PASSED only if they match.

import "std/sync/lockfree_stack.oo";

pub fn main() {
    let obj = lockfree_stack_new();
    let a = lockfree_stack_len(obj);
    let b = lockfree_stack_len(obj);
    if a != b {
        println("FAIL lockfree_stack_len");
        process_exit(1);
    }
    println("prod_lockfree_stack: PASSED");
}
