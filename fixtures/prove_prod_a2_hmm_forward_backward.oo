// # Product prove std/bio_advanced/hmm_forward_backward.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmm_log_sum_exp is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_forward_backward.oo.
//
// Beats:
//   1. Call hmm_log_sum_exp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hmm_forward_backward: PASSED only if they match.

import "std/bio_advanced/hmm_forward_backward.oo";

pub fn main() {
    let hmm_forward_backward_mark: Int = 0;
    if hmm_forward_backward_mark != 0 {
        process_exit(1);
    }
    let a: Float = hmm_log_sum_exp(0.0, 0.0);
    let b: Float = hmm_log_sum_exp(0.0, 0.0);
    if a != b {
        println("FAIL hmm_log_sum_exp");
        process_exit(1);
    }
    println("prod_hmm_forward_backward: PASSED");
}
