// # Product prove std/sec/crypto/falcon_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_falcon_types: PASSED only if they match.

import "std/sec/crypto/falcon_types.oo";

pub fn main() {
    let falcon_types_a = falcon_512_degree();
    let falcon_types_b = falcon_512_degree();
    if falcon_types_a != falcon_types_b {
        println("FAIL falcon_types");
        process_exit(1);
    }
    println("prod_ap_falcon_types: PASSED");
}
