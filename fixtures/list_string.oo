// # List[String] walk and eq
//
// Logline: Push two strings, walk them, and compare concat vs literal equality.
//
// Beats:
//   1. Push "hi" and "yo"; print len and both gets.
//   2. For-each print each string.
//   3. Compare ["hi"+"yo"] to ["hiyo"] and print 1.

// List[String]: push / .len / list_get / for / content == (interp + WASM).
// Equality must match interpreter String content eq (concat vs literal).
pub fn main() {
    let mut xs: List[String] = list_new();
    xs = xs.push("hi");
    xs = xs.push("yo");
    println(xs.len());
    println(list_get(xs, 0));
    println(list_get(xs, 1));
    for s in xs {
        println(s);
    }
    let mut a: List[String] = list_new();
    a = a.push("hi" + "yo");
    let mut b: List[String] = list_new();
    b = b.push("hiyo");
    if a == b {
        println(1);
    } else {
        println(0);
    }
}
