// # Product prove std/sec/crypto/tss.oo
//
// Logline: Fail-closed emit+gcc+run asserts TSS threshold parameters and initialization operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss.oo.
//
// Beats:
//   1. Instantiate ThresholdParams with concrete threshold and participant counts.
//   2. Query threshold values and parameter properties.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_sec_tss: PASSED and exit 0.

import "std/sec/crypto/tss.oo";

pub fn main() {
    let p1: ThresholdParams = shim_marker_tss_params();
    let p2: ThresholdParams = shim_marker_tss_params();
    if shim_marker_tss_params_t(p1) != shim_marker_tss_params_t(p2) || shim_marker_tss_params_t(p1) != 2 {
        println("FAIL shim_marker_tss_params");
        process_exit(1);
    }

    let p_ops1: ThresholdParams = shim_marker_tss_ops_init(3, 5, 2);
    let p_ops2: ThresholdParams = shim_marker_tss_ops_init(3, 5, 2);
    if shim_marker_tss_params_t(p_ops1) != shim_marker_tss_params_t(p_ops2) || shim_marker_tss_params_t(p_ops1) != 3 {
        println("FAIL shim_marker_tss_ops_init");
        process_exit(1);
    }

    if (p_ops1).total_shares != (p_ops2).total_shares || (p_ops1).total_shares != 5 {
        println("FAIL total_shares");
        process_exit(1);
    }

    if (p_ops1).curve_id != (p_ops2).curve_id || (p_ops1).curve_id != 2 {
        println("FAIL curve_id");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_tss_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_tss: PASSED");
    process_exit(0);
}
