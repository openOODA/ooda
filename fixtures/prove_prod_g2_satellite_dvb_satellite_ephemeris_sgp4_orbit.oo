// # Product prove std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo
//
// Logline: Fail-closed emit+gcc+run asserts kepler_solve_eccentric_anomaly_rad is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kepler_solve_eccentric_anomaly_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_ephemeris_sgp4_orbit: PASSED only if they match.

import "std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo";

pub fn main() {
    let g2_a = kepler_solve_eccentric_anomaly_rad(1.0, 1.0);
    let g2_b = kepler_solve_eccentric_anomaly_rad(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL kepler_solve_eccentric_anomaly_rad");
        process_exit(1);
    }
    println("prod_g2_satellite_ephemeris_sgp4_orbit: PASSED");
}
