// # Product prove std/robotics_auv/added_mass_damping_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts adam_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/added_mass_damping_matrix.oo.
//
// Beats:
//   1. Call adam_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_added_mass_damping_matrix: PASSED only if they match.

import "std/robotics_auv/added_mass_damping_matrix.oo";

pub fn main() {
    let added_mass_damping_matrix_mark: Int = 0;
    if added_mass_damping_matrix_mark != 0 {
        process_exit(1);
    }
    let a: Int = adam_abs(0);
    let b: Int = adam_abs(0);
    if a != b {
        println("FAIL adam_abs");
        process_exit(1);
    }
    println("prod_added_mass_damping_matrix: PASSED");
}
