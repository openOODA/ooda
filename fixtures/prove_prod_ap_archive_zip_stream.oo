// # Product prove std/archive/zip_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/zip_stream.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zip_stream.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zip_stream: PASSED only if they match.

import "std/archive/zip_stream.oo";

pub fn main() {
    let zip_stream_a = zip_detect_magic("x");
    let zip_stream_b = zip_detect_magic("x");
    if zip_stream_a != zip_stream_b {
        println("FAIL zip_stream");
        process_exit(1);
    }
    println("prod_ap_zip_stream: PASSED");
}
