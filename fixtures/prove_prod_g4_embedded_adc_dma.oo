// # Product prove std/embedded_hal/adc_dma_continuous.oo
//
// Logline: Fail-closed verification that ADC DMA continuous sampling and conversion are deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/adc_dma_continuous.oo.
//
// Beats:
//   1. Configure ADC channels and controller instances.
//   2. Convert raw quantization codes to calibrated millivolts.
//   3. Compute oversampled sample averages.
//   4. Print prod_g4_embedded_adc_dma: PASSED and exit 0.

import "std/embedded_hal/adc_dma_continuous.oo";

pub fn main() {
    let ch1: AdcChannelConfig = adc_channel_config_new(0, 1);
    let ch2: AdcChannelConfig = adc_channel_config_new(0, 1);

    let ctrl1: AdcController = adc_controller_new(1, 12, 3300);
    let ctrl2: AdcController = adc_controller_new(1, 12, 3300);

    let adc1: AdcController = adc_add_channel(ctrl1, ch1);
    let adc2: AdcController = adc_add_channel(ctrl2, ch2);

    let mv1: Int = adc_raw_to_millivolts(adc1, 2048);
    let mv2: Int = adc_raw_to_millivolts(adc2, 2048);
    if mv1 != mv2 || mv1 != 1650 {
        println("FAIL adc_raw_to_millivolts");
        process_exit(1);
    }

    let mut samples1: List[Int] = list_new();
    samples1 = list_push(samples1, 2000);
    samples1 = list_push(samples1, 2100);
    samples1 = list_push(samples1, 2200);

    let mut samples2: List[Int] = list_new();
    samples2 = list_push(samples2, 2000);
    samples2 = list_push(samples2, 2100);
    samples2 = list_push(samples2, 2200);

    let avg1: Int = adc_calculate_oversampled_average(samples1);
    let avg2: Int = adc_calculate_oversampled_average(samples2);
    if avg1 != avg2 || avg1 != 2100 {
        println("FAIL adc_calculate_oversampled_average");
        process_exit(1);
    }

    let started: AdcController = adc_start_continuous(adc1);
    let stopped: AdcController = adc_stop_continuous(started);
    if (stopped).is_scanning != false {
        println("FAIL adc_stop_continuous");
        process_exit(1);
    }

    println("prod_g4_embedded_adc_dma: PASSED");
    process_exit(0);
}
