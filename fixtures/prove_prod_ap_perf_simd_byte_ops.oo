// # Product prove std/perf/simd_byte_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/simd_byte_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/simd_byte_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_byte_ops: PASSED only if they match.

import "std/perf/simd_byte_ops.oo";

pub fn main() {
    let simd_byte_ops_a = simd_memcmp("x", "x", 0);
    let simd_byte_ops_b = simd_memcmp("x", "x", 0);
    if simd_byte_ops_a != simd_byte_ops_b {
        println("FAIL simd_byte_ops");
        process_exit(1);
    }
    println("prod_ap_simd_byte_ops: PASSED");
}
