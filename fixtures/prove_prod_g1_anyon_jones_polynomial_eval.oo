// # Product prove std/quantum_topological/anyon_jones_polynomial_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts braid_crossing_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_jones_polynomial_eval.oo.
//
// Beats:
//   1. Call braid_crossing_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anyon_jones_polynomial_eval: PASSED only if they match.

import "std/quantum_topological/anyon_jones_polynomial_eval.oo";

pub fn main() {
    let a: BraidCrossing = braid_crossing_new(0, 0);
    let b: BraidCrossing = braid_crossing_new(0, 0);
    if a.strand_index != b.strand_index {
        println("FAIL braid_crossing_new");
        process_exit(1);
    }
    println("prod_anyon_jones_polynomial_eval: PASSED");
}
