// # Product prove std/uav_flight/uav_collision_avoidance_orca.oo
//
// Logline: Fail-closed emit+gcc+run asserts orca_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_collision_avoidance_orca.oo.
//
// Beats:
//   1. Call orca_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_collision_avoidance_orca: PASSED only if they match.

import "std/uav_flight/uav_collision_avoidance_orca.oo";

pub fn main() {
    let uav_collision_avoidance_orca_mark: Int = 0;
    if uav_collision_avoidance_orca_mark != 0 {
        process_exit(1);
    }
    let a: OrcaConfig = orca_config_default();
    let b: OrcaConfig = orca_config_default();
    if (a).time_horizon_sec != (b).time_horizon_sec {
        println("FAIL orca_config_default");
        process_exit(1);
    }
    println("prod_g2_uav_collision_avoidance_orca: PASSED");
}
