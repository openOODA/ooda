// # Product prove std/zk_rollup/caulk_lookup_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts caulk_vanish_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/caulk_lookup_argument.oo.
//
// Beats:
//   1. Call caulk_vanish_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_caulk_lookup_argument: PASSED only if they match.

import "std/zk_rollup/caulk_lookup_argument.oo";

pub fn main() {
    let caulk_lookup_argument_mark: Int = 0;
    if caulk_lookup_argument_mark != 0 {
        process_exit(1);
    }
    let a: Int = caulk_vanish_eval(0, 0, 0, 0, 0);
    let b: Int = caulk_vanish_eval(0, 0, 0, 0, 0);
    if a != b {
        println("FAIL caulk_vanish_eval");
        process_exit(1);
    }
    println("prod_g2_caulk_lookup_argument: PASSED");
}
