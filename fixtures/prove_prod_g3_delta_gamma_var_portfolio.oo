// # Product prove std/defi_derivatives/delta_gamma_var_portfolio.oo
//
// Logline: Fail-closed emit+gcc+run asserts calc_z_score is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/delta_gamma_var_portfolio.oo.
//
// Beats:
//   1. Call calc_z_score twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_delta_gamma_var_portfolio: PASSED only if they match.

import "std/defi_derivatives/delta_gamma_var_portfolio.oo";

pub fn main() {
    let delta_gamma_var_portfolio_mark: Int = 0;
    if delta_gamma_var_portfolio_mark != 0 {
        process_exit(1);
    }
    let a: Float = calc_z_score(0.0);
    let b: Float = calc_z_score(0.0);
    if a != b {
        println("FAIL calc_z_score");
        process_exit(1);
    }
    println("prod_delta_gamma_var_portfolio: PASSED");
}
