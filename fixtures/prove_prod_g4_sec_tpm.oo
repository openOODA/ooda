// # Product prove std/sec/crypto/tpm.oo
//
// Logline: Fail-closed emit+gcc+run asserts TPM 2.0 checksums, NV index structures, and hex conversions are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tpm.oo.
//
// Beats:
//   1. Calculate DJB2 checksum hashes and verify equality.
//   2. Test hex encoding and decoding roundtrips.
//   3. Inspect TpmNvIndex properties and index accessors.
//   4. Print prod_g4_sec_tpm: PASSED and exit 0.

import "std/sec/crypto/tpm.oo";

pub fn main() {
    let cs1: Int = shim_marker_tpm_checksum();
    let cs2: Int = shim_marker_tpm_checksum();
    if cs1 != cs2 {
        println("FAIL shim_marker_tpm_checksum");
        process_exit(1);
    }

    let hex1: String = shim_marker_hex_encode();
    let hex2: String = shim_marker_hex_encode();
    if hex1 != hex2 || chars_len(hex1) == 0 {
        println("FAIL shim_marker_hex_encode");
        process_exit(1);
    }

    let dec_res1: Result[String, String] = shim_marker_hex_decode(hex1);
    let dec_res2: Result[String, String] = shim_marker_hex_decode(hex2);
    let dec1: String = match dec_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let dec2: String = match dec_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec1 != dec2 || dec1 != "TPM2.0" {
        println("FAIL shim_marker_hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = shim_marker_constant_time_eq("nonce123", "nonce123");
    let eq_b: Bool = shim_marker_constant_time_eq("nonce123", "nonce123");
    if eq_a != eq_b || eq_a == false {
        println("FAIL shim_marker_constant_time_eq true");
        process_exit(1);
    }

    let neq_a: Bool = shim_marker_constant_time_eq("nonce123", "nonce456");
    let neq_b: Bool = shim_marker_constant_time_eq("nonce123", "nonce456");
    if neq_a != neq_b || neq_a == true {
        println("FAIL shim_marker_constant_time_eq false");
        process_exit(1);
    }

    let nv1: TpmNvIndex = shim_marker_nv_new(1, 64, 15);
    let nv2: TpmNvIndex = shim_marker_nv_new(1, 64, 15);
    if tpm_nv_id(nv1) != tpm_nv_id(nv2) || tpm_nv_id(nv1) != 1 {
        println("FAIL tpm_nv_id");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_tpm_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_tpm: PASSED");
    process_exit(0);
}
