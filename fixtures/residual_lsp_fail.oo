// # Call residual lsp_serve
//
// Logline: A bare call to lsp_serve is the residual fail rail for that surface.
//
// Beats:
//   1. Invoke the residual name from main.
//   2. Bind the result so the call is live.
//   3. Expect check or emit to refuse the residual.

pub fn main() { let r = lsp_serve(0); }
