// # Product prove std/physics/constraint_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/constraint_distance.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/physics/constraint_distance.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_constraint_distance: PASSED only if they match.

import "std/physics/constraint_distance.oo";

pub fn main() {
    let constraint_distance_a = distance_constraint_new(0, 0, 0.0, 0.0);
    let constraint_distance_b = distance_constraint_new(0, 0, 0.0, 0.0);
    if constraint_distance_a.body_a_id != constraint_distance_b.body_a_id {
        println("FAIL constraint_distance");
        process_exit(1);
    }
    println("prod_ap_constraint_distance: PASSED");
}
