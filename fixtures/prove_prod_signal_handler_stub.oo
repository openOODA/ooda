// # Product prove std/os/signal_handler_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts signal_is_registered is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/signal_handler_stub.oo.
//
// Beats:
//   1. Call signal_is_registered twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_signal_handler_stub: PASSED only if they match.

import "std/os/signal_handler_stub.oo";

pub fn main() {
    let obj = signal_registry_new();
    let a = signal_is_registered(obj, 0);
    let b = signal_is_registered(obj, 0);
    if a != b {
        println("FAIL signal_is_registered");
        process_exit(1);
    }
    println("prod_signal_handler_stub: PASSED");
}
