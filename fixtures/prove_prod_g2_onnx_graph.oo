// # Product prove std/ai_ml/onnx_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts onnx_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/onnx_graph.oo.
//
// Beats:
//   1. Call onnx_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_onnx_graph: PASSED only if they match.

import "std/ai_ml/onnx_graph.oo";

pub fn main() {
    let onnx_graph_mark: Int = 0;
    if onnx_graph_mark != 0 {
        process_exit(1);
    }
    let a: OnnxNode = onnx_node_new(0, 0);
    let b: OnnxNode = onnx_node_new(0, 0);
    if (a).op_id != (b).op_id {
        println("FAIL onnx_node_new");
        process_exit(1);
    }
    println("prod_g2_onnx_graph: PASSED");
}
