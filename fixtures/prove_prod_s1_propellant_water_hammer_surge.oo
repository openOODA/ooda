// # Product prove std/space_propulsion/propellant_water_hammer_surge.oo
//
// Logline: Fail-closed emit+gcc+run asserts water_hammer_compute_surge is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_water_hammer_surge.oo.
//
// Beats:
//   1. Call water_hammer_compute_surge twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_water_hammer_surge: PASSED only if they match.

import "std/space_propulsion/propellant_water_hammer_surge.oo";

pub fn main() {
    let propellant_water_hammer_surge_mark: Int = 0;
    if propellant_water_hammer_surge_mark != 0 {
        process_exit(1);
    }
    let propellant_water_hammer_surge_a = water_hammer_compute_surge(propellant_line_spec_default_lox());
    let propellant_water_hammer_surge_b = water_hammer_compute_surge(propellant_line_spec_default_lox());
    if (propellant_water_hammer_surge_a).is_rapid_closure != (propellant_water_hammer_surge_b).is_rapid_closure {
        println("FAIL water_hammer_compute_surge");
        process_exit(1);
    }
    println("prod_propellant_water_hammer_surge: PASSED");
}
