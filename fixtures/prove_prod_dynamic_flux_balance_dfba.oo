// # Product prove std/synthetic_biology/dynamic_flux_balance_dfba.oo
//
// Logline: Fail-closed emit+gcc+run asserts dfba_calc_uptake_bound real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/dynamic_flux_balance_dfba.oo.
//
// Beats:
//   1. Call dfba_calc_uptake_bound with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_dynamic_flux_balance_dfba: PASSED only if the assert holds.

import "std/synthetic_biology/dynamic_flux_balance_dfba.oo";

pub fn main() {
    let dynamic_flux_balance_dfba_mark: Int = 0;
    if dynamic_flux_balance_dfba_mark != 0 {
        process_exit(1);
    }
    let dynamic_flux_balance_dfba_p: DfbaKineticsParams = DfbaKineticsParams { v_max_substrate: 0.0, k_s: 0.0, yield_biomass_substrate: 0.0, yield_product_biomass: 0.0, maintenance_flux: 0.0 };
    let dynamic_flux_balance_dfba_n: Float = dfba_calc_uptake_bound(0.0, &dynamic_flux_balance_dfba_p);
    if !(dynamic_flux_balance_dfba_n == 0.0) {
        println("FAIL dfba_calc_uptake_bound");
        process_exit(1);
    }
    println("prod_dynamic_flux_balance_dfba: PASSED");
}
