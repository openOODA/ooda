// # Product prove std/pqc_nist/falcon_fft.oo
//
// Logline: Fail-closed emit+gcc+run asserts complex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_fft.oo.
//
// Beats:
//   1. Call complex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_fft: PASSED only if they match.

import "std/pqc_nist/falcon_fft.oo";

pub fn main() {
    let a: ComplexF64 = complex_new(0.0, 0.0);
    let b: ComplexF64 = complex_new(0.0, 0.0);
    if a.re != b.re {
        println("FAIL complex_new");
        process_exit(1);
    }
    println("prod_falcon_fft: PASSED");
}
