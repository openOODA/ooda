// # Product prove std/sec/net/waf_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_engine_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_engine.oo.
//
// Beats:
//   1. Call waf_engine_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_waf_engine: PASSED only if they match.

import "std/sec/net/waf_engine.oo";

pub fn main() {
    let a = waf_engine_ready();
    let b = waf_engine_ready();
    if a != b {
        println("FAIL waf_engine_ready");
        process_exit(1);
    }
    println("prod_waf_engine: PASSED");
}
