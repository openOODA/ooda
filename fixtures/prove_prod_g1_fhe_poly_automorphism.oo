// # Product prove std/fhe_lattices/fhe_poly_automorphism.oo
//
// Logline: Fail-closed emit+gcc+run asserts galois_automorphism_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_poly_automorphism.oo.
//
// Beats:
//   1. Call galois_automorphism_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_poly_automorphism: PASSED only if they match.

import "std/fhe_lattices/fhe_poly_automorphism.oo";

pub fn main() {
    let a: GaloisAutomorphism = galois_automorphism_new(0, 0, 0);
    let b: GaloisAutomorphism = galois_automorphism_new(0, 0, 0);
    if a.k_generator != b.k_generator {
        println("FAIL galois_automorphism_new");
        process_exit(1);
    }
    println("prod_fhe_poly_automorphism: PASSED");
}
