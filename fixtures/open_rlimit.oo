// # POSIX rlimit product fixture
//
// Logline: Set a tiny nofile ceiling under SysCap and refuse a zero memory quota.
//
// Setup: Runtime oo_rlimit_set_* calls setrlimit after oo_cap_require_sys.
//
// Beats:
//   1. oo_rlimit_set_mem_mb(sys, 0) fails closed.
//   2. oo_rlimit_set_nofile(sys, 0) fails closed.
//   3. oo_rlimit_set_nofile(sys, 256) applies a tiny fd ceiling.

pub fn main(sys: &SysCap) {
    let zmem: Result[String, String] = oo_rlimit_set_mem_mb(sys, 0);
    if zmem.is_ok() {
        println("FAIL: mem 0 must fail closed");
        process_exit(1);
    }
    let zfd: Result[String, String] = oo_rlimit_set_nofile(sys, 0);
    if zfd.is_ok() {
        println("FAIL: nofile 0 must fail closed");
        process_exit(1);
    }
    let nfd: Result[String, String] = oo_rlimit_set_nofile(sys, 256);
    if nfd.is_err() {
        println("FAIL: nofile 256");
        process_exit(1);
    }
    println("open_rlimit: PASSED");
}
