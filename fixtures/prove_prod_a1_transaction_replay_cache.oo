// # Product prove std/bft_consensus/transaction_replay_cache.oo
//
// Logline: Fail-closed emit+gcc+run asserts account_nonce_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/transaction_replay_cache.oo.
//
// Beats:
//   1. Call account_nonce_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_transaction_replay_cache: PASSED only if they match.

import "std/bft_consensus/transaction_replay_cache.oo";

pub fn main() {
    let transaction_replay_cache_mark: Int = 0;
    if transaction_replay_cache_mark != 0 {
        process_exit(1);
    }
    let a: AccountNonceEntry = account_nonce_entry_new("x", 0, 0);
    let b: AccountNonceEntry = account_nonce_entry_new("x", 0, 0);
    if (a).expected_nonce != (b).expected_nonce {
        println("FAIL account_nonce_entry_new");
        process_exit(1);
    }
    println("prod_transaction_replay_cache: PASSED");
}
