// # Product prove std/compilers/c_header_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts c_tok_eof is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_lexer.oo.
//
// Beats:
//   1. Call c_tok_eof twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_c_header_lexer: PASSED only if they match.

import "std/compilers/c_header_lexer.oo";

pub fn main() {
    let c_header_lexer_mark: Int = 0;
    if c_header_lexer_mark != 0 {
        process_exit(1);
    }
    let a: Int = c_tok_eof();
    let b: Int = c_tok_eof();
    if a != b {
        println("FAIL c_tok_eof");
        process_exit(1);
    }
    println("prod_c_header_lexer: PASSED");
}
