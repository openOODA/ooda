// # Product prove std/quantum_advanced/quantum_trotter_suzuki.oo
//
// Logline: Fail-closed emit+gcc+run asserts trotter_order_1 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_trotter_suzuki.oo.
//
// Beats:
//   1. Call trotter_order_1 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_trotter_suzuki: PASSED only if they match.

import "std/quantum_advanced/quantum_trotter_suzuki.oo";

pub fn main() {
    let a: TrotterOrderType = trotter_order_1();
    let b: TrotterOrderType = trotter_order_1();
    if a.order_k != b.order_k {
        println("FAIL trotter_order_1");
        process_exit(1);
    }
    println("prod_quantum_trotter_suzuki: PASSED");
}
