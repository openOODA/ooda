// # Product prove std/scicomp/ode_adams_bashforth.oo
//
// Logline: Fail-closed verification that Adams-Bashforth explicit predictor and Adams-Moulton implicit corrector steps are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/ode_adams_bashforth.oo.
//
// Beats:
//   1. Construct AdamsHistory and initialize derivative history vectors.
//   2. Compute 4th-order Adams-Bashforth step for a constant vector field.
//   3. Compute 4th-order Adams-Moulton corrector step.
//   4. Print prod_g4_scicomp_adams: PASSED and exit 0.

import "std/scicomp/ode_adams_bashforth.oo";

pub fn main() {
    let mut hist: AdamsHistory = adams_history_new();
    if (hist).steps_available != 0 {
        println("FAIL adams_history_new");
        process_exit(1);
    }

    let mut f_vec: List[Float] = list_new();
    f_vec = list_push(f_vec, 2.0);

    (hist).f0 = f_vec;
    (hist).f1 = f_vec;
    (hist).f2 = f_vec;
    (hist).f3 = f_vec;
    (hist).steps_available = 4;

    let mut y_curr: List[Float] = list_new();
    y_curr = list_push(y_curr, 10.0);

    let y_ab1: List[Float] = adams_bashforth_4_step(&y_curr, 0.5, &hist);
    let y_ab2: List[Float] = adams_bashforth_4_step(&y_curr, 0.5, &hist);

    let val_ab1: Float = list_get(y_ab1, 0);
    let val_ab2: Float = list_get(y_ab2, 0);

    if val_ab1 != val_ab2 || val_ab1 < 10.999 || val_ab1 > 11.001 {
        println("FAIL adams_bashforth_4_step");
        process_exit(1);
    }

    let mut f_pred: List[Float] = list_new();
    f_pred = list_push(f_pred, 2.0);

    let y_am1: List[Float] = adams_moulton_4_step(&y_curr, 0.5, &f_pred, &hist);
    let y_am2: List[Float] = adams_moulton_4_step(&y_curr, 0.5, &f_pred, &hist);

    let val_am1: Float = list_get(y_am1, 0);
    let val_am2: Float = list_get(y_am2, 0);

    if val_am1 != val_am2 || val_am1 < 10.999 || val_am1 > 11.001 {
        println("FAIL adams_moulton_4_step");
        process_exit(1);
    }

    println("prod_g4_scicomp_adams: PASSED");
    process_exit(0);
}
