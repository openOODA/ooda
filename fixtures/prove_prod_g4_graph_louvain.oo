// # Product prove std/graph_topology/louvain_community_detect.oo
//
// Logline: Fail-closed verification of Louvain modularity community detection algorithm.
//
// Setup: Isolated emit-c. Imports std/graph_topology/louvain_community_detect.oo.
//
// Beats:
//   1. Construct partitioned graph with two interconnected clusters.
//   2. Run Louvain community detection and assert deterministic partition IDs.
//   3. Validate community cluster queries and boundary handling.
//   4. Print prod_g4_graph_louvain: PASSED and exit 0.

import "std/graph_topology/louvain_community_detect.oo";

pub fn main() {
    let mut g: GraphAdjList = adj_list_create(false);
    adj_list_add_edge(&mut g, 0, 1, 1);
    adj_list_add_edge(&mut g, 1, 2, 1);
    adj_list_add_edge(&mut g, 2, 0, 1);

    adj_list_add_edge(&mut g, 3, 4, 1);
    adj_list_add_edge(&mut g, 4, 5, 1);
    adj_list_add_edge(&mut g, 5, 3, 1);

    adj_list_add_edge(&mut g, 2, 3, 1);

    let res1: LouvainResult = louvain_detect_communities(&g, 6, 10);
    let res2: LouvainResult = louvain_detect_communities(&g, 6, 10);

    let n1: Int = (res1).num_vertices;
    let n2: Int = (res2).num_vertices;
    if n1 != n2 || n1 != 6 {
        println("FAIL num_vertices");
        process_exit(1);
    }

    let c_cnt1: Int = (res1).community_count;
    let c_cnt2: Int = (res2).community_count;
    if c_cnt1 != c_cnt2 || c_cnt1 <= 0 {
        println("FAIL community_count");
        process_exit(1);
    }

    let mod1: Int = (res1).modularity_scaled;
    let mod2: Int = (res2).modularity_scaled;
    if mod1 != mod2 || mod1 != 7500 {
        println("FAIL modularity_scaled");
        process_exit(1);
    }

    let c0_a: Int = louvain_get_community(&res1, 0);
    let c0_b: Int = louvain_get_community(&res2, 0);
    if c0_a != c0_b {
        println("FAIL louvain_get_community determinism");
        process_exit(1);
    }

    let same_0_1: Bool = louvain_same_community(&res1, 0, 1);
    let same_3_4: Bool = louvain_same_community(&res1, 3, 4);
    if !same_0_1 || !same_3_4 {
        println("FAIL louvain_same_community internal cluster");
        process_exit(1);
    }

    let out_bound: Int = louvain_get_community(&res1, -1);
    let out_bound_hi: Int = louvain_get_community(&res1, 100);
    if out_bound != -1 || out_bound_hi != -1 {
        println("FAIL louvain_get_community bounds");
        process_exit(1);
    }

    let bad_same: Bool = louvain_same_community(&res1, -1, 0);
    if bad_same {
        println("FAIL louvain_same_community bounds");
        process_exit(1);
    }

    println("prod_g4_graph_louvain: PASSED");
    process_exit(0);
}
