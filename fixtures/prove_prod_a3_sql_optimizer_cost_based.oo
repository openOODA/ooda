// # Product prove std/db_storage/sql_optimizer_cost_based.oo
//
// Logline: Fail-closed emit+gcc+run asserts estimate_equality_selectivity is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_optimizer_cost_based.oo.
//
// Beats:
//   1. Call estimate_equality_selectivity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_optimizer_cost_based: PASSED only if they match.

import "std/db_storage/sql_optimizer_cost_based.oo";

pub fn main() {
    let sql_optimizer_cost_based_mark: Int = 0;
    if sql_optimizer_cost_based_mark != 0 {
        process_exit(1);
    }
    let a: Float = estimate_equality_selectivity(0);
    let b: Float = estimate_equality_selectivity(0);
    if a != b {
        println("FAIL estimate_equality_selectivity");
        process_exit(1);
    }
    println("prod_sql_optimizer_cost_based: PASSED");
}
