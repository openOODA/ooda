// # Product prove std/web_ecosystem/zod_object_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_object_missing is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_object_schema.oo.
//
// Beats:
//   1. Call zod_object_missing twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zod_object_schema: PASSED only if they match.

import "std/web_ecosystem/zod_object_schema.oo";

pub fn main() {
    let zod_object_schema_mark: Int = 0;
    if zod_object_schema_mark != 0 {
        process_exit(1);
    }
    let a: Int = zod_object_missing(0, 0);
    let b: Int = zod_object_missing(0, 0);
    if a != b {
        println("FAIL zod_object_missing");
        process_exit(1);
    }
    println("prod_zod_object_schema: PASSED");
}
