// # Product prove std/quantum_topological/topological_qubit_initialization.oo
//
// Logline: Fail-closed emit+gcc+run asserts topo_qubit_init_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_qubit_initialization.oo.
//
// Beats:
//   1. Call topo_qubit_init_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_qubit_initialization: PASSED only if they match.

import "std/quantum_topological/topological_qubit_initialization.oo";

pub fn main() {
    let topological_qubit_initialization_mark: Int = 0;
    if topological_qubit_initialization_mark != 0 {
        process_exit(1);
    }
    let a: TopoQubitRegister = topo_qubit_init_zero(0);
    let b: TopoQubitRegister = topo_qubit_init_zero(0);
    if (a).num_anyons != (b).num_anyons {
        println("FAIL topo_qubit_init_zero");
        process_exit(1);
    }
    println("prod_topological_qubit_initialization: PASSED");
}
