// # Product prove std/bft_consensus/consensus_event_log_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/consensus_event_log_emitter.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/consensus_event_log_emitter.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_consensus_event_log_emitter: PASSED only if they match.

import "std/bft_consensus/consensus_event_log_emitter.oo";

pub fn main() {
    let consensus_event_log_emitter_a = event_log_buffer_new();
    let consensus_event_log_emitter_b = event_log_buffer_new();
    if consensus_event_log_emitter_a.total_events_emitted != consensus_event_log_emitter_b.total_events_emitted {
        println("FAIL consensus_event_log_emitter");
        process_exit(1);
    }
    println("prod_ap_consensus_event_log_emitter: PASSED");
}
