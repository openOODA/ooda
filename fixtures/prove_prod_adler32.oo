// # Product Adler-32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped adler32_update_byte/digest.
//
// Setup: Product std/io/checksum_adler32.oo. RFC 1950 / Wikipedia vector.
//
// Beats:
//   1. Fresh Adler-32 digest is 1.
//   2. Wikipedia bytes digest is 300286872 (0x11E60398).
//   3. Exit 1 before PASSED on a miss.

import "std/io/checksum_adler32.oo";

pub fn main() {
    let st0: Adler32 = adler32_new();
    let d0: Int = adler32_digest(st0);
    if d0 != 1 {
        println("FAIL adler32 empty");
        process_exit(1);
    }
    let mut st: Adler32 = adler32_new();
    st = adler32_update_byte(st, 87);
    st = adler32_update_byte(st, 105);
    st = adler32_update_byte(st, 107);
    st = adler32_update_byte(st, 105);
    st = adler32_update_byte(st, 112);
    st = adler32_update_byte(st, 101);
    st = adler32_update_byte(st, 100);
    st = adler32_update_byte(st, 105);
    st = adler32_update_byte(st, 97);
    let d: Int = adler32_digest(st);
    if d != 300286872 {
        println("FAIL adler32 Wikipedia");
        process_exit(1);
    }
    println("prod_adler32: PASSED");
}
