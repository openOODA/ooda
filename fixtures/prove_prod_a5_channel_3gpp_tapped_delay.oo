// # Product prove std/telecom_5g/channel_3gpp_tapped_delay.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_tdl_scaled_delay_ns is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_3gpp_tapped_delay.oo.
//
// Beats:
//   1. Call channel_tdl_scaled_delay_ns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_3gpp_tapped_delay: PASSED only if they match.

import "std/telecom_5g/channel_3gpp_tapped_delay.oo";

pub fn main() {
    let channel_3gpp_tapped_delay_mark: Int = 0;
    if channel_3gpp_tapped_delay_mark != 0 {
        process_exit(1);
    }
    let a: Float = channel_tdl_scaled_delay_ns(0.0, 0.0);
    let b: Float = channel_tdl_scaled_delay_ns(0.0, 0.0);
    if a != b {
        println("FAIL channel_tdl_scaled_delay_ns");
        process_exit(1);
    }
    println("prod_channel_3gpp_tapped_delay: PASSED");
}
