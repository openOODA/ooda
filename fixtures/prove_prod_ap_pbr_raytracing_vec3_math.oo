// # Product prove std/pbr_raytracing/vec3_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pbr_raytracing/vec3_math.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/vec3_math.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_vec3_math: PASSED only if they match.

import "std/pbr_raytracing/vec3_math.oo";

pub fn main() {
    let vec3_math_a = vec3_new(0.0, 0.0, 0.0);
    let vec3_math_b = vec3_new(0.0, 0.0, 0.0);
    if vec3_math_a.x != vec3_math_b.x {
        println("FAIL vec3_math");
        process_exit(1);
    }
    println("prod_ap_vec3_math: PASSED");
}
