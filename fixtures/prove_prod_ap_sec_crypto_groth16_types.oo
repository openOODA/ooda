// # Product prove std/sec/crypto/groth16_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/groth16_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_groth16_types: PASSED only if they match.

import "std/sec/crypto/groth16_types.oo";

pub fn main() {
    let groth16_types_a = groth16_setup_new(0, 0);
    let groth16_types_b = groth16_setup_new(0, 0);
    let groth16_types_va = groth16_setup_bytes(groth16_types_a);
    let groth16_types_vb = groth16_setup_bytes(groth16_types_b);
    if groth16_types_va != groth16_types_vb {
        println("FAIL groth16_types");
        process_exit(1);
    }
    println("prod_ap_groth16_types: PASSED");
}
