// # Product prove std/crypto_advanced/bn254_pairing.oo
//
// Logline: Fail-closed emit+gcc+run asserts bn254 pairing operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_pairing.oo.
//
// Beats:
//   1. Generate G1 and G2 generator points and infinity points.
//   2. Compute Miller loop and final exponentiation twice with concrete inputs.
//   3. Compute bn254_pairing and bn254_pairing_check deterministically.
//   4. Print prod_g4_crypto_bn254_pairing: PASSED and exit 0.

import "std/crypto_advanced/bn254_pairing.oo";

pub fn main() {
    let g1_pt: Bn254G1Affine = bn254_g1_generator(1009);
    let g2_pt: Bn254G2Affine = bn254_g2_generator(1009);

    let m1: Bn254MillerResult = bn254_miller_loop(g1_pt, g2_pt);
    let m2: Bn254MillerResult = bn254_miller_loop(g1_pt, g2_pt);
    if (m1).is_valid != (m2).is_valid {
        println("FAIL bn254_miller_loop is_valid mismatch");
        process_exit(1);
    }
    if (((m1).eval_fp2).c0).val != (((m2).eval_fp2).c0).val {
        println("FAIL bn254_miller_loop c0 mismatch");
        process_exit(1);
    }
    if (((m1).eval_fp2).c1).val != (((m2).eval_fp2).c1).val {
        println("FAIL bn254_miller_loop c1 mismatch");
        process_exit(1);
    }

    let p1: Bn254PairingResult = bn254_pairing(g1_pt, g2_pt);
    let p2: Bn254PairingResult = bn254_pairing(g1_pt, g2_pt);
    if (p1).is_valid != (p2).is_valid {
        println("FAIL bn254_pairing is_valid mismatch");
        process_exit(1);
    }
    if (p1).is_unity != (p2).is_unity {
        println("FAIL bn254_pairing is_unity mismatch");
        process_exit(1);
    }

    let chk1: Bool = bn254_pairing_check(g1_pt, g2_pt);
    let chk2: Bool = bn254_pairing_check(g1_pt, g2_pt);
    if chk1 != chk2 || !chk1 {
        println("FAIL bn254_pairing_check mismatch");
        process_exit(1);
    }

    let inf_g1: Bn254G1Affine = bn254_g1_infinity(1009);
    let m_inf: Bn254MillerResult = bn254_miller_loop(inf_g1, g2_pt);
    if (m_inf).is_valid {
        println("FAIL bn254_miller_loop infinity should be invalid");
        process_exit(1);
    }

    println("prod_g4_crypto_bn254_pairing: PASSED");
    process_exit(0);
}
