// # Product prove std/web_ecosystem/template_mustache.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/template_mustache.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/template_mustache.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_template_mustache: PASSED only if they match.

import "std/web_ecosystem/template_mustache.oo";

pub fn main() {
    let template_mustache_a = mustache_find_var(0, 0, 0, 0, 0);
    let template_mustache_b = mustache_find_var(0, 0, 0, 0, 0);
    if template_mustache_a != template_mustache_b {
        println("FAIL template_mustache");
        process_exit(1);
    }
    println("prod_ap_template_mustache: PASSED");
}
