// # Product prove std/synthetic_biology/gene_circuit_bifurcation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gene_circuit_bifurcation_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/gene_circuit_bifurcation.oo.
//
// Beats:
//   1. Call gene_circuit_bifurcation_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_gene_circuit_bifurcation: PASSED only if it matches.

import "std/synthetic_biology/gene_circuit_bifurcation.oo";

pub fn main() {
    let a: Int = gene_circuit_bifurcation_probe();
    if a != 0 {
        println("FAIL gene_circuit_bifurcation_probe");
        process_exit(1);
    }
    println("prod_nc_gene_circuit_bifurcation: PASSED");
}
