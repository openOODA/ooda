// # Product prove std/sec/net/mtls_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts mtls_policy_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_engine.oo.
//
// Beats:
//   1. Call mtls_policy_init using the mtls_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_mtls_engine: PASSED only if asserts hold.

import "std/sec/net/mtls_engine.oo";
import "std/str.oo";

pub fn main() {
    let obj = mtls_policy_init("x", "x", true, 0, true);
    let mtls_engine_a = obj.policy_id;
    let mtls_engine_b = obj.policy_id;
    if chars_len(mtls_engine_a) != chars_len(mtls_engine_b) {
        println("FAIL mtls_policy_init");
        process_exit(1);
    }
    if !str_contains(mtls_engine_a, mtls_engine_b) {
        println("FAIL mtls_policy_init");
        process_exit(1);
    }
    if !str_contains(mtls_engine_b, mtls_engine_a) {
        println("FAIL mtls_policy_init");
        process_exit(1);
    }
    println("prod_mtls_engine: PASSED");
}
