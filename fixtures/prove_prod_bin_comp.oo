// # Product prove binary inspect and compression
//
// Logline: Fail-closed emit+gcc+run drives ELF64, Mach-O, WASM inspectors and Huffman plus LZ77 round-trip.
//
// Setup: Isolated emit-c. Run from ooda/.
//
// Beats:
//   1. ELF64 magic, header, and PT_LOAD count on a synthetic image.
//   2. Mach-O magic plus LC_MAIN and WASM section IDs.
//   3. Huffman encode then decode restores source bytes.
//   4. LZ77 compress then decompress restores source bytes.

import "std/binary_formats/elf64_inspect.oo";
import "std/binary_formats/macho_inspect.oo";
import "std/binary_formats/wasm_inspect.oo";
import "std/compression/huffman_tree.oo";
import "std/compression/lz77_sliding.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn same_ints(a: List[Int], b: List[Int]) -> Bool {
    if list_len(a) != list_len(b) { return false; }
    let mut i: Int = 0;
    while i < list_len(a) {
        if list_get(a, i) != list_get(b, i) { return false; }
        i = i + 1;
    }
    return true;
}

fn unwrap(r: Result[List[Int], String], msg: String) -> List[Int] {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return list_new(); }
    }
}

fn unwrap_i(r: Result[Int, String], msg: String) -> Int {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return 0; }
    }
}

fn unwrap_b(r: Result[Bool, String], msg: String) -> Bool {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return false; }
    }
}

fn zeros(n: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, 0);
        i = i + 1;
    }
    return o;
}

fn put32(mut b: List[Int], o: Int, v: Int) -> List[Int] {
    b = list_set(b, o, v & 255);
    b = list_set(b, o + 1, (v >> 8) & 255);
    b = list_set(b, o + 2, (v >> 16) & 255);
    b = list_set(b, o + 3, (v >> 24) & 255);
    return b;
}

fn prove_elf() {
    let mut b: List[Int] = zeros(120);
    b = list_set(b, 0, 127);
    b = list_set(b, 1, 69);
    b = list_set(b, 2, 76);
    b = list_set(b, 3, 70);
    b = list_set(b, 4, 2);
    b = list_set(b, 5, 1);
    b = put32(b, 32, 64);
    b = list_set(b, 54, 56);
    b = list_set(b, 56, 1);
    b = put32(b, 64, 1);
    if unwrap_b(elf64_inspect_magic_ok(b), "elf magic") == false { fail("elf magic"); }
    let h: List[Int] = unwrap(elf64_inspect_header(b), "elf header");
    if list_get(h, 3) != 64 { fail("elf phoff"); }
    if unwrap_i(elf64_inspect_pt_load(b), "elf pt_load") != 1 { fail("elf PT_LOAD"); }
    println("ELF64 magic header PT_LOAD=1");
}

fn prove_macho() {
    let mut b: List[Int] = zeros(56);
    b = put32(b, 0, macho_inspect_magic());
    b = put32(b, 16, 1);
    b = put32(b, 20, 24);
    b = put32(b, 32, 2147483688);
    b = put32(b, 36, 24);
    let h: List[Int] = unwrap(macho_inspect_header(b), "macho header");
    if list_get(h, 0) != macho_inspect_magic() { fail("macho magic"); }
    let lc: List[Int] = unwrap(macho_inspect_loadcmds(b), "macho cmds");
    if list_get(lc, 1) != 1 { fail("macho LC_MAIN"); }
    println("Mach-O MH_MAGIC_64 LC_MAIN=1");
}

fn prove_wasm() {
    let mut b: List[Int] = list_new();
    b = list_push(b, 0);
    b = list_push(b, 97);
    b = list_push(b, 115);
    b = list_push(b, 109);
    b = list_push(b, 1);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 1);
    b = list_push(b, 1);
    b = list_push(b, 0);
    b = list_push(b, 7);
    b = list_push(b, 1);
    b = list_push(b, 0);
    if unwrap_b(wasm_inspect_header(b), "wasm header") == false { fail("wasm magic"); }
    let seen: List[Int] = unwrap(wasm_inspect_sections(b), "wasm sections");
    if list_get(seen, 1) != 1 { fail("wasm type section"); }
    if list_get(seen, 7) != 1 { fail("wasm export section"); }
    println("WASM magic version sections type+export");
}

fn prove_huff() {
    let mut src: List[Int] = list_new();
    src = list_push(src, 97);
    src = list_push(src, 97);
    src = list_push(src, 98);
    src = list_push(src, 97);
    src = list_push(src, 99);
    let enc: List[Int] = unwrap(huffman_tree_encode(src), "huff encode");
    let dec: List[Int] = unwrap(huffman_tree_decode(enc), "huff decode");
    if same_ints(src, dec) == false { fail("huffman round-trip"); }
    println("Huffman round-trip n=" + list_len(src).to_string());
}

fn prove_lz() {
    let mut src: List[Int] = list_new();
    src = list_push(src, 97);
    src = list_push(src, 98);
    src = list_push(src, 99);
    src = list_push(src, 97);
    src = list_push(src, 98);
    src = list_push(src, 99);
    src = list_push(src, 100);
    let enc: List[Int] = unwrap(lz77_sliding_compress(src), "lz encode");
    let dec: List[Int] = unwrap(lz77_sliding_decompress(enc), "lz decode");
    if same_ints(src, dec) == false { fail("lz77 round-trip"); }
    println("LZ77 round-trip n=" + list_len(src).to_string());
}

pub fn main() {
    prove_elf();
    prove_macho();
    prove_wasm();
    prove_huff();
    prove_lz();
    println("prove_prod_bin_comp: PASSED");
}
