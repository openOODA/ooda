// # Product prove std/protein_folding/md_lincs_constraint_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts lincs_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_lincs_constraint_matrix.oo.
//
// Beats:
//   1. Call lincs_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_lincs_constraint_matrix: PASSED only if they match.

import "std/protein_folding/md_lincs_constraint_matrix.oo";

pub fn main() {
    let a: LincsMatrixParams = lincs_params_default(0);
    let b: LincsMatrixParams = lincs_params_default(0);
    if a.num_bonds != b.num_bonds {
        println("FAIL lincs_params_default");
        process_exit(1);
    }
    println("prod_md_lincs_constraint_matrix: PASSED");
}
