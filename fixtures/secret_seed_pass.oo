// # Allow a public seed argument
//
// Logline: A non-secret value may reach seed while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public seed instead.
//   3. Expect emit to allow the call.

// Secret allow non-secret: seed
// SECRET: token
pub fn main(rnd: &RandCap) {
    let token = 42;
    let public = 7;
    let r = seed(rnd, public);
    println(1);
}
