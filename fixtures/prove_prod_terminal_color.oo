// # Product prove std/os/terminal_color.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_reset is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_color.oo.
//
// Beats:
//   1. Call color_reset twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_color: PASSED only if they match.

import "std/os/terminal_color.oo";

pub fn main() {
    let a = color_reset();
    let b = color_reset();
    if a != b {
        println("FAIL color_reset");
        process_exit(1);
    }
    println("prod_terminal_color: PASSED");
}
