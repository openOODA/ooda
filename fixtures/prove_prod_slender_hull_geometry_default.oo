// # Product prove std/robotics_auv/quadratic_damping_crossflow.oo
//
// Logline: Fail-closed emit+gcc+run asserts slender_hull_geometry_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/quadratic_damping_crossflow.oo.
//
// Beats:
//   1. Call slender_hull_geometry_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slender_hull_geometry_default: PASSED only if they match.

import "std/robotics_auv/quadratic_damping_crossflow.oo";

pub fn main() {
    let quadratic_damping_crossflow_mark: Int = 0;
    if quadratic_damping_crossflow_mark != 0 { process_exit(1); }
    let a: SlenderHullGeometry = slender_hull_geometry_default();
    let b: SlenderHullGeometry = slender_hull_geometry_default();
    if (a).length_m != (b).length_m {
        println("FAIL slender_hull_geometry_default");
        process_exit(1);
    }
    println("prod_slender_hull_geometry_default: PASSED");
}
