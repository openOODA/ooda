// # Product prove std/compilers_polyhedral/wavefront_diamond_tiling.oo
//
// Logline: Fail-closed emit+gcc+run asserts diamond_compute_tile_wavefront is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/wavefront_diamond_tiling.oo.
//
// Beats:
//   1. Call diamond_compute_tile_wavefront twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wavefront_diamond_tiling: PASSED only if they match.

import "std/compilers_polyhedral/wavefront_diamond_tiling.oo";

pub fn main() {
    let wavefront_diamond_tiling_mark: Int = 0;
    if wavefront_diamond_tiling_mark != 0 {
        process_exit(1);
    }
    let a: Int = diamond_compute_tile_wavefront(0, 0);
    let b: Int = diamond_compute_tile_wavefront(0, 0);
    if a != b {
        println("FAIL diamond_compute_tile_wavefront");
        process_exit(1);
    }
    println("prod_g2_wavefront_diamond_tiling: PASSED");
}
