// # Product prove std/db_columnar/columnar_run_length.oo
//
// Logline: Fail-closed emit+gcc+run asserts columnar_rle_encode is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_run_length.oo.
//
// Beats:
//   1. Call columnar_rle_encode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_run_length: PASSED only if they match.

import "std/db_columnar/columnar_run_length.oo";

pub fn main() {
    let columnar_run_length_mark: Int = 0;
    if columnar_run_length_mark != 0 {
        process_exit(1);
    }
    let a: ColumnarRleBlock = columnar_rle_encode(list_new());
    let b: ColumnarRleBlock = columnar_rle_encode(list_new());
    if (a).total_elements != (b).total_elements {
        println("FAIL columnar_rle_encode");
        process_exit(1);
    }
    println("prod_columnar_run_length: PASSED");
}
