// # Product prove std/auto_mpc_control/mpc_tube_robust_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts tube_mpc_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_tube_robust_controller.oo.
//
// Beats:
//   1. Call tube_mpc_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpc_tube_robust_controller: PASSED only if they match.

import "std/auto_mpc_control/mpc_tube_robust_controller.oo";

pub fn main() {
    let mpc_tube_robust_controller_mark: Int = 0;
    if mpc_tube_robust_controller_mark != 0 {
        process_exit(1);
    }
    let a: TubeMPCConfig = tube_mpc_config_default();
    let b: TubeMPCConfig = tube_mpc_config_default();
    if (a).tube_radius_m != (b).tube_radius_m {
        println("FAIL tube_mpc_config_default");
        process_exit(1);
    }
    println("prod_mpc_tube_robust_controller: PASSED");
}
