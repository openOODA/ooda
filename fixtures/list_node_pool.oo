// # List[struct] node pool emit lock
//
// Logline: Fail-closed emit+gcc+run of a Pool whose nodes are List[Item].
//
// Setup: Backend-C. Item is key/val Int. Empty pool, then one push.
//
// Beats:
//   1. Empty pool has list_len 0.
//   2. Push Item { key: 7, val: 3 }; list_len is 1; get key is 7.
//   3. Push a leaf Node { kids: List[Node] }; exit 1 before PASSED on a miss.

type Item = struct {
    key: Int,
    val: Int
};

type Pool = struct {
    nodes: List[Item],
    size: Int
};

type Node = struct {
    id: Int,
    kids: List[Node]
};

pub fn main() {
    let empty: List[Item] = list_new();
    let mut pool: Pool = Pool { nodes: empty, size: 0 };
    if list_len(pool.nodes) != 0 {
        println("FAIL empty len");
        process_exit(1);
    }
    let it: Item = Item { key: 7, val: 3 };
    let grown: List[Item] = list_push(pool.nodes, it);
    pool = Pool { nodes: grown, size: 1 };
    if list_len(pool.nodes) != 1 {
        println("FAIL push len");
        process_exit(1);
    }
    let g: Item = list_get(pool.nodes, 0);
    if g.key != 7 {
        println("FAIL get key");
        process_exit(1);
    }
    if g.val != 3 {
        println("FAIL get val");
        process_exit(1);
    }
    if pool.size != 1 {
        println("FAIL pool size");
        process_exit(1);
    }
    let kids: List[Node] = list_new();
    let leaf: Node = Node { id: 1, kids: kids };
    let mut forest: List[Node] = list_new();
    forest = list_push(forest, leaf);
    if list_len(forest) != 1 {
        println("FAIL leaf len");
        process_exit(1);
    }
    let lg: Node = list_get(forest, 0);
    if lg.id != 1 {
        println("FAIL leaf id");
        process_exit(1);
    }
    if list_len(lg.kids) != 0 {
        println("FAIL leaf kids");
        process_exit(1);
    }
    println("list_node_pool: PASSED");
}
