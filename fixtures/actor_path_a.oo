// M165 path A: thin actor under ThreadCap (spawn + mailbox send/recv)
pub fn main(thread: &ThreadCap) {
    let a: Result[String, String] = actor_spawn(thread, "worker");
    if a.is_ok() {
        let s: Result[String, String] = actor_send(thread, 0, "ping");
        if s.is_ok() {
            let m: Result[String, String] = actor_recv(thread, 0);
            if m.is_ok() {
                // match avoids unwrap-ternary println type residual
                match m {
                    Ok(msg) => println(msg),
                    Err(e) => println(e),
                };
            } else {
                println("recv-fail");
            }
        } else {
            println("send-fail");
        }
    } else {
        println("spawn-fail");
    }
}
