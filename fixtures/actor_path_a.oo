// # Smoke thin actor mailbox
//
// Logline: Spawn a worker under ThreadCap and ping its mailbox.
//
// Setup: M165 path A; spawn, send, and recv return Result.
//
// Beats:
//   1. actor_spawn a worker.
//   2. actor_send "ping" and actor_recv.
//   3. Match the message or print the fail arm.

pub fn main(thread: &ThreadCap) {
    let a: Result[String, String] = actor_spawn(thread, "worker");
    if a.is_ok() {
        let s: Result[String, String] = actor_send(thread, 0, "ping");
        if s.is_ok() {
            let m: Result[String, String] = actor_recv(thread, 0);
            if m.is_ok() {
                // match avoids unwrap-ternary println type residual
                match m {
                    Ok(msg) => println(msg),
                    Err(e) => println(e),
                };
            } else {
                println("recv-fail");
            }
        } else {
            println("send-fail");
        }
    } else {
        println("spawn-fail");
    }
}
