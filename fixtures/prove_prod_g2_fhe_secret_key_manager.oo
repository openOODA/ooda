// # Product prove std/fhe_lattices/fhe_secret_key_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts secret_key_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_secret_key_manager.oo.
//
// Beats:
//   1. Call secret_key_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_secret_key_manager: PASSED only if they match.

import "std/fhe_lattices/fhe_secret_key_manager.oo";

pub fn main() {
    let fhe_secret_key_manager_mark: Int = 0;
    if fhe_secret_key_manager_mark != 0 {
        process_exit(1);
    }
    let a: SecretKeyManager = secret_key_manager_new(list_new(), 0, 0, 0);
    let b: SecretKeyManager = secret_key_manager_new(list_new(), 0, 0, 0);
    if (a).degree_n != (b).degree_n {
        println("FAIL secret_key_manager_new");
        process_exit(1);
    }
    println("prod_g2_fhe_secret_key_manager: PASSED");
}
