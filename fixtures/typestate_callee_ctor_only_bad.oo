// # Callee constructor only
//
// Logline: wrap promises Closed to Open but only constructs a fresh sock.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap opens a different sock and ignores the parameter.
//   3. The caller's sock never transitions.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }

fn wrap(s: Int) {
    let t = open_sock();
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
