// # RHS ctor is not a match arm
//
// Logline: Check refuses Flag match On => Off; Off after => does not cover Off.
//
// Setup: type Flag = On | Off. Exhaust reads patterns, not arm bodies.
//
// Beats:
//   1. Pattern is On only.
//   2. Off appears only after =>.
//   3. check must ERR needing Off.

type Flag = On | Off;

pub fn main() {
    let a: Flag = On;
    let v: Flag = match a {
        On => Off
    };
}
