// # Product prove std/db_columnar/columnar_delta_lake_metadata.oo
//
// Logline: Fail-closed verification that Delta Lake / Iceberg table snapshot commit logs and add/remove file actions are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_delta_lake_metadata.oo.
//
// Beats:
//   1. Initialize DeltaTableSnapshot at version 0.
//   2. Apply DeltaAddFileAction and assert record and byte count accumulation.
//   3. Apply removal action and assert version bump and state reconciliation.
//   4. Print prod_g4_db_delta_lake: PASSED and exit 0.

import "std/db_columnar/columnar_delta_lake_metadata.oo";

pub fn main() {
    let snap0: DeltaTableSnapshot = delta_table_snapshot_new(0);
    if snap0.table_version != 0 || snap0.active_files_count != 0 || snap0.total_records != 0 {
        println("FAIL delta_table_snapshot_new");
        process_exit(1);
    }

    let file1: DeltaAddFileAction = DeltaAddFileAction {
        path: "part-00000.parquet",
        size_bytes: 204800,
        modification_time: 1700000000,
        data_change: true,
        num_records: 5000
    };

    let file2: DeltaAddFileAction = DeltaAddFileAction {
        path: "part-00001.parquet",
        size_bytes: 409600,
        modification_time: 1700000100,
        data_change: true,
        num_records: 10000
    };

    let snap1: DeltaTableSnapshot = delta_snapshot_add_file(snap0, file1);
    let snap2: DeltaTableSnapshot = delta_snapshot_add_file(snap1, file2);

    if snap2.active_files_count != 2 || snap2.total_records != 15000 || snap2.total_size_bytes != 614400 {
        println("FAIL delta_snapshot_add_file accumulation");
        process_exit(1);
    }

    let snap3: DeltaTableSnapshot = delta_snapshot_remove_file(snap2, 5000, 204800);
    if snap3.table_version != 1 || snap3.active_files_count != 1 || snap3.total_records != 10000 || snap3.total_size_bytes != 409600 {
        println("FAIL delta_snapshot_remove_file");
        process_exit(1);
    }

    println("prod_g4_db_delta_lake: PASSED");
    process_exit(0);
}
