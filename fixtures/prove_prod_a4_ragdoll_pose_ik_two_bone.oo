// # Product prove std/physics_advanced/ragdoll_pose_ik_two_bone.oo
//
// Logline: Fail-closed emit+gcc+run asserts two_bone_limb_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/ragdoll_pose_ik_two_bone.oo.
//
// Beats:
//   1. Call two_bone_limb_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ragdoll_pose_ik_two_bone: PASSED only if they match.

import "std/physics_advanced/ragdoll_pose_ik_two_bone.oo";

pub fn main() {
    let ragdoll_pose_ik_two_bone_mark: Int = 0;
    if ragdoll_pose_ik_two_bone_mark != 0 {
        process_exit(1);
    }
    let a: TwoBoneLimb = two_bone_limb_new(0.0, 0.0);
    let b: TwoBoneLimb = two_bone_limb_new(0.0, 0.0);
    if (a).length_1 != (b).length_1 {
        println("FAIL two_bone_limb_new");
        process_exit(1);
    }
    println("prod_ragdoll_pose_ik_two_bone: PASSED");
}
