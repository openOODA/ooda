// # Product prove std/exploit_analysis/kernel_page_table_isolation_kpti.oo
//
// Logline: Fail-closed emit+gcc+run asserts kpti_switch_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/kernel_page_table_isolation_kpti.oo.
//
// Beats:
//   1. Call kpti_switch_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_page_table_isolation_kpti: PASSED only if they match.

import "std/exploit_analysis/kernel_page_table_isolation_kpti.oo";

pub fn main() {
    let kernel_page_table_isolation_kpti_mark: Int = 0;
    if kernel_page_table_isolation_kpti_mark != 0 {
        process_exit(1);
    }
    let a: KptiCr3SwitchState = kpti_switch_state_new(0);
    let b: KptiCr3SwitchState = kpti_switch_state_new(0);
    if (a).kernel_cr3 != (b).kernel_cr3 {
        println("FAIL kpti_switch_state_new");
        process_exit(1);
    }
    println("prod_kernel_page_table_isolation_kpti: PASSED");
}
