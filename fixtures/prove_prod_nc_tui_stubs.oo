// # Product prove std/tui/tui_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_stubs_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/tui/tui_stubs.oo.
//
// Beats:
//   1. Call tui_stubs_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_tui_stubs: PASSED only if it matches.

import "std/tui/tui_stubs.oo";

pub fn main() {
    let a: Int = tui_stubs_probe();
    if a != 0 {
        println("FAIL tui_stubs_probe");
        process_exit(1);
    }
    println("prod_nc_tui_stubs: PASSED");
}
