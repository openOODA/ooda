// # Product prove std/crispr_cas/mmej_indelphi_prediction.oo
//
// Logline: Fail-closed emit+gcc+run asserts indelphi_predict_cut is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/mmej_indelphi_prediction.oo.
//
// Beats:
//   1. Call indelphi_predict_cut twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mmej_indelphi_prediction: PASSED only if they match.

import "std/crispr_cas/mmej_indelphi_prediction.oo";

pub fn main() {
    let mmej_indelphi_prediction_mark: Int = 0;
    if mmej_indelphi_prediction_mark != 0 {
        process_exit(1);
    }
    let a: IndelphiSummary = indelphi_predict_cut("x");
    let b: IndelphiSummary = indelphi_predict_cut("x");
    if (a).highest_frequency_pct != (b).highest_frequency_pct {
        println("FAIL indelphi_predict_cut");
        process_exit(1);
    }
    println("prod_mmej_indelphi_prediction: PASSED");
}
