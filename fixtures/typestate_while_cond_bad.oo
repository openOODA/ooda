// # Connect in a while condition
//
// Logline: Call connect as the while condition so the second test starts from Open.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Use connect(s) as the while condition.
//   3. Leave the body as a dummy bind.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) -> Bool { return true; }

pub fn main() {
    let s = open_sock();
    while connect(s) {
        let z = 0;
    }
}
