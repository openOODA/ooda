// # Product prove std/robotics_auv/hydrodynamic_suction_bernoulli.oo
//
// Logline: Fail-closed emit+gcc+run asserts bsuc_isqrt_seed is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/hydrodynamic_suction_bernoulli.oo.
//
// Beats:
//   1. Call bsuc_isqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hydrodynamic_suction_bernoulli: PASSED only if they match.

import "std/robotics_auv/hydrodynamic_suction_bernoulli.oo";

pub fn main() {
    let hydrodynamic_suction_bernoulli_mark: Int = 0;
    if hydrodynamic_suction_bernoulli_mark != 0 {
        process_exit(1);
    }
    let a: Int = bsuc_isqrt_seed(0, 0);
    let b: Int = bsuc_isqrt_seed(0, 0);
    if a != b {
        println("FAIL bsuc_isqrt_seed");
        process_exit(1);
    }
    println("prod_g2_hydrodynamic_suction_bernoulli: PASSED");
}
