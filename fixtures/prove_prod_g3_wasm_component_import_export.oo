// # Product prove std/wasm_gc/wasm_component_import_export.oo
//
// Logline: Fail-closed emit+gcc+run asserts comp_item_desc_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_import_export.oo.
//
// Beats:
//   1. Call comp_item_desc_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_import_export: PASSED only if they match.

import "std/wasm_gc/wasm_component_import_export.oo";

pub fn main() {
    let wasm_component_import_export_mark: Int = 0;
    if wasm_component_import_export_mark != 0 {
        process_exit(1);
    }
    let a: ComponentItemDesc = comp_item_desc_new(0, 0);
    let b: ComponentItemDesc = comp_item_desc_new(0, 0);
    if (a).item_kind != (b).item_kind {
        println("FAIL comp_item_desc_new");
        process_exit(1);
    }
    println("prod_wasm_component_import_export: PASSED");
}
