// # Product prove std/scicomp/optimize_lbfgs.oo
//
// Logline: Fail-closed emit+gcc+run asserts lbfgs_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/optimize_lbfgs.oo.
//
// Beats:
//   1. Call lbfgs_config_default using the optimize_lbfgs ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_optimize_lbfgs: PASSED only if asserts hold.

import "std/scicomp/optimize_lbfgs.oo";

pub fn main() {
    let obj = lbfgs_config_default();
    let optimize_lbfgs_a = obj.max_iters;
    if optimize_lbfgs_a != 200 {
        println("FAIL lbfgs_config_default");
        process_exit(1);
    }
    println("prod_optimize_lbfgs: PASSED");
}
