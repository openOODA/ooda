// # Product prove std/quantum_topological/kitaev_honeycomb_non_abelian_phase.oo
//
// Logline: Fail-closed emit+gcc+run asserts non_abelian_majorana_mass_gap is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/kitaev_honeycomb_non_abelian_phase.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call non_abelian_majorana_mass_gap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_kitaev_honeycomb_non_abelian_phase: PASSED only if they match.

import "std/quantum_topological/kitaev_honeycomb_non_abelian_phase.oo";

pub fn main() {
    let g0_oa: NonAbelianPhaseModel = NonAbelianPhaseModel { exchange_j: 1.0, magnetic_field_hx: 1.0, magnetic_field_hy: 1.0, magnetic_field_hz: 1.0, kappa_coupling: 1.0, chern_number: 2, // nu = +1 or -1
    chiral_central_charge: 1.0 };
    let g0_ob: NonAbelianPhaseModel = NonAbelianPhaseModel { exchange_j: 1.0, magnetic_field_hx: 1.0, magnetic_field_hy: 1.0, magnetic_field_hz: 1.0, kappa_coupling: 1.0, chern_number: 2, // nu = +1 or -1
    chiral_central_charge: 1.0 };
    let g0_a = non_abelian_majorana_mass_gap(&g0_oa);
    let g0_b = non_abelian_majorana_mass_gap(&g0_ob);
    if g0_a != g0_b {
        println("FAIL non_abelian_majorana_mass_gap");
        process_exit(1);
    }
    println("prod_g0_kitaev_honeycomb_non_abelian_phase: PASSED");
}
