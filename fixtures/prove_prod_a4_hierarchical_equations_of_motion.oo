// # Product prove std/quantum_open_systems/hierarchical_equations_of_motion.oo
//
// Logline: Fail-closed emit+gcc+run asserts heom_c_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/hierarchical_equations_of_motion.oo.
//
// Beats:
//   1. Call heom_c_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hierarchical_equations_of_motion: PASSED only if they match.

import "std/quantum_open_systems/hierarchical_equations_of_motion.oo";

pub fn main() {
    let hierarchical_equations_of_motion_mark: Int = 0;
    if hierarchical_equations_of_motion_mark != 0 {
        process_exit(1);
    }
    let a: Complex = heom_c_new(0.0, 0.0);
    let b: Complex = heom_c_new(0.0, 0.0);
    if (a).real != (b).real {
        println("FAIL heom_c_new");
        process_exit(1);
    }
    println("prod_hierarchical_equations_of_motion: PASSED");
}
