// # Product prove std/aero/formation_ops.oo
//
// Logline: Fail-closed verification that formation relative orbit operations and geometry models are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_ops.oo.
//
// Beats:
//   1. Verify math constants and trigonometric helper functions.
//   2. Construct and verify RelativeState, ChiefOrbitParams, and HCW data structures.
//   3. Assert deterministic formation geometry and maneuver outputs.
//   4. Print prod_g4_aero_formation_ops: PASSED and exit 0.

import "std/aero/formation_ops.oo";

pub fn main() {
    let formation_ops_mark: Int = 0;
    if formation_ops_mark != 0 {
        process_exit(1);
    }

    let pi_a: Float = math_pi();
    let pi_b: Float = math_pi();
    if pi_a != pi_b {
        println("FAIL math_pi");
        process_exit(1);
    }

    let abs_val: Float = math_abs(0.0 - 5.5);
    if abs_val != 5.5 {
        println("FAIL math_abs");
        process_exit(1);
    }

    let atan_val_a: Float = math_atan2(1.0, 1.0);
    let atan_val_b: Float = math_atan2(1.0, 1.0);
    if atan_val_a != atan_val_b {
        println("FAIL math_atan2");
        process_exit(1);
    }

    let flt: Float = int_to_float(42);
    if flt != 42.0 {
        println("FAIL int_to_float");
        process_exit(1);
    }

    let v: Vec3 = vec3_new(1.0, 2.0, 3.0);
    let s: RelativeState = relative_state_new(v, v, 10.0);
    if (s).epoch_sec != 10.0 {
        println("FAIL relative_state_new");
        process_exit(1);
    }

    let cp_a: ChiefOrbitParams = chief_params_new(7000000.0, 0.001, 398600441800000.0);
    let cp_b: ChiefOrbitParams = chief_params_new(7000000.0, 0.001, 398600441800000.0);
    if (cp_a).semi_major_axis != (cp_b).semi_major_axis || (cp_a).mean_motion != (cp_b).mean_motion {
        println("FAIL chief_params_new");
        process_exit(1);
    }

    let hcw: HillClohessyWiltshire = hcw_new(0.001, 7000000.0, 0.0);
    if (hcw).chief_mean_motion != 0.001 || (hcw).chief_radius != 7000000.0 {
        println("FAIL hcw_new");
        process_exit(1);
    }

    let geom: FormationGeometry = formation_geometry_new(1, 100.0, 50.0, 25.0, 0.0, 10.0);
    if (geom).geometry_type != 1 || (geom).semi_major_axis_rel != 100.0 {
        println("FAIL formation_geometry_new");
        process_exit(1);
    }

    let r: RelativeKeplerianElements = roe_new(10.0, 0.001, 0.002, 0.0001, 0.0002, 0.05);
    if (r).delta_a != 10.0 || (r).delta_lambda != 0.05 {
        println("FAIL roe_new");
        process_exit(1);
    }

    let m_a: FormationManeuver = formation_maneuver_new(v, v, 100.0);
    let m_b: FormationManeuver = formation_maneuver_new(v, v, 100.0);
    if (m_a).total_delta_v != (m_b).total_delta_v || (m_a).maneuver_time_sec != (m_b).maneuver_time_sec {
        println("FAIL formation_maneuver_new");
        process_exit(1);
    }

    println("prod_g4_aero_formation_ops: PASSED");
    process_exit(0);
}
