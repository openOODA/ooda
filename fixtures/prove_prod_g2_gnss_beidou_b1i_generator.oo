// # Product prove std/satellite_dvb/gnss_beidou_b1i_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts beidou_prn_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_beidou_b1i_generator.oo.
//
// Beats:
//   1. Call beidou_prn_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_beidou_b1i_generator: PASSED only if they match.

import "std/satellite_dvb/gnss_beidou_b1i_generator.oo";

pub fn main() {
    let gnss_beidou_b1i_generator_mark: Int = 0;
    if gnss_beidou_b1i_generator_mark != 0 {
        process_exit(1);
    }
    let a: BeidouPrnConfig = beidou_prn_config_new(0);
    let b: BeidouPrnConfig = beidou_prn_config_new(0);
    if (a).sv_id != (b).sv_id {
        println("FAIL beidou_prn_config_new");
        process_exit(1);
    }
    println("prod_g2_gnss_beidou_b1i_generator: PASSED");
}
