// # Product prove std/simd/simd_simplex_noise.oo
//
// Logline: Fail-closed emit+gcc+run asserts simplex_noise2d is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_simplex_noise.oo.
//
// Beats:
//   1. Call simplex_noise2d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_simplex_noise: PASSED only if they match.

import "std/simd/simd_simplex_noise.oo";

pub fn main() {
    let a = simplex_noise2d(0.0, 0.0);
    let b = simplex_noise2d(0.0, 0.0);
    if a != b {
        println("FAIL simplex_noise2d");
        process_exit(1);
    }
    println("prod_simd_simplex_noise: PASSED");
}
