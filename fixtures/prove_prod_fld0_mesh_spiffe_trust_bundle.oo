// # Product prove std/mesh_ebpf/mesh_spiffe_trust_bundle.oo
//
// Logline: Fail-closed emit+gcc+run asserts spiffe_validate_issuer is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_spiffe_trust_bundle.oo.
//
// Beats:
//   1. Call spiffe_validate_issuer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_spiffe_trust_bundle: PASSED only if they match.

import "std/mesh_ebpf/mesh_spiffe_trust_bundle.oo";

pub fn main() {
    let mesh_spiffe_trust_bundle_mark: Int = 0;
    if mesh_spiffe_trust_bundle_mark != 0 {
        process_exit(1);
    }
    let mesh_spiffe_trust_bundle_obj: SpiffeTrustStore = spiffe_trust_store_new();
    let mesh_spiffe_trust_bundle_a: Bool = spiffe_validate_issuer(&mesh_spiffe_trust_bundle_obj, "x", 1, 1);
    let mesh_spiffe_trust_bundle_b: Bool = spiffe_validate_issuer(&mesh_spiffe_trust_bundle_obj, "x", 1, 1);
    if mesh_spiffe_trust_bundle_a != mesh_spiffe_trust_bundle_b {
        println("FAIL spiffe_validate_issuer");
        process_exit(1);
    }
    println("prod_mesh_spiffe_trust_bundle: PASSED");
}
