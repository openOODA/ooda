// # Product prove std/telecom_6g/noma_successive_interference_cancel.oo
//
// Logline: Fail-closed verification that NOMA power allocation, SIC decoding, and rate evaluations are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/noma_successive_interference_cancel.oo.
//
// Beats:
//   1. Construct default 2-user power-domain NOMA configuration.
//   2. Evaluate achievable rates under successive interference cancellation.
//   3. Compare NOMA sum rate against orthogonal OMA baseline.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_noma: PASSED and exit 0.

import "std/telecom_6g/noma_successive_interference_cancel.oo";

pub fn main() {
    let cfg_a: NomaUserPairConfig = noma_config_default();
    let cfg_b: NomaUserPairConfig = noma_config_default();

    if (cfg_a).near_user_channel_gain_sq != (cfg_b).near_user_channel_gain_sq || (cfg_a).near_user_channel_gain_sq != 1.0 {
        println("FAIL noma_config_default near_user_channel_gain_sq");
        process_exit(1);
    }

    if (cfg_a).far_user_channel_gain_sq != (cfg_b).far_user_channel_gain_sq || (cfg_a).far_user_channel_gain_sq != 0.1 {
        println("FAIL noma_config_default far_user_channel_gain_sq");
        process_exit(1);
    }

    let res_a: NomaRateResult = noma_eval_rates(cfg_a);
    let res_b: NomaRateResult = noma_eval_rates(cfg_b);

    if (res_a).near_user_rate_bps_hz != (res_b).near_user_rate_bps_hz {
        println("FAIL noma_eval_rates near_user_rate_bps_hz");
        process_exit(1);
    }

    if (res_a).far_user_rate_bps_hz != (res_b).far_user_rate_bps_hz {
        println("FAIL noma_eval_rates far_user_rate_bps_hz");
        process_exit(1);
    }

    if (res_a).noma_sum_rate_bps_hz != (res_b).noma_sum_rate_bps_hz {
        println("FAIL noma_eval_rates noma_sum_rate_bps_hz");
        process_exit(1);
    }

    if (res_a).oma_sum_rate_bps_hz != (res_b).oma_sum_rate_bps_hz {
        println("FAIL noma_eval_rates oma_sum_rate_bps_hz");
        process_exit(1);
    }

    println("prod_g4_telecom_noma: PASSED");
    process_exit(0);
}
