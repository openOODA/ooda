// # Product prove std/astro_advanced/attitude_magnetorquer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/attitude_magnetorquer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_magnetorquer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_magnetorquer: PASSED only if they match.

import "std/astro_advanced/attitude_magnetorquer.oo";

pub fn main() {
    let attitude_magnetorquer_a = mag_dipole(0);
    let attitude_magnetorquer_b = mag_dipole(0);
    if attitude_magnetorquer_a != attitude_magnetorquer_b {
        println("FAIL attitude_magnetorquer");
        process_exit(1);
    }
    println("prod_ap_attitude_magnetorquer: PASSED");
}
