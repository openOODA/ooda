// # Product prove std/crispr_cas/crispr_aav_packaging_payload.oo
//
// Logline: Fail-closed emit+gcc+run asserts crispr_aav_packaging_payload_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_aav_packaging_payload.oo.
//
// Beats:
//   1. Call crispr_aav_packaging_payload_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_aav_packaging_payload: PASSED only if they match.

import "std/crispr_cas/crispr_aav_packaging_payload.oo";

pub fn main() {
    let a: Int = crispr_aav_packaging_payload_probe();
    let b: Int = crispr_aav_packaging_payload_probe();
    if a != b {
        println("FAIL crispr_aav_packaging_payload_probe");
        process_exit(1);
    }
    println("prod_g2_crispr_aav_packaging_payload: PASSED");
}
