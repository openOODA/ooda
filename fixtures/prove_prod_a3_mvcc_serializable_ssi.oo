// # Product prove std/db_storage/mvcc_serializable_ssi.oo
//
// Logline: Fail-closed emit+gcc+run asserts ssi_tracker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_serializable_ssi.oo.
//
// Beats:
//   1. Call ssi_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_serializable_ssi: PASSED only if they match.

import "std/db_storage/mvcc_serializable_ssi.oo";

pub fn main() {
    let mvcc_serializable_ssi_mark: Int = 0;
    if mvcc_serializable_ssi_mark != 0 {
        process_exit(1);
    }
    let a: SsiTracker = ssi_tracker_new();
    let b: SsiTracker = ssi_tracker_new();
    if (a).aborted_tx_count != (b).aborted_tx_count {
        println("FAIL ssi_tracker_new");
        process_exit(1);
    }
    println("prod_mvcc_serializable_ssi: PASSED");
}
