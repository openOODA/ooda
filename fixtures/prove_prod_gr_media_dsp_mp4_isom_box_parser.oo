// # Product prove std/media_dsp/mp4_isom_box_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts isom_box_ftyp is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/mp4_isom_box_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call isom_box_ftyp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_mp4_isom_box_parser: PASSED only if they match.

import "std/media_dsp/mp4_isom_box_parser.oo";

pub fn main() {
    let g0_a = isom_box_ftyp();
    let g0_b = isom_box_ftyp();
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL isom_box_ftyp");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL isom_box_ftyp");
        process_exit(1);
    }
    println("prod_gr_mp4_isom_box_parser: PASSED");
}
