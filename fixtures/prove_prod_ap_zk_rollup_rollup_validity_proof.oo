// # Product prove std/zk_rollup/rollup_validity_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_validity_proof.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_validity_proof.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_validity_proof: PASSED only if they match.

import "std/zk_rollup/rollup_validity_proof.oo";

pub fn main() {
    let rollup_validity_proof_a = validity_proof_envelope_new(0, 0, 0, 0, 0);
    let rollup_validity_proof_b = validity_proof_envelope_new(0, 0, 0, 0, 0);
    if rollup_validity_proof_a.proof_system_tag != rollup_validity_proof_b.proof_system_tag {
        println("FAIL rollup_validity_proof");
        process_exit(1);
    }
    println("prod_ap_rollup_validity_proof: PASSED");
}
