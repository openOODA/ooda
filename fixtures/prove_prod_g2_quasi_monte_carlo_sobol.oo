// # Product prove std/scicomp/quasi_monte_carlo_sobol.oo
//
// Logline: Fail-closed emit+gcc+run asserts gray_code is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/quasi_monte_carlo_sobol.oo.
//
// Beats:
//   1. Call gray_code twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quasi_monte_carlo_sobol: PASSED only if they match.

import "std/scicomp/quasi_monte_carlo_sobol.oo";

pub fn main() {
    let quasi_monte_carlo_sobol_mark: Int = 0;
    if quasi_monte_carlo_sobol_mark != 0 {
        process_exit(1);
    }
    let a: Int = gray_code(0);
    let b: Int = gray_code(0);
    if a != b {
        println("FAIL gray_code");
        process_exit(1);
    }
    println("prod_g2_quasi_monte_carlo_sobol: PASSED");
}
