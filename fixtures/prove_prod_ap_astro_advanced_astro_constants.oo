// # Product prove std/astro_advanced/astro_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/astro_constants.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/astro_constants.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_astro_constants: PASSED only if they match.

import "std/astro_advanced/astro_constants.oo";

pub fn main() {
    let astro_constants_a = astro_adv_c();
    let astro_constants_b = astro_adv_c();
    if astro_constants_a != astro_constants_b {
        println("FAIL astro_constants");
        process_exit(1);
    }
    println("prod_ap_astro_constants: PASSED");
}
