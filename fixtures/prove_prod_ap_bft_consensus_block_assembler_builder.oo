// # Product prove std/bft_consensus/block_assembler_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/block_assembler_builder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/block_assembler_builder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_block_assembler_builder: PASSED only if they match.

import "std/bft_consensus/block_assembler_builder.oo";

pub fn main() {
    let block_assembler_builder_a = block_builder_new(0, 0, 0);
    let block_assembler_builder_b = block_builder_new(0, 0, 0);
    let block_assembler_builder_va = block_builder_can_fit(block_assembler_builder_a, 0, 0);
    let block_assembler_builder_vb = block_builder_can_fit(block_assembler_builder_b, 0, 0);
    if block_assembler_builder_va != block_assembler_builder_vb {
        println("FAIL block_assembler_builder");
        process_exit(1);
    }
    println("prod_ap_block_assembler_builder: PASSED");
}
