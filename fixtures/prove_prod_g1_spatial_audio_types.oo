// # Product prove std/3d/spatial_audio_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_source_volume is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/spatial_audio_types.oo.
//
// Beats:
//   1. Call audio_source_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_audio_types: PASSED only if they match.

import "std/3d/spatial_audio_types.oo";

pub fn main() {
    let obj_a: AudioSource = audio_source_new(0, 0, 0, 0);
    let obj_b: AudioSource = audio_source_new(0, 0, 0, 0);
    let a: Int = audio_source_volume(obj_a);
    let b: Int = audio_source_volume(obj_b);
    if a != b {
        println("FAIL audio_source_volume");
        process_exit(1);
    }
    println("prod_spatial_audio_types: PASSED");
}
