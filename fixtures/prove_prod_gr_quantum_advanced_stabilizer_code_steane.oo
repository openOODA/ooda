// # Product prove std/quantum_advanced/stabilizer_code_steane.oo
//
// Logline: Fail-closed emit+gcc+run asserts steane_syndrome_to_error_location is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/stabilizer_code_steane.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call steane_syndrome_to_error_location twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_stabilizer_code_steane: PASSED only if they match.

import "std/quantum_advanced/stabilizer_code_steane.oo";

pub fn main() {
    let g0_oa: SteaneSyndrome = SteaneSyndrome { s0: 0, s1: 0, s2: 0 };
    let g0_ob: SteaneSyndrome = SteaneSyndrome { s0: 0, s1: 0, s2: 0 };
    let g0_a = steane_syndrome_to_error_location(&g0_oa);
    let g0_b = steane_syndrome_to_error_location(&g0_ob);
    if g0_a != g0_b {
        println("FAIL steane_syndrome_to_error_location");
        process_exit(1);
    }
    println("prod_gr_stabilizer_code_steane: PASSED");
}
