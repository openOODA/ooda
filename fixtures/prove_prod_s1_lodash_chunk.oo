// # Product prove std/web_ecosystem/lodash_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts lodash_chunk_n is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_chunk.oo.
//
// Beats:
//   1. Call lodash_chunk_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lodash_chunk: PASSED only if they match.

import "std/web_ecosystem/lodash_chunk.oo";

pub fn main() {
    let lodash_chunk_mark: Int = 0;
    if lodash_chunk_mark != 0 {
        process_exit(1);
    }
    let lodash_chunk_a: Int = lodash_chunk_n(1, 1);
    let lodash_chunk_b: Int = lodash_chunk_n(1, 1);
    if lodash_chunk_a != lodash_chunk_b {
        println("FAIL lodash_chunk_n");
        process_exit(1);
    }
    println("prod_lodash_chunk: PASSED");
}
