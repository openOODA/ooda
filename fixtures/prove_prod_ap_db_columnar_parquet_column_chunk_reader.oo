// # Product prove std/db_columnar/parquet_column_chunk_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_column_chunk_reader.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_column_chunk_reader.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_parquet_column_chunk_reader: PASSED only if they match.

import "std/db_columnar/parquet_column_chunk_reader.oo";

pub fn main() {
    let parquet_column_chunk_reader_a = column_chunk_reader_new("x", 0, 0);
    let parquet_column_chunk_reader_b = column_chunk_reader_new("x", 0, 0);
    if parquet_column_chunk_reader_a.column_name != parquet_column_chunk_reader_b.column_name {
        println("FAIL parquet_column_chunk_reader");
        process_exit(1);
    }
    println("prod_ap_parquet_column_chunk_reader: PASSED");
}
