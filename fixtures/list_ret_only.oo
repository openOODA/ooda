// # Empty list return
//
// Logline: Return a fresh List[String] and print its length.
//
// Beats:
//   1. empty returns list_new().
//   2. Bind the result in main.
//   3. Print list_len 0.

pub fn empty() -> List[String] {
    return list_new();
}
pub fn main() {
    let x = empty();
    println(list_len(x));
}
