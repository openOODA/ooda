// # Product prove std/telecom_5g/ofdm_sync_correlation.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_calc_pci is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_sync_correlation.oo.
//
// Beats:
//   1. Call nr5g_calc_pci twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ofdm_sync_correlation: PASSED only if they match.

import "std/telecom_5g/ofdm_sync_correlation.oo";

pub fn main() {
    let ofdm_sync_correlation_mark: Int = 0;
    if ofdm_sync_correlation_mark != 0 {
        process_exit(1);
    }
    let a: Int = nr5g_calc_pci(0, 0);
    let b: Int = nr5g_calc_pci(0, 0);
    if a != b {
        println("FAIL nr5g_calc_pci");
        process_exit(1);
    }
    println("prod_ofdm_sync_correlation: PASSED");
}
