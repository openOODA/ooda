// # Product prove contract theorem prover
//
// Logline: Fail-closed emit+gcc+run drives the shipped WP+DPLL prover on a holding Hoare triple and a broken one.
//
// Setup: Isolated emit-c. Imports std/formal_verif/contract_prover_engine.oo.
//
// Beats:
//   1. Prove requires x > 0; x = x + 1; y = x * 2; ensures y >= 4 is Ok.
//   2. Prove ensures y >= 20 and y >= 100 are Err with x > 0 (not a forced x=hi).
//   3. Print prove_prod_contract_prover: PASSED only if those checks hold.

import "std/formal_verif/contract_prover_engine.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let pre: RelAtom = rel_gt(lin_term(1, 0, 0));
    let post: RelAtom = rel_ge(lin_term(0, 1, -4));
    let mut steps: List[AssignStep] = list_new();
    steps = list_push(steps, assign_x(lin_term(1, 0, 1)));
    steps = list_push(steps, assign_y(lin_term(2, 0, 0)));
    let wp_shown: RelAtom = wp_backwards(steps, post);
    let wp_txt: String = rel_text(wp_shown);
    if chars_len(wp_txt) < 1 {
        fail("empty wp");
    }
    let hold: ProveOutcome = contract_prover_engine_prove("obj-hold", pre, steps, post);
    if (hold).passed == false {
        fail("holding should be Ok");
    }
    if (hold).cert.holds == false {
        fail("holding cert.holds");
    }
    let mid: RelAtom = rel_ge(lin_term(0, 1, -20));
    let mid_out: ProveOutcome = contract_prover_engine_prove("obj-y20", pre, steps, mid);
    if (mid_out).passed {
        fail("y>=20 should be Err");
    }
    if list_len((mid_out).cex.model) < 1 {
        fail("y>=20 empty counterexample assignment");
    }
    if (mid_out).cex.x_val <= 0 {
        fail("y>=20 cex x_val must satisfy x > 0");
    }
    if (mid_out).cex.x_val >= 9 {
        fail("y>=20 cex must violate WP x>=9");
    }
    let bad: RelAtom = rel_ge(lin_term(0, 1, -100));
    let brk: ProveOutcome = contract_prover_engine_prove("obj-break", pre, steps, bad);
    if (brk).passed {
        fail("broken post should be Err");
    }
    if list_len((brk).cex.model) < 1 {
        fail("empty counterexample assignment");
    }
    if (brk).cex.x_val <= 0 {
        fail("cex x_val must satisfy x > 0");
    }
    println("prove_prod_contract_prover: PASSED");
}
