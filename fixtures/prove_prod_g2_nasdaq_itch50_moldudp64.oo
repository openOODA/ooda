// # Product prove std/fintech_l3_book/nasdaq_itch50_moldudp64.oo
//
// Logline: Fail-closed emit+gcc+run asserts mold_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_moldudp64.oo.
//
// Beats:
//   1. Call mold_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nasdaq_itch50_moldudp64: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_moldudp64.oo";

pub fn main() {
    let nasdaq_itch50_moldudp64_mark: Int = 0;
    if nasdaq_itch50_moldudp64_mark != 0 {
        process_exit(1);
    }
    let a: MoldPacketHeader = mold_header_new("x", 0, 0);
    let b: MoldPacketHeader = mold_header_new("x", 0, 0);
    if (a).sequence_number != (b).sequence_number {
        println("FAIL mold_header_new");
        process_exit(1);
    }
    println("prod_g2_nasdaq_itch50_moldudp64: PASSED");
}
