// # Product prove std/protein_folding/cg_gaussian_network_gnm.oo
//
// Logline: Fail-closed emit+gcc+run asserts gnm_calc_kirchhoff_offdiag is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_gaussian_network_gnm.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gnm_calc_kirchhoff_offdiag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_cg_gaussian_network_gnm: PASSED only if they match.

import "std/protein_folding/cg_gaussian_network_gnm.oo";

pub fn main() {
    let g0_a = gnm_calc_kirchhoff_offdiag(1.0, 1.0);
    let g0_b = gnm_calc_kirchhoff_offdiag(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL gnm_calc_kirchhoff_offdiag");
        process_exit(1);
    }
    println("prod_g0_cg_gaussian_network_gnm: PASSED");
}
