// # Product prove std/db_graph/graph_shortest_path_dijkstra.oo
//
// Logline: Fail-closed emit+gcc+run asserts dijkstra_path_result_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_shortest_path_dijkstra.oo.
//
// Beats:
//   1. Call dijkstra_path_result_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_shortest_path_dijkstra: PASSED only if they match.

import "std/db_graph/graph_shortest_path_dijkstra.oo";

pub fn main() {
    let graph_shortest_path_dijkstra_mark: Int = 0;
    if graph_shortest_path_dijkstra_mark != 0 {
        process_exit(1);
    }
    let a: DijkstraPathResult = dijkstra_path_result_empty();
    let b: DijkstraPathResult = dijkstra_path_result_empty();
    if (a).hop_count != (b).hop_count {
        println("FAIL dijkstra_path_result_empty");
        process_exit(1);
    }
    println("prod_g2_graph_shortest_path_dijkstra: PASSED");
}
