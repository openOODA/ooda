// # Product prove std/web_protocols/csp_header_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts csp_src_self is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/csp_header_builder.oo.
//
// Beats:
//   1. Call csp_src_self twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_csp_header_builder: PASSED only if they match.

import "std/web_protocols/csp_header_builder.oo";

pub fn main() {
    let csp_header_builder_mark: Int = 0;
    if csp_header_builder_mark != 0 {
        process_exit(1);
    }
    let csp_header_builder_a: Int = csp_src_self();
    let csp_header_builder_b: Int = csp_src_self();
    if csp_header_builder_a != csp_header_builder_b {
        println("FAIL csp_src_self");
        process_exit(1);
    }
    println("prod_csp_header_builder: PASSED");
}
