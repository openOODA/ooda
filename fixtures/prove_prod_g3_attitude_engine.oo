// # Product prove std/aero/attitude_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts att_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_engine.oo.
//
// Beats:
//   1. Call att_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_engine: PASSED only if they match.

import "std/aero/attitude_engine.oo";

pub fn main() {
    let attitude_engine_mark: Int = 0;
    if attitude_engine_mark != 0 {
        process_exit(1);
    }
    let a: AttEng = att_eng_new(0, 0);
    let b: AttEng = att_eng_new(0, 0);
    if (a).mode != (b).mode {
        println("FAIL att_eng_new");
        process_exit(1);
    }
    println("prod_attitude_engine: PASSED");
}
