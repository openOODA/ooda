// # Product prove std/tda_topology/morse_smale_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts morse_field_count_critical_dim is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/morse_smale_complex.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call morse_field_count_critical_dim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_morse_smale_complex: PASSED only if they match.

import "std/tda_topology/morse_smale_complex.oo";

pub fn main() {
    let g0_oa = discrete_morse_field_new(0);
    let g0_ob = discrete_morse_field_new(0);
    let g0_a = morse_field_count_critical_dim(&g0_oa, 0);
    let g0_b = morse_field_count_critical_dim(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL morse_field_count_critical_dim");
        process_exit(1);
    }
    println("prod_gr_morse_smale_complex: PASSED");
}
