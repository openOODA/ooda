// # Tamper a pinned ingest CAS blob
//
// Logline: Append one byte to the first non-wrapper file in the ingar CAS so launch can refuse sha drift.
//
// Setup: cwd is ooda/. .ooda_modules/lock holds an ingar@ pin. ProcessCap runs one shell line.
//
// Beats:
//   1. Read the lock line that starts with ingar@.
//   2. Take the sha after the first #.
//   3. Open .ooda_modules/cas/<sha>/ and skip names that start with ingest_.
//   4. Append byte X to the first remaining file.

pub fn main(p: &ProcessCap) {
    let cmd: String = "sha=$(awk -F'#' '/^ingar@/{print $2; exit}' .ooda_modules/lock); "
        + "hit=; for f in .ooda_modules/cas/$sha/*; do "
        + "case $f in */ingest_*) continue;; esac; "
        + "if [ ! -e \"$f\" ]; then continue; fi; hit=$f; break; done; "
        + "if [ -z \"$hit\" ]; then echo no payload in .ooda_modules/cas/$sha; exit 1; fi; "
        + "printf X >> \"$hit\"";
    if process_exec(p, cmd).is_err() {
        println("FAIL sha tamper");
        process_exit(1);
    }
}
