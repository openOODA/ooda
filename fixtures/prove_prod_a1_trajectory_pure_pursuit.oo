// # Product prove std/auto_robot/trajectory_pure_pursuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts pursuit_look is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/trajectory_pure_pursuit.oo.
//
// Beats:
//   1. Call pursuit_look twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_trajectory_pure_pursuit: PASSED only if they match.

import "std/auto_robot/trajectory_pure_pursuit.oo";

pub fn main() {
    let trajectory_pure_pursuit_mark: Int = 0;
    if trajectory_pure_pursuit_mark != 0 {
        process_exit(1);
    }
    let a: Int = pursuit_look(0, 0);
    let b: Int = pursuit_look(0, 0);
    if a != b {
        println("FAIL pursuit_look");
        process_exit(1);
    }
    println("prod_trajectory_pure_pursuit: PASSED");
}
