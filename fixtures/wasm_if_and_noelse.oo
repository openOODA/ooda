// # Const if true && true println no else
//
// Logline: Print and-ne when true && true and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If true && true print and-ne.
//   3. Leave no else and no other statements.

pub fn main() {
    if true && true {
        println("and-ne");
    }
}
