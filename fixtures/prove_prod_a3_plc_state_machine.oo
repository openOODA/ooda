// # Product prove std/industrial_iot/plc_state_machine.oo
//
// Logline: Fail-closed emit+gcc+run asserts plc_state_name_code is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/plc_state_machine.oo.
//
// Beats:
//   1. Call plc_state_name_code twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plc_state_machine: PASSED only if they match.

import "std/industrial_iot/plc_state_machine.oo";

pub fn main() {
    let plc_state_machine_mark: Int = 0;
    if plc_state_machine_mark != 0 {
        process_exit(1);
    }
    let a: Int = plc_state_name_code(0);
    let b: Int = plc_state_name_code(0);
    if a != b {
        println("FAIL plc_state_name_code");
        process_exit(1);
    }
    println("prod_plc_state_machine: PASSED");
}
