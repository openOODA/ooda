// # Product prove std/net/dns_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts dns_type_a is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/dns_packet.oo.
//
// Beats:
//   1. Call dns_type_a twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dns_packet: PASSED only if they match.

import "std/net/dns_packet.oo";

pub fn main() {
    let a = dns_type_a();
    let b = dns_type_a();
    if a != b {
        println("FAIL dns_type_a");
        process_exit(1);
    }
    println("prod_dns_packet: PASSED");
}
