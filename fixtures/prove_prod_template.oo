// # Product template.oo prove
//
// Logline: Fail-closed emit+gcc+run of shipped template_render_simple.
//
// Setup: Product std/text/template.oo. Default {{key}} tags.
//
// Beats:
//   1. hi {{name}} with name=ada is hi ada.
//   2. Exit 1 before PASSED on a miss.

import "std/text/template.oo";

pub fn main() {
    let s: String = template_render_simple("hi {{name}}", "name", "ada");
    if s != "hi ada" {
        println("FAIL template");
        process_exit(1);
    }
    let e: TemplateEngine = template_default();
    let t2: String = template_render_var(e, "x{{k}}y", "k", "1");
    if t2 != "x1y" {
        println("FAIL template var");
        process_exit(1);
    }
    println("prod_template: PASSED");
}
