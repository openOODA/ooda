// # Product prove std/aero/propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts propulsion_eng_thrust is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call propulsion_eng_thrust twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_propulsion: PASSED only if they match.

import "std/aero/propulsion.oo";

pub fn main() {
    let g2_oa = propulsion_eng_new(2, 2);
    let g2_ob = propulsion_eng_new(2, 2);
    let g2_a = propulsion_eng_thrust(g2_oa);
    let g2_b = propulsion_eng_thrust(g2_ob);
    if g2_a != g2_b {
        println("FAIL propulsion_eng_thrust");
        process_exit(1);
    }
    println("prod_g2_propulsion: PASSED");
}
