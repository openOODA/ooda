// # Product prove std/graph_networks/batman_mesh_protocol.oo
//
// Logline: Fail-closed emit+gcc+run asserts batman_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/batman_mesh_protocol.oo.
//
// Beats:
//   1. Call batman_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_batman_mesh_protocol: PASSED only if they match.

import "std/graph_networks/batman_mesh_protocol.oo";

pub fn main() {
    let batman_mesh_protocol_mark: Int = 0;
    if batman_mesh_protocol_mark != 0 {
        process_exit(1);
    }
    let a: BatmanMeshRouter = batman_create(1);
    let b: BatmanMeshRouter = batman_create(1);
    if (a).local_id != (b).local_id {
        println("FAIL batman_create");
        process_exit(1);
    }
    println("prod_batman_mesh_protocol: PASSED");
}
