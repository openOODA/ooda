// # Product prove std/ai_multimodal/vit_patch_embedding.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/vit_patch_embedding.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_patch_embedding.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vit_patch_embedding: PASSED only if they match.

import "std/ai_multimodal/vit_patch_embedding.oo";

pub fn main() {
    let vit_patch_embedding_a = vit_n_patch(0, 0);
    let vit_patch_embedding_b = vit_n_patch(0, 0);
    if vit_patch_embedding_a != vit_patch_embedding_b {
        println("FAIL vit_patch_embedding");
        process_exit(1);
    }
    println("prod_ap_vit_patch_embedding: PASSED");
}
