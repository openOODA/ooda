// # Product prove std/gis_spatial/geohash.oo
//
// Logline: Fail-closed emit+gcc+run asserts geohash_char_to_val is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/geohash.oo.
//
// Beats:
//   1. Call geohash_char_to_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_geohash: PASSED only if they match.

import "std/gis_spatial/geohash.oo";

pub fn main() {
    let a: Int = geohash_char_to_val(0);
    let b: Int = geohash_char_to_val(0);
    if a != b {
        println("FAIL geohash_char_to_val");
        process_exit(1);
    }
    println("prod_g2_geohash: PASSED");
}
