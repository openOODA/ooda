// # Product prove std/sec/objcap.oo
//
// Logline: Fail-closed emit+gcc+run asserts capability_rights_diminish is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/objcap.oo.
//
// Beats:
//   1. Call capability_rights_diminish twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap: PASSED only if they match.

import "std/sec/objcap.oo";

pub fn main() {
    let a = capability_rights_diminish(0, 0);
    let b = capability_rights_diminish(0, 0);
    if a != b {
        println("FAIL capability_rights_diminish");
        process_exit(1);
    }
    println("prod_objcap: PASSED");
}
