// # Product prove std/sec/sys/audit_engine.oo
//
// Logline: Fail-closed emit+check asserts audit_check_path_prefix is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/audit_engine.oo.
//
// Beats:
//   1. Call audit_check_path_prefix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit_engine: PASSED only if they match.

import "std/sec/sys/audit_engine.oo";

pub fn main() {
    let audit_engine_mark: Int = 0;
    if audit_engine_mark != 0 { process_exit(1); }
    let a: Bool = audit_check_path_prefix("/var", "/var/log");
    let b: Bool = audit_check_path_prefix("/var", "/var/log");
    if a != b { process_exit(1); }
    println("prod_audit_engine: PASSED");
}
