// # Product prove std/grid/wind_farm.oo
//
// Logline: Fail-closed emit+gcc+run asserts wind_farm_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/wind_farm.oo.
//
// Beats:
//   1. Call wind_farm_new using the wind_farm ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_wind_farm: PASSED only if asserts hold.

import "std/grid/wind_farm.oo";

pub fn main() {
    let obj = wind_farm_new(8, 0.0, 8);
    let wind_farm_a = obj.farm_id;
    if wind_farm_a != 8 {
        println("FAIL wind_farm_new");
        process_exit(1);
    }
    println("prod_wind_farm: PASSED");
}
