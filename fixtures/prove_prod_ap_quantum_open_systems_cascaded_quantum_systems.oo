// # Product prove std/quantum_open_systems/cascaded_quantum_systems.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/cascaded_quantum_systems.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/cascaded_quantum_systems.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cascaded_quantum_systems: PASSED only if they match.

import "std/quantum_open_systems/cascaded_quantum_systems.oo";

pub fn main() {
    let cascaded_quantum_systems_a = cascaded_node_params_new(0.0, 0.0, 0.0);
    let cascaded_quantum_systems_b = cascaded_node_params_new(0.0, 0.0, 0.0);
    let cascaded_quantum_systems_va = cascaded_is_ideal_transfer(cascaded_quantum_systems_a);
    let cascaded_quantum_systems_vb = cascaded_is_ideal_transfer(cascaded_quantum_systems_b);
    if cascaded_quantum_systems_va != cascaded_quantum_systems_vb {
        println("FAIL cascaded_quantum_systems");
        process_exit(1);
    }
    println("prod_ap_cascaded_quantum_systems: PASSED");
}
