// # Product prove std/db_storage/mvcc_undo_log_garbage_collector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/mvcc_undo_log_garbage_collector.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_undo_log_garbage_collector.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_mvcc_undo_log_garbage_collector: PASSED only if they match.

import "std/db_storage/mvcc_undo_log_garbage_collector.oo";

pub fn main() {
    let mvcc_undo_log_garbage_collector_a = undo_segment_new(0);
    let mvcc_undo_log_garbage_collector_b = undo_segment_new(0);
    if mvcc_undo_log_garbage_collector_a.segment_id != mvcc_undo_log_garbage_collector_b.segment_id {
        println("FAIL mvcc_undo_log_garbage_collector");
        process_exit(1);
    }
    println("prod_ap_mvcc_undo_log_garbage_collector: PASSED");
}
