// # Product prove std/auto/behavior.oo
//
// Logline: Fail-closed verification that autonomous vehicle tactical behavior planning, kinematics, and decision nodes are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior.oo.
//
// Beats:
//   1. Query status constants, vehicle state zero, and obstacle initialization shims.
//   2. Compute inter-vehicle distance, time-to-collision (TTC), and kinematic updates.
//   3. Generate lane-keep and stop tactical plans.
//   4. Print prod_g4_auto_behavior: PASSED and exit 0.

import "std/auto/behavior.oo";

pub fn main() {
    let behavior_mark: Int = 0;
    if behavior_mark != 0 {
        process_exit(1);
    }

    let status_a: Int = shim_marker_status_success();
    let status_b: Int = shim_marker_status_success();
    if status_a != status_b || status_a != 1 {
        println("FAIL shim_marker_status_success");
        process_exit(1);
    }

    let b_mode_a: Int = shim_marker_behavior_lane_keep();
    let b_mode_b: Int = shim_marker_behavior_lane_keep();
    if b_mode_a != b_mode_b || b_mode_a != 1 {
        println("FAIL shim_marker_behavior_lane_keep");
        process_exit(1);
    }

    let v0_a: VehicleState = shim_marker_vehicle_state_zero();
    let v0_b: VehicleState = shim_marker_vehicle_state_zero();
    if (v0_a).id != (v0_b).id || (v0_a).speed != 0.0 {
        println("FAIL shim_marker_vehicle_state_zero");
        process_exit(1);
    }

    let v_lead: VehicleState = shim_marker_vehicle_state_new();
    let v_foll: VehicleState = shim_marker_vehicle_state_zero();

    let dist_a: Float = shim_marker_vehicle_distance(v_lead, v_foll);
    let dist_b: Float = shim_marker_vehicle_distance(v_lead, v_foll);
    if dist_a != dist_b {
        println("FAIL shim_marker_vehicle_distance");
        process_exit(1);
    }

    let ttc_a: Float = shim_marker_vehicle_ttc(v_lead, v_foll);
    let ttc_b: Float = shim_marker_vehicle_ttc(v_lead, v_foll);
    if ttc_a != ttc_b {
        println("FAIL shim_marker_vehicle_ttc");
        process_exit(1);
    }

    let v_updated_a: VehicleState = shim_marker_update_kinematics(v_lead);
    let v_updated_b: VehicleState = shim_marker_update_kinematics(v_lead);
    if (v_updated_a).x != (v_updated_b).x || (v_updated_a).speed != (v_updated_b).speed {
        println("FAIL shim_marker_update_kinematics");
        process_exit(1);
    }

    let plan_lk_a: TacticalPlan = shim_marker_plan_lane_keep(v_lead);
    let plan_lk_b: TacticalPlan = shim_marker_plan_lane_keep(v_lead);
    if (plan_lk_a).target_behavior != (plan_lk_b).target_behavior || (plan_lk_a).target_speed != (plan_lk_b).target_speed {
        println("FAIL shim_marker_plan_lane_keep");
        process_exit(1);
    }

    let plan_stop_a: TacticalPlan = shim_marker_plan_stop(v_lead);
    let plan_stop_b: TacticalPlan = shim_marker_plan_stop(v_lead);
    if (plan_stop_a).target_behavior != (plan_stop_b).target_behavior || (plan_stop_a).target_speed != 0.0 {
        println("FAIL shim_marker_plan_stop");
        process_exit(1);
    }

    let metrics_a: BehaviorMetrics = shim_marker_metrics_zero();
    let metrics_b: BehaviorMetrics = shim_marker_metrics_zero();
    if (metrics_a).total_ticks != (metrics_b).total_ticks {
        println("FAIL shim_marker_metrics_zero");
        process_exit(1);
    }

    println("prod_g4_auto_behavior: PASSED");
    process_exit(0);
}
