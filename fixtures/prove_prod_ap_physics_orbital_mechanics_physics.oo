// # Product prove std/physics/orbital_mechanics_physics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/orbital_mechanics_physics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/orbital_mechanics_physics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbital_mechanics_physics: PASSED only if they match.

import "std/physics/orbital_mechanics_physics.oo";

pub fn main() {
    let orbital_mechanics_physics_a = orbital_vis_viva_speed(0.0, 0.0, 0.0);
    let orbital_mechanics_physics_b = orbital_vis_viva_speed(0.0, 0.0, 0.0);
    if orbital_mechanics_physics_a != orbital_mechanics_physics_b {
        println("FAIL orbital_mechanics_physics");
        process_exit(1);
    }
    println("prod_ap_orbital_mechanics_physics: PASSED");
}
