// # Product prove std/graph_gnn/kg_negative_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts negative_sampling_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_negative_sampling.oo.
//
// Beats:
//   1. Call negative_sampling_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_negative_sampling: PASSED only if they match.

import "std/graph_gnn/kg_negative_sampling.oo";

pub fn main() {
    let kg_negative_sampling_mark: Int = 0;
    if kg_negative_sampling_mark != 0 {
        process_exit(1);
    }
    let a: NegativeSamplingConfig = negative_sampling_config_new(0, 0, 0.0, true);
    let b: NegativeSamplingConfig = negative_sampling_config_new(0, 0, 0.0, true);
    if (a).num_entities != (b).num_entities {
        println("FAIL negative_sampling_config_new");
        process_exit(1);
    }
    println("prod_g2_kg_negative_sampling: PASSED");
}
