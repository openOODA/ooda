// # Product prove std/space_propulsion/helicon_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts helicon_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/helicon_plasma_thruster.oo.
//
// Beats:
//   1. Call helicon_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_helicon_plasma_thruster: PASSED only if they match.

import "std/space_propulsion/helicon_plasma_thruster.oo";

pub fn main() {
    let helicon_plasma_thruster_mark: Int = 0;
    if helicon_plasma_thruster_mark != 0 {
        process_exit(1);
    }
    let helicon_plasma_thruster_a = helicon_compute_performance(helicon_spec_default_argon());
    let helicon_plasma_thruster_b = helicon_compute_performance(helicon_spec_default_argon());
    if (helicon_plasma_thruster_a).plasma_density_m3 != (helicon_plasma_thruster_b).plasma_density_m3 {
        println("FAIL helicon_compute_performance");
        process_exit(1);
    }
    println("prod_helicon_plasma_thruster: PASSED");
}
