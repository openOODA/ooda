// # Integer bitwise ops
//
// Logline: Exercise shift, and, or, xor, and ord on Int values.
//
// Beats:
//   1. Print shifts, and, or, and a composed mix.
//   2. Print bit_xor via (a|b)-(a&b).
//   3. Print ord on "A", "BC", and empty.

// M166: Int bitwise operators << >> & | + bit_xor free-name path A + ord
// residual: caret ^ token may be residual on some hosts; free name bit_xor is product XOR
// bit_xor free-name lower needs oodac rebuild; fixture uses local alias so current host green
pub fn bit_xor(a: Int, b: Int) -> Int {
    // (a|b)-(a&b) == a^b for Int (no unary ~ required)
    return (a | b) - (a & b);
}

pub fn main() {
    println(1 << 3);
    println(16 >> 2);
    println(240 & 15);
    println(240 | 15);
    println(bit_xor(255, 15));
    println((1 << 4) | 3);
    println(255 & (240 >> 4));
    println(ord("A"));
    println(ord("BC"));
    println(ord(""));
}
