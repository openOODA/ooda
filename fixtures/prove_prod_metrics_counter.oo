// # Product prove std/diag/metrics_counter.oo
//
// Logline: Fail-closed emit+gcc+run asserts metrics_counter_get is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/metrics_counter.oo.
//
// Beats:
//   1. Call metrics_counter_get twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metrics_counter: PASSED only if they match.

import "std/diag/metrics_counter.oo";

pub fn main() {
    let obj = metrics_counter_new("x");
    let a = metrics_counter_get(obj);
    let b = metrics_counter_get(obj);
    if a != b {
        println("FAIL metrics_counter_get");
        process_exit(1);
    }
    println("prod_metrics_counter: PASSED");
}
