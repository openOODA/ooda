// # Unified Diagnostic Engine Verification Test
//
// Logline: Integration test verifying visual breadcrumb trees, AI NDJSON telemetry, counterexample state capture, and invariant solvers.
//
// Setup: Exercises all diagnostic tracing and formal invariant verification subsystems on live binary execution under ProcessCap.
//
// Beats:
//   1. Verify trace span recording and ring buffer bounded capacity.
//   2. Verify human visual breadcrumb tree rendering with colored status badges.
//   3. Verify AI telemetry NDJSON single-line event streaming and ANSI stripping.
//   4. Verify dynamic counterexample snapshot diffing and relational invariant evaluation.

import "std/diag/trace_span.oo";
import "std/diag/breadcrumb_tree.oo";
import "std/diag/telemetry_ndjson.oo";
import "std/diag/counterexample_capture.oo";
import "std/diag/invariant_eval.oo";

pub fn main(p: &ProcessCap) {
    println("===================================================================");
    println(" openOODA Sovereign Diagnostic Engine Integration Test");
    println("===================================================================");

    // 1. Trace Span Lifecycle & Ring Buffer
    let mut ring: TraceRingBuffer = trace_ring_buffer_new(3);
    let mut s1: TraceSpan = trace_span_new(1, "engine_init", 0, 0, 1000);
    trace_span_finish(&mut s1, 1050, 1, 4096);
    let mut s2: TraceSpan = trace_span_new(2, "vdom_reconcile", 1, 1, 1050);
    trace_span_finish(&mut s2, 1070, 1, 8192);
    let mut s3: TraceSpan = trace_span_new(3, "gpu_submit", 1, 1, 1070);
    trace_span_finish(&mut s3, 1080, 2, 1024);

    trace_ring_buffer_push(&mut ring, s1);
    trace_ring_buffer_push(&mut ring, s2);
    trace_ring_buffer_push(&mut ring, s3);

    if trace_ring_buffer_len(&ring) != 3 || ring.total_recorded != 3 {
        println("FAIL: Trace ring buffer capacity mismatch");
        process_exit(1);
    }
    println("  [PASS] 1. Trace Span Lifecycle & Ring Buffer Storage");

    // 2. Human Visual Breadcrumb Hierarchy
    let mut span_list: List[TraceSpan] = list_new();
    span_list = list_push(span_list, s1);
    span_list = list_push(span_list, s2);
    span_list = list_push(span_list, s3);

    let visual_tree: String = breadcrumb_tree_render(span_list);
    if !str_contains(visual_tree, "[PASS]") || !str_contains(visual_tree, "[FAIL]") {
        println("FAIL: Breadcrumb tree visual status badge rendering mismatch");
        process_exit(1);
    }
    println("  [PASS] 2. Human Visual Breadcrumb Tree Rendering & ANSI Highlights");

    let mut esc_bytes: List[Int] = bytes_new();
    esc_bytes = bytes_push(esc_bytes, 27);
    let esc_str: String = bytes_to_str(esc_bytes);
    let raw_injected: String = esc_str + "[31mInjected" + esc_str + "[0mPayload";
    let mut s_fuzz: TraceSpan = trace_span_new(4, raw_injected, 0, 0, 2000);
    trace_span_finish(&mut s_fuzz, 2010, 1, 512);

    let ndjson: String = telemetry_span_to_ndjson(&s_fuzz);
    if str_contains(ndjson, esc_str) || !str_contains(ndjson, "Injected") || !str_contains(ndjson, "Payload") {
        println("FAIL: Telemetry NDJSON sanitizer failed to strip ANSI codes or escape quotes");
        process_exit(1);
    }
    println("  [PASS] 3. AI Telemetry NDJSON Event Serialization & ANSI Sanitization");

    // 4. Counterexample Capture & State Diff
    let mut pre_ce: CounterexampleState = counterexample_capture_new("check_memory", "main.oo:120");
    counterexample_add_var(&mut pre_ce, "heap_used", "Int", "1048576");
    counterexample_add_var(&mut pre_ce, "buffer_count", "Int", "4");

    let mut post_ce: CounterexampleState = counterexample_capture_new("check_memory", "main.oo:120");
    counterexample_add_var(&mut post_ce, "heap_used", "Int", "2097152"); // Mutated
    counterexample_add_var(&mut post_ce, "buffer_count", "Int", "4");

    let diff_report: String = counterexample_diff(&pre_ce, &post_ce);
    if !str_contains(diff_report, "MUTATION: heap_used changed: 1048576 -> 2097152") {
        println("FAIL: Counterexample state delta engine failed to capture variable mutation");
        process_exit(1);
    }
    println("  [PASS] 4. Dynamic Counterexample Snapshot Capture & State Delta Diffing");

    // 5. Formal Invariant Evaluator
    let rule_mem: InvariantRule = invariant_rule_lt("heap_used", 1500000);
    let eval_res1: Result[Bool, String] = invariant_eval_int(&rule_mem, 1048576);
    let eval_res2: Result[Bool, String] = invariant_eval_int(&rule_mem, 2097152);

    match eval_res1 {
        Ok(v) => { if !v { println("FAIL: Invariant check failed for valid value"); process_exit(1); } }
        Err(e) => { println("FAIL: Invariant check errored unexpectedly: " + e); process_exit(1); }
    }

    match eval_res2 {
        Ok(v) => { println("FAIL: Invariant check passed for violating value"); process_exit(1); }
        Err(e) => {
            if !str_contains(e, "Invariant violated") {
                println("FAIL: Invariant violation message format mismatch");
                process_exit(1);
            }
        }
    }
    println("  [PASS] 5. Formal Relational & Range Invariant Solver");

    println("test_diag_engine: PASSED");
}
