// # Product prove std/graph_gnn/graph_laplacian_spectrum.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_gnn/graph_laplacian_spectrum.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_laplacian_spectrum.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_laplacian_spectrum: PASSED only if they match.

import "std/graph_gnn/graph_laplacian_spectrum.oo";

pub fn main() {
    let graph_laplacian_spectrum_a = laplacian_config_new(0, true);
    let graph_laplacian_spectrum_b = laplacian_config_new(0, true);
    if graph_laplacian_spectrum_a.num_nodes != graph_laplacian_spectrum_b.num_nodes {
        println("FAIL graph_laplacian_spectrum");
        process_exit(1);
    }
    println("prod_ap_graph_laplacian_spectrum: PASSED");
}
