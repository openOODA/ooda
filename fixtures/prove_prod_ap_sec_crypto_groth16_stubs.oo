// # Product prove std/sec/crypto/groth16_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/groth16_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_groth16_stubs: PASSED only if they match.

import "std/sec/crypto/groth16_stubs.oo";

pub fn main() {
    let groth16_stubs_a = groth16_compute_msm_g1(list_new(), list_new(), list_new());
    let groth16_stubs_b = groth16_compute_msm_g1(list_new(), list_new(), list_new());
    if groth16_stubs_a.is_ok() != groth16_stubs_b.is_ok() {
        println("FAIL groth16_stubs");
        process_exit(1);
    }
    println("prod_ap_groth16_stubs: PASSED");
}
