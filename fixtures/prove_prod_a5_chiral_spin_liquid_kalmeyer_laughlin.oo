// # Product prove std/quantum_topological/chiral_spin_liquid_kalmeyer_laughlin.oo
//
// Logline: Fail-closed emit+gcc+run asserts csl_semion_quantum_dimension is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/chiral_spin_liquid_kalmeyer_laughlin.oo.
//
// Beats:
//   1. Call csl_semion_quantum_dimension twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chiral_spin_liquid_kalmeyer_laughlin: PASSED only if they match.

import "std/quantum_topological/chiral_spin_liquid_kalmeyer_laughlin.oo";

pub fn main() {
    let chiral_spin_liquid_kalmeyer_laughlin_mark: Int = 0;
    if chiral_spin_liquid_kalmeyer_laughlin_mark != 0 {
        process_exit(1);
    }
    let a: Float = csl_semion_quantum_dimension();
    let b: Float = csl_semion_quantum_dimension();
    if a != b {
        println("FAIL csl_semion_quantum_dimension");
        process_exit(1);
    }
    println("prod_chiral_spin_liquid_kalmeyer_laughlin: PASSED");
}
