// # Product prove std/hft_alpha/mm_microprice_queue_imbalance.oo
//
// Logline: Fail-closed emit+gcc+run asserts l1_book_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_microprice_queue_imbalance.oo.
//
// Beats:
//   1. Call l1_book_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_microprice_queue_imbalance: PASSED only if they match.

import "std/hft_alpha/mm_microprice_queue_imbalance.oo";

pub fn main() {
    let mm_microprice_queue_imbalance_mark: Int = 0;
    if mm_microprice_queue_imbalance_mark != 0 {
        process_exit(1);
    }
    let a: L1BookState = l1_book_state_new(0.0, 0.0, 0.0, 0.0);
    let b: L1BookState = l1_book_state_new(0.0, 0.0, 0.0, 0.0);
    if (a).best_bid_price != (b).best_bid_price {
        println("FAIL l1_book_state_new");
        process_exit(1);
    }
    println("prod_mm_microprice_queue_imbalance: PASSED");
}
