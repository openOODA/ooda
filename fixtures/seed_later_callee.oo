// # Seed later-defined callee emit lock
//
// Logline: emit-c of a call whose callee is defined later in the same file.
//
// Setup: Seed and tree hosts. later() sits after main.
//
// Beats:
//   1. main calls later before later is defined.
//   2. later returns 7.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let n: Int = later();
    if n != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("seed_later_callee: PASSED");
}

pub fn later() -> Int {
    return 7;
}
