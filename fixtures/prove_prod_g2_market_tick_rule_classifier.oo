// # Product prove std/fintech_l3_book/market_tick_rule_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts tick_classifier_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/market_tick_rule_classifier.oo.
//
// Beats:
//   1. Call tick_classifier_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_market_tick_rule_classifier: PASSED only if they match.

import "std/fintech_l3_book/market_tick_rule_classifier.oo";

pub fn main() {
    let market_tick_rule_classifier_mark: Int = 0;
    if market_tick_rule_classifier_mark != 0 {
        process_exit(1);
    }
    let a: TickClassifierState = tick_classifier_state_new("x");
    let b: TickClassifierState = tick_classifier_state_new("x");
    if (a).last_trade_price_fixed != (b).last_trade_price_fixed {
        println("FAIL tick_classifier_state_new");
        process_exit(1);
    }
    println("prod_g2_market_tick_rule_classifier: PASSED");
}
