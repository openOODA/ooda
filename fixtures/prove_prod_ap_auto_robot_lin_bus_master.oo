// # Product prove std/auto_robot/lin_bus_master.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/lin_bus_master.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/lin_bus_master.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lin_bus_master: PASSED only if they match.

import "std/auto_robot/lin_bus_master.oo";

pub fn main() {
    let lin_bus_master_a = lin_compute_pid(0);
    let lin_bus_master_b = lin_compute_pid(0);
    if lin_bus_master_a != lin_bus_master_b {
        println("FAIL lin_bus_master");
        process_exit(1);
    }
    println("prod_ap_lin_bus_master: PASSED");
}
