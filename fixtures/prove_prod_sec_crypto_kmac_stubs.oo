// # Product prove std/sec/crypto/kmac_stubs.oo
//
// Logline: Fail-closed emit+check asserts kmac_hardware_accelerated is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac_stubs.oo.
//
// Beats:
//   1. Call kmac_hardware_accelerated twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kmac_stubs: PASSED only if they match.

import "std/sec/crypto/kmac_stubs.oo";

pub fn main() {
    let kmac_stubs_mark: Int = 0;
    if kmac_stubs_mark != 0 { process_exit(1); }
    let a = kmac_hardware_accelerated("a", "b", "c");
    let b = kmac_hardware_accelerated("a", "b", "c");
    if a != b { process_exit(1); }
    println("prod_kmac_stubs: PASSED");
}
