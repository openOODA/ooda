// # Product prove std/bio_advanced/hmm_viterbi_aligner.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/hmm_viterbi_aligner.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_viterbi_aligner.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hmm_viterbi_aligner: PASSED only if they match.

import "std/bio_advanced/hmm_viterbi_aligner.oo";

pub fn main() {
    let hmm_viterbi_aligner_a = viterbi_step_update(0.0, 0.0, 0.0);
    let hmm_viterbi_aligner_b = viterbi_step_update(0.0, 0.0, 0.0);
    if hmm_viterbi_aligner_a != hmm_viterbi_aligner_b {
        println("FAIL hmm_viterbi_aligner");
        process_exit(1);
    }
    println("prod_ap_hmm_viterbi_aligner: PASSED");
}
