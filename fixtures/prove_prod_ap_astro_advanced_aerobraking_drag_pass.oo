// # Product prove std/astro_advanced/aerobraking_drag_pass.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/aerobraking_drag_pass.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/aerobraking_drag_pass.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aerobraking_drag_pass: PASSED only if they match.

import "std/astro_advanced/aerobraking_drag_pass.oo";

pub fn main() {
    let aerobraking_drag_pass_a = aero_drag_cd();
    let aerobraking_drag_pass_b = aero_drag_cd();
    if aerobraking_drag_pass_a != aerobraking_drag_pass_b {
        println("FAIL aerobraking_drag_pass");
        process_exit(1);
    }
    println("prod_ap_aerobraking_drag_pass: PASSED");
}
