// # Product prove std/aero/navigation_quat.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_quat_w is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_quat.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nav_quat_w twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_navigation_quat: PASSED only if they match.

import "std/aero/navigation_quat.oo";

pub fn main() {
    let g2_oa = nav_quat_new(2, 2);
    let g2_ob = nav_quat_new(2, 2);
    let g2_a = nav_quat_w(g2_oa);
    let g2_b = nav_quat_w(g2_ob);
    if g2_a != g2_b {
        println("FAIL nav_quat_w");
        process_exit(1);
    }
    println("prod_g2_navigation_quat: PASSED");
}
