// # Product prove std/physics_advanced/soft_body_position_based_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts soft_body_position_based_dynamics_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_position_based_dynamics.oo.
//
// Beats:
//   1. Call soft_body_position_based_dynamics_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_soft_body_position_based_dynamics: PASSED only if they match.

import "std/physics_advanced/soft_body_position_based_dynamics.oo";

pub fn main() {
    let a = soft_body_position_based_dynamics_probe();
    let b = soft_body_position_based_dynamics_probe();
    if a != b {
        println("FAIL soft_body_position_based_dynamics_probe");
        process_exit(1);
    }
    println("prod_soft_body_position_based_dynamics: PASSED");
}
