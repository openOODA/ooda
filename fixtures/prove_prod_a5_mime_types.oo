// # Product prove std/web_ecosystem/mime_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts mime_lookup_extension is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/mime_types.oo.
//
// Beats:
//   1. Call mime_lookup_extension twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mime_types: PASSED only if they match.

import "std/web_ecosystem/mime_types.oo";

pub fn main() {
    let mime_types_mark: Int = 0;
    if mime_types_mark != 0 {
        process_exit(1);
    }
    let a: String = mime_lookup_extension("x");
    let b: String = mime_lookup_extension("x");
    if a != b {
        println("FAIL mime_lookup_extension");
        process_exit(1);
    }
    println("prod_mime_types: PASSED");
}
