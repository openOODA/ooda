// # Refuse secret dlopen flag
//
// Logline: Pass a secret IDENT as the dlopen flag so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call dlopen with a public path and secret flag.
//   3. Print 1 after the call.
//
// T2-4b: secret in non-path flag/arg of dlopen (argi>=1 scan)
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "s3cret-flag";
    let r = dlopen(ffi, "libx.so", token);
    println(1);
}
