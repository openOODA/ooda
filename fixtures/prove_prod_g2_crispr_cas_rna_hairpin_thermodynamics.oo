// # Product prove std/crispr_cas/rna_hairpin_thermodynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_calc_simple_dg is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/rna_hairpin_thermodynamics.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rna_calc_simple_dg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rna_hairpin_thermodynamics: PASSED only if they match.

import "std/crispr_cas/rna_hairpin_thermodynamics.oo";

pub fn main() {
    let g2_a = rna_calc_simple_dg("x");
    let g2_b = rna_calc_simple_dg("x");
    if g2_a != g2_b {
        println("FAIL rna_calc_simple_dg");
        process_exit(1);
    }
    println("prod_g2_rna_hairpin_thermodynamics: PASSED");
}
