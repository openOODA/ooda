// # Product prove std/robotics_ros2/control_feedforward_gravity.oo
//
// Logline: Fail-closed emit+gcc+run asserts friction_model_new real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/control_feedforward_gravity.oo.
//
// Beats:
//   1. Call friction_model_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_control_feedforward_gravity: PASSED only if the assert holds.

import "std/robotics_ros2/control_feedforward_gravity.oo";

pub fn main() {
    let control_feedforward_gravity_mark: Int = 0;
    if control_feedforward_gravity_mark != 0 {
        process_exit(1);
    }
    let control_feedforward_gravity_a: FrictionModel = friction_model_new(2.0, 2.0, 2.0, 2.0);
    let control_feedforward_gravity_viscous_coeff: Float = (control_feedforward_gravity_a).viscous_coeff;
    if !(control_feedforward_gravity_viscous_coeff == 2.0) {
        println("FAIL friction_model_new");
        process_exit(1);
    }
    println("prod_control_feedforward_gravity: PASSED");
}
