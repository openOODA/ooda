// # Product prove std/lidar_perception/sensor_fusion_radar_lidar.oo
//
// Logline: Fail-closed emit+gcc+run asserts sensor_fusion_radar_lidar_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/sensor_fusion_radar_lidar.oo.
//
// Beats:
//   1. Call sensor_fusion_radar_lidar_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_sensor_fusion_radar_lidar: PASSED only if it matches.

import "std/lidar_perception/sensor_fusion_radar_lidar.oo";

pub fn main() {
    let a: Int = sensor_fusion_radar_lidar_probe();
    if a != 0 {
        println("FAIL sensor_fusion_radar_lidar_probe");
        process_exit(1);
    }
    println("prod_nc_sensor_fusion_radar_lidar: PASSED");
}
