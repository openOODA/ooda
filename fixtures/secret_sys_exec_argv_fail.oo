// # Refuse secret sys_exec argv
//
// Logline: Pass a secret string as a later sys_exec argument so taint must refuse the call.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call sys_exec with the secret in a later argv slot.
//   3. Print 1 after the call.
//
// M-? sys_exec argv taint: secret at argv pos 3+ with 5+ args slips past walker
// SECRET: token
pub fn main(sys: &SysCap) {
    let token = "s3cret-payload";
    let r = sys_exec(sys, "sh", "-c", token, "true");
    println(1);
}
