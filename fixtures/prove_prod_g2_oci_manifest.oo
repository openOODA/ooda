// # Product prove std/cloud/oci_manifest.oo
//
// Logline: Fail-closed emit+gcc+run asserts oci_manifest_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/oci_manifest.oo.
//
// Beats:
//   1. Call oci_manifest_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_oci_manifest: PASSED only if they match.

import "std/cloud/oci_manifest.oo";

pub fn main() {
    let a: Int = oci_manifest_probe();
    let b: Int = oci_manifest_probe();
    if a != b {
        println("FAIL oci_manifest_probe");
        process_exit(1);
    }
    println("prod_g2_oci_manifest: PASSED");
}
