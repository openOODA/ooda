// # Product prove std/cloud_k8s/crdt_g_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts g_set_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_g_set.oo.
//
// Beats:
//   1. Call g_set_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crdt_g_set: PASSED only if they match.

import "std/cloud_k8s/crdt_g_set.oo";

pub fn main() {
    let crdt_g_set_mark: Int = 0;
    if crdt_g_set_mark != 0 {
        process_exit(1);
    }
    let a: GSet = g_set_new();
    let b: GSet = g_set_new();
    if (a).e0 != (b).e0 {
        println("FAIL g_set_new");
        process_exit(1);
    }
    println("prod_crdt_g_set: PASSED");
}
