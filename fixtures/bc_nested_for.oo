// # Nested for-range
//
// Logline: Count iterations of a nested 0..3 by 0..2 for-range.
//
// Beats:
//   1. Outer loop runs i in 0..3.
//   2. Inner loop runs j in 0..2 and increments s.
//   3. Print the visit count.

// M6: nested for-range on bytecode interpreter
pub fn main() {
    let mut s = 0;
    for i in 0..3 {
        for j in 0..2 {
            s = s + 1;
        }
    }
    println(s);
}
