// # Product sec smap const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/smap_const.oo.
//
// Setup: Product std/sec/sys/smap_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. cr4 bit 21. rflags ac 18. action panic 2.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/smap_const.oo";

pub fn main() {
    let a: Int = smap_cr4_bit();
    if a != 21 {
        println("FAIL smap cr4");
        process_exit(1);
    }
    let b: Int = smap_rflags_ac_bit();
    if b != 18 {
        println("FAIL smap ac");
        process_exit(1);
    }
    let c: Int = smap_action_panic();
    if c != 2 {
        println("FAIL smap panic");
        process_exit(1);
    }
    println("prod_smapconst: PASSED");
}
