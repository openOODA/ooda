// # Product anonymous pipe prove
//
// Logline: Fail-closed emit+gcc+run of shipped anon_pipe_write/len.
//
// Setup: Product std/io/pipe_anonymous.oo. Write byte 7.
//
// Beats:
//   1. After write 7, len is 1.
//   2. Exit 1 before PASSED on a miss.

import "std/io/pipe_anonymous.oo";

pub fn main() {
    let mut p: AnonPipe = anon_pipe_new();
    p = anon_pipe_write(p, 7);
    let n: Int = anon_pipe_len(p);
    if n != 1 {
        println("FAIL anonpipe len");
        process_exit(1);
    }
    println("prod_anonpipe: PASSED");
}
