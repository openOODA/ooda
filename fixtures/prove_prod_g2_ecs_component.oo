// # Product prove std/game_engine/ecs_component.oo
//
// Logline: Fail-closed emit+gcc+run asserts component_mask_none is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_component.oo.
//
// Beats:
//   1. Call component_mask_none twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ecs_component: PASSED only if they match.

import "std/game_engine/ecs_component.oo";

pub fn main() {
    let ecs_component_mark: Int = 0;
    if ecs_component_mark != 0 {
        process_exit(1);
    }
    let a: Int = component_mask_none();
    let b: Int = component_mask_none();
    if a != b {
        println("FAIL component_mask_none");
        process_exit(1);
    }
    println("prod_g2_ecs_component: PASSED");
}
