// # Product prove std/sec/sys/objcap_registry.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/objcap_registry.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_registry.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_objcap_registry: PASSED and exit 0 only on match.

import "std/sec/sys/objcap_registry.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_sys_objcap_registry_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_sys_objcap_registry_oo();
    if dummy_a != dummy_b {
        println("FAIL objcap_registry dummy");
        process_exit(1);
    }

    let reg_a: ObjectCapabilityRegistry = objcap_registry_init("reg_main");
    let reg_b: ObjectCapabilityRegistry = objcap_registry_init("reg_main");

    let rev_a: Bool = objcap_registry_is_revoked(reg_a, "target_cap_99");
    let rev_b: Bool = objcap_registry_is_revoked(reg_b, "target_cap_99");
    if rev_a != rev_b {
        println("FAIL objcap_registry_is_revoked");
        process_exit(1);
    }

    let empty_a: ObjectCapability = objcap_empty();
    let empty_b: ObjectCapability = objcap_empty();
    let r_a: Int = empty_a.rights;
    let r_b: Int = empty_b.rights;
    if r_a != r_b {
        println("FAIL objcap_empty rights");
        process_exit(1);
    }

    println("prod_g4_sec_objcap_registry: PASSED");
    process_exit(0);
}
