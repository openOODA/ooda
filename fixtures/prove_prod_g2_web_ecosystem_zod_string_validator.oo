// # Product prove std/web_ecosystem/zod_string_validator.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_string_parse_len is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_string_validator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call zod_string_parse_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zod_string_validator: PASSED only if they match.

import "std/web_ecosystem/zod_string_validator.oo";

pub fn main() {
    let g2_oa = zod_string();
    let g2_ob = zod_string();
    let g2_a = zod_string_parse_len(g2_oa, 2);
    let g2_b = zod_string_parse_len(g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL zod_string_parse_len");
        process_exit(1);
    }
    println("prod_g2_zod_string_validator: PASSED");
}
