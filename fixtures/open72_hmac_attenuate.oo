// # Hierarchical HMAC capability attenuation
//
// Logline: Derive a child seal from a parent HMAC; same rights match; other rights and empty fail.
//
// Setup: OPEN-72. cap_attenuate / cap_attenuate_ok HMAC child rights with the parent seal.
//
// Beats:
//   1. Parent seal = HMAC(root, rwx).
//   2. Child read seal is deterministic and not the parent.
//   3. Write child differs. Empty parent is not ok.

pub fn main() {
    let parent: String = crypto_hmac_sha256_internal("root", "rwx");
    let child_a: String = cap_attenuate(parent, "r");
    let child_b: String = cap_attenuate(parent, "r");
    let child_w: String = cap_attenuate(parent, "w");
    if chars_len(child_a) != 64 {
        println("FAIL child len");
        process_exit(1);
    }
    if child_a != child_b {
        println("FAIL match");
        process_exit(1);
    }
    if child_a == parent {
        println("FAIL parent reuse");
        process_exit(1);
    }
    if child_a == child_w {
        println("FAIL rights");
        process_exit(1);
    }
    if !cap_attenuate_ok(parent, "r") {
        println("FAIL ok");
        process_exit(1);
    }
    if cap_attenuate_ok("", "r") {
        println("FAIL empty");
        process_exit(1);
    }
    let grand: String = cap_attenuate(child_a, "r");
    if grand == child_a {
        println("FAIL hierarchy");
        process_exit(1);
    }
    println("open72: PASSED");
}
