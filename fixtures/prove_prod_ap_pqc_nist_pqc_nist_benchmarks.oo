// # Product prove std/pqc_nist/pqc_nist_benchmarks.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pqc_nist/pqc_nist_benchmarks.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_nist_benchmarks.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pqc_nist_benchmarks: PASSED only if they match.

import "std/pqc_nist/pqc_nist_benchmarks.oo";

pub fn main() {
    let pqc_nist_benchmarks_a = benchmark_metric_new("x", "x", 0, 0);
    let pqc_nist_benchmarks_b = benchmark_metric_new("x", "x", 0, 0);
    if pqc_nist_benchmarks_a.algorithm != pqc_nist_benchmarks_b.algorithm {
        println("FAIL pqc_nist_benchmarks");
        process_exit(1);
    }
    println("prod_ap_pqc_nist_benchmarks: PASSED");
}
