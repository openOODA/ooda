// # Product prove std/space_propulsion/interplanetary_porkchop_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts porkchop_evaluate_earth_mars_point is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/interplanetary_porkchop_generator.oo.
//
// Beats:
//   1. Call porkchop_evaluate_earth_mars_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_interplanetary_porkchop_generator: PASSED only if they match.

import "std/space_propulsion/interplanetary_porkchop_generator.oo";

pub fn main() {
    let interplanetary_porkchop_generator_mark: Int = 0;
    if interplanetary_porkchop_generator_mark != 0 {
        process_exit(1);
    }
    let a: PorkchopTransferGridPoint = porkchop_evaluate_earth_mars_point(0.0, 0.0);
    let b: PorkchopTransferGridPoint = porkchop_evaluate_earth_mars_point(0.0, 0.0);
    if (a).is_type_one_transfer != (b).is_type_one_transfer {
        println("FAIL porkchop_evaluate_earth_mars_point");
        process_exit(1);
    }
    println("prod_interplanetary_porkchop_generator: PASSED");
}
