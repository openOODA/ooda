// # Product prove std/formal_verif/model_check_reachability_bfs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/model_check_reachability_bfs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_reachability_bfs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_model_check_reachability_bfs: PASSED only if they match.

import "std/formal_verif/model_check_reachability_bfs.oo";

pub fn main() {
    let model_check_reachability_bfs_a = reachability_node_new(0, true, list_new());
    let model_check_reachability_bfs_b = reachability_node_new(0, true, list_new());
    if model_check_reachability_bfs_a.state_id != model_check_reachability_bfs_b.state_id {
        println("FAIL model_check_reachability_bfs");
        process_exit(1);
    }
    println("prod_ap_model_check_reachability_bfs: PASSED");
}
