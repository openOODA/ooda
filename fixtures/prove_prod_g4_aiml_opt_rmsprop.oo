// # Product prove std/ai_ml/opt_rmsprop.oo
//
// Logline: Fail-closed verification that RMSprop and AdaGrad adaptive optimizer steps are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/opt_rmsprop.oo.
//
// Beats:
//   1. Instantiate RMSpropOptimizer with default learning rate configuration.
//   2. Execute RMSprop gradient update step and assert state increment.
//   3. Execute AdaGrad accumulator update step and verify parameter adjustments.
//   4. Print prod_g4_aiml_opt_rmsprop: PASSED only if all match.

import "std/ai_ml/opt_rmsprop.oo";

pub fn main() {
    let cfg: RMSpropConfig = rmsprop_config_default(0.01);
    if (cfg).lr != 0.01 || (cfg).alpha != 0.99 {
        println("FAIL rmsprop_config_default");
        process_exit(1);
    }

    let mut opt: RMSpropOptimizer = rmsprop_optimizer_new(cfg, 2);
    if (opt).step_count != 0 {
        println("FAIL rmsprop_optimizer_new");
        process_exit(1);
    }

    let mut p_data: List[Float] = list_new();
    p_data = list_push(p_data, 1.0);
    p_data = list_push(p_data, 2.0);
    let param: Tensor1D = Tensor1D { data: p_data, size: 2 };

    let mut g_data: List[Float] = list_new();
    g_data = list_push(g_data, 0.1);
    g_data = list_push(g_data, 0.2);
    let grad: Tensor1D = Tensor1D { data: g_data, size: 2 };

    let updated_p: Tensor1D = rmsprop_step_1d(&mut opt, param, grad);
    if (opt).step_count != 1 || (updated_p).size != 2 {
        println("FAIL rmsprop_step_1d");
        process_exit(1);
    }

    let mut acc: List[Float] = list_new();
    acc = list_push(acc, 0.0);
    acc = list_push(acc, 0.0);
    let ada_p: Tensor1D = adagrad_step_1d(0.01, 0.00000001, acc, param, grad);
    if (ada_p).size != 2 {
        println("FAIL adagrad_step_1d");
        process_exit(1);
    }

    println("prod_g4_aiml_opt_rmsprop: PASSED");
    process_exit(0);
}
