// # Product prove std/telecom/crc_radio.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/crc_radio.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/crc_radio.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crc_radio: PASSED only if they match.

import "std/telecom/crc_radio.oo";

pub fn main() {
    let crc_radio_a = crc_radio_mask_for_width(0);
    let crc_radio_b = crc_radio_mask_for_width(0);
    if crc_radio_a != crc_radio_b {
        println("FAIL crc_radio");
        process_exit(1);
    }
    println("prod_ap_crc_radio: PASSED");
}
