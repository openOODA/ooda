// # Product prove std/synthetic_biology/synthetic_biology_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts synbio_stub_gpu_ssa_throughput_trajectories_per_sec value or determinism.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/synthetic_biology_stubs.oo.
//
// Beats:
//   1. Call synbio_stub_gpu_ssa_throughput_trajectories_per_sec twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_synthetic_biology_stubs: PASSED only if asserts hold.

import "std/synthetic_biology/synthetic_biology_stubs.oo";

pub fn main() {
    let synthetic_biology_stubs_a: Float = synbio_stub_gpu_ssa_throughput_trajectories_per_sec(1);
    let synthetic_biology_stubs_b: Float = synbio_stub_gpu_ssa_throughput_trajectories_per_sec(1);
    if synthetic_biology_stubs_a != synthetic_biology_stubs_b {
        println("FAIL synbio_stub_gpu_ssa_throughput_trajectories_per_sec");
        process_exit(1);
    }
    println("prod_synthetic_biology_stubs: PASSED");
}
