// # Product prove std/quantum_tensor_nets/tdvp_two_site_integrator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_tensor_nets/tdvp_two_site_integrator.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tdvp_two_site_integrator.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_tdvp_two_site_integrator: PASSED only if they match.

import "std/quantum_tensor_nets/tdvp_two_site_integrator.oo";

pub fn main() {
    let tdvp_two_site_integrator_a = tdvp_two_site_config_default(0, 0.0, 0.0);
    let tdvp_two_site_integrator_b = tdvp_two_site_config_default(0, 0.0, 0.0);
    if tdvp_two_site_integrator_a.num_sites != tdvp_two_site_integrator_b.num_sites {
        println("FAIL tdvp_two_site_integrator");
        process_exit(1);
    }
    println("prod_ap_tdvp_two_site_integrator: PASSED");
}
