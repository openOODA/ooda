// # Product prove std/os/path_relative.oo
//
// Logline: Fail-closed emit+gcc+run asserts path_relative_to is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/path_relative.oo.
//
// Beats:
//   1. Call path_relative_to twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_relative: PASSED only if they match.

import "std/os/path_relative.oo";

pub fn main() {
    let a = path_relative_to("x", "x");
    let b = path_relative_to("x", "x");
    if a != b {
        println("FAIL path_relative_to");
        process_exit(1);
    }
    println("prod_path_relative: PASSED");
}
