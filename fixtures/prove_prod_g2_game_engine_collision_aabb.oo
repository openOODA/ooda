// # Product prove std/game_engine/collision_aabb.oo
//
// Logline: Fail-closed emit+gcc+run asserts aabb2d_center_x is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/collision_aabb.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call aabb2d_center_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_collision_aabb: PASSED only if they match.

import "std/game_engine/collision_aabb.oo";

pub fn main() {
    let g2_oa = aabb2d_new(1.0, 1.0, 1.0, 1.0);
    let g2_ob = aabb2d_new(1.0, 1.0, 1.0, 1.0);
    let g2_a = aabb2d_center_x(&g2_oa);
    let g2_b = aabb2d_center_x(&g2_ob);
    if g2_a != g2_b {
        println("FAIL aabb2d_center_x");
        process_exit(1);
    }
    println("prod_g2_collision_aabb: PASSED");
}
