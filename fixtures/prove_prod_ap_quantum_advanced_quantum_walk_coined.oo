// # Product prove std/quantum_advanced/quantum_walk_coined.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/quantum_walk_coined.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_walk_coined.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_quantum_walk_coined: PASSED only if they match.

import "std/quantum_advanced/quantum_walk_coined.oo";

pub fn main() {
    let quantum_walk_coined_a = coined_walk_init(0);
    let quantum_walk_coined_b = coined_walk_init(0);
    if quantum_walk_coined_a.num_positions != quantum_walk_coined_b.num_positions {
        println("FAIL quantum_walk_coined");
        process_exit(1);
    }
    println("prod_ap_quantum_walk_coined: PASSED");
}
