// # Product prove std/grid/solar_mppt.oo
//
// Logline: Fail-closed emit+gcc+run asserts mppt_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_mppt.oo.
//
// Beats:
//   1. Call mppt_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_mppt: PASSED only if they match.

import "std/grid/solar_mppt.oo";

pub fn main() {
    let solar_mppt_mark: Int = 0;
    if solar_mppt_mark != 0 {
        process_exit(1);
    }
    let a: MpptState = mppt_state_new(0, 0.0, 0.0);
    let b: MpptState = mppt_state_new(0, 0.0, 0.0);
    if (a).mode != (b).mode {
        println("FAIL mppt_state_new");
        process_exit(1);
    }
    println("prod_solar_mppt: PASSED");
}
