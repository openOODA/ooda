// # Product prove std/astro_advanced/orbit_cov_propagation.oo
//
// Logline: Fail-closed emit+gcc+run asserts cov_trace is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/orbit_cov_propagation.oo.
//
// Beats:
//   1. Call cov_trace twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbit_cov_propagation: PASSED only if they match.

import "std/astro_advanced/orbit_cov_propagation.oo";

pub fn main() {
    let orbit_cov_propagation_mark: Int = 0;
    if orbit_cov_propagation_mark != 0 {
        process_exit(1);
    }
    let a: Int = cov_trace();
    let b: Int = cov_trace();
    if a != b {
        println("FAIL cov_trace");
        process_exit(1);
    }
    println("prod_orbit_cov_propagation: PASSED");
}
