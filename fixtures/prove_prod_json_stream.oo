// # Product prove std/markup/json_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_stream_has_next is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_stream.oo.
//
// Beats:
//   1. Call json_stream_has_next twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json_stream: PASSED only if they match.

import "std/markup/json_stream.oo";

pub fn main() {
    let obj = json_stream_new("x");
    let a = json_stream_has_next(obj);
    let b = json_stream_has_next(obj);
    if a != b {
        println("FAIL json_stream_has_next");
        process_exit(1);
    }
    println("prod_json_stream: PASSED");
}
