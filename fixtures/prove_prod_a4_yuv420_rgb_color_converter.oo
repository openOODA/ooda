// # Product prove std/media_dsp/yuv420_rgb_color_converter.oo
//
// Logline: Fail-closed emit+gcc+run asserts yuv_clamp_byte is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/yuv420_rgb_color_converter.oo.
//
// Beats:
//   1. Call yuv_clamp_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yuv420_rgb_color_converter: PASSED only if they match.

import "std/media_dsp/yuv420_rgb_color_converter.oo";

pub fn main() {
    let yuv420_rgb_color_converter_mark: Int = 0;
    if yuv420_rgb_color_converter_mark != 0 {
        process_exit(1);
    }
    let a: Int = yuv_clamp_byte(0);
    let b: Int = yuv_clamp_byte(0);
    if a != b {
        println("FAIL yuv_clamp_byte");
        process_exit(1);
    }
    println("prod_yuv420_rgb_color_converter: PASSED");
}
