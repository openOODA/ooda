// # Product prove std/deep_ai/rag_bm25_retriever.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/rag_bm25_retriever.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/rag_bm25_retriever.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rag_bm25_retriever: PASSED only if they match.

import "std/deep_ai/rag_bm25_retriever.oo";

pub fn main() {
    let rag_bm25_retriever_a = rag_bm25_retriever_marker();
    let rag_bm25_retriever_b = rag_bm25_retriever_marker();
    if rag_bm25_retriever_a != rag_bm25_retriever_b {
        println("FAIL rag_bm25_retriever");
        process_exit(1);
    }
    println("prod_ap_rag_bm25_retriever: PASSED");
}
