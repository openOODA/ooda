// # Product prove std/pbr_raytracing/sampling_alias_method.oo
//
// Logline: Fail-closed emit+gcc+run asserts alias_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/sampling_alias_method.oo.
//
// Beats:
//   1. Call alias_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sampling_alias_method: PASSED only if they match.

import "std/pbr_raytracing/sampling_alias_method.oo";

pub fn main() {
    let a: AliasTableEntry = alias_entry_new(0.0, 0);
    let b: AliasTableEntry = alias_entry_new(0.0, 0);
    if a.prob != b.prob {
        println("FAIL alias_entry_new");
        process_exit(1);
    }
    println("prod_sampling_alias_method: PASSED");
}
