// # Product prove std/pbr_raytracing/bvh_traversal_stack.oo
//
// Logline: Fail-closed emit+check references bvh_traversal_stack for type completeness.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/bvh_traversal_stack.oo.
//
// Beats:
//   1. Call bvh_stack_new twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bvh_traversal_stack: PASSED only if they match.

import "std/pbr_raytracing/bvh_traversal_stack.oo";

pub fn main() {
    let bvh_traversal_stack_mark: Int = 0;
    if bvh_traversal_stack_mark != 0 {
        process_exit(1);
    }
    let a: BvhTraversalStack = bvh_stack_new();
    let b: BvhTraversalStack = bvh_stack_new();
    if (a).top != (b).top {
        println("FAIL bvh_stack_new");
        process_exit(1);
    }
    println("prod_bvh_traversal_stack: PASSED");
}
