// # Product prove std/tda_topology/persistence_diagram_features.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistence_diagram_total_persistence is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_diagram_features.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call persistence_diagram_total_persistence twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_persistence_diagram_features: PASSED only if they match.

import "std/tda_topology/persistence_diagram_features.oo";

pub fn main() {
    let g0_oa = persistence_diagram_new(0);
    let g0_ob = persistence_diagram_new(0);
    let g0_a = persistence_diagram_total_persistence(&g0_oa, 0.0);
    let g0_b = persistence_diagram_total_persistence(&g0_ob, 0.0);
    if g0_a != g0_b {
        println("FAIL persistence_diagram_total_persistence");
        process_exit(1);
    }
    println("prod_gr_persistence_diagram_features: PASSED");
}
