// # Product prove std/db_graph/graph_pagerank_iterative.oo
//
// Logline: Fail-closed emit+gcc+run asserts pagerank_init_ranks is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_pagerank_iterative.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call pagerank_init_ranks twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_graph_pagerank_iterative: PASSED only if they match.

import "std/db_graph/graph_pagerank_iterative.oo";

pub fn main() {
    let g0_la = pagerank_init_ranks(0);
    let g0_lb = pagerank_init_ranks(0);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL pagerank_init_ranks");
        process_exit(1);
    }
    println("prod_gr_graph_pagerank_iterative: PASSED");
}
