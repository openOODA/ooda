// # Product prove std/defi_derivatives/implied_volatility_bisection.oo
//
// Logline: Fail-closed emit+gcc+run asserts bisection_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/implied_volatility_bisection.oo.
//
// Beats:
//   1. Call bisection_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_implied_volatility_bisection: PASSED only if they match.

import "std/defi_derivatives/implied_volatility_bisection.oo";

pub fn main() {
    let implied_volatility_bisection_mark: Int = 0;
    if implied_volatility_bisection_mark != 0 {
        process_exit(1);
    }
    let a: Float = bisection_norm_pdf(0.0);
    let b: Float = bisection_norm_pdf(0.0);
    if a != b {
        println("FAIL bisection_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_implied_volatility_bisection: PASSED");
}
