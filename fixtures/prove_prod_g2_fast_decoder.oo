// # Product prove std/fintech/fast_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts fast_apply_copy_operator is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/fast_decoder.oo.
//
// Beats:
//   1. Call fast_apply_copy_operator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fast_decoder: PASSED only if they match.

import "std/fintech/fast_decoder.oo";

pub fn main() {
    let fast_decoder_mark: Int = 0;
    if fast_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = fast_apply_copy_operator(0, true, 0);
    let b: Int = fast_apply_copy_operator(0, true, 0);
    if a != b {
        println("FAIL fast_apply_copy_operator");
        process_exit(1);
    }
    println("prod_g2_fast_decoder: PASSED");
}
