// # Product prove std/3d/lights_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ambient_light_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights_engine.oo.
//
// Beats:
//   1. Call ambient_light_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lights_engine: PASSED only if they match.

import "std/3d/lights_engine.oo";

pub fn main() {
    let lights_engine_mark: Int = 0;
    if lights_engine_mark != 0 {
        process_exit(1);
    }
    let a: AmbientLight = ambient_light_default();
    let b: AmbientLight = ambient_light_default();
    if (a).r != (b).r {
        println("FAIL ambient_light_default");
        process_exit(1);
    }
    println("prod_g2_lights_engine: PASSED");
}
