// # Product prove std/simd/simd_vec4i.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec4i_hadd is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_vec4i.oo.
//
// Beats:
//   1. Call vec4i_hadd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_vec4i: PASSED only if they match.

import "std/simd/simd_vec4i.oo";

pub fn main() {
    let obj = vec4i_new(0, 0, 0, 0);
    let a = vec4i_hadd(obj);
    let b = vec4i_hadd(obj);
    if a != b {
        println("FAIL vec4i_hadd");
        process_exit(1);
    }
    println("prod_simd_vec4i: PASSED");
}
