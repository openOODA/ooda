// # sys_spawn then sys_wait
//
// Logline: Spawn true, wait for any child, print ok on success.
//
// Setup: Backend-C emit fixture. sys is SysCap or ProcessCap. Runtime fork+waitpid.
//
// Beats:
//   1. sys_spawn of true returns Ok.
//   2. sys_wait(-1) reaps the child.
//   3. Print ok.

pub fn main(sys: &SysCap) {
    match sys_spawn(sys, "true") {
        Ok(s) => {
            match sys_wait(sys, -1) {
                Ok(st) => println("ok"),
                Err(e) => println(e),
            }
        }
        Err(e) => println(e),
    }
}
