// # Product prove std/encoding/varint.oo
//
// Logline: Fail-closed emit+gcc+run asserts varint_encoded_len value or determinism.
//
// Setup: Isolated emit-c. Imports std/encoding/varint.oo.
//
// Beats:
//   1. Call varint_encoded_len twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_varint: PASSED only if asserts hold.

import "std/encoding/varint.oo";

pub fn main() {
    let varint: Int = varint_encoded_len(1);
    let varint_b: Int = varint_encoded_len(1);
    if varint != 1 {
        println("FAIL varint_encoded_len");
        process_exit(1);
    }
    if varint != varint_b {
        println("FAIL varint_encoded_len det");
        process_exit(1);
    }
    println("prod_varint: PASSED");
}
