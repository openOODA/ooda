// # if 1 + 2 == 3 is leftover
//
// Logline: ALU compare cond must fail closed and not emit THEN.
//
// Setup: Folded INT==INT requires INT OP INT LBRACE, not PLUS in the cond.
//
// Beats:
//   1. if 1 + 2 == 3 print THEN.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if 1 + 2 == 3 {
        println("THEN");
    }
}
