// # Product prove std/scicomp/cholesky_decomp.oo
//
// Logline: Fail-closed emit+gcc+run asserts cholesky_decomp_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/cholesky_decomp.oo.
//
// Beats:
//   1. Call cholesky_decomp_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_cholesky_decomp: PASSED only if it matches.

import "std/scicomp/cholesky_decomp.oo";

pub fn main() {
    let a: Int = cholesky_decomp_probe();
    if a != 0 {
        println("FAIL cholesky_decomp_probe");
        process_exit(1);
    }
    println("prod_nc_cholesky_decomp: PASSED");
}
