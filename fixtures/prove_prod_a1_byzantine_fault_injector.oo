// # Product prove std/bft_consensus/byzantine_fault_injector.oo
//
// Logline: Fail-closed emit+gcc+run asserts fault_injection_config_clean is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/byzantine_fault_injector.oo.
//
// Beats:
//   1. Call fault_injection_config_clean twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_byzantine_fault_injector: PASSED only if they match.

import "std/bft_consensus/byzantine_fault_injector.oo";

pub fn main() {
    let byzantine_fault_injector_mark: Int = 0;
    if byzantine_fault_injector_mark != 0 {
        process_exit(1);
    }
    let a: FaultInjectionConfig = fault_injection_config_clean();
    let b: FaultInjectionConfig = fault_injection_config_clean();
    if (a).inject_equivocation != (b).inject_equivocation {
        println("FAIL fault_injection_config_clean");
        process_exit(1);
    }
    println("prod_byzantine_fault_injector: PASSED");
}
