// # Product prove std/synthetic_biology/feed_forward_loop_motif.oo
//
// Logline: Fail-closed emit+gcc+run asserts ffl_pow is a real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/feed_forward_loop_motif.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ffl_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_feed_forward_loop_motif: PASSED only if they match.

import "std/synthetic_biology/feed_forward_loop_motif.oo";

pub fn main() {
    let g0_a = ffl_pow(0.0, 0);
    let g0_b = ffl_pow(0.0, 0);
    if g0_a != g0_b {
        println("FAIL ffl_pow");
        process_exit(1);
    }
    println("prod_gr_feed_forward_loop_motif: PASSED");
}
