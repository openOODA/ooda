// # Untyped struct let emit lock
//
// Logline: Fail-closed emit+gcc+run of untyped let copy of a user struct.
//
// Setup: Backend-C. let x = make() must keep Node, not default to long long.
//
// Beats:
//   1. make returns Node id 1.
//   2. let x = make(); let y = x; read y.id.
//   3. Exit 1 before PASSED when y.id is not 1.

type Node = struct {
    id: Int
};

fn make() -> Node {
    return Node { id: 1 };
}

pub fn main() {
    let x = make();
    let y = x;
    if y.id != 1 {
        println("FAIL");
        process_exit(1);
    }
    println("untyped_struct_let: PASSED");
}
