// # Product prove std/bft_consensus/bft_consensus_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts bft_consensus_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/bft_consensus_stubs.oo.
//
// Beats:
//   1. Call bft_consensus_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bft_consensus_stubs: PASSED only if they match.

import "std/bft_consensus/bft_consensus_stubs.oo";

pub fn main() {
    let bft_consensus_stubs_mark: Int = 0;
    if bft_consensus_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = bft_consensus_fail_closed("x", 0);
    let b: Bool = bft_consensus_fail_closed("x", 0);
    if a != b {
        println("FAIL bft_consensus_fail_closed");
        process_exit(1);
    }
    println("prod_bft_consensus_stubs: PASSED");
}
