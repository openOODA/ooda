// # Product prove std/auto/mpc_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/mpc_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/mpc_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mpc_ops: PASSED only if they match.

import "std/auto/mpc_ops.oo";

pub fn main() {
    let mpc_ops_a = mpc_pi();
    let mpc_ops_b = mpc_pi();
    if mpc_ops_a != mpc_ops_b {
        println("FAIL mpc_ops");
        process_exit(1);
    }
    println("prod_ap_mpc_ops: PASSED");
}
