// # Product prove std/tda_topology/persistent_homology_barcodes.oo
//
// Logline: Fail-closed emit+gcc+run asserts barcode_interval_persistence is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistent_homology_barcodes.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call barcode_interval_persistence twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_persistent_homology_barcodes: PASSED only if they match.

import "std/tda_topology/persistent_homology_barcodes.oo";

pub fn main() {
    let g0_oa: BarcodeInterval = BarcodeInterval { dimension: 0, birth: 0.0, death: 0.0, is_infinite: true, interval_id: 0 };
    let g0_ob: BarcodeInterval = BarcodeInterval { dimension: 0, birth: 0.0, death: 0.0, is_infinite: true, interval_id: 0 };
    let g0_a = barcode_interval_persistence(&g0_oa);
    let g0_b = barcode_interval_persistence(&g0_ob);
    if g0_a != g0_b {
        println("FAIL barcode_interval_persistence");
        process_exit(1);
    }
    println("prod_gr_persistent_homology_barcodes: PASSED");
}
