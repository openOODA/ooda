// # Product prove std/lidar_perception/sensor_fusion_camera_lidar.oo
//
// Logline: Fail-closed emit+gcc+run asserts rgb_color_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/sensor_fusion_camera_lidar.oo.
//
// Beats:
//   1. Call rgb_color_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sensor_fusion_camera_lidar: PASSED only if they match.

import "std/lidar_perception/sensor_fusion_camera_lidar.oo";

pub fn main() {
    let sensor_fusion_camera_lidar_mark: Int = 0;
    if sensor_fusion_camera_lidar_mark != 0 {
        process_exit(1);
    }
    let a: RGBColor = rgb_color_new(0, 0, 0);
    let b: RGBColor = rgb_color_new(0, 0, 0);
    if (a).r != (b).r {
        println("FAIL rgb_color_new");
        process_exit(1);
    }
    println("prod_g2_sensor_fusion_camera_lidar: PASSED");
}
