// # Product prove std/db_graph/graph_random_walk.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_node2vec_alpha is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_random_walk.oo.
//
// Beats:
//   1. Call compute_node2vec_alpha twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_random_walk: PASSED only if they match.

import "std/db_graph/graph_random_walk.oo";

pub fn main() {
    let graph_random_walk_mark: Int = 0;
    if graph_random_walk_mark != 0 {
        process_exit(1);
    }
    let a: Float = compute_node2vec_alpha(0, 0.0, 0.0);
    let b: Float = compute_node2vec_alpha(0, 0.0, 0.0);
    if a != b {
        println("FAIL compute_node2vec_alpha");
        process_exit(1);
    }
    println("prod_graph_random_walk: PASSED");
}
