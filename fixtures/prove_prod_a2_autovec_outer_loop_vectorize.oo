// # Product prove std/compilers_polyhedral/autovec_outer_loop_vectorize.oo
//
// Logline: Fail-closed emit+gcc+run asserts outer_loop_vector_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_outer_loop_vectorize.oo.
//
// Beats:
//   1. Call outer_loop_vector_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_outer_loop_vectorize: PASSED only if they match.

import "std/compilers_polyhedral/autovec_outer_loop_vectorize.oo";

pub fn main() {
    let autovec_outer_loop_vectorize_mark: Int = 0;
    if autovec_outer_loop_vectorize_mark != 0 {
        process_exit(1);
    }
    let a: OuterLoopVectorConfig = outer_loop_vector_config_new(0, 0, 0);
    let b: OuterLoopVectorConfig = outer_loop_vector_config_new(0, 0, 0);
    if (a).outer_loop_id != (b).outer_loop_id {
        println("FAIL outer_loop_vector_config_new");
        process_exit(1);
    }
    println("prod_autovec_outer_loop_vectorize: PASSED");
}
