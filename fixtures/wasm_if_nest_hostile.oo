// # Hostile nested if true { if x } fold
//
// Logline: Print fold-me or other from nested IDENT if so emit-wasm must miss a const-nest fold.
//
// Setup: One public main. Inner condition is IDENT x.
//
// Beats:
//   1. Let x be true.
//   2. Outer if true, inner if x print fold-me else other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = true;
    if true {
        if x {
            println("fold-me");
        } else {
            println("other");
        }
    } else {
        println("outer");
    }
}
