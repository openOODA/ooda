// # Product diag log levels prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/log.oo.
//
// Setup: Product std/diag/log.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. TRACE is 10, FATAL is 60.
//   2. log_level_name 30 is INFO.
//   3. should_emit respects min severity.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/log.oo";

pub fn main() {
    let t: Int = log_level_trace();
    if t != 10 {
        println("FAIL log trace");
        process_exit(1);
    }
    let f: Int = log_level_fatal();
    if f != 60 {
        println("FAIL log fatal");
        process_exit(1);
    }
    let nm: String = log_level_name(30);
    if nm != "INFO" {
        println("FAIL log name info");
        process_exit(1);
    }
    let lg: Logger = logger_new(30, "app");
    if log_should_emit(lg, 20) {
        println("FAIL log debug blocked");
        process_exit(1);
    }
    if log_should_emit(lg, 30) == false {
        println("FAIL log info emit");
        process_exit(1);
    }
    println("prod_loglvl: PASSED");
}
