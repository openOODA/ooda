// # Product prove std/crispr_cas/base_editing_glycosylase_cgbe.oo
//
// Logline: Fail-closed emit+gcc+run asserts base_editing_glycosylase_cgbe_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/base_editing_glycosylase_cgbe.oo.
//
// Beats:
//   1. Call base_editing_glycosylase_cgbe_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_base_editing_glycosylase_cgbe: PASSED only if they match.

import "std/crispr_cas/base_editing_glycosylase_cgbe.oo";

pub fn main() {
    let a = base_editing_glycosylase_cgbe_probe();
    let b = base_editing_glycosylase_cgbe_probe();
    if a != b {
        println("FAIL base_editing_glycosylase_cgbe_probe");
        process_exit(1);
    }
    println("prod_base_editing_glycosylase_cgbe: PASSED");
}
