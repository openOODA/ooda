// # Product prove std/astrophysics_relativity/cosmological_inflation_slow_roll.oo
//
// Logline: Fail-closed emit+gcc+run asserts inflation_starobinsky_model is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_inflation_slow_roll.oo.
//
// Beats:
//   1. Call inflation_starobinsky_model twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cosmological_inflation_slow_roll: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_inflation_slow_roll.oo";

pub fn main() {
    let cosmological_inflation_slow_roll_mark: Int = 0;
    if cosmological_inflation_slow_roll_mark != 0 {
        process_exit(1);
    }
    let a: InflationObservables = inflation_starobinsky_model(0.0);
    let b: InflationObservables = inflation_starobinsky_model(0.0);
    if (a).num_efolds_n != (b).num_efolds_n {
        println("FAIL inflation_starobinsky_model");
        process_exit(1);
    }
    println("prod_cosmological_inflation_slow_roll: PASSED");
}
