// # Product prove std/graph_networks/symphony_small_world_dht.oo
//
// Logline: Fail-closed emit+gcc+run asserts symphony_create_node is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/symphony_small_world_dht.oo.
//
// Beats:
//   1. Call symphony_create_node twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_symphony_small_world_dht: PASSED only if they match.

import "std/graph_networks/symphony_small_world_dht.oo";

pub fn main() {
    let a: SymphonyNode = symphony_create_node(0, 0);
    let b: SymphonyNode = symphony_create_node(0, 0);
    if a.node_id != b.node_id {
        println("FAIL symphony_create_node");
        process_exit(1);
    }
    println("prod_symphony_small_world_dht: PASSED");
}
