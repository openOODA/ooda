// # Product cloud circuit breaker state name prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud/circuit_breaker.oo.
//
// Setup: Product std/cloud/circuit_breaker.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. state 0 CLOSED, 1 OPEN, 2 HALF_OPEN, 9 UNKNOWN.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud/circuit_breaker.oo";

pub fn main() {
    let a: String = circuit_breaker_get_state_name(0);
    if a != "CLOSED" {
        println("FAIL cb closed");
        process_exit(1);
    }
    let b: String = circuit_breaker_get_state_name(1);
    if b != "OPEN" {
        println("FAIL cb open");
        process_exit(1);
    }
    let c: String = circuit_breaker_get_state_name(2);
    if c != "HALF_OPEN" {
        println("FAIL cb half");
        process_exit(1);
    }
    let d: String = circuit_breaker_get_state_name(9);
    if d != "UNKNOWN" {
        println("FAIL cb unk");
        process_exit(1);
    }
    println("prod_cbname: PASSED");
}
