// # Product prove std/auto/behavior_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts beh_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior_ops.oo.
//
// Beats:
//   1. Call beh_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_behavior_ops: PASSED only if they match.

import "std/auto/behavior_ops.oo";

pub fn main() {
    let behavior_ops_mark: Int = 0;
    if behavior_ops_mark != 0 {
        process_exit(1);
    }
    let a: BehOp = beh_op_new(0, 0);
    let b: BehOp = beh_op_new(0, 0);
    if (a).tree_id != (b).tree_id {
        println("FAIL beh_op_new");
        process_exit(1);
    }
    println("prod_behavior_ops: PASSED");
}
