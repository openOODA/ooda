// # Product prove std/defi_derivatives/bachelier_normal_options.oo
//
// Logline: Fail-closed emit+gcc+run asserts bachelier_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/bachelier_normal_options.oo.
//
// Beats:
//   1. Call bachelier_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bachelier_normal_options: PASSED only if they match.

import "std/defi_derivatives/bachelier_normal_options.oo";

pub fn main() {
    let bachelier_normal_options_mark: Int = 0;
    if bachelier_normal_options_mark != 0 {
        process_exit(1);
    }
    let a: Float = bachelier_norm_pdf(0.0);
    let b: Float = bachelier_norm_pdf(0.0);
    if a != b {
        println("FAIL bachelier_norm_pdf");
        process_exit(1);
    }
    println("prod_bachelier_normal_options: PASSED");
}
