// # Product prove std/telecom_6g/thz_molecular_absorption_loss.oo
//
// Logline: Fail-closed verification that sub-THz atmospheric gas medium and molecular absorption evaluations are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_molecular_absorption_loss.oo.
//
// Beats:
//   1. Construct standard sea level and dry atmosphere gas medium models.
//   2. Calculate water vapor density and resonance peak coefficients.
//   3. Evaluate molecular absorption loss and transmittance over distance.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_thz: PASSED and exit 0.

import "std/telecom_6g/thz_molecular_absorption_loss.oo";

pub fn main() {
    let med_a: ThzGasMedium = thz_gas_medium_standard_sea_level();
    let med_b: ThzGasMedium = thz_gas_medium_standard_sea_level();

    if (med_a).temperature_k != (med_b).temperature_k || (med_a).temperature_k != 293.15 {
        println("FAIL thz_gas_medium_standard_sea_level temperature_k");
        process_exit(1);
    }

    if (med_a).pressure_hpa != (med_b).pressure_hpa || (med_a).pressure_hpa != 1013.25 {
        println("FAIL thz_gas_medium_standard_sea_level pressure_hpa");
        process_exit(1);
    }

    let rho_a: Float = thz_calc_water_vapor_density(293.15, 50.0);
    let rho_b: Float = thz_calc_water_vapor_density(293.15, 50.0);
    if rho_a != rho_b || rho_a <= 0.0 {
        println("FAIL thz_calc_water_vapor_density");
        process_exit(1);
    }

    let res_a: ThzAbsorptionResult = thz_molecular_absorption_eval(300.0, 100.0, med_a);
    let res_b: ThzAbsorptionResult = thz_molecular_absorption_eval(300.0, 100.0, med_b);

    if (res_a).absorption_coeff_m_inv != (res_b).absorption_coeff_m_inv {
        println("FAIL thz_molecular_absorption_eval absorption_coeff_m_inv");
        process_exit(1);
    }

    if (res_a).attenuation_db_per_km != (res_b).attenuation_db_per_km {
        println("FAIL thz_molecular_absorption_eval attenuation_db_per_km");
        process_exit(1);
    }

    if (res_a).transmittance_factor != (res_b).transmittance_factor {
        println("FAIL thz_molecular_absorption_eval transmittance_factor");
        process_exit(1);
    }

    println("prod_g4_telecom_thz: PASSED");
    process_exit(0);
}
