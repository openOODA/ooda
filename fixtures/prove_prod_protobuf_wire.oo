// # Product prove std/markup/protobuf_wire.oo
//
// Logline: Fail-closed emit+gcc+run asserts pb_wire_varint is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/protobuf_wire.oo.
//
// Beats:
//   1. Call pb_wire_varint twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protobuf_wire: PASSED only if they match.

import "std/markup/protobuf_wire.oo";

pub fn main() {
    let a = pb_wire_varint();
    let b = pb_wire_varint();
    if a != b {
        println("FAIL pb_wire_varint");
        process_exit(1);
    }
    println("prod_protobuf_wire: PASSED");
}
