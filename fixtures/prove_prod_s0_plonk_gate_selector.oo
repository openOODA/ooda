// # Product prove std/zk_rollup/plonk_gate_selector.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_gate_selectors_arithmetic_add value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_gate_selector.oo.
//
// Beats:
//   1. Call plonk_gate_selectors_arithmetic_add twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_plonk_gate_selector: PASSED only if asserts hold.

import "std/zk_rollup/plonk_gate_selector.oo";

pub fn main() {
    let plonk_gate_selector_a = plonk_gate_selectors_arithmetic_add(1);
    let plonk_gate_selector_b = plonk_gate_selectors_arithmetic_add(1);
    if plonk_gate_selector_a.q_l != plonk_gate_selector_b.q_l {
        println("FAIL plonk_gate_selectors_arithmetic_add");
        process_exit(1);
    }
    println("prod_plonk_gate_selector: PASSED");
}
