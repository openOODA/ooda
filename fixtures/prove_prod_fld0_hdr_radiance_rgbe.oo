// # Product prove std/media_dsp/hdr_radiance_rgbe.oo
//
// Logline: Fail-closed emit+gcc+run asserts hdr_rgbe_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/hdr_radiance_rgbe.oo.
//
// Beats:
//   1. Call hdr_rgbe_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hdr_radiance_rgbe: PASSED only if they match.

import "std/media_dsp/hdr_radiance_rgbe.oo";

pub fn main() {
    let hdr_radiance_rgbe_mark: Int = 0;
    if hdr_radiance_rgbe_mark != 0 {
        process_exit(1);
    }
    let hdr_radiance_rgbe_a = hdr_rgbe_new(1, 1, 1, 1);
    let hdr_radiance_rgbe_b = hdr_rgbe_new(1, 1, 1, 1);
    if (hdr_radiance_rgbe_a).r != (hdr_radiance_rgbe_b).r {
        println("FAIL hdr_rgbe_new");
        process_exit(1);
    }
    println("prod_hdr_radiance_rgbe: PASSED");
}
