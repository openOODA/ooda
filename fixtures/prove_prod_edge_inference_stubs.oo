// # Product prove std/edge/inference_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts inference_engine_run_raw_weights is a fail-closed stub.
//
// Setup: Isolated emit-c. Imports std/edge/inference_stubs.oo.
//
// Beats:
//   1. Call inference_engine_run_raw_weights twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_inference_stubs: PASSED only if they match.

import "std/edge/inference_stubs.oo";

pub fn main() {
    let inference_stubs_mark: Int = 0;
    if inference_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = inference_engine_run_raw_weights(InferenceEngine { config: ModelConfig { model_id: 0, input_dim: 0, output_dim: 0, quant_level: 0, device_backend: 0, max_batch_size: 0, latency_target_ms: 0, memory_budget_mb: 0 }, metrics: InferenceMetrics { total_inferences: 0, successful_inferences: 0, failed_inferences: 0, total_latency_ms: 0, avg_latency_ms: 0, peak_latency_ms: 0, throughput_qps: 0, error_rate: 0.0, last_error_code: 0 }, is_initialized: false, is_warm: false, current_temperature_c: 0, power_consumption_mw: 0, last_status_code: 0, last_output_score: 0, last_latency_ms: 0 }, 0, 0);
    let b: Int = inference_engine_run_raw_weights(InferenceEngine { config: ModelConfig { model_id: 0, input_dim: 0, output_dim: 0, quant_level: 0, device_backend: 0, max_batch_size: 0, latency_target_ms: 0, memory_budget_mb: 0 }, metrics: InferenceMetrics { total_inferences: 0, successful_inferences: 0, failed_inferences: 0, total_latency_ms: 0, avg_latency_ms: 0, peak_latency_ms: 0, throughput_qps: 0, error_rate: 0.0, last_error_code: 0 }, is_initialized: false, is_warm: false, current_temperature_c: 0, power_consumption_mw: 0, last_status_code: 0, last_output_score: 0, last_latency_ms: 0 }, 0, 0);
    if a != b {
        println("FAIL inference_engine_run_raw_weights");
        process_exit(1);
    }
    println("prod_inference_stubs: PASSED");
}
