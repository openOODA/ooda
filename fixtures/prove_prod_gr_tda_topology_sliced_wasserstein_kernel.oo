// # Product prove std/tda_topology/sliced_wasserstein_kernel.oo
//
// Logline: Fail-closed emit+gcc+run asserts project_point_on_theta is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sliced_wasserstein_kernel.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call project_point_on_theta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_sliced_wasserstein_kernel: PASSED only if they match.

import "std/tda_topology/sliced_wasserstein_kernel.oo";

pub fn main() {
    let g0_oa: SwPoint = SwPoint { birth: 0.0, death: 0.0 };
    let g0_ob: SwPoint = SwPoint { birth: 0.0, death: 0.0 };
    let g0_a = project_point_on_theta(&g0_oa, 0.0);
    let g0_b = project_point_on_theta(&g0_ob, 0.0);
    if g0_a != g0_b {
        println("FAIL project_point_on_theta");
        process_exit(1);
    }
    println("prod_gr_sliced_wasserstein_kernel: PASSED");
}
