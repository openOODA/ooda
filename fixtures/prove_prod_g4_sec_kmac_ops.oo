// # Product prove std/sec/crypto/kmac_ops.oo
//
// Logline: Fail-closed verification that NIST SP 800-185 left/right encoding, bytepad, and KMAC configs are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac_ops.oo.
//
// Beats:
//   1. Perform NIST SP 800-185 left_encode and right_encode operations.
//   2. Encode strings with length prefixes and apply bytepad framing.
//   3. Construct KmacConfig and inspect configuration parameters.
//   4. Print prod_g4_sec_kmac_ops: PASSED and exit 0.

import "std/sec/crypto/kmac_ops.oo";

pub fn main() {
    let l_res_a: Result[String, String] = left_encode(0);
    let l_res_b: Result[String, String] = left_encode(0);
    let l_str_a: String = match l_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let l_str_b: String = match l_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if l_str_a != l_str_b || l_str_a.len() != 2 {
        println("FAIL left_encode 0");
        process_exit(1);
    }

    let r_res_a: Result[String, String] = right_encode(0);
    let r_res_b: Result[String, String] = right_encode(0);
    let r_str_a: String = match r_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let r_str_b: String = match r_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if r_str_a != r_str_b || r_str_a.len() != 2 {
        println("FAIL right_encode 0");
        process_exit(1);
    }

    let enc_res_a: Result[String, String] = encode_string("KMAC");
    let enc_res_b: Result[String, String] = encode_string("KMAC");
    let enc_a: String = match enc_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let enc_b: String = match enc_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if enc_a != enc_b || !str_ends_with(enc_a, "KMAC") {
        println("FAIL encode_string");
        process_exit(1);
    }

    let bpad_res_a: Result[String, String] = bytepad("data", 8);
    let bpad_res_b: Result[String, String] = bytepad("data", 8);
    let bpad_a: String = match bpad_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let bpad_b: String = match bpad_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if bpad_a != bpad_b || (bpad_a.len() % 8) != 0 {
        println("FAIL bytepad");
        process_exit(1);
    }

    let cfg: KmacConfig = kmac_config_new(168, 440, 256);
    let rate: Int = kmac_config_rate(cfg);
    if rate != 168 {
        println("FAIL kmac_config_rate");
        process_exit(1);
    }

    println("prod_g4_sec_kmac_ops: PASSED");
    process_exit(0);
}
