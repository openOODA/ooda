// # Product prove std/edge/ota_stubs.oo
//
// Logline: Fail-closed verification that OTA stub imports and partition slot configurations are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/ota_stubs.oo.
//
// Beats:
//   1. Construct partition slots and manifest descriptors.
//   2. Validate slot active state and version calculations.
//   3. Assert deterministic return values.
//   4. Print prod_g4_edge_ota_stubs: PASSED and exit 0.

import "std/edge/ota_stubs.oo";

pub fn main() {
    let slot_a: OtaPartitionSlot = ota_slot_new(1, true, true, 20100);
    let slot_b: OtaPartitionSlot = ota_slot_new(1, true, true, 20100);
    if (slot_a).slot_id != (slot_b).slot_id || (slot_a).version_code != (slot_b).version_code {
        println("FAIL ota_slot_new deterministic");
        process_exit(1);
    }
    if !(slot_a).is_active || !(slot_a).is_bootable {
        println("FAIL ota_slot_new flags");
        process_exit(1);
    }

    let inact_a: OtaPartitionSlot = ota_slot_inactive();
    let inact_b: OtaPartitionSlot = ota_slot_inactive();
    if (inact_a).is_active != (inact_b).is_active || (inact_a).is_active != false {
        println("FAIL ota_slot_inactive");
        process_exit(1);
    }

    let man_a: OtaManifest = ota_manifest_new(2, 1, 0, 100, 4096, 99999, true, false);
    let man_b: OtaManifest = ota_manifest_new(2, 1, 0, 100, 4096, 99999, true, false);
    let code_a: Int = ota_manifest_version_code(&man_a);
    let code_b: Int = ota_manifest_version_code(&man_b);
    if code_a != code_b || code_a != 20100 {
        println("FAIL ota_manifest_version_code");
        process_exit(1);
    }

    let val_a: Bool = ota_manifest_is_valid(&man_a);
    let val_b: Bool = ota_manifest_is_valid(&man_b);
    if val_a != val_b || !val_a {
        println("FAIL ota_manifest_is_valid");
        process_exit(1);
    }

    println("prod_g4_edge_ota_stubs: PASSED");
    process_exit(0);
}
