// # Product prove std/auto_mpc_control/path_tracking_vector_field.oo
//
// Logline: Fail-closed emit+gcc+run asserts vfg_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/path_tracking_vector_field.oo.
//
// Beats:
//   1. Call vfg_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_tracking_vector_field: PASSED only if they match.

import "std/auto_mpc_control/path_tracking_vector_field.oo";

pub fn main() {
    let a: VFGConfig = vfg_config_default();
    let b: VFGConfig = vfg_config_default();
    if a.chi_inf_rad != b.chi_inf_rad {
        println("FAIL vfg_config_default");
        process_exit(1);
    }
    println("prod_path_tracking_vector_field: PASSED");
}
