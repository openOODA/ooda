// # Product prove std/media_dsp/synth_oscillator_polyblep.oo
//
// Logline: Fail-closed emit+gcc+run asserts synth_poly_blep real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_oscillator_polyblep.oo.
//
// Beats:
//   1. Call synth_poly_blep with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_oscillator_polyblep: PASSED only if the assert holds.

import "std/media_dsp/synth_oscillator_polyblep.oo";

pub fn main() {
    let synth_oscillator_polyblep_n: Float = synth_poly_blep(0.0, 0.0);
    if !(synth_oscillator_polyblep_n == 0.0) {
        println("FAIL synth_poly_blep");
        process_exit(1);
    }
    println("prod_synth_oscillator_polyblep: PASSED");
}
