// # Product prove std/deep_ai/speculative_decode_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts speculative_verifier_new real value.
//
// Setup: Isolated emit-c. Imports std/deep_ai/speculative_decode_verifier.oo.
//
// Beats:
//   1. Call speculative_verifier_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_speculative_decode_verifier: PASSED only if the assert holds.

import "std/deep_ai/speculative_decode_verifier.oo";

pub fn main() {
    let speculative_decode_verifier_a = speculative_verifier_new(7, 7);
    let speculative_decode_verifier_gamma: Int = (speculative_decode_verifier_a).gamma;
    if speculative_decode_verifier_gamma != 7 {
        println("FAIL speculative_verifier_new");
        process_exit(1);
    }
    println("prod_speculative_decode_verifier: PASSED");
}
