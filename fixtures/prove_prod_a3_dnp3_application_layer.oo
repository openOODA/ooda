// # Product prove std/iot_scada/dnp3_application_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts dnp3_fc_read is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_application_layer.oo.
//
// Beats:
//   1. Call dnp3_fc_read twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dnp3_application_layer: PASSED only if they match.

import "std/iot_scada/dnp3_application_layer.oo";

pub fn main() {
    let dnp3_application_layer_mark: Int = 0;
    if dnp3_application_layer_mark != 0 {
        process_exit(1);
    }
    let a: Int = dnp3_fc_read();
    let b: Int = dnp3_fc_read();
    if a != b {
        println("FAIL dnp3_fc_read");
        process_exit(1);
    }
    println("prod_dnp3_application_layer: PASSED");
}
