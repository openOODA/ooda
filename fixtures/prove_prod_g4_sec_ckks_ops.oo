// # Product prove std/sec/crypto/ckks_ops.oo
//
// Logline: Fail-closed verification that CKKS complex arithmetic, checksums, and parameter validation are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ckks_ops.oo.
//
// Beats:
//   1. Call probe function ckks_ops_probe and verify deterministic return.
//   2. Validate DJB2 checksum calculation across strings.
//   3. Perform CKKS complex number addition, subtraction, and multiplication.
//   4. Construct and validate CKKS parameters.
//   5. Print prod_g4_sec_ckks_ops: PASSED and exit 0.

import "std/sec/crypto/ckks_ops.oo";

pub fn main() {
    let probe_a: Int = ckks_ops_probe();
    let probe_b: Int = ckks_ops_probe();
    if probe_a != probe_b || probe_a != 0 {
        println("FAIL ckks_ops_probe");
        process_exit(1);
    }

    let chk_a: Int = ckks_calculate_checksum("ckks_ciphertext_poly_repr");
    let chk_b: Int = ckks_calculate_checksum("ckks_ciphertext_poly_repr");
    if chk_a != chk_b {
        println("FAIL ckks_calculate_checksum");
        process_exit(1);
    }

    let c1: CkksComplex = ckks_complex_create(3.0, 4.0);
    let c2: CkksComplex = ckks_complex_create(1.0, 2.0);

    let sum_a: CkksComplex = ckks_complex_add(c1, c2);
    let sum_b: CkksComplex = ckks_complex_add(c1, c2);
    if (sum_a).real != (sum_b).real || (sum_a).real != 4.0 {
        println("FAIL ckks_complex_add real");
        process_exit(1);
    }
    if (sum_a).imag != (sum_b).imag || (sum_a).imag != 6.0 {
        println("FAIL ckks_complex_add imag");
        process_exit(1);
    }

    let diff_a: CkksComplex = ckks_complex_sub(c1, c2);
    let diff_b: CkksComplex = ckks_complex_sub(c1, c2);
    if (diff_a).real != (diff_b).real || (diff_a).real != 2.0 {
        println("FAIL ckks_complex_sub real");
        process_exit(1);
    }
    if (diff_a).imag != (diff_b).imag || (diff_a).imag != 2.0 {
        println("FAIL ckks_complex_sub imag");
        process_exit(1);
    }

    let prod_a: CkksComplex = ckks_complex_mul(c1, c2);
    let prod_b: CkksComplex = ckks_complex_mul(c1, c2);
    // (3 + 4i)(1 + 2i) = 3 + 6i + 4i - 8 = -5 + 10i
    if (prod_a).real != (prod_b).real || (prod_a).real != 0.0 - 5.0 {
        println("FAIL ckks_complex_mul real");
        process_exit(1);
    }
    if (prod_a).imag != (prod_b).imag || (prod_a).imag != 10.0 {
        println("FAIL ckks_complex_mul imag");
        process_exit(1);
    }

    let params_a: CkksParams = ckks_params_create(4096, 40.0, 30, 128);
    let params_b: CkksParams = ckks_params_create(4096, 40.0, 30, 128);
    if (params_a).poly_modulus_degree != (params_b).poly_modulus_degree || (params_a).poly_modulus_degree != 4096 {
        println("FAIL ckks_params_create degree");
        process_exit(1);
    }
    if (params_a).slots_count != (params_b).slots_count || (params_a).slots_count != 2048 {
        println("FAIL ckks_params_create slots");
        process_exit(1);
    }

    let val_res_a: Result[Bool, String] = ckks_params_validate(&params_a);
    let is_v: Bool = val_res_a.is_ok();
    if !is_v {
        println("FAIL ckks_params_validate");
        process_exit(1);
    }

    println("prod_g4_sec_ckks_ops: PASSED");
    process_exit(0);
}
