// # Product prove std/graph_topology/graph_edge_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts edge_list_add_edge is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_edge_list.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call edge_list_add_edge twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_graph_edge_list: PASSED only if they match.

import "std/graph_topology/graph_edge_list.oo";

pub fn main() {
    let mut g0_oa = edge_list_create(true);
    let mut g0_ob = edge_list_create(true);
    let g0_a = edge_list_add_edge(&g0_oa, 0, 0, 0);
    let g0_b = edge_list_add_edge(&g0_ob, 0, 0, 0);
    if g0_a != g0_b {
        println("FAIL edge_list_add_edge");
        process_exit(1);
    }
    println("prod_gr_graph_edge_list: PASSED");
}
