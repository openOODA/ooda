// # Product prove std/perf/lockfree_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/lockfree_queue.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/lockfree_queue.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lockfree_queue: PASSED only if they match.

import "std/perf/lockfree_queue.oo";

pub fn main() {
    let lockfree_queue_a = spsc_queue_create("x", 0);
    let lockfree_queue_b = spsc_queue_create("x", 0);
    let lockfree_queue_va = spsc_queue_peek(lockfree_queue_a);
    let lockfree_queue_vb = spsc_queue_peek(lockfree_queue_b);
    if lockfree_queue_va != lockfree_queue_vb {
        println("FAIL lockfree_queue");
        process_exit(1);
    }
    println("prod_ap_lockfree_queue: PASSED");
}
