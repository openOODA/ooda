// # Refuse secret sys_exec payload
//
// Logline: Pass a secret IDENT into sys_exec so the sink must refuse the call.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Hand token to sys_exec as the command payload.
//   3. Print 1 after the call.
//
// M135: Secret must not reach sys_exec argv
// SECRET: token
pub fn main(sys: &SysCap) {
    let token = "s3cret-payload";
    let r = sys_exec(sys, "sh", "-c", token);
    println(1);
}
