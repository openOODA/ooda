// # Product prove std/sec/sys/aslr_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/aslr_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aslr_ops: PASSED only if they match.

import "std/sec/sys/aslr_ops.oo";

pub fn main() {
    let aslr_ops_a = aslr_addr_in_range(0, 0, 0);
    let aslr_ops_b = aslr_addr_in_range(0, 0, 0);
    if aslr_ops_a != aslr_ops_b {
        println("FAIL aslr_ops");
        process_exit(1);
    }
    println("prod_ap_aslr_ops: PASSED");
}
