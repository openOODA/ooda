// # Product prove std/fs/dir_entry.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fs/dir_entry.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/dir_entry.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dir_entry: PASSED only if they match.

import "std/fs/dir_entry.oo";

pub fn main() {
    let dir_entry_a = dir_entry_new("x", "x", true, 0);
    let dir_entry_b = dir_entry_new("x", "x", true, 0);
    let dir_entry_va = dir_entry_path(dir_entry_a);
    let dir_entry_vb = dir_entry_path(dir_entry_b);
    if dir_entry_va.contains(dir_entry_vb) == false {
        println("FAIL dir_entry");
        process_exit(1);
    }
    if dir_entry_vb.contains(dir_entry_va) == false {
        println("FAIL dir_entry");
        process_exit(1);
    }
    println("prod_ap_dir_entry: PASSED");
}
