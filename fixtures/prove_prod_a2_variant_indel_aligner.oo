// # Product prove std/bio_advanced/variant_indel_aligner.oo
//
// Logline: Fail-closed emit+gcc+run asserts indel_char_at is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/variant_indel_aligner.oo.
//
// Beats:
//   1. Call indel_char_at twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_variant_indel_aligner: PASSED only if they match.

import "std/bio_advanced/variant_indel_aligner.oo";
import "std/str.oo";

pub fn main() {
    let variant_indel_aligner_mark: Int = 0;
    if variant_indel_aligner_mark != 0 {
        process_exit(1);
    }
    let a: String = indel_char_at("x", 0);
    let b: String = indel_char_at("x", 0);
    if str_eq(a, b) == false {
        println("FAIL indel_char_at");
        process_exit(1);
    }
    println("prod_variant_indel_aligner: PASSED");
}
