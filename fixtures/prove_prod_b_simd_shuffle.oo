// # Product prove std/simd/simd_shuffle.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_shuffle_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_shuffle.oo.
//
// Beats:
//   1. Call simd_shuffle_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_shuffle: PASSED only if they match.

import "std/simd/simd_shuffle.oo";

pub fn main() {
    let a = simd_shuffle_probe();
    let b = simd_shuffle_probe();
    if a != b {
        println("FAIL simd_shuffle_probe");
        process_exit(1);
    }
    println("prod_simd_shuffle: PASSED");
}
