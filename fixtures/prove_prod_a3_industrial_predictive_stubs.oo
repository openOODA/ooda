// # Product prove std/industrial_predictive/industrial_predictive_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts predictive_stub_vibration_adc_dma_status is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/industrial_predictive_stubs.oo.
//
// Beats:
//   1. Call predictive_stub_vibration_adc_dma_status twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_industrial_predictive_stubs: PASSED only if they match.

import "std/industrial_predictive/industrial_predictive_stubs.oo";

pub fn main() {
    let industrial_predictive_stubs_mark: Int = 0;
    if industrial_predictive_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = predictive_stub_vibration_adc_dma_status(0);
    let b: Int = predictive_stub_vibration_adc_dma_status(0);
    if a != b {
        println("FAIL predictive_stub_vibration_adc_dma_status");
        process_exit(1);
    }
    println("prod_industrial_predictive_stubs: PASSED");
}
