// # Product prove std/cloud_k8s/load_balancer_weighted_random.oo
//
// Logline: Fail-closed verification that weighted random load balancer selection is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/load_balancer_weighted_random.oo.
//
// Beats:
//   1. Initialize two balancers with identical weights and seeds.
//   2. Perform selections on both balancers.
//   3. Assert returned picks match deterministically.
//   4. Print prod_g4_cloud_lb_weighted: PASSED and exit 0.

import "std/cloud_k8s/load_balancer_weighted_random.oo";

pub fn main() {
    let b1: WeightedRandomBalancer = weighted_random_balancer_new(70, 30, 42);
    let b2: WeightedRandomBalancer = weighted_random_balancer_new(70, 30, 42);

    let sel1: WeightedRandomBalancer = weighted_random_select(b1);
    let sel2: WeightedRandomBalancer = weighted_random_select(b2);

    let p1: Int = weighted_random_last_pick(sel1);
    let p2: Int = weighted_random_last_pick(sel2);

    if p1 != p2 || p1 < 0 {
        println("FAIL weighted_random_select");
        process_exit(1);
    }

    println("prod_g4_cloud_lb_weighted: PASSED");
    process_exit(0);
}
