// # Product prove std/fintech_l3_book/dma_slippage_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fintech_l3_book/dma_slippage_model.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_slippage_model.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_dma_slippage_model: PASSED only if they match.

import "std/fintech_l3_book/dma_slippage_model.oo";

pub fn main() {
    let dma_slippage_model_a = slippage_estimate_new("x", 0, 0, 0, 0);
    let dma_slippage_model_b = slippage_estimate_new("x", 0, 0, 0, 0);
    if dma_slippage_model_a.symbol != dma_slippage_model_b.symbol {
        println("FAIL dma_slippage_model");
        process_exit(1);
    }
    println("prod_ap_dma_slippage_model: PASSED");
}
