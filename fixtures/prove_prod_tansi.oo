// # Product os terminal ansi prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/os/terminal_ansi.oo.
//
// Setup: Product std/os/terminal_ansi.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. cursor up 3. clear screen. hide cursor.
//   9. Exit 1 before PASSED on a miss.

import "std/os/terminal_ansi.oo";

pub fn main() {
    let u: String = ansi_cursor_up(3);
    if u != "\x1b[3A" {
        println("FAIL tansi up");
        process_exit(1);
    }
    let c: String = ansi_clear_screen();
    if c != "\x1b[2J\x1b[H" {
        println("FAIL tansi cls");
        process_exit(1);
    }
    let t: String = ansi_cursor_to(2, 5);
    if t != "\x1b[2;5H" {
        println("FAIL tansi to");
        process_exit(1);
    }
    println("prod_tansi: PASSED");
}
