// # LLVM Debug Smoke Test
//
// Logline: Verify DWARF debug metadata generation with clang -g.
//
// Setup: Compiled with oodac --backend llvm -g.
//
// Beats:
//   1. Define a helper function to step into.
//   2. Call helper from main and print result.

pub fn compute_sum(a: Int, b: Int) -> Int {
    let s: Int = a + b;
    return s;
}

pub fn main() {
    let x: Int = 10;
    let y: Int = 32;
    let res: Int = compute_sum(x, y);
    println(res);
}
