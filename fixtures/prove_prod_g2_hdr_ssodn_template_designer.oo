// # Product prove std/crispr_cas/hdr_ssodn_template_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ssodn_evaluate_arms is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/hdr_ssodn_template_designer.oo.
//
// Beats:
//   1. Call ssodn_evaluate_arms twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hdr_ssodn_template_designer: PASSED only if they match.

import "std/crispr_cas/hdr_ssodn_template_designer.oo";

pub fn main() {
    let hdr_ssodn_template_designer_mark: Int = 0;
    if hdr_ssodn_template_designer_mark != 0 {
        process_exit(1);
    }
    let a: SsodnDesignResult = ssodn_evaluate_arms(0, 0, "x");
    let b: SsodnDesignResult = ssodn_evaluate_arms(0, 0, "x");
    if (a).predicted_hdr_efficiency_pct != (b).predicted_hdr_efficiency_pct {
        println("FAIL ssodn_evaluate_arms");
        process_exit(1);
    }
    println("prod_g2_hdr_ssodn_template_designer: PASSED");
}
