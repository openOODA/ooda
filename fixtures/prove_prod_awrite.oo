// # Product async_write prove
//
// Logline: Fail-closed emit+gcc+run of shipped async_writer_poll_write.
//
// Setup: Product std/io/async_write.oo. Write hi.
//
// Beats:
//   1. poll_write hi bytes_written 2; buffer hi.
//   2. Exit 1 before PASSED on a miss.

import "std/io/async_write.oo";

pub fn main() {
    let w: AsyncWriter = async_writer_new(16);
    let res: AsyncWriteResult = async_writer_poll_write(w, "hi");
    let n: Int = res.bytes_written;
    if n != 2 {
        println("FAIL awrite n");
        process_exit(1);
    }
    let w2: AsyncWriter = res.writer;
    let bl: Int = async_writer_buffered_len(w2);
    if bl != 2 {
        println("FAIL awrite buf");
        process_exit(1);
    }
    println("prod_awrite: PASSED");
}
