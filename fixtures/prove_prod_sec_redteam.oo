// # Product prove std/sec/redteam.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_vector_risk is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/redteam.oo.
//
// Beats:
//   1. Call shim_marker_vector_risk twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_redteam: PASSED only if they match.

import "std/sec/redteam.oo";

pub fn main() {
    let redteam_mark: Int = 0;
    if redteam_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_vector_risk();
    let b: Int = shim_marker_vector_risk();
    if a != b { process_exit(1); }
    println("prod_redteam: PASSED");
}
