// # Product fuzzy match prove
//
// Logline: Fail-closed emit+gcc+run of shipped fuzzy_is_match.
//
// Setup: Product std/text/fuzzy_match.oo. Subsequence fzf.
//
// Beats:
//   1. fz is a subsequence of fuzzy.
//   2. zx is not a subsequence of fuzzy.
//   3. Exit 1 before PASSED on a miss.

import "std/text/fuzzy_match.oo";

pub fn main() {
    let ok: Bool = fuzzy_is_match("fz", "fuzzy");
    if ok == false {
        println("FAIL fuzzy yes");
        process_exit(1);
    }
    let no: Bool = fuzzy_is_match("zx", "fuzzy");
    if no == true {
        println("FAIL fuzzy no");
        process_exit(1);
    }
    println("prod_fuzzy: PASSED");
}
