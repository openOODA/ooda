// # Product sync async reactor prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/async_reactor.oo.
//
// Setup: Product std/sync/async_reactor.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New count 0 not registered.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/async_reactor.oo";

pub fn main() {
    let r: AsyncReactor = reactor_new();
    let n: Int = reactor_count(r);
    if n != 0 {
        println("FAIL reactor 0");
        process_exit(1);
    }
    if reactor_is_registered(r, 3) {
        println("FAIL reactor fd");
        process_exit(1);
    }
    println("prod_reactor: PASSED");
}
