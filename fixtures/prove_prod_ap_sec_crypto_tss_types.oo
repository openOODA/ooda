// # Product prove std/sec/crypto/tss_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/tss_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tss_types: PASSED only if they match.

import "std/sec/crypto/tss_types.oo";

pub fn main() {
    let tss_types_a = tss_params_new(0, 0, 0);
    let tss_types_b = tss_params_new(0, 0, 0);
    let tss_types_va = tss_params_t(tss_types_a);
    let tss_types_vb = tss_params_t(tss_types_b);
    if tss_types_va != tss_types_vb {
        println("FAIL tss_types");
        process_exit(1);
    }
    println("prod_ap_tss_types: PASSED");
}
