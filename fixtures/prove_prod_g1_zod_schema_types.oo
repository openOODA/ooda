// # Product prove std/web_ecosystem/zod_schema_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_result_success is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_schema_types.oo.
//
// Beats:
//   1. Call zod_result_success twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zod_schema_types: PASSED only if they match.

import "std/web_ecosystem/zod_schema_types.oo";

pub fn main() {
    let a: ZodResult = zod_result_success();
    let b: ZodResult = zod_result_success();
    if a.success != b.success {
        println("FAIL zod_result_success");
        process_exit(1);
    }
    println("prod_zod_schema_types: PASSED");
}
