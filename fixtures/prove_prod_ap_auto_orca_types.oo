// # Product prove std/auto/orca_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/orca_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orca_types: PASSED only if they match.

import "std/auto/orca_types.oo";

pub fn main() {
    let orca_types_a = vec2_new(0.0, 0.0);
    let orca_types_b = vec2_new(0.0, 0.0);
    let orca_types_va = vec2_length_sq(orca_types_a);
    let orca_types_vb = vec2_length_sq(orca_types_b);
    if orca_types_va != orca_types_vb {
        println("FAIL orca_types");
        process_exit(1);
    }
    println("prod_ap_orca_types: PASSED");
}
