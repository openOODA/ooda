// # Product prove std/auto/orca_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/orca_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orca_ops: PASSED only if they match.

import "std/auto/orca_ops.oo";

pub fn main() {
    let orca_ops_a = orca_op_new(0, 0);
    let orca_ops_b = orca_op_new(0, 0);
    let orca_ops_va = orca_op_radius(orca_ops_a);
    let orca_ops_vb = orca_op_radius(orca_ops_b);
    if orca_ops_va != orca_ops_vb {
        println("FAIL orca_ops");
        process_exit(1);
    }
    println("prod_ap_orca_ops: PASSED");
}
