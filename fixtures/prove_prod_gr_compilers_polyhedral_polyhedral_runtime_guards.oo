// # Product prove std/compilers_polyhedral/polyhedral_runtime_guards.oo
//
// Logline: Fail-closed emit+gcc+run asserts runtime_guard_evaluate is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_runtime_guards.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call runtime_guard_evaluate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_polyhedral_runtime_guards: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_runtime_guards.oo";

pub fn main() {
    let g0_oa = runtime_guard_context_new(0);
    let g0_ob = runtime_guard_context_new(0);
    let g0_a = runtime_guard_evaluate(g0_oa, 0);
    let g0_b = runtime_guard_evaluate(g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL runtime_guard_evaluate");
        process_exit(1);
    }
    println("prod_gr_polyhedral_runtime_guards: PASSED");
}
