// # Product prove std/db_storage/sql_logical_plan_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts logical_plan_tree_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_logical_plan_builder.oo.
//
// Beats:
//   1. Call logical_plan_tree_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_logical_plan_builder: PASSED only if they match.

import "std/db_storage/sql_logical_plan_builder.oo";

pub fn main() {
    let sql_logical_plan_builder_mark: Int = 0;
    if sql_logical_plan_builder_mark != 0 {
        process_exit(1);
    }
    let a: LogicalPlanTree = logical_plan_tree_new();
    let b: LogicalPlanTree = logical_plan_tree_new();
    if (a).root_node_id != (b).root_node_id {
        println("FAIL logical_plan_tree_new");
        process_exit(1);
    }
    println("prod_sql_logical_plan_builder: PASSED");
}
