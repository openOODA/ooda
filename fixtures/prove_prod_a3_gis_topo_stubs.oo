// # Product prove std/gis_topo/gis_topo_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts gis_topo_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/gis_topo_stubs.oo.
//
// Beats:
//   1. Call gis_topo_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gis_topo_stubs: PASSED only if they match.

import "std/gis_topo/gis_topo_stubs.oo";

pub fn main() {
    let gis_topo_stubs_mark: Int = 0;
    if gis_topo_stubs_mark != 0 {
        process_exit(1);
    }
    let a: GisTopoCapabilities = gis_topo_capabilities_default();
    let b: GisTopoCapabilities = gis_topo_capabilities_default();
    if (a).max_dem_cols != (b).max_dem_cols {
        println("FAIL gis_topo_capabilities_default");
        process_exit(1);
    }
    println("prod_gis_topo_stubs: PASSED");
}
