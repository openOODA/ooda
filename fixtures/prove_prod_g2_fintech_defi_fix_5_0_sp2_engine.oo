// # Product prove std/fintech_defi/fix_5_0_sp2_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts fix_field_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/fix_5_0_sp2_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fix_field_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fix_5_0_sp2_engine: PASSED only if they match.

import "std/fintech_defi/fix_5_0_sp2_engine.oo";

pub fn main() {
    let g2_oa: FixTagField = fix_field_new(2, "x");
    let g2_ob: FixTagField = fix_field_new(2, "x");
    let g2_a = (g2_oa).tag;
    let g2_b = (g2_ob).tag;
    if g2_a != g2_b {
        println("FAIL fix_field_new.tag");
        process_exit(1);
    }
    println("prod_g2_fix_5_0_sp2_engine: PASSED");
}
