// # Product prove std/telecom_5g/mimo_waterfilling_power.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_waterfilling_2x2_solve is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_waterfilling_power.oo.
//
// Beats:
//   1. Call mimo_waterfilling_2x2_solve twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mimo_waterfilling_power: PASSED only if they match.

import "std/telecom_5g/mimo_waterfilling_power.oo";

pub fn main() {
    let mimo_waterfilling_power_mark: Int = 0;
    if mimo_waterfilling_power_mark != 0 {
        process_exit(1);
    }
    let a: MimoWaterfilling2x2 = mimo_waterfilling_2x2_solve(0.0, 0.0, 0.0);
    let b: MimoWaterfilling2x2 = mimo_waterfilling_2x2_solve(0.0, 0.0, 0.0);
    if (a).active_subchannels != (b).active_subchannels {
        println("FAIL mimo_waterfilling_2x2_solve");
        process_exit(1);
    }
    println("prod_g2_mimo_waterfilling_power: PASSED");
}
