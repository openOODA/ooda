// # Product prove std/tda_topology/euler_characteristic_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts ect_add_direction is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/euler_characteristic_transform.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ect_add_direction twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_euler_characteristic_transform: PASSED only if they match.

import "std/tda_topology/euler_characteristic_transform.oo";

pub fn main() {
    let mut g0_oa = ect_new();
    let mut g0_ob = ect_new();
    let g0_a = ect_add_direction(&g0_oa, 0.0, 0.0);
    let g0_b = ect_add_direction(&g0_ob, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL ect_add_direction");
        process_exit(1);
    }
    println("prod_gr_euler_characteristic_transform: PASSED");
}
