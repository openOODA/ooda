// # Product prove std/mesh_ebpf/mesh_mtls_cert_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts mtls_verifier_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_mtls_cert_verifier.oo.
//
// Beats:
//   1. Call mtls_verifier_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_mtls_cert_verifier: PASSED only if they match.

import "std/mesh_ebpf/mesh_mtls_cert_verifier.oo";

pub fn main() {
    let mesh_mtls_cert_verifier_mark: Int = 0;
    if mesh_mtls_cert_verifier_mark != 0 {
        process_exit(1);
    }
    let mesh_mtls_cert_verifier_a: MtlsVerifierState = mtls_verifier_new("x");
    let mesh_mtls_cert_verifier_b: MtlsVerifierState = mtls_verifier_new("x");
    if (mesh_mtls_cert_verifier_a).total_verified != (mesh_mtls_cert_verifier_b).total_verified {
        println("FAIL mtls_verifier_new");
        process_exit(1);
    }
    println("prod_mesh_mtls_cert_verifier: PASSED");
}
