// # Product prove std/zk_rollup/merkle_patricia_trie_delete.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_empty_root is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_delete.oo.
//
// Beats:
//   1. Call mpt_empty_root twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_merkle_patricia_trie_delete: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_delete.oo";

pub fn main() {
    let merkle_patricia_trie_delete_mark: Int = 0;
    if merkle_patricia_trie_delete_mark != 0 {
        process_exit(1);
    }
    let a: Int = mpt_empty_root();
    let b: Int = mpt_empty_root();
    if a != b {
        println("FAIL mpt_empty_root");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_delete: PASSED");
}
