// # Product prove std/3d/math.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/math.oo.
//
// Beats:
//   1. Call vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_math: PASSED only if they match.

import "std/3d/math.oo";

pub fn main() {
    let math_mark: Int = 0;
    if math_mark != 0 {
        process_exit(1);
    }
    let a: Vector3 = vec3_new(0, 0, 0);
    let b: Vector3 = vec3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL vec3_new");
        process_exit(1);
    }
    println("prod_g2_math: PASSED");
}
