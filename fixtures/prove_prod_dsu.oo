// # Product disjoint-set prove
//
// Logline: Fail-closed emit+gcc+run of shipped dsu_new / dsu_num_sets.
//
// Setup: Product std/collections/disjoint_set.oo. Three elements, three sets.
//
// Beats:
//   1. dsu_new(3) length 3 and num_sets 3.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/disjoint_set.oo";

pub fn main() {
    let d: DisjointSet = dsu_new(3);
    let n: Int = dsu_len(d);
    if n != 3 {
        println("FAIL dsu len");
        process_exit(1);
    }
    let s: Int = dsu_num_sets(d);
    if s != 3 {
        println("FAIL dsu sets");
        process_exit(1);
    }
    println("prod_dsu: PASSED");
}
