// # Product prove std/lidar_perception/octree_pointcloud.oo
//
// Logline: Fail-closed verification that 3D LiDAR octree indexing, child octant decomposition, and containment checks are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/octree_pointcloud.oo.
//
// Beats:
//   1. Construct OctreeNode and verify default configurations.
//   2. Determine child octant indices based on 3D point coordinates.
//   3. Compute sub-octant spatial centers and verify bounding containment predicates.
//   4. Print prod_g4_lidar_octree: PASSED only if all match.

import "std/lidar_perception/octree_pointcloud.oo";

pub fn main() {
    let cfg: OctreeConfig = octree_config_default();
    if (cfg).max_depth != 8 || (cfg).max_points_per_leaf != 16 {
        println("FAIL octree_config_default");
        process_exit(1);
    }

    let node: OctreeNode = octree_node_new(0.0, 0.0, 0.0, 10.0, 0);
    if (node).depth != 0 || (node).half_size != 10.0 || !(node).is_leaf {
        println("FAIL octree_node_new");
        process_exit(1);
    }

    let pt1: Point3D = point3d_new(5.0, 5.0, 5.0);
    let child_idx_top: Int = octree_child_index(&node, &pt1);
    if child_idx_top != 7 {
        println("FAIL octree_child_index top");
        process_exit(1);
    }

    let pt2: Point3D = point3d_new(0.0 - 5.0, 0.0 - 5.0, 0.0 - 5.0);
    let child_idx_bot: Int = octree_child_index(&node, &pt2);
    if child_idx_bot != 0 {
        println("FAIL octree_child_index bottom");
        process_exit(1);
    }

    let center_7: Point3D = octree_child_center(&node, 7);
    if (center_7).x != 5.0 || (center_7).y != 5.0 || (center_7).z != 5.0 {
        println("FAIL octree_child_center");
        process_exit(1);
    }

    let inside: Bool = octree_contains_point(&node, &pt1);
    let pt_out: Point3D = point3d_new(15.0, 0.0, 0.0);
    let outside: Bool = octree_contains_point(&node, &pt_out);
    if !inside || outside {
        println("FAIL octree_contains_point");
        process_exit(1);
    }

    println("prod_g4_lidar_octree: PASSED");
    process_exit(0);
}
