// # Product prove std/db_storage/vector_cosine_simd.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_cosine_simd_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/db_storage/vector_cosine_simd.oo.
//
// Beats:
//   1. Call vector_cosine_simd_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_vector_cosine_simd: PASSED only if it matches.

import "std/db_storage/vector_cosine_simd.oo";

pub fn main() {
    let a: Int = vector_cosine_simd_probe();
    if a != 0 {
        println("FAIL vector_cosine_simd_probe");
        process_exit(1);
    }
    println("prod_nc_vector_cosine_simd: PASSED");
}
