// # Product prove std/cloud_faas/graceful_shutdown_drainer.oo
//
// Logline: Fail-closed emit+gcc+run asserts drainer_is_all_drained is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/graceful_shutdown_drainer.oo.
//
// Beats:
//   1. Call drainer_is_all_drained twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graceful_shutdown_drainer: PASSED only if they match.

import "std/cloud_faas/graceful_shutdown_drainer.oo";

pub fn main() {
    let graceful_shutdown_drainer_mark: Int = 0;
    if graceful_shutdown_drainer_mark != 0 {
        process_exit(1);
    }
    let graceful_shutdown_drainer_obj: GracefulShutdownDrainer = graceful_shutdown_drainer_new("x", 1);
    let graceful_shutdown_drainer_a: Bool = drainer_is_all_drained(&graceful_shutdown_drainer_obj);
    let graceful_shutdown_drainer_b: Bool = drainer_is_all_drained(&graceful_shutdown_drainer_obj);
    if graceful_shutdown_drainer_a != graceful_shutdown_drainer_b {
        println("FAIL drainer_is_all_drained");
        process_exit(1);
    }
    println("prod_graceful_shutdown_drainer: PASSED");
}
