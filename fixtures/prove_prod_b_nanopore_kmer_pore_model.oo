// # Product prove std/genomics_advanced/nanopore_kmer_pore_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_kmer_pore_model_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_kmer_pore_model.oo.
//
// Beats:
//   1. Call nanopore_kmer_pore_model_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanopore_kmer_pore_model: PASSED only if they match.

import "std/genomics_advanced/nanopore_kmer_pore_model.oo";

pub fn main() {
    let a = nanopore_kmer_pore_model_probe();
    let b = nanopore_kmer_pore_model_probe();
    if a != b {
        println("FAIL nanopore_kmer_pore_model_probe");
        process_exit(1);
    }
    println("prod_nanopore_kmer_pore_model: PASSED");
}
