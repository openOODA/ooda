// # Product prove std/uav_flight/uav_pure_pursuit_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts uav_pure_pursuit_guidance_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_pure_pursuit_guidance.oo.
//
// Beats:
//   1. Call uav_pure_pursuit_guidance_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_uav_pure_pursuit_guidance: PASSED only if it matches.

import "std/uav_flight/uav_pure_pursuit_guidance.oo";

pub fn main() {
    let a: Int = uav_pure_pursuit_guidance_probe();
    if a != 0 {
        println("FAIL uav_pure_pursuit_guidance_probe");
        process_exit(1);
    }
    println("prod_nc_uav_pure_pursuit_guidance: PASSED");
}
