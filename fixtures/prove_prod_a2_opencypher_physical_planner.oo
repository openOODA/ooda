// # Product prove std/db_graph/opencypher_physical_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts physical_operator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_physical_planner.oo.
//
// Beats:
//   1. Call physical_operator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_physical_planner: PASSED only if they match.

import "std/db_graph/opencypher_physical_planner.oo";

pub fn main() {
    let opencypher_physical_planner_mark: Int = 0;
    if opencypher_physical_planner_mark != 0 {
        process_exit(1);
    }
    let a: PhysicalOperatorNode = physical_operator_new(0, 0, 0, 0);
    let b: PhysicalOperatorNode = physical_operator_new(0, 0, 0, 0);
    if (a).op_id != (b).op_id {
        println("FAIL physical_operator_new");
        process_exit(1);
    }
    println("prod_opencypher_physical_planner: PASSED");
}
