// # Product prove std/quantum_topological/toric_code_braiding_phase.oo
//
// Logline: Fail-closed emit+gcc+run asserts toric_fusion is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_braiding_phase.oo.
//
// Beats:
//   1. Call toric_fusion twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_toric_code_braiding_phase: PASSED only if they match.

import "std/quantum_topological/toric_code_braiding_phase.oo";

pub fn main() {
    let toric_code_braiding_phase_mark: Int = 0;
    if toric_code_braiding_phase_mark != 0 {
        process_exit(1);
    }
    let a: Int = toric_fusion(0, 0);
    let b: Int = toric_fusion(0, 0);
    if a != b {
        println("FAIL toric_fusion");
        process_exit(1);
    }
    println("prod_toric_code_braiding_phase: PASSED");
}
