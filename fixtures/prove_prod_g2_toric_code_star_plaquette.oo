// # Product prove std/quantum_topological/toric_code_star_plaquette.oo
//
// Logline: Fail-closed emit+gcc+run asserts toric_ground_state_degeneracy is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_star_plaquette.oo.
//
// Beats:
//   1. Call toric_ground_state_degeneracy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_toric_code_star_plaquette: PASSED only if they match.

import "std/quantum_topological/toric_code_star_plaquette.oo";

pub fn main() {
    let toric_code_star_plaquette_mark: Int = 0;
    if toric_code_star_plaquette_mark != 0 {
        process_exit(1);
    }
    let a: Int = toric_ground_state_degeneracy(0);
    let b: Int = toric_ground_state_degeneracy(0);
    if a != b {
        println("FAIL toric_ground_state_degeneracy");
        process_exit(1);
    }
    println("prod_g2_toric_code_star_plaquette: PASSED");
}
