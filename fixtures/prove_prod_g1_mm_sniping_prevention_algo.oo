// # Product prove std/hft_alpha/mm_sniping_prevention_algo.oo
//
// Logline: Fail-closed emit+gcc+run asserts sniping_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_sniping_prevention_algo.oo.
//
// Beats:
//   1. Call sniping_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_sniping_prevention_algo: PASSED only if they match.

import "std/hft_alpha/mm_sniping_prevention_algo.oo";

pub fn main() {
    let a: SnipingDefenseConfig = sniping_config_default();
    let b: SnipingDefenseConfig = sniping_config_default();
    if a.max_toxic_fill_rate_per_sec != b.max_toxic_fill_rate_per_sec {
        println("FAIL sniping_config_default");
        process_exit(1);
    }
    println("prod_mm_sniping_prevention_algo: PASSED");
}
