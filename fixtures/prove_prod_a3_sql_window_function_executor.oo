// # Product prove std/db_storage/sql_window_function_executor.oo
//
// Logline: Fail-closed emit+gcc+run asserts window_execution_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_window_function_executor.oo.
//
// Beats:
//   1. Call window_execution_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_window_function_executor: PASSED only if they match.

import "std/db_storage/sql_window_function_executor.oo";

pub fn main() {
    let sql_window_function_executor_mark: Int = 0;
    if sql_window_function_executor_mark != 0 {
        process_exit(1);
    }
    let a: WindowExecutionResult = window_execution_result_new();
    let b: WindowExecutionResult = window_execution_result_new();
    if (a).total_processed != (b).total_processed {
        println("FAIL window_execution_result_new");
        process_exit(1);
    }
    println("prod_sql_window_function_executor: PASSED");
}
