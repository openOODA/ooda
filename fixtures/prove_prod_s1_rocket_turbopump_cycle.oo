// # Product prove std/space_propulsion/rocket_turbopump_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbopump_compute_power is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_turbopump_cycle.oo.
//
// Beats:
//   1. Call turbopump_compute_power twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_turbopump_cycle: PASSED only if they match.

import "std/space_propulsion/rocket_turbopump_cycle.oo";

pub fn main() {
    let rocket_turbopump_cycle_mark: Int = 0;
    if rocket_turbopump_cycle_mark != 0 {
        process_exit(1);
    }
    let rocket_turbopump_cycle_a = turbopump_compute_power(turbopump_spec_default_ffsc(), 1.0, 1.0, 1.0, 1.0);
    let rocket_turbopump_cycle_b = turbopump_compute_power(turbopump_spec_default_ffsc(), 1.0, 1.0, 1.0, 1.0);
    if (rocket_turbopump_cycle_a).p_pump_ox_bar != (rocket_turbopump_cycle_b).p_pump_ox_bar {
        println("FAIL turbopump_compute_power");
        process_exit(1);
    }
    println("prod_rocket_turbopump_cycle: PASSED");
}
