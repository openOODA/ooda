// # emit-x86 bound const-int plus
//
// Logline: Bind two ints and print a plus b so emit-x86 can lower const-int add to 3.
//
// Setup: Fold misses. No greet. a and b are const-int lets, not string lets.
//
// Beats:
//   1. Bind a to 1 and b to 2.
//   2. Print a plus b.
//   3. as+ld stdout is 3, not 12.
//
// residual: SysV stays later.

pub fn main() {
    let a = 1;
    let b = 2;
    println(a + b);
}
