// # Product prove std/net_telemetry/pcap_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcap_timestamp_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/pcap_packet.oo.
//
// Beats:
//   1. Call pcap_timestamp_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pcap_packet: PASSED only if they match.

import "std/net_telemetry/pcap_packet.oo";

pub fn main() {
    let a: PcapTimestamp = pcap_timestamp_new(0, 0, true);
    let b: PcapTimestamp = pcap_timestamp_new(0, 0, true);
    if a.sec != b.sec {
        println("FAIL pcap_timestamp_new");
        process_exit(1);
    }
    println("prod_pcap_packet: PASSED");
}
