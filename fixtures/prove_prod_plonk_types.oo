// # Product prove std/sec/crypto/plonk_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_types_module_loaded is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk_types.oo.
//
// Beats:
//   1. Call plonk_types_module_loaded twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_types: PASSED only if they match.

import "std/sec/crypto/plonk_types.oo";

pub fn main() {
    let a = plonk_types_module_loaded();
    let b = plonk_types_module_loaded();
    if a != b {
        println("FAIL plonk_types_module_loaded");
        process_exit(1);
    }
    println("prod_plonk_types: PASSED");
}
