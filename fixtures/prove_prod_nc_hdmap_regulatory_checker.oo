// # Product prove std/lidar_perception/hdmap_regulatory_checker.oo
//
// Logline: Fail-closed emit+gcc+run asserts hdmap_regulatory_checker_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/hdmap_regulatory_checker.oo.
//
// Beats:
//   1. Call hdmap_regulatory_checker_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hdmap_regulatory_checker: PASSED only if it matches.

import "std/lidar_perception/hdmap_regulatory_checker.oo";

pub fn main() {
    let a: Int = hdmap_regulatory_checker_probe();
    if a != 0 {
        println("FAIL hdmap_regulatory_checker_probe");
        process_exit(1);
    }
    println("prod_nc_hdmap_regulatory_checker: PASSED");
}
