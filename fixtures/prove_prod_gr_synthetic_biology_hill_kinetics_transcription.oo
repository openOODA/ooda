// # Product prove std/synthetic_biology/hill_kinetics_transcription.oo
//
// Logline: Fail-closed emit+gcc+run asserts hill_math_pow is a real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/hill_kinetics_transcription.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call hill_math_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_hill_kinetics_transcription: PASSED only if they match.

import "std/synthetic_biology/hill_kinetics_transcription.oo";

pub fn main() {
    let g0_a = hill_math_pow(0.0, 0);
    let g0_b = hill_math_pow(0.0, 0);
    if g0_a != g0_b {
        println("FAIL hill_math_pow");
        process_exit(1);
    }
    println("prod_gr_hill_kinetics_transcription: PASSED");
}
