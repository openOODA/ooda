// # Product sec policy path prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/policy_path.oo.
//
// Setup: Product std/sec/policy_path.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. SOUL.md is locked. x is not. pin line format.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/policy_path.oo";

pub fn main() {
    if policy_path_is_locked("SOUL.md") == false {
        println("FAIL policy soul");
        process_exit(1);
    }
    if policy_path_is_locked("x") {
        println("FAIL policy x");
        process_exit(1);
    }
    let s: String = policy_pin_line("n", "1", "s", "c");
    if s != "n@1#s#c" {
        println("FAIL policy pin");
        process_exit(1);
    }
    println("prod_pinline: PASSED");
}
