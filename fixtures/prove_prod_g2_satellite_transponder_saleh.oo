// # Product prove std/satellite_dvb/satellite_transponder_saleh.oo
//
// Logline: Fail-closed emit+gcc+run asserts saleh_twta_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_transponder_saleh.oo.
//
// Beats:
//   1. Call saleh_twta_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_transponder_saleh: PASSED only if they match.

import "std/satellite_dvb/satellite_transponder_saleh.oo";

pub fn main() {
    let satellite_transponder_saleh_mark: Int = 0;
    if satellite_transponder_saleh_mark != 0 {
        process_exit(1);
    }
    let a: SalehHpaModel = saleh_twta_default();
    let b: SalehHpaModel = saleh_twta_default();
    if (a).alpha_a != (b).alpha_a {
        println("FAIL saleh_twta_default");
        process_exit(1);
    }
    println("prod_g2_satellite_transponder_saleh: PASSED");
}
