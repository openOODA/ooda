// # Product prove std/zk_rollup/plonk_gate_selector.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_gate_selectors_arithmetic_add is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_gate_selector.oo.
//
// Beats:
//   1. Call plonk_gate_selectors_arithmetic_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_gate_selector: PASSED only if they match.

import "std/zk_rollup/plonk_gate_selector.oo";

pub fn main() {
    let plonk_gate_selector_mark: Int = 0;
    if plonk_gate_selector_mark != 0 {
        process_exit(1);
    }
    let a: PlonkGateSelectors = plonk_gate_selectors_arithmetic_add(0);
    let b: PlonkGateSelectors = plonk_gate_selectors_arithmetic_add(0);
    if (a).q_l != (b).q_l {
        println("FAIL plonk_gate_selectors_arithmetic_add");
        process_exit(1);
    }
    println("prod_plonk_gate_selector: PASSED");
}
