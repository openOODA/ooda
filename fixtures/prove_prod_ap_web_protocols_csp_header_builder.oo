// # Product prove std/web_protocols/csp_header_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_protocols/csp_header_builder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/csp_header_builder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_csp_header_builder: PASSED only if they match.

import "std/web_protocols/csp_header_builder.oo";

pub fn main() {
    let csp_header_builder_a = csp_src_self();
    let csp_header_builder_b = csp_src_self();
    if csp_header_builder_a != csp_header_builder_b {
        println("FAIL csp_header_builder");
        process_exit(1);
    }
    println("prod_ap_csp_header_builder: PASSED");
}
