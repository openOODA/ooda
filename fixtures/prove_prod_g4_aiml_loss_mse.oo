// # Product prove std/ai_ml/loss_mse.oo
//
// Logline: Fail-closed emit+gcc+run asserts regression loss functions are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/loss_mse.oo.
//
// Beats:
//   1. Construct prediction and target 1D tensors.
//   2. Call loss_mse_1d, loss_mae_1d, and loss_huber_1d twice with matching arguments.
//   3. Exit 1 on any mismatch or divergence.
//   4. Print prod_g4_aiml_loss_mse: PASSED only if all match.

import "std/ai_ml/loss_mse.oo";

pub fn main() {
    let mut p_data: List[Float] = list_new();
    p_data = list_push(p_data, 1.0);
    p_data = list_push(p_data, 3.0);
    let pred: Tensor1D = Tensor1D { data: p_data, size: 2 };

    let mut t_data: List[Float] = list_new();
    t_data = list_push(t_data, 1.0);
    t_data = list_push(t_data, 1.0);
    let target: Tensor1D = Tensor1D { data: t_data, size: 2 };

    let mse_a: Float = loss_mse_1d(pred, target);
    let mse_b: Float = loss_mse_1d(pred, target);
    if mse_a != mse_b {
        println("FAIL loss_mse_1d");
        process_exit(1);
    }
    if mse_a != 2.0 {
        println("FAIL loss_mse_1d value");
        process_exit(1);
    }

    let mae_a: Float = loss_mae_1d(pred, target);
    let mae_b: Float = loss_mae_1d(pred, target);
    if mae_a != mae_b {
        println("FAIL loss_mae_1d");
        process_exit(1);
    }
    if mae_a != 1.0 {
        println("FAIL loss_mae_1d value");
        process_exit(1);
    }

    let huber_a: Float = loss_huber_1d(pred, target, 1.0);
    let huber_b: Float = loss_huber_1d(pred, target, 1.0);
    if huber_a != huber_b {
        println("FAIL loss_huber_1d");
        process_exit(1);
    }

    let grad_mse: Tensor1D = loss_mse_grad_1d(pred, target);
    let grad_mae: Tensor1D = loss_mae_grad_1d(pred, target);
    let grad_huber: Tensor1D = loss_huber_grad_1d(pred, target, 1.0);
    if (grad_mse).size != 2 || (grad_mae).size != 2 || (grad_huber).size != 2 {
        println("FAIL loss gradient sizes");
        process_exit(1);
    }

    println("prod_g4_aiml_loss_mse: PASSED");
    process_exit(0);
}
