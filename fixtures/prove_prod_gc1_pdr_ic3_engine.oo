// # Product prove std/formal_verif/pdr_ic3_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts pdr_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/pdr_ic3_engine.oo.
//
// Beats:
//   1. Call pdr_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pdr_ic3_engine: PASSED only if they match.

import "std/formal_verif/pdr_ic3_engine.oo";

pub fn main() {
    let pdr_ic3_engine_mark: Int = 0;
    if pdr_ic3_engine_mark != 0 {
        process_exit(1);
    }
    let pdr_ic3_engine_a = pdr_engine_new();
    let pdr_ic3_engine_b = pdr_engine_new();
    if (pdr_ic3_engine_a).max_level != (pdr_ic3_engine_b).max_level {
        println("FAIL pdr_engine_new");
        process_exit(1);
    }
    println("prod_pdr_ic3_engine: PASSED");
}
