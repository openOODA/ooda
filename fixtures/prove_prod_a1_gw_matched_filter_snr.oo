// # Product prove std/astrophysics_relativity/gw_matched_filter_snr.oo
//
// Logline: Fail-closed emit+gcc+run asserts ligo_noise_psd_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_matched_filter_snr.oo.
//
// Beats:
//   1. Call ligo_noise_psd_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_matched_filter_snr: PASSED only if they match.

import "std/astrophysics_relativity/gw_matched_filter_snr.oo";

pub fn main() {
    let gw_matched_filter_snr_mark: Int = 0;
    if gw_matched_filter_snr_mark != 0 {
        process_exit(1);
    }
    let a: Float = ligo_noise_psd_approx(0.0);
    let b: Float = ligo_noise_psd_approx(0.0);
    if a != b {
        println("FAIL ligo_noise_psd_approx");
        process_exit(1);
    }
    println("prod_gw_matched_filter_snr: PASSED");
}
