// # Product prove std/formal_verif/null_pointer_deref_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts nullness_null is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/null_pointer_deref_analyzer.oo.
//
// Beats:
//   1. Call nullness_null twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_null_pointer_deref_analyzer: PASSED only if they match.

import "std/formal_verif/null_pointer_deref_analyzer.oo";

pub fn main() {
    let null_pointer_deref_analyzer_mark: Int = 0;
    if null_pointer_deref_analyzer_mark != 0 {
        process_exit(1);
    }
    let null_pointer_deref_analyzer_a = nullness_null();
    let null_pointer_deref_analyzer_b = nullness_null();
    if (null_pointer_deref_analyzer_a).tag != (null_pointer_deref_analyzer_b).tag {
        println("FAIL nullness_null");
        process_exit(1);
    }
    println("prod_null_pointer_deref_analyzer: PASSED");
}
