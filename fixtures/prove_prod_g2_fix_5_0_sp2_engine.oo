// # Product prove std/fintech_defi/fix_5_0_sp2_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts fix_field_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/fix_5_0_sp2_engine.oo.
//
// Beats:
//   1. Call fix_field_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fix_5_0_sp2_engine: PASSED only if they match.

import "std/fintech_defi/fix_5_0_sp2_engine.oo";

pub fn main() {
    let fix_5_0_sp2_engine_mark: Int = 0;
    if fix_5_0_sp2_engine_mark != 0 {
        process_exit(1);
    }
    let a: FixTagField = fix_field_new(0, "x");
    let b: FixTagField = fix_field_new(0, "x");
    if (a).tag != (b).tag {
        println("FAIL fix_field_new");
        process_exit(1);
    }
    println("prod_g2_fix_5_0_sp2_engine: PASSED");
}
