// # Product prove std/auto_robot/radar_target_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/radar_target_tracker.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/radar_target_tracker.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_radar_target_tracker: PASSED only if they match.

import "std/auto_robot/radar_target_tracker.oo";

pub fn main() {
    let radar_target_tracker_a = radar_range_sq(0, 0);
    let radar_target_tracker_b = radar_range_sq(0, 0);
    if radar_target_tracker_a != radar_target_tracker_b {
        println("FAIL radar_target_tracker");
        process_exit(1);
    }
    println("prod_ap_radar_target_tracker: PASSED");
}
