// # Product prove std/cloud_k8s/crdt_mv_register.oo
//
// Logline: Fail-closed emit+gcc+run asserts mv_register_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_mv_register.oo.
//
// Beats:
//   1. Call mv_register_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crdt_mv_register: PASSED only if they match.

import "std/cloud_k8s/crdt_mv_register.oo";

pub fn main() {
    let crdt_mv_register_mark: Int = 0;
    if crdt_mv_register_mark != 0 {
        process_exit(1);
    }
    let a: MvRegister = mv_register_new();
    let b: MvRegister = mv_register_new();
    if (a).v0 != (b).v0 {
        println("FAIL mv_register_new");
        process_exit(1);
    }
    println("prod_crdt_mv_register: PASSED");
}
