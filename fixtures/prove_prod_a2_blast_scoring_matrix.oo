// # Product prove std/bioinformatics/blast_scoring_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts blosum62_lookup_score is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/blast_scoring_matrix.oo.
//
// Beats:
//   1. Call blosum62_lookup_score twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_blast_scoring_matrix: PASSED only if they match.

import "std/bioinformatics/blast_scoring_matrix.oo";

pub fn main() {
    let blast_scoring_matrix_mark: Int = 0;
    if blast_scoring_matrix_mark != 0 {
        process_exit(1);
    }
    let a: Int = blosum62_lookup_score(0, 0);
    let b: Int = blosum62_lookup_score(0, 0);
    if a != b {
        println("FAIL blosum62_lookup_score");
        process_exit(1);
    }
    println("prod_blast_scoring_matrix: PASSED");
}
