// # Product prove std/web_ecosystem/semver_comparator.oo
//
// Logline: Fail-closed emit+gcc+run asserts semver_compare is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/semver_comparator.oo.
//
// Beats:
//   1. Call semver_compare twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_semver_comparator: PASSED only if they match.

import "std/web_ecosystem/semver_comparator.oo";

pub fn main() {
    let semver_comparator_mark: Int = 0;
    if semver_comparator_mark != 0 {
        process_exit(1);
    }
    let a: Int = semver_compare(0, 0, 0, 0, 0, 0);
    let b: Int = semver_compare(0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL semver_compare");
        process_exit(1);
    }
    println("prod_semver_comparator: PASSED");
}
