// # Product prove std/telecom_5g/ofdm_resource_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_resource_grid_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_resource_grid.oo.
//
// Beats:
//   1. Call nr5g_resource_grid_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ofdm_resource_grid: PASSED only if they match.

import "std/telecom_5g/ofdm_resource_grid.oo";

pub fn main() {
    let a: Nr5gResourceGrid = nr5g_resource_grid_new(0, 0, 0);
    let b: Nr5gResourceGrid = nr5g_resource_grid_new(0, 0, 0);
    if a.num_rbs != b.num_rbs {
        println("FAIL nr5g_resource_grid_new");
        process_exit(1);
    }
    println("prod_ofdm_resource_grid: PASSED");
}
