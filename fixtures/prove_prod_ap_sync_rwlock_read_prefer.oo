// # Product prove std/sync/rwlock_read_prefer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/rwlock_read_prefer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/rwlock_read_prefer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rwlock_read_prefer: PASSED only if they match.

import "std/sync/rwlock_read_prefer.oo";

pub fn main() {
    let rwlock_read_prefer_a = rwlock_read_prefer_new();
    let rwlock_read_prefer_b = rwlock_read_prefer_new();
    if rwlock_read_prefer_a.reader_count != rwlock_read_prefer_b.reader_count {
        println("FAIL rwlock_read_prefer");
        process_exit(1);
    }
    println("prod_ap_rwlock_read_prefer: PASSED");
}
