// # Product prove std/exploit_analysis/symbolic_execution_angr.oo
//
// Logline: Fail-closed emit+gcc+run asserts symbolic_ast_const is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/symbolic_execution_angr.oo.
//
// Beats:
//   1. Call symbolic_ast_const twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_symbolic_execution_angr: PASSED only if they match.

import "std/exploit_analysis/symbolic_execution_angr.oo";

pub fn main() {
    let symbolic_execution_angr_mark: Int = 0;
    if symbolic_execution_angr_mark != 0 {
        process_exit(1);
    }
    let symbolic_execution_angr_a = symbolic_ast_const(1, 1);
    let symbolic_execution_angr_b = symbolic_ast_const(1, 1);
    if (symbolic_execution_angr_a).const_val != (symbolic_execution_angr_b).const_val {
        println("FAIL symbolic_ast_const");
        process_exit(1);
    }
    println("prod_symbolic_execution_angr: PASSED");
}
