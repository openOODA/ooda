// # Product prove std/compilers/llvm_ir_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts llvm_opcode_ret is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_builder.oo.
//
// Beats:
//   1. Call llvm_opcode_ret twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_llvm_ir_builder: PASSED only if they match.

import "std/compilers/llvm_ir_builder.oo";

pub fn main() {
    let llvm_ir_builder_mark: Int = 0;
    if llvm_ir_builder_mark != 0 {
        process_exit(1);
    }
    let a: Int = llvm_opcode_ret();
    let b: Int = llvm_opcode_ret();
    if a != b {
        println("FAIL llvm_opcode_ret");
        process_exit(1);
    }
    println("prod_llvm_ir_builder: PASSED");
}
