// M165 path A: simple arith + compare in requires (runtime, not SMT)
pub fn shifted(x: Int) -> Int
    requires x + 1 > 0
{
    return x + 1;
}

pub fn any_pos_nonneg(a: Int, b: Int, c: Int) -> Int
    requires (a > 0 || b > 0) && c >= 0
{
    return a + b + c;
}

pub fn main() {
    println(shifted(0));
    println(any_pos_nonneg(0, 2, 1));
}
