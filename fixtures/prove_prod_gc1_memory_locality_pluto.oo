// # Product prove std/compilers_polyhedral/memory_locality_pluto.oo
//
// Logline: Fail-closed emit+gcc+run asserts locality_objective_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/memory_locality_pluto.oo.
//
// Beats:
//   1. Call locality_objective_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_memory_locality_pluto: PASSED only if they match.

import "std/compilers_polyhedral/memory_locality_pluto.oo";

pub fn main() {
    let memory_locality_pluto_mark: Int = 0;
    if memory_locality_pluto_mark != 0 {
        process_exit(1);
    }
    let memory_locality_pluto_a = locality_objective_new();
    let memory_locality_pluto_b = locality_objective_new();
    if (memory_locality_pluto_a).num_edges != (memory_locality_pluto_b).num_edges {
        println("FAIL locality_objective_new");
        process_exit(1);
    }
    println("prod_memory_locality_pluto: PASSED");
}
