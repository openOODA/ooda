// # Product prove std/bft_consensus/network_partition_simulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts partition_can_communicate is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/network_partition_simulator.oo.
//
// Beats:
//   1. Call partition_can_communicate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_network_partition_simulator: PASSED only if they match.

import "std/bft_consensus/network_partition_simulator.oo";

pub fn main() {
    let network_partition_simulator_mark: Int = 0;
    if network_partition_simulator_mark != 0 {
        process_exit(1);
    }
    let a: Bool = partition_can_communicate(0, 0, true);
    let b: Bool = partition_can_communicate(0, 0, true);
    if a != b {
        println("FAIL partition_can_communicate");
        process_exit(1);
    }
    println("prod_network_partition_simulator: PASSED");
}
