// # Product prove std/sec/untrusted.oo
//
// Logline: Fail-closed emit+gcc+run asserts untrusted_blob_in is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/untrusted.oo.
//
// Beats:
//   1. Call untrusted_blob_in twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_untrusted: PASSED only if they match.

import "std/sec/untrusted.oo";

pub fn main() {
    let a = untrusted_blob_in("x", "x");
    let b = untrusted_blob_in("x", "x");
    if a != b {
        println("FAIL untrusted_blob_in");
        process_exit(1);
    }
    println("prod_untrusted: PASSED");
}
