// # Product os VT100 ansi prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/os/terminal_ansi_vt100.oo.
//
// Setup: Product std/os/terminal_ansi_vt100.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. prefix is ESC[.
//   2. reset is ESC[0m. fg red is ESC[31m.
//   9. Exit 1 before PASSED on a miss.

import "std/os/terminal_ansi_vt100.oo";

pub fn main() {
    let p: String = ansi_escape_prefix();
    if p != "\x1b[" {
        println("FAIL vt100 prefix");
        process_exit(1);
    }
    let r: String = ansi_reset();
    if r != "\x1b[0m" {
        println("FAIL vt100 reset");
        process_exit(1);
    }
    let red: String = ansi_fg_red();
    if red != "\x1b[31m" {
        println("FAIL vt100 red");
        process_exit(1);
    }
    println("prod_vt100: PASSED");
}
