// # Product prove std/sec/crypto/bgv_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts bgv_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bgv_types.oo.
//
// Beats:
//   1. Call bgv_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bgv_types: PASSED only if they match.

import "std/sec/crypto/bgv_types.oo";

pub fn main() {
    let bgv_types_mark: Int = 0;
    if bgv_types_mark != 0 {
        process_exit(1);
    }
    let a: BgvParams = bgv_params_new(0, 0, 0);
    let b: BgvParams = bgv_params_new(0, 0, 0);
    if (a).poly_degree != (b).poly_degree {
        println("FAIL bgv_params_new");
        process_exit(1);
    }
    println("prod_g2_bgv_types: PASSED");
}
