// # Product prove std/robotics_auv/dubins_auv_path_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts dubins_auv_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/dubins_auv_path_3d.oo.
//
// Beats:
//   1. Call dubins_auv_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dubins_auv_default: PASSED only if they match.

import "std/robotics_auv/dubins_auv_path_3d.oo";

pub fn main() {
    let dubins_auv_path_3d_mark: Int = 0;
    if dubins_auv_path_3d_mark != 0 { process_exit(1); }
    let a: DubinsAuvConfig = dubins_auv_config_default();
    let b: DubinsAuvConfig = dubins_auv_config_default();
    let ar: Float = (a).min_turn_radius_m;
    let br: Float = (b).min_turn_radius_m;
    if ar != br {
        println("FAIL dubins_auv_config_default");
        process_exit(1);
    }
    println("prod_dubins_auv_default: PASSED");
}
