// # Product prove std/astro_advanced/attitude_quaternion_ekf.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/attitude_quaternion_ekf.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_quaternion_ekf.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_quaternion_ekf: PASSED only if they match.

import "std/astro_advanced/attitude_quaternion_ekf.oo";

pub fn main() {
    let attitude_quaternion_ekf_a = qekf_gain(0);
    let attitude_quaternion_ekf_b = qekf_gain(0);
    if attitude_quaternion_ekf_a != attitude_quaternion_ekf_b {
        println("FAIL attitude_quaternion_ekf");
        process_exit(1);
    }
    println("prod_ap_attitude_quaternion_ekf: PASSED");
}
