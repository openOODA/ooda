// # Product prove std/wasm_gc/wasm_component_wit_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts wit_field_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_wit_ast.oo.
//
// Beats:
//   1. Call wit_field_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_wit_ast: PASSED only if they match.

import "std/wasm_gc/wasm_component_wit_ast.oo";

pub fn main() {
    let wasm_component_wit_ast_mark: Int = 0;
    if wasm_component_wit_ast_mark != 0 {
        process_exit(1);
    }
    let a: WitField = wit_field_new("x", "x");
    let b: WitField = wit_field_new("x", "x");
    let sa: String = (a).name;
    let sb: String = (b).name;
    if sa != sb {
        println("FAIL wit_field_new");
        process_exit(1);
    }
    println("prod_wasm_component_wit_ast: PASSED");
}
