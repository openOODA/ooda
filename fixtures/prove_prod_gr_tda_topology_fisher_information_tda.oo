// # Product prove std/tda_topology/fisher_information_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts fisher_measure_add is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/fisher_information_tda.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fisher_measure_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fisher_information_tda: PASSED only if they match.

import "std/tda_topology/fisher_information_tda.oo";

pub fn main() {
    let mut g0_oa = fisher_measure_new(0.0);
    let mut g0_ob = fisher_measure_new(0.0);
    let g0_a = fisher_measure_add(&g0_oa, 0.0, 0.0);
    let g0_b = fisher_measure_add(&g0_ob, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL fisher_measure_add");
        process_exit(1);
    }
    println("prod_gr_fisher_information_tda: PASSED");
}
