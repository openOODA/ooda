// # Product prove std/compilers_polyhedral/autovec_widening_narrowing.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/autovec_widening_narrowing.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_widening_narrowing.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_autovec_widening_narrowing: PASSED only if they match.

import "std/compilers_polyhedral/autovec_widening_narrowing.oo";

pub fn main() {
    let autovec_widening_narrowing_a = get_saturating_max_val(0, 0);
    let autovec_widening_narrowing_b = get_saturating_max_val(0, 0);
    if autovec_widening_narrowing_a != autovec_widening_narrowing_b {
        println("FAIL autovec_widening_narrowing");
        process_exit(1);
    }
    println("prod_ap_autovec_widening_narrowing: PASSED");
}
