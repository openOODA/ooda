// # Product prove std/genomics_advanced/nanopore_ctc_beam_search.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_ctc_beam_search_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_ctc_beam_search.oo.
//
// Beats:
//   1. Call nanopore_ctc_beam_search_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanopore_ctc_beam_search: PASSED only if they match.

import "std/genomics_advanced/nanopore_ctc_beam_search.oo";

pub fn main() {
    let a = nanopore_ctc_beam_search_probe();
    let b = nanopore_ctc_beam_search_probe();
    if a != b {
        println("FAIL nanopore_ctc_beam_search_probe");
        process_exit(1);
    }
    println("prod_nanopore_ctc_beam_search: PASSED");
}
