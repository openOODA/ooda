// # Product prove std/quantum_open_systems/gaussian_quantum_dissipation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/gaussian_quantum_dissipation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/gaussian_quantum_dissipation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gaussian_quantum_dissipation: PASSED only if they match.

import "std/quantum_open_systems/gaussian_quantum_dissipation.oo";

pub fn main() {
    let gaussian_quantum_dissipation_a = gaussian_state_vacuum();
    let gaussian_quantum_dissipation_b = gaussian_state_vacuum();
    let gaussian_quantum_dissipation_va = gaussian_purity_eval(gaussian_quantum_dissipation_a);
    let gaussian_quantum_dissipation_vb = gaussian_purity_eval(gaussian_quantum_dissipation_b);
    if gaussian_quantum_dissipation_va != gaussian_quantum_dissipation_vb {
        println("FAIL gaussian_quantum_dissipation");
        process_exit(1);
    }
    println("prod_ap_gaussian_quantum_dissipation: PASSED");
}
