// # Product prove std/quantum_open_systems/quantum_decoherence_t1_t2.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_decoherence_t1_t2.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_decoherence_t1_t2.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_decoherence_t1_t2: PASSED only if they match.

import "std/quantum_open_systems/quantum_decoherence_t1_t2.oo";

pub fn main() {
    let quantum_decoherence_t1_t2_a = decoherence_times_new(0.0, 0.0);
    let quantum_decoherence_t1_t2_b = decoherence_times_new(0.0, 0.0);
    let quantum_decoherence_t1_t2_va = decoherence_validate_bound(quantum_decoherence_t1_t2_a);
    let quantum_decoherence_t1_t2_vb = decoherence_validate_bound(quantum_decoherence_t1_t2_b);
    if quantum_decoherence_t1_t2_va != quantum_decoherence_t1_t2_vb {
        println("FAIL quantum_decoherence_t1_t2");
        process_exit(1);
    }
    println("prod_ap_quantum_decoherence_t1_t2: PASSED");
}
