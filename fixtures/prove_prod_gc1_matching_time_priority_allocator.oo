// # Product prove std/fintech_l3_book/matching_time_priority_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts fifo_match_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/matching_time_priority_allocator.oo.
//
// Beats:
//   1. Call fifo_match_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_matching_time_priority_allocator: PASSED only if they match.

import "std/fintech_l3_book/matching_time_priority_allocator.oo";

pub fn main() {
    let matching_time_priority_allocator_mark: Int = 0;
    if matching_time_priority_allocator_mark != 0 {
        process_exit(1);
    }
    let matching_time_priority_allocator_a = fifo_match_result_new(1, 1);
    let matching_time_priority_allocator_b = fifo_match_result_new(1, 1);
    if (matching_time_priority_allocator_a).taker_order_id != (matching_time_priority_allocator_b).taker_order_id {
        println("FAIL fifo_match_result_new");
        process_exit(1);
    }
    println("prod_matching_time_priority_allocator: PASSED");
}
