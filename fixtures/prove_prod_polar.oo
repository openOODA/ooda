// # Product complex polar prove
//
// Logline: Fail-closed emit+gcc+run of shipped complex_polar_mul.
//
// Setup: Product std/math/complex_polar.oo. Magnitudes multiply; angles add.
//
// Beats:
//   1. (2,0)*(3,0) radius is 6.0.
//   2. (2,1)*(3,2) theta is 3.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/complex_polar.oo";

pub fn main() {
    let a: ComplexPolar = complex_polar_new(2.0, 0.0);
    let b: ComplexPolar = complex_polar_new(3.0, 0.0);
    let p: ComplexPolar = complex_polar_mul(a, b);
    let pr: Float = p.r;
    if pr != 6.0 {
        println("FAIL polar r");
        process_exit(1);
    }
    let c: ComplexPolar = complex_polar_new(2.0, 1.0);
    let d: ComplexPolar = complex_polar_new(3.0, 2.0);
    let q: ComplexPolar = complex_polar_mul(c, d);
    let qt: Float = q.theta;
    if qt != 3.0 {
        println("FAIL polar theta");
        process_exit(1);
    }
    println("prod_polar: PASSED");
}
