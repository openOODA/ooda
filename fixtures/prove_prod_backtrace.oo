// # Product prove std/diag/backtrace.oo
//
// Logline: Fail-closed emit+gcc+run asserts frame_format is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/backtrace.oo.
//
// Beats:
//   1. Call frame_format twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_backtrace: PASSED only if they match.

import "std/diag/backtrace.oo";

pub fn main() {
    let obj = frame_new(0, "x", "x", 0);
    let a = frame_format(obj);
    let b = frame_format(obj);
    if a != b {
        println("FAIL frame_format");
        process_exit(1);
    }
    println("prod_backtrace: PASSED");
}
