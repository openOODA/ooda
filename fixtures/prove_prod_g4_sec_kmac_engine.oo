// # Product prove std/sec/crypto/kmac_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kmac_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac_engine.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_kmac_engine: PASSED and exit 0 only on match.

import "std/sec/crypto/kmac_engine.oo";

pub fn main() {
    let cfg_a: KmacConfig = kmac_engine_init(1088, 512, 256);
    let cfg_b: KmacConfig = kmac_engine_init(1088, 512, 256);
    if (cfg_a).rate != (cfg_b).rate || (cfg_a).rate != 1088 {
        println("FAIL kmac_engine kmac_engine_init");
        process_exit(1);
    }

    let rate_a: Int = kmac_engine_rate(cfg_a);
    let rate_b: Int = kmac_engine_rate(cfg_b);
    if rate_a != rate_b || rate_a != 1088 {
        println("FAIL kmac_engine kmac_engine_rate");
        process_exit(1);
    }

    let work_a: Int = kmac_engine_work(1088, 512, 256);
    let work_b: Int = kmac_engine_work(1088, 512, 256);
    if work_a != work_b || work_a != 1856 {
        println("FAIL kmac_engine kmac_engine_work");
        process_exit(1);
    }

    println("prod_g4_sec_kmac_engine: PASSED");
    process_exit(0);
}
