// # Product prove std/edge/mesh_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/mesh_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/mesh_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mesh_types: PASSED only if they match.

import "std/edge/mesh_types.oo";

pub fn main() {
    let mesh_types_a = mesh_config_new(0, 0, 0);
    let mesh_types_b = mesh_config_new(0, 0, 0);
    let mesh_types_va = mesh_config_id(mesh_types_a);
    let mesh_types_vb = mesh_config_id(mesh_types_b);
    if mesh_types_va != mesh_types_vb {
        println("FAIL mesh_types");
        process_exit(1);
    }
    println("prod_ap_mesh_types: PASSED");
}
