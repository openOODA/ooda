// # Product prove std/satellite_dvb/satellite_itu_p676_gaseous.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaseous_oxygen_specific_atten_db_km is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_itu_p676_gaseous.oo.
//
// Beats:
//   1. Call gaseous_oxygen_specific_atten_db_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_itu_p676_gaseous: PASSED only if they match.

import "std/satellite_dvb/satellite_itu_p676_gaseous.oo";

pub fn main() {
    let satellite_itu_p676_gaseous_mark: Int = 0;
    if satellite_itu_p676_gaseous_mark != 0 {
        process_exit(1);
    }
    let a: Float = gaseous_oxygen_specific_atten_db_km(0.0);
    let b: Float = gaseous_oxygen_specific_atten_db_km(0.0);
    if a != b {
        println("FAIL gaseous_oxygen_specific_atten_db_km");
        process_exit(1);
    }
    println("prod_satellite_itu_p676_gaseous: PASSED");
}
