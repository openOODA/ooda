// # Product prove std/compilers_polyhedral/loop_peeling_unrolling.oo
//
// Logline: Fail-closed emit+gcc+run asserts peeling_has_epilogue is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/loop_peeling_unrolling.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call peeling_has_epilogue twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_loop_peeling_unrolling: PASSED only if they match.

import "std/compilers_polyhedral/loop_peeling_unrolling.oo";

pub fn main() {
    let g0_oa = loop_peeling_plan_new(2, 2);
    let g0_ob = loop_peeling_plan_new(2, 2);
    let g0_a = peeling_has_epilogue(g0_oa);
    let g0_b = peeling_has_epilogue(g0_ob);
    if g0_a != g0_b {
        println("FAIL peeling_has_epilogue");
        process_exit(1);
    }
    println("prod_g0_loop_peeling_unrolling: PASSED");
}
