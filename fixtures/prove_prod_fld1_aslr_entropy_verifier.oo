// # Product prove std/security_defense/aslr_entropy_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_compute_variance_bits is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/aslr_entropy_verifier.oo.
//
// Beats:
//   1. Call aslr_compute_variance_bits twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aslr_entropy_verifier: PASSED only if they match.

import "std/security_defense/aslr_entropy_verifier.oo";

pub fn main() {
    let aslr_entropy_verifier_mark: Int = 0;
    if aslr_entropy_verifier_mark != 0 {
        process_exit(1);
    }
    let aslr_entropy_verifier_a: Int = aslr_compute_variance_bits(list_new(), 1);
    let aslr_entropy_verifier_b: Int = aslr_compute_variance_bits(list_new(), 1);
    if aslr_entropy_verifier_a != aslr_entropy_verifier_b {
        println("FAIL aslr_compute_variance_bits");
        process_exit(1);
    }
    println("prod_aslr_entropy_verifier: PASSED");
}
