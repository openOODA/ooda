// # Product prove std/protein_folding/folding_pathway_transition_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts tpt_calc_backward_committor is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_pathway_transition_state.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tpt_calc_backward_committor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_folding_pathway_transition_state: PASSED only if they match.

import "std/protein_folding/folding_pathway_transition_state.oo";

pub fn main() {
    let g2_a = tpt_calc_backward_committor(1.0);
    let g2_b = tpt_calc_backward_committor(1.0);
    if g2_a != g2_b {
        println("FAIL tpt_calc_backward_committor");
        process_exit(1);
    }
    println("prod_g2_folding_pathway_transition_state: PASSED");
}
