// # Product prove std/synthetic_biology/recombinase_integrase_logic.oo
//
// Logline: Fail-closed emit+gcc+run asserts integrase_calc_efficiency is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/recombinase_integrase_logic.oo.
//
// Beats:
//   1. Call integrase_calc_efficiency twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_recombinase_integrase_logic: PASSED only if they match.

import "std/synthetic_biology/recombinase_integrase_logic.oo";

pub fn main() {
    let recombinase_integrase_logic_mark: Int = 0;
    if recombinase_integrase_logic_mark != 0 {
        process_exit(1);
    }
    let recombinase_integrase_logic_a: Float = integrase_calc_efficiency(1.0, true, true);
    let recombinase_integrase_logic_b: Float = integrase_calc_efficiency(1.0, true, true);
    if recombinase_integrase_logic_a != recombinase_integrase_logic_b {
        println("FAIL integrase_calc_efficiency");
        process_exit(1);
    }
    println("prod_recombinase_integrase_logic: PASSED");
}
