// # Product prove std/sync/token_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_bucket_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/token_bucket.oo.
//
// Beats:
//   1. Call token_bucket_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_token_bucket: PASSED only if they match.

import "std/sync/token_bucket.oo";

pub fn main() {
    let obj = token_bucket_new(0, 0);
    let a = obj.capacity;
    let b = obj.capacity;
    if a != b {
        println("FAIL token_bucket_new");
        process_exit(1);
    }
    println("prod_token_bucket: PASSED");
}
