// # Product prove std/quantum_open_systems/cascaded_quantum_systems.oo
//
// Logline: Fail-closed emit+gcc+run asserts cascaded_node_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/cascaded_quantum_systems.oo.
//
// Beats:
//   1. Call cascaded_node_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cascaded_quantum_systems: PASSED only if they match.

import "std/quantum_open_systems/cascaded_quantum_systems.oo";

pub fn main() {
    let cascaded_quantum_systems_mark: Int = 0;
    if cascaded_quantum_systems_mark != 0 {
        process_exit(1);
    }
    let a: CascadedNodeParams = cascaded_node_params_new(0.0, 0.0, 0.0);
    let b: CascadedNodeParams = cascaded_node_params_new(0.0, 0.0, 0.0);
    if (a).decay_rate_gamma_a != (b).decay_rate_gamma_a {
        println("FAIL cascaded_node_params_new");
        process_exit(1);
    }
    println("prod_cascaded_quantum_systems: PASSED");
}
