// # Product prove std/auto_robot/flexray_slot.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/flexray_slot.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/flexray_slot.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_flexray_slot: PASSED only if they match.

import "std/auto_robot/flexray_slot.oo";

pub fn main() {
    let flexray_slot_a = flexray_cycle_mod(0);
    let flexray_slot_b = flexray_cycle_mod(0);
    if flexray_slot_a != flexray_slot_b {
        println("FAIL flexray_slot");
        process_exit(1);
    }
    println("prod_ap_flexray_slot: PASSED");
}
