// # Product format pad prove
//
// Logline: Fail-closed emit+gcc+run of shipped format_pad_left.
//
// Setup: Product std/text/format.oo. Width 5 space pad.
//
// Beats:
//   1. format_pad_left hi 5 space is three spaces then hi.
//   2. Wider string is unchanged.
//   3. Exit 1 before PASSED on a miss.

import "std/text/format.oo";

pub fn main() {
    let s: String = format_pad_left("hi", 5, " ");
    if s != "   hi" {
        println("FAIL pad");
        process_exit(1);
    }
    let t: String = format_pad_left("hello", 3, "0");
    if t != "hello" {
        println("FAIL wide");
        process_exit(1);
    }
    println("prod_format: PASSED");
}
