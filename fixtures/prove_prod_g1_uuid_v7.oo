// # Product prove std/web_ecosystem/uuid_v7.oo
//
// Logline: Fail-closed emit+gcc+run asserts uuid_v7_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/uuid_v7.oo.
//
// Beats:
//   1. Call uuid_v7_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uuid_v7: PASSED only if they match.

import "std/web_ecosystem/uuid_v7.oo";

pub fn main() {
    let a: UuidV7 = uuid_v7_new(0, 0, 0, 0, 0);
    let b: UuidV7 = uuid_v7_new(0, 0, 0, 0, 0);
    if a.time_high != b.time_high {
        println("FAIL uuid_v7_new");
        process_exit(1);
    }
    println("prod_uuid_v7: PASSED");
}
