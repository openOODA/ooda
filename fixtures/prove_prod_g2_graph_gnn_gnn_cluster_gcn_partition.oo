// # Product prove std/graph_gnn/gnn_cluster_gcn_partition.oo
//
// Logline: Fail-closed emit+gcc+run asserts cluster_gcn_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_cluster_gcn_partition.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cluster_gcn_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_cluster_gcn_partition: PASSED only if they match.

import "std/graph_gnn/gnn_cluster_gcn_partition.oo";

pub fn main() {
    let g2_oa: ClusterGCNConfig = cluster_gcn_config_new(2, 2, 2);
    let g2_ob: ClusterGCNConfig = cluster_gcn_config_new(2, 2, 2);
    let g2_a = (g2_oa).num_nodes;
    let g2_b = (g2_ob).num_nodes;
    if g2_a != g2_b {
        println("FAIL cluster_gcn_config_new.num_nodes");
        process_exit(1);
    }
    println("prod_g2_gnn_cluster_gcn_partition: PASSED");
}
