// # Product prove std/genomics_advanced/genomic_principal_components_pca.oo
//
// Logline: Fail-closed emit+gcc+run asserts genomic_principal_components_pca_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/genomic_principal_components_pca.oo.
//
// Beats:
//   1. Call genomic_principal_components_pca_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_genomic_principal_components_pca: PASSED only if they match.

import "std/genomics_advanced/genomic_principal_components_pca.oo";

pub fn main() {
    let a = genomic_principal_components_pca_probe();
    let b = genomic_principal_components_pca_probe();
    if a != b {
        println("FAIL genomic_principal_components_pca_probe");
        process_exit(1);
    }
    println("prod_genomic_principal_components_pca: PASSED");
}
