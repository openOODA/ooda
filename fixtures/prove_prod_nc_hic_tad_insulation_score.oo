// # Product prove std/genomics_advanced/hic_tad_insulation_score.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_tad_insulation_score_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_tad_insulation_score.oo.
//
// Beats:
//   1. Call hic_tad_insulation_score_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hic_tad_insulation_score: PASSED only if it matches.

import "std/genomics_advanced/hic_tad_insulation_score.oo";

pub fn main() {
    let a: Int = hic_tad_insulation_score_probe();
    if a != 0 {
        println("FAIL hic_tad_insulation_score_probe");
        process_exit(1);
    }
    println("prod_nc_hic_tad_insulation_score: PASSED");
}
