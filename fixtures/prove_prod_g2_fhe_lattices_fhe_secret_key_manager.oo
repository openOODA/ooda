// # Product prove std/fhe_lattices/fhe_secret_key_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts secret_key_validate_security is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_secret_key_manager.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call secret_key_validate_security twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_secret_key_manager: PASSED only if they match.

import "std/fhe_lattices/fhe_secret_key_manager.oo";

pub fn main() {
    let g2_oa: SecretKeyManager = SecretKeyManager { degree_n: 2, modulus_q: 2, hamming_weight: 2, is_zeroized: true, sk_coeffs: list_new() };
    let g2_ob: SecretKeyManager = SecretKeyManager { degree_n: 2, modulus_q: 2, hamming_weight: 2, is_zeroized: true, sk_coeffs: list_new() };
    let g2_a = secret_key_validate_security(&g2_oa, 2);
    let g2_b = secret_key_validate_security(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL secret_key_validate_security");
        process_exit(1);
    }
    println("prod_g2_fhe_secret_key_manager: PASSED");
}
