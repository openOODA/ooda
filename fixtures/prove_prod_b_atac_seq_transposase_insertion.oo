// # Product prove std/genomics_advanced/atac_seq_transposase_insertion.oo
//
// Logline: Fail-closed emit+gcc+run asserts atac_seq_transposase_insertion_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/atac_seq_transposase_insertion.oo.
//
// Beats:
//   1. Call atac_seq_transposase_insertion_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atac_seq_transposase_insertion: PASSED only if they match.

import "std/genomics_advanced/atac_seq_transposase_insertion.oo";

pub fn main() {
    let a = atac_seq_transposase_insertion_probe();
    let b = atac_seq_transposase_insertion_probe();
    if a != b {
        println("FAIL atac_seq_transposase_insertion_probe");
        process_exit(1);
    }
    println("prod_atac_seq_transposase_insertion: PASSED");
}
