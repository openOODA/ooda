// # Product prove std/space_propulsion/tps_thermal_ablation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ablator_spec_default_pica is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/tps_thermal_ablation.oo.
//
// Beats:
//   1. Call ablator_spec_default_pica twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tps_thermal_ablation: PASSED only if they match.

import "std/space_propulsion/tps_thermal_ablation.oo";

pub fn main() {
    let tps_thermal_ablation_mark: Int = 0;
    if tps_thermal_ablation_mark != 0 {
        process_exit(1);
    }
    let a: AblatorMaterialSpec = ablator_spec_default_pica();
    let b: AblatorMaterialSpec = ablator_spec_default_pica();
    if (a).virgin_density_kg_m3 != (b).virgin_density_kg_m3 {
        println("FAIL ablator_spec_default_pica");
        process_exit(1);
    }
    println("prod_tps_thermal_ablation: PASSED");
}
