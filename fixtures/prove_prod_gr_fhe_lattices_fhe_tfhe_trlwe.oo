// # Product prove std/fhe_lattices/fhe_tfhe_trlwe.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_tfhe_trlwe_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_tfhe_trlwe.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fhe_tfhe_trlwe_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fhe_tfhe_trlwe: PASSED only if they match.

import "std/fhe_lattices/fhe_tfhe_trlwe.oo";

pub fn main() {
    let g0_a = fhe_tfhe_trlwe_probe();
    let g0_b = fhe_tfhe_trlwe_probe();
    if g0_a != g0_b {
        println("FAIL fhe_tfhe_trlwe_probe");
        process_exit(1);
    }
    println("prod_gr_fhe_tfhe_trlwe: PASSED");
}
