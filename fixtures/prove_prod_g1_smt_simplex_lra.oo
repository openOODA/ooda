// # Product prove std/formal_verif/smt_simplex_lra.oo
//
// Logline: Fail-closed emit+gcc+run asserts var_bounds_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/smt_simplex_lra.oo.
//
// Beats:
//   1. Call var_bounds_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smt_simplex_lra: PASSED only if they match.

import "std/formal_verif/smt_simplex_lra.oo";

pub fn main() {
    let a: VarBounds = var_bounds_new(0, 0, 0);
    let b: VarBounds = var_bounds_new(0, 0, 0);
    if a.var_id != b.var_id {
        println("FAIL var_bounds_new");
        process_exit(1);
    }
    println("prod_smt_simplex_lra: PASSED");
}
