// # Product prove std/gis_topo/gis_topo_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_topo/gis_topo_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/gis_topo/gis_topo_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_gis_topo_stubs: PASSED only if they match.

import "std/gis_topo/gis_topo_stubs.oo";

pub fn main() {
    let gis_topo_stubs_a = gis_topo_capabilities_default();
    let gis_topo_stubs_b = gis_topo_capabilities_default();
    if gis_topo_stubs_a.max_dem_cols != gis_topo_stubs_b.max_dem_cols {
        println("FAIL gis_topo_stubs");
        process_exit(1);
    }
    println("prod_ap_gis_topo_stubs: PASSED");
}
