// # Product prove std/compilers_vm/ssa_value_numbering.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/ssa_value_numbering.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_value_numbering.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ssa_value_numbering: PASSED only if they match.

import "std/compilers_vm/ssa_value_numbering.oo";

pub fn main() {
    let ssa_value_numbering_a = gvn_table_new();
    let ssa_value_numbering_b = gvn_table_new();
    let ssa_value_numbering_va = gvn_get_canonical_var(ssa_value_numbering_a, 0);
    let ssa_value_numbering_vb = gvn_get_canonical_var(ssa_value_numbering_b, 0);
    if ssa_value_numbering_va.contains(ssa_value_numbering_vb) == false {
        println("FAIL ssa_value_numbering");
        process_exit(1);
    }
    if ssa_value_numbering_vb.contains(ssa_value_numbering_va) == false {
        println("FAIL ssa_value_numbering");
        process_exit(1);
    }
    println("prod_ap_ssa_value_numbering: PASSED");
}
