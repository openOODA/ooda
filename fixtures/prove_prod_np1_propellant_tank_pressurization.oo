// # Product prove std/space_propulsion/propellant_tank_pressurization.oo
//
// Logline: Fail-closed emit+gcc+run asserts tank_compute_pressurization is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_tank_pressurization.oo.
//
// Beats:
//   1. Call tank_compute_pressurization twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_tank_pressurization: PASSED only if they match.

import "std/space_propulsion/propellant_tank_pressurization.oo";

pub fn main() {
    let propellant_tank_pressurization_mark: Int = 0;
    if propellant_tank_pressurization_mark != 0 {
        process_exit(1);
    }
    let propellant_tank_pressurization_a = tank_compute_pressurization(tank_pressurization_spec_default_methalox(), 1.0);
    let propellant_tank_pressurization_b = tank_compute_pressurization(tank_pressurization_spec_default_methalox(), 1.0);
    if (propellant_tank_pressurization_a).pressurant_mass_flow_kg_s != (propellant_tank_pressurization_b).pressurant_mass_flow_kg_s {
        println("FAIL tank_compute_pressurization");
        process_exit(1);
    }
    println("prod_propellant_tank_pressurization: PASSED");
}
