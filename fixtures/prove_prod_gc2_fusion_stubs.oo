// # Product prove std/auto/fusion_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fusion_stubs_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_stubs.oo.
//
// Beats:
//   1. Call fusion_stubs_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fusion_stubs: PASSED only if they match.

import "std/auto/fusion_stubs.oo";

pub fn main() {
    let fusion_stubs_mark: Int = 0;
    if fusion_stubs_mark != 0 {
        process_exit(1);
    }
    let fusion_stubs_a = fusion_stubs_init(1, 1);
    let fusion_stubs_b = fusion_stubs_init(1, 1);
    if (fusion_stubs_a).active != (fusion_stubs_b).active {
        println("FAIL fusion_stubs_init");
        process_exit(1);
    }
    println("prod_fusion_stubs: PASSED");
}
