// # Product prove std/compilers/wasm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/wasm_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_types: PASSED only if they match.

import "std/compilers/wasm_types.oo";

pub fn main() {
    let wasm_types_a = wasm_limits_new(0, 0, 0);
    let wasm_types_b = wasm_limits_new(0, 0, 0);
    let wasm_types_va = wasm_limits_min(wasm_types_a);
    let wasm_types_vb = wasm_limits_min(wasm_types_b);
    if wasm_types_va != wasm_types_vb {
        println("FAIL wasm_types");
        process_exit(1);
    }
    println("prod_ap_wasm_types: PASSED");
}
