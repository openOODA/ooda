// # Product prove std/defi_derivatives/garch11_volatility_forecasting.oo
//
// Logline: Fail-closed emit+gcc+run asserts garch11_unconditional_variance is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/garch11_volatility_forecasting.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call garch11_unconditional_variance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_garch11_volatility_forecasting: PASSED only if they match.

import "std/defi_derivatives/garch11_volatility_forecasting.oo";

pub fn main() {
    let g0_oa: Garch11Params = Garch11Params { omega: 1.0, // Base constant variance weight
    alpha: 1.0, // ARCH parameter (reaction to shocks)
    beta: 1.0, // GARCH parameter (persistence)
    annualization_factor: 1.0 };
    let g0_ob: Garch11Params = Garch11Params { omega: 1.0, // Base constant variance weight
    alpha: 1.0, // ARCH parameter (reaction to shocks)
    beta: 1.0, // GARCH parameter (persistence)
    annualization_factor: 1.0 };
    let g0_a = garch11_unconditional_variance(&g0_oa);
    let g0_b = garch11_unconditional_variance(&g0_ob);
    if g0_a != g0_b {
        println("FAIL garch11_unconditional_variance");
        process_exit(1);
    }
    println("prod_g0_garch11_volatility_forecasting: PASSED");
}
