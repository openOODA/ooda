// # Product prove std/sh.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sh.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sh.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sh: PASSED only if they match.

import "std/sh.oo";

pub fn main() {
    let sh_a = sh_arg_ok("x");
    let sh_b = sh_arg_ok("x");
    if sh_a != sh_b {
        println("FAIL sh");
        process_exit(1);
    }
    println("prod_ap_sh: PASSED");
}
