// # Product prove std/sync/atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts atomic_int_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/atomic.oo.
//
// Beats:
//   1. Call atomic_int_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atomic: PASSED only if they match.

import "std/sync/atomic.oo";

pub fn main() {
    let obj = atomic_int_new(0);
    let a = obj.id;
    let b = obj.id;
    if a != b {
        println("FAIL atomic_int_new");
        process_exit(1);
    }
    println("prod_atomic: PASSED");
}
