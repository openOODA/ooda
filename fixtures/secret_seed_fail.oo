// # Refuse a secret seed argument
//
// Logline: A tagged name must not reach seed.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the seed.
//   3. Expect the sink to refuse.

// Secret refuse: seed
// SECRET: token
pub fn main(rnd: &RandCap) {
    let token = 42;
    let r = seed(rnd, token);
    println(1);
}
