// # Product prove std/robot/locomotion_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/robot/locomotion_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/locomotion_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_locomotion_ops: PASSED only if they match.

import "std/robot/locomotion_ops.oo";

pub fn main() {
    let locomotion_ops_a = diff_drive_inverse_left(0.0, 0.0, 0.0, 0.0);
    let locomotion_ops_b = diff_drive_inverse_left(0.0, 0.0, 0.0, 0.0);
    if locomotion_ops_a != locomotion_ops_b {
        println("FAIL locomotion_ops");
        process_exit(1);
    }
    println("prod_ap_locomotion_ops: PASSED");
}
