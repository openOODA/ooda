// # Product prove std/telecom_6g/massive_mimo_pilot_contamination.oo
//
// Logline: Fail-closed emit+gcc+run asserts pilot_contamination_config_universal_reuse is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/massive_mimo_pilot_contamination.oo.
//
// Beats:
//   1. Call pilot_contamination_config_universal_reuse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_massive_mimo_pilot_contamination: PASSED only if they match.

import "std/telecom_6g/massive_mimo_pilot_contamination.oo";

pub fn main() {
    let massive_mimo_pilot_contamination_mark: Int = 0;
    if massive_mimo_pilot_contamination_mark != 0 {
        process_exit(1);
    }
    let a: PilotContaminationConfig = pilot_contamination_config_universal_reuse();
    let b: PilotContaminationConfig = pilot_contamination_config_universal_reuse();
    if (a).num_bs_antennas != (b).num_bs_antennas {
        println("FAIL pilot_contamination_config_universal_reuse");
        process_exit(1);
    }
    println("prod_g2_massive_mimo_pilot_contamination: PASSED");
}
