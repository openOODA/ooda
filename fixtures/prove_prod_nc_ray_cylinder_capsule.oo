// # Product prove std/pbr_raytracing/ray_cylinder_capsule.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_cylinder_capsule_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/ray_cylinder_capsule.oo.
//
// Beats:
//   1. Call ray_cylinder_capsule_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ray_cylinder_capsule: PASSED only if it matches.

import "std/pbr_raytracing/ray_cylinder_capsule.oo";

pub fn main() {
    let a: Int = ray_cylinder_capsule_probe();
    if a != 0 {
        println("FAIL ray_cylinder_capsule_probe");
        process_exit(1);
    }
    println("prod_nc_ray_cylinder_capsule: PASSED");
}
