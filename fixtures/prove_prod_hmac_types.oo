// # Product prove std/sec/crypto/hmac_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmac_key_used is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_types.oo.
//
// Beats:
//   1. Call hmac_key_used twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hmac_types: PASSED only if they match.

import "std/sec/crypto/hmac_types.oo";

pub fn main() {
    let obj = hmac_key_new(0, 0, 0, 0);
    let a = hmac_key_used(obj);
    let b = hmac_key_used(obj);
    if a != b {
        println("FAIL hmac_key_used");
        process_exit(1);
    }
    println("prod_hmac_types: PASSED");
}
