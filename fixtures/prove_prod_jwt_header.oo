// # Product prove std/sec/net/jwt_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_alg_is_safe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_header.oo.
//
// Beats:
//   1. Call jwt_alg_is_safe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jwt_header: PASSED only if they match.

import "std/sec/net/jwt_header.oo";

pub fn main() {
    let a = jwt_alg_is_safe("x");
    let b = jwt_alg_is_safe("x");
    if a != b {
        println("FAIL jwt_alg_is_safe");
        process_exit(1);
    }
    println("prod_jwt_header: PASSED");
}
