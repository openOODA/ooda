// # Println integer literal for WASI emit
//
// Logline: Print 42 so emit-wasm can plant a WASI fd_write body.
//
// Setup: No imports. One public main. The body is only println of that int.
//
// Beats:
//   1. Declare public main.
//   2. Print the 42 integer literal.
//   3. Leave no other statements so wasm_fn_println_int can see a print-only body.

pub fn main() { println(42); }
