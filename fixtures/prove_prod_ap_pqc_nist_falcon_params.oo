// # Product prove std/pqc_nist/falcon_params.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pqc_nist/falcon_params.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_params.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_falcon_params: PASSED only if they match.

import "std/pqc_nist/falcon_params.oo";

pub fn main() {
    let falcon_params_a = falcon_params_512();
    let falcon_params_b = falcon_params_512();
    if falcon_params_a.name != falcon_params_b.name {
        println("FAIL falcon_params");
        process_exit(1);
    }
    println("prod_ap_falcon_params: PASSED");
}
