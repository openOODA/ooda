// # Option[Bool] Some(true) emit lock
//
// Logline: Fail-closed emit+gcc+run of Option[Bool] mapped onto %OoResB sret.
//
// Setup: Backend-C. Some(true) must stay Bool, not a string pun.
//
// Beats:
//   1. f returns Some(true) as Option[Bool].
//   2. Match Some payload is true; None is false.
//   3. Exit 1 before PASSED on a miss.

fn f() -> Option[Bool] {
    return Some(true);
}

pub fn main() {
    let a: Option[Bool] = f();
    let va: Bool = match a {
        Some(v) => v,
        None => false
    };
    if va == false {
        println("FAIL some");
        process_exit(1);
    }
    let b: Option[Bool] = None;
    let vb: Bool = match b {
        Some(v) => true,
        None => false
    };
    if vb == true {
        println("FAIL none");
        process_exit(1);
    }
    println("option_bool_smoke: PASSED");
}
