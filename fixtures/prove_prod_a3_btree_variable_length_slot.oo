// # Product prove std/db_storage/btree_variable_length_slot.oo
//
// Logline: Fail-closed emit+gcc+run asserts varlen_storage_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_variable_length_slot.oo.
//
// Beats:
//   1. Call varlen_storage_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_variable_length_slot: PASSED only if they match.

import "std/db_storage/btree_variable_length_slot.oo";

pub fn main() {
    let btree_variable_length_slot_mark: Int = 0;
    if btree_variable_length_slot_mark != 0 {
        process_exit(1);
    }
    let a: VarLenStorageManager = varlen_storage_manager_new(0);
    let b: VarLenStorageManager = varlen_storage_manager_new(0);
    if (a).inline_byte_threshold != (b).inline_byte_threshold {
        println("FAIL varlen_storage_manager_new");
        process_exit(1);
    }
    println("prod_btree_variable_length_slot: PASSED");
}
