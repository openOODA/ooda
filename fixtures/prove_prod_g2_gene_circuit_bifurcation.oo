// # Product prove std/synthetic_biology/gene_circuit_bifurcation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gene_circuit_bifurcation_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/gene_circuit_bifurcation.oo.
//
// Beats:
//   1. Call gene_circuit_bifurcation_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gene_circuit_bifurcation: PASSED only if they match.

import "std/synthetic_biology/gene_circuit_bifurcation.oo";

pub fn main() {
    let a: Int = gene_circuit_bifurcation_probe();
    let b: Int = gene_circuit_bifurcation_probe();
    if a != b {
        println("FAIL gene_circuit_bifurcation_probe");
        process_exit(1);
    }
    println("prod_g2_gene_circuit_bifurcation: PASSED");
}
