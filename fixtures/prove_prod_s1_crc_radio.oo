// # Product prove std/telecom/crc_radio.oo
//
// Logline: Fail-closed emit+gcc+run asserts crc_radio_mask_for_width is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/crc_radio.oo.
//
// Beats:
//   1. Call crc_radio_mask_for_width twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crc_radio: PASSED only if they match.

import "std/telecom/crc_radio.oo";

pub fn main() {
    let crc_radio_mark: Int = 0;
    if crc_radio_mark != 0 {
        process_exit(1);
    }
    let crc_radio_a: Int = crc_radio_mask_for_width(1);
    let crc_radio_b: Int = crc_radio_mask_for_width(1);
    if crc_radio_a != crc_radio_b {
        println("FAIL crc_radio_mask_for_width");
        process_exit(1);
    }
    println("prod_crc_radio: PASSED");
}
