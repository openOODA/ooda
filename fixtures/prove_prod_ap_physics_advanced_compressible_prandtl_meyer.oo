// # Product prove std/physics_advanced/compressible_prandtl_meyer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/compressible_prandtl_meyer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_prandtl_meyer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_compressible_prandtl_meyer: PASSED only if they match.

import "std/physics_advanced/compressible_prandtl_meyer.oo";

pub fn main() {
    let compressible_prandtl_meyer_a = prandtl_meyer_nu(0.0, 0.0);
    let compressible_prandtl_meyer_b = prandtl_meyer_nu(0.0, 0.0);
    if compressible_prandtl_meyer_a != compressible_prandtl_meyer_b {
        println("FAIL compressible_prandtl_meyer");
        process_exit(1);
    }
    println("prod_ap_compressible_prandtl_meyer: PASSED");
}
