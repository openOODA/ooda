// # Product prove std/compilers_vm/pe_coff_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts pe_machine_amd64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/pe_coff_header_parser.oo.
//
// Beats:
//   1. Call pe_machine_amd64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pe_coff_header_parser: PASSED only if they match.

import "std/compilers_vm/pe_coff_header_parser.oo";

pub fn main() {
    let pe_coff_header_parser_mark: Int = 0;
    if pe_coff_header_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = pe_machine_amd64();
    let b: Int = pe_machine_amd64();
    if a != b {
        println("FAIL pe_machine_amd64");
        process_exit(1);
    }
    println("prod_pe_coff_header_parser: PASSED");
}
