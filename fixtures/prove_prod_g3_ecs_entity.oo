// # Product prove std/game_engine/ecs_entity.oo
//
// Logline: Fail-closed emit+gcc+run asserts entity_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_entity.oo.
//
// Beats:
//   1. Call entity_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ecs_entity: PASSED only if they match.

import "std/game_engine/ecs_entity.oo";

pub fn main() {
    let ecs_entity_mark: Int = 0;
    if ecs_entity_mark != 0 {
        process_exit(1);
    }
    let a: EntityRecord = entity_record_new(0, 0);
    let b: EntityRecord = entity_record_new(0, 0);
    if (a).id != (b).id {
        println("FAIL entity_record_new");
        process_exit(1);
    }
    println("prod_ecs_entity: PASSED");
}
