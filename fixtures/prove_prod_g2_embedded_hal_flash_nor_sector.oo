// # Product prove std/embedded_hal/flash_nor_sector.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_read_byte is a real value.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/flash_nor_sector.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call flash_read_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_flash_nor_sector: PASSED only if they match.

import "std/embedded_hal/flash_nor_sector.oo";

pub fn main() {
    let g2_oa = flash_controller_new();
    let g2_ob = flash_controller_new();
    let g2_a = flash_read_byte(g2_oa, 2, 2);
    let g2_b = flash_read_byte(g2_ob, 2, 2);
    if g2_a != g2_b {
        println("FAIL flash_read_byte");
        process_exit(1);
    }
    println("prod_g2_flash_nor_sector: PASSED");
}
