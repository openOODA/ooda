// # Product prove std/tda_topology/superlevel_set_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts merge_event_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/superlevel_set_filtration.oo.
//
// Beats:
//   1. Call merge_event_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_superlevel_set_filtration: PASSED only if they match.

import "std/tda_topology/superlevel_set_filtration.oo";

pub fn main() {
    let superlevel_set_filtration_mark: Int = 0;
    if superlevel_set_filtration_mark != 0 {
        process_exit(1);
    }
    let superlevel_set_filtration_a = merge_event_new(1, 1, 1.0, 1.0);
    let superlevel_set_filtration_b = merge_event_new(1, 1, 1.0, 1.0);
    if (superlevel_set_filtration_a).parent_peak_id != (superlevel_set_filtration_b).parent_peak_id {
        println("FAIL merge_event_new");
        process_exit(1);
    }
    println("prod_superlevel_set_filtration: PASSED");
}
