// # Product prove std/quantum_topological/topological_chern_number_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts First Chern number evaluation and quantized Hall conductance calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_chern_number_eval.oo.
//
// Beats:
//   1. Construct BrillouinGrid and add Berry fluxes.
//   2. Compute Chern number using fukui_compute_chern_number.
//   3. Compute quantized Hall conductance with qhe_hall_conductance_quantized.
//   4. Print prod_g4_quantum_chern: PASSED and exit 0.

import "std/quantum_topological/topological_chern_number_eval.oo";

pub fn main() {
    let mut grid: BrillouinGrid = brillouin_grid_new(2, 2);
    if (grid).nkx != 2 || (grid).nky != 2 || (grid).total_plaquettes != 4 {
        println("FAIL brillouin_grid_new");
        process_exit(1);
    }

    let pi_half: Float = 1.5707963267948966;
    brillouin_grid_add_flux(&mut grid, pi_half);
    brillouin_grid_add_flux(&mut grid, pi_half);
    brillouin_grid_add_flux(&mut grid, pi_half);
    brillouin_grid_add_flux(&mut grid, pi_half);

    let c_num1: Int = fukui_compute_chern_number(&grid);
    let c_num2: Int = fukui_compute_chern_number(&grid);

    if c_num1 != 1 || c_num1 != c_num2 {
        println("FAIL fukui_compute_chern_number");
        process_exit(1);
    }

    let cond1: Float = qhe_hall_conductance_quantized(c_num1);
    let cond2: Float = qhe_hall_conductance_quantized(c_num2);
    let cond_neg: Float = qhe_hall_conductance_quantized(0 - 2);

    if cond1 != cond2 || cond1 < 0.99 || cond1 > 1.01 {
        println("FAIL qhe_hall_conductance_quantized positive");
        process_exit(1);
    }
    if cond_neg < 0.0 - 2.01 || cond_neg > 0.0 - 1.99 {
        println("FAIL qhe_hall_conductance_quantized negative");
        process_exit(1);
    }

    println("prod_g4_quantum_chern: PASSED");
    process_exit(0);
}
