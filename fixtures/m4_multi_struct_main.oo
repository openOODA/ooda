// # Milestone 4 multi-module struct method caller
//
// Logline: Test method lowering on imported struct with value and reference receivers.
//
// Setup: Imports m4_multi_struct_lib.oo.
//
// Beats:
//   1. Import Point and methods from library.
//   2. Call value receiver methods p.dist_sq() and p.scale(2).
//   3. Call reference receiver methods (&p).shift_x(5) and ptr param methods.
//   4. Call Result-returning constructor and unwrap.
//   5. Assert runtime correctness and exit 0.

import "m4_multi_struct_lib.oo";

pub fn compute_on_ref(pt: &Point) -> Int {
    let shifted = pt.shift_x(10);
    return shifted.dist_sq();
}

pub fn read_ref_fields(pt: &Point) -> Int {
    return pt.x + pt.y;
}

pub fn main() {
    let p = Point { x: 3, y: 4 };

    // 1. Value receiver method calls
    let d2 = p.dist_sq();
    if d2 != 25 {
        println("FAIL: dist_sq value receiver");
        process_exit(1);
    }

    let p_scaled = p.scale(2);
    if p_scaled.x != 6 || p_scaled.y != 8 {
        println("FAIL: scale value receiver");
        process_exit(1);
    }

    // 2. Reference receiver method calls
    let p_shifted = (&p).shift_x(5);
    if p_shifted.x != 8 || p_shifted.y != 4 {
        println("FAIL: shift_x reference receiver");
        process_exit(1);
    }

    let from_ref = compute_on_ref(&p);
    if from_ref != 185 {
        println("FAIL: compute_on_ref");
        process_exit(1);
    }

    let sum_xy = read_ref_fields(&p);
    if sum_xy != 7 {
        println("FAIL: read_ref_fields");
        process_exit(1);
    }

    // 3. Result[Point, String] methods
    let res_ok = make_point(5, 12);
    if !res_ok.is_ok() {
        println("FAIL: make_point is_ok");
        process_exit(1);
    }
    let p_ok: Point = res_ok.unwrap();
    if p_ok.dist_sq() != 169 {
        println("FAIL: p_ok.dist_sq");
        process_exit(1);
    }

    let res_err = make_point(-1, 10);
    if !res_err.is_err() {
        println("FAIL: make_point is_err");
        process_exit(1);
    }

    // 4. Method returning Result[Point, String] on value receiver
    let r_inv = p.try_invert();
    if !r_inv.is_ok() {
        println("FAIL: p.try_invert() is_ok");
        process_exit(1);
    }
    let p_inv: Point = r_inv.unwrap();
    if p_inv.x != -3 || p_inv.y != -4 {
        println("FAIL: p_inv coordinates");
        process_exit(1);
    }

    let zero_p = Point { x: 0, y: 0 };
    let r_zero_inv = zero_p.try_invert();
    if !r_zero_inv.is_err() {
        println("FAIL: zero_p.try_invert() is_err");
        process_exit(1);
    }

    // 5. Method returning Result[Point, String] on reference receiver
    let r_scale = (&p).try_scale(3);
    if !r_scale.is_ok() {
        println("FAIL: (&p).try_scale(3) is_ok");
        process_exit(1);
    }
    let p_scaled3: Point = r_scale.unwrap();
    if p_scaled3.x != 9 || p_scaled3.y != 12 {
        println("FAIL: p_scaled3 coordinates");
        process_exit(1);
    }

    // 6. Multi-argument method call on imported struct
    let p_added = p.add_points(Point { x: 10, y: 20 });
    if p_added.x != 13 || p_added.y != 24 {
        println("FAIL: p.add_points");
        process_exit(1);
    }

    // 7. Chained method calls
    let chained_d2 = p.scale(2).dist_sq();
    if chained_d2 != 100 {
        println("FAIL: p.scale(2).dist_sq()");
        process_exit(1);
    }

    println("m4_multi_struct_main: PASSED");
}

