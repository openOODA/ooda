// # OPEN-75 stdin LSP serve
//
// Logline: Product lsp_serve reads stdin JSON-RPC and writes framed replies until shutdown.
//
// Setup: Self-contained serve. Feed initialize then shutdown on stdin.
//
// Beats:
//   1. Enter the product stdio loop.
//   2. Reply to each framed or newline JSON-RPC request.
//   3. Exit after shutdown.

fn lsp_frame(payload: String) -> String {
    return "Content-Length: " + chars_len(payload).to_string() + "\n\n" + payload;
}

fn lsp_has(s: String, needle: String) -> Bool {
    let hn: Int = chars_len(s);
    let nn: Int = chars_len(needle);
    if nn <= 0 {
        return true;
    }
    if nn > hn {
        return false;
    }
    let mut i: Int = 0;
    while i + nn <= hn {
        if str_slice(s, i, i + nn) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn lsp_skip_ws(s: String, i0: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = i0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
        } else {
            return i;
        }
    }
    return i;
}

fn lsp_obj_end(s: String, start: Int) -> Int {
    let n: Int = chars_len(s);
    if start >= n {
        return 0 - 1;
    }
    if char_at(s, start) != "{" {
        return 0 - 1;
    }
    let mut depth: Int = 0;
    let mut i: Int = start;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc {
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn lsp_reply(body: String) -> String {
    if lsp_has(body, "shutdown") {
        return lsp_frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}");
    }
    if lsp_has(body, "initialize") {
        let caps: String = "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true}}";
        return lsp_frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":" + caps + "}");
    }
    return "";
}

pub fn lsp_serve() {
    let raw: String = oo_read_stdin();
    let n: Int = chars_len(raw);
    let mut i: Int = 0;
    let mut msgs: Int = 0;
    while msgs < 256 {
        i = lsp_skip_ws(raw, i);
        if i >= n {
            return;
        }
        let end: Int = lsp_obj_end(raw, i);
        if end < 0 {
            return;
        }
        let body: String = str_slice(raw, i, end);
        i = end;
        let out: String = lsp_reply(body);
        if chars_len(out) > 0 {
            println(out);
        }
        msgs = msgs + 1;
        if lsp_has(body, "shutdown") || lsp_has(body, "exit") {
            return;
        }
    }
}

pub fn main() {
    lsp_serve();
}
