// # Product prove std/astro_advanced/relativistic_time_dilation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/relativistic_time_dilation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/relativistic_time_dilation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_relativistic_time_dilation: PASSED only if they match.

import "std/astro_advanced/relativistic_time_dilation.oo";

pub fn main() {
    let relativistic_time_dilation_a = gps_clock_ns();
    let relativistic_time_dilation_b = gps_clock_ns();
    if relativistic_time_dilation_a != relativistic_time_dilation_b {
        println("FAIL relativistic_time_dilation");
        process_exit(1);
    }
    println("prod_ap_relativistic_time_dilation: PASSED");
}
