// # Product prove std/tda_topology/persistence_silhouette_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts silhouette_tent_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_silhouette_calc.oo.
//
// Beats:
//   1. Call silhouette_tent_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistence_silhouette_calc: PASSED only if they match.

import "std/tda_topology/persistence_silhouette_calc.oo";

pub fn main() {
    let persistence_silhouette_calc_mark: Int = 0;
    if persistence_silhouette_calc_mark != 0 {
        process_exit(1);
    }
    let persistence_silhouette_calc_a: Float = silhouette_tent_eval(1.0, 1.0, 1.0);
    let persistence_silhouette_calc_b: Float = silhouette_tent_eval(1.0, 1.0, 1.0);
    if persistence_silhouette_calc_a != persistence_silhouette_calc_b {
        println("FAIL silhouette_tent_eval");
        process_exit(1);
    }
    println("prod_persistence_silhouette_calc: PASSED");
}
