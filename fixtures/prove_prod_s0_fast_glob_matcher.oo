// # Product prove std/web_ecosystem/fast_glob_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts glob_match_star value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/fast_glob_matcher.oo.
//
// Beats:
//   1. Call glob_match_star twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_fast_glob_matcher: PASSED only if asserts hold.

import "std/web_ecosystem/fast_glob_matcher.oo";

pub fn main() {
    let fast_glob_matcher_a: Int = glob_match_star();
    let fast_glob_matcher_b: Int = glob_match_star();
    if fast_glob_matcher_a != fast_glob_matcher_b {
        println("FAIL glob_match_star");
        process_exit(1);
    }
    println("prod_fast_glob_matcher: PASSED");
}
