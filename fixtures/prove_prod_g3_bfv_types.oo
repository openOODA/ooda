// # Product prove std/sec/crypto/bfv_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_types.oo.
//
// Beats:
//   1. Call bfv_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bfv_types: PASSED only if they match.

import "std/sec/crypto/bfv_types.oo";

pub fn main() {
    let bfv_types_mark: Int = 0;
    if bfv_types_mark != 0 {
        process_exit(1);
    }
    let a: BfvParameters = bfv_params_new(0, 0, 0);
    let b: BfvParameters = bfv_params_new(0, 0, 0);
    if (a).poly_degree != (b).poly_degree {
        println("FAIL bfv_params_new");
        process_exit(1);
    }
    println("prod_bfv_types: PASSED");
}
