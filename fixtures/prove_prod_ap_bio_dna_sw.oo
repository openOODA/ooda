// # Product prove std/bio/dna_sw.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/dna_sw.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bio/dna_sw.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_dna_sw: PASSED only if they match.

import "std/bio/dna_sw.oo";

pub fn main() {
    let dna_sw_a = sw_align(list_new(), 0, list_new(), 0, 0, 0, 0);
    let dna_sw_b = sw_align(list_new(), 0, list_new(), 0, 0, 0, 0);
    if dna_sw_a.rows != dna_sw_b.rows {
        println("FAIL dna_sw");
        process_exit(1);
    }
    println("prod_ap_dna_sw: PASSED");
}
