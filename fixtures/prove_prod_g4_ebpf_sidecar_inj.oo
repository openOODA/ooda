// # Product prove std/mesh_ebpf/mesh_sidecar_injector.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh sidecar injection webhook evaluation is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_sidecar_injector.oo.
//
// Beats:
//   1. Initialize sidecar injector state with default proxy configuration.
//   2. Evaluate pod injection annotations for enabled and disabled workloads.
//   3. Assert deterministic container specs, port redirects, and telemetry metrics.
//   4. Print prod_g4_ebpf_sidecar_inj: PASSED and exit 0.

import "std/mesh_ebpf/mesh_sidecar_injector.oo";

pub fn main() {
    let mut inj1: SidecarInjectorState = sidecar_injector_new("docker.io/envoyproxy/envoy:v1.30.0", 15001);
    let mut inj2: SidecarInjectorState = sidecar_injector_new("docker.io/envoyproxy/envoy:v1.30.0", 15001);

    if (inj1).total_injections != 0 || (inj1).skipped_injections != 0 {
        println("FAIL sidecar_injector_new init");
        process_exit(1);
    }

    // Evaluate enabled pod annotation
    let cfg1a: SidecarConfig = sidecar_evaluate_pod_annotation(&mut inj1, "true", "8080,9090");
    let cfg1b: SidecarConfig = sidecar_evaluate_pod_annotation(&mut inj2, "true", "8080,9090");

    if !(cfg1a).is_injected || !(cfg1b).is_injected {
        println("FAIL sidecar injection flag");
        process_exit(1);
    }

    if (cfg1a).proxy_port != 15001 || (cfg1a).admin_port != 15000 {
        println("FAIL sidecar port assignments");
        process_exit(1);
    }

    if (cfg1a).proxy_image != (cfg1b).proxy_image || (cfg1a).inbound_include_ports != "8080,9090" {
        println("FAIL sidecar spec mismatch");
        process_exit(1);
    }

    if (inj1).total_injections != 1 {
        println("FAIL total_injections count");
        process_exit(1);
    }

    // Evaluate disabled pod annotations
    let cfg_skip: SidecarConfig = sidecar_evaluate_pod_annotation(&mut inj1, "false", "8080");
    let cfg_dis: SidecarConfig = sidecar_evaluate_pod_annotation(&mut inj1, "disabled", "8080");

    if (cfg_skip).is_injected || (cfg_dis).is_injected {
        println("FAIL disabled pod sidecar rejection");
        process_exit(1);
    }

    if (inj1).skipped_injections != 2 {
        println("FAIL skipped_injections count");
        process_exit(1);
    }

    println("prod_g4_ebpf_sidecar_inj: PASSED");
    process_exit(0);
}
