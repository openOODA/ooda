// # Const if false || true println
//
// Logline: Print or-then when the condition is false || true.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If false || true print or-then else print or-else.
//   3. Leave no other statements.

pub fn main() {
    if false || true {
        println("or-then");
    } else {
        println("or-else");
    }
}
