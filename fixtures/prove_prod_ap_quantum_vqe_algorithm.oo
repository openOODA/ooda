// # Product prove std/quantum/vqe_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum/vqe_algorithm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/vqe_algorithm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vqe_algorithm: PASSED only if they match.

import "std/quantum/vqe_algorithm.oo";

pub fn main() {
    let vqe_algorithm_a = vqe_compute_energy_milli(0, 0, 0, 0);
    let vqe_algorithm_b = vqe_compute_energy_milli(0, 0, 0, 0);
    if vqe_algorithm_a != vqe_algorithm_b {
        println("FAIL vqe_algorithm");
        process_exit(1);
    }
    println("prod_ap_vqe_algorithm: PASSED");
}
