// # Adversarial Test: interval_domain extra operations
//
// Logline: Verify the new interval_domain operations (neg, div, join, meet, widen) handle edge cases and overflow correctly.
//
// Setup: Imports std/formal_verif/interval_domain.oo. Tests use direct .val extraction.
//
// Beats:
//   1. interval_neg([-3, 5]) == [-5, 3]; interval_neg on LLONG_MIN returns Err.
//   2. interval_div when divisor is strictly positive or strictly negative succeeds; Err when divisor contains 0.
//   3. interval_join covers both inputs; interval_meet intersects; Err on disjoint meet.
//   4. interval_widen clamps outward growth to infinity.

import "std/formal_verif/interval_domain.oo";

fn iv_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

pub fn main() {
    // Test 1: interval_neg basic.
    let r1: Result[Interval, String] = interval_neg(interval_new(-3, 5).val);
    if r1.is_ok() {
        let i: Interval = r1.val;
        let mn: Int = interval_min(i);
        let mx: Int = interval_max(i);
        iv_assert("neg([-3, 5]) == [-5, 3]", mn == -5 && mx == 3);
    } else {
        iv_assert("neg([-3, 5]) is_ok", false);
    }

    // Test 2: interval_neg on a range containing LLONG_MIN returns Err.
    let llmin: Int = 0 - 9223372036854775807 - 1;
    let r2: Result[Interval, String] = interval_neg(interval_new(llmin, 0).val);
    iv_assert("neg on interval containing LLONG_MIN is_err", r2.is_err());

    // Test 3: interval_div on positive divisor.
    let r3: Result[Interval, String] = interval_div(interval_new(6, 12).val, interval_new(2, 3).val);
    if r3.is_ok() {
        let i: Interval = r3.val;
        let mn: Int = interval_min(i);
        let mx: Int = interval_max(i);
        iv_assert("div([6,12], [2,3]) == [2, 6]", mn == 2 && mx == 6);
    } else {
        iv_assert("div([6,12], [2,3]) is_ok", false);
    }

    // Test 4: interval_div on divisor containing 0 returns Err.
    let r4: Result[Interval, String] = interval_div(interval_new(6, 12).val, interval_new(-1, 1).val);
    iv_assert("div with divisor [-1, 1] is_err", r4.is_err());

    // Test 5: interval_join is the smallest containing interval.
    let r5: Result[Interval, String] = interval_join(interval_new(0, 5).val, interval_new(3, 9).val);
    if r5.is_ok() {
        let i: Interval = r5.val;
        let mn: Int = interval_min(i);
        let mx: Int = interval_max(i);
        iv_assert("join([0,5], [3,9]) == [0, 9]", mn == 0 && mx == 9);
    } else {
        iv_assert("join([0,5], [3,9]) is_ok", false);
    }

    // Test 6: interval_meet of overlapping returns intersection.
    let r6: Result[Interval, String] = interval_meet(interval_new(0, 5).val, interval_new(3, 9).val);
    if r6.is_ok() {
        let i: Interval = r6.val;
        let mn: Int = interval_min(i);
        let mx: Int = interval_max(i);
        iv_assert("meet([0,5], [3,9]) == [3, 5]", mn == 3 && mx == 5);
    } else {
        iv_assert("meet([0,5], [3,9]) is_ok", false);
    }

    // Test 7: interval_meet of disjoint returns Err.
    let r7: Result[Interval, String] = interval_meet(interval_new(0, 2).val, interval_new(5, 7).val);
    iv_assert("meet([0,2], [5,7]) is_err", r7.is_err());

    // Test 8: interval_widen clamps outward growth to infinity.
    let r8: Result[Interval, String] = interval_widen(interval_new(0, 10).val, interval_new(-5, 15).val);
    if r8.is_ok() {
        let i: Interval = r8.val;
        let mn: Int = interval_min(i);
        let mx: Int = interval_max(i);
        let llmin2: Int = 0 - 9223372036854775807 - 1;
        iv_assert("widen min == LLONG_MIN when min grew", mn == llmin2);
        iv_assert("widen max == LLONG_MAX when max grew", mx == 9223372036854775807);
    } else {
        iv_assert("widen is_ok", false);
    }

    println("test_interval_domain_extra: PASSED");
}
