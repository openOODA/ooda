// # Product prove std/sec/crypto/double_ratchet_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts ratchet_chain_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/double_ratchet_types.oo.
//
// Beats:
//   1. Call ratchet_chain_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_double_ratchet_types: PASSED only if they match.

import "std/sec/crypto/double_ratchet_types.oo";

pub fn main() {
    let obj = ratchet_chain_new(0, 0, 0);
    let a = ratchet_chain_index(obj);
    let b = ratchet_chain_index(obj);
    if a != b {
        println("FAIL ratchet_chain_index");
        process_exit(1);
    }
    println("prod_double_ratchet_types: PASSED");
}
