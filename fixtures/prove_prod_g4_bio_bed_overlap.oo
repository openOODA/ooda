// # Product prove std/bio_advanced/bed_interval_overlap.oo
//
// Logline: Fail-closed verification that genomic BED interval intersection and reciprocal overlap calculation are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/bed_interval_overlap.oo.
//
// Beats:
//   1. Call bed_interval_overlap_probe.
//   2. Construct BedInterval objects and calculate interval lengths.
//   3. Compute overlapping intersection and disjoint intersection bounds.
//   4. Print prod_g4_bio_bed_overlap: PASSED and exit 0.

import "std/bio_advanced/bed_interval_overlap.oo";

pub fn main() {
    let probe1: Int = bed_interval_overlap_probe();
    let probe2: Int = bed_interval_overlap_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL bed_interval_overlap_probe");
        process_exit(1);
    }

    let a: BedInterval = BedInterval {
        chrom: "chr1",
        start_0based: 100,
        end_0based: 200,
        name: "geneA",
        score: 1000,
        strand: "+",
    };
    let b: BedInterval = BedInterval {
        chrom: "chr1",
        start_0based: 150,
        end_0based: 250,
        name: "peakB",
        score: 500,
        strand: "+",
    };

    let len_a1: Int = bed_calc_length(&a);
    let len_a2: Int = bed_calc_length(&a);
    if len_a1 != len_a2 || len_a1 != 100 {
        println("FAIL bed_calc_length");
        process_exit(1);
    }

    let ov1: BedOverlapResult = bed_intersect(&a, &b);
    let ov2: BedOverlapResult = bed_intersect(&a, &b);
    if (ov1).has_overlap != (ov2).has_overlap || !(ov1).has_overlap {
        println("FAIL bed_intersect overlap flag");
        process_exit(1);
    }

    if (ov1).overlap_start != 150 || (ov1).overlap_end != 200 || (ov1).overlap_length != 50 {
        println("FAIL bed_intersect coordinates");
        process_exit(1);
    }

    if (ov1).fraction_a != 0.5 || (ov1).fraction_b != 0.5 || (ov1).reciprocal_overlap != 0.5 {
        println("FAIL bed_intersect fraction");
        process_exit(1);
    }

    let c: BedInterval = BedInterval {
        chrom: "chr1",
        start_0based: 300,
        end_0based: 400,
        name: "peakC",
        score: 500,
        strand: "+",
    };
    let no_ov: BedOverlapResult = bed_intersect(&a, &c);
    if (no_ov).has_overlap || (no_ov).overlap_length != 0 {
        println("FAIL disjoint bed_intersect");
        process_exit(1);
    }

    println("prod_g4_bio_bed_overlap: PASSED");
    process_exit(0);
}
