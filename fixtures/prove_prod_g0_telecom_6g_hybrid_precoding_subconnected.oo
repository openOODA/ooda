// # Product prove std/telecom_6g/hybrid_precoding_subconnected.oo
//
// Logline: Fail-closed emit+gcc+run asserts hybrid_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/hybrid_precoding_subconnected.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hybrid_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_hybrid_precoding_subconnected: PASSED only if they match.

import "std/telecom_6g/hybrid_precoding_subconnected.oo";

pub fn main() {
    let g0_a = hybrid_int_to_float(2);
    let g0_b = hybrid_int_to_float(2);
    if g0_a != g0_b {
        println("FAIL hybrid_int_to_float");
        process_exit(1);
    }
    println("prod_g0_hybrid_precoding_subconnected: PASSED");
}
