// # Product prove std/web_protocols/webpush_encryption.oo
//
// Logline: Fail-closed emit+gcc+run asserts webpush_validate_subscription is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/webpush_encryption.oo.
//
// Beats:
//   1. Call webpush_validate_subscription twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_webpush_encryption: PASSED only if they match.

import "std/web_protocols/webpush_encryption.oo";

pub fn main() {
    let obj_a: WebPushSubscription = webpush_subscription_new(0, 0, 0);
    let obj_b: WebPushSubscription = webpush_subscription_new(0, 0, 0);
    let a: Int = webpush_validate_subscription(obj_a);
    let b: Int = webpush_validate_subscription(obj_b);
    if a != b {
        println("FAIL webpush_validate_subscription");
        process_exit(1);
    }
    println("prod_webpush_encryption: PASSED");
}
