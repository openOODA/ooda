// # Product prove std/sec/net/mtls_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts checksum_calculate is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_types.oo.
//
// Beats:
//   1. Call checksum_calculate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mtls_types: PASSED only if they match.

import "std/sec/net/mtls_types.oo";

pub fn main() {
    let a = checksum_calculate("x");
    let b = checksum_calculate("x");
    if a != b {
        println("FAIL checksum_calculate");
        process_exit(1);
    }
    println("prod_mtls_types: PASSED");
}
