// # Product avl_tree prove
//
// Logline: Fail-closed emit+gcc+run of shipped avl_tree_insert/contains/len.
//
// Setup: Product std/collections/avl_tree.oo. Sorted List[Int] stand-in.
//
// Beats:
//   1. After insert 3, len 1; contains 3 true; contains 2 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/avl_tree.oo";

pub fn main() {
    let mut t: AvlTree = avl_tree_new();
    t = avl_tree_insert(t, 3);
    let n: Int = avl_tree_len(t);
    if n != 1 {
        println("FAIL avl len");
        process_exit(1);
    }
    let c3: Bool = avl_tree_contains(t, 3);
    if c3 == false {
        println("FAIL avl contains 3");
        process_exit(1);
    }
    let c2: Bool = avl_tree_contains(t, 2);
    if c2 == true {
        println("FAIL avl contains 2");
        process_exit(1);
    }
    println("prod_avl: PASSED");
}
