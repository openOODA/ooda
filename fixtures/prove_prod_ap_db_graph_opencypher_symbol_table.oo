// # Product prove std/db_graph/opencypher_symbol_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_symbol_table.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_symbol_table.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_symbol_table: PASSED only if they match.

import "std/db_graph/opencypher_symbol_table.oo";

pub fn main() {
    let opencypher_symbol_table_a = cypher_symbol_new("x", 0, "x", 0);
    let opencypher_symbol_table_b = cypher_symbol_new("x", 0, "x", 0);
    if opencypher_symbol_table_a.name != opencypher_symbol_table_b.name {
        println("FAIL opencypher_symbol_table");
        process_exit(1);
    }
    println("prod_ap_opencypher_symbol_table: PASSED");
}
