// # Used Result must stay OK
//
// Logline: Bind Ok(1) and print is_ok so must-use cannot refuse a used Result.
//
// Setup: Isolated check. r is assigned and read.
//
// Beats:
//   1. Bind r to Ok(1).
//   2. Print r.is_ok().
//   3. check must print OK.

pub fn main() {
    let r = Ok(1);
    println(r.is_ok());
}
