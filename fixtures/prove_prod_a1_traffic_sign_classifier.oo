// # Product prove std/auto_robot/traffic_sign_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts traffic_sign_detection_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/traffic_sign_classifier.oo.
//
// Beats:
//   1. Call traffic_sign_detection_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_traffic_sign_classifier: PASSED only if they match.

import "std/auto_robot/traffic_sign_classifier.oo";

pub fn main() {
    let traffic_sign_classifier_mark: Int = 0;
    if traffic_sign_classifier_mark != 0 {
        process_exit(1);
    }
    let a: TrafficSignDetection = traffic_sign_detection_new(0, 0, 0, 0);
    let b: TrafficSignDetection = traffic_sign_detection_new(0, 0, 0, 0);
    if (a).sign_type != (b).sign_type {
        println("FAIL traffic_sign_detection_new");
        process_exit(1);
    }
    println("prod_traffic_sign_classifier: PASSED");
}
