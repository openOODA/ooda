// # Product prove std/quantum_tensor_nets/tebd_time_evolution.oo
//
// Logline: Fail-closed emit+gcc+run asserts tebd_step_summary_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tebd_time_evolution.oo.
//
// Beats:
//   1. Call tebd_step_summary_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tebd_time_evolution: PASSED only if they match.

import "std/quantum_tensor_nets/tebd_time_evolution.oo";

pub fn main() {
    let tebd_time_evolution_mark: Int = 0;
    if tebd_time_evolution_mark != 0 {
        process_exit(1);
    }
    let tebd_time_evolution_a = tebd_step_summary_new(1, 1.0, 1.0, 1, 1.0);
    let tebd_time_evolution_b = tebd_step_summary_new(1, 1.0, 1.0, 1, 1.0);
    if (tebd_time_evolution_a).step_number != (tebd_time_evolution_b).step_number {
        println("FAIL tebd_step_summary_new");
        process_exit(1);
    }
    println("prod_tebd_time_evolution: PASSED");
}
