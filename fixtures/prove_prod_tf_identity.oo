// # Product prove std/uav_flight/uav_se3_rigid_body.oo
//
// Logline: Fail-closed emit+gcc+run asserts tf_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_se3_rigid_body.oo.
//
// Beats:
//   1. Call tf_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tf_identity: PASSED only if they match.

import "std/uav_flight/uav_se3_rigid_body.oo";

pub fn main() {
    let uav_se3_rigid_body_mark: Int = 0;
    if uav_se3_rigid_body_mark != 0 { process_exit(1); }
    let a: Transform4x4 = tf_identity();
    let b: Transform4x4 = tf_identity();
    if (a).r00 != (b).r00 {
        println("FAIL tf_identity");
        process_exit(1);
    }
    println("prod_tf_identity: PASSED");
}
