// # Product prove std/sec/attestation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts attestation_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/attestation_engine.oo.
//
// Beats:
//   1. Call attestation_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_attestation_engine: PASSED only if it matches.

import "std/sec/attestation_engine.oo";

pub fn main() {
    let a: Int = attestation_engine_probe();
    if a != 0 {
        println("FAIL attestation_engine_probe");
        process_exit(1);
    }
    println("prod_nc_attestation_engine: PASSED");
}
