// # Product prove std/robotics_auv/auv_swarm_leader_follower.oo
//
// Logline: Fail-closed emit+gcc+run asserts swarm_formation_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_swarm_leader_follower.oo.
//
// Beats:
//   1. Call swarm_formation_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_swarm_formation_default: PASSED only if they match.

import "std/robotics_auv/auv_swarm_leader_follower.oo";

pub fn main() {
    let auv_swarm_leader_follower_mark: Int = 0;
    if auv_swarm_leader_follower_mark != 0 { process_exit(1); }
    let a: SwarmFormationConfig = swarm_formation_config_default();
    let b: SwarmFormationConfig = swarm_formation_config_default();
    let as: Float = (a).safety_separation_m;
    let bs: Float = (b).safety_separation_m;
    if as != bs {
        println("FAIL swarm_formation_config_default");
        process_exit(1);
    }
    println("prod_swarm_formation_default: PASSED");
}
