// # Product prove std/astrodynamics/julian_date.oo
//
// Logline: Fail-closed emit+gcc+run asserts j2000_jd is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/julian_date.oo.
//
// Beats:
//   1. Call j2000_jd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_julian_date: PASSED only if they match.

import "std/astrodynamics/julian_date.oo";

pub fn main() {
    let julian_date_mark: Int = 0;
    if julian_date_mark != 0 {
        process_exit(1);
    }
    let a: Int = j2000_jd();
    let b: Int = j2000_jd();
    if a != b {
        println("FAIL j2000_jd");
        process_exit(1);
    }
    println("prod_julian_date: PASSED");
}
