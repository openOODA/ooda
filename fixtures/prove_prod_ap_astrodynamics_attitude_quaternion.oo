// # Product prove std/astrodynamics/attitude_quaternion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/attitude_quaternion.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/attitude_quaternion.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_quaternion: PASSED only if they match.

import "std/astrodynamics/attitude_quaternion.oo";

pub fn main() {
    let attitude_quaternion_a = quat_ident_w();
    let attitude_quaternion_b = quat_ident_w();
    if attitude_quaternion_a != attitude_quaternion_b {
        println("FAIL attitude_quaternion");
        process_exit(1);
    }
    println("prod_ap_attitude_quaternion: PASSED");
}
