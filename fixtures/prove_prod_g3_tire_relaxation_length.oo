// # Product prove std/auto_mpc_control/tire_relaxation_length.oo
//
// Logline: Fail-closed emit+gcc+run asserts relaxation_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_relaxation_length.oo.
//
// Beats:
//   1. Call relaxation_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tire_relaxation_length: PASSED only if they match.

import "std/auto_mpc_control/tire_relaxation_length.oo";

pub fn main() {
    let tire_relaxation_length_mark: Int = 0;
    if tire_relaxation_length_mark != 0 {
        process_exit(1);
    }
    let a: RelaxationState = relaxation_state_new(0.0);
    let b: RelaxationState = relaxation_state_new(0.0);
    if (a).fy_current != (b).fy_current {
        println("FAIL relaxation_state_new");
        process_exit(1);
    }
    println("prod_tire_relaxation_length: PASSED");
}
