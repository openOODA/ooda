// # Product prove std/zk_rollup/zk_rollup_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts zk_rollup_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/zk_rollup_stubs.oo.
//
// Beats:
//   1. Call zk_rollup_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zk_rollup_stubs: PASSED only if they match.

import "std/zk_rollup/zk_rollup_stubs.oo";

pub fn main() {
    let zk_rollup_stubs_mark: Int = 0;
    if zk_rollup_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = zk_rollup_fail_closed("x", 0);
    let b: Bool = zk_rollup_fail_closed("x", 0);
    if a != b {
        println("FAIL zk_rollup_fail_closed");
        process_exit(1);
    }
    println("prod_zk_rollup_stubs: PASSED");
}
