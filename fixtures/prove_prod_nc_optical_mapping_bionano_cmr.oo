//
// Beats:
//   1. Call optical_mapping_bionano_cmr_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_optical_mapping_bionano_cmr: PASSED only if it matches.

import "std/genomics_advanced/optical_mapping_bionano_cmr.oo";

pub fn main() {
    let a: Int = optical_mapping_bionano_cmr_probe();
    if a != 0 {
        println("FAIL optical_mapping_bionano_cmr_probe");
        process_exit(1);
    }
    println("prod_nc_optical_mapping_bionano_cmr: PASSED");
}
