// # Product prove std/astrophysics_relativity/interstellar_extinction_reddening.oo
//
// Logline: Fail-closed emit+gcc+run asserts ccm_extinction_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/interstellar_extinction_reddening.oo.
//
// Beats:
//   1. Call ccm_extinction_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_interstellar_extinction_reddening: PASSED only if they match.

import "std/astrophysics_relativity/interstellar_extinction_reddening.oo";

pub fn main() {
    let interstellar_extinction_reddening_mark: Int = 0;
    if interstellar_extinction_reddening_mark != 0 {
        process_exit(1);
    }
    let a: Int = ccm_extinction_ratio(0, 0);
    let b: Int = ccm_extinction_ratio(0, 0);
    if a != b {
        println("FAIL ccm_extinction_ratio");
        process_exit(1);
    }
    println("prod_interstellar_extinction_reddening: PASSED");
}
