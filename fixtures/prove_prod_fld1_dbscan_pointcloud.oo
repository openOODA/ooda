// # Product prove std/lidar_perception/dbscan_pointcloud.oo
//
// Logline: Fail-closed emit+gcc+run asserts point_label_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/dbscan_pointcloud.oo.
//
// Beats:
//   1. Call point_label_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dbscan_pointcloud: PASSED only if they match.

import "std/lidar_perception/dbscan_pointcloud.oo";

pub fn main() {
    let dbscan_pointcloud_mark: Int = 0;
    if dbscan_pointcloud_mark != 0 {
        process_exit(1);
    }
    let dbscan_pointcloud_a = point_label_state_new(1);
    let dbscan_pointcloud_b = point_label_state_new(1);
    if (dbscan_pointcloud_a).point_idx != (dbscan_pointcloud_b).point_idx {
        println("FAIL point_label_state_new");
        process_exit(1);
    }
    println("prod_dbscan_pointcloud: PASSED");
}
