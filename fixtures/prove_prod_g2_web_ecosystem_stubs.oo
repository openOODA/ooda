// # Product prove std/web_ecosystem/web_ecosystem_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts web_eco_hardware_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/web_ecosystem_stubs.oo.
//
// Beats:
//   1. Call web_eco_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_web_ecosystem_stubs: PASSED only if they match.

import "std/web_ecosystem/web_ecosystem_stubs.oo";

pub fn main() {
    let web_ecosystem_stubs_mark: Int = 0;
    if web_ecosystem_stubs_mark != 0 {
        process_exit(1);
    }
    let a: WebEcoHardwareConfig = web_eco_hardware_config_new("x");
    let b: WebEcoHardwareConfig = web_eco_hardware_config_new("x");
    if (a).enabled != (b).enabled {
        println("FAIL web_eco_hardware_config_new");
        process_exit(1);
    }
    println("prod_g2_web_ecosystem_stubs: PASSED");
}
