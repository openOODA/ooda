// # Product prove std/iot_scada/ethercat_frame_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_cmd_lrd is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_frame_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ethercat_cmd_lrd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ethercat_frame_parser: PASSED only if they match.

import "std/iot_scada/ethercat_frame_parser.oo";

pub fn main() {
    let g0_a = ethercat_cmd_lrd();
    let g0_b = ethercat_cmd_lrd();
    if g0_a != g0_b {
        println("FAIL ethercat_cmd_lrd");
        process_exit(1);
    }
    println("prod_gr_ethercat_frame_parser: PASSED");
}
