// # Product prove std/auto_robot/costmap_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/costmap_2d.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/costmap_2d.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_costmap_2d: PASSED only if they match.

import "std/auto_robot/costmap_2d.oo";

pub fn main() {
    let costmap_2d_a = costmap_compute_inflation_cost(0, 0, 0, 0);
    let costmap_2d_b = costmap_compute_inflation_cost(0, 0, 0, 0);
    if costmap_2d_a != costmap_2d_b {
        println("FAIL costmap_2d");
        process_exit(1);
    }
    println("prod_ap_costmap_2d: PASSED");
}
