// # Product prove std/astro_advanced/lunar_orbit_insertion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/lunar_orbit_insertion.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/lunar_orbit_insertion.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lunar_orbit_insertion: PASSED only if they match.

import "std/astro_advanced/lunar_orbit_insertion.oo";

pub fn main() {
    let lunar_orbit_insertion_a = loi_dv();
    let lunar_orbit_insertion_b = loi_dv();
    if lunar_orbit_insertion_a != lunar_orbit_insertion_b {
        println("FAIL lunar_orbit_insertion");
        process_exit(1);
    }
    println("prod_ap_lunar_orbit_insertion: PASSED");
}
