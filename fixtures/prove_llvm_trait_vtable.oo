// # Prove LLVM Dynamic Trait VTables and Interface Polymorphism
//
// Logline: Verify LLVM backend dynamic dispatch, VTable generation, fat pointer coercions, and runtime polymorphism.
//
// Setup: Dog and Robot structs implement the Greeter trait with multiple methods; assertions verify indirect call correctness.
//
// Beats:
//   1. Define Greeter trait with greet and tag signatures.
//   2. Define Dog and Robot structs and implement Greeter for both.
//   3. Coerce concrete instances to dyn Greeter fat pointers.
//   4. Execute indirect dynamic dispatch through VTable function pointers.
//   5. Assert exact polymorphic computation results.

type Dog = struct {
    id: Int,
    power: Int,
}

type Robot = struct {
    serial: Int,
    multiplier: Int,
}

trait Greeter {
    fn greet(self: Dog, factor: Int) -> Int;
    fn tag(self: Dog) -> Int;
}

impl Greeter for Dog {
    fn Dog_greet(self: Dog, factor: Int) -> Int {
        return self.power * factor + self.id;
    }
    fn Dog_tag(self: Dog) -> Int {
        return self.id;
    }
}

impl Greeter for Robot {
    fn Robot_greet(self: Robot, factor: Int) -> Int {
        return self.multiplier * factor + self.serial;
    }
    fn Robot_tag(self: Robot) -> Int {
        return self.serial + 1000;
    }
}

pub fn main() {
    let d = Dog { id: 7, power: 10 };
    let r = Robot { serial: 42, multiplier: 3 };

    let g_dog: dyn Greeter = d;
    let dog_res = g_dog.greet(5);
    let dog_tag = g_dog.tag();
    println("Dog greet: " + dog_res.to_string());
    println("Dog tag: " + dog_tag.to_string());
    assert(dog_res == 57);
    assert(dog_tag == 7);

    let g_bot: dyn Greeter = r;
    let bot_res = g_bot.greet(5);
    let bot_tag = g_bot.tag();
    println("Robot greet: " + bot_res.to_string());
    println("Robot tag: " + bot_tag.to_string());
    assert(bot_res == 57);
    assert(bot_tag == 1042);

    println("PROVE_LLVM_TRAIT_VTABLE_OK");
}
