// # Product prove std/net_telemetry/tcp_segment.oo
//
// Logline: Fail-closed emit+gcc+run asserts tcp_segment_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/tcp_segment.oo.
//
// Beats:
//   1. Call tcp_segment_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tcp_segment: PASSED only if they match.

import "std/net_telemetry/tcp_segment.oo";

pub fn main() {
    let a: TcpSegment = tcp_segment_parse(list_new(), 0);
    let b: TcpSegment = tcp_segment_parse(list_new(), 0);
    if (a).src_port != (b).src_port {
        println("FAIL tcp_segment_parse");
        process_exit(1);
    }
    println("prod_g2_tcp_segment: PASSED");
}
