// # Result[List[Name]] emit must fail closed
//
// Logline: Emit of Result[List[Name]] must fail closed (no invented OoResL_*).
//
// Setup: Backend-C. Node is a user struct; Result[List[Node], String] has no typedef.
//
// Beats:
//   1. type Node = struct { id: Int }.
//   2. nodes() returns Ok of a one-Node list.
//   3. main calls nodes(); emit must ERR\tc_emit, not invent OoResL_Node.

type Node = struct {
    id: Int
};

fn nodes() -> Result[List[Node], String] {
    let mut xs: List[Node] = list_new();
    let n: Node = Node { id: 1 };
    xs = list_push(xs, n);
    return Ok(xs);
}

pub fn main() {
    let r: Result[List[Node], String] = nodes();
}
