// # Product prove std/crispr_cas/base_editing_bystander_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts base_editing_bystander_filter_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/base_editing_bystander_filter.oo.
//
// Beats:
//   1. Call base_editing_bystander_filter_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_base_editing_bystander_filter: PASSED only if they match.

import "std/crispr_cas/base_editing_bystander_filter.oo";

pub fn main() {
    let a: Int = base_editing_bystander_filter_probe();
    let b: Int = base_editing_bystander_filter_probe();
    if a != b {
        println("FAIL base_editing_bystander_filter_probe");
        process_exit(1);
    }
    println("prod_g2_base_editing_bystander_filter: PASSED");
}
