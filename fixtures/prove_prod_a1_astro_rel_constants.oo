// # Product prove std/astrophysics_relativity/astro_rel_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts const_c is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/astro_rel_constants.oo.
//
// Beats:
//   1. Call const_c twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_astro_rel_constants: PASSED only if they match.

import "std/astrophysics_relativity/astro_rel_constants.oo";

pub fn main() {
    let astro_rel_constants_mark: Int = 0;
    if astro_rel_constants_mark != 0 {
        process_exit(1);
    }
    let a: Float = const_c();
    let b: Float = const_c();
    if a != b {
        println("FAIL const_c");
        process_exit(1);
    }
    println("prod_astro_rel_constants: PASSED");
}
