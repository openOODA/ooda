// # Product prove std/astrodynamics/coordinate_eci_ecef.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/coordinate_eci_ecef.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/coordinate_eci_ecef.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_coordinate_eci_ecef: PASSED only if they match.

import "std/astrodynamics/coordinate_eci_ecef.oo";

pub fn main() {
    let coordinate_eci_ecef_a = earth_omega_nano();
    let coordinate_eci_ecef_b = earth_omega_nano();
    if coordinate_eci_ecef_a != coordinate_eci_ecef_b {
        println("FAIL coordinate_eci_ecef");
        process_exit(1);
    }
    println("prod_ap_coordinate_eci_ecef: PASSED");
}
