// # Product prove std/physics/aerodynamic_drag.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/aerodynamic_drag.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/physics/aerodynamic_drag.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_aerodynamic_drag: PASSED only if they match.

import "std/physics/aerodynamic_drag.oo";

pub fn main() {
    let aerodynamic_drag_a = atmosphere_isa_standard();
    let aerodynamic_drag_b = atmosphere_isa_standard();
    if aerodynamic_drag_a.sea_level_density != aerodynamic_drag_b.sea_level_density {
        println("FAIL aerodynamic_drag");
        process_exit(1);
    }
    println("prod_ap_aerodynamic_drag: PASSED");
}
