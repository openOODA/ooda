// # Const INT==INT if print
//
// Logline: Print EQ from if 1==1 and NE from the else of if 1==0.
//
// Setup: Side emit-aarch64 folds INT EQEQ INT only. IDENT compare stays leftover.
//
// Beats:
//   1. if 1==1 print EQ.
//   2. if 1==0 else print NE.
//   3. Expect EQ and NE.

pub fn main() {
    if 1 == 1 {
        println("EQ");
    }
    if 1 == 0 {
        println("BAD");
    } else {
        println("NE");
    }
}
