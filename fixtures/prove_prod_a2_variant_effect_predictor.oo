// # Product prove std/bio_advanced/variant_effect_predictor.oo
//
// Logline: Fail-closed emit+gcc+run asserts vep_impact_high is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/variant_effect_predictor.oo.
//
// Beats:
//   1. Call vep_impact_high twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_variant_effect_predictor: PASSED only if they match.

import "std/bio_advanced/variant_effect_predictor.oo";
import "std/str.oo";

pub fn main() {
    let variant_effect_predictor_mark: Int = 0;
    if variant_effect_predictor_mark != 0 {
        process_exit(1);
    }
    let a: String = vep_impact_high();
    let b: String = vep_impact_high();
    if str_eq(a, b) == false {
        println("FAIL vep_impact_high");
        process_exit(1);
    }
    println("prod_variant_effect_predictor: PASSED");
}
