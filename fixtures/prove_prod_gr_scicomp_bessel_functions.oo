// # Product prove std/scicomp/bessel_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts bessel_j0 is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/bessel_functions.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call bessel_j0 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_bessel_functions: PASSED only if they match.

import "std/scicomp/bessel_functions.oo";

pub fn main() {
    let g0_a = bessel_j0(0.0);
    let g0_b = bessel_j0(0.0);
    if g0_a != g0_b {
        println("FAIL bessel_j0");
        process_exit(1);
    }
    println("prod_gr_bessel_functions: PASSED");
}
