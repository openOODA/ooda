// # Product prove std/quantum_open_systems/caldeira_leggett_dissipation.oo
//
// Logline: Fail-closed emit+gcc+run asserts caldeira_leggett_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/caldeira_leggett_dissipation.oo.
//
// Beats:
//   1. Call caldeira_leggett_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_caldeira_leggett_dissipation: PASSED only if they match.

import "std/quantum_open_systems/caldeira_leggett_dissipation.oo";

pub fn main() {
    let caldeira_leggett_dissipation_mark: Int = 0;
    if caldeira_leggett_dissipation_mark != 0 {
        process_exit(1);
    }
    let a: CaldeiraLeggettParams = caldeira_leggett_params_new(0.0, 0.0, 0.0, 0.0);
    let b: CaldeiraLeggettParams = caldeira_leggett_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).mass != (b).mass {
        println("FAIL caldeira_leggett_params_new");
        process_exit(1);
    }
    println("prod_caldeira_leggett_dissipation: PASSED");
}
