// # For-range sum
//
// Logline: Sum i in 0..5 after for desugars to while.
//
// Beats:
//   1. Loop i in 0..5.
//   2. Add i into s.
//   3. Print the sum.

// for i in lo..hi desugars to while (interp + CHS C + WASM + LLVM).
pub fn main() {
    let mut s = 0;
    for i in 0..5 {
        s = s + i;
    }
    println(s);
}
