// # Product prove std/zk_rollup/stark_fri_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts stark_proof_envelope_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_fri_verifier.oo.
//
// Beats:
//   1. Call stark_proof_envelope_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stark_fri_verifier: PASSED only if they match.

import "std/zk_rollup/stark_fri_verifier.oo";

pub fn main() {
    let stark_fri_verifier_mark: Int = 0;
    if stark_fri_verifier_mark != 0 {
        process_exit(1);
    }
    let a: StarkProofEnvelope = stark_proof_envelope_new("x", "x", list_new(), 0);
    let b: StarkProofEnvelope = stark_proof_envelope_new("x", "x", list_new(), 0);
    if (a).fri_final_constant != (b).fri_final_constant {
        println("FAIL stark_proof_envelope_new");
        process_exit(1);
    }
    println("prod_stark_fri_verifier: PASSED");
}
