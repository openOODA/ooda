// # Product C emit: match-let Ok/Err without slist OOB
//
// Logline: Fail-closed emit+gcc+run of match on Result[String, String].
//
// Setup: Isolated emit-c. Match-let must not slist_get OOB on Err(_).
//
// Beats:
//   1. Ok("hi") match binds "hi" (len 2).
//   2. Exit 1 on miss. Print prod_match_let_err: PASSED only if it holds.

pub fn ml_ok(raw: String) -> Result[String, String] {
    return Ok(raw);
}

pub fn main() {
    let r: Result[String, String] = ml_ok("hi");
    let match_let_err_a: String = match r {
        Ok(v) => v,
        Err(_) => ""
    };
    if chars_len(match_let_err_a) != 2 {
        println("FAIL match_let");
        process_exit(1);
    }
    println("prod_match_let_err: PASSED");
}
