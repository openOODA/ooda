// # Product prove std/web_ecosystem/lodash_debounce.oo
//
// Logline: Fail-closed emit+gcc+run asserts debounce_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_debounce.oo.
//
// Beats:
//   1. Call debounce_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lodash_debounce: PASSED only if they match.

import "std/web_ecosystem/lodash_debounce.oo";

pub fn main() {
    let lodash_debounce_mark: Int = 0;
    if lodash_debounce_mark != 0 {
        process_exit(1);
    }
    let a: DebounceState = debounce_new(0);
    let b: DebounceState = debounce_new(0);
    if (a).wait_ms != (b).wait_ms {
        println("FAIL debounce_new");
        process_exit(1);
    }
    println("prod_lodash_debounce: PASSED");
}
