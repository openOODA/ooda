// # Product prove std/net/websocket_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net/websocket_frame.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/websocket_frame.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_websocket_frame: PASSED only if they match.

import "std/net/websocket_frame.oo";

pub fn main() {
    let websocket_frame_a = ws_frame_opcode_name(0);
    let websocket_frame_b = ws_frame_opcode_name(0);
    if websocket_frame_a.contains(websocket_frame_b) == false {
        println("FAIL websocket_frame");
        process_exit(1);
    }
    if websocket_frame_b.contains(websocket_frame_a) == false {
        println("FAIL websocket_frame");
        process_exit(1);
    }
    println("prod_ap_websocket_frame: PASSED");
}
