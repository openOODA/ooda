// # Product prove std/zk_rollup/stark_execution_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts stark_trace_table_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_execution_trace.oo.
//
// Beats:
//   1. Call stark_trace_table_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_stark_execution_trace: PASSED only if asserts hold.

import "std/zk_rollup/stark_execution_trace.oo";

pub fn main() {
    let stark_execution_trace_a: StarkTraceTable = stark_trace_table_new(1, 1);
    let stark_execution_trace_b: StarkTraceTable = stark_trace_table_new(1, 1);
    if stark_execution_trace_a.num_rows != stark_execution_trace_b.num_rows {
        println("FAIL stark_trace_table_new");
        process_exit(1);
    }
    println("prod_stark_execution_trace: PASSED");
}
