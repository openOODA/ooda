// # Product prove std/db_storage/btree_slotted_page_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts slotted_page_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_slotted_page_layout.oo.
//
// Beats:
//   1. Call slotted_page_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_slotted_page_layout: PASSED only if they match.

import "std/db_storage/btree_slotted_page_layout.oo";

pub fn main() {
    let btree_slotted_page_layout_mark: Int = 0;
    if btree_slotted_page_layout_mark != 0 {
        process_exit(1);
    }
    let a: SlottedPage = slotted_page_new(0, true, 0);
    let b: SlottedPage = slotted_page_new(0, true, 0);
    if (a).page_size != (b).page_size {
        println("FAIL slotted_page_new");
        process_exit(1);
    }
    println("prod_btree_slotted_page_layout: PASSED");
}
