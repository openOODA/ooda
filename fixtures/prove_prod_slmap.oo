// # Product skip_list_map prove
import "std/collections/skip_list_map.oo";
pub fn main() {
    let mut m: SkipListMap = skip_list_map_new();
    m = skip_list_map_insert(m, 7, 1);
    let n: Int = skip_list_map_len(m);
    if n != 1 {
        println("FAIL slmap len");
        process_exit(1);
    }
    let c7: Bool = skip_list_map_contains(m, 7);
    if c7 == false {
        println("FAIL slmap 7");
        process_exit(1);
    }
    println("prod_slmap: PASSED");
}
