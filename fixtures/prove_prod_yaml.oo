// # Product prove std/markup/yaml.oo
//
// Logline: Fail-closed emit+gcc+run asserts yaml_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/yaml.oo.
//
// Beats:
//   1. Call yaml_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yaml: PASSED only if they match.

import "std/markup/yaml.oo";

pub fn main() {
    let a = yaml_parse("x");
    let b = yaml_parse("x");
    if a != b {
        println("FAIL yaml_parse");
        process_exit(1);
    }
    println("prod_yaml: PASSED");
}
