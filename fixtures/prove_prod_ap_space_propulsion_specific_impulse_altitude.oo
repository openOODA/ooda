// # Product prove std/space_propulsion/specific_impulse_altitude.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/specific_impulse_altitude.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/specific_impulse_altitude.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_specific_impulse_altitude: PASSED only if they match.

import "std/space_propulsion/specific_impulse_altitude.oo";

pub fn main() {
    let specific_impulse_altitude_a = atmosphere_pressure_at_alt(0.0);
    let specific_impulse_altitude_b = atmosphere_pressure_at_alt(0.0);
    if specific_impulse_altitude_a != specific_impulse_altitude_b {
        println("FAIL specific_impulse_altitude");
        process_exit(1);
    }
    println("prod_ap_specific_impulse_altitude: PASSED");
}
