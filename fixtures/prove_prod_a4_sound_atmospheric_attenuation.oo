// # Product prove std/physics_advanced/sound_atmospheric_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts atmospheric_standard_isa is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/sound_atmospheric_attenuation.oo.
//
// Beats:
//   1. Call atmospheric_standard_isa twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sound_atmospheric_attenuation: PASSED only if they match.

import "std/physics_advanced/sound_atmospheric_attenuation.oo";

pub fn main() {
    let sound_atmospheric_attenuation_mark: Int = 0;
    if sound_atmospheric_attenuation_mark != 0 {
        process_exit(1);
    }
    let a: AtmosphericConditions = atmospheric_standard_isa();
    let b: AtmosphericConditions = atmospheric_standard_isa();
    if (a).temperature_kelvin != (b).temperature_kelvin {
        println("FAIL atmospheric_standard_isa");
        process_exit(1);
    }
    println("prod_sound_atmospheric_attenuation: PASSED");
}
