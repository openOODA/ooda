// # Const INT<=INT if print
//
// Logline: Print LE from if 1<=2, EQ from if 1<=1, and GT from the else of if 2<=1.
//
// Setup: Side emit-aarch64 folds INT LTE INT only when LBRACE follows.
//
// Beats:
//   1. if 1 <= 2 print LE.
//   2. if 1 <= 1 print EQ.
//   3. if 2 <= 1 else print GT.

pub fn main() {
    if 1 <= 2 {
        println("LE");
    }
    if 1 <= 1 {
        println("EQ");
    }
    if 2 <= 1 {
        println("BAD");
    } else {
        println("GT");
    }
}
