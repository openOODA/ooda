// # Product prove std/security_defense/landlock_policy_compiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_access_to_mask is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/landlock_policy_compiler.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call landlock_access_to_mask twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_landlock_policy_compiler: PASSED only if they match.

import "std/security_defense/landlock_policy_compiler.oo";

pub fn main() {
    let g0_oa: LandlockAccessFs = LandlockAccessFs { read_file: true, read_dir: true, write_file: true, execute_file: true, create_char: true, create_dir: true, create_regular: true, create_symlink: true, remove_dir: true, remove_file: true, make_char: true, make_dir: true, make_reg: true, make_symlink: true };
    let g0_ob: LandlockAccessFs = LandlockAccessFs { read_file: true, read_dir: true, write_file: true, execute_file: true, create_char: true, create_dir: true, create_regular: true, create_symlink: true, remove_dir: true, remove_file: true, make_char: true, make_dir: true, make_reg: true, make_symlink: true };
    let g0_a = landlock_access_to_mask(&g0_oa);
    let g0_b = landlock_access_to_mask(&g0_ob);
    if g0_a != g0_b {
        println("FAIL landlock_access_to_mask");
        process_exit(1);
    }
    println("prod_gr_landlock_policy_compiler: PASSED");
}
