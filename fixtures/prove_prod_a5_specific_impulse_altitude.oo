// # Product prove std/space_propulsion/specific_impulse_altitude.oo
//
// Logline: Fail-closed emit+gcc+run asserts atmosphere_pressure_at_alt is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/specific_impulse_altitude.oo.
//
// Beats:
//   1. Call atmosphere_pressure_at_alt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_specific_impulse_altitude: PASSED only if they match.

import "std/space_propulsion/specific_impulse_altitude.oo";

pub fn main() {
    let specific_impulse_altitude_mark: Int = 0;
    if specific_impulse_altitude_mark != 0 {
        process_exit(1);
    }
    let a: Float = atmosphere_pressure_at_alt(0.0);
    let b: Float = atmosphere_pressure_at_alt(0.0);
    if a != b {
        println("FAIL atmosphere_pressure_at_alt");
        process_exit(1);
    }
    println("prod_specific_impulse_altitude: PASSED");
}
