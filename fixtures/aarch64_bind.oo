// # Same-fn string bind
//
// Logline: Bind a string let in main and print that ident.
//
// Setup: Side emit-aarch64 must fold the bind, not leftover the ident.
//
// Beats:
//   1. Bind x to Hi.
//   2. Print x.
//   3. Leave call-result idents residual.

pub fn main() {
    let x = "Hi";
    println(x);
}
