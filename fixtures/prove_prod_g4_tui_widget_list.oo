// # Product prove std/tui/widget_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/tui/widget_list.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/widget_list.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_tui_widget_list: PASSED and exit 0 only on match.

import "std/tui/widget_list.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_tui_widget_list_oo();
    let dummy_b: Int = __dummy_std_src_ooda_tui_widget_list_oo();
    if dummy_a != dummy_b {
        println("FAIL tui_widget_list dummy");
        process_exit(1);
    }

    let item_a: ListItem = list_item_new(101, "Config Option 1");
    let item_b: ListItem = list_item_new(101, "Config Option 1");
    let id_a: Int = item_a.id;
    let id_b: Int = item_b.id;
    if id_a != id_b {
        println("FAIL list_item_new id mismatch");
        process_exit(1);
    }

    let area_a: BufferArea = buffer_area_new(0, 0, 80, 24);
    let area_b: BufferArea = buffer_area_new(0, 0, 80, 24);

    let wl_a: WidgetList = widget_list_new(1, area_a);
    let wl_b: WidgetList = widget_list_new(1, area_b);

    let wl_added_a: WidgetList = widget_list_add_item(wl_a, "Alpha");
    let wl_added_b: WidgetList = widget_list_add_item(wl_b, "Alpha");

    let count_a: Int = widget_list_get_item_count(wl_added_a);
    let count_b: Int = widget_list_get_item_count(wl_added_b);
    if count_a != count_b {
        println("FAIL widget_list_get_item_count mismatch");
        process_exit(1);
    }

    let sel_a: Int = widget_list_get_selected_index(wl_added_a);
    let sel_b: Int = widget_list_get_selected_index(wl_added_b);
    if sel_a != sel_b {
        println("FAIL widget_list_get_selected_index mismatch");
        process_exit(1);
    }

    println("prod_g4_tui_widget_list: PASSED");
    process_exit(0);
}
