// # Product prove std/bft_consensus/dag_bullshark_fair_ordering.oo
//
// Logline: Fail-closed emit+gcc+run asserts bullshark_is_leader_round is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_bullshark_fair_ordering.oo.
//
// Beats:
//   1. Call bullshark_is_leader_round twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dag_bullshark_fair_ordering: PASSED only if they match.

import "std/bft_consensus/dag_bullshark_fair_ordering.oo";

pub fn main() {
    let dag_bullshark_fair_ordering_mark: Int = 0;
    if dag_bullshark_fair_ordering_mark != 0 {
        process_exit(1);
    }
    let a: Bool = bullshark_is_leader_round(0);
    let b: Bool = bullshark_is_leader_round(0);
    if a != b {
        println("FAIL bullshark_is_leader_round");
        process_exit(1);
    }
    println("prod_dag_bullshark_fair_ordering: PASSED");
}
