// # Product prove std/media_dsp/png_filter_paeth.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/png_filter_paeth.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/png_filter_paeth.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_png_filter_paeth: PASSED only if they match.

import "std/media_dsp/png_filter_paeth.oo";

pub fn main() {
    let png_filter_paeth_a = png_filter_type_none();
    let png_filter_paeth_b = png_filter_type_none();
    if png_filter_paeth_a != png_filter_paeth_b {
        println("FAIL png_filter_paeth");
        process_exit(1);
    }
    println("prod_ap_png_filter_paeth: PASSED");
}
