// # Product prove std/protein_folding/folding_simulated_annealing.oo
//
// Logline: Fail-closed emit+gcc+run asserts annealing_schedule_default real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_simulated_annealing.oo.
//
// Beats:
//   1. Call annealing_schedule_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_folding_simulated_annealing: PASSED only if the assert holds.

import "std/protein_folding/folding_simulated_annealing.oo";

pub fn main() {
    let folding_simulated_annealing_mark: Int = 0;
    if folding_simulated_annealing_mark != 0 {
        process_exit(1);
    }
    let folding_simulated_annealing_a = annealing_schedule_default(2.0, 2.0, 7);
    let folding_simulated_annealing_total_steps: Int = (folding_simulated_annealing_a).total_steps;
    if folding_simulated_annealing_total_steps != 7 {
        println("FAIL annealing_schedule_default");
        process_exit(1);
    }
    println("prod_folding_simulated_annealing: PASSED");
}
