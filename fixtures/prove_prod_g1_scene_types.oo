// # Product prove std/3d/scene_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts scene_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/scene_types.oo.
//
// Beats:
//   1. Call scene_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_scene_types: PASSED only if they match.

import "std/3d/scene_types.oo";

pub fn main() {
    let obj_a: Scene = scene_new();
    let obj_b: Scene = scene_new();
    let a: Int = scene_len(obj_a);
    let b: Int = scene_len(obj_b);
    if a != 0 {
        println("FAIL scene_len");
        process_exit(1);
    }
    if a != b {
        println("FAIL scene_len");
        process_exit(1);
    }
    println("prod_scene_types: PASSED");
}
