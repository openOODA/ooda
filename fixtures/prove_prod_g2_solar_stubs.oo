// # Product prove std/grid/solar_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_raytrace_3d_shading_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_stubs.oo.
//
// Beats:
//   1. Call solar_raytrace_3d_shading_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_solar_stubs: PASSED only if they match.

import "std/grid/solar_stubs.oo";

pub fn main() {
    let solar_stubs_mark: Int = 0;
    if solar_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Float = solar_raytrace_3d_shading_matrix(0, 0.0, 0.0);
    let b: Float = solar_raytrace_3d_shading_matrix(0, 0.0, 0.0);
    if a != b {
        println("FAIL solar_raytrace_3d_shading_matrix");
        process_exit(1);
    }
    println("prod_g2_solar_stubs: PASSED");
}
