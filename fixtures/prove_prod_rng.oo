// # Product LCG / random_dist prove
//
// Logline: Fail-closed emit+gcc+run of shipped rng_new/rng_next/rng_uniform_int.
//
// Setup: Product std/math/random_dist.oo. ANSI C LCG (s*1103515245+12345)%2147483647.
//
// Beats:
//   1. seed 1 next is 1103527590; that seed next is 944465040.
//   2. seed 0 remaps to 123456789; uniform_int [0,9] of seed 1 is 0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/random_dist.oo";

pub fn main() {
    let r1: RngState = rng_new(1);
    let n1: Int = rng_next(r1);
    if n1 != 1103527590 {
        println("FAIL rng next seed1");
        process_exit(1);
    }
    let r2: RngState = rng_new(n1);
    let n2: Int = rng_next(r2);
    if n2 != 944465040 {
        println("FAIL rng next2");
        process_exit(1);
    }
    let z: RngState = rng_new(0);
    let zs: Int = z.state;
    if zs != 123456789 {
        println("FAIL rng seed0 remap");
        process_exit(1);
    }
    let z2: RngState = rng_new(0);
    let zn: Int = rng_next(z2);
    if zn != 295234770 {
        println("FAIL rng next seed0");
        process_exit(1);
    }
    let r3: RngState = rng_new(1);
    let u: Int = rng_uniform_int(r3, 0, 9);
    if u != 0 {
        println("FAIL rng uniform_int");
        process_exit(1);
    }
    println("prod_rng: PASSED");
}
