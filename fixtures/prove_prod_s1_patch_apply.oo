// # Product prove std/web_ecosystem/patch_apply.oo
//
// Logline: Fail-closed emit+gcc+run asserts patch_apply_op is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/patch_apply.oo.
//
// Beats:
//   1. Call patch_apply_op twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_patch_apply: PASSED only if they match.

import "std/web_ecosystem/patch_apply.oo";

pub fn main() {
    let patch_apply_mark: Int = 0;
    if patch_apply_mark != 0 {
        process_exit(1);
    }
    let patch_apply_a: Int = patch_apply_op(1, 1, 1);
    let patch_apply_b: Int = patch_apply_op(1, 1, 1);
    if patch_apply_a != patch_apply_b {
        println("FAIL patch_apply_op");
        process_exit(1);
    }
    println("prod_patch_apply: PASSED");
}
