// # Product prove std/robotics_auv/depth_pitch_cascaded_pid.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth_pitch_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/depth_pitch_cascaded_pid.oo.
//
// Beats:
//   1. Call depth_pitch_gains_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_depth_pitch_gains: PASSED only if they match.

import "std/robotics_auv/depth_pitch_cascaded_pid.oo";

pub fn main() {
    let depth_pitch_cascaded_pid_mark: Int = 0;
    if depth_pitch_cascaded_pid_mark != 0 { process_exit(1); }
    let a: DepthPitchGains = depth_pitch_gains_default();
    let b: DepthPitchGains = depth_pitch_gains_default();
    let ak: Float = (a).kp_depth;
    let bk: Float = (b).kp_depth;
    if ak != bk {
        println("FAIL depth_pitch_gains_default");
        process_exit(1);
    }
    println("prod_depth_pitch_gains: PASSED");
}
