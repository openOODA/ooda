// # Product prove std/pqc_nist/pqc_known_answer_tests.oo
//
// Logline: Fail-closed emit+gcc+run asserts kat_suite_result_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_known_answer_tests.oo.
//
// Beats:
//   1. Call kat_suite_result_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pqc_known_answer_tests: PASSED only if asserts hold.

import "std/pqc_nist/pqc_known_answer_tests.oo";

pub fn main() {
    let pqc_known_answer_tests = kat_suite_result_new("x", 2, 2);
    let pqc_known_answer_tests_b = kat_suite_result_new("x", 2, 2);
    if pqc_known_answer_tests.tests_total != 2 {
        println("FAIL kat_suite_result_new tests_total");
        process_exit(1);
    }
    if pqc_known_answer_tests.tests_total != pqc_known_answer_tests_b.tests_total {
        println("FAIL kat_suite_result_new det");
        process_exit(1);
    }
    println("prod_pqc_known_answer_tests: PASSED");
}
