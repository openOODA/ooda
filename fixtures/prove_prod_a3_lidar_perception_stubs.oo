// # Product prove std/lidar_perception/lidar_perception_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts lidar_hal_packet_read_stub is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/lidar_perception_stubs.oo.
//
// Beats:
//   1. Call lidar_hal_packet_read_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lidar_perception_stubs: PASSED only if they match.

import "std/lidar_perception/lidar_perception_stubs.oo";

pub fn main() {
    let lidar_perception_stubs_mark: Int = 0;
    if lidar_perception_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = lidar_hal_packet_read_stub(0, true);
    let b: Int = lidar_hal_packet_read_stub(0, true);
    if a != b {
        println("FAIL lidar_hal_packet_read_stub");
        process_exit(1);
    }
    println("prod_lidar_perception_stubs: PASSED");
}
