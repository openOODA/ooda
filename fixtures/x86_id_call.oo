// # emit-x86 one-arg SysV identity call
//
// Logline: Call id on hi and print the returned string so emit-x86 must lea %rdi then call.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No const-fold of the call.
//
// Beats:
//   1. Declare identity String passthrough id.
//   2. Print id("hi").
//   3. Expect hi from a real call, not a harvested write.

fn id(s: String) -> String {
    return s;
}

pub fn main() {
    println(id("hi"));
}
