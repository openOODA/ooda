// # Product prove std/tda_topology/boundary_matrix_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts column_is_empty is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/boundary_matrix_reduction.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call column_is_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_boundary_matrix_reduction: PASSED only if they match.

import "std/tda_topology/boundary_matrix_reduction.oo";

pub fn main() {
    let g0_oa: SparseColumn = SparseColumn { col_index: 0, row_indices: list_new(), low_row: 0 };
    let g0_ob: SparseColumn = SparseColumn { col_index: 0, row_indices: list_new(), low_row: 0 };
    let g0_a = column_is_empty(&g0_oa);
    let g0_b = column_is_empty(&g0_ob);
    if g0_a != g0_b {
        println("FAIL column_is_empty");
        process_exit(1);
    }
    println("prod_gr_boundary_matrix_reduction: PASSED");
}
