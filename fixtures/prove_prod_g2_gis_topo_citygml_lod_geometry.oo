// # Product prove std/gis_topo/citygml_lod_geometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts citygml_total_height is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/citygml_lod_geometry.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call citygml_total_height twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_citygml_lod_geometry: PASSED only if they match.

import "std/gis_topo/citygml_lod_geometry.oo";

pub fn main() {
    let g2_oa: CityGmlBuilding = citygml_building_new("x", 2, 1.0, 1.0, 1.0, "x");
    let g2_ob: CityGmlBuilding = citygml_building_new("x", 2, 1.0, 1.0, 1.0, "x");
    let g2_a = citygml_total_height(&g2_oa);
    let g2_b = citygml_total_height(&g2_ob);
    if g2_a != g2_b {
        println("FAIL citygml_total_height");
        process_exit(1);
    }
    println("prod_g2_citygml_lod_geometry: PASSED");
}
