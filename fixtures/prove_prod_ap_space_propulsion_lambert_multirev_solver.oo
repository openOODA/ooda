// # Product prove std/space_propulsion/lambert_multirev_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/lambert_multirev_solver.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/lambert_multirev_solver.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_lambert_multirev_solver: PASSED only if they match.

import "std/space_propulsion/lambert_multirev_solver.oo";

pub fn main() {
    let lambert_multirev_solver_a = multi_rev_spec_default_earth_mars_1rev();
    let lambert_multirev_solver_b = multi_rev_spec_default_earth_mars_1rev();
    if lambert_multirev_solver_a.r1_mag_m != lambert_multirev_solver_b.r1_mag_m {
        println("FAIL lambert_multirev_solver");
        process_exit(1);
    }
    println("prod_ap_lambert_multirev_solver: PASSED");
}
