// # Product prove std/net/x402_spend.oo
//
// Logline: Fail-closed emit+gcc+run asserts x402_spend_pin_on is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/x402_spend.oo.
//
// Beats:
//   1. Call x402_spend_pin_on twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_x402_spend: PASSED only if they match.

import "std/net/x402_spend.oo";

pub fn main() {
    let a = x402_spend_pin_on("x");
    let b = x402_spend_pin_on("x");
    if a != b {
        println("FAIL x402_spend_pin_on");
        process_exit(1);
    }
    println("prod_x402_spend: PASSED");
}
