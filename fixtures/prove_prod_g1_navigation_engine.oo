// # Product prove std/aero/navigation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_eng_sats is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_engine.oo.
//
// Beats:
//   1. Call nav_eng_sats twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_navigation_engine: PASSED only if they match.

import "std/aero/navigation_engine.oo";

pub fn main() {
    let obj_a: NavEng = nav_eng_new(0, 0);
    let obj_b: NavEng = nav_eng_new(0, 0);
    let a: Int = nav_eng_sats(obj_a);
    let b: Int = nav_eng_sats(obj_b);
    if a != b {
        println("FAIL nav_eng_sats");
        process_exit(1);
    }
    println("prod_navigation_engine: PASSED");
}
