// # Product prove std/satellite_dvb/satellite_antenna_itu_s465.oo
//
// Logline: Fail-closed emit+gcc+run asserts antenna_calc_peak_gain_dbi is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_antenna_itu_s465.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call antenna_calc_peak_gain_dbi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_satellite_antenna_itu_s465: PASSED only if they match.

import "std/satellite_dvb/satellite_antenna_itu_s465.oo";

pub fn main() {
    let g0_oa: EarthStationAntenna = EarthStationAntenna { diameter_m: 1.0, efficiency_eta: 1.0, // Typically 0.60 .. 0.70
    carrier_freq_ghz: 1.0 };
    let g0_ob: EarthStationAntenna = EarthStationAntenna { diameter_m: 1.0, efficiency_eta: 1.0, // Typically 0.60 .. 0.70
    carrier_freq_ghz: 1.0 };
    let g0_a = antenna_calc_peak_gain_dbi(&g0_oa);
    let g0_b = antenna_calc_peak_gain_dbi(&g0_ob);
    if g0_a != g0_b {
        println("FAIL antenna_calc_peak_gain_dbi");
        process_exit(1);
    }
    println("prod_g0_satellite_antenna_itu_s465: PASSED");
}
