// # Product prove std/crypto_advanced/bn254_curve_g1.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/bn254_curve_g1.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_curve_g1.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bn254_curve_g1: PASSED only if they match.

import "std/crypto_advanced/bn254_curve_g1.oo";

pub fn main() {
    let bn254_curve_g1_a = bn254_g1_infinity(0);
    let bn254_curve_g1_b = bn254_g1_infinity(0);
    let bn254_curve_g1_va = bn254_g1_is_on_curve(bn254_curve_g1_a);
    let bn254_curve_g1_vb = bn254_g1_is_on_curve(bn254_curve_g1_b);
    if bn254_curve_g1_va != bn254_curve_g1_vb {
        println("FAIL bn254_curve_g1");
        process_exit(1);
    }
    println("prod_ap_bn254_curve_g1: PASSED");
}
