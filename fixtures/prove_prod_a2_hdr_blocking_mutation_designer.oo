// # Product prove std/crispr_cas/hdr_blocking_mutation_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts blocking_design_pam_mutation is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/hdr_blocking_mutation_designer.oo.
//
// Beats:
//   1. Call blocking_design_pam_mutation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hdr_blocking_mutation_designer: PASSED only if they match.

import "std/crispr_cas/hdr_blocking_mutation_designer.oo";

pub fn main() {
    let hdr_blocking_mutation_designer_mark: Int = 0;
    if hdr_blocking_mutation_designer_mark != 0 {
        process_exit(1);
    }
    let a: BlockingMutationCandidate = blocking_design_pam_mutation("x");
    let b: BlockingMutationCandidate = blocking_design_pam_mutation("x");
    if (a).is_synonymous != (b).is_synonymous {
        println("FAIL blocking_design_pam_mutation");
        process_exit(1);
    }
    println("prod_hdr_blocking_mutation_designer: PASSED");
}
