// # Allow a chained call on a public string
//
// Logline: A method chain on an untagged helper stays clean at println.
//
// Beats:
//   1. Return a public literal from safe_make.
//   2. Tag api_key at line start in main.
//   3. Print safe_make().len() so the sink stays allowed.

// M-? method-call clean: chained call returns clean value
pub fn safe_make() -> String {
    return "public";
}
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let y = safe_make().len();
    println(y);
}
