// # Product prove std/fhe_lattices/fhe_bfv_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_compute_delta is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bfv_ciphertext.oo.
//
// Beats:
//   1. Call bfv_compute_delta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_bfv_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_bfv_ciphertext.oo";

pub fn main() {
    let fhe_bfv_ciphertext_mark: Int = 0;
    if fhe_bfv_ciphertext_mark != 0 {
        process_exit(1);
    }
    let a: Int = bfv_compute_delta(0, 0);
    let b: Int = bfv_compute_delta(0, 0);
    if a != b {
        println("FAIL bfv_compute_delta");
        process_exit(1);
    }
    println("prod_fhe_bfv_ciphertext: PASSED");
}
