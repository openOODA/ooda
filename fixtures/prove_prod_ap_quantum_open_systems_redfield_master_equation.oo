// # Product prove std/quantum_open_systems/redfield_master_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/redfield_master_equation.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/redfield_master_equation.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_redfield_master_equation: PASSED only if they match.

import "std/quantum_open_systems/redfield_master_equation.oo";

pub fn main() {
    let redfield_master_equation_a = redfield_rates_new(0.0, 0.0, 0.0, 0.0);
    let redfield_master_equation_b = redfield_rates_new(0.0, 0.0, 0.0, 0.0);
    if redfield_master_equation_a.rate_0_to_1 != redfield_master_equation_b.rate_0_to_1 {
        println("FAIL redfield_master_equation");
        process_exit(1);
    }
    println("prod_ap_redfield_master_equation: PASSED");
}
