// # User sum String payload emit lock
//
// Logline: Fail-closed emit+gcc+run of Text(String) | Empty match.
//
// Setup: Backend-C. String payload is not an Int.
//
// Beats:
//   1. Text("hi") match binds "hi".
//   2. Empty match is not the Text arm.
//   3. Exit 1 before PASSED on a miss.

type Msg = Text(String) | Empty;

pub fn main() {
    let s: Msg = Text("hi");
    let v: String = match s {
        Text(t) => t,
        Empty => "MISS"
    };
    if v != "hi" {
        println("FAIL text");
        process_exit(1);
    }
    let s2: Msg = Empty;
    let v2: String = match s2 {
        Text(t) => t,
        Empty => "ok"
    };
    if v2 != "ok" {
        println("FAIL empty");
        process_exit(1);
    }
    println("sum_string_smoke: PASSED");
}
