// # Product prove std/deep_ai/function_calling_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts function_calling_engine_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/function_calling_engine.oo.
//
// Beats:
//   1. Call function_calling_engine_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_function_calling_engine: PASSED only if they match.

import "std/deep_ai/function_calling_engine.oo";

pub fn main() {
    let a: Int = function_calling_engine_marker();
    let b: Int = function_calling_engine_marker();
    if a != b {
        println("FAIL function_calling_engine_marker");
        process_exit(1);
    }
    println("prod_g2_function_calling_engine: PASSED");
}
