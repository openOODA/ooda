// # Product prove std/lidar_perception/extended_kalman_filter_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts ctra_state_new real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/extended_kalman_filter_3d.oo.
//
// Beats:
//   1. Call ctra_state_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_extended_kalman_filter_3d: PASSED only if the assert holds.

import "std/lidar_perception/extended_kalman_filter_3d.oo";

pub fn main() {
    let extended_kalman_filter_3d_mark: Int = 0;
    if extended_kalman_filter_3d_mark != 0 {
        process_exit(1);
    }
    let extended_kalman_filter_3d_a = ctra_state_new(2.0, 2.0, 2.0, 2.0);
    let extended_kalman_filter_3d_heading_rad: Float = (extended_kalman_filter_3d_a).heading_rad;
    if !(extended_kalman_filter_3d_heading_rad == 2.0) {
        println("FAIL ctra_state_new");
        process_exit(1);
    }
    println("prod_extended_kalman_filter_3d: PASSED");
}
