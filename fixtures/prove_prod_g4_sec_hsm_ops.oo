// # Product prove std/sec/crypto/hsm_ops.oo
//
// Logline: Fail-closed verification that HSM mechanism builders, key handles, and session models are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_ops.oo.
//
// Beats:
//   1. Call hsm_ops_probe and verify deterministic return.
//   2. Calculate checksums and construct PKCS#11 mechanisms.
//   3. Construct and validate KeyHandle and HsmSession instances.
//   4. Print prod_g4_sec_hsm_ops: PASSED and exit 0.

import "std/sec/crypto/hsm_ops.oo";

pub fn main() {
    let probe_a: Int = hsm_ops_probe();
    let probe_b: Int = hsm_ops_probe();
    if probe_a != probe_b || probe_a != 0 {
        println("FAIL hsm_ops_probe");
        process_exit(1);
    }

    let cs_a: Int = hsm_checksum("hsm_pkcs11_token_identifier");
    let cs_b: Int = hsm_checksum("hsm_pkcs11_token_identifier");
    if cs_a != cs_b {
        println("FAIL hsm_checksum");
        process_exit(1);
    }

    let mech_pss_a: P11Mechanism = hsm_mechanism_rsa_pss(32);
    let mech_pss_b: P11Mechanism = hsm_mechanism_rsa_pss(32);
    if (mech_pss_a).mechanism_type != (mech_pss_b).mechanism_type || (mech_pss_a).mechanism_type != 13 {
        println("FAIL hsm_mechanism_rsa_pss");
        process_exit(1);
    }
    if (mech_pss_a).parameter_len != 32 {
        println("FAIL mech parameter_len");
        process_exit(1);
    }

    let pss_ok: Bool = hsm_mechanism_validate(&mech_pss_a);
    if !pss_ok {
        println("FAIL hsm_mechanism_validate");
        process_exit(1);
    }

    let mech_ecdsa: P11Mechanism = hsm_mechanism_ecdsa();
    if (mech_ecdsa).mechanism_type != 4161 {
        println("FAIL hsm_mechanism_ecdsa");
        process_exit(1);
    }

    let kh_res: Result[KeyHandle, String] = hsm_key_handle_create(1, "master_aes_key", "AES", "SECRET", true, false, true);
    let is_kh_ok: Bool = kh_res.is_ok();
    if !is_kh_ok {
        println("FAIL hsm_key_handle_create");
        process_exit(1);
    }

    let sess_res: Result[HsmSession, String] = hsm_session_create(1001, 1, true, 100);
    let is_sess_ok: Bool = sess_res.is_ok();
    if !is_sess_ok {
        println("FAIL hsm_session_create");
        process_exit(1);
    }

    let attr: HsmAttribute = hsm_attribute_create(1, "CKA_CLASS", "CKO_SECRET_KEY", 0, false);
    if (attr).type_code != 1 {
        println("FAIL hsm_attribute_create");
        process_exit(1);
    }

    println("prod_g4_sec_hsm_ops: PASSED");
    process_exit(0);
}
