// # Product prove std/quantum_open_systems/quantum_homodyne_detection.oo
//
// Logline: Fail-closed emit+gcc+run asserts homodyne_detector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_homodyne_detection.oo.
//
// Beats:
//   1. Call homodyne_detector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_homodyne_detection: PASSED only if they match.

import "std/quantum_open_systems/quantum_homodyne_detection.oo";

pub fn main() {
    let quantum_homodyne_detection_mark: Int = 0;
    if quantum_homodyne_detection_mark != 0 {
        process_exit(1);
    }
    let a: HomodyneDetectorConfig = homodyne_detector_new(0.0, 0.0, 0.0);
    let b: HomodyneDetectorConfig = homodyne_detector_new(0.0, 0.0, 0.0);
    if (a).quantum_efficiency_eta != (b).quantum_efficiency_eta {
        println("FAIL homodyne_detector_new");
        process_exit(1);
    }
    println("prod_quantum_homodyne_detection: PASSED");
}
