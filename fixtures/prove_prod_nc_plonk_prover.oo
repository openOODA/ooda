// # Product prove std/sec/crypto/plonk_prover.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_prover_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk_prover.oo.
//
// Beats:
//   1. Call plonk_prover_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_plonk_prover: PASSED only if it matches.

import "std/sec/crypto/plonk_prover.oo";

pub fn main() {
    let a: Int = plonk_prover_probe();
    if a != 0 {
        println("FAIL plonk_prover_probe");
        process_exit(1);
    }
    println("prod_nc_plonk_prover: PASSED");
}
