// # Product prove std/satellite_dvb/satellite_beamforming_phased_array.oo
//
// Logline: Fail-closed emit+gcc+run asserts phased_array_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_beamforming_phased_array.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call phased_array_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_beamforming_phased_array: PASSED only if they match.

import "std/satellite_dvb/satellite_beamforming_phased_array.oo";

pub fn main() {
    let g2_a = phased_array_int_to_float(2);
    let g2_b = phased_array_int_to_float(2);
    if g2_a != g2_b {
        println("FAIL phased_array_int_to_float");
        process_exit(1);
    }
    println("prod_g2_satellite_beamforming_phased_array: PASSED");
}
