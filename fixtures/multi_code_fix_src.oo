// # Hit cap and type errors together
//
// Logline: One program raises both an undefined-name type error and a missing-cap read.
//
// Beats:
//   1. Add two unknown names so typecheck fails.
//   2. Call read_file without a filesystem cap.
//   3. Give the multi-code fixer two error classes.

// M162 multi-code fix target: E_CAP + E_TC (two classes)
pub fn main() {
    let x = no_such_a + no_such_b;
    println(x);
    let body = read_file("nope.txt");
    println(body);
}
