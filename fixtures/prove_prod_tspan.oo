// # Product diag tracer span prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/tracer_span.oo.
//
// Setup: Product std/diag/tracer_span.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New duration 0.
//   2. Finish 100..150 is 50. Negative clamped 0.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/tracer_span.oo";

pub fn main() {
    let s0: TraceSpan = trace_span_new("tr", "sp", "op", 100);
    let d0: Int = trace_span_duration(s0);
    if d0 != 0 {
        println("FAIL tspan 0");
        process_exit(1);
    }
    let s1: TraceSpan = trace_span_finish(s0, 150);
    let d1: Int = trace_span_duration(s1);
    if d1 != 50 {
        println("FAIL tspan 50");
        process_exit(1);
    }
    let s2: TraceSpan = trace_span_finish(s0, 80);
    let d2: Int = trace_span_duration(s2);
    if d2 != 0 {
        println("FAIL tspan clamp");
        process_exit(1);
    }
    println("prod_tspan: PASSED");
}
