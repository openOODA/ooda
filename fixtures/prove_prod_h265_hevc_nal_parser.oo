import "std/media_dsp/h265_hevc_nal_parser.oo";

pub fn main() {
    let h265_hevc_nal_parser_n: Int = h265_nal_trail_r();
    if h265_hevc_nal_parser_n != 1 {
        println("FAIL h265_nal_trail_r");
        process_exit(1);
    }
    println("prod_h265_hevc_nal_parser: PASSED");
}
