// # Product prove std/robotics_ros2/slam_scan_matching_icp.oo
//
// Logline: Fail-closed emit+gcc+run asserts icp_compute_step_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_scan_matching_icp.oo.
//
// Beats:
//   1. Call icp_compute_step_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_scan_matching_icp: PASSED only if they match.

import "std/robotics_ros2/slam_scan_matching_icp.oo";

pub fn main() {
    let slam_scan_matching_icp_mark: Int = 0;
    if slam_scan_matching_icp_mark != 0 {
        process_exit(1);
    }
    let slam_scan_matching_icp_a = icp_compute_step_pair(1.0, 1.0, 1.0, 1.0);
    let slam_scan_matching_icp_b = icp_compute_step_pair(1.0, 1.0, 1.0, 1.0);
    if (slam_scan_matching_icp_a).is_converged != (slam_scan_matching_icp_b).is_converged {
        println("FAIL icp_compute_step_pair");
        process_exit(1);
    }
    println("prod_slam_scan_matching_icp: PASSED");
}
