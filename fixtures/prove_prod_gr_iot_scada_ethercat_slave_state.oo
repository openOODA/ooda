// # Product prove std/iot_scada/ethercat_slave_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_state_init is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_slave_state.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ethercat_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ethercat_slave_state: PASSED only if they match.

import "std/iot_scada/ethercat_slave_state.oo";

pub fn main() {
    let g0_a = ethercat_state_init();
    let g0_b = ethercat_state_init();
    if g0_a != g0_b {
        println("FAIL ethercat_state_init");
        process_exit(1);
    }
    println("prod_gr_ethercat_slave_state: PASSED");
}
