// # Multi-digit INT order if print
//
// Logline: Print GE from else of if 10<2, GT from if 10>2, and LT from if 2<10.
//
// Setup: Side emit-aarch64 compares INT digits numerically, not lexicographically.
//
// Beats:
//   1. if 10 < 2 else print GE.
//   2. if 10 > 2 print GT.
//   3. if 2 < 10 print LT.

pub fn main() {
    if 10 < 2 {
        println("BAD");
    } else {
        println("GE");
    }
    if 10 > 2 {
        println("GT");
    } else {
        println("BAD2");
    }
    if 2 < 10 {
        println("LT");
    } else {
        println("BAD3");
    }
}
