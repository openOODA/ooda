// # Product prove std/fintech_l3_book/exchange_trading_state_machine.oo
//
// Logline: Fail-closed emit+gcc+run asserts market_session_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/exchange_trading_state_machine.oo.
//
// Beats:
//   1. Call market_session_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_exchange_trading_state_machine: PASSED only if they match.

import "std/fintech_l3_book/exchange_trading_state_machine.oo";

pub fn main() {
    let exchange_trading_state_machine_mark: Int = 0;
    if exchange_trading_state_machine_mark != 0 {
        process_exit(1);
    }
    let a: MarketSessionState = market_session_state_new("x");
    let b: MarketSessionState = market_session_state_new("x");
    if (a).last_phase_transition_ts_ns != (b).last_phase_transition_ts_ns {
        println("FAIL market_session_state_new");
        process_exit(1);
    }
    println("prod_exchange_trading_state_machine: PASSED");
}
