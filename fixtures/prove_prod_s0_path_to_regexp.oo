// # Product prove std/web_ecosystem/path_to_regexp.oo
//
// Logline: Fail-closed emit+gcc+run asserts route_static_match value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/path_to_regexp.oo.
//
// Beats:
//   1. Call route_static_match twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_path_to_regexp: PASSED only if asserts hold.

import "std/web_ecosystem/path_to_regexp.oo";

pub fn main() {
    let path_to_regexp_a: Int = route_static_match(0, 0);
    let path_to_regexp_b: Int = route_static_match(0, 0);
    if path_to_regexp_a != path_to_regexp_b {
        println("FAIL route_static_match");
        process_exit(1);
    }
    println("prod_path_to_regexp: PASSED");
}
