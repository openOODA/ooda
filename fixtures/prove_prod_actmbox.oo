// # Product sync actor mailbox prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/actor_mailbox.oo.
//
// Setup: Product std/sync/actor_mailbox.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New len 0 empty. Cap 0 clamps internally to 1.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/actor_mailbox.oo";

pub fn main() {
    let mb: ActorMailbox = actor_mailbox_new(4);
    let n: Int = actor_mailbox_len(mb);
    if n != 0 {
        println("FAIL actmbox 0");
        process_exit(1);
    }
    if actor_mailbox_is_empty(mb) == false {
        println("FAIL actmbox empty");
        process_exit(1);
    }
    println("prod_actmbox: PASSED");
}
