// # Product prove std/nerf_3dgs/gaussian_opacity_reset_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts should_reset_opacity is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_opacity_reset_decay.oo.
//
// Beats:
//   1. Call should_reset_opacity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gaussian_opacity_reset_decay: PASSED only if they match.

import "std/nerf_3dgs/gaussian_opacity_reset_decay.oo";

pub fn main() {
    let gaussian_opacity_reset_decay_mark: Int = 0;
    if gaussian_opacity_reset_decay_mark != 0 {
        process_exit(1);
    }
    let a: Int = should_reset_opacity(0, 0);
    let b: Int = should_reset_opacity(0, 0);
    if a != b {
        println("FAIL should_reset_opacity");
        process_exit(1);
    }
    println("prod_gaussian_opacity_reset_decay: PASSED");
}
