// # Product prove std/crypto/crypto.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/crypto.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/crypto.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crypto: PASSED only if they match.

import "std/crypto/crypto.oo";

pub fn main() {
    let crypto_a = sha256("x");
    let crypto_b = sha256("x");
    if crypto_a.contains(crypto_b) == false {
        println("FAIL crypto");
        process_exit(1);
    }
    if crypto_b.contains(crypto_a) == false {
        println("FAIL crypto");
        process_exit(1);
    }
    println("prod_ap_crypto: PASSED");
}
