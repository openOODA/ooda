// # Product prove std/bio_advanced/variant_indel_aligner.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/variant_indel_aligner.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/variant_indel_aligner.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_variant_indel_aligner: PASSED only if they match.

import "std/bio_advanced/variant_indel_aligner.oo";

pub fn main() {
    let variant_indel_aligner_a = indel_char_at("x", 0);
    let variant_indel_aligner_b = indel_char_at("x", 0);
    if variant_indel_aligner_a.contains(variant_indel_aligner_b) == false {
        println("FAIL variant_indel_aligner");
        process_exit(1);
    }
    if variant_indel_aligner_b.contains(variant_indel_aligner_a) == false {
        println("FAIL variant_indel_aligner");
        process_exit(1);
    }
    println("prod_ap_variant_indel_aligner: PASSED");
}
