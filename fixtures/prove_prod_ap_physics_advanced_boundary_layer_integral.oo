import "std/physics_advanced/boundary_layer_integral.oo";

pub fn main() {
    let boundary_layer_integral_a = turbulent_flat_plate_theta(0.0, 0.0);
    let boundary_layer_integral_b = turbulent_flat_plate_theta(0.0, 0.0);
    if boundary_layer_integral_a != boundary_layer_integral_b {
        println("FAIL boundary_layer_integral");
        process_exit(1);
    }
    println("prod_ap_boundary_layer_integral: PASSED");
}
