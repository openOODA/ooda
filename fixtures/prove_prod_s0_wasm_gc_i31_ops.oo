// # Product prove std/wasm_gc/wasm_gc_i31_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts i31_max_signed value or determinism.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_i31_ops.oo.
//
// Beats:
//   1. Call i31_max_signed twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_wasm_gc_i31_ops: PASSED only if asserts hold.

import "std/wasm_gc/wasm_gc_i31_ops.oo";

pub fn main() {
    let wasm_gc_i31_ops_a: Int = i31_max_signed();
    let wasm_gc_i31_ops_b: Int = i31_max_signed();
    if wasm_gc_i31_ops_a != wasm_gc_i31_ops_b {
        println("FAIL i31_max_signed");
        process_exit(1);
    }
    println("prod_wasm_gc_i31_ops: PASSED");
}
