// # Product prove std/protein_folding/md_pme_electrostatics_mesh.oo
//
// Logline: Fail-closed emit+gcc+run asserts pme_calc_self_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_pme_electrostatics_mesh.oo.
//
// Beats:
//   1. Call pme_calc_self_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_pme_electrostatics_mesh: PASSED only if they match.

import "std/protein_folding/md_pme_electrostatics_mesh.oo";

pub fn main() {
    let md_pme_electrostatics_mesh_mark: Int = 0;
    if md_pme_electrostatics_mesh_mark != 0 {
        process_exit(1);
    }
    let a: Float = pme_calc_self_energy(0.0, 0.0);
    let b: Float = pme_calc_self_energy(0.0, 0.0);
    if a != b {
        println("FAIL pme_calc_self_energy");
        process_exit(1);
    }
    println("prod_md_pme_electrostatics_mesh: PASSED");
}
