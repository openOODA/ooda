// # Product prove std/compilers_polyhedral/polyhedral_ast_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts poly_ast_node_for is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_ast_generator.oo.
//
// Beats:
//   1. Call poly_ast_node_for twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_ast_generator: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_ast_generator.oo";

pub fn main() {
    let polyhedral_ast_generator_mark: Int = 0;
    if polyhedral_ast_generator_mark != 0 {
        process_exit(1);
    }
    let a: PolyAstNode = poly_ast_node_for(0, "x", 0, 0, 0);
    let b: PolyAstNode = poly_ast_node_for(0, "x", 0, 0, 0);
    if (a).node_id != (b).node_id {
        println("FAIL poly_ast_node_for");
        process_exit(1);
    }
    println("prod_g2_polyhedral_ast_generator: PASSED");
}
