// # Product prove std/telecom_6g/isac_constant_modulus_waveform.oo
//
// Logline: Fail-closed emit+gcc+run asserts cm_calc_papr_db is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_constant_modulus_waveform.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cm_calc_papr_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isac_constant_modulus_waveform: PASSED only if they match.

import "std/telecom_6g/isac_constant_modulus_waveform.oo";

pub fn main() {
    let g2_a = cm_calc_papr_db(1.0, 1.0);
    let g2_b = cm_calc_papr_db(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL cm_calc_papr_db");
        process_exit(1);
    }
    println("prod_g2_isac_constant_modulus_waveform: PASSED");
}
