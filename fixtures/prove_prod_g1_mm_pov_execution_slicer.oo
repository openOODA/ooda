// # Product prove std/hft_alpha/mm_pov_execution_slicer.oo
//
// Logline: Fail-closed emit+gcc+run asserts pov_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_pov_execution_slicer.oo.
//
// Beats:
//   1. Call pov_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_pov_execution_slicer: PASSED only if they match.

import "std/hft_alpha/mm_pov_execution_slicer.oo";

pub fn main() {
    let a: PovParams = pov_params_new(0.0, 0.0, 0.0, 0.0);
    let b: PovParams = pov_params_new(0.0, 0.0, 0.0, 0.0);
    if a.target_participation_rate != b.target_participation_rate {
        println("FAIL pov_params_new");
        process_exit(1);
    }
    println("prod_mm_pov_execution_slicer: PASSED");
}
