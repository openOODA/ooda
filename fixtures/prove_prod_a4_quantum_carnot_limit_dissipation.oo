// # Product prove std/quantum_open_systems/quantum_carnot_limit_dissipation.oo
//
// Logline: Fail-closed emit+gcc+run asserts carnot_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_carnot_limit_dissipation.oo.
//
// Beats:
//   1. Call carnot_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_carnot_limit_dissipation: PASSED only if they match.

import "std/quantum_open_systems/quantum_carnot_limit_dissipation.oo";

pub fn main() {
    let quantum_carnot_limit_dissipation_mark: Int = 0;
    if quantum_carnot_limit_dissipation_mark != 0 {
        process_exit(1);
    }
    let a: CarnotBenchmarkParams = carnot_params_new(0.0, 0.0, 0.0);
    let b: CarnotBenchmarkParams = carnot_params_new(0.0, 0.0, 0.0);
    if (a).temp_cold_k != (b).temp_cold_k {
        println("FAIL carnot_params_new");
        process_exit(1);
    }
    println("prod_quantum_carnot_limit_dissipation: PASSED");
}
