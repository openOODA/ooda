// # While under cycle budget
//
// Logline: Loop while i < 3 under an eight-cycle while-fuel marker.
//
// Beats:
//   1. Keep the eight-cycle marker the Backend-C rail injects.
//   2. While-increment i to 3.
//   3. Print 3.

// M48 MaxCycles marker fixture — path A while fuel (see bootstrap/MAX_CYCLES.oot)
// MAX_CYCLES: 8
// Product: // MAX_CYCLES: N fuels Backend-C while via inject rail.
// Residual: not OS cgroup / rlimit; for-loops not fueled; #[MaxCycles] name only.
pub fn main() {
    let mut i = 0;
    while i < 3 {
        i = i + 1;
    }
    println(i);
}
