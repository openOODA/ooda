// # Product prove std/fin/credit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts credit_score_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_types.oo.
//
// Beats:
//   1. Call credit_score_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_credit_types: PASSED only if they match.

import "std/fin/credit_types.oo";

pub fn main() {
    let credit_types_mark: Int = 0;
    if credit_types_mark != 0 {
        process_exit(1);
    }
    let a: CreditScore = credit_score_new(0, 0, 0);
    let b: CreditScore = credit_score_new(0, 0, 0);
    if (a).score != (b).score {
        println("FAIL credit_score_new");
        process_exit(1);
    }
    println("prod_credit_types: PASSED");
}
