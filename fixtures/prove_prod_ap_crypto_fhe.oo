// # Product prove std/crypto/fhe.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/fhe.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fhe: PASSED only if they match.

import "std/crypto/fhe.oo";

pub fn main() {
    let fhe_a = shim_marker_checksum();
    let fhe_b = shim_marker_checksum();
    if fhe_a != fhe_b {
        println("FAIL fhe");
        process_exit(1);
    }
    println("prod_ap_fhe: PASSED");
}
