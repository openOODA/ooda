// # Product prove std/scicomp/quadratic_programming_qp.oo
//
// Logline: Fail-closed emit+gcc+run asserts quadratic_programming_qp_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/quadratic_programming_qp.oo.
//
// Beats:
//   1. Call quadratic_programming_qp_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_quadratic_programming_qp: PASSED only if it matches.

import "std/scicomp/quadratic_programming_qp.oo";

pub fn main() {
    let a: Int = quadratic_programming_qp_probe();
    if a != 0 {
        println("FAIL quadratic_programming_qp_probe");
        process_exit(1);
    }
    println("prod_nc_quadratic_programming_qp: PASSED");
}
