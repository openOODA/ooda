// # Product prove std/os/process.oo
//
// Logline: Fail-closed emit+gcc+run asserts process_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/os/process.oo.
//
// Beats:
//   1. Call process_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_process: PASSED only if it matches.

import "std/os/process.oo";

pub fn main() {
    let a: Int = process_probe();
    if a != 0 {
        println("FAIL process_probe");
        process_exit(1);
    }
    println("prod_nc_process: PASSED");
}
