// # Product prove std/industrial_predictive/ts_thermal_transient_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_thermal_transient_model.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_thermal_transient_model: PASSED only if they match.

import "std/industrial_predictive/ts_thermal_transient_model.oo";

pub fn main() {
    let ts_thermal_transient_model_mark: Int = 0;
    if ts_thermal_transient_model_mark != 0 {
        process_exit(1);
    }
    let ts_thermal_transient_model_a: Float = int_to_float(1);
    let ts_thermal_transient_model_b: Float = int_to_float(1);
    if ts_thermal_transient_model_a != ts_thermal_transient_model_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_ts_thermal_transient_model: PASSED");
}
