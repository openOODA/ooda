// # Product prove std/compilers/compiler_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/compiler_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers/compiler_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_compiler_stubs: PASSED only if they match.

import "std/compilers/compiler_stubs.oo";

pub fn main() {
    let compiler_stubs_a = compiler_target_host();
    let compiler_stubs_b = compiler_target_host();
    if compiler_stubs_a.arch != compiler_stubs_b.arch {
        println("FAIL compiler_stubs");
        process_exit(1);
    }
    println("prod_ap_compiler_stubs: PASSED");
}
