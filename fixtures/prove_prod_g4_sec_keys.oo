// # Product prove std/crypto/keys.oo
//
// Logline: Fail-closed verification that cryptographic keys facade functions are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys.oo.
//
// Beats:
//   1. Call key checksum and hex encoding shim markers.
//   2. Initialize keystore and compute keystore work metric.
//   3. Assert all operations return consistent, deterministic results.
//   4. Print prod_g4_sec_keys: PASSED and exit 0.

import "std/crypto/keys.oo";

pub fn main() {
    let cs1: Int = shim_marker_checksum();
    let cs2: Int = shim_marker_checksum();

    if cs1 != cs2 {
        println("FAIL shim_marker_checksum mismatch");
        process_exit(1);
    }

    let ty_str1: String = shim_marker_type_to_string();
    let ty_str2: String = shim_marker_type_to_string();

    if chars_len(ty_str1) != chars_len(ty_str2) || chars_len(ty_str1) == 0 {
        println("FAIL shim_marker_type_to_string");
        process_exit(1);
    }

    let hex1: String = shim_marker_bytes_to_hex();
    let hex2: String = shim_marker_bytes_to_hex();

    if chars_len(hex1) != chars_len(hex2) || chars_len(hex1) == 0 {
        println("FAIL shim_marker_bytes_to_hex");
        process_exit(1);
    }

    let ks: KeyStore = shim_marker_keystore_init();
    let w1: Int = shim_marker_keystore_do_work(&ks);
    let w2: Int = shim_marker_keystore_do_work(&ks);

    if w1 != w2 {
        println("FAIL shim_marker_keystore_do_work");
        process_exit(1);
    }

    let dummy: Int = __keys_dummy();
    if dummy != 0 {
        println("FAIL __keys_dummy");
        process_exit(1);
    }

    println("prod_g4_sec_keys: PASSED");
    process_exit(0);
}
