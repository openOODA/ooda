// # Product prove std/sync/rcu_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts rcu_list_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/rcu_list.oo.
//
// Beats:
//   1. Call rcu_list_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rcu_list: PASSED only if they match.

import "std/sync/rcu_list.oo";

pub fn main() {
    let obj = rcu_list_new();
    let a = rcu_list_len(obj);
    let b = rcu_list_len(obj);
    if a != b {
        println("FAIL rcu_list_len");
        process_exit(1);
    }
    println("prod_rcu_list: PASSED");
}
