// # Product prove std/zk_rollup/logup_lookup_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/logup_lookup_argument.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/logup_lookup_argument.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_logup_lookup_argument: PASSED only if they match.

import "std/zk_rollup/logup_lookup_argument.oo";

pub fn main() {
    let logup_lookup_argument_a = logup_fraction_new(0, 0);
    let logup_lookup_argument_b = logup_fraction_new(0, 0);
    if logup_lookup_argument_a.numerator != logup_lookup_argument_b.numerator {
        println("FAIL logup_lookup_argument");
        process_exit(1);
    }
    println("prod_ap_logup_lookup_argument: PASSED");
}
