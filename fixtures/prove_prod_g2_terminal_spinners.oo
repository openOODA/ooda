// # Product prove std/web_ecosystem/terminal_spinners.oo
//
// Logline: Fail-closed emit+gcc+run asserts spinner_dots_n is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/terminal_spinners.oo.
//
// Beats:
//   1. Call spinner_dots_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_terminal_spinners: PASSED only if they match.

import "std/web_ecosystem/terminal_spinners.oo";

pub fn main() {
    let terminal_spinners_mark: Int = 0;
    if terminal_spinners_mark != 0 {
        process_exit(1);
    }
    let a: Int = spinner_dots_n();
    let b: Int = spinner_dots_n();
    if a != b {
        println("FAIL spinner_dots_n");
        process_exit(1);
    }
    println("prod_g2_terminal_spinners: PASSED");
}
