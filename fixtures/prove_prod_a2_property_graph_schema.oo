// # Product prove std/db_graph/property_graph_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts property_constraint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_schema.oo.
//
// Beats:
//   1. Call property_constraint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_schema: PASSED only if they match.

import "std/db_graph/property_graph_schema.oo";

pub fn main() {
    let property_graph_schema_mark: Int = 0;
    if property_graph_schema_mark != 0 {
        process_exit(1);
    }
    let a: PropertyConstraint = property_constraint_new("x", 0, true, true);
    let b: PropertyConstraint = property_constraint_new("x", 0, true, true);
    if (a).expected_type != (b).expected_type {
        println("FAIL property_constraint_new");
        process_exit(1);
    }
    println("prod_property_graph_schema: PASSED");
}
