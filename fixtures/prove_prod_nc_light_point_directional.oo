// # Product prove std/pbr_raytracing/light_point_directional.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_point_directional_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/light_point_directional.oo.
//
// Beats:
//   1. Call light_point_directional_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_light_point_directional: PASSED only if it matches.

import "std/pbr_raytracing/light_point_directional.oo";

pub fn main() {
    let a: Int = light_point_directional_probe();
    if a != 0 {
        println("FAIL light_point_directional_probe");
        process_exit(1);
    }
    println("prod_nc_light_point_directional: PASSED");
}
