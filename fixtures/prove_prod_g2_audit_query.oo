// # Product prove std/enterprise/audit_query.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_query_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_query.oo.
//
// Beats:
//   1. Call audit_query_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_audit_query: PASSED only if they match.

import "std/enterprise/audit_query.oo";

pub fn main() {
    let a: Int = audit_query_probe();
    let b: Int = audit_query_probe();
    if a != b {
        println("FAIL audit_query_probe");
        process_exit(1);
    }
    println("prod_g2_audit_query: PASSED");
}
