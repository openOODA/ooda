// # Product prove std/mesh_ebpf/mesh_rbac_authorization.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_rbac_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_rbac_authorization.oo.
//
// Beats:
//   1. Call mesh_rbac_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_rbac_authorization: PASSED only if they match.

import "std/mesh_ebpf/mesh_rbac_authorization.oo";

pub fn main() {
    let mesh_rbac_authorization_mark: Int = 0;
    if mesh_rbac_authorization_mark != 0 {
        process_exit(1);
    }
    let mesh_rbac_authorization_a: MeshRbacEngine = mesh_rbac_engine_new();
    let mesh_rbac_authorization_b: MeshRbacEngine = mesh_rbac_engine_new();
    if (mesh_rbac_authorization_a).total_evaluated != (mesh_rbac_authorization_b).total_evaluated {
        println("FAIL mesh_rbac_engine_new");
        process_exit(1);
    }
    println("prod_mesh_rbac_authorization: PASSED");
}
