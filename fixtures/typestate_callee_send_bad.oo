// # Send inside connect
//
// Logline: Call send from connect while the parameter is still Closed.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Enter connect from Closed.
//   3. Call send on that Closed parameter.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn send(s: Int) { let x = s; }

fn connect(s: Int) {
    send(s);
}

pub fn main() {
    let s = open_sock();
    connect(s);
}
