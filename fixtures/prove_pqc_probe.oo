// # PQC probe: ML-KEM keygen emit+run
//
// Logline: Drive shipped ml_kem_keygen and print the security level so a named prove can fail closed.
//
// Setup: Isolated emit-c. Imports fips203_ml_kem types and encapsulate. Run from ooda/.
//
// Beats:
//   1. Build 64-byte d and 32-byte z seeds.
//   2. Call ml_kem_keygen(2, d, z).
//   3. Print the keypair security level.

import "std/pqc_nist/fips203_ml_kem_types.oo";
import "std/pqc_nist/fips203_ml_kem_encapsulate.oo";

pub fn main() {
    let mut seed_d: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        seed_d = list_push(seed_d, i + 1);
        i = i + 1;
    }
    let mut seed_z: List[Int] = list_new();
    i = 0;
    while i < 32 {
        seed_z = list_push(seed_z, i + 100);
        i = i + 1;
    }
    let kp: MlKemKeyPair = ml_kem_keygen(2, seed_d, seed_z);
    let security_level: Int = (kp).security_level;
    if security_level == 1 {
        println("PASS: ml_kem_keygen returned MlKemKeyPair with security_level=1");
    } else {
        println("FAIL: security_level should be 1 for k=2, got other");
        process_exit(1);
    }
}
