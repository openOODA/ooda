// # Product prove std/robot/motors_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/motors_ops.oo.
//
// Beats:
//   1. Call math_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_motors_ops: PASSED only if they match.

import "std/robot/motors_ops.oo";

pub fn main() {
    let motors_ops_mark: Int = 0;
    if motors_ops_mark != 0 {
        process_exit(1);
    }
    let a: Float = math_pi();
    let b: Float = math_pi();
    if a != b {
        println("FAIL math_pi");
        process_exit(1);
    }
    println("prod_g2_motors_ops: PASSED");
}
