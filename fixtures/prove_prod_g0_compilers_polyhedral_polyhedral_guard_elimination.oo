// # Product prove std/compilers_polyhedral/polyhedral_guard_elimination.oo
//
// Logline: Fail-closed emit+gcc+run asserts guard_is_always_true is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_guard_elimination.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call guard_is_always_true twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_polyhedral_guard_elimination: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_guard_elimination.oo";

pub fn main() {
    let g0_oa: ConditionalGuard = ConditionalGuard { guard_id: 2, loop_level: 2, coeff: 2, threshold: 2, is_greater_or_equal: true, is_redundant: true };
    let g0_ob: ConditionalGuard = ConditionalGuard { guard_id: 2, loop_level: 2, coeff: 2, threshold: 2, is_greater_or_equal: true, is_redundant: true };
    let g0_a = guard_is_always_true(g0_oa, 2, 2);
    let g0_b = guard_is_always_true(g0_ob, 2, 2);
    if g0_a != g0_b {
        println("FAIL guard_is_always_true");
        process_exit(1);
    }
    println("prod_g0_polyhedral_guard_elimination: PASSED");
}
