// # Product prove std/sec/crypto/falcon.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_degree is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon.oo.
//
// Beats:
//   1. Call shim_marker_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon: PASSED only if they match.

import "std/sec/crypto/falcon.oo";

pub fn main() {
    let falcon_mark: Int = 0;
    if falcon_mark != 0 {
        process_exit(1);
    }
    let falcon_a: Int = shim_marker_degree();
    let falcon_b: Int = shim_marker_degree();
    if falcon_a != falcon_b {
        println("FAIL shim_marker_degree");
        process_exit(1);
    }
    println("prod_falcon: PASSED");
}
