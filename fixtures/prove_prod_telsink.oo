// # Product diag telemetry sink prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/telemetry_sink.oo.
//
// Setup: Product std/diag/telemetry_sink.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New len 0.
//   2. Push then len 1. Capacity 1 drops extra.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/telemetry_sink.oo";

pub fn main() {
    let s0: TelemetrySink = telemetry_sink_new(1);
    let n0: Int = telemetry_sink_len(s0);
    if n0 != 0 {
        println("FAIL telsink 0");
        process_exit(1);
    }
    let s1: TelemetrySink = telemetry_sink_push(s0, "e1");
    let n1: Int = telemetry_sink_len(s1);
    if n1 != 1 {
        println("FAIL telsink 1");
        process_exit(1);
    }
    let s2: TelemetrySink = telemetry_sink_push(s1, "e2");
    let n2: Int = telemetry_sink_len(s2);
    if n2 != 1 {
        println("FAIL telsink cap");
        process_exit(1);
    }
    println("prod_telsink: PASSED");
}
