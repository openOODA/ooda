// # Product prove std/zk_rollup/rollup_escape_hatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts escape_hatch_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_escape_hatch.oo.
//
// Beats:
//   1. Call escape_hatch_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_escape_hatch: PASSED only if they match.

import "std/zk_rollup/rollup_escape_hatch.oo";

pub fn main() {
    let rollup_escape_hatch_mark: Int = 0;
    if rollup_escape_hatch_mark != 0 {
        process_exit(1);
    }
    let a: EscapeHatchState = escape_hatch_init(0);
    let b: EscapeHatchState = escape_hatch_init(0);
    if (a).is_active != (b).is_active {
        println("FAIL escape_hatch_init");
        process_exit(1);
    }
    println("prod_rollup_escape_hatch: PASSED");
}
