// # Product prove std/math/integration_quad.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/math/integration_quad.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/math/integration_quad.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_integration_quad: PASSED only if they match.

import "std/math/integration_quad.oo";

pub fn main() {
    let integration_quad_a = quad_gauss_legendre_2pt(0.0, 0.0, 0.0, 0.0);
    let integration_quad_b = quad_gauss_legendre_2pt(0.0, 0.0, 0.0, 0.0);
    if integration_quad_a != integration_quad_b {
        println("FAIL integration_quad");
        process_exit(1);
    }
    println("prod_ap_integration_quad: PASSED");
}
