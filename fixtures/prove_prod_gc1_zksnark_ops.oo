// # Product prove std/sec/crypto/zksnark_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts proving_key_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_ops.oo.
//
// Beats:
//   1. Call proving_key_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zksnark_ops: PASSED only if they match.

import "std/sec/crypto/zksnark_ops.oo";

pub fn main() {
    let zksnark_ops_mark: Int = 0;
    if zksnark_ops_mark != 0 {
        process_exit(1);
    }
    let zksnark_ops_a = proving_key_create("x", "x", "x", 1, 1, "x", "x", "x");
    let zksnark_ops_b = proving_key_create("x", "x", "x", 1, 1, "x", "x", "x");
    if (zksnark_ops_a).constraint_count != (zksnark_ops_b).constraint_count {
        println("FAIL proving_key_create");
        process_exit(1);
    }
    println("prod_zksnark_ops: PASSED");
}
