// # Product prove std/db_storage/sql_optimizer_cost_based.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/sql_optimizer_cost_based.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_optimizer_cost_based.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sql_optimizer_cost_based: PASSED only if they match.

import "std/db_storage/sql_optimizer_cost_based.oo";

pub fn main() {
    let sql_optimizer_cost_based_a = estimate_equality_selectivity(0);
    let sql_optimizer_cost_based_b = estimate_equality_selectivity(0);
    if sql_optimizer_cost_based_a != sql_optimizer_cost_based_b {
        println("FAIL sql_optimizer_cost_based");
        process_exit(1);
    }
    println("prod_ap_sql_optimizer_cost_based: PASSED");
}
