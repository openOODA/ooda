// # Product prove std/astro_advanced/astro_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts astro_adv_c is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/astro_constants.oo.
//
// Beats:
//   1. Call astro_adv_c twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_astro_constants: PASSED only if they match.

import "std/astro_advanced/astro_constants.oo";

pub fn main() {
    let a = astro_adv_c();
    let b = astro_adv_c();
    if a != b {
        println("FAIL astro_adv_c");
        process_exit(1);
    }
    println("prod_astro_constants: PASSED");
}
