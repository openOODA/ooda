// # Product prove std/graph_networks/can_dht_coordinate.oo
//
// Logline: Fail-closed emit+gcc+run asserts can_dht_coordinate_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_networks/can_dht_coordinate.oo.
//
// Beats:
//   1. Call can_dht_coordinate_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_can_dht_coordinate: PASSED only if it matches.

import "std/graph_networks/can_dht_coordinate.oo";

pub fn main() {
    let a: Int = can_dht_coordinate_probe();
    if a != 0 {
        println("FAIL can_dht_coordinate_probe");
        process_exit(1);
    }
    println("prod_nc_can_dht_coordinate: PASSED");
}
