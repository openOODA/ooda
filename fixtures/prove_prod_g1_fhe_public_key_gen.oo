// # Product prove std/fhe_lattices/fhe_public_key_gen.oo
//
// Logline: Fail-closed emit+gcc+run asserts public_key_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_public_key_gen.oo.
//
// Beats:
//   1. Call public_key_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_public_key_gen: PASSED only if they match.

import "std/fhe_lattices/fhe_public_key_gen.oo";

pub fn main() {
    let a: PublicKey = public_key_new(list_new(), list_new(), 0, 0);
    let b: PublicKey = public_key_new(list_new(), list_new(), 0, 0);
    if a.degree_n != b.degree_n {
        println("FAIL public_key_new");
        process_exit(1);
    }
    println("prod_fhe_public_key_gen: PASSED");
}
