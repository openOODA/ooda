// # Product prove std/sec/attestation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/attestation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/attestation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attestation: PASSED only if they match.

import "std/sec/attestation.oo";

pub fn main() {
    let attestation_a = shim_marker_measurement_verify();
    let attestation_b = shim_marker_measurement_verify();
    if attestation_a != attestation_b {
        println("FAIL attestation");
        process_exit(1);
    }
    println("prod_ap_attestation: PASSED");
}
