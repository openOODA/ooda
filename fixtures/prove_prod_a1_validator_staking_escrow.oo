// # Product prove std/bft_consensus/validator_staking_escrow.oo
//
// Logline: Fail-closed emit+gcc+run asserts staking_escrow_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/validator_staking_escrow.oo.
//
// Beats:
//   1. Call staking_escrow_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_validator_staking_escrow: PASSED only if they match.

import "std/bft_consensus/validator_staking_escrow.oo";

pub fn main() {
    let validator_staking_escrow_mark: Int = 0;
    if validator_staking_escrow_mark != 0 {
        process_exit(1);
    }
    let a: StakingEscrow = staking_escrow_new();
    let b: StakingEscrow = staking_escrow_new();
    if (a).total_bonded != (b).total_bonded {
        println("FAIL staking_escrow_new");
        process_exit(1);
    }
    println("prod_validator_staking_escrow: PASSED");
}
