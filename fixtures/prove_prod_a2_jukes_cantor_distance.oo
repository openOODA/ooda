// # Product prove std/bioinformatics/jukes_cantor_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts jukes_cantor_distance_x1000 is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/jukes_cantor_distance.oo.
//
// Beats:
//   1. Call jukes_cantor_distance_x1000 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jukes_cantor_distance: PASSED only if they match.

import "std/bioinformatics/jukes_cantor_distance.oo";

pub fn main() {
    let a: Int = jukes_cantor_distance_x1000(0);
    let b: Int = jukes_cantor_distance_x1000(0);
    if a != b {
        println("FAIL jukes_cantor_distance_x1000");
        process_exit(1);
    }
    println("prod_jukes_cantor_distance: PASSED");
}
