// # Product prove std/security_defense/string_literal_encryptor.oo
//
// Logline: Fail-closed emit+gcc+run asserts string_payload_verify is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/string_literal_encryptor.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call string_payload_verify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_string_literal_encryptor: PASSED only if they match.

import "std/security_defense/string_literal_encryptor.oo";

pub fn main() {
    let g0_oa: EncryptedStringPayload = EncryptedStringPayload { ciphertext: list_new(), length: 0, xor_key: 0, checksum: 0 };
    let g0_ob: EncryptedStringPayload = EncryptedStringPayload { ciphertext: list_new(), length: 0, xor_key: 0, checksum: 0 };
    let g0_a = string_payload_verify(&g0_oa);
    let g0_b = string_payload_verify(&g0_ob);
    if g0_a != g0_b {
        println("FAIL string_payload_verify");
        process_exit(1);
    }
    println("prod_gr_string_literal_encryptor: PASSED");
}
