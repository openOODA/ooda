// # Product prove std/media_dsp/synth_moog_ladder_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts synth_tanh_approx real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_moog_ladder_filter.oo.
//
// Beats:
//   1. Call synth_tanh_approx with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_moog_ladder_filter: PASSED only if the assert holds.

import "std/media_dsp/synth_moog_ladder_filter.oo";

pub fn main() {
    let synth_moog_ladder_filter_n: Float = synth_tanh_approx(3.0);
    if !(synth_moog_ladder_filter_n == 1.0) {
        println("FAIL synth_tanh_approx");
        process_exit(1);
    }
    println("prod_synth_moog_ladder_filter: PASSED");
}
