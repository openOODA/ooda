// # Product prove std/pbr_raytracing/volumetric_delta_tracking.oo
//
// Logline: Fail-closed emit+gcc+run asserts volumetric_delta_tracking_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/volumetric_delta_tracking.oo.
//
// Beats:
//   1. Call volumetric_delta_tracking_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_volumetric_delta_tracking: PASSED only if they match.

import "std/pbr_raytracing/volumetric_delta_tracking.oo";

pub fn main() {
    let a: Int = volumetric_delta_tracking_probe();
    let b: Int = volumetric_delta_tracking_probe();
    if a != b {
        println("FAIL volumetric_delta_tracking_probe");
        process_exit(1);
    }
    println("prod_g2_volumetric_delta_tracking: PASSED");
}
