// # Product prove std/hft_alpha/mm_trade_flow_intensity.oo
//
// Logline: Fail-closed emit+gcc+run asserts flow_window_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_trade_flow_intensity.oo.
//
// Beats:
//   1. Call flow_window_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_trade_flow_intensity: PASSED only if they match.

import "std/hft_alpha/mm_trade_flow_intensity.oo";

pub fn main() {
    let a: FlowArrivalWindow = flow_window_new(0.0);
    let b: FlowArrivalWindow = flow_window_new(0.0);
    if a.buy_order_count != b.buy_order_count {
        println("FAIL flow_window_new");
        process_exit(1);
    }
    println("prod_mm_trade_flow_intensity: PASSED");
}
