import "std/sec/crypto/rsa_pss_types.oo";

pub fn main() {
    let rsa_pss_types_a = rsa_pub_key_empty();
    let rsa_pss_types_b = rsa_pub_key_empty();
    if rsa_pss_types_a.is_valid != rsa_pss_types_b.is_valid {
        println("FAIL rsa_pss_types");
        process_exit(1);
    }
    println("prod_ap_rsa_pss_types: PASSED");
