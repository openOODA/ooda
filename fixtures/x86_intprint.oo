// # emit-x86 const integer print
//
// Logline: Print the integer 42 so emit-x86 can lower a const INT as decimal text.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. Print the const integer 42.
//   3. Leave arithmetic residual.
//
// residual: general arithmetic stays later.

pub fn main() {
    println(42);
}
