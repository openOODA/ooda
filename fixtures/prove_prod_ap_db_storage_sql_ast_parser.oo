// # Product prove std/db_storage/sql_ast_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/sql_ast_parser.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_ast_parser.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_sql_ast_parser: PASSED only if they match.

import "std/db_storage/sql_ast_parser.oo";

pub fn main() {
    let sql_ast_parser_a = sql_predicate_new("x", "x", "x");
    let sql_ast_parser_b = sql_predicate_new("x", "x", "x");
    if sql_ast_parser_a.column_name != sql_ast_parser_b.column_name {
        println("FAIL sql_ast_parser");
        process_exit(1);
    }
    println("prod_ap_sql_ast_parser: PASSED");
}
