// # Product prove std/telecom_5g/sync_matched_filter_rrc.oo
//
// Logline: Fail-closed emit+gcc+run asserts sync_rrc_tap_coeff is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_matched_filter_rrc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sync_rrc_tap_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sync_matched_filter_rrc: PASSED only if they match.

import "std/telecom_5g/sync_matched_filter_rrc.oo";

pub fn main() {
    let g2_a = sync_rrc_tap_coeff(1.0, 1.0);
    let g2_b = sync_rrc_tap_coeff(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL sync_rrc_tap_coeff");
        process_exit(1);
    }
    println("prod_g2_sync_matched_filter_rrc: PASSED");
}
