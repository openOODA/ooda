// # Product prove std/db_graph/graph_closeness_centrality.oo
//
// Logline: Fail-closed emit+gcc+run asserts closeness_score_new is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_closeness_centrality.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call closeness_score_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_closeness_centrality: PASSED only if they match.

import "std/db_graph/graph_closeness_centrality.oo";

pub fn main() {
    let g2_oa: ClosenessScore = closeness_score_new(2);
    let g2_ob: ClosenessScore = closeness_score_new(2);
    let g2_a = (g2_oa).node_id;
    let g2_b = (g2_ob).node_id;
    if g2_a != g2_b {
        println("FAIL closeness_score_new.node_id");
        process_exit(1);
    }
    println("prod_g2_graph_closeness_centrality: PASSED");
}
