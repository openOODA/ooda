// # Product prove std/database/wal_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts wal_record_checksum is a real value.
//
// Setup: Isolated emit-c. Imports std/database/wal_writer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wal_record_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_wal_writer: PASSED only if they match.

import "std/database/wal_writer.oo";

pub fn main() {
    let g0_a = wal_record_checksum(0, 0, 0, "x", "x");
    let g0_b = wal_record_checksum(0, 0, 0, "x", "x");
    if g0_a != g0_b {
        println("FAIL wal_record_checksum");
        process_exit(1);
    }
    println("prod_gr_wal_writer: PASSED");
}
