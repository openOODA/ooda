// # Product prove std/tui/cursor_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts cursor_controller_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/cursor_controller.oo.
//
// Beats:
//   1. Call cursor_controller_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cursor_controller: PASSED only if they match.

import "std/tui/cursor_controller.oo";

pub fn main() {
    let a: CursorController = cursor_controller_new();
    let b: CursorController = cursor_controller_new();
    if a.x != 0 {
        println("FAIL cursor_controller_new");
        process_exit(1);
    }
    if a.x != b.x {
        println("FAIL cursor_controller_new");
        process_exit(1);
    }
    println("prod_cursor_controller: PASSED");
}
