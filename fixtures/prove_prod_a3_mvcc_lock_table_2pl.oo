// # Product prove std/db_storage/mvcc_lock_table_2pl.oo
//
// Logline: Fail-closed emit+gcc+run asserts are_locks_compatible is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_lock_table_2pl.oo.
//
// Beats:
//   1. Call are_locks_compatible twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_lock_table_2pl: PASSED only if they match.

import "std/db_storage/mvcc_lock_table_2pl.oo";

pub fn main() {
    let mvcc_lock_table_2pl_mark: Int = 0;
    if mvcc_lock_table_2pl_mark != 0 {
        process_exit(1);
    }
    let a: Bool = are_locks_compatible("x", "x");
    let b: Bool = are_locks_compatible("x", "x");
    if a != b {
        println("FAIL are_locks_compatible");
        process_exit(1);
    }
    println("prod_mvcc_lock_table_2pl: PASSED");
}
