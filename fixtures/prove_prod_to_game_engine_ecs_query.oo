// # Product prove std/game_engine/ecs_query.oo
//
// Logline: Fail-closed emit+gcc+run asserts query_collidable_2d holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_query.oo.
//
// Beats:
//   1. Call query_collidable_2d using the ecs_query ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ecs_query: PASSED only if asserts hold.

import "std/game_engine/ecs_query.oo";

pub fn main() {
    let obj = query_collidable_2d();
    let ecs_query_a = obj.all_mask;
    let ecs_query_b = obj.all_mask;
    if ecs_query_a != ecs_query_b {
        println("FAIL query_collidable_2d");
        process_exit(1);
    }
    println("prod_ecs_query: PASSED");
}
