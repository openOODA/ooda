// # Product prove std/auto_robot/pointcloud_cluster_euclidean.oo
//
// Logline: Fail-closed emit+gcc+run asserts euc_dist_sq is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_cluster_euclidean.oo.
//
// Beats:
//   1. Call euc_dist_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pointcloud_cluster_euclidean: PASSED only if they match.

import "std/auto_robot/pointcloud_cluster_euclidean.oo";

pub fn main() {
    let pointcloud_cluster_euclidean_mark: Int = 0;
    if pointcloud_cluster_euclidean_mark != 0 {
        process_exit(1);
    }
    let a: Int = euc_dist_sq(0, 0);
    let b: Int = euc_dist_sq(0, 0);
    if a != b {
        println("FAIL euc_dist_sq");
        process_exit(1);
    }
    println("prod_pointcloud_cluster_euclidean: PASSED");
}
