// # Product prove std/compilers_vm/wasm_component_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts comp_type_bool is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_component_model.oo.
//
// Beats:
//   1. Call comp_type_bool twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_model: PASSED only if they match.

import "std/compilers_vm/wasm_component_model.oo";

pub fn main() {
    let wasm_component_model_mark: Int = 0;
    if wasm_component_model_mark != 0 {
        process_exit(1);
    }
    let a: Int = comp_type_bool();
    let b: Int = comp_type_bool();
    if a != b {
        println("FAIL comp_type_bool");
        process_exit(1);
    }
    println("prod_wasm_component_model: PASSED");
}
