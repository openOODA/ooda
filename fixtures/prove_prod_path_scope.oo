// # Product prove std/sec/path_scope.oo
//
// Logline: Fail-closed emit+gcc+run asserts path_scope_allows is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/path_scope.oo.
//
// Beats:
//   1. Call path_scope_allows twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_scope: PASSED only if they match.

import "std/sec/path_scope.oo";

pub fn main() {
    let a = path_scope_allows("x", "x");
    let b = path_scope_allows("x", "x");
    if a != b {
        println("FAIL path_scope_allows");
        process_exit(1);
    }
    println("prod_path_scope: PASSED");
}
