// # Product prove std/3d/mesh_stubs.oo
//
// Logline: Fail-closed verification that 3D mesh stubs module imports and mesh geometry types are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/mesh_stubs.oo.
//
// Beats:
//   1. Construct Vector3, Triangle, and Mesh structures.
//   2. Read and verify vertex coordinates and mesh attributes.
//   3. Print prod_g4_3d_mesh_stubs: PASSED and exit 0.

import "std/3d/mesh_stubs.oo";

pub fn main() {
    let v1: Vector3 = vector3_new(10, 20, 30);
    let v2: Vector3 = vector3_new(40, 50, 60);
    let v3: Vector3 = vector3_new(70, 80, 90);

    let t: Triangle = triangle_new(v1, v2, v3);
    let x1: Int = t.x1;
    let y2: Int = t.y2;
    let z3: Int = t.z3;

    if x1 != 10 {
        println("FAIL triangle x1");
        process_exit(1);
    }
    if y2 != 50 {
        println("FAIL triangle y2");
        process_exit(1);
    }
    if z3 != 90 {
        println("FAIL triangle z3");
        process_exit(1);
    }

    let m: Mesh = mesh_new(42);
    let mid: Int = m.id;
    let ntri: Int = m.n_tri;

    if mid != 42 {
        println("FAIL mesh id");
        process_exit(1);
    }
    if ntri != 0 {
        println("FAIL mesh n_tri");
        process_exit(1);
    }

    println("prod_g4_3d_mesh_stubs: PASSED");
    process_exit(0);
}
