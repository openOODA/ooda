// # Refuse a helper that returns a secret
//
// Logline: A helper that captures a tagged name and returns a derived string taints println.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Concatenate that name inside closure_capture.
//   3. Print the helper result so the sink refuses.

// M-? closure-style return taint: helper captures secret and returns derived value
// SECRET: api_key
pub fn closure_capture() -> String {
    let api_key = "x";
    return "[" + api_key + "]";
}
pub fn main() {
    let y = closure_capture();
    println(y);
}
