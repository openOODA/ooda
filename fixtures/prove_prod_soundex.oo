// # Product Soundex prove
//
// Logline: Fail-closed emit+gcc+run of shipped soundex_encode.
//
// Setup: Product std/text/soundex.oo. US Census Robert/Rupert.
//
// Beats:
//   1. soundex_encode Robert is R163.
//   2. soundex_encode Rupert is R163.
//   3. soundex_matches Robert Rupert is true.
//   4. Exit 1 before PASSED on a miss.

import "std/text/soundex.oo";

pub fn main() {
    let rob: String = soundex_encode("Robert");
    if rob != "R163" {
        println("FAIL soundex Robert");
        process_exit(1);
    }
    let rup: String = soundex_encode("Rupert");
    if rup != "R163" {
        println("FAIL soundex Rupert");
        process_exit(1);
    }
    let ok: Bool = soundex_matches("Robert", "Rupert");
    if ok == false {
        println("FAIL soundex matches");
        process_exit(1);
    }
    println("prod_soundex: PASSED");
}
