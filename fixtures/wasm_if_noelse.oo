// # Const if-true println with no else
//
// Logline: Print noelse-yes when the body is only if true with one println and no else.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If true print noelse-yes.
//   3. Leave no else and no other statements.

pub fn main() {
    if true {
        println("noelse-yes");
    }
}
