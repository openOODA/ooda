// # Product prove std/wasm_gc/wasm_gc_shadow_stack.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadow_stack_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_shadow_stack.oo.
//
// Beats:
//   1. Call shadow_stack_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_shadow_stack: PASSED only if they match.

import "std/wasm_gc/wasm_gc_shadow_stack.oo";

pub fn main() {
    let wasm_gc_shadow_stack_mark: Int = 0;
    if wasm_gc_shadow_stack_mark != 0 {
        process_exit(1);
    }
    let wasm_gc_shadow_stack_a = shadow_stack_new();
    let wasm_gc_shadow_stack_b = shadow_stack_new();
    if (wasm_gc_shadow_stack_a).frame_count != (wasm_gc_shadow_stack_b).frame_count {
        println("FAIL shadow_stack_new");
        process_exit(1);
    }
    println("prod_wasm_gc_shadow_stack: PASSED");
}
