// # Product prove std/astro_advanced/venus_gravity_assist.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/venus_gravity_assist.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/venus_gravity_assist.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_venus_gravity_assist: PASSED only if they match.

import "std/astro_advanced/venus_gravity_assist.oo";

pub fn main() {
    let venus_gravity_assist_a = venus_assist_dv();
    let venus_gravity_assist_b = venus_assist_dv();
    if venus_gravity_assist_a != venus_gravity_assist_b {
        println("FAIL venus_gravity_assist");
        process_exit(1);
    }
    println("prod_ap_venus_gravity_assist: PASSED");
}
