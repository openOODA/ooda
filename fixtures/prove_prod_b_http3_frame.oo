// # Product prove std/net/http3_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts http3_frame_type_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http3_frame.oo.
//
// Beats:
//   1. Call http3_frame_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http3_frame: PASSED only if they match.

import "std/net/http3_frame.oo";

pub fn main() {
    let a = http3_frame_type_name(0);
    let b = http3_frame_type_name(0);
    if a != b {
        println("FAIL http3_frame_type_name");
        process_exit(1);
    }
    println("prod_http3_frame: PASSED");
}
