// # Product prove std/auto/orca_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts orca_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_ops.oo.
//
// Beats:
//   1. Call orca_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orca_ops: PASSED only if they match.

import "std/auto/orca_ops.oo";

pub fn main() {
    let orca_ops_mark: Int = 0;
    if orca_ops_mark != 0 {
        process_exit(1);
    }
    let a: OrcaOp = orca_op_new(0, 0);
    let b: OrcaOp = orca_op_new(0, 0);
    if (a).radius_mm != (b).radius_mm {
        println("FAIL orca_op_new");
        process_exit(1);
    }
    println("prod_orca_ops: PASSED");
}
