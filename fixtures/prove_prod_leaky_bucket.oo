// # Product prove std/sync/leaky_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts leaky_bucket_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/leaky_bucket.oo.
//
// Beats:
//   1. Call leaky_bucket_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_leaky_bucket: PASSED only if they match.

import "std/sync/leaky_bucket.oo";

pub fn main() {
    let obj = leaky_bucket_new(0, 0);
    let a = obj.capacity;
    let b = obj.capacity;
    if a != b {
        println("FAIL leaky_bucket_new");
        process_exit(1);
    }
    println("prod_leaky_bucket: PASSED");
}
