// # Product prove std/telecom_5g/sync_mueller_muller_ted.oo
//
// Logline: Fail-closed emit+gcc+run asserts sync_mm_slice_bpsk is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_mueller_muller_ted.oo.
//
// Beats:
//   1. Call sync_mm_slice_bpsk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sync_mueller_muller_ted: PASSED only if they match.

import "std/telecom_5g/sync_mueller_muller_ted.oo";

pub fn main() {
    let sync_mueller_muller_ted_mark: Int = 0;
    if sync_mueller_muller_ted_mark != 0 {
        process_exit(1);
    }
    let a: Float = sync_mm_slice_bpsk(0.0);
    let b: Float = sync_mm_slice_bpsk(0.0);
    if a != b {
        println("FAIL sync_mm_slice_bpsk");
        process_exit(1);
    }
    println("prod_sync_mueller_muller_ted: PASSED");
}
