// # Imported helper for per-module .o warm build
//
// Logline: Export sk13_n so a two-module build has a cacheable lib.
//
// Setup: Isolated oodac build. Imported by sk13_cache_main.
//
// Beats:
//   1. Name the helper.
//   2. Return 3.
//   3. Stay tiny.

pub fn sk13_n() -> Int {
    return 3;
}
