// # Product regex_bytecode prove
//
// Logline: Fail-closed emit+gcc+run of shipped regex_bc_emit_char/match/len/get_op.
//
// Setup: Product std/text/regex_bytecode.oo. CHAR 97 then MATCH.
//
// Beats:
//   1. Empty len 0; after CHAR+MATCH len 2; op0=2 arg1=97; op1=1.
//   2. Exit 1 before PASSED on a miss.

import "std/text/regex_bytecode.oo";

pub fn main() {
    let mut bc: RegexBytecode = regex_bc_new();
    let z: Int = regex_bc_len(bc);
    if z != 0 {
        println("FAIL rebc empty");
        process_exit(1);
    }
    bc = regex_bc_emit_char(bc, 97);
    bc = regex_bc_emit_match(bc);
    let n: Int = regex_bc_len(bc);
    if n != 2 {
        println("FAIL rebc len");
        process_exit(1);
    }
    let op0: Int = regex_bc_get_op(bc, 0);
    if op0 != 2 {
        println("FAIL rebc op char");
        process_exit(1);
    }
    let a1: Int = regex_bc_get_arg1(bc, 0);
    if a1 != 97 {
        println("FAIL rebc arg1");
        process_exit(1);
    }
    let op1: Int = regex_bc_get_op(bc, 1);
    if op1 != 1 {
        println("FAIL rebc op match");
        process_exit(1);
    }
    println("prod_rebc: PASSED");
}
