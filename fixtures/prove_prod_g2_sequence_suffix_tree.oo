// # Product prove std/bio_advanced/sequence_suffix_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts suffix_compare_strings is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_suffix_tree.oo.
//
// Beats:
//   1. Call suffix_compare_strings twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sequence_suffix_tree: PASSED only if they match.

import "std/bio_advanced/sequence_suffix_tree.oo";

pub fn main() {
    let sequence_suffix_tree_mark: Int = 0;
    if sequence_suffix_tree_mark != 0 {
        process_exit(1);
    }
    let a: Int = suffix_compare_strings("x", "x");
    let b: Int = suffix_compare_strings("x", "x");
    if a != b {
        println("FAIL suffix_compare_strings");
        process_exit(1);
    }
    println("prod_g2_sequence_suffix_tree: PASSED");
}
