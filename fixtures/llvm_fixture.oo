// # LLVM Backend Fixture
//
// Logline: Exercises integer/float arithmetic, GEP struct access and mutation, ARC strings and lists, and control flow on the LLVM IR backend.
//
// Setup: Types Point and Cell are defined with scalar fields.
//
// Beats:
//   1. Compute integer and float arithmetic expressions.
//   2. Allocate, read, and mutate Point and Cell struct fields.
//   3. Run while loops and if-else branches.
//   4. Build ARC strings and integer lists.
//   5. Print milestone markers to verify execution correctness.

type Point = struct {
    x: Int,
    y: Int
    };

type Cell = struct {
    v: Int
    };

pub fn calc_arith(a: Int, b: Int) -> Int {
    let sum = a + b * 2;
    let rem = sum % 5;
    let bit = (a & b) | (a ^ b);
    let sh = bit << 1;
    return sum + rem + sh;
}

pub fn calc_float(x: Float, y: Float) -> Float {
    let fsum = x + y * 2.0;
    let fdiv = fsum / 4.0;
    return fdiv;
}

pub fn bump_cell(c: Cell) -> Cell {
    let mut m: Cell = c;
    m.v = m.v + 10;
    return m;
}

pub fn loop_accum(n: Int) -> Int {
    let mut i = 0;
    let mut acc = 0;
    while i < n {
        if i % 2 == 0 {
            acc = acc + i;
        } else {
            acc = acc + (i * 2);
        }
        i = i + 1;
    }
    return acc;
}

pub fn main() {
    let i_res = calc_arith(10, 3);
    println(i_res);

    let f_res = calc_float(4.0, 6.0);
    println(f_res);

    let mut p = Point { x: 12, y: 34 };
    println(p.x);
    println(p.y);
    p.x = 99;
    println(p.x);

    let mut c = Cell { v: 5 };
    c = bump_cell(c);
    println(c.v);

    let l_res = loop_accum(5);
    println(l_res);

    let s1 = "LLVM_";
    let s2 = "FIXTURE_OK";
    let s3 = s1 + s2;
    println(s3);

    let mut xs = list_new();
    xs = list_push(xs, 100);
    xs = list_push(xs, 200);
    println(list_len(xs));
    println(list_get(xs, 0));
    println(list_get(xs, 1));
}
