// # List of struct that holds a struct
//
// Logline: Fail-closed emit+gcc+run of List[Wrap] where Wrap holds a Node.
//
// Setup: Backend-C. Nested user struct field, not List[List[T]].
//
// Beats:
//   1. Push one Wrap that holds Node id 9.
//   2. Get the wrap and read inner.id.
//   3. Exit 1 before PASSED on a miss.

type Node = struct {
    id: Int,
    tag: String
};

type Wrap = struct {
    inner: Node,
    n: Int
};

pub fn main() {
    let mut xs: List[Wrap] = list_new();
    let n0: Node = Node { id: 9, tag: "in" };
    let w0: Wrap = Wrap { inner: n0, n: 1 };
    xs = list_push(xs, w0);
    let g: Wrap = list_get(xs, 0);
    if g.n != 1 {
        println("FAIL wrap n");
        process_exit(1);
    }
    if g.inner.id != 9 {
        println("FAIL inner id");
        process_exit(1);
    }
    if g.inner.tag != "in" {
        println("FAIL inner tag");
        process_exit(1);
    }
    println("list_struct_nested: PASSED");
}
