// # Product prove std/astrodynamics/coordinate_orbital_plane.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/coordinate_orbital_plane.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/coordinate_orbital_plane.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_coordinate_orbital_plane: PASSED only if they match.

import "std/astrodynamics/coordinate_orbital_plane.oo";

pub fn main() {
    let coordinate_orbital_plane_a = plane_inc_deg();
    let coordinate_orbital_plane_b = plane_inc_deg();
    if coordinate_orbital_plane_a != coordinate_orbital_plane_b {
        println("FAIL coordinate_orbital_plane");
        process_exit(1);
    }
    println("prod_ap_coordinate_orbital_plane: PASSED");
}
