// # Product prove std/iot_scada/opcua_secure_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_next_sequence_number is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_secure_channel.oo.
//
// Beats:
//   1. Call opcua_next_sequence_number twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opcua_secure_channel: PASSED only if they match.

import "std/iot_scada/opcua_secure_channel.oo";

pub fn main() {
    let opcua_secure_channel_mark: Int = 0;
    if opcua_secure_channel_mark != 0 {
        process_exit(1);
    }
    let opcua_secure_channel_a: Int = opcua_next_sequence_number(1);
    let opcua_secure_channel_b: Int = opcua_next_sequence_number(1);
    if opcua_secure_channel_a != opcua_secure_channel_b {
        println("FAIL opcua_next_sequence_number");
        process_exit(1);
    }
    println("prod_opcua_secure_channel: PASSED");
}
