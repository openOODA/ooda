// # Product prove std/genomics_advanced/crispr_spacer_array_miner.oo
//
// Logline: Fail-closed emit+gcc+run asserts crispr_spacer_array_miner_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/crispr_spacer_array_miner.oo.
//
// Beats:
//   1. Call crispr_spacer_array_miner_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crispr_spacer_array_miner: PASSED only if they match.

import "std/genomics_advanced/crispr_spacer_array_miner.oo";

pub fn main() {
    let a = crispr_spacer_array_miner_probe();
    let b = crispr_spacer_array_miner_probe();
    if a != b {
        println("FAIL crispr_spacer_array_miner_probe");
        process_exit(1);
    }
    println("prod_crispr_spacer_array_miner: PASSED");
}
