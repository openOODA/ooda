// # Product prove std/astrodynamics/lambert_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/lambert_solver.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/lambert_solver.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lambert_solver: PASSED only if they match.

import "std/astrodynamics/lambert_solver.oo";

pub fn main() {
    let lambert_solver_a = lambert_revs();
    let lambert_solver_b = lambert_revs();
    if lambert_solver_a != lambert_solver_b {
        println("FAIL lambert_solver");
        process_exit(1);
    }
    println("prod_ap_lambert_solver: PASSED");
}
