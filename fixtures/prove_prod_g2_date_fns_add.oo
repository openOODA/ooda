// # Product prove std/web_ecosystem/date_fns_add.oo
//
// Logline: Fail-closed emit+gcc+run asserts date_fns_add_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/date_fns_add.oo.
//
// Beats:
//   1. Call date_fns_add_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_date_fns_add: PASSED only if they match.

import "std/web_ecosystem/date_fns_add.oo";

pub fn main() {
    let a: Int = date_fns_add_probe();
    let b: Int = date_fns_add_probe();
    if a != b {
        println("FAIL date_fns_add_probe");
        process_exit(1);
    }
    println("prod_g2_date_fns_add: PASSED");
}
