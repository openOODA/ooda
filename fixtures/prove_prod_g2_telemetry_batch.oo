// # Product prove std/aero/telemetry_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts tm_batch_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_batch.oo.
//
// Beats:
//   1. Call tm_batch_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telemetry_batch: PASSED only if they match.

import "std/aero/telemetry_batch.oo";

pub fn main() {
    let telemetry_batch_mark: Int = 0;
    if telemetry_batch_mark != 0 {
        process_exit(1);
    }
    let a: TmBatch = tm_batch_new(0, 0);
    let b: TmBatch = tm_batch_new(0, 0);
    if (a).count != (b).count {
        println("FAIL tm_batch_new");
        process_exit(1);
    }
    println("prod_g2_telemetry_batch: PASSED");
}
