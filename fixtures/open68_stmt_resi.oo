// # Statement match Result[Int] lock
//
// Logline: Fail-closed emit+run of a statement match that binds an Int Ok payload.
//
// Setup: Backend-LLVM. Ok(7) stays i64.
//
// Beats:
//   1. Bind r as Result[Int, String].
//   2. Statement match writes n from Ok(v).
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let r: Result[Int, String] = Ok(7);
    let mut n: Int = 0;
    match r {
        Ok(v) => { n = v; }
        Err(e) => { n = 0; }
    }
    if n != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("open68_stmt_resi: PASSED");
}
