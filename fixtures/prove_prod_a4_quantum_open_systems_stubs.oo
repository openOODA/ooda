// # Product prove std/quantum_open_systems/quantum_open_systems_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts open_quantum_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_open_systems_stubs.oo.
//
// Beats:
//   1. Call open_quantum_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_open_systems_stubs: PASSED only if they match.

import "std/quantum_open_systems/quantum_open_systems_stubs.oo";

pub fn main() {
    let quantum_open_systems_stubs_mark: Int = 0;
    if quantum_open_systems_stubs_mark != 0 {
        process_exit(1);
    }
    let a: OpenQuantumCapabilities = open_quantum_capabilities_default();
    let b: OpenQuantumCapabilities = open_quantum_capabilities_default();
    if (a).max_resonator_modes != (b).max_resonator_modes {
        println("FAIL open_quantum_capabilities_default");
        process_exit(1);
    }
    println("prod_quantum_open_systems_stubs: PASSED");
}
