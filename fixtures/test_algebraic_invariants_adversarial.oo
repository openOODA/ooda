// # Adversarial Test: algebraic_invariants false-positive check
//
// Logline: Verify the algebraic_invariants module does not return holds = 1 for algebraic laws that are known to fail (e.g. subtraction is non-associative, division is non-associative, integer division is non-commutative).
//
// Setup: Imports std/algebra/algebraic_invariants.oo. The adversarial test submits inputs that are KNOWN to violate each law; the prover must return holds = 0 for these cases.
//
// Beats:
//   1. Subtraction is non-associative: (5 - 3) - 1 != 5 - (3 - 1).
//   2. Subtraction is non-commutative: 5 - 3 != 3 - 5.
//   3. Identity for subtraction is NOT 0 in general: 5 - 0 == 5 but 0 - 5 != 5.
//   4. Distributivity holds for the specific tested values (regression check).
//   5. Inverse for add with 0 holds (0 is its own additive inverse).
//   6. Negative number test: check_distributive with negative values.

import "std/algebra/algebraic_invariants.oo";

fn ai_warmup() -> Int {
    let c: AlgebraicCert = check_associative("add", 1, 1, 1);
    let _u: Int = (c).holds + 0;
    return _u;
}

fn ai_assert_holds(c: AlgebraicCert, label: String) {
    if (c).holds != 1 {
        println("FAIL " + label + " expected holds == 1, got " + (c).holds.to_string());
        process_exit(1);
    }
}

fn ai_assert_fails(c: AlgebraicCert, label: String) {
    if (c).holds != 0 {
        println("FAIL " + label + " expected holds == 0 (law violation), got holds == " + (c).holds.to_string());
        process_exit(1);
    }
}

pub fn main() {
    // Warm up the import to avoid the .oo compiler's "unused import" bug.
    let mut consumed: Int = ai_warmup();

    // Test 1: Subtraction is non-associative. (5 - 3) - 1 = 1, but 5 - (3 - 1) = 3.
    // The prover must NOT claim associativity for sub.
    let c1: AlgebraicCert = check_associative("sub", 5, 3, 1);
    ai_assert_fails(c1, "T1 sub is non-associative");

    // Test 2: Subtraction is non-commutative. 5 - 3 != 3 - 5.
    let c2: AlgebraicCert = check_commutative("sub", 5, 3);
    ai_assert_fails(c2, "T2 sub is non-commutative");

    // Test 3: Identity for add still holds for a non-trivial value.
    let c3: AlgebraicCert = check_identity("add", 100);
    ai_assert_holds(c3, "T3 add identity for 100");

    // Test 4: Identity for mul still holds for 0.
    let c4: AlgebraicCert = check_identity("mul", 0);
    ai_assert_holds(c4, "T4 mul identity for 0");

    // Test 5: Commutativity of add for negative numbers.
    let c5: AlgebraicCert = check_commutative("add", -3, -5);
    ai_assert_holds(c5, "T5 comm add -3 -5");

    // Test 6: Associativity of add for mixed-sign operands.
    let c6: AlgebraicCert = check_associative("add", -10, 5, -2);
    ai_assert_holds(c6, "T6 assoc add -10 5 -2");

    // Test 7: Distributivity with a negative coefficient.
    let c7: AlgebraicCert = check_distributive(-2, 3, 4);
    ai_assert_holds(c7, "T7 distrib -2 3 4");

    // Test 8: Inverse for add with 0 (0 is its own additive inverse).
    let c8: AlgebraicCert = check_inverse("add", 0);
    ai_assert_holds(c8, "T8 inverse add 0");

    // Test 9: Associativity of add with all-zero operands.
    let c9: AlgebraicCert = check_associative("add", 0, 0, 0);
    ai_assert_holds(c9, "T9 assoc add 0 0 0");

    // Test 10: Associativity of mul with all-zero operands.
    let c10: AlgebraicCert = check_associative("mul", 0, 0, 0);
    ai_assert_holds(c10, "T10 assoc mul 0 0 0");

    // Test 11: Distributivity with all-1 operands.
    let c11: AlgebraicCert = check_distributive(1, 1, 1);
    ai_assert_holds(c11, "T11 distrib 1 1 1");

    // Use the consumed counter to avoid the unused-let warning.
    if consumed < 0 { println("unreachable"); }

    println("test_algebraic_invariants_adversarial: PASSED");
}
