// # Option[Int] Some(0) emit lock
//
// Logline: Fail-closed emit+gcc+run of Option[Int] so Some(0) is not None.
//
// Setup: Backend-C. Option[Int] is tagged. Some(0) must not lower as 0.
//
// Beats:
//   1. Bind Some(0) and match Some with payload 0.
//   2. Bind None and match None.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let a: Option[Int] = Some(0);
    let b: Option[Int] = None;
    let va: Int = match a {
        Some(v) => v,
        None => -1
    };
    if va != 0 {
        println("FAIL some0");
        process_exit(1);
    }
    let vb: Int = match b {
        Some(v) => 1,
        None => 0
    };
    if vb != 0 {
        println("FAIL none");
        process_exit(1);
    }
    println("option_int_smoke: PASSED");
}
