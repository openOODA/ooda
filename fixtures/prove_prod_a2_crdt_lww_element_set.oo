// # Product prove std/cloud_k8s/crdt_lww_element_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts lww_set_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_lww_element_set.oo.
//
// Beats:
//   1. Call lww_set_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crdt_lww_element_set: PASSED only if they match.

import "std/cloud_k8s/crdt_lww_element_set.oo";

pub fn main() {
    let crdt_lww_element_set_mark: Int = 0;
    if crdt_lww_element_set_mark != 0 {
        process_exit(1);
    }
    let a: LwwSet = lww_set_new(0, 0);
    let b: LwwSet = lww_set_new(0, 0);
    if (a).elem != (b).elem {
        println("FAIL lww_set_new");
        process_exit(1);
    }
    println("prod_crdt_lww_element_set: PASSED");
}
