// # Product prove std/db_graph/opencypher_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_classify_keyword is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_lexer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call cypher_classify_keyword twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_opencypher_lexer: PASSED only if they match.

import "std/db_graph/opencypher_lexer.oo";

pub fn main() {
    let g0_a = cypher_classify_keyword("x");
    let g0_b = cypher_classify_keyword("x");
    if g0_a != g0_b {
        println("FAIL cypher_classify_keyword");
        process_exit(1);
    }
    println("prod_gr_opencypher_lexer: PASSED");
}
