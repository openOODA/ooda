// # Product prove std/astrophysics_relativity/stellar_lane_emden_polytrope.oo
//
// Logline: Fail-closed emit+gcc+run asserts polytrope_derivatives is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_lane_emden_polytrope.oo.
//
// Beats:
//   1. Call polytrope_derivatives twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_lane_emden_polytrope: PASSED only if they match.

import "std/astrophysics_relativity/stellar_lane_emden_polytrope.oo";

pub fn main() {
    let stellar_lane_emden_polytrope_mark: Int = 0;
    if stellar_lane_emden_polytrope_mark != 0 {
        process_exit(1);
    }
    let a: Float = polytrope_derivatives(0.0, 0.0, 0.0, 0.0);
    let b: Float = polytrope_derivatives(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL polytrope_derivatives");
        process_exit(1);
    }
    println("prod_stellar_lane_emden_polytrope: PASSED");
}
