// # Product prove std/mesh_ebpf/ebpf_verifier_simulation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebpf_reg_scalar is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_verifier_simulation.oo.
//
// Beats:
//   1. Call ebpf_reg_scalar twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_verifier_simulation: PASSED only if they match.

import "std/mesh_ebpf/ebpf_verifier_simulation.oo";

pub fn main() {
    let ebpf_verifier_simulation_mark: Int = 0;
    if ebpf_verifier_simulation_mark != 0 {
        process_exit(1);
    }
    let ebpf_verifier_simulation_a = ebpf_reg_scalar(1, 1);
    let ebpf_verifier_simulation_b = ebpf_reg_scalar(1, 1);
    if (ebpf_verifier_simulation_a).type_id != (ebpf_verifier_simulation_b).type_id {
        println("FAIL ebpf_reg_scalar");
        process_exit(1);
    }
    println("prod_ebpf_verifier_simulation: PASSED");
}
