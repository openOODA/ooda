// # Product prove std/graph_topology/shortest_path_dijkstra.oo
//
// Logline: Fail-closed emit+gcc+run asserts shortest_path_dijkstra_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_topology/shortest_path_dijkstra.oo.
//
// Beats:
//   1. Call shortest_path_dijkstra_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_shortest_path_dijkstra: PASSED only if it matches.

import "std/graph_topology/shortest_path_dijkstra.oo";

pub fn main() {
    let a: Int = shortest_path_dijkstra_probe();
    if a != 0 {
        println("FAIL shortest_path_dijkstra_probe");
        process_exit(1);
    }
    println("prod_nc_shortest_path_dijkstra: PASSED");
}
