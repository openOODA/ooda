// # Product prove std/compilers_polyhedral/autovec_outer_loop_vectorize.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/autovec_outer_loop_vectorize.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_outer_loop_vectorize.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_autovec_outer_loop_vectorize: PASSED only if they match.

import "std/compilers_polyhedral/autovec_outer_loop_vectorize.oo";

pub fn main() {
    let autovec_outer_loop_vectorize_a = outer_loop_vector_config_new(0, 0, 0);
    let autovec_outer_loop_vectorize_b = outer_loop_vector_config_new(0, 0, 0);
    let autovec_outer_loop_vectorize_va = outer_vector_required_vector_registers(autovec_outer_loop_vectorize_a);
    let autovec_outer_loop_vectorize_vb = outer_vector_required_vector_registers(autovec_outer_loop_vectorize_b);
    if autovec_outer_loop_vectorize_va != autovec_outer_loop_vectorize_vb {
        println("FAIL autovec_outer_loop_vectorize");
        process_exit(1);
    }
    println("prod_ap_autovec_outer_loop_vectorize: PASSED");
}
