// # Product prove std/synthetic_biology/two_component_chimeric_sensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts tcs_derivatives real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/two_component_chimeric_sensor.oo.
//
// Beats:
//   1. Call tcs_derivatives with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_two_component_chimeric_sensor: PASSED only if the assert holds.

import "std/synthetic_biology/two_component_chimeric_sensor.oo";

pub fn main() {
    let two_component_chimeric_sensor_mark: Int = 0;
    if two_component_chimeric_sensor_mark != 0 {
        process_exit(1);
    }
    let two_component_chimeric_sensor_st: TcsPhosphoState = TcsPhosphoState { hk_p_conc: 0.0, rr_p_conc: 0.0, time_min: 0.0 };
    let two_component_chimeric_sensor_p: TcsKineticsParams = TcsKineticsParams { k_auto_phospho_max: 0.0, k_phosphotransfer: 0.0, k_phosphatase: 0.0, total_hk_conc: 0.0, total_rr_conc: 0.0 };
    let two_component_chimeric_sensor_a = tcs_derivatives(&two_component_chimeric_sensor_st, &two_component_chimeric_sensor_p, 0.0);
    let two_component_chimeric_sensor_time_min: Float = (two_component_chimeric_sensor_a).time_min;
    if !(two_component_chimeric_sensor_time_min == 0.0) {
        println("FAIL tcs_derivatives");
        process_exit(1);
    }
    println("prod_two_component_chimeric_sensor: PASSED");
}
