// # Product prove std/os/temp_file_atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts temp_file_make_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/temp_file_atomic.oo.
//
// Beats:
//   1. Call temp_file_make_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_temp_file_atomic: PASSED only if they match.

import "std/os/temp_file_atomic.oo";

pub fn main() {
    let a = temp_file_make_name("x", 0);
    let b = temp_file_make_name("x", 0);
    if a != b {
        println("FAIL temp_file_make_name");
        process_exit(1);
    }
    println("prod_temp_file_atomic: PASSED");
}
