// # Result[Int, Bool] emit honesty lock
//
// Logline: emit-c fail-closes Result[Int, Bool] rather than using OoResI String Err.
//
// Setup: Backend-C. Bool as Result E is residual. OoResB is Bool Ok, not Bool E.
//
// Beats:
//   1. Return Result[Int, Bool].
//   2. Emit must not treat E as String.
//   3. Fail closed with ERR c_emit.

pub fn f() -> Result[Int, Bool] {
    return Ok(1);
}

pub fn main() {
    let r: Result[Int, Bool] = f();
    println("should_not_emit");
}
