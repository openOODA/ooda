// # E-M scale demo
//
// Logline: Scale a non-negative int by plus one under requires and ensures.
//
// Beats:
//   1. Require x >= 0 and ensure result >= x.
//   2. Verify scale(1) and scale(0).
//   3. Print scale(41).

// Measured E-M demo: pure arithmetic + contracts (interpreter path).
// Run: ooda em fixtures/em_demo.oo
//      ooda run fixtures/em_demo.oo
// Note: ooda build --target c refuses requires/ensures — use run/test.

pub fn scale(x: Int) -> Int
    requires x >= 0
    ensures result >= x
{
    return x + 1;
}

verify scale {
    assert_eq!(scale(1), 2);
    assert_eq!(scale(0), 1);
}

pub fn main() {
    let y = scale(41);
    println(y);
}
