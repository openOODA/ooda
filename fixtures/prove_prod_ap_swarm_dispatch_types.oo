// # Product prove std/swarm/dispatch_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/swarm/dispatch_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dispatch_types: PASSED only if they match.

import "std/swarm/dispatch_types.oo";

pub fn main() {
    let dispatch_types_a = dispatcher_config_new(0, 0);
    let dispatch_types_b = dispatcher_config_new(0, 0);
    let dispatch_types_va = dispatcher_config_depth(dispatch_types_a);
    let dispatch_types_vb = dispatcher_config_depth(dispatch_types_b);
    if dispatch_types_va != dispatch_types_vb {
        println("FAIL dispatch_types");
        process_exit(1);
    }
    println("prod_ap_dispatch_types: PASSED");
}
