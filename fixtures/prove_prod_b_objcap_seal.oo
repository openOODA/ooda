// # Product prove std/sec/sys/objcap_seal.oo
//
// Logline: Fail-closed emit+gcc+run asserts objcap_seal_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_seal.oo.
//
// Beats:
//   1. Call objcap_seal_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap_seal: PASSED only if they match.

import "std/sec/sys/objcap_seal.oo";

pub fn main() {
    let a = objcap_seal_checksum("x");
    let b = objcap_seal_checksum("x");
    if a != b {
        println("FAIL objcap_seal_checksum");
        process_exit(1);
    }
    println("prod_objcap_seal: PASSED");
}
