// # Product prove std/satellite_dvb/satellite_doppler_precompensation.oo
//
// Logline: Fail-closed emit+gcc+run asserts doppler_precompensator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_doppler_precompensation.oo.
//
// Beats:
//   1. Call doppler_precompensator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_doppler_precompensation: PASSED only if they match.

import "std/satellite_dvb/satellite_doppler_precompensation.oo";

pub fn main() {
    let satellite_doppler_precompensation_mark: Int = 0;
    if satellite_doppler_precompensation_mark != 0 {
        process_exit(1);
    }
    let a: DopplerPrecompensator = doppler_precompensator_new(0.0);
    let b: DopplerPrecompensator = doppler_precompensator_new(0.0);
    if (a).carrier_freq_hz != (b).carrier_freq_hz {
        println("FAIL doppler_precompensator_new");
        process_exit(1);
    }
    println("prod_satellite_doppler_precompensation: PASSED");
}
