// # Product prove std/fin/yield_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts yield curve interpolation, bootstrap, shifts, and analysis.
//
// Setup: Isolated emit-c. Imports std/fin/yield_engine.oo.
//
// Beats:
//   1. Build yield curve and interpolate tenors between anchor points.
//   2. Calculate forward rate from consecutive discount factors.
//   3. Perform parallel curve rate shift.
//   4. Analyze curve duration, slope, and inversion metrics.

import "std/fin/yield_engine.oo";
import "std/fin/yield_curve.oo";

pub fn main() {
    let mut curve: YieldCurve = yield_curve_create("USD_SOFR", 0, 20260819, 0);
    let p1: YieldCurvePoint = yield_curve_point_create(12, 300, 0);
    let p2: YieldCurvePoint = yield_curve_point_create(120, 500, 0);
    yield_curve_add_point(&mut curve, p1);
    yield_curve_add_point(&mut curve, p2);

    let res_interp: Result[Int, String] = yield_curve_interpolate_rate(&curve, 60);
    let ok_interp: Bool = res_interp.is_ok();
    if ok_interp == false {
        println("FAIL yield_curve_interpolate_rate");
        process_exit(1);
    }
    let r_val: Int = res_interp.unwrap();
    if r_val <= 300 || r_val >= 500 {
        println("FAIL interpolated rate bounds");
        process_exit(1);
    }

    let df1: DiscountFactor = discount_factor_create(12, 300, 0);
    let df2: DiscountFactor = discount_factor_create(24, 400, 0);
    let res_fwd: Result[Int, String] = calculate_forward_rate_bps(&df1, &df2);
    let ok_fwd: Bool = res_fwd.is_ok();
    if ok_fwd == false {
        println("FAIL calculate_forward_rate_bps");
        process_exit(1);
    }

    let shifted: YieldCurve = yield_curve_shift_parallel(&curve, 50);
    let shift_cnt: Int = yield_curve_get_point_count(&shifted);
    if shift_cnt != 2 {
        println("FAIL yield_curve_shift_parallel count");
        process_exit(1);
    }

    let analysis: YieldAnalysisResult = yield_curve_analyze(&curve);
    let slope: Int = (analysis).slope_2y10y_bps;
    let inv: Bool = (analysis).is_inverted;
    if inv == true {
        println("FAIL yield_curve_analyze inversion");
        process_exit(1);
    }

    println("prod_g4_fin_yield_engine: PASSED");
    process_exit(0);
}
