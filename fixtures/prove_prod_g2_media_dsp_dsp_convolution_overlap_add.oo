// # Product prove std/media_dsp/dsp_convolution_overlap_add.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_ola_engine_new is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_convolution_overlap_add.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dsp_ola_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dsp_convolution_overlap_add: PASSED only if they match.

import "std/media_dsp/dsp_convolution_overlap_add.oo";

pub fn main() {
    let g2_oa = dsp_ola_engine_new(2, 2);
    let g2_ob = dsp_ola_engine_new(2, 2);
    let g2_a = (g2_oa).block_length_l;
    let g2_b = (g2_ob).block_length_l;
    if g2_a != g2_b {
        println("FAIL dsp_ola_engine_new.block_length_l");
        process_exit(1);
    }
    println("prod_g2_dsp_convolution_overlap_add: PASSED");
}
