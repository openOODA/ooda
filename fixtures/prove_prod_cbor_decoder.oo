// # Product prove std/markup/cbor_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts cbor_decoder_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/cbor_decoder.oo.
//
// Beats:
//   1. Call cbor_decoder_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cbor_decoder: PASSED only if they match.

import "std/markup/cbor_decoder.oo";

pub fn main() {
    let obj = cbor_decoder_new(0);
    let a = obj.pos;
    let b = obj.pos;
    if a != b {
        println("FAIL cbor_decoder_new");
        process_exit(1);
    }
    println("prod_cbor_decoder: PASSED");
}
