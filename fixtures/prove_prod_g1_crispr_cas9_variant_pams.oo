// # Product prove std/crispr_cas/crispr_cas9_variant_pams.oo
//
// Logline: Fail-closed emit+gcc+run asserts variant_evaluate_target is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_cas9_variant_pams.oo.
//
// Beats:
//   1. Call variant_evaluate_target twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crispr_cas9_variant_pams: PASSED only if they match.

import "std/crispr_cas/crispr_cas9_variant_pams.oo";

pub fn main() {
    let a: VariantTargetScore = variant_evaluate_target("x", "x", 0.0);
    let b: VariantTargetScore = variant_evaluate_target("x", "x", 0.0);
    if a.is_accessible != b.is_accessible {
        println("FAIL variant_evaluate_target");
        process_exit(1);
    }
    println("prod_crispr_cas9_variant_pams: PASSED");
}
