// # Product bitset prove
//
// Logline: Fail-closed emit+gcc+run of shipped bitset_set/test/count.
//
// Setup: Product std/collections/bitset.oo. Bits 1 and 3 set.
//
// Beats:
//   1. bitset_len of 8 is 8.
//   2. After set 1 and 3, test 1 true, test 2 false, count 2.
//   3. Exit 1 before PASSED on a miss.

import "std/collections/bitset.oo";

pub fn main() {
    let mut bs: BitSet = bitset_new(8);
    let n: Int = bitset_len(bs);
    if n != 8 {
        println("FAIL bitset len");
        process_exit(1);
    }
    bs = bitset_set(bs, 1);
    bs = bitset_set(bs, 3);
    let t1: Bool = bitset_test(bs, 1);
    if t1 == false {
        println("FAIL bitset test 1");
        process_exit(1);
    }
    let t2: Bool = bitset_test(bs, 2);
    if t2 == true {
        println("FAIL bitset test 2");
        process_exit(1);
    }
    let c: Int = bitset_count(bs);
    if c != 2 {
        println("FAIL bitset count");
        process_exit(1);
    }
    println("prod_bitset: PASSED");
}
