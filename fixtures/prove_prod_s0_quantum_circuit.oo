// # Product prove std/quantum/quantum_circuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum/quantum_circuit.oo.
//
// Beats:
//   1. Call circuit_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_quantum_circuit: PASSED only if asserts hold.

import "std/quantum/quantum_circuit.oo";

pub fn main() {
    let quantum_circuit_a = circuit_new(1, 1);
    let quantum_circuit_b = circuit_new(1, 1);
    if quantum_circuit_a.num_qubits != quantum_circuit_b.num_qubits {
        println("FAIL circuit_new");
        process_exit(1);
    }
    println("prod_quantum_circuit: PASSED");
}
