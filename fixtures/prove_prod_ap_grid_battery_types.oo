// # Product prove std/grid/battery_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/battery_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_battery_types: PASSED only if they match.

import "std/grid/battery_types.oo";

pub fn main() {
    let battery_types_a = battery_bank_new(0, 0);
    let battery_types_b = battery_bank_new(0, 0);
    let battery_types_va = battery_bank_cycles(battery_types_a);
    let battery_types_vb = battery_bank_cycles(battery_types_b);
    if battery_types_va != battery_types_vb {
        println("FAIL battery_types");
        process_exit(1);
    }
    println("prod_ap_battery_types: PASSED");
}
