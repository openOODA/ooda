// # Product prove std/pbr_raytracing/sampling_cosine_hemisphere.oo
//
// Logline: Fail-closed emit+gcc+run asserts concentric_sample_disk is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/sampling_cosine_hemisphere.oo.
//
// Beats:
//   1. Call concentric_sample_disk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sampling_cosine_hemisphere: PASSED only if they match.

import "std/pbr_raytracing/sampling_cosine_hemisphere.oo";

pub fn main() {
    let sampling_cosine_hemisphere_mark: Int = 0;
    if sampling_cosine_hemisphere_mark != 0 {
        process_exit(1);
    }
    let a: DiskSample = concentric_sample_disk(0.0, 0.0);
    let b: DiskSample = concentric_sample_disk(0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL concentric_sample_disk");
        process_exit(1);
    }
    println("prod_g2_sampling_cosine_hemisphere: PASSED");
}
