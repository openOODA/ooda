// # Product prove std/defi_derivatives/perpetual_funding_rate_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts calc_instantaneous_premium is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_funding_rate_calc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call calc_instantaneous_premium twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_perpetual_funding_rate_calc: PASSED only if they match.

import "std/defi_derivatives/perpetual_funding_rate_calc.oo";

pub fn main() {
    let g0_a = calc_instantaneous_premium(1.0, 1.0);
    let g0_b = calc_instantaneous_premium(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL calc_instantaneous_premium");
        process_exit(1);
    }
    println("prod_g0_perpetual_funding_rate_calc: PASSED");
}
