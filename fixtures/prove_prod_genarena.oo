// # Product generational_arena prove
//
// Logline: Fail-closed emit+gcc+run of shipped gen_arena_insert/len/contains.
//
// Setup: Product std/collections/generational_arena.oo. List[Int] destub.
//
// Beats:
//   1. After insert 7, len 1; contains(0,1) true; contains(0,99) false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/generational_arena.oo";

pub fn main() {
    let mut a: GenerationalArena = gen_arena_new();
    a = gen_arena_insert(a, 7);
    let n: Int = gen_arena_len(a);
    if n != 1 {
        println("FAIL genarena len");
        process_exit(1);
    }
    let ok: Bool = gen_arena_contains(a, 0, 1);
    if ok == false {
        println("FAIL genarena contains");
        process_exit(1);
    }
    let no: Bool = gen_arena_contains(a, 0, 99);
    if no == true {
        println("FAIL genarena gen");
        process_exit(1);
    }
    println("prod_genarena: PASSED");
}
