// # Product prove std/pbr_raytracing/denoiser_temporal_reprojection.oo
//
// Logline: Fail-closed emit+gcc+run asserts temporal_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/denoiser_temporal_reprojection.oo.
//
// Beats:
//   1. Call temporal_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_denoiser_temporal_reprojection: PASSED only if they match.

import "std/pbr_raytracing/denoiser_temporal_reprojection.oo";

pub fn main() {
    let denoiser_temporal_reprojection_mark: Int = 0;
    if denoiser_temporal_reprojection_mark != 0 {
        process_exit(1);
    }
    let a: TemporalBlendParams = temporal_params_default();
    let b: TemporalBlendParams = temporal_params_default();
    if (a).max_history_length != (b).max_history_length {
        println("FAIL temporal_params_default");
        process_exit(1);
    }
    println("prod_g2_denoiser_temporal_reprojection: PASSED");
}
