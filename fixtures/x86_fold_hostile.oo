// # x86 greet-fold must not drop extra println
//
// Logline: Same greet shape as hello.oo plus println other.
//
// Setup: Backend-x86. Fold must miss; harvest or ERR.
//
// Beats:
//   1. greet is STRING + name + STRING.
//   2. main prints greet then other.
//   3. emit-x86 must not emit only the greet line.

pub fn greet(name: String) -> String {
    return "Hello, " + name + "!";
}

pub fn main() {
    let message = greet("openOODA Developer");
    println(message);
    println("other");
}
