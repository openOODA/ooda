// # Product prove std/digital_twin/twin_rom_proper_orthogonal_decomp.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_rom_proper_orthogonal_decomp_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_rom_proper_orthogonal_decomp.oo.
//
// Beats:
//   1. Call twin_rom_proper_orthogonal_decomp_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_twin_rom_proper_orthogonal_decomp: PASSED only if they match.

import "std/digital_twin/twin_rom_proper_orthogonal_decomp.oo";

pub fn main() {
    let a: Int = twin_rom_proper_orthogonal_decomp_probe();
    let b: Int = twin_rom_proper_orthogonal_decomp_probe();
    if a != b {
        println("FAIL twin_rom_proper_orthogonal_decomp_probe");
        process_exit(1);
    }
    println("prod_g2_twin_rom_proper_orthogonal_decomp: PASSED");
}
