import "std/sec/crypto/sha3_engine.oo";

pub fn main() {
    let sha3_engine_mark: Int = 0;
    if sha3_engine_mark != 0 { process_exit(1); }
    let a: Sha3SecurityPolicy = sha3_security_policy_default();
    let b: Sha3SecurityPolicy = sha3_security_policy_default();
    if a != b { process_exit(1); }
    println("prod_sha3_engine: PASSED");
}
