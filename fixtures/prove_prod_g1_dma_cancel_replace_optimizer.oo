// # Product prove std/fintech_l3_book/dma_cancel_replace_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts modify_tracker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_cancel_replace_optimizer.oo.
//
// Beats:
//   1. Call modify_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_cancel_replace_optimizer: PASSED only if they match.

import "std/fintech_l3_book/dma_cancel_replace_optimizer.oo";

pub fn main() {
    let a: ModifyTracker = modify_tracker_new();
    let b: ModifyTracker = modify_tracker_new();
    if a.total_modifications != 0 {
        println("FAIL modify_tracker_new");
        process_exit(1);
    }
    if a.total_modifications != b.total_modifications {
        println("FAIL modify_tracker_new");
        process_exit(1);
    }
    println("prod_dma_cancel_replace_optimizer: PASSED");
}
