// # Product prove std/fintech_l3_book/dma_order_routing_gateway.oo
//
// Logline: Fail-closed emit+gcc+run asserts gateway_session_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_order_routing_gateway.oo.
//
// Beats:
//   1. Call gateway_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_order_routing_gateway: PASSED only if they match.

import "std/fintech_l3_book/dma_order_routing_gateway.oo";

pub fn main() {
    let a: GatewaySession = gateway_session_new("x", "x");
    let b: GatewaySession = gateway_session_new("x", "x");
    if a.current_latency_ns != b.current_latency_ns {
        println("FAIL gateway_session_new");
        process_exit(1);
    }
    println("prod_dma_order_routing_gateway: PASSED");
}
