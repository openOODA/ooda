// # Product prove std/bioinformatics/fasta_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts fasta_parse_header_id is a real value.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/fasta_reader.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fasta_parse_header_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fasta_reader: PASSED only if they match.

import "std/bioinformatics/fasta_reader.oo";

pub fn main() {
    let g0_a = fasta_parse_header_id("x");
    let g0_b = fasta_parse_header_id("x");
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL fasta_parse_header_id");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL fasta_parse_header_id");
        process_exit(1);
    }
    println("prod_gr_fasta_reader: PASSED");
}
