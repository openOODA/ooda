// # Product prove std/bft_consensus/transaction_replay_cache.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/transaction_replay_cache.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/transaction_replay_cache.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_transaction_replay_cache: PASSED only if they match.

import "std/bft_consensus/transaction_replay_cache.oo";

pub fn main() {
    let transaction_replay_cache_a = account_nonce_entry_new("x", 0, 0);
    let transaction_replay_cache_b = account_nonce_entry_new("x", 0, 0);
    let transaction_replay_cache_va = account_nonce_is_valid(transaction_replay_cache_a, 0);
    let transaction_replay_cache_vb = account_nonce_is_valid(transaction_replay_cache_b, 0);
    if transaction_replay_cache_va != transaction_replay_cache_vb {
        println("FAIL transaction_replay_cache");
        process_exit(1);
    }
    println("prod_ap_transaction_replay_cache: PASSED");
}
