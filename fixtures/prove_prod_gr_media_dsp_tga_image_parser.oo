// # Product prove std/media_dsp/tga_image_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts tga_type_no_image is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/tga_image_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call tga_type_no_image twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_tga_image_parser: PASSED only if they match.

import "std/media_dsp/tga_image_parser.oo";

pub fn main() {
    let g0_a = tga_type_no_image();
    let g0_b = tga_type_no_image();
    if g0_a != g0_b {
        println("FAIL tga_type_no_image");
        process_exit(1);
    }
    println("prod_gr_tga_image_parser: PASSED");
}
