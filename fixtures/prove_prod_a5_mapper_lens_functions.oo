// # Product prove std/tda_topology/mapper_lens_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts lens_config_coordinate is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/mapper_lens_functions.oo.
//
// Beats:
//   1. Call lens_config_coordinate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mapper_lens_functions: PASSED only if they match.

import "std/tda_topology/mapper_lens_functions.oo";

pub fn main() {
    let mapper_lens_functions_mark: Int = 0;
    if mapper_lens_functions_mark != 0 {
        process_exit(1);
    }
    let a: LensConfig = lens_config_coordinate(0);
    let b: LensConfig = lens_config_coordinate(0);
    if (a).lens_type != (b).lens_type {
        println("FAIL lens_config_coordinate");
        process_exit(1);
    }
    println("prod_mapper_lens_functions: PASSED");
}
