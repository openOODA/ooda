// # Product prove std/ai_multimodal/linear_attention_performer.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_attention_performer_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/linear_attention_performer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call linear_attention_performer_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_linear_attention_performer: PASSED only if they match.

import "std/ai_multimodal/linear_attention_performer.oo";

pub fn main() {
    let g0_a = linear_attention_performer_marker();
    let g0_b = linear_attention_performer_marker();
    if g0_a != g0_b {
        println("FAIL linear_attention_performer_marker");
        process_exit(1);
    }
    println("prod_gr_linear_attention_performer: PASSED");
}
