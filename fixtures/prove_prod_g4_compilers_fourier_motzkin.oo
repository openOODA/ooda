// # Product prove std/compilers_polyhedral/fourier_motzkin_dependence.oo
//
// Logline: Fail-closed verification of Fourier-Motzkin affine loop dependence testing and distance vectors.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/fourier_motzkin_dependence.oo.
//
// Beats:
//   1. Construct dependence type and distance vectors.
//   2. Run test_affine_dependence_simple for RAW loop dependence.
//   3. Evaluate loop parallelism predicate and assert deterministic results.
//   4. Print prod_g4_compilers_fourier_motzkin: PASSED and exit 0.

import "std/compilers_polyhedral/fourier_motzkin_dependence.oo";

pub fn main() {
    let dt1: PolyhedralDependenceType = dependence_type_new(0, true, 1, 2);
    let dt2: PolyhedralDependenceType = dependence_type_new(0, true, 1, 2);

    let k1: Int = (dt1).dep_kind;
    let k2: Int = (dt2).dep_kind;
    if k1 != k2 || k1 != 0 {
        println("FAIL dependence_type dep_kind");
        process_exit(1);
    }

    let src1: Int = (dt1).source_stmt_id;
    let src2: Int = (dt2).source_stmt_id;
    if src1 != src2 || src1 != 1 {
        println("FAIL dependence_type source_stmt_id");
        process_exit(1);
    }

    let sink1: Int = (dt1).sink_stmt_id;
    let sink2: Int = (dt2).sink_stmt_id;
    if sink1 != sink2 || sink1 != 2 {
        println("FAIL dependence_type sink_stmt_id");
        process_exit(1);
    }

    let dv1: DependenceDistanceVector = distance_vector_new(2);
    let dv2: DependenceDistanceVector = distance_vector_new(2);
    let dv1_ext: DependenceDistanceVector = distance_vector_add_level(dv1, 1);
    let dv2_ext: DependenceDistanceVector = distance_vector_add_level(dv2, 1);

    let lvl1: Int = (dv1_ext).num_loop_levels;
    let lvl2: Int = (dv2_ext).num_loop_levels;
    if lvl1 != lvl2 || lvl1 != 2 {
        println("FAIL distance_vector num_loop_levels");
        process_exit(1);
    }

    let res1: PolyhedralDependenceResult = test_affine_dependence_simple(1, 2, 0, 0, 4, 2);
    let res2: PolyhedralDependenceResult = test_affine_dependence_simple(1, 2, 0, 0, 4, 2);

    let has_dep1: Bool = (res1).has_dependence;
    let has_dep2: Bool = (res2).has_dependence;
    if has_dep1 != has_dep2 || !has_dep1 {
        println("FAIL test_affine_dependence_simple has_dependence");
        process_exit(1);
    }

    let conf1: Int = (res1).confidence_level;
    let conf2: Int = (res2).confidence_level;
    if conf1 != conf2 || conf1 != 100 {
        println("FAIL test_affine_dependence_simple confidence");
        process_exit(1);
    }

    let is_par1: Bool = dependence_is_parallel_loop(res1);
    let is_par2: Bool = dependence_is_parallel_loop(res2);
    if is_par1 != is_par2 || is_par1 {
        println("FAIL dependence_is_parallel_loop");
        process_exit(1);
    }

    println("prod_g4_compilers_fourier_motzkin: PASSED");
    process_exit(0);
}
