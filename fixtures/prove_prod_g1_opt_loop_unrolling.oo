// # Product prove std/compilers_vm/opt_loop_unrolling.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_trip_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_loop_unrolling.oo.
//
// Beats:
//   1. Call compute_trip_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opt_loop_unrolling: PASSED only if they match.

import "std/compilers_vm/opt_loop_unrolling.oo";

pub fn main() {
    let obj_a: InductionVar = induction_var_new("x", 0, 0, 0, 0);
    let obj_b: InductionVar = induction_var_new("x", 0, 0, 0, 0);
    let a: Int = compute_trip_count(obj_a);
    let b: Int = compute_trip_count(obj_b);
    if a != b {
        println("FAIL compute_trip_count");
        process_exit(1);
    }
    println("prod_opt_loop_unrolling: PASSED");
}
