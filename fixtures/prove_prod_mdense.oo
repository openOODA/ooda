// # Product matrix_dense prove
import "std/collections/matrix_dense.oo";
pub fn main() {
    let mut m: DenseMatrix = dense_matrix_new(2, 2);
    m = dense_matrix_set(m, 0, 0, 7);
    let v: Int = dense_matrix_get(m, 0, 0);
    if v != 7 {
        println("FAIL mdense get");
        process_exit(1);
    }
    let z: Int = dense_matrix_get(m, 1, 1);
    if z != 0 {
        println("FAIL mdense zero");
        process_exit(1);
    }
    println("prod_mdense: PASSED");
}
