// # Product prove std/sec/sys/objcap.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_seal_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap.oo.
//
// Beats:
//   1. Call shim_marker_seal_checksum twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap: PASSED only if they match.

import "std/sec/sys/objcap.oo";

pub fn main() {
    let objcap_mark: Int = 0;
    if objcap_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_seal_checksum();
    let b: Int = shim_marker_seal_checksum();
    if a != b { process_exit(1); }
    println("prod_objcap: PASSED");
}
