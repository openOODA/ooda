// # Product prove std/ai_ml/metric_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts mse_loss is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/metric_loss.oo.
//
// Beats:
//   1. Call mse_loss twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metric_loss: PASSED only if they match.

import "std/ai_ml/metric_loss.oo";

pub fn main() {
    let a = mse_loss(0, 0);
    let b = mse_loss(0, 0);
    if a != b {
        println("FAIL mse_loss");
        process_exit(1);
    }
    println("prod_metric_loss: PASSED");
}
