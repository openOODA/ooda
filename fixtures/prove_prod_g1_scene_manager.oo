// # Product prove std/game_engine/scene_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts scene_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/scene_manager.oo.
//
// Beats:
//   1. Call scene_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_scene_manager: PASSED only if they match.

import "std/game_engine/scene_manager.oo";

pub fn main() {
    let a: SceneManager = scene_manager_new(0);
    let b: SceneManager = scene_manager_new(0);
    if a.current_scene_id != b.current_scene_id {
        println("FAIL scene_manager_new");
        process_exit(1);
    }
    println("prod_scene_manager: PASSED");
}
