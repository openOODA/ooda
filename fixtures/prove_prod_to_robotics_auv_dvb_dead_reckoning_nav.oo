// # Product prove std/robotics_auv/dvb_dead_reckoning_nav.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvl_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/dvb_dead_reckoning_nav.oo.
//
// Beats:
//   1. Call dvl_config_default using the dvb_dead_reckoning_nav ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_dvb_dead_reckoning_nav: PASSED only if asserts hold.

import "std/robotics_auv/dvb_dead_reckoning_nav.oo";

pub fn main() {
    let obj = dvl_config_default();
    let dvb_dead_reckoning_nav_a = obj.carrier_frequency_hz;
    if dvb_dead_reckoning_nav_a != 600000.0 {
        println("FAIL dvl_config_default");
        process_exit(1);
    }
    println("prod_dvb_dead_reckoning_nav: PASSED");
}
