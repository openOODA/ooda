// # Product prove std/tda_topology/persistence_diagram_features.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistence_diagram_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_diagram_features.oo.
//
// Beats:
//   1. Call persistence_diagram_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistence_diagram_features: PASSED only if they match.

import "std/tda_topology/persistence_diagram_features.oo";

pub fn main() {
    let persistence_diagram_features_mark: Int = 0;
    if persistence_diagram_features_mark != 0 {
        process_exit(1);
    }
    let persistence_diagram_features_a = persistence_diagram_new(1);
    let persistence_diagram_features_b = persistence_diagram_new(1);
    if (persistence_diagram_features_a).point_count != (persistence_diagram_features_b).point_count {
        println("FAIL persistence_diagram_new");
        process_exit(1);
    }
    println("prod_persistence_diagram_features: PASSED");
}
