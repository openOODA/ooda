// # Product prove std/robotics_ros2/urdf_robot_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts urdf_robot_model_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/urdf_robot_model.oo.
//
// Beats:
//   1. Call urdf_robot_model_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_urdf_robot_model: PASSED only if they match.

import "std/robotics_ros2/urdf_robot_model.oo";

pub fn main() {
    let a: UrdfRobotModel = urdf_robot_model_new(0);
    let b: UrdfRobotModel = urdf_robot_model_new(0);
    if (a).model_id != (b).model_id {
        println("FAIL urdf_robot_model_new");
        process_exit(1);
    }
    println("prod_g2_urdf_robot_model: PASSED");
}
