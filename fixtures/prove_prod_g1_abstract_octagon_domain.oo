// # Product prove std/formal_verif/abstract_octagon_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts octagon_matrix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_octagon_domain.oo.
//
// Beats:
//   1. Call octagon_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_abstract_octagon_domain: PASSED only if they match.

import "std/formal_verif/abstract_octagon_domain.oo";

pub fn main() {
    let a: OctagonMatrix = octagon_matrix_new(0);
    let b: OctagonMatrix = octagon_matrix_new(0);
    if a.dimension != b.dimension {
        println("FAIL octagon_matrix_new");
        process_exit(1);
    }
    println("prod_abstract_octagon_domain: PASSED");
}
