// # Product prove std/compilers_vm/regalloc_chaitin_briggs.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_assignment_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_chaitin_briggs.oo.
//
// Beats:
//   1. Call color_assignment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_regalloc_chaitin_briggs: PASSED only if they match.

import "std/compilers_vm/regalloc_chaitin_briggs.oo";

pub fn main() {
    let regalloc_chaitin_briggs_mark: Int = 0;
    if regalloc_chaitin_briggs_mark != 0 {
        process_exit(1);
    }
    let a: ColorAssignment = color_assignment_new(0, 0, 0);
    let b: ColorAssignment = color_assignment_new(0, 0, 0);
    if (a).var_id != (b).var_id {
        println("FAIL color_assignment_new");
        process_exit(1);
    }
    println("prod_g2_regalloc_chaitin_briggs: PASSED");
}
