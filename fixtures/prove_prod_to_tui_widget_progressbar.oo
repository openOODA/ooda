// # Product prove std/tui/widget_progressbar.oo
//
// Logline: Fail-closed emit+gcc+run asserts widget_progressbar_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/widget_progressbar.oo.
//
// Beats:
//   1. Call widget_progressbar_new using the widget_progressbar ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_widget_progressbar: PASSED only if asserts hold.

import "std/tui/widget_progressbar.oo";
import "std/tui/tui_buffer.oo";

pub fn main() {
    let arg1 = buffer_area_new(0, 0, 8, 8);
    let obj = widget_progressbar_new(8, arg1);
    let widget_progressbar_a = obj.id;
    if widget_progressbar_a != 8 {
        println("FAIL widget_progressbar_new");
        process_exit(1);
    }
    println("prod_widget_progressbar: PASSED");
}
