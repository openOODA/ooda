// # Product prove std/multimedia/jpeg_quantization.oo
//
// Logline: Fail-closed emit+gcc+run asserts jpeg_zigzag_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/jpeg_quantization.oo.
//
// Beats:
//   1. Call jpeg_zigzag_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jpeg_quantization: PASSED only if they match.

import "std/multimedia/jpeg_quantization.oo";

pub fn main() {
    let jpeg_quantization_mark: Int = 0;
    if jpeg_quantization_mark != 0 {
        process_exit(1);
    }
    let jpeg_quantization_a: Int = jpeg_zigzag_index(1);
    let jpeg_quantization_b: Int = jpeg_zigzag_index(1);
    if jpeg_quantization_a != jpeg_quantization_b {
        println("FAIL jpeg_zigzag_index");
        process_exit(1);
    }
    println("prod_jpeg_quantization: PASSED");
}
