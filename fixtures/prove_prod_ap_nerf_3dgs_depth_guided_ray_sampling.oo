// # Product prove std/nerf_3dgs/depth_guided_ray_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/nerf_3dgs/depth_guided_ray_sampling.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/depth_guided_ray_sampling.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_depth_guided_ray_sampling: PASSED only if they match.

import "std/nerf_3dgs/depth_guided_ray_sampling.oo";

pub fn main() {
    let depth_guided_ray_sampling_a = sample_gaussian_depth(0.0, 0.0, 0.0);
    let depth_guided_ray_sampling_b = sample_gaussian_depth(0.0, 0.0, 0.0);
    if depth_guided_ray_sampling_a != depth_guided_ray_sampling_b {
        println("FAIL depth_guided_ray_sampling");
        process_exit(1);
    }
    println("prod_ap_depth_guided_ray_sampling: PASSED");
}
