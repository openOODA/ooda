// # Product prove std/security_defense/pointer_authentication_pac.oo
//
// Logline: Fail-closed emit+gcc+run asserts pac_compute_tag is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/pointer_authentication_pac.oo.
//
// Beats:
//   1. Call pac_compute_tag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pointer_authentication_pac: PASSED only if they match.

import "std/security_defense/pointer_authentication_pac.oo";

pub fn main() {
    let pointer_authentication_pac_mark: Int = 0;
    if pointer_authentication_pac_mark != 0 {
        process_exit(1);
    }
    let pointer_authentication_pac_obj: PacKey = pac_key_new(1, 1, 1);
    let pointer_authentication_pac_a: Int = pac_compute_tag(&pointer_authentication_pac_obj, 1, 1);
    let pointer_authentication_pac_b: Int = pac_compute_tag(&pointer_authentication_pac_obj, 1, 1);
    if pointer_authentication_pac_a != pointer_authentication_pac_b {
        println("FAIL pac_compute_tag");
        process_exit(1);
    }
    println("prod_pointer_authentication_pac: PASSED");
}
