// # Product prove std/compilers_vm/codegen_instruction_selection.oo
//
// Logline: Fail-closed emit+gcc+run asserts ir_pattern_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/codegen_instruction_selection.oo.
//
// Beats:
//   1. Call ir_pattern_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_codegen_instruction_selection: PASSED only if they match.

import "std/compilers_vm/codegen_instruction_selection.oo";

pub fn main() {
    let a: IrTreePattern = ir_pattern_new(0, 0, 0, 0, 0, 0, 0, "x");
    let b: IrTreePattern = ir_pattern_new(0, 0, 0, 0, 0, 0, 0, "x");
    if a.pattern_id != b.pattern_id {
        println("FAIL ir_pattern_new");
        process_exit(1);
    }
    println("prod_codegen_instruction_selection: PASSED");
}
