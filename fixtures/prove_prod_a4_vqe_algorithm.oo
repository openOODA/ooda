// # Product prove std/quantum/vqe_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts vqe_compute_energy_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/vqe_algorithm.oo.
//
// Beats:
//   1. Call vqe_compute_energy_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vqe_algorithm: PASSED only if they match.

import "std/quantum/vqe_algorithm.oo";

pub fn main() {
    let vqe_algorithm_mark: Int = 0;
    if vqe_algorithm_mark != 0 {
        process_exit(1);
    }
    let a: Int = vqe_compute_energy_milli(0, 0, 0, 0);
    let b: Int = vqe_compute_energy_milli(0, 0, 0, 0);
    if a != b {
        println("FAIL vqe_compute_energy_milli");
        process_exit(1);
    }
    println("prod_vqe_algorithm: PASSED");
}
