// # Product template interpolate prove
//
// Logline: Fail-closed emit+gcc+run of shipped template_substitute.
//
// Setup: Product std/text/template_interpolate.oo. ${name} replacement.
//
// Beats:
//   1. hi ${name} with name=ada is hi ada.
//   2. template_has_variable is true for name.
//   3. Exit 1 before PASSED on a miss.

import "std/text/template_interpolate.oo";

pub fn main() {
    let s: String = template_substitute("hi ${name}", "name", "ada");
    if s != "hi ada" {
        println("FAIL tpl");
        process_exit(1);
    }
    let has: Bool = template_has_variable("hi ${name}", "name");
    if has == false {
        println("FAIL has");
        process_exit(1);
    }
    println("prod_tpl: PASSED");
}
