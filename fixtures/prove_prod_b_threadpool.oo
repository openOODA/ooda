// # Product prove std/sync/threadpool.oo
//
// Logline: Fail-closed emit+gcc+run asserts threadpool_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/threadpool.oo.
//
// Beats:
//   1. Call threadpool_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_threadpool: PASSED only if they match.

import "std/sync/threadpool.oo";

pub fn main() {
    let a = threadpool_probe();
    let b = threadpool_probe();
    if a != b {
        println("FAIL threadpool_probe");
        process_exit(1);
    }
    println("prod_threadpool: PASSED");
}
