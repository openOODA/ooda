// # Product prove std/compilers_polyhedral/scratchpad_buffer_allocation.oo
//
// Logline: Fail-closed emit+gcc+run asserts scratchpad_can_fit is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/scratchpad_buffer_allocation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call scratchpad_can_fit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_scratchpad_buffer_allocation: PASSED only if they match.

import "std/compilers_polyhedral/scratchpad_buffer_allocation.oo";

pub fn main() {
    let g0_oa = scratchpad_buffer_new(2, 2, 8, 2);
    let g0_ob = scratchpad_buffer_new(2, 2, 8, 2);
    let g0_a = scratchpad_can_fit(g0_oa, 2);
    let g0_b = scratchpad_can_fit(g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL scratchpad_can_fit");
        process_exit(1);
    }
    println("prod_g0_scratchpad_buffer_allocation: PASSED");
}
