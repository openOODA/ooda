// # Product prove std/astrodynamics/sidereal_time.oo
//
// Logline: Fail-closed emit+gcc+run asserts sidereal_day_s is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/sidereal_time.oo.
//
// Beats:
//   1. Call sidereal_day_s twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sidereal_time: PASSED only if they match.

import "std/astrodynamics/sidereal_time.oo";

pub fn main() {
    let sidereal_time_mark: Int = 0;
    if sidereal_time_mark != 0 {
        process_exit(1);
    }
    let a: Int = sidereal_day_s();
    let b: Int = sidereal_day_s();
    if a != b {
        println("FAIL sidereal_day_s");
        process_exit(1);
    }
    println("prod_sidereal_time: PASSED");
}
