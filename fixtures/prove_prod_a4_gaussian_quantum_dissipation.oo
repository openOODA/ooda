// # Product prove std/quantum_open_systems/gaussian_quantum_dissipation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian_state_vacuum is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/gaussian_quantum_dissipation.oo.
//
// Beats:
//   1. Call gaussian_state_vacuum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gaussian_quantum_dissipation: PASSED only if they match.

import "std/quantum_open_systems/gaussian_quantum_dissipation.oo";

pub fn main() {
    let gaussian_quantum_dissipation_mark: Int = 0;
    if gaussian_quantum_dissipation_mark != 0 {
        process_exit(1);
    }
    let a: GaussianState1Mode = gaussian_state_vacuum();
    let b: GaussianState1Mode = gaussian_state_vacuum();
    if (a).mean_x != (b).mean_x {
        println("FAIL gaussian_state_vacuum");
        process_exit(1);
    }
    println("prod_gaussian_quantum_dissipation: PASSED");
}
