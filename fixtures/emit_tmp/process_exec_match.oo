// # process_exec match scrutinee
//
// Logline: Match process_exec of true and print ok on the Ok arm.
//
// Setup: Backend-C emit fixture. process is the ambient ProcessCap. The call must lower to oo_sys_exec.
//
// Beats:
//   1. Call process_exec with true.
//   2. Match Ok and Err.
//   3. Print ok on success.

pub fn main(p: &ProcessCap) {
    match process_exec(p, "true") {
        Ok(s) => println("ok"),
        Err(e) => println(e),
    }
}
