// # Unnamed string concat
//
// Logline: Concat two named strings in println and bind a three-part concat then print it.
//
// Setup: Backend-C emit fixture. String + must bind a temp and still print hello.
//
// Beats:
//   1. Bind a and b.
//   2. Print a + b.
//   3. Bind s from a + b + ! and print s.

pub fn main() {
    let a = "he";
    let b = "llo";
    println(a + b);
    let s = a + b + "!";
    println(s);
}
