// # If else on a list field
//
// Logline: Branch on list_get of a one-string list and print A when it is KW_FN.
//
// Setup: Backend-C emit fixture. list_new, list_push, list_get, String compare.
//
// Beats:
//   1. Push KW_FN onto xs.
//   2. Compare list_get(xs, 0) to KW_FN.
//   3. Print A on the true arm and B on the else.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "KW_FN");
    if list_get(xs, 0) == "KW_FN" {
        println("A");
    } else {
        println("B");
    }
}
