// # While list_get condition
//
// Logline: Walk a string list while list_get equals X and print the increment count.
//
// Setup: Backend-C emit fixture. Three X items then END.
//
// Beats:
//   1. Push X three times and END.
//   2. While list_get(xs, i) == X, increment i.
//   3. Print i so the count is 3.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "X");
    xs = list_push(xs, "X");
    xs = list_push(xs, "X");
    xs = list_push(xs, "END");
    let mut i = 0;
    while list_get(xs, i) == "X" {
        i = i + 1;
    }
    println(i);
}
