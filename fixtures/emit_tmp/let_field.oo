// # Let bind list_get
//
// Logline: Bind list_get of a one-string list and print that String.
//
// Setup: Backend-C emit fixture. let s = list_get(xs, 0).
//
// Beats:
//   1. Push one string onto xs.
//   2. Bind s from list_get at 0.
//   3. Print s.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    let s = list_get(xs, 0);
    println(s);
}
