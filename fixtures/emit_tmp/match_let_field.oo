// # Match-let owns a list_get arm
//
// Logline: Bind a Result and take list_get on the Ok arm into a named String.
//
// Setup: Backend-C emit fixture. Ok payload is unused; arm expr is list_get.
//
// Beats:
//   1. Push hi onto xs.
//   2. Match Ok and bind s from list_get.
//   3. Print s.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "hi");
    let r: Result[String, String] = Ok("x");
    let s = match r {
        Ok(x) => list_get(xs, 0),
        Err(e) => e,
    };
    println(s);
}
