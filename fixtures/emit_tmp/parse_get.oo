// # Print list_len as string
//
// Logline: Bind list_len of a two-string list and print n.to_string.
//
// Setup: Backend-C emit fixture. parse_int is skipped; list_len plus to_string.
//
// Beats:
//   1. Push two strings onto xs.
//   2. Bind n from list_len(xs).
//   3. Print n.to_string.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    let n = list_len(xs);
    println(n.to_string());
}
