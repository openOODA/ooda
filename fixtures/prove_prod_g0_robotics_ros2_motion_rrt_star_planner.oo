// # Product prove std/robotics_ros2/motion_rrt_star_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts rrt_distance is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_rrt_star_planner.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rrt_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_motion_rrt_star_planner: PASSED only if they match.

import "std/robotics_ros2/motion_rrt_star_planner.oo";

pub fn main() {
    let g0_a = rrt_distance(1.0, 1.0, 1.0, 1.0);
    let g0_b = rrt_distance(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL rrt_distance");
        process_exit(1);
    }
    println("prod_g0_motion_rrt_star_planner: PASSED");
}
