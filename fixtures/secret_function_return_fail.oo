// # Refuse a tagged maker at println
//
// Logline: A SECRET-tagged callee taints the call result used at a sink.
//
// Beats:
//   1. Tag make_secret at line start.
//   2. Bind y to that call.
//   3. Print y so the sink refuses.

// T1 function return taint: SECRET-tagged callee; call result used at sink
// SECRET: make_secret
pub fn make_secret() -> String {
    return "token";
}
pub fn main() {
    let y = make_secret();
    println(y);
}
