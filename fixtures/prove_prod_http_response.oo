// # Product prove std/net/http_response.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_response_reason is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http_response.oo.
//
// Beats:
//   1. Call http_response_reason twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http_response: PASSED only if they match.

import "std/net/http_response.oo";

pub fn main() {
    let a = http_response_reason(0);
    let b = http_response_reason(0);
    if a != b {
        println("FAIL http_response_reason");
        process_exit(1);
    }
    println("prod_http_response: PASSED");
}
