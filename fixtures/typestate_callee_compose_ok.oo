// # Compose actually once
//
// Logline: Call actually once inside wrap so the Sock is Open and send is legal.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Call actually once from wrap.
//   3. Send after wrap.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn actually: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

fn wrap(s: Int) {
    actually(s);
}

pub fn main() {
    let s = open_sock();
    wrap(s);
    send(s);
}
