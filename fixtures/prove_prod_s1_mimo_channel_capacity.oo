// # Product prove std/telecom_5g/mimo_channel_capacity.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_shannon_siso_bps_hz is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_channel_capacity.oo.
//
// Beats:
//   1. Call mimo_shannon_siso_bps_hz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimo_channel_capacity: PASSED only if they match.

import "std/telecom_5g/mimo_channel_capacity.oo";

pub fn main() {
    let mimo_channel_capacity_mark: Int = 0;
    if mimo_channel_capacity_mark != 0 {
        process_exit(1);
    }
    let mimo_channel_capacity_a: Float = mimo_shannon_siso_bps_hz(1.0);
    let mimo_channel_capacity_b: Float = mimo_shannon_siso_bps_hz(1.0);
    if mimo_channel_capacity_a != mimo_channel_capacity_b {
        println("FAIL mimo_shannon_siso_bps_hz");
        process_exit(1);
    }
    println("prod_mimo_channel_capacity: PASSED");
}
