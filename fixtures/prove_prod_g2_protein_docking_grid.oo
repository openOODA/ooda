// # Product prove std/bio_advanced/protein_docking_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts docking_lennard_jones_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_docking_grid.oo.
//
// Beats:
//   1. Call docking_lennard_jones_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_protein_docking_grid: PASSED only if they match.

import "std/bio_advanced/protein_docking_grid.oo";

pub fn main() {
    let protein_docking_grid_mark: Int = 0;
    if protein_docking_grid_mark != 0 {
        process_exit(1);
    }
    let a: Float = docking_lennard_jones_energy(0.0, 0.0, 0.0);
    let b: Float = docking_lennard_jones_energy(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL docking_lennard_jones_energy");
        process_exit(1);
    }
    println("prod_g2_protein_docking_grid: PASSED");
}
