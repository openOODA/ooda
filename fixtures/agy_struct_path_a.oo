// M168 path A: user struct typedef emit + field access/assign + param field shadow
// residual: List[Struct] nested not product; &mut T not product (by-value mut)
type Box = struct {
    b: Int,
};
type Cell = struct {
    v: Int,
};
type Tree = struct {
    nodes: List[Int],
};
// AGY: param name shadows field name — (b).b must typecheck/emit
pub fn get_b(b: Box) -> Int {
    return (b).b;
}
pub fn bump(c: Cell) -> Cell {
    let mut m = c;
    m.v = m.v + 1;
    return m;
}
pub fn tree_len(t: Tree) -> Int {
    return list_len(t.nodes);
}
pub fn main() {
    let x = Box { b: 7 };
    println(get_b(x));
    let mut c = Cell { v: 10 };
    c = bump(c);
    println(c.v);
    let mut xs = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    let t = Tree { nodes: xs };
    println(tree_len(t));
}
