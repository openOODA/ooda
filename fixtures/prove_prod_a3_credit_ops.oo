// # Product prove std/fin/credit_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts credit_facility_calculate_dscr is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_ops.oo.
//
// Beats:
//   1. Call credit_facility_calculate_dscr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_credit_ops: PASSED only if they match.

import "std/fin/credit_ops.oo";

pub fn main() {
    let credit_ops_mark: Int = 0;
    if credit_ops_mark != 0 {
        process_exit(1);
    }
    let a: Float = credit_facility_calculate_dscr(0.0, 0.0);
    let b: Float = credit_facility_calculate_dscr(0.0, 0.0);
    if a != b {
        println("FAIL credit_facility_calculate_dscr");
        process_exit(1);
    }
    println("prod_credit_ops: PASSED");
}
