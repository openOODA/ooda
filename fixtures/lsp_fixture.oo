// # Native LSP Server Engine Fixture
//
// Logline: Exercises LSP initialization, JSON-RPC framing, completion, hover, and diagnostic publishing.
//
// Setup: Imports lsp/lsp.oo subsystem and exercises protocol lifecycles.
//
// Beats:
//   1. Initialize LSP server state and verify protocol capabilities negotiation.
//   2. Verify JSON-RPC 2.0 framing and Content-Length encoding.
//   3. Verify autocomplete suggestions for capabilities and keywords.
//   4. Verify hover documentation resolution and diagnostic publishing.

import "lsp/lsp.oo";

pub fn run_lsp_fixture_checks() -> Int {
    let state: LspServerState = lsp_engine_init();
    if state.is_initialized {
        return 1;
    }

    let init_req: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///workspace\"}}";
    let init_resp: String = lsp_process_message(init_req);
    if lsp_str_starts_with(init_resp, "Content-Length: ") == false {
        return 2;
    }

    let raw_payload: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"status\":\"ok\"}}";
    let framed: String = lsp_frame_message(raw_payload);
    if chars_len(framed) == 0 {
        return 3;
    }

    let mut comp_items: List[String] = list_new();
    comp_items = lsp_completion_resolve("&Fs");
    if list_len(comp_items) < 3 {
        return 4;
    }

    let mut kw_items: List[String] = list_new();
    kw_items = lsp_completion_resolve("fn");
    if list_len(kw_items) < 1 {
        return 5;
    }

    let h_fs: LspHover = lsp_hover_resolve("FsCap", 1, 1);
    if chars_len(h_fs.contents) == 0 {
        return 6;
    }
    let h_print: LspHover = lsp_hover_resolve("println", 2, 1);
    if chars_len(h_print.contents) == 0 {
        return 7;
    }

    let err_str: String = "ERR\ttype\tType error at 12:4: type mismatch";
    let mut diags: List[String] = list_new();
    diags = lsp_parse_compiler_output(err_str);
    if list_len(diags) != 1 {
        return 8;
    }

    return 0;
}

pub fn main() {
    println(run_lsp_fixture_checks());
}
