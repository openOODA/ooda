// # Product URL percent-encode prove
//
// Logline: RFC 3986 unreserved stays literal; component space is %20.
//
// Setup: Product std/encoding/url_encode.oo. Destub none. No caps.
//
// Beats:
//   1. url_is_unreserved("A") is true (ALPHA).
//   2. url_encode("a") equals "a" (unreserved).
//   3. url_encode("hello world") equals hello%20world (space 0x20).
//   4. Miss process_exit(1) before PASSED.

import "std/encoding/url_encode.oo";

pub fn main() {
    if !url_is_unreserved("A") {
        println("FAIL url_is_unreserved A");
        process_exit(1);
    }
    let a: String = url_encode("a");
    if a != "a" {
        println("FAIL url_encode a");
        process_exit(1);
    }
    let hw: String = url_encode("hello world");
    if hw != "hello%20world" {
        println("FAIL url_encode hello world");
        process_exit(1);
    }
    println("prod_url: PASSED");
}
