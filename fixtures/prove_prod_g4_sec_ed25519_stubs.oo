// # Product prove std/sec/crypto/ed25519_stubs.oo
//
// Logline: Fail-closed verification that Ed25519 stubs, marker routines, and key constructors are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519_stubs.oo.
//
// Beats:
//   1. Call ed25519_stubs_marker and __dummy_std_src_ooda_sec_crypto_ed25519_stubs_oo.
//   2. Create and validate Ed25519PublicKey and Ed25519SecretKey.
//   3. Create and validate Ed25519Signature.
//   4. Print prod_g4_sec_ed25519_stubs: PASSED and exit 0.

import "std/sec/crypto/ed25519_stubs.oo";

pub fn main() {
    let m_a: Int = ed25519_stubs_marker();
    let m_b: Int = ed25519_stubs_marker();
    if m_a != m_b || m_a != 1 {
        println("FAIL ed25519_stubs_marker");
        process_exit(1);
    }

    let dummy_a: Int = __dummy_std_src_ooda_sec_crypto_ed25519_stubs_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_crypto_ed25519_stubs_oo();
    if dummy_a != dummy_b || dummy_a != 0 {
        println("FAIL ed25519 dummy");
        process_exit(1);
    }

    let key_32: String = "01234567890123456789012345678901";
    let pk_res: Result[Ed25519PublicKey, String] = ed25519_public_key_create("pk_01", key_32);
    let pk_ok: Bool = pk_res.is_ok();
    if !pk_ok {
        println("FAIL ed25519_public_key_create");
        process_exit(1);
    }

    let sk_res: Result[Ed25519SecretKey, String] = ed25519_secret_key_create("sk_01", key_32);
    let sk_ok: Bool = sk_res.is_ok();
    if !sk_ok {
        println("FAIL ed25519_secret_key_create");
        process_exit(1);
    }

    let sig_res: Result[Ed25519Signature, String] = ed25519_signature_create("sig_01", "pk_01", key_32, key_32, 100);
    let sig_ok: Bool = sig_res.is_ok();
    if !sig_ok {
        println("FAIL ed25519_signature_create");
        process_exit(1);
    }

    println("prod_g4_sec_ed25519_stubs: PASSED");
    process_exit(0);
}
