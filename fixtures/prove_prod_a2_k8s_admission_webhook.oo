// # Product prove std/cloud_k8s/k8s_admission_webhook.oo
//
// Logline: Fail-closed emit+gcc+run asserts admission_response_allow is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/k8s_admission_webhook.oo.
//
// Beats:
//   1. Call admission_response_allow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_k8s_admission_webhook: PASSED only if they match.

import "std/cloud_k8s/k8s_admission_webhook.oo";

pub fn main() {
    let k8s_admission_webhook_mark: Int = 0;
    if k8s_admission_webhook_mark != 0 {
        process_exit(1);
    }
    let a: AdmissionResponse = admission_response_allow("x");
    let b: AdmissionResponse = admission_response_allow("x");
    if (a).status_code != (b).status_code {
        println("FAIL admission_response_allow");
        process_exit(1);
    }
    println("prod_k8s_admission_webhook: PASSED");
}
