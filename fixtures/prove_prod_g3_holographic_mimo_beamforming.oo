// # Product prove std/telecom_6g/holographic_mimo_beamforming.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmimo_calc_wavelength_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/holographic_mimo_beamforming.oo.
//
// Beats:
//   1. Call hmimo_calc_wavelength_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_holographic_mimo_beamforming: PASSED only if they match.

import "std/telecom_6g/holographic_mimo_beamforming.oo";

pub fn main() {
    let holographic_mimo_beamforming_mark: Int = 0;
    if holographic_mimo_beamforming_mark != 0 {
        process_exit(1);
    }
    let a: Float = hmimo_calc_wavelength_m(0.0);
    let b: Float = hmimo_calc_wavelength_m(0.0);
    if a != b {
        println("FAIL hmimo_calc_wavelength_m");
        process_exit(1);
    }
    println("prod_holographic_mimo_beamforming: PASSED");
}
