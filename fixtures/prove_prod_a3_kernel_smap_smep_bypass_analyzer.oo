// # Product prove std/exploit_analysis/kernel_smap_smep_bypass_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts cr4_parse_flags is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/kernel_smap_smep_bypass_analyzer.oo.
//
// Beats:
//   1. Call cr4_parse_flags twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_smap_smep_bypass_analyzer: PASSED only if they match.

import "std/exploit_analysis/kernel_smap_smep_bypass_analyzer.oo";

pub fn main() {
    let kernel_smap_smep_bypass_analyzer_mark: Int = 0;
    if kernel_smap_smep_bypass_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: Cr4RegisterFlags = cr4_parse_flags(0);
    let b: Cr4RegisterFlags = cr4_parse_flags(0);
    if (a).raw_cr4_value != (b).raw_cr4_value {
        println("FAIL cr4_parse_flags");
        process_exit(1);
    }
    println("prod_kernel_smap_smep_bypass_analyzer: PASSED");
}
