// # Product prove std/formal_verif/relying_guarantee_concurrency.oo
//
// Logline: Fail-closed emit+gcc+run asserts rely_guarantee_spec_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/relying_guarantee_concurrency.oo.
//
// Beats:
//   1. Call rely_guarantee_spec_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_relying_guarantee_concurrency: PASSED only if they match.

import "std/formal_verif/relying_guarantee_concurrency.oo";

pub fn main() {
    let relying_guarantee_concurrency_mark: Int = 0;
    if relying_guarantee_concurrency_mark != 0 {
        process_exit(1);
    }
    let a: RelyGuaranteeSpec = rely_guarantee_spec_new(0, "x", "x", "x", "x");
    let b: RelyGuaranteeSpec = rely_guarantee_spec_new(0, "x", "x", "x", "x");
    if (a).thread_id != (b).thread_id {
        println("FAIL rely_guarantee_spec_new");
        process_exit(1);
    }
    println("prod_g2_relying_guarantee_concurrency: PASSED");
}
