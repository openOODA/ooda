// # Product buf_reader_delim prove
//
// Logline: Fail-closed emit+gcc+run of shipped buf_reader_read_until.
//
// Setup: Product std/io/buf_reader_delim.oo. "a,b" delim comma.
//
// Beats:
//   1. First record is a; matched_delim true.
//   2. Exit 1 before PASSED on a miss.

import "std/io/buf_reader_delim.oo";

pub fn main() {
    let r: BufReaderDelim = buf_reader_delim_new("a,b");
    let res: DelimReadResult = buf_reader_read_until(r, ",");
    let line: String = res.line;
    if line != "a" {
        println("FAIL delim line");
        process_exit(1);
    }
    let m: Bool = res.matched_delim;
    if m == false {
        println("FAIL delim match");
        process_exit(1);
    }
    println("prod_delim: PASSED");
}
