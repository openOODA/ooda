// # Product prove std/compilers_polyhedral/autovec_widening_narrowing.oo
//
// Logline: Fail-closed emit+gcc+run asserts get_saturating_max_val is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_widening_narrowing.oo.
//
// Beats:
//   1. Call get_saturating_max_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_widening_narrowing: PASSED only if they match.

import "std/compilers_polyhedral/autovec_widening_narrowing.oo";

pub fn main() {
    let autovec_widening_narrowing_mark: Int = 0;
    if autovec_widening_narrowing_mark != 0 {
        process_exit(1);
    }
    let a: Int = get_saturating_max_val(0, 0);
    let b: Int = get_saturating_max_val(0, 0);
    if a != b {
        println("FAIL get_saturating_max_val");
        process_exit(1);
    }
    println("prod_autovec_widening_narrowing: PASSED");
}
