// # Struct has no such field
//
// Logline: Check refuses p.nope on Point { x: Int }.
//
// Setup: Single-file probe. Line of the bad field stays under 50.
//
// Beats:
//   1. Define Point with x: Int.
//   2. Bind p as Point { x: 1 }.
//   3. check must ERR type has no field.

type Point = struct {
    x: Int
};

pub fn main() {
    let p = Point { x: 1 };
    println(p.nope);
}
