// # Product prove std/web_protocols/openapi_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts openapi_doc_path_n is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/openapi_schema.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call openapi_doc_path_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_openapi_schema: PASSED only if they match.

import "std/web_protocols/openapi_schema.oo";

pub fn main() {
    let g2_oa = openapi_doc_new(2, 2);
    let g2_ob = openapi_doc_new(2, 2);
    let g2_a = openapi_doc_path_n(g2_oa);
    let g2_b = openapi_doc_path_n(g2_ob);
    if g2_a != g2_b {
        println("FAIL openapi_doc_path_n");
        process_exit(1);
    }
    println("prod_g2_openapi_schema: PASSED");
}
