// # Product prove std/db_graph/graph_pattern_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_pattern_matcher.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_pattern_matcher.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_pattern_matcher: PASSED only if they match.

import "std/db_graph/graph_pattern_matcher.oo";

pub fn main() {
    let graph_pattern_matcher_a = pattern_match_binding_new(0, 0, 0);
    let graph_pattern_matcher_b = pattern_match_binding_new(0, 0, 0);
    if graph_pattern_matcher_a.src_node_id != graph_pattern_matcher_b.src_node_id {
        println("FAIL graph_pattern_matcher");
        process_exit(1);
    }
    println("prod_ap_graph_pattern_matcher: PASSED");
}
