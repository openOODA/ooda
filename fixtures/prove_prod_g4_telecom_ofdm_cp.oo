// # Product prove std/telecom_5g/ofdm_cyclic_prefix.oo
//
// Logline: Fail-closed verification that OFDM cyclic prefix configuration, symbol lengths, and windowing are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_cyclic_prefix.oo.
//
// Beats:
//   1. Construct OFDM CP configuration for 5G NR numerology.
//   2. Compute symbol-dependent CP lengths and total sample counts.
//   3. Evaluate raised cosine boundary window taper weights.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_ofdm_cp: PASSED and exit 0.

import "std/telecom_5g/ofdm_cyclic_prefix.oo";

pub fn main() {
    let cfg_a: OfdmCpConfig = ofdm_cp_config_new(0, 2048, false);
    let cfg_b: OfdmCpConfig = ofdm_cp_config_new(0, 2048, false);

    if (cfg_a).numerology_mu != (cfg_b).numerology_mu || (cfg_a).numerology_mu != 0 {
        println("FAIL ofdm_cp_config_new numerology_mu");
        process_exit(1);
    }

    if (cfg_a).fft_size != (cfg_b).fft_size || (cfg_a).fft_size != 2048 {
        println("FAIL ofdm_cp_config_new fft_size");
        process_exit(1);
    }

    let cp0_a: Int = ofdm_cp_length_samples(cfg_a, 0);
    let cp0_b: Int = ofdm_cp_length_samples(cfg_b, 0);
    if cp0_a != cp0_b || cp0_a != 160 {
        println("FAIL ofdm_cp_length_samples symbol 0");
        process_exit(1);
    }

    let cp1_a: Int = ofdm_cp_length_samples(cfg_a, 1);
    let cp1_b: Int = ofdm_cp_length_samples(cfg_b, 1);
    if cp1_a != cp1_b || cp1_a != 144 {
        println("FAIL ofdm_cp_length_samples symbol 1");
        process_exit(1);
    }

    let tot_a: Int = ofdm_total_symbol_samples(cfg_a, 0);
    let tot_b: Int = ofdm_total_symbol_samples(cfg_b, 0);
    if tot_a != tot_b || tot_a != 2208 {
        println("FAIL ofdm_total_symbol_samples");
        process_exit(1);
    }

    let w0_a: Float = ofdm_raised_cosine_window(0, 32);
    let w0_b: Float = ofdm_raised_cosine_window(0, 32);
    if w0_a != w0_b || w0_a != 0.0 {
        println("FAIL ofdm_raised_cosine_window start");
        process_exit(1);
    }

    let w32_a: Float = ofdm_raised_cosine_window(32, 32);
    let w32_b: Float = ofdm_raised_cosine_window(32, 32);
    if w32_a != w32_b || w32_a != 1.0 {
        println("FAIL ofdm_raised_cosine_window end");
        process_exit(1);
    }

    println("prod_g4_telecom_ofdm_cp: PASSED");
    process_exit(0);
}
