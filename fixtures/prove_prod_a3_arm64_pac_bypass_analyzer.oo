// # Product prove std/exploit_analysis/arm64_pac_bypass_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts pac_strip_pointer is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/arm64_pac_bypass_analyzer.oo.
//
// Beats:
//   1. Call pac_strip_pointer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arm64_pac_bypass_analyzer: PASSED only if they match.

import "std/exploit_analysis/arm64_pac_bypass_analyzer.oo";

pub fn main() {
    let arm64_pac_bypass_analyzer_mark: Int = 0;
    if arm64_pac_bypass_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: PacPointer = pac_strip_pointer(0);
    let b: PacPointer = pac_strip_pointer(0);
    if (a).raw_pointer != (b).raw_pointer {
        println("FAIL pac_strip_pointer");
        process_exit(1);
    }
    println("prod_arm64_pac_bypass_analyzer: PASSED");
}
