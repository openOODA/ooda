// # Product prove std/fhe_lattices/fhe_ring_lwe_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts rlwe_lcg_step is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ring_lwe_sampler.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rlwe_lcg_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_ring_lwe_sampler: PASSED only if they match.

import "std/fhe_lattices/fhe_ring_lwe_sampler.oo";

pub fn main() {
    let g0_a = rlwe_lcg_step(2);
    let g0_b = rlwe_lcg_step(2);
    if g0_a != g0_b {
        println("FAIL rlwe_lcg_step");
        process_exit(1);
    }
    println("prod_g0_fhe_ring_lwe_sampler: PASSED");
}
