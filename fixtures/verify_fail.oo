// # Fail a verify assert
//
// Logline: Assert a wrong add result so ooda test must exit non-zero.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Return a + b from add.
//   2. Assert add(2, 3) equals 6.
//   3. Print add(1, 1) from main.
//
// Fail fixture: assert_eq deliberately wrong — ooda test must exit non-zero.
pub fn add(a: Int, b: Int) -> Int {
    return a + b;
}

verify add {
    assert_eq!(add(2, 3), 6);
}

pub fn main() {
    let x = add(1, 1);
    println(x);
}
