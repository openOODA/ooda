// # Product prove std/uav_flight/uav_battery_soc_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_battery_soc_estimator.oo.
//
// Beats:
//   1. Call battery_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_battery_soc_estimator: PASSED only if they match.

import "std/uav_flight/uav_battery_soc_estimator.oo";

pub fn main() {
    let uav_battery_soc_estimator_mark: Int = 0;
    if uav_battery_soc_estimator_mark != 0 {
        process_exit(1);
    }
    let a: BatteryParams = battery_params_default();
    let b: BatteryParams = battery_params_default();
    if (a).capacity_mah != (b).capacity_mah {
        println("FAIL battery_params_default");
        process_exit(1);
    }
    println("prod_uav_battery_soc_estimator: PASSED");
}
