// # Product prove std/compilers_polyhedral/loop_unimodular_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts unimodular_3x3_determinant is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/loop_unimodular_transform.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call unimodular_3x3_determinant twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_loop_unimodular_transform: PASSED only if they match.

import "std/compilers_polyhedral/loop_unimodular_transform.oo";

pub fn main() {
    let g2_oa = unimodular_3x3_new(2, 2, 2, 2, 2, 2, 2, 2, 2);
    let g2_ob = unimodular_3x3_new(2, 2, 2, 2, 2, 2, 2, 2, 2);
    let g2_a = unimodular_3x3_determinant(g2_oa);
    let g2_b = unimodular_3x3_determinant(g2_ob);
    if g2_a != g2_b {
        println("FAIL unimodular_3x3_determinant");
        process_exit(1);
    }
    println("prod_g2_loop_unimodular_transform: PASSED");
}
