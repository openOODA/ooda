// # emit-x86 struct instantiation, mutation, and field access
//
// Logline: Defines Point { x: Int, y: Int }, instantiates it, mutates a field, and prints the field.
//
// Setup: Pure x86_64 assembly lowering for structs with heap allocation, offset calculation, field access and mutation.
//
// Beats:
//   1. Declare struct Point with fields x: Int and y: Int.
//   2. Instantiate Point { x: 10, y: 20 }.
//   3. Mutate field p.x = 42.
//   4. Print field p.x (stdout: 42).

type Point = struct {
    x: Int,
    y: Int
};

pub fn main() {
    let mut p = Point { x: 10, y: 20 };
    p.x = 42;
    println(p.x);
}
