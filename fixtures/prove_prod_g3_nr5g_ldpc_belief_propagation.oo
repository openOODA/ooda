// # Product prove std/telecom_5g/nr5g_ldpc_belief_propagation.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_ldpc_min_sum_boxplus is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_ldpc_belief_propagation.oo.
//
// Beats:
//   1. Call nr5g_ldpc_min_sum_boxplus twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nr5g_ldpc_belief_propagation: PASSED only if they match.

import "std/telecom_5g/nr5g_ldpc_belief_propagation.oo";

pub fn main() {
    let nr5g_ldpc_belief_propagation_mark: Int = 0;
    if nr5g_ldpc_belief_propagation_mark != 0 {
        process_exit(1);
    }
    let a: Float = nr5g_ldpc_min_sum_boxplus(0.0, 0.0, 0.0);
    let b: Float = nr5g_ldpc_min_sum_boxplus(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL nr5g_ldpc_min_sum_boxplus");
        process_exit(1);
    }
    println("prod_nr5g_ldpc_belief_propagation: PASSED");
}
