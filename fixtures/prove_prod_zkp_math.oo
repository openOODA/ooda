// # Product prove std/crypto/zkp_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts zkp_mod_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_math.oo.
//
// Beats:
//   1. Call zkp_mod_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zkp_math: PASSED only if they match.

import "std/crypto/zkp_math.oo";

pub fn main() {
    let a = zkp_mod_pow(0, 0, 0);
    let b = zkp_mod_pow(0, 0, 0);
    if a != b {
        println("FAIL zkp_mod_pow");
        process_exit(1);
    }
    println("prod_zkp_math: PASSED");
}
