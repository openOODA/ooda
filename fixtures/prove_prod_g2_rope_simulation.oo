// # Product prove std/physics/rope_simulation.oo
//
// Logline: Fail-closed emit+gcc+run asserts rope_particle_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/rope_simulation.oo.
//
// Beats:
//   1. Call rope_particle_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rope_simulation: PASSED only if they match.

import "std/physics/rope_simulation.oo";

pub fn main() {
    let rope_simulation_mark: Int = 0;
    if rope_simulation_mark != 0 {
        process_exit(1);
    }
    let a: RopeParticle = rope_particle_new(0.0, 0.0, 0.0, 0.0);
    let b: RopeParticle = rope_particle_new(0.0, 0.0, 0.0, 0.0);
    if (a).is_pinned != (b).is_pinned {
        println("FAIL rope_particle_new");
        process_exit(1);
    }
    println("prod_g2_rope_simulation: PASSED");
}
