// # Product prove std/robotics_auv/heading_autopilot_sliding_mode.oo
//
// Logline: Fail-closed emit+gcc+run asserts sat_boundary_layer holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/heading_autopilot_sliding_mode.oo.
//
// Beats:
//   1. Call sat_boundary_layer using the heading_autopilot_sliding_mode ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_heading_autopilot_sliding_mode: PASSED only if asserts hold.

import "std/robotics_auv/heading_autopilot_sliding_mode.oo";

pub fn main() {
    let heading_autopilot_sliding_mode_a = sat_boundary_layer(0.0, 0.0);
    let heading_autopilot_sliding_mode_b = sat_boundary_layer(0.0, 0.0);
    if heading_autopilot_sliding_mode_a != heading_autopilot_sliding_mode_b {
        println("FAIL sat_boundary_layer");
        process_exit(1);
    }
    println("prod_heading_autopilot_sliding_mode: PASSED");
}
