// # Product prove std/hft_alpha/mm_iceberg_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts iceberg_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_iceberg_detector.oo.
//
// Beats:
//   1. Call iceberg_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_iceberg_detector: PASSED only if they match.

import "std/hft_alpha/mm_iceberg_detector.oo";

pub fn main() {
    let mm_iceberg_detector_mark: Int = 0;
    if mm_iceberg_detector_mark != 0 {
        process_exit(1);
    }
    let a: IcebergDetectionState = iceberg_state_new(0.0, true);
    let b: IcebergDetectionState = iceberg_state_new(0.0, true);
    if (a).consecutive_refills != (b).consecutive_refills {
        println("FAIL iceberg_state_new");
        process_exit(1);
    }
    println("prod_g2_mm_iceberg_detector: PASSED");
}
