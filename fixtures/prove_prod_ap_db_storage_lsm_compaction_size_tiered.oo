// # Product prove std/db_storage/lsm_compaction_size_tiered.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/lsm_compaction_size_tiered.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_compaction_size_tiered.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_lsm_compaction_size_tiered: PASSED only if they match.

import "std/db_storage/lsm_compaction_size_tiered.oo";

pub fn main() {
    let lsm_compaction_size_tiered_a = size_tier_config_default();
    let lsm_compaction_size_tiered_b = size_tier_config_default();
    if lsm_compaction_size_tiered_a.min_threshold != lsm_compaction_size_tiered_b.min_threshold {
        println("FAIL lsm_compaction_size_tiered");
        process_exit(1);
    }
    println("prod_ap_lsm_compaction_size_tiered: PASSED");
}
