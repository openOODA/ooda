// # Product prove std/physics_advanced/lattice_boltzmann_stream_collide.oo
//
// Logline: Fail-closed emit+gcc+run asserts lbm_kinematic_viscosity_from_tau is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_stream_collide.oo.
//
// Beats:
//   1. Call lbm_kinematic_viscosity_from_tau twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lattice_boltzmann_stream_collide: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_stream_collide.oo";

pub fn main() {
    let lattice_boltzmann_stream_collide_mark: Int = 0;
    if lattice_boltzmann_stream_collide_mark != 0 {
        process_exit(1);
    }
    let a: Float = lbm_kinematic_viscosity_from_tau(0.0);
    let b: Float = lbm_kinematic_viscosity_from_tau(0.0);
    if a != b {
        println("FAIL lbm_kinematic_viscosity_from_tau");
        process_exit(1);
    }
    println("prod_lattice_boltzmann_stream_collide: PASSED");
}
