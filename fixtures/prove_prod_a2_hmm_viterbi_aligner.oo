// # Product prove std/bio_advanced/hmm_viterbi_aligner.oo
//
// Logline: Fail-closed emit+gcc+run asserts viterbi_step_update is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_viterbi_aligner.oo.
//
// Beats:
//   1. Call viterbi_step_update twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hmm_viterbi_aligner: PASSED only if they match.

import "std/bio_advanced/hmm_viterbi_aligner.oo";

pub fn main() {
    let hmm_viterbi_aligner_mark: Int = 0;
    if hmm_viterbi_aligner_mark != 0 {
        process_exit(1);
    }
    let a: Float = viterbi_step_update(0.0, 0.0, 0.0);
    let b: Float = viterbi_step_update(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL viterbi_step_update");
        process_exit(1);
    }
    println("prod_hmm_viterbi_aligner: PASSED");
}
