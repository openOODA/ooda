// # Product prove std/db_columnar/parquet_statistics_minmax.oo
//
// Logline: Fail-closed emit+gcc+run asserts stats_prune_equals_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_statistics_minmax.oo.
//
// Beats:
//   1. Call stats_prune_equals_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_statistics_minmax: PASSED only if they match.

import "std/db_columnar/parquet_statistics_minmax.oo";

pub fn main() {
    let obj_a: IntStatistics = int_statistics_empty();
    let obj_b: IntStatistics = int_statistics_empty();
    let a: Bool = stats_prune_equals_int(obj_a, 0);
    let b: Bool = stats_prune_equals_int(obj_b, 0);
    if a != b {
        println("FAIL stats_prune_equals_int");
        process_exit(1);
    }
    println("prod_parquet_statistics_minmax: PASSED");
}
