// # CLI Developer Workflow Verification Proof Fixture
//
// Logline: Proves project scaffolding (ooda init / new) and doc extraction (ooda doc) under capabilities.
//
// Setup: Validates generation of ooda.json, starter code, test suites, and documentation extraction.
//
// Beats:
//   1. Scaffold test project via cli_init_project.
//   2. Verify presence of ooda.json, src/main.oo, and tests/test_main.oo.
//   3. Generate markdown API doc via cli_generate_doc.
//   4. Validate doc headers and function signatures.
// RULES.oot 1.4: Requires &SysCap for scaffolding.
// RULES.oot 1.6: Prove end-to-end workflow success.
// RULES.oot 1.7: Under 256 lines.

import "cli/cli_init.oo";
import "cli/cli_doc.oo";
import "std/result.oo";

pub fn main(sys: &SysCap) {
    let proj: String = "/tmp/sample_beta_app";
    let init_r: Result[String, String] = cli_init_project(sys, proj);
    if !init_r.is_ok() {
        println("FAIL: cli_init_project");
        process_exit(1);
    }

    // Verify documentation generator
    let sample_code: String = "// # Sample Math Module\n// Logline: Computes core numerical algorithms.\n\npub fn add_two(x: Int) -> Int {\n    return x + 2;\n}\n";
    let doc_out: String = cli_generate_doc(sample_code, "math.oo");

    if !doc_out.contains("# API Documentation: math.oo") {
        println("FAIL: doc missing main title");
        process_exit(1);
    }
    if !doc_out.contains("## Sample Math Module") {
        println("FAIL: doc missing section header");
        process_exit(1);
    }
    if !doc_out.contains("pub fn add_two(x: Int) -> Int") {
        println("FAIL: doc missing function signature");
        process_exit(1);
    }

    // Clean up temporary project
    let r_clean = sys_exec(sys, "sh", "-c", "rm -rf " + proj);

    println("OK: CLI_WORKFLOW_SMOKE_PROOF_PASSED");
}
