// # Product prove std/bio_advanced/protein_secondary_dssp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/protein_secondary_dssp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_secondary_dssp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_secondary_dssp: PASSED only if they match.

import "std/bio_advanced/protein_secondary_dssp.oo";

pub fn main() {
    let protein_secondary_dssp_a = dssp_kabsch_sander_energy(0.0, 0.0, 0.0, 0.0);
    let protein_secondary_dssp_b = dssp_kabsch_sander_energy(0.0, 0.0, 0.0, 0.0);
    if protein_secondary_dssp_a != protein_secondary_dssp_b {
        println("FAIL protein_secondary_dssp");
        process_exit(1);
    }
    println("prod_ap_protein_secondary_dssp: PASSED");
}
