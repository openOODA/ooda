// # Product prove std/scicomp/halton_sequence.oo
//
// Logline: Fail-closed emit+gcc+run asserts halton_sequence_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/halton_sequence.oo.
//
// Beats:
//   1. Call halton_sequence_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_halton_sequence: PASSED only if they match.

import "std/scicomp/halton_sequence.oo";

pub fn main() {
    let a: HaltonSequence = halton_sequence_new(0);
    let b: HaltonSequence = halton_sequence_new(0);
    if a.dimension != b.dimension {
        println("FAIL halton_sequence_new");
        process_exit(1);
    }
    println("prod_halton_sequence: PASSED");
}
