// # Print a wrapped string
//
// Logline: A tiny wrapper returns hello and main prints it.
//
// Beats:
//   1. Return a string from get_str_wrap.
//   2. Call that wrapper from main.
//   3. Print so typecheck of println on String is live.

pub fn get_str_wrap() -> String { return "hello"; }
pub fn main() {
    println(get_str_wrap());
}
