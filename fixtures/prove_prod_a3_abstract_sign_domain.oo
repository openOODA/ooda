// # Product prove std/formal_verif/abstract_sign_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts sign_bottom is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_sign_domain.oo.
//
// Beats:
//   1. Call sign_bottom twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_abstract_sign_domain: PASSED only if they match.

import "std/formal_verif/abstract_sign_domain.oo";

pub fn main() {
    let abstract_sign_domain_mark: Int = 0;
    if abstract_sign_domain_mark != 0 {
        process_exit(1);
    }
    let a: SignValue = sign_bottom();
    let b: SignValue = sign_bottom();
    if (a).tag != (b).tag {
        println("FAIL sign_bottom");
        process_exit(1);
    }
    println("prod_abstract_sign_domain: PASSED");
}
