// # Product prove std/db_graph/opencypher_rule_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts optimization_rule_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_rule_optimizer.oo.
//
// Beats:
//   1. Call optimization_rule_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_rule_optimizer: PASSED only if they match.

import "std/db_graph/opencypher_rule_optimizer.oo";

pub fn main() {
    let opencypher_rule_optimizer_mark: Int = 0;
    if opencypher_rule_optimizer_mark != 0 {
        process_exit(1);
    }
    let a: OptimizationRule = optimization_rule_new(0, "x");
    let b: OptimizationRule = optimization_rule_new(0, "x");
    if (a).rule_id != (b).rule_id {
        println("FAIL optimization_rule_new");
        process_exit(1);
    }
    println("prod_opencypher_rule_optimizer: PASSED");
}
