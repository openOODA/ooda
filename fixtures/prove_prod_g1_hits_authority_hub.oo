// # Product prove std/graph_topology/hits_authority_hub.oo
//
// Logline: Fail-closed emit+gcc+run asserts hits_authority_hub_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/hits_authority_hub.oo.
//
// Beats:
//   1. Call hits_authority_hub_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hits_authority_hub: PASSED only if they match.

import "std/graph_topology/hits_authority_hub.oo";

pub fn main() {
    let a: Int = hits_authority_hub_probe();
    let b: Int = hits_authority_hub_probe();
    if a != 0 {
        println("FAIL hits_authority_hub_probe");
        process_exit(1);
    }
    if a != b {
        println("FAIL hits_authority_hub_probe");
        process_exit(1);
    }
    println("prod_hits_authority_hub: PASSED");
}
