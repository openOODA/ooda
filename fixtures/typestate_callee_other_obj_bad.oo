// # Callee opens another sock
//
// Logline: wrap connects a freshly opened sock and leaves the caller's sock Closed.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap opens a second sock.
//   3. wrap connects only that second sock.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

fn wrap(s: Int) {
    let t = open_sock();
    connect(t);
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
