// # Product prove std/astrodynamics/attitude_reaction_wheels.oo
//
// Logline: Fail-closed emit+gcc+run asserts rw_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/attitude_reaction_wheels.oo.
//
// Beats:
//   1. Call rw_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_reaction_wheels: PASSED only if they match.

import "std/astrodynamics/attitude_reaction_wheels.oo";

pub fn main() {
    let attitude_reaction_wheels_mark: Int = 0;
    if attitude_reaction_wheels_mark != 0 {
        process_exit(1);
    }
    let a: Int = rw_count();
    let b: Int = rw_count();
    if a != b {
        println("FAIL rw_count");
        process_exit(1);
    }
    println("prod_attitude_reaction_wheels: PASSED");
}
