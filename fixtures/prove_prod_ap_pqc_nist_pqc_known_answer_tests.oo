// # Product prove std/pqc_nist/pqc_known_answer_tests.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pqc_nist/pqc_known_answer_tests.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_known_answer_tests.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pqc_known_answer_tests: PASSED only if they match.

import "std/pqc_nist/pqc_known_answer_tests.oo";

pub fn main() {
    let pqc_known_answer_tests_a = kat_test_case_new("x", 0, list_new());
    let pqc_known_answer_tests_b = kat_test_case_new("x", 0, list_new());
    if pqc_known_answer_tests_a.scheme_name != pqc_known_answer_tests_b.scheme_name {
        println("FAIL pqc_known_answer_tests");
        process_exit(1);
    }
    println("prod_ap_pqc_known_answer_tests: PASSED");
}
