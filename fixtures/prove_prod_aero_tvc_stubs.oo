// # Product prove std/aero/tvc_stubs.oo
//
// Logline: Fail-closed emit+check asserts tvc_stubs is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_stubs.oo.
//
// Beats:
//   1. Call tvc_module_ready twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tvc_stubs: PASSED only if they match.

import "std/aero/tvc_stubs.oo";

pub fn main() {
    let tvc_stubs_mark: Int = 0;
    if tvc_stubs_mark != 0 { process_exit(1); }
    let a: Bool = tvc_module_ready();
    let b: Bool = tvc_module_ready();
    if a != b { process_exit(1); }
    println("prod_tvc_stubs: PASSED");
}
