// # Product prove std/swarm/dispatch.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_worker_can_accept is deterministic.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch.oo.
//
// Beats:
//   1. Call shim_marker_worker_can_accept twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dispatch: PASSED only if they match.

import "std/swarm/dispatch.oo";

pub fn main() {
    let dispatch_mark: Int = 0;
    if dispatch_mark != 0 { process_exit(1); }
    let a: Bool = shim_marker_worker_can_accept();
    let b: Bool = shim_marker_worker_can_accept();
    if a != b { process_exit(1); }
    println("prod_dispatch: PASSED");
}
