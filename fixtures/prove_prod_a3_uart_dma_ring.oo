// # Product prove std/embedded_hal/uart_dma_ring.oo
//
// Logline: Fail-closed emit+gcc+run asserts uart_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/uart_dma_ring.oo.
//
// Beats:
//   1. Call uart_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uart_dma_ring: PASSED only if they match.

import "std/embedded_hal/uart_dma_ring.oo";

pub fn main() {
    let uart_dma_ring_mark: Int = 0;
    if uart_dma_ring_mark != 0 {
        process_exit(1);
    }
    let a: UartConfig = uart_config_new(0, 0);
    let b: UartConfig = uart_config_new(0, 0);
    if (a).uart_id != (b).uart_id {
        println("FAIL uart_config_new");
        process_exit(1);
    }
    println("prod_uart_dma_ring: PASSED");
}
