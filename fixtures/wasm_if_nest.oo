// # Nested const if true println
//
// Logline: Print nest-then from if true wrapping if true.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. Outer if true, inner if true print nest-then.
//   3. Inner else and outer else stay unprinted.

pub fn main() {
    if true {
        if true {
            println("nest-then");
        } else {
            println("nest-inner-else");
        }
    } else {
        println("nest-else");
    }
}
