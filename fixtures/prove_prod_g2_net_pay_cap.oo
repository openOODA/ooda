// # Product prove std/net/pay_cap.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_cap_required_header_name is a real value.
//
// Setup: Isolated emit-c. Imports std/net/pay_cap.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pay_cap_required_header_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pay_cap: PASSED only if they match.

import "std/net/pay_cap.oo";

pub fn main() {
    let g2_a = pay_cap_required_header_name();
    let g2_b = pay_cap_required_header_name();
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL pay_cap_required_header_name");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL pay_cap_required_header_name");
        process_exit(1);
    }
    println("prod_g2_pay_cap: PASSED");
}
