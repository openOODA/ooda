// # Unary not on bytecode
//
// Logline: Flip a bool with unary ! and print 1 when the flip is false.
//
// Beats:
//   1. Set a to !(1 == 0), which is true.
//   2. Set b to !a, which is false.
//   3. Print 1 on the else branch.

// M6: unary ! / bool on bytecode interpreter
pub fn main() {
    let a = !(1 == 0);
    let b = !a;
    if b {
        println(0);
    } else {
        println(1);
    }
}
