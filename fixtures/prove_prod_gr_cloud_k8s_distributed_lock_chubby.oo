// # Product prove std/cloud_k8s/distributed_lock_chubby.oo
//
// Logline: Fail-closed emit+gcc+run asserts chubby_lock_renew is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/distributed_lock_chubby.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chubby_lock_renew twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_distributed_lock_chubby: PASSED only if they match.

import "std/cloud_k8s/distributed_lock_chubby.oo";

pub fn main() {
    let mut g0_oa: ChubbyLock = ChubbyLock { lock_name: "x", current_holder: "x", current_token: 0, lease_expires_ms: 0, is_locked: true };
    let mut g0_ob: ChubbyLock = ChubbyLock { lock_name: "x", current_holder: "x", current_token: 0, lease_expires_ms: 0, is_locked: true };
    let g0_a = chubby_lock_renew(&g0_oa, "x", 0, 0, 0);
    let g0_b = chubby_lock_renew(&g0_ob, "x", 0, 0, 0);
    if g0_a != g0_b {
        println("FAIL chubby_lock_renew");
        process_exit(1);
    }
    println("prod_gr_distributed_lock_chubby: PASSED");
}
