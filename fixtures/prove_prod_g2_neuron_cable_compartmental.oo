// # Product prove std/neuro_bci/neuron_cable_compartmental.oo
//
// Logline: Fail-closed emit+gcc+run asserts cable_steady_state_attenuation is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neuron_cable_compartmental.oo.
//
// Beats:
//   1. Call cable_steady_state_attenuation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_neuron_cable_compartmental: PASSED only if they match.

import "std/neuro_bci/neuron_cable_compartmental.oo";

pub fn main() {
    let neuron_cable_compartmental_mark: Int = 0;
    if neuron_cable_compartmental_mark != 0 {
        process_exit(1);
    }
    let a: Float = cable_steady_state_attenuation(0.0, 0.0);
    let b: Float = cable_steady_state_attenuation(0.0, 0.0);
    if a != b {
        println("FAIL cable_steady_state_attenuation");
        process_exit(1);
    }
    println("prod_g2_neuron_cable_compartmental: PASSED");
}
