// # Product prove std/gis_spatial/kml_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts kml_writer_point_placemark is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kml_writer.oo.
//
// Beats:
//   1. Call kml_writer_point_placemark twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kml_writer: PASSED only if they match.

import "std/gis_spatial/kml_writer.oo";

pub fn main() {
    let a: KmlPlacemark = kml_writer_point_placemark("x", 0.0, 0.0, 0.0);
    let b: KmlPlacemark = kml_writer_point_placemark("x", 0.0, 0.0, 0.0);
    if (a).geom_type != (b).geom_type {
        println("FAIL kml_writer_point_placemark");
        process_exit(1);
    }
    println("prod_kml_writer: PASSED");
}
