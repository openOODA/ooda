// # Product prove std/fintech_l3_book/market_data_sequence_gap_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts gap_recovery_tracker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/market_data_sequence_gap_recovery.oo.
//
// Beats:
//   1. Call gap_recovery_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_market_data_sequence_gap_recovery: PASSED only if they match.

import "std/fintech_l3_book/market_data_sequence_gap_recovery.oo";

pub fn main() {
    let a: GapRecoveryTracker = gap_recovery_tracker_new("x", 0);
    let b: GapRecoveryTracker = gap_recovery_tracker_new("x", 0);
    if a.total_gaps_detected != b.total_gaps_detected {
        println("FAIL gap_recovery_tracker_new");
        process_exit(1);
    }
    println("prod_market_data_sequence_gap_recovery: PASSED");
}
