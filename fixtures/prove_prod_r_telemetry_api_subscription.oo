// # Product prove std/cloud_faas/telemetry_api_subscription.oo
//
// Logline: Fail-closed emit+gcc+run asserts telemetry_api_manager_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/telemetry_api_subscription.oo.
//
// Beats:
//   1. Call telemetry_api_manager_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_telemetry_api_subscription: PASSED only if asserts hold.

import "std/cloud_faas/telemetry_api_subscription.oo";

pub fn main() {
    let telemetry_api_subscription: TelemetryApiManager = telemetry_api_manager_new();
    let telemetry_api_subscription_b: TelemetryApiManager = telemetry_api_manager_new();
    if (telemetry_api_subscription).total_events_dispatched != 0 {
        println("FAIL telemetry_api_manager_new total_events_dispatched");
        process_exit(1);
    }
    if (telemetry_api_subscription).total_events_dispatched != (telemetry_api_subscription_b).total_events_dispatched {
        println("FAIL telemetry_api_manager_new det");
        process_exit(1);
    }
    println("prod_telemetry_api_subscription: PASSED");
}
