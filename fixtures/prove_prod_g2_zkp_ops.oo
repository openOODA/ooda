// # Product prove std/crypto/zkp_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts pedersen_commitment_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_ops.oo.
//
// Beats:
//   1. Call pedersen_commitment_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zkp_ops: PASSED only if they match.

import "std/crypto/zkp_ops.oo";

pub fn main() {
    let zkp_ops_mark: Int = 0;
    if zkp_ops_mark != 0 {
        process_exit(1);
    }
    let a: PedersenCommitment = pedersen_commitment_create(0, 0, 0, 0, 0);
    let b: PedersenCommitment = pedersen_commitment_create(0, 0, 0, 0, 0);
    if (a).commitment != (b).commitment {
        println("FAIL pedersen_commitment_create");
        process_exit(1);
    }
    println("prod_g2_zkp_ops: PASSED");
}
