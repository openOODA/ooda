// # Product prove std/gis_topo/proj_utm_conversion.oo
//
// Logline: Fail-closed emit+gcc+run asserts utm_zone_from_lon is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_utm_conversion.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call utm_zone_from_lon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_proj_utm_conversion: PASSED only if they match.

import "std/gis_topo/proj_utm_conversion.oo";

pub fn main() {
    let g0_a = utm_zone_from_lon(1.0);
    let g0_b = utm_zone_from_lon(1.0);
    if g0_a != g0_b {
        println("FAIL utm_zone_from_lon");
        process_exit(1);
    }
    println("prod_g0_proj_utm_conversion: PASSED");
}
