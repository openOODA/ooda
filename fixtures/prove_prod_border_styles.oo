// # Product prove std/tui/border_styles.oo
//
// Logline: Fail-closed emit+gcc+run asserts border_sides_all is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/border_styles.oo.
//
// Beats:
//   1. Call border_sides_all twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_border_styles: PASSED only if they match.

import "std/tui/border_styles.oo";

pub fn main() {
    let border_styles_mark: Int = 0;
    if border_styles_mark != 0 {
        process_exit(1);
    }
    let a: BorderSides = border_sides_all();
    let b: BorderSides = border_sides_all();
    if (a).field0 != (b).field0 {
        println("FAIL border_sides_all");
        process_exit(1);
    }
    println("prod_border_styles: PASSED");
}
