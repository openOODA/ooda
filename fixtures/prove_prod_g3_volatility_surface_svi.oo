// # Product prove std/defi_derivatives/volatility_surface_svi.oo
//
// Logline: Fail-closed emit+gcc+run asserts svi_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/volatility_surface_svi.oo.
//
// Beats:
//   1. Call svi_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_volatility_surface_svi: PASSED only if they match.

import "std/defi_derivatives/volatility_surface_svi.oo";

pub fn main() {
    let volatility_surface_svi_mark: Int = 0;
    if volatility_surface_svi_mark != 0 {
        process_exit(1);
    }
    let a: SviParameters = svi_params_default();
    let b: SviParameters = svi_params_default();
    if (a).a != (b).a {
        println("FAIL svi_params_default");
        process_exit(1);
    }
    println("prod_volatility_surface_svi: PASSED");
}
