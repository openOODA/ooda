// # Test SMT Solver
//
// Logline: Verification harness proving the 3 acceptance theorems for the SMT solver stack.
//
// Setup: Imports smt_solver.oo and asserts each theorem returns 1 (proven/UNSAT).
//
// Beats:
//   1. Prove x > 5 implies x + 1 > 6 (UNSAT conjunction).
//   2. Prove 0 == 1 is UNSAT (no integer witness).
//   3. Prove x >= 0 and x < 0 is UNSAT (contradiction).
//   4. Verify DPLL on a simple 3-SAT satisfiable instance.

import "std/formal_verif/smt_solver.oo";

pub fn test_warmup() -> Int {
    let mut i: Int = 0;
    i = 0;
    return i;
}

pub fn test_x_gt5_implies_xp1_gt6() -> Int {
    let r: Int = smt_prove_x_gt5_implies_xp1_gt6();
    if r == 1 {
        return 1;
    }
    return 0;
}

pub fn test_zero_eq_one() -> Int {
    let r: Int = smt_prove_zero_eq_one();
    if r == 1 {
        return 1;
    }
    return 0;
}

pub fn test_x_ge0_and_x_lt0() -> Int {
    let r: Int = smt_prove_x_ge0_and_x_lt0();
    if r == 1 {
        return 1;
    }
    return 0;
}

pub fn test_dpll_basic_sat() -> Int {
    // (x1 OR x2) AND (NOT x1 OR x2) AND (x1 OR NOT x2) is satisfiable with x1=true, x2=true
    let mut clauses: List[List[Int]] = list_new();
    let mut c1: List[Int] = list_new();
    c1 = list_push(c1, smt_literal_pos(0));
    c1 = list_push(c1, smt_literal_pos(1));
    let mut c2: List[Int] = list_new();
    c2 = list_push(c2, smt_literal_neg(0));
    c2 = list_push(c2, smt_literal_pos(1));
    let mut c3: List[Int] = list_new();
    c3 = list_push(c3, smt_literal_pos(0));
    c3 = list_push(c3, smt_literal_neg(1));
    clauses = list_push(clauses, c1);
    clauses = list_push(clauses, c2);
    clauses = list_push(clauses, c3);
    let r: Int = smt_solve_bool_sat(clauses, 2);
    if r == 1 {
        return 1;
    }
    return 0;
}

pub fn test_dpll_basic_unsat() -> Int {
    // (x1) AND (NOT x1) is unsatisfiable
    let mut clauses: List[List[Int]] = list_new();
    let mut c1: List[Int] = list_new();
    c1 = list_push(c1, smt_literal_pos(0));
    let mut c2: List[Int] = list_new();
    c2 = list_push(c2, smt_literal_neg(0));
    clauses = list_push(clauses, c1);
    clauses = list_push(clauses, c2);
    let r: Int = smt_solve_bool_sat(clauses, 1);
    if r == 0 {
        return 1;
    }
    return 0;
}

pub fn test_lia_sat_with_witness() -> Int {
    // x + y = 5, x >= 0, y >= 0 → expect Sat with witness (e.g., 0, 5)
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 1, 0 - 5, 2));   // x + y == 5
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0, 2));       // x == 0 (we expect x=0)
    let r: List[Int] = smt_solve_lia(ineqs, 0, 10, 0, 10);
    let result: Int = list_get(r, 0);
    if result == 1 {
        let wx: Int = list_get(r, 1);
        let wy: Int = list_get(r, 2);
        if wx == 0 && wy == 5 {
            return 1;
        }
    }
    return 0;
}

pub fn main(alloc: &AllocCap) -> Int {
    let raw = alloc_bytes(alloc, 65536);
    let _raw_use: Int = raw + 0;
    let mut passed: Int = 0;
    let mut total: Int = 0;
    let warmup_1: Int = test_warmup();
    let warmup_2: Int = test_warmup();

    total = total + 1;
    if test_x_gt5_implies_xp1_gt6() == 1 { passed = passed + 1; }

    total = total + 1;
    if test_zero_eq_one() == 1 { passed = passed + 1; }

    total = total + 1;
    if test_x_ge0_and_x_lt0() == 1 { passed = passed + 1; }

    total = total + 1;
    if test_dpll_basic_sat() == 1 { passed = passed + 1; }

    total = total + 1;
    if test_dpll_basic_unsat() == 1 { passed = passed + 1; }

    total = total + 1;
    if test_lia_sat_with_witness() == 1 { passed = passed + 1; }

    println("SMT_SOLVER_TESTS: " + passed.to_string() + "/" + total.to_string() + " passed");
    if passed == total {
        println("PASSED");
        return 0;
    }
    println("FAILED");
    return 1;
}
