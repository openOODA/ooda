// # Product prove std/defi_derivatives/margin_haircut_risk_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts collateral_config_eth is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/margin_haircut_risk_matrix.oo.
//
// Beats:
//   1. Call collateral_config_eth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_margin_haircut_risk_matrix: PASSED only if they match.

import "std/defi_derivatives/margin_haircut_risk_matrix.oo";

pub fn main() {
    let margin_haircut_risk_matrix_mark: Int = 0;
    if margin_haircut_risk_matrix_mark != 0 {
        process_exit(1);
    }
    let a: CollateralAssetConfig = collateral_config_eth();
    let b: CollateralAssetConfig = collateral_config_eth();
    if (a).base_haircut_pct != (b).base_haircut_pct {
        println("FAIL collateral_config_eth");
        process_exit(1);
    }
    println("prod_margin_haircut_risk_matrix: PASSED");
}
