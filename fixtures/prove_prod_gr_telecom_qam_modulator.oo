// # Product prove std/telecom/qam_modulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts qam_pam4_map is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/qam_modulator.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call qam_pam4_map twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_qam_modulator: PASSED only if they match.

import "std/telecom/qam_modulator.oo";

pub fn main() {
    let g0_a = qam_pam4_map(0);
    let g0_b = qam_pam4_map(0);
    if g0_a != g0_b {
        println("FAIL qam_pam4_map");
        process_exit(1);
    }
    println("prod_gr_qam_modulator: PASSED");
}
