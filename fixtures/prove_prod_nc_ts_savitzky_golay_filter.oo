// # Product prove std/industrial_predictive/ts_savitzky_golay_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts ts_savitzky_golay_filter_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_savitzky_golay_filter.oo.
//
// Beats:
//   1. Call ts_savitzky_golay_filter_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ts_savitzky_golay_filter: PASSED only if it matches.

import "std/industrial_predictive/ts_savitzky_golay_filter.oo";

pub fn main() {
    let a: Int = ts_savitzky_golay_filter_probe();
    if a != 0 {
        println("FAIL ts_savitzky_golay_filter_probe");
        process_exit(1);
    }
    println("prod_nc_ts_savitzky_golay_filter: PASSED");
}
