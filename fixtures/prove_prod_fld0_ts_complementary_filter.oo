// # Product prove std/industrial_predictive/ts_complementary_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts comp_filter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_complementary_filter.oo.
//
// Beats:
//   1. Call comp_filter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_complementary_filter: PASSED only if they match.

import "std/industrial_predictive/ts_complementary_filter.oo";

pub fn main() {
    let ts_complementary_filter_mark: Int = 0;
    if ts_complementary_filter_mark != 0 {
        process_exit(1);
    }
    let ts_complementary_filter_a: ComplementaryState = comp_filter_new(1.0);
    let ts_complementary_filter_b: ComplementaryState = comp_filter_new(1.0);
    if (ts_complementary_filter_a).is_initialized != (ts_complementary_filter_b).is_initialized {
        println("FAIL comp_filter_new");
        process_exit(1);
    }
    println("prod_ts_complementary_filter: PASSED");
}
