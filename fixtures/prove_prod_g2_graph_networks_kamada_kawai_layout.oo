// # Product prove std/graph_networks/kamada_kawai_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts kk_approx_sqrt is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/kamada_kawai_layout.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kk_approx_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kamada_kawai_layout: PASSED only if they match.

import "std/graph_networks/kamada_kawai_layout.oo";

pub fn main() {
    let g2_a = kk_approx_sqrt(2);
    let g2_b = kk_approx_sqrt(2);
    if g2_a != g2_b {
        println("FAIL kk_approx_sqrt");
        process_exit(1);
    }
    println("prod_g2_kamada_kawai_layout: PASSED");
}
