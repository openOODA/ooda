// # Product prove std/mesh_ebpf/ebpf_map_hash_lru.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebpf_lru_map_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_map_hash_lru.oo.
//
// Beats:
//   1. Call ebpf_lru_map_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_map_hash_lru: PASSED only if they match.

import "std/mesh_ebpf/ebpf_map_hash_lru.oo";

pub fn main() {
    let ebpf_map_hash_lru_mark: Int = 0;
    if ebpf_map_hash_lru_mark != 0 {
        process_exit(1);
    }
    let ebpf_map_hash_lru_a: EbpfLruHashMap = ebpf_lru_map_new(1);
    let ebpf_map_hash_lru_b: EbpfLruHashMap = ebpf_lru_map_new(1);
    if (ebpf_map_hash_lru_a).capacity != (ebpf_map_hash_lru_b).capacity {
        println("FAIL ebpf_lru_map_new");
        process_exit(1);
    }
    println("prod_ebpf_map_hash_lru: PASSED");
}
