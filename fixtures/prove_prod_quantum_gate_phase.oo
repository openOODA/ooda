// # Product prove std/quantum/gate_phase.oo
//
// Logline: Fail-closed emit+check asserts phase_s_squared_is_z is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_phase.oo.
//
// Beats:
//   1. Call phase_s_squared_is_z twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_phase: PASSED only if they match.

import "std/quantum/gate_phase.oo";

pub fn main() {
    let gate_phase_mark: Int = 0;
    if gate_phase_mark != 0 { process_exit(1); }
    let a: Bool = phase_s_squared_is_z();
    let b: Bool = phase_s_squared_is_z();
    if a != b { process_exit(1); }
    println("prod_gate_phase: PASSED");
}
