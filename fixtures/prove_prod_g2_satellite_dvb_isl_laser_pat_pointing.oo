// # Product prove std/satellite_dvb/isl_laser_pat_pointing.oo
//
// Logline: Fail-closed emit+gcc+run asserts laser_calc_point_ahead_angle_urad is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_laser_pat_pointing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call laser_calc_point_ahead_angle_urad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isl_laser_pat_pointing: PASSED only if they match.

import "std/satellite_dvb/isl_laser_pat_pointing.oo";

pub fn main() {
    let g2_a = laser_calc_point_ahead_angle_urad(1.0);
    let g2_b = laser_calc_point_ahead_angle_urad(1.0);
    if g2_a != g2_b {
        println("FAIL laser_calc_point_ahead_angle_urad");
        process_exit(1);
    }
    println("prod_g2_isl_laser_pat_pointing: PASSED");
}
