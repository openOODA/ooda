// # Product prove std/zk_rollup/sparse_merkle_tree_history.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/sparse_merkle_tree_history.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_history.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sparse_merkle_tree_history: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_history.oo";

pub fn main() {
    let sparse_merkle_tree_history_a = smt_history_log_new();
    let sparse_merkle_tree_history_b = smt_history_log_new();
    let sparse_merkle_tree_history_va = smt_history_find_root_at_height(sparse_merkle_tree_history_a, 0);
    let sparse_merkle_tree_history_vb = smt_history_find_root_at_height(sparse_merkle_tree_history_b, 0);
    if sparse_merkle_tree_history_va.contains(sparse_merkle_tree_history_vb) == false {
        println("FAIL sparse_merkle_tree_history");
        process_exit(1);
    }
    if sparse_merkle_tree_history_vb.contains(sparse_merkle_tree_history_va) == false {
        println("FAIL sparse_merkle_tree_history");
        process_exit(1);
    }
    println("prod_ap_sparse_merkle_tree_history: PASSED");
}
