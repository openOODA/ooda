// # Product prove std/compilers_vm/wasm_threads_atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts atomic_memory_atomic_notify is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_threads_atomic.oo.
//
// Beats:
//   1. Call atomic_memory_atomic_notify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_threads_atomic: PASSED only if they match.

import "std/compilers_vm/wasm_threads_atomic.oo";

pub fn main() {
    let wasm_threads_atomic_mark: Int = 0;
    if wasm_threads_atomic_mark != 0 {
        process_exit(1);
    }
    let a: Int = atomic_memory_atomic_notify();
    let b: Int = atomic_memory_atomic_notify();
    if a != b {
        println("FAIL atomic_memory_atomic_notify");
        process_exit(1);
    }
    println("prod_wasm_threads_atomic: PASSED");
}
