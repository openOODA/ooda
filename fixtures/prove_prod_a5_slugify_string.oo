// # Product prove std/web_ecosystem/slugify_string.oo
//
// Logline: Fail-closed emit+gcc+run asserts to_char_lower is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/slugify_string.oo.
//
// Beats:
//   1. Call to_char_lower twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slugify_string: PASSED only if they match.

import "std/web_ecosystem/slugify_string.oo";

pub fn main() {
    let slugify_string_mark: Int = 0;
    if slugify_string_mark != 0 {
        process_exit(1);
    }
    let a: String = to_char_lower("x");
    let b: String = to_char_lower("x");
    if a != b {
        println("FAIL to_char_lower");
        process_exit(1);
    }
    println("prod_slugify_string: PASSED");
}
