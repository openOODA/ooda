// # Product prove std/genomics_advanced/mendelian_randomization_ivw.oo
//
// Logline: Fail-closed emit+gcc+run asserts mendelian_randomization_ivw_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/mendelian_randomization_ivw.oo.
//
// Beats:
//   1. Call mendelian_randomization_ivw_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mendelian_randomization_ivw: PASSED only if they match.

import "std/genomics_advanced/mendelian_randomization_ivw.oo";

pub fn main() {
    let a = mendelian_randomization_ivw_probe();
    let b = mendelian_randomization_ivw_probe();
    if a != b {
        println("FAIL mendelian_randomization_ivw_probe");
        process_exit(1);
    }
    println("prod_mendelian_randomization_ivw: PASSED");
}
