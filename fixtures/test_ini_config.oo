// # INI parser adversarial suite
//
// Logline: Parses section headers, trimmed assignments, and comments, and rejects a syntax error.
//
// Setup: Pure. Imports ini_config.oo. Run from ooda/.
//
// Beats:
//   1. Parse [section] plus a trimmed key=value.
//   2. Ignore semicolon and hash comments.
//   3. Reject a line without an equals sign.

import "std/parsers/ini_config.oo";

pub fn main() {
    let src: String = "[db]\n; c\n# d\n user = root \nport=8080\n";
    let d: IniDoc = ini_config_parse(src);
    let st: Result[Int, String] = ini_config_stat(d);
    if st.is_err() {
        println("FAIL parse");
        process_exit(1);
    }
    let user: Result[String, String] = ini_config_get(d, "db.user");
    match user {
        Ok(v) => {
            if v != "root" {
                println("FAIL user " + v);
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL get " + e);
            process_exit(1);
        }
    }
    let port: Result[String, String] = ini_config_get(d, "db.port");
    match port {
        Ok(p) => {
            if p != "8080" {
                println("FAIL port " + p);
                process_exit(1);
            }
        },
        Err(e2) => {
            println("FAIL port " + e2);
            process_exit(1);
        }
    }
    println("[section] + trimmed key=value");
    println(";/# comments ignored");
    let bad: IniDoc = ini_config_parse("noequals");
    let bst: Result[Int, String] = ini_config_stat(bad);
    if bst.is_ok() {
        println("FAIL syntax");
        process_exit(1);
    }
    println("syntax Err");
    println("SUITE PASSED");
    println("test_ini_config: PASSED");
}
