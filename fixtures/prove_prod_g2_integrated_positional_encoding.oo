// # Product prove std/nerf_3dgs/integrated_positional_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts ipe_attenuation_factor is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/integrated_positional_encoding.oo.
//
// Beats:
//   1. Call ipe_attenuation_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_integrated_positional_encoding: PASSED only if they match.

import "std/nerf_3dgs/integrated_positional_encoding.oo";

pub fn main() {
    let integrated_positional_encoding_mark: Int = 0;
    if integrated_positional_encoding_mark != 0 {
        process_exit(1);
    }
    let a: Float = ipe_attenuation_factor(0, 0.0);
    let b: Float = ipe_attenuation_factor(0, 0.0);
    if a != b {
        println("FAIL ipe_attenuation_factor");
        process_exit(1);
    }
    println("prod_g2_integrated_positional_encoding: PASSED");
}
