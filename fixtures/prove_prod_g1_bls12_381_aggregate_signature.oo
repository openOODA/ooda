// # Product prove std/zk_rollup/bls12_381_aggregate_signature.oo
//
// Logline: Fail-closed emit+gcc+run asserts bls_g1_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/bls12_381_aggregate_signature.oo.
//
// Beats:
//   1. Call bls_g1_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bls12_381_aggregate_signature: PASSED only if they match.

import "std/zk_rollup/bls12_381_aggregate_signature.oo";

pub fn main() {
    let a: BlsG1Point = bls_g1_point_new(0, 0);
    let b: BlsG1Point = bls_g1_point_new(0, 0);
    if a.x != b.x {
        println("FAIL bls_g1_point_new");
        process_exit(1);
    }
    println("prod_bls12_381_aggregate_signature: PASSED");
}
