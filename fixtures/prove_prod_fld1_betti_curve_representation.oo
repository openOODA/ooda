// # Product prove std/tda_topology/betti_curve_representation.oo
//
// Logline: Fail-closed emit+gcc+run asserts betti_curve_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/betti_curve_representation.oo.
//
// Beats:
//   1. Call betti_curve_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_betti_curve_representation: PASSED only if they match.

import "std/tda_topology/betti_curve_representation.oo";

pub fn main() {
    let betti_curve_representation_mark: Int = 0;
    if betti_curve_representation_mark != 0 {
        process_exit(1);
    }
    let betti_curve_representation_a = betti_curve_new(1.0, 1.0, 1);
    let betti_curve_representation_b = betti_curve_new(1.0, 1.0, 1);
    if (betti_curve_representation_a).interval_count != (betti_curve_representation_b).interval_count {
        println("FAIL betti_curve_new");
        process_exit(1);
    }
    println("prod_betti_curve_representation: PASSED");
}
