// # Product prove std/lidar_perception/patchwork_ground_segmenter.oo
//
// Logline: Fail-closed verification that Patchwork++ Concentric Zone Model (CZM) binning and ground classification are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/patchwork_ground_segmenter.oo.
//
// Beats:
//   1. Construct default CZM configuration and assert zone counts and range bounds.
//   2. Compute CZM zone index and sector bin index across radial and azimuth ranges.
//   3. Classify ground returns relative to patch elevation bins deterministically.
//   4. Print prod_g4_lidar_patchwork: PASSED and exit 0.

import "std/lidar_perception/patchwork_ground_segmenter.oo";

pub fn main() {
    let cfg1: CZMConfig = czm_config_default();
    let cfg2: CZMConfig = czm_config_default();
    if (cfg1).num_zones != (cfg2).num_zones || (cfg1).num_zones != 4 {
        println("FAIL czm_config_default num_zones");
        process_exit(1);
    }
    if (cfg1).max_range != 80.0 || (cfg1).elevation_threshold != 0.15 {
        println("FAIL czm_config_default thresholds");
        process_exit(1);
    }

    let z0: Int = czm_get_zone_index(5.0, &cfg1);
    let z1: Int = czm_get_zone_index(15.0, &cfg1);
    let z2: Int = czm_get_zone_index(35.0, &cfg1);
    let z3: Int = czm_get_zone_index(60.0, &cfg1);
    if z0 != 0 || z1 != 1 || z2 != 2 || z3 != 3 {
        println("FAIL czm_get_zone_index");
        process_exit(1);
    }

    let s0: Int = czm_get_sector_index(0.0, 16);
    let s1: Int = czm_get_sector_index(0.0, 16);
    if s0 != s1 || s0 < 0 || s0 >= 16 {
        println("FAIL czm_get_sector_index");
        process_exit(1);
    }

    let bin: PatchSectorBin = patch_sector_bin_new(0, s0);
    if (bin).zone_idx != 0 || (bin).point_count != 0 {
        println("FAIL patch_sector_bin_new");
        process_exit(1);
    }

    let is_g_empty: Bool = patch_sector_bin_is_ground(0.0, &bin, &cfg1);
    if is_g_empty != false {
        println("FAIL patch_sector_bin_is_ground empty");
        process_exit(1);
    }

    let bin_populated: PatchSectorBin = PatchSectorBin {
        zone_idx: 0,
        sector_idx: s0,
        min_z: 0.0,
        mean_z: 0.05,
        point_count: 10,
    };
    let is_g_true: Bool = patch_sector_bin_is_ground(0.1, &bin_populated, &cfg1);
    let is_g_false: Bool = patch_sector_bin_is_ground(1.5, &bin_populated, &cfg1);
    if is_g_true != true || is_g_false != false {
        println("FAIL patch_sector_bin_is_ground classification");
        process_exit(1);
    }

    println("prod_g4_lidar_patchwork: PASSED");
    process_exit(0);
}
