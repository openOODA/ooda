// # Product prove std/auto/mpc.oo
//
// Logline: Fail-closed verification that Model Predictive Control facade operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/mpc.oo.
//
// Beats:
//   1. Call shim_marker_mpc_horizon_default twice with the same args.
//   2. Assert returned horizon steps match deterministically.
//   3. Call shim_marker_mpc_constraints_default and assert max_speed matches.
//   4. Print prod_g4_auto_mpc: PASSED and exit 0.

import "std/auto/mpc.oo";

pub fn main() {
    let a: MpcHorizon = shim_marker_mpc_horizon_default();
    let b: MpcHorizon = shim_marker_mpc_horizon_default();
    let steps_a: Int = mpc_horizon_steps(a);
    let steps_b: Int = mpc_horizon_steps(b);
    if steps_a != steps_b || steps_a <= 0 {
        println("FAIL shim_marker_mpc_horizon_default");
        process_exit(1);
    }

    let c1: MpcConstraints = shim_marker_mpc_constraints_default();
    let c2: MpcConstraints = shim_marker_mpc_constraints_default();
    let max_v1: Float = mpc_constraints_max_speed(c1);
    let max_v2: Float = mpc_constraints_max_speed(c2);
    if max_v1 != max_v2 || max_v1 <= 0.0 {
        println("FAIL shim_marker_mpc_constraints_default");
        process_exit(1);
    }

    let w1: MpcWeights = shim_marker_mpc_weights_default();
    let w2: MpcWeights = shim_marker_mpc_weights_default();
    let spd1: Float = mpc_weights_speed(w1);
    let spd2: Float = mpc_weights_speed(w2);
    if spd1 != spd2 || spd1 <= 0.0 {
        println("FAIL shim_marker_mpc_weights_default");
        process_exit(1);
    }

    println("prod_g4_auto_mpc: PASSED");
    process_exit(0);
}
