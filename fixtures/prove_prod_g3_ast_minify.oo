// # Product prove std/token_opt/ast_minify.oo
//
// Logline: Fail-closed emit+gcc+run asserts minify_options_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/token_opt/ast_minify.oo.
//
// Beats:
//   1. Call minify_options_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ast_minify: PASSED only if they match.

import "std/token_opt/ast_minify.oo";

pub fn main() {
    let ast_minify_mark: Int = 0;
    if ast_minify_mark != 0 {
        process_exit(1);
    }
    let a: MinifyOptions = minify_options_default();
    let b: MinifyOptions = minify_options_default();
    if (a).strip_comments != (b).strip_comments {
        println("FAIL minify_options_default");
        process_exit(1);
    }
    println("prod_ast_minify: PASSED");
}
