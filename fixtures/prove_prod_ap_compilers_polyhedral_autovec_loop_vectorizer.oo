// # Product prove std/compilers_polyhedral/autovec_loop_vectorizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/autovec_loop_vectorizer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_loop_vectorizer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_autovec_loop_vectorizer: PASSED only if they match.

import "std/compilers_polyhedral/autovec_loop_vectorizer.oo";

pub fn main() {
    let autovec_loop_vectorizer_a = vector_loop_config_new(0, 0, 0);
    let autovec_loop_vectorizer_b = vector_loop_config_new(0, 0, 0);
    if autovec_loop_vectorizer_a.loop_id != autovec_loop_vectorizer_b.loop_id {
        println("FAIL autovec_loop_vectorizer");
        process_exit(1);
    }
    println("prod_ap_autovec_loop_vectorizer: PASSED");
}
