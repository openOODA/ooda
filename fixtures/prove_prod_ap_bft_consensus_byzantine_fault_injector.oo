// # Product prove std/bft_consensus/byzantine_fault_injector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/byzantine_fault_injector.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/byzantine_fault_injector.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_byzantine_fault_injector: PASSED only if they match.

import "std/bft_consensus/byzantine_fault_injector.oo";

pub fn main() {
    let byzantine_fault_injector_a = fault_injection_config_clean();
    let byzantine_fault_injector_b = fault_injection_config_clean();
    let byzantine_fault_injector_va = fault_should_drop_message(byzantine_fault_injector_a, 0);
    let byzantine_fault_injector_vb = fault_should_drop_message(byzantine_fault_injector_b, 0);
    if byzantine_fault_injector_va != byzantine_fault_injector_vb {
        println("FAIL byzantine_fault_injector");
        process_exit(1);
    }
    println("prod_ap_byzantine_fault_injector: PASSED");
}
