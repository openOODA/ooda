// # Product prove std/scicomp/least_squares_regression.oo
//
// Logline: Fail-closed verification that 1D linear regression and 3-point quadratic polynomial fitting are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/least_squares_regression.oo.
//
// Beats:
//   1. Construct linear dataset and evaluate linear_regression_1d slope, intercept, and R^2.
//   2. Fit 3 points to a quadratic polynomial via quadratic_fit_3pt and assert coefficients.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_scicomp_least_squares: PASSED and exit 0.

import "std/scicomp/least_squares_regression.oo";

pub fn main() {
    let mut x: List[Float] = list_new();
    x = list_push(x, 1.0);
    x = list_push(x, 2.0);
    x = list_push(x, 3.0);

    let mut y: List[Float] = list_new();
    y = list_push(y, 3.0);
    y = list_push(y, 5.0);
    y = list_push(y, 7.0);

    let fit1: LinearFitResult = linear_regression_1d(&x, &y);
    let fit2: LinearFitResult = linear_regression_1d(&x, &y);

    if (fit1).slope != (fit2).slope || (fit1).slope < 1.999 || (fit1).slope > 2.001 {
        println("FAIL linear_regression_1d slope");
        process_exit(1);
    }
    if (fit1).intercept < 0.999 || (fit1).intercept > 1.001 {
        println("FAIL linear_regression_1d intercept");
        process_exit(1);
    }
    if (fit1).r_squared < 0.999 || (fit1).residual_sum_squares > 0.001 {
        println("FAIL linear_regression_1d metrics");
        process_exit(1);
    }

    let q1: List[Float] = quadratic_fit_3pt(0.0, 1.0, 1.0, 3.0, 2.0, 7.0);
    let q2: List[Float] = quadratic_fit_3pt(0.0, 1.0, 1.0, 3.0, 2.0, 7.0);

    let a: Float = list_get(q1, 0);
    let b: Float = list_get(q1, 1);
    let c: Float = list_get(q1, 2);

    if a != list_get(q2, 0) || a < 0.999 || a > 1.001 {
        println("FAIL quadratic_fit_3pt a");
        process_exit(1);
    }
    if b < 0.999 || b > 1.001 || c < 0.999 || c > 1.001 {
        println("FAIL quadratic_fit_3pt b/c");
        process_exit(1);
    }

    println("prod_g4_scicomp_least_squares: PASSED");
    process_exit(0);
}
