// # Product prove std/security_defense/code_integrity_hmac_checker.oo
//
// Logline: Fail-closed emit+gcc+run asserts integrity_checker_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/code_integrity_hmac_checker.oo.
//
// Beats:
//   1. Call integrity_checker_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_code_integrity_hmac_checker: PASSED only if they match.

import "std/security_defense/code_integrity_hmac_checker.oo";

pub fn main() {
    let code_integrity_hmac_checker_mark: Int = 0;
    if code_integrity_hmac_checker_mark != 0 {
        process_exit(1);
    }
    let code_integrity_hmac_checker_a = integrity_checker_state_new(1);
    let code_integrity_hmac_checker_b = integrity_checker_state_new(1);
    if (code_integrity_hmac_checker_a).secret_key != (code_integrity_hmac_checker_b).secret_key {
        println("FAIL integrity_checker_state_new");
        process_exit(1);
    }
    println("prod_code_integrity_hmac_checker: PASSED");
}
