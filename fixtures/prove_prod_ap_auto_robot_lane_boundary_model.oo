// # Product prove std/auto_robot/lane_boundary_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/lane_boundary_model.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/lane_boundary_model.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lane_boundary_model: PASSED only if they match.

import "std/auto_robot/lane_boundary_model.oo";

pub fn main() {
    let lane_boundary_model_a = lane_lin_y(0, 0, 0);
    let lane_boundary_model_b = lane_lin_y(0, 0, 0);
    if lane_boundary_model_a != lane_boundary_model_b {
        println("FAIL lane_boundary_model");
        process_exit(1);
    }
    println("prod_ap_lane_boundary_model: PASSED");
}
