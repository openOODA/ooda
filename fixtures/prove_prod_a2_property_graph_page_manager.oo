// # Product prove std/db_graph/property_graph_page_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_page_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_page_manager.oo.
//
// Beats:
//   1. Call graph_page_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_page_manager: PASSED only if they match.

import "std/db_graph/property_graph_page_manager.oo";

pub fn main() {
    let property_graph_page_manager_mark: Int = 0;
    if property_graph_page_manager_mark != 0 {
        process_exit(1);
    }
    let a: GraphPageHeader = graph_page_header_new(0, 0);
    let b: GraphPageHeader = graph_page_header_new(0, 0);
    if (a).page_id != (b).page_id {
        println("FAIL graph_page_header_new");
        process_exit(1);
    }
    println("prod_property_graph_page_manager: PASSED");
}
