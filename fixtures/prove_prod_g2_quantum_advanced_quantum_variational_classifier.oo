// # Product prove std/quantum_advanced/quantum_variational_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts vqc_prediction_to_probability is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_variational_classifier.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call vqc_prediction_to_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_variational_classifier: PASSED only if they match.

import "std/quantum_advanced/quantum_variational_classifier.oo";

pub fn main() {
    let g2_a = vqc_prediction_to_probability(1.0);
    let g2_b = vqc_prediction_to_probability(1.0);
    if g2_a != g2_b {
        println("FAIL vqc_prediction_to_probability");
        process_exit(1);
    }
    println("prod_g2_quantum_variational_classifier: PASSED");
}
