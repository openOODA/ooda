// # Product prove std/grid/freq_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts grid_freq_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq_types.oo.
//
// Beats:
//   1. Call grid_freq_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_freq_types: PASSED only if they match.

import "std/grid/freq_types.oo";

pub fn main() {
    let freq_types_mark: Int = 0;
    if freq_types_mark != 0 {
        process_exit(1);
    }
    let a: GridFrequency = grid_freq_new(0, 0, 0);
    let b: GridFrequency = grid_freq_new(0, 0, 0);
    if (a).nominal_mhz != (b).nominal_mhz {
        println("FAIL grid_freq_new");
        process_exit(1);
    }
    println("prod_freq_types: PASSED");
}
