// # Product prove std/tda_topology/ball_mapper_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts ball_node_add_point is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/ball_mapper_algorithm.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ball_node_add_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ball_mapper_algorithm: PASSED only if they match.

import "std/tda_topology/ball_mapper_algorithm.oo";

pub fn main() {
    let mut g0_oa: BallNode = BallNode { ball_id: 0, center_point_id: 0, radius_epsilon: 0.0, covered_points: list_new(), point_count: 0 };
    let mut g0_ob: BallNode = BallNode { ball_id: 0, center_point_id: 0, radius_epsilon: 0.0, covered_points: list_new(), point_count: 0 };
    let g0_a = ball_node_add_point(&g0_oa, 0);
    let g0_b = ball_node_add_point(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL ball_node_add_point");
        process_exit(1);
    }
    println("prod_gr_ball_mapper_algorithm: PASSED");
}
