// # Product prove std/quantum_open_systems/quantum_zeno_effect_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts zeno_measurement_filter is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_zeno_effect_dynamics.oo.
//
// Beats:
//   1. Call zeno_measurement_filter twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_zeno_effect_dynamics: PASSED only if they match.

import "std/quantum_open_systems/quantum_zeno_effect_dynamics.oo";

pub fn main() {
    let quantum_zeno_effect_dynamics_mark: Int = 0;
    if quantum_zeno_effect_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Float = zeno_measurement_filter(0.0, 0.0);
    let b: Float = zeno_measurement_filter(0.0, 0.0);
    if a != b {
        println("FAIL zeno_measurement_filter");
        process_exit(1);
    }
    println("prod_quantum_zeno_effect_dynamics: PASSED");
}
