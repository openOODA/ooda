// # Product prove std/os/file_lock.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_lock_is_active is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/file_lock.oo.
//
// Beats:
//   1. Call file_lock_is_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_lock: PASSED only if they match.

import "std/os/file_lock.oo";

pub fn main() {
    let obj = file_lock_new("x");
    let a = file_lock_is_active(obj);
    let b = file_lock_is_active(obj);
    if a != b {
        println("FAIL file_lock_is_active");
        process_exit(1);
    }
    println("prod_file_lock: PASSED");
}
