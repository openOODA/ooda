// # Product prove std/web_protocols/oauth2_pkce.oo
//
// Logline: Fail-closed emit+gcc+run asserts pkce_is_valid_char is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/oauth2_pkce.oo.
//
// Beats:
//   1. Call pkce_is_valid_char twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_oauth2_pkce: PASSED only if they match.

import "std/web_protocols/oauth2_pkce.oo";

pub fn main() {
    let oauth2_pkce_mark: Int = 0;
    if oauth2_pkce_mark != 0 {
        process_exit(1);
    }
    let a: Int = pkce_is_valid_char(0);
    let b: Int = pkce_is_valid_char(0);
    if a != b {
        println("FAIL pkce_is_valid_char");
        process_exit(1);
    }
    println("prod_oauth2_pkce: PASSED");
}
