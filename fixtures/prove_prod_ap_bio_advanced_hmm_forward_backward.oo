// # Product prove std/bio_advanced/hmm_forward_backward.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/hmm_forward_backward.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_forward_backward.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hmm_forward_backward: PASSED only if they match.

import "std/bio_advanced/hmm_forward_backward.oo";

pub fn main() {
    let hmm_forward_backward_a = hmm_log_sum_exp(0.0, 0.0);
    let hmm_forward_backward_b = hmm_log_sum_exp(0.0, 0.0);
    if hmm_forward_backward_a != hmm_forward_backward_b {
        println("FAIL hmm_forward_backward");
        process_exit(1);
    }
    println("prod_ap_hmm_forward_backward: PASSED");
}
