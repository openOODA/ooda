// # emit-x86 ident const-int if
//
// Logline: Bind n to 1 and if n equals 1 print yes else no.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Bind n to 1.
//   2. Take the true branch.
//   3. as+ld stdout is yes only.
//
// residual: SysV stays later.

pub fn main() {
    let n = 1;
    if n == 1 {
        println("yes");
    } else {
        println("no");
    }
}
