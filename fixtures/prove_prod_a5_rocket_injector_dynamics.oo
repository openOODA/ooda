// # Product prove std/space_propulsion/rocket_injector_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts injector_coaxial_swirl_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_injector_dynamics.oo.
//
// Beats:
//   1. Call injector_coaxial_swirl_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_injector_dynamics: PASSED only if they match.

import "std/space_propulsion/rocket_injector_dynamics.oo";

pub fn main() {
    let rocket_injector_dynamics_mark: Int = 0;
    if rocket_injector_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: InjectorElement = injector_coaxial_swirl_default();
    let b: InjectorElement = injector_coaxial_swirl_default();
    if (a).element_type != (b).element_type {
        println("FAIL injector_coaxial_swirl_default");
        process_exit(1);
    }
    println("prod_rocket_injector_dynamics: PASSED");
}
