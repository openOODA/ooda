// # Product prove std/sec/sys/kernel_audit_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_perm_has is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit_ops.oo.
//
// Beats:
//   1. Call audit_perm_has twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kernel_audit_ops: PASSED only if they match.

import "std/sec/sys/kernel_audit_ops.oo";

pub fn main() {
    let kernel_audit_ops_mark: Int = 0;
    if kernel_audit_ops_mark != 0 {
        process_exit(1);
    }
    let a: Bool = audit_perm_has(0, 0);
    let b: Bool = audit_perm_has(0, 0);
    if a != b {
        println("FAIL audit_perm_has");
        process_exit(1);
    }
    println("prod_g2_kernel_audit_ops: PASSED");
}
