// # Product prove std/net/http_client.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_client_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http_client.oo.
//
// Beats:
//   1. Call http_client_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http_client: PASSED only if they match.

import "std/net/http_client.oo";

pub fn main() {
    let a: HttpClient = http_client_new();
    let b: HttpClient = http_client_new();
    if a.timeout_ms != b.timeout_ms {
        println("FAIL http_client_new");
        process_exit(1);
    }
    println("prod_http_client: PASSED");
}
