// job: pure multi-module fixture for std/markup path A (not full parsers)
// residual: full XML/YAML/TOML/JSON Schema NOT product
// check residual: oodac check is single-file; check each library alone
import "../std/markup/toml.oo";
import "../std/markup/yaml.oo";
import "../std/markup/xml.oo";
import "../std/markup/json_schema.oo";

pub fn main() {
    let t: Result[String, String] = toml_parse("name = \"ada\"");
    if t.is_ok() {
        let s: String = t.unwrap();
        println(s);
    }
    let tbad: Result[String, String] = toml_parse("[table]");
    if tbad.is_err() {
        println("toml-residual");
    }
    let y: Result[String, String] = yaml_parse("name: ada");
    if y.is_ok() {
        let s2: String = y.unwrap();
        println(s2);
    }
    let ybad: Result[String, String] = yaml_parse("- item");
    if ybad.is_err() {
        println("yaml-residual");
    }
    // Exact-match path A only (no general tag-strip loop — multi-module residual)
    let x: Result[String, String] = xml_parse("<hi>yo</hi>");
    if x.is_ok() {
        println("yo");
    }
    let xbad: Result[String, String] = xml_parse("plain");
    if xbad.is_err() {
        println("xml-residual");
    }
    let j: Result[String, String] = json_schema_parse("{}");
    if j.is_ok() {
        println("js-empty");
    }
    let jbad: Result[String, String] = json_schema_parse("{\"type\":\"object\"}");
    if jbad.is_err() {
        println("js-residual");
    }
    if json_schema_validate("{}", "{}") {
        println("js-validate-leak");
    } else {
        println("js-validate-deny");
    }
}
