// # emit-x86 ident-ident string concat
//
// Logline: Bind a to yy and b to zz and print a plus b so emit-x86 can lower two same-fn string lets.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind a to yy and b to zz.
//   3. Print a plus b.
//
// residual: greet calls stay later.

pub fn main() {
    let a = "yy";
    let b = "zz";
    println(a + b);
}
