// # Product prove std/scicomp/sparse_solver_cg.oo
//
// Logline: Fail-closed emit+gcc+run asserts cg_solver_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/sparse_solver_cg.oo.
//
// Beats:
//   1. Call cg_solver_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cg_solver_config_default: PASSED only if they match.

import "std/scicomp/sparse_solver_cg.oo";

pub fn main() {
    let sparse_solver_cg_mark: Int = 0;
    if sparse_solver_cg_mark != 0 { process_exit(1); }
    let a: CgSolverConfig = cg_solver_config_default();
    let b: CgSolverConfig = cg_solver_config_default();
    if (a).max_iters != (b).max_iters {
        println("FAIL cg_solver_config_default");
        process_exit(1);
    }
    println("prod_cg_solver_config_default: PASSED");
}
