// # Product prove std/zk_rollup/merkle_patricia_trie_delete.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/merkle_patricia_trie_delete.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_delete.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_merkle_patricia_trie_delete: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_delete.oo";

pub fn main() {
    let merkle_patricia_trie_delete_a = mpt_empty_root();
    let merkle_patricia_trie_delete_b = mpt_empty_root();
    if merkle_patricia_trie_delete_a != merkle_patricia_trie_delete_b {
        println("FAIL merkle_patricia_trie_delete");
        process_exit(1);
    }
    println("prod_ap_merkle_patricia_trie_delete: PASSED");
