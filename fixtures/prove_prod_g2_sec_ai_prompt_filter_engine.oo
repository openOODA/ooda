// # Product prove std/sec/ai/prompt_filter_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts prompt_filter_engine_work is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/ai/prompt_filter_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call prompt_filter_engine_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_prompt_filter_engine: PASSED only if they match.

import "std/sec/ai/prompt_filter_engine.oo";

pub fn main() {
    let g2_a = prompt_filter_engine_work(2, 2, 2);
    let g2_b = prompt_filter_engine_work(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL prompt_filter_engine_work");
        process_exit(1);
    }
    println("prod_g2_prompt_filter_engine: PASSED");
}
