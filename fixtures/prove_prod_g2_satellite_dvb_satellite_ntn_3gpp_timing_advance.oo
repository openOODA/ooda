// # Product prove std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntn_float_to_int_ceil is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ntn_float_to_int_ceil twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_ntn_3gpp_timing_advance: PASSED only if they match.

import "std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo";

pub fn main() {
    let g2_a = ntn_float_to_int_ceil(1.0);
    let g2_b = ntn_float_to_int_ceil(1.0);
    if g2_a != g2_b {
        println("FAIL ntn_float_to_int_ceil");
        process_exit(1);
    }
    println("prod_g2_satellite_ntn_3gpp_timing_advance: PASSED");
}
