// # Product prove std/perf/stack_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/stack_allocator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/stack_allocator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stack_allocator: PASSED only if they match.

import "std/perf/stack_allocator.oo";

pub fn main() {
    let stack_allocator_a = stack_alloc_create("x", 0);
    let stack_allocator_b = stack_alloc_create("x", 0);
    let stack_allocator_va = stack_alloc_remaining(stack_allocator_a);
    let stack_allocator_vb = stack_alloc_remaining(stack_allocator_b);
    if stack_allocator_va != stack_allocator_vb {
        println("FAIL stack_allocator");
        process_exit(1);
    }
    println("prod_ap_stack_allocator: PASSED");
}
