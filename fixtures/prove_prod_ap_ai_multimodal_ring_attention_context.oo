// # Product prove std/ai_multimodal/ring_attention_context.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/ring_attention_context.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/ring_attention_context.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ring_attention_context: PASSED only if they match.

import "std/ai_multimodal/ring_attention_context.oo";

pub fn main() {
    let ring_attention_context_a = ring_score(0, 0, 0, 0, 0);
    let ring_attention_context_b = ring_score(0, 0, 0, 0, 0);
    if ring_attention_context_a != ring_attention_context_b {
        println("FAIL ring_attention_context");
        process_exit(1);
    }
    println("prod_ap_ring_attention_context: PASSED");
}
