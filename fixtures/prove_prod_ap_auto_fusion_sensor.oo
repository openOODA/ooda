// # Product prove std/auto/fusion_sensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/fusion_sensor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_sensor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fusion_sensor: PASSED only if they match.

import "std/auto/fusion_sensor.oo";

pub fn main() {
    let fusion_sensor_a = fus_sens_new(0, 0);
    let fusion_sensor_b = fus_sens_new(0, 0);
    let fusion_sensor_va = fus_sens_stype(fusion_sensor_a);
    let fusion_sensor_vb = fus_sens_stype(fusion_sensor_b);
    if fusion_sensor_va != fusion_sensor_vb {
        println("FAIL fusion_sensor");
        process_exit(1);
    }
    println("prod_ap_fusion_sensor: PASSED");
}
