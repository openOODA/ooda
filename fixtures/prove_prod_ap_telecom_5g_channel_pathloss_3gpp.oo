// # Product prove std/telecom_5g/channel_pathloss_3gpp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/channel_pathloss_3gpp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_pathloss_3gpp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_channel_pathloss_3gpp: PASSED only if they match.

import "std/telecom_5g/channel_pathloss_3gpp.oo";

pub fn main() {
    let channel_pathloss_3gpp_a = channel_3gpp_breakpoint_distance_m(0.0, 0.0, 0.0);
    let channel_pathloss_3gpp_b = channel_3gpp_breakpoint_distance_m(0.0, 0.0, 0.0);
    if channel_pathloss_3gpp_a != channel_pathloss_3gpp_b {
        println("FAIL channel_pathloss_3gpp");
        process_exit(1);
    }
    println("prod_ap_channel_pathloss_3gpp: PASSED");
}
