// # Product prove std/auto_mpc_control/tire_dugoff_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts dugoff_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_dugoff_model.oo.
//
// Beats:
//   1. Call dugoff_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tire_dugoff_model: PASSED only if they match.

import "std/auto_mpc_control/tire_dugoff_model.oo";

pub fn main() {
    let tire_dugoff_model_mark: Int = 0;
    if tire_dugoff_model_mark != 0 {
        process_exit(1);
    }
    let a: DugoffParams = dugoff_params_default();
    let b: DugoffParams = dugoff_params_default();
    if (a).stiff_longitudinal != (b).stiff_longitudinal {
        println("FAIL dugoff_params_default");
        process_exit(1);
    }
    println("prod_g2_tire_dugoff_model: PASSED");
}
