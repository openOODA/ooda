// # Product prove std/robotics_ros2/control_impedance_admittance.oo
//
// Logline: Fail-closed emit+gcc+run asserts impedance_params_new is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/control_impedance_admittance.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call impedance_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_control_impedance_admittance: PASSED only if they match.

import "std/robotics_ros2/control_impedance_admittance.oo";

pub fn main() {
    let g2_oa: ImpedanceParameters2D = impedance_params_new(1.0, 1.0, 1.0);
    let g2_ob: ImpedanceParameters2D = impedance_params_new(1.0, 1.0, 1.0);
    let g2_a = (g2_oa).mass_d;
    let g2_b = (g2_ob).mass_d;
    if g2_a != g2_b {
        println("FAIL impedance_params_new.mass_d");
        process_exit(1);
    }
    println("prod_g2_control_impedance_admittance: PASSED");
}
