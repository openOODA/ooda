// # Product prove std/web_ecosystem/path_to_regexp.oo
//
// Logline: Fail-closed emit+gcc+run asserts route_static_match is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/path_to_regexp.oo.
//
// Beats:
//   1. Call route_static_match twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_to_regexp: PASSED only if they match.

import "std/web_ecosystem/path_to_regexp.oo";

pub fn main() {
    let path_to_regexp_mark: Int = 0;
    if path_to_regexp_mark != 0 {
        process_exit(1);
    }
    let a: Int = route_static_match(0, 0);
    let b: Int = route_static_match(0, 0);
    if a != b {
        println("FAIL route_static_match");
        process_exit(1);
    }
    println("prod_path_to_regexp: PASSED");
}
