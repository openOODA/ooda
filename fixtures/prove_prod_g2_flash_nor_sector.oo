// # Product prove std/embedded_hal/flash_nor_sector.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_sector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/flash_nor_sector.oo.
//
// Beats:
//   1. Call flash_sector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_flash_nor_sector: PASSED only if they match.

import "std/embedded_hal/flash_nor_sector.oo";

pub fn main() {
    let flash_nor_sector_mark: Int = 0;
    if flash_nor_sector_mark != 0 {
        process_exit(1);
    }
    let a: FlashSector = flash_sector_new(0, 0, 0);
    let b: FlashSector = flash_sector_new(0, 0, 0);
    if (a).sector_id != (b).sector_id {
        println("FAIL flash_sector_new");
        process_exit(1);
    }
    println("prod_g2_flash_nor_sector: PASSED");
}
