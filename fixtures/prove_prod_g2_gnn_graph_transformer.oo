// # Product prove std/graph_gnn/gnn_graph_transformer.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_transformer_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_graph_transformer.oo.
//
// Beats:
//   1. Call graph_transformer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_graph_transformer: PASSED only if they match.

import "std/graph_gnn/gnn_graph_transformer.oo";

pub fn main() {
    let gnn_graph_transformer_mark: Int = 0;
    if gnn_graph_transformer_mark != 0 {
        process_exit(1);
    }
    let a: GraphTransformerConfig = graph_transformer_config_new(0, 0, 0, 0.0);
    let b: GraphTransformerConfig = graph_transformer_config_new(0, 0, 0, 0.0);
    if (a).model_dim != (b).model_dim {
        println("FAIL graph_transformer_config_new");
        process_exit(1);
    }
    println("prod_g2_gnn_graph_transformer: PASSED");
}
