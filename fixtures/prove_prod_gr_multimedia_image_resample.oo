// # Product prove std/multimedia/image_resample.oo
//
// Logline: Fail-closed emit+gcc+run asserts resample_int_to_f is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/image_resample.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call resample_int_to_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_image_resample: PASSED only if they match.

import "std/multimedia/image_resample.oo";

pub fn main() {
    let g0_a = resample_int_to_f(0);
    let g0_b = resample_int_to_f(0);
    if g0_a != g0_b {
        println("FAIL resample_int_to_f");
        process_exit(1);
    }
    println("prod_gr_image_resample: PASSED");
}
