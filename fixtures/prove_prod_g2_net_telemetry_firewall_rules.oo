// # Product prove std/net_telemetry/firewall_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts firewall_evaluate_packet is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/firewall_rules.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call firewall_evaluate_packet twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_firewall_rules: PASSED only if they match.

import "std/net_telemetry/firewall_rules.oo";

pub fn main() {
    let mut g2_oa = firewall_table_new("x", true);
    let mut g2_ob = firewall_table_new("x", true);
    let g2_a = firewall_evaluate_packet(&g2_oa, true, 2, "x", "x", 2);
    let g2_b = firewall_evaluate_packet(&g2_ob, true, 2, "x", "x", 2);
    if g2_a != g2_b {
        println("FAIL firewall_evaluate_packet");
        process_exit(1);
    }
    println("prod_g2_firewall_rules: PASSED");
}
