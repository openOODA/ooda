// # emit-x86 mut int assign print
//
// Logline: Bind mut n to 1, assign 2, and print n so emit-x86 can lower int mutation.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. Bind mut n to 1 then assign 2.
//   3. Print n and expect 2.

pub fn main() {
    let mut n = 1;
    n = 2;
    println(n);
}
