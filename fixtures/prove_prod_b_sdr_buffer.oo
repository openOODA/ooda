// # Product prove std/telecom/sdr_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_buffer_decimate_step is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/sdr_buffer.oo.
//
// Beats:
//   1. Call sdr_buffer_decimate_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sdr_buffer: PASSED only if they match.

import "std/telecom/sdr_buffer.oo";

pub fn main() {
    let a = sdr_buffer_decimate_step(0, 0);
    let b = sdr_buffer_decimate_step(0, 0);
    if a != b {
        println("FAIL sdr_buffer_decimate_step");
        process_exit(1);
    }
    println("prod_sdr_buffer: PASSED");
}
