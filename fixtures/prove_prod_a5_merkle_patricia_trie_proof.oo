// # Product prove std/zk_rollup/merkle_patricia_trie_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_proof_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_proof.oo.
//
// Beats:
//   1. Call mpt_proof_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_merkle_patricia_trie_proof: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_proof.oo";

pub fn main() {
    let merkle_patricia_trie_proof_mark: Int = 0;
    if merkle_patricia_trie_proof_mark != 0 {
        process_exit(1);
    }
    let a: MptProofNode = mpt_proof_node_new(0, 0, 0);
    let b: MptProofNode = mpt_proof_node_new(0, 0, 0);
    if (a).node_hash != (b).node_hash {
        println("FAIL mpt_proof_node_new");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_proof: PASSED");
}
