// # if true && false is leftover
//
// Logline: A && tail after true must fail closed.
//
// Setup: Folded if true requires LBRACE next.
//
// Beats:
//   1. if true && false print THEN.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if true && false {
        println("THEN");
    }
}
