// # Product vec prove
//
// Logline: Fail-closed emit+gcc+run of shipped vec_push/len/contains.
//
// Setup: Product std/collections/vec.oo. List[Int] destub.
//
// Beats:
//   1. After push 7, len 1; contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/vec.oo";

pub fn main() {
    let mut v: Vec = vec_new();
    v = vec_push(v, 7);
    let n: Int = vec_len(v);
    if n != 1 {
        println("FAIL vec len");
        process_exit(1);
    }
    let c7: Bool = vec_contains(v, 7);
    if c7 == false {
        println("FAIL vec contains 7");
        process_exit(1);
    }
    let c3: Bool = vec_contains(v, 3);
    if c3 == true {
        println("FAIL vec contains 3");
        process_exit(1);
    }
    println("prod_vec: PASSED");
}
