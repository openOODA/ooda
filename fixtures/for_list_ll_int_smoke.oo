// # Collection for-in List[List[Int]] emit lock
//
// Logline: Fail-closed emit+gcc+run of for x in xs over nested List[List[Int]].
//
// Setup: Backend-C. Loop element is List[Int], not an i64 pun.
//
// Beats:
//   1. Push an inner list holding 3 and 4.
//   2. Sum list_get of the inner list via for x in xs.
//   3. Exit 1 before PASSED when the sum is not 7.

pub fn main() {
    let mut inner: List[Int] = list_new();
    inner = list_push(inner, 3);
    inner = list_push(inner, 4);
    let mut xs: List[List[Int]] = list_new();
    xs = list_push(xs, inner);
    let mut s: Int = 0;
    for x in xs {
        s = s + list_get(x, 0) + list_get(x, 1);
    }
    if s != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("for_list_ll_int_smoke: PASSED");
}
