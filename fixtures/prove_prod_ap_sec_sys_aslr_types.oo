// # Product prove std/sec/sys/aslr_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/aslr_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aslr_types: PASSED only if they match.

import "std/sec/sys/aslr_types.oo";

pub fn main() {
    let aslr_types_a = aslr_config_new(0);
    let aslr_types_b = aslr_config_new(0);
    let aslr_types_va = aslr_config_entropy(aslr_types_a);
    let aslr_types_vb = aslr_config_entropy(aslr_types_b);
    if aslr_types_va != aslr_types_vb {
        println("FAIL aslr_types");
        process_exit(1);
    }
    println("prod_ap_aslr_types: PASSED");
}
