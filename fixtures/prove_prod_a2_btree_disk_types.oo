// # Product prove std/database/btree_disk_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts btree_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/btree_disk_types.oo.
//
// Beats:
//   1. Call btree_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_disk_types: PASSED only if they match.

import "std/database/btree_disk_types.oo";

pub fn main() {
    let btree_disk_types_mark: Int = 0;
    if btree_disk_types_mark != 0 {
        process_exit(1);
    }
    let a: BTreeHeader = btree_header_new(0, 0, 0);
    let b: BTreeHeader = btree_header_new(0, 0, 0);
    if (a).root_page_id != (b).root_page_id {
        println("FAIL btree_header_new");
        process_exit(1);
    }
    println("prod_btree_disk_types: PASSED");
}
