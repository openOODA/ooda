// # Refuse a secret sleep_ms duration
//
// Logline: A tagged name must not reach sleep_ms.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the duration.
//   3. Expect the sink to refuse.

// Secret refuse: sleep_ms
// SECRET: token
pub fn main(tcap: &TimeCap) {
    let token = 10;
    let r = sleep_ms(tcap, token);
    println(1);
}
