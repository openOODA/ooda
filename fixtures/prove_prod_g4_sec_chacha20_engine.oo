// # Product prove std/sec/crypto/chacha20_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/chacha20_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20_engine.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_chacha20_engine: PASSED and exit 0 only on match.

import "std/sec/crypto/chacha20_engine.oo";

pub fn main() {
    let pol_a: ChaCha20SecurityPolicy = chacha20_security_policy_default();
    let pol_b: ChaCha20SecurityPolicy = chacha20_security_policy_default();
    if (pol_a).min_rounds != (pol_b).min_rounds {
        println("FAIL chacha20_engine security policy");
        process_exit(1);
    }

    let chacha20_engine_dummy_a: Int = __dummy_std_src_ooda_sec_crypto_chacha20_engine_oo();
    let chacha20_engine_dummy_b: Int = __dummy_std_src_ooda_sec_crypto_chacha20_engine_oo();
    if chacha20_engine_dummy_a != chacha20_engine_dummy_b {
        println("FAIL chacha20_engine dummy");
        process_exit(1);
    }

    let key_res_a: Result[ChaChaKey, String] = chacha_key_create("k1", "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    let key_res_b: Result[ChaChaKey, String] = chacha_key_create("k1", "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    if key_res_a.is_ok() != key_res_b.is_ok() {
        println("FAIL chacha20_engine key create");
        process_exit(1);
    }

    let nonce_res_a: Result[ChaChaNonce, String] = chacha_nonce_create("n1", "000000000000000000000000");
    let nonce_res_b: Result[ChaChaNonce, String] = chacha_nonce_create("n1", "000000000000000000000000");
    if nonce_res_a.is_ok() != nonce_res_b.is_ok() {
        println("FAIL chacha20_engine nonce create");
        process_exit(1);
    }

    println("prod_g4_sec_chacha20_engine: PASSED");
    process_exit(0);
}
