// # Product prove std/quantum_tensor_nets/metts_minimally_entangled.oo
//
// Logline: Fail-closed emit+gcc+run asserts metts_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/metts_minimally_entangled.oo.
//
// Beats:
//   1. Call metts_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_metts_minimally_entangled: PASSED only if they match.

import "std/quantum_tensor_nets/metts_minimally_entangled.oo";

pub fn main() {
    let metts_minimally_entangled_mark: Int = 0;
    if metts_minimally_entangled_mark != 0 {
        process_exit(1);
    }
    let a: MettsConfig = metts_config_default(0, 0.0);
    let b: MettsConfig = metts_config_default(0, 0.0);
    if (a).num_sites != (b).num_sites {
        println("FAIL metts_config_default");
        process_exit(1);
    }
    println("prod_g2_metts_minimally_entangled: PASSED");
}
