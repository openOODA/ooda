// # Product prove std/compilers/llvm_ir_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts llvm_ir_emitter_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_emitter.oo.
//
// Beats:
//   1. Call llvm_ir_emitter_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_llvm_ir_emitter: PASSED only if they match.

import "std/compilers/llvm_ir_emitter.oo";

pub fn main() {
    let llvm_ir_emitter_mark: Int = 0;
    if llvm_ir_emitter_mark != 0 {
        process_exit(1);
    }
    let llvm_ir_emitter_a = llvm_ir_emitter_init(1, 1, 1);
    let llvm_ir_emitter_b = llvm_ir_emitter_init(1, 1, 1);
    if (llvm_ir_emitter_a).kind != (llvm_ir_emitter_b).kind {
        println("FAIL llvm_ir_emitter_init");
        process_exit(1);
    }
    println("prod_llvm_ir_emitter: PASSED");
}
