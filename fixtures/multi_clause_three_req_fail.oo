// # Fail the middle of three requires
//
// Logline: Three simple requires fail at runtime when the middle argument is negative.
//
// Beats:
//   1. Require a, b, and c non-negative.
//   2. Call clamp with b equal to -1.
//   3. Trip the runtime contract rail.

pub fn clamp(a: Int, b: Int, c: Int) -> Int
    requires a >= 0
    requires b >= 0
    requires c >= 0
    ensures result >= 0
{
    return a + b + c;
}
pub fn main() {
    println(clamp(1, -1, 3));
}
