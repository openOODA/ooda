// # Product prove std/fintech_defi/fpml_contract_validator.oo
//
// Logline: Fail-closed emit+gcc+run asserts fpml_trade_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/fpml_contract_validator.oo.
//
// Beats:
//   1. Call fpml_trade_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fpml_contract_validator: PASSED only if they match.

import "std/fintech_defi/fpml_contract_validator.oo";

pub fn main() {
    let fpml_contract_validator_mark: Int = 0;
    if fpml_contract_validator_mark != 0 {
        process_exit(1);
    }
    let fpml_contract_validator_a = fpml_trade_new("x", "x", 1, 1, 1);
    let fpml_contract_validator_b = fpml_trade_new("x", "x", 1, 1, 1);
    if (fpml_contract_validator_a).trade_date != (fpml_contract_validator_b).trade_date {
        println("FAIL fpml_trade_new");
        process_exit(1);
    }
    println("prod_fpml_contract_validator: PASSED");
}
