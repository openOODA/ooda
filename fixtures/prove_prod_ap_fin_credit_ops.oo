// # Product prove std/fin/credit_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/credit_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_credit_ops: PASSED only if they match.

import "std/fin/credit_ops.oo";

pub fn main() {
    let credit_ops_a = credit_facility_calculate_dscr(0.0, 0.0);
    let credit_ops_b = credit_facility_calculate_dscr(0.0, 0.0);
    if credit_ops_a != credit_ops_b {
        println("FAIL credit_ops");
        process_exit(1);
    }
    println("prod_ap_credit_ops: PASSED");
}
