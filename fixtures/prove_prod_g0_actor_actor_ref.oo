// # Product prove std/actor/actor_ref.oo
//
// Logline: Fail-closed emit+gcc+run asserts actor_ref_id is a real value.
//
// Setup: Isolated emit-c. Imports std/actor/actor_ref.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call actor_ref_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_actor_ref: PASSED only if they match.

import "std/actor/actor_ref.oo";

pub fn main() {
    let g0_oa = actor_ref_new("x", "x", 2);
    let g0_ob = actor_ref_new("x", "x", 2);
    let g0_a = actor_ref_id(g0_oa);
    let g0_b = actor_ref_id(g0_ob);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL actor_ref_id");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL actor_ref_id");
        process_exit(1);
    }
    println("prod_g0_actor_ref: PASSED");
}
