// # Product prove std/fin/pricing_stubs.oo
//
// Logline: Fail-closed verification that financial pricing stub imports and option contract constructors are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing_stubs.oo.
//
// Beats:
//   1. Construct call and put option contracts.
//   2. Extract and verify strike prices and contract specifications.
//   3. Assert deterministic return values.
//   4. Print prod_g4_fin_pricing_stubs: PASSED and exit 0.

import "std/fin/pricing_stubs.oo";

pub fn main() {
    let call_a: OptionContract = option_contract_new(1, 100, 105);
    let call_b: OptionContract = option_contract_new(1, 100, 105);
    if (call_a).is_call != (call_b).is_call || (call_a).strike != (call_b).strike {
        println("FAIL option_contract_new deterministic");
        process_exit(1);
    }
    if (call_a).spot != 105 || (call_a).is_call != 1 {
        println("FAIL option_contract_new fields");
        process_exit(1);
    }

    let strike_a: Int = option_contract_strike(call_a);
    let strike_b: Int = option_contract_strike(call_b);
    if strike_a != strike_b || strike_a != 100 {
        println("FAIL option_contract_strike");
        process_exit(1);
    }

    let put_a: OptionContract = option_contract_new(0, 95, 90);
    let put_strike: Int = option_contract_strike(put_a);
    if (put_a).is_call != 0 || put_strike != 95 {
        println("FAIL put option contract");
        process_exit(1);
    }

    println("prod_g4_fin_pricing_stubs: PASSED");
    process_exit(0);
}
