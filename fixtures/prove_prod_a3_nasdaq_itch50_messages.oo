// # Product prove std/fintech_l3_book/nasdaq_itch50_messages.oo
//
// Logline: Fail-closed emit+gcc+run asserts itch_message_payload_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_messages.oo.
//
// Beats:
//   1. Call itch_message_payload_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nasdaq_itch50_messages: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_messages.oo";

pub fn main() {
    let nasdaq_itch50_messages_mark: Int = 0;
    if nasdaq_itch50_messages_mark != 0 {
        process_exit(1);
    }
    let a: Int = itch_message_payload_size("x");
    let b: Int = itch_message_payload_size("x");
    if a != b {
        println("FAIL itch_message_payload_size");
        process_exit(1);
    }
    println("prod_nasdaq_itch50_messages: PASSED");
}
