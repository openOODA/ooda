// # Product prove std/sec/crypto/ckks_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_encoder_init real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ckks_codec.oo.
//
// Beats:
//   1. Call ckks_encoder_init with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_ckks_codec: PASSED only if the assert holds.

import "std/sec/crypto/ckks_codec.oo";

pub fn main() {
    let ckks_codec_a = ckks_encoder_init("x", CkksParams { poly_modulus_degree: 0, scale: 0.0, prime_bits: 0, security_level: 0, max_level: 0, slots_count: 0, is_valid: true }, 2.0);
    let ckks_codec_default_scale: Float = (ckks_codec_a).default_scale;
    if !(ckks_codec_default_scale == 2.0) {
        println("FAIL ckks_encoder_init");
        process_exit(1);
    }
    println("prod_ckks_codec: PASSED");
}
