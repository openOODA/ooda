// # Product prove std/quantum/qasm_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts parse_int_from_str is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/qasm_parser.oo.
//
// Beats:
//   1. Call parse_int_from_str twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qasm_parse_int: PASSED only if they match.

import "std/quantum/qasm_parser.oo";

pub fn main() {
    let qasm_parser_mark: Int = 0;
    if qasm_parser_mark != 0 { process_exit(1); }
    let a: Int = parse_int_from_str("42");
    let b: Int = parse_int_from_str("42");
    if a != b {
        println("FAIL parse_int_from_str");
        process_exit(1);
    }
    println("prod_qasm_parse_int: PASSED");
}
