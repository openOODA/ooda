// # Product prove std/cloud_faas/faas_concurrency_limiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts regional_concurrency_pool_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/faas_concurrency_limiter.oo.
//
// Beats:
//   1. Call regional_concurrency_pool_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_faas_concurrency_limiter: PASSED only if they match.

import "std/cloud_faas/faas_concurrency_limiter.oo";

pub fn main() {
    let faas_concurrency_limiter_mark: Int = 0;
    if faas_concurrency_limiter_mark != 0 {
        process_exit(1);
    }
    let a: RegionalConcurrencyPool = regional_concurrency_pool_new(0, 0);
    let b: RegionalConcurrencyPool = regional_concurrency_pool_new(0, 0);
    if (a).region_id != (b).region_id {
        println("FAIL regional_concurrency_pool_new");
        process_exit(1);
    }
    println("prod_faas_concurrency_limiter: PASSED");
}
