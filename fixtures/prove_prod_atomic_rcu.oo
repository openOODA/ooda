// # Product prove std/sync/atomic_rcu.oo
//
// Logline: Fail-closed emit+gcc+run asserts rcu_version is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/atomic_rcu.oo.
//
// Beats:
//   1. Call rcu_version twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atomic_rcu: PASSED only if they match.

import "std/sync/atomic_rcu.oo";

pub fn main() {
    let obj = rcu_cell_new(0);
    let a = rcu_version(obj);
    let b = rcu_version(obj);
    if a != b {
        println("FAIL rcu_version");
        process_exit(1);
    }
    println("prod_atomic_rcu: PASSED");
}
