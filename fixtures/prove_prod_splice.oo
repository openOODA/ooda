// # Product zero_copy_splice prove
//
// Logline: Fail-closed emit+gcc+run of shipped splice_pipe_new/transfer.
//
// Setup: Product std/io/zero_copy_splice.oo. In-memory fd 3,4 transfer 8.
//
// Beats:
//   1. transfer 8 bytes_spliced 8; total 8.
//   2. Exit 1 before PASSED on a miss.

import "std/io/zero_copy_splice.oo";

pub fn main() {
    let p: SplicePipe = splice_pipe_new(3, 4);
    let res: SpliceResult = splice_transfer(p, 8);
    let n: Int = res.bytes_spliced;
    if n != 8 {
        println("FAIL splice n");
        process_exit(1);
    }
    let tot: Int = splice_bytes_total(res.pipe);
    if tot != 8 {
        println("FAIL splice tot");
        process_exit(1);
    }
    println("prod_splice: PASSED");
}
