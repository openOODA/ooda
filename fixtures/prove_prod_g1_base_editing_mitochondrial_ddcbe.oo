// # Product prove std/crispr_cas/base_editing_mitochondrial_ddcbe.oo
//
// Logline: Fail-closed emit+gcc+run asserts ddcbe_validate_spacing is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/base_editing_mitochondrial_ddcbe.oo.
//
// Beats:
//   1. Call ddcbe_validate_spacing twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_base_editing_mitochondrial_ddcbe: PASSED only if they match.

import "std/crispr_cas/base_editing_mitochondrial_ddcbe.oo";

pub fn main() {
    let a: Bool = ddcbe_validate_spacing(0);
    let b: Bool = ddcbe_validate_spacing(0);
    if a != b {
        println("FAIL ddcbe_validate_spacing");
        process_exit(1);
    }
    println("prod_base_editing_mitochondrial_ddcbe: PASSED");
}
