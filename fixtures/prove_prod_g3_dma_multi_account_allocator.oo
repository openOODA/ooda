// # Product prove std/fintech_l3_book/dma_multi_account_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts account_allocation_target_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_multi_account_allocator.oo.
//
// Beats:
//   1. Call account_allocation_target_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_multi_account_allocator: PASSED only if they match.

import "std/fintech_l3_book/dma_multi_account_allocator.oo";

pub fn main() {
    let dma_multi_account_allocator_mark: Int = 0;
    if dma_multi_account_allocator_mark != 0 {
        process_exit(1);
    }
    let a: AccountAllocationTarget = account_allocation_target_new("x", 0);
    let b: AccountAllocationTarget = account_allocation_target_new("x", 0);
    if (a).target_shares != (b).target_shares {
        println("FAIL account_allocation_target_new");
        process_exit(1);
    }
    println("prod_dma_multi_account_allocator: PASSED");
}
