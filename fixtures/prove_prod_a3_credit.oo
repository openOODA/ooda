// # Product prove std/fin/credit.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_borrower_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit.oo.
//
// Beats:
//   1. Call shim_marker_borrower_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_credit: PASSED only if they match.

import "std/fin/credit.oo";

pub fn main() {
    let credit_mark: Int = 0;
    if credit_mark != 0 {
        process_exit(1);
    }
    let a: BorrowerProfile = shim_marker_borrower_new();
    let b: BorrowerProfile = shim_marker_borrower_new();
    if (a).credit_history_months != (b).credit_history_months {
        println("FAIL shim_marker_borrower_new");
        process_exit(1);
    }
    println("prod_credit: PASSED");
}
