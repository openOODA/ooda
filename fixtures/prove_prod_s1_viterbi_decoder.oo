// # Product prove std/telecom/viterbi_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts viterbi_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/viterbi_decoder.oo.
//
// Beats:
//   1. Call viterbi_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_viterbi_decoder: PASSED only if they match.

import "std/telecom/viterbi_decoder.oo";

pub fn main() {
    let viterbi_decoder_mark: Int = 0;
    if viterbi_decoder_mark != 0 {
        process_exit(1);
    }
    let viterbi_decoder_a: Float = viterbi_int_to_float(1);
    let viterbi_decoder_b: Float = viterbi_int_to_float(1);
    if viterbi_decoder_a != viterbi_decoder_b {
        println("FAIL viterbi_int_to_float");
        process_exit(1);
    }
    println("prod_viterbi_decoder: PASSED");
}
