// # Product prove std/sec/sys/stackcanary_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_integrity_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/stackcanary_types.oo.
//
// Beats:
//   1. Call stack_integrity_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stackcanary_types: PASSED only if they match.

import "std/sec/sys/stackcanary_types.oo";

pub fn main() {
    let obj = stack_integrity_new();
    let a = obj.total_frames_checked;
    let b = obj.total_frames_checked;
    if a != b {
        println("FAIL stack_integrity_new");
        process_exit(1);
    }
    println("prod_stackcanary_types: PASSED");
}
