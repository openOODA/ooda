// # Product prove std/sec/crypto/zksnark_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts zk_snark_policy_init value or determinism.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_ops.oo.
//
// Beats:
//   1. Call zk_snark_policy_init twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_zksnark_ops: PASSED only if asserts hold.

import "std/sec/crypto/zksnark_ops.oo";

pub fn main() {
    let zksnark_ops = zk_snark_policy_init("x", 2, "x", true);
    let zksnark_ops_b = zk_snark_policy_init("x", 2, "x", true);
    if (zksnark_ops).require_trusted_setup != true {
        println("FAIL zk_snark_policy_init require_trusted_setup");
        process_exit(1);
    }
    if (zksnark_ops).require_trusted_setup != (zksnark_ops_b).require_trusted_setup {
        println("FAIL zk_snark_policy_init det");
        process_exit(1);
    }
    println("prod_zksnark_ops: PASSED");
}
