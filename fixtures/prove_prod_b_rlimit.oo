// # Product prove std/sec/rlimit.oo
//
// Logline: Fail-closed emit+gcc+run asserts rlimit_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/rlimit.oo.
//
// Beats:
//   1. Call rlimit_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rlimit: PASSED only if they match.

import "std/sec/rlimit.oo";

pub fn main() {
    let a = rlimit_probe();
    let b = rlimit_probe();
    if a != b {
        println("FAIL rlimit_probe");
        process_exit(1);
    }
    println("prod_rlimit: PASSED");
}
