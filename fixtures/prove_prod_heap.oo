// # Product binary_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped heap_push/len/contains.
//
// Setup: Product std/collections/binary_heap.oo. Max-heap List[Int].
//
// Beats:
//   1. Empty heap is empty; after 3 and 7, len 2; contains 7 true; contains 1 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/binary_heap.oo";

pub fn main() {
    let mut h: BinaryHeap = heap_new();
    let e: Bool = heap_is_empty(h);
    if e == false {
        println("FAIL heap empty");
        process_exit(1);
    }
    h = heap_push(h, 3);
    h = heap_push(h, 7);
    let n: Int = heap_len(h);
    if n != 2 {
        println("FAIL heap len");
        process_exit(1);
    }
    let c7: Bool = heap_contains(h, 7);
    if c7 == false {
        println("FAIL heap contains 7");
        process_exit(1);
    }
    let c1: Bool = heap_contains(h, 1);
    if c1 == true {
        println("FAIL heap contains 1");
        process_exit(1);
    }
    println("prod_heap: PASSED");
}
