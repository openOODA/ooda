// # Product prove std/exploit_analysis/payload_bad_instruction_scanner.oo
//
// Logline: Fail-closed emit+gcc+run asserts payload_scan_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/payload_bad_instruction_scanner.oo.
//
// Beats:
//   1. Call payload_scan_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_payload_bad_instruction_scanner: PASSED only if they match.

import "std/exploit_analysis/payload_bad_instruction_scanner.oo";

pub fn main() {
    let payload_bad_instruction_scanner_mark: Int = 0;
    if payload_bad_instruction_scanner_mark != 0 {
        process_exit(1);
    }
    let a: PayloadScanResult = payload_scan_bytes(list_new());
    let b: PayloadScanResult = payload_scan_bytes(list_new());
    if (a).anomaly_count != (b).anomaly_count {
        println("FAIL payload_scan_bytes");
        process_exit(1);
    }
    println("prod_payload_bad_instruction_scanner: PASSED");
}
