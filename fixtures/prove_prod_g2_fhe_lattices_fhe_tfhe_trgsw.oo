// # Product prove std/fhe_lattices/fhe_tfhe_trgsw.oo
//
// Logline: Fail-closed emit+gcc+run asserts torus_cmux_eval_selector is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_tfhe_trgsw.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call torus_cmux_eval_selector twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_tfhe_trgsw: PASSED only if they match.

import "std/fhe_lattices/fhe_tfhe_trgsw.oo";

pub fn main() {
    let g2_a = torus_cmux_eval_selector(1.0, 1.0, 1.0);
    let g2_b = torus_cmux_eval_selector(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL torus_cmux_eval_selector");
        process_exit(1);
    }
    println("prod_g2_fhe_tfhe_trgsw: PASSED");
}
