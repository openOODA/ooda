// # Product prove std/deep_ai/tool_call_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts tool_call_parser_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/tool_call_parser.oo.
//
// Beats:
//   1. Call tool_call_parser_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tool_call_parser: PASSED only if they match.

import "std/deep_ai/tool_call_parser.oo";

pub fn main() {
    let a: Int = tool_call_parser_marker();
    let b: Int = tool_call_parser_marker();
    if a != b {
        println("FAIL tool_call_parser_marker");
        process_exit(1);
    }
    println("prod_tool_call_parser: PASSED");
}
