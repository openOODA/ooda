// # Product cloud_k8s pn counter prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/crdt_pn_counter.oo.
//
// Setup: Product std/cloud_k8s/crdt_pn_counter.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. inc 5 then dec 2 reads 3.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/crdt_pn_counter.oo";

pub fn main() {
    let c0: PNCounter = pn_counter_new();
    let z: Int = pn_counter_read(c0);
    if z != 0 {
        println("FAIL pn 0");
        process_exit(1);
    }
    let c1: PNCounter = pn_counter_increment(c0, 0, 5);
    let c2: PNCounter = pn_counter_decrement(c1, 1, 2);
    let n: Int = pn_counter_read(c2);
    if n != 3 {
        println("FAIL pn 3");
        process_exit(1);
    }
    println("prod_pnctr: PASSED");
}
