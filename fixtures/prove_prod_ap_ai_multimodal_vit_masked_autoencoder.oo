// # Product prove std/ai_multimodal/vit_masked_autoencoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/vit_masked_autoencoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_masked_autoencoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vit_masked_autoencoder: PASSED only if they match.

import "std/ai_multimodal/vit_masked_autoencoder.oo";

pub fn main() {
    let vit_masked_autoencoder_a = mae_n_keep(0, 0);
    let vit_masked_autoencoder_b = mae_n_keep(0, 0);
    if vit_masked_autoencoder_a != vit_masked_autoencoder_b {
        println("FAIL vit_masked_autoencoder");
        process_exit(1);
    }
    println("prod_ap_vit_masked_autoencoder: PASSED");
}
