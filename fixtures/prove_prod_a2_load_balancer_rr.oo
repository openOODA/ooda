// # Product prove std/cloud/load_balancer_rr.oo
//
// Logline: Fail-closed emit+gcc+run asserts load_balancer_rr_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/load_balancer_rr.oo.
//
// Beats:
//   1. Call load_balancer_rr_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_load_balancer_rr: PASSED only if they match.

import "std/cloud/load_balancer_rr.oo";

pub fn main() {
    let a: LoadBalancerRr = load_balancer_rr_new(0, 0);
    let b: LoadBalancerRr = load_balancer_rr_new(0, 0);
    if (a).w0 != (b).w0 {
        println("FAIL load_balancer_rr_new");
        process_exit(1);
    }
    println("prod_load_balancer_rr: PASSED");
}
