// # Product prove std/sec/crypto/double_ratchet.oo
//
// Logline: Fail-closed emit+gcc+run asserts double ratchet operations and chain keys are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/double_ratchet.oo.
//
// Beats:
//   1. Verify checksum calculation and hex encode/decode roundtrips.
//   2. Validate constant-time string comparisons.
//   3. Construct and inspect ChainKey instances.
//   4. Print prod_g4_sec_double_ratchet: PASSED and exit 0.

import "std/sec/crypto/double_ratchet.oo";

pub fn main() {
    let cs1: Int = double_ratchet_checksum("test_payload_vector");
    let cs2: Int = double_ratchet_checksum("test_payload_vector");
    if cs1 != cs2 {
        println("FAIL double_ratchet_checksum");
        process_exit(1);
    }

    let hex1: String = double_ratchet_hex_encode("hello_ratchet");
    let hex2: String = double_ratchet_hex_encode("hello_ratchet");
    if hex1 != hex2 || chars_len(hex1) == 0 {
        println("FAIL double_ratchet_hex_encode");
        process_exit(1);
    }

    let dec_res1: Result[String, String] = double_ratchet_hex_decode(hex1);
    let dec_res2: Result[String, String] = double_ratchet_hex_decode(hex2);
    let dec1: String = match dec_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let dec2: String = match dec_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec1 != dec2 || dec1 != "hello_ratchet" {
        println("FAIL double_ratchet_hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = double_ratchet_constant_time_eq("key_abc", "key_abc");
    let eq_b: Bool = double_ratchet_constant_time_eq("key_abc", "key_abc");
    if eq_a != eq_b || eq_a == false {
        println("FAIL double_ratchet_constant_time_eq true");
        process_exit(1);
    }

    let neq_a: Bool = double_ratchet_constant_time_eq("key_abc", "key_xyz");
    let neq_b: Bool = double_ratchet_constant_time_eq("key_abc", "key_xyz");
    if neq_a != neq_b || neq_a == true {
        println("FAIL double_ratchet_constant_time_eq false");
        process_exit(1);
    }

    let ck1: ChainKey = ratchet_chain_new(42, cs1, 1);
    let ck2: ChainKey = ratchet_chain_new(42, cs2, 1);
    if ratchet_chain_index(ck1) != ratchet_chain_index(ck2) || (ck1).checksum != (ck2).checksum {
        println("FAIL ratchet_chain");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_double_ratchet_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_double_ratchet: PASSED");
    process_exit(0);
}
