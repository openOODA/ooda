// # Product prove std/pbr_raytracing/brdf_thin_film_iridescence.oo
//
// Logline: Fail-closed emit+gcc+run asserts brdf_thin_film_iridescence_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_thin_film_iridescence.oo.
//
// Beats:
//   1. Call brdf_thin_film_iridescence_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_brdf_thin_film_iridescence: PASSED only if it matches.

import "std/pbr_raytracing/brdf_thin_film_iridescence.oo";

pub fn main() {
    let a: Int = brdf_thin_film_iridescence_probe();
    if a != 0 {
        println("FAIL brdf_thin_film_iridescence_probe");
        process_exit(1);
    }
    println("prod_nc_brdf_thin_film_iridescence: PASSED");
}
