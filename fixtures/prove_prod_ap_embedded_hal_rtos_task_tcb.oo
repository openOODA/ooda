// # Product prove std/embedded_hal/rtos_task_tcb.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/rtos_task_tcb.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_task_tcb.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rtos_task_tcb: PASSED only if they match.

import "std/embedded_hal/rtos_task_tcb.oo";

pub fn main() {
    let rtos_task_tcb_a = rtos_tcb_new(0, "x", 0, 0, 0);
    let rtos_task_tcb_b = rtos_tcb_new(0, "x", 0, 0, 0);
    let rtos_task_tcb_va = rtos_tcb_is_ready(rtos_task_tcb_a);
    let rtos_task_tcb_vb = rtos_tcb_is_ready(rtos_task_tcb_b);
    if rtos_task_tcb_va != rtos_task_tcb_vb {
        println("FAIL rtos_task_tcb");
        process_exit(1);
    }
    println("prod_ap_rtos_task_tcb: PASSED");
}
