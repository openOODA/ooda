// # Product prove std/quantum_tensor_nets/tensor_qr_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts qr_decompose_2x2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tensor_qr_decomposition.oo.
//
// Beats:
//   1. Call qr_decompose_2x2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tensor_qr_decomposition: PASSED only if they match.

import "std/quantum_tensor_nets/tensor_qr_decomposition.oo";

pub fn main() {
    let tensor_qr_decomposition_mark: Int = 0;
    if tensor_qr_decomposition_mark != 0 {
        process_exit(1);
    }
    let a: QrResult2x2 = qr_decompose_2x2(0.0, 0.0, 0.0, 0.0);
    let b: QrResult2x2 = qr_decompose_2x2(0.0, 0.0, 0.0, 0.0);
    if (a).q00 != (b).q00 {
        println("FAIL qr_decompose_2x2");
        process_exit(1);
    }
    println("prod_g2_tensor_qr_decomposition: PASSED");
}
