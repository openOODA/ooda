// # OPEN-91 emit_ptx product
//
// Logline: Emit host PTX text and print PASSED.
//
// Setup: emit_ptx is product, not residual refuse.
//
// Beats:
//   1. Call emit_ptx.
//   2. Require 0.
//   3. Print open91: PASSED.

pub fn main() {
    let n = emit_ptx();
    if n != 0 {
        println("FAIL");
        process_exit(1);
    }
    println("open91: PASSED");
}
