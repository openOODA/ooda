// # OPEN-91 emit_ptx writes an add.s64 kernel
//
// Logline: emit_ptx returns the byte count of a real add kernel. It must not print PASSED.
//
// Setup: runtime/chs_rt_vision.c writes .ooda-cache/ooda-tmp/ooda_emit.ptx.
//
// Beats:
//   1. Byte count is more than a ret-only stub.
//   2. The caller prints open91: PASSED.
//   3. A dummy that returns 0 fails.

pub fn main() {
    let n = emit_ptx();
    if n < 40 {
        println("FAIL short");
        process_exit(1);
    }
    println("open91: PASSED");
}
