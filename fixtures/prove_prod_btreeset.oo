// # Product btree_set prove
//
// Logline: Fail-closed emit+gcc+run of shipped btree_set_insert/contains/len.
//
// Setup: Product std/collections/btree_set.oo. List[Int] destub.
//
// Beats:
//   1. After insert 7, contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/btree_set.oo";

pub fn main() {
    let mut s: BTreeSet = btree_set_new();
    s = btree_set_insert(s, 7);
    let n: Int = btree_set_len(s);
    if n != 1 {
        println("FAIL btreeset len");
        process_exit(1);
    }
    let c7: Bool = btree_set_contains(s, 7);
    if c7 == false {
        println("FAIL btreeset 7");
        process_exit(1);
    }
    let c3: Bool = btree_set_contains(s, 3);
    if c3 == true {
        println("FAIL btreeset 3");
        process_exit(1);
    }
    println("prod_btreeset: PASSED");
}
