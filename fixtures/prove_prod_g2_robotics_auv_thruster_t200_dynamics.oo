// # Product prove std/robotics_auv/thruster_t200_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts t200_clamp_int is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/thruster_t200_dynamics.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call t200_clamp_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thruster_t200_dynamics: PASSED only if they match.

import "std/robotics_auv/thruster_t200_dynamics.oo";

pub fn main() {
    let g2_a = t200_clamp_int(2, 2, 2);
    let g2_b = t200_clamp_int(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL t200_clamp_int");
        process_exit(1);
    }
    println("prod_g2_thruster_t200_dynamics: PASSED");
}
