// # Product prove std/fin/credit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/credit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_credit: PASSED only if they match.

import "std/fin/credit.oo";

pub fn main() {
    let credit_a = shim_marker_borrower_new();
    let credit_b = shim_marker_borrower_new();
    let credit_va = shim_marker_dti(credit_a);
    let credit_vb = shim_marker_dti(credit_b);
    if credit_va != credit_vb {
        println("FAIL credit");
        process_exit(1);
    }
    println("prod_ap_credit: PASSED");
}
