// # Product prove std/web_ecosystem/multipart_boundary.oo
//
// Logline: Fail-closed emit+gcc+run asserts multipart_boundary_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/multipart_boundary.oo.
//
// Beats:
//   1. Call multipart_boundary_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_multipart_boundary: PASSED only if they match.

import "std/web_ecosystem/multipart_boundary.oo";

pub fn main() {
    let a: Int = multipart_boundary_hash(0);
    let b: Int = multipart_boundary_hash(0);
    if a != b {
        println("FAIL multipart_boundary_hash");
        process_exit(1);
    }
    println("prod_multipart_boundary: PASSED");
}
