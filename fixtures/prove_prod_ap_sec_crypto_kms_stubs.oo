// # Product prove std/sec/crypto/kms_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kms_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kms_stubs: PASSED only if they match.

import "std/sec/crypto/kms_stubs.oo";

pub fn main() {
    let kms_stubs_a = kms_module_ready();
    let kms_stubs_b = kms_module_ready();
    if kms_stubs_a != kms_stubs_b {
        println("FAIL kms_stubs");
        process_exit(1);
    }
    println("prod_ap_kms_stubs: PASSED");
}
