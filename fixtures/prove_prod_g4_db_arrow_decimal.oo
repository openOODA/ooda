// # Product prove std/db_columnar/arrow_decimal_array.oo
//
// Logline: Fail-closed verification that Apache Arrow Decimal128 conversions, addition, and decimal arrays are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_decimal_array.oo.
//
// Beats:
//   1. Convert integer values to Decimal128 structures.
//   2. Add Decimal128 values and assert deterministic sums and signs.
//   3. Create ArrowDecimalArray and push values.
//   4. Assert deterministic array lengths and null counts.
//   5. Print prod_g4_db_arrow_decimal: PASSED and exit 0.

import "std/db_columnar/arrow_decimal_array.oo";

pub fn main() {
    let d1: Decimal128 = decimal128_from_int(12345);
    let d2: Decimal128 = decimal128_from_int(67890);

    if d1.high != 0 || d1.low != 12345 || d1.is_negative != false {
        println("FAIL decimal128_from_int d1");
        process_exit(1);
    }

    let sum1: Decimal128 = decimal128_add(d1, d2);
    let sum2: Decimal128 = decimal128_add(d1, d2);

    if sum1.high != sum2.high || sum1.low != sum2.low || sum1.is_negative != sum2.is_negative {
        println("FAIL decimal128_add deterministic");
        process_exit(1);
    }

    if sum1.low != 80235 {
        println("FAIL decimal128_add result");
        process_exit(1);
    }

    let arr0: ArrowDecimalArray = arrow_decimal_array_new(38, 9);
    let arr1: ArrowDecimalArray = arrow_decimal_array_push(arr0, d1, true);
    let arr2: ArrowDecimalArray = arrow_decimal_array_push(arr1, d2, false);

    if arr2.length != 2 || arr2.null_count != 1 {
        println("FAIL arrow_decimal_array_push");
        process_exit(1);
    }

    let cfg: DecimalConfig = arr2.config;
    if cfg.precision != 38 || cfg.scale != 9 {
        println("FAIL decimal config");
        process_exit(1);
    }

    println("prod_g4_db_arrow_decimal: PASSED");
    process_exit(0);
}
