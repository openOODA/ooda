// # Product prove std/hash/murmur3.oo
//
// Logline: Fail-closed emit+gcc+run asserts murmur3_32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/murmur3.oo.
//
// Beats:
//   1. Call murmur3_32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_murmur3: PASSED only if they match.

import "std/hash/murmur3.oo";

pub fn main() {
    let a = murmur3_32("x");
    let b = murmur3_32("x");
    if a != b {
        println("FAIL murmur3_32");
        process_exit(1);
    }
    println("prod_murmur3: PASSED");
}
