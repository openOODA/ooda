// # Product prove std/tda_topology/sparse_chain_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts chain_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sparse_chain_complex.oo.
//
// Beats:
//   1. Call chain_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_chain_complex: PASSED only if they match.

import "std/tda_topology/sparse_chain_complex.oo";

pub fn main() {
    let sparse_chain_complex_mark: Int = 0;
    if sparse_chain_complex_mark != 0 {
        process_exit(1);
    }
    let sparse_chain_complex_a = chain_new(1);
    let sparse_chain_complex_b = chain_new(1);
    if (sparse_chain_complex_a).dimension != (sparse_chain_complex_b).dimension {
        println("FAIL chain_new");
        process_exit(1);
    }
    println("prod_sparse_chain_complex: PASSED");
}
