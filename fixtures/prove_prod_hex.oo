// # Product hex encode/decode
//
// Logline: RFC 4648 Base16 of hello is 68656c6c6f; decode returns hello.
//
// Setup: Product std/encoding/hex.oo. Destub none. No caps.
//
// Beats:
//   1. hex_encode("hello") equals 68656c6c6f.
//   2. hex_decode of that is Ok("hello"); Err is fail-closed.
//   3. Miss process_exit(1) before PASSED.

import "std/encoding/hex.oo";

pub fn main() {
    let enc: String = hex_encode("hello");
    if enc != "68656c6c6f" {
        println("FAIL hex_encode");
        process_exit(1);
    }
    let dec_r: Result[String, String] = hex_decode("68656c6c6f");
    if dec_r.is_err() {
        println("FAIL hex_decode err");
        process_exit(1);
    }
    let dec: String = dec_r.unwrap();
    if dec != "hello" {
        println("FAIL hex_decode");
        process_exit(1);
    }
    println("prod_hex: PASSED");
}
