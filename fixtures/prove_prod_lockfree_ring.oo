// # Product prove std/sync/lockfree_ring.oo
//
// Logline: Fail-closed emit+gcc+run asserts lockfree_ring_capacity is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/lockfree_ring.oo.
//
// Beats:
//   1. Call lockfree_ring_capacity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lockfree_ring: PASSED only if they match.

import "std/sync/lockfree_ring.oo";

pub fn main() {
    let obj = lockfree_ring_new(0);
    let a = lockfree_ring_capacity(obj);
    let b = lockfree_ring_capacity(obj);
    if a != b {
        println("FAIL lockfree_ring_capacity");
        process_exit(1);
    }
    println("prod_lockfree_ring: PASSED");
}
