// # SHA-256 lock verify (no registry)
//
// Logline: Same lock payload hashes equal; a tampered checksum does not. Not a live registry.
//
// Setup: OPEN-42. crypto_sha256_internal. Local SHA-256; no network registry.
//
// Beats:
//   1. Hash pkg@1.0|core/foo@2.0#abc twice.
//   2. Hash tampered pkg@1.0|core/foo@2.0#EVIL.
//   3. Equal, unequal, length 64. Print PASSED.

pub fn main() {
    let h1: String = crypto_sha256_internal("pkg@1.0|core/foo@2.0#abc");
    let h2: String = crypto_sha256_internal("pkg@1.0|core/foo@2.0#abc");
    let h3: String = crypto_sha256_internal("pkg@1.0|core/foo@2.0#EVIL");
    if h1 != h2 {
        println("FAIL match");
        process_exit(1);
    }
    if h1 == h3 {
        println("FAIL tamper");
        process_exit(1);
    }
    let n: Int = chars_len(h1);
    if n != 64 {
        println("FAIL len");
        process_exit(1);
    }
    println(n);
    println("open_lock_verify: PASSED");
}
