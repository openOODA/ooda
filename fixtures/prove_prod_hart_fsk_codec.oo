// # Product prove std/iot_scada/hart_fsk_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts hart_frame_new real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/hart_fsk_codec.oo.
//
// Beats:
//   1. Call hart_frame_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_hart_fsk_codec: PASSED only if the assert holds.

import "std/iot_scada/hart_fsk_codec.oo";

pub fn main() {
    let hart_fsk_codec_a = hart_frame_new(7, true);
    let hart_fsk_codec_preamble_length: Int = (hart_fsk_codec_a).preamble_length;
    if hart_fsk_codec_preamble_length != 5 {
        println("FAIL hart_frame_new");
        process_exit(1);
    }
    println("prod_hart_fsk_codec: PASSED");
}
