// # Product prove std/tda_topology/cubical_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts cubical_grid_2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/cubical_complex_filtration.oo.
//
// Beats:
//   1. Call cubical_grid_2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cubical_complex_filtration: PASSED only if they match.

import "std/tda_topology/cubical_complex_filtration.oo";

pub fn main() {
    let cubical_complex_filtration_mark: Int = 0;
    if cubical_complex_filtration_mark != 0 {
        process_exit(1);
    }
    let cubical_complex_filtration_a = cubical_grid_2d_new(1, 1);
    let cubical_complex_filtration_b = cubical_grid_2d_new(1, 1);
    if (cubical_complex_filtration_a).width != (cubical_complex_filtration_b).width {
        println("FAIL cubical_grid_2d_new");
        process_exit(1);
    }
    println("prod_cubical_complex_filtration: PASSED");
}
