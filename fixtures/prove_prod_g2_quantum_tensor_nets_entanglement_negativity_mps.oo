// # Product prove std/quantum_tensor_nets/entanglement_negativity_mps.oo
//
// Logline: Fail-closed emit+gcc+run asserts partial_transpose_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/entanglement_negativity_mps.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call partial_transpose_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_entanglement_negativity_mps: PASSED only if they match.

import "std/quantum_tensor_nets/entanglement_negativity_mps.oo";

pub fn main() {
    let g2_oa: PartialTransposeConfig = partial_transpose_config_default();
    let g2_ob: PartialTransposeConfig = partial_transpose_config_default();
    let g2_a = (g2_oa).max_transfer_bond;
    let g2_b = (g2_ob).max_transfer_bond;
    if g2_a != g2_b {
        println("FAIL partial_transpose_config_default.max_transfer_bond");
        process_exit(1);
    }
    println("prod_g2_entanglement_negativity_mps: PASSED");
}
