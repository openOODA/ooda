// # Product prove std/bio/cell_agent.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/cell_agent.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_agent.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cell_agent: PASSED only if they match.

import "std/bio/cell_agent.oo";

pub fn main() {
    let cell_agent_a = agent_cell_new(0, "x", 0.0, 0.0);
    let cell_agent_b = agent_cell_new(0, "x", 0.0, 0.0);
    let cell_agent_va = agent_cell_is_alive(cell_agent_a);
    let cell_agent_vb = agent_cell_is_alive(cell_agent_b);
    if cell_agent_va != cell_agent_vb {
        println("FAIL cell_agent");
        process_exit(1);
    }
    println("prod_ap_cell_agent: PASSED");
}
