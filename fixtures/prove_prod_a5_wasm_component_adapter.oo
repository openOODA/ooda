// # Product prove std/wasm_gc/wasm_component_adapter.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasi_errno_success is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_adapter.oo.
//
// Beats:
//   1. Call wasi_errno_success twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_adapter: PASSED only if they match.

import "std/wasm_gc/wasm_component_adapter.oo";

pub fn main() {
    let wasm_component_adapter_mark: Int = 0;
    if wasm_component_adapter_mark != 0 {
        process_exit(1);
    }
    let a: Int = wasi_errno_success();
    let b: Int = wasi_errno_success();
    if a != b {
        println("FAIL wasi_errno_success");
        process_exit(1);
    }
    println("prod_wasm_component_adapter: PASSED");
}
