// # Product prove std/graph_gnn/gnn_tagcn_topology_adaptive.oo
//
// Logline: Fail-closed verification that TAGCN topology-adaptive polynomial graph convolution is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_tagcn_topology_adaptive.oo.
//
// Beats:
//   1. Construct TAGCNConfig and initialize hop filter weights with deterministic seed.
//   2. Run tagcn_forward_node on sample multi-scale hop aggregated features.
//   3. Assert deterministic return values.
//   4. Print prod_g4_gnn_tagcn: PASSED only if all match.

import "std/graph_gnn/gnn_tagcn_topology_adaptive.oo";

pub fn main() {
    let cfg1: TAGCNConfig = tagcn_config_new(4, 2, 2, true);
    let cfg2: TAGCNConfig = tagcn_config_new(4, 2, 2, true);
    if cfg1.in_features != cfg2.in_features {
        println("FAIL tagcn_config_new in_features");
        process_exit(1);
    }
    if cfg1.out_features != cfg2.out_features {
        println("FAIL tagcn_config_new out_features");
        process_exit(1);
    }
    if cfg1.k_hops != cfg2.k_hops {
        println("FAIL tagcn_config_new k_hops");
        process_exit(1);
    }

    // num_filters = 3, in_f = 4, out_f = 2 -> total_w = 24
    let hw1: List[Int] = tagcn_init_weights(24, 66);
    let hw2: List[Int] = tagcn_init_weights(24, 66);

    let mut b1: List[Int] = list_new();
    b1 = list_push(b1, 5);
    b1 = list_push(b1, 10);
    let mut b2: List[Int] = list_new();
    b2 = list_push(b2, 5);
    b2 = list_push(b2, 10);

    // 3 * 4 = 12 hop aggregated features
    let mut feats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        feats = list_push(feats, i + 2);
        i = i + 1;
    }

    let out1: List[Int] = tagcn_forward_node(cfg1, hw1, b1, feats);
    let out2: List[Int] = tagcn_forward_node(cfg2, hw2, b2, feats);

    let len1: Int = list_len(out1);
    let len2: Int = list_len(out2);
    if len1 != len2 {
        println("FAIL tagcn_forward_node length mismatch");
        process_exit(1);
    }
    if len1 != 2 {
        println("FAIL tagcn_forward_node length expected");
        process_exit(1);
    }

    let o0_a: Int = list_get(out1, 0);
    let o0_b: Int = list_get(out2, 0);
    if o0_a != o0_b {
        println("FAIL tagcn_forward_node o0");
        process_exit(1);
    }

    let o1_a: Int = list_get(out1, 1);
    let o1_b: Int = list_get(out2, 1);
    if o1_a != o1_b {
        println("FAIL tagcn_forward_node o1");
        process_exit(1);
    }

    println("prod_g4_gnn_tagcn: PASSED");
    process_exit(0);
}
