// # Product prove std/cloud_faas/firecracker_microvm_snapshot.oo
//
// Logline: Fail-closed emit+gcc+run asserts firecracker_snapshot_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/firecracker_microvm_snapshot.oo.
//
// Beats:
//   1. Call firecracker_snapshot_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_firecracker_microvm_snapshot: PASSED only if they match.

import "std/cloud_faas/firecracker_microvm_snapshot.oo";

pub fn main() {
    let firecracker_microvm_snapshot_mark: Int = 0;
    if firecracker_microvm_snapshot_mark != 0 {
        process_exit(1);
    }
    let firecracker_microvm_snapshot_a: FirecrackerSnapshotManager = firecracker_snapshot_manager_new("x", 1, 1);
    let firecracker_microvm_snapshot_b: FirecrackerSnapshotManager = firecracker_snapshot_manager_new("x", 1, 1);
    if (firecracker_microvm_snapshot_a).restore_latency_us != (firecracker_microvm_snapshot_b).restore_latency_us {
        println("FAIL firecracker_snapshot_manager_new");
        process_exit(1);
    }
    println("prod_firecracker_microvm_snapshot: PASSED");
}
