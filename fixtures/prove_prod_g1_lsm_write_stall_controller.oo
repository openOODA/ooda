// # Product prove std/db_storage/lsm_write_stall_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts can_accept_write is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_write_stall_controller.oo.
//
// Beats:
//   1. Call can_accept_write twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_write_stall_controller: PASSED only if they match.

import "std/db_storage/lsm_write_stall_controller.oo";

pub fn main() {
    let obj_a: WriteStallState = write_stall_state_init();
    let obj_b: WriteStallState = write_stall_state_init();
    let a: Bool = can_accept_write(obj_a);
    let b: Bool = can_accept_write(obj_b);
    if a != b {
        println("FAIL can_accept_write");
        process_exit(1);
    }
    println("prod_lsm_write_stall_controller: PASSED");
}
