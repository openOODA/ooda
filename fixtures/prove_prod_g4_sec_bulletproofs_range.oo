// # Product prove std/sec/crypto/bulletproofs_range.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs_range.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_range.oo.
//
// Beats:
//   1. Construct generators and Pedersen commitment.
//   2. Run bulletproof_range_prove twice with concrete test inputs.
//   3. Run bulletproof_range_verify and assert determinism and bounds validation.
//   4. Print prod_g4_sec_bulletproofs_range: PASSED and exit 0.

import "std/sec/crypto/bulletproofs_range.oo";

pub fn main() {
    let gens: BulletproofGenerators = bulletproof_generators_create(4, 1, 11, 17, 1009);

    let prf1: RangeProof = bulletproof_range_prove(5, 0, 15, 7, 4, gens, 1009);
    let prf2: RangeProof = bulletproof_range_prove(5, 0, 15, 7, 4, gens, 1009);

    if (prf1).is_valid != (prf2).is_valid || !(prf1).is_valid {
        println("FAIL bulletproof_range_prove is_valid mismatch");
        process_exit(1);
    }
    if (prf1).commitment != (prf2).commitment {
        println("FAIL bulletproof_range_prove commitment mismatch");
        process_exit(1);
    }
    if (prf1).tau_x != (prf2).tau_x {
        println("FAIL bulletproof_range_prove tau_x mismatch");
        process_exit(1);
    }
    if (prf1).t_hat != (prf2).t_hat {
        println("FAIL bulletproof_range_prove t_hat mismatch");
        process_exit(1);
    }

    let ok1: Bool = bulletproof_range_verify(prf1, (prf1).commitment, gens, 1009);
    let ok2: Bool = bulletproof_range_verify(prf2, (prf2).commitment, gens, 1009);

    if ok1 != ok2 || !ok1 {
        println("FAIL bulletproof_range_verify valid proof");
        process_exit(1);
    }

    let out_of_range: RangeProof = bulletproof_range_prove(20, 0, 15, 7, 4, gens, 1009);
    if (out_of_range).is_valid {
        println("FAIL bulletproof_range_prove out of range should be invalid");
        process_exit(1);
    }

    let ok_inv: Bool = bulletproof_range_verify(out_of_range, (out_of_range).commitment, gens, 1009);
    if ok_inv {
        println("FAIL bulletproof_range_verify invalid proof should fail");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs_range: PASSED");
    process_exit(0);
}
