// # Product prove std/perf/refcount.oo
//
// Logline: Fail-closed emit+gcc+run asserts refcount_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/refcount.oo.
//
// Beats:
//   1. Call refcount_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_refcount: PASSED only if they match.

import "std/perf/refcount.oo";

pub fn main() {
    let a: RefCount = refcount_create("x");
    let b: RefCount = refcount_create("x");
    if (a).count != (b).count {
        println("FAIL refcount_create");
        process_exit(1);
    }
    println("prod_refcount: PASSED");
}
