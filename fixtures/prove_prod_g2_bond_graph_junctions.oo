// # Product prove std/digital_twin/bond_graph_junctions.oo
//
// Logline: Fail-closed emit+gcc+run asserts junction_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_junctions.oo.
//
// Beats:
//   1. Call junction_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bond_graph_junctions: PASSED only if they match.

import "std/digital_twin/bond_graph_junctions.oo";

pub fn main() {
    let bond_graph_junctions_mark: Int = 0;
    if bond_graph_junctions_mark != 0 {
        process_exit(1);
    }
    let a: JunctionType = junction_new(true, 0, 0);
    let b: JunctionType = junction_new(true, 0, 0);
    if (a).num_ports != (b).num_ports {
        println("FAIL junction_new");
        process_exit(1);
    }
    println("prod_g2_bond_graph_junctions: PASSED");
}
