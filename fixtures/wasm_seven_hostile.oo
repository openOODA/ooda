// # Hostile IDENT seventh println
//
// Logline: Print six strings then IDENT x so emit-wasm must miss a seven-string fold.
//
// Setup: One public main. Seventh print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-f, then x.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println(x);
}
