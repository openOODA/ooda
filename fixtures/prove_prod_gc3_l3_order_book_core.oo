// # Product prove std/fintech_l3_book/l3_order_book_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts l3_order_book_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_order_book_core.oo.
//
// Beats:
//   1. Call l3_order_book_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_order_book_core: PASSED only if they match.

import "std/fintech_l3_book/l3_order_book_core.oo";

pub fn main() {
    let l3_order_book_core_mark: Int = 0;
    if l3_order_book_core_mark != 0 {
        process_exit(1);
    }
    let l3_order_book_core_a = l3_order_book_state_new("x");
    let l3_order_book_core_b = l3_order_book_state_new("x");
    if (l3_order_book_core_a).total_orders_inserted != (l3_order_book_core_b).total_orders_inserted {
        println("FAIL l3_order_book_state_new");
        process_exit(1);
    }
    println("prod_l3_order_book_core: PASSED");
}
