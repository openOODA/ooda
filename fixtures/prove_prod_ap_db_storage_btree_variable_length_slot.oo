// # Product prove std/db_storage/btree_variable_length_slot.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/btree_variable_length_slot.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_variable_length_slot.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_btree_variable_length_slot: PASSED only if they match.

import "std/db_storage/btree_variable_length_slot.oo";

pub fn main() {
    let btree_variable_length_slot_a = varlen_storage_manager_new(0);
    let btree_variable_length_slot_b = varlen_storage_manager_new(0);
    if btree_variable_length_slot_a.inline_byte_threshold != btree_variable_length_slot_b.inline_byte_threshold {
        println("FAIL btree_variable_length_slot");
        process_exit(1);
    }
    println("prod_ap_btree_variable_length_slot: PASSED");
}
