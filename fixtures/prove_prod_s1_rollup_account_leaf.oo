// # Product prove std/zk_rollup/rollup_account_leaf.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_account_leaf_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_account_leaf.oo.
//
// Beats:
//   1. Call rollup_account_leaf_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_account_leaf: PASSED only if they match.

import "std/zk_rollup/rollup_account_leaf.oo";

pub fn main() {
    let rollup_account_leaf_mark: Int = 0;
    if rollup_account_leaf_mark != 0 {
        process_exit(1);
    }
    let rollup_account_leaf_a = rollup_account_leaf_new(1, 1, 1, 1);
    let rollup_account_leaf_b = rollup_account_leaf_new(1, 1, 1, 1);
    if (rollup_account_leaf_a).account_index != (rollup_account_leaf_b).account_index {
        println("FAIL rollup_account_leaf_new");
        process_exit(1);
    }
    println("prod_rollup_account_leaf: PASSED");
}
