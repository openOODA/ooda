// # Product prove std/compilers_vm/bytecode_constant_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/bytecode_constant_pool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_constant_pool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bytecode_constant_pool: PASSED only if they match.

import "std/compilers_vm/bytecode_constant_pool.oo";

pub fn main() {
    let bytecode_constant_pool_a = cp_tag_int();
    let bytecode_constant_pool_b = cp_tag_int();
    if bytecode_constant_pool_a != bytecode_constant_pool_b {
        println("FAIL bytecode_constant_pool");
        process_exit(1);
    }
    println("prod_ap_bytecode_constant_pool: PASSED");
}
