// # Product prove std/aero/tvc_ops.oo
//
// Logline: Fail-closed verification that thrust vector control kinematics and operational limits are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_ops.oo.
//
// Beats:
//   1. Construct gimbal angles and perform angle arithmetic and scaling.
//   2. Create actuator commands and clamp against hardstop limits.
//   3. Initialize TVC allocations, operational limits, and state structures.
//   4. Print prod_g4_aero_tvc_ops: PASSED and exit 0.

import "std/aero/tvc_ops.oo";

pub fn main() {
    let tvc_ops_mark: Int = 0;
    if tvc_ops_mark != 0 {
        process_exit(1);
    }

    let g1: GimbalAngle = gimbal_angle_new(0.05, 0.02, 0.0);
    let g2: GimbalAngle = gimbal_angle_new(0.05, 0.02, 0.0);

    let mag_a: Float = gimbal_angle_magnitude(g1);
    let mag_b: Float = gimbal_angle_magnitude(g2);
    if mag_a != mag_b {
        println("FAIL gimbal_angle_magnitude");
        process_exit(1);
    }

    let g_add: GimbalAngle = gimbal_angle_add(g1, g2);
    if (g_add).pitch != 0.1 || (g_add).yaw != 0.04 {
        println("FAIL gimbal_angle_add");
        process_exit(1);
    }

    let g_scale: GimbalAngle = gimbal_angle_scale(g1, 2.0);
    if (g_scale).pitch != 0.1 {
        println("FAIL gimbal_angle_scale");
        process_exit(1);
    }

    let cmd: ActuatorCommand = actuator_command_new(10.0, 20.0, 0.5, 0.5, true);
    if !(cmd).enabled || (cmd).duty_cycle_pitch != 0.5 {
        println("FAIL actuator_command_new");
        process_exit(1);
    }

    let cmd_clamped: ActuatorCommand = actuator_command_clamp(cmd, 15.0);
    if (cmd_clamped).actuator_yaw_stroke_mm != 15.0 {
        println("FAIL actuator_command_clamp");
        process_exit(1);
    }

    let tvc_alloc: TvcAllocation = tvc_allocation_default();
    if (tvc_alloc).thrust_n != 1000.0 || (tvc_alloc).moment_arm_m != 2.0 {
        println("FAIL tvc_allocation_default");
        process_exit(1);
    }

    let tvc_lim: TvcLimits = tvc_limits_default();
    if (tvc_lim).max_actuator_stroke_mm != 50.0 {
        println("FAIL tvc_limits_default");
        process_exit(1);
    }

    let tvc_st: TvcState = tvc_state_init(tvc_alloc, tvc_lim);
    if (tvc_st).is_armed {
        println("FAIL tvc_state_init");
        process_exit(1);
    }

    println("prod_g4_aero_tvc_ops: PASSED");
    process_exit(0);
}
