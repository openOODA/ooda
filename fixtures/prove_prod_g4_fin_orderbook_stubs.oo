// # Product prove std/fin/orderbook_stubs.oo
//
// Logline: Fail-closed verification that order book stubs module imports, limit order constructors, and book slot mutations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_stubs.oo.
//
// Beats:
//   1. Construct buy and sell limit orders and verify price/qty fields.
//   2. Instantiate order book and record sequential bid additions.
//   3. Assert deterministic book count and last trade price updates.
//   4. Print prod_g4_fin_orderbook_stubs: PASSED and exit 0.

import "std/fin/orderbook_stubs.oo";

pub fn main() {
    let ord_a: LimitOrder = limit_order_new(101, 15000, 50);
    let ord_b: LimitOrder = limit_order_new(101, 15000, 50);
    if (ord_a).order_id != (ord_b).order_id || (ord_a).price != (ord_b).price {
        println("FAIL limit_order_new deterministic");
        process_exit(1);
    }
    if (ord_a).is_buy != 1 || (ord_a).filled != 0 {
        println("FAIL limit_order_new fields");
        process_exit(1);
    }

    let ord_sell: LimitOrder = limit_order_make(102, 15100, 25, 0);
    if (ord_sell).is_buy != 0 || (ord_sell).quantity != 25 {
        println("FAIL limit_order_make sell");
        process_exit(1);
    }

    let ob_empty: OrderBook = orderbook_new();
    if (ob_empty).bid_count != 0 || (ob_empty).ask_count != 0 {
        println("FAIL orderbook_new");
        process_exit(1);
    }

    let ob_1: OrderBook = orderbook_add_bid(ob_empty, 14950);
    let ob_2: OrderBook = orderbook_add_bid(ob_1, 14975);
    if (ob_2).bid_count != 2 || (ob_2).last_trade_price != 14975 {
        println("FAIL orderbook_add_bid");
        process_exit(1);
    }
    if (ob_2).processed != 2 {
        println("FAIL orderbook_add_bid processed");
        process_exit(1);
    }

    println("prod_g4_fin_orderbook_stubs: PASSED");
    process_exit(0);
}
