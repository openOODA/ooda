// # char_at const index out of bounds
//
// Logline: Check refuses char_at on a string literal when the index is past the end.
//
// Setup: Single-file probe. Line of the call stays under 50.
//
// Beats:
//   1. Call char_at with a two-char literal and index 9.
//   2. Keep the call in main.
//   3. check must ERR type char_at index out of bounds.

pub fn main() {
    char_at("ab", 9);
}
