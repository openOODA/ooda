// # Product prove std/quantum_advanced/clifford_tableau.oo
//
// Logline: Fail-closed emit+gcc+run asserts tableau_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/clifford_tableau.oo.
//
// Beats:
//   1. Call tableau_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_clifford_tableau: PASSED only if they match.

import "std/quantum_advanced/clifford_tableau.oo";

pub fn main() {
    let clifford_tableau_mark: Int = 0;
    if clifford_tableau_mark != 0 {
        process_exit(1);
    }
    let a: CliffordTableau = tableau_new(0);
    let b: CliffordTableau = tableau_new(0);
    if (a).num_qubits != (b).num_qubits {
        println("FAIL tableau_new");
        process_exit(1);
    }
    println("prod_clifford_tableau: PASSED");
}
