// # Product array_ring prove
//
// Logline: Fail-closed emit+gcc+run of shipped array_ring_push/len.
//
// Setup: Product std/collections/array_ring.oo. Capacity 4, push 7.
//
// Beats:
//   1. New ring len 0; after one push len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/array_ring.oo";

pub fn main() {
    let mut r: ArrayRing = array_ring_new(4);
    let z: Int = array_ring_len(r);
    if z != 0 {
        println("FAIL aring empty");
        process_exit(1);
    }
    r = array_ring_push(r, 7);
    let n: Int = array_ring_len(r);
    if n != 1 {
        println("FAIL aring len");
        process_exit(1);
    }
    println("prod_aring: PASSED");
}
