// # Product prove std/db_graph/opencypher_expression_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_val_null is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_expression_evaluator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cypher_val_null twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opencypher_expression_evaluator: PASSED only if they match.

import "std/db_graph/opencypher_expression_evaluator.oo";

pub fn main() {
    let g2_oa: CypherValue = cypher_val_null();
    let g2_ob: CypherValue = cypher_val_null();
    let g2_a = (g2_oa).val_type;
    let g2_b = (g2_ob).val_type;
    if g2_a != g2_b {
        println("FAIL cypher_val_null.val_type");
        process_exit(1);
    }
    println("prod_g2_opencypher_expression_evaluator: PASSED");
}
