// # Product prove std/auto_robot/robotic_arm_ik.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/robotic_arm_ik.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/robotic_arm_ik.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_robotic_arm_ik: PASSED only if they match.

import "std/auto_robot/robotic_arm_ik.oo";

pub fn main() {
    let robotic_arm_ik_a = arm_reach(0, 0);
    let robotic_arm_ik_b = arm_reach(0, 0);
    if robotic_arm_ik_a != robotic_arm_ik_b {
        println("FAIL robotic_arm_ik");
        process_exit(1);
    }
    println("prod_ap_robotic_arm_ik: PASSED");
}
