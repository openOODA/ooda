// M163 path A: joinable thread_spawn + thread_join under ThreadCap
pub fn main(thread: &ThreadCap) {
    let r: Result[String, String] = thread_spawn(thread, "worker");
    if r.is_ok() {
        // Preferred: join Int slot (first spawn → tid:0 → slot 0)
        let j: Result[String, String] = thread_join(thread, 0);
        if j.is_ok() {
            println("join-ok");
        } else {
            println("join-fail");
        }
    } else {
        println("spawn-fail");
    }
}
