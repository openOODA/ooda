// # Product prove std/sec/sys/enclave_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/enclave_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/enclave_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_enclave_types: PASSED only if they match.

import "std/sec/sys/enclave_types.oo";

pub fn main() {
    let enclave_types_a = enclave_type_new(0, 0);
    let enclave_types_b = enclave_type_new(0, 0);
    let enclave_types_va = enclave_type_vendor(enclave_types_a);
    let enclave_types_vb = enclave_type_vendor(enclave_types_b);
    if enclave_types_va != enclave_types_vb {
        println("FAIL enclave_types");
        process_exit(1);
    }
    println("prod_ap_enclave_types: PASSED");
}
