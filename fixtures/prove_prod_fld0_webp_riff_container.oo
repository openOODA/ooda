// # Product prove std/media_dsp/webp_riff_container.oo
//
// Logline: Fail-closed emit+gcc+run asserts webp_chunk_padded_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/webp_riff_container.oo.
//
// Beats:
//   1. Call webp_chunk_padded_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_webp_riff_container: PASSED only if they match.

import "std/media_dsp/webp_riff_container.oo";

pub fn main() {
    let webp_riff_container_mark: Int = 0;
    if webp_riff_container_mark != 0 {
        process_exit(1);
    }
    let webp_riff_container_obj: WebpChunk = webp_chunk_new("x", 1, 1);
    let webp_riff_container_a: Int = webp_chunk_padded_size(&webp_riff_container_obj);
    let webp_riff_container_b: Int = webp_chunk_padded_size(&webp_riff_container_obj);
    if webp_riff_container_a != webp_riff_container_b {
        println("FAIL webp_chunk_padded_size");
        process_exit(1);
    }
    println("prod_webp_riff_container: PASSED");
}
