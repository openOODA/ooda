// # Smoke bytecode list and string
//
// Logline: List push/get and string char helpers must run on the bytecode VM.
//
// Setup: M6 list plus string method surface.
//
// Beats:
//   1. Push 10 and 20 and print length plus slots.
//   2. Measure "fn" and read both chars.
//   3. Slice and test char_is_alpha.

pub fn main() {
    let mut xs = list_new();
    xs = list_push(xs, 10);
    xs = list_push(xs, 20);
    println(list_len(xs));
    println(list_get(xs, 0));
    println(list_get(xs, 1));
    let s = "fn";
    println(chars_len(s));
    println(char_at(s, 0));
    println(char_at(s, 1));
    println(str_slice(s, 0, 2));
    println(char_is_alpha(char_at(s, 0)));
}
