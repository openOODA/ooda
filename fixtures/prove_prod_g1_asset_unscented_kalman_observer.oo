// # Product prove std/digital_twin/asset_unscented_kalman_observer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ukf_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_unscented_kalman_observer.oo.
//
// Beats:
//   1. Call ukf_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_asset_unscented_kalman_observer: PASSED only if they match.

import "std/digital_twin/asset_unscented_kalman_observer.oo";

pub fn main() {
    let a: UkfState = ukf_state_new(0, 0.0, 0.0);
    let b: UkfState = ukf_state_new(0, 0.0, 0.0);
    if a.num_states != b.num_states {
        println("FAIL ukf_state_new");
        process_exit(1);
    }
    println("prod_asset_unscented_kalman_observer: PASSED");
}
