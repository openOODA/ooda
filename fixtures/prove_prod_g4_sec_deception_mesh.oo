// # Product Prove std/security_defense/deception_mesh.oo
//
// Logline: Deterministic assertion fixture verifying honeypot generation, canary tripwires, and adversary isolation.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/deception_mesh.oo.
//
// Beats:
//   1. Initialize DeceptionEngine and synthesize decoy entry points.
//   2. Probe a honeypot address and assert intercept action and threat isolation.
//   3. Probe a canary credential and assert canary tripwire trigger.
//   4. Print "prod_g4_sec_deception_mesh: PASSED".

import "std/security_defense/deception_mesh.oo";

pub fn main() {
    let mut eng: DeceptionEngine = deception_engine_new();

    let syn_ok: Bool = deception_engine_synthesize_honeypots(&mut eng);
    if !syn_ok {
        println("FAIL: synthesize_honeypots returned false");
        process_exit(1);
    }

    if ((eng).telemetry).decoys_active != 4 {
        println("FAIL: decoys_active mismatch");
        process_exit(1);
    }

    if ((eng).telemetry).canaries_active != 2 {
        println("FAIL: canaries_active mismatch");
        process_exit(1);
    }

    // Probe honeypot 2: "debug_backdoor" at 4202560
    let act: Int = deception_engine_probe_address(&mut eng, 4202560);
    if act != 0 {
        println("FAIL: honeypot trigger action mismatch");
        process_exit(1);
    }

    if !((eng).telemetry).adversary_isolated {
        println("FAIL: adversary not isolated after honeypot trip");
        process_exit(1);
    }

    // Probe canary credential
    let is_canary: Bool = deception_engine_probe_canary(&mut eng, "sk_live_canary_9921");
    if !is_canary {
        println("FAIL: canary probe returned false for real canary");
        process_exit(1);
    }

    if ((eng).telemetry).total_trips_intercepted != 2 {
        println("FAIL: total_trips_intercepted mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_deception_mesh: PASSED");
    process_exit(0);
}
