// # Product prove std/fin/routing_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts order_route_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing_types.oo.
//
// Beats:
//   1. Call order_route_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_routing_types: PASSED only if they match.

import "std/fin/routing_types.oo";

pub fn main() {
    let routing_types_mark: Int = 0;
    if routing_types_mark != 0 {
        process_exit(1);
    }
    let a: OrderRoute = order_route_new(0, 0, 0);
    let b: OrderRoute = order_route_new(0, 0, 0);
    if (a).side != (b).side {
        println("FAIL order_route_new");
        process_exit(1);
    }
    println("prod_routing_types: PASSED");
}
