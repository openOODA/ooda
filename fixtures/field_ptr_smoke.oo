// # Parenthesized &T field load
//
// Logline: Fail-closed emit+gcc+run of (p).x on &Point so C uses -> not .
//
// Setup: Backend-C. &Point is Point*. (p).x must compile as (p)->x.
//
// Beats:
//   1. px(p: &Point) returns (p).x.
//   2. main builds Point { x: 7 } and calls px.
//   3. Exit 1 before PASSED when the value is not 7.

type Point = struct {
    x: Int
};

pub fn px(p: &Point) -> Int {
    return (p).x;
}

pub fn main() {
    let pt: Point = Point { x: 7 };
    let v: Int = px(&pt);
    if v != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("field_ptr: PASSED");
}
