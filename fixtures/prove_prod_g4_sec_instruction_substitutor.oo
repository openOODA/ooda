// # Product Prove std/security_defense/instruction_substitutor.oo
//
// Logline: Deterministic assertion fixture verifying equivalent instruction substitution and zeroing idiom mutation.
//
// Setup: Isolated emit-c test fixture importing std/security_defense/instruction_substitutor.oo.
//
// Beats:
//   1. Construct instruction stream with MOV reg, 0 idioms.
//   2. Apply instruction_substitute_zeroing.
//   3. Assert substitution count and mutated opcodes.
//   4. Print "prod_g4_sec_instruction_substitutor: PASSED".

import "std/security_defense/instruction_substitutor.oo";

pub fn main() {
    let mut stream: InstructionStream = instruction_stream_new();
    let _a0: Bool = instruction_stream_append(&mut stream, 0, 1, 0, 0); // MOV r1, 0
    let _a1: Bool = instruction_stream_append(&mut stream, 3, 1, 1, 10); // ADD r1, 10
    let _a2: Bool = instruction_stream_append(&mut stream, 0, 2, 0, 0); // MOV r2, 0
    let _a3: Bool = instruction_stream_append(&mut stream, 5, 0, 0, 0); // NOP

    if (stream).count != 4 {
        println("FAIL: initial stream count mismatch");
        process_exit(1);
    }

    let subs: Int = instruction_substitute_zeroing(&mut stream, 100);
    if subs != 2 {
        println("FAIL: substitution count mismatch");
        process_exit(1);
    }

    if (stream).mutations_applied != 2 {
        println("FAIL: mutations_applied mismatch");
        process_exit(1);
    }

    let i0: Instruction = list_get((stream).instructions, 0);
    if (i0).opcode != 1 { // (100 + 0) % 2 == 0 -> XOR (1)
        println("FAIL: insn 0 opcode mismatch");
        process_exit(1);
    }

    let i2: Instruction = list_get((stream).instructions, 2);
    if (i2).opcode != 1 { // (100 + 2) % 2 == 0 -> XOR (1)
        println("FAIL: insn 2 opcode mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_instruction_substitutor: PASSED");
    process_exit(0);
}
