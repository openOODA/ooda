// # Product fraction prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_gcd and fraction_new/add.
//
// Setup: Product std/math/fraction.oo. Euclidean GCD and 1/2+1/2.
//
// Beats:
//   1. math_gcd(12, 8) is 4.
//   2. fraction_new(2, 4) simplifies to 1/2.
//   3. 1/2 + 1/2 is 1/1.
//   4. Exit 1 before PASSED on a miss.

import "std/math/fraction.oo";

pub fn main() {
    let g: Int = math_gcd(12, 8);
    if g != 4 {
        println("FAIL gcd");
        process_exit(1);
    }
    let half: Fraction = fraction_new(2, 4);
    let hn: Int = half.num;
    let hd: Int = half.den;
    if hn != 1 {
        println("FAIL frac num");
        process_exit(1);
    }
    if hd != 2 {
        println("FAIL frac den");
        process_exit(1);
    }
    let one: Fraction = fraction_add(half, half);
    let on: Int = one.num;
    let od: Int = one.den;
    if on != 1 {
        println("FAIL add num");
        process_exit(1);
    }
    if od != 1 {
        println("FAIL add den");
        process_exit(1);
    }
    println("prod_fraction: PASSED");
}
