// # Product prove std/media_dsp/dsp_delay_line_fractional.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_interpolate_linear is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_delay_line_fractional.oo.
//
// Beats:
//   1. Call dsp_interpolate_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_delay_line_fractional: PASSED only if they match.

import "std/media_dsp/dsp_delay_line_fractional.oo";

pub fn main() {
    let dsp_delay_line_fractional_mark: Int = 0;
    if dsp_delay_line_fractional_mark != 0 {
        process_exit(1);
    }
    let dsp_delay_line_fractional_a: Float = dsp_interpolate_linear(1.0, 1.0, 1.0);
    let dsp_delay_line_fractional_b: Float = dsp_interpolate_linear(1.0, 1.0, 1.0);
    if dsp_delay_line_fractional_a != dsp_delay_line_fractional_b {
        println("FAIL dsp_interpolate_linear");
        process_exit(1);
    }
    println("prod_dsp_delay_line_fractional: PASSED");
}
