// # Payload sum match must name every ctor
//
// Logline: Check refuses an Either match that drops B; payload idents are not ctors.
//
// Setup: type Either = A(Int) | B(Int). Exhaust is A and B, not n.
//
// Beats:
//   1. Match A(n) only on an annotated Either let.
//   2. B is missing. n is a payload, not a variant.
//   3. check must ERR naming B.

type Either = A(Int) | B(Int);

pub fn main() {
    let a: Either = A(1);
    let v: Int = match a {
        A(n) => n
    };
}
