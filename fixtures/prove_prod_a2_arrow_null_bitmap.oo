// # Product prove std/db_columnar/arrow_null_bitmap.oo
//
// Logline: Fail-closed emit+gcc+run asserts null_bitmap_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_null_bitmap.oo.
//
// Beats:
//   1. Call null_bitmap_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arrow_null_bitmap: PASSED only if they match.

import "std/db_columnar/arrow_null_bitmap.oo";

pub fn main() {
    let arrow_null_bitmap_mark: Int = 0;
    if arrow_null_bitmap_mark != 0 {
        process_exit(1);
    }
    let a: NullBitmapBuffer = null_bitmap_buffer_new(0);
    let b: NullBitmapBuffer = null_bitmap_buffer_new(0);
    if (a).bit_length != (b).bit_length {
        println("FAIL null_bitmap_buffer_new");
        process_exit(1);
    }
    println("prod_arrow_null_bitmap: PASSED");
}
