// # Product prove std/telecom/beamforming_weights.oo
//
// Logline: Fail-closed emit+gcc+run asserts beamforming_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/beamforming_weights.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call beamforming_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_beamforming_weights: PASSED only if they match.

import "std/telecom/beamforming_weights.oo";

pub fn main() {
    let g0_a = beamforming_pi();
    let g0_b = beamforming_pi();
    if g0_a != g0_b {
        println("FAIL beamforming_pi");
        process_exit(1);
    }
    println("prod_gr_beamforming_weights: PASSED");
}
