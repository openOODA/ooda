// # Product prove std/db_graph/opencypher_cost_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_catalog_stats_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_cost_estimator.oo.
//
// Beats:
//   1. Call graph_catalog_stats_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_cost_estimator: PASSED only if they match.

import "std/db_graph/opencypher_cost_estimator.oo";

pub fn main() {
    let opencypher_cost_estimator_mark: Int = 0;
    if opencypher_cost_estimator_mark != 0 {
        process_exit(1);
    }
    let a: GraphCatalogStats = graph_catalog_stats_default();
    let b: GraphCatalogStats = graph_catalog_stats_default();
    if (a).total_node_count != (b).total_node_count {
        println("FAIL graph_catalog_stats_default");
        process_exit(1);
    }
    println("prod_opencypher_cost_estimator: PASSED");
}
