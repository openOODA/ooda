// # Product prove std/crypto/aes_inv.oo
//
// Logline: Fail-closed emit+gcc+run asserts aes_inv_block is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/aes_inv.oo.
//
// Beats:
//   1. Call aes_inv_block twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aes_inv: PASSED only if they match.

import "std/crypto/aes_inv.oo";

pub fn main() {
    let a = aes_inv_block("x", "x");
    let b = aes_inv_block("x", "x");
    if a != b {
        println("FAIL aes_inv_block");
        process_exit(1);
    }
    println("prod_aes_inv: PASSED");
}
