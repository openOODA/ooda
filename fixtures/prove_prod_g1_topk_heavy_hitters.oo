// # Product prove std/graph_networks/topk_heavy_hitters.oo
//
// Logline: Fail-closed emit+gcc+run asserts topk_summary_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/topk_heavy_hitters.oo.
//
// Beats:
//   1. Call topk_summary_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topk_heavy_hitters: PASSED only if they match.

import "std/graph_networks/topk_heavy_hitters.oo";

pub fn main() {
    let a: SpaceSavingSummary = topk_summary_create(0);
    let b: SpaceSavingSummary = topk_summary_create(0);
    if a.k != b.k {
        println("FAIL topk_summary_create");
        process_exit(1);
    }
    println("prod_topk_heavy_hitters: PASSED");
}
