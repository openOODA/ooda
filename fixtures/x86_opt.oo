// # emit-x86 generic dynamic Option[T] fixture
//
// Logline: Dynamic Option[T] operations: opt_some, opt_none, opt_is_some, opt_is_none, opt_unwrap_or.
//
// Beats:
//   1. Wrap value in opt_some, test opt_is_some and opt_unwrap_or.
//   2. Create opt_none, test opt_is_none and opt_unwrap_or fallback.
//   3. Print values to verify x86_64 lowering.

import "std/option.oo";

pub fn main() {
    let some_val: Result[String, String] = opt_some("hello_opt");
    let none_val: Result[String, String] = opt_none();
    if opt_is_some(some_val) {
        println(opt_unwrap_or(some_val, "fallback"));
    }
    if opt_is_none(none_val) {
        println(opt_unwrap_or(none_val, "fallback"));
    }
}
