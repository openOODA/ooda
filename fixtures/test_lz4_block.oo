// # LZ4 block adversarial suite
//
// Logline: Decodes literal tokens and a 2-byte match offset, then rejects offset 0 and truncated input.
//
// Setup: Pure. Imports lz4_block.oo. Run from ooda/.
//
// Beats:
//   1. Encode then decode a literal-only block.
//   2. Encode a match and expand it.
//   3. Reject offset 0 and a truncated token.

import "std/compression/lz4_block.oo";

pub fn main() {
    let mut src: List[Int] = list_new();
    src = list_push(src, 97);
    src = list_push(src, 98);
    let e: ByteOut = lz4_block_lits(src);
    if e.flag < 1 {
        println("FAIL lits " + e.err);
        process_exit(1);
    }
    let d: ByteOut = lz4_block_decode(e.bytes);
    if d.flag < 1 {
        println("FAIL decode " + d.err);
        process_exit(1);
    }
    if list_len(d.bytes) != 2 {
        println("FAIL lit len");
        process_exit(1);
    }
    if list_get(d.bytes, 0) != 97 {
        println("FAIL lit0");
        process_exit(1);
    }
    println("token literal length");
    let mut lits: List[Int] = list_new();
    lits = list_push(lits, 97);
    lits = list_push(lits, 98);
    lits = list_push(lits, 99);
    lits = list_push(lits, 100);
    let m: ByteOut = lz4_block_match(lits, 4, 4);
    if m.flag < 1 {
        println("FAIL match enc " + m.err);
        process_exit(1);
    }
    let md: ByteOut = lz4_block_decode(m.bytes);
    if md.flag < 1 {
        println("FAIL match dec " + md.err);
        process_exit(1);
    }
    if list_len(md.bytes) != 8 {
        println("FAIL match len");
        process_exit(1);
    }
    if list_get(md.bytes, 4) != 97 {
        println("FAIL expand");
        process_exit(1);
    }
    println("2-byte offset, match expand");
    let z: ByteOut = lz4_block_match(lits, 0, 4);
    if z.flag > 0 {
        println("FAIL offset0 enc");
        process_exit(1);
    }
    let mut zbuf: List[Int] = list_new();
    zbuf = list_push(zbuf, 64);
    zbuf = list_push(zbuf, 97);
    zbuf = list_push(zbuf, 98);
    zbuf = list_push(zbuf, 99);
    zbuf = list_push(zbuf, 100);
    zbuf = list_push(zbuf, 0);
    zbuf = list_push(zbuf, 0);
    let zd: ByteOut = lz4_block_decode(zbuf);
    if zd.flag > 0 {
        println("FAIL offset0 dec");
        process_exit(1);
    }
    let mut tr: List[Int] = list_new();
    tr = list_push(tr, 16);
    let t: ByteOut = lz4_block_decode(tr);
    if t.flag > 0 {
        println("FAIL trunc ok");
        process_exit(1);
    }
    println("offset 0 / truncated Err");
    println("SUITE PASSED");
    println("test_lz4_block: PASSED");
}
