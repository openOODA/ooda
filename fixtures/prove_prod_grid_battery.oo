// # Product prove std/grid/battery.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_soc_pct is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery.oo.
//
// Beats:
//   1. Call shim_marker_soc_pct twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_battery: PASSED only if they match.

import "std/grid/battery.oo";

pub fn main() {
    let battery_mark: Int = 0;
    if battery_mark != 0 { process_exit(1); }
    let a: Float = shim_marker_soc_pct();
    let b: Float = shim_marker_soc_pct();
    if a != b { process_exit(1); }
    println("prod_battery: PASSED");
}
