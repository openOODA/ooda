// # Product prove std/aero/propulsion_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts standard_gravity is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion_ops.oo.
//
// Beats:
//   1. Call standard_gravity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propulsion_ops: PASSED only if they match.

import "std/aero/propulsion_ops.oo";

pub fn main() {
    let a = standard_gravity();
    let b = standard_gravity();
    if a != b {
        println("FAIL standard_gravity");
        process_exit(1);
    }
    println("prod_propulsion_ops: PASSED");
}
