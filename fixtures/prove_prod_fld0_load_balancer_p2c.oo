// # Product prove std/cloud_k8s/load_balancer_p2c.oo
//
// Logline: Fail-closed emit+gcc+run asserts p2c_balancer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/load_balancer_p2c.oo.
//
// Beats:
//   1. Call p2c_balancer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_load_balancer_p2c: PASSED only if they match.

import "std/cloud_k8s/load_balancer_p2c.oo";

pub fn main() {
    let load_balancer_p2c_mark: Int = 0;
    if load_balancer_p2c_mark != 0 {
        process_exit(1);
    }
    let load_balancer_p2c_a: P2cBalancer = p2c_balancer_new(1);
    let load_balancer_p2c_b: P2cBalancer = p2c_balancer_new(1);
    if (load_balancer_p2c_a).rng_state != (load_balancer_p2c_b).rng_state {
        println("FAIL p2c_balancer_new");
        process_exit(1);
    }
    println("prod_load_balancer_p2c: PASSED");
}
