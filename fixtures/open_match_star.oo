// # Underscore is not exhaustive Option
//
// Logline: match on an Option with only _ must fail check.
//
// Setup: OPEN-17. Annotation carries the type.
//
// Beats:
//   1. Bind Some as Option.
//   2. Match only underscore.
//   3. Check refuses.

pub fn main() {
    let x: Option = Some(1);
    let y = match x {
        _ => 0,
    };
    println(y);
}
