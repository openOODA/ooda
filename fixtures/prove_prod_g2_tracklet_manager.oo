// # Product prove std/lidar_perception/tracklet_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts tracklet_manager_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/tracklet_manager.oo.
//
// Beats:
//   1. Call tracklet_manager_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tracklet_manager: PASSED only if they match.

import "std/lidar_perception/tracklet_manager.oo";

pub fn main() {
    let a: TrackletManagerConfig = tracklet_manager_config_default();
    let b: TrackletManagerConfig = tracklet_manager_config_default();
    if (a).min_hits_to_confirm != (b).min_hits_to_confirm {
        println("FAIL tracklet_manager_config_default");
        process_exit(1);
    }
    println("prod_g2_tracklet_manager: PASSED");
}
