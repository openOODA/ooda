// # Product prove std/sec/sys/elf_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_magic_0 is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_ops.oo.
//
// Beats:
//   1. Call elf_magic_0 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_ops: PASSED only if they match.

import "std/sec/sys/elf_ops.oo";

pub fn main() {
    let a = elf_magic_0();
    let b = elf_magic_0();
    if a != b {
        println("FAIL elf_magic_0");
        process_exit(1);
    }
    println("prod_elf_ops: PASSED");
}
