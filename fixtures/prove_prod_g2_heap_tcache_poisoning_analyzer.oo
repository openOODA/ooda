// # Product prove std/exploit_analysis/heap_tcache_poisoning_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts tcache_bin_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_tcache_poisoning_analyzer.oo.
//
// Beats:
//   1. Call tcache_bin_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_heap_tcache_poisoning_analyzer: PASSED only if they match.

import "std/exploit_analysis/heap_tcache_poisoning_analyzer.oo";

pub fn main() {
    let heap_tcache_poisoning_analyzer_mark: Int = 0;
    if heap_tcache_poisoning_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: TcacheBin = tcache_bin_new(0);
    let b: TcacheBin = tcache_bin_new(0);
    if (a).size_class != (b).size_class {
        println("FAIL tcache_bin_new");
        process_exit(1);
    }
    println("prod_g2_heap_tcache_poisoning_analyzer: PASSED");
}
