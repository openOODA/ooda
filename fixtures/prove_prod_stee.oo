// # Product stream_tee prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_tee push/len.
//
// Setup: Product std/io/stream_tee.oo. List[Int] destub.
//
// Beats:
//   1. push 7 then 3: both branches len 2.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_tee.oo";

pub fn main() {
    let mut t: StreamTee = stream_tee_new();
    t = stream_tee_push(t, 7);
    t = stream_tee_push(t, 3);
    let a: Int = stream_tee_len_a(t);
    let b: Int = stream_tee_len_b(t);
    if a != 2 {
        println("FAIL tee a");
        process_exit(1);
    }
    if b != 2 {
        println("FAIL tee b");
        process_exit(1);
    }
    println("prod_stee: PASSED");
}
