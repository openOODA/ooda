// # Product prove std/sec/crypto/bulletproofs_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bulletproofs_stubs: PASSED only if they match.

import "std/sec/crypto/bulletproofs_stubs.oo";

pub fn main() {
    let bulletproofs_stubs_a = bulletproof_ec_ristretto_msm_opt(list_new(), 0);
    let bulletproofs_stubs_b = bulletproof_ec_ristretto_msm_opt(list_new(), 0);
    if bulletproofs_stubs_a != bulletproofs_stubs_b {
        println("FAIL bulletproofs_stubs");
        process_exit(1);
    }
    println("prod_ap_bulletproofs_stubs: PASSED");
}
