// # Product prove std/sec/net/waf_rule.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_rule_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_rule.oo.
//
// Beats:
//   1. Call waf_rule_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_waf_rule: PASSED only if they match.

import "std/sec/net/waf_rule.oo";

pub fn main() {
    let a = waf_rule_ready();
    let b = waf_rule_ready();
    if a != b {
        println("FAIL waf_rule_ready");
        process_exit(1);
    }
    println("prod_waf_rule: PASSED");
}
