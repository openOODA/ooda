// # Product prove std/zk_rollup/snark_verifier_circuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_gate_counter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/snark_verifier_circuit.oo.
//
// Beats:
//   1. Call circuit_gate_counter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_snark_verifier_circuit: PASSED only if they match.

import "std/zk_rollup/snark_verifier_circuit.oo";

pub fn main() {
    let snark_verifier_circuit_mark: Int = 0;
    if snark_verifier_circuit_mark != 0 {
        process_exit(1);
    }
    let a: CircuitGateCounter = circuit_gate_counter_new();
    let b: CircuitGateCounter = circuit_gate_counter_new();
    if (a).num_variables != (b).num_variables {
        println("FAIL circuit_gate_counter_new");
        process_exit(1);
    }
    println("prod_snark_verifier_circuit: PASSED");
}
