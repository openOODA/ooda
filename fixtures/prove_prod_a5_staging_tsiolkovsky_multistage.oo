// # Product prove std/space_propulsion/staging_tsiolkovsky_multistage.oo
//
// Logline: Fail-closed emit+gcc+run asserts two_stage_spec_default_orbital is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/staging_tsiolkovsky_multistage.oo.
//
// Beats:
//   1. Call two_stage_spec_default_orbital twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_staging_tsiolkovsky_multistage: PASSED only if they match.

import "std/space_propulsion/staging_tsiolkovsky_multistage.oo";

pub fn main() {
    let staging_tsiolkovsky_multistage_mark: Int = 0;
    if staging_tsiolkovsky_multistage_mark != 0 {
        process_exit(1);
    }
    let a: TwoStageRocketSpec = two_stage_spec_default_orbital();
    let b: TwoStageRocketSpec = two_stage_spec_default_orbital();
    if (a).payload_mass_kg != (b).payload_mass_kg {
        println("FAIL two_stage_spec_default_orbital");
        process_exit(1);
    }
    println("prod_staging_tsiolkovsky_multistage: PASSED");
}
