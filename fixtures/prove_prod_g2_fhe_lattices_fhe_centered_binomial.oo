// # Product prove std/fhe_lattices/fhe_centered_binomial.oo
//
// Logline: Fail-closed emit+gcc+run asserts cbd_variance is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_centered_binomial.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cbd_variance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_centered_binomial: PASSED only if they match.

import "std/fhe_lattices/fhe_centered_binomial.oo";

pub fn main() {
    let g2_a = cbd_variance(2);
    let g2_b = cbd_variance(2);
    if g2_a != g2_b {
        println("FAIL cbd_variance");
        process_exit(1);
    }
    println("prod_g2_fhe_centered_binomial: PASSED");
}
