// # Product prove std/quantum_tensor_nets/mps_matrix_product_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts mps_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/mps_matrix_product_state.oo.
//
// Beats:
//   1. Call mps_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mps_matrix_product_state: PASSED only if they match.

import "std/quantum_tensor_nets/mps_matrix_product_state.oo";

pub fn main() {
    let mps_matrix_product_state_mark: Int = 0;
    if mps_matrix_product_state_mark != 0 {
        process_exit(1);
    }
    let mps_matrix_product_state_a = mps_state_new(1, 1, 1);
    let mps_matrix_product_state_b = mps_state_new(1, 1, 1);
    if (mps_matrix_product_state_a).num_sites != (mps_matrix_product_state_b).num_sites {
        println("FAIL mps_state_new");
        process_exit(1);
    }
    println("prod_mps_matrix_product_state: PASSED");
}
