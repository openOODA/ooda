// # Product prove std/astro_advanced/planetary_entry_heating.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/planetary_entry_heating.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/planetary_entry_heating.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_planetary_entry_heating: PASSED only if they match.

import "std/astro_advanced/planetary_entry_heating.oo";

pub fn main() {
    let planetary_entry_heating_a = entry_qdot();
    let planetary_entry_heating_b = entry_qdot();
    if planetary_entry_heating_a != planetary_entry_heating_b {
        println("FAIL planetary_entry_heating");
        process_exit(1);
    }
    println("prod_ap_planetary_entry_heating: PASSED");
}
