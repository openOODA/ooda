// # Product prove std/compilers_polyhedral/loop_collapse_flattening.oo
//
// Logline: Fail-closed emit+gcc+run asserts linearize_ijk is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/loop_collapse_flattening.oo.
//
// Beats:
//   1. Call linearize_ijk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_loop_collapse_flattening: PASSED only if they match.

import "std/compilers_polyhedral/loop_collapse_flattening.oo";

pub fn main() {
    let loop_collapse_flattening_mark: Int = 0;
    if loop_collapse_flattening_mark != 0 {
        process_exit(1);
    }
    let a: Int = linearize_ijk(0, 0, 0, 0, 0);
    let b: Int = linearize_ijk(0, 0, 0, 0, 0);
    if a != b {
        println("FAIL linearize_ijk");
        process_exit(1);
    }
    println("prod_loop_collapse_flattening: PASSED");
}
