// # Allow a public free_bytes size
//
// Logline: A non-secret size may reach free_bytes while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public size instead.
//   3. Expect emit to allow the call.

// Secret allow non-secret: free_bytes
// SECRET: token
pub fn main(al: &AllocCap) {
    let token = 64;
    let public = 8;
    let r = free_bytes(al, public);
    println(1);
}
