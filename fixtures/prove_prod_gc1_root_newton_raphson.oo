// # Product prove std/scicomp/root_newton_raphson.oo
//
// Logline: Fail-closed emit+gcc+run asserts newton_step_1d is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/root_newton_raphson.oo.
//
// Beats:
//   1. Call newton_step_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_root_newton_raphson: PASSED only if they match.

import "std/scicomp/root_newton_raphson.oo";

pub fn main() {
    let root_newton_raphson_mark: Int = 0;
    if root_newton_raphson_mark != 0 {
        process_exit(1);
    }
    let root_newton_raphson_a: Float = newton_step_1d(1.0, 1.0, 1.0, 1.0);
    let root_newton_raphson_b: Float = newton_step_1d(1.0, 1.0, 1.0, 1.0);
    if root_newton_raphson_a != root_newton_raphson_b {
        println("FAIL newton_step_1d");
        process_exit(1);
    }
    println("prod_root_newton_raphson: PASSED");
}
