// # Product prove std/cloud_k8s/rate_limiter_leaky_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts leaky_bucket_add is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/rate_limiter_leaky_bucket.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call leaky_bucket_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_rate_limiter_leaky_bucket: PASSED only if they match.

import "std/cloud_k8s/rate_limiter_leaky_bucket.oo";

pub fn main() {
    let mut g0_oa: LeakyBucket = LeakyBucket { capacity: 1, leak_rate_per_sec: 0, water_level: 0, last_leak_ms: 0, total_queued: 0, total_dropped: 0 };
    let mut g0_ob: LeakyBucket = LeakyBucket { capacity: 1, leak_rate_per_sec: 0, water_level: 0, last_leak_ms: 0, total_queued: 0, total_dropped: 0 };
    let g0_a = leaky_bucket_add(&g0_oa, 0, 0);
    let g0_b = leaky_bucket_add(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL leaky_bucket_add");
        process_exit(1);
    }
    println("prod_gr_rate_limiter_leaky_bucket: PASSED");
}
