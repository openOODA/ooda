// # Product prove std/graph_networks/hierarchical_random_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts hrg_find_lca_prob is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/hierarchical_random_graph.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hrg_find_lca_prob twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hierarchical_random_graph: PASSED only if they match.

import "std/graph_networks/hierarchical_random_graph.oo";

pub fn main() {
    let g2_oa: HrgDendrogram = hrg_create_balanced(2);
    let g2_ob: HrgDendrogram = hrg_create_balanced(2);
    let g2_a = hrg_find_lca_prob(&g2_oa, 2, 2);
    let g2_b = hrg_find_lca_prob(&g2_ob, 2, 2);
    if g2_a != g2_b {
        println("FAIL hrg_find_lca_prob");
        process_exit(1);
    }
    println("prod_g2_hierarchical_random_graph: PASSED");
}
