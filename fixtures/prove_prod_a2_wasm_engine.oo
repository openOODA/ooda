// # Product prove std/compilers/wasm_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_page_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_engine.oo.
//
// Beats:
//   1. Call wasm_page_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_engine: PASSED only if they match.

import "std/compilers/wasm_engine.oo";

pub fn main() {
    let wasm_engine_mark: Int = 0;
    if wasm_engine_mark != 0 {
        process_exit(1);
    }
    let a: Int = wasm_page_bytes();
    let b: Int = wasm_page_bytes();
    if a != b {
        println("FAIL wasm_page_bytes");
        process_exit(1);
    }
    println("prod_wasm_engine: PASSED");
}
