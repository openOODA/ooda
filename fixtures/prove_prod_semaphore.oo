// # Product prove std/sync/semaphore.oo
//
// Logline: Fail-closed emit+gcc+run asserts semaphore_available is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/semaphore.oo.
//
// Beats:
//   1. Call semaphore_available twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_semaphore: PASSED only if they match.

import "std/sync/semaphore.oo";

pub fn main() {
    let obj = semaphore_new(0, 0);
    let a = semaphore_available(obj);
    let b = semaphore_available(obj);
    if a != b {
        println("FAIL semaphore_available");
        process_exit(1);
    }
    println("prod_semaphore: PASSED");
}
