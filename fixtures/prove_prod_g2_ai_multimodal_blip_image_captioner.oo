// # Product prove std/ai_multimodal/blip_image_captioner.oo
//
// Logline: Fail-closed emit+gcc+run asserts blip_image_captioner_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/blip_image_captioner.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call blip_image_captioner_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_blip_image_captioner: PASSED only if they match.

import "std/ai_multimodal/blip_image_captioner.oo";

pub fn main() {
    let g2_a = blip_image_captioner_marker();
    let g2_b = blip_image_captioner_marker();
    if g2_a != g2_b {
        println("FAIL blip_image_captioner_marker");
        process_exit(1);
    }
    println("prod_g2_blip_image_captioner: PASSED");
}
