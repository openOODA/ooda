// # Product prove std/genomics_advanced/bam_pileup_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts pileup_call_consensus real value.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/bam_pileup_generator.oo.
//
// Beats:
//   1. Call pileup_call_consensus with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_bam_pileup_generator: PASSED only if the assert holds.

import "std/genomics_advanced/bam_pileup_generator.oo";

pub fn main() {
    let bam_pileup_generator_mark: Int = 0;
    if bam_pileup_generator_mark != 0 {
        process_exit(1);
    }
    let bam_pileup_generator_l: PileupLocus = PileupLocus { chrom_id: 0, pos: 0, ref_base: "x", count_a: 0, count_c: 0, count_g: 0, count_t: 0, count_del: 0, count_ins: 0 };
    let bam_pileup_generator_a = pileup_call_consensus(&bam_pileup_generator_l, 2.0, 7);
    let bam_pileup_generator_alt_depth: Int = (bam_pileup_generator_a).alt_depth;
    if bam_pileup_generator_alt_depth != 0 {
        println("FAIL pileup_call_consensus");
        process_exit(1);
    }
    println("prod_bam_pileup_generator: PASSED");
}
