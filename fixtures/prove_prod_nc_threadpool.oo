// # Product prove std/sync/threadpool.oo
//
// Logline: Fail-closed emit+gcc+run asserts threadpool_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sync/threadpool.oo.
//
// Beats:
//   1. Call threadpool_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_threadpool: PASSED only if it matches.

import "std/sync/threadpool.oo";

pub fn main() {
    let a: Int = threadpool_probe();
    if a != 0 {
        println("FAIL threadpool_probe");
        process_exit(1);
    }
    println("prod_nc_threadpool: PASSED");
}
