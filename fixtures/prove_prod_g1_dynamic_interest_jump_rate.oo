// # Product prove std/defi_derivatives/dynamic_interest_jump_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts jump_rate_config_stablecoin_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/dynamic_interest_jump_rate.oo.
//
// Beats:
//   1. Call jump_rate_config_stablecoin_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dynamic_interest_jump_rate: PASSED only if they match.

import "std/defi_derivatives/dynamic_interest_jump_rate.oo";

pub fn main() {
    let a: JumpRateModelConfig = jump_rate_config_stablecoin_default();
    let b: JumpRateModelConfig = jump_rate_config_stablecoin_default();
    if a.base_rate_apr != b.base_rate_apr {
        println("FAIL jump_rate_config_stablecoin_default");
        process_exit(1);
    }
    println("prod_dynamic_interest_jump_rate: PASSED");
}
