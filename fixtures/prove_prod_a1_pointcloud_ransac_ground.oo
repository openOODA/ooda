// # Product prove std/auto_robot/pointcloud_ransac_ground.oo
//
// Logline: Fail-closed emit+gcc+run asserts ransac_plane_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_ransac_ground.oo.
//
// Beats:
//   1. Call ransac_plane_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pointcloud_ransac_ground: PASSED only if they match.

import "std/auto_robot/pointcloud_ransac_ground.oo";

pub fn main() {
    let pointcloud_ransac_ground_mark: Int = 0;
    if pointcloud_ransac_ground_mark != 0 {
        process_exit(1);
    }
    let a: Int = ransac_plane_eval(0, 0, 0, 0, 0, 0, 0);
    let b: Int = ransac_plane_eval(0, 0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL ransac_plane_eval");
        process_exit(1);
    }
    println("prod_pointcloud_ransac_ground: PASSED");
}
