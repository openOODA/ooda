import "std/space_propulsion/hall_effect_thruster_discharge.oo";

pub fn main() {
    let hall_effect_thruster_discharge_a = hall_thruster_spec_default_5kw();
    let hall_effect_thruster_discharge_b = hall_thruster_spec_default_5kw();
    if hall_effect_thruster_discharge_a.discharge_voltage_v != hall_effect_thruster_discharge_b.discharge_voltage_v {
        println("FAIL hall_effect_thruster_discharge");
