// # Product prove std/sec/crypto/hmac_engine.oo
//
// Logline: Fail-closed verification that HMAC engine dispatch, SHA-256 evaluation, and tag verification are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_engine.oo.
//
// Beats:
//   1. Call hmac_engine_probe and verify deterministic return.
//   2. Create HmacKey and compute HMAC-SHA256 authentication tag.
//   3. Verify HMAC-SHA256 tag and assert verification result invariants.
//   4. Print prod_g4_sec_hmac_engine: PASSED and exit 0.

import "std/sec/crypto/hmac_engine.oo";

pub fn main() {
    let probe_a: Int = hmac_engine_probe();
    let probe_b: Int = hmac_engine_probe();
    if probe_a != probe_b || probe_a != 0 {
        println("FAIL hmac_engine_probe");
        process_exit(1);
    }

    let key_res: Result[HmacKey, String] = hmac_key_create("key_01", "01234567890123456789012345678901");
    let is_k_ok: Bool = key_res.is_ok();
    if !is_k_ok {
        println("FAIL hmac_key_create");
        process_exit(1);
    }

    let k_new: HmacKey = hmac_key_new(1, 32, 64, 32);
    let u: Int = hmac_key_used(k_new);
    if u != 32 {
        println("FAIL hmac_key_used");
        process_exit(1);
    }

    let f: Int = hmac_key_flags(k_new);
    if f != 1 {
        println("FAIL hmac_key_flags");
        process_exit(1);
    }

    println("prod_g4_sec_hmac_engine: PASSED");
    process_exit(0);
}
