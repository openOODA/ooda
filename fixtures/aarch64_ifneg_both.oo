// # Const -INT OP -INT if print
//
// Logline: Print BOTH from if -1>-2 and GE from the else of if -1<-2.
//
// Setup: Side emit-aarch64 folds MINUS INT OP MINUS INT only when LBRACE follows.
//
// Beats:
//   1. if -1 > -2 print BOTH.
//   2. if -1 < -2 else print GE.
//   3. Expect BOTH and GE.

pub fn main() {
    if -1 > -2 {
        println("BOTH");
    }
    if -1 < -2 {
        println("BAD");
    } else {
        println("GE");
    }
}
