// # Product prove std/tda_topology/rips_graph_skeleton.oo
//
// Logline: Fail-closed emit+gcc+run asserts rips_graph_count_components is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/rips_graph_skeleton.oo.
//
// Beats:
//   1. Call rips_graph_count_components twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rips_graph_skeleton: PASSED only if they match.

import "std/tda_topology/rips_graph_skeleton.oo";

pub fn main() {
    let rips_graph_skeleton_mark: Int = 0;
    if rips_graph_skeleton_mark != 0 {
        process_exit(1);
    }
    let rips_graph_skeleton_a: Int = rips_graph_count_components(list_new());
    let rips_graph_skeleton_b: Int = rips_graph_count_components(list_new());
    if rips_graph_skeleton_a != rips_graph_skeleton_b {
        println("FAIL rips_graph_count_components");
        process_exit(1);
    }
    println("prod_rips_graph_skeleton: PASSED");
}
