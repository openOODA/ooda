// # Product prove std/db_graph/graph_variable_length_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_variable_length_path.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_variable_length_path.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_variable_length_path: PASSED only if they match.

import "std/db_graph/graph_variable_length_path.oo";

pub fn main() {
    let graph_variable_length_path_a = traversal_path_new(0);
    let graph_variable_length_path_b = traversal_path_new(0);
    let graph_variable_length_path_va = traversal_path_has_edge(graph_variable_length_path_a, 0);
    let graph_variable_length_path_vb = traversal_path_has_edge(graph_variable_length_path_b, 0);
    if graph_variable_length_path_va != graph_variable_length_path_vb {
        println("FAIL graph_variable_length_path");
        process_exit(1);
    }
    println("prod_ap_graph_variable_length_path: PASSED");
}
