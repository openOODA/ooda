// # Product prove std/fintech_defi/swap_pricer_irs.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/swap_pricer_irs.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_swap_pricer_irs: PASSED only if they match.

import "std/fintech_defi/swap_pricer_irs.oo";

pub fn main() {
    let swap_pricer_irs_mark: Int = 0;
    if swap_pricer_irs_mark != 0 {
        process_exit(1);
    }
    let a: Float = int_to_float(0);
    let b: Float = int_to_float(0);
    if a != b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_swap_pricer_irs: PASSED");
}
