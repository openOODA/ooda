// # Hostile if 1 != x no-else fold
//
// Logline: Print fold-me from if 1 != x with no else so emit-wasm must miss a const-neq no-else fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be 2.
//   2. If 1 != x print fold-me.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = 2;
    if 1 != x {
        println("fold-me");
    }
}
