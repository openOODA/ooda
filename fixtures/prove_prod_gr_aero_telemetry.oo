// # Product prove std/aero/telemetry.oo
//
// Logline: Fail-closed emit+gcc+run asserts telemetry_header_apid is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call telemetry_header_apid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_telemetry: PASSED only if they match.

import "std/aero/telemetry.oo";

pub fn main() {
    let g0_oa = telemetry_header_new(0, 0, 0);
    let g0_ob = telemetry_header_new(0, 0, 0);
    let g0_a = telemetry_header_apid(g0_oa);
    let g0_b = telemetry_header_apid(g0_ob);
    if g0_a != g0_b {
        println("FAIL telemetry_header_apid");
        process_exit(1);
    }
    println("prod_gr_telemetry: PASSED");
}
