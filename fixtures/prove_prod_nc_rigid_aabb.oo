// # Product prove std/physics/rigid_aabb.oo
//
// Logline: Fail-closed emit+gcc+run asserts rigid_aabb_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/physics/rigid_aabb.oo.
//
// Beats:
//   1. Call rigid_aabb_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_rigid_aabb: PASSED only if it matches.

import "std/physics/rigid_aabb.oo";

pub fn main() {
    let a: Int = rigid_aabb_probe();
    if a != 0 {
        println("FAIL rigid_aabb_probe");
        process_exit(1);
    }
    println("prod_nc_rigid_aabb: PASSED");
}
