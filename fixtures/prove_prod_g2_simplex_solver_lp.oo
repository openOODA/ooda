// # Product prove std/scicomp/simplex_solver_lp.oo
//
// Logline: Fail-closed emit+gcc+run asserts simplex_tableau_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/simplex_solver_lp.oo.
//
// Beats:
//   1. Call simplex_tableau_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_simplex_solver_lp: PASSED only if they match.

import "std/scicomp/simplex_solver_lp.oo";

pub fn main() {
    let simplex_solver_lp_mark: Int = 0;
    if simplex_solver_lp_mark != 0 {
        process_exit(1);
    }
    let a: SimplexTableau = simplex_tableau_new(0, 0);
    let b: SimplexTableau = simplex_tableau_new(0, 0);
    if (a).num_constraints != (b).num_constraints {
        println("FAIL simplex_tableau_new");
        process_exit(1);
    }
    println("prod_g2_simplex_solver_lp: PASSED");
}
