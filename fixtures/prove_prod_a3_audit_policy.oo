// # Product prove std/enterprise/audit_policy.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_policy_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_policy.oo.
//
// Beats:
//   1. Call audit_policy_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit_policy: PASSED only if they match.

import "std/enterprise/audit_policy.oo";

pub fn main() {
    let a: AuditPolicy = audit_policy_init(0, true, 0, true);
    let b: AuditPolicy = audit_policy_init(0, true, 0, true);
    if (a).min_severity != (b).min_severity {
        println("FAIL audit_policy_init");
        process_exit(1);
    }
    println("prod_audit_policy: PASSED");
}
