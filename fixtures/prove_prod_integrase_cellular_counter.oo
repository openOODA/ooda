// # Product prove std/synthetic_biology/integrase_cellular_counter.oo
//
// Logline: Fail-closed emit+gcc+run asserts counter_process_pulse real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/integrase_cellular_counter.oo.
//
// Beats:
//   1. Call counter_process_pulse with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_integrase_cellular_counter: PASSED only if the assert holds.

import "std/synthetic_biology/integrase_cellular_counter.oo";

pub fn main() {
    let integrase_cellular_counter_mark: Int = 0;
    if integrase_cellular_counter_mark != 0 {
        process_exit(1);
    }
    let integrase_cellular_counter_state: CellularCounterState = CellularCounterState { current_count: 0, max_count_capacity: 0, stages: list_new(), terminal_reporter_active: true };
    let integrase_cellular_counter_a = counter_process_pulse(&integrase_cellular_counter_state, 2.0, 2.0);
    let integrase_cellular_counter_pulse_successfully_registered: Bool = (integrase_cellular_counter_a).pulse_successfully_registered;
    if integrase_cellular_counter_pulse_successfully_registered == true {
        println("FAIL counter_process_pulse");
        process_exit(1);
    }
    println("prod_integrase_cellular_counter: PASSED");
}
