// # Product prove std/sec/crypto/ckks_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_calculate_checksum is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ckks_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ckks_calculate_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_ckks_types: PASSED only if they match.

import "std/sec/crypto/ckks_types.oo";

pub fn main() {
    let g0_a = ckks_calculate_checksum("x");
    let g0_b = ckks_calculate_checksum("x");
    if g0_a != g0_b {
        println("FAIL ckks_calculate_checksum");
        process_exit(1);
    }
    println("prod_g0_ckks_types: PASSED");
}
