// # Typed Result try and equality lock
//
// Logline: Fail-closed emit+gcc+run of call? and == on Result[Int, String].
//
// Setup: Backend-C. Helpers must not assume OoResS.
//
// Beats:
//   1. f? yields Int 7.
//   2. Two Ok(7) compare equal; Ok(7) != Ok(8).
//   3. Exit 1 before PASSED on a miss.

pub fn f() -> Result[Int, String] {
    return Ok(7);
}

pub fn main() {
    let n: Int = f()?;
    if n != 7 {
        println("FAIL try");
        process_exit(1);
    }
    let a: Result[Int, String] = Ok(7);
    let b: Result[Int, String] = Ok(7);
    let c: Result[Int, String] = Ok(8);
    if a != b {
        println("FAIL eq");
        process_exit(1);
    }
    if a == c {
        println("FAIL ne");
        process_exit(1);
    }
    println("result_try_eq_smoke: PASSED");
}
