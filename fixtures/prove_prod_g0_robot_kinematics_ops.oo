// # Product prove std/robot/kinematics_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/robot/kinematics_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call math_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_kinematics_ops: PASSED only if they match.

import "std/robot/kinematics_ops.oo";

pub fn main() {
    let g0_a = math_pi();
    let g0_b = math_pi();
    if g0_a != g0_b {
        println("FAIL math_pi");
        process_exit(1);
    }
    println("prod_g0_kinematics_ops: PASSED");
}
