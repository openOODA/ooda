// # Product prove ISO 26262 Modular Safety Library
//
// Logline: Verify the modular ISO 26262 library classifies hazard severity, controllability, and exposure into ASIL QM..D, builds SafetyGoal records, and enforces diagnostic coverage and FTT thresholds.
//
// Setup: Imports std/sec/cps/iso26262.oo for constants and AsilLevel constructors and std/sec/cps/iso26262_checks.oo for classify and validation. Pure value-returning helpers, no IO.
//
// Beats:
//   1. Confirm asil_qm..asil_d, severity S0..S3, controllability C0..C3, exposure E0..E4, and FTT constants.
//   2. asil_classify maps (severity, controllability, exposure) into the correct ASIL level.
//   3. safety_goal_create and safety_goal_acceptable enforce diagnostic coverage and FTT thresholds.
//   4. asil_level_d constructor and safety_diagnostic_coverage_for / safety_min_ftt_for_asil pure helpers.

import "std/sec/cps/iso26262.oo";
import "std/sec/cps/iso26262_checks.oo";

pub fn test_asil_constants() {
    if asil_qm() != 0 { println("FAIL: asil_qm"); process_exit(1); }
    if asil_a() != 1 { println("FAIL: asil_a"); process_exit(1); }
    if asil_b() != 2 { println("FAIL: asil_b"); process_exit(1); }
    if asil_c() != 3 { println("FAIL: asil_c"); process_exit(1); }
    if asil_d() != 4 { println("FAIL: asil_d"); process_exit(1); }
    if iso26262_severity_s3() != 3 { println("FAIL: severity_s3"); process_exit(1); }
    if iso26262_controllability_c3() != 3 { println("FAIL: controllability_c3"); process_exit(1); }
    if iso26262_exposure_e4() != 4 { println("FAIL: exposure_e4"); process_exit(1); }
    if iso26262_ftt_zero() != 0 { println("FAIL: ftt_zero"); process_exit(1); }
    if iso26262_ftt_triple() != 3 { println("FAIL: ftt_triple"); process_exit(1); }
    println("PASS: asil and ftt constants");
}

pub fn test_asil_classify_qm_escape_paths() {
    let lvl_s0: Int = asil_classify(0, 0, 0);
    if lvl_s0 != asil_qm() {
        println("FAIL: severity 0 must classify as QM");
        process_exit(1);
    }
    let lvl_e0: Int = asil_classify(2, 2, 0);
    if lvl_e0 != asil_qm() {
        println("FAIL: exposure 0 must classify as QM");
        process_exit(1);
    }
    let lvl_c0: Int = asil_classify(2, 0, 2);
    if lvl_c0 != asil_qm() {
        println("FAIL: controllability 0 must classify as QM");
        process_exit(1);
    }
    println("PASS: asil_classify QM escape paths");
}

pub fn test_asil_classify_d() {
    let lvl: Int = asil_classify(3, 3, 4);
    if lvl != asil_d() {
        println("FAIL: (S3, C3, E4) must classify as ASIL D");
        process_exit(1);
    }
    let lvl_alt: Int = asil_classify(3, 3, 5);
    if lvl_alt != asil_d() {
        println("FAIL: (S3, C3, E5) overflow exposure must still classify as ASIL D");
        process_exit(1);
    }
    let lvl_c2: Int = asil_classify(3, 2, 4);
    if lvl_c2 != asil_c() {
        println("FAIL: (S3, C2, E4) must classify as ASIL C");
        process_exit(1);
    }
    println("PASS: asil_classify ASIL D and C matrix");
}

pub fn test_asil_classify_a_b() {
    let lvl_a1: Int = asil_classify(1, 1, 3);
    if lvl_a1 != asil_a() {
        println("FAIL: (S1, C1, E3) must classify as ASIL A");
        process_exit(1);
    }
    let lvl_b1: Int = asil_classify(2, 3, 3);
    if lvl_b1 != asil_b() {
        println("FAIL: (S2, C3, E3) must classify as ASIL B");
        process_exit(1);
    }
    let lvl_a2: Int = asil_classify(2, 1, 3);
    if lvl_a2 != asil_a() {
        println("FAIL: (S2, C1, E3) must classify as ASIL A");
        process_exit(1);
    }
    println("PASS: asil_classify A and B tiers");
}

pub fn test_asil_level_d_constructor() {
    let lv: AsilLevel = asil_level_d();
    if lv.level != 4 {
        println("FAIL: asil_level_d.level should be 4");
        process_exit(1);
    }
    if lv.full_name != "D" {
        println("FAIL: asil_level_d.full_name should be D");
        process_exit(1);
    }
    let lv_qm: AsilLevel = asil_level_qm();
    if lv_qm.level != 0 {
        println("FAIL: asil_level_qm.level should be 0");
        process_exit(1);
    }
    println("PASS: asil_level constructors");
}

pub fn test_safety_goal_acceptable() {
    let g_d: SafetyGoal = safety_goal_create("goal_d", 4, "x", "safe", iso26262_ftt_triple());
    if safety_goal_acceptable(&g_d) == false {
        println("FAIL: ASIL D goal with FTT 3 and DC 99 must be acceptable");
        process_exit(1);
    }
    let g_low_ftt: SafetyGoal = safety_goal_create("goal_low_ftt", 4, "x", "safe", iso26262_ftt_zero());
    if safety_goal_acceptable(&g_low_ftt) == true {
        println("FAIL: ASIL D goal with FTT 0 must be rejected");
        process_exit(1);
    }
    let g_a: SafetyGoal = safety_goal_create("goal_a", 1, "x", "safe", iso26262_ftt_zero());
    if safety_goal_acceptable(&g_a) == false {
        println("FAIL: ASIL A goal with FTT 0 and low DC must be acceptable");
        process_exit(1);
    }
    println("PASS: safety_goal_acceptable gate");
}

pub fn test_safety_diagnostic_coverage_for() {
    if safety_diagnostic_coverage_for(4) != 99 {
        println("FAIL: ASIL D must require 99% diagnostic coverage");
        process_exit(1);
    }
    if safety_diagnostic_coverage_for(3) != 95 {
        println("FAIL: ASIL C must require 95% diagnostic coverage");
        process_exit(1);
    }
    if safety_diagnostic_coverage_for(0) != 60 {
        println("FAIL: ASIL QM must require 60% diagnostic coverage");
        process_exit(1);
    }
    println("PASS: safety_diagnostic_coverage_for thresholds");
}

pub fn test_safety_min_ftt_for_asil() {
    if safety_min_ftt_for_asil(4) != iso26262_ftt_triple() {
        println("FAIL: ASIL D must require FTT 3");
        process_exit(1);
    }
    if safety_min_ftt_for_asil(2) != iso26262_ftt_single() {
        println("FAIL: ASIL B must require FTT 1");
        process_exit(1);
    }
    if safety_min_ftt_for_asil(0) != iso26262_ftt_zero() {
        println("FAIL: ASIL QM must require FTT 0");
        process_exit(1);
    }
    println("PASS: safety_min_ftt_for_asil thresholds");
}

pub fn main() {
    test_asil_constants();
    test_asil_classify_qm_escape_paths();
    test_asil_classify_d();
    test_asil_classify_a_b();
    test_asil_level_d_constructor();
    test_safety_goal_acceptable();
    test_safety_diagnostic_coverage_for();
    test_safety_min_ftt_for_asil();
    println("PROVE_PROD_ISO26262_MODULAR_PASSED");
}
