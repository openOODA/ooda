// # Product prove std/exploit_analysis/heap_unsorted_bin_attack.oo
//
// Logline: Fail-closed emit+gcc+run asserts unsorted_bin_attack_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_unsorted_bin_attack.oo.
//
// Beats:
//   1. Call unsorted_bin_attack_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_unsorted_bin_attack: PASSED only if they match.

import "std/exploit_analysis/heap_unsorted_bin_attack.oo";

pub fn main() {
    let heap_unsorted_bin_attack_mark: Int = 0;
    if heap_unsorted_bin_attack_mark != 0 {
        process_exit(1);
    }
    let a: UnsortedBinAttackPlan = unsorted_bin_attack_plan_new(0);
    let b: UnsortedBinAttackPlan = unsorted_bin_attack_plan_new(0);
    if (a).target_write_address != (b).target_write_address {
        println("FAIL unsorted_bin_attack_plan_new");
        process_exit(1);
    }
    println("prod_heap_unsorted_bin_attack: PASSED");
}
