// # Product prove std/astrophysics_relativity/gw_chirp_waveform_imr.oo
//
// Logline: Fail-closed emit+gcc+run asserts gw_chirp_mass_kg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_chirp_waveform_imr.oo.
//
// Beats:
//   1. Call gw_chirp_mass_kg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_chirp_waveform_imr: PASSED only if they match.

import "std/astrophysics_relativity/gw_chirp_waveform_imr.oo";

pub fn main() {
    let gw_chirp_waveform_imr_mark: Int = 0;
    if gw_chirp_waveform_imr_mark != 0 {
        process_exit(1);
    }
    let a: Float = gw_chirp_mass_kg(0.0, 0.0);
    let b: Float = gw_chirp_mass_kg(0.0, 0.0);
    if a != b {
        println("FAIL gw_chirp_mass_kg");
        process_exit(1);
    }
    println("prod_gw_chirp_waveform_imr: PASSED");
}
