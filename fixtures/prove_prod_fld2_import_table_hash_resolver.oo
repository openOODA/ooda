// # Product prove std/security_defense/import_table_hash_resolver.oo
//
// Logline: Fail-closed emit+gcc+run asserts ror13_hash_step is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/import_table_hash_resolver.oo.
//
// Beats:
//   1. Call ror13_hash_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_import_table_hash_resolver: PASSED only if they match.

import "std/security_defense/import_table_hash_resolver.oo";

pub fn main() {
    let import_table_hash_resolver_mark: Int = 0;
    if import_table_hash_resolver_mark != 0 {
        process_exit(1);
    }
    let import_table_hash_resolver_a: Int = ror13_hash_step(1, 1);
    let import_table_hash_resolver_b: Int = ror13_hash_step(1, 1);
    if import_table_hash_resolver_a != import_table_hash_resolver_b {
        println("FAIL ror13_hash_step");
        process_exit(1);
    }
    println("prod_import_table_hash_resolver: PASSED");
}
