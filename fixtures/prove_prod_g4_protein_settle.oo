// # Product prove std/protein_folding/md_settle_water_constraints.oo
//
// Logline: Fail-closed emit+gcc+run asserts SETTLE water geometry constraint calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_settle_water_constraints.oo.
//
// Beats:
//   1. Verify TIP3P and SPC/E canonical water model parameters.
//   2. Calculate center-of-mass centered coordinates using settle_calc_com.
//   3. Compute interatomic distances with settle_evaluate_distances.
//   4. Print prod_g4_protein_settle: PASSED and exit 0.

import "std/protein_folding/md_settle_water_constraints.oo";

pub fn main() {
    let tip3p: SettleWaterParams = settle_tip3p_params();
    if (tip3p).r_oh_target_a < 0.957 || (tip3p).r_oh_target_a > 0.958 || (tip3p).mass_oxygen < 15.99 || (tip3p).mass_oxygen > 16.01 {
        println("FAIL settle_tip3p_params");
        process_exit(1);
    }

    let spce: SettleWaterParams = settle_spce_params();
    if (spce).r_oh_target_a < 0.999 || (spce).r_oh_target_a > 1.001 || (spce).r_hh_target_a < 1.632 || (spce).r_hh_target_a > 1.634 {
        println("FAIL settle_spce_params");
        process_exit(1);
    }

    let coords: WaterTriangleCoords = WaterTriangleCoords {
        ox: 0.0,
        oy: 0.0,
        oz: 0.0,
        h1x: 0.0,
        h1y: 0.757,
        h1z: 0.586,
        h2x: 0.0,
        h2y: 0.0 - 0.757,
        h2z: 0.586,
    };

    let com_coords1: WaterTriangleCoords = settle_calc_com(&coords, &tip3p);
    let com_coords2: WaterTriangleCoords = settle_calc_com(&coords, &tip3p);

    if (com_coords1).ox != (com_coords2).ox || (com_coords1).oz != (com_coords2).oz {
        println("FAIL settle_calc_com");
        process_exit(1);
    }

    let eval_res: SettleResult = settle_evaluate_distances(&coords);
    if (eval_res).r_oh1_actual < 0.91 || (eval_res).r_oh1_actual > 0.93 {
        println("FAIL settle_evaluate_distances r_oh1");
        process_exit(1);
    }
    if (eval_res).r_hh_actual < 2.29 || (eval_res).r_hh_actual > 2.31 {
        println("FAIL settle_evaluate_distances r_hh");
        process_exit(1);
    }

    println("prod_g4_protein_settle: PASSED");
    process_exit(0);
}
