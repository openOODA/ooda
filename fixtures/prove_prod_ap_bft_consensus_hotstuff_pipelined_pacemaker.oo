// # Product prove std/bft_consensus/hotstuff_pipelined_pacemaker.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/hotstuff_pipelined_pacemaker.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_pipelined_pacemaker.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hotstuff_pipelined_pacemaker: PASSED only if they match.

import "std/bft_consensus/hotstuff_pipelined_pacemaker.oo";

pub fn main() {
    let hotstuff_pipelined_pacemaker_a = pacemaker_get_leader(0, 0);
    let hotstuff_pipelined_pacemaker_b = pacemaker_get_leader(0, 0);
    if hotstuff_pipelined_pacemaker_a != hotstuff_pipelined_pacemaker_b {
        println("FAIL hotstuff_pipelined_pacemaker");
        process_exit(1);
    }
    println("prod_ap_hotstuff_pipelined_pacemaker: PASSED");
}
