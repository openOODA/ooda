// # Product prove std/sec/crypto/ed25519_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts ed25519_sha512_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519_stubs.oo.
//
// Beats:
//   1. Call ed25519_sha512_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ed25519_stubs: PASSED only if they match.

import "std/sec/crypto/ed25519_stubs.oo";
import "std/str.oo";

pub fn main() {
    let ed25519_stubs_mark: Int = 0;
    if ed25519_stubs_mark != 0 {
        process_exit(1);
    }
    let a: String = ed25519_sha512_hash("x");
    let b: String = ed25519_sha512_hash("x");
    if str_eq(a, b) == false {
        println("FAIL ed25519_sha512_hash");
        process_exit(1);
    }
    println("prod_g2_ed25519_stubs: PASSED");
}
