// # Product prove std/multimedia/mkv_ebml.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebml_id_header is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/mkv_ebml.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ebml_id_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_mkv_ebml: PASSED only if they match.

import "std/multimedia/mkv_ebml.oo";

pub fn main() {
    let g0_a = ebml_id_header();
    let g0_b = ebml_id_header();
    if g0_a != g0_b {
        println("FAIL ebml_id_header");
        process_exit(1);
    }
    println("prod_gr_mkv_ebml: PASSED");
}
