// # Product prove std/net/http3_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts http3_frame_new is a real value.
//
// Setup: Isolated emit-c. Imports std/net/http3_frame.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call http3_frame_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_http3_frame: PASSED only if they match.

import "std/net/http3_frame.oo";

pub fn main() {
    let g0_oa = http3_frame_new(2, "x");
    let g0_ob = http3_frame_new(2, "x");
    let g0_a = (g0_oa).frame_type;
    let g0_b = (g0_ob).frame_type;
    if g0_a != g0_b {
        println("FAIL http3_frame_new.frame_type");
        process_exit(1);
    }
    println("prod_g0_http3_frame: PASSED");
}
