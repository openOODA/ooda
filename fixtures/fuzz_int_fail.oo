// # Int-domain fuzz fail
//
// Logline: Return x while ensuring result > x so the int fuzz rail fails.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target always_bad 0 100.
//   2. Require x >= 0 and ensure result > x.
//   3. Return x so the ensures lies.

// Pure Int-domain fuzz fail fixture: ensures result > x but body returns x.
// FUZZ_DOMAIN: int
// FUZZ_TARGET: always_bad 0 100
// FUZZ_REQUIRES: always_bad x >= 0
// FUZZ_ENSURES: always_bad result > x
pub fn always_bad(x: Int) -> Int
    requires x >= 0
    ensures result > x
{
    return x;
}

