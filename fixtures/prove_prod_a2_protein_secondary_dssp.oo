// # Product prove std/bio_advanced/protein_secondary_dssp.oo
//
// Logline: Fail-closed emit+gcc+run asserts dssp_kabsch_sander_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_secondary_dssp.oo.
//
// Beats:
//   1. Call dssp_kabsch_sander_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_secondary_dssp: PASSED only if they match.

import "std/bio_advanced/protein_secondary_dssp.oo";

pub fn main() {
    let protein_secondary_dssp_mark: Int = 0;
    if protein_secondary_dssp_mark != 0 {
        process_exit(1);
    }
    let a: Float = dssp_kabsch_sander_energy(0.0, 0.0, 0.0, 0.0);
    let b: Float = dssp_kabsch_sander_energy(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL dssp_kabsch_sander_energy");
        process_exit(1);
    }
    println("prod_protein_secondary_dssp: PASSED");
}
