// # Product prove std/satellite_dvb/satellite_im_multipoint_im3.oo
//
// Logline: Fail-closed emit+gcc+run asserts intermod_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_im_multipoint_im3.oo.
//
// Beats:
//   1. Call intermod_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_im_multipoint_im3: PASSED only if they match.

import "std/satellite_dvb/satellite_im_multipoint_im3.oo";

pub fn main() {
    let a: IntermodConfig = intermod_config_new(0, 0.0, 0);
    let b: IntermodConfig = intermod_config_new(0, 0.0, 0);
    if a.num_carriers != b.num_carriers {
        println("FAIL intermod_config_new");
        process_exit(1);
    }
    println("prod_satellite_im_multipoint_im3: PASSED");
}
