// # Product prove std/astro_advanced/gravity_turn_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts gravity_turn_pitch_deg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/gravity_turn_trajectory.oo.
//
// Beats:
//   1. Call gravity_turn_pitch_deg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gravity_turn_trajectory: PASSED only if they match.

import "std/astro_advanced/gravity_turn_trajectory.oo";

pub fn main() {
    let a = gravity_turn_pitch_deg();
    let b = gravity_turn_pitch_deg();
    if a != b {
        println("FAIL gravity_turn_pitch_deg");
        process_exit(1);
    }
    println("prod_gravity_turn_trajectory: PASSED");
}
