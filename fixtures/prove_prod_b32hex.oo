// # Product Base32hex prove
//
// Logline: Fail-closed emit+gcc+run of shipped base32_hex_encode_byte.
//
// Setup: Product std/text/base32_hex.oo. RFC 4648 hex alphabet 0-9A-V.
//
// Beats:
//   1. Byte 0 is 00; byte 31 is 0V.
//   2. Byte 32 is 10; V is a valid char; W is not.
//   3. Exit 1 before PASSED on a miss.

import "std/text/base32_hex.oo";

pub fn main() {
    let z: String = base32_hex_encode_byte(0);
    if z != "00" {
        println("FAIL b32hex 0");
        process_exit(1);
    }
    let v: String = base32_hex_encode_byte(31);
    if v != "0V" {
        println("FAIL b32hex 31");
        process_exit(1);
    }
    let t: String = base32_hex_encode_byte(32);
    if t != "10" {
        println("FAIL b32hex 32");
        process_exit(1);
    }
    let ok: Bool = base32_hex_is_valid_char("V");
    if ok == false {
        println("FAIL b32hex V");
        process_exit(1);
    }
    let bad: Bool = base32_hex_is_valid_char("W");
    if bad == true {
        println("FAIL b32hex W");
        process_exit(1);
    }
    println("prod_b32hex: PASSED");
}
