// # Product prove std/gis_topo/wkt_geometry_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts wkt_is_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/wkt_geometry_parser.oo.
//
// Beats:
//   1. Call wkt_is_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wkt_geometry_parser: PASSED only if they match.

import "std/gis_topo/wkt_geometry_parser.oo";

pub fn main() {
    let wkt_geometry_parser_mark: Int = 0;
    if wkt_geometry_parser_mark != 0 {
        process_exit(1);
    }
    let wkt_geometry_parser_a: Bool = wkt_is_empty("x");
    let wkt_geometry_parser_b: Bool = wkt_is_empty("x");
    if wkt_geometry_parser_a != wkt_geometry_parser_b {
        println("FAIL wkt_is_empty");
        process_exit(1);
    }
    println("prod_wkt_geometry_parser: PASSED");
}
