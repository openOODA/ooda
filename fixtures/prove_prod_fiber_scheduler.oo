// # Product prove std/sync/fiber_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts scheduler_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/fiber_scheduler.oo.
//
// Beats:
//   1. Call scheduler_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fiber_scheduler: PASSED only if they match.

import "std/sync/fiber_scheduler.oo";

pub fn main() {
    let obj = scheduler_new();
    let a = scheduler_len(obj);
    let b = scheduler_len(obj);
    if a != b {
        println("FAIL scheduler_len");
        process_exit(1);
    }
    println("prod_fiber_scheduler: PASSED");
}
