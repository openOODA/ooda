// # Product prove std/space_propulsion/resistojet_electrothermal.oo
//
// Logline: Fail-closed emit+gcc+run asserts resistojet_spec_default_ammonia value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/resistojet_electrothermal.oo.
//
// Beats:
//   1. Call resistojet_spec_default_ammonia twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_resistojet_electrothermal: PASSED only if asserts hold.

import "std/space_propulsion/resistojet_electrothermal.oo";

pub fn main() {
    let resistojet_electrothermal: ResistojetSpec = resistojet_spec_default_ammonia();
    let resistojet_electrothermal_b: ResistojetSpec = resistojet_spec_default_ammonia();
    if (resistojet_electrothermal).propellant_type != 2 {
        println("FAIL resistojet_spec_default_ammonia propellant_type");
        process_exit(1);
    }
    if (resistojet_electrothermal).propellant_type != (resistojet_electrothermal_b).propellant_type {
        println("FAIL resistojet_spec_default_ammonia det");
        process_exit(1);
    }
    println("prod_resistojet_electrothermal: PASSED");
}
