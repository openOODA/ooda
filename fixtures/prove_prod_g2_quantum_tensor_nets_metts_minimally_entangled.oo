// # Product prove std/quantum_tensor_nets/metts_minimally_entangled.oo
//
// Logline: Fail-closed emit+gcc+run asserts metts_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/metts_minimally_entangled.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call metts_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_metts_minimally_entangled: PASSED only if they match.

import "std/quantum_tensor_nets/metts_minimally_entangled.oo";

pub fn main() {
    let g2_oa: MettsConfig = metts_config_default(2, 1.0);
    let g2_ob: MettsConfig = metts_config_default(2, 1.0);
    let g2_a = (g2_oa).num_sites;
    let g2_b = (g2_ob).num_sites;
    if g2_a != g2_b {
        println("FAIL metts_config_default.num_sites");
        process_exit(1);
    }
    println("prod_g2_metts_minimally_entangled: PASSED");
}
