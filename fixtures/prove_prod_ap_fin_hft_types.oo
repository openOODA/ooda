// # Product prove std/fin/hft_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/hft_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hft_types: PASSED only if they match.

import "std/fin/hft_types.oo";

pub fn main() {
    let hft_types_a = hft_tick_new(0, 0, 0);
    let hft_types_b = hft_tick_new(0, 0, 0);
    let hft_types_va = hft_tick_price(hft_types_a);
    let hft_types_vb = hft_tick_price(hft_types_b);
    if hft_types_va != hft_types_vb {
        println("FAIL hft_types");
        process_exit(1);
    }
    println("prod_ap_hft_types: PASSED");
}
