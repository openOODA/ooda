// # Product prove std/net_telemetry/dpi_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts dpi_stream_ingest is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/dpi_stream.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dpi_stream_ingest twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dpi_stream: PASSED only if they match.

import "std/net_telemetry/dpi_stream.oo";

pub fn main() {
    let mut g0_oa = dpi_stream_session_new("x", 0);
    let mut g0_ob = dpi_stream_session_new("x", 0);
    let g0_a = dpi_stream_ingest(&g0_oa, 0, "x");
    let g0_b = dpi_stream_ingest(&g0_ob, 0, "x");
    if g0_a != g0_b {
        println("FAIL dpi_stream_ingest");
        process_exit(1);
    }
    println("prod_gr_dpi_stream: PASSED");
}
