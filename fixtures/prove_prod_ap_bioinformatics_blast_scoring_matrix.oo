// # Product prove std/bioinformatics/blast_scoring_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/blast_scoring_matrix.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/blast_scoring_matrix.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_blast_scoring_matrix: PASSED only if they match.

import "std/bioinformatics/blast_scoring_matrix.oo";

pub fn main() {
    let blast_scoring_matrix_a = blosum62_lookup_score(0, 0);
    let blast_scoring_matrix_b = blosum62_lookup_score(0, 0);
    if blast_scoring_matrix_a != blast_scoring_matrix_b {
        println("FAIL blast_scoring_matrix");
        process_exit(1);
    }
    println("prod_ap_blast_scoring_matrix: PASSED");
}
