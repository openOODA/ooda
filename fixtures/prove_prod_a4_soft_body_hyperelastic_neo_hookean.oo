// # Product prove std/physics_advanced/soft_body_hyperelastic_neo_hookean.oo
//
// Logline: Fail-closed emit+gcc+run asserts hydrostatic_pressure is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_hyperelastic_neo_hookean.oo.
//
// Beats:
//   1. Call hydrostatic_pressure twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_soft_body_hyperelastic_neo_hookean: PASSED only if they match.

import "std/physics_advanced/soft_body_hyperelastic_neo_hookean.oo";

pub fn main() {
    let soft_body_hyperelastic_neo_hookean_mark: Int = 0;
    if soft_body_hyperelastic_neo_hookean_mark != 0 {
        process_exit(1);
    }
    let a: Float = hydrostatic_pressure(0.0, 0.0);
    let b: Float = hydrostatic_pressure(0.0, 0.0);
    if a != b {
        println("FAIL hydrostatic_pressure");
        process_exit(1);
    }
    println("prod_soft_body_hyperelastic_neo_hookean: PASSED");
}
