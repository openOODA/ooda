// # Refuse secret via wrapper fn into process_exec
//
// Logline: Passing a SECRET token through a wrapper function into process_exec must fail closed.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Pass token through wrapper function wrap_cmd.
//   3. Pass wrapped return value into process_exec so the sink refuses.
//
// Secret passed through wrapper must not reach process_exec
// SECRET: token
pub fn wrap_cmd(tok: String) -> String {
    return tok;
}

pub fn main(p: &ProcessCap) {
    let token = "s3cret-payload";
    let cmd = wrap_cmd(token);
    let r = process_exec(p, cmd);
    println(1);
}
