// # Const integer add println for WASI emit
//
// Logline: Print 1 + 2 so emit-wasm can plant a WASI fd_write body of 3.
//
// Setup: No imports. One public main. The body is only println of two INT literals plus.
//
// Beats:
//   1. Declare public main.
//   2. Print 1 + 2.
//   3. Leave no other statements so wasm_fn_println_add can see a print-only body.

pub fn main() { println(1 + 2); }
