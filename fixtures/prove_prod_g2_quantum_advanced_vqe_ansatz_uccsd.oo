// # Product prove std/quantum_advanced/vqe_ansatz_uccsd.oo
//
// Logline: Fail-closed emit+gcc+run asserts uccsd_trotter_step_count is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_ansatz_uccsd.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call uccsd_trotter_step_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vqe_ansatz_uccsd: PASSED only if they match.

import "std/quantum_advanced/vqe_ansatz_uccsd.oo";

pub fn main() {
    let g2_oa: UccsdConfig = UccsdConfig { num_spatial_orbitals: 2, num_spin_orbitals: 2, num_electrons: 2, num_singles: 2, num_doubles: 2, total_amplitudes: 2 };
    let g2_ob: UccsdConfig = UccsdConfig { num_spatial_orbitals: 2, num_spin_orbitals: 2, num_electrons: 2, num_singles: 2, num_doubles: 2, total_amplitudes: 2 };
    let g2_a = uccsd_trotter_step_count(&g2_oa, 2);
    let g2_b = uccsd_trotter_step_count(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL uccsd_trotter_step_count");
        process_exit(1);
    }
    println("prod_g2_vqe_ansatz_uccsd: PASSED");
}
