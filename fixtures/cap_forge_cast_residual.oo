// # Sealed dlopen grant
//
// Logline: Call dlopen only with a real UnsafeFFICap grant, not a forged cast.
//
// Beats:
//   1. Take &UnsafeFFICap on main.
//   2. Call dlopen on libc.so.6.
//   3. Print sealed on Err and ok on Ok.

// M169 path A: no product `as fn(...)` cast surface (IDENT "as" reserved).
// Classic magic-int forge is runtime-denied; cast-bypass is residual if surface appears.
pub fn main(ffi: &UnsafeFFICap) {
    // Valid path A: sealed free name requires real grant, not forge token at runtime.
    let r = dlopen(ffi, "libc.so.6");
    if r.is_err {
        println("sealed");
    } else {
        println("ok");
    }
}
