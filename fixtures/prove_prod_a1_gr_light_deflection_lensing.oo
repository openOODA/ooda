// # Product prove std/astrophysics_relativity/gr_light_deflection_lensing.oo
//
// Logline: Fail-closed emit+gcc+run asserts gr_light_deflection_angle is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_light_deflection_lensing.oo.
//
// Beats:
//   1. Call gr_light_deflection_angle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_light_deflection_lensing: PASSED only if they match.

import "std/astrophysics_relativity/gr_light_deflection_lensing.oo";

pub fn main() {
    let gr_light_deflection_lensing_mark: Int = 0;
    if gr_light_deflection_lensing_mark != 0 {
        process_exit(1);
    }
    let a: Int = gr_light_deflection_angle(0, 0);
    let b: Int = gr_light_deflection_angle(0, 0);
    if a != b {
        println("FAIL gr_light_deflection_angle");
        process_exit(1);
    }
    println("prod_gr_light_deflection_lensing: PASSED");
}
