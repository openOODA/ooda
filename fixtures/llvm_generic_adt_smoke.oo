// # Generic ADT and sum types smoke test
//
// Logline: Verifies Option, Result, and custom enum lowering with multiple payload types in LLVM IR.
//
// Setup: oodac emit-llvm and execute to verify correct tagged union unpacking.
//
// Beats:
//   1. Test Option[Int], Option[Bool], Option[Float], and Option[String].
//   2. Test Result[Int, String], Result[Bool, String], and Result[Float, String].
//   3. Test custom enum variants with Int, Bool, and struct payloads.

type Point = struct {
    x: Int,
    y: Int
};

type Value = Num(Int) | Flag(Bool) | Coord(Point) | Empty;

fn test_options() {
    let o1: Option[Int] = Some(42);
    let v1: Int = match o1 {
        Some(x) => x,
        None => 0
    };
    assert_eq(v1, 42);

    let o2: Option[Int] = None;
    let v2: Int = match o2 {
        Some(x) => x,
        None => 99
    };
    assert_eq(v2, 99);

    let o3: Option[Bool] = Some(true);
    let v3: Bool = match o3 {
        Some(b) => b,
        None => false
    };
    assert_eq(v3, true);

    let o4: Option[Float] = Some(3.14);
    match o4 {
        Some(f) => println("Option[Float] Some ok"),
        None => println("Option[Float] None")
    }

    let o5: Option[String] = Some("hello");
    let v5: String = match o5 {
        Some(s) => s,
        None => "empty"
    };
    assert_eq(v5, "hello");
}

fn test_results() {
    let r1: Result[Int, String] = Ok(100);
    let v1: Int = match r1 {
        Ok(n) => n,
        Err(e) => 0
    };
    assert_eq(v1, 100);

    let r2: Result[Int, String] = Err("failed");
    let v2: String = match r2 {
        Ok(n) => "ok",
        Err(e) => e
    };
    assert_eq(v2, "failed");

    let r3: Result[Bool, String] = Ok(true);
    let v3: Bool = match r3 {
        Ok(b) => b,
        Err(e) => false
    };
    assert_eq(v3, true);

    let r4: Result[Float, String] = Ok(2.718);
    match r4 {
        Ok(f) => println("Result[Float] Ok"),
        Err(e) => println(e)
    }

    let r5: Result[String, String] = Ok("success");
    let v5: String = match r5 {
        Ok(s) => s,
        Err(e) => e
    };
    assert_eq(v5, "success");
}

fn test_custom_enums() {
    let e1: Value = Num(55);
    let r1: Int = match e1 {
        Num(n) => n,
        Flag(b) => 0,
        Coord(pt) => pt.x,
        Empty => 0
    };
    assert_eq(r1, 55);

    let e2: Value = Flag(true);
    let r2: Bool = match e2 {
        Num(n) => false,
        Flag(b) => b,
        Coord(pt) => false,
        Empty => false
    };
    assert_eq(r2, true);

    let pt0 = Point { x: 12, y: 34 };
    let e3: Value = Coord(pt0);
    let r3: Int = match e3 {
        Num(n) => 0,
        Flag(b) => 0,
        Coord(p) => p.x + p.y,
        Empty => 0
    };
    assert_eq(r3, 46);

    let e4: Value = Empty;
    let r4: Int = match e4 {
        Num(n) => 1,
        Flag(b) => 2,
        Coord(p) => 3,
        Empty => 4
    };
    assert_eq(r4, 4);
}

pub fn main() {
    test_options();
    test_results();
    test_custom_enums();
    println("PASS: llvm_generic_adt_smoke");
}
