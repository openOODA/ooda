// # Product async_read prove
//
// Logline: Fail-closed emit+gcc+run of shipped async_reader_new/remaining/poll_read.
//
// Setup: Product std/io/async_read.oo. Source "hi".
//
// Beats:
//   1. remaining 2; poll_read 2 bytes_read 2 data hi.
//   2. Exit 1 before PASSED on a miss.

import "std/io/async_read.oo";

pub fn main() {
    let r: AsyncReader = async_reader_new("hi");
    let rem: Int = async_reader_remaining(r);
    if rem != 2 {
        println("FAIL aread rem");
        process_exit(1);
    }
    let res: AsyncReadResult = async_reader_poll_read(r, 2);
    let n: Int = res.bytes_read;
    if n != 2 {
        println("FAIL aread n");
        process_exit(1);
    }
    let d: String = res.data;
    if d != "hi" {
        println("FAIL aread data");
        process_exit(1);
    }
    println("prod_aread: PASSED");
}
