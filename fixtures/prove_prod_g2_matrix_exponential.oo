// # Product prove std/scicomp/matrix_exponential.oo
//
// Logline: Fail-closed emit+gcc+run asserts dense_mat_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/matrix_exponential.oo.
//
// Beats:
//   1. Call dense_mat_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_matrix_exponential: PASSED only if they match.

import "std/scicomp/matrix_exponential.oo";

pub fn main() {
    let matrix_exponential_mark: Int = 0;
    if matrix_exponential_mark != 0 {
        process_exit(1);
    }
    let a: DenseMatrix = dense_mat_identity(0);
    let b: DenseMatrix = dense_mat_identity(0);
    if (a).rows != (b).rows {
        println("FAIL dense_mat_identity");
        process_exit(1);
    }
    println("prod_g2_matrix_exponential: PASSED");
}
