// # Product prove std/gis_topo/isoline_marching_squares.oo
//
// Logline: Fail-closed emit+gcc+run asserts contour_segment_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/isoline_marching_squares.oo.
//
// Beats:
//   1. Call contour_segment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isoline_marching_squares: PASSED only if they match.

import "std/gis_topo/isoline_marching_squares.oo";

pub fn main() {
    let a: ContourSegment2D = contour_segment_new(0.0, 0.0, 0.0, 0.0);
    let b: ContourSegment2D = contour_segment_new(0.0, 0.0, 0.0, 0.0);
    if a.x1 != b.x1 {
        println("FAIL contour_segment_new");
        process_exit(1);
    }
    println("prod_isoline_marching_squares: PASSED");
}
