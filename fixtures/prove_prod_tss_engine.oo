import "std/sec/crypto/tss_engine.oo";

pub fn main() {
    let tss_engine_mark: Int = 0;
    if tss_engine_mark != 0 { process_exit(1); }
    let a: TssSecurityPolicy = tss_policy_init(true, true, 0);
    let b: TssSecurityPolicy = tss_policy_init(true, true, 0);
    if a != b { process_exit(1); }
    println("prod_tss_engine: PASSED");
}
