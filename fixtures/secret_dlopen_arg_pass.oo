// # Allow a public dlopen flag
//
// Logline: A literal flag may reach dlopen while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public path and flag instead.
//   3. Expect emit to allow the call.

// M-? dlopen non-path arg clean: literal flag may pass (emit path)
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "s3cret";
    let r = dlopen(ffi, "libx.so", "RTLD_LAZY");
    println(1);
}
