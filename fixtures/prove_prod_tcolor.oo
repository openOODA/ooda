// # Product os terminal color prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/os/terminal_color.oo.
//
// Setup: Product std/os/terminal_color.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. reset and red escape sequences. red != green.
//   9. Exit 1 before PASSED on a miss.

import "std/os/terminal_color.oo";

pub fn main() {
    let r: String = color_reset();
    if r != "\x1b[0m" {
        println("FAIL tcolor reset");
        process_exit(1);
    }
    let red: String = color_red();
    if red != "\x1b[31m" {
        println("FAIL tcolor red");
        process_exit(1);
    }
    let g: String = color_green();
    if g == red {
        println("FAIL tcolor greq");
        process_exit(1);
    }
    println("prod_tcolor: PASSED");
}
