// # Product prove std/graph_topology/louvain_community_detect.oo
//
// Logline: Fail-closed emit+gcc+run asserts louvain_get_community is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/louvain_community_detect.oo.
//
// Beats:
//   1. Call louvain_get_community twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_louvain_community_detect: PASSED only if they match.

import "std/graph_topology/louvain_community_detect.oo";

pub fn main() {
    let louvain_community_detect_mark: Int = 0;
    if louvain_community_detect_mark != 0 {
        process_exit(1);
    }
    let a: Int = louvain_get_community(LouvainResult { ptr: 0, len: 0, cap: 0 }, 0);
    let b: Int = louvain_get_community(LouvainResult { ptr: 0, len: 0, cap: 0 }, 0);
    if a != b {
        println("FAIL louvain_get_community");
        process_exit(1);
    }
    println("prod_louvain_community_detect: PASSED");
}
