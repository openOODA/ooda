// # Product prove std/os/terminal_raw_mode_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts raw_mode_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_raw_mode_stub.oo.
//
// Beats:
//   1. Call raw_mode_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_raw_mode_stub: PASSED only if they match.

import "std/os/terminal_raw_mode_stub.oo";

pub fn main() {
    let obj = raw_mode_config_new();
    let a = obj.echo_enabled;
    let b = obj.echo_enabled;
    if a != b {
        println("FAIL raw_mode_config_new");
        process_exit(1);
    }
    println("prod_terminal_raw_mode_stub: PASSED");
}
