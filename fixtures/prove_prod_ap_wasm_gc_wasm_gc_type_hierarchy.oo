// # Product prove std/wasm_gc/wasm_gc_type_hierarchy.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/wasm_gc/wasm_gc_type_hierarchy.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_type_hierarchy.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_gc_type_hierarchy: PASSED only if they match.

import "std/wasm_gc/wasm_gc_type_hierarchy.oo";

pub fn main() {
    let wasm_gc_type_hierarchy_a = gc_comp_struct();
    let wasm_gc_type_hierarchy_b = gc_comp_struct();
    if wasm_gc_type_hierarchy_a != wasm_gc_type_hierarchy_b {
        println("FAIL wasm_gc_type_hierarchy");
        process_exit(1);
    }
    println("prod_ap_wasm_gc_type_hierarchy: PASSED");
}
