// # Product prove std/text/regex.oo
//
// Logline: Fail-closed emit+gcc+run asserts regex_compile holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/text/regex.oo.
//
// Beats:
//   1. Call regex_compile using the regex ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_regex: PASSED only if asserts hold.

import "std/text/regex.oo";

pub fn main() {
    let xa = regex_compile("x");
    let xb = regex_compile("x");
    let regex_a = xa.is_ok();
    if !regex_a {
        println("FAIL regex_compile");
        process_exit(1);
    }
    println("prod_regex: PASSED");
}
