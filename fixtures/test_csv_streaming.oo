// # RFC 4180 CSV adversarial suite
//
// Logline: Parses quoted commas, embedded CRLF, escaped quotes, and header column indices.
//
// Setup: Pure. Imports csv_streaming.oo. Run from ooda/.
//
// Beats:
//   1. Parse a header row plus a quoted data row.
//   2. Unescape "" and keep commas and CRLF inside quotes.
//   3. Index a named column on the header and read that cell.
//   4. Reject an unterminated quote. Quoted '-' and '_' round-trip.

import "std/parsers/csv_streaming.oo";

fn ascii(s: String) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < bytes_len(s) {
        o = list_push(o, byte_at(s, i));
        i = i + 1;
    }
    return o;
}

fn push(o: List[Int], b: Int) -> List[Int] {
    let mut n: List[Int] = o;
    n = list_push(n, b);
    return n;
}

fn from_bytes(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    buf = bytes_push(buf, a);
    buf = bytes_push(buf, b);
    buf = bytes_push(buf, c);
    buf = bytes_push(buf, d);
    buf = bytes_push(buf, e);
    buf = bytes_push(buf, f);
    buf = bytes_push(buf, g);
    return bytes_to_str(buf);
}

pub fn main() {
    let mut src: List[Int] = list_new();
    src = push(src, 105);
    src = push(src, 100);
    src = push(src, 44);
    src = push(src, 110);
    src = push(src, 97);
    src = push(src, 109);
    src = push(src, 101);
    src = push(src, 13);
    src = push(src, 10);
    src = push(src, 49);
    src = push(src, 44);
    src = push(src, 34);
    src = push(src, 97);
    src = push(src, 44);
    src = push(src, 13);
    src = push(src, 10);
    src = push(src, 98);
    src = push(src, 34);
    src = push(src, 34);
    src = push(src, 99);
    src = push(src, 34);
    src = push(src, 13);
    src = push(src, 10);
    let d: CsvOut = csv_streaming_parse(src);
    let f: Int = d.flag;
    if f < 1 {
        println("FAIL parse " + d.err);
        process_exit(1);
    }
    let cells: List[String] = d.cells;
    let nc: Int = d.ncols;
    let nr: Int = d.nrows;
    let col: Result[Int, String] = csv_streaming_col(cells, nc, "name");
    match col {
        Ok(c) => {
            let cell: Result[String, String] = csv_streaming_cell(cells, nc, nr, 1, c);
            match cell {
                Ok(v) => {
                    let want: String = from_bytes(97, 44, 13, 10, 98, 34, 99);
                    if v == want {
                        println("quoted comma, embedded CRLF, unescape, header-to-column index used on a data row");
                    } else {
                        println("FAIL cell bytes");
                        process_exit(1);
                    }
                },
                Err(e) => {
                    println("FAIL cell " + e);
                    process_exit(1);
                }
            }
        },
        Err(e) => {
            println("FAIL col " + e);
            process_exit(1);
        }
    }
    let bad: CsvOut = csv_streaming_parse(ascii("a,\"b"));
    let bf: Int = bad.flag;
    if bf > 0 {
        println("FAIL unterminated quote ok");
        process_exit(1);
    }
    let st: Result[Int, String] = csv_streaming_stat(bf, bad.err, bad.nrows);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("unterminated quote is Err");
    let mut punc: List[Int] = list_new();
    punc = push(punc, 34);
    punc = push(punc, 97);
    punc = push(punc, 45);
    punc = push(punc, 98);
    punc = push(punc, 95);
    punc = push(punc, 99);
    punc = push(punc, 34);
    let dp: CsvOut = csv_streaming_parse(punc);
    let pf: Int = dp.flag;
    if pf < 1 {
        println("FAIL punct parse " + dp.err);
        process_exit(1);
    }
    let pc: List[String] = dp.cells;
    let pnc: Int = dp.ncols;
    let pnr: Int = dp.nrows;
    let pcell: Result[String, String] = csv_streaming_cell(pc, pnc, pnr, 0, 0);
    match pcell {
        Ok(v) => {
            if v == "a-b_c" {
                println("quoted field containing - and _ round-trips");
            } else {
                println("FAIL punct cell " + v);
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL punct cell " + e);
            process_exit(1);
        }
    }
    let mut jag: List[Int] = list_new();
    jag = push(jag, 97);
    jag = push(jag, 44);
    jag = push(jag, 98);
    jag = push(jag, 10);
    jag = push(jag, 99);
    let dj: CsvOut = csv_streaming_parse(jag);
    if dj.flag > 0 {
        println("FAIL columns ok");
        process_exit(1);
    }
    println("column-count mismatch Err");
    println("SUITE PASSED");
    println("test_csv_streaming: PASSED");
}
