// # Product prove std/math/matrix_decomp_qr.oo
//
// Logline: Fail-closed verification that QR decomposition and least squares solver are deterministic.
//
// Setup: Isolated emit-c. Imports std/math/matrix_decomp_qr.oo.
//
// Beats:
//   1. Construct concrete 2x2 test matrix and RHS vector.
//   2. Factorize via matrix_qr and check R diagonal elements.
//   3. Solve linear system via qr_solve and qr_least_squares.
//   4. Print prod_g4_matrix_decomp_qr: PASSED and exit 0.

import "std/math/matrix_decomp_qr.oo";

pub fn main() {
    let mut d: List[Float] = list_new();
    d = list_push(d, 1.0);
    d = list_push(d, 1.0);
    d = list_push(d, 0.0);
    d = list_push(d, 1.0);
    let mat: Matrix = Matrix { rows: 2, cols: 2, data: d };

    let qr1 = matrix_qr(mat);
    let qr2 = matrix_qr(mat);

    let r00_1 = matrix_get(qr1.r, 0, 0);
    let r00_2 = matrix_get(qr2.r, 0, 0);
    let r11_1 = matrix_get(qr1.r, 1, 1);
    let r11_2 = matrix_get(qr2.r, 1, 1);

    if r00_1 != r00_2 || r11_1 != r11_2 {
        println("FAIL matrix_qr R mismatch");
        process_exit(1);
    }

    if r00_1 < 0.99 || r00_1 > 1.01 || r11_1 < 0.99 || r11_1 > 1.01 {
        println("FAIL matrix_qr R values");
        process_exit(1);
    }

    let mut b_vec: List[Float] = list_new();
    b_vec = list_push(b_vec, 3.0);
    b_vec = list_push(b_vec, 2.0);

    let sol_res1 = qr_solve(qr1, b_vec);
    let sol_res2 = qr_solve(qr2, b_vec);

    if sol_res1.is_err() || sol_res2.is_err() {
        println("FAIL qr_solve is_err");
        process_exit(1);
    }

    let sol1 = match sol_res1 {
        Ok(v) => v,
        Err(_) => list_new(),
    };

    let x0 = list_get(sol1, 0);
    let x1 = list_get(sol1, 1);

    if x0 < 0.99 || x0 > 1.01 || x1 < 1.99 || x1 > 2.01 {
        println("FAIL qr_solve solution values");
        process_exit(1);
    }

    let ls_res = qr_least_squares(mat, b_vec);
    let ls_x0 = list_get(ls_res, 0);
    let ls_x1 = list_get(ls_res, 1);

    if ls_x0 < 0.99 || ls_x0 > 1.01 || ls_x1 < 1.99 || ls_x1 > 2.01 {
        println("FAIL qr_least_squares solution values");
        process_exit(1);
    }

    println("prod_g4_matrix_decomp_qr: PASSED");
    process_exit(0);
}
