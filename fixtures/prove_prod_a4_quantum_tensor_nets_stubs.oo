// # Product prove std/quantum_tensor_nets/quantum_tensor_nets_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts tensor_nets_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/quantum_tensor_nets_stubs.oo.
//
// Beats:
//   1. Call tensor_nets_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_tensor_nets_stubs: PASSED only if they match.

import "std/quantum_tensor_nets/quantum_tensor_nets_stubs.oo";

pub fn main() {
    let quantum_tensor_nets_stubs_mark: Int = 0;
    if quantum_tensor_nets_stubs_mark != 0 {
        process_exit(1);
    }
    let a: TensorNetsCapabilities = tensor_nets_capabilities_default();
    let b: TensorNetsCapabilities = tensor_nets_capabilities_default();
    if (a).max_mps_bond_dimension != (b).max_mps_bond_dimension {
        println("FAIL tensor_nets_capabilities_default");
        process_exit(1);
    }
    println("prod_quantum_tensor_nets_stubs: PASSED");
}
