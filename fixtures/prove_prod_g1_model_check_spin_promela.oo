// # Product prove std/formal_verif/model_check_spin_promela.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_spin_promela.oo.
//
// Beats:
//   1. Call channel_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_model_check_spin_promela: PASSED only if they match.

import "std/formal_verif/model_check_spin_promela.oo";

pub fn main() {
    let a: ChannelBuffer = channel_buffer_new(0, 1);
    let b: ChannelBuffer = channel_buffer_new(0, 1);
    if a.channel_id != b.channel_id {
        println("FAIL channel_buffer_new");
        process_exit(1);
    }
    println("prod_model_check_spin_promela: PASSED");
}
