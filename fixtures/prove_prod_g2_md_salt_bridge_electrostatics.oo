// # Product prove std/protein_folding/md_salt_bridge_electrostatics.oo
//
// Logline: Fail-closed emit+gcc+run asserts salt_bridge_screened_coulomb is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_salt_bridge_electrostatics.oo.
//
// Beats:
//   1. Call salt_bridge_screened_coulomb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_salt_bridge_electrostatics: PASSED only if they match.

import "std/protein_folding/md_salt_bridge_electrostatics.oo";

pub fn main() {
    let md_salt_bridge_electrostatics_mark: Int = 0;
    if md_salt_bridge_electrostatics_mark != 0 {
        process_exit(1);
    }
    let a: Float = salt_bridge_screened_coulomb(0.0, 0.0);
    let b: Float = salt_bridge_screened_coulomb(0.0, 0.0);
    if a != b {
        println("FAIL salt_bridge_screened_coulomb");
        process_exit(1);
    }
    println("prod_g2_md_salt_bridge_electrostatics: PASSED");
}
