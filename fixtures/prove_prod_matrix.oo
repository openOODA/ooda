// # Product matrix shape prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/math/matrix.oo zeros, identity, square.
//
// Setup: Tree oodac emit-c. Calls ooda/std/math/matrix.oo. Destub none. No caps.
//
// Beats:
//   1. matrix_zeros(2,3) has 2 rows and 3 cols.
//   2. matrix_is_square of that is false.
//   3. matrix_identity(2) is square (2x2).
//   4. Exit 1 on any miss. Print prod_matrix: PASSED only if all hold.
// residual: List[Float] get/set identity payload not asserted (emit concat).

import "std/math/matrix.oo";

pub fn main() {
    let z: Matrix = matrix_zeros(2, 3);
    let zr: Int = matrix_rows(z);
    if zr != 2 {
        println("FAIL matrix rows");
        process_exit(1);
    }
    let zc: Int = matrix_cols(z);
    if zc != 3 {
        println("FAIL matrix cols");
        process_exit(1);
    }
    if matrix_is_square(z) {
        println("FAIL matrix square zeros");
        process_exit(1);
    }
    let id: Matrix = matrix_identity(2);
    let ir: Int = matrix_rows(id);
    let ic: Int = matrix_cols(id);
    if ir != 2 {
        println("FAIL matrix ident rows");
        process_exit(1);
    }
    if ic != 2 {
        println("FAIL matrix ident cols");
        process_exit(1);
    }
    if !matrix_is_square(id) {
        println("FAIL matrix square id");
        process_exit(1);
    }
    println("prod_matrix: PASSED");
}
