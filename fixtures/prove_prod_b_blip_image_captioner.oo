// # Product prove std/ai_multimodal/blip_image_captioner.oo
//
// Logline: Fail-closed emit+gcc+run asserts blip_image_captioner_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/blip_image_captioner.oo.
//
// Beats:
//   1. Call blip_image_captioner_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_blip_image_captioner: PASSED only if they match.

import "std/ai_multimodal/blip_image_captioner.oo";

pub fn main() {
    let a = blip_image_captioner_marker();
    let b = blip_image_captioner_marker();
    if a != b {
        println("FAIL blip_image_captioner_marker");
        process_exit(1);
    }
    println("prod_blip_image_captioner: PASSED");
}
