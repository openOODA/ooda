// # Product C emit: parenthesized &T field load uses ->
//
// Logline: Fail-closed emit+gcc+run of (p).x on &Point so C uses -> not .
//
// Setup: Isolated emit-c. &Point is Point*. (p).x must compile as (p)->x.
//
// Beats:
//   1. px(p: &Point) returns (p).x as 7.
//   2. Exit 1 on miss. Print prod_field_ptr: PASSED only if it holds.

type PointFp = struct {
    x: Int
};

pub fn px_fp(p: &PointFp) -> Int {
    return (p).x;
}

pub fn main() {
    let pt: PointFp = PointFp { x: 7 };
    let v: Int = px_fp(&pt);
    if v != 7 {
        println("FAIL field_ptr");
        process_exit(1);
    }
    println("prod_field_ptr: PASSED");
}
