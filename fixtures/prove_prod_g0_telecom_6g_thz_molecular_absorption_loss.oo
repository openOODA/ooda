// # Product prove std/telecom_6g/thz_molecular_absorption_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_calc_water_vapor_density is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_molecular_absorption_loss.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call thz_calc_water_vapor_density twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_thz_molecular_absorption_loss: PASSED only if they match.

import "std/telecom_6g/thz_molecular_absorption_loss.oo";

pub fn main() {
    let g0_a = thz_calc_water_vapor_density(1.0, 1.0);
    let g0_b = thz_calc_water_vapor_density(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL thz_calc_water_vapor_density");
        process_exit(1);
    }
    println("prod_g0_thz_molecular_absorption_loss: PASSED");
}
