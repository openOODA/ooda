// # Product prove std/bio_advanced/crispr_cas9_offtarget.oo
//
// Logline: Fail-closed verification that CRISPR Cas9 Hsu-Zhang off-target scoring is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_cas9_offtarget.oo.
//
// Beats:
//   1. Query position-weighted mismatch penalties using Hsu-Zhang matrix.
//   2. Score perfect match and single mismatch guide/target sequence pairs.
//   3. Assert mismatch count and off-target cutting risk classification.
//   4. Print prod_g4_bio_crispr_offtarget: PASSED and exit 0.

import "std/bio_advanced/crispr_cas9_offtarget.oo";

pub fn main() {
    let w1: Float = crispr_hsu_weight(1);
    let w6: Float = crispr_hsu_weight(6);
    let w14: Float = crispr_hsu_weight(14);

    if w1 != 0.0 || w6 != 0.395 || w14 != 0.851 {
        println("FAIL crispr_hsu_weight");
        process_exit(1);
    }

    let guide: String = "GCCAATTCGAACGTTCGAAG";
    let target_exact: String = "GCCAATTCGAACGTTCGAAG";
    let m_exact: OffTargetMatch = crispr_score_offtarget(guide, target_exact);

    if (m_exact).mismatch_count != 0 || (m_exact).score != 100.0 || !(m_exact).is_cutting_risk {
        println("FAIL crispr_score_offtarget exact");
        process_exit(1);
    }

    let target_diff: String = "GCCAATTCGAACGTTCGAAA";
    let m_diff: OffTargetMatch = crispr_score_offtarget(guide, target_diff);

    if (m_diff).mismatch_count != 1 || (m_diff).seed_mismatches != 1 {
        println("FAIL crispr_score_offtarget mismatch count");
        process_exit(1);
    }

    println("prod_g4_bio_crispr_offtarget: PASSED");
    process_exit(0);
}
