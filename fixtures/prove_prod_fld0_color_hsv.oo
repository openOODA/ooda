// # Product prove std/multimedia/color_hsv.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_hsv_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/color_hsv.oo.
//
// Beats:
//   1. Call color_hsv_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_color_hsv: PASSED only if they match.

import "std/multimedia/color_hsv.oo";

pub fn main() {
    let color_hsv_mark: Int = 0;
    if color_hsv_mark != 0 {
        process_exit(1);
    }
    let color_hsv_a: ColorHsv = color_hsv_new(1.0, 1.0, 1.0);
    let color_hsv_b: ColorHsv = color_hsv_new(1.0, 1.0, 1.0);
    if (color_hsv_a).h != (color_hsv_b).h {
        println("FAIL color_hsv_new");
        process_exit(1);
    }
    println("prod_color_hsv: PASSED");
}
