// # Product prove std/compilers/ast_refactor.oo
//
// Logline: Fail-closed verification that AST refactoring plans, text edits, and workspace transformations are deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/ast_refactor.oo.
//
// Beats:
//   1. Verify refactoring action kind constants.
//   2. Construct TextEdit and WorkspaceEdit structures.
//   3. Build RefactorPlan symbol renaming plan and verify edit totals.
//   4. Print prod_g4_compilers_ast_refactor: PASSED and exit 0.

import "std/compilers/ast_refactor.oo";

pub fn main() {
    let ast_refactor_mark: Int = 0;
    if ast_refactor_mark != 0 {
        process_exit(1);
    }
    let k_rename: Int = refactor_kind_rename();
    let k_extract: Int = refactor_kind_extract_fn();
    let k_inline: Int = refactor_kind_inline_var();
    let k_format: Int = refactor_kind_format();
    if k_rename != 1 || k_extract != 2 || k_inline != 3 || k_format != 5 {
        println("FAIL refactor_kind constants");
        process_exit(1);
    }

    let r1: LspRange = lsp_range_new(10, 4, 10, 12);
    let te1: TextEdit = text_edit_new(r1, "renamed_var");
    let te2: TextEdit = text_edit_new(r1, "renamed_var");
    let t1: String = (te1).new_text;
    let t2: String = (te2).new_text;
    if t1 != t2 || (te1).range.start_line != 10 {
        println("FAIL text_edit_new");
        process_exit(1);
    }

    let mut we: WorkspaceEdit = workspace_edit_new("file:///workspace/main.oo");
    we = workspace_edit_add(we, te1);
    if (we).edit_count != 1 {
        println("FAIL workspace_edit_add");
        process_exit(1);
    }

    let mut occ: List[LspRange] = list_new();
    occ = list_push(occ, r1);
    let r2: LspRange = lsp_range_new(15, 8, 15, 16);
    occ = list_push(occ, r2);

    let plan1: RefactorPlan = refactor_plan_rename_symbol("file:///workspace/main.oo", occ, "new_symbol");
    let plan2: RefactorPlan = refactor_plan_rename_symbol("file:///workspace/main.oo", occ, "new_symbol");
    if (plan1).action_kind != (plan2).action_kind || (plan1).total_edits != (plan2).total_edits {
        println("FAIL refactor_plan_rename_symbol deterministic");
        process_exit(1);
    }

    if (plan1).action_kind != 1 || (plan1).total_edits != 2 {
        println("FAIL refactor_plan totals");
        process_exit(1);
    }

    println("prod_g4_compilers_ast_refactor: PASSED");
    process_exit(0);
}
