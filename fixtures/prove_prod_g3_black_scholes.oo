// # Product prove std/fintech/black_scholes.oo
//
// Logline: Fail-closed emit+gcc+run asserts norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/black_scholes.oo.
//
// Beats:
//   1. Call norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_black_scholes: PASSED only if they match.

import "std/fintech/black_scholes.oo";

pub fn main() {
    let black_scholes_mark: Int = 0;
    if black_scholes_mark != 0 {
        process_exit(1);
    }
    let a: Float = norm_pdf(0.0);
    let b: Float = norm_pdf(0.0);
    if a != b {
        println("FAIL norm_pdf");
        process_exit(1);
    }
    println("prod_black_scholes: PASSED");
}
