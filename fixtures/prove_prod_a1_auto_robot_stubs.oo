// # Product prove std/auto_robot/auto_robot_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts auto_robot_hardware_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/auto_robot_stubs.oo.
//
// Beats:
//   1. Call auto_robot_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auto_robot_stubs: PASSED only if they match.

import "std/auto_robot/auto_robot_stubs.oo";

pub fn main() {
    let auto_robot_stubs_mark: Int = 0;
    if auto_robot_stubs_mark != 0 {
        process_exit(1);
    }
    let a: AutoRobotHardwareConfig = auto_robot_hardware_config_new("x", 0);
    let b: AutoRobotHardwareConfig = auto_robot_hardware_config_new("x", 0);
    if (a).bus_id != (b).bus_id {
        println("FAIL auto_robot_hardware_config_new");
        process_exit(1);
    }
    println("prod_auto_robot_stubs: PASSED");
}
