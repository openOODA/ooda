// # Product prove std/net_telemetry/ids_signatures.oo
//
// Logline: Fail-closed emit+gcc+run asserts ids_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/ids_signatures.oo.
//
// Beats:
//   1. Call ids_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ids_signatures: PASSED only if they match.

import "std/net_telemetry/ids_signatures.oo";

pub fn main() {
    let ids_signatures_mark: Int = 0;
    if ids_signatures_mark != 0 {
        process_exit(1);
    }
    let ids_signatures_a = ids_engine_new("x");
    let ids_signatures_b = ids_engine_new("x");
    if (ids_signatures_a).total_scanned != (ids_signatures_b).total_scanned {
        println("FAIL ids_engine_new");
        process_exit(1);
    }
    println("prod_ids_signatures: PASSED");
}
