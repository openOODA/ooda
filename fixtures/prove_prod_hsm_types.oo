// # Product prove std/sec/crypto/hsm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts hsm_handle_id is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_types.oo.
//
// Beats:
//   1. Call hsm_handle_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hsm_types: PASSED only if they match.

import "std/sec/crypto/hsm_types.oo";

pub fn main() {
    let obj = hsm_handle_new(0, 0, 0);
    let a = hsm_handle_id(obj);
    let b = hsm_handle_id(obj);
    if a != b {
        println("FAIL hsm_handle_id");
        process_exit(1);
    }
    println("prod_hsm_types: PASSED");
}
