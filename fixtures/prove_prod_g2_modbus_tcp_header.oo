// # Product prove std/iot_scada/modbus_tcp_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_tcp_mbap_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/modbus_tcp_header.oo.
//
// Beats:
//   1. Call modbus_tcp_mbap_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_modbus_tcp_header: PASSED only if they match.

import "std/iot_scada/modbus_tcp_header.oo";

pub fn main() {
    let modbus_tcp_header_mark: Int = 0;
    if modbus_tcp_header_mark != 0 {
        process_exit(1);
    }
    let a: ModbusTcpMbap = modbus_tcp_mbap_new(0, 0, 0);
    let b: ModbusTcpMbap = modbus_tcp_mbap_new(0, 0, 0);
    if (a).transaction_id != (b).transaction_id {
        println("FAIL modbus_tcp_mbap_new");
        process_exit(1);
    }
    println("prod_g2_modbus_tcp_header: PASSED");
}
