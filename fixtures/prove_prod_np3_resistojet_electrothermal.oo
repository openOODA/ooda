// # Product prove std/space_propulsion/resistojet_electrothermal.oo
//
// Logline: Fail-closed emit+gcc+run asserts resistojet_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/resistojet_electrothermal.oo.
//
// Beats:
//   1. Call resistojet_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_resistojet_electrothermal: PASSED only if they match.

import "std/space_propulsion/resistojet_electrothermal.oo";

pub fn main() {
    let resistojet_electrothermal_mark: Int = 0;
    if resistojet_electrothermal_mark != 0 {
        process_exit(1);
    }
    let resistojet_electrothermal_a = resistojet_compute_performance(resistojet_spec_default_ammonia());
    let resistojet_electrothermal_b = resistojet_compute_performance(resistojet_spec_default_ammonia());
    if (resistojet_electrothermal_a).stagnation_temp_k != (resistojet_electrothermal_b).stagnation_temp_k {
        println("FAIL resistojet_compute_performance");
        process_exit(1);
    }
    println("prod_resistojet_electrothermal: PASSED");
}
