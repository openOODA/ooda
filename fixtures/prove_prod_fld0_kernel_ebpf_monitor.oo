// # Product prove std/security_defense/kernel_ebpf_monitor.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebpf_monitor_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/kernel_ebpf_monitor.oo.
//
// Beats:
//   1. Call ebpf_monitor_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_ebpf_monitor: PASSED only if they match.

import "std/security_defense/kernel_ebpf_monitor.oo";

pub fn main() {
    let kernel_ebpf_monitor_mark: Int = 0;
    if kernel_ebpf_monitor_mark != 0 {
        process_exit(1);
    }
    let kernel_ebpf_monitor_a: EbpfMonitorConfig = ebpf_monitor_config_default();
    let kernel_ebpf_monitor_b: EbpfMonitorConfig = ebpf_monitor_config_default();
    if (kernel_ebpf_monitor_a).monitor_exec != (kernel_ebpf_monitor_b).monitor_exec {
        println("FAIL ebpf_monitor_config_default");
        process_exit(1);
    }
    println("prod_kernel_ebpf_monitor: PASSED");
}
