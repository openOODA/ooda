// # Product prove std/astrodynamics/rcs_thruster_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/rcs_thruster_allocator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/rcs_thruster_allocator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rcs_thruster_allocator: PASSED only if they match.

import "std/astrodynamics/rcs_thruster_allocator.oo";

pub fn main() {
    let rcs_thruster_allocator_a = rcs_thrusters();
    let rcs_thruster_allocator_b = rcs_thrusters();
    if rcs_thruster_allocator_a != rcs_thruster_allocator_b {
        println("FAIL rcs_thruster_allocator");
        process_exit(1);
    }
    println("prod_ap_rcs_thruster_allocator: PASSED");
}
