// # OPEN-66 wasm source fixture
//
// Logline: Adds two ints and prints the sum so emit-wasm has two user functions.
//
// Setup: No imports. Two top-level functions.
//
// Beats:
//   1. add returns a + b.
//   2. main prints add(2, 3).
//   3. emit-wasm must plant two code bodies.
//
// residual: wasm bodies are dummy end; names add/main must appear in the module.

pub fn add(a: Int, b: Int) -> Int {
    return a + b;
}

pub fn main() {
    println(add(2, 3));
}
