// # Product cloud_k8s OR-Set prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/crdt_or_set.oo.
//
// Setup: Product std/cloud_k8s/crdt_or_set.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty does not contain 5. After add(5,1) contains 5.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/crdt_or_set.oo";

pub fn main() {
    let s0: OrSet = or_set_new();
    let m: Int = or_set_contains(s0, 5);
    if m != 0 {
        println("FAIL orset empty");
        process_exit(1);
    }
    let s1: OrSet = or_set_add(s0, 5, 1);
    let h: Int = or_set_contains(s1, 5);
    if h != 1 {
        println("FAIL orset hit");
        process_exit(1);
    }
    println("prod_orsetc: PASSED");
}
