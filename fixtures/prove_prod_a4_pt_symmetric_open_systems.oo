// # Product prove std/quantum_open_systems/pt_symmetric_open_systems.oo
//
// Logline: Fail-closed emit+gcc+run asserts pt_symmetric_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/pt_symmetric_open_systems.oo.
//
// Beats:
//   1. Call pt_symmetric_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pt_symmetric_open_systems: PASSED only if they match.

import "std/quantum_open_systems/pt_symmetric_open_systems.oo";

pub fn main() {
    let pt_symmetric_open_systems_mark: Int = 0;
    if pt_symmetric_open_systems_mark != 0 {
        process_exit(1);
    }
    let a: PtSymmetricParams = pt_symmetric_params_new(0.0, 0.0, 0.0);
    let b: PtSymmetricParams = pt_symmetric_params_new(0.0, 0.0, 0.0);
    if (a).center_freq_omega0 != (b).center_freq_omega0 {
        println("FAIL pt_symmetric_params_new");
        process_exit(1);
    }
    println("prod_pt_symmetric_open_systems: PASSED");
}
