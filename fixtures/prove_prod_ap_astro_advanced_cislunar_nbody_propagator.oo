// # Product prove std/astro_advanced/cislunar_nbody_propagator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/cislunar_nbody_propagator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/cislunar_nbody_propagator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cislunar_nbody_propagator: PASSED only if they match.

import "std/astro_advanced/cislunar_nbody_propagator.oo";

pub fn main() {
    let cislunar_nbody_propagator_a = nbody_bodies();
    let cislunar_nbody_propagator_b = nbody_bodies();
    if cislunar_nbody_propagator_a != cislunar_nbody_propagator_b {
        println("FAIL cislunar_nbody_propagator");
        process_exit(1);
    }
    println("prod_ap_cislunar_nbody_propagator: PASSED");
}
