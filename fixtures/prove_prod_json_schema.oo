// # Product prove std/markup/json_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_schema_validate is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_schema.oo.
//
// Beats:
//   1. Call json_schema_validate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json_schema: PASSED only if they match.

import "std/markup/json_schema.oo";

pub fn main() {
    let a = json_schema_validate("x", "x");
    let b = json_schema_validate("x", "x");
    if a != b {
        println("FAIL json_schema_validate");
        process_exit(1);
    }
    println("prod_json_schema: PASSED");
}
