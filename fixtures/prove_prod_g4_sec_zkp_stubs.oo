// # Product prove std/crypto/zkp_stubs.oo
//
// Logline: Fail-closed verification that ZKP Schnorr, Pedersen, Range, and batch proofs are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_stubs.oo.
//
// Beats:
//   1. Run Schnorr proving and verification.
//   2. Run Pedersen homomorphic addition and range proofs.
//   3. Assert batch proof verification returns deterministic success.
//   4. Print prod_g4_sec_zkp_stubs: PASSED and exit 0.

import "std/crypto/zkp_stubs.oo";

pub fn main() {
    let v_modulus: Int = 1009;
    let v_generator: Int = 11;
    let v_sec_gen: Int = 17;
    let v_secret: Int = 42;
    let v_blinding: Int = 123;

    let v_pub_key: Int = zkp_mod_pow(v_generator, v_secret, v_modulus);
    let v_schnorr: SchnorrProof = schnorr_prove(v_secret, v_pub_key, v_generator, v_blinding, v_modulus);
    let schnorr_ok: Bool = schnorr_verify(v_schnorr);
    if !schnorr_ok {
        println("FAIL schnorr_verify");
        process_exit(1);
    }

    let v_comm1: PedersenCommitment = pedersen_commitment_create(v_generator, v_sec_gen, 10, 5, v_modulus);
    let v_comm2: PedersenCommitment = pedersen_commitment_create(v_generator, v_sec_gen, 20, 7, v_modulus);
    let v_comm_sum1: PedersenCommitment = pedersen_commitment_homomorphic_add(v_comm1, v_comm2);
    let v_comm_sum2: PedersenCommitment = pedersen_commitment_homomorphic_add(v_comm1, v_comm2);

    if (v_comm_sum1).commitment != (v_comm_sum2).commitment || (v_comm_sum1).commitment <= 0 {
        println("FAIL pedersen_commitment_homomorphic_add");
        process_exit(1);
    }

    let v_range_p: RangeProof = zkp_range_prove(15, 0, 100, 99, v_generator, v_sec_gen, v_modulus);
    let range_ok: Bool = zkp_range_verify(v_range_p, v_generator, v_sec_gen, v_modulus);
    if !range_ok {
        println("FAIL zkp_range_verify");
        process_exit(1);
    }

    let mut v_prover: ZkpProver = zkp_prover_init("P1", 1, 128, v_modulus, v_generator, v_sec_gen);
    let mut v_verifier: ZkpVerifier = zkp_verifier_init("V1", 1, 128, v_modulus, v_generator, v_sec_gen);

    let v_stmt: ZkpStatement = zkp_statement_create("S1", "params", v_pub_key, v_modulus, 1);
    let v_wit: ZkpWitness = zkp_witness_create("W1", v_secret, v_blinding, 1);

    let v_main_proof: ZkpProof = zkp_prover_create_proof(&mut v_prover, v_stmt, v_wit);
    let v_verified: Bool = zkp_verifier_verify_proof(&mut v_verifier, v_main_proof, v_stmt);
    if !v_verified {
        println("FAIL zkp_verifier_verify_proof");
        process_exit(1);
    }

    let mut v_batch: ZkpBatchVerifier = zkp_batch_verifier_init("B1");
    zkp_batch_verifier_add(&mut v_batch, v_main_proof, v_stmt);
    let v_batch_ok: Bool = zkp_batch_verifier_verify_all(&mut v_verifier, &mut v_batch);
    if !v_batch_ok {
        println("FAIL zkp_batch_verifier_verify_all");
        process_exit(1);
    }

    println("prod_g4_sec_zkp_stubs: PASSED");
    process_exit(0);
}
