// # Product prove std/text/regex_match.oo
//
// Logline: Fail-closed emit+gcc+run asserts match_count_occurrences value or determinism.
//
// Setup: Isolated emit-c. Imports std/text/regex_match.oo.
//
// Beats:
//   1. Call match_count_occurrences twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_regex_match: PASSED only if asserts hold.

import "std/text/regex_match.oo";

pub fn main() {
    let regex_match_a: Int = match_count_occurrences("abcabc", "bc");
    let regex_match_b: Int = match_count_occurrences("abcabc", "bc");
    if regex_match_a != 2 {
        println("FAIL match_count_occurrences");
        process_exit(1);
    }
    if regex_match_a != regex_match_b {
        println("FAIL match_count_occurrences det");
        process_exit(1);
    }
    println("prod_regex_match: PASSED");
}
