// # Product sync semaphore prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/semaphore.oo.
//
// Setup: Product std/sync/semaphore.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(3,5) available 3. new(9,5) clamps 5. new(-1,5) is 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/semaphore.oo";

pub fn main() {
    let s: Semaphore = semaphore_new(3, 5);
    let a: Int = semaphore_available(s);
    if a != 3 {
        println("FAIL sem 3");
        process_exit(1);
    }
    let s2: Semaphore = semaphore_new(9, 5);
    let a2: Int = semaphore_available(s2);
    if a2 != 5 {
        println("FAIL sem clamp max");
        process_exit(1);
    }
    let s3: Semaphore = semaphore_new(-1, 5);
    let a3: Int = semaphore_available(s3);
    if a3 != 0 {
        println("FAIL sem clamp 0");
        process_exit(1);
    }
    if semaphore_is_empty(s) {
        println("FAIL sem empty");
        process_exit(1);
    }
    println("prod_semavail: PASSED");
}
