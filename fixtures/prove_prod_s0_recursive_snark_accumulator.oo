// # Product prove std/zk_rollup/recursive_snark_accumulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts nova_fold_witness_slot value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/recursive_snark_accumulator.oo.
//
// Beats:
//   1. Call nova_fold_witness_slot twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_recursive_snark_accumulator: PASSED only if asserts hold.

import "std/zk_rollup/recursive_snark_accumulator.oo";

pub fn main() {
    let recursive_snark_accumulator_a: Int = nova_fold_witness_slot(0, 0, 0, 1);
    let recursive_snark_accumulator_b: Int = nova_fold_witness_slot(0, 0, 0, 1);
    if recursive_snark_accumulator_a != recursive_snark_accumulator_b {
        println("FAIL nova_fold_witness_slot");
        process_exit(1);
    }
    println("prod_recursive_snark_accumulator: PASSED");
}
