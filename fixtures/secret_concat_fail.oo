// # Refuse a concatenated secret
//
// Logline: Concatenating a tagged name onto a literal taints the later println.
//
// Beats:
//   1. Tag x at line start.
//   2. Bind y to x plus a suffix.
//   3. Print y so the sink refuses.

// M113: concat propagates Secret
// SECRET: x
pub fn main() {
    let x = "token";
    let y = x + "!";
    println(y);
}
