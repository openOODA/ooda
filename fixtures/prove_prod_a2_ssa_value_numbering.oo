// # Product prove std/compilers_vm/ssa_value_numbering.oo
//
// Logline: Fail-closed emit+gcc+run asserts gvn_expr_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_value_numbering.oo.
//
// Beats:
//   1. Call gvn_expr_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ssa_value_numbering: PASSED only if they match.

import "std/compilers_vm/ssa_value_numbering.oo";

pub fn main() {
    let ssa_value_numbering_mark: Int = 0;
    if ssa_value_numbering_mark != 0 {
        process_exit(1);
    }
    let a: GvnExpression = gvn_expr_new(0, 0, 0, 0);
    let b: GvnExpression = gvn_expr_new(0, 0, 0, 0);
    if (a).opcode != (b).opcode {
        println("FAIL gvn_expr_new");
        process_exit(1);
    }
    println("prod_ssa_value_numbering: PASSED");
}
