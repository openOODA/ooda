// # Product prove std/iot_scada/opcua_monitored_item.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_monitored_item_new real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_monitored_item.oo.
//
// Beats:
//   1. Call opcua_monitored_item_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_opcua_monitored_item: PASSED only if the assert holds.

import "std/iot_scada/opcua_monitored_item.oo";

pub fn main() {
    let opcua_monitored_item_a: OpcUaMonitoredItem = opcua_monitored_item_new(7, 7, 7, 2.0);
    let opcua_monitored_item_item_id: Int = (opcua_monitored_item_a).item_id;
    if opcua_monitored_item_item_id != 7 {
        println("FAIL opcua_monitored_item_new");
        process_exit(1);
    }
    println("prod_opcua_monitored_item: PASSED");
}
