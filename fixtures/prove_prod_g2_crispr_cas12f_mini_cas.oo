// # Product prove std/crispr_cas/crispr_cas12f_mini_cas.oo
//
// Logline: Fail-closed emit+gcc+run asserts cas12f_is_tttr is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_cas12f_mini_cas.oo.
//
// Beats:
//   1. Call cas12f_is_tttr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_cas12f_mini_cas: PASSED only if they match.

import "std/crispr_cas/crispr_cas12f_mini_cas.oo";

pub fn main() {
    let crispr_cas12f_mini_cas_mark: Int = 0;
    if crispr_cas12f_mini_cas_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cas12f_is_tttr("x");
    let b: Bool = cas12f_is_tttr("x");
    if a != b {
        println("FAIL cas12f_is_tttr");
        process_exit(1);
    }
    println("prod_g2_crispr_cas12f_mini_cas: PASSED");
}
