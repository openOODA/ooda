// # Product prove std/security_defense/security_defense_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts mock_is_security_test_suite_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/security_defense_stubs.oo.
//
// Beats:
//   1. Call mock_is_security_test_suite_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_security_defense_stubs: PASSED only if they match.

import "std/security_defense/security_defense_stubs.oo";

pub fn main() {
    let security_defense_stubs_mark: Int = 0;
    if security_defense_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = mock_is_security_test_suite_ready();
    let b: Bool = mock_is_security_test_suite_ready();
    if a != b {
        println("FAIL mock_is_security_test_suite_ready");
        process_exit(1);
    }
    println("prod_security_defense_stubs: PASSED");
}
