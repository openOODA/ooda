// # Product prove std/telecom_5g/dsp_hilbert_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_hilbert_tap_coeff is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_hilbert_transform.oo.
//
// Beats:
//   1. Call dsp_hilbert_tap_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_hilbert_transform: PASSED only if they match.

import "std/telecom_5g/dsp_hilbert_transform.oo";

pub fn main() {
    let dsp_hilbert_transform_mark: Int = 0;
    if dsp_hilbert_transform_mark != 0 {
        process_exit(1);
    }
    let a: Float = dsp_hilbert_tap_coeff(0, 0);
    let b: Float = dsp_hilbert_tap_coeff(0, 0);
    if a != b {
        println("FAIL dsp_hilbert_tap_coeff");
        process_exit(1);
    }
    println("prod_dsp_hilbert_transform: PASSED");
}
