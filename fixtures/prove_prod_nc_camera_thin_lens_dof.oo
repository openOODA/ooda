// # Product prove std/pbr_raytracing/camera_thin_lens_dof.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_thin_lens_dof_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/camera_thin_lens_dof.oo.
//
// Beats:
//   1. Call camera_thin_lens_dof_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_camera_thin_lens_dof: PASSED only if it matches.

import "std/pbr_raytracing/camera_thin_lens_dof.oo";

pub fn main() {
    let a: Int = camera_thin_lens_dof_probe();
    if a != 0 {
        println("FAIL camera_thin_lens_dof_probe");
        process_exit(1);
    }
    println("prod_nc_camera_thin_lens_dof: PASSED");
}
