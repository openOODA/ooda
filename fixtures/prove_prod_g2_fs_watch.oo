// # Product prove std/fs/watch.oo
//
// Logline: Fail-closed emit+gcc+run asserts watch_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/fs/watch.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call watch_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_watch: PASSED only if they match.

import "std/fs/watch.oo";

pub fn main() {
    let g2_a = watch_probe();
    let g2_b = watch_probe();
    if g2_a != g2_b {
        println("FAIL watch_probe");
        process_exit(1);
    }
    println("prod_g2_watch: PASSED");
}
