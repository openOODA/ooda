// # Refuse secret process_exec payload
//
// Logline: Pass a secret IDENT into process_exec so the sink must refuse the call.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Hand token to process_exec as the command payload.
//   3. Print 1 after the call.
//
// Secret must not reach process_exec payload
// SECRET: token
pub fn main(p: &ProcessCap) {
    let token = "s3cret-payload";
    let r = process_exec(p, token);
    println(1);
}
