// # Product prove std/fintech_defi/hft_cross_venue_arbitrage.oo
//
// Logline: Fail-closed emit+gcc+run asserts venue_quote_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_cross_venue_arbitrage.oo.
//
// Beats:
//   1. Call venue_quote_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hft_cross_venue_arbitrage: PASSED only if they match.

import "std/fintech_defi/hft_cross_venue_arbitrage.oo";

pub fn main() {
    let hft_cross_venue_arbitrage_mark: Int = 0;
    if hft_cross_venue_arbitrage_mark != 0 {
        process_exit(1);
    }
    let a: VenueQuote = venue_quote_new("x", 0, 0, 0, 0, 0, 0);
    let b: VenueQuote = venue_quote_new("x", 0, 0, 0, 0, 0, 0);
    if (a).bid_price != (b).bid_price {
        println("FAIL venue_quote_new");
        process_exit(1);
    }
    println("prod_g2_hft_cross_venue_arbitrage: PASSED");
}
