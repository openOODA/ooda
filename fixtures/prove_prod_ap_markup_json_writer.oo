// # Product prove std/markup/json_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/json_writer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_writer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_json_writer: PASSED only if they match.

import "std/markup/json_writer.oo";

pub fn main() {
    let json_writer_a = json_escape_str("x");
    let json_writer_b = json_escape_str("x");
    if json_writer_a.contains(json_writer_b) == false {
        println("FAIL json_writer");
        process_exit(1);
    }
    if json_writer_b.contains(json_writer_a) == false {
        println("FAIL json_writer");
        process_exit(1);
    }
    println("prod_ap_json_writer: PASSED");
}
