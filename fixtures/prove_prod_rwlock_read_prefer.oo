// # Product prove std/sync/rwlock_read_prefer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rwlock_read_prefer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/rwlock_read_prefer.oo.
//
// Beats:
//   1. Call rwlock_read_prefer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rwlock_read_prefer: PASSED only if they match.

import "std/sync/rwlock_read_prefer.oo";

pub fn main() {
    let obj = rwlock_read_prefer_new();
    let a = obj.reader_count;
    let b = obj.reader_count;
    if a != b {
        println("FAIL rwlock_read_prefer_new");
        process_exit(1);
    }
    println("prod_rwlock_read_prefer: PASSED");
}
