// # Product prove std/fintech_defi/yield_curve_bootstrapping.oo
//
// Logline: Fail-closed emit+gcc+run asserts zero_curve_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/yield_curve_bootstrapping.oo.
//
// Beats:
//   1. Call zero_curve_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_curve_bootstrapping: PASSED only if they match.

import "std/fintech_defi/yield_curve_bootstrapping.oo";

pub fn main() {
    let a: BootstrappedZeroCurve = zero_curve_new("x");
    let b: BootstrappedZeroCurve = zero_curve_new("x");
    if chars_len(a.curve_name) != chars_len(b.curve_name) {
        println("FAIL zero_curve_new");
        process_exit(1);
    }
    println("prod_yield_curve_bootstrapping: PASSED");
}
