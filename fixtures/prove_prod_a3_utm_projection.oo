// # Product prove std/gis_spatial/utm_projection.oo
//
// Logline: Fail-closed emit+gcc+run asserts utm_calc_zone is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/utm_projection.oo.
//
// Beats:
//   1. Call utm_calc_zone twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_utm_projection: PASSED only if they match.

import "std/gis_spatial/utm_projection.oo";

pub fn main() {
    let utm_projection_mark: Int = 0;
    if utm_projection_mark != 0 {
        process_exit(1);
    }
    let a: Int = utm_calc_zone(0.0);
    let b: Int = utm_calc_zone(0.0);
    if a != b {
        println("FAIL utm_calc_zone");
        process_exit(1);
    }
    println("prod_utm_projection: PASSED");
}
