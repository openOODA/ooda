// # Product min_max_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped min_max_heap_push/size.
//
// Setup: Product std/collections/min_max_heap.oo. Two pushes.
//
// Beats:
//   1. After two pushes, size is 2.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/min_max_heap.oo";

pub fn main() {
    let mut h: MinMaxHeap = min_max_heap_new();
    h = min_max_heap_push(h, 3);
    h = min_max_heap_push(h, 7);
    let n: Int = h.size;
    if n != 2 {
        println("FAIL minmax size");
        process_exit(1);
    }
    println("prod_minmax: PASSED");
}
