// # Product prove std/multimedia/png_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_magic_byte is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_header.oo.
//
// Beats:
//   1. Call png_magic_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_png_header: PASSED only if they match.

import "std/multimedia/png_header.oo";

pub fn main() {
    let png_header_mark: Int = 0;
    if png_header_mark != 0 {
        process_exit(1);
    }
    let png_header_a: Int = png_magic_byte(1);
    let png_header_b: Int = png_magic_byte(1);
    if png_header_a != png_header_b {
        println("FAIL png_magic_byte");
        process_exit(1);
    }
    println("prod_png_header: PASSED");
}
