// # Product prove std/crypto_advanced/groth16_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts groth16 proof generation is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/groth16_proof.oo.
//
// Beats:
//   1. Construct proving key, empty proof, and witness assignments.
//   2. Run groth16_prove twice with identical parameters.
//   3. Assert proof components and validity match deterministically.
//   4. Print prod_g4_crypto_groth16_proof: PASSED and exit 0.

import "std/crypto_advanced/groth16_proof.oo";

pub fn main() {
    let g1_gen: Bn254G1Affine = bn254_g1_generator(1009);
    let g2_gen: Bn254G2Affine = bn254_g2_generator(1009);

    let empty_prf: Groth16Proof = groth16_proof_empty(1009);
    if (empty_prf).is_valid {
        println("FAIL groth16_proof_empty should be invalid");
        process_exit(1);
    }

    let mut pub_in: List[Int] = list_new();
    pub_in = list_push(pub_in, 5);
    pub_in = list_push(pub_in, 10);

    let mut priv_wit: List[Int] = list_new();
    priv_wit = list_push(priv_wit, 7);

    let wit: Groth16Witness = groth16_witness_new(pub_in, priv_wit);
    if (wit).total_vars != 3 {
        println("FAIL groth16_witness_new total_vars");
        process_exit(1);
    }

    let pk: Groth16ProvingKey = groth16_proving_key_new(g1_gen, g1_gen, g2_gen, g1_gen, g2_gen);
    if !(pk).is_ready {
        println("FAIL groth16_proving_key_new is_ready");
        process_exit(1);
    }

    let p1: Groth16Proof = groth16_prove(pk, wit, 3, 5, "proof_01");
    let p2: Groth16Proof = groth16_prove(pk, wit, 3, 5, "proof_01");

    if (p1).is_valid != (p2).is_valid || !(p1).is_valid {
        println("FAIL groth16_prove is_valid mismatch");
        process_exit(1);
    }
    if chars_len((p1).proof_id) != chars_len((p2).proof_id) || chars_len((p1).proof_id) == 0 {
        println("FAIL groth16_prove proof_id mismatch");
        process_exit(1);
    }

    println("prod_g4_crypto_groth16_proof: PASSED");
    process_exit(0);
}
