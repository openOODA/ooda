// # Product prove std/crypto/zkp_batch.oo
//
// Logline: Fail-closed verification that ZKP batch proof aggregation and verification are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_batch.oo.
//
// Beats:
//   1. Construct statement, witness, and create zero-knowledge proof.
//   2. Initialize ZkpBatchVerifier, add proof, and execute batch verification.
//   3. Assert proof string serialization and workload metrics.
//   4. Print prod_g4_sec_zkp_batch: PASSED and exit 0.

import "std/crypto/zkp_batch.oo";

pub fn main() {
    let mut prover: ZkpProver = zkp_prover_init("P_batch", 1, 128, 1009, 11, 17);
    let mut verifier: ZkpVerifier = zkp_verifier_init("V_batch", 1, 128, 1009, 11, 17);

    let pub_key: Int = zkp_mod_pow(11, 42, 1009);
    let stmt: ZkpStatement = zkp_statement_create("S_batch", "params", pub_key, 1009, 1);
    let wit: ZkpWitness = zkp_witness_create("W_batch", 42, 123, 1);

    let proof: ZkpProof = zkp_prover_create_proof(&mut prover, stmt, wit);
    let p_str: String = zkp_proof_to_string(proof);

    if chars_len(p_str) <= 0 {
        println("FAIL zkp_proof_to_string");
        process_exit(1);
    }

    let mut batch: ZkpBatchVerifier = zkp_batch_verifier_init("B_main");
    zkp_batch_verifier_add(&mut batch, proof, stmt);

    let batch_ok: Bool = zkp_batch_verifier_verify_all(&mut verifier, &mut batch);
    if !batch_ok {
        println("FAIL zkp_batch_verifier_verify_all");
        process_exit(1);
    }

    let work: Int = zkp_do_work(&prover, &verifier);
    if work != 2 {
        println("FAIL zkp_do_work count");
        process_exit(1);
    }

    println("prod_g4_sec_zkp_batch: PASSED");
    process_exit(0);
}
