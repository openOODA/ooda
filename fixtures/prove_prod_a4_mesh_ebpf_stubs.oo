// # Product prove std/mesh_ebpf/mesh_ebpf_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_ebpf_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_ebpf_stubs.oo.
//
// Beats:
//   1. Call mesh_ebpf_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_ebpf_stubs: PASSED only if they match.

import "std/mesh_ebpf/mesh_ebpf_stubs.oo";

pub fn main() {
    let mesh_ebpf_stubs_mark: Int = 0;
    if mesh_ebpf_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = mesh_ebpf_fail_closed("x", 0);
    let b: Bool = mesh_ebpf_fail_closed("x", 0);
    if a != b {
        println("FAIL mesh_ebpf_fail_closed");
        process_exit(1);
    }
    println("prod_mesh_ebpf_stubs: PASSED");
}
