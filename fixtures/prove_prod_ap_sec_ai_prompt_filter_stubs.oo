// # Product prove std/sec/ai/prompt_filter_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/ai/prompt_filter_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/ai/prompt_filter_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_prompt_filter_stubs: PASSED only if they match.

import "std/sec/ai/prompt_filter_stubs.oo";

pub fn main() {
    let prompt_filter_stubs_a = prompt_redact_pii("x");
    let prompt_filter_stubs_b = prompt_redact_pii("x");
    if prompt_filter_stubs_a.contains(prompt_filter_stubs_b) == false {
        println("FAIL prompt_filter_stubs");
        process_exit(1);
    }
    if prompt_filter_stubs_b.contains(prompt_filter_stubs_a) == false {
        println("FAIL prompt_filter_stubs");
        process_exit(1);
    }
    println("prod_ap_prompt_filter_stubs: PASSED");
}
