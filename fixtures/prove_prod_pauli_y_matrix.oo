// # Product prove std/quantum/gate_pauli.oo
//
// Logline: Fail-closed emit+gcc+run asserts pauli_y_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_pauli.oo.
//
// Beats:
//   1. Call pauli_y_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pauli_y_matrix: PASSED only if they match.

import "std/quantum/gate_pauli.oo";

pub fn main() {
    let gate_pauli_mark: Int = 0;
    if gate_pauli_mark != 0 { process_exit(1); }
    let a: Matrix2x2 = pauli_y_matrix();
    let b: Matrix2x2 = pauli_y_matrix();
    let am: Complex = (a).m00;
    let bm: Complex = (b).m00;
    let ar: Float = (am).real;
    let br: Float = (bm).real;
    if ar != br {
        println("FAIL pauli_y_matrix");
        process_exit(1);
    }
    println("prod_pauli_y_matrix: PASSED");
}
