// # Product prove std/satellite_dvb/gnss_glonass_ofdm_fdma.oo
//
// Logline: Fail-closed emit+gcc+run asserts glonass_meander_encode is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_glonass_ofdm_fdma.oo.
//
// Beats:
//   1. Call glonass_meander_encode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_glonass_ofdm_fdma: PASSED only if they match.

import "std/satellite_dvb/gnss_glonass_ofdm_fdma.oo";

pub fn main() {
    let gnss_glonass_ofdm_fdma_mark: Int = 0;
    if gnss_glonass_ofdm_fdma_mark != 0 {
        process_exit(1);
    }
    let a: Int = glonass_meander_encode(0, 0);
    let b: Int = glonass_meander_encode(0, 0);
    if a != b {
        println("FAIL glonass_meander_encode");
        process_exit(1);
    }
    println("prod_g2_gnss_glonass_ofdm_fdma: PASSED");
}
