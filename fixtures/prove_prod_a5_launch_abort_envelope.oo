// # Product prove std/space_propulsion/launch_abort_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts launch_abort_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/launch_abort_envelope.oo.
//
// Beats:
//   1. Call launch_abort_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_abort_envelope: PASSED only if they match.

import "std/space_propulsion/launch_abort_envelope.oo";

pub fn main() {
    let launch_abort_envelope_mark: Int = 0;
    if launch_abort_envelope_mark != 0 {
        process_exit(1);
    }
    let a: LaunchAbortSpec = launch_abort_spec_default();
    let b: LaunchAbortSpec = launch_abort_spec_default();
    if (a).capsule_mass_kg != (b).capsule_mass_kg {
        println("FAIL launch_abort_spec_default");
        process_exit(1);
    }
    println("prod_launch_abort_envelope: PASSED");
}
