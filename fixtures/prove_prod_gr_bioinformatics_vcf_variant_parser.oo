// # Product prove std/bioinformatics/vcf_variant_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts vcf_classify_type is a real value.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/vcf_variant_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call vcf_classify_type twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_vcf_variant_parser: PASSED only if they match.

import "std/bioinformatics/vcf_variant_parser.oo";

pub fn main() {
    let g0_a = vcf_classify_type("x", "x");
    let g0_b = vcf_classify_type("x", "x");
    if g0_a != g0_b {
        println("FAIL vcf_classify_type");
        process_exit(1);
    }
    println("prod_gr_vcf_variant_parser: PASSED");
}
