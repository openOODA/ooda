// # Product prove std/astro_advanced/solar_radiation_pressure.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/solar_radiation_pressure.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/solar_radiation_pressure.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_solar_radiation_pressure: PASSED only if they match.

import "std/astro_advanced/solar_radiation_pressure.oo";

pub fn main() {
    let solar_radiation_pressure_a = srp_w_m2();
    let solar_radiation_pressure_b = srp_w_m2();
    if solar_radiation_pressure_a != solar_radiation_pressure_b {
        println("FAIL solar_radiation_pressure");
        process_exit(1);
    }
    println("prod_ap_solar_radiation_pressure: PASSED");
}
