//
// Setup: Isolated emit-c. Imports std/diag/profiler_sampling_stub.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_profiler_sampling_stub: PASSED only if they match.

import "std/diag/profiler_sampling_stub.oo";

pub fn main() {
    let profiler_sampling_stub_a = profiler_sampler_new(0);
    let profiler_sampling_stub_b = profiler_sampler_new(0);
    if profiler_sampling_stub_a.freq_hz != profiler_sampling_stub_b.freq_hz {
        println("FAIL profiler_sampling_stub");
        process_exit(1);
    }
    println("prod_ap_profiler_sampling_stub: PASSED");
