// # Const INT<INT if print
//
// Logline: Print LT from if 1<2 and GE from the else of if 2<1.
//
// Setup: Side emit-aarch64 folds INT LT INT only when LBRACE follows.
//
// Beats:
//   1. if 1 < 2 print LT.
//   2. if 2 < 1 else print GE.
//   3. Expect LT and GE.

pub fn main() {
    if 1 < 2 {
        println("LT");
    }
    if 2 < 1 {
        println("BAD");
    } else {
        println("GE");
    }
}
