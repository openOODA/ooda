// # Product prove std/uav_flight/uav_optical_flow_velocity.oo
//
// Logline: Fail-closed emit+gcc+run asserts optical_flow_params_default is a real value.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_optical_flow_velocity.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call optical_flow_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_uav_optical_flow_velocity: PASSED only if they match.

import "std/uav_flight/uav_optical_flow_velocity.oo";

pub fn main() {
    let g0_oa = optical_flow_params_default();
    let g0_ob = optical_flow_params_default();
    let g0_a = (g0_oa).focal_length_px;
    let g0_b = (g0_ob).focal_length_px;
    if g0_a != g0_b {
        println("FAIL optical_flow_params_default.focal_length_px");
        process_exit(1);
    }
    println("prod_g0_uav_optical_flow_velocity: PASSED");
}
