// # Product prove std/nerf_3dgs/nerf_3dgs_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts nerf_3dgs_capabilities_cuda is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_3dgs_stubs.oo.
//
// Beats:
//   1. Call nerf_3dgs_capabilities_cuda twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nerf_3dgs_stubs: PASSED only if they match.

import "std/nerf_3dgs/nerf_3dgs_stubs.oo";

pub fn main() {
    let nerf_3dgs_stubs_mark: Int = 0;
    if nerf_3dgs_stubs_mark != 0 {
        process_exit(1);
    }
    let nerf_3dgs_stubs_a = nerf_3dgs_capabilities_cuda();
    let nerf_3dgs_stubs_b = nerf_3dgs_capabilities_cuda();
    if (nerf_3dgs_stubs_a).supports_cuda_rasterizer != (nerf_3dgs_stubs_b).supports_cuda_rasterizer {
        println("FAIL nerf_3dgs_capabilities_cuda");
        process_exit(1);
    }
    println("prod_nerf_3dgs_stubs: PASSED");
}
