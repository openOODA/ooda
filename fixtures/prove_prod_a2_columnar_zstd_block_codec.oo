// # Product prove std/db_columnar/columnar_zstd_block_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts zstd_frame_header_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_zstd_block_codec.oo.
//
// Beats:
//   1. Call zstd_frame_header_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_zstd_block_codec: PASSED only if they match.

import "std/db_columnar/columnar_zstd_block_codec.oo";

pub fn main() {
    let columnar_zstd_block_codec_mark: Int = 0;
    if columnar_zstd_block_codec_mark != 0 {
        process_exit(1);
    }
    let a: ZstdFrameHeader = zstd_frame_header_default();
    let b: ZstdFrameHeader = zstd_frame_header_default();
    if (a).magic_number != (b).magic_number {
        println("FAIL zstd_frame_header_default");
        process_exit(1);
    }
    println("prod_columnar_zstd_block_codec: PASSED");
}
