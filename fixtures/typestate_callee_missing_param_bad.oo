// # Missing connect parameter
//
// Logline: connect is declared with no sock parameter so the open never binds.
//
// Beats:
//   1. Declare connect without a Closed parameter.
//   2. Open a Closed sock in main.
//   3. Call parameterless connect.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect() { }

pub fn main() {
    let s = open_sock();
    connect();
}
