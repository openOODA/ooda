// # Product prove std/web_ecosystem/slugify_string.oo
//
// Logline: Fail-closed emit+gcc+run asserts to_char_lower value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/slugify_string.oo.
//
// Beats:
//   1. Call to_char_lower twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_slugify_string: PASSED only if asserts hold.

import "std/web_ecosystem/slugify_string.oo";

pub fn main() {
    let slugify_string_a: String = to_char_lower("x");
    let slugify_string_b: String = to_char_lower("x");
    if chars_len(slugify_string_a) != chars_len(slugify_string_b) {
        println("FAIL to_char_lower");
        process_exit(1);
    }
    println("prod_slugify_string: PASSED");
}
