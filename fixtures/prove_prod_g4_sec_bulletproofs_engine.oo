// # Product prove std/sec/crypto/bulletproofs_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_engine.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_bulletproofs_engine: PASSED and exit 0 only on match.

import "std/sec/crypto/bulletproofs_engine.oo";

pub fn main() {
    let gens_a: BulletproofGenerators = bulletproof_generators_create(4, 1, 11, 17, 1009);
    let gens_b: BulletproofGenerators = bulletproof_generators_create(4, 1, 11, 17, 1009);
    if (gens_a).is_valid != (gens_b).is_valid {
        println("FAIL bulletproofs_engine generators");
        process_exit(1);
    }

    let pcomm_a: PedersenCommitment = pedersen_commitment_create(11, 17, 42, 99, 1009);
    let pcomm_b: PedersenCommitment = pedersen_commitment_create(11, 17, 42, 99, 1009);
    if (pcomm_a).commitment != (pcomm_b).commitment {
        println("FAIL bulletproofs_engine commitment");
        process_exit(1);
    }

    let mut vec_a: List[Int] = list_new();
    let mut vec_b: List[Int] = list_new();
    vec_a = list_push(vec_a, 2);
    vec_a = list_push(vec_a, 3);
    vec_b = list_push(vec_b, 5);
    vec_b = list_push(vec_b, 7);

    let bulletproofs_engine_a: InnerProductProof = inner_product_prove(vec_a, vec_b, gens_a, 1009);
    let bulletproofs_engine_b: InnerProductProof = inner_product_prove(vec_a, vec_b, gens_b, 1009);
    if (bulletproofs_engine_a).a_final != (bulletproofs_engine_b).a_final {
        println("FAIL bulletproofs_engine ipp a_final");
        process_exit(1);
    }
    if (bulletproofs_engine_a).b_final != (bulletproofs_engine_b).b_final {
        println("FAIL bulletproofs_engine ipp b_final");
        process_exit(1);
    }

    let ver_a: Bool = inner_product_verify(bulletproofs_engine_a, (pcomm_a).commitment, gens_a, 1009);
    let ver_b: Bool = inner_product_verify(bulletproofs_engine_b, (pcomm_b).commitment, gens_b, 1009);
    if ver_a != ver_b {
        println("FAIL bulletproofs_engine ipp verify");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs_engine: PASSED");
    process_exit(0);
}
