// # Product prove std/zk_rollup/sparse_merkle_tree_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_batch_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_batch.oo.
//
// Beats:
//   1. Call smt_batch_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_merkle_tree_batch: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_batch.oo";

pub fn main() {
    let sparse_merkle_tree_batch_mark: Int = 0;
    if sparse_merkle_tree_batch_mark != 0 {
        process_exit(1);
    }
    let a: SmtBatchEntry = smt_batch_entry_new("x", "x");
    let b: SmtBatchEntry = smt_batch_entry_new("x", "x");
    let sa: String = (a).key_hex;
    let sb: String = (b).key_hex;
    if sa != sb {
        println("FAIL smt_batch_entry_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_batch: PASSED");
}
