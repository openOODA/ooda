// # Product prove std/db_columnar/columnar_late_materialization.oo
//
// Logline: Fail-closed emit+gcc+run asserts position_vector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_late_materialization.oo.
//
// Beats:
//   1. Call position_vector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_late_materialization: PASSED only if they match.

import "std/db_columnar/columnar_late_materialization.oo";

pub fn main() {
    let columnar_late_materialization_mark: Int = 0;
    if columnar_late_materialization_mark != 0 {
        process_exit(1);
    }
    let a: PositionVector = position_vector_new(0);
    let b: PositionVector = position_vector_new(0);
    if (a).count != (b).count {
        println("FAIL position_vector_new");
        process_exit(1);
    }
    println("prod_columnar_late_materialization: PASSED");
}
