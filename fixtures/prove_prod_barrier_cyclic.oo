// # Product prove std/sync/barrier_cyclic.oo
//
// Logline: Fail-closed emit+gcc+run asserts cyclic_barrier_is_broken is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/barrier_cyclic.oo.
//
// Beats:
//   1. Call cyclic_barrier_is_broken twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_barrier_cyclic: PASSED only if they match.

import "std/sync/barrier_cyclic.oo";

pub fn main() {
    let obj = cyclic_barrier_new(0);
    let a = cyclic_barrier_is_broken(obj);
    let b = cyclic_barrier_is_broken(obj);
    if a != b {
        println("FAIL cyclic_barrier_is_broken");
        process_exit(1);
    }
    println("prod_barrier_cyclic: PASSED");
}
