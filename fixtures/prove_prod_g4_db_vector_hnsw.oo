// # Product prove std/database/vector_index_hnsw.oo
//
// Logline: Fail-closed verification that HNSW vector index construction, insertion, and candidate distance queries are deterministic.
//
// Setup: Isolated emit-c. Imports std/database/vector_index_hnsw.oo.
//
// Beats:
//   1. Verify probe marker and initialize HNSW configuration.
//   2. Create index instance and perform incremental vector registrations.
//   3. Compute fixed-point cosine distances against query embeddings.
//   4. Assert deterministic winner selection and total vector counts.
//   5. Print prod_g4_db_vector_hnsw: PASSED and exit 0.

import "std/database/vector_index_hnsw.oo";

pub fn main() {
    let probe_val: Int = vector_index_hnsw_probe();
    if probe_val != 0 {
        println("FAIL vector_index_hnsw_probe");
        process_exit(1);
    }

    let cfg: HnswConfig = HnswConfig {
        dim: 2,
        m_max: 16,
        ef_construction: 200,
        ef_search: 50,
        max_layers: 4
    };

    let idx0: HnswIndex = hnsw_index_create(cfg);
    if idx0.total_vectors != 0 || idx0.enter_point_id != 0 {
        println("FAIL hnsw_index_create");
        process_exit(1);
    }

    let idx1: HnswIndex = hnsw_index_insert(idx0, 101);
    let idx2: HnswIndex = hnsw_index_insert(idx1, 202);

    if idx2.total_vectors != 2 || idx2.enter_point_id != 101 {
        println("FAIL hnsw_index_insert total");
        process_exit(1);
    }

    let mut v1_comp: List[Int] = list_new();
    v1_comp = list_push(v1_comp, 100);
    v1_comp = list_push(v1_comp, 0);
    let vec1: VectorFloat = vector_create(v1_comp);

    let mut v2_comp: List[Int] = list_new();
    v2_comp = list_push(v2_comp, 0);
    v2_comp = list_push(v2_comp, 100);
    let vec2: VectorFloat = vector_create(v2_comp);

    let mut q_comp: List[Int] = list_new();
    q_comp = list_push(q_comp, 90);
    q_comp = list_push(q_comp, 10);
    let q_vec: VectorFloat = vector_create(q_comp);

    let best: Int = hnsw_find_best_candidate(vec1, vec2, q_vec);
    if best != 1 {
        println("FAIL hnsw_find_best_candidate");
        process_exit(1);
    }

    println("prod_g4_db_vector_hnsw: PASSED");
    process_exit(0);
}
