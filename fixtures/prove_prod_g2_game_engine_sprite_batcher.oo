// # Product prove std/game_engine/sprite_batcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts sprite_batch_can_add is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/sprite_batcher.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sprite_batch_can_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sprite_batcher: PASSED only if they match.

import "std/game_engine/sprite_batcher.oo";

pub fn main() {
    let g2_oa = sprite_batch_new(8);
    let g2_ob = sprite_batch_new(8);
    let g2_a = sprite_batch_can_add(&g2_oa);
    let g2_b = sprite_batch_can_add(&g2_ob);
    if g2_a != g2_b {
        println("FAIL sprite_batch_can_add");
        process_exit(1);
    }
    println("prod_g2_sprite_batcher: PASSED");
}
