// # Product prove std/robotics_auv/auv_swarm_leader_follower.oo
//
// Logline: Fail-closed emit+gcc+run asserts swarm_formation_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_swarm_leader_follower.oo.
//
// Beats:
//   1. Call swarm_formation_config_default using the auv_swarm_leader_follower ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_swarm_leader_follower: PASSED only if asserts hold.

import "std/robotics_auv/auv_swarm_leader_follower.oo";

pub fn main() {
    let obj = swarm_formation_config_default();
    let auv_swarm_leader_follower_a = obj.safety_separation_m;
    if auv_swarm_leader_follower_a != 15.0 {
        println("FAIL swarm_formation_config_default");
        process_exit(1);
    }
    println("prod_auv_swarm_leader_follower: PASSED");
}
