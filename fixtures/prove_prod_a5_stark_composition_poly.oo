// # Product prove std/zk_rollup/stark_composition_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts composition_poly_context_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_composition_poly.oo.
//
// Beats:
//   1. Call composition_poly_context_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stark_composition_poly: PASSED only if they match.

import "std/zk_rollup/stark_composition_poly.oo";

pub fn main() {
    let stark_composition_poly_mark: Int = 0;
    if stark_composition_poly_mark != 0 {
        process_exit(1);
    }
    let a: CompositionPolyContext = composition_poly_context_new(0, 0, 0);
    let b: CompositionPolyContext = composition_poly_context_new(0, 0, 0);
    if (a).num_boundary_constraints != (b).num_boundary_constraints {
        println("FAIL composition_poly_context_new");
        process_exit(1);
    }
    println("prod_stark_composition_poly: PASSED");
}
