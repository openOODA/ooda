// # Product prove std/zk_rollup/kzg10_trusted_setup.oo
//
// Logline: Fail-closed emit+gcc+run asserts srs_g1_point_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/kzg10_trusted_setup.oo.
//
// Beats:
//   1. Call srs_g1_point_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_kzg10_trusted_setup: PASSED only if asserts hold.

import "std/zk_rollup/kzg10_trusted_setup.oo";

pub fn main() {
    let kzg10_trusted_setup_a = srs_g1_point_new(0, 0, 0);
    let kzg10_trusted_setup_b = srs_g1_point_new(0, 0, 0);
    if kzg10_trusted_setup_a.x_val != kzg10_trusted_setup_b.x_val {
        println("FAIL srs_g1_point_new");
        process_exit(1);
    }
    println("prod_kzg10_trusted_setup: PASSED");
}
