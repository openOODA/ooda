// # Product prove std/crypto/zkp_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts pedersen_opening is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_types.oo.
//
// Beats:
//   1. Call pedersen_opening twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zkp_types: PASSED only if they match.

import "std/crypto/zkp_types.oo";

pub fn main() {
    let obj = pedersen_commit(0, 0, 0, 0, 0);
    let a = pedersen_opening(obj);
    let b = pedersen_opening(obj);
    if a != b {
        println("FAIL pedersen_opening");
        process_exit(1);
    }
    println("prod_zkp_types: PASSED");
}
