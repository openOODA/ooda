// # Product prove std/genomics_advanced/nanopore_kmer_pore_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_kmer_pore_model_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_kmer_pore_model.oo.
//
// Beats:
//   1. Call nanopore_kmer_pore_model_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_nanopore_kmer_pore_model: PASSED only if it matches.

import "std/genomics_advanced/nanopore_kmer_pore_model.oo";

pub fn main() {
    let a: Int = nanopore_kmer_pore_model_probe();
    if a != 0 {
        println("FAIL nanopore_kmer_pore_model_probe");
        process_exit(1);
    }
    println("prod_nc_nanopore_kmer_pore_model: PASSED");
}
