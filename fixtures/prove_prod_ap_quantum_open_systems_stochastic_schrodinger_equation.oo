// # Product prove std/quantum_open_systems/stochastic_schrodinger_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/stochastic_schrodinger_equation.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/stochastic_schrodinger_equation.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_stochastic_schrodinger_equation: PASSED only if they match.

import "std/quantum_open_systems/stochastic_schrodinger_equation.oo";

pub fn main() {
    let stochastic_schrodinger_equation_a = sse_c_new(0.0, 0.0);
    let stochastic_schrodinger_equation_b = sse_c_new(0.0, 0.0);
    if stochastic_schrodinger_equation_a.real != stochastic_schrodinger_equation_b.real {
        println("FAIL stochastic_schrodinger_equation");
        process_exit(1);
    }
    println("prod_ap_stochastic_schrodinger_equation: PASSED");
}
