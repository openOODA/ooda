// # Product prove std/compilers_vm/bytecode_garbage_collector.oo
//
// Logline: Fail-closed emit+gcc+run asserts nursery_space_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_garbage_collector.oo.
//
// Beats:
//   1. Call nursery_space_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_garbage_collector: PASSED only if they match.

import "std/compilers_vm/bytecode_garbage_collector.oo";

pub fn main() {
    let bytecode_garbage_collector_mark: Int = 0;
    if bytecode_garbage_collector_mark != 0 {
        process_exit(1);
    }
    let bytecode_garbage_collector_a = nursery_space_new(1);
    let bytecode_garbage_collector_b = nursery_space_new(1);
    if (bytecode_garbage_collector_a).capacity_bytes != (bytecode_garbage_collector_b).capacity_bytes {
        println("FAIL nursery_space_new");
        process_exit(1);
    }
    println("prod_bytecode_garbage_collector: PASSED");
}
