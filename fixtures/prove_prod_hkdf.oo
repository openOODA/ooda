// # Product prove std/crypto/hkdf.oo
//
// Logline: Fail-closed emit+gcc+run asserts hkdf_extract is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/hkdf.oo.
//
// Beats:
//   1. Call hkdf_extract twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hkdf: PASSED only if they match.

import "std/crypto/hkdf.oo";

pub fn main() {
    let a = hkdf_extract("x", "x");
    let b = hkdf_extract("x", "x");
    if a != b {
        println("FAIL hkdf_extract");
        process_exit(1);
    }
    println("prod_hkdf: PASSED");
}
