// # Product prove std/hft_alpha/mm_statistical_arbitrage_pairs.oo
//
// Logline: Fail-closed emit+gcc+run asserts pair_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_statistical_arbitrage_pairs.oo.
//
// Beats:
//   1. Call pair_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_statistical_arbitrage_pairs: PASSED only if they match.

import "std/hft_alpha/mm_statistical_arbitrage_pairs.oo";

pub fn main() {
    let mm_statistical_arbitrage_pairs_mark: Int = 0;
    if mm_statistical_arbitrage_pairs_mark != 0 {
        process_exit(1);
    }
    let a: PairStrategyConfig = pair_config_default();
    let b: PairStrategyConfig = pair_config_default();
    if (a).entry_z_score != (b).entry_z_score {
        println("FAIL pair_config_default");
        process_exit(1);
    }
    println("prod_g2_mm_statistical_arbitrage_pairs: PASSED");
}
