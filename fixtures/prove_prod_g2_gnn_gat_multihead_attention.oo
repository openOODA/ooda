// # Product prove std/graph_gnn/gnn_gat_multihead_attention.oo
//
// Logline: Fail-closed emit+gcc+run asserts gat_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_gat_multihead_attention.oo.
//
// Beats:
//   1. Call gat_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_gat_multihead_attention: PASSED only if they match.

import "std/graph_gnn/gnn_gat_multihead_attention.oo";

pub fn main() {
    let gnn_gat_multihead_attention_mark: Int = 0;
    if gnn_gat_multihead_attention_mark != 0 {
        process_exit(1);
    }
    let a: GATConfig = gat_config_new(0, 0, 0, 0.0, true);
    let b: GATConfig = gat_config_new(0, 0, 0, 0.0, true);
    if (a).in_features != (b).in_features {
        println("FAIL gat_config_new");
        process_exit(1);
    }
    println("prod_g2_gnn_gat_multihead_attention: PASSED");
}
