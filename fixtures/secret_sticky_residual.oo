// # Keep residual sticky taint after rebind
//
// Logline: Residual sticky taint does not clear when a tagged alias is rebound to a public literal.
//
// Beats:
//   1. Tag x at line start.
//   2. Bind mutable y to that name, then assign a public literal.
//   3. Print y so the residual rail still refuses.

// Residual: once tagged secret via assign-prop, reassign to public does not clear tag
// SECRET: x
pub fn main() {
    let x = "secret";
    let mut y = x;
    y = "public";
    println(y);
}
