// # Product prove std/exploit_analysis/shellcode_emulator_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts cpu_context_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/shellcode_emulator_engine.oo.
//
// Beats:
//   1. Call cpu_context_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_shellcode_emulator_engine: PASSED only if they match.

import "std/exploit_analysis/shellcode_emulator_engine.oo";

pub fn main() {
    let shellcode_emulator_engine_mark: Int = 0;
    if shellcode_emulator_engine_mark != 0 {
        process_exit(1);
    }
    let a: CpuContext = cpu_context_init(0, 0);
    let b: CpuContext = cpu_context_init(0, 0);
    if (a).rax != (b).rax {
        println("FAIL cpu_context_init");
        process_exit(1);
    }
    println("prod_g2_shellcode_emulator_engine: PASSED");
}
