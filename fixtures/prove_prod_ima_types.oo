// # Product prove std/sec/sys/ima_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_types_module_loaded is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/ima_types.oo.
//
// Beats:
//   1. Call ima_types_module_loaded twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ima_types: PASSED only if they match.

import "std/sec/sys/ima_types.oo";

pub fn main() {
    let a = ima_types_module_loaded();
    let b = ima_types_module_loaded();
    if a != b {
        println("FAIL ima_types_module_loaded");
        process_exit(1);
    }
    println("prod_ima_types: PASSED");
}
