// # Product prove std/graph_topology/all_pairs_floyd_warshall.oo
//
// Logline: Fail-closed emit+gcc+run asserts all_pairs_floyd_warshall_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/all_pairs_floyd_warshall.oo.
//
// Beats:
//   1. Call all_pairs_floyd_warshall_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_all_pairs_floyd_warshall: PASSED only if they match.

import "std/graph_topology/all_pairs_floyd_warshall.oo";

pub fn main() {
    let a: Int = all_pairs_floyd_warshall_probe();
    let b: Int = all_pairs_floyd_warshall_probe();
    if a != b {
        println("FAIL all_pairs_floyd_warshall_probe");
        process_exit(1);
    }
    println("prod_g2_all_pairs_floyd_warshall: PASSED");
}
