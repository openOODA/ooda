// # Product prove std/compilers_polyhedral/polyhedral_pass_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts polyhedral_pipeline_count_enabled is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_pass_pipeline.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call polyhedral_pipeline_count_enabled twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_pass_pipeline: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_pass_pipeline.oo";

pub fn main() {
    let g2_oa = polyhedral_pipeline_new(2);
    let g2_ob = polyhedral_pipeline_new(2);
    let g2_a = polyhedral_pipeline_count_enabled(g2_oa);
    let g2_b = polyhedral_pipeline_count_enabled(g2_ob);
    if g2_a != g2_b {
        println("FAIL polyhedral_pipeline_count_enabled");
        process_exit(1);
    }
    println("prod_g2_polyhedral_pass_pipeline: PASSED");
}
