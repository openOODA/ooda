// # Product prove std/ai_ml/metric_accuracy.oo
//
// Logline: Fail-closed emit+gcc+run of confusion-matrix milli accuracy.
//
// Setup: Isolated emit-c. Imports std/ai_ml/metric_accuracy.oo.
//
// Beats:
//   1. confusion_matrix_new(1, 0, 1, 0) accuracy milli is 1000.
//   2. Exit 1 on miss. Print prod_metric_accuracy: PASSED only if it holds.

import "std/ai_ml/metric_accuracy.oo";

pub fn main() {
    let metric_accuracy_a = confusion_matrix_new(1, 0, 1, 0);
    let n: Int = metric_accuracy_milli(metric_accuracy_a);
    if n != 1000 {
        println("FAIL metric_accuracy");
        process_exit(1);
    }
    println("prod_metric_accuracy: PASSED");
}
