// # Product prove std/mesh_ebpf/mesh_adaptive_concurrency.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh adaptive concurrency limit updates and admission control are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_adaptive_concurrency.oo.
//
// Beats:
//   1. Configure adaptive concurrency controller.
//   2. Acquire in-flight slots and release with measured latency feedback.
//   3. Assert dynamic limit adjustments and rejection counters.
//   4. Print prod_g4_ebpf_concurrency: PASSED and exit 0.

import "std/mesh_ebpf/mesh_adaptive_concurrency.oo";

pub fn main() {
    let cfg: AdaptiveConcurrencyConfig = adaptive_concurrency_config_default();
    let mut state: AdaptiveConcurrencyState = adaptive_concurrency_new(cfg);

    if (state).current_limit != 5 {
        println("FAIL adaptive_concurrency_new initial limit");
        process_exit(1);
    }
    if (state).in_flight != 0 {
        println("FAIL adaptive_concurrency_new in_flight");
        process_exit(1);
    }

    let ok_acq: Bool = adaptive_concurrency_try_acquire(&mut state);
    if !ok_acq {
        println("FAIL adaptive_concurrency_try_acquire 1");
        process_exit(1);
    }
    if (state).in_flight != 1 {
        println("FAIL adaptive_concurrency in_flight after acq");
        process_exit(1);
    }

    adaptive_concurrency_release(&mut state, 10);
    if (state).in_flight != 0 {
        println("FAIL adaptive_concurrency in_flight after rel");
        process_exit(1);
    }
    if (state).current_limit < 5 {
        println("FAIL adaptive_concurrency current_limit under minimum");
        process_exit(1);
    }

    println("prod_g4_ebpf_concurrency: PASSED");
    process_exit(0);
}
