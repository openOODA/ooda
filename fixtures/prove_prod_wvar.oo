// # Product weighted variance prove
//
// Logline: Fail-closed emit+gcc+run of shipped weighted_stats_add/mean/variance.
//
// Setup: Product std/math/variance_weighted.oo. Equal-weight 1 and 3.
//
// Beats:
//   1. Weighted mean of 1 and 3 weight 1 is 2.0.
//   2. Population weighted variance is 1.0 (m2/W).
//   3. Exit 1 before PASSED on a miss.

import "std/math/variance_weighted.oo";

pub fn main() {
    let mut s: WeightedStats = weighted_stats_new();
    s = weighted_stats_add(s, 1.0, 1.0);
    s = weighted_stats_add(s, 3.0, 1.0);
    let m: Float = s.weighted_mean;
    if m != 2.0 {
        println("FAIL wvar mean");
        process_exit(1);
    }
    let v: Float = weighted_stats_variance(s);
    if v != 1.0 {
        println("FAIL wvar var");
        process_exit(1);
    }
    println("prod_wvar: PASSED");
}
