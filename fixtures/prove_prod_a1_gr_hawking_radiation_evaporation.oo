// # Product prove std/astrophysics_relativity/gr_hawking_radiation_evaporation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gr_hawking_temperature is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_hawking_radiation_evaporation.oo.
//
// Beats:
//   1. Call gr_hawking_temperature twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_hawking_radiation_evaporation: PASSED only if they match.

import "std/astrophysics_relativity/gr_hawking_radiation_evaporation.oo";

pub fn main() {
    let gr_hawking_radiation_evaporation_mark: Int = 0;
    if gr_hawking_radiation_evaporation_mark != 0 {
        process_exit(1);
    }
    let a: Int = gr_hawking_temperature(0);
    let b: Int = gr_hawking_temperature(0);
    if a != b {
        println("FAIL gr_hawking_temperature");
        process_exit(1);
    }
    println("prod_gr_hawking_radiation_evaporation: PASSED");
}
