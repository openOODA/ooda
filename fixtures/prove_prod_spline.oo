// # Product linear spline prove
//
// Logline: Fail-closed emit+gcc+run of shipped spline_linear_eval_seg.
//
// Setup: Product std/math/spline_linear.oo. Segment (0,0)-(2,2) at x=1 is 1.
//
// Beats:
//   1. Midpoint is 1.0.
//   2. At x=2 is 2.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/spline_linear.oo";

pub fn main() {
    let k0: Knot = knot_new(0.0, 0.0);
    let k1: Knot = knot_new(2.0, 2.0);
    let mid: Float = spline_linear_eval_seg(k0, k1, 1.0);
    if mid != 1.0 {
        println("FAIL spline mid");
        process_exit(1);
    }
    let end: Float = spline_linear_eval_seg(k0, k1, 2.0);
    if end != 2.0 {
        println("FAIL spline end");
        process_exit(1);
    }
    println("prod_spline: PASSED");
}
