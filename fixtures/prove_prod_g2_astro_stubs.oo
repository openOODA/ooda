// # Product prove std/astrodynamics/astro_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts stub_earth_mars_transfer_dv is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/astro_stubs.oo.
//
// Beats:
//   1. Call stub_earth_mars_transfer_dv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_astro_stubs: PASSED only if they match.

import "std/astrodynamics/astro_stubs.oo";

pub fn main() {
    let astro_stubs_mark: Int = 0;
    if astro_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Float = stub_earth_mars_transfer_dv();
    let b: Float = stub_earth_mars_transfer_dv();
    if a != b {
        println("FAIL stub_earth_mars_transfer_dv");
        process_exit(1);
    }
    println("prod_g2_astro_stubs: PASSED");
}
