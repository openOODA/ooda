// # Product prove std/formal_verif/model_check_symbolic_bdd.oo
//
// Logline: Fail-closed emit+gcc+run asserts bdd_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_symbolic_bdd.oo.
//
// Beats:
//   1. Call bdd_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_model_check_symbolic_bdd: PASSED only if they match.

import "std/formal_verif/model_check_symbolic_bdd.oo";

pub fn main() {
    let model_check_symbolic_bdd_mark: Int = 0;
    if model_check_symbolic_bdd_mark != 0 {
        process_exit(1);
    }
    let a: BddManager = bdd_manager_new();
    let b: BddManager = bdd_manager_new();
    if (a).node_count != (b).node_count {
        println("FAIL bdd_manager_new");
        process_exit(1);
    }
    println("prod_g2_model_check_symbolic_bdd: PASSED");
}
