// # Product prove std/satellite_dvb/isl_laser_link_doppler.oo
//
// Logline: Fail-closed emit+gcc+run asserts laser_doppler_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_laser_link_doppler.oo.
//
// Beats:
//   1. Call laser_doppler_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isl_laser_link_doppler: PASSED only if they match.

import "std/satellite_dvb/isl_laser_link_doppler.oo";

pub fn main() {
    let a: LaserDopplerState = laser_doppler_state_new(0.0);
    let b: LaserDopplerState = laser_doppler_state_new(0.0);
    if a.nominal_wavelength_nm != b.nominal_wavelength_nm {
        println("FAIL laser_doppler_state_new");
        process_exit(1);
    }
    println("prod_isl_laser_link_doppler: PASSED");
}
