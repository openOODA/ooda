// # IDENT if is leftover
//
// Logline: if x must fail closed and not emit both arms.
//
// Setup: x is not const true/false.
//
// Beats:
//   1. Bind x to true.
//   2. if x print YES else print NO.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = true;
    if x {
        println("YES");
    } else {
        println("NO");
    }
}
