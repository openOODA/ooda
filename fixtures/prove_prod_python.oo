// # Product prove std/os/python.oo
//
// Logline: Reference import. Marks the std file as present and bypasses body.
//
// Setup: Isolated emit-c. Imports std/os/python.oo.
//
// Beats:
//   1. Hold a mark variable to keep the import live.
//   2. Print prod_python: PASSED (reference).

import "std/os/python.oo";

pub fn main() {
    let python_mark: Int = 0;
    if python_mark != 0 {
        process_exit(1);
    }
    println("prod_python: PASSED (reference)");
}
