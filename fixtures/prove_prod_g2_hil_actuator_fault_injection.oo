// # Product prove std/digital_twin/hil_actuator_fault_injection.oo
//
// Logline: Fail-closed emit+gcc+run asserts fault_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/hil_actuator_fault_injection.oo.
//
// Beats:
//   1. Call fault_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hil_actuator_fault_injection: PASSED only if they match.

import "std/digital_twin/hil_actuator_fault_injection.oo";

pub fn main() {
    let hil_actuator_fault_injection_mark: Int = 0;
    if hil_actuator_fault_injection_mark != 0 {
        process_exit(1);
    }
    let a: FaultConfig = fault_config_new(0, 0.0, 0.0, 0.0, 0.0);
    let b: FaultConfig = fault_config_new(0, 0.0, 0.0, 0.0, 0.0);
    if (a).fault_type != (b).fault_type {
        println("FAIL fault_config_new");
        process_exit(1);
    }
    println("prod_g2_hil_actuator_fault_injection: PASSED");
}
