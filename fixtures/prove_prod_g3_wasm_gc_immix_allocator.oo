// # Product prove std/wasm_gc/wasm_gc_immix_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts immix_line_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_immix_allocator.oo.
//
// Beats:
//   1. Call immix_line_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_immix_allocator: PASSED only if they match.

import "std/wasm_gc/wasm_gc_immix_allocator.oo";

pub fn main() {
    let wasm_gc_immix_allocator_mark: Int = 0;
    if wasm_gc_immix_allocator_mark != 0 {
        process_exit(1);
    }
    let a: ImmixLine = immix_line_new(0);
    let b: ImmixLine = immix_line_new(0);
    if (a).line_index != (b).line_index {
        println("FAIL immix_line_new");
        process_exit(1);
    }
    println("prod_wasm_gc_immix_allocator: PASSED");
}
