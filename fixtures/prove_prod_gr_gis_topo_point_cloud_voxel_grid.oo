// # Product prove std/gis_topo/point_cloud_voxel_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts voxel_accum_get_centroid is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/point_cloud_voxel_grid.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call voxel_accum_get_centroid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_point_cloud_voxel_grid: PASSED only if they match.

import "std/gis_topo/point_cloud_voxel_grid.oo";

pub fn main() {
    let g0_oa = voxel_accum_new(0, 0, 0);
    let g0_ob = voxel_accum_new(0, 0, 0);
    let g0_la = voxel_accum_get_centroid(&g0_oa);
    let g0_lb = voxel_accum_get_centroid(&g0_ob);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL voxel_accum_get_centroid");
        process_exit(1);
    }
    println("prod_gr_point_cloud_voxel_grid: PASSED");
}
