// # Product prove std/ai_multimodal/vit_positional_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/vit_positional_2d.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_positional_2d.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vit_positional_2d: PASSED only if they match.

import "std/ai_multimodal/vit_positional_2d.oo";

pub fn main() {
    let vit_positional_2d_a = vit_n_tok_grid(0, 0);
    let vit_positional_2d_b = vit_n_tok_grid(0, 0);
    if vit_positional_2d_a != vit_positional_2d_b {
        println("FAIL vit_positional_2d");
        process_exit(1);
    }
    println("prod_ap_vit_positional_2d: PASSED");
}
