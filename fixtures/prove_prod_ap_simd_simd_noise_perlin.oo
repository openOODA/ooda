// # Product prove std/simd/simd_noise_perlin.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_noise_perlin.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_noise_perlin.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_noise_perlin: PASSED only if they match.

import "std/simd/simd_noise_perlin.oo";

pub fn main() {
    let simd_noise_perlin_a = perlin_fade(0.0);
    let simd_noise_perlin_b = perlin_fade(0.0);
    if simd_noise_perlin_a != simd_noise_perlin_b {
        println("FAIL simd_noise_perlin");
        process_exit(1);
    }
    println("prod_ap_simd_noise_perlin: PASSED");
}
