//
// Setup: Isolated emit-c. Imports std/auto_robot/path_planner_hybrid_astar.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_path_planner_hybrid_astar: PASSED only if they match.

import "std/auto_robot/path_planner_hybrid_astar.oo";

pub fn main() {
    let path_planner_hybrid_astar_a = hastar_f(0, 0);
    let path_planner_hybrid_astar_b = hastar_f(0, 0);
    if path_planner_hybrid_astar_a != path_planner_hybrid_astar_b {
        println("FAIL path_planner_hybrid_astar");
        process_exit(1);
    }
    println("prod_ap_path_planner_hybrid_astar: PASSED");
