// # Product prove std/db_columnar/columnar_vectorized_hash_agg.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_vectorized_hash_agg.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_hash_agg.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_vectorized_hash_agg: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_hash_agg.oo";

pub fn main() {
    let columnar_vectorized_hash_agg_a = hash_agg_table_new();
    let columnar_vectorized_hash_agg_b = hash_agg_table_new();
    let columnar_vectorized_hash_agg_va = hash_agg_find_group(columnar_vectorized_hash_agg_a, 0);
    let columnar_vectorized_hash_agg_vb = hash_agg_find_group(columnar_vectorized_hash_agg_b, 0);
    if columnar_vectorized_hash_agg_va != columnar_vectorized_hash_agg_vb {
        println("FAIL columnar_vectorized_hash_agg");
        process_exit(1);
    }
    println("prod_ap_columnar_vectorized_hash_agg: PASSED");
}
