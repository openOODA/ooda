// # Product prove std/net_telemetry/icmp_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts icmp_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/icmp_packet.oo.
//
// Beats:
//   1. Call icmp_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_icmp_packet: PASSED only if they match.

import "std/net_telemetry/icmp_packet.oo";

pub fn main() {
    let icmp_packet_mark: Int = 0;
    if icmp_packet_mark != 0 {
        process_exit(1);
    }
    let a: IcmpHeader = icmp_header_new(0, 0, 0, 0, 0);
    let b: IcmpHeader = icmp_header_new(0, 0, 0, 0, 0);
    if (a).msg_type != (b).msg_type {
        println("FAIL icmp_header_new");
        process_exit(1);
    }
    println("prod_icmp_packet: PASSED");
}
