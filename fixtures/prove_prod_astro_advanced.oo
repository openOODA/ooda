// # Product prove std/astro_advanced/astro_advanced.oo
//
// Logline: Fail-closed emit+gcc+run asserts astro_adv_ok is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/astro_advanced.oo.
//
// Beats:
//   1. Call astro_adv_ok twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_astro_advanced: PASSED only if they match.

import "std/astro_advanced/astro_advanced.oo";

pub fn main() {
    let a = astro_adv_ok();
    let b = astro_adv_ok();
    if a != b {
        println("FAIL astro_adv_ok");
        process_exit(1);
    }
    println("prod_astro_advanced: PASSED");
}
