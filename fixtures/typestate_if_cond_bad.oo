// # Send after connect in an if condition
//
// Logline: Call connect as the if condition and send in the body so the cond transition must count.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Use connect(s) as the if condition.
//   3. Send in the true body.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) -> Bool { return true; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    if connect(s) {
        send(s);
    }
}
