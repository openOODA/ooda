// # Product bit reader prove
//
// Logline: Fail-closed emit+gcc+run of shipped bit_reader_peek_bit.
//
// Setup: Product std/io/bit_reader.oo. MSB of 128 is 1; of 1 is 0.
//
// Beats:
//   1. Peek first bit of 128 is 1.
//   2. Peek first bit of 1 is 0.
//   3. Remaining bits of one byte is 8.
//   4. Exit 1 before PASSED on a miss.

import "std/io/bit_reader.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 128);
    let r: BitReader = bit_reader_new(xs);
    let n: Int = bit_reader_remaining_bits(r);
    if n != 8 {
        println("FAIL rem8");
        process_exit(1);
    }
    let b: Int = bit_reader_peek_bit(r);
    if b != 1 {
        println("FAIL peek 128");
        process_exit(1);
    }
    let mut ys: List[Int] = list_new();
    ys = list_push(ys, 1);
    let r2: BitReader = bit_reader_new(ys);
    let b2: Int = bit_reader_peek_bit(r2);
    if b2 != 0 {
        println("FAIL peek 1");
        process_exit(1);
    }
    println("prod_bitread: PASSED");
}
