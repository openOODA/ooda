// # Product prove std/edge/power_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts power_ops_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/edge/power_ops.oo.
//
// Beats:
//   1. Call power_ops_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_power_ops: PASSED only if it matches.

import "std/edge/power_ops.oo";

pub fn main() {
    let a: Int = power_ops_probe();
    if a != 0 {
        println("FAIL power_ops_probe");
        process_exit(1);
    }
    println("prod_nc_power_ops: PASSED");
}
