// # Product hash_set prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash_set_insert/contains.
//
// Setup: Product std/collections/hash_set.oo. List[Int] destub.
//
// Beats:
//   1. After insert 7, contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/hash_set.oo";

pub fn main() {
    let mut s: HashSet = hash_set_new();
    s = hash_set_insert(s, 7);
    let c7: Bool = hash_set_contains(s, 7);
    if c7 == false {
        println("FAIL hset 7");
        process_exit(1);
    }
    let c3: Bool = hash_set_contains(s, 3);
    if c3 == true {
        println("FAIL hset 3");
        process_exit(1);
    }
    println("prod_hset: PASSED");
}
