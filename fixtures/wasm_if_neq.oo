// # Const if 1 != 2 println
//
// Logline: Print neq-then when the condition is 1 != 2.
//
// Setup: No imports. One public main. Body is only if INT != INT then else println.
//
// Beats:
//   1. Declare public main.
//   2. If 1 != 2 print neq-then else print neq-else.
//   3. Leave no other statements.

pub fn main() {
    if 1 != 2 {
        println("neq-then");
    } else {
        println("neq-else");
    }
}
