// # Product KMP prove
//
// Logline: Fail-closed emit+gcc+run of shipped kmp_search_first.
//
// Setup: Product std/text/kmp.oo. First index of abc in xxabcxx is 2.
//
// Beats:
//   1. kmp_search_first of abc in xxabcxx is 2.
//   2. Missing needle returns -1.
//   3. Exit 1 before PASSED on a miss.

import "std/text/kmp.oo";

pub fn main() {
    let pat: KmpPattern = kmp_compile("abc");
    let idx: Int = kmp_search_first(pat, "xxabcxx");
    if idx != 2 {
        println("FAIL kmp first");
        process_exit(1);
    }
    let miss: Int = kmp_search_first(pat, "abxab");
    if miss != 0 - 1 {
        println("FAIL kmp miss");
        process_exit(1);
    }
    println("prod_kmp: PASSED");
}
