// # Product prove std/space_propulsion/pulsed_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts ppt_circuit_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/pulsed_plasma_thruster.oo.
//
// Beats:
//   1. Call ppt_circuit_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pulsed_plasma_thruster: PASSED only if they match.

import "std/space_propulsion/pulsed_plasma_thruster.oo";

pub fn main() {
    let pulsed_plasma_thruster_mark: Int = 0;
    if pulsed_plasma_thruster_mark != 0 {
        process_exit(1);
    }
    let a: PptCircuitSpec = ppt_circuit_spec_default();
    let b: PptCircuitSpec = ppt_circuit_spec_default();
    if (a).capacitance_uf != (b).capacitance_uf {
        println("FAIL ppt_circuit_spec_default");
        process_exit(1);
    }
    println("prod_pulsed_plasma_thruster: PASSED");
}
