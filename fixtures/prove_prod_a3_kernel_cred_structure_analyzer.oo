// # Product prove std/exploit_analysis/kernel_cred_structure_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts linux_cred_layout_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/kernel_cred_structure_analyzer.oo.
//
// Beats:
//   1. Call linux_cred_layout_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_cred_structure_analyzer: PASSED only if they match.

import "std/exploit_analysis/kernel_cred_structure_analyzer.oo";

pub fn main() {
    let kernel_cred_structure_analyzer_mark: Int = 0;
    if kernel_cred_structure_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: LinuxCredLayout = linux_cred_layout_default(0);
    let b: LinuxCredLayout = linux_cred_layout_default(0);
    if (a).cred_address != (b).cred_address {
        println("FAIL linux_cred_layout_default");
        process_exit(1);
    }
    println("prod_kernel_cred_structure_analyzer: PASSED");
}
