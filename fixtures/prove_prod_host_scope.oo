// # Product prove std/sec/host_scope.oo
//
// Logline: Fail-closed emit+gcc+run asserts host_scope_allows is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/host_scope.oo.
//
// Beats:
//   1. Call host_scope_allows twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_host_scope: PASSED only if they match.

import "std/sec/host_scope.oo";

pub fn main() {
    let a = host_scope_allows("x", "x");
    let b = host_scope_allows("x", "x");
    if a != b {
        println("FAIL host_scope_allows");
        process_exit(1);
    }
    println("prod_host_scope: PASSED");
}
