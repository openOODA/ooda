// # Product prove std/robotics_auv/auv_restoring_forces.oo
//
// Logline: Fail-closed emit+gcc+run asserts auv_hydrostatic_params_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_restoring_forces.oo.
//
// Beats:
//   1. Call auv_hydrostatic_params_default using the auv_restoring_forces ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_restoring_forces: PASSED only if asserts hold.

import "std/robotics_auv/auv_restoring_forces.oo";

pub fn main() {
    let obj = auv_hydrostatic_params_default();
    let auv_restoring_forces_a = obj.mass_kg;
    if auv_restoring_forces_a != 30.5 {
        println("FAIL auv_hydrostatic_params_default");
        process_exit(1);
    }
    println("prod_auv_restoring_forces: PASSED");
}
