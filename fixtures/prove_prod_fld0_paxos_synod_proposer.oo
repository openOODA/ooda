// # Product prove std/cloud_k8s/paxos_synod_proposer.oo
//
// Logline: Fail-closed emit+gcc+run asserts synod_proposer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/paxos_synod_proposer.oo.
//
// Beats:
//   1. Call synod_proposer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_paxos_synod_proposer: PASSED only if they match.

import "std/cloud_k8s/paxos_synod_proposer.oo";

pub fn main() {
    let paxos_synod_proposer_mark: Int = 0;
    if paxos_synod_proposer_mark != 0 {
        process_exit(1);
    }
    let paxos_synod_proposer_a: SynodProposer = synod_proposer_new("x", 1, 1);
    let paxos_synod_proposer_b: SynodProposer = synod_proposer_new("x", 1, 1);
    if (paxos_synod_proposer_a).node_index != (paxos_synod_proposer_b).node_index {
        println("FAIL synod_proposer_new");
        process_exit(1);
    }
    println("prod_paxos_synod_proposer: PASSED");
}
