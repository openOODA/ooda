// # Product prove std/neuro_bci/spike_sorting_pca_kmeans.oo
//
// Logline: Fail-closed emit+gcc+run asserts spike_sorting_pca_kmeans_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_sorting_pca_kmeans.oo.
//
// Beats:
//   1. Call spike_sorting_pca_kmeans_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_spike_sorting_pca_kmeans: PASSED only if they match.

import "std/neuro_bci/spike_sorting_pca_kmeans.oo";

pub fn main() {
    let a: Int = spike_sorting_pca_kmeans_probe();
    let b: Int = spike_sorting_pca_kmeans_probe();
    if a != b {
        println("FAIL spike_sorting_pca_kmeans_probe");
        process_exit(1);
    }
    println("prod_g2_spike_sorting_pca_kmeans: PASSED");
}
