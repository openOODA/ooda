// # Product prove std/cloud_faas/cloud_faas_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_faas/cloud_faas_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/cloud_faas_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cloud_faas_stubs: PASSED only if they match.

import "std/cloud_faas/cloud_faas_stubs.oo";

pub fn main() {
    let cloud_faas_stubs_a = cloud_faas_fail_closed("x", 0);
    let cloud_faas_stubs_b = cloud_faas_fail_closed("x", 0);
    if cloud_faas_stubs_a != cloud_faas_stubs_b {
        println("FAIL cloud_faas_stubs");
        process_exit(1);
    }
    println("prod_ap_cloud_faas_stubs: PASSED");
}
