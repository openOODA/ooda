// # Product prove std/wasm_gc/jit_cfg_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts jir_cfg_block_info_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_cfg_analysis.oo.
//
// Beats:
//   1. Call jir_cfg_block_info_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_cfg_analysis: PASSED only if they match.

import "std/wasm_gc/jit_cfg_analysis.oo";

pub fn main() {
    let a: JirCfgBlockInfo = jir_cfg_block_info_new(0);
    let b: JirCfgBlockInfo = jir_cfg_block_info_new(0);
    if a.block_id != b.block_id {
        println("FAIL jir_cfg_block_info_new");
        process_exit(1);
    }
    println("prod_jit_cfg_analysis: PASSED");
}
