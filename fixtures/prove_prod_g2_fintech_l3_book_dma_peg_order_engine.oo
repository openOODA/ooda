// # Product prove std/fintech_l3_book/dma_peg_order_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts pegged_order_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_peg_order_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pegged_order_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dma_peg_order_engine: PASSED only if they match.

import "std/fintech_l3_book/dma_peg_order_engine.oo";

pub fn main() {
    let g2_oa: PeggedOrder = pegged_order_new(2, "x", 2, "x", "x", 2, 8);
    let g2_ob: PeggedOrder = pegged_order_new(2, "x", 2, "x", "x", 2, 8);
    let g2_a = (g2_oa).user_ref_number;
    let g2_b = (g2_ob).user_ref_number;
    if g2_a != g2_b {
        println("FAIL pegged_order_new.user_ref_number");
        process_exit(1);
    }
    println("prod_g2_dma_peg_order_engine: PASSED");
}
