// # Product prove std/sec/crypto/falcon.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_falcon: PASSED and exit 0 only on match.

import "std/sec/crypto/falcon.oo";

pub fn main() {
    let deg_a: Int = shim_marker_degree();
    let deg_b: Int = shim_marker_degree();
    if deg_a != deg_b || deg_a != 512 {
        println("FAIL falcon shim_marker_degree");
        process_exit(1);
    }

    let params_a: FalconParams = shim_marker_params();
    let params_b: FalconParams = shim_marker_params();
    if (params_a).degree != (params_b).degree || (params_a).degree != 512 {
        println("FAIL falcon shim_marker_params degree");
        process_exit(1);
    }

    let poly_a: FalconPolynomial = shim_marker_poly_zero();
    let poly_b: FalconPolynomial = shim_marker_poly_zero();
    if (poly_a).degree != (poly_b).degree || (poly_a).degree != 8 {
        println("FAIL falcon shim_marker_poly_zero degree");
        process_exit(1);
    }

    let chk_a: Int = shim_marker_checksum();
    let chk_b: Int = shim_marker_checksum();
    if chk_a != chk_b {
        println("FAIL falcon shim_marker_checksum");
        process_exit(1);
    }

    let batch_a: FalconBatchVerifier = shim_marker_batch_init();
    let batch_b: FalconBatchVerifier = shim_marker_batch_init();
    if (batch_a).verifier_id != (batch_b).verifier_id || (batch_a).degree != (batch_b).degree {
        println("FAIL falcon shim_marker_batch_init");
        process_exit(1);
    }

    let probe_a: Int = shim_marker_stubs_probe();
    let probe_b: Int = shim_marker_stubs_probe();
    if probe_a != probe_b || probe_a != 1 {
        println("FAIL falcon shim_marker_stubs_probe");
        process_exit(1);
    }

    println("prod_g4_sec_falcon: PASSED");
    process_exit(0);
}
