// # Product prove std/web_ecosystem/semver_range.oo
//
// Logline: Fail-closed emit+gcc+run asserts semver_cmp is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/semver_range.oo.
//
// Beats:
//   1. Call semver_cmp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_semver_range: PASSED only if they match.

import "std/web_ecosystem/semver_range.oo";

pub fn main() {
    let semver_range_mark: Int = 0;
    if semver_range_mark != 0 {
        process_exit(1);
    }
    let semver_range_a: Int = semver_cmp(1, 1, 1, 1, 1, 1);
    let semver_range_b: Int = semver_cmp(1, 1, 1, 1, 1, 1);
    if semver_range_a != semver_range_b {
        println("FAIL semver_cmp");
        process_exit(1);
    }
    println("prod_semver_range: PASSED");
}
