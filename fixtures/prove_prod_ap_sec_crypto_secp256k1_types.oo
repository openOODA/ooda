// # Product prove std/sec/crypto/secp256k1_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/secp256k1_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/secp256k1_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_secp256k1_types: PASSED only if they match.

import "std/sec/crypto/secp256k1_types.oo";

pub fn main() {
    let secp256k1_types_a = secp256k1_checksum("x");
    let secp256k1_types_b = secp256k1_checksum("x");
    if secp256k1_types_a != secp256k1_types_b {
        println("FAIL secp256k1_types");
        process_exit(1);
    }
    println("prod_ap_secp256k1_types: PASSED");
}
