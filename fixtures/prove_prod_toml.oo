// # Product prove std/markup/toml.oo
//
// Logline: Fail-closed emit+gcc+run asserts toml_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/toml.oo.
//
// Beats:
//   1. Call toml_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_toml: PASSED only if they match.

import "std/markup/toml.oo";

pub fn main() {
    let a = toml_parse("x");
    let b = toml_parse("x");
    if a != b {
        println("FAIL toml_parse");
        process_exit(1);
    }
    println("prod_toml: PASSED");
}
