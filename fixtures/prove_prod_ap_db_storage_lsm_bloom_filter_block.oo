// # Product prove std/db_storage/lsm_bloom_filter_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/lsm_bloom_filter_block.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_bloom_filter_block.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lsm_bloom_filter_block: PASSED only if they match.

import "std/db_storage/lsm_bloom_filter_block.oo";

pub fn main() {
    let lsm_bloom_filter_block_a = bloom_hash_seed("x", 0);
    let lsm_bloom_filter_block_b = bloom_hash_seed("x", 0);
    if lsm_bloom_filter_block_a != lsm_bloom_filter_block_b {
        println("FAIL lsm_bloom_filter_block");
        process_exit(1);
    }
    println("prod_ap_lsm_bloom_filter_block: PASSED");
}
