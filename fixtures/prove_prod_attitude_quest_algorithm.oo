// # Product prove std/astro_advanced/attitude_quest_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts quest_yaw is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_quest_algorithm.oo.
//
// Beats:
//   1. Call quest_yaw twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_quest_algorithm: PASSED only if they match.

import "std/astro_advanced/attitude_quest_algorithm.oo";

pub fn main() {
    let a = quest_yaw(0);
    let b = quest_yaw(0);
    if a != b {
        println("FAIL quest_yaw");
        process_exit(1);
    }
    println("prod_attitude_quest_algorithm: PASSED");
}
