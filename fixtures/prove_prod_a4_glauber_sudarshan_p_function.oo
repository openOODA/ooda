// # Product prove std/quantum_open_systems/glauber_sudarshan_p_function.oo
//
// Logline: Fail-closed emit+gcc+run asserts mandel_q_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/glauber_sudarshan_p_function.oo.
//
// Beats:
//   1. Call mandel_q_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_glauber_sudarshan_p_function: PASSED only if they match.

import "std/quantum_open_systems/glauber_sudarshan_p_function.oo";

pub fn main() {
    let glauber_sudarshan_p_function_mark: Int = 0;
    if glauber_sudarshan_p_function_mark != 0 {
        process_exit(1);
    }
    let a: Float = mandel_q_eval(0.0, 0.0);
    let b: Float = mandel_q_eval(0.0, 0.0);
    if a != b {
        println("FAIL mandel_q_eval");
        process_exit(1);
    }
    println("prod_glauber_sudarshan_p_function: PASSED");
}
