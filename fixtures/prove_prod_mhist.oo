// # Product diag metrics histogram prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/metrics_histogram.oo.
//
// Setup: Product std/diag/metrics_histogram.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty count 0 mean 0.
//   2. Record 10 and 20: count 2 mean 15.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/metrics_histogram.oo";

pub fn main() {
    let h0: MetricsHist = metrics_hist_new("lat");
    let c0: Int = metrics_hist_count(h0);
    if c0 != 0 {
        println("FAIL mhist empty count");
        process_exit(1);
    }
    let m0: Int = metrics_hist_mean(h0);
    if m0 != 0 {
        println("FAIL mhist empty mean");
        process_exit(1);
    }
    let h1: MetricsHist = metrics_hist_record(h0, 10);
    let h2: MetricsHist = metrics_hist_record(h1, 20);
    let c: Int = metrics_hist_count(h2);
    if c != 2 {
        println("FAIL mhist count");
        process_exit(1);
    }
    let m: Int = metrics_hist_mean(h2);
    if m != 15 {
        println("FAIL mhist mean");
        process_exit(1);
    }
    println("prod_mhist: PASSED");
}
