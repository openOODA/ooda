// # Product prove std/sec/sys/pe_util.oo
//
// Logline: Fail-closed emit+gcc+run asserts pe_get_machine_name holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_util.oo.
//
// Beats:
//   1. Call pe_get_machine_name using the pe_util ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_pe_util: PASSED only if asserts hold.

import "std/sec/sys/pe_util.oo";
import "std/str.oo";

pub fn main() {
    let pe_util_a = pe_get_machine_name(0);
    let pe_util_b = pe_get_machine_name(0);
    if chars_len(pe_util_a) != chars_len(pe_util_b) {
        println("FAIL pe_get_machine_name");
        process_exit(1);
    }
    if !str_contains(pe_util_a, pe_util_b) {
        println("FAIL pe_get_machine_name");
        process_exit(1);
    }
    if !str_contains(pe_util_b, pe_util_a) {
        println("FAIL pe_get_machine_name");
        process_exit(1);
    }
    println("prod_pe_util: PASSED");
}
