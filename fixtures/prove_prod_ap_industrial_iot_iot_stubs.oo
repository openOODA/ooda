// # Product prove std/industrial_iot/iot_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_iot/iot_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/iot_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_iot_stubs: PASSED only if they match.

import "std/industrial_iot/iot_stubs.oo";

pub fn main() {
    let iot_stubs_a = iot_hardware_config_new(0, "x", 0);
    let iot_stubs_b = iot_hardware_config_new(0, "x", 0);
    if iot_stubs_a.bus_type != iot_stubs_b.bus_type {
        println("FAIL iot_stubs");
        process_exit(1);
    }
    println("prod_ap_iot_stubs: PASSED");
}
