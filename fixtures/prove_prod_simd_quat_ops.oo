// # Product prove std/simd/simd_quat_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_quat_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_quat_ops.oo.
//
// Beats:
//   1. Call simd_quat_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_quat_ops: PASSED only if they match.

import "std/simd/simd_quat_ops.oo";

pub fn main() {
    let obj = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    let a = obj.x;
    let b = obj.x;
    if a != b {
        println("FAIL simd_quat_new");
        process_exit(1);
    }
    println("prod_simd_quat_ops: PASSED");
}
