// # Product prove std/auto/occupancy_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts occ_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy_engine.oo.
//
// Beats:
//   1. Call occ_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_occupancy_engine: PASSED only if they match.

import "std/auto/occupancy_engine.oo";

pub fn main() {
    let occupancy_engine_mark: Int = 0;
    if occupancy_engine_mark != 0 {
        process_exit(1);
    }
    let a: OccEng = occ_eng_new(0, 0);
    let b: OccEng = occ_eng_new(0, 0);
    if (a).dim_x != (b).dim_x {
        println("FAIL occ_eng_new");
        process_exit(1);
    }
    println("prod_occupancy_engine: PASSED");
}
