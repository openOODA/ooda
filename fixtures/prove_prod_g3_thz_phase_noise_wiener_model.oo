// # Product prove std/telecom_6g/thz_phase_noise_wiener_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts pn_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_phase_noise_wiener_model.oo.
//
// Beats:
//   1. Call pn_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_phase_noise_wiener_model: PASSED only if they match.

import "std/telecom_6g/thz_phase_noise_wiener_model.oo";

pub fn main() {
    let thz_phase_noise_wiener_model_mark: Int = 0;
    if thz_phase_noise_wiener_model_mark != 0 {
        process_exit(1);
    }
    let a: Float = pn_int_to_float(0);
    let b: Float = pn_int_to_float(0);
    if a != b {
        println("FAIL pn_int_to_float");
        process_exit(1);
    }
    println("prod_thz_phase_noise_wiener_model: PASSED");
}
