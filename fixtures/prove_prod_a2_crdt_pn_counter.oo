// # Product prove std/cloud_k8s/crdt_pn_counter.oo
//
// Logline: Fail-closed emit+gcc+run asserts pn_counter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_pn_counter.oo.
//
// Beats:
//   1. Call pn_counter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crdt_pn_counter: PASSED only if they match.

import "std/cloud_k8s/crdt_pn_counter.oo";

pub fn main() {
    let crdt_pn_counter_mark: Int = 0;
    if crdt_pn_counter_mark != 0 {
        process_exit(1);
    }
    let a: PNCounter = pn_counter_new();
    let b: PNCounter = pn_counter_new();
    if (a).p0 != (b).p0 {
        println("FAIL pn_counter_new");
        process_exit(1);
    }
    println("prod_crdt_pn_counter: PASSED");
}
