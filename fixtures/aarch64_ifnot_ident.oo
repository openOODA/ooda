// # if !x is leftover
//
// Logline: BANG IDENT must fail closed and not emit YES or NO.
//
// Setup: x is a bind, not const true/false after bang.
//
// Beats:
//   1. Bind x to true.
//   2. if !x print YES else print NO.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = true;
    if !x {
        println("YES");
    } else {
        println("NO");
    }
}
