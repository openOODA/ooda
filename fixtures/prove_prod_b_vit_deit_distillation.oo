// # Product prove std/ai_multimodal/vit_deit_distillation.oo
//
// Logline: Fail-closed emit+gcc+run asserts vit_deit_distillation_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_deit_distillation.oo.
//
// Beats:
//   1. Call vit_deit_distillation_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vit_deit_distillation: PASSED only if they match.

import "std/ai_multimodal/vit_deit_distillation.oo";

pub fn main() {
    let a = vit_deit_distillation_marker();
    let b = vit_deit_distillation_marker();
    if a != b {
        println("FAIL vit_deit_distillation_marker");
        process_exit(1);
    }
    println("prod_vit_deit_distillation: PASSED");
}
