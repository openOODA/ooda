// # Product prove std/graph_gnn/graph_node2vec_random_walk.oo
//
// Logline: Fail-closed emit+gcc+run asserts node2vec_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_node2vec_random_walk.oo.
//
// Beats:
//   1. Call node2vec_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_node2vec_random_walk: PASSED only if they match.

import "std/graph_gnn/graph_node2vec_random_walk.oo";

pub fn main() {
    let graph_node2vec_random_walk_mark: Int = 0;
    if graph_node2vec_random_walk_mark != 0 {
        process_exit(1);
    }
    let a: Node2VecConfig = node2vec_config_new(0.0, 0.0, 0, 0);
    let b: Node2VecConfig = node2vec_config_new(0.0, 0.0, 0, 0);
    if (a).walk_length != (b).walk_length {
        println("FAIL node2vec_config_new");
        process_exit(1);
    }
    println("prod_g2_graph_node2vec_random_walk: PASSED");
}
