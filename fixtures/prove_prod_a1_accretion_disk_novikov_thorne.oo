// # Product prove std/astrophysics_relativity/accretion_disk_novikov_thorne.oo
//
// Logline: Fail-closed emit+gcc+run asserts kerr_isco_radius_rg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/accretion_disk_novikov_thorne.oo.
//
// Beats:
//   1. Call kerr_isco_radius_rg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_accretion_disk_novikov_thorne: PASSED only if they match.

import "std/astrophysics_relativity/accretion_disk_novikov_thorne.oo";

pub fn main() {
    let accretion_disk_novikov_thorne_mark: Int = 0;
    if accretion_disk_novikov_thorne_mark != 0 {
        process_exit(1);
    }
    let a: Int = kerr_isco_radius_rg(0);
    let b: Int = kerr_isco_radius_rg(0);
    if a != b {
        println("FAIL kerr_isco_radius_rg");
        process_exit(1);
    }
    println("prod_accretion_disk_novikov_thorne: PASSED");
}
