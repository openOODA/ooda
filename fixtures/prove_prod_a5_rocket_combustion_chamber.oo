// # Product prove std/space_propulsion/rocket_combustion_chamber.oo
//
// Logline: Fail-closed emit+gcc+run asserts combustion_hydrolox_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_combustion_chamber.oo.
//
// Beats:
//   1. Call combustion_hydrolox_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_combustion_chamber: PASSED only if they match.

import "std/space_propulsion/rocket_combustion_chamber.oo";

pub fn main() {
    let rocket_combustion_chamber_mark: Int = 0;
    if rocket_combustion_chamber_mark != 0 {
        process_exit(1);
    }
    let a: PropellantCombination = combustion_hydrolox_default();
    let b: PropellantCombination = combustion_hydrolox_default();
    if (a).prop_type != (b).prop_type {
        println("FAIL combustion_hydrolox_default");
        process_exit(1);
    }
    println("prod_rocket_combustion_chamber: PASSED");
}
