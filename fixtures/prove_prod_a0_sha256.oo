// # Product prove std/crypto/sha256.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha256 is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/sha256.oo.
//
// Beats:
//   1. Call sha256 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha256: PASSED only if they match.

import "std/crypto/sha256.oo";

pub fn main() {
    let a = sha256("x");
    let b = sha256("x");
    if a != b {
        println("FAIL sha256");
        process_exit(1);
    }
    println("prod_sha256: PASSED");
}
