// # Product prove std/formal_verif/taint_information_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts security_low is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/taint_information_flow.oo.
//
// Beats:
//   1. Call security_low twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_taint_information_flow: PASSED only if they match.

import "std/formal_verif/taint_information_flow.oo";

pub fn main() {
    let taint_information_flow_mark: Int = 0;
    if taint_information_flow_mark != 0 {
        process_exit(1);
    }
    let a: SecurityLevel = security_low();
    let b: SecurityLevel = security_low();
    if (a).level_id != (b).level_id {
        println("FAIL security_low");
        process_exit(1);
    }
    println("prod_taint_information_flow: PASSED");
}
