// # Product prove std/tui/tui_renderer.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_render_ansi_clear_screen holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/tui_renderer.oo.
//
// Beats:
//   1. Call tui_render_ansi_clear_screen using the tui_renderer ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_tui_renderer: PASSED only if asserts hold.

import "std/tui/tui_renderer.oo";
import "std/str.oo";

pub fn main() {
    let tui_renderer_a = tui_render_ansi_clear_screen();
    if chars_len(tui_renderer_a) != 13 {
        println("FAIL tui_render_ansi_clear_screen");
        process_exit(1);
    }
    if !str_contains(tui_renderer_a, "\x1b[2J\x1b[H") {
        println("FAIL tui_render_ansi_clear_screen");
        process_exit(1);
    }
    if !str_contains("\x1b[2J\x1b[H", tui_renderer_a) {
        println("FAIL tui_render_ansi_clear_screen");
        process_exit(1);
    }
    println("prod_tui_renderer: PASSED");
}
