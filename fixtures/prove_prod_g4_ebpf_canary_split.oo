// # Product prove std/mesh_ebpf/mesh_canary_traffic_splitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts canary traffic splitting, weighted routing, and header overrides are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_canary_traffic_splitter.oo.
//
// Beats:
//   1. Initialize canary traffic splitter and configure route.
//   2. Route requests across weighted seeds and explicit canary header overrides.
//   3. Assert deterministic cluster targets and distribution counters.
//   4. Print prod_g4_ebpf_canary_split: PASSED and exit 0.

import "std/mesh_ebpf/mesh_canary_traffic_splitter.oo";

pub fn main() {
    let mut state: CanarySplitterState = canary_splitter_new();
    canary_add_route(&mut state, "srv_v1", "srv_v2_canary", 20);

    let c_override: String = canary_select_cluster(&mut state, 0, 99, "always");
    if c_override != "srv_v2_canary" {
        println("FAIL canary header override");
        process_exit(1);
    }

    let c_canary: String = canary_select_cluster(&mut state, 0, 15, "none");
    if c_canary != "srv_v2_canary" {
        println("FAIL canary weighted seed");
        process_exit(1);
    }

    let c_base: String = canary_select_cluster(&mut state, 0, 50, "none");
    if c_base != "srv_v1" {
        println("FAIL baseline weighted seed");
        process_exit(1);
    }

    if (state).total_routed != 3 {
        println("FAIL canary total_routed");
        process_exit(1);
    }
    if (state).canary_routed != 2 {
        println("FAIL canary canary_routed");
        process_exit(1);
    }
    if (state).baseline_routed != 1 {
        println("FAIL canary baseline_routed");
        process_exit(1);
    }

    println("prod_g4_ebpf_canary_split: PASSED");
    process_exit(0);
}
