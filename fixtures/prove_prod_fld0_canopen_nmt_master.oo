// # Product prove std/iot_scada/canopen_nmt_master.oo
//
// Logline: Fail-closed emit+gcc+run asserts canopen_nmt_master_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/canopen_nmt_master.oo.
//
// Beats:
//   1. Call canopen_nmt_master_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_canopen_nmt_master: PASSED only if they match.

import "std/iot_scada/canopen_nmt_master.oo";

pub fn main() {
    let canopen_nmt_master_mark: Int = 0;
    if canopen_nmt_master_mark != 0 {
        process_exit(1);
    }
    let canopen_nmt_master_a: CanopenNmtMaster = canopen_nmt_master_new(1);
    let canopen_nmt_master_b: CanopenNmtMaster = canopen_nmt_master_new(1);
    if (canopen_nmt_master_a).command_specifier != (canopen_nmt_master_b).command_specifier {
        println("FAIL canopen_nmt_master_new");
        process_exit(1);
    }
    println("prod_canopen_nmt_master: PASSED");
}
