// # Product prove std/auto_mpc_control/projected_gradient_mpc.oo
//
// Logline: Fail-closed emit+gcc+run asserts projected_grad_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/projected_gradient_mpc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call projected_grad_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_projected_gradient_mpc: PASSED only if they match.

import "std/auto_mpc_control/projected_gradient_mpc.oo";

pub fn main() {
    let g2_oa: ProjectedGradConfig = projected_grad_config_default();
    let g2_ob: ProjectedGradConfig = projected_grad_config_default();
    let g2_a = (g2_oa).step_size;
    let g2_b = (g2_ob).step_size;
    if g2_a != g2_b {
        println("FAIL projected_grad_config_default.step_size");
        process_exit(1);
    }
    println("prod_g2_projected_gradient_mpc: PASSED");
}
