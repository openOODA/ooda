// # Product prove std/sec/crypto/secp256k1.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/secp256k1.oo.
//
// Beats:
//   1. Call shim_marker_checksum twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secp256k1: PASSED only if they match.

import "std/sec/crypto/secp256k1.oo";

pub fn main() {
    let secp256k1_mark: Int = 0;
    if secp256k1_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_checksum();
    let b: Int = shim_marker_checksum();
    if a != b { process_exit(1); }
    println("prod_secp256k1: PASSED");
}
