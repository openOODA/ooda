// # Product prove std/fintech_l3_book/l3_price_level_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts l3_price_level_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_price_level_queue.oo.
//
// Beats:
//   1. Call l3_price_level_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_price_level_queue: PASSED only if they match.

import "std/fintech_l3_book/l3_price_level_queue.oo";

pub fn main() {
    let l3_price_level_queue_mark: Int = 0;
    if l3_price_level_queue_mark != 0 {
        process_exit(1);
    }
    let a: L3PriceLevel = l3_price_level_new(0);
    let b: L3PriceLevel = l3_price_level_new(0);
    if (a).price_fixed != (b).price_fixed {
        println("FAIL l3_price_level_new");
        process_exit(1);
    }
    println("prod_g2_l3_price_level_queue: PASSED");
}
