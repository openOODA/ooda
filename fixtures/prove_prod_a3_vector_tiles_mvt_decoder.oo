// # Product prove std/gis_topo/vector_tiles_mvt_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts mvt_decode_zigzag is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/vector_tiles_mvt_decoder.oo.
//
// Beats:
//   1. Call mvt_decode_zigzag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_tiles_mvt_decoder: PASSED only if they match.

import "std/gis_topo/vector_tiles_mvt_decoder.oo";

pub fn main() {
    let vector_tiles_mvt_decoder_mark: Int = 0;
    if vector_tiles_mvt_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = mvt_decode_zigzag(0);
    let b: Int = mvt_decode_zigzag(0);
    if a != b {
        println("FAIL mvt_decode_zigzag");
        process_exit(1);
    }
    println("prod_vector_tiles_mvt_decoder: PASSED");
}
