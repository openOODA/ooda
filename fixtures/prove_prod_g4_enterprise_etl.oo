// # Product prove std/enterprise/etl.oo
//
// Logline: Fail-closed emit+gcc+run asserts ETL schema validation, record transforms, and batch execution.
//
// Setup: Isolated emit-c. Imports std/enterprise/etl.oo.
//
// Beats:
//   1. Construct source and target schemas with field definitions.
//   2. Create record, populate values, and assert schema conformance.
//   3. Define prefix transformation rule and apply to record fields.
//   4. Execute pipeline batch and verify end-to-end load stats and health.

import "std/enterprise/etl.oo";

pub fn main() {
    let f_id: EtlField = etl_field_create("id", 0, false, true);
    let f_user: EtlField = etl_field_create("username", 1, false, false);

    let mut src_sch: EtlSchema = etl_schema_create("src_users", 1);
    src_sch = etl_schema_add_field(src_sch, f_id);
    src_sch = etl_schema_add_field(src_sch, f_user);

    let u_idx: Int = etl_schema_find_field_index(&src_sch, "username");
    if u_idx != 1 {
        println("FAIL etl_schema_find_field_index");
        process_exit(1);
    }

    let mut rec: EtlRecord = etl_record_create(1, "src_users");
    rec = etl_record_add_value(rec, "1001");
    rec = etl_record_add_value(rec, "bob");

    let is_v: Bool = etl_record_validate(&rec, &src_sch);
    if is_v == false {
        println("FAIL etl_record_validate");
        process_exit(1);
    }

    let val_at_1: String = etl_record_get_value(&rec, 1);
    if val_at_1 != "bob" {
        println("FAIL etl_record_get_value");
        process_exit(1);
    }

    let rule: EtlTransformRule = etl_transform_rule_create(1, "username", "username", 2, "user_");
    let tf_val: String = etl_apply_transform_rule(&rule, "bob");
    if tf_val != "user_bob" {
        println("FAIL etl_apply_transform_rule");
        process_exit(1);
    }

    let cfg: EtlPipelineConfig = etl_pipeline_config_create("pipe_1", 10, 2, true, true, false);
    let mut pipe: EtlPipeline = etl_pipeline_create(cfg, src_sch, src_sch);
    etl_pipeline_add_rule(&mut pipe, rule);

    let ok_ext: Bool = etl_extract_record(&mut pipe, rec);
    if ok_ext == false {
        println("FAIL etl_extract_record");
        process_exit(1);
    }

    let ok_exec: Bool = etl_pipeline_execute_batch(&mut pipe);
    if ok_exec == false {
        println("FAIL etl_pipeline_execute_batch");
        process_exit(1);
    }

    let is_hl: Bool = etl_pipeline_is_healthy(&pipe);
    if is_hl == false {
        println("FAIL etl_pipeline_is_healthy");
        process_exit(1);
    }

    let stats: Int = etl_pipeline_get_stats(&pipe);
    if stats != 1 {
        println("FAIL etl_pipeline_get_stats");
        process_exit(1);
    }

    println("prod_g4_enterprise_etl: PASSED");
    process_exit(0);
}
