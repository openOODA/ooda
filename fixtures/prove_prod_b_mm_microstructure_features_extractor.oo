// # Product prove std/hft_alpha/mm_microstructure_features_extractor.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_microstructure_features_extractor_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_microstructure_features_extractor.oo.
//
// Beats:
//   1. Call mm_microstructure_features_extractor_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_microstructure_features_extractor: PASSED only if they match.

import "std/hft_alpha/mm_microstructure_features_extractor.oo";

pub fn main() {
    let a = mm_microstructure_features_extractor_probe();
    let b = mm_microstructure_features_extractor_probe();
    if a != b {
        println("FAIL mm_microstructure_features_extractor_probe");
        process_exit(1);
    }
    println("prod_mm_microstructure_features_extractor: PASSED");
}
