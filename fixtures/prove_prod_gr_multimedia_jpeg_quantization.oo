// # Product prove std/multimedia/jpeg_quantization.oo
//
// Logline: Fail-closed emit+gcc+run asserts jpeg_zigzag_index is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/jpeg_quantization.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call jpeg_zigzag_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_jpeg_quantization: PASSED only if they match.

import "std/multimedia/jpeg_quantization.oo";

pub fn main() {
    let g0_a = jpeg_zigzag_index(0);
    let g0_b = jpeg_zigzag_index(0);
    if g0_a != g0_b {
        println("FAIL jpeg_zigzag_index");
        process_exit(1);
    }
    println("prod_gr_jpeg_quantization: PASSED");
}
