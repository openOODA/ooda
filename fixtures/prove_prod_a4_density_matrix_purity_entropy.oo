// # Product prove std/quantum_open_systems/density_matrix_purity_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts density_purity_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/density_matrix_purity_entropy.oo.
//
// Beats:
//   1. Call density_purity_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_density_matrix_purity_entropy: PASSED only if they match.

import "std/quantum_open_systems/density_matrix_purity_entropy.oo";

pub fn main() {
    let density_matrix_purity_entropy_mark: Int = 0;
    if density_matrix_purity_entropy_mark != 0 {
        process_exit(1);
    }
    let a: Float = density_purity_eval(0.0, 0.0, 0.0, 0.0);
    let b: Float = density_purity_eval(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL density_purity_eval");
        process_exit(1);
    }
    println("prod_density_matrix_purity_entropy: PASSED");
}
