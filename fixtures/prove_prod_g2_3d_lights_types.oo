// # Product prove std/3d/lights_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_color_new is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/lights_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call light_color_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lights_types: PASSED only if they match.

import "std/3d/lights_types.oo";

pub fn main() {
    let g2_oa = light_color_new(2, 2, 2, 2);
    let g2_ob = light_color_new(2, 2, 2, 2);
    let g2_a = (g2_oa).r;
    let g2_b = (g2_ob).r;
    if g2_a != g2_b {
        println("FAIL light_color_new.r");
        process_exit(1);
    }
    println("prod_g2_lights_types: PASSED");
}
