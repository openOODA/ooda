// # Product prove std/3d/mesh_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector3_new is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/mesh_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call vector3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mesh_types: PASSED only if they match.

import "std/3d/mesh_types.oo";

pub fn main() {
    let g2_oa = vector3_new(2, 2, 2);
    let g2_ob = vector3_new(2, 2, 2);
    let g2_a = (g2_oa).x;
    let g2_b = (g2_ob).x;
    if g2_a != g2_b {
        println("FAIL vector3_new.x");
        process_exit(1);
    }
    println("prod_g2_mesh_types: PASSED");
}
