// # Match Ok and Err values
//
// Logline: Match Ok and Err literals and print each bound payload.
//
// Beats:
//   1. Match Ok("ok") and print the Ok string.
//   2. Match Err("bad") and print the Err string.
//   3. Both arms bind a string for println.

// M6: match Ok/Err value form (no Result return-type arrow in helpers)
pub fn main() {
    let a = match Ok("ok") {
        Ok(v) => v,
        Err(e) => e
    };
    println(a);
    let b = match Err("bad") {
        Ok(v) => v,
        Err(e) => e
    };
    println(b);
}
