// # Product prove std/zk_rollup/kzg10_trusted_setup.oo
//
// Logline: Fail-closed emit+gcc+run asserts srs_g1_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/kzg10_trusted_setup.oo.
//
// Beats:
//   1. Call srs_g1_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kzg10_trusted_setup: PASSED only if they match.

import "std/zk_rollup/kzg10_trusted_setup.oo";

pub fn main() {
    let kzg10_trusted_setup_mark: Int = 0;
    if kzg10_trusted_setup_mark != 0 {
        process_exit(1);
    }
    let a: SrsG1Point = srs_g1_point_new(0, 0, 0);
    let b: SrsG1Point = srs_g1_point_new(0, 0, 0);
    if (a).x_val != (b).x_val {
        println("FAIL srs_g1_point_new");
        process_exit(1);
    }
    println("prod_kzg10_trusted_setup: PASSED");
}
