// # Product prove std/fin/credit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts credit_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fin/credit_engine.oo.
//
// Beats:
//   1. Call credit_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_credit_engine: PASSED only if it matches.

import "std/fin/credit_engine.oo";
import "std/fin/credit_engine_compute.oo";
import "std/fin/credit_engine_assess.oo";

pub fn main() {
    let a: Int = credit_engine_probe();
    if a != 0 {
        println("FAIL credit_engine_probe");
        process_exit(1);
    }
    println("prod_nc_credit_engine: PASSED");
}
