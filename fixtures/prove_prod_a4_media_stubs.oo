// # Product prove std/multimedia/media_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts media_hw_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/media_stubs.oo.
//
// Beats:
//   1. Call media_hw_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_media_stubs: PASSED only if they match.

import "std/multimedia/media_stubs.oo";

pub fn main() {
    let media_stubs_mark: Int = 0;
    if media_stubs_mark != 0 {
        process_exit(1);
    }
    let a: MediaHwCapabilities = media_hw_probe();
    let b: MediaHwCapabilities = media_hw_probe();
    if (a).has_vaapi != (b).has_vaapi {
        println("FAIL media_hw_probe");
        process_exit(1);
    }
    println("prod_media_stubs: PASSED");
}
