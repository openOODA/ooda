// # Product prove std/sec/crypto/blake3_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts blake3_key_sum is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/blake3_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call blake3_key_sum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_blake3_types: PASSED only if they match.

import "std/sec/crypto/blake3_types.oo";

pub fn main() {
    let g0_oa = blake3_key_new(2, 2, 2);
    let g0_ob = blake3_key_new(2, 2, 2);
    let g0_a = blake3_key_sum(g0_oa);
    let g0_b = blake3_key_sum(g0_ob);
    if g0_a != g0_b {
        println("FAIL blake3_key_sum");
        process_exit(1);
    }
    println("prod_g0_blake3_types: PASSED");
}
