// # Product prove std/edge/inference_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts inference_pipeline_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_pipeline.oo.
//
// Beats:
//   1. Call inference_pipeline_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_inference_pipeline: PASSED only if they match.

import "std/edge/inference_pipeline.oo";

pub fn main() {
    let a: Int = inference_pipeline_probe();
    let b: Int = inference_pipeline_probe();
    if a != b {
        println("FAIL inference_pipeline_probe");
        process_exit(1);
    }
    println("prod_g2_inference_pipeline: PASSED");
}
