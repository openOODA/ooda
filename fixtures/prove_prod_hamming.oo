// # Product Hamming distance prove
//
// Logline: Fail-closed emit+gcc+run of shipped hamming_distance_str.
//
// Setup: Product std/text/hamming_distance.oo. Wikipedia karolin/kathrin.
//
// Beats:
//   1. hamming_distance_str karolin kathrin is 3.
//   2. Length mismatch is Err.
//   3. Exit 1 before PASSED on a miss.
//
// Backend-C lowers Result[Int, String] as string payload (oo_int_to_str).

import "std/text/hamming_distance.oo";

pub fn main() {
    let r: Result[Int, String] = hamming_distance_str("karolin", "kathrin");
    if r.is_err() {
        println("FAIL hamming err");
        process_exit(1);
    }
    let d: String = r.unwrap();
    if d != "3" {
        println("FAIL hamming 3");
        process_exit(1);
    }
    let bad: Result[Int, String] = hamming_distance_str("ab", "a");
    if bad.is_err() == false {
        println("FAIL hamming length");
        process_exit(1);
    }
    println("prod_hamming: PASSED");
}
