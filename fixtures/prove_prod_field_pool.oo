// # Product prove &T list field and bang field
//
// Logline: Fail-closed emit+gcc+run of list_get((p).nodes) and !(p).off on &Pool.
//
// Setup: Isolated emit-c. Item/Pool/Node local. Destub none. No caps.
//
// Beats:
//   1. head_k(&pool) is 7 from list_get((p).nodes, 0).k.
//   2. is_on(&pool) is true from !(p).off.
//   3. Node { id: 1, kids: List[Node] } id is 1 (complete pool type).
//   4. Exit 1 on miss. Print prod_field_pool: PASSED only if all hold.

type Item = struct {
    k: Int
};

type Pool = struct {
    nodes: List[Item],
    off: Bool
};

type Node = struct {
    id: Int,
    kids: List[Node]
};

fn head_k(p: &Pool) -> Int {
    return list_get((p).nodes, 0).k;
}

fn is_on(p: &Pool) -> Bool {
    return !(p).off;
}

pub fn main() {
    let mut ns: List[Item] = list_new();
    let it: Item = Item { k: 7 };
    ns = list_push(ns, it);
    let pool: Pool = Pool { nodes: ns, off: false };
    let hk: Int = head_k(&pool);
    if hk != 7 {
        println("FAIL head_k");
        process_exit(1);
    }
    if !is_on(&pool) {
        println("FAIL is_on");
        process_exit(1);
    }
    let kids: List[Node] = list_new();
    let leaf: Node = Node { id: 1, kids: kids };
    if leaf.id != 1 {
        println("FAIL leaf id");
        process_exit(1);
    }
    if list_len(leaf.kids) != 0 {
        println("FAIL leaf kids");
        process_exit(1);
    }
    println("prod_field_pool: PASSED");
}
