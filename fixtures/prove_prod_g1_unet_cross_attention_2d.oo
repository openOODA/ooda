// # Product prove std/ai_multimodal/unet_cross_attention_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts unet_cross_attention_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_cross_attention_2d.oo.
//
// Beats:
//   1. Call unet_cross_attention_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_unet_cross_attention_2d: PASSED only if they match.

import "std/ai_multimodal/unet_cross_attention_2d.oo";

pub fn main() {
    let a: UNetCrossAttentionConfig = unet_cross_attention_config_new(0, 0, 0, 0);
    let b: UNetCrossAttentionConfig = unet_cross_attention_config_new(0, 0, 0, 0);
    if a.query_dim != b.query_dim {
        println("FAIL unet_cross_attention_config_new");
        process_exit(1);
    }
    println("prod_unet_cross_attention_2d: PASSED");
}
