// # Product prove std/gis_spatial/spatial_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/spatial_envelope.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/spatial_envelope.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_spatial_envelope: PASSED only if they match.

import "std/gis_spatial/spatial_envelope.oo";

pub fn main() {
    let spatial_envelope_a = envelope2d_empty();
    let spatial_envelope_b = envelope2d_empty();
    let spatial_envelope_va = envelope2d_contains_point(spatial_envelope_a, 0.0, 0.0);
    let spatial_envelope_vb = envelope2d_contains_point(spatial_envelope_b, 0.0, 0.0);
    if spatial_envelope_va != spatial_envelope_vb {
        println("FAIL spatial_envelope");
        process_exit(1);
    }
    println("prod_ap_spatial_envelope: PASSED");
}
