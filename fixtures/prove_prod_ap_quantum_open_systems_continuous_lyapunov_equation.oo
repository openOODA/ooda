// # Product prove std/quantum_open_systems/continuous_lyapunov_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/continuous_lyapunov_equation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/continuous_lyapunov_equation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_continuous_lyapunov_equation: PASSED only if they match.

import "std/quantum_open_systems/continuous_lyapunov_equation.oo";

pub fn main() {
    let continuous_lyapunov_equation_a = matrix2x2_real_new(0.0, 0.0, 0.0, 0.0);
    let continuous_lyapunov_equation_b = matrix2x2_real_new(0.0, 0.0, 0.0, 0.0);
    let continuous_lyapunov_equation_va = lyapunov_uncertainty_satisfied(continuous_lyapunov_equation_a);
    let continuous_lyapunov_equation_vb = lyapunov_uncertainty_satisfied(continuous_lyapunov_equation_b);
    if continuous_lyapunov_equation_va != continuous_lyapunov_equation_vb {
        println("FAIL continuous_lyapunov_equation");
        process_exit(1);
    }
    println("prod_ap_continuous_lyapunov_equation: PASSED");
}
