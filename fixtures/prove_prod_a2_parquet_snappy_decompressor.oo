// # Product prove std/db_columnar/parquet_snappy_decompressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts snappy_parse_varint_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_snappy_decompressor.oo.
//
// Beats:
//   1. Call snappy_parse_varint_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_snappy_decompressor: PASSED only if they match.

import "std/db_columnar/parquet_snappy_decompressor.oo";

pub fn main() {
    let parquet_snappy_decompressor_mark: Int = 0;
    if parquet_snappy_decompressor_mark != 0 {
        process_exit(1);
    }
    let a: Int = snappy_parse_varint_len(list_new());
    let b: Int = snappy_parse_varint_len(list_new());
    if a != b {
        println("FAIL snappy_parse_varint_len");
        process_exit(1);
    }
    println("prod_parquet_snappy_decompressor: PASSED");
}
