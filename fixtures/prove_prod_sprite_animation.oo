// # Product prove std/game_engine/sprite_animation.oo
//
// Logline: Fail-closed emit+gcc+run asserts anim_loop_mode_loop real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/sprite_animation.oo.
//
// Beats:
//   1. Call anim_loop_mode_loop with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_sprite_animation: PASSED only if the assert holds.

import "std/game_engine/sprite_animation.oo";

pub fn main() {
    let sprite_animation_mark: Int = 0;
    if sprite_animation_mark != 0 {
        process_exit(1);
    }
    let sprite_animation_n: Int = anim_loop_mode_loop();
    if sprite_animation_n != 0 {
        println("FAIL anim_loop_mode_loop");
        process_exit(1);
    }
    println("prod_sprite_animation: PASSED");
}
