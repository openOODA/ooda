// # Product bilinear interp prove
//
// Logline: Fail-closed emit+gcc+run of shipped bilinear_interp.
//
// Setup: Product std/math/interpolation_bilinear.oo. Bottom edge 0 to 2 at u=0.5 is 1.
//
// Beats:
//   1. bilinear_interp(0,2,0,2, 0.5, 0) is 1.0.
//   2. bilinear_interp(0,0,2,2, 0, 0.5) is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/interpolation_bilinear.oo";

pub fn main() {
    let a: Float = bilinear_interp(0.0, 2.0, 0.0, 2.0, 0.5, 0.0);
    if a != 1.0 {
        println("FAIL bilinear u");
        process_exit(1);
    }
    let b: Float = bilinear_interp(0.0, 0.0, 2.0, 2.0, 0.0, 0.5);
    if b != 1.0 {
        println("FAIL bilinear v");
        process_exit(1);
    }
    println("prod_bilinear: PASSED");
}
