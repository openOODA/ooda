// # Product prove std/diag/tracer_span.oo
//
// Logline: Fail-closed emit+gcc+run asserts trace_span_duration is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/tracer_span.oo.
//
// Beats:
//   1. Call trace_span_duration twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tracer_span: PASSED only if they match.

import "std/diag/tracer_span.oo";

pub fn main() {
    let obj = trace_span_new("x", "x", "x", 0);
    let a = trace_span_duration(obj);
    let b = trace_span_duration(obj);
    if a != b {
        println("FAIL trace_span_duration");
        process_exit(1);
    }
    println("prod_tracer_span: PASSED");
}
