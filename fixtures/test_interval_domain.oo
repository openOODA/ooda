// # Interval Domain Test Fixture
//
// Logline: Fail-closed emit+gcc+run covering constructor, arithmetic, ordering, and subset semantics on the interval domain.
//
// Setup: Imports std/formal_verif/interval_domain.oo; tests run entirely in main() without helper struct scopes.
//
// Beats:
//   1. Verify interval_new accepts (0, 10) and rejects (10, 0).
//   2. Verify interval_contains for in-range, above, and below cases.
//   3. Verify interval_add([0,5], [2,3]) == [2,8].
//   4. Verify interval_sub([5,10], [2,3]) == [2,8].
//   5. Verify interval_subset for proper inclusion and rejection.
//   6. Prove [0, n-1] subset [0, capacity-1] across several index/buffer pairs.
//   7. Verify interval_overlaps true on [0,5]/[3,7] and false on [0,2]/[3,5].

import "std/formal_verif/interval_domain.oo";

pub fn main() {
    // Test 1: interval_new accepts (0, 10); rejects (10, 0).
    let t1a: Result[Interval, String] = interval_new(0, 10);
    if !t1a.is_ok() {
        println("FAIL T1 interval_new(0, 10) not ok");
        process_exit(1);
    }
    let t1b: Result[Interval, String] = interval_new(10, 0);
    if !t1b.is_err() {
        println("FAIL T1 interval_new(10, 0) not err");
        process_exit(1);
    }

    // Test 2: interval_contains with three values on [0, 10].
    let t2_iv: Result[Interval, String] = interval_new(0, 10);
    let t2_iv_v: Interval = match t2_iv {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_contains(t2_iv_v, 5) {
        println("FAIL T2 contains 5");
        process_exit(1);
    }
    if interval_contains(t2_iv_v, 11) {
        println("FAIL T2 contains 11");
        process_exit(1);
    }
    if interval_contains(t2_iv_v, -1) {
        println("FAIL T2 contains -1");
        process_exit(1);
    }

    // Test 3: interval_add([0,5], [2,3]) == [2,8].
    let t3a_a: Result[Interval, String] = interval_new(0, 5);
    let t3a_b: Result[Interval, String] = interval_new(2, 3);
    let t3a_iv_a: Interval = match t3a_a {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t3a_iv_b: Interval = match t3a_b {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t3_sum: Result[Interval, String] = interval_add(t3a_iv_a, t3a_iv_b);
    let t3_iv_sum: Interval = match t3_sum {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t3_exp: Result[Interval, String] = interval_new(2, 8);
    let t3_iv_exp: Interval = match t3_exp {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_eq(t3_iv_sum, t3_iv_exp) {
        println("FAIL T3 add");
        process_exit(1);
    }

    // Test 4: interval_sub([5,10], [2,3]) == [2,8].
    let t4a: Result[Interval, String] = interval_new(5, 10);
    let t4b: Result[Interval, String] = interval_new(2, 3);
    let t4a_iv: Interval = match t4a {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t4b_iv: Interval = match t4b {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t4_diff: Result[Interval, String] = interval_sub(t4a_iv, t4b_iv);
    let t4_iv_diff: Interval = match t4_diff {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t4_exp: Result[Interval, String] = interval_new(2, 8);
    let t4_iv_exp: Interval = match t4_exp {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_eq(t4_iv_diff, t4_iv_exp) {
        println("FAIL T4 sub");
        process_exit(1);
    }

    // Test 5: interval_subset proper inclusion both directions.
    let t5_inner: Result[Interval, String] = interval_new(2, 5);
    let t5_outer: Result[Interval, String] = interval_new(0, 10);
    let t5_in: Interval = match t5_inner {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t5_out: Interval = match t5_outer {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_subset(t5_in, t5_out) {
        println("FAIL T5 subset inner outer");
        process_exit(1);
    }
    if interval_subset(t5_out, t5_in) {
        println("FAIL T5 subset outer inner");
        process_exit(1);
    }

    // Test 6: [0, n-1] subset [0, capacity-1] for various n, capacity.
    let t6_n1: Result[Interval, String] = interval_new(0, 9);
    let t6_c1: Result[Interval, String] = interval_new(0, 99);
    let t6_in1: Interval = match t6_n1 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t6_out1: Interval = match t6_c1 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_subset(t6_in1, t6_out1) {
        println("FAIL T6 [0,9] subset [0,99]");
        process_exit(1);
    }
    let t6_n2: Result[Interval, String] = interval_new(0, 0);
    let t6_c2: Result[Interval, String] = interval_new(0, 0);
    let t6_in2: Interval = match t6_n2 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t6_out2: Interval = match t6_c2 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_subset(t6_in2, t6_out2) {
        println("FAIL T6 [0,0] subset [0,0]");
        process_exit(1);
    }
    let t6_n3: Result[Interval, String] = interval_new(0, 4);
    let t6_c3: Result[Interval, String] = interval_new(0, 7);
    let t6_in3: Interval = match t6_n3 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t6_out3: Interval = match t6_c3 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_subset(t6_in3, t6_out3) {
        println("FAIL T6 [0,4] subset [0,7]");
        process_exit(1);
    }

    // Test 7: interval_overlaps true on [0,5]/[3,7] and false on [0,2]/[3,5].
    let t7_a: Result[Interval, String] = interval_new(0, 5);
    let t7_b: Result[Interval, String] = interval_new(3, 7);
    let t7_iv_a: Interval = match t7_a {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t7_iv_b: Interval = match t7_b {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_overlaps(t7_iv_a, t7_iv_b) {
        println("FAIL T7 overlaps [0,5] [3,7]");
        process_exit(1);
    }
    let t7_c: Result[Interval, String] = interval_new(0, 2);
    let t7_d: Result[Interval, String] = interval_new(3, 5);
    let t7_iv_c: Interval = match t7_c {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t7_iv_d: Interval = match t7_d {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if interval_overlaps(t7_iv_c, t7_iv_d) {
        println("FAIL T7 overlaps [0,2] [3,5]");
        process_exit(1);
    }

    // Test 8: interval_mul handles negative ranges. interval_mul([-3, -1], [2, 5]) == [-15, -2].
    let t8a: Result[Interval, String] = interval_new(-3, -1);
    let t8b: Result[Interval, String] = interval_new(2, 5);
    let t8a_iv: Interval = match t8a {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8b_iv: Interval = match t8b {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8_prod: Result[Interval, String] = interval_mul(t8a_iv, t8b_iv);
    let t8_iv_prod: Interval = match t8_prod {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8_exp: Result[Interval, String] = interval_new(-15, -2);
    let t8_iv_exp: Interval = match t8_exp {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_eq(t8_iv_prod, t8_iv_exp) {
        println("FAIL T8 mul [-3,-1] x [2,5] != [-15,-2]");
        process_exit(1);
    }
    // interval_mul([-3, 3], [-2, 2]) == [-6, 6] (mixed signs).
    let t8c: Result[Interval, String] = interval_new(-3, 3);
    let t8d: Result[Interval, String] = interval_new(-2, 2);
    let t8c_iv: Interval = match t8c {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8d_iv: Interval = match t8d {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8_prod2: Result[Interval, String] = interval_mul(t8c_iv, t8d_iv);
    let t8_iv_prod2: Interval = match t8_prod2 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    let t8_exp2: Result[Interval, String] = interval_new(-6, 6);
    let t8_iv_exp2: Interval = match t8_exp2 {
        Ok(v) => v,
        Err(_) => Interval { min_val: 0, max_val: 0 }
    };
    if !interval_eq(t8_iv_prod2, t8_iv_exp2) {
        println("FAIL T8 mul [-3,3] x [-2,2] != [-6,6]");
        process_exit(1);
    }

    println("test_interval_domain: PASSED");
}
