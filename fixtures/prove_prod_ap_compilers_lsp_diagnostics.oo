// # Product prove std/compilers/lsp_diagnostics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/lsp_diagnostics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_diagnostics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lsp_diagnostics: PASSED only if they match.

import "std/compilers/lsp_diagnostics.oo";

pub fn main() {
    let lsp_diagnostics_a = lsp_diag_severity_error();
    let lsp_diagnostics_b = lsp_diag_severity_error();
    if lsp_diagnostics_a != lsp_diagnostics_b {
        println("FAIL lsp_diagnostics");
        process_exit(1);
    }
    println("prod_ap_lsp_diagnostics: PASSED");
}
