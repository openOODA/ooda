// # Product prove std/formal_verif/abstract_congruence_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts gcd is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_congruence_domain.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gcd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abstract_congruence_domain: PASSED only if they match.

import "std/formal_verif/abstract_congruence_domain.oo";

pub fn main() {
    let g2_a = gcd(2, 2);
    let g2_b = gcd(2, 2);
    if g2_a != g2_b {
        println("FAIL gcd");
        process_exit(1);
    }
    println("prod_g2_abstract_congruence_domain: PASSED");
}
