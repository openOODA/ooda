// # Product prove std/satellite_dvb/satellite_transponder_saleh.oo
//
// Logline: Fail-closed emit+gcc+run asserts saleh_am_am_gain is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_transponder_saleh.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call saleh_am_am_gain twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_transponder_saleh: PASSED only if they match.

import "std/satellite_dvb/satellite_transponder_saleh.oo";

pub fn main() {
    let g2_oa: SalehHpaModel = SalehHpaModel { alpha_a: 1.0, // AM/AM linear scale factor (typically 1.0 .. 2.0)
    beta_a: 1.0, // AM/AM compression factor (typically 0.5 .. 1.0)
    alpha_p: 1.0, // AM/PM conversion coefficient (typically 2.0 .. 4.0 rad)
    beta_p: 1.0, // AM/PM saturation factor (typically 0.5 .. 1.5)
    input_backoff_db: 1.0 };
    let g2_ob: SalehHpaModel = SalehHpaModel { alpha_a: 1.0, // AM/AM linear scale factor (typically 1.0 .. 2.0)
    beta_a: 1.0, // AM/AM compression factor (typically 0.5 .. 1.0)
    alpha_p: 1.0, // AM/PM conversion coefficient (typically 2.0 .. 4.0 rad)
    beta_p: 1.0, // AM/PM saturation factor (typically 0.5 .. 1.5)
    input_backoff_db: 1.0 };
    let g2_a = saleh_am_am_gain(&g2_oa, 1.0);
    let g2_b = saleh_am_am_gain(&g2_ob, 1.0);
    if g2_a != g2_b {
        println("FAIL saleh_am_am_gain");
        process_exit(1);
    }
    println("prod_g2_satellite_transponder_saleh: PASSED");
}
