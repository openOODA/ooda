// # Product prove std/net/websocket.oo
//
// Logline: Fail-closed emit+gcc+run asserts websocket_make_handshake is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/websocket.oo.
//
// Beats:
//   1. Call websocket_make_handshake twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_websocket: PASSED only if they match.

import "std/net/websocket.oo";

pub fn main() {
    let a = websocket_make_handshake("x", "x", "x");
    let b = websocket_make_handshake("x", "x", "x");
    if a != b {
        println("FAIL websocket_make_handshake");
        process_exit(1);
    }
    println("prod_websocket: PASSED");
}
