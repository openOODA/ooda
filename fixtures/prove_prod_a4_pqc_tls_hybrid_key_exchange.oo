// # Product prove std/pqc_nist/pqc_tls_hybrid_key_exchange.oo
//
// Logline: Fail-closed emit+gcc+run asserts tls_group_x25519_mlkem768 is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_tls_hybrid_key_exchange.oo.
//
// Beats:
//   1. Call tls_group_x25519_mlkem768 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pqc_tls_hybrid_key_exchange: PASSED only if they match.

import "std/pqc_nist/pqc_tls_hybrid_key_exchange.oo";

pub fn main() {
    let pqc_tls_hybrid_key_exchange_mark: Int = 0;
    if pqc_tls_hybrid_key_exchange_mark != 0 {
        process_exit(1);
    }
    let a: TlsPqNamedGroup = tls_group_x25519_mlkem768();
    let b: TlsPqNamedGroup = tls_group_x25519_mlkem768();
    if (a).group_id != (b).group_id {
        println("FAIL tls_group_x25519_mlkem768");
        process_exit(1);
    }
    println("prod_pqc_tls_hybrid_key_exchange: PASSED");
}
