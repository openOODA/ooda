// # Product prove std/sec/rlimit.oo
//
// Logline: Fail-closed emit+gcc+run asserts rlimit_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/rlimit.oo.
//
// Beats:
//   1. Call rlimit_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_rlimit: PASSED only if it matches.

import "std/sec/rlimit.oo";

pub fn main() {
    let a: Int = rlimit_probe();
    if a != 0 {
        println("FAIL rlimit_probe");
        process_exit(1);
    }
    println("prod_nc_rlimit: PASSED");
}
