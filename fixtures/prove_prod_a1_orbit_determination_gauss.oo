// # Product prove std/astro_advanced/orbit_determination_gauss.oo
//
// Logline: Fail-closed emit+gcc+run asserts od_gauss_obs is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/orbit_determination_gauss.oo.
//
// Beats:
//   1. Call od_gauss_obs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbit_determination_gauss: PASSED only if they match.

import "std/astro_advanced/orbit_determination_gauss.oo";

pub fn main() {
    let orbit_determination_gauss_mark: Int = 0;
    if orbit_determination_gauss_mark != 0 {
        process_exit(1);
    }
    let a: Int = od_gauss_obs();
    let b: Int = od_gauss_obs();
    if a != b {
        println("FAIL od_gauss_obs");
        process_exit(1);
    }
    println("prod_orbit_determination_gauss: PASSED");
}
