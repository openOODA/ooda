// # Leftover println ident is not a string literal
//
// Logline: Side emit-aarch64 must ERR leftover println and not emit a silent omit.
//
// Setup: message is a call, not a string let. Greet fold stays residual.
//
// Beats:
//   1. main binds message from foo.
//   2. println(message) is not a string-literal let.
//   3. foo returns nope.

pub fn main() {
    let message = foo();
    println(message);
}

fn foo() -> String { return "nope"; }
