// # Product prove std/scicomp/dual_quaternion.oo
//
// Logline: Fail-closed emit+gcc+run asserts dual_quat_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/dual_quaternion.oo.
//
// Beats:
//   1. Call dual_quat_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dual_quaternion: PASSED only if they match.

import "std/scicomp/dual_quaternion.oo";

pub fn main() {
    let dual_quaternion_mark: Int = 0;
    if dual_quaternion_mark != 0 {
        process_exit(1);
    }
    let a: DualQuaternion = dual_quat_identity();
    let b: DualQuaternion = dual_quat_identity();
    if (a).r_w != (b).r_w {
        println("FAIL dual_quat_identity");
        process_exit(1);
    }
    println("prod_g2_dual_quaternion: PASSED");
}
