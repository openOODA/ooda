// # Prove Pure Runtime Helpers Fixture
//
// Logline: Verification fixture for pure standard library runtime formatting, math intrinsics, and capability checking.
//
// Setup: Comprehensive unit test suite covering std/runtime modules without external C runtime dependencies.
//
// Beats:
//   1. Verify string formatting, integer/float conversion, splitting, trimming, and padding.
//   2. Verify fast trigonometric, logarithm, exponential, power, and square root approximations.
//   3. Verify capability token creation, domain validation, permission masking, and sandboxing checks.
//   4. Print pure_runtime_helpers: PASSED on success.

import "std/runtime/rt_str_format.oo";
import "std/runtime/rt_math_intrinsics.oo";
import "std/runtime/rt_caps_check.oo";

pub fn main() {
    // 1. String formatting & conversion verification
    let s_dec: String = int_to_str(12345);
    if s_dec != "12345" { println("FAIL: int_to_str"); process_exit(1); }

    let s_hex: String = int_to_hex(255, true);
    if s_hex != "FF" { println("FAIL: int_to_hex"); process_exit(1); }

    let s_bin: String = int_to_bin(10);
    if s_bin != "1010" { println("FAIL: int_to_bin"); process_exit(1); }

    let s_pad_l: String = pad_left("42", 5, "0");
    if s_pad_l != "00042" { println("FAIL: pad_left"); process_exit(1); }

    let s_pad_r: String = pad_right("hi", 4, "!");
    if s_pad_r != "hi!!" { println("FAIL: pad_right"); process_exit(1); }

    let s_fmt_int: String = format_int(7, 3, true);
    if s_fmt_int != "007" { println("FAIL: format_int"); process_exit(1); }

    let s_fmt_flt: String = format_float(12.3456, 2);
    if s_fmt_flt != "12.34" { println("FAIL: format_float"); process_exit(1); }

    let s_trimmed: String = rt_str_trim("  \t hello world \n ");
    if s_trimmed != "hello world" { println("FAIL: rt_str_trim"); process_exit(1); }

    let b_start: Bool = rt_str_starts_with("openOODA", "open");
    if !b_start { println("FAIL: rt_str_starts_with"); process_exit(1); }

    let b_end: Bool = rt_str_ends_with("openOODA", "OODA");
    if !b_end { println("FAIL: rt_str_ends_with"); process_exit(1); }

    let idx_found: Int = rt_str_index_of("hello openOODA", "open");
    if idx_found != 6 { println("FAIL: rt_str_index_of"); process_exit(1); }

    let s_rep: String = rt_str_repeat("ab", 3);
    if s_rep != "ababab" { println("FAIL: rt_str_repeat"); process_exit(1); }

    let parts: List[String] = rt_str_split("alpha,beta,gamma", ",");
    if list_len(parts) != 3 { println("FAIL: rt_str_split len"); process_exit(1); }
    if list_get(parts, 0) != "alpha" { println("FAIL: rt_str_split item 0"); process_exit(1); }
    if list_get(parts, 1) != "beta" { println("FAIL: rt_str_split item 1"); process_exit(1); }
    if list_get(parts, 2) != "gamma" { println("FAIL: rt_str_split item 2"); process_exit(1); }

    // 2. Math intrinsics verification
    let abs_val: Float = fast_abs(0.0 - 5.5);
    if abs_val != 5.5 { println("FAIL: fast_abs"); process_exit(1); }

    let clamped: Float = fast_clamp(10.0, 0.0, 5.0);
    if clamped != 5.0 { println("FAIL: fast_clamp"); process_exit(1); }

    let sin_0: Float = fast_sin(0.0);
    if fast_abs(sin_0) > 0.0001 { println("FAIL: fast_sin 0"); process_exit(1); }

    let sin_half_pi: Float = fast_sin(math_half_pi());
    if fast_abs(sin_half_pi - 1.0) > 0.001 { println("FAIL: fast_sin half_pi"); process_exit(1); }

    let cos_0: Float = fast_cos(0.0);
    if fast_abs(cos_0 - 1.0) > 0.001 { println("FAIL: fast_cos 0"); process_exit(1); }

    let tan_0: Float = fast_tan(0.0);
    if fast_abs(tan_0) > 0.0001 { println("FAIL: fast_tan 0"); process_exit(1); }

    let atan_1: Float = fast_atan(1.0);
    let exp_atan: Float = math_pi() / 4.0;
    if fast_abs(atan_1 - exp_atan) > 0.005 { println("FAIL: fast_atan 1.0"); process_exit(1); }

    let atan2_val: Float = fast_atan2(1.0, 1.0);
    if fast_abs(atan2_val - exp_atan) > 0.005 { println("FAIL: fast_atan2"); process_exit(1); }

    let exp_0: Float = fast_exp(0.0);
    if fast_abs(exp_0 - 1.0) > 0.001 { println("FAIL: fast_exp 0"); process_exit(1); }

    let exp_1: Float = fast_exp(1.0);
    if fast_abs(exp_1 - math_e()) > 0.01 { println("FAIL: fast_exp 1"); process_exit(1); }

    let ln_1: Float = fast_ln(1.0);
    if fast_abs(ln_1) > 0.001 { println("FAIL: fast_ln 1"); process_exit(1); }

    let ln_e: Float = fast_ln(math_e());
    if fast_abs(ln_e - 1.0) > 0.01 { println("FAIL: fast_ln e"); process_exit(1); }

    let log2_8: Float = fast_log2(8.0);
    if fast_abs(log2_8 - 3.0) > 0.02 { println("FAIL: fast_log2 8"); process_exit(1); }

    let log10_100: Float = fast_log10(100.0);
    if fast_abs(log10_100 - 2.0) > 0.02 { println("FAIL: fast_log10 100"); process_exit(1); }

    let pow_2_3: Float = fast_pow(2.0, 3.0);
    if fast_abs(pow_2_3 - 8.0) > 0.05 { println("FAIL: fast_pow 2^3"); process_exit(1); }

    let sqrt_9: Float = fast_sqrt(9.0);
    if fast_abs(sqrt_9 - 3.0) > 0.001 { println("FAIL: fast_sqrt 9"); process_exit(1); }

    let inv_sqrt_4: Float = fast_inv_sqrt(4.0);
    if fast_abs(inv_sqrt_4 - 0.5) > 0.001 { println("FAIL: fast_inv_sqrt 4"); process_exit(1); }

    // 3. Capability checking verification
    let p_rw: Int = cap_mask_combine(cap_perm_read(), cap_perm_write());
    let tok: CapToken = cap_token_new(cap_domain_fs(), p_rw, 999);

    if !cap_token_is_valid(tok) { println("FAIL: cap_token_is_valid"); process_exit(1); }
    if !cap_token_has_domain(tok, cap_domain_fs()) { println("FAIL: cap_token_has_domain fs"); process_exit(1); }
    if !cap_token_has_domain(tok, cap_domain_fsread()) { println("FAIL: cap_token_has_domain fsread"); process_exit(1); }
    if !cap_token_has_perm(tok, cap_perm_read()) { println("FAIL: cap_token_has_perm read"); process_exit(1); }
    if !cap_token_has_perm(tok, cap_perm_write()) { println("FAIL: cap_token_has_perm write"); process_exit(1); }
    if cap_token_has_perm(tok, cap_perm_exec()) { println("FAIL: cap_token_has_perm exec should be false"); process_exit(1); }

    if !cap_token_check(tok, cap_domain_fs(), cap_perm_read()) { println("FAIL: cap_token_check fs read"); process_exit(1); }

    let tok_ro: CapToken = cap_token_restrict(tok, cap_perm_read());
    if !cap_token_has_perm(tok_ro, cap_perm_read()) { println("FAIL: tok_ro read"); process_exit(1); }
    if cap_token_has_perm(tok_ro, cap_perm_write()) { println("FAIL: tok_ro write should be false"); process_exit(1); }

    let tok_rev: CapToken = cap_token_revoke(tok);
    if cap_token_is_valid(tok_rev) { println("FAIL: tok_rev is_valid should be false"); process_exit(1); }

    let m_comb: Int = cap_mask_combine(cap_perm_read(), cap_perm_admin());
    if !cap_mask_has(m_comb, cap_perm_read()) { println("FAIL: cap_mask_has read"); process_exit(1); }
    if !cap_mask_has(m_comb, cap_perm_admin()) { println("FAIL: cap_mask_has admin"); process_exit(1); }

    let m_rem: Int = cap_mask_remove(m_comb, cap_perm_read());
    if cap_mask_has(m_rem, cap_perm_read()) { println("FAIL: cap_mask_remove read"); process_exit(1); }
    if !cap_mask_has(m_rem, cap_perm_admin()) { println("FAIL: cap_mask_remove retain admin"); process_exit(1); }

    let dom_name: String = cap_domain_name(cap_domain_fs());
    if dom_name != "fs" { println("FAIL: cap_domain_name"); process_exit(1); }

    let perm_name: String = cap_perm_name(cap_perm_read());
    if perm_name != "read" { println("FAIL: cap_perm_name"); process_exit(1); }

    let b_sandbox: Bool = cap_sandbox_verify(tok, "read_config", cap_domain_fs(), cap_perm_read());
    if !b_sandbox { println("FAIL: cap_sandbox_verify"); process_exit(1); }

    println("pure_runtime_helpers: PASSED");
}
