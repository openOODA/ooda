// # Product stack prove
//
// Logline: Fail-closed emit+gcc+run of shipped stack_push/peek/pop.
//
// Setup: Product std/collections/stack.oo. LIFO a then b. Needs emit-c field retain.
//
// Beats:
//   1. After push a then b, peek is b.
//   2. After pop, peek is a.
//   3. Exit 1 before PASSED on a miss.

import "std/collections/stack.oo";

pub fn main() {
    let s0: Stack = stack_new();
    let s1: Stack = stack_push(s0, "a");
    let s2: Stack = stack_push(s1, "b");
    let n: Int = stack_len(s2);
    if n != 2 {
        println("FAIL stack len");
        process_exit(1);
    }
    let p1: Result[String, String] = stack_peek(s2);
    if p1.is_err() {
        println("FAIL stack peek err");
        process_exit(1);
    }
    let top: String = p1.unwrap();
    if top != "b" {
        println("FAIL stack peek b");
        process_exit(1);
    }
    let s3: Stack = stack_pop(s2);
    let p2: Result[String, String] = stack_peek(s3);
    if p2.is_err() {
        println("FAIL stack peek2 err");
        process_exit(1);
    }
    let a: String = p2.unwrap();
    if a != "a" {
        println("FAIL stack peek a");
        process_exit(1);
    }
    println("prod_stack: PASSED");
}
