// # Product prove std/physics_advanced/compressible_fanno_rayleigh_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts fanno_evaluate_state is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_fanno_rayleigh_flow.oo.
//
// Beats:
//   1. Call fanno_evaluate_state twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compressible_fanno_rayleigh_flow: PASSED only if they match.

import "std/physics_advanced/compressible_fanno_rayleigh_flow.oo";

pub fn main() {
    let compressible_fanno_rayleigh_flow_mark: Int = 0;
    if compressible_fanno_rayleigh_flow_mark != 0 {
        process_exit(1);
    }
    let a: FannoState = fanno_evaluate_state(0.0, 0.0);
    let b: FannoState = fanno_evaluate_state(0.0, 0.0);
    if (a).mach != (b).mach {
        println("FAIL fanno_evaluate_state");
        process_exit(1);
    }
    println("prod_compressible_fanno_rayleigh_flow: PASSED");
}
