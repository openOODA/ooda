// # Product prove std/markup/yaml.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/yaml.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/yaml.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_yaml: PASSED only if they match.

import "std/markup/yaml.oo";

pub fn main() {
    let yaml_a = yaml_parse("x");
    let yaml_b = yaml_parse("x");
    if yaml_a.is_ok() != yaml_b.is_ok() {
        println("FAIL yaml");
        process_exit(1);
    }
    println("prod_ap_yaml: PASSED");
}
