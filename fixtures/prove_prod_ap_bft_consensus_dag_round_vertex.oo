// # Product prove std/bft_consensus/dag_round_vertex.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/dag_round_vertex.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_round_vertex.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dag_round_vertex: PASSED only if they match.

import "std/bft_consensus/dag_round_vertex.oo";

pub fn main() {
    let dag_round_vertex_a = dag_vertex_is_monotonic_child(0, 0);
    let dag_round_vertex_b = dag_vertex_is_monotonic_child(0, 0);
    if dag_round_vertex_a != dag_round_vertex_b {
        println("FAIL dag_round_vertex");
        process_exit(1);
    }
    println("prod_ap_dag_round_vertex: PASSED");
}
