// # Product prove std/compilers_vm/regalloc_spill_placement.oo
//
// Logline: Fail-closed emit+gcc+run asserts align_up is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_spill_placement.oo.
//
// Beats:
//   1. Call align_up twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regalloc_spill_placement: PASSED only if they match.

import "std/compilers_vm/regalloc_spill_placement.oo";

pub fn main() {
    let regalloc_spill_placement_mark: Int = 0;
    if regalloc_spill_placement_mark != 0 {
        process_exit(1);
    }
    let a: Int = align_up(0, 0);
    let b: Int = align_up(0, 0);
    if a != b {
        println("FAIL align_up");
        process_exit(1);
    }
    println("prod_regalloc_spill_placement: PASSED");
}
