// # Product prove std/telecom_5g/mimo_zero_forcing_precoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_zf_pseudo_inverse_denom is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_zero_forcing_precoder.oo.
//
// Beats:
//   1. Call mimo_zf_pseudo_inverse_denom twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimo_zero_forcing_precoder: PASSED only if they match.

import "std/telecom_5g/mimo_zero_forcing_precoder.oo";

pub fn main() {
    let mimo_zero_forcing_precoder_mark: Int = 0;
    if mimo_zero_forcing_precoder_mark != 0 {
        process_exit(1);
    }
    let a: Float = mimo_zf_pseudo_inverse_denom(0.0, 0.0, 0.0, 0.0);
    let b: Float = mimo_zf_pseudo_inverse_denom(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL mimo_zf_pseudo_inverse_denom");
        process_exit(1);
    }
    println("prod_mimo_zero_forcing_precoder: PASSED");
}
