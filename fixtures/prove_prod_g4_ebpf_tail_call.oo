// # Product prove std/mesh_ebpf/ebpf_tail_call_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts eBPF tail call pipeline dispatching and depth bounding are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_tail_call_pipeline.oo.
//
// Beats:
//   1. Initialize tail call pipeline and register stages.
//   2. Dispatch pipeline jumps across registered stage indices.
//   3. Assert deterministic program file descriptors, depth increments, and reset behavior.
//   4. Print prod_g4_ebpf_tail_call: PASSED and exit 0.

import "std/mesh_ebpf/ebpf_tail_call_pipeline.oo";

pub fn main() {
    let mut pipe: TailCallPipeline = tail_call_pipeline_new();
    tail_call_register_stage(&mut pipe, 0, "ingress_filter", 10, 1);
    tail_call_register_stage(&mut pipe, 1, "conntrack_lookup", 11, 1);

    let fd0: Int = tail_call_dispatch(&mut pipe, 0);
    if fd0 != 10 {
        println("FAIL tail_call_dispatch 0");
        process_exit(1);
    }
    if (pipe).current_depth != 1 {
        println("FAIL tail_call depth after 0");
        process_exit(1);
    }

    let fd1: Int = tail_call_dispatch(&mut pipe, 1);
    if fd1 != 11 {
        println("FAIL tail_call_dispatch 1");
        process_exit(1);
    }
    if (pipe).current_depth != 2 {
        println("FAIL tail_call depth after 1");
        process_exit(1);
    }

    let fd_miss: Int = tail_call_dispatch(&mut pipe, 99);
    if fd_miss != 0 - 2 {
        println("FAIL tail_call_dispatch miss");
        process_exit(1);
    }

    tail_call_reset_depth(&mut pipe);
    if (pipe).current_depth != 0 {
        println("FAIL tail_call_reset_depth");
        process_exit(1);
    }

    if (pipe).total_dispatched != 2 {
        println("FAIL tail_call total_dispatched");
        process_exit(1);
    }

    println("prod_g4_ebpf_tail_call: PASSED");
    process_exit(0);
}
