// # Product prove std/embedded_hal/riscv_csr.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/riscv_csr.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/riscv_csr.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_riscv_csr: PASSED only if they match.

import "std/embedded_hal/riscv_csr.oo";

pub fn main() {
    let riscv_csr_a = riscv_csr_init();
    let riscv_csr_b = riscv_csr_init();
    let riscv_csr_va = riscv_csr_read(riscv_csr_a, 0);
    let riscv_csr_vb = riscv_csr_read(riscv_csr_b, 0);
    if riscv_csr_va != riscv_csr_vb {
        println("FAIL riscv_csr");
        process_exit(1);
    }
    println("prod_ap_riscv_csr: PASSED");
}
