// # Product prove std/synthetic_biology/ribozyme_cleavage_kinetics.oo
//
// Logline: Fail-closed emit+gcc+run asserts ribozyme_math_exp_neg real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/ribozyme_cleavage_kinetics.oo.
//
// Beats:
//   1. Call ribozyme_math_exp_neg with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_ribozyme_cleavage_kinetics: PASSED only if the assert holds.

import "std/synthetic_biology/ribozyme_cleavage_kinetics.oo";

pub fn main() {
    let ribozyme_cleavage_kinetics_n: Float = ribozyme_math_exp_neg(12.0);
    if !(ribozyme_cleavage_kinetics_n == 0.000006) {
        println("FAIL ribozyme_math_exp_neg");
        process_exit(1);
    }
    println("prod_ribozyme_cleavage_kinetics: PASSED");
}
