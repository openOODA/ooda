// # Product prove std/robotics_ros2/ros2_topic_publisher.oo
//
// Logline: Fail-closed emit+gcc+run asserts topic_qos_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_topic_publisher.oo.
//
// Beats:
//   1. Call topic_qos_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ros2_topic_publisher: PASSED only if they match.

import "std/robotics_ros2/ros2_topic_publisher.oo";

pub fn main() {
    let ros2_topic_publisher_mark: Int = 0;
    if ros2_topic_publisher_mark != 0 {
        process_exit(1);
    }
    let a: TopicQos = topic_qos_default();
    let b: TopicQos = topic_qos_default();
    if (a).reliability != (b).reliability {
        println("FAIL topic_qos_default");
        process_exit(1);
    }
    println("prod_g2_ros2_topic_publisher: PASSED");
}
