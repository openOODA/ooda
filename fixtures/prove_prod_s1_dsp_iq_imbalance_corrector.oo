// # Product prove std/telecom_5g/dsp_iq_imbalance_corrector.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_iq_calc_irr_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_iq_imbalance_corrector.oo.
//
// Beats:
//   1. Call dsp_iq_calc_irr_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_iq_imbalance_corrector: PASSED only if they match.

import "std/telecom_5g/dsp_iq_imbalance_corrector.oo";

pub fn main() {
    let dsp_iq_imbalance_corrector_mark: Int = 0;
    if dsp_iq_imbalance_corrector_mark != 0 {
        process_exit(1);
    }
    let dsp_iq_imbalance_corrector_a: Float = dsp_iq_calc_irr_db(1.0, 1.0);
    let dsp_iq_imbalance_corrector_b: Float = dsp_iq_calc_irr_db(1.0, 1.0);
    if dsp_iq_imbalance_corrector_a != dsp_iq_imbalance_corrector_b {
        println("FAIL dsp_iq_calc_irr_db");
        process_exit(1);
    }
    println("prod_dsp_iq_imbalance_corrector: PASSED");
}
