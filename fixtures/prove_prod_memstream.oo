// # Product mem_stream prove
//
// Logline: Fail-closed emit+gcc+run of shipped mem_stream_from_string/len/seek.
//
// Setup: Product std/io/mem_stream.oo. Seed "hi".
//
// Beats:
//   1. from_string hi len 2; seek 1 then read_pos 1.
//   2. Exit 1 before PASSED on a miss.

import "std/io/mem_stream.oo";

pub fn main() {
    let mut s: MemStream = mem_stream_from_string("hi");
    let n: Int = mem_stream_len(s);
    if n != 2 {
        println("FAIL memstream len");
        process_exit(1);
    }
    s = mem_stream_seek_read(s, 1);
    let p: Int = s.read_pos;
    if p != 1 {
        println("FAIL memstream seek");
        process_exit(1);
    }
    println("prod_memstream: PASSED");
}
