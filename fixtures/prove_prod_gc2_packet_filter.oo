// # Product prove std/net_telemetry/packet_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts packet_filter_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/packet_filter.oo.
//
// Beats:
//   1. Call packet_filter_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_packet_filter: PASSED only if they match.

import "std/net_telemetry/packet_filter.oo";

pub fn main() {
    let packet_filter_mark: Int = 0;
    if packet_filter_mark != 0 {
        process_exit(1);
    }
    let packet_filter_a = packet_filter_engine_new("x");
    let packet_filter_b = packet_filter_engine_new("x");
    if (packet_filter_a).total_evaluated != (packet_filter_b).total_evaluated {
        println("FAIL packet_filter_engine_new");
        process_exit(1);
    }
    println("prod_packet_filter: PASSED");
}
