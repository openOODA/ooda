// # Product prove std/ai_ml/tensor_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/tensor_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tensor_engine: PASSED only if they match.

import "std/ai_ml/tensor_engine.oo";

pub fn main() {
    let tensor_engine_a = pseudo_rand_lcg(0);
    let tensor_engine_b = pseudo_rand_lcg(0);
    if tensor_engine_a != tensor_engine_b {
        println("FAIL tensor_engine");
        process_exit(1);
    }
    println("prod_ap_tensor_engine: PASSED");
}
