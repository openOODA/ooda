// # Product prove std/aero/tvc_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts tvc_abs_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_types.oo.
//
// Beats:
//   1. Call tvc_abs_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tvc_types: PASSED only if they match.

import "std/aero/tvc_types.oo";

pub fn main() {
    let a = tvc_abs_milli(0);
    let b = tvc_abs_milli(0);
    if a != b {
        println("FAIL tvc_abs_milli");
        process_exit(1);
    }
    println("prod_tvc_types: PASSED");
}
