// # Product prove std/quantum_topological/topological_braid_group_bn.oo
//
// Logline: Fail-closed emit+gcc+run asserts Artin Braid Group B_N generators, relations, and commutation checks are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_braid_group_bn.oo.
//
// Beats:
//   1. Construct BraidGenerator instances for generators and inverses.
//   2. Create BraidGroupElement and append generators.
//   3. Test far commutation relation (|i - j| >= 2) and adjacent cancellation relation.
//   4. Print prod_g4_quantum_braid: PASSED and exit 0.

import "std/quantum_topological/topological_braid_group_bn.oo";

pub fn main() {
    let s1: BraidGenerator = braid_generator_new(1, 0);
    let s1_inv: BraidGenerator = braid_generator_new(1, 1);
    let s2: BraidGenerator = braid_generator_new(2, 0);
    let s3: BraidGenerator = braid_generator_new(3, 0);

    if (s1).index != 1 || (s1).is_inverse != 0 || (s1_inv).is_inverse != 1 {
        println("FAIL braid_generator_new");
        process_exit(1);
    }

    let mut b_elem: BraidGroupElement = braid_group_element_new(4);
    if (b_elem).num_strands_n != 4 || (b_elem).word_length != 0 {
        println("FAIL braid_group_element_new");
        process_exit(1);
    }

    braid_group_append(&mut b_elem, s1);
    braid_group_append(&mut b_elem, s3);
    if (b_elem).word_length != 2 {
        println("FAIL braid_group_append");
        process_exit(1);
    }

    let comm_1_3: Int = braid_generators_commute(&s1, &s3);
    let comm_1_2: Int = braid_generators_commute(&s1, &s2);
    if comm_1_3 != 1 || comm_1_2 != 0 {
        println("FAIL braid_generators_commute");
        process_exit(1);
    }

    let cancel_ok: Int = braid_cancels_adjacent(&s1, &s1_inv);
    let cancel_no: Int = braid_cancels_adjacent(&s1, &s2);
    if cancel_ok != 1 || cancel_no != 0 {
        println("FAIL braid_cancels_adjacent");
        process_exit(1);
    }

    println("prod_g4_quantum_braid: PASSED");
    process_exit(0);
}
