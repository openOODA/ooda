// # Product unicode_norm prove
//
// Logline: Fail-closed emit+gcc+run of shipped unicode_is_ascii / unicode_strip_diacritics.
//
// Setup: Product std/text/unicode_norm.oo. ASCII check and Latin-1 strip.
//
// Beats:
//   1. "ab" is ASCII.
//   2. strip of "cafe" (no marks) stays cafe.
//   3. Exit 1 before PASSED on a miss.

import "std/text/unicode_norm.oo";

pub fn main() {
    let a: Bool = unicode_is_ascii("ab");
    if a == false {
        println("FAIL uninorm ascii");
        process_exit(1);
    }
    let s: String = unicode_strip_diacritics("cafe");
    if s != "cafe" {
        println("FAIL uninorm strip");
        process_exit(1);
    }
    println("prod_uninorm: PASSED");
}
