// # Product prove std/db_storage/mvcc_serializable_ssi.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/mvcc_serializable_ssi.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_serializable_ssi.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mvcc_serializable_ssi: PASSED only if they match.

import "std/db_storage/mvcc_serializable_ssi.oo";

pub fn main() {
    let mvcc_serializable_ssi_a = ssi_tracker_new();
    let mvcc_serializable_ssi_b = ssi_tracker_new();
    let mvcc_serializable_ssi_va = ssi_is_dangerous_structure(mvcc_serializable_ssi_a, 0);
    let mvcc_serializable_ssi_vb = ssi_is_dangerous_structure(mvcc_serializable_ssi_b, 0);
    if mvcc_serializable_ssi_va != mvcc_serializable_ssi_vb {
        println("FAIL mvcc_serializable_ssi");
        process_exit(1);
    }
    println("prod_ap_mvcc_serializable_ssi: PASSED");
}
