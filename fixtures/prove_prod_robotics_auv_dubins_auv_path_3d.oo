// # Product prove std/robotics_auv/dubins_auv_path_3d.oo
//
// Logline: Fail-closed emit+check asserts dubins_solve_rsr is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/dubins_auv_path_3d.oo.
//
// Beats:
//   1. Call dubins_solve_rsr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dubins_auv_path_3d: PASSED only if they match.

import "std/robotics_auv/dubins_auv_path_3d.oo";

pub fn main() {
    let dubins_auv_path_3d_mark: Int = 0;
    if dubins_auv_path_3d_mark != 0 { process_exit(1); }
    let a: Float = dubins_solve_rsr(1.0, 1.0, 0.0, 0.0, 1.0);
    let b: Float = dubins_solve_rsr(1.0, 1.0, 0.0, 0.0, 1.0);
    if a != b { process_exit(1); }
    println("prod_dubins_auv_path_3d: PASSED");
}
