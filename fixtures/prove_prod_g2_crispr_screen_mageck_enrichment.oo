// # Product prove std/crispr_cas/crispr_screen_mageck_enrichment.oo
//
// Logline: Fail-closed emit+gcc+run asserts mageck_calc_lfc is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_screen_mageck_enrichment.oo.
//
// Beats:
//   1. Call mageck_calc_lfc twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_screen_mageck_enrichment: PASSED only if they match.

import "std/crispr_cas/crispr_screen_mageck_enrichment.oo";

pub fn main() {
    let crispr_screen_mageck_enrichment_mark: Int = 0;
    if crispr_screen_mageck_enrichment_mark != 0 {
        process_exit(1);
    }
    let a: Float = mageck_calc_lfc(0.0, 0.0);
    let b: Float = mageck_calc_lfc(0.0, 0.0);
    if a != b {
        println("FAIL mageck_calc_lfc");
        process_exit(1);
    }
    println("prod_g2_crispr_screen_mageck_enrichment: PASSED");
}
