// # Product prove std/sec/sys/elf_security.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_security_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_security.oo.
//
// Beats:
//   1. Call elf_security_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_elf_security: PASSED only if it matches.

import "std/sec/sys/elf_security.oo";

pub fn main() {
    let a: Int = elf_security_probe();
    if a != 0 {
        println("FAIL elf_security_probe");
        process_exit(1);
    }
    println("prod_nc_elf_security: PASSED");
}
