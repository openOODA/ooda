// # Product prove std/zk_rollup/stark_execution_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/stark_execution_trace.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_execution_trace.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_stark_execution_trace: PASSED only if they match.

import "std/zk_rollup/stark_execution_trace.oo";

pub fn main() {
    let stark_execution_trace_a = stark_trace_table_new(0, 0);
    let stark_execution_trace_b = stark_trace_table_new(0, 0);
    if stark_execution_trace_a.num_rows != stark_execution_trace_b.num_rows {
        println("FAIL stark_execution_trace");
        process_exit(1);
    }
    println("prod_ap_stark_execution_trace: PASSED");
}
