// # Product prove std/grid/wind.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_farm_capacity holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/wind.oo.
//
// Beats:
//   1. Call shim_marker_farm_capacity using the wind ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_wind: PASSED only if asserts hold.

import "std/grid/wind.oo";

pub fn main() {
    let wind_a = shim_marker_farm_capacity();
    let wind_b = shim_marker_farm_capacity();
    if wind_a != wind_b {
        println("FAIL shim_marker_farm_capacity");
        process_exit(1);
    }
    println("prod_wind: PASSED");
}
