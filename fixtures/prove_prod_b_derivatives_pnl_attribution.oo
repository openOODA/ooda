// # Product prove std/defi_derivatives/derivatives_pnl_attribution.oo
//
// Logline: Fail-closed emit+gcc+run asserts derivatives_pnl_attribution_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/derivatives_pnl_attribution.oo.
//
// Beats:
//   1. Call derivatives_pnl_attribution_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_derivatives_pnl_attribution: PASSED only if they match.

import "std/defi_derivatives/derivatives_pnl_attribution.oo";

pub fn main() {
    let a = derivatives_pnl_attribution_probe();
    let b = derivatives_pnl_attribution_probe();
    if a != b {
        println("FAIL derivatives_pnl_attribution_probe");
        process_exit(1);
    }
    println("prod_derivatives_pnl_attribution: PASSED");
}
