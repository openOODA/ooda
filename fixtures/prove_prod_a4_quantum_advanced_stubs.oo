// # Product prove std/quantum_advanced/quantum_advanced_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts advanced_quantum_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_advanced_stubs.oo.
//
// Beats:
//   1. Call advanced_quantum_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_advanced_stubs: PASSED only if they match.

import "std/quantum_advanced/quantum_advanced_stubs.oo";

pub fn main() {
    let quantum_advanced_stubs_mark: Int = 0;
    if quantum_advanced_stubs_mark != 0 {
        process_exit(1);
    }
    let a: AdvancedQuantumCapabilities = advanced_quantum_capabilities_default();
    let b: AdvancedQuantumCapabilities = advanced_quantum_capabilities_default();
    if (a).max_physical_qubits != (b).max_physical_qubits {
        println("FAIL advanced_quantum_capabilities_default");
        process_exit(1);
    }
    println("prod_quantum_advanced_stubs: PASSED");
}
