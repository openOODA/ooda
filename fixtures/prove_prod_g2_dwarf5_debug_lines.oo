// # Product prove std/compilers_vm/dwarf5_debug_lines.oo
//
// Logline: Fail-closed emit+gcc+run asserts line_matrix_row_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/dwarf5_debug_lines.oo.
//
// Beats:
//   1. Call line_matrix_row_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dwarf5_debug_lines: PASSED only if they match.

import "std/compilers_vm/dwarf5_debug_lines.oo";

pub fn main() {
    let dwarf5_debug_lines_mark: Int = 0;
    if dwarf5_debug_lines_mark != 0 {
        process_exit(1);
    }
    let a: LineMatrixRow = line_matrix_row_new(0, 0, 0, 0);
    let b: LineMatrixRow = line_matrix_row_new(0, 0, 0, 0);
    if (a).address != (b).address {
        println("FAIL line_matrix_row_new");
        process_exit(1);
    }
    println("prod_g2_dwarf5_debug_lines: PASSED");
}
