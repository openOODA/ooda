// # Product prove std/satellite_dvb/satellite_itu_p618_rain.oo
//
// Logline: Fail-closed emit+gcc+run asserts rain_calc_specific_attenuation_db_km is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_itu_p618_rain.oo.
//
// Beats:
//   1. Call rain_calc_specific_attenuation_db_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_itu_p618_rain: PASSED only if they match.

import "std/satellite_dvb/satellite_itu_p618_rain.oo";

pub fn main() {
    let satellite_itu_p618_rain_mark: Int = 0;
    if satellite_itu_p618_rain_mark != 0 {
        process_exit(1);
    }
    let a: Float = rain_calc_specific_attenuation_db_km(0.0, 0.0);
    let b: Float = rain_calc_specific_attenuation_db_km(0.0, 0.0);
    if a != b {
        println("FAIL rain_calc_specific_attenuation_db_km");
        process_exit(1);
    }
    println("prod_g2_satellite_itu_p618_rain: PASSED");
}
