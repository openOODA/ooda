// # Product prove std/bio/smiles_engine.oo
//
// Logline: Fail-closed verification that chemical fingerprint and similarity algorithms are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_engine.oo.
//
// Beats:
//   1. Create chemical fingerprints and set specific bits.
//   2. Calculate Tanimoto and Dice similarity coefficients.
//   3. Assert identical fingerprints yield 100 percent similarity.
//   4. Print prod_g4_bio_smiles_engine: PASSED and exit 0.

import "std/bio/smiles_engine.oo";

pub fn main() {
    let fp1: Fingerprint = fingerprint_create_empty(32, "ECFP4");
    let fp2: Fingerprint = fingerprint_create_empty(32, "ECFP4");
    let s1: Fingerprint = fingerprint_set_bit(fp1, 5);
    let s2: Fingerprint = fingerprint_set_bit(fp2, 5);

    let has1: Bool = fingerprint_has_bit(s1, 5);
    let has2: Bool = fingerprint_has_bit(s2, 5);
    if !has1 || !has2 {
        println("FAIL fingerprint_has_bit");
        process_exit(1);
    }

    let tan: Int = fingerprint_tanimoto_similarity(s1, s2);
    if tan != 100 {
        println("FAIL fingerprint_tanimoto_similarity");
        process_exit(1);
    }

    let dice: Int = fingerprint_dice_similarity(s1, s2);
    if dice != 100 {
        println("FAIL fingerprint_dice_similarity");
        process_exit(1);
    }

    println("prod_g4_bio_smiles_engine: PASSED");
    process_exit(0);
}
