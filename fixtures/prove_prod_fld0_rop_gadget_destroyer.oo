// # Product prove std/security_defense/rop_gadget_destroyer.oo
//
// Logline: Fail-closed emit+gcc+run asserts bytecode_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/rop_gadget_destroyer.oo.
//
// Beats:
//   1. Call bytecode_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rop_gadget_destroyer: PASSED only if they match.

import "std/security_defense/rop_gadget_destroyer.oo";

pub fn main() {
    let rop_gadget_destroyer_mark: Int = 0;
    if rop_gadget_destroyer_mark != 0 {
        process_exit(1);
    }
    let rop_gadget_destroyer_a: BytecodeBuffer = bytecode_buffer_new();
    let rop_gadget_destroyer_b: BytecodeBuffer = bytecode_buffer_new();
    if (rop_gadget_destroyer_a).length != (rop_gadget_destroyer_b).length {
        println("FAIL bytecode_buffer_new");
        process_exit(1);
    }
    println("prod_rop_gadget_destroyer: PASSED");
}
