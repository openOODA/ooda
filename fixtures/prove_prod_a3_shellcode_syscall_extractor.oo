// # Product prove std/exploit_analysis/shellcode_syscall_extractor.oo
//
// Logline: Fail-closed emit+gcc+run asserts syscall_name_x86_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/shellcode_syscall_extractor.oo.
//
// Beats:
//   1. Call syscall_name_x86_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shellcode_syscall_extractor: PASSED only if they match.

import "std/exploit_analysis/shellcode_syscall_extractor.oo";

pub fn main() {
    let shellcode_syscall_extractor_mark: Int = 0;
    if shellcode_syscall_extractor_mark != 0 {
        process_exit(1);
    }
    let a: String = syscall_name_x86_64(0);
    let b: String = syscall_name_x86_64(0);
    if a != b {
        println("FAIL syscall_name_x86_64");
        process_exit(1);
    }
    println("prod_shellcode_syscall_extractor: PASSED");
}
