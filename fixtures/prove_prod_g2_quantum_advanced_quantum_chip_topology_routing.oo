// # Product prove std/quantum_advanced/quantum_chip_topology_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts chip_linear is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_chip_topology_routing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call chip_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_chip_topology_routing: PASSED only if they match.

import "std/quantum_advanced/quantum_chip_topology_routing.oo";

pub fn main() {
    let g2_oa: ChipTopologyType = chip_linear();
    let g2_ob: ChipTopologyType = chip_linear();
    let g2_a = (g2_oa).mode;
    let g2_b = (g2_ob).mode;
    if g2_a != g2_b {
        println("FAIL chip_linear.mode");
        process_exit(1);
    }
    println("prod_g2_quantum_chip_topology_routing: PASSED");
}
