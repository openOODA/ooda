// # Product prove std/auto_robot/emergency_brake_ttc.oo
//
// Logline: Fail-closed emit+gcc+run asserts ttc_quot is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/emergency_brake_ttc.oo.
//
// Beats:
//   1. Call ttc_quot twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_emergency_brake_ttc: PASSED only if they match.

import "std/auto_robot/emergency_brake_ttc.oo";

pub fn main() {
    let emergency_brake_ttc_mark: Int = 0;
    if emergency_brake_ttc_mark != 0 {
        process_exit(1);
    }
    let a: Int = ttc_quot(0, 0);
    let b: Int = ttc_quot(0, 0);
    if a != b {
        println("FAIL ttc_quot");
        process_exit(1);
    }
    println("prod_emergency_brake_ttc: PASSED");
}
