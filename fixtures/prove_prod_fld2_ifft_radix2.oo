// # Product prove std/telecom/ifft_radix2.oo
//
// Logline: Fail-closed emit+gcc+run asserts ifft_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/ifft_radix2.oo.
//
// Beats:
//   1. Call ifft_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ifft_radix2: PASSED only if they match.

import "std/telecom/ifft_radix2.oo";

pub fn main() {
    let ifft_radix2_mark: Int = 0;
    if ifft_radix2_mark != 0 {
        process_exit(1);
    }
    let ifft_radix2_a: Float = ifft_pi();
    let ifft_radix2_b: Float = ifft_pi();
    if ifft_radix2_a != ifft_radix2_b {
        println("FAIL ifft_pi");
        process_exit(1);
    }
    println("prod_ifft_radix2: PASSED");
}
