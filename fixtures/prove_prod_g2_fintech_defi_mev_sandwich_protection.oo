// # Product prove std/fintech_defi/mev_sandwich_protection.oo
//
// Logline: Fail-closed emit+gcc+run asserts mev_evaluate_sandwich_risk is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/mev_sandwich_protection.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mev_evaluate_sandwich_risk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mev_sandwich_protection: PASSED only if they match.

import "std/fintech_defi/mev_sandwich_protection.oo";

pub fn main() {
    let g2_oa: SandwichRiskProfile = mev_evaluate_sandwich_risk(2, 2, 2, 2);
    let g2_ob: SandwichRiskProfile = mev_evaluate_sandwich_risk(2, 2, 2, 2);
    let g2_a = (g2_oa).victim_amount_in;
    let g2_b = (g2_ob).victim_amount_in;
    if g2_a != g2_b {
        println("FAIL mev_evaluate_sandwich_risk.victim_amount_in");
        process_exit(1);
    }
    println("prod_g2_mev_sandwich_protection: PASSED");
}
