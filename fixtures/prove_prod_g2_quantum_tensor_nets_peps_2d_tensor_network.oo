// # Product prove std/quantum_tensor_nets/peps_2d_tensor_network.oo
//
// Logline: Fail-closed emit+gcc+run asserts peps_node_entry_5d_new is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_2d_tensor_network.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call peps_node_entry_5d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_peps_2d_tensor_network: PASSED only if they match.

import "std/quantum_tensor_nets/peps_2d_tensor_network.oo";

pub fn main() {
    let g2_oa: PepsNodeEntry5D = peps_node_entry_5d_new(2, 2, 2, 2, 2, 1.0);
    let g2_ob: PepsNodeEntry5D = peps_node_entry_5d_new(2, 2, 2, 2, 2, 1.0);
    let g2_a = (g2_oa).phys;
    let g2_b = (g2_ob).phys;
    if g2_a != g2_b {
        println("FAIL peps_node_entry_5d_new.phys");
        process_exit(1);
    }
    println("prod_g2_peps_2d_tensor_network: PASSED");
}
