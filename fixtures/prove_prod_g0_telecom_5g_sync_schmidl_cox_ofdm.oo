// # Product prove std/telecom_5g/sync_schmidl_cox_ofdm.oo
//
// Logline: Fail-closed emit+gcc+run asserts sync_schmidl_cox_metric is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_schmidl_cox_ofdm.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sync_schmidl_cox_metric twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_sync_schmidl_cox_ofdm: PASSED only if they match.

import "std/telecom_5g/sync_schmidl_cox_ofdm.oo";

pub fn main() {
    let g0_a = sync_schmidl_cox_metric(1.0, 1.0, 1.0);
    let g0_b = sync_schmidl_cox_metric(1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL sync_schmidl_cox_metric");
        process_exit(1);
    }
    println("prod_g0_sync_schmidl_cox_ofdm: PASSED");
}
