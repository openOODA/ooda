// # Product prove std/embedded_hal/usb_device_hid.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/usb_device_hid.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/usb_device_hid.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_usb_device_hid: PASSED only if they match.

import "std/embedded_hal/usb_device_hid.oo";

pub fn main() {
    let usb_device_hid_a = usb_hid_keyboard_report_new();
    let usb_device_hid_b = usb_hid_keyboard_report_new();
    if usb_device_hid_a.modifier_keys != usb_device_hid_b.modifier_keys {
        println("FAIL usb_device_hid");
        process_exit(1);
    }
    println("prod_ap_usb_device_hid: PASSED");
}
