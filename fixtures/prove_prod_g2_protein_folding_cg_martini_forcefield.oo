// # Product prove std/protein_folding/cg_martini_forcefield.oo
//
// Logline: Fail-closed emit+gcc+run asserts martini_calc_epsilon is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_martini_forcefield.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call martini_calc_epsilon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cg_martini_forcefield: PASSED only if they match.

import "std/protein_folding/cg_martini_forcefield.oo";

pub fn main() {
    let g2_a = martini_calc_epsilon(2);
    let g2_b = martini_calc_epsilon(2);
    if g2_a != g2_b {
        println("FAIL martini_calc_epsilon");
        process_exit(1);
    }
    println("prod_g2_cg_martini_forcefield: PASSED");
}
