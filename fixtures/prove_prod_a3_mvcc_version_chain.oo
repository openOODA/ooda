// # Product prove std/db_storage/mvcc_version_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts mvcc_tuple_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_version_chain.oo.
//
// Beats:
//   1. Call mvcc_tuple_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_version_chain: PASSED only if they match.

import "std/db_storage/mvcc_version_chain.oo";

pub fn main() {
    let mvcc_version_chain_mark: Int = 0;
    if mvcc_version_chain_mark != 0 {
        process_exit(1);
    }
    let a: MvccTupleHeader = mvcc_tuple_header_new(0);
    let b: MvccTupleHeader = mvcc_tuple_header_new(0);
    if (a).xmin != (b).xmin {
        println("FAIL mvcc_tuple_header_new");
        process_exit(1);
    }
    println("prod_mvcc_version_chain: PASSED");
}
