// # Product prove std/quantum_tensor_nets/peps_simple_update.oo
//
// Logline: Fail-closed emit+gcc+run asserts simple_update_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_simple_update.oo.
//
// Beats:
//   1. Call simple_update_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_peps_simple_update: PASSED only if they match.

import "std/quantum_tensor_nets/peps_simple_update.oo";

pub fn main() {
    let a: SimpleUpdateConfig = simple_update_config_default(0.0, 0);
    let b: SimpleUpdateConfig = simple_update_config_default(0.0, 0);
    if a.max_steps != b.max_steps {
        println("FAIL simple_update_config_default");
        process_exit(1);
    }
    println("prod_peps_simple_update: PASSED");
}
