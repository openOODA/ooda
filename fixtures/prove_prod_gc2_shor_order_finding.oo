// # Product prove std/quantum_advanced/shor_order_finding.oo
//
// Logline: Fail-closed emit+gcc+run asserts bit_length is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_order_finding.oo.
//
// Beats:
//   1. Call bit_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shor_order_finding: PASSED only if they match.

import "std/quantum_advanced/shor_order_finding.oo";

pub fn main() {
    let shor_order_finding_mark: Int = 0;
    if shor_order_finding_mark != 0 {
        process_exit(1);
    }
    let shor_order_finding_a: Int = bit_length(1);
    let shor_order_finding_b: Int = bit_length(1);
    if shor_order_finding_a != shor_order_finding_b {
        println("FAIL bit_length");
        process_exit(1);
    }
    println("prod_shor_order_finding: PASSED");
}
