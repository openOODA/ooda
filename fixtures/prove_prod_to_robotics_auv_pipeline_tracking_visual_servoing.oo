// # Product prove std/robotics_auv/pipeline_tracking_visual_servoing.oo
//
// Logline: Fail-closed emit+gcc+run asserts visual_servoing_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/pipeline_tracking_visual_servoing.oo.
//
// Beats:
//   1. Call visual_servoing_config_default using the pipeline_tracking_visual_servoing ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_pipeline_tracking_visual_servoing: PASSED only if asserts hold.

import "std/robotics_auv/pipeline_tracking_visual_servoing.oo";

pub fn main() {
    let obj = visual_servoing_config_default();
    let pipeline_tracking_visual_servoing_a = obj.camera_focal_length_px;
    if pipeline_tracking_visual_servoing_a != 800.0 {
        println("FAIL visual_servoing_config_default");
        process_exit(1);
    }
    println("prod_pipeline_tracking_visual_servoing: PASSED");
}
