// # Product prove std/telecom_5g/dsp_iir_chebyshev.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_chebyshev_epsilon is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_iir_chebyshev.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dsp_chebyshev_epsilon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dsp_iir_chebyshev: PASSED only if they match.

import "std/telecom_5g/dsp_iir_chebyshev.oo";

pub fn main() {
    let g0_a = dsp_chebyshev_epsilon(0.0);
    let g0_b = dsp_chebyshev_epsilon(0.0);
    if g0_a != g0_b {
        println("FAIL dsp_chebyshev_epsilon");
        process_exit(1);
    }
    println("prod_gr_dsp_iir_chebyshev: PASSED");
}
