// # Product prove std/security_defense/basic_block_permutator.oo
//
// Logline: Fail-closed emit+gcc+run asserts function_cfg_total_instructions is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/basic_block_permutator.oo.
//
// Beats:
//   1. Call function_cfg_total_instructions twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_basic_block_permutator: PASSED only if they match.

import "std/security_defense/basic_block_permutator.oo";

pub fn main() {
    let basic_block_permutator_mark: Int = 0;
    if basic_block_permutator_mark != 0 {
        process_exit(1);
    }
    let basic_block_permutator_obj: FunctionCfg = function_cfg_new("x", 1);
    let basic_block_permutator_a: Int = function_cfg_total_instructions(&basic_block_permutator_obj);
    let basic_block_permutator_b: Int = function_cfg_total_instructions(&basic_block_permutator_obj);
    if basic_block_permutator_a != basic_block_permutator_b {
        println("FAIL function_cfg_total_instructions");
        process_exit(1);
    }
    println("prod_basic_block_permutator: PASSED");
}
