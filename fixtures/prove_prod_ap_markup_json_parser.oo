// # Product prove std/markup/json_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/json_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_json_parser: PASSED only if they match.

import "std/markup/json_parser.oo";

pub fn main() {
    let json_parser_a = json_validate("x");
    let json_parser_b = json_validate("x");
    if json_parser_a != json_parser_b {
        println("FAIL json_parser");
        process_exit(1);
    }
    println("prod_ap_json_parser: PASSED");
}
