// # Product prove std/tda_topology/ball_mapper_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts ball_mapper_count_intersections is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/ball_mapper_algorithm.oo.
//
// Beats:
//   1. Call ball_mapper_count_intersections twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ball_mapper_algorithm: PASSED only if they match.

import "std/tda_topology/ball_mapper_algorithm.oo";

pub fn main() {
    let ball_mapper_algorithm_mark: Int = 0;
    if ball_mapper_algorithm_mark != 0 {
        process_exit(1);
    }
    let ball_mapper_algorithm_obj: BallMapperGraph = ball_mapper_graph_new(1.0);
    let ball_mapper_algorithm_a: Int = ball_mapper_count_intersections(&ball_mapper_algorithm_obj);
    let ball_mapper_algorithm_b: Int = ball_mapper_count_intersections(&ball_mapper_algorithm_obj);
    if ball_mapper_algorithm_a != ball_mapper_algorithm_b {
        println("FAIL ball_mapper_count_intersections");
        process_exit(1);
    }
    println("prod_ball_mapper_algorithm: PASSED");
}
