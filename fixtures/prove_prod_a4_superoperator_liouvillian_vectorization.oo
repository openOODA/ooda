// # Product prove std/quantum_open_systems/superoperator_liouvillian_vectorization.oo
//
// Logline: Fail-closed emit+gcc+run asserts sv_c_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/superoperator_liouvillian_vectorization.oo.
//
// Beats:
//   1. Call sv_c_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_superoperator_liouvillian_vectorization: PASSED only if they match.

import "std/quantum_open_systems/superoperator_liouvillian_vectorization.oo";

pub fn main() {
    let superoperator_liouvillian_vectorization_mark: Int = 0;
    if superoperator_liouvillian_vectorization_mark != 0 {
        process_exit(1);
    }
    let a: Complex = sv_c_new(0.0, 0.0);
    let b: Complex = sv_c_new(0.0, 0.0);
    if (a).real != (b).real {
        println("FAIL sv_c_new");
        process_exit(1);
    }
    println("prod_superoperator_liouvillian_vectorization: PASSED");
}
