// # Product prove std/cloud_k8s/crdt_rga_sequence.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_k8s/crdt_rga_sequence.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_rga_sequence.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crdt_rga_sequence: PASSED only if they match.

import "std/cloud_k8s/crdt_rga_sequence.oo";
import "std/cloud_k8s/crdt_rga_sequence_ops.oo";

pub fn main() {
    let crdt_rga_sequence_a = rga_id_eq(0, 0, 0, 0);
    let crdt_rga_sequence_b = rga_id_eq(0, 0, 0, 0);
    if crdt_rga_sequence_a != crdt_rga_sequence_b {
        println("FAIL crdt_rga_sequence");
        process_exit(1);
    }
    println("prod_ap_crdt_rga_sequence: PASSED");
}
