// # Product prove std/physics/fluid_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts fluid_vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/fluid_math.oo.
//
// Beats:
//   1. Call fluid_vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fluid_math: PASSED only if they match.

import "std/physics/fluid_math.oo";

pub fn main() {
    let fluid_math_mark: Int = 0;
    if fluid_math_mark != 0 {
        process_exit(1);
    }
    let a: FluidVec3 = fluid_vec3_new(0, 0, 0);
    let b: FluidVec3 = fluid_vec3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL fluid_vec3_new");
        process_exit(1);
    }
    println("prod_fluid_math: PASSED");
}
