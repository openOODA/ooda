// # Product prove std/zk_rollup/baby_jubjub_curve.oo
//
// Logline: Fail-closed emit+gcc+run asserts baby_jubjub_params_default is a real value.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/baby_jubjub_curve.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call baby_jubjub_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_baby_jubjub_curve: PASSED only if they match.

import "std/zk_rollup/baby_jubjub_curve.oo";

pub fn main() {
    let g0_oa = baby_jubjub_params_default(2);
    let g0_ob = baby_jubjub_params_default(2);
    let g0_a = (g0_oa).coeff_a;
    let g0_b = (g0_ob).coeff_a;
    if g0_a != g0_b {
        println("FAIL baby_jubjub_params_default.coeff_a");
        process_exit(1);
    }
    println("prod_g0_baby_jubjub_curve: PASSED");
}
