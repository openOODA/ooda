// # List ambient quota pass
//
// Logline: Raise the alloc ceiling and push 50 ints successfully.
//
// Beats:
//   1. alloc_bytes(alloc, 65536) to raise the ambient ceiling.
//   2. Push 0..49 onto a List[Int].
//   3. Print list_len 50.

// M125: under raised ambient ceiling (alloc_bytes) growth succeeds
pub fn main(alloc: &AllocCap) {
    let raw = alloc_bytes(alloc, 65536);
    let mut lst: List[Int] = list_new();
    let mut i = 0;
    while i < 50 {
        lst = list_push(lst, i);
        i = i + 1;
    }
    println(list_len(lst));
}
