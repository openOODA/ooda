// # emit-x86 const-int else if
//
// Logline: Chain else if so emit-x86 prints only the first taken arm.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Skip the false then arm.
//   2. Take the else if arm.
//   3. as+ld stdout is b only.
//
// residual: if true/false stay later.

pub fn main() {
    if 1 == 2 {
        println("a");
    } else if 1 == 1 {
        println("b");
    } else {
        println("c");
    }
}
