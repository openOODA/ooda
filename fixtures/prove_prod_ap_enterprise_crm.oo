// # Product prove std/enterprise/crm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/enterprise/crm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/crm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crm: PASSED only if they match.

import "std/enterprise/crm.oo";

pub fn main() {
    let crm_a = crm_batch_import_raw_pointers(0, 0);
    let crm_b = crm_batch_import_raw_pointers(0, 0);
    if crm_a != crm_b {
        println("FAIL crm");
        process_exit(1);
    }
    println("prod_ap_crm: PASSED");
}
