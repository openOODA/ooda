// # Product prove std/astrophysics_relativity/accretion_disk_shakura_sunyaev.oo
//
// Logline: Fail-closed emit+gcc+run asserts ss_keplerian_frequency is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/accretion_disk_shakura_sunyaev.oo.
//
// Beats:
//   1. Call ss_keplerian_frequency twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_accretion_disk_shakura_sunyaev: PASSED only if they match.

import "std/astrophysics_relativity/accretion_disk_shakura_sunyaev.oo";

pub fn main() {
    let accretion_disk_shakura_sunyaev_mark: Int = 0;
    if accretion_disk_shakura_sunyaev_mark != 0 {
        process_exit(1);
    }
    let a: Int = ss_keplerian_frequency(0, 0);
    let b: Int = ss_keplerian_frequency(0, 0);
    if a != b {
        println("FAIL ss_keplerian_frequency");
        process_exit(1);
    }
    println("prod_accretion_disk_shakura_sunyaev: PASSED");
}
