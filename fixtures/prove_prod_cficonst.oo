import "std/sec/sys/cfi_const.oo";

pub fn main() {
    let a: Int = cfi_mode_disabled();
    if a != 0 {
        println("FAIL cfi dis");
        process_exit(1);
    }
    let b: Int = cfi_mode_full_protection();
    if b != 4 {
        println("FAIL cfi full");
        process_exit(1);
    }
    let c: Int = cfi_hw_feature_arm_bti();
    if c != 8 {
        println("FAIL cfi bti");
        process_exit(1);
    }
    println("prod_cficonst: PASSED");
