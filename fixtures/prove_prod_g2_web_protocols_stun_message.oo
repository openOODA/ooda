// # Product prove std/web_protocols/stun_message.oo
//
// Logline: Fail-closed emit+gcc+run asserts stun_is_binding_request is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/stun_message.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call stun_is_binding_request twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stun_message: PASSED only if they match.

import "std/web_protocols/stun_message.oo";

pub fn main() {
    let g2_oa = stun_message_binding_request(2);
    let g2_ob = stun_message_binding_request(2);
    let g2_a = stun_is_binding_request(g2_oa);
    let g2_b = stun_is_binding_request(g2_ob);
    if g2_a != g2_b {
        println("FAIL stun_is_binding_request");
        process_exit(1);
    }
    println("prod_g2_stun_message: PASSED");
}
