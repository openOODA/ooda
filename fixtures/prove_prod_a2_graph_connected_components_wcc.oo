// # Product prove std/db_graph/graph_connected_components_wcc.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsu_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_connected_components_wcc.oo.
//
// Beats:
//   1. Call dsu_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_connected_components_wcc: PASSED only if they match.

import "std/db_graph/graph_connected_components_wcc.oo";

pub fn main() {
    let graph_connected_components_wcc_mark: Int = 0;
    if graph_connected_components_wcc_mark != 0 {
        process_exit(1);
    }
    let a: DisjointSetUnion = dsu_new(0);
    let b: DisjointSetUnion = dsu_new(0);
    if (a).num_elements != (b).num_elements {
        println("FAIL dsu_new");
        process_exit(1);
    }
    println("prod_graph_connected_components_wcc: PASSED");
}
