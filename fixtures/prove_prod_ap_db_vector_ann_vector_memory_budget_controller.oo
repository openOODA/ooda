// # Product prove std/db_vector_ann/vector_memory_budget_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_memory_budget_controller.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_memory_budget_controller.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_memory_budget_controller: PASSED only if they match.

import "std/db_vector_ann/vector_memory_budget_controller.oo";

pub fn main() {
    let vector_memory_budget_controller_a = estimate_vector_memory(0, 0, 0);
    let vector_memory_budget_controller_b = estimate_vector_memory(0, 0, 0);
    if vector_memory_budget_controller_a != vector_memory_budget_controller_b {
        println("FAIL vector_memory_budget_controller");
        process_exit(1);
    }
    println("prod_ap_vector_memory_budget_controller: PASSED");
}
