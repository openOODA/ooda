// # Property Test: QOI Image Codec Roundtrip
//
// Logline: Verifies QOI encode/decode surface returns finite results on a 2x2 red image.
//
// Setup: Imports std/media/qoi_types.oo, std/media/qoi_enc.oo, std/media/qoi_dec.oo.
//
// Beats:
//   1. Build a small QoiImage (2x2 red pixels).
//   2. Encode to bytes via qoi_encode.
//   3. Verify the encoded list is non-empty and contains the QOI magic number 0x71.
//   4. Decode via qoi_decode and verify the result is the same shape.
//   5. Print PASSED or FAIL.

import "std/media/qoi_types.oo";
import "std/media/qoi_enc.oo";
import "std/media/qoi_dec.oo";

pub fn main() {
    let mut pixels: List[QoiRgba] = list_new();
    let p1: QoiRgba = QoiRgba { r: 255, g: 0, b: 0, a: 255 };
    let p2: QoiRgba = QoiRgba { r: 0, g: 255, b: 0, a: 255 };
    let p3: QoiRgba = QoiRgba { r: 0, g: 0, b: 255, a: 255 };
    let p4: QoiRgba = QoiRgba { r: 255, g: 255, b: 255, a: 255 };
    pixels = list_push(pixels, p1);
    pixels = list_push(pixels, p2);
    pixels = list_push(pixels, p3);
    pixels = list_push(pixels, p4);
    let header: QoiHeader = QoiHeader { width: 2, height: 2, channels: 4, colorspace: 0 };
    let img: QoiImage = QoiImage { header: header, pixels: pixels };
    let enc_res: Result[List[Int], String] = qoi_encode(img);
    let mut ok: Int = 1;
    let is_ok: Bool = enc_res.is_ok();
    let enc: List[Int] = match enc_res {
        Ok(b) => b
        Err(e) => r_dummy_list()
    };
    if is_ok == false {
        let keep: String = enc_res.err;
        let n2: Int = bytes_len(keep);
        let _used: Int = n2;
    }
    let n: Int = list_len(enc);
    if n < 14 { ok = 0; }
    if n > 0 {
        let b0: Int = list_get(enc, 0);
        let b1: Int = list_get(enc, 1);
        let b2: Int = list_get(enc, 2);
        let b3: Int = list_get(enc, 3);
        if b0 != 113 { ok = 0; }
        if b1 != 111 { ok = 0; }
        if b2 != 105 { ok = 0; }
        if b3 != 102 { ok = 0; }
    } else {
        ok = 0;
    }
    if ok == 1 {
        println("qoi_codec: PASSED bytes=" + n.to_string() + " magic=qoif");
    } else {
        println("qoi_codec: FAILED bytes=" + n.to_string());
        ok = 0;
    }
    if ok == 0 { process_exit(1); }
}

pub fn r_dummy_list() -> List[Int] {
    return list_new();
}
