// # Product prove std/perf/mutex.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/mutex.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/mutex.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mutex: PASSED only if they match.

import "std/perf/mutex.oo";

pub fn main() {
    let mutex_a = mutex_create("x");
    let mutex_b = mutex_create("x");
    let mutex_va = mutex_is_held(mutex_a);
    let mutex_vb = mutex_is_held(mutex_b);
    if mutex_va != mutex_vb {
        println("FAIL mutex");
        process_exit(1);
    }
    println("prod_ap_mutex: PASSED");
}
