// # Product prove std/perf/cache_aligned_alloc.oo
//
// Logline: Fail-closed emit+gcc+run asserts cache_aligned_align_up is a real value.
//
// Setup: Isolated emit-c. Imports std/perf/cache_aligned_alloc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cache_aligned_align_up twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_cache_aligned_alloc: PASSED only if they match.

import "std/perf/cache_aligned_alloc.oo";

pub fn main() {
    let g0_a = cache_aligned_align_up(2, 2);
    let g0_b = cache_aligned_align_up(2, 2);
    if g0_a != g0_b {
        println("FAIL cache_aligned_align_up");
        process_exit(1);
    }
    println("prod_g0_cache_aligned_alloc: PASSED");
}
