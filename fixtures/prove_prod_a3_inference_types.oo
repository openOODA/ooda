// # Product prove std/edge/inference_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts model_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_types.oo.
//
// Beats:
//   1. Call model_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_inference_types: PASSED only if they match.

import "std/edge/inference_types.oo";

pub fn main() {
    let inference_types_mark: Int = 0;
    if inference_types_mark != 0 {
        process_exit(1);
    }
    let a: ModelConfig = model_config_new(0, 0, 0);
    let b: ModelConfig = model_config_new(0, 0, 0);
    if (a).model_id != (b).model_id {
        println("FAIL model_config_new");
        process_exit(1);
    }
    println("prod_inference_types: PASSED");
}
