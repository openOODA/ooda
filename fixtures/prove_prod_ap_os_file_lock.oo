// # Product prove std/os/file_lock.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/file_lock.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/file_lock.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_file_lock: PASSED only if they match.

import "std/os/file_lock.oo";

pub fn main() {
    let file_lock_a = file_lock_new("x");
    let file_lock_b = file_lock_new("x");
    let file_lock_va = file_lock_is_active(file_lock_a);
    let file_lock_vb = file_lock_is_active(file_lock_b);
    if file_lock_va != file_lock_vb {
        println("FAIL file_lock");
        process_exit(1);
    }
    println("prod_ap_file_lock: PASSED");
}
