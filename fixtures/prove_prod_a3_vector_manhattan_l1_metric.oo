// # Product prove std/db_vector_ann/vector_manhattan_l1_metric.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_manhattan_l1_distance is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_manhattan_l1_metric.oo.
//
// Beats:
//   1. Call compute_manhattan_l1_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_manhattan_l1_metric: PASSED only if they match.

import "std/db_vector_ann/vector_manhattan_l1_metric.oo";

pub fn main() {
    let vector_manhattan_l1_metric_mark: Int = 0;
    if vector_manhattan_l1_metric_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_manhattan_l1_distance(list_new(), list_new());
    let b: Int = compute_manhattan_l1_distance(list_new(), list_new());
    if a != b {
        println("FAIL compute_manhattan_l1_distance");
        process_exit(1);
    }
    println("prod_vector_manhattan_l1_metric: PASSED");
}
