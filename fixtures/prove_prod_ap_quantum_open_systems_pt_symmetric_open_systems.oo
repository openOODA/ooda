// # Product prove std/quantum_open_systems/pt_symmetric_open_systems.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/pt_symmetric_open_systems.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/pt_symmetric_open_systems.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pt_symmetric_open_systems: PASSED only if they match.

import "std/quantum_open_systems/pt_symmetric_open_systems.oo";

pub fn main() {
    let pt_symmetric_open_systems_a = pt_symmetric_params_new(0.0, 0.0, 0.0);
    let pt_symmetric_open_systems_b = pt_symmetric_params_new(0.0, 0.0, 0.0);
    let pt_symmetric_open_systems_va = pt_exceptional_point_distance(pt_symmetric_open_systems_a);
    let pt_symmetric_open_systems_vb = pt_exceptional_point_distance(pt_symmetric_open_systems_b);
    if pt_symmetric_open_systems_va != pt_symmetric_open_systems_vb {
        println("FAIL pt_symmetric_open_systems");
        process_exit(1);
    }
    println("prod_ap_pt_symmetric_open_systems: PASSED");
}
