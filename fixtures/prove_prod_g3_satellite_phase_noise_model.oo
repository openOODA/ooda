// # Product prove std/satellite_dvb/satellite_phase_noise_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts phase_noise_integrated_jitter_deg is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_phase_noise_model.oo.
//
// Beats:
//   1. Call phase_noise_integrated_jitter_deg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_phase_noise_model: PASSED only if they match.

import "std/satellite_dvb/satellite_phase_noise_model.oo";

pub fn main() {
    let satellite_phase_noise_model_mark: Int = 0;
    if satellite_phase_noise_model_mark != 0 {
        process_exit(1);
    }
    let a: Float = phase_noise_integrated_jitter_deg(0.0);
    let b: Float = phase_noise_integrated_jitter_deg(0.0);
    if a != b {
        println("FAIL phase_noise_integrated_jitter_deg");
        process_exit(1);
    }
    println("prod_satellite_phase_noise_model: PASSED");
}
