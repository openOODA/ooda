// # Product prove std/hash/siphash.oo
//
// Logline: Fail-closed emit+gcc+run asserts siphash24 is a real value.
//
// Setup: Isolated emit-c. Imports std/hash/siphash.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call siphash24 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_siphash: PASSED only if they match.

import "std/hash/siphash.oo";

pub fn main() {
    let g0_a = siphash24("x", 2, 2);
    let g0_b = siphash24("x", 2, 2);
    if g0_a != g0_b {
        println("FAIL siphash24");
        process_exit(1);
    }
    println("prod_g0_siphash: PASSED");
}
