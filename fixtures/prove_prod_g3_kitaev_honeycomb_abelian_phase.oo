// # Product prove std/quantum_topological/kitaev_honeycomb_abelian_phase.oo
//
// Logline: Fail-closed emit+gcc+run asserts abelian_phase_mapping_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/kitaev_honeycomb_abelian_phase.oo.
//
// Beats:
//   1. Call abelian_phase_mapping_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kitaev_honeycomb_abelian_phase: PASSED only if they match.

import "std/quantum_topological/kitaev_honeycomb_abelian_phase.oo";

pub fn main() {
    let kitaev_honeycomb_abelian_phase_mark: Int = 0;
    if kitaev_honeycomb_abelian_phase_mark != 0 {
        process_exit(1);
    }
    let a: AbelianPhaseMapping = abelian_phase_mapping_new(0.0, 0.0, 0.0);
    let b: AbelianPhaseMapping = abelian_phase_mapping_new(0.0, 0.0, 0.0);
    if (a).jx != (b).jx {
        println("FAIL abelian_phase_mapping_new");
        process_exit(1);
    }
    println("prod_kitaev_honeycomb_abelian_phase: PASSED");
}
