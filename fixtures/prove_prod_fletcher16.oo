// # Product Fletcher-16 prove
//
// Logline: Fail-closed emit+gcc+run of shipped fletcher16_update_byte/digest.
//
// Setup: Product std/io/checksum_fletcher16.oo. Wikipedia abcde vector.
//
// Beats:
//   1. Fresh Fletcher-16 digest is 0.
//   2. ASCII abcde digest is 51440 (0xC8F0).
//   3. Exit 1 before PASSED on a miss.

import "std/io/checksum_fletcher16.oo";

pub fn main() {
    let st0: Fletcher16 = fletcher16_new();
    let d0: Int = fletcher16_digest(st0);
    if d0 != 0 {
        println("FAIL fletcher16 empty");
        process_exit(1);
    }
    let mut st: Fletcher16 = fletcher16_new();
    st = fletcher16_update_byte(st, 97);
    st = fletcher16_update_byte(st, 98);
    st = fletcher16_update_byte(st, 99);
    st = fletcher16_update_byte(st, 100);
    st = fletcher16_update_byte(st, 101);
    let d: Int = fletcher16_digest(st);
    if d != 51440 {
        println("FAIL fletcher16 abcde");
        process_exit(1);
    }
    println("prod_fletcher16: PASSED");
}
