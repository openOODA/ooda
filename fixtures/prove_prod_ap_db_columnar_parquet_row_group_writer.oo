// # Product prove std/db_columnar/parquet_row_group_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_row_group_writer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_row_group_writer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_parquet_row_group_writer: PASSED only if they match.

import "std/db_columnar/parquet_row_group_writer.oo";

pub fn main() {
    let parquet_row_group_writer_a = default_row_group_config();
    let parquet_row_group_writer_b = default_row_group_config();
    if parquet_row_group_writer_a.max_row_group_rows != parquet_row_group_writer_b.max_row_group_rows {
        println("FAIL parquet_row_group_writer");
        process_exit(1);
    }
    println("prod_ap_parquet_row_group_writer: PASSED");
}
