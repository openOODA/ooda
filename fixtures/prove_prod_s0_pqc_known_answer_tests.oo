// # Product prove std/pqc_nist/pqc_known_answer_tests.oo
//
// Logline: Fail-closed emit+gcc+run asserts kat_test_case_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_known_answer_tests.oo.
//
// Beats:
//   1. Call kat_test_case_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pqc_known_answer_tests: PASSED only if asserts hold.

import "std/pqc_nist/pqc_known_answer_tests.oo";

pub fn main() {
    let pqc_known_answer_tests_a: KatTestCase = kat_test_case_new("x", 0, list_new());
    let pqc_known_answer_tests_b: KatTestCase = kat_test_case_new("x", 0, list_new());
    if pqc_known_answer_tests_a.test_id != pqc_known_answer_tests_b.test_id {
        println("FAIL kat_test_case_new");
        process_exit(1);
    }
    println("prod_pqc_known_answer_tests: PASSED");
}
