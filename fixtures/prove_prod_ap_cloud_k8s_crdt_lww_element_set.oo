// # Product prove std/cloud_k8s/crdt_lww_element_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_k8s/crdt_lww_element_set.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_lww_element_set.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crdt_lww_element_set: PASSED only if they match.

import "std/cloud_k8s/crdt_lww_element_set.oo";

pub fn main() {
    let crdt_lww_element_set_a = lww_set_new(0, 0);
    let crdt_lww_element_set_b = lww_set_new(0, 0);
    let crdt_lww_element_set_va = lww_set_contains(crdt_lww_element_set_a);
    let crdt_lww_element_set_vb = lww_set_contains(crdt_lww_element_set_b);
    if crdt_lww_element_set_va != crdt_lww_element_set_vb {
        println("FAIL crdt_lww_element_set");
        process_exit(1);
    }
    println("prod_ap_crdt_lww_element_set: PASSED");
}
