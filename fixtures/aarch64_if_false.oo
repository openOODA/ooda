// # Const if false else print
//
// Logline: Print T only from the else arm of if false.
//
// Setup: Side emit-aarch64 skips the false arm.
//
// Beats:
//   1. if false print F.
//   2. else print T.
//   3. Expect T only.

pub fn main() {
    if false {
        println("F");
    } else {
        println("T");
    }
}
