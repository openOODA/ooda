// # Product prove std/deep_ai/rotary_embedding_rope.oo
//
// Logline: Fail-closed emit+gcc+run asserts rope_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/rotary_embedding_rope.oo.
//
// Beats:
//   1. Call rope_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rotary_embedding_rope: PASSED only if they match.

import "std/deep_ai/rotary_embedding_rope.oo";

pub fn main() {
    let rotary_embedding_rope_mark: Int = 0;
    if rotary_embedding_rope_mark != 0 {
        process_exit(1);
    }
    let a: RoPEConfig = rope_config_new(0, 0, 0);
    let b: RoPEConfig = rope_config_new(0, 0, 0);
    if (a).dim != (b).dim {
        println("FAIL rope_config_new");
        process_exit(1);
    }
    println("prod_rotary_embedding_rope: PASSED");
}
