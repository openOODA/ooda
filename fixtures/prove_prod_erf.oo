// # Product erf prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_erf on published pins.
//
// Setup: Product std/math/special_erf.oo. A&S 7.1.1 erf(0)=0; A&S 7.1.26 erf(0.5)~0.5205.
//
// Beats:
//   1. math_erf(0.0) is 0.0.
//   2. math_erf(0.5) is in (0.52, 0.521) — A&S 0.520500, libm 0.520500.
//   3. Exit 1 before PASSED on a miss.

import "std/math/special_erf.oo";

pub fn main() {
    let e0: Float = math_erf(0.0);
    if e0 != 0.0 {
        println("FAIL erf0");
        process_exit(1);
    }
    let e05: Float = math_erf(0.5);
    if e05 <= 0.52 {
        println("FAIL erf05 lo");
        process_exit(1);
    }
    if e05 >= 0.521 {
        println("FAIL erf05 hi");
        process_exit(1);
    }
    println("prod_erf: PASSED");
}
