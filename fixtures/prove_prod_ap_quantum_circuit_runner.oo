// # Product prove std/quantum/circuit_runner.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum/circuit_runner.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/circuit_runner.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_circuit_runner: PASSED only if they match.

import "std/quantum/circuit_runner.oo";

pub fn main() {
    let circuit_runner_a = register_new_1q();
    let circuit_runner_b = register_new_1q();
    let circuit_runner_va = register_prob0_milli(circuit_runner_a);
    let circuit_runner_vb = register_prob0_milli(circuit_runner_b);
    if circuit_runner_va != circuit_runner_vb {
        println("FAIL circuit_runner");
        process_exit(1);
    }
    println("prod_ap_circuit_runner: PASSED");
}
