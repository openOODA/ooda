// # Product prove std/fintech_defi/hft_tick_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_tick_compressor_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_tick_compressor.oo.
//
// Beats:
//   1. Call hft_tick_compressor_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hft_tick_compressor: PASSED only if it matches.

import "std/fintech_defi/hft_tick_compressor.oo";

pub fn main() {
    let a: Int = hft_tick_compressor_probe();
    if a != 0 {
        println("FAIL hft_tick_compressor_probe");
        process_exit(1);
    }
    println("prod_nc_hft_tick_compressor: PASSED");
}
