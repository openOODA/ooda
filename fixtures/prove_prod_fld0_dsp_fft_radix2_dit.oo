// # Product prove std/media_dsp/dsp_fft_radix2_dit.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_bit_reverse is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_fft_radix2_dit.oo.
//
// Beats:
//   1. Call dsp_bit_reverse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_fft_radix2_dit: PASSED only if they match.

import "std/media_dsp/dsp_fft_radix2_dit.oo";

pub fn main() {
    let dsp_fft_radix2_dit_mark: Int = 0;
    if dsp_fft_radix2_dit_mark != 0 {
        process_exit(1);
    }
    let dsp_fft_radix2_dit_a: Int = dsp_bit_reverse(1, 1);
    let dsp_fft_radix2_dit_b: Int = dsp_bit_reverse(1, 1);
    if dsp_fft_radix2_dit_a != dsp_fft_radix2_dit_b {
        println("FAIL dsp_bit_reverse");
        process_exit(1);
    }
    println("prod_dsp_fft_radix2_dit: PASSED");
}
