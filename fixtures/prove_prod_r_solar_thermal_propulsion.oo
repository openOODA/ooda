// # Product prove std/space_propulsion/solar_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_thermal_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_thermal_propulsion.oo.
//
// Beats:
//   1. Call solar_thermal_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_solar_thermal_propulsion: PASSED only if asserts hold.

import "std/space_propulsion/solar_thermal_propulsion.oo";

pub fn main() {
    let solar_thermal_propulsion: SolarThermalSpec = solar_thermal_spec_default();
    let solar_thermal_propulsion_b: SolarThermalSpec = solar_thermal_spec_default();
    if (solar_thermal_propulsion).concentrator_area_m2 != 45.0 {
        println("FAIL solar_thermal_spec_default concentrator_area_m2");
        process_exit(1);
    }
    if (solar_thermal_propulsion).concentrator_area_m2 != (solar_thermal_propulsion_b).concentrator_area_m2 {
        println("FAIL solar_thermal_spec_default det");
        process_exit(1);
    }
    println("prod_solar_thermal_propulsion: PASSED");
}
