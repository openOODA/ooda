// # Product prove std/compilers_vm/regalloc_linear_scan.oo
//
// Logline: Fail-closed emit+gcc+run asserts live_interval_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_linear_scan.oo.
//
// Beats:
//   1. Call live_interval_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regalloc_linear_scan: PASSED only if they match.

import "std/compilers_vm/regalloc_linear_scan.oo";

pub fn main() {
    let a: LiveInterval = live_interval_new(0, 0, 0);
    let b: LiveInterval = live_interval_new(0, 0, 0);
    if a.var_id != b.var_id {
        println("FAIL live_interval_new");
        process_exit(1);
    }
    println("prod_regalloc_linear_scan: PASSED");
}
