// # Product prove std/net/dns_client.oo
//
// Logline: Fail-closed emit+gcc+run asserts dns_client_new is a real value.
//
// Setup: Isolated emit-c. Imports std/net/dns_client.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dns_client_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_dns_client: PASSED only if they match.

import "std/net/dns_client.oo";

pub fn main() {
    let g0_oa = dns_client_new("x");
    let g0_ob = dns_client_new("x");
    let g0_a = (g0_oa).server_port;
    let g0_b = (g0_ob).server_port;
    if g0_a != g0_b {
        println("FAIL dns_client_new.server_port");
        process_exit(1);
    }
    println("prod_g0_dns_client: PASSED");
}
