// # Product prove std/security_defense/seccomp_notify_interceptor.oo
//
// Logline: Fail-closed emit+gcc+run asserts seccomp_supervisor_stats is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/seccomp_notify_interceptor.oo.
//
// Beats:
//   1. Call seccomp_supervisor_stats twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_seccomp_notify_interceptor: PASSED only if they match.

import "std/security_defense/seccomp_notify_interceptor.oo";

pub fn main() {
    let seccomp_notify_interceptor_mark: Int = 0;
    if seccomp_notify_interceptor_mark != 0 {
        process_exit(1);
    }
    let seccomp_notify_interceptor_obj: SeccompSupervisor = seccomp_supervisor_new("x");
    let seccomp_notify_interceptor_a: Int = seccomp_supervisor_stats(&seccomp_notify_interceptor_obj);
    let seccomp_notify_interceptor_b: Int = seccomp_supervisor_stats(&seccomp_notify_interceptor_obj);
    if seccomp_notify_interceptor_a != seccomp_notify_interceptor_b {
        println("FAIL seccomp_supervisor_stats");
        process_exit(1);
    }
    println("prod_seccomp_notify_interceptor: PASSED");
}
