// # list_set out-of-range
//
// Logline: Fail-closed emit+gcc+run of list_set past the end.
//
// Setup: Backend-C. One-elem list set at 9 must print ERR and exit 1.
//
// Beats:
//   1. Push one int onto a list.
//   2. Call list_set at index 9.
//   3. That path must not print PASSED.

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_set(xs, 9, 8);
    println("list_set_oob: LEAKED");
}
