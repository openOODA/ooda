// # Product sync barrier prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/barrier.oo.
//
// Setup: Product std/sync/barrier.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(4) threshold 4 arrived 0 generation 0. new(0) threshold 1.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/barrier.oo";

pub fn main() {
    let b: Barrier = barrier_new(4);
    let t: Int = barrier_threshold(b);
    if t != 4 {
        println("FAIL barri thresh");
        process_exit(1);
    }
    let a: Int = barrier_arrived(b);
    if a != 0 {
        println("FAIL barri arrived");
        process_exit(1);
    }
    let g: Int = barrier_generation(b);
    if g != 0 {
        println("FAIL barri gen");
        process_exit(1);
    }
    let b2: Barrier = barrier_new(0);
    let t2: Int = barrier_threshold(b2);
    if t2 != 1 {
        println("FAIL barri clamp");
        process_exit(1);
    }
    println("prod_barri: PASSED");
}
