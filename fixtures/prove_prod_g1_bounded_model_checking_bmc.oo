// # Product prove std/formal_verif/bounded_model_checking_bmc.oo
//
// Logline: Fail-closed emit+gcc+run asserts bmc_context_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/bounded_model_checking_bmc.oo.
//
// Beats:
//   1. Call bmc_context_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bounded_model_checking_bmc: PASSED only if they match.

import "std/formal_verif/bounded_model_checking_bmc.oo";

pub fn main() {
    let a: BmcContext = bmc_context_new("x", 0);
    let b: BmcContext = bmc_context_new("x", 0);
    if a.max_k_bound != b.max_k_bound {
        println("FAIL bmc_context_new");
        process_exit(1);
    }
    println("prod_bounded_model_checking_bmc: PASSED");
}
