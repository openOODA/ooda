// # Product prove std/physics/sph_fluid_density.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/sph_fluid_density.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/sph_fluid_density.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sph_fluid_density: PASSED only if they match.

import "std/physics/sph_fluid_density.oo";

pub fn main() {
    let sph_fluid_density_a = sph_poly6_kernel(0.0, 0.0);
    let sph_fluid_density_b = sph_poly6_kernel(0.0, 0.0);
    if sph_fluid_density_a != sph_fluid_density_b {
        println("FAIL sph_fluid_density");
        process_exit(1);
    }
    println("prod_ap_sph_fluid_density: PASSED");
}
