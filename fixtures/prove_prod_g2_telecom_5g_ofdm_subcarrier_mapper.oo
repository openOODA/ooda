// # Product prove std/telecom_5g/ofdm_subcarrier_mapper.oo
//
// Logline: Fail-closed emit+gcc+run asserts ofdm_mapper_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_subcarrier_mapper.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ofdm_mapper_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ofdm_subcarrier_mapper: PASSED only if they match.

import "std/telecom_5g/ofdm_subcarrier_mapper.oo";

pub fn main() {
    let g2_a = ofdm_mapper_int_to_float(2);
    let g2_b = ofdm_mapper_int_to_float(2);
    if g2_a != g2_b {
        println("FAIL ofdm_mapper_int_to_float");
        process_exit(1);
    }
    println("prod_g2_ofdm_subcarrier_mapper: PASSED");
}
