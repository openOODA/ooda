// # Product prove std/game_engine/pathfinding_astar.oo
//
// Logline: Fail-closed emit+gcc+run asserts astar_calculate_f_cost is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/pathfinding_astar.oo.
//
// Beats:
//   1. Call astar_calculate_f_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pathfinding_astar: PASSED only if they match.

import "std/game_engine/pathfinding_astar.oo";

pub fn main() {
    let pathfinding_astar_mark: Int = 0;
    if pathfinding_astar_mark != 0 {
        process_exit(1);
    }
    let a: Float = astar_calculate_f_cost(0.0, 0.0);
    let b: Float = astar_calculate_f_cost(0.0, 0.0);
    if a != b {
        println("FAIL astar_calculate_f_cost");
        process_exit(1);
    }
    println("prod_pathfinding_astar: PASSED");
}
