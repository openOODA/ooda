// # Product prove std/cloud_k8s/circuit_breaker_hysteretic.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_breaker_can_execute is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/circuit_breaker_hysteretic.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call circuit_breaker_can_execute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_circuit_breaker_hysteretic: PASSED only if they match.

import "std/cloud_k8s/circuit_breaker_hysteretic.oo";

pub fn main() {
    let mut g0_oa: HystereticCircuitBreaker = HystereticCircuitBreaker { state: 0, failure_threshold: 0, recovery_success_threshold: 0, cooldown_base_ms: 0, consecutive_failures: 0, consecutive_successes: 0, last_state_change_ms: 0, trip_count: 0 };
    let mut g0_ob: HystereticCircuitBreaker = HystereticCircuitBreaker { state: 0, failure_threshold: 0, recovery_success_threshold: 0, cooldown_base_ms: 0, consecutive_failures: 0, consecutive_successes: 0, last_state_change_ms: 0, trip_count: 0 };
    let g0_a = circuit_breaker_can_execute(&g0_oa, 0);
    let g0_b = circuit_breaker_can_execute(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL circuit_breaker_can_execute");
        process_exit(1);
    }
    println("prod_gr_circuit_breaker_hysteretic: PASSED");
}
