// # Product prove std/quantum_topological/toric_code_boundary_conditions.oo
//
// Logline: Fail-closed emit+gcc+run asserts boundary_smooth is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_boundary_conditions.oo.
//
// Beats:
//   1. Call boundary_smooth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_toric_code_boundary_conditions: PASSED only if they match.

import "std/quantum_topological/toric_code_boundary_conditions.oo";

pub fn main() {
    let toric_code_boundary_conditions_mark: Int = 0;
    if toric_code_boundary_conditions_mark != 0 {
        process_exit(1);
    }
    let a: BoundaryType = boundary_smooth();
    let b: BoundaryType = boundary_smooth();
    if (a).id != (b).id {
        println("FAIL boundary_smooth");
        process_exit(1);
    }
    println("prod_g2_toric_code_boundary_conditions: PASSED");
}
