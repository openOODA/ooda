// # Product prove std/formal_verif/abstract_polyhedra_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_constraint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_polyhedra_domain.oo.
//
// Beats:
//   1. Call linear_constraint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abstract_polyhedra_domain: PASSED only if they match.

import "std/formal_verif/abstract_polyhedra_domain.oo";

pub fn main() {
    let abstract_polyhedra_domain_mark: Int = 0;
    if abstract_polyhedra_domain_mark != 0 {
        process_exit(1);
    }
    let a: LinearConstraint = linear_constraint_new(list_new(), 0, true);
    let b: LinearConstraint = linear_constraint_new(list_new(), 0, true);
    if (a).constant_bound != (b).constant_bound {
        println("FAIL linear_constraint_new");
        process_exit(1);
    }
    println("prod_g2_abstract_polyhedra_domain: PASSED");
}
