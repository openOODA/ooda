// # Product prove std/ai_ml/layer_attention.oo
//
// Logline: Fail-closed verification that multi-head attention configuration and scaled dot-product attention are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_attention.oo.
//
// Beats:
//   1. Construct AttentionConfig and MultiHeadAttention layer instances.
//   2. Compute scaled dot-product attention scores across sequence tensors.
//   3. Execute multi-head attention forward projection.
//   4. Print prod_g4_aiml_layer_attention: PASSED and exit 0.

import "std/ai_ml/layer_attention.oo";

pub fn main() {
    let cfg1: AttentionConfig = attention_config_new(4, 2, false);
    let cfg2: AttentionConfig = attention_config_new(4, 2, false);

    if (cfg1).embed_dim != (cfg2).embed_dim || (cfg1).embed_dim != 4 {
        println("FAIL attention_config_new embed_dim");
        process_exit(1);
    }
    if (cfg1).num_heads != (cfg2).num_heads || (cfg1).num_heads != 2 {
        println("FAIL attention_config_new num_heads");
        process_exit(1);
    }
    if (cfg1).head_dim != (cfg2).head_dim || (cfg1).head_dim != 2 {
        println("FAIL attention_config_new head_dim");
        process_exit(1);
    }

    let mha: MultiHeadAttention = attention_layer_new(cfg1);
    if ((mha).config).embed_dim != 4 {
        println("FAIL attention_layer_new config");
        process_exit(1);
    }

    let mut q_data: List[Float] = list_new();
    q_data = list_push(q_data, 1.0);
    q_data = list_push(q_data, 0.0);
    q_data = list_push(q_data, 0.0);
    q_data = list_push(q_data, 1.0);
    let q: Tensor2D = Tensor2D { data: q_data, rows: 2, cols: 2 };

    let mut k_data: List[Float] = list_new();
    k_data = list_push(k_data, 1.0);
    k_data = list_push(k_data, 0.0);
    k_data = list_push(k_data, 0.0);
    k_data = list_push(k_data, 1.0);
    let k: Tensor2D = Tensor2D { data: k_data, rows: 2, cols: 2 };

    let mut v_data: List[Float] = list_new();
    v_data = list_push(v_data, 2.0);
    v_data = list_push(v_data, 3.0);
    v_data = list_push(v_data, 4.0);
    v_data = list_push(v_data, 5.0);
    let v: Tensor2D = Tensor2D { data: v_data, rows: 2, cols: 2 };

    let attn_out1: Tensor2D = scaled_dot_product_attention_single_head(q, k, v, 2, 2, false);
    let attn_out2: Tensor2D = scaled_dot_product_attention_single_head(q, k, v, 2, 2, false);

    if (attn_out1).rows != (attn_out2).rows || (attn_out1).rows != 2 {
        println("FAIL scaled_dot_product_attention rows");
        process_exit(1);
    }
    if (attn_out1).cols != (attn_out2).cols || (attn_out1).cols != 2 {
        println("FAIL scaled_dot_product_attention cols");
        process_exit(1);
    }

    let causal_out: Tensor2D = scaled_dot_product_attention_single_head(q, k, v, 2, 2, true);
    if (causal_out).rows != 2 || (causal_out).cols != 2 {
        println("FAIL causal scaled_dot_product_attention");
        process_exit(1);
    }

    println("prod_g4_aiml_layer_attention: PASSED");
    process_exit(0);
}
