// # Product prove std/robotics_auv/turbidity_light_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts optical_water_config_default_clear is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/turbidity_light_attenuation.oo.
//
// Beats:
//   1. Call optical_water_config_default_clear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_turbidity_light_attenuation: PASSED only if they match.

import "std/robotics_auv/turbidity_light_attenuation.oo";

pub fn main() {
    let turbidity_light_attenuation_mark: Int = 0;
    if turbidity_light_attenuation_mark != 0 {
        process_exit(1);
    }
    let a: OpticalWaterConfig = optical_water_config_default_clear();
    let b: OpticalWaterConfig = optical_water_config_default_clear();
    if (a).absorption_milli != (b).absorption_milli {
        println("FAIL optical_water_config_default_clear");
        process_exit(1);
    }
    println("prod_turbidity_light_attenuation: PASSED");
}
