// # Product prove std/db_graph/property_graph_edge_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts edge_index_catalog_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_edge_index.oo.
//
// Beats:
//   1. Call edge_index_catalog_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_edge_index: PASSED only if they match.

import "std/db_graph/property_graph_edge_index.oo";

pub fn main() {
    let property_graph_edge_index_mark: Int = 0;
    if property_graph_edge_index_mark != 0 {
        process_exit(1);
    }
    let a: EdgeIndexCatalog = edge_index_catalog_new();
    let b: EdgeIndexCatalog = edge_index_catalog_new();
    if (a).partition_count != (b).partition_count {
        println("FAIL edge_index_catalog_new");
        process_exit(1);
    }
    println("prod_property_graph_edge_index: PASSED");
}
