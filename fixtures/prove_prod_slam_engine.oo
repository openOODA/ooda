// # Product prove std/robot/slam_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts slam_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/slam_engine.oo.
//
// Beats:
//   1. Call slam_engine_new twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_engine: PASSED only if they match.

import "std/robot/slam_engine.oo";

pub fn main() {
    let slam_engine_mark: Int = 0;
    if slam_engine_mark != 0 {
        process_exit(1);
    }
    let a: SlamState = slam_engine_new();
    let b: SlamState = slam_engine_new();
    if (a).size != (b).size {
        println("FAIL slam_engine_new");
        process_exit(1);
    }
    println("prod_slam_engine: PASSED");
}
