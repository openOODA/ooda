// # Product prove std/web_ecosystem/patch_apply.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/patch_apply.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/patch_apply.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_patch_apply: PASSED only if they match.

import "std/web_ecosystem/patch_apply.oo";

pub fn main() {
    let patch_apply_a = patch_apply_op(0, 0, 0);
    let patch_apply_b = patch_apply_op(0, 0, 0);
    if patch_apply_a != patch_apply_b {
        println("FAIL patch_apply");
        process_exit(1);
    }
    println("prod_ap_patch_apply: PASSED");
}
