// # While exceeds cycle budget
//
// Logline: Run a while i < 10 loop past a two-cycle budget.
//
// Beats:
//   1. Keep the two-cycle marker.
//   2. Increment i while i < 10.
//   3. Expect ERR max_cycles before println.

// M48 MaxCycles path A — fail: while exceeds budget → ERR max_cycles + non-zero
// MAX_CYCLES: 2
pub fn main() {
    let mut i = 0;
    while i < 10 {
        i = i + 1;
    }
    println(i);
}
