// # Product prove std/robotics_auv/heading_autopilot_sliding_mode.oo
//
// Logline: Fail-closed emit+gcc+run asserts smc_heading_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/heading_autopilot_sliding_mode.oo.
//
// Beats:
//   1. Call smc_heading_gains_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heading_autopilot_sliding_mode: PASSED only if they match.

import "std/robotics_auv/heading_autopilot_sliding_mode.oo";

pub fn main() {
    let heading_autopilot_sliding_mode_mark: Int = 0;
    if heading_autopilot_sliding_mode_mark != 0 {
        process_exit(1);
    }
    let a: SmcHeadingGains = smc_heading_gains_default();
    let b: SmcHeadingGains = smc_heading_gains_default();
    if (a).lambda_slope != (b).lambda_slope {
        println("FAIL smc_heading_gains_default");
        process_exit(1);
    }
    println("prod_heading_autopilot_sliding_mode: PASSED");
}
