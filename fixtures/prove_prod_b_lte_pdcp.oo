// # Product prove std/telecom/lte_pdcp.oo
//
// Logline: Fail-closed emit+gcc+run asserts lte_pdcp_sn_modulus is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/lte_pdcp.oo.
//
// Beats:
//   1. Call lte_pdcp_sn_modulus twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lte_pdcp: PASSED only if they match.

import "std/telecom/lte_pdcp.oo";

pub fn main() {
    let a = lte_pdcp_sn_modulus(0);
    let b = lte_pdcp_sn_modulus(0);
    if a != b {
        println("FAIL lte_pdcp_sn_modulus");
        process_exit(1);
    }
    println("prod_lte_pdcp: PASSED");
}
