// # Multi-module add_one
//
// Logline: Export add_one so a sibling main can import it.
//
// Beats:
//   1. Declare pub fn add_one.
//   2. Return x + 1.
//   3. Keep this file import-bearing, not a standalone main.

// M119 multi-module library (import-bearing product surface)
pub fn add_one(x: Int) -> Int {
    return x + 1;
}
