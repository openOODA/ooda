// # Product prove std/bioinformatics/hmm_profile.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmm_viterbi_step_score is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/hmm_profile.oo.
//
// Beats:
//   1. Call hmm_viterbi_step_score twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hmm_profile: PASSED only if they match.

import "std/bioinformatics/hmm_profile.oo";

pub fn main() {
    let hmm_profile_mark: Int = 0;
    if hmm_profile_mark != 0 {
        process_exit(1);
    }
    let a: Int = hmm_viterbi_step_score(0, 0, 0);
    let b: Int = hmm_viterbi_step_score(0, 0, 0);
    if a != b {
        println("FAIL hmm_viterbi_step_score");
        process_exit(1);
    }
    println("prod_hmm_profile: PASSED");
}
