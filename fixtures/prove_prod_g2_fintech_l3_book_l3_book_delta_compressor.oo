// # Product prove std/fintech_l3_book/l3_book_delta_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts compression_state_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_book_delta_compressor.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compression_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_book_delta_compressor: PASSED only if they match.

import "std/fintech_l3_book/l3_book_delta_compressor.oo";

pub fn main() {
    let g2_oa: CompressionState = compression_state_new(2, 8);
    let g2_ob: CompressionState = compression_state_new(2, 8);
    let g2_a = (g2_oa).base_order_id;
    let g2_b = (g2_ob).base_order_id;
    if g2_a != g2_b {
        println("FAIL compression_state_new.base_order_id");
        process_exit(1);
    }
    println("prod_g2_l3_book_delta_compressor: PASSED");
}
