// # Product prove std/cloud_faas/snapstart_criu_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts snapstart_criu_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/snapstart_criu_engine.oo.
//
// Beats:
//   1. Call snapstart_criu_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_snapstart_criu_engine: PASSED only if they match.

import "std/cloud_faas/snapstart_criu_engine.oo";

pub fn main() {
    let snapstart_criu_engine_mark: Int = 0;
    if snapstart_criu_engine_mark != 0 {
        process_exit(1);
    }
    let snapstart_criu_engine_a: SnapStartCriuEngine = snapstart_criu_engine_new("x");
    let snapstart_criu_engine_b: SnapStartCriuEngine = snapstart_criu_engine_new("x");
    if (snapstart_criu_engine_a).total_restores != (snapstart_criu_engine_b).total_restores {
        println("FAIL snapstart_criu_engine_new");
        process_exit(1);
    }
    println("prod_snapstart_criu_engine: PASSED");
}
