// # Product prove std/compilers_polyhedral/polyhedral_domain_polytope.oo
//
// Logline: Fail-closed emit+gcc+run asserts polyhedral_domain_contains_point is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_domain_polytope.oo.
//
// Beats:
//   1. Call polyhedral_domain_contains_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_domain_polytope: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_domain_polytope.oo";

pub fn main() {
    let obj_a: PolyhedralDomain = polyhedral_domain_new(0, 0);
    let obj_b: PolyhedralDomain = polyhedral_domain_new(0, 0);
    let a: Bool = polyhedral_domain_contains_point(obj_a, list_new());
    let b: Bool = polyhedral_domain_contains_point(obj_b, list_new());
    if a != b {
        println("FAIL polyhedral_domain_contains_point");
        process_exit(1);
    }
    println("prod_polyhedral_domain_polytope: PASSED");
}
