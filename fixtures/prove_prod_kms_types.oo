// # Product prove std/sec/crypto/kms_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts kms_policy_uses is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_types.oo.
//
// Beats:
//   1. Call kms_policy_uses twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kms_types: PASSED only if they match.

import "std/sec/crypto/kms_types.oo";

pub fn main() {
    let obj = kms_policy_new(0, 0, 0);
    let a = kms_policy_uses(obj);
    let b = kms_policy_uses(obj);
    if a != b {
        println("FAIL kms_policy_uses");
        process_exit(1);
    }
    println("prod_kms_types: PASSED");
}
