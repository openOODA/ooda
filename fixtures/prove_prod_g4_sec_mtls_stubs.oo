// # Product prove std/sec/net/mtls_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/mtls_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_mtls_stubs: PASSED and exit 0 only on match.

import "std/sec/net/mtls_stubs.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_net_mtls_stubs_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_net_mtls_stubs_oo();
    if dummy_a != dummy_b {
        println("FAIL mtls_stubs dummy");
        process_exit(1);
    }

    let cs_a: Int = checksum_calculate("openooda_mtls_payload");
    let cs_b: Int = checksum_calculate("openooda_mtls_payload");
    if cs_a != cs_b {
        println("FAIL checksum_calculate");
        process_exit(1);
    }

    let eq_a: Bool = bytes_constant_time_eq("mtls_secret_token", "mtls_secret_token");
    let eq_b: Bool = bytes_constant_time_eq("mtls_secret_token", "mtls_secret_token");
    if eq_a != eq_b {
        println("FAIL bytes_constant_time_eq");
        process_exit(1);
    }

    let seq_a: Bool = str_eq("TLS_AES_256_GCM_SHA384", "TLS_AES_256_GCM_SHA384");
    let seq_b: Bool = str_eq("TLS_AES_256_GCM_SHA384", "TLS_AES_256_GCM_SHA384");
    if seq_a != seq_b {
        println("FAIL str_eq");
        process_exit(1);
    }

    println("prod_g4_sec_mtls_stubs: PASSED");
    process_exit(0);
}
