// # Product bigdecimal prove
//
// Logline: Fail-closed emit+gcc+run of shipped bigdec_zero/one/is_zero.
//
// Setup: Product std/math/bigdecimal.oo. Unscaled "0"/"1".
//
// Beats:
//   1. bigdec_is_zero(zero) true; bigdec_is_zero(one) false.
//   2. Exit 1 before PASSED on a miss.

import "std/math/bigdecimal.oo";

pub fn main() {
    let z: BigDecimal = bigdec_zero();
    let o: BigDecimal = bigdec_one();
    let zz: Bool = bigdec_is_zero(z);
    if zz == false {
        println("FAIL bigdec zero");
        process_exit(1);
    }
    let oz: Bool = bigdec_is_zero(o);
    if oz == true {
        println("FAIL bigdec one");
        process_exit(1);
    }
    println("prod_bigdec: PASSED");
}
