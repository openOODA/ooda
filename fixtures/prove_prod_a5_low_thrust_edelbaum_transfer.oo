// # Product prove std/space_propulsion/low_thrust_edelbaum_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts edelbaum_spec_default_leo_to_geo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/low_thrust_edelbaum_transfer.oo.
//
// Beats:
//   1. Call edelbaum_spec_default_leo_to_geo twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_low_thrust_edelbaum_transfer: PASSED only if they match.

import "std/space_propulsion/low_thrust_edelbaum_transfer.oo";

pub fn main() {
    let low_thrust_edelbaum_transfer_mark: Int = 0;
    if low_thrust_edelbaum_transfer_mark != 0 {
        process_exit(1);
    }
    let a: EdelbaumTransferSpec = edelbaum_spec_default_leo_to_geo();
    let b: EdelbaumTransferSpec = edelbaum_spec_default_leo_to_geo();
    if (a).r_initial_m != (b).r_initial_m {
        println("FAIL edelbaum_spec_default_leo_to_geo");
        process_exit(1);
    }
    println("prod_low_thrust_edelbaum_transfer: PASSED");
}
