// # Refuse a secret file_size path
//
// Logline: A tagged name must not be used as the file_size path.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the path.
//   3. Expect the sink to refuse.

// M143: Secret must not be used as file_size path
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let r = file_size(fs, token);
    println(1);
}
