// # Product prove std/wasm_gc/wasm_component_type_section.oo
//
// Logline: Fail-closed emit+gcc+run asserts comp_type_decl_new is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_type_section.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call comp_type_decl_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_component_type_section: PASSED only if they match.

import "std/wasm_gc/wasm_component_type_section.oo";

pub fn main() {
    let g2_oa: ComponentTypeDecl = comp_type_decl_new(2, "x", 2, 2);
    let g2_ob: ComponentTypeDecl = comp_type_decl_new(2, "x", 2, 2);
    let g2_a = (g2_oa).tag;
    let g2_b = (g2_ob).tag;
    if g2_a != g2_b {
        println("FAIL comp_type_decl_new.tag");
        process_exit(1);
    }
    println("prod_g2_wasm_component_type_section: PASSED");
}
