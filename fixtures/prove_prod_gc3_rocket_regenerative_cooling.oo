// # Product prove std/space_propulsion/rocket_regenerative_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts bartz_heat_transfer_coeff is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_regenerative_cooling.oo.
//
// Beats:
//   1. Call bartz_heat_transfer_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_regenerative_cooling: PASSED only if they match.

import "std/space_propulsion/rocket_regenerative_cooling.oo";

pub fn main() {
    let rocket_regenerative_cooling_mark: Int = 0;
    if rocket_regenerative_cooling_mark != 0 {
        process_exit(1);
    }
    let rocket_regenerative_cooling_a: Float = bartz_heat_transfer_coeff(1.0, 1.0, 1.0, 1.0);
    let rocket_regenerative_cooling_b: Float = bartz_heat_transfer_coeff(1.0, 1.0, 1.0, 1.0);
    if rocket_regenerative_cooling_a != rocket_regenerative_cooling_b {
        println("FAIL bartz_heat_transfer_coeff");
        process_exit(1);
    }
    println("prod_rocket_regenerative_cooling: PASSED");
}
