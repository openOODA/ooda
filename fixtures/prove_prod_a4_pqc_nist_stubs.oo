// # Product prove std/pqc_nist/pqc_nist_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts pqc_hardware_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_nist_stubs.oo.
//
// Beats:
//   1. Call pqc_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pqc_nist_stubs: PASSED only if they match.

import "std/pqc_nist/pqc_nist_stubs.oo";

pub fn main() {
    let pqc_nist_stubs_mark: Int = 0;
    if pqc_nist_stubs_mark != 0 {
        process_exit(1);
    }
    let a: PqcHardwareCapabilities = pqc_hardware_capabilities_default();
    let b: PqcHardwareCapabilities = pqc_hardware_capabilities_default();
    if (a).supports_qrng != (b).supports_qrng {
        println("FAIL pqc_hardware_capabilities_default");
        process_exit(1);
    }
    println("prod_pqc_nist_stubs: PASSED");
}
