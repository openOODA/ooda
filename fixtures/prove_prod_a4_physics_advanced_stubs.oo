// # Product prove std/physics_advanced/physics_advanced_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts advanced_physics_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/physics_advanced_stubs.oo.
//
// Beats:
//   1. Call advanced_physics_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_physics_advanced_stubs: PASSED only if they match.

import "std/physics_advanced/physics_advanced_stubs.oo";

pub fn main() {
    let physics_advanced_stubs_mark: Int = 0;
    if physics_advanced_stubs_mark != 0 {
        process_exit(1);
    }
    let a: AdvancedPhysicsCapabilities = advanced_physics_capabilities_default();
    let b: AdvancedPhysicsCapabilities = advanced_physics_capabilities_default();
    if (a).max_grid_resolution_nx != (b).max_grid_resolution_nx {
        println("FAIL advanced_physics_capabilities_default");
        process_exit(1);
    }
    println("prod_physics_advanced_stubs: PASSED");
}
