// # Product prove std/fs/watch.oo
//
// Logline: Fail-closed emit+gcc+run asserts watch_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/watch.oo.
//
// Beats:
//   1. Call watch_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_watch: PASSED only if they match.

import "std/fs/watch.oo";

pub fn main() {
    let a: Int = watch_probe();
    let b: Int = watch_probe();
    if a != b {
        println("FAIL watch_probe");
        process_exit(1);
    }
    println("prod_g2_watch: PASSED");
}
