// # Product prove std/os/directory_walker.oo
//
// Logline: Fail-closed emit+gcc+run asserts dir_walker_has_pending is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/directory_walker.oo.
//
// Beats:
//   1. Call dir_walker_has_pending twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_directory_walker: PASSED only if they match.

import "std/os/directory_walker.oo";

pub fn main() {
    let obj = dir_walker_new("x", 0);
    let a = dir_walker_has_pending(obj);
    let b = dir_walker_has_pending(obj);
    if a != b {
        println("FAIL dir_walker_has_pending");
        process_exit(1);
    }
    println("prod_directory_walker: PASSED");
}
