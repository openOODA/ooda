// # Product prove std/quantum_advanced/quantum_arithmetic_adder.oo
//
// Logline: Fail-closed emit+gcc+run asserts draper_phase_angle is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_arithmetic_adder.oo.
//
// Beats:
//   1. Call draper_phase_angle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_arithmetic_adder: PASSED only if they match.

import "std/quantum_advanced/quantum_arithmetic_adder.oo";

pub fn main() {
    let quantum_arithmetic_adder_mark: Int = 0;
    if quantum_arithmetic_adder_mark != 0 {
        process_exit(1);
    }
    let a: Float = draper_phase_angle(0);
    let b: Float = draper_phase_angle(0);
    if a != b {
        println("FAIL draper_phase_angle");
        process_exit(1);
    }
    println("prod_quantum_arithmetic_adder: PASSED");
}
