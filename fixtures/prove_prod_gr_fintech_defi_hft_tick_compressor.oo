// # Product prove std/fintech_defi/hft_tick_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_tick_compressor_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_tick_compressor.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call hft_tick_compressor_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_hft_tick_compressor: PASSED only if they match.

import "std/fintech_defi/hft_tick_compressor.oo";

pub fn main() {
    let g0_a = hft_tick_compressor_probe();
    let g0_b = hft_tick_compressor_probe();
    if g0_a != g0_b {
        println("FAIL hft_tick_compressor_probe");
        process_exit(1);
    }
    println("prod_gr_hft_tick_compressor: PASSED");
}
