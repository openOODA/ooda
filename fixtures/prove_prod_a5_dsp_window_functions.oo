// # Product prove std/telecom_5g/dsp_window_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_window_hann_sample is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_window_functions.oo.
//
// Beats:
//   1. Call dsp_window_hann_sample twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_window_functions: PASSED only if they match.

import "std/telecom_5g/dsp_window_functions.oo";

pub fn main() {
    let dsp_window_functions_mark: Int = 0;
    if dsp_window_functions_mark != 0 {
        process_exit(1);
    }
    let a: Float = dsp_window_hann_sample(0, 0);
    let b: Float = dsp_window_hann_sample(0, 0);
    if a != b {
        println("FAIL dsp_window_hann_sample");
        process_exit(1);
    }
    println("prod_dsp_window_functions: PASSED");
}
