// # Product prove std/aero/propulsion_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/propulsion_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_propulsion_stubs: PASSED only if they match.

import "std/aero/propulsion_stubs.oo";

pub fn main() {
    let propulsion_stubs_a = propulsion_module_ready();
    let propulsion_stubs_b = propulsion_module_ready();
    if propulsion_stubs_a != propulsion_stubs_b {
        println("FAIL propulsion_stubs");
        process_exit(1);
    }
    println("prod_ap_propulsion_stubs: PASSED");
}
