// # Product prove std/gui/theme.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gui/theme.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/theme.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_theme: PASSED only if they match.

import "std/gui/theme.oo";

pub fn main() {
    let theme_a = theme_new(0, 0, 0, 0, 0, 0, true);
    let theme_b = theme_new(0, 0, 0, 0, 0, 0, true);
    let theme_va = theme_is_dark(theme_a);
    let theme_vb = theme_is_dark(theme_b);
    if theme_va != theme_vb {
        println("FAIL theme");
        process_exit(1);
    }
    println("prod_ap_theme: PASSED");
}
