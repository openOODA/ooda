// # Product prove std/sec/net/jwt_token_config.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/jwt_token_config.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_token_config.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_jwt_token_config: PASSED and exit 0 only on match.

import "std/sec/net/jwt_token_config.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_net_jwt_token_config_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_net_jwt_token_config_oo();
    if dummy_a != dummy_b {
        println("FAIL jwt_token_config dummy");
        process_exit(1);
    }

    let cs_a: Bool = jwt_str_eq("jwt_hs256", "jwt_hs256");
    let cs_b: Bool = jwt_str_eq("jwt_hs256", "jwt_hs256");
    if cs_a != cs_b {
        println("FAIL jwt_str_eq");
        process_exit(1);
    }

    let rules_a: JwtValidationRules = jwt_validation_rules_default();
    let rules_b: JwtValidationRules = jwt_validation_rules_default();
    let skew_a: Int = rules_a.clock_skew_seconds;
    let skew_b: Int = rules_b.clock_skew_seconds;
    if skew_a != skew_b {
        println("FAIL jwt_validation_rules_default clock_skew");
        process_exit(1);
    }

    let rules_mod_a: JwtValidationRules = jwt_validation_rules_add_algorithm(rules_a, "RS256");
    let rules_mod_b: JwtValidationRules = jwt_validation_rules_add_algorithm(rules_b, "RS256");
    let active_a: Bool = rules_mod_a.is_active;
    let active_b: Bool = rules_mod_b.is_active;
    if active_a != active_b {
        println("FAIL jwt_validation_rules_add_algorithm is_active");
        process_exit(1);
    }

    let cfg_a: JwtConfig = jwt_config_init("mysecretkey", "HS256", "auth.openooda.org", "api.openooda.org", 3600);
    let cfg_b: JwtConfig = jwt_config_init("mysecretkey", "HS256", "auth.openooda.org", "api.openooda.org", 3600);
    let ttl_a: Int = cfg_a.default_ttl_seconds;
    let ttl_b: Int = cfg_b.default_ttl_seconds;
    if ttl_a != ttl_b {
        println("FAIL jwt_config_init ttl mismatch");
        process_exit(1);
    }

    let valid_cfg_a: Bool = jwt_config_validate(cfg_a);
    let valid_cfg_b: Bool = jwt_config_validate(cfg_b);
    if valid_cfg_a != valid_cfg_b {
        println("FAIL jwt_config_validate mismatch");
        process_exit(1);
    }

    let free_a: JwtConfig = jwt_config_free(cfg_a);
    let free_b: JwtConfig = jwt_config_free(cfg_b);
    let free_valid_a: Bool = free_a.is_valid;
    let free_valid_b: Bool = free_b.is_valid;
    if free_valid_a != free_valid_b {
        println("FAIL jwt_config_free is_valid mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_jwt_token_config: PASSED");
    process_exit(0);
}
