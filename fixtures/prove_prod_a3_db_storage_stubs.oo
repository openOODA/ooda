// # Product prove std/db_storage/db_storage_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts db_storage_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/db_storage_stubs.oo.
//
// Beats:
//   1. Call db_storage_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_db_storage_stubs: PASSED only if they match.

import "std/db_storage/db_storage_stubs.oo";

pub fn main() {
    let db_storage_stubs_mark: Int = 0;
    if db_storage_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = db_storage_fail_closed("x", 0);
    let b: Bool = db_storage_fail_closed("x", 0);
    if a != b {
        println("FAIL db_storage_fail_closed");
        process_exit(1);
    }
    println("prod_db_storage_stubs: PASSED");
}
