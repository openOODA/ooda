// # Call residual ffi_gen
//
// Logline: A bare call to ffi_gen is the residual fail rail for that surface.
//
// Beats:
//   1. Invoke the residual name from main.
//   2. Bind the result so the call is live.
//   3. Expect check or emit to refuse the residual.

pub fn main() { let r = ffi_gen("C"); }
