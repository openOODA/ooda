// # Product prove std/synthetic_biology/synchronized_quorum_oscillator.oo
//
// Logline: Fail-closed emit+check asserts danino_hill_act is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/synchronized_quorum_oscillator.oo.
//
// Beats:
//   1. Call danino_hill_act twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_synchronized_quorum_oscillator: PASSED only if they match.

import "std/synthetic_biology/synchronized_quorum_oscillator.oo";

pub fn main() {
    let synchronized_quorum_oscillator_mark: Int = 0;
    if synchronized_quorum_oscillator_mark != 0 { process_exit(1); }
    let a: Float = danino_hill_act(1.0, 0.5, 0.1);
    let b: Float = danino_hill_act(1.0, 0.5, 0.1);
    if a != b { process_exit(1); }
    println("prod_synchronized_quorum_oscillator: PASSED");
}
