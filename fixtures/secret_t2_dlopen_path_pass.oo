// # Allow public dlopen path
//
// Logline: Call dlopen with a public path while an unused secret name sits nearby.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call dlopen with a public path and flag 0.
//   3. Print 1 after the call.
//
// T2-4 control: dlopen public path with unrelated SECRET tag — must ALLOW path
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "s3cret";
    let r = dlopen(ffi, "libx.so", 0);
    println(1);
}
