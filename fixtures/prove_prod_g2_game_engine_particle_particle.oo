// # Product prove std/game_engine/particle_particle.oo
//
// Logline: Fail-closed emit+gcc+run asserts particle_is_alive is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/particle_particle.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call particle_is_alive twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_particle_particle: PASSED only if they match.

import "std/game_engine/particle_particle.oo";

pub fn main() {
    let g2_oa: Particle = Particle { x: 1.0, y: 1.0, z: 1.0, vx: 1.0, vy: 1.0, vz: 1.0, ax: 1.0, ay: 1.0, az: 1.0, size: 1.0, alpha: 1.0, r: 1.0, g: 1.0, b: 1.0, age: 1.0, life: 1.0, active: 2 };
    let g2_ob: Particle = Particle { x: 1.0, y: 1.0, z: 1.0, vx: 1.0, vy: 1.0, vz: 1.0, ax: 1.0, ay: 1.0, az: 1.0, size: 1.0, alpha: 1.0, r: 1.0, g: 1.0, b: 1.0, age: 1.0, life: 1.0, active: 2 };
    let g2_a = particle_is_alive(&g2_oa);
    let g2_b = particle_is_alive(&g2_ob);
    if g2_a != g2_b {
        println("FAIL particle_is_alive");
        process_exit(1);
    }
    println("prod_g2_particle_particle: PASSED");
}
