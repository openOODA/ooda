// # Product prove std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_nic_to_app_latency is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compute_nic_to_app_latency twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_itch_ouch_clock_sync_ptp: PASSED only if they match.

import "std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo";

pub fn main() {
    let g2_oa: NicTimestampTelemetry = NicTimestampTelemetry { nic_ingress_ts_ns: 2, kernel_ts_ns: 2, app_ingress_ts_ns: 2, app_egress_ts_ns: 2, nic_egress_ts_ns: 2 };
    let g2_ob: NicTimestampTelemetry = NicTimestampTelemetry { nic_ingress_ts_ns: 2, kernel_ts_ns: 2, app_ingress_ts_ns: 2, app_egress_ts_ns: 2, nic_egress_ts_ns: 2 };
    let g2_a = compute_nic_to_app_latency(&g2_oa);
    let g2_b = compute_nic_to_app_latency(&g2_ob);
    if g2_a != g2_b {
        println("FAIL compute_nic_to_app_latency");
        process_exit(1);
    }
    println("prod_g2_itch_ouch_clock_sync_ptp: PASSED");
}
