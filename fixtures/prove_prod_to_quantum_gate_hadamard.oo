// # Product prove std/quantum/gate_hadamard.oo
//
// Logline: Fail-closed emit+gcc+run asserts hadamard_is_hermitian holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_hadamard.oo.
//
// Beats:
//   1. Call hadamard_is_hermitian using the gate_hadamard ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_gate_hadamard: PASSED only if asserts hold.

import "std/quantum/gate_hadamard.oo";

pub fn main() {
    let gate_hadamard_a = hadamard_is_hermitian();
    if !gate_hadamard_a {
        println("FAIL hadamard_is_hermitian");
        process_exit(1);
    }
    println("prod_gate_hadamard: PASSED");
}
