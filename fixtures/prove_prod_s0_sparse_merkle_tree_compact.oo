// # Product prove std/zk_rollup/sparse_merkle_tree_compact.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_compact_node_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_compact.oo.
//
// Beats:
//   1. Call smt_compact_node_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_sparse_merkle_tree_compact: PASSED only if asserts hold.

import "std/zk_rollup/sparse_merkle_tree_compact.oo";

pub fn main() {
    let sparse_merkle_tree_compact_a: SmtCompactNode = smt_compact_node_new(0, "x", "x", true);
    let sparse_merkle_tree_compact_b: SmtCompactNode = smt_compact_node_new(0, "x", "x", true);
    if sparse_merkle_tree_compact_a.bit_depth != sparse_merkle_tree_compact_b.bit_depth {
        println("FAIL smt_compact_node_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_compact: PASSED");
}
