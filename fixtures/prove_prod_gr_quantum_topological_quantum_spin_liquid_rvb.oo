// # Product prove std/quantum_topological/quantum_spin_liquid_rvb.oo
//
// Logline: Fail-closed emit+gcc+run asserts rvb_overlap_loop_factor is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_spin_liquid_rvb.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call rvb_overlap_loop_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_quantum_spin_liquid_rvb: PASSED only if they match.

import "std/quantum_topological/quantum_spin_liquid_rvb.oo";

pub fn main() {
    let g0_a = rvb_overlap_loop_factor(0);
    let g0_b = rvb_overlap_loop_factor(0);
    if g0_a != g0_b {
        println("FAIL rvb_overlap_loop_factor");
        process_exit(1);
    }
    println("prod_gr_quantum_spin_liquid_rvb: PASSED");
}
