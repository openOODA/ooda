// # Product prove std/fintech_l3_book/l3_market_depth_ladder.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth_ladder_compute_vwap is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_market_depth_ladder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call depth_ladder_compute_vwap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_market_depth_ladder: PASSED only if they match.

import "std/fintech_l3_book/l3_market_depth_ladder.oo";

pub fn main() {
    let g2_oa = depth_ladder_new("x", "x");
    let g2_ob = depth_ladder_new("x", "x");
    let g2_a = depth_ladder_compute_vwap(&g2_oa);
    let g2_b = depth_ladder_compute_vwap(&g2_ob);
    if g2_a != g2_b {
        println("FAIL depth_ladder_compute_vwap");
        process_exit(1);
    }
    println("prod_g2_l3_market_depth_ladder: PASSED");
}
