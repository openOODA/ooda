// # Product prove std/auto_robot/pointcloud_cluster_euclidean.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/pointcloud_cluster_euclidean.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_cluster_euclidean.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pointcloud_cluster_euclidean: PASSED only if they match.

import "std/auto_robot/pointcloud_cluster_euclidean.oo";

pub fn main() {
    let pointcloud_cluster_euclidean_a = euc_dist_sq(0, 0);
    let pointcloud_cluster_euclidean_b = euc_dist_sq(0, 0);
    if pointcloud_cluster_euclidean_a != pointcloud_cluster_euclidean_b {
        println("FAIL pointcloud_cluster_euclidean");
        process_exit(1);
    }
    println("prod_ap_pointcloud_cluster_euclidean: PASSED");
}
