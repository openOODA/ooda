// # Product prove std/net/dns.oo
//
// Logline: Fail-closed emit+gcc+run asserts dns_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/dns.oo.
//
// Beats:
//   1. Call dns_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dns: PASSED only if they match.

import "std/net/dns.oo";

pub fn main() {
    let a = dns_probe();
    let b = dns_probe();
    if a != b {
        println("FAIL dns_probe");
        process_exit(1);
    }
    println("prod_dns: PASSED");
}
