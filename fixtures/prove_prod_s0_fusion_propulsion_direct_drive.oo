// # Product prove std/space_propulsion/fusion_propulsion_direct_drive.oo
//
// Logline: Fail-closed emit+gcc+run asserts direct_fusion_spec_default_d_he3 value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/fusion_propulsion_direct_drive.oo.
//
// Beats:
//   1. Call direct_fusion_spec_default_d_he3 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_fusion_propulsion_direct_drive: PASSED only if asserts hold.

import "std/space_propulsion/fusion_propulsion_direct_drive.oo";

pub fn main() {
    let fusion_propulsion_direct_drive_a: DirectFusionSpec = direct_fusion_spec_default_d_he3();
    let fusion_propulsion_direct_drive_b: DirectFusionSpec = direct_fusion_spec_default_d_he3();
    if fusion_propulsion_direct_drive_a.fusion_fuel_type != fusion_propulsion_direct_drive_b.fusion_fuel_type {
        println("FAIL direct_fusion_spec_default_d_he3");
        process_exit(1);
    }
    println("prod_fusion_propulsion_direct_drive: PASSED");
}
