// # Product prove std/sec/sys/secure_boot_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/secure_boot_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_secure_boot_types: PASSED only if they match.

import "std/sec/sys/secure_boot_types.oo";

pub fn main() {
    let secure_boot_types_a = sboot_violation_new(0, 0);
    let secure_boot_types_b = sboot_violation_new(0, 0);
    let secure_boot_types_va = sboot_violation_type(secure_boot_types_a);
    let secure_boot_types_vb = sboot_violation_type(secure_boot_types_b);
    if secure_boot_types_va != secure_boot_types_vb {
        println("FAIL secure_boot_types");
        process_exit(1);
    }
    println("prod_ap_secure_boot_types: PASSED");
}
