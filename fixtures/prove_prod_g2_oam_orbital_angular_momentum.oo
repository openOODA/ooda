// # Product prove std/telecom_6g/oam_orbital_angular_momentum.oo
//
// Logline: Fail-closed emit+gcc+run asserts oam_mode_orthogonality_check is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/oam_orbital_angular_momentum.oo.
//
// Beats:
//   1. Call oam_mode_orthogonality_check twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_oam_orbital_angular_momentum: PASSED only if they match.

import "std/telecom_6g/oam_orbital_angular_momentum.oo";

pub fn main() {
    let oam_orbital_angular_momentum_mark: Int = 0;
    if oam_orbital_angular_momentum_mark != 0 {
        process_exit(1);
    }
    let a: Float = oam_mode_orthogonality_check(0, 0);
    let b: Float = oam_mode_orthogonality_check(0, 0);
    if a != b {
        println("FAIL oam_mode_orthogonality_check");
        process_exit(1);
    }
    println("prod_g2_oam_orbital_angular_momentum: PASSED");
}
