// # Mutation Sweep on Real Std Modules
//
// Logline: Reads the actual .oo source bytes of rational_exact, fixed_point_q32, interval_domain, and algebraic_invariants, then runs the 4-mutator sweep and reports per-module kill rates.
//
// Setup: Requires &FsReadCap to read module source files. Uses file_reader_open + file_reader_read_all to load each module's source as a String, then converts to bytes for mut_run_all.
//
// Beats:
//   1. Open and read each of the 4 std module files via FsReadCap.
//   2. Run mut_run_all on each module's actual source bytes.
//   3. Compute the per-module kill rate and report an OVERALL roll-up.
//   4. Assert OVERALL kill rate >= 95% (rigorous).

import "std/fs/file_reader.oo";
import "qa/mutation/mutation_operators.oo";
import "qa/mutation/mutation_runner.oo";
import "qa/mutation/mutation_scorecard.oo";

pub fn string_to_bytes(s: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = bytes_len(s);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, byte_at(s, i));
        i = i + 1;
    }
    return out;
}

pub fn path_empty(s: String) -> Bool {
    let n: Int = bytes_len(s);
    if n == 0 { return true; }
    return false;
}

pub fn read_module_bytes(fs: &FsReadCap, path: String) -> List[Int] {
    let open_res: Result[FileReader, String] = file_reader_open(fs, path);
    let is_open_err: Bool = open_res.is_err();
    if is_open_err { return list_new(); }
    // Use a default-value pattern: result_unwrap_or provides a fallback.
    // We don't have direct unwrap, so use the Ok path explicitly.
    let reader: FileReader = match open_res {
        Ok(r) => r
        Err(e) => r_dummy_reader()
    };
    let content_res: Result[String, String] = file_reader_read_all(fs, reader);
    let is_content_err: Bool = content_res.is_err();
    if is_content_err { return list_new(); }
    let content: String = match content_res {
        Ok(s) => s
        Err(e) => ""
    };
    return string_to_bytes(content);
}

pub fn r_dummy_reader() -> FileReader {
    let r: FileReader = FileReader { path: "", is_open: false };
    return r;
}

pub fn sweep_real(fs: &FsReadCap, name: String, path: String) -> List[Int] {
    let src: List[Int] = read_module_bytes(fs, path);
    let src_len: Int = list_len(src);
    if src_len == 0 {
        let mut err: List[Int] = list_new();
        err = list_push(err, 0);
        err = list_push(err, 0);
        err = list_push(err, 0);
        err = list_push(err, 0);
        let line: String = name + " EMPTY_OR_ERROR";
        println(line);
        return err;
    }
    let summary: List[Int] = mut_run_all(src);
    let score: List[Int] = mut_score(summary);
    let total: Int = list_get(score, 0);
    let killed: Int = list_get(score, 1);
    let rate: Int = list_get(score, 2);
    let pass: Int = list_get(score, 3);
    let line: String = name + " bytes=" + src_len.to_string() + " total=" + total.to_string() + " killed=" + killed.to_string() + " rate=" + rate.to_string() + "% rigorous=" + pass.to_string();
    println(line);
    return score;
}

pub fn main(fs: &FsReadCap) -> Int {
    let p1: String = "std/math_exact/rational_exact.oo";
    let p2: String = "std/math_exact/fixed_point_q32.oo";
    let p3: String = "std/formal_verif/interval_domain.oo";
    let p4: String = "std/algebra/algebraic_invariants.oo";
    let r1: List[Int] = sweep_real(fs, "rational_exact", p1);
    let r2: List[Int] = sweep_real(fs, "fixed_point_q32", p2);
    let r3: List[Int] = sweep_real(fs, "interval_domain", p3);
    let r4: List[Int] = sweep_real(fs, "algebraic_invariants", p4);
    let t1: Int = list_get(r1, 0);
    let t2: Int = list_get(r2, 0);
    let t3: Int = list_get(r3, 0);
    let t4: Int = list_get(r4, 0);
    let k1: Int = list_get(r1, 1);
    let k2: Int = list_get(r2, 1);
    let k3: Int = list_get(r3, 1);
    let k4: Int = list_get(r4, 1);
    let total: Int = t1 + t2 + t3 + t4;
    let killed: Int = k1 + k2 + k3 + k4;
    if total == 0 {
        println("OVERALL FAILED no mutators fired");
        return 1;
    }
    let rate: Int = (killed * 100) / total;
    println("OVERALL total=" + total.to_string() + " killed=" + killed.to_string() + " rate=" + rate.to_string() + "%");
    if rate >= 95 {
        println("mutation_sweep_real: PASSED rigorous");
        return 0;
    }
    println("mutation_sweep_real: BELOW_THRESHOLD");
    return 1;
}
