// # Product prove std/sec/sys/landlock_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_types_module_loaded is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/landlock_types.oo.
//
// Beats:
//   1. Call landlock_types_module_loaded twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_landlock_types: PASSED only if they match.

import "std/sec/sys/landlock_types.oo";

pub fn main() {
    let a = landlock_types_module_loaded();
    let b = landlock_types_module_loaded();
    if a != b {
        println("FAIL landlock_types_module_loaded");
        process_exit(1);
    }
    println("prod_landlock_types: PASSED");
}
