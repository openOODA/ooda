// # Product prove std/media_dsp/jpeg_huffman_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts jpeg_extend_sign is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/jpeg_huffman_decoder.oo.
//
// Beats:
//   1. Call jpeg_extend_sign twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jpeg_huffman_decoder: PASSED only if they match.

import "std/media_dsp/jpeg_huffman_decoder.oo";

pub fn main() {
    let jpeg_huffman_decoder_mark: Int = 0;
    if jpeg_huffman_decoder_mark != 0 {
        process_exit(1);
    }
    let jpeg_huffman_decoder_a: Int = jpeg_extend_sign(1, 1);
    let jpeg_huffman_decoder_b: Int = jpeg_extend_sign(1, 1);
    if jpeg_huffman_decoder_a != jpeg_huffman_decoder_b {
        println("FAIL jpeg_extend_sign");
        process_exit(1);
    }
    println("prod_jpeg_huffman_decoder: PASSED");
}
