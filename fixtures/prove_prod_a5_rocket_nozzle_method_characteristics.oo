// # Product prove std/space_propulsion/rocket_nozzle_method_characteristics.oo
//
// Logline: Fail-closed emit+gcc+run asserts rao_nozzle_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_nozzle_method_characteristics.oo.
//
// Beats:
//   1. Call rao_nozzle_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_nozzle_method_characteristics: PASSED only if they match.

import "std/space_propulsion/rocket_nozzle_method_characteristics.oo";

pub fn main() {
    let rocket_nozzle_method_characteristics_mark: Int = 0;
    if rocket_nozzle_method_characteristics_mark != 0 {
        process_exit(1);
    }
    let a: RaoNozzleSpec = rao_nozzle_spec_default();
    let b: RaoNozzleSpec = rao_nozzle_spec_default();
    if (a).r_throat_m != (b).r_throat_m {
        println("FAIL rao_nozzle_spec_default");
        process_exit(1);
    }
    println("prod_rocket_nozzle_method_characteristics: PASSED");
}
