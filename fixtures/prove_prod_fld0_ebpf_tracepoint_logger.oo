// # Product prove std/mesh_ebpf/ebpf_tracepoint_logger.oo
//
// Logline: Fail-closed emit+gcc+run asserts tracepoint_logger_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_tracepoint_logger.oo.
//
// Beats:
//   1. Call tracepoint_logger_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_tracepoint_logger: PASSED only if they match.

import "std/mesh_ebpf/ebpf_tracepoint_logger.oo";

pub fn main() {
    let ebpf_tracepoint_logger_mark: Int = 0;
    if ebpf_tracepoint_logger_mark != 0 {
        process_exit(1);
    }
    let ebpf_tracepoint_logger_a: TracepointLoggerState = tracepoint_logger_new();
    let ebpf_tracepoint_logger_b: TracepointLoggerState = tracepoint_logger_new();
    if (ebpf_tracepoint_logger_a).events_logged != (ebpf_tracepoint_logger_b).events_logged {
        println("FAIL tracepoint_logger_new");
        process_exit(1);
    }
    println("prod_ebpf_tracepoint_logger: PASSED");
}
