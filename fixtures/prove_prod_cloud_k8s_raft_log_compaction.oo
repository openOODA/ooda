// # Product prove std/cloud_k8s/raft_log_compaction.oo
//
// Logline: Fail-closed emit+gcc+run asserts compacted_raft_log_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/raft_log_compaction.oo.
//
// Beats:
//   1. Call compacted_raft_log_new twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_raft_log_compaction: PASSED only if they match.

import "std/cloud_k8s/raft_log_compaction.oo";

pub fn main() {
    let cloud_k8s_raft_log_compaction_mark: Int = 0;
    if cloud_k8s_raft_log_compaction_mark != 0 {
        process_exit(1);
    }
    let a: CompactedRaftLog = compacted_raft_log_new();
    let b: CompactedRaftLog = compacted_raft_log_new();
    if (a).base_index != (b).base_index {
        println("FAIL compacted_raft_log_new");
        process_exit(1);
    }
    println("prod_raft_log_compaction: PASSED");
}
