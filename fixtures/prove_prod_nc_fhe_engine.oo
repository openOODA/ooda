// # Product prove std/crypto/fhe_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_engine.oo.
//
// Beats:
//   1. Call fhe_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fhe_engine: PASSED only if it matches.

import "std/crypto/fhe_engine.oo";

pub fn main() {
    let a: Int = fhe_engine_probe();
    if a != 0 {
        println("FAIL fhe_engine_probe");
        process_exit(1);
    }
    println("prod_nc_fhe_engine: PASSED");
}
