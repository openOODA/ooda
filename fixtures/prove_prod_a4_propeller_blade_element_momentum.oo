// # Product prove std/physics_advanced/propeller_blade_element_momentum.oo
//
// Logline: Fail-closed emit+gcc+run asserts bem_prandtl_tip_loss is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/propeller_blade_element_momentum.oo.
//
// Beats:
//   1. Call bem_prandtl_tip_loss twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propeller_blade_element_momentum: PASSED only if they match.

import "std/physics_advanced/propeller_blade_element_momentum.oo";

pub fn main() {
    let propeller_blade_element_momentum_mark: Int = 0;
    if propeller_blade_element_momentum_mark != 0 {
        process_exit(1);
    }
    let a: Float = bem_prandtl_tip_loss(0.0, 0.0, 0, 0.0);
    let b: Float = bem_prandtl_tip_loss(0.0, 0.0, 0, 0.0);
    if a != b {
        println("FAIL bem_prandtl_tip_loss");
        process_exit(1);
    }
    println("prod_propeller_blade_element_momentum: PASSED");
}
