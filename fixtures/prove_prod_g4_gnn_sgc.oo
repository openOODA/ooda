// # Product prove std/graph_gnn/gnn_sgc_simplifying_graph_conv.oo
//
// Logline: Fail-closed verification that SGC model initialization, configuration, and node predictions are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_sgc_simplifying_graph_conv.oo.
//
// Beats:
//   1. Construct SGCConfig and initialize weight matrices with deterministic seed.
//   2. Run sgc_predict_node on sample precomputed features.
//   3. Assert deterministic return values.
//   4. Print prod_g4_gnn_sgc: PASSED only if all match.

import "std/graph_gnn/gnn_sgc_simplifying_graph_conv.oo";

pub fn main() {
    let cfg1: SGCConfig = sgc_config_new(4, 2, 2, 10);
    let cfg2: SGCConfig = sgc_config_new(4, 2, 2, 10);
    if cfg1.in_features != cfg2.in_features {
        println("FAIL sgc_config_new in_features");
        process_exit(1);
    }
    if cfg1.out_features != cfg2.out_features {
        println("FAIL sgc_config_new out_features");
        process_exit(1);
    }
    if cfg1.k_hops != cfg2.k_hops {
        println("FAIL sgc_config_new k_hops");
        process_exit(1);
    }

    let w1: List[Int] = sgc_init_weights(8, 99);
    let w2: List[Int] = sgc_init_weights(8, 99);

    let mut b1: List[Int] = list_new();
    b1 = list_push(b1, 0);
    b1 = list_push(b1, 0);
    let mut b2: List[Int] = list_new();
    b2 = list_push(b2, 0);
    b2 = list_push(b2, 0);

    let mut feats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        feats = list_push(feats, i + 3);
        i = i + 1;
    }

    let preds1: List[Int] = sgc_predict_node(4, 2, w1, b1, feats, 0);
    let preds2: List[Int] = sgc_predict_node(4, 2, w2, b2, feats, 0);

    let len1: Int = list_len(preds1);
    let len2: Int = list_len(preds2);
    if len1 != len2 {
        println("FAIL sgc_predict_node length mismatch");
        process_exit(1);
    }
    if len1 != 2 {
        println("FAIL sgc_predict_node length expected");
        process_exit(1);
    }

    let p0_a: Int = list_get(preds1, 0);
    let p0_b: Int = list_get(preds2, 0);
    if p0_a != p0_b {
        println("FAIL sgc_predict_node p0");
        process_exit(1);
    }

    let p1_a: Int = list_get(preds1, 1);
    let p1_b: Int = list_get(preds2, 1);
    if p1_a != p1_b {
        println("FAIL sgc_predict_node p1");
        process_exit(1);
    }

    println("prod_g4_gnn_sgc: PASSED");
    process_exit(0);
}
