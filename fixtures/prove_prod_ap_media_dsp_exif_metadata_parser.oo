// # Product prove std/media_dsp/exif_metadata_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/exif_metadata_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/exif_metadata_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_exif_metadata_parser: PASSED only if they match.

import "std/media_dsp/exif_metadata_parser.oo";

pub fn main() {
    let exif_metadata_parser_a = exif_tag_image_width();
    let exif_metadata_parser_b = exif_tag_image_width();
    if exif_metadata_parser_a != exif_metadata_parser_b {
        println("FAIL exif_metadata_parser");
        process_exit(1);
    }
    println("prod_ap_exif_metadata_parser: PASSED");
}
