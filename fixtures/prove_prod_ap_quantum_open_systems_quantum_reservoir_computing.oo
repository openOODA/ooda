// # Product prove std/quantum_open_systems/quantum_reservoir_computing.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_reservoir_computing.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_reservoir_computing.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_reservoir_computing: PASSED only if they match.

import "std/quantum_open_systems/quantum_reservoir_computing.oo";

pub fn main() {
    let quantum_reservoir_computing_a = reservoir_state_init();
    let quantum_reservoir_computing_b = reservoir_state_init();
    let quantum_reservoir_computing_va = reservoir_linear_readout(quantum_reservoir_computing_a, 0.0, 0.0, 0.0, 0.0);
    let quantum_reservoir_computing_vb = reservoir_linear_readout(quantum_reservoir_computing_b, 0.0, 0.0, 0.0, 0.0);
    if quantum_reservoir_computing_va != quantum_reservoir_computing_vb {
        println("FAIL quantum_reservoir_computing");
        process_exit(1);
    }
    println("prod_ap_quantum_reservoir_computing: PASSED");
}
