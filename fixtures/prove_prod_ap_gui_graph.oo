// # Product prove std/gui/graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gui/graph.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/graph.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph: PASSED only if they match.

import "std/gui/graph.oo";

pub fn main() {
    let graph_a = graph_view_new(0, 0, 0, 0);
    let graph_b = graph_view_new(0, 0, 0, 0);
    let graph_va = graph_view_project_x(graph_a, 0);
    let graph_vb = graph_view_project_x(graph_b, 0);
    if graph_va != graph_vb {
        println("FAIL graph");
        process_exit(1);
    }
    println("prod_ap_graph: PASSED");
}
