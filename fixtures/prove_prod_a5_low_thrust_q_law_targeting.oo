// # Product prove std/space_propulsion/low_thrust_q_law_targeting.oo
//
// Logline: Fail-closed emit+gcc+run asserts keplerian_elements_leo_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/low_thrust_q_law_targeting.oo.
//
// Beats:
//   1. Call keplerian_elements_leo_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_low_thrust_q_law_targeting: PASSED only if they match.

import "std/space_propulsion/low_thrust_q_law_targeting.oo";

pub fn main() {
    let low_thrust_q_law_targeting_mark: Int = 0;
    if low_thrust_q_law_targeting_mark != 0 {
        process_exit(1);
    }
    let a: KeplerianElements = keplerian_elements_leo_default();
    let b: KeplerianElements = keplerian_elements_leo_default();
    if (a).semi_major_axis_m != (b).semi_major_axis_m {
        println("FAIL keplerian_elements_leo_default");
        process_exit(1);
    }
    println("prod_low_thrust_q_law_targeting: PASSED");
}
