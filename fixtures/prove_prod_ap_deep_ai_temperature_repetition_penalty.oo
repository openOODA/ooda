// # Product prove std/deep_ai/temperature_repetition_penalty.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/temperature_repetition_penalty.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/temperature_repetition_penalty.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_temperature_repetition_penalty: PASSED only if they match.

import "std/deep_ai/temperature_repetition_penalty.oo";

pub fn main() {
    let temperature_repetition_penalty_a = repetition_tracker_new(0);
    let temperature_repetition_penalty_b = repetition_tracker_new(0);
    let temperature_repetition_penalty_va = repetition_tracker_seen(temperature_repetition_penalty_a, 0);
    let temperature_repetition_penalty_vb = repetition_tracker_seen(temperature_repetition_penalty_b, 0);
    if temperature_repetition_penalty_va != temperature_repetition_penalty_vb {
        println("FAIL temperature_repetition_penalty");
        process_exit(1);
    }
    println("prod_ap_temperature_repetition_penalty: PASSED");
}
