import "std/db_storage/btree_concurrent_latch_crabbing.oo";

pub fn main() {
    let g0_a = is_node_safe_for_insert(0, 0);
    let g0_b = is_node_safe_for_insert(0, 0);
    if g0_a != g0_b {
        println("FAIL is_node_safe_for_insert");
        process_exit(1);
    }
    println("prod_gr_btree_concurrent_latch_crabbing: PASSED");
