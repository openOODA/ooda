// # Product prove std/bio/smiles_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts atom_symbol_to_number is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_ops.oo.
//
// Beats:
//   1. Call atom_symbol_to_number twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smiles_ops: PASSED only if they match.

import "std/bio/smiles_ops.oo";

pub fn main() {
    let smiles_ops_mark: Int = 0;
    if smiles_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = atom_symbol_to_number("x");
    let b: Int = atom_symbol_to_number("x");
    if a != b {
        println("FAIL atom_symbol_to_number");
        process_exit(1);
    }
    println("prod_smiles_ops: PASSED");
}
