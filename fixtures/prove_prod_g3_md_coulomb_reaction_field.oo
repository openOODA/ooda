// # Product prove std/protein_folding/md_coulomb_reaction_field.oo
//
// Logline: Fail-closed emit+gcc+run asserts reaction_field_params_water is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_coulomb_reaction_field.oo.
//
// Beats:
//   1. Call reaction_field_params_water twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_coulomb_reaction_field: PASSED only if they match.

import "std/protein_folding/md_coulomb_reaction_field.oo";

pub fn main() {
    let md_coulomb_reaction_field_mark: Int = 0;
    if md_coulomb_reaction_field_mark != 0 {
        process_exit(1);
    }
    let a: ReactionFieldParams = reaction_field_params_water(0.0);
    let b: ReactionFieldParams = reaction_field_params_water(0.0);
    if (a).cutoff_radius_angstrom != (b).cutoff_radius_angstrom {
        println("FAIL reaction_field_params_water");
        process_exit(1);
    }
    println("prod_md_coulomb_reaction_field: PASSED");
}
