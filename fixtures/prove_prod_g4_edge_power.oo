// # Product prove std/edge/power.oo
//
// Logline: Fail-closed emit+gcc+run asserts edge power management operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power.oo.
//
// Beats:
//   1. Initialize battery state and calculate telemetry power consumption.
//   2. Query performance profile and evaluate power governor.
//   3. Assert deterministic return values.
//   4. Print prod_g4_edge_power: PASSED and exit 0.

import "std/edge/power.oo";

pub fn main() {
    let b1: BatteryState = shim_marker_battery_new();
    let b2: BatteryState = shim_marker_battery_new();

    let p1: Int = shim_marker_power_calc(&b1);
    let p2: Int = shim_marker_power_calc(&b2);
    if p1 != p2 || p1 != 24000 {
        println("FAIL shim_marker_power_calc");
        process_exit(1);
    }

    let prof: PowerProfile = shim_marker_profile_perf();
    if (prof).cpu_freq_pct <= 0 {
        println("FAIL shim_marker_profile_perf");
        process_exit(1);
    }

    let cap: &SysCap = 0;
    let mut gov: PowerGovernor = shim_marker_governor_init(cap);
    let mode: Int = shim_marker_governor_eval(&mut gov);
    if mode != 1 {
        println("FAIL shim_marker_governor_eval");
        process_exit(1);
    }

    let crit: Bool = shim_marker_is_critical(&gov);
    if crit != false {
        println("FAIL shim_marker_is_critical");
        process_exit(1);
    }

    println("prod_g4_edge_power: PASSED");
    process_exit(0);
}
