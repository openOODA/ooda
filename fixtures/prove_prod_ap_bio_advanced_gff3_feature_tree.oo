// # Product prove std/bio_advanced/gff3_feature_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/gff3_feature_tree.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/gff3_feature_tree.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gff3_feature_tree: PASSED only if they match.

import "std/bio_advanced/gff3_feature_tree.oo";

pub fn main() {
    let gff3_feature_tree_a = gff3_calc_feature_length(0, 0);
    let gff3_feature_tree_b = gff3_calc_feature_length(0, 0);
    if gff3_feature_tree_a != gff3_feature_tree_b {
        println("FAIL gff3_feature_tree");
        process_exit(1);
    }
    println("prod_ap_gff3_feature_tree: PASSED");
}
