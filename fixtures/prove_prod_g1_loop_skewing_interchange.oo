// # Product prove std/compilers_polyhedral/loop_skewing_interchange.oo
//
// Logline: Fail-closed emit+gcc+run asserts unimodular_2x2_determinant is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/loop_skewing_interchange.oo.
//
// Beats:
//   1. Call unimodular_2x2_determinant twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_loop_skewing_interchange: PASSED only if they match.

import "std/compilers_polyhedral/loop_skewing_interchange.oo";

pub fn main() {
    let obj_a: UnimodularMatrix2x2 = unimodular_2x2_identity();
    let obj_b: UnimodularMatrix2x2 = unimodular_2x2_identity();
    let a: Int = unimodular_2x2_determinant(obj_a);
    let b: Int = unimodular_2x2_determinant(obj_b);
    if a != b {
        println("FAIL unimodular_2x2_determinant");
        process_exit(1);
    }
    println("prod_loop_skewing_interchange: PASSED");
}
