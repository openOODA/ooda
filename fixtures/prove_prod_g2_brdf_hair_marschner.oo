// # Product prove std/pbr_raytracing/brdf_hair_marschner.oo
//
// Logline: Fail-closed emit+gcc+run asserts hair_gaussian_lobe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_hair_marschner.oo.
//
// Beats:
//   1. Call hair_gaussian_lobe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_brdf_hair_marschner: PASSED only if they match.

import "std/pbr_raytracing/brdf_hair_marschner.oo";

pub fn main() {
    let brdf_hair_marschner_mark: Int = 0;
    if brdf_hair_marschner_mark != 0 {
        process_exit(1);
    }
    let a: Float = hair_gaussian_lobe(0.0, 0.0, 0.0);
    let b: Float = hair_gaussian_lobe(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL hair_gaussian_lobe");
        process_exit(1);
    }
    println("prod_g2_brdf_hair_marschner: PASSED");
}
