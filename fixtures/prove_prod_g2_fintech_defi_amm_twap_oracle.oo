// # Product prove std/fintech_defi/amm_twap_oracle.oo
//
// Logline: Fail-closed emit+gcc+run asserts twap_observation_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_twap_oracle.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call twap_observation_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_amm_twap_oracle: PASSED only if they match.

import "std/fintech_defi/amm_twap_oracle.oo";

pub fn main() {
    let g2_oa: TwapObservation = twap_observation_new(2, 2, 2);
    let g2_ob: TwapObservation = twap_observation_new(2, 2, 2);
    let g2_a = (g2_oa).timestamp_sec;
    let g2_b = (g2_ob).timestamp_sec;
    if g2_a != g2_b {
        println("FAIL twap_observation_new.timestamp_sec");
        process_exit(1);
    }
    println("prod_g2_amm_twap_oracle: PASSED");
}
