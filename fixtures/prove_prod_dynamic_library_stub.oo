// # Product prove std/os/dynamic_library_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts dynlib_path is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/dynamic_library_stub.oo.
//
// Beats:
//   1. Call dynlib_path twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dynamic_library_stub: PASSED only if they match.

import "std/os/dynamic_library_stub.oo";

pub fn main() {
    let obj = dynlib_desc_new("x");
    let a = dynlib_path(obj);
    let b = dynlib_path(obj);
    if a != b {
        println("FAIL dynlib_path");
        process_exit(1);
    }
    println("prod_dynamic_library_stub: PASSED");
}
