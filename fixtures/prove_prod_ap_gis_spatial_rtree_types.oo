// # Product prove std/gis_spatial/rtree_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/rtree_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/rtree_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rtree_types: PASSED only if they match.

import "std/gis_spatial/rtree_types.oo";

pub fn main() {
    let rtree_types_a = rtree_box_new(0, 0);
    let rtree_types_b = rtree_box_new(0, 0);
    let rtree_types_va = rtree_box_min_x(rtree_types_a);
    let rtree_types_vb = rtree_box_min_x(rtree_types_b);
    if rtree_types_va != rtree_types_vb {
        println("FAIL rtree_types");
        process_exit(1);
    }
    println("prod_ap_rtree_types: PASSED");
}
