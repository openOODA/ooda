// # Product prove std/astro_advanced/attitude_control_moment_gyro.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/attitude_control_moment_gyro.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_control_moment_gyro.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_control_moment_gyro: PASSED only if they match.

import "std/astro_advanced/attitude_control_moment_gyro.oo";

pub fn main() {
    let attitude_control_moment_gyro_a = cmg_gimbal_rate(0);
    let attitude_control_moment_gyro_b = cmg_gimbal_rate(0);
    if attitude_control_moment_gyro_a != attitude_control_moment_gyro_b {
        println("FAIL attitude_control_moment_gyro");
        process_exit(1);
    }
    println("prod_ap_attitude_control_moment_gyro: PASSED");
}
