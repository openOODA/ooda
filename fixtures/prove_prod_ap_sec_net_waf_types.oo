// # Product prove std/sec/net/waf_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/waf_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_waf_types: PASSED only if they match.

import "std/sec/net/waf_types.oo";

pub fn main() {
    let waf_types_a = str_eq("x", "x");
    let waf_types_b = str_eq("x", "x");
    if waf_types_a != waf_types_b {
        println("FAIL waf_types");
        process_exit(1);
    }
    println("prod_ap_waf_types: PASSED");
}
