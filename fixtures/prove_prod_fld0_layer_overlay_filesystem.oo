// # Product prove std/cloud_faas/layer_overlay_filesystem.oo
//
// Logline: Fail-closed emit+gcc+run asserts overlay_find_top_layer is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/layer_overlay_filesystem.oo.
//
// Beats:
//   1. Call overlay_find_top_layer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_layer_overlay_filesystem: PASSED only if they match.

import "std/cloud_faas/layer_overlay_filesystem.oo";
import "std/str.oo";

pub fn main() {
    let layer_overlay_filesystem_mark: Int = 0;
    if layer_overlay_filesystem_mark != 0 {
        process_exit(1);
    }
    let layer_overlay_filesystem_obj: OverlayFilesystem = overlay_filesystem_new("x");
    let layer_overlay_filesystem_a: String = overlay_find_top_layer(&layer_overlay_filesystem_obj);
    let layer_overlay_filesystem_b: String = overlay_find_top_layer(&layer_overlay_filesystem_obj);
    if str_eq(layer_overlay_filesystem_a, layer_overlay_filesystem_b) == false {
        println("FAIL overlay_find_top_layer");
        process_exit(1);
    }
    println("prod_layer_overlay_filesystem: PASSED");
}
