// # Product prove std/wasm_gc/jit_code_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts jit_code_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_code_buffer.oo.
//
// Beats:
//   1. Call jit_code_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jit_code_buffer: PASSED only if they match.

import "std/wasm_gc/jit_code_buffer.oo";

pub fn main() {
    let a: JitCodeBuffer = jit_code_buffer_new(0);
    let b: JitCodeBuffer = jit_code_buffer_new(0);
    if (a).byte_count != (b).byte_count {
        println("FAIL jit_code_buffer_new");
        process_exit(1);
    }
    println("prod_g2_jit_code_buffer: PASSED");
}
