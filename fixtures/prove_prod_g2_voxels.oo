// # Product prove std/3d/voxels.oo
//
// Logline: Fail-closed emit+gcc+run asserts voxel_grid_slot_match is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/voxels.oo.
//
// Beats:
//   1. Call voxel_grid_slot_match twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_voxels: PASSED only if they match.

import "std/3d/voxels.oo";

pub fn main() {
    let voxels_mark: Int = 0;
    if voxels_mark != 0 {
        process_exit(1);
    }
    let a: Int = voxel_grid_slot_match(0, 0, 0, 0, 0, 0, 0);
    let b: Int = voxel_grid_slot_match(0, 0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL voxel_grid_slot_match");
        process_exit(1);
    }
    println("prod_g2_voxels: PASSED");
}
