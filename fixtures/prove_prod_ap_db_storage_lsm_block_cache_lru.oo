// # Product prove std/db_storage/lsm_block_cache_lru.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/lsm_block_cache_lru.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_block_cache_lru.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_lsm_block_cache_lru: PASSED only if they match.

import "std/db_storage/lsm_block_cache_lru.oo";

pub fn main() {
    let lsm_block_cache_lru_a = block_cache_config_default();
    let lsm_block_cache_lru_b = block_cache_config_default();
    if lsm_block_cache_lru_a.capacity_bytes != lsm_block_cache_lru_b.capacity_bytes {
        println("FAIL lsm_block_cache_lru");
        process_exit(1);
    }
    println("prod_ap_lsm_block_cache_lru: PASSED");
}
