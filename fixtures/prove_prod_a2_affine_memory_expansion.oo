// # Product prove std/compilers_polyhedral/affine_memory_expansion.oo
//
// Logline: Fail-closed emit+gcc+run asserts variable_expansion_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_memory_expansion.oo.
//
// Beats:
//   1. Call variable_expansion_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_affine_memory_expansion: PASSED only if they match.

import "std/compilers_polyhedral/affine_memory_expansion.oo";

pub fn main() {
    let affine_memory_expansion_mark: Int = 0;
    if affine_memory_expansion_mark != 0 {
        process_exit(1);
    }
    let a: VariableExpansionPlan = variable_expansion_plan_new("x", 0, 0);
    let b: VariableExpansionPlan = variable_expansion_plan_new("x", 0, 0);
    if (a).original_rank != (b).original_rank {
        println("FAIL variable_expansion_plan_new");
        process_exit(1);
    }
    println("prod_affine_memory_expansion: PASSED");
}
