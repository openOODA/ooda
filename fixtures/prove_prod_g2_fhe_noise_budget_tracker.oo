// # Product prove std/fhe_lattices/fhe_noise_budget_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts noise_budget_tracker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_noise_budget_tracker.oo.
//
// Beats:
//   1. Call noise_budget_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_noise_budget_tracker: PASSED only if they match.

import "std/fhe_lattices/fhe_noise_budget_tracker.oo";

pub fn main() {
    let fhe_noise_budget_tracker_mark: Int = 0;
    if fhe_noise_budget_tracker_mark != 0 {
        process_exit(1);
    }
    let a: NoiseBudgetTracker = noise_budget_tracker_new(0.0, 0.0);
    let b: NoiseBudgetTracker = noise_budget_tracker_new(0.0, 0.0);
    if (a).initial_budget_bits != (b).initial_budget_bits {
        println("FAIL noise_budget_tracker_new");
        process_exit(1);
    }
    println("prod_g2_fhe_noise_budget_tracker: PASSED");
}
