// # Product prove std/fintech_defi/options_barrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts barrier_norm_pdf is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/options_barrier.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call barrier_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_options_barrier: PASSED only if they match.

import "std/fintech_defi/options_barrier.oo";

pub fn main() {
    let g0_a = barrier_norm_pdf(0.0);
    let g0_b = barrier_norm_pdf(0.0);
    if g0_a != g0_b {
        println("FAIL barrier_norm_pdf");
        process_exit(1);
    }
    println("prod_gr_options_barrier: PASSED");
}
