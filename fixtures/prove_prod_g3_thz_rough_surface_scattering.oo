// # Product prove std/telecom_6g/thz_rough_surface_scattering.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_rayleigh_roughness_parameter is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_rough_surface_scattering.oo.
//
// Beats:
//   1. Call thz_rayleigh_roughness_parameter twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_rough_surface_scattering: PASSED only if they match.

import "std/telecom_6g/thz_rough_surface_scattering.oo";

pub fn main() {
    let thz_rough_surface_scattering_mark: Int = 0;
    if thz_rough_surface_scattering_mark != 0 {
        process_exit(1);
    }
    let a: Float = thz_rayleigh_roughness_parameter(0.0, 0.0, 0.0);
    let b: Float = thz_rayleigh_roughness_parameter(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL thz_rayleigh_roughness_parameter");
        process_exit(1);
    }
    println("prod_thz_rough_surface_scattering: PASSED");
}
