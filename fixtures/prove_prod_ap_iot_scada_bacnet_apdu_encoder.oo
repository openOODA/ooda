// # Product prove std/iot_scada/bacnet_apdu_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/bacnet_apdu_encoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_apdu_encoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bacnet_apdu_encoder: PASSED only if they match.

import "std/iot_scada/bacnet_apdu_encoder.oo";

pub fn main() {
    let bacnet_apdu_encoder_a = bacnet_service_read_property();
    let bacnet_apdu_encoder_b = bacnet_service_read_property();
    if bacnet_apdu_encoder_a != bacnet_apdu_encoder_b {
        println("FAIL bacnet_apdu_encoder");
        process_exit(1);
    }
    println("prod_ap_bacnet_apdu_encoder: PASSED");
}
