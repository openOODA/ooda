// # Product prove std/net/http_request.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_request_parse_method is a real value.
//
// Setup: Isolated emit-c. Imports std/net/http_request.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call http_request_parse_method twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_http_request: PASSED only if they match.

import "std/net/http_request.oo";

pub fn main() {
    let g2_a = http_request_parse_method("x");
    let g2_b = http_request_parse_method("x");
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL http_request_parse_method");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL http_request_parse_method");
        process_exit(1);
    }
    println("prod_g2_http_request: PASSED");
}
