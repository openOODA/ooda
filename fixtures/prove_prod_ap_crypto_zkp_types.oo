// # Product prove std/crypto/zkp_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/zkp_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zkp_types: PASSED only if they match.

import "std/crypto/zkp_types.oo";

pub fn main() {
    let zkp_types_a = pedersen_commit(0, 0, 0, 0, 0);
    let zkp_types_b = pedersen_commit(0, 0, 0, 0, 0);
    let zkp_types_va = pedersen_opening(zkp_types_a);
    let zkp_types_vb = pedersen_opening(zkp_types_b);
    if zkp_types_va != zkp_types_vb {
        println("FAIL zkp_types");
        process_exit(1);
    }
    println("prod_ap_zkp_types: PASSED");
}
