// # Product prove std/fintech_l3_book/nasdaq_itch50_messages.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fintech_l3_book/nasdaq_itch50_messages.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_messages.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_nasdaq_itch50_messages: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_messages.oo";

pub fn main() {
    let nasdaq_itch50_messages_a = itch_message_payload_size("x");
    let nasdaq_itch50_messages_b = itch_message_payload_size("x");
    if nasdaq_itch50_messages_a != nasdaq_itch50_messages_b {
        println("FAIL nasdaq_itch50_messages");
        process_exit(1);
    }
    println("prod_ap_nasdaq_itch50_messages: PASSED");
}
