// # Product prove std/auto_mpc_control/abs_slip_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts abs_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/abs_slip_controller.oo.
//
// Beats:
//   1. Call abs_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abs_slip_controller: PASSED only if they match.

import "std/auto_mpc_control/abs_slip_controller.oo";

pub fn main() {
    let abs_slip_controller_mark: Int = 0;
    if abs_slip_controller_mark != 0 {
        process_exit(1);
    }
    let a: ABSConfig = abs_config_default();
    let b: ABSConfig = abs_config_default();
    if (a).slip_threshold != (b).slip_threshold {
        println("FAIL abs_config_default");
        process_exit(1);
    }
    println("prod_g2_abs_slip_controller: PASSED");
}
