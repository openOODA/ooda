// # Product prove std/cloud_faas/sandbox_entropy_refresher.oo
//
// Logline: Fail-closed emit+gcc+run asserts entropy_replenish is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/sandbox_entropy_refresher.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call entropy_replenish twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_sandbox_entropy_refresher: PASSED only if they match.

import "std/cloud_faas/sandbox_entropy_refresher.oo";

pub fn main() {
    let mut g0_oa: EntropyRefresher = EntropyRefresher { vm_id: "x", seed_epoch: 0, bytes_injected: 0, refreshes_performed: 0, is_entropy_ready: true };
    let mut g0_ob: EntropyRefresher = EntropyRefresher { vm_id: "x", seed_epoch: 0, bytes_injected: 0, refreshes_performed: 0, is_entropy_ready: true };
    let g0_a = entropy_replenish(&g0_oa, 0, 0);
    let g0_b = entropy_replenish(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL entropy_replenish");
        process_exit(1);
    }
    println("prod_gr_sandbox_entropy_refresher: PASSED");
}
