// # Const if (1 == 1) println
//
// Logline: Print peq-then when the condition is (1 == 1).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (1 == 1) print peq-then else print peq-else.
//   3. Leave no other statements.

pub fn main() {
    if (1 == 1) {
        println("peq-then");
    } else {
        println("peq-else");
    }
}
