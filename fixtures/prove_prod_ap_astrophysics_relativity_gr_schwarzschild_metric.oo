// # Product prove std/astrophysics_relativity/gr_schwarzschild_metric.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/gr_schwarzschild_metric.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_schwarzschild_metric.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gr_schwarzschild_metric: PASSED only if they match.

import "std/astrophysics_relativity/gr_schwarzschild_metric.oo";

pub fn main() {
    let gr_schwarzschild_metric_a = schwarzschild_gamma_t_tr_milli(0, 0);
    let gr_schwarzschild_metric_b = schwarzschild_gamma_t_tr_milli(0, 0);
    if gr_schwarzschild_metric_a != gr_schwarzschild_metric_b {
        println("FAIL gr_schwarzschild_metric");
        process_exit(1);
    }
    println("prod_ap_gr_schwarzschild_metric: PASSED");
}
