// # Product prove std/wasm_gc/wasm_gc_generational.oo
//
// Logline: Fail-closed emit+gcc+run asserts nursery_alloc is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_generational.oo.
//
// Beats:
//   1. Call nursery_alloc twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_generational: PASSED only if they match.

import "std/wasm_gc/wasm_gc_generational.oo";

pub fn main() {
    let obj_a: GenerationalHeap = generational_heap_new(0, 0);
    let obj_b: GenerationalHeap = generational_heap_new(0, 0);
    let a: Int = nursery_alloc(obj_a, 0);
    let b: Int = nursery_alloc(obj_b, 0);
    if a != b {
        println("FAIL nursery_alloc");
        process_exit(1);
    }
    println("prod_wasm_gc_generational: PASSED");
}
