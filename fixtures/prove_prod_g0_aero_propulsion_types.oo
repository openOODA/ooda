// # Product prove std/aero/propulsion_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts rocket_engine_id is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rocket_engine_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_propulsion_types: PASSED only if they match.

import "std/aero/propulsion_types.oo";

pub fn main() {
    let g0_oa = rocket_engine_new(2, 2, 2);
    let g0_ob = rocket_engine_new(2, 2, 2);
    let g0_a = rocket_engine_id(g0_oa);
    let g0_b = rocket_engine_id(g0_ob);
    if g0_a != g0_b {
        println("FAIL rocket_engine_id");
        process_exit(1);
    }
    println("prod_g0_propulsion_types: PASSED");
}
