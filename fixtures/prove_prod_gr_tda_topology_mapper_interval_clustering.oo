// # Product prove std/tda_topology/mapper_interval_clustering.oo
//
// Logline: Fail-closed emit+gcc+run asserts mapper_cover_assign_point is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/mapper_interval_clustering.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call mapper_cover_assign_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_mapper_interval_clustering: PASSED only if they match.

import "std/tda_topology/mapper_interval_clustering.oo";

pub fn main() {
    let mut g0_oa = mapper_cover_new(0, 0.0, 0.0, 0.0);
    let mut g0_ob = mapper_cover_new(0, 0.0, 0.0, 0.0);
    let g0_a = mapper_cover_assign_point(&g0_oa, 0, 0.0);
    let g0_b = mapper_cover_assign_point(&g0_ob, 0, 0.0);
    if g0_a != g0_b {
        println("FAIL mapper_cover_assign_point");
        process_exit(1);
    }
    println("prod_gr_mapper_interval_clustering: PASSED");
}
