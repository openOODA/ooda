// # Product prove std/telecom_6g/otfs_mp_equalizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts otfs_mp_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/otfs_mp_equalizer.oo.
//
// Beats:
//   1. Call otfs_mp_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_otfs_mp_equalizer: PASSED only if they match.

import "std/telecom_6g/otfs_mp_equalizer.oo";

pub fn main() {
    let a: OtfsMpEqualizerConfig = otfs_mp_config_default();
    let b: OtfsMpEqualizerConfig = otfs_mp_config_default();
    if a.max_iterations != b.max_iterations {
        println("FAIL otfs_mp_config_default");
        process_exit(1);
    }
    println("prod_otfs_mp_equalizer: PASSED");
}
