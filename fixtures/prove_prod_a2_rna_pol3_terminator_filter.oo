// # Product prove std/crispr_cas/rna_pol3_terminator_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts pol3_scan_terminators is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/rna_pol3_terminator_filter.oo.
//
// Beats:
//   1. Call pol3_scan_terminators twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rna_pol3_terminator_filter: PASSED only if they match.

import "std/crispr_cas/rna_pol3_terminator_filter.oo";

pub fn main() {
    let rna_pol3_terminator_filter_mark: Int = 0;
    if rna_pol3_terminator_filter_mark != 0 {
        process_exit(1);
    }
    let a: Pol3ExpressionProfile = pol3_scan_terminators("x");
    let b: Pol3ExpressionProfile = pol3_scan_terminators("x");
    if (a).has_terminator != (b).has_terminator {
        println("FAIL pol3_scan_terminators");
        process_exit(1);
    }
    println("prod_rna_pol3_terminator_filter: PASSED");
}
