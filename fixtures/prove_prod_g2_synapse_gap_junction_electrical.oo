// # Product prove std/neuro_bci/synapse_gap_junction_electrical.oo
//
// Logline: Fail-closed emit+gcc+run asserts gap_junction_linear_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/synapse_gap_junction_electrical.oo.
//
// Beats:
//   1. Call gap_junction_linear_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_synapse_gap_junction_electrical: PASSED only if they match.

import "std/neuro_bci/synapse_gap_junction_electrical.oo";

pub fn main() {
    let synapse_gap_junction_electrical_mark: Int = 0;
    if synapse_gap_junction_electrical_mark != 0 {
        process_exit(1);
    }
    let a: GapJunctionParams = gap_junction_linear_default(0.0);
    let b: GapJunctionParams = gap_junction_linear_default(0.0);
    if (a).is_rectifying != (b).is_rectifying {
        println("FAIL gap_junction_linear_default");
        process_exit(1);
    }
    println("prod_g2_synapse_gap_junction_electrical: PASSED");
}
