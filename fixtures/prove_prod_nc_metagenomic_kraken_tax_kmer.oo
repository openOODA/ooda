// # Product prove std/genomics_advanced/metagenomic_kraken_tax_kmer.oo
//
// Logline: Fail-closed emit+gcc+run asserts metagenomic_kraken_tax_kmer_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/metagenomic_kraken_tax_kmer.oo.
//
// Beats:
//   1. Call metagenomic_kraken_tax_kmer_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_metagenomic_kraken_tax_kmer: PASSED only if it matches.

import "std/genomics_advanced/metagenomic_kraken_tax_kmer.oo";

pub fn main() {
    let a: Int = metagenomic_kraken_tax_kmer_probe();
    if a != 0 {
        println("FAIL metagenomic_kraken_tax_kmer_probe");
        process_exit(1);
    }
    println("prod_nc_metagenomic_kraken_tax_kmer: PASSED");
}
