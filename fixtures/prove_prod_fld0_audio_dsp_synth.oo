// # Product prove std/multimedia/audio_dsp_synth.oo
//
// Logline: Fail-closed emit+gcc+run asserts synth_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/audio_dsp_synth.oo.
//
// Beats:
//   1. Call synth_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audio_dsp_synth: PASSED only if they match.

import "std/multimedia/audio_dsp_synth.oo";

pub fn main() {
    let audio_dsp_synth_mark: Int = 0;
    if audio_dsp_synth_mark != 0 {
        process_exit(1);
    }
    let audio_dsp_synth_a: Float = synth_pi();
    let audio_dsp_synth_b: Float = synth_pi();
    if audio_dsp_synth_a != audio_dsp_synth_b {
        println("FAIL synth_pi");
        process_exit(1);
    }
    println("prod_audio_dsp_synth: PASSED");
}
