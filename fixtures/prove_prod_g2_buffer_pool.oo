// # Product prove std/database/buffer_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts buffer_pool_manager_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/buffer_pool.oo.
//
// Beats:
//   1. Call buffer_pool_manager_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_buffer_pool: PASSED only if they match.

import "std/database/buffer_pool.oo";

pub fn main() {
    let a: BufferPoolManager = buffer_pool_manager_create(0, 0);
    let b: BufferPoolManager = buffer_pool_manager_create(0, 0);
    if (a).pool_size != (b).pool_size {
        println("FAIL buffer_pool_manager_create");
        process_exit(1);
    }
    println("prod_g2_buffer_pool: PASSED");
}
