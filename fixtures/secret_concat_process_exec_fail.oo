// # Refuse concatenated secret in process_exec
//
// Logline: Concatenating a SECRET token into a string passed to process_exec must fail closed.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Concatenate token into cmd.
//   3. Pass cmd to process_exec so the sink refuses.
//
// Concatenated secret must not reach process_exec
// SECRET: token
pub fn main(p: &ProcessCap) {
    let token = "s3cret-payload";
    let cmd = "echo " + token;
    let r = process_exec(p, cmd);
    println(1);
}
