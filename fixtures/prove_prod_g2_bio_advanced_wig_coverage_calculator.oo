// # Product prove std/bio_advanced/wig_coverage_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts wig_coverage_calculator_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/wig_coverage_calculator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call wig_coverage_calculator_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wig_coverage_calculator: PASSED only if they match.

import "std/bio_advanced/wig_coverage_calculator.oo";

pub fn main() {
    let g2_a = wig_coverage_calculator_probe();
    let g2_b = wig_coverage_calculator_probe();
    if g2_a != g2_b {
        println("FAIL wig_coverage_calculator_probe");
        process_exit(1);
    }
    println("prod_g2_wig_coverage_calculator: PASSED");
}
