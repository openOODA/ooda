// # Product prove std/formal_verif/k_induction_invariant_prover.oo
//
// Logline: Fail-closed emit+gcc+run asserts k_induction_build_step_query is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/k_induction_invariant_prover.oo.
//
// Beats:
//   1. Call k_induction_build_step_query twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_k_induction_invariant_prover: PASSED only if they match.

import "std/formal_verif/k_induction_invariant_prover.oo";

pub fn main() {
    let k_induction_invariant_prover_mark: Int = 0;
    if k_induction_invariant_prover_mark != 0 {
        process_exit(1);
    }
    let a: String = k_induction_build_step_query(0, "x");
    let b: String = k_induction_build_step_query(0, "x");
    if a != b {
        println("FAIL k_induction_build_step_query");
        process_exit(1);
    }
    println("prod_k_induction_invariant_prover: PASSED");
}
