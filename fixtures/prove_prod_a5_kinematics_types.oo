// # Product prove std/robot/kinematics_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts kinematics_types_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/kinematics_types.oo.
//
// Beats:
//   1. Call kinematics_types_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kinematics_types: PASSED only if they match.

import "std/robot/kinematics_types.oo";

pub fn main() {
    let a: Int = kinematics_types_marker();
    let b: Int = kinematics_types_marker();
    if a != b {
        println("FAIL kinematics_types_marker");
        process_exit(1);
    }
    println("prod_kinematics_types: PASSED");
}
