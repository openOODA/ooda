// # Result Void Ok and Err
//
// Logline: Return Ok(void) and take the Err path, then print ok.
//
// Setup: Result[Void, String] must emit OoResV, not OoResS.
//
// Beats:
//   1. boom returns Ok(void).
//   2. fail returns Err.
//   3. main matches boom and prints ok.

pub fn boom() -> Result[Void, String] {
    return Ok(void);
}

pub fn fail() -> Result[Void, String] {
    return Err("nope");
}

pub fn main() {
    let r: Result[Void, String] = boom();
    if r.is_ok() {
        println("ok");
    }
    let e: Result[Void, String] = fail();
    if e.is_err() {
        println("err");
    }
}
