// # HMAC verify of a cap token string
//
// Logline: Same key and message match; a tampered message does not.
//
// Setup: OPEN-38. crypto_hmac_sha256_internal. CHS digest, not kernel object caps.
//
// Beats:
//   1. HMAC key k and msg cap1.
//   2. Recompute and compare.
//   3. Tampered msg must differ.

pub fn main() {
    let a: String = crypto_hmac_sha256_internal("k", "cap1");
    let b: String = crypto_hmac_sha256_internal("k", "cap1");
    let c: String = crypto_hmac_sha256_internal("k", "cap2");
    if a != b {
        println("FAIL match");
        process_exit(1);
    }
    if a == c {
        println("FAIL tamper");
        process_exit(1);
    }
    println(chars_len(a));
    println("open_hmac_verify: PASSED");
}