// # Product prove std/sec/watermark_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/watermark_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/watermark_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_watermark_types: PASSED only if they match.

import "std/sec/watermark_types.oo";

pub fn main() {
    let watermark_types_a = watermark_meta_new(0, 0);
    let watermark_types_b = watermark_meta_new(0, 0);
    let watermark_types_va = watermark_meta_algo(watermark_types_a);
    let watermark_types_vb = watermark_meta_algo(watermark_types_b);
    if watermark_types_va != watermark_types_vb {
        println("FAIL watermark_types");
        process_exit(1);
    }
    println("prod_ap_watermark_types: PASSED");
}
