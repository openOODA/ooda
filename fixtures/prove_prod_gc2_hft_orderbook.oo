// # Product prove std/fin/hft_orderbook.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_orderbook_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_orderbook.oo.
//
// Beats:
//   1. Call hft_orderbook_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_orderbook: PASSED only if they match.

import "std/fin/hft_orderbook.oo";

pub fn main() {
    let hft_orderbook_mark: Int = 0;
    if hft_orderbook_mark != 0 {
        process_exit(1);
    }
    let hft_orderbook_a = hft_orderbook_init(1, 1, 1);
    let hft_orderbook_b = hft_orderbook_init(1, 1, 1);
    if (hft_orderbook_a).price != (hft_orderbook_b).price {
        println("FAIL hft_orderbook_init");
        process_exit(1);
    }
    println("prod_hft_orderbook: PASSED");
}
