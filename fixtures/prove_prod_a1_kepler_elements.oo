// # Product prove std/astrodynamics/kepler_elements.oo
//
// Logline: Fail-closed emit+gcc+run asserts kepler_n_el is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/kepler_elements.oo.
//
// Beats:
//   1. Call kepler_n_el twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kepler_elements: PASSED only if they match.

import "std/astrodynamics/kepler_elements.oo";

pub fn main() {
    let kepler_elements_mark: Int = 0;
    if kepler_elements_mark != 0 {
        process_exit(1);
    }
    let a: Int = kepler_n_el();
    let b: Int = kepler_n_el();
    if a != b {
        println("FAIL kepler_n_el");
        process_exit(1);
    }
    println("prod_kepler_elements: PASSED");
}
