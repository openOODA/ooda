// # Product prove std/defi_derivatives/perpetual_funding_arbitrage.oo
//
// Logline: Fail-closed emit+gcc+run asserts basis_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_funding_arbitrage.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call basis_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_perpetual_funding_arbitrage: PASSED only if they match.

import "std/defi_derivatives/perpetual_funding_arbitrage.oo";

pub fn main() {
    let g2_oa: BasisYieldConfig = basis_config_default();
    let g2_ob: BasisYieldConfig = basis_config_default();
    let g2_a = (g2_oa).spot_taker_fee;
    let g2_b = (g2_ob).spot_taker_fee;
    if g2_a != g2_b {
        println("FAIL basis_config_default.spot_taker_fee");
        process_exit(1);
    }
    println("prod_g2_perpetual_funding_arbitrage: PASSED");
}
