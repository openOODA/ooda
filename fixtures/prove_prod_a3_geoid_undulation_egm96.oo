// # Product prove std/gis_topo/geoid_undulation_egm96.oo
//
// Logline: Fail-closed emit+gcc+run asserts egm96_geoid_undulation is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geoid_undulation_egm96.oo.
//
// Beats:
//   1. Call egm96_geoid_undulation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geoid_undulation_egm96: PASSED only if they match.

import "std/gis_topo/geoid_undulation_egm96.oo";

pub fn main() {
    let geoid_undulation_egm96_mark: Int = 0;
    if geoid_undulation_egm96_mark != 0 {
        process_exit(1);
    }
    let a: Float = egm96_geoid_undulation(0.0, 0.0);
    let b: Float = egm96_geoid_undulation(0.0, 0.0);
    if a != b {
        println("FAIL egm96_geoid_undulation");
        process_exit(1);
    }
    println("prod_geoid_undulation_egm96: PASSED");
}
