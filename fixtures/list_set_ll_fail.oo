// leftover: list_set on List[List[String]] stays ERR llvm_emit
pub fn main() {
    let mut inner: List[String] = list_new();
    inner = list_push(inner, "a");
    let mut xs: List[List[String]] = list_new();
    xs = list_push(xs, inner);
    xs = list_set(xs, 0, inner);
    println("should_not_emit");
}
