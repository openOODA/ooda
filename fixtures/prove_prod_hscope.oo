// # Product sec host scope prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/host_scope.oo.
//
// Setup: Product std/sec/host_scope.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty allowed denied. Exact host allowed.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/host_scope.oo";

pub fn main() {
    if host_scope_allows("", "x") {
        println("FAIL hscope empty");
        process_exit(1);
    }
    if host_scope_allows("example.com", "example.com") == false {
        println("FAIL hscope exact");
        process_exit(1);
    }
    println("prod_hscope: PASSED");
}
