// # Product prove std/quantum_topological/fqhe_quasiparticle_braiding.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_quasiparticle_braiding.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fqhe_quasiparticle_braiding: PASSED only if they match.

import "std/quantum_topological/fqhe_quasiparticle_braiding.oo";

pub fn main() {
    let fqhe_quasiparticle_braiding_mark: Int = 0;
    if fqhe_quasiparticle_braiding_mark != 0 {
        process_exit(1);
    }
    let a: Float = int_to_float(0);
    let b: Float = int_to_float(0);
    if a != b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_fqhe_quasiparticle_braiding: PASSED");
}
