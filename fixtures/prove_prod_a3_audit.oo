// # Product prove std/enterprise/audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_severity_code is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit.oo.
//
// Beats:
//   1. Call audit_severity_code twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit: PASSED only if they match.

import "std/enterprise/audit.oo";

pub fn main() {
    let a: Int = audit_severity_code(0);
    let b: Int = audit_severity_code(0);
    if a != b {
        println("FAIL audit_severity_code");
        process_exit(1);
    }
    println("prod_audit: PASSED");
}
