// # Product prove std/compilers/elf_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/elf_header.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_header.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf_header: PASSED only if they match.

import "std/compilers/elf_header.oo";

pub fn main() {
    let elf_header_a = elf_machine_x86_64();
    let elf_header_b = elf_machine_x86_64();
    if elf_header_a != elf_header_b {
        println("FAIL elf_header");
        process_exit(1);
    }
    println("prod_ap_elf_header: PASSED");
}
