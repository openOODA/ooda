// # Product prove std/db_vector_ann/vector_cross_polytope_lsh.oo
//
// Logline: Fail-closed emit+gcc+run asserts cross_polytope_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_cross_polytope_lsh.oo.
//
// Beats:
//   1. Call cross_polytope_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_cross_polytope_lsh: PASSED only if they match.

import "std/db_vector_ann/vector_cross_polytope_lsh.oo";

pub fn main() {
    let vector_cross_polytope_lsh_mark: Int = 0;
    if vector_cross_polytope_lsh_mark != 0 {
        process_exit(1);
    }
    let a: CrossPolytopeConfig = cross_polytope_config_default(0);
    let b: CrossPolytopeConfig = cross_polytope_config_default(0);
    if (a).dimension != (b).dimension {
        println("FAIL cross_polytope_config_default");
        process_exit(1);
    }
    println("prod_g2_vector_cross_polytope_lsh: PASSED");
}
