// # Product prove std/sync/fiber.oo
//
// Logline: Fail-closed emit+gcc+run asserts fiber_is_runnable is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/fiber.oo.
//
// Beats:
//   1. Call fiber_is_runnable twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fiber: PASSED only if they match.

import "std/sync/fiber.oo";

pub fn main() {
    let obj = fiber_create(0, "x", "x");
    let a = fiber_is_runnable(obj);
    let b = fiber_is_runnable(obj);
    if a != b {
        println("FAIL fiber_is_runnable");
        process_exit(1);
    }
    println("prod_fiber: PASSED");
}
