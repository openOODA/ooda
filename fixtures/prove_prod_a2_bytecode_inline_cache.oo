// # Product prove std/compilers_vm/bytecode_inline_cache.oo
//
// Logline: Fail-closed emit+gcc+run asserts ic_state_uninitialized is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_inline_cache.oo.
//
// Beats:
//   1. Call ic_state_uninitialized twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_inline_cache: PASSED only if they match.

import "std/compilers_vm/bytecode_inline_cache.oo";

pub fn main() {
    let bytecode_inline_cache_mark: Int = 0;
    if bytecode_inline_cache_mark != 0 {
        process_exit(1);
    }
    let a: Int = ic_state_uninitialized();
    let b: Int = ic_state_uninitialized();
    if a != b {
        println("FAIL ic_state_uninitialized");
        process_exit(1);
    }
    println("prod_bytecode_inline_cache: PASSED");
}
