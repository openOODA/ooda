// # Product prove std/game_engine/ecs_component.oo
//
// Logline: Fail-closed emit+gcc+run asserts component_mask_none is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_component.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call component_mask_none twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ecs_component: PASSED only if they match.

import "std/game_engine/ecs_component.oo";

pub fn main() {
    let g2_a = component_mask_none();
    let g2_b = component_mask_none();
    if g2_a != g2_b {
        println("FAIL component_mask_none");
        process_exit(1);
    }
    println("prod_g2_ecs_component: PASSED");
}
