// # Product prove std/web_ecosystem/cuid2_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts cuid2_hash_step is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/cuid2_generator.oo.
//
// Beats:
//   1. Call cuid2_hash_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cuid2_generator: PASSED only if they match.

import "std/web_ecosystem/cuid2_generator.oo";

pub fn main() {
    let cuid2_generator_mark: Int = 0;
    if cuid2_generator_mark != 0 {
        process_exit(1);
    }
    let a: Int = cuid2_hash_step(0, 0);
    let b: Int = cuid2_hash_step(0, 0);
    if a != b {
        println("FAIL cuid2_hash_step");
        process_exit(1);
    }
    println("prod_cuid2_generator: PASSED");
}
