// # Product prove std/astrophysics_relativity/cosmological_distances_luminosity.oo
//
// Logline: Fail-closed verification that cosmological comoving, luminosity, and angular diameter distances are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_distances_luminosity.oo.
//
// Beats:
//   1. Compute comoving distance and cosmic lookback time at redshift z = 1.0.
//   2. Compute full cosmological distance evaluation tuple (D_c, D_L, D_A, mu, t_L).
//   3. Assert deterministic return values.
//   4. Print prod_g4_astrophys_luminosity: PASSED and exit 0.

import "std/astrophysics_relativity/cosmological_distances_luminosity.oo";

pub fn main() {
    let cosmological_distances_luminosity_mark: Int = 0;
    if cosmological_distances_luminosity_mark != 0 {
        process_exit(1);
    }

    let params: CosmoParams = cosmo_params_default();

    let dc_a: Float = cosmo_comoving_distance_mpc(params, 1.0);
    let dc_b: Float = cosmo_comoving_distance_mpc(params, 1.0);
    if dc_a != dc_b || dc_a <= 1000.0 {
        println("FAIL cosmo_comoving_distance_mpc");
        process_exit(1);
    }

    let tl_a: Float = cosmo_lookback_time_gyr(params, 1.0);
    let tl_b: Float = cosmo_lookback_time_gyr(params, 1.0);
    if tl_a != tl_b || tl_a <= 0.0 {
        println("FAIL cosmo_lookback_time_gyr");
        process_exit(1);
    }

    let res_a: CosmoDistanceResult = cosmo_distances_evaluate(params, 1.0);
    let res_b: CosmoDistanceResult = cosmo_distances_evaluate(params, 1.0);

    if (res_a).comoving_distance_mpc != (res_b).comoving_distance_mpc || (res_a).comoving_distance_mpc <= 0.0 {
        println("FAIL cosmo_distances_evaluate comoving_distance_mpc");
        process_exit(1);
    }

    if (res_a).luminosity_distance_mpc != (res_b).luminosity_distance_mpc || (res_a).luminosity_distance_mpc <= (res_a).comoving_distance_mpc {
        println("FAIL cosmo_distances_evaluate luminosity_distance_mpc");
        process_exit(1);
    }

    if (res_a).angular_diameter_distance_mpc != (res_b).angular_diameter_distance_mpc || (res_a).angular_diameter_distance_mpc <= 0.0 {
        println("FAIL cosmo_distances_evaluate angular_diameter_distance_mpc");
        process_exit(1);
    }

    if (res_a).distance_modulus_mag != (res_b).distance_modulus_mag || (res_a).distance_modulus_mag <= 0.0 {
        println("FAIL cosmo_distances_evaluate distance_modulus_mag");
        process_exit(1);
    }

    println("prod_g4_astrophys_luminosity: PASSED");
    process_exit(0);
}
