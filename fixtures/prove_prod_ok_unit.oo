// # Product C emit: Ok(()) unit Result[Void]
//
// Logline: Fail-closed emit+gcc+run of return Ok(()) as Result[Void, String].
//
// Setup: Isolated emit-c. Unit Ok must not slist OOB.
//
// Beats:
//   1. ok_unit() is Ok.
//   2. Exit 1 on miss. Print prod_ok_unit: PASSED only if it holds.

pub fn ok_unit() -> Result[Void, String] {
    return Ok(());
}

pub fn main() {
    let r: Result[Void, String] = ok_unit();
    if r.is_err() {
        println("FAIL ok_unit");
        process_exit(1);
    }
    println("prod_ok_unit: PASSED");
}
