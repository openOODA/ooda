// # Product prove std/media_dsp/icc_color_profile_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts icc_srgb_to_linear is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/icc_color_profile_header.oo.
//
// Beats:
//   1. Call icc_srgb_to_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_icc_color_profile_header: PASSED only if they match.

import "std/media_dsp/icc_color_profile_header.oo";

pub fn main() {
    let icc_color_profile_header_mark: Int = 0;
    if icc_color_profile_header_mark != 0 {
        process_exit(1);
    }
    let a: Float = icc_srgb_to_linear(0.0);
    let b: Float = icc_srgb_to_linear(0.0);
    if a != b {
        println("FAIL icc_srgb_to_linear");
        process_exit(1);
    }
    println("prod_icc_color_profile_header: PASSED");
}
