// # Product prove std/media_dsp/h264_sps_pps_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts h264_decode_ue_golomb is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/h264_sps_pps_decoder.oo.
//
// Beats:
//   1. Call h264_decode_ue_golomb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_h264_sps_pps_decoder: PASSED only if they match.

import "std/media_dsp/h264_sps_pps_decoder.oo";

pub fn main() {
    let h264_sps_pps_decoder_mark: Int = 0;
    if h264_sps_pps_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = h264_decode_ue_golomb(0, 0);
    let b: Int = h264_decode_ue_golomb(0, 0);
    if a != b {
        println("FAIL h264_decode_ue_golomb");
        process_exit(1);
    }
    println("prod_h264_sps_pps_decoder: PASSED");
}
