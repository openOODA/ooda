// # Product prove std/robotics_auv/auv_restoring_forces.oo
//
// Logline: Fail-closed emit+gcc+run asserts auv_hydrostatic_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_restoring_forces.oo.
//
// Beats:
//   1. Call auv_hydrostatic_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auv_hydrostatic_default: PASSED only if they match.

import "std/robotics_auv/auv_restoring_forces.oo";

pub fn main() {
    let auv_restoring_forces_mark: Int = 0;
    if auv_restoring_forces_mark != 0 { process_exit(1); }
    let a: AuvHydrostaticParams = auv_hydrostatic_params_default();
    let b: AuvHydrostaticParams = auv_hydrostatic_params_default();
    let am: Float = (a).mass_kg;
    let bm: Float = (b).mass_kg;
    if am != bm {
        println("FAIL auv_hydrostatic_params_default");
        process_exit(1);
    }
    println("prod_auv_hydrostatic_default: PASSED");
}
