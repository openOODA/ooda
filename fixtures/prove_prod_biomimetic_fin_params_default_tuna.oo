// # Product prove std/robotics_auv/bio_inspired_undulatory_fin.oo
//
// Logline: Fail-closed emit+gcc+run asserts biomimetic_fin_params_default_tuna is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/bio_inspired_undulatory_fin.oo.
//
// Beats:
//   1. Call biomimetic_fin_params_default_tuna twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_biomimetic_fin_params_default_tuna: PASSED only if they match.

import "std/robotics_auv/bio_inspired_undulatory_fin.oo";

pub fn main() {
    let bio_inspired_undulatory_fin_mark: Int = 0;
    if bio_inspired_undulatory_fin_mark != 0 { process_exit(1); }
    let a: BiomimeticFinParams = biomimetic_fin_params_default_tuna();
    let b: BiomimeticFinParams = biomimetic_fin_params_default_tuna();
    if (a).body_length_m != (b).body_length_m {
        println("FAIL biomimetic_fin_params_default_tuna");
        process_exit(1);
    }
    println("prod_biomimetic_fin_params_default_tuna: PASSED");
}
