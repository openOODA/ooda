// # Product prove std/fhe_lattices/fhe_noise_budget_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts noise_budget_consume_addition is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_noise_budget_tracker.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call noise_budget_consume_addition twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_noise_budget_tracker: PASSED only if they match.

import "std/fhe_lattices/fhe_noise_budget_tracker.oo";

pub fn main() {
    let mut g2_oa: NoiseBudgetTracker = NoiseBudgetTracker { initial_budget_bits: 1.0, current_budget_bits: 1.0, noise_scale_delta: 1.0 };
    let mut g2_ob: NoiseBudgetTracker = NoiseBudgetTracker { initial_budget_bits: 1.0, current_budget_bits: 1.0, noise_scale_delta: 1.0 };
    let g2_a = noise_budget_consume_addition(&g2_oa);
    let g2_b = noise_budget_consume_addition(&g2_ob);
    if g2_a != g2_b {
        println("FAIL noise_budget_consume_addition");
        process_exit(1);
    }
    println("prod_g2_fhe_noise_budget_tracker: PASSED");
}
