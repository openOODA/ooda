// # Product prove std/auto/lanelet_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/lanelet_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lanelet_ops: PASSED only if they match.

import "std/auto/lanelet_ops.oo";

pub fn main() {
    let lanelet_ops_a = llt_op_new(0, 0);
    let lanelet_ops_b = llt_op_new(0, 0);
    let lanelet_ops_va = llt_op_speed(lanelet_ops_a);
    let lanelet_ops_vb = llt_op_speed(lanelet_ops_b);
    if lanelet_ops_va != lanelet_ops_vb {
        println("FAIL lanelet_ops");
        process_exit(1);
    }
    println("prod_ap_lanelet_ops: PASSED");
}
