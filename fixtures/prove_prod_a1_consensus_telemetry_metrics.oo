// # Product prove std/bft_consensus/consensus_telemetry_metrics.oo
//
// Logline: Fail-closed emit+gcc+run asserts consensus_metrics_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/consensus_telemetry_metrics.oo.
//
// Beats:
//   1. Call consensus_metrics_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_consensus_telemetry_metrics: PASSED only if they match.

import "std/bft_consensus/consensus_telemetry_metrics.oo";

pub fn main() {
    let consensus_telemetry_metrics_mark: Int = 0;
    if consensus_telemetry_metrics_mark != 0 {
        process_exit(1);
    }
    let a: ConsensusMetrics = consensus_metrics_new();
    let b: ConsensusMetrics = consensus_metrics_new();
    if (a).current_committed_height != (b).current_committed_height {
        println("FAIL consensus_metrics_new");
        process_exit(1);
    }
    println("prod_consensus_telemetry_metrics: PASSED");
}
