// # Product prove std/auto_mpc_control/mpc_terminal_cost_constraint.oo
//
// Logline: Fail-closed emit+gcc+run asserts terminal_validator_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_terminal_cost_constraint.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call terminal_validator_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mpc_terminal_cost_constraint: PASSED only if they match.

import "std/auto_mpc_control/mpc_terminal_cost_constraint.oo";

pub fn main() {
    let g2_oa: TerminalSetValidator = terminal_validator_default();
    let g2_ob: TerminalSetValidator = terminal_validator_default();
    let g2_a = (g2_oa).p11;
    let g2_b = (g2_ob).p11;
    if g2_a != g2_b {
        println("FAIL terminal_validator_default.p11");
        process_exit(1);
    }
    println("prod_g2_mpc_terminal_cost_constraint: PASSED");
}
