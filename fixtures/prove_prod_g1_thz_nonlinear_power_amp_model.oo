// # Product prove std/telecom_6g/thz_nonlinear_power_amp_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts pa_model_sub_thz_sspa is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_nonlinear_power_amp_model.oo.
//
// Beats:
//   1. Call pa_model_sub_thz_sspa twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_nonlinear_power_amp_model: PASSED only if they match.

import "std/telecom_6g/thz_nonlinear_power_amp_model.oo";

pub fn main() {
    let a: PowerAmplifierModel = pa_model_sub_thz_sspa();
    let b: PowerAmplifierModel = pa_model_sub_thz_sspa();
    if a.small_signal_gain_db != b.small_signal_gain_db {
        println("FAIL pa_model_sub_thz_sspa");
        process_exit(1);
    }
    println("prod_thz_nonlinear_power_amp_model: PASSED");
}
