// M161 path A: ThreadCap main-grant → residual Err (no OS threads).
// main injects: long long thread = oo_cap_grant_thread();
// Annotate Result so Backend-C binds OoResS (is_err) without c_call_result_ty.
pub fn main(thread: &ThreadCap) {
    let r: Result[String, String] = thread_spawn(thread, "worker");
    if r.is_err() {
        println("thread-residual-ok");
    } else {
        println("unexpected-ok");
    }
    let m: Result[String, String] = mutex_lock(thread, 1);
    if m.is_err() {
        println("mutex-residual-ok");
    } else {
        println("mutex-unexpected-ok");
    }
}
