// # ThreadCap spawn and mutex
//
// Logline: Spawn a thread and lock mutex slot 2 under a granted ThreadCap.
//
// Beats:
//   1. thread_spawn(thread, "t") and print spawn ok or fail.
//   2. mutex_lock(thread, 2) and print lock ok or fail.
//   3. Unlock slot 2 when the lock succeeded.

// M162: ThreadCap grant path — mutex + spawn product (not residual-only)
pub fn main(thread: &ThreadCap) {
    let s: Result[String, String] = thread_spawn(thread, "t");
    if s.is_ok() {
        println("thread-residual-ok");
    } else {
        println("thread-spawn-fail");
    }
    let m: Result[String, String] = mutex_lock(thread, 2);
    if m.is_ok() {
        println("mutex-residual-ok");
        let u: Result[String, String] = mutex_unlock(thread, 2);
        if u.is_ok() {
            println("mutex-unlock-ok");
        }
    } else {
        println("mutex-fail");
    }
}
