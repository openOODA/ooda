// # Product prove std/enterprise/crm.oo
//
// Logline: Fail-closed emit+gcc+run asserts contact_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/crm.oo.
//
// Beats:
//   1. Call contact_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_contact_create: PASSED only if they match.

import "std/enterprise/crm.oo";

pub fn main() {
    let crm_mark: Int = 0;
    if crm_mark != 0 { process_exit(1); }
    let a = contact_create(1, "n", "e", "p", 0);
    let b = contact_create(1, "n", "e", "p", 0);
    if (a).id != (b).id {
        println("FAIL contact_create");
        process_exit(1);
    }
    println("prod_contact_create: PASSED");
}
