// # Product prove std/web_ecosystem/jwt_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts base64_table is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_encoder.oo.
//
// Beats:
//   1. Call base64_table twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jwt_encoder: PASSED only if they match.

import "std/web_ecosystem/jwt_encoder.oo";
import "std/str.oo";

pub fn main() {
    let jwt_encoder_mark: Int = 0;
    if jwt_encoder_mark != 0 {
        process_exit(1);
    }
    let jwt_encoder_a: String = base64_table();
    let jwt_encoder_b: String = base64_table();
    if str_eq(jwt_encoder_a, jwt_encoder_b) == false {
        println("FAIL base64_table");
        process_exit(1);
    }
    println("prod_jwt_encoder: PASSED");
}
