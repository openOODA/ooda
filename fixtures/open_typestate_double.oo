// # Double-close a FileHandle
//
// Logline: Walk Unopened to Opened to Closed, then file_close again so TYPESTATE must refuse.
//
// Setup: Same FileHandle machine as typestate_fixture.oo.
//
// Beats:
//   1. Declare FileHandle machine with Unopened, Opened, and Closed states.
//   2. Step through legal init, open, read, write, and close.
//   3. Call file_close a second time on the Closed handle.
//
// TYPESTATE: FileHandle Unopened Opened Closed
// TYPESTATE end Closed
// TYPESTATE fn file_init: -> Unopened
// TYPESTATE fn file_open: Unopened -> Opened
// TYPESTATE fn file_read: Opened -> Opened
// TYPESTATE fn file_write: Opened -> Opened
// TYPESTATE fn file_close: Opened -> Closed

fn file_init() -> Int {
    return 100;
}

fn file_open(f: Int) {
    let x = f;
}

fn file_read(f: Int) {
    let x = f;
}

fn file_write(f: Int) {
    let x = f;
}

fn file_close(f: Int) {
    let x = f;
}

pub fn main() {
    let fh = file_init();
    file_open(fh);
    file_read(fh);
    file_write(fh);
    file_close(fh);
    file_close(fh);
}
