// # Product prove std/physics/particle_system.oo
//
// Logline: Fail-closed emit+gcc+run asserts particle_system_state_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/particle_system.oo.
//
// Beats:
//   1. Call particle_system_state_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_particle_system: PASSED only if they match.

import "std/physics/particle_system.oo";

pub fn main() {
    let a: ParticleSystemState = particle_system_state_default();
    let b: ParticleSystemState = particle_system_state_default();
    if (a).particle_count != (b).particle_count {
        println("FAIL particle_system_state_default");
        process_exit(1);
    }
    println("prod_g2_particle_system: PASSED");
}
