// # Product prove std/fs/file_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_reader_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fs/file_reader.oo.
//
// Beats:
//   1. Call file_reader_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_file_reader: PASSED only if it matches.

import "std/fs/file_reader.oo";

pub fn main() {
    let a: Int = file_reader_probe();
    if a != 0 {
        println("FAIL file_reader_probe");
        process_exit(1);
    }
    println("prod_nc_file_reader: PASSED");
}
