// # Product prove std/compilers/llvm_ir_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/llvm_ir_builder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_builder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_llvm_ir_builder: PASSED only if they match.

import "std/compilers/llvm_ir_builder.oo";

pub fn main() {
    let llvm_ir_builder_a = llvm_opcode_ret();
    let llvm_ir_builder_b = llvm_opcode_ret();
    if llvm_ir_builder_a != llvm_ir_builder_b {
        println("FAIL llvm_ir_builder");
        process_exit(1);
    }
    println("prod_ap_llvm_ir_builder: PASSED");
}
