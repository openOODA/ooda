// # Product prove std/graph_networks/tapestry_dolr_overlay.oo
//
// Logline: Fail-closed emit+gcc+run asserts tapestry_get_digit_at_level is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/tapestry_dolr_overlay.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tapestry_get_digit_at_level twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tapestry_dolr_overlay: PASSED only if they match.

import "std/graph_networks/tapestry_dolr_overlay.oo";

pub fn main() {
    let g2_a = tapestry_get_digit_at_level(2, 2, 2);
    let g2_b = tapestry_get_digit_at_level(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL tapestry_get_digit_at_level");
        process_exit(1);
    }
    println("prod_g2_tapestry_dolr_overlay: PASSED");
}
