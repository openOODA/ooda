// # Product order_statistic_tree prove
//
// Logline: Fail-closed emit+gcc+run of shipped ost_insert/len.
//
// Setup: Product std/collections/order_statistic_tree.oo. Sorted List[Int] stand-in.
//
// Beats:
//   1. After insert 3 then 1, len is 2.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/order_statistic_tree.oo";

pub fn main() {
    let mut t: OrderStatisticTree = ost_new();
    t = ost_insert(t, 3);
    t = ost_insert(t, 1);
    let n: Int = ost_len(t);
    if n != 2 {
        println("FAIL ost len");
        process_exit(1);
    }
    println("prod_ost: PASSED");
}
