// # Product prove std/space_propulsion/ballistic_entry_deceleration.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/ballistic_entry_deceleration.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ballistic_entry_deceleration.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_ballistic_entry_deceleration: PASSED only if they match.

import "std/space_propulsion/ballistic_entry_deceleration.oo";

pub fn main() {
    let ballistic_entry_deceleration_a = ballistic_entry_spec_default();
    let ballistic_entry_deceleration_b = ballistic_entry_spec_default();
    if ballistic_entry_deceleration_a.entry_velocity_m_s != ballistic_entry_deceleration_b.entry_velocity_m_s {
        println("FAIL ballistic_entry_deceleration");
        process_exit(1);
    }
    println("prod_ap_ballistic_entry_deceleration: PASSED");
}
