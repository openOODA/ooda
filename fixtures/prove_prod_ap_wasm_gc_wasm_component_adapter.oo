// # Product prove std/wasm_gc/wasm_component_adapter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/wasm_gc/wasm_component_adapter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_adapter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_component_adapter: PASSED only if they match.

import "std/wasm_gc/wasm_component_adapter.oo";

pub fn main() {
    let wasm_component_adapter_a = wasi_errno_success();
    let wasm_component_adapter_b = wasi_errno_success();
    if wasm_component_adapter_a != wasm_component_adapter_b {
        println("FAIL wasm_component_adapter");
        process_exit(1);
    }
    println("prod_ap_wasm_component_adapter: PASSED");
}
