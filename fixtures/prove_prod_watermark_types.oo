// # Product prove std/sec/watermark_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts watermark_meta_algo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/watermark_types.oo.
//
// Beats:
//   1. Call watermark_meta_algo twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_watermark_types: PASSED only if they match.

import "std/sec/watermark_types.oo";

pub fn main() {
    let obj = watermark_meta_new(0, 0);
    let a = watermark_meta_algo(obj);
    let b = watermark_meta_algo(obj);
    if a != b {
        println("FAIL watermark_meta_algo");
        process_exit(1);
    }
    println("prod_watermark_types: PASSED");
}
