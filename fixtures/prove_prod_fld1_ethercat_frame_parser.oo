// # Product prove std/iot_scada/ethercat_frame_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_cmd_lrd is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_frame_parser.oo.
//
// Beats:
//   1. Call ethercat_cmd_lrd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ethercat_frame_parser: PASSED only if they match.

import "std/iot_scada/ethercat_frame_parser.oo";

pub fn main() {
    let ethercat_frame_parser_mark: Int = 0;
    if ethercat_frame_parser_mark != 0 {
        process_exit(1);
    }
    let ethercat_frame_parser_a: Int = ethercat_cmd_lrd();
    let ethercat_frame_parser_b: Int = ethercat_cmd_lrd();
    if ethercat_frame_parser_a != ethercat_frame_parser_b {
        println("FAIL ethercat_cmd_lrd");
        process_exit(1);
    }
    println("prod_ethercat_frame_parser: PASSED");
}
