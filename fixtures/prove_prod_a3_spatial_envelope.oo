// # Product prove std/gis_spatial/spatial_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts envelope2d_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/spatial_envelope.oo.
//
// Beats:
//   1. Call envelope2d_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_envelope: PASSED only if they match.

import "std/gis_spatial/spatial_envelope.oo";

pub fn main() {
    let spatial_envelope_mark: Int = 0;
    if spatial_envelope_mark != 0 {
        process_exit(1);
    }
    let a: Envelope2D = envelope2d_empty();
    let b: Envelope2D = envelope2d_empty();
    if (a).min_x != (b).min_x {
        println("FAIL envelope2d_empty");
        process_exit(1);
    }
    println("prod_spatial_envelope: PASSED");
}
