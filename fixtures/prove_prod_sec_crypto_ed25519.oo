// # Product prove std/sec/crypto/ed25519.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_public_key is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519.oo.
//
// Beats:
//   1. Call shim_marker_public_key twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ed25519: PASSED only if they match.

import "std/sec/crypto/ed25519.oo";

pub fn main() {
    let ed25519_mark: Int = 0;
    if ed25519_mark != 0 { process_exit(1); }
    let a = shim_marker_public_key();
    let b = shim_marker_public_key();
    if a != b { process_exit(1); }
    println("prod_ed25519: PASSED");
}
