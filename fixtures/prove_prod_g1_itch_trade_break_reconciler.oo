// # Product prove std/fintech_l3_book/itch_trade_break_reconciler.oo
//
// Logline: Fail-closed emit+gcc+run asserts trade_break_ledger_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/itch_trade_break_reconciler.oo.
//
// Beats:
//   1. Call trade_break_ledger_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_itch_trade_break_reconciler: PASSED only if they match.

import "std/fintech_l3_book/itch_trade_break_reconciler.oo";

pub fn main() {
    let a: TradeBreakLedger = trade_break_ledger_new();
    let b: TradeBreakLedger = trade_break_ledger_new();
    if a.total_breaks_processed != 0 {
        println("FAIL trade_break_ledger_new");
        process_exit(1);
    }
    if a.total_breaks_processed != b.total_breaks_processed {
        println("FAIL trade_break_ledger_new");
        process_exit(1);
    }
    println("prod_itch_trade_break_reconciler: PASSED");
}
