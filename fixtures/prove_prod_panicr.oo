// # Product diag panic hook registry prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/panic_hook_registry.oo.
//
// Setup: Product std/diag/panic_hook_registry.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New registry has no hooks.
//   2. After register, has hooks.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/panic_hook_registry.oo";

pub fn main() {
    let r0: PanicRegistry = panic_registry_new();
    if panic_has_hooks(r0) {
        println("FAIL panic empty");
        process_exit(1);
    }
    let r1: PanicRegistry = panic_register_hook(r0, "flush");
    if panic_has_hooks(r1) == false {
        println("FAIL panic has");
        process_exit(1);
    }
    println("prod_panicr: PASSED");
}
