// # Product prove std/astrophysics_relativity/stellar_structure_equations.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/stellar_structure_equations.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_structure_equations.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stellar_structure_equations: PASSED only if they match.

import "std/astrophysics_relativity/stellar_structure_equations.oo";

pub fn main() {
    let stellar_structure_equations_a = stellar_ideal_gas_density(0.0, 0.0, 0.0);
    let stellar_structure_equations_b = stellar_ideal_gas_density(0.0, 0.0, 0.0);
    if stellar_structure_equations_a != stellar_structure_equations_b {
        println("FAIL stellar_structure_equations");
        process_exit(1);
    }
    println("prod_ap_stellar_structure_equations: PASSED");
}
