// # Product prove std/encoding/base32.oo
//
// Logline: Fail-closed emit+gcc+run asserts base32_encode is deterministic.
//
// Setup: Isolated emit-c. Imports std/encoding/base32.oo.
//
// Beats:
//   1. Call base32_encode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_base32: PASSED only if they match.

import "std/encoding/base32.oo";
import "std/str.oo";

pub fn main() {
    let base32_mark: Int = 0;
    if base32_mark != 0 {
        process_exit(1);
    }
    let base32_a: String = base32_encode("x");
    let base32_b: String = base32_encode("x");
    if str_eq(base32_a, base32_b) == false {
        println("FAIL base32_encode");
        process_exit(1);
    }
    println("prod_base32: PASSED");
}
