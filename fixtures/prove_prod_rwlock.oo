// # Product prove std/sync/rwlock.oo
//
// Logline: Fail-closed emit+gcc+run asserts rwlock_reader_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/rwlock.oo.
//
// Beats:
//   1. Call rwlock_reader_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rwlock: PASSED only if they match.

import "std/sync/rwlock.oo";

pub fn main() {
    let obj = rwlock_new(0, "x");
    let a = rwlock_reader_count(obj);
    let b = rwlock_reader_count(obj);
    if a != b {
        println("FAIL rwlock_reader_count");
        process_exit(1);
    }
    println("prod_rwlock: PASSED");
}
