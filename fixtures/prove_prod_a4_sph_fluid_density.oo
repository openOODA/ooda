// # Product prove std/physics/sph_fluid_density.oo
//
// Logline: Fail-closed emit+gcc+run asserts sph_poly6_kernel is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/sph_fluid_density.oo.
//
// Beats:
//   1. Call sph_poly6_kernel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sph_fluid_density: PASSED only if they match.

import "std/physics/sph_fluid_density.oo";

pub fn main() {
    let sph_fluid_density_mark: Int = 0;
    if sph_fluid_density_mark != 0 {
        process_exit(1);
    }
    let a: Float = sph_poly6_kernel(0.0, 0.0);
    let b: Float = sph_poly6_kernel(0.0, 0.0);
    if a != b {
        println("FAIL sph_poly6_kernel");
        process_exit(1);
    }
    println("prod_sph_fluid_density: PASSED");
}
