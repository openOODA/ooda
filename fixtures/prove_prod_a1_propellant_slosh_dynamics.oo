// # Product prove std/astro_advanced/propellant_slosh_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts slosh_freq_mhz is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/propellant_slosh_dynamics.oo.
//
// Beats:
//   1. Call slosh_freq_mhz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_slosh_dynamics: PASSED only if they match.

import "std/astro_advanced/propellant_slosh_dynamics.oo";

pub fn main() {
    let propellant_slosh_dynamics_mark: Int = 0;
    if propellant_slosh_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Int = slosh_freq_mhz();
    let b: Int = slosh_freq_mhz();
    if a != b {
        println("FAIL slosh_freq_mhz");
        process_exit(1);
    }
    println("prod_propellant_slosh_dynamics: PASSED");
}
