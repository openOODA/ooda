// # Product prove std/robot/ros_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts qos_profile_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/robot/ros_ops.oo.
//
// Beats:
//   1. Call qos_profile_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ros_ops: PASSED only if asserts hold.

import "std/robot/ros_ops.oo";

pub fn main() {
    let ros_ops_a = qos_profile_default();
    let ros_ops_b = qos_profile_default();
    if ros_ops_a.depth != ros_ops_b.depth {
        println("FAIL qos_profile_default");
        process_exit(1);
    }
    println("prod_ros_ops: PASSED");
}
