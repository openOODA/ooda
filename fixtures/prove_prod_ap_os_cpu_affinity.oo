// # Product prove std/os/cpu_affinity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/cpu_affinity.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/cpu_affinity.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cpu_affinity: PASSED only if they match.

import "std/os/cpu_affinity.oo";

pub fn main() {
    let cpu_affinity_a = cpu_set_new(0);
    let cpu_affinity_b = cpu_set_new(0);
    let cpu_affinity_va = cpu_set_is_set(cpu_affinity_a, 0);
    let cpu_affinity_vb = cpu_set_is_set(cpu_affinity_b, 0);
    if cpu_affinity_va != cpu_affinity_vb {
        println("FAIL cpu_affinity");
        process_exit(1);
    }
    println("prod_ap_cpu_affinity: PASSED");
}
