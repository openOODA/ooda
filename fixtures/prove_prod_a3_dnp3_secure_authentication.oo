// # Product prove std/iot_scada/dnp3_secure_authentication.oo
//
// Logline: Fail-closed emit+gcc+run asserts dnp3_auth_verify_sequence is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_secure_authentication.oo.
//
// Beats:
//   1. Call dnp3_auth_verify_sequence twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dnp3_secure_authentication: PASSED only if they match.

import "std/iot_scada/dnp3_secure_authentication.oo";

pub fn main() {
    let dnp3_secure_authentication_mark: Int = 0;
    if dnp3_secure_authentication_mark != 0 {
        process_exit(1);
    }
    let a: Bool = dnp3_auth_verify_sequence(0, 0);
    let b: Bool = dnp3_auth_verify_sequence(0, 0);
    if a != b {
        println("FAIL dnp3_auth_verify_sequence");
        process_exit(1);
    }
    println("prod_dnp3_secure_authentication: PASSED");
}
