// # Product prove std/astro_advanced/spacecraft_thermal_radiation.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermal_eps_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/spacecraft_thermal_radiation.oo.
//
// Beats:
//   1. Call thermal_eps_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spacecraft_thermal_radiation: PASSED only if they match.

import "std/astro_advanced/spacecraft_thermal_radiation.oo";

pub fn main() {
    let spacecraft_thermal_radiation_mark: Int = 0;
    if spacecraft_thermal_radiation_mark != 0 {
        process_exit(1);
    }
    let a: Int = thermal_eps_milli();
    let b: Int = thermal_eps_milli();
    if a != b {
        println("FAIL thermal_eps_milli");
        process_exit(1);
    }
    println("prod_spacecraft_thermal_radiation: PASSED");
}
