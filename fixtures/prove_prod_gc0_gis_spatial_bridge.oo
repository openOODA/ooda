// # Product prove std/gis_topo/gis_spatial_bridge.oo
//
// Logline: Fail-closed emit+gcc+run asserts bridge_envelope_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/gis_spatial_bridge.oo.
//
// Beats:
//   1. Call bridge_envelope_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gis_spatial_bridge: PASSED only if they match.

import "std/gis_topo/gis_spatial_bridge.oo";

pub fn main() {
    let gis_spatial_bridge_mark: Int = 0;
    if gis_spatial_bridge_mark != 0 {
        process_exit(1);
    }
    let gis_spatial_bridge_a = bridge_envelope_new(1.0, 1.0, 1.0, 1.0);
    let gis_spatial_bridge_b = bridge_envelope_new(1.0, 1.0, 1.0, 1.0);
    if (gis_spatial_bridge_a).min_x != (gis_spatial_bridge_b).min_x {
        println("FAIL bridge_envelope_new");
        process_exit(1);
    }
    println("prod_gis_spatial_bridge: PASSED");
}
