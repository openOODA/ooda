// # Product prove std/db_graph/graph_connected_components_wcc.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_connected_components_wcc.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_connected_components_wcc.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_connected_components_wcc: PASSED only if they match.

import "std/db_graph/graph_connected_components_wcc.oo";

pub fn main() {
    let graph_connected_components_wcc_a = dsu_new(0);
    let graph_connected_components_wcc_b = dsu_new(0);
    let graph_connected_components_wcc_va = dsu_find_root(graph_connected_components_wcc_a, 0);
    let graph_connected_components_wcc_vb = dsu_find_root(graph_connected_components_wcc_b, 0);
    if graph_connected_components_wcc_va != graph_connected_components_wcc_vb {
        println("FAIL graph_connected_components_wcc");
        process_exit(1);
    }
    println("prod_ap_graph_connected_components_wcc: PASSED");
}
