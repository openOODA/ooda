//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/krylov_subspace_mps_evolution.oo.
//
// Beats:
//   1. Call krylov_mps_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_krylov_subspace_mps_evolution: PASSED only if they match.

import "std/quantum_tensor_nets/krylov_subspace_mps_evolution.oo";

pub fn main() {
    let a: KrylovMpsConfig = krylov_mps_config_default(0, 0.0);
    let b: KrylovMpsConfig = krylov_mps_config_default(0, 0.0);
    if a.krylov_dimension != b.krylov_dimension {
        println("FAIL krylov_mps_config_default");
        process_exit(1);
    }
    println("prod_krylov_subspace_mps_evolution: PASSED");
}
