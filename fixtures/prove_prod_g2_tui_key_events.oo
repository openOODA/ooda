// # Product prove std/tui/key_events.oo
//
// Logline: Fail-closed emit+gcc+run asserts key_event_is_arrow is a real value.
//
// Setup: Isolated emit-c. Imports std/tui/key_events.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call key_event_is_arrow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_key_events: PASSED only if they match.

import "std/tui/key_events.oo";

pub fn main() {
    let g2_oa: KeyEvent = key_event_new(2, "x");
    let g2_ob: KeyEvent = key_event_new(2, "x");
    let g2_a = key_event_is_arrow(&g2_oa);
    let g2_b = key_event_is_arrow(&g2_ob);
    if g2_a != g2_b {
        println("FAIL key_event_is_arrow");
        process_exit(1);
    }
    println("prod_g2_key_events: PASSED");
}
