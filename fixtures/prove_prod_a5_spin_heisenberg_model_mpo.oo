// # Product prove std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo
//
// Logline: Fail-closed emit+gcc+run asserts heisenberg_config_xxx is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo.
//
// Beats:
//   1. Call heisenberg_config_xxx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spin_heisenberg_model_mpo: PASSED only if they match.

import "std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo";

pub fn main() {
    let spin_heisenberg_model_mpo_mark: Int = 0;
    if spin_heisenberg_model_mpo_mark != 0 {
        process_exit(1);
    }
    let a: HeisenbergConfig = heisenberg_config_xxx(0, 0.0);
    let b: HeisenbergConfig = heisenberg_config_xxx(0, 0.0);
    if (a).num_sites != (b).num_sites {
        println("FAIL heisenberg_config_xxx");
        process_exit(1);
    }
    println("prod_spin_heisenberg_model_mpo: PASSED");
}
