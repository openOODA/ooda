// # Product prove std/embedded_hal/power_sleep_modes.oo
//
// Logline: Fail-closed emit+gcc+run asserts mcu_power_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/power_sleep_modes.oo.
//
// Beats:
//   1. Call mcu_power_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_power_sleep_modes: PASSED only if they match.

import "std/embedded_hal/power_sleep_modes.oo";

pub fn main() {
    let power_sleep_modes_mark: Int = 0;
    if power_sleep_modes_mark != 0 {
        process_exit(1);
    }
    let a: McuPowerState = mcu_power_state_new();
    let b: McuPowerState = mcu_power_state_new();
    if (a).mode != (b).mode {
        println("FAIL mcu_power_state_new");
        process_exit(1);
    }
    println("prod_power_sleep_modes: PASSED");
}
