// # Product prove std/quantum_advanced/quantum_virtual_distillation.oo
//
// Logline: Fail-closed emit+gcc+run asserts vqd_estimate_infidelity_suppression is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_virtual_distillation.oo.
//
// Beats:
//   1. Call vqd_estimate_infidelity_suppression twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_virtual_distillation: PASSED only if they match.

import "std/quantum_advanced/quantum_virtual_distillation.oo";

pub fn main() {
    let quantum_virtual_distillation_mark: Int = 0;
    if quantum_virtual_distillation_mark != 0 {
        process_exit(1);
    }
    let a: Float = vqd_estimate_infidelity_suppression(0.0, 0);
    let b: Float = vqd_estimate_infidelity_suppression(0.0, 0);
    if a != b {
        println("FAIL vqd_estimate_infidelity_suppression");
        process_exit(1);
    }
    println("prod_quantum_virtual_distillation: PASSED");
}
