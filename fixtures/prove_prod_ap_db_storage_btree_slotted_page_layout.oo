// # Product prove std/db_storage/btree_slotted_page_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/btree_slotted_page_layout.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_slotted_page_layout.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_btree_slotted_page_layout: PASSED only if they match.

import "std/db_storage/btree_slotted_page_layout.oo";

pub fn main() {
    let btree_slotted_page_layout_a = slotted_page_new(0, true, 0);
    let btree_slotted_page_layout_b = slotted_page_new(0, true, 0);
    let btree_slotted_page_layout_va = slotted_page_free_space(btree_slotted_page_layout_a);
    let btree_slotted_page_layout_vb = slotted_page_free_space(btree_slotted_page_layout_b);
    if btree_slotted_page_layout_va != btree_slotted_page_layout_vb {
        println("FAIL btree_slotted_page_layout");
        process_exit(1);
    }
    println("prod_ap_btree_slotted_page_layout: PASSED");
}
