// # Wave 1 Foundations Proof
//
// Logline: Test fixture program exercising Wave 1 core modules end-to-end.
//
// Setup: Compiled and executed by wave1_foundations_smoke.oo.
//
// Beats:
//   1. Exercise RingBuffer lifecycle (create, push, peek, pop, is_empty).
//   2. Exercise SwarmDispatcher routing and worker assignment.
//   3. Emit success verification token to stdout.
//

import "../std/src/ooda/perf/ring_buffer.oo";
import "../std/src/ooda/swarm/dispatch_types.oo";
import "../std/src/ooda/swarm/dispatch_engine.oo";
import "../std/src/ooda/swarm/dispatch_worker.oo";

pub fn main() {
    // 1. RingBuffer Test
    let mut rb = ring_buffer_create("test_buf", 4);
    if !ring_buffer_is_empty(&rb) {
        println("FAIL: ring buffer not empty");
        process_exit(1);
    }

    rb = ring_buffer_push(rb);
    if ring_buffer_size(&rb) != 1 {
        println("FAIL: ring buffer size != 1");
        process_exit(1);
    }

    rb = ring_buffer_pop(rb);
    if ring_buffer_size(&rb) != 0 {
        println("FAIL: ring buffer pop size != 0");
        process_exit(1);
    }

    // 2. Swarm Dispatcher Test
    let cfg = dispatcher_config_struct(0, 32, 4, 1000, 2);
    let mut disp = SwarmDispatcher {
        config: cfg,
        total_submitted: 0,
        total_completed: 0,
        total_failed: 0,
        total_cancelled: 0,
        rr_cursor: 0,
        next_task_id: 1,
        active_worker_count: 1,
    };

    let mut task = dispatcher_submit(&mut disp, 10, 42, 100);
    if (task).task_id != 1 {
        println("FAIL: task id != 1");
        process_exit(1);
    }

    let mut worker = worker_node_struct(101, 1, 0, 2, 0, 0, 100);
    let res = dispatcher_route_task(&mut disp, &mut task, &mut worker);
    if !(res).success {
        println("FAIL: task routing failed");
        process_exit(1);
    }

    dispatcher_process_completion(&mut disp, &mut task, &mut worker, true, 200);
    if (disp).total_completed != 1 {
        println("FAIL: total completed != 1");
        process_exit(1);
    }

    println("WAVE1_FOUNDATIONS_PROOF_PASSED");
}
