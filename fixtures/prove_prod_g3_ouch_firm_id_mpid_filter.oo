// # Product prove std/fintech_l3_book/ouch_firm_id_mpid_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpid_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/ouch_firm_id_mpid_filter.oo.
//
// Beats:
//   1. Call mpid_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ouch_firm_id_mpid_filter: PASSED only if they match.

import "std/fintech_l3_book/ouch_firm_id_mpid_filter.oo";

pub fn main() {
    let ouch_firm_id_mpid_filter_mark: Int = 0;
    if ouch_firm_id_mpid_filter_mark != 0 {
        process_exit(1);
    }
    let a: MpidConfig = mpid_config_new("x", "x", "x", "x");
    let b: MpidConfig = mpid_config_new("x", "x", "x", "x");
    if (a).is_active != (b).is_active {
        println("FAIL mpid_config_new");
        process_exit(1);
    }
    println("prod_ouch_firm_id_mpid_filter: PASSED");
}
