// # Product prove std/industrial_iot/opcua_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_iot/opcua_encoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/opcua_encoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_opcua_encoder: PASSED only if they match.

import "std/industrial_iot/opcua_encoder.oo";

pub fn main() {
    let opcua_encoder_a = opcua_encoder_new();
    let opcua_encoder_b = opcua_encoder_new();
    let opcua_encoder_va = opcua_encoder_byte_at(opcua_encoder_a, 0);
    let opcua_encoder_vb = opcua_encoder_byte_at(opcua_encoder_b, 0);
    if opcua_encoder_va != opcua_encoder_vb {
        println("FAIL opcua_encoder");
        process_exit(1);
    }
    println("prod_ap_opcua_encoder: PASSED");
}
