// # Product prove std/space_propulsion/ion_thruster_gridded_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts ion_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ion_thruster_gridded_grid.oo.
//
// Beats:
//   1. Call ion_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ion_thruster_gridded_grid: PASSED only if they match.

import "std/space_propulsion/ion_thruster_gridded_grid.oo";

pub fn main() {
    let ion_thruster_gridded_grid_mark: Int = 0;
    if ion_thruster_gridded_grid_mark != 0 {
        process_exit(1);
    }
    let ion_thruster_gridded_grid_a = ion_compute_performance(gridded_ion_spec_default_xenon());
    let ion_thruster_gridded_grid_b = ion_compute_performance(gridded_ion_spec_default_xenon());
    if (ion_thruster_gridded_grid_a).beam_velocity_m_s != (ion_thruster_gridded_grid_b).beam_velocity_m_s {
        println("FAIL ion_compute_performance");
        process_exit(1);
    }
    println("prod_ion_thruster_gridded_grid: PASSED");
}
