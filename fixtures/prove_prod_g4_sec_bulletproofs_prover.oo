// # Product prove std/sec/crypto/bulletproofs_prover.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs_prover.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_prover.oo.
//
// Beats:
//   1. Initialize bulletproof prover and verifier with generators.
//   2. Create range proof and verify commitment.
//   3. Run batch verifier and compute workload metric deterministically.
//   4. Print prod_g4_sec_bulletproofs_prover: PASSED and exit 0.

import "std/sec/crypto/bulletproofs_prover.oo";

pub fn main() {
    let gens: BulletproofGenerators = bulletproof_generators_create(4, 1, 11, 17, 1009);

    let mut p1: BulletproofProver = bulletproof_prover_init("P01", gens, 1009);
    let mut p2: BulletproofProver = bulletproof_prover_init("P01", gens, 1009);

    let prf1: RangeProof = bulletproof_prover_create_range_proof(&mut p1, 5, 0, 15, 7, 4);
    let prf2: RangeProof = bulletproof_prover_create_range_proof(&mut p2, 5, 0, 15, 7, 4);

    if (prf1).is_valid != (prf2).is_valid || !(prf1).is_valid {
        println("FAIL bulletproof_prover_create_range_proof is_valid");
        process_exit(1);
    }
    if (prf1).commitment != (prf2).commitment {
        println("FAIL bulletproof_prover_create_range_proof commitment");
        process_exit(1);
    }

    let mut v1: BulletproofVerifier = bulletproof_verifier_init("V01", gens, 1009);
    let mut v2: BulletproofVerifier = bulletproof_verifier_init("V01", gens, 1009);

    let ok1: Bool = bulletproof_verifier_verify_range_proof(&mut v1, prf1, (prf1).commitment);
    let ok2: Bool = bulletproof_verifier_verify_range_proof(&mut v2, prf2, (prf2).commitment);

    if ok1 != ok2 || !ok1 {
        println("FAIL bulletproof_verifier_verify_range_proof");
        process_exit(1);
    }

    let pcomm: PedersenCommitment = pedersen_commitment_create(11, 17, 5, 7, 1009);
    let mut batch1: BulletproofBatchVerifier = bulletproof_batch_verifier_init("BV01");
    let mut batch2: BulletproofBatchVerifier = bulletproof_batch_verifier_init("BV01");

    bulletproof_batch_verifier_add(&mut batch1, prf1, pcomm);
    bulletproof_batch_verifier_add(&mut batch2, prf2, pcomm);

    let b_ok1: Bool = bulletproof_batch_verifier_verify_all(&mut v1, &mut batch1);
    let b_ok2: Bool = bulletproof_batch_verifier_verify_all(&mut v2, &mut batch2);

    if b_ok1 != b_ok2 || !b_ok1 {
        println("FAIL bulletproof_batch_verifier_verify_all");
        process_exit(1);
    }

    let work1: Int = bulletproof_do_work(&p1, &v1);
    let work2: Int = bulletproof_do_work(&p2, &v2);

    if work1 != work2 || work1 <= 0 {
        println("FAIL bulletproof_do_work");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs_prover: PASSED");
    process_exit(0);
}
