// # Q32.32 Fixed-Point Test Fixture
//
// Logline: Fail-closed emit+run of q32_from_int, to_int_nearest, add, sub, mul, div, overflow variants, negative-dividend guard, and zero-drift Bézier midpoint evaluation.
//
// Setup: Product std/math_exact/fixed_point_q32.oo. Scale 2^32 = 4294967296.
//
// Beats:
//   1. from_int/to_int_nearest round-trip at integer 3.
//   2. add 1.5 + 2.25 = 3.75.
//   3. sub 3.0 - 1.5 = 1.5.
//   4. mul 1.5 * 2.0 = 3.0 (overflow-safe 32-bit split path).
//   5. div 3.0 / 2.0 = 1.5 (long division path).
//   6. div 1.0 / 0 returns Err.
//   7. div with negative dividend returns Err (fail-closed).
//   8. q32_negate and q32_abs round-trip.
//   9. Bézier midpoint of (0, 5, 10) at t=0.5 = 5.0; 1000 iterations stay at 5.0.

import "std/math_exact/fixed_point_q32.oo";

// Helper: return raw value of a Q32 by going through q32_add(0) which is a no-op addition.
fn raw_of(q: Q32) -> Int {
    let zero: Q32 = q32_from_int(0);
    let same: Q32 = q32_add(q, zero);
    return same.raw;
}

// Helper: build a Q32 from a raw value directly.
fn q32_from_raw(r: Int) -> Q32 {
    return Q32 { raw: r };
}

// Helper: assert equality of two Q32 values by comparing raw; prints FAIL and exits on miss.
fn check_q32_eq(label: String, got: Q32, want_raw: Int) {
    let got_raw: Int = raw_of(got);
    if got_raw != want_raw {
        println("FAIL q32");
        println(label);
        println(got_raw);
        println(want_raw);
        process_exit(1);
    }
}

pub fn main() {
    let s: Int = q32_scale();

    // Test 1: from_int(3) == 3 * SCALE; to_int_nearest == 3.
    let q3: Q32 = q32_from_int(3);
    let q3_raw: Int = raw_of(q3);
    if q3_raw != 3 * s {
        println("FAIL test1 from_int");
        process_exit(1);
    }
    let q3_round: Int = q32_to_int_nearest(q3);
    if q3_round != 3 {
        println("FAIL test1 to_int_nearest");
        process_exit(1);
    }

    // Test 2: add 1.5 + 2.25 = 3.75.
    // 1.5 raw = 1.5 * SCALE, 2.25 raw = 2.25 * SCALE, 3.75 raw = 3.75 * SCALE.
    let half: Int = s / 2;
    let q_half: Q32 = q32_from_raw(half);
    let q_one: Q32 = q32_from_int(1);
    let q_one_half: Q32 = q32_add(q_one, q_half);
    let q_one_half_raw: Int = raw_of(q_one_half);
    let q_two: Q32 = q32_from_int(2);
    let q_quarter: Q32 = q32_from_raw(s / 4);
    let q_two_quarter: Q32 = q32_add(q_two, q_quarter);
    let q_two_quarter_raw: Int = raw_of(q_two_quarter);
    let q_sum: Q32 = q32_add(q_one_half, q_two_quarter);
    let want_sum_raw: Int = 3 * s + s / 2 + s / 4;
    check_q32_eq("test2 add", q_sum, want_sum_raw);

    // Test 3: sub 3.0 - 1.5 = 1.5.
    let q_three: Q32 = q32_from_int(3);
    let q_diff: Q32 = q32_sub(q_three, q_one_half);
    check_q32_eq("test3 sub", q_diff, q_one_half_raw);

    // Test 4: mul 1.5 * 2.0 = 3.0.
    let q_two_int: Q32 = q32_from_int(2);
    let q_prod: Q32 = q32_mul(q_one_half, q_two_int);
    let q_three_raw: Int = 3 * s;
    check_q32_eq("test4 mul", q_prod, q_three_raw);

    // Test 5: div 3.0 / 2.0 = 1.5.
    let q_div: Result[Q32, String] = q32_div(q_three, q_two_int);
    if q_div.is_err() {
        println("FAIL test5 div returned err");
        process_exit(1);
    }
    let q_div_val: Q32 = q_div.val;
    check_q32_eq("test5 div", q_div_val, q_one_half_raw);

    // Test 6: div 1.0 / 0 returns Err.
    let q_one_raw: Q32 = q32_from_int(1);
    let q_zero: Q32 = q32_from_int(0);
    let q_div0: Result[Q32, String] = q32_div(q_one_raw, q_zero);
    if q_div0.is_ok() {
        println("FAIL test6 div-by-zero should be Err");
        process_exit(1);
    }

    // Test 7: div with negative dividend returns Err (fail-closed).
    let q_neg: Q32 = q32_negate(q_three);
    let q_div_neg: Result[Q32, String] = q32_div(q_neg, q_two_int);
    if q_div_neg.is_ok() {
        println("FAIL test7 div negative dividend should be Err");
        process_exit(1);
    }

    // Test 8: q32_negate round-trips with q32_abs.
    let q_neg_three_raw: Int = raw_of(q_neg);
    let q_abs_three: Q32 = q32_abs(q_neg);
    let q_abs_three_raw: Int = raw_of(q_abs_three);
    if q_neg_three_raw != 0 - q_three_raw {
        println("FAIL test8 negate sign");
        process_exit(1);
    }
    if q_abs_three_raw != q_three_raw {
        println("FAIL test8 abs round-trip");
        process_exit(1);
    }

    // Test 9: Bézier midpoint of (0, 5, 10) at t=0.5 = 5.0; 1000 iterations stay at 5.0.
    let p0: Q32 = q32_from_int(0);
    let p1: Q32 = q32_from_int(5);
    let p2: Q32 = q32_from_int(10);
    let t_half: Q32 = q32_from_raw(s / 2);
    let b_first: Q32 = q32_eval_bezier(p0, p1, p2, t_half);
    let want_b_raw: Int = 5 * s;
    check_q32_eq("test9 bezier first", b_first, want_b_raw);
    // Run 1000 times, each call must produce exactly 5.0 (no drift).
    let mut iter: Int = 0;
    let mut drift_count: Int = 0;
    while iter < 1000 {
        let b: Q32 = q32_eval_bezier(p0, p1, p2, t_half);
        let b_raw_val: Int = raw_of(b);
        if b_raw_val != want_b_raw {
            drift_count = drift_count + 1;
        }
        iter = iter + 1;
    }
    if drift_count != 0 {
        println("FAIL test9 bezier drift");
        process_exit(1);
    }

    println("test_fixed_point_q32: PASSED");
}
