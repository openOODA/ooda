// # Product prove std/cloud_k8s/otel_otlp_json_exporter.oo
//
// Logline: Fail-closed emit+gcc+run asserts otlp_batch_span_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/otel_otlp_json_exporter.oo.
//
// Beats:
//   1. Call otlp_batch_span_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_otel_otlp_json_exporter: PASSED only if they match.

import "std/cloud_k8s/otel_otlp_json_exporter.oo";

pub fn main() {
    let otel_otlp_json_exporter_mark: Int = 0;
    if otel_otlp_json_exporter_mark != 0 {
        process_exit(1);
    }
    let otel_otlp_json_exporter_obj: OtlpBatch = otlp_batch_new("x");
    let otel_otlp_json_exporter_a: Int = otlp_batch_span_count(&otel_otlp_json_exporter_obj);
    let otel_otlp_json_exporter_b: Int = otlp_batch_span_count(&otel_otlp_json_exporter_obj);
    if otel_otlp_json_exporter_a != otel_otlp_json_exporter_b {
        println("FAIL otlp_batch_span_count");
        process_exit(1);
    }
    println("prod_otel_otlp_json_exporter: PASSED");
}
