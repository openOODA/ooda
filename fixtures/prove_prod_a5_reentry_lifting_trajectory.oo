// # Product prove std/space_propulsion/reentry_lifting_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts lifting_entry_vehicle_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/reentry_lifting_trajectory.oo.
//
// Beats:
//   1. Call lifting_entry_vehicle_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_reentry_lifting_trajectory: PASSED only if they match.

import "std/space_propulsion/reentry_lifting_trajectory.oo";

pub fn main() {
    let reentry_lifting_trajectory_mark: Int = 0;
    if reentry_lifting_trajectory_mark != 0 {
        process_exit(1);
    }
    let a: LiftingEntryVehicle = lifting_entry_vehicle_default();
    let b: LiftingEntryVehicle = lifting_entry_vehicle_default();
    if (a).mass_kg != (b).mass_kg {
        println("FAIL lifting_entry_vehicle_default");
        process_exit(1);
    }
    println("prod_reentry_lifting_trajectory: PASSED");
}
