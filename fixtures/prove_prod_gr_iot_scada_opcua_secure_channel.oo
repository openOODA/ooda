// # Product prove std/iot_scada/opcua_secure_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_next_sequence_number is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_secure_channel.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call opcua_next_sequence_number twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_opcua_secure_channel: PASSED only if they match.

import "std/iot_scada/opcua_secure_channel.oo";

pub fn main() {
    let g0_a = opcua_next_sequence_number(0);
    let g0_b = opcua_next_sequence_number(0);
    if g0_a != g0_b {
        println("FAIL opcua_next_sequence_number");
        process_exit(1);
    }
    println("prod_gr_opcua_secure_channel: PASSED");
}
