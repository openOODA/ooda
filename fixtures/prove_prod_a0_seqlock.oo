// # Product prove std/sync/seqlock.oo
//
// Logline: Fail-closed emit+gcc+run asserts seqlock_read_begin is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/seqlock.oo.
//
// Beats:
//   1. Call seqlock_read_begin twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_seqlock: PASSED only if they match.

import "std/sync/seqlock.oo";

pub fn main() {
    let obj = seqlock_new();
    let a = seqlock_read_begin(obj);
    let b = seqlock_read_begin(obj);
    if a != b {
        println("FAIL seqlock_read_begin");
        process_exit(1);
    }
    println("prod_seqlock: PASSED");
}
