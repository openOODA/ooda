// # Product prove std/web_protocols/rtp_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtp_packet_payload_offset is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/rtp_packet.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rtp_packet_payload_offset twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_rtp_packet: PASSED only if they match.

import "std/web_protocols/rtp_packet.oo";

pub fn main() {
    let g0_oa = rtp_packet_new(2, 2, 2, 2, 2);
    let g0_ob = rtp_packet_new(2, 2, 2, 2, 2);
    let g0_a = rtp_packet_payload_offset(g0_oa);
    let g0_b = rtp_packet_payload_offset(g0_ob);
    if g0_a != g0_b {
        println("FAIL rtp_packet_payload_offset");
        process_exit(1);
    }
    println("prod_g0_rtp_packet: PASSED");
}
