// # Product prove std/bioinformatics/codon_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/codon_table.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/codon_table.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_codon_table: PASSED only if they match.

import "std/bioinformatics/codon_table.oo";

pub fn main() {
    let codon_table_a = codon_table_known(0);
    let codon_table_b = codon_table_known(0);
    if codon_table_a != codon_table_b {
        println("FAIL codon_table");
        process_exit(1);
    }
    println("prod_ap_codon_table: PASSED");
}
