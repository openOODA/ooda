// M72 ensures cap 8 fail-closed
pub fn f(a: Int) -> Int
    requires a >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
{
    return a;
}
pub fn main() {
    println(f(1));
}
