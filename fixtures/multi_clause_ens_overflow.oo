// # Fail closed past eight ensures
//
// Logline: Nine identical simple ensures overflow the clause cap and fail closed.
//
// Beats:
//   1. Keep a single simple requires on a.
//   2. Stack nine result >= 0 ensures past the cap of eight.
//   3. Call f(1) so emit or check refuses the overflow.

// M72 ensures cap 8 fail-closed
pub fn f(a: Int) -> Int
    requires a >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
    ensures result >= 0
{
    return a;
}
pub fn main() {
    println(f(1));
}
