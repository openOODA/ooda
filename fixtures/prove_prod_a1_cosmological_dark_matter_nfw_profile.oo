// # Product prove std/astrophysics_relativity/cosmological_dark_matter_nfw_profile.oo
//
// Logline: Fail-closed emit+gcc+run asserts nfw_density_over_rho0_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_dark_matter_nfw_profile.oo.
//
// Beats:
//   1. Call nfw_density_over_rho0_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cosmological_dark_matter_nfw_profile: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_dark_matter_nfw_profile.oo";

pub fn main() {
    let cosmological_dark_matter_nfw_profile_mark: Int = 0;
    if cosmological_dark_matter_nfw_profile_mark != 0 {
        process_exit(1);
    }
    let a: Int = nfw_density_over_rho0_milli(0);
    let b: Int = nfw_density_over_rho0_milli(0);
    if a != b {
        println("FAIL nfw_density_over_rho0_milli");
        process_exit(1);
    }
    println("prod_cosmological_dark_matter_nfw_profile: PASSED");
}
