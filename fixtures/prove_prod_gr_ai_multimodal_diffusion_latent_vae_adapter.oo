//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_latent_vae_adapter.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call latent_vae_adapter_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_diffusion_latent_vae_adapter: PASSED only if they match.

import "std/ai_multimodal/diffusion_latent_vae_adapter.oo";

pub fn main() {
    let g0_a = latent_vae_adapter_marker();
    let g0_b = latent_vae_adapter_marker();
    if g0_a != g0_b {
        println("FAIL latent_vae_adapter_marker");
        process_exit(1);
    }
    println("prod_gr_diffusion_latent_vae_adapter: PASSED");
}
