// # Product prove std/web_ecosystem/template_handlebars.oo
//
// Logline: Fail-closed emit+gcc+run asserts handlebars_escape_kind is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/template_handlebars.oo.
//
// Beats:
//   1. Call handlebars_escape_kind twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_template_handlebars: PASSED only if they match.

import "std/web_ecosystem/template_handlebars.oo";

pub fn main() {
    let template_handlebars_mark: Int = 0;
    if template_handlebars_mark != 0 {
        process_exit(1);
    }
    let template_handlebars_a: Int = handlebars_escape_kind(1);
    let template_handlebars_b: Int = handlebars_escape_kind(1);
    if template_handlebars_a != template_handlebars_b {
        println("FAIL handlebars_escape_kind");
        process_exit(1);
    }
    println("prod_template_handlebars: PASSED");
}
