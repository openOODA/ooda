// # Product prove std/edge/power_governor.oo
//
// Logline: Fail-closed verification that edge power governor state transitions are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power_governor.oo.
//
// Beats:
//   1. Initialize power governor with telemetry thresholds.
//   2. Evaluate power governor profile switching under discharge and normal operation.
//   3. Assert deterministic power mode evaluations and critical state flags.
//   4. Print prod_g4_edge_power_governor: PASSED and exit 0.

import "std/edge/power_governor.oo";

pub fn main() {
    let probe1: Int = power_governor_probe();
    let probe2: Int = power_governor_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL power_governor_probe");
        process_exit(1);
    }

    let cap: &SysCap = 0;
    let mut gov1: PowerGovernor = power_governor_init(cap, 50000);
    let mut gov2: PowerGovernor = power_governor_init(cap, 50000);

    let mode1: Int = power_governor_evaluate(&mut gov1);
    let mode2: Int = power_governor_evaluate(&mut gov2);
    if mode1 != mode2 || mode1 != 1 {
        println("FAIL power_governor_evaluate default");
        process_exit(1);
    }

    let throttled1: Bool = power_governor_is_throttled(&gov1);
    let throttled2: Bool = power_governor_is_throttled(&gov2);
    if throttled1 != throttled2 || throttled1 != false {
        println("FAIL power_governor_is_throttled");
        process_exit(1);
    }

    let crit1: Bool = power_governor_is_critical(&gov1);
    let crit2: Bool = power_governor_is_critical(&gov2);
    if crit1 != crit2 || crit1 != false {
        println("FAIL power_governor_is_critical");
        process_exit(1);
    }

    let bat: BatteryState = battery_state_new(15, 11200, 2000, 95, 35, 0, 0);
    power_governor_update_telemetry(&mut gov1, bat);
    power_governor_update_telemetry(&mut gov2, bat);

    let low_mode1: Int = power_governor_evaluate(&mut gov1);
    let low_mode2: Int = power_governor_evaluate(&mut gov2);
    if low_mode1 != low_mode2 || low_mode1 != 2 {
        println("FAIL power_governor_evaluate low_battery");
        process_exit(1);
    }

    let rem_sec1: Int = power_governor_get_remaining_sec(&gov1);
    let rem_sec2: Int = power_governor_get_remaining_sec(&gov2);
    if rem_sec1 != rem_sec2 || rem_sec1 <= 0 {
        println("FAIL power_governor_get_remaining_sec");
        process_exit(1);
    }

    println("prod_g4_edge_power_governor: PASSED");
    process_exit(0);
}
