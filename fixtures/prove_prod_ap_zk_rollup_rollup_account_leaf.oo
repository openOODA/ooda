// # Product prove std/zk_rollup/rollup_account_leaf.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_account_leaf.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_account_leaf.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rollup_account_leaf: PASSED only if they match.

import "std/zk_rollup/rollup_account_leaf.oo";

pub fn main() {
    let rollup_account_leaf_a = rollup_account_leaf_new(0, 0, 0, 0);
    let rollup_account_leaf_b = rollup_account_leaf_new(0, 0, 0, 0);
    let rollup_account_leaf_va = rollup_account_compute_hash(rollup_account_leaf_a);
    let rollup_account_leaf_vb = rollup_account_compute_hash(rollup_account_leaf_b);
    if rollup_account_leaf_va != rollup_account_leaf_vb {
        println("FAIL rollup_account_leaf");
        process_exit(1);
    }
    println("prod_ap_rollup_account_leaf: PASSED");
}
