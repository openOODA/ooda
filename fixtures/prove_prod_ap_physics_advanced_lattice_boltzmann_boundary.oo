// # Product prove std/physics_advanced/lattice_boltzmann_boundary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/lattice_boltzmann_boundary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_boundary.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lattice_boltzmann_boundary: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_boundary.oo";

pub fn main() {
    let lattice_boltzmann_boundary_a = lbm_bounce_back_opposite(0);
    let lattice_boltzmann_boundary_b = lbm_bounce_back_opposite(0);
    if lattice_boltzmann_boundary_a != lattice_boltzmann_boundary_b {
        println("FAIL lattice_boltzmann_boundary");
        process_exit(1);
    }
    println("prod_ap_lattice_boltzmann_boundary: PASSED");
}
