// # Product prove std/astrophysics_relativity/stellar_eddington_luminosity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/stellar_eddington_luminosity.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_eddington_luminosity.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stellar_eddington_luminosity: PASSED only if they match.

import "std/astrophysics_relativity/stellar_eddington_luminosity.oo";

pub fn main() {
    let stellar_eddington_luminosity_a = eddington_thomson_opacity(0);
    let stellar_eddington_luminosity_b = eddington_thomson_opacity(0);
    if stellar_eddington_luminosity_a != stellar_eddington_luminosity_b {
        println("FAIL stellar_eddington_luminosity");
        process_exit(1);
    }
    println("prod_ap_stellar_eddington_luminosity: PASSED");
}
