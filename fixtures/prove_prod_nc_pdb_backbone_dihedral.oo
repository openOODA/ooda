// # Product prove std/bio_advanced/pdb_backbone_dihedral.oo
//
// Logline: Fail-closed emit+gcc+run asserts pdb_backbone_dihedral_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/pdb_backbone_dihedral.oo.
//
// Beats:
//   1. Call pdb_backbone_dihedral_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pdb_backbone_dihedral: PASSED only if it matches.

import "std/bio_advanced/pdb_backbone_dihedral.oo";

pub fn main() {
    let a: Int = pdb_backbone_dihedral_probe();
    if a != 0 {
        println("FAIL pdb_backbone_dihedral_probe");
        process_exit(1);
    }
    println("prod_nc_pdb_backbone_dihedral: PASSED");
}
