// # Product prove std/bio/cell.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/cell.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cell: PASSED only if they match.

import "std/bio/cell.oo";

pub fn main() {
    let cell_a = shim_marker_growth_optimal();
    let cell_b = shim_marker_growth_optimal();
    if cell_a != cell_b {
        println("FAIL cell");
        process_exit(1);
    }
    println("prod_ap_cell: PASSED");
}
