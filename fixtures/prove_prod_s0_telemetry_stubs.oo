// # Product prove std/net_telemetry/telemetry_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts nic_hardware_config_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/telemetry_stubs.oo.
//
// Beats:
//   1. Call nic_hardware_config_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_telemetry_stubs: PASSED only if asserts hold.

import "std/net_telemetry/telemetry_stubs.oo";

pub fn main() {
    let telemetry_stubs_a: NicHardwareConfig = nic_hardware_config_new("x", 0, true, true);
    let telemetry_stubs_b: NicHardwareConfig = nic_hardware_config_new("x", 0, true, true);
    if telemetry_stubs_a.ring_size != telemetry_stubs_b.ring_size {
        println("FAIL nic_hardware_config_new");
        process_exit(1);
    }
    println("prod_telemetry_stubs: PASSED");
}
