// # Product prove std/digital_twin/bond_graph_hydraulic_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_hydraulic_domain.oo.
//
// Beats:
//   1. Call math_sqrt_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bond_graph_hydraulic_domain: PASSED only if they match.

import "std/digital_twin/bond_graph_hydraulic_domain.oo";

pub fn main() {
    let a: Float = math_sqrt_approx(0.0);
    let b: Float = math_sqrt_approx(0.0);
    if a != b {
        println("FAIL math_sqrt_approx");
        process_exit(1);
    }
    println("prod_bond_graph_hydraulic_domain: PASSED");
}
