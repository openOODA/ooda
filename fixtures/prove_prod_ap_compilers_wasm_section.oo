// # Product prove std/compilers/wasm_section.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/wasm_section.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_section.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_section: PASSED only if they match.

import "std/compilers/wasm_section.oo";

pub fn main() {
    let wasm_section_a = wasm_section_id_custom();
    let wasm_section_b = wasm_section_id_custom();
    if wasm_section_a != wasm_section_b {
        println("FAIL wasm_section");
        process_exit(1);
    }
    println("prod_ap_wasm_section: PASSED");
}
