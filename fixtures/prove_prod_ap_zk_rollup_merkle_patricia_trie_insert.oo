// # Product prove std/zk_rollup/merkle_patricia_trie_insert.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/merkle_patricia_trie_insert.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_insert.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_merkle_patricia_trie_insert: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_insert.oo";

pub fn main() {
    let merkle_patricia_trie_insert_a = mpt_common_prefix_len(0, 0);
    let merkle_patricia_trie_insert_b = mpt_common_prefix_len(0, 0);
    if merkle_patricia_trie_insert_a != merkle_patricia_trie_insert_b {
        println("FAIL merkle_patricia_trie_insert");
        process_exit(1);
    }
    println("prod_ap_merkle_patricia_trie_insert: PASSED");
}
