// # Product prove std/markup/xml.oo
//
// Logline: Fail-closed emit+gcc+run asserts xml_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/xml.oo.
//
// Beats:
//   1. Call xml_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xml: PASSED only if they match.

import "std/markup/xml.oo";

pub fn main() {
    let a = xml_parse("x");
    let b = xml_parse("x");
    if a != b {
        println("FAIL xml_parse");
        process_exit(1);
    }
    println("prod_xml: PASSED");
}
