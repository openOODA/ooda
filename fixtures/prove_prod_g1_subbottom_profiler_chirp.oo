// # Product prove std/robotics_auv/subbottom_profiler_chirp.oo
//
// Logline: Fail-closed emit+gcc+run asserts sbp_chirp_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/subbottom_profiler_chirp.oo.
//
// Beats:
//   1. Call sbp_chirp_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_subbottom_profiler_chirp: PASSED only if they match.

import "std/robotics_auv/subbottom_profiler_chirp.oo";

pub fn main() {
    let a: SbpChirpConfig = sbp_chirp_config_default();
    let b: SbpChirpConfig = sbp_chirp_config_default();
    if a.start_freq_khz != b.start_freq_khz {
        println("FAIL sbp_chirp_config_default");
        process_exit(1);
    }
    println("prod_subbottom_profiler_chirp: PASSED");
}
