// # Check distinguishes Result T/E
//
// Logline: Typecheck refuses assigning Result[String] where Result[Int] is required.
//
// Setup: Check must read T/E, not only the word Result.
//
// Beats:
//   1. f returns Result[Int, String].
//   2. g takes Result[String, String].
//   3. g(f()) must not typecheck.

pub fn f() -> Result[Int, String] {
    return Ok(7);
}

pub fn g(r: Result[String, String]) -> Int {
    return 0;
}

pub fn main() {
    let x: Int = g(f());
}

