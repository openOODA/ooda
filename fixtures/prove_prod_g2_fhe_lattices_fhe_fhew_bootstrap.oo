// # Product prove std/fhe_lattices/fhe_fhew_bootstrap.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhew_extract_msb is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_fhew_bootstrap.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fhew_extract_msb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_fhew_bootstrap: PASSED only if they match.

import "std/fhe_lattices/fhe_fhew_bootstrap.oo";

pub fn main() {
    let g2_a = fhew_extract_msb(2, 2);
    let g2_b = fhew_extract_msb(2, 2);
    if g2_a != g2_b {
        println("FAIL fhew_extract_msb");
        process_exit(1);
    }
    println("prod_g2_fhe_fhew_bootstrap: PASSED");
}
