// # Product prove std/bft_consensus/downtime_liveness_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts validator_liveness_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/downtime_liveness_tracker.oo.
//
// Beats:
//   1. Call validator_liveness_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_downtime_liveness_tracker: PASSED only if they match.

import "std/bft_consensus/downtime_liveness_tracker.oo";

pub fn main() {
    let downtime_liveness_tracker_mark: Int = 0;
    if downtime_liveness_tracker_mark != 0 {
        process_exit(1);
    }
    let a: ValidatorLivenessRecord = validator_liveness_new("x", 0, 0);
    let b: ValidatorLivenessRecord = validator_liveness_new("x", 0, 0);
    if (a).window_size != (b).window_size {
        println("FAIL validator_liveness_new");
        process_exit(1);
    }
    println("prod_g2_downtime_liveness_tracker: PASSED");
}
