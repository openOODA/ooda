// # Product prove std/sec/crypto/bgv_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts bgv_params_degree is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bgv_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bgv_params_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bgv_types: PASSED only if they match.

import "std/sec/crypto/bgv_types.oo";

pub fn main() {
    let g2_oa = bgv_params_new(2, 2, 2);
    let g2_ob = bgv_params_new(2, 2, 2);
    let g2_a = bgv_params_degree(g2_oa);
    let g2_b = bgv_params_degree(g2_ob);
    if g2_a != g2_b {
        println("FAIL bgv_params_degree");
        process_exit(1);
    }
    println("prod_g2_bgv_types: PASSED");
}
