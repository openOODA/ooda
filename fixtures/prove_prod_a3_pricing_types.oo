// # Product prove std/fin/pricing_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts option_contract_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing_types.oo.
//
// Beats:
//   1. Call option_contract_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pricing_types: PASSED only if they match.

import "std/fin/pricing_types.oo";

pub fn main() {
    let pricing_types_mark: Int = 0;
    if pricing_types_mark != 0 {
        process_exit(1);
    }
    let a: OptionContract = option_contract_new(0, 0, 0);
    let b: OptionContract = option_contract_new(0, 0, 0);
    if (a).is_call != (b).is_call {
        println("FAIL option_contract_new");
        process_exit(1);
    }
    println("prod_pricing_types: PASSED");
}
