// # Product prove std/db_storage/sql_logical_plan_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/sql_logical_plan_builder.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_logical_plan_builder.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_sql_logical_plan_builder: PASSED only if they match.

import "std/db_storage/sql_logical_plan_builder.oo";

pub fn main() {
    let sql_logical_plan_builder_a = logical_plan_tree_new();
    let sql_logical_plan_builder_b = logical_plan_tree_new();
    if sql_logical_plan_builder_a.root_node_id != sql_logical_plan_builder_b.root_node_id {
        println("FAIL sql_logical_plan_builder");
        process_exit(1);
    }
    println("prod_ap_sql_logical_plan_builder: PASSED");
}
