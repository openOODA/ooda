// # Product prove std/simd/simd_vec4f.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_vec4f.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_vec4f.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_vec4f: PASSED only if they match.

import "std/simd/simd_vec4f.oo";

pub fn main() {
    let simd_vec4f_a = vec4f_new(0.0, 0.0, 0.0, 0.0);
    let simd_vec4f_b = vec4f_new(0.0, 0.0, 0.0, 0.0);
    let simd_vec4f_va = vec4f_hadd(simd_vec4f_a);
    let simd_vec4f_vb = vec4f_hadd(simd_vec4f_b);
    if simd_vec4f_va != simd_vec4f_vb {
        println("FAIL simd_vec4f");
        process_exit(1);
    }
    println("prod_ap_simd_vec4f: PASSED");
}
