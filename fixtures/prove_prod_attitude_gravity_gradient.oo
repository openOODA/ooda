// # Product prove std/astro_advanced/attitude_gravity_gradient.oo
//
// Logline: Fail-closed emit+gcc+run asserts gg_torque is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_gravity_gradient.oo.
//
// Beats:
//   1. Call gg_torque twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_gravity_gradient: PASSED only if they match.

import "std/astro_advanced/attitude_gravity_gradient.oo";

pub fn main() {
    let a = gg_torque(0);
    let b = gg_torque(0);
    if a != b {
        println("FAIL gg_torque");
        process_exit(1);
    }
    println("prod_attitude_gravity_gradient: PASSED");
}
