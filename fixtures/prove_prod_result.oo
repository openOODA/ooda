// # Product std result prove
//
// Logline: Fail-closed emit+gcc+run of shipped Result helpers.
//
// Setup: Tree oodac emit-c. Calls std/result.oo. No destub.
//
// Beats:
//   1. res_ok("x") is_ok.
//   2. res_err("e") is_err.
//   3. res_unwrap_or(res_err("e"), "d") == "d".
//   4. res_unwrap_or(res_ok("x"), "d") == "x".
//   5. Exit 1 before PASSED on a miss.

import "std/result.oo";

pub fn main() {
    let ok_r: Result[String, String] = res_ok("x");
    if !res_is_ok(ok_r) {
        println("FAIL is_ok");
        process_exit(1);
    }
    let err_r: Result[String, String] = res_err("e");
    if !res_is_err(err_r) {
        println("FAIL is_err");
        process_exit(1);
    }
    let d: String = res_unwrap_or(res_err("e"), "d");
    if d != "d" {
        println("FAIL unwrap_or err");
        process_exit(1);
    }
    let x: String = res_unwrap_or(res_ok("x"), "d");
    if x != "x" {
        println("FAIL unwrap_or ok");
        process_exit(1);
    }
    println("prod_result: PASSED");
}
