// # Product prove std/db_graph/opencypher_group_aggregate.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_group_aggregate.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_group_aggregate.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_opencypher_group_aggregate: PASSED only if they match.

import "std/db_graph/opencypher_group_aggregate.oo";

pub fn main() {
    let opencypher_group_aggregate_a = group_accumulator_new("x");
    let opencypher_group_aggregate_b = group_accumulator_new("x");
    let opencypher_group_aggregate_va = group_accumulator_avg(opencypher_group_aggregate_a);
    let opencypher_group_aggregate_vb = group_accumulator_avg(opencypher_group_aggregate_b);
    if opencypher_group_aggregate_va != opencypher_group_aggregate_vb {
        println("FAIL opencypher_group_aggregate");
        process_exit(1);
    }
    println("prod_ap_opencypher_group_aggregate: PASSED");
}
