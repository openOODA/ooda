// # Product prove std/industrial_predictive/ts_proportional_hazards_cox.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_proportional_hazards_cox.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_proportional_hazards_cox: PASSED only if they match.

import "std/industrial_predictive/ts_proportional_hazards_cox.oo";

pub fn main() {
    let ts_proportional_hazards_cox_mark: Int = 0;
    if ts_proportional_hazards_cox_mark != 0 {
        process_exit(1);
    }
    let ts_proportional_hazards_cox_a: Float = int_to_float(1);
    let ts_proportional_hazards_cox_b: Float = int_to_float(1);
    if ts_proportional_hazards_cox_a != ts_proportional_hazards_cox_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_ts_proportional_hazards_cox: PASSED");
}
