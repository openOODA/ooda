// # Product prove std/space_propulsion/propellant_pogo_suppression.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/propellant_pogo_suppression.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_pogo_suppression.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_propellant_pogo_suppression: PASSED only if they match.

import "std/space_propulsion/propellant_pogo_suppression.oo";

pub fn main() {
    let propellant_pogo_suppression_a = pogo_spec_default();
    let propellant_pogo_suppression_b = pogo_spec_default();
    if propellant_pogo_suppression_a.structural_frequency_hz != propellant_pogo_suppression_b.structural_frequency_hz {
        println("FAIL propellant_pogo_suppression");
        process_exit(1);
    }
    println("prod_ap_propellant_pogo_suppression: PASSED");
}
