// # Product prove std/sec/sys/smap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/smap_types.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/smap_types.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_smap_types: PASSED only if they match.

import "std/sec/sys/smap_types.oo";

pub fn main() {
    let smap_types_a = smap_status_new();
    let smap_types_b = smap_status_new();
    if smap_types_a.violation_count != smap_types_b.violation_count {
        println("FAIL smap_types");
        process_exit(1);
    }
    println("prod_ap_smap_types: PASSED");
}
