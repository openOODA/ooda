// # LLVM Verify Strings Fixture
//
// Logline: Exercises pure string functions and verify blocks on the LLVM backend.
//
// Setup: Pure string helper functions with verify blocks and main execution assertions.
//
// Beats:
//   1. Test string concat, slice, trim, and case conversion.
//   2. Verify pure functions with verify blocks.
//   3. Assert return values in main and confirm zero exit code.

pub fn join_slug(prefix: String, delim: String, suffix: String) -> String {
    let left = prefix + delim;
    return left + suffix;
}

verify join_slug {
    assert_eq!(join_slug("open", "_", "OODA"), "open_OODA");
    assert_eq!(join_slug("alpha", "-", "beta"), "alpha-beta");
}

pub fn make_uppercase_slug(s: String) -> String {
    let trimmed = str_trim(s);
    return str_to_uppercase(trimmed);
}

verify make_uppercase_slug {
    assert_eq!(make_uppercase_slug("  ooda  "), "OODA");
    assert_eq!(make_uppercase_slug("llvm"), "LLVM");
}

pub fn make_lowercase_slug(s: String) -> String {
    let trimmed = str_trim(s);
    return str_to_lowercase(trimmed);
}

verify make_lowercase_slug {
    assert_eq!(make_lowercase_slug("  SWARM  "), "swarm");
    assert_eq!(make_lowercase_slug("CLANG"), "clang");
}

pub fn sub_slice(s: String, start: Int, end: Int) -> String {
    return str_slice(s, start, end);
}

verify sub_slice {
    assert_eq!(sub_slice("hello world", 0, 5), "hello");
    assert_eq!(sub_slice("openOODA", 4, 8), "OODA");
}

pub fn count_char_matches(s: String, target: String) -> Int {
    let mut count = 0;
    let mut i = 0;
    let n = chars_len(s);
    while i < n {
        let c = char_at(s, i);
        if c == target {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

verify count_char_matches {
    assert_eq!(count_char_matches("banana", "a"), 3);
    assert_eq!(count_char_matches("banana", "n"), 2);
    assert_eq!(count_char_matches("banana", "z"), 0);
}

pub fn reverse_string(s: String) -> String {
    let mut res = "";
    let mut i = chars_len(s);
    while i > 0 {
        i = i - 1;
        let c = char_at(s, i);
        res = res + c;
    }
    return res;
}

verify reverse_string {
    assert_eq!(reverse_string("abc"), "cba");
    assert_eq!(reverse_string("OODA"), "ADOO");
}

pub fn main() {
    let s1 = join_slug("open", "_", "OODA");
    assert_eq!(s1, "open_OODA");
    println(s1);

    let s2 = make_uppercase_slug("  ooda  ");
    assert_eq!(s2, "OODA");
    println(s2);

    let s3 = make_lowercase_slug("  SWARM  ");
    assert_eq!(s3, "swarm");
    println(s3);

    let s4 = sub_slice("openOODA", 4, 8);
    assert_eq!(s4, "OODA");
    println(s4);

    let cnt = count_char_matches("banana", "a");
    assert_eq!(cnt, 3);
    println(cnt);

    let rev = reverse_string("OODA");
    assert_eq!(rev, "ADOO");
    println(rev);

    println("LLVM_VERIFY_STRINGS_OK");
}
