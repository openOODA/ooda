// # Product prove std/cloud_k8s/service_mesh_envoy_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts envoy_route_table_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/service_mesh_envoy_filter.oo.
//
// Beats:
//   1. Call envoy_route_table_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_service_mesh_envoy_filter: PASSED only if asserts hold.

import "std/cloud_k8s/service_mesh_envoy_filter.oo";

pub fn main() {
    let service_mesh_envoy_filter_a: EnvoyRouteTable = envoy_route_table_new("x");
    let service_mesh_envoy_filter_b: EnvoyRouteTable = envoy_route_table_new("x");
    if chars_len(service_mesh_envoy_filter_a.default_cluster) != chars_len(service_mesh_envoy_filter_b.default_cluster) {
        println("FAIL envoy_route_table_new");
        process_exit(1);
    }
    println("prod_service_mesh_envoy_filter: PASSED");
}
