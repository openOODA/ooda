// # Product prove std/scicomp/sparse_solver_gmres.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/sparse_solver_gmres.oo.
//
// Beats:
//   1. Call math_sqrt_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sparse_solver_gmres: PASSED only if they match.

import "std/scicomp/sparse_solver_gmres.oo";

pub fn main() {
    let sparse_solver_gmres_mark: Int = 0;
    if sparse_solver_gmres_mark != 0 {
        process_exit(1);
    }
    let a: Float = math_sqrt_approx(0.0);
    let b: Float = math_sqrt_approx(0.0);
    if a != b {
        println("FAIL math_sqrt_approx");
        process_exit(1);
    }
    println("prod_g2_sparse_solver_gmres: PASSED");
}
