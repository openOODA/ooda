// # Product sync mpsc channel prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/channel_mpsc.oo.
//
// Setup: Product std/sync/channel_mpsc.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(8) len 0 not closed. new(0) cap 64. clone senders.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/channel_mpsc.oo";

pub fn main() {
    let ch: MpscChannel = mpsc_channel_new(8);
    let n: Int = mpsc_len(ch);
    if n != 0 {
        println("FAIL mpsc len");
        process_exit(1);
    }
    if mpsc_is_empty(ch) == false {
        println("FAIL mpsc empty");
        process_exit(1);
    }
    if mpsc_is_closed(ch) {
        println("FAIL mpsc closed");
        process_exit(1);
    }
    let ch2: MpscChannel = mpsc_channel_new(0);
    if mpsc_is_full(ch2) {
        println("FAIL mpsc full 64");
        process_exit(1);
    }
    let cl: MpscChannel = mpsc_sender_clone(ch);
    if mpsc_is_closed(cl) {
        println("FAIL mpsc clone");
        process_exit(1);
    }
    println("prod_mpscch: PASSED");
}
