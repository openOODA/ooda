// # Product prove std/bft_consensus/dynamic_reconfiguration_epoch.oo
//
// Logline: Fail-closed emit+gcc+run asserts epoch_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dynamic_reconfiguration_epoch.oo.
//
// Beats:
//   1. Call epoch_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dynamic_reconfiguration_epoch: PASSED only if they match.

import "std/bft_consensus/dynamic_reconfiguration_epoch.oo";

pub fn main() {
    let dynamic_reconfiguration_epoch_mark: Int = 0;
    if dynamic_reconfiguration_epoch_mark != 0 {
        process_exit(1);
    }
    let a: EpochState = epoch_state_new(0, 0, 0);
    let b: EpochState = epoch_state_new(0, 0, 0);
    if (a).current_epoch != (b).current_epoch {
        println("FAIL epoch_state_new");
        process_exit(1);
    }
    println("prod_dynamic_reconfiguration_epoch: PASSED");
}
