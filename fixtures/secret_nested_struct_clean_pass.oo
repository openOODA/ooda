// # Allow nested struct clean field
//
// Logline: Multi-hop access to a clean field user.creds.name is allowed while secret is present.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag secret_val as secret.
//   2. Construct nested struct User with clean fields.
//   3. Print user.creds.name so the sink stays allowed.
//
// clean nested struct field stays allowed
type Creds = struct { token: String, name: String };
type User = struct { creds: Creds };
// SECRET: secret_val
pub fn main() {
    let secret_val = "s3cret-payload";
    let c = Creds { token: "public_tok", name: "alice" };
    let user = User { creds: c };
    println(user.creds.name);
}
