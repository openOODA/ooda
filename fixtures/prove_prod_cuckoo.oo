// # Product cuckoo_filter prove
//
// Logline: Fail-closed emit+gcc+run of shipped cuckoo_filter_insert/contains.
//
// Setup: Product std/collections/cuckoo_filter.oo. Fingerprint 7.
//
// Beats:
//   1. After insert 7, contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/cuckoo_filter.oo";

pub fn main() {
    let mut c: CuckooFilter = cuckoo_filter_new(8);
    c = cuckoo_filter_insert(c, 7);
    let y: Bool = cuckoo_filter_contains(c, 7);
    if y == false {
        println("FAIL cuckoo 7");
        process_exit(1);
    }
    let n: Bool = cuckoo_filter_contains(c, 3);
    if n == true {
        println("FAIL cuckoo 3");
        process_exit(1);
    }
    println("prod_cuckoo: PASSED");
}
