// # Product prove std/aero/aerodynamics_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts aero_dynamic_pressure_milli is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/aerodynamics_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call aero_dynamic_pressure_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_aerodynamics_types: PASSED only if they match.

import "std/aero/aerodynamics_types.oo";

pub fn main() {
    let g0_a = aero_dynamic_pressure_milli(2, 2);
    let g0_b = aero_dynamic_pressure_milli(2, 2);
    if g0_a != g0_b {
        println("FAIL aero_dynamic_pressure_milli");
        process_exit(1);
    }
    println("prod_g0_aerodynamics_types: PASSED");
}
