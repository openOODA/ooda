// # Product prove std/robotics_auv/heading_autopilot_sliding_mode.oo
//
// Logline: Fail-closed emit+check asserts sat_boundary_layer is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/heading_autopilot_sliding_mode.oo.
//
// Beats:
//   1. Call sat_boundary_layer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heading_autopilot_sliding_mode: PASSED only if they match.

import "std/robotics_auv/heading_autopilot_sliding_mode.oo";

pub fn main() {
    let heading_autopilot_sliding_mode_mark: Int = 0;
    if heading_autopilot_sliding_mode_mark != 0 { process_exit(1); }
    let a: Float = sat_boundary_layer(0.5, 0.1);
    let b: Float = sat_boundary_layer(0.5, 0.1);
    if a != b { process_exit(1); }
    println("prod_heading_autopilot_sliding_mode: PASSED");
}
