// # Product prove std/net/tls_session.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net/tls_session.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/net/tls_session.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_tls_session: PASSED only if they match.

import "std/net/tls_session.oo";

pub fn main() {
    let tls_session_a = tls_config_new("x", 0);
    let tls_session_b = tls_config_new("x", 0);
    if chars_len(tls_session_a.host) != 1 {
        println("FAIL tls_session");
        process_exit(1);
    }
    println("prod_ap_tls_session: PASSED");
}
