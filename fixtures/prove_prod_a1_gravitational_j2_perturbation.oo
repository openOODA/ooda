// # Product prove std/astrodynamics/gravitational_j2_perturbation.oo
//
// Logline: Fail-closed emit+gcc+run asserts earth_j2_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/gravitational_j2_perturbation.oo.
//
// Beats:
//   1. Call earth_j2_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gravitational_j2_perturbation: PASSED only if they match.

import "std/astrodynamics/gravitational_j2_perturbation.oo";

pub fn main() {
    let gravitational_j2_perturbation_mark: Int = 0;
    if gravitational_j2_perturbation_mark != 0 {
        process_exit(1);
    }
    let a: Int = earth_j2_milli();
    let b: Int = earth_j2_milli();
    if a != b {
        println("FAIL earth_j2_milli");
        process_exit(1);
    }
    println("prod_gravitational_j2_perturbation: PASSED");
}
