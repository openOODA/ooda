// # Product prove std/cloud_k8s/consistent_hash_ring.oo
//
// Logline: Fail-closed emit+gcc+run asserts hash_string_token is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/consistent_hash_ring.oo.
//
// Beats:
//   1. Call hash_string_token twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_consistent_hash_ring: PASSED only if they match.

import "std/cloud_k8s/consistent_hash_ring.oo";

pub fn main() {
    let consistent_hash_ring_mark: Int = 0;
    if consistent_hash_ring_mark != 0 {
        process_exit(1);
    }
    let a: Int = hash_string_token(0, 0);
    let b: Int = hash_string_token(0, 0);
    if a != b {
        println("FAIL hash_string_token");
        process_exit(1);
    }
    println("prod_consistent_hash_ring: PASSED");
}
