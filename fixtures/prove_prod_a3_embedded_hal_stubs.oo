// # Product prove std/embedded_hal/embedded_hal_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts hal_hardware_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/embedded_hal_stubs.oo.
//
// Beats:
//   1. Call hal_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_embedded_hal_stubs: PASSED only if they match.

import "std/embedded_hal/embedded_hal_stubs.oo";

pub fn main() {
    let embedded_hal_stubs_mark: Int = 0;
    if embedded_hal_stubs_mark != 0 {
        process_exit(1);
    }
    let a: HalHardwareConfig = hal_hardware_config_new(0, 0);
    let b: HalHardwareConfig = hal_hardware_config_new(0, 0);
    if (a).device_base_addr != (b).device_base_addr {
        println("FAIL hal_hardware_config_new");
        process_exit(1);
    }
    println("prod_embedded_hal_stubs: PASSED");
}
