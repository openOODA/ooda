// # Product prove std/tda_topology/persistent_homology_barcodes.oo
//
// Logline: Fail-closed emit+gcc+run asserts barcode_interval_infinite is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistent_homology_barcodes.oo.
//
// Beats:
//   1. Call barcode_interval_infinite twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistent_homology_barcodes: PASSED only if they match.

import "std/tda_topology/persistent_homology_barcodes.oo";

pub fn main() {
    let persistent_homology_barcodes_mark: Int = 0;
    if persistent_homology_barcodes_mark != 0 {
        process_exit(1);
    }
    let persistent_homology_barcodes_a = barcode_interval_infinite(1, 1, 1.0);
    let persistent_homology_barcodes_b = barcode_interval_infinite(1, 1, 1.0);
    if (persistent_homology_barcodes_a).dimension != (persistent_homology_barcodes_b).dimension {
        println("FAIL barcode_interval_infinite");
        process_exit(1);
    }
    println("prod_persistent_homology_barcodes: PASSED");
}
