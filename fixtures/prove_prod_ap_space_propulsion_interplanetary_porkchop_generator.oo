//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_interplanetary_porkchop_generator: PASSED only if they match.

import "std/space_propulsion/interplanetary_porkchop_generator.oo";

pub fn main() {
    let interplanetary_porkchop_generator_a = porkchop_evaluate_earth_mars_point(0.0, 0.0);
    let interplanetary_porkchop_generator_b = porkchop_evaluate_earth_mars_point(0.0, 0.0);
    if interplanetary_porkchop_generator_a.departure_day_offset != interplanetary_porkchop_generator_b.departure_day_offset {
        println("FAIL interplanetary_porkchop_generator");
        process_exit(1);
    }
    println("prod_ap_interplanetary_porkchop_generator: PASSED");
}
