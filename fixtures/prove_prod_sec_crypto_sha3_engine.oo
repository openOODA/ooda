// # Product prove std/sec/crypto/sha3_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha3_security_policy_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/sha3_engine.oo.
//
// Beats:
//   1. Call sha3_security_policy_default twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha3_engine: PASSED only if they match.

import "std/sec/crypto/sha3_engine.oo";

pub fn main() {
    let sha3_engine_mark: Int = 0;
    if sha3_engine_mark != 0 {
        process_exit(1);
    }
    let a: Sha3SecurityPolicy = sha3_security_policy_default();
    let b: Sha3SecurityPolicy = sha3_security_policy_default();
    if (a).min_digest_bits != (b).min_digest_bits {
        println("FAIL sha3_security_policy_default");
        process_exit(1);
    }
    println("prod_sha3_engine: PASSED");
}
