// # Product prove std/quantum_open_systems/heisenberg_langevin_equations.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/heisenberg_langevin_equations.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/heisenberg_langevin_equations.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_heisenberg_langevin_equations: PASSED only if they match.

import "std/quantum_open_systems/heisenberg_langevin_equations.oo";

pub fn main() {
    let heisenberg_langevin_equations_a = langevin_params_new(0.0, 0.0, 0.0);
    let heisenberg_langevin_equations_b = langevin_params_new(0.0, 0.0, 0.0);
    if heisenberg_langevin_equations_a.resonance_freq != heisenberg_langevin_equations_b.resonance_freq {
        println("FAIL heisenberg_langevin_equations");
        process_exit(1);
    }
    println("prod_ap_heisenberg_langevin_equations: PASSED");
}
