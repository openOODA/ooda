// # Product prove std/3d/mesh.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_stat_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/mesh.oo.
//
// Beats:
//   1. Call mesh_stat_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh: PASSED only if they match.

import "std/3d/mesh.oo";

pub fn main() {
    let a: MeshStat = mesh_stat_new(0, 0);
    let b: MeshStat = mesh_stat_new(0, 0);
    if (a).verts != (b).verts {
        println("FAIL mesh_stat_new");
        process_exit(1);
    }
    println("prod_mesh: PASSED");
}
