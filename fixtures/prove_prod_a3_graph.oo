// # Product prove std/gui/graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_view_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/graph.oo.
//
// Beats:
//   1. Call graph_view_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph: PASSED only if they match.

import "std/gui/graph.oo";

pub fn main() {
    let a: GraphView = graph_view_new(0, 0, 0, 0);
    let b: GraphView = graph_view_new(0, 0, 0, 0);
    if (a).ox != (b).ox {
        println("FAIL graph_view_new");
        process_exit(1);
    }
    println("prod_graph: PASSED");
}
