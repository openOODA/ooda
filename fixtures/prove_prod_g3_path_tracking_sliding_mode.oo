// # Product prove std/auto_mpc_control/path_tracking_sliding_mode.oo
//
// Logline: Fail-closed emit+gcc+run asserts sliding_mode_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/path_tracking_sliding_mode.oo.
//
// Beats:
//   1. Call sliding_mode_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_tracking_sliding_mode: PASSED only if they match.

import "std/auto_mpc_control/path_tracking_sliding_mode.oo";

pub fn main() {
    let path_tracking_sliding_mode_mark: Int = 0;
    if path_tracking_sliding_mode_mark != 0 {
        process_exit(1);
    }
    let a: SlidingModeConfig = sliding_mode_config_default();
    let b: SlidingModeConfig = sliding_mode_config_default();
    if (a).c1_surface != (b).c1_surface {
        println("FAIL sliding_mode_config_default");
        process_exit(1);
    }
    println("prod_path_tracking_sliding_mode: PASSED");
}
