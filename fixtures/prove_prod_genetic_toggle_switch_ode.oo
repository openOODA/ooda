// # Product prove std/synthetic_biology/genetic_toggle_switch_ode.oo
//
// Logline: Fail-closed emit+gcc+run asserts toggle_pow real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/genetic_toggle_switch_ode.oo.
//
// Beats:
//   1. Call toggle_pow with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_genetic_toggle_switch_ode: PASSED only if the assert holds.

import "std/synthetic_biology/genetic_toggle_switch_ode.oo";

pub fn main() {
    let genetic_toggle_switch_ode_mark: Int = 0;
    if genetic_toggle_switch_ode_mark != 0 {
        process_exit(1);
    }
    let genetic_toggle_switch_ode_n: Float = toggle_pow(0.0, 0);
    if !(genetic_toggle_switch_ode_n == 1.0) {
        println("FAIL toggle_pow");
        process_exit(1);
    }
    println("prod_genetic_toggle_switch_ode: PASSED");
}
