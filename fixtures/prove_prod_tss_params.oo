// # Product prove std/sec/crypto/tss_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts tss_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss_types.oo.
//
// Beats:
//   1. Call tss_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tss_params: PASSED only if they match.

import "std/sec/crypto/tss_types.oo";

pub fn main() {
    let tss_types_mark: Int = 0;
    if tss_types_mark != 0 { process_exit(1); }
    let a: ThresholdParams = tss_params_new(2, 3, 1);
    let b: ThresholdParams = tss_params_new(2, 3, 1);
    let at: Int = (a).threshold;
    let bt: Int = (b).threshold;
    if at != bt {
        println("FAIL tss_params_new");
        process_exit(1);
    }
    println("prod_tss_params: PASSED");
}
