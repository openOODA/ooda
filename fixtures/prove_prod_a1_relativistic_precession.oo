// # Product prove std/astro_advanced/relativistic_precession.oo
//
// Logline: Fail-closed emit+gcc+run asserts mercury_precession_as is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/relativistic_precession.oo.
//
// Beats:
//   1. Call mercury_precession_as twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_relativistic_precession: PASSED only if they match.

import "std/astro_advanced/relativistic_precession.oo";

pub fn main() {
    let relativistic_precession_mark: Int = 0;
    if relativistic_precession_mark != 0 {
        process_exit(1);
    }
    let a: Int = mercury_precession_as();
    let b: Int = mercury_precession_as();
    if a != b {
        println("FAIL mercury_precession_as");
        process_exit(1);
    }
    println("prod_relativistic_precession: PASSED");
}
