// # Product prove std/db_vector_ann/vector_random_projection_lsh.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsh_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_random_projection_lsh.oo.
//
// Beats:
//   1. Call lsh_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_random_projection_lsh: PASSED only if they match.

import "std/db_vector_ann/vector_random_projection_lsh.oo";

pub fn main() {
    let vector_random_projection_lsh_mark: Int = 0;
    if vector_random_projection_lsh_mark != 0 {
        process_exit(1);
    }
    let a: LshConfig = lsh_config_default(0, 0);
    let b: LshConfig = lsh_config_default(0, 0);
    if (a).num_hyperplanes != (b).num_hyperplanes {
        println("FAIL lsh_config_default");
        process_exit(1);
    }
    println("prod_g2_vector_random_projection_lsh: PASSED");
}
