// # Product prove std/db_graph/graph_closeness_centrality.oo
//
// Logline: Fail-closed emit+gcc+run asserts closeness_score_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_closeness_centrality.oo.
//
// Beats:
//   1. Call closeness_score_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_closeness_centrality: PASSED only if they match.

import "std/db_graph/graph_closeness_centrality.oo";

pub fn main() {
    let graph_closeness_centrality_mark: Int = 0;
    if graph_closeness_centrality_mark != 0 {
        process_exit(1);
    }
    let a: ClosenessScore = closeness_score_new(0);
    let b: ClosenessScore = closeness_score_new(0);
    if (a).node_id != (b).node_id {
        println("FAIL closeness_score_new");
        process_exit(1);
    }
    println("prod_g2_graph_closeness_centrality: PASSED");
}
