// # Product prove std/zk_rollup/sparse_merkle_tree_audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_sibling_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_audit.oo.
//
// Beats:
//   1. Call smt_sibling_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_merkle_tree_audit: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_audit.oo";

pub fn main() {
    let sparse_merkle_tree_audit_mark: Int = 0;
    if sparse_merkle_tree_audit_mark != 0 {
        process_exit(1);
    }
    let a: SmtSibling = smt_sibling_new("x", true, 0);
    let b: SmtSibling = smt_sibling_new("x", true, 0);
    if (a).level != (b).level {
        println("FAIL smt_sibling_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_audit: PASSED");
}
