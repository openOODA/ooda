// # Product prove std/cloud/cloud_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts cloud_hardware_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/cloud_stubs.oo.
//
// Beats:
//   1. Call cloud_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cloud_stubs: PASSED only if they match.

import "std/cloud/cloud_stubs.oo";

pub fn main() {
    let cloud_stubs_mark: Int = 0;
    if cloud_stubs_mark != 0 {
        process_exit(1);
    }
    let a: CloudHardwareConfig = cloud_hardware_config_new(0, "x");
    let b: CloudHardwareConfig = cloud_hardware_config_new(0, "x");
    if (a).accelerator_type != (b).accelerator_type {
        println("FAIL cloud_hardware_config_new");
        process_exit(1);
    }
    println("prod_cloud_stubs: PASSED");
}
