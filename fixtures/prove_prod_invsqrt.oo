// # Product fast invsqrt prove
//
// Logline: Fail-closed emit+gcc+run of shipped fast_sqrt.
//
// Setup: Product std/math/fast_math_invsqrt.oo. Newton from exact 1/sqrt(4).
//
// Beats:
//   1. fast_sqrt(4.0) is 2.0.
//   2. fast_inv_sqrt(4.0) is 0.5.
//   3. Exit 1 before PASSED on a miss.

import "std/math/fast_math_invsqrt.oo";

pub fn main() {
    let s: Float = fast_sqrt(4.0);
    if s != 2.0 {
        println("FAIL fast_sqrt 4");
        process_exit(1);
    }
    let inv: Float = fast_inv_sqrt(4.0);
    if inv != 0.5 {
        println("FAIL fast_inv_sqrt 4");
        process_exit(1);
    }
    println("prod_invsqrt: PASSED");
}
