// # Product prove std/satellite_dvb/satellite_dvb_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts satellite_hardware_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_dvb_stubs.oo.
//
// Beats:
//   1. Call satellite_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_dvb_stubs: PASSED only if they match.

import "std/satellite_dvb/satellite_dvb_stubs.oo";

pub fn main() {
    let a: SatelliteHardwareCapabilities = satellite_hardware_capabilities_default();
    let b: SatelliteHardwareCapabilities = satellite_hardware_capabilities_default();
    if a.supports_fpga_dvb_framing != b.supports_fpga_dvb_framing {
        println("FAIL satellite_hardware_capabilities_default");
        process_exit(1);
    }
    println("prod_satellite_dvb_stubs: PASSED");
}
