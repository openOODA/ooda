// # Bind secret from an if-expr
//
// Logline: Bind y from an if-expression that yields the secret and print y.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag x as secret.
//   2. Bind y to if true { x } else { public }.
//   3. Print y.
//
// T1-3b related: if-expression RHS — LBRACE walker may drop taint on prop
// SECRET: x
pub fn main() {
    let x = "token";
    let y = if true { x } else { "public" };
    println(y);
}
