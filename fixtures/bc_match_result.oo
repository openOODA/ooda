// M6: match Result Ok/Err surface on bytecode VM
fn make_ok() -> Result[String, String] {
    return Ok("ok");
}
fn make_err() -> Result[String, String] {
    return Err("bad");
}
pub fn main() {
    let a = match make_ok() {
        Ok(v) => v,
        Err(e) => e,
    };
    println(a);
    let b = match make_err() {
        Ok(v) => v,
        Err(e) => e,
    };
    println(b);
}
