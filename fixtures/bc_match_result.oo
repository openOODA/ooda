// # Match Result helpers
//
// Logline: Match Result[String, String] from helpers that return Ok or Err.
//
// Beats:
//   1. make_ok returns Ok("ok"); make_err returns Err("bad").
//   2. Main matches each result onto a string.
//   3. Print the Ok payload then the Err payload.

// M6: match Result Ok/Err surface on bytecode VM
fn make_ok() -> Result[String, String] {
    return Ok("ok");
}
fn make_err() -> Result[String, String] {
    return Err("bad");
}
pub fn main() {
    let a = match make_ok() {
        Ok(v) => v,
        Err(e) => e
    };
    println(a);
    let b = match make_err() {
        Ok(v) => v,
        Err(e) => e
    };
    println(b);
}
