// # Product prove std/media_dsp/h264_nal_unit_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts h264_nal_slice_non_idr is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/h264_nal_unit_parser.oo.
//
// Beats:
//   1. Call h264_nal_slice_non_idr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_h264_nal_unit_parser: PASSED only if they match.

import "std/media_dsp/h264_nal_unit_parser.oo";

pub fn main() {
    let h264_nal_unit_parser_mark: Int = 0;
    if h264_nal_unit_parser_mark != 0 {
        process_exit(1);
    }
    let h264_nal_unit_parser_a: Int = h264_nal_slice_non_idr();
    let h264_nal_unit_parser_b: Int = h264_nal_slice_non_idr();
    if h264_nal_unit_parser_a != h264_nal_unit_parser_b {
        println("FAIL h264_nal_slice_non_idr");
        process_exit(1);
    }
    println("prod_h264_nal_unit_parser: PASSED");
}
