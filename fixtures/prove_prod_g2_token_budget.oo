// # Product prove std/token_opt/token_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_budget_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/token_opt/token_budget.oo.
//
// Beats:
//   1. Call token_budget_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_token_budget: PASSED only if they match.

import "std/token_opt/token_budget.oo";

pub fn main() {
    let a: TokenBudgetConfig = token_budget_config_new(0, 0);
    let b: TokenBudgetConfig = token_budget_config_new(0, 0);
    if (a).max_context_tokens != (b).max_context_tokens {
        println("FAIL token_budget_config_new");
        process_exit(1);
    }
    println("prod_g2_token_budget: PASSED");
}
