// # Product prove std/quantum_advanced/quantum_basis_transpiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts basis_ibm is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_basis_transpiler.oo.
//
// Beats:
//   1. Call basis_ibm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_basis_transpiler: PASSED only if they match.

import "std/quantum_advanced/quantum_basis_transpiler.oo";

pub fn main() {
    let a: NativeBasisType = basis_ibm();
    let b: NativeBasisType = basis_ibm();
    if a.mode != b.mode {
        println("FAIL basis_ibm");
        process_exit(1);
    }
    println("prod_quantum_basis_transpiler: PASSED");
}
