// # Product prove std/zk_rollup/schnorr_signature_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts schnorr_pubkey_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/schnorr_signature_batch.oo.
//
// Beats:
//   1. Call schnorr_pubkey_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_schnorr_signature_batch: PASSED only if they match.

import "std/zk_rollup/schnorr_signature_batch.oo";

pub fn main() {
    let schnorr_signature_batch_mark: Int = 0;
    if schnorr_signature_batch_mark != 0 {
        process_exit(1);
    }
    let schnorr_signature_batch_a = schnorr_pubkey_new(1, 1);
    let schnorr_signature_batch_b = schnorr_pubkey_new(1, 1);
    if (schnorr_signature_batch_a).point_x != (schnorr_signature_batch_b).point_x {
        println("FAIL schnorr_pubkey_new");
        process_exit(1);
    }
    println("prod_schnorr_signature_batch: PASSED");
}
