// # Product prove std/aero/orbit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/orbit_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbit_engine: PASSED only if they match.

import "std/aero/orbit_engine.oo";

pub fn main() {
    let orbit_engine_a = calculate_inclination_change_dv(0.0, 0.0);
    let orbit_engine_b = calculate_inclination_change_dv(0.0, 0.0);
    if orbit_engine_a != orbit_engine_b {
        println("FAIL orbit_engine");
        process_exit(1);
    }
    println("prod_ap_orbit_engine: PASSED");
}
