// # Hostile ident mod fold
//
// Logline: Print 8 % x so emit-wasm must miss a const 8%3 fold.
//
// Setup: One public main. Right operand is IDENT x, not INT.
//
// Beats:
//   1. Let x be 3.
//   2. Print 8 % x.
//   3. A 2-only module is a lie.

pub fn main() {
    let x = 3;
    println(8 % x);
}
