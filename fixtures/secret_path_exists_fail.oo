// # Refuse a secret path_exists path
//
// Logline: A tagged name must not be used as the path_exists path.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the path.
//   3. Expect the sink to refuse.

// M142: Secret must not be used as path_exists path
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let r = path_exists(fs, token);
    println(1);
}
