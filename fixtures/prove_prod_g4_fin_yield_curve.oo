// # Product prove std/fin/yield_curve.oo
//
// Logline: Fail-closed verification that yield curve construction and discount factors are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_curve.oo.
//
// Beats:
//   1. Create discount factors and swap rate structures.
//   2. Construct calibrated yield curve and add rate points.
//   3. Assert deterministic discount factors and curve point lookups.
//   4. Print prod_g4_fin_yield_curve: PASSED and exit 0.

import "std/fin/yield_curve.oo";

pub fn main() {
    let df1: DiscountFactor = discount_factor_create(12, 450, 0);
    let df2: DiscountFactor = discount_factor_create(12, 450, 0);

    let val1: Int = discount_factor_get_value(&df1);
    let val2: Int = discount_factor_get_value(&df2);
    if val1 != val2 || val1 <= 0 {
        println("FAIL discount_factor_get_value");
        process_exit(1);
    }

    let swap1: SwapRate = swap_rate_create("SWAP_1Y", 12, 450, 2, 4);
    let swap2: SwapRate = swap_rate_create("SWAP_1Y", 12, 450, 2, 4);

    let r1: Int = swap_rate_get_rate(&swap1);
    let r2: Int = swap_rate_get_rate(&swap2);
    if r1 != r2 || r1 != 450 {
        println("FAIL swap_rate_get_rate");
        process_exit(1);
    }

    let mut curve1: YieldCurve = yield_curve_create("USD_SOFR", 1, 20260819, 0);
    let mut curve2: YieldCurve = yield_curve_create("USD_SOFR", 1, 20260819, 0);

    let pt1: YieldCurvePoint = yield_curve_point_create(12, 450, 0);
    let pt2: YieldCurvePoint = yield_curve_point_create(12, 450, 0);

    let added1: Bool = yield_curve_add_point(&mut curve1, pt1);
    let added2: Bool = yield_curve_add_point(&mut curve2, pt2);
    if added1 != added2 || added1 == false {
        println("FAIL yield_curve_add_point");
        process_exit(1);
    }

    let count1: Int = yield_curve_get_point_count(&curve1);
    let count2: Int = yield_curve_get_point_count(&curve2);
    if count1 != count2 || count1 != 1 {
        println("FAIL yield_curve_get_point_count");
        process_exit(1);
    }

    println("prod_g4_fin_yield_curve: PASSED");
    process_exit(0);
}
