// # Product prove std/genomics_advanced/debruijn_graph_assembly.oo
//
// Logline: Fail-closed emit+gcc+run asserts debruijn_is_linear is a real value.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/debruijn_graph_assembly.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call debruijn_is_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_debruijn_graph_assembly: PASSED only if they match.

import "std/genomics_advanced/debruijn_graph_assembly.oo";

pub fn main() {
    let g2_oa: DeBruijnNode = DeBruijnNode { kmer_id: 2, in_degree: 2, out_degree: 2, coverage_count: 8 };
    let g2_ob: DeBruijnNode = DeBruijnNode { kmer_id: 2, in_degree: 2, out_degree: 2, coverage_count: 8 };
    let g2_a = debruijn_is_linear(&g2_oa);
    let g2_b = debruijn_is_linear(&g2_ob);
    if g2_a != g2_b {
        println("FAIL debruijn_is_linear");
        process_exit(1);
    }
    println("prod_g2_debruijn_graph_assembly: PASSED");
}
