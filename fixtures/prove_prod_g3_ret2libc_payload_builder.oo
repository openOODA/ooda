// # Product prove std/exploit_analysis/ret2libc_payload_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts libc_symbol_offsets_standard_x86_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/ret2libc_payload_builder.oo.
//
// Beats:
//   1. Call libc_symbol_offsets_standard_x86_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ret2libc_payload_builder: PASSED only if they match.

import "std/exploit_analysis/ret2libc_payload_builder.oo";

pub fn main() {
    let ret2libc_payload_builder_mark: Int = 0;
    if ret2libc_payload_builder_mark != 0 {
        process_exit(1);
    }
    let a: LibcSymbolOffsets = libc_symbol_offsets_standard_x86_64();
    let b: LibcSymbolOffsets = libc_symbol_offsets_standard_x86_64();
    if (a).system_offset != (b).system_offset {
        println("FAIL libc_symbol_offsets_standard_x86_64");
        process_exit(1);
    }
    println("prod_ret2libc_payload_builder: PASSED");
}
