// # Product prove std/markup/cbor_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/cbor_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/cbor_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cbor_decoder: PASSED only if they match.

import "std/markup/cbor_decoder.oo";

pub fn main() {
    let cbor_decoder_a = cbor_decode_uint(list_new(), 0);
    let cbor_decoder_b = cbor_decode_uint(list_new(), 0);
    if cbor_decoder_a.is_ok() != cbor_decoder_b.is_ok() {
        println("FAIL cbor_decoder");
        process_exit(1);
    }
    println("prod_ap_cbor_decoder: PASSED");
}
