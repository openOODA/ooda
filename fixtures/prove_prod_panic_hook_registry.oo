// # Product prove std/diag/panic_hook_registry.oo
//
// Logline: Fail-closed emit+gcc+run asserts panic_has_hooks is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/panic_hook_registry.oo.
//
// Beats:
//   1. Call panic_has_hooks twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_panic_hook_registry: PASSED only if they match.

import "std/diag/panic_hook_registry.oo";

pub fn main() {
    let obj = panic_registry_new();
    let a = panic_has_hooks(obj);
    let b = panic_has_hooks(obj);
    if a != b {
        println("FAIL panic_has_hooks");
        process_exit(1);
    }
    println("prod_panic_hook_registry: PASSED");
}
