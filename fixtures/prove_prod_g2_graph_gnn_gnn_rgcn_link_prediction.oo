// # Product prove std/graph_gnn/gnn_rgcn_link_prediction.oo
//
// Logline: Fail-closed emit+gcc+run asserts rgcn_link_pred_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_rgcn_link_prediction.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rgcn_link_pred_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_rgcn_link_prediction: PASSED only if they match.

import "std/graph_gnn/gnn_rgcn_link_prediction.oo";

pub fn main() {
    let g2_oa: RGCNLinkPredConfig = rgcn_link_pred_config_new(2, 2, 2, 2, 2, 2);
    let g2_ob: RGCNLinkPredConfig = rgcn_link_pred_config_new(2, 2, 2, 2, 2, 2);
    let g2_a = (g2_oa).num_entities;
    let g2_b = (g2_ob).num_entities;
    if g2_a != g2_b {
        println("FAIL rgcn_link_pred_config_new.num_entities");
        process_exit(1);
    }
    println("prod_g2_gnn_rgcn_link_prediction: PASSED");
}
