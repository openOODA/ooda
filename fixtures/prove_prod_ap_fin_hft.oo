// # Product prove std/fin/hft.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_ready is 1.
//
// Setup: Isolated emit-c. Imports std/fin/hft.oo.
//
// Beats:
//   1. hft_ready() is 1.
//   2. Exit 1 on miss. Print prod_ap_hft: PASSED only if it holds.

import "std/fin/hft.oo";

pub fn main() {
    let hft_a = hft_ready();
    if hft_a != 1 {
        println("FAIL hft");
        process_exit(1);
    }
    println("prod_ap_hft: PASSED");
}
