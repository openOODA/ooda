// # Product prove std/cloud/raft_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud/raft_state.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/raft_state.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_raft_state: PASSED only if they match.

import "std/cloud/raft_state.oo";

pub fn main() {
    let raft_state_a = raft_state_new("x", 0);
    let raft_state_b = raft_state_new("x", 0);
    let raft_state_va = raft_state_is_leader(raft_state_a);
    let raft_state_vb = raft_state_is_leader(raft_state_b);
    if raft_state_va != raft_state_vb {
        println("FAIL raft_state");
        process_exit(1);
    }
    println("prod_ap_raft_state: PASSED");
}
