// # Product prove std/gui/core.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gui/core.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/core.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_core: PASSED only if they match.

import "std/gui/core.oo";

pub fn main() {
    let core_a = gui_context_new(0, 0);
    let core_b = gui_context_new(0, 0);
    let core_va = gui_context_get_focus(core_a);
    let core_vb = gui_context_get_focus(core_b);
    if core_va != core_vb {
        println("FAIL core");
        process_exit(1);
    }
    println("prod_ap_core: PASSED");
}
