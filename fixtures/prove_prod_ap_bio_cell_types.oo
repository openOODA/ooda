// # Product prove std/bio/cell_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/cell_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cell_types: PASSED only if they match.

import "std/bio/cell_types.oo";

pub fn main() {
    let cell_types_a = cell_pop_new(0);
    let cell_types_b = cell_pop_new(0);
    let cell_types_va = cell_pop_current(cell_types_a);
    let cell_types_vb = cell_pop_current(cell_types_b);
    if cell_types_va != cell_types_vb {
        println("FAIL cell_types");
        process_exit(1);
    }
    println("prod_ap_cell_types: PASSED");
}
