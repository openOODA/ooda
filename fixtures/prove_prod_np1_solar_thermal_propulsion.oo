// # Product prove std/space_propulsion/solar_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_thermal_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_thermal_propulsion.oo.
//
// Beats:
//   1. Call solar_thermal_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_thermal_propulsion: PASSED only if they match.

import "std/space_propulsion/solar_thermal_propulsion.oo";

pub fn main() {
    let solar_thermal_propulsion_mark: Int = 0;
    if solar_thermal_propulsion_mark != 0 {
        process_exit(1);
    }
    let solar_thermal_propulsion_a = solar_thermal_compute_performance(solar_thermal_spec_default(), 1.0);
    let solar_thermal_propulsion_b = solar_thermal_compute_performance(solar_thermal_spec_default(), 1.0);
    if (solar_thermal_propulsion_a).concentrated_solar_power_kw != (solar_thermal_propulsion_b).concentrated_solar_power_kw {
        println("FAIL solar_thermal_compute_performance");
        process_exit(1);
    }
    println("prod_solar_thermal_propulsion: PASSED");
}
