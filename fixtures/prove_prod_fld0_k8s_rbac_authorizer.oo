// # Product prove std/cloud_k8s/k8s_rbac_authorizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rbac_authorize is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/k8s_rbac_authorizer.oo.
//
// Beats:
//   1. Call rbac_authorize twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_k8s_rbac_authorizer: PASSED only if they match.

import "std/cloud_k8s/k8s_rbac_authorizer.oo";

pub fn main() {
    let k8s_rbac_authorizer_mark: Int = 0;
    if k8s_rbac_authorizer_mark != 0 {
        process_exit(1);
    }
    let k8s_rbac_authorizer_obj: RbacAuthorizer = rbac_authorizer_new();
    let k8s_rbac_authorizer_a: Bool = rbac_authorize(&k8s_rbac_authorizer_obj, "x", "x", "x");
    let k8s_rbac_authorizer_b: Bool = rbac_authorize(&k8s_rbac_authorizer_obj, "x", "x", "x");
    if k8s_rbac_authorizer_a != k8s_rbac_authorizer_b {
        println("FAIL rbac_authorize");
        process_exit(1);
    }
    println("prod_k8s_rbac_authorizer: PASSED");
}
