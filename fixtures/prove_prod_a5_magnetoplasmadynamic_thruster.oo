// # Product prove std/space_propulsion/magnetoplasmadynamic_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpd_thruster_spec_default_argon is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/magnetoplasmadynamic_thruster.oo.
//
// Beats:
//   1. Call mpd_thruster_spec_default_argon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_magnetoplasmadynamic_thruster: PASSED only if they match.

import "std/space_propulsion/magnetoplasmadynamic_thruster.oo";

pub fn main() {
    let magnetoplasmadynamic_thruster_mark: Int = 0;
    if magnetoplasmadynamic_thruster_mark != 0 {
        process_exit(1);
    }
    let a: MpdThrusterSpec = mpd_thruster_spec_default_argon();
    let b: MpdThrusterSpec = mpd_thruster_spec_default_argon();
    if (a).anode_radius_m != (b).anode_radius_m {
        println("FAIL mpd_thruster_spec_default_argon");
        process_exit(1);
    }
    println("prod_magnetoplasmadynamic_thruster: PASSED");
}
