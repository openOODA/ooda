// # Product prove std/3d/lights_spot.oo
//
// Logline: Fail-closed emit+gcc+run asserts spot_light_set_position is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights_spot.oo.
//
// Beats:
//   1. Call spot_light_set_position twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g4_3d_lights_spot: PASSED only if they match.

import "std/3d/lights_spot.oo";

pub fn main() {
    let s0: SpotLight = spot_light_default();
    let g0_oa: SpotLight = spot_light_set_position(s0, 10, 20, 30);
    let g0_ob: SpotLight = spot_light_set_position(s0, 10, 20, 30);
    let g0_a: Int = spot_light_pos_sum(g0_oa);
    let g0_b: Int = spot_light_pos_sum(g0_ob);
    if g0_a != g0_b {
        println("FAIL spot_light_set_position");
        process_exit(1);
    }
    println("prod_g4_3d_lights_spot: PASSED");
}
