// # Product prove std/quantum_open_systems/quantum_heterodyne_detection.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_heterodyne_detection.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_heterodyne_detection.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_quantum_heterodyne_detection: PASSED only if they match.

import "std/quantum_open_systems/quantum_heterodyne_detection.oo";

pub fn main() {
    let quantum_heterodyne_detection_a = heterodyne_detector_new(0.0, 0.0);
    let quantum_heterodyne_detection_b = heterodyne_detector_new(0.0, 0.0);
    if quantum_heterodyne_detection_a.efficiency_eta != quantum_heterodyne_detection_b.efficiency_eta {
        println("FAIL quantum_heterodyne_detection");
        process_exit(1);
    }
    println("prod_ap_quantum_heterodyne_detection: PASSED");
}
