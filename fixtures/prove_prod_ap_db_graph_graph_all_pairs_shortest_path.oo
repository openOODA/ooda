// # Product prove std/db_graph/graph_all_pairs_shortest_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_all_pairs_shortest_path.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_all_pairs_shortest_path.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_all_pairs_shortest_path: PASSED only if they match.

import "std/db_graph/graph_all_pairs_shortest_path.oo";

pub fn main() {
    let graph_all_pairs_shortest_path_a = apsp_matrix_new(0);
    let graph_all_pairs_shortest_path_b = apsp_matrix_new(0);
    let graph_all_pairs_shortest_path_va = apsp_matrix_get(graph_all_pairs_shortest_path_a, 0, 0);
    let graph_all_pairs_shortest_path_vb = apsp_matrix_get(graph_all_pairs_shortest_path_b, 0, 0);
    if graph_all_pairs_shortest_path_va != graph_all_pairs_shortest_path_vb {
        println("FAIL graph_all_pairs_shortest_path");
        process_exit(1);
    }
    println("prod_ap_graph_all_pairs_shortest_path: PASSED");
}
