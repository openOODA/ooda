// # Fail the second simple requires
//
// Logline: A second simple requires clause fails at runtime when b is negative.
//
// Beats:
//   1. Require both arguments non-negative.
//   2. Call both_pos with a negative second argument.
//   3. Trip the runtime contract rail.

// M51 fail-at-runtime: second simple requires violated
pub fn both_pos(a: Int, b: Int) -> Int
    requires a >= 0
    requires b >= 0
{
    return a + b;
}

pub fn main() {
    println(both_pos(1, 0 - 2));
}
