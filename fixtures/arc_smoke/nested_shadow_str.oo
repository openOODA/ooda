// # Smoke shadowed string frames
//
// Logline: An inner same-name string must release only the shadow.
//
// Setup: M2 nested same-name String; outer must survive.
//
// Beats:
//   1. Bind x to "outer".
//   2. Shadow x as "inner" and print it.
//   3. Print the outer x after the block.

pub fn main() {
    let x = "outer";
    {
        let x = "inner";
        println(x);
    }
    println(x);
}
