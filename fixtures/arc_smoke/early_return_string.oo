// # Smoke early String return
//
// Logline: Returning a live String while sibling locals remain must not double-free.
//
// Setup: make concatenates or returns b; main prints via oo_print_str.
//
// Beats:
//   1. Bind two String locals.
//   2. Return a + b when x > 0 else b.
//   3. Print both make(1) and make(0).

fn make(x: Int) -> String {
    let a: String = "a";
    let b: String = "b";
    if x > 0 {
        return a + b;
    }
    return b;
}
pub fn main(sys: &SysCap) {
    // Bare String-returning calls → oo_print_str via __fr__ map (c_expr_is_str_env).
    println(make(1));
    println(make(0));
}
