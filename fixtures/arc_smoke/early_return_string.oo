// ARC smoke: early return with live String locals
fn make(x: Int) -> String {
    let a: String = "a";
    let b: String = "b";
    if x > 0 {
        return a + b;
    }
    return b;
}
pub fn main(sys: &SysCap) {
    // Bare String-returning calls → oo_print_str via __fr__ map (c_expr_is_str_env).
    println(make(1));
    println(make(0));
}
