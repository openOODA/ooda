// ARC smoke: early return with live String locals
fn make(x: Int) -> String {
    let a: String = "a";
    let b: String = "b";
    if x > 0 {
        return a + b;
    }
    return b;
}
pub fn main(sys: &SysCap) {
    // Bind to typed locals so emit uses oo_print_str (call-result typing residual).
    let s1: String = make(1);
    let s0: String = make(0);
    println(s1);
    println(s0);
}
