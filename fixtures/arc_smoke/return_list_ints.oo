// M2: return list of ints
fn make_list(x: Int) -> List[Int] {
    let mut lst: List[Int] = list_new();
    lst = list_push(lst, 10);
    lst = list_push(lst, 20);
    if x > 0 {
        return lst;
    }
    let mut lst2: List[Int] = list_new();
    lst2 = list_push(lst2, 30);
    return lst2;
}

pub fn main() {
    let l1: List[Int] = make_list(1);
    let l0: List[Int] = make_list(0);
    println(list_get(l1, 0));
    println(list_get(l1, 1));
    println(list_get(l0, 0));
}
