// # Smoke string list ARC
//
// Logline: Push two strings, get both, and release the list without leaking.
//
// Setup: M2 leak-safe free on List[String].
//
// Beats:
//   1. list_new a string list.
//   2. Push "a" and "b".
//   3. Get and print both slots.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    let s = list_get(xs, 0);
    let t = list_get(xs, 1);
    println(s);
    println(t);
}
