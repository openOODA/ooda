// # Smoke string concat reassign
//
// Logline: s = s + t must not double-free the old string.
//
// Setup: ARC smoke; two concatenating stores.
//
// Beats:
//   1. Bind mut s and t.
//   2. Store s = s + t then s = s + "!".
//   3. Print the result.

pub fn main(sys: &SysCap) {
    let mut s: String = "hello";
    let t: String = " world";
    s = s + t;
    s = s + "!";
    println(s);
}
