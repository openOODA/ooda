// # Product prove std/astro_advanced/stage_separation_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/stage_separation_dynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/stage_separation_dynamics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stage_separation_dynamics: PASSED only if they match.

import "std/astro_advanced/stage_separation_dynamics.oo";

pub fn main() {
    let stage_separation_dynamics_a = sep_delta_v();
    let stage_separation_dynamics_b = sep_delta_v();
    if stage_separation_dynamics_a != stage_separation_dynamics_b {
        println("FAIL stage_separation_dynamics");
        process_exit(1);
    }
    println("prod_ap_stage_separation_dynamics: PASSED");
}
