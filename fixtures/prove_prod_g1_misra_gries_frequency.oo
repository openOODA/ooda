// # Product prove std/graph_networks/misra_gries_frequency.oo
//
// Logline: Fail-closed emit+gcc+run asserts misra_gries_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/misra_gries_frequency.oo.
//
// Beats:
//   1. Call misra_gries_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_misra_gries_frequency: PASSED only if they match.

import "std/graph_networks/misra_gries_frequency.oo";

pub fn main() {
    let a: MisraGriesSketch = misra_gries_create(0);
    let b: MisraGriesSketch = misra_gries_create(0);
    if a.k_factor != b.k_factor {
        println("FAIL misra_gries_create");
        process_exit(1);
    }
    println("prod_misra_gries_frequency: PASSED");
}
