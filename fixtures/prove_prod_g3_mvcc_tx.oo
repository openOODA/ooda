// # Product prove std/database/mvcc_tx.oo
//
// Logline: Fail-closed emit+gcc+run asserts tx_snapshot_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/mvcc_tx.oo.
//
// Beats:
//   1. Call tx_snapshot_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_tx: PASSED only if they match.

import "std/database/mvcc_tx.oo";

pub fn main() {
    let mvcc_tx_mark: Int = 0;
    if mvcc_tx_mark != 0 {
        process_exit(1);
    }
    let a: TxSnapshot = tx_snapshot_create(0, list_new(), 0, 0);
    let b: TxSnapshot = tx_snapshot_create(0, list_new(), 0, 0);
    if (a).snapshot_tx_id != (b).snapshot_tx_id {
        println("FAIL tx_snapshot_create");
        process_exit(1);
    }
    println("prod_mvcc_tx: PASSED");
}
