// # Product prove std/sync/leaky_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/leaky_bucket.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/leaky_bucket.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_leaky_bucket: PASSED only if they match.

import "std/sync/leaky_bucket.oo";

pub fn main() {
    let leaky_bucket_a = leaky_bucket_new(0, 0);
    let leaky_bucket_b = leaky_bucket_new(0, 0);
    if leaky_bucket_a.capacity != leaky_bucket_b.capacity {
        println("FAIL leaky_bucket");
        process_exit(1);
    }
    println("prod_ap_leaky_bucket: PASSED");
}
