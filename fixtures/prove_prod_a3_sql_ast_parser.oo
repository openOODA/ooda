// # Product prove std/db_storage/sql_ast_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_predicate_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_ast_parser.oo.
//
// Beats:
//   1. Call sql_predicate_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_ast_parser: PASSED only if they match.

import "std/db_storage/sql_ast_parser.oo";

pub fn main() {
    let sql_ast_parser_mark: Int = 0;
    if sql_ast_parser_mark != 0 {
        process_exit(1);
    }
    let a: SqlBinaryPredicate = sql_predicate_new("x", "x", "x");
    let b: SqlBinaryPredicate = sql_predicate_new("x", "x", "x");
    let sa: String = (a).column_name;
    let sb: String = (b).column_name;
    if sa != sb {
        println("FAIL sql_predicate_new");
        process_exit(1);
    }
    println("prod_sql_ast_parser: PASSED");
}
