// # Product sync seqlock prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/seqlock.oo.
//
// Setup: Product std/sync/seqlock.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New sequence 0 validates.
//   2. Odd start seq fails validate.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/seqlock.oo";

pub fn main() {
    let l: SeqLock = seqlock_new();
    let s: Int = seqlock_read_begin(l);
    if s != 0 {
        println("FAIL seq begin");
        process_exit(1);
    }
    if seqlock_read_validate(l, 0) == false {
        println("FAIL seq valid 0");
        process_exit(1);
    }
    if seqlock_read_validate(l, 1) {
        println("FAIL seq odd");
        process_exit(1);
    }
    println("prod_seqlock: PASSED");
}
