// # Product prove std/security_defense/string_literal_encryptor.oo
//
// Logline: Fail-closed emit+gcc+run asserts string_payload_verify is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/string_literal_encryptor.oo.
//
// Beats:
//   1. Call string_payload_verify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_string_literal_encryptor: PASSED only if they match.

import "std/security_defense/string_literal_encryptor.oo";

pub fn main() {
    let string_literal_encryptor_mark: Int = 0;
    if string_literal_encryptor_mark != 0 {
        process_exit(1);
    }
    let string_literal_encryptor_obj: EncryptedStringPayload = string_encrypt_bytes(list_new(), 0, 1);
    let string_literal_encryptor_a: Bool = string_payload_verify(&string_literal_encryptor_obj);
    let string_literal_encryptor_b: Bool = string_payload_verify(&string_literal_encryptor_obj);
    if string_literal_encryptor_a != string_literal_encryptor_b {
        println("FAIL string_payload_verify");
        process_exit(1);
    }
    println("prod_string_literal_encryptor: PASSED");
}
