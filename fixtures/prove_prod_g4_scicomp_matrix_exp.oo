// # Product prove std/scicomp/matrix_exponential.oo
//
// Logline: Fail-closed verification that matrix exponential scaling/squaring and dense matrix operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/matrix_exponential.oo.
//
// Beats:
//   1. Construct identity matrix and evaluate 1-norm.
//   2. Perform dense matrix scaling and addition.
//   3. Compute matrix exponential via scaling and squaring and assert e^0 = I.
//   4. Print prod_g4_scicomp_matrix_exp: PASSED and exit 0.

import "std/scicomp/matrix_exponential.oo";

pub fn main() {
    let id1: DenseMatrix = dense_mat_identity(2);
    let id2: DenseMatrix = dense_mat_identity(2);

    let norm1: Float = dense_mat_norm_1(&id1);
    let norm2: Float = dense_mat_norm_1(&id2);
    if norm1 != norm2 || norm1 < 0.999 || norm1 > 1.001 {
        println("FAIL dense_mat_norm_1");
        process_exit(1);
    }

    let scaled: DenseMatrix = dense_mat_scale(&id1, 2.0);
    let sum_mat: DenseMatrix = dense_mat_add(&id1, &scaled);
    let d00: Float = dense_mat_get(&sum_mat, 0, 0);
    let d11: Float = dense_mat_get(&sum_mat, 1, 1);
    if d00 < 2.999 || d00 > 3.001 || d11 < 2.999 || d11 > 3.001 {
        println("FAIL dense_mat_add / dense_mat_scale");
        process_exit(1);
    }

    let zero_mat: DenseMatrix = dense_mat_new(2, 2);
    let exp_z1: DenseMatrix = matrix_exp_scale_square(&zero_mat);
    let exp_z2: DenseMatrix = matrix_exp_scale_square(&zero_mat);

    let e00: Float = dense_mat_get(&exp_z1, 0, 0);
    let e01: Float = dense_mat_get(&exp_z1, 0, 1);
    let e11: Float = dense_mat_get(&exp_z1, 1, 1);

    if e00 != dense_mat_get(&exp_z2, 0, 0) || e00 < 0.999 || e00 > 1.001 {
        println("FAIL matrix_exp_scale_square e00");
        process_exit(1);
    }
    if e11 < 0.999 || e11 > 1.001 || e01 < (0.0 - 0.001) || e01 > 0.001 {
        println("FAIL matrix_exp_scale_square off-diag");
        process_exit(1);
    }

    println("prod_g4_scicomp_matrix_exp: PASSED");
    process_exit(0);
}
