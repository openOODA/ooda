// # Product prove std/defi_derivatives/liquidation_debt_cascade.oo
//
// Logline: Fail-closed emit+gcc+run asserts calc_unrealized_pnl is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/liquidation_debt_cascade.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call calc_unrealized_pnl twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_liquidation_debt_cascade: PASSED only if they match.

import "std/defi_derivatives/liquidation_debt_cascade.oo";

pub fn main() {
    let g2_a = calc_unrealized_pnl(1.0, 1.0, 1.0);
    let g2_b = calc_unrealized_pnl(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL calc_unrealized_pnl");
        process_exit(1);
    }
    println("prod_g2_liquidation_debt_cascade: PASSED");
}
