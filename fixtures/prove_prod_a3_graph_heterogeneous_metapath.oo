// # Product prove std/graph_gnn/graph_heterogeneous_metapath.oo
//
// Logline: Fail-closed emit+gcc+run asserts hetero_graph_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_heterogeneous_metapath.oo.
//
// Beats:
//   1. Call hetero_graph_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_heterogeneous_metapath: PASSED only if they match.

import "std/graph_gnn/graph_heterogeneous_metapath.oo";

pub fn main() {
    let graph_heterogeneous_metapath_mark: Int = 0;
    if graph_heterogeneous_metapath_mark != 0 {
        process_exit(1);
    }
    let a: HeteroGraph = hetero_graph_new(0);
    let b: HeteroGraph = hetero_graph_new(0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL hetero_graph_new");
        process_exit(1);
    }
    println("prod_graph_heterogeneous_metapath: PASSED");
}
