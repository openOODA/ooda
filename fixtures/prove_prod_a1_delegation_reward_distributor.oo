// # Product prove std/bft_consensus/delegation_reward_distributor.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_delegator_share is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/delegation_reward_distributor.oo.
//
// Beats:
//   1. Call compute_delegator_share twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_delegation_reward_distributor: PASSED only if they match.

import "std/bft_consensus/delegation_reward_distributor.oo";

pub fn main() {
    let delegation_reward_distributor_mark: Int = 0;
    if delegation_reward_distributor_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_delegator_share(0, 0, 0);
    let b: Int = compute_delegator_share(0, 0, 0);
    if a != b {
        println("FAIL compute_delegator_share");
        process_exit(1);
    }
    println("prod_delegation_reward_distributor: PASSED");
}
