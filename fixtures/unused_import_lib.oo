// # Unused-import probe lib
//
// Logline: One pub fn so a used import can call it.
//
// Setup: Tiny sibling. Stem unused_import_lib matches unused_import_lib_hi.
//
// Beats:
//   1. Export unused_import_lib_hi.
//   2. Print hi.
//   3. Stay one function.

pub fn unused_import_lib_hi() {
    println("hi");
}
