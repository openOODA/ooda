// # Pass AND of simple contracts
//
// Logline: Multiple simple requires and ensures all hold and the sum prints.
//
// Beats:
//   1. Require both arguments non-negative.
//   2. Ensure the result is non-negative and at least a.
//   3. Add 1 and 2 so every clause holds.

// M51 pass: AND of multiple simple requires + ensures at runtime
pub fn both_nonneg(a: Int, b: Int) -> Int
    requires a >= 0
    requires b >= 0
    ensures result >= 0
    ensures result >= a
{
    return a + b;
}

pub fn main() {
    println(both_nonneg(1, 2));
}
