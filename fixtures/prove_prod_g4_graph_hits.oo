// # Product prove std/graph_gnn/graph_hits_authority_hub.oo
//
// Logline: Fail-closed verification that HITS authority and hub score updates are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_hits_authority_hub.oo.
//
// Beats:
//   1. Construct HITSConfig and initialize graph adjacency structures.
//   2. Run hits_update_step and hits_hub_update_step on sample graph.
//   3. Assert deterministic return values.
//   4. Print prod_g4_graph_hits: PASSED only if all match.

import "std/graph_gnn/graph_hits_authority_hub.oo";

pub fn main() {
    let cfg1: HITSConfig = hits_config_new(3, 20, 1);
    let cfg2: HITSConfig = hits_config_new(3, 20, 1);
    if cfg1.num_nodes != cfg2.num_nodes {
        println("FAIL hits_config_new num_nodes");
        process_exit(1);
    }
    if cfg1.max_iterations != cfg2.max_iterations {
        println("FAIL hits_config_new max_iterations");
        process_exit(1);
    }
    if cfg1.tolerance_milli != cfg2.tolerance_milli {
        println("FAIL hits_config_new tolerance_milli");
        process_exit(1);
    }

    let mut hubs1: List[Int] = list_new();
    hubs1 = list_push(hubs1, 100);
    hubs1 = list_push(hubs1, 100);
    hubs1 = list_push(hubs1, 100);

    let mut hubs2: List[Int] = list_new();
    hubs2 = list_push(hubs2, 100);
    hubs2 = list_push(hubs2, 100);
    hubs2 = list_push(hubs2, 100);

    // Node 0 has in-neighbor 1; Node 1 has in-neighbor 2; Node 2 has in-neighbors 0, 1
    let mut in_neighs1: List[Int] = list_new();
    in_neighs1 = list_push(in_neighs1, 1);
    in_neighs1 = list_push(in_neighs1, 2);
    in_neighs1 = list_push(in_neighs1, 0);
    in_neighs1 = list_push(in_neighs1, 1);

    let mut in_offs1: List[Int] = list_new();
    in_offs1 = list_push(in_offs1, 0);
    in_offs1 = list_push(in_offs1, 1);
    in_offs1 = list_push(in_offs1, 2);
    in_offs1 = list_push(in_offs1, 4);

    let mut in_neighs2: List[Int] = list_new();
    in_neighs2 = list_push(in_neighs2, 1);
    in_neighs2 = list_push(in_neighs2, 2);
    in_neighs2 = list_push(in_neighs2, 0);
    in_neighs2 = list_push(in_neighs2, 1);

    let mut in_offs2: List[Int] = list_new();
    in_offs2 = list_push(in_offs2, 0);
    in_offs2 = list_push(in_offs2, 1);
    in_offs2 = list_push(in_offs2, 2);
    in_offs2 = list_push(in_offs2, 4);

    let auth1: List[Int] = hits_update_step(3, hubs1, in_neighs1, in_offs1);
    let auth2: List[Int] = hits_update_step(3, hubs2, in_neighs2, in_offs2);

    let len_a1: Int = list_len(auth1);
    let len_a2: Int = list_len(auth2);
    if len_a1 != len_a2 {
        println("FAIL hits_update_step length mismatch");
        process_exit(1);
    }
    if len_a1 != 3 {
        println("FAIL hits_update_step length expected");
        process_exit(1);
    }

    let a0_1: Int = list_get(auth1, 0);
    let a0_2: Int = list_get(auth2, 0);
    if a0_1 != a0_2 {
        println("FAIL hits auth 0");
        process_exit(1);
    }

    let a2_1: Int = list_get(auth1, 2);
    let a2_2: Int = list_get(auth2, 2);
    if a2_1 != a2_2 {
        println("FAIL hits auth 2");
        process_exit(1);
    }

    println("prod_g4_graph_hits: PASSED");
    process_exit(0);
}
