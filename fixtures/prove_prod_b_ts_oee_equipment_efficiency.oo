// # Product prove std/industrial_predictive/ts_oee_equipment_efficiency.oo
//
// Logline: Fail-closed emit+gcc+run asserts ts_oee_equipment_efficiency_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_oee_equipment_efficiency.oo.
//
// Beats:
//   1. Call ts_oee_equipment_efficiency_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_oee_equipment_efficiency: PASSED only if they match.

import "std/industrial_predictive/ts_oee_equipment_efficiency.oo";

pub fn main() {
    let a = ts_oee_equipment_efficiency_probe();
    let b = ts_oee_equipment_efficiency_probe();
    if a != b {
        println("FAIL ts_oee_equipment_efficiency_probe");
        process_exit(1);
    }
    println("prod_ts_oee_equipment_efficiency: PASSED");
}
