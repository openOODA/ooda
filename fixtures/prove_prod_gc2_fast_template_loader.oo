// # Product prove std/fintech_defi/fast_template_loader.oo
//
// Logline: Fail-closed emit+gcc+run asserts fast_template_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/fast_template_loader.oo.
//
// Beats:
//   1. Call fast_template_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fast_template_loader: PASSED only if they match.

import "std/fintech_defi/fast_template_loader.oo";

pub fn main() {
    let fast_template_loader_mark: Int = 0;
    if fast_template_loader_mark != 0 {
        process_exit(1);
    }
    let fast_template_loader_a = fast_template_new(1, "x");
    let fast_template_loader_b = fast_template_new(1, "x");
    if (fast_template_loader_a).template_id != (fast_template_loader_b).template_id {
        println("FAIL fast_template_new");
        process_exit(1);
    }
    println("prod_fast_template_loader: PASSED");
}
