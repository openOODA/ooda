// # Product prove std/media_dsp/ogg_page_bitstream.oo
//
// Logline: Fail-closed emit+gcc+run asserts ogg_flag_continued is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/ogg_page_bitstream.oo.
//
// Beats:
//   1. Call ogg_flag_continued twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ogg_page_bitstream: PASSED only if they match.

import "std/media_dsp/ogg_page_bitstream.oo";

pub fn main() {
    let ogg_page_bitstream_mark: Int = 0;
    if ogg_page_bitstream_mark != 0 {
        process_exit(1);
    }
    let a: Int = ogg_flag_continued();
    let b: Int = ogg_flag_continued();
    if a != b {
        println("FAIL ogg_flag_continued");
        process_exit(1);
    }
    println("prod_ogg_page_bitstream: PASSED");
}
