// # Product prove std/quantum_tensor_nets/chebyshev_mps_expansion.oo
//
// Logline: Fail-closed emit+gcc+run asserts jackson_kernel_damping is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/chebyshev_mps_expansion.oo.
//
// Beats:
//   1. Call jackson_kernel_damping twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_chebyshev_mps_expansion: PASSED only if they match.

import "std/quantum_tensor_nets/chebyshev_mps_expansion.oo";

pub fn main() {
    let chebyshev_mps_expansion_mark: Int = 0;
    if chebyshev_mps_expansion_mark != 0 {
        process_exit(1);
    }
    let a: Float = jackson_kernel_damping(0, 0);
    let b: Float = jackson_kernel_damping(0, 0);
    if a != b {
        println("FAIL jackson_kernel_damping");
        process_exit(1);
    }
    println("prod_g2_chebyshev_mps_expansion: PASSED");
}
