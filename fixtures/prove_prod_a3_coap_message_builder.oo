// # Product prove std/iot_scada/coap_message_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts coap_code_get is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/coap_message_builder.oo.
//
// Beats:
//   1. Call coap_code_get twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_coap_message_builder: PASSED only if they match.

import "std/iot_scada/coap_message_builder.oo";

pub fn main() {
    let coap_message_builder_mark: Int = 0;
    if coap_message_builder_mark != 0 {
        process_exit(1);
    }
    let a: Int = coap_code_get();
    let b: Int = coap_code_get();
    if a != b {
        println("FAIL coap_code_get");
        process_exit(1);
    }
    println("prod_coap_message_builder: PASSED");
}
