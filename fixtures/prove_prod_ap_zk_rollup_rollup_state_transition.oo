// # Product prove std/zk_rollup/rollup_state_transition.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_state_transition.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_state_transition.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_state_transition: PASSED only if they match.

import "std/zk_rollup/rollup_state_transition.oo";

pub fn main() {
    let rollup_state_transition_a = rollup_tx_new(0, 0, 0, 0, 0);
    let rollup_state_transition_b = rollup_tx_new(0, 0, 0, 0, 0);
    if rollup_state_transition_a.sender_account != rollup_state_transition_b.sender_account {
        println("FAIL rollup_state_transition");
        process_exit(1);
    }
    println("prod_ap_rollup_state_transition: PASSED");
}
