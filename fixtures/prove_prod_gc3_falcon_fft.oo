// # Product prove std/crypto_advanced/falcon_fft.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_fft_tree_leaf is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/falcon_fft.oo.
//
// Beats:
//   1. Call falcon_fft_tree_leaf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_fft: PASSED only if they match.

import "std/crypto_advanced/falcon_fft.oo";

pub fn main() {
    let falcon_fft_mark: Int = 0;
    if falcon_fft_mark != 0 {
        process_exit(1);
    }
    let falcon_fft_a = falcon_fft_tree_leaf(1);
    let falcon_fft_b = falcon_fft_tree_leaf(1);
    if (falcon_fft_a).depth != (falcon_fft_b).depth {
        println("FAIL falcon_fft_tree_leaf");
        process_exit(1);
    }
    println("prod_falcon_fft: PASSED");
}
