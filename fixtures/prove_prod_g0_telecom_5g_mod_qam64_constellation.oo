// # Product prove std/telecom_5g/mod_qam64_constellation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mod_qam64_pam8_map is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_qam64_constellation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mod_qam64_pam8_map twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_mod_qam64_constellation: PASSED only if they match.

import "std/telecom_5g/mod_qam64_constellation.oo";

pub fn main() {
    let g0_a = mod_qam64_pam8_map(2);
    let g0_b = mod_qam64_pam8_map(2);
    if g0_a != g0_b {
        println("FAIL mod_qam64_pam8_map");
        process_exit(1);
    }
    println("prod_g0_mod_qam64_constellation: PASSED");
}
