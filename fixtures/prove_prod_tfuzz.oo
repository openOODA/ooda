// # Product test fuzz boundaries prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/test/fuzz.oo.
//
// Setup: Product std/test/fuzz.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. boundary_int 0/1/2/3.
//   2. boundary_string 0 and 2.
//   3. int_range max<=min returns min.
//   9. Exit 1 before PASSED on a miss.

import "std/test/fuzz.oo";

pub fn main() {
    let z: Int = fuzz_boundary_int(0);
    if z != 0 {
        println("FAIL fuzz 0");
        process_exit(1);
    }
    let o: Int = fuzz_boundary_int(1);
    if o != 1 {
        println("FAIL fuzz 1");
        process_exit(1);
    }
    let n: Int = fuzz_boundary_int(2);
    if n != -1 {
        println("FAIL fuzz -1");
        process_exit(1);
    }
    let mx: Int = fuzz_boundary_int(3);
    if mx != 2147483647 {
        println("FAIL fuzz i32max");
        process_exit(1);
    }
    let s0: String = fuzz_boundary_string(0);
    if s0 != "" {
        println("FAIL fuzz str empty");
        process_exit(1);
    }
    let s2: String = fuzz_boundary_string(2);
    if s2 != "a" {
        println("FAIL fuzz str a");
        process_exit(1);
    }
    let r: Int = fuzz_int_range(1, 5, 5);
    if r != 5 {
        println("FAIL fuzz range min");
        process_exit(1);
    }
    println("prod_tfuzz: PASSED");
}
