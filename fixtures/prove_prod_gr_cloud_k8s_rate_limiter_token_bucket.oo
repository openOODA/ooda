// # Product prove std/cloud_k8s/rate_limiter_token_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_bucket_limiter_allow is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/rate_limiter_token_bucket.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call token_bucket_limiter_allow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_rate_limiter_token_bucket: PASSED only if they match.

import "std/cloud_k8s/rate_limiter_token_bucket.oo";

pub fn main() {
    let mut g0_oa: TokenBucketLimiter = TokenBucketLimiter { capacity: 1, refill_rate_per_sec: 0, available_tokens: 0, last_refill_ms: 0, total_permitted: 0, total_throttled: 0 };
    let mut g0_ob: TokenBucketLimiter = TokenBucketLimiter { capacity: 1, refill_rate_per_sec: 0, available_tokens: 0, last_refill_ms: 0, total_permitted: 0, total_throttled: 0 };
    let g0_a = token_bucket_limiter_allow(&g0_oa, 0, 0);
    let g0_b = token_bucket_limiter_allow(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL token_bucket_limiter_allow");
        process_exit(1);
    }
    println("prod_gr_rate_limiter_token_bucket: PASSED");
}
