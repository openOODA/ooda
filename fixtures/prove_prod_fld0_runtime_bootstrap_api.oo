// # Product prove std/cloud_faas/runtime_bootstrap_api.oo
//
// Logline: Fail-closed emit+gcc+run asserts runtime_bootstrap_api_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/runtime_bootstrap_api.oo.
//
// Beats:
//   1. Call runtime_bootstrap_api_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_runtime_bootstrap_api: PASSED only if they match.

import "std/cloud_faas/runtime_bootstrap_api.oo";

pub fn main() {
    let runtime_bootstrap_api_mark: Int = 0;
    if runtime_bootstrap_api_mark != 0 {
        process_exit(1);
    }
    let runtime_bootstrap_api_a: RuntimeBootstrapApi = runtime_bootstrap_api_new("x", 1);
    let runtime_bootstrap_api_b: RuntimeBootstrapApi = runtime_bootstrap_api_new("x", 1);
    if (runtime_bootstrap_api_a).port != (runtime_bootstrap_api_b).port {
        println("FAIL runtime_bootstrap_api_new");
        process_exit(1);
    }
    println("prod_runtime_bootstrap_api: PASSED");
}
