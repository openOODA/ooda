// # Hostile IDENT third println
//
// Logline: Print two strings then IDENT x so emit-wasm must miss a three-string fold.
//
// Setup: One public main. Third print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a, line-b, then x.
//   3. A line-a/line-b/fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println(x);
}
