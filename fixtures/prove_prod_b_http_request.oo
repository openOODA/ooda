// # Product prove std/net/http_request.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_request_parse_method is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http_request.oo.
//
// Beats:
//   1. Call http_request_parse_method twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http_request: PASSED only if they match.

import "std/net/http_request.oo";

pub fn main() {
    let a = http_request_parse_method("x");
    let b = http_request_parse_method("x");
    if a != b {
        println("FAIL http_request_parse_method");
        process_exit(1);
    }
    println("prod_http_request: PASSED");
}
