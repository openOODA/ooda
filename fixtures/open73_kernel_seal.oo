// # Kernel object-cap HMAC seal
//
// Logline: Seal a cap id under SysCap with the process-local kernel HMAC key.
//
// Setup: OPEN-73. oo_cap_kernel_seal requires &SysCap. Not a published magic.
//
// Beats:
//   1. Same cap id seals the same in-process.
//   2. A different id has a different seal.
//   3. Empty id fails closed. Published-string HMAC is not the kernel seal.

pub fn main(sys: &SysCap) {
    let a: String = oo_cap_kernel_seal(sys, "cap:fs:1");
    let b: String = oo_cap_kernel_seal(sys, "cap:fs:1");
    let c: String = oo_cap_kernel_seal(sys, "cap:fs:2");
    if chars_len(a) != 64 {
        println("FAIL seal len");
        process_exit(1);
    }
    if a != b {
        println("FAIL match");
        process_exit(1);
    }
    if a == c {
        println("FAIL distinct");
        process_exit(1);
    }
    let empty: String = oo_cap_kernel_seal(sys, "");
    if chars_len(empty) != 0 {
        println("FAIL empty");
        process_exit(1);
    }
    let published: String = crypto_hmac_sha256_internal("ooda-kernel-objcap", "cap:fs:1");
    if a == published {
        println("FAIL published key");
        process_exit(1);
    }
    println("open73: PASSED");
}
