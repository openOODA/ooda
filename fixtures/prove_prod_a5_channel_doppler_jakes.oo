// # Product prove std/telecom_5g/channel_doppler_jakes.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_doppler_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_doppler_jakes.oo.
//
// Beats:
//   1. Call channel_doppler_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_doppler_jakes: PASSED only if they match.

import "std/telecom_5g/channel_doppler_jakes.oo";

pub fn main() {
    let channel_doppler_jakes_mark: Int = 0;
    if channel_doppler_jakes_mark != 0 {
        process_exit(1);
    }
    let a: Float = channel_doppler_int_to_float(0);
    let b: Float = channel_doppler_int_to_float(0);
    if a != b {
        println("FAIL channel_doppler_int_to_float");
        process_exit(1);
    }
    println("prod_channel_doppler_jakes: PASSED");
}
