// # Product prove std/telecom_5g/mimo_waterfilling_power.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_waterfilling_capacity_bps_hz is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_waterfilling_power.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mimo_waterfilling_capacity_bps_hz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mimo_waterfilling_power: PASSED only if they match.

import "std/telecom_5g/mimo_waterfilling_power.oo";

pub fn main() {
    let g2_oa: MimoWaterfilling2x2 = MimoWaterfilling2x2 { total_power_p: 1.0, water_level_mu: 1.0, power_subchannel_1: 1.0, power_subchannel_2: 1.0, active_subchannels: 2 };
    let g2_ob: MimoWaterfilling2x2 = MimoWaterfilling2x2 { total_power_p: 1.0, water_level_mu: 1.0, power_subchannel_1: 1.0, power_subchannel_2: 1.0, active_subchannels: 2 };
    let g2_a = mimo_waterfilling_capacity_bps_hz(&g2_oa, 1.0, 1.0);
    let g2_b = mimo_waterfilling_capacity_bps_hz(&g2_ob, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL mimo_waterfilling_capacity_bps_hz");
        process_exit(1);
    }
    println("prod_g2_mimo_waterfilling_power: PASSED");
}
