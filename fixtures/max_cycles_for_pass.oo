// # For under cycle budget
//
// Logline: Count a 0..3 for-range under an eight-cycle budget.
//
// Beats:
//   1. Keep the eight-cycle marker.
//   2. For i in 0..3 increment s.
//   3. Print 3.

// M54 MaxCycles path B — range-for under budget
// MAX_CYCLES: 8
pub fn main() {
    let mut s = 0;
    for i in 0..3 {
        s = s + 1;
    }
    println(s);
}
