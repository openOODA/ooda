// # Product prove std/compilers_vm/bytecode_exception_unwinder.oo
//
// Logline: Fail-closed emit+gcc+run asserts exception_handler_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_exception_unwinder.oo.
//
// Beats:
//   1. Call exception_handler_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_exception_unwinder: PASSED only if they match.

import "std/compilers_vm/bytecode_exception_unwinder.oo";

pub fn main() {
    let bytecode_exception_unwinder_mark: Int = 0;
    if bytecode_exception_unwinder_mark != 0 {
        process_exit(1);
    }
    let a: ExceptionHandlerEntry = exception_handler_entry_new(0, 0, 0, 0);
    let b: ExceptionHandlerEntry = exception_handler_entry_new(0, 0, 0, 0);
    if (a).start_pc != (b).start_pc {
        println("FAIL exception_handler_entry_new");
        process_exit(1);
    }
    println("prod_bytecode_exception_unwinder: PASSED");
}
