// # Product prove std/gis_topo/geodesic_great_circle.oo
//
// Logline: Fail-closed emit+gcc+run asserts gc_deg2rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geodesic_great_circle.oo.
//
// Beats:
//   1. Call gc_deg2rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geodesic_great_circle: PASSED only if they match.

import "std/gis_topo/geodesic_great_circle.oo";

pub fn main() {
    let geodesic_great_circle_mark: Int = 0;
    if geodesic_great_circle_mark != 0 {
        process_exit(1);
    }
    let a: Float = gc_deg2rad(0.0);
    let b: Float = gc_deg2rad(0.0);
    if a != b {
        println("FAIL gc_deg2rad");
        process_exit(1);
    }
    println("prod_geodesic_great_circle: PASSED");
}
