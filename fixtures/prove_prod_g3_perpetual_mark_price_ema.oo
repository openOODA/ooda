// # Product prove std/defi_derivatives/perpetual_mark_price_ema.oo
//
// Logline: Fail-closed emit+gcc+run asserts mark_price_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_mark_price_ema.oo.
//
// Beats:
//   1. Call mark_price_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_perpetual_mark_price_ema: PASSED only if they match.

import "std/defi_derivatives/perpetual_mark_price_ema.oo";

pub fn main() {
    let perpetual_mark_price_ema_mark: Int = 0;
    if perpetual_mark_price_ema_mark != 0 {
        process_exit(1);
    }
    let a: MarkPriceEmaConfig = mark_price_config_default();
    let b: MarkPriceEmaConfig = mark_price_config_default();
    if (a).ema_alpha != (b).ema_alpha {
        println("FAIL mark_price_config_default");
        process_exit(1);
    }
    println("prod_perpetual_mark_price_ema: PASSED");
}
