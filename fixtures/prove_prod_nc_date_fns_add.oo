// # Product prove std/web_ecosystem/date_fns_add.oo
//
// Logline: Fail-closed emit+gcc+run asserts date_fns_add_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/date_fns_add.oo.
//
// Beats:
//   1. Call date_fns_add_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_date_fns_add: PASSED only if it matches.

import "std/web_ecosystem/date_fns_add.oo";

pub fn main() {
    let a: Int = date_fns_add_probe();
    if a != 0 {
        println("FAIL date_fns_add_probe");
        process_exit(1);
    }
    println("prod_nc_date_fns_add: PASSED");
}
