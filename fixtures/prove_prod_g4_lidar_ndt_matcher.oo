// # Product prove std/lidar_perception/ndt_scan_matcher_3d.oo
//
// Logline: Fail-closed verification that 3D NDT scan matcher data structures and likelihood evaluation are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/ndt_scan_matcher_3d.oo.
//
// Beats:
//   1. Construct default NDT configurations and assert deterministic parameters.
//   2. Create uninitialized and initialized NDT voxels and evaluate point likelihood scores.
//   3. Assert deterministic scores across identical inputs.
//   4. Print prod_g4_lidar_ndt_matcher: PASSED and exit 0.

import "std/lidar_perception/ndt_scan_matcher_3d.oo";

pub fn main() {
    let cfg1: NDTConfig = ndt_config_default();
    let cfg2: NDTConfig = ndt_config_default();
    if (cfg1).voxel_resolution != (cfg2).voxel_resolution || (cfg1).max_iterations != 35 {
        println("FAIL ndt_config_default");
        process_exit(1);
    }
    if (cfg1).step_size != (cfg2).step_size || (cfg1).outlier_ratio != 0.55 {
        println("FAIL ndt_config_default fields");
        process_exit(1);
    }

    let v1: NDTVoxel = ndt_voxel_new();
    let v2: NDTVoxel = ndt_voxel_new();
    if (v1).point_count != (v2).point_count || (v1).is_initialized != false {
        println("FAIL ndt_voxel_new");
        process_exit(1);
    }

    let pt: Point3D = point3d_new(0.0, 0.0, 0.0);
    let l1: Float = ndt_eval_point_likelihood(&pt, &v1);
    let l2: Float = ndt_eval_point_likelihood(&pt, &v2);
    if l1 != l2 || l1 != 0.0 {
        println("FAIL ndt_eval_point_likelihood uninit");
        process_exit(1);
    }

    let v_init: NDTVoxel = NDTVoxel {
        mean_x: 0.0,
        mean_y: 0.0,
        mean_z: 0.0,
        c00: 0.1,
        c01: 0.0,
        c02: 0.0,
        c11: 0.1,
        c12: 0.0,
        c22: 0.1,
        point_count: 5,
        is_initialized: true,
    };
    let score1: Float = ndt_eval_point_likelihood(&pt, &v_init);
    let score2: Float = ndt_eval_point_likelihood(&pt, &v_init);
    if score1 != score2 || score1 <= 0.0 {
        println("FAIL ndt_eval_point_likelihood initialized");
        process_exit(1);
    }

    println("prod_g4_lidar_ndt_matcher: PASSED");
    process_exit(0);
}
