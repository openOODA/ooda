// # Product prove std/robot/slam_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts abs_val is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/slam_ops.oo.
//
// Beats:
//   1. Call abs_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_slam_ops: PASSED only if they match.

import "std/robot/slam_ops.oo";

pub fn main() {
    let slam_ops_mark: Int = 0;
    if slam_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = abs_val(0);
    let b: Int = abs_val(0);
    if a != b {
        println("FAIL abs_val");
        process_exit(1);
    }
    println("prod_g2_slam_ops: PASSED");
}
