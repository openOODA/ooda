// # List[Node] pool must not hang
//
// Logline: Three-node pool of flat Node must emit+run under 20s.
//
// Setup: Isolated emit-c. Int+String fields. Index-linked pool, no destub.
//
// Beats:
//   1. Push three nodes; length is 3.
//   2. Get middle node id and tag.
//   3. Print PASSED.

type Node = struct {
    id: Int,
    tag: String,
    next: Int
};

pub fn main() {
    let mut pool: List[Node] = list_new();
    let a: Node = Node { id: 1, tag: "a", next: 1 };
    let b: Node = Node { id: 2, tag: "b", next: 2 };
    let c: Node = Node { id: 3, tag: "c", next: -1 };
    pool = list_push(pool, a);
    pool = list_push(pool, b);
    pool = list_push(pool, c);
    if list_len(pool) != 3 {
        println("FAIL pool len");
        process_exit(1);
    }
    let g: Node = list_get(pool, 1);
    if g.id != 2 {
        println("FAIL pool id");
        process_exit(1);
    }
    if g.tag != "b" {
        println("FAIL pool tag");
        process_exit(1);
    }
    if g.next != 2 {
        println("FAIL pool next");
        process_exit(1);
    }
    println("sk13_node_pool: PASSED");
}
