// # Product prove std/exploit_analysis/heap_house_of_force.oo
//
// Logline: Fail-closed emit+gcc+run asserts top_chunk_corrupt_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_house_of_force.oo.
//
// Beats:
//   1. Call top_chunk_corrupt_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_house_of_force: PASSED only if they match.

import "std/exploit_analysis/heap_house_of_force.oo";

pub fn main() {
    let heap_house_of_force_mark: Int = 0;
    if heap_house_of_force_mark != 0 {
        process_exit(1);
    }
    let a: TopChunkState = top_chunk_corrupt_size(0, 0);
    let b: TopChunkState = top_chunk_corrupt_size(0, 0);
    if (a).top_address != (b).top_address {
        println("FAIL top_chunk_corrupt_size");
        process_exit(1);
    }
    println("prod_heap_house_of_force: PASSED");
}
