// # Option[String] Some("hi") emit lock
//
// Logline: Fail-closed emit+gcc+run of Option[String] so Some is not None.
//
// Setup: Backend-C. Option[String] is tagged. Some("") must not lower as None.
//
// Beats:
//   1. Bind Some("hi") and match Some with payload "hi".
//   2. Bind None and match None.
//   3. Bind Some("") and match Some so empty string is not None.
//   4. Exit 1 before PASSED on a miss.

pub fn main() {
    let a: Option[String] = Some("hi");
    let b: Option[String] = None;
    let va: String = match a {
        Some(v) => v,
        None => "MISS"
    };
    if va != "hi" {
        println("FAIL some_hi");
        process_exit(1);
    }
    let vb: String = match b {
        Some(v) => "S",
        None => "N"
    };
    if vb != "N" {
        println("FAIL none");
        process_exit(1);
    }
    let c: Option[String] = Some("");
    let vc: String = match c {
        Some(v) => "S",
        None => "N"
    };
    if vc != "S" {
        println("FAIL some_empty");
        process_exit(1);
    }
    println("option_str_smoke: PASSED");
}
