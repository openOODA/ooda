// # Product prove std/bft_consensus/tendermint_bft_validator_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts tendermint_has_two_thirds_majority is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_bft_validator_set.oo.
//
// Beats:
//   1. Call tendermint_has_two_thirds_majority twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tendermint_bft_validator_set: PASSED only if they match.

import "std/bft_consensus/tendermint_bft_validator_set.oo";

pub fn main() {
    let tendermint_bft_validator_set_mark: Int = 0;
    if tendermint_bft_validator_set_mark != 0 {
        process_exit(1);
    }
    let a = tendermint_validator_set_new(0, 0);
    let b = tendermint_validator_set_new(0, 0);
    let xa: Bool = tendermint_has_two_thirds_majority(0, a);
    let xb: Bool = tendermint_has_two_thirds_majority(0, b);
    if xa != xb {
        println("FAIL tendermint_has_two_thirds_majority");
        process_exit(1);
    }
    println("prod_tendermint_bft_validator_set: PASSED");
}
