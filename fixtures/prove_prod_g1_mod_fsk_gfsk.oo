// # Product prove std/telecom_5g/mod_fsk_gfsk.oo
//
// Logline: Fail-closed emit+gcc+run asserts gfsk_modulator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_fsk_gfsk.oo.
//
// Beats:
//   1. Call gfsk_modulator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mod_fsk_gfsk: PASSED only if they match.

import "std/telecom_5g/mod_fsk_gfsk.oo";

pub fn main() {
    let a: GfskModulator = gfsk_modulator_new(0.0, 0.0, 0);
    let b: GfskModulator = gfsk_modulator_new(0.0, 0.0, 0);
    if a.samples_per_symbol != b.samples_per_symbol {
        println("FAIL gfsk_modulator_new");
        process_exit(1);
    }
    println("prod_mod_fsk_gfsk: PASSED");
}
