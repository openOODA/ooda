// # Product prove std/graph_topology/kademlia_dht_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts kademlia_distance_xor is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/kademlia_dht_routing.oo.
//
// Beats:
//   1. Call kademlia_distance_xor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kademlia_dht_routing: PASSED only if they match.

import "std/graph_topology/kademlia_dht_routing.oo";

pub fn main() {
    let kademlia_dht_routing_mark: Int = 0;
    if kademlia_dht_routing_mark != 0 {
        process_exit(1);
    }
    let a: Int = kademlia_distance_xor(0, 0);
    let b: Int = kademlia_distance_xor(0, 0);
    if a != b {
        println("FAIL kademlia_distance_xor");
        process_exit(1);
    }
    println("prod_g2_kademlia_dht_routing: PASSED");
}
