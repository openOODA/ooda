// # Product prove std/astrodynamics/bi_elliptic_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts bielliptic_burns is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/bi_elliptic_transfer.oo.
//
// Beats:
//   1. Call bielliptic_burns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bi_elliptic_transfer: PASSED only if they match.

import "std/astrodynamics/bi_elliptic_transfer.oo";

pub fn main() {
    let bi_elliptic_transfer_mark: Int = 0;
    if bi_elliptic_transfer_mark != 0 {
        process_exit(1);
    }
    let a: Int = bielliptic_burns();
    let b: Int = bielliptic_burns();
    if a != b {
        println("FAIL bielliptic_burns");
        process_exit(1);
    }
    println("prod_bi_elliptic_transfer: PASSED");
}
