// # Product prove std/sec/sys/pe_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/pe_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pe_types: PASSED only if they match.

import "std/sec/sys/pe_types.oo";

pub fn main() {
    let pe_types_a = pe_dos_magic();
    let pe_types_b = pe_dos_magic();
    if pe_types_a != pe_types_b {
        println("FAIL pe_types");
        process_exit(1);
    }
    println("prod_ap_pe_types: PASSED");
}
