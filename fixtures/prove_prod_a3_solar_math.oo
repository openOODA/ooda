// # Product prove std/grid/solar_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_math.oo.
//
// Beats:
//   1. Call math_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_math: PASSED only if they match.

import "std/grid/solar_math.oo";

pub fn main() {
    let solar_math_mark: Int = 0;
    if solar_math_mark != 0 {
        process_exit(1);
    }
    let a: Float = math_pi();
    let b: Float = math_pi();
    if a != b {
        println("FAIL math_pi");
        process_exit(1);
    }
    println("prod_solar_math: PASSED");
}
