// # Product prove std/fintech_defi/hft_cross_venue_arbitrage.oo
//
// Logline: Fail-closed emit+gcc+run asserts venue_quote_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_cross_venue_arbitrage.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call venue_quote_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hft_cross_venue_arbitrage: PASSED only if they match.

import "std/fintech_defi/hft_cross_venue_arbitrage.oo";

pub fn main() {
    let g2_oa: VenueQuote = venue_quote_new("x", 2, 2, 2, 2, 2, 2);
    let g2_ob: VenueQuote = venue_quote_new("x", 2, 2, 2, 2, 2, 2);
    let g2_a = (g2_oa).bid_price;
    let g2_b = (g2_ob).bid_price;
    if g2_a != g2_b {
        println("FAIL venue_quote_new.bid_price");
        process_exit(1);
    }
    println("prod_g2_hft_cross_venue_arbitrage: PASSED");
}
