// # Product prove std/auto/fusion.oo
//
// Logline: Fail-closed verification that multi-sensor fusion operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion.oo.
//
// Beats:
//   1. Construct sensor, track, and engine instances.
//   2. Query fields deterministically.
//   3. Assert returned integer metrics match.
//   4. Print prod_g4_auto_fusion: PASSED and exit 0.

import "std/auto/fusion.oo";

pub fn main() {
    let s1: FusSens = fusion_sensor_new(1, 100);
    let s2: FusSens = fusion_sensor_new(1, 100);
    let stype1: Int = fus_sens_stype(s1);
    let stype2: Int = fus_sens_stype(s2);
    if stype1 != stype2 || stype1 != 1 {
        println("FAIL fus_sens_stype");
        process_exit(1);
    }

    let t1: FusTrk = fusion_track_new(5, 0);
    let t2: FusTrk = fusion_track_new(5, 0);
    let hits1: Int = fus_trk_hits(t1);
    let hits2: Int = fus_trk_hits(t2);
    if hits1 != hits2 || hits1 != 5 {
        println("FAIL fus_trk_hits");
        process_exit(1);
    }

    let e1: FusEng = fusion_engine_new(10, 8);
    let e2: FusEng = fusion_engine_new(10, 8);
    let act1: Int = fus_eng_active(e1);
    let act2: Int = fus_eng_active(e2);
    if act1 != act2 || act1 != 10 {
        println("FAIL fus_eng_active");
        process_exit(1);
    }

    let stub_e: FusEng = fusion_stubs_init(3, 2);
    let stub_act: Int = fus_eng_active(stub_e);
    if stub_act != 3 {
        println("FAIL fusion_stubs_init");
        process_exit(1);
    }

    println("prod_g4_auto_fusion: PASSED");
    process_exit(0);
}
