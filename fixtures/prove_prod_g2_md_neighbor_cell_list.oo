// # Product prove std/protein_folding/md_neighbor_cell_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts cell_should_rebuild_neighbor_list is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_neighbor_cell_list.oo.
//
// Beats:
//   1. Call cell_should_rebuild_neighbor_list twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_neighbor_cell_list: PASSED only if they match.

import "std/protein_folding/md_neighbor_cell_list.oo";

pub fn main() {
    let md_neighbor_cell_list_mark: Int = 0;
    if md_neighbor_cell_list_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cell_should_rebuild_neighbor_list(0.0, 0.0);
    let b: Bool = cell_should_rebuild_neighbor_list(0.0, 0.0);
    if a != b {
        println("FAIL cell_should_rebuild_neighbor_list");
        process_exit(1);
    }
    println("prod_g2_md_neighbor_cell_list: PASSED");
}
