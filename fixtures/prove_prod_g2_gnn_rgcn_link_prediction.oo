// # Product prove std/graph_gnn/gnn_rgcn_link_prediction.oo
//
// Logline: Fail-closed emit+gcc+run asserts rgcn_link_pred_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_rgcn_link_prediction.oo.
//
// Beats:
//   1. Call rgcn_link_pred_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_rgcn_link_prediction: PASSED only if they match.

import "std/graph_gnn/gnn_rgcn_link_prediction.oo";

pub fn main() {
    let gnn_rgcn_link_prediction_mark: Int = 0;
    if gnn_rgcn_link_prediction_mark != 0 {
        process_exit(1);
    }
    let a: RGCNLinkPredConfig = rgcn_link_pred_config_new(0, 0, 0, 0, 0, 0);
    let b: RGCNLinkPredConfig = rgcn_link_pred_config_new(0, 0, 0, 0, 0, 0);
    if (a).num_entities != (b).num_entities {
        println("FAIL rgcn_link_pred_config_new");
        process_exit(1);
    }
    println("prod_g2_gnn_rgcn_link_prediction: PASSED");
}
