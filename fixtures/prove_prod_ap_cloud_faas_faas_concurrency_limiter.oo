// # Product prove std/cloud_faas/faas_concurrency_limiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_faas/faas_concurrency_limiter.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/faas_concurrency_limiter.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_faas_concurrency_limiter: PASSED only if they match.

import "std/cloud_faas/faas_concurrency_limiter.oo";

pub fn main() {
    let faas_concurrency_limiter_a = regional_concurrency_pool_new(0, 0);
    let faas_concurrency_limiter_b = regional_concurrency_pool_new(0, 0);
    if faas_concurrency_limiter_a.region_id != faas_concurrency_limiter_b.region_id {
        println("FAIL faas_concurrency_limiter");
        process_exit(1);
    }
    println("prod_ap_faas_concurrency_limiter: PASSED");
}
