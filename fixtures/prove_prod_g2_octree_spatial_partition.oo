// # Product prove std/gis_topo/octree_spatial_partition.oo
//
// Logline: Fail-closed emit+gcc+run asserts octree_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/octree_spatial_partition.oo.
//
// Beats:
//   1. Call octree_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_octree_spatial_partition: PASSED only if they match.

import "std/gis_topo/octree_spatial_partition.oo";

pub fn main() {
    let octree_spatial_partition_mark: Int = 0;
    if octree_spatial_partition_mark != 0 {
        process_exit(1);
    }
    let a: OctreePoint3D = octree_point_new(0, 0.0, 0.0, 0.0);
    let b: OctreePoint3D = octree_point_new(0, 0.0, 0.0, 0.0);
    if (a).id != (b).id {
        println("FAIL octree_point_new");
        process_exit(1);
    }
    println("prod_g2_octree_spatial_partition: PASSED");
}
