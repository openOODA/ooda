// # Allow a public sleep_ms duration
//
// Logline: A non-secret duration may reach sleep_ms while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public duration instead.
//   3. Expect emit to allow the call.

// Secret allow non-secret: sleep_ms
// SECRET: token
pub fn main(tcap: &TimeCap) {
    let token = 10;
    let public = 1;
    let r = sleep_ms(tcap, public);
    println(1);
}
