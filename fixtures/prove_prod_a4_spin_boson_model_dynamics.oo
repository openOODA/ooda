// # Product prove std/quantum_open_systems/spin_boson_model_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts spin_boson_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/spin_boson_model_dynamics.oo.
//
// Beats:
//   1. Call spin_boson_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spin_boson_model_dynamics: PASSED only if they match.

import "std/quantum_open_systems/spin_boson_model_dynamics.oo";

pub fn main() {
    let spin_boson_model_dynamics_mark: Int = 0;
    if spin_boson_model_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: SpinBosonParams = spin_boson_params_new(0.0, 0.0, 0.0, 0.0);
    let b: SpinBosonParams = spin_boson_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).tunneling_delta != (b).tunneling_delta {
        println("FAIL spin_boson_params_new");
        process_exit(1);
    }
    println("prod_spin_boson_model_dynamics: PASSED");
}
