// # Product prove std/pbr_raytracing/pathtrace_russian_roulette.oo
//
// Logline: Fail-closed emit+gcc+run asserts pathtrace_russian_roulette_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pathtrace_russian_roulette.oo.
//
// Beats:
//   1. Call pathtrace_russian_roulette_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pathtrace_russian_roulette: PASSED only if it matches.

import "std/pbr_raytracing/pathtrace_russian_roulette.oo";

pub fn main() {
    let a: Int = pathtrace_russian_roulette_probe();
    if a != 0 {
        println("FAIL pathtrace_russian_roulette_probe");
        process_exit(1);
    }
    println("prod_nc_pathtrace_russian_roulette: PASSED");
}
