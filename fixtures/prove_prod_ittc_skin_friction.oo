// # Product prove std/robotics_auv/quadratic_damping_crossflow.oo
//
// Logline: Fail-closed emit+gcc+run asserts ittc_skin_friction_coefficient is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/quadratic_damping_crossflow.oo.
//
// Beats:
//   1. Call ittc_skin_friction_coefficient twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ittc_skin_friction: PASSED only if they match.

import "std/robotics_auv/quadratic_damping_crossflow.oo";

pub fn main() {
    let quadratic_damping_crossflow_mark: Int = 0;
    if quadratic_damping_crossflow_mark != 0 { process_exit(1); }
    let a: Float = ittc_skin_friction_coefficient(100000.0);
    let b: Float = ittc_skin_friction_coefficient(100000.0);
    if a != b {
        println("FAIL ittc_skin_friction_coefficient");
        process_exit(1);
    }
    println("prod_ittc_skin_friction: PASSED");
}
