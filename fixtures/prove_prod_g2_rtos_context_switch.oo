// # Product prove std/embedded_hal/rtos_context_switch.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_scheduler_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_context_switch.oo.
//
// Beats:
//   1. Call rtos_scheduler_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rtos_context_switch: PASSED only if they match.

import "std/embedded_hal/rtos_context_switch.oo";

pub fn main() {
    let rtos_context_switch_mark: Int = 0;
    if rtos_context_switch_mark != 0 {
        process_exit(1);
    }
    let a: RtosScheduler = rtos_scheduler_new();
    let b: RtosScheduler = rtos_scheduler_new();
    if (a).ready_bitmap != (b).ready_bitmap {
        println("FAIL rtos_scheduler_new");
        process_exit(1);
    }
    println("prod_g2_rtos_context_switch: PASSED");
}
