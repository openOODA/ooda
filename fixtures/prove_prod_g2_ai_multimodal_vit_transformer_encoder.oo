// # Product prove std/ai_multimodal/vit_transformer_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts vit_transformer_encoder_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_transformer_encoder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call vit_transformer_encoder_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vit_transformer_encoder: PASSED only if they match.

import "std/ai_multimodal/vit_transformer_encoder.oo";

pub fn main() {
    let g2_a = vit_transformer_encoder_marker();
    let g2_b = vit_transformer_encoder_marker();
    if g2_a != g2_b {
        println("FAIL vit_transformer_encoder_marker");
        process_exit(1);
    }
    println("prod_g2_vit_transformer_encoder: PASSED");
}
