// # Product prove std/bio_advanced/protein_isoelectric_point.oo
//
// Logline: Fail-closed emit+gcc+run asserts pi_pka_n_term is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_isoelectric_point.oo.
//
// Beats:
//   1. Call pi_pka_n_term twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_isoelectric_point: PASSED only if they match.

import "std/bio_advanced/protein_isoelectric_point.oo";

pub fn main() {
    let protein_isoelectric_point_mark: Int = 0;
    if protein_isoelectric_point_mark != 0 {
        process_exit(1);
    }
    let a: Float = pi_pka_n_term();
    let b: Float = pi_pka_n_term();
    if a != b {
        println("FAIL pi_pka_n_term");
        process_exit(1);
    }
    println("prod_protein_isoelectric_point: PASSED");
}
