// # Product prove std/gis_topo/dem_terrain_roughness.oo
//
// Logline: Fail-closed emit+gcc+run asserts dem_classify_landform is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_terrain_roughness.oo.
//
// Beats:
//   1. Call dem_classify_landform twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dem_terrain_roughness: PASSED only if they match.

import "std/gis_topo/dem_terrain_roughness.oo";
import "std/str.oo";

pub fn main() {
    let dem_terrain_roughness_mark: Int = 0;
    if dem_terrain_roughness_mark != 0 {
        process_exit(1);
    }
    let dem_terrain_roughness_a: String = dem_classify_landform(1.0);
    let dem_terrain_roughness_b: String = dem_classify_landform(1.0);
    if str_eq(dem_terrain_roughness_a, dem_terrain_roughness_b) == false {
        println("FAIL dem_classify_landform");
        process_exit(1);
    }
    println("prod_dem_terrain_roughness: PASSED");
}
