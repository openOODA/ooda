// # Product prove std/db_columnar/columnar_quantiles_t_digest.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_quantiles_t_digest.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_quantiles_t_digest.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_quantiles_t_digest: PASSED only if they match.

import "std/db_columnar/columnar_quantiles_t_digest.oo";

pub fn main() {
    let columnar_quantiles_t_digest_a = tdigest_state_new(0);
    let columnar_quantiles_t_digest_b = tdigest_state_new(0);
    let columnar_quantiles_t_digest_va = tdigest_estimate_median(columnar_quantiles_t_digest_a);
    let columnar_quantiles_t_digest_vb = tdigest_estimate_median(columnar_quantiles_t_digest_b);
    if columnar_quantiles_t_digest_va != columnar_quantiles_t_digest_vb {
        println("FAIL columnar_quantiles_t_digest");
        process_exit(1);
    }
    println("prod_ap_columnar_quantiles_t_digest: PASSED");
}
