// # Product prove std/sec/sys/secure_boot.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/secure_boot.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_secure_boot: PASSED only if they match.

import "std/sec/sys/secure_boot.oo";

pub fn main() {
    let secure_boot_a = shim_marker_sboot_cert_x509();
    let secure_boot_b = shim_marker_sboot_cert_x509();
    if secure_boot_a != secure_boot_b {
        println("FAIL secure_boot");
        process_exit(1);
    }
    println("prod_ap_secure_boot: PASSED");
}
