// # Product prove std/quantum_advanced/surface_code_lattice_surgery.oo
//
// Logline: Fail-closed emit+gcc+run asserts boundary_rough is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/surface_code_lattice_surgery.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call boundary_rough twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_surface_code_lattice_surgery: PASSED only if they match.

import "std/quantum_advanced/surface_code_lattice_surgery.oo";

pub fn main() {
    let g2_oa: BoundaryType = boundary_rough();
    let g2_ob: BoundaryType = boundary_rough();
    let g2_a = (g2_oa).mode;
    let g2_b = (g2_ob).mode;
    if g2_a != g2_b {
        println("FAIL boundary_rough.mode");
        process_exit(1);
    }
    println("prod_g2_surface_code_lattice_surgery: PASSED");
}
