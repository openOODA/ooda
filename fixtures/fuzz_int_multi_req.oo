// # Int arity-2 with requires
//
// Logline: Add two Ints that each carry a non-negative requires.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target clamp_add 0 10.
//   2. Require x >= 0 and y >= 0.
//   3. Ensure result >= x and result >= y; return x + y.

// Pure Int arity-2 with requires (x,y).
// FUZZ_DOMAIN: int
// FUZZ_TARGET: clamp_add 0 10
// FUZZ_REQUIRES: clamp_add x >= 0
// FUZZ_REQUIRES: clamp_add y >= 0
// FUZZ_ENSURES: clamp_add result >= x
// FUZZ_ENSURES: clamp_add result >= y
fn clamp_add(x: Int, y: Int) -> Int {
    return x + y;
}
pub fn main() {}
