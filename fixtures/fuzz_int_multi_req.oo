// Pure Int arity-2 with requires (x,y).
// FUZZ_DOMAIN: int
// FUZZ_TARGET: clamp_add 0 10
// FUZZ_REQUIRES: clamp_add x >= 0
// FUZZ_REQUIRES: clamp_add y >= 0
// FUZZ_ENSURES: clamp_add result >= x
// FUZZ_ENSURES: clamp_add result >= y
fn clamp_add(x: Int, y: Int) -> Int {
    return x + y;
}
pub fn main() {}
