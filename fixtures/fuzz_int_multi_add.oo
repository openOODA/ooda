// # Int arity-2 add fuzz
//
// Logline: Add two non-negative Ints and prove result == x + y.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target multi_add 0 40.
//   2. Require x, y >= 0 and ensure the sum and lower bounds.
//   3. Return x + y.

// Pure Int arity-2 multi-arg fuzz pass fixture (M46).
// FUZZ_DOMAIN: int
// FUZZ_TARGET: multi_add 0 40
// FUZZ_REQUIRES: multi_add x >= 0 && y >= 0
// FUZZ_ENSURES: multi_add result == x + y
// FUZZ_ENSURES: multi_add result >= x
// FUZZ_ENSURES: multi_add result >= y
fn multi_add(x: Int, y: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    ensures result == x + y;
    ensures result >= x;
    ensures result >= y;
    return x + y;
}

