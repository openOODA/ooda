// # Product prove std/os/signal_handler_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/signal_handler_stub.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/signal_handler_stub.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_signal_handler_stub: PASSED only if they match.

import "std/os/signal_handler_stub.oo";

pub fn main() {
    let signal_handler_stub_a = signal_registry_new();
    let signal_handler_stub_b = signal_registry_new();
    let signal_handler_stub_va = signal_is_registered(signal_handler_stub_a, 0);
    let signal_handler_stub_vb = signal_is_registered(signal_handler_stub_b, 0);
    if signal_handler_stub_va != signal_handler_stub_vb {
        println("FAIL signal_handler_stub");
        process_exit(1);
    }
    println("prod_ap_signal_handler_stub: PASSED");
}
