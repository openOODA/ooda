// # Product prove std/scicomp/sparse_solver_cg.oo
//
// Logline: Fail-closed emit+check asserts apply_jacobi is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/sparse_solver_cg.oo.
//
// Beats:
//   1. Call apply_jacobi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_solver_cg: PASSED only if they match.

import "std/scicomp/sparse_solver_cg.oo";

pub fn main() {
    let sparse_solver_cg_mark: Int = 0;
    if sparse_solver_cg_mark != 0 { process_exit(1); }
    let a: List[Float] = apply_jacobi(list_new(), list_new());
    let b: List[Float] = apply_jacobi(list_new(), list_new());
    if a != b { process_exit(1); }
    println("prod_sparse_solver_cg: PASSED");
}
