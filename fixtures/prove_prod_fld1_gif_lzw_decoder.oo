// # Product prove std/media_dsp/gif_lzw_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts gif_gce_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/gif_lzw_decoder.oo.
//
// Beats:
//   1. Call gif_gce_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gif_lzw_decoder: PASSED only if they match.

import "std/media_dsp/gif_lzw_decoder.oo";

pub fn main() {
    let gif_lzw_decoder_mark: Int = 0;
    if gif_lzw_decoder_mark != 0 {
        process_exit(1);
    }
    let gif_lzw_decoder_a = gif_gce_default();
    let gif_lzw_decoder_b = gif_gce_default();
    if (gif_lzw_decoder_a).disposal_method != (gif_lzw_decoder_b).disposal_method {
        println("FAIL gif_gce_default");
        process_exit(1);
    }
    println("prod_gif_lzw_decoder: PASSED");
}
