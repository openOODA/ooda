// # Product prove std/robot/slam_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts slam_engine_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/slam_engine.oo.
//
// Beats:
//   1. Call slam_engine_new using the slam_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_slam_engine: PASSED only if asserts hold.

import "std/robot/slam_engine.oo";

pub fn main() {
    let obj = slam_engine_new();
    let slam_engine_a = obj.total_steps;
    if slam_engine_a != 0 {
        println("FAIL slam_engine_new");
        process_exit(1);
    }
    println("prod_slam_engine: PASSED");
}
