// # Product prove std/archive/zip_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts zip_detect_magic is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zip_stream.oo.
//
// Beats:
//   1. Call zip_detect_magic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zip_stream: PASSED only if they match.

import "std/archive/zip_stream.oo";

pub fn main() {
    let a = zip_detect_magic("x");
    let b = zip_detect_magic("x");
    if a != b {
        println("FAIL zip_detect_magic");
        process_exit(1);
    }
    println("prod_zip_stream: PASSED");
}
