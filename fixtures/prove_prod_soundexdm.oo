// # Product Daitch-Mokotoff soundex prove
//
// Logline: Fail-closed emit+gcc+run of shipped soundex_dm_encode.
//
// Setup: Product std/text/soundex_dm.oo. Digit map s=4 m=6 t=3, pad to 6.
//
// Beats:
//   1. smith encodes to 463000.
//   2. empty encodes to 000000.
//   3. Exit 1 before PASSED on a miss.

import "std/text/soundex_dm.oo";

pub fn main() {
    let s: String = soundex_dm_encode("smith");
    if s != "463000" {
        println("FAIL soundex_dm smith");
        process_exit(1);
    }
    let z: String = soundex_dm_encode("");
    if z != "000000" {
        println("FAIL soundex_dm empty");
        process_exit(1);
    }
    println("prod_soundexdm: PASSED");
}
