// # Product prove std/quantum_open_systems/operator_space_entanglement_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/operator_space_entanglement_decay.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/operator_space_entanglement_decay.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_operator_space_entanglement_decay: PASSED only if they match.

import "std/quantum_open_systems/operator_space_entanglement_decay.oo";

pub fn main() {
    let operator_space_entanglement_decay_a = osee_tracking_new(0.0, 0.0);
    let operator_space_entanglement_decay_b = osee_tracking_new(0.0, 0.0);
    let operator_space_entanglement_decay_va = osee_evaluate(operator_space_entanglement_decay_a, 0.0);
    let operator_space_entanglement_decay_vb = osee_evaluate(operator_space_entanglement_decay_b, 0.0);
    if operator_space_entanglement_decay_va != operator_space_entanglement_decay_vb {
        println("FAIL operator_space_entanglement_decay");
        process_exit(1);
    }
    println("prod_ap_operator_space_entanglement_decay: PASSED");
}
