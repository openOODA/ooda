// # Product prove std/os/rlimit.oo
//
// Logline: Fail-closed emit+gcc+run asserts rlimit_cpu_limit is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/rlimit.oo.
//
// Beats:
//   1. Call rlimit_cpu_limit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rlimit: PASSED only if they match.

import "std/os/rlimit.oo";

pub fn main() {
    let a = rlimit_cpu_limit();
    let b = rlimit_cpu_limit();
    if a != b {
        println("FAIL rlimit_cpu_limit");
        process_exit(1);
    }
    println("prod_rlimit: PASSED");
}
