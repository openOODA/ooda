// # Product prove std/telecom_6g/oam_orbital_angular_momentum.oo
//
// Logline: Fail-closed emit+gcc+run asserts oam_mode_orthogonality_check is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/oam_orbital_angular_momentum.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call oam_mode_orthogonality_check twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_oam_orbital_angular_momentum: PASSED only if they match.

import "std/telecom_6g/oam_orbital_angular_momentum.oo";

pub fn main() {
    let g2_a = oam_mode_orthogonality_check(2, 2);
    let g2_b = oam_mode_orthogonality_check(2, 2);
    if g2_a != g2_b {
        println("FAIL oam_mode_orthogonality_check");
        process_exit(1);
    }
    println("prod_g2_oam_orbital_angular_momentum: PASSED");
}
