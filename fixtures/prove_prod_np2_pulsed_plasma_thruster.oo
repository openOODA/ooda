// # Product prove std/space_propulsion/pulsed_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts ppt_compute_pulse is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/pulsed_plasma_thruster.oo.
//
// Beats:
//   1. Call ppt_compute_pulse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pulsed_plasma_thruster: PASSED only if they match.

import "std/space_propulsion/pulsed_plasma_thruster.oo";

pub fn main() {
    let pulsed_plasma_thruster_mark: Int = 0;
    if pulsed_plasma_thruster_mark != 0 {
        process_exit(1);
    }
    let pulsed_plasma_thruster_a = ppt_compute_pulse(ppt_circuit_spec_default());
    let pulsed_plasma_thruster_b = ppt_compute_pulse(ppt_circuit_spec_default());
    if (pulsed_plasma_thruster_a).stored_energy_joules != (pulsed_plasma_thruster_b).stored_energy_joules {
        println("FAIL ppt_compute_pulse");
        process_exit(1);
    }
    println("prod_pulsed_plasma_thruster: PASSED");
}
