// # Product prove std/wasm_gc/wasm_gc_heap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_gc_heap_kind is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_heap_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call wasm_gc_heap_kind twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_gc_heap_types: PASSED only if they match.

import "std/wasm_gc/wasm_gc_heap_types.oo";

pub fn main() {
    let g2_oa = wasm_gc_heap_new(2, 2);
    let g2_ob = wasm_gc_heap_new(2, 2);
    let g2_a = wasm_gc_heap_kind(g2_oa);
    let g2_b = wasm_gc_heap_kind(g2_ob);
    if g2_a != g2_b {
        println("FAIL wasm_gc_heap_kind");
        process_exit(1);
    }
    println("prod_g2_wasm_gc_heap_types: PASSED");
}
