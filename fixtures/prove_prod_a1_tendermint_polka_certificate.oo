// # Product prove std/bft_consensus/tendermint_polka_certificate.oo
//
// Logline: Fail-closed emit+gcc+run asserts polka_can_unlock is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_polka_certificate.oo.
//
// Beats:
//   1. Call polka_can_unlock twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tendermint_polka_certificate: PASSED only if they match.

import "std/bft_consensus/tendermint_polka_certificate.oo";

pub fn main() {
    let tendermint_polka_certificate_mark: Int = 0;
    if tendermint_polka_certificate_mark != 0 {
        process_exit(1);
    }
    let a: Bool = polka_can_unlock(0, 0);
    let b: Bool = polka_can_unlock(0, 0);
    if a != b {
        println("FAIL polka_can_unlock");
        process_exit(1);
    }
    println("prod_tendermint_polka_certificate: PASSED");
}
