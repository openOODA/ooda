// # Product prove std/crypto/keys_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/keys_store.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys_store.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_keys_store: PASSED only if they match.

import "std/crypto/keys_store.oo";

pub fn main() {
    let keys_store_a = __dummy_std_src_ooda_crypto_keys_store_oo();
    let keys_store_b = __dummy_std_src_ooda_crypto_keys_store_oo();
    if keys_store_a != keys_store_b {
        println("FAIL keys_store");
        process_exit(1);
    }
    println("prod_ap_keys_store: PASSED");
}
