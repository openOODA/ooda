// # Product prove std/bio/smiles_stubs.oo
//
// Logline: Fail-closed verification that cheminformatics stubs and fingerprint data structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_stubs.oo.
//
// Beats:
//   1. Construct Fingerprint instances using fingerprint_create_empty.
//   2. Set and query fingerprint bits deterministically.
//   3. Compute Tanimoto and Dice similarity coefficients.
//   4. Print prod_g4_bio_smiles_stubs: PASSED and exit 0.

import "std/bio/smiles_stubs.oo";

pub fn main() {
    let fp1: Fingerprint = fingerprint_create_empty(64, "Morgan");
    let fp2: Fingerprint = fingerprint_create_empty(64, "Morgan");

    let s1: Fingerprint = fingerprint_set_bit(fp1, 10);
    let s2: Fingerprint = fingerprint_set_bit(fp2, 10);

    let has1: Bool = fingerprint_has_bit(s1, 10);
    let has2: Bool = fingerprint_has_bit(s2, 10);
    if !has1 || !has2 {
        println("FAIL fingerprint_has_bit");
        process_exit(1);
    }

    let has_other: Bool = fingerprint_has_bit(s1, 20);
    if has_other {
        println("FAIL fingerprint_has_bit unset");
        process_exit(1);
    }

    let tan: Int = fingerprint_tanimoto_similarity(s1, s2);
    if tan != 100 {
        println("FAIL fingerprint_tanimoto_similarity");
        process_exit(1);
    }

    let dice: Int = fingerprint_dice_similarity(s1, s2);
    if dice != 100 {
        println("FAIL fingerprint_dice_similarity");
        process_exit(1);
    }

    println("prod_g4_bio_smiles_stubs: PASSED");
    process_exit(0);
}
