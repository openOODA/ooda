// # Product prove std/bio_advanced/protein_isoelectric_point.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/protein_isoelectric_point.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_isoelectric_point.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_isoelectric_point: PASSED only if they match.

import "std/bio_advanced/protein_isoelectric_point.oo";

pub fn main() {
    let protein_isoelectric_point_a = pi_pka_n_term();
    let protein_isoelectric_point_b = pi_pka_n_term();
    if protein_isoelectric_point_a != protein_isoelectric_point_b {
        println("FAIL protein_isoelectric_point");
        process_exit(1);
    }
    println("prod_ap_protein_isoelectric_point: PASSED");
}
