// # Product vec3 projection prove
//
// Logline: Fail-closed emit+gcc+run of shipped vec3_dot/project.
//
// Setup: Product std/math/vector_projection.oo. (1,0,0) onto (2,0,0) is itself.
//
// Beats:
//   1. Dot of (1,0,0) and (2,0,0) is 2.0.
//   2. Project (1,0,0) onto (2,0,0) x is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/vector_projection.oo";

pub fn main() {
    let u: Vec3 = vec3_new(1.0, 0.0, 0.0);
    let v: Vec3 = vec3_new(2.0, 0.0, 0.0);
    let d: Float = vec3_dot(u, v);
    if d != 2.0 {
        println("FAIL vec3 dot");
        process_exit(1);
    }
    let p: Vec3 = vec3_project(u, v);
    let px: Float = vec3_get_x(p);
    if px != 1.0 {
        println("FAIL vec3 project");
        process_exit(1);
    }
    println("prod_vec3: PASSED");
}
