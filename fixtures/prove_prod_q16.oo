// # Product Q16.16 prove
//
// Logline: Fail-closed emit+gcc+run of shipped q16_from_int/add/mul/to_int.
//
// Setup: Product std/math/fixed_point_q16_16.oo. Scale 65536.
//
// Beats:
//   1. 2+3 is 5.
//   2. 2*3 is 6.
//   3. Exit 1 before PASSED on a miss.

import "std/math/fixed_point_q16_16.oo";

pub fn main() {
    let a: Q16 = q16_from_int(2);
    let b: Q16 = q16_from_int(3);
    let s: Q16 = q16_add(a, b);
    let si: Int = q16_to_int(s);
    if si != 5 {
        println("FAIL q16 add");
        process_exit(1);
    }
    let p: Q16 = q16_mul(a, b);
    let pi: Int = q16_to_int(p);
    if pi != 6 {
        println("FAIL q16 mul");
        process_exit(1);
    }
    println("prod_q16: PASSED");
}
