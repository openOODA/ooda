// # Product prove std/formal_verif/model_check_symbolic_bdd.oo
//
// Logline: Fail-closed emit+gcc+run asserts bdd_make_node is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_symbolic_bdd.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bdd_make_node twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_model_check_symbolic_bdd: PASSED only if they match.

import "std/formal_verif/model_check_symbolic_bdd.oo";

pub fn main() {
    let mut g2_oa: BddManager = bdd_manager_new();
    let mut g2_ob: BddManager = bdd_manager_new();
    let g2_a = bdd_make_node(&g2_oa, 2, 2, 2);
    let g2_b = bdd_make_node(&g2_ob, 2, 2, 2);
    if g2_a != g2_b {
        println("FAIL bdd_make_node");
        process_exit(1);
    }
    println("prod_g2_model_check_symbolic_bdd: PASSED");
}
