// # Product prove std/graph_topology/bipartite_matching_hopcroft.oo
//
// Logline: Fail-closed emit+gcc+run asserts bipartite_matching_hopcroft_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/bipartite_matching_hopcroft.oo.
//
// Beats:
//   1. Call bipartite_matching_hopcroft_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bipartite_matching_hopcroft: PASSED only if they match.

import "std/graph_topology/bipartite_matching_hopcroft.oo";

pub fn main() {
    let bipartite_matching_hopcroft_mark: Int = 0;
    if bipartite_matching_hopcroft_mark != 0 {
        process_exit(1);
    }
    let bipartite_matching_hopcroft_a: Int = bipartite_matching_hopcroft_probe();
    let bipartite_matching_hopcroft_b: Int = bipartite_matching_hopcroft_probe();
    if bipartite_matching_hopcroft_a != bipartite_matching_hopcroft_b {
        println("FAIL bipartite_matching_hopcroft_probe");
        process_exit(1);
    }
    println("prod_bipartite_matching_hopcroft: PASSED");
}
