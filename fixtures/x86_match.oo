// # Native x86_64 pattern match over Option tagged union
//
// Logline: Evaluates Option[Int] Some(42), extracts tag/payload in pure x86_64 assembly, and prints 42.
//
// Setup: Tagged union representation [tag (8B), payload (8B)]. Pure as+ld.

pub fn main() {
    let opt: Option[Int] = Some(42);
    let val: Int = match opt {
        Some(v) => v,
        None => 0
    };
    println(val);
}
