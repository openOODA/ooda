// # Product prove std/telecom_5g/channel_pathloss_3gpp.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_3gpp_breakpoint_distance_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_pathloss_3gpp.oo.
//
// Beats:
//   1. Call channel_3gpp_breakpoint_distance_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_pathloss_3gpp: PASSED only if they match.

import "std/telecom_5g/channel_pathloss_3gpp.oo";

pub fn main() {
    let channel_pathloss_3gpp_mark: Int = 0;
    if channel_pathloss_3gpp_mark != 0 {
        process_exit(1);
    }
    let channel_pathloss_3gpp_a: Float = channel_3gpp_breakpoint_distance_m(1.0, 1.0, 1.0);
    let channel_pathloss_3gpp_b: Float = channel_3gpp_breakpoint_distance_m(1.0, 1.0, 1.0);
    if channel_pathloss_3gpp_a != channel_pathloss_3gpp_b {
        println("FAIL channel_3gpp_breakpoint_distance_m");
        process_exit(1);
    }
    println("prod_channel_pathloss_3gpp: PASSED");
}
