// # HTTP Networking and Parsing Proof Fixture
//
// Logline: Proves HTTP request header building, status code parsing, body extraction, and capability requirement.
//
// Setup: Validates HTTP parsing utilities and ensures capability checking.
//
// Beats:
//   1. Build standard HTTP request header.
//   2. Parse 200 OK and 404 Not Found status codes.
//   3. Extract HTTP body from response payload.
// RULES.oot 1.4: Default-deny for network effects. Explicit &NetCap required for requests.
// RULES.oot 1.6: Prove parsing and validation suite.
// RULES.oot 1.7: Under 256 lines.

import "std/net/http.oo";
import "std/result.oo";

pub fn main(net: &NetCap) {
    // 1. Build HTTP request
    let req: String = http_build_request_header("GET", "/api/v1/health", "api.service.internal", "application/json");
    if !req.contains("GET /api/v1/health HTTP/1.1") {
        println("FAIL: request header format");
        process_exit(1);
    }
    if !req.contains("Host: api.service.internal") {
        println("FAIL: host header missing");
        process_exit(1);
    }

    // 2. Parse status codes
    let resp_200: String = "HTTP/1.1 200 OK\nContent-Type: text/plain\n\nall systems operational";
    let status_200: Int = http_parse_status(resp_200);
    if status_200 != 200 {
        println("FAIL: status_200 mismatch: " + status_200.to_string());
        process_exit(1);
    }

    let resp_404: String = "HTTP/1.1 404 Not Found\n\nresource not found";
    let status_404: Int = http_parse_status(resp_404);
    if status_404 != 404 {
        println("FAIL: status_404 mismatch: " + status_404.to_string());
        process_exit(1);
    }

    // 3. Parse body
    let body_extracted: String = http_parse_body(resp_200);
    if body_extracted != "all systems operational" {
        println("FAIL: body_extracted mismatch: " + body_extracted);
        process_exit(1);
    }

    println("OK: HTTP_SMOKE_PROOF_PASSED");
}
