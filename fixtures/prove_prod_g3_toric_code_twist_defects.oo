// # Product prove std/quantum_topological/toric_code_twist_defects.oo
//
// Logline: Fail-closed emit+gcc+run asserts twist_permute_anyon is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_twist_defects.oo.
//
// Beats:
//   1. Call twist_permute_anyon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_toric_code_twist_defects: PASSED only if they match.

import "std/quantum_topological/toric_code_twist_defects.oo";

pub fn main() {
    let toric_code_twist_defects_mark: Int = 0;
    if toric_code_twist_defects_mark != 0 {
        process_exit(1);
    }
    let a: Int = twist_permute_anyon(0);
    let b: Int = twist_permute_anyon(0);
    if a != b {
        println("FAIL twist_permute_anyon");
        process_exit(1);
    }
    println("prod_toric_code_twist_defects: PASSED");
}
