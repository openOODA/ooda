// # Product prove std/quantum_advanced/quantum_approx_opt_qaoa.oo
//
// Logline: Fail-closed emit+gcc+run asserts qaoa_approximation_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_approx_opt_qaoa.oo.
//
// Beats:
//   1. Call qaoa_approximation_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_approx_opt_qaoa: PASSED only if they match.

import "std/quantum_advanced/quantum_approx_opt_qaoa.oo";

pub fn main() {
    let quantum_approx_opt_qaoa_mark: Int = 0;
    if quantum_approx_opt_qaoa_mark != 0 {
        process_exit(1);
    }
    let quantum_approx_opt_qaoa_a: Float = qaoa_approximation_ratio(1.0, 1.0);
    let quantum_approx_opt_qaoa_b: Float = qaoa_approximation_ratio(1.0, 1.0);
    if quantum_approx_opt_qaoa_a != quantum_approx_opt_qaoa_b {
        println("FAIL qaoa_approximation_ratio");
        process_exit(1);
    }
    println("prod_quantum_approx_opt_qaoa: PASSED");
}
