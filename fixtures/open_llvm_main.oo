// # LLVM two-module main
//
// Logline: Import open_llvm_lib.oo and print two().
//
// Setup: OPEN-30. emit-llvm concatenates imports into one module.
//
// Beats:
//   1. Import the sibling library.
//   2. Call two().
//   3. Print 2.

import "open_llvm_lib.oo";

pub fn main() {
    println(two());
}
