// # Product prove std/physics/collision_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/collision_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/collision_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_collision_types: PASSED only if they match.

import "std/physics/collision_types.oo";

pub fn main() {
    let collision_types_a = collider_aabb_new(0, 0);
    let collision_types_b = collider_aabb_new(0, 0);
    let collision_types_va = collider_aabb_min_x(collision_types_a);
    let collision_types_vb = collider_aabb_min_x(collision_types_b);
    if collision_types_va != collision_types_vb {
        println("FAIL collision_types");
        process_exit(1);
    }
    println("prod_ap_collision_types: PASSED");
}
