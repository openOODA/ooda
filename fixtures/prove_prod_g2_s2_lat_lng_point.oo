// # Product prove std/gis_topo/s2_lat_lng_point.oo
//
// Logline: Fail-closed emit+gcc+run asserts s2_deg_to_rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/s2_lat_lng_point.oo.
//
// Beats:
//   1. Call s2_deg_to_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_s2_lat_lng_point: PASSED only if they match.

import "std/gis_topo/s2_lat_lng_point.oo";

pub fn main() {
    let s2_lat_lng_point_mark: Int = 0;
    if s2_lat_lng_point_mark != 0 {
        process_exit(1);
    }
    let a: Float = s2_deg_to_rad(0.0);
    let b: Float = s2_deg_to_rad(0.0);
    if a != b {
        println("FAIL s2_deg_to_rad");
        process_exit(1);
    }
    println("prod_g2_s2_lat_lng_point: PASSED");
}
