// # Product prove std/tda_topology/fisher_information_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts fisher_measure_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/fisher_information_tda.oo.
//
// Beats:
//   1. Call fisher_measure_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fisher_information_tda: PASSED only if they match.

import "std/tda_topology/fisher_information_tda.oo";

pub fn main() {
    let fisher_information_tda_mark: Int = 0;
    if fisher_information_tda_mark != 0 {
        process_exit(1);
    }
    let fisher_information_tda_a = fisher_measure_new(1.0);
    let fisher_information_tda_b = fisher_measure_new(1.0);
    if (fisher_information_tda_a).point_count != (fisher_information_tda_b).point_count {
        println("FAIL fisher_measure_new");
        process_exit(1);
    }
    println("prod_fisher_information_tda: PASSED");
}
