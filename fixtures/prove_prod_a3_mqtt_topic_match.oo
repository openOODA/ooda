// # Product prove std/industrial_iot/mqtt_topic_match.oo
//
// Logline: Fail-closed emit+gcc+run asserts mqtt_topic_is_valid_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/mqtt_topic_match.oo.
//
// Beats:
//   1. Call mqtt_topic_is_valid_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mqtt_topic_match: PASSED only if they match.

import "std/industrial_iot/mqtt_topic_match.oo";

pub fn main() {
    let mqtt_topic_match_mark: Int = 0;
    if mqtt_topic_match_mark != 0 {
        process_exit(1);
    }
    let a: Bool = mqtt_topic_is_valid_name("x");
    let b: Bool = mqtt_topic_is_valid_name("x");
    if a != b {
        println("FAIL mqtt_topic_is_valid_name");
        process_exit(1);
    }
    println("prod_mqtt_topic_match: PASSED");
}
