// # Product prove std/satellite_dvb/satellite_beam_hopping_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts beam_hopping_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_beam_hopping_scheduler.oo.
//
// Beats:
//   1. Call beam_hopping_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_beam_hopping_scheduler: PASSED only if they match.

import "std/satellite_dvb/satellite_beam_hopping_scheduler.oo";

pub fn main() {
    let a: BeamHoppingPlan = beam_hopping_plan_new(0, 0.0, 0);
    let b: BeamHoppingPlan = beam_hopping_plan_new(0, 0.0, 0);
    if a.num_beams != b.num_beams {
        println("FAIL beam_hopping_plan_new");
        process_exit(1);
    }
    println("prod_satellite_beam_hopping_scheduler: PASSED");
}
