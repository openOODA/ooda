// # Product prove std/sec/crypto/zksnark_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts zksnark_protocol_groth16 is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_types.oo.
//
// Beats:
//   1. Call zksnark_protocol_groth16 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zksnark_types: PASSED only if they match.

import "std/sec/crypto/zksnark_types.oo";

pub fn main() {
    let a = zksnark_protocol_groth16();
    let b = zksnark_protocol_groth16();
    if a != b {
        println("FAIL zksnark_protocol_groth16");
        process_exit(1);
    }
    println("prod_zksnark_types: PASSED");
}
