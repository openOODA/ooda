// # Human-in-the-Loop (HITL) Harness and Step-Pause End-to-End Fixture
//
// Logline: Fixture proving gate approval, rejection rollback, timeout denial, and audit log integrity.
//
// Setup: Test fixture exercising the full HITL protocol lifecycle across approval, rejection, and timeout paths.
//
// Beats:
//   1. Prove successful step-pause approval gate authorization and atomic side effect commit.
//   2. Prove rejection path triggering rollback and preventing unauthorized effect execution.
//   3. Prove timeout path enforcing fail-closed default-deny on expired operator authorization.
//   4. Prove single-use token replay prevention and complete audit log integrity.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "src/ooda/hitl/hitl.oo";

pub fn verify_hitl_approval_and_commit() -> Bool {
    let policy: HitlPolicy = hitl_policy_strict("pol_prod_strict");
    let mut sess: HitlSession = hitl_harness_init("sess_test_01", "operator_alice", policy);

    // 1. Add destructive database migration gate with 5000ms timeout
    sess = hitl_harness_add_gate(
        sess, "gate_db_migrate", "Production DB Migration", "SCHEMA_MIGRATE",
        "db://prod/primary", 5000, true, false
    );

    // 2. Request step-pause for destructive schema change
    sess = hitl_harness_request_step(
        sess, "act_drop_old_index", "gate_db_migrate", "Drop Deprecated Index",
        "ALTER TABLE users DROP INDEX idx_legacy;", "HIGH", true, false, 10000
    );
    let paused_1: Bool = sess.is_paused;
    if !paused_1 { return false; }

    // 3. Operator approves at 10000 + 1200ms (within 5000ms timeout)
    sess = hitl_harness_submit_decision(
        sess, "act_drop_old_index", true, "Migration plan reviewed and approved",
        11200, 1200
    );
    let paused_2: Bool = sess.is_paused;
    if paused_2 { return false; }

    let tok_res: Result[String, String] = hitl_harness_get_token(sess, "act_drop_old_index", 11200);
    if tok_res.is_err() { return false; }
    let token_raw: String = tok_res.unwrap();
    let token: HitlToken = hitl_token_parse(token_raw);
    let val_tok: Bool = token.is_valid;
    let cons_tok: Bool = token.is_consumed;
    if !val_tok || cons_tok { return false; }

    // 4. Commit effect with single-use token
    sess = hitl_harness_commit_effect(
        sess, token, "act_drop_old_index", 11250
    );
    let act: PauseAction = hitl_session_find_action(sess, "act_drop_old_index");
    let aid_len: Int = chars_len(act.action_id);
    let st: String = act.status;
    if aid_len == 0 || st != "COMMITTED" { return false; }

    // 5. Replay prevention: reusing consumed token must fail
    let consumed_tok: HitlToken = hitl_gate_consume_token(token);
    let replay_check: Result[Bool, String] = hitl_gate_validate_token(consumed_tok, "gate_db_migrate", 11300);
    if replay_check.is_ok() { return false; }

    println("GATE_APPROVAL_COMMIT_OK");
    println("REPLAY_PREVENTION_OK");
    return true;
}

pub fn verify_hitl_rejection_and_rollback() -> Bool {
    let policy: HitlPolicy = hitl_policy_strict("pol_rollback_strict");
    let mut sess: HitlSession = hitl_harness_init("sess_test_02", "operator_bob", policy);

    // 1. Add external webhook dispatch gate
    sess = hitl_harness_add_gate(
        sess, "gate_ext_webhook", "External Webhook Broadcast", "DISPATCH_WEBHOOK",
        "https://api.external.com/notify", 4000, false, true
    );

    // 2. Request step-pause for external dispatch
    sess = hitl_harness_request_step(
        sess, "act_dispatch_webhook", "gate_ext_webhook", "Broadcast Webhook",
        "{\"event\":\"billing_reset\"}", "MEDIUM", false, true, 20000
    );
    let paused_1: Bool = sess.is_paused;
    if !paused_1 { return false; }

    // 3. Operator rejects due to untrusted payload
    sess = hitl_harness_submit_decision(
        sess, "act_dispatch_webhook", false, "Untrusted payload format detected",
        20600, 600
    );
    let paused_2: Bool = sess.is_paused;
    if paused_2 { return false; }

    let tok_res: Result[String, String] = hitl_harness_get_token(sess, "act_dispatch_webhook", 20600);
    if tok_res.is_ok() { return false; }

    // 4. Verify action transitioned to ROLLED_BACK
    let act: PauseAction = hitl_session_find_action(sess, "act_dispatch_webhook");
    let aid_len: Int = chars_len(act.action_id);
    let st: String = act.status;
    if aid_len == 0 || st != "ROLLED_BACK" { return false; }

    println("REJECTION_ROLLBACK_OK");
    return true;
}

pub fn verify_hitl_timeout_denial() -> Bool {
    let policy: HitlPolicy = hitl_policy_strict("pol_timeout_strict");
    let mut sess: HitlSession = hitl_harness_init("sess_test_03", "operator_charlie", policy);

    // 1. Add sensitive credential rotation gate with short 1500ms timeout
    sess = hitl_harness_add_gate(
        sess, "gate_key_rotate", "KMS Key Rotation", "ROTATE_KEY",
        "kms://vault/root_key", 1500, true, true
    );

    // 2. Request step-pause for key rotation
    sess = hitl_harness_request_step(
        sess, "act_rotate_keys", "gate_key_rotate", "Rotate Vault Keys",
        "ROTATE_ROOT_KMS_KEY", "CRITICAL", true, true, 30000
    );

    // 3. Operator attempts to approve after 3200ms (> 1500ms timeout)
    sess = hitl_harness_submit_decision(
        sess, "act_rotate_keys", true, "Delayed approval",
        33200, 3200
    );

    let tok_res: Result[String, String] = hitl_harness_get_token(sess, "act_rotate_keys", 33200);
    if tok_res.is_ok() { return false; }

    // 4. Verify action transitioned to TIMEOUT_DENIED
    let act: PauseAction = hitl_session_find_action(sess, "act_rotate_keys");
    let aid_len: Int = chars_len(act.action_id);
    let st: String = act.status;
    if aid_len == 0 || st != "TIMEOUT_DENIED" { return false; }

    println("TIMEOUT_DENIAL_OK");
    return true;
}

pub fn verify_hitl_audit_integrity_suite() -> Bool {
    let policy: HitlPolicy = hitl_policy_default("pol_audit_test");
    let mut sess: HitlSession = hitl_harness_init("sess_audit_04", "operator_auditor", policy);

    sess = hitl_harness_add_gate(
        sess, "gate_log_purge", "Log Purge Gate", "PURGE_LOGS",
        "fs:///var/log/app", 3000, true, false
    );

    sess = hitl_harness_request_step(
        sess, "act_purge_old", "gate_log_purge", "Purge 90d Logs",
        "rm /var/log/app/*.old", "MEDIUM", true, false, 40000
    );

    sess = hitl_harness_submit_decision(
        sess, "act_purge_old", true, "Audit compliance retention verified",
        41000, 1000
    );

    let tok_res: Result[String, String] = hitl_harness_get_token(sess, "act_purge_old", 41000);
    if tok_res.is_err() { return false; }
    let tok_raw: String = tok_res.unwrap();
    let tok: HitlToken = hitl_token_parse(tok_raw);

    sess = hitl_harness_commit_effect(
        sess, tok, "act_purge_old", 41200
    );

    let audit_res: Result[Bool, String] = hitl_harness_verify_audit(sess);
    if audit_res.is_err() { return false; }

    let summary: String = hitl_harness_audit_summary(sess);
    if chars_len(summary) == 0 { return false; }

    println("AUDIT_LOG_INTEGRITY_OK");
    return true;
}

pub fn main() {
    if !verify_hitl_approval_and_commit() {
        println("FAIL: verify_hitl_approval_and_commit");
        process_exit(1);
    }
    if !verify_hitl_rejection_and_rollback() {
        println("FAIL: verify_hitl_rejection_and_rollback");
        process_exit(1);
    }
    if !verify_hitl_timeout_denial() {
        println("FAIL: verify_hitl_timeout_denial");
        process_exit(1);
    }
    if !verify_hitl_audit_integrity_suite() {
        println("FAIL: verify_hitl_audit_integrity_suite");
        process_exit(1);
    }

    println("HITL_FIXTURE_ALL_PASSED");
}
