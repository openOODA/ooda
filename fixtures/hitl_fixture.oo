// # Human-in-the-Loop (HITL) Harness and Step-Pause Verification Fixture
//
// Logline: End-to-end integration fixture verifying approval, rejection rollback, timeout denial, and audit integrity.
//
// Setup: Initializes standard approval gates and tests the complete step-pause lifecycle with deterministic time steps.
//
// Beats:
//   1. Verify gate approval and effect commitment with valid token generation.
//   2. Verify operator rejection with automatic rollback status transition.
//   3. Verify gate timeout default-deny enforcement when decision exceeds threshold.
//   4. Verify tamper-evident audit record sequence and monotonic timestamp integrity.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "std/hitl.oo";

pub fn verify_hitl_approval_and_commit() -> Bool {
    let pol: HitlPolicy = hitl_policy_strict("pol_strict_01");
    let mut sess: HitlSession = std_hitl_session_create(
        "sess_test_01", "operator_alice", pol
    );

    sess = std_hitl_add_gate(
        sess, "gate_db_drop", "Database Drop Gate", "database:drop_table",
        "sql://prod_db/users", 5000, true, false
    );

    let act: PauseAction = pause_action_new(
        "act_drop_users", "gate_db_drop", "Drop Users Table",
        "digest_sha256_drop_users", "CRITICAL", true, false
    );
    sess = std_hitl_request_action(sess, act, 10000);

    if !sess.is_paused { return false; }

    sess = std_hitl_decide(
        sess, "act_drop_users", true, "Migration step verified",
        12000, 2000
    );

    if sess.is_paused { return false; }

    let tok_res: Result[String, String] = std_hitl_get_token(
        sess, "act_drop_users", 12000
    );
    if tok_res.is_err() { return false; }
    let tok_raw: String = tok_res.unwrap();
    let tok: HitlToken = hitl_token_parse(tok_raw);
    if !tok.is_valid { return false; }
    if tok.is_consumed { return false; }

    sess = std_hitl_commit(
        sess, tok, "act_drop_users", 12500
    );

    let committed_action: PauseAction = hitl_session_find_action(sess, "act_drop_users");
    let act_status: String = committed_action.status;
    let expected_status: String = "COMMITTED";
    if !(act_status == expected_status) { return false; }

    return true;
}

pub fn verify_hitl_rejection_and_rollback() -> Bool {
    let pol: HitlPolicy = hitl_policy_strict("pol_strict_02");
    let mut sess: HitlSession = std_hitl_session_create(
        "sess_test_02", "operator_bob", pol
    );

    sess = std_hitl_add_gate(
        sess, "gate_fund_xfer", "Fund Transfer Gate", "bank:wire_transfer",
        "swift://central_bank/acc_99", 10000, true, true
    );

    let act: PauseAction = pause_action_new(
        "act_xfer_1m", "gate_fund_xfer", "Transfer $1,000,000",
        "digest_sha256_xfer_1m", "CRITICAL", true, true
    );
    sess = std_hitl_request_action(sess, act, 20000);

    if !sess.is_paused { return false; }

    sess = std_hitl_decide(
        sess, "act_xfer_1m", false, "Unrecognized destination SWIFT code",
        21000, 1000
    );

    let rejected_action: PauseAction = hitl_session_find_action(sess, "act_xfer_1m");
    let act_status: String = rejected_action.status;
    let expected_status: String = "ROLLED_BACK";
    if !(act_status == expected_status) { return false; }

    let tok_res: Result[String, String] = std_hitl_get_token(
        sess, "act_xfer_1m", 21000
    );
    if !tok_res.is_err() { return false; }

    return true;
}

pub fn verify_hitl_timeout_denial() -> Bool {
    let pol: HitlPolicy = hitl_policy_strict("pol_strict_03");
    let mut sess: HitlSession = std_hitl_session_create(
        "sess_test_03", "operator_charlie", pol
    );

    sess = std_hitl_add_gate(
        sess, "gate_reboot", "Server Reboot Gate", "sys:host_reboot",
        "node://cluster_node_7", 3000, true, false
    );

    let act: PauseAction = pause_action_new(
        "act_reboot_node", "gate_reboot", "Reboot Node 7",
        "digest_sha256_reboot", "HIGH", true, false
    );
    sess = std_hitl_request_action(sess, act, 30000);

    if !sess.is_paused { return false; }

    sess = std_hitl_decide(
        sess, "act_reboot_node", true, "Late approval",
        35000, 5000
    );

    let denied_action: PauseAction = hitl_session_find_action(sess, "act_reboot_node");
    let act_status: String = denied_action.status;
    let expected_status: String = "TIMEOUT_DENIED";
    if !(act_status == expected_status) { return false; }

    let tok_res: Result[String, String] = std_hitl_get_token(
        sess, "act_reboot_node", 35000
    );
    if !tok_res.is_err() { return false; }

    return true;
}

pub fn verify_hitl_audit_integrity_suite() -> Bool {
    let pol: HitlPolicy = hitl_policy_strict("pol_strict_04");
    let mut sess: HitlSession = std_hitl_session_create(
        "sess_test_04", "operator_dave", pol
    );

    sess = std_hitl_add_gate(
        sess, "gate_purge", "Data Purge Gate", "fs:purge_records",
        "file:///var/log/audit", 5000, true, false
    );

    let act: PauseAction = pause_action_new(
        "act_purge_old", "gate_purge", "Purge 2024 Audit Logs",
        "digest_sha256_purge", "HIGH", true, false
    );
    sess = std_hitl_request_action(sess, act, 40000);

    sess = std_hitl_decide(
        sess, "act_purge_old", true, "Annual retention cycle",
        41000, 1000
    );

    let tok_res: Result[String, String] = std_hitl_get_token(sess, "act_purge_old", 41000);
    if tok_res.is_err() { return false; }
    let tok_raw: String = tok_res.unwrap();
    let tok: HitlToken = hitl_token_parse(tok_raw);

    sess = std_hitl_commit(
        sess, tok, "act_purge_old", 41200
    );

    let audit_res: Result[Bool, String] = std_hitl_verify_audit(sess);
    if audit_res.is_err() { return false; }

    let summary: String = std_hitl_audit_summary(sess);
    if chars_len(summary) == 0 { return false; }

    return true;
}

pub fn main() {
    if !verify_hitl_approval_and_commit() {
        println("FAIL: verify_hitl_approval_and_commit");
        process_exit(1);
    }
    if !verify_hitl_rejection_and_rollback() {
        println("FAIL: verify_hitl_rejection_and_rollback");
        process_exit(1);
    }
    if !verify_hitl_timeout_denial() {
        println("FAIL: verify_hitl_timeout_denial");
        process_exit(1);
    }
    if !verify_hitl_audit_integrity_suite() {
        println("FAIL: verify_hitl_audit_integrity_suite");
        process_exit(1);
    }

    println("HITL_FIXTURE_ALL_PASSED");
}
