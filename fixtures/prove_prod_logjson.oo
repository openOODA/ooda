// # Product diag structured json log prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/logger_structured_json.oo.
//
// Setup: Product std/diag/logger_structured_json.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. log_json_info hi is the JSON object.
//   2. log_json_error uses ERROR.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/logger_structured_json.oo";

pub fn main() {
    let s: String = log_json_info("hi");
    if s != "{\"level\":\"INFO\",\"target\":\"app\",\"message\":\"hi\"}" {
        println("FAIL logjson info");
        process_exit(1);
    }
    let e: String = log_json_error("boom");
    if e != "{\"level\":\"ERROR\",\"target\":\"app\",\"message\":\"boom\"}" {
        println("FAIL logjson error");
        process_exit(1);
    }
    println("prod_logjson: PASSED");
}
