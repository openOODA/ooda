// # Product prove std/graph_networks/flajolet_martin_distinct.oo
//
// Logline: Fail-closed emit+gcc+run asserts fm_pow2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/flajolet_martin_distinct.oo.
//
// Beats:
//   1. Call fm_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_flajolet_martin_distinct: PASSED only if they match.

import "std/graph_networks/flajolet_martin_distinct.oo";

pub fn main() {
    let flajolet_martin_distinct_mark: Int = 0;
    if flajolet_martin_distinct_mark != 0 {
        process_exit(1);
    }
    let a: Int = fm_pow2(0);
    let b: Int = fm_pow2(0);
    if a != b {
        println("FAIL fm_pow2");
        process_exit(1);
    }
    println("prod_g2_flajolet_martin_distinct: PASSED");
}
