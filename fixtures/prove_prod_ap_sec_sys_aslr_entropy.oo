// # Product prove std/sec/sys/aslr_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/aslr_entropy.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_entropy.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aslr_entropy: PASSED only if they match.

import "std/sec/sys/aslr_entropy.oo";

pub fn main() {
    let aslr_entropy_a = aslr_compute_entropy(0);
    let aslr_entropy_b = aslr_compute_entropy(0);
    if aslr_entropy_a != aslr_entropy_b {
        println("FAIL aslr_entropy");
        process_exit(1);
    }
    println("prod_ap_aslr_entropy: PASSED");
}
