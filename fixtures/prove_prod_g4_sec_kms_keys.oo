// # Product prove std/sec/crypto/kms_keys.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kms_keys.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_keys.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_kms_keys: PASSED and exit 0 only on match.

import "std/sec/crypto/kms_keys.oo";

pub fn main() {
    let pol: KmsKeyPolicy = kms_key_policy_create("pol_1", "ENCRYPT,DECRYPT", 1000, false, true, 90, true);

    let key_res_a: Result[KmsKey, String] = kms_key_create(
        "key_01",
        "arn:aws:kms:us-east-1:123456789012:key/key_01",
        "AES_256_GCM",
        pol,
        "01234567890123456789012345678901",
        1700000000
    );
    let key_res_b: Result[KmsKey, String] = kms_key_create(
        "key_01",
        "arn:aws:kms:us-east-1:123456789012:key/key_01",
        "AES_256_GCM",
        pol,
        "01234567890123456789012345678901",
        1700000000
    );

    let mut key_a: KmsKey = match key_res_a {
        Ok(k) => k,
        Err(_) => {
            println("FAIL kms_keys key_create a");
            process_exit(1);
        },
    };
    let mut key_b: KmsKey = match key_res_b {
        Ok(k) => k,
        Err(_) => {
            println("FAIL kms_keys key_create b");
            process_exit(1);
        },
    };

    let valid_a: Bool = kms_key_validate(&key_a);
    let valid_b: Bool = kms_key_validate(&key_b);
    if !valid_a || !valid_b {
        println("FAIL kms_keys key_validate");
        process_exit(1);
    }

    let rot_res_a: Result[KmsKeyRotation, String] = kms_key_rotate(&mut key_a, "scheduled_rotation", 1700086400);
    let rot_res_b: Result[KmsKeyRotation, String] = kms_key_rotate(&mut key_b, "scheduled_rotation", 1700086400);
    let rot_a: KmsKeyRotation = match rot_res_a {
        Ok(r) => r,
        Err(_) => {
            println("FAIL kms_keys key_rotate a");
            process_exit(1);
        },
    };
    let rot_b: KmsKeyRotation = match rot_res_b {
        Ok(r) => r,
        Err(_) => {
            println("FAIL kms_keys key_rotate b");
            process_exit(1);
        },
    };
    if (rot_a).new_version != (rot_b).new_version || (rot_a).new_version != 2 {
        println("FAIL kms_keys rotation new_version");
        process_exit(1);
    }

    kms_key_disable(&mut key_a);
    if (key_a).is_enabled {
        println("FAIL kms_keys key_disable");
        process_exit(1);
    }

    kms_key_enable(&mut key_a);
    if !(key_a).is_enabled {
        println("FAIL kms_keys key_enable");
        process_exit(1);
    }

    kms_key_destroy(&mut key_a);
    if !(key_a).is_destroyed {
        println("FAIL kms_keys key_destroy");
        process_exit(1);
    }

    let grant_res_a: Result[KmsGrant, String] = kms_grant_create(
        "grant_01",
        "key_01",
        "arn:aws:iam::123456789012:role/AppRole",
        "ENCRYPT,DECRYPT",
        1700000000,
        3600
    );
    let mut grant_a: KmsGrant = match grant_res_a {
        Ok(g) => g,
        Err(_) => {
            println("FAIL kms_keys grant_create");
            process_exit(1);
        },
    };

    let g_valid: Bool = kms_grant_is_valid(&grant_a, 1700001000);
    if !g_valid {
        println("FAIL kms_keys grant_is_valid");
        process_exit(1);
    }

    kms_grant_revoke(&mut grant_a);
    let g_revoked_valid: Bool = kms_grant_is_valid(&grant_a, 1700001000);
    if g_revoked_valid {
        println("FAIL kms_keys grant_revoke");
        process_exit(1);
    }

    println("prod_g4_sec_kms_keys: PASSED");
    process_exit(0);
}
