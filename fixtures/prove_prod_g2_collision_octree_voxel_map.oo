// # Product prove std/robotics_ros2/collision_octree_voxel_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts octree_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/collision_octree_voxel_map.oo.
//
// Beats:
//   1. Call octree_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_collision_octree_voxel_map: PASSED only if they match.

import "std/robotics_ros2/collision_octree_voxel_map.oo";

pub fn main() {
    let collision_octree_voxel_map_mark: Int = 0;
    if collision_octree_voxel_map_mark != 0 {
        process_exit(1);
    }
    let a: OctreeNode = octree_node_new(0.0, 0.0, 0.0, 0.0);
    let b: OctreeNode = octree_node_new(0.0, 0.0, 0.0, 0.0);
    if (a).child_mask != (b).child_mask {
        println("FAIL octree_node_new");
        process_exit(1);
    }
    println("prod_g2_collision_octree_voxel_map: PASSED");
}
