// # Product prove std/graph_networks/quotient_filter_compact.oo
//
// Logline: Fail-closed emit+gcc+run asserts qf_power_of_two is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/quotient_filter_compact.oo.
//
// Beats:
//   1. Call qf_power_of_two twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quotient_filter_compact: PASSED only if they match.

import "std/graph_networks/quotient_filter_compact.oo";

pub fn main() {
    let quotient_filter_compact_mark: Int = 0;
    if quotient_filter_compact_mark != 0 {
        process_exit(1);
    }
    let a: Int = qf_power_of_two(0);
    let b: Int = qf_power_of_two(0);
    if a != b {
        println("FAIL qf_power_of_two");
        process_exit(1);
    }
    println("prod_g2_quotient_filter_compact: PASSED");
}
