// # Product prove std/bio_advanced/variant_effect_predictor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/variant_effect_predictor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/variant_effect_predictor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_variant_effect_predictor: PASSED only if they match.

import "std/bio_advanced/variant_effect_predictor.oo";

pub fn main() {
    let variant_effect_predictor_a = vep_impact_high();
    let variant_effect_predictor_b = vep_impact_high();
    if variant_effect_predictor_a.contains(variant_effect_predictor_b) == false {
        println("FAIL variant_effect_predictor");
        process_exit(1);
    }
    if variant_effect_predictor_b.contains(variant_effect_predictor_a) == false {
        println("FAIL variant_effect_predictor");
        process_exit(1);
    }
    println("prod_ap_variant_effect_predictor: PASSED");
}
