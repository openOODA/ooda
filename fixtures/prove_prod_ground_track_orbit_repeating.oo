// # Product prove std/astro_advanced/ground_track_orbit_repeating.oo
//
// Logline: Fail-closed emit+gcc+run asserts repeat_revs is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/ground_track_orbit_repeating.oo.
//
// Beats:
//   1. Call repeat_revs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ground_track_orbit_repeating: PASSED only if they match.

import "std/astro_advanced/ground_track_orbit_repeating.oo";

pub fn main() {
    let a = repeat_revs();
    let b = repeat_revs();
    if a != b {
        println("FAIL repeat_revs");
        process_exit(1);
    }
    println("prod_ground_track_orbit_repeating: PASSED");
}
