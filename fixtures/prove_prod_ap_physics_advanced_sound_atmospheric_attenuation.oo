// # Product prove std/physics_advanced/sound_atmospheric_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/sound_atmospheric_attenuation.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/sound_atmospheric_attenuation.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_sound_atmospheric_attenuation: PASSED only if they match.

import "std/physics_advanced/sound_atmospheric_attenuation.oo";

pub fn main() {
    let sound_atmospheric_attenuation_a = atmospheric_standard_isa();
    let sound_atmospheric_attenuation_b = atmospheric_standard_isa();
    if sound_atmospheric_attenuation_a.temperature_kelvin != sound_atmospheric_attenuation_b.temperature_kelvin {
        println("FAIL sound_atmospheric_attenuation");
        process_exit(1);
    }
    println("prod_ap_sound_atmospheric_attenuation: PASSED");
}
