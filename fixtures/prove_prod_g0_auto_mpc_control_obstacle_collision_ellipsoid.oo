// # Product prove std/auto_mpc_control/obstacle_collision_ellipsoid.oo
//
// Logline: Fail-closed emit+gcc+run asserts ObstacleEllipse is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/obstacle_collision_ellipsoid.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ObstacleEllipse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_obstacle_collision_ellipsoid: PASSED only if they match.

import "std/auto_mpc_control/obstacle_collision_ellipsoid.oo";

pub fn main() {
    let g0_oa: ObstacleEllipse = ObstacleEllipse { center_x:1.0, center_y:1.0, semi_axis_a:1.0, semi_axis_b:1.0, yaw_angle:1.0 };
    let g0_ob: ObstacleEllipse = ObstacleEllipse { center_x:1.0, center_y:1.0, semi_axis_a:1.0, semi_axis_b:1.0, yaw_angle:1.0 };
    let g0_a = (g0_oa).center_x;
    let g0_b = (g0_ob).center_x;
    if g0_a != g0_b {
        println("FAIL ObstacleEllipse.center_x");
        process_exit(1);
    }
    println("prod_g0_obstacle_collision_ellipsoid: PASSED");
}
