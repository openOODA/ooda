// # Allow an untagged maker at println
//
// Logline: An untagged helper that returns a constant is allowed at the sink.
//
// Beats:
//   1. Return a public literal from safe_make.
//   2. Tag api_key at line start in main.
//   3. Print the helper result so the sink stays allowed.

// T1 function return clean: untagged helper returns constant; sink allow
// SECRET: api_key
pub fn safe_make() -> String {
    return "public";
}
pub fn main() {
    let api_key = "x";
    let y = safe_make();
    println(y);
}
