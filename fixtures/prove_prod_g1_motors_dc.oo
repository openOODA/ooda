// # Product prove std/robot/motors_dc.oo
//
// Logline: Fail-closed emit+gcc+run asserts dc_motor_get_duty is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/motors_dc.oo.
//
// Beats:
//   1. Call dc_motor_get_duty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_motors_dc: PASSED only if they match.

import "std/robot/motors_dc.oo";

pub fn main() {
    let obj_a: DcMotor = dc_motor_init(0, 0.0, 0.0, 0.0, 0.0);
    let obj_b: DcMotor = dc_motor_init(0, 0.0, 0.0, 0.0, 0.0);
    let a: Float = dc_motor_get_duty(obj_a);
    let b: Float = dc_motor_get_duty(obj_b);
    if a != b {
        println("FAIL dc_motor_get_duty");
        process_exit(1);
    }
    println("prod_motors_dc: PASSED");
}
