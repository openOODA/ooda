// # Product quaternion prove
//
// Logline: Fail-closed emit+gcc+run of shipped quat_identity/add.
//
// Setup: Product std/math/quaternion.oo. Identity w=1; add components.
//
// Beats:
//   1. quat_identity w is 1.0.
//   2. (1,2,3,4)+(1,0,0,0) w is 2.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/quaternion.oo";

pub fn main() {
    let q: Quaternion = quat_identity();
    let w: Float = q.w;
    if w != 1.0 {
        println("FAIL quat id");
        process_exit(1);
    }
    let a: Quaternion = quat_new(1.0, 2.0, 3.0, 4.0);
    let b: Quaternion = quat_new(1.0, 0.0, 0.0, 0.0);
    let s: Quaternion = quat_add(a, b);
    let sw: Float = s.w;
    if sw != 2.0 {
        println("FAIL quat add");
        process_exit(1);
    }
    println("prod_quat: PASSED");
}
