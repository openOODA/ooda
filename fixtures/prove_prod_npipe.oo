// # Product named pipe descriptor prove
//
// Logline: Fail-closed emit+gcc+run of shipped named_pipe_desc_new/path/mode.
//
// Setup: Product std/io/pipe_named_stub.oo. Descriptor only; no mkfifo.
//
// Beats:
//   1. Path fifo; mode 1 is valid; mode 0 is not.
//   2. Exit 1 before PASSED on a miss.

import "std/io/pipe_named_stub.oo";

pub fn main() {
    let d: NamedPipeDesc = named_pipe_desc_new("fifo", 1);
    let p: String = named_pipe_get_path(d);
    if p != "fifo" {
        println("FAIL npipe path");
        process_exit(1);
    }
    let ok: Bool = named_pipe_is_valid_mode(d);
    if ok == false {
        println("FAIL npipe mode1");
        process_exit(1);
    }
    let bad: NamedPipeDesc = named_pipe_desc_new("fifo", 0);
    let no: Bool = named_pipe_is_valid_mode(bad);
    if no == true {
        println("FAIL npipe mode0");
        process_exit(1);
    }
    println("prod_npipe: PASSED");
}
