// # Product prove std/fin/var_stubs.oo
//
// Logline: Fail-closed verification that value-at-risk stubs module imports and risk calculation results are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_stubs.oo.
//
// Beats:
//   1. Construct VarResult instances across normal and breached risk thresholds.
//   2. Extract basis points risk metrics and verify horizon parameters.
//   3. Assert deterministic results.
//   4. Print prod_g4_fin_var_stubs: PASSED and exit 0.

import "std/fin/var_stubs.oo";

pub fn main() {
    let res_a: VarResult = var_result_new(250, 10, 0);
    let res_b: VarResult = var_result_new(250, 10, 0);
    if (res_a).var_bps != (res_b).var_bps || (res_a).horizon_days != (res_b).horizon_days {
        println("FAIL var_result_new deterministic");
        process_exit(1);
    }
    if (res_a).is_breached != 0 {
        println("FAIL var_result_new breached flag");
        process_exit(1);
    }

    let bps_a: Int = var_result_bps(res_a);
    let bps_b: Int = var_result_bps(res_b);
    if bps_a != bps_b || bps_a != 250 {
        println("FAIL var_result_bps");
        process_exit(1);
    }

    let res_breach: VarResult = var_result_new(850, 1, 1);
    let bps_breach: Int = var_result_bps(res_breach);
    if (res_breach).is_breached != 1 || bps_breach != 850 {
        println("FAIL var_result breached");
        process_exit(1);
    }

    println("prod_g4_fin_var_stubs: PASSED");
    process_exit(0);
}
