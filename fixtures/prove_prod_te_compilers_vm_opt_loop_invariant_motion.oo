// # Product prove std/compilers_vm/opt_loop_invariant_motion.oo
//
// Logline: Fail-closed emit+gcc+run asserts is_instruction_speculative_safe is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_loop_invariant_motion.oo.
//
// Beats:
//   1. Call is_instruction_speculative_safe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opt_loop_invariant_motion: PASSED only if they match.

import "std/compilers_vm/opt_loop_invariant_motion.oo";

pub fn main() {
    let opt_loop_invariant_motion_mark: Int = 0;
    if opt_loop_invariant_motion_mark != 0 {
        process_exit(1);
    }
    let a: Int = is_instruction_speculative_safe(0);
    let b: Int = is_instruction_speculative_safe(0);
    if a != b {
        println("FAIL is_instruction_speculative_safe");
        process_exit(1);
    }
    println("prod_opt_loop_invariant_motion: PASSED");
}
