// # Product prove std/telecom_6g/ris_simultaneous_trans_reflect.oo
//
// Logline: Fail-closed emit+gcc+run asserts star_ris_config_mode_switching is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_simultaneous_trans_reflect.oo.
//
// Beats:
//   1. Call star_ris_config_mode_switching twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ris_simultaneous_trans_reflect: PASSED only if they match.

import "std/telecom_6g/ris_simultaneous_trans_reflect.oo";

pub fn main() {
    let ris_simultaneous_trans_reflect_mark: Int = 0;
    if ris_simultaneous_trans_reflect_mark != 0 {
        process_exit(1);
    }
    let ris_simultaneous_trans_reflect_a = star_ris_config_mode_switching();
    let ris_simultaneous_trans_reflect_b = star_ris_config_mode_switching();
    if (ris_simultaneous_trans_reflect_a).num_elements != (ris_simultaneous_trans_reflect_b).num_elements {
        println("FAIL star_ris_config_mode_switching");
        process_exit(1);
    }
    println("prod_ris_simultaneous_trans_reflect: PASSED");
}
