// # Product prove std/bft_consensus/mempool_gossip_disseminator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/mempool_gossip_disseminator.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/mempool_gossip_disseminator.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_mempool_gossip_disseminator: PASSED only if they match.

import "std/bft_consensus/mempool_gossip_disseminator.oo";

pub fn main() {
    let mempool_gossip_disseminator_a = gossip_disseminator_new(0);
    let mempool_gossip_disseminator_b = gossip_disseminator_new(0);
    if mempool_gossip_disseminator_a.peer_count != mempool_gossip_disseminator_b.peer_count {
        println("FAIL mempool_gossip_disseminator");
        process_exit(1);
    }
    println("prod_ap_mempool_gossip_disseminator: PASSED");
}
