// # Product prove std/simd/simd_vec4f.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec4f_hadd is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_vec4f.oo.
//
// Beats:
//   1. Call vec4f_hadd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_vec4f: PASSED only if they match.

import "std/simd/simd_vec4f.oo";

pub fn main() {
    let obj = vec4f_new(0.0, 0.0, 0.0, 0.0);
    let a = vec4f_hadd(obj);
    let b = vec4f_hadd(obj);
    if a != b {
        println("FAIL vec4f_hadd");
        process_exit(1);
    }
    println("prod_simd_vec4f: PASSED");
}
