// # Product prove std/markup/json_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/json_stream.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_stream.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_json_stream: PASSED only if they match.

import "std/markup/json_stream.oo";

pub fn main() {
    let json_stream_a = json_stream_new("x");
    let json_stream_b = json_stream_new("x");
    let json_stream_va = json_stream_has_next(json_stream_a);
    let json_stream_vb = json_stream_has_next(json_stream_b);
    if json_stream_va != json_stream_vb {
        println("FAIL json_stream");
        process_exit(1);
    }
    println("prod_ap_json_stream: PASSED");
}
