// # Product prove std/fs/path.oo
//
// Logline: Fail-closed emit+gcc+run asserts path_is_absolute is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/path.oo.
//
// Beats:
//   1. Call path_is_absolute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path: PASSED only if they match.

import "std/fs/path.oo";

pub fn main() {
    let a = path_is_absolute("x");
    let b = path_is_absolute("x");
    if a != b {
        println("FAIL path_is_absolute");
        process_exit(1);
    }
    println("prod_path: PASSED");
}
