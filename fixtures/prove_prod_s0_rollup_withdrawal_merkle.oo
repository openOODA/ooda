// # Product prove std/zk_rollup/rollup_withdrawal_merkle.oo
//
// Logline: Fail-closed emit+gcc+run asserts withdrawal_message_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_withdrawal_merkle.oo.
//
// Beats:
//   1. Call withdrawal_message_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rollup_withdrawal_merkle: PASSED only if asserts hold.

import "std/zk_rollup/rollup_withdrawal_merkle.oo";

pub fn main() {
    let rollup_withdrawal_merkle_a: WithdrawalMessage = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    let rollup_withdrawal_merkle_b: WithdrawalMessage = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    if rollup_withdrawal_merkle_a.withdrawal_id != rollup_withdrawal_merkle_b.withdrawal_id {
        println("FAIL withdrawal_message_new");
        process_exit(1);
    }
    println("prod_rollup_withdrawal_merkle: PASSED");
}
