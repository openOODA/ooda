// # Product prove std/sec/crypto/rsa_pss_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts rsa_pss_engine_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/rsa_pss_engine.oo.
//
// Beats:
//   1. Call rsa_pss_engine_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rsa_pss_engine: PASSED only if they match.

import "std/sec/crypto/rsa_pss_engine.oo";

pub fn main() {
    let a = rsa_pss_engine_ready();
    let b = rsa_pss_engine_ready();
    if a != b {
        println("FAIL rsa_pss_engine_ready");
        process_exit(1);
    }
    println("prod_rsa_pss_engine: PASSED");
}
