// # Product prove std/compilers_vm/opt_function_inlining.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_inlining_cost is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_function_inlining.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compute_inlining_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opt_function_inlining: PASSED only if they match.

import "std/compilers_vm/opt_function_inlining.oo";

pub fn main() {
    let g2_oa: FunctionSummary = FunctionSummary { fn_name: "x", instruction_count: 8, block_count: 8, has_loops: 2, has_indirect_calls: 2, is_always_inline: 2, is_never_inline: 2 };
    let g2_ob: FunctionSummary = FunctionSummary { fn_name: "x", instruction_count: 8, block_count: 8, has_loops: 2, has_indirect_calls: 2, is_always_inline: 2, is_never_inline: 2 };
    let g2_a = compute_inlining_cost(g2_oa, 8, 2);
    let g2_b = compute_inlining_cost(g2_ob, 8, 2);
    if g2_a != g2_b {
        println("FAIL compute_inlining_cost");
        process_exit(1);
    }
    println("prod_g2_opt_function_inlining: PASSED");
}
