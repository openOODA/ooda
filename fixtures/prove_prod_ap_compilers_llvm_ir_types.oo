// # Product prove std/compilers/llvm_ir_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/llvm_ir_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_llvm_ir_types: PASSED only if they match.

import "std/compilers/llvm_ir_types.oo";

pub fn main() {
    let llvm_ir_types_a = llvm_type_new(0, 0, 0);
    let llvm_ir_types_b = llvm_type_new(0, 0, 0);
    let llvm_ir_types_va = llvm_type_width(llvm_ir_types_a);
    let llvm_ir_types_vb = llvm_type_width(llvm_ir_types_b);
    if llvm_ir_types_va != llvm_ir_types_vb {
        println("FAIL llvm_ir_types");
        process_exit(1);
    }
    println("prod_ap_llvm_ir_types: PASSED");
}
