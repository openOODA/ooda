// # Product prove std/zk_rollup/merkle_patricia_trie_delete.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_empty_root value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_delete.oo.
//
// Beats:
//   1. Call mpt_empty_root twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_merkle_patricia_trie_delete: PASSED only if asserts hold.

import "std/zk_rollup/merkle_patricia_trie_delete.oo";

pub fn main() {
    let merkle_patricia_trie_delete_a: Int = mpt_empty_root();
    let merkle_patricia_trie_delete_b: Int = mpt_empty_root();
    if merkle_patricia_trie_delete_a != merkle_patricia_trie_delete_b {
        println("FAIL mpt_empty_root");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_delete: PASSED");
}
