// # Product prove std/zk_rollup/plonk_permutation_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/plonk_permutation_argument.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_permutation_argument.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plonk_permutation_argument: PASSED only if they match.

import "std/zk_rollup/plonk_permutation_argument.oo";

pub fn main() {
    let plonk_permutation_argument_a = plonk_permutation_state_new(0, 0, 0, 0);
    let plonk_permutation_argument_b = plonk_permutation_state_new(0, 0, 0, 0);
    let plonk_permutation_argument_va = plonk_compute_grand_product_step(plonk_permutation_argument_a, 0, 0, 0, 0, 0, 0);
    let plonk_permutation_argument_vb = plonk_compute_grand_product_step(plonk_permutation_argument_b, 0, 0, 0, 0, 0, 0);
    if plonk_permutation_argument_va != plonk_permutation_argument_vb {
        println("FAIL plonk_permutation_argument");
        process_exit(1);
    }
    println("prod_ap_plonk_permutation_argument: PASSED");
}
