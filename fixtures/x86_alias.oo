// # emit-x86 string let alias
//
// Logline: Bind a to hi, bind b to a, and print b so emit-x86 can lower a same-fn string alias.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind a to hi and b to a.
//   3. Print b.
//
// residual: greet calls stay later.

pub fn main() {
    let a = "hi";
    let b = a;
    println(b);
}
