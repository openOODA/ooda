// # Result[List[Int]] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[List[Int], String] Ok list get.
//
// Setup: Backend-C. Ok payload is List[Int], not a string.
//
// Beats:
//   1. xs returns Ok of a one-int list.
//   2. Match binds the list and list_get is 9.
//   3. Exit 1 before PASSED on a miss.

fn xs() -> Result[List[Int], String] {
    let mut a: List[Int] = list_new();
    a = list_push(a, 9);
    return Ok(a);
}

pub fn main() {
    let r: Result[List[Int], String] = xs();
    let a: List[Int] = match r {
        Ok(v) => v,
        Err(e) => list_new()
    };
    if list_get(a, 0) != 9 {
        println("FAIL");
        process_exit(1);
    }
    println("result_list_smoke: PASSED");
}
