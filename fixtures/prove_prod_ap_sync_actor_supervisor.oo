// # Product prove std/sync/actor_supervisor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/actor_supervisor.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/actor_supervisor.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_actor_supervisor: PASSED only if they match.

import "std/sync/actor_supervisor.oo";

pub fn main() {
    let actor_supervisor_a = actor_sup_create(0, 0);
    let actor_supervisor_b = actor_sup_create(0, 0);
    if actor_supervisor_a.strategy != actor_supervisor_b.strategy {
        println("FAIL actor_supervisor");
        process_exit(1);
    }
    println("prod_ap_actor_supervisor: PASSED");
}
