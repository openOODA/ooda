// # Product prove std/satellite_dvb/satellite_scintillation_iono.oo
//
// Logline: Fail-closed emit+gcc+run asserts scintillation_s4_to_nakagami_m is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_scintillation_iono.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call scintillation_s4_to_nakagami_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_satellite_scintillation_iono: PASSED only if they match.

import "std/satellite_dvb/satellite_scintillation_iono.oo";

pub fn main() {
    let g0_a = scintillation_s4_to_nakagami_m(1.0);
    let g0_b = scintillation_s4_to_nakagami_m(1.0);
    if g0_a != g0_b {
        println("FAIL scintillation_s4_to_nakagami_m");
        process_exit(1);
    }
    println("prod_g0_satellite_scintillation_iono: PASSED");
}
