// # Product prove std/auto/lanelet_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts llt_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_engine.oo.
//
// Beats:
//   1. Call llt_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lanelet_engine: PASSED only if they match.

import "std/auto/lanelet_engine.oo";

pub fn main() {
    let lanelet_engine_mark: Int = 0;
    if lanelet_engine_mark != 0 {
        process_exit(1);
    }
    let a: LltEng = llt_eng_new(0, 0);
    let b: LltEng = llt_eng_new(0, 0);
    if (a).map_id != (b).map_id {
        println("FAIL llt_eng_new");
        process_exit(1);
    }
    println("prod_lanelet_engine: PASSED");
}
