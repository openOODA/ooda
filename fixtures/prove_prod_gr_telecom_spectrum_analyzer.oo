// # Product prove std/telecom/spectrum_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts spectrum_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/spectrum_analyzer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call spectrum_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_spectrum_analyzer: PASSED only if they match.

import "std/telecom/spectrum_analyzer.oo";

pub fn main() {
    let g0_a = spectrum_int_to_float(0);
    let g0_b = spectrum_int_to_float(0);
    if g0_a != g0_b {
        println("FAIL spectrum_int_to_float");
        process_exit(1);
    }
    println("prod_gr_spectrum_analyzer: PASSED");
}
