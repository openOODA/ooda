// # Product prove std/ai_ml/layer_embedding.oo
//
// Logline: Fail-closed verification that token embedding lookup and sinusoidal encoding are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_embedding.oo.
//
// Beats:
//   1. Construct EmbeddingTable and perform token lookup.
//   2. Generate analytical sinusoidal positional encodings.
//   3. Assert deterministic tensor shapes and contents.
//   4. Print prod_g4_aiml_layer_embedding: PASSED and exit 0.

import "std/ai_ml/layer_embedding.oo";

pub fn main() {
    let tbl: EmbeddingTable = embedding_table_new(50, 16);
    if (tbl).num_embeddings != 50 || (tbl).embedding_dim != 16 {
        println("FAIL embedding_table_new dims");
        process_exit(1);
    }

    let emb: Tensor1D = embedding_forward_lookup(&tbl, 5);
    if (emb).size != 16 {
        println("FAIL embedding_forward_lookup size");
        process_exit(1);
    }

    let pe_a: Tensor2D = positional_encoding_sinusoidal(8, 16);
    let pe_b: Tensor2D = positional_encoding_sinusoidal(8, 16);
    if (pe_a).rows != (pe_b).rows || (pe_a).cols != (pe_b).cols {
        println("FAIL positional_encoding_sinusoidal shape");
        process_exit(1);
    }
    if (pe_a).rows != 8 || (pe_a).cols != 16 {
        println("FAIL positional_encoding_sinusoidal dims");
        process_exit(1);
    }

    let mut token_ids: List[Int] = list_new();
    token_ids = list_push(token_ids, 0);
    token_ids = list_push(token_ids, 1);
    token_ids = list_push(token_ids, 2);
    let seq_emb: Tensor2D = embedding_forward_sequence(&tbl, token_ids);
    if (seq_emb).rows != 3 || (seq_emb).cols != 16 {
        println("FAIL embedding_forward_sequence");
        process_exit(1);
    }

    println("prod_g4_aiml_layer_embedding: PASSED");
    process_exit(0);
}
