// # Product prove std/game_engine/game_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts game_stub_render_clear is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/game_stubs.oo.
//
// Beats:
//   1. Call game_stub_render_clear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_game_stubs: PASSED only if they match.

import "std/game_engine/game_stubs.oo";

pub fn main() {
    let game_stubs_mark: Int = 0;
    if game_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = game_stub_render_clear();
    let b: Int = game_stub_render_clear();
    if a != b {
        println("FAIL game_stub_render_clear");
        process_exit(1);
    }
    println("prod_game_stubs: PASSED");
}
