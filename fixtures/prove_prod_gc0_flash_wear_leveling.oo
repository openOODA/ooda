// # Product prove std/embedded_hal/flash_wear_leveling.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_physical_block_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/flash_wear_leveling.oo.
//
// Beats:
//   1. Call flash_physical_block_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flash_wear_leveling: PASSED only if they match.

import "std/embedded_hal/flash_wear_leveling.oo";

pub fn main() {
    let flash_wear_leveling_mark: Int = 0;
    if flash_wear_leveling_mark != 0 {
        process_exit(1);
    }
    let flash_wear_leveling_a = flash_physical_block_new(1);
    let flash_wear_leveling_b = flash_physical_block_new(1);
    if (flash_wear_leveling_a).physical_id != (flash_wear_leveling_b).physical_id {
        println("FAIL flash_physical_block_new");
        process_exit(1);
    }
    println("prod_flash_wear_leveling: PASSED");
}
