// # Option[Float] Some(1.5) emit lock
//
// Logline: Fail-closed emit+gcc+run of Option[Float] mapped onto %OoResF sret.
//
// Setup: Backend-C. Some(1.5) must stay Float, not an int pun.
//
// Beats:
//   1. f returns Some(1.5) as Option[Float].
//   2. Match Some payload is 1.5; None is 0.0.
//   3. Exit 1 before PASSED on a miss.

fn f() -> Option[Float] {
    return Some(1.5);
}

pub fn main() {
    let a: Option[Float] = f();
    let va: Float = match a {
        Some(v) => v,
        None => 0.0
    };
    if va != 1.5 {
        println("FAIL some");
        process_exit(1);
    }
    let b: Option[Float] = None;
    let vb: Float = match b {
        Some(v) => 9.0,
        None => 0.0
    };
    if vb != 0.0 {
        println("FAIL none");
        process_exit(1);
    }
    println("option_float_smoke: PASSED");
}
