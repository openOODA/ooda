import "std/sec/crypto/secp256k1_engine.oo";

pub fn main() {
    let secp256k1_engine_mark: Int = 0;
    if secp256k1_engine_mark != 0 { process_exit(1); }
    let a: Result[EcdsaSignature, String] = ecdsa_signature_create("x", "x", "x", "x", 0, 0);
    let b: Result[EcdsaSignature, String] = ecdsa_signature_create("x", "x", "x", "x", 0, 0);
    if a != b { process_exit(1); }
    println("prod_secp256k1_engine: PASSED");
}
