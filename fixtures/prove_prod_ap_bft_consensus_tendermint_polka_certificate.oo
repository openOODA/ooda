// # Product prove std/bft_consensus/tendermint_polka_certificate.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/tendermint_polka_certificate.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_polka_certificate.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tendermint_polka_certificate: PASSED only if they match.

import "std/bft_consensus/tendermint_polka_certificate.oo";

pub fn main() {
    let tendermint_polka_certificate_a = polka_can_unlock(0, 0);
    let tendermint_polka_certificate_b = polka_can_unlock(0, 0);
    if tendermint_polka_certificate_a != tendermint_polka_certificate_b {
        println("FAIL tendermint_polka_certificate");
        process_exit(1);
    }
    println("prod_ap_tendermint_polka_certificate: PASSED");
}
