// # Product prove std/text/hex_dump_format.oo
//
// Logline: Fail-closed emit+gcc+run asserts hex_dump_byte is deterministic.
//
// Setup: Isolated emit-c. Imports std/text/hex_dump_format.oo.
//
// Beats:
//   1. Call hex_dump_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hex_dump_format: PASSED only if they match.

import "std/text/hex_dump_format.oo";
import "std/str.oo";

pub fn main() {
    let hex_dump_format_mark: Int = 0;
    if hex_dump_format_mark != 0 {
        process_exit(1);
    }
    let hex_dump_format_a: String = hex_dump_byte(1);
    let hex_dump_format_b: String = hex_dump_byte(1);
    if str_eq(hex_dump_format_a, hex_dump_format_b) == false {
        println("FAIL hex_dump_byte");
        process_exit(1);
    }
    println("prod_hex_dump_format: PASSED");
}
