// # Product prove std/gis_spatial/wgs84_coords.oo
//
// Logline: Fail-closed emit+gcc+run asserts wgs84_math_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/wgs84_coords.oo.
//
// Beats:
//   1. Call wgs84_math_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wgs84_coords: PASSED only if they match.

import "std/gis_spatial/wgs84_coords.oo";

pub fn main() {
    let wgs84_coords_mark: Int = 0;
    if wgs84_coords_mark != 0 {
        process_exit(1);
    }
    let a: Float = wgs84_math_pi();
    let b: Float = wgs84_math_pi();
    if a != b {
        println("FAIL wgs84_math_pi");
        process_exit(1);
    }
    println("prod_wgs84_coords: PASSED");
}
