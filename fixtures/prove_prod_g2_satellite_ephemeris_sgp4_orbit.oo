// # Product prove std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo
//
// Logline: Fail-closed emit+gcc+run asserts kepler_solve_eccentric_anomaly_rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo.
//
// Beats:
//   1. Call kepler_solve_eccentric_anomaly_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_ephemeris_sgp4_orbit: PASSED only if they match.

import "std/satellite_dvb/satellite_ephemeris_sgp4_orbit.oo";

pub fn main() {
    let satellite_ephemeris_sgp4_orbit_mark: Int = 0;
    if satellite_ephemeris_sgp4_orbit_mark != 0 {
        process_exit(1);
    }
    let a: Float = kepler_solve_eccentric_anomaly_rad(0.0, 0.0);
    let b: Float = kepler_solve_eccentric_anomaly_rad(0.0, 0.0);
    if a != b {
        println("FAIL kepler_solve_eccentric_anomaly_rad");
        process_exit(1);
    }
    println("prod_g2_satellite_ephemeris_sgp4_orbit: PASSED");
}
