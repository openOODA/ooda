// # Product prove std/space_propulsion/field_emission_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/field_emission_electric_propulsion.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/field_emission_electric_propulsion.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_field_emission_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/field_emission_electric_propulsion.oo";

pub fn main() {
    let field_emission_electric_propulsion_a = feep_spec_default_indium();
    let field_emission_electric_propulsion_b = feep_spec_default_indium();
    if field_emission_electric_propulsion_a.num_emitters != field_emission_electric_propulsion_b.num_emitters {
        println("FAIL field_emission_electric_propulsion");
        process_exit(1);
    }
    println("prod_ap_field_emission_electric_propulsion: PASSED");
}
