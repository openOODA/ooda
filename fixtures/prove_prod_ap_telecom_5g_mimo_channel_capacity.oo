// # Product prove std/telecom_5g/mimo_channel_capacity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/mimo_channel_capacity.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_channel_capacity.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mimo_channel_capacity: PASSED only if they match.

import "std/telecom_5g/mimo_channel_capacity.oo";

pub fn main() {
    let mimo_channel_capacity_a = mimo_shannon_siso_bps_hz(0.0);
    let mimo_channel_capacity_b = mimo_shannon_siso_bps_hz(0.0);
    if mimo_channel_capacity_a != mimo_channel_capacity_b {
        println("FAIL mimo_channel_capacity");
        process_exit(1);
    }
    println("prod_ap_mimo_channel_capacity: PASSED");
}
