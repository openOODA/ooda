// # Product prove std/bioinformatics/bio_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts bio_hardware_device_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/bio_stubs.oo.
//
// Beats:
//   1. Call bio_hardware_device_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bio_stubs: PASSED only if they match.

import "std/bioinformatics/bio_stubs.oo";

pub fn main() {
    let bio_stubs_mark: Int = 0;
    if bio_stubs_mark != 0 {
        process_exit(1);
    }
    let a: BioHardwareDevice = bio_hardware_device_new(0, "x");
    let b: BioHardwareDevice = bio_hardware_device_new(0, "x");
    if (a).device_id != (b).device_id {
        println("FAIL bio_hardware_device_new");
        process_exit(1);
    }
    println("prod_bio_stubs: PASSED");
}
