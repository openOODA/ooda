// # Const if (true) println
//
// Logline: Print paren-then when the condition is (true).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (true) print paren-then else print paren-else.
//   3. Leave no other statements.

pub fn main() {
    if (true) {
        println("paren-then");
    } else {
        println("paren-else");
    }
}
