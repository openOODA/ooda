// # Product prove std/astrodynamics/ground_station_pass.oo
//
// Logline: Fail-closed emit+gcc+run asserts min_elev_deg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/ground_station_pass.oo.
//
// Beats:
//   1. Call min_elev_deg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ground_station_pass: PASSED only if they match.

import "std/astrodynamics/ground_station_pass.oo";

pub fn main() {
    let ground_station_pass_mark: Int = 0;
    if ground_station_pass_mark != 0 {
        process_exit(1);
    }
    let a: Int = min_elev_deg();
    let b: Int = min_elev_deg();
    if a != b {
        println("FAIL min_elev_deg");
        process_exit(1);
    }
    println("prod_ground_station_pass: PASSED");
}
