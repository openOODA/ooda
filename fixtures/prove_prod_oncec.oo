// # Product sync once cell prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/once_cell.oo.
//
// Setup: Product std/sync/once_cell.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New cell is unset.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/once_cell.oo";

pub fn main() {
    let c: OnceCell = once_cell_new();
    if once_cell_is_set(c) {
        println("FAIL oncec set");
        process_exit(1);
    }
    println("prod_oncec: PASSED");
}
