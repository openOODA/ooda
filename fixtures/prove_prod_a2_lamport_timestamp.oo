// # Product prove std/cloud_k8s/lamport_timestamp.oo
//
// Logline: Fail-closed emit+gcc+run asserts lamport_event_compare is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/lamport_timestamp.oo.
//
// Beats:
//   1. Call lamport_event_compare twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lamport_timestamp: PASSED only if they match.

import "std/cloud_k8s/lamport_timestamp.oo";

pub fn main() {
    let lamport_timestamp_mark: Int = 0;
    if lamport_timestamp_mark != 0 {
        process_exit(1);
    }
    let a: Int = lamport_event_compare(0, 0, 0, 0);
    let b: Int = lamport_event_compare(0, 0, 0, 0);
    if a != b {
        println("FAIL lamport_event_compare");
        process_exit(1);
    }
    println("prod_lamport_timestamp: PASSED");
}
