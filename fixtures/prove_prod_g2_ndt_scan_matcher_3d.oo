// # Product prove std/lidar_perception/ndt_scan_matcher_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts ndt_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/ndt_scan_matcher_3d.oo.
//
// Beats:
//   1. Call ndt_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ndt_scan_matcher_3d: PASSED only if they match.

import "std/lidar_perception/ndt_scan_matcher_3d.oo";

pub fn main() {
    let ndt_scan_matcher_3d_mark: Int = 0;
    if ndt_scan_matcher_3d_mark != 0 {
        process_exit(1);
    }
    let a: NDTConfig = ndt_config_default();
    let b: NDTConfig = ndt_config_default();
    if (a).max_iterations != (b).max_iterations {
        println("FAIL ndt_config_default");
        process_exit(1);
    }
    println("prod_g2_ndt_scan_matcher_3d: PASSED");
}
