// # Product prove std/genomics_advanced/genomics_advanced_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts genomics_stub_basecaller_samples_per_sec is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/genomics_advanced_stubs.oo.
//
// Beats:
//   1. Call genomics_stub_basecaller_samples_per_sec twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_genomics_advanced_stubs: PASSED only if they match.

import "std/genomics_advanced/genomics_advanced_stubs.oo";

pub fn main() {
    let genomics_advanced_stubs_mark: Int = 0;
    if genomics_advanced_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = genomics_stub_basecaller_samples_per_sec(0);
    let b: Int = genomics_stub_basecaller_samples_per_sec(0);
    if a != b {
        println("FAIL genomics_stub_basecaller_samples_per_sec");
        process_exit(1);
    }
    println("prod_genomics_advanced_stubs: PASSED");
}
