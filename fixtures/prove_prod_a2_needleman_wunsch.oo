// # Product prove std/bioinformatics/needleman_wunsch.oo
//
// Logline: Fail-closed emit+gcc+run asserts needleman_wunsch_matrix_dim is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/needleman_wunsch.oo.
//
// Beats:
//   1. Call needleman_wunsch_matrix_dim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_needleman_wunsch: PASSED only if they match.

import "std/bioinformatics/needleman_wunsch.oo";

pub fn main() {
    let a: Int = needleman_wunsch_matrix_dim(0, 0);
    let b: Int = needleman_wunsch_matrix_dim(0, 0);
    if a != b {
        println("FAIL needleman_wunsch_matrix_dim");
        process_exit(1);
    }
    println("prod_needleman_wunsch: PASSED");
}
