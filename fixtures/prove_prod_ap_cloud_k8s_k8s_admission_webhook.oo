import "std/cloud_k8s/k8s_admission_webhook.oo";

pub fn main() {
    let k8s_admission_webhook_a = admission_response_allow("x");
    let k8s_admission_webhook_b = admission_response_allow("x");
    if k8s_admission_webhook_a.uid != k8s_admission_webhook_b.uid {
        println("FAIL k8s_admission_webhook");
        process_exit(1);
