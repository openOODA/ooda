// # Product prove std/astrodynamics/julian_date.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/julian_date.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/julian_date.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_julian_date: PASSED only if they match.

import "std/astrodynamics/julian_date.oo";

pub fn main() {
    let julian_date_a = j2000_jd();
    let julian_date_b = j2000_jd();
    if julian_date_a != julian_date_b {
        println("FAIL julian_date");
        process_exit(1);
    }
    println("prod_ap_julian_date: PASSED");
}
