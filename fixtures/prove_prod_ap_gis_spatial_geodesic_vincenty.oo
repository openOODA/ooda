// # Product prove std/gis_spatial/geodesic_vincenty.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/geodesic_vincenty.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/geodesic_vincenty.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_geodesic_vincenty: PASSED only if they match.

import "std/gis_spatial/geodesic_vincenty.oo";

pub fn main() {
    let geodesic_vincenty_a = vincenty_inverse(0.0, 0.0, 0.0, 0.0);
    let geodesic_vincenty_b = vincenty_inverse(0.0, 0.0, 0.0, 0.0);
    if geodesic_vincenty_a.distance_m != geodesic_vincenty_b.distance_m {
        println("FAIL geodesic_vincenty");
        process_exit(1);
    }
    println("prod_ap_geodesic_vincenty: PASSED");
}
