// # Product matrix_banded prove
import "std/collections/matrix_banded.oo";
pub fn main() {
    let mut m: BandedMatrix = banded_matrix_new(2, 0, 0);
    m = banded_matrix_set_diag(m, 0, 7);
    m = banded_matrix_set_diag(m, 1, 3);
    let tr: Int = banded_matrix_trace(m);
    if tr != 10 {
        println("FAIL mband trace");
        process_exit(1);
    }
    println("prod_mband: PASSED");
}
