// # Product prove std/fhe_lattices/fhe_poly_ntt_arithmetic.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntt_bit_reverse is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_poly_ntt_arithmetic.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ntt_bit_reverse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_poly_ntt_arithmetic: PASSED only if they match.

import "std/fhe_lattices/fhe_poly_ntt_arithmetic.oo";

pub fn main() {
    let g2_a = ntt_bit_reverse(2, 2);
    let g2_b = ntt_bit_reverse(2, 2);
    if g2_a != g2_b {
        println("FAIL ntt_bit_reverse");
        process_exit(1);
    }
    println("prod_g2_fhe_poly_ntt_arithmetic: PASSED");
}
