// # Product prove std/synthetic_biology/small_rna_antisense_silencing.oo
//
// Logline: Fail-closed emit+gcc+run asserts srna_rk4_step real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/small_rna_antisense_silencing.oo.
//
// Beats:
//   1. Call srna_rk4_step with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_small_rna_antisense_silencing: PASSED only if the assert holds.

import "std/synthetic_biology/small_rna_antisense_silencing.oo";

pub fn main() {
    let small_rna_antisense_silencing_mark: Int = 0;
    if small_rna_antisense_silencing_mark != 0 {
        process_exit(1);
    }
    let small_rna_antisense_silencing_st: SrnaState = SrnaState { srna_conc: 0.0, target_mrna_conc: 0.0, duplex_conc: 0.0, time_min: 0.0 };
    let small_rna_antisense_silencing_p: SrnaSilencingParams = SrnaSilencingParams { k_tx_srna: 0.0, k_tx_mrna: 0.0, k_bind_duplex: 0.0, d_free_srna: 0.0, d_free_mrna: 0.0, d_duplex_cleavage: 0.0 };
    let small_rna_antisense_silencing_a = srna_rk4_step(&small_rna_antisense_silencing_st, &small_rna_antisense_silencing_p, 0.0);
    let small_rna_antisense_silencing_time_min: Float = (small_rna_antisense_silencing_a).time_min;
    if !(small_rna_antisense_silencing_time_min == 0.0) {
        println("FAIL srna_rk4_step");
        process_exit(1);
    }
    println("prod_small_rna_antisense_silencing: PASSED");
}
