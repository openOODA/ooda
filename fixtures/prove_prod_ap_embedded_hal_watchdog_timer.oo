// # Product prove std/embedded_hal/watchdog_timer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/watchdog_timer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/watchdog_timer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_watchdog_timer: PASSED only if they match.

import "std/embedded_hal/watchdog_timer.oo";

pub fn main() {
    let watchdog_timer_a = iwdg_config_new(0, 0);
    let watchdog_timer_b = iwdg_config_new(0, 0);
    let watchdog_timer_va = iwdg_calculate_timeout_ms(watchdog_timer_a);
    let watchdog_timer_vb = iwdg_calculate_timeout_ms(watchdog_timer_b);
    if watchdog_timer_va != watchdog_timer_vb {
        println("FAIL watchdog_timer");
        process_exit(1);
    }
    println("prod_ap_watchdog_timer: PASSED");
}
