// # Product prove std/fhe_lattices/fhe_functional_bootstrap.oo
//
// Logline: Fail-closed emit+gcc+run asserts functional_bootstrap_sign_extract is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_functional_bootstrap.oo.
//
// Beats:
//   1. Call functional_bootstrap_sign_extract twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_functional_bootstrap: PASSED only if they match.

import "std/fhe_lattices/fhe_functional_bootstrap.oo";

pub fn main() {
    let fhe_functional_bootstrap_mark: Int = 0;
    if fhe_functional_bootstrap_mark != 0 {
        process_exit(1);
    }
    let a: Int = functional_bootstrap_sign_extract(0.0);
    let b: Int = functional_bootstrap_sign_extract(0.0);
    if a != b {
        println("FAIL functional_bootstrap_sign_extract");
        process_exit(1);
    }
    println("prod_fhe_functional_bootstrap: PASSED");
}
