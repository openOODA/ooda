// # Product prove std/crispr_cas/prime_editing_rtt_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtt_evaluate_spec is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_rtt_designer.oo.
//
// Beats:
//   1. Call rtt_evaluate_spec twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prime_editing_rtt_designer: PASSED only if they match.

import "std/crispr_cas/prime_editing_rtt_designer.oo";

pub fn main() {
    let prime_editing_rtt_designer_mark: Int = 0;
    if prime_editing_rtt_designer_mark != 0 {
        process_exit(1);
    }
    let a: RttDesignSpec = rtt_evaluate_spec("x", 0, true);
    let b: RttDesignSpec = rtt_evaluate_spec("x", 0, true);
    if (a).rtt_length != (b).rtt_length {
        println("FAIL rtt_evaluate_spec");
        process_exit(1);
    }
    println("prod_prime_editing_rtt_designer: PASSED");
}
