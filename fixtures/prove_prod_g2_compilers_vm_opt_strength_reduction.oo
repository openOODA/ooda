// # Product prove std/compilers_vm/opt_strength_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts primary_ind_var_new is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_strength_reduction.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call primary_ind_var_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opt_strength_reduction: PASSED only if they match.

import "std/compilers_vm/opt_strength_reduction.oo";

pub fn main() {
    let g2_oa: PrimaryIndVar = primary_ind_var_new("x", 2, 2, 2);
    let g2_ob: PrimaryIndVar = primary_ind_var_new("x", 2, 2, 2);
    let g2_a = (g2_oa).init_val;
    let g2_b = (g2_ob).init_val;
    if g2_a != g2_b {
        println("FAIL primary_ind_var_new.init_val");
        process_exit(1);
    }
    println("prod_g2_opt_strength_reduction: PASSED");
}
