// # Product prove std/astro_advanced/launch_vehicle_max_q.oo
//
// Logline: Fail-closed emit+gcc+run asserts max_q_pa is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/launch_vehicle_max_q.oo.
//
// Beats:
//   1. Call max_q_pa twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_vehicle_max_q: PASSED only if they match.

import "std/astro_advanced/launch_vehicle_max_q.oo";

pub fn main() {
    let a = max_q_pa();
    let b = max_q_pa();
    if a != b {
        println("FAIL max_q_pa");
        process_exit(1);
    }
    println("prod_launch_vehicle_max_q: PASSED");
}
