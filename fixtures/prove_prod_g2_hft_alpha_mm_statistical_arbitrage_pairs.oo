// # Product prove std/hft_alpha/mm_statistical_arbitrage_pairs.oo
//
// Logline: Fail-closed emit+gcc+run asserts pair_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_statistical_arbitrage_pairs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pair_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_statistical_arbitrage_pairs: PASSED only if they match.

import "std/hft_alpha/mm_statistical_arbitrage_pairs.oo";

pub fn main() {
    let g2_oa: PairStrategyConfig = pair_config_default();
    let g2_ob: PairStrategyConfig = pair_config_default();
    let g2_a = (g2_oa).entry_z_score;
    let g2_b = (g2_ob).entry_z_score;
    if g2_a != g2_b {
        println("FAIL pair_config_default.entry_z_score");
        process_exit(1);
    }
    println("prod_g2_mm_statistical_arbitrage_pairs: PASSED");
}
