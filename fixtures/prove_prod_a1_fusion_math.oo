// # Product prove std/auto/fusion_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts fus_vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_math.oo.
//
// Beats:
//   1. Call fus_vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fusion_math: PASSED only if they match.

import "std/auto/fusion_math.oo";

pub fn main() {
    let fusion_math_mark: Int = 0;
    if fusion_math_mark != 0 {
        process_exit(1);
    }
    let a: FusVec3 = fus_vec3_new(0, 0, 0);
    let b: FusVec3 = fus_vec3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL fus_vec3_new");
        process_exit(1);
    }
    println("prod_fusion_math: PASSED");
}
