// # Product prove std/protein_folding/structure_kabsch_alignment.oo
//
// Logline: Fail-closed emit+gcc+run asserts structure_kabsch_alignment_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/structure_kabsch_alignment.oo.
//
// Beats:
//   1. Call structure_kabsch_alignment_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_structure_kabsch_alignment: PASSED only if they match.

import "std/protein_folding/structure_kabsch_alignment.oo";

pub fn main() {
    let a: Int = structure_kabsch_alignment_probe();
    let b: Int = structure_kabsch_alignment_probe();
    if a != b {
        println("FAIL structure_kabsch_alignment_probe");
        process_exit(1);
    }
    println("prod_g2_structure_kabsch_alignment: PASSED");
}
