// # Product prove std/zk_rollup/rollup_tx_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_tx_envelope_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_tx_envelope.oo.
//
// Beats:
//   1. Call rollup_tx_envelope_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rollup_tx_envelope: PASSED only if asserts hold.

import "std/zk_rollup/rollup_tx_envelope.oo";

pub fn main() {
    let rollup_tx_envelope_a = rollup_tx_envelope_new(0, 0, 0, 0, 0, 0);
    let rollup_tx_envelope_b = rollup_tx_envelope_new(0, 0, 0, 0, 0, 0);
    if rollup_tx_envelope_a.tx_type != rollup_tx_envelope_b.tx_type {
        println("FAIL rollup_tx_envelope_new");
        process_exit(1);
    }
    println("prod_rollup_tx_envelope: PASSED");
}
