// # Product prove std/telecom_6g/beam_squint_wideband_compensator.oo
//
// Logline: Fail-closed emit+gcc+run asserts beam_squint_angle_rad is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/beam_squint_wideband_compensator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call beam_squint_angle_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_beam_squint_wideband_compensator: PASSED only if they match.

import "std/telecom_6g/beam_squint_wideband_compensator.oo";

pub fn main() {
    let g2_a = beam_squint_angle_rad(1.0, 1.0, 1.0);
    let g2_b = beam_squint_angle_rad(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL beam_squint_angle_rad");
        process_exit(1);
    }
    println("prod_g2_beam_squint_wideband_compensator: PASSED");
}
