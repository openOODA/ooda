// # Product prove std/db_columnar/arrow_record_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts arrow_record_batch_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_record_batch.oo.
//
// Beats:
//   1. Call arrow_record_batch_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_arrow_record_batch: PASSED only if they match.

import "std/db_columnar/arrow_record_batch.oo";

pub fn main() {
    let a: ArrowRecordBatch = arrow_record_batch_new(0);
    let b: ArrowRecordBatch = arrow_record_batch_new(0);
    if (a).num_rows != (b).num_rows {
        println("FAIL arrow_record_batch_new");
        process_exit(1);
    }
    println("prod_g2_arrow_record_batch: PASSED");
}
