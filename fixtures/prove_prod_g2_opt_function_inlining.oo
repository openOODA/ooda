// # Product prove std/compilers_vm/opt_function_inlining.oo
//
// Logline: Fail-closed emit+gcc+run asserts function_summary_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_function_inlining.oo.
//
// Beats:
//   1. Call function_summary_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opt_function_inlining: PASSED only if they match.

import "std/compilers_vm/opt_function_inlining.oo";

pub fn main() {
    let opt_function_inlining_mark: Int = 0;
    if opt_function_inlining_mark != 0 {
        process_exit(1);
    }
    let a: FunctionSummary = function_summary_new("x", 0, 0, 0, 0);
    let b: FunctionSummary = function_summary_new("x", 0, 0, 0, 0);
    if (a).instruction_count != (b).instruction_count {
        println("FAIL function_summary_new");
        process_exit(1);
    }
    println("prod_g2_opt_function_inlining: PASSED");
}
