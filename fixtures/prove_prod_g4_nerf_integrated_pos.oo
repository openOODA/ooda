// # Product prove std/nerf_3dgs/integrated_positional_encoding.oo
//
// Logline: Fail-closed verification that Integrated Positional Encoding (IPE) conical frustum projection and Gaussian attenuation are deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/integrated_positional_encoding.oo.
//
// Beats:
//   1. Convert conical frustum into Gaussian distribution representation.
//   2. Evaluate scale-aware frequency attenuation factors across variance bounds.
//   3. Compute integrated Fourier feature pair encodings deterministically.
//   4. Print prod_g4_nerf_integrated_pos: PASSED and exit 0.

import "std/nerf_3dgs/integrated_positional_encoding.oo";

pub fn main() {
    let frustum: ConicalFrustum = ConicalFrustum {
        origin: vec3_new(0.0, 0.0, 0.0),
        direction: vec3_new(0.0, 0.0, 1.0),
        t0: 1.0,
        t1: 3.0,
        radius: 0.1,
    };
    let g1: GaussianFrustum = conical_frustum_to_gaussian(&frustum);
    let g2: GaussianFrustum = conical_frustum_to_gaussian(&frustum);
    if (g1).mean.z != (g2).mean.z || (g1).mean.z != 2.0 {
        println("FAIL conical_frustum_to_gaussian mean");
        process_exit(1);
    }
    if (g1).variance_parallel != (g2).variance_parallel || (g1).variance_parallel <= 0.0 {
        println("FAIL conical_frustum_to_gaussian variance");
        process_exit(1);
    }

    let atten0_a: Float = ipe_attenuation_factor(0, 0.0);
    let atten0_b: Float = ipe_attenuation_factor(0, 0.0);
    if atten0_a != atten0_b || atten0_a != 1.0 {
        println("FAIL ipe_attenuation_factor zero variance");
        process_exit(1);
    }

    let atten_large: Float = ipe_attenuation_factor(5, 100.0);
    if atten_large != 0.0 {
        println("FAIL ipe_attenuation_factor large variance");
        process_exit(1);
    }

    let feat1: EncodedFeaturePair = ipe_encode_frustum_dim(&g1, 0);
    let feat2: EncodedFeaturePair = ipe_encode_frustum_dim(&g1, 0);
    if (feat1).sin_val != (feat2).sin_val || (feat1).cos_val != (feat2).cos_val {
        println("FAIL ipe_encode_frustum_dim");
        process_exit(1);
    }

    println("prod_g4_nerf_integrated_pos: PASSED");
    process_exit(0);
}
