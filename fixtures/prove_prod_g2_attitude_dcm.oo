// # Product prove std/aero/attitude_dcm.oo
//
// Logline: Fail-closed emit+gcc+run asserts dcm_cell_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_dcm.oo.
//
// Beats:
//   1. Call dcm_cell_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_attitude_dcm: PASSED only if they match.

import "std/aero/attitude_dcm.oo";

pub fn main() {
    let attitude_dcm_mark: Int = 0;
    if attitude_dcm_mark != 0 {
        process_exit(1);
    }
    let a: DcmCell = dcm_cell_new(0, 0);
    let b: DcmCell = dcm_cell_new(0, 0);
    if (a).r00 != (b).r00 {
        println("FAIL dcm_cell_new");
        process_exit(1);
    }
    println("prod_g2_attitude_dcm: PASSED");
}
