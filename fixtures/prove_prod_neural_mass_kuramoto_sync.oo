// # Product prove std/neuro_bci/neural_mass_kuramoto_sync.oo
//
// Logline: Fail-closed emit+gcc+run asserts kuramoto_network4_default real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neural_mass_kuramoto_sync.oo.
//
// Beats:
//   1. Call kuramoto_network4_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_neural_mass_kuramoto_sync: PASSED only if the assert holds.

import "std/neuro_bci/neural_mass_kuramoto_sync.oo";

pub fn main() {
    let neural_mass_kuramoto_sync_mark: Int = 0;
    if neural_mass_kuramoto_sync_mark != 0 {
        process_exit(1);
    }
    let neural_mass_kuramoto_sync_a = kuramoto_network4_default(2.0);
    let neural_mass_kuramoto_sync_coupling_k: Float = (neural_mass_kuramoto_sync_a).coupling_k;
    if !(neural_mass_kuramoto_sync_coupling_k == 2.0) {
        println("FAIL kuramoto_network4_default");
        process_exit(1);
    }
    println("prod_neural_mass_kuramoto_sync: PASSED");
}
