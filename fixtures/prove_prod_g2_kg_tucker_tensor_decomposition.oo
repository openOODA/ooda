// # Product prove std/graph_gnn/kg_tucker_tensor_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts tucker_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_tucker_tensor_decomposition.oo.
//
// Beats:
//   1. Call tucker_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_tucker_tensor_decomposition: PASSED only if they match.

import "std/graph_gnn/kg_tucker_tensor_decomposition.oo";

pub fn main() {
    let kg_tucker_tensor_decomposition_mark: Int = 0;
    if kg_tucker_tensor_decomposition_mark != 0 {
        process_exit(1);
    }
    let a: TuckERConfig = tucker_config_new(0, 0, 0, 0, 0.0);
    let b: TuckERConfig = tucker_config_new(0, 0, 0, 0, 0.0);
    if (a).num_entities != (b).num_entities {
        println("FAIL tucker_config_new");
        process_exit(1);
    }
    println("prod_g2_kg_tucker_tensor_decomposition: PASSED");
}
