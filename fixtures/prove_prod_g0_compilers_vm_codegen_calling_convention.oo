// # Product prove std/compilers_vm/codegen_calling_convention.oo
//
// Logline: Fail-closed emit+gcc+run asserts sysv_amd64_reg_name is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/codegen_calling_convention.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sysv_amd64_reg_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_codegen_calling_convention: PASSED only if they match.

import "std/compilers_vm/codegen_calling_convention.oo";

pub fn main() {
    let g0_a = sysv_amd64_reg_name(2);
    let g0_b = sysv_amd64_reg_name(2);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL sysv_amd64_reg_name");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL sysv_amd64_reg_name");
        process_exit(1);
    }
    println("prod_g0_codegen_calling_convention: PASSED");
}
