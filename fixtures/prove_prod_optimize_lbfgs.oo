// # Product prove std/scicomp/optimize_lbfgs.oo
//
// Logline: Fail-closed emit+gcc+run asserts lbfgs_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/optimize_lbfgs.oo.
//
// Beats:
//   1. Call lbfgs_config_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_optimize_lbfgs: PASSED only if they match.

import "std/scicomp/optimize_lbfgs.oo";

pub fn main() {
    let optimize_lbfgs_mark: Int = 0;
    if optimize_lbfgs_mark != 0 {
        process_exit(1);
    }
    let a: LbfgsConfig = lbfgs_config_default();
    let b: LbfgsConfig = lbfgs_config_default();
    if (a).max_iters != (b).max_iters {
        println("FAIL lbfgs_config_default");
        process_exit(1);
    }
    println("prod_optimize_lbfgs: PASSED");
}
