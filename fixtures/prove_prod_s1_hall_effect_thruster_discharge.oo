// # Product prove std/space_propulsion/hall_effect_thruster_discharge.oo
//
// Logline: Fail-closed emit+gcc+run asserts hall_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/hall_effect_thruster_discharge.oo.
//
// Beats:
//   1. Call hall_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hall_effect_thruster_discharge: PASSED only if they match.

import "std/space_propulsion/hall_effect_thruster_discharge.oo";

pub fn main() {
    let hall_effect_thruster_discharge_mark: Int = 0;
    if hall_effect_thruster_discharge_mark != 0 {
        process_exit(1);
    }
    let hall_effect_thruster_discharge_a = hall_compute_performance(hall_thruster_spec_default_5kw());
    let hall_effect_thruster_discharge_b = hall_compute_performance(hall_thruster_spec_default_5kw());
    if (hall_effect_thruster_discharge_a).thrust_mn != (hall_effect_thruster_discharge_b).thrust_mn {
        println("FAIL hall_compute_performance");
        process_exit(1);
    }
    println("prod_hall_effect_thruster_discharge: PASSED");
}
