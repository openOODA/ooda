// # Product prove std/zk_rollup/sparse_merkle_tree_audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_sibling_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_audit.oo.
//
// Beats:
//   1. Call smt_sibling_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_sparse_merkle_tree_audit: PASSED only if asserts hold.

import "std/zk_rollup/sparse_merkle_tree_audit.oo";

pub fn main() {
    let sparse_merkle_tree_audit_a: SmtSibling = smt_sibling_new("x", true, 0);
    let sparse_merkle_tree_audit_b: SmtSibling = smt_sibling_new("x", true, 0);
    if sparse_merkle_tree_audit_a.level != sparse_merkle_tree_audit_b.level {
        println("FAIL smt_sibling_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_audit: PASSED");
}
