// M166 path A: sealed OS syscall free names under SysCap → residual Err
// Honesty: not full async I/O / epoll loop / inotify / prctl product.
pub fn main(sys: &SysCap) {
    let e: Result[String, String] = sys_epoll_create(sys, 0);
    if e.is_err() {
        println("epoll-residual-ok");
    } else {
        println("epoll-unexpected-ok");
    }
    let n: Result[String, String] = sys_inotify_init(sys);
    if n.is_err() {
        println("inotify-residual-ok");
    } else {
        println("inotify-unexpected-ok");
    }
    let p: Result[String, String] = sys_prctl(sys, 1);
    if p.is_err() {
        println("prctl-residual-ok");
    } else {
        println("prctl-unexpected-ok");
    }
}
