// # Product prove std/security_defense/chroot_jail_isolator.oo
//
// Logline: Fail-closed emit+gcc+run asserts chroot_jail_is_path_safe is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/chroot_jail_isolator.oo.
//
// Beats:
//   1. Call chroot_jail_is_path_safe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chroot_jail_isolator: PASSED only if they match.

import "std/security_defense/chroot_jail_isolator.oo";

pub fn main() {
    let chroot_jail_isolator_mark: Int = 0;
    if chroot_jail_isolator_mark != 0 {
        process_exit(1);
    }
    let chroot_jail_isolator_a: Bool = chroot_jail_is_path_safe("x");
    let chroot_jail_isolator_b: Bool = chroot_jail_is_path_safe("x");
    if chroot_jail_isolator_a != chroot_jail_isolator_b {
        println("FAIL chroot_jail_is_path_safe");
        process_exit(1);
    }
    println("prod_chroot_jail_isolator: PASSED");
}
