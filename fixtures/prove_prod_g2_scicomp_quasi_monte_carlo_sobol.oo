// # Product prove std/scicomp/quasi_monte_carlo_sobol.oo
//
// Logline: Fail-closed emit+gcc+run asserts gray_code is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/quasi_monte_carlo_sobol.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gray_code twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quasi_monte_carlo_sobol: PASSED only if they match.

import "std/scicomp/quasi_monte_carlo_sobol.oo";

pub fn main() {
    let g2_a = gray_code(2);
    let g2_b = gray_code(2);
    if g2_a != g2_b {
        println("FAIL gray_code");
        process_exit(1);
    }
    println("prod_g2_quasi_monte_carlo_sobol: PASSED");
}
