// # Product prove std/astrophysics_relativity/relativistic_jets_blandford_znajek.oo
//
// Logline: Fail-closed emit+gcc+run asserts bz_horizon_radius_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/relativistic_jets_blandford_znajek.oo.
//
// Beats:
//   1. Call bz_horizon_radius_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_relativistic_jets_blandford_znajek: PASSED only if they match.

import "std/astrophysics_relativity/relativistic_jets_blandford_znajek.oo";

pub fn main() {
    let relativistic_jets_blandford_znajek_mark: Int = 0;
    if relativistic_jets_blandford_znajek_mark != 0 {
        process_exit(1);
    }
    let a: Float = bz_horizon_radius_m(0.0, 0.0);
    let b: Float = bz_horizon_radius_m(0.0, 0.0);
    if a != b {
        println("FAIL bz_horizon_radius_m");
        process_exit(1);
    }
    println("prod_relativistic_jets_blandford_znajek: PASSED");
}
