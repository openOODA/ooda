    let quantum_refrigeration_cooling_a = absorption_refrigerator_cop(0.0, 0.0, 0.0);
    let quantum_refrigeration_cooling_b = absorption_refrigerator_cop(0.0, 0.0, 0.0);
    if quantum_refrigeration_cooling_a != quantum_refrigeration_cooling_b {
        println("FAIL quantum_refrigeration_cooling");
        process_exit(1);
