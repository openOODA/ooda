// # Product prove std/security_defense/hardware_breakpoint_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts debug_registers_state_clean is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/hardware_breakpoint_detector.oo.
//
// Beats:
//   1. Call debug_registers_state_clean twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hardware_breakpoint_detector: PASSED only if they match.

import "std/security_defense/hardware_breakpoint_detector.oo";

pub fn main() {
    let hardware_breakpoint_detector_mark: Int = 0;
    if hardware_breakpoint_detector_mark != 0 {
        process_exit(1);
    }
    let hardware_breakpoint_detector_a: DebugRegistersState = debug_registers_state_clean();
    let hardware_breakpoint_detector_b: DebugRegistersState = debug_registers_state_clean();
    if (hardware_breakpoint_detector_a).dr0 != (hardware_breakpoint_detector_b).dr0 {
        println("FAIL debug_registers_state_clean");
        process_exit(1);
    }
    println("prod_hardware_breakpoint_detector: PASSED");
}
