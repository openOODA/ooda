// # Product prove std/zk_rollup/rollup_fraud_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_fraud_proof.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_fraud_proof.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_fraud_proof: PASSED only if they match.

import "std/zk_rollup/rollup_fraud_proof.oo";

pub fn main() {
    let rollup_fraud_proof_a = fraud_dispute_init(0, 0, 0, 0);
    let rollup_fraud_proof_b = fraud_dispute_init(0, 0, 0, 0);
    if rollup_fraud_proof_a.dispute_id != rollup_fraud_proof_b.dispute_id {
        println("FAIL rollup_fraud_proof");
        process_exit(1);
    }
    println("prod_ap_rollup_fraud_proof: PASSED");
}
