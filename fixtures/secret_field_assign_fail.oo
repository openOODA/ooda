// # Refuse a secret stored in a field
//
// Logline: Assigning a tagged name into a struct field taints the later field read.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Store that name in Box.v.
//   3. Print the field so the sink refuses.

// M-? field-assign taint: secret assigned to struct field, field read at sink
type Box = struct { v: String };
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let mut b = Box { v: "init" };
    b.v = api_key;
    println(b.v);
}
