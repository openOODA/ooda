// # Product prove std/bioinformatics/smith_waterman.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_pow4 real value.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/smith_waterman.oo.
//
// Beats:
//   1. Call int_pow4 with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_smith_waterman: PASSED only if the assert holds.

import "std/bioinformatics/smith_waterman.oo";

pub fn main() {
    let smith_waterman_mark: Int = 0;
    if smith_waterman_mark != 0 {
        process_exit(1);
    }
    let smith_waterman_n: Int = int_pow4(0);
    if smith_waterman_n != 1 {
        println("FAIL int_pow4");
        process_exit(1);
    }
    println("prod_smith_waterman: PASSED");
}
