// # Product prove std/sec/crypto/rsa_pss_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts rsa_pss_verify_emsa is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/rsa_pss_stubs.oo.
//
// Beats:
//   1. Call rsa_pss_verify_emsa twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rsa_pss_stubs: PASSED only if they match.

import "std/sec/crypto/rsa_pss_stubs.oo";

pub fn main() {
    let rsa_pss_stubs_mark: Int = 0;
    if rsa_pss_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = rsa_pss_verify_emsa("x", "x", 0, 0);
    let b: Bool = rsa_pss_verify_emsa("x", "x", 0, 0);
    if a != b {
        println("FAIL rsa_pss_verify_emsa");
        process_exit(1);
    }
    println("prod_g2_rsa_pss_stubs: PASSED");
}
