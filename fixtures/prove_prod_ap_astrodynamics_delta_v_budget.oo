// # Product prove std/astrodynamics/delta_v_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/delta_v_budget.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/delta_v_budget.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_delta_v_budget: PASSED only if they match.

import "std/astrodynamics/delta_v_budget.oo";

pub fn main() {
    let delta_v_budget_a = leo_dv();
    let delta_v_budget_b = leo_dv();
    if delta_v_budget_a != delta_v_budget_b {
        println("FAIL delta_v_budget");
        process_exit(1);
    }
    println("prod_ap_delta_v_budget: PASSED");
}
