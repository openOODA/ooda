// # Ensures fail closed
//
// Logline: Return a negative so ensures result >= 0 fails at runtime.
//
// Beats:
//   1. Ensure result >= 0.
//   2. Return x - 10.
//   3. Call bad(3) so the postcondition trips.

// Fail-at-runtime: ensures result >= 0 violated by return of negative
pub fn bad(x: Int) -> Int
    ensures result >= 0
{
    return x - 10;
}

pub fn main() {
    println(bad(3));
}
