// # Product prove std/embedded_hal/dac_waveform_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/dac_waveform_generator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/dac_waveform_generator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dac_waveform_generator: PASSED only if they match.

import "std/embedded_hal/dac_waveform_generator.oo";

pub fn main() {
    let dac_waveform_generator_a = dac_channel_new(0, 0);
    let dac_waveform_generator_b = dac_channel_new(0, 0);
    let dac_waveform_generator_va = dac_millivolts_to_code(dac_waveform_generator_a, 0);
    let dac_waveform_generator_vb = dac_millivolts_to_code(dac_waveform_generator_b, 0);
    if dac_waveform_generator_va != dac_waveform_generator_vb {
        println("FAIL dac_waveform_generator");
        process_exit(1);
    }
    println("prod_ap_dac_waveform_generator: PASSED");
}
