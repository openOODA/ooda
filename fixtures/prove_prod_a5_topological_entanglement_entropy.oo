// # Product prove std/quantum_topological/topological_entanglement_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts total_quantum_dim_from_gamma is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_entanglement_entropy.oo.
//
// Beats:
//   1. Call total_quantum_dim_from_gamma twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_entanglement_entropy: PASSED only if they match.

import "std/quantum_topological/topological_entanglement_entropy.oo";

pub fn main() {
    let topological_entanglement_entropy_mark: Int = 0;
    if topological_entanglement_entropy_mark != 0 {
        process_exit(1);
    }
    let a: Float = total_quantum_dim_from_gamma(0.0);
    let b: Float = total_quantum_dim_from_gamma(0.0);
    if a != b {
        println("FAIL total_quantum_dim_from_gamma");
        process_exit(1);
    }
    println("prod_topological_entanglement_entropy: PASSED");
}
