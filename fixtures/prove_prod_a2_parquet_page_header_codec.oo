// # Product prove std/db_columnar/parquet_page_header_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts data_page_v1_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_page_header_codec.oo.
//
// Beats:
//   1. Call data_page_v1_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_page_header_codec: PASSED only if they match.

import "std/db_columnar/parquet_page_header_codec.oo";

pub fn main() {
    let parquet_page_header_codec_mark: Int = 0;
    if parquet_page_header_codec_mark != 0 {
        process_exit(1);
    }
    let a: DataPageHeaderV1 = data_page_v1_new(0, 0, 0, 0);
    let b: DataPageHeaderV1 = data_page_v1_new(0, 0, 0, 0);
    if (a).num_values != (b).num_values {
        println("FAIL data_page_v1_new");
        process_exit(1);
    }
    println("prod_parquet_page_header_codec: PASSED");
}
