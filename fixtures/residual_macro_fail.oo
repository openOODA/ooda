// # Call residual macro_expand
//
// Logline: A bare call to macro_expand is the residual fail rail for that surface.
//
// Beats:
//   1. Invoke the residual name from main.
//   2. Bind the result so the call is live.
//   3. Expect check or emit to refuse the residual.

pub fn main() { let r = macro_expand("m"); }
