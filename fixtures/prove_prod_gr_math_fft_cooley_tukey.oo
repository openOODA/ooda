// # Product prove std/math/fft_cooley_tukey.oo
//
// Logline: Fail-closed emit+gcc+run asserts fft_power_spectrum is a real value.
//
// Setup: Isolated emit-c. Imports std/math/fft_cooley_tukey.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fft_power_spectrum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fft_cooley_tukey: PASSED only if they match.

import "std/math/fft_cooley_tukey.oo";

pub fn main() {
    let g0_oa = fft_buffer_new(0);
    let g0_ob = fft_buffer_new(0);
    let g0_la = fft_power_spectrum(g0_oa);
    let g0_lb = fft_power_spectrum(g0_ob);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL fft_power_spectrum");
        process_exit(1);
    }
    println("prod_gr_fft_cooley_tukey: PASSED");
}
