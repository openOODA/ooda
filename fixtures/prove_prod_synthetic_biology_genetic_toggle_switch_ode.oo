// # Product prove std/synthetic_biology/genetic_toggle_switch_ode.oo
//
// Logline: Fail-closed emit+check asserts toggle_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/genetic_toggle_switch_ode.oo.
//
// Beats:
//   1. Call toggle_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_genetic_toggle_switch_ode: PASSED only if they match.

import "std/synthetic_biology/genetic_toggle_switch_ode.oo";

pub fn main() {
    let genetic_toggle_switch_ode_mark: Int = 0;
    if genetic_toggle_switch_ode_mark != 0 { process_exit(1); }
    let a: Float = toggle_pow(2.0, 3);
    let b: Float = toggle_pow(2.0, 3);
    if a != b { process_exit(1); }
    println("prod_genetic_toggle_switch_ode: PASSED");
}
