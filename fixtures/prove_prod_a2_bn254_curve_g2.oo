// # Product prove std/crypto_advanced/bn254_curve_g2.oo
//
// Logline: Fail-closed emit+gcc+run asserts bn254_g2_infinity is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_curve_g2.oo.
//
// Beats:
//   1. Call bn254_g2_infinity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bn254_curve_g2: PASSED only if they match.

import "std/crypto_advanced/bn254_curve_g2.oo";

pub fn main() {
    let bn254_curve_g2_mark: Int = 0;
    if bn254_curve_g2_mark != 0 {
        process_exit(1);
    }
    let a: Bn254G2Affine = bn254_g2_infinity(0);
    let b: Bn254G2Affine = bn254_g2_infinity(0);
    if (a).is_infinity != (b).is_infinity {
        println("FAIL bn254_g2_infinity");
        process_exit(1);
    }
    println("prod_bn254_curve_g2: PASSED");
}
