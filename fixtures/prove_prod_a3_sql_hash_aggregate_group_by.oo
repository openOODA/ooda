// # Product prove std/db_storage/sql_hash_aggregate_group_by.oo
//
// Logline: Fail-closed emit+gcc+run asserts aggregate_accumulator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_hash_aggregate_group_by.oo.
//
// Beats:
//   1. Call aggregate_accumulator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_hash_aggregate_group_by: PASSED only if they match.

import "std/db_storage/sql_hash_aggregate_group_by.oo";

pub fn main() {
    let sql_hash_aggregate_group_by_mark: Int = 0;
    if sql_hash_aggregate_group_by_mark != 0 {
        process_exit(1);
    }
    let a: AggregateAccumulator = aggregate_accumulator_new();
    let b: AggregateAccumulator = aggregate_accumulator_new();
    if (a).count != (b).count {
        println("FAIL aggregate_accumulator_new");
        process_exit(1);
    }
    println("prod_sql_hash_aggregate_group_by: PASSED");
}
