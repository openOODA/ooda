// # Product prove std/space_propulsion/launch_vehicle_mass_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts stage_compute_mass_budget is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/launch_vehicle_mass_budget.oo.
//
// Beats:
//   1. Call stage_compute_mass_budget twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_vehicle_mass_budget: PASSED only if they match.

import "std/space_propulsion/launch_vehicle_mass_budget.oo";

pub fn main() {
    let launch_vehicle_mass_budget_mark: Int = 0;
    if launch_vehicle_mass_budget_mark != 0 {
        process_exit(1);
    }
    let launch_vehicle_mass_budget_a = stage_compute_mass_budget(stage_mass_inputs_default_booster());
    let launch_vehicle_mass_budget_b = stage_compute_mass_budget(stage_mass_inputs_default_booster());
    if (launch_vehicle_mass_budget_a).tank_structure_mass_kg != (launch_vehicle_mass_budget_b).tank_structure_mass_kg {
        println("FAIL stage_compute_mass_budget");
        process_exit(1);
    }
    println("prod_launch_vehicle_mass_budget: PASSED");
}
