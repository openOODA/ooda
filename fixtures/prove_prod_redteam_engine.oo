// # Product prove std/sec/redteam_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts redteam_engine_init real value.
//
// Setup: Isolated emit-c. Imports std/sec/redteam_engine.oo.
//
// Beats:
//   1. Call redteam_engine_init with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_redteam_engine: PASSED only if the assert holds.

import "std/sec/redteam_engine.oo";

pub fn main() {
    let redteam_engine_a = redteam_engine_init();
    let redteam_engine_global_threat_level: Int = (redteam_engine_a).global_threat_level;
    if redteam_engine_global_threat_level != 1 {
        println("FAIL redteam_engine_init");
        process_exit(1);
    }
    println("prod_redteam_engine: PASSED");
}
