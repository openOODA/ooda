// # Product prove std/web_ecosystem/semver_range.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/semver_range.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/semver_range.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_semver_range: PASSED only if they match.

import "std/web_ecosystem/semver_range.oo";

pub fn main() {
    let semver_range_a = semver_cmp(0, 0, 0, 0, 0, 0);
    let semver_range_b = semver_cmp(0, 0, 0, 0, 0, 0);
    if semver_range_a != semver_range_b {
        println("FAIL semver_range");
        process_exit(1);
    }
    println("prod_ap_semver_range: PASSED");
}
