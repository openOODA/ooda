// # Product prove std/media_dsp/tga_image_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts tga_type_no_image is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/tga_image_parser.oo.
//
// Beats:
//   1. Call tga_type_no_image twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tga_image_parser: PASSED only if they match.

import "std/media_dsp/tga_image_parser.oo";

pub fn main() {
    let tga_image_parser_mark: Int = 0;
    if tga_image_parser_mark != 0 {
        process_exit(1);
    }
    let tga_image_parser_a: Int = tga_type_no_image();
    let tga_image_parser_b: Int = tga_type_no_image();
    if tga_image_parser_a != tga_image_parser_b {
        println("FAIL tga_type_no_image");
        process_exit(1);
    }
    println("prod_tga_image_parser: PASSED");
}
