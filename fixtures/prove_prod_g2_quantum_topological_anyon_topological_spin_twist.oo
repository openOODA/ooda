// # Product prove std/quantum_topological/anyon_topological_spin_twist.oo
//
// Logline: Fail-closed emit+gcc+run asserts ribbon_balancing_phase_diff is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_topological_spin_twist.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ribbon_balancing_phase_diff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_anyon_topological_spin_twist: PASSED only if they match.

import "std/quantum_topological/anyon_topological_spin_twist.oo";

pub fn main() {
    let g2_a = ribbon_balancing_phase_diff(1.0, 1.0, 1.0, 1.0);
    let g2_b = ribbon_balancing_phase_diff(1.0, 1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL ribbon_balancing_phase_diff");
        process_exit(1);
    }
    println("prod_g2_anyon_topological_spin_twist: PASSED");
}
