// # Same-fn bool bind
//
// Logline: Bind true and false lets and print those idents.
//
// Setup: Side emit-aarch64 records KW_TRUE/KW_FALSE lets as string binds.
//
// Beats:
//   1. Bind t to true.
//   2. Bind f to false.
//   3. Print t then f.

pub fn main() {
    let t = true;
    let f = false;
    println(t);
    println(f);
}
