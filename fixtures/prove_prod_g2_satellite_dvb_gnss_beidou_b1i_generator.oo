// # Product prove std/satellite_dvb/gnss_beidou_b1i_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts beidou_step_b1i_chip is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_beidou_b1i_generator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call beidou_step_b1i_chip twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_beidou_b1i_generator: PASSED only if they match.

import "std/satellite_dvb/gnss_beidou_b1i_generator.oo";

pub fn main() {
    let mut g2_oa: BeidouPrnConfig = BeidouPrnConfig { sv_id: 2, g1_state: 2, // 11-bit register
    g2_state: 2, // 11-bit register
    chip_counter: 8, // 0 .. 2045
    g2_tap_a: 2, g2_tap_b: 2 };
    let mut g2_ob: BeidouPrnConfig = BeidouPrnConfig { sv_id: 2, g1_state: 2, // 11-bit register
    g2_state: 2, // 11-bit register
    chip_counter: 8, // 0 .. 2045
    g2_tap_a: 2, g2_tap_b: 2 };
    let g2_a = beidou_step_b1i_chip(&g2_oa);
    let g2_b = beidou_step_b1i_chip(&g2_ob);
    if g2_a != g2_b {
        println("FAIL beidou_step_b1i_chip");
        process_exit(1);
    }
    println("prod_g2_gnss_beidou_b1i_generator: PASSED");
}
