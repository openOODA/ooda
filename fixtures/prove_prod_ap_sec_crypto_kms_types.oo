// # Product prove std/sec/crypto/kms_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kms_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kms_types: PASSED only if they match.

import "std/sec/crypto/kms_types.oo";

pub fn main() {
    let kms_types_a = kms_policy_new(0, 0, 0);
    let kms_types_b = kms_policy_new(0, 0, 0);
    let kms_types_va = kms_policy_uses(kms_types_a);
    let kms_types_vb = kms_policy_uses(kms_types_b);
    if kms_types_va != kms_types_vb {
        println("FAIL kms_types");
        process_exit(1);
    }
    println("prod_ap_kms_types: PASSED");
}
