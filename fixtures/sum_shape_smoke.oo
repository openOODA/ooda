// # User sum type emit lock
//
// Logline: Fail-closed emit+gcc+run of Circle | Rect match.
//
// Setup: Backend-C. Two Int-payload variants.
//
// Beats:
//   1. Circle(3) match yields 3.
//   2. Rect(8) match yields 8.
//   3. Exit 1 before PASSED on a miss.

type Shape = Circle(Int) | Rect(Int);

pub fn main() {
    let s: Shape = Circle(3);
    let v: Int = match s {
        Circle(r) => r,
        Rect(w) => w
    };
    if v != 3 {
        println("FAIL circle");
        process_exit(1);
    }
    let s2: Shape = Rect(8);
    let v2: Int = match s2 {
        Circle(r) => r,
        Rect(w) => w
    };
    if v2 != 8 {
        println("FAIL rect");
        process_exit(1);
    }
    println("sum_shape_smoke: PASSED");
}
