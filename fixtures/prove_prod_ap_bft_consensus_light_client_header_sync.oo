// # Product prove std/bft_consensus/light_client_header_sync.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/light_client_header_sync.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/light_client_header_sync.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_light_client_header_sync: PASSED only if they match.

import "std/bft_consensus/light_client_header_sync.oo";

pub fn main() {
    let light_client_header_sync_a = light_client_check_voting_power_overlap(0, 0);
    let light_client_header_sync_b = light_client_check_voting_power_overlap(0, 0);
    if light_client_header_sync_a != light_client_header_sync_b {
        println("FAIL light_client_header_sync");
        process_exit(1);
    }
    println("prod_ap_light_client_header_sync: PASSED");
}
