// # Product Prove std/security_defense/capability_delegation_audit.oo
//
// Logline: Deterministic assertion fixture verifying POSIX capability bounding set verification and privilege dropping audit.
//
// Setup: Isolated emit-c test fixture importing std/security_defense/capability_delegation_audit.oo.
//
// Beats:
//   1. Construct ProcessCapabilityState.
//   2. Check dangerous capabilities detection.
//   3. Verify valid drop vs invalid drop scenarios.
//   4. Print "prod_g4_sec_capability_delegation_audit: PASSED".

import "std/security_defense/capability_delegation_audit.oo";

pub fn main() {
    let mut state: ProcessCapabilityState = process_cap_state_new(1337);

    // Initial empty state (non-root, no dangerous caps)
    let ok_init: Bool = capability_audit_verify_drop(&state);
    if !ok_init {
        println("FAIL: initial state drop failed");
        process_exit(1);
    }

    // Dangerous cap in effective
    (state).effective.cap_sys_admin = true;
    let has_dang: Bool = capability_set_has_dangerous(&(state).effective);
    if !has_dang {
        println("FAIL: failed to detect cap_sys_admin");
        process_exit(1);
    }

    let bad_drop: Bool = capability_audit_verify_drop(&state);
    if bad_drop {
        println("FAIL: state with cap_sys_admin should fail verify_drop");
        process_exit(1);
    }

    // Reset effective, add dangerous bounding cap
    (state).effective.cap_sys_admin = false;
    (state).bounding.cap_sys_module = true;
    let bad_bound: Bool = capability_audit_verify_drop(&state);
    if bad_bound {
        println("FAIL: state with bounding cap_sys_module should fail verify_drop");
        process_exit(1);
    }

    println("prod_g4_sec_capability_delegation_audit: PASSED");
    process_exit(0);
}
