// # Product prove std/compilers_polyhedral/affine_memory_expansion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/affine_memory_expansion.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_memory_expansion.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_affine_memory_expansion: PASSED only if they match.

import "std/compilers_polyhedral/affine_memory_expansion.oo";

pub fn main() {
    let affine_memory_expansion_a = variable_expansion_plan_new("x", 0, 0);
    let affine_memory_expansion_b = variable_expansion_plan_new("x", 0, 0);
    if affine_memory_expansion_a.variable_name != affine_memory_expansion_b.variable_name {
        println("FAIL affine_memory_expansion");
        process_exit(1);
    }
    println("prod_ap_affine_memory_expansion: PASSED");
}
