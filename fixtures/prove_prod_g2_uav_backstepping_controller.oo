// # Product prove std/uav_flight/uav_backstepping_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts backstepping_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_backstepping_controller.oo.
//
// Beats:
//   1. Call backstepping_gains_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_backstepping_controller: PASSED only if they match.

import "std/uav_flight/uav_backstepping_controller.oo";

pub fn main() {
    let uav_backstepping_controller_mark: Int = 0;
    if uav_backstepping_controller_mark != 0 {
        process_exit(1);
    }
    let a: BacksteppingGains = backstepping_gains_default();
    let b: BacksteppingGains = backstepping_gains_default();
    if (a).c1_pos != (b).c1_pos {
        println("FAIL backstepping_gains_default");
        process_exit(1);
    }
    println("prod_g2_uav_backstepping_controller: PASSED");
}
