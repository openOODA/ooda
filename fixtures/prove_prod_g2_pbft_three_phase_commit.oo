// # Product prove std/bft_consensus/pbft_three_phase_commit.oo
//
// Logline: Fail-closed emit+gcc+run asserts pbft_quorum_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/pbft_three_phase_commit.oo.
//
// Beats:
//   1. Call pbft_quorum_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pbft_three_phase_commit: PASSED only if they match.

import "std/bft_consensus/pbft_three_phase_commit.oo";

pub fn main() {
    let pbft_three_phase_commit_mark: Int = 0;
    if pbft_three_phase_commit_mark != 0 {
        process_exit(1);
    }
    let a: Int = pbft_quorum_threshold(0);
    let b: Int = pbft_quorum_threshold(0);
    if a != b {
        println("FAIL pbft_quorum_threshold");
        process_exit(1);
    }
    println("prod_g2_pbft_three_phase_commit: PASSED");
}
