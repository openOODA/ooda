// # Product prove std/compilers_vm/wasm_simd128_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_v128_const is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_simd128_encoder.oo.
//
// Beats:
//   1. Call simd_v128_const twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_simd128_encoder: PASSED only if they match.

import "std/compilers_vm/wasm_simd128_encoder.oo";

pub fn main() {
    let wasm_simd128_encoder_mark: Int = 0;
    if wasm_simd128_encoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = simd_v128_const();
    let b: Int = simd_v128_const();
    if a != b {
        println("FAIL simd_v128_const");
        process_exit(1);
    }
    println("prod_wasm_simd128_encoder: PASSED");
}
