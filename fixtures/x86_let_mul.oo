// # emit-x86 let-bound const-int ALU
//
// Logline: Bind n to 2 times 3 and print n so emit-x86 does not bind the first 2.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Bind n to 2 times 3.
//   2. Print n.
//   3. as+ld stdout is 6, not 2.
//
// residual: call-ident lets stay leftover.

pub fn main() {
    let n = 2 * 3;
    println(n);
}
