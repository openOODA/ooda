// # Product prove std/media_dsp/adpcm_ima_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_step_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/adpcm_ima_decoder.oo.
//
// Beats:
//   1. Call ima_step_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_adpcm_ima_decoder: PASSED only if they match.

import "std/media_dsp/adpcm_ima_decoder.oo";

pub fn main() {
    let adpcm_ima_decoder_mark: Int = 0;
    if adpcm_ima_decoder_mark != 0 {
        process_exit(1);
    }
    let adpcm_ima_decoder_a: Int = ima_step_size(1);
    let adpcm_ima_decoder_b: Int = ima_step_size(1);
    if adpcm_ima_decoder_a != adpcm_ima_decoder_b {
        println("FAIL ima_step_size");
        process_exit(1);
    }
    println("prod_adpcm_ima_decoder: PASSED");
}
