// # Product prove std/db_columnar/arrow_null_bitmap.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/arrow_null_bitmap.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_null_bitmap.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_arrow_null_bitmap: PASSED only if they match.

import "std/db_columnar/arrow_null_bitmap.oo";

pub fn main() {
    let arrow_null_bitmap_a = null_bitmap_buffer_new(0);
    let arrow_null_bitmap_b = null_bitmap_buffer_new(0);
    let arrow_null_bitmap_va = null_bitmap_is_valid(arrow_null_bitmap_a, 0);
    let arrow_null_bitmap_vb = null_bitmap_is_valid(arrow_null_bitmap_b, 0);
    if arrow_null_bitmap_va != arrow_null_bitmap_vb {
        println("FAIL arrow_null_bitmap");
        process_exit(1);
    }
    println("prod_ap_arrow_null_bitmap: PASSED");
}
