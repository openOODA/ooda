// M161/M165 path A: GpuCap main-grant → residual Err for non-noop device shaders.
// main injects: long long gpu = oo_cap_grant_gpu();
// Annotate Result so Backend-C binds OoResS (is_err) without c_call_result_ty.
// "noop"/"cpu:…" are product Ok paths (see fixtures/gpu_path_a.oo).
pub fn main(gpu: &GpuCap) {
    let r: Result[String, String] = gpu_launch(gpu, "shader0");
    if r.is_err() {
        println("gpu-residual-ok");
    } else {
        println("unexpected-ok");
    }
}
