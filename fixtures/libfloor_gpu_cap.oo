// M161 path A: GpuCap main-grant → residual Err (no GPU shaders).
// main injects: long long gpu = oo_cap_grant_gpu();
// Annotate Result so Backend-C binds OoResS (is_err) without c_call_result_ty.
pub fn main(gpu: &GpuCap) {
    let r: Result[String, String] = gpu_launch(gpu, "noop");
    if r.is_err() {
        println("gpu-residual-ok");
    } else {
        println("unexpected-ok");
    }
}
