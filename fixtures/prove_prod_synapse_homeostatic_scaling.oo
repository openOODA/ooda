// # Product prove std/neuro_bci/synapse_homeostatic_scaling.oo
//
// Logline: Fail-closed emit+gcc+run asserts homeostatic_params_default real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/synapse_homeostatic_scaling.oo.
//
// Beats:
//   1. Call homeostatic_params_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synapse_homeostatic_scaling: PASSED only if the assert holds.

import "std/neuro_bci/synapse_homeostatic_scaling.oo";

pub fn main() {
    let synapse_homeostatic_scaling_mark: Int = 0;
    if synapse_homeostatic_scaling_mark != 0 {
        process_exit(1);
    }
    let synapse_homeostatic_scaling_a = homeostatic_params_default();
    let synapse_homeostatic_scaling_target_rate_hz: Float = (synapse_homeostatic_scaling_a).target_rate_hz;
    if !(synapse_homeostatic_scaling_target_rate_hz == 5.0) {
        println("FAIL homeostatic_params_default");
        process_exit(1);
    }
    println("prod_synapse_homeostatic_scaling: PASSED");
}
