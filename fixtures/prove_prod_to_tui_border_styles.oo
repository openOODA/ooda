// # Product prove std/tui/border_styles.oo
//
// Logline: Fail-closed emit+gcc+run asserts border_sides_all holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/border_styles.oo.
//
// Beats:
//   1. Call border_sides_all using the border_styles ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_border_styles: PASSED only if asserts hold.

import "std/tui/border_styles.oo";

pub fn main() {
    let obj = border_sides_all();
    let border_styles_a = obj.top;
    if !border_styles_a {
        println("FAIL border_sides_all");
        process_exit(1);
    }
    println("prod_border_styles: PASSED");
}
