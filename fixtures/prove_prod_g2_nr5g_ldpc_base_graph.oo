// # Product prove std/telecom_5g/nr5g_ldpc_base_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_ldpc_select_graph is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_ldpc_base_graph.oo.
//
// Beats:
//   1. Call nr5g_ldpc_select_graph twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nr5g_ldpc_base_graph: PASSED only if they match.

import "std/telecom_5g/nr5g_ldpc_base_graph.oo";

pub fn main() {
    let nr5g_ldpc_base_graph_mark: Int = 0;
    if nr5g_ldpc_base_graph_mark != 0 {
        process_exit(1);
    }
    let a: Int = nr5g_ldpc_select_graph(0, 0);
    let b: Int = nr5g_ldpc_select_graph(0, 0);
    if a != b {
        println("FAIL nr5g_ldpc_select_graph");
        process_exit(1);
    }
    println("prod_g2_nr5g_ldpc_base_graph: PASSED");
}
