// # Product utf8_stream prove
//
// Logline: Fail-closed emit+gcc+run of shipped utf8_lead_byte_len / utf8_reader_new.
//
// Setup: Product std/text/utf8_stream.oo. ASCII lead is 1; 0xC0 lead is 2.
//
// Beats:
//   1. Lead 65 is length 1; lead 192 is length 2.
//   2. Reader of "hi" has_next true.
//   3. Exit 1 before PASSED on a miss.

import "std/text/utf8_stream.oo";

pub fn main() {
    let a: Int = utf8_lead_byte_len(65);
    if a != 1 {
        println("FAIL utf8stream lead A");
        process_exit(1);
    }
    let b: Int = utf8_lead_byte_len(192);
    if b != 2 {
        println("FAIL utf8stream lead C0");
        process_exit(1);
    }
    let r: Utf8Reader = utf8_reader_new("hi");
    let h: Bool = utf8_reader_has_next(r);
    if h == false {
        println("FAIL utf8stream has");
        process_exit(1);
    }
    println("prod_utf8stream: PASSED");
}
