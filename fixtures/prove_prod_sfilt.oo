// # Product stream_filter prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_filter_gt.
//
// Setup: Product std/io/stream_filter.oo. List[Int] destub.
//
// Beats:
//   1. [1,5,3] gt 2 keeps 5 then 3; len 2.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_filter.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 5);
    xs = list_push(xs, 3);
    let f: StreamFilter = stream_filter_gt(xs, 2);
    let n: Int = stream_filter_len(f);
    if n != 2 {
        println("FAIL filt len");
        process_exit(1);
    }
    let g0: Int = stream_filter_get(f, 0);
    if g0 != 5 {
        println("FAIL filt first");
        process_exit(1);
    }
    println("prod_sfilt: PASSED");
}
