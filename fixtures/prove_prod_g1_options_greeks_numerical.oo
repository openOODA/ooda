// # Product prove std/defi_derivatives/options_greeks_numerical.oo
//
// Logline: Fail-closed emit+gcc+run asserts numerical_greeks_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_greeks_numerical.oo.
//
// Beats:
//   1. Call numerical_greeks_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_greeks_numerical: PASSED only if they match.

import "std/defi_derivatives/options_greeks_numerical.oo";

pub fn main() {
    let a: NumericalGreeksConfig = numerical_greeks_config_default();
    let b: NumericalGreeksConfig = numerical_greeks_config_default();
    if a.spot_bump_pct != b.spot_bump_pct {
        println("FAIL numerical_greeks_config_default");
        process_exit(1);
    }
    println("prod_options_greeks_numerical: PASSED");
}
