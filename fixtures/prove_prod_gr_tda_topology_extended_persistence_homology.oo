// # Product prove std/tda_topology/extended_persistence_homology.oo
//
// Logline: Fail-closed emit+gcc+run asserts extended_diagram_count_type is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/extended_persistence_homology.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call extended_diagram_count_type twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_extended_persistence_homology: PASSED only if they match.

import "std/tda_topology/extended_persistence_homology.oo";

pub fn main() {
    let g0_oa = extended_diagram_new(0);
    let g0_ob = extended_diagram_new(0);
    let g0_a = extended_diagram_count_type(&g0_oa, 0);
    let g0_b = extended_diagram_count_type(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL extended_diagram_count_type");
        process_exit(1);
    }
    println("prod_gr_extended_persistence_homology: PASSED");
}
