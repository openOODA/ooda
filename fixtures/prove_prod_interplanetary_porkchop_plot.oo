// # Product prove std/astro_advanced/interplanetary_porkchop_plot.oo
//
// Logline: Fail-closed emit+gcc+run asserts porkchop_c3 is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/interplanetary_porkchop_plot.oo.
//
// Beats:
//   1. Call porkchop_c3 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_interplanetary_porkchop_plot: PASSED only if they match.

import "std/astro_advanced/interplanetary_porkchop_plot.oo";

pub fn main() {
    let a = porkchop_c3();
    let b = porkchop_c3();
    if a != b {
        println("FAIL porkchop_c3");
        process_exit(1);
    }
    println("prod_interplanetary_porkchop_plot: PASSED");
}
