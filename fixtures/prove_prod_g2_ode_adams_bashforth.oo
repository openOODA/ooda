// # Product prove std/scicomp/ode_adams_bashforth.oo
//
// Logline: Fail-closed emit+gcc+run asserts adams_history_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/ode_adams_bashforth.oo.
//
// Beats:
//   1. Call adams_history_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ode_adams_bashforth: PASSED only if they match.

import "std/scicomp/ode_adams_bashforth.oo";

pub fn main() {
    let ode_adams_bashforth_mark: Int = 0;
    if ode_adams_bashforth_mark != 0 {
        process_exit(1);
    }
    let a: AdamsHistory = adams_history_new();
    let b: AdamsHistory = adams_history_new();
    if (a).steps_available != (b).steps_available {
        println("FAIL adams_history_new");
        process_exit(1);
    }
    println("prod_g2_ode_adams_bashforth: PASSED");
}
