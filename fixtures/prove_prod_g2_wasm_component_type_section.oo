// # Product prove std/wasm_gc/wasm_component_type_section.oo
//
// Logline: Fail-closed emit+gcc+run asserts comp_type_decl_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_type_section.oo.
//
// Beats:
//   1. Call comp_type_decl_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_component_type_section: PASSED only if they match.

import "std/wasm_gc/wasm_component_type_section.oo";

pub fn main() {
    let wasm_component_type_section_mark: Int = 0;
    if wasm_component_type_section_mark != 0 {
        process_exit(1);
    }
    let a: ComponentTypeDecl = comp_type_decl_new(0, "x", 0, 0);
    let b: ComponentTypeDecl = comp_type_decl_new(0, "x", 0, 0);
    if (a).tag != (b).tag {
        println("FAIL comp_type_decl_new");
        process_exit(1);
    }
    println("prod_g2_wasm_component_type_section: PASSED");
}
