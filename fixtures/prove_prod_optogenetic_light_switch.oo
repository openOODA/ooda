// # Product prove std/synthetic_biology/optogenetic_light_switch.oo
//
// Logline: Fail-closed emit+gcc+run asserts opto_derivatives real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/optogenetic_light_switch.oo.
//
// Beats:
//   1. Call opto_derivatives with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_optogenetic_light_switch: PASSED only if the assert holds.

import "std/synthetic_biology/optogenetic_light_switch.oo";

pub fn main() {
    let optogenetic_light_switch_mark: Int = 0;
    if optogenetic_light_switch_mark != 0 {
        process_exit(1);
    }
    let optogenetic_light_switch_st: OptoPhotoreceptorState = OptoPhotoreceptorState { dark_inactive_fraction: 0.0, light_active_fraction: 0.0, mrna_output_conc: 0.0, time_seconds: 0.0 };
    let optogenetic_light_switch_p: OptoParams = OptoParams { k_photo_activation: 0.0, k_thermal_reversion: 0.0, k_transcription_max: 0.0, k_transcription_basal: 0.0, d_mrna: 0.0 };
    let optogenetic_light_switch_a = opto_derivatives(&optogenetic_light_switch_st, &optogenetic_light_switch_p, 0.0);
    let optogenetic_light_switch_time_seconds: Float = (optogenetic_light_switch_a).time_seconds;
    if !(optogenetic_light_switch_time_seconds == 0.0) {
        println("FAIL opto_derivatives");
        process_exit(1);
    }
    println("prod_optogenetic_light_switch: PASSED");
}
