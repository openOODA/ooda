// # Product prove std/sec/crypto/zksnark_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts zksnark_calculate_string_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_hash.oo.
//
// Beats:
//   1. Call zksnark_calculate_string_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zksnark_hash: PASSED only if they match.

import "std/sec/crypto/zksnark_hash.oo";

pub fn main() {
    let a = zksnark_calculate_string_hash("x");
    let b = zksnark_calculate_string_hash("x");
    if a != b {
        println("FAIL zksnark_calculate_string_hash");
        process_exit(1);
    }
    println("prod_zksnark_hash: PASSED");
}
