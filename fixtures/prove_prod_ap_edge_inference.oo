// # Product prove std/edge/inference.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/inference.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_inference: PASSED only if they match.

import "std/edge/inference.oo";

pub fn main() {
    let inference_a = shim_marker_can_process();
    let inference_b = shim_marker_can_process();
    if inference_a != inference_b {
        println("FAIL inference");
        process_exit(1);
    }
    println("prod_ap_inference: PASSED");
}
