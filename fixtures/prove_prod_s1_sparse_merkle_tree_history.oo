// # Product prove std/zk_rollup/sparse_merkle_tree_history.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_history_log_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_history.oo.
//
// Beats:
//   1. Call smt_history_log_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_merkle_tree_history: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_history.oo";

pub fn main() {
    let sparse_merkle_tree_history_mark: Int = 0;
    if sparse_merkle_tree_history_mark != 0 {
        process_exit(1);
    }
    let sparse_merkle_tree_history_a = smt_history_log_new();
    let sparse_merkle_tree_history_b = smt_history_log_new();
    if (sparse_merkle_tree_history_a).latest_height != (sparse_merkle_tree_history_b).latest_height {
        println("FAIL smt_history_log_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_history: PASSED");
}
