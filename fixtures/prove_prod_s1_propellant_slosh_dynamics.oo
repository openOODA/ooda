// # Product prove std/space_propulsion/propellant_slosh_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts slosh_compute_mechanical_model is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_slosh_dynamics.oo.
//
// Beats:
//   1. Call slosh_compute_mechanical_model twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_slosh_dynamics: PASSED only if they match.

import "std/space_propulsion/propellant_slosh_dynamics.oo";

pub fn main() {
    let propellant_slosh_dynamics_mark: Int = 0;
    if propellant_slosh_dynamics_mark != 0 {
        process_exit(1);
    }
    let propellant_slosh_dynamics_a = slosh_compute_mechanical_model(tank_slosh_spec_default());
    let propellant_slosh_dynamics_b = slosh_compute_mechanical_model(tank_slosh_spec_default());
    if (propellant_slosh_dynamics_a).total_liquid_mass_kg != (propellant_slosh_dynamics_b).total_liquid_mass_kg {
        println("FAIL slosh_compute_mechanical_model");
        process_exit(1);
    }
    println("prod_propellant_slosh_dynamics: PASSED");
}
