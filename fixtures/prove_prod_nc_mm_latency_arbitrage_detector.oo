// # Product prove std/hft_alpha/mm_latency_arbitrage_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_latency_arbitrage_detector_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_latency_arbitrage_detector.oo.
//
// Beats:
//   1. Call mm_latency_arbitrage_detector_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_mm_latency_arbitrage_detector: PASSED only if it matches.

import "std/hft_alpha/mm_latency_arbitrage_detector.oo";

pub fn main() {
    let a: Int = mm_latency_arbitrage_detector_probe();
    if a != 0 {
        println("FAIL mm_latency_arbitrage_detector_probe");
        process_exit(1);
    }
    println("prod_nc_mm_latency_arbitrage_detector: PASSED");
}
