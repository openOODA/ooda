// # Product prove std/sec/crypto/groth16_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/groth16_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_groth16_stubs: PASSED and exit 0 only on match.

import "std/sec/crypto/groth16_stubs.oo";

pub fn main() {
    let probe_a: Int = groth16_stubs_probe();
    let probe_b: Int = groth16_stubs_probe();
    if probe_a != probe_b {
        println("FAIL groth16_stubs probe");
        process_exit(1);
    }

    let setup_a: Groth16Setup = groth16_setup_new(1, 2);
    let setup_b: Groth16Setup = groth16_setup_new(1, 2);
    let bytes_a: Int = groth16_setup_bytes(setup_a);
    let bytes_b: Int = groth16_setup_bytes(setup_b);
    if bytes_a != bytes_b {
        println("FAIL groth16_stubs setup bytes");
        process_exit(1);
    }

    println("prod_g4_sec_groth16_stubs: PASSED");
    process_exit(0);
}
