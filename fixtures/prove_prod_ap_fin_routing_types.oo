// # Product prove std/fin/routing_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/routing_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_routing_types: PASSED only if they match.

import "std/fin/routing_types.oo";

pub fn main() {
    let routing_types_a = order_route_new(0, 0, 0);
    let routing_types_b = order_route_new(0, 0, 0);
    let routing_types_va = order_route_qty(routing_types_a);
    let routing_types_vb = order_route_qty(routing_types_b);
    if routing_types_va != routing_types_vb {
        println("FAIL routing_types");
        process_exit(1);
    }
    println("prod_ap_routing_types: PASSED");
}
