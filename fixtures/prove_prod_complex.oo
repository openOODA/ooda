// # Product complex prove
//
// Logline: Fail-closed emit+gcc+run of shipped complex_add/mul/mag.
//
// Setup: Product std/math/complex.oo. 3+4i magnitude 5.
//
// Beats:
//   1. (1+2i)+(3+4i) is 4+6i.
//   2. i*i is -1+0i.
//   3. magnitude of 3+4i is 5.0.
//   4. Exit 1 before PASSED on a miss.

import "std/math/complex.oo";

pub fn main() {
    let a: Complex = complex_new(1.0, 2.0);
    let b: Complex = complex_new(3.0, 4.0);
    let s: Complex = complex_add(a, b);
    let sr: Float = s.re;
    let si: Float = s.im;
    if sr != 4.0 {
        println("FAIL complex add re");
        process_exit(1);
    }
    if si != 6.0 {
        println("FAIL complex add im");
        process_exit(1);
    }
    let ii: Complex = complex_mul(complex_i(), complex_i());
    let ir: Float = ii.re;
    let iiim: Float = ii.im;
    if ir != 0.0 - 1.0 {
        println("FAIL complex i*i re");
        process_exit(1);
    }
    if iiim != 0.0 {
        println("FAIL complex i*i im");
        process_exit(1);
    }
    let m: Float = complex_mag(b);
    if m != 5.0 {
        println("FAIL complex mag");
        process_exit(1);
    }
    println("prod_complex: PASSED");
}
