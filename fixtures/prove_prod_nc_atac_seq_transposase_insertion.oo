//
// Setup: Isolated emit-c. Imports std/genomics_advanced/atac_seq_transposase_insertion.oo.
//
// Beats:
//   1. Call atac_seq_transposase_insertion_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_atac_seq_transposase_insertion: PASSED only if it matches.

import "std/genomics_advanced/atac_seq_transposase_insertion.oo";

pub fn main() {
    let a: Int = atac_seq_transposase_insertion_probe();
    if a != 0 {
        println("FAIL atac_seq_transposase_insertion_probe");
        process_exit(1);
    }
    println("prod_nc_atac_seq_transposase_insertion: PASSED");
}
