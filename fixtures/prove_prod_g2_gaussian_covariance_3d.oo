// # Product prove std/nerf_3dgs/gaussian_covariance_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian_covariance_3d_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_covariance_3d.oo.
//
// Beats:
//   1. Call gaussian_covariance_3d_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gaussian_covariance_3d: PASSED only if they match.

import "std/nerf_3dgs/gaussian_covariance_3d.oo";

pub fn main() {
    let a: Int = gaussian_covariance_3d_probe();
    let b: Int = gaussian_covariance_3d_probe();
    if a != b {
        println("FAIL gaussian_covariance_3d_probe");
        process_exit(1);
    }
    println("prod_g2_gaussian_covariance_3d: PASSED");
}
