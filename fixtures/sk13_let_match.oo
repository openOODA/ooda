// # let v = match must stay OK
//
// Logline: Unused-import and unused-let must not refuse a used match bind.
//
// Setup: Isolated check. v is the match result; n is used.
//
// Beats:
//   1. Bind r to Ok(1).
//   2. Bind v from match Ok(n)/Err(e).
//   3. Print v. check must print OK.

pub fn main() {
    let r = Ok(1);
    let v = match r {
        Ok(n) => n,
        Err(e) => 0
    };
    println(v);
}
