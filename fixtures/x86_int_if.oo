// # emit-x86 const INT==INT if
//
// Logline: Print yes from if 1==1 else no so emit-x86 can fold a const-int compare.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. if 1==1 print yes else print no.
//   3. Expect yes only.

pub fn main() {
    if 1 == 1 {
        println("yes");
    } else {
        println("no");
    }
}
