// # emit-x86 typed const-int let
//
// Logline: Bind typed n to 7 and print n so emit-x86 can lower a typed const let.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Bind n as Int 7.
//   3. as+ld stdout is 7.
//
// residual: SysV stays later.

pub fn main() {
    let n: Int = 7;
    println(n);
}
