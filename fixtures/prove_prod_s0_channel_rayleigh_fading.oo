// # Product prove std/telecom_5g/channel_rayleigh_fading.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_rayleigh_pdf value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_rayleigh_fading.oo.
//
// Beats:
//   1. Call channel_rayleigh_pdf twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_channel_rayleigh_fading: PASSED only if asserts hold.

import "std/telecom_5g/channel_rayleigh_fading.oo";

pub fn main() {
    let channel_rayleigh_fading_a: Float = channel_rayleigh_pdf(0.0, 0.0);
    let channel_rayleigh_fading_b: Float = channel_rayleigh_pdf(0.0, 0.0);
    if channel_rayleigh_fading_a != channel_rayleigh_fading_b {
        println("FAIL channel_rayleigh_pdf");
        process_exit(1);
    }
    println("prod_channel_rayleigh_fading: PASSED");
}
