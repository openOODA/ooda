// # Product prove std/robotics_auv/pure_pursuit_underwater.oo
//
// Logline: Fail-closed emit+gcc+run asserts pure_pursuit_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/pure_pursuit_underwater.oo.
//
// Beats:
//   1. Call pure_pursuit_config_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pure_pursuit_underwater: PASSED only if they match.

import "std/robotics_auv/pure_pursuit_underwater.oo";

pub fn main() {
    let pure_pursuit_underwater_mark: Int = 0;
    if pure_pursuit_underwater_mark != 0 {
        process_exit(1);
    }
    let a: PurePursuitConfig = pure_pursuit_config_default();
    let b: PurePursuitConfig = pure_pursuit_config_default();
    if (a).min_lookahead_m != (b).min_lookahead_m {
        println("FAIL pure_pursuit_config_default");
        process_exit(1);
    }
    println("prod_pure_pursuit_underwater: PASSED");
}
