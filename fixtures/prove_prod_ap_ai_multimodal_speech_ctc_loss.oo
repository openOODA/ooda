// # Product prove std/ai_multimodal/speech_ctc_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/speech_ctc_loss.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/speech_ctc_loss.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_speech_ctc_loss: PASSED only if they match.

import "std/ai_multimodal/speech_ctc_loss.oo";

pub fn main() {
    let speech_ctc_loss_a = ctc_log_add(0, 0);
    let speech_ctc_loss_b = ctc_log_add(0, 0);
    if speech_ctc_loss_a != speech_ctc_loss_b {
        println("FAIL speech_ctc_loss");
        process_exit(1);
    }
    println("prod_ap_speech_ctc_loss: PASSED");
}
