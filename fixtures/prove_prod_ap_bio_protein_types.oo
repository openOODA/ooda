// # Product prove std/bio/protein_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/protein_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_types: PASSED only if they match.

import "std/bio/protein_types.oo";

pub fn main() {
    let protein_types_a = protein_point3d_new(0, 0, 0);
    let protein_types_b = protein_point3d_new(0, 0, 0);
    let protein_types_va = protein_point3d_x(protein_types_a);
    let protein_types_vb = protein_point3d_x(protein_types_b);
    if protein_types_va != protein_types_vb {
        println("FAIL protein_types");
        process_exit(1);
    }
    println("prod_ap_protein_types: PASSED");
}
