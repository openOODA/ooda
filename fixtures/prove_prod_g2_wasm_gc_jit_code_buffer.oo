// # Product prove std/wasm_gc/jit_code_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts relocation_patch_new is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_code_buffer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call relocation_patch_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jit_code_buffer: PASSED only if they match.

import "std/wasm_gc/jit_code_buffer.oo";

pub fn main() {
    let g2_oa: RelocationPatch = relocation_patch_new(2, 2);
    let g2_ob: RelocationPatch = relocation_patch_new(2, 2);
    let g2_a = (g2_oa).patch_offset;
    let g2_b = (g2_ob).patch_offset;
    if g2_a != g2_b {
        println("FAIL relocation_patch_new.patch_offset");
        process_exit(1);
    }
    println("prod_g2_jit_code_buffer: PASSED");
}
