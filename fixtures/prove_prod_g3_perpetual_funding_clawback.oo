// # Product prove std/defi_derivatives/perpetual_funding_clawback.oo
//
// Logline: Fail-closed emit+gcc+run asserts funding_pool_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_funding_clawback.oo.
//
// Beats:
//   1. Call funding_pool_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_perpetual_funding_clawback: PASSED only if they match.

import "std/defi_derivatives/perpetual_funding_clawback.oo";

pub fn main() {
    let perpetual_funding_clawback_mark: Int = 0;
    if perpetual_funding_clawback_mark != 0 {
        process_exit(1);
    }
    let a: FundingPoolBalance = funding_pool_new(0.0, 0.0, 0.0, 0.0);
    let b: FundingPoolBalance = funding_pool_new(0.0, 0.0, 0.0, 0.0);
    if (a).total_long_oi_usd != (b).total_long_oi_usd {
        println("FAIL funding_pool_new");
        process_exit(1);
    }
    println("prod_perpetual_funding_clawback: PASSED");
}
