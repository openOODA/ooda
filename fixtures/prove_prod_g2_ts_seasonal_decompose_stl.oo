// # Product prove std/industrial_predictive/ts_seasonal_decompose_stl.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_seasonal_decompose_stl.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ts_seasonal_decompose_stl: PASSED only if they match.

import "std/industrial_predictive/ts_seasonal_decompose_stl.oo";

pub fn main() {
    let ts_seasonal_decompose_stl_mark: Int = 0;
    if ts_seasonal_decompose_stl_mark != 0 {
        process_exit(1);
    }
    let a: Float = int_to_float(0);
    let b: Float = int_to_float(0);
    if a != b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_g2_ts_seasonal_decompose_stl: PASSED");
}
