// # Product prove std/hft_alpha/mm_kyle_lambda_impact.oo
//
// Logline: Fail-closed emit+gcc+run asserts kyle_compute_lambda is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_kyle_lambda_impact.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kyle_compute_lambda twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_kyle_lambda_impact: PASSED only if they match.

import "std/hft_alpha/mm_kyle_lambda_impact.oo";

pub fn main() {
    let g2_oa: KyleParams = KyleParams { fundamental_variance_v: 1.0, noise_order_variance_u: 1.0, prior_mean_p0: 1.0 };
    let g2_ob: KyleParams = KyleParams { fundamental_variance_v: 1.0, noise_order_variance_u: 1.0, prior_mean_p0: 1.0 };
    let g2_a = kyle_compute_lambda(&g2_oa);
    let g2_b = kyle_compute_lambda(&g2_ob);
    if g2_a != g2_b {
        println("FAIL kyle_compute_lambda");
        process_exit(1);
    }
    println("prod_g2_mm_kyle_lambda_impact: PASSED");
}
