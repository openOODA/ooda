// # Allow clean field read from struct literal
//
// Logline: A clean struct field read stays allowed when a secret sits beside it.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag secret_val as secret.
//   2. Build Pair with clean field values.
//   3. Print field p.b so the sink stays allowed.
//
// clean struct field stays allowed
type Pair = struct { a: String, b: String };
// SECRET: secret_val
pub fn main() {
    let secret_val = "sensitive_data";
    let p = Pair { a: "clean_a", b: "clean_b" };
    println(p.b);
}
