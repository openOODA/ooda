// # Product prove std/telecom/telecom_stubs.oo
//
// Logline: Fail-closed verification that telecom SDR hardware capability tokens and defaults are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/telecom_stubs.oo.
//
// Beats:
//   1. Query telecom hardware capabilities default structure.
//   2. Validate channel count and maximum sample rate.
//   3. Assert deterministic return values.
//   4. Print prod_g4_telecom_stubs: PASSED and exit 0.

import "std/telecom/telecom_stubs.oo";

pub fn main() {
    let a: TelecomHardwareCapabilities = telecom_hardware_capabilities_default();
    let b: TelecomHardwareCapabilities = telecom_hardware_capabilities_default();

    if (a).num_rf_channels != (b).num_rf_channels || (a).num_rf_channels != 2 {
        println("FAIL telecom_hardware_capabilities_default num_rf_channels");
        process_exit(1);
    }

    if (a).max_sample_rate_msps != (b).max_sample_rate_msps || (a).max_sample_rate_msps != 56.0 {
        println("FAIL telecom_hardware_capabilities_default max_sample_rate_msps");
        process_exit(1);
    }

    if (a).supports_fpga_dma != (b).supports_fpga_dma || (a).supports_fpga_dma != 0 {
        println("FAIL telecom_hardware_capabilities_default supports_fpga_dma");
        process_exit(1);
    }

    println("prod_g4_telecom_stubs: PASSED");
    process_exit(0);
}
