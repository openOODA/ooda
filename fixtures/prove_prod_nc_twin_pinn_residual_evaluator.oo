// # Product prove std/digital_twin/twin_pinn_residual_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_pinn_residual_evaluator_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_pinn_residual_evaluator.oo.
//
// Beats:
//   1. Call twin_pinn_residual_evaluator_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_twin_pinn_residual_evaluator: PASSED only if it matches.

import "std/digital_twin/twin_pinn_residual_evaluator.oo";

pub fn main() {
    let a: Int = twin_pinn_residual_evaluator_probe();
    if a != 0 {
        println("FAIL twin_pinn_residual_evaluator_probe");
        process_exit(1);
    }
    println("prod_nc_twin_pinn_residual_evaluator: PASSED");
}
