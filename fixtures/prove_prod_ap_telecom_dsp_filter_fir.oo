// # Product prove std/telecom/dsp_filter_fir.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/dsp_filter_fir.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/dsp_filter_fir.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dsp_filter_fir: PASSED only if they match.

import "std/telecom/dsp_filter_fir.oo";

pub fn main() {
    let dsp_filter_fir_a = fir_pi();
    let dsp_filter_fir_b = fir_pi();
    if dsp_filter_fir_a != dsp_filter_fir_b {
        println("FAIL dsp_filter_fir");
        process_exit(1);
    }
    println("prod_ap_dsp_filter_fir: PASSED");
}
