// # Product prove std/auto/fusion_sensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts fus_sens_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_sensor.oo.
//
// Beats:
//   1. Call fus_sens_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fusion_sensor: PASSED only if they match.

import "std/auto/fusion_sensor.oo";

pub fn main() {
    let fusion_sensor_mark: Int = 0;
    if fusion_sensor_mark != 0 {
        process_exit(1);
    }
    let a: FusSens = fus_sens_new(0, 0);
    let b: FusSens = fus_sens_new(0, 0);
    if (a).stype != (b).stype {
        println("FAIL fus_sens_new");
        process_exit(1);
    }
    println("prod_fusion_sensor: PASSED");
}
