// # Product prove std/digital_twin/hil_analog_digital_io_mapping.oo
//
// Logline: Fail-closed emit+gcc+run asserts dac_quantize_voltage is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/hil_analog_digital_io_mapping.oo.
//
// Beats:
//   1. Call dac_quantize_voltage twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hil_analog_digital_io_mapping: PASSED only if they match.

import "std/digital_twin/hil_analog_digital_io_mapping.oo";

pub fn main() {
    let hil_analog_digital_io_mapping_mark: Int = 0;
    if hil_analog_digital_io_mapping_mark != 0 {
        process_exit(1);
    }
    let a: Int = dac_quantize_voltage(0.0, 0.0, 0.0, 0);
    let b: Int = dac_quantize_voltage(0.0, 0.0, 0.0, 0);
    if a != b {
        println("FAIL dac_quantize_voltage");
        process_exit(1);
    }
    println("prod_hil_analog_digital_io_mapping: PASSED");
}
