// # Product fibonacci_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped fib_heap_insert/len.
//
// Setup: Product std/collections/fibonacci_heap.oo. Insert 7 then 3.
//
// Beats:
//   1. After two inserts, len 2 and min_key 3.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/fibonacci_heap.oo";

pub fn main() {
    let mut h: FibHeap = fib_heap_new();
    h = fib_heap_insert(h, 7);
    h = fib_heap_insert(h, 3);
    let n: Int = fib_heap_len(h);
    if n != 2 {
        println("FAIL fibheap len");
        process_exit(1);
    }
    let m: Int = h.min_key;
    if m != 3 {
        println("FAIL fibheap min");
        process_exit(1);
    }
    println("prod_fibheap: PASSED");
}
