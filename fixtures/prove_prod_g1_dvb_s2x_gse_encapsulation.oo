// # Product prove std/satellite_dvb/dvb_s2x_gse_encapsulation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gse_header_new_unfragmented is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_gse_encapsulation.oo.
//
// Beats:
//   1. Call gse_header_new_unfragmented twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvb_s2x_gse_encapsulation: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_gse_encapsulation.oo";

pub fn main() {
    let a: GseHeader = gse_header_new_unfragmented(0, 0);
    let b: GseHeader = gse_header_new_unfragmented(0, 0);
    if a.start_flag != b.start_flag {
        println("FAIL gse_header_new_unfragmented");
        process_exit(1);
    }
    println("prod_dvb_s2x_gse_encapsulation: PASSED");
}
