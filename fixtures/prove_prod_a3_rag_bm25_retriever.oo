// # Product prove std/deep_ai/rag_bm25_retriever.oo
//
// Logline: Fail-closed emit+gcc+run asserts rag_bm25_retriever_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/rag_bm25_retriever.oo.
//
// Beats:
//   1. Call rag_bm25_retriever_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rag_bm25_retriever: PASSED only if they match.

import "std/deep_ai/rag_bm25_retriever.oo";

pub fn main() {
    let a: Int = rag_bm25_retriever_marker();
    let b: Int = rag_bm25_retriever_marker();
    if a != b {
        println("FAIL rag_bm25_retriever_marker");
        process_exit(1);
    }
    println("prod_rag_bm25_retriever: PASSED");
}
