// # Product prove std/db_columnar/arrow_schema_fields.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/arrow_schema_fields.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_schema_fields.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_arrow_schema_fields: PASSED only if they match.

import "std/db_columnar/arrow_schema_fields.oo";

pub fn main() {
    let arrow_schema_fields_a = arrow_field_new("x", 0, true);
    let arrow_schema_fields_b = arrow_field_new("x", 0, true);
    if arrow_schema_fields_a.name != arrow_schema_fields_b.name {
        println("FAIL arrow_schema_fields");
        process_exit(1);
    }
    println("prod_ap_arrow_schema_fields: PASSED");
}
