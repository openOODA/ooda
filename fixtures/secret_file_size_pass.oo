// # Allow a public file_size path
//
// Logline: A non-secret path may reach file_size while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public path instead.
//   3. Expect emit to allow the call.

// M143: non-secret path may file_size
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let public = "/tmp/ok";
    let r = file_size(fs, public);
    println(1);
}
