// # Product prove std/graph_topology/k_core_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts k_core_get_coreness is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/k_core_decomposition.oo.
//
// Beats:
//   1. Call k_core_get_coreness twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_k_core_decomposition: PASSED only if they match.

import "std/graph_topology/k_core_decomposition.oo";

pub fn main() {
    let k_core_decomposition_mark: Int = 0;
    if k_core_decomposition_mark != 0 {
        process_exit(1);
    }
    let a: Int = k_core_get_coreness(KCoreResult { ptr: 0, len: 0, cap: 0 }, 0);
    let b: Int = k_core_get_coreness(KCoreResult { ptr: 0, len: 0, cap: 0 }, 0);
    if a != b {
        println("FAIL k_core_get_coreness");
        process_exit(1);
    }
    println("prod_k_core_decomposition: PASSED");
}
