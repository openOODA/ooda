import "std/quantum_open_systems/bose_einstein_thermal_reservoir.oo";

pub fn main() {
    let bose_einstein_thermal_reservoir_a = thermal_reservoir_cryogenic();
    let bose_einstein_thermal_reservoir_b = thermal_reservoir_cryogenic();
    let bose_einstein_thermal_reservoir_va = bose_einstein_occupation(bose_einstein_thermal_reservoir_a, 0.0);
    let bose_einstein_thermal_reservoir_vb = bose_einstein_occupation(bose_einstein_thermal_reservoir_b, 0.0);
    if bose_einstein_thermal_reservoir_va != bose_einstein_thermal_reservoir_vb {
        println("FAIL bose_einstein_thermal_reservoir");
        process_exit(1);
    }
    println("prod_ap_bose_einstein_thermal_reservoir: PASSED");
