// # Match-expression heap payload lock
//
// Logline: LLVM match-expr returns concatenated Ok/Err strings without release-then-return.
//
// Setup: Backend-LLVM. Payloads are concat, not interned lits.
//
// Beats:
//   1. take_ok matches Ok("he" + "llo") and returns hello.
//   2. take_err matches Err("b" + "ad") and returns bad.
//   3. main prints both lines.

pub fn take_ok() -> String {
    let r: Result[String, String] = Ok("he" + "llo");
    return match r {
        Ok(s) => s,
        Err(e) => e
    };
}

pub fn take_err() -> String {
    let r: Result[String, String] = Err("b" + "ad");
    return match r {
        Ok(s) => s,
        Err(e) => e
    };
}

pub fn main() {
    println(take_ok());
    println(take_err());
}
