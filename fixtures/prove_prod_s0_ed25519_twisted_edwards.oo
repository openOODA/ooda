// # Product prove std/zk_rollup/ed25519_twisted_edwards.oo
//
// Logline: Fail-closed emit+gcc+run asserts edwards_params_ed25519 value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/ed25519_twisted_edwards.oo.
//
// Beats:
//   1. Call edwards_params_ed25519 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ed25519_twisted_edwards: PASSED only if asserts hold.

import "std/zk_rollup/ed25519_twisted_edwards.oo";

pub fn main() {
    let ed25519_twisted_edwards_a = edwards_params_ed25519();
    let ed25519_twisted_edwards_b = edwards_params_ed25519();
    if ed25519_twisted_edwards_a.d_coeff != ed25519_twisted_edwards_b.d_coeff {
        println("FAIL edwards_params_ed25519");
        process_exit(1);
    }
    println("prod_ed25519_twisted_edwards: PASSED");
}
