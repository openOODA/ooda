// # Product prove std/quantum_topological/topological_density_matrix_fusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts topo_density_matrix_purity is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_density_matrix_fusion.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call topo_density_matrix_purity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_topological_density_matrix_fusion: PASSED only if they match.

import "std/quantum_topological/topological_density_matrix_fusion.oo";

pub fn main() {
    let g2_oa: TopoDensityMatrix2x2 = TopoDensityMatrix2x2 { rho00: 1.0, rho11: 1.0, rho01_re: 1.0, rho01_im: 1.0 };
    let g2_ob: TopoDensityMatrix2x2 = TopoDensityMatrix2x2 { rho00: 1.0, rho11: 1.0, rho01_re: 1.0, rho01_im: 1.0 };
    let g2_a = topo_density_matrix_purity(&g2_oa);
    let g2_b = topo_density_matrix_purity(&g2_ob);
    if g2_a != g2_b {
        println("FAIL topo_density_matrix_purity");
        process_exit(1);
    }
    println("prod_g2_topological_density_matrix_fusion: PASSED");
}
