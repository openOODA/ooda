// # Product prove std/fintech_l3_book/ouch_inbound_canceller.oo
//
// Logline: Fail-closed emit+gcc+run asserts evaluate_cod_trigger is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/ouch_inbound_canceller.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call evaluate_cod_trigger twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ouch_inbound_canceller: PASSED only if they match.

import "std/fintech_l3_book/ouch_inbound_canceller.oo";

pub fn main() {
    let g0_oa: KillSwitchConfig = KillSwitchConfig { is_kill_switch_active: true, auto_cancel_on_disconnect: true, cod_timeout_ms: 0, authorized_admin: "x" };
    let g0_ob: KillSwitchConfig = KillSwitchConfig { is_kill_switch_active: true, auto_cancel_on_disconnect: true, cod_timeout_ms: 0, authorized_admin: "x" };
    let g0_a = evaluate_cod_trigger(&g0_oa, 0, 0);
    let g0_b = evaluate_cod_trigger(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL evaluate_cod_trigger");
        process_exit(1);
    }
    println("prod_gr_ouch_inbound_canceller: PASSED");
}
