// # Product prove std/quantum/measurement_prob.oo
//
// Logline: Fail-closed emit+gcc+run asserts prob_qubit_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/measurement_prob.oo.
//
// Beats:
//   1. Call prob_qubit_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_measurement_prob: PASSED only if they match.

import "std/quantum/measurement_prob.oo";

pub fn main() {
    let measurement_prob_mark: Int = 0;
    if measurement_prob_mark != 0 {
        process_exit(1);
    }
    let r: QuantumRegister = register_new(2);
    let a: Float = prob_qubit_zero(r, 0);
    let b: Float = prob_qubit_zero(r, 0);
    if a != b {
        println("FAIL prob_qubit_zero");
        process_exit(1);
    }
    println("prod_measurement_prob: PASSED");
}
