// # Product prove std/net/net.oo
//
// Logline: Fail-closed emit+gcc+run asserts net_modules_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/net.oo.
//
// Beats:
//   1. Call net_modules_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_net: PASSED only if they match.

import "std/net/net.oo";

pub fn main() {
    let a = net_modules_count();
    let b = net_modules_count();
    if a != b {
        println("FAIL net_modules_count");
        process_exit(1);
    }
    println("prod_net: PASSED");
}
