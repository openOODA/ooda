// # Product prove std/db_storage/lsm_sstable_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsm_sstable_reader_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_sstable_reader.oo.
//
// Beats:
//   1. Call lsm_sstable_reader_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_lsm_sstable_reader: PASSED only if it matches.

import "std/db_storage/lsm_sstable_reader.oo";

pub fn main() {
    let a: Int = lsm_sstable_reader_probe();
    if a != 0 {
        println("FAIL lsm_sstable_reader_probe");
        process_exit(1);
    }
    println("prod_nc_lsm_sstable_reader: PASSED");
}
