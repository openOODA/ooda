// # Product prove std/auto_mpc_control/tire_slip_angle_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_mpc_control/tire_slip_angle_calculator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_slip_angle_calculator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tire_slip_angle_calculator: PASSED only if they match.

import "std/auto_mpc_control/tire_slip_angle_calculator.oo";

pub fn main() {
    let tire_slip_angle_calculator_a = compute_wheel_slip_ratio(0.0, 0.0, 0.0);
    let tire_slip_angle_calculator_b = compute_wheel_slip_ratio(0.0, 0.0, 0.0);
    if tire_slip_angle_calculator_a != tire_slip_angle_calculator_b {
        println("FAIL tire_slip_angle_calculator");
        process_exit(1);
    }
    println("prod_ap_tire_slip_angle_calculator: PASSED");
}
