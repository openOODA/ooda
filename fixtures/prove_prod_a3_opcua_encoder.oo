// # Product prove std/industrial_iot/opcua_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_encoder_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/opcua_encoder.oo.
//
// Beats:
//   1. Call opcua_encoder_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opcua_encoder: PASSED only if they match.

import "std/industrial_iot/opcua_encoder.oo";

pub fn main() {
    let a: OpcUaEncoder = opcua_encoder_new();
    let b: OpcUaEncoder = opcua_encoder_new();
    if (a).bytes_written != (b).bytes_written {
        println("FAIL opcua_encoder_new");
        process_exit(1);
    }
    println("prod_opcua_encoder: PASSED");
}
