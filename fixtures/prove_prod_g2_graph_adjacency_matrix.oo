// # Product prove std/graph_topology/graph_adjacency_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts adj_matrix_get_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_adjacency_matrix.oo.
//
// Beats:
//   1. Call adj_matrix_get_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_adjacency_matrix: PASSED only if they match.

import "std/graph_topology/graph_adjacency_matrix.oo";

pub fn main() {
    let graph_adjacency_matrix_mark: Int = 0;
    if graph_adjacency_matrix_mark != 0 {
        process_exit(1);
    }
    let a: Int = adj_matrix_get_index(0, 0, 0);
    let b: Int = adj_matrix_get_index(0, 0, 0);
    if a != b {
        println("FAIL adj_matrix_get_index");
        process_exit(1);
    }
    println("prod_g2_graph_adjacency_matrix: PASSED");
}
