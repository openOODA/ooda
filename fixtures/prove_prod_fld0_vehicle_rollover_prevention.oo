// # Product prove std/auto_mpc_control/vehicle_rollover_prevention.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollover_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_rollover_prevention.oo.
//
// Beats:
//   1. Call rollover_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vehicle_rollover_prevention: PASSED only if they match.

import "std/auto_mpc_control/vehicle_rollover_prevention.oo";

pub fn main() {
    let vehicle_rollover_prevention_mark: Int = 0;
    if vehicle_rollover_prevention_mark != 0 {
        process_exit(1);
    }
    let vehicle_rollover_prevention_a: RolloverConfig = rollover_config_default();
    let vehicle_rollover_prevention_b: RolloverConfig = rollover_config_default();
    if (vehicle_rollover_prevention_a).cg_height_m != (vehicle_rollover_prevention_b).cg_height_m {
        println("FAIL rollover_config_default");
        process_exit(1);
    }
    println("prod_vehicle_rollover_prevention: PASSED");
}
