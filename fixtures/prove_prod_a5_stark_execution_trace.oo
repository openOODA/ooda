// # Product prove std/zk_rollup/stark_execution_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts stark_trace_table_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_execution_trace.oo.
//
// Beats:
//   1. Call stark_trace_table_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stark_execution_trace: PASSED only if they match.

import "std/zk_rollup/stark_execution_trace.oo";

pub fn main() {
    let stark_execution_trace_mark: Int = 0;
    if stark_execution_trace_mark != 0 {
        process_exit(1);
    }
    let a: StarkTraceTable = stark_trace_table_new(0, 0);
    let b: StarkTraceTable = stark_trace_table_new(0, 0);
    if (a).num_rows != (b).num_rows {
        println("FAIL stark_trace_table_new");
        process_exit(1);
    }
    println("prod_stark_execution_trace: PASSED");
}
