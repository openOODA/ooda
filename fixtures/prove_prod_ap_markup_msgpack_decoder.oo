// # Product prove std/markup/msgpack_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/msgpack_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/msgpack_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_msgpack_decoder: PASSED only if they match.

import "std/markup/msgpack_decoder.oo";

pub fn main() {
    let msgpack_decoder_a = msgpack_decode_str_payload(list_new(), 0, 0);
    let msgpack_decoder_b = msgpack_decode_str_payload(list_new(), 0, 0);
    if msgpack_decoder_a.contains(msgpack_decoder_b) == false {
        println("FAIL msgpack_decoder");
        process_exit(1);
    }
    if msgpack_decoder_b.contains(msgpack_decoder_a) == false {
        println("FAIL msgpack_decoder");
        process_exit(1);
    }
    println("prod_ap_msgpack_decoder: PASSED");
}
