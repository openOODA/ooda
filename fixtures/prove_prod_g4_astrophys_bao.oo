// # Product prove std/astrophysics_relativity/cosmological_baryon_acoustic_oscillations.oo
//
// Logline: Fail-closed verification that Baryon Acoustic Oscillations (BAO) sound horizon scale and distance projections are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_baryon_acoustic_oscillations.oo.
//
// Beats:
//   1. Compute sound horizon scale r_s at drag epoch for fiducial cosmological parameters.
//   2. Compute BAO angular, radial, and volume dilation scales at redshift z = 0.5.
//   3. Assert deterministic return values.
//   4. Print prod_g4_astrophys_bao: PASSED and exit 0.

import "std/astrophysics_relativity/cosmological_baryon_acoustic_oscillations.oo";

pub fn main() {
    let cosmological_baryon_acoustic_oscillations_mark: Int = 0;
    if cosmological_baryon_acoustic_oscillations_mark != 0 {
        process_exit(1);
    }

    let rs_a: Float = bao_sound_horizon_drag_mpc(0.1430, 0.02237);
    let rs_b: Float = bao_sound_horizon_drag_mpc(0.1430, 0.02237);
    if rs_a != rs_b || rs_a <= 100.0 || rs_a >= 200.0 {
        println("FAIL bao_sound_horizon_drag_mpc fiducial");
        process_exit(1);
    }

    let rs_edge_a: Float = bao_sound_horizon_drag_mpc(0.0, 0.0);
    let rs_edge_b: Float = bao_sound_horizon_drag_mpc(0.0, 0.0);
    if rs_edge_a != rs_edge_b || rs_edge_a != 147.5 {
        println("FAIL bao_sound_horizon_drag_mpc edge");
        process_exit(1);
    }

    let params: CosmoParams = cosmo_params_default();
    let res_a: BaoScaleResult = bao_scales_compute(params, 1000.0, 0.5);
    let res_b: BaoScaleResult = bao_scales_compute(params, 1000.0, 0.5);

    if (res_a).angular_scale_deg != (res_b).angular_scale_deg || (res_a).angular_scale_deg <= 0.0 {
        println("FAIL bao_scales_compute angular_scale_deg");
        process_exit(1);
    }

    if (res_a).radial_redshift_step_dz != (res_b).radial_redshift_step_dz || (res_a).radial_redshift_step_dz <= 0.0 {
        println("FAIL bao_scales_compute radial_redshift_step_dz");
        process_exit(1);
    }

    if (res_a).dilation_distance_dv_mpc != (res_b).dilation_distance_dv_mpc || (res_a).dilation_distance_dv_mpc <= 0.0 {
        println("FAIL bao_scales_compute dilation_distance_dv_mpc");
        process_exit(1);
    }

    println("prod_g4_astrophys_bao: PASSED");
    process_exit(0);
}
