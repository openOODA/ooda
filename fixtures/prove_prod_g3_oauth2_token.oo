// # Product prove std/web_protocols/oauth2_token.oo
//
// Logline: Fail-closed emit+gcc+run asserts oauth2_is_bearer_prefix is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/oauth2_token.oo.
//
// Beats:
//   1. Call oauth2_is_bearer_prefix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_oauth2_token: PASSED only if they match.

import "std/web_protocols/oauth2_token.oo";

pub fn main() {
    let oauth2_token_mark: Int = 0;
    if oauth2_token_mark != 0 {
        process_exit(1);
    }
    let a: Int = oauth2_is_bearer_prefix(0, 0, 0, 0, 0, 0, 0);
    let b: Int = oauth2_is_bearer_prefix(0, 0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL oauth2_is_bearer_prefix");
        process_exit(1);
    }
    println("prod_oauth2_token: PASSED");
}
