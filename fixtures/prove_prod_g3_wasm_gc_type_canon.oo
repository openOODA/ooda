// # Product prove std/wasm_gc/wasm_gc_type_canon.oo
//
// Logline: Fail-closed emit+gcc+run asserts canon_compute_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_type_canon.oo.
//
// Beats:
//   1. Call canon_compute_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_type_canon: PASSED only if they match.

import "std/wasm_gc/wasm_gc_type_canon.oo";

pub fn main() {
    let wasm_gc_type_canon_mark: Int = 0;
    if wasm_gc_type_canon_mark != 0 {
        process_exit(1);
    }
    let a: Int = canon_compute_hash(0, 0, 0);
    let b: Int = canon_compute_hash(0, 0, 0);
    if a != b {
        println("FAIL canon_compute_hash");
        process_exit(1);
    }
    println("prod_wasm_gc_type_canon: PASSED");
}
