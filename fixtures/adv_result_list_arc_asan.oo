// # ARC and AddressSanitizer stress test for Result[List[Item]]
//
// Logline: Verify zero leaks, zero use-after-free, zero double-free in Result[List[Item]] with String fields.
//
// Setup: Backend-C. Custom struct Item with String fields allocated dynamically.
//
// Beats:
//   1. Function allocates dynamic strings and packs into Item inside List[Item].
//   2. Function returns Result[List[Item], String] (Ok and Err paths).
//   3. Caller matches, accesses strings, passes them to helpers.
//   4. Runs under GCC AddressSanitizer (-fsanitize=address,undefined).

type Item = struct {
    id: Int,
    name: String,
    category: String
};

fn build_items(count: Int) -> Result[List[Item], String] {
    if count < 0 {
        return Err("negative count requested: " + count.to_string());
    }
    let mut xs: List[Item] = list_new();
    let mut i = 0;
    while i < count {
        let tag: String = "item_" + i.to_string();
        let cat: String = "category_" + (i % 3).to_string();
        let it: Item = Item {
            id: i * 10,
            name: tag,
            category: cat
        };
        xs = list_push(xs, it);
        i = i + 1;
    }
    return Ok(xs);
}

fn process_items(r: Result[List[Item], String]) -> Int {
    let mut total_id: Int = 0;
    match r {
        Ok(items) => {
            let n: Int = list_len(items);
            let mut j = 0;
            while j < n {
                let it: Item = list_get(items, j);
                total_id = total_id + it.id;
                if !str_starts_with(it.name, "item_") {
                    println("FAIL name prefix");
                    process_exit(1);
                }
                if !str_starts_with(it.category, "category_") {
                    println("FAIL category prefix");
                    process_exit(1);
                }
                j = j + 1;
            }
        }
        Err(e) => {
            if !str_starts_with(e, "negative count") {
                println("FAIL err prefix");
                process_exit(1);
            }
            return -1;
        }
    }
    return total_id;
}

pub fn main() {
    // Ok with 10 elements
    let r1: Result[List[Item], String] = build_items(10);
    let sum1: Int = process_items(r1);
    // 0 + 10 + 20 + ... + 90 = 450
    if sum1 != 450 {
        println("FAIL sum1: " + sum1.to_string());
        process_exit(1);
    }

    // Ok with 0 elements
    let r2: Result[List[Item], String] = build_items(0);
    let sum2: Int = process_items(r2);
    if sum2 != 0 {
        println("FAIL sum2: " + sum2.to_string());
        process_exit(1);
    }

    // Err path
    let r3: Result[List[Item], String] = build_items(-5);
    let sum3: Int = process_items(r3);
    if sum3 != -1 {
        println("FAIL sum3: " + sum3.to_string());
        process_exit(1);
    }

    println("adv_result_list_arc_asan: PASSED");
}
