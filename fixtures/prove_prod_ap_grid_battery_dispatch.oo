// # Product prove std/grid/battery_dispatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/battery_dispatch.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_dispatch.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_battery_dispatch: PASSED only if they match.

import "std/grid/battery_dispatch.oo";

pub fn main() {
    let battery_dispatch_a = dispatch_schedule_new(0.0, 0.0, 0, 0);
    let battery_dispatch_b = dispatch_schedule_new(0.0, 0.0, 0, 0);
    let battery_dispatch_va = dispatch_schedule_estimate_energy_kwh(battery_dispatch_a);
    let battery_dispatch_vb = dispatch_schedule_estimate_energy_kwh(battery_dispatch_b);
    if battery_dispatch_va != battery_dispatch_vb {
        println("FAIL battery_dispatch");
        process_exit(1);
    }
    println("prod_ap_battery_dispatch: PASSED");
}
