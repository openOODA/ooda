// # Product prove std/fintech_defi/matching_pro_rata.oo
//
// Logline: Fail-closed emit+gcc+run asserts pro_rata_quote_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/matching_pro_rata.oo.
//
// Beats:
//   1. Call pro_rata_quote_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_matching_pro_rata: PASSED only if they match.

import "std/fintech_defi/matching_pro_rata.oo";

pub fn main() {
    let matching_pro_rata_mark: Int = 0;
    if matching_pro_rata_mark != 0 {
        process_exit(1);
    }
    let a: ProRataQuote = pro_rata_quote_new(0, "x", 0, 0);
    let b: ProRataQuote = pro_rata_quote_new(0, "x", 0, 0);
    if (a).order_id != (b).order_id {
        println("FAIL pro_rata_quote_new");
        process_exit(1);
    }
    println("prod_matching_pro_rata: PASSED");
}
