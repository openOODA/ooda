// # Product prove std/bft_consensus/tendermint_block_part_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/tendermint_block_part_set.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_block_part_set.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tendermint_block_part_set: PASSED only if they match.

import "std/bft_consensus/tendermint_block_part_set.oo";

pub fn main() {
    let tendermint_block_part_set_a = block_part_set_new(0, "x");
    let tendermint_block_part_set_b = block_part_set_new(0, "x");
    let tendermint_block_part_set_va = block_part_set_is_complete(tendermint_block_part_set_a);
    let tendermint_block_part_set_vb = block_part_set_is_complete(tendermint_block_part_set_b);
    if tendermint_block_part_set_va != tendermint_block_part_set_vb {
        println("FAIL tendermint_block_part_set");
        process_exit(1);
    }
    println("prod_ap_tendermint_block_part_set: PASSED");
}
