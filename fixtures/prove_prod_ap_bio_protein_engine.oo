// # Product prove std/bio/protein_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/protein_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_engine: PASSED only if they match.

import "std/bio/protein_engine.oo";

pub fn main() {
    let protein_engine_a = protein_backbone_new(0);
    let protein_engine_b = protein_backbone_new(0);
    let protein_engine_va = protein_backbone_get_residue_count(protein_engine_a);
    let protein_engine_vb = protein_backbone_get_residue_count(protein_engine_b);
    if protein_engine_va != protein_engine_vb {
        println("FAIL protein_engine");
        process_exit(1);
    }
    println("prod_ap_protein_engine: PASSED");
}
