// # Product prove std/fintech_defi/amm_twap_oracle.oo
//
// Logline: Fail-closed emit+gcc+run asserts twap_observation_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_twap_oracle.oo.
//
// Beats:
//   1. Call twap_observation_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_amm_twap_oracle: PASSED only if they match.

import "std/fintech_defi/amm_twap_oracle.oo";

pub fn main() {
    let amm_twap_oracle_mark: Int = 0;
    if amm_twap_oracle_mark != 0 {
        process_exit(1);
    }
    let a: TwapObservation = twap_observation_new(0, 0, 0);
    let b: TwapObservation = twap_observation_new(0, 0, 0);
    if (a).timestamp_sec != (b).timestamp_sec {
        println("FAIL twap_observation_new");
        process_exit(1);
    }
    println("prod_g2_amm_twap_oracle: PASSED");
}
