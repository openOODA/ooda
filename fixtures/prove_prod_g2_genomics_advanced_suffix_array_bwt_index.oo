// # Product prove std/genomics_advanced/suffix_array_bwt_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts bwt_calc_range_count is a real value.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/suffix_array_bwt_index.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bwt_calc_range_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_suffix_array_bwt_index: PASSED only if they match.

import "std/genomics_advanced/suffix_array_bwt_index.oo";

pub fn main() {
    let g2_oa = bwt_step_lf_mapping(8, 2, 2);
    let g2_ob = bwt_step_lf_mapping(8, 2, 2);
    let g2_a = bwt_calc_range_count(&g2_oa);
    let g2_b = bwt_calc_range_count(&g2_ob);
    if g2_a != g2_b {
        println("FAIL bwt_calc_range_count");
        process_exit(1);
    }
    println("prod_g2_suffix_array_bwt_index: PASSED");
}
