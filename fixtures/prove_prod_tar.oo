// # Product prove std/archive/tar.oo
//
// Logline: Fail-closed emit+gcc+run asserts tar_detect is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/tar.oo.
//
// Beats:
//   1. Call tar_detect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tar: PASSED only if they match.

import "std/archive/tar.oo";

pub fn main() {
    let a = tar_detect("x");
    let b = tar_detect("x");
    if a != b {
        println("FAIL tar_detect");
        process_exit(1);
    }
    println("prod_tar: PASSED");
}
