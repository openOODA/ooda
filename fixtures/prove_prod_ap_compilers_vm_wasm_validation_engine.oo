// # Product prove std/compilers_vm/wasm_validation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_validation_engine.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_validation_engine.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_wasm_validation_engine: PASSED only if they match.

import "std/compilers_vm/wasm_validation_engine.oo";

pub fn main() {
    let wasm_validation_engine_a = wasm_val_type_i32();
    let wasm_validation_engine_b = wasm_val_type_i32();
    if wasm_validation_engine_a.type_code != wasm_validation_engine_b.type_code {
        println("FAIL wasm_validation_engine");
        process_exit(1);
    }
    println("prod_ap_wasm_validation_engine: PASSED");
}
