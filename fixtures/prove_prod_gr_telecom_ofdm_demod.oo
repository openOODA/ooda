// # Product prove std/telecom/ofdm_demod.oo
//
// Logline: Fail-closed emit+gcc+run asserts ofdm_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/ofdm_demod.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ofdm_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ofdm_demod: PASSED only if they match.

import "std/telecom/ofdm_demod.oo";

pub fn main() {
    let g0_a = ofdm_int_to_float(0);
    let g0_b = ofdm_int_to_float(0);
    if g0_a != g0_b {
        println("FAIL ofdm_int_to_float");
        process_exit(1);
    }
    println("prod_gr_ofdm_demod: PASSED");
}
