// # Product prove std/aero/orbit_coords.oo
//
// Logline: Fail-closed verification that orbital coordinate conversions are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_coords.oo.
//
// Beats:
//   1. Convert Keplerian elements to Cartesian ECI state twice.
//   2. Extract position coordinates and assert deterministic results.
//   3. Print prod_g4_aero_orbit_coords: PASSED and exit 0.

import "std/aero/orbit_coords.oo";

pub fn main() {
    let elem1: KeplerianElements = keplerian_new(7000000.0, 0.001, 0.5, 0.2, 0.1, 0.0);
    let elem2: KeplerianElements = keplerian_new(7000000.0, 0.001, 0.5, 0.2, 0.1, 0.0);
    let s1: EciState = keplerian_to_eci(elem1, 398600441800000.0);
    let s2: EciState = keplerian_to_eci(elem2, 398600441800000.0);

    let p1: Vec3 = s1.position;
    let p2: Vec3 = s2.position;
    let x1: Float = p1.x;
    let x2: Float = p2.x;
    if x1 != x2 {
        println("FAIL keplerian_to_eci x");
        process_exit(1);
    }

    let y1: Float = p1.y;
    let y2: Float = p2.y;
    if y1 != y2 {
        println("FAIL keplerian_to_eci y");
        process_exit(1);
    }

    let z1: Float = p1.z;
    let z2: Float = p2.z;
    if z1 != z2 {
        println("FAIL keplerian_to_eci z");
        process_exit(1);
    }

    println("prod_g4_aero_orbit_coords: PASSED");
    process_exit(0);
}
