// # Product prove std/lidar_perception/radial_grid_clusterer.oo
//
// Logline: Fail-closed emit+gcc+run asserts radial_grid_config_default real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/radial_grid_clusterer.oo.
//
// Beats:
//   1. Call radial_grid_config_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_radial_grid_clusterer: PASSED only if the assert holds.

import "std/lidar_perception/radial_grid_clusterer.oo";

pub fn main() {
    let radial_grid_clusterer_a = radial_grid_config_default();
    let radial_grid_clusterer_radial_step_m: Float = (radial_grid_clusterer_a).radial_step_m;
    if !(radial_grid_clusterer_radial_step_m == 0.5) {
        println("FAIL radial_grid_config_default");
        process_exit(1);
    }
    println("prod_radial_grid_clusterer: PASSED");
}
