// # Product prove std/zk_rollup/plonk_prover_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_trace_row_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_prover_trace.oo.
//
// Beats:
//   1. Call plonk_trace_row_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_plonk_prover_trace: PASSED only if asserts hold.

import "std/zk_rollup/plonk_prover_trace.oo";

pub fn main() {
    let plonk_prover_trace_a = plonk_trace_row_new(0, 0, 0, 0);
    let plonk_prover_trace_b = plonk_trace_row_new(0, 0, 0, 0);
    if plonk_prover_trace_a.row_index != plonk_prover_trace_b.row_index {
        println("FAIL plonk_trace_row_new");
        process_exit(1);
    }
    println("prod_plonk_prover_trace: PASSED");
}
