// # Product prove std/ai_ml/layer_norm.oo
//
// Logline: Fail-closed emit+gcc+run asserts normalization layer operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_norm.oo.
//
// Beats:
//   1. Construct LayerNorm, RMSNorm, and BatchNorm1D instances.
//   2. Call layer_norm_forward_1d, rms_norm_forward_1d, and batch_norm_forward_1d.
//   3. Assert deterministic tensor dimensions and outputs.
//   4. Print prod_g4_aiml_layer_norm: PASSED only if all match.

import "std/ai_ml/layer_norm.oo";

pub fn main() {
    let ln: LayerNorm = layer_norm_new(2, 0.00001);
    let rmsn: RMSNorm = rms_norm_new(2, 0.00001);
    let bn: BatchNorm1D = batch_norm_1d_new(2, 0.00001, 0.1);

    let mut x_data: List[Float] = list_new();
    x_data = list_push(x_data, 2.0);
    x_data = list_push(x_data, 4.0);
    let x: Tensor1D = Tensor1D { data: x_data, size: 2 };

    let ln_out_a: Tensor1D = layer_norm_forward_1d(&ln, x);
    let ln_out_b: Tensor1D = layer_norm_forward_1d(&ln, x);
    if (ln_out_a).size != (ln_out_b).size || (ln_out_a).size != 2 {
        println("FAIL layer_norm_forward_1d");
        process_exit(1);
    }

    let rms_out_a: Tensor1D = rms_norm_forward_1d(&rmsn, x);
    let rms_out_b: Tensor1D = rms_norm_forward_1d(&rmsn, x);
    if (rms_out_a).size != (rms_out_b).size || (rms_out_a).size != 2 {
        println("FAIL rms_norm_forward_1d");
        process_exit(1);
    }

    let bn_out_a: Tensor1D = batch_norm_forward_1d(&bn, x);
    let bn_out_b: Tensor1D = batch_norm_forward_1d(&bn, x);
    if (bn_out_a).size != (bn_out_b).size || (bn_out_a).size != 2 {
        println("FAIL batch_norm_forward_1d");
        process_exit(1);
    }

    println("prod_g4_aiml_layer_norm: PASSED");
    process_exit(0);
}
