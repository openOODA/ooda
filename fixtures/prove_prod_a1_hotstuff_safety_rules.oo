// # Product prove std/bft_consensus/hotstuff_safety_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts safety_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_safety_rules.oo.
//
// Beats:
//   1. Call safety_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hotstuff_safety_rules: PASSED only if they match.

import "std/bft_consensus/hotstuff_safety_rules.oo";

pub fn main() {
    let hotstuff_safety_rules_mark: Int = 0;
    if hotstuff_safety_rules_mark != 0 {
        process_exit(1);
    }
    let a: SafetyState = safety_state_new(0);
    let b: SafetyState = safety_state_new(0);
    if (a).locked_qc_view != (b).locked_qc_view {
        println("FAIL safety_state_new");
        process_exit(1);
    }
    println("prod_hotstuff_safety_rules: PASSED");
}
