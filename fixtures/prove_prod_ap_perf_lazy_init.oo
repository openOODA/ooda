// # Product prove std/perf/lazy_init.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/lazy_init.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/lazy_init.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lazy_init: PASSED only if they match.

import "std/perf/lazy_init.oo";

pub fn main() {
    let lazy_init_a = lazy_init_create("x");
    let lazy_init_b = lazy_init_create("x");
    let lazy_init_va = lazy_init_is_done(lazy_init_a);
    let lazy_init_vb = lazy_init_is_done(lazy_init_b);
    if lazy_init_va != lazy_init_vb {
        println("FAIL lazy_init");
        process_exit(1);
    }
    println("prod_ap_lazy_init: PASSED");
}
