// # Product prove std/net/pay_json.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_json_string is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/pay_json.oo.
//
// Beats:
//   1. Call pay_json_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pay_json: PASSED only if they match.

import "std/net/pay_json.oo";

pub fn main() {
    let a = pay_json_string("x", "x");
    let b = pay_json_string("x", "x");
    if a != b {
        println("FAIL pay_json_string");
        process_exit(1);
    }
    println("prod_pay_json: PASSED");
}
