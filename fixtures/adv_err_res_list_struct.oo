// # Test Err returns for Result[List[Struct]]
//
// Logline: Test returning Err for Result[List[Item]] and Result[List[Header]].
//
// Setup: Backend-C.
//
// Beats:
//   1. Return Err from Result[List[Item]].
//   2. Return Err from Result[List[Header]].
//   3. Match on Err.

type Item = struct {
    id: Int,
    name: String
};

type Header = struct {
    title: String,
    count: Int
};

fn make_items_err() -> Result[List[Item], String] {
    return Err("item_load_failed");
}

fn make_headers_err() -> Result[List[Header], String] {
    return Err("header_parse_error");
}

pub fn main() {
    let r1: Result[List[Item], String] = make_items_err();
    match r1 {
        Ok(items) => {
            println("FAIL r1 ok");
            process_exit(1);
        }
        Err(e) => {
            if e != "item_load_failed" {
                println("FAIL r1 msg");
                process_exit(1);
            }
        }
    }

    let r2: Result[List[Header], String] = make_headers_err();
    match r2 {
        Ok(hs) => {
            println("FAIL r2 ok");
            process_exit(1);
        }
        Err(e) => {
            if e != "header_parse_error" {
                println("FAIL r2 msg");
                process_exit(1);
            }
        }
    }

    println("err_res_list_struct: PASSED");
}
