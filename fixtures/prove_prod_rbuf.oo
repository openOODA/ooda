// # Product ring_buffer prove
//
// Logline: Fail-closed emit+gcc+run of shipped ring_buffer_push/len.
//
// Setup: Product std/collections/ring_buffer.oo. List[Int] destub.
//
// Beats:
//   1. After push 7, len 1; not empty.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/ring_buffer.oo";

pub fn main() {
    let mut r: RingBuffer = ring_buffer_new(4);
    r = ring_buffer_push(r, 7);
    let n: Int = ring_buffer_len(r);
    if n != 1 {
        println("FAIL rbuf len");
        process_exit(1);
    }
    let e: Bool = ring_buffer_is_empty(r);
    if e == true {
        println("FAIL rbuf empty");
        process_exit(1);
    }
    println("prod_rbuf: PASSED");
}
