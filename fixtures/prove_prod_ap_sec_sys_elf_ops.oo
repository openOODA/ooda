// # Product prove std/sec/sys/elf_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/elf_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf_ops: PASSED only if they match.

import "std/sec/sys/elf_ops.oo";

pub fn main() {
    let elf_ops_a = elf_magic_0();
    let elf_ops_b = elf_magic_0();
    if elf_ops_a != elf_ops_b {
        println("FAIL elf_ops");
        process_exit(1);
    }
    println("prod_ap_elf_ops: PASSED");
}
