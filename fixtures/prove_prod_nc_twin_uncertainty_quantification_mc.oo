// # Product prove std/digital_twin/twin_uncertainty_quantification_mc.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_uncertainty_quantification_mc_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_uncertainty_quantification_mc.oo.
//
// Beats:
//   1. Call twin_uncertainty_quantification_mc_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_twin_uncertainty_quantification_mc: PASSED only if it matches.

import "std/digital_twin/twin_uncertainty_quantification_mc.oo";

pub fn main() {
    let a: Int = twin_uncertainty_quantification_mc_probe();
    if a != 0 {
        println("FAIL twin_uncertainty_quantification_mc_probe");
        process_exit(1);
    }
    println("prod_nc_twin_uncertainty_quantification_mc: PASSED");
}
