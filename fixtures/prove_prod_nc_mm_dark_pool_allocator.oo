// # Product prove std/hft_alpha/mm_dark_pool_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_dark_pool_allocator_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_dark_pool_allocator.oo.
//
// Beats:
//   1. Call mm_dark_pool_allocator_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_mm_dark_pool_allocator: PASSED only if it matches.

import "std/hft_alpha/mm_dark_pool_allocator.oo";

pub fn main() {
    let a: Int = mm_dark_pool_allocator_probe();
    if a != 0 {
        println("FAIL mm_dark_pool_allocator_probe");
        process_exit(1);
    }
    println("prod_nc_mm_dark_pool_allocator: PASSED");
}
