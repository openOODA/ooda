// # Product prove std/quantum/density_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts density_get_00 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/density_matrix.oo.
//
// Beats:
//   1. Call density_get_00 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_density_get_00: PASSED only if they match.

import "std/quantum/density_matrix.oo";

pub fn main() {
    let density_matrix_mark: Int = 0;
    if density_matrix_mark != 0 { process_exit(1); }
    let rho: DensityMatrix2x2 = DensityMatrix2x2 { rho00: Complex { real: 1.0, imag: 0.0 }, rho01: Complex { real: 0.0, imag: 0.0 }, rho10: Complex { real: 0.0, imag: 0.0 }, rho11: Complex { real: 0.0, imag: 0.0 } };
    let a: Complex = density_get_00(&rho);
    let b: Complex = density_get_00(&rho);
    let ar: Float = (a).real;
    let br: Float = (b).real;
    if ar != br {
        println("FAIL density_get_00");
        process_exit(1);
    }
    println("prod_density_get_00: PASSED");
}
