// # Product prove std/graph_gnn/graph_subgraph_extraction_k_hop.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_gnn/graph_subgraph_extraction_k_hop.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_subgraph_extraction_k_hop.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_subgraph_extraction_k_hop: PASSED only if they match.

import "std/graph_gnn/graph_subgraph_extraction_k_hop.oo";

pub fn main() {
    let graph_subgraph_extraction_k_hop_a = compute_drnl_label(0, 0);
    let graph_subgraph_extraction_k_hop_b = compute_drnl_label(0, 0);
    if graph_subgraph_extraction_k_hop_a != graph_subgraph_extraction_k_hop_b {
        println("FAIL graph_subgraph_extraction_k_hop");
        process_exit(1);
    }
    println("prod_ap_graph_subgraph_extraction_k_hop: PASSED");
}
