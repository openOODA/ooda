// # Product prove std/astro_advanced/attitude_quaternion_ekf.oo
//
// Logline: Fail-closed emit+gcc+run asserts qekf_gain is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_quaternion_ekf.oo.
//
// Beats:
//   1. Call qekf_gain twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_quaternion_ekf: PASSED only if they match.

import "std/astro_advanced/attitude_quaternion_ekf.oo";

pub fn main() {
    let a = qekf_gain(0);
    let b = qekf_gain(0);
    if a != b {
        println("FAIL qekf_gain");
        process_exit(1);
    }
    println("prod_attitude_quaternion_ekf: PASSED");
}
