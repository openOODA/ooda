// # Product prove std/compilers_polyhedral/parametric_domain_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts symbolic_parameter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/parametric_domain_solver.oo.
//
// Beats:
//   1. Call symbolic_parameter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parametric_domain_solver: PASSED only if they match.

import "std/compilers_polyhedral/parametric_domain_solver.oo";

pub fn main() {
    let a: SymbolicParameter = symbolic_parameter_new(0, "x", 0, 0);
    let b: SymbolicParameter = symbolic_parameter_new(0, "x", 0, 0);
    if a.param_id != b.param_id {
        println("FAIL symbolic_parameter_new");
        process_exit(1);
    }
    println("prod_parametric_domain_solver: PASSED");
}
