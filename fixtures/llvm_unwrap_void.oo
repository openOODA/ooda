// # Void Result unwrap refuse
//
// Logline: emit-llvm fail-closes unwrap of Result[Void] instead of taking the Err string.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. f returns Result[Void, String].
//   2. Call unwrap.
//   3. Emit must print ERR llvm_emit.

pub fn f() -> Result[Void, String] {
    return Err("e");
}

pub fn main() {
    let r: Result[Void, String] = f();
    println(r.unwrap());
}
