// # Product prove std/database/sql_parser.oo
//
// Logline: Fail-closed verification that SQL statement kind detection and parser cursor progression are deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_parser.oo.
//
// Beats:
//   1. Initialize parser instance with total token capacity.
//   2. Advance parser cursor and assert monotonic index progression.
//   3. Parse SELECT, INSERT, UPDATE, DELETE, and CREATE statement kinds.
//   4. Assert deterministic statement classification tags.
//   5. Print prod_g4_db_sql_parser: PASSED and exit 0.

import "std/database/sql_parser.oo";

pub fn main() {
    let p0: SqlParser = sql_parser_create(10);
    if p0.current_idx != 0 || p0.total_tokens != 10 {
        println("FAIL sql_parser_create");
        process_exit(1);
    }

    let p1: SqlParser = sql_parser_advance(p0);
    let p2: SqlParser = sql_parser_advance(p1);
    if p2.current_idx != 2 || p2.total_tokens != 10 {
        println("FAIL sql_parser_advance");
        process_exit(1);
    }

    let k_sel: Int = sql_parse_statement_kind("SELECT * FROM users WHERE id = 1");
    let k_ins: Int = sql_parse_statement_kind("INSERT INTO users VALUES (1, 'alice')");
    let k_upd: Int = sql_parse_statement_kind("UPDATE users SET name = 'bob' WHERE id = 1");
    let k_del: Int = sql_parse_statement_kind("DELETE FROM users WHERE id = 1");
    let k_crt: Int = sql_parse_statement_kind("CREATE TABLE users (id INT)");

    if k_sel != 1 || k_ins != 2 || k_upd != 3 || k_del != 4 || k_crt != 5 {
        println("FAIL sql_parse_statement_kind");
        process_exit(1);
    }

    println("prod_g4_db_sql_parser: PASSED");
    process_exit(0);
}
