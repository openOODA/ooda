// # Product prove std/tda_topology/mapper_simplicial_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts count_shared_points is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/mapper_simplicial_complex.oo.
//
// Beats:
//   1. Call count_shared_points twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mapper_simplicial_complex: PASSED only if they match.

import "std/tda_topology/mapper_simplicial_complex.oo";

pub fn main() {
    let mapper_simplicial_complex_mark: Int = 0;
    if mapper_simplicial_complex_mark != 0 {
        process_exit(1);
    }
    let mapper_simplicial_complex_a: Int = count_shared_points(list_new(), list_new());
    let mapper_simplicial_complex_b: Int = count_shared_points(list_new(), list_new());
    if mapper_simplicial_complex_a != mapper_simplicial_complex_b {
        println("FAIL count_shared_points");
        process_exit(1);
    }
    println("prod_mapper_simplicial_complex: PASSED");
}
