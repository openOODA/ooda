// # Product prove std/embedded_hal/rtos_event_flags.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/rtos_event_flags.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_event_flags.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rtos_event_flags: PASSED only if they match.

import "std/embedded_hal/rtos_event_flags.oo";

pub fn main() {
    let rtos_event_flags_a = rtos_event_group_new(0, 0);
    let rtos_event_flags_b = rtos_event_group_new(0, 0);
    let rtos_event_flags_va = rtos_event_group_get_bits(rtos_event_flags_a);
    let rtos_event_flags_vb = rtos_event_group_get_bits(rtos_event_flags_b);
    if rtos_event_flags_va != rtos_event_flags_vb {
        println("FAIL rtos_event_flags");
        process_exit(1);
    }
    println("prod_ap_rtos_event_flags: PASSED");
}
