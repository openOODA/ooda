// # Product prove std/fintech_defi/mev_sandwich_protection.oo
//
// Logline: Fail-closed emit+gcc+run asserts mev_evaluate_sandwich_risk is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/mev_sandwich_protection.oo.
//
// Beats:
//   1. Call mev_evaluate_sandwich_risk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mev_sandwich_protection: PASSED only if they match.

import "std/fintech_defi/mev_sandwich_protection.oo";

pub fn main() {
    let mev_sandwich_protection_mark: Int = 0;
    if mev_sandwich_protection_mark != 0 {
        process_exit(1);
    }
    let a: SandwichRiskProfile = mev_evaluate_sandwich_risk(0, 0, 0, 0);
    let b: SandwichRiskProfile = mev_evaluate_sandwich_risk(0, 0, 0, 0);
    if (a).victim_amount_in != (b).victim_amount_in {
        println("FAIL mev_evaluate_sandwich_risk");
        process_exit(1);
    }
    println("prod_g2_mev_sandwich_protection: PASSED");
}
