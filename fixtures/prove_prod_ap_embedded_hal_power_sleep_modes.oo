// # Product prove std/embedded_hal/power_sleep_modes.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/power_sleep_modes.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/power_sleep_modes.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_power_sleep_modes: PASSED only if they match.

import "std/embedded_hal/power_sleep_modes.oo";

pub fn main() {
    let power_sleep_modes_a = mcu_power_state_new();
    let power_sleep_modes_b = mcu_power_state_new();
    let power_sleep_modes_va = power_is_in_low_power(power_sleep_modes_a);
    let power_sleep_modes_vb = power_is_in_low_power(power_sleep_modes_b);
    if power_sleep_modes_va != power_sleep_modes_vb {
        println("FAIL power_sleep_modes");
        process_exit(1);
    }
    println("prod_ap_power_sleep_modes: PASSED");
}
