// # Product prove std/deep_ai/guided_json_regex_constrained.oo
//
// Logline: Fail-closed emit+gcc+run asserts guided_json_regex_constrained_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/guided_json_regex_constrained.oo.
//
// Beats:
//   1. Call guided_json_regex_constrained_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_guided_json_regex_constrained: PASSED only if they match.

import "std/deep_ai/guided_json_regex_constrained.oo";

pub fn main() {
    let guided_json_regex_constrained_mark: Int = 0;
    if guided_json_regex_constrained_mark != 0 {
        process_exit(1);
    }
    let guided_json_regex_constrained_a: Int = guided_json_regex_constrained_marker();
    let guided_json_regex_constrained_b: Int = guided_json_regex_constrained_marker();
    if guided_json_regex_constrained_a != guided_json_regex_constrained_b {
        println("FAIL guided_json_regex_constrained_marker");
        process_exit(1);
    }
    println("prod_guided_json_regex_constrained: PASSED");
}
