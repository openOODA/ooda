// # Product prove std/tda_topology/persistence_entropy_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistent_entropy_add is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_entropy_calc.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call persistent_entropy_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_persistence_entropy_calc: PASSED only if they match.

import "std/tda_topology/persistence_entropy_calc.oo";

pub fn main() {
    let mut g0_oa = persistent_entropy_new();
    let mut g0_ob = persistent_entropy_new();
    let g0_a = persistent_entropy_add(&g0_oa, 0.0, 0.0);
    let g0_b = persistent_entropy_add(&g0_ob, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL persistent_entropy_add");
        process_exit(1);
    }
    println("prod_gr_persistence_entropy_calc: PASSED");
}
