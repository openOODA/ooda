// # Product prove std/crypto_advanced/crypto_pq_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts crypto_pq_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/crypto_pq_stubs.oo.
//
// Beats:
//   1. Call crypto_pq_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crypto_pq_stubs: PASSED only if they match.

import "std/crypto_advanced/crypto_pq_stubs.oo";

pub fn main() {
    let crypto_pq_stubs_mark: Int = 0;
    if crypto_pq_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = crypto_pq_fail_closed("x", 0);
    let b: Bool = crypto_pq_fail_closed("x", 0);
    if a != b {
        println("FAIL crypto_pq_fail_closed");
        process_exit(1);
    }
    println("prod_crypto_pq_stubs: PASSED");
}
