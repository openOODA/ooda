//
// Setup: Isolated emit-c. Imports std/ai_multimodal/residual_vq_cascade.oo.
//
// Beats:
//   1. Call residual_vq_cascade_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_residual_vq_cascade: PASSED only if they match.

import "std/ai_multimodal/residual_vq_cascade.oo";

pub fn main() {
    let a = residual_vq_cascade_marker();
    let b = residual_vq_cascade_marker();
    if a != b {
        println("FAIL residual_vq_cascade_marker");
        process_exit(1);
    }
    println("prod_residual_vq_cascade: PASSED");
}
