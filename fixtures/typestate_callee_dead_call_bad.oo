// # Dead callee transition
//
// Logline: Wrap claims Closed to Open but only calls actually on a false branch.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap calls actually only inside if false.
//   3. The live path never takes the Open transition.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn actually: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }

fn wrap(s: Int) {
    if false {
        actually(s);
        return;
    }
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
