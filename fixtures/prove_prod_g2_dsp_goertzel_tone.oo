// # Product prove std/telecom_5g/dsp_goertzel_tone.oo
//
// Logline: Fail-closed emit+gcc+run asserts goertzel_tone_detector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_goertzel_tone.oo.
//
// Beats:
//   1. Call goertzel_tone_detector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dsp_goertzel_tone: PASSED only if they match.

import "std/telecom_5g/dsp_goertzel_tone.oo";

pub fn main() {
    let dsp_goertzel_tone_mark: Int = 0;
    if dsp_goertzel_tone_mark != 0 {
        process_exit(1);
    }
    let a: GoertzelToneDetector = goertzel_tone_detector_new(0.0, 0.0, 0);
    let b: GoertzelToneDetector = goertzel_tone_detector_new(0.0, 0.0, 0);
    if (a).block_size_n != (b).block_size_n {
        println("FAIL goertzel_tone_detector_new");
        process_exit(1);
    }
    println("prod_g2_dsp_goertzel_tone: PASSED");
}
