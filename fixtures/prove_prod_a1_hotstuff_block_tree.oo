// # Product prove std/bft_consensus/hotstuff_block_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_tree_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_block_tree.oo.
//
// Beats:
//   1. Call block_tree_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hotstuff_block_tree: PASSED only if they match.

import "std/bft_consensus/hotstuff_block_tree.oo";

pub fn main() {
    let hotstuff_block_tree_mark: Int = 0;
    if hotstuff_block_tree_mark != 0 {
        process_exit(1);
    }
    let a: BlockTree = block_tree_new("x");
    let b: BlockTree = block_tree_new("x");
    if (a).deepest_height != (b).deepest_height {
        println("FAIL block_tree_new");
        process_exit(1);
    }
    println("prod_hotstuff_block_tree: PASSED");
}
