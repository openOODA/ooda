// # Product prove std/sec/sys/ima_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_context_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/ima_engine.oo.
//
// Beats:
//   1. Call ima_context_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ima_engine: PASSED only if asserts hold.

import "std/sec/sys/ima_engine.oo";

pub fn main() {
    let ima_engine = ima_context_new("x");
    let ima_engine_b = ima_context_new("x");
    if (ima_engine).total_measurements != 0 {
        println("FAIL ima_context_new total_measurements");
        process_exit(1);
    }
    if (ima_engine).total_measurements != (ima_engine_b).total_measurements {
        println("FAIL ima_context_new det");
        process_exit(1);
    }
    println("prod_ima_engine: PASSED");
}
