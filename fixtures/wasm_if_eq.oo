// # Const if 1 == 1 println
//
// Logline: Print eq-then when the condition is 1 == 1.
//
// Setup: No imports. One public main. Body is only if INT == INT then else println.
//
// Beats:
//   1. Declare public main.
//   2. If 1 == 1 print eq-then else print eq-else.
//   3. Leave no other statements.

pub fn main() {
    if 1 == 1 {
        println("eq-then");
    } else {
        println("eq-else");
    }
}
