// # Product prove std/tda_topology/filtered_simplicial_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts filtered_sequence_active_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/filtered_simplicial_complex.oo.
//
// Beats:
//   1. Call filtered_sequence_active_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_filtered_simplicial_complex: PASSED only if they match.

import "std/tda_topology/filtered_simplicial_complex.oo";

pub fn main() {
    let filtered_simplicial_complex_mark: Int = 0;
    if filtered_simplicial_complex_mark != 0 {
        process_exit(1);
    }
    let filtered_simplicial_complex_obj: FilteredSequence = filtered_sequence_new(1);
    let filtered_simplicial_complex_a: Int = filtered_sequence_active_count(&filtered_simplicial_complex_obj, 1.0);
    let filtered_simplicial_complex_b: Int = filtered_sequence_active_count(&filtered_simplicial_complex_obj, 1.0);
    if filtered_simplicial_complex_a != filtered_simplicial_complex_b {
        println("FAIL filtered_sequence_active_count");
        process_exit(1);
    }
    println("prod_filtered_simplicial_complex: PASSED");
}
