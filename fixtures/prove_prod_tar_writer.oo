// # Product prove std/archive/tar_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts tar_to_octal is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/tar_writer.oo.
//
// Beats:
//   1. Call tar_to_octal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tar_writer: PASSED only if they match.

import "std/archive/tar_writer.oo";

pub fn main() {
    let a = tar_to_octal(0, 0);
    let b = tar_to_octal(0, 0);
    if a != b {
        println("FAIL tar_to_octal");
        process_exit(1);
    }
    println("prod_tar_writer: PASSED");
}
