// # Product prove std/sec/crypto/falcon.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_falcon: PASSED only if they match.

import "std/sec/crypto/falcon.oo";

pub fn main() {
    let falcon_a = shim_marker_degree();
    let falcon_b = shim_marker_degree();
    if falcon_a != falcon_b {
        println("FAIL falcon");
        process_exit(1);
    }
    println("prod_ap_falcon: PASSED");
}
