// # Product diff_match prove
//
// Logline: Fail-closed emit+gcc+run of shipped diff_lcs_length (index-aligned).
//
// Setup: Product std/text/diff_match.oo. Same-index match count, not full LCS.
//
// Beats:
//   1. abc/abc length is 3.
//   2. abc/axc length is 2 (a and c).
//   3. Exit 1 before PASSED on a miss.

import "std/text/diff_match.oo";

pub fn main() {
    let a: Int = diff_lcs_length("abc", "abc");
    if a != 3 {
        println("FAIL diffmatch abc");
        process_exit(1);
    }
    let b: Int = diff_lcs_length("abc", "axc");
    if b != 2 {
        println("FAIL diffmatch axc");
        process_exit(1);
    }
    println("prod_diffmatch: PASSED");
}
