// # Product prove std/web_ecosystem/lodash_clonedeep.oo
//
// Logline: Fail-closed emit+gcc+run asserts clone_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_clonedeep.oo.
//
// Beats:
//   1. Call clone_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lodash_clonedeep: PASSED only if they match.

import "std/web_ecosystem/lodash_clonedeep.oo";

pub fn main() {
    let lodash_clonedeep_mark: Int = 0;
    if lodash_clonedeep_mark != 0 {
        process_exit(1);
    }
    let a: Int = clone_int(0);
    let b: Int = clone_int(0);
    if a != b {
        println("FAIL clone_int");
        process_exit(1);
    }
    println("prod_g2_lodash_clonedeep: PASSED");
}
