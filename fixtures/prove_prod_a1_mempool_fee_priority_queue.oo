// # Product prove std/bft_consensus/mempool_fee_priority_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts mempool_queue_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/mempool_fee_priority_queue.oo.
//
// Beats:
//   1. Call mempool_queue_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mempool_fee_priority_queue: PASSED only if they match.

import "std/bft_consensus/mempool_fee_priority_queue.oo";

pub fn main() {
    let mempool_fee_priority_queue_mark: Int = 0;
    if mempool_fee_priority_queue_mark != 0 {
        process_exit(1);
    }
    let a: MempoolQueue = mempool_queue_new(0, 0);
    let b: MempoolQueue = mempool_queue_new(0, 0);
    if (a).total_txs != (b).total_txs {
        println("FAIL mempool_queue_new");
        process_exit(1);
    }
    println("prod_mempool_fee_priority_queue: PASSED");
}
