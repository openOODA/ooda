// # Product concurrent_hashmap prove
//
// Logline: Fail-closed emit+gcc+run of shipped chm_new/put/contains/len.
//
// Setup: Product std/collections/concurrent_hashmap.oo. List[Int] destub.
//
// Beats:
//   1. After put 7->1, len 1; contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/concurrent_hashmap.oo";

pub fn main() {
    let mut m: ConcurrentHashMap = chm_new(4);
    let s: Int = chm_stripes(m);
    if s != 4 {
        println("FAIL chm stripes");
        process_exit(1);
    }
    m = chm_put(m, 7, 1);
    let n: Int = chm_len(m);
    if n != 1 {
        println("FAIL chm len");
        process_exit(1);
    }
    let c7: Bool = chm_contains_key(m, 7);
    if c7 == false {
        println("FAIL chm 7");
        process_exit(1);
    }
    let c3: Bool = chm_contains_key(m, 3);
    if c3 == true {
        println("FAIL chm 3");
        process_exit(1);
    }
    println("prod_chm: PASSED");
}
