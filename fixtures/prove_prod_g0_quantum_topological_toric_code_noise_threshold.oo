// # Product prove std/quantum_topological/toric_code_noise_threshold.oo
//
// Logline: Fail-closed emit+gcc+run asserts toric_defect_density is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_noise_threshold.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call toric_defect_density twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_toric_code_noise_threshold: PASSED only if they match.

import "std/quantum_topological/toric_code_noise_threshold.oo";

pub fn main() {
    let g0_a = toric_defect_density(1.0);
    let g0_b = toric_defect_density(1.0);
    if g0_a != g0_b {
        println("FAIL toric_defect_density");
        process_exit(1);
    }
    println("prod_g0_toric_code_noise_threshold: PASSED");
}
