// # Product prove std/net_telemetry/pcap_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcap_reader_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/pcap_reader.oo.
//
// Beats:
//   1. Call pcap_reader_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pcap_reader: PASSED only if they match.

import "std/net_telemetry/pcap_reader.oo";

pub fn main() {
    let a = pcap_reader_probe();
    let b = pcap_reader_probe();
    if a != b {
        println("FAIL pcap_reader_probe");
        process_exit(1);
    }
    println("prod_pcap_reader: PASSED");
}
