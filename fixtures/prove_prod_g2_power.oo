// # Product prove std/edge/power.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_battery_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power.oo.
//
// Beats:
//   1. Call shim_marker_battery_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_power: PASSED only if they match.

import "std/edge/power.oo";

pub fn main() {
    let power_mark: Int = 0;
    if power_mark != 0 {
        process_exit(1);
    }
    let a: BatteryState = shim_marker_battery_new();
    let b: BatteryState = shim_marker_battery_new();
    if (a).capacity_pct != (b).capacity_pct {
        println("FAIL shim_marker_battery_new");
        process_exit(1);
    }
    println("prod_g2_power: PASSED");
}
