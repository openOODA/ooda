// # Product prove std/telecom_5g/channel_awgn_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/channel_awgn_generator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_awgn_generator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_channel_awgn_generator: PASSED only if they match.

import "std/telecom_5g/channel_awgn_generator.oo";

pub fn main() {
    let channel_awgn_generator_a = channel_box_muller_re(0.0, 0.0);
    let channel_awgn_generator_b = channel_box_muller_re(0.0, 0.0);
    if channel_awgn_generator_a != channel_awgn_generator_b {
        println("FAIL channel_awgn_generator");
        process_exit(1);
    }
    println("prod_ap_channel_awgn_generator: PASSED");
}
