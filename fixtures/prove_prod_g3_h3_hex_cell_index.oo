// # Product prove std/gis_topo/h3_hex_cell_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts h3_edge_length_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/h3_hex_cell_index.oo.
//
// Beats:
//   1. Call h3_edge_length_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_h3_hex_cell_index: PASSED only if they match.

import "std/gis_topo/h3_hex_cell_index.oo";

pub fn main() {
    let h3_hex_cell_index_mark: Int = 0;
    if h3_hex_cell_index_mark != 0 {
        process_exit(1);
    }
    let a: Float = h3_edge_length_m(0);
    let b: Float = h3_edge_length_m(0);
    if a != b {
        println("FAIL h3_edge_length_m");
        process_exit(1);
    }
    println("prod_h3_hex_cell_index: PASSED");
}
