// # Product prove std/perf/latency_histogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts latency_histogram_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/latency_histogram.oo.
//
// Beats:
//   1. Call latency_histogram_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_latency_histogram: PASSED only if they match.

import "std/perf/latency_histogram.oo";

pub fn main() {
    let a: LatencyHistogram = latency_histogram_create("x", 0, 0, 0);
    let b: LatencyHistogram = latency_histogram_create("x", 0, 0, 0);
    if (a).bucket_count != (b).bucket_count {
        println("FAIL latency_histogram_create");
        process_exit(1);
    }
    println("prod_g2_latency_histogram: PASSED");
}
