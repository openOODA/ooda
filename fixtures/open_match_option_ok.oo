// # Exhaustive Option match
//
// Logline: Match Some and None and print one.
//
// Setup: OPEN-5 Option floor. Both arms are present.
//
// Beats:
//   1. Bind Some(1).
//   2. Match Some and None.
//   3. Print the value.

pub fn main() {
    let x = Some(1);
    let y = match x {
        Some(v) => v,
        None => 0,
    };
    println(y);
}
