// # Product prove std/perf/throughput_counter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/throughput_counter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/throughput_counter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_throughput_counter: PASSED only if they match.

import "std/perf/throughput_counter.oo";

pub fn main() {
    let throughput_counter_a = throughput_counter_create("x", 0);
    let throughput_counter_b = throughput_counter_create("x", 0);
    let throughput_counter_va = throughput_counter_current_rate(throughput_counter_a, 0);
    let throughput_counter_vb = throughput_counter_current_rate(throughput_counter_b, 0);
    if throughput_counter_va != throughput_counter_vb {
        println("FAIL throughput_counter");
        process_exit(1);
    }
    println("prod_ap_throughput_counter: PASSED");
}
