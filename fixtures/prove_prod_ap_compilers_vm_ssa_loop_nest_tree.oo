// # Product prove std/compilers_vm/ssa_loop_nest_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/ssa_loop_nest_tree.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_loop_nest_tree.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ssa_loop_nest_tree: PASSED only if they match.

import "std/compilers_vm/ssa_loop_nest_tree.oo";

pub fn main() {
    let ssa_loop_nest_tree_a = loop_info_new(0, 0, 0);
    let ssa_loop_nest_tree_b = loop_info_new(0, 0, 0);
    let ssa_loop_nest_tree_va = loop_contains_block(ssa_loop_nest_tree_a, 0);
    let ssa_loop_nest_tree_vb = loop_contains_block(ssa_loop_nest_tree_b, 0);
    if ssa_loop_nest_tree_va != ssa_loop_nest_tree_vb {
        println("FAIL ssa_loop_nest_tree");
        process_exit(1);
    }
    println("prod_ap_ssa_loop_nest_tree: PASSED");
}
