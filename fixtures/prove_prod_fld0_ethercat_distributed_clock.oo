// # Product prove std/iot_scada/ethercat_distributed_clock.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_dc_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_distributed_clock.oo.
//
// Beats:
//   1. Call ethercat_dc_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ethercat_distributed_clock: PASSED only if they match.

import "std/iot_scada/ethercat_distributed_clock.oo";

pub fn main() {
    let ethercat_distributed_clock_mark: Int = 0;
    if ethercat_distributed_clock_mark != 0 {
        process_exit(1);
    }
    let ethercat_distributed_clock_a: EthercatDcConfig = ethercat_dc_new(1, 1);
    let ethercat_distributed_clock_b: EthercatDcConfig = ethercat_dc_new(1, 1);
    if (ethercat_distributed_clock_a).slave_id != (ethercat_distributed_clock_b).slave_id {
        println("FAIL ethercat_dc_new");
        process_exit(1);
    }
    println("prod_ethercat_distributed_clock: PASSED");
}
