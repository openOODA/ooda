// # OPEN-75 product lsp_serve stdio loop
//
// Logline: Drive initialize then shutdown through the product loop and print PASSED.
//
// Setup: Imports lsp/lsp.oo. lsp_serve is the stdin entry; this fixture does not hang on a TTY.
//
// Beats:
//   1. Name lsp_serve as a product function.
//   2. Process newline-framed initialize then shutdown.
//   3. Require two Content-Length replies and print PASSED.

import "lsp/lsp.oo";

fn count_sub(s: String, sub: String) -> Int {
    let sl: Int = chars_len(sub);
    let mut n: Int = 0;
    let mut rest: String = s;
    let mut k: Int = 0;
    while k < 32 {
        k = k + 1;
        let at: Int = str_index_of(rest, sub);
        if at < 0 {
            return n;
        }
        n = n + 1;
        rest = str_slice(rest, at + sl, chars_len(rest));
    }
    return n;
}

pub fn open75_lsp_serve_entry() {
    lsp_serve();
}

pub fn main() {
    let init: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///tmp\"}}";
    let shut: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\",\"params\":null}";
    let out: String = lsp_server_process_stream(init + "\n" + shut + "\n");
    if count_sub(out, "Content-Length:") != 2 {
        println("FAIL replies");
        process_exit(1);
    }
    if str_index_of(out, "capabilities") < 0 {
        println("FAIL initialize");
        process_exit(1);
    }
    if str_index_of(out, "\"result\":null") < 0 {
        println("FAIL shutdown");
        process_exit(1);
    }
    let framed: String = lsp_jsonrpc_frame(init) + lsp_jsonrpc_frame(shut);
    let out_fr: String = lsp_server_process_stream(framed);
    if count_sub(out_fr, "Content-Length:") != 2 {
        println("FAIL framed replies");
        process_exit(1);
    }
    println("open75: PASSED");
}
