// # Product prove std/cloud_k8s/raft_log_replication.oo
//
// Logline: Fail-closed emit+gcc+run asserts raft_replicator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/raft_log_replication.oo.
//
// Beats:
//   1. Call raft_replicator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_raft_log_replication: PASSED only if they match.

import "std/cloud_k8s/raft_log_replication.oo";

pub fn main() {
    let raft_log_replication_mark: Int = 0;
    if raft_log_replication_mark != 0 {
        process_exit(1);
    }
    let raft_log_replication_a: RaftReplicator = raft_replicator_new("x", 1);
    let raft_log_replication_b: RaftReplicator = raft_replicator_new("x", 1);
    if (raft_log_replication_a).current_term != (raft_log_replication_b).current_term {
        println("FAIL raft_replicator_new");
        process_exit(1);
    }
    println("prod_raft_log_replication: PASSED");
}
