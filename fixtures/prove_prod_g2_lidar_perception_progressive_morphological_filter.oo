// # Product prove std/lidar_perception/progressive_morphological_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts pmf_is_ground_point is a real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/progressive_morphological_filter.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pmf_is_ground_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_progressive_morphological_filter: PASSED only if they match.

import "std/lidar_perception/progressive_morphological_filter.oo";

pub fn main() {
    let g2_a = pmf_is_ground_point(1.0, 1.0, 1.0);
    let g2_b = pmf_is_ground_point(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL pmf_is_ground_point");
        process_exit(1);
    }
    println("prod_g2_progressive_morphological_filter: PASSED");
}
