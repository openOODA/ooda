// Cap vs FFI path A runtime: process-local UnsafeFFICap + stub oo_dlopen
// main injects long long ffi = oo_cap_grant_ffi();
pub fn main(ffi: &UnsafeFFICap) {
    let r = dlopen(ffi, "libx.so");
    if r.is_ok() {
        println("unexpected-ok");
    } else {
        println("ffi-stub-ok");
    }
}
