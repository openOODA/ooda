// # FFI stub runtime
//
// Logline: Call granted dlopen and print ffi-stub-ok on the stub Err.
//
// Beats:
//   1. Grant &UnsafeFFICap on main.
//   2. Call dlopen(ffi, "libx.so").
//   3. Print ffi-stub-ok unless the stub unexpectedly Ok.

// Cap vs FFI path A runtime: process-local UnsafeFFICap + stub oo_dlopen
// main injects long long ffi = oo_cap_grant_ffi();
pub fn main(ffi: &UnsafeFFICap) {
    let r = dlopen(ffi, "libx.so");
    if r.is_ok() {
        println("unexpected-ok");
    } else {
        println("ffi-stub-ok");
    }
}
