    let protein_mass_spec_peptides_a = mass_spec_aa_monoisotopic("x");
    let protein_mass_spec_peptides_b = mass_spec_aa_monoisotopic("x");
    if protein_mass_spec_peptides_a != protein_mass_spec_peptides_b {
        println("FAIL protein_mass_spec_peptides");
