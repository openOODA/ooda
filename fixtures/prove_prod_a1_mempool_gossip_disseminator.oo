// # Product prove std/bft_consensus/mempool_gossip_disseminator.oo
//
// Logline: Fail-closed emit+gcc+run asserts gossip_disseminator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/mempool_gossip_disseminator.oo.
//
// Beats:
//   1. Call gossip_disseminator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mempool_gossip_disseminator: PASSED only if they match.

import "std/bft_consensus/mempool_gossip_disseminator.oo";

pub fn main() {
    let mempool_gossip_disseminator_mark: Int = 0;
    if mempool_gossip_disseminator_mark != 0 {
        process_exit(1);
    }
    let a: GossipDisseminator = gossip_disseminator_new(0);
    let b: GossipDisseminator = gossip_disseminator_new(0);
    if (a).peer_count != (b).peer_count {
        println("FAIL gossip_disseminator_new");
        process_exit(1);
    }
    println("prod_mempool_gossip_disseminator: PASSED");
}
