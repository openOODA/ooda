// # Product prove std/auto_mpc_control/vehicle_coordinate_frames.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_speed_magnitude is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_coordinate_frames.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call compute_speed_magnitude twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_vehicle_coordinate_frames: PASSED only if they match.

import "std/auto_mpc_control/vehicle_coordinate_frames.oo";

pub fn main() {
    let g0_a = compute_speed_magnitude(0.0, 0.0);
    let g0_b = compute_speed_magnitude(0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL compute_speed_magnitude");
        process_exit(1);
    }
    println("prod_gr_vehicle_coordinate_frames: PASSED");
}
