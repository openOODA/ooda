// # Product bit_array prove
//
// Logline: Fail-closed emit+gcc+run of shipped bit_array_set/get/popcount.
//
// Setup: Product std/collections/bit_array.oo. Bits 1 and 3 set.
//
// Beats:
//   1. bit_array_len of 8 is 8.
//   2. After set 1 and 3, get 1 true, get 2 false, popcount 2.
//   3. Exit 1 before PASSED on a miss.

import "std/collections/bit_array.oo";

pub fn main() {
    let mut ba: BitArray = bit_array_new(8);
    let n: Int = bit_array_len(ba);
    if n != 8 {
        println("FAIL bitarr len");
        process_exit(1);
    }
    ba = bit_array_set(ba, 1);
    ba = bit_array_set(ba, 3);
    let t1: Bool = bit_array_get(ba, 1);
    if t1 == false {
        println("FAIL bitarr get 1");
        process_exit(1);
    }
    let t2: Bool = bit_array_get(ba, 2);
    if t2 == true {
        println("FAIL bitarr get 2");
        process_exit(1);
    }
    let c: Int = bit_array_popcount(ba);
    if c != 2 {
        println("FAIL bitarr popcount");
        process_exit(1);
    }
    println("prod_bitarr: PASSED");
}
