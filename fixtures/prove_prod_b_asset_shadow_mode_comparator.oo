// # Product prove std/digital_twin/asset_shadow_mode_comparator.oo
//
// Logline: Fail-closed emit+gcc+run asserts asset_shadow_mode_comparator_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_shadow_mode_comparator.oo.
//
// Beats:
//   1. Call asset_shadow_mode_comparator_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_asset_shadow_mode_comparator: PASSED only if they match.

import "std/digital_twin/asset_shadow_mode_comparator.oo";

pub fn main() {
    let a = asset_shadow_mode_comparator_probe();
    let b = asset_shadow_mode_comparator_probe();
    if a != b {
        println("FAIL asset_shadow_mode_comparator_probe");
        process_exit(1);
    }
    println("prod_asset_shadow_mode_comparator: PASSED");
}
