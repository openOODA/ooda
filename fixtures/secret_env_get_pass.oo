// # Allow a public env_get key
//
// Logline: A non-secret key may reach env_get while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public key instead.
//   3. Expect emit to allow the call.

// M140: non-secret key may env_get (emit path)
// SECRET: token
pub fn main(envc: &EnvCap) {
    let token = "SECRET_KEY";
    let public = "PATH";
    let r = env_get(envc, public);
    println(1);
}
