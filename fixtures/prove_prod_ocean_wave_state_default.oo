// # Product prove std/robotics_auv/wave_radiation_diffraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts ocean_wave_state_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/wave_radiation_diffraction.oo.
//
// Beats:
//   1. Call ocean_wave_state_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ocean_wave_state_default: PASSED only if they match.

import "std/robotics_auv/wave_radiation_diffraction.oo";

pub fn main() {
    let wave_radiation_diffraction_mark: Int = 0;
    if wave_radiation_diffraction_mark != 0 { process_exit(1); }
    let a: OceanWaveState = ocean_wave_state_default();
    let b: OceanWaveState = ocean_wave_state_default();
    if (a).amplitude_m != (b).amplitude_m {
        println("FAIL ocean_wave_state_default");
        process_exit(1);
    }
    println("prod_ocean_wave_state_default: PASSED");
}
