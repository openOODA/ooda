// # Println strcat of two string lits
//
// Logline: Print Hello, strcat! from two literals so emit-wasm must concat then fd_write.
//
// Setup: No imports. One public main. The body is only that println concat.
//
// Beats:
//   1. Declare public main.
//   2. Print "Hello, " plus "strcat!".
//   3. Leave no other statements.

pub fn main() { println("Hello, " + "strcat!"); }
