// # Product prove std/sec/sys/secure_boot_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts sboot_cert_x509 is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot_const.oo.
//
// Beats:
//   1. Call sboot_cert_x509 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secure_boot_const: PASSED only if they match.

import "std/sec/sys/secure_boot_const.oo";

pub fn main() {
    let a = sboot_cert_x509();
    let b = sboot_cert_x509();
    if a != b {
        println("FAIL sboot_cert_x509");
        process_exit(1);
    }
    println("prod_secure_boot_const: PASSED");
}
