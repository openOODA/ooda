// M161 libfloor path A: mutex_lock/unlock with granted ThreadCap → residual Err
// main injects long long thread = oo_cap_grant_thread();
// Honesty: no OS mutex — Result err "mutex residual: path A seal only"
pub fn main(thread: &ThreadCap) {
    let lk: Result[String, String] = mutex_lock(thread, 1);
    if lk.is_ok() {
        println("unexpected-ok");
    } else {
        println("mutex-residual-ok");
    }
    let uk: Result[String, String] = mutex_unlock(thread, 1);
    if uk.is_err() {
        println("mutex-unlock-residual-ok");
    } else {
        println("unexpected-unlock-ok");
    }
}
