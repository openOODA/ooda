// # ThreadCap mutex lock
//
// Logline: Lock and unlock mutex slot 1 under ThreadCap.
//
// Beats:
//   1. mutex_lock(thread, 1) and print lock ok or fail.
//   2. mutex_unlock(thread, 1) and print unlock ok or fail.
//   3. Real pthread mutex, not a residual stub.

// M162 path A: real pthread mutex under ThreadCap
pub fn main(thread: &ThreadCap) {
    let lk: Result[String, String] = mutex_lock(thread, 1);
    if lk.is_ok() {
        println("mutex-lock-ok");
    } else {
        println("mutex-lock-fail");
    }
    let uk: Result[String, String] = mutex_unlock(thread, 1);
    if uk.is_ok() {
        println("mutex-unlock-ok");
    } else {
        println("mutex-unlock-fail");
    }
}
