// # Product prove std/telecom/lte_rrc.oo
//
// Logline: Fail-closed emit+gcc+run asserts lte_rrc_is_connected is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/lte_rrc.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call lte_rrc_is_connected twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_lte_rrc: PASSED only if they match.

import "std/telecom/lte_rrc.oo";

pub fn main() {
    let g0_oa: LteRrcState = LteRrcState { state_id: 0, transaction_id: 0, ue_identity: 1, is_security_active: true, bearer_count: 0 };
    let g0_ob: LteRrcState = LteRrcState { state_id: 0, transaction_id: 0, ue_identity: 1, is_security_active: true, bearer_count: 0 };
    let g0_a = lte_rrc_is_connected(&g0_oa);
    let g0_b = lte_rrc_is_connected(&g0_ob);
    if g0_a != g0_b {
        println("FAIL lte_rrc_is_connected");
        process_exit(1);
    }
    println("prod_gr_lte_rrc: PASSED");
}
