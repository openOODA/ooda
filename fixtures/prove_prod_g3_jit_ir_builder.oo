// # Product prove std/wasm_gc/jit_ir_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts jir_function_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_ir_builder.oo.
//
// Beats:
//   1. Call jir_function_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_ir_builder: PASSED only if they match.

import "std/wasm_gc/jit_ir_builder.oo";

pub fn main() {
    let jit_ir_builder_mark: Int = 0;
    if jit_ir_builder_mark != 0 {
        process_exit(1);
    }
    let a: JirFunction = jir_function_new("x");
    let b: JirFunction = jir_function_new("x");
    if (a).block_count != (b).block_count {
        println("FAIL jir_function_new");
        process_exit(1);
    }
    println("prod_jit_ir_builder: PASSED");
}
