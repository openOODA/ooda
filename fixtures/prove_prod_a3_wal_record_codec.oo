// # Product prove std/db_storage/wal_record_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_wal_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_record_codec.oo.
//
// Beats:
//   1. Call compute_wal_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_record_codec: PASSED only if they match.

import "std/db_storage/wal_record_codec.oo";

pub fn main() {
    let wal_record_codec_mark: Int = 0;
    if wal_record_codec_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_wal_checksum(0, 0, "x");
    let b: Int = compute_wal_checksum(0, 0, "x");
    if a != b {
        println("FAIL compute_wal_checksum");
        process_exit(1);
    }
    println("prod_wal_record_codec: PASSED");
}
