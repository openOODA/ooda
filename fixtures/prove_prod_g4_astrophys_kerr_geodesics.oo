// # Product prove std/astrophysics_relativity/gr_kerr_black_hole_geodesics.oo
//
// Logline: Fail-closed verification that Kerr spacetime geodesic potentials and orbital integration steps are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_kerr_black_hole_geodesics.oo.
//
// Beats:
//   1. Compute Kerr radial potential R(r) and polar potential Theta(theta).
//   2. Step first-order Kerr geodesic equations of motion forward.
//   3. Assert deterministic state evolution.
//   4. Print prod_g4_astrophys_kerr_geodesics: PASSED and exit 0.

import "std/astrophysics_relativity/gr_kerr_black_hole_geodesics.oo";

pub fn main() {
    let gr_kerr_black_hole_geodesics_mark: Int = 0;
    if gr_kerr_black_hole_geodesics_mark != 0 {
        process_exit(1);
    }

    let consts: KerrGeodesicConstants = KerrGeodesicConstants {
        energy_e: 1.0,
        angular_momentum_lz: 2.0,
        carter_constant_q: 5.0,
        mass_param_mu: 1.0,
    };

    let r_pot_a: Float = kerr_radial_potential(6.0, 0.5, 1.0, consts);
    let r_pot_b: Float = kerr_radial_potential(6.0, 0.5, 1.0, consts);
    if r_pot_a != r_pot_b {
        println("FAIL kerr_radial_potential");
        process_exit(1);
    }

    let th_pot_a: Float = kerr_polar_potential(1.570796, 0.5, consts);
    let th_pot_b: Float = kerr_polar_potential(1.570796, 0.5, consts);
    if th_pot_a != th_pot_b {
        println("FAIL kerr_polar_potential");
        process_exit(1);
    }

    let st_init: KerrGeodesicState = KerrGeodesicState {
        r: 6.0,
        theta: 1.570796,
        phi: 0.0,
        t: 0.0,
        p_r: 0.0,
        p_theta: 0.0,
    };

    let st_next_a: KerrGeodesicState = kerr_geodesic_step(st_init, 0.5, 1.0, consts, 0.01);
    let st_next_b: KerrGeodesicState = kerr_geodesic_step(st_init, 0.5, 1.0, consts, 0.01);

    if (st_next_a).r != (st_next_b).r || (st_next_a).theta != (st_next_b).theta {
        println("FAIL kerr_geodesic_step r or theta");
        process_exit(1);
    }

    if (st_next_a).phi != (st_next_b).phi || (st_next_a).t != (st_next_b).t {
        println("FAIL kerr_geodesic_step phi or t");
        process_exit(1);
    }

    println("prod_g4_astrophys_kerr_geodesics: PASSED");
    process_exit(0);
}
