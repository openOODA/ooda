// # Product prove std/sec/sys/cfi_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts cfi_mode_disabled is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/cfi_const.oo.
//
// Beats:
//   1. Call cfi_mode_disabled twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cfi_const: PASSED only if they match.

import "std/sec/sys/cfi_const.oo";

pub fn main() {
    let a = cfi_mode_disabled();
    let b = cfi_mode_disabled();
    if a != b {
        println("FAIL cfi_mode_disabled");
        process_exit(1);
    }
    println("prod_cfi_const: PASSED");
}
