// # Import an installed vendor package
//
// Logline: Import vendor/hello.oo through the product search path and call hello_ok.
//
// Setup: cwd is ooda/. add or vendor placed vendor/hello.oo. No .. in the import name.
//
// Beats:
//   1. Resolve vendor/hello.oo from cwd.
//   2. Call hello_ok.
//   3. Print one success line.

import "vendor/hello.oo";

pub fn main() {
    if hello_ok() {
        println("import-vendor-hello");
    }
}
