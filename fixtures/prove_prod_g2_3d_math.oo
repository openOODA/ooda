// # Product prove std/3d/math.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec3_length_squared is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/math.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call vec3_length_squared twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_math: PASSED only if they match.

import "std/3d/math.oo";

pub fn main() {
    let g2_oa = vec3_new(2, 2, 2);
    let g2_ob = vec3_new(2, 2, 2);
    let g2_a = vec3_length_squared(g2_oa);
    let g2_b = vec3_length_squared(g2_ob);
    if g2_a != g2_b {
        println("FAIL vec3_length_squared");
        process_exit(1);
    }
    println("prod_g2_math: PASSED");
}
