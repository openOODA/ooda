// # Product prove std/security_defense/covert_channel_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts covert_channel_detector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/covert_channel_detector.oo.
//
// Beats:
//   1. Call covert_channel_detector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_covert_channel_detector: PASSED only if they match.

import "std/security_defense/covert_channel_detector.oo";

pub fn main() {
    let covert_channel_detector_mark: Int = 0;
    if covert_channel_detector_mark != 0 {
        process_exit(1);
    }
    let covert_channel_detector_a: CovertChannelDetector = covert_channel_detector_new(1);
    let covert_channel_detector_b: CovertChannelDetector = covert_channel_detector_new(1);
    if (covert_channel_detector_a).sample_count != (covert_channel_detector_b).sample_count {
        println("FAIL covert_channel_detector_new");
        process_exit(1);
    }
    println("prod_covert_channel_detector: PASSED");
}
