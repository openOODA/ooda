// # Product prove std/scicomp/geometric_algebra_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts mv2_norm_sq is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/geometric_algebra_2d.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call mv2_norm_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_geometric_algebra_2d: PASSED only if they match.

import "std/scicomp/geometric_algebra_2d.oo";

pub fn main() {
    let g0_oa: MultiVector2D = MultiVector2D { s: 0.0, e1: 0.0, e2: 0.0, e12: 0.0 };
    let g0_ob: MultiVector2D = MultiVector2D { s: 0.0, e1: 0.0, e2: 0.0, e12: 0.0 };
    let g0_a = mv2_norm_sq(&g0_oa);
    let g0_b = mv2_norm_sq(&g0_ob);
    if g0_a != g0_b {
        println("FAIL mv2_norm_sq");
        process_exit(1);
    }
    println("prod_gr_geometric_algebra_2d: PASSED");
}
