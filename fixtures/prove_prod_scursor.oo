// # Product stream_cursor prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_cursor_new/remaining/seek.
//
// Setup: Product std/io/stream_cursor.oo. Empty List[Int].
//
// Beats:
//   1. New cursor remaining 0; seek 0 position 0.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_cursor.oo";

pub fn main() {
    let xs: List[Int] = list_new();
    let mut c: StreamCursor = stream_cursor_new(xs);
    let rem: Int = stream_cursor_remaining(c);
    if rem != 0 {
        println("FAIL scursor rem");
        process_exit(1);
    }
    c = stream_cursor_seek(c, 0);
    let p: Int = c.position;
    if p != 0 {
        println("FAIL scursor pos");
        process_exit(1);
    }
    println("prod_scursor: PASSED");
}
