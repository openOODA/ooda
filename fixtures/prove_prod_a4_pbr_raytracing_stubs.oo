// # Product prove std/pbr_raytracing/pbr_raytracing_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts raytracing_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pbr_raytracing_stubs.oo.
//
// Beats:
//   1. Call raytracing_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pbr_raytracing_stubs: PASSED only if they match.

import "std/pbr_raytracing/pbr_raytracing_stubs.oo";

pub fn main() {
    let pbr_raytracing_stubs_mark: Int = 0;
    if pbr_raytracing_stubs_mark != 0 {
        process_exit(1);
    }
    let a: RaytracingCapabilities = raytracing_capabilities_default();
    let b: RaytracingCapabilities = raytracing_capabilities_default();
    if (a).max_bvh_depth != (b).max_bvh_depth {
        println("FAIL raytracing_capabilities_default");
        process_exit(1);
    }
    println("prod_pbr_raytracing_stubs: PASSED");
}
