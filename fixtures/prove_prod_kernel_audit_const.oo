// # Product prove std/sec/sys/kernel_audit_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_perm_exec is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit_const.oo.
//
// Beats:
//   1. Call audit_perm_exec twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_audit_const: PASSED only if they match.

import "std/sec/sys/kernel_audit_const.oo";

pub fn main() {
    let a = audit_perm_exec();
    let b = audit_perm_exec();
    if a != b {
        println("FAIL audit_perm_exec");
        process_exit(1);
    }
    println("prod_kernel_audit_const: PASSED");
}
