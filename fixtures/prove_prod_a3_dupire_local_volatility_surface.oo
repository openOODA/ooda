// # Product prove std/defi_derivatives/dupire_local_volatility_surface.oo
//
// Logline: Fail-closed emit+gcc+run asserts dupire_surface_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/dupire_local_volatility_surface.oo.
//
// Beats:
//   1. Call dupire_surface_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dupire_local_volatility_surface: PASSED only if they match.

import "std/defi_derivatives/dupire_local_volatility_surface.oo";

pub fn main() {
    let dupire_local_volatility_surface_mark: Int = 0;
    if dupire_local_volatility_surface_mark != 0 {
        process_exit(1);
    }
    let a: DupireSurfaceGrid = dupire_surface_new("x", 0.0, 0.0, 0.0);
    let b: DupireSurfaceGrid = dupire_surface_new("x", 0.0, 0.0, 0.0);
    if (a).spot_price != (b).spot_price {
        println("FAIL dupire_surface_new");
        process_exit(1);
    }
    println("prod_dupire_local_volatility_surface: PASSED");
}
