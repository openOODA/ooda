// # Product prove std/fhe_lattices/fhe_ring_lwe_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts rlwe_ciphertext_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ring_lwe_ciphertext.oo.
//
// Beats:
//   1. Call rlwe_ciphertext_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_ring_lwe_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_ring_lwe_ciphertext.oo";

pub fn main() {
    let fhe_ring_lwe_ciphertext_mark: Int = 0;
    if fhe_ring_lwe_ciphertext_mark != 0 {
        process_exit(1);
    }
    let a: RlweCiphertext = rlwe_ciphertext_new(list_new(), list_new(), 0, 0);
    let b: RlweCiphertext = rlwe_ciphertext_new(list_new(), list_new(), 0, 0);
    if (a).degree_n != (b).degree_n {
        println("FAIL rlwe_ciphertext_new");
        process_exit(1);
    }
    println("prod_fhe_ring_lwe_ciphertext: PASSED");
}
