// # Product prove std/nerf_3dgs/nerf_cone_frustum_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts cone_frustum_volume is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_cone_frustum_sampling.oo.
//
// Beats:
//   1. Call cone_frustum_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nerf_cone_frustum_sampling: PASSED only if they match.

import "std/nerf_3dgs/nerf_cone_frustum_sampling.oo";

pub fn main() {
    let nerf_cone_frustum_sampling_mark: Int = 0;
    if nerf_cone_frustum_sampling_mark != 0 {
        process_exit(1);
    }
    let a: Float = cone_frustum_volume(0.0, 0.0, 0.0);
    let b: Float = cone_frustum_volume(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL cone_frustum_volume");
        process_exit(1);
    }
    println("prod_g2_nerf_cone_frustum_sampling: PASSED");
}
