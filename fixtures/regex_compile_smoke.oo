// # regex_compile Result emit lock
//
// Logline: Fail-closed emit+gcc+run of regex_compile Ok handle and is_valid.
//
// Setup: Backend-C. Import std/text/regex.oo. Result[Regex, String] match.
//
// Beats:
//   1. Compile pattern ab.
//   2. Match Ok(re) and require re.is_valid.
//   3. Exit 1 before PASSED on a miss.

import "std/text/regex.oo";

pub fn main() {
    let r: Result[Regex, String] = regex_compile("ab");
    match r {
        Ok(re) => {
            if !re.is_valid {
                println("FAIL valid");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL err");
            process_exit(1);
        }
    }
    println("regex_compile_smoke: PASSED");
}
