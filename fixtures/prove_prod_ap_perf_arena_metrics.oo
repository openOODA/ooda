// # Product prove std/perf/arena_metrics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/arena_metrics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/arena_metrics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_arena_metrics: PASSED only if they match.

import "std/perf/arena_metrics.oo";

pub fn main() {
    let arena_metrics_a = arena_metrics_create("x");
    let arena_metrics_b = arena_metrics_create("x");
    let arena_metrics_va = arena_metrics_total_bytes(arena_metrics_a);
    let arena_metrics_vb = arena_metrics_total_bytes(arena_metrics_b);
    if arena_metrics_va != arena_metrics_vb {
        println("FAIL arena_metrics");
        process_exit(1);
    }
    println("prod_ap_arena_metrics: PASSED");
}
