// # Product prove std/sec/crypto/shamir_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts shamir_share_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/shamir_types.oo.
//
// Beats:
//   1. Call shamir_share_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shamir_types: PASSED only if they match.

import "std/sec/crypto/shamir_types.oo";

pub fn main() {
    let obj = shamir_share_new(0, 0, 0);
    let a = shamir_share_x(obj);
    let b = shamir_share_x(obj);
    if a != b {
        println("FAIL shamir_share_x");
        process_exit(1);
    }
    println("prod_shamir_types: PASSED");
}
