// # Product prove std/bio/cell_stubs.oo
//
// Logline: Fail-closed verification that cellular biology fail-closed stubs and markers are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_stubs.oo.
//
// Beats:
//   1. Call cell_stubs_marker twice and assert deterministic 0 return.
//   2. Print prod_g4_bio_cell_stubs: PASSED and exit 0.

import "std/bio/cell_stubs.oo";

pub fn main() {
    let m1: Int = cell_stubs_marker();
    let m2: Int = cell_stubs_marker();
    if m1 != m2 || m1 != 0 {
        println("FAIL cell_stubs_marker");
        process_exit(1);
    }

    println("prod_g4_bio_cell_stubs: PASSED");
    process_exit(0);
}
