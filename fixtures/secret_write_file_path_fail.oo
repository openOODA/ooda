// # Refuse a secret write_file path
//
// Logline: Pass a secret IDENT as the write_file path so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call write_file with token as the path.
//   3. Print 1 after the call.
//
// Secret refuse: write_file_path
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/sec";
    let content = "ok";
    let r = write_file(fs, token, content);
    println(1);
}
