// # Product prove std/compilers_polyhedral/autovec_loop_vectorizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_loop_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_loop_vectorizer.oo.
//
// Beats:
//   1. Call vector_loop_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_loop_vectorizer: PASSED only if they match.

import "std/compilers_polyhedral/autovec_loop_vectorizer.oo";

pub fn main() {
    let autovec_loop_vectorizer_mark: Int = 0;
    if autovec_loop_vectorizer_mark != 0 {
        process_exit(1);
    }
    let a: VectorLoopConfig = vector_loop_config_new(0, 0, 0);
    let b: VectorLoopConfig = vector_loop_config_new(0, 0, 0);
    if (a).loop_id != (b).loop_id {
        println("FAIL vector_loop_config_new");
        process_exit(1);
    }
    println("prod_autovec_loop_vectorizer: PASSED");
}
