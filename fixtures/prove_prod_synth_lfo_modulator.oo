// # Product prove std/media_dsp/synth_lfo_modulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts lfo_wave_sine real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_lfo_modulator.oo.
//
// Beats:
//   1. Call lfo_wave_sine with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_lfo_modulator: PASSED only if the assert holds.

import "std/media_dsp/synth_lfo_modulator.oo";

pub fn main() {
    let synth_lfo_modulator_mark: Int = 0;
    if synth_lfo_modulator_mark != 0 {
        process_exit(1);
    }
    let synth_lfo_modulator_n: Int = lfo_wave_sine();
    if synth_lfo_modulator_n != 0 {
        println("FAIL lfo_wave_sine");
        process_exit(1);
    }
    println("prod_synth_lfo_modulator: PASSED");
}
