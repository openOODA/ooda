// # Product prove std/ai_ml/onnx_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts onnx_node_op_id is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_ml/onnx_graph.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call onnx_node_op_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_onnx_graph: PASSED only if they match.

import "std/ai_ml/onnx_graph.oo";

pub fn main() {
    let g2_oa = onnx_node_new(2, 2);
    let g2_ob = onnx_node_new(2, 2);
    let g2_a = onnx_node_op_id(g2_oa);
    let g2_b = onnx_node_op_id(g2_ob);
    if g2_a != g2_b {
        println("FAIL onnx_node_op_id");
        process_exit(1);
    }
    println("prod_g2_onnx_graph: PASSED");
}
