// # Product prove std/telecom_6g/isac_radar_ofdm_ambiguity.oo
//
// Logline: Fail-closed emit+gcc+run asserts isac_ambiguity_2d_response is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_radar_ofdm_ambiguity.oo.
//
// Beats:
//   1. Call isac_ambiguity_2d_response twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isac_radar_ofdm_ambiguity: PASSED only if they match.

import "std/telecom_6g/isac_radar_ofdm_ambiguity.oo";

pub fn main() {
    let isac_radar_ofdm_ambiguity_mark: Int = 0;
    if isac_radar_ofdm_ambiguity_mark != 0 {
        process_exit(1);
    }
    let a: Float = isac_ambiguity_2d_response(0.0, 0.0, 0.0, 0.0);
    let b: Float = isac_ambiguity_2d_response(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL isac_ambiguity_2d_response");
        process_exit(1);
    }
    println("prod_isac_radar_ofdm_ambiguity: PASSED");
}
