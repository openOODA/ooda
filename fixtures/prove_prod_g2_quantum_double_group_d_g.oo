// # Product prove std/quantum_topological/quantum_double_group_d_g.oo
//
// Logline: Fail-closed emit+gcc+run asserts qd_anyon_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_double_group_d_g.oo.
//
// Beats:
//   1. Call qd_anyon_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_double_group_d_g: PASSED only if they match.

import "std/quantum_topological/quantum_double_group_d_g.oo";

pub fn main() {
    let quantum_double_group_d_g_mark: Int = 0;
    if quantum_double_group_d_g_mark != 0 {
        process_exit(1);
    }
    let a: QuantumDoubleAnyon = qd_anyon_new(0, 0, "x", 0.0, 0);
    let b: QuantumDoubleAnyon = qd_anyon_new(0, 0, "x", 0.0, 0);
    if (a).conjugacy_class_id != (b).conjugacy_class_id {
        println("FAIL qd_anyon_new");
        process_exit(1);
    }
    println("prod_g2_quantum_double_group_d_g: PASSED");
}
