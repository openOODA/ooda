// # Product prove std/quantum_topological/topological_levin_wen_string_net.oo
//
// Logline: Fail-closed emit+gcc+run asserts string_net_vertex_is_allowed_z2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_levin_wen_string_net.oo.
//
// Beats:
//   1. Call string_net_vertex_is_allowed_z2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_levin_wen_string_net: PASSED only if they match.

import "std/quantum_topological/topological_levin_wen_string_net.oo";

pub fn main() {
    let topological_levin_wen_string_net_mark: Int = 0;
    if topological_levin_wen_string_net_mark != 0 {
        process_exit(1);
    }
    let a: Int = string_net_vertex_is_allowed_z2(0, 0, 0);
    let b: Int = string_net_vertex_is_allowed_z2(0, 0, 0);
    if a != b {
        println("FAIL string_net_vertex_is_allowed_z2");
        process_exit(1);
    }
    println("prod_topological_levin_wen_string_net: PASSED");
}
