// # Product prove std/physics/aerodynamic_drag.oo
//
// Logline: Fail-closed emit+gcc+run asserts atmosphere_isa_standard is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/aerodynamic_drag.oo.
//
// Beats:
//   1. Call atmosphere_isa_standard twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aerodynamic_drag: PASSED only if they match.

import "std/physics/aerodynamic_drag.oo";

pub fn main() {
    let aerodynamic_drag_mark: Int = 0;
    if aerodynamic_drag_mark != 0 {
        process_exit(1);
    }
    let a: AtmosphereModel = atmosphere_isa_standard();
    let b: AtmosphereModel = atmosphere_isa_standard();
    if (a).sea_level_density != (b).sea_level_density {
        println("FAIL atmosphere_isa_standard");
        process_exit(1);
    }
    println("prod_aerodynamic_drag: PASSED");
}
