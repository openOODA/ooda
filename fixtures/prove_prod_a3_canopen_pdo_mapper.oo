// # Product prove std/iot_scada/canopen_pdo_mapper.oo
//
// Logline: Fail-closed emit+gcc+run asserts canopen_tpdo1_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/canopen_pdo_mapper.oo.
//
// Beats:
//   1. Call canopen_tpdo1_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_canopen_pdo_mapper: PASSED only if they match.

import "std/iot_scada/canopen_pdo_mapper.oo";

pub fn main() {
    let canopen_pdo_mapper_mark: Int = 0;
    if canopen_pdo_mapper_mark != 0 {
        process_exit(1);
    }
    let a: CanopenPdoMapping = canopen_tpdo1_default(0);
    let b: CanopenPdoMapping = canopen_tpdo1_default(0);
    if (a).cob_id != (b).cob_id {
        println("FAIL canopen_tpdo1_default");
        process_exit(1);
    }
    println("prod_canopen_pdo_mapper: PASSED");
}
