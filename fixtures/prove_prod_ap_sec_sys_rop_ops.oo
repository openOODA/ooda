// # Product prove std/sec/sys/rop_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/rop_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rop_ops: PASSED only if they match.

import "std/sec/sys/rop_ops.oo";

pub fn main() {
    let rop_ops_a = rop_gadget_create(0, 0, 0);
    let rop_ops_b = rop_gadget_create(0, 0, 0);
    let rop_ops_va = rop_gadget_verify(rop_ops_a);
    let rop_ops_vb = rop_gadget_verify(rop_ops_b);
    if rop_ops_va != rop_ops_vb {
        println("FAIL rop_ops");
        process_exit(1);
    }
    println("prod_ap_rop_ops: PASSED");
}
