// # Product prove std/pqc_nist/falcon_params.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_params_1024 is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_params.oo.
//
// Beats:
//   1. Call falcon_params_1024 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_params: PASSED only if they match.

import "std/pqc_nist/falcon_params.oo";

pub fn main() {
    let falcon_params_mark: Int = 0;
    if falcon_params_mark != 0 {
        process_exit(1);
    }
    let falcon_params_a = falcon_params_1024();
    let falcon_params_b = falcon_params_1024();
    if (falcon_params_a).degree_n != (falcon_params_b).degree_n {
        println("FAIL falcon_params_1024");
        process_exit(1);
    }
    println("prod_falcon_params: PASSED");
}
