// # Product prove std/quantum_open_systems/davies_generator_markovian.oo
//
// Logline: Fail-closed emit+gcc+run asserts davies_detailed_balance_residual is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/davies_generator_markovian.oo.
//
// Beats:
//   1. Call davies_detailed_balance_residual twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_davies_generator_markovian: PASSED only if they match.

import "std/quantum_open_systems/davies_generator_markovian.oo";

pub fn main() {
    let davies_generator_markovian_mark: Int = 0;
    if davies_generator_markovian_mark != 0 {
        process_exit(1);
    }
    let a: Float = davies_detailed_balance_residual(0.0, 0.0, 0.0, 0.0);
    let b: Float = davies_detailed_balance_residual(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL davies_detailed_balance_residual");
        process_exit(1);
    }
    println("prod_davies_generator_markovian: PASSED");
}
