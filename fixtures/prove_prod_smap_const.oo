// # Product prove std/sec/sys/smap_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts smap_cr4_bit is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/smap_const.oo.
//
// Beats:
//   1. Call smap_cr4_bit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smap_const: PASSED only if they match.

import "std/sec/sys/smap_const.oo";

pub fn main() {
    let a = smap_cr4_bit();
    let b = smap_cr4_bit();
    if a != b {
        println("FAIL smap_cr4_bit");
        process_exit(1);
    }
    println("prod_smap_const: PASSED");
}
