// # Product prove std/cloud_k8s/crdt_mv_register.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_k8s/crdt_mv_register.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_mv_register.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_crdt_mv_register: PASSED only if they match.

import "std/cloud_k8s/crdt_mv_register.oo";

pub fn main() {
    let crdt_mv_register_a = mv_register_new();
    let crdt_mv_register_b = mv_register_new();
    if crdt_mv_register_a.v0 != crdt_mv_register_b.v0 {
        println("FAIL crdt_mv_register");
        process_exit(1);
    }
    println("prod_ap_crdt_mv_register: PASSED");
}
