// # Product prove std/fhe_lattices/fhe_chebyshev_approximation.oo
//
// Logline: Fail-closed emit+gcc+run asserts chebyshev_fit_sigmoid_demo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_chebyshev_approximation.oo.
//
// Beats:
//   1. Call chebyshev_fit_sigmoid_demo twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_chebyshev_approximation: PASSED only if they match.

import "std/fhe_lattices/fhe_chebyshev_approximation.oo";

pub fn main() {
    let fhe_chebyshev_approximation_mark: Int = 0;
    if fhe_chebyshev_approximation_mark != 0 {
        process_exit(1);
    }
    let fhe_chebyshev_approximation_a = chebyshev_fit_sigmoid_demo();
    let fhe_chebyshev_approximation_b = chebyshev_fit_sigmoid_demo();
    if (fhe_chebyshev_approximation_a).degree_k != (fhe_chebyshev_approximation_b).degree_k {
        println("FAIL chebyshev_fit_sigmoid_demo");
        process_exit(1);
    }
    println("prod_fhe_chebyshev_approximation: PASSED");
}
