// # Product prove std/telecom_6g/hybrid_precoding_subconnected.oo
//
// Logline: Fail-closed verification that hybrid massive MIMO precoding architectures and power efficiency calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/hybrid_precoding_subconnected.oo.
//
// Beats:
//   1. Construct sub-connected and fully connected 128x8 hybrid massive MIMO architectures.
//   2. Compute RF chain power consumption and phase shifter hardware metrics.
//   3. Compare power efficiency ratios between architectures.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_mimo: PASSED and exit 0.

import "std/telecom_6g/hybrid_precoding_subconnected.oo";

pub fn main() {
    let sub_a: HybridPrecoderArchitecture = hybrid_architecture_subconnected_128x8();
    let sub_b: HybridPrecoderArchitecture = hybrid_architecture_subconnected_128x8();

    if (sub_a).num_tx_antennas != (sub_b).num_tx_antennas || (sub_a).num_tx_antennas != 128 {
        println("FAIL hybrid_architecture_subconnected_128x8 num_tx_antennas");
        process_exit(1);
    }

    if (sub_a).num_rf_chains != (sub_b).num_rf_chains || (sub_a).num_rf_chains != 8 {
        println("FAIL hybrid_architecture_subconnected_128x8 num_rf_chains");
        process_exit(1);
    }

    let full_a: HybridPrecoderArchitecture = hybrid_architecture_fully_connected_128x8();
    let full_b: HybridPrecoderArchitecture = hybrid_architecture_fully_connected_128x8();

    if (full_a).is_subconnected != (full_b).is_subconnected || (full_a).is_subconnected {
        println("FAIL hybrid_architecture_fully_connected_128x8 is_subconnected");
        process_exit(1);
    }

    let met_sub_a: HybridPrecodingMetrics = hybrid_calc_metrics(sub_a);
    let met_sub_b: HybridPrecodingMetrics = hybrid_calc_metrics(sub_b);

    if (met_sub_a).antennas_per_rf_chain != (met_sub_b).antennas_per_rf_chain || (met_sub_a).antennas_per_rf_chain != 16 {
        println("FAIL hybrid_calc_metrics antennas_per_rf_chain");
        process_exit(1);
    }

    if (met_sub_a).total_phase_shifters != (met_sub_b).total_phase_shifters || (met_sub_a).total_phase_shifters != 128 {
        println("FAIL hybrid_calc_metrics sub total_phase_shifters");
        process_exit(1);
    }

    let met_full_a: HybridPrecodingMetrics = hybrid_calc_metrics(full_a);
    let met_full_b: HybridPrecodingMetrics = hybrid_calc_metrics(full_b);

    if (met_full_a).total_phase_shifters != (met_full_b).total_phase_shifters || (met_full_a).total_phase_shifters != 1024 {
        println("FAIL hybrid_calc_metrics full total_phase_shifters");
        process_exit(1);
    }

    if (met_sub_a).total_rf_power_mw != (met_sub_b).total_rf_power_mw {
        println("FAIL hybrid_calc_metrics total_rf_power_mw");
        process_exit(1);
    }

    println("prod_g4_telecom_mimo: PASSED");
    process_exit(0);
}
