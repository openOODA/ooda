// # Product prove std/gis_spatial/gis_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts gis_hardware_accel_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/gis_stubs.oo.
//
// Beats:
//   1. Call gis_hardware_accel_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gis_stubs: PASSED only if they match.

import "std/gis_spatial/gis_stubs.oo";

pub fn main() {
    let gis_stubs_mark: Int = 0;
    if gis_stubs_mark != 0 {
        process_exit(1);
    }
    let a: GisHardwareAccel = gis_hardware_accel_init(0);
    let b: GisHardwareAccel = gis_hardware_accel_init(0);
    if (a).device_id != (b).device_id {
        println("FAIL gis_hardware_accel_init");
        process_exit(1);
    }
    println("prod_gis_stubs: PASSED");
}
