// # Product prove std/tda_topology/morse_smale_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts morse_field_count_critical_dim is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/morse_smale_complex.oo.
//
// Beats:
//   1. Call morse_field_count_critical_dim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_morse_smale_complex: PASSED only if they match.

import "std/tda_topology/morse_smale_complex.oo";

pub fn main() {
    let morse_smale_complex_mark: Int = 0;
    if morse_smale_complex_mark != 0 {
        process_exit(1);
    }
    let morse_smale_complex_obj: DiscreteMorseField = discrete_morse_field_new(1);
    let morse_smale_complex_a: Int = morse_field_count_critical_dim(&morse_smale_complex_obj, 1);
    let morse_smale_complex_b: Int = morse_field_count_critical_dim(&morse_smale_complex_obj, 1);
    if morse_smale_complex_a != morse_smale_complex_b {
        println("FAIL morse_field_count_critical_dim");
        process_exit(1);
    }
    println("prod_morse_smale_complex: PASSED");
}
