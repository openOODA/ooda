// # Product prove std/telecom_5g/sdr_iq_dma_ring_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_dma_ring_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sdr_iq_dma_ring_buffer.oo.
//
// Beats:
//   1. Call sdr_dma_ring_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sdr_iq_dma_ring_buffer: PASSED only if they match.

import "std/telecom_5g/sdr_iq_dma_ring_buffer.oo";

pub fn main() {
    let a: SdrDmaRingBuffer = sdr_dma_ring_buffer_new(1);
    let b: SdrDmaRingBuffer = sdr_dma_ring_buffer_new(1);
    if a.capacity_samples != b.capacity_samples {
        println("FAIL sdr_dma_ring_buffer_new");
        process_exit(1);
    }
    println("prod_sdr_iq_dma_ring_buffer: PASSED");
}
