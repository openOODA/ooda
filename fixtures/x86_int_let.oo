// # emit-x86 same-fn const-int let print
//
// Logline: Bind n to 7 and print n so emit-x86 can lower a lone const-int ident.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No plus.
//
// Beats:
//   1. Declare main.
//   2. Bind n to 7.
//   3. Print n.
//
// residual: integer ALU stays later.

pub fn main() {
    let n = 7;
    println(n);
}
