// # Product prove std/gis_topo/tin_delaunay_terrain.oo
//
// Logline: Fail-closed emit+gcc+run asserts tin_vertex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/tin_delaunay_terrain.oo.
//
// Beats:
//   1. Call tin_vertex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tin_delaunay_terrain: PASSED only if they match.

import "std/gis_topo/tin_delaunay_terrain.oo";

pub fn main() {
    let a: TinVertex3D = tin_vertex_new(0, 0.0, 0.0, 0.0);
    let b: TinVertex3D = tin_vertex_new(0, 0.0, 0.0, 0.0);
    if a.id != b.id {
        println("FAIL tin_vertex_new");
        process_exit(1);
    }
    println("prod_tin_delaunay_terrain: PASSED");
}
