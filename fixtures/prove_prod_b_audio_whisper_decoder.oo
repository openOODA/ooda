// # Product prove std/ai_multimodal/audio_whisper_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_whisper_decoder_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/audio_whisper_decoder.oo.
//
// Beats:
//   1. Call audio_whisper_decoder_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audio_whisper_decoder: PASSED only if they match.

import "std/ai_multimodal/audio_whisper_decoder.oo";

pub fn main() {
    let a = audio_whisper_decoder_marker();
    let b = audio_whisper_decoder_marker();
    if a != b {
        println("FAIL audio_whisper_decoder_marker");
        process_exit(1);
    }
    println("prod_audio_whisper_decoder: PASSED");
}
