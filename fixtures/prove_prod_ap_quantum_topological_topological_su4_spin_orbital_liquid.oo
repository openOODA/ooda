    let topological_su4_spin_orbital_liquid_a = su4_casimir_eigenvalue();
    let topological_su4_spin_orbital_liquid_b = su4_casimir_eigenvalue();
    if topological_su4_spin_orbital_liquid_a != topological_su4_spin_orbital_liquid_b {
        println("FAIL topological_su4_spin_orbital_liquid");
        process_exit(1);
