// # Product prove std/media_dsp/dsp_dynamic_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts compressor_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_dynamic_compressor.oo.
//
// Beats:
//   1. Call compressor_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_dynamic_compressor: PASSED only if they match.

import "std/media_dsp/dsp_dynamic_compressor.oo";

pub fn main() {
    let dsp_dynamic_compressor_mark: Int = 0;
    if dsp_dynamic_compressor_mark != 0 {
        process_exit(1);
    }
    let dsp_dynamic_compressor_a = compressor_state_new();
    let dsp_dynamic_compressor_b = compressor_state_new();
    if (dsp_dynamic_compressor_a).envelope_db != (dsp_dynamic_compressor_b).envelope_db {
        println("FAIL compressor_state_new");
        process_exit(1);
    }
    println("prod_dsp_dynamic_compressor: PASSED");
}
