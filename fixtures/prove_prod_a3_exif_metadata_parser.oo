// # Product prove std/media_dsp/exif_metadata_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts exif_tag_image_width is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/exif_metadata_parser.oo.
//
// Beats:
//   1. Call exif_tag_image_width twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_exif_metadata_parser: PASSED only if they match.

import "std/media_dsp/exif_metadata_parser.oo";

pub fn main() {
    let exif_metadata_parser_mark: Int = 0;
    if exif_metadata_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = exif_tag_image_width();
    let b: Int = exif_tag_image_width();
    if a != b {
        println("FAIL exif_tag_image_width");
        process_exit(1);
    }
    println("prod_exif_metadata_parser: PASSED");
}
