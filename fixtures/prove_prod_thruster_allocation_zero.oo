// # Product prove std/robotics_auv/thruster_allocation_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts thruster_allocation_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/thruster_allocation_matrix.oo.
//
// Beats:
//   1. Call thruster_allocation_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thruster_allocation_zero: PASSED only if they match.

import "std/robotics_auv/thruster_allocation_matrix.oo";

pub fn main() {
    let thruster_allocation_matrix_mark: Int = 0;
    if thruster_allocation_matrix_mark != 0 { process_exit(1); }
    let a: ThrusterAllocation8 = thruster_allocation_zero();
    let b: ThrusterAllocation8 = thruster_allocation_zero();
    if (a).t1 != (b).t1 {
        println("FAIL thruster_allocation_zero");
        process_exit(1);
    }
    println("prod_thruster_allocation_zero: PASSED");
}
