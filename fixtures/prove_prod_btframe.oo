// # Product diag backtrace frame prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/backtrace.oo.
//
// Setup: Product std/diag/backtrace.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. frame_format #0 main at main.oo:42.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/backtrace.oo";

pub fn main() {
    let f: StackFrame = frame_new(0, "main", "main.oo", 42);
    let s: String = frame_format(f);
    if s != "#0 main at main.oo:42" {
        println("FAIL btframe");
        process_exit(1);
    }
    println("prod_btframe: PASSED");
}
