// # Product prove std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo
//
// Logline: Fail-closed emit+gcc+run asserts soup_process_sequenced_packet is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call soup_process_sequenced_packet twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nasdaq_ouch50_soupbintcp: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo";

pub fn main() {
    let mut g2_oa: SoupSessionState = SoupSessionState { session_id: "x", username: "x", is_authenticated: true, inbound_seq: 2, outbound_seq: 2, last_heartbeat_sent_ns: 2, last_heartbeat_rcvd_ns: 2, heartbeat_interval_ms: 2, session_status: "x" };
    let mut g2_ob: SoupSessionState = SoupSessionState { session_id: "x", username: "x", is_authenticated: true, inbound_seq: 2, outbound_seq: 2, last_heartbeat_sent_ns: 2, last_heartbeat_rcvd_ns: 2, heartbeat_interval_ms: 2, session_status: "x" };
    let g2_a = soup_process_sequenced_packet(&g2_oa, 2);
    let g2_b = soup_process_sequenced_packet(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL soup_process_sequenced_packet");
        process_exit(1);
    }
    println("prod_g2_nasdaq_ouch50_soupbintcp: PASSED");
}
