// # Product prove std/fintech_l3_book/dma_order_rate_limiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_bucket_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_order_rate_limiter.oo.
//
// Beats:
//   1. Call token_bucket_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_order_rate_limiter: PASSED only if they match.

import "std/fintech_l3_book/dma_order_rate_limiter.oo";

pub fn main() {
    let dma_order_rate_limiter_mark: Int = 0;
    if dma_order_rate_limiter_mark != 0 {
        process_exit(1);
    }
    let dma_order_rate_limiter_a = token_bucket_state_new(1, 1);
    let dma_order_rate_limiter_b = token_bucket_state_new(1, 1);
    if (dma_order_rate_limiter_a).available_tokens != (dma_order_rate_limiter_b).available_tokens {
        println("FAIL token_bucket_state_new");
        process_exit(1);
    }
    println("prod_dma_order_rate_limiter: PASSED");
}
