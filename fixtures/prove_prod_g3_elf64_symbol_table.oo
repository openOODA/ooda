// # Product prove std/compilers_vm/elf64_symbol_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts stb_local is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/elf64_symbol_table.oo.
//
// Beats:
//   1. Call stb_local twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf64_symbol_table: PASSED only if they match.

import "std/compilers_vm/elf64_symbol_table.oo";

pub fn main() {
    let elf64_symbol_table_mark: Int = 0;
    if elf64_symbol_table_mark != 0 {
        process_exit(1);
    }
    let a: Int = stb_local();
    let b: Int = stb_local();
    if a != b {
        println("FAIL stb_local");
        process_exit(1);
    }
    println("prod_elf64_symbol_table: PASSED");
}
