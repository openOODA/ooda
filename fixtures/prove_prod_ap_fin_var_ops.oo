// # Product prove std/fin/var_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/var_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_var_ops: PASSED only if they match.

import "std/fin/var_ops.oo";

pub fn main() {
    let var_ops_a = z_score_for_confidence(0.0);
    let var_ops_b = z_score_for_confidence(0.0);
    if var_ops_a != var_ops_b {
        println("FAIL var_ops");
        process_exit(1);
    }
    println("prod_ap_var_ops: PASSED");
}
