// # Product prove std/fin/orderbook_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/orderbook_types.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_types.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_orderbook_types: PASSED only if they match.

import "std/fin/orderbook_types.oo";

pub fn main() {
    let orderbook_types_mark: Int = 0;
    if orderbook_types_mark != 0 {
        process_exit(1);
    }
    let orderbook_types_a: LimitOrder = limit_order_new(0, 0, 0);
    let orderbook_types_b: LimitOrder = limit_order_new(0, 0, 0);
    if (orderbook_types_a).order_id != (orderbook_types_b).order_id {
        println("FAIL orderbook_types");
        process_exit(1);
    }
    println("prod_ap_orderbook_types: PASSED");
    process_exit(0);
}
