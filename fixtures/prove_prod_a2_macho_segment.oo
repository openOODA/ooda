// # Product prove std/compilers/macho_segment.oo
//
// Logline: Fail-closed emit+gcc+run asserts macho_segment_command64_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/macho_segment.oo.
//
// Beats:
//   1. Call macho_segment_command64_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_macho_segment: PASSED only if they match.

import "std/compilers/macho_segment.oo";

pub fn main() {
    let a: Int = macho_segment_command64_bytes();
    let b: Int = macho_segment_command64_bytes();
    if a != b {
        println("FAIL macho_segment_command64_bytes");
        process_exit(1);
    }
    println("prod_macho_segment: PASSED");
}
