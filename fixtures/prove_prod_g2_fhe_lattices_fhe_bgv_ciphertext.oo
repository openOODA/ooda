// # Product prove std/fhe_lattices/fhe_bgv_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts bgv_ciphertext_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bgv_ciphertext.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bgv_ciphertext_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_bgv_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_bgv_ciphertext.oo";

pub fn main() {
    let g2_oa: BgvCiphertext = bgv_ciphertext_new(list_new(), list_new(), 2, 2, 2, 2);
    let g2_ob: BgvCiphertext = bgv_ciphertext_new(list_new(), list_new(), 2, 2, 2, 2);
    let g2_a = (g2_oa).degree_n;
    let g2_b = (g2_ob).degree_n;
    if g2_a != g2_b {
        println("FAIL bgv_ciphertext_new.degree_n");
        process_exit(1);
    }
    println("prod_g2_fhe_bgv_ciphertext: PASSED");
}
