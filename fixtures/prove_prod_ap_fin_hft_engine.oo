// # Product prove std/fin/hft_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/hft_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hft_engine: PASSED only if they match.

import "std/fin/hft_engine.oo";

pub fn main() {
    let hft_engine_a = hft_engine_init("x", 0, 0, 0);
    let hft_engine_b = hft_engine_init("x", 0, 0, 0);
    let hft_engine_va = hft_engine_can_submit_order(hft_engine_a, 0, 0);
    let hft_engine_vb = hft_engine_can_submit_order(hft_engine_b, 0, 0);
    if hft_engine_va != hft_engine_vb {
        println("FAIL hft_engine");
        process_exit(1);
    }
    println("prod_ap_hft_engine: PASSED");
}
