// # Product prove std/fintech_l3_book/l3_book_delta_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts compression_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_book_delta_compressor.oo.
//
// Beats:
//   1. Call compression_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_book_delta_compressor: PASSED only if they match.

import "std/fintech_l3_book/l3_book_delta_compressor.oo";

pub fn main() {
    let l3_book_delta_compressor_mark: Int = 0;
    if l3_book_delta_compressor_mark != 0 {
        process_exit(1);
    }
    let a: CompressionState = compression_state_new(0, 0);
    let b: CompressionState = compression_state_new(0, 0);
    if (a).base_order_id != (b).base_order_id {
        println("FAIL compression_state_new");
        process_exit(1);
    }
    println("prod_g2_l3_book_delta_compressor: PASSED");
}
