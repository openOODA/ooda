// # Product prove std/astro_advanced/planetary_entry_heating.oo
//
// Logline: Fail-closed emit+gcc+run asserts entry_qdot is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/planetary_entry_heating.oo.
//
// Beats:
//   1. Call entry_qdot twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_planetary_entry_heating: PASSED only if they match.

import "std/astro_advanced/planetary_entry_heating.oo";

pub fn main() {
    let planetary_entry_heating_mark: Int = 0;
    if planetary_entry_heating_mark != 0 {
        process_exit(1);
    }
    let a: Int = entry_qdot();
    let b: Int = entry_qdot();
    if a != b {
        println("FAIL entry_qdot");
        process_exit(1);
    }
    println("prod_planetary_entry_heating: PASSED");
}
