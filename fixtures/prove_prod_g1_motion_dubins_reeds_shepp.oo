// # Product prove std/robotics_ros2/motion_dubins_reeds_shepp.oo
//
// Logline: Fail-closed emit+gcc+run asserts dubins_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_dubins_reeds_shepp.oo.
//
// Beats:
//   1. Call dubins_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_motion_dubins_reeds_shepp: PASSED only if they match.

import "std/robotics_ros2/motion_dubins_reeds_shepp.oo";

pub fn main() {
    let a: DubinsState2D = dubins_state_new(0.0, 0.0, 0.0);
    let b: DubinsState2D = dubins_state_new(0.0, 0.0, 0.0);
    if a.x != b.x {
        println("FAIL dubins_state_new");
        process_exit(1);
    }
    println("prod_motion_dubins_reeds_shepp: PASSED");
}
