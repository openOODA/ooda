// # Product prove std/quantum_open_systems/heisenberg_langevin_equations.oo
//
// Logline: Fail-closed emit+gcc+run asserts langevin_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/heisenberg_langevin_equations.oo.
//
// Beats:
//   1. Call langevin_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heisenberg_langevin_equations: PASSED only if they match.

import "std/quantum_open_systems/heisenberg_langevin_equations.oo";

pub fn main() {
    let heisenberg_langevin_equations_mark: Int = 0;
    if heisenberg_langevin_equations_mark != 0 {
        process_exit(1);
    }
    let a: LangevinOscillatorParams = langevin_params_new(0.0, 0.0, 0.0);
    let b: LangevinOscillatorParams = langevin_params_new(0.0, 0.0, 0.0);
    if (a).resonance_freq != (b).resonance_freq {
        println("FAIL langevin_params_new");
        process_exit(1);
    }
    println("prod_heisenberg_langevin_equations: PASSED");
}
