// # Product prove std/grid/battery_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_bank_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_types.oo.
//
// Beats:
//   1. Call battery_bank_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_battery_types: PASSED only if they match.

import "std/grid/battery_types.oo";

pub fn main() {
    let battery_types_mark: Int = 0;
    if battery_types_mark != 0 {
        process_exit(1);
    }
    let a: BatteryBank = battery_bank_new(0, 0);
    let b: BatteryBank = battery_bank_new(0, 0);
    if (a).cycle_count != (b).cycle_count {
        println("FAIL battery_bank_new");
        process_exit(1);
    }
    println("prod_battery_types: PASSED");
}
