// # Product prove std/media_dsp/vorbis_floor_residue.oo
//
// Logline: Fail-closed emit+gcc+run asserts vorbis_floor1_render_line is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/vorbis_floor_residue.oo.
//
// Beats:
//   1. Call vorbis_floor1_render_line twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vorbis_floor_residue: PASSED only if they match.

import "std/media_dsp/vorbis_floor_residue.oo";

pub fn main() {
    let vorbis_floor_residue_mark: Int = 0;
    if vorbis_floor_residue_mark != 0 {
        process_exit(1);
    }
    let a: Int = vorbis_floor1_render_line(0, 0, 0, 0, 0);
    let b: Int = vorbis_floor1_render_line(0, 0, 0, 0, 0);
    if a != b {
        println("FAIL vorbis_floor1_render_line");
        process_exit(1);
    }
    println("prod_vorbis_floor_residue: PASSED");
}
