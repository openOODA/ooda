// # Product prove std/sec/sys/landlock_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/landlock_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/landlock_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_landlock_ops: PASSED only if they match.

import "std/sec/sys/landlock_ops.oo";

pub fn main() {
    let landlock_ops_a = access_rights_has_fs_permission(0, 0);
    let landlock_ops_b = access_rights_has_fs_permission(0, 0);
    if landlock_ops_a != landlock_ops_b {
        println("FAIL landlock_ops");
        process_exit(1);
    }
    println("prod_ap_landlock_ops: PASSED");
}
