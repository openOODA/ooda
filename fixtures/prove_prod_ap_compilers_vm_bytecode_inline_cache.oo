// # Product prove std/compilers_vm/bytecode_inline_cache.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/bytecode_inline_cache.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_inline_cache.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bytecode_inline_cache: PASSED only if they match.

import "std/compilers_vm/bytecode_inline_cache.oo";

pub fn main() {
    let bytecode_inline_cache_a = ic_state_uninitialized();
    let bytecode_inline_cache_b = ic_state_uninitialized();
    if bytecode_inline_cache_a != bytecode_inline_cache_b {
        println("FAIL bytecode_inline_cache");
        process_exit(1);
    }
    println("prod_ap_bytecode_inline_cache: PASSED");
}
