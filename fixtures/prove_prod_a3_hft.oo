// # Product prove std/fin/hft.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_tick_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft.oo.
//
// Beats:
//   1. Call shim_marker_tick_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft: PASSED only if they match.

import "std/fin/hft.oo";

pub fn main() {
    let hft_mark: Int = 0;
    if hft_mark != 0 {
        process_exit(1);
    }
    let a: TickData = shim_marker_tick_create();
    let b: TickData = shim_marker_tick_create();
    if (a).price != (b).price {
        println("FAIL shim_marker_tick_create");
        process_exit(1);
    }
    println("prod_hft: PASSED");
}
