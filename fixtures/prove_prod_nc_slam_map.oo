// # Product prove std/robot/slam_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts slam_map_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/robot/slam_map.oo.
//
// Beats:
//   1. Call slam_map_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_slam_map: PASSED only if it matches.

import "std/robot/slam_map.oo";

pub fn main() {
    let a: Int = slam_map_probe();
    if a != 0 {
        println("FAIL slam_map_probe");
        process_exit(1);
    }
    println("prod_nc_slam_map: PASSED");
}
