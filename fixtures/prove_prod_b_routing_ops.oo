// # Product prove std/fin/routing_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts routing_ops_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing_ops.oo.
//
// Beats:
//   1. Call routing_ops_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_routing_ops: PASSED only if they match.

import "std/fin/routing_ops.oo";

pub fn main() {
    let a = routing_ops_probe();
    let b = routing_ops_probe();
    if a != b {
        println("FAIL routing_ops_probe");
        process_exit(1);
    }
    println("prod_routing_ops: PASSED");
}
