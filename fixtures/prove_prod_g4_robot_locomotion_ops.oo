// # Product prove std/robot/locomotion_ops.oo
//
// Logline: Fail-closed verification that wheel kinematics, legged gait stepping, and PID feedback math are deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/locomotion_ops.oo.
//
// Beats:
//   1. Verify differential, Ackermann, and Mecanum forward and inverse kinematics.
//   2. Step quadruped gait state and compute swing foot trajectories.
//   3. Run analytical 2-link leg inverse kinematics and PID feedback loop updates.
//   4. Print prod_g4_robot_locomotion_ops: PASSED and exit 0.

import "std/robot/locomotion_ops.oo";

pub fn main() {
    let tw: Twist = diff_drive_forward(10.0, 10.0, 0.1, 0.5);
    if (tw).linear.x != 1.0 || (tw).angular.z != 0.0 {
        println("FAIL diff_drive_forward");
        process_exit(1);
    }
    let w_l: Float = diff_drive_inverse_left(1.0, 0.0, 0.1, 0.5);
    let w_r: Float = diff_drive_inverse_right(1.0, 0.0, 0.1, 0.5);
    if w_l != 10.0 || w_r != 10.0 {
        println("FAIL diff_drive_inverse");
        process_exit(1);
    }

    let ack_tw: Twist = ackermann_forward(2.0, 0.0, 1.0);
    if (ack_tw).linear.x != 2.0 || (ack_tw).angular.z != 0.0 {
        println("FAIL ackermann_forward");
        process_exit(1);
    }
    let steer: Float = ackermann_inverse_steer(2.0, 0.0, 1.0, 0.5);
    if steer != 0.0 {
        println("FAIL ackermann_inverse_steer");
        process_exit(1);
    }

    let ws: WheelSpeeds = mecanum_inverse_wheel_speeds(1.0, 0.0, 0.0, 0.1, 0.5, 0.4);
    let m_tw: Twist = mecanum_forward(ws, 0.1, 0.5, 0.4);
    if (m_tw).linear.x != 1.0 {
        println("FAIL mecanum kinematics");
        process_exit(1);
    }

    let g_init: QuadrupedGaitState = quadruped_gait_init(0, 0.05, 2.0);
    let g_next: QuadrupedGaitState = quadruped_gait_step(g_init, 0.1);
    if (g_next).phase != 0.2 {
        println("FAIL quadruped_gait_step");
        process_exit(1);
    }
    let h_stance: Float = quadruped_compute_foot_height(0.2, 0.05, 0.5);
    let h_swing: Float = quadruped_compute_foot_height(0.75, 0.05, 0.5);
    if h_stance != 0.0 || h_swing <= 0.0 {
        println("FAIL quadruped_compute_foot_height");
        process_exit(1);
    }

    let leg: LegJoints = leg_kinematics_inverse(0.0, 0.3, 0.2, 0.2);
    if (leg).knee_pitch <= 0.0 {
        println("FAIL leg_kinematics_inverse");
        process_exit(1);
    }

    let pid0: PidController = pid_init(1.0, 0.1, 0.01, 10.0);
    let step1: PidStep = pid_update(pid0, 5.0, 0.0, 0.1);
    let out1: Float = pid_step_output(step1);
    let step2: PidStep = pid_update(pid0, 5.0, 0.0, 0.1);
    let out2: Float = pid_step_output(step2);
    if out1 != out2 || out1 <= 0.0 {
        println("FAIL pid_update");
        process_exit(1);
    }

    println("prod_g4_robot_locomotion_ops: PASSED");
    process_exit(0);
}
