// # Product prove std/uav_flight/uav_flight_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts uav_hal_pwm_write_stub is a real value.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_flight_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call uav_hal_pwm_write_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_flight_stubs: PASSED only if they match.

import "std/uav_flight/uav_flight_stubs.oo";

pub fn main() {
    let g2_a = uav_hal_pwm_write_stub(2, 1.0, true);
    let g2_b = uav_hal_pwm_write_stub(2, 1.0, true);
    if g2_a != g2_b {
        println("FAIL uav_hal_pwm_write_stub");
        process_exit(1);
    }
    println("prod_g2_uav_flight_stubs: PASSED");
}
