// # Product prove std/web_protocols/webrtc_sdp_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdp_value_n is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/webrtc_sdp_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sdp_value_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_webrtc_sdp_parser: PASSED only if they match.

import "std/web_protocols/webrtc_sdp_parser.oo";

pub fn main() {
    let g2_a = sdp_value_n(2, 2);
    let g2_b = sdp_value_n(2, 2);
    if g2_a != g2_b {
        println("FAIL sdp_value_n");
        process_exit(1);
    }
    println("prod_g2_webrtc_sdp_parser: PASSED");
}
