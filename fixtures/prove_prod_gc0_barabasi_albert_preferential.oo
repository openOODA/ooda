// # Product prove std/graph_networks/barabasi_albert_preferential.oo
//
// Logline: Fail-closed emit+gcc+run asserts ba_update_degree is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/barabasi_albert_preferential.oo.
//
// Beats:
//   1. Call ba_update_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_barabasi_albert_preferential: PASSED only if they match.

import "std/graph_networks/barabasi_albert_preferential.oo";

pub fn main() {
    let barabasi_albert_preferential_mark: Int = 0;
    if barabasi_albert_preferential_mark != 0 {
        process_exit(1);
    }
    let barabasi_albert_preferential_xa = ba_update_degree(list_new(), 1, 1);
    let barabasi_albert_preferential_xb = ba_update_degree(list_new(), 1, 1);
    let barabasi_albert_preferential_a: Int = list_len(barabasi_albert_preferential_xa);
    let barabasi_albert_preferential_b: Int = list_len(barabasi_albert_preferential_xb);
    if barabasi_albert_preferential_a != barabasi_albert_preferential_b {
        println("FAIL ba_update_degree");
        process_exit(1);
    }
    println("prod_barabasi_albert_preferential: PASSED");
}
