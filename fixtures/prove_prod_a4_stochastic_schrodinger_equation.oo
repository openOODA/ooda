// # Product prove std/quantum_open_systems/stochastic_schrodinger_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts sse_c_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/stochastic_schrodinger_equation.oo.
//
// Beats:
//   1. Call sse_c_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stochastic_schrodinger_equation: PASSED only if they match.

import "std/quantum_open_systems/stochastic_schrodinger_equation.oo";

pub fn main() {
    let stochastic_schrodinger_equation_mark: Int = 0;
    if stochastic_schrodinger_equation_mark != 0 {
        process_exit(1);
    }
    let a: Complex = sse_c_new(0.0, 0.0);
    let b: Complex = sse_c_new(0.0, 0.0);
    if (a).real != (b).real {
        println("FAIL sse_c_new");
        process_exit(1);
    }
    println("prod_stochastic_schrodinger_equation: PASSED");
}
