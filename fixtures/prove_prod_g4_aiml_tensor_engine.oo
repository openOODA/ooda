// # Product prove std/ai_ml/tensor_engine.oo
//
// Logline: Fail-closed verification that tensor allocation, PRNG generation, and weight initializers are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_engine.oo.
//
// Beats:
//   1. Construct TensorEngine context and allocate zero/one buffers.
//   2. Validate deterministic LCG pseudo-random number sequence.
//   3. Initialize Xavier and He 2D weight matrices.
//   4. Print prod_g4_aiml_tensor_engine: PASSED and exit 0.

import "std/ai_ml/tensor_engine.oo";

pub fn main() {
    let eng: TensorEngine = tensor_engine_new(0);
    if (eng).current_device != 0 || (eng).initialized != true {
        println("FAIL tensor_engine_new");
        process_exit(1);
    }

    let t1: Tensor1D = tensor_1d_zeros(5);
    if (t1).size != 5 {
        println("FAIL tensor_1d_zeros");
        process_exit(1);
    }

    let t2: Tensor2D = tensor_2d_ones(3, 4);
    if (t2).rows != 3 || (t2).cols != 4 {
        println("FAIL tensor_2d_ones");
        process_exit(1);
    }

    let r1: Int = pseudo_rand_lcg(12345);
    let r2: Int = pseudo_rand_lcg(12345);
    if r1 != r2 {
        println("FAIL pseudo_rand_lcg");
        process_exit(1);
    }

    let tx: Tensor2D = tensor_2d_xavier_init(2, 3, 42);
    if (tx).rows != 2 || (tx).cols != 3 {
        println("FAIL tensor_2d_xavier_init");
        process_exit(1);
    }

    let th: Tensor2D = tensor_2d_he_init(2, 3, 42);
    if (th).rows != 2 || (th).cols != 3 {
        println("FAIL tensor_2d_he_init");
        process_exit(1);
    }

    println("prod_g4_aiml_tensor_engine: PASSED");
    process_exit(0);
}
