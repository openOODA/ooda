// # Product prove std/astro_advanced/lunar_landing_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts lunar_land_dv is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/lunar_landing_guidance.oo.
//
// Beats:
//   1. Call lunar_land_dv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lunar_landing_guidance: PASSED only if they match.

import "std/astro_advanced/lunar_landing_guidance.oo";

pub fn main() {
    let lunar_landing_guidance_mark: Int = 0;
    if lunar_landing_guidance_mark != 0 {
        process_exit(1);
    }
    let a: Int = lunar_land_dv();
    let b: Int = lunar_land_dv();
    if a != b {
        println("FAIL lunar_land_dv");
        process_exit(1);
    }
    println("prod_lunar_landing_guidance: PASSED");
}
