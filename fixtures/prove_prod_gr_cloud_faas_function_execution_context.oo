// # Product prove std/cloud_faas/function_execution_context.oo
//
// Logline: Fail-closed emit+gcc+run asserts context_get_remaining_time_ms is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/function_execution_context.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call context_get_remaining_time_ms twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_function_execution_context: PASSED only if they match.

import "std/cloud_faas/function_execution_context.oo";

pub fn main() {
    let g0_oa: FunctionExecutionContext = FunctionExecutionContext { aws_request_id: "x", invoked_function_arn: "x", memory_limit_in_mb: 0, log_group_name: "x", log_stream_name: "x", deadline_ms: 0, trace_id: "x" };
    let g0_ob: FunctionExecutionContext = FunctionExecutionContext { aws_request_id: "x", invoked_function_arn: "x", memory_limit_in_mb: 0, log_group_name: "x", log_stream_name: "x", deadline_ms: 0, trace_id: "x" };
    let g0_a = context_get_remaining_time_ms(&g0_oa, 0);
    let g0_b = context_get_remaining_time_ms(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL context_get_remaining_time_ms");
        process_exit(1);
    }
    println("prod_gr_function_execution_context: PASSED");
}
