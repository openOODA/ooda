// # Int arity-3 add fail
//
// Logline: Return x + y + z + 1 while ensuring the honest sum.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target multi3_bad 0 15.
//   2. Require x, y, z >= 0 and ensure result == x + y + z.
//   3. Return the sum plus one so the rail fails.

// Pure Int arity-3 multi-arg fuzz fail fixture: ensures result == x+y+z but body lies.
// FUZZ_DOMAIN: int
// FUZZ_TARGET: multi3_bad 0 15
// FUZZ_REQUIRES: multi3_bad x >= 0 && y >= 0 && z >= 0
// FUZZ_ENSURES: multi3_bad result == x + y + z
fn multi3_bad(x: Int, y: Int, z: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    requires z >= 0;
    ensures result == x + y + z;
    return x + y + z + 1;
}

