// # Product prove std/astrodynamics/attitude_quaternion.oo
//
// Logline: Fail-closed emit+gcc+run asserts quat_ident_w is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/attitude_quaternion.oo.
//
// Beats:
//   1. Call quat_ident_w twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_quaternion: PASSED only if they match.

import "std/astrodynamics/attitude_quaternion.oo";

pub fn main() {
    let attitude_quaternion_mark: Int = 0;
    if attitude_quaternion_mark != 0 {
        process_exit(1);
    }
    let a: Int = quat_ident_w();
    let b: Int = quat_ident_w();
    if a != b {
        println("FAIL quat_ident_w");
        process_exit(1);
    }
    println("prod_attitude_quaternion: PASSED");
}
