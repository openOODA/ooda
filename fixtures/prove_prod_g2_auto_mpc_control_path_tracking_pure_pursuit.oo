// # Product prove std/auto_mpc_control/path_tracking_pure_pursuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts pure_pursuit_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/path_tracking_pure_pursuit.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pure_pursuit_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_path_tracking_pure_pursuit: PASSED only if they match.

import "std/auto_mpc_control/path_tracking_pure_pursuit.oo";

pub fn main() {
    let g2_oa: PurePursuitConfig = pure_pursuit_config_default();
    let g2_ob: PurePursuitConfig = pure_pursuit_config_default();
    let g2_a = (g2_oa).k_lookahead;
    let g2_b = (g2_ob).k_lookahead;
    if g2_a != g2_b {
        println("FAIL pure_pursuit_config_default.k_lookahead");
        process_exit(1);
    }
    println("prod_g2_path_tracking_pure_pursuit: PASSED");
}
