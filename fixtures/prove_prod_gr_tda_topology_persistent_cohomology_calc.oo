// # Product prove std/tda_topology/persistent_cohomology_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistent_cocycle_add_entry is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistent_cohomology_calc.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call persistent_cocycle_add_entry twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_persistent_cohomology_calc: PASSED only if they match.

import "std/tda_topology/persistent_cohomology_calc.oo";

pub fn main() {
    let mut g0_oa = persistent_cocycle_new(0, 0.0, 0.0);
    let mut g0_ob = persistent_cocycle_new(0, 0.0, 0.0);
    let g0_a = persistent_cocycle_add_entry(&g0_oa, 0, 0);
    let g0_b = persistent_cocycle_add_entry(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL persistent_cocycle_add_entry");
        process_exit(1);
    }
    println("prod_gr_persistent_cohomology_calc: PASSED");
}
