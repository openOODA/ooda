// # Product prove std/ai_ml/opt_sgd.oo
//
// Logline: Fail-closed emit+gcc+run asserts SGD optimizer and cosine learning rate schedule are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/opt_sgd.oo.
//
// Beats:
//   1. Construct SGD optimizer configuration and state.
//   2. Call sgd_learning_rate_schedule_cosine, sgd_step_1d, and opt_sgd_marker.
//   3. Assert deterministic state transitions and outputs.
//   4. Print prod_g4_aiml_opt_sgd: PASSED only if all match.

import "std/ai_ml/opt_sgd.oo";

pub fn main() {
    let m: Int = opt_sgd_marker();
    if m != 1 {
        println("FAIL opt_sgd_marker");
        process_exit(1);
    }

    let cfg: SGDConfig = sgd_config_default(0.01);
    let lr_a: Float = sgd_learning_rate_schedule_cosine(0.01, 10, 100);
    let lr_b: Float = sgd_learning_rate_schedule_cosine(0.01, 10, 100);
    if lr_a != lr_b {
        println("FAIL sgd_learning_rate_schedule_cosine");
        process_exit(1);
    }

    let mut opt: SGDOptimizer = sgd_optimizer_new(cfg, 2);
    let mut p_data: List[Float] = list_new();
    p_data = list_push(p_data, 1.0);
    p_data = list_push(p_data, 2.0);
    let param: Tensor1D = Tensor1D { data: p_data, size: 2 };

    let mut g_data: List[Float] = list_new();
    g_data = list_push(g_data, 0.1);
    g_data = list_push(g_data, 0.2);
    let grad: Tensor1D = Tensor1D { data: g_data, size: 2 };

    let res: Tensor1D = sgd_step_1d(&mut opt, param, grad);
    if (res).size != 2 {
        println("FAIL sgd_step_1d size");
        process_exit(1);
    }
    if (opt).step_count != 1 {
        println("FAIL opt step_count");
        process_exit(1);
    }

    println("prod_g4_aiml_opt_sgd: PASSED");
    process_exit(0);
}
