pub fn pack_ints() -> List[Int] {
    let mut xs = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    return xs;
}
pub fn pack_strs() -> List[String] {
    let mut xs = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    return xs;
}
pub fn main() {
    let a = pack_ints();
    let b = pack_strs();
    println(list_len(a));
    println(list_len(b));
}
