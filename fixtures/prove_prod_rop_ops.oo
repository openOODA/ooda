// # Product prove std/sec/sys/rop_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts rop_gadget_verify is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop_ops.oo.
//
// Beats:
//   1. Call rop_gadget_verify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rop_ops: PASSED only if they match.

import "std/sec/sys/rop_ops.oo";

pub fn main() {
    let obj = rop_gadget_create(0, 0, 0);
    let a = rop_gadget_verify(obj);
    let b = rop_gadget_verify(obj);
    if a != b {
        println("FAIL rop_gadget_verify");
        process_exit(1);
    }
    println("prod_rop_ops: PASSED");
}
