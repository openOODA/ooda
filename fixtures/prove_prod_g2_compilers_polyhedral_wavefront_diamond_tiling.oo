// # Product prove std/compilers_polyhedral/wavefront_diamond_tiling.oo
//
// Logline: Fail-closed emit+gcc+run asserts diamond_compute_tile_wavefront is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/wavefront_diamond_tiling.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call diamond_compute_tile_wavefront twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wavefront_diamond_tiling: PASSED only if they match.

import "std/compilers_polyhedral/wavefront_diamond_tiling.oo";

pub fn main() {
    let g2_a = diamond_compute_tile_wavefront(2, 2);
    let g2_b = diamond_compute_tile_wavefront(2, 2);
    if g2_a != g2_b {
        println("FAIL diamond_compute_tile_wavefront");
        process_exit(1);
    }
    println("prod_g2_wavefront_diamond_tiling: PASSED");
}
