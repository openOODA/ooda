// # Product prove std/sec/sys/pe_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts read_u16_le is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_ops.oo.
//
// Beats:
//   1. Call read_u16_le twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pe_ops: PASSED only if they match.

import "std/sec/sys/pe_ops.oo";

pub fn main() {
    let a = read_u16_le("x", 0);
    let b = read_u16_le("x", 0);
    if a != b {
        println("FAIL read_u16_le");
        process_exit(1);
    }
    println("prod_pe_ops: PASSED");
}
