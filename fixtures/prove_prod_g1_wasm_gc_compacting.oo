// # Product prove std/wasm_gc/wasm_gc_compacting.oo
//
// Logline: Fail-closed emit+gcc+run asserts compact_object_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_compacting.oo.
//
// Beats:
//   1. Call compact_object_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_compacting: PASSED only if they match.

import "std/wasm_gc/wasm_gc_compacting.oo";

pub fn main() {
    let a: CompactObject = compact_object_new(0, 0, 0, 0);
    let b: CompactObject = compact_object_new(0, 0, 0, 0);
    if a.object_id != b.object_id {
        println("FAIL compact_object_new");
        process_exit(1);
    }
    println("prod_wasm_gc_compacting: PASSED");
}
