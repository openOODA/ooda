// # Hostile if true || x fold
//
// Logline: Print fold-me or other from if true || x so emit-wasm must miss a const-or fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be false.
//   2. If true || x print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = false;
    if true || x {
        println("fold-me");
    } else {
        println("other");
    }
}
