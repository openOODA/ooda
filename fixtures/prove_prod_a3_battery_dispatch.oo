// # Product prove std/grid/battery_dispatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts dispatch_schedule_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_dispatch.oo.
//
// Beats:
//   1. Call dispatch_schedule_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_battery_dispatch: PASSED only if they match.

import "std/grid/battery_dispatch.oo";

pub fn main() {
    let battery_dispatch_mark: Int = 0;
    if battery_dispatch_mark != 0 {
        process_exit(1);
    }
    let a: DispatchSchedule = dispatch_schedule_new(0.0, 0.0, 0, 0);
    let b: DispatchSchedule = dispatch_schedule_new(0.0, 0.0, 0, 0);
    if (a).target_power_kw != (b).target_power_kw {
        println("FAIL dispatch_schedule_new");
        process_exit(1);
    }
    println("prod_battery_dispatch: PASSED");
}
