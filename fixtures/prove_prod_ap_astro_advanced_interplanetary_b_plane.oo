// # Product prove std/astro_advanced/interplanetary_b_plane.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/interplanetary_b_plane.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/interplanetary_b_plane.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_interplanetary_b_plane: PASSED only if they match.

import "std/astro_advanced/interplanetary_b_plane.oo";

pub fn main() {
    let interplanetary_b_plane_a = bplane_b_mag();
    let interplanetary_b_plane_b = bplane_b_mag();
    if interplanetary_b_plane_a != interplanetary_b_plane_b {
        println("FAIL interplanetary_b_plane");
        process_exit(1);
    }
    println("prod_ap_interplanetary_b_plane: PASSED");
}
