// # Product prove std/tui/tui_cell.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_cell_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/tui_cell.oo.
//
// Beats:
//   1. Call tui_cell_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tui_cell: PASSED only if they match.

import "std/tui/tui_cell.oo";

pub fn main() {
    let a: TuiCell = tui_cell_new(0, 0, 0);
    let b: TuiCell = tui_cell_new(0, 0, 0);
    if (a).ch != (b).ch {
        println("FAIL tui_cell_new");
        process_exit(1);
    }
    println("prod_g2_tui_cell: PASSED");
}
