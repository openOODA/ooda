// # Product prove std/crypto/zkp.oo
//
// Logline: Fail-closed verification that zero-knowledge proof facade shim operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp.oo.
//
// Beats:
//   1. Call ZKP scheme and modular exponentiation shim markers.
//   2. Create Pedersen commitment and check opening value.
//   3. Compute ZKP work metric across prover and verifier instances.
//   4. Print prod_g4_crypto_zkp: PASSED and exit 0.

import "std/crypto/zkp.oo";

pub fn main() {
    let s1: Int = shim_marker_scheme();
    let s2: Int = shim_marker_scheme();

    if s1 != s2 || s1 != 1 {
        println("FAIL shim_marker_scheme");
        process_exit(1);
    }

    let p1: Int = shim_marker_mod_pow();
    let p2: Int = shim_marker_mod_pow();

    if p1 != p2 || p1 <= 0 {
        println("FAIL shim_marker_mod_pow");
        process_exit(1);
    }

    let comm: PedersenCommitment = shim_marker_pedersen();
    let open_val: Int = pedersen_opening(comm);

    if open_val <= 0 {
        println("FAIL shim_marker_pedersen");
        process_exit(1);
    }

    let prover: ZkpProver = zkp_prover_init("P_main", 1, 128, 1009, 11, 17);
    let verifier: ZkpVerifier = zkp_verifier_init("V_main", 1, 128, 1009, 11, 17);

    let w1: Int = shim_marker_do_work(&prover, &verifier);
    let w2: Int = shim_marker_do_work(&prover, &verifier);

    if w1 != w2 {
        println("FAIL shim_marker_do_work");
        process_exit(1);
    }

    println("prod_g4_crypto_zkp: PASSED");
    process_exit(0);
}
