// # Product prove std/space_propulsion/ion_thruster_gridded_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts gridded_ion_spec_default_xenon value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ion_thruster_gridded_grid.oo.
//
// Beats:
//   1. Call gridded_ion_spec_default_xenon twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ion_thruster_gridded_grid: PASSED only if asserts hold.

import "std/space_propulsion/ion_thruster_gridded_grid.oo";

pub fn main() {
    let ion_thruster_gridded_grid: GriddedIonSpec = gridded_ion_spec_default_xenon();
    let ion_thruster_gridded_grid_b: GriddedIonSpec = gridded_ion_spec_default_xenon();
    if (ion_thruster_gridded_grid).num_apertures != 4200 {
        println("FAIL gridded_ion_spec_default_xenon num_apertures");
        process_exit(1);
    }
    if (ion_thruster_gridded_grid).num_apertures != (ion_thruster_gridded_grid_b).num_apertures {
        println("FAIL gridded_ion_spec_default_xenon det");
        process_exit(1);
    }
    println("prod_ion_thruster_gridded_grid: PASSED");
}
