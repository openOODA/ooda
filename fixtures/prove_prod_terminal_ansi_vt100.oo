// # Product prove std/os/terminal_ansi_vt100.oo
//
// Logline: Fail-closed emit+gcc+run asserts ansi_escape_prefix is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_ansi_vt100.oo.
//
// Beats:
//   1. Call ansi_escape_prefix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_ansi_vt100: PASSED only if they match.

import "std/os/terminal_ansi_vt100.oo";

pub fn main() {
    let a = ansi_escape_prefix();
    let b = ansi_escape_prefix();
    if a != b {
        println("FAIL ansi_escape_prefix");
        process_exit(1);
    }
    println("prod_terminal_ansi_vt100: PASSED");
}
