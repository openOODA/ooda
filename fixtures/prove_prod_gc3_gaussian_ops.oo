// # Product prove std/3d/gaussian_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian_ops_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_ops.oo.
//
// Beats:
//   1. Call gaussian_ops_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gaussian_ops: PASSED only if they match.

import "std/3d/gaussian_ops.oo";

pub fn main() {
    let gaussian_ops_mark: Int = 0;
    if gaussian_ops_mark != 0 {
        process_exit(1);
    }
    let gaussian_ops_a = gaussian_ops_init(1, 1, 1, 1);
    let gaussian_ops_b = gaussian_ops_init(1, 1, 1, 1);
    if (gaussian_ops_a).cx != (gaussian_ops_b).cx {
        println("FAIL gaussian_ops_init");
        process_exit(1);
    }
    println("prod_gaussian_ops: PASSED");
}
