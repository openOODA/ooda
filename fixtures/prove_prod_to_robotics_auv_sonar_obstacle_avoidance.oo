// # Product prove std/robotics_auv/sonar_obstacle_avoidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts fls_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/sonar_obstacle_avoidance.oo.
//
// Beats:
//   1. Call fls_config_default using the sonar_obstacle_avoidance ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_sonar_obstacle_avoidance: PASSED only if asserts hold.

import "std/robotics_auv/sonar_obstacle_avoidance.oo";

pub fn main() {
    let obj = fls_config_default();
    let sonar_obstacle_avoidance_a = obj.max_range_m;
    if sonar_obstacle_avoidance_a != 60.0 {
        println("FAIL fls_config_default");
        process_exit(1);
    }
    println("prod_sonar_obstacle_avoidance: PASSED");
}
