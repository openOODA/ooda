// # Product prove std/quantum_advanced/quantum_annealing_qubo.oo
//
// Logline: Fail-closed emit+gcc+run asserts qubo_matrix_new is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_annealing_qubo.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qubo_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_annealing_qubo: PASSED only if they match.

import "std/quantum_advanced/quantum_annealing_qubo.oo";

pub fn main() {
    let g2_oa: QuboMatrix = qubo_matrix_new(2);
    let g2_ob: QuboMatrix = qubo_matrix_new(2);
    let g2_a = (g2_oa).num_variables;
    let g2_b = (g2_ob).num_variables;
    if g2_a != g2_b {
        println("FAIL qubo_matrix_new.num_variables");
        process_exit(1);
    }
    println("prod_g2_quantum_annealing_qubo: PASSED");
}
