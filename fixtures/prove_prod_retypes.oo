// # Product regex_types prove
//
// Logline: Fail-closed emit+gcc+run of shipped regex_config_default/span_empty/token_new.
//
// Setup: Product std/text/regex_types.oo. Default config and empty span sentinels.
//
// Beats:
//   1. Default case_sensitive is true; empty span start is -1; token value is x.
//   2. Exit 1 before PASSED on a miss.

import "std/text/regex_types.oo";

pub fn main() {
    let c: RegexConfig = regex_config_default();
    let cs: Bool = c.case_sensitive;
    if cs == false {
        println("FAIL retypes case");
        process_exit(1);
    }
    let s: RegexSpan = regex_span_empty();
    let i: Int = s.start_idx;
    if i != 0 - 1 {
        println("FAIL retypes span");
        process_exit(1);
    }
    let t: RegexToken = regex_token_new("LIT", "x", 1, 1);
    let v: String = t.value;
    if v != "x" {
        println("FAIL retypes token");
        process_exit(1);
    }
    println("prod_retypes: PASSED");
}
