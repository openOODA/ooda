// # Product prove std/compilers_polyhedral/polyhedral_hermite_normal_form.oo
//
// Logline: Fail-closed emit+gcc+run asserts hnf_lattice_determinant is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_hermite_normal_form.oo.
//
// Beats:
//   1. Call hnf_lattice_determinant twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_hermite_normal_form: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_hermite_normal_form.oo";

pub fn main() {
    let obj_a: HnfMatrix2x2 = hnf_matrix_2x2_new(0, 0, 0);
    let obj_b: HnfMatrix2x2 = hnf_matrix_2x2_new(0, 0, 0);
    let a: Int = hnf_lattice_determinant(obj_a);
    let b: Int = hnf_lattice_determinant(obj_b);
    if a != b {
        println("FAIL hnf_lattice_determinant");
        process_exit(1);
    }
    println("prod_polyhedral_hermite_normal_form: PASSED");
}
