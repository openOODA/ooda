// # Product prove std/astrodynamics/astro_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts astro_stubs_work is a real value.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/astro_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call astro_stubs_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_astro_stubs: PASSED only if they match.

import "std/astrodynamics/astro_stubs.oo";

pub fn main() {
    let g2_a = astro_stubs_work();
    let g2_b = astro_stubs_work();
    if g2_a != g2_b {
        println("FAIL astro_stubs_work");
        process_exit(1);
    }
    println("prod_g2_astro_stubs: PASSED");
}
