// # Product prove std/tda_topology/boundary_matrix_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts boundary_matrix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/boundary_matrix_reduction.oo.
//
// Beats:
//   1. Call boundary_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_boundary_matrix_reduction: PASSED only if they match.

import "std/tda_topology/boundary_matrix_reduction.oo";

pub fn main() {
    let boundary_matrix_reduction_mark: Int = 0;
    if boundary_matrix_reduction_mark != 0 {
        process_exit(1);
    }
    let boundary_matrix_reduction_a = boundary_matrix_new(1);
    let boundary_matrix_reduction_b = boundary_matrix_new(1);
    if (boundary_matrix_reduction_a).num_columns != (boundary_matrix_reduction_b).num_columns {
        println("FAIL boundary_matrix_new");
        process_exit(1);
    }
    println("prod_boundary_matrix_reduction: PASSED");
}
