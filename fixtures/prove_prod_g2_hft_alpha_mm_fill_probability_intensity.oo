// # Product prove std/hft_alpha/mm_fill_probability_intensity.oo
//
// Logline: Fail-closed emit+gcc+run asserts intensity_params_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_fill_probability_intensity.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call intensity_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_fill_probability_intensity: PASSED only if they match.

import "std/hft_alpha/mm_fill_probability_intensity.oo";

pub fn main() {
    let g2_oa: IntensityParams = intensity_params_new(1.0, 1.0, 1.0);
    let g2_ob: IntensityParams = intensity_params_new(1.0, 1.0, 1.0);
    let g2_a = (g2_oa).scale_a;
    let g2_b = (g2_ob).scale_a;
    if g2_a != g2_b {
        println("FAIL intensity_params_new.scale_a");
        process_exit(1);
    }
    println("prod_g2_mm_fill_probability_intensity: PASSED");
}
