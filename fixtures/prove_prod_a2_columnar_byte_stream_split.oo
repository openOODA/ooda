// # Product prove std/db_columnar/columnar_byte_stream_split.oo
//
// Logline: Fail-closed emit+gcc+run asserts split_stream_4byte_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_byte_stream_split.oo.
//
// Beats:
//   1. Call split_stream_4byte_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_byte_stream_split: PASSED only if they match.

import "std/db_columnar/columnar_byte_stream_split.oo";

pub fn main() {
    let columnar_byte_stream_split_mark: Int = 0;
    if columnar_byte_stream_split_mark != 0 {
        process_exit(1);
    }
    let a: SplitStream4Byte = split_stream_4byte_new();
    let b: SplitStream4Byte = split_stream_4byte_new();
    if (a).num_floats != (b).num_floats {
        println("FAIL split_stream_4byte_new");
        process_exit(1);
    }
    println("prod_columnar_byte_stream_split: PASSED");
}
