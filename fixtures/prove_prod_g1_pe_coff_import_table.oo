// # Product prove std/compilers_vm/pe_coff_import_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts imported_symbol_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/pe_coff_import_table.oo.
//
// Beats:
//   1. Call imported_symbol_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pe_coff_import_table: PASSED only if they match.

import "std/compilers_vm/pe_coff_import_table.oo";

pub fn main() {
    let a: ImportedSymbol = imported_symbol_name("x", 0, 0);
    let b: ImportedSymbol = imported_symbol_name("x", 0, 0);
    if a.hint != b.hint {
        println("FAIL imported_symbol_name");
        process_exit(1);
    }
    println("prod_pe_coff_import_table: PASSED");
}
