// # Product prove std/aero/attitude.oo
//
// Logline: Fail-closed emit+gcc+run asserts attitude_vec3_x is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/attitude.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call attitude_vec3_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_attitude: PASSED only if they match.

import "std/aero/attitude.oo";

pub fn main() {
    let g0_oa = attitude_vec3_new(0, 0, 0);
    let g0_ob = attitude_vec3_new(0, 0, 0);
    let g0_a = attitude_vec3_x(g0_oa);
    let g0_b = attitude_vec3_x(g0_ob);
    if g0_a != g0_b {
        println("FAIL attitude_vec3_x");
        process_exit(1);
    }
    println("prod_gr_attitude: PASSED");
}
