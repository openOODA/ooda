// # Product prove std/digital_twin/hil_fpga_solver_fixed_point.oo
//
// Logline: Fail-closed emit+gcc+run asserts fp_add_sat is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/hil_fpga_solver_fixed_point.oo.
//
// Beats:
//   1. Call fp_add_sat twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hil_fpga_solver_fixed_point: PASSED only if they match.

import "std/digital_twin/hil_fpga_solver_fixed_point.oo";

pub fn main() {
    let hil_fpga_solver_fixed_point_mark: Int = 0;
    if hil_fpga_solver_fixed_point_mark != 0 {
        process_exit(1);
    }
    let a: Int = fp_add_sat(0, 0);
    let b: Int = fp_add_sat(0, 0);
    if a != b {
        println("FAIL fp_add_sat");
        process_exit(1);
    }
    println("prod_g2_hil_fpga_solver_fixed_point: PASSED");
}
