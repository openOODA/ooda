// # Product prove std/auto_robot/costmap_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts costmap_compute_inflation_cost is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/costmap_2d.oo.
//
// Beats:
//   1. Call costmap_compute_inflation_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_costmap_2d: PASSED only if they match.

import "std/auto_robot/costmap_2d.oo";

pub fn main() {
    let costmap_2d_mark: Int = 0;
    if costmap_2d_mark != 0 {
        process_exit(1);
    }
    let a: Int = costmap_compute_inflation_cost(0, 0, 0, 0);
    let b: Int = costmap_compute_inflation_cost(0, 0, 0, 0);
    if a != b {
        println("FAIL costmap_compute_inflation_cost");
        process_exit(1);
    }
    println("prod_costmap_2d: PASSED");
}
