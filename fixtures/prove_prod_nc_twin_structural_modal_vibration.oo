// # Product prove std/digital_twin/twin_structural_modal_vibration.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_structural_modal_vibration_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_structural_modal_vibration.oo.
//
// Beats:
//   1. Call twin_structural_modal_vibration_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_twin_structural_modal_vibration: PASSED only if it matches.

import "std/digital_twin/twin_structural_modal_vibration.oo";

pub fn main() {
    let a: Int = twin_structural_modal_vibration_probe();
    if a != 0 {
        println("FAIL twin_structural_modal_vibration_probe");
        process_exit(1);
    }
    println("prod_nc_twin_structural_modal_vibration: PASSED");
}
