// # Product prove std/industrial_predictive/ts_oee_equipment_efficiency.oo
//
// Logline: Fail-closed emit+gcc+run asserts ts_oee_equipment_efficiency_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_oee_equipment_efficiency.oo.
//
// Beats:
//   1. Call ts_oee_equipment_efficiency_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ts_oee_equipment_efficiency: PASSED only if it matches.

import "std/industrial_predictive/ts_oee_equipment_efficiency.oo";

pub fn main() {
    let a: Int = ts_oee_equipment_efficiency_probe();
    if a != 0 {
        println("FAIL ts_oee_equipment_efficiency_probe");
        process_exit(1);
    }
    println("prod_nc_ts_oee_equipment_efficiency: PASSED");
}
