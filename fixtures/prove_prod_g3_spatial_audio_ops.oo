// # Product prove std/3d/spatial_audio_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/spatial_audio_ops.oo.
//
// Beats:
//   1. Call audio_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_audio_ops: PASSED only if they match.

import "std/3d/spatial_audio_ops.oo";

pub fn main() {
    let spatial_audio_ops_mark: Int = 0;
    if spatial_audio_ops_mark != 0 {
        process_exit(1);
    }
    let a: AudioOp = audio_op_new(0, 0);
    let b: AudioOp = audio_op_new(0, 0);
    if (a).gain != (b).gain {
        println("FAIL audio_op_new");
        process_exit(1);
    }
    println("prod_spatial_audio_ops: PASSED");
}
