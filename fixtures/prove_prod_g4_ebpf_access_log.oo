// # Product prove std/mesh_ebpf/mesh_access_log_formatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh access log formatting operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_access_log_formatter.oo.
//
// Beats:
//   1. Initialize access logger state.
//   2. Format access log records into JSON.
//   3. Assert deterministic log formatting and state tracking.
//   4. Print prod_g4_ebpf_access_log: PASSED and exit 0.

import "std/mesh_ebpf/mesh_access_log_formatter.oo";

pub fn main() {
    let mut state1: AccessLoggerState = access_logger_new();
    let mut state2: AccessLoggerState = access_logger_new();

    if (state1).logs_emitted != 0 || (state1).error_logs_emitted != 0 || (state1).total_bytes_logged != 0 {
        println("FAIL access_logger_new initial state");
        process_exit(1);
    }

    let rec1: AccessLogRecord = AccessLogRecord {
        method: "GET",
        path: "/api/v1/health",
        response_code: 200,
        duration_ms: 12,
        bytes_sent: 1024,
        bytes_received: 256,
        upstream_cluster: "cluster_health",
        trace_id: "trace-abc-123",
    };

    let s1: String = access_log_format_json(&mut state1, &rec1);
    let s2: String = access_log_format_json(&mut state2, &rec1);

    if s1 != s2 {
        println("FAIL access_log_format_json mismatch");
        process_exit(1);
    }

    if (state1).logs_emitted != 1 || (state1).error_logs_emitted != 0 || (state1).total_bytes_logged != 1280 {
        println("FAIL access_log_format_json state update 200");
        process_exit(1);
    }

    let rec_err: AccessLogRecord = AccessLogRecord {
        method: "POST",
        path: "/api/v1/pay",
        response_code: 503,
        duration_ms: 45,
        bytes_sent: 128,
        bytes_received: 512,
        upstream_cluster: "cluster_pay",
        trace_id: "trace-xyz-789",
    };

    let s3: String = access_log_format_json(&mut state1, &rec_err);
    if chars_len(s3) == 0 {
        println("FAIL access_log_format_json empty output");
        process_exit(1);
    }

    if (state1).logs_emitted != 2 || (state1).error_logs_emitted != 1 || (state1).total_bytes_logged != 1920 {
        println("FAIL access_log_format_json state update 503");
        process_exit(1);
    }

    println("prod_g4_ebpf_access_log: PASSED");
    process_exit(0);
}
