// # Product prove std/synthetic_biology/yield_stoichiometry_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts yield_calc_degree_of_reduction real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/yield_stoichiometry_calculator.oo.
//
// Beats:
//   1. Call yield_calc_degree_of_reduction with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_yield_stoichiometry_calculator: PASSED only if the assert holds.

import "std/synthetic_biology/yield_stoichiometry_calculator.oo";

pub fn main() {
    let yield_stoichiometry_calculator_f: ChemicalFormula = ChemicalFormula { name: "x", carbon_atoms: 0, hydrogen_atoms: 0, oxygen_atoms: 0, nitrogen_atoms: 0, molecular_weight_g_mol: 0.0 };
    let yield_stoichiometry_calculator_n: Float = yield_calc_degree_of_reduction(&yield_stoichiometry_calculator_f);
    if !(yield_stoichiometry_calculator_n == 0.0) {
        println("FAIL yield_calc_degree_of_reduction");
        process_exit(1);
    }
    println("prod_yield_stoichiometry_calculator: PASSED");
}
