// # Product prove std/telecom/beamforming_weights.oo
//
// Logline: Fail-closed emit+gcc+run asserts beamforming_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/beamforming_weights.oo.
//
// Beats:
//   1. Call beamforming_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_beamforming_weights: PASSED only if they match.

import "std/telecom/beamforming_weights.oo";

pub fn main() {
    let beamforming_weights_mark: Int = 0;
    if beamforming_weights_mark != 0 {
        process_exit(1);
    }
    let beamforming_weights_a: Float = beamforming_pi();
    let beamforming_weights_b: Float = beamforming_pi();
    if beamforming_weights_a != beamforming_weights_b {
        println("FAIL beamforming_pi");
        process_exit(1);
    }
    println("prod_beamforming_weights: PASSED");
}
