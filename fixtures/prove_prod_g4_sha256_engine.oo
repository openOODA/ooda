// # Product prove std/crypto/sha256_engine.oo
//
// Logline: Fail-closed verification that SHA-256 block processing is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/sha256_engine.oo.
//
// Beats:
//   1. Construct initial SHA-256 state and a 64-byte message block.
//   2. Execute process_block twice on the block.
//   3. Assert returned hash states match deterministically.
//   4. Print prod_g4_sha256_engine: PASSED and exit 0.

import "std/crypto/sha256_engine.oo";

pub fn main() {
    let init_st: Sha256State = sha256_state_new(
        1779033703,
        3144134277,
        1013904242,
        2773480762,
        1359893119,
        2600822924,
        528734635,
        1541459225
    );

    let block: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@";

    let st1: Sha256State = process_block(init_st, block, 0);
    let st2: Sha256State = process_block(init_st, block, 0);

    let h0_1: Int = sha256_state_h0(st1);
    let h0_2: Int = sha256_state_h0(st2);

    if h0_1 != h0_2 {
        println("FAIL process_block h0 mismatch");
        process_exit(1);
    }

    if h0_1 == 0 {
        println("FAIL process_block h0 was zero");
        process_exit(1);
    }

    println("prod_g4_sha256_engine: PASSED");
    process_exit(0);
}
