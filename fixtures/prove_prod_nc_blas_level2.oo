// # Product prove std/math/blas_level2.oo
//
// Logline: Fail-closed emit+gcc+run asserts blas_level2_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/math/blas_level2.oo.
//
// Beats:
//   1. Call blas_level2_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_blas_level2: PASSED only if it matches.

import "std/math/blas_level2.oo";

pub fn main() {
    let a: Int = blas_level2_probe();
    if a != 0 {
        println("FAIL blas_level2_probe");
        process_exit(1);
    }
    println("prod_nc_blas_level2: PASSED");
}
