// # Product prove std/db_graph/opencypher_expression_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_val_null is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_expression_evaluator.oo.
//
// Beats:
//   1. Call cypher_val_null twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opencypher_expression_evaluator: PASSED only if they match.

import "std/db_graph/opencypher_expression_evaluator.oo";

pub fn main() {
    let opencypher_expression_evaluator_mark: Int = 0;
    if opencypher_expression_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: CypherValue = cypher_val_null();
    let b: CypherValue = cypher_val_null();
    if (a).val_type != (b).val_type {
        println("FAIL cypher_val_null");
        process_exit(1);
    }
    println("prod_g2_opencypher_expression_evaluator: PASSED");
}
