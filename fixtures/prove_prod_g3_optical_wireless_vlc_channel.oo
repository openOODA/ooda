// # Product prove std/telecom_6g/optical_wireless_vlc_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts vlc_config_indoor_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/optical_wireless_vlc_channel.oo.
//
// Beats:
//   1. Call vlc_config_indoor_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_optical_wireless_vlc_channel: PASSED only if they match.

import "std/telecom_6g/optical_wireless_vlc_channel.oo";

pub fn main() {
    let optical_wireless_vlc_channel_mark: Int = 0;
    if optical_wireless_vlc_channel_mark != 0 {
        process_exit(1);
    }
    let a: VlcTransceiverConfig = vlc_config_indoor_default();
    let b: VlcTransceiverConfig = vlc_config_indoor_default();
    if (a).led_semi_angle_deg != (b).led_semi_angle_deg {
        println("FAIL vlc_config_indoor_default");
        process_exit(1);
    }
    println("prod_optical_wireless_vlc_channel: PASSED");
}
