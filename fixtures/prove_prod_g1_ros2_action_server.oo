// # Product prove std/robotics_ros2/ros2_action_server.oo
//
// Logline: Fail-closed emit+gcc+run asserts action_server_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_action_server.oo.
//
// Beats:
//   1. Call action_server_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros2_action_server: PASSED only if they match.

import "std/robotics_ros2/ros2_action_server.oo";

pub fn main() {
    let a: ActionServer = action_server_new(0);
    let b: ActionServer = action_server_new(0);
    if a.action_id != b.action_id {
        println("FAIL action_server_new");
        process_exit(1);
    }
    println("prod_ros2_action_server: PASSED");
}
