// # Product prove std/graph_gnn/kg_link_prediction_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts link_pred_metrics_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_link_prediction_eval.oo.
//
// Beats:
//   1. Call link_pred_metrics_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_link_pred_metrics_new: PASSED only if they match.

import "std/graph_gnn/kg_link_prediction_eval.oo";

pub fn main() {
    let kg_link_prediction_eval_mark: Int = 0;
    if kg_link_prediction_eval_mark != 0 { process_exit(1); }
    let a: LinkPredMetrics = link_pred_metrics_new();
    let b: LinkPredMetrics = link_pred_metrics_new();
    if (a).num_queries != (b).num_queries {
        println("FAIL link_pred_metrics_new");
        process_exit(1);
    }
    println("prod_link_pred_metrics_new: PASSED");
}
