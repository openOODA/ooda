// # Product prove std/ai_ml/onnx_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/onnx_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/onnx_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_onnx_parser: PASSED only if they match.

import "std/ai_ml/onnx_parser.oo";

pub fn main() {
    let onnx_parser_a = onnx_magic();
    let onnx_parser_b = onnx_magic();
    if onnx_parser_a != onnx_parser_b {
        println("FAIL onnx_parser");
        process_exit(1);
    }
    println("prod_ap_onnx_parser: PASSED");
}
