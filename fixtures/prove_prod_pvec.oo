// # Product persistent_vector prove
//
// Logline: Fail-closed emit+gcc+run of shipped pvec_push/len/pop.
//
// Setup: Product std/collections/persistent_vector.oo. Push 7 then pop.
//
// Beats:
//   1. After push 7, len 1; after pop, len 0.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/persistent_vector.oo";

pub fn main() {
    let mut v: PVector = pvec_new();
    v = pvec_push(v, 7);
    let n: Int = pvec_len(v);
    if n != 1 {
        println("FAIL pvec push");
        process_exit(1);
    }
    v = pvec_pop(v);
    let z: Int = pvec_len(v);
    if z != 0 {
        println("FAIL pvec pop");
        process_exit(1);
    }
    println("prod_pvec: PASSED");
}
