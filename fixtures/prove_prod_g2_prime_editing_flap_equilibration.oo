// # Product prove std/crispr_cas/prime_editing_flap_equilibration.oo
//
// Logline: Fail-closed emit+gcc+run asserts flap_calc_equilibrium is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_flap_equilibration.oo.
//
// Beats:
//   1. Call flap_calc_equilibrium twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_prime_editing_flap_equilibration: PASSED only if they match.

import "std/crispr_cas/prime_editing_flap_equilibration.oo";

pub fn main() {
    let prime_editing_flap_equilibration_mark: Int = 0;
    if prime_editing_flap_equilibration_mark != 0 {
        process_exit(1);
    }
    let a: FlapEquilibriumState = flap_calc_equilibrium(0.0, 0.0, 0);
    let b: FlapEquilibriumState = flap_calc_equilibrium(0.0, 0.0, 0);
    if (a).flap_length != (b).flap_length {
        println("FAIL flap_calc_equilibrium");
        process_exit(1);
    }
    println("prod_g2_prime_editing_flap_equilibration: PASSED");
}
