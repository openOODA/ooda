// # Product prove std/quantum_tensor_nets/su2_symmetric_wigner_tensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts su2_check_triangle_rule is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/su2_symmetric_wigner_tensor.oo.
//
// Beats:
//   1. Call su2_check_triangle_rule twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_su2_symmetric_wigner_tensor: PASSED only if they match.

import "std/quantum_tensor_nets/su2_symmetric_wigner_tensor.oo";

pub fn main() {
    let su2_symmetric_wigner_tensor_mark: Int = 0;
    if su2_symmetric_wigner_tensor_mark != 0 {
        process_exit(1);
    }
    let su2_symmetric_wigner_tensor_a = su2_check_triangle_rule(1, 1, 1);
    let su2_symmetric_wigner_tensor_b = su2_check_triangle_rule(1, 1, 1);
    if (su2_symmetric_wigner_tensor_a).two_j1 != (su2_symmetric_wigner_tensor_b).two_j1 {
        println("FAIL su2_check_triangle_rule");
        process_exit(1);
    }
    println("prod_su2_symmetric_wigner_tensor: PASSED");
}
