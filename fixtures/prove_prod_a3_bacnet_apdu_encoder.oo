// # Product prove std/iot_scada/bacnet_apdu_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts bacnet_service_read_property is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_apdu_encoder.oo.
//
// Beats:
//   1. Call bacnet_service_read_property twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bacnet_apdu_encoder: PASSED only if they match.

import "std/iot_scada/bacnet_apdu_encoder.oo";

pub fn main() {
    let bacnet_apdu_encoder_mark: Int = 0;
    if bacnet_apdu_encoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = bacnet_service_read_property();
    let b: Int = bacnet_service_read_property();
    if a != b {
        println("FAIL bacnet_service_read_property");
        process_exit(1);
    }
    println("prod_bacnet_apdu_encoder: PASSED");
}
