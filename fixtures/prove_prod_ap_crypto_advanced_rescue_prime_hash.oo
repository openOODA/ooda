// # Product prove std/crypto_advanced/rescue_prime_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/rescue_prime_hash.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/rescue_prime_hash.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rescue_prime_hash: PASSED only if they match.

import "std/crypto_advanced/rescue_prime_hash.oo";

pub fn main() {
    let rescue_prime_hash_a = rescue_prime_sbox_fwd(0, 0, 0);
    let rescue_prime_hash_b = rescue_prime_sbox_fwd(0, 0, 0);
    if rescue_prime_hash_a != rescue_prime_hash_b {
        println("FAIL rescue_prime_hash");
        process_exit(1);
    }
    println("prod_ap_rescue_prime_hash: PASSED");
}
