// # Product prove std/quantum_tensor_nets/mpo_matrix_product_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpo_identity_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/mpo_matrix_product_operator.oo.
//
// Beats:
//   1. Call mpo_identity_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpo_matrix_product_operator: PASSED only if they match.

import "std/quantum_tensor_nets/mpo_matrix_product_operator.oo";

pub fn main() {
    let mpo_matrix_product_operator_mark: Int = 0;
    if mpo_matrix_product_operator_mark != 0 {
        process_exit(1);
    }
    let mpo_matrix_product_operator_a = mpo_identity_new(1, 1);
    let mpo_matrix_product_operator_b = mpo_identity_new(1, 1);
    if (mpo_matrix_product_operator_a).num_sites != (mpo_matrix_product_operator_b).num_sites {
        println("FAIL mpo_identity_new");
        process_exit(1);
    }
    println("prod_mpo_matrix_product_operator: PASSED");
}
