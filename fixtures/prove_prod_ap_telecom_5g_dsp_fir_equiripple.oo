// # Product prove std/telecom_5g/dsp_fir_equiripple.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/dsp_fir_equiripple.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_fir_equiripple.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dsp_fir_equiripple: PASSED only if they match.

import "std/telecom_5g/dsp_fir_equiripple.oo";

pub fn main() {
    let dsp_fir_equiripple_a = dsp_sinc_windowed_tap(0, 0, 0.0);
    let dsp_fir_equiripple_b = dsp_sinc_windowed_tap(0, 0, 0.0);
    if dsp_fir_equiripple_a != dsp_fir_equiripple_b {
        println("FAIL dsp_fir_equiripple");
        process_exit(1);
    }
    println("prod_ap_dsp_fir_equiripple: PASSED");
}
