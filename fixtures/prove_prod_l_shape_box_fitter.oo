// # Product prove std/lidar_perception/l_shape_box_fitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts l_shape_criterion_init real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/l_shape_box_fitter.oo.
//
// Beats:
//   1. Call l_shape_criterion_init with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_l_shape_box_fitter: PASSED only if the assert holds.

import "std/lidar_perception/l_shape_box_fitter.oo";

pub fn main() {
    let l_shape_box_fitter_mark: Int = 0;
    if l_shape_box_fitter_mark != 0 {
        process_exit(1);
    }
    let l_shape_box_fitter_a = l_shape_criterion_init();
    let l_shape_box_fitter_best_theta_rad: Float = (l_shape_box_fitter_a).best_theta_rad;
    if !(l_shape_box_fitter_best_theta_rad == 0.0) {
        println("FAIL l_shape_criterion_init");
        process_exit(1);
    }
    println("prod_l_shape_box_fitter: PASSED");
}
