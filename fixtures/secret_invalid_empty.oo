// # Fail closed on an empty secret tag
//
// Logline: A line-start secret directive with an empty name is fail-closed.
//
// Beats:
//   1. Keep the empty tag line exactly.
//   2. Publish a main that only prints 1.
//   3. Expect parse of the empty name to refuse.

// M65 empty SECRET name fail-closed
// SECRET:
pub fn main() {
    println(1);
}
