// # Product prove std/sec/crypto/zksnark_validate.oo
//
// Logline: Fail-closed emit+gcc+run asserts zksnark_validate_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_validate.oo.
//
// Beats:
//   1. Call zksnark_validate_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zksnark_validate: PASSED only if they match.

import "std/sec/crypto/zksnark_validate.oo";

pub fn main() {
    let a = zksnark_validate_probe();
    let b = zksnark_validate_probe();
    if a != b {
        println("FAIL zksnark_validate_probe");
        process_exit(1);
    }
    println("prod_zksnark_validate: PASSED");
}
