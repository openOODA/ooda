// # Product prove std/tda_topology/persistence_silhouette_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts silhouette_tent_eval is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_silhouette_calc.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call silhouette_tent_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_persistence_silhouette_calc: PASSED only if they match.

import "std/tda_topology/persistence_silhouette_calc.oo";

pub fn main() {
    let g0_a = silhouette_tent_eval(0.0, 0.0, 0.0);
    let g0_b = silhouette_tent_eval(0.0, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL silhouette_tent_eval");
        process_exit(1);
    }
    println("prod_gr_persistence_silhouette_calc: PASSED");
}
