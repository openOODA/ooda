// # Product prove std/astro_advanced/payload_fairing_aerodynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/payload_fairing_aerodynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/payload_fairing_aerodynamics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_payload_fairing_aerodynamics: PASSED only if they match.

import "std/astro_advanced/payload_fairing_aerodynamics.oo";

pub fn main() {
    let payload_fairing_aerodynamics_a = fairing_cd();
    let payload_fairing_aerodynamics_b = fairing_cd();
    if payload_fairing_aerodynamics_a != payload_fairing_aerodynamics_b {
        println("FAIL payload_fairing_aerodynamics");
        process_exit(1);
    }
    println("prod_ap_payload_fairing_aerodynamics: PASSED");
}
