// # Product prove std/iot_scada/coap_message_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/coap_message_builder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/coap_message_builder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_coap_message_builder: PASSED only if they match.

import "std/iot_scada/coap_message_builder.oo";

pub fn main() {
    let coap_message_builder_a = coap_code_get();
    let coap_message_builder_b = coap_code_get();
    if coap_message_builder_a != coap_message_builder_b {
        println("FAIL coap_message_builder");
        process_exit(1);
    }
    println("prod_ap_coap_message_builder: PASSED");
}
