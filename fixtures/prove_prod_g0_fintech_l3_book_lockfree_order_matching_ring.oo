// # Product prove std/fintech_l3_book/lockfree_order_matching_ring.oo
//
// Logline: Fail-closed emit+gcc+run asserts ring_dequeue_complete is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/lockfree_order_matching_ring.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ring_dequeue_complete twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_lockfree_order_matching_ring: PASSED only if they match.

import "std/fintech_l3_book/lockfree_order_matching_ring.oo";

pub fn main() {
    let mut g0_oa: RingBufferMetrics = RingBufferMetrics { capacity: 8, head_sequence: 2, tail_sequence: 2, total_enqueued: 2, total_dequeued: 2, overflow_count: 8 };
    let mut g0_ob: RingBufferMetrics = RingBufferMetrics { capacity: 8, head_sequence: 2, tail_sequence: 2, total_enqueued: 2, total_dequeued: 2, overflow_count: 8 };
    let g0_a = ring_dequeue_complete(&g0_oa);
    let g0_b = ring_dequeue_complete(&g0_ob);
    if g0_a != g0_b {
        println("FAIL ring_dequeue_complete");
        process_exit(1);
    }
    println("prod_g0_lockfree_order_matching_ring: PASSED");
}
