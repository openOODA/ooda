// # Product prove std/compilers/macho_linker.oo
//
// Logline: Fail-closed verification that Mach-O static linker configuration, segment layout, and binary builds are deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/macho_linker.oo.
//
// Beats:
//   1. Configure Mach-O linker for ARM64 target presets.
//   2. Register text and data segments and compute file size progression.
//   3. Perform layout and build, and assert deterministic total file size.
//   4. Print prod_g4_compilers_macho_linker: PASSED and exit 0.

import "std/compilers/macho_linker.oo";

pub fn main() {
    let cfg1: MachOLinkerConfig = macho_linker_config_default_arm64();
    let cfg2: MachOLinkerConfig = macho_linker_config_default_arm64();
    if (cfg1).cputype != (cfg2).cputype || (cfg1).page_size != 16384 {
        println("FAIL macho_linker_config_default_arm64");
        process_exit(1);
    }

    let mut state1: MachOLinkerState = macho_linker_init(cfg1);
    let mut state2: MachOLinkerState = macho_linker_init(cfg2);
    if (state1).total_file_size != (state2).total_file_size || (state1).total_file_size != 32 {
        println("FAIL macho_linker_init");
        process_exit(1);
    }

    let seg_text: MachOSegment64 = macho_segment64_text(4294967296, 4096, 0);
    let seg_data: MachOSegment64 = macho_segment64_data(4294971392, 4096, 4096);

    state1 = macho_linker_add_segment(state1, seg_text);
    state1 = macho_linker_add_segment(state1, seg_data);
    state2 = macho_linker_add_segment(state2, seg_text);
    state2 = macho_linker_add_segment(state2, seg_data);

    if (state1).segment_count != (state2).segment_count || (state1).segment_count != 2 {
        println("FAIL macho_linker_add_segment count");
        process_exit(1);
    }

    if (state1).total_file_size != (state2).total_file_size || (state1).total_file_size != 8224 {
        println("FAIL macho_linker_add_segment size");
        process_exit(1);
    }

    let sz1: Int = macho_linker_layout_and_build(&mut state1);
    let sz2: Int = macho_linker_layout_and_build(&mut state2);
    if sz1 != sz2 || sz1 != 8224 || !(state1).is_linked || !(state2).is_linked {
        println("FAIL macho_linker_layout_and_build");
        process_exit(1);
    }

    println("prod_g4_compilers_macho_linker: PASSED");
    process_exit(0);
}
