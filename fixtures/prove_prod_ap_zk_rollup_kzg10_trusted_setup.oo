// # Product prove std/zk_rollup/kzg10_trusted_setup.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/kzg10_trusted_setup.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/kzg10_trusted_setup.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_kzg10_trusted_setup: PASSED only if they match.

import "std/zk_rollup/kzg10_trusted_setup.oo";

pub fn main() {
    let kzg10_trusted_setup_a = srs_g1_point_new(0, 0, 0);
    let kzg10_trusted_setup_b = srs_g1_point_new(0, 0, 0);
    if kzg10_trusted_setup_a.x_val != kzg10_trusted_setup_b.x_val {
        println("FAIL kzg10_trusted_setup");
        process_exit(1);
    }
    println("prod_ap_kzg10_trusted_setup: PASSED");
}
