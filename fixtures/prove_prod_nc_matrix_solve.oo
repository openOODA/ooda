// # Product prove std/math/matrix_solve.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix_solve_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/math/matrix_solve.oo.
//
// Beats:
//   1. Call matrix_solve_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_matrix_solve: PASSED only if it matches.

import "std/math/matrix_solve.oo";

pub fn main() {
    let a: Int = matrix_solve_probe();
    if a != 0 {
        println("FAIL matrix_solve_probe");
        process_exit(1);
    }
    println("prod_nc_matrix_solve: PASSED");
}
