// # Product prove std/multimedia/audio_gain.oo
//
// Logline: Fail-closed emit+gcc+run asserts gain_abs_f is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/audio_gain.oo.
//
// Beats:
//   1. Call gain_abs_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audio_gain: PASSED only if they match.

import "std/multimedia/audio_gain.oo";

pub fn main() {
    let audio_gain_mark: Int = 0;
    if audio_gain_mark != 0 {
        process_exit(1);
    }
    let a: Float = gain_abs_f(0.0);
    let b: Float = gain_abs_f(0.0);
    if a != b {
        println("FAIL gain_abs_f");
        process_exit(1);
    }
    println("prod_audio_gain: PASSED");
}
