// # Product prove std/genomics_advanced/read_backed_phasing_whatshap.oo
//
// Logline: Fail-closed emit+gcc+run asserts read_backed_phasing_whatshap_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/read_backed_phasing_whatshap.oo.
//
// Beats:
//   1. Call read_backed_phasing_whatshap_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_read_backed_phasing_whatshap: PASSED only if they match.

import "std/genomics_advanced/read_backed_phasing_whatshap.oo";

pub fn main() {
    let a = read_backed_phasing_whatshap_probe();
    let b = read_backed_phasing_whatshap_probe();
    if a != b {
        println("FAIL read_backed_phasing_whatshap_probe");
        process_exit(1);
    }
    println("prod_read_backed_phasing_whatshap: PASSED");
}
