// # Product prove std/astro_advanced/lunar_landing_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/lunar_landing_guidance.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/lunar_landing_guidance.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lunar_landing_guidance: PASSED only if they match.

import "std/astro_advanced/lunar_landing_guidance.oo";

pub fn main() {
    let lunar_landing_guidance_a = lunar_land_dv();
    let lunar_landing_guidance_b = lunar_land_dv();
    if lunar_landing_guidance_a != lunar_landing_guidance_b {
        println("FAIL lunar_landing_guidance");
        process_exit(1);
    }
    println("prod_ap_lunar_landing_guidance: PASSED");
}
