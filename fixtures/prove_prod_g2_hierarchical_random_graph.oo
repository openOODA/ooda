// # Product prove std/graph_networks/hierarchical_random_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts hrg_create_balanced is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/hierarchical_random_graph.oo.
//
// Beats:
//   1. Call hrg_create_balanced twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hierarchical_random_graph: PASSED only if they match.

import "std/graph_networks/hierarchical_random_graph.oo";

pub fn main() {
    let hierarchical_random_graph_mark: Int = 0;
    if hierarchical_random_graph_mark != 0 {
        process_exit(1);
    }
    let a: HrgDendrogram = hrg_create_balanced(0);
    let b: HrgDendrogram = hrg_create_balanced(0);
    if (a).num_leaves != (b).num_leaves {
        println("FAIL hrg_create_balanced");
        process_exit(1);
    }
    println("prod_g2_hierarchical_random_graph: PASSED");
}
