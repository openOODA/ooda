// # Control-flow #line probe
//
// Logline: Holds if, while, for, match, and assignment so emit-c can stamp each form.
//
// Setup: Single file. Backend-C. Result match uses Ok and Err.
//
// Beats:
//   1. Assign a mut Int.
//   2. Run if, while, for, and match once each.
//   3. Print the Int.

pub fn main() {
    let mut x: Int = 0;
    x = 1;
    if x == 1 {
        x = 2;
    }
    let mut i: Int = 0;
    while i < 1 {
        i = 1;
    }
    for j in 0..1 {
        x = x + j;
    }
    let r: Result[Int, String] = Ok(3);
    match r {
        Ok(v) => {
            x = v;
        },
        Err(e) => {
            x = 0;
        },
    }
    println(x);
}
