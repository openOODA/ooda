// # Product prove std/graph_networks/quotient_filter_compact.oo
//
// Logline: Fail-closed emit+gcc+run asserts qf_power_of_two is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/quotient_filter_compact.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qf_power_of_two twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quotient_filter_compact: PASSED only if they match.

import "std/graph_networks/quotient_filter_compact.oo";

pub fn main() {
    let g2_a = qf_power_of_two(2);
    let g2_b = qf_power_of_two(2);
    if g2_a != g2_b {
        println("FAIL qf_power_of_two");
        process_exit(1);
    }
    println("prod_g2_quotient_filter_compact: PASSED");
}
