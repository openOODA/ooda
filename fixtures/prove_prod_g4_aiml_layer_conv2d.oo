// # Product prove std/ai_ml/layer_conv2d.oo
//
// Logline: Fail-closed verification that 2D convolution layer construction, dimension calculation, and forward propagation are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_conv2d.oo.
//
// Beats:
//   1. Calculate output dimensions for 2D convolutions under standard stride and padding.
//   2. Instantiate Conv2DLayer and execute forward spatial convolution pass.
//   3. Compute backward bias gradients and assert deterministic shape and values.
//   4. Print prod_g4_aiml_layer_conv2d: PASSED only if all match.

import "std/ai_ml/layer_conv2d.oo";

pub fn main() {
    let out_dim_a: Int = conv2d_calc_out_dim(28, 3, 1, 1);
    let out_dim_b: Int = conv2d_calc_out_dim(28, 3, 1, 1);
    if out_dim_a != out_dim_b || out_dim_a != 28 {
        println("FAIL conv2d_calc_out_dim");
        process_exit(1);
    }

    let out_dim_valid: Int = conv2d_calc_out_dim(10, 3, 2, 0);
    if out_dim_valid != 4 {
        println("FAIL conv2d_calc_out_dim strided");
        process_exit(1);
    }

    let layer: Conv2DLayer = conv2d_layer_new(1, 1, 2, 1, 0);
    if ((layer).config).kernel_size != 2 || ((layer).config).out_channels != 1 {
        println("FAIL conv2d_layer_new config");
        process_exit(1);
    }

    let mut in_data: List[Float] = list_new();
    in_data = list_push(in_data, 1.0);
    in_data = list_push(in_data, 2.0);
    in_data = list_push(in_data, 3.0);
    in_data = list_push(in_data, 4.0);
    let in_tensor: Tensor4D = Tensor4D { data: in_data, b: 1, c: 1, h: 2, w: 2 };

    let out_tensor_a: Tensor4D = conv2d_forward(&layer, in_tensor);
    let out_tensor_b: Tensor4D = conv2d_forward(&layer, in_tensor);
    if (out_tensor_a).b != (out_tensor_b).b || (out_tensor_a).h != 1 || (out_tensor_a).w != 1 {
        println("FAIL conv2d_forward");
        process_exit(1);
    }

    let bias_grad: Tensor1D = conv2d_backward_bias(out_tensor_a);
    if (bias_grad).size != 1 {
        println("FAIL conv2d_backward_bias");
        process_exit(1);
    }

    println("prod_g4_aiml_layer_conv2d: PASSED");
    process_exit(0);
}
