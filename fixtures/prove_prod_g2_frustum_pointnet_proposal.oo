// # Product prove std/lidar_perception/frustum_pointnet_proposal.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_intrinsics_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/frustum_pointnet_proposal.oo.
//
// Beats:
//   1. Call camera_intrinsics_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_frustum_pointnet_proposal: PASSED only if they match.

import "std/lidar_perception/frustum_pointnet_proposal.oo";

pub fn main() {
    let frustum_pointnet_proposal_mark: Int = 0;
    if frustum_pointnet_proposal_mark != 0 {
        process_exit(1);
    }
    let a: CameraIntrinsics = camera_intrinsics_default();
    let b: CameraIntrinsics = camera_intrinsics_default();
    if (a).fx != (b).fx {
        println("FAIL camera_intrinsics_default");
        process_exit(1);
    }
    println("prod_g2_frustum_pointnet_proposal: PASSED");
}
