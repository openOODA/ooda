// # Product prove std/bioinformatics/needleman_wunsch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/needleman_wunsch.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/needleman_wunsch.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_needleman_wunsch: PASSED only if they match.

import "std/bioinformatics/needleman_wunsch.oo";

pub fn main() {
    let needleman_wunsch_a = needleman_wunsch_matrix_dim(0, 0);
    let needleman_wunsch_b = needleman_wunsch_matrix_dim(0, 0);
    if needleman_wunsch_a != needleman_wunsch_b {
        println("FAIL needleman_wunsch");
        process_exit(1);
    }
    println("prod_ap_needleman_wunsch: PASSED");
}
