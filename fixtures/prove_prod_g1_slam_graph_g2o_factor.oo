// # Product prove std/robotics_ros2/slam_graph_g2o_factor.oo
//
// Logline: Fail-closed emit+gcc+run asserts pose2d_vertex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_graph_g2o_factor.oo.
//
// Beats:
//   1. Call pose2d_vertex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_graph_g2o_factor: PASSED only if they match.

import "std/robotics_ros2/slam_graph_g2o_factor.oo";

pub fn main() {
    let a: Pose2DVertex = pose2d_vertex_new(0, 0.0, 0.0, 0.0, true);
    let b: Pose2DVertex = pose2d_vertex_new(0, 0.0, 0.0, 0.0, true);
    if a.id != b.id {
        println("FAIL pose2d_vertex_new");
        process_exit(1);
    }
    println("prod_slam_graph_g2o_factor: PASSED");
}
