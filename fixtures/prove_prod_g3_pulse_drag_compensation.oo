// # Product prove std/quantum_advanced/pulse_drag_compensation.oo
//
// Logline: Fail-closed emit+gcc+run asserts drag_pulse_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/pulse_drag_compensation.oo.
//
// Beats:
//   1. Call drag_pulse_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pulse_drag_compensation: PASSED only if they match.

import "std/quantum_advanced/pulse_drag_compensation.oo";

pub fn main() {
    let pulse_drag_compensation_mark: Int = 0;
    if pulse_drag_compensation_mark != 0 {
        process_exit(1);
    }
    let a: DragPulseConfig = drag_pulse_config_default(0.0, 0.0);
    let b: DragPulseConfig = drag_pulse_config_default(0.0, 0.0);
    if (a).num_samples != (b).num_samples {
        println("FAIL drag_pulse_config_default");
        process_exit(1);
    }
    println("prod_pulse_drag_compensation: PASSED");
}
