// # Product prove std/fintech_defi/crypto_address_derivation.oo
//
// Logline: Fail-closed emit+gcc+run asserts secp256k1_pubkey_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/crypto_address_derivation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call secp256k1_pubkey_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crypto_address_derivation: PASSED only if they match.

import "std/fintech_defi/crypto_address_derivation.oo";

pub fn main() {
    let g2_oa: Secp256k1PublicKey = secp256k1_pubkey_new(2, 2, 2, 2);
    let g2_ob: Secp256k1PublicKey = secp256k1_pubkey_new(2, 2, 2, 2);
    let g2_a = (g2_oa).x_coord_hi;
    let g2_b = (g2_ob).x_coord_hi;
    if g2_a != g2_b {
        println("FAIL secp256k1_pubkey_new.x_coord_hi");
        process_exit(1);
    }
    println("prod_g2_crypto_address_derivation: PASSED");
}
