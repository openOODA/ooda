// # Product prove std/db_storage/sql_statistics_histogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/sql_statistics_histogram.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_statistics_histogram.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sql_statistics_histogram: PASSED only if they match.

import "std/db_storage/sql_statistics_histogram.oo";

pub fn main() {
    let sql_statistics_histogram_a = column_statistics_new("x", 0);
    let sql_statistics_histogram_b = column_statistics_new("x", 0);
    let sql_statistics_histogram_va = estimate_range_selectivity(sql_statistics_histogram_a, 0, 0);
    let sql_statistics_histogram_vb = estimate_range_selectivity(sql_statistics_histogram_b, 0, 0);
    if sql_statistics_histogram_va != sql_statistics_histogram_vb {
        println("FAIL sql_statistics_histogram");
        process_exit(1);
    }
    println("prod_ap_sql_statistics_histogram: PASSED");
}
