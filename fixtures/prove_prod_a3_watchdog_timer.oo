// # Product prove std/embedded_hal/watchdog_timer.oo
//
// Logline: Fail-closed emit+gcc+run asserts iwdg_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/watchdog_timer.oo.
//
// Beats:
//   1. Call iwdg_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_watchdog_timer: PASSED only if they match.

import "std/embedded_hal/watchdog_timer.oo";

pub fn main() {
    let watchdog_timer_mark: Int = 0;
    if watchdog_timer_mark != 0 {
        process_exit(1);
    }
    let a: IwdgConfig = iwdg_config_new(0, 0);
    let b: IwdgConfig = iwdg_config_new(0, 0);
    if (a).prescaler_div != (b).prescaler_div {
        println("FAIL iwdg_config_new");
        process_exit(1);
    }
    println("prod_watchdog_timer: PASSED");
}
