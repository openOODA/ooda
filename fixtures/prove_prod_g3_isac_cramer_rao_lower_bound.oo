// # Product prove std/telecom_6g/isac_cramer_rao_lower_bound.oo
//
// Logline: Fail-closed emit+gcc+run asserts crlb_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_cramer_rao_lower_bound.oo.
//
// Beats:
//   1. Call crlb_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isac_cramer_rao_lower_bound: PASSED only if they match.

import "std/telecom_6g/isac_cramer_rao_lower_bound.oo";

pub fn main() {
    let isac_cramer_rao_lower_bound_mark: Int = 0;
    if isac_cramer_rao_lower_bound_mark != 0 {
        process_exit(1);
    }
    let a: Float = crlb_int_to_float(0);
    let b: Float = crlb_int_to_float(0);
    if a != b {
        println("FAIL crlb_int_to_float");
        process_exit(1);
    }
    println("prod_isac_cramer_rao_lower_bound: PASSED");
}
