// # Product prove std/fintech_l3_book/l3_book_snapshot_rebuilder.oo
//
// Logline: Fail-closed emit+gcc+run asserts replay_delta_message is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_book_snapshot_rebuilder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call replay_delta_message twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_l3_book_snapshot_rebuilder: PASSED only if they match.

import "std/fintech_l3_book/l3_book_snapshot_rebuilder.oo";

pub fn main() {
    let mut g0_oa: SnapshotRebuildStatus = SnapshotRebuildStatus { symbol: "x", is_snapshot_applied: true, is_fully_synchronized: true, baseline_sequence: 0, current_sequence: 0, buffered_deltas_count: 0, replayed_deltas_count: 0 };
    let mut g0_ob: SnapshotRebuildStatus = SnapshotRebuildStatus { symbol: "x", is_snapshot_applied: true, is_fully_synchronized: true, baseline_sequence: 0, current_sequence: 0, buffered_deltas_count: 0, replayed_deltas_count: 0 };
    let g0_a = replay_delta_message(&g0_oa, 0);
    let g0_b = replay_delta_message(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL replay_delta_message");
        process_exit(1);
    }
    println("prod_gr_l3_book_snapshot_rebuilder: PASSED");
}
