// # Product prove std/fs/file_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_reader_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/file_reader.oo.
//
// Beats:
//   1. Call file_reader_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_reader: PASSED only if they match.

import "std/fs/file_reader.oo";

pub fn main() {
    let a = file_reader_probe();
    let b = file_reader_probe();
    if a != b {
        println("FAIL file_reader_probe");
        process_exit(1);
    }
    println("prod_file_reader: PASSED");
}
