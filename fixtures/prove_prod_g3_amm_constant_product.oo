// # Product prove std/fintech_defi/amm_constant_product.oo
//
// Logline: Fail-closed emit+gcc+run asserts amm_get_amount_in is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_constant_product.oo.
//
// Beats:
//   1. Call amm_get_amount_in twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_amm_constant_product: PASSED only if they match.

import "std/fintech_defi/amm_constant_product.oo";

pub fn main() {
    let amm_constant_product_mark: Int = 0;
    if amm_constant_product_mark != 0 {
        process_exit(1);
    }
    let a: Int = amm_get_amount_in(0, 0, 0, 0);
    let b: Int = amm_get_amount_in(0, 0, 0, 0);
    if a != b {
        println("FAIL amm_get_amount_in");
        process_exit(1);
    }
    println("prod_amm_constant_product: PASSED");
}
