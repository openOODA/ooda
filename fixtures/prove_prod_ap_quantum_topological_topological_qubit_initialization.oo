// # Product prove std/quantum_topological/topological_qubit_initialization.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_topological/topological_qubit_initialization.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_qubit_initialization.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_topological_qubit_initialization: PASSED only if they match.

import "std/quantum_topological/topological_qubit_initialization.oo";

pub fn main() {
    let topological_qubit_initialization_a = topo_qubit_init_zero(0);
    let topological_qubit_initialization_b = topo_qubit_init_zero(0);
    if topological_qubit_initialization_a.num_anyons != topological_qubit_initialization_b.num_anyons {
        println("FAIL topological_qubit_initialization");
        process_exit(1);
    }
    println("prod_ap_topological_qubit_initialization: PASSED");
}
