// # Product prove std/sync/futex.oo
//
// Logline: Fail-closed emit+gcc+run asserts futex_val is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/futex.oo.
//
// Beats:
//   1. Call futex_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_futex: PASSED only if they match.

import "std/sync/futex.oo";

pub fn main() {
    let obj = futex_new(0, 0);
    let a = futex_val(obj);
    let b = futex_val(obj);
    if a != b {
        println("FAIL futex_val");
        process_exit(1);
    }
    println("prod_futex: PASSED");
}
