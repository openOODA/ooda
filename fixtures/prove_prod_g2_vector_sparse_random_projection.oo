// # Product prove std/db_vector_ann/vector_sparse_random_projection.oo
//
// Logline: Fail-closed emit+gcc+run asserts sparse_projection_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_sparse_random_projection.oo.
//
// Beats:
//   1. Call sparse_projection_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_sparse_random_projection: PASSED only if they match.

import "std/db_vector_ann/vector_sparse_random_projection.oo";

pub fn main() {
    let vector_sparse_random_projection_mark: Int = 0;
    if vector_sparse_random_projection_mark != 0 {
        process_exit(1);
    }
    let a: SparseProjectionConfig = sparse_projection_config_default(0, 0);
    let b: SparseProjectionConfig = sparse_projection_config_default(0, 0);
    if (a).input_dimension != (b).input_dimension {
        println("FAIL sparse_projection_config_default");
        process_exit(1);
    }
    println("prod_g2_vector_sparse_random_projection: PASSED");
}
