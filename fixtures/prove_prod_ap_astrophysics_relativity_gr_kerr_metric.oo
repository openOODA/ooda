// # Product prove std/astrophysics_relativity/gr_kerr_metric.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/gr_kerr_metric.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_kerr_metric.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gr_kerr_metric: PASSED only if they match.

import "std/astrophysics_relativity/gr_kerr_metric.oo";

pub fn main() {
    let gr_kerr_metric_a = kerr_spacetime_evaluate(0, 0, 0, 0);
    let gr_kerr_metric_b = kerr_spacetime_evaluate(0, 0, 0, 0);
    let gr_kerr_metric_va = kerr_r_plus(gr_kerr_metric_a);
    let gr_kerr_metric_vb = kerr_r_plus(gr_kerr_metric_b);
    if gr_kerr_metric_va != gr_kerr_metric_vb {
        println("FAIL gr_kerr_metric");
        process_exit(1);
    }
    println("prod_ap_gr_kerr_metric: PASSED");
}
