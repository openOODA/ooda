// # Product prove std/wasm_gc/wasm_gc_type_hierarchy.oo
//
// Logline: Fail-closed emit+gcc+run asserts gc_comp_struct is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_type_hierarchy.oo.
//
// Beats:
//   1. Call gc_comp_struct twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_type_hierarchy: PASSED only if they match.

import "std/wasm_gc/wasm_gc_type_hierarchy.oo";

pub fn main() {
    let wasm_gc_type_hierarchy_mark: Int = 0;
    if wasm_gc_type_hierarchy_mark != 0 {
        process_exit(1);
    }
    let a: Int = gc_comp_struct();
    let b: Int = gc_comp_struct();
    if a != b {
        println("FAIL gc_comp_struct");
        process_exit(1);
    }
    println("prod_wasm_gc_type_hierarchy: PASSED");
}
