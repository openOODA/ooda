// # Product prove std/cloud/oci_manifest.oo
//
// Logline: Fail-closed verification that OCI manifest schema construction and layer size aggregation are deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/oci_manifest.oo.
//
// Beats:
//   1. Construct OCI config and layer descriptors.
//   2. Initialize OciManifest and append layer descriptors.
//   3. Assert deterministic layer counts and total byte sizes.
//   4. Print prod_g4_cloud_oci_manifest: PASSED only if all match.

import "std/cloud/oci_manifest.oo";

pub fn main() {
    let prb: Int = oci_manifest_probe();
    if prb != 0 {
        println("FAIL oci_manifest_probe");
        process_exit(1);
    }

    let cfg_desc: OciDescriptor = oci_descriptor_config("sha256:abcd1234abcd1234", 1024);
    if (cfg_desc).size != 1024 {
        println("FAIL oci_descriptor_config");
        process_exit(1);
    }

    let mut manifest: OciManifest = oci_manifest_new(cfg_desc);
    if (manifest).schema_version != 2 {
        println("FAIL oci_manifest_new schema_version");
        process_exit(1);
    }
    if (manifest).total_size != 1024 {
        println("FAIL oci_manifest_new total_size");
        process_exit(1);
    }

    let count0: Int = oci_manifest_layer_count(&manifest);
    if count0 != 0 {
        println("FAIL oci_manifest_layer_count initial");
        process_exit(1);
    }

    let layer1: OciDescriptor = oci_descriptor_layer_gzip("sha256:layer1digest", 4096);
    let layer2: OciDescriptor = oci_descriptor_layer_gzip("sha256:layer2digest", 8192);

    let add1: Bool = oci_manifest_add_layer(&mut manifest, layer1);
    let add2: Bool = oci_manifest_add_layer(&mut manifest, layer2);
    if add1 != true || add2 != true {
        println("FAIL oci_manifest_add_layer");
        process_exit(1);
    }

    let count1: Int = oci_manifest_layer_count(&manifest);
    if count1 != 2 {
        println("FAIL oci_manifest_layer_count after add");
        process_exit(1);
    }

    let layer_size: Int = oci_manifest_total_layer_size(&manifest);
    if layer_size != 12288 {
        println("FAIL oci_manifest_total_layer_size");
        process_exit(1);
    }

    if (manifest).total_size != 13312 {
        println("FAIL manifest.total_size");
        process_exit(1);
    }

    println("prod_g4_cloud_oci_manifest: PASSED");
    process_exit(0);
}
