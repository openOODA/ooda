// # Product prove std/quantum_open_systems/kraus_channel_representation.oo
//
// Logline: Fail-closed emit+gcc+run asserts kc_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/kraus_channel_representation.oo.
//
// Beats:
//   1. Call kc_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kraus_channel_representation: PASSED only if they match.

import "std/quantum_open_systems/kraus_channel_representation.oo";

pub fn main() {
    let a: Complex = kc_new(0.0, 0.0);
    let b: Complex = kc_new(0.0, 0.0);
    if a.real != b.real {
        println("FAIL kc_new");
        process_exit(1);
    }
    println("prod_kraus_channel_representation: PASSED");
}
