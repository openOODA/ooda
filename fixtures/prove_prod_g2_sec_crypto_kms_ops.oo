// # Product prove std/sec/crypto/kms_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts kms_key_policy_validate is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kms_key_policy_validate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kms_ops: PASSED only if they match.

import "std/sec/crypto/kms_ops.oo";

pub fn main() {
    let g2_oa = kms_key_policy_create(2, 2, 2);
    let g2_ob = kms_key_policy_create(2, 2, 2);
    let g2_a = kms_key_policy_validate(g2_oa);
    let g2_b = kms_key_policy_validate(g2_ob);
    if g2_a != g2_b {
        println("FAIL kms_key_policy_validate");
        process_exit(1);
    }
    println("prod_g2_kms_ops: PASSED");
}
