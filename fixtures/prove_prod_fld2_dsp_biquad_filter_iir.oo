// # Product prove std/media_dsp/dsp_biquad_filter_iir.oo
//
// Logline: Fail-closed emit+gcc+run asserts biquad_highpass is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_biquad_filter_iir.oo.
//
// Beats:
//   1. Call biquad_highpass twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_biquad_filter_iir: PASSED only if they match.

import "std/media_dsp/dsp_biquad_filter_iir.oo";

pub fn main() {
    let dsp_biquad_filter_iir_mark: Int = 0;
    if dsp_biquad_filter_iir_mark != 0 {
        process_exit(1);
    }
    let dsp_biquad_filter_iir_a = biquad_highpass(1.0, 1.0, 1.0);
    let dsp_biquad_filter_iir_b = biquad_highpass(1.0, 1.0, 1.0);
    if (dsp_biquad_filter_iir_a).b0 != (dsp_biquad_filter_iir_b).b0 {
        println("FAIL biquad_highpass");
        process_exit(1);
    }
    println("prod_dsp_biquad_filter_iir: PASSED");
}
