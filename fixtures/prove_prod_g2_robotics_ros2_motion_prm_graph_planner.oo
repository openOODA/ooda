// # Product prove std/robotics_ros2/motion_prm_graph_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts prm_can_connect is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_prm_graph_planner.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call prm_can_connect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_motion_prm_graph_planner: PASSED only if they match.

import "std/robotics_ros2/motion_prm_graph_planner.oo";

pub fn main() {
    let g2_a = prm_can_connect(1.0, 1.0);
    let g2_b = prm_can_connect(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL prm_can_connect");
        process_exit(1);
    }
    println("prod_g2_motion_prm_graph_planner: PASSED");
}
