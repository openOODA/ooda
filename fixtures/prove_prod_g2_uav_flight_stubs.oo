// # Product prove std/uav_flight/uav_flight_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts uav_hal_pwm_write_stub is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_flight_stubs.oo.
//
// Beats:
//   1. Call uav_hal_pwm_write_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_flight_stubs: PASSED only if they match.

import "std/uav_flight/uav_flight_stubs.oo";

pub fn main() {
    let uav_flight_stubs_mark: Int = 0;
    if uav_flight_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = uav_hal_pwm_write_stub(0, 0.0, true);
    let b: Int = uav_hal_pwm_write_stub(0, 0.0, true);
    if a != b {
        println("FAIL uav_hal_pwm_write_stub");
        process_exit(1);
    }
    println("prod_g2_uav_flight_stubs: PASSED");
}
