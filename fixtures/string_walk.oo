// # Walk chars by index
//
// Logline: Loop by length and print each char of ab.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Bind s to ab.
//   2. Walk i from 0 to len.
//   3. Print each char_at.
//
// Alpha fixture: string walk via .len + .char_at (interp + WASM subset).
pub fn main() {
    let s = "ab";
    let mut i = 0;
    while i < s.len() {
        println(s.char_at(i));
        i = i + 1;
    }
}
