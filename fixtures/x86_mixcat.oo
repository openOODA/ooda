// # emit-x86 mixed same-fn string-let concat
//
// Logline: Bind n to zz and print yy plus n so emit-x86 can lower STRING plus a same-fn let.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Bind n to zz.
//   3. Print yy plus n.
//
// residual: greet calls stay later.

pub fn main() {
    let n = "zz";
    println("yy" + n);
}
