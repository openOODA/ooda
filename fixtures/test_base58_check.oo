// # Base58Check adversarial suite
//
// Logline: Encodes a payload with leading zeros, verifies the double-SHA256 checksum, and rejects a mismatch.
//
// Setup: Pure. Imports base58_check.oo. Run from ooda/.
//
// Beats:
//   1. Encode a payload that starts with a zero byte.
//   2. Decode and recover that leading zero.
//   3. Tamper the checksum and require Err.

import "std/encoding/base58_check.oo";

pub fn main() {
    let mut p: List[Int] = list_new();
    p = list_push(p, 0);
    p = list_push(p, 1);
    p = list_push(p, 2);
    let e: B58Out = base58_check_encode(p);
    if e.flag < 1 {
        println("FAIL encode " + e.err);
        process_exit(1);
    }
    if e.nzero < 1 {
        println("FAIL nzero");
        process_exit(1);
    }
    let d: ByteOut = base58_check_decode(e.text);
    if d.flag < 1 {
        println("FAIL decode " + d.err);
        process_exit(1);
    }
    if list_len(d.bytes) != 3 {
        println("FAIL len");
        process_exit(1);
    }
    if list_get(d.bytes, 0) != 0 {
        println("FAIL leading zero");
        process_exit(1);
    }
    if list_get(d.bytes, 1) != 1 {
        println("FAIL payload");
        process_exit(1);
    }
    println("leading-zero bytes preserved");
    println("4-byte double-SHA256 checksum verified");
    let bad: ByteOut = base58_check_decode(e.text + "2");
    if bad.flag > 0 {
        println("FAIL mismatch ok");
        process_exit(1);
    }
    let st: Result[Int, String] = base58_check_stat(bad.flag, bad.err);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("mismatch Err");
    println("SUITE PASSED");
    println("test_base58_check: PASSED");
}
