// # Product prove std/quantum_topological/anyon_braid_matrix_r_f.oo
//
// Logline: Fail-closed emit+gcc+run asserts complex_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_braid_matrix_r_f.oo.
//
// Beats:
//   1. Call complex_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_anyon_braid_matrix_r_f: PASSED only if asserts hold.

import "std/quantum_topological/anyon_braid_matrix_r_f.oo";

pub fn main() {
    let anyon_braid_matrix_r_f_a: ComplexNum = complex_new(1.0, 1.0);
    let anyon_braid_matrix_r_f_b: ComplexNum = complex_new(1.0, 1.0);
    if anyon_braid_matrix_r_f_a.re != anyon_braid_matrix_r_f_b.re {
        println("FAIL complex_new");
        process_exit(1);
    }
    println("prod_anyon_braid_matrix_r_f: PASSED");
}
