// # Product prove std/db_storage/btree_bulk_loader.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/btree_bulk_loader.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_bulk_loader.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_btree_bulk_loader: PASSED only if they match.

import "std/db_storage/btree_bulk_loader.oo";

pub fn main() {
    let btree_bulk_loader_a = bulk_loader_config_default();
    let btree_bulk_loader_b = bulk_loader_config_default();
    if btree_bulk_loader_a.page_capacity_keys != btree_bulk_loader_b.page_capacity_keys {
        println("FAIL btree_bulk_loader");
        process_exit(1);
    }
    println("prod_ap_btree_bulk_loader: PASSED");
}
