// # Product prove std/astrodynamics/bi_elliptic_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/bi_elliptic_transfer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/bi_elliptic_transfer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bi_elliptic_transfer: PASSED only if they match.

import "std/astrodynamics/bi_elliptic_transfer.oo";

pub fn main() {
    let bi_elliptic_transfer_a = bielliptic_burns();
    let bi_elliptic_transfer_b = bielliptic_burns();
    if bi_elliptic_transfer_a != bi_elliptic_transfer_b {
        println("FAIL bi_elliptic_transfer");
        process_exit(1);
    }
    println("prod_ap_bi_elliptic_transfer: PASSED");
}
