// # Product core list helpers prove
//
// Logline: Fail-closed emit+gcc+run of std/core/list.oo empty, first, and last.
//
// Setup: Tree oodac emit-c. Calls ooda/std/core/list.oo. Destub none.
//
// Beats:
//   1. list_is_empty of a new list is true.
//   2. list_first of empty is Err.
//   3. After one push, list_last Ok payload is 9.
//   4. Exit 1 on any miss. Print prod_core_list: PASSED only if all hold.

import "std/core/list.oo";

pub fn main() {
    let xs: List[Int] = list_new();
    if !list_is_empty(xs) {
        println("FAIL list_is_empty");
        process_exit(1);
    }
    let f: Result[Int, String] = list_first(xs);
    if !f.is_err() {
        println("FAIL list_first empty");
        process_exit(1);
    }
    let ys: List[Int] = list_push(xs, 9);
    let last: Result[Int, String] = list_last(ys);
    if !last.is_ok() {
        println("FAIL list_last miss");
        process_exit(1);
    }
    let v: Int = match last {
        Ok(x) => x,
        Err(e) => 0 - 1,
    };
    if v != 9 {
        println("FAIL list_last val");
        process_exit(1);
    }
    println("prod_core_list: PASSED");
}
