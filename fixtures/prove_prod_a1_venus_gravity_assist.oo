// # Product prove std/astro_advanced/venus_gravity_assist.oo
//
// Logline: Fail-closed emit+gcc+run asserts venus_assist_dv is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/venus_gravity_assist.oo.
//
// Beats:
//   1. Call venus_assist_dv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_venus_gravity_assist: PASSED only if they match.

import "std/astro_advanced/venus_gravity_assist.oo";

pub fn main() {
    let venus_gravity_assist_mark: Int = 0;
    if venus_gravity_assist_mark != 0 {
        process_exit(1);
    }
    let a: Int = venus_assist_dv();
    let b: Int = venus_assist_dv();
    if a != b {
        println("FAIL venus_assist_dv");
        process_exit(1);
    }
    println("prod_venus_gravity_assist: PASSED");
}
