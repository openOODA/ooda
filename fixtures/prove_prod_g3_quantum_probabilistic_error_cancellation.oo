// # Product prove std/quantum_advanced/quantum_probabilistic_error_cancellation.oo
//
// Logline: Fail-closed emit+gcc+run asserts pec_circuit_sampling_overhead is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_probabilistic_error_cancellation.oo.
//
// Beats:
//   1. Call pec_circuit_sampling_overhead twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_probabilistic_error_cancellation: PASSED only if they match.

import "std/quantum_advanced/quantum_probabilistic_error_cancellation.oo";

pub fn main() {
    let quantum_probabilistic_error_cancellation_mark: Int = 0;
    if quantum_probabilistic_error_cancellation_mark != 0 {
        process_exit(1);
    }
    let a: Float = pec_circuit_sampling_overhead(0.0, 0);
    let b: Float = pec_circuit_sampling_overhead(0.0, 0);
    if a != b {
        println("FAIL pec_circuit_sampling_overhead");
        process_exit(1);
    }
    println("prod_quantum_probabilistic_error_cancellation: PASSED");
}
