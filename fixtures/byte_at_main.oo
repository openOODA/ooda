// # Raw byte_at
//
// Logline: Print byte_at indexes 0, 1, and 99 of "AB".
//
// Beats:
//   1. Read byte 0 of "AB" (65).
//   2. Read byte 1 of "AB" (66).
//   3. Read out-of-range index 99.

// M162 path A: byte_at raw 0..255 (not &str borrow)
pub fn main() {
    let s = "AB";
    // 'A' = 65, 'B' = 66
    println(byte_at(s, 0));
    println(byte_at(s, 1));
    println(byte_at(s, 99));
}
