// # Product prove std/tda_topology/graph_persistent_homology.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_persistence_add_edge is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/graph_persistent_homology.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call graph_persistence_add_edge twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_graph_persistent_homology: PASSED only if they match.

import "std/tda_topology/graph_persistent_homology.oo";

pub fn main() {
    let mut g0_oa = graph_persistence_summary_new(0);
    let mut g0_ob = graph_persistence_summary_new(0);
    let g0_a = graph_persistence_add_edge(&g0_oa, 0, 0, 0.0, 0);
    let g0_b = graph_persistence_add_edge(&g0_ob, 0, 0, 0.0, 0);
    if g0_a != g0_b {
        println("FAIL graph_persistence_add_edge");
        process_exit(1);
    }
    println("prod_gr_graph_persistent_homology: PASSED");
}
