// # Product queue prove
//
// Logline: Fail-closed emit+gcc+run of shipped queue_enqueue/peek/dequeue.
//
// Setup: Product std/collections/queue.oo. FIFO a then b. Needs emit-c field retain.
//
// Beats:
//   1. After enqueue a then b, len is 2 and peek is a.
//   2. After dequeue, peek is b.
//   3. Exit 1 before PASSED on a miss.

import "std/collections/queue.oo";

pub fn main() {
    let q0: Queue = queue_new();
    let q1: Queue = queue_enqueue(q0, "a");
    let q2: Queue = queue_enqueue(q1, "b");
    let n: Int = queue_len(q2);
    if n != 2 {
        println("FAIL queue len");
        process_exit(1);
    }
    let p1: Result[String, String] = queue_peek(q2);
    if p1.is_err() {
        println("FAIL queue peek err");
        process_exit(1);
    }
    let a: String = p1.unwrap();
    if a != "a" {
        println("FAIL queue peek a");
        process_exit(1);
    }
    let q3: Queue = queue_dequeue(q2);
    let p2: Result[String, String] = queue_peek(q3);
    if p2.is_err() {
        println("FAIL queue peek2 err");
        process_exit(1);
    }
    let b: String = p2.unwrap();
    if b != "b" {
        println("FAIL queue peek b");
        process_exit(1);
    }
    println("prod_queue: PASSED");
}
