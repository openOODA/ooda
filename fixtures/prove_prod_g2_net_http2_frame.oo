// # Product prove std/net/http2_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts http2_frame_type_name is a real value.
//
// Setup: Isolated emit-c. Imports std/net/http2_frame.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call http2_frame_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_http2_frame: PASSED only if they match.

import "std/net/http2_frame.oo";

pub fn main() {
    let g2_a = http2_frame_type_name(2);
    let g2_b = http2_frame_type_name(2);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL http2_frame_type_name");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL http2_frame_type_name");
        process_exit(1);
    }
    println("prod_g2_http2_frame: PASSED");
}
