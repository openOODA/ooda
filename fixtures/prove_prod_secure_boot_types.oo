// # Product prove std/sec/sys/secure_boot_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts sboot_violation_type is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot_types.oo.
//
// Beats:
//   1. Call sboot_violation_type twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secure_boot_types: PASSED only if they match.

import "std/sec/sys/secure_boot_types.oo";

pub fn main() {
    let obj = sboot_violation_new(0, 0);
    let a = sboot_violation_type(obj);
    let b = sboot_violation_type(obj);
    if a != b {
        println("FAIL sboot_violation_type");
        process_exit(1);
    }
    println("prod_secure_boot_types: PASSED");
}
