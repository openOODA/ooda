// # Product prove std/net/quic_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts quic_packet_is_long is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/quic_packet.oo.
//
// Beats:
//   1. Call quic_packet_is_long twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quic_packet: PASSED only if they match.

import "std/net/quic_packet.oo";

pub fn main() {
    let obj_a: QuicPacket = quic_packet_initial("x", "x", "x");
    let obj_b: QuicPacket = quic_packet_initial("x", "x", "x");
    let a: Bool = quic_packet_is_long(obj_a);
    let b: Bool = quic_packet_is_long(obj_b);
    if a != b {
        println("FAIL quic_packet_is_long");
        process_exit(1);
    }
    println("prod_quic_packet: PASSED");
}
