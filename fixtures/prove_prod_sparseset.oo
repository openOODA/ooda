// # Product sparse_set prove
//
// Logline: Fail-closed emit+gcc+run of shipped sparse_set_insert/contains.
//
// Setup: Product std/collections/sparse_set.oo. Capacity 8, insert 3.
//
// Beats:
//   1. After insert 3, contains 3 is true and contains 2 is false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/sparse_set.oo";

pub fn main() {
    let mut s: SparseSet = sparse_set_new(8);
    s = sparse_set_insert(s, 3);
    let c3: Bool = sparse_set_contains(s, 3);
    if c3 == false {
        println("FAIL sparse contains 3");
        process_exit(1);
    }
    let c2: Bool = sparse_set_contains(s, 2);
    if c2 == true {
        println("FAIL sparse contains 2");
        process_exit(1);
    }
    println("prod_sparseset: PASSED");
}
