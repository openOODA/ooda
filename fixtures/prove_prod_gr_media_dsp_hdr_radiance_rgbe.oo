// # Product prove std/media_dsp/hdr_radiance_rgbe.oo
//
// Logline: Fail-closed emit+gcc+run asserts hdr_rgbe_new is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/hdr_radiance_rgbe.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call hdr_rgbe_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_hdr_radiance_rgbe: PASSED only if they match.

import "std/media_dsp/hdr_radiance_rgbe.oo";

pub fn main() {
    let g0_oa = hdr_rgbe_new(0, 0, 0, 0);
    let g0_ob = hdr_rgbe_new(0, 0, 0, 0);
    let g0_a = (g0_oa).r;
    let g0_b = (g0_ob).r;
    if g0_a != g0_b {
        println("FAIL hdr_rgbe_new.r");
        process_exit(1);
    }
    println("prod_gr_hdr_radiance_rgbe: PASSED");
}
