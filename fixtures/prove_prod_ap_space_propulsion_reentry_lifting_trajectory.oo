// # Product prove std/space_propulsion/reentry_lifting_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/reentry_lifting_trajectory.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/reentry_lifting_trajectory.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_reentry_lifting_trajectory: PASSED only if they match.

import "std/space_propulsion/reentry_lifting_trajectory.oo";

pub fn main() {
    let reentry_lifting_trajectory_a = lifting_entry_vehicle_default();
    let reentry_lifting_trajectory_b = lifting_entry_vehicle_default();
    if reentry_lifting_trajectory_a.mass_kg != reentry_lifting_trajectory_b.mass_kg {
        println("FAIL reentry_lifting_trajectory");
        process_exit(1);
    }
    println("prod_ap_reentry_lifting_trajectory: PASSED");
}
