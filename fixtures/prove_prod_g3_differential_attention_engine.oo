// # Product prove std/ai_multimodal/differential_attention_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/differential_attention_engine.oo.
//
// Beats:
//   1. Call diff_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_differential_attention_engine: PASSED only if they match.

import "std/ai_multimodal/differential_attention_engine.oo";

pub fn main() {
    let differential_attention_engine_mark: Int = 0;
    if differential_attention_engine_mark != 0 {
        process_exit(1);
    }
    let a: Float = diff_int_to_float(0);
    let b: Float = diff_int_to_float(0);
    if a != b {
        println("FAIL diff_int_to_float");
        process_exit(1);
    }
    println("prod_differential_attention_engine: PASSED");
}
