// # Product prove std/net/http.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_parse_status is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http.oo.
//
// Beats:
//   1. Call http_parse_status twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http: PASSED only if they match.

import "std/net/http.oo";

pub fn main() {
    let a = http_parse_status("x");
    let b = http_parse_status("x");
    if a != b {
        println("FAIL http_parse_status");
        process_exit(1);
    }
    println("prod_http: PASSED");
}
