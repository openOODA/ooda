// # Product prove std/multimedia/jpeg_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts jpeg_marker_soi is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/jpeg_header.oo.
//
// Beats:
//   1. Call jpeg_marker_soi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jpeg_header: PASSED only if they match.

import "std/multimedia/jpeg_header.oo";

pub fn main() {
    let jpeg_header_mark: Int = 0;
    if jpeg_header_mark != 0 {
        process_exit(1);
    }
    let jpeg_header_a: Int = jpeg_marker_soi();
    let jpeg_header_b: Int = jpeg_marker_soi();
    if jpeg_header_a != jpeg_header_b {
        println("FAIL jpeg_marker_soi");
        process_exit(1);
    }
    println("prod_jpeg_header: PASSED");
}
