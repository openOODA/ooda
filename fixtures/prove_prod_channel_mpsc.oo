// # Product prove std/sync/channel_mpsc.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpsc_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/channel_mpsc.oo.
//
// Beats:
//   1. Call mpsc_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_mpsc: PASSED only if they match.

import "std/sync/channel_mpsc.oo";

pub fn main() {
    let obj = mpsc_channel_new(0);
    let a = mpsc_len(obj);
    let b = mpsc_len(obj);
    if a != b {
        println("FAIL mpsc_len");
        process_exit(1);
    }
    println("prod_channel_mpsc: PASSED");
}
