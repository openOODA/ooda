// # Product prove std/telecom/nr5g_subcarrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_subcarrier_index_to_prb is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/nr5g_subcarrier.oo.
//
// Beats:
//   1. Call nr5g_subcarrier_index_to_prb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nr5g_subcarrier: PASSED only if they match.

import "std/telecom/nr5g_subcarrier.oo";

pub fn main() {
    let a = nr5g_subcarrier_index_to_prb(0);
    let b = nr5g_subcarrier_index_to_prb(0);
    if a != b {
        println("FAIL nr5g_subcarrier_index_to_prb");
        process_exit(1);
    }
    println("prod_nr5g_subcarrier: PASSED");
}
