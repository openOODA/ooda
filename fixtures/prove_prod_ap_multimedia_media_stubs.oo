// # Product prove std/multimedia/media_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/multimedia/media_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/multimedia/media_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_media_stubs: PASSED only if they match.

import "std/multimedia/media_stubs.oo";

pub fn main() {
    let media_stubs_a = media_hw_probe();
    let media_stubs_b = media_hw_probe();
    if media_stubs_a.has_vaapi != media_stubs_b.has_vaapi {
        println("FAIL media_stubs");
        process_exit(1);
    }
    println("prod_ap_media_stubs: PASSED");
}
