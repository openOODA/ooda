// # Product prove std/compilers_polyhedral/polyhedral_spatial_locality.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_cache_line_waste_percent is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_spatial_locality.oo.
//
// Beats:
//   1. Call spatial_cache_line_waste_percent twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_spatial_locality: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_spatial_locality.oo";

pub fn main() {
    let polyhedral_spatial_locality_mark: Int = 0;
    if polyhedral_spatial_locality_mark != 0 {
        process_exit(1);
    }
    let a: Int = spatial_cache_line_waste_percent(0, 0);
    let b: Int = spatial_cache_line_waste_percent(0, 0);
    if a != b {
        println("FAIL spatial_cache_line_waste_percent");
        process_exit(1);
    }
    println("prod_g2_polyhedral_spatial_locality: PASSED");
}
