// # Product prove std/bio_advanced/pdb_b_factor_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfactor_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/pdb_b_factor_analysis.oo.
//
// Beats:
//   1. Call bfactor_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pdb_b_factor_analysis: PASSED only if they match.

import "std/bio_advanced/pdb_b_factor_analysis.oo";

pub fn main() {
    let pdb_b_factor_analysis_mark: Int = 0;
    if pdb_b_factor_analysis_mark != 0 {
        process_exit(1);
    }
    let a: Float = bfactor_sqrt(0.0);
    let b: Float = bfactor_sqrt(0.0);
    if a != b {
        println("FAIL bfactor_sqrt");
        process_exit(1);
    }
    println("prod_pdb_b_factor_analysis: PASSED");
}
