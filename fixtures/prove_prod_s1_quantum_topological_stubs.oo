// # Product prove std/quantum_topological/quantum_topological_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts topological_execution_telemetry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_topological_stubs.oo.
//
// Beats:
//   1. Call topological_execution_telemetry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_topological_stubs: PASSED only if they match.

import "std/quantum_topological/quantum_topological_stubs.oo";

pub fn main() {
    let quantum_topological_stubs_mark: Int = 0;
    if quantum_topological_stubs_mark != 0 {
        process_exit(1);
    }
    let quantum_topological_stubs_a = topological_execution_telemetry_new();
    let quantum_topological_stubs_b = topological_execution_telemetry_new();
    if (quantum_topological_stubs_a).total_braids_executed != (quantum_topological_stubs_b).total_braids_executed {
        println("FAIL topological_execution_telemetry_new");
        process_exit(1);
    }
    println("prod_quantum_topological_stubs: PASSED");
}
