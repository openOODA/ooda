// # Product prove std/simd/simd_pack_unpack.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_pack_4bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_pack_unpack.oo.
//
// Beats:
//   1. Call simd_pack_4bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_pack_unpack: PASSED only if they match.

import "std/simd/simd_pack_unpack.oo";

pub fn main() {
    let a = simd_pack_4bytes(0, 0, 0, 0);
    let b = simd_pack_4bytes(0, 0, 0, 0);
    if a != b {
        println("FAIL simd_pack_4bytes");
        process_exit(1);
    }
    println("prod_simd_pack_unpack: PASSED");
}
