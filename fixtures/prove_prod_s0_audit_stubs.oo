// # Product prove std/enterprise/audit_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_severity_to_string value or determinism.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_stubs.oo.
//
// Beats:
//   1. Call audit_severity_to_string twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_audit_stubs: PASSED only if asserts hold.

import "std/enterprise/audit_stubs.oo";

pub fn main() {
    let audit_stubs_a: String = audit_severity_to_string(0);
    let audit_stubs_b: String = audit_severity_to_string(0);
    if chars_len(audit_stubs_a) != chars_len(audit_stubs_b) {
        println("FAIL audit_severity_to_string");
        process_exit(1);
    }
    println("prod_audit_stubs: PASSED");
}
