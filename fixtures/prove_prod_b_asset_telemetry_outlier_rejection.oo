// # Product prove std/digital_twin/asset_telemetry_outlier_rejection.oo
//
// Logline: Fail-closed emit+gcc+run asserts asset_telemetry_outlier_rejection_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_telemetry_outlier_rejection.oo.
//
// Beats:
//   1. Call asset_telemetry_outlier_rejection_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_asset_telemetry_outlier_rejection: PASSED only if they match.

import "std/digital_twin/asset_telemetry_outlier_rejection.oo";

pub fn main() {
    let a = asset_telemetry_outlier_rejection_probe();
    let b = asset_telemetry_outlier_rejection_probe();
    if a != b {
        println("FAIL asset_telemetry_outlier_rejection_probe");
        process_exit(1);
    }
    println("prod_asset_telemetry_outlier_rejection: PASSED");
}
