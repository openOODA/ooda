// # Product prove std/robotics_auv/auv_mpc_trajectory_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpc_horizon_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_mpc_trajectory_tracker.oo.
//
// Beats:
//   1. Call mpc_horizon_config_default using the auv_mpc_trajectory_tracker ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_mpc_trajectory_tracker: PASSED only if asserts hold.

import "std/robotics_auv/auv_mpc_trajectory_tracker.oo";

pub fn main() {
    let obj = mpc_horizon_config_default();
    let auv_mpc_trajectory_tracker_a = obj.horizon_steps;
    if auv_mpc_trajectory_tracker_a != 10 {
        println("FAIL mpc_horizon_config_default");
        process_exit(1);
    }
    println("prod_auv_mpc_trajectory_tracker: PASSED");
}
