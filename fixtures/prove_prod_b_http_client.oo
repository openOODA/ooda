// # Product prove std/net/http_client.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_client_build_header is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http_client.oo.
//
// Beats:
//   1. Call http_client_build_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http_client: PASSED only if they match.

import "std/net/http_client.oo";

pub fn main() {
    let a = http_client_build_header("x", "x", "x", "x", "x");
    let b = http_client_build_header("x", "x", "x", "x", "x");
    if a != b {
        println("FAIL http_client_build_header");
        process_exit(1);
    }
    println("prod_http_client: PASSED");
}
