// # Product prove std/ai_multimodal/wav2vec_conformer_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts conformer_glu_activation is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/wav2vec_conformer_block.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call conformer_glu_activation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_wav2vec_conformer_block: PASSED only if they match.

import "std/ai_multimodal/wav2vec_conformer_block.oo";

pub fn main() {
    let g0_a = conformer_glu_activation(1.0, 1.0);
    let g0_b = conformer_glu_activation(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL conformer_glu_activation");
        process_exit(1);
    }
    println("prod_g0_wav2vec_conformer_block: PASSED");
}
