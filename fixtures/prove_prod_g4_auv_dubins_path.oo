// # Product prove std/robotics_auv/dubins_auv_path_3d.oo
//
// Logline: Fail-closed verification of 3D Dubins curvature-bounded paths and turning constraints for AUVs.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/dubins_auv_path_3d.oo.
//
// Beats:
//   1. Query default Dubins AUV turning configuration constraints.
//   2. Solve horizontal RSR segment lengths and assert determinism.
//   3. Solve 3D composite Dubins trajectory across start and target poses.
//   4. Print prod_g4_auv_dubins_path: PASSED and exit 0.

import "std/robotics_auv/dubins_auv_path_3d.oo";
import "std/robotics_auv/fossen_6dof_hydrodynamics.oo";

pub fn main() {
    let cfg: DubinsAuvConfig = dubins_auv_config_default();
    let cfg_b: DubinsAuvConfig = dubins_auv_config_default();

    let r_min1: Float = (cfg).min_turn_radius_m;
    let r_min2: Float = (cfg_b).min_turn_radius_m;
    if r_min1 != r_min2 || r_min1 != 8.0 {
        println("FAIL dubins_auv_config_default min_turn_radius");
        process_exit(1);
    }

    let rsr1: Float = dubins_solve_rsr(50.0, 0.0, 0.0, 0.0, 8.0);
    let rsr2: Float = dubins_solve_rsr(50.0, 0.0, 0.0, 0.0, 8.0);
    if rsr1 != rsr2 || rsr1 <= 0.0 {
        println("FAIL dubins_solve_rsr determinism");
        process_exit(1);
    }

    let p_start: AuvPose = AuvPose { x: 0.0, y: 0.0, z: 0.0, phi: 0.0, theta: 0.0, psi: 0.0 };
    let p_end: AuvPose = AuvPose { x: 50.0, y: 0.0, z: 10.0, phi: 0.0, theta: 0.0, psi: 0.0 };

    let path1: Dubins3DPath = dubins_solve_3d_path(&cfg, &p_start, &p_end);
    let path2: Dubins3DPath = dubins_solve_3d_path(&cfg, &p_start, &p_end);

    let len1: Float = (path1).total_length_3d_m;
    let len2: Float = (path2).total_length_3d_m;
    if len1 != len2 || len1 <= 0.0 {
        println("FAIL dubins_solve_3d_path total_length");
        process_exit(1);
    }

    let v_dist: Float = (path1).vertical_distance_m;
    if v_dist != 10.0 {
        println("FAIL dubins_solve_3d_path vertical_distance");
        process_exit(1);
    }

    let is_v: Bool = (path1).is_valid;
    if !is_v {
        println("FAIL dubins_solve_3d_path is_valid");
        process_exit(1);
    }

    println("prod_g4_auv_dubins_path: PASSED");
    process_exit(0);
}
