// # Product beta prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_beta_inc_reg.
//
// Setup: Product std/math/special_beta.oo. Ix endpoints.
//
// Beats:
//   1. math_beta_inc_reg(1,1,0) is 0.0.
//   2. math_beta_inc_reg(1,1,1) is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/special_beta.oo";

pub fn main() {
    let z: Float = math_beta_inc_reg(1.0, 1.0, 0.0);
    if z != 0.0 {
        println("FAIL beta0");
        process_exit(1);
    }
    let o: Float = math_beta_inc_reg(1.0, 1.0, 1.0);
    if o != 1.0 {
        println("FAIL beta1");
        process_exit(1);
    }
    println("prod_beta: PASSED");
}
