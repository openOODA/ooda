// # OPEN-90 hot_reload detects change
//
// Logline: First load is 1; a second call on the same bytes is 0.
//
// Setup: oo_hot_reload hashes the file. Always-1 is a stub.
//
// Beats:
//   1. First hot_reload of this fixture is 1.
//   2. Second call without a write is 0.
//   3. Print open90: PASSED.

pub fn main() {
    let a = hot_reload("fixtures/open90_hotswap.oo");
    let b = hot_reload("fixtures/open90_hotswap.oo");
    if a != 1 {
        println("FAIL first");
        process_exit(1);
    }
    if b != 0 {
        println("FAIL always-one");
        process_exit(1);
    }
    println("open90: PASSED");
}
