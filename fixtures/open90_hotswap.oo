// # OPEN-90 hot_reload product
//
// Logline: Reload a path and print PASSED.
//
// Setup: hot_reload is product C.
//
// Beats:
//   1. Call hot_reload on this fixture.
//   2. Require 1.
//   3. Print open90: PASSED.

pub fn main() {
    let n = hot_reload("fixtures/open90_hotswap.oo");
    if n != 1 {
        println("FAIL");
        process_exit(1);
    }
    println("open90: PASSED");
}
