// # Product prove std/bio_advanced/protein_mass_spec_peptides.oo
//
// Logline: Fail-closed emit+gcc+run asserts mass_spec_aa_monoisotopic is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_mass_spec_peptides.oo.
//
// Beats:
//   1. Call mass_spec_aa_monoisotopic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_mass_spec_peptides: PASSED only if they match.

import "std/bio_advanced/protein_mass_spec_peptides.oo";

pub fn main() {
    let protein_mass_spec_peptides_mark: Int = 0;
    if protein_mass_spec_peptides_mark != 0 {
        process_exit(1);
    }
    let a: Float = mass_spec_aa_monoisotopic("x");
    let b: Float = mass_spec_aa_monoisotopic("x");
    if a != b {
        println("FAIL mass_spec_aa_monoisotopic");
        process_exit(1);
    }
    println("prod_protein_mass_spec_peptides: PASSED");
}
