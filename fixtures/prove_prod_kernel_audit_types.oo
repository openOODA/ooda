// # Product prove std/sec/sys/kernel_audit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_rule_perm is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit_types.oo.
//
// Beats:
//   1. Call audit_rule_perm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_audit_types: PASSED only if they match.

import "std/sec/sys/kernel_audit_types.oo";

pub fn main() {
    let obj = audit_rule_new(0, 0);
    let a = audit_rule_perm(obj);
    let b = audit_rule_perm(obj);
    if a != b {
        println("FAIL audit_rule_perm");
        process_exit(1);
    }
    println("prod_kernel_audit_types: PASSED");
}
