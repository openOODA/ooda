// # Product prove linear algebra
//
// Logline: Fail-closed emit+gcc+run drives BLAS-1, BLAS-2, LU, and Householder QR on small Float matrices.
//
// Setup: Isolated emit-c. Run from ooda/.
//
// Beats:
//   1. BLAS-1 dot, L2, axpy, and iamax match named identities.
//   2. GEMV and GER apply matrix-vector and rank-1 update.
//   3. LU solves A x = b and yields det.
//   4. QR reconstructs A with a small residual.

import "std/linalg/blas_level1.oo";
import "std/linalg/blas_level2.oo";
import "std/linalg/lu_decomposition.oo";
import "std/linalg/qr_householder.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn unwrap_f(r: Result[Float, String], msg: String) -> Float {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return 0.0; }
    }
}

fn unwrap_i(r: Result[Int, String], msg: String) -> Int {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return 0; }
    }
}

fn unwrap_fv(r: Result[List[Float], String], msg: String) -> List[Float] {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return list_new(); }
    }
}

fn near(a: Float, b: Float, eps: Float) -> Bool {
    let mut d: Float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d <= eps;
}

fn prove_blas1() {
    let mut u: List[Float] = list_new();
    u = list_push(u, 1.0);
    u = list_push(u, 2.0);
    u = list_push(u, 3.0);
    let mut v: List[Float] = list_new();
    v = list_push(v, 4.0);
    v = list_push(v, 5.0);
    v = list_push(v, 6.0);
    let d: Float = unwrap_f(blas_level1_dot_product(u, v), "dot");
    if near(d, 32.0, 0.0000001) == false { fail("dot"); }
    let n: Float = unwrap_f(blas_level1_norm_l2(u), "norm");
    if near(n, sqrt(14.0), 0.0000001) == false { fail("norm"); }
    let ax: List[Float] = unwrap_fv(blas_level1_axpy(1.0, u, v), "axpy");
    if near(list_get(ax, 0), 5.0, 0.0000001) == false { fail("axpy"); }
    if unwrap_i(blas_level1_iamax(u), "iamax") != 2 { fail("iamax"); }
    println("BLAS-1 dot=" + d.to_string() + " iamax=2");
}

fn prove_blas2() {
    let mut a: List[Float] = list_new();
    a = list_push(a, 1.0);
    a = list_push(a, 2.0);
    a = list_push(a, 3.0);
    a = list_push(a, 4.0);
    let mut x: List[Float] = list_new();
    x = list_push(x, 1.0);
    x = list_push(x, 1.0);
    let mut y: List[Float] = list_new();
    y = list_push(y, 0.0);
    y = list_push(y, 0.0);
    let g: List[Float] = unwrap_fv(blas_level2_gemv(1.0, a, 2, 2, x, 0.0, y), "gemv");
    if near(list_get(g, 0), 3.0, 0.0000001) == false { fail("gemv0"); }
    if near(list_get(g, 1), 7.0, 0.0000001) == false { fail("gemv1"); }
    let ger: List[Float] = unwrap_fv(blas_level2_ger(1.0, x, x, a, 2, 2), "ger");
    if near(list_get(ger, 0), 2.0, 0.0000001) == false { fail("ger"); }
    println("BLAS-2 gemv/ger ok");
}

fn prove_lu() {
    let mut a: List[Float] = list_new();
    a = list_push(a, 2.0);
    a = list_push(a, 1.0);
    a = list_push(a, 1.0);
    a = list_push(a, 2.0);
    let mut b: List[Float] = list_new();
    b = list_push(b, 5.0);
    b = list_push(b, 4.0);
    let pack: List[Float] = unwrap_fv(lu_decomposition_factor(a, 2), "lu factor");
    let x: List[Float] = unwrap_fv(lu_decomposition_solve(pack, 2, b), "lu solve");
    if near(list_get(x, 0), 2.0, 0.000001) == false { fail("lu x0"); }
    if near(list_get(x, 1), 1.0, 0.000001) == false { fail("lu x1"); }
    let det: Float = unwrap_f(lu_decomposition_det(pack, 2), "lu det");
    if near(det, 3.0, 0.000001) == false { fail("lu det"); }
    println("LU solve x0=" + list_get(x, 0).to_string() + " det=" + det.to_string());
}

fn prove_qr() {
    let mut a: List[Float] = list_new();
    a = list_push(a, 1.0);
    a = list_push(a, 1.0);
    a = list_push(a, 0.0);
    a = list_push(a, 1.0);
    let pack: List[Float] = unwrap_fv(qr_householder_factor(a, 2, 2), "qr factor");
    let rec: List[Float] = unwrap_fv(qr_householder_reconstruct(pack, 2, 2), "qr reconstruct");
    if near(list_get(rec, 0), 1.0, 0.000001) == false { fail("qr residual"); }
    if near(list_get(rec, 1), 1.0, 0.000001) == false { fail("qr residual"); }
    if near(list_get(rec, 2), 0.0, 0.000001) == false { fail("qr residual"); }
    if near(list_get(rec, 3), 1.0, 0.000001) == false { fail("qr residual"); }
    println("QR reconstruct residual small");
}

pub fn main() {
    prove_blas1();
    prove_blas2();
    prove_lu();
    prove_qr();
    println("prove_prod_linalg: PASSED");
}
