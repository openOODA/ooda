// # Product prove std/quantum_topological/topological_density_matrix_fusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts topo_density_matrix_pure_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_density_matrix_fusion.oo.
//
// Beats:
//   1. Call topo_density_matrix_pure_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_topological_density_matrix_fusion: PASSED only if they match.

import "std/quantum_topological/topological_density_matrix_fusion.oo";

pub fn main() {
    let topological_density_matrix_fusion_mark: Int = 0;
    if topological_density_matrix_fusion_mark != 0 {
        process_exit(1);
    }
    let a: TopoDensityMatrix2x2 = topo_density_matrix_pure_zero();
    let b: TopoDensityMatrix2x2 = topo_density_matrix_pure_zero();
    if (a).rho00 != (b).rho00 {
        println("FAIL topo_density_matrix_pure_zero");
        process_exit(1);
    }
    println("prod_g2_topological_density_matrix_fusion: PASSED");
}
