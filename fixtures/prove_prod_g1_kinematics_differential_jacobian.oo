// # Product prove std/robotics_ros2/kinematics_differential_jacobian.oo
//
// Logline: Fail-closed emit+gcc+run asserts kinematics_jacobian_2link is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/kinematics_differential_jacobian.oo.
//
// Beats:
//   1. Call kinematics_jacobian_2link twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kinematics_differential_jacobian: PASSED only if they match.

import "std/robotics_ros2/kinematics_differential_jacobian.oo";

pub fn main() {
    let a: ManipulatorJacobian2D = kinematics_jacobian_2link(0.0, 0.0, 0.0, 0.0);
    let b: ManipulatorJacobian2D = kinematics_jacobian_2link(0.0, 0.0, 0.0, 0.0);
    if a.j11 != b.j11 {
        println("FAIL kinematics_jacobian_2link");
        process_exit(1);
    }
    println("prod_kinematics_differential_jacobian: PASSED");
}
