// # Product prove std/tui/widget_input.oo
//
// Logline: Fail-closed emit+gcc+run asserts widget_input_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/widget_input.oo.
//
// Beats:
//   1. Call widget_input_new using the widget_input ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_widget_input: PASSED only if asserts hold.

import "std/tui/widget_input.oo";
import "std/tui/tui_buffer.oo";

pub fn main() {
    let arg2 = buffer_area_new(0, 0, 8, 8);
    let obj = widget_input_new(8, "x", arg2);
    let widget_input_a = obj.id;
    if widget_input_a != 8 {
        println("FAIL widget_input_new");
        process_exit(1);
    }
    println("prod_widget_input: PASSED");
}
