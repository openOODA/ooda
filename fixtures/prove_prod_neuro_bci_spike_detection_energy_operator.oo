// # Product prove std/neuro_bci/spike_detection_energy_operator.oo
//
// Logline: Fail-closed emit+check asserts neo_compute_point_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_detection_energy_operator.oo.
//
// Beats:
//   1. Call neo_compute_point_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spike_detection_energy_operator: PASSED only if they match.

import "std/neuro_bci/spike_detection_energy_operator.oo";

pub fn main() {
    let spike_detection_energy_operator_mark: Int = 0;
    if spike_detection_energy_operator_mark != 0 { process_exit(1); }
    let a: Float = neo_compute_point_energy(0.1, 0.2, 0.3);
    let b: Float = neo_compute_point_energy(0.1, 0.2, 0.3);
    if a != b { process_exit(1); }
    println("prod_spike_detection_energy_operator: PASSED");
}
