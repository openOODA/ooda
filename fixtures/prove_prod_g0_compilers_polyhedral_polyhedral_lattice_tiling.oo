// # Product prove std/compilers_polyhedral/polyhedral_lattice_tiling.oo
//
// Logline: Fail-closed emit+gcc+run asserts lattice_cell_volume is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_lattice_tiling.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call lattice_cell_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_polyhedral_lattice_tiling: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_lattice_tiling.oo";

pub fn main() {
    let g0_oa = lattice_tile_basis_2d_new(2, 2, 2, 2);
    let g0_ob = lattice_tile_basis_2d_new(2, 2, 2, 2);
    let g0_a = lattice_cell_volume(g0_oa);
    let g0_b = lattice_cell_volume(g0_ob);
    if g0_a != g0_b {
        println("FAIL lattice_cell_volume");
        process_exit(1);
    }
    println("prod_g0_polyhedral_lattice_tiling: PASSED");
}
