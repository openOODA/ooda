// # Product prove std/robotics_auv/acoustic_modem_comms.oo
//
// Logline: Fail-closed emit+gcc+run asserts thorp_absorption_db_per_km is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/acoustic_modem_comms.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call thorp_absorption_db_per_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_acoustic_modem_comms: PASSED only if they match.

import "std/robotics_auv/acoustic_modem_comms.oo";

pub fn main() {
    let g0_a = thorp_absorption_db_per_km(1.0);
    let g0_b = thorp_absorption_db_per_km(1.0);
    if g0_a != g0_b {
        println("FAIL thorp_absorption_db_per_km");
        process_exit(1);
    }
    println("prod_g0_acoustic_modem_comms: PASSED");
}
