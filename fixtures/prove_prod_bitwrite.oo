// # Product bit_writer prove
//
// Logline: Fail-closed emit+gcc+run of shipped bit_writer_write_bit/len/last_byte.
//
// Setup: Product std/io/bit_writer.oo. LSB-first pack into last flushed byte.
//
// Beats:
//   1. Eight 1-bits flush to last_byte 255 and len 1.
//   2. Bits 1,0,1 then five 0s flush to last_byte 5.
//   3. Exit 1 before PASSED on a miss.

import "std/io/bit_writer.oo";

pub fn main() {
    let mut w: BitWriter = bit_writer_new();
    let mut i: Int = 0;
    while i < 8 {
        w = bit_writer_write_bit(w, 1);
        i = i + 1;
    }
    let n: Int = bit_writer_len(w);
    if n != 1 {
        println("FAIL bitwrite len");
        process_exit(1);
    }
    let b: Int = bit_writer_last_byte(w);
    if b != 255 {
        println("FAIL bitwrite 255");
        process_exit(1);
    }
    let mut w2: BitWriter = bit_writer_new();
    w2 = bit_writer_write_bit(w2, 1);
    w2 = bit_writer_write_bit(w2, 0);
    w2 = bit_writer_write_bit(w2, 1);
    w2 = bit_writer_write_bit(w2, 0);
    w2 = bit_writer_write_bit(w2, 0);
    w2 = bit_writer_write_bit(w2, 0);
    w2 = bit_writer_write_bit(w2, 0);
    w2 = bit_writer_write_bit(w2, 0);
    let b2: Int = bit_writer_last_byte(w2);
    if b2 != 5 {
        println("FAIL bitwrite 5");
        process_exit(1);
    }
    println("prod_bitwrite: PASSED");
}
