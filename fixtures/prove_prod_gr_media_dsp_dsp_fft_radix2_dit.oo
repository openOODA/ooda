// # Product prove std/media_dsp/dsp_fft_radix2_dit.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_bit_reverse is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_fft_radix2_dit.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dsp_bit_reverse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dsp_fft_radix2_dit: PASSED only if they match.

import "std/media_dsp/dsp_fft_radix2_dit.oo";

pub fn main() {
    let g0_a = dsp_bit_reverse(0, 0);
    let g0_b = dsp_bit_reverse(0, 0);
    if g0_a != g0_b {
        println("FAIL dsp_bit_reverse");
        process_exit(1);
    }
    println("prod_gr_dsp_fft_radix2_dit: PASSED");
}
