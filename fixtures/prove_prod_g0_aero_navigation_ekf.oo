// # Product prove std/aero/navigation_ekf.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_ekf_px is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_ekf.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nav_ekf_px twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_navigation_ekf: PASSED only if they match.

import "std/aero/navigation_ekf.oo";

pub fn main() {
    let g0_oa = nav_ekf_new(2, 2);
    let g0_ob = nav_ekf_new(2, 2);
    let g0_a = nav_ekf_px(g0_oa);
    let g0_b = nav_ekf_px(g0_ob);
    if g0_a != g0_b {
        println("FAIL nav_ekf_px");
        process_exit(1);
    }
    println("prod_g0_navigation_ekf: PASSED");
}
