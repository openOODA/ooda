// # Product prove std/bio_advanced/crispr_cas12a_cpf1.oo
//
// Logline: Fail-closed emit+gcc+run asserts cas12a_is_pam is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_cas12a_cpf1.oo.
//
// Beats:
//   1. Call cas12a_is_pam twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crispr_cas12a_cpf1: PASSED only if they match.

import "std/bio_advanced/crispr_cas12a_cpf1.oo";

pub fn main() {
    let crispr_cas12a_cpf1_mark: Int = 0;
    if crispr_cas12a_cpf1_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cas12a_is_pam("x");
    let b: Bool = cas12a_is_pam("x");
    if a != b {
        println("FAIL cas12a_is_pam");
        process_exit(1);
    }
    println("prod_crispr_cas12a_cpf1: PASSED");
}
