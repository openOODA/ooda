// # Product prove std/defi_derivatives/implied_volatility_newton_raphson.oo
//
// Logline: Fail-closed emit+gcc+run asserts iv_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/implied_volatility_newton_raphson.oo.
//
// Beats:
//   1. Call iv_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_implied_volatility_newton_raphson: PASSED only if they match.

import "std/defi_derivatives/implied_volatility_newton_raphson.oo";

pub fn main() {
    let implied_volatility_newton_raphson_mark: Int = 0;
    if implied_volatility_newton_raphson_mark != 0 {
        process_exit(1);
    }
    let a: Float = iv_norm_pdf(0.0);
    let b: Float = iv_norm_pdf(0.0);
    if a != b {
        println("FAIL iv_norm_pdf");
        process_exit(1);
    }
    println("prod_implied_volatility_newton_raphson: PASSED");
}
