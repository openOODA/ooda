// # Product prove std/web_protocols/webrtc_ice_candidate.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_protocols/webrtc_ice_candidate.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/webrtc_ice_candidate.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_webrtc_ice_candidate: PASSED only if they match.

import "std/web_protocols/webrtc_ice_candidate.oo";

pub fn main() {
    let webrtc_ice_candidate_a = ice_candidate_compute_priority(0, 0, 0);
    let webrtc_ice_candidate_b = ice_candidate_compute_priority(0, 0, 0);
    if webrtc_ice_candidate_a != webrtc_ice_candidate_b {
        println("FAIL webrtc_ice_candidate");
        process_exit(1);
    }
    println("prod_ap_webrtc_ice_candidate: PASSED");
}
