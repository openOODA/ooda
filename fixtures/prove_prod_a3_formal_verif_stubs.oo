// # Product prove std/formal_verif/formal_verif_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts formal_verif_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/formal_verif_stubs.oo.
//
// Beats:
//   1. Call formal_verif_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_formal_verif_stubs: PASSED only if they match.

import "std/formal_verif/formal_verif_stubs.oo";

pub fn main() {
    let formal_verif_stubs_mark: Int = 0;
    if formal_verif_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = formal_verif_fail_closed("x", 0);
    let b: Bool = formal_verif_fail_closed("x", 0);
    if a != b {
        println("FAIL formal_verif_fail_closed");
        process_exit(1);
    }
    println("prod_formal_verif_stubs: PASSED");
}
