// # Product prove std/graph_gnn/graph_pos_enc_random_walk.oo
//
// Logline: Fail-closed verification that random walk positional encoding transformation is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_pos_enc_random_walk.oo.
//
// Beats:
//   1. Construct RWPEConfig and initialize projection weights with deterministic seed.
//   2. Run rwpe_transform_node on sample random walk landing probabilities.
//   3. Assert deterministic return values.
//   4. Print prod_g4_graph_random_walk: PASSED only if all match.

import "std/graph_gnn/graph_pos_enc_random_walk.oo";

pub fn main() {
    let cfg1: RWPEConfig = rwpe_config_new(4, 2);
    let cfg2: RWPEConfig = rwpe_config_new(4, 2);
    if cfg1.k_steps != cfg2.k_steps {
        println("FAIL rwpe_config_new k_steps");
        process_exit(1);
    }
    if cfg1.out_dim != cfg2.out_dim {
        println("FAIL rwpe_config_new out_dim");
        process_exit(1);
    }

    // 4 * 2 = 8 weights
    let w1: List[Int] = rwpe_init_weights(8, 44);
    let w2: List[Int] = rwpe_init_weights(8, 44);

    let mut b1: List[Int] = list_new();
    b1 = list_push(b1, 2);
    b1 = list_push(b1, 4);
    let mut b2: List[Int] = list_new();
    b2 = list_push(b2, 2);
    b2 = list_push(b2, 4);

    let mut probs1: List[Int] = list_new();
    probs1 = list_push(probs1, 100);
    probs1 = list_push(probs1, 50);
    probs1 = list_push(probs1, 25);
    probs1 = list_push(probs1, 12);

    let mut probs2: List[Int] = list_new();
    probs2 = list_push(probs2, 100);
    probs2 = list_push(probs2, 50);
    probs2 = list_push(probs2, 25);
    probs2 = list_push(probs2, 12);

    let out1: List[Int] = rwpe_transform_node(cfg1, w1, b1, probs1);
    let out2: List[Int] = rwpe_transform_node(cfg2, w2, b2, probs2);

    let len1: Int = list_len(out1);
    let len2: Int = list_len(out2);
    if len1 != len2 {
        println("FAIL rwpe_transform_node length mismatch");
        process_exit(1);
    }
    if len1 != 2 {
        println("FAIL rwpe_transform_node length expected");
        process_exit(1);
    }

    let o0_1: Int = list_get(out1, 0);
    let o0_2: Int = list_get(out2, 0);
    if o0_1 != o0_2 {
        println("FAIL rwpe o0");
        process_exit(1);
    }

    let o1_1: Int = list_get(out1, 1);
    let o1_2: Int = list_get(out2, 1);
    if o1_1 != o1_2 {
        println("FAIL rwpe o1");
        process_exit(1);
    }

    println("prod_g4_graph_random_walk: PASSED");
    process_exit(0);
}
