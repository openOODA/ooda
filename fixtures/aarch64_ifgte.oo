// # Const INT>=INT if print
//
// Logline: Print GE from if 2>=1, EQ from if 1>=1, and LT from the else of if 1>=2.
//
// Setup: Side emit-aarch64 folds INT GTE INT only when LBRACE follows.
//
// Beats:
//   1. if 2 >= 1 print GE.
//   2. if 1 >= 1 print EQ.
//   3. if 1 >= 2 else print LT.

pub fn main() {
    if 2 >= 1 {
        println("GE");
    }
    if 1 >= 1 {
        println("EQ");
    }
    if 1 >= 2 {
        println("BAD");
    } else {
        println("LT");
    }
}
