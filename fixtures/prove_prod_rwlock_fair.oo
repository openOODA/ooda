// # Product prove std/sync/rwlock_fair.oo
//
// Logline: Fail-closed emit+gcc+run asserts fair_rwlock_active_readers is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/rwlock_fair.oo.
//
// Beats:
//   1. Call fair_rwlock_active_readers twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rwlock_fair: PASSED only if they match.

import "std/sync/rwlock_fair.oo";

pub fn main() {
    let obj = fair_rwlock_new();
    let a = fair_rwlock_active_readers(obj);
    let b = fair_rwlock_active_readers(obj);
    if a != b {
        println("FAIL fair_rwlock_active_readers");
        process_exit(1);
    }
    println("prod_rwlock_fair: PASSED");
}
