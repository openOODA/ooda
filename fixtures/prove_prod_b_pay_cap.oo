// # Product prove std/net/pay_cap.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_cap_required_header_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/pay_cap.oo.
//
// Beats:
//   1. Call pay_cap_required_header_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pay_cap: PASSED only if they match.

import "std/net/pay_cap.oo";

pub fn main() {
    let a = pay_cap_required_header_name();
    let b = pay_cap_required_header_name();
    if a != b {
        println("FAIL pay_cap_required_header_name");
        process_exit(1);
    }
    println("prod_pay_cap: PASSED");
}
