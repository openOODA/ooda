// # Product prove std/gis_topo/geojson_feature_collection.oo
//
// Logline: Fail-closed emit+gcc+run asserts geojson_feature_collection_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geojson_feature_collection.oo.
//
// Beats:
//   1. Call geojson_feature_collection_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geojson_feature_collection: PASSED only if they match.

import "std/gis_topo/geojson_feature_collection.oo";

pub fn main() {
    let geojson_feature_collection_mark: Int = 0;
    if geojson_feature_collection_mark != 0 {
        process_exit(1);
    }
    let geojson_feature_collection_a = geojson_feature_collection_new();
    let geojson_feature_collection_b = geojson_feature_collection_new();
    if (geojson_feature_collection_a).num_features != (geojson_feature_collection_b).num_features {
        println("FAIL geojson_feature_collection_new");
        process_exit(1);
    }
    println("prod_geojson_feature_collection: PASSED");
}
