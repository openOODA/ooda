//
// Setup: Isolated emit-c. Imports std/robotics_auv/robotics_auv_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call auv_hal_thruster_pwm_write_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_robotics_auv_stubs: PASSED only if they match.

import "std/robotics_auv/robotics_auv_stubs.oo";

pub fn main() {
    let g2_a = auv_hal_thruster_pwm_write_stub(2, 1.0, true);
    let g2_b = auv_hal_thruster_pwm_write_stub(2, 1.0, true);
    if g2_a != g2_b {
        println("FAIL auv_hal_thruster_pwm_write_stub");
        process_exit(1);
    }
    println("prod_g2_robotics_auv_stubs: PASSED");
