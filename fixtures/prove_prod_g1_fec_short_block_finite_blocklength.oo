// # Product prove std/telecom_6g/fec_short_block_finite_blocklength.oo
//
// Logline: Fail-closed emit+gcc+run asserts fbl_config_urllc_critical is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/fec_short_block_finite_blocklength.oo.
//
// Beats:
//   1. Call fbl_config_urllc_critical twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fec_short_block_finite_blocklength: PASSED only if they match.

import "std/telecom_6g/fec_short_block_finite_blocklength.oo";

pub fn main() {
    let a: FiniteBlocklengthConfig = fbl_config_urllc_critical();
    let b: FiniteBlocklengthConfig = fbl_config_urllc_critical();
    if a.blocklength_symbols_n != b.blocklength_symbols_n {
        println("FAIL fbl_config_urllc_critical");
        process_exit(1);
    }
    println("prod_fec_short_block_finite_blocklength: PASSED");
}
