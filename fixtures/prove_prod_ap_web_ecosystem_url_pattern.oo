// # Product prove std/web_ecosystem/url_pattern.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/url_pattern.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/url_pattern.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_url_pattern: PASSED only if they match.

import "std/web_ecosystem/url_pattern.oo";

pub fn main() {
    let url_pattern_a = url_scheme_http();
    let url_pattern_b = url_scheme_http();
    if url_pattern_a != url_pattern_b {
        println("FAIL url_pattern");
        process_exit(1);
    }
    println("prod_ap_url_pattern: PASSED");
}
