// # Product prove std/sec/sys/aslr_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_config_entropy is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_types.oo.
//
// Beats:
//   1. Call aslr_config_entropy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aslr_types: PASSED only if they match.

import "std/sec/sys/aslr_types.oo";

pub fn main() {
    let obj = aslr_config_new(0);
    let a = aslr_config_entropy(obj);
    let b = aslr_config_entropy(obj);
    if a != b {
        println("FAIL aslr_config_entropy");
        process_exit(1);
    }
    println("prod_aslr_types: PASSED");
}
