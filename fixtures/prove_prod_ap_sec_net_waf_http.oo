// # Product prove std/sec/net/waf_http.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_http_ready is 1.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_http.oo.
//
// Beats:
//   1. waf_http_ready() is 1.
//   2. Exit 1 on miss. Print prod_ap_waf_http: PASSED only if it holds.

import "std/sec/net/waf_http.oo";

pub fn main() {
    let waf_http_a = waf_http_ready();
    if waf_http_a != 1 {
        println("FAIL waf_http");
        process_exit(1);
    }
    println("prod_ap_waf_http: PASSED");
}
