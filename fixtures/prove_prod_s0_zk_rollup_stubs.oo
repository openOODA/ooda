// # Product prove std/zk_rollup/zk_rollup_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts zk_rollup_fail_closed value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/zk_rollup_stubs.oo.
//
// Beats:
//   1. Call zk_rollup_fail_closed twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_zk_rollup_stubs: PASSED only if asserts hold.

import "std/zk_rollup/zk_rollup_stubs.oo";

pub fn main() {
    let zk_rollup_stubs_a: Bool = zk_rollup_fail_closed("x", 0);
    let zk_rollup_stubs_b: Bool = zk_rollup_fail_closed("x", 0);
    if zk_rollup_stubs_a != zk_rollup_stubs_b {
        println("FAIL zk_rollup_fail_closed");
        process_exit(1);
    }
    println("prod_zk_rollup_stubs: PASSED");
}
