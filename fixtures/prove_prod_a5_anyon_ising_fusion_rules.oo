// # Product prove std/quantum_topological/anyon_ising_fusion_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts ising_fusion_space_dim_sigma_pairs is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_ising_fusion_rules.oo.
//
// Beats:
//   1. Call ising_fusion_space_dim_sigma_pairs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anyon_ising_fusion_rules: PASSED only if they match.

import "std/quantum_topological/anyon_ising_fusion_rules.oo";

pub fn main() {
    let anyon_ising_fusion_rules_mark: Int = 0;
    if anyon_ising_fusion_rules_mark != 0 {
        process_exit(1);
    }
    let a: Int = ising_fusion_space_dim_sigma_pairs(0);
    let b: Int = ising_fusion_space_dim_sigma_pairs(0);
    if a != b {
        println("FAIL ising_fusion_space_dim_sigma_pairs");
        process_exit(1);
    }
    println("prod_anyon_ising_fusion_rules: PASSED");
}
