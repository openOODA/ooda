// # Product prove std/aero/attitude_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts att_op_roll is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call att_op_roll twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_attitude_ops: PASSED only if they match.

import "std/aero/attitude_ops.oo";

pub fn main() {
    let g0_oa = att_op_new(2, 2);
    let g0_ob = att_op_new(2, 2);
    let g0_a = att_op_roll(g0_oa);
    let g0_b = att_op_roll(g0_ob);
    if g0_a != g0_b {
        println("FAIL att_op_roll");
        process_exit(1);
    }
    println("prod_g0_attitude_ops: PASSED");
}
