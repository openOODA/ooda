// # Product prove std/tda_topology/tda_kernel_machine_learning.oo
//
// Logline: Fail-closed emit+gcc+run asserts tda_sliced_wasserstein_kernel_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/tda_kernel_machine_learning.oo.
//
// Beats:
//   1. Call tda_sliced_wasserstein_kernel_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tda_kernel_machine_learning: PASSED only if they match.

import "std/tda_topology/tda_kernel_machine_learning.oo";

pub fn main() {
    let tda_kernel_machine_learning_mark: Int = 0;
    if tda_kernel_machine_learning_mark != 0 {
        process_exit(1);
    }
    let tda_kernel_machine_learning_a: Float = tda_sliced_wasserstein_kernel_eval(1.0, 1.0);
    let tda_kernel_machine_learning_b: Float = tda_sliced_wasserstein_kernel_eval(1.0, 1.0);
    if tda_kernel_machine_learning_a != tda_kernel_machine_learning_b {
        println("FAIL tda_sliced_wasserstein_kernel_eval");
        process_exit(1);
    }
    println("prod_tda_kernel_machine_learning: PASSED");
}
