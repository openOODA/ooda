// # Product prove std/compilers_vm/ssa_phi_placement.oo
//
// Logline: Fail-closed verification that SSA phi node placement data structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_phi_placement.oo.
//
// Beats:
//   1. Construct PhiOperand and query fields deterministically.
//   2. Construct PhiNode, append operands, and verify count.
//   3. Initialize BlockPhiSet and SsaPhiPlacementResult.
//   4. Print prod_g4_compilers_ssa_phi: PASSED and exit 0.

import "std/compilers_vm/ssa_phi_placement.oo";

pub fn main() {
    let op1: PhiOperand = phi_operand_new(0, "v0", 1);
    let op2: PhiOperand = phi_operand_new(0, "v0", 1);

    let b1: Int = phi_operand_block(op1);
    let b2: Int = phi_operand_block(op2);
    if b1 != b2 || b1 != 0 {
        println("FAIL phi_operand_block");
        process_exit(1);
    }

    let n1: String = phi_operand_name(op1);
    let n2: String = phi_operand_name(op2);
    if n1 != n2 || n1 != "v0" {
        println("FAIL phi_operand_name");
        process_exit(1);
    }

    let v1: Int = phi_operand_version(op1);
    let v2: Int = phi_operand_version(op2);
    if v1 != v2 || v1 != 1 {
        println("FAIL phi_operand_version");
        process_exit(1);
    }

    let node1: PhiNode = phi_node_new("x", 2);
    let node2: PhiNode = phi_node_new("x", 2);

    let node1_with_op: PhiNode = phi_node_add_operand(node1, op1);
    let node2_with_op: PhiNode = phi_node_add_operand(node2, op2);

    let cnt1: Int = phi_node_count(node1_with_op);
    let cnt2: Int = phi_node_count(node2_with_op);
    if cnt1 != cnt2 || cnt1 != 1 {
        println("FAIL phi_node_count");
        process_exit(1);
    }

    let res1: SsaPhiPlacementResult = ssa_phi_placement_result_new(4);
    let res2: SsaPhiPlacementResult = ssa_phi_placement_result_new(4);
    let blk_cnt1: Int = ssa_phi_result_block_count(res1);
    let blk_cnt2: Int = ssa_phi_result_block_count(res2);
    if blk_cnt1 != blk_cnt2 || blk_cnt1 != 4 {
        println("FAIL ssa_phi_result_block_count");
        process_exit(1);
    }

    println("prod_g4_compilers_ssa_phi: PASSED");
    process_exit(0);
}
