// # Product prove std/simd/simd_matrix4x4.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_mat4_trace is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_matrix4x4.oo.
//
// Beats:
//   1. Call simd_mat4_trace twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_matrix4x4: PASSED only if they match.

import "std/simd/simd_matrix4x4.oo";

pub fn main() {
    let obj = simd_mat4_zero();
    let a = simd_mat4_trace(obj);
    let b = simd_mat4_trace(obj);
    if a != b {
        println("FAIL simd_mat4_trace");
        process_exit(1);
    }
    println("prod_simd_matrix4x4: PASSED");
}
