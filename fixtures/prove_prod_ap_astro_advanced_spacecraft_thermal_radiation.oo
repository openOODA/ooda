// # Product prove std/astro_advanced/spacecraft_thermal_radiation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/spacecraft_thermal_radiation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/spacecraft_thermal_radiation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_spacecraft_thermal_radiation: PASSED only if they match.

import "std/astro_advanced/spacecraft_thermal_radiation.oo";

pub fn main() {
    let spacecraft_thermal_radiation_a = thermal_eps_milli();
    let spacecraft_thermal_radiation_b = thermal_eps_milli();
    if spacecraft_thermal_radiation_a != spacecraft_thermal_radiation_b {
        println("FAIL spacecraft_thermal_radiation");
        process_exit(1);
    }
    println("prod_ap_spacecraft_thermal_radiation: PASSED");
}
