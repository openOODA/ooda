// # Granted dlopen check
//
// Logline: Allow dlopen at check when &UnsafeFFICap is granted.
//
// Beats:
//   1. Take &UnsafeFFICap on ok.
//   2. Call dlopen(ffi, "libx.so").
//   3. Leave main empty so this is check only.

// Cap vs FFI path A: dlopen allowed when &UnsafeFFICap granted (check only)
pub fn ok(ffi: &UnsafeFFICap) {
    let r = dlopen(ffi, "libx.so");
}
pub fn main() {}
