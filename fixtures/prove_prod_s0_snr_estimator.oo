// # Product prove std/telecom/snr_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts snr_ln_approx value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom/snr_estimator.oo.
//
// Beats:
//   1. Call snr_ln_approx twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_snr_estimator: PASSED only if asserts hold.

import "std/telecom/snr_estimator.oo";

pub fn main() {
    let snr_estimator_a: Float = snr_ln_approx(0.0);
    let snr_estimator_b: Float = snr_ln_approx(0.0);
    if snr_estimator_a != snr_estimator_b {
        println("FAIL snr_ln_approx");
        process_exit(1);
    }
    println("prod_snr_estimator: PASSED");
}
