// # Product prove std/grid/microgrid_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/microgrid_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_microgrid_ops: PASSED only if they match.

import "std/grid/microgrid_ops.oo";

pub fn main() {
    let microgrid_ops_a = microgrid_abs(0.0);
    let microgrid_ops_b = microgrid_abs(0.0);
    if microgrid_ops_a != microgrid_ops_b {
        println("FAIL microgrid_ops");
        process_exit(1);
    }
    println("prod_ap_microgrid_ops: PASSED");
}
