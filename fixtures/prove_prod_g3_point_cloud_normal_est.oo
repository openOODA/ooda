// # Product prove std/gis_topo/point_cloud_normal_est.oo
//
// Logline: Fail-closed emit+gcc+run asserts point_normal_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/point_cloud_normal_est.oo.
//
// Beats:
//   1. Call point_normal_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_point_cloud_normal_est: PASSED only if they match.

import "std/gis_topo/point_cloud_normal_est.oo";

pub fn main() {
    let point_cloud_normal_est_mark: Int = 0;
    if point_cloud_normal_est_mark != 0 {
        process_exit(1);
    }
    let a: PointNormal3D = point_normal_new(0.0, 0.0, 0.0);
    let b: PointNormal3D = point_normal_new(0.0, 0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL point_normal_new");
        process_exit(1);
    }
    println("prod_point_cloud_normal_est: PASSED");
}
