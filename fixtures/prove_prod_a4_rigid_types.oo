// # Product prove std/physics/rigid_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts rigid_body_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/rigid_types.oo.
//
// Beats:
//   1. Call rigid_body_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rigid_types: PASSED only if they match.

import "std/physics/rigid_types.oo";

pub fn main() {
    let rigid_types_mark: Int = 0;
    if rigid_types_mark != 0 {
        process_exit(1);
    }
    let a: RigidBody = rigid_body_new(0, 0);
    let b: RigidBody = rigid_body_new(0, 0);
    if (a).mass != (b).mass {
        println("FAIL rigid_body_new");
        process_exit(1);
    }
    println("prod_rigid_types: PASSED");
}
