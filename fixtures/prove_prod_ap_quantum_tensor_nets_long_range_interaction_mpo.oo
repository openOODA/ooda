//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/long_range_interaction_mpo.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_long_range_interaction_mpo: PASSED only if they match.

import "std/quantum_tensor_nets/long_range_interaction_mpo.oo";

pub fn main() {
    let long_range_interaction_mpo_a = power_law_mpo_bond_dimension(0);
    let long_range_interaction_mpo_b = power_law_mpo_bond_dimension(0);
    if long_range_interaction_mpo_a != long_range_interaction_mpo_b {
        println("FAIL long_range_interaction_mpo");
        process_exit(1);
    }
    println("prod_ap_long_range_interaction_mpo: PASSED");
