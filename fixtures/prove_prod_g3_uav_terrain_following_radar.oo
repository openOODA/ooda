// # Product prove std/uav_flight/uav_terrain_following_radar.oo
//
// Logline: Fail-closed emit+gcc+run asserts terrain_following_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_terrain_following_radar.oo.
//
// Beats:
//   1. Call terrain_following_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_terrain_following_radar: PASSED only if they match.

import "std/uav_flight/uav_terrain_following_radar.oo";

pub fn main() {
    let uav_terrain_following_radar_mark: Int = 0;
    if uav_terrain_following_radar_mark != 0 {
        process_exit(1);
    }
    let a: TerrainFollowingConfig = terrain_following_config_default();
    let b: TerrainFollowingConfig = terrain_following_config_default();
    if (a).target_agl_clearance_mm != (b).target_agl_clearance_mm {
        println("FAIL terrain_following_config_default");
        process_exit(1);
    }
    println("prod_uav_terrain_following_radar: PASSED");
}
