// # Product prove std/synthetic_biology/dna_origami_molecular_assembly.oo
//
// Logline: Fail-closed emit+gcc+run asserts origami_calc_staple_tm is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/dna_origami_molecular_assembly.oo.
//
// Beats:
//   1. Call origami_calc_staple_tm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_origami_calc_tm: PASSED only if they match.

import "std/synthetic_biology/dna_origami_molecular_assembly.oo";

pub fn main() {
    let dna_origami_molecular_assembly_mark: Int = 0;
    if dna_origami_molecular_assembly_mark != 0 { process_exit(1); }
    let a: Float = origami_calc_staple_tm(20, 0.5, 12.0);
    let b: Float = origami_calc_staple_tm(20, 0.5, 12.0);
    if a != b {
        println("FAIL origami_calc_staple_tm");
        process_exit(1);
    }
    println("prod_origami_calc_tm: PASSED");
}
