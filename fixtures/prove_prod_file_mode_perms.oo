// # Product prove std/os/file_mode_perms.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_mode_has_owner_read is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/file_mode_perms.oo.
//
// Beats:
//   1. Call file_mode_has_owner_read twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_mode_perms: PASSED only if they match.

import "std/os/file_mode_perms.oo";

pub fn main() {
    let a = file_mode_has_owner_read(0);
    let b = file_mode_has_owner_read(0);
    if a != b {
        println("FAIL file_mode_has_owner_read");
        process_exit(1);
    }
    println("prod_file_mode_perms: PASSED");
}
