// # Product Q32.32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped q32_from_int/add/to_int.
//
// Setup: Product std/math/fixed_point_q32_32.oo. Scale 2^32.
//
// Beats:
//   1. 2+3 is 5.
//   2. Exit 1 before PASSED on a miss.

import "std/math/fixed_point_q32_32.oo";

pub fn main() {
    let a: Q32 = q32_from_int(2);
    let b: Q32 = q32_from_int(3);
    let s: Q32 = q32_add(a, b);
    let si: Int = q32_to_int(s);
    if si != 5 {
        println("FAIL q32 add");
        process_exit(1);
    }
    println("prod_q32: PASSED");
}
