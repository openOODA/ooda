// # Product prove std/robotics_auv/auv_backstepping_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts backstepping_gains_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_backstepping_controller.oo.
//
// Beats:
//   1. Call backstepping_gains_default using the auv_backstepping_controller ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_backstepping_controller: PASSED only if asserts hold.

import "std/robotics_auv/auv_backstepping_controller.oo";

pub fn main() {
    let obj = backstepping_gains_default();
    let auv_backstepping_controller_a = obj.k1_pos;
    if auv_backstepping_controller_a != 0.5 {
        println("FAIL backstepping_gains_default");
        process_exit(1);
    }
    println("prod_auv_backstepping_controller: PASSED");
}
