// # Product sync rwlock prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/rwlock.oo.
//
// Setup: Product std/sync/rwlock.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New reader count 0 not write locked.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/rwlock.oo";

pub fn main() {
    let l: RwLock = rwlock_new(1, "x");
    let n: Int = rwlock_reader_count(l);
    if n != 0 {
        println("FAIL rwlock readers");
        process_exit(1);
    }
    if rwlock_is_write_locked(l) {
        println("FAIL rwlock write");
        process_exit(1);
    }
    println("prod_rwlockc: PASSED");
}
