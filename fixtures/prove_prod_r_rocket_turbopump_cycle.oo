// # Product prove std/space_propulsion/rocket_turbopump_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbopump_spec_default_ffsc value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_turbopump_cycle.oo.
//
// Beats:
//   1. Call turbopump_spec_default_ffsc twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rocket_turbopump_cycle: PASSED only if asserts hold.

import "std/space_propulsion/rocket_turbopump_cycle.oo";

pub fn main() {
    let rocket_turbopump_cycle: TurbopumpSpec = turbopump_spec_default_ffsc();
    let rocket_turbopump_cycle_b: TurbopumpSpec = turbopump_spec_default_ffsc();
    if (rocket_turbopump_cycle).cycle_type != 2 {
        println("FAIL turbopump_spec_default_ffsc cycle_type");
        process_exit(1);
    }
    if (rocket_turbopump_cycle).cycle_type != (rocket_turbopump_cycle_b).cycle_type {
        println("FAIL turbopump_spec_default_ffsc det");
        process_exit(1);
    }
    println("prod_rocket_turbopump_cycle: PASSED");
}
