// # Product prove std/sec/landlock.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_is_supported is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/landlock.oo.
//
// Beats:
//   1. Call landlock_is_supported twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_landlock: PASSED only if they match.

import "std/sec/landlock.oo";

pub fn main() {
    let a: Bool = landlock_is_supported();
    let b: Bool = landlock_is_supported();
    if a != b {
        println("FAIL landlock_is_supported");
        process_exit(1);
    }
    println("prod_g2_landlock: PASSED");
}
