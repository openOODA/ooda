// # if 1 <= x is leftover
//
// Logline: INT LTE IDENT must fail closed and not emit YES.
//
// Setup: x is a bind, not a const INT cond rhs. Sibling of locked INT<IDENT.
//
// Beats:
//   1. Bind x to 2.
//   2. if 1 <= x print YES.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = 2;
    if 1 <= x {
        println("YES");
    }
}
