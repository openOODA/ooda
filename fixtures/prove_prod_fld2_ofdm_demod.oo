// # Product prove std/telecom/ofdm_demod.oo
//
// Logline: Fail-closed emit+gcc+run asserts ofdm_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/ofdm_demod.oo.
//
// Beats:
//   1. Call ofdm_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ofdm_demod: PASSED only if they match.

import "std/telecom/ofdm_demod.oo";

pub fn main() {
    let ofdm_demod_mark: Int = 0;
    if ofdm_demod_mark != 0 {
        process_exit(1);
    }
    let ofdm_demod_a: Float = ofdm_int_to_float(1);
    let ofdm_demod_b: Float = ofdm_int_to_float(1);
    if ofdm_demod_a != ofdm_demod_b {
        println("FAIL ofdm_int_to_float");
        process_exit(1);
    }
    println("prod_ofdm_demod: PASSED");
}
