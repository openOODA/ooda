// # Product prove std/swarm/dispatch_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts dispatcher_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch_types.oo.
//
// Beats:
//   1. Call dispatcher_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dispatch_types: PASSED only if they match.

import "std/swarm/dispatch_types.oo";

pub fn main() {
    let dispatch_types_mark: Int = 0;
    if dispatch_types_mark != 0 {
        process_exit(1);
    }
    let dispatch_types_a = dispatcher_config_new(1, 1);
    let dispatch_types_b = dispatcher_config_new(1, 1);
    if (dispatch_types_a).strategy != (dispatch_types_b).strategy {
        println("FAIL dispatcher_config_new");
        process_exit(1);
    }
    println("prod_dispatch_types: PASSED");
}
