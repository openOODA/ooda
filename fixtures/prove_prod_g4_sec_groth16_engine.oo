// # Product prove std/sec/crypto/groth16_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/groth16_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_engine.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_groth16_engine: PASSED and exit 0 only on match.

import "std/sec/crypto/groth16_engine.oo";

pub fn main() {
    let mut ic_x: List[String] = list_new();
    ic_x = list_push(ic_x, "1");
    ic_x = list_push(ic_x, "2");

    let mut ic_y: List[String] = list_new();
    ic_y = list_push(ic_y, "3");
    ic_y = list_push(ic_y, "4");

    let vk: Groth16Vk = groth16_vk_create(
        "vk_1", 1, 1,
        "ax", "ay",
        "bx0", "bx1", "by0", "by1",
        "gx0", "gx1", "gy0", "gy1",
        "dx0", "dx1", "dy0", "dy1",
        ic_x, ic_y
    );

    let verifier_a: Groth16Verifier = groth16_verifier_init("ver_1", vk, true);
    let verifier_b: Groth16Verifier = groth16_verifier_init("ver_1", vk, true);
    if (verifier_a).is_active != (verifier_b).is_active || !(verifier_a).is_active {
        println("FAIL groth16_engine verifier_init");
        process_exit(1);
    }

    let mut in_vals: List[String] = list_new();
    in_vals = list_push(in_vals, "42");
    let inputs: PublicInputs = public_inputs_create("inp_1", in_vals);

    let match_a: Bool = groth16_verify_input_match(&vk, &inputs);
    let match_b: Bool = groth16_verify_input_match(&vk, &inputs);
    if !match_a || !match_b {
        println("FAIL groth16_engine verify_input_match");
        process_exit(1);
    }

    let proof: Groth16Proof = groth16_proof_create(
        "p_1", 1,
        "ax", "ay",
        "bx0", "bx1", "by0", "by1",
        "cx", "cy",
        false
    );

    let mut ver_mut: Groth16Verifier = groth16_verifier_init("ver_mut", vk, true);
    let res_a: Groth16VerificationResult = groth16_verifier_verify_structural(&mut ver_mut, &proof, &inputs);
    if !(res_a).is_valid || !(res_a).pairing_satisfied {
        println("FAIL groth16_engine verify_structural");
        process_exit(1);
    }

    let work_a: Int = groth16_do_work(&ver_mut);
    let work_b: Int = groth16_do_work(&ver_mut);
    if work_a != work_b || work_a != 4 {
        println("FAIL groth16_engine do_work");
        process_exit(1);
    }

    let mut batch: Groth16BatchVerifier = groth16_batch_verifier_init("batch_1");
    let add_ok: Bool = groth16_batch_verifier_add(&mut batch, proof, inputs);
    if !add_ok || (batch).batch_size != 1 {
        println("FAIL groth16_engine batch_verifier_add");
        process_exit(1);
    }

    groth16_batch_verifier_clear(&mut batch);
    if (batch).batch_size != 0 {
        println("FAIL groth16_engine batch_verifier_clear");
        process_exit(1);
    }

    let setup_a: Groth16SetupParams = groth16_setup_params_init("circuit_1", 1, 100, 50, 1);
    let setup_b: Groth16SetupParams = groth16_setup_params_init("circuit_1", 1, 100, 50, 1);
    if !(setup_a).is_trusted_setup_complete || !(setup_b).is_trusted_setup_complete {
        println("FAIL groth16_engine setup_params_init");
        process_exit(1);
    }

    println("prod_g4_sec_groth16_engine: PASSED");
    process_exit(0);
}
