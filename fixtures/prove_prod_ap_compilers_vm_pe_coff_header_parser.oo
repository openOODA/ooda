// # Product prove std/compilers_vm/pe_coff_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/pe_coff_header_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/pe_coff_header_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pe_coff_header_parser: PASSED only if they match.

import "std/compilers_vm/pe_coff_header_parser.oo";

pub fn main() {
    let pe_coff_header_parser_a = pe_machine_amd64();
    let pe_coff_header_parser_b = pe_machine_amd64();
    if pe_coff_header_parser_a != pe_coff_header_parser_b {
        println("FAIL pe_coff_header_parser");
        process_exit(1);
    }
    println("prod_ap_pe_coff_header_parser: PASSED");
}
