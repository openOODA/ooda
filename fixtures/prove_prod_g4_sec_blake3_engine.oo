// # Product prove std/sec/crypto/blake3_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/blake3_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/blake3_engine.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_blake3_engine: PASSED and exit 0 only on match.

import "std/sec/crypto/blake3_engine.oo";

pub fn main() {
    let blake3_engine_ts_a: Blake3TreeState = blake3_tree_state_init();
    let blake3_engine_ts_b: Blake3TreeState = blake3_tree_state_init();
    let valid_a: Bool = blake3_tree_state_validate(&blake3_engine_ts_a);
    let valid_b: Bool = blake3_tree_state_validate(&blake3_engine_ts_b);
    if valid_a != valid_b {
        println("FAIL blake3_engine tree state validate");
        process_exit(1);
    }

    let h_res_a: Result[Blake3Hasher, String] = blake3_hasher_new("hasher_1");
    let h_res_b: Result[Blake3Hasher, String] = blake3_hasher_new("hasher_1");
    if h_res_a.is_ok() != h_res_b.is_ok() {
        println("FAIL blake3_engine hasher new");
        process_exit(1);
    }

    let pol_a: Blake3SecurityPolicy = blake3_security_policy_default();
    let pol_b: Blake3SecurityPolicy = blake3_security_policy_default();
    if (pol_a).fail_closed != (pol_b).fail_closed {
        println("FAIL blake3_engine security policy");
        process_exit(1);
    }

    let xof_a: Blake3XofReader = blake3_xof_reader_init("xof_1");
    let xof_b: Blake3XofReader = blake3_xof_reader_init("xof_1");
    if (xof_a).is_active != (xof_b).is_active {
        println("FAIL blake3_engine xof reader");
        process_exit(1);
    }

    let eng_a: Result[Blake3Engine, String] = blake3_engine_init("eng_1");
    let eng_b: Result[Blake3Engine, String] = blake3_engine_init("eng_1");
    if eng_a.is_ok() != eng_b.is_ok() {
        println("FAIL blake3_engine init");
        process_exit(1);
    }

    println("prod_g4_sec_blake3_engine: PASSED");
    process_exit(0);
}
