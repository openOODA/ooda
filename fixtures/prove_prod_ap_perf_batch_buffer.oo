// # Product prove std/perf/batch_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/batch_buffer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/batch_buffer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_batch_buffer: PASSED only if they match.

import "std/perf/batch_buffer.oo";

pub fn main() {
    let batch_buffer_a = batch_buffer_create("x", 0, 0);
    let batch_buffer_b = batch_buffer_create("x", 0, 0);
    let batch_buffer_va = batch_buffer_should_flush(batch_buffer_a);
    let batch_buffer_vb = batch_buffer_should_flush(batch_buffer_b);
    if batch_buffer_va != batch_buffer_vb {
        println("FAIL batch_buffer");
        process_exit(1);
    }
    println("prod_ap_batch_buffer: PASSED");
}
