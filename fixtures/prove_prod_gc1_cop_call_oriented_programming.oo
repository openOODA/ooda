// # Product prove std/exploit_analysis/cop_call_oriented_programming.oo
//
// Logline: Fail-closed emit+gcc+run asserts cop_chain_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/cop_call_oriented_programming.oo.
//
// Beats:
//   1. Call cop_chain_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cop_call_oriented_programming: PASSED only if they match.

import "std/exploit_analysis/cop_call_oriented_programming.oo";

pub fn main() {
    let cop_call_oriented_programming_mark: Int = 0;
    if cop_call_oriented_programming_mark != 0 {
        process_exit(1);
    }
    let cop_call_oriented_programming_a = cop_chain_plan_new("x");
    let cop_call_oriented_programming_b = cop_chain_plan_new("x");
    if (cop_call_oriented_programming_a).total_calls != (cop_call_oriented_programming_b).total_calls {
        println("FAIL cop_chain_plan_new");
        process_exit(1);
    }
    println("prod_cop_call_oriented_programming: PASSED");
}
