// # String Result == refuse
//
// Logline: emit-llvm fail-closes == on Result[String] instead of icmp i64 on the aggregate.
//
// Setup: Backend-LLVM. Int Result == stays the typed lock.
//
// Beats:
//   1. Bind two Result[String] Ok values.
//   2. Compare them with ==.
//   3. Emit must print ERR llvm_emit.

pub fn main() {
    let a: Result[String] = Ok("x");
    let b: Result[String] = Ok("x");
    if a == b {
        println("pun");
    }
}
