// # Product prove std/grid/microgrid_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/microgrid_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_microgrid_engine: PASSED only if they match.

import "std/grid/microgrid_engine.oo";

pub fn main() {
    let microgrid_engine_a = microgrid_state_default();
    let microgrid_engine_b = microgrid_state_default();
    let microgrid_engine_va = microgrid_calculate_power_mismatch(microgrid_engine_a);
    let microgrid_engine_vb = microgrid_calculate_power_mismatch(microgrid_engine_b);
    if microgrid_engine_va != microgrid_engine_vb {
        println("FAIL microgrid_engine");
        process_exit(1);
    }
    println("prod_ap_microgrid_engine: PASSED");
}
