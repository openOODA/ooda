// # Product prove std/telecom_6g/ris_near_field_spherical_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_near_field_config_150ghz_1m is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_near_field_spherical_model.oo.
//
// Beats:
//   1. Call ris_near_field_config_150ghz_1m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ris_near_field_spherical_model: PASSED only if they match.

import "std/telecom_6g/ris_near_field_spherical_model.oo";

pub fn main() {
    let a: RisNearFieldConfig = ris_near_field_config_150ghz_1m();
    let b: RisNearFieldConfig = ris_near_field_config_150ghz_1m();
    if a.num_elements_x != b.num_elements_x {
        println("FAIL ris_near_field_config_150ghz_1m");
        process_exit(1);
    }
    println("prod_ris_near_field_spherical_model: PASSED");
}
