// # Product prove std/fhe_lattices/fhe_centered_binomial.oo
//
// Logline: Fail-closed emit+gcc+run asserts cbd_variance is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_centered_binomial.oo.
//
// Beats:
//   1. Call cbd_variance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_centered_binomial: PASSED only if they match.

import "std/fhe_lattices/fhe_centered_binomial.oo";

pub fn main() {
    let fhe_centered_binomial_mark: Int = 0;
    if fhe_centered_binomial_mark != 0 {
        process_exit(1);
    }
    let a: Float = cbd_variance(0);
    let b: Float = cbd_variance(0);
    if a != b {
        println("FAIL cbd_variance");
        process_exit(1);
    }
    println("prod_g2_fhe_centered_binomial: PASSED");
}
