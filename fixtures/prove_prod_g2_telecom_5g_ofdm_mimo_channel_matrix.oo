// # Product prove std/telecom_5g/ofdm_mimo_channel_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts ComplexScalar is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_mimo_channel_matrix.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ComplexScalar twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ofdm_mimo_channel_matrix: PASSED only if they match.

import "std/telecom_5g/ofdm_mimo_channel_matrix.oo";

pub fn main() {
    let g2_oa: ComplexScalar = ComplexScalar { re:1.0, im:1.0 };
    let g2_ob: ComplexScalar = ComplexScalar { re:1.0, im:1.0 };
    let g2_a = (g2_oa).re;
    let g2_b = (g2_ob).re;
    if g2_a != g2_b {
        println("FAIL ComplexScalar.re");
        process_exit(1);
    }
    println("prod_g2_ofdm_mimo_channel_matrix: PASSED");
}
