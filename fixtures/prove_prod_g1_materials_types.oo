// # Product prove std/3d/materials_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/materials_types.oo.
//
// Beats:
//   1. Call color_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_materials_types: PASSED only if they match.

import "std/3d/materials_types.oo";

pub fn main() {
    let a: Color = color_new(0, 0, 0, 0);
    let b: Color = color_new(0, 0, 0, 0);
    if a.r != b.r {
        println("FAIL color_new");
        process_exit(1);
    }
    println("prod_materials_types: PASSED");
}
