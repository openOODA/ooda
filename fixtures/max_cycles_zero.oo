// # Fail closed on zero MaxCycles
//
// Logline: A zero fuel cap refuses the loop instead of silently disabling the check.
//
// Beats:
//   1. Honor the line-start fuel directive with N equal to zero.
//   2. Attempt a three-step while that would need fuel.
//   3. Fail closed so zero is never a silent disable.

// M48 MaxCycles path A — zero N fail-closed (no silent disable)
// MAX_CYCLES: 0
pub fn main() {
    let mut i = 0;
    while i < 3 {
        i = i + 1;
    }
    println(i);
}
