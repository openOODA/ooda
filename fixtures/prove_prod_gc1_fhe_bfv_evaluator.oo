// # Product prove std/fhe_lattices/fhe_bfv_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_tensor_round_coeff is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bfv_evaluator.oo.
//
// Beats:
//   1. Call bfv_tensor_round_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_bfv_evaluator: PASSED only if they match.

import "std/fhe_lattices/fhe_bfv_evaluator.oo";

pub fn main() {
    let fhe_bfv_evaluator_mark: Int = 0;
    if fhe_bfv_evaluator_mark != 0 {
        process_exit(1);
    }
    let fhe_bfv_evaluator_a: Int = bfv_tensor_round_coeff(1, 1, 1);
    let fhe_bfv_evaluator_b: Int = bfv_tensor_round_coeff(1, 1, 1);
    if fhe_bfv_evaluator_a != fhe_bfv_evaluator_b {
        println("FAIL bfv_tensor_round_coeff");
        process_exit(1);
    }
    println("prod_fhe_bfv_evaluator: PASSED");
}
