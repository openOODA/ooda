// # Product prove std/genomics_advanced/chip_seq_macs2_peak_caller.oo
//
// Logline: Fail-closed emit+gcc+run asserts chip_seq_macs2_peak_caller_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/chip_seq_macs2_peak_caller.oo.
//
// Beats:
//   1. Call chip_seq_macs2_peak_caller_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chip_seq_macs2_peak_caller: PASSED only if they match.

import "std/genomics_advanced/chip_seq_macs2_peak_caller.oo";

pub fn main() {
    let a = chip_seq_macs2_peak_caller_probe();
    let b = chip_seq_macs2_peak_caller_probe();
    if a != b {
        println("FAIL chip_seq_macs2_peak_caller_probe");
        process_exit(1);
    }
    println("prod_chip_seq_macs2_peak_caller: PASSED");
}
