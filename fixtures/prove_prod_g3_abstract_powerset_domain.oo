// # Product prove std/formal_verif/abstract_powerset_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts powerset_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_powerset_domain.oo.
//
// Beats:
//   1. Call powerset_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_abstract_powerset_domain: PASSED only if they match.

import "std/formal_verif/abstract_powerset_domain.oo";

pub fn main() {
    let abstract_powerset_domain_mark: Int = 0;
    if abstract_powerset_domain_mark != 0 {
        process_exit(1);
    }
    let a: PowersetDomain = powerset_empty();
    let b: PowersetDomain = powerset_empty();
    if (a).element_count != (b).element_count {
        println("FAIL powerset_empty");
        process_exit(1);
    }
    println("prod_abstract_powerset_domain: PASSED");
}
