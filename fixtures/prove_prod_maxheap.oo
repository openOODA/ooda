// # Product max_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped max_heap_push/len/contains.
//
// Setup: Product std/collections/max_heap.oo. Push 3 and 7.
//
// Beats:
//   1. After 3 and 7, len 2; contains 7 true; contains 1 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/max_heap.oo";

pub fn main() {
    let mut h: MaxHeap = max_heap_new();
    h = max_heap_push(h, 3);
    h = max_heap_push(h, 7);
    let n: Int = max_heap_len(h);
    if n != 2 {
        println("FAIL maxheap len");
        process_exit(1);
    }
    let c7: Bool = max_heap_contains(h, 7);
    if c7 == false {
        println("FAIL maxheap contains 7");
        process_exit(1);
    }
    let c1: Bool = max_heap_contains(h, 1);
    if c1 == true {
        println("FAIL maxheap contains 1");
        process_exit(1);
    }
    println("prod_maxheap: PASSED");
}
