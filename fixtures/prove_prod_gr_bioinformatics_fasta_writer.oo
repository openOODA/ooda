// # Product prove std/bioinformatics/fasta_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts fasta_format_header is a real value.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/fasta_writer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fasta_format_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fasta_writer: PASSED only if they match.

import "std/bioinformatics/fasta_writer.oo";

pub fn main() {
    let g0_a = fasta_format_header("x", "x", true);
    let g0_b = fasta_format_header("x", "x", true);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL fasta_format_header");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL fasta_format_header");
        process_exit(1);
    }
    println("prod_gr_fasta_writer: PASSED");
}
