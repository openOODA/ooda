// # Product prove std/graph_networks/core_periphery_detection.oo
//
// Logline: Fail-closed emit+gcc+run asserts cp_detect_structure is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/core_periphery_detection.oo.
//
// Beats:
//   1. Call cp_detect_structure twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_core_periphery_detection: PASSED only if they match.

import "std/graph_networks/core_periphery_detection.oo";

pub fn main() {
    let core_periphery_detection_mark: Int = 0;
    if core_periphery_detection_mark != 0 {
        process_exit(1);
    }
    let a: CorePeripheryResult = cp_detect_structure(0, list_new(), 0);
    let b: CorePeripheryResult = cp_detect_structure(0, list_new(), 0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL cp_detect_structure");
        process_exit(1);
    }
    println("prod_g2_core_periphery_detection: PASSED");
}
