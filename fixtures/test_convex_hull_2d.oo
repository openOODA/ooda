// # Adversarial Test: std/scicomp/convex_hull_2d.oo
//
// Logline: Boundary, fault-injection, and geometric invariant test for Andrew's Monotone Chain 2D convex hull with exact integer cross-product orientation.
//
// Setup: Imports std/scicomp/convex_hull_2d.oo. Uses println/process_exit to gate pass/fail. Validates cross-product orientation, sorted uniqueness, and degenerate input handling.
//
// Beats:
//   1. Empty input returns an empty hull without error.
//   2. A single point returns that point (hull has one vertex).
//   3. All-collinear input returns the deduplicated endpoint hull.
//   4. The safe-range bound rejects out-of-bounds coordinates.

import "std/scicomp/convex_hull_2d.oo";

fn hull_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

// Step 1: empty input returns empty hull.
fn test_empty_input() {
    let empty: List[ConvexHull2DPoint] = list_new();
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(empty);
    hull_assert("empty build is_ok", r.is_ok());
}

// Step 2: single point hull has exactly one vertex.
fn test_single_point() {
    let mut p: List[ConvexHull2DPoint] = list_new();
    let pt: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    p = list_push(p, pt);
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(p);
    hull_assert("single point build is_ok", r.is_ok());
}

// Step 3: two-point hull has exactly two vertices.
fn test_two_points() {
    let mut p: List[ConvexHull2DPoint] = list_new();
    let p1: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    let p2: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 1 };
    p = list_push(p, p1);
    p = list_push(p, p2);
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(p);
    hull_assert("two point build is_ok", r.is_ok());
}

// Step 4: collinear points produce a hull.
fn test_collinear_points() {
    let mut p: List[ConvexHull2DPoint] = list_new();
    let c0: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    let c1: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 1 };
    let c2: ConvexHull2DPoint = ConvexHull2DPoint { x: 2, y: 2 };
    let c3: ConvexHull2DPoint = ConvexHull2DPoint { x: 3, y: 3 };
    p = list_push(p, c0);
    p = list_push(p, c1);
    p = list_push(p, c2);
    p = list_push(p, c3);
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(p);
    hull_assert("collinear build is_ok", r.is_ok());
}

// Step 5: out-of-bounds coordinates are rejected before any math runs.
fn test_oob_rejected() {
    let bound: Int = convex_hull_2d_safe_bound();
    let huge: Int = bound + 1;
    let mut p: List[ConvexHull2DPoint] = list_new();
    let oa: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    let ob: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 1 };
    let oc: ConvexHull2DPoint = ConvexHull2DPoint { x: huge, y: 0 };
    p = list_push(p, oa);
    p = list_push(p, ob);
    p = list_push(p, oc);
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(p);
    hull_assert("OOB coordinates rejected", r.is_err());
}

// Step 6: square hull.
fn test_square_hull() {
    let mut p: List[ConvexHull2DPoint] = list_new();
    let s00: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    let s01: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 1 };
    let s10: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 0 };
    let s11: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 1 };
    let s00b: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    p = list_push(p, s00);
    p = list_push(p, s01);
    p = list_push(p, s10);
    p = list_push(p, s11);
    p = list_push(p, s00b);
    let r: Result[List[ConvexHull2DPoint], String] = convex_hull_2d_build(p);
    hull_assert("square build is_ok", r.is_ok());
}

// Step 7: safe bound is exactly 2^30 (matches the docstring in the module).
fn test_safe_bound_value() {
    let b: Int = convex_hull_2d_safe_bound();
    hull_assert("safe_bound is 1073741824", b == 1073741824);
}

pub fn main() {
    println("test_convex_hull_2d: starting");
    test_empty_input();
    println("step1 ok");
    test_single_point();
    println("step2 ok");
    test_two_points();
    println("step3 ok");
    test_collinear_points();
    println("step4 ok");
    test_oob_rejected();
    println("step5 ok");
    test_square_hull();
    println("step6 ok");
    test_safe_bound_value();
    println("step7 ok");
    println("test_convex_hull_2d: PASSED");
}
