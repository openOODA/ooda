// # Product prove std/quantum_topological/quantum_topological_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts topological_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_topological_stubs.oo.
//
// Beats:
//   1. Call topological_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_topological_stubs: PASSED only if they match.

import "std/quantum_topological/quantum_topological_stubs.oo";

pub fn main() {
    let quantum_topological_stubs_mark: Int = 0;
    if quantum_topological_stubs_mark != 0 {
        process_exit(1);
    }
    let a: TopologicalQuantumCapabilities = topological_capabilities_default();
    let b: TopologicalQuantumCapabilities = topological_capabilities_default();
    if (a).max_topological_qubits != (b).max_topological_qubits {
        println("FAIL topological_capabilities_default");
        process_exit(1);
    }
    println("prod_quantum_topological_stubs: PASSED");
}
