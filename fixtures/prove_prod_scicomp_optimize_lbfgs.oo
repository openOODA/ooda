// # Product prove std/scicomp/optimize_lbfgs.oo
//
// Logline: Fail-closed emit+check asserts vec_scale_dense is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/optimize_lbfgs.oo.
//
// Beats:
//   1. Call vec_scale_dense twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_optimize_lbfgs: PASSED only if they match.

import "std/scicomp/optimize_lbfgs.oo";

pub fn main() {
    let optimize_lbfgs_mark: Int = 0;
    if optimize_lbfgs_mark != 0 { process_exit(1); }
    let a: List[Float] = vec_scale_dense(list_new(), 1.0);
    let b: List[Float] = vec_scale_dense(list_new(), 1.0);
    if a != b { process_exit(1); }
    println("prod_optimize_lbfgs: PASSED");
}
