// # Product prove std/db_columnar/arrow_ipc_stream_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/arrow_ipc_stream_reader.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_ipc_stream_reader.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_arrow_ipc_stream_reader: PASSED only if they match.

import "std/db_columnar/arrow_ipc_stream_reader.oo";

pub fn main() {
    let arrow_ipc_stream_reader_a = arrow_ipc_decode_framing(0);
    let arrow_ipc_stream_reader_b = arrow_ipc_decode_framing(0);
    if arrow_ipc_stream_reader_a != arrow_ipc_stream_reader_b {
        println("FAIL arrow_ipc_stream_reader");
        process_exit(1);
    }
    println("prod_ap_arrow_ipc_stream_reader: PASSED");
}
