// # Product prove std/gis_spatial/web_mercator.oo
//
// Logline: Fail-closed verification that Web Mercator forward projection, latitude clamping, and tile coordinate conversion are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/web_mercator.oo.
//
// Beats:
//   1. Query Web Mercator origin shift and check latitude clamping bounds.
//   2. Forward project WGS-84 coordinates to Mercator planar coordinates.
//   3. Convert geographic coordinates to tile pyramid coordinates at specified zoom.
//   4. Query global Web Mercator geographic bounding box.
//   5. Print prod_g4_gis_web_mercator: PASSED and exit 0.

import "std/gis_spatial/web_mercator.oo";

pub fn main() {
    let shift1: Float = web_mercator_origin_shift();
    let shift2: Float = web_mercator_origin_shift();
    if shift1 != shift2 || shift1 != 20037508.342789244 {
        println("FAIL web_mercator_origin_shift");
        process_exit(1);
    }

    let c_lat1: Float = web_mercator_clamp_lat(90.0);
    let c_lat2: Float = web_mercator_clamp_lat(90.0);
    if c_lat1 != c_lat2 || c_lat1 != 85.05112878 {
        println("FAIL web_mercator_clamp_lat high");
        process_exit(1);
    }

    let pt1: MercatorPoint = web_mercator_forward(0.0, 0.0);
    let pt2: MercatorPoint = web_mercator_forward(0.0, 0.0);
    if (pt1).x != (pt2).x || (pt1).y != (pt2).y {
        println("FAIL web_mercator_forward origin");
        process_exit(1);
    }

    let tc1: TileCoord = web_mercator_latlon_to_tile(37.7749, -122.4194, 10);
    let tc2: TileCoord = web_mercator_latlon_to_tile(37.7749, -122.4194, 10);
    if (tc1).z != (tc2).z || (tc1).z != 10 {
        println("FAIL web_mercator_latlon_to_tile zoom");
        process_exit(1);
    }

    let bounds1: GeoBBox = web_mercator_bounds();
    let bounds2: GeoBBox = web_mercator_bounds();
    if (bounds1).min_x != (bounds2).min_x || (bounds1).min_x != -180.0 {
        println("FAIL web_mercator_bounds min_x");
        process_exit(1);
    }

    println("prod_g4_gis_web_mercator: PASSED");
    process_exit(0);
}
