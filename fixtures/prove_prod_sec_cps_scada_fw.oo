// # Product prove std/sec/cps/scada_fw.oo
//
// Logline: Fail-closed emit+check asserts scada_action_accept is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/cps/scada_fw.oo.
//
// Beats:
//   1. Call scada_action_accept twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_scada_fw: PASSED only if they match.

import "std/sec/cps/scada_fw.oo";

pub fn main() {
    let scada_fw_mark: Int = 0;
    if scada_fw_mark != 0 { process_exit(1); }
    let a: Int = scada_action_accept();
    let b: Int = scada_action_accept();
    if a != b { process_exit(1); }
    println("prod_scada_fw: PASSED");
}
