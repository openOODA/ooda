// # Product prove std/zk_rollup/plonk_prover_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/plonk_prover_trace.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_prover_trace.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_plonk_prover_trace: PASSED only if they match.

import "std/zk_rollup/plonk_prover_trace.oo";

pub fn main() {
    let plonk_prover_trace_a = plonk_trace_row_new(0, 0, 0, 0);
    let plonk_prover_trace_b = plonk_trace_row_new(0, 0, 0, 0);
    if plonk_prover_trace_a.row_index != plonk_prover_trace_b.row_index {
        println("FAIL plonk_prover_trace");
        process_exit(1);
    }
    println("prod_ap_plonk_prover_trace: PASSED");
}
