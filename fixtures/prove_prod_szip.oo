// # Product stream_zip prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_zip combine/len/at.
//
// Setup: Product std/io/stream_zip.oo. List[Int] destub.
//
// Beats:
//   1. [1,2] zip [10,20,30] len 2; left 1 right 10.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_zip.oo";

pub fn main() {
    let mut a: List[Int] = list_new();
    a = list_push(a, 1);
    a = list_push(a, 2);
    let mut b: List[Int] = list_new();
    b = list_push(b, 10);
    b = list_push(b, 20);
    b = list_push(b, 30);
    let z: StreamZip = stream_zip_combine(a, b);
    let n: Int = stream_zip_len(z);
    if n != 2 {
        println("FAIL zip len");
        process_exit(1);
    }
    let l0: Int = stream_zip_left_at(z, 0);
    let r0: Int = stream_zip_right_at(z, 0);
    if l0 != 1 {
        println("FAIL zip left");
        process_exit(1);
    }
    if r0 != 10 {
        println("FAIL zip right");
        process_exit(1);
    }
    println("prod_szip: PASSED");
}
