// # Product prove std/sec/sys/objcap_rights.oo
//
// Logline: Fail-closed emit+gcc+run asserts capability_rights_has_permission is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_rights.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call capability_rights_has_permission twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_objcap_rights: PASSED only if they match.

import "std/sec/sys/objcap_rights.oo";

pub fn main() {
    let g0_a = capability_rights_has_permission(0, 0);
    let g0_b = capability_rights_has_permission(0, 0);
    if g0_a != g0_b {
        println("FAIL capability_rights_has_permission");
        process_exit(1);
    }
    println("prod_gr_objcap_rights: PASSED");
}
