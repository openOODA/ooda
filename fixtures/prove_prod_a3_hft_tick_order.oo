// # Product prove std/fin/hft_tick_order.oo
//
// Logline: Fail-closed emit+gcc+run asserts tick_data_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_tick_order.oo.
//
// Beats:
//   1. Call tick_data_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_tick_order: PASSED only if they match.

import "std/fin/hft_tick_order.oo";

pub fn main() {
    let hft_tick_order_mark: Int = 0;
    if hft_tick_order_mark != 0 {
        process_exit(1);
    }
    let a: TickData = tick_data_create("x", 0, 0, 0, 0, 0, 0, 0, 0, "x", true);
    let b: TickData = tick_data_create("x", 0, 0, 0, 0, 0, 0, 0, 0, "x", true);
    if (a).price != (b).price {
        println("FAIL tick_data_create");
        process_exit(1);
    }
    println("prod_hft_tick_order: PASSED");
}
