// # Product prove std/zk_rollup/pasta_curves_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts pasta_field_switch_p_to_q value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/pasta_curves_cycle.oo.
//
// Beats:
//   1. Call pasta_field_switch_p_to_q twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pasta_curves_cycle: PASSED only if asserts hold.

import "std/zk_rollup/pasta_curves_cycle.oo";

pub fn main() {
    let pasta_curves_cycle_a: Int = pasta_field_switch_p_to_q(0, 1);
    let pasta_curves_cycle_b: Int = pasta_field_switch_p_to_q(0, 1);
    if pasta_curves_cycle_a != pasta_curves_cycle_b {
        println("FAIL pasta_field_switch_p_to_q");
        process_exit(1);
    }
    println("prod_pasta_curves_cycle: PASSED");
}
