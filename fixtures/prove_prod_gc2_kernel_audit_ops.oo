// # Product prove std/sec/sys/kernel_audit_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts kernel_audit_ops_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit_ops.oo.
//
// Beats:
//   1. Call kernel_audit_ops_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kernel_audit_ops: PASSED only if they match.

import "std/sec/sys/kernel_audit_ops.oo";

pub fn main() {
    let kernel_audit_ops_mark: Int = 0;
    if kernel_audit_ops_mark != 0 {
        process_exit(1);
    }
    let kernel_audit_ops_a = kernel_audit_ops_init(1, 1);
    let kernel_audit_ops_b = kernel_audit_ops_init(1, 1);
    if (kernel_audit_ops_a).perm_mask != (kernel_audit_ops_b).perm_mask {
        println("FAIL kernel_audit_ops_init");
        process_exit(1);
    }
    println("prod_kernel_audit_ops: PASSED");
}
