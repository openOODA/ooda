// # Product prove std/zk_rollup/merkle_patricia_trie_iterator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_iterator.oo.
//
// Beats:
//   1. Call mpt_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_merkle_patricia_trie_iterator: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_iterator.oo";

pub fn main() {
    let merkle_patricia_trie_iterator_mark: Int = 0;
    if merkle_patricia_trie_iterator_mark != 0 {
        process_exit(1);
    }
    let a: MptEntry = mpt_entry_new(0, 0);
    let b: MptEntry = mpt_entry_new(0, 0);
    if (a).key_hex != (b).key_hex {
        println("FAIL mpt_entry_new");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_iterator: PASSED");
}
