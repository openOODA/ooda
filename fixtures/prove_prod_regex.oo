// # Product prove std/text/regex.oo
//
// Logline: Fail-closed emit+gcc+run asserts regex_compile is deterministic.
//
// Setup: Isolated emit-c. Imports std/text/regex.oo.
//
// Beats:
//   1. Call regex_compile twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regex: PASSED only if they match.

import "std/text/regex.oo";

pub fn main() {
    let regex_mark: Int = 0;
    if regex_mark != 0 {
        process_exit(1);
    }
    let a: Result[Regex, String] = regex_compile("a");
    let b: Result[Regex, String] = regex_compile("a");
    if (a).is_ok() != (b).is_ok() {
        println("FAIL regex_compile");
        process_exit(1);
    }
    println("prod_regex: PASSED");
}
