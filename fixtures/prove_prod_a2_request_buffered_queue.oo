// # Product prove std/cloud_faas/request_buffered_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts request_buffered_queue_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/request_buffered_queue.oo.
//
// Beats:
//   1. Call request_buffered_queue_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_request_buffered_queue: PASSED only if they match.

import "std/cloud_faas/request_buffered_queue.oo";

pub fn main() {
    let a: RequestBufferedQueue = request_buffered_queue_new(0, 0);
    let b: RequestBufferedQueue = request_buffered_queue_new(0, 0);
    if (a).queue_id != (b).queue_id {
        println("FAIL request_buffered_queue_new");
        process_exit(1);
    }
    println("prod_request_buffered_queue: PASSED");
}
