// # Product prove std/astrodynamics/hohmann_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/hohmann_transfer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/hohmann_transfer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hohmann_transfer: PASSED only if they match.

import "std/astrodynamics/hohmann_transfer.oo";

pub fn main() {
    let hohmann_transfer_a = hohmann_burns();
    let hohmann_transfer_b = hohmann_burns();
    if hohmann_transfer_a != hohmann_transfer_b {
        println("FAIL hohmann_transfer");
        process_exit(1);
    }
    println("prod_ap_hohmann_transfer: PASSED");
}
