// # Product prove std/gis_spatial/kdtree_spatial.oo
//
// Logline: Fail-closed verification that 2D k-d tree point construction, distance calculation, bounding queries, and neighbor checks are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kdtree_spatial.oo.
//
// Beats:
//   1. Construct 2D spatial points and initialize KdTree index structure.
//   2. Compute squared Euclidean distances between point pairs.
//   3. Evaluate bounding box point containment predicates.
//   4. Execute nearest neighbor hypersphere search checks.
//   5. Print prod_g4_gis_kdtree_spatial: PASSED only if all match.

import "std/gis_spatial/kdtree_spatial.oo";

pub fn main() {
    let p1: KdPoint2D = kd_point2d_new(3.0, 4.0, 1);
    let p2: KdPoint2D = kd_point2d_new(0.0, 0.0, 2);
    if (p1).id != 1 || (p2).id != 2 {
        println("FAIL kd_point2d_new");
        process_exit(1);
    }

    let tree: KdTree2D = kd_tree_init();
    if (tree).node_count != 0 {
        println("FAIL kd_tree_init");
        process_exit(1);
    }

    let d_sq_a: Float = kd_point_distance_sq(p1, p2);
    let d_sq_b: Float = kd_point_distance_sq(p1, p2);
    if d_sq_a != d_sq_b || d_sq_a != 25.0 {
        println("FAIL kd_point_distance_sq");
        process_exit(1);
    }

    let inside: Bool = kd_box_contains_point(0.0, 0.0, 5.0, 5.0, p1);
    let outside: Bool = kd_box_contains_point(0.0, 0.0, 2.0, 2.0, p1);
    if !inside || outside {
        println("FAIL kd_box_contains_point");
        process_exit(1);
    }

    let nn_best: Float = kd_nearest_neighbor_check(p1, p2, 100.0);
    if nn_best != 25.0 {
        println("FAIL kd_nearest_neighbor_check");
        process_exit(1);
    }

    println("prod_g4_gis_kdtree_spatial: PASSED");
    process_exit(0);
}
