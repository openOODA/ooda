// # Product prove std/defi_derivatives/perpetual_isolated_margin_position.oo
//
// Logline: Fail-closed emit+gcc+run asserts isolated_position_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_isolated_margin_position.oo.
//
// Beats:
//   1. Call isolated_position_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_perpetual_isolated_margin_position: PASSED only if they match.

import "std/defi_derivatives/perpetual_isolated_margin_position.oo";

pub fn main() {
    let perpetual_isolated_margin_position_mark: Int = 0;
    if perpetual_isolated_margin_position_mark != 0 {
        process_exit(1);
    }
    let a: IsolatedPosition = isolated_position_new("x", "x", 0.0, 0.0, 0.0, 0.0);
    let b: IsolatedPosition = isolated_position_new("x", "x", 0.0, 0.0, 0.0, 0.0);
    if (a).size != (b).size {
        println("FAIL isolated_position_new");
        process_exit(1);
    }
    println("prod_g2_perpetual_isolated_margin_position: PASSED");
}
