// # Product prove std/encoding/base64.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/encoding/base64.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/encoding/base64.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_base64: PASSED only if they match.

import "std/encoding/base64.oo";

pub fn main() {
    let base64_a = base64_encode("x");
    let base64_b = base64_encode("x");
    if base64_a.contains(base64_b) == false {
        println("FAIL base64");
        process_exit(1);
    }
    if base64_b.contains(base64_a) == false {
        println("FAIL base64");
        process_exit(1);
    }
    println("prod_ap_base64: PASSED");
}
