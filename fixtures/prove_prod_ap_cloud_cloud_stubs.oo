// # Product prove std/cloud/cloud_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud/cloud_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud/cloud_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_cloud_stubs: PASSED only if they match.

import "std/cloud/cloud_stubs.oo";

pub fn main() {
    let cloud_stubs_a = cloud_hardware_config_new(0, "x");
    let cloud_stubs_b = cloud_hardware_config_new(0, "x");
    if cloud_stubs_a.accelerator_type != cloud_stubs_b.accelerator_type {
        println("FAIL cloud_stubs");
        process_exit(1);
    }
    println("prod_ap_cloud_stubs: PASSED");
}
