// # Product prove std/physics_advanced/soft_body_mass_spring.oo
//
// Logline: Fail-closed emit+gcc+run asserts spring_node_3d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_mass_spring.oo.
//
// Beats:
//   1. Call spring_node_3d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_soft_body_mass_spring: PASSED only if they match.

import "std/physics_advanced/soft_body_mass_spring.oo";

pub fn main() {
    let soft_body_mass_spring_mark: Int = 0;
    if soft_body_mass_spring_mark != 0 {
        process_exit(1);
    }
    let a: SpringNode3D = spring_node_3d_new(0.0, 0.0, 0.0, 0.0);
    let b: SpringNode3D = spring_node_3d_new(0.0, 0.0, 0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL spring_node_3d_new");
        process_exit(1);
    }
    println("prod_soft_body_mass_spring: PASSED");
}
