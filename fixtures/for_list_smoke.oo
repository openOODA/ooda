// # Collection for-in emit lock
//
// Logline: Fail-closed emit+gcc+run of for x in xs over List[Int].
//
// Setup: Backend-C. Collection for-in must sum the list.
//
// Beats:
//   1. Push 1 and 2.
//   2. Sum with for x in xs.
//   3. Exit 1 before PASSED when the sum is not 3.

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    let mut s: Int = 0;
    for x in xs {
        s = s + x;
    }
    if s != 3 {
        println("FAIL");
        process_exit(1);
    }
    println("for_list_smoke: PASSED");
}
