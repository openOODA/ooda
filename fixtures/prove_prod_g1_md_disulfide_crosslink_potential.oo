// # Product prove std/protein_folding/md_disulfide_crosslink_potential.oo
//
// Logline: Fail-closed emit+gcc+run asserts disulfide_bond_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_disulfide_crosslink_potential.oo.
//
// Beats:
//   1. Call disulfide_bond_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_disulfide_crosslink_potential: PASSED only if they match.

import "std/protein_folding/md_disulfide_crosslink_potential.oo";

pub fn main() {
    let a: Float = disulfide_bond_energy(0.0);
    let b: Float = disulfide_bond_energy(0.0);
    if a != b {
        println("FAIL disulfide_bond_energy");
        process_exit(1);
    }
    println("prod_md_disulfide_crosslink_potential: PASSED");
}
