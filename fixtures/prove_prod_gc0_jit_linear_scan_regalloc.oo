// # Product prove std/wasm_gc/jit_linear_scan_regalloc.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_scan_alloc_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_linear_scan_regalloc.oo.
//
// Beats:
//   1. Call linear_scan_alloc_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_linear_scan_regalloc: PASSED only if they match.

import "std/wasm_gc/jit_linear_scan_regalloc.oo";

pub fn main() {
    let jit_linear_scan_regalloc_mark: Int = 0;
    if jit_linear_scan_regalloc_mark != 0 {
        process_exit(1);
    }
    let jit_linear_scan_regalloc_a = linear_scan_alloc_new(1);
    let jit_linear_scan_regalloc_b = linear_scan_alloc_new(1);
    if (jit_linear_scan_regalloc_a).num_physical_regs != (jit_linear_scan_regalloc_b).num_physical_regs {
        println("FAIL linear_scan_alloc_new");
        process_exit(1);
    }
    println("prod_jit_linear_scan_regalloc: PASSED");
}
