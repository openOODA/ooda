// # Product prove std/diag/stopwatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts stopwatch_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/stopwatch.oo.
//
// Beats:
//   1. Call stopwatch_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stopwatch: PASSED only if they match.

import "std/diag/stopwatch.oo";

pub fn main() {
    let a = stopwatch_probe();
    let b = stopwatch_probe();
    if a != b {
        println("FAIL stopwatch_probe");
        process_exit(1);
    }
    println("prod_stopwatch: PASSED");
}
