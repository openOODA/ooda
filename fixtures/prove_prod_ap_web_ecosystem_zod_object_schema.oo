// # Product prove std/web_ecosystem/zod_object_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/zod_object_schema.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_object_schema.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zod_object_schema: PASSED only if they match.

import "std/web_ecosystem/zod_object_schema.oo";

pub fn main() {
    let zod_object_schema_a = zod_object_missing(0, 0);
    let zod_object_schema_b = zod_object_missing(0, 0);
    if zod_object_schema_a != zod_object_schema_b {
        println("FAIL zod_object_schema");
        process_exit(1);
    }
    println("prod_ap_zod_object_schema: PASSED");
}
