// # Product prove std/physics_advanced/navier_stokes_diffusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts diffusion_step_explicit is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/navier_stokes_diffusion.oo.
//
// Beats:
//   1. Call diffusion_step_explicit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_navier_stokes_diffusion: PASSED only if they match.

import "std/physics_advanced/navier_stokes_diffusion.oo";

pub fn main() {
    let navier_stokes_diffusion_mark: Int = 0;
    if navier_stokes_diffusion_mark != 0 {
        process_exit(1);
    }
    let a: Float = diffusion_step_explicit(0.0, 0.0, 0.0, 0.0);
    let b: Float = diffusion_step_explicit(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL diffusion_step_explicit");
        process_exit(1);
    }
    println("prod_navier_stokes_diffusion: PASSED");
}
