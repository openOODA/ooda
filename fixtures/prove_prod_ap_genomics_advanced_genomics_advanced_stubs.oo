// # Product prove std/genomics_advanced/genomics_advanced_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/genomics_advanced/genomics_advanced_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/genomics_advanced_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_genomics_advanced_stubs: PASSED only if they match.

import "std/genomics_advanced/genomics_advanced_stubs.oo";

pub fn main() {
    let genomics_advanced_stubs_a = genomics_stub_basecaller_samples_per_sec(0);
    let genomics_advanced_stubs_b = genomics_stub_basecaller_samples_per_sec(0);
    if genomics_advanced_stubs_a != genomics_advanced_stubs_b {
        println("FAIL genomics_advanced_stubs");
        process_exit(1);
    }
    println("prod_ap_genomics_advanced_stubs: PASSED");
}
