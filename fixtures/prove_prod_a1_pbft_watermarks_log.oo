// # Product prove std/bft_consensus/pbft_watermarks_log.oo
//
// Logline: Fail-closed emit+gcc+run asserts watermark_window_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/pbft_watermarks_log.oo.
//
// Beats:
//   1. Call watermark_window_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pbft_watermarks_log: PASSED only if they match.

import "std/bft_consensus/pbft_watermarks_log.oo";

pub fn main() {
    let pbft_watermarks_log_mark: Int = 0;
    if pbft_watermarks_log_mark != 0 {
        process_exit(1);
    }
    let a: WatermarkWindow = watermark_window_new(0, 0);
    let b: WatermarkWindow = watermark_window_new(0, 0);
    if (a).low_watermark != (b).low_watermark {
        println("FAIL watermark_window_new");
        process_exit(1);
    }
    println("prod_pbft_watermarks_log: PASSED");
}
