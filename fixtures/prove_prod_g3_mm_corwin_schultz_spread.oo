// # Product prove std/hft_alpha/mm_corwin_schultz_spread.oo
//
// Logline: Fail-closed emit+gcc+run asserts high_low_bar_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_corwin_schultz_spread.oo.
//
// Beats:
//   1. Call high_low_bar_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_corwin_schultz_spread: PASSED only if they match.

import "std/hft_alpha/mm_corwin_schultz_spread.oo";

pub fn main() {
    let mm_corwin_schultz_spread_mark: Int = 0;
    if mm_corwin_schultz_spread_mark != 0 {
        process_exit(1);
    }
    let a: HighLowBar = high_low_bar_new(0.0, 0.0);
    let b: HighLowBar = high_low_bar_new(0.0, 0.0);
    if (a).high_price != (b).high_price {
        println("FAIL high_low_bar_new");
        process_exit(1);
    }
    println("prod_mm_corwin_schultz_spread: PASSED");
}
