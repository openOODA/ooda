// # Product prove std/quantum/gate_phase.oo
//
// Logline: Fail-closed emit+gcc+run asserts phase_s_squared_is_z holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_phase.oo.
//
// Beats:
//   1. Call phase_s_squared_is_z using the gate_phase ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_gate_phase: PASSED only if asserts hold.

import "std/quantum/gate_phase.oo";

pub fn main() {
    let gate_phase_a = phase_s_squared_is_z();
    if !gate_phase_a {
        println("FAIL phase_s_squared_is_z");
        process_exit(1);
    }
    println("prod_gate_phase: PASSED");
}
