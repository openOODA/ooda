// # Product prove std/graph_topology/kademlia_dht_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts kademlia_distance_xor is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/kademlia_dht_routing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kademlia_distance_xor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kademlia_dht_routing: PASSED only if they match.

import "std/graph_topology/kademlia_dht_routing.oo";

pub fn main() {
    let g2_a = kademlia_distance_xor(2, 2);
    let g2_b = kademlia_distance_xor(2, 2);
    if g2_a != g2_b {
        println("FAIL kademlia_distance_xor");
        process_exit(1);
    }
    println("prod_g2_kademlia_dht_routing: PASSED");
}
