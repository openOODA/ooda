// # List ambient quota fail
//
// Logline: Push 200 ints so a small ambient list quota trips.
//
// Beats:
//   1. Start an empty List[Int].
//   2. Push 0..199 under the smoke quota.
//   3. Print the length if growth is allowed.

// M125: ambient List growth must hit quota (set OO_LIST_AMBIENT_QUOTA small in smoke)
pub fn main() {
    let mut lst: List[Int] = list_new();
    let mut i = 0;
    while i < 200 {
        lst = list_push(lst, i);
        i = i + 1;
    }
    println(list_len(lst));
}
