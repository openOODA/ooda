// # Product prove std/web_ecosystem/mime_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/mime_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/mime_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mime_types: PASSED only if they match.

import "std/web_ecosystem/mime_types.oo";

pub fn main() {
    let mime_types_a = mime_lookup_extension("x");
    let mime_types_b = mime_lookup_extension("x");
    if mime_types_a.contains(mime_types_b) == false {
        println("FAIL mime_types");
        process_exit(1);
    }
    if mime_types_b.contains(mime_types_a) == false {
        println("FAIL mime_types");
        process_exit(1);
    }
    println("prod_ap_mime_types: PASSED");
}
