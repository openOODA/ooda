// # Product prove std/ai_multimodal/diffusion_dpmsolver_multistep.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/diffusion_dpmsolver_multistep.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_dpmsolver_multistep.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diffusion_dpmsolver_multistep: PASSED only if they match.

import "std/ai_multimodal/diffusion_dpmsolver_multistep.oo";

pub fn main() {
    let diffusion_dpmsolver_multistep_a = dpm_ratio(0, 0);
    let diffusion_dpmsolver_multistep_b = dpm_ratio(0, 0);
    if diffusion_dpmsolver_multistep_a != diffusion_dpmsolver_multistep_b {
        println("FAIL diffusion_dpmsolver_multistep");
        process_exit(1);
    }
    println("prod_ap_diffusion_dpmsolver_multistep: PASSED");
}
