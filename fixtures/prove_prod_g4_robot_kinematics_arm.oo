// # Product prove std/robot/kinematics_arm.oo
//
// Logline: Fail-closed verification of planar 2-DoF and 3-DoF robotic manipulator forward/inverse kinematics and Jacobian.
//
// Setup: Isolated emit-c. Imports std/robot/kinematics_arm.oo.
//
// Beats:
//   1. Construct DHLink and compute 2-DoF forward and inverse kinematics.
//   2. Compute 2-DoF manipulator Jacobian, determinant, and differential velocity mapping.
//   3. Compute 3-DoF planar arm forward and inverse kinematics.
//   4. Print prod_g4_robot_kinematics_arm: PASSED and exit 0.

import "std/robot/kinematics_arm.oo";

pub fn main() {
    let dhl: DHLink = dh_link_new(1.0, 0.0, 0.5, 1.57, 0);
    let dhl_b: DHLink = dh_link_new(1.0, 0.0, 0.5, 1.57, 0);

    let a_len1: Float = (dhl).a_len;
    let a_len2: Float = (dhl_b).a_len;
    if a_len1 != a_len2 || a_len1 != 1.0 {
        println("FAIL dh_link_new");
        process_exit(1);
    }

    let cfg2: Arm2DConfig = arm2d_config_new(1.0, 1.0);
    let joints2: Arm2DJoints = arm2d_joints_new(0.0, 0.0);

    let pos: Vec2 = arm2d_fk(cfg2, joints2);
    let px: Float = (pos).x;
    let py: Float = (pos).y;
    if px < 1.99 || px > 2.01 || py < -0.01 || py > 0.01 {
        println("FAIL arm2d_fk");
        process_exit(1);
    }

    let ik_down: Arm2DIKResult = arm2d_ik_elbow_down(cfg2, pos);
    let ik_up: Arm2DIKResult = arm2d_ik_elbow_up(cfg2, pos);
    let valid_down: Int = (ik_down).valid;
    let valid_up: Int = (ik_up).valid;
    if valid_down != 1 || valid_up != 1 {
        println("FAIL arm2d_ik validity");
        process_exit(1);
    }

    let jac: Arm2DJacobian = arm2d_jacobian(cfg2, joints2);
    let det_val: Float = arm2d_jacobian_det(jac);
    let v_fk: Vec2 = arm2d_velocity_fk(jac, 1.0, 0.5);

    let cfg3: Arm3DConfig = arm3d_config_new(1.0, 1.0, 0.5);
    let joints3: Arm3DJoints = arm3d_joints_new(0.0, 0.0, 0.0);
    let pose3: Pose2D = arm3d_fk(cfg3, joints3);
    let p3x: Float = (pose3).x;
    if p3x < 2.49 || p3x > 2.51 {
        println("FAIL arm3d_fk");
        process_exit(1);
    }

    let ik3: Arm3DIKResult = arm3d_ik(cfg3, pose3);
    let valid3: Int = (ik3).valid;
    if valid3 != 1 {
        println("FAIL arm3d_ik");
        process_exit(1);
    }

    println("prod_g4_robot_kinematics_arm: PASSED");
    process_exit(0);
}
