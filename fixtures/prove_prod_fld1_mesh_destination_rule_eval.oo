// # Product prove std/mesh_ebpf/mesh_destination_rule_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts destination_rule_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_destination_rule_eval.oo.
//
// Beats:
//   1. Call destination_rule_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_destination_rule_eval: PASSED only if they match.

import "std/mesh_ebpf/mesh_destination_rule_eval.oo";

pub fn main() {
    let mesh_destination_rule_eval_mark: Int = 0;
    if mesh_destination_rule_eval_mark != 0 {
        process_exit(1);
    }
    let mesh_destination_rule_eval_a = destination_rule_new("x", 1);
    let mesh_destination_rule_eval_b = destination_rule_new("x", 1);
    if (mesh_destination_rule_eval_a).tls_mode != (mesh_destination_rule_eval_b).tls_mode {
        println("FAIL destination_rule_new");
        process_exit(1);
    }
    println("prod_mesh_destination_rule_eval: PASSED");
}
