// # Product prove std/simd/simd_half_float.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_half_float.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_half_float.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_half_float: PASSED only if they match.

import "std/simd/simd_half_float.oo";

pub fn main() {
    let simd_half_float_a = half_from_bits(0);
    let simd_half_float_b = half_from_bits(0);
    let simd_half_float_va = half_to_bits(simd_half_float_a);
    let simd_half_float_vb = half_to_bits(simd_half_float_b);
    if simd_half_float_va != simd_half_float_vb {
        println("FAIL simd_half_float");
        process_exit(1);
    }
    println("prod_ap_simd_half_float: PASSED");
}
