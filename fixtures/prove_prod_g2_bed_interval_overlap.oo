// # Product prove std/bio_advanced/bed_interval_overlap.oo
//
// Logline: Fail-closed emit+gcc+run asserts bed_interval_overlap_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/bed_interval_overlap.oo.
//
// Beats:
//   1. Call bed_interval_overlap_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bed_interval_overlap: PASSED only if they match.

import "std/bio_advanced/bed_interval_overlap.oo";

pub fn main() {
    let a: Int = bed_interval_overlap_probe();
    let b: Int = bed_interval_overlap_probe();
    if a != b {
        println("FAIL bed_interval_overlap_probe");
        process_exit(1);
    }
    println("prod_g2_bed_interval_overlap: PASSED");
}
