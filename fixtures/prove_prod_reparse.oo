// # Product regex_parser prove
//
// Logline: Fail-closed emit+gcc+run of shipped regex_is_meta_char/regex_escape.
//
// Setup: Product std/text/regex_parser.oo. Meta-char and escape of a.b.
//
// Beats:
//   1. "." is meta; "a" is not; regex_escape("a.b") is a\\.b.
//   2. Exit 1 before PASSED on a miss.

import "std/text/regex_parser.oo";

pub fn main() {
    let d: Bool = regex_is_meta_char(".");
    if d == false {
        println("FAIL reparse dot meta");
        process_exit(1);
    }
    let a: Bool = regex_is_meta_char("a");
    if a == true {
        println("FAIL reparse a not meta");
        process_exit(1);
    }
    let e: String = regex_escape("a.b");
    if e != "a\\.b" {
        println("FAIL reparse escape");
        process_exit(1);
    }
    println("prod_reparse: PASSED");
}
