// # Product prove std/physics/rigid_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts rigid_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/physics/rigid_engine.oo.
//
// Beats:
//   1. Call rigid_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_rigid_engine: PASSED only if it matches.

import "std/physics/rigid_engine.oo";

pub fn main() {
    let a: Int = rigid_engine_probe();
    if a != 0 {
        println("FAIL rigid_engine_probe");
        process_exit(1);
    }
    println("prod_nc_rigid_engine: PASSED");
}
