// # Product prove std/auto_mpc_control/mpc_terminal_cost_constraint.oo
//
// Logline: Fail-closed emit+gcc+run asserts terminal_validator_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_terminal_cost_constraint.oo.
//
// Beats:
//   1. Call terminal_validator_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mpc_terminal_cost_constraint: PASSED only if they match.

import "std/auto_mpc_control/mpc_terminal_cost_constraint.oo";

pub fn main() {
    let mpc_terminal_cost_constraint_mark: Int = 0;
    if mpc_terminal_cost_constraint_mark != 0 {
        process_exit(1);
    }
    let a: TerminalSetValidator = terminal_validator_default();
    let b: TerminalSetValidator = terminal_validator_default();
    if (a).p11 != (b).p11 {
        println("FAIL terminal_validator_default");
        process_exit(1);
    }
    println("prod_g2_mpc_terminal_cost_constraint: PASSED");
}
