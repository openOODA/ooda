// # Product prove std/db_graph/opencypher_mutation_executor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_mutation_executor.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_mutation_executor.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_mutation_executor: PASSED only if they match.

import "std/db_graph/opencypher_mutation_executor.oo";

pub fn main() {
    let opencypher_mutation_executor_a = mutation_stats_empty();
    let opencypher_mutation_executor_b = mutation_stats_empty();
    if opencypher_mutation_executor_a.nodes_created != opencypher_mutation_executor_b.nodes_created {
        println("FAIL opencypher_mutation_executor");
        process_exit(1);
    }
    println("prod_ap_opencypher_mutation_executor: PASSED");
}
