// # Product prove std/embedded_hal/rtc_realtime_clock.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtc_datetime_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtc_realtime_clock.oo.
//
// Beats:
//   1. Call rtc_datetime_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtc_realtime_clock: PASSED only if they match.

import "std/embedded_hal/rtc_realtime_clock.oo";

pub fn main() {
    let a: RtcDateTime = rtc_datetime_new(0, 0, 0, 0, 0, 0);
    let b: RtcDateTime = rtc_datetime_new(0, 0, 0, 0, 0, 0);
    if a.year != b.year {
        println("FAIL rtc_datetime_new");
        process_exit(1);
    }
    println("prod_rtc_realtime_clock: PASSED");
}
