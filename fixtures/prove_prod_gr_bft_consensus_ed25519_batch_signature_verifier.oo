// # Product prove std/bft_consensus/ed25519_batch_signature_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts ed25519_batch_verify is a real value.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/ed25519_batch_signature_verifier.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ed25519_batch_verify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ed25519_batch_signature_verifier: PASSED only if they match.

import "std/bft_consensus/ed25519_batch_signature_verifier.oo";

pub fn main() {
    let g0_oa: Ed25519BatchQueue = Ed25519BatchQueue { item_count: 0, max_batch_size: 0, all_valid: true };
    let g0_ob: Ed25519BatchQueue = Ed25519BatchQueue { item_count: 0, max_batch_size: 0, all_valid: true };
    let g0_a = ed25519_batch_verify(g0_oa);
    let g0_b = ed25519_batch_verify(g0_ob);
    if g0_a != g0_b {
        println("FAIL ed25519_batch_verify");
        process_exit(1);
    }
    println("prod_gr_ed25519_batch_signature_verifier: PASSED");
}
