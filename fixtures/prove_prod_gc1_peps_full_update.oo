// # Product prove std/quantum_tensor_nets/peps_full_update.oo
//
// Logline: Fail-closed emit+gcc+run asserts full_update_convergence_report_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_full_update.oo.
//
// Beats:
//   1. Call full_update_convergence_report_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_peps_full_update: PASSED only if they match.

import "std/quantum_tensor_nets/peps_full_update.oo";

pub fn main() {
    let peps_full_update_mark: Int = 0;
    if peps_full_update_mark != 0 {
        process_exit(1);
    }
    let peps_full_update_a = full_update_convergence_report_new(1, 1.0, 1.0);
    let peps_full_update_b = full_update_convergence_report_new(1, 1.0, 1.0);
    if (peps_full_update_a).iteration != (peps_full_update_b).iteration {
        println("FAIL full_update_convergence_report_new");
        process_exit(1);
    }
    println("prod_peps_full_update: PASSED");
}
