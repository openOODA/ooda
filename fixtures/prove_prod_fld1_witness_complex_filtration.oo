// # Product prove std/tda_topology/witness_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts witness_simplex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/witness_complex_filtration.oo.
//
// Beats:
//   1. Call witness_simplex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_witness_complex_filtration: PASSED only if they match.

import "std/tda_topology/witness_complex_filtration.oo";

pub fn main() {
    let witness_complex_filtration_mark: Int = 0;
    if witness_complex_filtration_mark != 0 {
        process_exit(1);
    }
    let witness_complex_filtration_a = witness_simplex_new(list_new(), 1.0, 1);
    let witness_complex_filtration_b = witness_simplex_new(list_new(), 1.0, 1);
    if (witness_complex_filtration_a).dimension != (witness_complex_filtration_b).dimension {
        println("FAIL witness_simplex_new");
        process_exit(1);
    }
    println("prod_witness_complex_filtration: PASSED");
}
