// # Product prove std/multimedia/jpeg_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts jpeg_marker_soi is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/jpeg_header.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call jpeg_marker_soi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_jpeg_header: PASSED only if they match.

import "std/multimedia/jpeg_header.oo";

pub fn main() {
    let g0_a = jpeg_marker_soi();
    let g0_b = jpeg_marker_soi();
    if g0_a != g0_b {
        println("FAIL jpeg_marker_soi");
        process_exit(1);
    }
    println("prod_gr_jpeg_header: PASSED");
}
