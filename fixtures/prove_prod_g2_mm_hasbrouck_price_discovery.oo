// # Product prove std/hft_alpha/mm_hasbrouck_price_discovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts hasbrouck_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_hasbrouck_price_discovery.oo.
//
// Beats:
//   1. Call hasbrouck_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_hasbrouck_price_discovery: PASSED only if they match.

import "std/hft_alpha/mm_hasbrouck_price_discovery.oo";

pub fn main() {
    let mm_hasbrouck_price_discovery_mark: Int = 0;
    if mm_hasbrouck_price_discovery_mark != 0 {
        process_exit(1);
    }
    let a: HasbrouckVarParams = hasbrouck_params_new(0.0, 0.0, 0.0);
    let b: HasbrouckVarParams = hasbrouck_params_new(0.0, 0.0, 0.0);
    if (a).cross_venue_covariance != (b).cross_venue_covariance {
        println("FAIL hasbrouck_params_new");
        process_exit(1);
    }
    println("prod_g2_mm_hasbrouck_price_discovery: PASSED");
}
