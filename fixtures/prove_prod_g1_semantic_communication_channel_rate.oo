// # Product prove std/telecom_6g/semantic_communication_channel_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts semantic_config_default_vision_task is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/semantic_communication_channel_rate.oo.
//
// Beats:
//   1. Call semantic_config_default_vision_task twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_semantic_communication_channel_rate: PASSED only if they match.

import "std/telecom_6g/semantic_communication_channel_rate.oo";

pub fn main() {
    let a: SemanticChannelConfig = semantic_config_default_vision_task();
    let b: SemanticChannelConfig = semantic_config_default_vision_task();
    if a.semantic_feature_dimension_k != b.semantic_feature_dimension_k {
        println("FAIL semantic_config_default_vision_task");
        process_exit(1);
    }
    println("prod_semantic_communication_channel_rate: PASSED");
}
