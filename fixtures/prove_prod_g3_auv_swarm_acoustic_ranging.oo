// # Product prove std/robotics_auv/auv_swarm_acoustic_ranging.oo
//
// Logline: Fail-closed emit+gcc+run asserts swarm_ranging_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_swarm_acoustic_ranging.oo.
//
// Beats:
//   1. Call swarm_ranging_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auv_swarm_acoustic_ranging: PASSED only if they match.

import "std/robotics_auv/auv_swarm_acoustic_ranging.oo";

pub fn main() {
    let auv_swarm_acoustic_ranging_mark: Int = 0;
    if auv_swarm_acoustic_ranging_mark != 0 {
        process_exit(1);
    }
    let a: SwarmRangingConfig = swarm_ranging_config_default();
    let b: SwarmRangingConfig = swarm_ranging_config_default();
    if (a).sound_speed_mm_s != (b).sound_speed_mm_s {
        println("FAIL swarm_ranging_config_default");
        process_exit(1);
    }
    println("prod_auv_swarm_acoustic_ranging: PASSED");
}
