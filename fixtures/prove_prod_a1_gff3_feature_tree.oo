// # Product prove std/bio_advanced/gff3_feature_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts gff3_calc_feature_length is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/gff3_feature_tree.oo.
//
// Beats:
//   1. Call gff3_calc_feature_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gff3_feature_tree: PASSED only if they match.

import "std/bio_advanced/gff3_feature_tree.oo";

pub fn main() {
    let gff3_feature_tree_mark: Int = 0;
    if gff3_feature_tree_mark != 0 {
        process_exit(1);
    }
    let a: Int = gff3_calc_feature_length(0, 0);
    let b: Int = gff3_calc_feature_length(0, 0);
    if a != b {
        println("FAIL gff3_calc_feature_length");
        process_exit(1);
    }
    println("prod_gff3_feature_tree: PASSED");
}
