// # Product prove std/astrodynamics/kepler_orbit.oo
//
// Logline: Fail-closed emit+gcc+run asserts kepler_mu_earth is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/kepler_orbit.oo.
//
// Beats:
//   1. Call kepler_mu_earth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kepler_orbit: PASSED only if they match.

import "std/astrodynamics/kepler_orbit.oo";

pub fn main() {
    let kepler_orbit_mark: Int = 0;
    if kepler_orbit_mark != 0 {
        process_exit(1);
    }
    let a: Int = kepler_mu_earth();
    let b: Int = kepler_mu_earth();
    if a != b {
        println("FAIL kepler_mu_earth");
        process_exit(1);
    }
    println("prod_kepler_orbit: PASSED");
}
