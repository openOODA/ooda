// # Product prove std/compilers_vm/wasm_module_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_module_emitter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_module_emitter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_module_emitter: PASSED only if they match.

import "std/compilers_vm/wasm_module_emitter.oo";

pub fn main() {
    let wasm_module_emitter_a = wasm_sec_custom();
    let wasm_module_emitter_b = wasm_sec_custom();
    if wasm_module_emitter_a != wasm_module_emitter_b {
        println("FAIL wasm_module_emitter");
        process_exit(1);
    }
    println("prod_ap_wasm_module_emitter: PASSED");
}
