// # Zero-Trust Scientific Computing Proof Fixture
//
// Logline: Proves the four zero-trust std/scicomp modules (convex_hull_2d, aabb_tree, quat_slerp, bezier_castel) on Ok, Err, and edge paths.
//
// Setup: Pure data-structure verification fixture with no ambient effects. Imports the four target modules and exercises them on small but interesting inputs.
//
// Beats:
//   1. convex_hull_2d: in-safe-range checks, out-of-bounds detection.
//   2. aabb_tree: build, query intersecting, query disjoint, box-inverted Err.
//   3. quat_slerp: identity, non-unit Err, t-range Err.
//   4. bezier_castel: linear curve at t=0.5, t out-of-range Err, empty pts Err.
//
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.6: Dual-evidence happy path and explicit error path.
// RULES.oot 1.7: Under 256 lines.
//
// NOTE: convex_hull_2d_build's Result[List[ConvexHull2DPoint>, String]
// trips C-emit match-unwrap in cross-module context (ag/grok fixing).
// The convex_hull_2d Build() happy/Err paths are exercised by the
// per-module verify block in std/scicomp/convex_hull_2d.oo. Here we
// only call the in_safe_range predicate to prove the data structures
// are correctly set up.

import "std/scicomp/convex_hull_2d.oo";
import "std/scicomp/aabb_tree.oo";
import "std/scicomp/quat_slerp.oo";
import "std/scicomp/bezier_castel.oo";

pub fn main() {
    // 1. convex_hull_2d
    let p_origin: ConvexHull2DPoint = ConvexHull2DPoint { x: 0, y: 0 };
    let p_unit: ConvexHull2DPoint = ConvexHull2DPoint { x: 1, y: 1 };
    let p_big: ConvexHull2DPoint = ConvexHull2DPoint { x: 9999999999, y: 9999999999 };
    let r1: Bool = convex_hull_2d_in_safe_range(&p_origin);
    if !r1 {
        println("FAIL: convex_hull_2d_in_safe_range(origin) should be true");
        process_exit(1);
    }
    let r2: Bool = convex_hull_2d_in_safe_range(&p_big);
    if r2 {
        println("FAIL: convex_hull_2d_in_safe_range(big) should be false");
        process_exit(1);
    }
    let eq: Bool = convex_hull_2d_eq(&p_unit, &p_unit);
    if !eq {
        println("FAIL: convex_hull_2d_eq(same, same) should be true");
        process_exit(1);
    }
    let lex: Bool = convex_hull_2d_lex_less(&p_origin, &p_unit);
    if !lex {
        println("FAIL: convex_hull_2d_lex_less(origin, unit) should be true");
        process_exit(1);
    }

    // 2. aabb_tree
    let mut bxs: List[Float] = list_new();
    bxs = list_push(bxs, 0.0);
    bxs = list_push(bxs, 0.0);
    bxs = list_push(bxs, 1.0);
    bxs = list_push(bxs, 1.0);
    let tree_r: Result[List[Float], String] = aabb_tree_build(bxs);
    if !tree_r.is_ok() {
        println("FAIL: aabb_tree_build should Ok");
        process_exit(1);
    }
    let bad_box: Result[List[Float], String] = aabb_tree_box_new(1.0, 0.0, 0.0, 1.0);
    if !bad_box.is_err() {
        println("FAIL: aabb_tree_box_new(inverted) should Err");
        process_exit(1);
    }
    let good_box: Result[List[Float], String] = aabb_tree_box_new(0.0, 0.0, 1.0, 1.0);
    if !good_box.is_ok() {
        println("FAIL: aabb_tree_box_new(valid) should Ok");
        process_exit(1);
    }
    let q_in: Result[List[Float], String] = aabb_tree_box_new(0.5, 0.5, 2.0, 2.0);
    if !q_in.is_ok() {
        println("FAIL: aabb_tree_box_new(query) should Ok");
        process_exit(1);
    }
    let q_out: Result[List[Float], String] = aabb_tree_box_new(5.0, 5.0, 6.0, 6.0);
    if !q_out.is_ok() {
        println("FAIL: aabb_tree_box_new(disjoint query) should Ok");
        process_exit(1);
    }
    let inter: Bool = aabb_tree_intersects(mk_box(0.0, 0.0, 1.0, 1.0), mk_box(0.5, 0.5, 2.0, 2.0));
    if !inter {
        println("FAIL: aabb_tree_intersects overlapping should be true");
        process_exit(1);
    }
    let disjo: Bool = aabb_tree_intersects(mk_box(0.0, 0.0, 1.0, 1.0), mk_box(5.0, 5.0, 6.0, 6.0));
    if disjo {
        println("FAIL: aabb_tree_intersects disjoint should be false");
        process_exit(1);
    }

    // 3. quat_slerp
    let id_r: Result[QuatSlerpQuat, String] = quat_slerp_new(1.0, 0.0, 0.0, 0.0);
    if !id_r.is_ok() {
        println("FAIL: quat_slerp_new(identity) should Ok");
        process_exit(1);
    }
    let non_unit_r: Result[QuatSlerpQuat, String] = quat_slerp_new(2.0, 0.0, 0.0, 0.0);
    if !non_unit_r.is_err() {
        println("FAIL: quat_slerp_new(non-unit) should Err");
        process_exit(1);
    }
    let id: QuatSlerpQuat = QuatSlerpQuat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 };
    let q2: Result[QuatSlerpQuat, String] = quat_slerp(&id, &id, 0.0 - 0.5);
    if !q2.is_err() {
        println("FAIL: quat_slerp(t<0) should Err");
        process_exit(1);
    }
    let q3: Result[QuatSlerpQuat, String] = quat_slerp(&id, &id, 1.5);
    if !q3.is_err() {
        println("FAIL: quat_slerp(t>1) should Err");
        process_exit(1);
    }
    let q0: Result[QuatSlerpQuat, String] = quat_slerp(&id, &id, 0.5);
    if !q0.is_ok() {
        println("FAIL: quat_slerp(identity, identity, 0.5) should Ok");
        process_exit(1);
    }

    // 4. bezier_castel
    let mut linear: List[Float] = list_new();
    linear = list_push(linear, 0.0);
    linear = list_push(linear, 0.0);
    linear = list_push(linear, 1.0);
    linear = list_push(linear, 1.0);
    let p0: Result[List[Float], String] = bezier_castel_evaluate(linear, 0.5);
    if !p0.is_ok() {
        println("FAIL: bezier_castel_evaluate(linear, 0.5) should Ok");
        process_exit(1);
    }
    let p1: Result[List[Float], String] = bezier_castel_evaluate(linear, 0.0 - 0.1);
    if !p1.is_err() {
        println("FAIL: bezier_castel_evaluate(t<0) should Err");
        process_exit(1);
    }
    let p2: Result[List[Float], String] = bezier_castel_evaluate(linear, 1.5);
    if !p2.is_err() {
        println("FAIL: bezier_castel_evaluate(t>1) should Err");
        process_exit(1);
    }
    let p3: Result[List[Float], String] = bezier_castel_evaluate(mk_empty_float_list(), 0.5);
    if !p3.is_err() {
        println("FAIL: bezier_castel_evaluate(empty) should Err");
        process_exit(1);
    }

    println("OK: scicomp proof fixture passed");
}


fn mk_empty_float_list() -> List[Float] {
    let mut out: List[Float] = list_new();
    return out;
}

// mk_box builds a 4-elem list representing [min_x, min_y, max_x, max_y].
fn mk_box(mnx: Float, mny: Float, mxx: Float, mxy: Float) -> List[Float] {
    let mut b: List[Float] = list_new();
    b = list_push(b, mnx);
    b = list_push(b, mny);
    b = list_push(b, mxx);
    b = list_push(b, mxy);
    return b;
}
