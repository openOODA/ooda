// # Product sync waitgroup prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/waitgroup.oo.
//
// Setup: Product std/sync/waitgroup.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New count 0 waiters 0 is_done.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/waitgroup.oo";

pub fn main() {
    let wg: WaitGroup = waitgroup_new();
    let c: Int = waitgroup_count(wg);
    if c != 0 {
        println("FAIL wg count");
        process_exit(1);
    }
    let w: Int = waitgroup_waiters(wg);
    if w != 0 {
        println("FAIL wg waiters");
        process_exit(1);
    }
    if waitgroup_is_done(wg) == false {
        println("FAIL wg done");
        process_exit(1);
    }
    println("prod_wgcount: PASSED");
}
