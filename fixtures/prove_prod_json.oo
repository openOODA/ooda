// # Product prove std/markup/json.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_escape is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json.oo.
//
// Beats:
//   1. Call json_escape twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json: PASSED only if they match.

import "std/markup/json.oo";

pub fn main() {
    let a = json_escape("x");
    let b = json_escape("x");
    if a != b {
        println("FAIL json_escape");
        process_exit(1);
    }
    println("prod_json: PASSED");
}
