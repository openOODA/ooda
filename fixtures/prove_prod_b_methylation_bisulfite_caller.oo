// # Product prove std/genomics_advanced/methylation_bisulfite_caller.oo
//
// Logline: Fail-closed emit+gcc+run asserts methylation_bisulfite_caller_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/methylation_bisulfite_caller.oo.
//
// Beats:
//   1. Call methylation_bisulfite_caller_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_methylation_bisulfite_caller: PASSED only if they match.

import "std/genomics_advanced/methylation_bisulfite_caller.oo";

pub fn main() {
    let a = methylation_bisulfite_caller_probe();
    let b = methylation_bisulfite_caller_probe();
    if a != b {
        println("FAIL methylation_bisulfite_caller_probe");
        process_exit(1);
    }
    println("prod_methylation_bisulfite_caller: PASSED");
}
