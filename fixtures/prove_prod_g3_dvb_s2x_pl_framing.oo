// # Product prove std/satellite_dvb/dvb_s2x_pl_framing.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_pl_slots_per_xfecframe is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_pl_framing.oo.
//
// Beats:
//   1. Call dvb_pl_slots_per_xfecframe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvb_s2x_pl_framing: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_pl_framing.oo";

pub fn main() {
    let dvb_s2x_pl_framing_mark: Int = 0;
    if dvb_s2x_pl_framing_mark != 0 {
        process_exit(1);
    }
    let a: Int = dvb_pl_slots_per_xfecframe(0, 0);
    let b: Int = dvb_pl_slots_per_xfecframe(0, 0);
    if a != b {
        println("FAIL dvb_pl_slots_per_xfecframe");
        process_exit(1);
    }
    println("prod_dvb_s2x_pl_framing: PASSED");
}
