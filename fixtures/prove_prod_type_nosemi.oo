// # Product C emit: type struct without trailing semicolon
//
// Logline: Fail-closed emit+gcc+run of a type struct that ends on RBRACE, not SEMI.
//
// Setup: Isolated emit-c. Type has no trailing semicolon after the struct.
//
// Beats:
//   1. pair_nosemi_sum(1, 2) is 3.
//   2. Exit 1 on miss. Print prod_type_nosemi: PASSED only if it holds.

type PairNoSemi = struct {
    a: Int,
    b: Int
}

pub fn pair_nosemi_sum(x: Int, y: Int) -> Int {
    let p: PairNoSemi = PairNoSemi { a: x, b: y };
    return p.a + p.b;
}

pub fn main() {
    let n: Int = pair_nosemi_sum(1, 2);
    if n != 3 {
        println("FAIL pair_nosemi");
        process_exit(1);
    }
    println("prod_type_nosemi: PASSED");
}
