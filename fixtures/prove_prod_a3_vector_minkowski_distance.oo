// # Product prove std/db_vector_ann/vector_minkowski_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_minkowski_distance.oo.
//
// Beats:
//   1. Call int_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_minkowski_distance: PASSED only if they match.

import "std/db_vector_ann/vector_minkowski_distance.oo";

pub fn main() {
    let vector_minkowski_distance_mark: Int = 0;
    if vector_minkowski_distance_mark != 0 {
        process_exit(1);
    }
    let a: Int = int_pow(0, 0);
    let b: Int = int_pow(0, 0);
    if a != b {
        println("FAIL int_pow");
        process_exit(1);
    }
    println("prod_vector_minkowski_distance: PASSED");
}
