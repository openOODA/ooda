// # Product prove std/quantum_tensor_nets/quantum_ising_transverse_mpo.oo
//
// Logline: Fail-closed emit+gcc+run asserts tfim_mpo_bond_dim is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/quantum_ising_transverse_mpo.oo.
//
// Beats:
//   1. Call tfim_mpo_bond_dim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_ising_transverse_mpo: PASSED only if they match.

import "std/quantum_tensor_nets/quantum_ising_transverse_mpo.oo";

pub fn main() {
    let quantum_ising_transverse_mpo_mark: Int = 0;
    if quantum_ising_transverse_mpo_mark != 0 {
        process_exit(1);
    }
    let a: Int = tfim_mpo_bond_dim();
    let b: Int = tfim_mpo_bond_dim();
    if a != b {
        println("FAIL tfim_mpo_bond_dim");
        process_exit(1);
    }
    println("prod_quantum_ising_transverse_mpo: PASSED");
}
