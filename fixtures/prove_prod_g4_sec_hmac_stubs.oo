// # Product prove std/sec/crypto/hmac_stubs.oo
//
// Logline: Fail-closed verification that HMAC stubs, marker routines, and key constructors are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_stubs.oo.
//
// Beats:
//   1. Call hmac_stubs_marker and __dummy_std_src_ooda_sec_crypto_hmac_stubs_oo.
//   2. Create and validate HmacKey instances.
//   3. Assert deterministic return values.
//   4. Print prod_g4_sec_hmac_stubs: PASSED and exit 0.

import "std/sec/crypto/hmac_stubs.oo";

pub fn main() {
    let m_a: Int = hmac_stubs_marker();
    let m_b: Int = hmac_stubs_marker();
    if m_a != m_b || m_a != 1 {
        println("FAIL hmac_stubs_marker");
        process_exit(1);
    }

    let dummy_a: Int = __dummy_std_src_ooda_sec_crypto_hmac_stubs_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_crypto_hmac_stubs_oo();
    if dummy_a != dummy_b || dummy_a != 0 {
        println("FAIL hmac dummy");
        process_exit(1);
    }

    let k_new_a: HmacKey = hmac_key_new(1, 32, 64, 32);
    let k_new_b: HmacKey = hmac_key_new(1, 32, 64, 32);
    let u_a: Int = hmac_key_used(k_new_a);
    let u_b: Int = hmac_key_used(k_new_b);
    if u_a != u_b || u_a != 32 {
        println("FAIL hmac_key_used");
        process_exit(1);
    }

    let f_a: Int = hmac_key_flags(k_new_a);
    let f_b: Int = hmac_key_flags(k_new_b);
    if f_a != f_b || f_a != 1 {
        println("FAIL hmac_key_flags");
        process_exit(1);
    }

    let key_res: Result[HmacKey, String] = hmac_key_create("k_stub_01", "01234567890123456789012345678901");
    let is_ok: Bool = key_res.is_ok();
    if !is_ok {
        println("FAIL hmac_key_create");
        process_exit(1);
    }

    println("prod_g4_sec_hmac_stubs: PASSED");
    process_exit(0);
}
