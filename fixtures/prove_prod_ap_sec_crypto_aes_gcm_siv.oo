// # Product prove std/sec/crypto/aes_gcm_siv.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/aes_gcm_siv.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/aes_gcm_siv.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aes_gcm_siv: PASSED only if they match.

import "std/sec/crypto/aes_gcm_siv.oo";

pub fn main() {
    let aes_gcm_siv_a = shim_marker_hex_encode("x");
    let aes_gcm_siv_b = shim_marker_hex_encode("x");
    if aes_gcm_siv_a.contains(aes_gcm_siv_b) == false {
        println("FAIL aes_gcm_siv");
        process_exit(1);
    }
    if aes_gcm_siv_b.contains(aes_gcm_siv_a) == false {
        println("FAIL aes_gcm_siv");
        process_exit(1);
    }
    println("prod_ap_aes_gcm_siv: PASSED");
}
