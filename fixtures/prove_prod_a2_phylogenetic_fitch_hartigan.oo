// # Product prove std/bio_advanced/phylogenetic_fitch_hartigan.oo
//
// Logline: Fail-closed emit+gcc+run asserts fitch_char_to_mask is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/phylogenetic_fitch_hartigan.oo.
//
// Beats:
//   1. Call fitch_char_to_mask twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_phylogenetic_fitch_hartigan: PASSED only if they match.

import "std/bio_advanced/phylogenetic_fitch_hartigan.oo";

pub fn main() {
    let phylogenetic_fitch_hartigan_mark: Int = 0;
    if phylogenetic_fitch_hartigan_mark != 0 {
        process_exit(1);
    }
    let a: Int = fitch_char_to_mask("x");
    let b: Int = fitch_char_to_mask("x");
    if a != b {
        println("FAIL fitch_char_to_mask");
        process_exit(1);
    }
    println("prod_phylogenetic_fitch_hartigan: PASSED");
}
