// # Product prove std/space_propulsion/solar_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/solar_thermal_propulsion.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_thermal_propulsion.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_solar_thermal_propulsion: PASSED only if they match.

import "std/space_propulsion/solar_thermal_propulsion.oo";

pub fn main() {
    let solar_thermal_propulsion_a = solar_thermal_spec_default();
    let solar_thermal_propulsion_b = solar_thermal_spec_default();
    if solar_thermal_propulsion_a.concentrator_area_m2 != solar_thermal_propulsion_b.concentrator_area_m2 {
        println("FAIL solar_thermal_propulsion");
        process_exit(1);
    }
    println("prod_ap_solar_thermal_propulsion: PASSED");
}
