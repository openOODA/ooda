// # Product prove std/graph_networks/erdos_renyi_random_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_networks/erdos_renyi_random_graph.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/erdos_renyi_random_graph.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_erdos_renyi_random_graph: PASSED only if they match.

import "std/graph_networks/erdos_renyi_random_graph.oo";

pub fn main() {
    let erdos_renyi_random_graph_a = er_check_giant_component_threshold(0, 0);
    let erdos_renyi_random_graph_b = er_check_giant_component_threshold(0, 0);
    if erdos_renyi_random_graph_a != erdos_renyi_random_graph_b {
        println("FAIL erdos_renyi_random_graph");
        process_exit(1);
    }
    println("prod_ap_erdos_renyi_random_graph: PASSED");
}
