// # Product prove std/sec/crypto/ed25519_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts ed25519_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519_ops.oo.
//
// Beats:
//   1. Call ed25519_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ed25519_ops: PASSED only if they match.

import "std/sec/crypto/ed25519_ops.oo";

pub fn main() {
    let a = ed25519_checksum("x");
    let b = ed25519_checksum("x");
    if a != b {
        println("FAIL ed25519_checksum");
        process_exit(1);
    }
    println("prod_ed25519_ops: PASSED");
}
