// # Product prove std/compilers_polyhedral/loop_unimodular_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts unimodular_3x3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/loop_unimodular_transform.oo.
//
// Beats:
//   1. Call unimodular_3x3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_loop_unimodular_transform: PASSED only if they match.

import "std/compilers_polyhedral/loop_unimodular_transform.oo";

pub fn main() {
    let loop_unimodular_transform_mark: Int = 0;
    if loop_unimodular_transform_mark != 0 {
        process_exit(1);
    }
    let a: UnimodularMatrix3x3 = unimodular_3x3_new(0, 0, 0, 0, 0, 0, 0, 0, 0);
    let b: UnimodularMatrix3x3 = unimodular_3x3_new(0, 0, 0, 0, 0, 0, 0, 0, 0);
    if (a).m00 != (b).m00 {
        println("FAIL unimodular_3x3_new");
        process_exit(1);
    }
    println("prod_g2_loop_unimodular_transform: PASSED");
}
