// # Product prove std/genomics_advanced/differentially_methylated_regions.oo
//
// Logline: Fail-closed emit+gcc+run asserts differentially_methylated_regions_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/differentially_methylated_regions.oo.
//
// Beats:
//   1. Call differentially_methylated_regions_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_differentially_methylated_regions: PASSED only if they match.

import "std/genomics_advanced/differentially_methylated_regions.oo";

pub fn main() {
    let a = differentially_methylated_regions_probe();
    let b = differentially_methylated_regions_probe();
    if a != b {
        println("FAIL differentially_methylated_regions_probe");
        process_exit(1);
    }
    println("prod_differentially_methylated_regions: PASSED");
}
