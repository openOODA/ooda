// # Product writer prove
//
// Logline: Fail-closed emit+gcc+run of shipped writer_write/bytes_written/flush.
//
// Setup: Product std/io/writer.oo. Write "hi".
//
// Beats:
//   1. After write hi, bytes_written 2 and flush is hi.
//   2. Exit 1 before PASSED on a miss.

import "std/io/writer.oo";

pub fn main() {
    let mut w: Writer = writer_new();
    w = writer_write(w, "hi");
    let n: Int = writer_bytes_written(w);
    if n != 2 {
        println("FAIL writer bytes");
        process_exit(1);
    }
    let s: String = writer_flush(w);
    if s != "hi" {
        println("FAIL writer flush");
        process_exit(1);
    }
    println("prod_writer: PASSED");
}
