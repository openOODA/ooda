// # Product prove std/sync/atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/atomic.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/atomic.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_atomic: PASSED only if they match.

import "std/sync/atomic.oo";

pub fn main() {
    let atomic_a = atomic_int_new(0);
    let atomic_b = atomic_int_new(0);
    if atomic_a.id != atomic_b.id {
        println("FAIL atomic");
        process_exit(1);
    }
    println("prod_ap_atomic: PASSED");
}
