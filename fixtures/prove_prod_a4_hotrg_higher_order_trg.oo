// # Product prove std/quantum_tensor_nets/hotrg_higher_order_trg.oo
//
// Logline: Fail-closed emit+gcc+run asserts hotrg_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/hotrg_higher_order_trg.oo.
//
// Beats:
//   1. Call hotrg_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hotrg_higher_order_trg: PASSED only if they match.

import "std/quantum_tensor_nets/hotrg_higher_order_trg.oo";

pub fn main() {
    let hotrg_higher_order_trg_mark: Int = 0;
    if hotrg_higher_order_trg_mark != 0 {
        process_exit(1);
    }
    let a: HotrgConfig = hotrg_config_default(0, 0);
    let b: HotrgConfig = hotrg_config_default(0, 0);
    if (a).chi_max != (b).chi_max {
        println("FAIL hotrg_config_default");
        process_exit(1);
    }
    println("prod_hotrg_higher_order_trg: PASSED");
}
