// # Product prove std/gis_topo/dem_hillshade_shader.oo
//
// Logline: Fail-closed emit+gcc+run asserts hillshade_deg2rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_hillshade_shader.oo.
//
// Beats:
//   1. Call hillshade_deg2rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dem_hillshade_shader: PASSED only if they match.

import "std/gis_topo/dem_hillshade_shader.oo";

pub fn main() {
    let dem_hillshade_shader_mark: Int = 0;
    if dem_hillshade_shader_mark != 0 {
        process_exit(1);
    }
    let a: Float = hillshade_deg2rad(0.0);
    let b: Float = hillshade_deg2rad(0.0);
    if a != b {
        println("FAIL hillshade_deg2rad");
        process_exit(1);
    }
    println("prod_g2_dem_hillshade_shader: PASSED");
}
