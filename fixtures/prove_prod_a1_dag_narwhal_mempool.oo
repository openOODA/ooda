// # Product prove std/bft_consensus/dag_narwhal_mempool.oo
//
// Logline: Fail-closed emit+gcc+run asserts availability_certificate_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_narwhal_mempool.oo.
//
// Beats:
//   1. Call availability_certificate_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dag_narwhal_mempool: PASSED only if they match.

import "std/bft_consensus/dag_narwhal_mempool.oo";

pub fn main() {
    let dag_narwhal_mempool_mark: Int = 0;
    if dag_narwhal_mempool_mark != 0 {
        process_exit(1);
    }
    let a: AvailabilityCertificate = availability_certificate_new("x", 0, 0, 0);
    let b: AvailabilityCertificate = availability_certificate_new("x", 0, 0, 0);
    if (a).signatures_count != (b).signatures_count {
        println("FAIL availability_certificate_new");
        process_exit(1);
    }
    println("prod_dag_narwhal_mempool: PASSED");
}
