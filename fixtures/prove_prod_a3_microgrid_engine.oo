// # Product prove std/grid/microgrid_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts microgrid_state_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_engine.oo.
//
// Beats:
//   1. Call microgrid_state_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_microgrid_engine: PASSED only if they match.

import "std/grid/microgrid_engine.oo";

pub fn main() {
    let microgrid_engine_mark: Int = 0;
    if microgrid_engine_mark != 0 {
        process_exit(1);
    }
    let a: MicrogridState = microgrid_state_default();
    let b: MicrogridState = microgrid_state_default();
    if (a).total_generation_kw != (b).total_generation_kw {
        println("FAIL microgrid_state_default");
        process_exit(1);
    }
    println("prod_microgrid_engine: PASSED");
}
