// # Product prove std/db_graph/graph_shortest_path_astar.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_shortest_path_astar.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_shortest_path_astar.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_shortest_path_astar: PASSED only if they match.

import "std/db_graph/graph_shortest_path_astar.oo";

pub fn main() {
    let graph_shortest_path_astar_a = astar_euclidean_heuristic(0.0, 0.0, 0.0, 0.0);
    let graph_shortest_path_astar_b = astar_euclidean_heuristic(0.0, 0.0, 0.0, 0.0);
    if graph_shortest_path_astar_a != graph_shortest_path_astar_b {
        println("FAIL graph_shortest_path_astar");
        process_exit(1);
    }
    println("prod_ap_graph_shortest_path_astar: PASSED");
}
