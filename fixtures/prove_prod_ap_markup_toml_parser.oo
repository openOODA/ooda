// # Product prove std/markup/toml_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/toml_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/toml_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_toml_parser: PASSED only if they match.

import "std/markup/toml_parser.oo";

pub fn main() {
    let toml_parser_a = toml_doc_new("x");
    let toml_parser_b = toml_doc_new("x");
    let toml_parser_va = toml_has_key(toml_parser_a, "x", "x");
    let toml_parser_vb = toml_has_key(toml_parser_b, "x", "x");
    if toml_parser_va != toml_parser_vb {
        println("FAIL toml_parser");
        process_exit(1);
    }
    println("prod_ap_toml_parser: PASSED");
}
