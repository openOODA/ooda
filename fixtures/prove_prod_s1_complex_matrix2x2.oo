// # Product prove std/quantum/complex_matrix2x2.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix_get_m00 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/complex_matrix2x2.oo.
//
// Beats:
//   1. Call matrix_get_m00 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_complex_matrix2x2: PASSED only if they match.

import "std/quantum/complex_matrix2x2.oo";

pub fn main() {
    let complex_matrix2x2_mark: Int = 0;
    if complex_matrix2x2_mark != 0 {
        process_exit(1);
    }
    let complex_matrix2x2_obj = matrix2x2_identity();
    let complex_matrix2x2_a = matrix_get_m00(&complex_matrix2x2_obj);
    let complex_matrix2x2_b = matrix_get_m00(&complex_matrix2x2_obj);
    if (complex_matrix2x2_a).real != (complex_matrix2x2_b).real {
        println("FAIL matrix_get_m00");
        process_exit(1);
    }
    println("prod_complex_matrix2x2: PASSED");
}
