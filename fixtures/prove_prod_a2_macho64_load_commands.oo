// # Product prove std/compilers_vm/macho64_load_commands.oo
//
// Logline: Fail-closed emit+gcc+run asserts macho_magic_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/macho64_load_commands.oo.
//
// Beats:
//   1. Call macho_magic_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_macho64_load_commands: PASSED only if they match.

import "std/compilers_vm/macho64_load_commands.oo";

pub fn main() {
    let macho64_load_commands_mark: Int = 0;
    if macho64_load_commands_mark != 0 {
        process_exit(1);
    }
    let a: Int = macho_magic_64();
    let b: Int = macho_magic_64();
    if a != b {
        println("FAIL macho_magic_64");
        process_exit(1);
    }
    println("prod_macho64_load_commands: PASSED");
}
