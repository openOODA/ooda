// # Product prove std/genomics_advanced/metagenomic_bracken_abundance.oo
//
// Logline: Fail-closed emit+gcc+run asserts metagenomic_bracken_abundance_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/metagenomic_bracken_abundance.oo.
//
// Beats:
//   1. Call metagenomic_bracken_abundance_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_metagenomic_bracken_abundance: PASSED only if it matches.

import "std/genomics_advanced/metagenomic_bracken_abundance.oo";

pub fn main() {
    let a: Int = metagenomic_bracken_abundance_probe();
    if a != 0 {
        println("FAIL metagenomic_bracken_abundance_probe");
        process_exit(1);
    }
    println("prod_nc_metagenomic_bracken_abundance: PASSED");
}
