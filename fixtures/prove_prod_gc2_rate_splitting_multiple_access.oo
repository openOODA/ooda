// # Product prove std/telecom_6g/rate_splitting_multiple_access.oo
//
// Logline: Fail-closed emit+gcc+run asserts rsma_eval_rates is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/rate_splitting_multiple_access.oo.
//
// Beats:
//   1. Call rsma_eval_rates twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rate_splitting_multiple_access: PASSED only if they match.

import "std/telecom_6g/rate_splitting_multiple_access.oo";

pub fn main() {
    let rate_splitting_multiple_access_mark: Int = 0;
    if rate_splitting_multiple_access_mark != 0 {
        process_exit(1);
    }
    let rate_splitting_multiple_access_a = rsma_eval_rates(rsma_config_default());
    let rate_splitting_multiple_access_b = rsma_eval_rates(rsma_config_default());
    if (rate_splitting_multiple_access_a).common_stream_rate_bps_hz != (rate_splitting_multiple_access_b).common_stream_rate_bps_hz {
        println("FAIL rsma_eval_rates");
        process_exit(1);
    }
    println("prod_rate_splitting_multiple_access: PASSED");
}
