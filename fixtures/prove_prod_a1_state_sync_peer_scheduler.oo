// # Product prove std/bft_consensus/state_sync_peer_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts peer_scheduler_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/state_sync_peer_scheduler.oo.
//
// Beats:
//   1. Call peer_scheduler_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_state_sync_peer_scheduler: PASSED only if they match.

import "std/bft_consensus/state_sync_peer_scheduler.oo";

pub fn main() {
    let state_sync_peer_scheduler_mark: Int = 0;
    if state_sync_peer_scheduler_mark != 0 {
        process_exit(1);
    }
    let a: PeerScheduler = peer_scheduler_new(0);
    let b: PeerScheduler = peer_scheduler_new(0);
    if (a).active_peers_count != (b).active_peers_count {
        println("FAIL peer_scheduler_new");
        process_exit(1);
    }
    println("prod_state_sync_peer_scheduler: PASSED");
}
