// # Product prove std/quantum_open_systems/operator_space_entanglement_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts osee_tracking_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/operator_space_entanglement_decay.oo.
//
// Beats:
//   1. Call osee_tracking_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_operator_space_entanglement_decay: PASSED only if they match.

import "std/quantum_open_systems/operator_space_entanglement_decay.oo";

pub fn main() {
    let operator_space_entanglement_decay_mark: Int = 0;
    if operator_space_entanglement_decay_mark != 0 {
        process_exit(1);
    }
    let a: OseeTrackingParams = osee_tracking_new(0.0, 0.0);
    let b: OseeTrackingParams = osee_tracking_new(0.0, 0.0);
    if (a).initial_osee != (b).initial_osee {
        println("FAIL osee_tracking_new");
        process_exit(1);
    }
    println("prod_operator_space_entanglement_decay: PASSED");
}
