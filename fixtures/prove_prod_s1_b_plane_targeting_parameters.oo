// # Product prove std/space_propulsion/b_plane_targeting_parameters.oo
//
// Logline: Fail-closed emit+gcc+run asserts b_plane_compute_coordinates is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/b_plane_targeting_parameters.oo.
//
// Beats:
//   1. Call b_plane_compute_coordinates twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_b_plane_targeting_parameters: PASSED only if they match.

import "std/space_propulsion/b_plane_targeting_parameters.oo";

pub fn main() {
    let b_plane_targeting_parameters_mark: Int = 0;
    if b_plane_targeting_parameters_mark != 0 {
        process_exit(1);
    }
    let b_plane_targeting_parameters_a = b_plane_compute_coordinates(b_plane_target_spec_default_mars());
    let b_plane_targeting_parameters_b = b_plane_compute_coordinates(b_plane_target_spec_default_mars());
    if (b_plane_targeting_parameters_a).b_magnitude_m != (b_plane_targeting_parameters_b).b_magnitude_m {
        println("FAIL b_plane_compute_coordinates");
        process_exit(1);
    }
    println("prod_b_plane_targeting_parameters: PASSED");
}
