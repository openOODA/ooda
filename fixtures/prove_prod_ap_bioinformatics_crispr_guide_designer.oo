// # Product prove std/bioinformatics/crispr_guide_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/crispr_guide_designer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/crispr_guide_designer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crispr_guide_designer: PASSED only if they match.

import "std/bioinformatics/crispr_guide_designer.oo";

pub fn main() {
    let crispr_guide_designer_a = int_pow4(0);
    let crispr_guide_designer_b = int_pow4(0);
    if crispr_guide_designer_a != crispr_guide_designer_b {
        println("FAIL crispr_guide_designer");
        process_exit(1);
    }
    println("prod_ap_crispr_guide_designer: PASSED");
}
