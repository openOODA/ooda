// # Product radix_tree prove
import "std/collections/radix_tree.oo";
pub fn main() {
    let mut t: RadixTree = radix_tree_new();
    t = radix_tree_insert(t, 7, 1);
    let n: Int = radix_tree_len(t);
    if n != 1 {
        println("FAIL radix len");
        process_exit(1);
    }
    let c7: Bool = radix_tree_contains(t, 7);
    if c7 == false {
        println("FAIL radix 7");
        process_exit(1);
    }
    println("prod_radix: PASSED");
}
