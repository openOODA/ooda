// # Product prove std/auto_robot/trajectory_mpc.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpc_cte_sq is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/trajectory_mpc.oo.
//
// Beats:
//   1. Call mpc_cte_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_trajectory_mpc: PASSED only if they match.

import "std/auto_robot/trajectory_mpc.oo";

pub fn main() {
    let trajectory_mpc_mark: Int = 0;
    if trajectory_mpc_mark != 0 {
        process_exit(1);
    }
    let a: Int = mpc_cte_sq(0, 0);
    let b: Int = mpc_cte_sq(0, 0);
    if a != b {
        println("FAIL mpc_cte_sq");
        process_exit(1);
    }
    println("prod_trajectory_mpc: PASSED");
}
