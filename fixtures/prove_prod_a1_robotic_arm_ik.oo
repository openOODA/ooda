// # Product prove std/auto_robot/robotic_arm_ik.oo
//
// Logline: Fail-closed emit+gcc+run asserts arm_reach is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/robotic_arm_ik.oo.
//
// Beats:
//   1. Call arm_reach twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_robotic_arm_ik: PASSED only if they match.

import "std/auto_robot/robotic_arm_ik.oo";

pub fn main() {
    let robotic_arm_ik_mark: Int = 0;
    if robotic_arm_ik_mark != 0 {
        process_exit(1);
    }
    let a: Int = arm_reach(0, 0);
    let b: Int = arm_reach(0, 0);
    if a != b {
        println("FAIL arm_reach");
        process_exit(1);
    }
    println("prod_robotic_arm_ik: PASSED");
}
