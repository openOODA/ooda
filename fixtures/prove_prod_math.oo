// # Product libm identity prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/math.oo sin, sqrt, and exp identities.
//
// Setup: import std/math.oo. Tree oodac emit-c. gcc needs -lm. No destub of math.oo.
//
// Beats:
//   1. math_sin(0.0) is 0.0 or abs below a tiny Float.
//   2. math_sqrt(4.0) is 2.0.
//   3. math_exp(0.0) is 1.0. Exit 1 on a miss before PASSED.
// residual: identity values only; host NaN/inf domain is not this proof.

import "std/math.oo";

pub fn main() {
    let s: Float = math_sin(0.0);
    let mut s_abs: Float = s;
    if s_abs < 0.0 {
        s_abs = 0.0 - s_abs;
    }
    if s_abs > 0.0000000001 {
        println("FAIL sin");
        process_exit(1);
    }
    let q: Float = math_sqrt(4.0);
    if !(q == 2.0) {
        println("FAIL sqrt");
        process_exit(1);
    }
    let e: Float = math_exp(0.0);
    if !(e == 1.0) {
        println("FAIL exp");
        process_exit(1);
    }
    println("prod_math: PASSED");
}
