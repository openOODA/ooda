// # Product prove std/sec/crypto/falcon_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_512_degree is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_types.oo.
//
// Beats:
//   1. Call falcon_512_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_types: PASSED only if they match.

import "std/sec/crypto/falcon_types.oo";

pub fn main() {
    let a = falcon_512_degree();
    let b = falcon_512_degree();
    if a != b {
        println("FAIL falcon_512_degree");
        process_exit(1);
    }
    println("prod_falcon_types: PASSED");
}
