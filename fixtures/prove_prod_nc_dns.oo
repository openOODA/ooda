// # Product prove std/net/dns.oo
//
// Logline: Fail-closed emit+gcc+run asserts dns_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/net/dns.oo.
//
// Beats:
//   1. Call dns_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_dns: PASSED only if it matches.

import "std/net/dns.oo";

pub fn main() {
    let a: Int = dns_probe();
    if a != 0 {
        println("FAIL dns_probe");
        process_exit(1);
    }
    println("prod_nc_dns: PASSED");
}
