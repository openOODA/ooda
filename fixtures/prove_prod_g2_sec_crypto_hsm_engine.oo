// # Product prove std/sec/crypto/hsm_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts hsm_engine_work is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hsm_engine_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hsm_engine: PASSED only if they match.

import "std/sec/crypto/hsm_engine.oo";

pub fn main() {
    let g2_a = hsm_engine_work(2, 2, 2);
    let g2_b = hsm_engine_work(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL hsm_engine_work");
        process_exit(1);
    }
    println("prod_g2_hsm_engine: PASSED");
}
