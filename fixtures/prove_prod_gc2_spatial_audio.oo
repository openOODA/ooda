// # Product prove std/3d/spatial_audio.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_audio_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/spatial_audio.oo.
//
// Beats:
//   1. Call spatial_audio_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_audio: PASSED only if they match.

import "std/3d/spatial_audio.oo";

pub fn main() {
    let spatial_audio_mark: Int = 0;
    if spatial_audio_mark != 0 {
        process_exit(1);
    }
    let spatial_audio_a = spatial_audio_init(1, 1, 1, 1);
    let spatial_audio_b = spatial_audio_init(1, 1, 1, 1);
    if (spatial_audio_a).x != (spatial_audio_b).x {
        println("FAIL spatial_audio_init");
        process_exit(1);
    }
    println("prod_spatial_audio: PASSED");
}
