// # Product prove std/web_protocols/graphql_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts graphql_parse holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/graphql_parser.oo.
//
// Beats:
//   1. Call graphql_parse using the graphql_parser ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_graphql_parser: PASSED only if asserts hold.

import "std/web_protocols/graphql_parser.oo";

pub fn main() {
    let obj = graphql_parse("x");
    let graphql_parser_a = obj.is_valid;
    let graphql_parser_b = obj.is_valid;
    if graphql_parser_a != graphql_parser_b {
        println("FAIL graphql_parse");
        process_exit(1);
    }
    println("prod_graphql_parser: PASSED");
}
