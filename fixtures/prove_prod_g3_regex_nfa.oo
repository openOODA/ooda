// # Product prove std/text/regex_nfa.oo
//
// Logline: Fail-closed emit+gcc+run asserts nfa_simulate is deterministic.
//
// Setup: Isolated emit-c. Imports std/text/regex_nfa.oo.
//
// Beats:
//   1. Call nfa_simulate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regex_nfa: PASSED only if they match.

import "std/text/regex_nfa.oo";

pub fn main() {
    let regex_nfa_mark: Int = 0;
    if regex_nfa_mark != 0 {
        process_exit(1);
    }
    let a: Bool = nfa_simulate("x", "x");
    let b: Bool = nfa_simulate("x", "x");
    if a != b {
        println("FAIL nfa_simulate");
        process_exit(1);
    }
    println("prod_regex_nfa: PASSED");
}
