// # Refuse nested struct secret field
//
// Logline: Reading a secret field across nested struct access user.creds.token must fail closed.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Construct nested struct User containing Creds with token.
//   3. Print user.creds.token so the sink refuses.
//
// multi-hop nested struct field read must refuse
type Creds = struct { token: String, name: String };
type User = struct { creds: Creds };
// SECRET: token
pub fn main() {
    let token = "s3cret-payload";
    let c = Creds { token: token, name: "alice" };
    let user = User { creds: c };
    println(user.creds.token);
}
