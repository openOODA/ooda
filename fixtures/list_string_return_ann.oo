// # Annotated string-list return
//
// Logline: Return a one-element List[String] with an annotated local.
//
// Beats:
//   1. pack annotates r as List[String].
//   2. Push "TOK" and return r.
//   3. Print list_len 1.

pub fn pack() -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "TOK");
    return r;
}
pub fn main() {
    let x = pack();
    println(list_len(x));
}
