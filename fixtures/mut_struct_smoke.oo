// # &mut struct field emit lock
//
// Logline: Fail-closed emit+gcc+run of bump through &mut Cell field assign.
//
// Setup: Backend-C. &mut T is product; field write must mutate the caller.
//
// Beats:
//   1. Bind mut Cell v 10.
//   2. bump(&mut x) adds one to v.
//   3. Exit 1 before PASSED when x.v is not 11.

type Cell = struct {
    v: Int
};

pub fn bump(c: &mut Cell) {
    c.v = c.v + 1;
}

pub fn main() {
    let mut x = Cell { v: 10 };
    bump(&mut x);
    if x.v != 11 {
        println("FAIL");
        process_exit(1);
    }
    println("mut_struct_smoke: PASSED");
}
