// # Product prove std/bio_advanced/crispr_base_editing.oo
//
// Logline: Fail-closed emit+gcc+run asserts base_editor_abe_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_base_editing.oo.
//
// Beats:
//   1. Call base_editor_abe_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crispr_base_editing: PASSED only if they match.

import "std/bio_advanced/crispr_base_editing.oo";

pub fn main() {
    let crispr_base_editing_mark: Int = 0;
    if crispr_base_editing_mark != 0 {
        process_exit(1);
    }
    let crispr_base_editing_a = base_editor_abe_default();
    let crispr_base_editing_b = base_editor_abe_default();
    if (crispr_base_editing_a).window_start != (crispr_base_editing_b).window_start {
        println("FAIL base_editor_abe_default");
        process_exit(1);
    }
    println("prod_crispr_base_editing: PASSED");
}
