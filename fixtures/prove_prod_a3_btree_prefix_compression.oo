// # Product prove std/db_storage/btree_prefix_compression.oo
//
// Logline: Fail-closed emit+gcc+run asserts common_prefix_length is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_prefix_compression.oo.
//
// Beats:
//   1. Call common_prefix_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_prefix_compression: PASSED only if they match.

import "std/db_storage/btree_prefix_compression.oo";

pub fn main() {
    let btree_prefix_compression_mark: Int = 0;
    if btree_prefix_compression_mark != 0 {
        process_exit(1);
    }
    let a: Int = common_prefix_length("x", "x");
    let b: Int = common_prefix_length("x", "x");
    if a != b {
        println("FAIL common_prefix_length");
        process_exit(1);
    }
    println("prod_btree_prefix_compression: PASSED");
}
