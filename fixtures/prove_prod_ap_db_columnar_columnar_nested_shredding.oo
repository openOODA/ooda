// # Product prove std/db_columnar/columnar_nested_shredding.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_nested_shredding.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_nested_shredding.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_columnar_nested_shredding: PASSED only if they match.

import "std/db_columnar/columnar_nested_shredding.oo";

pub fn main() {
    let columnar_nested_shredding_a = dremel_schema_node_new("x", 0, 0, true);
    let columnar_nested_shredding_b = dremel_schema_node_new("x", 0, 0, true);
    if columnar_nested_shredding_a.field_name != columnar_nested_shredding_b.field_name {
        println("FAIL columnar_nested_shredding");
        process_exit(1);
    }
    println("prod_ap_columnar_nested_shredding: PASSED");
}
