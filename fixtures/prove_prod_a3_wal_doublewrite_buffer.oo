// # Product prove std/db_storage/wal_doublewrite_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts doublewrite_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_doublewrite_buffer.oo.
//
// Beats:
//   1. Call doublewrite_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_doublewrite_buffer: PASSED only if they match.

import "std/db_storage/wal_doublewrite_buffer.oo";

pub fn main() {
    let wal_doublewrite_buffer_mark: Int = 0;
    if wal_doublewrite_buffer_mark != 0 {
        process_exit(1);
    }
    let a: DoublewriteBuffer = doublewrite_buffer_new(0);
    let b: DoublewriteBuffer = doublewrite_buffer_new(0);
    if (a).total_slots != (b).total_slots {
        println("FAIL doublewrite_buffer_new");
        process_exit(1);
    }
    println("prod_wal_doublewrite_buffer: PASSED");
}
