// # Product prove std/formal_verif/model_check_ltl_tableau.oo
//
// Logline: Fail-closed emit+gcc+run asserts ltl_translate_always is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_ltl_tableau.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ltl_translate_always twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_model_check_ltl_tableau: PASSED only if they match.

import "std/formal_verif/model_check_ltl_tableau.oo";

pub fn main() {
    let g0_a = ltl_translate_always("x");
    let g0_b = ltl_translate_always("x");
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL ltl_translate_always");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL ltl_translate_always");
        process_exit(1);
    }
    println("prod_gr_model_check_ltl_tableau: PASSED");
}
