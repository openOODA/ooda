// # Product prove std/astro_advanced/relativistic_precession.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/relativistic_precession.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/relativistic_precession.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_relativistic_precession: PASSED only if they match.

import "std/astro_advanced/relativistic_precession.oo";

pub fn main() {
    let relativistic_precession_a = mercury_precession_as();
    let relativistic_precession_b = mercury_precession_as();
    if relativistic_precession_a != relativistic_precession_b {
        println("FAIL relativistic_precession");
        process_exit(1);
    }
    println("prod_ap_relativistic_precession: PASSED");
}
