// # Product prove std/fintech_defi/perpetual_funding_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts perp_market_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/perpetual_funding_rate.oo.
//
// Beats:
//   1. Call perp_market_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_perpetual_funding_rate: PASSED only if they match.

import "std/fintech_defi/perpetual_funding_rate.oo";

pub fn main() {
    let perpetual_funding_rate_mark: Int = 0;
    if perpetual_funding_rate_mark != 0 {
        process_exit(1);
    }
    let a: PerpMarketState = perp_market_state_new("x", 0, 0);
    let b: PerpMarketState = perp_market_state_new("x", 0, 0);
    if (a).index_price != (b).index_price {
        println("FAIL perp_market_state_new");
        process_exit(1);
    }
    println("prod_g2_perpetual_funding_rate: PASSED");
}
