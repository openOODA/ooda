// # Product prove std/satellite_dvb/gnss_glonass_ofdm_fdma.oo
//
// Logline: Fail-closed emit+gcc+run asserts glonass_meander_encode is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_glonass_ofdm_fdma.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call glonass_meander_encode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_glonass_ofdm_fdma: PASSED only if they match.

import "std/satellite_dvb/gnss_glonass_ofdm_fdma.oo";

pub fn main() {
    let g2_a = glonass_meander_encode(2, 2);
    let g2_b = glonass_meander_encode(2, 2);
    if g2_a != g2_b {
        println("FAIL glonass_meander_encode");
        process_exit(1);
    }
    println("prod_g2_gnss_glonass_ofdm_fdma: PASSED");
}
