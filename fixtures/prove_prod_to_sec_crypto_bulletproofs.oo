// # Product prove std/sec/crypto/bulletproofs.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_mod_pow holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs.oo.
//
// Beats:
//   1. Call shim_marker_mod_pow using the bulletproofs ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_bulletproofs: PASSED only if asserts hold.

import "std/sec/crypto/bulletproofs.oo";

pub fn main() {
    let bulletproofs_a = shim_marker_mod_pow();
    let bulletproofs_b = shim_marker_mod_pow();
    if bulletproofs_a != bulletproofs_b {
        println("FAIL shim_marker_mod_pow");
        process_exit(1);
    }
    println("prod_bulletproofs: PASSED");
}
