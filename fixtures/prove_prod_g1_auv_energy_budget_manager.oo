// # Product prove std/robotics_auv/auv_energy_budget_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_config_default_auv is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_energy_budget_manager.oo.
//
// Beats:
//   1. Call battery_config_default_auv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auv_energy_budget_manager: PASSED only if they match.

import "std/robotics_auv/auv_energy_budget_manager.oo";

pub fn main() {
    let a: BatteryPackConfig = battery_config_default_auv();
    let b: BatteryPackConfig = battery_config_default_auv();
    if a.nominal_capacity_mwh != b.nominal_capacity_mwh {
        println("FAIL battery_config_default_auv");
        process_exit(1);
    }
    println("prod_auv_energy_budget_manager: PASSED");
}
