// # Hostile if 1==x && 2==2 no-else fold
//
// Logline: Print fold-me from if 1==x && 2==2 with no else so emit-wasm must miss a const-eq-and no-else fold.
//
// Setup: One public main. Left compare right operand is IDENT x.
//
// Beats:
//   1. Let x be 1.
//   2. If 1==x && 2==2 print fold-me.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = 1;
    if 1 == x && 2 == 2 {
        println("fold-me");
    }
}
