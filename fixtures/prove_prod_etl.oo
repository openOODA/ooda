// # Product prove std/enterprise/etl.oo
//
// Logline: Fail-closed emit+gcc+run asserts etl_field_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/etl.oo.
//
// Beats:
//   1. Call etl_field_create twice with the same args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_etl: PASSED only if they match.

import "std/enterprise/etl.oo";

pub fn main() {
    let etl_mark: Int = 0;
    if etl_mark != 0 {
        process_exit(1);
    }
    let a: EtlField = etl_field_create(0);
    let b: EtlField = etl_field_create(0);
    if (a).fl_type != (b).fl_type {
        println("FAIL etl_field_create");
        process_exit(1);
    }
    println("prod_etl: PASSED");
}
