// # Product prove std/web_ecosystem/url_pattern.oo
//
// Logline: Fail-closed emit+gcc+run asserts url_scheme_http is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/url_pattern.oo.
//
// Beats:
//   1. Call url_scheme_http twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_url_pattern: PASSED only if they match.

import "std/web_ecosystem/url_pattern.oo";

pub fn main() {
    let url_pattern_mark: Int = 0;
    if url_pattern_mark != 0 {
        process_exit(1);
    }
    let url_pattern_a: Int = url_scheme_http();
    let url_pattern_b: Int = url_scheme_http();
    if url_pattern_a != url_pattern_b {
        println("FAIL url_scheme_http");
        process_exit(1);
    }
    println("prod_url_pattern: PASSED");
}
