// # Product prove std/simd/simd_gather_scatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_gather_scatter.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/simd/simd_gather_scatter.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_simd_gather_scatter: PASSED only if they match.

import "std/simd/simd_gather_scatter.oo";

pub fn main() {
    let simd_gather_scatter_a = simd_indices4_new(0, 0, 0, 0);
    let simd_gather_scatter_b = simd_indices4_new(0, 0, 0, 0);
    if simd_gather_scatter_a.i0 != simd_gather_scatter_b.i0 {
        println("FAIL simd_gather_scatter");
        process_exit(1);
    }
    println("prod_ap_simd_gather_scatter: PASSED");
}
