// # Product prove std/mesh_ebpf/ebpf_sk_lookup_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts eBPF sk_lookup socket routing and fallback dispatch are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_sk_lookup_router.oo.
//
// Beats:
//   1. Initialize sk_lookup routing state with multi-port rules.
//   2. Query socket cookies for matched and fallback ports.
//   3. Assert deterministic socket selection and redirect counters.
//   4. Print prod_g4_ebpf_sk_lookup: PASSED and exit 0.

import "std/mesh_ebpf/ebpf_sk_lookup_router.oo";

pub fn main() {
    let mut state: SkLookupState = sk_lookup_state_new();
    sk_lookup_add_rule(&mut state, 80, 80, 15001, true);
    sk_lookup_add_rule(&mut state, 8080, 8090, 15006, false);

    let sock1: Int = sk_lookup_select_socket(&mut state, 80);
    if sock1 != 15001 {
        println("FAIL sk_lookup_select_socket 80");
        process_exit(1);
    }

    let sock2: Int = sk_lookup_select_socket(&mut state, 8085);
    if sock2 != 15006 {
        println("FAIL sk_lookup_select_socket 8085");
        process_exit(1);
    }

    let sock_fallback: Int = sk_lookup_select_socket(&mut state, 443);
    if sock_fallback != 0 {
        println("FAIL sk_lookup_select_socket fallback");
        process_exit(1);
    }

    if (state).redirects_performed != 2 {
        println("FAIL sk_lookup redirects_performed");
        process_exit(1);
    }
    if (state).fallbacks_performed != 1 {
        println("FAIL sk_lookup fallbacks_performed");
        process_exit(1);
    }

    println("prod_g4_ebpf_sk_lookup: PASSED");
    process_exit(0);
}
