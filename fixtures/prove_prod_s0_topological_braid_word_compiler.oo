// # Product prove std/quantum_topological/topological_braid_word_compiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts target_gate_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_braid_word_compiler.oo.
//
// Beats:
//   1. Call target_gate_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_topological_braid_word_compiler: PASSED only if asserts hold.

import "std/quantum_topological/topological_braid_word_compiler.oo";

pub fn main() {
    let topological_braid_word_compiler_a: TargetGateType = target_gate_new(0, "x", 1.0);
    let topological_braid_word_compiler_b: TargetGateType = target_gate_new(0, "x", 1.0);
    if topological_braid_word_compiler_a.gate_id != topological_braid_word_compiler_b.gate_id {
        println("FAIL target_gate_new");
        process_exit(1);
    }
    println("prod_topological_braid_word_compiler: PASSED");
}
