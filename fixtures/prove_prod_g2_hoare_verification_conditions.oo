// # Product prove std/formal_verif/hoare_verification_conditions.oo
//
// Logline: Fail-closed emit+gcc+run asserts hoare_env_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/hoare_verification_conditions.oo.
//
// Beats:
//   1. Call hoare_env_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hoare_verification_conditions: PASSED only if they match.

import "std/formal_verif/hoare_verification_conditions.oo";

pub fn main() {
    let hoare_verification_conditions_mark: Int = 0;
    if hoare_verification_conditions_mark != 0 {
        process_exit(1);
    }
    let a: HoareEnvironment = hoare_env_new();
    let b: HoareEnvironment = hoare_env_new();
    if (a).obligation_count != (b).obligation_count {
        println("FAIL hoare_env_new");
        process_exit(1);
    }
    println("prod_g2_hoare_verification_conditions: PASSED");
}
