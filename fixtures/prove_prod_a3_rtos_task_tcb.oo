// # Product prove std/embedded_hal/rtos_task_tcb.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_tcb_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_task_tcb.oo.
//
// Beats:
//   1. Call rtos_tcb_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtos_task_tcb: PASSED only if they match.

import "std/embedded_hal/rtos_task_tcb.oo";

pub fn main() {
    let rtos_task_tcb_mark: Int = 0;
    if rtos_task_tcb_mark != 0 {
        process_exit(1);
    }
    let a: RtosTaskState = rtos_tcb_new(0, "x", 0, 0, 0);
    let b: RtosTaskState = rtos_tcb_new(0, "x", 0, 0, 0);
    if (a).task_id != (b).task_id {
        println("FAIL rtos_tcb_new");
        process_exit(1);
    }
    println("prod_rtos_task_tcb: PASSED");
}
