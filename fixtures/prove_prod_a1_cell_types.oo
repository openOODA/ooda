// # Product prove std/bio/cell_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts cell_pop_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_types.oo.
//
// Beats:
//   1. Call cell_pop_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cell_types: PASSED only if they match.

import "std/bio/cell_types.oo";

pub fn main() {
    let cell_types_mark: Int = 0;
    if cell_types_mark != 0 {
        process_exit(1);
    }
    let a: CellPopulation = cell_pop_new(0);
    let b: CellPopulation = cell_pop_new(0);
    if (a).initial_count != (b).initial_count {
        println("FAIL cell_pop_new");
        process_exit(1);
    }
    println("prod_cell_types: PASSED");
}
