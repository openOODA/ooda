// # Product prove std/db_storage/btree_page_split_merge.oo
//
// Logline: Fail-closed emit+gcc+run asserts btree_node_data_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_page_split_merge.oo.
//
// Beats:
//   1. Call btree_node_data_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_page_split_merge: PASSED only if they match.

import "std/db_storage/btree_page_split_merge.oo";

pub fn main() {
    let btree_page_split_merge_mark: Int = 0;
    if btree_page_split_merge_mark != 0 {
        process_exit(1);
    }
    let a: BTreeNodeData = btree_node_data_new(0, true);
    let b: BTreeNodeData = btree_node_data_new(0, true);
    if (a).page_id != (b).page_id {
        println("FAIL btree_node_data_new");
        process_exit(1);
    }
    println("prod_btree_page_split_merge: PASSED");
}
