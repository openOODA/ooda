// # Product prove std/robotics_auv/auv_backstepping_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts backstepping_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_backstepping_controller.oo.
//
// Beats:
//   1. Call backstepping_gains_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_backstepping_controller: PASSED only if they match.

import "std/robotics_auv/auv_backstepping_controller.oo";

pub fn main() {
    let auv_backstepping_controller_mark: Int = 0;
    if auv_backstepping_controller_mark != 0 {
        process_exit(1);
    }
    let a: BacksteppingGains = backstepping_gains_default();
    let b: BacksteppingGains = backstepping_gains_default();
    if (a).field0 != (b).field0 {
        println("FAIL backstepping_gains_default");
        process_exit(1);
    }
    println("prod_auv_backstepping_controller: PASSED");
}
