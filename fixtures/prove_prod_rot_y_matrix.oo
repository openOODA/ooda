// # Product prove std/quantum/gate_rotation.oo
//
// Logline: Fail-closed emit+gcc+run asserts rot_y_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_rotation.oo.
//
// Beats:
//   1. Call rot_y_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rot_y_matrix: PASSED only if they match.

import "std/quantum/gate_rotation.oo";

pub fn main() {
    let gate_rotation_mark: Int = 0;
    if gate_rotation_mark != 0 { process_exit(1); }
    let a: Matrix2x2 = rot_y_matrix(0.5);
    let b: Matrix2x2 = rot_y_matrix(0.5);
    let am: Complex = (a).m00;
    let bm: Complex = (b).m00;
    let ar: Float = (am).real;
    let br: Float = (bm).real;
    if ar != br {
        println("FAIL rot_y_matrix");
        process_exit(1);
    }
    println("prod_rot_y_matrix: PASSED");
}
