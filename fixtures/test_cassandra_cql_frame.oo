// # Cassandra CQL v4 adversarial suite
//
// Logline: Wraps then parses STARTUP, READY, QUERY, and RESULT frames and rejects truncated and overrun bodies.
//
// Setup: Pure. Imports cassandra_cql_frame.oo. Run from ooda/.
//
// Beats:
//   1. Wrap a QUERY body with version 4 and stream id.
//   2. Recover version, flags, stream, opcode, and length.
//   3. Reject a short header and a length overrun.

import "std/database/cassandra_cql_frame.oo";

pub fn main() {
    let mut body: List[Int] = list_new();
    body = list_push(body, 1);
    body = list_push(body, 2);
    let q: ByteOut = cassandra_cql_frame_wrap(4, 0, 7, 7, body);
    if q.flag < 1 {
        println("FAIL wrap " + q.err);
        process_exit(1);
    }
    let p: CqlFrame = cassandra_cql_frame_parse(q.bytes);
    if p.flag < 1 {
        println("FAIL parse " + p.err);
        process_exit(1);
    }
    if p.version != 4 {
        println("FAIL version");
        process_exit(1);
    }
    if p.stream != 7 {
        println("FAIL stream");
        process_exit(1);
    }
    if p.opcode != 7 {
        println("FAIL opcode");
        process_exit(1);
    }
    if p.length != 2 {
        println("FAIL length");
        process_exit(1);
    }
    let r: ByteOut = cassandra_cql_frame_wrap(132, 0, 1, 8, list_new());
    let rp: CqlFrame = cassandra_cql_frame_parse(r.bytes);
    if rp.flag < 1 {
        println("FAIL result");
        process_exit(1);
    }
    let s: ByteOut = cassandra_cql_frame_wrap(4, 0, 0, 1, list_new());
    let sp: CqlFrame = cassandra_cql_frame_parse(s.bytes);
    if sp.opcode != 1 {
        println("FAIL startup");
        process_exit(1);
    }
    let y: ByteOut = cassandra_cql_frame_wrap(132, 0, 0, 2, list_new());
    let yp: CqlFrame = cassandra_cql_frame_parse(y.bytes);
    if yp.opcode != 2 {
        println("FAIL ready");
        process_exit(1);
    }
    println("v4 version/flags/stream/opcode/4-byte length");
    println("STARTUP/READY/QUERY/RESULT");
    let mut cut: List[Int] = list_new();
    cut = list_push(cut, 4);
    let bad: CqlFrame = cassandra_cql_frame_parse(cut);
    if bad.flag > 0 {
        println("FAIL short ok");
        process_exit(1);
    }
    let mut over: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 9 {
        over = list_push(over, list_get(q.bytes, i));
        i = i + 1;
    }
    let ov: CqlFrame = cassandra_cql_frame_parse(over);
    if ov.flag > 0 {
        println("FAIL overrun ok");
        process_exit(1);
    }
    println("truncated/overrun Err");
    println("SUITE PASSED");
    println("test_cassandra_cql_frame: PASSED");
}
