// # Product prove std/web_ecosystem/lodash_flatten.oo
//
// Logline: Fail-closed emit+gcc+run asserts lodash_flatten_n value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_flatten.oo.
//
// Beats:
//   1. Call lodash_flatten_n twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_lodash_flatten: PASSED only if asserts hold.

import "std/web_ecosystem/lodash_flatten.oo";

pub fn main() {
    let lodash_flatten_a: Int = lodash_flatten_n(0, 0);
    let lodash_flatten_b: Int = lodash_flatten_n(0, 0);
    if lodash_flatten_a != lodash_flatten_b {
        println("FAIL lodash_flatten_n");
        process_exit(1);
    }
    println("prod_lodash_flatten: PASSED");
}
