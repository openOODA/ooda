// # Algebraic invariant property prover test fixture
//
// Logline: Fail-closed emit+gcc+run asserts algebraic law checks (associative, identity, commutative, distributive, inverse) plus a 50-triple fuzz over add and mul all hold.
//
// Setup: Imports std/algebra/algebraic_invariants.oo. Uses a deterministic LCG (same family as tensor_engine.oo) for the fuzz to keep the run reproducible.
//
// Beats:
//   1. Test 1: check_associative("add", 1, 2, 3) holds.
//   2. Test 2: check_associative("mul", 2, 3, 4) holds.
//   3. Test 3: check_associative("add", 1, 2, -5) holds (negative operand).
//   4. Test 4: check_identity("add", 7) holds (left and right identity both 7).
//   5. Test 5: check_identity("mul", 7) holds.
//   6. Test 6: check_commutative("add", 3, 5) and check_commutative("min", 3, 5) both hold.
//   7. Test 7: check_distributive(2, 3, 4) holds.
//   8. Test 8: check_inverse("add", 7) holds (7 + (-7) == 0).
//   9. Test 9: 50-triple deterministic fuzz over add and mul; all holds == 1.
//
// residual: 50-triple fuzz uses pseudo_rand_lcg so the run is deterministic; the .oo runtime cannot take an OS entropy source.

import "std/algebra/algebraic_invariants.oo";

// Deterministic LCG step, mirrors pseudo_rand_lcg in std/ai_ml/tensor_engine.oo.
fn fuzz_lcg(state: Int) -> Int {
    let n = (state * 1103515245) + 12345;
    let m = n % 2147483647;
    if m < 0 {
        return 0 - m;
    }
    return m;
}

// Take a 0..2^31-1 LCG output to an Int in [-100, 100].
fn fuzz_to_small(state: Int) -> Int {
    let v = state % 201;
    return v - 100;
}

// Fail closed with a per-test label.
fn assert_holds(c: AlgebraicCert, label: String) {
    if (c).holds != 1 {
        println("FAIL " + label);
        process_exit(1);
    }
}

pub fn main() {
    let c1: AlgebraicCert = check_associative("add", 1, 2, 3);
    assert_holds(c1, "T1 assoc add 1 2 3");

    let c2: AlgebraicCert = check_associative("mul", 2, 3, 4);
    assert_holds(c2, "T2 assoc mul 2 3 4");

    let c3: AlgebraicCert = check_associative("add", 1, 2, 0 - 5);
    assert_holds(c3, "T3 assoc add 1 2 -5");

    let c4: AlgebraicCert = check_identity("add", 7);
    assert_holds(c4, "T4 identity add 7");

    let c5: AlgebraicCert = check_identity("mul", 7);
    assert_holds(c5, "T5 identity mul 7");

    let c6a: AlgebraicCert = check_commutative("add", 3, 5);
    assert_holds(c6a, "T6a comm add 3 5");
    let c6b: AlgebraicCert = check_commutative("min", 3, 5);
    assert_holds(c6b, "T6b comm min 3 5");

    let c7: AlgebraicCert = check_distributive(2, 3, 4);
    assert_holds(c7, "T7 distrib 2 3 4");

    let c8: AlgebraicCert = check_inverse("add", 7);
    assert_holds(c8, "T8 inverse add 7");

    // Test 9: 50-triple deterministic fuzz over add and mul.
    let mut state: Int = 42;
    let mut i: Int = 0;
    while i < 50 {
        state = fuzz_lcg(state);
        let a: Int = fuzz_to_small(state);
        state = fuzz_lcg(state);
        let b: Int = fuzz_to_small(state);
        state = fuzz_lcg(state);
        let c: Int = fuzz_to_small(state);
        let cadd: AlgebraicCert = check_associative("add", a, b, c);
        if (cadd).holds != 1 {
            println("FAIL T9 fuzz add at i=" + i.to_string());
            process_exit(1);
        }
        let cmul: AlgebraicCert = check_associative("mul", a, b, c);
        if (cmul).holds != 1 {
            println("FAIL T9 fuzz mul at i=" + i.to_string());
            process_exit(1);
        }
        i = i + 1;
    }

    println("test_algebraic_invariants: PASSED");
}
