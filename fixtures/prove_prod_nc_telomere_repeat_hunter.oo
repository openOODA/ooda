// # Product prove std/genomics_advanced/telomere_repeat_hunter.oo
//
// Logline: Fail-closed emit+gcc+run asserts telomere_repeat_hunter_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/telomere_repeat_hunter.oo.
//
// Beats:
//   1. Call telomere_repeat_hunter_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_telomere_repeat_hunter: PASSED only if it matches.

import "std/genomics_advanced/telomere_repeat_hunter.oo";

pub fn main() {
    let a: Int = telomere_repeat_hunter_probe();
    if a != 0 {
        println("FAIL telomere_repeat_hunter_probe");
        process_exit(1);
    }
    println("prod_nc_telomere_repeat_hunter: PASSED");
}
