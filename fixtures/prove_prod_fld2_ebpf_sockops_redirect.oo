// # Product prove std/mesh_ebpf/ebpf_sockops_redirect.oo
//
// Logline: Fail-closed emit+gcc+run asserts sockmap_hash_4tuple is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_sockops_redirect.oo.
//
// Beats:
//   1. Call sockmap_hash_4tuple twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_sockops_redirect: PASSED only if they match.

import "std/mesh_ebpf/ebpf_sockops_redirect.oo";

pub fn main() {
    let ebpf_sockops_redirect_mark: Int = 0;
    if ebpf_sockops_redirect_mark != 0 {
        process_exit(1);
    }
    let ebpf_sockops_redirect_a: Int = sockmap_hash_4tuple(1, 1, 1, 1);
    let ebpf_sockops_redirect_b: Int = sockmap_hash_4tuple(1, 1, 1, 1);
    if ebpf_sockops_redirect_a != ebpf_sockops_redirect_b {
        println("FAIL sockmap_hash_4tuple");
        process_exit(1);
    }
    println("prod_ebpf_sockops_redirect: PASSED");
}
