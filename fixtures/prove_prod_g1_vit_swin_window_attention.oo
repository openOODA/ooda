// # Product prove std/ai_multimodal/vit_swin_window_attention.oo
//
// Logline: Fail-closed emit+gcc+run asserts swin_window_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_swin_window_attention.oo.
//
// Beats:
//   1. Call swin_window_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vit_swin_window_attention: PASSED only if they match.

import "std/ai_multimodal/vit_swin_window_attention.oo";

pub fn main() {
    let a: SwinWindowConfig = swin_window_config_new(0, 0, 0, 0);
    let b: SwinWindowConfig = swin_window_config_new(0, 0, 0, 0);
    if a.dim != b.dim {
        println("FAIL swin_window_config_new");
        process_exit(1);
    }
    println("prod_vit_swin_window_attention: PASSED");
}
