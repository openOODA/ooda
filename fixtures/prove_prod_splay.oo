// # Product splay_tree prove
//
// Logline: Fail-closed emit+gcc+run of shipped splay_tree_insert/contains/len.
//
// Setup: Product std/collections/splay_tree.oo. Sorted List[Int] stand-in.
//
// Beats:
//   1. After insert 3, len 1; contains 3 true; contains 2 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/splay_tree.oo";

pub fn main() {
    let mut t: SplayTree = splay_tree_new();
    t = splay_tree_insert(t, 3);
    let n: Int = splay_tree_len(t);
    if n != 1 {
        println("FAIL splay len");
        process_exit(1);
    }
    let c3: Bool = splay_tree_contains(t, 3);
    if c3 == false {
        println("FAIL splay contains 3");
        process_exit(1);
    }
    let c2: Bool = splay_tree_contains(t, 2);
    if c2 == true {
        println("FAIL splay contains 2");
        process_exit(1);
    }
    println("prod_splay: PASSED");
}
