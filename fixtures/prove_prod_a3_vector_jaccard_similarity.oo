// # Product prove std/db_vector_ann/vector_jaccard_similarity.oo
//
// Logline: Fail-closed emit+gcc+run asserts jaccard_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_jaccard_similarity.oo.
//
// Beats:
//   1. Call jaccard_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_jaccard_similarity: PASSED only if they match.

import "std/db_vector_ann/vector_jaccard_similarity.oo";

pub fn main() {
    let vector_jaccard_similarity_mark: Int = 0;
    if vector_jaccard_similarity_mark != 0 {
        process_exit(1);
    }
    let a: JaccardConfig = jaccard_config_default();
    let b: JaccardConfig = jaccard_config_default();
    if (a).scale_factor != (b).scale_factor {
        println("FAIL jaccard_config_default");
        process_exit(1);
    }
    println("prod_vector_jaccard_similarity: PASSED");
}
