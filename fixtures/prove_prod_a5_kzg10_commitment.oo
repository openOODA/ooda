// # Product prove std/zk_rollup/kzg10_commitment.oo
//
// Logline: Fail-closed emit+gcc+run asserts kzg10_commitment_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/kzg10_commitment.oo.
//
// Beats:
//   1. Call kzg10_commitment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kzg10_commitment: PASSED only if they match.

import "std/zk_rollup/kzg10_commitment.oo";

pub fn main() {
    let a: Kzg10Commitment = kzg10_commitment_new(0, 0, 0);
    let b: Kzg10Commitment = kzg10_commitment_new(0, 0, 0);
    if (a).commitment_point_x != (b).commitment_point_x {
        println("FAIL kzg10_commitment_new");
        process_exit(1);
    }
    println("prod_kzg10_commitment: PASSED");
}
