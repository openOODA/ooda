// # Product prove std/media_dsp/dsp_delay_line_fractional.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_interpolate_linear is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_delay_line_fractional.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dsp_interpolate_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dsp_delay_line_fractional: PASSED only if they match.

import "std/media_dsp/dsp_delay_line_fractional.oo";

pub fn main() {
    let g0_a = dsp_interpolate_linear(0.0, 0.0, 0.0);
    let g0_b = dsp_interpolate_linear(0.0, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL dsp_interpolate_linear");
        process_exit(1);
    }
    println("prod_gr_dsp_delay_line_fractional: PASSED");
}
