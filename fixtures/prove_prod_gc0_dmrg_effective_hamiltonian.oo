// # Product prove std/quantum_tensor_nets/dmrg_effective_hamiltonian.oo
//
// Logline: Fail-closed emit+gcc+run asserts environment_trivial_boundary is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/dmrg_effective_hamiltonian.oo.
//
// Beats:
//   1. Call environment_trivial_boundary twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dmrg_effective_hamiltonian: PASSED only if they match.

import "std/quantum_tensor_nets/dmrg_effective_hamiltonian.oo";

pub fn main() {
    let dmrg_effective_hamiltonian_mark: Int = 0;
    if dmrg_effective_hamiltonian_mark != 0 {
        process_exit(1);
    }
    let dmrg_effective_hamiltonian_a = environment_trivial_boundary(1);
    let dmrg_effective_hamiltonian_b = environment_trivial_boundary(1);
    if (dmrg_effective_hamiltonian_a).site_index != (dmrg_effective_hamiltonian_b).site_index {
        println("FAIL environment_trivial_boundary");
        process_exit(1);
    }
    println("prod_dmrg_effective_hamiltonian: PASSED");
}
