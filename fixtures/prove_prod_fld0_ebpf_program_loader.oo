// # Product prove std/mesh_ebpf/ebpf_program_loader.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebpf_loader_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_program_loader.oo.
//
// Beats:
//   1. Call ebpf_loader_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_program_loader: PASSED only if they match.

import "std/mesh_ebpf/ebpf_program_loader.oo";

pub fn main() {
    let ebpf_program_loader_mark: Int = 0;
    if ebpf_program_loader_mark != 0 {
        process_exit(1);
    }
    let ebpf_program_loader_a: EbpfLoaderContext = ebpf_loader_new();
    let ebpf_program_loader_b: EbpfLoaderContext = ebpf_loader_new();
    if (ebpf_program_loader_a).next_fd != (ebpf_program_loader_b).next_fd {
        println("FAIL ebpf_loader_new");
        process_exit(1);
    }
    println("prod_ebpf_program_loader: PASSED");
}
