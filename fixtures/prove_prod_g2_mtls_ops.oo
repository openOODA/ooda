// # Product prove std/sec/net/mtls_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts tls_handshake_state_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_ops.oo.
//
// Beats:
//   1. Call tls_handshake_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mtls_ops: PASSED only if they match.

import "std/sec/net/mtls_ops.oo";

pub fn main() {
    let mtls_ops_mark: Int = 0;
    if mtls_ops_mark != 0 {
        process_exit(1);
    }
    let a: TlsHandshakeState = tls_handshake_state_init("x");
    let b: TlsHandshakeState = tls_handshake_state_init("x");
    if (a).client_auth_requested != (b).client_auth_requested {
        println("FAIL tls_handshake_state_init");
        process_exit(1);
    }
    println("prod_g2_mtls_ops: PASSED");
}
