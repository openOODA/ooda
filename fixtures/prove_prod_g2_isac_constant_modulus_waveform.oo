// # Product prove std/telecom_6g/isac_constant_modulus_waveform.oo
//
// Logline: Fail-closed emit+gcc+run asserts cm_calc_papr_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_constant_modulus_waveform.oo.
//
// Beats:
//   1. Call cm_calc_papr_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isac_constant_modulus_waveform: PASSED only if they match.

import "std/telecom_6g/isac_constant_modulus_waveform.oo";

pub fn main() {
    let isac_constant_modulus_waveform_mark: Int = 0;
    if isac_constant_modulus_waveform_mark != 0 {
        process_exit(1);
    }
    let a: Float = cm_calc_papr_db(0.0, 0.0);
    let b: Float = cm_calc_papr_db(0.0, 0.0);
    if a != b {
        println("FAIL cm_calc_papr_db");
        process_exit(1);
    }
    println("prod_g2_isac_constant_modulus_waveform: PASSED");
}
