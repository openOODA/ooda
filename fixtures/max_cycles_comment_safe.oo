// # Mid-line cycles mention
//
// Logline: Loop twice under a real cycles marker while a mid-line mention stays inert.
//
// Beats:
//   1. Keep the mid-line mention that is not a marker.
//   2. Keep the real cycles marker on its own line.
//   3. While i < 2 and print i.

// mention of directive mid-line is not a marker: path A MAX_CYCLES N text
// MAX_CYCLES: 5
pub fn main() {
    let mut i = 0;
    while i < 2 {
        i = i + 1;
    }
    println(i);
}
