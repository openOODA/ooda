// # Product prove std/gis_topo/proj_geodetic_datum.oo
//
// Logline: Fail-closed emit+gcc+run asserts datum_wgs84 is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_geodetic_datum.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call datum_wgs84 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_proj_geodetic_datum: PASSED only if they match.

import "std/gis_topo/proj_geodetic_datum.oo";

pub fn main() {
    let g2_oa: GeodeticDatum = datum_wgs84();
    let g2_ob: GeodeticDatum = datum_wgs84();
    let g2_a = (g2_oa).semi_major_a;
    let g2_b = (g2_ob).semi_major_a;
    if g2_a != g2_b {
        println("FAIL datum_wgs84.semi_major_a");
        process_exit(1);
    }
    println("prod_g2_proj_geodetic_datum: PASSED");
}
