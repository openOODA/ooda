// # Product prove std/physics/constraint_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts distance_constraint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/constraint_distance.oo.
//
// Beats:
//   1. Call distance_constraint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_constraint_distance: PASSED only if they match.

import "std/physics/constraint_distance.oo";

pub fn main() {
    let constraint_distance_mark: Int = 0;
    if constraint_distance_mark != 0 {
        process_exit(1);
    }
    let a: DistanceConstraint = distance_constraint_new(0, 0, 0.0, 0.0);
    let b: DistanceConstraint = distance_constraint_new(0, 0, 0.0, 0.0);
    if (a).body_a_id != (b).body_a_id {
        println("FAIL distance_constraint_new");
        process_exit(1);
    }
    println("prod_constraint_distance: PASSED");
}
