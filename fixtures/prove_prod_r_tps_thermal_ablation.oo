// # Product prove std/space_propulsion/tps_thermal_ablation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ablator_spec_default_pica value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/tps_thermal_ablation.oo.
//
// Beats:
//   1. Call ablator_spec_default_pica twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_tps_thermal_ablation: PASSED only if asserts hold.

import "std/space_propulsion/tps_thermal_ablation.oo";

pub fn main() {
    let tps_thermal_ablation: AblatorMaterialSpec = ablator_spec_default_pica();
    let tps_thermal_ablation_b: AblatorMaterialSpec = ablator_spec_default_pica();
    if (tps_thermal_ablation).virgin_density_kg_m3 != 270.0 {
        println("FAIL ablator_spec_default_pica virgin_density_kg_m3");
        process_exit(1);
    }
    if (tps_thermal_ablation).virgin_density_kg_m3 != (tps_thermal_ablation_b).virgin_density_kg_m3 {
        println("FAIL ablator_spec_default_pica det");
        process_exit(1);
    }
    println("prod_tps_thermal_ablation: PASSED");
}
