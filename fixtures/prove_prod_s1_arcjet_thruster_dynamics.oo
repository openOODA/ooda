// # Product prove std/space_propulsion/arcjet_thruster_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts arcjet_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/arcjet_thruster_dynamics.oo.
//
// Beats:
//   1. Call arcjet_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arcjet_thruster_dynamics: PASSED only if they match.

import "std/space_propulsion/arcjet_thruster_dynamics.oo";

pub fn main() {
    let arcjet_thruster_dynamics_mark: Int = 0;
    if arcjet_thruster_dynamics_mark != 0 {
        process_exit(1);
    }
    let arcjet_thruster_dynamics_a = arcjet_compute_performance(arcjet_spec_default_hydrazine());
    let arcjet_thruster_dynamics_b = arcjet_compute_performance(arcjet_spec_default_hydrazine());
    if (arcjet_thruster_dynamics_a).total_power_kw != (arcjet_thruster_dynamics_b).total_power_kw {
        println("FAIL arcjet_compute_performance");
        process_exit(1);
    }
    println("prod_arcjet_thruster_dynamics: PASSED");
}
