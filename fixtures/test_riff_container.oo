// # RIFF container adversarial suite
//
// Logline: Parses WAVE, AVI, and WebP RIFF forms and rejects a size that overruns the buffer.
//
// Setup: Pure. Imports riff_container.oo. Run from ooda/.
//
// Beats:
//   1. Make and parse WAVE, AVI, and WEBP containers.
//   2. Recover FourCC, size, and payload offset.
//   3. Reject an overrun chunk size.

import "std/multimedia/riff_container.oo";

pub fn main() {
    let mut p: List[Int] = list_new();
    p = list_push(p, 1);
    p = list_push(p, 2);
    let w: ByteOut = riff_container_make("WAVE", "fmt ", p);
    let wp: RiffOut = riff_container_parse(w.bytes);
    if wp.flag < 1 {
        println("FAIL wave " + wp.err);
        process_exit(1);
    }
    if wp.payload != 20 {
        println("FAIL payload");
        process_exit(1);
    }
    let a: ByteOut = riff_container_make("AVI ", "hdrl", p);
    let ap: RiffOut = riff_container_parse(a.bytes);
    if ap.flag < 1 {
        println("FAIL avi " + ap.err);
        process_exit(1);
    }
    let e: ByteOut = riff_container_make("WEBP", "VP8 ", p);
    let ep: RiffOut = riff_container_parse(e.bytes);
    if ep.flag < 1 {
        println("FAIL webp " + ep.err);
        process_exit(1);
    }
    println("FourCC, size, payload offset for WAVE, AVI, WebP");
    let mut over: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 20 {
        over = list_push(over, list_get(w.bytes, i));
        i = i + 1;
    }
    let ov: RiffOut = riff_container_parse(over);
    if ov.flag > 0 {
        println("FAIL overrun ok");
        process_exit(1);
    }
    println("overrun Err");
    println("SUITE PASSED");
    println("test_riff_container: PASSED");
}
