// # Product prove std/crypto_advanced/poseidon_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/poseidon_hash.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/poseidon_hash.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_poseidon_hash: PASSED only if they match.

import "std/crypto_advanced/poseidon_hash.oo";

pub fn main() {
    let poseidon_hash_a = poseidon_sbox_x5(0, 0);
    let poseidon_hash_b = poseidon_sbox_x5(0, 0);
    if poseidon_hash_a != poseidon_hash_b {
        println("FAIL poseidon_hash");
        process_exit(1);
    }
    println("prod_ap_poseidon_hash: PASSED");
}
