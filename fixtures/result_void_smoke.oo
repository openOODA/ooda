// # Result[Void] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[Void, String] Ok(void) and Err String bind.
//
// Setup: Backend-C. Result[Void] is OoResV. Ok(void) has no payload.
//
// Beats:
//   1. f returns Ok(void).
//   2. Match Ok sets a flag; Err FAIL.
//   3. boom Err("no") binds a String. Exit 1 before PASSED on a miss.

pub fn f() -> Result[Void, String] {
    return Ok(void);
}

pub fn boom() -> Result[Void, String] {
    return Err("no");
}

pub fn main() {
    let r: Result[Void, String] = f();
    let mut flag: Int = 0;
    match r {
        Ok(_) => { flag = 1; }
        Err(e) => {
            println("FAIL");
            process_exit(1);
        }
    }
    if flag != 1 {
        println("FAIL");
        process_exit(1);
    }
    let e: Result[Void, String] = boom();
    let msg: String = match e {
        Ok(_) => "",
        Err(s) => s
    };
    if msg != "no" {
        println("FAIL");
        process_exit(1);
    }
    println("result_void_smoke: PASSED");
}
