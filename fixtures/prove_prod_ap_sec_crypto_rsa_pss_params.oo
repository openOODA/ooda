// # Product prove std/sec/crypto/rsa_pss_params.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/rsa_pss_params.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/rsa_pss_params.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rsa_pss_params: PASSED only if they match.

import "std/sec/crypto/rsa_pss_params.oo";

pub fn main() {
    let rsa_pss_params_a = rsa_checksum("x");
    let rsa_pss_params_b = rsa_checksum("x");
    if rsa_pss_params_a != rsa_pss_params_b {
        println("FAIL rsa_pss_params");
        process_exit(1);
    }
    println("prod_ap_rsa_pss_params: PASSED");
}
