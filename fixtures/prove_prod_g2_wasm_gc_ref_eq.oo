// # Product prove std/wasm_gc/wasm_gc_ref_eq.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_gc_ref_eq_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_ref_eq.oo.
//
// Beats:
//   1. Call wasm_gc_ref_eq_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_gc_ref_eq: PASSED only if they match.

import "std/wasm_gc/wasm_gc_ref_eq.oo";

pub fn main() {
    let a: Int = wasm_gc_ref_eq_probe();
    let b: Int = wasm_gc_ref_eq_probe();
    if a != b {
        println("FAIL wasm_gc_ref_eq_probe");
        process_exit(1);
    }
    println("prod_g2_wasm_gc_ref_eq: PASSED");
}
