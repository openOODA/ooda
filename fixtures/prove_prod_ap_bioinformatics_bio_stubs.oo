// # Product prove std/bioinformatics/bio_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/bio_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/bio_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_bio_stubs: PASSED only if they match.

import "std/bioinformatics/bio_stubs.oo";

pub fn main() {
    let bio_stubs_a = bio_hardware_device_new(0, "x");
    let bio_stubs_b = bio_hardware_device_new(0, "x");
    if bio_stubs_a.device_id != bio_stubs_b.device_id {
        println("FAIL bio_stubs");
        process_exit(1);
    }
    println("prod_ap_bio_stubs: PASSED");
}
