// # Product cursor prove
//
// Logline: Fail-closed emit+gcc+run of shipped cursor_read / remaining.
//
// Setup: Product std/io/cursor.oo. hello buffer.
//
// Beats:
//   1. Read 2 of hello is he; remaining is 5 until advance.
//   2. After advance 2, remaining is 3.
//   3. Exit 1 before PASSED on a miss.

import "std/io/cursor.oo";

pub fn main() {
    let c0: Cursor = cursor_new("hello");
    let rem0: Int = cursor_remaining(c0);
    if rem0 != 5 {
        println("FAIL rem0");
        process_exit(1);
    }
    let r: Result[String, String] = cursor_read(c0, 2);
    if r.is_err() {
        println("FAIL read err");
        process_exit(1);
    }
    let chunk: String = r.unwrap();
    if chunk != "he" {
        println("FAIL read he");
        process_exit(1);
    }
    let c1: Cursor = cursor_advance(c0, 2);
    let rem1: Int = cursor_remaining(c1);
    if rem1 != 3 {
        println("FAIL rem1");
        process_exit(1);
    }
    println("prod_cursor: PASSED");
}
