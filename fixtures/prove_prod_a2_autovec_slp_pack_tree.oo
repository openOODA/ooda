// # Product prove std/compilers_polyhedral/autovec_slp_pack_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts slp_scalar_inst_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_slp_pack_tree.oo.
//
// Beats:
//   1. Call slp_scalar_inst_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_slp_pack_tree: PASSED only if they match.

import "std/compilers_polyhedral/autovec_slp_pack_tree.oo";

pub fn main() {
    let autovec_slp_pack_tree_mark: Int = 0;
    if autovec_slp_pack_tree_mark != 0 {
        process_exit(1);
    }
    let a: SlpScalarInstruction = slp_scalar_inst_new(0, 0, "x", "x", "x");
    let b: SlpScalarInstruction = slp_scalar_inst_new(0, 0, "x", "x", "x");
    if (a).inst_id != (b).inst_id {
        println("FAIL slp_scalar_inst_new");
        process_exit(1);
    }
    println("prod_autovec_slp_pack_tree: PASSED");
}
