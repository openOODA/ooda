// # Product prove std/formal_verif/sat_dpll_clause_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts sat_lit_neg is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/sat_dpll_clause_solver.oo.
//
// Beats:
//   1. Call sat_lit_neg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sat_dpll_clause_solver: PASSED only if they match.

import "std/formal_verif/sat_dpll_clause_solver.oo";

pub fn main() {
    let sat_dpll_clause_solver_mark: Int = 0;
    if sat_dpll_clause_solver_mark != 0 {
        process_exit(1);
    }
    let sat_dpll_clause_solver_a = sat_lit_neg(1);
    let sat_dpll_clause_solver_b = sat_lit_neg(1);
    if (sat_dpll_clause_solver_a).variable != (sat_dpll_clause_solver_b).variable {
        println("FAIL sat_lit_neg");
        process_exit(1);
    }
    println("prod_sat_dpll_clause_solver: PASSED");
}
