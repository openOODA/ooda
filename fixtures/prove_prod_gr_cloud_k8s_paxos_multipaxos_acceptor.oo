// # Product prove std/cloud_k8s/paxos_multipaxos_acceptor.oo
//
// Logline: Fail-closed emit+gcc+run asserts multipaxos_acceptor_accept is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/paxos_multipaxos_acceptor.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call multipaxos_acceptor_accept twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_paxos_multipaxos_acceptor: PASSED only if they match.

import "std/cloud_k8s/paxos_multipaxos_acceptor.oo";

pub fn main() {
    let mut g0_oa = multipaxos_acceptor_new("x");
    let mut g0_ob = multipaxos_acceptor_new("x");
    let g0_a = multipaxos_acceptor_accept(&g0_oa, 0, 0, "x");
    let g0_b = multipaxos_acceptor_accept(&g0_ob, 0, 0, "x");
    if g0_a != g0_b {
        println("FAIL multipaxos_acceptor_accept");
        process_exit(1);
    }
    println("prod_gr_paxos_multipaxos_acceptor: PASSED");
}
