// Pure Int arity-3 multi-arg fuzz pass fixture (M49).
// FUZZ_DOMAIN: int
// FUZZ_TARGET: multi3_add 0 20
// FUZZ_REQUIRES: multi3_add x >= 0 && y >= 0 && z >= 0
// FUZZ_ENSURES: multi3_add result == x + y + z
// FUZZ_ENSURES: multi3_add result >= x
// FUZZ_ENSURES: multi3_add result >= y
// FUZZ_ENSURES: multi3_add result >= z
fn multi3_add(x: Int, y: Int, z: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    requires z >= 0;
    ensures result == x + y + z;
    ensures result >= x;
    ensures result >= y;
    ensures result >= z;
    return x + y + z;
}

