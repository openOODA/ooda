// # Product prove std/quantum_tensor_nets/mera_multiscale_entanglement.oo
//
// Logline: Fail-closed emit+gcc+run asserts mera_disentangler_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/mera_multiscale_entanglement.oo.
//
// Beats:
//   1. Call mera_disentangler_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mera_multiscale_entanglement: PASSED only if they match.

import "std/quantum_tensor_nets/mera_multiscale_entanglement.oo";

pub fn main() {
    let mera_multiscale_entanglement_mark: Int = 0;
    if mera_multiscale_entanglement_mark != 0 {
        process_exit(1);
    }
    let a: MeraDisentangler = mera_disentangler_new(0, 0, 0);
    let b: MeraDisentangler = mera_disentangler_new(0, 0, 0);
    if (a).layer_index != (b).layer_index {
        println("FAIL mera_disentangler_new");
        process_exit(1);
    }
    println("prod_mera_multiscale_entanglement: PASSED");
}
