// # Refuse a secret function argument
//
// Logline: Passing a secret into a helper taints the returned value at println.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Return that argument from do_something.
//   3. Print the call result so the sink refuses.

// M113: function taking a secret propagates taint to result
// SECRET: api_key
pub fn do_something(key: String) -> String {
    return key;
}

pub fn main() {
    let api_key = "123";
    let y = do_something(api_key);
    println(y);
}
