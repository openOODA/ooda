// # Product prove std/fs/fs_ops.oo
//
// Logline: Fail-closed emit+gcc+run of FsOpResult after emit of fs_ops.
//
// Setup: Isolated emit-c. Imports std/fs/fs_ops.oo.
//
// Beats:
//   1. FsOpResult { success: true } success is true.
//   2. Exit 1 on miss. Print prod_fs_ops: PASSED only if it holds.

import "std/fs/fs_ops.oo";

pub fn main() {
    let fs_ops_a: FsOpResult = FsOpResult { success: true, error_message: "" };
    if fs_ops_a.success == false {
        println("FAIL fs_ops");
        process_exit(1);
    }
    println("prod_fs_ops: PASSED");
}
