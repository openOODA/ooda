// # Product prove std/lidar_perception/point_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/lidar_perception/point_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/point_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_point_types: PASSED only if they match.

import "std/lidar_perception/point_types.oo";

pub fn main() {
    let point_types_a = lidar_point_new(0, 0, 0);
    let point_types_b = lidar_point_new(0, 0, 0);
    let point_types_va = lidar_point_x(point_types_a);
    let point_types_vb = lidar_point_x(point_types_b);
    if point_types_va != point_types_vb {
        println("FAIL point_types");
        process_exit(1);
    }
    println("prod_ap_point_types: PASSED");
}
