// # Product prove std/sec/crypto/bulletproofs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_bulletproofs: PASSED and exit 0 only on match.

import "std/sec/crypto/bulletproofs.oo";

pub fn main() {
    let pow_a: Int = shim_marker_mod_pow();
    let pow_b: Int = shim_marker_mod_pow();
    if pow_a != pow_b {
        println("FAIL bulletproofs mod_pow");
        process_exit(1);
    }
    if pow_a != 15 {
        println("FAIL bulletproofs mod_pow value");
        process_exit(1);
    }

    let pcomm_a: PedersenCommitment = shim_marker_pedersen();
    let pcomm_b: PedersenCommitment = shim_marker_pedersen();
    if (pcomm_a).commitment != (pcomm_b).commitment {
        println("FAIL bulletproofs pedersen commitment");
        process_exit(1);
    }
    if (pcomm_a).is_valid != (pcomm_b).is_valid {
        println("FAIL bulletproofs pedersen is_valid");
        process_exit(1);
    }

    let gens_a: BulletproofGenerators = shim_marker_generators();
    let gens_b: BulletproofGenerators = shim_marker_generators();
    if (gens_a).is_valid != (gens_b).is_valid {
        println("FAIL bulletproofs generators is_valid");
        process_exit(1);
    }
    if (gens_a).gens_capacity != (gens_b).gens_capacity {
        println("FAIL bulletproofs generators capacity");
        process_exit(1);
    }

    let prov_a: BulletproofProver = shim_marker_prover_init();
    let prov_b: BulletproofProver = shim_marker_prover_init();
    if (prov_a).id != (prov_b).id {
        println("FAIL bulletproofs prover id");
        process_exit(1);
    }

    let ver_a: BulletproofVerifier = shim_marker_verifier_init();
    let ver_b: BulletproofVerifier = shim_marker_verifier_init();
    if (ver_a).id != (ver_b).id {
        println("FAIL bulletproofs verifier id");
        process_exit(1);
    }

    let work_a: Int = shim_marker_do_work(&prov_a, &ver_a);
    let work_b: Int = shim_marker_do_work(&prov_b, &ver_b);
    if work_a != work_b {
        println("FAIL bulletproofs do_work");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs: PASSED");
    process_exit(0);
}
