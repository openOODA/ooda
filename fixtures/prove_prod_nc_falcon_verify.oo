// # Product prove std/pqc_nist/falcon_verify.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_verify_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_verify.oo.
//
// Beats:
//   1. Call falcon_verify_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_falcon_verify: PASSED only if it matches.

import "std/pqc_nist/falcon_verify.oo";

pub fn main() {
    let a: Int = falcon_verify_probe();
    if a != 0 {
        println("FAIL falcon_verify_probe");
        process_exit(1);
    }
    println("prod_nc_falcon_verify: PASSED");
}
