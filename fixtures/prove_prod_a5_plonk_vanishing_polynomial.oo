// # Product prove std/zk_rollup/plonk_vanishing_polynomial.oo
//
// Logline: Fail-closed emit+gcc+run asserts vanishing_poly_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_vanishing_polynomial.oo.
//
// Beats:
//   1. Call vanishing_poly_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_vanishing_polynomial: PASSED only if they match.

import "std/zk_rollup/plonk_vanishing_polynomial.oo";

pub fn main() {
    let plonk_vanishing_polynomial_mark: Int = 0;
    if plonk_vanishing_polynomial_mark != 0 {
        process_exit(1);
    }
    let a: VanishingPolyConfig = vanishing_poly_config_new(0, 0, 0);
    let b: VanishingPolyConfig = vanishing_poly_config_new(0, 0, 0);
    if (a).domain_size != (b).domain_size {
        println("FAIL vanishing_poly_config_new");
        process_exit(1);
    }
    println("prod_plonk_vanishing_polynomial: PASSED");
}
