// # Product prove std/sec/sys/objcap_attenuate.oo
//
// Logline: Fail-closed emit+gcc+run asserts objcap_attenuation_validate is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_attenuate.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call objcap_attenuation_validate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_objcap_attenuate: PASSED only if they match.

import "std/sec/sys/objcap_attenuate.oo";

pub fn main() {
    let g0_oa = objcap_attenuation_create("x", "x", 0, "x", 0, 0);
    let g0_ob = objcap_attenuation_create("x", "x", 0, "x", 0, 0);
    let g0_a = objcap_attenuation_validate(&g0_oa, 0);
    let g0_b = objcap_attenuation_validate(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL objcap_attenuation_validate");
        process_exit(1);
    }
    println("prod_gr_objcap_attenuate: PASSED");
}
