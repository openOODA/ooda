// # Product prove std/iot_scada/dnp3_unsolicited_event.oo
//
// Logline: Fail-closed emit+gcc+run asserts dnp3_has_pending_events is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_unsolicited_event.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dnp3_has_pending_events twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dnp3_unsolicited_event: PASSED only if they match.

import "std/iot_scada/dnp3_unsolicited_event.oo";

pub fn main() {
    let g0_oa: Dnp3EventQueue = Dnp3EventQueue { class1_count: 0, class2_count: 0, class3_count: 0, max_queue_size: 0, unsolicited_enabled: true, unsolicited_seq: 0, pending_confirm: true, retry_count: 0 };
    let g0_ob: Dnp3EventQueue = Dnp3EventQueue { class1_count: 0, class2_count: 0, class3_count: 0, max_queue_size: 0, unsolicited_enabled: true, unsolicited_seq: 0, pending_confirm: true, retry_count: 0 };
    let g0_a = dnp3_has_pending_events(&g0_oa);
    let g0_b = dnp3_has_pending_events(&g0_ob);
    if g0_a != g0_b {
        println("FAIL dnp3_has_pending_events");
        process_exit(1);
    }
    println("prod_gr_dnp3_unsolicited_event: PASSED");
}
