// # Hostile hello println greet with no let
//
// Logline: Main prints greet of x with no let so emit-wasm must miss the hello fold.
//
// Setup: Same greet return shape as hello.oo. Verify still names World. Main has no let.
//
// Beats:
//   1. greet returns Hello, plus name plus !.
//   2. verify calls greet("World").
//   3. main only prints greet("x").
//
// residual: dummy end or ERR wasm is the honest miss.

pub fn greet(name: String) -> String {
    return "Hello, " + name + "!";
}

verify greet {
    assert_eq!(greet("World"), "Hello, World!");
}

pub fn main() {
    println(greet("x"));
}
