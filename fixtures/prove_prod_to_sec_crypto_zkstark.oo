// # Product prove std/sec/crypto/zkstark.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_mod_pow holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zkstark.oo.
//
// Beats:
//   1. Call shim_marker_mod_pow using the zkstark ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_zkstark: PASSED only if asserts hold.

import "std/sec/crypto/zkstark.oo";

pub fn main() {
    let zkstark_a = shim_marker_mod_pow();
    let zkstark_b = shim_marker_mod_pow();
    if zkstark_a != zkstark_b {
        println("FAIL shim_marker_mod_pow");
        process_exit(1);
    }
    println("prod_zkstark: PASSED");
}
