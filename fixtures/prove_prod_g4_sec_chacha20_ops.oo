// # Product prove std/sec/crypto/chacha20_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/chacha20_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20_ops.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_chacha20_ops: PASSED and exit 0 only on match.

import "std/sec/crypto/chacha20_ops.oo";

pub fn main() {
    let chk_a: Int = checksum_calculate("0123456789abcdef0123456789abcdef");
    let chk_b: Int = checksum_calculate("0123456789abcdef0123456789abcdef");
    if chk_a != chk_b {
        println("FAIL chacha20_ops checksum_calculate");
        process_exit(1);
    }

    let hpair_a: String = byte_to_hex_pair(255);
    let hpair_b: String = byte_to_hex_pair(255);
    if hpair_a != hpair_b || hpair_a != "ff" {
        println("FAIL chacha20_ops byte_to_hex_pair");
        process_exit(1);
    }

    let hval_a: Int = hex_char_to_val(97);
    let hval_b: Int = hex_char_to_val(97);
    if hval_a != hval_b || hval_a != 10 {
        println("FAIL chacha20_ops hex_char_to_val");
        process_exit(1);
    }

    let enc_a: String = hex_encode("hello");
    let enc_b: String = hex_encode("hello");
    if enc_a != enc_b || enc_a != "68656c6c6f" {
        println("FAIL chacha20_ops hex_encode");
        process_exit(1);
    }

    let dec_res_a: Result[String, String] = hex_decode("68656c6c6f");
    let dec_res_b: Result[String, String] = hex_decode("68656c6c6f");
    let dec_str_a: String = match dec_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let dec_str_b: String = match dec_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec_str_a != dec_str_b || dec_str_a != "hello" {
        println("FAIL chacha20_ops hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = bytes_constant_time_eq("secretkey123", "secretkey123");
    let eq_b: Bool = bytes_constant_time_eq("secretkey123", "wrongkey1234");
    if !eq_a || eq_b {
        println("FAIL chacha20_ops bytes_constant_time_eq");
        process_exit(1);
    }

    let pad_a: String = pad_to_16_bytes("1234567890");
    let pad_b: String = pad_to_16_bytes("1234567890");
    if pad_a != pad_b || pad_a.len() != 16 {
        println("FAIL chacha20_ops pad_to_16_bytes");
        process_exit(1);
    }

    let key_res: Result[ChaChaKey, String] = chacha_key_create("k1", "01234567890123456789012345678901");
    let key: ChaChaKey = match key_res {
        Ok(k) => k,
        Err(_) => {
            println("FAIL chacha20_ops chacha_key_create");
            process_exit(1);
        },
    };
    let k_valid: Bool = chacha_key_validate(&key);
    if !k_valid {
        println("FAIL chacha20_ops chacha_key_validate");
        process_exit(1);
    }

    let nonce_res: Result[ChaChaNonce, String] = chacha_nonce_create("n1", "012345678901");
    let nonce: ChaChaNonce = match nonce_res {
        Ok(n) => n,
        Err(_) => {
            println("FAIL chacha20_ops chacha_nonce_create");
            process_exit(1);
        },
    };
    let n_valid: Bool = chacha_nonce_validate(&nonce);
    if !n_valid {
        println("FAIL chacha20_ops chacha_nonce_validate");
        process_exit(1);
    }

    let tag_res: Result[Poly1305Tag, String] = poly1305_tag_create("0123456789012345");
    let tag: Poly1305Tag = match tag_res {
        Ok(t) => t,
        Err(_) => {
            println("FAIL chacha20_ops poly1305_tag_create");
            process_exit(1);
        },
    };
    let t_valid: Bool = poly1305_tag_validate(&tag);
    if !t_valid {
        println("FAIL chacha20_ops poly1305_tag_validate");
        process_exit(1);
    }

    println("prod_g4_sec_chacha20_ops: PASSED");
    process_exit(0);
}
