// # Product prove std/astrophysics_relativity/gr_kerr_metric.oo
//
// Logline: Fail-closed emit+gcc+run asserts kerr_spacetime_evaluate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_kerr_metric.oo.
//
// Beats:
//   1. Call kerr_spacetime_evaluate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_kerr_metric: PASSED only if they match.

import "std/astrophysics_relativity/gr_kerr_metric.oo";

pub fn main() {
    let gr_kerr_metric_mark: Int = 0;
    if gr_kerr_metric_mark != 0 {
        process_exit(1);
    }
    let a: KerrSpacetimeGeometry = kerr_spacetime_evaluate(0, 0, 0, 0);
    let b: KerrSpacetimeGeometry = kerr_spacetime_evaluate(0, 0, 0, 0);
    if (a).mass != (b).mass {
        println("FAIL kerr_spacetime_evaluate");
        process_exit(1);
    }
    println("prod_gr_kerr_metric: PASSED");
}
