// # Product prove std/fin/var_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/var_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_var_types: PASSED only if they match.

import "std/fin/var_types.oo";

pub fn main() {
    let var_types_a = var_result_new(0, 0, 0);
    let var_types_b = var_result_new(0, 0, 0);
    let var_types_va = var_result_bps(var_types_a);
    let var_types_vb = var_result_bps(var_types_b);
    if var_types_va != var_types_vb {
        println("FAIL var_types");
        process_exit(1);
    }
    println("prod_ap_var_types: PASSED");
}
