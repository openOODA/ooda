// # Product prove std/db_storage/wal_doublewrite_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/wal_doublewrite_buffer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_doublewrite_buffer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_wal_doublewrite_buffer: PASSED only if they match.

import "std/db_storage/wal_doublewrite_buffer.oo";

pub fn main() {
    let wal_doublewrite_buffer_a = doublewrite_buffer_new(0);
    let wal_doublewrite_buffer_b = doublewrite_buffer_new(0);
    if wal_doublewrite_buffer_a.total_slots != wal_doublewrite_buffer_b.total_slots {
        println("FAIL wal_doublewrite_buffer");
        process_exit(1);
    }
    println("prod_ap_wal_doublewrite_buffer: PASSED");
}
