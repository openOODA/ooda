// # Product prove std/sec/sys/pe_parse.oo
//
// Logline: Fail-closed emit+gcc+run asserts pe_parse_dos_header value or determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_parse.oo.
//
// Beats:
//   1. Call pe_parse_dos_header twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pe_parse: PASSED only if asserts hold.

import "std/sec/sys/pe_parse.oo";

pub fn main() {
    let pe_parse_a = pe_parse_dos_header("x");
    let pe_parse_b = pe_parse_dos_header("x");
    if pe_parse_a.is_err() != pe_parse_b.is_err() {
        println("FAIL pe_parse_dos_header");
        process_exit(1);
    }
    println("prod_pe_parse: PASSED");
}
