// # Product os file mode perms prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/os/file_mode_perms.oo.
//
// Setup: Product std/os/file_mode_perms.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. 0644 owner read yes exec no. string rw-r--r--. triplet r-x.
//   9. Exit 1 before PASSED on a miss.

import "std/os/file_mode_perms.oo";

pub fn main() {
    let mode: Int = 420;
    if file_mode_has_owner_read(mode) == false {
        println("FAIL fmode read");
        process_exit(1);
    }
    if file_mode_has_owner_exec(mode) {
        println("FAIL fmode exec");
        process_exit(1);
    }
    let s: String = file_mode_to_string(mode);
    if s != "rw-r--r--" {
        println("FAIL fmode str");
        process_exit(1);
    }
    let t: String = file_mode_to_rwx_triplet(true, false, true);
    if t != "r-x" {
        println("FAIL fmode trip");
        process_exit(1);
    }
    println("prod_fmode: PASSED");
}
