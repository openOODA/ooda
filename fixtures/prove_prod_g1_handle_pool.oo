// # Product prove std/perf/handle_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts handle_pool_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/handle_pool.oo.
//
// Beats:
//   1. Call handle_pool_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_handle_pool: PASSED only if they match.

import "std/perf/handle_pool.oo";

pub fn main() {
    let a: HandlePool = handle_pool_create("x");
    let b: HandlePool = handle_pool_create("x");
    if a.next_id != b.next_id {
        println("FAIL handle_pool_create");
        process_exit(1);
    }
    println("prod_handle_pool: PASSED");
}
