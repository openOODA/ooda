// # Product prove std/physics/fluid_particle.oo
//
// Logline: Fail-closed emit+gcc+run asserts fluid_particle_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/fluid_particle.oo.
//
// Beats:
//   1. Call fluid_particle_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fluid_particle: PASSED only if they match.

import "std/physics/fluid_particle.oo";

pub fn main() {
    let a: Int = fluid_particle_probe();
    let b: Int = fluid_particle_probe();
    if a != b {
        println("FAIL fluid_particle_probe");
        process_exit(1);
    }
    println("prod_g2_fluid_particle: PASSED");
}
