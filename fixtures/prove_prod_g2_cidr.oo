// # Product prove std/net/cidr.oo
//
// Logline: Fail-closed emit+gcc+run asserts cidr_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/cidr.oo.
//
// Beats:
//   1. Call cidr_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cidr: PASSED only if they match.

import "std/net/cidr.oo";

pub fn main() {
    let a: Ipv4Cidr = cidr_new(0, 0, 0, 0, 0);
    let b: Ipv4Cidr = cidr_new(0, 0, 0, 0, 0);
    if (a).a != (b).a {
        println("FAIL cidr_new");
        process_exit(1);
    }
    println("prod_g2_cidr: PASSED");
}
