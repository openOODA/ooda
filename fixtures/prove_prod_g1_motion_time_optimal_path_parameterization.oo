// # Product prove std/robotics_ros2/motion_time_optimal_path_parameterization.oo
//
// Logline: Fail-closed emit+gcc+run asserts topp_path_segment_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_time_optimal_path_parameterization.oo.
//
// Beats:
//   1. Call topp_path_segment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_motion_time_optimal_path_parameterization: PASSED only if they match.

import "std/robotics_ros2/motion_time_optimal_path_parameterization.oo";

pub fn main() {
    let a: ToppPathSegment = topp_path_segment_new(0.0, 0.0, 0.0, 0.0);
    let b: ToppPathSegment = topp_path_segment_new(0.0, 0.0, 0.0, 0.0);
    if a.s_start != b.s_start {
        println("FAIL topp_path_segment_new");
        process_exit(1);
    }
    println("prod_motion_time_optimal_path_parameterization: PASSED");
}
