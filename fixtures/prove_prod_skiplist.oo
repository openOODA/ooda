// # Product skip_list prove
import "std/collections/skip_list.oo";
pub fn main() {
    let mut s: SkipList = skip_list_new();
    s = skip_list_insert(s, 7, 1);
    let n: Int = skip_list_len(s);
    if n != 1 {
        println("FAIL skiplist len");
        process_exit(1);
    }
    let c7: Bool = skip_list_contains(s, 7);
    if c7 == false {
        println("FAIL skiplist 7");
        process_exit(1);
    }
    let c3: Bool = skip_list_contains(s, 3);
    if c3 == true {
        println("FAIL skiplist 3");
        process_exit(1);
    }
    println("prod_skiplist: PASSED");
}
