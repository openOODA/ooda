// # Product prove std/formal_verif/separation_logic_heap.oo
//
// Logline: Fail-closed emit+gcc+run asserts frame_rule_check is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/separation_logic_heap.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call frame_rule_check twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_separation_logic_heap: PASSED only if they match.

import "std/formal_verif/separation_logic_heap.oo";

pub fn main() {
    let g0_a = frame_rule_check(true, true);
    let g0_b = frame_rule_check(true, true);
    if g0_a != g0_b {
        println("FAIL frame_rule_check");
        process_exit(1);
    }
    println("prod_gr_separation_logic_heap: PASSED");
}
