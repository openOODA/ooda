// # Product prove std/db_columnar/columnar_expression_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts expr_node_col_plus_scalar is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_expression_evaluator.oo.
//
// Beats:
//   1. Call expr_node_col_plus_scalar twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_columnar_expression_evaluator: PASSED only if they match.

import "std/db_columnar/columnar_expression_evaluator.oo";

pub fn main() {
    let columnar_expression_evaluator_mark: Int = 0;
    if columnar_expression_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: ExprNode = expr_node_col_plus_scalar(0, 0);
    let b: ExprNode = expr_node_col_plus_scalar(0, 0);
    if (a).op_type != (b).op_type {
        println("FAIL expr_node_col_plus_scalar");
        process_exit(1);
    }
    println("prod_g2_columnar_expression_evaluator: PASSED");
}
