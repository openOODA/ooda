// # Product prove std/quantum_open_systems/lindblad_master_equation_ode.oo
//
// Logline: Fail-closed emit+gcc+run asserts c_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/lindblad_master_equation_ode.oo.
//
// Beats:
//   1. Call c_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lindblad_master_equation_ode: PASSED only if they match.

import "std/quantum_open_systems/lindblad_master_equation_ode.oo";

pub fn main() {
    let lindblad_master_equation_ode_mark: Int = 0;
    if lindblad_master_equation_ode_mark != 0 {
        process_exit(1);
    }
    let a: Complex = c_new(0.0, 0.0);
    let b: Complex = c_new(0.0, 0.0);
    if (a).real != (b).real {
        println("FAIL c_new");
        process_exit(1);
    }
    println("prod_lindblad_master_equation_ode: PASSED");
}
