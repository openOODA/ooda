// # Two statement matches share bind names
//
// Logline: Two statement matches in one function bind Ok(v) without reusing one slot.
//
// Setup: Backend-LLVM. Distinct %v.*.slot names.
//
// Beats:
//   1. Match Ok(7) into a.
//   2. Match Ok(8) into b with the same bind names.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let r1: Result[Int, String] = Ok(7);
    let r2: Result[Int, String] = Ok(8);
    let mut a: Int = 0;
    let mut b: Int = 0;
    match r1 {
        Ok(v) => { a = v; }
        Err(e) => { a = 0; }
    }
    match r2 {
        Ok(v) => { b = v; }
        Err(e) => { b = 0; }
    }
    if a != 7 {
        println("FAIL");
        process_exit(1);
    }
    if b != 8 {
        println("FAIL");
        process_exit(1);
    }
    println("llvm_two_match: PASSED");
}
