// # Product prove std/iot_scada/opcua_variant_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_variant_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_variant_types.oo.
//
// Beats:
//   1. Call opcua_variant_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opcua_variant_types: PASSED only if they match.

import "std/iot_scada/opcua_variant_types.oo";

pub fn main() {
    let opcua_variant_types_mark: Int = 0;
    if opcua_variant_types_mark != 0 {
        process_exit(1);
    }
    let a: OpcUaVariant = opcua_variant_new(0, 0);
    let b: OpcUaVariant = opcua_variant_new(0, 0);
    if (a).kind != (b).kind {
        println("FAIL opcua_variant_new");
        process_exit(1);
    }
    println("prod_opcua_variant_types: PASSED");
}
