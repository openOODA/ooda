// # Product prove std/mesh_ebpf/ebpf_kprobe_tracer.oo
//
// Logline: Fail-closed emit+gcc+run asserts eBPF kprobe tracer execution and latency tracking are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_kprobe_tracer.oo.
//
// Beats:
//   1. Initialize tracer state with slow threshold.
//   2. Record function entry and exit probe events.
//   3. Assert deterministic latency calculation and slow trace flagging.
//   4. Print prod_g4_ebpf_kprobe: PASSED and exit 0.

import "std/mesh_ebpf/ebpf_kprobe_tracer.oo";

pub fn main() {
    let mut tracer: KprobeTracerState = kprobe_tracer_new(5000);
    if (tracer).slow_threshold_ns != 5000 {
        println("FAIL kprobe_tracer_new threshold");
        process_exit(1);
    }
    if (tracer).total_traces != 0 {
        println("FAIL kprobe_tracer_new total_traces");
        process_exit(1);
    }

    kprobe_on_enter(&mut tracer, 1001, 42, 10000, 10, 20);
    let res_fast: KretprobeResult = kretprobe_on_exit(&mut tracer, 1001, 42, 12000, 0);
    if (res_fast).duration_ns != 2000 {
        println("FAIL kretprobe_on_exit fast duration");
        process_exit(1);
    }
    if (res_fast).is_slow {
        println("FAIL kretprobe_on_exit fast is_slow");
        process_exit(1);
    }
    if (res_fast).ret_code != 0 {
        println("FAIL kretprobe_on_exit fast ret_code");
        process_exit(1);
    }

    kprobe_on_enter(&mut tracer, 1002, 42, 20000, 10, 20);
    let res_slow: KretprobeResult = kretprobe_on_exit(&mut tracer, 1002, 42, 28000, 0);
    if (res_slow).duration_ns != 8000 {
        println("FAIL kretprobe_on_exit slow duration");
        process_exit(1);
    }
    if !(res_slow).is_slow {
        println("FAIL kretprobe_on_exit slow is_slow");
        process_exit(1);
    }

    if (tracer).total_traces != 2 {
        println("FAIL tracer total_traces");
        process_exit(1);
    }
    if (tracer).slow_traces != 1 {
        println("FAIL tracer slow_traces");
        process_exit(1);
    }

    println("prod_g4_ebpf_kprobe: PASSED");
    process_exit(0);
}
