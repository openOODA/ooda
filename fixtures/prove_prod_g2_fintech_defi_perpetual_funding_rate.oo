// # Product prove std/fintech_defi/perpetual_funding_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts perp_market_state_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/perpetual_funding_rate.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call perp_market_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_perpetual_funding_rate: PASSED only if they match.

import "std/fintech_defi/perpetual_funding_rate.oo";

pub fn main() {
    let g2_oa: PerpMarketState = perp_market_state_new("x", 2, 2);
    let g2_ob: PerpMarketState = perp_market_state_new("x", 2, 2);
    let g2_a = (g2_oa).index_price;
    let g2_b = (g2_ob).index_price;
    if g2_a != g2_b {
        println("FAIL perp_market_state_new.index_price");
        process_exit(1);
    }
    println("prod_g2_perpetual_funding_rate: PASSED");
}
