// # Product prove std/cloud_faas/provisioned_concurrency_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts provisioned_concurrency_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/provisioned_concurrency_manager.oo.
//
// Beats:
//   1. Call provisioned_concurrency_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_provisioned_concurrency_manager: PASSED only if they match.

import "std/cloud_faas/provisioned_concurrency_manager.oo";

pub fn main() {
    let a: ProvisionedConcurrencyManager = provisioned_concurrency_manager_new(0, 0);
    let b: ProvisionedConcurrencyManager = provisioned_concurrency_manager_new(0, 0);
    if (a).function_id != (b).function_id {
        println("FAIL provisioned_concurrency_manager_new");
        process_exit(1);
    }
    println("prod_provisioned_concurrency_manager: PASSED");
}
