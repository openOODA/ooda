// # Product prove std/sec/crypto/hsm_pkcs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/hsm_pkcs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_pkcs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_hsm_pkcs: PASSED and exit 0 only on match.

import "std/sec/crypto/hsm_pkcs.oo";

pub fn main() {
    let handle_a: KeyHandle = hsm_handle_new(101, 555, 1);
    let handle_b: KeyHandle = hsm_handle_new(101, 555, 1);
    if (handle_a).handle_id != (handle_b).handle_id || (handle_a).handle_id != 101 {
        println("FAIL hsm_pkcs hsm_handle_new");
        process_exit(1);
    }

    let id_a: Int = hsm_handle_id(handle_a);
    let id_b: Int = hsm_handle_id(handle_b);
    if id_a != id_b || id_a != 101 {
        println("FAIL hsm_pkcs hsm_handle_id");
        process_exit(1);
    }

    let eng_h_a: KeyHandle = hsm_engine_init(202, 777, 1);
    let eng_h_b: KeyHandle = hsm_engine_init(202, 777, 1);
    if (eng_h_a).checksum != (eng_h_b).checksum || (eng_h_a).checksum != 777 {
        println("FAIL hsm_pkcs hsm_engine_init");
        process_exit(1);
    }

    let work_a: Int = hsm_engine_work(202, 777, 1);
    let work_b: Int = hsm_engine_work(202, 777, 1);
    if work_a != work_b || work_a != 980 {
        println("FAIL hsm_pkcs hsm_engine_work");
        process_exit(1);
    }

    println("prod_g4_sec_hsm_pkcs: PASSED");
    process_exit(0);
}
