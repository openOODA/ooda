// # Product prove std/quantum_advanced/quantum_state_tomography.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_state_tomography_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_state_tomography.oo.
//
// Beats:
//   1. Call quantum_state_tomography_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_quantum_state_tomography: PASSED only if it matches.

import "std/quantum_advanced/quantum_state_tomography.oo";

pub fn main() {
    let a: Int = quantum_state_tomography_probe();
    if a != 0 {
        println("FAIL quantum_state_tomography_probe");
        process_exit(1);
    }
    println("prod_nc_quantum_state_tomography: PASSED");
}
