// # Product prove std/db_graph/opencypher_ast_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_parse_match_pattern is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_ast_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call cypher_parse_match_pattern twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_opencypher_ast_parser: PASSED only if they match.

import "std/db_graph/opencypher_ast_parser.oo";

pub fn main() {
    let g0_oa = cypher_parse_match_pattern("x", "x", "x", "x", "x");
    let g0_ob = cypher_parse_match_pattern("x", "x", "x", "x", "x");
    let g0_a = (g0_oa).is_optional;
    let g0_b = (g0_ob).is_optional;
    if g0_a != g0_b {
        println("FAIL cypher_parse_match_pattern.is_optional");
        process_exit(1);
    }
    println("prod_gr_opencypher_ast_parser: PASSED");
}
