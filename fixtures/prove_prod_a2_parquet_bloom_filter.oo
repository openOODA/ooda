// # Product prove std/db_columnar/parquet_bloom_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts bloom_filter_hash_string is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_bloom_filter.oo.
//
// Beats:
//   1. Call bloom_filter_hash_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_bloom_filter: PASSED only if they match.

import "std/db_columnar/parquet_bloom_filter.oo";

pub fn main() {
    let parquet_bloom_filter_mark: Int = 0;
    if parquet_bloom_filter_mark != 0 {
        process_exit(1);
    }
    let a: Int = bloom_filter_hash_string("x");
    let b: Int = bloom_filter_hash_string("x");
    if a != b {
        println("FAIL bloom_filter_hash_string");
        process_exit(1);
    }
    println("prod_parquet_bloom_filter: PASSED");
}
