// # Product prove std/sec/net/waf_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_engine_ready is 1.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_engine.oo.
//
// Beats:
//   1. waf_engine_ready() is 1.
//   2. Exit 1 on miss. Print prod_ap_waf_engine: PASSED only if it holds.

import "std/sec/net/waf_engine.oo";

pub fn main() {
    let waf_engine_a = waf_engine_ready();
    if waf_engine_a != 1 {
        println("FAIL waf_engine");
        process_exit(1);
    }
    println("prod_ap_waf_engine: PASSED");
}
