// # Fail two loops on one MaxCycles budget
//
// Logline: Two short whiles each fit alone but together spend past the shared cap.
//
// Beats:
//   1. Honor the line-start fuel directive as one shared budget.
//   2. Run two three-step loops that would each pass in isolation.
//   3. Sum past five cycles so the rail refuses.

// M58 shared fuel: two whiles share one budget (each alone under N, sum over)
// MAX_CYCLES: 5
pub fn main() {
    let mut a = 0;
    while a < 3 {
        a = a + 1;
    }
    let mut b = 0;
    while b < 3 {
        b = b + 1;
    }
    println(a + b);
}
