// # Product prove std/space_propulsion/rocket_injector_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts injector_compute_hydraulics is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_injector_dynamics.oo.
//
// Beats:
//   1. Call injector_compute_hydraulics twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_injector_dynamics: PASSED only if they match.

import "std/space_propulsion/rocket_injector_dynamics.oo";

pub fn main() {
    let rocket_injector_dynamics_mark: Int = 0;
    if rocket_injector_dynamics_mark != 0 {
        process_exit(1);
    }
    let rocket_injector_dynamics_a = injector_compute_hydraulics(injector_coaxial_swirl_default(), 1.0, 1.0);
    let rocket_injector_dynamics_b = injector_compute_hydraulics(injector_coaxial_swirl_default(), 1.0, 1.0);
    if (rocket_injector_dynamics_a).vel_ox_m_s != (rocket_injector_dynamics_b).vel_ox_m_s {
        println("FAIL injector_compute_hydraulics");
        process_exit(1);
    }
    println("prod_rocket_injector_dynamics: PASSED");
}
