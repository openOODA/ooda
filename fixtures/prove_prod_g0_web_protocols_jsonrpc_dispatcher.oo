// # Product prove std/web_protocols/jsonrpc_dispatcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts jsonrpc_dispatcher_has_method is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/jsonrpc_dispatcher.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call jsonrpc_dispatcher_has_method twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_jsonrpc_dispatcher: PASSED only if they match.

import "std/web_protocols/jsonrpc_dispatcher.oo";

pub fn main() {
    let g0_oa = jsonrpc_dispatcher_new();
    let g0_ob = jsonrpc_dispatcher_new();
    let g0_a = jsonrpc_dispatcher_has_method(g0_oa, 2);
    let g0_b = jsonrpc_dispatcher_has_method(g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL jsonrpc_dispatcher_has_method");
        process_exit(1);
    }
    println("prod_g0_jsonrpc_dispatcher: PASSED");
}
