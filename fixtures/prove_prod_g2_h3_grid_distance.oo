// # Product prove std/gis_topo/h3_grid_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts h3_coord_ij_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/h3_grid_distance.oo.
//
// Beats:
//   1. Call h3_coord_ij_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_h3_grid_distance: PASSED only if they match.

import "std/gis_topo/h3_grid_distance.oo";

pub fn main() {
    let h3_grid_distance_mark: Int = 0;
    if h3_grid_distance_mark != 0 {
        process_exit(1);
    }
    let a: H3CoordIJ = h3_coord_ij_new(0, 0);
    let b: H3CoordIJ = h3_coord_ij_new(0, 0);
    if (a).i != (b).i {
        println("FAIL h3_coord_ij_new");
        process_exit(1);
    }
    println("prod_g2_h3_grid_distance: PASSED");
}
