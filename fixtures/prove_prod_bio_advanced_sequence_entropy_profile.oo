// # Product prove std/bio_advanced/sequence_entropy_profile.oo
//
// Logline: Fail-closed emit+check asserts entropy_log2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_entropy_profile.oo.
//
// Beats:
//   1. Call entropy_log2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sequence_entropy_profile: PASSED only if they match.

import "std/bio_advanced/sequence_entropy_profile.oo";

pub fn main() {
    let sequence_entropy_profile_mark: Int = 0;
    if sequence_entropy_profile_mark != 0 { process_exit(1); }
    let a: Float = entropy_log2(0.5);
    let b: Float = entropy_log2(0.5);
    if a != b { process_exit(1); }
    println("prod_sequence_entropy_profile: PASSED");
}
