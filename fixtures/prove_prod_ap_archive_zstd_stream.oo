// # Product prove std/archive/zstd_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/zstd_stream.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zstd_stream.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zstd_stream: PASSED only if they match.

import "std/archive/zstd_stream.oo";

pub fn main() {
    let zstd_stream_a = zstd_check_magic("x");
    let zstd_stream_b = zstd_check_magic("x");
    if zstd_stream_a != zstd_stream_b {
        println("FAIL zstd_stream");
        process_exit(1);
    }
    println("prod_ap_zstd_stream: PASSED");
}
