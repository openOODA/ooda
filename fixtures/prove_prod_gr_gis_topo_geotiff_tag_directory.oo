// # Product prove std/gis_topo/geotiff_tag_directory.oo
//
// Logline: Fail-closed emit+gcc+run asserts geotiff_tag_is_geokey is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geotiff_tag_directory.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call geotiff_tag_is_geokey twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_geotiff_tag_directory: PASSED only if they match.

import "std/gis_topo/geotiff_tag_directory.oo";

pub fn main() {
    let g0_a = geotiff_tag_is_geokey(0);
    let g0_b = geotiff_tag_is_geokey(0);
    if g0_a != g0_b {
        println("FAIL geotiff_tag_is_geokey");
        process_exit(1);
    }
    println("prod_gr_geotiff_tag_directory: PASSED");
}
