// # Product prove std/quantum_open_systems/continuous_lyapunov_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix2x2_real_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/continuous_lyapunov_equation.oo.
//
// Beats:
//   1. Call matrix2x2_real_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_continuous_lyapunov_equation: PASSED only if they match.

import "std/quantum_open_systems/continuous_lyapunov_equation.oo";

pub fn main() {
    let continuous_lyapunov_equation_mark: Int = 0;
    if continuous_lyapunov_equation_mark != 0 {
        process_exit(1);
    }
    let a: Matrix2x2Real = matrix2x2_real_new(0.0, 0.0, 0.0, 0.0);
    let b: Matrix2x2Real = matrix2x2_real_new(0.0, 0.0, 0.0, 0.0);
    if (a).m00 != (b).m00 {
        println("FAIL matrix2x2_real_new");
        process_exit(1);
    }
    println("prod_continuous_lyapunov_equation: PASSED");
}
