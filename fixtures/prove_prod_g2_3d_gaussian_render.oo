// # Product prove std/3d/gaussian_render.oo
//
// Logline: Fail-closed emit+gcc+run asserts gauss_rend_w is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_render.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gauss_rend_w twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gaussian_render: PASSED only if they match.

import "std/3d/gaussian_render.oo";

pub fn main() {
    let g2_oa = gauss_rend_new(2, 2);
    let g2_ob = gauss_rend_new(2, 2);
    let g2_a = gauss_rend_w(g2_oa);
    let g2_b = gauss_rend_w(g2_ob);
    if g2_a != g2_b {
        println("FAIL gauss_rend_w");
        process_exit(1);
    }
    println("prod_g2_gaussian_render: PASSED");
}
