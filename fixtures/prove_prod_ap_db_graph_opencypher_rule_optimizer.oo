// # Product prove std/db_graph/opencypher_rule_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_rule_optimizer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_rule_optimizer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_rule_optimizer: PASSED only if they match.

import "std/db_graph/opencypher_rule_optimizer.oo";

pub fn main() {
    let opencypher_rule_optimizer_a = optimization_rule_new(0, "x");
    let opencypher_rule_optimizer_b = optimization_rule_new(0, "x");
    if opencypher_rule_optimizer_a.rule_id != opencypher_rule_optimizer_b.rule_id {
        println("FAIL opencypher_rule_optimizer");
        process_exit(1);
    }
    println("prod_ap_opencypher_rule_optimizer: PASSED");
}
