// # Product prove std/web_protocols/rtcp_sr_rr.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtcp_is_sender_report is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/rtcp_sr_rr.oo.
//
// Beats:
//   1. Call rtcp_is_sender_report twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtcp_sr_rr: PASSED only if they match.

import "std/web_protocols/rtcp_sr_rr.oo";

pub fn main() {
    let rtcp_sr_rr_mark: Int = 0;
    if rtcp_sr_rr_mark != 0 {
        process_exit(1);
    }
    let a: Int = rtcp_is_sender_report(0);
    let b: Int = rtcp_is_sender_report(0);
    if a != b {
        println("FAIL rtcp_is_sender_report");
        process_exit(1);
    }
    println("prod_rtcp_sr_rr: PASSED");
}
