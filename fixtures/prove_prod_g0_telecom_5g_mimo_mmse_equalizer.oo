// # Product prove std/telecom_5g/mimo_mmse_equalizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_mmse_reg_det is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_mmse_equalizer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mimo_mmse_reg_det twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_mimo_mmse_equalizer: PASSED only if they match.

import "std/telecom_5g/mimo_mmse_equalizer.oo";

pub fn main() {
    let g0_a = mimo_mmse_reg_det(1.0, 1.0, 1.0, 1.0);
    let g0_b = mimo_mmse_reg_det(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL mimo_mmse_reg_det");
        process_exit(1);
    }
    println("prod_g0_mimo_mmse_equalizer: PASSED");
}
