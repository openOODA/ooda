// # Product sync spsc queue prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/spsc_queue.oo.
//
// Setup: Product std/sync/spsc_queue.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New cap 8 len 0 empty. Cap 0 clamps to 1.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/spsc_queue.oo";

pub fn main() {
    let q: SpscQueue = spsc_new(8);
    let c: Int = spsc_capacity(q);
    if c != 8 {
        println("FAIL spsc cap");
        process_exit(1);
    }
    let n: Int = spsc_len(q);
    if n != 0 {
        println("FAIL spsc len");
        process_exit(1);
    }
    if spsc_is_empty(q) == false {
        println("FAIL spsc empty");
        process_exit(1);
    }
    if spsc_is_full(q) {
        println("FAIL spsc full");
        process_exit(1);
    }
    let q1: SpscQueue = spsc_new(0);
    let c1: Int = spsc_capacity(q1);
    if c1 != 1 {
        println("FAIL spsc clamp");
        process_exit(1);
    }
    println("prod_spsc: PASSED");
}
