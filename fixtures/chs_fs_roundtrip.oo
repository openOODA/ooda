// # CHS filesystem roundtrip
//
// Logline: Write a temp file through FsCap and print chs-m0-ok when the read succeeds.
//
// Beats:
//   1. Write "chs-m0-ok" to the temp path.
//   2. Read the same path back.
//   3. Print chs-m0-ok or a fail tag.

// M0 CHS: real FsCap disk I/O (no match — Backend-C match residual).
// Rail: scripts/caps_matrix_smoke.sh / manual oodac build.
pub fn main(fs: &FsCap) {
    let path = "/tmp/ooda_chs_fs_roundtrip.txt";
    let w = write_file(fs, path, "chs-m0-ok");
    if w.is_ok() {
        let r = read_file(fs, path);
        if r.is_ok() {
            println("chs-m0-ok");
        } else {
            println("read_fail");
        }
    } else {
        println("write_fail");
    }
}
