// M0 CHS: real FsCap disk I/O (no match — Backend-C match residual).
// Rail: scripts/caps_matrix_smoke.sh / manual oodac build.
pub fn main(fs: &FsCap) {
    let path = "/tmp/ooda_chs_fs_roundtrip.txt";
    let w = write_file(fs, path, "chs-m0-ok");
    if w.is_ok() {
        let r = read_file(fs, path);
        if r.is_ok() {
            println("chs-m0-ok");
        } else {
            println("read_fail");
        }
    } else {
        println("write_fail");
    }
}
