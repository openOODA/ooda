// # Product prove std/compilers_vm/wasm_leb128_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_leb128_codec.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_leb128_codec.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_leb128_codec: PASSED only if they match.

import "std/compilers_vm/wasm_leb128_codec.oo";

pub fn main() {
    let wasm_leb128_codec_a = encode_u32_leb128(0);
    let wasm_leb128_codec_b = encode_u32_leb128(0);
    if list_len(wasm_leb128_codec_a) != list_len(wasm_leb128_codec_b) {
        println("FAIL wasm_leb128_codec");
        process_exit(1);
    }
    println("prod_ap_wasm_leb128_codec: PASSED");
}
