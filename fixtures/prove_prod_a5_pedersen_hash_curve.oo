// # Product prove std/zk_rollup/pedersen_hash_curve.oo
//
// Logline: Fail-closed emit+gcc+run asserts pedersen_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/pedersen_hash_curve.oo.
//
// Beats:
//   1. Call pedersen_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pedersen_hash_curve: PASSED only if they match.

import "std/zk_rollup/pedersen_hash_curve.oo";

pub fn main() {
    let pedersen_hash_curve_mark: Int = 0;
    if pedersen_hash_curve_mark != 0 {
        process_exit(1);
    }
    let a: PedersenPoint = pedersen_point_new(0, 0);
    let b: PedersenPoint = pedersen_point_new(0, 0);
    if (a).x != (b).x {
        println("FAIL pedersen_point_new");
        process_exit(1);
    }
    println("prod_pedersen_hash_curve: PASSED");
}
