// # Product prove std/sec/sys/pe_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts pe_dos_magic is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_types.oo.
//
// Beats:
//   1. Call pe_dos_magic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pe_types: PASSED only if they match.

import "std/sec/sys/pe_types.oo";

pub fn main() {
    let a = pe_dos_magic();
    let b = pe_dos_magic();
    if a != b {
        println("FAIL pe_dos_magic");
        process_exit(1);
    }
    println("prod_pe_types: PASSED");
}
