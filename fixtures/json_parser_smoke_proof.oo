// # JSON Parser and Builder Verification Proof Fixture
//
// Logline: Proves JSON object construction, string extraction, raw value extraction, and fail-closed error handling.
//
// Setup: Pure data structure verification fixture without ambient effects.
//
// Beats:
//   1. Build JSON object with strings, integers, and booleans.
//   2. Parse and extract string field.
//   3. Parse and extract int field via json_get_value.
//   4. Parse and extract bool field via json_get_value.
//   5. Verify fail-closed error for non-existent key.
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.6: Dual-evidence happy path and missing key refusal.
// RULES.oot 1.7: Under 256 lines.

import "std/markup/json.oo";
import "std/result.oo";

pub fn main() {
    let mut b: String = json_builder_new();
    b = json_builder_add_string(b, "name", "openOODA Beta Engine");
    b = json_builder_add_int(b, "version_major", 1);
    b = json_builder_add_int(b, "port", 8080);
    b = json_builder_add_bool(b, "is_secure", true);
    b = json_builder_finish(b);

    println("BUILT JSON: " + b);

    // 1. Verify string extraction
    let name_r: Result[String, String] = json_get_string(b, "name");
    if !name_r.is_ok() {
        println("FAIL: json_get_string name");
        process_exit(1);
    }
    let name_val: String = res_unwrap_or(name_r, "");
    if name_val != "openOODA Beta Engine" {
        println("FAIL: name_val mismatch: " + name_val);
        process_exit(1);
    }

    // 2. Verify int extraction via json_get_value
    let port_r: Result[String, String] = json_get_value(b, "port");
    if !port_r.is_ok() {
        println("FAIL: json_get_value port");
        process_exit(1);
    }
    let port_val: String = res_unwrap_or(port_r, "");
    if port_val != "8080" {
        println("FAIL: port_val mismatch: " + port_val);
        process_exit(1);
    }

    // 3. Verify bool extraction via json_get_value
    let sec_r: Result[String, String] = json_get_value(b, "is_secure");
    if !sec_r.is_ok() {
        println("FAIL: json_get_value is_secure");
        process_exit(1);
    }
    let sec_val: String = res_unwrap_or(sec_r, "");
    if sec_val != "true" {
        println("FAIL: sec_val should be true");
        process_exit(1);
    }

    // 4. Verify fail-closed on missing key
    let missing_r: Result[String, String] = json_get_string(b, "non_existent_key");
    if !missing_r.is_err() {
        println("FAIL: missing key must return Err");
        process_exit(1);
    }

    println("OK: JSON_PARSER_SMOKE_PROOF_PASSED");
}
