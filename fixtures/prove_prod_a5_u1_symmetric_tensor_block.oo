// # Product prove std/quantum_tensor_nets/u1_symmetric_tensor_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts u1_charge_sector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/u1_symmetric_tensor_block.oo.
//
// Beats:
//   1. Call u1_charge_sector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_u1_symmetric_tensor_block: PASSED only if they match.

import "std/quantum_tensor_nets/u1_symmetric_tensor_block.oo";

pub fn main() {
    let u1_symmetric_tensor_block_mark: Int = 0;
    if u1_symmetric_tensor_block_mark != 0 {
        process_exit(1);
    }
    let a: U1ChargeSector = u1_charge_sector_new(0, 0);
    let b: U1ChargeSector = u1_charge_sector_new(0, 0);
    if (a).charge_q != (b).charge_q {
        println("FAIL u1_charge_sector_new");
        process_exit(1);
    }
    println("prod_u1_symmetric_tensor_block: PASSED");
}
