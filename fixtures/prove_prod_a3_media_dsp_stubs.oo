// # Product prove std/media_dsp/media_dsp_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts media_dsp_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/media_dsp_stubs.oo.
//
// Beats:
//   1. Call media_dsp_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_media_dsp_stubs: PASSED only if they match.

import "std/media_dsp/media_dsp_stubs.oo";

pub fn main() {
    let media_dsp_stubs_mark: Int = 0;
    if media_dsp_stubs_mark != 0 {
        process_exit(1);
    }
    let a: MediaDspCapabilities = media_dsp_capabilities_default();
    let b: MediaDspCapabilities = media_dsp_capabilities_default();
    if (a).max_sample_rate != (b).max_sample_rate {
        println("FAIL media_dsp_capabilities_default");
        process_exit(1);
    }
    println("prod_media_dsp_stubs: PASSED");
}
