// # Product prove std/robotics_auv/auv_vector_field_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_field_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_vector_field_guidance.oo.
//
// Beats:
//   1. Call vector_field_config_default using the auv_vector_field_guidance ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_vector_field_guidance: PASSED only if asserts hold.

import "std/robotics_auv/auv_vector_field_guidance.oo";

pub fn main() {
    let obj = vector_field_config_default();
    let auv_vector_field_guidance_a = obj.k_convergence;
    if auv_vector_field_guidance_a != 0.15 {
        println("FAIL vector_field_config_default");
        process_exit(1);
    }
    println("prod_auv_vector_field_guidance: PASSED");
}
