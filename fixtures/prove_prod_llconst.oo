// # Product sec landlock const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/landlock_const.oo.
//
// Setup: Product std/sec/sys/landlock_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. execute 1 read_file 4 all 32767. net all 3.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/landlock_const.oo";

pub fn main() {
    let a: Int = landlock_access_fs_execute();
    if a != 1 {
        println("FAIL ll exec");
        process_exit(1);
    }
    let b: Int = landlock_access_fs_read_file();
    if b != 4 {
        println("FAIL ll read");
        process_exit(1);
    }
    let c: Int = landlock_access_fs_all();
    if c != 32767 {
        println("FAIL ll all");
        process_exit(1);
    }
    let d: Int = landlock_access_net_all();
    if d != 3 {
        println("FAIL ll net");
        process_exit(1);
    }
    println("prod_llconst: PASSED");
}
