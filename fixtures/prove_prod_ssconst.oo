// # Product sec shadowstack const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/shadowstack_const.oo.
//
// Setup: Product std/sec/sys/shadowstack_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. max depth 1024 page 4096 overflow 3.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/shadowstack_const.oo";

pub fn main() {
    let a: Int = shadowstack_default_max_depth();
    if a != 1024 {
        println("FAIL ss depth");
        process_exit(1);
    }
    let b: Int = shadowstack_default_page_size();
    if b != 4096 {
        println("FAIL ss page");
        process_exit(1);
    }
    let c: Int = shadowstack_violation_overflow();
    if c != 3 {
        println("FAIL ss ovf");
        process_exit(1);
    }
    println("prod_ssconst: PASSED");
}
