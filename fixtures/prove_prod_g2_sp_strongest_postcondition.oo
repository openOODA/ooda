// # Product prove std/formal_verif/sp_strongest_postcondition.oo
//
// Logline: Fail-closed emit+gcc+run asserts symbolic_state_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/sp_strongest_postcondition.oo.
//
// Beats:
//   1. Call symbolic_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sp_strongest_postcondition: PASSED only if they match.

import "std/formal_verif/sp_strongest_postcondition.oo";

pub fn main() {
    let sp_strongest_postcondition_mark: Int = 0;
    if sp_strongest_postcondition_mark != 0 {
        process_exit(1);
    }
    let a: SymbolicState = symbolic_state_init();
    let b: SymbolicState = symbolic_state_init();
    if (a).is_reachable != (b).is_reachable {
        println("FAIL symbolic_state_init");
        process_exit(1);
    }
    println("prod_g2_sp_strongest_postcondition: PASSED");
}
