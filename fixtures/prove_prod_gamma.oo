// # Product gamma prove
//
// Logline: Fail-closed emit+gcc+run of shipped Lanczos math_gamma on published pins.
//
// Setup: Product std/math/special_gamma.oo. Gamma(1/2)=sqrt(pi); Gamma(3/2)=sqrt(pi)/2.
//
// Beats:
//   1. math_gamma(0.5) in (1.772, 1.773) — published sqrt(pi) = 1.7724538509.
//   2. math_gamma(1.5) in (0.886, 0.887) — published sqrt(pi)/2 = 0.8862269254.
//   3. Exit 1 before PASSED on a miss. Integer-table stub fails both bands.

import "std/math/special_gamma.oo";

pub fn main() {
    let g05: Float = math_gamma(0.5);
    if g05 <= 1.772 {
        println("FAIL gamma05 lo");
        process_exit(1);
    }
    if g05 >= 1.773 {
        println("FAIL gamma05 hi");
        process_exit(1);
    }
    let g15: Float = math_gamma(1.5);
    if g15 <= 0.886 {
        println("FAIL gamma15 lo");
        process_exit(1);
    }
    if g15 >= 0.887 {
        println("FAIL gamma15 hi");
        process_exit(1);
    }
    println("prod_gamma: PASSED");
}
