// # Product prove std/satellite_dvb/isl_laser_link_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts laser_calc_telescope_gain_dbi is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_laser_link_budget.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call laser_calc_telescope_gain_dbi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_isl_laser_link_budget: PASSED only if they match.

import "std/satellite_dvb/isl_laser_link_budget.oo";

pub fn main() {
    let g0_a = laser_calc_telescope_gain_dbi(1.0, 1.0, 1.0);
    let g0_b = laser_calc_telescope_gain_dbi(1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL laser_calc_telescope_gain_dbi");
        process_exit(1);
    }
    println("prod_g0_isl_laser_link_budget: PASSED");
}
