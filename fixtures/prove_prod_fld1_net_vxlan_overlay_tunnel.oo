// # Product prove std/mesh_ebpf/net_vxlan_overlay_tunnel.oo
//
// Logline: Fail-closed emit+gcc+run asserts vxlan_parse_header is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/net_vxlan_overlay_tunnel.oo.
//
// Beats:
//   1. Call vxlan_parse_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_net_vxlan_overlay_tunnel: PASSED only if they match.

import "std/mesh_ebpf/net_vxlan_overlay_tunnel.oo";

pub fn main() {
    let net_vxlan_overlay_tunnel_mark: Int = 0;
    if net_vxlan_overlay_tunnel_mark != 0 {
        process_exit(1);
    }
    let net_vxlan_overlay_tunnel_a = vxlan_parse_header(1, 1, 1, 1, 1);
    let net_vxlan_overlay_tunnel_b = vxlan_parse_header(1, 1, 1, 1, 1);
    if (net_vxlan_overlay_tunnel_a).flags != (net_vxlan_overlay_tunnel_b).flags {
        println("FAIL vxlan_parse_header");
        process_exit(1);
    }
    println("prod_net_vxlan_overlay_tunnel: PASSED");
}
