// # Product prove std/quantum/qasm_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts qasm_token_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/qasm_lexer.oo.
//
// Beats:
//   1. Call qasm_token_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_qasm_lexer: PASSED only if they match.

import "std/quantum/qasm_lexer.oo";

pub fn main() {
    let qasm_lexer_mark: Int = 0;
    if qasm_lexer_mark != 0 {
        process_exit(1);
    }
    let a: QasmToken = qasm_token_new("x", "x", 0, 0);
    let b: QasmToken = qasm_token_new("x", "x", 0, 0);
    if (a).line != (b).line {
        println("FAIL qasm_token_new");
        process_exit(1);
    }
    println("prod_g2_qasm_lexer: PASSED");
}
