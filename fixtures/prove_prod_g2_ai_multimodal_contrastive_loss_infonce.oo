// # Product prove std/ai_multimodal/contrastive_loss_infonce.oo
//
// Logline: Fail-closed emit+gcc+run asserts contrastive_loss_infonce_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/contrastive_loss_infonce.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call contrastive_loss_infonce_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_contrastive_loss_infonce: PASSED only if they match.

import "std/ai_multimodal/contrastive_loss_infonce.oo";

pub fn main() {
    let g2_a = contrastive_loss_infonce_marker();
    let g2_b = contrastive_loss_infonce_marker();
    if g2_a != g2_b {
        println("FAIL contrastive_loss_infonce_marker");
        process_exit(1);
    }
    println("prod_g2_contrastive_loss_infonce: PASSED");
}
