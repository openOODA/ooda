// # Product prove std/genomics_advanced/metagenomic_kraken_tax_kmer.oo
//
// Logline: Fail-closed emit+gcc+run asserts metagenomic_kraken_tax_kmer_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/metagenomic_kraken_tax_kmer.oo.
//
// Beats:
//   1. Call metagenomic_kraken_tax_kmer_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metagenomic_kraken_tax_kmer: PASSED only if they match.

import "std/genomics_advanced/metagenomic_kraken_tax_kmer.oo";

pub fn main() {
    let a = metagenomic_kraken_tax_kmer_probe();
    let b = metagenomic_kraken_tax_kmer_probe();
    if a != b {
        println("FAIL metagenomic_kraken_tax_kmer_probe");
        process_exit(1);
    }
    println("prod_metagenomic_kraken_tax_kmer: PASSED");
}
