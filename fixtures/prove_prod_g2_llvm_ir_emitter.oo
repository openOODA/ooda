// # Product prove std/compilers/llvm_ir_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts llvm_type_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_emitter.oo.
//
// Beats:
//   1. Call llvm_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_llvm_ir_emitter: PASSED only if they match.

import "std/compilers/llvm_ir_emitter.oo";
import "std/str.oo";

pub fn main() {
    let llvm_ir_emitter_mark: Int = 0;
    if llvm_ir_emitter_mark != 0 {
        process_exit(1);
    }
    let a: String = llvm_type_name(0);
    let b: String = llvm_type_name(0);
    if str_eq(a, b) == false {
        println("FAIL llvm_type_name");
        process_exit(1);
    }
    println("prod_g2_llvm_ir_emitter: PASSED");
}
