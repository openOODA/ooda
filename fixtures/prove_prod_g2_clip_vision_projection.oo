// # Product prove std/deep_ai/clip_vision_projection.oo
//
// Logline: Fail-closed emit+gcc+run asserts clip_vision_projection_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/clip_vision_projection.oo.
//
// Beats:
//   1. Call clip_vision_projection_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_clip_vision_projection: PASSED only if they match.

import "std/deep_ai/clip_vision_projection.oo";

pub fn main() {
    let a: Int = clip_vision_projection_marker();
    let b: Int = clip_vision_projection_marker();
    if a != b {
        println("FAIL clip_vision_projection_marker");
        process_exit(1);
    }
    println("prod_g2_clip_vision_projection: PASSED");
}
