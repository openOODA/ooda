// # Product prove std/gis_spatial/spatial_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_buffer_circle_vertex_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/spatial_buffer.oo.
//
// Beats:
//   1. Call spatial_buffer_circle_vertex_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_buffer: PASSED only if they match.

import "std/gis_spatial/spatial_buffer.oo";

pub fn main() {
    let a: Float = spatial_buffer_circle_vertex_x(0.0, 0.0, 0, 0);
    let b: Float = spatial_buffer_circle_vertex_x(0.0, 0.0, 0, 0);
    if a != b {
        println("FAIL spatial_buffer_circle_vertex_x");
        process_exit(1);
    }
    println("prod_spatial_buffer: PASSED");
}
