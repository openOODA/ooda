// # Product prove std/sec/crypto/kmac_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts kmac_config_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac_types.oo.
//
// Beats:
//   1. Call kmac_config_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kmac_types: PASSED only if they match.

import "std/sec/crypto/kmac_types.oo";

pub fn main() {
    let obj = kmac_config_new(0, 0, 0);
    let a = kmac_config_rate(obj);
    let b = kmac_config_rate(obj);
    if a != b {
        println("FAIL kmac_config_rate");
        process_exit(1);
    }
    println("prod_kmac_types: PASSED");
}
