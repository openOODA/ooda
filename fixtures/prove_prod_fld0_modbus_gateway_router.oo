// # Product prove std/iot_scada/modbus_gateway_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_gateway_tx_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/modbus_gateway_router.oo.
//
// Beats:
//   1. Call modbus_gateway_tx_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_modbus_gateway_router: PASSED only if they match.

import "std/iot_scada/modbus_gateway_router.oo";

pub fn main() {
    let modbus_gateway_router_mark: Int = 0;
    if modbus_gateway_router_mark != 0 {
        process_exit(1);
    }
    let modbus_gateway_router_a = modbus_gateway_tx_new(1, 1, 1, 1);
    let modbus_gateway_router_b = modbus_gateway_tx_new(1, 1, 1, 1);
    if (modbus_gateway_router_a).transaction_id != (modbus_gateway_router_b).transaction_id {
        println("FAIL modbus_gateway_tx_new");
        process_exit(1);
    }
    println("prod_modbus_gateway_router: PASSED");
}
