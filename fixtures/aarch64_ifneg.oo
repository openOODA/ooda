// # Const -INT compare if print
//
// Logline: Print NEG from if -1<1 and LE from the else of if -1>1.
//
// Setup: Side emit-aarch64 folds MINUS INT OP INT only when LBRACE follows.
//
// Beats:
//   1. if -1 < 1 print NEG.
//   2. if -1 > 1 else print LE.
//   3. Expect NEG and LE.

pub fn main() {
    if -1 < 1 {
        println("NEG");
    }
    if -1 > 1 {
        println("BAD");
    } else {
        println("LE");
    }
}
