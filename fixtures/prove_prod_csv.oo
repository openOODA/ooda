// # Product CSV escape + parse prove
//
// Logline: Fail-closed emit+gcc+run of shipped csv_escape_field and csv_nth_field.
//
// Setup: Product std/encoding/csv.oo. RFC 4180 comma split. No List[String].
//
// Beats:
//   1. csv_escape_field("abc") is abc; csv_escape_field("a,b") is "a,b".
//   2. csv_field_count("a,b,c") is 3; csv_nth_field(..., 1) is b.
//   3. Exit 1 before PASSED on a miss.

import "std/encoding/csv.oo";

pub fn main() {
    let plain: String = csv_escape_field("abc");
    if plain != "abc" {
        println("FAIL csv plain");
        process_exit(1);
    }
    let quoted: String = csv_escape_field("a,b");
    if quoted != "\"a,b\"" {
        println("FAIL csv quoted");
        process_exit(1);
    }
    let n: Int = csv_field_count("a,b,c");
    if n != 3 {
        println("FAIL csv count");
        process_exit(1);
    }
    let mid: String = csv_nth_field("a,b,c", 1);
    if mid != "b" {
        println("FAIL csv nth");
        process_exit(1);
    }
    let rows: Int = csv_parse_document("a,b\nc,d");
    if rows != 2 {
        println("FAIL csv document");
        process_exit(1);
    }
    let empty_doc: Int = csv_parse_document("");
    if empty_doc != 0 {
        println("FAIL csv empty document");
        process_exit(1);
    }
    println("prod_csv: PASSED");
}
