// # emit-x86 for leftover honesty
//
// Logline: For-range print once so emit-x86 must ERR leftover and not emit a silent once.
//
// Setup: Fold misses. for is not walked. Inner println must not become _start.
//
// Beats:
//   1. Declare main.
//   2. for range prints once.
//   3. emit-x86 must print ERR x86_emit.

pub fn main() {
    for i in 0..1 {
        println("once");
    }
}
