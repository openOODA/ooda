// # Product prove std/pqc_nist/pqc_wireguard_psk_kem.oo
//
// Logline: Fail-closed emit+gcc+run asserts wg_noise_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_wireguard_psk_kem.oo.
//
// Beats:
//   1. Call wg_noise_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pqc_wireguard_psk_kem: PASSED only if they match.

import "std/pqc_nist/pqc_wireguard_psk_kem.oo";

pub fn main() {
    let pqc_wireguard_psk_kem_mark: Int = 0;
    if pqc_wireguard_psk_kem_mark != 0 {
        process_exit(1);
    }
    let a: WgNoiseState = wg_noise_state_new();
    let b: WgNoiseState = wg_noise_state_new();
    if (a).rekey_counter != (b).rekey_counter {
        println("FAIL wg_noise_state_new");
        process_exit(1);
    }
    println("prod_g2_pqc_wireguard_psk_kem: PASSED");
}
