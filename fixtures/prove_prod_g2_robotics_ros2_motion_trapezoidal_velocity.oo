// # Product prove std/robotics_ros2/motion_trapezoidal_velocity.oo
//
// Logline: Fail-closed emit+gcc+run asserts trapezoidal_profile_plan is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_trapezoidal_velocity.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call trapezoidal_profile_plan twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_motion_trapezoidal_velocity: PASSED only if they match.

import "std/robotics_ros2/motion_trapezoidal_velocity.oo";

pub fn main() {
    let g2_oa: TrapezoidalProfile = trapezoidal_profile_plan(1.0, 1.0, 1.0, 1.0);
    let g2_ob: TrapezoidalProfile = trapezoidal_profile_plan(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).q0;
    let g2_b = (g2_ob).q0;
    if g2_a != g2_b {
        println("FAIL trapezoidal_profile_plan.q0");
        process_exit(1);
    }
    println("prod_g2_motion_trapezoidal_velocity: PASSED");
}
