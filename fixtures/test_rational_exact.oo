// # Test rational exact
//
// Logline: Fail-closed emit+gcc+run of std/math_exact/rational_exact.oo operations.
//
// Setup: Imports std/math_exact/rational_exact.oo.
//
// Beats:
//   1. rational_new(1,2) and (2,4) are 1/2.
//   2. rational_new(1,0) is Err.
//   3. rational_add(1/2, 1/3) is 5/6.
//   4. rational_mul(1/2, 1/3) is 1/6.
//   5. rational_div(1/2, 1/4) is 2/1.
//   6. rational_div(1/0, 1) is Err.
//   7. rational_cmp orders correctly.
//   8. Lossless associativity on add.
//   9. Distributivity on mul.

import "std/math_exact/rational_exact.oo";

pub fn main() {
    // Test 1: rational_new(1, 2) and (2, 4) both yield 1/2
    let a_r: Result[Rational, String] = rational_new(1, 2);
    if a_r.is_err() {
        println("FAIL t1a err");
        process_exit(1);
    }
    let a: Rational = a_r.val;
    if rational_num(a) != 1 {
        println("FAIL t1a num");
        process_exit(1);
    }
    if rational_den(a) != 2 {
        println("FAIL t1a den");
        process_exit(1);
    }
    let b_r: Result[Rational, String] = rational_new(2, 4);
    if b_r.is_err() {
        println("FAIL t1b err");
        process_exit(1);
    }
    let b: Rational = b_r.val;
    if rational_num(b) != 1 {
        println("FAIL t1b num");
        process_exit(1);
    }
    if rational_den(b) != 2 {
        println("FAIL t1b den");
        process_exit(1);
    }

    // Test 2: rational_new(1, 0) returns Err
    let z_r: Result[Rational, String] = rational_new(1, 0);
    if z_r.is_ok() {
        println("FAIL t2 should be err");
        process_exit(1);
    }

    // Test 3: rational_add(1/2, 1/3) == 5/6
    let h: Rational = rational_new(1, 2).val;
    let t: Rational = rational_new(1, 3).val;
    let sum: Rational = rational_add(h, t).val;
    if rational_num(sum) != 5 {
        println("FAIL t3 num");
        process_exit(1);
    }
    if rational_den(sum) != 6 {
        println("FAIL t3 den");
        process_exit(1);
    }

    // Test 4: rational_mul(1/2, 1/3) == 1/6
    let pr: Rational = rational_mul(h, t).val;
    if rational_num(pr) != 1 {
        println("FAIL t4 num");
        process_exit(1);
    }
    if rational_den(pr) != 6 {
        println("FAIL t4 den");
        process_exit(1);
    }

    // Test 5: rational_div(1/2, 1/4) == 2/1
    let q: Rational = rational_new(1, 4).val;
    let dv: Rational = rational_div(h, q).val;
    if rational_num(dv) != 2 {
        println("FAIL t5 num");
        process_exit(1);
    }
    if rational_den(dv) != 1 {
        println("FAIL t5 den");
        process_exit(1);
    }

    // Test 6: rational_div(1, 0/1) returns Err (divisor has zero numerator)
    let zero: Rational = rational_new(0, 1).val;
    let one: Rational = rational_new(1, 1).val;
    let bad_div: Result[Rational, String] = rational_div(one, zero);
    if bad_div.is_ok() {
        println("FAIL t6 should be err");
        process_exit(1);
    }
    // Also: rational_new(1, 0) returns Err (denominator zero)
    let den_zero: Result[Rational, String] = rational_new(1, 0);
    if den_zero.is_ok() {
        println("FAIL t6b should be err");
        process_exit(1);
    }

    // Test 7: rational_cmp orders correctly
    if rational_cmp(h, t) != 1 {
        println("FAIL t7a cmp");
        process_exit(1);
    }
    if rational_cmp(t, h) != -1 {
        println("FAIL t7b cmp");
        process_exit(1);
    }
    if rational_cmp(h, h) != 0 {
        println("FAIL t7c cmp");
        process_exit(1);
    }

    // Test 8: Lossless associativity on add: (a+b)+c == a+(b+c)
    let a1: Rational = rational_new(1, 2).val;
    let a2: Rational = rational_new(1, 3).val;
    let a3: Rational = rational_new(1, 6).val;
    let lhs8: Rational = rational_add(rational_add(a1, a2).val, a3).val;
    let rhs8: Rational = rational_add(a1, rational_add(a2, a3).val).val;
    if !rational_eq(lhs8, rhs8) {
        println("FAIL t8 assoc");
        process_exit(1);
    }

    // Test 9: Distributivity: a*(b+c) == a*b + a*c
    let b1: Rational = rational_new(2, 3).val;
    let b2: Rational = rational_new(1, 4).val;
    let b3: Rational = rational_new(1, 5).val;
    let lhs9: Rational = rational_mul(a1, rational_add(b1, b2).val).val;
    let rhs9: Rational = rational_add(rational_mul(a1, b1).val, rational_mul(a1, b2).val).val;
    if !rational_eq(lhs9, rhs9) {
        println("FAIL t9 distrib");
        process_exit(1);
    }

    println("test_rational_exact: PASSED");
}
