// # Product prove std/grid/freq_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/freq_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_freq_types: PASSED only if they match.

import "std/grid/freq_types.oo";

pub fn main() {
    let freq_types_a = grid_freq_new(0, 0, 0);
    let freq_types_b = grid_freq_new(0, 0, 0);
    let freq_types_va = grid_freq_current(freq_types_a);
    let freq_types_vb = grid_freq_current(freq_types_b);
    if freq_types_va != freq_types_vb {
        println("FAIL freq_types");
        process_exit(1);
    }
    println("prod_ap_freq_types: PASSED");
}
