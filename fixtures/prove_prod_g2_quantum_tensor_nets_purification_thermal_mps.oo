// # Product prove std/quantum_tensor_nets/purification_thermal_mps.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermal_purification_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/purification_thermal_mps.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call thermal_purification_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_purification_thermal_mps: PASSED only if they match.

import "std/quantum_tensor_nets/purification_thermal_mps.oo";

pub fn main() {
    let g2_oa: ThermalPurificationConfig = thermal_purification_config_default(2, 1.0);
    let g2_ob: ThermalPurificationConfig = thermal_purification_config_default(2, 1.0);
    let g2_a = (g2_oa).num_sites;
    let g2_b = (g2_ob).num_sites;
    if g2_a != g2_b {
        println("FAIL thermal_purification_config_default.num_sites");
        process_exit(1);
    }
    println("prod_g2_purification_thermal_mps: PASSED");
}
