// # Product prove std/bft_consensus/tendermint_abci_application_interface.oo
//
// Logline: Fail-closed emit+gcc+run asserts abci_process_proposal_accept is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_abci_application_interface.oo.
//
// Beats:
//   1. Call abci_process_proposal_accept twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tendermint_abci_application_interface: PASSED only if they match.

import "std/bft_consensus/tendermint_abci_application_interface.oo";

pub fn main() {
    let tendermint_abci_application_interface_mark: Int = 0;
    if tendermint_abci_application_interface_mark != 0 {
        process_exit(1);
    }
    let a: AbciProcessProposalResponse = abci_process_proposal_accept();
    let b: AbciProcessProposalResponse = abci_process_proposal_accept();
    if (a).is_accepted != (b).is_accepted {
        println("FAIL abci_process_proposal_accept");
        process_exit(1);
    }
    println("prod_tendermint_abci_application_interface: PASSED");
}
