// # Product prove std/fintech_defi/crypto_wallet_hd_bip32.oo
//
// Logline: Fail-closed emit+gcc+run asserts hd_path_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/crypto_wallet_hd_bip32.oo.
//
// Beats:
//   1. Call hd_path_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crypto_wallet_hd_bip32: PASSED only if they match.

import "std/fintech_defi/crypto_wallet_hd_bip32.oo";

pub fn main() {
    let crypto_wallet_hd_bip32_mark: Int = 0;
    if crypto_wallet_hd_bip32_mark != 0 {
        process_exit(1);
    }
    let crypto_wallet_hd_bip32_a = hd_path_new(1, 1, 1, 1, 1);
    let crypto_wallet_hd_bip32_b = hd_path_new(1, 1, 1, 1, 1);
    if (crypto_wallet_hd_bip32_a).purpose != (crypto_wallet_hd_bip32_b).purpose {
        println("FAIL hd_path_new");
        process_exit(1);
    }
    println("prod_crypto_wallet_hd_bip32: PASSED");
}
