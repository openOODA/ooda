// # Product prove std/compilers_polyhedral/affine_access_relation.oo
//
// Logline: Fail-closed emit+gcc+run asserts affine_index_expr_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_access_relation.oo.
//
// Beats:
//   1. Call affine_index_expr_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_affine_access_relation: PASSED only if they match.

import "std/compilers_polyhedral/affine_access_relation.oo";

pub fn main() {
    let affine_access_relation_mark: Int = 0;
    if affine_access_relation_mark != 0 {
        process_exit(1);
    }
    let a: AffineIndexExpr = affine_index_expr_new(list_new(), 0);
    let b: AffineIndexExpr = affine_index_expr_new(list_new(), 0);
    if (a).constant_offset != (b).constant_offset {
        println("FAIL affine_index_expr_new");
        process_exit(1);
    }
    println("prod_affine_access_relation: PASSED");
}
