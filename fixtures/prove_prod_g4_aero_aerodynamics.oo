// # Product prove std/aero/aerodynamics_engine.oo
//
// Logline: Fail-closed verification that aerodynamic calculations, stability derivatives, and wing geometry are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/aerodynamics_engine.oo.
//
// Beats:
//   1. Call aerodynamics_engine_marker, compute_mach_number, and thin_airfoil_cl.
//   2. Construct WingGeometry and evaluate aspect ratio.
//   3. Scale and manipulate AeroCoefficients.
//   4. Print prod_g4_aero_aerodynamics: PASSED only if all match.

import "std/aero/aerodynamics_engine.oo";

pub fn main() {
    let m: Int = aerodynamics_engine_marker();
    if m != 1 {
        println("FAIL aerodynamics_engine_marker");
        process_exit(1);
    }

    let mach_a: Float = compute_mach_number(340.0, 340.0);
    let mach_b: Float = compute_mach_number(340.0, 340.0);
    if mach_a != mach_b || mach_a != 1.0 {
        println("FAIL compute_mach_number");
        process_exit(1);
    }

    let cl_a: Float = thin_airfoil_cl(0.1, 0.0);
    let cl_b: Float = thin_airfoil_cl(0.1, 0.0);
    if cl_a != cl_b {
        println("FAIL thin_airfoil_cl");
        process_exit(1);
    }

    let geom: WingGeometry = wing_geometry_new(10.0, 20.0, 2.0, 0.85);
    if (geom).aspect_ratio != 5.0 {
        println("FAIL wing_geometry_new aspect_ratio");
        process_exit(1);
    }

    let coeff: AeroCoefficients = aero_coefficients_new(0.5, 0.02, 0.0, 0.0, 0.0 - 0.05, 0.0);
    let scaled: AeroCoefficients = aero_coefficients_scale(coeff, 2.0);
    if (scaled).cl != 1.0 || (scaled).cd != 0.04 {
        println("FAIL aero_coefficients_scale");
        process_exit(1);
    }

    println("prod_g4_aero_aerodynamics: PASSED");
    process_exit(0);
}
