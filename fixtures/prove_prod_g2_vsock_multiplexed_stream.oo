// # Product prove std/cloud_faas/vsock_multiplexed_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts vsock_multiplexer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/vsock_multiplexed_stream.oo.
//
// Beats:
//   1. Call vsock_multiplexer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vsock_multiplexed_stream: PASSED only if they match.

import "std/cloud_faas/vsock_multiplexed_stream.oo";

pub fn main() {
    let vsock_multiplexed_stream_mark: Int = 0;
    if vsock_multiplexed_stream_mark != 0 {
        process_exit(1);
    }
    let a: VsockMultiplexer = vsock_multiplexer_new(0);
    let b: VsockMultiplexer = vsock_multiplexer_new(0);
    if (a).local_cid != (b).local_cid {
        println("FAIL vsock_multiplexer_new");
        process_exit(1);
    }
    println("prod_g2_vsock_multiplexed_stream: PASSED");
}
