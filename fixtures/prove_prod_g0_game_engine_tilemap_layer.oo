// # Product prove std/game_engine/tilemap_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts tile_layer_tile_count is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/tilemap_layer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tile_layer_tile_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_tilemap_layer: PASSED only if they match.

import "std/game_engine/tilemap_layer.oo";

pub fn main() {
    let g0_oa: TileLayer = TileLayer { layer_id: 2, width: 8, height: 8, visible: 2, opacity: 1.0, parallax_x: 1.0, parallax_y: 1.0, collision_enabled: 2 };
    let g0_ob: TileLayer = TileLayer { layer_id: 2, width: 8, height: 8, visible: 2, opacity: 1.0, parallax_x: 1.0, parallax_y: 1.0, collision_enabled: 2 };
    let g0_a = tile_layer_tile_count(&g0_oa);
    let g0_b = tile_layer_tile_count(&g0_ob);
    if g0_a != g0_b {
        println("FAIL tile_layer_tile_count");
        process_exit(1);
    }
    println("prod_g0_tilemap_layer: PASSED");
}
