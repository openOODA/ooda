// # Product prove std/graph_networks/hyperloglog_cardinality.oo
//
// Logline: Fail-closed emit+gcc+run asserts hll_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/hyperloglog_cardinality.oo.
//
// Beats:
//   1. Call hll_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hyperloglog_cardinality: PASSED only if they match.

import "std/graph_networks/hyperloglog_cardinality.oo";

pub fn main() {
    let a: HllRegisterBank = hll_create(0);
    let b: HllRegisterBank = hll_create(0);
    if a.precision_bits != b.precision_bits {
        println("FAIL hll_create");
        process_exit(1);
    }
    println("prod_hyperloglog_cardinality: PASSED");
}
