// # Product prove std/telecom/dsp_filter_fir.oo
//
// Logline: Fail-closed emit+gcc+run asserts fir_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/dsp_filter_fir.oo.
//
// Beats:
//   1. Call fir_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_filter_fir: PASSED only if they match.

import "std/telecom/dsp_filter_fir.oo";

pub fn main() {
    let dsp_filter_fir_mark: Int = 0;
    if dsp_filter_fir_mark != 0 {
        process_exit(1);
    }
    let a: Float = fir_pi();
    let b: Float = fir_pi();
    if a != b {
        println("FAIL fir_pi");
        process_exit(1);
    }
    println("prod_dsp_filter_fir: PASSED");
}
