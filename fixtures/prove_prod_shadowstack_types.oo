// # Product prove std/sec/sys/shadowstack_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadow_stack_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/shadowstack_types.oo.
//
// Beats:
//   1. Call shadow_stack_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shadowstack_types: PASSED only if they match.

import "std/sec/sys/shadowstack_types.oo";

pub fn main() {
    let obj = shadow_stack_new(0);
    let a = obj.top_index;
    let b = obj.top_index;
    if a != b {
        println("FAIL shadow_stack_new");
        process_exit(1);
    }
    println("prod_shadowstack_types: PASSED");
}
