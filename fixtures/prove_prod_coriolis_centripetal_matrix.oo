// # Product prove std/robotics_auv/coriolis_centripetal_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts auv_inertia_params_default_remus is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/coriolis_centripetal_matrix.oo.
//
// Beats:
//   1. Call auv_inertia_params_default_remus twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_coriolis_centripetal_matrix: PASSED only if they match.

import "std/robotics_auv/coriolis_centripetal_matrix.oo";

pub fn main() {
    let coriolis_centripetal_matrix_mark: Int = 0;
    if coriolis_centripetal_matrix_mark != 0 {
        process_exit(1);
    }
    let a: AuvInertiaParams = auv_inertia_params_default_remus();
    let b: AuvInertiaParams = auv_inertia_params_default_remus();
    if (a).field0 != (b).field0 {
        println("FAIL auv_inertia_params_default_remus");
        process_exit(1);
    }
    println("prod_coriolis_centripetal_matrix: PASSED");
}
