// # Product prove std/ai_multimodal/clip_image_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts clip_image_encoder_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/clip_image_encoder.oo.
//
// Beats:
//   1. Call clip_image_encoder_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_clip_image_encoder: PASSED only if they match.

import "std/ai_multimodal/clip_image_encoder.oo";

pub fn main() {
    let a: Int = clip_image_encoder_marker();
    let b: Int = clip_image_encoder_marker();
    if a != b {
        println("FAIL clip_image_encoder_marker");
        process_exit(1);
    }
    println("prod_clip_image_encoder: PASSED");
}
