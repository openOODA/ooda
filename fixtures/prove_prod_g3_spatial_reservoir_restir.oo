// # Product prove std/pbr_raytracing/spatial_reservoir_restir.oo
//
// Logline: Fail-closed emit+gcc+run asserts reservoir_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/spatial_reservoir_restir.oo.
//
// Beats:
//   1. Call reservoir_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_reservoir_restir: PASSED only if they match.

import "std/pbr_raytracing/spatial_reservoir_restir.oo";

pub fn main() {
    let spatial_reservoir_restir_mark: Int = 0;
    if spatial_reservoir_restir_mark != 0 {
        process_exit(1);
    }
    let a: LightReservoir = reservoir_new();
    let b: LightReservoir = reservoir_new();
    if (a).selected_sample_id != (b).selected_sample_id {
        println("FAIL reservoir_new");
        process_exit(1);
    }
    println("prod_spatial_reservoir_restir: PASSED");
}
