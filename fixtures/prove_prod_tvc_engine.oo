// # Product prove std/aero/tvc_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts tvc_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_engine.oo.
//
// Beats:
//   1. Call tvc_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tvc_engine: PASSED only if they match.

import "std/aero/tvc_engine.oo";

pub fn main() {
    let a = tvc_pi();
    let b = tvc_pi();
    if a != b {
        println("FAIL tvc_pi");
        process_exit(1);
    }
    println("prod_tvc_engine: PASSED");
}
