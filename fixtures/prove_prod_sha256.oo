// # Product hash/sha256 forward prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash_sha256_forward.
//
// Setup: Product std/hash/sha256.oo forwards to crypto_sha256_internal.
//
// Beats:
//   1. Digest hello is the RFC 6234 SHA-256 hex.
//   2. Digest world differs from hello.
//   3. Exit 1 before PASSED on a miss.

import "std/hash/sha256.oo";

pub fn main() {
    let h: String = hash_sha256_forward("hello");
    println(h);
    if h != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        println("FAIL sha256 hello");
        process_exit(1);
    }
    let w: String = hash_sha256_forward("world");
    if w == h {
        println("FAIL sha256 world");
        process_exit(1);
    }
    if chars_len(h) != 64 {
        println("FAIL sha256 len");
        process_exit(1);
    }
    println("prod_sha256: PASSED");
}
