// # Product prove std/ai_ml/tokenizer_wordpiece.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/tokenizer_wordpiece.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tokenizer_wordpiece.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tokenizer_wordpiece: PASSED only if they match.

import "std/ai_ml/tokenizer_wordpiece.oo";

pub fn main() {
    let tokenizer_wordpiece_a = wp_unk_id();
    let tokenizer_wordpiece_b = wp_unk_id();
    if tokenizer_wordpiece_a != tokenizer_wordpiece_b {
        println("FAIL tokenizer_wordpiece");
        process_exit(1);
    }
    println("prod_ap_tokenizer_wordpiece: PASSED");
}
