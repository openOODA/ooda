// # Product prove std/web_protocols/graphql_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts graphql_is_whitespace is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/graphql_lexer.oo.
//
// Beats:
//   1. Call graphql_is_whitespace twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graphql_lexer: PASSED only if they match.

import "std/web_protocols/graphql_lexer.oo";

pub fn main() {
    let graphql_lexer_mark: Int = 0;
    if graphql_lexer_mark != 0 {
        process_exit(1);
    }
    let a: Int = graphql_is_whitespace(0);
    let b: Int = graphql_is_whitespace(0);
    if a != b {
        println("FAIL graphql_is_whitespace");
        process_exit(1);
    }
    println("prod_g2_graphql_lexer: PASSED");
}
