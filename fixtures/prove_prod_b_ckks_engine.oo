// # Product prove std/sec/crypto/ckks_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_engine_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ckks_engine.oo.
//
// Beats:
//   1. Call ckks_engine_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ckks_engine: PASSED only if they match.

import "std/sec/crypto/ckks_engine.oo";

pub fn main() {
    let a = ckks_engine_probe();
    let b = ckks_engine_probe();
    if a != b {
        println("FAIL ckks_engine_probe");
        process_exit(1);
    }
    println("prod_ckks_engine: PASSED");
}
