// # Product prove std/genomics_advanced/sam_flag_bitwise_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/genomics_advanced/sam_flag_bitwise_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/sam_flag_bitwise_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sam_flag_bitwise_parser: PASSED only if they match.

import "std/genomics_advanced/sam_flag_bitwise_parser.oo";

pub fn main() {
    let sam_flag_bitwise_parser_a = sam_test_bit(0, 0);
    let sam_flag_bitwise_parser_b = sam_test_bit(0, 0);
    if sam_flag_bitwise_parser_a != sam_flag_bitwise_parser_b {
        println("FAIL sam_flag_bitwise_parser");
        process_exit(1);
    }
    println("prod_ap_sam_flag_bitwise_parser: PASSED");
}
