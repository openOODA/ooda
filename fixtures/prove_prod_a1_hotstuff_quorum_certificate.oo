// # Product prove std/bft_consensus/hotstuff_quorum_certificate.oo
//
// Logline: Fail-closed emit+gcc+run asserts hotstuff_check_3chain_commit is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_quorum_certificate.oo.
//
// Beats:
//   1. Call hotstuff_check_3chain_commit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hotstuff_quorum_certificate: PASSED only if they match.

import "std/bft_consensus/hotstuff_quorum_certificate.oo";

pub fn main() {
    let hotstuff_quorum_certificate_mark: Int = 0;
    if hotstuff_quorum_certificate_mark != 0 {
        process_exit(1);
    }
    let a: Bool = hotstuff_check_3chain_commit(0, 0, 0, 0);
    let b: Bool = hotstuff_check_3chain_commit(0, 0, 0, 0);
    if a != b {
        println("FAIL hotstuff_check_3chain_commit");
        process_exit(1);
    }
    println("prod_hotstuff_quorum_certificate: PASSED");
}
