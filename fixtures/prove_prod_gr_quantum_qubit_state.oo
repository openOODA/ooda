// # Product prove std/quantum/qubit_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts qubit_bloch_coords is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum/qubit_state.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call qubit_bloch_coords twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_qubit_state: PASSED only if they match.

import "std/quantum/qubit_state.oo";

pub fn main() {
    let g0_oa = qubit_zero();
    let g0_ob = qubit_zero();
    let g0_la = qubit_bloch_coords(&g0_oa);
    let g0_lb = qubit_bloch_coords(&g0_ob);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL qubit_bloch_coords");
        process_exit(1);
    }
    println("prod_gr_qubit_state: PASSED");
}
