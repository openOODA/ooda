// # Connect inside a while
//
// Logline: Connect in a while so the second iteration starts from Open and must fail.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Enter a true while.
//   3. Call connect each iteration.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    while true {
        connect(s);
    }
}
