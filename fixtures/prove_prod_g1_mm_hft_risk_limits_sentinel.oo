// # Product prove std/hft_alpha/mm_hft_risk_limits_sentinel.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_risk_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_hft_risk_limits_sentinel.oo.
//
// Beats:
//   1. Call hft_risk_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_hft_risk_limits_sentinel: PASSED only if they match.

import "std/hft_alpha/mm_hft_risk_limits_sentinel.oo";

pub fn main() {
    let a: HftRiskConfig = hft_risk_config_default();
    let b: HftRiskConfig = hft_risk_config_default();
    if a.max_single_order_shares != b.max_single_order_shares {
        println("FAIL hft_risk_config_default");
        process_exit(1);
    }
    println("prod_mm_hft_risk_limits_sentinel: PASSED");
}
