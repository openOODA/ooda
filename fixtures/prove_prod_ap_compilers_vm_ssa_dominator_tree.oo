// # Product prove std/compilers_vm/ssa_dominator_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/ssa_dominator_tree.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_dominator_tree.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ssa_dominator_tree: PASSED only if they match.

import "std/compilers_vm/ssa_dominator_tree.oo";

pub fn main() {
    let ssa_dominator_tree_a = dom_tree_new(0);
    let ssa_dominator_tree_b = dom_tree_new(0);
    let ssa_dominator_tree_va = dom_tree_dominates(ssa_dominator_tree_a, 0, 0);
    let ssa_dominator_tree_vb = dom_tree_dominates(ssa_dominator_tree_b, 0, 0);
    if ssa_dominator_tree_va != ssa_dominator_tree_vb {
        println("FAIL ssa_dominator_tree");
        process_exit(1);
    }
    println("prod_ap_ssa_dominator_tree: PASSED");
}
