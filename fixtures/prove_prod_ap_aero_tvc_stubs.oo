// # Product prove std/aero/tvc_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/tvc_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tvc_stubs: PASSED only if they match.

import "std/aero/tvc_stubs.oo";

pub fn main() {
    let tvc_stubs_a = tvc_module_ready();
    let tvc_stubs_b = tvc_module_ready();
    if tvc_stubs_a != tvc_stubs_b {
        println("FAIL tvc_stubs");
        process_exit(1);
    }
    println("prod_ap_tvc_stubs: PASSED");
}
