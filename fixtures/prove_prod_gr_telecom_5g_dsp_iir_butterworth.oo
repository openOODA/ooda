// # Product prove std/telecom_5g/dsp_iir_butterworth.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_butterworth_step is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_iir_butterworth.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dsp_butterworth_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dsp_iir_butterworth: PASSED only if they match.

import "std/telecom_5g/dsp_iir_butterworth.oo";

pub fn main() {
    let mut g0_oa: ButterworthBiquad = ButterworthBiquad { b0: 0.0, b1: 0.0, b2: 0.0, a1: 0.0, a2: 0.0, w1: 0.0, w2: 0.0 };
    let mut g0_ob: ButterworthBiquad = ButterworthBiquad { b0: 0.0, b1: 0.0, b2: 0.0, a1: 0.0, a2: 0.0, w1: 0.0, w2: 0.0 };
    let g0_a = dsp_butterworth_step(&g0_oa, 0.0);
    let g0_b = dsp_butterworth_step(&g0_ob, 0.0);
    if g0_a != g0_b {
        println("FAIL dsp_butterworth_step");
        process_exit(1);
    }
    println("prod_gr_dsp_iir_butterworth: PASSED");
}
