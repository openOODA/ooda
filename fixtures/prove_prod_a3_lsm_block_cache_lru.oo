// # Product prove std/db_storage/lsm_block_cache_lru.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_cache_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_block_cache_lru.oo.
//
// Beats:
//   1. Call block_cache_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_block_cache_lru: PASSED only if they match.

import "std/db_storage/lsm_block_cache_lru.oo";

pub fn main() {
    let lsm_block_cache_lru_mark: Int = 0;
    if lsm_block_cache_lru_mark != 0 {
        process_exit(1);
    }
    let a: BlockCacheConfig = block_cache_config_default();
    let b: BlockCacheConfig = block_cache_config_default();
    if (a).capacity_bytes != (b).capacity_bytes {
        println("FAIL block_cache_config_default");
        process_exit(1);
    }
    println("prod_lsm_block_cache_lru: PASSED");
}
