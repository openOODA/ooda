// # Product prove std/formal_verif/wp_calculus_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/wp_calculus_evaluator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/wp_calculus_evaluator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wp_calculus_evaluator: PASSED only if they match.

import "std/formal_verif/wp_calculus_evaluator.oo";

pub fn main() {
    let wp_calculus_evaluator_a = wp_eval_skip("x");
    let wp_calculus_evaluator_b = wp_eval_skip("x");
    if wp_calculus_evaluator_a.contains(wp_calculus_evaluator_b) == false {
        println("FAIL wp_calculus_evaluator");
        process_exit(1);
    }
    if wp_calculus_evaluator_b.contains(wp_calculus_evaluator_a) == false {
        println("FAIL wp_calculus_evaluator");
        process_exit(1);
    }
    println("prod_ap_wp_calculus_evaluator: PASSED");
}
