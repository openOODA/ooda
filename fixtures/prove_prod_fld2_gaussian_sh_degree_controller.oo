// # Product prove std/nerf_3dgs/gaussian_sh_degree_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts sh_degree_to_num_coeffs is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_sh_degree_controller.oo.
//
// Beats:
//   1. Call sh_degree_to_num_coeffs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gaussian_sh_degree_controller: PASSED only if they match.

import "std/nerf_3dgs/gaussian_sh_degree_controller.oo";

pub fn main() {
    let gaussian_sh_degree_controller_mark: Int = 0;
    if gaussian_sh_degree_controller_mark != 0 {
        process_exit(1);
    }
    let gaussian_sh_degree_controller_a: Int = sh_degree_to_num_coeffs(1);
    let gaussian_sh_degree_controller_b: Int = sh_degree_to_num_coeffs(1);
    if gaussian_sh_degree_controller_a != gaussian_sh_degree_controller_b {
        println("FAIL sh_degree_to_num_coeffs");
        process_exit(1);
    }
    println("prod_gaussian_sh_degree_controller: PASSED");
}
