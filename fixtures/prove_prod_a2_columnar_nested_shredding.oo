// # Product prove std/db_columnar/columnar_nested_shredding.oo
//
// Logline: Fail-closed emit+gcc+run asserts dremel_schema_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_nested_shredding.oo.
//
// Beats:
//   1. Call dremel_schema_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_nested_shredding: PASSED only if they match.

import "std/db_columnar/columnar_nested_shredding.oo";

pub fn main() {
    let columnar_nested_shredding_mark: Int = 0;
    if columnar_nested_shredding_mark != 0 {
        process_exit(1);
    }
    let a: DremelSchemaNode = dremel_schema_node_new("x", 0, 0, true);
    let b: DremelSchemaNode = dremel_schema_node_new("x", 0, 0, true);
    if (a).max_def_level != (b).max_def_level {
        println("FAIL dremel_schema_node_new");
        process_exit(1);
    }
    println("prod_columnar_nested_shredding: PASSED");
}
