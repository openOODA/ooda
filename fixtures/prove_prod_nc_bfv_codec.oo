// # Product prove std/sec/crypto/bfv_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_codec_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_codec.oo.
//
// Beats:
//   1. Call bfv_codec_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bfv_codec: PASSED only if it matches.

import "std/sec/crypto/bfv_codec.oo";

pub fn main() {
    let a: Int = bfv_codec_probe();
    if a != 0 {
        println("FAIL bfv_codec_probe");
        process_exit(1);
    }
    println("prod_nc_bfv_codec: PASSED");
}
