// # Product sync ticket spinlock prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/spinlock_ticket.oo.
//
// Setup: Product std/sync/spinlock_ticket.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New serving 0 is my turn. Ticket 1 is not.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/spinlock_ticket.oo";

pub fn main() {
    let l: TicketSpinlock = ticket_spinlock_new();
    if ticket_spinlock_is_my_turn(l, 0) == false {
        println("FAIL ticket 0");
        process_exit(1);
    }
    if ticket_spinlock_is_my_turn(l, 1) {
        println("FAIL ticket 1");
        process_exit(1);
    }
    println("prod_ticket: PASSED");
}
