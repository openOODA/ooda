// # Assign secret in an if
//
// Logline: Copy a secret into y inside an if block and print y after the join.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag x as secret.
//   2. Assign y = x in a true branch.
//   3. Print y after the if.
//
// T1-3 attack: if-branch assigns secret to y then println(y)
// Same-fn bare assign-prop inside block (path A may catch via IDENT EQ walk).
// SECRET: x
pub fn main() {
    let x = "token";
    let mut y = "public";
    if true {
        y = x;
    }
    println(y);
}
