// # let v = match with used payload must stay OK
//
// Logline: Unused-let must not refuse a match bind whose payload is used.
//
// Setup: Isolated check. v is the match result; n is used; e is unused payload.
//
// Beats:
//   1. Bind r to Ok(1).
//   2. Bind v from match Ok(n)/Err(e).
//   3. Print v. Unused Err payload must not trip unused-let.

pub fn main() {
    let r = Ok(1);
    let v = match r {
        Ok(n) => n,
        Err(e) => 0
    };
    println(v);
}
