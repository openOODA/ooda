// # Int double nonneg fuzz
//
// Logline: Double a non-negative Int and prove result == x + x.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target double_nonneg 0 40.
//   2. Require x >= 0 and ensure result >= x and result == x + x.
//   3. Return x + x.

// FUZZ_DOMAIN: int
// FUZZ_TARGET: double_nonneg 0 40
// FUZZ_REQUIRES: double_nonneg x >= 0
// FUZZ_ENSURES: double_nonneg result >= x
// FUZZ_ENSURES: double_nonneg result == x + x
fn double_nonneg(x: Int) -> Int {
    requires x >= 0;
    ensures result >= x;
    ensures result == x + x;
    return x + x;
}
