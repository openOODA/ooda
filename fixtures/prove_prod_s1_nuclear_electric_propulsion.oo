// # Product prove std/space_propulsion/nuclear_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts nep_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/nuclear_electric_propulsion.oo.
//
// Beats:
//   1. Call nep_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nuclear_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/nuclear_electric_propulsion.oo";

pub fn main() {
    let nuclear_electric_propulsion_mark: Int = 0;
    if nuclear_electric_propulsion_mark != 0 {
        process_exit(1);
    }
    let nuclear_electric_propulsion_a = nep_compute_performance(nep_system_spec_default_1mwe());
    let nuclear_electric_propulsion_b = nep_compute_performance(nep_system_spec_default_1mwe());
    if (nuclear_electric_propulsion_a).electrical_power_kwe != (nuclear_electric_propulsion_b).electrical_power_kwe {
        println("FAIL nep_compute_performance");
        process_exit(1);
    }
    println("prod_nuclear_electric_propulsion: PASSED");
}
