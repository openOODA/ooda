// # Product prove std/industrial_iot/modbus_rtu_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_rtu_frame_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/modbus_rtu_frame.oo.
//
// Beats:
//   1. Call modbus_rtu_frame_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_modbus_rtu_frame: PASSED only if they match.

import "std/industrial_iot/modbus_rtu_frame.oo";

pub fn main() {
    let a: ModbusRtuFrame = modbus_rtu_frame_new(0, 0, list_new());
    let b: ModbusRtuFrame = modbus_rtu_frame_new(0, 0, list_new());
    if (a).slave_id != (b).slave_id {
        println("FAIL modbus_rtu_frame_new");
        process_exit(1);
    }
    println("prod_g2_modbus_rtu_frame: PASSED");
}
