// # Product prove std/crispr_cas/crispr_cas12f_mini_cas.oo
//
// Logline: Fail-closed emit+gcc+run asserts cas12f_is_tttr is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_cas12f_mini_cas.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cas12f_is_tttr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_cas12f_mini_cas: PASSED only if they match.

import "std/crispr_cas/crispr_cas12f_mini_cas.oo";

pub fn main() {
    let g2_a = cas12f_is_tttr("x");
    let g2_b = cas12f_is_tttr("x");
    if g2_a != g2_b {
        println("FAIL cas12f_is_tttr");
        process_exit(1);
    }
    println("prod_g2_crispr_cas12f_mini_cas: PASSED");
}
