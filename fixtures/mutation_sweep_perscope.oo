// # Mutation Sweep Per-Scope
//
// Logline: Reads source bytes of multiple std/ modules across scopes and runs the 4-op mutator sweep on each, reporting per-module kill rates.
//
// Setup: Requires &FsReadCap to read std/ module files via file_reader_open + file_reader_read_all.
//
// Beats:
//   1. Read 12 std modules across math_exact, formal_verif, algebra, crypto, embedded_hal, fin, media, file_formats, tensor, diag, tui.
//   2. Run mut_run_all on each module's actual source bytes.
//   3. Compute per-module kill rate and OVERALL aggregate.
//   4. Assert OVERALL kill rate >= 95% (rigorous).

import "std/fs/file_reader.oo";
import "qa/mutation/mutation_operators.oo";
import "qa/mutation/mutation_runner.oo";
import "qa/mutation/mutation_scorecard.oo";

pub fn string_to_bytes(s: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = bytes_len(s);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, byte_at(s, i));
        i = i + 1;
    }
    return out;
}

pub fn read_module_bytes(fs: &FsReadCap, path: String) -> List[Int] {
    let open_res: Result[FileReader, String] = file_reader_open(fs, path);
    if open_res.is_err() { return list_new(); }
    let reader: FileReader = open_res.val;
    let content_res: Result[String, String] = file_reader_read_all(fs, reader);
    if content_res.is_err() { return list_new(); }
    let content: String = content_res.val;
    return string_to_bytes(content);
}

pub fn sweep_one(fs: &FsReadCap, name: String, path: String) -> List[Int] {
    let src: List[Int] = read_module_bytes(fs, path);
    let src_len: Int = list_len(src);
    if src_len == 0 {
        let mut err: List[Int] = list_new();
        err = list_push(err, 0);
        err = list_push(err, 0);
        err = list_push(err, 0);
        err = list_push(err, 0);
        let line: String = name + " EMPTY";
        println(line);
        return err;
    }
    let summary: List[Int] = mut_run_all(src);
    let score: List[Int] = mut_score(summary);
    let total: Int = list_get(score, 0);
    let killed: Int = list_get(score, 1);
    let rate: Int = list_get(score, 2);
    let pass: Int = list_get(score, 3);
    let line: String = name + " bytes=" + src_len.to_string() + " total=" + total.to_string() + " killed=" + killed.to_string() + " rate=" + rate.to_string() + "%";
    println(line);
    return score;
}

pub fn main(fs: &FsReadCap) -> Int {
    let r1: List[Int] = sweep_one(fs, "rational_exact", "std/math_exact/rational_exact.oo");
    let r2: List[Int] = sweep_one(fs, "fixed_point_q32", "std/math_exact/fixed_point_q32.oo");
    let r3: List[Int] = sweep_one(fs, "interval_domain", "std/formal_verif/interval_domain.oo");
    let r4: List[Int] = sweep_one(fs, "algebraic_invariants", "std/algebra/algebraic_invariants.oo");
    let r5: List[Int] = sweep_one(fs, "kyber_ntt", "std/crypto_advanced/kyber_ntt.oo");
    let r6: List[Int] = sweep_one(fs, "chacha20", "std/crypto/chacha20.oo");
    let r7: List[Int] = sweep_one(fs, "black_scholes_pde", "std/defi_derivatives/black_scholes_pde.oo");
    let r8: List[Int] = sweep_one(fs, "qoi_enc", "std/media/qoi_enc.oo");
    let r9: List[Int] = sweep_one(fs, "tensor_engine", "std/ai_ml/tensor_engine.oo");
    let r10: List[Int] = sweep_one(fs, "trace_span", "std/diag/trace_span.oo");
    let r11: List[Int] = sweep_one(fs, "tui_buffer", "std/tui/tui_buffer.oo");
    let r12: List[Int] = sweep_one(fs, "ring_buffer", "std/collections/ring_buffer.oo");
    let t1: Int = list_get(r1, 0);
    let t2: Int = list_get(r2, 0);
    let t3: Int = list_get(r3, 0);
    let t4: Int = list_get(r4, 0);
    let t5: Int = list_get(r5, 0);
    let t6: Int = list_get(r6, 0);
    let t7: Int = list_get(r7, 0);
    let t8: Int = list_get(r8, 0);
    let t9: Int = list_get(r9, 0);
    let t10: Int = list_get(r10, 0);
    let t11: Int = list_get(r11, 0);
    let t12: Int = list_get(r12, 0);
    let k1: Int = list_get(r1, 1);
    let k2: Int = list_get(r2, 1);
    let k3: Int = list_get(r3, 1);
    let k4: Int = list_get(r4, 1);
    let k5: Int = list_get(r5, 1);
    let k6: Int = list_get(r6, 1);
    let k7: Int = list_get(r7, 1);
    let k8: Int = list_get(r8, 1);
    let k9: Int = list_get(r9, 1);
    let k10: Int = list_get(r10, 1);
    let k11: Int = list_get(r11, 1);
    let k12: Int = list_get(r12, 1);
    let total: Int = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12;
    let killed: Int = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12;
    if total == 0 {
        println("OVERALL FAILED no mutators fired");
        return 1;
    }
    let rate: Int = (killed * 100) / total;
    println("OVERALL modules=12 total=" + total.to_string() + " killed=" + killed.to_string() + " rate=" + rate.to_string() + "%");
    if rate >= 95 {
        println("mutation_sweep_perscope: PASSED rigorous");
        return 0;
    }
    println("mutation_sweep_perscope: BELOW_THRESHOLD");
    return 1;
}
