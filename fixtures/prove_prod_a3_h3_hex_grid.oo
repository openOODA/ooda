// # Product prove std/gis_spatial/h3_hex_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts h3_is_valid_resolution is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/h3_hex_grid.oo.
//
// Beats:
//   1. Call h3_is_valid_resolution twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_h3_hex_grid: PASSED only if they match.

import "std/gis_spatial/h3_hex_grid.oo";

pub fn main() {
    let h3_hex_grid_mark: Int = 0;
    if h3_hex_grid_mark != 0 {
        process_exit(1);
    }
    let a: Bool = h3_is_valid_resolution(0);
    let b: Bool = h3_is_valid_resolution(0);
    if a != b {
        println("FAIL h3_is_valid_resolution");
        process_exit(1);
    }
    println("prod_h3_hex_grid: PASSED");
}
