// # Product prove std/wasm_gc/jit_tail_call_trampoline.oo
//
// Logline: Fail-closed emit+gcc+run asserts tail_call_trampoline_plan is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_tail_call_trampoline.oo.
//
// Beats:
//   1. Call tail_call_trampoline_plan twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_tail_call_trampoline: PASSED only if they match.

import "std/wasm_gc/jit_tail_call_trampoline.oo";

pub fn main() {
    let jit_tail_call_trampoline_mark: Int = 0;
    if jit_tail_call_trampoline_mark != 0 {
        process_exit(1);
    }
    let jit_tail_call_trampoline_a = tail_call_trampoline_plan(tail_call_descriptor_new(1, 1, 1, 1));
    let jit_tail_call_trampoline_b = tail_call_trampoline_plan(tail_call_descriptor_new(1, 1, 1, 1));
    if (jit_tail_call_trampoline_a).stack_delta_bytes != (jit_tail_call_trampoline_b).stack_delta_bytes {
        println("FAIL tail_call_trampoline_plan");
        process_exit(1);
    }
    println("prod_jit_tail_call_trampoline: PASSED");
}
