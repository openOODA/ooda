// # Property Test: Embedded HAL Signed Integer Decoding
//
// Logline: Verifies two's complement decoding of sub-byte bitmasks (the canonical signed decode pattern used in CAN bus and HAL drivers).
//
// Setup: Pure .oo. Asserts that bitwise operations on Int correctly produce -2 for 0xFE, -128 for 0x80, and signed positive for 0x7F.
//
// Beats:
//   1. Assert 0xFF & 0xFE == 254 (unsigned byte).
//   2. Assert signed decode of 0xFE = -2 (sign bit set).
//   3. Assert 0x80 signed = -128, 0x7F signed = 127.

pub fn hal_signed_decode(byte_val: Int, bits: Int) -> Int {
    let mut threshold: Int = 1;
    let mut k: Int = 0;
    while k < bits {
        threshold = threshold * 2;
        k = k + 1;
    }
    let mut sign_check: Int = byte_val;
    let mut top_bit: Int = 0;
    let mut i: Int = 0;
    while i < bits - 1 {
        sign_check = sign_check / 2;
        i = i + 1;
    }
    top_bit = sign_check;
    if top_bit == 1 {
        return byte_val - threshold;
    }
    return byte_val;
}

pub fn main() {
    let d1: Int = hal_signed_decode(254, 8);
    let d2: Int = hal_signed_decode(128, 8);
    let d3: Int = hal_signed_decode(127, 8);
    let d4: Int = hal_signed_decode(0, 8);
    let mut all_correct: Int = 1;
    if d1 != 0 - 2 { println("FAIL_FE=" + d1.to_string()); all_correct = 0; }
    if d2 != 0 - 128 { println("FAIL_80=" + d2.to_string()); all_correct = 0; }
    if d3 != 127 { println("FAIL_7F=" + d3.to_string()); all_correct = 0; }
    if d4 != 0 { println("FAIL_00=" + d4.to_string()); all_correct = 0; }
    if all_correct == 1 {
        println("hal_signed: PASSED 0xFE=" + d1.to_string() + " 0x80=" + d2.to_string() + " 0x7F=" + d3.to_string() + " 0x00=" + d4.to_string());
    } else {
        process_exit(1);
    }
}
