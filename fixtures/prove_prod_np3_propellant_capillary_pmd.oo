// # Product prove std/space_propulsion/propellant_capillary_pmd.oo
//
// Logline: Fail-closed emit+gcc+run asserts pmd_compute_retention is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_capillary_pmd.oo.
//
// Beats:
//   1. Call pmd_compute_retention twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_capillary_pmd: PASSED only if they match.

import "std/space_propulsion/propellant_capillary_pmd.oo";

pub fn main() {
    let propellant_capillary_pmd_mark: Int = 0;
    if propellant_capillary_pmd_mark != 0 {
        process_exit(1);
    }
    let propellant_capillary_pmd_a = pmd_compute_retention(capillary_pmd_spec_default_hydrazine(), 1.0);
    let propellant_capillary_pmd_b = pmd_compute_retention(capillary_pmd_spec_default_hydrazine(), 1.0);
    if (propellant_capillary_pmd_a).is_bubble_resistant != (propellant_capillary_pmd_b).is_bubble_resistant {
        println("FAIL pmd_compute_retention");
        process_exit(1);
    }
    println("prod_propellant_capillary_pmd: PASSED");
}
