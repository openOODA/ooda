// # Product prove std/db_graph/graph_topological_sort_kahn.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_topological_sort_kahn.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_topological_sort_kahn.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_topological_sort_kahn: PASSED only if they match.

import "std/db_graph/graph_topological_sort_kahn.oo";

pub fn main() {
    let graph_topological_sort_kahn_a = topo_sort_result_new();
    let graph_topological_sort_kahn_b = topo_sort_result_new();
    if graph_topological_sort_kahn_a.is_dag != graph_topological_sort_kahn_b.is_dag {
        println("FAIL graph_topological_sort_kahn");
        process_exit(1);
    }
    println("prod_ap_graph_topological_sort_kahn: PASSED");
