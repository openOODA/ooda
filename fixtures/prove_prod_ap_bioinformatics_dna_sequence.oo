// # Product prove std/bioinformatics/dna_sequence.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/dna_sequence.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/dna_sequence.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dna_sequence: PASSED only if they match.

import "std/bioinformatics/dna_sequence.oo";

pub fn main() {
    let dna_sequence_a = dna_is_valid_nucleotide("x");
    let dna_sequence_b = dna_is_valid_nucleotide("x");
    if dna_sequence_a != dna_sequence_b {
        println("FAIL dna_sequence");
        process_exit(1);
    }
    println("prod_ap_dna_sequence: PASSED");
}
