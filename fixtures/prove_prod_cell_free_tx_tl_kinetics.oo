// # Product prove std/synthetic_biology/cell_free_tx_tl_kinetics.oo
//
// Logline: Fail-closed emit+gcc+run asserts txtl_derivatives real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/cell_free_tx_tl_kinetics.oo.
//
// Beats:
//   1. Call txtl_derivatives with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_cell_free_tx_tl_kinetics: PASSED only if the assert holds.

import "std/synthetic_biology/cell_free_tx_tl_kinetics.oo";

pub fn main() {
    let cell_free_tx_tl_kinetics_mark: Int = 0;
    if cell_free_tx_tl_kinetics_mark != 0 {
        process_exit(1);
    }
    let cell_free_tx_tl_kinetics_st: CellFreeBatchState = CellFreeBatchState { dna_template_nm: 0.0, mrna_conc_nm: 0.0, protein_conc_nm: 0.0, energy_pool_m_m: 0.0, time_hours: 0.0 };
    let cell_free_tx_tl_kinetics_p: CellFreeParams = CellFreeParams { k_tx_max_per_min: 0.0, k_tl_max_per_min: 0.0, d_mrna: 0.0, energy_consumption_per_mrna: 0.0, energy_consumption_per_protein: 0.0, energy_regeneration_rate: 0.0 };
    let cell_free_tx_tl_kinetics_a = txtl_derivatives(&cell_free_tx_tl_kinetics_st, &cell_free_tx_tl_kinetics_p);
    let cell_free_tx_tl_kinetics_dna_template_nm: Float = (cell_free_tx_tl_kinetics_a).dna_template_nm;
    if !(cell_free_tx_tl_kinetics_dna_template_nm == 0.0) {
        println("FAIL txtl_derivatives");
        process_exit(1);
    }
    println("prod_cell_free_tx_tl_kinetics: PASSED");
}
