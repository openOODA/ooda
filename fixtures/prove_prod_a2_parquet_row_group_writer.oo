// # Product prove std/db_columnar/parquet_row_group_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts default_row_group_config is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_row_group_writer.oo.
//
// Beats:
//   1. Call default_row_group_config twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_row_group_writer: PASSED only if they match.

import "std/db_columnar/parquet_row_group_writer.oo";

pub fn main() {
    let parquet_row_group_writer_mark: Int = 0;
    if parquet_row_group_writer_mark != 0 {
        process_exit(1);
    }
    let a: RowGroupWriterConfig = default_row_group_config();
    let b: RowGroupWriterConfig = default_row_group_config();
    if (a).max_row_group_rows != (b).max_row_group_rows {
        println("FAIL default_row_group_config");
        process_exit(1);
    }
    println("prod_parquet_row_group_writer: PASSED");
}
