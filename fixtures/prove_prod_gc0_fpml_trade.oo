// # Product prove std/fintech/fpml_trade.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/fpml_trade.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fpml_trade: PASSED only if they match.

import "std/fintech/fpml_trade.oo";

pub fn main() {
    let fpml_trade_mark: Int = 0;
    if fpml_trade_mark != 0 {
        process_exit(1);
    }
    let fpml_trade_a: Float = int_to_float(1);
    let fpml_trade_b: Float = int_to_float(1);
    if fpml_trade_a != fpml_trade_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_fpml_trade: PASSED");
}
