// # Unary-minus int print
//
// Logline: Print -3 and the negation of a same-fn int bind.
//
// Setup: Side emit-aarch64 writes signed decimal text. No ALU.
//
// Beats:
//   1. Print -3.
//   2. Bind n to 7.
//   3. Print -n as -7.

pub fn main() {
    println(-3);
    let n = 7;
    println(-n);
}
