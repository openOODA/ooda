// # Product prove std/pbr_raytracing/ray_primitive.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_primitive_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/ray_primitive.oo.
//
// Beats:
//   1. Call ray_primitive_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ray_primitive: PASSED only if they match.

import "std/pbr_raytracing/ray_primitive.oo";

pub fn main() {
    let a: Int = ray_primitive_probe();
    let b: Int = ray_primitive_probe();
    if a != b {
        println("FAIL ray_primitive_probe");
        process_exit(1);
    }
    println("prod_g2_ray_primitive: PASSED");
}
