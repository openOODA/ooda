// # Product prove std/telecom_6g/isac_target_detection_cfar.oo
//
// Logline: Fail-closed emit+gcc+run asserts cfar_calc_alpha_ca is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_target_detection_cfar.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cfar_calc_alpha_ca twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_isac_target_detection_cfar: PASSED only if they match.

import "std/telecom_6g/isac_target_detection_cfar.oo";

pub fn main() {
    let g0_a = cfar_calc_alpha_ca(2, 1.0);
    let g0_b = cfar_calc_alpha_ca(2, 1.0);
    if g0_a != g0_b {
        println("FAIL cfar_calc_alpha_ca");
        process_exit(1);
    }
    println("prod_g0_isac_target_detection_cfar: PASSED");
}
