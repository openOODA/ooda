// # Product prove std/quantum_advanced/shor_factorization_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/shor_factorization_pipeline.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_factorization_pipeline.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_shor_factorization_pipeline: PASSED only if they match.

import "std/quantum_advanced/shor_factorization_pipeline.oo";

pub fn main() {
    let shor_factorization_pipeline_a = shor_gcd(0, 0);
    let shor_factorization_pipeline_b = shor_gcd(0, 0);
    if shor_factorization_pipeline_a != shor_factorization_pipeline_b {
        println("FAIL shor_factorization_pipeline");
        process_exit(1);
    }
    println("prod_ap_shor_factorization_pipeline: PASSED");
}
