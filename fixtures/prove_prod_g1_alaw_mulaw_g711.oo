// # Product prove std/media_dsp/alaw_mulaw_g711.oo
//
// Logline: Fail-closed emit+gcc+run asserts g711_linear_to_mulaw is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/alaw_mulaw_g711.oo.
//
// Beats:
//   1. Call g711_linear_to_mulaw twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_alaw_mulaw_g711: PASSED only if they match.

import "std/media_dsp/alaw_mulaw_g711.oo";

pub fn main() {
    let a: Int = g711_linear_to_mulaw(0);
    let b: Int = g711_linear_to_mulaw(0);
    if a != b {
        println("FAIL g711_linear_to_mulaw");
        process_exit(1);
    }
    println("prod_alaw_mulaw_g711: PASSED");
}
