// # Product prove std/graph_gnn/kg_rescal_tensor_factorization.oo
//
// Logline: Fail-closed emit+gcc+run asserts rescal_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_rescal_tensor_factorization.oo.
//
// Beats:
//   1. Call rescal_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_rescal_tensor_factorization: PASSED only if they match.

import "std/graph_gnn/kg_rescal_tensor_factorization.oo";

pub fn main() {
    let kg_rescal_tensor_factorization_mark: Int = 0;
    if kg_rescal_tensor_factorization_mark != 0 {
        process_exit(1);
    }
    let a: RESCALConfig = rescal_config_new(0, 0, 0, 0.0, 0.0);
    let b: RESCALConfig = rescal_config_new(0, 0, 0, 0.0, 0.0);
    if (a).num_entities != (b).num_entities {
        println("FAIL rescal_config_new");
        process_exit(1);
    }
    println("prod_g2_kg_rescal_tensor_factorization: PASSED");
}
