// # Product prove std/hft_alpha/mm_iceberg_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts iceberg_state_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_iceberg_detector.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call iceberg_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_iceberg_detector: PASSED only if they match.

import "std/hft_alpha/mm_iceberg_detector.oo";

pub fn main() {
    let g2_oa: IcebergDetectionState = iceberg_state_new(1.0, true);
    let g2_ob: IcebergDetectionState = iceberg_state_new(1.0, true);
    let g2_a = (g2_oa).price_level;
    let g2_b = (g2_ob).price_level;
    if g2_a != g2_b {
        println("FAIL iceberg_state_new.price_level");
        process_exit(1);
    }
    println("prod_g2_mm_iceberg_detector: PASSED");
}
