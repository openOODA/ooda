// # Product prove std/crypto/fhe_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/fhe_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fhe_types: PASSED only if they match.

import "std/crypto/fhe_types.oo";

pub fn main() {
    let fhe_types_a = fhe_params_new(0, 0, 0);
    let fhe_types_b = fhe_params_new(0, 0, 0);
    let fhe_types_va = fhe_params_degree(fhe_types_a);
    let fhe_types_vb = fhe_params_degree(fhe_types_b);
    if fhe_types_va != fhe_types_vb {
        println("FAIL fhe_types");
        process_exit(1);
    }
    println("prod_ap_fhe_types: PASSED");
}
