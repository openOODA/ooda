// # Product prove std/uav_flight/uav_quadrotor_dynamics_se3.oo
//
// Logline: Fail-closed emit+gcc+run asserts quadrotor_params_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_quadrotor_dynamics_se3.oo.
//
// Beats:
//   1. Call quadrotor_params_default using the uav_quadrotor_dynamics_se3 ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_uav_quadrotor_dynamics_se3: PASSED only if asserts hold.

import "std/uav_flight/uav_quadrotor_dynamics_se3.oo";

pub fn main() {
    let obj = quadrotor_params_default();
    let uav_quadrotor_dynamics_se3_a = obj.mass;
    if uav_quadrotor_dynamics_se3_a != 1.5 {
        println("FAIL quadrotor_params_default");
        process_exit(1);
    }
    println("prod_uav_quadrotor_dynamics_se3: PASSED");
}
