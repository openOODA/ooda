// # Product prove std/sec/sys/elf_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_engine_ready is 1.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_engine.oo.
//
// Beats:
//   1. elf_engine_ready() is 1.
//   2. Exit 1 on miss. Print prod_ap_elf_engine: PASSED only if it holds.

import "std/sec/sys/elf_engine.oo";

pub fn main() {
    let elf_engine_a = elf_engine_ready();
    if elf_engine_a != 1 {
        println("FAIL elf_engine");
        process_exit(1);
    }
    println("prod_ap_elf_engine: PASSED");
}
