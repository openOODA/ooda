// # Product prove std/exploit_analysis/shellcode_egg_hunter.oo
//
// Logline: Fail-closed emit+gcc+run asserts egg_hunter_spec_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/shellcode_egg_hunter.oo.
//
// Beats:
//   1. Call egg_hunter_spec_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shellcode_egg_hunter: PASSED only if they match.

import "std/exploit_analysis/shellcode_egg_hunter.oo";

pub fn main() {
    let a: EggHunterSpec = egg_hunter_spec_new("x", 0, true);
    let b: EggHunterSpec = egg_hunter_spec_new("x", 0, true);
    if a.tag_dword != b.tag_dword {
        println("FAIL egg_hunter_spec_new");
        process_exit(1);
    }
    println("prod_shellcode_egg_hunter: PASSED");
}
