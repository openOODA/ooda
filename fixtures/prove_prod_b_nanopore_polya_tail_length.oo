// # Product prove std/genomics_advanced/nanopore_polya_tail_length.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_polya_tail_length_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_polya_tail_length.oo.
//
// Beats:
//   1. Call nanopore_polya_tail_length_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanopore_polya_tail_length: PASSED only if they match.

import "std/genomics_advanced/nanopore_polya_tail_length.oo";

pub fn main() {
    let a = nanopore_polya_tail_length_probe();
    let b = nanopore_polya_tail_length_probe();
    if a != b {
        println("FAIL nanopore_polya_tail_length_probe");
        process_exit(1);
    }
    println("prod_nanopore_polya_tail_length: PASSED");
}
