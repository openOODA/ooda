// # Product prove std/sync/reentrant_mutex.oo
//
// Logline: Fail-closed emit+gcc+run asserts reentrant_mutex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/reentrant_mutex.oo.
//
// Beats:
//   1. Call reentrant_mutex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_reentrant_mutex: PASSED only if they match.

import "std/sync/reentrant_mutex.oo";

pub fn main() {
    let obj = reentrant_mutex_new();
    let a = obj.owner_id;
    let b = obj.owner_id;
    if a != b {
        println("FAIL reentrant_mutex_new");
        process_exit(1);
    }
    println("prod_reentrant_mutex: PASSED");
}
