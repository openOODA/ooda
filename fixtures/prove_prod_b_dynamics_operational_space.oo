// # Product prove std/robotics_ros2/dynamics_operational_space.oo
//
// Logline: Fail-closed emit+gcc+run asserts dynamics_operational_space_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/dynamics_operational_space.oo.
//
// Beats:
//   1. Call dynamics_operational_space_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dynamics_operational_space: PASSED only if they match.

import "std/robotics_ros2/dynamics_operational_space.oo";

pub fn main() {
    let a = dynamics_operational_space_probe();
    let b = dynamics_operational_space_probe();
    if a != b {
        println("FAIL dynamics_operational_space_probe");
        process_exit(1);
    }
    println("prod_dynamics_operational_space: PASSED");
}
