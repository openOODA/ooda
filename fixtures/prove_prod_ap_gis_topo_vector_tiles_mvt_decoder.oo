// # Product prove std/gis_topo/vector_tiles_mvt_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_topo/vector_tiles_mvt_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/vector_tiles_mvt_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_tiles_mvt_decoder: PASSED only if they match.

import "std/gis_topo/vector_tiles_mvt_decoder.oo";

pub fn main() {
    let vector_tiles_mvt_decoder_a = mvt_decode_zigzag(0);
    let vector_tiles_mvt_decoder_b = mvt_decode_zigzag(0);
    if vector_tiles_mvt_decoder_a != vector_tiles_mvt_decoder_b {
        println("FAIL vector_tiles_mvt_decoder");
        process_exit(1);
    }
    println("prod_ap_vector_tiles_mvt_decoder: PASSED");
}
