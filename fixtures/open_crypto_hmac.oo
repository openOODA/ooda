// # CHS sha256 and hmac lengths
//
// Logline: Product crypto builtins return 64 hex chars. This is not a FIPS pin.
//
// Setup: OPEN-44. crypto_*_internal. CHS K256 is not FIPS.
//
// Beats:
//   1. Hash hello.
//   2. HMAC hello with key k.
//   3. Print both lengths and require 64.

pub fn main() {
    let h: String = crypto_sha256_internal("hello");
    let m: String = crypto_hmac_sha256_internal("k", "hello");
    let hlen: Int = chars_len(h);
    let mlen: Int = chars_len(m);
    println(hlen);
    println(mlen);
    if hlen != 64 {
        println("FAIL: sha256 len");
        process_exit(1);
    }
    if mlen != 64 {
        println("FAIL: hmac_sha256 len");
        process_exit(1);
    }
    println("open_crypto_hmac: PASSED");
}
