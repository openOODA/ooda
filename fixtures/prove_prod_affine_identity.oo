// # Product prove std/pbr_raytracing/bvh_tlas_blas_instancing.oo
//
// Logline: Fail-closed emit+gcc+run asserts affine_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/bvh_tlas_blas_instancing.oo.
//
// Beats:
//   1. Call affine_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_affine_identity: PASSED only if they match.

import "std/pbr_raytracing/bvh_tlas_blas_instancing.oo";

pub fn main() {
    let bvh_tlas_blas_instancing_mark: Int = 0;
    if bvh_tlas_blas_instancing_mark != 0 { process_exit(1); }
    let a: AffineTransform = affine_identity();
    let b: AffineTransform = affine_identity();
    let am: Float = (a).m00;
    let bm: Float = (b).m00;
    if am != bm {
        println("FAIL affine_identity");
        process_exit(1);
    }
    println("prod_affine_identity: PASSED");
}
