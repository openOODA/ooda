// # Product prove std/web_protocols/oidc_jwt_claims.oo
//
// Logline: Fail-closed emit+gcc+run asserts oidc_claims_is_expired is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/oidc_jwt_claims.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call oidc_claims_is_expired twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_oidc_jwt_claims: PASSED only if they match.

import "std/web_protocols/oidc_jwt_claims.oo";

pub fn main() {
    let g0_oa = oidc_claims_new(2, 2, 2, 2, 2, 2);
    let g0_ob = oidc_claims_new(2, 2, 2, 2, 2, 2);
    let g0_a = oidc_claims_is_expired(g0_oa, 2);
    let g0_b = oidc_claims_is_expired(g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL oidc_claims_is_expired");
        process_exit(1);
    }
    println("prod_g0_oidc_jwt_claims: PASSED");
}
