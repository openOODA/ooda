// # Product prove std/physics_advanced/finite_wing_lifting_line.oo
//
// Logline: Fail-closed emit+gcc+run asserts finite_wing_induced_drag_cdi is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/finite_wing_lifting_line.oo.
//
// Beats:
//   1. Call finite_wing_induced_drag_cdi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_finite_wing_lifting_line: PASSED only if they match.

import "std/physics_advanced/finite_wing_lifting_line.oo";

pub fn main() {
    let finite_wing_lifting_line_mark: Int = 0;
    if finite_wing_lifting_line_mark != 0 {
        process_exit(1);
    }
    let a: Float = finite_wing_induced_drag_cdi(0.0, 0.0, 0.0);
    let b: Float = finite_wing_induced_drag_cdi(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL finite_wing_induced_drag_cdi");
        process_exit(1);
    }
    println("prod_finite_wing_lifting_line: PASSED");
}
