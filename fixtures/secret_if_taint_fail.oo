// # Refuse a secret assigned in an if
//
// Logline: Assigning a tagged name inside an if taints the later println.
//
// Beats:
//   1. Tag secret at line start.
//   2. Rebind s to that name in the true branch.
//   3. Print s so the sink refuses.

// T1 if-taint: secret assigned inside if-branch, then used at println sink
// SECRET: secret
pub fn main() {
    let secret = "token";
    let mut s = "public";
    if true {
        s = secret;
    }
    println(s);
}
