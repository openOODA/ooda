// # Product prove std/space_propulsion/field_emission_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts feep_spec_default_indium is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/field_emission_electric_propulsion.oo.
//
// Beats:
//   1. Call feep_spec_default_indium twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_field_emission_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/field_emission_electric_propulsion.oo";

pub fn main() {
    let field_emission_electric_propulsion_mark: Int = 0;
    if field_emission_electric_propulsion_mark != 0 {
        process_exit(1);
    }
    let a: FeepEmitterSpec = feep_spec_default_indium();
    let b: FeepEmitterSpec = feep_spec_default_indium();
    if (a).num_emitters != (b).num_emitters {
        println("FAIL feep_spec_default_indium");
        process_exit(1);
    }
    println("prod_field_emission_electric_propulsion: PASSED");
}
