// # Product prove std/physics/rigid_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/rigid_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/rigid_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rigid_types: PASSED only if they match.

import "std/physics/rigid_types.oo";

pub fn main() {
    let rigid_types_a = rigid_body_new(0, 0);
    let rigid_types_b = rigid_body_new(0, 0);
    let rigid_types_va = rigid_body_mass(rigid_types_a);
    let rigid_types_vb = rigid_body_mass(rigid_types_b);
    if rigid_types_va != rigid_types_vb {
        println("FAIL rigid_types");
        process_exit(1);
    }
    println("prod_ap_rigid_types: PASSED");
}
