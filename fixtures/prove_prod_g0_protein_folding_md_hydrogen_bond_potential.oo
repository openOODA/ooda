// # Product prove std/protein_folding/md_hydrogen_bond_potential.oo
//
// Logline: Fail-closed emit+gcc+run asserts hbond_calc_radial_12_10 is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_hydrogen_bond_potential.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hbond_calc_radial_12_10 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_md_hydrogen_bond_potential: PASSED only if they match.

import "std/protein_folding/md_hydrogen_bond_potential.oo";

pub fn main() {
    let g0_a = hbond_calc_radial_12_10(1.0, 1.0, 1.0);
    let g0_b = hbond_calc_radial_12_10(1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL hbond_calc_radial_12_10");
        process_exit(1);
    }
    println("prod_g0_md_hydrogen_bond_potential: PASSED");
}
