// # Product prove std/edge/ota_engine.oo
//
// Logline: Fail-closed verification that edge OTA engine lifecycle operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/ota_engine.oo.
//
// Beats:
//   1. Initialize OTA manager and manifest structures.
//   2. Step through update staging, chunk ingestion, and verification.
//   3. Assert deterministic state transitions and error-free execution.
//   4. Print prod_g4_edge_ota_engine: PASSED and exit 0.

import "std/edge/ota_engine.oo";

pub fn main() {
    let probe1: Int = ota_engine_probe();
    let probe2: Int = ota_engine_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL ota_engine_probe");
        process_exit(1);
    }

    let cap: &SysCap = 0;
    let mut mgr1: OtaManager = ota_manager_init(cap);
    let mut mgr2: OtaManager = ota_manager_init(cap);

    let st1: Int = ota_manager_get_state(&mgr1);
    let st2: Int = ota_manager_get_state(&mgr2);
    if st1 != st2 || st1 != 0 {
        println("FAIL ota_manager_get_state");
        process_exit(1);
    }

    let manifest1: OtaManifest = ota_manifest_new(2, 0, 0, 101, 4096, 54321, true, false);
    let manifest2: OtaManifest = ota_manifest_new(2, 0, 0, 101, 4096, 54321, true, false);

    let v_code1: Int = ota_manifest_version_code(&manifest1);
    let v_code2: Int = ota_manifest_version_code(&manifest2);
    if v_code1 != v_code2 || v_code1 != 20000 {
        println("FAIL ota_manifest_version_code");
        process_exit(1);
    }

    let started1: Bool = ota_manager_start_update(&mut mgr1, &manifest1);
    let started2: Bool = ota_manager_start_update(&mut mgr2, &manifest2);
    if started1 != started2 || started1 == false {
        println("FAIL ota_manager_start_update");
        process_exit(1);
    }

    let chunk_st1: Int = ota_manager_chunk_received(&mut mgr1, 4096);
    let chunk_st2: Int = ota_manager_chunk_received(&mut mgr2, 4096);
    if chunk_st1 != chunk_st2 || chunk_st1 != 2 {
        println("FAIL ota_manager_chunk_received");
        process_exit(1);
    }

    let prog1: Int = ota_manager_get_progress(&mgr1);
    let prog2: Int = ota_manager_get_progress(&mgr2);
    if prog1 != prog2 || prog1 != 100 {
        println("FAIL ota_manager_get_progress");
        process_exit(1);
    }

    let v1: Bool = ota_manager_verify_payload(&mut mgr1, 54321, true);
    let v2: Bool = ota_manager_verify_payload(&mut mgr2, 54321, true);
    if v1 != v2 || v1 == false {
        println("FAIL ota_manager_verify_payload");
        process_exit(1);
    }

    let apply1: Bool = ota_manager_apply_update(&mut mgr1, cap);
    let apply2: Bool = ota_manager_apply_update(&mut mgr2, cap);
    if apply1 != apply2 || apply1 == false {
        println("FAIL ota_manager_apply_update");
        process_exit(1);
    }

    let boot1: Bool = ota_manager_mark_boot_successful(&mut mgr1);
    let boot2: Bool = ota_manager_mark_boot_successful(&mut mgr2);
    if boot1 != boot2 || boot1 == false {
        println("FAIL ota_manager_mark_boot_successful");
        process_exit(1);
    }

    println("prod_g4_edge_ota_engine: PASSED");
    process_exit(0);
}
