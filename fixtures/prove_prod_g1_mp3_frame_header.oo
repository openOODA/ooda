// # Product prove std/media_dsp/mp3_frame_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts mp3_frame_header_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/mp3_frame_header.oo.
//
// Beats:
//   1. Call mp3_frame_header_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mp3_frame_header: PASSED only if they match.

import "std/media_dsp/mp3_frame_header.oo";

pub fn main() {
    let a: Mp3FrameHeader = mp3_frame_header_parse(0);
    let b: Mp3FrameHeader = mp3_frame_header_parse(0);
    if a.mpeg_version != b.mpeg_version {
        println("FAIL mp3_frame_header_parse");
        process_exit(1);
    }
    println("prod_mp3_frame_header: PASSED");
}
