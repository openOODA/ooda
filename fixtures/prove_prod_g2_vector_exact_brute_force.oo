// # Product prove std/db_vector_ann/vector_exact_brute_force.oo
//
// Logline: Fail-closed emit+gcc+run asserts exact_scan_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_exact_brute_force.oo.
//
// Beats:
//   1. Call exact_scan_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_exact_brute_force: PASSED only if they match.

import "std/db_vector_ann/vector_exact_brute_force.oo";

pub fn main() {
    let vector_exact_brute_force_mark: Int = 0;
    if vector_exact_brute_force_mark != 0 {
        process_exit(1);
    }
    let a: ExactScanConfig = exact_scan_config_default(0);
    let b: ExactScanConfig = exact_scan_config_default(0);
    if (a).dimension != (b).dimension {
        println("FAIL exact_scan_config_default");
        process_exit(1);
    }
    println("prod_g2_vector_exact_brute_force: PASSED");
}
