// # Product prove std/tui/key_events.oo
//
// Logline: Fail-closed emit+gcc+run asserts key_event_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/key_events.oo.
//
// Beats:
//   1. Call key_event_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_key_events: PASSED only if they match.

import "std/tui/key_events.oo";

pub fn main() {
    let key_events_mark: Int = 0;
    if key_events_mark != 0 {
        process_exit(1);
    }
    let a: KeyEvent = key_event_new(0, "x");
    let b: KeyEvent = key_event_new(0, "x");
    if (a).key_code != (b).key_code {
        println("FAIL key_event_new");
        process_exit(1);
    }
    println("prod_g2_key_events: PASSED");
}
