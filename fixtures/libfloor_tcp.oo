// M161 path A: NetCap + tcp_connect → residual Err (no real socket).
// main injects long long net = oo_cap_grant_net();
// Honesty: Result err "net residual: path A seal only (no full TCP/UDP/TLS product)"
pub fn main(net: &NetCap) {
    let r: Result[String, String] = tcp_connect(net, "127.0.0.1", 1);
    if r.is_ok() {
        println("tcp-unexpected-ok");
    } else {
        println("tcp-residual-ok");
    }
}
