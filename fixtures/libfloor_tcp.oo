// M162 path A: NetCap + tcp_connect real TCP (port 1 usually refused → Err)
// Also proves grant path. Real connect Ok only if something listens.
pub fn main(net: &NetCap) {
    let r: Result[String, String] = tcp_connect(net, "127.0.0.1", 1);
    if r.is_ok() {
        println("tcp-connected");
    } else {
        // connection refused / resolve fail are product Err (not residual stub)
        println("tcp-err-ok");
    }
    let b: Result[String, String] = tcp_bind(net, 0);
    // port 0 is bad in path A (1..65535)
    if b.is_err() {
        println("tcp-bind-badport-ok");
    }
}
