// # Product prove std/quantum/circuit_runner.oo
//
// Logline: Fail-closed emit+gcc+run asserts qamp_mul_add is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/circuit_runner.oo.
//
// Beats:
//   1. Call qamp_mul_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_circuit_runner: PASSED only if they match.

import "std/quantum/circuit_runner.oo";

pub fn main() {
    let circuit_runner_mark: Int = 0;
    if circuit_runner_mark != 0 {
        process_exit(1);
    }
    let a: QAmp = qamp_mul_add(0, 0, 0, 0, 0, 0, 0, 0);
    let b: QAmp = qamp_mul_add(0, 0, 0, 0, 0, 0, 0, 0);
    if (a).re_milli != (b).re_milli {
        println("FAIL qamp_mul_add");
        process_exit(1);
    }
    println("prod_circuit_runner: PASSED");
}
