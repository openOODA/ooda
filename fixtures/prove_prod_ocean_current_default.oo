// # Product prove std/robotics_auv/ocean_current_kinematics.oo
//
// Logline: Fail-closed emit+gcc+run asserts ocean_current_profile_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/ocean_current_kinematics.oo.
//
// Beats:
//   1. Call ocean_current_profile_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ocean_current_default: PASSED only if they match.

import "std/robotics_auv/ocean_current_kinematics.oo";

pub fn main() {
    let ocean_current_kinematics_mark: Int = 0;
    if ocean_current_kinematics_mark != 0 { process_exit(1); }
    let a: OceanCurrentProfile = ocean_current_profile_default();
    let b: OceanCurrentProfile = ocean_current_profile_default();
    let as: Float = (a).surface_speed_m_s;
    let bs: Float = (b).surface_speed_m_s;
    if as != bs {
        println("FAIL ocean_current_profile_default");
        process_exit(1);
    }
    println("prod_ocean_current_default: PASSED");
}
