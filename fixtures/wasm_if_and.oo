// # Const if true && true println
//
// Logline: Print and-then when the condition is true && true.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If true && true print and-then else print and-else.
//   3. Leave no other statements.

pub fn main() {
    if true && true {
        println("and-then");
    } else {
        println("and-else");
    }
}
