// # Product prove std/os/cmd.oo
//
// Logline: Fail-closed emit+gcc+run asserts cmd_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/cmd.oo.
//
// Beats:
//   1. Call cmd_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cmd: PASSED only if they match.

import "std/os/cmd.oo";

pub fn main() {
    let xa = cmd_new("x");
    let xb = cmd_new("x");
    let a = list_len(xa);
    let b = list_len(xb);
    if a != b {
        println("FAIL cmd_new");
        process_exit(1);
    }
    println("prod_cmd: PASSED");
}
