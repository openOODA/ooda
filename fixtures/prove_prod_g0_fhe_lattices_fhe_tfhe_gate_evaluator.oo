// # Product prove std/fhe_lattices/fhe_tfhe_gate_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts tfhe_gate_nand_phase is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_tfhe_gate_evaluator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tfhe_gate_nand_phase twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_tfhe_gate_evaluator: PASSED only if they match.

import "std/fhe_lattices/fhe_tfhe_gate_evaluator.oo";

pub fn main() {
    let g0_a = tfhe_gate_nand_phase(1.0, 1.0);
    let g0_b = tfhe_gate_nand_phase(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL tfhe_gate_nand_phase");
        process_exit(1);
    }
    println("prod_g0_fhe_tfhe_gate_evaluator: PASSED");
}
