// # Product prove std/satellite_dvb/satellite_group_delay_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts transponder_calc_group_delay_ns is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_group_delay_filter.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call transponder_calc_group_delay_ns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_satellite_group_delay_filter: PASSED only if they match.

import "std/satellite_dvb/satellite_group_delay_filter.oo";

pub fn main() {
    let g0_oa: TransponderGroupDelay = TransponderGroupDelay { channel_bw_mhz: 1.0, center_freq_mhz: 1.0, linear_slope_ns_per_mhz: 1.0, // Linear delay coefficient b1
    parabolic_curv_ns_per_mhz2: 1.0, // Parabolic delay coefficient b2
    ripple_peak_ns: 1.0, // Periodic ripple amplitude
    ripple_period_mhz: 1.0 };
    let g0_ob: TransponderGroupDelay = TransponderGroupDelay { channel_bw_mhz: 1.0, center_freq_mhz: 1.0, linear_slope_ns_per_mhz: 1.0, // Linear delay coefficient b1
    parabolic_curv_ns_per_mhz2: 1.0, // Parabolic delay coefficient b2
    ripple_peak_ns: 1.0, // Periodic ripple amplitude
    ripple_period_mhz: 1.0 };
    let g0_a = transponder_calc_group_delay_ns(&g0_oa, 1.0);
    let g0_b = transponder_calc_group_delay_ns(&g0_ob, 1.0);
    if g0_a != g0_b {
        println("FAIL transponder_calc_group_delay_ns");
        process_exit(1);
    }
    println("prod_g0_satellite_group_delay_filter: PASSED");
}
