// # Product prove std/satellite_dvb/gnss_gps_l1_ca_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts gps_step_ca_chip is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_gps_l1_ca_generator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gps_step_ca_chip twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_gnss_gps_l1_ca_generator: PASSED only if they match.

import "std/satellite_dvb/gnss_gps_l1_ca_generator.oo";

pub fn main() {
    let mut g0_oa: GpsPrnConfig = GpsPrnConfig { sv_id: 2, g2_tap_a: 2, g2_tap_b: 2, g1_state: 2, // 10-bit register (all 1s init = 1023)
    g2_state: 2, // 10-bit register
    chip_counter: 8 };
    let mut g0_ob: GpsPrnConfig = GpsPrnConfig { sv_id: 2, g2_tap_a: 2, g2_tap_b: 2, g1_state: 2, // 10-bit register (all 1s init = 1023)
    g2_state: 2, // 10-bit register
    chip_counter: 8 };
    let g0_a = gps_step_ca_chip(&g0_oa);
    let g0_b = gps_step_ca_chip(&g0_ob);
    if g0_a != g0_b {
        println("FAIL gps_step_ca_chip");
        process_exit(1);
    }
    println("prod_g0_gnss_gps_l1_ca_generator: PASSED");
}
