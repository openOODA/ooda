// # Product prove std/bioinformatics/rna_secondary_structure.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/rna_secondary_structure.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/rna_secondary_structure.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rna_secondary_structure: PASSED only if they match.

import "std/bioinformatics/rna_secondary_structure.oo";

pub fn main() {
    let rna_secondary_structure_a = int_pow4(0);
    let rna_secondary_structure_b = int_pow4(0);
    if rna_secondary_structure_a != rna_secondary_structure_b {
        println("FAIL rna_secondary_structure");
        process_exit(1);
    }
    println("prod_ap_rna_secondary_structure: PASSED");
}
