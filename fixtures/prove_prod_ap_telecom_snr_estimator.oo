// # Product prove std/telecom/snr_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/snr_estimator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/snr_estimator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_snr_estimator: PASSED only if they match.

import "std/telecom/snr_estimator.oo";

pub fn main() {
    let snr_estimator_a = snr_ln_approx(0.0);
    let snr_estimator_b = snr_ln_approx(0.0);
    if snr_estimator_a != snr_estimator_b {
        println("FAIL snr_estimator");
        process_exit(1);
    }
    println("prod_ap_snr_estimator: PASSED");
}
