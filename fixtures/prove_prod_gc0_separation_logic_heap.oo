// # Product prove std/formal_verif/separation_logic_heap.oo
//
// Logline: Fail-closed emit+gcc+run asserts frame_rule_check is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/separation_logic_heap.oo.
//
// Beats:
//   1. Call frame_rule_check twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_separation_logic_heap: PASSED only if they match.

import "std/formal_verif/separation_logic_heap.oo";

pub fn main() {
    let separation_logic_heap_mark: Int = 0;
    if separation_logic_heap_mark != 0 {
        process_exit(1);
    }
    let separation_logic_heap_a: Bool = frame_rule_check(true, true);
    let separation_logic_heap_b: Bool = frame_rule_check(true, true);
    if separation_logic_heap_a != separation_logic_heap_b {
        println("FAIL frame_rule_check");
        process_exit(1);
    }
    println("prod_separation_logic_heap: PASSED");
}
