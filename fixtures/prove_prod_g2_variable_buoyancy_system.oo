// # Product prove std/robotics_auv/variable_buoyancy_system.oo
//
// Logline: Fail-closed emit+gcc+run asserts vbs_clamp_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/variable_buoyancy_system.oo.
//
// Beats:
//   1. Call vbs_clamp_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_variable_buoyancy_system: PASSED only if they match.

import "std/robotics_auv/variable_buoyancy_system.oo";

pub fn main() {
    let variable_buoyancy_system_mark: Int = 0;
    if variable_buoyancy_system_mark != 0 {
        process_exit(1);
    }
    let a: Int = vbs_clamp_int(0, 0, 0);
    let b: Int = vbs_clamp_int(0, 0, 0);
    if a != b {
        println("FAIL vbs_clamp_int");
        process_exit(1);
    }
    println("prod_g2_variable_buoyancy_system: PASSED");
}
