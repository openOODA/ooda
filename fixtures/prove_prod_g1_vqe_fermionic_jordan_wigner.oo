// # Product prove std/quantum_advanced/vqe_fermionic_jordan_wigner.oo
//
// Logline: Fail-closed emit+gcc+run asserts jw_pauli_string_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_fermionic_jordan_wigner.oo.
//
// Beats:
//   1. Call jw_pauli_string_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vqe_fermionic_jordan_wigner: PASSED only if they match.

import "std/quantum_advanced/vqe_fermionic_jordan_wigner.oo";

pub fn main() {
    let a: JwPauliString = jw_pauli_string_new(0, 0.0);
    let b: JwPauliString = jw_pauli_string_new(0, 0.0);
    if a.num_qubits != b.num_qubits {
        println("FAIL jw_pauli_string_new");
        process_exit(1);
    }
    println("prod_vqe_fermionic_jordan_wigner: PASSED");
}
