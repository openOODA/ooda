// # Product prove std/exploit_analysis/bop_block_oriented_programming.oo
//
// Logline: Fail-closed emit+gcc+run asserts bop_basic_block_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/bop_block_oriented_programming.oo.
//
// Beats:
//   1. Call bop_basic_block_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bop_block_oriented_programming: PASSED only if they match.

import "std/exploit_analysis/bop_block_oriented_programming.oo";

pub fn main() {
    let a: BopBasicBlock = bop_basic_block_new("x", 0, 0, "x", "x", 0);
    let b: BopBasicBlock = bop_basic_block_new("x", 0, 0, "x", "x", 0);
    if a.start_address != b.start_address {
        println("FAIL bop_basic_block_new");
        process_exit(1);
    }
    println("prod_bop_block_oriented_programming: PASSED");
}
