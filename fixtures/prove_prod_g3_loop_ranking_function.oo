// # Product prove std/formal_verif/loop_ranking_function.oo
//
// Logline: Fail-closed emit+gcc+run asserts ranking_function_linear is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/loop_ranking_function.oo.
//
// Beats:
//   1. Call ranking_function_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_loop_ranking_function: PASSED only if they match.

import "std/formal_verif/loop_ranking_function.oo";

pub fn main() {
    let loop_ranking_function_mark: Int = 0;
    if loop_ranking_function_mark != 0 {
        process_exit(1);
    }
    let a: RankingFunction = ranking_function_linear("x", 0, 0);
    let b: RankingFunction = ranking_function_linear("x", 0, 0);
    if (a).coefficient != (b).coefficient {
        println("FAIL ranking_function_linear");
        process_exit(1);
    }
    println("prod_loop_ranking_function: PASSED");
}
