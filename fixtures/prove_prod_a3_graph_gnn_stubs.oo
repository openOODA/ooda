// # Product prove std/graph_gnn/graph_gnn_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_gnn_accel_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_gnn_stubs.oo.
//
// Beats:
//   1. Call graph_gnn_accel_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_gnn_stubs: PASSED only if they match.

import "std/graph_gnn/graph_gnn_stubs.oo";

pub fn main() {
    let graph_gnn_stubs_mark: Int = 0;
    if graph_gnn_stubs_mark != 0 {
        process_exit(1);
    }
    let a: GraphGNNHardwareAccel = graph_gnn_accel_init(0);
    let b: GraphGNNHardwareAccel = graph_gnn_accel_init(0);
    if (a).device_id != (b).device_id {
        println("FAIL graph_gnn_accel_init");
        process_exit(1);
    }
    println("prod_graph_gnn_stubs: PASSED");
}
