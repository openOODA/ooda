// # Product prove std/ai_multimodal/diffusion_flow_matching.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/diffusion_flow_matching.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_flow_matching.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diffusion_flow_matching: PASSED only if they match.

import "std/ai_multimodal/diffusion_flow_matching.oo";

pub fn main() {
    let diffusion_flow_matching_a = flow_euler_step(0, 0, 0);
    let diffusion_flow_matching_b = flow_euler_step(0, 0, 0);
    if diffusion_flow_matching_a != diffusion_flow_matching_b {
        println("FAIL diffusion_flow_matching");
        process_exit(1);
    }
    println("prod_ap_diffusion_flow_matching: PASSED");
}
