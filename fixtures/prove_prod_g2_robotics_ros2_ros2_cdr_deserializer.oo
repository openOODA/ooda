// # Product prove std/robotics_ros2/ros2_cdr_deserializer.oo
//
// Logline: Fail-closed emit+gcc+run asserts cdr_decoder_calculate_padding is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_cdr_deserializer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cdr_decoder_calculate_padding twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ros2_cdr_deserializer: PASSED only if they match.

import "std/robotics_ros2/ros2_cdr_deserializer.oo";

pub fn main() {
    let g2_a = cdr_decoder_calculate_padding(2, 2);
    let g2_b = cdr_decoder_calculate_padding(2, 2);
    if g2_a != g2_b {
        println("FAIL cdr_decoder_calculate_padding");
        process_exit(1);
    }
    println("prod_g2_ros2_cdr_deserializer: PASSED");
}
