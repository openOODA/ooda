// # Product prove std/cloud_k8s/load_balancer_round_robin.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_k8s/load_balancer_round_robin.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/load_balancer_round_robin.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_load_balancer_round_robin: PASSED only if they match.

import "std/cloud_k8s/load_balancer_round_robin.oo";

pub fn main() {
    let load_balancer_round_robin_a = round_robin_balancer_new(0, 0);
    let load_balancer_round_robin_b = round_robin_balancer_new(0, 0);
    let load_balancer_round_robin_va = round_robin_last_pick(load_balancer_round_robin_a);
    let load_balancer_round_robin_vb = round_robin_last_pick(load_balancer_round_robin_b);
    if load_balancer_round_robin_va != load_balancer_round_robin_vb {
        println("FAIL load_balancer_round_robin");
        process_exit(1);
    }
    println("prod_ap_load_balancer_round_robin: PASSED");
}
