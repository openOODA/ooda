// # list_set List[Node] emit lock
//
// Logline: Fail-closed emit+gcc+run of list_set on List[Node] index 0.
//
// Setup: Backend-C. Node has Int id and String tag.
//
// Beats:
//   1. Push a node with id 1.
//   2. list_set index 0 to id 7 tag ok.
//   3. Exit 1 before PASSED when get id is not 7.

type Node = struct {
    id: Int,
    tag: String
};

pub fn main() {
    let mut xs: List[Node] = list_new();
    let n0: Node = Node { id: 1, tag: "a" };
    xs = list_push(xs, n0);
    let n1: Node = Node { id: 7, tag: "ok" };
    xs = list_set(xs, 0, n1);
    let g: Node = list_get(xs, 0);
    if g.id != 7 {
        println("FAIL id");
        process_exit(1);
    }
    if g.tag != "ok" {
        println("FAIL tag");
        process_exit(1);
    }
    println("list_set_node_smoke: PASSED");
}
