// # Call verify_human without caps
//
// Logline: A bare verify_human without EnvCap and FsCap must refuse at check or emit.
//
// Beats:
//   1. Call verify_human with the wrong arity and no caps.
//   2. Branch on Ok versus Err so both arms exist.
//   3. Point path A at hitl_verify_human.oo.

// Historical residual fixture — bare verify_human without caps must refuse at check/emit.
// Path A product: fixtures/hitl_verify_human.oo with &EnvCap + &FsCap.
pub fn main() {
    // Intentionally wrong arity/caps — expect check or emit refuse
    let r: Result[String, String] = verify_human("ok?");
    if r.is_ok() {
        println("ok");
    } else {
        println("deny");
    }
}
