// # Product prove std/cloud/otel_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts otel_tracer_completed_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/otel_trace.oo.
//
// Beats:
//   1. Call otel_tracer_completed_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_otel_trace: PASSED only if they match.

import "std/cloud/otel_trace.oo";

pub fn main() {
    let otel_trace_mark: Int = 0;
    if otel_trace_mark != 0 {
        process_exit(1);
    }
    let otel_trace_obj: OtelTracer = otel_tracer_new("x", "x");
    let otel_trace_a: Int = otel_tracer_completed_count(&otel_trace_obj);
    let otel_trace_b: Int = otel_tracer_completed_count(&otel_trace_obj);
    if otel_trace_a != otel_trace_b {
        println("FAIL otel_tracer_completed_count");
        process_exit(1);
    }
    println("prod_otel_trace: PASSED");
}
