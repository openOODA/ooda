// # Match-expression payload bind
//
// Logline: Returns the Ok or Err string from a Result match expression so LLVM emit can prove a real phi.
//
// Setup: Ok and Err constructors and println exist.
//
// Beats:
//   1. take_ok matches Ok("hello") and returns the payload.
//   2. take_err matches Err("bad") and returns the payload.
//   3. main prints both lines.

pub fn take_ok() -> String {
    let r: Result[String, String] = Ok("hello");
    return match r {
        Ok(s) => s,
        Err(e) => e,
    };
}

pub fn take_err() -> String {
    let r: Result[String, String] = Err("bad");
    return match r {
        Ok(s) => s,
        Err(e) => e,
    };
}

pub fn main() {
    println(take_ok());
    println(take_err());
}
