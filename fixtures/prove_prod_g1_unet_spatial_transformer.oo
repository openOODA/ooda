// # Product prove std/ai_multimodal/unet_spatial_transformer.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_transformer_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_spatial_transformer.oo.
//
// Beats:
//   1. Call spatial_transformer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_unet_spatial_transformer: PASSED only if they match.

import "std/ai_multimodal/unet_spatial_transformer.oo";

pub fn main() {
    let a: SpatialTransformerConfig = spatial_transformer_config_new(0, 0, 0, 0);
    let b: SpatialTransformerConfig = spatial_transformer_config_new(0, 0, 0, 0);
    if a.channels != b.channels {
        println("FAIL spatial_transformer_config_new");
        process_exit(1);
    }
    println("prod_unet_spatial_transformer: PASSED");
}
