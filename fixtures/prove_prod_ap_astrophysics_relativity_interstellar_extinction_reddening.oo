// # Product prove std/astrophysics_relativity/interstellar_extinction_reddening.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/interstellar_extinction_reddening.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/interstellar_extinction_reddening.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_interstellar_extinction_reddening: PASSED only if they match.

import "std/astrophysics_relativity/interstellar_extinction_reddening.oo";

pub fn main() {
    let interstellar_extinction_reddening_a = ccm_extinction_ratio(0, 0);
    let interstellar_extinction_reddening_b = ccm_extinction_ratio(0, 0);
    if interstellar_extinction_reddening_a != interstellar_extinction_reddening_b {
        println("FAIL interstellar_extinction_reddening");
        process_exit(1);
    }
    println("prod_ap_interstellar_extinction_reddening: PASSED");
}
