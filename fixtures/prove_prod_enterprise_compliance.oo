// # Product prove std/enterprise/compliance.oo
//
// Logline: Fail-closed emit+gcc+run asserts compliance_requirement_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/compliance.oo.
//
// Beats:
//   1. Call compliance_requirement_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compliance: PASSED only if they match.

import "std/enterprise/compliance.oo";

pub fn main() {
    let enterprise_compliance_mark: Int = 0;
    if enterprise_compliance_mark != 0 {
        process_exit(1);
    }
    let a: ComplianceRequirement = compliance_requirement_create(1, "x", "y", "z", 0, false);
    let b: ComplianceRequirement = compliance_requirement_create(1, "x", "y", "z", 0, false);
    if (a).id != (b).id {
        println("FAIL compliance_requirement_create");
        process_exit(1);
    }
    println("prod_compliance: PASSED");
}
