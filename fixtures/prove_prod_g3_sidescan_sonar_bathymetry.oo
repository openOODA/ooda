// # Product prove std/robotics_auv/sidescan_sonar_bathymetry.oo
//
// Logline: Fail-closed emit+gcc+run asserts sidescan_slant_to_ground_range is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/sidescan_sonar_bathymetry.oo.
//
// Beats:
//   1. Call sidescan_slant_to_ground_range twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sidescan_sonar_bathymetry: PASSED only if they match.

import "std/robotics_auv/sidescan_sonar_bathymetry.oo";

pub fn main() {
    let sidescan_sonar_bathymetry_mark: Int = 0;
    if sidescan_sonar_bathymetry_mark != 0 {
        process_exit(1);
    }
    let a: Float = sidescan_slant_to_ground_range(0.0, 0.0);
    let b: Float = sidescan_slant_to_ground_range(0.0, 0.0);
    if a != b {
        println("FAIL sidescan_slant_to_ground_range");
        process_exit(1);
    }
    println("prod_sidescan_sonar_bathymetry: PASSED");
}
