// # Product prove std/bio/phylo_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts calculate_p_distance value or determinism.
//
// Setup: Isolated emit-c. Imports std/bio/phylo_stubs.oo.
//
// Beats:
//   1. Call calculate_p_distance twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_phylo_stubs: PASSED only if asserts hold.

import "std/bio/phylo_stubs.oo";

pub fn main() {
    let phylo_stubs_a: Float = calculate_p_distance("x", "x");
    let phylo_stubs_b: Float = calculate_p_distance("x", "x");
    if phylo_stubs_a != phylo_stubs_b {
        println("FAIL calculate_p_distance");
        process_exit(1);
    }
    println("prod_phylo_stubs: PASSED");
}
