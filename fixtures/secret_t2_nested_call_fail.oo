// # Refuse nested identity of a secret
//
// Logline: Pipe a secret through nested identity calls and print the result.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag api_key as secret.
//   2. Return the same string from id.
//   3. Print id(id(api_key)).
//
// SECRET: api_key
fn id(s: String) -> String { return s; }
pub fn main() {
    let api_key = "x";
    let y = id(id(api_key));
    println(y);
}
