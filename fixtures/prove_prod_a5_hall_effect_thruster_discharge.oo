// # Product prove std/space_propulsion/hall_effect_thruster_discharge.oo
//
// Logline: Fail-closed emit+gcc+run asserts hall_thruster_spec_default_5kw is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/hall_effect_thruster_discharge.oo.
//
// Beats:
//   1. Call hall_thruster_spec_default_5kw twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hall_effect_thruster_discharge: PASSED only if they match.

import "std/space_propulsion/hall_effect_thruster_discharge.oo";

pub fn main() {
    let hall_effect_thruster_discharge_mark: Int = 0;
    if hall_effect_thruster_discharge_mark != 0 {
        process_exit(1);
    }
    let a: HallThrusterSpec = hall_thruster_spec_default_5kw();
    let b: HallThrusterSpec = hall_thruster_spec_default_5kw();
    if (a).discharge_voltage_v != (b).discharge_voltage_v {
        println("FAIL hall_thruster_spec_default_5kw");
        process_exit(1);
    }
    println("prod_hall_effect_thruster_discharge: PASSED");
}
