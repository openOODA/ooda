// # Product prove std/auto_mpc_control/vehicle_frenet_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts vehicle_frenet_frame_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_frenet_frame.oo.
//
// Beats:
//   1. Call vehicle_frenet_frame_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vehicle_frenet_frame: PASSED only if they match.

import "std/auto_mpc_control/vehicle_frenet_frame.oo";

pub fn main() {
    let a = vehicle_frenet_frame_probe();
    let b = vehicle_frenet_frame_probe();
    if a != b {
        println("FAIL vehicle_frenet_frame_probe");
        process_exit(1);
    }
    println("prod_vehicle_frenet_frame: PASSED");
}
