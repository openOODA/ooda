// # Result[List[String]] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[List[String], String] Ok list get.
//
// Setup: Backend-C. Ok payload is List[String], not a string.
//
// Beats:
//   1. xs returns Ok of a one-string list.
//   2. Match binds the list and list_get is "hi".
//   3. Exit 1 before PASSED on a miss.

fn xs() -> Result[List[String], String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "hi");
    return Ok(a);
}

pub fn main() {
    let r: Result[List[String], String] = xs();
    let mut empty: List[String] = list_new();
    let xs: List[String] = match r {
        Ok(v) => v,
        Err(e) => empty
    };
    if list_get(xs, 0) != "hi" {
        println("FAIL");
        process_exit(1);
    }
    println("result_lstr_smoke: PASSED");
}
