// # Product prove std/sec/sys/aslr_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_addr_in_range is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_ops.oo.
//
// Beats:
//   1. Call aslr_addr_in_range twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aslr_ops: PASSED only if they match.

import "std/sec/sys/aslr_ops.oo";

pub fn main() {
    let a = aslr_addr_in_range(0, 0, 0);
    let b = aslr_addr_in_range(0, 0, 0);
    if a != b {
        println("FAIL aslr_addr_in_range");
        process_exit(1);
    }
    println("prod_aslr_ops: PASSED");
}
