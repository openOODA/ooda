// # Product prove std/web_protocols/jsonrpc_response.oo
//
// Logline: Fail-closed emit+gcc+run asserts jsonrpc_response_success is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/jsonrpc_response.oo.
//
// Beats:
//   1. Call jsonrpc_response_success twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jsonrpc_response: PASSED only if they match.

import "std/web_protocols/jsonrpc_response.oo";

pub fn main() {
    let a: JsonRpcResponse = jsonrpc_response_success(0, 0);
    let b: JsonRpcResponse = jsonrpc_response_success(0, 0);
    if (a).jsonrpc_version != (b).jsonrpc_version {
        println("FAIL jsonrpc_response_success");
        process_exit(1);
    }
    println("prod_g2_jsonrpc_response: PASSED");
}
