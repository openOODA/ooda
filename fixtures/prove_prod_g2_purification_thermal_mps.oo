// # Product prove std/quantum_tensor_nets/purification_thermal_mps.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermal_purification_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/purification_thermal_mps.oo.
//
// Beats:
//   1. Call thermal_purification_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_purification_thermal_mps: PASSED only if they match.

import "std/quantum_tensor_nets/purification_thermal_mps.oo";

pub fn main() {
    let purification_thermal_mps_mark: Int = 0;
    if purification_thermal_mps_mark != 0 {
        process_exit(1);
    }
    let a: ThermalPurificationConfig = thermal_purification_config_default(0, 0.0);
    let b: ThermalPurificationConfig = thermal_purification_config_default(0, 0.0);
    if (a).num_sites != (b).num_sites {
        println("FAIL thermal_purification_config_default");
        process_exit(1);
    }
    println("prod_g2_purification_thermal_mps: PASSED");
}
