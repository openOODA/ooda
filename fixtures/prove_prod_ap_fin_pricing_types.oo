// # Product prove std/fin/pricing_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/pricing_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pricing_types: PASSED only if they match.

import "std/fin/pricing_types.oo";

pub fn main() {
    let pricing_types_a = option_contract_new(0, 0, 0);
    let pricing_types_b = option_contract_new(0, 0, 0);
    let pricing_types_va = option_contract_strike(pricing_types_a);
    let pricing_types_vb = option_contract_strike(pricing_types_b);
    if pricing_types_va != pricing_types_vb {
        println("FAIL pricing_types");
        process_exit(1);
    }
    println("prod_ap_pricing_types: PASSED");
}
