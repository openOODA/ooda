// # Product prove std/cloud_k8s/vector_clock_causality.oo
//
// Logline: Fail-closed verification that distributed vector clock causality tracking, ticks, merges, and ordering comparisons are deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/vector_clock_causality.oo.
//
// Beats:
//   1. Initialize vector clocks and perform local node ticks.
//   2. Evaluate equality, causal precedence, and concurrency relations.
//   3. Merge clocks via pairwise supremum and verify updated counters.
//   4. Print prod_g4_cloud_vector_clock: PASSED and exit 0.

import "std/cloud_k8s/vector_clock_causality.oo";

pub fn main() {
    let vector_clock_causality_mark: Int = 0;
    if vector_clock_causality_mark != 0 {
        process_exit(1);
    }
    let mut vc1: VectorClock = vector_clock_new();
    let mut vc2: VectorClock = vector_clock_new();

    vector_clock_tick(&mut vc1, "nodeA");
    vector_clock_tick(&mut vc2, "nodeA");

    let count1: Int = vector_clock_get(&vc1, "nodeA");
    let count2: Int = vector_clock_get(&vc2, "nodeA");
    if count1 != count2 || count1 != 1 {
        println("FAIL vector_clock_tick");
        process_exit(1);
    }

    let cmp_eq: Int = vector_clock_compare(&vc1, &vc2);
    if cmp_eq != 0 {
        println("FAIL vector_clock_compare equal");
        process_exit(1);
    }

    vector_clock_tick(&mut vc2, "nodeB");
    let cmp_prec: Int = vector_clock_compare(&vc1, &vc2);
    if cmp_prec != (0 - 1) {
        println("FAIL vector_clock_compare precedes");
        process_exit(1);
    }

    vector_clock_tick(&mut vc1, "nodeC");
    let cmp_conc: Int = vector_clock_compare(&vc1, &vc2);
    if cmp_conc != 2 {
        println("FAIL vector_clock_compare concurrent");
        process_exit(1);
    }

    vector_clock_merge(&mut vc1, &vc2);
    let cmp_after: Int = vector_clock_compare(&vc2, &vc1);
    if cmp_after != (0 - 1) {
        println("FAIL vector_clock_merge comparison");
        process_exit(1);
    }

    let a_cnt: Int = vector_clock_get(&vc1, "nodeA");
    let b_cnt: Int = vector_clock_get(&vc1, "nodeB");
    let c_cnt: Int = vector_clock_get(&vc1, "nodeC");
    if a_cnt != 1 || b_cnt != 1 || c_cnt != 1 {
        println("FAIL vector_clock_merge counts");
        process_exit(1);
    }

    println("prod_g4_cloud_vector_clock: PASSED");
    process_exit(0);
}
