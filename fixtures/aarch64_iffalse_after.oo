// # Const if false then later print
//
// Logline: Print OK after a const-false if and do not emit BAD.
//
// Setup: Side emit-aarch64 skips the false then and harvests the next println.
//
// Beats:
//   1. if false print BAD.
//   2. Then print OK.
//   3. Expect OK only.

pub fn main() {
    if false {
        println("BAD");
    }
    println("OK");
}
