// # Product prove std/quantum_topological/topological_walker_wang_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts walker_wang_semion_3d is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_walker_wang_3d.oo.
//
// Beats:
//   1. Call walker_wang_semion_3d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_walker_wang_3d: PASSED only if they match.

import "std/quantum_topological/topological_walker_wang_3d.oo";

pub fn main() {
    let topological_walker_wang_3d_mark: Int = 0;
    if topological_walker_wang_3d_mark != 0 {
        process_exit(1);
    }
    let topological_walker_wang_3d_a = walker_wang_semion_3d();
    let topological_walker_wang_3d_b = walker_wang_semion_3d();
    if (topological_walker_wang_3d_a).num_bulk_cells != (topological_walker_wang_3d_b).num_bulk_cells {
        println("FAIL walker_wang_semion_3d");
        process_exit(1);
    }
    println("prod_topological_walker_wang_3d: PASSED");
}
