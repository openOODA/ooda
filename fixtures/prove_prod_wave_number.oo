// # Product prove std/robotics_auv/wave_radiation_diffraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts wave_number_deep_water is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/wave_radiation_diffraction.oo.
//
// Beats:
//   1. Call wave_number_deep_water twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wave_number: PASSED only if they match.

import "std/robotics_auv/wave_radiation_diffraction.oo";

pub fn main() {
    let wave_radiation_diffraction_mark: Int = 0;
    if wave_radiation_diffraction_mark != 0 { process_exit(1); }
    let a: Float = wave_number_deep_water(0.8);
    let b: Float = wave_number_deep_water(0.8);
    if a != b {
        println("FAIL wave_number_deep_water");
        process_exit(1);
    }
    println("prod_wave_number: PASSED");
}
