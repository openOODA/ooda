// # Product prove std/tui/widget_treeview.oo
//
// Logline: Fail-closed emit+gcc+run asserts tree_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/widget_treeview.oo.
//
// Beats:
//   1. Call tree_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_widget_treeview: PASSED only if they match.

import "std/tui/widget_treeview.oo";

pub fn main() {
    let widget_treeview_mark: Int = 0;
    if widget_treeview_mark != 0 {
        process_exit(1);
    }
    let a: TreeNode = tree_node_new(0, 0, "x", true, 0);
    let b: TreeNode = tree_node_new(0, 0, "x", true, 0);
    if (a).id != (b).id {
        println("FAIL tree_node_new");
        process_exit(1);
    }
    println("prod_g2_widget_treeview: PASSED");
}
