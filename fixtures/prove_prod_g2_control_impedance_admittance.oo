// # Product prove std/robotics_ros2/control_impedance_admittance.oo
//
// Logline: Fail-closed emit+gcc+run asserts impedance_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/control_impedance_admittance.oo.
//
// Beats:
//   1. Call impedance_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_control_impedance_admittance: PASSED only if they match.

import "std/robotics_ros2/control_impedance_admittance.oo";

pub fn main() {
    let control_impedance_admittance_mark: Int = 0;
    if control_impedance_admittance_mark != 0 {
        process_exit(1);
    }
    let a: ImpedanceParameters2D = impedance_params_new(0.0, 0.0, 0.0);
    let b: ImpedanceParameters2D = impedance_params_new(0.0, 0.0, 0.0);
    if (a).mass_d != (b).mass_d {
        println("FAIL impedance_params_new");
        process_exit(1);
    }
    println("prod_g2_control_impedance_admittance: PASSED");
}
