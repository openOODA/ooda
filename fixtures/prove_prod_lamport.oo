// # Product cloud_k8s lamport clock prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/lamport_timestamp.oo.
//
// Setup: Product std/cloud_k8s/lamport_timestamp.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new time 0. tick 1. witness remote 5 -> 6. compare.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/lamport_timestamp.oo";

pub fn main() {
    let c0: LamportClock = lamport_clock_new(1);
    let t0: Int = lamport_clock_time(c0);
    if t0 != 0 {
        println("FAIL lamp 0");
        process_exit(1);
    }
    let c1: LamportClock = lamport_clock_tick(c0);
    let t1: Int = lamport_clock_time(c1);
    if t1 != 1 {
        println("FAIL lamp tick");
        process_exit(1);
    }
    let c2: LamportClock = lamport_clock_witness(c1, 5);
    let t2: Int = lamport_clock_time(c2);
    if t2 != 6 {
        println("FAIL lamp witness");
        process_exit(1);
    }
    let cmp: Int = lamport_event_compare(1, 0, 2, 0);
    if cmp != -1 {
        println("FAIL lamp cmp");
        process_exit(1);
    }
    println("prod_lamport: PASSED");
}
