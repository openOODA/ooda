// # Nested const if must not emit the outer dead else
//
// Logline: Print INNER from nested if true and omit OUTER_ELSE.
//
// Setup: Side emit-aarch64 stacks skip_else per live const-if.
//
// Beats:
//   1. Outer if true wraps an inner if true.
//   2. Inner prints INNER.
//   3. Outer else prints OUTER_ELSE and must not emit.

pub fn main() {
    if true {
        if true {
            println("INNER");
        } else {
        }
    } else {
        println("OUTER_ELSE");
    }
}
