// # list_set Float emit lock
//
// Logline: Fail-closed emit+gcc+run of list_set on List[Float] index 0 to 2.5.
//
// Setup: Backend-C. list_set returns the updated List[Float].
//
// Beats:
//   1. Push 1.0 onto an empty list.
//   2. list_set index 0 to 2.5; get is 2.5.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let mut xs: List[Float] = list_new();
    xs = list_push(xs, 1.0);
    xs = list_set(xs, 0, 2.5);
    if list_get(xs, 0) != 2.5 {
        println("FAIL");
        process_exit(1);
    }
    println("list_set_float_smoke: PASSED");
}
