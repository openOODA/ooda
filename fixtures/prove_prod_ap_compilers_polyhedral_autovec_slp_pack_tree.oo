// # Product prove std/compilers_polyhedral/autovec_slp_pack_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/autovec_slp_pack_tree.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_slp_pack_tree.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_autovec_slp_pack_tree: PASSED only if they match.

import "std/compilers_polyhedral/autovec_slp_pack_tree.oo";

pub fn main() {
    let autovec_slp_pack_tree_a = slp_vector_pack_new(0, 0, 0);
    let autovec_slp_pack_tree_b = slp_vector_pack_new(0, 0, 0);
    let autovec_slp_pack_tree_va = slp_compute_pack_profitability(autovec_slp_pack_tree_a);
    let autovec_slp_pack_tree_vb = slp_compute_pack_profitability(autovec_slp_pack_tree_b);
    if autovec_slp_pack_tree_va != autovec_slp_pack_tree_vb {
        println("FAIL autovec_slp_pack_tree");
        process_exit(1);
    }
    println("prod_ap_autovec_slp_pack_tree: PASSED");
}
