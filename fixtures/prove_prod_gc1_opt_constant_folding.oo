// # Product prove std/compilers_vm/opt_constant_folding.oo
//
// Logline: Fail-closed emit+gcc+run asserts lattice_const is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_constant_folding.oo.
//
// Beats:
//   1. Call lattice_const twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opt_constant_folding: PASSED only if they match.

import "std/compilers_vm/opt_constant_folding.oo";

pub fn main() {
    let opt_constant_folding_mark: Int = 0;
    if opt_constant_folding_mark != 0 {
        process_exit(1);
    }
    let opt_constant_folding_a = lattice_const(1);
    let opt_constant_folding_b = lattice_const(1);
    if (opt_constant_folding_a).tag != (opt_constant_folding_b).tag {
        println("FAIL lattice_const");
        process_exit(1);
    }
    println("prod_opt_constant_folding: PASSED");
}
