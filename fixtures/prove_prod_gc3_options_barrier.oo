// # Product prove std/fintech_defi/options_barrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts barrier_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/options_barrier.oo.
//
// Beats:
//   1. Call barrier_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_barrier: PASSED only if they match.

import "std/fintech_defi/options_barrier.oo";

pub fn main() {
    let options_barrier_mark: Int = 0;
    if options_barrier_mark != 0 {
        process_exit(1);
    }
    let options_barrier_a: Float = barrier_norm_pdf(1.0);
    let options_barrier_b: Float = barrier_norm_pdf(1.0);
    if options_barrier_a != options_barrier_b {
        println("FAIL barrier_norm_pdf");
        process_exit(1);
    }
    println("prod_options_barrier: PASSED");
}
