// # Product prove std/quantum_topological/toric_code_boundary_conditions.oo
//
// Logline: Fail-closed emit+gcc+run asserts planar_patch_can_condense is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_boundary_conditions.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call planar_patch_can_condense twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_toric_code_boundary_conditions: PASSED only if they match.

import "std/quantum_topological/toric_code_boundary_conditions.oo";

pub fn main() {
    let g2_oa: BoundaryType = boundary_smooth();
    let g2_ob: BoundaryType = boundary_smooth();
    let g2_a = planar_patch_can_condense(&g2_oa, 2);
    let g2_b = planar_patch_can_condense(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL planar_patch_can_condense");
        process_exit(1);
    }
    println("prod_g2_toric_code_boundary_conditions: PASSED");
}
