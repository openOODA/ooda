// # Product prove std/zk_rollup/stark_air_constraint.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/stark_air_constraint.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_air_constraint.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_stark_air_constraint: PASSED only if they match.

import "std/zk_rollup/stark_air_constraint.oo";

pub fn main() {
    let stark_air_constraint_a = air_boundary_constraint_new(0, 0, 0);
    let stark_air_constraint_b = air_boundary_constraint_new(0, 0, 0);
    if stark_air_constraint_a.column_index != stark_air_constraint_b.column_index {
        println("FAIL stark_air_constraint");
        process_exit(1);
    }
    println("prod_ap_stark_air_constraint: PASSED");
}
