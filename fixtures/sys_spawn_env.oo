// # sys_spawn child env filter
//
// Logline: Spawn a shell that reports whether HOME leaked and whether PATH remains.
//
// Setup: Backend-C emit fixture. Runtime must filter child env like sys_exec.
//
// Beats:
//   1. Child has no HOME (parent HOME must not leak).
//   2. Child has PATH (reset allowlist).
//   3. Print filtered then path-ok.

pub fn main(sys: &SysCap) {
    match sys_spawn(sys, "sh -c 'if printenv HOME >/dev/null 2>&1; then echo LEAK; else echo FILTERED; fi'") {
        Ok(s) => {
            match sys_wait(sys, -1) {
                Ok(st) => println("wait1"),
                Err(e) => println(e),
            }
        }
        Err(e) => println(e),
    }
    match sys_spawn(sys, "sh -c 'if printenv PATH >/dev/null 2>&1; then echo PATHOK; else echo NOPATH; fi'") {
        Ok(s) => {
            match sys_wait(sys, -1) {
                Ok(st) => println("wait2"),
                Err(e) => println(e),
            }
        }
        Err(e) => println(e),
    }
}
