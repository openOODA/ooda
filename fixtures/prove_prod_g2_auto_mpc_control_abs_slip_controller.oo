// # Product prove std/auto_mpc_control/abs_slip_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts abs_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/abs_slip_controller.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call abs_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abs_slip_controller: PASSED only if they match.

import "std/auto_mpc_control/abs_slip_controller.oo";

pub fn main() {
    let g2_oa: ABSConfig = abs_config_default();
    let g2_ob: ABSConfig = abs_config_default();
    let g2_a = (g2_oa).slip_threshold;
    let g2_b = (g2_ob).slip_threshold;
    if g2_a != g2_b {
        println("FAIL abs_config_default.slip_threshold");
        process_exit(1);
    }
    println("prod_g2_abs_slip_controller: PASSED");
}
