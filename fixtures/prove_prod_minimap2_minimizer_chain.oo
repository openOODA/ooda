// # Product prove std/genomics_advanced/minimap2_minimizer_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts minimap_evaluate_chain real value.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/minimap2_minimizer_chain.oo.
//
// Beats:
//   1. Call minimap_evaluate_chain with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_minimap2_minimizer_chain: PASSED only if the assert holds.

import "std/genomics_advanced/minimap2_minimizer_chain.oo";

pub fn main() {
    let minimap2_minimizer_chain_mark: Int = 0;
    if minimap2_minimizer_chain_mark != 0 {
        process_exit(1);
    }
    let minimap2_minimizer_chain_a1: MinimizerAnchor = MinimizerAnchor { q_pos: 0, r_pos: 0, kmer_len: 0 };
    let minimap2_minimizer_chain_a2: MinimizerAnchor = MinimizerAnchor { q_pos: 0, r_pos: 0, kmer_len: 0 };
    let minimap2_minimizer_chain_a = minimap_evaluate_chain(&minimap2_minimizer_chain_a1, &minimap2_minimizer_chain_a2, 7, 7, 7);
    let minimap2_minimizer_chain_anchor_count: Int = (minimap2_minimizer_chain_a).anchor_count;
    if minimap2_minimizer_chain_anchor_count != 2 {
        println("FAIL minimap_evaluate_chain");
        process_exit(1);
    }
    println("prod_minimap2_minimizer_chain: PASSED");
}
