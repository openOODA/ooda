// # Product prove std/web_ecosystem/date_fns_timezone.oo
//
// Logline: Fail-closed emit+gcc+run asserts timezone_abs_minutes is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/date_fns_timezone.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call timezone_abs_minutes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_date_fns_timezone: PASSED only if they match.

import "std/web_ecosystem/date_fns_timezone.oo";

pub fn main() {
    let g2_a = timezone_abs_minutes(2);
    let g2_b = timezone_abs_minutes(2);
    if g2_a != g2_b {
        println("FAIL timezone_abs_minutes");
        process_exit(1);
    }
    println("prod_g2_date_fns_timezone: PASSED");
}
