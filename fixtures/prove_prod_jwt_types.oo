// # Product prove std/sec/net/jwt_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_types_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_types.oo.
//
// Beats:
//   1. Call jwt_types_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jwt_types: PASSED only if they match.

import "std/sec/net/jwt_types.oo";

pub fn main() {
    let a = jwt_types_marker();
    let b = jwt_types_marker();
    if a != b {
        println("FAIL jwt_types_marker");
        process_exit(1);
    }
    println("prod_jwt_types: PASSED");
}
