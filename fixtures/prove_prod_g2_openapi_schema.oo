// # Product prove std/web_protocols/openapi_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts openapi_info_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/openapi_schema.oo.
//
// Beats:
//   1. Call openapi_info_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_openapi_schema: PASSED only if they match.

import "std/web_protocols/openapi_schema.oo";

pub fn main() {
    let openapi_schema_mark: Int = 0;
    if openapi_schema_mark != 0 {
        process_exit(1);
    }
    let a: OpenApiInfo = openapi_info_new(0, 0, 0);
    let b: OpenApiInfo = openapi_info_new(0, 0, 0);
    if (a).title != (b).title {
        println("FAIL openapi_info_new");
        process_exit(1);
    }
    println("prod_g2_openapi_schema: PASSED");
}
