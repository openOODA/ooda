// # Product rational prove
//
// Logline: Fail-closed emit+gcc+run of shipped rational_new / rational_add.
//
// Setup: Product std/math/rational_big.oo. 2/4 simplifies; 1/2+1/2=1.
//
// Beats:
//   1. rational_new(2,4) is 1/2.
//   2. 1/2+1/2 is 1/1.
//   3. Exit 1 before PASSED on a miss.

import "std/math/rational_big.oo";

pub fn main() {
    let h: Rational = rational_new(2, 4);
    let hn: Int = h.num;
    let hd: Int = h.den;
    if hn != 1 {
        println("FAIL rat num");
        process_exit(1);
    }
    if hd != 2 {
        println("FAIL rat den");
        process_exit(1);
    }
    let one: Rational = rational_add(h, h);
    let on: Int = one.num;
    let od: Int = one.den;
    if on != 1 {
        println("FAIL add num");
        process_exit(1);
    }
    if od != 1 {
        println("FAIL add den");
        process_exit(1);
    }
    println("prod_rational: PASSED");
}
