// # Product prove std/robot/ros_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts qos_profile_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/ros_types.oo.
//
// Beats:
//   1. Call qos_profile_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros_types: PASSED only if they match.

import "std/robot/ros_types.oo";

pub fn main() {
    let ros_types_mark: Int = 0;
    if ros_types_mark != 0 {
        process_exit(1);
    }
    let a: QosProfile = qos_profile_new(0, 0);
    let b: QosProfile = qos_profile_new(0, 0);
    if (a).depth != (b).depth {
        println("FAIL qos_profile_new");
        process_exit(1);
    }
    println("prod_ros_types: PASSED");
}
