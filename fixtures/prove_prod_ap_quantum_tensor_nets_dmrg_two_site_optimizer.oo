// # Product prove std/quantum_tensor_nets/dmrg_two_site_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_tensor_nets/dmrg_two_site_optimizer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/dmrg_two_site_optimizer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_dmrg_two_site_optimizer: PASSED only if they match.

import "std/quantum_tensor_nets/dmrg_two_site_optimizer.oo";

pub fn main() {
    let dmrg_two_site_optimizer_a = dmrg_two_site_config_default(0);
    let dmrg_two_site_optimizer_b = dmrg_two_site_config_default(0);
    if dmrg_two_site_optimizer_a.num_sites != dmrg_two_site_optimizer_b.num_sites {
        println("FAIL dmrg_two_site_optimizer");
        process_exit(1);
    }
    println("prod_ap_dmrg_two_site_optimizer: PASSED");
}
