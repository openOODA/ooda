// # Product prove std/wasm_gc/wasm_gc_heap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_gc_heap_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_heap_types.oo.
//
// Beats:
//   1. Call wasm_gc_heap_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_gc_heap_types: PASSED only if they match.

import "std/wasm_gc/wasm_gc_heap_types.oo";

pub fn main() {
    let wasm_gc_heap_types_mark: Int = 0;
    if wasm_gc_heap_types_mark != 0 {
        process_exit(1);
    }
    let a: WasmGcHeap = wasm_gc_heap_new(0, 0);
    let b: WasmGcHeap = wasm_gc_heap_new(0, 0);
    if (a).kind != (b).kind {
        println("FAIL wasm_gc_heap_new");
        process_exit(1);
    }
    println("prod_g2_wasm_gc_heap_types: PASSED");
}
