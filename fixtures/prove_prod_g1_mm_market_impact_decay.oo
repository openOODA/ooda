// # Product prove std/hft_alpha/mm_market_impact_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts propagator_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_market_impact_decay.oo.
//
// Beats:
//   1. Call propagator_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_market_impact_decay: PASSED only if they match.

import "std/hft_alpha/mm_market_impact_decay.oo";

pub fn main() {
    let a: PropagatorParams = propagator_params_default();
    let b: PropagatorParams = propagator_params_default();
    if a.decay_gamma != b.decay_gamma {
        println("FAIL propagator_params_default");
        process_exit(1);
    }
    println("prod_mm_market_impact_decay: PASSED");
}
