// # Product prove std/lidar_perception/lidar_perception_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/lidar_perception/lidar_perception_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/lidar_perception_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lidar_perception_stubs: PASSED only if they match.

import "std/lidar_perception/lidar_perception_stubs.oo";

pub fn main() {
    let lidar_perception_stubs_a = lidar_hal_packet_read_stub(0, true);
    let lidar_perception_stubs_b = lidar_hal_packet_read_stub(0, true);
    if lidar_perception_stubs_a != lidar_perception_stubs_b {
        println("FAIL lidar_perception_stubs");
        process_exit(1);
    }
    println("prod_ap_lidar_perception_stubs: PASSED");
}
