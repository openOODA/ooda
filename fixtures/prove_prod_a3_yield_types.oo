// # Product prove std/fin/yield_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts discount_factor_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_types.oo.
//
// Beats:
//   1. Call discount_factor_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_types: PASSED only if they match.

import "std/fin/yield_types.oo";

pub fn main() {
    let yield_types_mark: Int = 0;
    if yield_types_mark != 0 {
        process_exit(1);
    }
    let a: DiscountFactor = discount_factor_new(0, 0);
    let b: DiscountFactor = discount_factor_new(0, 0);
    if (a).tenor_months != (b).tenor_months {
        println("FAIL discount_factor_new");
        process_exit(1);
    }
    println("prod_yield_types: PASSED");
}
