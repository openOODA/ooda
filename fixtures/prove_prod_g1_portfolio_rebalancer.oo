// # Product prove std/fintech_defi/portfolio_rebalancer.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/portfolio_rebalancer.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_portfolio_rebalancer: PASSED only if they match.

import "std/fintech_defi/portfolio_rebalancer.oo";

pub fn main() {
    let a: Float = int_to_float(0);
    let b: Float = int_to_float(0);
    if a != b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_portfolio_rebalancer: PASSED");
}
