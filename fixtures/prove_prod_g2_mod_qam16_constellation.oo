// # Product prove std/telecom_5g/mod_qam16_constellation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mod_qam16_pam4_map is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_qam16_constellation.oo.
//
// Beats:
//   1. Call mod_qam16_pam4_map twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mod_qam16_constellation: PASSED only if they match.

import "std/telecom_5g/mod_qam16_constellation.oo";

pub fn main() {
    let mod_qam16_constellation_mark: Int = 0;
    if mod_qam16_constellation_mark != 0 {
        process_exit(1);
    }
    let a: Float = mod_qam16_pam4_map(0);
    let b: Float = mod_qam16_pam4_map(0);
    if a != b {
        println("FAIL mod_qam16_pam4_map");
        process_exit(1);
    }
    println("prod_g2_mod_qam16_constellation: PASSED");
}
