// # Product prove std/synthetic_biology/hill_kinetics_transcription.oo
//
// Logline: Fail-closed emit+gcc+run asserts hill_math_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/hill_kinetics_transcription.oo.
//
// Beats:
//   1. Call hill_math_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hill_kinetics_transcription: PASSED only if they match.

import "std/synthetic_biology/hill_kinetics_transcription.oo";

pub fn main() {
    let hill_kinetics_transcription_mark: Int = 0;
    if hill_kinetics_transcription_mark != 0 {
        process_exit(1);
    }
    let hill_kinetics_transcription_a: Float = hill_math_pow(1.0, 1);
    let hill_kinetics_transcription_b: Float = hill_math_pow(1.0, 1);
    if hill_kinetics_transcription_a != hill_kinetics_transcription_b {
        println("FAIL hill_math_pow");
        process_exit(1);
    }
    println("prod_hill_kinetics_transcription: PASSED");
}
