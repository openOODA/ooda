// # Product prove std/scicomp/ode_runge_kutta_45.oo
//
// Logline: Fail-closed verification that adaptive Runge-Kutta 4(5) stage combination and configuration defaults are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/ode_runge_kutta_45.oo.
//
// Beats:
//   1. Construct default OdeRk45Config and assert tolerance and step bounds.
//   2. Combine 6 Runge-Kutta stages for a unit derivative vector field.
//   3. Assert step acceptance, next state vector, and recommended step size.
//   4. Print prod_g4_scicomp_rk45: PASSED and exit 0.

import "std/scicomp/ode_runge_kutta_45.oo";

pub fn main() {
    let cfg1: OdeRk45Config = ode_rk45_config_default();
    let cfg2: OdeRk45Config = ode_rk45_config_default();
    if (cfg1).tolerance != (cfg2).tolerance || (cfg1).tolerance != 0.000001 || (cfg1).safety_factor != 0.9 {
        println("FAIL ode_rk45_config_default");
        process_exit(1);
    }

    let mut y0: List[Float] = list_new();
    y0 = list_push(y0, 0.0);

    let mut k: List[Float] = list_new();
    k = list_push(k, 1.0);

    let step1: OdeRk45Step = rk45_combine_stages(&y0, 0.1, &k, &k, &k, &k, &k, &k);
    let step2: OdeRk45Step = rk45_combine_stages(&y0, 0.1, &k, &k, &k, &k, &k, &k);

    if (step1).step_accepted != true || (step2).step_accepted != true {
        println("FAIL rk45_combine_stages step_accepted");
        process_exit(1);
    }

    if (step1).t_next != (step2).t_next || (step1).t_next < 0.099 || (step1).t_next > 0.101 {
        println("FAIL rk45_combine_stages t_next");
        process_exit(1);
    }

    let y_next_val: Float = list_get((step1).y_next, 0);
    if y_next_val < 0.099 || y_next_val > 0.101 {
        println("FAIL rk45_combine_stages y_next");
        process_exit(1);
    }

    println("prod_g4_scicomp_rk45: PASSED");
    process_exit(0);
}
