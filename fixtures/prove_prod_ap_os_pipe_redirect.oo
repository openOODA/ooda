// # Product prove std/os/pipe_redirect.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/pipe_redirect.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/os/pipe_redirect.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pipe_redirect: PASSED only if they match.

import "std/os/pipe_redirect.oo";

pub fn main() {
    let pipe_redirect_a = redirect_config_default();
    let pipe_redirect_b = redirect_config_default();
    if pipe_redirect_a.stdin_mode != pipe_redirect_b.stdin_mode {
        println("FAIL pipe_redirect");
        process_exit(1);
    }
    println("prod_ap_pipe_redirect: PASSED");
}
