// # Product prove std/simd/simd_clamp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_clamp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_clamp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_clamp: PASSED only if they match.

import "std/simd/simd_clamp.oo";

pub fn main() {
    let simd_clamp_a = simd_clamp_f32(0.0, 0.0, 0.0);
    let simd_clamp_b = simd_clamp_f32(0.0, 0.0, 0.0);
    if simd_clamp_a != simd_clamp_b {
        println("FAIL simd_clamp");
        process_exit(1);
    }
    println("prod_ap_simd_clamp: PASSED");
}
