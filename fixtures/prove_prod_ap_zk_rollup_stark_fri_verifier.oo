// # Product prove std/zk_rollup/stark_fri_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/stark_fri_verifier.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_fri_verifier.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_stark_fri_verifier: PASSED only if they match.

import "std/zk_rollup/stark_fri_verifier.oo";

pub fn main() {
    let stark_fri_verifier_a = stark_proof_envelope_new("x", "x", list_new(), 0);
    let stark_fri_verifier_b = stark_proof_envelope_new("x", "x", list_new(), 0);
    if stark_fri_verifier_a.trace_root != stark_fri_verifier_b.trace_root {
        println("FAIL stark_fri_verifier");
        process_exit(1);
    }
    println("prod_ap_stark_fri_verifier: PASSED");
}
