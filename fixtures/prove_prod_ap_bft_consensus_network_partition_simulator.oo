// # Product prove std/bft_consensus/network_partition_simulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/network_partition_simulator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/network_partition_simulator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_network_partition_simulator: PASSED only if they match.

import "std/bft_consensus/network_partition_simulator.oo";

pub fn main() {
    let network_partition_simulator_a = partition_can_communicate(0, 0, true);
    let network_partition_simulator_b = partition_can_communicate(0, 0, true);
    if network_partition_simulator_a != network_partition_simulator_b {
        println("FAIL network_partition_simulator");
        process_exit(1);
    }
    println("prod_ap_network_partition_simulator: PASSED");
}
