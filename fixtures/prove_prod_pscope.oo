// # Product sec path scope prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/path_scope.oo.
//
// Setup: Product std/sec/path_scope.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. prefix match true. empty prefix false. dotdot false.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/path_scope.oo";

pub fn main() {
    if path_scope_allows("/tmp", "/tmp") == false {
        println("FAIL pscope eq");
        process_exit(1);
    }
    if path_scope_allows("", "x") {
        println("FAIL pscope empty");
        process_exit(1);
    }
    if path_scope_allows("/tmp", "..") {
        println("FAIL pscope trav");
        process_exit(1);
    }
    println("prod_pscope: PASSED");
}
