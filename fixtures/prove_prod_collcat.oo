// # Product collections catalog prove
//
// Logline: Fail-closed emit+gcc+run of shipped collections_count/is_available.
//
// Setup: Product std/collections/collections.oo. Catalog count 24.
//
// Beats:
//   1. collections_count is 24; stack is available; no_such is not.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/collections.oo";

pub fn main() {
    let n: Int = collections_count();
    if n != 24 {
        println("FAIL collcat count");
        process_exit(1);
    }
    let ok: Bool = collections_is_available("stack");
    if ok == false {
        println("FAIL collcat stack");
        process_exit(1);
    }
    let no: Bool = collections_is_available("no_such");
    if no == true {
        println("FAIL collcat nosuch");
        process_exit(1);
    }
    println("prod_collcat: PASSED");
}
