// # Product prove std/auto_mpc_control/tire_slip_angle_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_wheel_slip_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_slip_angle_calculator.oo.
//
// Beats:
//   1. Call compute_wheel_slip_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tire_slip_angle_calculator: PASSED only if they match.

import "std/auto_mpc_control/tire_slip_angle_calculator.oo";

pub fn main() {
    let tire_slip_angle_calculator_mark: Int = 0;
    if tire_slip_angle_calculator_mark != 0 {
        process_exit(1);
    }
    let a: Float = compute_wheel_slip_ratio(1.0, 1.0, 1.0);
    let b: Float = compute_wheel_slip_ratio(1.0, 1.0, 1.0);
    if a != b {
        println("FAIL compute_wheel_slip_ratio");
        process_exit(1);
    }
    println("prod_tire_slip_angle_calculator: PASSED");
}
