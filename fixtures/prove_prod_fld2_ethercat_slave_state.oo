// # Product prove std/iot_scada/ethercat_slave_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_state_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_slave_state.oo.
//
// Beats:
//   1. Call ethercat_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ethercat_slave_state: PASSED only if they match.

import "std/iot_scada/ethercat_slave_state.oo";

pub fn main() {
    let ethercat_slave_state_mark: Int = 0;
    if ethercat_slave_state_mark != 0 {
        process_exit(1);
    }
    let ethercat_slave_state_a: Int = ethercat_state_init();
    let ethercat_slave_state_b: Int = ethercat_state_init();
    if ethercat_slave_state_a != ethercat_slave_state_b {
        println("FAIL ethercat_state_init");
        process_exit(1);
    }
    println("prod_ethercat_slave_state: PASSED");
}
