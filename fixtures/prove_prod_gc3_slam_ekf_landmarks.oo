// # Product prove std/robotics_ros2/slam_ekf_landmarks.oo
//
// Logline: Fail-closed emit+gcc+run asserts ekf_landmark_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_ekf_landmarks.oo.
//
// Beats:
//   1. Call ekf_landmark_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_ekf_landmarks: PASSED only if they match.

import "std/robotics_ros2/slam_ekf_landmarks.oo";

pub fn main() {
    let slam_ekf_landmarks_mark: Int = 0;
    if slam_ekf_landmarks_mark != 0 {
        process_exit(1);
    }
    let slam_ekf_landmarks_a = ekf_landmark_new(1, 1.0, 1.0);
    let slam_ekf_landmarks_b = ekf_landmark_new(1, 1.0, 1.0);
    if (slam_ekf_landmarks_a).id != (slam_ekf_landmarks_b).id {
        println("FAIL ekf_landmark_new");
        process_exit(1);
    }
    println("prod_slam_ekf_landmarks: PASSED");
}
