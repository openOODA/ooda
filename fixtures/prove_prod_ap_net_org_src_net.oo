// # Product prove std/net/org_src_net.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net/org_src_net.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/org_src_net.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_org_src_net: PASSED only if they match.

import "std/net/org_src_net.oo";

pub fn main() {
    let org_src_net_a = rx001_k();
    let org_src_net_b = rx001_k();
    if org_src_net_a != org_src_net_b {
        println("FAIL org_src_net");
        process_exit(1);
    }
    println("prod_ap_org_src_net: PASSED");
}
