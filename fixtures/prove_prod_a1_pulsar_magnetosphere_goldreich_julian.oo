// # Product prove std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo
//
// Logline: Fail-closed emit+gcc+run asserts pulsar_parameters_compute is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo.
//
// Beats:
//   1. Call pulsar_parameters_compute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pulsar_magnetosphere_goldreich_julian: PASSED only if they match.

import "std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo";

pub fn main() {
    let pulsar_magnetosphere_goldreich_julian_mark: Int = 0;
    if pulsar_magnetosphere_goldreich_julian_mark != 0 {
        process_exit(1);
    }
    let a: PulsarParameters = pulsar_parameters_compute(0, 0, 0, 0);
    let b: PulsarParameters = pulsar_parameters_compute(0, 0, 0, 0);
    if (a).period_s != (b).period_s {
        println("FAIL pulsar_parameters_compute");
        process_exit(1);
    }
    println("prod_pulsar_magnetosphere_goldreich_julian: PASSED");
}
