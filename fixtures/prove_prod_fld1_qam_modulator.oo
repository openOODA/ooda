// # Product prove std/telecom/qam_modulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts qam_pam4_map is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/qam_modulator.oo.
//
// Beats:
//   1. Call qam_pam4_map twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qam_modulator: PASSED only if they match.

import "std/telecom/qam_modulator.oo";

pub fn main() {
    let qam_modulator_mark: Int = 0;
    if qam_modulator_mark != 0 {
        process_exit(1);
    }
    let qam_modulator_a: Float = qam_pam4_map(1);
    let qam_modulator_b: Float = qam_pam4_map(1);
    if qam_modulator_a != qam_modulator_b {
        println("FAIL qam_pam4_map");
        process_exit(1);
    }
    println("prod_qam_modulator: PASSED");
}
