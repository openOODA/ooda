// # Product prove std/robot/locomotion_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_drive_inverse_left is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/locomotion_ops.oo.
//
// Beats:
//   1. Call diff_drive_inverse_left twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_locomotion_ops: PASSED only if they match.

import "std/robot/locomotion_ops.oo";

pub fn main() {
    let locomotion_ops_mark: Int = 0;
    if locomotion_ops_mark != 0 {
        process_exit(1);
    }
    let locomotion_ops_a: Float = diff_drive_inverse_left(1.0, 1.0, 1.0, 1.0);
    let locomotion_ops_b: Float = diff_drive_inverse_left(1.0, 1.0, 1.0, 1.0);
    if locomotion_ops_a != locomotion_ops_b {
        println("FAIL diff_drive_inverse_left");
        process_exit(1);
    }
    println("prod_locomotion_ops: PASSED");
}
