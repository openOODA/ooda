// # Product prove std/diag/log.oo
//
// Logline: Fail-closed emit+gcc+run asserts log_level_trace is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/log.oo.
//
// Beats:
//   1. Call log_level_trace twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_log: PASSED only if they match.

import "std/diag/log.oo";

pub fn main() {
    let a = log_level_trace();
    let b = log_level_trace();
    if a != b {
        println("FAIL log_level_trace");
        process_exit(1);
    }
    println("prod_log: PASSED");
}
