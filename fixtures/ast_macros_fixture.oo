// # AST macros fixture
//
// Logline: Fixture testing AST quotes, expression building, macro template expansion, and transforms.
//
// Setup: Imports std/macro.oo for syntax and macro constructs.
//
// Beats:
//   1. Build AST nodes and binary expressions.
//   2. Quasi-quote template and unquote placeholders.
//   3. Execute macro expansion and print success code.

import "std/macro.oo";

pub fn run_ast_macros_fixture_checks() -> Int {
    let mut tree: AstTree = ast_tree_new();
    let id_a: Int = ast_ident(&mut tree, "x");
    let id_b: Int = ast_ident(&mut tree, "y");
    let bin_id: Int = ast_expr(&mut tree, "BINOP", "+", id_a, id_b);
    if bin_id <= 0 {
        return 1;
    }

    let q: AstQuote = ast_quote("let $VAR = $VAL + 10;");
    let q1: AstQuote = ast_unquote(&q, "$VAR", "result");
    let q2: AstQuote = ast_unquote(&q1, "$VAL", "32");
    if q2.raw_syntax != "let result = 32 + 10;" {
        return 2;
    }

    let mut env: MacroEnv = macro_env_new();
    let sym: String = macro_gensym(&mut env, "tmp");
    if chars_len(sym) == 0 {
        return 3;
    }

    let exp_id: Int = ast_expand(&mut env, &mut tree, bin_id);
    if exp_id <= 0 {
        return 4;
    }

    return 0;
}

pub fn main() {
    let res: Int = run_ast_macros_fixture_checks();
    println(res);
}
