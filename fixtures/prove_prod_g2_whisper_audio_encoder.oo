// # Product prove std/deep_ai/whisper_audio_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts whisper_audio_encoder_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/whisper_audio_encoder.oo.
//
// Beats:
//   1. Call whisper_audio_encoder_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_whisper_audio_encoder: PASSED only if they match.

import "std/deep_ai/whisper_audio_encoder.oo";

pub fn main() {
    let a: Int = whisper_audio_encoder_marker();
    let b: Int = whisper_audio_encoder_marker();
    if a != b {
        println("FAIL whisper_audio_encoder_marker");
        process_exit(1);
    }
    println("prod_g2_whisper_audio_encoder: PASSED");
}
