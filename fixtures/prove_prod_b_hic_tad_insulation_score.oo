// # Product prove std/genomics_advanced/hic_tad_insulation_score.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_tad_insulation_score_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_tad_insulation_score.oo.
//
// Beats:
//   1. Call hic_tad_insulation_score_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hic_tad_insulation_score: PASSED only if they match.

import "std/genomics_advanced/hic_tad_insulation_score.oo";

pub fn main() {
    let a = hic_tad_insulation_score_probe();
    let b = hic_tad_insulation_score_probe();
    if a != b {
        println("FAIL hic_tad_insulation_score_probe");
        process_exit(1);
    }
    println("prod_hic_tad_insulation_score: PASSED");
}
