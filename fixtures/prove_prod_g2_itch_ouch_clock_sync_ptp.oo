// # Product prove std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo
//
// Logline: Fail-closed emit+gcc+run asserts ptp_clock_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo.
//
// Beats:
//   1. Call ptp_clock_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_itch_ouch_clock_sync_ptp: PASSED only if they match.

import "std/fintech_l3_book/itch_ouch_clock_sync_ptp.oo";

pub fn main() {
    let itch_ouch_clock_sync_ptp_mark: Int = 0;
    if itch_ouch_clock_sync_ptp_mark != 0 {
        process_exit(1);
    }
    let a: PtpClockState = ptp_clock_state_new();
    let b: PtpClockState = ptp_clock_state_new();
    if (a).current_offset_ns != (b).current_offset_ns {
        println("FAIL ptp_clock_state_new");
        process_exit(1);
    }
    println("prod_g2_itch_ouch_clock_sync_ptp: PASSED");
}
