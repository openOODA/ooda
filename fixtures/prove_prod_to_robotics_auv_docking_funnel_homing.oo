// # Product prove std/robotics_auv/docking_funnel_homing.oo
//
// Logline: Fail-closed emit+gcc+run asserts docking_homing_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/docking_funnel_homing.oo.
//
// Beats:
//   1. Call docking_homing_init using the docking_funnel_homing ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_docking_funnel_homing: PASSED only if asserts hold.

import "std/robotics_auv/docking_funnel_homing.oo";

pub fn main() {
    let obj = docking_homing_init();
    let docking_funnel_homing_a = obj.distance_to_throat_m;
    if docking_funnel_homing_a != 10.0 {
        println("FAIL docking_homing_init");
        process_exit(1);
    }
    println("prod_docking_funnel_homing: PASSED");
}
