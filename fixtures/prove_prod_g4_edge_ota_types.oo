// # Product prove std/edge/ota_types.oo
//
// Logline: Fail-closed verification that OTA data types, constructors, and manifest validation are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/ota_types.oo.
//
// Beats:
//   1. Construct valid and empty OTA manifests and compute version codes.
//   2. Validate manifest validity predicates and slot mutation helpers.
//   3. Assert deterministic values.
//   4. Print prod_g4_edge_ota_types: PASSED and exit 0.

import "std/edge/ota_types.oo";

pub fn main() {
    let m1: OtaManifest = ota_manifest_new(3, 2, 1, 42, 2048, 55555, true, true);
    let m2: OtaManifest = ota_manifest_new(3, 2, 1, 42, 2048, 55555, true, true);
    if (m1).version_major != (m2).version_major || (m1).build_number != 42 {
        println("FAIL ota_manifest_new fields");
        process_exit(1);
    }
    if !(m1).is_delta || !(m1).signature_valid {
        println("FAIL ota_manifest_new flags");
        process_exit(1);
    }

    let code1: Int = ota_manifest_version_code(&m1);
    let code2: Int = ota_manifest_version_code(&m2);
    if code1 != code2 || code1 != 30201 {
        println("FAIL ota_manifest_version_code");
        process_exit(1);
    }

    let v1: Bool = ota_manifest_is_valid(&m1);
    let v2: Bool = ota_manifest_is_valid(&m2);
    if v1 != v2 || !v1 {
        println("FAIL ota_manifest_is_valid valid");
        process_exit(1);
    }

    let empty_m: OtaManifest = ota_manifest_empty();
    let empty_v: Bool = ota_manifest_is_valid(&empty_m);
    if empty_v != false {
        println("FAIL ota_manifest_empty invalid");
        process_exit(1);
    }

    let mut slot1: OtaPartitionSlot = ota_slot_new(0, false, true, 30201);
    let mut slot2: OtaPartitionSlot = ota_slot_new(0, false, true, 30201);
    ota_slot_set_active(&mut slot1, true);
    ota_slot_set_active(&mut slot2, true);
    if (slot1).is_active != (slot2).is_active || !(slot1).is_active {
        println("FAIL ota_slot_set_active");
        process_exit(1);
    }

    ota_slot_mark_confirmed(&mut slot1);
    ota_slot_mark_confirmed(&mut slot2);
    if !(slot1).is_confirmed {
        println("FAIL ota_slot_mark_confirmed");
        process_exit(1);
    }

    let inact: OtaPartitionSlot = ota_slot_inactive();
    if (inact).is_active || (inact).is_bootable || (inact).is_confirmed {
        println("FAIL ota_slot_inactive flags");
        process_exit(1);
    }

    println("prod_g4_edge_ota_types: PASSED");
    process_exit(0);
}
