// # Three-ctor sum match must name the middle
//
// Logline: Check refuses a Color match that drops Yellow.
//
// Setup: type Color = Red | Yellow | Blue. Exhaust is the variant set.
//
// Beats:
//   1. Match Red and Blue only on an annotated Color let.
//   2. Yellow is missing.
//   3. check must ERR.

type Color = Red | Yellow | Blue;

pub fn main() {
    let a: Color = Red;
    let v: Int = match a {
        Red => 1,
        Blue => 3
    };
}
