// # Product prove std/quantum_open_systems/time_dependent_floquet_lindblad.oo
//
// Logline: Fail-closed emit+gcc+run asserts floquet_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/time_dependent_floquet_lindblad.oo.
//
// Beats:
//   1. Call floquet_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_time_dependent_floquet_lindblad: PASSED only if they match.

import "std/quantum_open_systems/time_dependent_floquet_lindblad.oo";

pub fn main() {
    let time_dependent_floquet_lindblad_mark: Int = 0;
    if time_dependent_floquet_lindblad_mark != 0 {
        process_exit(1);
    }
    let a: FloquetDriveParams = floquet_params_new(0.0, 0.0, 0.0);
    let b: FloquetDriveParams = floquet_params_new(0.0, 0.0, 0.0);
    if (a).static_detuning_delta != (b).static_detuning_delta {
        println("FAIL floquet_params_new");
        process_exit(1);
    }
    println("prod_g2_time_dependent_floquet_lindblad: PASSED");
}
