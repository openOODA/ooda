// # Product prove std/robot/safety_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts safety_fault_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/safety_types.oo.
//
// Beats:
//   1. Call safety_fault_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_safety_types: PASSED only if they match.

import "std/robot/safety_types.oo";

pub fn main() {
    let safety_types_mark: Int = 0;
    if safety_types_mark != 0 {
        process_exit(1);
    }
    let a: SafetyFault = safety_fault_new(0, 0, 0);
    let b: SafetyFault = safety_fault_new(0, 0, 0);
    if (a).code != (b).code {
        println("FAIL safety_fault_new");
        process_exit(1);
    }
    println("prod_safety_types: PASSED");
}
