// # Restart a thin actor slot
//
// Logline: Spawn, send ping, recv, restart, send again.
//
// Setup: OPEN-54. actor_restart under ThreadCap.
//
// Beats:
//   1. actor_spawn.
//   2. send/recv ping.
//   3. actor_restart and print PASSED.

pub fn main(thread: &ThreadCap) {
    let a: Result[String, String] = actor_spawn(thread, "w");
    if a.is_err() {
        println("FAIL spawn");
        process_exit(1);
    }
    let s: Result[String, String] = actor_send(thread, 0, "ping");
    if s.is_err() {
        println("FAIL send");
        process_exit(1);
    }
    let m: Result[String, String] = actor_recv(thread, 0);
    if m.is_err() {
        println("FAIL recv");
        process_exit(1);
    }
    let r: Result[String, String] = actor_restart(thread, 0);
    if r.is_err() {
        println("FAIL restart");
        process_exit(1);
    }
    println("open_actor_restart: PASSED");
}