// # Product stream_map prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_map_add.
//
// Setup: Product std/io/stream_map.oo. List[Int] destub.
//
// Beats:
//   1. [1,2] add 10 -> 11 then 12; len 2.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_map.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    let m: StreamMap = stream_map_add(xs, 10);
    let n: Int = stream_map_len(m);
    if n != 2 {
        println("FAIL smap len");
        process_exit(1);
    }
    let g0: Int = stream_map_get(m, 0);
    if g0 != 11 {
        println("FAIL smap first");
        process_exit(1);
    }
    let g1: Int = stream_map_get(m, 1);
    if g1 != 12 {
        println("FAIL smap second");
        process_exit(1);
    }
    println("prod_smap: PASSED");
}
