// # Product prove std/robotics_auv/multibeam_echosounder_swath.oo
//
// Logline: Fail-closed emit+gcc+run asserts mbes_config_default_em2040 is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/multibeam_echosounder_swath.oo.
//
// Beats:
//   1. Call mbes_config_default_em2040 twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_multibeam_echosounder_swath: PASSED only if they match.

import "std/robotics_auv/multibeam_echosounder_swath.oo";

pub fn main() {
    let multibeam_echosounder_swath_mark: Int = 0;
    if multibeam_echosounder_swath_mark != 0 {
        process_exit(1);
    }
    let a: MbesConfig = mbes_config_default_em2040();
    let b: MbesConfig = mbes_config_default_em2040();
    if (a).number_of_beams != (b).number_of_beams {
        println("FAIL mbes_config_default_em2040");
        process_exit(1);
    }
    println("prod_multibeam_echosounder_swath: PASSED");
}
