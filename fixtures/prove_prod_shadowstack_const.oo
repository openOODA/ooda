// # Product prove std/sec/sys/shadowstack_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadowstack_default_max_depth is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/shadowstack_const.oo.
//
// Beats:
//   1. Call shadowstack_default_max_depth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shadowstack_const: PASSED only if they match.

import "std/sec/sys/shadowstack_const.oo";

pub fn main() {
    let a = shadowstack_default_max_depth();
    let b = shadowstack_default_max_depth();
    if a != b {
        println("FAIL shadowstack_default_max_depth");
        process_exit(1);
    }
    println("prod_shadowstack_const: PASSED");
}
