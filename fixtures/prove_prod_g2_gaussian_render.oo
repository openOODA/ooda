// # Product prove std/3d/gaussian_render.oo
//
// Logline: Fail-closed emit+gcc+run asserts gauss_rend_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_render.oo.
//
// Beats:
//   1. Call gauss_rend_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gaussian_render: PASSED only if they match.

import "std/3d/gaussian_render.oo";

pub fn main() {
    let gaussian_render_mark: Int = 0;
    if gaussian_render_mark != 0 {
        process_exit(1);
    }
    let a: GaussRend = gauss_rend_new(0, 0);
    let b: GaussRend = gauss_rend_new(0, 0);
    if (a).w != (b).w {
        println("FAIL gauss_rend_new");
        process_exit(1);
    }
    println("prod_g2_gaussian_render: PASSED");
}
