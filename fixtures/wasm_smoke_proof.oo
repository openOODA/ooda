// # WebAssembly (.wat) Output and Execution Proof Fixture
//
// Logline: Prove WebAssembly lowering, string concatenation, integer math, and wasmtime execution.
//
// Setup: Emits standard .wat module and executes under wasmtime.
//
// Beats:
//   1. Perform string concatenation and formatting in WASM.
//   2. Validate arithmetic execution.
//   3. Print confirmation marker.
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.6: Prove happy path execution.
// RULES.oot 1.7: Under 256 lines.

pub fn wasm_calc(x: Int, y: Int) -> Int {
    return (x * y) + 10;
}

pub fn wasm_greet(name: String) -> String {
    return "WASM_OK: " + name;
}

pub fn main() {
    let msg: String = wasm_greet("Proof Passed");
    println(msg);
    let val: Int = wasm_calc(5, 6);
    println(val.to_string());
}
