// # Product prove std/sync/latch_countdown.oo
//
// Logline: Fail-closed emit+gcc+run asserts latch_is_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/latch_countdown.oo.
//
// Beats:
//   1. Call latch_is_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_latch_countdown: PASSED only if they match.

import "std/sync/latch_countdown.oo";

pub fn main() {
    let obj = latch_new(0);
    let a = latch_is_zero(obj);
    let b = latch_is_zero(obj);
    if a != b {
        println("FAIL latch_is_zero");
        process_exit(1);
    }
    println("prod_latch_countdown: PASSED");
}
