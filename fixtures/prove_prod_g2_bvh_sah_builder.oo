// # Product prove std/pbr_raytracing/bvh_sah_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts sah_compute_cost is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/bvh_sah_builder.oo.
//
// Beats:
//   1. Call sah_compute_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bvh_sah_builder: PASSED only if they match.

import "std/pbr_raytracing/bvh_sah_builder.oo";

pub fn main() {
    let bvh_sah_builder_mark: Int = 0;
    if bvh_sah_builder_mark != 0 {
        process_exit(1);
    }
    let a: Float = sah_compute_cost(0.0, 0.0, 0.0, 0, 0);
    let b: Float = sah_compute_cost(0.0, 0.0, 0.0, 0, 0);
    if a != b {
        println("FAIL sah_compute_cost");
        process_exit(1);
    }
    println("prod_g2_bvh_sah_builder: PASSED");
}
