// # Product prove std/neuro_bci/eeg_csp_spatial_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts csp_filter_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_csp_spatial_filter.oo.
//
// Beats:
//   1. Call csp_filter_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eeg_csp_spatial_filter: PASSED only if they match.

import "std/neuro_bci/eeg_csp_spatial_filter.oo";

pub fn main() {
    let eeg_csp_spatial_filter_mark: Int = 0;
    if eeg_csp_spatial_filter_mark != 0 {
        process_exit(1);
    }
    let a: CSPFilter4x2 = csp_filter_default();
    let b: CSPFilter4x2 = csp_filter_default();
    if (a).// Component 1 (maximizes Class 1 variance)
    w1_0 != (b).// Component 1 (maximizes Class 1 variance)
    w1_0 {
        println("FAIL csp_filter_default");
        process_exit(1);
    }
    println("prod_eeg_csp_spatial_filter: PASSED");
}
