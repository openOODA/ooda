// # Product prove std/space_propulsion/patched_conics_flyby.oo
//
// Logline: Fail-closed emit+gcc+run asserts flyby_spec_default_venus value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/patched_conics_flyby.oo.
//
// Beats:
//   1. Call flyby_spec_default_venus twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_patched_conics_flyby: PASSED only if asserts hold.

import "std/space_propulsion/patched_conics_flyby.oo";

pub fn main() {
    let patched_conics_flyby: FlybyPlanetarySpec = flyby_spec_default_venus();
    let patched_conics_flyby_b: FlybyPlanetarySpec = flyby_spec_default_venus();
    if (patched_conics_flyby).periapsis_altitude_m != 350000.0 {
        println("FAIL flyby_spec_default_venus periapsis_altitude_m");
        process_exit(1);
    }
    if (patched_conics_flyby).periapsis_altitude_m != (patched_conics_flyby_b).periapsis_altitude_m {
        println("FAIL flyby_spec_default_venus det");
        process_exit(1);
    }
    println("prod_patched_conics_flyby: PASSED");
}
