// # Product prove std/compilers_polyhedral/polyhedral_schedule_tree.oo
//
// Logline: Fail-closed verification of polyhedral schedule tree node construction and traversal.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_schedule_tree.oo.
//
// Beats:
//   1. Construct schedule tree root and band child nodes.
//   2. Add child relationships and insert nodes into schedule tree context.
//   3. Search nodes and evaluate node type predicates deterministically.
//   4. Print prod_g4_compilers_polyhedral_tree: PASSED and exit 0.

import "std/compilers_polyhedral/polyhedral_schedule_tree.oo";

pub fn main() {
    let mut root_node: ScheduleTreeNode = schedule_tree_node_new(1, 0, 0, 0);
    let mut band_node: ScheduleTreeNode = schedule_tree_node_new(2, 1, 1, 1);

    let is_root_band: Bool = schedule_tree_is_band(root_node);
    let is_child_band: Bool = schedule_tree_is_band(band_node);
    if is_root_band || !is_child_band {
        println("FAIL schedule_tree_is_band");
        process_exit(1);
    }

    root_node = schedule_tree_node_add_child(root_node, 2);
    let mut ctx: ScheduleTreeContext = schedule_tree_context_new(1);
    ctx = schedule_tree_add_node(ctx, root_node);
    ctx = schedule_tree_add_node(ctx, band_node);

    let cnt: Int = (ctx).node_count;
    if cnt != 2 {
        println("FAIL schedule_tree_add_node count");
        process_exit(1);
    }

    let idx1: Int = schedule_tree_find_node(ctx, 1);
    let idx2: Int = schedule_tree_find_node(ctx, 2);
    let idx_miss: Int = schedule_tree_find_node(ctx, 999);

    if idx1 != 0 || idx2 != 1 || idx_miss != -1 {
        println("FAIL schedule_tree_find_node indices");
        process_exit(1);
    }

    println("prod_g4_compilers_polyhedral_tree: PASSED");
    process_exit(0);
}
