// # Product prove std/graph_networks/rpl_dodag_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts rpl_node_create real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/rpl_dodag_tree.oo.
//
// Beats:
//   1. Call rpl_node_create with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_rpl_dodag_tree: PASSED only if the assert holds.

import "std/graph_networks/rpl_dodag_tree.oo";

pub fn main() {
    let rpl_dodag_tree_a: RplDodagNode = rpl_node_create(7, true, 7);
    let rpl_dodag_tree_node_id: Int = (rpl_dodag_tree_a).node_id;
    if rpl_dodag_tree_node_id != 7 {
        println("FAIL rpl_node_create");
        process_exit(1);
    }
    println("prod_rpl_dodag_tree: PASSED");
}
