// # Product prove std/db_columnar/columnar_byte_stream_split.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_byte_stream_split.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_byte_stream_split.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_columnar_byte_stream_split: PASSED only if they match.

import "std/db_columnar/columnar_byte_stream_split.oo";

pub fn main() {
    let columnar_byte_stream_split_a = split_stream_4byte_new();
    let columnar_byte_stream_split_b = split_stream_4byte_new();
    if columnar_byte_stream_split_a.num_floats != columnar_byte_stream_split_b.num_floats {
        println("FAIL columnar_byte_stream_split");
        process_exit(1);
    }
    println("prod_ap_columnar_byte_stream_split: PASSED");
