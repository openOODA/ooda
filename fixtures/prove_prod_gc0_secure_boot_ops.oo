// # Product prove std/sec/sys/secure_boot_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts secure_boot_ops_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot_ops.oo.
//
// Beats:
//   1. Call secure_boot_ops_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secure_boot_ops: PASSED only if they match.

import "std/sec/sys/secure_boot_ops.oo";

pub fn main() {
    let secure_boot_ops_mark: Int = 0;
    if secure_boot_ops_mark != 0 {
        process_exit(1);
    }
    let secure_boot_ops_a = secure_boot_ops_init(1, 1);
    let secure_boot_ops_b = secure_boot_ops_init(1, 1);
    if (secure_boot_ops_a).violation_type != (secure_boot_ops_b).violation_type {
        println("FAIL secure_boot_ops_init");
        process_exit(1);
    }
    println("prod_secure_boot_ops: PASSED");
}
