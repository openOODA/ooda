// # Product prove std/enterprise/audit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts enterprise audit engine operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_engine.oo.
//
// Beats:
//   1. Call audit_engine_probe and verify status code.
//   2. Evaluate audit severity conversions and policy allowance checks.
//   3. Compute audit event hash and assert deterministic output.
//   4. Print prod_g4_enterprise_audit: PASSED and exit 0.

import "std/enterprise/audit_engine.oo";

pub fn main() {
    let probe_a: Int = audit_engine_probe();
    let probe_b: Int = audit_engine_probe();
    if probe_a != probe_b || probe_a != 0 {
        println("FAIL audit_engine_probe");
        process_exit(1);
    }

    let s1: String = audit_severity_to_string(1);
    let s2: String = audit_severity_to_string(1);
    if s1 != s2 || s1 != "INFO" {
        println("FAIL audit_severity_to_string");
        process_exit(1);
    }

    let pol: AuditPolicy = audit_policy_init(1, true, 100, false);
    let allowed: Bool = audit_policy_is_allowed(pol, 2);
    if allowed != true {
        println("FAIL audit_policy_is_allowed");
        process_exit(1);
    }

    let evt1: AuditEvent = audit_event_create(1, 1000, 2, "LOGIN", "alice", "auth", "OK", "success");
    let evt2: AuditEvent = audit_event_create(1, 1000, 2, "LOGIN", "alice", "auth", "OK", "success");
    let h1: Int = audit_event_calculate_hash(evt1);
    let h2: Int = audit_event_calculate_hash(evt2);
    if h1 != h2 {
        println("FAIL audit_event_calculate_hash");
        process_exit(1);
    }

    println("prod_g4_enterprise_audit: PASSED");
    process_exit(0);
}
