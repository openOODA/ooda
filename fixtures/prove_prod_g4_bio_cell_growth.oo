// # Product prove std/bio/cell_growth.oo
//
// Logline: Fail-closed verification that cellular growth kinetics and rate models are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_growth.oo.
//
// Beats:
//   1. Construct GrowthRate using default and custom parameters.
//   2. Validate optimal growth rate criteria and effective growth rate calculation.
//   3. Compute predicted cell counts across elapsed division hours.
//   4. Print prod_g4_bio_cell_growth: PASSED and exit 0.

import "std/bio/cell_growth.oo";

pub fn main() {
    let cell_growth_mark: Int = 0;
    if cell_growth_mark != 0 {
        process_exit(1);
    }
    let r1: GrowthRate = growth_rate_default();
    let r2: GrowthRate = growth_rate_default();

    let opt1: Bool = growth_rate_is_optimal(&r1);
    let opt2: Bool = growth_rate_is_optimal(&r2);
    if !opt1 || !opt2 {
        println("FAIL growth_rate_is_optimal");
        process_exit(1);
    }

    let eff1: Float = growth_rate_effective_rate(&r1, 0.0);
    let eff2: Float = growth_rate_effective_rate(&r2, 0.0);
    if eff1 != eff2 || eff1 <= 0.0 {
        println("FAIL growth_rate_effective_rate");
        process_exit(1);
    }

    let cnt1: Int = growth_rate_calculate_count(&r1, 100, 50.0);
    let cnt2: Int = growth_rate_calculate_count(&r2, 100, 50.0);
    if cnt1 != cnt2 || cnt1 != 400 {
        println("FAIL growth_rate_calculate_count");
        process_exit(1);
    }

    let custom1: GrowthRate = growth_rate_new(12.0, 1.0, 500000.0, 0.02);
    let custom2: GrowthRate = growth_rate_new(12.0, 1.0, 500000.0, 0.02);
    let opt_cust: Bool = growth_rate_is_optimal(&custom1);
    if !opt_cust {
        println("FAIL growth_rate_new optimal");
        process_exit(1);
    }

    let cnt_cust1: Int = growth_rate_calculate_count(&custom1, 50, 25.0);
    let cnt_cust2: Int = growth_rate_calculate_count(&custom2, 50, 25.0);
    if cnt_cust1 != cnt_cust2 || cnt_cust1 != 200 {
        println("FAIL growth_rate_calculate_count custom");
        process_exit(1);
    }

    println("prod_g4_bio_cell_growth: PASSED");
    process_exit(0);
}
