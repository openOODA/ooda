// # Product prove std/compilers/llvm_ir_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts llvm_type_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/llvm_ir_types.oo.
//
// Beats:
//   1. Call llvm_type_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_llvm_ir_types: PASSED only if they match.

import "std/compilers/llvm_ir_types.oo";

pub fn main() {
    let llvm_ir_types_mark: Int = 0;
    if llvm_ir_types_mark != 0 {
        process_exit(1);
    }
    let a: LLVMType = llvm_type_new(0, 0, 0);
    let b: LLVMType = llvm_type_new(0, 0, 0);
    if (a).kind != (b).kind {
        println("FAIL llvm_type_new");
        process_exit(1);
    }
    println("prod_llvm_ir_types: PASSED");
}
