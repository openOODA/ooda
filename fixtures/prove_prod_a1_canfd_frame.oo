// # Product prove std/auto_robot/canfd_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts canfd_dlc_to_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/canfd_frame.oo.
//
// Beats:
//   1. Call canfd_dlc_to_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_canfd_frame: PASSED only if they match.

import "std/auto_robot/canfd_frame.oo";

pub fn main() {
    let canfd_frame_mark: Int = 0;
    if canfd_frame_mark != 0 {
        process_exit(1);
    }
    let a: Int = canfd_dlc_to_len(0);
    let b: Int = canfd_dlc_to_len(0);
    if a != b {
        println("FAIL canfd_dlc_to_len");
        process_exit(1);
    }
    println("prod_canfd_frame: PASSED");
}
