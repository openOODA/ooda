// # Product slug prove
//
// Logline: Fail-closed emit+gcc+run of shipped slug_generate.
//
// Setup: Product std/text/slug_generator.oo. Hello World -> hello-world.
//
// Beats:
//   1. slug_generate Hello World is hello-world.
//   2. Empty input is empty.
//   3. Exit 1 before PASSED on a miss.

import "std/text/slug_generator.oo";

pub fn main() {
    let s: String = slug_generate("Hello World");
    if s != "hello-world" {
        println("FAIL slug");
        process_exit(1);
    }
    let e: String = slug_generate("");
    if e != "" {
        println("FAIL slug empty");
        process_exit(1);
    }
    println("prod_slug: PASSED");
}
