// # Product prove std/auto_robot/pointcloud_ransac_ground.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/pointcloud_ransac_ground.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_ransac_ground.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pointcloud_ransac_ground: PASSED only if they match.

import "std/auto_robot/pointcloud_ransac_ground.oo";

pub fn main() {
    let pointcloud_ransac_ground_a = ransac_plane_eval(0, 0, 0, 0, 0, 0, 0);
    let pointcloud_ransac_ground_b = ransac_plane_eval(0, 0, 0, 0, 0, 0, 0);
    if pointcloud_ransac_ground_a != pointcloud_ransac_ground_b {
        println("FAIL pointcloud_ransac_ground");
        process_exit(1);
    }
    println("prod_ap_pointcloud_ransac_ground: PASSED");
}
