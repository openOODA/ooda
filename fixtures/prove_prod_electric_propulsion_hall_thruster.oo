// # Product prove std/astro_advanced/electric_propulsion_hall_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts hall_isp is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/electric_propulsion_hall_thruster.oo.
//
// Beats:
//   1. Call hall_isp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_electric_propulsion_hall_thruster: PASSED only if they match.

import "std/astro_advanced/electric_propulsion_hall_thruster.oo";

pub fn main() {
    let a = hall_isp();
    let b = hall_isp();
    if a != b {
        println("FAIL hall_isp");
        process_exit(1);
    }
    println("prod_electric_propulsion_hall_thruster: PASSED");
}
