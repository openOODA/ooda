// # Product prove std/scicomp/gamma_beta_special.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_ln_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/gamma_beta_special.oo.
//
// Beats:
//   1. Call math_ln_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gamma_beta_special: PASSED only if they match.

import "std/scicomp/gamma_beta_special.oo";

pub fn main() {
    let gamma_beta_special_mark: Int = 0;
    if gamma_beta_special_mark != 0 {
        process_exit(1);
    }
    let a: Float = math_ln_approx(0.0);
    let b: Float = math_ln_approx(0.0);
    if a != b {
        println("FAIL math_ln_approx");
        process_exit(1);
    }
    println("prod_g2_gamma_beta_special: PASSED");
}
