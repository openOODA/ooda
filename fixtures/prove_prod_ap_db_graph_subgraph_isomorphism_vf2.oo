// # Product prove std/db_graph/subgraph_isomorphism_vf2.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/subgraph_isomorphism_vf2.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/subgraph_isomorphism_vf2.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_subgraph_isomorphism_vf2: PASSED only if they match.

import "std/db_graph/subgraph_isomorphism_vf2.oo";

pub fn main() {
    let subgraph_isomorphism_vf2_a = vf2_state_new(0, 0);
    let subgraph_isomorphism_vf2_b = vf2_state_new(0, 0);
    let subgraph_isomorphism_vf2_va = vf2_is_feasible(subgraph_isomorphism_vf2_a, 0, 0);
    let subgraph_isomorphism_vf2_vb = vf2_is_feasible(subgraph_isomorphism_vf2_b, 0, 0);
    if subgraph_isomorphism_vf2_va != subgraph_isomorphism_vf2_vb {
        println("FAIL subgraph_isomorphism_vf2");
        process_exit(1);
    }
    println("prod_ap_subgraph_isomorphism_vf2: PASSED");
}
