// # Product prove std/fintech/portfolio_opt_markowitz.oo
//
// Logline: Fail-closed emit+gcc+run asserts asset_stats_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/portfolio_opt_markowitz.oo.
//
// Beats:
//   1. Call asset_stats_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_portfolio_opt_markowitz: PASSED only if they match.

import "std/fintech/portfolio_opt_markowitz.oo";

pub fn main() {
    let a: AssetStats = asset_stats_new("x", 0.0, 0.0, 0.0);
    let b: AssetStats = asset_stats_new("x", 0.0, 0.0, 0.0);
    if a.expected_return != b.expected_return {
        println("FAIL asset_stats_new");
        process_exit(1);
    }
    println("prod_portfolio_opt_markowitz: PASSED");
}
