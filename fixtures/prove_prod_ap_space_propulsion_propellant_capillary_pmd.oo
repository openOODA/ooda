// # Product prove std/space_propulsion/propellant_capillary_pmd.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/propellant_capillary_pmd.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_capillary_pmd.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_propellant_capillary_pmd: PASSED only if they match.

import "std/space_propulsion/propellant_capillary_pmd.oo";

pub fn main() {
    let propellant_capillary_pmd_a = capillary_pmd_spec_default_hydrazine();
    let propellant_capillary_pmd_b = capillary_pmd_spec_default_hydrazine();
    if propellant_capillary_pmd_a.screen_pore_radius_um != propellant_capillary_pmd_b.screen_pore_radius_um {
        println("FAIL propellant_capillary_pmd");
        process_exit(1);
    }
    println("prod_ap_propellant_capillary_pmd: PASSED");
}
