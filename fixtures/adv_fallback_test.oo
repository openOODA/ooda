// # Test fallback items in match let
//
// Logline: Test match let when Err returns an existing List[Item].
//
// Setup: Backend-C.
//
// Beats:
//   1. Create fallback List[Item].
//   2. Match let Err branch returns fallback.
//   3. GCC compile and run.

type Item = struct {
    id: Int,
    name: String
};

fn make_err() -> Result[List[Item], String] {
    return Err("failed");
}

pub fn main() {
    let mut fallback: List[Item] = list_new();
    let it: Item = Item { id: 999, name: "fallback_item" };
    fallback = list_push(fallback, it);

    let r: Result[List[Item], String] = make_err();
    let xs: List[Item] = match r {
        Ok(v) => v,
        Err(e) => fallback
    };
    if list_len(xs) != 1 {
        println("FAIL fallback len");
        process_exit(1);
    }
    let g: Item = list_get(xs, 0);
    if g.id != 999 {
        println("FAIL fallback id");
        process_exit(1);
    }
    println("fallback_test: PASSED");
}
