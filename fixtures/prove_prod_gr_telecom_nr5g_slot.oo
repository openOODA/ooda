// # Product prove std/telecom/nr5g_slot.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_slot_total_symbols is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/nr5g_slot.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call nr5g_slot_total_symbols twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_nr5g_slot: PASSED only if they match.

import "std/telecom/nr5g_slot.oo";

pub fn main() {
    let g0_oa: Nr5gSlotFormat = Nr5gSlotFormat { format_id: 0, num_dl_symbols: 0, num_ul_symbols: 0, num_flex_symbols: 0, is_extended_cp: true };
    let g0_ob: Nr5gSlotFormat = Nr5gSlotFormat { format_id: 0, num_dl_symbols: 0, num_ul_symbols: 0, num_flex_symbols: 0, is_extended_cp: true };
    let g0_a = nr5g_slot_total_symbols(&g0_oa);
    let g0_b = nr5g_slot_total_symbols(&g0_ob);
    if g0_a != g0_b {
        println("FAIL nr5g_slot_total_symbols");
        process_exit(1);
    }
    println("prod_gr_nr5g_slot: PASSED");
}
