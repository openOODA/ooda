// # emit-x86 let-bound string-int concat
//
// Logline: Bind s to n= plus 7 and print s so emit-x86 can lower a same-fn mixed concat.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind s to n= plus 7.
//   3. Print s.
//
// residual: greet calls stay later.

pub fn main() {
    let s = "n=" + 7;
    println(s);
}
