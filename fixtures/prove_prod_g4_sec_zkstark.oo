// # Product prove std/sec/crypto/zkstark.oo
//
// Logline: Fail-closed emit+gcc+run asserts ZK-STARK modular field arithmetic and AIR constraints are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zkstark.oo.
//
// Beats:
//   1. Evaluate modular exponentiation, multiplication, addition, and subtraction.
//   2. Instantiate AirConstraint structures and query polynomial degrees.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_sec_zkstark: PASSED and exit 0.

import "std/sec/crypto/zkstark.oo";

pub fn main() {
    let pow1: Int = shim_marker_mod_pow();
    let pow2: Int = shim_marker_mod_pow();
    if pow1 != pow2 || pow1 != 256 {
        println("FAIL shim_marker_mod_pow");
        process_exit(1);
    }

    let mul1: Int = shim_marker_mod_mul();
    let mul2: Int = shim_marker_mod_mul();
    if mul1 != mul2 || mul1 != 21 {
        println("FAIL shim_marker_mod_mul");
        process_exit(1);
    }

    let add1: Int = shim_marker_mod_add();
    let add2: Int = shim_marker_mod_add();
    if add1 != add2 || add1 != 30 {
        println("FAIL shim_marker_mod_add");
        process_exit(1);
    }

    let sub1: Int = shim_marker_mod_sub();
    let sub2: Int = shim_marker_mod_sub();
    if sub1 != sub2 || sub1 != 10 {
        println("FAIL shim_marker_mod_sub");
        process_exit(1);
    }

    let c1: AirConstraint = shim_marker_air_constraint_new(4, 3, 16);
    let c2: AirConstraint = shim_marker_air_constraint_new(4, 3, 16);
    if shim_marker_air_constraint_degree(c1) != shim_marker_air_constraint_degree(c2) || shim_marker_air_constraint_degree(c1) != 4 {
        println("FAIL shim_marker_air_constraint_degree");
        process_exit(1);
    }

    if (c1).coefficient != (c2).coefficient || (c1).coefficient != 3 {
        println("FAIL coefficient");
        process_exit(1);
    }

    if (c1).target_step != (c2).target_step || (c1).target_step != 16 {
        println("FAIL target_step");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_zkstark_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_zkstark: PASSED");
    process_exit(0);
}
