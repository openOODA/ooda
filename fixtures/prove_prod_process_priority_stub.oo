// # Product prove std/os/process_priority_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts priority_is_realtime_high is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/process_priority_stub.oo.
//
// Beats:
//   1. Call priority_is_realtime_high twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_process_priority_stub: PASSED only if they match.

import "std/os/process_priority_stub.oo";

pub fn main() {
    let obj = priority_config_new(0, 0);
    let a = priority_is_realtime_high(obj);
    let b = priority_is_realtime_high(obj);
    if a != b {
        println("FAIL priority_is_realtime_high");
        process_exit(1);
    }
    println("prod_process_priority_stub: PASSED");
}
