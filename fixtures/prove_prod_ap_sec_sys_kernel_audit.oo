// # Product prove std/sec/sys/kernel_audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/kernel_audit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kernel_audit: PASSED only if they match.

import "std/sec/sys/kernel_audit.oo";

pub fn main() {
    let kernel_audit_a = shim_marker_audit_perm_exec();
    let kernel_audit_b = shim_marker_audit_perm_exec();
    if kernel_audit_a != kernel_audit_b {
        println("FAIL kernel_audit");
        process_exit(1);
    }
    println("prod_ap_kernel_audit: PASSED");
}
