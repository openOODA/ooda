// # Product prove std/digital_twin/digital_twin_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts digital_twin_stub_dac_dma_latch is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/digital_twin_stubs.oo.
//
// Beats:
//   1. Call digital_twin_stub_dac_dma_latch twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_digital_twin_stubs: PASSED only if they match.

import "std/digital_twin/digital_twin_stubs.oo";

pub fn main() {
    let digital_twin_stubs_mark: Int = 0;
    if digital_twin_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = digital_twin_stub_dac_dma_latch(0, 0);
    let b: Bool = digital_twin_stub_dac_dma_latch(0, 0);
    if a != b {
        println("FAIL digital_twin_stub_dac_dma_latch");
        process_exit(1);
    }
    println("prod_digital_twin_stubs: PASSED");
}
