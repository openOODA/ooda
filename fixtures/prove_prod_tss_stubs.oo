import "std/sec/crypto/tss_stubs.oo";

pub fn main() {
    let tss_stubs_mark: Int = 0;
    if tss_stubs_mark != 0 { process_exit(1); }
    let a: List[ThresholdKeyShare] = tss_dkg_generate_shares(0, "x");
    let b: List[ThresholdKeyShare] = tss_dkg_generate_shares(0, "x");
    if a != b { process_exit(1); }
    println("prod_tss_stubs: PASSED");
}
