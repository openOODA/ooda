// # Product prove std/astrophysics_relativity/cosmological_big_bang_nucleosynthesis.oo
//
// Logline: Fail-closed emit+gcc+run asserts bbn_freeze_out_np is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_big_bang_nucleosynthesis.oo.
//
// Beats:
//   1. Call bbn_freeze_out_np twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cosmological_big_bang_nucleosynthesis: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_big_bang_nucleosynthesis.oo";

pub fn main() {
    let cosmological_big_bang_nucleosynthesis_mark: Int = 0;
    if cosmological_big_bang_nucleosynthesis_mark != 0 {
        process_exit(1);
    }
    let a: Float = bbn_freeze_out_np(0.0);
    let b: Float = bbn_freeze_out_np(0.0);
    if a != b {
        println("FAIL bbn_freeze_out_np");
        process_exit(1);
    }
    println("prod_cosmological_big_bang_nucleosynthesis: PASSED");
}
