// # Product prove std/neuro_bci/bci_prosthetic_hand_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts prosthetic_state_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_prosthetic_hand_controller.oo.
//
// Beats:
//   1. Call prosthetic_state_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bci_prosthetic_hand_controller: PASSED only if they match.

import "std/neuro_bci/bci_prosthetic_hand_controller.oo";

pub fn main() {
    let a: ProstheticState = prosthetic_state_default();
    let b: ProstheticState = prosthetic_state_default();
    if a.current_posture != b.current_posture {
        println("FAIL prosthetic_state_default");
        process_exit(1);
    }
    println("prod_bci_prosthetic_hand_controller: PASSED");
}
