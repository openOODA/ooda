// # Product prove std/genomics_advanced/ancient_dna_damage_mapdamage.oo
//
// Logline: Fail-closed emit+gcc+run asserts ancient_dna_damage_mapdamage_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/ancient_dna_damage_mapdamage.oo.
//
// Beats:
//   1. Call ancient_dna_damage_mapdamage_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ancient_dna_damage_mapdamage: PASSED only if they match.

import "std/genomics_advanced/ancient_dna_damage_mapdamage.oo";

pub fn main() {
    let a = ancient_dna_damage_mapdamage_probe();
    let b = ancient_dna_damage_mapdamage_probe();
    if a != b {
        println("FAIL ancient_dna_damage_mapdamage_probe");
        process_exit(1);
    }
    println("prod_ancient_dna_damage_mapdamage: PASSED");
}
