// # Product bigint_str prove
//
// Logline: Fail-closed emit+gcc+run of shipped bigint_from_int/to_int.
//
// Setup: Product std/math/bigint_str.oo. Native Int 42 roundtrip.
//
// Beats:
//   1. from_int(42) to_int is 42.
//   2. from_int(0) to_int is 0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/bigint_str.oo";

pub fn main() {
    let b: BigInt = bigint_from_int(42);
    let n: Int = bigint_to_int(b);
    if n != 42 {
        println("FAIL bigintstr 42");
        process_exit(1);
    }
    let z: BigInt = bigint_from_int(0);
    let zn: Int = bigint_to_int(z);
    if zn != 0 {
        println("FAIL bigintstr 0");
        process_exit(1);
    }
    println("prod_bigintstr: PASSED");
}
