// # Product prove std/nerf_3dgs/gaussian_scene_ply_loader.oo
//
// Logline: Fail-closed emit+gcc+run asserts validate_ply_property_count is a real value.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_scene_ply_loader.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call validate_ply_property_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_gaussian_scene_ply_loader: PASSED only if they match.

import "std/nerf_3dgs/gaussian_scene_ply_loader.oo";

pub fn main() {
    let g0_oa: PlyGaussianHeader = PlyGaussianHeader { num_vertices: 0, is_binary_little_endian: 0, sh_degree: 0, has_normals: 0, stride_bytes: 0 };
    let g0_ob: PlyGaussianHeader = PlyGaussianHeader { num_vertices: 0, is_binary_little_endian: 0, sh_degree: 0, has_normals: 0, stride_bytes: 0 };
    let g0_a = validate_ply_property_count(&g0_oa);
    let g0_b = validate_ply_property_count(&g0_ob);
    if g0_a != g0_b {
        println("FAIL validate_ply_property_count");
        process_exit(1);
    }
    println("prod_gr_gaussian_scene_ply_loader: PASSED");
}
