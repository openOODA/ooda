// # Product prove std/tda_topology/multiscale_mapper_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts cluster_lineage_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/multiscale_mapper_graph.oo.
//
// Beats:
//   1. Call cluster_lineage_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_multiscale_mapper_graph: PASSED only if they match.

import "std/tda_topology/multiscale_mapper_graph.oo";

pub fn main() {
    let multiscale_mapper_graph_mark: Int = 0;
    if multiscale_mapper_graph_mark != 0 {
        process_exit(1);
    }
    let multiscale_mapper_graph_a = cluster_lineage_new(1, 1, 1, 1, 1);
    let multiscale_mapper_graph_b = cluster_lineage_new(1, 1, 1, 1, 1);
    if (multiscale_mapper_graph_a).parent_level != (multiscale_mapper_graph_b).parent_level {
        println("FAIL cluster_lineage_new");
        process_exit(1);
    }
    println("prod_multiscale_mapper_graph: PASSED");
}
