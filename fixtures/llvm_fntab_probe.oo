// # Prove List[String] fntab mapping
//
// Logline: Scan a List[String] return as %OoSList and a List[Int] return as %OoIList.
//
// Setup: Imports oodac/llvm_fntab.oo. No emit of oodac.
//
// Beats:
//   1. parse_cli_argv maps to %OoSList.
//   2. nums maps to %OoIList.
//   3. Bare void fn maps to void.

import "oodac/llvm_fntab.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let sl: String = llvm_fntab_of_src("pub fn parse_cli_argv(a: List[String]) -> List[String] {\n}\n");
    if str_index_of(sl, "parse_cli_argv=%OoSList|") < 0 {
        fail("want %OoSList got " + sl);
    }
    let il: String = llvm_fntab_of_src("pub fn nums() -> List[Int] {\n}\n");
    if str_index_of(il, "nums=%OoIList|") < 0 {
        fail("want %OoIList got " + il);
    }
    let vd: String = llvm_fntab_of_src("pub fn go() {\n}\n");
    if str_index_of(vd, "go=void|") < 0 {
        fail("want void got " + vd);
    }
    let bt: String = llvm_builtin_fntab();
    if str_index_of(bt, "sys_exec=%OoResS|") < 0 {
        fail("builtin sys_exec");
    }
    println("llvm_fntab_probe: PASSED");
}
