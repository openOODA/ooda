// # Product prove std/space_propulsion/rocket_combustion_chamber.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_combustion_chamber.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_combustion_chamber.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rocket_combustion_chamber: PASSED only if they match.

import "std/space_propulsion/rocket_combustion_chamber.oo";

pub fn main() {
    let rocket_combustion_chamber_a = combustion_hydrolox_default();
    let rocket_combustion_chamber_b = combustion_hydrolox_default();
    if rocket_combustion_chamber_a.prop_type != rocket_combustion_chamber_b.prop_type {
        println("FAIL rocket_combustion_chamber");
        process_exit(1);
    }
    println("prod_ap_rocket_combustion_chamber: PASSED");
}
