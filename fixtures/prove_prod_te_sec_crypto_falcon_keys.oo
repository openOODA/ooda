// # Product prove std/sec/crypto/falcon_keys.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_hash_to_point is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_keys.oo.
//
// Beats:
//   1. Call falcon_hash_to_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_keys: PASSED only if they match.

import "std/sec/crypto/falcon_keys.oo";

pub fn main() {
    let falcon_keys_mark: Int = 0;
    if falcon_keys_mark != 0 {
        process_exit(1);
    }
    let a: FalconPolynomial = falcon_hash_to_point("x", "x", 0, 0);
    let b: FalconPolynomial = falcon_hash_to_point("x", "x", 0, 0);
    if (a).degree != (b).degree {
        println("FAIL falcon_hash_to_point");
        process_exit(1);
    }
    println("prod_falcon_keys: PASSED");
}
