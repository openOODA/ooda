// # Product prove std/compilers_polyhedral/compilers_polyhedral_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts stub_gemm_kernel is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/compilers_polyhedral_stubs.oo.
//
// Beats:
//   1. Call stub_gemm_kernel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compilers_polyhedral_stubs: PASSED only if they match.

import "std/compilers_polyhedral/compilers_polyhedral_stubs.oo";

pub fn main() {
    let compilers_polyhedral_stubs_mark: Int = 0;
    if compilers_polyhedral_stubs_mark != 0 {
        process_exit(1);
    }
    let a: PolyhedralBenchmarkKernel = stub_gemm_kernel();
    let b: PolyhedralBenchmarkKernel = stub_gemm_kernel();
    if (a).kernel_id != (b).kernel_id {
        println("FAIL stub_gemm_kernel");
        process_exit(1);
    }
    println("prod_compilers_polyhedral_stubs: PASSED");
}
