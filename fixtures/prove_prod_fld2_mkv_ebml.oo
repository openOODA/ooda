// # Product prove std/multimedia/mkv_ebml.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebml_id_header is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/mkv_ebml.oo.
//
// Beats:
//   1. Call ebml_id_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mkv_ebml: PASSED only if they match.

import "std/multimedia/mkv_ebml.oo";

pub fn main() {
    let mkv_ebml_mark: Int = 0;
    if mkv_ebml_mark != 0 {
        process_exit(1);
    }
    let mkv_ebml_a: Int = ebml_id_header();
    let mkv_ebml_b: Int = ebml_id_header();
    if mkv_ebml_a != mkv_ebml_b {
        println("FAIL ebml_id_header");
        process_exit(1);
    }
    println("prod_mkv_ebml: PASSED");
}
