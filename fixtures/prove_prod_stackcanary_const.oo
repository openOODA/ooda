// # Product prove std/sec/sys/stackcanary_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts canary_level_disabled is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/stackcanary_const.oo.
//
// Beats:
//   1. Call canary_level_disabled twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stackcanary_const: PASSED only if they match.

import "std/sec/sys/stackcanary_const.oo";

pub fn main() {
    let a = canary_level_disabled();
    let b = canary_level_disabled();
    if a != b {
        println("FAIL canary_level_disabled");
        process_exit(1);
    }
    println("prod_stackcanary_const: PASSED");
}
