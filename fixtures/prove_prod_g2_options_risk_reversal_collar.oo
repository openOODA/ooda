// # Product prove std/defi_derivatives/options_risk_reversal_collar.oo
//
// Logline: Fail-closed emit+gcc+run asserts rrc_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_risk_reversal_collar.oo.
//
// Beats:
//   1. Call rrc_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_options_risk_reversal_collar: PASSED only if they match.

import "std/defi_derivatives/options_risk_reversal_collar.oo";

pub fn main() {
    let options_risk_reversal_collar_mark: Int = 0;
    if options_risk_reversal_collar_mark != 0 {
        process_exit(1);
    }
    let a: Float = rrc_norm_pdf(0.0);
    let b: Float = rrc_norm_pdf(0.0);
    if a != b {
        println("FAIL rrc_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_options_risk_reversal_collar: PASSED");
}
