// # Product prove std/space_propulsion/rocket_nozzle_method_characteristics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_nozzle_method_characteristics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_nozzle_method_characteristics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rocket_nozzle_method_characteristics: PASSED only if they match.

import "std/space_propulsion/rocket_nozzle_method_characteristics.oo";

pub fn main() {
    let rocket_nozzle_method_characteristics_a = prandtl_meyer_nu(0.0, 0.0);
    let rocket_nozzle_method_characteristics_b = prandtl_meyer_nu(0.0, 0.0);
    if rocket_nozzle_method_characteristics_a != rocket_nozzle_method_characteristics_b {
        println("FAIL rocket_nozzle_method_characteristics");
        process_exit(1);
    }
    println("prod_ap_rocket_nozzle_method_characteristics: PASSED");
}
