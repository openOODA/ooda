// # Product prove std/game_engine/game_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/game_engine/game_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/game_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_game_stubs: PASSED only if they match.

import "std/game_engine/game_stubs.oo";

pub fn main() {
    let game_stubs_a = game_stub_render_clear();
    let game_stubs_b = game_stub_render_clear();
    if game_stubs_a != game_stubs_b {
        println("FAIL game_stubs");
        process_exit(1);
    }
    println("prod_ap_game_stubs: PASSED");
}
