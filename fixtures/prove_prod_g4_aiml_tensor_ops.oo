// # Product prove std/ai_ml/tensor_ops.oo
//
// Logline: Fail-closed verification that 1D and 2D tensor operations, reductions, and matrix multiplication are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_ops.oo.
//
// Beats:
//   1. Perform 1D tensor arithmetic (add, scale, dot, sum, norm).
//   2. Perform 2D tensor arithmetic, matrix transposition, and matrix multiplication.
//   3. Assert deterministic mathematical results.
//   4. Print prod_g4_aiml_tensor_ops: PASSED only if all match.

import "std/ai_ml/tensor_ops.oo";

pub fn main() {
    let mut d1: List[Float] = list_new();
    d1 = list_push(d1, 3.0);
    d1 = list_push(d1, 4.0);
    let t1: Tensor1D = Tensor1D { data: d1, size: 2 };

    let mut d2: List[Float] = list_new();
    d2 = list_push(d2, 1.0);
    d2 = list_push(d2, 2.0);
    let t2: Tensor1D = Tensor1D { data: d2, size: 2 };

    let sum_1d: Tensor1D = tensor_1d_add(t1, t2);
    if (sum_1d).size != 2 {
        println("FAIL tensor_1d_add size");
        process_exit(1);
    }

    let dot_val: Float = tensor_1d_dot(t1, t2);
    if dot_val != 11.0 {
        println("FAIL tensor_1d_dot");
        process_exit(1);
    }

    let norm_val: Float = tensor_1d_norm(t1);
    if norm_val != 5.0 {
        println("FAIL tensor_1d_norm");
        process_exit(1);
    }

    let total_sum: Float = tensor_1d_sum(t1);
    if total_sum != 7.0 {
        println("FAIL tensor_1d_sum");
        process_exit(1);
    }

    let mut m_data: List[Float] = list_new();
    m_data = list_push(m_data, 1.0);
    m_data = list_push(m_data, 2.0);
    m_data = list_push(m_data, 3.0);
    m_data = list_push(m_data, 4.0);
    let mat_a: Tensor2D = Tensor2D { data: m_data, rows: 2, cols: 2 };

    let mat_t: Tensor2D = tensor_2d_transpose(mat_a);
    if (mat_t).rows != 2 || (mat_t).cols != 2 {
        println("FAIL tensor_2d_transpose");
        process_exit(1);
    }

    let mat_prod: Tensor2D = tensor_2d_matmul(mat_a, mat_a);
    if (mat_prod).rows != 2 || (mat_prod).cols != 2 {
        println("FAIL tensor_2d_matmul");
        process_exit(1);
    }

    let flat: Tensor1D = tensor_2d_flatten(mat_a);
    if (flat).size != 4 {
        println("FAIL tensor_2d_flatten");
        process_exit(1);
    }

    println("prod_g4_aiml_tensor_ops: PASSED");
    process_exit(0);
}
