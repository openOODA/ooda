// # Product prove std/telecom_5g/channel_doppler_jakes.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_jakes_oscillator_phase value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_doppler_jakes.oo.
//
// Beats:
//   1. Call channel_jakes_oscillator_phase twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_channel_doppler_jakes: PASSED only if asserts hold.

import "std/telecom_5g/channel_doppler_jakes.oo";

pub fn main() {
    let channel_doppler_jakes_a: Float = channel_jakes_oscillator_phase(0, 8, 1.0, 0.0);
    let channel_doppler_jakes_b: Float = channel_jakes_oscillator_phase(0, 8, 1.0, 0.0);
    if channel_doppler_jakes_a != 0.0 {
        println("FAIL channel_jakes_oscillator_phase");
        process_exit(1);
    }
    if channel_doppler_jakes_a != channel_doppler_jakes_b {
        println("FAIL channel_jakes_oscillator_phase det");
        process_exit(1);
    }
    println("prod_channel_doppler_jakes: PASSED");
}
