// # Product prove std/compilers/elf_symbol.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_stb_local is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_symbol.oo.
//
// Beats:
//   1. Call elf_stb_local twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_symbol: PASSED only if they match.

import "std/compilers/elf_symbol.oo";

pub fn main() {
    let elf_symbol_mark: Int = 0;
    if elf_symbol_mark != 0 {
        process_exit(1);
    }
    let a: Int = elf_stb_local();
    let b: Int = elf_stb_local();
    if a != b {
        println("FAIL elf_stb_local");
        process_exit(1);
    }
    println("prod_elf_symbol: PASSED");
}
