// # Product prove std/graph_networks/dsdv_distance_vector.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsdv_table_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/dsdv_distance_vector.oo.
//
// Beats:
//   1. Call dsdv_table_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dsdv_distance_vector: PASSED only if they match.

import "std/graph_networks/dsdv_distance_vector.oo";

pub fn main() {
    let dsdv_distance_vector_mark: Int = 0;
    if dsdv_distance_vector_mark != 0 {
        process_exit(1);
    }
    let a: DsdvRoutingTable = dsdv_table_create(0);
    let b: DsdvRoutingTable = dsdv_table_create(0);
    if (a).local_id != (b).local_id {
        println("FAIL dsdv_table_create");
        process_exit(1);
    }
    println("prod_g2_dsdv_distance_vector: PASSED");
}
