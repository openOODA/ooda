// # Product prove std/graph_gnn/gnn_graph_transformer.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_transformer_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_graph_transformer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call graph_transformer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_graph_transformer: PASSED only if they match.

import "std/graph_gnn/gnn_graph_transformer.oo";

pub fn main() {
    let g2_oa: GraphTransformerConfig = graph_transformer_config_new(2, 2, 2, 1.0);
    let g2_ob: GraphTransformerConfig = graph_transformer_config_new(2, 2, 2, 1.0);
    let g2_a = (g2_oa).model_dim;
    let g2_b = (g2_ob).model_dim;
    if g2_a != g2_b {
        println("FAIL graph_transformer_config_new.model_dim");
        process_exit(1);
    }
    println("prod_g2_gnn_graph_transformer: PASSED");
}
