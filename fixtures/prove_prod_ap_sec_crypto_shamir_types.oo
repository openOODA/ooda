// # Product prove std/sec/crypto/shamir_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/shamir_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/shamir_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_shamir_types: PASSED only if they match.

import "std/sec/crypto/shamir_types.oo";

pub fn main() {
    let shamir_types_a = shamir_share_new(0, 0, 0);
    let shamir_types_b = shamir_share_new(0, 0, 0);
    let shamir_types_va = shamir_share_x(shamir_types_a);
    let shamir_types_vb = shamir_share_x(shamir_types_b);
    if shamir_types_va != shamir_types_vb {
        println("FAIL shamir_types");
        process_exit(1);
    }
    println("prod_ap_shamir_types: PASSED");
}
