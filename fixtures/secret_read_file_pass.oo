// # Allow a public read_file path
//
// Logline: A non-secret path may reach read_file while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public path instead.
//   3. Expect emit to allow the call.

// M141: non-secret path may read_file (emit path)
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let public = "/tmp/ok";
    let r = read_file(fs, public);
    println(1);
}
