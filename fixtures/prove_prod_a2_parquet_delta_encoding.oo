// # Product prove std/db_columnar/parquet_delta_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts delta_decode_zigzag is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_delta_encoding.oo.
//
// Beats:
//   1. Call delta_decode_zigzag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_delta_encoding: PASSED only if they match.

import "std/db_columnar/parquet_delta_encoding.oo";

pub fn main() {
    let parquet_delta_encoding_mark: Int = 0;
    if parquet_delta_encoding_mark != 0 {
        process_exit(1);
    }
    let a: Int = delta_decode_zigzag(0);
    let b: Int = delta_decode_zigzag(0);
    if a != b {
        println("FAIL delta_decode_zigzag");
        process_exit(1);
    }
    println("prod_parquet_delta_encoding: PASSED");
}
