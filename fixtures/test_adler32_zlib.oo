// # Adler-32 adversarial suite
//
// Logline: Computes RFC 1950 Adler-32 on a live buffer and checks s1/s2 modulo 65521.
//
// Setup: Pure. Imports adler32_zlib.oo. Run from ooda/.
//
// Beats:
//   1. Hash ASCII 123456789.
//   2. Recover s1 and s2 from the packed residue.
//   3. Prove empty input is 1.

import "std/hash/adler32_zlib.oo";

pub fn main() {
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    let s: String = "123456789";
    while i < bytes_len(s) {
        b = list_push(b, byte_at(s, i));
        i = i + 1;
    }
    let v: Int = adler32_zlib(b);
    let s1: Int = adler32_zlib_s1(b);
    let s2: Int = adler32_zlib_s2(b);
    if v != s2 * 65536 + s1 {
        println("FAIL pack");
        process_exit(1);
    }
    if s1 != 478 {
        println("FAIL s1");
        process_exit(1);
    }
    println("RFC 1950 s1/s2 mod 65521 on a live buffer");
    let empty: List[Int] = list_new();
    let z: Int = adler32_zlib(empty);
    if z != 1 {
        println("FAIL empty");
        process_exit(1);
    }
    let st: Result[Int, String] = adler32_zlib_stat(v);
    if st.is_err() {
        println("FAIL stat");
        process_exit(1);
    }
    println("SUITE PASSED");
    println("test_adler32_zlib: PASSED");
}
