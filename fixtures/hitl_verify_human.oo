// # Verify human sealed
//
// Logline: Call verify_human with EnvCap and FsCap and print approved or denied.
//
// Beats:
//   1. Take fs: &FsCap and env: &EnvCap on main.
//   2. Call verify_human(env, fs, "approve path A?").
//   3. Print approved on Ok and denied on Err.

// M165/ZT path A: verify_human requires &EnvCap + &FsCap (runtime sealed)
pub fn main(fs: &FsCap, env: &EnvCap) {
    let r: Result[String, String] = verify_human(env, fs, "approve path A?");
    if r.is_ok() {
        println("approved");
    } else {
        println("denied");
    }
}
