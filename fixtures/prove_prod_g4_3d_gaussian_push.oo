// # Product prove std/3d/gaussian_push.oo
//
// Logline: Fail-closed verification that GaussianCloud push and indexed splat getters are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_push.oo.
//
// Beats:
//   1. Create an empty GaussianCloud and push Gaussian3D splats.
//   2. Retrieve splats by index and verify opacity.
//   3. Print prod_g4_3d_gaussian_push: PASSED and exit 0.

import "std/3d/gaussian_push.oo";

pub fn main() {
    let c0: GaussianCloud = gaussian_cloud_new();
    let s0: Gaussian3D = gaussian3d_new(1, 2, 3, 50);
    let s1: Gaussian3D = gaussian3d_new(4, 5, 6, 80);

    let c1: GaussianCloud = gaussian_cloud_push(c0, s0);
    let c2: GaussianCloud = gaussian_cloud_push(c1, s1);

    let cnt: Int = gaussian_cloud_count(c2);
    if cnt != 2 {
        println("FAIL gaussian_cloud_push count");
        process_exit(1);
    }

    let g_ret0: Gaussian3D = gaussian_cloud_get(c2, 0);
    let op0: Int = gaussian3d_opacity(g_ret0);
    if op0 != 50 {
        println("FAIL gaussian_cloud_get idx 0");
        process_exit(1);
    }

    let g_ret1: Gaussian3D = gaussian_cloud_get(c2, 1);
    let op1: Int = gaussian3d_opacity(g_ret1);
    if op1 != 80 {
        println("FAIL gaussian_cloud_get idx 1");
        process_exit(1);
    }

    println("prod_g4_3d_gaussian_push: PASSED");
    process_exit(0);
}
