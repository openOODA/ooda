// # Product std/core crypto helpers prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/core/crypto.oo sha256 digest.
//
// Setup: Tree oodac emit-c. Calls ooda/std/core/crypto.oo. Destub none. No caps.
//
// Beats:
//   1. sha256("hello") is the RFC 6234 SHA-256 hex.
//   2. Digest length is 64.
//   3. Exit 1 on any miss. Print prod_core_crypto: PASSED only if all hold.

import "std/core/crypto.oo";

pub fn main() {
    let h: String = sha256("hello");
    if h != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        println("FAIL sha256 hello");
        process_exit(1);
    }
    if chars_len(h) != 64 {
        println("FAIL sha256 len");
        process_exit(1);
    }
    println("prod_core_crypto: PASSED");
}
