// # Two-function source for cursor hover
//
// Logline: Call add from main so hover can name add instead of the first fn.
//
// Setup: Read-only fixture. No I/O.
//
// Beats:
//   1. main calls add.
//   2. add returns the sum.
//   3. Keep names unique for the smoke.

pub fn main() {
    let x = add(1, 2);
    println(x);
}

pub fn add(a: Int, b: Int) -> Int {
    return a + b;
}
