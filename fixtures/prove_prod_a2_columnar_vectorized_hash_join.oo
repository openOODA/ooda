// # Product prove std/db_columnar/columnar_vectorized_hash_join.oo
//
// Logline: Fail-closed emit+gcc+run asserts hash_int_key is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_hash_join.oo.
//
// Beats:
//   1. Call hash_int_key twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_vectorized_hash_join: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_hash_join.oo";

pub fn main() {
    let columnar_vectorized_hash_join_mark: Int = 0;
    if columnar_vectorized_hash_join_mark != 0 {
        process_exit(1);
    }
    let a: Int = hash_int_key(0, 0);
    let b: Int = hash_int_key(0, 0);
    if a != b {
        println("FAIL hash_int_key");
        process_exit(1);
    }
    println("prod_columnar_vectorized_hash_join: PASSED");
}
