// # emit-x86 bump overflow honesty
//
// Logline: Concat two 2048-byte strings so emit-x86 must ERR x86 buf and emit no _start.
//
// Setup: chars_len(a)+chars_len(b)+1 is 4097. Cap is 4096.
//
// Beats:
//   1. Declare cat as return a plus b.
//   2. Call cat on two long strings.
//   3. emit-x86 must print ERR x86_emit x86 buf.

fn cat(a: String, b: String) -> String {
    return a + b;
}

pub fn main() {
    println(cat("", ""));
}
