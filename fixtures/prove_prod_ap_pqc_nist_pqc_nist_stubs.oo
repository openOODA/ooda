// # Product prove std/pqc_nist/pqc_nist_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pqc_nist/pqc_nist_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_nist_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pqc_nist_stubs: PASSED only if they match.

import "std/pqc_nist/pqc_nist_stubs.oo";

pub fn main() {
    let pqc_nist_stubs_a = pqc_hardware_capabilities_default();
    let pqc_nist_stubs_b = pqc_hardware_capabilities_default();
    if pqc_nist_stubs_a.supports_qrng != pqc_nist_stubs_b.supports_qrng {
        println("FAIL pqc_nist_stubs");
        process_exit(1);
    }
    println("prod_ap_pqc_nist_stubs: PASSED");
}
