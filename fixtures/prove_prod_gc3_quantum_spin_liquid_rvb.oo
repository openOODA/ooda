// # Product prove std/quantum_topological/quantum_spin_liquid_rvb.oo
//
// Logline: Fail-closed emit+gcc+run asserts rvb_overlap_loop_factor is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_spin_liquid_rvb.oo.
//
// Beats:
//   1. Call rvb_overlap_loop_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_spin_liquid_rvb: PASSED only if they match.

import "std/quantum_topological/quantum_spin_liquid_rvb.oo";

pub fn main() {
    let quantum_spin_liquid_rvb_mark: Int = 0;
    if quantum_spin_liquid_rvb_mark != 0 {
        process_exit(1);
    }
    let quantum_spin_liquid_rvb_a: Float = rvb_overlap_loop_factor(1);
    let quantum_spin_liquid_rvb_b: Float = rvb_overlap_loop_factor(1);
    if quantum_spin_liquid_rvb_a != quantum_spin_liquid_rvb_b {
        println("FAIL rvb_overlap_loop_factor");
        process_exit(1);
    }
    println("prod_quantum_spin_liquid_rvb: PASSED");
}
