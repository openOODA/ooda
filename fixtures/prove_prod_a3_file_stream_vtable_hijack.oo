// # Product prove std/exploit_analysis/file_stream_vtable_hijack.oo
//
// Logline: Fail-closed emit+gcc+run asserts io_file_plus_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/file_stream_vtable_hijack.oo.
//
// Beats:
//   1. Call io_file_plus_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_stream_vtable_hijack: PASSED only if they match.

import "std/exploit_analysis/file_stream_vtable_hijack.oo";

pub fn main() {
    let file_stream_vtable_hijack_mark: Int = 0;
    if file_stream_vtable_hijack_mark != 0 {
        process_exit(1);
    }
    let a: IoFilePlusStructure = io_file_plus_default(0);
    let b: IoFilePlusStructure = io_file_plus_default(0);
    if (a).file_address != (b).file_address {
        println("FAIL io_file_plus_default");
        process_exit(1);
    }
    println("prod_file_stream_vtable_hijack: PASSED");
}
