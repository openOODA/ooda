// # Product prove std/lidar_perception/point_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts lidar_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/point_types.oo.
//
// Beats:
//   1. Call lidar_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_point_types: PASSED only if they match.

import "std/lidar_perception/point_types.oo";

pub fn main() {
    let point_types_mark: Int = 0;
    if point_types_mark != 0 {
        process_exit(1);
    }
    let a: LidarPoint = lidar_point_new(0, 0, 0);
    let b: LidarPoint = lidar_point_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL lidar_point_new");
        process_exit(1);
    }
    println("prod_point_types: PASSED");
}
