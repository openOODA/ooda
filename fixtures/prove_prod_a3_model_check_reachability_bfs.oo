// # Product prove std/formal_verif/model_check_reachability_bfs.oo
//
// Logline: Fail-closed emit+gcc+run asserts reachability_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_reachability_bfs.oo.
//
// Beats:
//   1. Call reachability_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_model_check_reachability_bfs: PASSED only if they match.

import "std/formal_verif/model_check_reachability_bfs.oo";

pub fn main() {
    let model_check_reachability_bfs_mark: Int = 0;
    if model_check_reachability_bfs_mark != 0 {
        process_exit(1);
    }
    let a: ReachabilityNode = reachability_node_new(0, true, list_new());
    let b: ReachabilityNode = reachability_node_new(0, true, list_new());
    if (a).state_id != (b).state_id {
        println("FAIL reachability_node_new");
        process_exit(1);
    }
    println("prod_model_check_reachability_bfs: PASSED");
}
