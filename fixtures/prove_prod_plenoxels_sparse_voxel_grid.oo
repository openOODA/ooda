// # Product prove std/nerf_3dgs/plenoxels_sparse_voxel_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts plenoxel_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/plenoxels_sparse_voxel_grid.oo.
//
// Beats:
//   1. Call plenoxel_config_new twice with the same args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_plenoxels_sparse_voxel_grid: PASSED only if they match.

import "std/nerf_3dgs/plenoxels_sparse_voxel_grid.oo";

pub fn main() {
    let plenoxels_sparse_voxel_grid_mark: Int = 0;
    if plenoxels_sparse_voxel_grid_mark != 0 {
        process_exit(1);
    }
    let a: PlenoxelGridConfig = plenoxel_config_new(0);
    let b: PlenoxelGridConfig = plenoxel_config_new(0);
    if (a).res != (b).res {
        println("FAIL plenoxel_config_new");
        process_exit(1);
    }
    println("prod_plenoxels_sparse_voxel_grid: PASSED");
}
