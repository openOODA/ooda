// # Product prove std/robotics_auv/robotics_auv_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts auv_hal_thruster_pwm_write_stub is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/robotics_auv_stubs.oo.
//
// Beats:
//   1. Call auv_hal_thruster_pwm_write_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_robotics_auv_stubs: PASSED only if they match.

import "std/robotics_auv/robotics_auv_stubs.oo";

pub fn main() {
    let robotics_auv_stubs_mark: Int = 0;
    if robotics_auv_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = auv_hal_thruster_pwm_write_stub(0, 0.0, true);
    let b: Int = auv_hal_thruster_pwm_write_stub(0, 0.0, true);
    if a != b {
        println("FAIL auv_hal_thruster_pwm_write_stub");
        process_exit(1);
    }
    println("prod_g2_robotics_auv_stubs: PASSED");
}
