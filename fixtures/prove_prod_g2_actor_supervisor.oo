// # Product prove std/actor/supervisor.oo
//
// Logline: Fail-closed emit+gcc+run asserts supervisor_child_count is a real value.
//
// Setup: Isolated emit-c. Imports std/actor/supervisor.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call supervisor_child_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_supervisor: PASSED only if they match.

import "std/actor/supervisor.oo";

pub fn main() {
    let g2_oa = supervisor_new("x", "x", 2);
    let g2_ob = supervisor_new("x", "x", 2);
    let g2_a = supervisor_child_count(g2_oa);
    let g2_b = supervisor_child_count(g2_ob);
    if g2_a != g2_b {
        println("FAIL supervisor_child_count");
        process_exit(1);
    }
    println("prod_g2_supervisor: PASSED");
}
