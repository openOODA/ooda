// # Product prove std/gis_topo/geospatial_transform_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts transform_wgs84_to_utm is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geospatial_transform_pipeline.oo.
//
// Beats:
//   1. Call transform_wgs84_to_utm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geospatial_transform_pipeline: PASSED only if they match.

import "std/gis_topo/geospatial_transform_pipeline.oo";

pub fn main() {
    let a: TransformPipelineResult = transform_wgs84_to_utm(0.0, 0.0, 0.0);
    let b: TransformPipelineResult = transform_wgs84_to_utm(0.0, 0.0, 0.0);
    if a.success != b.success {
        println("FAIL transform_wgs84_to_utm");
        process_exit(1);
    }
    println("prod_geospatial_transform_pipeline: PASSED");
}
