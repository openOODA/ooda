// # Product prove std/astro_advanced/deep_space_optical_comm.oo
//
// Logline: Fail-closed emit+gcc+run asserts optcomm_wavelength_nm is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/deep_space_optical_comm.oo.
//
// Beats:
//   1. Call optcomm_wavelength_nm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_deep_space_optical_comm: PASSED only if they match.

import "std/astro_advanced/deep_space_optical_comm.oo";

pub fn main() {
    let a = optcomm_wavelength_nm();
    let b = optcomm_wavelength_nm();
    if a != b {
        println("FAIL optcomm_wavelength_nm");
        process_exit(1);
    }
    println("prod_deep_space_optical_comm: PASSED");
}
