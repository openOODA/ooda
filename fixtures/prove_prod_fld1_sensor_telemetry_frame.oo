// # Product prove std/industrial_iot/sensor_telemetry_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts sensor_telemetry_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/sensor_telemetry_frame.oo.
//
// Beats:
//   1. Call sensor_telemetry_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sensor_telemetry_frame: PASSED only if they match.

import "std/industrial_iot/sensor_telemetry_frame.oo";

pub fn main() {
    let sensor_telemetry_frame_mark: Int = 0;
    if sensor_telemetry_frame_mark != 0 {
        process_exit(1);
    }
    let sensor_telemetry_frame_a: Int = sensor_telemetry_checksum(1, 1, 1, 1);
    let sensor_telemetry_frame_b: Int = sensor_telemetry_checksum(1, 1, 1, 1);
    if sensor_telemetry_frame_a != sensor_telemetry_frame_b {
        println("FAIL sensor_telemetry_checksum");
        process_exit(1);
    }
    println("prod_sensor_telemetry_frame: PASSED");
}
