// # Product prove std/graph_networks/minhash_lsh_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsh_index_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/minhash_lsh_index.oo.
//
// Beats:
//   1. Call lsh_index_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_minhash_lsh_index: PASSED only if they match.

import "std/graph_networks/minhash_lsh_index.oo";

pub fn main() {
    let minhash_lsh_index_mark: Int = 0;
    if minhash_lsh_index_mark != 0 {
        process_exit(1);
    }
    let minhash_lsh_index_a = lsh_index_create(1, 1);
    let minhash_lsh_index_b = lsh_index_create(1, 1);
    if (minhash_lsh_index_a).num_bands != (minhash_lsh_index_b).num_bands {
        println("FAIL lsh_index_create");
        process_exit(1);
    }
    println("prod_minhash_lsh_index: PASSED");
}
