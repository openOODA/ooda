// # Product prove std/fin/hft_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_engine_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_engine.oo.
//
// Beats:
//   1. Call hft_engine_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_engine: PASSED only if they match.

import "std/fin/hft_engine.oo";

pub fn main() {
    let a: HftEngine = hft_engine_init("x", 0, 0, 0);
    let b: HftEngine = hft_engine_init("x", 0, 0, 0);
    if (a).max_position != (b).max_position {
        println("FAIL hft_engine_init");
        process_exit(1);
    }
    println("prod_hft_engine: PASSED");
}
