// # Product prove std/media_dsp/bmp_dib_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts bmp_calculate_row_stride is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/bmp_dib_header.oo.
//
// Beats:
//   1. Call bmp_calculate_row_stride twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bmp_dib_header: PASSED only if they match.

import "std/media_dsp/bmp_dib_header.oo";

pub fn main() {
    let bmp_dib_header_mark: Int = 0;
    if bmp_dib_header_mark != 0 {
        process_exit(1);
    }
    let bmp_dib_header_a: Int = bmp_calculate_row_stride(1, 1);
    let bmp_dib_header_b: Int = bmp_calculate_row_stride(1, 1);
    if bmp_dib_header_a != bmp_dib_header_b {
        println("FAIL bmp_calculate_row_stride");
        process_exit(1);
    }
    println("prod_bmp_dib_header: PASSED");
}
