// # Product prove std/fin/orderbook_engine.oo
//
// Logline: Fail-closed verification that financial order book limit matching operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_engine.oo.
//
// Beats:
//   1. Initialize order book and insert resting limit orders.
//   2. Match incoming crossing limit order against resting book queue.
//   3. Assert deterministic trade execution and residual book updates.
//   4. Print prod_g4_fin_orderbook_engine: PASSED and exit 0.

import "std/fin/orderbook_engine.oo";

pub fn main() {
    let probe1: Int = orderbook_engine_probe();
    let probe2: Int = orderbook_engine_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL orderbook_engine_probe");
        process_exit(1);
    }

    let ob1: OrderBook = orderbook_new();
    let ob2: OrderBook = orderbook_new();

    let ask1: LimitOrder = limit_order_make(1, 100, 10, 0);
    let ask2: LimitOrder = limit_order_make(1, 100, 10, 0);

    let book_with_ask1: OrderBook = orderbook_add_order(ob1, ask1);
    let book_with_ask2: OrderBook = orderbook_add_order(ob2, ask2);

    let buy1: LimitOrder = limit_order_make(2, 105, 6, 1);
    let buy2: LimitOrder = limit_order_make(2, 105, 6, 1);

    let matched1: OrderBook = orderbook_match_limit_order(book_with_ask1, buy1);
    let matched2: OrderBook = orderbook_match_limit_order(book_with_ask2, buy2);

    if (matched1).last_trade_price != (matched2).last_trade_price || (matched1).last_trade_price != 100 {
        println("FAIL orderbook_match_limit_order last_trade_price");
        process_exit(1);
    }
    if (matched1).ask0_qty != (matched2).ask0_qty || (matched1).ask0_qty != 4 {
        println("FAIL orderbook_match_limit_order remaining ask qty");
        process_exit(1);
    }

    println("prod_g4_fin_orderbook_engine: PASSED");
    process_exit(0);
}
