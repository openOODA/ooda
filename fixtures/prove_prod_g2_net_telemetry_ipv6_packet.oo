// # Product prove std/net_telemetry/ipv6_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts ipv6_address_to_string is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/ipv6_packet.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ipv6_address_to_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ipv6_packet: PASSED only if they match.

import "std/net_telemetry/ipv6_packet.oo";

pub fn main() {
    let g2_oa: Ipv6Address = Ipv6Address { w0: 2, w1: 2, w2: 2, w3: 2, w4: 2, w5: 2, w6: 2, w7: 2 };
    let g2_ob: Ipv6Address = Ipv6Address { w0: 2, w1: 2, w2: 2, w3: 2, w4: 2, w5: 2, w6: 2, w7: 2 };
    let g2_a = ipv6_address_to_string(&g2_oa);
    let g2_b = ipv6_address_to_string(&g2_ob);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL ipv6_address_to_string");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL ipv6_address_to_string");
        process_exit(1);
    }
    println("prod_g2_ipv6_packet: PASSED");
}
