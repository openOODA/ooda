// # Product prove std/sec/crypto/sha3_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha3_state_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/sha3_types.oo.
//
// Beats:
//   1. Call sha3_state_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha3_types: PASSED only if they match.

import "std/sec/crypto/sha3_types.oo";

pub fn main() {
    let obj = sha3_state_new(0, 0, 0);
    let a = sha3_state_rate(obj);
    let b = sha3_state_rate(obj);
    if a != b {
        println("FAIL sha3_state_rate");
        process_exit(1);
    }
    println("prod_sha3_types: PASSED");
}
