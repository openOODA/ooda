// # Product prove std/simd/simd_half_float.oo
//
// Logline: Fail-closed emit+gcc+run asserts half_to_bits is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_half_float.oo.
//
// Beats:
//   1. Call half_to_bits twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_half_float: PASSED only if they match.

import "std/simd/simd_half_float.oo";

pub fn main() {
    let obj = half_from_bits(0);
    let a = half_to_bits(obj);
    let b = half_to_bits(obj);
    if a != b {
        println("FAIL half_to_bits");
        process_exit(1);
    }
    println("prod_simd_half_float: PASSED");
}
