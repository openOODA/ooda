// # Product prove std/robotics_ros2/ros2_service_client.oo
//
// Logline: Fail-closed emit+gcc+run asserts service_pending_request_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_service_client.oo.
//
// Beats:
//   1. Call service_pending_request_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros2_service_client: PASSED only if they match.

import "std/robotics_ros2/ros2_service_client.oo";

pub fn main() {
    let ros2_service_client_mark: Int = 0;
    if ros2_service_client_mark != 0 {
        process_exit(1);
    }
    let ros2_service_client_a = service_pending_request_new(1, 1.0);
    let ros2_service_client_b = service_pending_request_new(1, 1.0);
    if (ros2_service_client_a).sequence_id != (ros2_service_client_b).sequence_id {
        println("FAIL service_pending_request_new");
        process_exit(1);
    }
    println("prod_ros2_service_client: PASSED");
}
