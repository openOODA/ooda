// # Product prove std/exploit_analysis/format_string_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts format_calculate_single_byte_write is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/format_string_analyzer.oo.
//
// Beats:
//   1. Call format_calculate_single_byte_write twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_format_string_analyzer: PASSED only if they match.

import "std/exploit_analysis/format_string_analyzer.oo";
import "std/str.oo";

pub fn main() {
    let format_string_analyzer_mark: Int = 0;
    if format_string_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: String = format_calculate_single_byte_write(0, 0, 0, 0);
    let b: String = format_calculate_single_byte_write(0, 0, 0, 0);
    if str_eq(a, b) == false {
        println("FAIL format_calculate_single_byte_write");
        process_exit(1);
    }
    println("prod_g2_format_string_analyzer: PASSED");
}
