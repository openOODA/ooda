// # Product prove std/hft_alpha/mm_latency_arbitrage_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_latency_arbitrage_detector_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_latency_arbitrage_detector.oo.
//
// Beats:
//   1. Call mm_latency_arbitrage_detector_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_latency_arbitrage_detector: PASSED only if they match.

import "std/hft_alpha/mm_latency_arbitrage_detector.oo";

pub fn main() {
    let a = mm_latency_arbitrage_detector_probe();
    let b = mm_latency_arbitrage_detector_probe();
    if a != b {
        println("FAIL mm_latency_arbitrage_detector_probe");
        process_exit(1);
    }
    println("prod_mm_latency_arbitrage_detector: PASSED");
}
