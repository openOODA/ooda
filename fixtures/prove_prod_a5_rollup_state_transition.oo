// # Product prove std/zk_rollup/rollup_state_transition.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_tx_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_state_transition.oo.
//
// Beats:
//   1. Call rollup_tx_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_state_transition: PASSED only if they match.

import "std/zk_rollup/rollup_state_transition.oo";

pub fn main() {
    let rollup_state_transition_mark: Int = 0;
    if rollup_state_transition_mark != 0 {
        process_exit(1);
    }
    let a: RollupTx = rollup_tx_new(0, 0, 0, 0, 0);
    let b: RollupTx = rollup_tx_new(0, 0, 0, 0, 0);
    if (a).sender_account != (b).sender_account {
        println("FAIL rollup_tx_new");
        process_exit(1);
    }
    println("prod_rollup_state_transition: PASSED");
}
