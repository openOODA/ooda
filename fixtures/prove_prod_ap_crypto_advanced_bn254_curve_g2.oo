// # Product prove std/crypto_advanced/bn254_curve_g2.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/bn254_curve_g2.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_curve_g2.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_bn254_curve_g2: PASSED only if they match.

import "std/crypto_advanced/bn254_curve_g2.oo";

pub fn main() {
    let bn254_curve_g2_a = bn254_g2_infinity(0);
    let bn254_curve_g2_b = bn254_g2_infinity(0);
    if bn254_curve_g2_a.is_infinity != bn254_curve_g2_b.is_infinity {
        println("FAIL bn254_curve_g2");
        process_exit(1);
    }
    println("prod_ap_bn254_curve_g2: PASSED");
}
