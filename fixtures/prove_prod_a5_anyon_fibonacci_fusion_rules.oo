// # Product prove std/quantum_topological/anyon_fibonacci_fusion_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts fibonacci_number is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_fibonacci_fusion_rules.oo.
//
// Beats:
//   1. Call fibonacci_number twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anyon_fibonacci_fusion_rules: PASSED only if they match.

import "std/quantum_topological/anyon_fibonacci_fusion_rules.oo";

pub fn main() {
    let anyon_fibonacci_fusion_rules_mark: Int = 0;
    if anyon_fibonacci_fusion_rules_mark != 0 {
        process_exit(1);
    }
    let a: Int = fibonacci_number(0);
    let b: Int = fibonacci_number(0);
    if a != b {
        println("FAIL fibonacci_number");
        process_exit(1);
    }
    println("prod_anyon_fibonacci_fusion_rules: PASSED");
}
