// # Byte slice owned copy
//
// Logline: Print bytes_len, byte_slice, byte_at, and bytes_eq on "AB".
//
// Beats:
//   1. Print bytes_len of "AB".
//   2. Slice [0,1) and read its first byte.
//   3. Compare the slice to "A" and "B".

// M163 path A: bytes_len + byte_slice owned copy (not &str borrow)
// Avoid intermediate let of byte_slice (emit residual SEGV on some pure hosts).
pub fn main() {
    println(bytes_len("AB"));
    println(byte_slice("AB", 0, 1));
    println(byte_at(byte_slice("AB", 0, 1), 0));
    println(bytes_eq(byte_slice("AB", 0, 1), "A"));
    println(bytes_eq(byte_slice("AB", 0, 1), "B"));
}
