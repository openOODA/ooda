// M163 path A: bytes_len + byte_slice owned copy (not &str borrow)
pub fn main() {
    let s = "AB";
    // byte length 2 (not char semantics beyond ASCII)
    println(bytes_len(s));
    // [0,1) → "A"; raw byte 65
    let a = byte_slice(s, 0, 1);
    println(a);
    println(byte_at(a, 0));
    // equality of owned byte views
    println(bytes_eq(a, "A"));
    println(bytes_eq(a, "B"));
}
