// # emit-x86 bound int plus
//
// Logline: Bind a to 1 and b to 2 and print a plus b so emit-x86 can lower bound ALU to 3.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. Honesty lock stays x86_int_add_bind.
//
// Beats:
//   1. Bind a to 1 and b to 2.
//   2. Print a plus b.
//   3. Expect 3, not digit-strcat 12.

pub fn main() {
    let a = 1;
    let b = 2;
    println(a + b);
}
