// # Product prove std/tda_topology/sublevel_set_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts sublevel_count_active is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sublevel_set_filtration.oo.
//
// Beats:
//   1. Call sublevel_count_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sublevel_set_filtration: PASSED only if they match.

import "std/tda_topology/sublevel_set_filtration.oo";

pub fn main() {
    let sublevel_set_filtration_mark: Int = 0;
    if sublevel_set_filtration_mark != 0 {
        process_exit(1);
    }
    let sublevel_set_filtration_obj: SublevelFiltration = sublevel_filtration_new();
    let sublevel_set_filtration_a: Int = sublevel_count_active(&sublevel_set_filtration_obj, 1.0);
    let sublevel_set_filtration_b: Int = sublevel_count_active(&sublevel_set_filtration_obj, 1.0);
    if sublevel_set_filtration_a != sublevel_set_filtration_b {
        println("FAIL sublevel_count_active");
        process_exit(1);
    }
    println("prod_sublevel_set_filtration: PASSED");
}
