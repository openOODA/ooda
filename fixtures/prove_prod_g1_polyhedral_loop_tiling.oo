// # Product prove std/compilers_polyhedral/polyhedral_loop_tiling.oo
//
// Logline: Fail-closed emit+gcc+run asserts tile_dimension_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_loop_tiling.oo.
//
// Beats:
//   1. Call tile_dimension_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_loop_tiling: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_loop_tiling.oo";

pub fn main() {
    let a: TileDimension = tile_dimension_new(0, 0);
    let b: TileDimension = tile_dimension_new(0, 0);
    if a.dim_index != b.dim_index {
        println("FAIL tile_dimension_new");
        process_exit(1);
    }
    println("prod_polyhedral_loop_tiling: PASSED");
}
