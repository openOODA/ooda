// # Product prove std/physics_advanced/navier_stokes_boundary_conditions.oo
//
// Logline: Fail-closed emit+gcc+run asserts poiseuille_inflow_u is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/navier_stokes_boundary_conditions.oo.
//
// Beats:
//   1. Call poiseuille_inflow_u twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_navier_stokes_boundary_conditions: PASSED only if they match.

import "std/physics_advanced/navier_stokes_boundary_conditions.oo";

pub fn main() {
    let navier_stokes_boundary_conditions_mark: Int = 0;
    if navier_stokes_boundary_conditions_mark != 0 {
        process_exit(1);
    }
    let a: Float = poiseuille_inflow_u(0.0, 0.0, 0.0);
    let b: Float = poiseuille_inflow_u(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL poiseuille_inflow_u");
        process_exit(1);
    }
    println("prod_navier_stokes_boundary_conditions: PASSED");
}
