// # Product prove std/multimedia/audio_mixer.oo
//
// Logline: Fail-closed emit+gcc+run asserts mixer_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/audio_mixer.oo.
//
// Beats:
//   1. Call mixer_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_audio_mixer: PASSED only if they match.

import "std/multimedia/audio_mixer.oo";

pub fn main() {
    let audio_mixer_mark: Int = 0;
    if audio_mixer_mark != 0 {
        process_exit(1);
    }
    let a: Float = mixer_pi();
    let b: Float = mixer_pi();
    if a != b {
        println("FAIL mixer_pi");
        process_exit(1);
    }
    println("prod_g2_audio_mixer: PASSED");
}
