// # Product prove std/physics_advanced/airfoil_lift_drag_polar.oo
//
// Logline: Fail-closed emit+gcc+run asserts lift_to_drag_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/airfoil_lift_drag_polar.oo.
//
// Beats:
//   1. Call lift_to_drag_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_airfoil_lift_drag_polar: PASSED only if they match.

import "std/physics_advanced/airfoil_lift_drag_polar.oo";

pub fn main() {
    let airfoil_lift_drag_polar_mark: Int = 0;
    if airfoil_lift_drag_polar_mark != 0 {
        process_exit(1);
    }
    let a: Float = lift_to_drag_ratio(0.0, 0.0);
    let b: Float = lift_to_drag_ratio(0.0, 0.0);
    if a != b {
        println("FAIL lift_to_drag_ratio");
        process_exit(1);
    }
    println("prod_airfoil_lift_drag_polar: PASSED");
}
