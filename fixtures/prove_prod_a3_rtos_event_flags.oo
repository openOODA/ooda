// # Product prove std/embedded_hal/rtos_event_flags.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_event_group_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_event_flags.oo.
//
// Beats:
//   1. Call rtos_event_group_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtos_event_flags: PASSED only if they match.

import "std/embedded_hal/rtos_event_flags.oo";

pub fn main() {
    let rtos_event_flags_mark: Int = 0;
    if rtos_event_flags_mark != 0 {
        process_exit(1);
    }
    let a: RtosEventGroup = rtos_event_group_new(0, 0);
    let b: RtosEventGroup = rtos_event_group_new(0, 0);
    if (a).group_id != (b).group_id {
        println("FAIL rtos_event_group_new");
        process_exit(1);
    }
    println("prod_rtos_event_flags: PASSED");
}
