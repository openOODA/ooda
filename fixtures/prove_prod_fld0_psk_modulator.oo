// # Product prove std/telecom/psk_modulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts psk_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/psk_modulator.oo.
//
// Beats:
//   1. Call psk_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_psk_modulator: PASSED only if they match.

import "std/telecom/psk_modulator.oo";

pub fn main() {
    let psk_modulator_mark: Int = 0;
    if psk_modulator_mark != 0 {
        process_exit(1);
    }
    let psk_modulator_a: Float = psk_pi();
    let psk_modulator_b: Float = psk_pi();
    if psk_modulator_a != psk_modulator_b {
        println("FAIL psk_pi");
        process_exit(1);
    }
    println("prod_psk_modulator: PASSED");
}
