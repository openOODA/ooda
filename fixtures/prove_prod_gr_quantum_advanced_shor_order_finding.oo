// # Product prove std/quantum_advanced/shor_order_finding.oo
//
// Logline: Fail-closed emit+gcc+run asserts bit_length is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_order_finding.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call bit_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_shor_order_finding: PASSED only if they match.

import "std/quantum_advanced/shor_order_finding.oo";

pub fn main() {
    let g0_a = bit_length(0);
    let g0_b = bit_length(0);
    if g0_a != g0_b {
        println("FAIL bit_length");
        process_exit(1);
    }
    println("prod_gr_shor_order_finding: PASSED");
}
