// # Product prove std/auto_mpc_control/vehicle_four_wheel_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts four_wheel_geometry_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_four_wheel_dynamics.oo.
//
// Beats:
//   1. Call four_wheel_geometry_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vehicle_four_wheel_dynamics: PASSED only if they match.

import "std/auto_mpc_control/vehicle_four_wheel_dynamics.oo";

pub fn main() {
    let vehicle_four_wheel_dynamics_mark: Int = 0;
    if vehicle_four_wheel_dynamics_mark != 0 {
        process_exit(1);
    }
    let vehicle_four_wheel_dynamics_a: FourWheelGeometry = four_wheel_geometry_default();
    let vehicle_four_wheel_dynamics_b: FourWheelGeometry = four_wheel_geometry_default();
    if (vehicle_four_wheel_dynamics_a).mass != (vehicle_four_wheel_dynamics_b).mass {
        println("FAIL four_wheel_geometry_default");
        process_exit(1);
    }
    println("prod_vehicle_four_wheel_dynamics: PASSED");
}
