// # Product prove std/astro_advanced/attitude_control_moment_gyro.oo
//
// Logline: Fail-closed emit+gcc+run asserts cmg_gimbal_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_control_moment_gyro.oo.
//
// Beats:
//   1. Call cmg_gimbal_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_control_moment_gyro: PASSED only if they match.

import "std/astro_advanced/attitude_control_moment_gyro.oo";

pub fn main() {
    let a = cmg_gimbal_rate(0);
    let b = cmg_gimbal_rate(0);
    if a != b {
        println("FAIL cmg_gimbal_rate");
        process_exit(1);
    }
    println("prod_attitude_control_moment_gyro: PASSED");
}
