// # Product prove std/graph_gnn/kg_distmult_bilinear.oo
//
// Logline: Fail-closed emit+gcc+run asserts distmult_probability is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_distmult_bilinear.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call distmult_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_distmult_bilinear: PASSED only if they match.

import "std/graph_gnn/kg_distmult_bilinear.oo";

pub fn main() {
    let g2_a = distmult_probability(1.0);
    let g2_b = distmult_probability(1.0);
    if g2_a != g2_b {
        println("FAIL distmult_probability");
        process_exit(1);
    }
    println("prod_g2_kg_distmult_bilinear: PASSED");
}
