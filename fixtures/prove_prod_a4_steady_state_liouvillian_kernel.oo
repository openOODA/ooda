// # Product prove std/quantum_open_systems/steady_state_liouvillian_kernel.oo
//
// Logline: Fail-closed emit+gcc+run asserts solve_steady_state_qubit is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/steady_state_liouvillian_kernel.oo.
//
// Beats:
//   1. Call solve_steady_state_qubit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_steady_state_liouvillian_kernel: PASSED only if they match.

import "std/quantum_open_systems/steady_state_liouvillian_kernel.oo";

pub fn main() {
    let steady_state_liouvillian_kernel_mark: Int = 0;
    if steady_state_liouvillian_kernel_mark != 0 {
        process_exit(1);
    }
    let a: SteadyStateResult2x2 = solve_steady_state_qubit(0.0, 0.0, 0.0, 0.0);
    let b: SteadyStateResult2x2 = solve_steady_state_qubit(0.0, 0.0, 0.0, 0.0);
    if (a).pop_0 != (b).pop_0 {
        println("FAIL solve_steady_state_qubit");
        process_exit(1);
    }
    println("prod_steady_state_liouvillian_kernel: PASSED");
}
