// # Product hash SHA-512 prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/sha512.oo.
//
// Setup: Product std/hash/sha512.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty digest is the FIPS 180-4 vector.
//   2. Length is 128.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/sha512.oo";

pub fn main() {
    let h: String = sha512("");
    println(h);
    if h != "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" {
        println("FAIL sha512 empty");
        process_exit(1);
    }
    let n: Int = chars_len(h);
    if n != 128 {
        println("FAIL sha512 len");
        process_exit(1);
    }
    println("prod_sha512: PASSED");
}
