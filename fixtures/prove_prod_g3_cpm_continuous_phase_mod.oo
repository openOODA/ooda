// # Product prove std/satellite_dvb/cpm_continuous_phase_mod.oo
//
// Logline: Fail-closed emit+gcc+run asserts cpm_laurent_principal_pulse is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/cpm_continuous_phase_mod.oo.
//
// Beats:
//   1. Call cpm_laurent_principal_pulse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cpm_continuous_phase_mod: PASSED only if they match.

import "std/satellite_dvb/cpm_continuous_phase_mod.oo";

pub fn main() {
    let cpm_continuous_phase_mod_mark: Int = 0;
    if cpm_continuous_phase_mod_mark != 0 {
        process_exit(1);
    }
    let a: Float = cpm_laurent_principal_pulse(0.0, 0);
    let b: Float = cpm_laurent_principal_pulse(0.0, 0);
    if a != b {
        println("FAIL cpm_laurent_principal_pulse");
        process_exit(1);
    }
    println("prod_cpm_continuous_phase_mod: PASSED");
}
