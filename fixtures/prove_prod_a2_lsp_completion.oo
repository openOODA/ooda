// # Product prove std/compilers/lsp_completion.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsp_item_kind_text is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_completion.oo.
//
// Beats:
//   1. Call lsp_item_kind_text twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsp_completion: PASSED only if they match.

import "std/compilers/lsp_completion.oo";

pub fn main() {
    let lsp_completion_mark: Int = 0;
    if lsp_completion_mark != 0 {
        process_exit(1);
    }
    let a: Int = lsp_item_kind_text();
    let b: Int = lsp_item_kind_text();
    if a != b {
        println("FAIL lsp_item_kind_text");
        process_exit(1);
    }
    println("prod_lsp_completion: PASSED");
}
