// # Product prove std/astrodynamics/coordinate_eci_ecef.oo
//
// Logline: Fail-closed emit+gcc+run asserts earth_omega_nano is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/coordinate_eci_ecef.oo.
//
// Beats:
//   1. Call earth_omega_nano twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_coordinate_eci_ecef: PASSED only if they match.

import "std/astrodynamics/coordinate_eci_ecef.oo";

pub fn main() {
    let coordinate_eci_ecef_mark: Int = 0;
    if coordinate_eci_ecef_mark != 0 {
        process_exit(1);
    }
    let a: Int = earth_omega_nano();
    let b: Int = earth_omega_nano();
    if a != b {
        println("FAIL earth_omega_nano");
        process_exit(1);
    }
    println("prod_coordinate_eci_ecef: PASSED");
}
