// # Product prove std/iot_scada/profinet_io_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts profinet_rt_is_data_valid is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/profinet_io_frame.oo.
//
// Beats:
//   1. Call profinet_rt_is_data_valid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_profinet_io_frame: PASSED only if they match.

import "std/iot_scada/profinet_io_frame.oo";

pub fn main() {
    let profinet_io_frame_mark: Int = 0;
    if profinet_io_frame_mark != 0 {
        process_exit(1);
    }
    let profinet_io_frame_obj: ProfinetRtFrame = profinet_rt_frame_new(1, 1, 1);
    let profinet_io_frame_a: Bool = profinet_rt_is_data_valid(&profinet_io_frame_obj);
    let profinet_io_frame_b: Bool = profinet_rt_is_data_valid(&profinet_io_frame_obj);
    if profinet_io_frame_a != profinet_io_frame_b {
        println("FAIL profinet_rt_is_data_valid");
        process_exit(1);
    }
    println("prod_profinet_io_frame: PASSED");
}
