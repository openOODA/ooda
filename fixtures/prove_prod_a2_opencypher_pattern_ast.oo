// # Product prove std/db_graph/opencypher_pattern_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_hop_range_exact is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_pattern_ast.oo.
//
// Beats:
//   1. Call cypher_hop_range_exact twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_pattern_ast: PASSED only if they match.

import "std/db_graph/opencypher_pattern_ast.oo";

pub fn main() {
    let opencypher_pattern_ast_mark: Int = 0;
    if opencypher_pattern_ast_mark != 0 {
        process_exit(1);
    }
    let a: CypherHopRange = cypher_hop_range_exact(0);
    let b: CypherHopRange = cypher_hop_range_exact(0);
    if (a).min_hops != (b).min_hops {
        println("FAIL cypher_hop_range_exact");
        process_exit(1);
    }
    println("prod_opencypher_pattern_ast: PASSED");
}
