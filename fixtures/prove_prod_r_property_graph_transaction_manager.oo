// # Product prove std/db_graph/property_graph_transaction_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_tx_manager_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_transaction_manager.oo.
//
// Beats:
//   1. Call graph_tx_manager_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_property_graph_transaction_manager: PASSED only if asserts hold.

import "std/db_graph/property_graph_transaction_manager.oo";

pub fn main() {
    let property_graph_transaction_manager: GraphTxManager = graph_tx_manager_new();
    let property_graph_transaction_manager_b: GraphTxManager = graph_tx_manager_new();
    if (property_graph_transaction_manager).next_tx_id != 1 {
        println("FAIL graph_tx_manager_new next_tx_id");
        process_exit(1);
    }
    if (property_graph_transaction_manager).next_tx_id != (property_graph_transaction_manager_b).next_tx_id {
        println("FAIL graph_tx_manager_new det");
        process_exit(1);
    }
    println("prod_property_graph_transaction_manager: PASSED");
}
