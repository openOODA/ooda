// # Const integer mod println
//
// Logline: Print 8 % 3 so emit-wasm can plant a WASI fd_write body of 2.
//
// Setup: No imports. One public main. The body is only println of two INT literals percent.
//
// Beats:
//   1. Declare public main.
//   2. Print 8 % 3.
//   3. Leave no other statements.

pub fn main() { println(8 % 3); }
