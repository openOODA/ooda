// # Product prove std/genomics_advanced/linkage_disequilibrium_r2.oo
//
// Logline: Fail-closed emit+gcc+run asserts linkage_disequilibrium_r2_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/linkage_disequilibrium_r2.oo.
//
// Beats:
//   1. Call linkage_disequilibrium_r2_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_linkage_disequilibrium_r2: PASSED only if they match.

import "std/genomics_advanced/linkage_disequilibrium_r2.oo";

pub fn main() {
    let a = linkage_disequilibrium_r2_probe();
    let b = linkage_disequilibrium_r2_probe();
    if a != b {
        println("FAIL linkage_disequilibrium_r2_probe");
        process_exit(1);
    }
    println("prod_linkage_disequilibrium_r2: PASSED");
}
