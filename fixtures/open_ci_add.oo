// # Tiny add for named CI
//
// Logline: Add two ints and print five.
//
// Setup: OPEN-7 named emit+gcc+run member.
//
// Beats:
//   1. Return a + b.
//   2. Call add(2, 3).
//   3. Print the sum.

pub fn add(a: Int, b: Int) -> Int {
    return a + b;
}

pub fn main() {
    let x = add(2, 3);
    println(x);
}
