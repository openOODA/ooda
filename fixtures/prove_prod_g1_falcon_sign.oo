// # Product prove std/crypto_advanced/falcon_sign.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_params_512 is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/falcon_sign.oo.
//
// Beats:
//   1. Call falcon_params_512 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_sign: PASSED only if they match.

import "std/crypto_advanced/falcon_sign.oo";

pub fn main() {
    let a: FalconParams = falcon_params_512();
    let b: FalconParams = falcon_params_512();
    if a.n != b.n {
        println("FAIL falcon_params_512");
        process_exit(1);
    }
    println("prod_falcon_sign: PASSED");
}
