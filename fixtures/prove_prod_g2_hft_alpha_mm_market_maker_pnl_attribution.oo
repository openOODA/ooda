// # Product prove std/hft_alpha/mm_market_maker_pnl_attribution.oo
//
// Logline: Fail-closed emit+gcc+run asserts pnl_attribution_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_market_maker_pnl_attribution.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pnl_attribution_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_market_maker_pnl_attribution: PASSED only if they match.

import "std/hft_alpha/mm_market_maker_pnl_attribution.oo";

pub fn main() {
    let g2_oa: PnlComponentReport = pnl_attribution_new();
    let g2_ob: PnlComponentReport = pnl_attribution_new();
    let g2_a = (g2_oa).total_pnl_usd;
    let g2_b = (g2_ob).total_pnl_usd;
    if g2_a != g2_b {
        println("FAIL pnl_attribution_new.total_pnl_usd");
        process_exit(1);
    }
    println("prod_g2_mm_market_maker_pnl_attribution: PASSED");
}
