// # Product prove std/ai_multimodal/audio_spectrogram_transformer.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_spectrogram_transformer_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/audio_spectrogram_transformer.oo.
//
// Beats:
//   1. Call audio_spectrogram_transformer_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audio_spectrogram_transformer: PASSED only if they match.

import "std/ai_multimodal/audio_spectrogram_transformer.oo";

pub fn main() {
    let a = audio_spectrogram_transformer_marker();
    let b = audio_spectrogram_transformer_marker();
    if a != b {
        println("FAIL audio_spectrogram_transformer_marker");
        process_exit(1);
    }
    println("prod_audio_spectrogram_transformer: PASSED");
}
