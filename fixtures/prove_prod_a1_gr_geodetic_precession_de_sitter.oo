// # Product prove std/astrophysics_relativity/gr_geodetic_precession_de_sitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts gr_geodetic_precession_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_geodetic_precession_de_sitter.oo.
//
// Beats:
//   1. Call gr_geodetic_precession_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_geodetic_precession_de_sitter: PASSED only if they match.

import "std/astrophysics_relativity/gr_geodetic_precession_de_sitter.oo";

pub fn main() {
    let gr_geodetic_precession_de_sitter_mark: Int = 0;
    if gr_geodetic_precession_de_sitter_mark != 0 {
        process_exit(1);
    }
    let a: Float = gr_geodetic_precession_rate(0.0, 0.0);
    let b: Float = gr_geodetic_precession_rate(0.0, 0.0);
    if a != b {
        println("FAIL gr_geodetic_precession_rate");
        process_exit(1);
    }
    println("prod_gr_geodetic_precession_de_sitter: PASSED");
}
