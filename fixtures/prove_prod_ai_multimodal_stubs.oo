import "std/ai_multimodal/ai_multimodal_stubs.oo";

pub fn main() {
    let a = ai_multimodal_stubs_marker();
    let b = ai_multimodal_stubs_marker();
    if a != b {
        println("FAIL ai_multimodal_stubs_marker");
        process_exit(1);
