// # Product sync lockfree ring prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/lockfree_ring.oo.
//
// Setup: Product std/sync/lockfree_ring.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(8) cap 8 len 0 empty. new(0) clamps 2.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/lockfree_ring.oo";

pub fn main() {
    let r: LockfreeRing = lockfree_ring_new(8);
    let c: Int = lockfree_ring_capacity(r);
    if c != 8 {
        println("FAIL lfring cap");
        process_exit(1);
    }
    let n: Int = lockfree_ring_len(r);
    if n != 0 {
        println("FAIL lfring len");
        process_exit(1);
    }
    if lockfree_ring_is_empty(r) == false {
        println("FAIL lfring empty");
        process_exit(1);
    }
    if lockfree_ring_is_full(r) {
        println("FAIL lfring full");
        process_exit(1);
    }
    let r2: LockfreeRing = lockfree_ring_new(0);
    let c2: Int = lockfree_ring_capacity(r2);
    if c2 != 2 {
        println("FAIL lfring clamp");
        process_exit(1);
    }
    println("prod_lfring: PASSED");
}
