// # Product prove std/quantum_topological/anyon_majorana_zero_modes.oo
//
// Logline: Fail-closed emit+gcc+run asserts majorana_wire_energy_split is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_majorana_zero_modes.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call majorana_wire_energy_split twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_anyon_majorana_zero_modes: PASSED only if they match.

import "std/quantum_topological/anyon_majorana_zero_modes.oo";

pub fn main() {
    let g2_a = majorana_wire_energy_split(1.0, 1.0);
    let g2_b = majorana_wire_energy_split(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL majorana_wire_energy_split");
        process_exit(1);
    }
    println("prod_g2_anyon_majorana_zero_modes: PASSED");
}
