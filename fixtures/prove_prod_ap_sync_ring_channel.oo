// # Product prove std/sync/ring_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/ring_channel.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/ring_channel.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_ring_channel: PASSED only if they match.

import "std/sync/ring_channel.oo";

pub fn main() {
    let ring_channel_a = ring_channel_new(0);
    let ring_channel_b = ring_channel_new(0);
    if ring_channel_a.capacity != ring_channel_b.capacity {
        println("FAIL ring_channel");
        process_exit(1);
    }
    println("prod_ap_ring_channel: PASSED");
}
