// # Product prove std/bft_consensus/round_timeout_pacemaker.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/round_timeout_pacemaker.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/round_timeout_pacemaker.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_round_timeout_pacemaker: PASSED only if they match.

import "std/bft_consensus/round_timeout_pacemaker.oo";

pub fn main() {
    let round_timeout_pacemaker_a = pacemaker_timer_state_new(0, 0);
    let round_timeout_pacemaker_b = pacemaker_timer_state_new(0, 0);
    if round_timeout_pacemaker_a.current_round != round_timeout_pacemaker_b.current_round {
        println("FAIL round_timeout_pacemaker");
        process_exit(1);
    }
    println("prod_ap_round_timeout_pacemaker: PASSED");
}
