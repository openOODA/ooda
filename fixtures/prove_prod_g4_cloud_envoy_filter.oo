// # Product prove std/cloud_k8s/service_mesh_envoy_filter.oo
//
// Logline: Fail-closed verification that service mesh Envoy route filtering is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/service_mesh_envoy_filter.oo.
//
// Beats:
//   1. Initialize route tables with matching configuration.
//   2. Add route rules and match incoming request paths.
//   3. Assert returned cluster names and rewritten paths match deterministically.
//   4. Print prod_g4_cloud_envoy_filter: PASSED and exit 0.

import "std/cloud_k8s/service_mesh_envoy_filter.oo";

pub fn main() {
    let t1: EnvoyRouteTable = envoy_route_table_new("default-cluster");
    let t2: EnvoyRouteTable = envoy_route_table_new("default-cluster");

    let configured1: EnvoyRouteTable = envoy_add_route(t1, "/api/v1", "api-cluster", "/v1", 2000);
    let configured2: EnvoyRouteTable = envoy_add_route(t2, "/api/v1", "api-cluster", "/v1", 2000);

    let res1: FilterResult = envoy_match_route(configured1, "/api/v1");
    let res2: FilterResult = envoy_match_route(configured2, "/api/v1");

    let cl1: String = filter_result_cluster(res1);
    let cl2: String = filter_result_cluster(res2);
    if cl1 != cl2 || cl1 != "api-cluster" {
        println("FAIL filter_result_cluster");
        process_exit(1);
    }

    let rw1: String = filter_result_rewritten_path(res1);
    let rw2: String = filter_result_rewritten_path(res2);
    if rw1 != rw2 || rw1 != "/v1" {
        println("FAIL filter_result_rewritten_path");
        process_exit(1);
    }

    let tm1: Int = filter_result_timeout(res1);
    let tm2: Int = filter_result_timeout(res2);
    if tm1 != tm2 || tm1 != 2000 {
        println("FAIL filter_result_timeout");
        process_exit(1);
    }

    println("prod_g4_cloud_envoy_filter: PASSED");
    process_exit(0);
}
