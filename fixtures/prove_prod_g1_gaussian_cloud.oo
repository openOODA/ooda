// # Product prove std/3d/gaussian_cloud.oo
//
// Logline: Fail-closed emit+gcc+run asserts gauss_cloud_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_cloud.oo.
//
// Beats:
//   1. Call gauss_cloud_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gaussian_cloud: PASSED only if they match.

import "std/3d/gaussian_cloud.oo";

pub fn main() {
    let obj_a: GaussCloud = gauss_cloud_new(0, 0);
    let obj_b: GaussCloud = gauss_cloud_new(0, 0);
    let a: Int = gauss_cloud_count(obj_a);
    let b: Int = gauss_cloud_count(obj_b);
    if a != 0 {
        println("FAIL gauss_cloud_count");
        process_exit(1);
    }
    if a != b {
        println("FAIL gauss_cloud_count");
        process_exit(1);
    }
    println("prod_gaussian_cloud: PASSED");
}
