// # Product prove std/telecom_6g/massive_mimo_pilot_contamination.oo
//
// Logline: Fail-closed emit+gcc+run asserts pilot_contamination_config_universal_reuse is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/massive_mimo_pilot_contamination.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pilot_contamination_config_universal_reuse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_massive_mimo_pilot_contamination: PASSED only if they match.

import "std/telecom_6g/massive_mimo_pilot_contamination.oo";

pub fn main() {
    let g2_oa: PilotContaminationConfig = pilot_contamination_config_universal_reuse();
    let g2_ob: PilotContaminationConfig = pilot_contamination_config_universal_reuse();
    let g2_a = (g2_oa).num_bs_antennas;
    let g2_b = (g2_ob).num_bs_antennas;
    if g2_a != g2_b {
        println("FAIL pilot_contamination_config_universal_reuse.num_bs_antennas");
        process_exit(1);
    }
    println("prod_g2_massive_mimo_pilot_contamination: PASSED");
}
