// # Product prove std/telecom_5g/dsp_fir_equiripple.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_sinc_windowed_tap is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_fir_equiripple.oo.
//
// Beats:
//   1. Call dsp_sinc_windowed_tap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_fir_equiripple: PASSED only if they match.

import "std/telecom_5g/dsp_fir_equiripple.oo";

pub fn main() {
    let dsp_fir_equiripple_mark: Int = 0;
    if dsp_fir_equiripple_mark != 0 {
        process_exit(1);
    }
    let a: Float = dsp_sinc_windowed_tap(0, 0, 0.0);
    let b: Float = dsp_sinc_windowed_tap(0, 0, 0.0);
    if a != b {
        println("FAIL dsp_sinc_windowed_tap");
        process_exit(1);
    }
    println("prod_dsp_fir_equiripple: PASSED");
}
