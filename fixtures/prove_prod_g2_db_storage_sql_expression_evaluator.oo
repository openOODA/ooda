// # Product prove std/db_storage/sql_expression_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts eval_int_value is a real value.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_expression_evaluator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call eval_int_value twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sql_expression_evaluator: PASSED only if they match.

import "std/db_storage/sql_expression_evaluator.oo";

pub fn main() {
    let g2_oa: EvaluatedValue = eval_int_value(2);
    let g2_ob: EvaluatedValue = eval_int_value(2);
    let g2_a = (g2_oa).int_val;
    let g2_b = (g2_ob).int_val;
    if g2_a != g2_b {
        println("FAIL eval_int_value.int_val");
        process_exit(1);
    }
    println("prod_g2_sql_expression_evaluator: PASSED");
}
