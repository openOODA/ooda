// # Product prove std/bft_consensus/consensus_telemetry_metrics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/consensus_telemetry_metrics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/consensus_telemetry_metrics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_consensus_telemetry_metrics: PASSED only if they match.

import "std/bft_consensus/consensus_telemetry_metrics.oo";

pub fn main() {
    let consensus_telemetry_metrics_a = consensus_metrics_new();
    let consensus_telemetry_metrics_b = consensus_metrics_new();
    let consensus_telemetry_metrics_va = consensus_metrics_average_block_ms(consensus_telemetry_metrics_a);
    let consensus_telemetry_metrics_vb = consensus_metrics_average_block_ms(consensus_telemetry_metrics_b);
    if consensus_telemetry_metrics_va != consensus_telemetry_metrics_vb {
        println("FAIL consensus_telemetry_metrics");
        process_exit(1);
    }
    println("prod_ap_consensus_telemetry_metrics: PASSED");
}
