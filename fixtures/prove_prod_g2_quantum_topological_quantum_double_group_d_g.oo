// # Product prove std/quantum_topological/quantum_double_group_d_g.oo
//
// Logline: Fail-closed emit+gcc+run asserts qd_total_quantum_dimension is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/quantum_double_group_d_g.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qd_total_quantum_dimension twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_double_group_d_g: PASSED only if they match.

import "std/quantum_topological/quantum_double_group_d_g.oo";

pub fn main() {
    let g2_oa: QuantumDoubleModel = QuantumDoubleModel { group_name: "x", group_order: 2, num_classes: 2, num_anyon_species: 2, total_quantum_dim: 1.0 };
    let g2_ob: QuantumDoubleModel = QuantumDoubleModel { group_name: "x", group_order: 2, num_classes: 2, num_anyon_species: 2, total_quantum_dim: 1.0 };
    let g2_a = qd_total_quantum_dimension(&g2_oa);
    let g2_b = qd_total_quantum_dimension(&g2_ob);
    if g2_a != g2_b {
        println("FAIL qd_total_quantum_dimension");
        process_exit(1);
    }
    println("prod_g2_quantum_double_group_d_g: PASSED");
}
