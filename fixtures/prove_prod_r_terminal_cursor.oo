// # Product prove std/os/terminal_cursor.oo
//
// Logline: Fail-closed emit+gcc+run asserts cursor_save value or determinism.
//
// Setup: Isolated emit-c. Imports std/os/terminal_cursor.oo.
//
// Beats:
//   1. Call cursor_save twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_terminal_cursor: PASSED only if asserts hold.

import "std/os/terminal_cursor.oo";

pub fn main() {
    let terminal_cursor: String = cursor_save();
    let terminal_cursor_b: String = cursor_save();
    if chars_len(terminal_cursor) < 1 {
        println("FAIL cursor_save len");
        process_exit(1);
    }
    if chars_len(terminal_cursor) != chars_len(terminal_cursor_b) {
        println("FAIL cursor_save det");
        process_exit(1);
    }
    println("prod_terminal_cursor: PASSED");
}
