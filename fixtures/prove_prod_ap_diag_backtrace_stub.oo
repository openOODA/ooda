// # Product prove std/diag/backtrace_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/diag/backtrace_stub.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/backtrace_stub.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_backtrace_stub: PASSED only if they match.

import "std/diag/backtrace_stub.oo";

pub fn main() {
    let backtrace_stub_a = stack_frame_new("x", "x", 0);
    let backtrace_stub_b = stack_frame_new("x", "x", 0);
    let backtrace_stub_va = stack_frame_format(backtrace_stub_a);
    let backtrace_stub_vb = stack_frame_format(backtrace_stub_b);
    if backtrace_stub_va.contains(backtrace_stub_vb) == false {
        println("FAIL backtrace_stub");
        process_exit(1);
    }
    if backtrace_stub_vb.contains(backtrace_stub_va) == false {
        println("FAIL backtrace_stub");
        process_exit(1);
    }
    println("prod_ap_backtrace_stub: PASSED");
}
