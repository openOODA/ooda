// # Product prove std/auto_mpc_control/tire_fiala_brush_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts fiala_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_fiala_brush_model.oo.
//
// Beats:
//   1. Call fiala_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tire_fiala_brush_model: PASSED only if they match.

import "std/auto_mpc_control/tire_fiala_brush_model.oo";

pub fn main() {
    let tire_fiala_brush_model_mark: Int = 0;
    if tire_fiala_brush_model_mark != 0 {
        process_exit(1);
    }
    let a: FialaParams = fiala_params_default();
    let b: FialaParams = fiala_params_default();
    if (a).cornering_stiff != (b).cornering_stiff {
        println("FAIL fiala_params_default");
        process_exit(1);
    }
    println("prod_tire_fiala_brush_model: PASSED");
}
