// # Product prove std/sec/crypto/groth16.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_curve_bn254 holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16.oo.
//
// Beats:
//   1. Call shim_marker_curve_bn254 using the groth16 ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_groth16: PASSED only if asserts hold.

import "std/sec/crypto/groth16.oo";

pub fn main() {
    let groth16_a = shim_marker_curve_bn254();
    let groth16_b = shim_marker_curve_bn254();
    if groth16_a != groth16_b {
        println("FAIL shim_marker_curve_bn254");
        process_exit(1);
    }
    println("prod_groth16: PASSED");
}
