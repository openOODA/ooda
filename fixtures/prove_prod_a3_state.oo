// # Product prove std/gui/state.oo
//
// Logline: Fail-closed emit+gcc+run asserts gui_state_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/state.oo.
//
// Beats:
//   1. Call gui_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_state: PASSED only if they match.

import "std/gui/state.oo";

pub fn main() {
    let state_mark: Int = 0;
    if state_mark != 0 {
        process_exit(1);
    }
    let a: GuiState = gui_state_init();
    let b: GuiState = gui_state_init();
    if (a).mouse_x != (b).mouse_x {
        println("FAIL gui_state_init");
        process_exit(1);
    }
    println("prod_state: PASSED");
}
