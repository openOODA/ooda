// # Product prove std/digital_twin/twin_rotor_bearing_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_rotor_bearing_dynamics_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_rotor_bearing_dynamics.oo.
//
// Beats:
//   1. Call twin_rotor_bearing_dynamics_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_twin_rotor_bearing_dynamics: PASSED only if they match.

import "std/digital_twin/twin_rotor_bearing_dynamics.oo";

pub fn main() {
    let a = twin_rotor_bearing_dynamics_probe();
    let b = twin_rotor_bearing_dynamics_probe();
    if a != b {
        println("FAIL twin_rotor_bearing_dynamics_probe");
        process_exit(1);
    }
    println("prod_twin_rotor_bearing_dynamics: PASSED");
}
