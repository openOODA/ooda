// # Product prove std/fintech_defi/yield_curve_nelson_siegel.oo
//
// Logline: Fail-closed emit+gcc+run asserts ns_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/yield_curve_nelson_siegel.oo.
//
// Beats:
//   1. Call ns_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_curve_nelson_siegel: PASSED only if they match.

import "std/fintech_defi/yield_curve_nelson_siegel.oo";

pub fn main() {
    let yield_curve_nelson_siegel_mark: Int = 0;
    if yield_curve_nelson_siegel_mark != 0 {
        process_exit(1);
    }
    let a: NelsonSiegelParams = ns_params_new(0.0, 0.0, 0.0, 0.0);
    let b: NelsonSiegelParams = ns_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).beta0 != (b).beta0 {
        println("FAIL ns_params_new");
        process_exit(1);
    }
    println("prod_yield_curve_nelson_siegel: PASSED");
}
