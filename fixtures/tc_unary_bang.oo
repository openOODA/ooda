// # Unary bang needs Bool
//
// Logline: Check refuses ! on an Int literal.
//
// Setup: Single-file probe. Line of the bang stays under 50.
//
// Beats:
//   1. Use !1 as an if condition.
//   2. Do not bind an unused let.
//   3. check must ERR type unary '!' requires Bool.

pub fn main() {
    if !1 {
        println(1);
    }
}
