// # Product prove std/tda_topology/clique_complex_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts is_clique_in_adj_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/clique_complex_graph.oo.
//
// Beats:
//   1. Call is_clique_in_adj_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_clique_complex_graph: PASSED only if they match.

import "std/tda_topology/clique_complex_graph.oo";

pub fn main() {
    let clique_complex_graph_mark: Int = 0;
    if clique_complex_graph_mark != 0 {
        process_exit(1);
    }
    let clique_complex_graph_a: Bool = is_clique_in_adj_matrix(list_new(), list_new(), 1);
    let clique_complex_graph_b: Bool = is_clique_in_adj_matrix(list_new(), list_new(), 1);
    if clique_complex_graph_a != clique_complex_graph_b {
        println("FAIL is_clique_in_adj_matrix");
        process_exit(1);
    }
    println("prod_clique_complex_graph: PASSED");
}
