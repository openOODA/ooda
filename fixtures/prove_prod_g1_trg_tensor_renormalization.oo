// # Product prove std/quantum_tensor_nets/trg_tensor_renormalization.oo
//
// Logline: Fail-closed emit+gcc+run asserts trg_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/trg_tensor_renormalization.oo.
//
// Beats:
//   1. Call trg_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_trg_tensor_renormalization: PASSED only if they match.

import "std/quantum_tensor_nets/trg_tensor_renormalization.oo";

pub fn main() {
    let a: TrgConfig = trg_config_default(0, 0.0);
    let b: TrgConfig = trg_config_default(0, 0.0);
    if a.chi_max != b.chi_max {
        println("FAIL trg_config_default");
        process_exit(1);
    }
    println("prod_trg_tensor_renormalization: PASSED");
}
