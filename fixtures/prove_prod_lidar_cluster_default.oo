// # Product prove std/lidar_perception/euclidean_cluster_extractor.oo
//
// Logline: Fail-closed emit+gcc+run asserts euclidean_cluster_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/euclidean_cluster_extractor.oo.
//
// Beats:
//   1. Call euclidean_cluster_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lidar_cluster_default: PASSED only if they match.

import "std/lidar_perception/euclidean_cluster_extractor.oo";

pub fn main() {
    let euclidean_cluster_extractor_mark: Int = 0;
    if euclidean_cluster_extractor_mark != 0 { process_exit(1); }
    let a: EuclideanClusterConfig = euclidean_cluster_config_default();
    let b: EuclideanClusterConfig = euclidean_cluster_config_default();
    let at: Float = (a).cluster_tolerance;
    let bt: Float = (b).cluster_tolerance;
    if at != bt {
        println("FAIL euclidean_cluster_config_default");
        process_exit(1);
    }
    println("prod_lidar_cluster_default: PASSED");
}
