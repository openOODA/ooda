// # Product prove std/crispr_cas/off_target_hsu_zhang_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts hsu_weight is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/off_target_hsu_zhang_matrix.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hsu_weight twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_off_target_hsu_zhang_matrix: PASSED only if they match.

import "std/crispr_cas/off_target_hsu_zhang_matrix.oo";

pub fn main() {
    let g0_a = hsu_weight(2);
    let g0_b = hsu_weight(2);
    if g0_a != g0_b {
        println("FAIL hsu_weight");
        process_exit(1);
    }
    println("prod_g0_off_target_hsu_zhang_matrix: PASSED");
}
