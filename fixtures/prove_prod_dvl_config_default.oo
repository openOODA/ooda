// # Product prove std/robotics_auv/dvb_dead_reckoning_nav.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvl_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/dvb_dead_reckoning_nav.oo.
//
// Beats:
//   1. Call dvl_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvl_config_default: PASSED only if they match.

import "std/robotics_auv/dvb_dead_reckoning_nav.oo";

pub fn main() {
    let dvb_dead_reckoning_nav_mark: Int = 0;
    if dvb_dead_reckoning_nav_mark != 0 { process_exit(1); }
    let a: DvlJanusConfig = dvl_config_default();
    let b: DvlJanusConfig = dvl_config_default();
    let ac: Float = (a).carrier_frequency_hz;
    let bc: Float = (b).carrier_frequency_hz;
    if ac != bc {
        println("FAIL dvl_config_default");
        process_exit(1);
    }
    println("prod_dvl_config_default: PASSED");
}
