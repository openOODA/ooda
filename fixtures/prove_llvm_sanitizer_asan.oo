// # Prove LLVM Sanitizer ASan
//
// Logline: Exercises memory allocation, struct access, string manipulation, and arithmetic under AddressSanitizer (ASan) instrumentation.
//
// Setup: Compiled and executed with LLVM backend and AddressSanitizer enabled (-fsanitize=address).
//
// Beats:
//   1. Calculate point coordinates with arithmetic.
//   2. Build and concatenate ARC strings and verify contents.
//   3. Execute memory loop arithmetic and verify accumulators.
//   4. Print ASAN_PROVE_OK on successful verification.

pub fn check_point(x: Int, y: Int) -> Int {
    let sum: Int = x + y;
    return sum;
}

pub fn check_strings() -> Bool {
    let s1: String = "ASAN_";
    let s2: String = "PROVE_OK";
    let s3: String = s1 + s2;
    if s3 == "ASAN_PROVE_OK" {
        return true;
    }
    return false;
}

pub fn check_memory_loop(limit: Int) -> Int {
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < limit {
        sum = sum + check_point(i, i * 2);
        i = i + 1;
    }
    return sum;
}

pub fn main() {
    let pt_res: Int = check_point(40, 2);
    if pt_res != 42 {
        println("FAIL: check_point");
        return;
    }

    let loop_res: Int = check_memory_loop(100);
    if loop_res != 14850 {
        println("FAIL: check_memory_loop");
        return;
    }

    if check_strings() {
        println("ASAN_PROVE_OK");
    } else {
        println("FAIL: check_strings");
    }
}
