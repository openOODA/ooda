// # Product prove std/tda_topology/vietoris_rips_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts vr_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/vietoris_rips_filtration.oo.
//
// Beats:
//   1. Call vr_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vietoris_rips_filtration: PASSED only if they match.

import "std/tda_topology/vietoris_rips_filtration.oo";

pub fn main() {
    let vietoris_rips_filtration_mark: Int = 0;
    if vietoris_rips_filtration_mark != 0 {
        process_exit(1);
    }
    let vietoris_rips_filtration_a: RipsFiltrationConfig = vr_config_new(1, 1.0, 1);
    let vietoris_rips_filtration_b: RipsFiltrationConfig = vr_config_new(1, 1.0, 1);
    if (vietoris_rips_filtration_a).max_dimension != (vietoris_rips_filtration_b).max_dimension {
        println("FAIL vr_config_new");
        process_exit(1);
    }
    println("prod_vietoris_rips_filtration: PASSED");
}
