// # Product prove std/sec/sys/elf_inspect.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_inspect_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_inspect.oo.
//
// Beats:
//   1. Call elf_inspect_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_elf_inspect: PASSED only if it matches.

import "std/sec/sys/elf_inspect.oo";

pub fn main() {
    let a: Int = elf_inspect_probe();
    if a != 0 {
        println("FAIL elf_inspect_probe");
        process_exit(1);
    }
    println("prod_nc_elf_inspect: PASSED");
}
