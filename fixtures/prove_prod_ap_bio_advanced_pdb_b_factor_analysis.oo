// # Product prove std/bio_advanced/pdb_b_factor_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/pdb_b_factor_analysis.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/pdb_b_factor_analysis.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pdb_b_factor_analysis: PASSED only if they match.

import "std/bio_advanced/pdb_b_factor_analysis.oo";

pub fn main() {
    let pdb_b_factor_analysis_a = bfactor_sqrt(0.0);
    let pdb_b_factor_analysis_b = bfactor_sqrt(0.0);
    if pdb_b_factor_analysis_a != pdb_b_factor_analysis_b {
        println("FAIL pdb_b_factor_analysis");
        process_exit(1);
    }
    println("prod_ap_pdb_b_factor_analysis: PASSED");
}
