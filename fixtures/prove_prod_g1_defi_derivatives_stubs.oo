// # Product prove std/defi_derivatives/defi_derivatives_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts mock_perp_feed_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/defi_derivatives_stubs.oo.
//
// Beats:
//   1. Call mock_perp_feed_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_defi_derivatives_stubs: PASSED only if they match.

import "std/defi_derivatives/defi_derivatives_stubs.oo";

pub fn main() {
    let a: MockPerpFeed = mock_perp_feed_new("x", 0.0, 0.0);
    let b: MockPerpFeed = mock_perp_feed_new("x", 0.0, 0.0);
    if a.tick_count != b.tick_count {
        println("FAIL mock_perp_feed_new");
        process_exit(1);
    }
    println("prod_defi_derivatives_stubs: PASSED");
}
