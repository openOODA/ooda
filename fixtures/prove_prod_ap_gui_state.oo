// # Product prove std/gui/state.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gui/state.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/state.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_state: PASSED only if they match.

import "std/gui/state.oo";

pub fn main() {
    let state_a = gui_state_init();
    let state_b = gui_state_init();
    let state_va = gui_state_get_focus(state_a);
    let state_vb = gui_state_get_focus(state_b);
    if state_va != state_vb {
        println("FAIL state");
        process_exit(1);
    }
    println("prod_ap_state: PASSED");
}
