// # Hop probe for infection-loop gates
//
// Logline: Drive shipped write_file, process_exec, and agent_send under one case key.
//
// Setup: OODA_HOP_CASE selects the case. OODA_FS_WRITEDIR is absolute. Caps are write, env, and process.
//
// Beats:
//   1. write_ok writes a workspace note.
//   2. write_policy, unlink/hardlink/symlink policy, write_untrusted, and exec_untrusted must fail closed.
//   3. send and send_token use agent_send. pin_init writes the policy pin.

import "std/sec/agent_send.oo";
import "std/sec/policy_path.oo";
import "std/os/fs.oo";

fn die(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn need_dir(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if r.is_err() {
        die("no writedir");
    }
    return match r {
        Ok(s) => s,
        Err(m) => m
    };
}

fn need_case(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_HOP_CASE");
    if r.is_err() {
        die("no case");
    }
    return match r {
        Ok(s) => s,
        Err(m) => m
    };
}

fn blob(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_UNTRUSTED");
    if r.is_err() {
        return "";
    }
    return match r {
        Ok(s) => s,
        Err(_) => ""
    };
}

pub fn main(fw: &FsWriteCap, env: &EnvCap, p: &ProcessCap) {
    let dir: String = need_dir(env);
    let cse: String = need_case(env);
    if cse == "write_ok" {
        let wr: Result[Void, String] = write_file(fw, dir + "/note.txt", "ok-workspace");
        if wr.is_err() {
            die("write_ok");
        }
        println("OK write_ok");
        return;
    }
    if cse == "write_policy" {
        let wr: Result[Void, String] = write_file(fw, dir + "/SOUL.md", "virus-soul");
        if wr.is_ok() {
            die("write_policy allowed");
        }
        println("OK write_policy_denied");
        return;
    }
    if cse == "write_untrusted" {
        let b: String = blob(env);
        let wr: Result[Void, String] = write_file(fw, dir + "/note.txt", b);
        if wr.is_ok() {
            die("write_untrusted allowed");
        }
        println("OK write_untrusted_denied");
        return;
    }
    if cse == "exec_untrusted" {
        let b: String = blob(env);
        let er: Result[String, String] = process_exec(p, "echo " + b);
        if er.is_ok() {
            die("exec_untrusted allowed");
        }
        println("OK exec_untrusted_denied");
        return;
    }
    if cse == "send" {
        let sr: Result[Bool, String] = agent_send(env, fw, "peer", "hello-peer");
        if sr.is_err() {
            die("send");
        }
        println("OK send");
        return;
    }
    if cse == "send_hop2" {
        let sr: Result[Bool, String] = agent_send(env, fw, "peer", "hello-peer");
        if sr.is_ok() {
            die("send_hop2 allowed");
        }
        println("OK send_hop2_denied");
        return;
    }
    if cse == "send_empty_hop" {
        let sr: Result[Bool, String] = agent_send(env, fw, "peer", "hello-peer");
        if sr.is_ok() {
            die("send_empty_hop allowed");
        }
        println("OK send_empty_hop_denied");
        return;
    }
    if cse == "send_token" {
        let sr: Result[Bool, String] = agent_send(env, fw, "peer", "hold &FsWriteCap now");
        if sr.is_ok() {
            die("send_token allowed");
        }
        println("OK send_token_denied");
        return;
    }
    if cse == "pin_init" {
        let line: String = policy_pin_line("agent", "0", "abc", "FsReadCap");
        let wr: Result[Void, String] = write_file(fw, dir + "/host.agent.pin", line);
        if wr.is_err() {
            die("pin_init");
        }
        println("OK pin_init");
        return;
    }
    if cse == "pin_infect" {
        let wr: Result[Void, String] = write_file(fw, dir + "/host.agent.pin", "infected");
        if wr.is_ok() {
            die("pin_infect allowed");
        }
        println("OK pin_infect_denied");
        return;
    }
    if cse == "unlink_policy" {
        let wr: Result[Void, String] = fs_remove_file(fw, dir + "/host.agent.pin");
        if wr.is_ok() {
            die("unlink_policy allowed");
        }
        println("OK unlink_policy_denied");
        return;
    }
    if cse == "hardlink_policy" {
        let wr: Result[Void, String] = fs_hardlink(fw, dir + "/host.agent.pin", dir + "/note.txt");
        if wr.is_ok() {
            die("hardlink_policy allowed");
        }
        println("OK hardlink_policy_denied");
        return;
    }
    if cse == "symlink_policy" {
        let wr: Result[Void, String] = fs_symlink(fw, dir + "/SOUL.md", dir + "/note-link");
        if wr.is_ok() {
            die("symlink_policy allowed");
        }
        println("OK symlink_policy_denied");
        return;
    }
    die("unknown case");
}
