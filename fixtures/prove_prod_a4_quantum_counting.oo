// # Product prove std/quantum_advanced/quantum_counting.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_counting_optimum_iterations is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_counting.oo.
//
// Beats:
//   1. Call quantum_counting_optimum_iterations twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_counting: PASSED only if they match.

import "std/quantum_advanced/quantum_counting.oo";

pub fn main() {
    let a: Int = quantum_counting_optimum_iterations(0.0, 0);
    let b: Int = quantum_counting_optimum_iterations(0.0, 0);
    if a != b {
        println("FAIL quantum_counting_optimum_iterations");
        process_exit(1);
    }
    println("prod_quantum_counting: PASSED");
}
