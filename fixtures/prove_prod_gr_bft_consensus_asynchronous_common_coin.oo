// # Product prove std/bft_consensus/asynchronous_common_coin.oo
//
// Logline: Fail-closed emit+gcc+run asserts common_coin_get_bit is a real value.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/asynchronous_common_coin.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call common_coin_get_bit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_asynchronous_common_coin: PASSED only if they match.

import "std/bft_consensus/asynchronous_common_coin.oo";

pub fn main() {
    let g0_oa: CommonCoinSession = CommonCoinSession { round: 0, threshold: 0, shares_count: 0, coin_accumulator: 0, is_revealed: true };
    let g0_ob: CommonCoinSession = CommonCoinSession { round: 0, threshold: 0, shares_count: 0, coin_accumulator: 0, is_revealed: true };
    let g0_a = common_coin_get_bit(g0_oa);
    let g0_b = common_coin_get_bit(g0_ob);
    if g0_a != g0_b {
        println("FAIL common_coin_get_bit");
        process_exit(1);
    }
    println("prod_gr_asynchronous_common_coin: PASSED");
}
