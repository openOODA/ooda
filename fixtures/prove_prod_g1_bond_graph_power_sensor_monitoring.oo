// # Product prove std/digital_twin/bond_graph_power_sensor_monitoring.oo
//
// Logline: Fail-closed emit+gcc+run asserts power_sensor_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_power_sensor_monitoring.oo.
//
// Beats:
//   1. Call power_sensor_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bond_graph_power_sensor_monitoring: PASSED only if they match.

import "std/digital_twin/bond_graph_power_sensor_monitoring.oo";

pub fn main() {
    let a: PowerSensorPort = power_sensor_new(0);
    let b: PowerSensorPort = power_sensor_new(0);
    if a.port_id != b.port_id {
        println("FAIL power_sensor_new");
        process_exit(1);
    }
    println("prod_bond_graph_power_sensor_monitoring: PASSED");
}
