// # Product prove std/quantum_open_systems/husimi_q_function_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/husimi_q_function_dynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/husimi_q_function_dynamics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_husimi_q_function_dynamics: PASSED only if they match.

import "std/quantum_open_systems/husimi_q_function_dynamics.oo";

pub fn main() {
    let husimi_q_function_dynamics_a = husimi_vacuum_eval(0.0, 0.0);
    let husimi_q_function_dynamics_b = husimi_vacuum_eval(0.0, 0.0);
    if husimi_q_function_dynamics_a != husimi_q_function_dynamics_b {
        println("FAIL husimi_q_function_dynamics");
        process_exit(1);
    }
    println("prod_ap_husimi_q_function_dynamics: PASSED");
}
