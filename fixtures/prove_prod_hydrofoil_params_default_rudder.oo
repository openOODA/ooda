// # Product prove std/robotics_auv/control_surfaces_hydrofoils.oo
//
// Logline: Fail-closed emit+gcc+run asserts hydrofoil_params_default_rudder is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/control_surfaces_hydrofoils.oo.
//
// Beats:
//   1. Call hydrofoil_params_default_rudder twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hydrofoil_params_default_rudder: PASSED only if they match.

import "std/robotics_auv/control_surfaces_hydrofoils.oo";

pub fn main() {
    let control_surfaces_hydrofoils_mark: Int = 0;
    if control_surfaces_hydrofoils_mark != 0 { process_exit(1); }
    let a: HydrofoilParams = hydrofoil_params_default_rudder();
    let b: HydrofoilParams = hydrofoil_params_default_rudder();
    if (a).area_m2 != (b).area_m2 {
        println("FAIL hydrofoil_params_default_rudder");
        process_exit(1);
    }
    println("prod_hydrofoil_params_default_rudder: PASSED");
}
