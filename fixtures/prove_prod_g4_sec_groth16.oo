// # Product prove std/sec/crypto/groth16.oo
//
// Logline: Fail-closed emit+gcc+run asserts groth16 zk-SNARK verification and proof structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16.oo.
//
// Beats:
//   1. Verify curve identification, proof construction, and setup parameters.
//   2. Validate format checking on Groth16 proofs and public input shim markers.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_sec_groth16: PASSED and exit 0.

import "std/sec/crypto/groth16.oo";

pub fn main() {
    let bn1: Int = shim_marker_curve_bn254();
    let bn2: Int = shim_marker_curve_bn254();
    if bn1 != bn2 || bn1 != 1 {
        println("FAIL shim_marker_curve_bn254");
        process_exit(1);
    }

    let name1: String = groth16_curve_name(1);
    let name2: String = groth16_curve_name(1);
    if name1 != name2 || name1 != "BN254" {
        println("FAIL groth16_curve_name BN254");
        process_exit(1);
    }

    let name_bls1: String = groth16_curve_name(2);
    let name_bls2: String = groth16_curve_name(2);
    if name_bls1 != name_bls2 || name_bls1 != "BLS12-381" {
        println("FAIL groth16_curve_name BLS12-381");
        process_exit(1);
    }

    let p1: Groth16Proof = shim_marker_proof();
    let p2: Groth16Proof = shim_marker_proof();
    if (p1).curve_id != (p2).curve_id || groth16_proof_validate_format(&p1) == false {
        println("FAIL shim_marker_proof");
        process_exit(1);
    }

    let pub1: PublicInputs = shim_marker_public_inputs();
    let pub2: PublicInputs = shim_marker_public_inputs();
    if (pub1).scalar_count != (pub2).scalar_count || (pub1).is_well_formed == false {
        println("FAIL shim_marker_public_inputs");
        process_exit(1);
    }

    let params1: Groth16SetupParams = shim_marker_setup_params();
    let params2: Groth16SetupParams = shim_marker_setup_params();
    if (params1).num_constraints != (params2).num_constraints || (params1).is_trusted_setup_complete == false {
        println("FAIL shim_marker_setup_params");
        process_exit(1);
    }

    let proof: Groth16Proof = groth16_proof_create(
        "proof_001",
        1,
        "0x111", "0x222",
        "0x333", "0x444", "0x555", "0x666",
        "0x777", "0x888",
        true
    );
    if (proof).is_valid == false || groth16_proof_validate_format(&proof) == false {
        println("FAIL groth16_proof_create");
        process_exit(1);
    }

    let s1: Groth16Setup = groth16_setup_new(1, 2);
    let s2: Groth16Setup = groth16_setup_new(1, 2);
    if groth16_setup_bytes(s1) != groth16_setup_bytes(s2) || groth16_setup_flags(s1) != groth16_setup_flags(s2) {
        println("FAIL groth16_setup");
        process_exit(1);
    }

    println("prod_g4_sec_groth16: PASSED");
    process_exit(0);
}
