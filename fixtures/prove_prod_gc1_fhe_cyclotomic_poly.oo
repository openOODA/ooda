// # Product prove std/fhe_lattices/fhe_cyclotomic_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts cyclo_poly_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_cyclotomic_poly.oo.
//
// Beats:
//   1. Call cyclo_poly_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_cyclotomic_poly: PASSED only if they match.

import "std/fhe_lattices/fhe_cyclotomic_poly.oo";

pub fn main() {
    let fhe_cyclotomic_poly_mark: Int = 0;
    if fhe_cyclotomic_poly_mark != 0 {
        process_exit(1);
    }
    let fhe_cyclotomic_poly_a = cyclo_poly_zero(1);
    let fhe_cyclotomic_poly_b = cyclo_poly_zero(1);
    if (fhe_cyclotomic_poly_a).degree_n != (fhe_cyclotomic_poly_b).degree_n {
        println("FAIL cyclo_poly_zero");
        process_exit(1);
    }
    println("prod_fhe_cyclotomic_poly: PASSED");
}
