// # Product prove std/mesh_ebpf/net_vrrp_failover_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts vrrp_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/net_vrrp_failover_engine.oo.
//
// Beats:
//   1. Call vrrp_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_net_vrrp_failover_engine: PASSED only if they match.

import "std/mesh_ebpf/net_vrrp_failover_engine.oo";

pub fn main() {
    let net_vrrp_failover_engine_mark: Int = 0;
    if net_vrrp_failover_engine_mark != 0 {
        process_exit(1);
    }
    let net_vrrp_failover_engine_a: VrrpState = vrrp_engine_new(1, 1, 1, true);
    let net_vrrp_failover_engine_b: VrrpState = vrrp_engine_new(1, 1, 1, true);
    if (net_vrrp_failover_engine_a).vrid != (net_vrrp_failover_engine_b).vrid {
        println("FAIL vrrp_engine_new");
        process_exit(1);
    }
    println("prod_net_vrrp_failover_engine: PASSED");
}
