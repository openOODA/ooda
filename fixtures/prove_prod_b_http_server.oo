// # Product prove std/net/http_server.oo
//
// Logline: Fail-closed emit+gcc+run asserts http_server_match_route is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http_server.oo.
//
// Beats:
//   1. Call http_server_match_route twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http_server: PASSED only if they match.

import "std/net/http_server.oo";

pub fn main() {
    let a = http_server_match_route("x", "x", "x", "x");
    let b = http_server_match_route("x", "x", "x", "x");
    if a != b {
        println("FAIL http_server_match_route");
        process_exit(1);
    }
    println("prod_http_server: PASSED");
}
