// # Product prove std/db_storage/mvcc_lock_table_2pl.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/mvcc_lock_table_2pl.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_lock_table_2pl.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mvcc_lock_table_2pl: PASSED only if they match.

import "std/db_storage/mvcc_lock_table_2pl.oo";

pub fn main() {
    let mvcc_lock_table_2pl_a = are_locks_compatible("x", "x");
    let mvcc_lock_table_2pl_b = are_locks_compatible("x", "x");
    if mvcc_lock_table_2pl_a != mvcc_lock_table_2pl_b {
        println("FAIL mvcc_lock_table_2pl");
        process_exit(1);
    }
    println("prod_ap_mvcc_lock_table_2pl: PASSED");
}
