// # emit-x86 string-int concat print
//
// Logline: Bind n to 7 and print n= plus n so emit-x86 can lower STRING plus a same-fn int ident.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Bind n to 7.
//   3. Print n= plus n.
//
// residual: general concat and ALU stay later.

pub fn main() {
    let n = 7;
    println("n=" + n);
}
