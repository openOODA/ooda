// # Product prove std/ai_multimodal/clip_text_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts clip_text_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/clip_text_encoder.oo.
//
// Beats:
//   1. Call clip_text_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_clip_text_encoder: PASSED only if they match.

import "std/ai_multimodal/clip_text_encoder.oo";

pub fn main() {
    let a: CLIPTextConfig = clip_text_config_new(0, 0, 0, 0, 0);
    let b: CLIPTextConfig = clip_text_config_new(0, 0, 0, 0, 0);
    if a.vocab_size != b.vocab_size {
        println("FAIL clip_text_config_new");
        process_exit(1);
    }
    println("prod_clip_text_encoder: PASSED");
}
