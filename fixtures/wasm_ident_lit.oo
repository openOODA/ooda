// # Same-fn string let println
//
// Logline: Bind a string literal to a local and println that ident.
//
// Setup: One public main. No greet. No concat.
//
// Beats:
//   1. Let msg be the ident-hi literal.
//   2. Print that ident.
//   3. Leave no other statements.

pub fn main() {
    let msg = "ident-hi";
    println(msg);
}
