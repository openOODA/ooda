// # Product prove std/media_dsp/png_chunk_ihdr_idat.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_color_type_grayscale is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/png_chunk_ihdr_idat.oo.
//
// Beats:
//   1. Call png_color_type_grayscale twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_png_chunk_ihdr_idat: PASSED only if they match.

import "std/media_dsp/png_chunk_ihdr_idat.oo";

pub fn main() {
    let png_chunk_ihdr_idat_mark: Int = 0;
    if png_chunk_ihdr_idat_mark != 0 {
        process_exit(1);
    }
    let png_chunk_ihdr_idat_a: Int = png_color_type_grayscale();
    let png_chunk_ihdr_idat_b: Int = png_color_type_grayscale();
    if png_chunk_ihdr_idat_a != png_chunk_ihdr_idat_b {
        println("FAIL png_color_type_grayscale");
        process_exit(1);
    }
    println("prod_png_chunk_ihdr_idat: PASSED");
}
