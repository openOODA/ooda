// # Product prove std/synthetic_biology/promoter_leakiness_tna.oo
//
// Logline: Fail-closed emit+gcc+run asserts promoter_math_log10 is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/promoter_leakiness_tna.oo.
//
// Beats:
//   1. Call promoter_math_log10 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_promoter_leakiness_tna: PASSED only if they match.

import "std/synthetic_biology/promoter_leakiness_tna.oo";

pub fn main() {
    let promoter_leakiness_tna_mark: Int = 0;
    if promoter_leakiness_tna_mark != 0 {
        process_exit(1);
    }
    let promoter_leakiness_tna_a: Float = promoter_math_log10(1.0);
    let promoter_leakiness_tna_b: Float = promoter_math_log10(1.0);
    if promoter_leakiness_tna_a != promoter_leakiness_tna_b {
        println("FAIL promoter_math_log10");
        process_exit(1);
    }
    println("prod_promoter_leakiness_tna: PASSED");
}
