// # Product prove std/compilers/macho_segment.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/macho_segment.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/macho_segment.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_macho_segment: PASSED only if they match.

import "std/compilers/macho_segment.oo";

pub fn main() {
    let macho_segment_a = macho_segment_command64_bytes();
    let macho_segment_b = macho_segment_command64_bytes();
    if macho_segment_a != macho_segment_b {
        println("FAIL macho_segment");
        process_exit(1);
    }
    println("prod_ap_macho_segment: PASSED");
}
