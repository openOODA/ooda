// # Product prove std/embedded_hal/uart_dma_ring.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/uart_dma_ring.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/uart_dma_ring.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_uart_dma_ring: PASSED only if they match.

import "std/embedded_hal/uart_dma_ring.oo";

pub fn main() {
    let uart_dma_ring_a = uart_config_new(0, 0);
    let uart_dma_ring_b = uart_config_new(0, 0);
    if uart_dma_ring_a.uart_id != uart_dma_ring_b.uart_id {
        println("FAIL uart_dma_ring");
        process_exit(1);
    }
    println("prod_ap_uart_dma_ring: PASSED");
}
