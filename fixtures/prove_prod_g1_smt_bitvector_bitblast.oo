// # Product prove std/formal_verif/smt_bitvector_bitblast.oo
//
// Logline: Fail-closed emit+gcc+run asserts bv_circuit_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/smt_bitvector_bitblast.oo.
//
// Beats:
//   1. Call bv_circuit_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smt_bitvector_bitblast: PASSED only if they match.

import "std/formal_verif/smt_bitvector_bitblast.oo";

pub fn main() {
    let a: BvCircuit = bv_circuit_new(0, 0);
    let b: BvCircuit = bv_circuit_new(0, 0);
    if a.width != b.width {
        println("FAIL bv_circuit_new");
        process_exit(1);
    }
    println("prod_smt_bitvector_bitblast: PASSED");
}
