// # Product prove std/pqc_nist/pqc_crypto_agility.oo
//
// Logline: Fail-closed emit+gcc+run asserts agility_policy_cnsa_20 is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_crypto_agility.oo.
//
// Beats:
//   1. Call agility_policy_cnsa_20 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pqc_crypto_agility: PASSED only if they match.

import "std/pqc_nist/pqc_crypto_agility.oo";

pub fn main() {
    let pqc_crypto_agility_mark: Int = 0;
    if pqc_crypto_agility_mark != 0 {
        process_exit(1);
    }
    let a: AgilityPolicy = agility_policy_cnsa_20();
    let b: AgilityPolicy = agility_policy_cnsa_20();
    if (a).minimum_security_level != (b).minimum_security_level {
        println("FAIL agility_policy_cnsa_20");
        process_exit(1);
    }
    println("prod_g2_pqc_crypto_agility: PASSED");
}
