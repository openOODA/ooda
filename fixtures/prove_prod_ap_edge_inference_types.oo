// # Product prove std/edge/inference_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/inference_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_inference_types: PASSED only if they match.

import "std/edge/inference_types.oo";

pub fn main() {
    let inference_types_a = model_config_new(0, 0, 0);
    let inference_types_b = model_config_new(0, 0, 0);
    let inference_types_va = model_config_batch(inference_types_a);
    let inference_types_vb = model_config_batch(inference_types_b);
    if inference_types_va != inference_types_vb {
        println("FAIL inference_types");
        process_exit(1);
    }
    println("prod_ap_inference_types: PASSED");
}
