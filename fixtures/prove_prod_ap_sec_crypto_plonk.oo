// # Product prove std/sec/crypto/plonk.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/plonk.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plonk: PASSED only if they match.

import "std/sec/crypto/plonk.oo";

pub fn main() {
    let plonk_a = shim_marker_mod_add();
    let plonk_b = shim_marker_mod_add();
    if plonk_a != plonk_b {
        println("FAIL plonk");
        process_exit(1);
    }
    println("prod_ap_plonk: PASSED");
}
