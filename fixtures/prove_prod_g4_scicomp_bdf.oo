// # Product prove std/scicomp/ode_bdf_stiff.oo
//
// Logline: Fail-closed verification that BDF1 and BDF2 stiff ODE step integrators and configurations are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/ode_bdf_stiff.oo.
//
// Beats:
//   1. Construct default BdfConfig and assert parameters.
//   2. Compute BDF1 linear implicit step for a scalar decay ODE.
//   3. Compute BDF2 multi-step linear implicit step.
//   4. Print prod_g4_scicomp_bdf: PASSED and exit 0.

import "std/scicomp/ode_bdf_stiff.oo";

pub fn main() {
    let cfg1: BdfConfig = bdf_config_default();
    let cfg2: BdfConfig = bdf_config_default();
    if (cfg1).max_order != (cfg2).max_order || (cfg1).max_order != 2 || (cfg1).newton_max_iters != 10 {
        println("FAIL bdf_config_default");
        process_exit(1);
    }

    let mut mat_a: DenseMatrix = dense_mat_new(1, 1);
    dense_mat_set(mat_a, 0, 0, 0.0 - 2.0);

    let mut y_n: List[Float] = list_new();
    y_n = list_push(y_n, 10.0);

    let res_bdf1_a: List[Float] = bdf1_step_linear(&y_n, 0.5, &mat_a);
    let res_bdf1_b: List[Float] = bdf1_step_linear(&y_n, 0.5, &mat_a);

    let val_bdf1: Float = list_get(res_bdf1_a, 0);
    if val_bdf1 != list_get(res_bdf1_b, 0) || val_bdf1 < 4.999 || val_bdf1 > 5.001 {
        println("FAIL bdf1_step_linear");
        process_exit(1);
    }

    let mut mat_zero: DenseMatrix = dense_mat_new(1, 1);
    dense_mat_set(mat_zero, 0, 0, 0.0);

    let mut y_n_const: List[Float] = list_new();
    y_n_const = list_push(y_n_const, 3.0);

    let mut y_prev: List[Float] = list_new();
    y_prev = list_push(y_prev, 3.0);

    let res_bdf2_a: List[Float] = bdf2_step_linear(&y_n_const, &y_prev, 0.1, &mat_zero);
    let res_bdf2_b: List[Float] = bdf2_step_linear(&y_n_const, &y_prev, 0.1, &mat_zero);

    let val_bdf2: Float = list_get(res_bdf2_a, 0);
    if val_bdf2 != list_get(res_bdf2_b, 0) || val_bdf2 < 2.999 || val_bdf2 > 3.001 {
        println("FAIL bdf2_step_linear");
        process_exit(1);
    }

    println("prod_g4_scicomp_bdf: PASSED");
    process_exit(0);
}
