// # ThreadCap pthread spawn
//
// Logline: Spawn a joinable worker thread under ThreadCap.
//
// Beats:
//   1. Take thread: &ThreadCap on main.
//   2. thread_spawn(thread, "worker").
//   3. Print thread-spawn-ok on Ok.

// M162/M163 path A: real joinable pthread_create under ThreadCap (returns tid:N)
pub fn main(thread: &ThreadCap) {
    let r: Result[String, String] = thread_spawn(thread, "worker");
    if r.is_ok() {
        println("thread-spawn-ok");
    } else {
        println("thread-spawn-fail");
    }
}
