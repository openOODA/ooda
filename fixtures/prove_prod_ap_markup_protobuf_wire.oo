// # Product prove std/markup/protobuf_wire.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/protobuf_wire.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/protobuf_wire.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protobuf_wire: PASSED only if they match.

import "std/markup/protobuf_wire.oo";

pub fn main() {
    let protobuf_wire_a = pb_wire_varint();
    let protobuf_wire_b = pb_wire_varint();
    if protobuf_wire_a != protobuf_wire_b {
        println("FAIL protobuf_wire");
        process_exit(1);
    }
    println("prod_ap_protobuf_wire: PASSED");
}
