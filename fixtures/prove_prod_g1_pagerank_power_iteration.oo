// # Product prove std/graph_topology/pagerank_power_iteration.oo
//
// Logline: Fail-closed emit+gcc+run asserts pagerank_power_iteration_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/pagerank_power_iteration.oo.
//
// Beats:
//   1. Call pagerank_power_iteration_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pagerank_power_iteration: PASSED only if they match.

import "std/graph_topology/pagerank_power_iteration.oo";

pub fn main() {
    let a: Int = pagerank_power_iteration_probe();
    let b: Int = pagerank_power_iteration_probe();
    if a != 0 {
        println("FAIL pagerank_power_iteration_probe");
        process_exit(1);
    }
    if a != b {
        println("FAIL pagerank_power_iteration_probe");
        process_exit(1);
    }
    println("prod_pagerank_power_iteration: PASSED");
}
