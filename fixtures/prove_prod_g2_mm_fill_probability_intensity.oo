// # Product prove std/hft_alpha/mm_fill_probability_intensity.oo
//
// Logline: Fail-closed emit+gcc+run asserts intensity_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_fill_probability_intensity.oo.
//
// Beats:
//   1. Call intensity_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_fill_probability_intensity: PASSED only if they match.

import "std/hft_alpha/mm_fill_probability_intensity.oo";

pub fn main() {
    let mm_fill_probability_intensity_mark: Int = 0;
    if mm_fill_probability_intensity_mark != 0 {
        process_exit(1);
    }
    let a: IntensityParams = intensity_params_new(0.0, 0.0, 0.0);
    let b: IntensityParams = intensity_params_new(0.0, 0.0, 0.0);
    if (a).scale_a != (b).scale_a {
        println("FAIL intensity_params_new");
        process_exit(1);
    }
    println("prod_g2_mm_fill_probability_intensity: PASSED");
}
