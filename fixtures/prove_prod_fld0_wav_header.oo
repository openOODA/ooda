// # Product prove std/multimedia/wav_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts wav_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/wav_header.oo.
//
// Beats:
//   1. Call wav_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wav_header: PASSED only if they match.

import "std/multimedia/wav_header.oo";

pub fn main() {
    let wav_header_mark: Int = 0;
    if wav_header_mark != 0 {
        process_exit(1);
    }
    let wav_header_ra: Result[WavHeader, String] = wav_header_new(1, 1, 1, 1);
    let wav_header_rb: Result[WavHeader, String] = wav_header_new(1, 1, 1, 1);
    let wav_header_a: Bool = wav_header_ra.is_ok();
    let wav_header_b: Bool = wav_header_rb.is_ok();
    if wav_header_a != wav_header_b {
        println("FAIL wav_header_new");
        process_exit(1);
    }
    println("prod_wav_header: PASSED");
}
