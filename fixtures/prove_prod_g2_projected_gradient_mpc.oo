// # Product prove std/auto_mpc_control/projected_gradient_mpc.oo
//
// Logline: Fail-closed emit+gcc+run asserts projected_grad_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/projected_gradient_mpc.oo.
//
// Beats:
//   1. Call projected_grad_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_projected_gradient_mpc: PASSED only if they match.

import "std/auto_mpc_control/projected_gradient_mpc.oo";

pub fn main() {
    let projected_gradient_mpc_mark: Int = 0;
    if projected_gradient_mpc_mark != 0 {
        process_exit(1);
    }
    let a: ProjectedGradConfig = projected_grad_config_default();
    let b: ProjectedGradConfig = projected_grad_config_default();
    if (a).max_iter != (b).max_iter {
        println("FAIL projected_grad_config_default");
        process_exit(1);
    }
    println("prod_g2_projected_gradient_mpc: PASSED");
}
