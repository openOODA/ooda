// # Product prove std/fin/aml_ops.oo
//
// Logline: Fail-closed verification that AML batch rule evaluation and compliance profiling are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_ops.oo.
//
// Beats:
//   1. Construct transaction nodes, pattern rules, and compliance profiles.
//   2. Batch evaluate transactions against AML pattern rules.
//   3. Update compliance profiles and assert deterministic metrics.
//   4. Print prod_g4_fin_aml_ops: PASSED and exit 0.

import "std/fin/aml_ops.oo";

pub fn main() {
    let probe1: Int = aml_ops_probe();
    let probe2: Int = aml_ops_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL aml_ops_probe");
        process_exit(1);
    }

    let tx1: TransactionNode = transaction_node_new("TX1001", "ACC_A", "ACC_B", 950000, 1700000000, "WIRE", "US", false);
    let tx2: TransactionNode = transaction_node_new("TX1001", "ACC_A", "ACC_B", 950000, 1700000000, "WIRE", "US", false);

    let rule1: PatternRule = pattern_rule_new("R_LARGE", "Large Wire", 500000, 86400, 5, 30, true);
    let rule2: PatternRule = pattern_rule_new("R_LARGE", "Large Wire", 500000, 86400, 5, 30, true);

    let mut list1: List[TransactionNode] = list_new();
    list1 = list_push(list1, tx1);

    let mut list2: List[TransactionNode] = list_new();
    list2 = list_push(list2, tx2);

    let trig1: Int = aml_batch_evaluate_transactions(list1, rule1);
    let trig2: Int = aml_batch_evaluate_transactions(list2, rule2);
    if trig1 != trig2 || trig1 != 1 {
        println("FAIL aml_batch_evaluate_transactions");
        process_exit(1);
    }

    let prof1: ComplianceProfile = compliance_profile_new("ACC_A", true, false);
    let prof2: ComplianceProfile = compliance_profile_new("ACC_A", true, false);

    let upd1: ComplianceProfile = aml_update_compliance_profile(prof1, 950000, true);
    let upd2: ComplianceProfile = aml_update_compliance_profile(prof2, 950000, true);

    if (upd1).total_volume != (upd2).total_volume || (upd1).total_volume != 950000 {
        println("FAIL aml_update_compliance_profile volume");
        process_exit(1);
    }
    if (upd1).flagged_count != (upd2).flagged_count || (upd1).flagged_count != 1 {
        println("FAIL aml_update_compliance_profile flagged");
        process_exit(1);
    }

    println("prod_g4_fin_aml_ops: PASSED");
    process_exit(0);
}
