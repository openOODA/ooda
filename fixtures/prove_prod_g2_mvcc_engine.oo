// # Product prove std/database/mvcc_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts mvcc_engine_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/mvcc_engine.oo.
//
// Beats:
//   1. Call mvcc_engine_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mvcc_engine: PASSED only if they match.

import "std/database/mvcc_engine.oo";

pub fn main() {
    let a: MvccEngine = mvcc_engine_init();
    let b: MvccEngine = mvcc_engine_init();
    if (a).next_tx_id != (b).next_tx_id {
        println("FAIL mvcc_engine_init");
        process_exit(1);
    }
    println("prod_g2_mvcc_engine: PASSED");
}
