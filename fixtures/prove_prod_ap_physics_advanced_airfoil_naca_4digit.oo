// # Product prove std/physics_advanced/airfoil_naca_4digit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/airfoil_naca_4digit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/airfoil_naca_4digit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_airfoil_naca_4digit: PASSED only if they match.

import "std/physics_advanced/airfoil_naca_4digit.oo";

pub fn main() {
    let airfoil_naca_4digit_a = naca4_camber_line(0.0, 0.0, 0.0);
    let airfoil_naca_4digit_b = naca4_camber_line(0.0, 0.0, 0.0);
    if airfoil_naca_4digit_a != airfoil_naca_4digit_b {
        println("FAIL airfoil_naca_4digit");
        process_exit(1);
    }
    println("prod_ap_airfoil_naca_4digit: PASSED");
