// # Product prove std/gis_topo/spatial_overlay_clipping.oo
//
// Logline: Fail-closed emit+gcc+run asserts clipped_polygon_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/spatial_overlay_clipping.oo.
//
// Beats:
//   1. Call clipped_polygon_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_spatial_overlay_clipping: PASSED only if they match.

import "std/gis_topo/spatial_overlay_clipping.oo";

pub fn main() {
    let spatial_overlay_clipping_mark: Int = 0;
    if spatial_overlay_clipping_mark != 0 {
        process_exit(1);
    }
    let a: ClippedPolygon2D = clipped_polygon_new();
    let b: ClippedPolygon2D = clipped_polygon_new();
    if (a).num_points != (b).num_points {
        println("FAIL clipped_polygon_new");
        process_exit(1);
    }
    println("prod_g2_spatial_overlay_clipping: PASSED");
}
