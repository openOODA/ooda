// # Product prove std/sec/crypto/tpm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/tpm_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tpm_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tpm_types: PASSED only if they match.

import "std/sec/crypto/tpm_types.oo";

pub fn main() {
    let tpm_types_a = tpm_nv_new(0, 0, 0);
    let tpm_types_b = tpm_nv_new(0, 0, 0);
    let tpm_types_va = tpm_nv_id(tpm_types_a);
    let tpm_types_vb = tpm_nv_id(tpm_types_b);
    if tpm_types_va != tpm_types_vb {
        println("FAIL tpm_types");
        process_exit(1);
    }
    println("prod_ap_tpm_types: PASSED");
}
