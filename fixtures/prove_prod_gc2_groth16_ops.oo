// # Product prove std/sec/crypto/groth16_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts groth16_ops_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_ops.oo.
//
// Beats:
//   1. Call groth16_ops_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_groth16_ops: PASSED only if they match.

import "std/sec/crypto/groth16_ops.oo";

pub fn main() {
    let groth16_ops_mark: Int = 0;
    if groth16_ops_mark != 0 {
        process_exit(1);
    }
    let groth16_ops_a = groth16_ops_init(1, 1);
    let groth16_ops_b = groth16_ops_init(1, 1);
    if (groth16_ops_a).curve_id != (groth16_ops_b).curve_id {
        println("FAIL groth16_ops_init");
        process_exit(1);
    }
    println("prod_groth16_ops: PASSED");
}
