// # Product prove std/robotics_ros2/kinematics_forward_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix4x4_identity holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/kinematics_forward_chain.oo.
//
// Beats:
//   1. Call matrix4x4_identity using the kinematics_forward_chain ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_kinematics_forward_chain: PASSED only if asserts hold.

import "std/robotics_ros2/kinematics_forward_chain.oo";

pub fn main() {
    let obj = matrix4x4_identity();
    let kinematics_forward_chain_a = obj.r11;
    if kinematics_forward_chain_a != 1.0 {
        println("FAIL matrix4x4_identity");
        process_exit(1);
    }
    println("prod_kinematics_forward_chain: PASSED");
}
