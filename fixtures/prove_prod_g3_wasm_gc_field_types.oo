// # Product prove std/wasm_gc/wasm_gc_field_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_gc_field_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_field_types.oo.
//
// Beats:
//   1. Call wasm_gc_field_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_field_types: PASSED only if they match.

import "std/wasm_gc/wasm_gc_field_types.oo";

pub fn main() {
    let wasm_gc_field_types_mark: Int = 0;
    if wasm_gc_field_types_mark != 0 {
        process_exit(1);
    }
    let a: WasmGcField = wasm_gc_field_new(0, 0);
    let b: WasmGcField = wasm_gc_field_new(0, 0);
    if (a).storage != (b).storage {
        println("FAIL wasm_gc_field_new");
        process_exit(1);
    }
    println("prod_wasm_gc_field_types: PASSED");
}
