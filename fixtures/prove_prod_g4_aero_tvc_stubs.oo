// # Product prove std/aero/tvc_stubs.oo
//
// Logline: Fail-closed verification that TVC stubs module readiness and gimbal constants are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_stubs.oo.
//
// Beats:
//   1. Call tvc_module_ready and assert boolean status.
//   2. Calculate and verify TVC mathematical conversion constants.
//   3. Assert deterministic execution.
//   4. Print prod_g4_aero_tvc_stubs: PASSED and exit 0.

import "std/aero/tvc_stubs.oo";

pub fn main() {
    let ready_a: Bool = tvc_module_ready();
    let ready_b: Bool = tvc_module_ready();
    if ready_a != ready_b || !ready_a {
        println("FAIL tvc_module_ready");
        process_exit(1);
    }

    let pi_a: Float = tvc_pi();
    let pi_b: Float = tvc_pi();
    if pi_a != pi_b || pi_a <= 3.0 {
        println("FAIL tvc_pi");
        process_exit(1);
    }

    let rad_a: Float = tvc_deg_to_rad(180.0);
    let rad_b: Float = tvc_deg_to_rad(180.0);
    if rad_a != rad_b {
        println("FAIL tvc_deg_to_rad");
        process_exit(1);
    }

    println("prod_g4_aero_tvc_stubs: PASSED");
    process_exit(0);
}
