// # Product prove std/test/fuzz.oo
//
// Logline: Fail-closed emit+gcc+run asserts fuzz_next_seed is deterministic.
//
// Setup: Isolated emit-c. Imports std/test/fuzz.oo.
//
// Beats:
//   1. Call fuzz_next_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fuzz: PASSED only if they match.

import "std/test/fuzz.oo";

pub fn main() {
    let a = fuzz_next_seed(0);
    let b = fuzz_next_seed(0);
    if a != b {
        println("FAIL fuzz_next_seed");
        process_exit(1);
    }
    println("prod_fuzz: PASSED");
}
