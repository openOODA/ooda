// # Product prove std/bft_consensus/hotstuff_safety_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/hotstuff_safety_rules.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_safety_rules.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hotstuff_safety_rules: PASSED only if they match.

import "std/bft_consensus/hotstuff_safety_rules.oo";

pub fn main() {
    let hotstuff_safety_rules_a = safety_state_new(0);
    let hotstuff_safety_rules_b = safety_state_new(0);
    let hotstuff_safety_rules_va = safety_can_vote(hotstuff_safety_rules_a, 0, 0, "x");
    let hotstuff_safety_rules_vb = safety_can_vote(hotstuff_safety_rules_b, 0, 0, "x");
    if hotstuff_safety_rules_va != hotstuff_safety_rules_vb {
        println("FAIL hotstuff_safety_rules");
        process_exit(1);
    }
    println("prod_ap_hotstuff_safety_rules: PASSED");
}
