// # Product prove std/gis_spatial/geodesic_vincenty.oo
//
// Logline: Fail-closed emit+gcc+run asserts vincenty_inverse is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/geodesic_vincenty.oo.
//
// Beats:
//   1. Call vincenty_inverse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geodesic_vincenty: PASSED only if they match.

import "std/gis_spatial/geodesic_vincenty.oo";

pub fn main() {
    let geodesic_vincenty_mark: Int = 0;
    if geodesic_vincenty_mark != 0 {
        process_exit(1);
    }
    let a: VincentyInverseResult = vincenty_inverse(0.0, 0.0, 0.0, 0.0);
    let b: VincentyInverseResult = vincenty_inverse(0.0, 0.0, 0.0, 0.0);
    if (a).distance_m != (b).distance_m {
        println("FAIL vincenty_inverse");
        process_exit(1);
    }
    println("prod_geodesic_vincenty: PASSED");
}
