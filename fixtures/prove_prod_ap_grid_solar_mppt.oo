// # Product prove std/grid/solar_mppt.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/solar_mppt.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/grid/solar_mppt.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_solar_mppt: PASSED only if they match.

import "std/grid/solar_mppt.oo";

pub fn main() {
    let solar_mppt_a = mppt_state_new(0, 0.0, 0.0);
    let solar_mppt_b = mppt_state_new(0, 0.0, 0.0);
    if solar_mppt_a.mode != solar_mppt_b.mode {
        println("FAIL solar_mppt");
        process_exit(1);
    }
    println("prod_ap_solar_mppt: PASSED");
}
