// # Product prove std/sync/token_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/token_bucket.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/token_bucket.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_token_bucket: PASSED only if they match.

import "std/sync/token_bucket.oo";

pub fn main() {
    let token_bucket_a = token_bucket_new(0, 0);
    let token_bucket_b = token_bucket_new(0, 0);
    if token_bucket_a.capacity != token_bucket_b.capacity {
        println("FAIL token_bucket");
        process_exit(1);
    }
    println("prod_ap_token_bucket: PASSED");
}
