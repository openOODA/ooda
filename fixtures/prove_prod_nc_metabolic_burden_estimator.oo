// # Product prove std/synthetic_biology/metabolic_burden_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts metabolic_burden_estimator_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/metabolic_burden_estimator.oo.
//
// Beats:
//   1. Call metabolic_burden_estimator_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_metabolic_burden_estimator: PASSED only if it matches.

import "std/synthetic_biology/metabolic_burden_estimator.oo";

pub fn main() {
    let a: Int = metabolic_burden_estimator_probe();
    if a != 0 {
        println("FAIL metabolic_burden_estimator_probe");
        process_exit(1);
    }
    println("prod_nc_metabolic_burden_estimator: PASSED");
}
