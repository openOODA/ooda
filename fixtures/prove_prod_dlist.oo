// Logline: Fail-closed emit+gcc+run of shipped dlist_push_back/size.
//
// Setup: Product std/collections/linked_list_doubly.oo. List[Int] destub.
//
// Beats:
//   1. After push_back 7, size 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/linked_list_doubly.oo";

pub fn main() {
    let mut l: DoublyLinkedList = dlist_new();
    l = dlist_push_back(l, 7);
    let n: Int = l.size;
    if n != 1 {
        println("FAIL dlist size");
        process_exit(1);
    }
    println("prod_dlist: PASSED");
}
