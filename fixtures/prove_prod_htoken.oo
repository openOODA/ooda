// # Product cloud_k8s hash token prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/consistent_hash_ring.oo.
//
// Setup: Product std/cloud_k8s/consistent_hash_ring.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. hash_string_token(1, 0) is 233391245.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/consistent_hash_ring.oo";

pub fn main() {
    let h: Int = hash_string_token(1, 0);
    if h != 233391245 {
        println("FAIL htoken");
        process_exit(1);
    }
    let z: Int = hash_string_token(0, 0);
    if z != 216613626 {
        println("FAIL htoken0");
        process_exit(1);
    }
    println("prod_htoken: PASSED");
}
