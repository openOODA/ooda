// # Product prove std/embedded_hal/usb_device_cdc.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/usb_device_cdc.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/usb_device_cdc.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_usb_device_cdc: PASSED only if they match.

import "std/embedded_hal/usb_device_cdc.oo";

pub fn main() {
    let usb_device_cdc_a = usb_cdc_line_coding_new(0);
    let usb_device_cdc_b = usb_cdc_line_coding_new(0);
    if usb_device_cdc_a.baud_rate != usb_device_cdc_b.baud_rate {
        println("FAIL usb_device_cdc");
        process_exit(1);
    }
    println("prod_ap_usb_device_cdc: PASSED");
}
