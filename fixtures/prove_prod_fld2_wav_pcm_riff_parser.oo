// # Product prove std/media_dsp/wav_pcm_riff_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts wav_format_pcm is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/wav_pcm_riff_parser.oo.
//
// Beats:
//   1. Call wav_format_pcm twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wav_pcm_riff_parser: PASSED only if they match.

import "std/media_dsp/wav_pcm_riff_parser.oo";

pub fn main() {
    let wav_pcm_riff_parser_mark: Int = 0;
    if wav_pcm_riff_parser_mark != 0 {
        process_exit(1);
    }
    let wav_pcm_riff_parser_a: Int = wav_format_pcm();
    let wav_pcm_riff_parser_b: Int = wav_format_pcm();
    if wav_pcm_riff_parser_a != wav_pcm_riff_parser_b {
        println("FAIL wav_format_pcm");
        process_exit(1);
    }
    println("prod_wav_pcm_riff_parser: PASSED");
}
