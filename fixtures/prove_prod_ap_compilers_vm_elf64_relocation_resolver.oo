// # Product prove std/compilers_vm/elf64_relocation_resolver.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/elf64_relocation_resolver.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/elf64_relocation_resolver.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf64_relocation_resolver: PASSED only if they match.

import "std/compilers_vm/elf64_relocation_resolver.oo";

pub fn main() {
    let elf64_relocation_resolver_a = r_x86_64_none();
    let elf64_relocation_resolver_b = r_x86_64_none();
    if elf64_relocation_resolver_a != elf64_relocation_resolver_b {
        println("FAIL elf64_relocation_resolver");
        process_exit(1);
    }
    println("prod_ap_elf64_relocation_resolver: PASSED");
}
