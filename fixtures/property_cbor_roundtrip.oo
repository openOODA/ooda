// # Property Test: CBOR Major Type Roundtrip
//
// Logline: Verifies that each of the 7 CBOR major types (uint, nint, bstr, tstr, array, map, tag, simple) is recognized and not confused with each other.
//
// Setup: Pure .oo. Asserts that the major type integers match the RFC 8949 specification.
//
// Beats:
//   1. Assert major uint = 0, nint = 1, bstr = 2, tstr = 3, array = 4, map = 5, tag = 6, simple = 7.
//   2. Assert all 8 are distinct.
//   3. Print PASSED or FAIL.

import "std/markup/cbor.oo";

pub fn main() {
    let u: Int = cbor_major_uint();
    let n: Int = cbor_major_nint();
    let b: Int = cbor_major_bstr();
    let t: Int = cbor_major_tstr();
    let a: Int = cbor_major_array();
    let m: Int = cbor_major_map();
    let g: Int = cbor_major_tag();
    let s: Int = cbor_major_simple();
    let mut ok: Int = 1;
    if u != 0 { println("FAIL_uint=" + u.to_string()); ok = 0; }
    if n != 1 { println("FAIL_nint=" + n.to_string()); ok = 0; }
    if b != 2 { println("FAIL_bstr=" + b.to_string()); ok = 0; }
    if t != 3 { println("FAIL_tstr=" + t.to_string()); ok = 0; }
    if a != 4 { println("FAIL_array=" + a.to_string()); ok = 0; }
    if m != 5 { println("FAIL_map=" + m.to_string()); ok = 0; }
    if g != 6 { println("FAIL_tag=" + g.to_string()); ok = 0; }
    if s != 7 { println("FAIL_simple=" + s.to_string()); ok = 0; }
    if ok == 1 {
        println("cbor_roundtrip: PASSED 8_majors_distinct");
    } else {
        println("cbor_roundtrip: FAILED");
        process_exit(1);
    }
}
