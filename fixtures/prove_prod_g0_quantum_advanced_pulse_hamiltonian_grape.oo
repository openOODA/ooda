// # Product prove std/quantum_advanced/pulse_hamiltonian_grape.oo
//
// Logline: Fail-closed emit+gcc+run asserts grape_fidelity_overlap is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/pulse_hamiltonian_grape.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call grape_fidelity_overlap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_pulse_hamiltonian_grape: PASSED only if they match.

import "std/quantum_advanced/pulse_hamiltonian_grape.oo";

pub fn main() {
    let g0_a = grape_fidelity_overlap(1.0, 1.0, 2);
    let g0_b = grape_fidelity_overlap(1.0, 1.0, 2);
    if g0_a != g0_b {
        println("FAIL grape_fidelity_overlap");
        process_exit(1);
    }
    println("prod_g0_pulse_hamiltonian_grape: PASSED");
}
