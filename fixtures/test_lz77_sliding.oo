// # LZ77 sliding window adversarial suite
//
// Logline: Proves 4KB window and 258 match bounds, out-of-window reject, and bit-exact binary roundtrip.
//
// Setup: Pure. Imports std/compression/lz77_sliding.oo. Run from ooda/.
//
// Beats:
//   1. Roundtrip mixed binary including overlapping repeats.
//   2. Reject an offset past the 4KB window and a match longer than 258.
//   3. Print the live window and match caps from the shipped functions.

import "std/compression/lz77_sliding.oo";

fn need(flag: Int, err: String, bytes: List[Int], msg: String) -> List[Int] {
    if flag < 1 {
        println("FAIL " + msg + ": " + err);
        process_exit(1);
    }
    return bytes;
}

fn eq_bytes(a: List[Int], b: List[Int]) -> Bool {
    if list_len(a) != list_len(b) {
        return false;
    }
    let mut i: Int = 0;
    while i < list_len(a) {
        if list_get(a, i) != list_get(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn main() {
    if lz77_sliding_window() != 4096 {
        println("FAIL window cap");
        process_exit(1);
    }
    if lz77_sliding_max_match() != 258 {
        println("FAIL match cap");
        process_exit(1);
    }
    println("window bound 4KB and match cap 258 are enforced");

    let mut bin: List[Int] = list_new();
    bin = list_push(bin, 0);
    bin = list_push(bin, 255);
    bin = list_push(bin, 1);
    bin = list_push(bin, 1);
    bin = list_push(bin, 1);
    bin = list_push(bin, 1);
    bin = list_push(bin, 2);
    bin = list_push(bin, 128);
    bin = list_push(bin, 128);
    bin = list_push(bin, 128);
    let enc: ByteOut = lz77_sliding_compress(bin);
    let tok: List[Int] = need(enc.flag, enc.err, enc.bytes, "enc");
    let dec: ByteOut = lz77_sliding_decompress(tok);
    let out: List[Int] = need(dec.flag, dec.err, dec.bytes, "dec");
    if eq_bytes(bin, out) == false {
        println("FAIL binary roundtrip");
        process_exit(1);
    }
    println("lossless bit-exact roundtrip on arbitrary binary");

    let mut bad: List[Int] = list_new();
    bad = list_push(bad, 0);
    bad = list_push(bad, 0);
    bad = list_push(bad, 7);
    bad = list_push(bad, 4097);
    bad = list_push(bad, 3);
    bad = list_push(bad, 9);
    let ow: ByteOut = lz77_sliding_decompress(bad);
    let owf: Int = ow.flag;
    if owf > 0 {
        println("FAIL out of window not err");
        process_exit(1);
    }
    println("out-of-window lookback is Err");

    let mut cap: List[Int] = list_new();
    cap = list_push(cap, 0);
    cap = list_push(cap, 0);
    cap = list_push(cap, 1);
    cap = list_push(cap, 1);
    cap = list_push(cap, 259);
    cap = list_push(cap, 2);
    let mc: ByteOut = lz77_sliding_decompress(cap);
    let mcf: Int = mc.flag;
    if mcf > 0 {
        println("FAIL match cap not err");
        process_exit(1);
    }

    let st: Result[Int, String] = lz77_sliding_decompress_stat(bad);
    if st.is_ok() {
        println("FAIL stat ok");
        process_exit(1);
    }
    println("SUITE PASSED");
    println("test_lz77_sliding: PASSED");
}
