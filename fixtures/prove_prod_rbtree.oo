// # Product red_black_tree prove
//
// Logline: Fail-closed emit+gcc+run of shipped rb_tree_insert/contains/len.
//
// Setup: Product std/collections/red_black_tree.oo. Sorted List[Int] stand-in.
//
// Beats:
//   1. After insert 3, len 1; contains 3 true; contains 2 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/red_black_tree.oo";

pub fn main() {
    let mut t: RedBlackTree = rb_tree_new();
    t = rb_tree_insert(t, 3);
    let n: Int = rb_tree_len(t);
    if n != 1 {
        println("FAIL rbtree len");
        process_exit(1);
    }
    let c3: Bool = rb_tree_contains(t, 3);
    if c3 == false {
        println("FAIL rbtree contains 3");
        process_exit(1);
    }
    let c2: Bool = rb_tree_contains(t, 2);
    if c2 == true {
        println("FAIL rbtree contains 2");
        process_exit(1);
    }
    println("prod_rbtree: PASSED");
}
