// # Product prove std/quantum_advanced/vqe_hamiltonian_pauli.oo
//
// Logline: Fail-closed emit+gcc+run asserts paulis_commute_single is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_hamiltonian_pauli.oo.
//
// Beats:
//   1. Call paulis_commute_single twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vqe_hamiltonian_pauli: PASSED only if they match.

import "std/quantum_advanced/vqe_hamiltonian_pauli.oo";

pub fn main() {
    let vqe_hamiltonian_pauli_mark: Int = 0;
    if vqe_hamiltonian_pauli_mark != 0 {
        process_exit(1);
    }
    let a: Int = paulis_commute_single(0, 0);
    let b: Int = paulis_commute_single(0, 0);
    if a != b {
        println("FAIL paulis_commute_single");
        process_exit(1);
    }
    println("prod_g2_vqe_hamiltonian_pauli: PASSED");
}
