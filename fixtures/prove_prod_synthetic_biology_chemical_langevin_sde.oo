// # Product prove std/synthetic_biology/chemical_langevin_sde.oo
//
// Logline: Fail-closed emit+check asserts cle_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/chemical_langevin_sde.oo.
//
// Beats:
//   1. Call cle_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chemical_langevin_sde: PASSED only if they match.

import "std/synthetic_biology/chemical_langevin_sde.oo";

pub fn main() {
    let chemical_langevin_sde_mark: Int = 0;
    if chemical_langevin_sde_mark != 0 { process_exit(1); }
    let a: Float = cle_sqrt(4.0);
    let b: Float = cle_sqrt(4.0);
    if a != b { process_exit(1); }
    println("prod_chemical_langevin_sde: PASSED");
}
