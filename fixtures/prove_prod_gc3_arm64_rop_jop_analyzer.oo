// # Product prove std/exploit_analysis/arm64_rop_jop_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts arm64_chain_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/arm64_rop_jop_analyzer.oo.
//
// Beats:
//   1. Call arm64_chain_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arm64_rop_jop_analyzer: PASSED only if they match.

import "std/exploit_analysis/arm64_rop_jop_analyzer.oo";

pub fn main() {
    let arm64_rop_jop_analyzer_mark: Int = 0;
    if arm64_rop_jop_analyzer_mark != 0 {
        process_exit(1);
    }
    let arm64_rop_jop_analyzer_a = arm64_chain_plan_new();
    let arm64_rop_jop_analyzer_b = arm64_chain_plan_new();
    if (arm64_rop_jop_analyzer_a).total_stack_allocation != (arm64_rop_jop_analyzer_b).total_stack_allocation {
        println("FAIL arm64_chain_plan_new");
        process_exit(1);
    }
    println("prod_arm64_rop_jop_analyzer: PASSED");
}
