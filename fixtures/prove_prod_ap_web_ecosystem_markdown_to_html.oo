// # Product prove std/web_ecosystem/markdown_to_html.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/markdown_to_html.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/markdown_to_html.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_markdown_to_html: PASSED only if they match.

import "std/web_ecosystem/markdown_to_html.oo";

pub fn main() {
    let markdown_to_html_a = markdown_to_html("x");
    let markdown_to_html_b = markdown_to_html("x");
    if markdown_to_html_a.contains(markdown_to_html_b) == false {
        println("FAIL markdown_to_html");
        process_exit(1);
    }
    if markdown_to_html_b.contains(markdown_to_html_a) == false {
        println("FAIL markdown_to_html");
        process_exit(1);
    }
    println("prod_ap_markdown_to_html: PASSED");
}
