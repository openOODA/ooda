// # Product prove std/net/pay_pin.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_pin_on is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/pay_pin.oo.
//
// Beats:
//   1. Call pay_pin_on twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pay_pin: PASSED only if they match.

import "std/net/pay_pin.oo";

pub fn main() {
    let a = pay_pin_on("x");
    let b = pay_pin_on("x");
    if a != b {
        println("FAIL pay_pin_on");
        process_exit(1);
    }
    println("prod_pay_pin: PASSED");
}
