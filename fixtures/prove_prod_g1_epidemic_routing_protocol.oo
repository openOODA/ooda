// # Product prove std/graph_networks/epidemic_routing_protocol.oo
//
// Logline: Fail-closed emit+gcc+run asserts epidemic_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/epidemic_routing_protocol.oo.
//
// Beats:
//   1. Call epidemic_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_epidemic_routing_protocol: PASSED only if they match.

import "std/graph_networks/epidemic_routing_protocol.oo";

pub fn main() {
    let a: EpidemicRouter = epidemic_create(0, 1);
    let b: EpidemicRouter = epidemic_create(0, 1);
    if a.local_id != b.local_id {
        println("FAIL epidemic_create");
        process_exit(1);
    }
    println("prod_epidemic_routing_protocol: PASSED");
}
