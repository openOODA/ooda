// # Product prove std/zk_rollup/fri_folding_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts fri_fold_single_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_folding_operator.oo.
//
// Beats:
//   1. Call fri_fold_single_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fri_folding_operator: PASSED only if they match.

import "std/zk_rollup/fri_folding_operator.oo";

pub fn main() {
    let fri_folding_operator_mark: Int = 0;
    if fri_folding_operator_mark != 0 {
        process_exit(1);
    }
    let fri_folding_operator_a: Int = fri_fold_single_pair(1, 1, 1, 1);
    let fri_folding_operator_b: Int = fri_fold_single_pair(1, 1, 1, 1);
    if fri_folding_operator_a != fri_folding_operator_b {
        println("FAIL fri_fold_single_pair");
        process_exit(1);
    }
    println("prod_fri_folding_operator: PASSED");
}
