// # Product prove std/fintech_l3_book/market_tick_rule_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts tick_classifier_state_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/market_tick_rule_classifier.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tick_classifier_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_market_tick_rule_classifier: PASSED only if they match.

import "std/fintech_l3_book/market_tick_rule_classifier.oo";

pub fn main() {
    let g2_oa: TickClassifierState = tick_classifier_state_new("x");
    let g2_ob: TickClassifierState = tick_classifier_state_new("x");
    let g2_a = (g2_oa).last_trade_price_fixed;
    let g2_b = (g2_ob).last_trade_price_fixed;
    if g2_a != g2_b {
        println("FAIL tick_classifier_state_new.last_trade_price_fixed");
        process_exit(1);
    }
    println("prod_g2_market_tick_rule_classifier: PASSED");
}
