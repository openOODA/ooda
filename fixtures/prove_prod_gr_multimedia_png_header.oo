// # Product prove std/multimedia/png_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_magic_byte is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_header.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call png_magic_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_png_header: PASSED only if they match.

import "std/multimedia/png_header.oo";

pub fn main() {
    let g0_a = png_magic_byte(0);
    let g0_b = png_magic_byte(0);
    if g0_a != g0_b {
        println("FAIL png_magic_byte");
        process_exit(1);
    }
    println("prod_gr_png_header: PASSED");
}
