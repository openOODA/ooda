// # Product prove std/pqc_nist/pqc_side_channel_masking.oo
//
// Logline: Fail-closed emit+gcc+run asserts masking_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_side_channel_masking.oo.
//
// Beats:
//   1. Call masking_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pqc_side_channel_masking: PASSED only if they match.

import "std/pqc_nist/pqc_side_channel_masking.oo";

pub fn main() {
    let a: MaskingConfig = masking_config_default();
    let b: MaskingConfig = masking_config_default();
    if a.masking_order != b.masking_order {
        println("FAIL masking_config_default");
        process_exit(1);
    }
    println("prod_pqc_side_channel_masking: PASSED");
}
