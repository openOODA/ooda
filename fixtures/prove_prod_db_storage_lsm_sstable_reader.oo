// # Product prove std/db_storage/lsm_sstable_reader.oo
//
// Logline: Fail-closed emit+check asserts lsm_sstable_reader_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_sstable_reader.oo.
//
// Beats:
//   1. Call lsm_sstable_reader_probe twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_sstable_reader: PASSED only if they match.

import "std/db_storage/lsm_sstable_reader.oo";

pub fn main() {
    let lsm_sstable_reader_mark: Int = 0;
    if lsm_sstable_reader_mark != 0 { process_exit(1); }
    let a: Int = lsm_sstable_reader_probe();
    let b: Int = lsm_sstable_reader_probe();
    if a != b { process_exit(1); }
    println("prod_lsm_sstable_reader: PASSED");
}
