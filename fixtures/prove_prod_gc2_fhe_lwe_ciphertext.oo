// # Product prove std/fhe_lattices/fhe_lwe_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts lwe_encrypt is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_lwe_ciphertext.oo.
//
// Beats:
//   1. Call lwe_encrypt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_lwe_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_lwe_ciphertext.oo";

pub fn main() {
    let fhe_lwe_ciphertext_mark: Int = 0;
    if fhe_lwe_ciphertext_mark != 0 {
        process_exit(1);
    }
    let fhe_lwe_ciphertext_a = lwe_encrypt(list_new(), 1, 1, 1, list_new(), 1);
    let fhe_lwe_ciphertext_b = lwe_encrypt(list_new(), 1, 1, 1, list_new(), 1);
    if (fhe_lwe_ciphertext_a).b_scalar != (fhe_lwe_ciphertext_b).b_scalar {
        println("FAIL lwe_encrypt");
        process_exit(1);
    }
    println("prod_fhe_lwe_ciphertext: PASSED");
}
