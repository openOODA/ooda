// # Product cloud_k8s g-set prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/crdt_g_set.oo.
//
// Setup: Product std/cloud_k8s/crdt_g_set.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. add 7 len 1 contains 7. missing 0.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/crdt_g_set.oo";

pub fn main() {
    let s0: GSet = g_set_new();
    let n0: Int = g_set_len(s0);
    if n0 != 0 {
        println("FAIL gset 0");
        process_exit(1);
    }
    let s1: GSet = g_set_add(s0, 7);
    let n1: Int = g_set_len(s1);
    if n1 != 1 {
        println("FAIL gset 1");
        process_exit(1);
    }
    let hit: Int = g_set_contains(s1, 7);
    if hit != 1 {
        println("FAIL gset hit");
        process_exit(1);
    }
    let miss: Int = g_set_contains(s1, 9);
    if miss != 0 {
        println("FAIL gset miss");
        process_exit(1);
    }
    println("prod_gsetc: PASSED");
}
