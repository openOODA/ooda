// # Product prove std/auto_mpc_control/cornering_stiffness_observer.oo
//
// Logline: Fail-closed emit+gcc+run asserts stiffness_observer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/cornering_stiffness_observer.oo.
//
// Beats:
//   1. Call stiffness_observer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cornering_stiffness_observer: PASSED only if they match.

import "std/auto_mpc_control/cornering_stiffness_observer.oo";

pub fn main() {
    let a: StiffnessRLSState = stiffness_observer_new();
    let b: StiffnessRLSState = stiffness_observer_new();
    if a.cf_hat != b.cf_hat {
        println("FAIL stiffness_observer_new");
        process_exit(1);
    }
    println("prod_cornering_stiffness_observer: PASSED");
}
