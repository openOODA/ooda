// # Product prove std/ai_multimodal/vector_quantization_ema.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/vector_quantization_ema.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vector_quantization_ema.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_quantization_ema: PASSED only if they match.

import "std/ai_multimodal/vector_quantization_ema.oo";

pub fn main() {
    let vector_quantization_ema_a = vq_ema_update_n(0, 0, 0);
    let vector_quantization_ema_b = vq_ema_update_n(0, 0, 0);
    if vector_quantization_ema_a != vector_quantization_ema_b {
        println("FAIL vector_quantization_ema");
        process_exit(1);
    }
    println("prod_ap_vector_quantization_ema: PASSED");
}
