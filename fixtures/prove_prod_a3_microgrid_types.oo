// # Product prove std/grid/microgrid_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts microgrid_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_types.oo.
//
// Beats:
//   1. Call microgrid_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_microgrid_types: PASSED only if they match.

import "std/grid/microgrid_types.oo";

pub fn main() {
    let microgrid_types_mark: Int = 0;
    if microgrid_types_mark != 0 {
        process_exit(1);
    }
    let a: MicrogridState = microgrid_state_new(0, 0);
    let b: MicrogridState = microgrid_state_new(0, 0);
    if (a).islanded != (b).islanded {
        println("FAIL microgrid_state_new");
        process_exit(1);
    }
    println("prod_microgrid_types: PASSED");
}
