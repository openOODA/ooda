// # Product prove std/formal_verif/hoare_verification_conditions.oo
//
// Logline: Fail-closed emit+gcc+run asserts hoare_emit_obligation is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/hoare_verification_conditions.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hoare_emit_obligation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hoare_verification_conditions: PASSED only if they match.

import "std/formal_verif/hoare_verification_conditions.oo";

pub fn main() {
    let mut g2_oa: HoareEnvironment = hoare_env_new();
    let mut g2_ob: HoareEnvironment = hoare_env_new();
    let g2_a = hoare_emit_obligation(&g2_oa, "x", "x", "x");
    let g2_b = hoare_emit_obligation(&g2_ob, "x", "x", "x");
    if g2_a != g2_b {
        println("FAIL hoare_emit_obligation");
        process_exit(1);
    }
    println("prod_g2_hoare_verification_conditions: PASSED");
}
