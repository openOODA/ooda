// # Product prove std/net_telemetry/ids_signatures.oo
//
// Logline: Fail-closed emit+gcc+run asserts ids_engine_inspect_payload is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/ids_signatures.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ids_engine_inspect_payload twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ids_signatures: PASSED only if they match.

import "std/net_telemetry/ids_signatures.oo";

pub fn main() {
    let mut g0_oa = ids_engine_new("x");
    let mut g0_ob = ids_engine_new("x");
    let g0_a = ids_engine_inspect_payload(&g0_oa, 0, 0, "x", "x", "x", 0);
    let g0_b = ids_engine_inspect_payload(&g0_ob, 0, 0, "x", "x", "x", 0);
    if g0_a != g0_b {
        println("FAIL ids_engine_inspect_payload");
        process_exit(1);
    }
    println("prod_gr_ids_signatures: PASSED");
}
