// # emit-x86 recursive fibonacci lowering
//
// Logline: Recursive Fibonacci call lowering with stack frame allocation and register spilling.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld.
//
// Beats:
//   1. Declare recursive fib function.
//   2. Call fib(7) in main and println result.
//   3. as+ld stdout is 13.

fn fib(n: Int) -> Int {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

pub fn main() {
    println(fib(7));
}
