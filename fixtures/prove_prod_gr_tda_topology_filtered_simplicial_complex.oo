// # Product prove std/tda_topology/filtered_simplicial_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts filtered_sequence_active_count is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/filtered_simplicial_complex.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call filtered_sequence_active_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_filtered_simplicial_complex: PASSED only if they match.

import "std/tda_topology/filtered_simplicial_complex.oo";

pub fn main() {
    let g0_oa = filtered_sequence_new(0);
    let g0_ob = filtered_sequence_new(0);
    let g0_a = filtered_sequence_active_count(&g0_oa, 0.0);
    let g0_b = filtered_sequence_active_count(&g0_ob, 0.0);
    if g0_a != g0_b {
        println("FAIL filtered_sequence_active_count");
        process_exit(1);
    }
    println("prod_gr_filtered_simplicial_complex: PASSED");
}
