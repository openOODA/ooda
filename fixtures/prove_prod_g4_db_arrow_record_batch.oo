// # Product prove std/db_columnar/arrow_record_batch.oo
//
// Logline: Fail-closed verification that Apache Arrow RecordBatch creation, column management, and batch slicing are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_record_batch.oo.
//
// Beats:
//   1. Create columnar array for integers.
//   2. Initialize ArrowRecordBatch and add column fields.
//   3. Extract record batch metadata.
//   4. Slice record batch and assert deterministic row subset dimensions.
//   5. Print prod_g4_db_arrow_record_batch: PASSED and exit 0.

import "std/db_columnar/arrow_record_batch.oo";

pub fn main() {
    let mut i_vals: List[Int] = list_new();
    i_vals = list_push(i_vals, 100);
    i_vals = list_push(i_vals, 200);
    i_vals = list_push(i_vals, 300);

    let col_id: ArrowColumnData = arrow_column_data_new_int(i_vals, 0);
    if col_id.length != 3 || col_id.type_id != 1 || col_id.null_count != 0 {
        println("FAIL col_id length");
        process_exit(1);
    }

    let batch0: ArrowRecordBatch = arrow_record_batch_new(3);
    let batch1: ArrowRecordBatch = arrow_record_batch_add_column(batch0);
    let batch2: ArrowRecordBatch = arrow_record_batch_add_column(batch1);

    if batch2.num_rows != 3 || batch2.num_cols != 2 {
        println("FAIL batch2 dimensions");
        process_exit(1);
    }

    let sliced: ArrowRecordBatch = arrow_record_batch_slice(batch2, 2);
    if sliced.num_rows != 2 || sliced.num_cols != 2 {
        println("FAIL sliced dimensions");
        process_exit(1);
    }

    println("prod_g4_db_arrow_record_batch: PASSED");
    process_exit(0);
}
