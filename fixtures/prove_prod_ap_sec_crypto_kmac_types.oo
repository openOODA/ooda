// # Product prove std/sec/crypto/kmac_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kmac_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kmac_types: PASSED only if they match.

import "std/sec/crypto/kmac_types.oo";

pub fn main() {
    let kmac_types_a = kmac_config_new(0, 0, 0);
    let kmac_types_b = kmac_config_new(0, 0, 0);
    let kmac_types_va = kmac_config_rate(kmac_types_a);
    let kmac_types_vb = kmac_config_rate(kmac_types_b);
    if kmac_types_va != kmac_types_vb {
        println("FAIL kmac_types");
        process_exit(1);
    }
    println("prod_ap_kmac_types: PASSED");
}
