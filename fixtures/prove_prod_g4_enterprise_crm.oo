// # Product prove std/enterprise/crm.oo
//
// Logline: Fail-closed emit+gcc+run asserts CRM contacts, deals, campaigns, and pipeline analytics.
//
// Setup: Isolated emit-c. Imports std/enterprise/crm.oo.
//
// Beats:
//   1. Create and score lead contact record.
//   2. Create deal, advance stage, and compute weighted value.
//   3. Run campaign spend, lead generation, and ROI analytics.
//   4. Integrate into CRM engine and compute aggregate pipeline metrics.

import "std/enterprise/crm.oo";

pub fn main() {
    let mut contact: Contact = contact_create(1, "Alice", "alice@example.com", "555-0100", 10);
    let ok_score: Bool = contact_update_score(&mut contact, 60);
    if ok_score == false {
        println("FAIL contact_update_score");
        process_exit(1);
    }
    let sc: Int = (contact).score;
    if sc != 60 {
        println("FAIL contact score value");
        process_exit(1);
    }

    let ok_qual: Bool = contact_qualify_lead(&mut contact);
    if ok_qual == false {
        println("FAIL contact_qualify_lead");
        process_exit(1);
    }
    let st: Int = (contact).status;
    if st != 1 {
        println("FAIL contact status value");
        process_exit(1);
    }

    let mut deal: Deal = deal_create(101, 1, "Enterprise License", 50000);
    let ok_stage: Bool = deal_advance_stage(&mut deal, 2, 50);
    if ok_stage == false {
        println("FAIL deal_advance_stage");
        process_exit(1);
    }
    let wv: Int = deal_weighted_value(&deal);
    if wv != 25000 {
        println("FAIL deal_weighted_value");
        process_exit(1);
    }

    let mut camp: Campaign = campaign_create(201, "Q3 Inbound", 10000);
    let ok_sp: Bool = campaign_record_spend(&mut camp, 2000);
    if ok_sp == false {
        println("FAIL campaign_record_spend");
        process_exit(1);
    }
    let ok_ld1: Bool = campaign_record_lead(&mut camp);
    let ok_ld2: Bool = campaign_record_lead(&mut camp);
    if ok_ld1 == false || ok_ld2 == false {
        println("FAIL campaign_record_lead");
        process_exit(1);
    }
    let cpl: Int = campaign_calculate_cost_per_lead(&camp);
    if cpl != 1000 {
        println("FAIL campaign_calculate_cost_per_lead");
        process_exit(1);
    }
    let roi: Int = campaign_calculate_roi(&camp, 6000);
    if roi != 200 {
        println("FAIL campaign_calculate_roi");
        process_exit(1);
    }

    let mut engine: CrmEngine = crm_engine_init();
    crm_add_customer(&mut engine, contact);
    crm_add_deal(&mut engine, deal);

    let pipe_val: Int = crm_calculate_pipeline_value(&engine);
    if pipe_val != 50000 {
        println("FAIL crm_calculate_pipeline_value");
        process_exit(1);
    }
    let w_pipe: Int = crm_calculate_weighted_pipeline(&engine);
    if w_pipe != 25000 {
        println("FAIL crm_calculate_weighted_pipeline");
        process_exit(1);
    }

    println("prod_g4_enterprise_crm: PASSED");
    process_exit(0);
}
