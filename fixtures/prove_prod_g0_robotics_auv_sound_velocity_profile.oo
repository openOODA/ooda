// # Product prove std/robotics_auv/sound_velocity_profile.oo
//
// Logline: Fail-closed emit+gcc+run asserts svp_sound_speed_at_depth is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/sound_velocity_profile.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call svp_sound_speed_at_depth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_sound_velocity_profile: PASSED only if they match.

import "std/robotics_auv/sound_velocity_profile.oo";

pub fn main() {
    let g0_oa: OceanSoundProfile = OceanSoundProfile { surface_c_m_s: 1.0, thermocline_base_depth_m: 1.0, thermocline_min_c_m_s: 1.0, deep_gradient_s_inv: 1.0 };
    let g0_ob: OceanSoundProfile = OceanSoundProfile { surface_c_m_s: 1.0, thermocline_base_depth_m: 1.0, thermocline_min_c_m_s: 1.0, deep_gradient_s_inv: 1.0 };
    let g0_a = svp_sound_speed_at_depth(&g0_oa, 1.0);
    let g0_b = svp_sound_speed_at_depth(&g0_ob, 1.0);
    if g0_a != g0_b {
        println("FAIL svp_sound_speed_at_depth");
        process_exit(1);
    }
    println("prod_g0_sound_velocity_profile: PASSED");
}
