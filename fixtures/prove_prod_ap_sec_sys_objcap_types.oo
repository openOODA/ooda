// # Product prove std/sec/sys/objcap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/objcap_types.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_types.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_objcap_types: PASSED only if they match.

import "std/sec/sys/objcap_types.oo";

pub fn main() {
    let objcap_types_a = capability_rights_none();
    let objcap_types_b = capability_rights_none();
    if objcap_types_a.allow_read != objcap_types_b.allow_read {
        println("FAIL objcap_types");
        process_exit(1);
    }
    println("prod_ap_objcap_types: PASSED");
}
