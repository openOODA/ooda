// # Product prove std/db_graph/property_graph_adjacency_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_adjacency_list.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_adjacency_list.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_property_graph_adjacency_list: PASSED only if they match.

import "std/db_graph/property_graph_adjacency_list.oo";

pub fn main() {
    let property_graph_adjacency_list_a = csr_graph_new(0);
    let property_graph_adjacency_list_b = csr_graph_new(0);
    let property_graph_adjacency_list_va = csr_get_target(property_graph_adjacency_list_a, 0);
    let property_graph_adjacency_list_vb = csr_get_target(property_graph_adjacency_list_b, 0);
    if property_graph_adjacency_list_va != property_graph_adjacency_list_vb {
        println("FAIL property_graph_adjacency_list");
        process_exit(1);
    }
    println("prod_ap_property_graph_adjacency_list: PASSED");
}
