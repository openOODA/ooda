// # Product prove std/fin/routing_venue.oo
//
// Logline: Fail-closed emit+gcc+run asserts routing_venue_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fin/routing_venue.oo.
//
// Beats:
//   1. Call routing_venue_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_routing_venue: PASSED only if it matches.

import "std/fin/routing_venue.oo";

pub fn main() {
    let a: Int = routing_venue_probe();
    if a != 0 {
        println("FAIL routing_venue_probe");
        process_exit(1);
    }
    println("prod_nc_routing_venue: PASSED");
}
