// # Product prove std/astro_advanced/earth_moon_trans_lunar.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/earth_moon_trans_lunar.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/earth_moon_trans_lunar.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_earth_moon_trans_lunar: PASSED only if they match.

import "std/astro_advanced/earth_moon_trans_lunar.oo";

pub fn main() {
    let earth_moon_trans_lunar_a = tli_delta_v();
    let earth_moon_trans_lunar_b = tli_delta_v();
    if earth_moon_trans_lunar_a != earth_moon_trans_lunar_b {
        println("FAIL earth_moon_trans_lunar");
        process_exit(1);
    }
    println("prod_ap_earth_moon_trans_lunar: PASSED");
}
