// # Bencode adversarial suite
//
// Logline: Roundtrips int, string, list, and dict, emits lex-sorted keys, and rejects i03e, i-0e, and unsorted dictionaries.
//
// Setup: Pure. Imports bencode_safe.oo. Run from ooda/.
//
// Beats:
//   1. Encode then parse each Bencode type.
//   2. Encode two keys out of order and require lexicographic emit.
//   3. Parse i03e, i-0e, and an unsorted dict as Err.

import "std/encoding/bencode_safe.oo";

fn need(flag: Int, err: String, bytes: List[Int], msg: String) -> List[Int] {
    if flag < 1 {
        println("FAIL " + msg + ": " + err);
        process_exit(1);
    }
    return bytes;
}

fn must_err(flag: Int, msg: String) {
    if flag > 0 {
        println("FAIL " + msg);
        process_exit(1);
    }
}

fn ascii(s: String) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < bytes_len(s) {
        o = list_push(o, byte_at(s, i));
        i = i + 1;
    }
    return o;
}

pub fn main() {
    let ei: ByteOut = bencode_safe_encode_int(7);
    let ib: List[Int] = need(ei.flag, ei.err, ei.bytes, "int");
    let pi: ByteOut = bencode_safe_parse(ib);
    if pi.flag < 1 {
        println("FAIL parse int");
        process_exit(1);
    }
    let es: ByteOut = bencode_safe_encode_str(ascii("hi"));
    let sb: List[Int] = need(es.flag, es.err, es.bytes, "str");
    let ps: ByteOut = bencode_safe_parse(sb);
    if ps.flag < 1 {
        println("FAIL parse str");
        process_exit(1);
    }
    let el: ByteOut = bencode_safe_encode_list_n(1, ib);
    let lb: List[Int] = need(el.flag, el.err, el.bytes, "list");
    let pl: ByteOut = bencode_safe_parse(lb);
    if pl.flag < 1 {
        println("FAIL parse list");
        process_exit(1);
    }
    let ed: ByteOut = bencode_safe_encode_dict2(ascii("b"), ib, ascii("a"), ib);
    let db: List[Int] = need(ed.flag, ed.err, ed.bytes, "dict");
    if list_get(db, 0) != 100 {
        println("FAIL d");
        process_exit(1);
    }
    if list_get(db, 1) != 49 {
        println("FAIL sorted key len");
        process_exit(1);
    }
    if list_get(db, 3) != 97 {
        println("FAIL lex a first");
        process_exit(1);
    }
    let pd: ByteOut = bencode_safe_parse(db);
    if pd.flag < 1 {
        println("FAIL parse dict " + pd.err);
        process_exit(1);
    }
    println("int/string/list/dict roundtrip");
    println("encode emits lex-sorted keys");

    let z: ByteOut = bencode_safe_parse(ascii("i03e"));
    must_err(z.flag, "i03e");
    let nz: ByteOut = bencode_safe_parse(ascii("i-0e"));
    must_err(nz.flag, "i-0e");
    let us: ByteOut = bencode_safe_parse(ascii("d1:bi1e1:ai1ee"));
    must_err(us.flag, "unsorted");
    println("i03e and i-0e and unsorted d are Err");
    println("SUITE PASSED");
    println("test_bencode_safe: PASSED");
}
