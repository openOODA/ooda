// # Product prove std/lidar_perception/centerpoint_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts sigmoid is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/centerpoint_detector.oo.
//
// Beats:
//   1. Call sigmoid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_centerpoint_detector: PASSED only if they match.

import "std/lidar_perception/centerpoint_detector.oo";

pub fn main() {
    let centerpoint_detector_mark: Int = 0;
    if centerpoint_detector_mark != 0 {
        process_exit(1);
    }
    let a: Float = sigmoid(0.0);
    let b: Float = sigmoid(0.0);
    if a != b {
        println("FAIL sigmoid");
        process_exit(1);
    }
    println("prod_g2_centerpoint_detector: PASSED");
}
