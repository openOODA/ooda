// # Product prove std/pbr_raytracing/brdf_thin_film_iridescence.oo
//
// Logline: Fail-closed emit+gcc+run asserts brdf_thin_film_iridescence_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_thin_film_iridescence.oo.
//
// Beats:
//   1. Call brdf_thin_film_iridescence_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_brdf_thin_film_iridescence: PASSED only if they match.

import "std/pbr_raytracing/brdf_thin_film_iridescence.oo";

pub fn main() {
    let a: Int = brdf_thin_film_iridescence_probe();
    let b: Int = brdf_thin_film_iridescence_probe();
    if a != b {
        println("FAIL brdf_thin_film_iridescence_probe");
        process_exit(1);
    }
    println("prod_g2_brdf_thin_film_iridescence: PASSED");
}
