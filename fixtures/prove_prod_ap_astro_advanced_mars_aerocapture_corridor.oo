// # Product prove std/astro_advanced/mars_aerocapture_corridor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/mars_aerocapture_corridor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/mars_aerocapture_corridor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mars_aerocapture_corridor: PASSED only if they match.

import "std/astro_advanced/mars_aerocapture_corridor.oo";

pub fn main() {
    let mars_aerocapture_corridor_a = aero_corridor_km();
    let mars_aerocapture_corridor_b = aero_corridor_km();
    if mars_aerocapture_corridor_a != mars_aerocapture_corridor_b {
        println("FAIL mars_aerocapture_corridor");
        process_exit(1);
    }
    println("prod_ap_mars_aerocapture_corridor: PASSED");
}
