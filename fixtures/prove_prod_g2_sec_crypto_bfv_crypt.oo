// # Product prove std/sec/crypto/bfv_crypt.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_crypt_work is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_crypt.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bfv_crypt_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bfv_crypt: PASSED only if they match.

import "std/sec/crypto/bfv_crypt.oo";

pub fn main() {
    let g2_a = bfv_crypt_work(2, 2, 2);
    let g2_b = bfv_crypt_work(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL bfv_crypt_work");
        process_exit(1);
    }
    println("prod_g2_bfv_crypt: PASSED");
}
