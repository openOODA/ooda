// # Product prove std/formal_verif/abstract_interval_arithmetic.oo
//
// Logline: Fail-closed emit+gcc+run asserts interval_bottom is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_interval_arithmetic.oo.
//
// Beats:
//   1. Call interval_bottom twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_abstract_interval_arithmetic: PASSED only if they match.

import "std/formal_verif/abstract_interval_arithmetic.oo";

pub fn main() {
    let abstract_interval_arithmetic_mark: Int = 0;
    if abstract_interval_arithmetic_mark != 0 {
        process_exit(1);
    }
    let a: Interval = interval_bottom();
    let b: Interval = interval_bottom();
    if (a).low != (b).low {
        println("FAIL interval_bottom");
        process_exit(1);
    }
    println("prod_abstract_interval_arithmetic: PASSED");
}
