// # Product prove std/fin/yield_curve.oo
//
// Logline: Fail-closed emit+gcc+run asserts discount_factor_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_curve.oo.
//
// Beats:
//   1. Call discount_factor_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_curve_df: PASSED only if they match.

import "std/fin/yield_curve.oo";

pub fn main() {
    let yield_curve_mark: Int = 0;
    if yield_curve_mark != 0 { process_exit(1); }
    let a: DiscountFactor = discount_factor_create(12, 100, 0);
    let b: DiscountFactor = discount_factor_create(12, 100, 0);
    let af: Int = (a).factor_bps;
    let bf: Int = (b).factor_bps;
    if af != bf {
        println("FAIL discount_factor_create");
        process_exit(1);
    }
    println("prod_yield_curve_df: PASSED");
}
