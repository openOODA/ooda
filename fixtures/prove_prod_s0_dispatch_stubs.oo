// # Product prove std/swarm/dispatch_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts dispatcher_config_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch_stubs.oo.
//
// Beats:
//   1. Call dispatcher_config_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_dispatch_stubs: PASSED only if asserts hold.

import "std/swarm/dispatch_stubs.oo";

pub fn main() {
    let dispatch_stubs_a = dispatcher_config_new(0, 0);
    let dispatch_stubs_b = dispatcher_config_new(0, 0);
    if dispatch_stubs_a.strategy != dispatch_stubs_b.strategy {
        println("FAIL dispatcher_config_new");
        process_exit(1);
    }
    println("prod_dispatch_stubs: PASSED");
}
