// # Product prove std/db_columnar/columnar_lz4_decompressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_lz4_decompressor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_lz4_decompressor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_lz4_decompressor: PASSED only if they match.

import "std/db_columnar/columnar_lz4_decompressor.oo";

pub fn main() {
    let columnar_lz4_decompressor_a = lz4_copy_match(list_new(), 0, 0);
    let columnar_lz4_decompressor_b = lz4_copy_match(list_new(), 0, 0);
    if list_len(columnar_lz4_decompressor_a) != list_len(columnar_lz4_decompressor_b) {
        println("FAIL columnar_lz4_decompressor");
        process_exit(1);
    }
    println("prod_ap_columnar_lz4_decompressor: PASSED");
}
