// # Product prove std/db_columnar/columnar_frame_of_reference.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_frame_of_reference.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_frame_of_reference.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_frame_of_reference: PASSED only if they match.

import "std/db_columnar/columnar_frame_of_reference.oo";

pub fn main() {
    let columnar_frame_of_reference_a = for_calc_bit_width(0);
    let columnar_frame_of_reference_b = for_calc_bit_width(0);
    if columnar_frame_of_reference_a != columnar_frame_of_reference_b {
        println("FAIL columnar_frame_of_reference");
        process_exit(1);
    }
    println("prod_ap_columnar_frame_of_reference: PASSED");
}
