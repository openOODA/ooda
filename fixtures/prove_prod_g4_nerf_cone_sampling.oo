// # Product prove std/nerf_3dgs/nerf_cone_frustum_sampling.oo
//
// Logline: Fail-closed verification that ray cone construction, frustum slicing, and volume calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_cone_frustum_sampling.oo.
//
// Beats:
//   1. Construct RayCone instances from origin, direction, and focal length.
//   2. Extract conical frustum sampling intervals along rays.
//   3. Compute analytical conical frustum volumes deterministically.
//   4. Print prod_g4_nerf_cone_sampling: PASSED and exit 0.

import "std/nerf_3dgs/nerf_cone_frustum_sampling.oo";

pub fn main() {
    let orig: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let dir: Vec3 = vec3_new(0.0, 0.0, 2.0);
    let cone1: RayCone = ray_cone_new(orig, dir, 500.0);
    let cone2: RayCone = ray_cone_new(orig, dir, 500.0);
    if (cone1).radius != (cone2).radius || (cone1).radius <= 0.0 {
        println("FAIL ray_cone_new radius");
        process_exit(1);
    }
    if (cone1).direction.z != 1.0 {
        println("FAIL ray_cone_new normalized direction");
        process_exit(1);
    }

    let frustum: ConicalFrustum = ray_cone_frustum_at(&cone1, 1.0, 5.0);
    if (frustum).t0 != 1.0 || (frustum).t1 != 5.0 || (frustum).radius != (cone1).radius {
        println("FAIL ray_cone_frustum_at");
        process_exit(1);
    }

    let v1: Float = cone_frustum_volume(1.0, 2.0, 3.0);
    let v2: Float = cone_frustum_volume(1.0, 2.0, 3.0);
    if v1 != v2 || v1 <= 0.0 {
        println("FAIL cone_frustum_volume");
        process_exit(1);
    }

    println("prod_g4_nerf_cone_sampling: PASSED");
    process_exit(0);
}
