// # Product prove std/physics/fluid_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics/fluid_math.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/fluid_math.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fluid_math: PASSED only if they match.

import "std/physics/fluid_math.oo";

pub fn main() {
    let fluid_math_a = fluid_vec3_new(0, 0, 0);
    let fluid_math_b = fluid_vec3_new(0, 0, 0);
    let fluid_math_va = fluid_vec3_x(fluid_math_a);
    let fluid_math_vb = fluid_vec3_x(fluid_math_b);
    if fluid_math_va != fluid_math_vb {
        println("FAIL fluid_math");
        process_exit(1);
    }
    println("prod_ap_fluid_math: PASSED");
}
