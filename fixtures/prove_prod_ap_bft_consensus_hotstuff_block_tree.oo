// # Product prove std/bft_consensus/hotstuff_block_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/hotstuff_block_tree.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_block_tree.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_hotstuff_block_tree: PASSED only if they match.

import "std/bft_consensus/hotstuff_block_tree.oo";

pub fn main() {
    let hotstuff_block_tree_a = block_tree_new("x");
    let hotstuff_block_tree_b = block_tree_new("x");
    if hotstuff_block_tree_a.root_hash != hotstuff_block_tree_b.root_hash {
        println("FAIL hotstuff_block_tree");
        process_exit(1);
    }
    println("prod_ap_hotstuff_block_tree: PASSED");
}
