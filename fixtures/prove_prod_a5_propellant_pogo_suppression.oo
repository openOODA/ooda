// # Product prove std/space_propulsion/propellant_pogo_suppression.oo
//
// Logline: Fail-closed emit+gcc+run asserts pogo_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_pogo_suppression.oo.
//
// Beats:
//   1. Call pogo_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_pogo_suppression: PASSED only if they match.

import "std/space_propulsion/propellant_pogo_suppression.oo";

pub fn main() {
    let propellant_pogo_suppression_mark: Int = 0;
    if propellant_pogo_suppression_mark != 0 {
        process_exit(1);
    }
    let a: PogoSystemSpec = pogo_spec_default();
    let b: PogoSystemSpec = pogo_spec_default();
    if (a).structural_frequency_hz != (b).structural_frequency_hz {
        println("FAIL pogo_spec_default");
        process_exit(1);
    }
    println("prod_propellant_pogo_suppression: PASSED");
}
