// # Integer-subset add
//
// Logline: Add two non-negative ints and print the LLVM-safe result.
//
// Beats:
//   1. Require a >= 0 and b >= 0; ensure result >= 0.
//   2. Verify add(2, 3) == 5.
//   3. Print add(20, 22).

// Integer-subset program — valid for `ooda build` LLVM IR emission.
pub fn add(a: Int, b: Int) -> Int
    requires a >= 0
    requires b >= 0
    ensures result >= 0
{
    return a + b;
}

verify add {
    assert_eq!(add(2, 3), 5);
}

pub fn main() {
    let x = add(20, 22);
    println(x);
}
