// # Product prove std/space_propulsion/chapman_reentry_stagnation_heat.oo
//
// Logline: Fail-closed emit+gcc+run asserts heating_compute_stagnation is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/chapman_reentry_stagnation_heat.oo.
//
// Beats:
//   1. Call heating_compute_stagnation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chapman_reentry_stagnation_heat: PASSED only if they match.

import "std/space_propulsion/chapman_reentry_stagnation_heat.oo";

pub fn main() {
    let chapman_reentry_stagnation_heat_mark: Int = 0;
    if chapman_reentry_stagnation_heat_mark != 0 {
        process_exit(1);
    }
    let chapman_reentry_stagnation_heat_a = heating_compute_stagnation(stagnation_spec_default_lunar_return());
    let chapman_reentry_stagnation_heat_b = heating_compute_stagnation(stagnation_spec_default_lunar_return());
    if (chapman_reentry_stagnation_heat_a).convective_heat_flux_w_cm2 != (chapman_reentry_stagnation_heat_b).convective_heat_flux_w_cm2 {
        println("FAIL heating_compute_stagnation");
        process_exit(1);
    }
    println("prod_chapman_reentry_stagnation_heat: PASSED");
}
