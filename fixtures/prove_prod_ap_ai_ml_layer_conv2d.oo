// # Product prove std/ai_ml/layer_conv2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/layer_conv2d.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_conv2d.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_layer_conv2d: PASSED only if they match.

import "std/ai_ml/layer_conv2d.oo";

pub fn main() {
    let layer_conv2d_a = conv2d_calc_out_dim(0, 0, 0, 0);
    let layer_conv2d_b = conv2d_calc_out_dim(0, 0, 0, 0);
    if layer_conv2d_a != layer_conv2d_b {
        println("FAIL layer_conv2d");
        process_exit(1);
    }
    println("prod_ap_layer_conv2d: PASSED");
}
