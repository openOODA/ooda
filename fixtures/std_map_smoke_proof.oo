// # Standard Hash Map Verification Proof Fixture
//
// Logline: Proves insertion, retrieval, overwrite, removal, keys, and values in std/hash/map.oo.
//
// Setup: Pure data structure verification fixture without ambient effects.
//
// Beats:
//   1. Verify map creation and empty state.
//   2. Verify key insertion and retrieval.
//   3. Verify key overwriting and size consistency.
//   4. Verify key removal and failure-closed lookup.
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.6: Dual-evidence happy path and missing key refusal.
// RULES.oot 1.7: Under 256 lines.

import "std/hash/map.oo";
import "std/result.oo";

pub fn main() {
    let mut m: HashMap = map_new();
    if !map_is_empty(m) {
        println("FAIL: map should be empty");
        process_exit(1);
    }
    if map_len(m) != 0 {
        println("FAIL: map_len should be 0");
        process_exit(1);
    }

    m = map_insert(m, "hostname", "prod.cluster.local");
    m = map_insert(m, "port", "8080");
    m = map_insert(m, "env", "production");

    if map_len(m) != 3 {
        println("FAIL: map_len should be 3");
        process_exit(1);
    }

    if !map_has(m, "hostname") {
        println("FAIL: map_has hostname");
        process_exit(1);
    }

    let host_r: Result[String, String] = map_get(m, "hostname");
    if !host_r.is_ok() {
        println("FAIL: map_get hostname");
        process_exit(1);
    }
    let host_val: String = res_unwrap_or(host_r, "");
    if host_val != "prod.cluster.local" {
        println("FAIL: host_val mismatch");
        process_exit(1);
    }

    // Overwrite port
    m = map_insert(m, "port", "9090");
    if map_len(m) != 3 {
        println("FAIL: map_len after overwrite should stay 3");
        process_exit(1);
    }
    let port_val: String = map_get_or(m, "port", "");
    if port_val != "9090" {
        println("FAIL: port_val should be 9090");
        process_exit(1);
    }

    // Remove env
    m = map_remove(m, "env");
    if map_len(m) != 2 {
        println("FAIL: map_len after remove should be 2");
        process_exit(1);
    }
    if map_has(m, "env") {
        println("FAIL: map_has env should be false");
        process_exit(1);
    }
    let missing_r: Result[String, String] = map_get(m, "env");
    if !missing_r.is_err() {
        println("FAIL: map_get missing key should return Err");
        process_exit(1);
    }

    println("OK: MAP_SMOKE_PROOF_PASSED");
}
