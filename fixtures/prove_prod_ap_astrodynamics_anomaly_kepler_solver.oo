// # Product prove std/astrodynamics/anomaly_kepler_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/anomaly_kepler_solver.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/anomaly_kepler_solver.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_anomaly_kepler_solver: PASSED only if they match.

import "std/astrodynamics/anomaly_kepler_solver.oo";

pub fn main() {
    let anomaly_kepler_solver_a = kepler_iters();
    let anomaly_kepler_solver_b = kepler_iters();
    if anomaly_kepler_solver_a != anomaly_kepler_solver_b {
        println("FAIL anomaly_kepler_solver");
        process_exit(1);
    }
    println("prod_ap_anomaly_kepler_solver: PASSED");
}
