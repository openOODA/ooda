// # Product prove std/space_propulsion/arcjet_thruster_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts arcjet_spec_default_hydrazine value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/arcjet_thruster_dynamics.oo.
//
// Beats:
//   1. Call arcjet_spec_default_hydrazine twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_arcjet_thruster_dynamics: PASSED only if asserts hold.

import "std/space_propulsion/arcjet_thruster_dynamics.oo";

pub fn main() {
    let arcjet_thruster_dynamics: ArcjetSpec = arcjet_spec_default_hydrazine();
    let arcjet_thruster_dynamics_b: ArcjetSpec = arcjet_spec_default_hydrazine();
    if (arcjet_thruster_dynamics).propellant_type != 1 {
        println("FAIL arcjet_spec_default_hydrazine propellant_type");
        process_exit(1);
    }
    if (arcjet_thruster_dynamics).propellant_type != (arcjet_thruster_dynamics_b).propellant_type {
        println("FAIL arcjet_spec_default_hydrazine det");
        process_exit(1);
    }
    println("prod_arcjet_thruster_dynamics: PASSED");
}
