// # Product prove std/tui/tui_renderer.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_renderer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/tui_renderer.oo.
//
// Beats:
//   1. Call tui_renderer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tui_renderer_new: PASSED only if they match.

import "std/tui/tui_renderer.oo";

pub fn main() {
    let tui_renderer_mark: Int = 0;
    if tui_renderer_mark != 0 { process_exit(1); }
    let a: TuiRenderer = tui_renderer_new(80, 24);
    let b: TuiRenderer = tui_renderer_new(80, 24);
    let aw: Int = (a).width;
    let bw: Int = (b).width;
    if aw != bw {
        println("FAIL tui_renderer_new");
        process_exit(1);
    }
    println("prod_tui_renderer_new: PASSED");
}
