// # Product prove std/robot/slam_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts slam_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/slam_engine.oo.
//
// Beats:
//   1. Call slam_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_engine_new: PASSED only if they match.

import "std/robot/slam_engine.oo";

pub fn main() {
    let slam_engine_mark: Int = 0;
    if slam_engine_mark != 0 { process_exit(1); }
    let a = slam_engine_new();
    let b = slam_engine_new();
    if (a).total_steps != (b).total_steps {
        println("FAIL slam_engine_new");
        process_exit(1);
    }
    println("prod_slam_engine_new: PASSED");
}
