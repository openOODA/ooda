// # Product prove std/protein_folding/alphafold_msa_row_column_attention.oo
//
// Logline: Fail-closed emit+gcc+run asserts af_msa_sigmoid is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/alphafold_msa_row_column_attention.oo.
//
// Beats:
//   1. Call af_msa_sigmoid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_alphafold_msa_row_column_attention: PASSED only if they match.

import "std/protein_folding/alphafold_msa_row_column_attention.oo";

pub fn main() {
    let a: Float = af_msa_sigmoid(0.0);
    let b: Float = af_msa_sigmoid(0.0);
    if a != b {
        println("FAIL af_msa_sigmoid");
        process_exit(1);
    }
    println("prod_alphafold_msa_row_column_attention: PASSED");
}
