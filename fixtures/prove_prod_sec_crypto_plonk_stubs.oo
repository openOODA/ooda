// # Product prove std/sec/crypto/plonk_stubs.oo
//
// Logline: Fail-closed emit+check asserts plonk_eval_fft_poly_mult is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk_stubs.oo.
//
// Beats:
//   1. Call plonk_eval_fft_poly_mult twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_stubs: PASSED only if they match.

import "std/sec/crypto/plonk_stubs.oo";

pub fn main() {
    let plonk_stubs_mark: Int = 0;
    if plonk_stubs_mark != 0 { process_exit(1); }
    let a: List[Int] = plonk_eval_fft_poly_mult(list_new(), list_new(), 0);
    let b: List[Int] = plonk_eval_fft_poly_mult(list_new(), list_new(), 0);
    if a != b { process_exit(1); }
    println("prod_plonk_stubs: PASSED");
}
