// # Product prove std/bft_consensus/snapshot_merkle_indexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts snapshot_index_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/snapshot_merkle_indexer.oo.
//
// Beats:
//   1. Call snapshot_index_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_snapshot_merkle_indexer: PASSED only if they match.

import "std/bft_consensus/snapshot_merkle_indexer.oo";

pub fn main() {
    let snapshot_merkle_indexer_mark: Int = 0;
    if snapshot_merkle_indexer_mark != 0 {
        process_exit(1);
    }
    let a: SnapshotIndex = snapshot_index_new(0);
    let b: SnapshotIndex = snapshot_index_new(0);
    if (a).snapshot_interval_blocks != (b).snapshot_interval_blocks {
        println("FAIL snapshot_index_new");
        process_exit(1);
    }
    println("prod_snapshot_merkle_indexer: PASSED");
}
