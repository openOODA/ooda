// # Product prove std/bio/smiles_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/smiles_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_smiles_stubs: PASSED only if they match.

import "std/bio/smiles_stubs.oo";

pub fn main() {
    let smiles_stubs_a = smiles_iupac_to_structure("x");
    let smiles_stubs_b = smiles_iupac_to_structure("x");
    let smiles_stubs_va = smiles_generate_3d_conformer(smiles_stubs_a);
    let smiles_stubs_vb = smiles_generate_3d_conformer(smiles_stubs_b);
    if smiles_stubs_va != smiles_stubs_vb {
        println("FAIL smiles_stubs");
        process_exit(1);
    }
    println("prod_ap_smiles_stubs: PASSED");
}
