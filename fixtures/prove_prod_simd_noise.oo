// # Product prove std/simd/simd_noise.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_noise_fade is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_noise.oo.
//
// Beats:
//   1. Call simd_noise_fade twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_noise: PASSED only if they match.

import "std/simd/simd_noise.oo";

pub fn main() {
    let a = simd_noise_fade(0.0);
    let b = simd_noise_fade(0.0);
    if a != b {
        println("FAIL simd_noise_fade");
        process_exit(1);
    }
    println("prod_simd_noise: PASSED");
}
