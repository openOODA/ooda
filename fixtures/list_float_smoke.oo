// # List[Float] emit lock
//
// Logline: Fail-closed emit+gcc+run of List[Float] new, push, get, and sum.
//
// Setup: Backend-C. OoFList in chs_rt.
//
// Beats:
//   1. Empty list has length 0.
//   2. Push 1.5 and 2.5; get both; sum is 4.0.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let mut xs: List[Float] = list_new();
    if list_len(xs) != 0 {
        println("FAIL empty len");
        process_exit(1);
    }
    xs = list_push(xs, 1.5);
    xs = list_push(xs, 2.5);
    if list_len(xs) != 2 {
        println("FAIL push len");
        process_exit(1);
    }
    let a: Float = list_get(xs, 0);
    let b: Float = list_get(xs, 1);
    let s: Float = a + b;
    if s < 3.99 {
        println("FAIL sum low");
        process_exit(1);
    }
    if s > 4.01 {
        println("FAIL sum high");
        process_exit(1);
    }
    println("list_float_smoke: PASSED");
}
