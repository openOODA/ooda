// # Product prove std/simd/simd_simplex_noise.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_simplex_noise.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_simplex_noise.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_simplex_noise: PASSED only if they match.

import "std/simd/simd_simplex_noise.oo";

pub fn main() {
    let simd_simplex_noise_a = simplex_noise2d(0.0, 0.0);
    let simd_simplex_noise_b = simplex_noise2d(0.0, 0.0);
    if simd_simplex_noise_a != simd_simplex_noise_b {
        println("FAIL simd_simplex_noise");
        process_exit(1);
    }
    println("prod_ap_simd_simplex_noise: PASSED");
}
