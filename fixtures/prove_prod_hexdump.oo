// # Product hex dump byte prove
//
// Logline: Fail-closed emit+gcc+run of shipped hex_dump_byte.
//
// Setup: Product std/text/hex_dump_format.oo. 255 is ff; 10 is 0a.
//
// Beats:
//   1. hex_dump_byte(255) is ff.
//   2. hex_dump_byte(10) is 0a.
//   3. Exit 1 before PASSED on a miss.

import "std/text/hex_dump_format.oo";

pub fn main() {
    let ff: String = hex_dump_byte(255);
    if ff != "ff" {
        println("FAIL hexdump ff");
        process_exit(1);
    }
    let za: String = hex_dump_byte(10);
    if za != "0a" {
        println("FAIL hexdump 0a");
        process_exit(1);
    }
    println("prod_hexdump: PASSED");
}
