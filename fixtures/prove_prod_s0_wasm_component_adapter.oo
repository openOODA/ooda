// # Product prove std/wasm_gc/wasm_component_adapter.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasi_errno_success value or determinism.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_adapter.oo.
//
// Beats:
//   1. Call wasi_errno_success twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_wasm_component_adapter: PASSED only if asserts hold.

import "std/wasm_gc/wasm_component_adapter.oo";

pub fn main() {
    let wasm_component_adapter_a: Int = wasi_errno_success();
    let wasm_component_adapter_b: Int = wasi_errno_success();
    if wasm_component_adapter_a != wasm_component_adapter_b {
        println("FAIL wasi_errno_success");
        process_exit(1);
    }
    println("prod_wasm_component_adapter: PASSED");
}
