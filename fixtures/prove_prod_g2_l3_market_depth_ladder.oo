// # Product prove std/fintech_l3_book/l3_market_depth_ladder.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth_level_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_market_depth_ladder.oo.
//
// Beats:
//   1. Call depth_level_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_market_depth_ladder: PASSED only if they match.

import "std/fintech_l3_book/l3_market_depth_ladder.oo";

pub fn main() {
    let l3_market_depth_ladder_mark: Int = 0;
    if l3_market_depth_ladder_mark != 0 {
        process_exit(1);
    }
    let a: DepthLevel = depth_level_new(0, 0, 0);
    let b: DepthLevel = depth_level_new(0, 0, 0);
    if (a).price_fixed != (b).price_fixed {
        println("FAIL depth_level_new");
        process_exit(1);
    }
    println("prod_g2_l3_market_depth_ladder: PASSED");
}
