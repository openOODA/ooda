// # String Result refuses Int Ok
//
// Logline: emit-llvm fail-closes Ok(7) written into a String Result.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. Annotate r as Result[String].
//   2. Assign Ok(7).
//   3. Emit must print ERR llvm_emit.

pub fn main() {
    let r: Result[String] = Ok(7);
    println(r.is_ok().to_string());
}
