// # Product prove std/hft_alpha/mm_hawkes_point_process.oo
//
// Logline: Fail-closed emit+gcc+run asserts hawkes_1d_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_hawkes_point_process.oo.
//
// Beats:
//   1. Call hawkes_1d_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_hawkes_point_process: PASSED only if they match.

import "std/hft_alpha/mm_hawkes_point_process.oo";

pub fn main() {
    let mm_hawkes_point_process_mark: Int = 0;
    if mm_hawkes_point_process_mark != 0 {
        process_exit(1);
    }
    let a: Hawkes1DParams = hawkes_1d_params_new(0.0, 0.0, 0.0);
    let b: Hawkes1DParams = hawkes_1d_params_new(0.0, 0.0, 0.0);
    if (a).mu_baseline != (b).mu_baseline {
        println("FAIL hawkes_1d_params_new");
        process_exit(1);
    }
    println("prod_mm_hawkes_point_process: PASSED");
}
