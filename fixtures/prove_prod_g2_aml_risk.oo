// # Product prove std/fin/aml_risk.oo
//
// Logline: Fail-closed emit+gcc+run asserts aml_check_structuring_pattern is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_risk.oo.
//
// Beats:
//   1. Call aml_check_structuring_pattern twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_aml_risk: PASSED only if they match.

import "std/fin/aml_risk.oo";

pub fn main() {
    let aml_risk_mark: Int = 0;
    if aml_risk_mark != 0 {
        process_exit(1);
    }
    let a: Bool = aml_check_structuring_pattern(0, 0);
    let b: Bool = aml_check_structuring_pattern(0, 0);
    if a != b {
        println("FAIL aml_check_structuring_pattern");
        process_exit(1);
    }
    println("prod_g2_aml_risk: PASSED");
}
