// # Product prove std/uav_flight/uav_waypoint_navigator.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_waypoint_new is a real value.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_waypoint_navigator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nav_waypoint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_waypoint_navigator: PASSED only if they match.

import "std/uav_flight/uav_waypoint_navigator.oo";

pub fn main() {
    let g2_oa = nav_waypoint_new(2, 2, 2, 2, 2, 2, 2, 2);
    let g2_ob = nav_waypoint_new(2, 2, 2, 2, 2, 2, 2, 2);
    let g2_a = (g2_oa).x_mm;
    let g2_b = (g2_ob).x_mm;
    if g2_a != g2_b {
        println("FAIL nav_waypoint_new.x_mm");
        process_exit(1);
    }
    println("prod_g2_uav_waypoint_navigator: PASSED");
}
