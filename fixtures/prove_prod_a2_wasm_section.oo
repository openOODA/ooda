// # Product prove std/compilers/wasm_section.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_section_id_custom is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_section.oo.
//
// Beats:
//   1. Call wasm_section_id_custom twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_section: PASSED only if they match.

import "std/compilers/wasm_section.oo";

pub fn main() {
    let a: Int = wasm_section_id_custom();
    let b: Int = wasm_section_id_custom();
    if a != b {
        println("FAIL wasm_section_id_custom");
        process_exit(1);
    }
    println("prod_wasm_section: PASSED");
}
