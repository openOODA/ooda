// # Product prove std/sec/crypto/sha3_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/sha3_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/sha3_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sha3_types: PASSED only if they match.

import "std/sec/crypto/sha3_types.oo";

pub fn main() {
    let sha3_types_a = sha3_state_new(0, 0, 0);
    let sha3_types_b = sha3_state_new(0, 0, 0);
    let sha3_types_va = sha3_state_rate(sha3_types_a);
    let sha3_types_vb = sha3_state_rate(sha3_types_b);
    if sha3_types_va != sha3_types_vb {
        println("FAIL sha3_types");
        process_exit(1);
    }
    println("prod_ap_sha3_types: PASSED");
}
