// # Product prove std/db_columnar/columnar_frame_of_reference.oo
//
// Logline: Fail-closed emit+gcc+run asserts for_calc_bit_width is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_frame_of_reference.oo.
//
// Beats:
//   1. Call for_calc_bit_width twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_frame_of_reference: PASSED only if they match.

import "std/db_columnar/columnar_frame_of_reference.oo";

pub fn main() {
    let columnar_frame_of_reference_mark: Int = 0;
    if columnar_frame_of_reference_mark != 0 {
        process_exit(1);
    }
    let a: Int = for_calc_bit_width(0);
    let b: Int = for_calc_bit_width(0);
    if a != b {
        println("FAIL for_calc_bit_width");
        process_exit(1);
    }
    println("prod_columnar_frame_of_reference: PASSED");
}
