// # Product prove std/compilers/elf_section.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/elf_section.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_section.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf_section: PASSED only if they match.

import "std/compilers/elf_section.oo";

pub fn main() {
    let elf_section_a = elf_sht_null();
    let elf_section_b = elf_sht_null();
    if elf_section_a != elf_section_b {
        println("FAIL elf_section");
        process_exit(1);
    }
    println("prod_ap_elf_section: PASSED");
}
