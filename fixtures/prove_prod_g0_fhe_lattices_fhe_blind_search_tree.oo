// # Product prove std/fhe_lattices/fhe_blind_search_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts blind_search_eval_depth_cost is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_blind_search_tree.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call blind_search_eval_depth_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_blind_search_tree: PASSED only if they match.

import "std/fhe_lattices/fhe_blind_search_tree.oo";

pub fn main() {
    let g0_a = blind_search_eval_depth_cost(2);
    let g0_b = blind_search_eval_depth_cost(2);
    if g0_a != g0_b {
        println("FAIL blind_search_eval_depth_cost");
        process_exit(1);
    }
    println("prod_g0_fhe_blind_search_tree: PASSED");
}
