// # Product prove std/physics/physics_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts physics_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/physics_stubs.oo.
//
// Beats:
//   1. Call physics_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_physics_stubs: PASSED only if they match.

import "std/physics/physics_stubs.oo";

pub fn main() {
    let physics_stubs_mark: Int = 0;
    if physics_stubs_mark != 0 {
        process_exit(1);
    }
    let a: PhysicsCapabilities = physics_capabilities_default();
    let b: PhysicsCapabilities = physics_capabilities_default();
    if (a).max_rigid_bodies != (b).max_rigid_bodies {
        println("FAIL physics_capabilities_default");
        process_exit(1);
    }
    println("prod_physics_stubs: PASSED");
}
