// # Product prove std/gis_topo/citygml_lod_geometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts citygml_building_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/citygml_lod_geometry.oo.
//
// Beats:
//   1. Call citygml_building_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_citygml_lod_geometry: PASSED only if they match.

import "std/gis_topo/citygml_lod_geometry.oo";

pub fn main() {
    let citygml_lod_geometry_mark: Int = 0;
    if citygml_lod_geometry_mark != 0 {
        process_exit(1);
    }
    let a: CityGmlBuilding = citygml_building_new("x", 0, 0.0, 0.0, 0.0, "x");
    let b: CityGmlBuilding = citygml_building_new("x", 0, 0.0, 0.0, 0.0, "x");
    if (a).lod_level != (b).lod_level {
        println("FAIL citygml_building_new");
        process_exit(1);
    }
    println("prod_g2_citygml_lod_geometry: PASSED");
}
