// # Product prove std/bft_consensus/tendermint_consensus_state_machine.oo
//
// Logline: Fail-closed emit+gcc+run asserts tendermint_step_new_round is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_consensus_state_machine.oo.
//
// Beats:
//   1. Call tendermint_step_new_round twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tendermint_consensus_state_machine: PASSED only if they match.

import "std/bft_consensus/tendermint_consensus_state_machine.oo";

pub fn main() {
    let tendermint_consensus_state_machine_mark: Int = 0;
    if tendermint_consensus_state_machine_mark != 0 {
        process_exit(1);
    }
    let a: Int = tendermint_step_new_round();
    let b: Int = tendermint_step_new_round();
    if a != b {
        println("FAIL tendermint_step_new_round");
        process_exit(1);
    }
    println("prod_tendermint_consensus_state_machine: PASSED");
}
