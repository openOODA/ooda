// # Product prove std/aero/orbit.oo
//
// Logline: Fail-closed emit+gcc+run asserts orbit_state_x is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/orbit.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call orbit_state_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_orbit: PASSED only if they match.

import "std/aero/orbit.oo";

pub fn main() {
    let g0_oa = orbit_state_new(0, 0, 0);
    let g0_ob = orbit_state_new(0, 0, 0);
    let g0_a = orbit_state_x(g0_oa);
    let g0_b = orbit_state_x(g0_ob);
    if g0_a != g0_b {
        println("FAIL orbit_state_x");
        process_exit(1);
    }
    println("prod_gr_orbit: PASSED");
}
