// # Product prove std/graph_networks/kamada_kawai_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts kk_approx_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/kamada_kawai_layout.oo.
//
// Beats:
//   1. Call kk_approx_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kamada_kawai_layout: PASSED only if they match.

import "std/graph_networks/kamada_kawai_layout.oo";

pub fn main() {
    let kamada_kawai_layout_mark: Int = 0;
    if kamada_kawai_layout_mark != 0 {
        process_exit(1);
    }
    let a: Int = kk_approx_sqrt(0);
    let b: Int = kk_approx_sqrt(0);
    if a != b {
        println("FAIL kk_approx_sqrt");
        process_exit(1);
    }
    println("prod_g2_kamada_kawai_layout: PASSED");
}
