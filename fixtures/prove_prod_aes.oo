// # Product prove std/crypto/aes.oo
//
// Logline: Fail-closed emit+gcc+run asserts aes_encrypt is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/aes.oo.
//
// Beats:
//   1. Call aes_encrypt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aes: PASSED only if they match.

import "std/crypto/aes.oo";

pub fn main() {
    let a = aes_encrypt("x", "x");
    let b = aes_encrypt("x", "x");
    if a != b {
        println("FAIL aes_encrypt");
        process_exit(1);
    }
    println("prod_aes: PASSED");
}
