// # Product prove std/telecom_6g/isac_esprit_direction_finding.oo
//
// Logline: Fail-closed emit+gcc+run asserts esprit_solve_angle is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_esprit_direction_finding.oo.
//
// Beats:
//   1. Call esprit_solve_angle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isac_esprit_direction_finding: PASSED only if they match.

import "std/telecom_6g/isac_esprit_direction_finding.oo";

pub fn main() {
    let isac_esprit_direction_finding_mark: Int = 0;
    if isac_esprit_direction_finding_mark != 0 {
        process_exit(1);
    }
    let isac_esprit_direction_finding_a = esprit_solve_angle(1.0, esprit_config_default_16ant());
    let isac_esprit_direction_finding_b = esprit_solve_angle(1.0, esprit_config_default_16ant());
    if (isac_esprit_direction_finding_a).source_index != (isac_esprit_direction_finding_b).source_index {
        println("FAIL esprit_solve_angle");
        process_exit(1);
    }
    println("prod_isac_esprit_direction_finding: PASSED");
}
