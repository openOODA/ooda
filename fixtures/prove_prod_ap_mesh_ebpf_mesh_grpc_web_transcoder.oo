// # Product prove std/mesh_ebpf/mesh_grpc_web_transcoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/mesh_ebpf/mesh_grpc_web_transcoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_grpc_web_transcoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mesh_grpc_web_transcoder: PASSED only if they match.

import "std/mesh_ebpf/mesh_grpc_web_transcoder.oo";

pub fn main() {
    let mesh_grpc_web_transcoder_a = grpc_web_http_to_grpc_status(0);
    let mesh_grpc_web_transcoder_b = grpc_web_http_to_grpc_status(0);
    if mesh_grpc_web_transcoder_a != mesh_grpc_web_transcoder_b {
        println("FAIL mesh_grpc_web_transcoder");
        process_exit(1);
    }
    println("prod_ap_mesh_grpc_web_transcoder: PASSED");
}
