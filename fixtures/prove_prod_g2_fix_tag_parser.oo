// # Product prove std/fintech/fix_tag_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts fix_compute_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/fix_tag_parser.oo.
//
// Beats:
//   1. Call fix_compute_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fix_tag_parser: PASSED only if they match.

import "std/fintech/fix_tag_parser.oo";

pub fn main() {
    let fix_tag_parser_mark: Int = 0;
    if fix_tag_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = fix_compute_checksum("x");
    let b: Int = fix_compute_checksum("x");
    if a != b {
        println("FAIL fix_compute_checksum");
        process_exit(1);
    }
    println("prod_g2_fix_tag_parser: PASSED");
}
