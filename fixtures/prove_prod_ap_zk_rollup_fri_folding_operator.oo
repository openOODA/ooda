// # Product prove std/zk_rollup/fri_folding_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/fri_folding_operator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_folding_operator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fri_folding_operator: PASSED only if they match.

import "std/zk_rollup/fri_folding_operator.oo";

pub fn main() {
    let fri_folding_operator_a = fri_fold_single_pair(0, 0, 0, 0);
    let fri_folding_operator_b = fri_fold_single_pair(0, 0, 0, 0);
    if fri_folding_operator_a != fri_folding_operator_b {
        println("FAIL fri_folding_operator");
        process_exit(1);
    }
    println("prod_ap_fri_folding_operator: PASSED");
}
