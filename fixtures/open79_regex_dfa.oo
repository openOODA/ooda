// # Product regex class and compiled DFA
//
// Logline: [ab] matches in the NFA and in a compiled DFA table.
//
// Setup: OPEN-79. regex_nfa.oo class scan plus regex_dfa.oo dfa_compile.
//
// Beats:
//   1. NFA matches a and b and misses c.
//   2. dfa_compile([ab]) simulates a and b and misses c and ab.
//   3. Print PASSED.

import "std/text/regex_nfa.oo";
import "std/text/regex_dfa.oo";

pub fn main() {
    if !nfa_simulate("[ab]", "a") {
        println("FAIL nfa a");
        process_exit(1);
    }
    if !nfa_simulate("[ab]", "b") {
        println("FAIL nfa b");
        process_exit(1);
    }
    if nfa_simulate("[ab]", "c") {
        println("FAIL nfa c");
        process_exit(1);
    }
    let tab: DfaTable = dfa_compile("[ab]");
    if !dfa_simulate(tab, "a", 0) {
        println("FAIL dfa a");
        process_exit(1);
    }
    if !dfa_simulate(tab, "b", 0) {
        println("FAIL dfa b");
        process_exit(1);
    }
    if dfa_simulate(tab, "c", 0) {
        println("FAIL dfa c");
        process_exit(1);
    }
    if dfa_simulate(tab, "ab", 0) {
        println("FAIL dfa ab");
        process_exit(1);
    }
    println("open79: PASSED");
}
