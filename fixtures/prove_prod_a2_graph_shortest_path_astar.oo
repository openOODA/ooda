// # Product prove std/db_graph/graph_shortest_path_astar.oo
//
// Logline: Fail-closed emit+gcc+run asserts astar_euclidean_heuristic is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_shortest_path_astar.oo.
//
// Beats:
//   1. Call astar_euclidean_heuristic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_shortest_path_astar: PASSED only if they match.

import "std/db_graph/graph_shortest_path_astar.oo";

pub fn main() {
    let graph_shortest_path_astar_mark: Int = 0;
    if graph_shortest_path_astar_mark != 0 {
        process_exit(1);
    }
    let a: Float = astar_euclidean_heuristic(0.0, 0.0, 0.0, 0.0);
    let b: Float = astar_euclidean_heuristic(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL astar_euclidean_heuristic");
        process_exit(1);
    }
    println("prod_graph_shortest_path_astar: PASSED");
}
