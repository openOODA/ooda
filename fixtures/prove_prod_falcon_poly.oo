// # Product prove std/sec/crypto/falcon_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_polynomial_center_mod is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_poly.oo.
//
// Beats:
//   1. Call falcon_polynomial_center_mod twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_falcon_poly: PASSED only if they match.

import "std/sec/crypto/falcon_poly.oo";

pub fn main() {
    let a = falcon_polynomial_center_mod(0, 1);
    let b = falcon_polynomial_center_mod(0, 1);
    if a != b {
        println("FAIL falcon_polynomial_center_mod");
        process_exit(1);
    }
    println("prod_falcon_poly: PASSED");
}
