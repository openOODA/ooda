// # Product prove std/industrial_predictive/ts_isolation_forest_score.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_predictive/ts_isolation_forest_score.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_isolation_forest_score.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ts_isolation_forest_score: PASSED only if they match.

import "std/industrial_predictive/ts_isolation_forest_score.oo";

pub fn main() {
    let ts_isolation_forest_score_a = int_to_float(0);
    let ts_isolation_forest_score_b = int_to_float(0);
    if ts_isolation_forest_score_a != ts_isolation_forest_score_b {
        println("FAIL ts_isolation_forest_score");
        process_exit(1);
    }
    println("prod_ap_ts_isolation_forest_score: PASSED");
}
