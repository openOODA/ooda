// # Product prove std/cloud_k8s/crdt_or_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts or_set_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/crdt_or_set.oo.
//
// Beats:
//   1. Call or_set_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crdt_or_set: PASSED only if they match.

import "std/cloud_k8s/crdt_or_set.oo";

pub fn main() {
    let crdt_or_set_mark: Int = 0;
    if crdt_or_set_mark != 0 {
        process_exit(1);
    }
    let a: OrSet = or_set_new();
    let b: OrSet = or_set_new();
    if (a).v0 != (b).v0 {
        println("FAIL or_set_new");
        process_exit(1);
    }
    println("prod_crdt_or_set: PASSED");
}
