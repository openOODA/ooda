// # Product prove std/fintech_l3_book/drop_copy_audit_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts drop_copy_session_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/drop_copy_audit_stream.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call drop_copy_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_drop_copy_audit_stream: PASSED only if they match.

import "std/fintech_l3_book/drop_copy_audit_stream.oo";

pub fn main() {
    let g2_oa: DropCopySession = drop_copy_session_new("x", "x");
    let g2_ob: DropCopySession = drop_copy_session_new("x", "x");
    let g2_a = (g2_oa).last_sent_seq;
    let g2_b = (g2_ob).last_sent_seq;
    if g2_a != g2_b {
        println("FAIL drop_copy_session_new.last_sent_seq");
        process_exit(1);
    }
    println("prod_g2_drop_copy_audit_stream: PASSED");
}
