// # Product arena_allocator prove
//
// Logline: Fail-closed emit+gcc+run of shipped arena_alloc/remaining.
//
// Setup: Product std/collections/arena_allocator.oo. Cap 64, alloc 8.
//
// Beats:
//   1. After alloc 8, remaining is 56; offset 0.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/arena_allocator.oo";

pub fn main() {
    let a: Arena = arena_new(64);
    let res: ArenaAllocResult = arena_bump(a, 8);
    let off: Int = res.offset;
    if off != 0 {
        println("FAIL arena off");
        process_exit(1);
    }
    let rem: Int = arena_remaining_bytes(res.arena);
    if rem != 56 {
        println("FAIL arena rem");
        process_exit(1);
    }
    println("prod_arena: PASSED");
}
