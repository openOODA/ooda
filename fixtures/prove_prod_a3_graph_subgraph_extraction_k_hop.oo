// # Product prove std/graph_gnn/graph_subgraph_extraction_k_hop.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_drnl_label is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_subgraph_extraction_k_hop.oo.
//
// Beats:
//   1. Call compute_drnl_label twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_subgraph_extraction_k_hop: PASSED only if they match.

import "std/graph_gnn/graph_subgraph_extraction_k_hop.oo";

pub fn main() {
    let graph_subgraph_extraction_k_hop_mark: Int = 0;
    if graph_subgraph_extraction_k_hop_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_drnl_label(0, 0);
    let b: Int = compute_drnl_label(0, 0);
    if a != b {
        println("FAIL compute_drnl_label");
        process_exit(1);
    }
    println("prod_graph_subgraph_extraction_k_hop: PASSED");
}
