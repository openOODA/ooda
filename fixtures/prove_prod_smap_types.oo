// # Product prove std/sec/sys/smap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts smap_status_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/smap_types.oo.
//
// Beats:
//   1. Call smap_status_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smap_types: PASSED only if they match.

import "std/sec/sys/smap_types.oo";

pub fn main() {
    let obj = smap_status_new();
    let a = obj.violation_count;
    let b = obj.violation_count;
    if a != b {
        println("FAIL smap_status_new");
        process_exit(1);
    }
    println("prod_smap_types: PASSED");
}
