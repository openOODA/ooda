// # Product prove std/zk_rollup/fri_parameters.oo
//
// Logline: Fail-closed emit+gcc+run asserts fri_parameters_100_bits value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_parameters.oo.
//
// Beats:
//   1. Call fri_parameters_100_bits twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_fri_parameters: PASSED only if asserts hold.

import "std/zk_rollup/fri_parameters.oo";

pub fn main() {
    let fri_parameters: FriParameters = fri_parameters_100_bits(1);
    let fri_parameters_b: FriParameters = fri_parameters_100_bits(1);
    if (fri_parameters).blowup_factor != 4 {
        println("FAIL fri blowup");
        process_exit(1);
    }
    if (fri_parameters).num_query_rounds != 40 {
        println("FAIL fri queries");
        process_exit(1);
    }
    if (fri_parameters).blowup_factor != (fri_parameters_b).blowup_factor {
        println("FAIL fri det");
        process_exit(1);
    }
    println("prod_fri_parameters: PASSED");
}
