// # Product prove std/wasm_gc/wasm_component_canonical_abi.oo
//
// Logline: Fail-closed emit+gcc+run asserts flat_val_i32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_canonical_abi.oo.
//
// Beats:
//   1. Call flat_val_i32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_canonical_abi: PASSED only if they match.

import "std/wasm_gc/wasm_component_canonical_abi.oo";

pub fn main() {
    let a: FlatVal = flat_val_i32(0);
    let b: FlatVal = flat_val_i32(0);
    if a.tag != b.tag {
        println("FAIL flat_val_i32");
        process_exit(1);
    }
    println("prod_wasm_component_canonical_abi: PASSED");
}
