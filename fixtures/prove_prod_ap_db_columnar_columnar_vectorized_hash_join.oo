// # Product prove std/db_columnar/columnar_vectorized_hash_join.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_vectorized_hash_join.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_hash_join.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_vectorized_hash_join: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_hash_join.oo";

pub fn main() {
    let columnar_vectorized_hash_join_a = hash_int_key(0, 0);
    let columnar_vectorized_hash_join_b = hash_int_key(0, 0);
    if columnar_vectorized_hash_join_a != columnar_vectorized_hash_join_b {
        println("FAIL columnar_vectorized_hash_join");
        process_exit(1);
    }
    println("prod_ap_columnar_vectorized_hash_join: PASSED");
}
