// # Refuse a direct secret alias
//
// Logline: A direct IDENT assign from a secret name taints the later println.
//
// Beats:
//   1. Tag x at line start.
//   2. Bind y to that IDENT.
//   3. Print y so the sink refuses.

// M53 path B — direct IDENT assign-prop: println(y) after let y = x
// SECRET: x
pub fn main() {
    let x = "token";
    let y = x;
    println(y);
}
