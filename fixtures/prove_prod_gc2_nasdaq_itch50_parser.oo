// # Product prove std/fintech_l3_book/nasdaq_itch50_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts itch_parse_result_error is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_parser.oo.
//
// Beats:
//   1. Call itch_parse_result_error twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nasdaq_itch50_parser: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_parser.oo";

pub fn main() {
    let nasdaq_itch50_parser_mark: Int = 0;
    if nasdaq_itch50_parser_mark != 0 {
        process_exit(1);
    }
    let nasdaq_itch50_parser_a = itch_parse_result_error();
    let nasdaq_itch50_parser_b = itch_parse_result_error();
    if (nasdaq_itch50_parser_a).locate_code != (nasdaq_itch50_parser_b).locate_code {
        println("FAIL itch_parse_result_error");
        process_exit(1);
    }
    println("prod_nasdaq_itch50_parser: PASSED");
}
