// # Product prove std/astro_advanced/low_thrust_spiral.oo
//
// Logline: Fail-closed emit+gcc+run asserts spiral_revs is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/low_thrust_spiral.oo.
//
// Beats:
//   1. Call spiral_revs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_low_thrust_spiral: PASSED only if they match.

import "std/astro_advanced/low_thrust_spiral.oo";

pub fn main() {
    let low_thrust_spiral_mark: Int = 0;
    if low_thrust_spiral_mark != 0 {
        process_exit(1);
    }
    let a: Int = spiral_revs();
    let b: Int = spiral_revs();
    if a != b {
        println("FAIL spiral_revs");
        process_exit(1);
    }
    println("prod_low_thrust_spiral: PASSED");
}
