// # Product prove std/genomics_advanced/bwa_mem_seed_extend.oo
//
// Logline: Fail-closed verification that BWA-MEM seed collinearity checking, seed chaining, and banded affine extension are deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/bwa_mem_seed_extend.oo.
//
// Beats:
//   1. Construct BwaMemSeed instances and check collinearity.
//   2. Compute seed chaining score with match and gap penalty weights.
//   3. Evaluate banded affine gap extension scoring and optimality.
//   4. Print prod_g4_genomics_bwa_mem: PASSED and exit 0.

import "std/genomics_advanced/bwa_mem_seed_extend.oo";

pub fn main() {
    let s1: BwaMemSeed = BwaMemSeed {
        q_start: 0,
        q_end: 20,
        r_start: 100,
        r_end: 120,
        length: 20,
    };
    let s2: BwaMemSeed = BwaMemSeed {
        q_start: 25,
        q_end: 45,
        r_start: 125,
        r_end: 145,
        length: 20,
    };

    let col1: Bool = bwa_seed_is_collinear(&s1, &s2, 10);
    let col2: Bool = bwa_seed_is_collinear(&s1, &s2, 10);
    if col1 != col2 || !col1 {
        println("FAIL bwa_seed_is_collinear");
        process_exit(1);
    }

    let score1: Int = bwa_chain_seed_score(&s1, &s2, 2, 1);
    let score2: Int = bwa_chain_seed_score(&s1, &s2, 2, 1);
    if score1 != score2 || score1 <= 0 {
        println("FAIL bwa_chain_seed_score");
        process_exit(1);
    }

    let ext1: BwaAlignmentExtension = bwa_extend_banded_affine(100, 100, 40, 2, 1, 2, 4, 6, 1);
    let ext2: BwaAlignmentExtension = bwa_extend_banded_affine(100, 100, 40, 2, 1, 2, 4, 6, 1);

    if (ext1).final_sw_score != (ext2).final_sw_score {
        println("FAIL bwa_extend_banded_affine final_sw_score");
        process_exit(1);
    }
    if (ext1).is_optimal != (ext2).is_optimal || !(ext1).is_optimal {
        println("FAIL bwa_extend_banded_affine is_optimal");
        process_exit(1);
    }

    println("prod_g4_genomics_bwa_mem: PASSED");
    process_exit(0);
}
