// # Product prove std/sec/crypto/zkstark_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts air_constraint_degree is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zkstark_types.oo.
//
// Beats:
//   1. Call air_constraint_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zkstark_types: PASSED only if they match.

import "std/sec/crypto/zkstark_types.oo";

pub fn main() {
    let obj = air_constraint_new(0, 0, 0);
    let a = air_constraint_degree(obj);
    let b = air_constraint_degree(obj);
    if a != b {
        println("FAIL air_constraint_degree");
        process_exit(1);
    }
    println("prod_zkstark_types: PASSED");
}
