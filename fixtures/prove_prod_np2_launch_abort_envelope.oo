// # Product prove std/space_propulsion/launch_abort_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts abort_evaluate_pad_escape is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/launch_abort_envelope.oo.
//
// Beats:
//   1. Call abort_evaluate_pad_escape twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_abort_envelope: PASSED only if they match.

import "std/space_propulsion/launch_abort_envelope.oo";

pub fn main() {
    let launch_abort_envelope_mark: Int = 0;
    if launch_abort_envelope_mark != 0 {
        process_exit(1);
    }
    let launch_abort_envelope_a = abort_evaluate_pad_escape(launch_abort_spec_default());
    let launch_abort_envelope_b = abort_evaluate_pad_escape(launch_abort_spec_default());
    if (launch_abort_envelope_a).can_safely_parachute != (launch_abort_envelope_b).can_safely_parachute {
        println("FAIL abort_evaluate_pad_escape");
        process_exit(1);
    }
    println("prod_launch_abort_envelope: PASSED");
}
