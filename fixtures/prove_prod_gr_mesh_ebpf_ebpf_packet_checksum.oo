// # Product prove std/mesh_ebpf/ebpf_packet_checksum.oo
//
// Logline: Fail-closed emit+gcc+run asserts checksum_calc_ipv4_header is a real value.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_packet_checksum.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call checksum_calc_ipv4_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ebpf_packet_checksum: PASSED only if they match.

import "std/mesh_ebpf/ebpf_packet_checksum.oo";

pub fn main() {
    let g0_a = checksum_calc_ipv4_header(0, 0, 1, 0, 0, 0, 0, 0, 0);
    let g0_b = checksum_calc_ipv4_header(0, 0, 1, 0, 0, 0, 0, 0, 0);
    if g0_a != g0_b {
        println("FAIL checksum_calc_ipv4_header");
        process_exit(1);
    }
    println("prod_gr_ebpf_packet_checksum: PASSED");
}
