// # Product prove std/quantum_open_systems/environmental_backaction_evasion.oo
//
// Logline: Fail-closed emit+gcc+run asserts backaction_is_sub_sql is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/environmental_backaction_evasion.oo.
//
// Beats:
//   1. Call backaction_is_sub_sql twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_environmental_backaction_evasion: PASSED only if they match.

import "std/quantum_open_systems/environmental_backaction_evasion.oo";

pub fn main() {
    let environmental_backaction_evasion_mark: Int = 0;
    if environmental_backaction_evasion_mark != 0 {
        process_exit(1);
    }
    let a: Int = backaction_is_sub_sql(0.0);
    let b: Int = backaction_is_sub_sql(0.0);
    if a != b {
        println("FAIL backaction_is_sub_sql");
        process_exit(1);
    }
    println("prod_environmental_backaction_evasion: PASSED");
}
