// # Product prove std/quantum_topological/topological_majorana_braiding_gate.oo
//
// Logline: Fail-closed emit+gcc+run asserts t_junction_check_adiabaticity is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_majorana_braiding_gate.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call t_junction_check_adiabaticity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_topological_majorana_braiding_gate: PASSED only if they match.

import "std/quantum_topological/topological_majorana_braiding_gate.oo";

pub fn main() {
    let g0_a = t_junction_check_adiabaticity(1.0, 1.0);
    let g0_b = t_junction_check_adiabaticity(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL t_junction_check_adiabaticity");
        process_exit(1);
    }
    println("prod_g0_topological_majorana_braiding_gate: PASSED");
}
