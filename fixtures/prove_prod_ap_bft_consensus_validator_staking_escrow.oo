// # Product prove std/bft_consensus/validator_staking_escrow.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/validator_staking_escrow.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/validator_staking_escrow.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_validator_staking_escrow: PASSED only if they match.

import "std/bft_consensus/validator_staking_escrow.oo";

pub fn main() {
    let validator_staking_escrow_a = staking_escrow_new();
    let validator_staking_escrow_b = staking_escrow_new();
    if validator_staking_escrow_a.total_bonded != validator_staking_escrow_b.total_bonded {
        println("FAIL validator_staking_escrow");
        process_exit(1);
    }
    println("prod_ap_validator_staking_escrow: PASSED");
}
