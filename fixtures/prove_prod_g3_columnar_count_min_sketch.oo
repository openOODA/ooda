// # Product prove std/db_columnar/columnar_count_min_sketch.oo
//
// Logline: Fail-closed emit+gcc+run asserts cms_hash_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_count_min_sketch.oo.
//
// Beats:
//   1. Call cms_hash_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_count_min_sketch: PASSED only if they match.

import "std/db_columnar/columnar_count_min_sketch.oo";

pub fn main() {
    let columnar_count_min_sketch_mark: Int = 0;
    if columnar_count_min_sketch_mark != 0 {
        process_exit(1);
    }
    let a: Int = cms_hash_int(0, 0, 0);
    let b: Int = cms_hash_int(0, 0, 0);
    if a != b {
        println("FAIL cms_hash_int");
        process_exit(1);
    }
    println("prod_columnar_count_min_sketch: PASSED");
}
