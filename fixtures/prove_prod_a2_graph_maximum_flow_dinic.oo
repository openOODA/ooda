// # Product prove std/db_graph/graph_maximum_flow_dinic.oo
//
// Logline: Fail-closed emit+gcc+run asserts dinic_edge_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_maximum_flow_dinic.oo.
//
// Beats:
//   1. Call dinic_edge_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_maximum_flow_dinic: PASSED only if they match.

import "std/db_graph/graph_maximum_flow_dinic.oo";

pub fn main() {
    let graph_maximum_flow_dinic_mark: Int = 0;
    if graph_maximum_flow_dinic_mark != 0 {
        process_exit(1);
    }
    let a: DinicEdge = dinic_edge_new(0, 0, 0.0, 0);
    let b: DinicEdge = dinic_edge_new(0, 0, 0.0, 0);
    if (a).src != (b).src {
        println("FAIL dinic_edge_new");
        process_exit(1);
    }
    println("prod_graph_maximum_flow_dinic: PASSED");
}
