// # Product prove std/db_graph/graph_community_louvain.oo
//
// Logline: Fail-closed emit+gcc+run asserts louvain_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_community_louvain.oo.
//
// Beats:
//   1. Call louvain_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_community_louvain: PASSED only if they match.

import "std/db_graph/graph_community_louvain.oo";

pub fn main() {
    let graph_community_louvain_mark: Int = 0;
    if graph_community_louvain_mark != 0 {
        process_exit(1);
    }
    let a: LouvainConfig = louvain_config_default();
    let b: LouvainConfig = louvain_config_default();
    if (a).max_passes != (b).max_passes {
        println("FAIL louvain_config_default");
        process_exit(1);
    }
    println("prod_graph_community_louvain: PASSED");
}
