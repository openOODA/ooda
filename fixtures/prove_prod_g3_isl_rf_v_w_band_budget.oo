// # Product prove std/satellite_dvb/isl_rf_v_w_band_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts rf_isl_calc_fspl_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_rf_v_w_band_budget.oo.
//
// Beats:
//   1. Call rf_isl_calc_fspl_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isl_rf_v_w_band_budget: PASSED only if they match.

import "std/satellite_dvb/isl_rf_v_w_band_budget.oo";

pub fn main() {
    let isl_rf_v_w_band_budget_mark: Int = 0;
    if isl_rf_v_w_band_budget_mark != 0 {
        process_exit(1);
    }
    let a: Float = rf_isl_calc_fspl_db(0.0, 0.0);
    let b: Float = rf_isl_calc_fspl_db(0.0, 0.0);
    if a != b {
        println("FAIL rf_isl_calc_fspl_db");
        process_exit(1);
    }
    println("prod_isl_rf_v_w_band_budget: PASSED");
}
