// # Product prove std/formal_verif/relying_guarantee_concurrency.oo
//
// Logline: Fail-closed emit+gcc+run asserts rely_guarantee_spec_new is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/relying_guarantee_concurrency.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rely_guarantee_spec_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_relying_guarantee_concurrency: PASSED only if they match.

import "std/formal_verif/relying_guarantee_concurrency.oo";

pub fn main() {
    let g2_oa: RelyGuaranteeSpec = rely_guarantee_spec_new(2, "x", "x", "x", "x");
    let g2_ob: RelyGuaranteeSpec = rely_guarantee_spec_new(2, "x", "x", "x", "x");
    let g2_a = (g2_oa).thread_id;
    let g2_b = (g2_ob).thread_id;
    if g2_a != g2_b {
        println("FAIL rely_guarantee_spec_new.thread_id");
        process_exit(1);
    }
    println("prod_g2_relying_guarantee_concurrency: PASSED");
}
