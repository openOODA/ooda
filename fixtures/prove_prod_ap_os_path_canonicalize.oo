// # Product prove std/os/path_canonicalize.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/path_canonicalize.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/path_canonicalize.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_path_canonicalize: PASSED only if they match.

import "std/os/path_canonicalize.oo";

pub fn main() {
    let path_canonicalize_a = path_clean_slashes("x");
    let path_canonicalize_b = path_clean_slashes("x");
    if path_canonicalize_a.contains(path_canonicalize_b) == false {
        println("FAIL path_canonicalize");
        process_exit(1);
    }
    if path_canonicalize_b.contains(path_canonicalize_a) == false {
        println("FAIL path_canonicalize");
        process_exit(1);
    }
    println("prod_ap_path_canonicalize: PASSED");
}
