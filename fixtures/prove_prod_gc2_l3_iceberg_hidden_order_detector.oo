// # Product prove std/fintech_l3_book/l3_iceberg_hidden_order_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts iceberg_signature_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_iceberg_hidden_order_detector.oo.
//
// Beats:
//   1. Call iceberg_signature_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_iceberg_hidden_order_detector: PASSED only if they match.

import "std/fintech_l3_book/l3_iceberg_hidden_order_detector.oo";

pub fn main() {
    let l3_iceberg_hidden_order_detector_mark: Int = 0;
    if l3_iceberg_hidden_order_detector_mark != 0 {
        process_exit(1);
    }
    let l3_iceberg_hidden_order_detector_a = iceberg_signature_new(1, "x", 1, 1);
    let l3_iceberg_hidden_order_detector_b = iceberg_signature_new(1, "x", 1, 1);
    if (l3_iceberg_hidden_order_detector_a).price_fixed != (l3_iceberg_hidden_order_detector_b).price_fixed {
        println("FAIL iceberg_signature_new");
        process_exit(1);
    }
    println("prod_l3_iceberg_hidden_order_detector: PASSED");
}
