// # Product prove std/quantum_tensor_nets/chebyshev_mps_expansion.oo
//
// Logline: Fail-closed emit+gcc+run asserts jackson_kernel_damping is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/chebyshev_mps_expansion.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call jackson_kernel_damping twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_chebyshev_mps_expansion: PASSED only if they match.

import "std/quantum_tensor_nets/chebyshev_mps_expansion.oo";

pub fn main() {
    let g2_a = jackson_kernel_damping(2, 2);
    let g2_b = jackson_kernel_damping(2, 2);
    if g2_a != g2_b {
        println("FAIL jackson_kernel_damping");
        process_exit(1);
    }
    println("prod_g2_chebyshev_mps_expansion: PASSED");
}
