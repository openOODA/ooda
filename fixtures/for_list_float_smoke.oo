// # Collection for-in List[Float] emit lock
//
// Logline: Fail-closed emit+gcc+run of for x in xs over List[Float].
//
// Setup: Backend-C. Loop body sees Float elements.
//
// Beats:
//   1. Push 1.0 and 1.5.
//   2. Sum with for x in xs.
//   3. Exit 1 before PASSED when the sum is not 2.5.

pub fn main() {
    let mut xs: List[Float] = list_new();
    xs = list_push(xs, 1.0);
    xs = list_push(xs, 1.5);
    let mut s: Float = 0.0;
    for x in xs {
        s = s + x;
    }
    if s != 2.5 {
        println("FAIL");
        process_exit(1);
    }
    println("for_list_float_smoke: PASSED");
}
