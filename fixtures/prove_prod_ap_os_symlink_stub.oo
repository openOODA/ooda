// # Product prove std/os/symlink_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/symlink_stub.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/symlink_stub.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_symlink_stub: PASSED only if they match.

import "std/os/symlink_stub.oo";

pub fn main() {
    let symlink_stub_a = symlink_desc_new("x", "x");
    let symlink_stub_b = symlink_desc_new("x", "x");
    let symlink_stub_va = symlink_target(symlink_stub_a);
    let symlink_stub_vb = symlink_target(symlink_stub_b);
    if symlink_stub_va.contains(symlink_stub_vb) == false {
        println("FAIL symlink_stub");
        process_exit(1);
    }
    if symlink_stub_vb.contains(symlink_stub_va) == false {
        println("FAIL symlink_stub");
        process_exit(1);
    }
    println("prod_ap_symlink_stub: PASSED");
}
