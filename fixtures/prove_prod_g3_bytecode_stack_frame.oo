// # Product prove std/compilers_vm/bytecode_stack_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts vm_stack_frame_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_stack_frame.oo.
//
// Beats:
//   1. Call vm_stack_frame_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_stack_frame: PASSED only if they match.

import "std/compilers_vm/bytecode_stack_frame.oo";

pub fn main() {
    let bytecode_stack_frame_mark: Int = 0;
    if bytecode_stack_frame_mark != 0 {
        process_exit(1);
    }
    let a: VmStackFrame = vm_stack_frame_new(0, "x", 0, 0, 0);
    let b: VmStackFrame = vm_stack_frame_new(0, "x", 0, 0, 0);
    if (a).frame_id != (b).frame_id {
        println("FAIL vm_stack_frame_new");
        process_exit(1);
    }
    println("prod_bytecode_stack_frame: PASSED");
}
