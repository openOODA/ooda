// # Product prove std/ai_ml/metric_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/metric_loss.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/metric_loss.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_metric_loss: PASSED only if they match.

import "std/ai_ml/metric_loss.oo";

pub fn main() {
    let metric_loss_a = mse_loss(0, 0);
    let metric_loss_b = mse_loss(0, 0);
    if metric_loss_a != metric_loss_b {
        println("FAIL metric_loss");
        process_exit(1);
    }
    println("prod_ap_metric_loss: PASSED");
}
