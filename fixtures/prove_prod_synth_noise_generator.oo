// # Product prove std/media_dsp/synth_noise_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts synth_noise_generator_new real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_noise_generator.oo.
//
// Beats:
//   1. Call synth_noise_generator_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_noise_generator: PASSED only if the assert holds.

import "std/media_dsp/synth_noise_generator.oo";

pub fn main() {
    let synth_noise_generator_a = synth_noise_generator_new(7);
    let synth_noise_generator_pink_b0: Float = (synth_noise_generator_a).pink_b0;
    if !(synth_noise_generator_pink_b0 == 0.0) {
        println("FAIL synth_noise_generator_new");
        process_exit(1);
    }
    println("prod_synth_noise_generator: PASSED");
}
