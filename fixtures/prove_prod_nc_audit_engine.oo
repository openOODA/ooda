// # Product prove std/enterprise/audit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_engine.oo.
//
// Beats:
//   1. Call audit_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_audit_engine: PASSED only if it matches.

import "std/enterprise/audit_engine.oo";

pub fn main() {
    let a: Int = audit_engine_probe();
    if a != 0 {
        println("FAIL audit_engine_probe");
        process_exit(1);
    }
    println("prod_nc_audit_engine: PASSED");
}
