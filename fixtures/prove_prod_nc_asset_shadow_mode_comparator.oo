// # Product prove std/digital_twin/asset_shadow_mode_comparator.oo
//
// Logline: Fail-closed emit+gcc+run asserts asset_shadow_mode_comparator_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_shadow_mode_comparator.oo.
//
// Beats:
//   1. Call asset_shadow_mode_comparator_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_asset_shadow_mode_comparator: PASSED only if it matches.

import "std/digital_twin/asset_shadow_mode_comparator.oo";

pub fn main() {
    let a: Int = asset_shadow_mode_comparator_probe();
    if a != 0 {
        println("FAIL asset_shadow_mode_comparator_probe");
        process_exit(1);
    }
    println("prod_nc_asset_shadow_mode_comparator: PASSED");
}
