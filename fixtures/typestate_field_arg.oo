// # Connect a boxed field
//
// Logline: Store the Sock in a Box field and connect through b.s so field tracking must fire.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Store s in Box.s.
//   3. Connect through the field.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

type Box = struct { s: Int }

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    let b = Box { s: s };
    connect(b.s);
}
