// # Product prove std/ai_ml/layer_embedding.oo
//
// Logline: Fail-closed emit+gcc+run asserts positional_encoding_sinusoidal is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_embedding.oo.
//
// Beats:
//   1. Call positional_encoding_sinusoidal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_layer_embedding: PASSED only if they match.

import "std/ai_ml/layer_embedding.oo";

pub fn main() {
    let layer_embedding_mark: Int = 0;
    if layer_embedding_mark != 0 {
        process_exit(1);
    }
    let layer_embedding_a = positional_encoding_sinusoidal(1, 1);
    let layer_embedding_b = positional_encoding_sinusoidal(1, 1);
    if (layer_embedding_a).rows != (layer_embedding_b).rows {
        println("FAIL positional_encoding_sinusoidal");
        process_exit(1);
    }
    println("prod_layer_embedding: PASSED");
}
