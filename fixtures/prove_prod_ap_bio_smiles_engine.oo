// # Product prove std/bio/smiles_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/smiles_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_smiles_engine: PASSED only if they match.

import "std/bio/smiles_engine.oo";

pub fn main() {
    let smiles_engine_a = fingerprint_create_empty(0, "x");
    let smiles_engine_b = fingerprint_create_empty(0, "x");
    let smiles_engine_va = fingerprint_has_bit(smiles_engine_a, 0);
    let smiles_engine_vb = fingerprint_has_bit(smiles_engine_b, 0);
    if smiles_engine_va != smiles_engine_vb {
        println("FAIL smiles_engine");
        process_exit(1);
    }
    println("prod_ap_smiles_engine: PASSED");
}
