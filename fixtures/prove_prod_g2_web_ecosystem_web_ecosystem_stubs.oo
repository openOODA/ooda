// # Product prove std/web_ecosystem/web_ecosystem_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts web_eco_hardware_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/web_ecosystem_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call web_eco_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_web_ecosystem_stubs: PASSED only if they match.

import "std/web_ecosystem/web_ecosystem_stubs.oo";

pub fn main() {
    let g2_oa: WebEcoHardwareConfig = web_eco_hardware_config_new("x");
    let g2_ob: WebEcoHardwareConfig = web_eco_hardware_config_new("x");
    let g2_a = (g2_oa).enabled;
    let g2_b = (g2_ob).enabled;
    if g2_a != g2_b {
        println("FAIL web_eco_hardware_config_new.enabled");
        process_exit(1);
    }
    println("prod_g2_web_ecosystem_stubs: PASSED");
}
