// # Product prove std/space_propulsion/chapman_reentry_stagnation_heat.oo
//
// Logline: Fail-closed emit+gcc+run asserts stagnation_spec_default_lunar_return is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/chapman_reentry_stagnation_heat.oo.
//
// Beats:
//   1. Call stagnation_spec_default_lunar_return twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chapman_reentry_stagnation_heat: PASSED only if they match.

import "std/space_propulsion/chapman_reentry_stagnation_heat.oo";

pub fn main() {
    let chapman_reentry_stagnation_heat_mark: Int = 0;
    if chapman_reentry_stagnation_heat_mark != 0 {
        process_exit(1);
    }
    let a: StagnationHeatingSpec = stagnation_spec_default_lunar_return();
    let b: StagnationHeatingSpec = stagnation_spec_default_lunar_return();
    if (a).planetary_gas_type != (b).planetary_gas_type {
        println("FAIL stagnation_spec_default_lunar_return");
        process_exit(1);
    }
    println("prod_chapman_reentry_stagnation_heat: PASSED");
}
