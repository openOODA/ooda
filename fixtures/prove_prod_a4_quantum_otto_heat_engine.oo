// # Product prove std/quantum_open_systems/quantum_otto_heat_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_otto_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_otto_heat_engine.oo.
//
// Beats:
//   1. Call quantum_otto_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_otto_heat_engine: PASSED only if they match.

import "std/quantum_open_systems/quantum_otto_heat_engine.oo";

pub fn main() {
    let quantum_otto_heat_engine_mark: Int = 0;
    if quantum_otto_heat_engine_mark != 0 {
        process_exit(1);
    }
    let a: QuantumOttoConfig = quantum_otto_config_new(0.0, 0.0, 0.0, 0.0);
    let b: QuantumOttoConfig = quantum_otto_config_new(0.0, 0.0, 0.0, 0.0);
    if (a).omega_cold_low != (b).omega_cold_low {
        println("FAIL quantum_otto_config_new");
        process_exit(1);
    }
    println("prod_quantum_otto_heat_engine: PASSED");
}
