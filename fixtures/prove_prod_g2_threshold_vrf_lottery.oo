// # Product prove std/bft_consensus/threshold_vrf_lottery.oo
//
// Logline: Fail-closed emit+gcc+run asserts vrf_beacon_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/threshold_vrf_lottery.oo.
//
// Beats:
//   1. Call vrf_beacon_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_threshold_vrf_lottery: PASSED only if they match.

import "std/bft_consensus/threshold_vrf_lottery.oo";

pub fn main() {
    let threshold_vrf_lottery_mark: Int = 0;
    if threshold_vrf_lottery_mark != 0 {
        process_exit(1);
    }
    let a: VrfRandomBeacon = vrf_beacon_new(0, 0);
    let b: VrfRandomBeacon = vrf_beacon_new(0, 0);
    if (a).round != (b).round {
        println("FAIL vrf_beacon_new");
        process_exit(1);
    }
    println("prod_g2_threshold_vrf_lottery: PASSED");
}
