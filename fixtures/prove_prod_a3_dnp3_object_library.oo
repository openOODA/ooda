// # Product prove std/iot_scada/dnp3_object_library.oo
//
// Logline: Fail-closed emit+gcc+run asserts dnp3_binary_input_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_object_library.oo.
//
// Beats:
//   1. Call dnp3_binary_input_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dnp3_object_library: PASSED only if they match.

import "std/iot_scada/dnp3_object_library.oo";

pub fn main() {
    let dnp3_object_library_mark: Int = 0;
    if dnp3_object_library_mark != 0 {
        process_exit(1);
    }
    let a: Dnp3BinaryInput = dnp3_binary_input_new(0, true, 0);
    let b: Dnp3BinaryInput = dnp3_binary_input_new(0, true, 0);
    if (a).point_index != (b).point_index {
        println("FAIL dnp3_binary_input_new");
        process_exit(1);
    }
    println("prod_dnp3_object_library: PASSED");
}
