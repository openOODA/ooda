// # Product prove std/edge/mesh_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_config_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/mesh_ops.oo.
//
// Beats:
//   1. Call mesh_config_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_ops: PASSED only if they match.

import "std/edge/mesh_ops.oo";

pub fn main() {
    let mesh_ops_mark: Int = 0;
    if mesh_ops_mark != 0 {
        process_exit(1);
    }
    let a: MeshNodeConfig = mesh_config_init(0, 0, 0);
    let b: MeshNodeConfig = mesh_config_init(0, 0, 0);
    if (a).node_id != (b).node_id {
        println("FAIL mesh_config_init");
        process_exit(1);
    }
    println("prod_mesh_ops: PASSED");
}
