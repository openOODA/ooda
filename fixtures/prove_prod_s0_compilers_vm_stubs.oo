// # Product prove std/compilers_vm/compilers_vm_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts compiler_vm_stubs_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/compilers_vm_stubs.oo.
//
// Beats:
//   1. Call compiler_vm_stubs_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_compilers_vm_stubs: PASSED only if asserts hold.

import "std/compilers_vm/compilers_vm_stubs.oo";

pub fn main() {
    let compilers_vm_stubs_a: CompilerVmStubSuite = compiler_vm_stubs_default();
    let compilers_vm_stubs_b: CompilerVmStubSuite = compiler_vm_stubs_default();
    if compilers_vm_stubs_a.num_test_graphs != compilers_vm_stubs_b.num_test_graphs {
        println("FAIL compiler_vm_stubs_default");
        process_exit(1);
    }
    println("prod_compilers_vm_stubs: PASSED");
}
