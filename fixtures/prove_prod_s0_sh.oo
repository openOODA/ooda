// # Product prove std/sh.oo
//
// Logline: Fail-closed emit+gcc+run asserts sh_arg_ok value or determinism.
//
// Setup: Isolated emit-c. Imports std/sh.oo.
//
// Beats:
//   1. Call sh_arg_ok twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_sh: PASSED only if asserts hold.

import "std/sh.oo";

pub fn main() {
    let sh_a: Bool = sh_arg_ok("abc");
    let sh_b: Bool = sh_arg_ok("abc");
    if sh_a != true {
        println("FAIL sh_arg_ok");
        process_exit(1);
    }
    if sh_a != sh_b {
        println("FAIL sh_arg_ok det");
        process_exit(1);
    }
    if sh_arg_ok("a;b") != false {
        println("FAIL sh_arg_ok reject");
        process_exit(1);
    }
    println("prod_sh: PASSED");
}
