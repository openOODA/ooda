// # Product prove std/astrodynamics/patched_conics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/patched_conics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/patched_conics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_patched_conics: PASSED only if they match.

import "std/astrodynamics/patched_conics.oo";

pub fn main() {
    let patched_conics_a = patched_bodies();
    let patched_conics_b = patched_bodies();
    if patched_conics_a != patched_conics_b {
        println("FAIL patched_conics");
        process_exit(1);
    }
    println("prod_ap_patched_conics: PASSED");
}
