// M166 path A: product malloc/free free names under AllocCap (aliases alloc_bytes/free_bytes)
// Not OS malloc / heap sandbox / GC — process-local AllocCap seal only.
// residual: some hosts SEGV on `let p = malloc(...)` (c_emit_let bind of sealed alloc);
// nested free(malloc(...)) is the path-A product shape that emits+runs on current oodac.
pub fn main(alloc: &AllocCap) {
    free(alloc, malloc(alloc, 64));
    println("ok");
}
