// # Product prove std/space_propulsion/interplanetary_porkchop_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts porkchop_evaluate_earth_mars_point value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/interplanetary_porkchop_generator.oo.
//
// Beats:
//   1. Call porkchop_evaluate_earth_mars_point twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_interplanetary_porkchop_generator: PASSED only if asserts hold.

import "std/space_propulsion/interplanetary_porkchop_generator.oo";

pub fn main() {
    let interplanetary_porkchop_generator: PorkchopTransferGridPoint = porkchop_evaluate_earth_mars_point(1.0, 1.0);
    let interplanetary_porkchop_generator_b: PorkchopTransferGridPoint = porkchop_evaluate_earth_mars_point(1.0, 1.0);
    if (interplanetary_porkchop_generator).departure_day_offset != 1.0 {
        println("FAIL porkchop_evaluate_earth_mars_point departure_day_offset");
        process_exit(1);
    }
    if (interplanetary_porkchop_generator).departure_day_offset != (interplanetary_porkchop_generator_b).departure_day_offset {
        println("FAIL porkchop_evaluate_earth_mars_point det");
        process_exit(1);
    }
    println("prod_interplanetary_porkchop_generator: PASSED");
}
