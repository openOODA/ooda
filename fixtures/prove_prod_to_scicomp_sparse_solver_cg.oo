// # Product prove std/scicomp/sparse_solver_cg.oo
//
// Logline: Fail-closed emit+gcc+run asserts cg_solver_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/sparse_solver_cg.oo.
//
// Beats:
//   1. Call cg_solver_config_default using the sparse_solver_cg ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_sparse_solver_cg: PASSED only if asserts hold.

import "std/scicomp/sparse_solver_cg.oo";

pub fn main() {
    let obj = cg_solver_config_default();
    let sparse_solver_cg_a = obj.max_iters;
    if sparse_solver_cg_a != 1000 {
        println("FAIL cg_solver_config_default");
        process_exit(1);
    }
    println("prod_sparse_solver_cg: PASSED");
}
