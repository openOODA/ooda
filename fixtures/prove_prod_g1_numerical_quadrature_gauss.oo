// # Product prove std/scicomp/numerical_quadrature_gauss.oo
//
// Logline: Fail-closed emit+gcc+run asserts gauss_legendre_3_rule is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/numerical_quadrature_gauss.oo.
//
// Beats:
//   1. Call gauss_legendre_3_rule twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_numerical_quadrature_gauss: PASSED only if they match.

import "std/scicomp/numerical_quadrature_gauss.oo";

pub fn main() {
    let a: GaussLegendreRule = gauss_legendre_3_rule();
    let b: GaussLegendreRule = gauss_legendre_3_rule();
    if a.order != b.order {
        println("FAIL gauss_legendre_3_rule");
        process_exit(1);
    }
    println("prod_numerical_quadrature_gauss: PASSED");
}
