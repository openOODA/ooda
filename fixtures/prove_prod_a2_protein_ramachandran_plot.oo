// # Product prove std/bio_advanced/protein_ramachandran_plot.oo
//
// Logline: Fail-closed emit+gcc+run asserts rama_region_favored_alpha is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_ramachandran_plot.oo.
//
// Beats:
//   1. Call rama_region_favored_alpha twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_ramachandran_plot: PASSED only if they match.

import "std/bio_advanced/protein_ramachandran_plot.oo";

pub fn main() {
    let protein_ramachandran_plot_mark: Int = 0;
    if protein_ramachandran_plot_mark != 0 {
        process_exit(1);
    }
    let a: RamachandranRegion = rama_region_favored_alpha();
    let b: RamachandranRegion = rama_region_favored_alpha();
    if (a).is_favored != (b).is_favored {
        println("FAIL rama_region_favored_alpha");
        process_exit(1);
    }
    println("prod_protein_ramachandran_plot: PASSED");
}
