// # C emit list-ref, as, and &mut field prove
//
// Logline: Fail-closed emit+gcc+run of &List[Int] list_len, List[Bool], as Float, nested List field, untyped struct let, and &mut (p).inner.
//
// Setup: Isolated c1 after list-ref / Bool / as / AMP-postfix emit fixes.
//
// Beats:
//   1. list_len/get on &List[Int] is OoIList, not List*.
//   2. List[Bool] is OoIList; `as Float` is a C cast; List[List[Int]] field is OoLL_I.
//   3. Untyped let of a struct return and &mut (o).inner compile and run.

type Node = struct {
    n: Int,
};

type Outer = struct {
    inner: Node,
};

type Wrap = struct {
    xs: List[List[Int]],
};

pub fn first_i(values: &List[Int]) -> Int {
    let n: Int = list_len(values);
    if n == 0 {
        return 0;
    }
    return list_get(values, 0);
}

pub fn set_n(it: &mut Node, v: Int) {
    (it).n = v;
}

pub fn set_outer(o: &mut Outer, v: Int) {
    set_n(&mut (o).inner, v);
}

pub fn mk_node() -> Node {
    return Node { n: 4 };
}

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 7);
    let a: Int = first_i(&xs);
    if a != 7 {
        println("FAIL list_ref");
        process_exit(1);
    }

    let mut u: List[Bool] = list_new();
    u = list_push(u, false);
    u = list_push(u, true);
    if list_len(u) != 2 {
        println("FAIL bools len");
        process_exit(1);
    }
    if !list_get(u, 1) {
        println("FAIL bools get");
        process_exit(1);
    }

    let f: Float = 2 as Float;
    if f < 1.5 {
        println("FAIL as lo");
        process_exit(1);
    }
    if f > 2.5 {
        println("FAIL as hi");
        process_exit(1);
    }

    let mut inner: List[Int] = list_new();
    inner = list_push(inner, 3);
    let mut nest: List[List[Int]] = list_new();
    nest = list_push(nest, inner);
    let w: Wrap = Wrap { xs: nest };
    let got: List[Int] = list_get((w).xs, 0);
    if list_get(got, 0) != 3 {
        println("FAIL nest");
        process_exit(1);
    }

    let it = mk_node();
    if (it).n != 4 {
        println("FAIL untyped");
        process_exit(1);
    }

    let mut o: Outer = Outer { inner: Node { n: 1 } };
    set_outer(&mut o, 9);
    if (o).inner.n != 9 {
        println("FAIL fieldptr");
        process_exit(1);
    }

    println("prod_list_ref: PASSED");
}
