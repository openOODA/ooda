// # Product prove std/scicomp/eigen_values_qr.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/eigen_values_qr.oo.
//
// Beats:
//   1. Call math_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eigen_values_qr: PASSED only if they match.

import "std/scicomp/eigen_values_qr.oo";

pub fn main() {
    let eigen_values_qr_mark: Int = 0;
    if eigen_values_qr_mark != 0 {
        process_exit(1);
    }
    let eigen_values_qr_a: Float = math_sqrt(1.0);
    let eigen_values_qr_b: Float = math_sqrt(1.0);
    if eigen_values_qr_a != eigen_values_qr_b {
        println("FAIL math_sqrt");
        process_exit(1);
    }
    println("prod_eigen_values_qr: PASSED");
}
