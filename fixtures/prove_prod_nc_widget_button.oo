// # Product prove std/tui/widget_button.oo
//
// Logline: Fail-closed emit+gcc+run asserts widget_button_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/tui/widget_button.oo.
//
// Beats:
//   1. Call widget_button_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_widget_button: PASSED only if it matches.

import "std/tui/widget_button.oo";

pub fn main() {
    let a: Int = widget_button_probe();
    if a != 0 {
        println("FAIL widget_button_probe");
        process_exit(1);
    }
    println("prod_nc_widget_button: PASSED");
}
