// # Product prove std/crispr_cas/atac_seq_chromatin_open.oo
//
// Logline: Fail-closed emit+gcc+run asserts atac_intersects is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/atac_seq_chromatin_open.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call atac_intersects twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_atac_seq_chromatin_open: PASSED only if they match.

import "std/crispr_cas/atac_seq_chromatin_open.oo";

pub fn main() {
    let g0_a = atac_intersects(2, 2, 2);
    let g0_b = atac_intersects(2, 2, 2);
    if g0_a != g0_b {
        println("FAIL atac_intersects");
        process_exit(1);
    }
    println("prod_g0_atac_seq_chromatin_open: PASSED");
}
