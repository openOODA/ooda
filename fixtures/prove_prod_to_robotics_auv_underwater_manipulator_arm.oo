// # Product prove std/robotics_auv/underwater_manipulator_arm.oo
//
// Logline: Fail-closed emit+gcc+run asserts manipulator_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/underwater_manipulator_arm.oo.
//
// Beats:
//   1. Call manipulator_config_default using the underwater_manipulator_arm ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_underwater_manipulator_arm: PASSED only if asserts hold.

import "std/robotics_auv/underwater_manipulator_arm.oo";

pub fn main() {
    let obj = manipulator_config_default();
    let underwater_manipulator_arm_a = obj.link1_length_m;
    if underwater_manipulator_arm_a != 0.35 {
        println("FAIL manipulator_config_default");
        process_exit(1);
    }
    println("prod_underwater_manipulator_arm: PASSED");
}
