// # Product prove std/protein_folding/md_pme_electrostatics_mesh.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/protein_folding/md_pme_electrostatics_mesh.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_pme_electrostatics_mesh.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_md_pme_electrostatics_mesh: PASSED only if they match.

import "std/protein_folding/md_pme_electrostatics_mesh.oo";

pub fn main() {
    let md_pme_electrostatics_mesh_a = pme_calc_self_energy(0.0, 0.0);
    let md_pme_electrostatics_mesh_b = pme_calc_self_energy(0.0, 0.0);
    if md_pme_electrostatics_mesh_a != md_pme_electrostatics_mesh_b {
        println("FAIL md_pme_electrostatics_mesh");
        process_exit(1);
    }
    println("prod_ap_md_pme_electrostatics_mesh: PASSED");
}
