// # Unannotated Some still needs both match arms
//
// Logline: let x = Some(1) then match only _ must fail check.
//
// Setup: OPEN-17. RHS Some sets the Option floor.
//
// Beats:
//   1. Bind Some without a type annotation.
//   2. Match only underscore.
//   3. Check refuses.

pub fn main() {
    let x = Some(1);
    let y = match x {
        _ => 0,
    };
    println(y);
}