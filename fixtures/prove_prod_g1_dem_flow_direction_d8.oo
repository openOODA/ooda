// # Product prove std/gis_topo/dem_flow_direction_d8.oo
//
// Logline: Fail-closed emit+gcc+run asserts d8_code_east is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_flow_direction_d8.oo.
//
// Beats:
//   1. Call d8_code_east twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dem_flow_direction_d8: PASSED only if they match.

import "std/gis_topo/dem_flow_direction_d8.oo";

pub fn main() {
    let a: Int = d8_code_east();
    let b: Int = d8_code_east();
    if a != b {
        println("FAIL d8_code_east");
        process_exit(1);
    }
    println("prod_dem_flow_direction_d8: PASSED");
}
