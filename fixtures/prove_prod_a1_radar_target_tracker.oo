// # Product prove std/auto_robot/radar_target_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts radar_range_sq is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/radar_target_tracker.oo.
//
// Beats:
//   1. Call radar_range_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_radar_target_tracker: PASSED only if they match.

import "std/auto_robot/radar_target_tracker.oo";

pub fn main() {
    let radar_target_tracker_mark: Int = 0;
    if radar_target_tracker_mark != 0 {
        process_exit(1);
    }
    let a: Int = radar_range_sq(0, 0);
    let b: Int = radar_range_sq(0, 0);
    if a != b {
        println("FAIL radar_range_sq");
        process_exit(1);
    }
    println("prod_radar_target_tracker: PASSED");
}
