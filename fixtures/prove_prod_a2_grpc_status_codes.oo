// # Product prove std/cloud_k8s/grpc_status_codes.oo
//
// Logline: Fail-closed emit+gcc+run asserts grpc_status_to_http is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/grpc_status_codes.oo.
//
// Beats:
//   1. Call grpc_status_to_http twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_grpc_status_codes: PASSED only if they match.

import "std/cloud_k8s/grpc_status_codes.oo";

pub fn main() {
    let grpc_status_codes_mark: Int = 0;
    if grpc_status_codes_mark != 0 {
        process_exit(1);
    }
    let a: Int = grpc_status_to_http(0);
    let b: Int = grpc_status_to_http(0);
    if a != b {
        println("FAIL grpc_status_to_http");
        process_exit(1);
    }
    println("prod_grpc_status_codes: PASSED");
}
