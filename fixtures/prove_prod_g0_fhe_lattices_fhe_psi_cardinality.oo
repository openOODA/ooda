// # Product prove std/fhe_lattices/fhe_psi_cardinality.oo
//
// Logline: Fail-closed emit+gcc+run asserts psi_is_zero_result is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_psi_cardinality.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call psi_is_zero_result twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_psi_cardinality: PASSED only if they match.

import "std/fhe_lattices/fhe_psi_cardinality.oo";

pub fn main() {
    let g0_a = psi_is_zero_result(2);
    let g0_b = psi_is_zero_result(2);
    if g0_a != g0_b {
        println("FAIL psi_is_zero_result");
        process_exit(1);
    }
    println("prod_g0_fhe_psi_cardinality: PASSED");
}
