// # Product prove std/space_propulsion/mars_aerocapture_corridor.oo
//
// Logline: Fail-closed emit+gcc+run asserts mars_aerocapture_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/mars_aerocapture_corridor.oo.
//
// Beats:
//   1. Call mars_aerocapture_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mars_aerocapture_corridor: PASSED only if they match.

import "std/space_propulsion/mars_aerocapture_corridor.oo";

pub fn main() {
    let mars_aerocapture_corridor_mark: Int = 0;
    if mars_aerocapture_corridor_mark != 0 {
        process_exit(1);
    }
    let a: MarsAerocaptureSpec = mars_aerocapture_spec_default();
    let b: MarsAerocaptureSpec = mars_aerocapture_spec_default();
    if (a).entry_velocity_m_s != (b).entry_velocity_m_s {
        println("FAIL mars_aerocapture_spec_default");
        process_exit(1);
    }
    println("prod_g2_mars_aerocapture_corridor: PASSED");
}
