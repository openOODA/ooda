// # Product prove std/pbr_raytracing/brdf_dielectric_specular.oo
//
// Logline: Fail-closed emit+gcc+run asserts brdf_dielectric_specular_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_dielectric_specular.oo.
//
// Beats:
//   1. Call brdf_dielectric_specular_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_brdf_dielectric_specular: PASSED only if they match.

import "std/pbr_raytracing/brdf_dielectric_specular.oo";

pub fn main() {
    let a: Int = brdf_dielectric_specular_probe();
    let b: Int = brdf_dielectric_specular_probe();
    if a != b {
        println("FAIL brdf_dielectric_specular_probe");
        process_exit(1);
    }
    println("prod_g2_brdf_dielectric_specular: PASSED");
}
