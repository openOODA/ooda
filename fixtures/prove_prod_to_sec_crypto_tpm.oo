// # Product prove std/sec/crypto/tpm.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_tpm_checksum holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tpm.oo.
//
// Beats:
//   1. Call shim_marker_tpm_checksum using the tpm ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_tpm: PASSED only if asserts hold.

import "std/sec/crypto/tpm.oo";

pub fn main() {
    let tpm_a = shim_marker_tpm_checksum();
    let tpm_b = shim_marker_tpm_checksum();
    if tpm_a != tpm_b {
        println("FAIL shim_marker_tpm_checksum");
        process_exit(1);
    }
    println("prod_tpm: PASSED");
}
