// # Product prove std/enterprise/etl.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/enterprise/etl.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/etl.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_etl: PASSED only if they match.

import "std/enterprise/etl.oo";

pub fn main() {
    let etl_a = etl_stream_raw_pointer_buffer(0, 0);
    let etl_b = etl_stream_raw_pointer_buffer(0, 0);
    if etl_a != etl_b {
        println("FAIL etl");
        process_exit(1);
    }
    println("prod_ap_etl: PASSED");
}
