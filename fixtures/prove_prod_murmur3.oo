// # Product hash Murmur3 x86 32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/murmur3.oo.
//
// Setup: Product std/hash/murmur3.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty is 0.
//   2. a is 1009084850.
//   3. foo is 4138058784.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/murmur3.oo";

pub fn main() {
    let e: Int = murmur3_32("");
    if e != 0 {
        println("FAIL murmur empty");
        process_exit(1);
    }
    let a: Int = murmur3_32("a");
    if a != 1009084850 {
        println("FAIL murmur a");
        process_exit(1);
    }
    let foo: Int = murmur3_32("foo");
    if foo != 4138058784 {
        println("FAIL murmur foo");
        process_exit(1);
    }
    println("prod_murmur3: PASSED");
}
