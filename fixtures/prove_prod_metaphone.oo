// # Product metaphone prove
//
// Logline: Fail-closed emit+gcc+run of shipped metaphone_encode.
//
// Setup: Product std/text/metaphone.oo. PH->F, TH->0, interior vowels dropped.
//
// Beats:
//   1. Philip encodes to FLP.
//   2. Smith encodes to SM0.
//   3. Exit 1 before PASSED on a miss.

import "std/text/metaphone.oo";

pub fn main() {
    let p: String = metaphone_encode("Philip");
    if p != "FLP" {
        println("FAIL metaphone Philip");
        process_exit(1);
    }
    let s: String = metaphone_encode("Smith");
    if s != "SM0" {
        println("FAIL metaphone Smith");
        process_exit(1);
    }
    println("prod_metaphone: PASSED");
}
