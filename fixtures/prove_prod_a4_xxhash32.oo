// # Product prove std/perf/xxhash32.oo
//
// Logline: Fail-closed emit+gcc+run asserts xxhash32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/xxhash32.oo.
//
// Beats:
//   1. Call xxhash32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xxhash32: PASSED only if they match.

import "std/perf/xxhash32.oo";

pub fn main() {
    let a: Int = xxhash32("x");
    let b: Int = xxhash32("x");
    if a != b {
        println("FAIL xxhash32");
        process_exit(1);
    }
    println("prod_xxhash32: PASSED");
}
