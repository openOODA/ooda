// # Product prove std/media_dsp/midi_file_smf_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts midi_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/midi_file_smf_parser.oo.
//
// Beats:
//   1. Call midi_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_midi_file_smf_parser: PASSED only if they match.

import "std/media_dsp/midi_file_smf_parser.oo";

pub fn main() {
    let midi_file_smf_parser_mark: Int = 0;
    if midi_file_smf_parser_mark != 0 {
        process_exit(1);
    }
    let midi_file_smf_parser_a = midi_header_new(1, 1, 1);
    let midi_file_smf_parser_b = midi_header_new(1, 1, 1);
    if (midi_file_smf_parser_a).format_type != (midi_file_smf_parser_b).format_type {
        println("FAIL midi_header_new");
        process_exit(1);
    }
    println("prod_midi_file_smf_parser: PASSED");
}
