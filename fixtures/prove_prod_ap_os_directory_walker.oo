// # Product prove std/os/directory_walker.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/directory_walker.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/directory_walker.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_directory_walker: PASSED only if they match.

import "std/os/directory_walker.oo";

pub fn main() {
    let directory_walker_a = dir_walker_new("x", 0);
    let directory_walker_b = dir_walker_new("x", 0);
    let directory_walker_va = dir_walker_has_pending(directory_walker_a);
    let directory_walker_vb = dir_walker_has_pending(directory_walker_b);
    if directory_walker_va != directory_walker_vb {
        println("FAIL directory_walker");
        process_exit(1);
    }
    println("prod_ap_directory_walker: PASSED");
}
