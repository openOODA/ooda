// # if x >= 1 is leftover
//
// Logline: IDENT GTE INT must fail closed and not emit YES.
//
// Setup: x is a bind, not a const INT cond prefix. Sibling of locked INT>=INT.
//
// Beats:
//   1. Bind x to 2.
//   2. if x >= 1 print YES.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = 2;
    if x >= 1 {
        println("YES");
    }
}
