// # Product prove std/pbr_raytracing/kdtree_spatial_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts kdtree_node_leaf is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/kdtree_spatial_builder.oo.
//
// Beats:
//   1. Call kdtree_node_leaf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kdtree_spatial_builder: PASSED only if they match.

import "std/pbr_raytracing/kdtree_spatial_builder.oo";

pub fn main() {
    let kdtree_spatial_builder_mark: Int = 0;
    if kdtree_spatial_builder_mark != 0 {
        process_exit(1);
    }
    let a: KdTreeNode = kdtree_node_leaf(0, 1);
    let b: KdTreeNode = kdtree_node_leaf(0, 1);
    if (a).primitive_count != (b).primitive_count {
        println("FAIL kdtree_node_leaf");
        process_exit(1);
    }
    println("prod_kdtree_spatial_builder: PASSED");
}
