// # Product prove std/compilers_polyhedral/polyhedral_lexicographic_opt.oo
//
// Logline: Fail-closed emit+gcc+run asserts lexicographic_compare_vectors is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_lexicographic_opt.oo.
//
// Beats:
//   1. Call lexicographic_compare_vectors twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_lexicographic_opt: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_lexicographic_opt.oo";

pub fn main() {
    let polyhedral_lexicographic_opt_mark: Int = 0;
    if polyhedral_lexicographic_opt_mark != 0 {
        process_exit(1);
    }
    let a: Int = lexicographic_compare_vectors(0, 0, 0, 0, 0, 0, 0, 0);
    let b: Int = lexicographic_compare_vectors(0, 0, 0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL lexicographic_compare_vectors");
        process_exit(1);
    }
    println("prod_polyhedral_lexicographic_opt: PASSED");
}
