// # Product prove std/game_engine/game_loop.oo
//
// Logline: Fail-closed emit+gcc+run asserts game_loop_new real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/game_loop.oo.
//
// Beats:
//   1. Call game_loop_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_game_loop: PASSED only if the assert holds.

import "std/game_engine/game_loop.oo";

pub fn main() {
    let game_loop_a: GameLoopState = game_loop_new(2.0, 2.0);
    let game_loop_frame_count: Int = (game_loop_a).frame_count;
    if game_loop_frame_count != 0 {
        println("FAIL game_loop_new");
        process_exit(1);
    }
    println("prod_game_loop: PASSED");
}
