// # Product prove std/auto/fusion_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts fus_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_engine.oo.
//
// Beats:
//   1. Call fus_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fusion_engine: PASSED only if they match.

import "std/auto/fusion_engine.oo";

pub fn main() {
    let fusion_engine_mark: Int = 0;
    if fusion_engine_mark != 0 {
        process_exit(1);
    }
    let a: FusEng = fus_eng_new(0, 0);
    let b: FusEng = fus_eng_new(0, 0);
    if (a).active != (b).active {
        println("FAIL fus_eng_new");
        process_exit(1);
    }
    println("prod_fusion_engine: PASSED");
}
