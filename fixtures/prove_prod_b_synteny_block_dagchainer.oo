// # Product prove std/genomics_advanced/synteny_block_dagchainer.oo
//
// Logline: Fail-closed emit+gcc+run asserts synteny_block_dagchainer_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/synteny_block_dagchainer.oo.
//
// Beats:
//   1. Call synteny_block_dagchainer_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_synteny_block_dagchainer: PASSED only if they match.

import "std/genomics_advanced/synteny_block_dagchainer.oo";

pub fn main() {
    let a = synteny_block_dagchainer_probe();
    let b = synteny_block_dagchainer_probe();
    if a != b {
        println("FAIL synteny_block_dagchainer_probe");
        process_exit(1);
    }
    println("prod_synteny_block_dagchainer: PASSED");
}
