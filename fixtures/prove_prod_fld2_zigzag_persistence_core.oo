// # Product prove std/tda_topology/zigzag_persistence_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts zigzag_step_remove is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/zigzag_persistence_core.oo.
//
// Beats:
//   1. Call zigzag_step_remove twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zigzag_persistence_core: PASSED only if they match.

import "std/tda_topology/zigzag_persistence_core.oo";

pub fn main() {
    let zigzag_persistence_core_mark: Int = 0;
    if zigzag_persistence_core_mark != 0 {
        process_exit(1);
    }
    let zigzag_persistence_core_a = zigzag_step_remove(1, 1);
    let zigzag_persistence_core_b = zigzag_step_remove(1, 1);
    if (zigzag_persistence_core_a).step_index != (zigzag_persistence_core_b).step_index {
        println("FAIL zigzag_step_remove");
        process_exit(1);
    }
    println("prod_zigzag_persistence_core: PASSED");
}
