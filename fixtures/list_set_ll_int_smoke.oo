// # list_set List[List[Int]] emit lock
//
// Logline: Fail-closed emit+gcc+run of nested list_set replacing index 0.
//
// Setup: Backend-C. list_set on List[List[Int]] returns the updated nest.
//
// Beats:
//   1. Push an inner list holding 1.
//   2. list_set index 0 to an inner list holding 8; nested get is 8.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let mut inner: List[Int] = list_new();
    inner = list_push(inner, 1);
    let mut xs: List[List[Int]] = list_new();
    xs = list_push(xs, inner);
    let mut inner2: List[Int] = list_new();
    inner2 = list_push(inner2, 8);
    xs = list_set(xs, 0, inner2);
    if list_get(list_get(xs, 0), 0) != 8 {
        println("FAIL");
        process_exit(1);
    }
    println("list_set_ll_int_smoke: PASSED");
}
