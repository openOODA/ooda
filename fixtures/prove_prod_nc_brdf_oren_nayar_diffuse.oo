// # Product prove std/pbr_raytracing/brdf_oren_nayar_diffuse.oo
//
// Logline: Fail-closed emit+gcc+run asserts brdf_oren_nayar_diffuse_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_oren_nayar_diffuse.oo.
//
// Beats:
//   1. Call brdf_oren_nayar_diffuse_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_brdf_oren_nayar_diffuse: PASSED only if it matches.

import "std/pbr_raytracing/brdf_oren_nayar_diffuse.oo";

pub fn main() {
    let a: Int = brdf_oren_nayar_diffuse_probe();
    if a != 0 {
        println("FAIL brdf_oren_nayar_diffuse_probe");
        process_exit(1);
    }
    println("prod_nc_brdf_oren_nayar_diffuse: PASSED");
}
