// # Product prove std/fintech_defi/amm_curve_stableswap.oo
//
// Logline: Fail-closed emit+gcc+run asserts stableswap_get_d is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_curve_stableswap.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call stableswap_get_d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_amm_curve_stableswap: PASSED only if they match.

import "std/fintech_defi/amm_curve_stableswap.oo";

pub fn main() {
    let g0_a = stableswap_get_d(2, 2, 2);
    let g0_b = stableswap_get_d(2, 2, 2);
    if g0_a != g0_b {
        println("FAIL stableswap_get_d");
        process_exit(1);
    }
    println("prod_g0_amm_curve_stableswap: PASSED");
}
