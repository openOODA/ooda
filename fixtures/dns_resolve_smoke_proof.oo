// # DNS Host Resolution Proof Fixture
//
// Logline: Prove DNS hostname resolution and capability-bounded networking under NetCap.
//
// Setup: Exercises dns_resolve and dns_resolve_ipv4 under explicit NetCap capability tokens.
//
// Beats:
//   1. Resolve localhost to loopback IPv4 address ("127.0.0.1").
//   2. Resolve localhost strictly via IPv4 lookup.
//   3. Validate empty host lookup rejection.
//   4. Confirm happy path execution and print confirmation marker.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &NetCap required.
// RULES.oot 1.6: Prove happy path works and invalid inputs fail safely.
// RULES.oot 1.7: Under 256 lines.

import "std/net/dns.oo";

pub fn main(net: &NetCap) {
    // ---------------------------------------------------------------
    // Beat 1: Localhost resolution to 127.0.0.1
    // ---------------------------------------------------------------
    let res1: Result[String, String] = dns_resolve(net, "localhost");
    if res1.is_err() {
        println("FAIL: dns_resolve localhost failed");
        process_exit(1);
    }
    let ip1: String = match res1 {
        Ok(ip) => ip,
        Err(_) => ""
    };
    if ip1 != "127.0.0.1" {
        println("FAIL: dns_resolve localhost expected 127.0.0.1");
        process_exit(1);
    }

    // ---------------------------------------------------------------
    // Beat 2: Strict IPv4 resolution
    // ---------------------------------------------------------------
    let res2: Result[String, String] = dns_resolve_ipv4(net, "localhost");
    if res2.is_err() {
        println("FAIL: dns_resolve_ipv4 localhost failed");
        process_exit(1);
    }
    let ip2: String = match res2 {
        Ok(ip) => ip,
        Err(_) => ""
    };
    if ip2 != "127.0.0.1" {
        println("FAIL: dns_resolve_ipv4 localhost expected 127.0.0.1");
        process_exit(1);
    }

    // ---------------------------------------------------------------
    // Beat 3: Empty hostname rejection
    // ---------------------------------------------------------------
    let res_empty: Result[String, String] = dns_resolve(net, "");
    if res_empty.is_ok() {
        println("FAIL: empty hostname should be rejected");
        process_exit(1);
    }

    // ---------------------------------------------------------------
    // Beat 4: Success confirmation
    // ---------------------------------------------------------------
    println("OK: DNS_RESOLVE_SMOKE_PROOF_SUCCESS");
}
