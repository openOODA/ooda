// # Product prove std/synthetic_biology/ribozyme_cleavage_kinetics.oo
//
// Logline: Fail-closed emit+check asserts ribozyme_math_exp_neg is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/ribozyme_cleavage_kinetics.oo.
//
// Beats:
//   1. Call ribozyme_math_exp_neg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ribozyme_cleavage_kinetics: PASSED only if they match.

import "std/synthetic_biology/ribozyme_cleavage_kinetics.oo";

pub fn main() {
    let ribozyme_cleavage_kinetics_mark: Int = 0;
    if ribozyme_cleavage_kinetics_mark != 0 { process_exit(1); }
    let a: Float = ribozyme_math_exp_neg(2.0);
    let b: Float = ribozyme_math_exp_neg(2.0);
    if a != b { process_exit(1); }
    println("prod_ribozyme_cleavage_kinetics: PASSED");
}
