// # Product prove std/markup/xml_tokenizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/xml_tokenizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/xml_tokenizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_xml_tokenizer: PASSED only if they match.

import "std/markup/xml_tokenizer.oo";

pub fn main() {
    let xml_tokenizer_a = xml_escape("x");
    let xml_tokenizer_b = xml_escape("x");
    if xml_tokenizer_a.contains(xml_tokenizer_b) == false {
        println("FAIL xml_tokenizer");
        process_exit(1);
    }
    if xml_tokenizer_b.contains(xml_tokenizer_a) == false {
        println("FAIL xml_tokenizer");
        process_exit(1);
    }
    println("prod_ap_xml_tokenizer: PASSED");
}
