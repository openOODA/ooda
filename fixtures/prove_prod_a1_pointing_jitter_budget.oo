// # Product prove std/astro_advanced/pointing_jitter_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts jitter_urad is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/pointing_jitter_budget.oo.
//
// Beats:
//   1. Call jitter_urad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pointing_jitter_budget: PASSED only if they match.

import "std/astro_advanced/pointing_jitter_budget.oo";

pub fn main() {
    let pointing_jitter_budget_mark: Int = 0;
    if pointing_jitter_budget_mark != 0 {
        process_exit(1);
    }
    let a: Int = jitter_urad();
    let b: Int = jitter_urad();
    if a != b {
        println("FAIL jitter_urad");
        process_exit(1);
    }
    println("prod_pointing_jitter_budget: PASSED");
}
