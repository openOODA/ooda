// # Probe R-Tree 100
//
// Logline: Adversarial probe testing R-tree indexing with 100 items.
//
// Setup: Pure. Runs from ooda root.
//
// Beats:
//   1. Insert 100 non-overlapping boxes.
//   2. Query overlap for each inserted box.
//   3. Query nearest neighbor.
//   4. Verify returned IDs match expected IDs.

import "std/geometry/spatial_r_tree.oo";

pub fn main() {
    let mut t: List[Float] = spatial_r_tree_new();
    let mut i: Int = 0;
    let mut f: Float = 0.0;
    while i < 100 {
        let r: Result[List[Float], String] = spatial_r_tree_insert(t, f * 10.0, f * 10.0, f * 10.0 + 1.0, f * 10.0 + 1.0);
        match r {
            Ok(tree) => { t = tree; },
            Err(e) => {
                println("FAIL insert at i=" + i.to_string() + " err=" + e);
                process_exit(1);
            }
        }
        f = f + 1.0;
        i = i + 1;
    }
    println("Successfully inserted 100 boxes");

    // Check overlap on box 70 (x: 700.0 .. 701.0, y: 700.0 .. 701.0)
    let q: Result[Int, String] = spatial_r_tree_overlap(t, 700.2, 700.2, 700.8, 700.8);
    match q {
        Ok(id) => {
            println("Overlap for box 70 returned id: " + id.to_string());
            if id != 70 {
                println("ERROR: Expected id 70, got " + id.to_string());
            }
        },
        Err(e) => {
            println("FAIL overlap on box 70: " + e);
        }
    }

    // Check nearest on point (700.5, 700.5)
    let nn: Result[Int, String] = spatial_r_tree_nearest(t, 700.5, 700.5);
    match nn {
        Ok(id) => {
            println("Nearest for (700.5, 700.5) returned id: " + id.to_string());
            if id != 70 {
                println("ERROR: Expected nearest id 70, got " + id.to_string());
            }
        },
        Err(e) => {
            println("FAIL nearest: " + e);
        }
    }
}
