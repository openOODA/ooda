// # Product prove std/quantum_advanced/qasm3_instruction_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts schedule_asap is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/qasm3_instruction_scheduler.oo.
//
// Beats:
//   1. Call schedule_asap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qasm3_instruction_scheduler: PASSED only if they match.

import "std/quantum_advanced/qasm3_instruction_scheduler.oo";

pub fn main() {
    let qasm3_instruction_scheduler_mark: Int = 0;
    if qasm3_instruction_scheduler_mark != 0 {
        process_exit(1);
    }
    let a: ScheduleMode = schedule_asap();
    let b: ScheduleMode = schedule_asap();
    if (a).mode != (b).mode {
        println("FAIL schedule_asap");
        process_exit(1);
    }
    println("prod_qasm3_instruction_scheduler: PASSED");
}
