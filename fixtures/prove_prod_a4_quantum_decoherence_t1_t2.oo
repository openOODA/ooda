// # Product prove std/quantum_open_systems/quantum_decoherence_t1_t2.oo
//
// Logline: Fail-closed emit+gcc+run asserts decoherence_times_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_decoherence_t1_t2.oo.
//
// Beats:
//   1. Call decoherence_times_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_decoherence_t1_t2: PASSED only if they match.

import "std/quantum_open_systems/quantum_decoherence_t1_t2.oo";

pub fn main() {
    let quantum_decoherence_t1_t2_mark: Int = 0;
    if quantum_decoherence_t1_t2_mark != 0 {
        process_exit(1);
    }
    let a: DecoherenceTimescales = decoherence_times_new(0.0, 0.0);
    let b: DecoherenceTimescales = decoherence_times_new(0.0, 0.0);
    if (a).t1_relaxation_us != (b).t1_relaxation_us {
        println("FAIL decoherence_times_new");
        process_exit(1);
    }
    println("prod_quantum_decoherence_t1_t2: PASSED");
}
