// # Product prove std/robot/kinematics_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/robot/kinematics_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/kinematics_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kinematics_types: PASSED only if they match.

import "std/robot/kinematics_types.oo";

pub fn main() {
    let kinematics_types_a = kinematics_types_marker();
    let kinematics_types_b = kinematics_types_marker();
    if kinematics_types_a != kinematics_types_b {
        println("FAIL kinematics_types");
        process_exit(1);
    }
    println("prod_ap_kinematics_types: PASSED");
}
