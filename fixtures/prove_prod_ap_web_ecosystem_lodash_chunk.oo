// # Product prove std/web_ecosystem/lodash_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/lodash_chunk.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_chunk.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lodash_chunk: PASSED only if they match.

import "std/web_ecosystem/lodash_chunk.oo";

pub fn main() {
    let lodash_chunk_a = lodash_chunk_n(0, 0);
    let lodash_chunk_b = lodash_chunk_n(0, 0);
    if lodash_chunk_a != lodash_chunk_b {
        println("FAIL lodash_chunk");
        process_exit(1);
    }
    println("prod_ap_lodash_chunk: PASSED");
}
