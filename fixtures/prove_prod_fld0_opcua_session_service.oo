// # Product prove std/iot_scada/opcua_session_service.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_session_is_active is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_session_service.oo.
//
// Beats:
//   1. Call opcua_session_is_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opcua_session_service: PASSED only if they match.

import "std/iot_scada/opcua_session_service.oo";

pub fn main() {
    let opcua_session_service_mark: Int = 0;
    if opcua_session_service_mark != 0 {
        process_exit(1);
    }
    let opcua_session_service_obj: OpcUaSession = opcua_session_new(1, 1);
    let opcua_session_service_a: Bool = opcua_session_is_active(&opcua_session_service_obj);
    let opcua_session_service_b: Bool = opcua_session_is_active(&opcua_session_service_obj);
    if opcua_session_service_a != opcua_session_service_b {
        println("FAIL opcua_session_is_active");
        process_exit(1);
    }
    println("prod_opcua_session_service: PASSED");
}
