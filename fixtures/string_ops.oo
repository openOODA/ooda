// # Walk a string subset
//
// Logline: Print length, first char, contains, and a slice of hello.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Print hello length and first char.
//   2. Print 1 when it contains ell.
//   3. Print the slice from 1 to 4.
//
// String subset: len, char_at, contains, str_slice (interp + WASM).
pub fn main() {
    let s = "hello";
    println(s.len());
    println(s.char_at(0));
    if s.contains("ell") {
        println(1);
    } else {
        println(0);
    }
    println(s.str_slice(1, 4));
}
