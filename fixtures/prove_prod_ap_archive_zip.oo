// # Product prove std/archive/zip.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/zip.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zip.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zip: PASSED only if they match.

import "std/archive/zip.oo";

pub fn main() {
    let zip_a = zip_detect("x");
    let zip_b = zip_detect("x");
    if zip_a.is_ok() != zip_b.is_ok() {
        println("FAIL zip");
        process_exit(1);
    }
    println("prod_ap_zip: PASSED");
}
