// # Product prove std/physics/sph_fluid_viscosity.oo
//
// Logline: Fail-closed emit+gcc+run asserts sph_viscosity_laplacian_kernel is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/sph_fluid_viscosity.oo.
//
// Beats:
//   1. Call sph_viscosity_laplacian_kernel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sph_fluid_viscosity: PASSED only if they match.

import "std/physics/sph_fluid_viscosity.oo";

pub fn main() {
    let sph_fluid_viscosity_mark: Int = 0;
    if sph_fluid_viscosity_mark != 0 {
        process_exit(1);
    }
    let a: Float = sph_viscosity_laplacian_kernel(0.0, 0.0);
    let b: Float = sph_viscosity_laplacian_kernel(0.0, 0.0);
    if a != b {
        println("FAIL sph_viscosity_laplacian_kernel");
        process_exit(1);
    }
    println("prod_sph_fluid_viscosity: PASSED");
}
