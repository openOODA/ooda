// # Product prove std/auto_mpc_control/path_tracking_lqr_lateral.oo
//
// Logline: Fail-closed emit+gcc+run asserts lqr_lateral_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/path_tracking_lqr_lateral.oo.
//
// Beats:
//   1. Call lqr_lateral_gains_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_tracking_lqr_lateral: PASSED only if they match.

import "std/auto_mpc_control/path_tracking_lqr_lateral.oo";

pub fn main() {
    let a: LQRLateralGains = lqr_lateral_gains_default();
    let b: LQRLateralGains = lqr_lateral_gains_default();
    if a.k_ey != b.k_ey {
        println("FAIL lqr_lateral_gains_default");
        process_exit(1);
    }
    println("prod_path_tracking_lqr_lateral: PASSED");
}
