// # Product prove std/graph_networks/viceroy_dht_butterfly.oo
//
// Logline: Fail-closed emit+gcc+run asserts viceroy_dist is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/viceroy_dht_butterfly.oo.
//
// Beats:
//   1. Call viceroy_dist twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_viceroy_dht_butterfly: PASSED only if they match.

import "std/graph_networks/viceroy_dht_butterfly.oo";

pub fn main() {
    let viceroy_dht_butterfly_mark: Int = 0;
    if viceroy_dht_butterfly_mark != 0 {
        process_exit(1);
    }
    let a: Int = viceroy_dist(0, 0);
    let b: Int = viceroy_dist(0, 0);
    if a != b {
        println("FAIL viceroy_dist");
        process_exit(1);
    }
    println("prod_viceroy_dht_butterfly: PASSED");
}
