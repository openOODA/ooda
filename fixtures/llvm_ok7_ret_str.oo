// # String Result return refuses Int Ok
//
// Logline: emit-llvm fail-closes return Ok(7) from a Result[String] function.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. f returns Result[String].
//   2. Body returns Ok(7).
//   3. Emit must print ERR llvm_emit.

pub fn f() -> Result[String] {
    return Ok(7);
}

pub fn main() {
    let r: Result[String] = f();
    println(r.is_ok().to_string());
}
