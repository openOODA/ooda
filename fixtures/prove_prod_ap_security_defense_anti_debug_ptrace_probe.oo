// # Product prove std/security_defense/anti_debug_ptrace_probe.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/anti_debug_ptrace_probe.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/security_defense/anti_debug_ptrace_probe.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_anti_debug_ptrace_probe: PASSED only if they match.

import "std/security_defense/anti_debug_ptrace_probe.oo";

pub fn main() {
    let anti_debug_ptrace_probe_a = tracer_status_from_pid(0);
    let anti_debug_ptrace_probe_b = tracer_status_from_pid(0);
    if anti_debug_ptrace_probe_a.tracer_pid != anti_debug_ptrace_probe_b.tracer_pid {
        println("FAIL anti_debug_ptrace_probe");
        process_exit(1);
    }
    println("prod_ap_anti_debug_ptrace_probe: PASSED");
}
