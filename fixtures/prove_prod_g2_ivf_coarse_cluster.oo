// # Product prove std/db_vector_ann/ivf_coarse_cluster.oo
//
// Logline: Fail-closed emit+gcc+run asserts ivf_cluster_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/ivf_coarse_cluster.oo.
//
// Beats:
//   1. Call ivf_cluster_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ivf_coarse_cluster: PASSED only if they match.

import "std/db_vector_ann/ivf_coarse_cluster.oo";

pub fn main() {
    let ivf_coarse_cluster_mark: Int = 0;
    if ivf_coarse_cluster_mark != 0 {
        process_exit(1);
    }
    let a: IvfClusterConfig = ivf_cluster_config_default(0, 0);
    let b: IvfClusterConfig = ivf_cluster_config_default(0, 0);
    if (a).num_centroids_k != (b).num_centroids_k {
        println("FAIL ivf_cluster_config_default");
        process_exit(1);
    }
    println("prod_g2_ivf_coarse_cluster: PASSED");
}
