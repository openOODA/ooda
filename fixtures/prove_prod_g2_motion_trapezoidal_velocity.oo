// # Product prove std/robotics_ros2/motion_trapezoidal_velocity.oo
//
// Logline: Fail-closed emit+gcc+run asserts trapezoidal_profile_plan is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_trapezoidal_velocity.oo.
//
// Beats:
//   1. Call trapezoidal_profile_plan twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_motion_trapezoidal_velocity: PASSED only if they match.

import "std/robotics_ros2/motion_trapezoidal_velocity.oo";

pub fn main() {
    let motion_trapezoidal_velocity_mark: Int = 0;
    if motion_trapezoidal_velocity_mark != 0 {
        process_exit(1);
    }
    let a: TrapezoidalProfile = trapezoidal_profile_plan(0.0, 0.0, 0.0, 0.0);
    let b: TrapezoidalProfile = trapezoidal_profile_plan(0.0, 0.0, 0.0, 0.0);
    if (a).q0 != (b).q0 {
        println("FAIL trapezoidal_profile_plan");
        process_exit(1);
    }
    println("prod_g2_motion_trapezoidal_velocity: PASSED");
}
