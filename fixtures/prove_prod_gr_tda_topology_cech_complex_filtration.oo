// # Product prove std/tda_topology/cech_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts cech_radius_1d is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/cech_complex_filtration.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call cech_radius_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_cech_complex_filtration: PASSED only if they match.

import "std/tda_topology/cech_complex_filtration.oo";

pub fn main() {
    let g0_a = cech_radius_1d(0.0);
    let g0_b = cech_radius_1d(0.0);
    if g0_a != g0_b {
        println("FAIL cech_radius_1d");
        process_exit(1);
    }
    println("prod_gr_cech_complex_filtration: PASSED");
}
