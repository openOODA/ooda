// # Product prove std/iot_scada/plc_ladder_rung_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/plc_ladder_rung_eval.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/plc_ladder_rung_eval.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plc_ladder_rung_eval: PASSED only if they match.

import "std/iot_scada/plc_ladder_rung_eval.oo";

pub fn main() {
    let plc_ladder_rung_eval_a = plc_eval_contact_no(true, true);
    let plc_ladder_rung_eval_b = plc_eval_contact_no(true, true);
    if plc_ladder_rung_eval_a != plc_ladder_rung_eval_b {
        println("FAIL plc_ladder_rung_eval");
        process_exit(1);
    }
    println("prod_ap_plc_ladder_rung_eval: PASSED");
}
