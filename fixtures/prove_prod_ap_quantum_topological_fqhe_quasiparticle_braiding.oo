// # Product prove std/quantum_topological/fqhe_quasiparticle_braiding.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_topological/fqhe_quasiparticle_braiding.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_quasiparticle_braiding.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fqhe_quasiparticle_braiding: PASSED only if they match.

import "std/quantum_topological/fqhe_quasiparticle_braiding.oo";

pub fn main() {
    let fqhe_quasiparticle_braiding_a = int_to_float(0);
    let fqhe_quasiparticle_braiding_b = int_to_float(0);
    if fqhe_quasiparticle_braiding_a != fqhe_quasiparticle_braiding_b {
        println("FAIL fqhe_quasiparticle_braiding");
        process_exit(1);
    }
    println("prod_ap_fqhe_quasiparticle_braiding: PASSED");
}
