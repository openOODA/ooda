// # Product prove std/neuro_bci/neuron_izhikevich_spiking.oo
//
// Logline: Fail-closed emit+gcc+run asserts izhikevich_params_regular_spiking is a real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neuron_izhikevich_spiking.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call izhikevich_params_regular_spiking twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_neuron_izhikevich_spiking: PASSED only if they match.

import "std/neuro_bci/neuron_izhikevich_spiking.oo";

pub fn main() {
    let g2_oa: IzhikevichParams = izhikevich_params_regular_spiking();
    let g2_ob: IzhikevichParams = izhikevich_params_regular_spiking();
    let g2_a = (g2_oa).a;
    let g2_b = (g2_ob).a;
    if g2_a != g2_b {
        println("FAIL izhikevich_params_regular_spiking.a");
        process_exit(1);
    }
    println("prod_g2_neuron_izhikevich_spiking: PASSED");
}
