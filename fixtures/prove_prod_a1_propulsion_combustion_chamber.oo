// # Product prove std/astro_advanced/propulsion_combustion_chamber.oo
//
// Logline: Fail-closed emit+gcc+run asserts chamber_pc_bar is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/propulsion_combustion_chamber.oo.
//
// Beats:
//   1. Call chamber_pc_bar twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propulsion_combustion_chamber: PASSED only if they match.

import "std/astro_advanced/propulsion_combustion_chamber.oo";

pub fn main() {
    let propulsion_combustion_chamber_mark: Int = 0;
    if propulsion_combustion_chamber_mark != 0 {
        process_exit(1);
    }
    let a: Int = chamber_pc_bar();
    let b: Int = chamber_pc_bar();
    if a != b {
        println("FAIL chamber_pc_bar");
        process_exit(1);
    }
    println("prod_propulsion_combustion_chamber: PASSED");
}
