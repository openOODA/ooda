// # Product Prove std/security_defense/register_allocator_randomizer.oo
//
// Logline: Deterministic assertion fixture verifying randomized register allocation mapping and entropy.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/register_allocator_randomizer.oo.
//
// Beats:
//   1. Create RandomRegContext with seed 777.
//   2. Allocate physical registers for virtual registers 0, 1, 2.
//   3. Assert allocated register IDs and allocation counts.
//   4. Print "prod_register_allocator_randomizer: PASSED".

import "std/security_defense/register_allocator_randomizer.oo";

pub fn main() {
    let mut ctx: RandomRegContext = random_reg_context_new(777);

    if (ctx).reg_count != 8 {
        println("FAIL: reg_count mismatch");
        process_exit(1);
    }

    let p0: Int = random_reg_allocate_vreg(&mut ctx, 0);
    let p1: Int = random_reg_allocate_vreg(&mut ctx, 1);
    let p2: Int = random_reg_allocate_vreg(&mut ctx, 2);

    if (ctx).alloc_count != 3 {
        println("FAIL: alloc_count mismatch");
        process_exit(1);
    }

    // With seed 777:
    // vreg 0: (777 + 0)%8 = 1 -> reg_id 1
    // vreg 1: (777 + 7)%8 = 0 -> reg_id 0
    // vreg 2: (777 + 14)%8 = 7 -> reg_id 7
    if p0 != 1 || p1 != 0 || p2 != 7 {
        println("FAIL: allocation mapping mismatch");
        process_exit(1);
    }

    println("prod_register_allocator_randomizer: PASSED");
    process_exit(0);
}
