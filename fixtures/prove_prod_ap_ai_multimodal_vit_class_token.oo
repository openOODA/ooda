// # Product prove std/ai_multimodal/vit_class_token.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/vit_class_token.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_class_token.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vit_class_token: PASSED only if they match.

import "std/ai_multimodal/vit_class_token.oo";

pub fn main() {
    let vit_class_token_a = vit_class_token_config_new(0, 0, 0);
    let vit_class_token_b = vit_class_token_config_new(0, 0, 0);
    let vit_class_token_va = vit_n_tok(vit_class_token_a, 0);
    let vit_class_token_vb = vit_n_tok(vit_class_token_b, 0);
    if vit_class_token_va != vit_class_token_vb {
        println("FAIL vit_class_token");
        process_exit(1);
    }
    println("prod_ap_vit_class_token: PASSED");
}
