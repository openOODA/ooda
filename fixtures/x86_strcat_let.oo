// # emit-x86 let-bound two-string concat
//
// Logline: Bind s to aa plus bb and print s so emit-x86 can lower a same-fn string-let concat.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind s to aa plus bb.
//   3. Print s.
//
// residual: greet calls stay later.

pub fn main() {
    let s = "aa" + "bb";
    println(s);
}
