// # Product prove std/web_ecosystem/event_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts event_emitter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/event_emitter.oo.
//
// Beats:
//   1. Call event_emitter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_event_emitter: PASSED only if they match.

import "std/web_ecosystem/event_emitter.oo";

pub fn main() {
    let a: EventEmitter = event_emitter_new();
    let b: EventEmitter = event_emitter_new();
    if (a).e0 != (b).e0 {
        println("FAIL event_emitter_new");
        process_exit(1);
    }
    println("prod_event_emitter: PASSED");
}
