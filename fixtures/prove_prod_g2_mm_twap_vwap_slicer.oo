// # Product prove std/hft_alpha/mm_twap_vwap_slicer.oo
//
// Logline: Fail-closed emit+gcc+run asserts slicer_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_twap_vwap_slicer.oo.
//
// Beats:
//   1. Call slicer_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_twap_vwap_slicer: PASSED only if they match.

import "std/hft_alpha/mm_twap_vwap_slicer.oo";

pub fn main() {
    let mm_twap_vwap_slicer_mark: Int = 0;
    if mm_twap_vwap_slicer_mark != 0 {
        process_exit(1);
    }
    let a: ExecutionScheduleParams = slicer_params_new(0.0, 0.0, 0.0, 0.0);
    let b: ExecutionScheduleParams = slicer_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).total_order_size != (b).total_order_size {
        println("FAIL slicer_params_new");
        process_exit(1);
    }
    println("prod_g2_mm_twap_vwap_slicer: PASSED");
}
