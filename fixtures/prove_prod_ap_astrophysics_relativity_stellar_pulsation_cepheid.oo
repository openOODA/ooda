// # Product prove std/astrophysics_relativity/stellar_pulsation_cepheid.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/stellar_pulsation_cepheid.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_pulsation_cepheid.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stellar_pulsation_cepheid: PASSED only if they match.

import "std/astrophysics_relativity/stellar_pulsation_cepheid.oo";

pub fn main() {
    let stellar_pulsation_cepheid_a = stellar_dynamical_pulsation_period_s(0.0, 0.0);
    let stellar_pulsation_cepheid_b = stellar_dynamical_pulsation_period_s(0.0, 0.0);
    if stellar_pulsation_cepheid_a != stellar_pulsation_cepheid_b {
        println("FAIL stellar_pulsation_cepheid");
        process_exit(1);
    }
    println("prod_ap_stellar_pulsation_cepheid: PASSED");
}
