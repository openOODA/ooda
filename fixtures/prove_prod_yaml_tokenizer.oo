// # Product prove std/markup/yaml_tokenizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts yaml_is_scalar_char is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/yaml_tokenizer.oo.
//
// Beats:
//   1. Call yaml_is_scalar_char twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yaml_tokenizer: PASSED only if they match.

import "std/markup/yaml_tokenizer.oo";

pub fn main() {
    let a = yaml_is_scalar_char("x");
    let b = yaml_is_scalar_char("x");
    if a != b {
        println("FAIL yaml_is_scalar_char");
        process_exit(1);
    }
    println("prod_yaml_tokenizer: PASSED");
}
