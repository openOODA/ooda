// # Product prove std/graph_topology/scc_tarjan.oo
//
// Logline: Fail-closed emit+gcc+run asserts Tarjan's strongly connected components algorithm.
//
// Setup: Isolated emit-c. Imports std/graph_topology/scc_tarjan.oo.
//
// Beats:
//   1. Build directed strongly connected cycle and partition into SCCs.
//   2. Assert single component count and strong connectivity predicate.
//   3. Build directed acyclic graph and verify multi-component partitioning.
//   4. Print prod_g4_graph_scc_tarjan: PASSED on success.

import "std/graph_topology/scc_tarjan.oo";
import "std/graph_topology/graph_adjacency_list.oo";

pub fn main() {
    let mut g1: GraphAdjList = adj_list_create(true);
    adj_list_add_vertex(&mut g1, 0);
    adj_list_add_vertex(&mut g1, 1);
    adj_list_add_vertex(&mut g1, 2);
    adj_list_add_edge_directed(&mut g1, 0, 1, 1);
    adj_list_add_edge_directed(&mut g1, 1, 2, 1);
    adj_list_add_edge_directed(&mut g1, 2, 0, 1);

    let res1: TarjanSccResult = tarjan_scc_find(&g1, 3);
    let scc_cnt1: Int = (res1).scc_count;
    if scc_cnt1 != 1 {
        println("FAIL tarjan_scc_find scc_count cycle");
        process_exit(1);
    }

    let is_strong1: Bool = tarjan_is_strongly_connected(&res1);
    if is_strong1 == false {
        println("FAIL tarjan_is_strongly_connected cycle");
        process_exit(1);
    }

    let c0: Int = tarjan_get_component_id(&res1, 0);
    let c1: Int = tarjan_get_component_id(&res1, 1);
    let c2: Int = tarjan_get_component_id(&res1, 2);
    if c0 != c1 || c1 != c2 {
        println("FAIL tarjan component ids mismatch");
        process_exit(1);
    }

    let mut g2: GraphAdjList = adj_list_create(true);
    adj_list_add_vertex(&mut g2, 0);
    adj_list_add_vertex(&mut g2, 1);
    adj_list_add_edge_directed(&mut g2, 0, 1, 1);

    let res2: TarjanSccResult = tarjan_scc_find(&g2, 2);
    let scc_cnt2: Int = (res2).scc_count;
    if scc_cnt2 != 2 {
        println("FAIL tarjan_scc_find scc_count dag");
        process_exit(1);
    }

    let is_strong2: Bool = tarjan_is_strongly_connected(&res2);
    if is_strong2 == true {
        println("FAIL tarjan_is_strongly_connected dag");
        process_exit(1);
    }

    println("prod_g4_graph_scc_tarjan: PASSED");
    process_exit(0);
}
