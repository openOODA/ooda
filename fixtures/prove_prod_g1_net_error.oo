// # Product prove std/net/net_error.oo
//
// Logline: Fail-closed emit+gcc+run asserts net_err_is_retryable is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/net_error.oo.
//
// Beats:
//   1. Call net_err_is_retryable twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_net_error: PASSED only if they match.

import "std/net/net_error.oo";

pub fn main() {
    let obj_a: NetError = net_err_new(0, "x", "x", true);
    let obj_b: NetError = net_err_new(0, "x", "x", true);
    let a: Bool = net_err_is_retryable(obj_a);
    let b: Bool = net_err_is_retryable(obj_b);
    if a != b {
        println("FAIL net_err_is_retryable");
        process_exit(1);
    }
    println("prod_net_error: PASSED");
}
