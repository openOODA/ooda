// # Product prove std/db_graph/graph_pattern_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts pattern_match_binding_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_pattern_matcher.oo.
//
// Beats:
//   1. Call pattern_match_binding_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_pattern_matcher: PASSED only if they match.

import "std/db_graph/graph_pattern_matcher.oo";

pub fn main() {
    let graph_pattern_matcher_mark: Int = 0;
    if graph_pattern_matcher_mark != 0 {
        process_exit(1);
    }
    let a: PatternMatchBinding = pattern_match_binding_new(0, 0, 0);
    let b: PatternMatchBinding = pattern_match_binding_new(0, 0, 0);
    if (a).src_node_id != (b).src_node_id {
        println("FAIL pattern_match_binding_new");
        process_exit(1);
    }
    println("prod_graph_pattern_matcher: PASSED");
}
