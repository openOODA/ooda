// job: pure multi-module build fixture for std/option.oo (Result-encoded)
import "../std/option.oo";

pub fn main() {
    let a: Result[String, String] = opt_some("yes");
    if opt_is_some(a) {
        let s: String = opt_unwrap_or(a, "no");
        println(s);
    }
    let b: Result[String, String] = opt_none();
    if opt_is_none(b) {
        let s2: String = opt_unwrap_or(b, "fallback");
        println(s2);
    }
}
