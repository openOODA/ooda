// # Unwrap option some and none
//
// Logline: Build opt_some and opt_none and print unwrap_or for each arm.
//
// Setup: Test fixture. Imports std/option.oo. Keep all code exact.
//
// Beats:
//   1. Bind opt_some("yes") and print the unwrap.
//   2. Bind opt_none and print the fallback.
//   3. Use the Result-encoded option helpers only.
import "std/option.oo";

pub fn main() {
    let a: Result[String, String] = opt_some("yes");
    if opt_is_some(a) {
        let s: String = opt_unwrap_or(a, "no");
        println(s);
    }
    let b: Result[String, String] = opt_none();
    if opt_is_none(b) {
        let s2: String = opt_unwrap_or(b, "fallback");
        println(s2);
    }
}
