// # Product prove std/fin/aml_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts aml_risk_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_types.oo.
//
// Beats:
//   1. Call aml_risk_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aml_types: PASSED only if they match.

import "std/fin/aml_types.oo";

pub fn main() {
    let aml_types_mark: Int = 0;
    if aml_types_mark != 0 {
        process_exit(1);
    }
    let a: AmlRisk = aml_risk_new(0, 0, 0);
    let b: AmlRisk = aml_risk_new(0, 0, 0);
    if (a).entity_id != (b).entity_id {
        println("FAIL aml_risk_new");
        process_exit(1);
    }
    println("prod_aml_types: PASSED");
}
