// # Product prove std/bft_consensus/dag_causal_history_traversal.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/dag_causal_history_traversal.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_causal_history_traversal.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dag_causal_history_traversal: PASSED only if they match.

import "std/bft_consensus/dag_causal_history_traversal.oo";

pub fn main() {
    let dag_causal_history_traversal_a = causal_traversal_context_new("x", 0);
    let dag_causal_history_traversal_b = causal_traversal_context_new("x", 0);
    let dag_causal_history_traversal_va = causal_traversal_is_complete(dag_causal_history_traversal_a, 0);
    let dag_causal_history_traversal_vb = causal_traversal_is_complete(dag_causal_history_traversal_b, 0);
    if dag_causal_history_traversal_va != dag_causal_history_traversal_vb {
        println("FAIL dag_causal_history_traversal");
        process_exit(1);
    }
    println("prod_ap_dag_causal_history_traversal: PASSED");
}
