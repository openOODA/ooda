// # Product prove std/compilers_vm/wasm_simd128_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_simd128_encoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_simd128_encoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_simd128_encoder: PASSED only if they match.

import "std/compilers_vm/wasm_simd128_encoder.oo";

pub fn main() {
    let wasm_simd128_encoder_a = simd_v128_const();
    let wasm_simd128_encoder_b = simd_v128_const();
    if wasm_simd128_encoder_a != wasm_simd128_encoder_b {
        println("FAIL wasm_simd128_encoder");
        process_exit(1);
    }
    println("prod_ap_wasm_simd128_encoder: PASSED");
}
