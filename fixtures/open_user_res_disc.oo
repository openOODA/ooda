// # Discarded user Result call
//
// Logline: A user function that returns Result used as a statement must fail check.
//
// Setup: OPEN-16 must-use.
//
// Beats:
//   1. boom returns Result.
//   2. main calls boom as a statement.
//   3. Check refuses.

pub fn boom() -> Result[String, String] {
    return Ok("x");
}

pub fn main() {
    boom();
}
