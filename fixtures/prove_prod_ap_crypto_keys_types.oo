// # Product prove std/crypto/keys_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/keys_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_keys_types: PASSED only if they match.

import "std/crypto/keys_types.oo";

pub fn main() {
    let keys_types_a = key_meta_new(0, 0, 0);
    let keys_types_b = key_meta_new(0, 0, 0);
    let keys_types_va = key_meta_bits(keys_types_a);
    let keys_types_vb = key_meta_bits(keys_types_b);
    if keys_types_va != keys_types_vb {
        println("FAIL keys_types");
        process_exit(1);
    }
    println("prod_ap_keys_types: PASSED");
}
