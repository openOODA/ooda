// # Product prove std/space_propulsion/lambert_multirev_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts multi_rev_spec_default_earth_mars_1rev is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/lambert_multirev_solver.oo.
//
// Beats:
//   1. Call multi_rev_spec_default_earth_mars_1rev twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lambert_multirev_solver: PASSED only if they match.

import "std/space_propulsion/lambert_multirev_solver.oo";

pub fn main() {
    let lambert_multirev_solver_mark: Int = 0;
    if lambert_multirev_solver_mark != 0 {
        process_exit(1);
    }
    let a: MultiRevLambertSpec = multi_rev_spec_default_earth_mars_1rev();
    let b: MultiRevLambertSpec = multi_rev_spec_default_earth_mars_1rev();
    if (a).num_revolutions != (b).num_revolutions {
        println("FAIL multi_rev_spec_default_earth_mars_1rev");
        process_exit(1);
    }
    println("prod_lambert_multirev_solver: PASSED");
}
