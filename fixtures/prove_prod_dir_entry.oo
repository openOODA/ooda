// # Product prove std/fs/dir_entry.oo
//
// Logline: Fail-closed emit+gcc+run asserts dir_entry_path is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/dir_entry.oo.
//
// Beats:
//   1. Call dir_entry_path twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dir_entry: PASSED only if they match.

import "std/fs/dir_entry.oo";

pub fn main() {
    let obj = dir_entry_new("x", "x", true, 0);
    let a = dir_entry_path(obj);
    let b = dir_entry_path(obj);
    if a != b {
        println("FAIL dir_entry_path");
        process_exit(1);
    }
    println("prod_dir_entry: PASSED");
}
