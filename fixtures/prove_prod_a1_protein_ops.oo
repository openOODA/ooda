// # Product prove std/bio/protein_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts point3d_sqrt_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_ops.oo.
//
// Beats:
//   1. Call point3d_sqrt_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_ops: PASSED only if they match.

import "std/bio/protein_ops.oo";

pub fn main() {
    let protein_ops_mark: Int = 0;
    if protein_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = point3d_sqrt_approx(0);
    let b: Int = point3d_sqrt_approx(0);
    if a != b {
        println("FAIL point3d_sqrt_approx");
        process_exit(1);
    }
    println("prod_protein_ops: PASSED");
}
