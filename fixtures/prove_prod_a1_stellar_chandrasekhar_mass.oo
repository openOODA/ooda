// # Product prove std/astrophysics_relativity/stellar_chandrasekhar_mass.oo
//
// Logline: Fail-closed emit+gcc+run asserts chandrasekhar_mass_limit_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_chandrasekhar_mass.oo.
//
// Beats:
//   1. Call chandrasekhar_mass_limit_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_chandrasekhar_mass: PASSED only if they match.

import "std/astrophysics_relativity/stellar_chandrasekhar_mass.oo";

pub fn main() {
    let stellar_chandrasekhar_mass_mark: Int = 0;
    if stellar_chandrasekhar_mass_mark != 0 {
        process_exit(1);
    }
    let a: Int = chandrasekhar_mass_limit_milli(0);
    let b: Int = chandrasekhar_mass_limit_milli(0);
    if a != b {
        println("FAIL chandrasekhar_mass_limit_milli");
        process_exit(1);
    }
    println("prod_stellar_chandrasekhar_mass: PASSED");
}
