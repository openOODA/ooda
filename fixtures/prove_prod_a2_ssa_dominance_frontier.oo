// # Product prove std/compilers_vm/ssa_dominance_frontier.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_frontier_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_dominance_frontier.oo.
//
// Beats:
//   1. Call block_frontier_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ssa_dominance_frontier: PASSED only if they match.

import "std/compilers_vm/ssa_dominance_frontier.oo";

pub fn main() {
    let ssa_dominance_frontier_mark: Int = 0;
    if ssa_dominance_frontier_mark != 0 {
        process_exit(1);
    }
    let a: BlockFrontier = block_frontier_new(0);
    let b: BlockFrontier = block_frontier_new(0);
    if (a).block_id != (b).block_id {
        println("FAIL block_frontier_new");
        process_exit(1);
    }
    println("prod_ssa_dominance_frontier: PASSED");
}
