// # Product prove std/grid/freq.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/freq.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_freq: PASSED only if they match.

import "std/grid/freq.oo";

pub fn main() {
    let freq_a = shim_marker_freq_is_stable();
    let freq_b = shim_marker_freq_is_stable();
    if freq_a != freq_b {
        println("FAIL freq");
        process_exit(1);
    }
    println("prod_ap_freq: PASSED");
}
