// # Product prove std/graph_gnn/gnn_cluster_gcn_partition.oo
//
// Logline: Fail-closed emit+gcc+run asserts cluster_gcn_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_cluster_gcn_partition.oo.
//
// Beats:
//   1. Call cluster_gcn_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_cluster_gcn_partition: PASSED only if they match.

import "std/graph_gnn/gnn_cluster_gcn_partition.oo";

pub fn main() {
    let gnn_cluster_gcn_partition_mark: Int = 0;
    if gnn_cluster_gcn_partition_mark != 0 {
        process_exit(1);
    }
    let a: ClusterGCNConfig = cluster_gcn_config_new(0, 0, 0);
    let b: ClusterGCNConfig = cluster_gcn_config_new(0, 0, 0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL cluster_gcn_config_new");
        process_exit(1);
    }
    println("prod_g2_gnn_cluster_gcn_partition: PASSED");
}
