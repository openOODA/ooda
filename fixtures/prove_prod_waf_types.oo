// # Product prove std/sec/net/waf_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts str_eq is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_types.oo.
//
// Beats:
//   1. Call str_eq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_waf_types: PASSED only if they match.

import "std/sec/net/waf_types.oo";

pub fn main() {
    let a = str_eq("x", "x");
    let b = str_eq("x", "x");
    if a != b {
        println("FAIL str_eq");
        process_exit(1);
    }
    println("prod_waf_types: PASSED");
}
