// # Thread Channel Verification Proof Fixture
//
// Logline: Proves thread-safe bounded channel creation, message push, FIFO pop, and empty queue handling under ThreadCap.
//
// Setup: Requires explicit &ThreadCap capability token.
//
// Beats:
//   1. Allocate channel handle.
//   2. Push two messages into channel.
//   3. Pop first message and verify FIFO ordering.
//   4. Pop second message.
//   5. Pop empty channel and verify Err refusal.
// RULES.oot 1.4: Default-deny for concurrency effects. Explicit &ThreadCap required.
// RULES.oot 1.6: Dual-evidence happy path and empty channel refusal.
// RULES.oot 1.7: Under 256 lines.

import "std/sync/channel.oo";
import "std/result.oo";

pub fn main(tc: &ThreadCap) {
    let r_ch: Result[String, String] = channel_create(tc);
    if !r_ch.is_ok() {
        println("FAIL: channel_create failed");
        process_exit(1);
    }
    let handle: String = res_unwrap_or(r_ch, "");
    if !handle.contains("ch:") {
        println("FAIL: bad channel handle");
        process_exit(1);
    }

    // 1. Push two messages
    let r_push1: Result[String, String] = channel_push(tc, handle, "event:alpha");
    if !r_push1.is_ok() {
        println("FAIL: push1 failed");
        process_exit(1);
    }

    let r_push2: Result[String, String] = channel_push(tc, handle, "event:beta");
    if !r_push2.is_ok() {
        println("FAIL: push2 failed");
        process_exit(1);
    }

    // 2. Pop FIFO
    let r_pop1: Result[String, String] = channel_pop(tc, handle);
    if !r_pop1.is_ok() {
        println("FAIL: pop1 failed");
        process_exit(1);
    }
    let m1: String = res_unwrap_or(r_pop1, "");
    if m1 != "event:alpha" {
        println("FAIL: FIFO order mismatch: " + m1);
        process_exit(1);
    }

    let r_pop2: Result[String, String] = channel_pop(tc, handle);
    if !r_pop2.is_ok() {
        println("FAIL: pop2 failed");
        process_exit(1);
    }
    let m2: String = res_unwrap_or(r_pop2, "");
    if m2 != "event:beta" {
        println("FAIL: FIFO order mismatch: " + m2);
        process_exit(1);
    }

    // 3. Pop empty channel -> must Err
    let r_empty: Result[String, String] = channel_pop(tc, handle);
    if !r_empty.is_err() {
        println("FAIL: empty pop must return Err");
        process_exit(1);
    }

    println("OK: CHANNEL_SMOKE_PROOF_PASSED");
}
