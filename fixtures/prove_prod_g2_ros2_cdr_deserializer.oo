// # Product prove std/robotics_ros2/ros2_cdr_deserializer.oo
//
// Logline: Fail-closed emit+gcc+run asserts cdr_decoder_calculate_padding is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_cdr_deserializer.oo.
//
// Beats:
//   1. Call cdr_decoder_calculate_padding twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ros2_cdr_deserializer: PASSED only if they match.

import "std/robotics_ros2/ros2_cdr_deserializer.oo";

pub fn main() {
    let ros2_cdr_deserializer_mark: Int = 0;
    if ros2_cdr_deserializer_mark != 0 {
        process_exit(1);
    }
    let a: Int = cdr_decoder_calculate_padding(0, 0);
    let b: Int = cdr_decoder_calculate_padding(0, 0);
    if a != b {
        println("FAIL cdr_decoder_calculate_padding");
        process_exit(1);
    }
    println("prod_g2_ros2_cdr_deserializer: PASSED");
}
