// # Product prove std/web_ecosystem/uuid_v7.oo
//
// Logline: Fail-closed emit+gcc+run asserts uuid_v7_validate is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/uuid_v7.oo.
//
// Beats:
//   1. Call uuid_v7_validate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uuid_v7: PASSED only if they match.

import "std/web_ecosystem/uuid_v7.oo";

pub fn main() {
    let a = uuid_v7_validate(0, 0, 0, 0, 0, 0, 0);
    let b = uuid_v7_validate(0, 0, 0, 0, 0, 0, 0);
    if a != b {
        println("FAIL uuid_v7_validate");
        process_exit(1);
    }
    println("prod_uuid_v7: PASSED");
}
