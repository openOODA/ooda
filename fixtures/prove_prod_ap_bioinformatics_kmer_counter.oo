// # Product prove std/bioinformatics/kmer_counter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/kmer_counter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/kmer_counter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kmer_counter: PASSED only if they match.

import "std/bioinformatics/kmer_counter.oo";

pub fn main() {
    let kmer_counter_a = int_pow4(0);
    let kmer_counter_b = int_pow4(0);
    if kmer_counter_a != kmer_counter_b {
        println("FAIL kmer_counter");
        process_exit(1);
    }
    println("prod_ap_kmer_counter: PASSED");
}
