// # Product prove std/sec/attestation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/attestation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/attestation.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_attestation: PASSED and exit 0 only on match.

import "std/sec/attestation.oo";

pub fn main() {
    let attestation_a: Bool = shim_marker_measurement_verify();
    let attestation_b: Bool = shim_marker_measurement_verify();
    if attestation_a != attestation_b {
        println("FAIL attestation measurement verify");
        process_exit(1);
    }

    let tok_ok_a: Bool = shim_marker_token_valid();
    let tok_ok_b: Bool = shim_marker_token_valid();
    if tok_ok_a != tok_ok_b {
        println("FAIL attestation token valid");
        process_exit(1);
    }

    let chk_a: Int = shim_marker_quote_checksum();
    let chk_b: Int = shim_marker_quote_checksum();
    if chk_a != chk_b {
        println("FAIL attestation quote checksum");
        process_exit(1);
    }

    let trust_a: Int = shim_marker_quote_trust();
    let trust_b: Int = shim_marker_quote_trust();
    if trust_a != trust_b {
        println("FAIL attestation quote trust");
        process_exit(1);
    }

    let work_a: Int = shim_marker_engine_do_work();
    let work_b: Int = shim_marker_engine_do_work();
    if work_a != work_b {
        println("FAIL attestation engine do work");
        process_exit(1);
    }

    println("prod_g4_sec_attestation: PASSED");
    process_exit(0);
}
