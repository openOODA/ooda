// # Product prove std/graph_topology/scc_kosaraju.oo
//
// Logline: Fail-closed verification of Kosaraju strongly connected components algorithm and transpose operations.
//
// Setup: Isolated emit-c. Imports std/graph_topology/scc_kosaraju.oo.
//
// Beats:
//   1. Build directed 3-cycle and assert single strongly connected component.
//   2. Build two separated SCC subgraphs connected by a 1-way bridge and assert 2 components.
//   3. Assert transpose graph edge reversal and component equality predicates.
//   4. Print prod_g4_graph_scc_kosaraju: PASSED and exit 0.

import "std/graph_topology/scc_kosaraju.oo";

pub fn main() {
    let mut g1: GraphAdjList = adj_list_create(true);
    adj_list_add_vertex(&mut g1, 0);
    adj_list_add_vertex(&mut g1, 1);
    adj_list_add_vertex(&mut g1, 2);
    adj_list_add_edge_directed(&mut g1, 0, 1, 1);
    adj_list_add_edge_directed(&mut g1, 1, 2, 1);
    adj_list_add_edge_directed(&mut g1, 2, 0, 1);

    let gt: GraphAdjList = graph_transpose(&g1, 3);
    let has_rev: Bool = adj_list_has_edge(&gt, 1, 0);
    if !has_rev {
        println("FAIL graph_transpose edge reversal");
        process_exit(1);
    }

    let res1_a: KosarajuSccResult = kosaraju_scc_find(&g1, 3);
    let res1_b: KosarajuSccResult = kosaraju_scc_find(&g1, 3);

    let scc_cnt1: Int = (res1_a).scc_count;
    let scc_cnt1_b: Int = (res1_b).scc_count;
    if scc_cnt1 != scc_cnt1_b || scc_cnt1 != 1 {
        println("FAIL kosaraju_scc_find cycle count");
        process_exit(1);
    }

    let same_0_1: Bool = kosaraju_same_component(&res1_a, 0, 1);
    let same_1_2: Bool = kosaraju_same_component(&res1_a, 1, 2);
    if !same_0_1 || !same_1_2 {
        println("FAIL kosaraju_same_component cycle");
        process_exit(1);
    }

    let mut g2: GraphAdjList = adj_list_create(true);
    adj_list_add_vertex(&mut g2, 0);
    adj_list_add_vertex(&mut g2, 1);
    adj_list_add_vertex(&mut g2, 2);
    adj_list_add_vertex(&mut g2, 3);
    adj_list_add_edge_directed(&mut g2, 0, 1, 1);
    adj_list_add_edge_directed(&mut g2, 1, 0, 1);
    adj_list_add_edge_directed(&mut g2, 2, 3, 1);
    adj_list_add_edge_directed(&mut g2, 3, 2, 1);
    adj_list_add_edge_directed(&mut g2, 1, 2, 1);

    let res2: KosarajuSccResult = kosaraju_scc_find(&g2, 4);
    let scc_cnt2: Int = (res2).scc_count;
    if scc_cnt2 != 2 {
        println("FAIL kosaraju_scc_find 2-cluster count");
        process_exit(1);
    }

    let same_cluster1: Bool = kosaraju_same_component(&res2, 0, 1);
    let same_cluster2: Bool = kosaraju_same_component(&res2, 2, 3);
    let cross_cluster: Bool = kosaraju_same_component(&res2, 0, 2);
    if !same_cluster1 || !same_cluster2 || cross_cluster {
        println("FAIL kosaraju_same_component 2-cluster partitioning");
        process_exit(1);
    }

    let oob: Bool = kosaraju_same_component(&res2, -1, 0);
    if oob {
        println("FAIL kosaraju_same_component out-of-bounds");
        process_exit(1);
    }

    println("prod_g4_graph_scc_kosaraju: PASSED");
    process_exit(0);
}
