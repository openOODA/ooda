// # Product prove std/pqc_nist/pqc_nist_benchmarks.oo
//
// Logline: Fail-closed emit+gcc+run asserts benchmark_report_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_nist_benchmarks.oo.
//
// Beats:
//   1. Call benchmark_report_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pqc_nist_benchmarks: PASSED only if they match.

import "std/pqc_nist/pqc_nist_benchmarks.oo";

pub fn main() {
    let pqc_nist_benchmarks_mark: Int = 0;
    if pqc_nist_benchmarks_mark != 0 {
        process_exit(1);
    }
    let pqc_nist_benchmarks_a = benchmark_report_default();
    let pqc_nist_benchmarks_b = benchmark_report_default();
    if (pqc_nist_benchmarks_a).total_benchmarks != (pqc_nist_benchmarks_b).total_benchmarks {
        println("FAIL benchmark_report_default");
        process_exit(1);
    }
    println("prod_pqc_nist_benchmarks: PASSED");
}
