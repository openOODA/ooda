// # Product prove std/wasm_gc/wasm_component_wit_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts wit_parser_is_eof is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_wit_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call wit_parser_is_eof twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_wasm_component_wit_parser: PASSED only if they match.

import "std/wasm_gc/wasm_component_wit_parser.oo";

pub fn main() {
    let g0_oa = wit_parser_new();
    let g0_ob = wit_parser_new();
    let g0_a = wit_parser_is_eof(g0_oa);
    let g0_b = wit_parser_is_eof(g0_ob);
    if g0_a != g0_b {
        println("FAIL wit_parser_is_eof");
        process_exit(1);
    }
    println("prod_g0_wasm_component_wit_parser: PASSED");
}
