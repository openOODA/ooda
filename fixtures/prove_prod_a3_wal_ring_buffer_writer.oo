// # Product prove std/db_storage/wal_ring_buffer_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts wal_ring_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_ring_buffer_writer.oo.
//
// Beats:
//   1. Call wal_ring_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_ring_buffer_writer: PASSED only if they match.

import "std/db_storage/wal_ring_buffer_writer.oo";

pub fn main() {
    let wal_ring_buffer_writer_mark: Int = 0;
    if wal_ring_buffer_writer_mark != 0 {
        process_exit(1);
    }
    let a: WalRingBuffer = wal_ring_buffer_new(0);
    let b: WalRingBuffer = wal_ring_buffer_new(0);
    if (a).capacity_slots != (b).capacity_slots {
        println("FAIL wal_ring_buffer_new");
        process_exit(1);
    }
    println("prod_wal_ring_buffer_writer: PASSED");
}
