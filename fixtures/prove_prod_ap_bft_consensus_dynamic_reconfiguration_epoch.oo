// # Product prove std/bft_consensus/dynamic_reconfiguration_epoch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/dynamic_reconfiguration_epoch.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dynamic_reconfiguration_epoch.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dynamic_reconfiguration_epoch: PASSED only if they match.

import "std/bft_consensus/dynamic_reconfiguration_epoch.oo";

pub fn main() {
    let dynamic_reconfiguration_epoch_a = epoch_state_new(0, 0, 0);
    let dynamic_reconfiguration_epoch_b = epoch_state_new(0, 0, 0);
    let dynamic_reconfiguration_epoch_va = epoch_is_boundary_block(dynamic_reconfiguration_epoch_a, 0);
    let dynamic_reconfiguration_epoch_vb = epoch_is_boundary_block(dynamic_reconfiguration_epoch_b, 0);
    if dynamic_reconfiguration_epoch_va != dynamic_reconfiguration_epoch_vb {
        println("FAIL dynamic_reconfiguration_epoch");
        process_exit(1);
    }
    println("prod_ap_dynamic_reconfiguration_epoch: PASSED");
}
