// # Product prove std/telecom_5g/channel_rayleigh_fading.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/channel_rayleigh_fading.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_rayleigh_fading.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_channel_rayleigh_fading: PASSED only if they match.

import "std/telecom_5g/channel_rayleigh_fading.oo";

pub fn main() {
    let channel_rayleigh_fading_a = channel_rayleigh_pdf(0.0, 0.0);
    let channel_rayleigh_fading_b = channel_rayleigh_pdf(0.0, 0.0);
    if channel_rayleigh_fading_a != channel_rayleigh_fading_b {
        println("FAIL channel_rayleigh_fading");
        process_exit(1);
    }
    println("prod_ap_channel_rayleigh_fading: PASSED");
}
