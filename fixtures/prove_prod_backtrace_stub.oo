// # Product prove std/diag/backtrace_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_frame_format is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/backtrace_stub.oo.
//
// Beats:
//   1. Call stack_frame_format twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_backtrace_stub: PASSED only if they match.

import "std/diag/backtrace_stub.oo";

pub fn main() {
    let obj = stack_frame_new("x", "x", 0);
    let a = stack_frame_format(obj);
    let b = stack_frame_format(obj);
    if a != b {
        println("FAIL stack_frame_format");
        process_exit(1);
    }
    println("prod_backtrace_stub: PASSED");
}
