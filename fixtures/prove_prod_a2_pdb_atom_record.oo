// # Product prove std/bioinformatics/pdb_atom_record.oo
//
// Logline: Fail-closed emit+gcc+run asserts point3d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/pdb_atom_record.oo.
//
// Beats:
//   1. Call point3d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pdb_atom_record: PASSED only if they match.

import "std/bioinformatics/pdb_atom_record.oo";

pub fn main() {
    let pdb_atom_record_mark: Int = 0;
    if pdb_atom_record_mark != 0 {
        process_exit(1);
    }
    let a: Point3D = point3d_new(0, 0, 0);
    let b: Point3D = point3d_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL point3d_new");
        process_exit(1);
    }
    println("prod_pdb_atom_record: PASSED");
}
