// # Product priority_queue prove
//
// Logline: Fail-closed emit+gcc+run of shipped pq_push/len.
//
// Setup: Product std/collections/priority_queue.oo. List[Int] destub.
//
// Beats:
//   1. After push item 7 pri 1, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/priority_queue.oo";

pub fn main() {
    let mut q: PriorityQueue = pq_new();
    q = pq_push(q, 7, 1);
    let n: Int = pq_len(q);
    if n != 1 {
        println("FAIL pq len");
        process_exit(1);
    }
    println("prod_pq: PASSED");
}
