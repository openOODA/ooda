// # Product prove std/exploit_analysis/heap_house_of_spirit.oo
//
// Logline: Fail-closed emit+gcc+run asserts house_of_spirit_plan_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_house_of_spirit.oo.
//
// Beats:
//   1. Call house_of_spirit_plan_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_house_of_spirit: PASSED only if they match.

import "std/exploit_analysis/heap_house_of_spirit.oo";

pub fn main() {
    let heap_house_of_spirit_mark: Int = 0;
    if heap_house_of_spirit_mark != 0 {
        process_exit(1);
    }
    let a: HouseOfSpiritPlan = house_of_spirit_plan_new(0, 0, "x");
    let b: HouseOfSpiritPlan = house_of_spirit_plan_new(0, 0, "x");
    if (a).next_chunk_address != (b).next_chunk_address {
        println("FAIL house_of_spirit_plan_new");
        process_exit(1);
    }
    println("prod_heap_house_of_spirit: PASSED");
}
