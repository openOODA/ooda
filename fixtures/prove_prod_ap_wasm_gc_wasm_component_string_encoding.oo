// # Product prove std/wasm_gc/wasm_component_string_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/wasm_gc/wasm_component_string_encoding.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_string_encoding.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_component_string_encoding: PASSED only if they match.

import "std/wasm_gc/wasm_component_string_encoding.oo";

pub fn main() {
    let wasm_component_string_encoding_a = enc_utf8();
    let wasm_component_string_encoding_b = enc_utf8();
    if wasm_component_string_encoding_a != wasm_component_string_encoding_b {
        println("FAIL wasm_component_string_encoding");
        process_exit(1);
    }
    println("prod_ap_wasm_component_string_encoding: PASSED");
}
