// # Product prove std/os/terminal_cursor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/terminal_cursor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_cursor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_terminal_cursor: PASSED only if they match.

import "std/os/terminal_cursor.oo";

pub fn main() {
    let terminal_cursor_a = cursor_up(0);
    let terminal_cursor_b = cursor_up(0);
    if terminal_cursor_a.contains(terminal_cursor_b) == false {
        println("FAIL terminal_cursor");
        process_exit(1);
    }
    if terminal_cursor_b.contains(terminal_cursor_a) == false {
        println("FAIL terminal_cursor");
        process_exit(1);
    }
    println("prod_ap_terminal_cursor: PASSED");
}
