// # Product prove std/quantum/density_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts density_maximally_mixed holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/density_matrix.oo.
//
// Beats:
//   1. Call density_maximally_mixed using the density_matrix ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_density_matrix: PASSED only if asserts hold.

import "std/quantum/density_matrix.oo";

pub fn main() {
    let obj = density_maximally_mixed();
    let density_matrix_a = obj.rho00.real;
    let density_matrix_b = obj.rho00.real;
    if density_matrix_a != density_matrix_b {
        println("FAIL density_maximally_mixed");
        process_exit(1);
    }
    println("prod_density_matrix: PASSED");
}
