// # Product prove std/web_ecosystem/lodash_throttle.oo
//
// Logline: Fail-closed emit+gcc+run asserts throttle_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_throttle.oo.
//
// Beats:
//   1. Call throttle_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lodash_throttle: PASSED only if they match.

import "std/web_ecosystem/lodash_throttle.oo";

pub fn main() {
    let lodash_throttle_mark: Int = 0;
    if lodash_throttle_mark != 0 {
        process_exit(1);
    }
    let a: ThrottleState = throttle_new(0);
    let b: ThrottleState = throttle_new(0);
    if (a).interval_ms != (b).interval_ms {
        println("FAIL throttle_new");
        process_exit(1);
    }
    println("prod_g2_lodash_throttle: PASSED");
}
