// # Product treap prove
//
// Logline: Fail-closed emit+gcc+run of shipped treap insert/contains/len.
//
// Setup: Product std/collections/treap.oo. List[Int] destub.
//
// Beats:
//   1. insert 7,1,10: len 1; contains 7 true; contains 3 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/treap.oo";

pub fn main() {
    let mut t: Treap = treap_new();
    t = treap_insert(t, 7, 1, 10);
    let n: Int = treap_len(t);
    if n != 1 {
        println("FAIL treap len");
        process_exit(1);
    }
    let c7: Bool = treap_contains(t, 7);
    if c7 == false {
        println("FAIL treap 7");
        process_exit(1);
    }
    let c3: Bool = treap_contains(t, 3);
    if c3 == true {
        println("FAIL treap 3");
        process_exit(1);
    }
    let v: Int = treap_get(t, 7);
    if v != 10 {
        println("FAIL treap get");
        process_exit(1);
    }
    println("prod_treap: PASSED");
}
