// # Product prove std/genomics_advanced/em_seq_enzymatic_methylation.oo
//
// Logline: Fail-closed emit+gcc+run asserts em_seq_enzymatic_methylation_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/em_seq_enzymatic_methylation.oo.
//
// Beats:
//   1. Call em_seq_enzymatic_methylation_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_em_seq_enzymatic_methylation: PASSED only if they match.

import "std/genomics_advanced/em_seq_enzymatic_methylation.oo";

pub fn main() {
    let a = em_seq_enzymatic_methylation_probe();
    let b = em_seq_enzymatic_methylation_probe();
    if a != b {
        println("FAIL em_seq_enzymatic_methylation_probe");
        process_exit(1);
    }
    println("prod_em_seq_enzymatic_methylation: PASSED");
}
