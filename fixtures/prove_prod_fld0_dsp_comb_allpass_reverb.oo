// # Product prove std/media_dsp/dsp_comb_allpass_reverb.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_allpass_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_comb_allpass_reverb.oo.
//
// Beats:
//   1. Call dsp_allpass_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_comb_allpass_reverb: PASSED only if they match.

import "std/media_dsp/dsp_comb_allpass_reverb.oo";

pub fn main() {
    let dsp_comb_allpass_reverb_mark: Int = 0;
    if dsp_comb_allpass_reverb_mark != 0 {
        process_exit(1);
    }
    let dsp_comb_allpass_reverb_a = dsp_allpass_new(1, 1.0);
    let dsp_comb_allpass_reverb_b = dsp_allpass_new(1, 1.0);
    if (dsp_comb_allpass_reverb_a).buffer_size != (dsp_comb_allpass_reverb_b).buffer_size {
        println("FAIL dsp_allpass_new");
        process_exit(1);
    }
    println("prod_dsp_comb_allpass_reverb: PASSED");
}
