// # Product prove std/defi_derivatives/portfolio_expected_shortfall.oo
//
// Logline: Fail-closed emit+gcc+run asserts es_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/portfolio_expected_shortfall.oo.
//
// Beats:
//   1. Call es_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_portfolio_expected_shortfall: PASSED only if they match.

import "std/defi_derivatives/portfolio_expected_shortfall.oo";

pub fn main() {
    let portfolio_expected_shortfall_mark: Int = 0;
    if portfolio_expected_shortfall_mark != 0 {
        process_exit(1);
    }
    let a: Float = es_norm_pdf(0.0);
    let b: Float = es_norm_pdf(0.0);
    if a != b {
        println("FAIL es_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_portfolio_expected_shortfall: PASSED");
}
