// # Product Jaro-Winkler prefix prove
//
// Logline: Fail-closed emit+gcc+run of shipped jaro_winkler_prefix_len.
//
// Setup: Product std/text/jaro_winkler.oo. MARTHA/MARHTA prefix 3.
//
// Beats:
//   1. Prefix of MARTHA and MARHTA is 3.
//   2. Prefix of CRATE and TRACE is 0.
//   3. Exit 1 before PASSED on a miss.

import "std/text/jaro_winkler.oo";

pub fn main() {
    let p: Int = jaro_winkler_prefix_len("MARTHA", "MARHTA");
    if p != 3 {
        println("FAIL jaro prefix");
        process_exit(1);
    }
    let z: Int = jaro_winkler_prefix_len("CRATE", "TRACE");
    if z != 0 {
        println("FAIL jaro zero");
        process_exit(1);
    }
    println("prod_jaro: PASSED");
}
