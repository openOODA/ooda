// # Product prove std/web_ecosystem/jwt_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_b64_index value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_decoder.oo.
//
// Beats:
//   1. Call jwt_b64_index twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_jwt_decoder: PASSED only if asserts hold.

import "std/web_ecosystem/jwt_decoder.oo";

pub fn main() {
    let jwt_decoder_a: Int = jwt_b64_index(0);
    let jwt_decoder_b: Int = jwt_b64_index(0);
    if jwt_decoder_a != jwt_decoder_b {
        println("FAIL jwt_b64_index");
        process_exit(1);
    }
    println("prod_jwt_decoder: PASSED");
}
