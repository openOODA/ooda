// # Product prove std/cloud_faas/request_buffered_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_faas/request_buffered_queue.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/request_buffered_queue.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_request_buffered_queue: PASSED only if they match.

import "std/cloud_faas/request_buffered_queue.oo";

pub fn main() {
    let request_buffered_queue_a = request_buffered_queue_new(0, 0);
    let request_buffered_queue_b = request_buffered_queue_new(0, 0);
    if request_buffered_queue_a.queue_id != request_buffered_queue_b.queue_id {
        println("FAIL request_buffered_queue");
        process_exit(1);
    }
    println("prod_ap_request_buffered_queue: PASSED");
}
