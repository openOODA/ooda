// # Product prove std/multimedia/pcm_audio.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcm_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/pcm_audio.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call pcm_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_pcm_audio: PASSED only if they match.

import "std/multimedia/pcm_audio.oo";

pub fn main() {
    let g0_a = pcm_int_to_float(0);
    let g0_b = pcm_int_to_float(0);
    if g0_a != g0_b {
        println("FAIL pcm_int_to_float");
        process_exit(1);
    }
    println("prod_gr_pcm_audio: PASSED");
}
