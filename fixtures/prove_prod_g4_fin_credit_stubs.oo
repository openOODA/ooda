// # Product prove std/fin/credit_stubs.oo
//
// Logline: Fail-closed verification that credit stubs module imports and credit score constructors are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_stubs.oo.
//
// Beats:
//   1. Construct CreditScore instances across prime, near-prime, and subprime tiers.
//   2. Extract score values and verify rating tier categorization.
//   3. Assert deterministic execution.
//   4. Print prod_g4_fin_credit_stubs: PASSED and exit 0.

import "std/fin/credit_stubs.oo";

pub fn main() {
    let cs_prime_a: CreditScore = credit_score_new(780, 1, 1);
    let cs_prime_b: CreditScore = credit_score_new(780, 1, 1);
    if (cs_prime_a).score != (cs_prime_b).score || (cs_prime_a).rating_tier != (cs_prime_b).rating_tier {
        println("FAIL credit_score_new prime");
        process_exit(1);
    }

    let val_a: Int = credit_score_value(cs_prime_a);
    let val_b: Int = credit_score_value(cs_prime_b);
    if val_a != val_b || val_a != 780 {
        println("FAIL credit_score_value");
        process_exit(1);
    }

    let cs_sub: CreditScore = credit_score_new(540, 4, 1);
    let val_sub: Int = credit_score_value(cs_sub);
    if val_sub != 540 || (cs_sub).rating_tier != 4 {
        println("FAIL credit_score_new subprime");
        process_exit(1);
    }

    let cs_inval: CreditScore = credit_score_new(0, 0, 0);
    if (cs_inval).is_valid != 0 {
        println("FAIL credit_score_new invalid flag");
        process_exit(1);
    }

    println("prod_g4_fin_credit_stubs: PASSED");
    process_exit(0);
}
