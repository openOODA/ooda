// # Allow a public path_exists path
//
// Logline: A non-secret path may reach path_exists while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public path instead.
//   3. Expect emit to allow the call.

// M142: non-secret path may path_exists
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let public = "/tmp/ok";
    let r = path_exists(fs, public);
    println(1);
}
