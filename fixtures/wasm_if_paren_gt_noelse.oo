// # Const if (2 > 1) println no else
//
// Logline: Print pgt-ne when (2 > 1) and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (2 > 1) print pgt-ne.
//   3. Leave no else and no other statements.

pub fn main() {
    if (2 > 1) {
        println("pgt-ne");
    }
}
