// # Hostile IDENT fourteenth println
//
// Logline: Print thirteen strings then IDENT x so emit-wasm must miss a fourteen-string fold.
//
// Setup: One public main. Fourteenth print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-m, then x.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println("line-g");
    println("line-h");
    println("line-i");
    println("line-j");
    println("line-k");
    println("line-l");
    println("line-m");
    println(x);
}
