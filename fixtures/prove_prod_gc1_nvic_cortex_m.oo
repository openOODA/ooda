// # Product prove std/embedded_hal/nvic_cortex_m.oo
//
// Logline: Fail-closed emit+gcc+run asserts nvic_encode_priority is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/nvic_cortex_m.oo.
//
// Beats:
//   1. Call nvic_encode_priority twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nvic_cortex_m: PASSED only if they match.

import "std/embedded_hal/nvic_cortex_m.oo";

pub fn main() {
    let nvic_cortex_m_mark: Int = 0;
    if nvic_cortex_m_mark != 0 {
        process_exit(1);
    }
    let nvic_cortex_m_a: Int = nvic_encode_priority(1, 1, 1);
    let nvic_cortex_m_b: Int = nvic_encode_priority(1, 1, 1);
    if nvic_cortex_m_a != nvic_cortex_m_b {
        println("FAIL nvic_encode_priority");
        process_exit(1);
    }
    println("prod_nvic_cortex_m: PASSED");
}
