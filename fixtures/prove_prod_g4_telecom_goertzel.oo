// # Product prove std/telecom_5g/dsp_goertzel_tone.oo
//
// Logline: Fail-closed verification that Goertzel tone detector initialization and power calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_goertzel_tone.oo.
//
// Beats:
//   1. Construct Goertzel single-tone detector for target frequency.
//   2. Validate target frequency and sampling parameters.
//   3. Compute feedback coefficient and power metric.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_goertzel: PASSED and exit 0.

import "std/telecom_5g/dsp_goertzel_tone.oo";

pub fn main() {
    let a: GoertzelToneDetector = goertzel_tone_detector_new(1000.0, 8000.0, 205);
    let b: GoertzelToneDetector = goertzel_tone_detector_new(1000.0, 8000.0, 205);

    if (a).target_frequency_hz != (b).target_frequency_hz || (a).target_frequency_hz != 1000.0 {
        println("FAIL goertzel_tone_detector_new target_frequency_hz");
        process_exit(1);
    }

    if (a).sample_rate_hz != (b).sample_rate_hz || (a).sample_rate_hz != 8000.0 {
        println("FAIL goertzel_tone_detector_new sample_rate_hz");
        process_exit(1);
    }

    if (a).block_size_n != (b).block_size_n || (a).block_size_n != 205 {
        println("FAIL goertzel_tone_detector_new block_size_n");
        process_exit(1);
    }

    if (a).feedback_coeff_c != (b).feedback_coeff_c {
        println("FAIL goertzel_tone_detector_new feedback_coeff_c");
        process_exit(1);
    }

    let pwr_a: Float = dsp_goertzel_calc_power(a);
    let pwr_b: Float = dsp_goertzel_calc_power(b);
    if pwr_a != pwr_b || pwr_a != 0.0 {
        println("FAIL dsp_goertzel_calc_power initial");
        process_exit(1);
    }

    println("prod_g4_telecom_goertzel: PASSED");
    process_exit(0);
}
