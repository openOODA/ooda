// job: pure multi-module fixture for std/archive magic detect (not decompress)
// residual: full tar/zip/gzip decompress NOT product
// check residual: oodac check is single-file; check each library alone
import "std/archive/tar.oo";
import "std/archive/zip.oo";
import "std/archive/gzip.oo";

pub fn main() {
    let t: Result[String, String] = tar_detect("pad ustar pad");
    if t.is_ok() {
        let s: String = t.unwrap();
        println(s);
    }
    let z: Result[String, String] = zip_detect("PKdata");
    if z.is_ok() {
        let s2: String = z.unwrap();
        println(s2);
    }
    let g: Result[String, String] = gzip_detect("1f8bxxxx");
    if g.is_ok() {
        let s3: String = g.unwrap();
        println(s3);
    }
    let bad: Result[String, String] = tar_detect("no-magic");
    if bad.is_err() {
        println("not-tar");
    }
}
