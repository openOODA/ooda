// # Product prove std/graph_topology/graph_adjacency_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts adj_matrix_get_index is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_adjacency_matrix.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call adj_matrix_get_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_adjacency_matrix: PASSED only if they match.

import "std/graph_topology/graph_adjacency_matrix.oo";

pub fn main() {
    let g2_a = adj_matrix_get_index(8, 2, 2);
    let g2_b = adj_matrix_get_index(8, 2, 2);
    if g2_a != g2_b {
        println("FAIL adj_matrix_get_index");
        process_exit(1);
    }
    println("prod_g2_graph_adjacency_matrix: PASSED");
}
