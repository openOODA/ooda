// # Product prove std/edge/mesh.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_config_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/mesh.oo.
//
// Beats:
//   1. Call shim_marker_config_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh: PASSED only if they match.

import "std/edge/mesh.oo";

pub fn main() {
    let mesh_mark: Int = 0;
    if mesh_mark != 0 {
        process_exit(1);
    }
    let a: MeshNodeConfig = shim_marker_config_init();
    let b: MeshNodeConfig = shim_marker_config_init();
    if (a).node_id != (b).node_id {
        println("FAIL shim_marker_config_init");
        process_exit(1);
    }
    println("prod_mesh: PASSED");
}
