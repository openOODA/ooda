// # Product prove std/bio_advanced/pdb_backbone_dihedral.oo
//
// Logline: Fail-closed verification that PDB protein backbone dihedral vector algebra and torsion angles are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/pdb_backbone_dihedral.oo.
//
// Beats:
//   1. Construct AtomCoord3D instances in 3D Cartesian space.
//   2. Compute vector subtraction, dot product, cross product, and magnitude.
//   3. Compute dihedral torsion angle in degrees.
//   4. Print prod_g4_bio_pdb_dihedral: PASSED and exit 0.

import "std/bio_advanced/pdb_backbone_dihedral.oo";

pub fn main() {
    let v1: AtomCoord3D = AtomCoord3D { x: 1.0, y: 0.0, z: 0.0 };
    let v2: AtomCoord3D = AtomCoord3D { x: 0.0, y: 1.0, z: 0.0 };

    let diff: AtomCoord3D = dihedral_vec_sub(&v1, &v2);
    if (diff).x != 1.0 || (diff).y != -1.0 || (diff).z != 0.0 {
        println("FAIL dihedral_vec_sub");
        process_exit(1);
    }

    let cross: AtomCoord3D = dihedral_vec_cross(&v1, &v2);
    if (cross).x != 0.0 || (cross).y != 0.0 || (cross).z != 1.0 {
        println("FAIL dihedral_vec_cross");
        process_exit(1);
    }

    let dot: Float = dihedral_vec_dot(&v1, &v2);
    if dot != 0.0 {
        println("FAIL dihedral_vec_dot");
        process_exit(1);
    }

    let l1: Float = dihedral_vec_len(&v1);
    if l1 != 1.0 {
        println("FAIL dihedral_vec_len");
        process_exit(1);
    }

    let p1: AtomCoord3D = AtomCoord3D { x: 0.0, y: 1.0, z: 0.0 };
    let p2: AtomCoord3D = AtomCoord3D { x: 0.0, y: 0.0, z: 0.0 };
    let p3: AtomCoord3D = AtomCoord3D { x: 1.0, y: 0.0, z: 0.0 };
    let p4: AtomCoord3D = AtomCoord3D { x: 1.0, y: 1.0, z: 0.0 };

    let deg1: Float = dihedral_compute_angle_deg(&p1, &p2, &p3, &p4);
    let deg2: Float = dihedral_compute_angle_deg(&p1, &p2, &p3, &p4);

    if deg1 != deg2 {
        println("FAIL dihedral_compute_angle_deg");
        process_exit(1);
    }

    let probe: Int = pdb_backbone_dihedral_probe();
    if probe != 0 {
        println("FAIL pdb_backbone_dihedral_probe");
        process_exit(1);
    }

    println("prod_g4_bio_pdb_dihedral: PASSED");
    process_exit(0);
}
