// # Product prove std/net/pay_early.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_early_is_too_early is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/pay_early.oo.
//
// Beats:
//   1. Call pay_early_is_too_early twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pay_early: PASSED only if they match.

import "std/net/pay_early.oo";

pub fn main() {
    let a = pay_early_is_too_early(0);
    let b = pay_early_is_too_early(0);
    if a != b {
        println("FAIL pay_early_is_too_early");
        process_exit(1);
    }
    println("prod_pay_early: PASSED");
}
