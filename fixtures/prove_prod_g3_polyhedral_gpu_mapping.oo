// # Product prove std/compilers_polyhedral/polyhedral_gpu_mapping.oo
//
// Logline: Fail-closed emit+gcc+run asserts gpu_is_warp_multiple is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_gpu_mapping.oo.
//
// Beats:
//   1. Call gpu_is_warp_multiple twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_gpu_mapping: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_gpu_mapping.oo";

pub fn main() {
    let polyhedral_gpu_mapping_mark: Int = 0;
    if polyhedral_gpu_mapping_mark != 0 {
        process_exit(1);
    }
    let a: Int = gpu_is_warp_multiple(0);
    let b: Int = gpu_is_warp_multiple(0);
    if a != b {
        println("FAIL gpu_is_warp_multiple");
        process_exit(1);
    }
    println("prod_polyhedral_gpu_mapping: PASSED");
}
