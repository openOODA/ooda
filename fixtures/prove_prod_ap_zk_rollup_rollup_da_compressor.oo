// # Product prove std/zk_rollup/rollup_da_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_da_compressor.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_da_compressor.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_da_compressor: PASSED only if they match.

import "std/zk_rollup/rollup_da_compressor.oo";

pub fn main() {
    let rollup_da_compressor_a = state_diff_record_new(0, 0, 0);
    let rollup_da_compressor_b = state_diff_record_new(0, 0, 0);
    if rollup_da_compressor_a.account_index != rollup_da_compressor_b.account_index {
        println("FAIL rollup_da_compressor");
        process_exit(1);
    }
    println("prod_ap_rollup_da_compressor: PASSED");
}
