// # Product prove std/gis_topo/dem_slope_aspect_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts dem_slope_aspect_calc_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_slope_aspect_calc.oo.
//
// Beats:
//   1. Call dem_slope_aspect_calc_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_dem_slope_aspect_calc: PASSED only if it matches.

import "std/gis_topo/dem_slope_aspect_calc.oo";

pub fn main() {
    let a: Int = dem_slope_aspect_calc_probe();
    if a != 0 {
        println("FAIL dem_slope_aspect_calc_probe");
        process_exit(1);
    }
    println("prod_nc_dem_slope_aspect_calc: PASSED");
}
