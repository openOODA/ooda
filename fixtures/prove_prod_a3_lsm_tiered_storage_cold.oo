// # Product prove std/db_storage/lsm_tiered_storage_cold.oo
//
// Logline: Fail-closed emit+gcc+run asserts tier_migration_policy_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_tiered_storage_cold.oo.
//
// Beats:
//   1. Call tier_migration_policy_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_tiered_storage_cold: PASSED only if they match.

import "std/db_storage/lsm_tiered_storage_cold.oo";

pub fn main() {
    let lsm_tiered_storage_cold_mark: Int = 0;
    if lsm_tiered_storage_cold_mark != 0 {
        process_exit(1);
    }
    let a: TierMigrationPolicy = tier_migration_policy_default();
    let b: TierMigrationPolicy = tier_migration_policy_default();
    if (a).hot_tier_max_bytes != (b).hot_tier_max_bytes {
        println("FAIL tier_migration_policy_default");
        process_exit(1);
    }
    println("prod_lsm_tiered_storage_cold: PASSED");
}
