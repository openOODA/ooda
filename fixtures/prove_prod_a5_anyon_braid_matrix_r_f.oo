// # Product prove std/quantum_topological/anyon_braid_matrix_r_f.oo
//
// Logline: Fail-closed emit+gcc+run asserts complex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_braid_matrix_r_f.oo.
//
// Beats:
//   1. Call complex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anyon_braid_matrix_r_f: PASSED only if they match.

import "std/quantum_topological/anyon_braid_matrix_r_f.oo";

pub fn main() {
    let anyon_braid_matrix_r_f_mark: Int = 0;
    if anyon_braid_matrix_r_f_mark != 0 {
        process_exit(1);
    }
    let a: ComplexNum = complex_new(0.0, 0.0);
    let b: ComplexNum = complex_new(0.0, 0.0);
    if (a).re != (b).re {
        println("FAIL complex_new");
        process_exit(1);
    }
    println("prod_anyon_braid_matrix_r_f: PASSED");
}
