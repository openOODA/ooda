// # Product prove std/quantum_open_systems/dissipative_kerr_soliton.oo
//
// Logline: Fail-closed emit+gcc+run asserts kerr_cavity_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/dissipative_kerr_soliton.oo.
//
// Beats:
//   1. Call kerr_cavity_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dissipative_kerr_soliton: PASSED only if they match.

import "std/quantum_open_systems/dissipative_kerr_soliton.oo";

pub fn main() {
    let dissipative_kerr_soliton_mark: Int = 0;
    if dissipative_kerr_soliton_mark != 0 {
        process_exit(1);
    }
    let a: KerrCavityParams = kerr_cavity_params_new(0.0, 0.0, 0.0, 0.0);
    let b: KerrCavityParams = kerr_cavity_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).loss_kappa != (b).loss_kappa {
        println("FAIL kerr_cavity_params_new");
        process_exit(1);
    }
    println("prod_dissipative_kerr_soliton: PASSED");
}
