// # Product prove std/mesh_ebpf/mesh_fault_injection.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_fault_injection_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_fault_injection.oo.
//
// Beats:
//   1. Call mesh_fault_injection_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_fault_injection: PASSED only if they match.

import "std/mesh_ebpf/mesh_fault_injection.oo";

pub fn main() {
    let a: Int = mesh_fault_injection_probe();
    let b: Int = mesh_fault_injection_probe();
    if a != 0 {
        println("FAIL mesh_fault_injection_probe");
        process_exit(1);
    }
    if a != b {
        println("FAIL mesh_fault_injection_probe");
        process_exit(1);
    }
    println("prod_mesh_fault_injection: PASSED");
}
