// # Hostile IDENT eighth println
//
// Logline: Print seven strings then IDENT x so emit-wasm must miss an eight-string fold.
//
// Setup: One public main. Eighth print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-g, then x.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println("line-g");
    println(x);
}
