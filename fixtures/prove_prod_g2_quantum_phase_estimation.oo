// # Product prove std/quantum_advanced/quantum_phase_estimation.oo
//
// Logline: Fail-closed emit+gcc+run asserts qpe_binary_fraction_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_phase_estimation.oo.
//
// Beats:
//   1. Call qpe_binary_fraction_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_phase_estimation: PASSED only if they match.

import "std/quantum_advanced/quantum_phase_estimation.oo";

pub fn main() {
    let quantum_phase_estimation_mark: Int = 0;
    if quantum_phase_estimation_mark != 0 {
        process_exit(1);
    }
    let a: Float = qpe_binary_fraction_to_float(list_new());
    let b: Float = qpe_binary_fraction_to_float(list_new());
    if a != b {
        println("FAIL qpe_binary_fraction_to_float");
        process_exit(1);
    }
    println("prod_g2_quantum_phase_estimation: PASSED");
}
