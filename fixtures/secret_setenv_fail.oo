// # Refuse a secret setenv value
//
// Logline: A tagged value must not reach setenv.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the value.
//   3. Expect the sink to refuse.

// M-? setenv taint: secret value must not reach setenv sink
// SECRET: token
pub fn main(envc: &EnvCap) {
    let token = "s3cret-value";
    let r = setenv(envc, "KEY", token);
    println(1);
}
