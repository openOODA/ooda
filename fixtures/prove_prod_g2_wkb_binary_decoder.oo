// # Product prove std/gis_topo/wkb_binary_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts wkb_type_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/wkb_binary_decoder.oo.
//
// Beats:
//   1. Call wkb_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wkb_binary_decoder: PASSED only if they match.

import "std/gis_topo/wkb_binary_decoder.oo";
import "std/str.oo";

pub fn main() {
    let wkb_binary_decoder_mark: Int = 0;
    if wkb_binary_decoder_mark != 0 {
        process_exit(1);
    }
    let a: String = wkb_type_name(0);
    let b: String = wkb_type_name(0);
    if str_eq(a, b) == false {
        println("FAIL wkb_type_name");
        process_exit(1);
    }
    println("prod_g2_wkb_binary_decoder: PASSED");
}
