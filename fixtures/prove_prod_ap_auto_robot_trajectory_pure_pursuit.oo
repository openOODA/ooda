// # Product prove std/auto_robot/trajectory_pure_pursuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/trajectory_pure_pursuit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/trajectory_pure_pursuit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_trajectory_pure_pursuit: PASSED only if they match.

import "std/auto_robot/trajectory_pure_pursuit.oo";

pub fn main() {
    let trajectory_pure_pursuit_a = pursuit_look(0, 0);
    let trajectory_pure_pursuit_b = pursuit_look(0, 0);
    if trajectory_pure_pursuit_a != trajectory_pure_pursuit_b {
        println("FAIL trajectory_pure_pursuit");
        process_exit(1);
    }
    println("prod_ap_trajectory_pure_pursuit: PASSED");
}
