// # Hostile hello plus extra println
//
// Logline: Greet shape plus println of other so emit-wasm must not drop the extra print.
//
// Setup: Same greet fold as hello.oo. Main also prints other.
//
// Beats:
//   1. greet returns Hello, plus name plus !.
//   2. main folds greet then prints other.
//   3. A greet-only module is a lie.

pub fn greet(name: String) -> String {
    return "Hello, " + name + "!";
}

pub fn main() {
    let message = greet("openOODA Developer");
    println(message);
    println("other");
}
