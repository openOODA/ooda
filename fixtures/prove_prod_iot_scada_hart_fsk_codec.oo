// # Product prove std/iot_scada/hart_fsk_codec.oo
//
// Logline: Fail-closed emit+check asserts hart_calc_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/hart_fsk_codec.oo.
//
// Beats:
//   1. Call hart_calc_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hart_fsk_codec: PASSED only if they match.

import "std/iot_scada/hart_fsk_codec.oo";

pub fn main() {
    let hart_fsk_codec_mark: Int = 0;
    if hart_fsk_codec_mark != 0 { process_exit(1); }
    let bytes: List[Int] = list_new();
    let a: Int = hart_calc_checksum(&bytes);
    let b: Int = hart_calc_checksum(&bytes);
    if a != b { process_exit(1); }
    println("prod_hart_fsk_codec: PASSED");
}
