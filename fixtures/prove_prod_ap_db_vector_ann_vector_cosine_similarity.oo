// # Product prove std/db_vector_ann/vector_cosine_similarity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_cosine_similarity.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_cosine_similarity.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_cosine_similarity: PASSED only if they match.

import "std/db_vector_ann/vector_cosine_similarity.oo";

pub fn main() {
    let vector_cosine_similarity_a = isqrt_approx(0);
    let vector_cosine_similarity_b = isqrt_approx(0);
    if vector_cosine_similarity_a != vector_cosine_similarity_b {
        println("FAIL vector_cosine_similarity");
        process_exit(1);
    }
    println("prod_ap_vector_cosine_similarity: PASSED");
}
