// # Product prove std/encoding/base58.oo
//
// Logline: Fail-closed emit+gcc+run asserts base58_encode_int value or determinism.
//
// Setup: Isolated emit-c. Imports std/encoding/base58.oo.
//
// Beats:
//   1. Call base58_encode_int twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_base58: PASSED only if asserts hold.

import "std/encoding/base58.oo";

pub fn main() {
    let base58: String = base58_encode_int(0);
    let base58_b: String = base58_encode_int(0);
    if chars_len(base58) != 1 {
        println("FAIL base58_encode_int len");
        process_exit(1);
    }
    if chars_len(base58) != chars_len(base58_b) {
        println("FAIL base58_encode_int det");
        process_exit(1);
    }
    println("prod_base58: PASSED");
}
