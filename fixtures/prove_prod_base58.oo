// # Product Base58 encode/decode prove
//
// Logline: Fail-closed emit+gcc+run of shipped Bitcoin Base58.
//
// Setup: Product std/encoding/base58.oo. Published Bitcoin alphabet vector.
//
// Beats:
//   1. base58_encode_int(0) is 1.
//   2. base58_encode("Hello World") is JxF12TrwUP45BMd.
//   3. decode of that is Ok("Hello World").
//   4. Exit 1 before PASSED on a miss.

import "std/encoding/base58.oo";

pub fn main() {
    let z: String = base58_encode_int(0);
    if z != "1" {
        println("FAIL base58_encode_int 0");
        process_exit(1);
    }
    let enc: String = base58_encode("Hello World");
    if enc != "JxF12TrwUP45BMd" {
        println("FAIL base58_encode");
        process_exit(1);
    }
    let dec_r: Result[String, String] = base58_decode("JxF12TrwUP45BMd");
    if dec_r.is_err() {
        println("FAIL base58_decode err");
        process_exit(1);
    }
    let dec: String = dec_r.unwrap();
    if dec != "Hello World" {
        println("FAIL base58_decode");
        process_exit(1);
    }
    println("prod_base58: PASSED");
}
