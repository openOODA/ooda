// # Product prove std/telecom_5g/channel_doppler_jakes.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/channel_doppler_jakes.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_doppler_jakes.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_channel_doppler_jakes: PASSED only if they match.

import "std/telecom_5g/channel_doppler_jakes.oo";

pub fn main() {
    let channel_doppler_jakes_a = channel_jakes_oscillator_phase(0, 0, 0.0, 0.0);
    let channel_doppler_jakes_b = channel_jakes_oscillator_phase(0, 0, 0.0, 0.0);
    if channel_doppler_jakes_a != channel_doppler_jakes_b {
        println("FAIL channel_doppler_jakes");
        process_exit(1);
    }
    println("prod_ap_channel_doppler_jakes: PASSED");
}
