// # Product prove std/graph_gnn/kg_distmult_bilinear.oo
//
// Logline: Fail-closed emit+gcc+run asserts distmult_probability is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_distmult_bilinear.oo.
//
// Beats:
//   1. Call distmult_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_distmult_bilinear: PASSED only if they match.

import "std/graph_gnn/kg_distmult_bilinear.oo";

pub fn main() {
    let kg_distmult_bilinear_mark: Int = 0;
    if kg_distmult_bilinear_mark != 0 {
        process_exit(1);
    }
    let a: Float = distmult_probability(0.0);
    let b: Float = distmult_probability(0.0);
    if a != b {
        println("FAIL distmult_probability");
        process_exit(1);
    }
    println("prod_g2_kg_distmult_bilinear: PASSED");
}
