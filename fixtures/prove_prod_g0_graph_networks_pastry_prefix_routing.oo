// # Product prove std/graph_networks/pastry_prefix_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts pastry_pow is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/pastry_prefix_routing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pastry_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_pastry_prefix_routing: PASSED only if they match.

import "std/graph_networks/pastry_prefix_routing.oo";

pub fn main() {
    let g0_a = pastry_pow(2, 2);
    let g0_b = pastry_pow(2, 2);
    if g0_a != g0_b {
        println("FAIL pastry_pow");
        process_exit(1);
    }
    println("prod_g0_pastry_prefix_routing: PASSED");
}
