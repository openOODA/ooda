// # Product prove std/compilers_polyhedral/polyhedral_transitive_closure.oo
//
// Logline: Fail-closed emit+gcc+run asserts closure_is_point_reachable is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_transitive_closure.oo.
//
// Beats:
//   1. Call closure_is_point_reachable twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_transitive_closure: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_transitive_closure.oo";

pub fn main() {
    let obj_a: DependenceClosureRelation = dependence_closure_new(0, 0, 0);
    let obj_b: DependenceClosureRelation = dependence_closure_new(0, 0, 0);
    let a: Int = closure_is_point_reachable(obj_a, 0, 0, 0, 0);
    let b: Int = closure_is_point_reachable(obj_b, 0, 0, 0, 0);
    if a != b {
        println("FAIL closure_is_point_reachable");
        process_exit(1);
    }
    println("prod_polyhedral_transitive_closure: PASSED");
}
