// # Product prove std/bio/phylo_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts calculate_p_distance is a real value.
//
// Setup: Isolated emit-c. Imports std/bio/phylo_engine.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call calculate_p_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_phylo_engine: PASSED only if they match.

import "std/bio/phylo_engine.oo";

pub fn main() {
    let g0_a = calculate_p_distance("x", "x");
    let g0_b = calculate_p_distance("x", "x");
    if g0_a != g0_b {
        println("FAIL calculate_p_distance");
        process_exit(1);
    }
    println("prod_gr_phylo_engine: PASSED");
}
