// # Patch replace_fn on add
//
// Logline: A pass-rail add function is the target for ooda patch replace_fn.
//
// Beats:
//   1. Publish add as the replaceable function.
//   2. Call add(20, 22) from main.
//   3. Print 42 so the post-patch smoke can rematch.

// Fixture for ooda patch replace_fn (pass rail).
pub fn add(a: Int, b: Int) -> Int {
    return a + b;
}

pub fn main() {
    let x = add(20, 22);
    println(x);
}
