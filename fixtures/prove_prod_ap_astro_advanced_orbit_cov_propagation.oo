// # Product prove std/astro_advanced/orbit_cov_propagation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/orbit_cov_propagation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/orbit_cov_propagation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbit_cov_propagation: PASSED only if they match.

import "std/astro_advanced/orbit_cov_propagation.oo";

pub fn main() {
    let orbit_cov_propagation_a = cov_trace();
    let orbit_cov_propagation_b = cov_trace();
    if orbit_cov_propagation_a != orbit_cov_propagation_b {
        println("FAIL orbit_cov_propagation");
        process_exit(1);
    }
    println("prod_ap_orbit_cov_propagation: PASSED");
}
