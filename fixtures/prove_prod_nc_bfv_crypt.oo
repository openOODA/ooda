// # Product prove std/sec/crypto/bfv_crypt.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_crypt_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_crypt.oo.
//
// Beats:
//   1. Call bfv_crypt_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bfv_crypt: PASSED only if it matches.

import "std/sec/crypto/bfv_crypt.oo";

pub fn main() {
    let a: Int = bfv_crypt_probe();
    if a != 0 {
        println("FAIL bfv_crypt_probe");
        process_exit(1);
    }
    println("prod_nc_bfv_crypt: PASSED");
}
