// # Product prove std/tda_topology/persistence_landscape_features.oo
//
// Logline: Fail-closed emit+gcc+run asserts landscape_tent_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistence_landscape_features.oo.
//
// Beats:
//   1. Call landscape_tent_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistence_landscape_features: PASSED only if they match.

import "std/tda_topology/persistence_landscape_features.oo";

pub fn main() {
    let persistence_landscape_features_mark: Int = 0;
    if persistence_landscape_features_mark != 0 {
        process_exit(1);
    }
    let persistence_landscape_features_a: Float = landscape_tent_eval(1.0, 1.0, 1.0);
    let persistence_landscape_features_b: Float = landscape_tent_eval(1.0, 1.0, 1.0);
    if persistence_landscape_features_a != persistence_landscape_features_b {
        println("FAIL landscape_tent_eval");
        process_exit(1);
    }
    println("prod_persistence_landscape_features: PASSED");
}
