// # Product prove std/satellite_dvb/satellite_itu_p618_rain.oo
//
// Logline: Fail-closed emit+gcc+run asserts rain_calc_specific_attenuation_db_km is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_itu_p618_rain.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rain_calc_specific_attenuation_db_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_itu_p618_rain: PASSED only if they match.

import "std/satellite_dvb/satellite_itu_p618_rain.oo";

pub fn main() {
    let g2_a = rain_calc_specific_attenuation_db_km(1.0, 1.0);
    let g2_b = rain_calc_specific_attenuation_db_km(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL rain_calc_specific_attenuation_db_km");
        process_exit(1);
    }
    println("prod_g2_satellite_itu_p618_rain: PASSED");
}
