// # Product prove std/digital_twin/dae_consistent_initialization.oo
//
// Logline: Fail-closed emit+gcc+run asserts dae_consistent_initialization_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/dae_consistent_initialization.oo.
//
// Beats:
//   1. Call dae_consistent_initialization_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_dae_consistent_initialization: PASSED only if it matches.

import "std/digital_twin/dae_consistent_initialization.oo";

pub fn main() {
    let a: Int = dae_consistent_initialization_probe();
    if a != 0 {
        println("FAIL dae_consistent_initialization_probe");
        process_exit(1);
    }
    println("prod_nc_dae_consistent_initialization: PASSED");
}
