// # Product prove std/bioinformatics/hmm_profile.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/hmm_profile.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/hmm_profile.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hmm_profile: PASSED only if they match.

import "std/bioinformatics/hmm_profile.oo";

pub fn main() {
    let hmm_profile_a = hmm_viterbi_step_score(0, 0, 0);
    let hmm_profile_b = hmm_viterbi_step_score(0, 0, 0);
    if hmm_profile_a != hmm_profile_b {
        println("FAIL hmm_profile");
        process_exit(1);
    }
    println("prod_ap_hmm_profile: PASSED");
}
