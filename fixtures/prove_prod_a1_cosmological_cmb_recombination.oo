// # Product prove std/astrophysics_relativity/cosmological_cmb_recombination.oo
//
// Logline: Fail-closed emit+gcc+run asserts cmb_temperature_k is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_cmb_recombination.oo.
//
// Beats:
//   1. Call cmb_temperature_k twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cosmological_cmb_recombination: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_cmb_recombination.oo";

pub fn main() {
    let cosmological_cmb_recombination_mark: Int = 0;
    if cosmological_cmb_recombination_mark != 0 {
        process_exit(1);
    }
    let a: Float = cmb_temperature_k(0.0);
    let b: Float = cmb_temperature_k(0.0);
    if a != b {
        println("FAIL cmb_temperature_k");
        process_exit(1);
    }
    println("prod_cosmological_cmb_recombination: PASSED");
}
