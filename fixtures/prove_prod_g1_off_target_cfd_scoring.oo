// # Product prove std/crispr_cas/off_target_cfd_scoring.oo
//
// Logline: Fail-closed emit+gcc+run asserts cfd_score_alignment is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/off_target_cfd_scoring.oo.
//
// Beats:
//   1. Call cfd_score_alignment twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_off_target_cfd_scoring: PASSED only if they match.

import "std/crispr_cas/off_target_cfd_scoring.oo";

pub fn main() {
    let a: CfdOffTargetScore = cfd_score_alignment("x", "x");
    let b: CfdOffTargetScore = cfd_score_alignment("x", "x");
    if a.mismatch_count != b.mismatch_count {
        println("FAIL cfd_score_alignment");
        process_exit(1);
    }
    println("prod_off_target_cfd_scoring: PASSED");
}
