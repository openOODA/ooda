// # Product prove std/fintech_l3_book/l3_queue_priority_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts queue_priority_position_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_queue_priority_tracker.oo.
//
// Beats:
//   1. Call queue_priority_position_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_queue_priority_tracker: PASSED only if they match.

import "std/fintech_l3_book/l3_queue_priority_tracker.oo";

pub fn main() {
    let l3_queue_priority_tracker_mark: Int = 0;
    if l3_queue_priority_tracker_mark != 0 {
        process_exit(1);
    }
    let a: QueuePriorityPosition = queue_priority_position_new(0, 0, 0, 0, 0);
    let b: QueuePriorityPosition = queue_priority_position_new(0, 0, 0, 0, 0);
    if (a).order_id != (b).order_id {
        println("FAIL queue_priority_position_new");
        process_exit(1);
    }
    println("prod_l3_queue_priority_tracker: PASSED");
}
