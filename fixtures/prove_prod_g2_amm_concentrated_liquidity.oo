// # Product prove std/fintech_defi/amm_concentrated_liquidity.oo
//
// Logline: Fail-closed emit+gcc+run asserts cl_get_amount_0_delta is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_concentrated_liquidity.oo.
//
// Beats:
//   1. Call cl_get_amount_0_delta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_amm_concentrated_liquidity: PASSED only if they match.

import "std/fintech_defi/amm_concentrated_liquidity.oo";

pub fn main() {
    let amm_concentrated_liquidity_mark: Int = 0;
    if amm_concentrated_liquidity_mark != 0 {
        process_exit(1);
    }
    let a: Int = cl_get_amount_0_delta(0, 0, 0);
    let b: Int = cl_get_amount_0_delta(0, 0, 0);
    if a != b {
        println("FAIL cl_get_amount_0_delta");
        process_exit(1);
    }
    println("prod_g2_amm_concentrated_liquidity: PASSED");
}
