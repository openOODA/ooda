// # Product prove std/iot_scada/modbus_gateway_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_gateway_matches_route is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/modbus_gateway_router.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call modbus_gateway_matches_route twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_modbus_gateway_router: PASSED only if they match.

import "std/iot_scada/modbus_gateway_router.oo";

pub fn main() {
    let g0_oa: ModbusGatewayRoute = ModbusGatewayRoute { unit_id_min: 0, unit_id_max: 0, serial_port_id: 0, baud_rate: 0, timeout_ms: 0 };
    let g0_ob: ModbusGatewayRoute = ModbusGatewayRoute { unit_id_min: 0, unit_id_max: 0, serial_port_id: 0, baud_rate: 0, timeout_ms: 0 };
    let g0_a = modbus_gateway_matches_route(&g0_oa, 0);
    let g0_b = modbus_gateway_matches_route(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL modbus_gateway_matches_route");
        process_exit(1);
    }
    println("prod_gr_modbus_gateway_router: PASSED");
}
