// # Product prove std/telecom/crc_radio.oo
//
// Logline: Fail-closed emit+gcc+run asserts crc_radio_spec_crc11_nr value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom/crc_radio.oo.
//
// Beats:
//   1. Call crc_radio_spec_crc11_nr twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_crc_radio: PASSED only if asserts hold.

import "std/telecom/crc_radio.oo";

pub fn main() {
    let crc_radio = crc_radio_spec_crc11_nr();
    let crc_radio_b = crc_radio_spec_crc11_nr();
    if crc_radio.width_bits != 11 {
        println("FAIL crc_radio_spec_crc11_nr width_bits");
        process_exit(1);
    }
    if crc_radio.width_bits != crc_radio_b.width_bits {
        println("FAIL crc_radio_spec_crc11_nr det");
        process_exit(1);
    }
    println("prod_crc_radio: PASSED");
}
