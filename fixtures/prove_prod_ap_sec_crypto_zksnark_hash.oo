// # Product prove std/sec/crypto/zksnark_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/zksnark_hash.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_hash.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zksnark_hash: PASSED only if they match.

import "std/sec/crypto/zksnark_hash.oo";

pub fn main() {
    let zksnark_hash_a = zksnark_calculate_string_hash("x");
    let zksnark_hash_b = zksnark_calculate_string_hash("x");
    if zksnark_hash_a != zksnark_hash_b {
        println("FAIL zksnark_hash");
        process_exit(1);
    }
    println("prod_ap_zksnark_hash: PASSED");
}
