// # Product prove std/db_columnar/arrow_ipc_stream_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts arrow_ipc_decode_framing is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_ipc_stream_reader.oo.
//
// Beats:
//   1. Call arrow_ipc_decode_framing twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arrow_ipc_stream_reader: PASSED only if they match.

import "std/db_columnar/arrow_ipc_stream_reader.oo";

pub fn main() {
    let arrow_ipc_stream_reader_mark: Int = 0;
    if arrow_ipc_stream_reader_mark != 0 {
        process_exit(1);
    }
    let a: Int = arrow_ipc_decode_framing(0);
    let b: Int = arrow_ipc_decode_framing(0);
    if a != b {
        println("FAIL arrow_ipc_decode_framing");
        process_exit(1);
    }
    println("prod_arrow_ipc_stream_reader: PASSED");
}
