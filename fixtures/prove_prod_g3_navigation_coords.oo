// # Product prove std/aero/navigation_coords.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_coord_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_coords.oo.
//
// Beats:
//   1. Call nav_coord_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_navigation_coords: PASSED only if they match.

import "std/aero/navigation_coords.oo";

pub fn main() {
    let navigation_coords_mark: Int = 0;
    if navigation_coords_mark != 0 {
        process_exit(1);
    }
    let a: NavCoord = nav_coord_new(0, 0);
    let b: NavCoord = nav_coord_new(0, 0);
    if (a).lat_milli != (b).lat_milli {
        println("FAIL nav_coord_new");
        process_exit(1);
    }
    println("prod_navigation_coords: PASSED");
}
