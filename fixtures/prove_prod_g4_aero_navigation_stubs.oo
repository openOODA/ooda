// # Product prove std/aero/navigation_stubs.oo
//
// Logline: Fail-closed verification that navigation hardware receiver and IMU stub interfaces are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_stubs.oo.
//
// Beats:
//   1. Verify navigation engine marker and constructor.
//   2. Call nav_init and nav_do_work on Navigation objects.
//   3. Assert deterministic return values.
//   4. Print prod_g4_aero_navigation_stubs: PASSED and exit 0.

import "std/aero/navigation_stubs.oo";

pub fn main() {
    let navigation_stubs_mark: Int = 0;
    if navigation_stubs_mark != 0 {
        process_exit(1);
    }

    let m_a: Int = navigation_engine_marker();
    let m_b: Int = navigation_engine_marker();
    if m_a != m_b {
        println("FAIL navigation_engine_marker");
        process_exit(1);
    }

    let n1: Navigation = nav_init();
    let n2: Navigation = nav_init();

    let len1: Int = nav_do_work(&n1);
    let len2: Int = nav_do_work(&n2);
    if len1 != len2 {
        println("FAIL nav_do_work");
        process_exit(1);
    }

    if (n1).len != (n2).len || (n1).ptr != (n2).ptr {
        println("FAIL Navigation fields");
        process_exit(1);
    }

    println("prod_g4_aero_navigation_stubs: PASSED");
    process_exit(0);
}
