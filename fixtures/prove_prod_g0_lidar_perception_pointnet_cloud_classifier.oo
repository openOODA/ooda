// # Product prove std/lidar_perception/pointnet_cloud_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts relu_activation is a real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/pointnet_cloud_classifier.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call relu_activation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_pointnet_cloud_classifier: PASSED only if they match.

import "std/lidar_perception/pointnet_cloud_classifier.oo";

pub fn main() {
    let g0_a = relu_activation(1.0);
    let g0_b = relu_activation(1.0);
    if g0_a != g0_b {
        println("FAIL relu_activation");
        process_exit(1);
    }
    println("prod_g0_pointnet_cloud_classifier: PASSED");
}
