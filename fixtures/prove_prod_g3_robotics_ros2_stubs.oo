// # Product prove std/robotics_ros2/robotics_ros2_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts robotics_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/robotics_ros2_stubs.oo.
//
// Beats:
//   1. Call robotics_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_robotics_ros2_stubs: PASSED only if they match.

import "std/robotics_ros2/robotics_ros2_stubs.oo";

pub fn main() {
    let robotics_ros2_stubs_mark: Int = 0;
    if robotics_ros2_stubs_mark != 0 {
        process_exit(1);
    }
    let a: RoboticsHardwareCapabilities = robotics_capabilities_default();
    let b: RoboticsHardwareCapabilities = robotics_capabilities_default();
    if (a).max_joints != (b).max_joints {
        println("FAIL robotics_capabilities_default");
        process_exit(1);
    }
    println("prod_robotics_ros2_stubs: PASSED");
}
