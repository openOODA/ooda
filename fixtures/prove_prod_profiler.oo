// # Product prove std/perf/profiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts profiler_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/profiler.oo.
//
// Beats:
//   1. Call profiler_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_profiler: PASSED only if they match.

import "std/perf/profiler.oo";

pub fn main() {
    let profiler_mark: Int = 0;
    if profiler_mark != 0 {
        process_exit(1);
    }
    let a: Profiler = profiler_create("x");
    let b: Profiler = profiler_create("x");
    if (a).total_entries != (b).total_entries {
        println("FAIL profiler_create");
        process_exit(1);
    }
    println("prod_profiler: PASSED");
}
