// # Product prove std/astrophysics_relativity/stellar_supernova_lightcurve.oo
//
// Logline: Fail-closed verification that supernova radioactive decay heating and Arnett diffusion light curves are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_supernova_lightcurve.oo.
//
// Beats:
//   1. Compute Nickel-56 and Cobalt-56 radioactive heating rate.
//   2. Compute Arnett bolometric and solar luminosities at post-explosion epoch.
//   3. Assert deterministic light curve point metrics.
//   4. Print prod_g4_astrophys_supernova: PASSED and exit 0.

import "std/astrophysics_relativity/stellar_supernova_lightcurve.oo";

pub fn main() {
    let stellar_supernova_lightcurve_mark: Int = 0;
    if stellar_supernova_lightcurve_mark != 0 {
        process_exit(1);
    }

    let q_heat_a: Float = supernova_nickel_heating_rate(0.6, 15.0);
    let q_heat_b: Float = supernova_nickel_heating_rate(0.6, 15.0);
    if q_heat_a != q_heat_b || q_heat_a <= 0.0 {
        println("FAIL supernova_nickel_heating_rate");
        process_exit(1);
    }

    let pt_a: SupernovaLightCurvePoint = supernova_arnett_luminosity(0.6, 1.4, 1.0, 15.0);
    let pt_b: SupernovaLightCurvePoint = supernova_arnett_luminosity(0.6, 1.4, 1.0, 15.0);

    if (pt_a).luminosity_bolometric_w != (pt_b).luminosity_bolometric_w || (pt_a).luminosity_bolometric_w <= 0.0 {
        println("FAIL supernova_arnett_luminosity luminosity_bolometric_w");
        process_exit(1);
    }

    if (pt_a).luminosity_solar != (pt_b).luminosity_solar || (pt_a).luminosity_solar <= 0.0 {
        println("FAIL supernova_arnett_luminosity luminosity_solar");
        process_exit(1);
    }

    if (pt_a).effective_temperature_k != (pt_b).effective_temperature_k || (pt_a).effective_temperature_k <= 0.0 {
        println("FAIL supernova_arnett_luminosity effective_temperature_k");
        process_exit(1);
    }

    println("prod_g4_astrophys_supernova: PASSED");
    process_exit(0);
}
