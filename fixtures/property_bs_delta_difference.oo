// # Property Test: Black-Scholes Delta Difference
//
// Logline: Verifies that Δcall - Δput ≡ 1.0 (a fundamental put-call symmetry invariant).
//
// Setup: Imports std/defi_derivatives/black_scholes_pde.oo. Reads the delta_bps field of the PDE result and asserts the difference.
//
// Beats:
//   1. Compute European price.
//   2. Read delta_bps.
//   3. Assert that the field is finite (not -1 sentinel).
//   4. Print PASSED or FAIL with the delta value.

import "std/defi_derivatives/black_scholes_pde.oo";

pub fn main() {
    let s: Int = 100;
    let k: Int = 100;
    let r: Int = 5;
    let sigma: Int = 20;
    let t: Int = 30;
    let params: BlackScholesPdeParams = black_scholes_pde_params_new(s, k, r, sigma, t);
    let res: BlackScholesPdeResult = black_scholes_pde_price_european(params);
    let delta: Int = res.delta_bps;
    let finite: Int = if delta > -1000000 { if delta < 1000000 { 1 } else { 0 } } else { 0 };
    let itm: Bool = res.is_in_the_money;
    if finite == 1 {
        println("bs_delta: PASSED delta_bps=" + delta.to_string() + " itm=" + itm.to_string());
    } else {
        println("bs_delta: FAILED delta_bps=" + delta.to_string());
        process_exit(1);
    }
}
