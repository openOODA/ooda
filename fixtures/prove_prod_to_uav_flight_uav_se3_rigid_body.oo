// # Product prove std/uav_flight/uav_se3_rigid_body.oo
//
// Logline: Fail-closed emit+gcc+run asserts tf_identity holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_se3_rigid_body.oo.
//
// Beats:
//   1. Call tf_identity using the uav_se3_rigid_body ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_uav_se3_rigid_body: PASSED only if asserts hold.

import "std/uav_flight/uav_se3_rigid_body.oo";

pub fn main() {
    let obj = tf_identity();
    let uav_se3_rigid_body_a = obj.r00;
    if uav_se3_rigid_body_a != 1.0 {
        println("FAIL tf_identity");
        process_exit(1);
    }
    println("prod_uav_se3_rigid_body: PASSED");
}
