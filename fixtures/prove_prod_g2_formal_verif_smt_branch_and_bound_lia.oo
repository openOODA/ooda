// # Product prove std/formal_verif/smt_branch_and_bound_lia.oo
//
// Logline: Fail-closed emit+gcc+run asserts lia_is_integral is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/smt_branch_and_bound_lia.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call lia_is_integral twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_smt_branch_and_bound_lia: PASSED only if they match.

import "std/formal_verif/smt_branch_and_bound_lia.oo";

pub fn main() {
    let g2_a = lia_is_integral(2, 2);
    let g2_b = lia_is_integral(2, 2);
    if g2_a != g2_b {
        println("FAIL lia_is_integral");
        process_exit(1);
    }
    println("prod_g2_smt_branch_and_bound_lia: PASSED");
}
