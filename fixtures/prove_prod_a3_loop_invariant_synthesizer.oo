// # Product prove std/formal_verif/loop_invariant_synthesizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts verify_invariant_initiation is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/loop_invariant_synthesizer.oo.
//
// Beats:
//   1. Call verify_invariant_initiation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_loop_invariant_synthesizer: PASSED only if they match.

import "std/formal_verif/loop_invariant_synthesizer.oo";

pub fn main() {
    let loop_invariant_synthesizer_mark: Int = 0;
    if loop_invariant_synthesizer_mark != 0 {
        process_exit(1);
    }
    let a: Bool = verify_invariant_initiation(0, 0);
    let b: Bool = verify_invariant_initiation(0, 0);
    if a != b {
        println("FAIL verify_invariant_initiation");
        process_exit(1);
    }
    println("prod_loop_invariant_synthesizer: PASSED");
}
