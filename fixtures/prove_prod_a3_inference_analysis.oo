// # Product prove std/edge/inference_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts inference_select_optimal_backend is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_analysis.oo.
//
// Beats:
//   1. Call inference_select_optimal_backend twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_inference_analysis: PASSED only if they match.

import "std/edge/inference_analysis.oo";

pub fn main() {
    let inference_analysis_mark: Int = 0;
    if inference_analysis_mark != 0 {
        process_exit(1);
    }
    let a: Int = inference_select_optimal_backend(0, 0);
    let b: Int = inference_select_optimal_backend(0, 0);
    if a != b {
        println("FAIL inference_select_optimal_backend");
        process_exit(1);
    }
    println("prod_inference_analysis: PASSED");
}
