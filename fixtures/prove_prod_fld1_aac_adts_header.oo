// # Product prove std/media_dsp/aac_adts_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts aac_lookup_sampling_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/aac_adts_header.oo.
//
// Beats:
//   1. Call aac_lookup_sampling_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aac_adts_header: PASSED only if they match.

import "std/media_dsp/aac_adts_header.oo";

pub fn main() {
    let aac_adts_header_mark: Int = 0;
    if aac_adts_header_mark != 0 {
        process_exit(1);
    }
    let aac_adts_header_a: Int = aac_lookup_sampling_rate(1);
    let aac_adts_header_b: Int = aac_lookup_sampling_rate(1);
    if aac_adts_header_a != aac_adts_header_b {
        println("FAIL aac_lookup_sampling_rate");
        process_exit(1);
    }
    println("prod_aac_adts_header: PASSED");
}
