// # Product prove std/exploit_analysis/rop_gadget_finder.oo
//
// Logline: Fail-closed emit+gcc+run asserts candidate_gadget_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/rop_gadget_finder.oo.
//
// Beats:
//   1. Call candidate_gadget_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rop_gadget_finder: PASSED only if they match.

import "std/exploit_analysis/rop_gadget_finder.oo";

pub fn main() {
    let rop_gadget_finder_mark: Int = 0;
    if rop_gadget_finder_mark != 0 {
        process_exit(1);
    }
    let a: CandidateGadget = candidate_gadget_new(0, 0, "x", "x", 0);
    let b: CandidateGadget = candidate_gadget_new(0, 0, "x", "x", 0);
    if (a).address != (b).address {
        println("FAIL candidate_gadget_new");
        process_exit(1);
    }
    println("prod_g2_rop_gadget_finder: PASSED");
}
