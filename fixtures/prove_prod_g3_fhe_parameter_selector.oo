// # Product prove std/fhe_lattices/fhe_parameter_selector.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_param_toy_test is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_parameter_selector.oo.
//
// Beats:
//   1. Call fhe_param_toy_test twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_parameter_selector: PASSED only if they match.

import "std/fhe_lattices/fhe_parameter_selector.oo";

pub fn main() {
    let fhe_parameter_selector_mark: Int = 0;
    if fhe_parameter_selector_mark != 0 {
        process_exit(1);
    }
    let a: FheParameterSet = fhe_param_toy_test();
    let b: FheParameterSet = fhe_param_toy_test();
    if (a).ring_degree_n != (b).ring_degree_n {
        println("FAIL fhe_param_toy_test");
        process_exit(1);
    }
    println("prod_fhe_parameter_selector: PASSED");
}
