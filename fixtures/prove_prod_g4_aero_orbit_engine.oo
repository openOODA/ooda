// # Product prove std/aero/orbit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts orbital mechanics and Hohmann transfer calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_engine.oo.
//
// Beats:
//   1. Call orbit_engine_marker, calculate_hohmann_transfer, and calculate_inclination_change_dv.
//   2. Propagate Keplerian orbit state.
//   3. Assert deterministic outputs.
//   4. Print prod_g4_aero_orbit_engine: PASSED only if all match.

import "std/aero/orbit_engine.oo";

pub fn main() {
    let m: Int = orbit_engine_marker();
    if m != 1 {
        println("FAIL orbit_engine_marker");
        process_exit(1);
    }

    let mu: Float = 398600441800000.0;
    let r1: Float = 7000000.0;
    let r2: Float = 42000000.0;

    let hohmann_a: HohmannTransfer = calculate_hohmann_transfer(r1, r2, mu);
    let hohmann_b: HohmannTransfer = calculate_hohmann_transfer(r1, r2, mu);
    if (hohmann_a).total_delta_v != (hohmann_b).total_delta_v {
        println("FAIL calculate_hohmann_transfer");
        process_exit(1);
    }
    if (hohmann_a).total_delta_v <= 0.0 {
        println("FAIL total_delta_v value");
        process_exit(1);
    }

    let dv_inc_a: Float = calculate_inclination_change_dv(7500.0, 0.1);
    let dv_inc_b: Float = calculate_inclination_change_dv(7500.0, 0.1);
    if dv_inc_a != dv_inc_b || dv_inc_a <= 0.0 {
        println("FAIL calculate_inclination_change_dv");
        process_exit(1);
    }

    let elem: KeplerianElements = keplerian_new(7000000.0, 0.001, 0.5, 0.0, 0.0, 0.0);
    let prop: KeplerianElements = propagate_kepler(elem, 100.0, mu);
    if (prop).semi_major_axis != 7000000.0 {
        println("FAIL propagate_kepler semi_major_axis");
        process_exit(1);
    }

    println("prod_g4_aero_orbit_engine: PASSED");
    process_exit(0);
}
