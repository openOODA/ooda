// # Product prove std/iot_scada/ethercat_mailbox_coe.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_mailbox_coe_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_mailbox_coe.oo.
//
// Beats:
//   1. Call ethercat_mailbox_coe_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ethercat_mailbox_coe: PASSED only if they match.

import "std/iot_scada/ethercat_mailbox_coe.oo";

pub fn main() {
    let a: Int = ethercat_mailbox_coe_probe();
    let b: Int = ethercat_mailbox_coe_probe();
    if a != b {
        println("FAIL ethercat_mailbox_coe_probe");
        process_exit(1);
    }
    println("prod_g2_ethercat_mailbox_coe: PASSED");
}
