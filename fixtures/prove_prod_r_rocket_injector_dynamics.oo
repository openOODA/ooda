// # Product prove std/space_propulsion/rocket_injector_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts injector_coaxial_swirl_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_injector_dynamics.oo.
//
// Beats:
//   1. Call injector_coaxial_swirl_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rocket_injector_dynamics: PASSED only if asserts hold.

import "std/space_propulsion/rocket_injector_dynamics.oo";

pub fn main() {
    let rocket_injector_dynamics: InjectorElement = injector_coaxial_swirl_default();
    let rocket_injector_dynamics_b: InjectorElement = injector_coaxial_swirl_default();
    if (rocket_injector_dynamics).element_type != 1 {
        println("FAIL injector_coaxial_swirl_default element_type");
        process_exit(1);
    }
    if (rocket_injector_dynamics).element_type != (rocket_injector_dynamics_b).element_type {
        println("FAIL injector_coaxial_swirl_default det");
        process_exit(1);
    }
    println("prod_rocket_injector_dynamics: PASSED");
}
