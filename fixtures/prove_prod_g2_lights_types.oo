// # Product prove std/3d/lights_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_color_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights_types.oo.
//
// Beats:
//   1. Call light_color_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lights_types: PASSED only if they match.

import "std/3d/lights_types.oo";

pub fn main() {
    let lights_types_mark: Int = 0;
    if lights_types_mark != 0 {
        process_exit(1);
    }
    let a: LightColor = light_color_new(0, 0, 0, 0);
    let b: LightColor = light_color_new(0, 0, 0, 0);
    if (a).r != (b).r {
        println("FAIL light_color_new");
        process_exit(1);
    }
    println("prod_g2_lights_types: PASSED");
}
