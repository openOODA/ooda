// # Product prove std/fintech_l3_book/itch_ouch_roundtrip_latency.oo
//
// Logline: Fail-closed emit+gcc+run asserts roundtrip_latency_record_new real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/itch_ouch_roundtrip_latency.oo.
//
// Beats:
//   1. Call roundtrip_latency_record_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_itch_ouch_roundtrip_latency: PASSED only if the assert holds.

import "std/fintech_l3_book/itch_ouch_roundtrip_latency.oo";

pub fn main() {
    let itch_ouch_roundtrip_latency_mark: Int = 0;
    if itch_ouch_roundtrip_latency_mark != 0 {
        process_exit(1);
    }
    let itch_ouch_roundtrip_latency_a: RoundtripLatencyRecord = roundtrip_latency_record_new(7, 7, 7);
    let itch_ouch_roundtrip_latency_market_event_ts_ns: Int = (itch_ouch_roundtrip_latency_a).market_event_ts_ns;
    if itch_ouch_roundtrip_latency_market_event_ts_ns != 7 {
        println("FAIL roundtrip_latency_record_new");
        process_exit(1);
    }
    println("prod_itch_ouch_roundtrip_latency: PASSED");
}
