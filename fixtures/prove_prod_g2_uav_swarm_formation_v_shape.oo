// # Product prove std/uav_flight/uav_swarm_formation_v_shape.oo
//
// Logline: Fail-closed emit+gcc+run asserts v_formation_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_swarm_formation_v_shape.oo.
//
// Beats:
//   1. Call v_formation_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_swarm_formation_v_shape: PASSED only if they match.

import "std/uav_flight/uav_swarm_formation_v_shape.oo";

pub fn main() {
    let uav_swarm_formation_v_shape_mark: Int = 0;
    if uav_swarm_formation_v_shape_mark != 0 {
        process_exit(1);
    }
    let a: VFormationParams = v_formation_params_default();
    let b: VFormationParams = v_formation_params_default();
    if (a).apex_angle_rad != (b).apex_angle_rad {
        println("FAIL v_formation_params_default");
        process_exit(1);
    }
    println("prod_g2_uav_swarm_formation_v_shape: PASSED");
}
