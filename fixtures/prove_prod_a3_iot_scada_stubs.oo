// # Product prove std/iot_scada/iot_scada_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts scada_stub_rs485_set_direction_tx is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/iot_scada_stubs.oo.
//
// Beats:
//   1. Call scada_stub_rs485_set_direction_tx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_iot_scada_stubs: PASSED only if they match.

import "std/iot_scada/iot_scada_stubs.oo";

pub fn main() {
    let iot_scada_stubs_mark: Int = 0;
    if iot_scada_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = scada_stub_rs485_set_direction_tx(0);
    let b: Bool = scada_stub_rs485_set_direction_tx(0);
    if a != b {
        println("FAIL scada_stub_rs485_set_direction_tx");
        process_exit(1);
    }
    println("prod_iot_scada_stubs: PASSED");
}
