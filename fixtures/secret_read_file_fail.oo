// # Refuse a secret read_file path
//
// Logline: A tagged name must not be used as the read_file path.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the path.
//   3. Expect the sink to refuse.

// M141: Secret must not be used as read_file path
// SECRET: token
pub fn main(fs: &FsCap) {
    let token = "/tmp/secret-path";
    let r = read_file(fs, token);
    println(1);
}
