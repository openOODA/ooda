// # Product prove std/web_protocols/oauth2_pkce.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_protocols/oauth2_pkce.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/oauth2_pkce.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_oauth2_pkce: PASSED only if they match.

import "std/web_protocols/oauth2_pkce.oo";

pub fn main() {
    let oauth2_pkce_a = pkce_is_valid_char(0);
    let oauth2_pkce_b = pkce_is_valid_char(0);
    if oauth2_pkce_a != oauth2_pkce_b {
        println("FAIL oauth2_pkce");
        process_exit(1);
    }
    println("prod_ap_oauth2_pkce: PASSED");
}
