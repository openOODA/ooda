// # Product prove std/auto/fusion_kalman.oo
//
// Logline: Fail-closed verification that multi-sensor Extended Kalman Filter prediction, update, and gating metrics are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_kalman.oo.
//
// Beats:
//   1. Propagate target state with EKF kinematic prediction step.
//   2. Compute Euclidean and Mahalanobis data association gating distances.
//   3. Correct track state estimate with measurement update step.
//   4. Print prod_g4_auto_fusion_kalman: PASSED and exit 0.

import "std/auto/fusion_kalman.oo";

pub fn main() {
    let fusion_kalman_mark: Int = 0;
    if fusion_kalman_mark != 0 {
        process_exit(1);
    }

    let p_pred_a: Float = kalman_predict_pos(10.0, 15.0, 0.0, 0.1);
    let p_pred_b: Float = kalman_predict_pos(10.0, 15.0, 0.0, 0.1);
    if p_pred_a != p_pred_b || p_pred_a <= 10.0 {
        println("FAIL kalman_predict_pos");
        process_exit(1);
    }

    let k_gain_a: Float = kalman_gain(1.0, 0.1);
    let k_gain_b: Float = kalman_gain(1.0, 0.1);
    if k_gain_a != k_gain_b || k_gain_a <= 0.0 {
        println("FAIL kalman_gain");
        process_exit(1);
    }

    let pos1: Vec3 = vec3_new(10.0, 5.0, 0.0);
    let pos2: Vec3 = vec3_new(11.5, 5.0, 0.0);
    let cov1: Vec3 = vec3_new(1.0, 1.0, 1.0);

    let euc_a: Float = compute_euclidean_distance(pos1, pos2);
    let euc_b: Float = compute_euclidean_distance(pos1, pos2);
    if euc_a != euc_b || euc_a <= 0.0 {
        println("FAIL compute_euclidean_distance");
        process_exit(1);
    }

    let mah_a: Float = compute_mahalanobis_distance(pos1, pos2, cov1, 0.1);
    let mah_b: Float = compute_mahalanobis_distance(pos1, pos2, cov1, 0.1);
    if mah_a != mah_b || mah_a <= 0.0 {
        println("FAIL compute_mahalanobis_distance");
        process_exit(1);
    }

    let cfg: FusionConfig = FusionConfig {
        max_tracks: 100,
        gating_threshold_m: 5.0,
        confirmation_threshold_hits: 3,
        deletion_threshold_misses: 5,
        process_noise_pos: 0.1,
        process_noise_vel: 0.1,
        default_lidar_noise: 0.05,
        default_radar_noise: 0.1,
        default_camera_noise: 0.2,
    };

    let trk: TrackedObject = TrackedObject {
        id: 1,
        track_state: 0,
        class_label: 1,
        position: pos1,
        velocity: vec3_new(15.0, 0.0, 0.0),
        acceleration: vec3_new(0.0, 0.0, 0.0),
        size: vec3_new(4.5, 2.0, 1.5),
        heading: 0.0,
        yaw_rate: 0.0,
        pos_covariance: cov1,
        vel_covariance: cov1,
        confidence: 0.5,
        age_ticks: 1,
        hits: 1,
        misses: 0,
        last_update_time_s: 0.0,
        is_active: true,
    };

    let meas: SensorMeasurement = SensorMeasurement {
        id: 1,
        sensor_id: 1,
        sensor_type: 1,
        position: pos2,
        velocity: vec3_zero(),
        covariance_pos: 0.1,
        covariance_vel: 0.5,
        confidence: 0.9,
        class_label: 1,
        timestamp_s: 0.1,
        is_valid: true,
    };

    let pred_trk_a: TrackedObject = kalman_predict_step(trk, 0.1, cfg);
    let pred_trk_b: TrackedObject = kalman_predict_step(trk, 0.1, cfg);

    if ((pred_trk_a).position).x != ((pred_trk_b).position).x {
        println("FAIL kalman_predict_step");
        process_exit(1);
    }

    let upd_trk_a: TrackedObject = kalman_update_step(pred_trk_a, meas, cfg);
    let upd_trk_b: TrackedObject = kalman_update_step(pred_trk_b, meas, cfg);

    if ((upd_trk_a).position).x != ((upd_trk_b).position).x || (upd_trk_a).hits != (upd_trk_b).hits {
        println("FAIL kalman_update_step");
        process_exit(1);
    }

    println("prod_g4_auto_fusion_kalman: PASSED");
    process_exit(0);
}
