// # Product prove std/space_propulsion/rocket_thrust_vector_control.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_thrust_vector_control.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_thrust_vector_control.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rocket_thrust_vector_control: PASSED only if they match.

import "std/space_propulsion/rocket_thrust_vector_control.oo";

pub fn main() {
    let rocket_thrust_vector_control_a = tvc_gimbal_spec_default();
    let rocket_thrust_vector_control_b = tvc_gimbal_spec_default();
    let rocket_thrust_vector_control_va = tvc_compute_actuator_stroke(rocket_thrust_vector_control_a, 0.0);
    let rocket_thrust_vector_control_vb = tvc_compute_actuator_stroke(rocket_thrust_vector_control_b, 0.0);
    if rocket_thrust_vector_control_va != rocket_thrust_vector_control_vb {
        println("FAIL rocket_thrust_vector_control");
        process_exit(1);
    }
    println("prod_ap_rocket_thrust_vector_control: PASSED");
}
