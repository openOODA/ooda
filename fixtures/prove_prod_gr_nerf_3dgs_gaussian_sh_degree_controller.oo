// # Product prove std/nerf_3dgs/gaussian_sh_degree_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts sh_degree_to_num_coeffs is a real value.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_sh_degree_controller.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call sh_degree_to_num_coeffs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_gaussian_sh_degree_controller: PASSED only if they match.

import "std/nerf_3dgs/gaussian_sh_degree_controller.oo";

pub fn main() {
    let g0_a = sh_degree_to_num_coeffs(0);
    let g0_b = sh_degree_to_num_coeffs(0);
    if g0_a != g0_b {
        println("FAIL sh_degree_to_num_coeffs");
        process_exit(1);
    }
    println("prod_gr_gaussian_sh_degree_controller: PASSED");
}
