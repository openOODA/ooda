// # Product prove std/crypto/fhe_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_stubs_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_stubs.oo.
//
// Beats:
//   1. Call fhe_stubs_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fhe_stubs: PASSED only if it matches.

import "std/crypto/fhe_stubs.oo";

pub fn main() {
    let a: Int = fhe_stubs_probe();
    if a != 0 {
        println("FAIL fhe_stubs_probe");
        process_exit(1);
    }
    println("prod_nc_fhe_stubs: PASSED");
}
