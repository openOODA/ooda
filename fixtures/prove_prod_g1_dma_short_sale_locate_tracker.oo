// # Product prove std/fintech_l3_book/dma_short_sale_locate_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts locate_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_short_sale_locate_tracker.oo.
//
// Beats:
//   1. Call locate_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_short_sale_locate_tracker: PASSED only if they match.

import "std/fintech_l3_book/dma_short_sale_locate_tracker.oo";

pub fn main() {
    let a: LocateRecord = locate_record_new("x", "x", 0, true, 0);
    let b: LocateRecord = locate_record_new("x", "x", 0, true, 0);
    if a.total_borrow_shares != b.total_borrow_shares {
        println("FAIL locate_record_new");
        process_exit(1);
    }
    println("prod_dma_short_sale_locate_tracker: PASSED");
}
