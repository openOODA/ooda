// # list_set String emit lock
//
// Logline: Fail-closed emit+gcc+run of list_set on List[String] index 0 to z.
//
// Setup: Backend-C. list_set returns the updated List[String].
//
// Beats:
//   1. Push a onto an empty list.
//   2. list_set index 0 to z; get is z.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_set(xs, 0, "z");
    if list_get(xs, 0) != "z" {
        println("FAIL");
        process_exit(1);
    }
    println("list_set_str_smoke: PASSED");
}
