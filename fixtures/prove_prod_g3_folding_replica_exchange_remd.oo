// # Product prove std/protein_folding/folding_replica_exchange_remd.oo
//
// Logline: Fail-closed emit+gcc+run asserts remd_calc_beta is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_replica_exchange_remd.oo.
//
// Beats:
//   1. Call remd_calc_beta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_folding_replica_exchange_remd: PASSED only if they match.

import "std/protein_folding/folding_replica_exchange_remd.oo";

pub fn main() {
    let folding_replica_exchange_remd_mark: Int = 0;
    if folding_replica_exchange_remd_mark != 0 {
        process_exit(1);
    }
    let a: Float = remd_calc_beta(0.0);
    let b: Float = remd_calc_beta(0.0);
    if a != b {
        println("FAIL remd_calc_beta");
        process_exit(1);
    }
    println("prod_folding_replica_exchange_remd: PASSED");
}
