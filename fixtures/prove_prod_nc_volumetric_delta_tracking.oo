// # Product prove std/pbr_raytracing/volumetric_delta_tracking.oo
//
// Logline: Fail-closed emit+gcc+run asserts volumetric_delta_tracking_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/volumetric_delta_tracking.oo.
//
// Beats:
//   1. Call volumetric_delta_tracking_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_volumetric_delta_tracking: PASSED only if it matches.

import "std/pbr_raytracing/volumetric_delta_tracking.oo";

pub fn main() {
    let a: Int = volumetric_delta_tracking_probe();
    if a != 0 {
        println("FAIL volumetric_delta_tracking_probe");
        process_exit(1);
    }
    println("prod_nc_volumetric_delta_tracking: PASSED");
}
