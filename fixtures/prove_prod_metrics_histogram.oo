// # Product prove std/diag/metrics_histogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts metrics_hist_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/metrics_histogram.oo.
//
// Beats:
//   1. Call metrics_hist_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metrics_histogram: PASSED only if they match.

import "std/diag/metrics_histogram.oo";

pub fn main() {
    let obj = metrics_hist_new("x");
    let a = metrics_hist_count(obj);
    let b = metrics_hist_count(obj);
    if a != b {
        println("FAIL metrics_hist_count");
        process_exit(1);
    }
    println("prod_metrics_histogram: PASSED");
}
