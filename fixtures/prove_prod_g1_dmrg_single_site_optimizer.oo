// # Product prove std/quantum_tensor_nets/dmrg_single_site_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts dmrg_single_site_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/dmrg_single_site_optimizer.oo.
//
// Beats:
//   1. Call dmrg_single_site_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dmrg_single_site_optimizer: PASSED only if they match.

import "std/quantum_tensor_nets/dmrg_single_site_optimizer.oo";

pub fn main() {
    let a: DmrgSingleSiteConfig = dmrg_single_site_config_default(0);
    let b: DmrgSingleSiteConfig = dmrg_single_site_config_default(0);
    if a.num_sites != b.num_sites {
        println("FAIL dmrg_single_site_config_default");
        process_exit(1);
    }
    println("prod_dmrg_single_site_optimizer: PASSED");
}
