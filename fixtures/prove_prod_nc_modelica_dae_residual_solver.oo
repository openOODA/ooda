// # Product prove std/digital_twin/modelica_dae_residual_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts modelica_dae_residual_solver_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/modelica_dae_residual_solver.oo.
//
// Beats:
//   1. Call modelica_dae_residual_solver_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_modelica_dae_residual_solver: PASSED only if it matches.

import "std/digital_twin/modelica_dae_residual_solver.oo";

pub fn main() {
    let a: Int = modelica_dae_residual_solver_probe();
    if a != 0 {
        println("FAIL modelica_dae_residual_solver_probe");
        process_exit(1);
    }
    println("prod_nc_modelica_dae_residual_solver: PASSED");
}
