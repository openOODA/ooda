// # Product prove std/robotics_auv/auv_swarm_area_coverage.oo
//
// Logline: Fail-closed emit+gcc+run asserts area_coverage_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_swarm_area_coverage.oo.
//
// Beats:
//   1. Call area_coverage_config_default using the auv_swarm_area_coverage ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_swarm_area_coverage: PASSED only if asserts hold.

import "std/robotics_auv/auv_swarm_area_coverage.oo";

pub fn main() {
    let obj = area_coverage_config_default();
    let auv_swarm_area_coverage_a = obj.survey_length_m;
    if auv_swarm_area_coverage_a != 500.0 {
        println("FAIL area_coverage_config_default");
        process_exit(1);
    }
    println("prod_auv_swarm_area_coverage: PASSED");
}
