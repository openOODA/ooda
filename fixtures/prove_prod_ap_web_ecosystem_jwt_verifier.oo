// # Product prove std/web_ecosystem/jwt_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/jwt_verifier.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_verifier.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jwt_verifier: PASSED only if they match.

import "std/web_ecosystem/jwt_verifier.oo";

pub fn main() {
    let jwt_verifier_a = jwt_clock_skew_default();
    let jwt_verifier_b = jwt_clock_skew_default();
    if jwt_verifier_a != jwt_verifier_b {
        println("FAIL jwt_verifier");
        process_exit(1);
    }
    println("prod_ap_jwt_verifier: PASSED");
}
