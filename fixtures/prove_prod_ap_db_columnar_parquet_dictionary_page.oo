// # Product prove std/db_columnar/parquet_dictionary_page.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_dictionary_page.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_dictionary_page.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_parquet_dictionary_page: PASSED only if they match.

import "std/db_columnar/parquet_dictionary_page.oo";

pub fn main() {
    let parquet_dictionary_page_a = dictionary_table_new();
    let parquet_dictionary_page_b = dictionary_table_new();
    let parquet_dictionary_page_va = dictionary_table_find_string(parquet_dictionary_page_a, "x");
    let parquet_dictionary_page_vb = dictionary_table_find_string(parquet_dictionary_page_b, "x");
    if parquet_dictionary_page_va != parquet_dictionary_page_vb {
        println("FAIL parquet_dictionary_page");
        process_exit(1);
    }
    println("prod_ap_parquet_dictionary_page: PASSED");
}
