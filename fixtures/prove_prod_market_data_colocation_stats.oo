// # Product prove std/fintech_l3_book/market_data_colocation_stats.oo
//
// Logline: Fail-closed emit+gcc+run asserts colocation_profile_new real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/market_data_colocation_stats.oo.
//
// Beats:
//   1. Call colocation_profile_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_market_data_colocation_stats: PASSED only if the assert holds.

import "std/fintech_l3_book/market_data_colocation_stats.oo";

pub fn main() {
    let market_data_colocation_stats_mark: Int = 0;
    if market_data_colocation_stats_mark != 0 {
        process_exit(1);
    }
    let market_data_colocation_stats_a: ColocationProfile = colocation_profile_new();
    let market_data_colocation_stats_sample_count: Int = (market_data_colocation_stats_a).sample_count;
    if market_data_colocation_stats_sample_count != 0 {
        println("FAIL colocation_profile_new");
        process_exit(1);
    }
    println("prod_market_data_colocation_stats: PASSED");
}
