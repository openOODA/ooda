// # Product prove std/wasm_gc/jit_register_file.oo
//
// Logline: Fail-closed emit+gcc+run asserts physical_reg_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_register_file.oo.
//
// Beats:
//   1. Call physical_reg_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_register_file: PASSED only if they match.

import "std/wasm_gc/jit_register_file.oo";

pub fn main() {
    let a: PhysicalReg = physical_reg_new(0, "x", 0, 0, 0);
    let b: PhysicalReg = physical_reg_new(0, "x", 0, 0, 0);
    if a.reg_id != b.reg_id {
        println("FAIL physical_reg_new");
        process_exit(1);
    }
    println("prod_jit_register_file: PASSED");
}
