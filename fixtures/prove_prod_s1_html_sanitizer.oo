// # Product prove std/web_ecosystem/html_sanitizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts html_tag_script is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/html_sanitizer.oo.
//
// Beats:
//   1. Call html_tag_script twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_html_sanitizer: PASSED only if they match.

import "std/web_ecosystem/html_sanitizer.oo";

pub fn main() {
    let html_sanitizer_mark: Int = 0;
    if html_sanitizer_mark != 0 {
        process_exit(1);
    }
    let html_sanitizer_a: Int = html_tag_script();
    let html_sanitizer_b: Int = html_tag_script();
    if html_sanitizer_a != html_sanitizer_b {
        println("FAIL html_tag_script");
        process_exit(1);
    }
    println("prod_html_sanitizer: PASSED");
}
