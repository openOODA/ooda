// # Product prove std/gis_spatial/wgs84_coords.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/wgs84_coords.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/wgs84_coords.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wgs84_coords: PASSED only if they match.

import "std/gis_spatial/wgs84_coords.oo";

pub fn main() {
    let wgs84_coords_a = wgs84_math_pi();
    let wgs84_coords_b = wgs84_math_pi();
    if wgs84_coords_a != wgs84_coords_b {
        println("FAIL wgs84_coords");
        process_exit(1);
    }
    println("prod_ap_wgs84_coords: PASSED");
}
