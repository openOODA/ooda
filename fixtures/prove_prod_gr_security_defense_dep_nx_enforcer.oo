// # Product prove std/security_defense/dep_nx_enforcer.oo
//
// Logline: Fail-closed emit+gcc+run asserts dep_policy_flip_jit_page is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/dep_nx_enforcer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dep_policy_flip_jit_page twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dep_nx_enforcer: PASSED only if they match.

import "std/security_defense/dep_nx_enforcer.oo";

pub fn main() {
    let mut g0_oa = dep_policy_enforcer_new(true);
    let mut g0_ob = dep_policy_enforcer_new(true);
    let g0_a = dep_policy_flip_jit_page(&g0_oa, 0, true);
    let g0_b = dep_policy_flip_jit_page(&g0_ob, 0, true);
    if g0_a != g0_b {
        println("FAIL dep_policy_flip_jit_page");
        process_exit(1);
    }
    println("prod_gr_dep_nx_enforcer: PASSED");
}
