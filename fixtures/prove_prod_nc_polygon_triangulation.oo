// # Product prove std/scicomp/polygon_triangulation.oo
//
// Logline: Fail-closed emit+gcc+run asserts polygon_triangulation_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/polygon_triangulation.oo.
//
// Beats:
//   1. Call polygon_triangulation_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_polygon_triangulation: PASSED only if it matches.

import "std/scicomp/polygon_triangulation.oo";

pub fn main() {
    let a: Int = polygon_triangulation_probe();
    if a != 0 {
        println("FAIL polygon_triangulation_probe");
        process_exit(1);
    }
    println("prod_nc_polygon_triangulation: PASSED");
}
