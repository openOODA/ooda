// # Product prove std/hft_alpha/mm_market_maker_pnl_attribution.oo
//
// Logline: Fail-closed emit+gcc+run asserts pnl_attribution_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_market_maker_pnl_attribution.oo.
//
// Beats:
//   1. Call pnl_attribution_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_market_maker_pnl_attribution: PASSED only if they match.

import "std/hft_alpha/mm_market_maker_pnl_attribution.oo";

pub fn main() {
    let mm_market_maker_pnl_attribution_mark: Int = 0;
    if mm_market_maker_pnl_attribution_mark != 0 {
        process_exit(1);
    }
    let a: PnlComponentReport = pnl_attribution_new();
    let b: PnlComponentReport = pnl_attribution_new();
    if (a).total_pnl_usd != (b).total_pnl_usd {
        println("FAIL pnl_attribution_new");
        process_exit(1);
    }
    println("prod_g2_mm_market_maker_pnl_attribution: PASSED");
}
