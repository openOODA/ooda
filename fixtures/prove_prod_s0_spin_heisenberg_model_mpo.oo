// # Product prove std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo
//
// Logline: Fail-closed emit+gcc+run asserts heisenberg_config_xxx value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo.
//
// Beats:
//   1. Call heisenberg_config_xxx twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_spin_heisenberg_model_mpo: PASSED only if asserts hold.

import "std/quantum_tensor_nets/spin_heisenberg_model_mpo.oo";

pub fn main() {
    let spin_heisenberg_model_mpo_a: HeisenbergConfig = heisenberg_config_xxx(1, 1.0);
    let spin_heisenberg_model_mpo_b: HeisenbergConfig = heisenberg_config_xxx(1, 1.0);
    if spin_heisenberg_model_mpo_a.num_sites != spin_heisenberg_model_mpo_b.num_sites {
        println("FAIL heisenberg_config_xxx");
        process_exit(1);
    }
    println("prod_spin_heisenberg_model_mpo: PASSED");
}
