// # Product prove std/deep_ai/qlora_nf4_quantize.oo
//
// Logline: Fail-closed emit+gcc+run asserts qlora_nf4_quantize_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/qlora_nf4_quantize.oo.
//
// Beats:
//   1. Call qlora_nf4_quantize_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qlora_nf4_quantize: PASSED only if they match.

import "std/deep_ai/qlora_nf4_quantize.oo";

pub fn main() {
    let qlora_nf4_quantize_mark: Int = 0;
    if qlora_nf4_quantize_mark != 0 {
        process_exit(1);
    }
    let qlora_nf4_quantize_a: Int = qlora_nf4_quantize_marker();
    let qlora_nf4_quantize_b: Int = qlora_nf4_quantize_marker();
    if qlora_nf4_quantize_a != qlora_nf4_quantize_b {
        println("FAIL qlora_nf4_quantize_marker");
        process_exit(1);
    }
    println("prod_qlora_nf4_quantize: PASSED");
}
