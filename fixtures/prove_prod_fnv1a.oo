// # Product FNV-1a 32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped fnv1a_hash_str.
//
// Setup: Product std/io/checksum_fnv1a.oo. Fowler FNV-1a 32 official.
//
// Beats:
//   1. Empty string is 2166136261 (0x811c9dc5).
//   2. a is 3826004268 (0xe40c292c).
//   3. foobar is 3216097640 (0xbf9cf968).
//   4. Exit 1 before PASSED on a miss.

import "std/io/checksum_fnv1a.oo";

pub fn main() {
    let empty: Int = fnv1a_hash_str("");
    if empty != 2166136261 {
        println("FAIL fnv1a empty");
        process_exit(1);
    }
    let a: Int = fnv1a_hash_str("a");
    if a != 3826002220 {
        println("FAIL fnv1a a");
        process_exit(1);
    }
    let fb: Int = fnv1a_hash_str("foobar");
    if fb != 3214735720 {
        println("FAIL fnv1a foobar");
        process_exit(1);
    }
    println("prod_fnv1a: PASSED");
}
