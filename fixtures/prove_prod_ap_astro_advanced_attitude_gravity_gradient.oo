// # Product prove std/astro_advanced/attitude_gravity_gradient.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/attitude_gravity_gradient.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_gravity_gradient.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_gravity_gradient: PASSED only if they match.

import "std/astro_advanced/attitude_gravity_gradient.oo";

pub fn main() {
    let attitude_gravity_gradient_a = gg_torque(0);
    let attitude_gravity_gradient_b = gg_torque(0);
    if attitude_gravity_gradient_a != attitude_gravity_gradient_b {
        println("FAIL attitude_gravity_gradient");
        process_exit(1);
    }
    println("prod_ap_attitude_gravity_gradient: PASSED");
}
