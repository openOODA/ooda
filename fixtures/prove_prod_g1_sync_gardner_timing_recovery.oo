// # Product prove std/telecom_5g/sync_gardner_timing_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts gardner_ted_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_gardner_timing_recovery.oo.
//
// Beats:
//   1. Call gardner_ted_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sync_gardner_timing_recovery: PASSED only if they match.

import "std/telecom_5g/sync_gardner_timing_recovery.oo";

pub fn main() {
    let a: GardnerTedState = gardner_ted_state_new(0.0, 0.0);
    let b: GardnerTedState = gardner_ted_state_new(0.0, 0.0);
    if a.strobe_ready != b.strobe_ready {
        println("FAIL gardner_ted_state_new");
        process_exit(1);
    }
    println("prod_sync_gardner_timing_recovery: PASSED");
}
