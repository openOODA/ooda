// # Product prove std/3d/materials_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts mat_op_albedo is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/materials_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mat_op_albedo twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_materials_ops: PASSED only if they match.

import "std/3d/materials_ops.oo";

pub fn main() {
    let g0_oa = mat_op_new(2, 2);
    let g0_ob = mat_op_new(2, 2);
    let g0_a = mat_op_albedo(g0_oa);
    let g0_b = mat_op_albedo(g0_ob);
    if g0_a != g0_b {
        println("FAIL mat_op_albedo");
        process_exit(1);
    }
    println("prod_g0_materials_ops: PASSED");
}
