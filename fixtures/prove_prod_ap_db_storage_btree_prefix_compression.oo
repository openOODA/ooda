// # Product prove std/db_storage/btree_prefix_compression.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/btree_prefix_compression.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_prefix_compression.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_btree_prefix_compression: PASSED only if they match.

import "std/db_storage/btree_prefix_compression.oo";

pub fn main() {
    let btree_prefix_compression_a = common_prefix_length("x", "x");
    let btree_prefix_compression_b = common_prefix_length("x", "x");
    if btree_prefix_compression_a != btree_prefix_compression_b {
        println("FAIL btree_prefix_compression");
        process_exit(1);
    }
    println("prod_ap_btree_prefix_compression: PASSED");
}
