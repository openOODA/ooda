// # Product prove std/astrodynamics/rocket_tsiolkovsky.oo
//
// Logline: Fail-closed emit+gcc+run asserts tsiolkovsky_g0 is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/rocket_tsiolkovsky.oo.
//
// Beats:
//   1. Call tsiolkovsky_g0 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_tsiolkovsky: PASSED only if they match.

import "std/astrodynamics/rocket_tsiolkovsky.oo";

pub fn main() {
    let rocket_tsiolkovsky_mark: Int = 0;
    if rocket_tsiolkovsky_mark != 0 {
        process_exit(1);
    }
    let a: Int = tsiolkovsky_g0();
    let b: Int = tsiolkovsky_g0();
    if a != b {
        println("FAIL tsiolkovsky_g0");
        process_exit(1);
    }
    println("prod_rocket_tsiolkovsky: PASSED");
}
