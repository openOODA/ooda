// # Product prove std/defi_derivatives/derivatives_pnl_attribution.oo
//
// Logline: Fail-closed emit+gcc+run asserts derivatives_pnl_attribution_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/derivatives_pnl_attribution.oo.
//
// Beats:
//   1. Call derivatives_pnl_attribution_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_derivatives_pnl_attribution: PASSED only if it matches.

import "std/defi_derivatives/derivatives_pnl_attribution.oo";

pub fn main() {
    let a: Int = derivatives_pnl_attribution_probe();
    if a != 0 {
        println("FAIL derivatives_pnl_attribution_probe");
        process_exit(1);
    }
    println("prod_nc_derivatives_pnl_attribution: PASSED");
}
