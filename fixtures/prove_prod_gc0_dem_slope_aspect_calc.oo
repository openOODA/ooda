// # Product prove std/gis_topo/dem_slope_aspect_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts dem_slope_aspect_calc_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_slope_aspect_calc.oo.
//
// Beats:
//   1. Call dem_slope_aspect_calc_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dem_slope_aspect_calc: PASSED only if they match.

import "std/gis_topo/dem_slope_aspect_calc.oo";

pub fn main() {
    let dem_slope_aspect_calc_mark: Int = 0;
    if dem_slope_aspect_calc_mark != 0 {
        process_exit(1);
    }
    let dem_slope_aspect_calc_a: Int = dem_slope_aspect_calc_probe();
    let dem_slope_aspect_calc_b: Int = dem_slope_aspect_calc_probe();
    if dem_slope_aspect_calc_a != dem_slope_aspect_calc_b {
        println("FAIL dem_slope_aspect_calc_probe");
        process_exit(1);
    }
    println("prod_dem_slope_aspect_calc: PASSED");
}
