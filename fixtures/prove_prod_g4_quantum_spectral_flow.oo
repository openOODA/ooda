// # Product prove std/quantum_topological/topological_spectral_flow_invariant.oo
//
// Logline: Fail-closed emit+gcc+run asserts spectral flow level tracking, net pumped charge, and Thouless pump current calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_spectral_flow_invariant.oo.
//
// Beats:
//   1. Construct SpectralFlowLevel instances for upward, downward, and non-crossing states.
//   2. Create SpectralFlowPump and add levels.
//   3. Calculate net pumped topological charge and Thouless pump average current.
//   4. Print prod_g4_quantum_spectral_flow: PASSED and exit 0.

import "std/quantum_topological/topological_spectral_flow_invariant.oo";

pub fn main() {
    let ef: Float = 0.0;
    let lvl_up: SpectralFlowLevel = spectral_flow_level_new(1, 0.0 - 0.5, 0.5, ef);
    let lvl_down: SpectralFlowLevel = spectral_flow_level_new(2, 0.5, 0.0 - 0.5, ef);
    let lvl_stay: SpectralFlowLevel = spectral_flow_level_new(3, 0.2, 0.8, ef);

    if (lvl_up).crosses_fermi_level_up != 1 || (lvl_up).crosses_fermi_level_down != 0 {
        println("FAIL spectral_flow_level_new lvl_up");
        process_exit(1);
    }
    if (lvl_down).crosses_fermi_level_up != 0 || (lvl_down).crosses_fermi_level_down != 1 {
        println("FAIL spectral_flow_level_new lvl_down");
        process_exit(1);
    }
    if (lvl_stay).crosses_fermi_level_up != 0 || (lvl_stay).crosses_fermi_level_down != 0 {
        println("FAIL spectral_flow_level_new lvl_stay");
        process_exit(1);
    }

    let mut pump: SpectralFlowPump = spectral_flow_pump_new(ef, 1.0);
    spectral_flow_add_level(&mut pump, lvl_up);
    spectral_flow_add_level(&mut pump, lvl_up);
    spectral_flow_add_level(&mut pump, lvl_down);
    spectral_flow_add_level(&mut pump, lvl_stay);

    let net_q1: Int = spectral_flow_net_pumped_charge(&pump);
    let net_q2: Int = spectral_flow_net_pumped_charge(&pump);

    if net_q1 != 1 || net_q1 != net_q2 {
        println("FAIL spectral_flow_net_pumped_charge");
        process_exit(1);
    }

    let curr1: Float = thouless_pump_average_current_amps(net_q1, 1.0);
    let curr2: Float = thouless_pump_average_current_amps(net_q2, 1.0);

    if curr1 != curr2 || curr1 <= 0.0 {
        println("FAIL thouless_pump_average_current_amps");
        process_exit(1);
    }

    println("prod_g4_quantum_spectral_flow: PASSED");
    process_exit(0);
}
