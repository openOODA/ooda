// # Product prove std/quantum_topological/topological_higher_order_insulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts BBH quadrupole insulator models, topological phase checks, and corner state energy splittings are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_higher_order_insulator.oo.
//
// Beats:
//   1. Construct topological and trivial BbhQuadrupoleModel instances.
//   2. Validate topological quadrupole phase classification with bbh_is_topological_quadrupole.
//   3. Calculate corner state energy splitting with bbh_corner_state_energy_splitting.
//   4. Print prod_g4_quantum_insulator: PASSED and exit 0.

import "std/quantum_topological/topological_higher_order_insulator.oo";

pub fn main() {
    let topo_model: BbhQuadrupoleModel = bbh_quadrupole_model_new(0.2, 1.0, 10);
    let triv_model: BbhQuadrupoleModel = bbh_quadrupole_model_new(1.0, 0.2, 10);

    if (topo_model).bulk_quadrupole_qxy < 0.49 || (topo_model).bulk_quadrupole_qxy > 0.51 {
        println("FAIL bbh_quadrupole_model_new topo qxy");
        process_exit(1);
    }
    if (topo_model).corner_charge < 0.24 || (topo_model).corner_charge > 0.26 {
        println("FAIL bbh_quadrupole_model_new topo corner");
        process_exit(1);
    }
    if (triv_model).bulk_quadrupole_qxy != 0.0 || (triv_model).corner_charge != 0.0 {
        println("FAIL bbh_quadrupole_model_new triv");
        process_exit(1);
    }

    let is_topo: Int = bbh_is_topological_quadrupole(&topo_model);
    let is_triv: Int = bbh_is_topological_quadrupole(&triv_model);

    if is_topo != 1 || is_triv != 0 {
        println("FAIL bbh_is_topological_quadrupole");
        process_exit(1);
    }

    let split1: Float = bbh_corner_state_energy_splitting(&topo_model);
    let split2: Float = bbh_corner_state_energy_splitting(&topo_model);
    let split_triv: Float = bbh_corner_state_energy_splitting(&triv_model);

    if split1 != split2 || split1 < 0.0 || split1 > 0.001 {
        println("FAIL bbh_corner_state_energy_splitting topo");
        process_exit(1);
    }
    if split_triv != 1.0 {
        println("FAIL bbh_corner_state_energy_splitting triv");
        process_exit(1);
    }

    println("prod_g4_quantum_insulator: PASSED");
    process_exit(0);
}
