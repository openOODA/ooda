// # Product prove std/sec/sys/aslr_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_engine_work is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call aslr_engine_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_aslr_engine: PASSED only if they match.

import "std/sec/sys/aslr_engine.oo";

pub fn main() {
    let g2_a = aslr_engine_work(2);
    let g2_b = aslr_engine_work(2);
    if g2_a != g2_b {
        println("FAIL aslr_engine_work");
        process_exit(1);
    }
    println("prod_g2_aslr_engine: PASSED");
}
