// # Product prove std/multimedia/spectrogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts spec_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/spectrogram.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call spec_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_spectrogram: PASSED only if they match.

import "std/multimedia/spectrogram.oo";

pub fn main() {
    let g0_a = spec_pi();
    let g0_b = spec_pi();
    if g0_a != g0_b {
        println("FAIL spec_pi");
        process_exit(1);
    }
    println("prod_gr_spectrogram: PASSED");
}
