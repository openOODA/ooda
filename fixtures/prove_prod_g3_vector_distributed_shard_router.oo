// # Product prove std/db_vector_ann/vector_distributed_shard_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts shard_routing_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_distributed_shard_router.oo.
//
// Beats:
//   1. Call shard_routing_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_distributed_shard_router: PASSED only if they match.

import "std/db_vector_ann/vector_distributed_shard_router.oo";

pub fn main() {
    let vector_distributed_shard_router_mark: Int = 0;
    if vector_distributed_shard_router_mark != 0 {
        process_exit(1);
    }
    let a: ShardRoutingConfig = shard_routing_config_default(0);
    let b: ShardRoutingConfig = shard_routing_config_default(0);
    if (a).num_shards != (b).num_shards {
        println("FAIL shard_routing_config_default");
        process_exit(1);
    }
    println("prod_vector_distributed_shard_router: PASSED");
}
