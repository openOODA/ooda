// # Product prove std/ai_ml/opt_adamw.oo
//
// Logline: Fail-closed emit+gcc+run asserts AdamW optimization step is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/opt_adamw.oo.
//
// Beats:
//   1. Configure AdamW optimizer with default parameters and call opt_adamw_marker.
//   2. Execute AdamW update steps on 1D parameter and gradient tensors.
//   3. Print prod_g4_aiml_opt_adamw: PASSED only if all match.

import "std/ai_ml/opt_adamw.oo";

pub fn main() {
    let m: Int = opt_adamw_marker();
    if m != 1 {
        println("FAIL opt_adamw_marker");
        process_exit(1);
    }

    let cfg: AdamWConfig = adamw_config_default(0.001);
    let mut opt: AdamWOptimizer = adamw_optimizer_new(cfg, 2);

    let mut p_data: List[Float] = list_new();
    p_data = list_push(p_data, 1.0);
    p_data = list_push(p_data, 2.0);
    let param: Tensor1D = Tensor1D { data: p_data, size: 2 };

    let mut g_data: List[Float] = list_new();
    g_data = list_push(g_data, 0.1);
    g_data = list_push(g_data, 0.2);
    let grad: Tensor1D = Tensor1D { data: g_data, size: 2 };

    let step_res: Tensor1D = adamw_step_1d(&mut opt, param, grad);
    if (step_res).size != 2 {
        println("FAIL adamw_step_1d size");
        process_exit(1);
    }
    if (opt).step_count != 1 {
        println("FAIL opt step_count");
        process_exit(1);
    }

    println("prod_g4_aiml_opt_adamw: PASSED");
    process_exit(0);
}
