// # Product prove std/synthetic_biology/synchronized_quorum_oscillator.oo
//
// Logline: Fail-closed emit+gcc+run asserts danino_rk4_step real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/synchronized_quorum_oscillator.oo.
//
// Beats:
//   1. Call danino_rk4_step with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synchronized_quorum_oscillator: PASSED only if the assert holds.

import "std/synthetic_biology/synchronized_quorum_oscillator.oo";

pub fn main() {
    let synchronized_quorum_oscillator_mark: Int = 0;
    if synchronized_quorum_oscillator_mark != 0 {
        process_exit(1);
    }
    let synchronized_quorum_oscillator_st: DaninoCellState = DaninoCellState { lux_i: 0.0, aii_a: 0.0, ahl_internal: 0.0, ahl_external: 0.0, time_min: 0.0 };
    let synchronized_quorum_oscillator_p: DaninoOscillatorParams = DaninoOscillatorParams { c_a: 0.0, c_i: 0.0, b_a: 0.0, b_i: 0.0, gamma_a: 0.0, gamma_i: 0.0, gamma_c: 0.0, k_diff: 0.0, mu_washout: 0.0, cell_density_d: 0.0 };
    let synchronized_quorum_oscillator_a = danino_rk4_step(&synchronized_quorum_oscillator_st, &synchronized_quorum_oscillator_p, 0.0);
    let synchronized_quorum_oscillator_time_min: Float = (synchronized_quorum_oscillator_a).time_min;
    if !(synchronized_quorum_oscillator_time_min == 0.0) {
        println("FAIL danino_rk4_step");
        process_exit(1);
    }
    println("prod_synchronized_quorum_oscillator: PASSED");
}
