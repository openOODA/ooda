// # Product prove std/bio/dna.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/dna.oo.
//
// Beats:
//   1. Call int_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dna: PASSED only if they match.

import "std/bio/dna.oo";

pub fn main() {
    let dna_mark: Int = 0;
    if dna_mark != 0 {
        process_exit(1);
    }
    let a: Int = int_abs(0);
    let b: Int = int_abs(0);
    if a != b {
        println("FAIL int_abs");
        process_exit(1);
    }
    println("prod_dna: PASSED");
}
