// # Product prove std/embedded_hal/flash_wear_leveling.oo
//
// Logline: Fail-closed emit+gcc+run asserts wear_leveler_get_physical is a real value.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/flash_wear_leveling.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wear_leveler_get_physical twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_flash_wear_leveling: PASSED only if they match.

import "std/embedded_hal/flash_wear_leveling.oo";

pub fn main() {
    let g0_oa = wear_leveler_new(0, 0);
    let g0_ob = wear_leveler_new(0, 0);
    let g0_a = wear_leveler_get_physical(g0_oa, 0);
    let g0_b = wear_leveler_get_physical(g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL wear_leveler_get_physical");
        process_exit(1);
    }
    println("prod_gr_flash_wear_leveling: PASSED");
}
