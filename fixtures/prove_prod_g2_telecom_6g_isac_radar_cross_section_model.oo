// # Product prove std/telecom_6g/isac_radar_cross_section_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts radar_target_drone is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_radar_cross_section_model.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call radar_target_drone twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isac_radar_cross_section_model: PASSED only if they match.

import "std/telecom_6g/isac_radar_cross_section_model.oo";

pub fn main() {
    let g2_oa: RadarTargetConfig = radar_target_drone();
    let g2_ob: RadarTargetConfig = radar_target_drone();
    let g2_a = (g2_oa).mean_rcs_m2;
    let g2_b = (g2_ob).mean_rcs_m2;
    if g2_a != g2_b {
        println("FAIL radar_target_drone.mean_rcs_m2");
        process_exit(1);
    }
    println("prod_g2_isac_radar_cross_section_model: PASSED");
}
