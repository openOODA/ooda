// # Product prove std/auto/mpc_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpc_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/mpc_ops.oo.
//
// Beats:
//   1. Call mpc_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpc_ops: PASSED only if they match.

import "std/auto/mpc_ops.oo";

pub fn main() {
    let mpc_ops_mark: Int = 0;
    if mpc_ops_mark != 0 {
        process_exit(1);
    }
    let a: Float = mpc_pi();
    let b: Float = mpc_pi();
    if a != b {
        println("FAIL mpc_pi");
        process_exit(1);
    }
    println("prod_mpc_ops: PASSED");
}
