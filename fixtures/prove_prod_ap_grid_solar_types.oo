// # Product prove std/grid/solar_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/solar_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_solar_types: PASSED only if they match.

import "std/grid/solar_types.oo";

pub fn main() {
    let solar_types_a = pv_array_new(0, 0);
    let solar_types_b = pv_array_new(0, 0);
    let solar_types_va = pv_array_panels(solar_types_a);
    let solar_types_vb = pv_array_panels(solar_types_b);
    if solar_types_va != solar_types_vb {
        println("FAIL solar_types");
        process_exit(1);
    }
    println("prod_ap_solar_types: PASSED");
}
