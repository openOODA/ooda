// # Product prove std/zk_rollup/poseidon2_permutation.oo
//
// Logline: Fail-closed emit+gcc+run asserts poseidon2_config_t3 is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/poseidon2_permutation.oo.
//
// Beats:
//   1. Call poseidon2_config_t3 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_poseidon2_permutation: PASSED only if they match.

import "std/zk_rollup/poseidon2_permutation.oo";

pub fn main() {
    let poseidon2_permutation_mark: Int = 0;
    if poseidon2_permutation_mark != 0 {
        process_exit(1);
    }
    let a: Poseidon2Config = poseidon2_config_t3(1);
    let b: Poseidon2Config = poseidon2_config_t3(1);
    if (a).width_t != (b).width_t {
        println("FAIL poseidon2_config_t3");
        process_exit(1);
    }
    println("prod_poseidon2_permutation: PASSED");
}
