// # Product prove std/iot_scada/dnp3_transport_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts dnp3_transport_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_transport_layer.oo.
//
// Beats:
//   1. Call dnp3_transport_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dnp3_transport_layer: PASSED only if they match.

import "std/iot_scada/dnp3_transport_layer.oo";

pub fn main() {
    let dnp3_transport_layer_mark: Int = 0;
    if dnp3_transport_layer_mark != 0 {
        process_exit(1);
    }
    let a: Dnp3TransportHeader = dnp3_transport_header_new(true, true, 0);
    let b: Dnp3TransportHeader = dnp3_transport_header_new(true, true, 0);
    if (a).is_fir != (b).is_fir {
        println("FAIL dnp3_transport_header_new");
        process_exit(1);
    }
    println("prod_dnp3_transport_layer: PASSED");
}
