// # Product prove std/bio_advanced/phylogenetic_maximum_parsimony.oo
//
// Logline: Fail-closed emit+gcc+run asserts parsimony_calc_consistency_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/phylogenetic_maximum_parsimony.oo.
//
// Beats:
//   1. Call parsimony_calc_consistency_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_phylogenetic_maximum_parsimony: PASSED only if they match.

import "std/bio_advanced/phylogenetic_maximum_parsimony.oo";

pub fn main() {
    let phylogenetic_maximum_parsimony_mark: Int = 0;
    if phylogenetic_maximum_parsimony_mark != 0 {
        process_exit(1);
    }
    let a: Float = parsimony_calc_consistency_index(0, 0);
    let b: Float = parsimony_calc_consistency_index(0, 0);
    if a != b {
        println("FAIL parsimony_calc_consistency_index");
        process_exit(1);
    }
    println("prod_g2_phylogenetic_maximum_parsimony: PASSED");
}
