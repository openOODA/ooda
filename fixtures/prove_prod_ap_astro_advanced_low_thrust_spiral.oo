// # Product prove std/astro_advanced/low_thrust_spiral.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/low_thrust_spiral.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/low_thrust_spiral.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_low_thrust_spiral: PASSED only if they match.

import "std/astro_advanced/low_thrust_spiral.oo";

pub fn main() {
    let low_thrust_spiral_a = spiral_revs();
    let low_thrust_spiral_b = spiral_revs();
    if low_thrust_spiral_a != low_thrust_spiral_b {
        println("FAIL low_thrust_spiral");
        process_exit(1);
    }
    println("prod_ap_low_thrust_spiral: PASSED");
}
