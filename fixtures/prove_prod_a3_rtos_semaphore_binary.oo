// # Product prove std/embedded_hal/rtos_semaphore_binary.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_semaphore_binary_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_semaphore_binary.oo.
//
// Beats:
//   1. Call rtos_semaphore_binary_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtos_semaphore_binary: PASSED only if they match.

import "std/embedded_hal/rtos_semaphore_binary.oo";

pub fn main() {
    let a: RtosSemaphore = rtos_semaphore_binary_new(0, true);
    let b: RtosSemaphore = rtos_semaphore_binary_new(0, true);
    if (a).sem_id != (b).sem_id {
        println("FAIL rtos_semaphore_binary_new");
        process_exit(1);
    }
    println("prod_rtos_semaphore_binary: PASSED");
}
