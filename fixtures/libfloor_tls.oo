// M163 path A: NetCap + tls_connect → residual Err without OpenSSL.
// After real TCP (when peer accepts), message is "tls residual: OpenSSL not linked".
// With OO_HAVE_OPENSSL=1, real TLS 1.2+ handshake may Ok (not claimed here).
// OODA_TLS_INSECURE_TCP=1 is insecure residual TCP-only (see tls_path_a_smoke).
pub fn main(net: &NetCap) {
    // Host that usually fails resolve/connect → Err still after NetCap require.
    let r: Result[String, String] = tls_connect(net, "example.invalid", 443);
    if r.is_ok() {
        println("tls-unexpected-ok");
    } else {
        println("tls-residual-ok");
    }
}
