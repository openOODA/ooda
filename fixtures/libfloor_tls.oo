// M161 path A: NetCap + tls_connect → residual Err (no TLS handshake).
// main injects long long net = oo_cap_grant_net();
// Honesty: Result err "net residual: path A seal only (no full TCP/UDP/TLS product)"
pub fn main(net: &NetCap) {
    let r: Result[String, String] = tls_connect(net, "example.invalid", 443);
    if r.is_ok() {
        println("tls-unexpected-ok");
    } else {
        println("tls-residual-ok");
    }
}
