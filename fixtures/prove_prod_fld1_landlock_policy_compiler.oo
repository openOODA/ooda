// # Product prove std/security_defense/landlock_policy_compiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_access_fs_readwrite is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/landlock_policy_compiler.oo.
//
// Beats:
//   1. Call landlock_access_fs_readwrite twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_landlock_policy_compiler: PASSED only if they match.

import "std/security_defense/landlock_policy_compiler.oo";

pub fn main() {
    let landlock_policy_compiler_mark: Int = 0;
    if landlock_policy_compiler_mark != 0 {
        process_exit(1);
    }
    let landlock_policy_compiler_a = landlock_access_fs_readwrite();
    let landlock_policy_compiler_b = landlock_access_fs_readwrite();
    if (landlock_policy_compiler_a).read_file != (landlock_policy_compiler_b).read_file {
        println("FAIL landlock_access_fs_readwrite");
        process_exit(1);
    }
    println("prod_landlock_policy_compiler: PASSED");
}
