// # Product prove std/math/matrix_decomp_lu.oo
//
// Logline: Fail-closed verification that LU decomposition, determinant, and linear solver are deterministic.
//
// Setup: Isolated emit-c. Imports std/math/matrix_decomp_lu.oo.
//
// Beats:
//   1. Construct concrete 2x2 test matrix and RHS vector.
//   2. Factorize via matrix_lu and compute determinant with lu_det.
//   3. Solve linear system with lu_solve and assert exact solution.
//   4. Print prod_g4_matrix_decomp_lu: PASSED and exit 0.

import "std/math/matrix_decomp_lu.oo";

pub fn main() {
    let mut d: List[Float] = list_new();
    d = list_push(d, 4.0);
    d = list_push(d, 3.0);
    d = list_push(d, 6.0);
    d = list_push(d, 3.0);
    let mat: Matrix = Matrix { rows: 2, cols: 2, data: d };

    let lu1 = matrix_lu(mat);
    let lu2 = matrix_lu(mat);

    let det1 = lu_det(lu1);
    let det2 = lu_det(lu2);

    if det1 != det2 {
        println("FAIL lu_det mismatch");
        process_exit(1);
    }

    if det1 > -5.99 || det1 < -6.01 {
        println("FAIL lu_det value");
        process_exit(1);
    }

    let mut b_vec: List[Float] = list_new();
    b_vec = list_push(b_vec, 10.0);
    b_vec = list_push(b_vec, 12.0);

    let sol_res1 = lu_solve(lu1, b_vec);
    let sol_res2 = lu_solve(lu2, b_vec);

    if sol_res1.is_err() || sol_res2.is_err() {
        println("FAIL lu_solve is_err");
        process_exit(1);
    }

    let sol1 = match sol_res1 {
        Ok(v) => v,
        Err(_) => list_new(),
    };

    let x0 = list_get(sol1, 0);
    let x1 = list_get(sol1, 1);

    if x0 < 0.99 || x0 > 1.01 || x1 < 1.99 || x1 > 2.01 {
        println("FAIL lu_solve solution value");
        process_exit(1);
    }

    println("prod_g4_matrix_decomp_lu: PASSED");
    process_exit(0);
}
