// # Product prove std/crypto_advanced/ml_dsa_verify.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/ml_dsa_verify.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/ml_dsa_verify.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ml_dsa_verify: PASSED only if they match.

import "std/crypto_advanced/ml_dsa_verify.oo";

pub fn main() {
    let ml_dsa_verify_a = ml_dsa_verify_fast_path("x", "x", "x");
    let ml_dsa_verify_b = ml_dsa_verify_fast_path("x", "x", "x");
    if ml_dsa_verify_a != ml_dsa_verify_b {
        println("FAIL ml_dsa_verify");
        process_exit(1);
    }
    println("prod_ap_ml_dsa_verify: PASSED");
}
