// # Product prove std/compilers_vm/bytecode_interpreter_loop.oo
//
// Logline: Fail-closed emit+gcc+run asserts vm_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_interpreter_loop.oo.
//
// Beats:
//   1. Call vm_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_interpreter_loop: PASSED only if they match.

import "std/compilers_vm/bytecode_interpreter_loop.oo";

pub fn main() {
    let a: VmState = vm_state_new(0);
    let b: VmState = vm_state_new(0);
    if a.pc != b.pc {
        println("FAIL vm_state_new");
        process_exit(1);
    }
    println("prod_bytecode_interpreter_loop: PASSED");
}
