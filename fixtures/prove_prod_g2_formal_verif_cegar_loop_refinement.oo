// # Product prove std/formal_verif/cegar_loop_refinement.oo
//
// Logline: Fail-closed emit+gcc+run asserts cegar_is_spurious_counterexample is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/cegar_loop_refinement.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cegar_is_spurious_counterexample twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cegar_loop_refinement: PASSED only if they match.

import "std/formal_verif/cegar_loop_refinement.oo";

pub fn main() {
    let g2_a = cegar_is_spurious_counterexample(true);
    let g2_b = cegar_is_spurious_counterexample(true);
    if g2_a != g2_b {
        println("FAIL cegar_is_spurious_counterexample");
        process_exit(1);
    }
    println("prod_g2_cegar_loop_refinement: PASSED");
}
