// # Product prove std/ai_ml/opt_sgd.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/opt_sgd.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/opt_sgd.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_opt_sgd: PASSED only if they match.

import "std/ai_ml/opt_sgd.oo";

pub fn main() {
    let opt_sgd_a = sgd_learning_rate_schedule_cosine(0.0, 0, 0);
    let opt_sgd_b = sgd_learning_rate_schedule_cosine(0.0, 0, 0);
    if opt_sgd_a != opt_sgd_b {
        println("FAIL opt_sgd");
        process_exit(1);
    }
    println("prod_ap_opt_sgd: PASSED");
}
