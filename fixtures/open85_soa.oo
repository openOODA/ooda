// # OPEN-85 soa_layout product
//
// Logline: Call soa_layout and print open85: PASSED.
//
// Setup: soa_layout is product C, not residual refuse.
//
// Beats:
//   1. Call soa_layout with a field name.
//   2. Require a nonnegative result.
//   3. Print PASSED.

pub fn main() {
    let n = soa_layout("x");
    if n < 0 {
        println("FAIL");
        process_exit(1);
    }
    println(n);
    println("open85: PASSED");
}
