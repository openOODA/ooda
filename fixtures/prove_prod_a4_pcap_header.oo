// # Product prove std/net_telemetry/pcap_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcap_header_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/pcap_header.oo.
//
// Beats:
//   1. Call pcap_header_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pcap_header: PASSED only if they match.

import "std/net_telemetry/pcap_header.oo";

pub fn main() {
    let a: PcapGlobalHeader = pcap_header_default();
    let b: PcapGlobalHeader = pcap_header_default();
    if (a).magic_number != (b).magic_number {
        println("FAIL pcap_header_default");
        process_exit(1);
    }
    println("prod_pcap_header: PASSED");
}
