// # Product prove std/quantum_advanced/quantum_fourier_transform_exact.oo
//
// Logline: Fail-closed emit+gcc+run asserts qft_calc_angle is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_fourier_transform_exact.oo.
//
// Beats:
//   1. Call qft_calc_angle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_fourier_transform_exact: PASSED only if they match.

import "std/quantum_advanced/quantum_fourier_transform_exact.oo";

pub fn main() {
    let quantum_fourier_transform_exact_mark: Int = 0;
    if quantum_fourier_transform_exact_mark != 0 {
        process_exit(1);
    }
    let a: Float = qft_calc_angle(0, 0);
    let b: Float = qft_calc_angle(0, 0);
    if a != b {
        println("FAIL qft_calc_angle");
        process_exit(1);
    }
    println("prod_quantum_fourier_transform_exact: PASSED");
}
