// # Product prove std/sec/net/waf_rule.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_rule_ready is 1.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_rule.oo.
//
// Beats:
//   1. waf_rule_ready() is 1.
//   2. Exit 1 on miss. Print prod_ap_waf_rule: PASSED only if it holds.

import "std/sec/net/waf_rule.oo";

pub fn main() {
    let waf_rule_a = waf_rule_ready();
    if waf_rule_a != 1 {
        println("FAIL waf_rule");
        process_exit(1);
    }
    println("prod_ap_waf_rule: PASSED");
}
