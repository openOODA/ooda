// # Product prove std/astrodynamics/coordinate_orbital_plane.oo
//
// Logline: Fail-closed emit+gcc+run asserts plane_inc_deg is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/coordinate_orbital_plane.oo.
//
// Beats:
//   1. Call plane_inc_deg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_coordinate_orbital_plane: PASSED only if they match.

import "std/astrodynamics/coordinate_orbital_plane.oo";

pub fn main() {
    let coordinate_orbital_plane_mark: Int = 0;
    if coordinate_orbital_plane_mark != 0 {
        process_exit(1);
    }
    let a: Int = plane_inc_deg();
    let b: Int = plane_inc_deg();
    if a != b {
        println("FAIL plane_inc_deg");
        process_exit(1);
    }
    println("prod_coordinate_orbital_plane: PASSED");
}
