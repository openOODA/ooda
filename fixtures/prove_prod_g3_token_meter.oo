// # Product prove std/token_opt/token_meter.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_rate_limiter_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/token_opt/token_meter.oo.
//
// Beats:
//   1. Call token_rate_limiter_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_token_meter: PASSED only if they match.

import "std/token_opt/token_meter.oo";

pub fn main() {
    let token_meter_mark: Int = 0;
    if token_meter_mark != 0 {
        process_exit(1);
    }
    let a: TokenRateLimiterConfig = token_rate_limiter_config_default();
    let b: TokenRateLimiterConfig = token_rate_limiter_config_default();
    if (a).max_tokens_per_minute != (b).max_tokens_per_minute {
        println("FAIL token_rate_limiter_config_default");
        process_exit(1);
    }
    println("prod_token_meter: PASSED");
}
