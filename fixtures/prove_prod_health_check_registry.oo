// # Product prove std/diag/health_check_registry.oo
//
// Logline: Fail-closed emit+gcc+run asserts health_is_healthy is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/health_check_registry.oo.
//
// Beats:
//   1. Call health_is_healthy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_health_check_registry: PASSED only if they match.

import "std/diag/health_check_registry.oo";

pub fn main() {
    let obj = health_registry_new();
    let a = health_is_healthy(obj);
    let b = health_is_healthy(obj);
    if a != b {
        println("FAIL health_is_healthy");
        process_exit(1);
    }
    println("prod_health_check_registry: PASSED");
}
