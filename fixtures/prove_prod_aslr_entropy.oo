// # Product prove std/sec/sys/aslr_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_compute_entropy is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_entropy.oo.
//
// Beats:
//   1. Call aslr_compute_entropy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aslr_entropy: PASSED only if they match.

import "std/sec/sys/aslr_entropy.oo";

pub fn main() {
    let a = aslr_compute_entropy(0);
    let b = aslr_compute_entropy(0);
    if a != b {
        println("FAIL aslr_compute_entropy");
        process_exit(1);
    }
    println("prod_aslr_entropy: PASSED");
}
