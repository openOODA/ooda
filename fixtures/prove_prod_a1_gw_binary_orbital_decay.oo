// # Product prove std/astrophysics_relativity/gw_binary_orbital_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts binary_decay_eccentricity_factor is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_binary_orbital_decay.oo.
//
// Beats:
//   1. Call binary_decay_eccentricity_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_binary_orbital_decay: PASSED only if they match.

import "std/astrophysics_relativity/gw_binary_orbital_decay.oo";

pub fn main() {
    let gw_binary_orbital_decay_mark: Int = 0;
    if gw_binary_orbital_decay_mark != 0 {
        process_exit(1);
    }
    let a: Float = binary_decay_eccentricity_factor(0.0);
    let b: Float = binary_decay_eccentricity_factor(0.0);
    if a != b {
        println("FAIL binary_decay_eccentricity_factor");
        process_exit(1);
    }
    println("prod_gw_binary_orbital_decay: PASSED");
}
