// # Product ring_deque prove
//
// Logline: Fail-closed emit+gcc+run of shipped ring_deque_push_back/len.
//
// Setup: Product std/collections/ring_deque.oo. Capacity 4, push 7.
//
// Beats:
//   1. New deque empty; after push_back 7, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/ring_deque.oo";

pub fn main() {
    let mut d: RingDeque = ring_deque_new(4);
    let z: Bool = ring_deque_is_empty(d);
    if z == false {
        println("FAIL rdeque empty");
        process_exit(1);
    }
    d = ring_deque_push_back(d, 7);
    let n: Int = ring_deque_len(d);
    if n != 1 {
        println("FAIL rdeque len");
        process_exit(1);
    }
    println("prod_rdeque: PASSED");
}
