// # Product prove std/ai_multimodal/flava_multimodal_fusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts flava_multimodal_fusion_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/flava_multimodal_fusion.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call flava_multimodal_fusion_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_flava_multimodal_fusion: PASSED only if they match.

import "std/ai_multimodal/flava_multimodal_fusion.oo";

pub fn main() {
    let g2_a = flava_multimodal_fusion_marker();
    let g2_b = flava_multimodal_fusion_marker();
    if g2_a != g2_b {
        println("FAIL flava_multimodal_fusion_marker");
        process_exit(1);
    }
    println("prod_g2_flava_multimodal_fusion: PASSED");
}
