// # Product prove std/robotics_auv/emergency_abort_ballast_drop.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_sqrt_seed is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/emergency_abort_ballast_drop.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call int_sqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_emergency_abort_ballast_drop: PASSED only if they match.

import "std/robotics_auv/emergency_abort_ballast_drop.oo";

pub fn main() {
    let g0_a = int_sqrt_seed(2, 2);
    let g0_b = int_sqrt_seed(2, 2);
    if g0_a != g0_b {
        println("FAIL int_sqrt_seed");
        process_exit(1);
    }
    println("prod_g0_emergency_abort_ballast_drop: PASSED");
}
