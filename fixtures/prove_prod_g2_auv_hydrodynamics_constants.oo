// # Product prove std/robotics_auv/auv_hydrodynamics_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts const_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_hydrodynamics_constants.oo.
//
// Beats:
//   1. Call const_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_auv_hydrodynamics_constants: PASSED only if they match.

import "std/robotics_auv/auv_hydrodynamics_constants.oo";

pub fn main() {
    let auv_hydrodynamics_constants_mark: Int = 0;
    if auv_hydrodynamics_constants_mark != 0 {
        process_exit(1);
    }
    let a: Float = const_pi();
    let b: Float = const_pi();
    if a != b {
        println("FAIL const_pi");
        process_exit(1);
    }
    println("prod_g2_auv_hydrodynamics_constants: PASSED");
}
