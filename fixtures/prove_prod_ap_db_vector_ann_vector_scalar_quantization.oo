// # Product prove std/db_vector_ann/vector_scalar_quantization.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_scalar_quantization.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_scalar_quantization.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_vector_scalar_quantization: PASSED only if they match.

import "std/db_vector_ann/vector_scalar_quantization.oo";

pub fn main() {
    let vector_scalar_quantization_a = sq_config_default(0, 0);
    let vector_scalar_quantization_b = sq_config_default(0, 0);
    if vector_scalar_quantization_a.num_bits != vector_scalar_quantization_b.num_bits {
        println("FAIL vector_scalar_quantization");
        process_exit(1);
    }
    println("prod_ap_vector_scalar_quantization: PASSED");
}
