// # Product prove std/astrophysics_relativity/stellar_pulsation_cepheid.oo
//
// Logline: Fail-closed emit+gcc+run asserts stellar_dynamical_pulsation_period_s is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_pulsation_cepheid.oo.
//
// Beats:
//   1. Call stellar_dynamical_pulsation_period_s twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_pulsation_cepheid: PASSED only if they match.

import "std/astrophysics_relativity/stellar_pulsation_cepheid.oo";

pub fn main() {
    let stellar_pulsation_cepheid_mark: Int = 0;
    if stellar_pulsation_cepheid_mark != 0 {
        process_exit(1);
    }
    let a: Float = stellar_dynamical_pulsation_period_s(0.0, 0.0);
    let b: Float = stellar_dynamical_pulsation_period_s(0.0, 0.0);
    if a != b {
        println("FAIL stellar_dynamical_pulsation_period_s");
        process_exit(1);
    }
    println("prod_stellar_pulsation_cepheid: PASSED");
}
