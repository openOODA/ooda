// # Product prove std/bft_consensus/dag_tusk_asynchronous_ordering.oo
//
// Logline: Fail-closed emit+gcc+run asserts tusk_wave_to_leader_round is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_tusk_asynchronous_ordering.oo.
//
// Beats:
//   1. Call tusk_wave_to_leader_round twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dag_tusk_asynchronous_ordering: PASSED only if they match.

import "std/bft_consensus/dag_tusk_asynchronous_ordering.oo";

pub fn main() {
    let dag_tusk_asynchronous_ordering_mark: Int = 0;
    if dag_tusk_asynchronous_ordering_mark != 0 {
        process_exit(1);
    }
    let a: Int = tusk_wave_to_leader_round(0);
    let b: Int = tusk_wave_to_leader_round(0);
    if a != b {
        println("FAIL tusk_wave_to_leader_round");
        process_exit(1);
    }
    println("prod_dag_tusk_asynchronous_ordering: PASSED");
}
