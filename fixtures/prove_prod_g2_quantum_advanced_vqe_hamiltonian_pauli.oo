// # Product prove std/quantum_advanced/vqe_hamiltonian_pauli.oo
//
// Logline: Fail-closed emit+gcc+run asserts paulis_commute_single is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_hamiltonian_pauli.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call paulis_commute_single twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vqe_hamiltonian_pauli: PASSED only if they match.

import "std/quantum_advanced/vqe_hamiltonian_pauli.oo";

pub fn main() {
    let g2_a = paulis_commute_single(2, 2);
    let g2_b = paulis_commute_single(2, 2);
    if g2_a != g2_b {
        println("FAIL paulis_commute_single");
        process_exit(1);
    }
    println("prod_g2_vqe_hamiltonian_pauli: PASSED");
}
