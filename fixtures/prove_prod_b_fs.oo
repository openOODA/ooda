// # Product prove std/os/fs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fs_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/fs.oo.
//
// Beats:
//   1. Call fs_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fs: PASSED only if they match.

import "std/os/fs.oo";

pub fn main() {
    let a = fs_probe();
    let b = fs_probe();
    if a != b {
        println("FAIL fs_probe");
        process_exit(1);
    }
    println("prod_fs: PASSED");
}
