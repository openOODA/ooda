// # Product prove std/graph_networks/flajolet_martin_distinct.oo
//
// Logline: Fail-closed emit+gcc+run asserts fm_pow2 is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/flajolet_martin_distinct.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fm_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_flajolet_martin_distinct: PASSED only if they match.

import "std/graph_networks/flajolet_martin_distinct.oo";

pub fn main() {
    let g2_a = fm_pow2(2);
    let g2_b = fm_pow2(2);
    if g2_a != g2_b {
        println("FAIL fm_pow2");
        process_exit(1);
    }
    println("prod_g2_flajolet_martin_distinct: PASSED");
}
