// # Product prove std/synthetic_biology/plasmid_copy_number_burden.oo
//
// Logline: Fail-closed emit+gcc+run asserts plasmid_calc_loss_probability is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/plasmid_copy_number_burden.oo.
//
// Beats:
//   1. Call plasmid_calc_loss_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_plasmid_copy_number_burden: PASSED only if they match.

import "std/synthetic_biology/plasmid_copy_number_burden.oo";

pub fn main() {
    let plasmid_copy_number_burden_mark: Int = 0;
    if plasmid_copy_number_burden_mark != 0 {
        process_exit(1);
    }
    let a: Float = plasmid_calc_loss_probability(0, true);
    let b: Float = plasmid_calc_loss_probability(0, true);
    if a != b {
        println("FAIL plasmid_calc_loss_probability");
        process_exit(1);
    }
    println("prod_g2_plasmid_copy_number_burden: PASSED");
}
