// # Product prove std/cloud/rate_limiter_token_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud/rate_limiter_token_bucket.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/rate_limiter_token_bucket.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rate_limiter_token_bucket: PASSED only if they match.

import "std/cloud/rate_limiter_token_bucket.oo";

pub fn main() {
    let rate_limiter_token_bucket_a = token_bucket_new(0, 0, 0);
    let rate_limiter_token_bucket_b = token_bucket_new(0, 0, 0);
    let rate_limiter_token_bucket_va = token_bucket_time_until_available(rate_limiter_token_bucket_a, 0);
    let rate_limiter_token_bucket_vb = token_bucket_time_until_available(rate_limiter_token_bucket_b, 0);
    if rate_limiter_token_bucket_va != rate_limiter_token_bucket_vb {
        println("FAIL rate_limiter_token_bucket");
        process_exit(1);
    }
    println("prod_ap_rate_limiter_token_bucket: PASSED");
}
