// # Product prove std/scicomp/kd_tree_spatial.oo
//
// Logline: Fail-closed verification that KD-tree node construction and 2D spatial partitioning insertions are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/kd_tree_spatial.oo.
//
// Beats:
//   1. Construct KD-node and empty KD-tree.
//   2. Insert multiple 2D points to split along alternating coordinate axes.
//   3. Assert resulting tree structure, root index, count, and child indices.
//   4. Print prod_g4_scicomp_kdtree: PASSED and exit 0.

import "std/scicomp/kd_tree_spatial.oo";

pub fn main() {
    let p_test: VoronoiPoint = VoronoiPoint { x: 10.0, y: 20.0 };
    let n1: KdNode = kd_node_new(p_test, 0);
    let n2: KdNode = kd_node_new(p_test, 0);
    if (n1).axis != (n2).axis || (n1).axis != 0 || (n1).left_child != (0 - 1) {
        println("FAIL kd_node_new");
        process_exit(1);
    }

    let mut tree: KdTree = kd_tree_new();
    if (tree).count != 0 || (tree).root_idx != (0 - 1) {
        println("FAIL kd_tree_new");
        process_exit(1);
    }

    let p1: VoronoiPoint = VoronoiPoint { x: 5.0, y: 5.0 };
    let p2: VoronoiPoint = VoronoiPoint { x: 2.0, y: 8.0 };
    let p3: VoronoiPoint = VoronoiPoint { x: 8.0, y: 3.0 };

    kd_tree_insert(&mut tree, p1);
    kd_tree_insert(&mut tree, p2);
    kd_tree_insert(&mut tree, p3);

    if (tree).count != 3 || (tree).root_idx != 0 {
        println("FAIL kd_tree_insert count/root");
        process_exit(1);
    }

    let root_node: KdNode = list_get((tree).nodes, 0);
    if (root_node).left_child != 1 || (root_node).right_child != 2 {
        println("FAIL kd_tree_insert child pointers");
        process_exit(1);
    }

    println("prod_g4_scicomp_kdtree: PASSED");
    process_exit(0);
}
