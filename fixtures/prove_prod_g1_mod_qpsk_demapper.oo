// # Product prove std/telecom_5g/mod_qpsk_demapper.oo
//
// Logline: Fail-closed emit+gcc+run asserts qpsk_demapper_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_qpsk_demapper.oo.
//
// Beats:
//   1. Call qpsk_demapper_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mod_qpsk_demapper: PASSED only if they match.

import "std/telecom_5g/mod_qpsk_demapper.oo";

pub fn main() {
    let a: QpskDemapperConfig = qpsk_demapper_config_new(0.0);
    let b: QpskDemapperConfig = qpsk_demapper_config_new(0.0);
    if a.norm_factor != b.norm_factor {
        println("FAIL qpsk_demapper_config_new");
        process_exit(1);
    }
    println("prod_mod_qpsk_demapper: PASSED");
}
