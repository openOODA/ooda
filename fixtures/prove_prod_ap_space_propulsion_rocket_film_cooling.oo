// # Product prove std/space_propulsion/rocket_film_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_film_cooling.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_film_cooling.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rocket_film_cooling: PASSED only if they match.

import "std/space_propulsion/rocket_film_cooling.oo";

pub fn main() {
    let rocket_film_cooling_a = film_cooling_spec_default();
    let rocket_film_cooling_b = film_cooling_spec_default();
    if rocket_film_cooling_a.film_mass_fraction != rocket_film_cooling_b.film_mass_fraction {
        println("FAIL rocket_film_cooling");
        process_exit(1);
    }
    println("prod_ap_rocket_film_cooling: PASSED");
}
