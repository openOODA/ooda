// # Product Prove std/security_defense/morpher_semantic_equiv
//
// Logline: Comprehensive verification of semantic equivalence between un-morphed and morphed AST/bytecode transformations.
//
// Setup: Standalone emit-c test fixture importing metamorphic morpher modules.
//
// Beats:
//   1. Verify CFG instruction totals and block connectivity under permutation.
//   2. Verify equivalent instruction substitution preserves zeroing register semantics.
//   3. Verify control flow flattening state dispatcher preserves execution paths for both branch outcomes.
//   4. Verify string literal encryption and rolling XOR decryption preserves exact plaintext bytes.
//   5. Verify number-theoretic opaque predicates evaluate invariant truth values deterministically.
//   6. Verify ROP gadget neutralization preserves non-gadget bytecode.
//   7. Print "prod_g4_sec_morpher_semantic_equiv: PASSED".

import "std/security_defense/basic_block_permutator.oo";
import "std/security_defense/instruction_substitutor.oo";
import "std/security_defense/control_flow_flattening.oo";
import "std/security_defense/opaque_predicate_builder.oo";
import "std/security_defense/string_literal_encryptor.oo";
import "std/security_defense/rop_gadget_destroyer.oo";
import "std/security_defense/metamorphic_pipeline.oo";

pub fn main() {
    // -------------------------------------------------------------
    // Beat 1: CFG Permutation Semantic Equivalence
    // -------------------------------------------------------------
    let mut cfg_orig: FunctionCfg = function_cfg_new("compute_payload", 0);
    let _b0: Bool = function_cfg_add_block(&mut cfg_orig, 0, 5, 1, -1);
    let _b1: Bool = function_cfg_add_block(&mut cfg_orig, 1, 8, 2, 3);
    let _b2: Bool = function_cfg_add_block(&mut cfg_orig, 2, 4, 3, -1);
    let _b3: Bool = function_cfg_add_block(&mut cfg_orig, 3, 2, -1, -1);

    let total_orig_insts: Int = function_cfg_total_instructions(&cfg_orig);
    if total_orig_insts != 19 {
        println("FAIL: orig CFG instruction count mismatch");
        process_exit(1);
    }

    let mut cfg_morphed: FunctionCfg = function_cfg_new("compute_payload", 0);
    let _mb0: Bool = function_cfg_add_block(&mut cfg_morphed, 0, 5, 1, -1);
    let _mb1: Bool = function_cfg_add_block(&mut cfg_morphed, 1, 8, 2, 3);
    let _mb2: Bool = function_cfg_add_block(&mut cfg_morphed, 2, 4, 3, -1);
    let _mb3: Bool = function_cfg_add_block(&mut cfg_morphed, 3, 2, -1, -1);

    let perm_ok: Bool = basic_block_permute_cfg(&mut cfg_morphed, 42);
    if !perm_ok || !(cfg_morphed).is_permuted {
        println("FAIL: basic_block_permute_cfg failed");
        process_exit(1);
    }

    let total_morphed_insts: Int = function_cfg_total_instructions(&cfg_morphed);
    if total_orig_insts != total_morphed_insts {
        println("FAIL: morphed CFG total instructions mismatch");
        process_exit(1);
    }

    // -------------------------------------------------------------
    // Beat 2: Instruction Substitution Semantic Equivalence
    // -------------------------------------------------------------
    let mut stream: InstructionStream = instruction_stream_new();
    let _s0: Bool = instruction_stream_append(&mut stream, 0, 1, 0, 0); // MOV reg1, 0
    let _s1: Bool = instruction_stream_append(&mut stream, 3, 1, 1, 5); // ADD reg1, 5
    let _s2: Bool = instruction_stream_append(&mut stream, 0, 2, 0, 0); // MOV reg2, 0
    let _s3: Bool = instruction_stream_append(&mut stream, 4, 2, 2, 3); // SUB reg2, 3

    let muts: Int = instruction_substitute_zeroing(&mut stream, 99);
    if muts != 2 {
        println("FAIL: expected exactly 2 zeroing substitutions");
        process_exit(1);
    }

    // Verify substituted opcodes are XOR (1) or SUB (2) with same dst and src reg
    let insn0: Instruction = list_get((stream).instructions, 0);
    if (insn0).opcode != 2 || (insn0).dst_reg != 1 || (insn0).src_reg != 1 {
        println("FAIL: instruction 0 substitution error");
        process_exit(1);
    }

    let insn2: Instruction = list_get((stream).instructions, 2);
    if (insn2).opcode != 1 || (insn2).dst_reg != 2 || (insn2).src_reg != 2 {
        println("FAIL: instruction 2 substitution error");
        process_exit(1);
    }

    // -------------------------------------------------------------
    // Beat 3: Control Flow Flattening State Dispatcher Semantic Equivalence
    // -------------------------------------------------------------
    // Model: Block 10 (init) -> if (cond) Block 20 else Block 30 -> Block 40 (term)
    let mut ff_true: FlattenedFunction = flattened_function_new("branch_logic", 10, 99);
    let _fb0: Bool = flattened_function_add_block(&mut ff_true, 10, 3, 30, 20, false);
    let _fb1: Bool = flattened_function_add_block(&mut ff_true, 20, 4, 40, -1, false);
    let _fb2: Bool = flattened_function_add_block(&mut ff_true, 30, 2, 40, -1, false);
    let _fb3: Bool = flattened_function_add_block(&mut ff_true, 40, 1, 99, -1, true);

    // Step 1: from state 10 with cond=true -> goes to state 20
    let cont1: Bool = flattened_function_step(&mut ff_true, true);
    if !cont1 || (ff_true).dispatcher_switch_var != 20 {
        println("FAIL: ff_true step 1 did not reach state 20");
        process_exit(1);
    }

    // Step 2: from state 20 -> goes to state 40
    let cont2: Bool = flattened_function_step(&mut ff_true, false);
    if !cont2 || (ff_true).dispatcher_switch_var != 40 {
        println("FAIL: ff_true step 2 did not reach state 40");
        process_exit(1);
    }

    // Step 3: from state 40 (terminal) -> sets exit_state (99) and returns false
    let cont3: Bool = flattened_function_step(&mut ff_true, false);
    if cont3 || (ff_true).dispatcher_switch_var != 99 {
        println("FAIL: ff_true step 3 did not terminate at exit_state 99");
        process_exit(1);
    }

    // Test False Branch
    let mut ff_false: FlattenedFunction = flattened_function_new("branch_logic", 10, 99);
    let _fbb0: Bool = flattened_function_add_block(&mut ff_false, 10, 3, 30, 20, false);
    let _fbb1: Bool = flattened_function_add_block(&mut ff_false, 20, 4, 40, -1, false);
    let _fbb2: Bool = flattened_function_add_block(&mut ff_false, 30, 2, 40, -1, false);
    let _fbb3: Bool = flattened_function_add_block(&mut ff_false, 40, 1, 99, -1, true);

    // Step 1: from state 10 with cond=false -> goes to state 30
    let fcont1: Bool = flattened_function_step(&mut ff_false, false);
    if !fcont1 || (ff_false).dispatcher_switch_var != 30 {
        println("FAIL: ff_false step 1 did not reach state 30");
        process_exit(1);
    }

    // Step 2: from state 30 -> goes to state 40
    let fcont2: Bool = flattened_function_step(&mut ff_false, false);
    if !fcont2 || (ff_false).dispatcher_switch_var != 40 {
        println("FAIL: ff_false step 2 did not reach state 40");
        process_exit(1);
    }

    // -------------------------------------------------------------
    // Beat 4: String Literal Encryption & Rolling XOR Decryption Equivalence
    // -------------------------------------------------------------
    let mut plain: List[Int] = list_new();
    plain = list_push(plain, 72);  // 'H'
    plain = list_push(plain, 69);  // 'E'
    plain = list_push(plain, 76);  // 'L'
    plain = list_push(plain, 76);  // 'L'
    plain = list_push(plain, 79);  // 'O'

    let payload: EncryptedStringPayload = string_encrypt_bytes(plain, 5, 170);
    let verify_ok: Bool = string_payload_verify(&payload);
    if !verify_ok {
        println("FAIL: encrypted payload checksum validation failed");
        process_exit(1);
    }

    let decrypted: List[Int] = string_decrypt_bytes(&payload);
    if list_len(decrypted) != 5 {
        println("FAIL: decrypted string length mismatch");
        process_exit(1);
    }

    let mut di: Int = 0;
    while di < 5 {
        let orig_b: Int = list_get(plain, di);
        let dec_b: Int = list_get(decrypted, di);
        if orig_b != dec_b {
            println("FAIL: decrypted byte mismatch at index");
            process_exit(1);
        }
        di = di + 1;
    }

    // -------------------------------------------------------------
    // Beat 5: Number-Theoretic Opaque Predicates Invariant Verification
    // -------------------------------------------------------------
    let mut test_x: Int = -10;
    while test_x <= 10 {
        let is_even: Bool = opaque_predicate_eval_even(test_x);
        if !is_even {
            println("FAIL: opaque_predicate_eval_even invariant violated");
            process_exit(1);
        }
        test_x = test_x + 1;
    }

    let mut tx: Int = 0;
    while tx < 7 {
        let mut ty: Int = 0;
        while ty < 7 {
            let is_mod7_eq: Bool = opaque_predicate_eval_mod7(tx, ty);
            if is_mod7_eq {
                println("FAIL: opaque_predicate_eval_mod7 invariant violated");
                process_exit(1);
            }
            ty = ty + 1;
        }
        tx = tx + 1;
    }

    // -------------------------------------------------------------
    // Beat 6: ROP/JOP Gadget Elimination
    // -------------------------------------------------------------
    let mut bc: BytecodeBuffer = bytecode_buffer_new();
    bytecode_buffer_append(&mut bc, 85);  // 0x55 (PUSH RBP)
    bytecode_buffer_append(&mut bc, 195); // 0xC3 (RET in intermediate position)
    bytecode_buffer_append(&mut bc, 90);  // 0x5A (POP RDX)

    let neut: Int = rop_gadget_destroyer_scan_and_pad(&mut bc);
    if neut != 1 {
        println("FAIL: rop gadget count mismatch");
        process_exit(1);
    }
    if (bc).length != 4 {
        println("FAIL: padded bytecode length mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_morpher_semantic_equiv: PASSED");
    process_exit(0);
}
