// # Product prove std/perf/stopwatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/stopwatch.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/stopwatch.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stopwatch: PASSED only if they match.

import "std/perf/stopwatch.oo";

pub fn main() {
    let stopwatch_a = stopwatch_create("x");
    let stopwatch_b = stopwatch_create("x");
    let stopwatch_va = stopwatch_count(stopwatch_a);
    let stopwatch_vb = stopwatch_count(stopwatch_b);
    if stopwatch_va != stopwatch_vb {
        println("FAIL stopwatch");
        process_exit(1);
    }
    println("prod_ap_stopwatch: PASSED");
}
