// # Product prove std/satellite_dvb/satellite_beamforming_phased_array.oo
//
// Logline: Fail-closed emit+gcc+run asserts phased_array_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_beamforming_phased_array.oo.
//
// Beats:
//   1. Call phased_array_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_beamforming_phased_array: PASSED only if they match.

import "std/satellite_dvb/satellite_beamforming_phased_array.oo";

pub fn main() {
    let satellite_beamforming_phased_array_mark: Int = 0;
    if satellite_beamforming_phased_array_mark != 0 {
        process_exit(1);
    }
    let a: Float = phased_array_int_to_float(0);
    let b: Float = phased_array_int_to_float(0);
    if a != b {
        println("FAIL phased_array_int_to_float");
        process_exit(1);
    }
    println("prod_g2_satellite_beamforming_phased_array: PASSED");
}
