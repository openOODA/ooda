// # Product prove std/defi_derivatives/perpetual_virtual_amm_vamm.oo
//
// Logline: Fail-closed emit+gcc+run asserts vamm_pool_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_virtual_amm_vamm.oo.
//
// Beats:
//   1. Call vamm_pool_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_perpetual_virtual_amm_vamm: PASSED only if they match.

import "std/defi_derivatives/perpetual_virtual_amm_vamm.oo";

pub fn main() {
    let a: VammPool = vamm_pool_new("x", 0.0, 0.0, 0.0);
    let b: VammPool = vamm_pool_new("x", 0.0, 0.0, 0.0);
    if a.base_asset_reserve != b.base_asset_reserve {
        println("FAIL vamm_pool_new");
        process_exit(1);
    }
    println("prod_perpetual_virtual_amm_vamm: PASSED");
}
