// # OPEN-89 macro_expand product
//
// Logline: Expand a source string at runtime and print PASSED.
//
// Setup: macro_expand is product, not residual refuse.
//
// Beats:
//   1. Expand hi.
//   2. Print the string.
//   3. Print open89: PASSED.

pub fn main() {
    let s: String = macro_expand("hi");
    println(s);
    println("open89: PASSED");
}

