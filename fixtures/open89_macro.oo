// # OPEN-89 macro_expand evaluates $(const)
//
// Logline: Expand $(1+1) to 2. Identity copy of hi must not pass.
//
// Setup: oo_str_macro_expand in runtime/chs_rt_vision.c.
//
// Beats:
//   1. $(1+1) becomes 2.
//   2. $(2*3) becomes 6.
//   3. Print open89: PASSED.

pub fn main() {
    let s: String = macro_expand("$(1+1)");
    if s != "2" {
        println("FAIL identity");
        process_exit(1);
    }
    let t: String = macro_expand("$(2*3)");
    if t != "6" {
        println("FAIL mul");
        process_exit(1);
    }
    println("open89: PASSED");
}
