// # Product prove std/markup/protobuf_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/protobuf_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/protobuf_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protobuf_types: PASSED only if they match.

import "std/markup/protobuf_types.oo";

pub fn main() {
    let protobuf_types_a = pb_wire_type_for_proto_type("x");
    let protobuf_types_b = pb_wire_type_for_proto_type("x");
    if protobuf_types_a != protobuf_types_b {
        println("FAIL protobuf_types");
        process_exit(1);
    }
    println("prod_ap_protobuf_types: PASSED");
}
