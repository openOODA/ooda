// # Product prove std/ai_multimodal/unet_downsample_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts unet_downsample_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_downsample_block.oo.
//
// Beats:
//   1. Call unet_downsample_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_unet_downsample_block: PASSED only if they match.

import "std/ai_multimodal/unet_downsample_block.oo";

pub fn main() {
    let unet_downsample_block_mark: Int = 0;
    if unet_downsample_block_mark != 0 {
        process_exit(1);
    }
    let a: Int = unet_downsample_marker();
    let b: Int = unet_downsample_marker();
    if a != b {
        println("FAIL unet_downsample_marker");
        process_exit(1);
    }
    println("prod_g2_unet_downsample_block: PASSED");
}
