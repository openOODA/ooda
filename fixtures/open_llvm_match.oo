// # LLVM Result match floor
//
// Logline: Return Ok("ok") and match it so LLVM prints the payload.
//
// Setup: OPEN-30. No caps. LLVM lowers icmp on the Result ok field.
//
// Beats:
//   1. Return Ok("ok") from a helper.
//   2. Match Ok(x) and print x.
//   3. Match Err(e) and print e.

pub fn go() -> Result[String, String] {
    return Ok("ok");
}

pub fn main() {
    let r = go();
    match r {
        Ok(x) => println(x),
        Err(e) => println(e)
    }
}
