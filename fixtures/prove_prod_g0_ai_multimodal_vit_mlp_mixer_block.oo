// # Product prove std/ai_multimodal/vit_mlp_mixer_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts mlp_mixer_gelu is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vit_mlp_mixer_block.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mlp_mixer_gelu twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_vit_mlp_mixer_block: PASSED only if they match.

import "std/ai_multimodal/vit_mlp_mixer_block.oo";

pub fn main() {
    let g0_a = mlp_mixer_gelu(1.0);
    let g0_b = mlp_mixer_gelu(1.0);
    if g0_a != g0_b {
        println("FAIL mlp_mixer_gelu");
        process_exit(1);
    }
    println("prod_g0_vit_mlp_mixer_block: PASSED");
}
