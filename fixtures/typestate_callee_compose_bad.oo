// # Compose actually twice
//
// Logline: Call actually twice inside wrap so the second Closed-to-Open step must fail.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Enter wrap from Closed.
//   3. Call actually twice.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn actually: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }

fn wrap(s: Int) {
    let z = 1;
    actually(s);
    actually(s);
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
