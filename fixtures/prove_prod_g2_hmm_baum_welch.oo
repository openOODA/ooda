// # Product prove std/bio_advanced/hmm_baum_welch.oo
//
// Logline: Fail-closed emit+gcc+run asserts baum_welch_reestimate_transition is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_baum_welch.oo.
//
// Beats:
//   1. Call baum_welch_reestimate_transition twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hmm_baum_welch: PASSED only if they match.

import "std/bio_advanced/hmm_baum_welch.oo";

pub fn main() {
    let hmm_baum_welch_mark: Int = 0;
    if hmm_baum_welch_mark != 0 {
        process_exit(1);
    }
    let a: Float = baum_welch_reestimate_transition(0.0, 0.0, 0.0, 0);
    let b: Float = baum_welch_reestimate_transition(0.0, 0.0, 0.0, 0);
    if a != b {
        println("FAIL baum_welch_reestimate_transition");
        process_exit(1);
    }
    println("prod_g2_hmm_baum_welch: PASSED");
}
