// # Product prove std/robot/safety_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/robot/safety_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/safety_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_safety_ops: PASSED only if they match.

import "std/robot/safety_ops.oo";

pub fn main() {
    let safety_ops_a = safety_clamp_speed(0, 0);
    let safety_ops_b = safety_clamp_speed(0, 0);
    if safety_ops_a != safety_ops_b {
        println("FAIL safety_ops");
        process_exit(1);
    }
    println("prod_ap_safety_ops: PASSED");
}
