// # Product prove std/3d/lights.oo
//
// Logline: Fail-closed verification that 3D lights facade and lighting engine operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights.oo.
//
// Beats:
//   1. Call shim markers and construct ambient, directional, point, and spot lights.
//   2. Mutate light parameters and assert deterministic getters and sums.
//   3. Print prod_g4_3d_lights: PASSED only if all match.

import "std/3d/lights.oo";

pub fn main() {
    let col: LightColor = shim_marker_light_color_white();
    if (col).r != 255 || (col).g != 255 || (col).b != 255 || (col).a != 255 {
        println("FAIL shim_marker_light_color_white");
        process_exit(1);
    }

    let black_col: LightColor = light_color_black();
    if (black_col).r != 0 || (black_col).g != 0 || (black_col).b != 0 || (black_col).a != 255 {
        println("FAIL light_color_black");
        process_exit(1);
    }

    let amb: AmbientLight = shim_marker_ambient_light_default();
    let amb_mod: AmbientLight = ambient_light_set_intensity(amb, 80);
    let amb_int: Int = ambient_light_get_intensity(amb_mod);
    if amb_int != 80 {
        println("FAIL ambient_light_get_intensity");
        process_exit(1);
    }

    let dir: DirectionalLight = shim_marker_directional_light_default();
    let dir_mod: DirectionalLight = directional_light_set_direction(dir, 1, 2, 3);
    let dir_sum: Int = directional_light_dir_sum(dir_mod);
    if dir_sum != 6 {
        println("FAIL directional_light_dir_sum");
        process_exit(1);
    }

    let pt: PointLight = shim_marker_point_light_default();
    let pt_mod: PointLight = point_light_set_position(pt, 10, 20, 30);
    let pt_sum: Int = point_light_pos_sum(pt_mod);
    if pt_sum != 60 {
        println("FAIL point_light_pos_sum");
        process_exit(1);
    }

    let spot: SpotLight = shim_marker_spot_light_default();
    let spot_sum: Int = spot_light_pos_sum(spot);
    if spot_sum != 10 {
        println("FAIL spot_light_pos_sum");
        process_exit(1);
    }

    println("prod_g4_3d_lights: PASSED");
    process_exit(0);
}
