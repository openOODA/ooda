// # Product prove std/db_graph/graph_community_louvain.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_community_louvain.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_community_louvain.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_community_louvain: PASSED only if they match.

import "std/db_graph/graph_community_louvain.oo";

pub fn main() {
    let graph_community_louvain_a = louvain_init_communities(0);
    let graph_community_louvain_b = louvain_init_communities(0);
    if list_len(graph_community_louvain_a) != list_len(graph_community_louvain_b) {
        println("FAIL graph_community_louvain");
        process_exit(1);
    }
    println("prod_ap_graph_community_louvain: PASSED");
}
