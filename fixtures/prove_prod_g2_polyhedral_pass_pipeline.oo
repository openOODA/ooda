// # Product prove std/compilers_polyhedral/polyhedral_pass_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts compiler_pass_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_pass_pipeline.oo.
//
// Beats:
//   1. Call compiler_pass_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_pass_pipeline: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_pass_pipeline.oo";

pub fn main() {
    let polyhedral_pass_pipeline_mark: Int = 0;
    if polyhedral_pass_pipeline_mark != 0 {
        process_exit(1);
    }
    let a: CompilerPass = compiler_pass_new(0, "x", true);
    let b: CompilerPass = compiler_pass_new(0, "x", true);
    if (a).pass_id != (b).pass_id {
        println("FAIL compiler_pass_new");
        process_exit(1);
    }
    println("prod_g2_polyhedral_pass_pipeline: PASSED");
}
