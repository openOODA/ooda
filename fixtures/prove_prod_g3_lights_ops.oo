// # Product prove std/3d/lights_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights_ops.oo.
//
// Beats:
//   1. Call light_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lights_ops: PASSED only if they match.

import "std/3d/lights_ops.oo";

pub fn main() {
    let lights_ops_mark: Int = 0;
    if lights_ops_mark != 0 {
        process_exit(1);
    }
    let a: LightOp = light_op_new(0, 0);
    let b: LightOp = light_op_new(0, 0);
    if (a).kind != (b).kind {
        println("FAIL light_op_new");
        process_exit(1);
    }
    println("prod_lights_ops: PASSED");
}
