// # Sixteen println string statements
//
// Logline: Print sixteen string literals so emit-wasm can plant all sixteen texts.
//
// Setup: One public main. Body is only sixteen println(STRING) statements.
//
// Beats:
//   1. Print line-a through line-h.
//   2. Print line-i through line-p.
//   3. Leave no other statements.

pub fn main() {
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println("line-g");
    println("line-h");
    println("line-i");
    println("line-j");
    println("line-k");
    println("line-l");
    println("line-m");
    println("line-n");
    println("line-o");
    println("line-p");
}
