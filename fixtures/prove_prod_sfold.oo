// # Product stream_fold prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_fold_sum_int.
//
// Setup: Product std/io/stream_fold.oo. Local List[Int] 1+2+3.
//
// Beats:
//   1. Sum of 1,2,3 is 6.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_fold.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    xs = list_push(xs, 3);
    let s: Int = stream_fold_sum_int(xs);
    if s != 6 {
        println("FAIL sfold sum");
        process_exit(1);
    }
    println("prod_sfold: PASSED");
}
