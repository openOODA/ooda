// # Product prove std/cloud/raft_log.oo
//
// Logline: Fail-closed emit+gcc+run asserts raft_log_last_index is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud/raft_log.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call raft_log_last_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_raft_log: PASSED only if they match.

import "std/cloud/raft_log.oo";

pub fn main() {
    let g0_oa = raft_log_new();
    let g0_ob = raft_log_new();
    let g0_a = raft_log_last_index(&g0_oa);
    let g0_b = raft_log_last_index(&g0_ob);
    if g0_a != g0_b {
        println("FAIL raft_log_last_index");
        process_exit(1);
    }
    println("prod_gr_raft_log: PASSED");
}
