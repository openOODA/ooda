// # Product prove std/db_columnar/parquet_column_chunk_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts column_chunk_reader_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_column_chunk_reader.oo.
//
// Beats:
//   1. Call column_chunk_reader_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_column_chunk_reader: PASSED only if they match.

import "std/db_columnar/parquet_column_chunk_reader.oo";

pub fn main() {
    let parquet_column_chunk_reader_mark: Int = 0;
    if parquet_column_chunk_reader_mark != 0 {
        process_exit(1);
    }
    let a: ColumnChunkReader = column_chunk_reader_new("x", 0, 0);
    let b: ColumnChunkReader = column_chunk_reader_new("x", 0, 0);
    if (a).total_values != (b).total_values {
        println("FAIL column_chunk_reader_new");
        process_exit(1);
    }
    println("prod_parquet_column_chunk_reader: PASSED");
}
