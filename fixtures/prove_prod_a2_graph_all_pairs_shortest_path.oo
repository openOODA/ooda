// # Product prove std/db_graph/graph_all_pairs_shortest_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts apsp_matrix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_all_pairs_shortest_path.oo.
//
// Beats:
//   1. Call apsp_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_all_pairs_shortest_path: PASSED only if they match.

import "std/db_graph/graph_all_pairs_shortest_path.oo";

pub fn main() {
    let graph_all_pairs_shortest_path_mark: Int = 0;
    if graph_all_pairs_shortest_path_mark != 0 {
        process_exit(1);
    }
    let a: APSPDistanceMatrix = apsp_matrix_new(0);
    let b: APSPDistanceMatrix = apsp_matrix_new(0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL apsp_matrix_new");
        process_exit(1);
    }
    println("prod_graph_all_pairs_shortest_path: PASSED");
}
