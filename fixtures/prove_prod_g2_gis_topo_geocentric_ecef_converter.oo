// # Product prove std/gis_topo/geocentric_ecef_converter.oo
//
// Logline: Fail-closed emit+gcc+run asserts ecef_point_new is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geocentric_ecef_converter.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ecef_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_geocentric_ecef_converter: PASSED only if they match.

import "std/gis_topo/geocentric_ecef_converter.oo";

pub fn main() {
    let g2_oa: EcefPoint = ecef_point_new(1.0, 1.0, 1.0);
    let g2_ob: EcefPoint = ecef_point_new(1.0, 1.0, 1.0);
    let g2_a = (g2_oa).x_m;
    let g2_b = (g2_ob).x_m;
    if g2_a != g2_b {
        println("FAIL ecef_point_new.x_m");
        process_exit(1);
    }
    println("prod_g2_geocentric_ecef_converter: PASSED");
}
