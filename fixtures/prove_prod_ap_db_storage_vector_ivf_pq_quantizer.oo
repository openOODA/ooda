// # Product prove std/db_storage/vector_ivf_pq_quantizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/vector_ivf_pq_quantizer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/vector_ivf_pq_quantizer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_vector_ivf_pq_quantizer: PASSED only if they match.

import "std/db_storage/vector_ivf_pq_quantizer.oo";

pub fn main() {
    let vector_ivf_pq_quantizer_a = ivf_pq_config_default();
    let vector_ivf_pq_quantizer_b = ivf_pq_config_default();
    if vector_ivf_pq_quantizer_a.num_centroids != vector_ivf_pq_quantizer_b.num_centroids {
        println("FAIL vector_ivf_pq_quantizer");
        process_exit(1);
    }
    println("prod_ap_vector_ivf_pq_quantizer: PASSED");
}
