// # Product prove std/ai_multimodal/diffusion_edm_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/diffusion_edm_sampler.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_edm_sampler.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diffusion_edm_sampler: PASSED only if they match.

import "std/ai_multimodal/diffusion_edm_sampler.oo";

pub fn main() {
    let diffusion_edm_sampler_a = edm_sigma_terminal();
    let diffusion_edm_sampler_b = edm_sigma_terminal();
    if diffusion_edm_sampler_a != diffusion_edm_sampler_b {
        println("FAIL diffusion_edm_sampler");
        process_exit(1);
    }
    println("prod_ap_diffusion_edm_sampler: PASSED");
}
