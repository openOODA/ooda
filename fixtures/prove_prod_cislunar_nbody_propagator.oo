// # Product prove std/astro_advanced/cislunar_nbody_propagator.oo
//
// Logline: Fail-closed emit+gcc+run asserts nbody_bodies is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/cislunar_nbody_propagator.oo.
//
// Beats:
//   1. Call nbody_bodies twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cislunar_nbody_propagator: PASSED only if they match.

import "std/astro_advanced/cislunar_nbody_propagator.oo";

pub fn main() {
    let a = nbody_bodies();
    let b = nbody_bodies();
    if a != b {
        println("FAIL nbody_bodies");
        process_exit(1);
    }
    println("prod_cislunar_nbody_propagator: PASSED");
}
