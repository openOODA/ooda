// # emit-x86 const-int greater if
//
// Logline: If 2 is greater than 1 print yes else no.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the true greater branch.
//   3. as+ld stdout is yes only.
//
// residual: SysV stays later.

pub fn main() {
    if 2 > 1 {
        println("yes");
    } else {
        println("no");
    }
}
