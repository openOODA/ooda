// # Product prove std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo
//
// Logline: Fail-closed emit+gcc+run asserts apf_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo.
//
// Beats:
//   1. Call apf_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dynamic_obstacle_avoidance_apf: PASSED only if they match.

import "std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo";

pub fn main() {
    let dynamic_obstacle_avoidance_apf_mark: Int = 0;
    if dynamic_obstacle_avoidance_apf_mark != 0 {
        process_exit(1);
    }
    let a: APFConfig = apf_config_default();
    let b: APFConfig = apf_config_default();
    if (a).k_att != (b).k_att {
        println("FAIL apf_config_default");
        process_exit(1);
    }
    println("prod_g2_dynamic_obstacle_avoidance_apf: PASSED");
}
