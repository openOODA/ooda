// # Product prove std/db_graph/opencypher_cost_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_cost_estimator.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_cost_estimator.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_cost_estimator: PASSED only if they match.

import "std/db_graph/opencypher_cost_estimator.oo";

pub fn main() {
    let opencypher_cost_estimator_a = graph_catalog_stats_default();
    let opencypher_cost_estimator_b = graph_catalog_stats_default();
    if opencypher_cost_estimator_a.total_node_count != opencypher_cost_estimator_b.total_node_count {
        println("FAIL opencypher_cost_estimator");
        process_exit(1);
    }
    println("prod_ap_opencypher_cost_estimator: PASSED");
}
