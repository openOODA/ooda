// # Std Smoke Proof
//
// Logline: Unified proof fixture exercising standard library core modules (list, result, option, str, math, test).
//
// Setup: Pure operations and test runner assertions across core stdlib modules.
//
// Beats:
//   1. Verify result helpers (res_ok, res_err, res_is_ok, res_is_err, res_unwrap_or, res_ok_eq).
//   2. Verify option helpers (opt_some, opt_none, opt_is_some, opt_is_none, opt_unwrap_or).
//   3. Verify list helpers (list_new, list_push, list_len, list_get, list_is_empty).
//   4. Verify string helpers (str_len, str_concat, str_contains, str_char_at, str_sub, parse_int).
//   5. Verify math helpers (math_sin, math_cos, math_sqrt, math_pow).
//   6. Verify test runner summary.

import "std/test.oo";
import "std/result.oo";
import "std/option.oo";
import "std/str.oo";
import "std/math.oo";
import "std/core/list.oo";

pub fn main() {
    let mut tr: TestRunner = test_runner_new();

    // 1. Result tests
    let ok_res: Result[String, String] = res_ok("hello");
    let err_res: Result[String, String] = res_err("failure");
    tr = test_assert(tr, "result is_ok", res_is_ok(ok_res));
    tr = test_assert(tr, "result is_err", res_is_err(err_res));
    tr = test_assert_eq_str(tr, "result unwrap ok", res_unwrap_or(ok_res, "default"), "hello");
    tr = test_assert_eq_str(tr, "result unwrap err", res_unwrap_or(err_res, "default"), "default");
    tr = test_assert(tr, "result ok eq true", res_ok_eq(ok_res, "hello"));
    tr = test_assert(tr, "result ok eq false on mismatch", !res_ok_eq(ok_res, "world"));
    tr = test_assert(tr, "result ok eq false on err", !res_ok_eq(err_res, "failure"));

    // 2. Option tests
    let some_opt: Result[String, String] = opt_some("value");
    let none_opt: Result[String, String] = opt_none();
    tr = test_assert(tr, "opt is_some", opt_is_some(some_opt));
    tr = test_assert(tr, "opt is_none", opt_is_none(none_opt));
    tr = test_assert_eq_str(tr, "opt unwrap some", opt_unwrap_or(some_opt, "none"), "value");
    tr = test_assert_eq_str(tr, "opt unwrap none", opt_unwrap_or(none_opt, "none"), "none");

    // 3. List tests
    let mut xs: List[Int] = list_new();
    tr = test_assert(tr, "list initially empty", list_is_empty(xs));
    xs = list_push(xs, 10);
    xs = list_push(xs, 20);
    xs = list_push(xs, 30);
    tr = test_assert_eq_int(tr, "list length", list_len(xs), 3);
    tr = test_assert(tr, "list not empty", !list_is_empty(xs));
    tr = test_assert_eq_int(tr, "list get index 0", list_get(xs, 0), 10);
    tr = test_assert_eq_int(tr, "list get index 1", list_get(xs, 1), 20);
    tr = test_assert_eq_int(tr, "list get index 2", list_get(xs, 2), 30);

    // 4. String tests
    let s1: String = "OpenOODA";
    let s2: String = " 2.0";
    let s_cat: String = str_concat(s1, s2);
    tr = test_assert_eq_int(tr, "str len", str_len(s_cat), 12);
    tr = test_assert(tr, "str contains", str_contains(s_cat, "OODA"));
    tr = test_assert(tr, "str eq", str_eq(s_cat, "OpenOODA 2.0"));
    tr = test_assert(tr, "str is empty false", !str_is_empty(s_cat));
    tr = test_assert(tr, "str is empty true", str_is_empty(""));
    tr = test_assert_eq_str(tr, "str char at", str_char_at(s1, 0), "O");
    tr = test_assert_eq_str(tr, "str sub", str_sub(s1, 0, 4), "Open");
    let num_val: Int = parse_int("42");
    tr = test_assert_eq_int(tr, "parse_int positive", num_val, 42);
    let neg_num: Int = parse_int("-100");
    tr = test_assert_eq_int(tr, "parse_int negative", neg_num, -100);

    // 5. Math tests
    let sq: Float = math_sqrt(16.0);
    let pw: Float = math_pow(2.0, 3.0);
    let s_val: Float = math_sin(0.0);
    let c_val: Float = math_cos(0.0);
    tr = test_assert(tr, "math sqrt 16 == 4", sq == 4.0);
    tr = test_assert(tr, "math pow 2^3 == 8", pw == 8.0);
    tr = test_assert(tr, "math sin 0 == 0", s_val == 0.0);
    tr = test_assert(tr, "math cos 0 == 1", c_val == 1.0);

    // 6. Summary
    test_summary(tr);
}
