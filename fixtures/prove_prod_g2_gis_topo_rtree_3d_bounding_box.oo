// # Product prove std/gis_topo/rtree_3d_bounding_box.oo
//
// Logline: Fail-closed emit+gcc+run asserts bbox3d_volume is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/rtree_3d_bounding_box.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bbox3d_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rtree_3d_bounding_box: PASSED only if they match.

import "std/gis_topo/rtree_3d_bounding_box.oo";

pub fn main() {
    let g2_oa: BoundingBox3D = BoundingBox3D { min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g2_ob: BoundingBox3D = BoundingBox3D { min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g2_a = bbox3d_volume(&g2_oa);
    let g2_b = bbox3d_volume(&g2_ob);
    if g2_a != g2_b {
        println("FAIL bbox3d_volume");
        process_exit(1);
    }
    println("prod_g2_rtree_3d_bounding_box: PASSED");
}
