// # Product prove std/compilers_vm/bytecode_profiler_telemetry.oo
//
// Logline: Fail-closed emit+gcc+run asserts branch_feedback_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_profiler_telemetry.oo.
//
// Beats:
//   1. Call branch_feedback_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bytecode_profiler_telemetry: PASSED only if they match.

import "std/compilers_vm/bytecode_profiler_telemetry.oo";

pub fn main() {
    let bytecode_profiler_telemetry_mark: Int = 0;
    if bytecode_profiler_telemetry_mark != 0 {
        process_exit(1);
    }
    let a: BranchFeedback = branch_feedback_new(0);
    let b: BranchFeedback = branch_feedback_new(0);
    if (a).branch_bc_offset != (b).branch_bc_offset {
        println("FAIL branch_feedback_new");
        process_exit(1);
    }
    println("prod_g2_bytecode_profiler_telemetry: PASSED");
}
