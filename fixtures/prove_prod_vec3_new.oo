// # Product prove std/robotics_auv/auv_hydrodynamics_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_hydrodynamics_constants.oo.
//
// Beats:
//   1. Call vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vec3_new: PASSED only if they match.

import "std/robotics_auv/auv_hydrodynamics_constants.oo";

pub fn main() {
    let auv_hydrodynamics_constants_mark: Int = 0;
    if auv_hydrodynamics_constants_mark != 0 { process_exit(1); }
    let a: Vector3 = vec3_new(1.0, 2.0, 3.0);
    let b: Vector3 = vec3_new(1.0, 2.0, 3.0);
    let ax: Float = (a).x;
    let bx: Float = (b).x;
    if ax != bx {
        println("FAIL vec3_new");
        process_exit(1);
    }
    println("prod_vec3_new: PASSED");
}
