// # Product prove std/nerf_3dgs/nerf_positional_volumetric.oo
//
// Logline: Fail-closed emit+gcc+run asserts nerf_network_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_positional_volumetric.oo.
//
// Beats:
//   1. Call nerf_network_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nerf_positional_volumetric: PASSED only if they match.

import "std/nerf_3dgs/nerf_positional_volumetric.oo";

pub fn main() {
    let nerf_positional_volumetric_mark: Int = 0;
    if nerf_positional_volumetric_mark != 0 {
        process_exit(1);
    }
    let a: NeRFNetworkConfig = nerf_network_config_default();
    let b: NeRFNetworkConfig = nerf_network_config_default();
    if (a).num_layers_pos != (b).num_layers_pos {
        println("FAIL nerf_network_config_default");
        process_exit(1);
    }
    println("prod_g2_nerf_positional_volumetric: PASSED");
}
