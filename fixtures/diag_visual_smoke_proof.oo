// # Visual Diagnostic Formatter Proof Fixture
//
// Logline: Proves source line extraction, column padding, caret underline generation, and visual error formatting.
//
// Setup: Pure text formatting verification fixture without ambient effects.
//
// Beats:
//   1. Extract source line by index.
//   2. Generate column-accurate caret pointers.
//   3. Render complete visual error message.
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.6: Prove visual formatting accuracy.
// RULES.oot 1.7: Under 256 lines.

import "cli/diag_fmt.oo";

pub fn main() {
    let sample_src: String = "pub fn calculate() -> Int {\n    let val: Int = \"invalid\";\n    return val;\n}\n";

    // 1. Verify line extraction
    let l2: String = extract_source_line(sample_src, 2);
    if l2 != "    let val: Int = \"invalid\";" {
        println("FAIL: extract_source_line mismatch: " + l2);
        process_exit(1);
    }

    // 2. Verify caret line
    let caret: String = make_caret_line(5, 7, "expected Int");
    if !caret.contains("    ^^^^^^^ expected Int") {
        println("FAIL: make_caret_line mismatch: " + caret);
        process_exit(1);
    }

    // 3. Verify complete diagnostic
    let diag: String = format_visual_diagnostic(sample_src, "src/main.oo", 2, 20, "E_TYPE", "type mismatch");
    if !diag.contains("error[E_TYPE]: type mismatch") {
        println("FAIL: diag missing error header");
        process_exit(1);
    }
    if !diag.contains("--> src/main.oo:2:20") {
        println("FAIL: diag missing location arrow");
        process_exit(1);
    }
    if !diag.contains(" 2 |     let val: Int = \"invalid\";") {
        println("FAIL: diag missing source line context");
        process_exit(1);
    }

    println("RENDERED DIAGNOSTIC:\n" + diag);
    println("OK: DIAG_VISUAL_SMOKE_PROOF_PASSED");
}
