// # Product prove std/auto_robot/differential_drive.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/differential_drive.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/differential_drive.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_differential_drive: PASSED only if they match.

import "std/auto_robot/differential_drive.oo";

pub fn main() {
    let differential_drive_a = diff_v_left(0, 0, 0);
    let differential_drive_b = diff_v_left(0, 0, 0);
    if differential_drive_a != differential_drive_b {
        println("FAIL differential_drive");
        process_exit(1);
    }
    println("prod_ap_differential_drive: PASSED");
}
