// # Product prove std/physics_advanced/lattice_boltzmann_boundary.oo
//
// Logline: Fail-closed emit+gcc+run asserts lbm_bounce_back_opposite is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_boundary.oo.
//
// Beats:
//   1. Call lbm_bounce_back_opposite twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lattice_boltzmann_boundary: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_boundary.oo";

pub fn main() {
    let lattice_boltzmann_boundary_mark: Int = 0;
    if lattice_boltzmann_boundary_mark != 0 {
        process_exit(1);
    }
    let a: Int = lbm_bounce_back_opposite(0);
    let b: Int = lbm_bounce_back_opposite(0);
    if a != b {
        println("FAIL lbm_bounce_back_opposite");
        process_exit(1);
    }
    println("prod_lattice_boltzmann_boundary: PASSED");
}
