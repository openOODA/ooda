// # Product prove std/quantum_open_systems/dissipative_kerr_soliton.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/dissipative_kerr_soliton.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/dissipative_kerr_soliton.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dissipative_kerr_soliton: PASSED only if they match.

import "std/quantum_open_systems/dissipative_kerr_soliton.oo";

pub fn main() {
    let dissipative_kerr_soliton_a = kerr_cavity_params_new(0.0, 0.0, 0.0, 0.0);
    let dissipative_kerr_soliton_b = kerr_cavity_params_new(0.0, 0.0, 0.0, 0.0);
    let dissipative_kerr_soliton_va = kerr_threshold_drive(dissipative_kerr_soliton_a);
    let dissipative_kerr_soliton_vb = kerr_threshold_drive(dissipative_kerr_soliton_b);
    if dissipative_kerr_soliton_va != dissipative_kerr_soliton_vb {
        println("FAIL dissipative_kerr_soliton");
        process_exit(1);
    }
    println("prod_ap_dissipative_kerr_soliton: PASSED");
}
