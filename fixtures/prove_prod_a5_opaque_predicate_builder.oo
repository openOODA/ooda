// # Product prove std/security_defense/opaque_predicate_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts opaque_predicate_eval_even is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/opaque_predicate_builder.oo.
//
// Beats:
//   1. Call opaque_predicate_eval_even twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opaque_predicate_builder: PASSED only if they match.

import "std/security_defense/opaque_predicate_builder.oo";

pub fn main() {
    let opaque_predicate_builder_mark: Int = 0;
    if opaque_predicate_builder_mark != 0 {
        process_exit(1);
    }
    let a: Bool = opaque_predicate_eval_even(0);
    let b: Bool = opaque_predicate_eval_even(0);
    if a != b {
        println("FAIL opaque_predicate_eval_even");
        process_exit(1);
    }
    println("prod_opaque_predicate_builder: PASSED");
}
