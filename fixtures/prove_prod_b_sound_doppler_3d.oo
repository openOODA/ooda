// # Product prove std/physics_advanced/sound_doppler_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts sound_doppler_3d_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/sound_doppler_3d.oo.
//
// Beats:
//   1. Call sound_doppler_3d_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sound_doppler_3d: PASSED only if they match.

import "std/physics_advanced/sound_doppler_3d.oo";

pub fn main() {
    let a = sound_doppler_3d_probe();
    let b = sound_doppler_3d_probe();
    if a != b {
        println("FAIL sound_doppler_3d_probe");
        process_exit(1);
    }
    println("prod_sound_doppler_3d: PASSED");
}
