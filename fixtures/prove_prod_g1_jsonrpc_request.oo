// # Product prove std/web_protocols/jsonrpc_request.oo
//
// Logline: Fail-closed emit+gcc+run asserts jsonrpc_is_notification is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/jsonrpc_request.oo.
//
// Beats:
//   1. Call jsonrpc_is_notification twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jsonrpc_request: PASSED only if they match.

import "std/web_protocols/jsonrpc_request.oo";

pub fn main() {
    let obj_a: JsonRpcRequest = jsonrpc_request_new(0, 0, 0);
    let obj_b: JsonRpcRequest = jsonrpc_request_new(0, 0, 0);
    let a: Int = jsonrpc_is_notification(obj_a);
    let b: Int = jsonrpc_is_notification(obj_b);
    if a != b {
        println("FAIL jsonrpc_is_notification");
        process_exit(1);
    }
    println("prod_jsonrpc_request: PASSED");
}
