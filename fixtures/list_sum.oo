// # List[Int] for-sum
//
// Logline: Push 1, 2, 3 and print their for-loop sum.
//
// Beats:
//   1. Method-push 1, 2, 3.
//   2. For-each add into s.
//   3. Print 6.

// List[Int] for-sum: method push + for desugar → list_get/list_len (interp + WASM).
pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = xs.push(1);
    xs = xs.push(2);
    xs = xs.push(3);
    let mut s = 0;
    for x in xs {
        s = s + x;
    }
    println(s);
}
