// # Product prove std/astrophysics_relativity/accretion_disk_advection_dominated.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/accretion_disk_advection_dominated.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/accretion_disk_advection_dominated.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_accretion_disk_advection_dominated: PASSED only if they match.

import "std/astrophysics_relativity/accretion_disk_advection_dominated.oo";

pub fn main() {
    let accretion_disk_advection_dominated_a = adaf_self_similar_evaluate(0, 0, 0, 0, 0);
    let accretion_disk_advection_dominated_b = adaf_self_similar_evaluate(0, 0, 0, 0, 0);
    let accretion_disk_advection_dominated_va = adaf_eta(accretion_disk_advection_dominated_a);
    let accretion_disk_advection_dominated_vb = adaf_eta(accretion_disk_advection_dominated_b);
    if accretion_disk_advection_dominated_va != accretion_disk_advection_dominated_vb {
        println("FAIL accretion_disk_advection_dominated");
        process_exit(1);
    }
    println("prod_ap_accretion_disk_advection_dominated: PASSED");
}
