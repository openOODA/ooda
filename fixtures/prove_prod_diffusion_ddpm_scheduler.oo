// # Product prove std/ai_multimodal/diffusion_ddpm_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts ddpm_beta_at real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_ddpm_scheduler.oo.
//
// Beats:
//   1. Call ddpm_beta_at with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_diffusion_ddpm_scheduler: PASSED only if the assert holds.

import "std/ai_multimodal/diffusion_ddpm_scheduler.oo";

pub fn main() {
    let diffusion_ddpm_scheduler_mark: Int = 0;
    if diffusion_ddpm_scheduler_mark != 0 {
        process_exit(1);
    }
    let diffusion_ddpm_scheduler_n: Int = ddpm_beta_at(0, 42, 0, 0);
    if diffusion_ddpm_scheduler_n != 42 {
        println("FAIL ddpm_beta_at");
        process_exit(1);
    }
    println("prod_diffusion_ddpm_scheduler: PASSED");
}
