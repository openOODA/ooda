// # Const if true else-if false println
//
// Logline: Print elif-yes when the body is if true else if false else.
//
// Setup: No imports. One public main. Body is only that const else-if chain.
//
// Beats:
//   1. Declare public main.
//   2. If true print elif-yes else if false print elif-mid else print elif-no.
//   3. Leave no other statements.

pub fn main() {
    if true {
        println("elif-yes");
    } else if false {
        println("elif-mid");
    } else {
        println("elif-no");
    }
}
