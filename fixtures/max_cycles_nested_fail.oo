// # Nested while exceeds budget
//
// Logline: Nest two while i/j < 3 loops under a five-cycle per-fn budget.
//
// Beats:
//   1. Keep the five-cycle marker.
//   2. Outer while i < 3; inner while j < 3.
//   3. Expect the shared budget to trip before println.

// M77 nested while shares per-fn budget
// MAX_CYCLES: 5
pub fn main() {
    let mut i = 0;
    while i < 3 {
        let mut j = 0;
        while j < 3 {
            j = j + 1;
        }
        i = i + 1;
    }
    println(i);
}
