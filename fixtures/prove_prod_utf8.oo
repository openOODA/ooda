// # Product UTF-8 validator prove
//
// Logline: Fail-closed emit+gcc+run of shipped utf8_sequence_len / continuation.
//
// Setup: Product std/text/utf8_validator.oo. RFC 3629 lead-byte lengths.
//
// Beats:
//   1. ASCII 65 sequence length is 1.
//   2. Lead 195 (0xC3) sequence length is 2.
//   3. 128 is a continuation byte; 65 is not.
//   4. Exit 1 before PASSED on a miss.

import "std/text/utf8_validator.oo";

pub fn main() {
    let a: Int = utf8_sequence_len(65);
    if a != 1 {
        println("FAIL utf8 ascii");
        process_exit(1);
    }
    let two: Int = utf8_sequence_len(195);
    if two != 2 {
        println("FAIL utf8 2byte");
        process_exit(1);
    }
    let cont: Bool = utf8_is_continuation_byte(128);
    if cont == false {
        println("FAIL utf8 cont");
        process_exit(1);
    }
    let lead: Bool = utf8_is_continuation_byte(65);
    if lead == true {
        println("FAIL utf8 lead");
        process_exit(1);
    }
    println("prod_utf8: PASSED");
}
