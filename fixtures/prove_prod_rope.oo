// # Product rope_string prove
//
// Logline: Fail-closed emit+gcc+run of shipped rope_new/concat/to_string.
//
// Setup: Product std/text/rope_string.oo. String-floor destub.
//
// Beats:
//   1. rope("ab")+rope("cd") is "abcd" len 4.
//   2. Exit 1 before PASSED on a miss.

import "std/text/rope_string.oo";

pub fn main() {
    let a: Rope = rope_new("ab");
    let b: Rope = rope_new("cd");
    let c: Rope = rope_concat(a, b);
    let n: Int = rope_len(c);
    if n != 4 {
        println("FAIL rope len");
        process_exit(1);
    }
    let s: String = rope_to_string(c);
    if s != "abcd" {
        println("FAIL rope text");
        process_exit(1);
    }
    println("prod_rope: PASSED");
}
