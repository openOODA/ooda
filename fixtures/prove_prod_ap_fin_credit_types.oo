// # Product prove std/fin/credit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/credit_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_credit_types: PASSED only if they match.

import "std/fin/credit_types.oo";

pub fn main() {
    let credit_types_a = credit_score_new(0, 0, 0);
    let credit_types_b = credit_score_new(0, 0, 0);
    let credit_types_va = credit_score_value(credit_types_a);
    let credit_types_vb = credit_score_value(credit_types_b);
    if credit_types_va != credit_types_vb {
        println("FAIL credit_types");
        process_exit(1);
    }
    println("prod_ap_credit_types: PASSED");
}
