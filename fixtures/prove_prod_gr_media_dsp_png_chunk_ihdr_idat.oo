// # Product prove std/media_dsp/png_chunk_ihdr_idat.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_color_type_grayscale is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/png_chunk_ihdr_idat.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call png_color_type_grayscale twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_png_chunk_ihdr_idat: PASSED only if they match.

import "std/media_dsp/png_chunk_ihdr_idat.oo";

pub fn main() {
    let g0_a = png_color_type_grayscale();
    let g0_b = png_color_type_grayscale();
    if g0_a != g0_b {
        println("FAIL png_color_type_grayscale");
        process_exit(1);
    }
    println("prod_gr_png_chunk_ihdr_idat: PASSED");
}
