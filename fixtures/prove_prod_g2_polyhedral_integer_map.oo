// # Product prove std/compilers_polyhedral/polyhedral_integer_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts map_dimension_mapping_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_integer_map.oo.
//
// Beats:
//   1. Call map_dimension_mapping_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_integer_map: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_integer_map.oo";

pub fn main() {
    let polyhedral_integer_map_mark: Int = 0;
    if polyhedral_integer_map_mark != 0 {
        process_exit(1);
    }
    let a: MapDimensionMapping = map_dimension_mapping_new(0, list_new(), 0);
    let b: MapDimensionMapping = map_dimension_mapping_new(0, list_new(), 0);
    if (a).out_dim_idx != (b).out_dim_idx {
        println("FAIL map_dimension_mapping_new");
        process_exit(1);
    }
    println("prod_g2_polyhedral_integer_map: PASSED");
}
