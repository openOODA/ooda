// # Result[List[Float]] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[List[Float], String] Ok list get.
//
// Setup: Backend-C. Ok payload is List[Float], not a string.
//
// Beats:
//   1. xs returns Ok of a one-float list.
//   2. Match binds the list and list_get is 2.5.
//   3. Exit 1 before PASSED on a miss.

fn xs() -> Result[List[Float], String] {
    let mut a: List[Float] = list_new();
    a = list_push(a, 2.5);
    return Ok(a);
}

pub fn main() {
    let r: Result[List[Float], String] = xs();
    let mut empty: List[Float] = list_new();
    let a: List[Float] = match r {
        Ok(v) => v,
        Err(e) => empty
    };
    let x: Float = list_get(a, 0);
    if x < 2.4 {
        println("FAIL");
        process_exit(1);
    }
    if x > 2.6 {
        println("FAIL");
        process_exit(1);
    }
    println("result_lfloat_smoke: PASSED");
}
