// # Product lru_ttl_cache prove
import "std/collections/lru_ttl_cache.oo";
pub fn main() {
    let mut c: LruTtlCache = lru_ttl_cache_new(4);
    c = lru_ttl_cache_put(c, 7, 1, 100);
    let n: Int = lru_ttl_cache_len(c);
    if n != 1 {
        println("FAIL lruttl len");
        process_exit(1);
    }
    println("prod_lruttl: PASSED");
}
