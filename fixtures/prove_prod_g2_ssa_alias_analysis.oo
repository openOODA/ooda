// # Product prove std/compilers_vm/ssa_alias_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts alias_no_alias is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_alias_analysis.oo.
//
// Beats:
//   1. Call alias_no_alias twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ssa_alias_analysis: PASSED only if they match.

import "std/compilers_vm/ssa_alias_analysis.oo";

pub fn main() {
    let ssa_alias_analysis_mark: Int = 0;
    if ssa_alias_analysis_mark != 0 {
        process_exit(1);
    }
    let a: Int = alias_no_alias();
    let b: Int = alias_no_alias();
    if a != b {
        println("FAIL alias_no_alias");
        process_exit(1);
    }
    println("prod_g2_ssa_alias_analysis: PASSED");
}
