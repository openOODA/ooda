// # Product permutations prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_factorial/permutations_count.
//
// Setup: Product std/math/combinatorics_perms.oo. 5!=120; P(5,2)=20.
//
// Beats:
//   1. math_factorial(5) is 120.
//   2. math_permutations_count(5, 2) is 20.
//   3. Exit 1 before PASSED on a miss.

import "std/math/combinatorics_perms.oo";

pub fn main() {
    let f: Int = math_factorial(5);
    if f != 120 {
        println("FAIL factorial");
        process_exit(1);
    }
    let p: Int = math_permutations_count(5, 2);
    if p != 20 {
        println("FAIL P(5,2)");
        process_exit(1);
    }
    println("prod_perms: PASSED");
}
