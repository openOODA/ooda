// # Product prove std/grid/battery_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_pack_cell_balancing_matrix_sim is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_stubs.oo.
//
// Beats:
//   1. Call battery_pack_cell_balancing_matrix_sim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_battery_stubs: PASSED only if they match.

import "std/grid/battery_stubs.oo";

pub fn main() {
    let battery_stubs_mark: Int = 0;
    if battery_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Float = battery_pack_cell_balancing_matrix_sim(0, 0);
    let b: Float = battery_pack_cell_balancing_matrix_sim(0, 0);
    if a != b {
        println("FAIL battery_pack_cell_balancing_matrix_sim");
        process_exit(1);
    }
    println("prod_g2_battery_stubs: PASSED");
}
