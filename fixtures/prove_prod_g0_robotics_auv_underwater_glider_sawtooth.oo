// # Product prove std/robotics_auv/underwater_glider_sawtooth.oo
//
// Logline: Fail-closed emit+gcc+run asserts gldr_isqrt_seed is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/underwater_glider_sawtooth.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gldr_isqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_underwater_glider_sawtooth: PASSED only if they match.

import "std/robotics_auv/underwater_glider_sawtooth.oo";

pub fn main() {
    let g0_a = gldr_isqrt_seed(2, 2);
    let g0_b = gldr_isqrt_seed(2, 2);
    if g0_a != g0_b {
        println("FAIL gldr_isqrt_seed");
        process_exit(1);
    }
    println("prod_g0_underwater_glider_sawtooth: PASSED");
}
