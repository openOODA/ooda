// # Product prove std/compilers_polyhedral/polyhedral_ast_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts poly_ast_node_for is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_ast_generator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call poly_ast_node_for twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_ast_generator: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_ast_generator.oo";

pub fn main() {
    let g2_oa: PolyAstNode = poly_ast_node_for(2, "x", 2, 2, 2);
    let g2_ob: PolyAstNode = poly_ast_node_for(2, "x", 2, 2, 2);
    let g2_a = (g2_oa).node_id;
    let g2_b = (g2_ob).node_id;
    if g2_a != g2_b {
        println("FAIL poly_ast_node_for.node_id");
        process_exit(1);
    }
    println("prod_g2_polyhedral_ast_generator: PASSED");
}
