// # Product prove std/astro_advanced/propellant_slosh_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/propellant_slosh_dynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/propellant_slosh_dynamics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_propellant_slosh_dynamics: PASSED only if they match.

import "std/astro_advanced/propellant_slosh_dynamics.oo";

pub fn main() {
    let propellant_slosh_dynamics_a = slosh_freq_mhz();
    let propellant_slosh_dynamics_b = slosh_freq_mhz();
    if propellant_slosh_dynamics_a != propellant_slosh_dynamics_b {
        println("FAIL propellant_slosh_dynamics");
        process_exit(1);
    }
    println("prod_ap_propellant_slosh_dynamics: PASSED");
}
