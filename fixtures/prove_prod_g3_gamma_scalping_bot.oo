// # Product prove std/defi_derivatives/gamma_scalping_bot.oo
//
// Logline: Fail-closed emit+gcc+run asserts gamma_scalp_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/gamma_scalping_bot.oo.
//
// Beats:
//   1. Call gamma_scalp_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gamma_scalping_bot: PASSED only if they match.

import "std/defi_derivatives/gamma_scalping_bot.oo";

pub fn main() {
    let gamma_scalping_bot_mark: Int = 0;
    if gamma_scalping_bot_mark != 0 {
        process_exit(1);
    }
    let a: GammaScalpConfig = gamma_scalp_config_default();
    let b: GammaScalpConfig = gamma_scalp_config_default();
    if (a).delta_rebalance_threshold != (b).delta_rebalance_threshold {
        println("FAIL gamma_scalp_config_default");
        process_exit(1);
    }
    println("prod_gamma_scalping_bot: PASSED");
}
