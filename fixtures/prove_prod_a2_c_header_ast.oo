// # Product prove std/compilers/c_header_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts c_type_kind_void is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_ast.oo.
//
// Beats:
//   1. Call c_type_kind_void twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_c_header_ast: PASSED only if they match.

import "std/compilers/c_header_ast.oo";

pub fn main() {
    let c_header_ast_mark: Int = 0;
    if c_header_ast_mark != 0 {
        process_exit(1);
    }
    let a: Int = c_type_kind_void();
    let b: Int = c_type_kind_void();
    if a != b {
        println("FAIL c_type_kind_void");
        process_exit(1);
    }
    println("prod_c_header_ast: PASSED");
}
