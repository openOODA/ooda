// # Milestone 4 inventory struct caller
//
// Logline: Test complex methods, mutations, string fields, and Result[Item].
//
// Setup: Imports m4_inventory_lib.oo.
//
// Beats:
//   1. Import Item from library.
//   2. Test value receiver methods and chaining.
//   3. Test reference receiver and mutation methods.
//   4. Test Result[Item] unwrap and validation.
//   5. Assert runtime correctness.

import "m4_inventory_lib.oo";

pub fn inspect_tag(it: &Item) -> String {
    return it.format_tag();
}

pub fn main() {
    let mut it = Item { name: "Widget", price: 50, count: 10 };

    // 1. Value receiver method
    let v0 = it.total_val();
    if v0 != 500 {
        println("FAIL: item.total_val");
        process_exit(1);
    }

    // 2. Reference receiver mutation
    restock(&mut it, 5);
    if it.count != 15 {
        println("FAIL: restock(&mut it)");
        process_exit(1);
    }
    if it.total_val() != 750 {
        println("FAIL: it.total_val after restock");
        process_exit(1);
    }

    // 3. Chaining value receiver methods
    let discounted_val = it.discount(20).total_val();
    if discounted_val != 600 {
        println("FAIL: it.discount(20).total_val()");
        process_exit(1);
    }

    // 4. Reference receiver reading String field
    let tag = inspect_tag(&it);
    if tag != "Widget" {
        println("FAIL: inspect_tag");
        process_exit(1);
    }

    // 5. Result[Item, String] validation
    let res_ok = validate_item(it);
    if !res_ok.is_ok() {
        println("FAIL: validate_item is_ok");
        process_exit(1);
    }
    let validated: Item = res_ok.unwrap();
    if validated.count != 15 || validated.price != 50 {
        println("FAIL: validated fields");
        process_exit(1);
    }

    let bad_item = Item { name: "Bad", price: -10, count: 1 };
    let res_bad = validate_item(bad_item);
    if !res_bad.is_err() {
        println("FAIL: validate_item is_err");
        process_exit(1);
    }

    println("m4_inventory_main: PASSED");
}
