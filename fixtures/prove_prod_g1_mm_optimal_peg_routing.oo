// # Product prove std/hft_alpha/mm_optimal_peg_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts nbbo_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_optimal_peg_routing.oo.
//
// Beats:
//   1. Call nbbo_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_optimal_peg_routing: PASSED only if they match.

import "std/hft_alpha/mm_optimal_peg_routing.oo";

pub fn main() {
    let a: NbboState = nbbo_state_new(0.0, 0.0);
    let b: NbboState = nbbo_state_new(0.0, 0.0);
    if a.best_bid != b.best_bid {
        println("FAIL nbbo_state_new");
        process_exit(1);
    }
    println("prod_mm_optimal_peg_routing: PASSED");
}
