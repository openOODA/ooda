// # Product prove std/ai_multimodal/unet_downsample_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts unet_downsample_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_downsample_block.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call unet_downsample_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_unet_downsample_block: PASSED only if they match.

import "std/ai_multimodal/unet_downsample_block.oo";

pub fn main() {
    let g2_a = unet_downsample_marker();
    let g2_b = unet_downsample_marker();
    if g2_a != g2_b {
        println("FAIL unet_downsample_marker");
        process_exit(1);
    }
    println("prod_g2_unet_downsample_block: PASSED");
}
