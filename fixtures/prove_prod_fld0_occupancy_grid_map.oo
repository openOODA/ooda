// # Product prove std/auto_robot/occupancy_grid_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts grid_world_to_map_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/occupancy_grid_map.oo.
//
// Beats:
//   1. Call grid_world_to_map_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_occupancy_grid_map: PASSED only if they match.

import "std/auto_robot/occupancy_grid_map.oo";

pub fn main() {
    let occupancy_grid_map_mark: Int = 0;
    if occupancy_grid_map_mark != 0 {
        process_exit(1);
    }
    let occupancy_grid_map_obj = occupancy_grid_map_new(grid_map_config_default(1, 1, 1.0));
    let occupancy_grid_map_a: Int = grid_world_to_map_x(&occupancy_grid_map_obj, 1.0);
    let occupancy_grid_map_b: Int = grid_world_to_map_x(&occupancy_grid_map_obj, 1.0);
    if occupancy_grid_map_a != occupancy_grid_map_b {
        println("FAIL grid_world_to_map_x");
        process_exit(1);
    }
    println("prod_occupancy_grid_map: PASSED");
}
