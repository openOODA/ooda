// # Allow a public println beside a secret
//
// Logline: A tagged x does not taint a public y at println.
//
// Beats:
//   1. Tag x at line start.
//   2. Bind a public y beside it.
//   3. Print y so the sink stays allowed.

// M52 path A — SECRET tags x but println non-secret is OK
// SECRET: x
pub fn main() {
    let x = "token";
    let y = "ok";
    println(y);
}
