// # Product prove std/defi_derivatives/options_calendar_spread.oo
//
// Logline: Fail-closed emit+gcc+run asserts cal_norm_pdf is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_calendar_spread.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cal_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_options_calendar_spread: PASSED only if they match.

import "std/defi_derivatives/options_calendar_spread.oo";

pub fn main() {
    let g2_a = cal_norm_pdf(1.0);
    let g2_b = cal_norm_pdf(1.0);
    if g2_a != g2_b {
        println("FAIL cal_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_options_calendar_spread: PASSED");
}
