// # Product prove std/zk_rollup/snark_verifier_circuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_gate_counter_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/snark_verifier_circuit.oo.
//
// Beats:
//   1. Call circuit_gate_counter_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_snark_verifier_circuit: PASSED only if asserts hold.

import "std/zk_rollup/snark_verifier_circuit.oo";

pub fn main() {
    let snark_verifier_circuit_a: CircuitGateCounter = circuit_gate_counter_new();
    let snark_verifier_circuit_b: CircuitGateCounter = circuit_gate_counter_new();
    if snark_verifier_circuit_a.num_variables != snark_verifier_circuit_b.num_variables {
        println("FAIL circuit_gate_counter_new");
        process_exit(1);
    }
    println("prod_snark_verifier_circuit: PASSED");
}
