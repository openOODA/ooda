// # Product prove std/net_telemetry/udp_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts udp_is_dns is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/udp_packet.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call udp_is_dns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_udp_packet: PASSED only if they match.

import "std/net_telemetry/udp_packet.oo";

pub fn main() {
    let g0_oa: UdpDatagram = UdpDatagram { src_port: 2, dst_port: 2, length: 8, checksum: 2, payload_len: 8, is_valid: true };
    let g0_ob: UdpDatagram = UdpDatagram { src_port: 2, dst_port: 2, length: 8, checksum: 2, payload_len: 8, is_valid: true };
    let g0_a = udp_is_dns(&g0_oa);
    let g0_b = udp_is_dns(&g0_ob);
    if g0_a != g0_b {
        println("FAIL udp_is_dns");
        process_exit(1);
    }
    println("prod_g0_udp_packet: PASSED");
}
