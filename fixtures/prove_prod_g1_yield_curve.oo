// # Product prove std/fintech/yield_curve.oo
//
// Logline: Fail-closed emit+gcc+run asserts yield_tenor_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/yield_curve.oo.
//
// Beats:
//   1. Call yield_tenor_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_curve: PASSED only if they match.

import "std/fintech/yield_curve.oo";

pub fn main() {
    let a: YieldTenor = yield_tenor_new(0, 0);
    let b: YieldTenor = yield_tenor_new(0, 0);
    if a.tenor_months != b.tenor_months {
        println("FAIL yield_tenor_new");
        process_exit(1);
    }
    println("prod_yield_curve: PASSED");
}
