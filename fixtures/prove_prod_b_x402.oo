// # Product prove std/net/x402.oo
//
// Logline: Fail-closed emit+gcc+run asserts x402_is_payment_required is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/x402.oo.
//
// Beats:
//   1. Call x402_is_payment_required twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_x402: PASSED only if they match.

import "std/net/x402.oo";

pub fn main() {
    let a = x402_is_payment_required(0);
    let b = x402_is_payment_required(0);
    if a != b {
        println("FAIL x402_is_payment_required");
        process_exit(1);
    }
    println("prod_x402: PASSED");
}
