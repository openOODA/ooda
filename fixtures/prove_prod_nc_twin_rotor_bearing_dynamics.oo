// # Product prove std/digital_twin/twin_rotor_bearing_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_rotor_bearing_dynamics_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_rotor_bearing_dynamics.oo.
//
// Beats:
//   1. Call twin_rotor_bearing_dynamics_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_twin_rotor_bearing_dynamics: PASSED only if it matches.

import "std/digital_twin/twin_rotor_bearing_dynamics.oo";

pub fn main() {
    let a: Int = twin_rotor_bearing_dynamics_probe();
    if a != 0 {
        println("FAIL twin_rotor_bearing_dynamics_probe");
        process_exit(1);
    }
    println("prod_nc_twin_rotor_bearing_dynamics: PASSED");
}
