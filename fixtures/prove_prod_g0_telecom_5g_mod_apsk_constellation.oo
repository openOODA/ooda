// # Product prove std/telecom_5g/mod_apsk_constellation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mod_apsk_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_apsk_constellation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mod_apsk_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_mod_apsk_constellation: PASSED only if they match.

import "std/telecom_5g/mod_apsk_constellation.oo";

pub fn main() {
    let g0_a = mod_apsk_int_to_float(2);
    let g0_b = mod_apsk_int_to_float(2);
    if g0_a != g0_b {
        println("FAIL mod_apsk_int_to_float");
        process_exit(1);
    }
    println("prod_g0_mod_apsk_constellation: PASSED");
}
