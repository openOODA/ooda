// # Product sync condvar prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/condvar.oo.
//
// Setup: Product std/sync/condvar.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New wait_count 0 not signaled.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/condvar.oo";

pub fn main() {
    let cv: Condvar = condvar_new(3);
    let n: Int = condvar_wait_count(cv);
    if n != 0 {
        println("FAIL condvc wait");
        process_exit(1);
    }
    if condvar_is_signaled(cv) {
        println("FAIL condvc sig");
        process_exit(1);
    }
    println("prod_condvc: PASSED");
}
