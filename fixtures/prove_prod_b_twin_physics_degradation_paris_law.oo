// # Product prove std/digital_twin/twin_physics_degradation_paris_law.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_physics_degradation_paris_law_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_physics_degradation_paris_law.oo.
//
// Beats:
//   1. Call twin_physics_degradation_paris_law_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_twin_physics_degradation_paris_law: PASSED only if they match.

import "std/digital_twin/twin_physics_degradation_paris_law.oo";

pub fn main() {
    let a = twin_physics_degradation_paris_law_probe();
    let b = twin_physics_degradation_paris_law_probe();
    if a != b {
        println("FAIL twin_physics_degradation_paris_law_probe");
        process_exit(1);
    }
    println("prod_twin_physics_degradation_paris_law: PASSED");
}
