// # Product prove std/crispr_cas/prime_editing_peg_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts peg_combine_extension is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_peg_designer.oo.
//
// Beats:
//   1. Call peg_combine_extension twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prime_editing_peg_designer: PASSED only if they match.

import "std/crispr_cas/prime_editing_peg_designer.oo";
import "std/str.oo";

pub fn main() {
    let prime_editing_peg_designer_mark: Int = 0;
    if prime_editing_peg_designer_mark != 0 {
        process_exit(1);
    }
    let a: String = peg_combine_extension("x", "x");
    let b: String = peg_combine_extension("x", "x");
    if str_eq(a, b) == false {
        println("FAIL peg_combine_extension");
        process_exit(1);
    }
    println("prod_prime_editing_peg_designer: PASSED");
}
