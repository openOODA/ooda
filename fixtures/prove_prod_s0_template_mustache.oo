// # Product prove std/web_ecosystem/template_mustache.oo
//
// Logline: Fail-closed emit+gcc+run asserts mustache_find_var value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/template_mustache.oo.
//
// Beats:
//   1. Call mustache_find_var twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_template_mustache: PASSED only if asserts hold.

import "std/web_ecosystem/template_mustache.oo";

pub fn main() {
    let template_mustache_a: Int = mustache_find_var(0, 0, 0, 0, 0);
    let template_mustache_b: Int = mustache_find_var(0, 0, 0, 0, 0);
    if template_mustache_a != template_mustache_b {
        println("FAIL mustache_find_var");
        process_exit(1);
    }
    println("prod_template_mustache: PASSED");
}
