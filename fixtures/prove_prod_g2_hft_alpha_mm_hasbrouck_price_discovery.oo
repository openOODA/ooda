// # Product prove std/hft_alpha/mm_hasbrouck_price_discovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts hasbrouck_params_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_hasbrouck_price_discovery.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hasbrouck_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_hasbrouck_price_discovery: PASSED only if they match.

import "std/hft_alpha/mm_hasbrouck_price_discovery.oo";

pub fn main() {
    let g2_oa: HasbrouckVarParams = hasbrouck_params_new(1.0, 1.0, 1.0);
    let g2_ob: HasbrouckVarParams = hasbrouck_params_new(1.0, 1.0, 1.0);
    let g2_a = (g2_oa).cross_venue_covariance;
    let g2_b = (g2_ob).cross_venue_covariance;
    if g2_a != g2_b {
        println("FAIL hasbrouck_params_new.cross_venue_covariance");
        process_exit(1);
    }
    println("prod_g2_mm_hasbrouck_price_discovery: PASSED");
}
