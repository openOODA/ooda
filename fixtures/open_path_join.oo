// # Product path join
//
// Logline: path_join of two segments prints a posix path.
//
// Setup: OPEN-43. ooda/std/fs/path.oo string math. Not a buffered FD.
//
// Beats:
//   1. Join /usr/local and bin.
//   2. Print the result.
//   3. Require a slash.

import "std/fs/path.oo";

pub fn main() {
    let p: String = path_join("/usr/local", "bin");
    println(p);
}