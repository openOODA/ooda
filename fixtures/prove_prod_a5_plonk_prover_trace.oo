// # Product prove std/zk_rollup/plonk_prover_trace.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_trace_row_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_prover_trace.oo.
//
// Beats:
//   1. Call plonk_trace_row_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_prover_trace: PASSED only if they match.

import "std/zk_rollup/plonk_prover_trace.oo";

pub fn main() {
    let plonk_prover_trace_mark: Int = 0;
    if plonk_prover_trace_mark != 0 {
        process_exit(1);
    }
    let a: PlonkTraceRow = plonk_trace_row_new(0, 0, 0, 0);
    let b: PlonkTraceRow = plonk_trace_row_new(0, 0, 0, 0);
    if (a).row_index != (b).row_index {
        println("FAIL plonk_trace_row_new");
        process_exit(1);
    }
    println("prod_plonk_prover_trace: PASSED");
}
