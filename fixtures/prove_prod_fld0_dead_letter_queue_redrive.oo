// # Product prove std/cloud_faas/dead_letter_queue_redrive.oo
//
// Logline: Fail-closed emit+gcc+run asserts redrive_compute_backoff_ms is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/dead_letter_queue_redrive.oo.
//
// Beats:
//   1. Call redrive_compute_backoff_ms twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dead_letter_queue_redrive: PASSED only if they match.

import "std/cloud_faas/dead_letter_queue_redrive.oo";

pub fn main() {
    let dead_letter_queue_redrive_mark: Int = 0;
    if dead_letter_queue_redrive_mark != 0 {
        process_exit(1);
    }
    let dead_letter_queue_redrive_obj: DeadLetterRedrivePolicy = dead_letter_policy_new(1, 1, "x");
    let dead_letter_queue_redrive_a: Int = redrive_compute_backoff_ms(&dead_letter_queue_redrive_obj, 1);
    let dead_letter_queue_redrive_b: Int = redrive_compute_backoff_ms(&dead_letter_queue_redrive_obj, 1);
    if dead_letter_queue_redrive_a != dead_letter_queue_redrive_b {
        println("FAIL redrive_compute_backoff_ms");
        process_exit(1);
    }
    println("prod_dead_letter_queue_redrive: PASSED");
}
