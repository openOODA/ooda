// # Product two-point linreg prove
//
// Logline: Fail-closed emit+gcc+run of shipped linreg_slope2/intercept2/predict2.
//
// Setup: Product std/math/linreg.oo. Line through (0,1) and (2,5) is y=2x+1.
//
// Beats:
//   1. Slope is 2.0; intercept is 1.0.
//   2. Predict at 3 is 7.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/linreg.oo";

pub fn main() {
    let s: Float = linreg_slope2(0.0, 1.0, 2.0, 5.0);
    if s != 2.0 {
        println("FAIL linreg slope");
        process_exit(1);
    }
    let ic: Float = linreg_intercept2(0.0, 1.0, 2.0, 5.0);
    if ic != 1.0 {
        println("FAIL linreg intercept");
        process_exit(1);
    }
    let y: Float = linreg_predict2(s, ic, 3.0);
    if y != 7.0 {
        println("FAIL linreg predict");
        process_exit(1);
    }
    println("prod_linreg: PASSED");
}
