// # Product prove std/protein_folding/md_poisson_boltzmann_pbe.oo
//
// Logline: Fail-closed emit+gcc+run asserts pb_calc_ionic_parameters is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_poisson_boltzmann_pbe.oo.
//
// Beats:
//   1. Call pb_calc_ionic_parameters twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_poisson_boltzmann_pbe: PASSED only if they match.

import "std/protein_folding/md_poisson_boltzmann_pbe.oo";

pub fn main() {
    let a: IonicAtmosphere = pb_calc_ionic_parameters(0.0, 0.0, 0.0);
    let b: IonicAtmosphere = pb_calc_ionic_parameters(0.0, 0.0, 0.0);
    if a.ionic_strength_molar != b.ionic_strength_molar {
        println("FAIL pb_calc_ionic_parameters");
        process_exit(1);
    }
    println("prod_md_poisson_boltzmann_pbe: PASSED");
}
