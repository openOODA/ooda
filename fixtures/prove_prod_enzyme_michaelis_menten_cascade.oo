// # Product prove std/synthetic_biology/enzyme_michaelis_menten_cascade.oo
//
// Logline: Fail-closed emit+gcc+run asserts enz_calc_velocity real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/enzyme_michaelis_menten_cascade.oo.
//
// Beats:
//   1. Call enz_calc_velocity with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_enzyme_michaelis_menten_cascade: PASSED only if the assert holds.

import "std/synthetic_biology/enzyme_michaelis_menten_cascade.oo";

pub fn main() {
    let enzyme_michaelis_menten_cascade_mark: Int = 0;
    if enzyme_michaelis_menten_cascade_mark != 0 {
        process_exit(1);
    }
    let enzyme_michaelis_menten_cascade_p: EnzymeKineticsStep = EnzymeKineticsStep { k_cat_per_s: 0.0, k_m_m_m: 0.0, enzyme_conc_u_m: 0.0, k_i_inhibition_m_m: 0.0, inhibition_type: 0 };
    let enzyme_michaelis_menten_cascade_n: Float = enz_calc_velocity(0.0, 0.0, &enzyme_michaelis_menten_cascade_p);
    if !(enzyme_michaelis_menten_cascade_n == 0.0) {
        println("FAIL enz_calc_velocity");
        process_exit(1);
    }
    println("prod_enzyme_michaelis_menten_cascade: PASSED");
}
