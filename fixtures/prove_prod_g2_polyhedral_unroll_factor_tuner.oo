// # Product prove std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo
//
// Logline: Fail-closed emit+gcc+run asserts tuning_candidate_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo.
//
// Beats:
//   1. Call tuning_candidate_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_unroll_factor_tuner: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo";

pub fn main() {
    let polyhedral_unroll_factor_tuner_mark: Int = 0;
    if polyhedral_unroll_factor_tuner_mark != 0 {
        process_exit(1);
    }
    let a: TuningCandidate = tuning_candidate_new(0, 0, 0, 0, 0, 0);
    let b: TuningCandidate = tuning_candidate_new(0, 0, 0, 0, 0, 0);
    if (a).candidate_id != (b).candidate_id {
        println("FAIL tuning_candidate_new");
        process_exit(1);
    }
    println("prod_g2_polyhedral_unroll_factor_tuner: PASSED");
}
