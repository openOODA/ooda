// # Product prove std/genomics_advanced/pacbio_ccs_circular_consensus.oo
//
// Logline: Fail-closed emit+gcc+run asserts pacbio_ccs_circular_consensus_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/pacbio_ccs_circular_consensus.oo.
//
// Beats:
//   1. Call pacbio_ccs_circular_consensus_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pacbio_ccs_circular_consensus: PASSED only if it matches.

import "std/genomics_advanced/pacbio_ccs_circular_consensus.oo";

pub fn main() {
    let a: Int = pacbio_ccs_circular_consensus_probe();
    if a != 0 {
        println("FAIL pacbio_ccs_circular_consensus_probe");
        process_exit(1);
    }
    println("prod_nc_pacbio_ccs_circular_consensus: PASSED");
}
