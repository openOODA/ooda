// # Product prove std/robotics_ros2/slam_occupancy_elevation_mapping.oo
//
// Logline: Fail-closed emit+gcc+run asserts elevation_map_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_occupancy_elevation_mapping.oo.
//
// Beats:
//   1. Call elevation_map_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_occupancy_elevation_mapping: PASSED only if they match.

import "std/robotics_ros2/slam_occupancy_elevation_mapping.oo";

pub fn main() {
    let slam_occupancy_elevation_mapping_mark: Int = 0;
    if slam_occupancy_elevation_mapping_mark != 0 {
        process_exit(1);
    }
    let slam_occupancy_elevation_mapping_a = elevation_map_config_default();
    let slam_occupancy_elevation_mapping_b = elevation_map_config_default();
    if (slam_occupancy_elevation_mapping_a).cell_size_m != (slam_occupancy_elevation_mapping_b).cell_size_m {
        println("FAIL elevation_map_config_default");
        process_exit(1);
    }
    println("prod_slam_occupancy_elevation_mapping: PASSED");
}
