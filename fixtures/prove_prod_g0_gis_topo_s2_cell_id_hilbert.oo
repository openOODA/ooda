// # Product prove std/gis_topo/s2_cell_id_hilbert.oo
//
// Logline: Fail-closed emit+gcc+run asserts s2_st_to_uv is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/s2_cell_id_hilbert.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call s2_st_to_uv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_s2_cell_id_hilbert: PASSED only if they match.

import "std/gis_topo/s2_cell_id_hilbert.oo";

pub fn main() {
    let g0_a = s2_st_to_uv(1.0);
    let g0_b = s2_st_to_uv(1.0);
    if g0_a != g0_b {
        println("FAIL s2_st_to_uv");
        process_exit(1);
    }
    println("prod_g0_s2_cell_id_hilbert: PASSED");
}
