// FUZZ_DOMAIN: int
// FUZZ_TARGET: clamp10 0 30
// FUZZ_REQUIRES: clamp10 x >= 0
// FUZZ_ENSURES: clamp10 result >= 0
// FUZZ_ENSURES: clamp10 result <= 10
fn clamp10(x: Int) -> Int {
    requires x >= 0;
    ensures result >= 0;
    ensures result <= 10;
    if x > 10 {
        return 10;
    }
    return x;
}
pub fn main(sys: &SysCap) {
}
