// # Product prove std/fin/pricing_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/pricing_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pricing_engine: PASSED only if they match.

import "std/fin/pricing_engine.oo";

pub fn main() {
    let pricing_engine_a = std_normal_pdf(0.0);
    let pricing_engine_b = std_normal_pdf(0.0);
    if pricing_engine_a != pricing_engine_b {
        println("FAIL pricing_engine");
        process_exit(1);
    }
    println("prod_ap_pricing_engine: PASSED");
}
