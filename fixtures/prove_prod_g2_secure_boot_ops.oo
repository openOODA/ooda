// # Product prove std/sec/sys/secure_boot_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts sboot_is_violation is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot_ops.oo.
//
// Beats:
//   1. Call sboot_is_violation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_secure_boot_ops: PASSED only if they match.

import "std/sec/sys/secure_boot_ops.oo";

pub fn main() {
    let secure_boot_ops_mark: Int = 0;
    if secure_boot_ops_mark != 0 {
        process_exit(1);
    }
    let a: Bool = sboot_is_violation(0);
    let b: Bool = sboot_is_violation(0);
    if a != b {
        println("FAIL sboot_is_violation");
        process_exit(1);
    }
    println("prod_g2_secure_boot_ops: PASSED");
}
