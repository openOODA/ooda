// # Product prove std/db_graph/property_graph_id_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_id_allocator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_id_allocator.oo.
//
// Beats:
//   1. Call graph_id_allocator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_id_allocator: PASSED only if they match.

import "std/db_graph/property_graph_id_allocator.oo";

pub fn main() {
    let property_graph_id_allocator_mark: Int = 0;
    if property_graph_id_allocator_mark != 0 {
        process_exit(1);
    }
    let a: GraphIdAllocator = graph_id_allocator_new(0);
    let b: GraphIdAllocator = graph_id_allocator_new(0);
    if (a).entity_kind != (b).entity_kind {
        println("FAIL graph_id_allocator_new");
        process_exit(1);
    }
    println("prod_property_graph_id_allocator: PASSED");
}
