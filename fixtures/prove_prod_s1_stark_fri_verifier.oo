// # Product prove std/zk_rollup/stark_fri_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts stark_verify_proof is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_fri_verifier.oo.
//
// Beats:
//   1. Call stark_verify_proof twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stark_fri_verifier: PASSED only if they match.

import "std/zk_rollup/stark_fri_verifier.oo";

pub fn main() {
    let stark_fri_verifier_mark: Int = 0;
    if stark_fri_verifier_mark != 0 {
        process_exit(1);
    }
    let stark_fri_verifier_a = stark_verify_proof(stark_proof_envelope_new("x", "x", list_new(), 1), list_new());
    let stark_fri_verifier_b = stark_verify_proof(stark_proof_envelope_new("x", "x", list_new(), 1), list_new());
    if (stark_fri_verifier_a).security_level_bits != (stark_fri_verifier_b).security_level_bits {
        println("FAIL stark_verify_proof");
        process_exit(1);
    }
    println("prod_stark_fri_verifier: PASSED");
}
