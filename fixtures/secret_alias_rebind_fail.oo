// # Refuse a rebound secret alias
//
// Logline: Assigning a secret into a mutable public name taints the later println.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Rebind y from a public literal onto that secret.
//   3. Print y so the sink refuses.

// M-? alias rebind propagation: let mut to secret correctly taints
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let mut y = "public";
    y = api_key;
    println(y);
}
