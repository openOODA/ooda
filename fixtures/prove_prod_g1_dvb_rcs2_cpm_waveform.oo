// # Product prove std/satellite_dvb/dvb_rcs2_cpm_waveform.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_cpm_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_rcs2_cpm_waveform.oo.
//
// Beats:
//   1. Call dvb_cpm_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvb_rcs2_cpm_waveform: PASSED only if they match.

import "std/satellite_dvb/dvb_rcs2_cpm_waveform.oo";

pub fn main() {
    let a: DvbCpmConfig = dvb_cpm_config_new(0, 1, 0, 0);
    let b: DvbCpmConfig = dvb_cpm_config_new(0, 1, 0, 0);
    if a.mod_index_h_num != b.mod_index_h_num {
        println("FAIL dvb_cpm_config_new");
        process_exit(1);
    }
    println("prod_dvb_rcs2_cpm_waveform: PASSED");
}
