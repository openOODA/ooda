// # Product prove std/net_telemetry/ipv6_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts ipv6_address_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/ipv6_packet.oo.
//
// Beats:
//   1. Call ipv6_address_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ipv6_packet: PASSED only if they match.

import "std/net_telemetry/ipv6_packet.oo";

pub fn main() {
    let ipv6_packet_mark: Int = 0;
    if ipv6_packet_mark != 0 {
        process_exit(1);
    }
    let a: Ipv6Address = ipv6_address_new(0, 0, 0, 0, 0, 0, 0, 0);
    let b: Ipv6Address = ipv6_address_new(0, 0, 0, 0, 0, 0, 0, 0);
    if (a).w0 != (b).w0 {
        println("FAIL ipv6_address_new");
        process_exit(1);
    }
    println("prod_g2_ipv6_packet: PASSED");
}
