// # Product prove std/digital_twin/bond_graph_energy_elements.oo
//
// Logline: Fail-closed emit+gcc+run asserts bg_calculate_power is a real value.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_energy_elements.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bg_calculate_power twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_bond_graph_energy_elements: PASSED only if they match.

import "std/digital_twin/bond_graph_energy_elements.oo";

pub fn main() {
    let g0_a = bg_calculate_power(1.0, 1.0);
    let g0_b = bg_calculate_power(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL bg_calculate_power");
        process_exit(1);
    }
    println("prod_g0_bond_graph_energy_elements: PASSED");
}
