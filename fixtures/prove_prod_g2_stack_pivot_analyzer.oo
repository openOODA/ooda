// # Product prove std/exploit_analysis/stack_pivot_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_pivot_xchg_rsp_rax is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/stack_pivot_analyzer.oo.
//
// Beats:
//   1. Call stack_pivot_xchg_rsp_rax twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stack_pivot_analyzer: PASSED only if they match.

import "std/exploit_analysis/stack_pivot_analyzer.oo";

pub fn main() {
    let stack_pivot_analyzer_mark: Int = 0;
    if stack_pivot_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: StackPivotGadget = stack_pivot_xchg_rsp_rax(0);
    let b: StackPivotGadget = stack_pivot_xchg_rsp_rax(0);
    if (a).address != (b).address {
        println("FAIL stack_pivot_xchg_rsp_rax");
        process_exit(1);
    }
    println("prod_g2_stack_pivot_analyzer: PASSED");
}
