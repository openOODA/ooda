// # Product prove std/formal_verif/model_check_ltl_tableau.oo
//
// Logline: Fail-closed emit+gcc+run asserts ltl_translate_always is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/model_check_ltl_tableau.oo.
//
// Beats:
//   1. Call ltl_translate_always twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_model_check_ltl_tableau: PASSED only if they match.

import "std/formal_verif/model_check_ltl_tableau.oo";
import "std/str.oo";

pub fn main() {
    let model_check_ltl_tableau_mark: Int = 0;
    if model_check_ltl_tableau_mark != 0 {
        process_exit(1);
    }
    let model_check_ltl_tableau_a: String = ltl_translate_always("x");
    let model_check_ltl_tableau_b: String = ltl_translate_always("x");
    if str_eq(model_check_ltl_tableau_a, model_check_ltl_tableau_b) == false {
        println("FAIL ltl_translate_always");
        process_exit(1);
    }
    println("prod_model_check_ltl_tableau: PASSED");
}
