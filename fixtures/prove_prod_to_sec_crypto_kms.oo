// # Product prove std/sec/crypto/kms.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_checksum holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms.oo.
//
// Beats:
//   1. Call shim_marker_checksum using the kms ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_kms: PASSED only if asserts hold.

import "std/sec/crypto/kms.oo";

pub fn main() {
    let kms_a = shim_marker_checksum();
    let kms_b = shim_marker_checksum();
    if kms_a != kms_b {
        println("FAIL shim_marker_checksum");
        process_exit(1);
    }
    println("prod_kms: PASSED");
}
