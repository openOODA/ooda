// # Product prove std/gis_topo/dem_hillshade_shader.oo
//
// Logline: Fail-closed emit+gcc+run asserts DEM hillshade illumination shader operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_hillshade_shader.oo.
//
// Beats:
//   1. Configure solar altitude, azimuth, and exaggeration parameters.
//   2. Convert degree angles to radians and assert trigonometric consistency.
//   3. Compute raster hillshade illumination and verify deterministic grayscale value.
//   4. Print prod_g4_gis_dem_shader: PASSED and exit 0.

import "std/gis_topo/dem_hillshade_shader.oo";

pub fn main() {
    let cfg1: HillshadeConfig = hillshade_config_default();
    let cfg2: HillshadeConfig = hillshade_config_default();
    if (cfg1).solar_altitude_deg != (cfg2).solar_altitude_deg || (cfg1).solar_altitude_deg != 45.0 {
        println("FAIL hillshade_config_default");
        process_exit(1);
    }

    let rad1: Float = hillshade_deg2rad(180.0);
    let rad2: Float = hillshade_deg2rad(180.0);
    if rad1 != rad2 || rad1 <= 3.14 || rad1 >= 3.15 {
        println("FAIL hillshade_deg2rad");
        process_exit(1);
    }

    let grid: DemRasterGrid = dem_raster_grid_new(3, 3, 0.0, 0.0, 10.0, 10.0, -9999.0);
    let h1: Int = dem_compute_hillshade(&grid, 1, 1, &cfg1);
    let h2: Int = dem_compute_hillshade(&grid, 1, 1, &cfg2);
    if h1 != h2 {
        println("FAIL dem_compute_hillshade");
        process_exit(1);
    }

    println("prod_g4_gis_dem_shader: PASSED");
    process_exit(0);
}
