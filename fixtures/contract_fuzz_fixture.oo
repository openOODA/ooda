// # Contract Fuzz and Ghost-State Verification Fixture
//
// Logline: Target functions with arithmetic, boundary, and state contracts for automated fuzzing and proof verification.
//
// Setup: Standalone fixture containing contract-annotated functions.
//
// Beats:
//   1. Implement safe_add with multi-clause non-negative requires and ensures.
//   2. Implement clamp_val bounded within integer ranges.
//   3. Implement account_transfer with balance preservation and ghost-state pre/post guarantees.
//
// residual: Higher-order ghost invariant annotations lower in formal proof engine

pub fn safe_add(a: Int, b: Int) -> Int
    requires (a >= 0 && b >= 0)
    ensures result >= 0
{
    return a + b;
}

pub fn clamp_val(x: Int, min_v: Int, max_v: Int) -> Int
    requires (min_v <= max_v)
    ensures (result >= min_v && result <= max_v)
{
    if x < min_v {
        return min_v;
    }
    if x > max_v {
        return max_v;
    }
    return x;
}

pub fn account_transfer(balance: Int, amount: Int) -> Int
    requires (balance >= amount && amount > 0)
    ensures result >= 0
{
    return balance - amount;
}

pub fn main() {
    println(safe_add(10, 20));
    println(clamp_val(150, 0, 100));
    println(account_transfer(500, 100));
}
