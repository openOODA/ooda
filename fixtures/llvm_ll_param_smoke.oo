// # Nested-list parameter LLVM lock
//
// Logline: Fail-closed emit+clang-run of List[List[Int]] as a function parameter.
//
// Setup: Backend-LLVM. Outer param type is nested, not %OoSList.
//
// Beats:
//   1. take receives List[List[Int]].
//   2. Nested get is Int 4.
//   3. Exit 1 before PASSED on a miss.

fn take(xs: List[List[Int]]) -> Int {
    return list_get(list_get(xs, 0), 0);
}

pub fn main() {
    let mut inner: List[Int] = list_new();
    inner = list_push(inner, 4);
    let empty: List[List[Int]] = list_new();
    let xs: List[List[Int]] = list_push(empty, inner);
    if take(xs) != 4 {
        println("FAIL");
        process_exit(1);
    }
    println("llvm_ll_param_smoke: PASSED");
}
