// # Product prove std/synthetic_biology/synthetic_microbial_consortia.oo
//
// Logline: Fail-closed emit+gcc+run asserts consortia_step real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/synthetic_microbial_consortia.oo.
//
// Beats:
//   1. Call consortia_step with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synthetic_microbial_consortia: PASSED only if the assert holds.

import "std/synthetic_biology/synthetic_microbial_consortia.oo";

pub fn main() {
    let synthetic_microbial_consortia_mark: Int = 0;
    if synthetic_microbial_consortia_mark != 0 {
        process_exit(1);
    }
    let synthetic_microbial_consortia_st: ConsortiaPopulationState = ConsortiaPopulationState { biomass_a_od: 0.0, biomass_b_od: 0.0, nutrient_x_conc_m_m: 0.0, nutrient_y_conc_m_m: 0.0, time_hours: 0.0 };
    let synthetic_microbial_consortia_p: ConsortiaKineticsParams = ConsortiaKineticsParams { max_growth_rate_a_per_h: 0.0, max_growth_rate_b_per_h: 0.0, k_s_nutrient_y_for_a: 0.0, k_s_nutrient_x_for_b: 0.0, secretion_rate_x_by_a: 0.0, secretion_rate_y_by_b: 0.0, dilution_rate_d_per_h: 0.0 };
    let synthetic_microbial_consortia_a = consortia_step(&synthetic_microbial_consortia_st, &synthetic_microbial_consortia_p, 0.0);
    let synthetic_microbial_consortia_time_hours: Float = (synthetic_microbial_consortia_a).time_hours;
    if !(synthetic_microbial_consortia_time_hours == 0.0) {
        println("FAIL consortia_step");
        process_exit(1);
    }
    println("prod_synthetic_microbial_consortia: PASSED");
}
