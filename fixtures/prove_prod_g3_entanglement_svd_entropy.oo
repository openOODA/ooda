// # Product prove std/quantum_tensor_nets/entanglement_svd_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts renyi_entropy_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/entanglement_svd_entropy.oo.
//
// Beats:
//   1. Call renyi_entropy_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_entanglement_svd_entropy: PASSED only if they match.

import "std/quantum_tensor_nets/entanglement_svd_entropy.oo";

pub fn main() {
    let entanglement_svd_entropy_mark: Int = 0;
    if entanglement_svd_entropy_mark != 0 {
        process_exit(1);
    }
    let a: RenyiEntropyConfig = renyi_entropy_config_default();
    let b: RenyiEntropyConfig = renyi_entropy_config_default();
    if (a).alpha_order != (b).alpha_order {
        println("FAIL renyi_entropy_config_default");
        process_exit(1);
    }
    println("prod_entanglement_svd_entropy: PASSED");
}
