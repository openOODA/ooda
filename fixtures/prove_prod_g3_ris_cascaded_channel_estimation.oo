// # Product prove std/telecom_6g/ris_cascaded_channel_estimation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_dft_matrix_element_phase is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_cascaded_channel_estimation.oo.
//
// Beats:
//   1. Call ris_dft_matrix_element_phase twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ris_cascaded_channel_estimation: PASSED only if they match.

import "std/telecom_6g/ris_cascaded_channel_estimation.oo";

pub fn main() {
    let ris_cascaded_channel_estimation_mark: Int = 0;
    if ris_cascaded_channel_estimation_mark != 0 {
        process_exit(1);
    }
    let a: Float = ris_dft_matrix_element_phase(0, 0, 0);
    let b: Float = ris_dft_matrix_element_phase(0, 0, 0);
    if a != b {
        println("FAIL ris_dft_matrix_element_phase");
        process_exit(1);
    }
    println("prod_ris_cascaded_channel_estimation: PASSED");
}
