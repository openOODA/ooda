// # Product prove std/graph_gnn/graph_heterogeneous_metapath.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_gnn/graph_heterogeneous_metapath.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_heterogeneous_metapath.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_heterogeneous_metapath: PASSED only if they match.

import "std/graph_gnn/graph_heterogeneous_metapath.oo";

pub fn main() {
    let graph_heterogeneous_metapath_a = hetero_graph_new(0);
    let graph_heterogeneous_metapath_b = hetero_graph_new(0);
    let graph_heterogeneous_metapath_va = sample_metapath_step(graph_heterogeneous_metapath_a, 0, 0, 0, 0);
    let graph_heterogeneous_metapath_vb = sample_metapath_step(graph_heterogeneous_metapath_b, 0, 0, 0, 0);
    if graph_heterogeneous_metapath_va != graph_heterogeneous_metapath_vb {
        println("FAIL graph_heterogeneous_metapath");
        process_exit(1);
    }
    println("prod_ap_graph_heterogeneous_metapath: PASSED");
}
