// # Product prove std/3d/scene.oo
//
// Logline: Fail-closed verification that 3D scene graph, node hierarchy, and spatial transforms are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/scene.oo.
//
// Beats:
//   1. Call vector, transform, scene, and scene node constructor shims.
//   2. Assert deterministic structural properties and identity transforms.
//   3. Print prod_g4_3d_scene: PASSED and exit 0.

import "std/3d/scene.oo";

pub fn main() {
    let scene_mark: Int = 0;
    if scene_mark != 0 {
        process_exit(1);
    }

    let v0_a: Vector3 = shim_marker_vector3_zero();
    let v0_b: Vector3 = shim_marker_vector3_zero();
    if (v0_a).x != (v0_b).x || (v0_a).y != (v0_b).y || (v0_a).z != (v0_b).z || (v0_a).x != 0 {
        println("FAIL shim_marker_vector3_zero");
        process_exit(1);
    }

    let tf: Transform = shim_marker_transform_identity();
    if (tf).scale.x != 1 || (tf).scale.y != 1 || (tf).scale.z != 1 {
        println("FAIL shim_marker_transform_identity");
        process_exit(1);
    }

    let sc: Scene = shim_marker_scene_new();
    if (sc).next_id != 1 || (sc).count != 0 {
        println("FAIL shim_marker_scene_new");
        process_exit(1);
    }

    let node: SceneNode = shim_marker_scene_node_new();
    if (node).id != 0 || (node).parent_id != 0 {
        println("FAIL shim_marker_scene_node_new");
        process_exit(1);
    }

    let mark_st: Int = scene_types_marker();
    let mark_so: Int = scene_ops_marker();
    let mark_s: Int = scene_marker();
    if mark_st != 1 || mark_so != 1 || mark_s != 1 {
        println("FAIL scene markers");
        process_exit(1);
    }

    println("prod_g4_3d_scene: PASSED");
    process_exit(0);
}
