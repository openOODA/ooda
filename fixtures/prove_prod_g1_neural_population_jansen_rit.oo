// # Product prove std/neuro_bci/neural_population_jansen_rit.oo
//
// Logline: Fail-closed emit+gcc+run asserts jansen_rit_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neural_population_jansen_rit.oo.
//
// Beats:
//   1. Call jansen_rit_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_neural_population_jansen_rit: PASSED only if they match.

import "std/neuro_bci/neural_population_jansen_rit.oo";

pub fn main() {
    let a: JansenRitParams = jansen_rit_params_default();
    let b: JansenRitParams = jansen_rit_params_default();
    if a.a_amplitude != b.a_amplitude {
        println("FAIL jansen_rit_params_default");
        process_exit(1);
    }
    println("prod_neural_population_jansen_rit: PASSED");
}
