// # Product prove std/web_ecosystem/fast_glob_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/fast_glob_matcher.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/fast_glob_matcher.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fast_glob_matcher: PASSED only if they match.

import "std/web_ecosystem/fast_glob_matcher.oo";

pub fn main() {
    let fast_glob_matcher_a = glob_match_star();
    let fast_glob_matcher_b = glob_match_star();
    if fast_glob_matcher_a != fast_glob_matcher_b {
        println("FAIL fast_glob_matcher");
        process_exit(1);
    }
    println("prod_ap_fast_glob_matcher: PASSED");
}
