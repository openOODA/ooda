// # Product prove std/neuro_bci/synapse_tripartite_astrocyte.oo
//
// Logline: Fail-closed emit+gcc+run asserts astrocyte_params_default is a real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/synapse_tripartite_astrocyte.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call astrocyte_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_synapse_tripartite_astrocyte: PASSED only if they match.

import "std/neuro_bci/synapse_tripartite_astrocyte.oo";

pub fn main() {
    let g2_oa: AstrocyteParams = astrocyte_params_default();
    let g2_ob: AstrocyteParams = astrocyte_params_default();
    let g2_a = (g2_oa).tau_ca_ms;
    let g2_b = (g2_ob).tau_ca_ms;
    if g2_a != g2_b {
        println("FAIL astrocyte_params_default.tau_ca_ms");
        process_exit(1);
    }
    println("prod_g2_synapse_tripartite_astrocyte: PASSED");
}
