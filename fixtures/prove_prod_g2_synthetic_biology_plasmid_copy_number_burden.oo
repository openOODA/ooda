// # Product prove std/synthetic_biology/plasmid_copy_number_burden.oo
//
// Logline: Fail-closed emit+gcc+run asserts plasmid_calc_loss_probability is a real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/plasmid_copy_number_burden.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call plasmid_calc_loss_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_plasmid_copy_number_burden: PASSED only if they match.

import "std/synthetic_biology/plasmid_copy_number_burden.oo";

pub fn main() {
    let g2_a = plasmid_calc_loss_probability(2, true);
    let g2_b = plasmid_calc_loss_probability(2, true);
    if g2_a != g2_b {
        println("FAIL plasmid_calc_loss_probability");
        process_exit(1);
    }
    println("prod_g2_plasmid_copy_number_burden: PASSED");
}
