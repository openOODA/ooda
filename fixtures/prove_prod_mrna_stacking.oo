// # Product prove std/synthetic_biology/mrna_secondary_structure_dg.oo
//
// Logline: Fail-closed emit+gcc+run asserts mrna_calc_stacking_energy is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/mrna_secondary_structure_dg.oo.
//
// Beats:
//   1. Call mrna_calc_stacking_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mrna_stacking: PASSED only if they match.

import "std/synthetic_biology/mrna_secondary_structure_dg.oo";

pub fn main() {
    let mrna_secondary_structure_dg_mark: Int = 0;
    if mrna_secondary_structure_dg_mark != 0 { process_exit(1); }
    let a: Float = mrna_calc_stacking_energy("GC", "CG");
    let b: Float = mrna_calc_stacking_energy("GC", "CG");
    if a != b {
        println("FAIL mrna_calc_stacking_energy");
        process_exit(1);
    }
    println("prod_mrna_stacking: PASSED");
}
