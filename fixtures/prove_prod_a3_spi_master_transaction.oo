// # Product prove std/embedded_hal/spi_master_transaction.oo
//
// Logline: Fail-closed emit+gcc+run asserts spi_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/spi_master_transaction.oo.
//
// Beats:
//   1. Call spi_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spi_master_transaction: PASSED only if they match.

import "std/embedded_hal/spi_master_transaction.oo";

pub fn main() {
    let spi_master_transaction_mark: Int = 0;
    if spi_master_transaction_mark != 0 {
        process_exit(1);
    }
    let a: SpiConfig = spi_config_new(0, 0, 0, 0, 0);
    let b: SpiConfig = spi_config_new(0, 0, 0, 0, 0);
    if (a).bus_id != (b).bus_id {
        println("FAIL spi_config_new");
        process_exit(1);
    }
    println("prod_spi_master_transaction: PASSED");
}
