// # Test two structs
//
// Logline: Test emitting two structs.
//
// Setup: Backend-C.
//
// Beats:
//   1. Struct 1.
//   2. Struct 2.
//   3. Main.

type Item = struct {
    id: Int,
    name: String,
    val: Int
};

type Header = struct {
    title: String,
    count: Int
};

pub fn main() {
    let it: Item = Item { id: 1, name: "a", val: 10 };
    let h: Header = Header { title: "b", count: 2 };
    if it.id != 1 || h.count != 2 {
        println("FAIL");
        process_exit(1);
    }
    println("two_structs: PASSED");
}
