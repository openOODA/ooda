// # Product prove std/os/path_canonicalize.oo
//
// Logline: Fail-closed emit+gcc+run asserts path_clean_slashes is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/path_canonicalize.oo.
//
// Beats:
//   1. Call path_clean_slashes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_canonicalize: PASSED only if they match.

import "std/os/path_canonicalize.oo";

pub fn main() {
    let a = path_clean_slashes("x");
    let b = path_clean_slashes("x");
    if a != b {
        println("FAIL path_clean_slashes");
        process_exit(1);
    }
    println("prod_path_canonicalize: PASSED");
}
