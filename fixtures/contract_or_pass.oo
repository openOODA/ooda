// # Or requires pass
//
// Logline: Accept pick(0, 3) because the right side of || is true.
//
// Beats:
//   1. Require a > 0 || b > 0.
//   2. Return a + b.
//   3. Print pick(0, 3).

// M162 path A: simple || in requires (runtime, not SMT)
pub fn pick(a: Int, b: Int) -> Int
    requires a > 0 || b > 0
{
    return a + b;
}

pub fn main() {
    println(pick(0, 3));
}
