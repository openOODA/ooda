// # Product prove std/sync/channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/channel.oo.
//
// Beats:
//   1. Call channel_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel: PASSED only if they match.

import "std/sync/channel.oo";

pub fn main() {
    let a = channel_probe();
    let b = channel_probe();
    if a != b {
        println("FAIL channel_probe");
        process_exit(1);
    }
    println("prod_channel: PASSED");
}
