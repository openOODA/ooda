// # Product prove std/genomics_advanced/overlap_layout_consensus.oo
//
// Logline: Fail-closed emit+gcc+run asserts olc_is_transitive_edge is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/overlap_layout_consensus.oo.
//
// Beats:
//   1. Call olc_is_transitive_edge twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_overlap_layout_consensus: PASSED only if they match.

import "std/genomics_advanced/overlap_layout_consensus.oo";

pub fn main() {
    let a: Bool = olc_is_transitive_edge(0, 0, 0, 0);
    let b: Bool = olc_is_transitive_edge(0, 0, 0, 0);
    if a != b {
        println("FAIL olc_is_transitive_edge");
        process_exit(1);
    }
    println("prod_overlap_layout_consensus: PASSED");
}
