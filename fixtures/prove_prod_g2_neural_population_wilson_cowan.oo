// # Product prove std/neuro_bci/neural_population_wilson_cowan.oo
//
// Logline: Fail-closed emit+gcc+run asserts wilson_cowan_sigmoid is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neural_population_wilson_cowan.oo.
//
// Beats:
//   1. Call wilson_cowan_sigmoid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_neural_population_wilson_cowan: PASSED only if they match.

import "std/neuro_bci/neural_population_wilson_cowan.oo";

pub fn main() {
    let neural_population_wilson_cowan_mark: Int = 0;
    if neural_population_wilson_cowan_mark != 0 {
        process_exit(1);
    }
    let a: Float = wilson_cowan_sigmoid(0.0, 0.0, 0.0);
    let b: Float = wilson_cowan_sigmoid(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL wilson_cowan_sigmoid");
        process_exit(1);
    }
    println("prod_g2_neural_population_wilson_cowan: PASSED");
}
