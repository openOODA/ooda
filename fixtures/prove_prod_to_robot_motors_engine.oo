// # Product prove std/robot/motors_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts motor_bank_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/motors_engine.oo.
//
// Beats:
//   1. Call motor_bank_new using the motors_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_motors_engine: PASSED only if asserts hold.

import "std/robot/motors_engine.oo";

pub fn main() {
    let obj = motor_bank_new();
    let motors_engine_a = obj.count;
    if motors_engine_a != 0 {
        println("FAIL motor_bank_new");
        process_exit(1);
    }
    println("prod_motors_engine: PASSED");
}
