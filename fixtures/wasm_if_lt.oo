// # Const if 1 < 2 println
//
// Logline: Print lt-then when the condition is 1 < 2.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If 1 < 2 print lt-then else print lt-else.
//   3. Leave no other statements.

pub fn main() {
    if 1 < 2 {
        println("lt-then");
    } else {
        println("lt-else");
    }
}
