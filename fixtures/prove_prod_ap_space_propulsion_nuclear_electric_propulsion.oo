// # Product prove std/space_propulsion/nuclear_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/nuclear_electric_propulsion.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/nuclear_electric_propulsion.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_nuclear_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/nuclear_electric_propulsion.oo";

pub fn main() {
    let nuclear_electric_propulsion_a = nep_system_spec_default_1mwe();
    let nuclear_electric_propulsion_b = nep_system_spec_default_1mwe();
    if nuclear_electric_propulsion_a.reactor_thermal_power_kw != nuclear_electric_propulsion_b.reactor_thermal_power_kw {
        println("FAIL nuclear_electric_propulsion");
        process_exit(1);
    }
    println("prod_ap_nuclear_electric_propulsion: PASSED");
}
