// # Connect in one match arm
//
// Logline: Connect only in Ok so the match join stays Closed.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Match an Ok result.
//   3. Connect only in the Ok arm.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    let r = Ok(1);
    match r {
        Ok(v) => {
            connect(s);
        }
        Err(e) => {
            let z = e;
        }
    }
}
