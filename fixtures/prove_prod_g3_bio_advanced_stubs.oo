// # Product prove std/bio_advanced/bio_advanced_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts bio_stub_gpu_gotoh_align is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/bio_advanced_stubs.oo.
//
// Beats:
//   1. Call bio_stub_gpu_gotoh_align twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bio_advanced_stubs: PASSED only if they match.

import "std/bio_advanced/bio_advanced_stubs.oo";

pub fn main() {
    let bio_advanced_stubs_mark: Int = 0;
    if bio_advanced_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = bio_stub_gpu_gotoh_align("x", "x");
    let b: Int = bio_stub_gpu_gotoh_align("x", "x");
    if a != b {
        println("FAIL bio_stub_gpu_gotoh_align");
        process_exit(1);
    }
    println("prod_bio_advanced_stubs: PASSED");
}
