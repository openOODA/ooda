// # Complex requires fail
//
// Logline: Violate a complex requires by passing a non-positive y.
//
// Beats:
//   1. Require both args positive.
//   2. Ensure result == x + y.
//   3. Call with 3, -4 so requires fail closed.

// Fail: complex requires violated
pub fn complex_fn(x: Int, y: Int) -> Int
    requires (x > 0 && y > 0)
    ensures result > 0 && (result == x + y)
{
    return x + y;
}

pub fn main() {
    println(complex_fn(3, -4));
}
