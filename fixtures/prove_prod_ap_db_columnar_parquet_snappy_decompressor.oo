// # Product prove std/db_columnar/parquet_snappy_decompressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_snappy_decompressor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_snappy_decompressor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_parquet_snappy_decompressor: PASSED only if they match.

import "std/db_columnar/parquet_snappy_decompressor.oo";

pub fn main() {
    let parquet_snappy_decompressor_a = snappy_parse_varint_len(list_new());
    let parquet_snappy_decompressor_b = snappy_parse_varint_len(list_new());
    if parquet_snappy_decompressor_a != parquet_snappy_decompressor_b {
        println("FAIL parquet_snappy_decompressor");
        process_exit(1);
    }
    println("prod_ap_parquet_snappy_decompressor: PASSED");
}
