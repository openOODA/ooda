// # Product prove std/zk_rollup/plonk_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/plonk_verifier.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_verifier.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_plonk_verifier: PASSED only if they match.

import "std/zk_rollup/plonk_verifier.oo";

pub fn main() {
    let plonk_verifier_a = plonk_verifying_key_new(0);
    let plonk_verifier_b = plonk_verifying_key_new(0);
    if plonk_verifier_a.domain_size != plonk_verifier_b.domain_size {
        println("FAIL plonk_verifier");
        process_exit(1);
    }
    println("prod_ap_plonk_verifier: PASSED");
}
