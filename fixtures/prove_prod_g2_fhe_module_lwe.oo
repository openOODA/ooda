// # Product prove std/fhe_lattices/fhe_module_lwe.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_module_lwe_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_module_lwe.oo.
//
// Beats:
//   1. Call fhe_module_lwe_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_module_lwe: PASSED only if they match.

import "std/fhe_lattices/fhe_module_lwe.oo";

pub fn main() {
    let a: Int = fhe_module_lwe_probe();
    let b: Int = fhe_module_lwe_probe();
    if a != b {
        println("FAIL fhe_module_lwe_probe");
        process_exit(1);
    }
    println("prod_g2_fhe_module_lwe: PASSED");
}
