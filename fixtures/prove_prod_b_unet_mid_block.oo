// # Product prove std/ai_multimodal/unet_mid_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts unet_mid_block_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_mid_block.oo.
//
// Beats:
//   1. Call unet_mid_block_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_unet_mid_block: PASSED only if they match.

import "std/ai_multimodal/unet_mid_block.oo";

pub fn main() {
    let a = unet_mid_block_marker();
    let b = unet_mid_block_marker();
    if a != b {
        println("FAIL unet_mid_block_marker");
        process_exit(1);
    }
    println("prod_unet_mid_block: PASSED");
}
