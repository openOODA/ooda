// # Product prove std/astrodynamics/gravitational_j2_perturbation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/gravitational_j2_perturbation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/gravitational_j2_perturbation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gravitational_j2_perturbation: PASSED only if they match.

import "std/astrodynamics/gravitational_j2_perturbation.oo";

pub fn main() {
    let gravitational_j2_perturbation_a = earth_j2_milli();
    let gravitational_j2_perturbation_b = earth_j2_milli();
    if gravitational_j2_perturbation_a != gravitational_j2_perturbation_b {
        println("FAIL gravitational_j2_perturbation");
        process_exit(1);
    }
    println("prod_ap_gravitational_j2_perturbation: PASSED");
}
