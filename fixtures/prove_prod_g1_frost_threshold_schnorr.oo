// # Product prove std/bft_consensus/frost_threshold_schnorr.oo
//
// Logline: Fail-closed emit+gcc+run asserts frost_is_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/frost_threshold_schnorr.oo.
//
// Beats:
//   1. Call frost_is_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_frost_threshold_schnorr: PASSED only if they match.

import "std/bft_consensus/frost_threshold_schnorr.oo";

pub fn main() {
    let obj_a: FrostSession = frost_session_new(0, "x");
    let obj_b: FrostSession = frost_session_new(0, "x");
    let a: Bool = frost_is_ready(obj_a);
    let b: Bool = frost_is_ready(obj_b);
    if a != b {
        println("FAIL frost_is_ready");
        process_exit(1);
    }
    println("prod_frost_threshold_schnorr: PASSED");
}
