// # Product prove std/physics/fluid_particle.oo
//
// Logline: Fail-closed emit+gcc+run asserts fluid_particle_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/physics/fluid_particle.oo.
//
// Beats:
//   1. Call fluid_particle_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fluid_particle: PASSED only if it matches.

import "std/physics/fluid_particle.oo";

pub fn main() {
    let a: Int = fluid_particle_probe();
    if a != 0 {
        println("FAIL fluid_particle_probe");
        process_exit(1);
    }
    println("prod_nc_fluid_particle: PASSED");
}
