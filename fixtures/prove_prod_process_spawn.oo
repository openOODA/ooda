// # Product prove std/os/process_spawn.oo
//
// Logline: Fail-closed emit+gcc+run asserts process_spawn_to_cmd is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/process_spawn.oo.
//
// Beats:
//   1. Call process_spawn_to_cmd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_process_spawn: PASSED only if they match.

import "std/os/process_spawn.oo";

pub fn main() {
    let obj = process_spawn_config_new("x");
    let a = process_spawn_to_cmd(obj);
    let b = process_spawn_to_cmd(obj);
    if a != b {
        println("FAIL process_spawn_to_cmd");
        process_exit(1);
    }
    println("prod_process_spawn: PASSED");
}
