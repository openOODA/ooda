// # Product prove std/uav_flight/uav_geofence_containment.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/uav_flight/uav_geofence_containment.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_geofence_containment.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_uav_geofence_containment: PASSED only if they match.

import "std/uav_flight/uav_geofence_containment.oo";

pub fn main() {
    let uav_geofence_containment_a = gef_isqrt_seed(0, 0);
    let uav_geofence_containment_b = gef_isqrt_seed(0, 0);
    if uav_geofence_containment_a != uav_geofence_containment_b {
        println("FAIL uav_geofence_containment");
        process_exit(1);
    }
    println("prod_ap_uav_geofence_containment: PASSED");
}
