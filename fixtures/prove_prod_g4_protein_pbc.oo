// # Product prove std/protein_folding/md_periodic_boundary_pbc.oo
//
// Logline: Fail-closed emit+gcc+run asserts periodic boundary conditions and minimum image displacement calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_periodic_boundary_pbc.oo.
//
// Beats:
//   1. Verify pbc_sqrt calculation.
//   2. Create SimulationBox3D with pbc_box_new and wrap individual coordinates and 3D points.
//   3. Calculate minimum image displacement between two points across periodic boundaries.
//   4. Print prod_g4_protein_pbc: PASSED and exit 0.

import "std/protein_folding/md_periodic_boundary_pbc.oo";

pub fn main() {
    let s: Float = pbc_sqrt(25.0);
    if s < 4.99 || s > 5.01 {
        println("FAIL pbc_sqrt");
        process_exit(1);
    }

    let box: SimulationBox3D = pbc_box_new(10.0, 10.0, 10.0);
    if (box).lx != 10.0 || (box).inv_lx < 0.099 || (box).inv_lx > 0.101 {
        println("FAIL pbc_box_new");
        process_exit(1);
    }

    let c_wrapped: Float = pbc_wrap_coordinate(12.5, 10.0);
    if c_wrapped < 2.49 || c_wrapped > 2.51 {
        println("FAIL pbc_wrap_coordinate");
        process_exit(1);
    }

    let pt: Point3D = Point3D { x: 12.5, y: 0.0 - 1.0, z: 25.0 };
    let pt_wrapped: Point3D = pbc_wrap_point(&pt, &box);
    if (pt_wrapped).x < 2.49 || (pt_wrapped).x > 2.51 || (pt_wrapped).y < 8.99 || (pt_wrapped).y > 9.01 || (pt_wrapped).z < 4.99 || (pt_wrapped).z > 5.01 {
        println("FAIL pbc_wrap_point");
        process_exit(1);
    }

    let p1: Point3D = Point3D { x: 1.0, y: 2.0, z: 3.0 };
    let p2: Point3D = Point3D { x: 9.0, y: 8.0, z: 7.0 };
    let disp1: PbcDisplacementResult = pbc_minimum_image_disp(&p1, &p2, &box);
    let disp2: PbcDisplacementResult = pbc_minimum_image_disp(&p1, &p2, &box);

    if (disp1).dist_sq != (disp2).dist_sq || (disp1).dist < 5.99 || (disp1).dist > 6.01 {
        println("FAIL pbc_minimum_image_disp");
        process_exit(1);
    }

    println("prod_g4_protein_pbc: PASSED");
    process_exit(0);
}
