// # Product prove std/iot_scada/bacnet_cov_subscription.oo
//
// Logline: Fail-closed emit+gcc+run asserts bacnet_cov_sub_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_cov_subscription.oo.
//
// Beats:
//   1. Call bacnet_cov_sub_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bacnet_cov_sub: PASSED only if they match.

import "std/iot_scada/bacnet_cov_subscription.oo";

pub fn main() {
    let a: BacnetCovSubscription = bacnet_cov_sub_new(1, 2, 3, 60, 0.5);
    let b: BacnetCovSubscription = bacnet_cov_sub_new(1, 2, 3, 60, 0.5);
    let a_id: Int = (a).subscriber_process_id;
    let b_id: Int = (b).subscriber_process_id;
    let bacnet_cov_subscription_mark: Int = 0;
    if bacnet_cov_subscription_mark != 0 { process_exit(1); }
    if a_id != b_id {
        println("FAIL bacnet_cov_sub_new");
        process_exit(1);
    }
    println("prod_bacnet_cov_sub: PASSED");
}
