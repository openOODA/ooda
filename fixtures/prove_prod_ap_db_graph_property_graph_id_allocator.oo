// # Product prove std/db_graph/property_graph_id_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_id_allocator.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_id_allocator.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_property_graph_id_allocator: PASSED only if they match.

import "std/db_graph/property_graph_id_allocator.oo";

pub fn main() {
    let property_graph_id_allocator_a = graph_id_allocator_new(0);
    let property_graph_id_allocator_b = graph_id_allocator_new(0);
    if property_graph_id_allocator_a.entity_kind != property_graph_id_allocator_b.entity_kind {
        println("FAIL property_graph_id_allocator");
        process_exit(1);
    }
    println("prod_ap_property_graph_id_allocator: PASSED");
}
