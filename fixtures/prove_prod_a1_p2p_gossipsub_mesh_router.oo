// # Product prove std/bft_consensus/p2p_gossipsub_mesh_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts gossip_topic_mesh_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/p2p_gossipsub_mesh_router.oo.
//
// Beats:
//   1. Call gossip_topic_mesh_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_p2p_gossipsub_mesh_router: PASSED only if they match.

import "std/bft_consensus/p2p_gossipsub_mesh_router.oo";

pub fn main() {
    let p2p_gossipsub_mesh_router_mark: Int = 0;
    if p2p_gossipsub_mesh_router_mark != 0 {
        process_exit(1);
    }
    let a: GossipTopicMesh = gossip_topic_mesh_new("x", 0, 0, 0);
    let b: GossipTopicMesh = gossip_topic_mesh_new("x", 0, 0, 0);
    if (a).d_target != (b).d_target {
        println("FAIL gossip_topic_mesh_new");
        process_exit(1);
    }
    println("prod_p2p_gossipsub_mesh_router: PASSED");
}
