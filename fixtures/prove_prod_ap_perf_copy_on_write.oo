// # Product prove std/perf/copy_on_write.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/copy_on_write.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/copy_on_write.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_copy_on_write: PASSED only if they match.

import "std/perf/copy_on_write.oo";

pub fn main() {
    let copy_on_write_a = cow_buffer_create("x", "x");
    let copy_on_write_b = cow_buffer_create("x", "x");
    let copy_on_write_va = cow_buffer_refcount(copy_on_write_a);
    let copy_on_write_vb = cow_buffer_refcount(copy_on_write_b);
    if copy_on_write_va != copy_on_write_vb {
        println("FAIL copy_on_write");
        process_exit(1);
    }
    println("prod_ap_copy_on_write: PASSED");
}
