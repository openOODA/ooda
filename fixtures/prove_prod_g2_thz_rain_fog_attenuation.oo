// # Product prove std/telecom_6g/thz_rain_fog_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_rain_specific_attenuation is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_rain_fog_attenuation.oo.
//
// Beats:
//   1. Call thz_rain_specific_attenuation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thz_rain_fog_attenuation: PASSED only if they match.

import "std/telecom_6g/thz_rain_fog_attenuation.oo";

pub fn main() {
    let thz_rain_fog_attenuation_mark: Int = 0;
    if thz_rain_fog_attenuation_mark != 0 {
        process_exit(1);
    }
    let a: Float = thz_rain_specific_attenuation(0.0, 0.0);
    let b: Float = thz_rain_specific_attenuation(0.0, 0.0);
    if a != b {
        println("FAIL thz_rain_specific_attenuation");
        process_exit(1);
    }
    println("prod_g2_thz_rain_fog_attenuation: PASSED");
}
