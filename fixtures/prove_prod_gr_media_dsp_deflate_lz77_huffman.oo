// # Product prove std/media_dsp/deflate_lz77_huffman.oo
//
// Logline: Fail-closed emit+gcc+run asserts deflate_decode_fixed_literal_symbol is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/deflate_lz77_huffman.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call deflate_decode_fixed_literal_symbol twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_deflate_lz77_huffman: PASSED only if they match.

import "std/media_dsp/deflate_lz77_huffman.oo";

pub fn main() {
    let g0_a = deflate_decode_fixed_literal_symbol(0);
    let g0_b = deflate_decode_fixed_literal_symbol(0);
    if g0_a != g0_b {
        println("FAIL deflate_decode_fixed_literal_symbol");
        process_exit(1);
    }
    println("prod_gr_deflate_lz77_huffman: PASSED");
}
