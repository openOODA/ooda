// # Trait method monomorphization
//
// Logline: Parse one trait and impl, then call the monomorphized method.
//
// Setup: OPEN-83. trait T { fn greet(); } plus impl T for S.
//
// Beats:
//   1. Parse TraitDecl.
//   2. impl T for S supplies greet.
//   3. s.greet() typechecks, emits, and prints 1.

type Spot = struct {
    n: Int
};

trait T {
    fn greet();
}

impl T for Spot {
    fn greet() {
        println(1);
    }
}

pub fn main() {
    let s = Spot { n: 1 };
    s.greet();
}
