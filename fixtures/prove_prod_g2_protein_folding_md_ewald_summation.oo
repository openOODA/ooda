// # Product prove std/protein_folding/md_ewald_summation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ewald_reciprocal_factor is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_ewald_summation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ewald_reciprocal_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_ewald_summation: PASSED only if they match.

import "std/protein_folding/md_ewald_summation.oo";

pub fn main() {
    let g2_oa = ewald_make_k_vector(2, 2, 2, 1.0);
    let g2_ob = ewald_make_k_vector(2, 2, 2, 1.0);
    let g2_a = ewald_reciprocal_factor(&g2_oa, 1.0, 1.0);
    let g2_b = ewald_reciprocal_factor(&g2_ob, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL ewald_reciprocal_factor");
        process_exit(1);
    }
    println("prod_g2_md_ewald_summation: PASSED");
}
