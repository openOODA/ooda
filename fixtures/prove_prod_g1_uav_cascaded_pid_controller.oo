// # Product prove std/uav_flight/uav_cascaded_pid_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts pid_output is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_cascaded_pid_controller.oo.
//
// Beats:
//   1. Call pid_output twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_cascaded_pid_controller: PASSED only if they match.

import "std/uav_flight/uav_cascaded_pid_controller.oo";

pub fn main() {
    let obj_a: PIDStepResult = position_to_velocity_sp(0, 0, 0, 0, 0, 0, 0, 0);
    let obj_b: PIDStepResult = position_to_velocity_sp(0, 0, 0, 0, 0, 0, 0, 0);
    let a: Int = pid_output(obj_a);
    let b: Int = pid_output(obj_b);
    if a != b {
        println("FAIL pid_output");
        process_exit(1);
    }
    println("prod_uav_cascaded_pid_controller: PASSED");
}
