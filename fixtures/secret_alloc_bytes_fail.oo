// # Refuse secret alloc_bytes size
//
// Logline: A secret size argument must not reach alloc_bytes.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the alloc size.
//   3. Expect the sink to refuse.

// Secret refuse: alloc_bytes
// SECRET: token
pub fn main(al: &AllocCap) {
    let token = 64;
    let r = alloc_bytes(al, token);
    println(1);
}
