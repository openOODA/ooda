// # Product prove std/sec/sys/elf_inspect.oo
//
// Logline: Fail-closed emit+check asserts elf_inspect_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_inspect.oo.
//
// Beats:
//   1. Call elf_inspect_probe twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_inspect: PASSED only if they match.

import "std/sec/sys/elf_inspect.oo";

pub fn main() {
    let elf_inspect_mark: Int = 0;
    if elf_inspect_mark != 0 { process_exit(1); }
    let a: Int = elf_inspect_probe();
    let b: Int = elf_inspect_probe();
    if a != b { process_exit(1); }
    println("prod_elf_inspect: PASSED");
}
