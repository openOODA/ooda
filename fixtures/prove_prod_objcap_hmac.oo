// # Product prove std/sec/objcap_hmac.oo
//
// Logline: Fail-closed emit+gcc+run asserts objcap_hmac_seal is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/objcap_hmac.oo.
//
// Beats:
//   1. Call objcap_hmac_seal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap_hmac: PASSED only if they match.

import "std/sec/objcap_hmac.oo";

pub fn main() {
    let a = objcap_hmac_seal("x", "x");
    let b = objcap_hmac_seal("x", "x");
    if a != b {
        println("FAIL objcap_hmac_seal");
        process_exit(1);
    }
    println("prod_objcap_hmac: PASSED");
}
