// # Canonical CBOR adversarial suite
//
// Logline: Roundtrips int, bstr, tstr, array, and map, and rejects extra-width integers, depth 33, and truncated items.
//
// Setup: Pure. Imports cbor_strict.oo. Run from ooda/.
//
// Beats:
//   1. Encode then decode each named major type.
//   2. Prove integer 24 uses the shortest one-byte argument.
//   3. Reject a non-shortest int, a 33-deep nest, and a truncated buffer.

import "std/encoding/cbor_strict.oo";

fn need(flag: Int, err: String, bytes: List[Int], msg: String) -> List[Int] {
    if flag < 1 {
        println("FAIL " + msg + ": " + err);
        process_exit(1);
    }
    return bytes;
}

fn must_err(flag: Int, msg: String) {
    if flag > 0 {
        println("FAIL " + msg);
        process_exit(1);
    }
}

pub fn main() {
    let ei: ByteOut = cbor_strict_encode_int(24);
    let ib: List[Int] = need(ei.flag, ei.err, ei.bytes, "int");
    if list_get(ib, 0) != 24 {
        println("FAIL shortest header");
        process_exit(1);
    }
    let di: ByteOut = cbor_strict_decode(ib);
    if di.flag < 1 {
        println("FAIL decode int " + di.err);
        process_exit(1);
    }
    let mut bs: List[Int] = list_new();
    bs = list_push(bs, 1);
    bs = list_push(bs, 2);
    let eb: ByteOut = cbor_strict_encode_bstr(bs);
    let bb: List[Int] = need(eb.flag, eb.err, eb.bytes, "bstr");
    let db: ByteOut = cbor_strict_decode(bb);
    if db.flag < 1 {
        println("FAIL bstr");
        process_exit(1);
    }
    let et: ByteOut = cbor_strict_encode_tstr(bs);
    let tb: List[Int] = need(et.flag, et.err, et.bytes, "tstr");
    let dt: ByteOut = cbor_strict_decode(tb);
    if dt.flag < 1 {
        println("FAIL tstr");
        process_exit(1);
    }
    let ea: ByteOut = cbor_strict_encode_array_n(1, ib);
    let ab: List[Int] = need(ea.flag, ea.err, ea.bytes, "arr");
    let da: ByteOut = cbor_strict_decode(ab);
    if da.flag < 1 {
        println("FAIL array");
        process_exit(1);
    }
    let kids: List[Int] = cbor_strict_cat(ib, ib);
    let em: ByteOut = cbor_strict_encode_map_n(1, kids);
    let mb: List[Int] = need(em.flag, em.err, em.bytes, "map");
    let dm: ByteOut = cbor_strict_decode(mb);
    if dm.flag < 1 {
        println("FAIL map");
        process_exit(1);
    }
    println("int/bstr/tstr/array/map roundtrip");
    println("shortest-int form");

    let mut wide: List[Int] = list_new();
    wide = list_push(wide, 24);
    wide = list_push(wide, 5);
    let w: ByteOut = cbor_strict_decode(wide);
    must_err(w.flag, "non-shortest");
    let mut nest: List[Int] = ib;
    let mut d: Int = 0;
    while d < 33 {
        let w2: ByteOut = cbor_strict_encode_array_n(1, nest);
        nest = need(w2.flag, w2.err, w2.bytes, "nest");
        d = d + 1;
    }
    let deep: ByteOut = cbor_strict_decode(nest);
    must_err(deep.flag, "depth 33");
    println("depth 33 is Err");
    let mut tr: List[Int] = list_new();
    tr = list_push(tr, 88);
    let t: ByteOut = cbor_strict_decode(tr);
    must_err(t.flag, "truncated");
    println("truncated item is Err");
    println("SUITE PASSED");
    println("test_cbor_strict: PASSED");
}
