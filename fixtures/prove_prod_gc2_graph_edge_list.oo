// # Product prove std/graph_topology/graph_edge_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts edge_list_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_edge_list.oo.
//
// Beats:
//   1. Call edge_list_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_edge_list: PASSED only if they match.

import "std/graph_topology/graph_edge_list.oo";

pub fn main() {
    let graph_edge_list_mark: Int = 0;
    if graph_edge_list_mark != 0 {
        process_exit(1);
    }
    let graph_edge_list_a = edge_list_create(true);
    let graph_edge_list_b = edge_list_create(true);
    if (graph_edge_list_a).edge_count != (graph_edge_list_b).edge_count {
        println("FAIL edge_list_create");
        process_exit(1);
    }
    println("prod_graph_edge_list: PASSED");
}
