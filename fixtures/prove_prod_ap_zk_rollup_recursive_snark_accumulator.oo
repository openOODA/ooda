// # Product prove std/zk_rollup/recursive_snark_accumulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/recursive_snark_accumulator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/recursive_snark_accumulator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_recursive_snark_accumulator: PASSED only if they match.

import "std/zk_rollup/recursive_snark_accumulator.oo";

pub fn main() {
    let recursive_snark_accumulator_a = nova_fold_witness_slot(0, 0, 0, 0);
    let recursive_snark_accumulator_b = nova_fold_witness_slot(0, 0, 0, 0);
    if recursive_snark_accumulator_a != recursive_snark_accumulator_b {
        println("FAIL recursive_snark_accumulator");
        process_exit(1);
    }
    println("prod_ap_recursive_snark_accumulator: PASSED");
}
