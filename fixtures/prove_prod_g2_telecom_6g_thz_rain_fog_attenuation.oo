// # Product prove std/telecom_6g/thz_rain_fog_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_rain_specific_attenuation is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_rain_fog_attenuation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call thz_rain_specific_attenuation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thz_rain_fog_attenuation: PASSED only if they match.

import "std/telecom_6g/thz_rain_fog_attenuation.oo";

pub fn main() {
    let g2_a = thz_rain_specific_attenuation(1.0, 1.0);
    let g2_b = thz_rain_specific_attenuation(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL thz_rain_specific_attenuation");
        process_exit(1);
    }
    println("prod_g2_thz_rain_fog_attenuation: PASSED");
}
