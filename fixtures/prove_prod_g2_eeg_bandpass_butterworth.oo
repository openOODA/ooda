// # Product prove std/neuro_bci/eeg_bandpass_butterworth.oo
//
// Logline: Fail-closed emit+gcc+run asserts biquad_state_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_bandpass_butterworth.oo.
//
// Beats:
//   1. Call biquad_state_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eeg_bandpass_butterworth: PASSED only if they match.

import "std/neuro_bci/eeg_bandpass_butterworth.oo";

pub fn main() {
    let eeg_bandpass_butterworth_mark: Int = 0;
    if eeg_bandpass_butterworth_mark != 0 {
        process_exit(1);
    }
    let a: BiquadState = biquad_state_zero();
    let b: BiquadState = biquad_state_zero();
    if (a).z1 != (b).z1 {
        println("FAIL biquad_state_zero");
        process_exit(1);
    }
    println("prod_g2_eeg_bandpass_butterworth: PASSED");
}
