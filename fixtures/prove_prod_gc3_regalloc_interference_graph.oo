// # Product prove std/compilers_vm/regalloc_interference_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts rig_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_interference_graph.oo.
//
// Beats:
//   1. Call rig_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regalloc_interference_graph: PASSED only if they match.

import "std/compilers_vm/regalloc_interference_graph.oo";

pub fn main() {
    let regalloc_interference_graph_mark: Int = 0;
    if regalloc_interference_graph_mark != 0 {
        process_exit(1);
    }
    let regalloc_interference_graph_a = rig_node_new(1, "x");
    let regalloc_interference_graph_b = rig_node_new(1, "x");
    if (regalloc_interference_graph_a).var_id != (regalloc_interference_graph_b).var_id {
        println("FAIL rig_node_new");
        process_exit(1);
    }
    println("prod_regalloc_interference_graph: PASSED");
}
