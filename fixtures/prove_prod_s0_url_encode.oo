// # Product prove std/encoding/url_encode.oo
//
// Logline: Fail-closed emit+gcc+run asserts url_encode value or determinism.
//
// Setup: Isolated emit-c. Imports std/encoding/url_encode.oo.
//
// Beats:
//   1. Call url_encode twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_url_encode: PASSED only if asserts hold.

import "std/encoding/url_encode.oo";

pub fn main() {
    let url_encode_a: String = url_encode("a");
    let url_encode_b: String = url_encode("a");
    if chars_len(url_encode_a) != 1 {
        println("FAIL url_encode len");
        process_exit(1);
    }
    if chars_len(url_encode_a) != chars_len(url_encode_b) {
        println("FAIL url_encode det");
        process_exit(1);
    }
    println("prod_url_encode: PASSED");
}
