// # Product prove std/compilers_vm/wasm_exception_handling.oo
//
// Logline: Fail-closed emit+gcc+run asserts catch_kind_tag is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_exception_handling.oo.
//
// Beats:
//   1. Call catch_kind_tag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_exception_handling: PASSED only if they match.

import "std/compilers_vm/wasm_exception_handling.oo";

pub fn main() {
    let wasm_exception_handling_mark: Int = 0;
    if wasm_exception_handling_mark != 0 {
        process_exit(1);
    }
    let a: Int = catch_kind_tag();
    let b: Int = catch_kind_tag();
    if a != b {
        println("FAIL catch_kind_tag");
        process_exit(1);
    }
    println("prod_wasm_exception_handling: PASSED");
}
