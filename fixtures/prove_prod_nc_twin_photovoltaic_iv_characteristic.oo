// # Product prove std/digital_twin/twin_photovoltaic_iv_characteristic.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_photovoltaic_iv_characteristic_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_photovoltaic_iv_characteristic.oo.
//
// Beats:
//   1. Call twin_photovoltaic_iv_characteristic_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_twin_photovoltaic_iv_characteristic: PASSED only if it matches.

import "std/digital_twin/twin_photovoltaic_iv_characteristic.oo";

pub fn main() {
    let a: Int = twin_photovoltaic_iv_characteristic_probe();
    if a != 0 {
        println("FAIL twin_photovoltaic_iv_characteristic_probe");
        process_exit(1);
    }
    println("prod_nc_twin_photovoltaic_iv_characteristic: PASSED");
}
