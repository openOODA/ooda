// # Product prove std/gis_spatial/h3_hex_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/h3_hex_grid.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/h3_hex_grid.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_h3_hex_grid: PASSED only if they match.

import "std/gis_spatial/h3_hex_grid.oo";

pub fn main() {
    let h3_hex_grid_a = h3_is_valid_resolution(0);
    let h3_hex_grid_b = h3_is_valid_resolution(0);
    if h3_hex_grid_a != h3_hex_grid_b {
        println("FAIL h3_hex_grid");
        process_exit(1);
    }
    println("prod_ap_h3_hex_grid: PASSED");
}
