// # Product prove std/telecom_5g/channel_3gpp_tapped_delay.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/channel_3gpp_tapped_delay.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_3gpp_tapped_delay.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_channel_3gpp_tapped_delay: PASSED only if they match.

import "std/telecom_5g/channel_3gpp_tapped_delay.oo";

pub fn main() {
    let channel_3gpp_tapped_delay_a = channel_tdl_scaled_delay_ns(0.0, 0.0);
    let channel_3gpp_tapped_delay_b = channel_tdl_scaled_delay_ns(0.0, 0.0);
    if channel_3gpp_tapped_delay_a != channel_3gpp_tapped_delay_b {
        println("FAIL channel_3gpp_tapped_delay");
        process_exit(1);
    }
    println("prod_ap_channel_3gpp_tapped_delay: PASSED");
}
