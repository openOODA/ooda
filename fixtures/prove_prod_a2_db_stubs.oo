// # Product prove std/database/db_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts db_hardware_direct_io_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/db_stubs.oo.
//
// Beats:
//   1. Call db_hardware_direct_io_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_db_stubs: PASSED only if they match.

import "std/database/db_stubs.oo";

pub fn main() {
    let db_stubs_mark: Int = 0;
    if db_stubs_mark != 0 {
        process_exit(1);
    }
    let a: DbHardwareDirectIo = db_hardware_direct_io_init(0);
    let b: DbHardwareDirectIo = db_hardware_direct_io_init(0);
    if (a).device_fd != (b).device_fd {
        println("FAIL db_hardware_direct_io_init");
        process_exit(1);
    }
    println("prod_db_stubs: PASSED");
}
