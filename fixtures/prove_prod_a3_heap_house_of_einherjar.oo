// # Product prove std/exploit_analysis/heap_house_of_einherjar.oo
//
// Logline: Fail-closed emit+gcc+run asserts house_of_einherjar_plan_build is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_house_of_einherjar.oo.
//
// Beats:
//   1. Call house_of_einherjar_plan_build twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_house_of_einherjar: PASSED only if they match.

import "std/exploit_analysis/heap_house_of_einherjar.oo";

pub fn main() {
    let heap_house_of_einherjar_mark: Int = 0;
    if heap_house_of_einherjar_mark != 0 {
        process_exit(1);
    }
    let a: HouseOfEinherjarPlan = house_of_einherjar_plan_build(0, 0, 0);
    let b: HouseOfEinherjarPlan = house_of_einherjar_plan_build(0, 0, 0);
    if (a).fake_chunk_address != (b).fake_chunk_address {
        println("FAIL house_of_einherjar_plan_build");
        process_exit(1);
    }
    println("prod_heap_house_of_einherjar: PASSED");
}
