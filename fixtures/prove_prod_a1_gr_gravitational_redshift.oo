// # Product prove std/astrophysics_relativity/gr_gravitational_redshift.oo
//
// Logline: Fail-closed emit+gcc+run asserts gr_schwarzschild_redshift is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_gravitational_redshift.oo.
//
// Beats:
//   1. Call gr_schwarzschild_redshift twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_gravitational_redshift: PASSED only if they match.

import "std/astrophysics_relativity/gr_gravitational_redshift.oo";

pub fn main() {
    let gr_gravitational_redshift_mark: Int = 0;
    if gr_gravitational_redshift_mark != 0 {
        process_exit(1);
    }
    let a: GravitationalRedshiftResult = gr_schwarzschild_redshift(0, 0);
    let b: GravitationalRedshiftResult = gr_schwarzschild_redshift(0, 0);
    if (a).radius != (b).radius {
        println("FAIL gr_schwarzschild_redshift");
        process_exit(1);
    }
    println("prod_gr_gravitational_redshift: PASSED");
}
