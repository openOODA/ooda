// # Product prove std/telecom_6g/ris_mac_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_calc_proportional_fairness_metric is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_mac_scheduler.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ris_calc_proportional_fairness_metric twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_ris_mac_scheduler: PASSED only if they match.

import "std/telecom_6g/ris_mac_scheduler.oo";

pub fn main() {
    let g0_a = ris_calc_proportional_fairness_metric(2, 1.0);
    let g0_b = ris_calc_proportional_fairness_metric(2, 1.0);
    if g0_a != g0_b {
        println("FAIL ris_calc_proportional_fairness_metric");
        process_exit(1);
    }
    println("prod_g0_ris_mac_scheduler: PASSED");
}
