// # Product prove std/auto_mpc_control/torque_vectoring_diff_allocation.oo
//
// Logline: Fail-closed emit+gcc+run asserts torque_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/torque_vectoring_diff_allocation.oo.
//
// Beats:
//   1. Call torque_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_torque_vectoring_diff_allocation: PASSED only if they match.

import "std/auto_mpc_control/torque_vectoring_diff_allocation.oo";

pub fn main() {
    let torque_vectoring_diff_allocation_mark: Int = 0;
    if torque_vectoring_diff_allocation_mark != 0 {
        process_exit(1);
    }
    let torque_vectoring_diff_allocation_a: TorqueAllocationParams = torque_params_default();
    let torque_vectoring_diff_allocation_b: TorqueAllocationParams = torque_params_default();
    if (torque_vectoring_diff_allocation_a).track_width != (torque_vectoring_diff_allocation_b).track_width {
        println("FAIL torque_params_default");
        process_exit(1);
    }
    println("prod_torque_vectoring_diff_allocation: PASSED");
}
