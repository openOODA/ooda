// # Product prove std/quantum/quantum_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum/quantum_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/quantum_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_stubs: PASSED only if they match.

import "std/quantum/quantum_stubs.oo";

pub fn main() {
    let quantum_stubs_a = quantum_stub_ion_trap_calibrate();
    let quantum_stubs_b = quantum_stub_ion_trap_calibrate();
    if quantum_stubs_a != quantum_stubs_b {
        println("FAIL quantum_stubs");
        process_exit(1);
    }
    println("prod_ap_quantum_stubs: PASSED");
}
