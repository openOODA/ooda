// # Product prove std/aero/tvc_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/tvc_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tvc_engine: PASSED only if they match.

import "std/aero/tvc_engine.oo";

pub fn main() {
    let tvc_engine_a = tvc_pi();
    let tvc_engine_b = tvc_pi();
    if tvc_engine_a != tvc_engine_b {
        println("FAIL tvc_engine");
        process_exit(1);
    }
    println("prod_ap_tvc_engine: PASSED");
}
