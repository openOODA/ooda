// # Product prove std/sec/crypto/falcon_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon_poly.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_poly.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_falcon_poly: PASSED and exit 0 only on match.

import "std/sec/crypto/falcon_poly.oo";

pub fn main() {
    let p_zero_a: FalconPolynomial = falcon_polynomial_zero(4);
    let p_zero_b: FalconPolynomial = falcon_polynomial_zero(4);
    if (p_zero_a).degree != (p_zero_b).degree || (p_zero_a).degree != 4 {
        println("FAIL falcon_poly falcon_polynomial_zero");
        process_exit(1);
    }

    let mut c1: List[Int] = list_new();
    c1 = list_push(c1, 10);
    c1 = list_push(c1, 20);
    c1 = list_push(c1, 30);
    c1 = list_push(c1, 40);

    let p1_a: FalconPolynomial = falcon_polynomial_create(4, c1, false);
    let p1_b: FalconPolynomial = falcon_polynomial_create(4, c1, false);
    if (p1_a).degree != (p1_b).degree {
        println("FAIL falcon_poly falcon_polynomial_create");
        process_exit(1);
    }

    let g_val_a: Int = falcon_polynomial_get(p1_a, 2);
    let g_val_b: Int = falcon_polynomial_get(p1_b, 2);
    if g_val_a != g_val_b || g_val_a != 30 {
        println("FAIL falcon_poly falcon_polynomial_get");
        process_exit(1);
    }

    let p_mod_a: FalconPolynomial = falcon_polynomial_set(p1_a, 2, 99);
    let p_mod_b: FalconPolynomial = falcon_polynomial_set(p1_b, 2, 99);
    let m_val_a: Int = falcon_polynomial_get(p_mod_a, 2);
    let m_val_b: Int = falcon_polynomial_get(p_mod_b, 2);
    if m_val_a != m_val_b || m_val_a != 99 {
        println("FAIL falcon_poly falcon_polynomial_set");
        process_exit(1);
    }

    let cmod_a: Int = falcon_polynomial_center_mod(15, 20);
    let cmod_b: Int = falcon_polynomial_center_mod(15, 20);
    if cmod_a != cmod_b || cmod_a != -5 {
        println("FAIL falcon_poly falcon_polynomial_center_mod");
        process_exit(1);
    }

    let mut c2: List[Int] = list_new();
    c2 = list_push(c2, 5);
    c2 = list_push(c2, 15);
    c2 = list_push(c2, 25);
    c2 = list_push(c2, 35);
    let p2: FalconPolynomial = falcon_polynomial_create(4, c2, false);

    let p_add: FalconPolynomial = falcon_polynomial_add(p1_a, p2, 100);
    let p_sub: FalconPolynomial = falcon_polynomial_sub(p1_a, p2, 100);
    let add_c0: Int = falcon_polynomial_get(p_add, 0);
    let sub_c0: Int = falcon_polynomial_get(p_sub, 0);
    if add_c0 != 15 || sub_c0 != 5 {
        println("FAIL falcon_poly add/sub");
        process_exit(1);
    }

    let p_mul: FalconPolynomial = falcon_polynomial_scalar_mul(p1_a, 3, 100);
    let mul_c1: Int = falcon_polynomial_get(p_mul, 1);
    if mul_c1 != 60 {
        println("FAIL falcon_poly scalar_mul");
        process_exit(1);
    }

    println("prod_g4_sec_falcon_poly: PASSED");
    process_exit(0);
}
