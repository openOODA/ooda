// # Product prove std/sec/crypto/poly1305_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts poly1305_tag_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/poly1305_types.oo.
//
// Beats:
//   1. Call poly1305_tag_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_poly1305_types: PASSED only if they match.

import "std/sec/crypto/poly1305_types.oo";

pub fn main() {
    let obj = poly1305_tag_new(0, 0, 0);
    let a = poly1305_tag_checksum(obj);
    let b = poly1305_tag_checksum(obj);
    if a != b {
        println("FAIL poly1305_tag_checksum");
        process_exit(1);
    }
    println("prod_poly1305_types: PASSED");
}
