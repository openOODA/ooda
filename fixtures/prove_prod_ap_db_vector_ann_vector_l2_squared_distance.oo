// # Product prove std/db_vector_ann/vector_l2_squared_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_l2_squared_distance.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_l2_squared_distance.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_l2_squared_distance: PASSED only if they match.

import "std/db_vector_ann/vector_l2_squared_distance.oo";

pub fn main() {
    let vector_l2_squared_distance_a = compute_l2_squared_distance(list_new(), list_new());
    let vector_l2_squared_distance_b = compute_l2_squared_distance(list_new(), list_new());
    if vector_l2_squared_distance_a != vector_l2_squared_distance_b {
        println("FAIL vector_l2_squared_distance");
        process_exit(1);
    }
    println("prod_ap_vector_l2_squared_distance: PASSED");
}
