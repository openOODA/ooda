// # Export the first shared_name
//
// Logline: Define shared_name as x plus one for a duplicate-import residual.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Export shared_name.
//   2. Add one to x.
//   3. Leave this leaf as the first import.
//
// Residual: first module defining shared_name.
pub fn shared_name(x: Int) -> Int {
    return x + 1;
}
