// # Export the second shared_name
//
// Logline: Redefine shared_name as x plus ten so two imports collide.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Export the same name.
//   2. Add ten to x.
//   3. Leave this leaf as the second import.
//
// Residual: second module redefines shared_name (name collision).
pub fn shared_name(x: Int) -> Int {
    return x + 10;
}
