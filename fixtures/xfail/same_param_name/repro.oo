// SPRINT Issue #12 / #10 residual — same param name on two user-struct functions.
// HONESTY (tip host): check FAILS with "struct 'Key' has no field 'signer_name'"
// because both params are named `it` — second fn loses its struct type in the env.
// Distinct param names (k/s) pass; this file documents the residual for rails.
// Smoke: treated as xfail residual (expected broken until env tables are per-fn).
type Key = struct {
    tag: Int,
    public_key: Int,
    is_valid: Bool,
};
type Sig = struct {
    tag: Int,
    signer_name: Int,
    is_valid: Bool,
};

pub fn get1(it: Key) -> Int {
    let pk: Int = it.public_key;
    return pk;
}

pub fn get2(it: Sig) -> Int {
    let sn: Int = it.signer_name;
    return sn;
}

pub fn main() {
    let k = Key { tag: 1, public_key: 7, is_valid: true };
    let s = Sig { tag: 2, signer_name: 9, is_valid: true };
    println(get1(k));
    println(get2(s));
}
