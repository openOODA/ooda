// # list_first product Int payload
//
// Logline: Fail-closed emit+gcc+run of std list_first Ok payload as Int.
//
// Setup: Backend-C. Import std/core/list.oo. Ok(7) is Int, not a string.
//
// Beats:
//   1. Push 7 onto a List[Int].
//   2. list_first returns Ok of Int 7.
//   3. Exit 1 before PASSED on a miss.

import "std/core/list.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 7);
    let r: Result[Int, String] = list_first(xs);
    let n: Int = match r {
        Ok(v) => v,
        Err(e) => 0
    };
    if n != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("list_first_prod: PASSED");
}
