// # Product Prove std/security_defense/control_flow_flattening.oo
//
// Logline: Deterministic assertion fixture verifying Chenxi Wang control flow flattening state machine dispatch.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/control_flow_flattening.oo.
//
// Beats:
//   1. Construct FlattenedFunction with states 0, 1, 2 and exit state 99.
//   2. Step through state transitions and assert state sequence.
//   3. Print "prod_control_flow_flattening: PASSED".

import "std/security_defense/control_flow_flattening.oo";

pub fn main() {
    let mut ff: FlattenedFunction = flattened_function_new("test_fn", 0, 99);
    let _b0: Bool = flattened_function_add_block(&mut ff, 0, 5, 1, 2, false);
    let _b1: Bool = flattened_function_add_block(&mut ff, 1, 3, 2, -1, false);
    let _b2: Bool = flattened_function_add_block(&mut ff, 2, 4, 99, -1, true);

    if (ff).block_count != 3 {
        println("FAIL: block_count mismatch");
        process_exit(1);
    }

    // Step 1: from state 0 with branch_cond false -> should transition to next_state_default (1)
    let s1: Bool = flattened_function_step(&mut ff, false);
    if !s1 || (ff).dispatcher_switch_var != 1 {
        println("FAIL: state transition 0 -> 1");
        process_exit(1);
    }

    // Step 2: from state 1 -> should transition to 2
    let s2: Bool = flattened_function_step(&mut ff, false);
    if !s2 || (ff).dispatcher_switch_var != 2 {
        println("FAIL: state transition 1 -> 2");
        process_exit(1);
    }

    // Step 3: from state 2 (terminal) -> should transition to exit_state (99) and return false
    let s3: Bool = flattened_function_step(&mut ff, false);
    if s3 || (ff).dispatcher_switch_var != 99 {
        println("FAIL: terminal transition to exit_state");
        process_exit(1);
    }

    println("prod_control_flow_flattening: PASSED");
    process_exit(0);
}
