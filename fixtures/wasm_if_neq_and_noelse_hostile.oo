// # Hostile if 1!=x && 3!=4 no-else fold
//
// Logline: Print fold-me from if 1!=x && 3!=4 with no else so emit-wasm must miss a const-neq-and no-else fold.
//
// Setup: One public main. Left compare right operand is IDENT x.
//
// Beats:
//   1. Let x be 2.
//   2. If 1!=x && 3!=4 print fold-me.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = 2;
    if 1 != x && 3 != 4 {
        println("fold-me");
    }
}
