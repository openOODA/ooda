// # Product stream_skip prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_skip peek/next.
//
// Setup: Product std/io/stream_skip.oo. List[Int] destub.
//
// Beats:
//   1. [1,2,3] skip 1 peeks 2 then 3.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_skip.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    xs = list_push(xs, 3);
    let mut ss: StreamSkip = stream_skip_new(xs, 1);
    let p0: Int = stream_skip_peek(ss);
    if p0 != 2 {
        println("FAIL skip peek2");
        process_exit(1);
    }
    ss = stream_skip_next(ss);
    let p1: Int = stream_skip_peek(ss);
    if p1 != 3 {
        println("FAIL skip peek3");
        process_exit(1);
    }
    println("prod_sskip: PASSED");
}
