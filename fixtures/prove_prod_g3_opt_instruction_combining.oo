// # Product prove std/compilers_vm/opt_instruction_combining.oo
//
// Logline: Fail-closed emit+gcc+run asserts log2_exact is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_instruction_combining.oo.
//
// Beats:
//   1. Call log2_exact twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opt_instruction_combining: PASSED only if they match.

import "std/compilers_vm/opt_instruction_combining.oo";

pub fn main() {
    let opt_instruction_combining_mark: Int = 0;
    if opt_instruction_combining_mark != 0 {
        process_exit(1);
    }
    let a: Int = log2_exact(0);
    let b: Int = log2_exact(0);
    if a != b {
        println("FAIL log2_exact");
        process_exit(1);
    }
    println("prod_opt_instruction_combining: PASSED");
}
