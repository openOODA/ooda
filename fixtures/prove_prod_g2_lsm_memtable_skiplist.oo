// # Product prove std/db_storage/lsm_memtable_skiplist.oo
//
// Logline: Fail-closed emit+gcc+run asserts skiplist_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_memtable_skiplist.oo.
//
// Beats:
//   1. Call skiplist_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lsm_memtable_skiplist: PASSED only if they match.

import "std/db_storage/lsm_memtable_skiplist.oo";

pub fn main() {
    let lsm_memtable_skiplist_mark: Int = 0;
    if lsm_memtable_skiplist_mark != 0 {
        process_exit(1);
    }
    let a: SkipListNode = skiplist_node_new("x", "x", 0, true, 0);
    let b: SkipListNode = skiplist_node_new("x", "x", 0, true, 0);
    if (a).sequence_number != (b).sequence_number {
        println("FAIL skiplist_node_new");
        process_exit(1);
    }
    println("prod_g2_lsm_memtable_skiplist: PASSED");
}
