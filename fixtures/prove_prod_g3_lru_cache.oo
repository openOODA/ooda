// # Product prove std/web_ecosystem/lru_cache.oo
//
// Logline: Fail-closed emit+gcc+run asserts lru_cache_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lru_cache.oo.
//
// Beats:
//   1. Call lru_cache_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lru_cache: PASSED only if they match.

import "std/web_ecosystem/lru_cache.oo";

pub fn main() {
    let a: LruCache = lru_cache_new();
    let b: LruCache = lru_cache_new();
    if (a).k0 != (b).k0 {
        println("FAIL lru_cache_new");
        process_exit(1);
    }
    println("prod_lru_cache: PASSED");
}
