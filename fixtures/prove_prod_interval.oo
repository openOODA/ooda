// # Product interval_tree prove
import "std/collections/interval_tree.oo";
pub fn main() {
    let mut t: IntervalTree = interval_tree_new();
    t = interval_tree_insert(t, 1, 5, 9);
    let n: Int = interval_tree_len(t);
    if n != 1 {
        println("FAIL interval len");
        process_exit(1);
    }
    let ov: Bool = interval_tree_has_overlap(t, 2, 3);
    if ov == false {
        println("FAIL interval ov");
        process_exit(1);
    }
    let no: Bool = interval_tree_has_overlap(t, 10, 12);
    if no == true {
        println("FAIL interval no");
        process_exit(1);
    }
    println("prod_interval: PASSED");
}
