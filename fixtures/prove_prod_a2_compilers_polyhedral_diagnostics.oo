// # Product prove std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo
//
// Logline: Fail-closed emit+gcc+run asserts diagnostic_metric_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo.
//
// Beats:
//   1. Call diagnostic_metric_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compilers_polyhedral_diagnostics: PASSED only if they match.

import "std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo";

pub fn main() {
    let compilers_polyhedral_diagnostics_mark: Int = 0;
    if compilers_polyhedral_diagnostics_mark != 0 {
        process_exit(1);
    }
    let a: DiagnosticMetric = diagnostic_metric_new(0, "x", 0, "x");
    let b: DiagnosticMetric = diagnostic_metric_new(0, "x", 0, "x");
    if (a).metric_id != (b).metric_id {
        println("FAIL diagnostic_metric_new");
        process_exit(1);
    }
    println("prod_compilers_polyhedral_diagnostics: PASSED");
}
