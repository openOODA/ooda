// # Product prove std/tda_topology/mapper_simplicial_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts count_shared_points is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/mapper_simplicial_complex.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call count_shared_points twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_mapper_simplicial_complex: PASSED only if they match.

import "std/tda_topology/mapper_simplicial_complex.oo";

pub fn main() {
    let g0_a = count_shared_points(list_new(), list_new());
    let g0_b = count_shared_points(list_new(), list_new());
    if g0_a != g0_b {
        println("FAIL count_shared_points");
        process_exit(1);
    }
    println("prod_gr_mapper_simplicial_complex: PASSED");
}
