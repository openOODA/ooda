// # Product prove std/satellite_dvb/gnss_galileo_prn_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts galileo_prn_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_galileo_prn_generator.oo.
//
// Beats:
//   1. Call galileo_prn_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gnss_galileo_prn_generator: PASSED only if they match.

import "std/satellite_dvb/gnss_galileo_prn_generator.oo";

pub fn main() {
    let a: GalileoPrnConfig = galileo_prn_config_new(0);
    let b: GalileoPrnConfig = galileo_prn_config_new(0);
    if a.sv_id != b.sv_id {
        println("FAIL galileo_prn_config_new");
        process_exit(1);
    }
    println("prod_gnss_galileo_prn_generator: PASSED");
}
