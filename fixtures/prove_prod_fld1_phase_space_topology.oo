// # Product prove std/tda_topology/phase_space_topology.oo
//
// Logline: Fail-closed emit+gcc+run asserts phase_space_topology_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/phase_space_topology.oo.
//
// Beats:
//   1. Call phase_space_topology_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_phase_space_topology: PASSED only if they match.

import "std/tda_topology/phase_space_topology.oo";

pub fn main() {
    let phase_space_topology_mark: Int = 0;
    if phase_space_topology_mark != 0 {
        process_exit(1);
    }
    let phase_space_topology_a = phase_space_topology_new(1.0);
    let phase_space_topology_b = phase_space_topology_new(1.0);
    if (phase_space_topology_a).state_count != (phase_space_topology_b).state_count {
        println("FAIL phase_space_topology_new");
        process_exit(1);
    }
    println("prod_phase_space_topology: PASSED");
}
