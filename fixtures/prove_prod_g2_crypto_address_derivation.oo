// # Product prove std/fintech_defi/crypto_address_derivation.oo
//
// Logline: Fail-closed emit+gcc+run asserts secp256k1_pubkey_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/crypto_address_derivation.oo.
//
// Beats:
//   1. Call secp256k1_pubkey_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crypto_address_derivation: PASSED only if they match.

import "std/fintech_defi/crypto_address_derivation.oo";

pub fn main() {
    let crypto_address_derivation_mark: Int = 0;
    if crypto_address_derivation_mark != 0 {
        process_exit(1);
    }
    let a: Secp256k1PublicKey = secp256k1_pubkey_new(0, 0, 0, 0);
    let b: Secp256k1PublicKey = secp256k1_pubkey_new(0, 0, 0, 0);
    if (a).x_coord_hi != (b).x_coord_hi {
        println("FAIL secp256k1_pubkey_new");
        process_exit(1);
    }
    println("prod_g2_crypto_address_derivation: PASSED");
}
