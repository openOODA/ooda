// # Product hash BLAKE3 prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/blake3.oo.
//
// Setup: Product std/hash/blake3.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty digest is the official 64-hex vector.
//   2. Length is 64.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/blake3.oo";

pub fn main() {
    let h: String = blake3("");
    println(h);
    if h != "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262" {
        println("FAIL blake3 empty");
        process_exit(1);
    }
    let n: Int = chars_len(h);
    if n != 64 {
        println("FAIL blake3 len");
        process_exit(1);
    }
    println("prod_blake3: PASSED");
}
