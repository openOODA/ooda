// # Product prove std/fin/orderbook_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts limit_order_remaining_qty is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_ops.oo.
//
// Beats:
//   1. Call limit_order_remaining_qty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orderbook_ops: PASSED only if they match.

import "std/fin/orderbook_ops.oo";

pub fn main() {
    let orderbook_ops_mark: Int = 0;
    if orderbook_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = limit_order_remaining_qty(LimitOrder { id: 0, side: 0, price: 100, quantity: 10, filled: 3, ts_ms: 0 });
    let b: Int = limit_order_remaining_qty(LimitOrder { id: 0, side: 0, price: 100, quantity: 10, filled: 3, ts_ms: 0 });
    if a != b {
        println("FAIL limit_order_remaining_qty");
        process_exit(1);
    }
    println("prod_orderbook_ops: PASSED");
}
