// # Product prove std/edge/mesh_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts mesh_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/mesh_types.oo.
//
// Beats:
//   1. Call mesh_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_types: PASSED only if they match.

import "std/edge/mesh_types.oo";

pub fn main() {
    let mesh_types_mark: Int = 0;
    if mesh_types_mark != 0 {
        process_exit(1);
    }
    let a: MeshNodeConfig = mesh_config_new(0, 0, 0);
    let b: MeshNodeConfig = mesh_config_new(0, 0, 0);
    if (a).node_id != (b).node_id {
        println("FAIL mesh_config_new");
        process_exit(1);
    }
    println("prod_mesh_types: PASSED");
}
