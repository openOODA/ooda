// # Product prove std/iot_scada/dnp3_secure_authentication.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/dnp3_secure_authentication.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_secure_authentication.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dnp3_secure_authentication: PASSED only if they match.

import "std/iot_scada/dnp3_secure_authentication.oo";

pub fn main() {
    let dnp3_secure_authentication_a = dnp3_auth_verify_sequence(0, 0);
    let dnp3_secure_authentication_b = dnp3_auth_verify_sequence(0, 0);
    if dnp3_secure_authentication_a != dnp3_secure_authentication_b {
        println("FAIL dnp3_secure_authentication");
        process_exit(1);
    }
    println("prod_ap_dnp3_secure_authentication: PASSED");
}
