// # Product prove std/enterprise/audit_query.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_query_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_query.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call audit_query_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_audit_query: PASSED only if they match.

import "std/enterprise/audit_query.oo";

pub fn main() {
    let g2_a = audit_query_probe();
    let g2_b = audit_query_probe();
    if g2_a != g2_b {
        println("FAIL audit_query_probe");
        process_exit(1);
    }
    println("prod_g2_audit_query: PASSED");
}
