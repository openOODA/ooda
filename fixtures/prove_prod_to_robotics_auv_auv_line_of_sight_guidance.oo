// # Product prove std/robotics_auv/auv_line_of_sight_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts ilos_guidance_state_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_line_of_sight_guidance.oo.
//
// Beats:
//   1. Call ilos_guidance_state_init using the auv_line_of_sight_guidance ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_auv_line_of_sight_guidance: PASSED only if asserts hold.

import "std/robotics_auv/auv_line_of_sight_guidance.oo";

pub fn main() {
    let obj = ilos_guidance_state_init();
    let auv_line_of_sight_guidance_a = obj.integral_cross_track_m;
    if auv_line_of_sight_guidance_a != 0.0 {
        println("FAIL ilos_guidance_state_init");
        process_exit(1);
    }
    println("prod_auv_line_of_sight_guidance: PASSED");
}
