// # Product prove std/db_storage/wal_record_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/wal_record_codec.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_record_codec.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wal_record_codec: PASSED only if they match.

import "std/db_storage/wal_record_codec.oo";

pub fn main() {
    let wal_record_codec_a = compute_wal_checksum(0, 0, "x");
    let wal_record_codec_b = compute_wal_checksum(0, 0, "x");
    if wal_record_codec_a != wal_record_codec_b {
        println("FAIL wal_record_codec");
        process_exit(1);
    }
    println("prod_ap_wal_record_codec: PASSED");
}
