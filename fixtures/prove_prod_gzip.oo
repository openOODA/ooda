// # Product prove std/archive/gzip.oo
//
// Logline: Fail-closed emit+gcc+run asserts gzip_detect is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/gzip.oo.
//
// Beats:
//   1. Call gzip_detect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gzip: PASSED only if they match.

import "std/archive/gzip.oo";

pub fn main() {
    let a = gzip_detect("x");
    let b = gzip_detect("x");
    if a != b {
        println("FAIL gzip_detect");
        process_exit(1);
    }
    println("prod_gzip: PASSED");
}
