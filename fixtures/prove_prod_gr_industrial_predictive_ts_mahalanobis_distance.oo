// # Product prove std/industrial_predictive/ts_mahalanobis_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt is a real value.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_mahalanobis_distance.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call math_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_ts_mahalanobis_distance: PASSED only if they match.

import "std/industrial_predictive/ts_mahalanobis_distance.oo";

pub fn main() {
    let g0_a = math_sqrt(0.0);
    let g0_b = math_sqrt(0.0);
    if g0_a != g0_b {
        println("FAIL math_sqrt");
        process_exit(1);
    }
    println("prod_gr_ts_mahalanobis_distance: PASSED");
}
