// # Product prove std/gis_spatial/geojson_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/geojson_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/geojson_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_geojson_types: PASSED only if they match.

import "std/gis_spatial/geojson_types.oo";

pub fn main() {
    let geojson_types_a = geo_point_new(0, 0);
    let geojson_types_b = geo_point_new(0, 0);
    let geojson_types_va = geo_point_x(geojson_types_a);
    let geojson_types_vb = geo_point_x(geojson_types_b);
    if geojson_types_va != geojson_types_vb {
        println("FAIL geojson_types");
        process_exit(1);
    }
    println("prod_ap_geojson_types: PASSED");
}
