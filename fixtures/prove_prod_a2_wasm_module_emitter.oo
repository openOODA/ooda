// # Product prove std/compilers_vm/wasm_module_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_sec_custom is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_module_emitter.oo.
//
// Beats:
//   1. Call wasm_sec_custom twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_module_emitter: PASSED only if they match.

import "std/compilers_vm/wasm_module_emitter.oo";

pub fn main() {
    let wasm_module_emitter_mark: Int = 0;
    if wasm_module_emitter_mark != 0 {
        process_exit(1);
    }
    let a: Int = wasm_sec_custom();
    let b: Int = wasm_sec_custom();
    if a != b {
        println("FAIL wasm_sec_custom");
        process_exit(1);
    }
    println("prod_wasm_module_emitter: PASSED");
}
