// # Product prove std/compilers_vm/ssa_dominance_frontier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/ssa_dominance_frontier.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_dominance_frontier.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_ssa_dominance_frontier: PASSED only if they match.

import "std/compilers_vm/ssa_dominance_frontier.oo";

pub fn main() {
    let ssa_dominance_frontier_a = block_frontier_new(0);
    let ssa_dominance_frontier_b = block_frontier_new(0);
    if ssa_dominance_frontier_a.block_id != ssa_dominance_frontier_b.block_id {
        println("FAIL ssa_dominance_frontier");
        process_exit(1);
    }
    println("prod_ap_ssa_dominance_frontier: PASSED");
}
