// # Product Horner prove
//
// Logline: Fail-closed emit+gcc+run of shipped poly_eval3.
//
// Setup: Product std/math/polynomial.oo. 1+2x+3x^2 at x=2 is 17.
//
// Beats:
//   1. poly_eval3(1, 2, 3, 2) is 17.0.
//   2. poly_eval3(1, 0, 0, 5) is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/polynomial.oo";

pub fn main() {
    let v: Float = poly_eval3(1.0, 2.0, 3.0, 2.0);
    if v != 17.0 {
        println("FAIL horner");
        process_exit(1);
    }
    let c: Float = poly_eval3(1.0, 0.0, 0.0, 5.0);
    if c != 1.0 {
        println("FAIL const");
        process_exit(1);
    }
    println("prod_poly: PASSED");
}
