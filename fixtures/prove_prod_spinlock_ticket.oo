// # Product prove std/sync/spinlock_ticket.oo
//
// Logline: Fail-closed emit+gcc+run asserts ticket_spinlock_is_my_turn is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/spinlock_ticket.oo.
//
// Beats:
//   1. Call ticket_spinlock_is_my_turn twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spinlock_ticket: PASSED only if they match.

import "std/sync/spinlock_ticket.oo";

pub fn main() {
    let obj = ticket_spinlock_new();
    let a = ticket_spinlock_is_my_turn(obj, 0);
    let b = ticket_spinlock_is_my_turn(obj, 0);
    if a != b {
        println("FAIL ticket_spinlock_is_my_turn");
        process_exit(1);
    }
    println("prod_spinlock_ticket: PASSED");
}
