import "std/quantum_open_systems/quantum_carnot_limit_dissipation.oo";

pub fn main() {
    let quantum_carnot_limit_dissipation_a = carnot_params_new(0.0, 0.0, 0.0);
    let quantum_carnot_limit_dissipation_b = carnot_params_new(0.0, 0.0, 0.0);
    let quantum_carnot_limit_dissipation_va = carnot_efficiency_ideal(quantum_carnot_limit_dissipation_a);
    let quantum_carnot_limit_dissipation_vb = carnot_efficiency_ideal(quantum_carnot_limit_dissipation_b);
    if quantum_carnot_limit_dissipation_va != quantum_carnot_limit_dissipation_vb {
        println("FAIL quantum_carnot_limit_dissipation");
        process_exit(1);
    }
    println("prod_ap_quantum_carnot_limit_dissipation: PASSED");
