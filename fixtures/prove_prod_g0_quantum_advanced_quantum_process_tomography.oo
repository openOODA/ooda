// # Product prove std/quantum_advanced/quantum_process_tomography.oo
//
// Logline: Fail-closed emit+gcc+run asserts qpt_process_to_average_gate_fidelity is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_process_tomography.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qpt_process_to_average_gate_fidelity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_quantum_process_tomography: PASSED only if they match.

import "std/quantum_advanced/quantum_process_tomography.oo";

pub fn main() {
    let g0_a = qpt_process_to_average_gate_fidelity(1.0, 2);
    let g0_b = qpt_process_to_average_gate_fidelity(1.0, 2);
    if g0_a != g0_b {
        println("FAIL qpt_process_to_average_gate_fidelity");
        process_exit(1);
    }
    println("prod_g0_quantum_process_tomography: PASSED");
}
