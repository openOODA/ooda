// # Product string_builder_pool prove
//
// Logline: Fail-closed emit+gcc+run of shipped pool new/release/len.
//
// Setup: Product std/text/string_builder_pool.oo. List[Int] destub.
//
// Beats:
//   1. new(2) len 0; release 7 len 1; release 3 len 2; release 9 stays 2.
//   2. Exit 1 before PASSED on a miss.

import "std/text/string_builder_pool.oo";

pub fn main() {
    let mut p: StringBuilderPool = string_builder_pool_new(2);
    let n0: Int = string_builder_pool_len(p);
    if n0 != 0 {
        println("FAIL sbpool empty");
        process_exit(1);
    }
    p = string_builder_pool_release(p, 7);
    let n1: Int = string_builder_pool_len(p);
    if n1 != 1 {
        println("FAIL sbpool one");
        process_exit(1);
    }
    p = string_builder_pool_release(p, 3);
    let n2: Int = string_builder_pool_len(p);
    if n2 != 2 {
        println("FAIL sbpool two");
        process_exit(1);
    }
    p = string_builder_pool_release(p, 9);
    let n3: Int = string_builder_pool_len(p);
    if n3 != 2 {
        println("FAIL sbpool cap");
        process_exit(1);
    }
    println("prod_sbpool: PASSED");
}
