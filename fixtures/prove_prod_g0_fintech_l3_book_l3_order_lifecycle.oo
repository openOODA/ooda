// # Product prove std/fintech_l3_book/l3_order_lifecycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts is_order_active is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_order_lifecycle.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call is_order_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_l3_order_lifecycle: PASSED only if they match.

import "std/fintech_l3_book/l3_order_lifecycle.oo";

pub fn main() {
    let g0_oa: L3OrderRecord = L3OrderRecord { order_id: 2, side: "x", symbol: "x", shares: 2, price_fixed: 2, filled_shares: 2, state: "x", entry_timestamp_ns: 2, last_update_timestamp_ns: 2 };
    let g0_ob: L3OrderRecord = L3OrderRecord { order_id: 2, side: "x", symbol: "x", shares: 2, price_fixed: 2, filled_shares: 2, state: "x", entry_timestamp_ns: 2, last_update_timestamp_ns: 2 };
    let g0_a = is_order_active(&g0_oa);
    let g0_b = is_order_active(&g0_ob);
    if g0_a != g0_b {
        println("FAIL is_order_active");
        process_exit(1);
    }
    println("prod_g0_l3_order_lifecycle: PASSED");
}
