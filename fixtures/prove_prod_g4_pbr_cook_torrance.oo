// # Product prove std/pbr_raytracing/brdf_cook_torrance_ggx.oo
//
// Logline: Fail-closed verification that Cook-Torrance GGX specular BRDF evaluation and importance sampling are deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_cook_torrance_ggx.oo.
//
// Beats:
//   1. Call module probe and assert zero return status.
//   2. Evaluate specular BRDF f_r(l, v) for aligned and backfacing directions.
//   3. Perform deterministic microfacet hemisphere sampling.
//   4. Print prod_g4_pbr_cook_torrance: PASSED and exit 0.

import "std/pbr_raytracing/brdf_cook_torrance_ggx.oo";

pub fn main() {
    let p1: Int = brdf_cook_torrance_ggx_probe();
    let p2: Int = brdf_cook_torrance_ggx_probe();
    if p1 != p2 || p1 != 0 {
        println("FAIL brdf_cook_torrance_ggx_probe");
        process_exit(1);
    }

    let params: CookTorranceParams = CookTorranceParams {
        roughness: 0.2,
        f0: vec3_new(0.04, 0.04, 0.04),
    };
    let n: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let v: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let l: Vec3 = vec3_new(0.0, 0.0, 1.0);

    let eval1: Vec3 = cook_torrance_eval(&l, &v, &n, &params);
    let eval2: Vec3 = cook_torrance_eval(&l, &v, &n, &params);
    if (eval1).x != (eval2).x || (eval1).x <= 0.0 {
        println("FAIL cook_torrance_eval normal incidence");
        process_exit(1);
    }

    let l_back: Vec3 = vec3_new(0.0, 0.0, -1.0);
    let eval_back: Vec3 = cook_torrance_eval(&l_back, &v, &n, &params);
    if (eval_back).x != 0.0 || (eval_back).y != 0.0 || (eval_back).z != 0.0 {
        println("FAIL cook_torrance_eval backfacing");
        process_exit(1);
    }

    let sample1: Vec3 = cook_torrance_sample(&v, &params, 0.5, 0.5);
    let sample2: Vec3 = cook_torrance_sample(&v, &params, 0.5, 0.5);
    if (sample1).z != (sample2).z {
        println("FAIL cook_torrance_sample");
        process_exit(1);
    }

    println("prod_g4_pbr_cook_torrance: PASSED");
    process_exit(0);
}
