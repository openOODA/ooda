// # Product prove std/telecom_5g/channel_rician_k_factor.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_rician_sample_re is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_rician_k_factor.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call channel_rician_sample_re twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_channel_rician_k_factor: PASSED only if they match.

import "std/telecom_5g/channel_rician_k_factor.oo";

pub fn main() {
    let g0_oa: RicianChannelConfig = RicianChannelConfig { k_factor_db: 0.0, k_factor_linear: 0.0, specular_power_fraction: 0.0, diffuse_power_fraction: 0.0 };
    let g0_ob: RicianChannelConfig = RicianChannelConfig { k_factor_db: 0.0, k_factor_linear: 0.0, specular_power_fraction: 0.0, diffuse_power_fraction: 0.0 };
    let g0_a = channel_rician_sample_re(&g0_oa, 0.0, 0.0);
    let g0_b = channel_rician_sample_re(&g0_ob, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL channel_rician_sample_re");
        process_exit(1);
    }
    println("prod_gr_channel_rician_k_factor: PASSED");
}
