// # Product prove std/physics_advanced/orbital_relativity_schwarzschild.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/orbital_relativity_schwarzschild.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/orbital_relativity_schwarzschild.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbital_relativity_schwarzschild: PASSED only if they match.

import "std/physics_advanced/orbital_relativity_schwarzschild.oo";

pub fn main() {
    let orbital_relativity_schwarzschild_a = schwarzschild_radius(0.0, 0.0);
    let orbital_relativity_schwarzschild_b = schwarzschild_radius(0.0, 0.0);
    if orbital_relativity_schwarzschild_a != orbital_relativity_schwarzschild_b {
        println("FAIL orbital_relativity_schwarzschild");
        process_exit(1);
    }
    println("prod_ap_orbital_relativity_schwarzschild: PASSED");
}
