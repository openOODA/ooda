// # Product prove std/protein_folding/md_steered_molecular_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts smd_step_work is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_steered_molecular_dynamics.oo.
//
// Beats:
//   1. Call smd_step_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_steered_molecular_dynamics: PASSED only if they match.

import "std/protein_folding/md_steered_molecular_dynamics.oo";

pub fn main() {
    let md_steered_molecular_dynamics_mark: Int = 0;
    if md_steered_molecular_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Float = smd_step_work(0.0, 0.0, 0.0);
    let b: Float = smd_step_work(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL smd_step_work");
        process_exit(1);
    }
    println("prod_g2_md_steered_molecular_dynamics: PASSED");
}
