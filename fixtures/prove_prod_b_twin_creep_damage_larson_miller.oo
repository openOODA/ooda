// # Product prove std/digital_twin/twin_creep_damage_larson_miller.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_creep_damage_larson_miller_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_creep_damage_larson_miller.oo.
//
// Beats:
//   1. Call twin_creep_damage_larson_miller_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_twin_creep_damage_larson_miller: PASSED only if they match.

import "std/digital_twin/twin_creep_damage_larson_miller.oo";

pub fn main() {
    let a = twin_creep_damage_larson_miller_probe();
    let b = twin_creep_damage_larson_miller_probe();
    if a != b {
        println("FAIL twin_creep_damage_larson_miller_probe");
        process_exit(1);
    }
    println("prod_twin_creep_damage_larson_miller: PASSED");
}
