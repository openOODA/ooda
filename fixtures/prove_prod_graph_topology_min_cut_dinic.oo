// # Product prove std/graph_topology/min_cut_dinic.oo
//
// Logline: Fail-closed emit+gcc+run asserts dinic_min_cut is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/min_cut_dinic.oo.
//
// Beats:
//   1. Call dinic_min_cut twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_min_cut_dinic: PASSED only if they match.

import "std/graph_topology/min_cut_dinic.oo";

pub fn main() {
    let min_cut_dinic_mark: Int = 0;
    if min_cut_dinic_mark != 0 {
        process_exit(1);
    }
    let a: DinicCutResult = dinic_min_cut(GraphAdjMatrix { ptr: 0, len: 0, cap: 0 }, 0, 0);
    let b: DinicCutResult = dinic_min_cut(GraphAdjMatrix { ptr: 0, len: 0, cap: 0 }, 0, 0);
    if (a).min_cut_capacity != (b).min_cut_capacity {
        println("FAIL dinic_min_cut");
        process_exit(1);
    }
    println("prod_min_cut_dinic: PASSED");
}
