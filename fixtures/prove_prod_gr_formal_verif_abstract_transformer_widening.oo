// # Product prove std/formal_verif/abstract_transformer_widening.oo
//
// Logline: Fail-closed emit+gcc+run asserts widen_find_upper_threshold is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_transformer_widening.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call widen_find_upper_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_abstract_transformer_widening: PASSED only if they match.

import "std/formal_verif/abstract_transformer_widening.oo";

pub fn main() {
    let g0_oa: WideningThresholds = WideningThresholds { thresholds: list_new(), count: 0 };
    let g0_ob: WideningThresholds = WideningThresholds { thresholds: list_new(), count: 0 };
    let g0_a = widen_find_upper_threshold(&g0_oa, 0);
    let g0_b = widen_find_upper_threshold(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL widen_find_upper_threshold");
        process_exit(1);
    }
    println("prod_gr_abstract_transformer_widening: PASSED");
}
