// # Product prove std/nerf_3dgs/fourier_positional_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts positional_encoding_config_default_pos is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/fourier_positional_encoding.oo.
//
// Beats:
//   1. Call positional_encoding_config_default_pos twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fourier_positional_encoding: PASSED only if they match.

import "std/nerf_3dgs/fourier_positional_encoding.oo";

pub fn main() {
    let fourier_positional_encoding_mark: Int = 0;
    if fourier_positional_encoding_mark != 0 {
        process_exit(1);
    }
    let a: PositionalEncodingConfig = positional_encoding_config_default_pos();
    let b: PositionalEncodingConfig = positional_encoding_config_default_pos();
    if (a).num_frequencies != (b).num_frequencies {
        println("FAIL positional_encoding_config_default_pos");
        process_exit(1);
    }
    println("prod_g2_fourier_positional_encoding: PASSED");
}
