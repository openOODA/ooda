// # Product base64 encode
//
// Logline: Encode hello to the RFC 4648 string aGVsbG8=.
//
// Setup: OPEN-78. ooda/std/encoding/base64.oo. No caps.
//
// Beats:
//   1. Encode hello.
//   2. Require aGVsbG8=.
//   3. Print PASSED.

import "std/encoding/base64.oo";

pub fn main() {
    let e: String = base64_encode("hello");
    println(e);
    if e != "aGVsbG8=" {
        println("FAIL base64");
        process_exit(1);
    }
    println("open78: PASSED");
}
