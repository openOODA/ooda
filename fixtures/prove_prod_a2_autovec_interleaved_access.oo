// # Product prove std/compilers_polyhedral/autovec_interleaved_access.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_shuffle_overhead is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_interleaved_access.oo.
//
// Beats:
//   1. Call compute_shuffle_overhead twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_interleaved_access: PASSED only if they match.

import "std/compilers_polyhedral/autovec_interleaved_access.oo";

pub fn main() {
    let autovec_interleaved_access_mark: Int = 0;
    if autovec_interleaved_access_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_shuffle_overhead(0, 0);
    let b: Int = compute_shuffle_overhead(0, 0);
    if a != b {
        println("FAIL compute_shuffle_overhead");
        process_exit(1);
    }
    println("prod_autovec_interleaved_access: PASSED");
}
