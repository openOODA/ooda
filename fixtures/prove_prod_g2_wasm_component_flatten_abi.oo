// # Product prove std/wasm_gc/wasm_component_flatten_abi.oo
//
// Logline: Fail-closed emit+gcc+run asserts should_pass_by_memory is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_flatten_abi.oo.
//
// Beats:
//   1. Call should_pass_by_memory twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_component_flatten_abi: PASSED only if they match.

import "std/wasm_gc/wasm_component_flatten_abi.oo";

pub fn main() {
    let wasm_component_flatten_abi_mark: Int = 0;
    if wasm_component_flatten_abi_mark != 0 {
        process_exit(1);
    }
    let a: Int = should_pass_by_memory(0);
    let b: Int = should_pass_by_memory(0);
    if a != b {
        println("FAIL should_pass_by_memory");
        process_exit(1);
    }
    println("prod_g2_wasm_component_flatten_abi: PASSED");
}
