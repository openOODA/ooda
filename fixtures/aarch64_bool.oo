// # Const bool println
//
// Logline: Print true then false as ASCII text.
//
// Setup: Side emit-aarch64 lowers KW_TRUE and KW_FALSE only when followed by RPAREN.
//
// Beats:
//   1. Print true.
//   2. Print false.
//   3. Leave true plus int leftover.

pub fn main() {
    println(true);
    println(false);
}
