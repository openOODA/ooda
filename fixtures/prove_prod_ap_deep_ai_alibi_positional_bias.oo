// # Product prove std/deep_ai/alibi_positional_bias.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/alibi_positional_bias.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/alibi_positional_bias.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_alibi_positional_bias: PASSED only if they match.

import "std/deep_ai/alibi_positional_bias.oo";

pub fn main() {
    let alibi_positional_bias_a = alibi_slope_milli(0, 0);
    let alibi_positional_bias_b = alibi_slope_milli(0, 0);
    if alibi_positional_bias_a != alibi_positional_bias_b {
        println("FAIL alibi_positional_bias");
        process_exit(1);
    }
    println("prod_ap_alibi_positional_bias: PASSED");
}
