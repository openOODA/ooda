// # Product prove std/bioinformatics/fastq_quality.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/fastq_quality.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/fastq_quality.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fastq_quality: PASSED only if they match.

import "std/bioinformatics/fastq_quality.oo";

pub fn main() {
    let fastq_quality_a = int_pow64(0);
    let fastq_quality_b = int_pow64(0);
    if fastq_quality_a != fastq_quality_b {
        println("FAIL fastq_quality");
        process_exit(1);
    }
    println("prod_ap_fastq_quality: PASSED");
}
