// # Product prove std/sync/channel_broadcast.oo
//
// Logline: Fail-closed emit+gcc+run asserts broadcast_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/channel_broadcast.oo.
//
// Beats:
//   1. Call broadcast_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_broadcast: PASSED only if they match.

import "std/sync/channel_broadcast.oo";

pub fn main() {
    let obj = broadcast_new(0);
    let a = broadcast_len(obj);
    let b = broadcast_len(obj);
    if a != b {
        println("FAIL broadcast_len");
        process_exit(1);
    }
    println("prod_channel_broadcast: PASSED");
}
