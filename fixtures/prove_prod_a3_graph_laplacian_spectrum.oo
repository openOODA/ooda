// # Product prove std/graph_gnn/graph_laplacian_spectrum.oo
//
// Logline: Fail-closed emit+gcc+run asserts laplacian_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_laplacian_spectrum.oo.
//
// Beats:
//   1. Call laplacian_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_laplacian_spectrum: PASSED only if they match.

import "std/graph_gnn/graph_laplacian_spectrum.oo";

pub fn main() {
    let graph_laplacian_spectrum_mark: Int = 0;
    if graph_laplacian_spectrum_mark != 0 {
        process_exit(1);
    }
    let a: LaplacianConfig = laplacian_config_new(0, true);
    let b: LaplacianConfig = laplacian_config_new(0, true);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL laplacian_config_new");
        process_exit(1);
    }
    println("prod_graph_laplacian_spectrum: PASSED");
}
