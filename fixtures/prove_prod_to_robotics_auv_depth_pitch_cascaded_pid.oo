// # Product prove std/robotics_auv/depth_pitch_cascaded_pid.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth_pitch_controller_state_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/depth_pitch_cascaded_pid.oo.
//
// Beats:
//   1. Call depth_pitch_controller_state_init using the depth_pitch_cascaded_pid ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_depth_pitch_cascaded_pid: PASSED only if asserts hold.

import "std/robotics_auv/depth_pitch_cascaded_pid.oo";

pub fn main() {
    let obj = depth_pitch_controller_state_init();
    let depth_pitch_cascaded_pid_a = obj.integral_depth_err;
    if depth_pitch_cascaded_pid_a != 0.0 {
        println("FAIL depth_pitch_controller_state_init");
        process_exit(1);
    }
    println("prod_depth_pitch_cascaded_pid: PASSED");
}
