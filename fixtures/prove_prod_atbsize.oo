// # Product sync atomic bitset size prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/atomic_bitset.oo.
//
// Setup: Product std/sync/atomic_bitset.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(128) size 128. new(0) clamps 64.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/atomic_bitset.oo";

pub fn main() {
    let b: AtomicBitSet = atomic_bitset_new(128);
    let n: Int = atomic_bitset_size(b);
    if n != 128 {
        println("FAIL bitset 128");
        process_exit(1);
    }
    let b2: AtomicBitSet = atomic_bitset_new(0);
    let n2: Int = atomic_bitset_size(b2);
    if n2 != 64 {
        println("FAIL bitset clamp");
        process_exit(1);
    }
    println("prod_atbsize: PASSED");
}
