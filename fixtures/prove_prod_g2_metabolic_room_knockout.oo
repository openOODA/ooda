// # Product prove std/synthetic_biology/metabolic_room_knockout.oo
//
// Logline: Fail-closed emit+gcc+run asserts room_evaluate_transition is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/metabolic_room_knockout.oo.
//
// Beats:
//   1. Call room_evaluate_transition twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_metabolic_room_knockout: PASSED only if they match.

import "std/synthetic_biology/metabolic_room_knockout.oo";

pub fn main() {
    let metabolic_room_knockout_mark: Int = 0;
    if metabolic_room_knockout_mark != 0 {
        process_exit(1);
    }
    let a: Bool = room_evaluate_transition(0.0, 0.0, 0.0, 0.0);
    let b: Bool = room_evaluate_transition(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL room_evaluate_transition");
        process_exit(1);
    }
    println("prod_g2_metabolic_room_knockout: PASSED");
}
