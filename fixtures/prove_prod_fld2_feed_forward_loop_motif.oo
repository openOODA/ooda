// # Product prove std/synthetic_biology/feed_forward_loop_motif.oo
//
// Logline: Fail-closed emit+gcc+run asserts ffl_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/feed_forward_loop_motif.oo.
//
// Beats:
//   1. Call ffl_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_feed_forward_loop_motif: PASSED only if they match.

import "std/synthetic_biology/feed_forward_loop_motif.oo";

pub fn main() {
    let feed_forward_loop_motif_mark: Int = 0;
    if feed_forward_loop_motif_mark != 0 {
        process_exit(1);
    }
    let feed_forward_loop_motif_a: Float = ffl_pow(1.0, 1);
    let feed_forward_loop_motif_b: Float = ffl_pow(1.0, 1);
    if feed_forward_loop_motif_a != feed_forward_loop_motif_b {
        println("FAIL ffl_pow");
        process_exit(1);
    }
    println("prod_feed_forward_loop_motif: PASSED");
}
