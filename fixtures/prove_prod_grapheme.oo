// # Product grapheme prove
//
// Logline: Fail-closed emit+gcc+run of shipped grapheme_count.
//
// Setup: Product std/text/grapheme.oo. ASCII letters are one cluster each.
//
// Beats:
//   1. grapheme_count("") is 0.
//   2. grapheme_count("ab") is 2.
//   3. Exit 1 before PASSED on a miss.

import "std/text/grapheme.oo";

pub fn main() {
    let z: Int = grapheme_count("");
    if z != 0 {
        println("FAIL grapheme empty");
        process_exit(1);
    }
    let n: Int = grapheme_count("ab");
    if n != 2 {
        println("FAIL grapheme ab");
        process_exit(1);
    }
    println("prod_grapheme: PASSED");
}
