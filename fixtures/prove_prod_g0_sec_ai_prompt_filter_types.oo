// # Product prove std/sec/ai/prompt_filter_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts prompt_policy_block is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/ai/prompt_filter_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call prompt_policy_block twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_prompt_filter_types: PASSED only if they match.

import "std/sec/ai/prompt_filter_types.oo";

pub fn main() {
    let g0_oa = prompt_policy_new(2, 2, 2);
    let g0_ob = prompt_policy_new(2, 2, 2);
    let g0_a = prompt_policy_block(g0_oa);
    let g0_b = prompt_policy_block(g0_ob);
    if g0_a != g0_b {
        println("FAIL prompt_policy_block");
        process_exit(1);
    }
    println("prod_g0_prompt_filter_types: PASSED");
}
