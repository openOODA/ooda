// # Product prove std/telecom_5g/dsp_hilbert_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/dsp_hilbert_transform.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_hilbert_transform.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dsp_hilbert_transform: PASSED only if they match.

import "std/telecom_5g/dsp_hilbert_transform.oo";

pub fn main() {
    let dsp_hilbert_transform_a = dsp_hilbert_tap_coeff(0, 0);
    let dsp_hilbert_transform_b = dsp_hilbert_tap_coeff(0, 0);
    if dsp_hilbert_transform_a != dsp_hilbert_transform_b {
        println("FAIL dsp_hilbert_transform");
        process_exit(1);
    }
    println("prod_ap_dsp_hilbert_transform: PASSED");
}
