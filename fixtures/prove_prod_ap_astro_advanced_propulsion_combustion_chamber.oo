// # Product prove std/astro_advanced/propulsion_combustion_chamber.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/propulsion_combustion_chamber.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/propulsion_combustion_chamber.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_propulsion_combustion_chamber: PASSED only if they match.

import "std/astro_advanced/propulsion_combustion_chamber.oo";

pub fn main() {
    let propulsion_combustion_chamber_a = chamber_pc_bar();
    let propulsion_combustion_chamber_b = chamber_pc_bar();
    if propulsion_combustion_chamber_a != propulsion_combustion_chamber_b {
        println("FAIL propulsion_combustion_chamber");
        process_exit(1);
    }
    println("prod_ap_propulsion_combustion_chamber: PASSED");
}
