// # Product prove std/compilers_vm/wasm_validation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_val_type_i32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_validation_engine.oo.
//
// Beats:
//   1. Call wasm_val_type_i32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_validation_engine: PASSED only if they match.

import "std/compilers_vm/wasm_validation_engine.oo";

pub fn main() {
    let wasm_validation_engine_mark: Int = 0;
    if wasm_validation_engine_mark != 0 {
        process_exit(1);
    }
    let a: WasmValType = wasm_val_type_i32();
    let b: WasmValType = wasm_val_type_i32();
    if (a).type_code != (b).type_code {
        println("FAIL wasm_val_type_i32");
        process_exit(1);
    }
    println("prod_wasm_validation_engine: PASSED");
}
