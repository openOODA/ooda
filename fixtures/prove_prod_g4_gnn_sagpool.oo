// # Product prove std/graph_gnn/gnn_sagpool_self_attention.oo
//
// Logline: Fail-closed verification that SAGPool self-attention graph pooling configuration, layer initialization, and node score computations are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_sagpool_self_attention.oo.
//
// Beats:
//   1. Construct SAGPoolConfig and initialize SAGPoolLayer with deterministic seed.
//   2. Compute node self-attention score for test node and neighbors.
//   3. Assert deterministic return values.
//   4. Print prod_g4_gnn_sagpool: PASSED only if all match.

import "std/graph_gnn/gnn_sagpool_self_attention.oo";

pub fn main() {
    let cfg1: SAGPoolConfig = sagpool_config_new(4, 500);
    let cfg2: SAGPoolConfig = sagpool_config_new(4, 500);
    if cfg1.in_features != cfg2.in_features {
        println("FAIL sagpool_config_new in_features");
        process_exit(1);
    }
    if cfg1.pooling_ratio_milli != cfg2.pooling_ratio_milli {
        println("FAIL sagpool_config_new ratio");
        process_exit(1);
    }

    let layer1: SAGPoolLayer = sagpool_layer_init(cfg1, 42);
    let layer2: SAGPoolLayer = sagpool_layer_init(cfg2, 42);

    let mut neighs: List[Int] = list_new();
    neighs = list_push(neighs, 1);
    neighs = list_push(neighs, 2);

    let mut feats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        feats = list_push(feats, i + 1);
        i = i + 1;
    }

    let s1: Int = sagpool_compute_node_score(layer1, 0, neighs, feats);
    let s2: Int = sagpool_compute_node_score(layer2, 0, neighs, feats);
    if s1 != s2 {
        println("FAIL sagpool_compute_node_score");
        process_exit(1);
    }

    println("prod_g4_gnn_sagpool: PASSED");
    process_exit(0);
}
