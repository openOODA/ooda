// # Product prove std/telecom_6g/isac_radar_cross_section_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts radar_target_drone is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_radar_cross_section_model.oo.
//
// Beats:
//   1. Call radar_target_drone twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isac_radar_cross_section_model: PASSED only if they match.

import "std/telecom_6g/isac_radar_cross_section_model.oo";

pub fn main() {
    let isac_radar_cross_section_model_mark: Int = 0;
    if isac_radar_cross_section_model_mark != 0 {
        process_exit(1);
    }
    let a: RadarTargetConfig = radar_target_drone();
    let b: RadarTargetConfig = radar_target_drone();
    if (a).swerling_case != (b).swerling_case {
        println("FAIL radar_target_drone");
        process_exit(1);
    }
    println("prod_g2_isac_radar_cross_section_model: PASSED");
}
