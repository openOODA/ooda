// # Product prove std/telecom_6g/isac_music_doa_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts music_config_default_8ant is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_music_doa_estimator.oo.
//
// Beats:
//   1. Call music_config_default_8ant twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isac_music_doa_estimator: PASSED only if they match.

import "std/telecom_6g/isac_music_doa_estimator.oo";

pub fn main() {
    let a: MusicArrayConfig = music_config_default_8ant();
    let b: MusicArrayConfig = music_config_default_8ant();
    if a.num_array_elements != b.num_array_elements {
        println("FAIL music_config_default_8ant");
        process_exit(1);
    }
    println("prod_isac_music_doa_estimator: PASSED");
}
