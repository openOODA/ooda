// # Product prove std/sec/crypto/bulletproofs_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/bulletproofs_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_ops.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_bulletproofs_ops: PASSED and exit 0 only on match.

import "std/sec/crypto/bulletproofs_ops.oo";

pub fn main() {
    let add_a: Int = bp_mod_add(15, 25, 37);
    let add_b: Int = bp_mod_add(15, 25, 37);
    if add_a != add_b || add_a != 3 {
        println("FAIL bulletproofs_ops bp_mod_add");
        process_exit(1);
    }

    let sub_a: Int = bp_mod_sub(10, 25, 37);
    let sub_b: Int = bp_mod_sub(10, 25, 37);
    if sub_a != sub_b || sub_a != 22 {
        println("FAIL bulletproofs_ops bp_mod_sub");
        process_exit(1);
    }

    let mul_a: Int = bp_mod_mul(6, 7, 37);
    let mul_b: Int = bp_mod_mul(6, 7, 37);
    if mul_a != mul_b || mul_a != 5 {
        println("FAIL bulletproofs_ops bp_mod_mul");
        process_exit(1);
    }

    let pow_a: Int = bp_mod_pow(2, 5, 37);
    let pow_b: Int = bp_mod_pow(2, 5, 37);
    if pow_a != pow_b || pow_a != 32 {
        println("FAIL bulletproofs_ops bp_mod_pow");
        process_exit(1);
    }

    let mut v1: List[Int] = list_new();
    let mut v2: List[Int] = list_new();
    v1 = list_push(v1, 2);
    v1 = list_push(v1, 3);
    v2 = list_push(v2, 4);
    v2 = list_push(v2, 5);

    let dot_a: Int = bp_vector_dot_product(v1, v2, 37);
    let dot_b: Int = bp_vector_dot_product(v1, v2, 37);
    if dot_a != dot_b || dot_a != 23 {
        println("FAIL bulletproofs_ops bp_vector_dot_product");
        process_exit(1);
    }

    let ch_a: Int = bp_hash_challenge(10, 20, 1009);
    let ch_b: Int = bp_hash_challenge(10, 20, 1009);
    if ch_a != ch_b {
        println("FAIL bulletproofs_ops bp_hash_challenge");
        process_exit(1);
    }

    let comm1: PedersenCommitment = pedersen_commitment_create(5, 7, 10, 3, 1009);
    let comm2: PedersenCommitment = pedersen_commitment_create(5, 7, 20, 4, 1009);
    let ver1_a: Bool = pedersen_commitment_verify(comm1, (comm1).commitment);
    let ver1_b: Bool = pedersen_commitment_verify(comm1, (comm1).commitment);
    if !ver1_a || !ver1_b {
        println("FAIL bulletproofs_ops pedersen_commitment_verify");
        process_exit(1);
    }

    let comm_sum: PedersenCommitment = pedersen_commitment_homomorphic_add(comm1, comm2);
    if !(comm_sum).is_valid || (comm_sum).value != 30 || (comm_sum).blinding_factor != 7 {
        println("FAIL bulletproofs_ops pedersen_commitment_homomorphic_add");
        process_exit(1);
    }

    let str_a: String = pedersen_commitment_to_string(comm1);
    let str_b: String = pedersen_commitment_to_string(comm1);
    if str_a != str_b {
        println("FAIL bulletproofs_ops pedersen_commitment_to_string");
        process_exit(1);
    }

    let gens_a: BulletproofGenerators = bulletproof_generators_create(4, 2, 5, 7, 1009);
    let gens_b: BulletproofGenerators = bulletproof_generators_create(4, 2, 5, 7, 1009);
    let gver_a: Bool = bulletproof_generators_verify(gens_a);
    let gver_b: Bool = bulletproof_generators_verify(gens_b);
    if !gver_a || !gver_b {
        println("FAIL bulletproofs_ops bulletproof_generators_verify");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs_ops: PASSED");
    process_exit(0);
}
