// # Product prove std/telecom_6g/thz_path_loss_sub_thz.oo
//
// Logline: Fail-closed emit+gcc+run asserts sub_thz_fspl_1m_db is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_path_loss_sub_thz.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sub_thz_fspl_1m_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thz_path_loss_sub_thz: PASSED only if they match.

import "std/telecom_6g/thz_path_loss_sub_thz.oo";

pub fn main() {
    let g2_a = sub_thz_fspl_1m_db(1.0);
    let g2_b = sub_thz_fspl_1m_db(1.0);
    if g2_a != g2_b {
        println("FAIL sub_thz_fspl_1m_db");
        process_exit(1);
    }
    println("prod_g2_thz_path_loss_sub_thz: PASSED");
}
