// # Product prove std/os/cgroup.oo
//
// Logline: Fail-closed emit+gcc+run asserts cgroup_format_cpu is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/cgroup.oo.
//
// Beats:
//   1. Call cgroup_format_cpu twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cgroup: PASSED only if they match.

import "std/os/cgroup.oo";

pub fn main() {
    let a = cgroup_format_cpu(0, 0);
    let b = cgroup_format_cpu(0, 0);
    if a != b {
        println("FAIL cgroup_format_cpu");
        process_exit(1);
    }
    println("prod_cgroup: PASSED");
}
