// # Product prove std/auto_mpc_control/mpc_nonlinear_vehicle_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts nmpc_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_nonlinear_vehicle_tracker.oo.
//
// Beats:
//   1. Call nmpc_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpc_nonlinear_vehicle_tracker: PASSED only if they match.

import "std/auto_mpc_control/mpc_nonlinear_vehicle_tracker.oo";

pub fn main() {
    let mpc_nonlinear_vehicle_tracker_mark: Int = 0;
    if mpc_nonlinear_vehicle_tracker_mark != 0 {
        process_exit(1);
    }
    let a: NMPCConfig = nmpc_config_default();
    let b: NMPCConfig = nmpc_config_default();
    if (a).horizon_steps != (b).horizon_steps {
        println("FAIL nmpc_config_default");
        process_exit(1);
    }
    println("prod_mpc_nonlinear_vehicle_tracker: PASSED");
}
