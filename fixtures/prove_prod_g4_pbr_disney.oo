// # Product prove std/pbr_raytracing/brdf_disney_principled.oo
//
// Logline: Fail-closed verification that Disney Principled BSDF diffuse, specular, and clearcoat lobes are deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_disney_principled.oo.
//
// Beats:
//   1. Construct default Disney material and assert baseline parameters.
//   2. Evaluate diffuse retro-reflection and clearcoat lobes individually.
//   3. Evaluate unified Disney BSDF for normal incidence and backfacing rays.
//   4. Print prod_g4_pbr_disney: PASSED and exit 0.

import "std/pbr_raytracing/brdf_disney_principled.oo";

pub fn main() {
    let mat1: DisneyMaterial = disney_material_default();
    let mat2: DisneyMaterial = disney_material_default();
    if (mat1).roughness != (mat2).roughness || (mat1).roughness != 0.5 {
        println("FAIL disney_material_default roughness");
        process_exit(1);
    }
    if (mat1).metallic != 0.0 || (mat1).specular != 0.5 {
        println("FAIL disney_material_default parameters");
        process_exit(1);
    }

    let diff1: Vec3 = disney_diffuse_eval(&mat1, 1.0, 1.0, 1.0);
    let diff2: Vec3 = disney_diffuse_eval(&mat1, 1.0, 1.0, 1.0);
    if (diff1).x != (diff2).x || (diff1).x <= 0.0 {
        println("FAIL disney_diffuse_eval");
        process_exit(1);
    }

    let cc0: Float = disney_clearcoat_eval(&mat1, 1.0, 1.0, 1.0, 1.0);
    if cc0 != 0.0 {
        println("FAIL disney_clearcoat_eval default zero");
        process_exit(1);
    }

    let l: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let v: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let n: Vec3 = vec3_new(0.0, 0.0, 1.0);

    let bsdf1: Vec3 = disney_bsdf_eval(&mat1, &l, &v, &n);
    let bsdf2: Vec3 = disney_bsdf_eval(&mat1, &l, &v, &n);
    if (bsdf1).x != (bsdf2).x || (bsdf1).x <= 0.0 {
        println("FAIL disney_bsdf_eval normal incidence");
        process_exit(1);
    }

    let l_back: Vec3 = vec3_new(0.0, 0.0, -1.0);
    let bsdf_back: Vec3 = disney_bsdf_eval(&mat1, &l_back, &v, &n);
    if (bsdf_back).x != 0.0 || (bsdf_back).y != 0.0 || (bsdf_back).z != 0.0 {
        println("FAIL disney_bsdf_eval backfacing");
        process_exit(1);
    }

    println("prod_g4_pbr_disney: PASSED");
    process_exit(0);
}
