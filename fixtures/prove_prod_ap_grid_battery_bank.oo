// # Product prove std/grid/battery_bank.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/battery_bank.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_bank.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_battery_bank: PASSED only if they match.

import "std/grid/battery_bank.oo";

pub fn main() {
    let battery_bank_a = soc_calculate_pct(0.0, 0.0);
    let battery_bank_b = soc_calculate_pct(0.0, 0.0);
    if battery_bank_a != battery_bank_b {
        println("FAIL battery_bank");
        process_exit(1);
    }
    println("prod_ap_battery_bank: PASSED");
}
