// # Product prove std/compilers_polyhedral/affine_farkas_scheduler.oo
//
// Logline: Fail-closed emit+gcc+run asserts farkas_evaluate_timestamp is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_farkas_scheduler.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call farkas_evaluate_timestamp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_affine_farkas_scheduler: PASSED only if they match.

import "std/compilers_polyhedral/affine_farkas_scheduler.oo";

pub fn main() {
    let g0_oa: AffineSchedule = AffineSchedule { stmt_id: 0, dimension_coeffs: list_new(), constant_offset: 0, schedule_dimension: 0 };
    let g0_ob: AffineSchedule = AffineSchedule { stmt_id: 0, dimension_coeffs: list_new(), constant_offset: 0, schedule_dimension: 0 };
    let g0_a = farkas_evaluate_timestamp(g0_oa, list_new());
    let g0_b = farkas_evaluate_timestamp(g0_ob, list_new());
    if g0_a != g0_b {
        println("FAIL farkas_evaluate_timestamp");
        process_exit(1);
    }
    println("prod_gr_affine_farkas_scheduler: PASSED");
}
