// # emit-x86 else-less const-int if
//
// Logline: If 1 equals 1 print yes with no else so emit-x86 can lower else-less if.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the then branch.
//   3. as+ld stdout is yes.
//
// residual: SysV stays later.

pub fn main() {
    if 1 == 1 {
        println("yes");
    }
}
