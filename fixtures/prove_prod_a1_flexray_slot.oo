// # Product prove std/auto_robot/flexray_slot.oo
//
// Logline: Fail-closed emit+gcc+run asserts flexray_cycle_mod is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/flexray_slot.oo.
//
// Beats:
//   1. Call flexray_cycle_mod twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flexray_slot: PASSED only if they match.

import "std/auto_robot/flexray_slot.oo";

pub fn main() {
    let flexray_slot_mark: Int = 0;
    if flexray_slot_mark != 0 {
        process_exit(1);
    }
    let a: Int = flexray_cycle_mod(0);
    let b: Int = flexray_cycle_mod(0);
    if a != b {
        println("FAIL flexray_cycle_mod");
        process_exit(1);
    }
    println("prod_flexray_slot: PASSED");
}
