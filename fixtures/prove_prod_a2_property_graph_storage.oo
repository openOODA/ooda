// # Product prove std/db_graph/property_graph_storage.oo
//
// Logline: Fail-closed emit+gcc+run asserts property_graph_store_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_storage.oo.
//
// Beats:
//   1. Call property_graph_store_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_storage: PASSED only if they match.

import "std/db_graph/property_graph_storage.oo";

pub fn main() {
    let property_graph_storage_mark: Int = 0;
    if property_graph_storage_mark != 0 {
        process_exit(1);
    }
    let a: PropertyGraphStore = property_graph_store_new();
    let b: PropertyGraphStore = property_graph_store_new();
    if (a).node_count != (b).node_count {
        println("FAIL property_graph_store_new");
        process_exit(1);
    }
    println("prod_property_graph_storage: PASSED");
}
