// # Product prove std/compilers/disasm_arm.oo
//
// Logline: Fail-closed emit+gcc+run asserts arm64_reg_num is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/disasm_arm.oo.
//
// Beats:
//   1. Call arm64_reg_num twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_disasm_arm: PASSED only if they match.

import "std/compilers/disasm_arm.oo";

pub fn main() {
    let disasm_arm_mark: Int = 0;
    if disasm_arm_mark != 0 {
        process_exit(1);
    }
    let a: Int = arm64_reg_num(0);
    let b: Int = arm64_reg_num(0);
    if a != b {
        println("FAIL arm64_reg_num");
        process_exit(1);
    }
    println("prod_disasm_arm: PASSED");
}
