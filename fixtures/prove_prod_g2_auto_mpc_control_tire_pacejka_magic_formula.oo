    let g2_oa: PacejkaCoefficients = pacejka_lateral_default();
    let g2_ob: PacejkaCoefficients = pacejka_lateral_default();
    let g2_a = (g2_oa).b_stiff;
    let g2_b = (g2_ob).b_stiff;
