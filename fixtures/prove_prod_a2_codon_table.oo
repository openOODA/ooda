// # Product prove std/bioinformatics/codon_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts codon_table_known is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/codon_table.oo.
//
// Beats:
//   1. Call codon_table_known twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_codon_table: PASSED only if they match.

import "std/bioinformatics/codon_table.oo";

pub fn main() {
    let a: Int = codon_table_known(0);
    let b: Int = codon_table_known(0);
    if a != b {
        println("FAIL codon_table_known");
        process_exit(1);
    }
    println("prod_codon_table: PASSED");
}
