// # Product prove std/compilers_vm/macho64_load_commands.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/macho64_load_commands.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/macho64_load_commands.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_macho64_load_commands: PASSED only if they match.

import "std/compilers_vm/macho64_load_commands.oo";

pub fn main() {
    let macho64_load_commands_a = macho_magic_64();
    let macho64_load_commands_b = macho_magic_64();
    if macho64_load_commands_a != macho64_load_commands_b {
        println("FAIL macho64_load_commands");
        process_exit(1);
    }
    println("prod_ap_macho64_load_commands: PASSED");
}
