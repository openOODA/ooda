// # Product prove std/db_vector_ann/hnsw_heuristic_pruning.oo
//
// Logline: Fail-closed emit+gcc+run asserts heuristic_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/hnsw_heuristic_pruning.oo.
//
// Beats:
//   1. Call heuristic_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hnsw_heuristic_pruning: PASSED only if they match.

import "std/db_vector_ann/hnsw_heuristic_pruning.oo";

pub fn main() {
    let hnsw_heuristic_pruning_mark: Int = 0;
    if hnsw_heuristic_pruning_mark != 0 {
        process_exit(1);
    }
    let a: HeuristicConfig = heuristic_config_default(0);
    let b: HeuristicConfig = heuristic_config_default(0);
    if (a).max_neighbors_m != (b).max_neighbors_m {
        println("FAIL heuristic_config_default");
        process_exit(1);
    }
    println("prod_hnsw_heuristic_pruning: PASSED");
}
