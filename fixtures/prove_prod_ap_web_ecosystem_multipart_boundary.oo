// # Product prove std/web_ecosystem/multipart_boundary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/multipart_boundary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/multipart_boundary.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_multipart_boundary: PASSED only if they match.

import "std/web_ecosystem/multipart_boundary.oo";

pub fn main() {
    let multipart_boundary_a = multipart_boundary_hash(0);
    let multipart_boundary_b = multipart_boundary_hash(0);
    if multipart_boundary_a != multipart_boundary_b {
        println("FAIL multipart_boundary");
        process_exit(1);
    }
    println("prod_ap_multipart_boundary: PASSED");
}
