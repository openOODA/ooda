// # Product prove std/gis_topo/geocentric_ecef_converter.oo
//
// Logline: Fail-closed emit+gcc+run asserts ecef_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geocentric_ecef_converter.oo.
//
// Beats:
//   1. Call ecef_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_geocentric_ecef_converter: PASSED only if they match.

import "std/gis_topo/geocentric_ecef_converter.oo";

pub fn main() {
    let geocentric_ecef_converter_mark: Int = 0;
    if geocentric_ecef_converter_mark != 0 {
        process_exit(1);
    }
    let a: EcefPoint = ecef_point_new(0.0, 0.0, 0.0);
    let b: EcefPoint = ecef_point_new(0.0, 0.0, 0.0);
    if (a).x_m != (b).x_m {
        println("FAIL ecef_point_new");
        process_exit(1);
    }
    println("prod_g2_geocentric_ecef_converter: PASSED");
}
