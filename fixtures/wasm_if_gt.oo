// # Const if 2 > 1 println
//
// Logline: Print gt-then when the condition is 2 > 1.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If 2 > 1 print gt-then else print gt-else.
//   3. Leave no other statements.

pub fn main() {
    if 2 > 1 {
        println("gt-then");
    } else {
        println("gt-else");
    }
}
