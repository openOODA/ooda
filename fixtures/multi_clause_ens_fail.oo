// # Fail the second simple ensures
//
// Logline: A second simple ensures clause fails at runtime when the result is too large.
//
// Beats:
//   1. Require result >= 0 and result <= 5.
//   2. Return x + 10 so the second clause breaks.
//   3. Call narrow(1) from main to trip the rail.

// M51 fail-at-runtime: second simple ensures violated
pub fn narrow(x: Int) -> Int
    ensures result >= 0
    ensures result <= 5
{
    return x + 10;
}

pub fn main() {
    println(narrow(1));
}
