// # Product stream_chain prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_chain len/peek.
//
// Setup: Product std/io/stream_chain.oo. List[Int] destub.
//
// Beats:
//   1. [1] then [2,3] len 3; peek 1 then after next peek 2.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_chain.oo";

pub fn main() {
    let mut a: List[Int] = list_new();
    a = list_push(a, 1);
    let mut b: List[Int] = list_new();
    b = list_push(b, 2);
    b = list_push(b, 3);
    let mut sc: StreamChain = stream_chain_new(a, b);
    let n: Int = stream_chain_len(sc);
    if n != 3 {
        println("FAIL chain len");
        process_exit(1);
    }
    let p0: Int = stream_chain_peek(sc);
    if p0 != 1 {
        println("FAIL chain peek1");
        process_exit(1);
    }
    sc = stream_chain_next(sc);
    let p1: Int = stream_chain_peek(sc);
    if p1 != 2 {
        println("FAIL chain peek2");
        process_exit(1);
    }
    println("prod_schain: PASSED");
}
