// # Product prove std/sec/crypto/poly1305_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/poly1305_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/poly1305_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_poly1305_types: PASSED only if they match.

import "std/sec/crypto/poly1305_types.oo";

pub fn main() {
    let poly1305_types_a = poly1305_tag_new(0, 0, 0);
    let poly1305_types_b = poly1305_tag_new(0, 0, 0);
    let poly1305_types_va = poly1305_tag_checksum(poly1305_types_a);
    let poly1305_types_vb = poly1305_tag_checksum(poly1305_types_b);
    if poly1305_types_va != poly1305_types_vb {
        println("FAIL poly1305_types");
        process_exit(1);
    }
    println("prod_ap_poly1305_types: PASSED");
}
