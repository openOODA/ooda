// # Product prove std/iot_scada/scada_redundancy_arbiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts scada_check_failover_trigger is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/scada_redundancy_arbiter.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call scada_check_failover_trigger twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_scada_redundancy_arbiter: PASSED only if they match.

import "std/iot_scada/scada_redundancy_arbiter.oo";

pub fn main() {
    let g0_oa: ScadaRedundancyNode = ScadaRedundancyNode { node_id: 0, is_primary: true, heartbeat_count: 0, last_heartbeat_ms: 0, db_sync_lag_ms: 0, witness_ping_ok: true, is_healthy: true };
    let g0_ob: ScadaRedundancyNode = ScadaRedundancyNode { node_id: 0, is_primary: true, heartbeat_count: 0, last_heartbeat_ms: 0, db_sync_lag_ms: 0, witness_ping_ok: true, is_healthy: true };
    let g0_a = scada_check_failover_trigger(&g0_oa, 0, 0);
    let g0_b = scada_check_failover_trigger(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL scada_check_failover_trigger");
        process_exit(1);
    }
    println("prod_gr_scada_redundancy_arbiter: PASSED");
}
