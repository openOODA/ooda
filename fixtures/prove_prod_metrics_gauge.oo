// # Product prove std/diag/metrics_gauge.oo
//
// Logline: Fail-closed emit+gcc+run asserts metrics_gauge_get is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/metrics_gauge.oo.
//
// Beats:
//   1. Call metrics_gauge_get twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metrics_gauge: PASSED only if they match.

import "std/diag/metrics_gauge.oo";

pub fn main() {
    let obj = metrics_gauge_new("x", 0);
    let a = metrics_gauge_get(obj);
    let b = metrics_gauge_get(obj);
    if a != b {
        println("FAIL metrics_gauge_get");
        process_exit(1);
    }
    println("prod_metrics_gauge: PASSED");
}
