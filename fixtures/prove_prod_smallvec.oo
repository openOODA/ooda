// # Product small_vec prove
//
// Logline: Fail-closed emit+gcc+run of shipped small_vec_push/len/is_spilled.
//
// Setup: Product std/collections/small_vec.oo. Inline cap 8, one push.
//
// Beats:
//   1. After push 7, len 1 and not spilled.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/small_vec.oo";

pub fn main() {
    let mut v: SmallVec = small_vec_new(8);
    v = small_vec_push(v, 7);
    let n: Int = small_vec_len(v);
    if n != 1 {
        println("FAIL smallvec len");
        process_exit(1);
    }
    let s: Bool = small_vec_is_spilled(v);
    if s == true {
        println("FAIL smallvec spilled");
        process_exit(1);
    }
    println("prod_smallvec: PASSED");
}
