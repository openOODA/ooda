// # Product prove std/space_propulsion/patched_conics_flyby.oo
//
// Logline: Fail-closed emit+gcc+run asserts flyby_spec_default_venus is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/patched_conics_flyby.oo.
//
// Beats:
//   1. Call flyby_spec_default_venus twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_patched_conics_flyby: PASSED only if they match.

import "std/space_propulsion/patched_conics_flyby.oo";

pub fn main() {
    let patched_conics_flyby_mark: Int = 0;
    if patched_conics_flyby_mark != 0 {
        process_exit(1);
    }
    let a: FlybyPlanetarySpec = flyby_spec_default_venus();
    let b: FlybyPlanetarySpec = flyby_spec_default_venus();
    if (a).planet_mu != (b).planet_mu {
        println("FAIL flyby_spec_default_venus");
        process_exit(1);
    }
    println("prod_patched_conics_flyby: PASSED");
}
