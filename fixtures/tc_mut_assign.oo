// # Mut assign type mismatch
//
// Logline: Check refuses assigning a string to a mut Int.
//
// Setup: Single-file probe. Line of the assign stays under 50.
//
// Beats:
//   1. Bind mut x as Int.
//   2. Assign a string literal.
//   3. check must ERR type cannot assign.

pub fn main() {
    let mut x: Int = 1;
    x = "a";
}
