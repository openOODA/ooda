// # Product prove std/hft_alpha/mm_kalman_spread_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts kalman_filter_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_kalman_spread_filter.oo.
//
// Beats:
//   1. Call kalman_filter_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_kalman_spread_filter: PASSED only if they match.

import "std/hft_alpha/mm_kalman_spread_filter.oo";

pub fn main() {
    let a: KalmanFilterState = kalman_filter_state_new(0.0, 0.0);
    let b: KalmanFilterState = kalman_filter_state_new(0.0, 0.0);
    if a.intercept_alpha != b.intercept_alpha {
        println("FAIL kalman_filter_state_new");
        process_exit(1);
    }
    println("prod_mm_kalman_spread_filter: PASSED");
}
