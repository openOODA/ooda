// # Product prove std/quantum_advanced/magic_state_distillation.oo
//
// Logline: Fail-closed emit+gcc+run asserts magic_state_is_below_threshold is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/magic_state_distillation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call magic_state_is_below_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_magic_state_distillation: PASSED only if they match.

import "std/quantum_advanced/magic_state_distillation.oo";

pub fn main() {
    let g2_a = magic_state_is_below_threshold(1.0);
    let g2_b = magic_state_is_below_threshold(1.0);
    if g2_a != g2_b {
        println("FAIL magic_state_is_below_threshold");
        process_exit(1);
    }
    println("prod_g2_magic_state_distillation: PASSED");
}
