// # Product prove std/3d/scene_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts scene_op_node_id is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/scene_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call scene_op_node_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_scene_ops: PASSED only if they match.

import "std/3d/scene_ops.oo";

pub fn main() {
    let g0_oa = scene_op_new(2, 2);
    let g0_ob = scene_op_new(2, 2);
    let g0_a = scene_op_node_id(g0_oa);
    let g0_b = scene_op_node_id(g0_ob);
    if g0_a != g0_b {
        println("FAIL scene_op_node_id");
        process_exit(1);
    }
    println("prod_g0_scene_ops: PASSED");
}
