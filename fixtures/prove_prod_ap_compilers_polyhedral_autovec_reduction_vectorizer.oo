    let autovec_reduction_vectorizer_a = compute_horizontal_reduction_steps(0);
    let autovec_reduction_vectorizer_b = compute_horizontal_reduction_steps(0);
    if autovec_reduction_vectorizer_a != autovec_reduction_vectorizer_b {
        println("FAIL autovec_reduction_vectorizer");
