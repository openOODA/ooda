// # Product prove std/fintech_defi/amm_multi_hop_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts pool_hop_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/amm_multi_hop_router.oo.
//
// Beats:
//   1. Call pool_hop_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_amm_multi_hop_router: PASSED only if they match.

import "std/fintech_defi/amm_multi_hop_router.oo";

pub fn main() {
    let a: PoolHop = pool_hop_new("x", "x", "x", 0, 0, 0);
    let b: PoolHop = pool_hop_new("x", "x", "x", 0, 0, 0);
    if a.reserve_in != b.reserve_in {
        println("FAIL pool_hop_new");
        process_exit(1);
    }
    println("prod_amm_multi_hop_router: PASSED");
}
