// # Collection for-in List[Node] emit lock
//
// Logline: Fail-closed emit+gcc+run of for x in xs over List[Node].
//
// Setup: Backend-C. Loop body sees struct fields.
//
// Beats:
//   1. Push two nodes with id 3 and 4.
//   2. Sum id with for x in xs.
//   3. Exit 1 before PASSED when the sum is not 7.

type Node = struct {
    id: Int,
    tag: String
};

pub fn main() {
    let mut xs: List[Node] = list_new();
    let a: Node = Node { id: 3, tag: "a" };
    let b: Node = Node { id: 4, tag: "b" };
    xs = list_push(xs, a);
    xs = list_push(xs, b);
    let mut s: Int = 0;
    for x in xs {
        s = s + x.id;
    }
    if s != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("for_list_node_smoke: PASSED");
}
