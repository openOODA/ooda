// # Branch on a quote character
//
// Logline: A scanner helper compares the first character to a quote and returns an empty list either way.
//
// Beats:
//   1. Read the first character of src.
//   2. Compare it to a quote literal.
//   3. Return list_new on both arms so emit covers the quote-if path.

pub fn f(src: String) -> List[String] {
    let c = char_at(src, 0);
    if c == "\"" {
        return list_new();
    }
    return list_new();
}
pub fn main() {}
