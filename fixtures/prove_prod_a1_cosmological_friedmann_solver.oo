// # Product prove std/astrophysics_relativity/cosmological_friedmann_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts friedmann_e_z is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_friedmann_solver.oo.
//
// Beats:
//   1. Call friedmann_e_z twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cosmological_friedmann_solver: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_friedmann_solver.oo";

pub fn main() {
    let cosmological_friedmann_solver_mark: Int = 0;
    if cosmological_friedmann_solver_mark != 0 {
        process_exit(1);
    }
    let a: Int = friedmann_e_z(0, 0, 0, 0, 0);
    let b: Int = friedmann_e_z(0, 0, 0, 0, 0);
    if a != b {
        println("FAIL friedmann_e_z");
        process_exit(1);
    }
    println("prod_cosmological_friedmann_solver: PASSED");
}
