// # Product prove std/auto/occupancy.oo
//
// Logline: Fail-closed verification that occupancy grid operations and engine are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy.oo.
//
// Beats:
//   1. Construct occupancy operation and engine instances.
//   2. Query fields deterministically.
//   3. Assert returned integer metrics match.
//   4. Print prod_g4_auto_occupancy: PASSED and exit 0.

import "std/auto/occupancy.oo";

pub fn main() {
    let op1: OccOp = occupancy_op_new(50, 100);
    let op2: OccOp = occupancy_op_new(50, 100);
    let v1: Int = occ_op_voxel(op1);
    let v2: Int = occ_op_voxel(op2);
    if v1 != v2 || v1 != 50 {
        println("FAIL occ_op_voxel");
        process_exit(1);
    }

    let eng1: OccEng = occupancy_engine_new(100, 200);
    let eng2: OccEng = occupancy_engine_new(100, 200);
    let dim1: Int = occ_eng_dim_x(eng1);
    let dim2: Int = occ_eng_dim_x(eng2);
    if dim1 != dim2 || dim1 != 100 {
        println("FAIL occ_eng_dim_x");
        process_exit(1);
    }

    println("prod_g4_auto_occupancy: PASSED");
    process_exit(0);
}
