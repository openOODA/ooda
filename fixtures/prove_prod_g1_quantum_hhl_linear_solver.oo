// # Product prove std/quantum_advanced/quantum_hhl_linear_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts hhl_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_hhl_linear_solver.oo.
//
// Beats:
//   1. Call hhl_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_hhl_linear_solver: PASSED only if they match.

import "std/quantum_advanced/quantum_hhl_linear_solver.oo";

pub fn main() {
    let a: HhlConfig = hhl_config_new(0, 0, 0.0, 0.0);
    let b: HhlConfig = hhl_config_new(0, 0, 0.0, 0.0);
    if a.num_clock_qubits != b.num_clock_qubits {
        println("FAIL hhl_config_new");
        process_exit(1);
    }
    println("prod_quantum_hhl_linear_solver: PASSED");
}
