// # Product prove std/multimedia/color_hsl.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_hsl_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/color_hsl.oo.
//
// Beats:
//   1. Call color_hsl_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_color_hsl: PASSED only if they match.

import "std/multimedia/color_hsl.oo";

pub fn main() {
    let color_hsl_mark: Int = 0;
    if color_hsl_mark != 0 {
        process_exit(1);
    }
    let color_hsl_a: Float = color_hsl_abs(1.0);
    let color_hsl_b: Float = color_hsl_abs(1.0);
    if color_hsl_a != color_hsl_b {
        println("FAIL color_hsl_abs");
        process_exit(1);
    }
    println("prod_color_hsl: PASSED");
}
