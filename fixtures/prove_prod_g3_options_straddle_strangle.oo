// # Product prove std/defi_derivatives/options_straddle_strangle.oo
//
// Logline: Fail-closed emit+gcc+run asserts ss_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_straddle_strangle.oo.
//
// Beats:
//   1. Call ss_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_straddle_strangle: PASSED only if they match.

import "std/defi_derivatives/options_straddle_strangle.oo";

pub fn main() {
    let options_straddle_strangle_mark: Int = 0;
    if options_straddle_strangle_mark != 0 {
        process_exit(1);
    }
    let a: Float = ss_norm_pdf(0.0);
    let b: Float = ss_norm_pdf(0.0);
    if a != b {
        println("FAIL ss_norm_pdf");
        process_exit(1);
    }
    println("prod_options_straddle_strangle: PASSED");
}
