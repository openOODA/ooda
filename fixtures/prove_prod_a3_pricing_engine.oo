// # Product prove std/fin/pricing_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std_normal_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing_engine.oo.
//
// Beats:
//   1. Call std_normal_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pricing_engine: PASSED only if they match.

import "std/fin/pricing_engine.oo";

pub fn main() {
    let pricing_engine_mark: Int = 0;
    if pricing_engine_mark != 0 {
        process_exit(1);
    }
    let a: Float = std_normal_pdf(0.0);
    let b: Float = std_normal_pdf(0.0);
    if a != b {
        println("FAIL std_normal_pdf");
        process_exit(1);
    }
    println("prod_pricing_engine: PASSED");
}
