// # Product prove std/crypto/keys_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts key_meta_bits is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys_types.oo.
//
// Beats:
//   1. Call key_meta_bits twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_keys_types: PASSED only if they match.

import "std/crypto/keys_types.oo";

pub fn main() {
    let obj = key_meta_new(0, 0, 0);
    let a = key_meta_bits(obj);
    let b = key_meta_bits(obj);
    if a != b {
        println("FAIL key_meta_bits");
        process_exit(1);
    }
    println("prod_keys_types: PASSED");
}
