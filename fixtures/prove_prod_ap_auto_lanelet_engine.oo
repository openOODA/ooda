// # Product prove std/auto/lanelet_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/lanelet_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lanelet_engine: PASSED only if they match.

import "std/auto/lanelet_engine.oo";

pub fn main() {
    let lanelet_engine_a = llt_eng_new(0, 0);
    let lanelet_engine_b = llt_eng_new(0, 0);
    let lanelet_engine_va = llt_eng_map_id(lanelet_engine_a);
    let lanelet_engine_vb = llt_eng_map_id(lanelet_engine_b);
    if lanelet_engine_va != lanelet_engine_vb {
        println("FAIL lanelet_engine");
        process_exit(1);
    }
    println("prod_ap_lanelet_engine: PASSED");
}
