// # Product prove std/bio_advanced/crispr_efficiency_score.oo
//
// Logline: Fail-closed verification that CRISPR on-target cleavage efficiency scoring is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_efficiency_score.oo.
//
// Beats:
//   1. Query position-specific nucleotide preference weights.
//   2. Evaluate maximum poly-T tract length in sgRNA spacer sequences.
//   3. Calculate composite efficiency metrics and GC percentage.
//   4. Print prod_g4_bio_crispr_efficiency: PASSED and exit 0.

import "std/bio_advanced/crispr_efficiency_score.oo";

pub fn main() {
    let pw19_g: Float = crispr_pos_weight(19, "G");
    let pw19_c: Float = crispr_pos_weight(19, "C");
    let pw18_c: Float = crispr_pos_weight(18, "C");
    let pw2_c: Float = crispr_pos_weight(2, "C");

    if pw19_g != 0.45 || pw19_c != -0.25 || pw18_c != 0.35 || pw2_c != 0.15 {
        println("FAIL crispr_pos_weight");
        process_exit(1);
    }

    let pt0: Int = crispr_max_poly_t("ACGCGC");
    let pt1: Int = crispr_max_poly_t("ACGT");
    let pt4: Int = crispr_max_poly_t("ACGTTTTG");

    if pt0 != 0 || pt1 != 1 || pt4 != 4 {
        println("FAIL crispr_max_poly_t");
        process_exit(1);
    }

    let spacer: String = "GCCAATTCGAACGTTCGAAG";
    let eff1: EfficiencyMetrics = crispr_calc_efficiency(spacer);
    let eff2: EfficiencyMetrics = crispr_calc_efficiency(spacer);

    if (eff1).poly_t_tract_len != (eff2).poly_t_tract_len || (eff1).gc_percentage != (eff2).gc_percentage {
        println("FAIL crispr_calc_efficiency determinism");
        process_exit(1);
    }

    if (eff1).gc_percentage != 50.0 || (eff1).seed_stability_score != 85.0 {
        println("FAIL crispr_calc_efficiency values");
        process_exit(1);
    }

    println("prod_g4_bio_crispr_efficiency: PASSED");
    process_exit(0);
}
