// # Product prove std/db_graph/opencypher_logical_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_logical_planner.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_logical_planner.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_logical_planner: PASSED only if they match.

import "std/db_graph/opencypher_logical_planner.oo";

pub fn main() {
    let opencypher_logical_planner_a = logical_plan_node_new(0, 0, "x", "x", "x", 0);
    let opencypher_logical_planner_b = logical_plan_node_new(0, 0, "x", "x", "x", 0);
    if opencypher_logical_planner_a.node_id != opencypher_logical_planner_b.node_id {
        println("FAIL opencypher_logical_planner");
        process_exit(1);
    }
    println("prod_ap_opencypher_logical_planner: PASSED");
}
