// # Product prove std/grid/freq_inertia.oo
//
// Logline: Fail-closed emit+gcc+run asserts freq_math_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq_inertia.oo.
//
// Beats:
//   1. Call freq_math_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_freq_inertia: PASSED only if they match.

import "std/grid/freq_inertia.oo";

pub fn main() {
    let freq_inertia_mark: Int = 0;
    if freq_inertia_mark != 0 {
        process_exit(1);
    }
    let a: Float = freq_math_abs(0.0);
    let b: Float = freq_math_abs(0.0);
    if a != b {
        println("FAIL freq_math_abs");
        process_exit(1);
    }
    println("prod_freq_inertia: PASSED");
}
