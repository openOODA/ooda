// # Product prove std/os/landlock_jail.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/landlock_jail.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/landlock_jail.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_landlock_jail: PASSED only if they match.

import "std/os/landlock_jail.oo";

pub fn main() {
    let landlock_jail_a = jail_new();
    let landlock_jail_b = jail_new();
    let landlock_jail_va = jail_read_path_count(landlock_jail_a);
    let landlock_jail_vb = jail_read_path_count(landlock_jail_b);
    if landlock_jail_va != landlock_jail_vb {
        println("FAIL landlock_jail");
        process_exit(1);
    }
    println("prod_ap_landlock_jail: PASSED");
}
