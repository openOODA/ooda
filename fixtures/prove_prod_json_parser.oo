// # Product prove std/markup/json_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_validate is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_parser.oo.
//
// Beats:
//   1. Call json_validate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json_parser: PASSED only if they match.

import "std/markup/json_parser.oo";

pub fn main() {
    let a = json_validate("x");
    let b = json_validate("x");
    if a != b {
        println("FAIL json_validate");
        process_exit(1);
    }
    println("prod_json_parser: PASSED");
}
