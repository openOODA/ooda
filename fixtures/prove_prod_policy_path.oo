// # Product prove std/sec/policy_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts policy_path_is_locked is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/policy_path.oo.
//
// Beats:
//   1. Call policy_path_is_locked twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_policy_path: PASSED only if they match.

import "std/sec/policy_path.oo";

pub fn main() {
    let a = policy_path_is_locked("x");
    let b = policy_path_is_locked("x");
    if a != b {
        println("FAIL policy_path_is_locked");
        process_exit(1);
    }
    println("prod_policy_path: PASSED");
}
