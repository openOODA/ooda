// # Product prove std/quantum/qasm_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts qasm_token_get_kind is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum/qasm_lexer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qasm_token_get_kind twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_qasm_lexer: PASSED only if they match.

import "std/quantum/qasm_lexer.oo";

pub fn main() {
    let g2_oa: QasmToken = QasmToken { kind: "x", text: "x", line: 2, col: 2 };
    let g2_ob: QasmToken = QasmToken { kind: "x", text: "x", line: 2, col: 2 };
    let g2_a = qasm_token_get_kind(&g2_oa);
    let g2_b = qasm_token_get_kind(&g2_ob);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL qasm_token_get_kind");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL qasm_token_get_kind");
        process_exit(1);
    }
    println("prod_g2_qasm_lexer: PASSED");
}
