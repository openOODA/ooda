// # Product prove std/physics_advanced/soft_body_fem_tetrahedral.oo
//
// Logline: Fail-closed emit+gcc+run asserts lame_parameters is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_fem_tetrahedral.oo.
//
// Beats:
//   1. Call lame_parameters twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_soft_body_fem_tetrahedral: PASSED only if they match.

import "std/physics_advanced/soft_body_fem_tetrahedral.oo";

pub fn main() {
    let soft_body_fem_tetrahedral_mark: Int = 0;
    if soft_body_fem_tetrahedral_mark != 0 {
        process_exit(1);
    }
    let a: ElasticMaterialParams = lame_parameters(0.0, 0.0);
    let b: ElasticMaterialParams = lame_parameters(0.0, 0.0);
    if (a).youngs_modulus_e != (b).youngs_modulus_e {
        println("FAIL lame_parameters");
        process_exit(1);
    }
    println("prod_soft_body_fem_tetrahedral: PASSED");
}
