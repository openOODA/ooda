// # Product prove std/fin/orderbook.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_orderbook_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook.oo.
//
// Beats:
//   1. Call shim_marker_orderbook_init using the orderbook ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_orderbook: PASSED only if asserts hold.

import "std/fin/orderbook.oo";

pub fn main() {
    let obj = shim_marker_orderbook_init();
    let orderbook_a = obj.bid_count;
    let orderbook_b = obj.bid_count;
    if orderbook_a != orderbook_b {
        println("FAIL shim_marker_orderbook_init");
        process_exit(1);
    }
    println("prod_orderbook: PASSED");
}
