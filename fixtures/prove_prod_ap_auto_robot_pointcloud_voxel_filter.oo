// # Product prove std/auto_robot/pointcloud_voxel_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/pointcloud_voxel_filter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_voxel_filter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pointcloud_voxel_filter: PASSED only if they match.

import "std/auto_robot/pointcloud_voxel_filter.oo";

pub fn main() {
    let pointcloud_voxel_filter_a = voxel_idx(0, 0);
    let pointcloud_voxel_filter_b = voxel_idx(0, 0);
    if pointcloud_voxel_filter_a != pointcloud_voxel_filter_b {
        println("FAIL pointcloud_voxel_filter");
        process_exit(1);
    }
    println("prod_ap_pointcloud_voxel_filter: PASSED");
}
