// # Product prove std/compilers_vm/wasm_leb128_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts leb128_decoded_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_leb128_codec.oo.
//
// Beats:
//   1. Call leb128_decoded_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_leb128_codec: PASSED only if they match.

import "std/compilers_vm/wasm_leb128_codec.oo";

pub fn main() {
    let wasm_leb128_codec_mark: Int = 0;
    if wasm_leb128_codec_mark != 0 {
        process_exit(1);
    }
    let a: Leb128Decoded = leb128_decoded_new(0, 0);
    let b: Leb128Decoded = leb128_decoded_new(0, 0);
    if (a).value != (b).value {
        println("FAIL leb128_decoded_new");
        process_exit(1);
    }
    println("prod_wasm_leb128_codec: PASSED");
}
