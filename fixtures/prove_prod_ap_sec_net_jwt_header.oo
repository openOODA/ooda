// # Product prove std/sec/net/jwt_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/jwt_header.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_header.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jwt_header: PASSED only if they match.

import "std/sec/net/jwt_header.oo";

pub fn main() {
    let jwt_header_a = jwt_alg_is_safe("x");
    let jwt_header_b = jwt_alg_is_safe("x");
    if jwt_header_a != jwt_header_b {
        println("FAIL jwt_header");
        process_exit(1);
    }
    println("prod_ap_jwt_header: PASSED");
}
