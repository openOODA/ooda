// # Allow a helper that returns a public string
//
// Logline: A helper that returns a constant is not tainted just because a secret exists in main.
//
// Beats:
//   1. Return a public literal from safe_closure.
//   2. Tag api_key at line start in main.
//   3. Print the helper result so the sink stays allowed.

// M-? closure-style return clean: helper returns constant, caller uses result
pub fn safe_closure() -> String {
    return "[public]";
}
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let y = safe_closure();
    println(y);
}
