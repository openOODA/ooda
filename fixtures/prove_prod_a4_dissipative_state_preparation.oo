// # Product prove std/quantum_open_systems/dissipative_state_preparation.oo
//
// Logline: Fail-closed emit+gcc+run asserts dissipative_prep_config_bell is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/dissipative_state_preparation.oo.
//
// Beats:
//   1. Call dissipative_prep_config_bell twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dissipative_state_preparation: PASSED only if they match.

import "std/quantum_open_systems/dissipative_state_preparation.oo";

pub fn main() {
    let dissipative_state_preparation_mark: Int = 0;
    if dissipative_state_preparation_mark != 0 {
        process_exit(1);
    }
    let a: TargetStatePrepConfig = dissipative_prep_config_bell();
    let b: TargetStatePrepConfig = dissipative_prep_config_bell();
    if (a).target_state_id != (b).target_state_id {
        println("FAIL dissipative_prep_config_bell");
        process_exit(1);
    }
    println("prod_dissipative_state_preparation: PASSED");
}
