// # Product prove std/3d/voxels.oo
//
// Logline: Fail-closed emit+gcc+run asserts voxel_grid_slot_match is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/voxels.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call voxel_grid_slot_match twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_voxels: PASSED only if they match.

import "std/3d/voxels.oo";

pub fn main() {
    let g2_a = voxel_grid_slot_match(2, 2, 2, 2, 2, 2, 2);
    let g2_b = voxel_grid_slot_match(2, 2, 2, 2, 2, 2, 2);
    if g2_a != g2_b {
        println("FAIL voxel_grid_slot_match");
        process_exit(1);
    }
    println("prod_g2_voxels: PASSED");
}
