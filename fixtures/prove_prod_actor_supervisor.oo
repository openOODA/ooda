// # Product prove std/sync/actor_supervisor.oo
//
// Logline: Fail-closed emit+gcc+run asserts actor_sup_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/actor_supervisor.oo.
//
// Beats:
//   1. Call actor_sup_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_actor_supervisor: PASSED only if they match.

import "std/sync/actor_supervisor.oo";

pub fn main() {
    let obj = actor_sup_create(0, 0);
    let a = obj.strategy;
    let b = obj.strategy;
    if a != b {
        println("FAIL actor_sup_create");
        process_exit(1);
    }
    println("prod_actor_supervisor: PASSED");
}
