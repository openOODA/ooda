// # Product prove std/encoding/varint.oo
//
// Logline: Fail-closed emit+gcc+run asserts varint_encoded_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/encoding/varint.oo.
//
// Beats:
//   1. Call varint_encoded_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_varint: PASSED only if they match.

import "std/encoding/varint.oo";

pub fn main() {
    let varint_mark: Int = 0;
    if varint_mark != 0 {
        process_exit(1);
    }
    let varint_a: Int = varint_encoded_len(1);
    let varint_b: Int = varint_encoded_len(1);
    if varint_a != varint_b {
        println("FAIL varint_encoded_len");
        process_exit(1);
    }
    println("prod_varint: PASSED");
}
