// # Product prove std/aero/formation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts satellite formation flight engine calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_engine.oo.
//
// Beats:
//   1. Call formation_engine_marker, hcw_compute_mean_motion, and hcw_bounded_v_intrack.
//   2. Generate formation geometry states.
//   3. Assert deterministic outputs.
//   4. Print prod_g4_aero_formation_engine: PASSED only if all match.

import "std/aero/formation_engine.oo";

pub fn main() {
    let m: Int = formation_engine_marker();
    if m != 1 {
        println("FAIL formation_engine_marker");
        process_exit(1);
    }

    let n_a: Float = hcw_compute_mean_motion(7000000.0, 398600441800000.0);
    let n_b: Float = hcw_compute_mean_motion(7000000.0, 398600441800000.0);
    if n_a != n_b || n_a <= 0.0 {
        println("FAIL hcw_compute_mean_motion");
        process_exit(1);
    }

    let v_bound_a: Float = hcw_bounded_v_intrack(100.0, n_a);
    let v_bound_b: Float = hcw_bounded_v_intrack(100.0, n_a);
    if v_bound_a != v_bound_b {
        println("FAIL hcw_bounded_v_intrack");
        process_exit(1);
    }

    let leader_follower: RelativeState = geometry_in_plane_leader_follower(500.0);
    let pos_y: Float = ((leader_follower).position).y;
    if pos_y != 500.0 {
        println("FAIL geometry_in_plane_leader_follower position");
        process_exit(1);
    }

    let pco: RelativeState = geometry_projected_circular_orbit(1000.0, 0.0, n_a);
    let pco_y: Float = ((pco).position).y;
    if pco_y != 1000.0 {
        println("FAIL geometry_projected_circular_orbit");
        process_exit(1);
    }

    println("prod_g4_aero_formation_engine: PASSED");
    process_exit(0);
}
