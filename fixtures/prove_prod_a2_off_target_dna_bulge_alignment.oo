// # Product prove std/crispr_cas/off_target_dna_bulge_alignment.oo
//
// Logline: Fail-closed emit+gcc+run asserts bulge_score_penalty is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/off_target_dna_bulge_alignment.oo.
//
// Beats:
//   1. Call bulge_score_penalty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_off_target_dna_bulge_alignment: PASSED only if they match.

import "std/crispr_cas/off_target_dna_bulge_alignment.oo";

pub fn main() {
    let off_target_dna_bulge_alignment_mark: Int = 0;
    if off_target_dna_bulge_alignment_mark != 0 {
        process_exit(1);
    }
    let a: Float = bulge_score_penalty("x", 0, 0);
    let b: Float = bulge_score_penalty("x", 0, 0);
    if a != b {
        println("FAIL bulge_score_penalty");
        process_exit(1);
    }
    println("prod_off_target_dna_bulge_alignment: PASSED");
}
