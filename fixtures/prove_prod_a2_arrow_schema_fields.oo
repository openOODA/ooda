// # Product prove std/db_columnar/arrow_schema_fields.oo
//
// Logline: Fail-closed emit+gcc+run asserts arrow_field_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_schema_fields.oo.
//
// Beats:
//   1. Call arrow_field_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arrow_schema_fields: PASSED only if they match.

import "std/db_columnar/arrow_schema_fields.oo";

pub fn main() {
    let arrow_schema_fields_mark: Int = 0;
    if arrow_schema_fields_mark != 0 {
        process_exit(1);
    }
    let a: ArrowField = arrow_field_new("x", 0, true);
    let b: ArrowField = arrow_field_new("x", 0, true);
    if (a).type_id != (b).type_id {
        println("FAIL arrow_field_new");
        process_exit(1);
    }
    println("prod_arrow_schema_fields: PASSED");
}
