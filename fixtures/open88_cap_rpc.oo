// # Token-sealed capability RPC
//
// Logline: HMAC-seal a payload with the cap token; recv verifies and returns it.
//
// Setup: OPEN-88. cap_rpc_send / cap_rpc_recv under ThreadCap.
//
// Beats:
//   1. Send ping.
//   2. Recv yields ping.
//   3. Print PASSED.

pub fn main(thread: &ThreadCap) {
    let s: Result[String, String] = cap_rpc_send(thread, "ping");
    if s.is_err() {
        println("FAIL send");
        process_exit(1);
    }
    let sealed: String = s.unwrap();
    let p: Result[String, String] = cap_rpc_recv(thread, sealed);
    if p.is_err() {
        println("FAIL recv");
        process_exit(1);
    }
    let got: String = p.unwrap();
    if got != "ping" {
        println("FAIL payload");
        process_exit(1);
    }
    println("open88_cap_rpc: PASSED");
}
