// # Product prove std/db_graph/graph_variable_length_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts var_length_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_variable_length_path.oo.
//
// Beats:
//   1. Call var_length_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_variable_length_path: PASSED only if they match.

import "std/db_graph/graph_variable_length_path.oo";

pub fn main() {
    let graph_variable_length_path_mark: Int = 0;
    if graph_variable_length_path_mark != 0 {
        process_exit(1);
    }
    let a: VarLengthConfig = var_length_config_default();
    let b: VarLengthConfig = var_length_config_default();
    if (a).min_hops != (b).min_hops {
        println("FAIL var_length_config_default");
        process_exit(1);
    }
    println("prod_graph_variable_length_path: PASSED");
}
