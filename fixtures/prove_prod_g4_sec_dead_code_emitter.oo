// # Product Prove std/security_defense/dead_code_emitter.oo
//
// Logline: Deterministic assertion fixture verifying dead code sequence and junk byte generation.
//
// Setup: Isolated emit-c test fixture importing std/security_defense/dead_code_emitter.oo.
//
// Beats:
//   1. Construct DeadCodeGenerator with seed.
//   2. Emit neutral instruction sequences and opaque junk byte skips.
//   3. Assert junk block counts and byte sizes.
//   4. Print "prod_g4_sec_dead_code_emitter: PASSED".

import "std/security_defense/dead_code_emitter.oo";

pub fn main() {
    let mut gen: DeadCodeGenerator = dead_code_generator_new(42);

    let seq1: List[JunkInstruction] = dead_code_emit_neutral_sequence(&mut gen, 1);
    if list_len(seq1) != 3 {
        println("FAIL: seq1 length mismatch");
        process_exit(1);
    }

    let seq2: List[JunkInstruction] = dead_code_emit_opaque_skip(&mut gen, 8);
    if list_len(seq2) != 2 {
        println("FAIL: seq2 length mismatch");
        process_exit(1);
    }

    if (gen).junk_blocks_emitted != 2 {
        println("FAIL: junk_blocks_emitted mismatch");
        process_exit(1);
    }

    if (gen).total_junk_bytes != 16 { // 6 + (2 + 8) = 16
        println("FAIL: total_junk_bytes mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_dead_code_emitter: PASSED");
    process_exit(0);
}
