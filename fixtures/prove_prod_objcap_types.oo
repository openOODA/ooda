// # Product prove std/sec/sys/objcap_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts objcap_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_types.oo.
//
// Beats:
//   1. Call objcap_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap_types: PASSED only if they match.

import "std/sec/sys/objcap_types.oo";

pub fn main() {
    let obj = objcap_empty();
    let a = obj.issued_at;
    let b = obj.issued_at;
    if a != b {
        println("FAIL objcap_empty");
        process_exit(1);
    }
    println("prod_objcap_types: PASSED");
}
