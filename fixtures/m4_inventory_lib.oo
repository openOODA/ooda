// # Milestone 4 inventory struct library
//
// Logline: Provide Item struct and methods for inventory management.
//
// Setup: Imported by m4_inventory_main.oo.
//
// Beats:
//   1. Define Item struct with name, price, count.
//   2. Define total_val, restock, discount, validate_item, and format_tag.

type Item = struct {
    name: String,
    price: Int,
    count: Int
};

pub fn total_val(it: Item) -> Int {
    return it.price * it.count;
}

pub fn restock(it: &mut Item, add: Int) {
    (*it).count = (*it).count + add;
}

pub fn discount(it: Item, pct: Int) -> Item {
    return Item {
        name: it.name,
        price: it.price * (100 - pct) / 100,
        count: it.count
    };
}

pub fn validate_item(it: Item) -> Result[Item, String] {
    if it.price < 0 {
        return Err("negative price");
    }
    return Ok(it);
}

pub fn format_tag(it: &Item) -> String {
    return it.name;
}
