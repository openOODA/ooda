// # Product prove std/enterprise/audit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/enterprise/audit_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_audit_types: PASSED only if they match.

import "std/enterprise/audit_types.oo";

pub fn main() {
    let audit_types_a = audit_severity_to_string(0);
    let audit_types_b = audit_severity_to_string(0);
    if audit_types_a.contains(audit_types_b) == false {
        println("FAIL audit_types");
        process_exit(1);
    }
    if audit_types_b.contains(audit_types_a) == false {
        println("FAIL audit_types");
        process_exit(1);
    }
    println("prod_ap_audit_types: PASSED");
}
