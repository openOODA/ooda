// # Product prove std/space_propulsion/rocket_turbopump_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_turbopump_cycle.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_turbopump_cycle.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rocket_turbopump_cycle: PASSED only if they match.

import "std/space_propulsion/rocket_turbopump_cycle.oo";

pub fn main() {
    let rocket_turbopump_cycle_a = turbopump_spec_default_ffsc();
    let rocket_turbopump_cycle_b = turbopump_spec_default_ffsc();
    if rocket_turbopump_cycle_a.cycle_type != rocket_turbopump_cycle_b.cycle_type {
        println("FAIL rocket_turbopump_cycle");
        process_exit(1);
    }
    println("prod_ap_rocket_turbopump_cycle: PASSED");
}
