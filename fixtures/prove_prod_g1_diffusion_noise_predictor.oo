// # Product prove std/ai_multimodal/diffusion_noise_predictor.oo
//
// Logline: Fail-closed emit+gcc+run asserts noise_predictor_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_noise_predictor.oo.
//
// Beats:
//   1. Call noise_predictor_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_diffusion_noise_predictor: PASSED only if they match.

import "std/ai_multimodal/diffusion_noise_predictor.oo";

pub fn main() {
    let a: NoisePredictorConfig = noise_predictor_config_new(0, 0.0, true);
    let b: NoisePredictorConfig = noise_predictor_config_new(0, 0.0, true);
    if a.prediction_type != b.prediction_type {
        println("FAIL noise_predictor_config_new");
        process_exit(1);
    }
    println("prod_diffusion_noise_predictor: PASSED");
}
