// # Product prove std/pqc_nist/falcon_ntru_lattice_sig.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntru_basis_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_ntru_lattice_sig.oo.
//
// Beats:
//   1. Call ntru_basis_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_falcon_ntru_lattice_sig: PASSED only if they match.

import "std/pqc_nist/falcon_ntru_lattice_sig.oo";

pub fn main() {
    let falcon_ntru_lattice_sig_mark: Int = 0;
    if falcon_ntru_lattice_sig_mark != 0 {
        process_exit(1);
    }
    let a: NtruBasis = ntru_basis_new(0);
    let b: NtruBasis = ntru_basis_new(0);
    if (a).n != (b).n {
        println("FAIL ntru_basis_new");
        process_exit(1);
    }
    println("prod_g2_falcon_ntru_lattice_sig: PASSED");
}
