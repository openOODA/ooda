// # Product prove std/industrial_predictive/ts_sensor_health_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts ts_sensor_health_index_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_sensor_health_index.oo.
//
// Beats:
//   1. Call ts_sensor_health_index_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ts_sensor_health_index: PASSED only if it matches.

import "std/industrial_predictive/ts_sensor_health_index.oo";

pub fn main() {
    let a: Int = ts_sensor_health_index_probe();
    if a != 0 {
        println("FAIL ts_sensor_health_index_probe");
        process_exit(1);
    }
    println("prod_nc_ts_sensor_health_index: PASSED");
}
