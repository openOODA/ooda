// # Product prove std/compilers_vm/wasm_component_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_component_model.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_component_model.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_component_model: PASSED only if they match.

import "std/compilers_vm/wasm_component_model.oo";

pub fn main() {
    let wasm_component_model_a = comp_type_bool();
    let wasm_component_model_b = comp_type_bool();
    if wasm_component_model_a != wasm_component_model_b {
        println("FAIL wasm_component_model");
        process_exit(1);
    }
    println("prod_ap_wasm_component_model: PASSED");
}
