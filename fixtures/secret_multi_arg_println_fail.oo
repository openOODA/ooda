// # Refuse a secret in a multi-arg println
//
// Logline: Multi-arg println refuses when any argument is a tagged IDENT.
//
// Beats:
//   1. Tag s at line start.
//   2. Print a public n beside that IDENT.
//   3. Expect the sink to refuse.

// M107: multi-arg println with secret bare IDENT
// SECRET: s
pub fn main() {
    let s = "secret";
    let n = 1;
    println(n, s);
}
