// # Product prove std/synthetic_biology/dynamic_flux_balance_dfba.oo
//
// Logline: Fail-closed emit+gcc+run asserts dfba_calc_uptake_bound is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/dynamic_flux_balance_dfba.oo.
//
// Beats:
//   1. Call dfba_calc_uptake_bound twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dfba_calc_uptake: PASSED only if they match.

import "std/synthetic_biology/dynamic_flux_balance_dfba.oo";

pub fn main() {
    let dynamic_flux_balance_dfba_mark: Int = 0;
    if dynamic_flux_balance_dfba_mark != 0 { process_exit(1); }
    let p: DfbaKineticsParams = DfbaKineticsParams { v_max_substrate: 1.0, k_s: 0.1, yield_biomass_substrate: 0.5, yield_product_biomass: 0.1, maintenance_flux: 0.05 };
    let a: Float = dfba_calc_uptake_bound(2.0, &p);
    let b: Float = dfba_calc_uptake_bound(2.0, &p);
    if a != b {
        println("FAIL dfba_calc_uptake_bound");
        process_exit(1);
    }
    println("prod_dfba_calc_uptake: PASSED");
}
