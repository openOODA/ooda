// # Product prove std/db_graph/property_graph_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_schema.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_schema.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_property_graph_schema: PASSED only if they match.

import "std/db_graph/property_graph_schema.oo";

pub fn main() {
    let property_graph_schema_a = property_constraint_new("x", 0, true, true);
    let property_graph_schema_b = property_constraint_new("x", 0, true, true);
    if property_graph_schema_a.prop_name != property_graph_schema_b.prop_name {
        println("FAIL property_graph_schema");
        process_exit(1);
    }
    println("prod_ap_property_graph_schema: PASSED");
}
