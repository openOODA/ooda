// # Product prove std/_template.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/_template.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/_template.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap__template: PASSED only if they match.

import "std/_template.oo";

pub fn main() {
    let _template_a = template_op("x");
    let _template_b = template_op("x");
    if _template_a.contains(_template_b) == false {
        println("FAIL _template");
        process_exit(1);
    }
    if _template_b.contains(_template_a) == false {
        println("FAIL _template");
        process_exit(1);
    }
    println("prod_ap__template: PASSED");
}
