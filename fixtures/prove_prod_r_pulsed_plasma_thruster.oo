// # Product prove std/space_propulsion/pulsed_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts ppt_circuit_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/pulsed_plasma_thruster.oo.
//
// Beats:
//   1. Call ppt_circuit_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pulsed_plasma_thruster: PASSED only if asserts hold.

import "std/space_propulsion/pulsed_plasma_thruster.oo";

pub fn main() {
    let pulsed_plasma_thruster: PptCircuitSpec = ppt_circuit_spec_default();
    let pulsed_plasma_thruster_b: PptCircuitSpec = ppt_circuit_spec_default();
    if (pulsed_plasma_thruster).capacitance_uf != 4.0 {
        println("FAIL ppt_circuit_spec_default capacitance_uf");
        process_exit(1);
    }
    if (pulsed_plasma_thruster).capacitance_uf != (pulsed_plasma_thruster_b).capacitance_uf {
        println("FAIL ppt_circuit_spec_default det");
        process_exit(1);
    }
    println("prod_pulsed_plasma_thruster: PASSED");
}
