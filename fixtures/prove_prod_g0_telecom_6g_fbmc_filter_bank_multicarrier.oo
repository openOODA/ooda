// # Product prove std/telecom_6g/fbmc_filter_bank_multicarrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts fbmc_oqam_phase_factor is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/fbmc_filter_bank_multicarrier.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fbmc_oqam_phase_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fbmc_filter_bank_multicarrier: PASSED only if they match.

import "std/telecom_6g/fbmc_filter_bank_multicarrier.oo";

pub fn main() {
    let g0_a = fbmc_oqam_phase_factor(2, 2);
    let g0_b = fbmc_oqam_phase_factor(2, 2);
    if g0_a != g0_b {
        println("FAIL fbmc_oqam_phase_factor");
        process_exit(1);
    }
    println("prod_g0_fbmc_filter_bank_multicarrier: PASSED");
}
