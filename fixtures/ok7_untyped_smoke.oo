// # Untyped Ok(7) emit lock
//
// Logline: Fail-closed emit+gcc+run of unannotated Ok(7) as Int payload.
//
// Setup: Backend-C. No Result type on the let. Not oo_int_to_str.
//
// Beats:
//   1. let r = Ok(7) with no annotation.
//   2. Match binds Int 7.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let r = Ok(7);
    let n: Int = match r {
        Ok(v) => v,
        Err(e) => 0
    };
    if n != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("ok7_untyped_smoke: PASSED");
}
