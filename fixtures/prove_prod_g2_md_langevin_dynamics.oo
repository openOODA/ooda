// # Product prove std/protein_folding/md_langevin_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts langevin_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_langevin_dynamics.oo.
//
// Beats:
//   1. Call langevin_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_langevin_dynamics: PASSED only if they match.

import "std/protein_folding/md_langevin_dynamics.oo";

pub fn main() {
    let md_langevin_dynamics_mark: Int = 0;
    if md_langevin_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: LangevinParams = langevin_params_default(0.0, 0.0, 0.0);
    let b: LangevinParams = langevin_params_default(0.0, 0.0, 0.0);
    if (a).target_temp_k != (b).target_temp_k {
        println("FAIL langevin_params_default");
        process_exit(1);
    }
    println("prod_g2_md_langevin_dynamics: PASSED");
}
