// # Product prove std/fintech/risk_sharpe_sortino.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech/risk_sharpe_sortino.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_risk_sharpe_sortino: PASSED only if they match.

import "std/fintech/risk_sharpe_sortino.oo";

pub fn main() {
    let g2_a = int_to_float(2);
    let g2_b = int_to_float(2);
    if g2_a != g2_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_g2_risk_sharpe_sortino: PASSED");
}
