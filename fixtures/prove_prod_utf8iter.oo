// # Product utf8_iterator prove
//
// Logline: Fail-closed emit+gcc+run of shipped utf8_iter_new/has_next/next/pos.
//
// Setup: Product std/text/utf8_iterator.oo. Two-char "hi".
//
// Beats:
//   1. New iterator has_next; after two next, pos is 2 and has_next is false.
//   2. len is 2.
//   3. Exit 1 before PASSED on a miss.

import "std/text/utf8_iterator.oo";

pub fn main() {
    let mut it: Utf8Iter = utf8_iter_new("hi");
    let n: Int = utf8_iter_len(it);
    if n != 2 {
        println("FAIL utf8iter len");
        process_exit(1);
    }
    let h0: Bool = utf8_iter_has_next(it);
    if h0 == false {
        println("FAIL utf8iter has0");
        process_exit(1);
    }
    it = utf8_iter_next(it);
    it = utf8_iter_next(it);
    let p: Int = utf8_iter_pos(it);
    if p != 2 {
        println("FAIL utf8iter pos");
        process_exit(1);
    }
    let h2: Bool = utf8_iter_has_next(it);
    if h2 == true {
        println("FAIL utf8iter has2");
        process_exit(1);
    }
    println("prod_utf8iter: PASSED");
}
