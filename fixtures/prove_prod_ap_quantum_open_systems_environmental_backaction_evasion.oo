// # Product prove std/quantum_open_systems/environmental_backaction_evasion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/environmental_backaction_evasion.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/environmental_backaction_evasion.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_environmental_backaction_evasion: PASSED only if they match.

import "std/quantum_open_systems/environmental_backaction_evasion.oo";

pub fn main() {
    let environmental_backaction_evasion_a = backaction_is_sub_sql(0.0);
    let environmental_backaction_evasion_b = backaction_is_sub_sql(0.0);
    if environmental_backaction_evasion_a != environmental_backaction_evasion_b {
        println("FAIL environmental_backaction_evasion");
        process_exit(1);
    }
    println("prod_ap_environmental_backaction_evasion: PASSED");
}
