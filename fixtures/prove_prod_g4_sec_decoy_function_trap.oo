// # Product Prove std/security_defense/decoy_function_trap.oo
//
// Logline: Deterministic assertion fixture verifying honeypot trap registration and unauthorized call interception.
//
// Setup: Isolated emit-c test fixture importing std/security_defense/decoy_function_trap.oo.
//
// Beats:
//   1. Instantiate TrapManager and register decoy traps.
//   2. Trigger decoy addresses and benign addresses.
//   3. Assert trip counters and isolation actions.
//   4. Print "prod_g4_sec_decoy_function_trap: PASSED".

import "std/security_defense/decoy_function_trap.oo";

pub fn main() {
    let mut mgr: TrapManager = trap_manager_new();
    let _a1: Bool = trap_manager_add_decoy(&mut mgr, 1, "admin_shell", 4001, 0); // LOG_AND_BLOCK
    let _a2: Bool = trap_manager_add_decoy(&mut mgr, 2, "root_bypass", 4002, 1); // RETURN_FAKE_SUCCESS

    if (mgr).trap_count != 2 {
        println("FAIL: trap_count mismatch");
        process_exit(1);
    }

    let act1: Int = trap_manager_trigger(&mut mgr, 4001);
    if act1 != 0 {
        println("FAIL: act1 mismatch");
        process_exit(1);
    }

    let act2: Int = trap_manager_trigger(&mut mgr, 4002);
    if act2 != 1 {
        println("FAIL: act2 mismatch");
        process_exit(1);
    }

    let act_none: Int = trap_manager_trigger(&mut mgr, 9999);
    if act_none != -1 {
        println("FAIL: act_none mismatch");
        process_exit(1);
    }

    if (mgr).total_trips != 2 {
        println("FAIL: total_trips mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_decoy_function_trap: PASSED");
    process_exit(0);
}
