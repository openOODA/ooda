// # Product prove std/db_storage/sql_expression_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts eval_int_value is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_expression_evaluator.oo.
//
// Beats:
//   1. Call eval_int_value twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sql_expression_evaluator: PASSED only if they match.

import "std/db_storage/sql_expression_evaluator.oo";

pub fn main() {
    let sql_expression_evaluator_mark: Int = 0;
    if sql_expression_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: EvaluatedValue = eval_int_value(0);
    let b: EvaluatedValue = eval_int_value(0);
    if (a).int_val != (b).int_val {
        println("FAIL eval_int_value");
        process_exit(1);
    }
    println("prod_g2_sql_expression_evaluator: PASSED");
}
