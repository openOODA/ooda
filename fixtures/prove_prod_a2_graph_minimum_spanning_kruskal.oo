// # Product prove std/db_graph/graph_minimum_spanning_kruskal.oo
//
// Logline: Fail-closed emit+gcc+run asserts mst_edge_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_minimum_spanning_kruskal.oo.
//
// Beats:
//   1. Call mst_edge_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_minimum_spanning_kruskal: PASSED only if they match.

import "std/db_graph/graph_minimum_spanning_kruskal.oo";

pub fn main() {
    let graph_minimum_spanning_kruskal_mark: Int = 0;
    if graph_minimum_spanning_kruskal_mark != 0 {
        process_exit(1);
    }
    let a: MSTEdge = mst_edge_new(0, 0, 0.0);
    let b: MSTEdge = mst_edge_new(0, 0, 0.0);
    if (a).u != (b).u {
        println("FAIL mst_edge_new");
        process_exit(1);
    }
    println("prod_graph_minimum_spanning_kruskal: PASSED");
}
