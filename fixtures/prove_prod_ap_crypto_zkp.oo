// # Product prove std/crypto/zkp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/zkp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zkp: PASSED only if they match.

import "std/crypto/zkp.oo";

pub fn main() {
    let zkp_a = shim_marker_scheme();
    let zkp_b = shim_marker_scheme();
    if zkp_a != zkp_b {
        println("FAIL zkp");
        process_exit(1);
    }
    println("prod_ap_zkp: PASSED");
}
