// # Two-sock alias mixup
//
// Logline: Open two socks, connect one, and send on the other handle.
//
// Beats:
//   1. Open two Closed socks.
//   2. Connect only the first sock.
//   3. Send on the second sock.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    let t = open_sock();
    connect(s);
    send(t);
}
