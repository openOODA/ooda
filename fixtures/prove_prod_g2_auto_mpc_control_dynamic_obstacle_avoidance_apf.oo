// # Product prove std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo
//
// Logline: Fail-closed emit+gcc+run asserts apf_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call apf_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dynamic_obstacle_avoidance_apf: PASSED only if they match.

import "std/auto_mpc_control/dynamic_obstacle_avoidance_apf.oo";

pub fn main() {
    let g2_oa: APFConfig = apf_config_default();
    let g2_ob: APFConfig = apf_config_default();
    let g2_a = (g2_oa).k_att;
    let g2_b = (g2_ob).k_att;
    if g2_a != g2_b {
        println("FAIL apf_config_default.k_att");
        process_exit(1);
    }
    println("prod_g2_dynamic_obstacle_avoidance_apf: PASSED");
}
