// # Product prove std/synthetic_biology/recombinase_integrase_logic.oo
//
// Logline: Fail-closed emit+gcc+run asserts integrase_calc_efficiency is a real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/recombinase_integrase_logic.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call integrase_calc_efficiency twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_recombinase_integrase_logic: PASSED only if they match.

import "std/synthetic_biology/recombinase_integrase_logic.oo";

pub fn main() {
    let g0_a = integrase_calc_efficiency(0.0, true, true);
    let g0_b = integrase_calc_efficiency(0.0, true, true);
    if g0_a != g0_b {
        println("FAIL integrase_calc_efficiency");
        process_exit(1);
    }
    println("prod_gr_recombinase_integrase_logic: PASSED");
}
