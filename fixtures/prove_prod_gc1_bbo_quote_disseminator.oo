// # Product prove std/fintech_l3_book/bbo_quote_disseminator.oo
//
// Logline: Fail-closed emit+gcc+run asserts bbo_quote_message_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/bbo_quote_disseminator.oo.
//
// Beats:
//   1. Call bbo_quote_message_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bbo_quote_disseminator: PASSED only if they match.

import "std/fintech_l3_book/bbo_quote_disseminator.oo";

pub fn main() {
    let bbo_quote_disseminator_mark: Int = 0;
    if bbo_quote_disseminator_mark != 0 {
        process_exit(1);
    }
    let bbo_quote_disseminator_a = bbo_quote_message_new("x", 1, 1, 1, 1, 1);
    let bbo_quote_disseminator_b = bbo_quote_message_new("x", 1, 1, 1, 1, 1);
    if (bbo_quote_disseminator_a).bid_price_fixed != (bbo_quote_disseminator_b).bid_price_fixed {
        println("FAIL bbo_quote_message_new");
        process_exit(1);
    }
    println("prod_bbo_quote_disseminator: PASSED");
}
