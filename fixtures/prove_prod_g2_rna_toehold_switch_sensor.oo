// # Product prove std/synthetic_biology/rna_toehold_switch_sensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_toehold_switch_sensor_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/rna_toehold_switch_sensor.oo.
//
// Beats:
//   1. Call rna_toehold_switch_sensor_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rna_toehold_switch_sensor: PASSED only if they match.

import "std/synthetic_biology/rna_toehold_switch_sensor.oo";

pub fn main() {
    let a: Int = rna_toehold_switch_sensor_probe();
    let b: Int = rna_toehold_switch_sensor_probe();
    if a != b {
        println("FAIL rna_toehold_switch_sensor_probe");
        process_exit(1);
    }
    println("prod_g2_rna_toehold_switch_sensor: PASSED");
}
