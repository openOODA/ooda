// # Product prove std/grid/solar.oo
//
// Logline: Fail-closed verification of solar photovoltaic generation, yield estimation, and carbon analytics facade.
//
// Setup: Isolated emit-c. Imports std/grid/solar.oo.
//
// Beats:
//   1. Query solar physics constant shims and DC power calculations.
//   2. Validate daily yield, performance ratio, and CO2 emissions savings.
//   3. Assert determinism across repeated analytical calls.
//   4. Print prod_g4_grid_solar: PASSED and exit 0.

import "std/grid/solar.oo";

pub fn main() {
    let pi_a: Float = shim_marker_math_pi();
    let pi_b: Float = shim_marker_math_pi();
    if pi_a != pi_b || pi_a < 3.14 || pi_a > 3.15 {
        println("FAIL shim_marker_math_pi");
        process_exit(1);
    }

    let dc_a: Float = shim_marker_pv_dc_power();
    let dc_b: Float = shim_marker_pv_dc_power();
    if dc_a != dc_b || dc_a <= 0.0 {
        println("FAIL shim_marker_pv_dc_power");
        process_exit(1);
    }

    let yield_a: Float = shim_marker_daily_yield();
    let yield_b: Float = shim_marker_daily_yield();
    if yield_a != yield_b || yield_a <= 0.0 {
        println("FAIL shim_marker_daily_yield");
        process_exit(1);
    }

    let co2_a: Float = shim_marker_co2_savings();
    let co2_b: Float = shim_marker_co2_savings();
    if co2_a != co2_b || co2_a != 500.0 {
        println("FAIL shim_marker_co2_savings");
        process_exit(1);
    }

    let pr_a: Float = shim_marker_performance_ratio();
    let pr_b: Float = shim_marker_performance_ratio();
    if pr_a != pr_b || pr_a != 80.0 {
        println("FAIL shim_marker_performance_ratio");
        process_exit(1);
    }

    let co2_direct: Float = solar_calculate_co2_savings(2000.0, 0.4);
    if co2_direct != 800.0 {
        println("FAIL solar_calculate_co2_savings direct");
        process_exit(1);
    }

    let pr_direct: Float = solar_calculate_performance_ratio(800.0, 200.0, 5.0);
    if pr_direct != 80.0 {
        println("FAIL solar_calculate_performance_ratio direct");
        process_exit(1);
    }

    println("prod_g4_grid_solar: PASSED");
    process_exit(0);
}
