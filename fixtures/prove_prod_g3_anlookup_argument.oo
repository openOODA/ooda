// # Product prove std/zk_rollup/anlookup_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts lookup_table_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/anlookup_argument.oo.
//
// Beats:
//   1. Call lookup_table_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anlookup_argument: PASSED only if they match.

import "std/zk_rollup/anlookup_argument.oo";

pub fn main() {
    let anlookup_argument_mark: Int = 0;
    if anlookup_argument_mark != 0 {
        process_exit(1);
    }
    let a: LookupTable = lookup_table_new(0, 0, 0, 0, 0);
    let b: LookupTable = lookup_table_new(0, 0, 0, 0, 0);
    if (a).table_id != (b).table_id {
        println("FAIL lookup_table_new");
        process_exit(1);
    }
    println("prod_anlookup_argument: PASSED");
}
