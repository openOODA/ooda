// # Product prove std/db_columnar/columnar_partition_pruner.oo
//
// Logline: Fail-closed emit+gcc+run asserts partition_directory_matches_int is a real value.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_partition_pruner.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call partition_directory_matches_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_columnar_partition_pruner: PASSED only if they match.

import "std/db_columnar/columnar_partition_pruner.oo";

pub fn main() {
    let g0_oa = partition_directory_new("x");
    let g0_ob = partition_directory_new("x");
    let g0_a = partition_directory_matches_int(g0_oa, "x", 0);
    let g0_b = partition_directory_matches_int(g0_ob, "x", 0);
    if g0_a != g0_b {
        println("FAIL partition_directory_matches_int");
        process_exit(1);
    }
    println("prod_gr_columnar_partition_pruner: PASSED");
}
