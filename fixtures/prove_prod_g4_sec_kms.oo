// # Product prove std/sec/crypto/kms.oo
//
// Logline: Fail-closed emit+gcc+run asserts KMS policies, key lifecycle, and engine operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms.oo.
//
// Beats:
//   1. Check KMS checksum and hex encoding shim markers.
//   2. Validate key policies, operation permissions, and constant-time equality.
//   3. Initialize KMS engine and evaluate deterministic work metric.
//   4. Print prod_g4_sec_kms: PASSED and exit 0.

import "std/sec/crypto/kms.oo";

pub fn main() {
    let cs1: Int = shim_marker_checksum();
    let cs2: Int = shim_marker_checksum();
    if cs1 != cs2 {
        println("FAIL shim_marker_checksum");
        process_exit(1);
    }

    let hex1: String = shim_marker_hex();
    let hex2: String = shim_marker_hex();
    if hex1 != hex2 || chars_len(hex1) == 0 {
        println("FAIL shim_marker_hex");
        process_exit(1);
    }

    let pol1: KmsKeyPolicy = shim_marker_policy_create();
    let pol2: KmsKeyPolicy = shim_marker_policy_create();
    if kms_key_policy_validate(&pol1) != kms_key_policy_validate(&pol2) || (pol1).max_uses != (pol2).max_uses {
        println("FAIL shim_marker_policy_create");
        process_exit(1);
    }

    let allows1: Bool = kms_key_policy_allows_operation(&pol1, "encrypt");
    let allows2: Bool = kms_key_policy_allows_operation(&pol2, "encrypt");
    if allows1 != allows2 || allows1 == false {
        println("FAIL kms_key_policy_allows_operation");
        process_exit(1);
    }

    let eq_a: Bool = kms_constant_time_eq("secret_kms_key", "secret_kms_key");
    let eq_b: Bool = kms_constant_time_eq("secret_kms_key", "secret_kms_key");
    if eq_a != eq_b || eq_a == false {
        println("FAIL kms_constant_time_eq");
        process_exit(1);
    }

    let eng: KmsEngine = shim_marker_engine_init();
    let w1: Int = shim_marker_engine_do_work(&eng);
    let w2: Int = shim_marker_engine_do_work(&eng);
    if w1 != w2 {
        println("FAIL shim_marker_engine_do_work");
        process_exit(1);
    }

    println("prod_g4_sec_kms: PASSED");
    process_exit(0);
}
