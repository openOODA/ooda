// # Product prove std/formal_verif/refinement_type_checker.oo
//
// Logline: Fail-closed emit+gcc+run asserts refinement_env_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/refinement_type_checker.oo.
//
// Beats:
//   1. Call refinement_env_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_refinement_type_checker: PASSED only if they match.

import "std/formal_verif/refinement_type_checker.oo";

pub fn main() {
    let a: RefinementEnv = refinement_env_new();
    let b: RefinementEnv = refinement_env_new();
    if a.binding_count != 0 {
        println("FAIL refinement_env_new");
        process_exit(1);
    }
    if a.binding_count != b.binding_count {
        println("FAIL refinement_env_new");
        process_exit(1);
    }
    println("prod_refinement_type_checker: PASSED");
}
