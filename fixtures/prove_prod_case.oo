// # Product case converter prove
//
// Logline: Fail-closed emit+gcc+run of shipped char_to_lower/upper.
//
// Setup: Product std/text/case_converter.oo. ASCII A/a.
//
// Beats:
//   1. char_to_lower A is a.
//   2. char_to_upper a is A.
//   3. to_snake_case HelloWorld is hello_world if that is the impl.
//   4. Exit 1 before PASSED on a miss.

import "std/text/case_converter.oo";

pub fn main() {
    let lo: String = char_to_lower("A");
    if lo != "a" {
        println("FAIL lower");
        process_exit(1);
    }
    let up: String = char_to_upper("a");
    if up != "A" {
        println("FAIL upper");
        process_exit(1);
    }
    println("prod_case: PASSED");
}
