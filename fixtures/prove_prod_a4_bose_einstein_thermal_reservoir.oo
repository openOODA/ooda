// # Product prove std/quantum_open_systems/bose_einstein_thermal_reservoir.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermal_reservoir_cryogenic is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/bose_einstein_thermal_reservoir.oo.
//
// Beats:
//   1. Call thermal_reservoir_cryogenic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bose_einstein_thermal_reservoir: PASSED only if they match.

import "std/quantum_open_systems/bose_einstein_thermal_reservoir.oo";

pub fn main() {
    let bose_einstein_thermal_reservoir_mark: Int = 0;
    if bose_einstein_thermal_reservoir_mark != 0 {
        process_exit(1);
    }
    let a: ThermalReservoir = thermal_reservoir_cryogenic();
    let b: ThermalReservoir = thermal_reservoir_cryogenic();
    if (a).temperature_kelvin != (b).temperature_kelvin {
        println("FAIL thermal_reservoir_cryogenic");
        process_exit(1);
    }
    println("prod_bose_einstein_thermal_reservoir: PASSED");
}
