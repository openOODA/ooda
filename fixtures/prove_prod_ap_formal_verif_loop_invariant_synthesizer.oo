// # Product prove std/formal_verif/loop_invariant_synthesizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/loop_invariant_synthesizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/loop_invariant_synthesizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_loop_invariant_synthesizer: PASSED only if they match.

import "std/formal_verif/loop_invariant_synthesizer.oo";

pub fn main() {
    let loop_invariant_synthesizer_a = verify_invariant_initiation(0, 0);
    let loop_invariant_synthesizer_b = verify_invariant_initiation(0, 0);
    if loop_invariant_synthesizer_a != loop_invariant_synthesizer_b {
        println("FAIL loop_invariant_synthesizer");
        process_exit(1);
    }
    println("prod_ap_loop_invariant_synthesizer: PASSED");
}
