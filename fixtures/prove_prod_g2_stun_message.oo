// # Product prove std/web_protocols/stun_message.oo
//
// Logline: Fail-closed emit+gcc+run asserts stun_message_binding_request is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/stun_message.oo.
//
// Beats:
//   1. Call stun_message_binding_request twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stun_message: PASSED only if they match.

import "std/web_protocols/stun_message.oo";

pub fn main() {
    let a: StunMessage = stun_message_binding_request(0);
    let b: StunMessage = stun_message_binding_request(0);
    if (a).msg_type != (b).msg_type {
        println("FAIL stun_message_binding_request");
        process_exit(1);
    }
    println("prod_g2_stun_message: PASSED");
}
