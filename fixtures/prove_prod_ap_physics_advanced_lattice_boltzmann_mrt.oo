// # Product prove std/physics_advanced/lattice_boltzmann_mrt.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/lattice_boltzmann_mrt.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_mrt.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lattice_boltzmann_mrt: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_mrt.oo";

pub fn main() {
    let lattice_boltzmann_mrt_a = mrt_relax_moment(0.0, 0.0, 0.0);
    let lattice_boltzmann_mrt_b = mrt_relax_moment(0.0, 0.0, 0.0);
    if lattice_boltzmann_mrt_a != lattice_boltzmann_mrt_b {
        println("FAIL lattice_boltzmann_mrt");
        process_exit(1);
    }
    println("prod_ap_lattice_boltzmann_mrt: PASSED");
}
