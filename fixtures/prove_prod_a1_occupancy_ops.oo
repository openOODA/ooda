// # Product prove std/auto/occupancy_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts occ_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy_ops.oo.
//
// Beats:
//   1. Call occ_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_occupancy_ops: PASSED only if they match.

import "std/auto/occupancy_ops.oo";

pub fn main() {
    let occupancy_ops_mark: Int = 0;
    if occupancy_ops_mark != 0 {
        process_exit(1);
    }
    let a: OccOp = occ_op_new(0, 0);
    let b: OccOp = occ_op_new(0, 0);
    if (a).voxel_mm != (b).voxel_mm {
        println("FAIL occ_op_new");
        process_exit(1);
    }
    println("prod_occupancy_ops: PASSED");
}
