// # Product prove std/compilers_vm/regalloc_spill_placement.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/regalloc_spill_placement.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_spill_placement.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_regalloc_spill_placement: PASSED only if they match.

import "std/compilers_vm/regalloc_spill_placement.oo";

pub fn main() {
    let regalloc_spill_placement_a = align_up(0, 0);
    let regalloc_spill_placement_b = align_up(0, 0);
    if regalloc_spill_placement_a != regalloc_spill_placement_b {
        println("FAIL regalloc_spill_placement");
        process_exit(1);
    }
    println("prod_ap_regalloc_spill_placement: PASSED");
}
