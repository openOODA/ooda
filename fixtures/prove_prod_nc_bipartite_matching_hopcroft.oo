// # Product prove std/graph_topology/bipartite_matching_hopcroft.oo
//
// Logline: Fail-closed emit+gcc+run asserts bipartite_matching_hopcroft_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_topology/bipartite_matching_hopcroft.oo.
//
// Beats:
//   1. Call bipartite_matching_hopcroft_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bipartite_matching_hopcroft: PASSED only if it matches.

import "std/graph_topology/bipartite_matching_hopcroft.oo";

pub fn main() {
    let a: Int = bipartite_matching_hopcroft_probe();
    if a != 0 {
        println("FAIL bipartite_matching_hopcroft_probe");
        process_exit(1);
    }
    println("prod_nc_bipartite_matching_hopcroft: PASSED");
}
