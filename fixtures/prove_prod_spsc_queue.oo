// # Product prove std/sync/spsc_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts spsc_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/spsc_queue.oo.
//
// Beats:
//   1. Call spsc_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spsc_queue: PASSED only if they match.

import "std/sync/spsc_queue.oo";

pub fn main() {
    let obj = spsc_new(0);
    let a = spsc_len(obj);
    let b = spsc_len(obj);
    if a != b {
        println("FAIL spsc_len");
        process_exit(1);
    }
    println("prod_spsc_queue: PASSED");
}
