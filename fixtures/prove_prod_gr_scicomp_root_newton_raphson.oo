// # Product prove std/scicomp/root_newton_raphson.oo
//
// Logline: Fail-closed emit+gcc+run asserts newton_step_1d is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/root_newton_raphson.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call newton_step_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_root_newton_raphson: PASSED only if they match.

import "std/scicomp/root_newton_raphson.oo";

pub fn main() {
    let g0_a = newton_step_1d(0.0, 0.0, 0.0, 0.0);
    let g0_b = newton_step_1d(0.0, 0.0, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL newton_step_1d");
        process_exit(1);
    }
    println("prod_gr_root_newton_raphson: PASSED");
}
