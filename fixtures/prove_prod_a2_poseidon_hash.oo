// # Product prove std/crypto_advanced/poseidon_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts poseidon_sbox_x5 is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/poseidon_hash.oo.
//
// Beats:
//   1. Call poseidon_sbox_x5 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_poseidon_hash: PASSED only if they match.

import "std/crypto_advanced/poseidon_hash.oo";

pub fn main() {
    let poseidon_hash_mark: Int = 0;
    if poseidon_hash_mark != 0 {
        process_exit(1);
    }
    let a: Int = poseidon_sbox_x5(0, 0);
    let b: Int = poseidon_sbox_x5(0, 0);
    if a != b {
        println("FAIL poseidon_sbox_x5");
        process_exit(1);
    }
    println("prod_poseidon_hash: PASSED");
}
