// # Match-expression call scrutinee refuse
//
// Logline: emit-llvm fail-closes a match whose scrutinee is a call, not an IDENT.
//
// Setup: Backend-LLVM. Residual on purpose.
//
// Beats:
//   1. take returns Result[String].
//   2. Match take() directly.
//   3. Emit must print ERR llvm_emit.

pub fn take() -> Result[String, String] {
    return Ok("x");
}

pub fn main() {
    let s: String = match take() {
        Ok(v) => v,
        Err(e) => e
    };
    println(s);
}

pub fn bad() -> String {
    return match take() {
        Ok(v) => v,
        Err(e) => e
    };
}
