// # Product core Result helpers prove
//
// Logline: Fail-closed emit+gcc+run of std/core/result.oo Ok and is_ok.
//
// Setup: Tree oodac emit-c. Calls ooda/std/core/result.oo. Destub none.
//
// Beats:
//   1. res_ok("hi") is Ok.
//   2. res_err("no") is Err.
//   3. Exit 1 on any miss. Print prod_core_result: PASSED only if all hold.

import "std/core/result.oo";

pub fn main() {
    let a: Result[String, String] = res_ok("hi");
    if !res_is_ok(a) {
        println("FAIL res_is_ok");
        process_exit(1);
    }
    let b: Result[String, String] = res_err("no");
    if !res_is_err(b) {
        println("FAIL res_is_err");
        process_exit(1);
    }
    println("prod_core_result: PASSED");
}
