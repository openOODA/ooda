// # Product prove std/sec/sys/rop_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/rop_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rop_types: PASSED only if they match.

import "std/sec/sys/rop_types.oo";

pub fn main() {
    let rop_types_a = rop_gadget_new(0, 0, 0);
    let rop_types_b = rop_gadget_new(0, 0, 0);
    let rop_types_va = rop_gadget_addr(rop_types_a);
    let rop_types_vb = rop_gadget_addr(rop_types_b);
    if rop_types_va != rop_types_vb {
        println("FAIL rop_types");
        process_exit(1);
    }
    println("prod_ap_rop_types: PASSED");
}
