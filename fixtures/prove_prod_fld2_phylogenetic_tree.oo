// # Product prove std/bioinformatics/phylogenetic_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts phylo_patristic_distance_estimate is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/phylogenetic_tree.oo.
//
// Beats:
//   1. Call phylo_patristic_distance_estimate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_phylogenetic_tree: PASSED only if they match.

import "std/bioinformatics/phylogenetic_tree.oo";

pub fn main() {
    let phylogenetic_tree_mark: Int = 0;
    if phylogenetic_tree_mark != 0 {
        process_exit(1);
    }
    let phylogenetic_tree_a: Int = phylo_patristic_distance_estimate(1, 1);
    let phylogenetic_tree_b: Int = phylo_patristic_distance_estimate(1, 1);
    if phylogenetic_tree_a != phylogenetic_tree_b {
        println("FAIL phylo_patristic_distance_estimate");
        process_exit(1);
    }
    println("prod_phylogenetic_tree: PASSED");
}
