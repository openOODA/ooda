// # IEEE double free names
//
// Logline: Print sin, cos, sqrt, ln, exp, and pow on well-known doubles.
//
// Beats:
//   1. Print sin(0.0) and cos(0.0).
//   2. Print sqrt(4.0), ln(1.0), and exp(0.0).
//   3. Print pow(2.0, 3.0).

// M166 path A: IEEE double free names (Float = double; no decimal)
// Free names only so oodac rebuild ships without std import.
// Expect prints: sin0 ~0, cos0 ~1, sqrt4 = 2, ln1 = 0, exp0 = 1, pow2_3 = 8
pub fn main() {
    println(sin(0.0));
    println(cos(0.0));
    println(sqrt(4.0));
    println(ln(1.0));
    println(exp(0.0));
    println(pow(2.0, 3.0));
}
