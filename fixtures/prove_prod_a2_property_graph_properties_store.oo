// # Product prove std/db_graph/property_graph_properties_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts property_entry_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_properties_store.oo.
//
// Beats:
//   1. Call property_entry_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_properties_store: PASSED only if they match.

import "std/db_graph/property_graph_properties_store.oo";

pub fn main() {
    let property_graph_properties_store_mark: Int = 0;
    if property_graph_properties_store_mark != 0 {
        process_exit(1);
    }
    let a: PropertyEntry = property_entry_int("x", 0);
    let b: PropertyEntry = property_entry_int("x", 0);
    if (a).type_tag != (b).type_tag {
        println("FAIL property_entry_int");
        process_exit(1);
    }
    println("prod_property_graph_properties_store: PASSED");
}
