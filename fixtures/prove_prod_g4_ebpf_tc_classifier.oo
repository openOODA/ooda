// # Product prove std/mesh_ebpf/ebpf_tc_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts eBPF TC classifier packet classification and QoS marking are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_tc_classifier.oo.
//
// Beats:
//   1. Initialize TC classifier state with DSCP and protocol matching rules.
//   2. Classify sample socket buffer metadata against rules.
//   3. Assert deterministic return actions, priority markings, and classification counters.
//   4. Print prod_g4_ebpf_tc_classifier: PASSED and exit 0.

import "std/mesh_ebpf/ebpf_tc_classifier.oo";

pub fn main() {
    let mut tc: TcClassifierState = tc_classifier_state_new();
    tc_add_rule(&mut tc, 46, 6, 1, 100, 0);
    tc_add_rule(&mut tc, 0, 17, 0, 0, 2);

    let act1: TcAction = tc_classify_skb(&mut tc, 46, 6, 0, 0);
    if (act1).ret_code != 0 {
        println("FAIL tc_classify_skb act1 ret_code");
        process_exit(1);
    }
    if (act1).new_priority != 1 {
        println("FAIL tc_classify_skb act1 new_priority");
        process_exit(1);
    }
    if (act1).new_mark != 100 {
        println("FAIL tc_classify_skb act1 new_mark");
        process_exit(1);
    }

    let act2: TcAction = tc_classify_skb(&mut tc, 0, 17, 0, 0);
    if (act2).ret_code != 2 {
        println("FAIL tc_classify_skb act2 ret_code");
        process_exit(1);
    }

    if (tc).total_classified != 2 {
        println("FAIL tc total_classified");
        process_exit(1);
    }
    if (tc).passed_count != 1 {
        println("FAIL tc passed_count");
        process_exit(1);
    }
    if (tc).dropped_count != 1 {
        println("FAIL tc dropped_count");
        process_exit(1);
    }

    println("prod_g4_ebpf_tc_classifier: PASSED");
    process_exit(0);
}
