// # Product prove std/sync/actor_mailbox.oo
//
// Logline: Fail-closed emit+gcc+run asserts actor_mailbox_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/actor_mailbox.oo.
//
// Beats:
//   1. Call actor_mailbox_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_actor_mailbox: PASSED only if they match.

import "std/sync/actor_mailbox.oo";

pub fn main() {
    let obj = actor_mailbox_new(0);
    let a = actor_mailbox_len(obj);
    let b = actor_mailbox_len(obj);
    if a != b {
        println("FAIL actor_mailbox_len");
        process_exit(1);
    }
    println("prod_actor_mailbox: PASSED");
}
