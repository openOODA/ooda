// # Product prove std/uav_flight/uav_sliding_mode_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts smc_sat is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_sliding_mode_controller.oo.
//
// Beats:
//   1. Call smc_sat twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_sliding_mode_controller: PASSED only if they match.

import "std/uav_flight/uav_sliding_mode_controller.oo";

pub fn main() {
    let uav_sliding_mode_controller_mark: Int = 0;
    if uav_sliding_mode_controller_mark != 0 {
        process_exit(1);
    }
    let a: Float = smc_sat(0.0, 0.0);
    let b: Float = smc_sat(0.0, 0.0);
    if a != b {
        println("FAIL smc_sat");
        process_exit(1);
    }
    println("prod_g2_uav_sliding_mode_controller: PASSED");
}
