// # Product prove std/compilers_vm/elf64_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/elf64_header_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/elf64_header_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf64_header_parser: PASSED only if they match.

import "std/compilers_vm/elf64_header_parser.oo";

pub fn main() {
    let elf64_header_parser_a = elf_et_rel();
    let elf64_header_parser_b = elf_et_rel();
    if elf64_header_parser_a != elf64_header_parser_b {
        println("FAIL elf64_header_parser");
        process_exit(1);
    }
    println("prod_ap_elf64_header_parser: PASSED");
}
