// # Product prove std/astro_advanced/interplanetary_porkchop_plot.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/interplanetary_porkchop_plot.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/interplanetary_porkchop_plot.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_interplanetary_porkchop_plot: PASSED only if they match.

import "std/astro_advanced/interplanetary_porkchop_plot.oo";

pub fn main() {
    let interplanetary_porkchop_plot_a = porkchop_c3();
    let interplanetary_porkchop_plot_b = porkchop_c3();
    if interplanetary_porkchop_plot_a != interplanetary_porkchop_plot_b {
        println("FAIL interplanetary_porkchop_plot");
        process_exit(1);
    }
    println("prod_ap_interplanetary_porkchop_plot: PASSED");
}
