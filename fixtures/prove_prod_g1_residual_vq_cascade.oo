// # Product prove std/ai_multimodal/residual_vq_cascade.oo
//
// Logline: Fail-closed emit+gcc+run asserts rvq_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/residual_vq_cascade.oo.
//
// Beats:
//   1. Call rvq_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_residual_vq_cascade: PASSED only if they match.

import "std/ai_multimodal/residual_vq_cascade.oo";

pub fn main() {
    let a: RVQConfig = rvq_config_new(0, 0, 0);
    let b: RVQConfig = rvq_config_new(0, 0, 0);
    if a.num_quantizers != b.num_quantizers {
        println("FAIL rvq_config_new");
        process_exit(1);
    }
    println("prod_residual_vq_cascade: PASSED");
}
