// # Product prove std/fintech_defi/hft_tick_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_tick_compressor_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_tick_compressor.oo.
//
// Beats:
//   1. Call hft_tick_compressor_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_tick_compressor: PASSED only if they match.

import "std/fintech_defi/hft_tick_compressor.oo";

pub fn main() {
    let hft_tick_compressor_mark: Int = 0;
    if hft_tick_compressor_mark != 0 {
        process_exit(1);
    }
    let hft_tick_compressor_a: Int = hft_tick_compressor_probe();
    let hft_tick_compressor_b: Int = hft_tick_compressor_probe();
    if hft_tick_compressor_a != hft_tick_compressor_b {
        println("FAIL hft_tick_compressor_probe");
        process_exit(1);
    }
    println("prod_hft_tick_compressor: PASSED");
}
