// # Product prove std/compilers/disasm_x86.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/disasm_x86.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/disasm_x86.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_disasm_x86: PASSED only if they match.

import "std/compilers/disasm_x86.oo";

pub fn main() {
    let disasm_x86_a = x86_reg_id(0);
    let disasm_x86_b = x86_reg_id(0);
    if disasm_x86_a != disasm_x86_b {
        println("FAIL disasm_x86");
        process_exit(1);
    }
    println("prod_ap_disasm_x86: PASSED");
}
