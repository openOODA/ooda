// # Product prove std/satellite_dvb/isl_intersatellite_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts isl_calc_intra_plane_distance_km is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_intersatellite_routing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call isl_calc_intra_plane_distance_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isl_intersatellite_routing: PASSED only if they match.

import "std/satellite_dvb/isl_intersatellite_routing.oo";

pub fn main() {
    let g2_a = isl_calc_intra_plane_distance_km(1.0, 2);
    let g2_b = isl_calc_intra_plane_distance_km(1.0, 2);
    if g2_a != g2_b {
        println("FAIL isl_calc_intra_plane_distance_km");
        process_exit(1);
    }
    println("prod_g2_isl_intersatellite_routing: PASSED");
}
