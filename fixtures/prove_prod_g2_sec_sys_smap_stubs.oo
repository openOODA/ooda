// # Product prove std/sec/sys/smap_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts smap_stubs_init is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/sys/smap_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call smap_stubs_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_smap_stubs: PASSED only if they match.

import "std/sec/sys/smap_stubs.oo";

pub fn main() {
    let g2_oa = smap_stubs_init();
    let g2_ob = smap_stubs_init();
    let g2_a = (g2_oa).violation_count;
    let g2_b = (g2_ob).violation_count;
    if g2_a != g2_b {
        println("FAIL smap_stubs_init.violation_count");
        process_exit(1);
    }
    println("prod_g2_smap_stubs: PASSED");
}
