// # Product prove std/tda_topology/circular_coordinates_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts wrap_to_2pi is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/circular_coordinates_tda.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wrap_to_2pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_circular_coordinates_tda: PASSED only if they match.

import "std/tda_topology/circular_coordinates_tda.oo";

pub fn main() {
    let g0_a = wrap_to_2pi(0.0);
    let g0_b = wrap_to_2pi(0.0);
    if g0_a != g0_b {
        println("FAIL wrap_to_2pi");
        process_exit(1);
    }
    println("prod_gr_circular_coordinates_tda: PASSED");
}
