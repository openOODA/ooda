// # Browser WASI hello for moonshot WAT host
//
// Logline: Print Hello, browser! so browser WAT can plant env.print_str and _start with data string bytes.
// Setup: No imports. One public main. Body is only println of the browser literal.
// Beats:
//   1. Declare public main.
//   2. Print Hello, browser!.
//   3. Leave no other statements so browser picks can see print-only body.

pub fn main() { println("Hello, browser!"); }
