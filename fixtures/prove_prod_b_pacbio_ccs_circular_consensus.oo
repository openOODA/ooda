// # Product prove std/genomics_advanced/pacbio_ccs_circular_consensus.oo
//
// Logline: Fail-closed emit+gcc+run asserts pacbio_ccs_circular_consensus_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/pacbio_ccs_circular_consensus.oo.
//
// Beats:
//   1. Call pacbio_ccs_circular_consensus_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pacbio_ccs_circular_consensus: PASSED only if they match.

import "std/genomics_advanced/pacbio_ccs_circular_consensus.oo";

pub fn main() {
    let a = pacbio_ccs_circular_consensus_probe();
    let b = pacbio_ccs_circular_consensus_probe();
    if a != b {
        println("FAIL pacbio_ccs_circular_consensus_probe");
        process_exit(1);
    }
    println("prod_pacbio_ccs_circular_consensus: PASSED");
}
