// # Const integer div println
//
// Logline: Print 8 / 2 so emit-wasm can plant a WASI fd_write body of 4.
//
// Setup: No imports. One public main. The body is only println of two INT literals slash.
//
// Beats:
//   1. Declare public main.
//   2. Print 8 / 2.
//   3. Leave no other statements.

pub fn main() { println(8 / 2); }
