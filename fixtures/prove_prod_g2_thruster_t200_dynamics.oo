// # Product prove std/robotics_auv/thruster_t200_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts t200_clamp_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/thruster_t200_dynamics.oo.
//
// Beats:
//   1. Call t200_clamp_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thruster_t200_dynamics: PASSED only if they match.

import "std/robotics_auv/thruster_t200_dynamics.oo";

pub fn main() {
    let thruster_t200_dynamics_mark: Int = 0;
    if thruster_t200_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Int = t200_clamp_int(0, 0, 0);
    let b: Int = t200_clamp_int(0, 0, 0);
    if a != b {
        println("FAIL t200_clamp_int");
        process_exit(1);
    }
    println("prod_g2_thruster_t200_dynamics: PASSED");
}
