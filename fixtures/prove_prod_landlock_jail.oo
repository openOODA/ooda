// # Product prove std/os/landlock_jail.oo
//
// Logline: Fail-closed emit+gcc+run asserts jail_read_path_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/landlock_jail.oo.
//
// Beats:
//   1. Call jail_read_path_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_landlock_jail: PASSED only if they match.

import "std/os/landlock_jail.oo";

pub fn main() {
    let obj = jail_new();
    let a = jail_read_path_count(obj);
    let b = jail_read_path_count(obj);
    if a != b {
        println("FAIL jail_read_path_count");
        process_exit(1);
    }
    println("prod_landlock_jail: PASSED");
}
