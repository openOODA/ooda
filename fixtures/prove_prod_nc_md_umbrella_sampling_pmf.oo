// # Product prove std/protein_folding/md_umbrella_sampling_pmf.oo
//
// Logline: Fail-closed emit+gcc+run asserts md_umbrella_sampling_pmf_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_umbrella_sampling_pmf.oo.
//
// Beats:
//   1. Call md_umbrella_sampling_pmf_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_md_umbrella_sampling_pmf: PASSED only if it matches.

import "std/protein_folding/md_umbrella_sampling_pmf.oo";

pub fn main() {
    let a: Int = md_umbrella_sampling_pmf_probe();
    if a != 0 {
        println("FAIL md_umbrella_sampling_pmf_probe");
        process_exit(1);
    }
    println("prod_nc_md_umbrella_sampling_pmf: PASSED");
}
