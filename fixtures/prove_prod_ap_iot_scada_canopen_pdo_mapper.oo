// # Product prove std/iot_scada/canopen_pdo_mapper.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/canopen_pdo_mapper.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/iot_scada/canopen_pdo_mapper.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_canopen_pdo_mapper: PASSED only if they match.

import "std/iot_scada/canopen_pdo_mapper.oo";

pub fn main() {
    let canopen_pdo_mapper_a = canopen_tpdo1_default(0);
    let canopen_pdo_mapper_b = canopen_tpdo1_default(0);
    if canopen_pdo_mapper_a.cob_id != canopen_pdo_mapper_b.cob_id {
        println("FAIL canopen_pdo_mapper");
        process_exit(1);
    }
    println("prod_ap_canopen_pdo_mapper: PASSED");
}
