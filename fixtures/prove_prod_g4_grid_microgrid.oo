// # Product prove std/grid/microgrid.oo
//
// Logline: Fail-closed emit+gcc+run asserts microgrid islanding and droop control operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid.oo.
//
// Beats:
//   1. Initialize default islanding status, droop control, and microgrid state.
//   2. Detect mains voltage and frequency threshold violations.
//   3. Assert deterministic islanding state transitions.
//   4. Print prod_g4_grid_microgrid: PASSED and exit 0.

import "std/grid/microgrid.oo";

pub fn main() {
    let isl1: IslandingStatus = shim_marker_islanding_default();
    let isl2: IslandingStatus = shim_marker_islanding_default();
    if (isl1).grid_connected != (isl2).grid_connected || (isl1).grid_connected != true {
        println("FAIL shim_marker_islanding_default");
        process_exit(1);
    }

    let droop: DroopControl = shim_marker_droop_default();
    if (droop).p_nominal_kw != 500.0 {
        println("FAIL shim_marker_droop_default");
        process_exit(1);
    }

    let grp: LoadPriorityGroup = shim_marker_load_group_new();
    if (grp).priority != 3 || (grp).total_load_kw != 150.0 {
        println("FAIL shim_marker_load_group_new");
        process_exit(1);
    }

    let fault1: IslandingStatus = shim_marker_detect_mains(isl1, 0.80, 60.0);
    let fault2: IslandingStatus = shim_marker_detect_mains(isl2, 0.80, 60.0);
    if (fault1).status_code != (fault2).status_code || (fault1).status_code != 1 {
        println("FAIL shim_marker_detect_mains");
        process_exit(1);
    }

    let mg: MicrogridState = shim_marker_microgrid_default();
    if (mg).total_generation_kw != 1000.0 {
        println("FAIL shim_marker_microgrid_default");
        process_exit(1);
    }

    println("prod_g4_grid_microgrid: PASSED");
    process_exit(0);
}
