// # Product prove std/space_propulsion/resistojet_electrothermal.oo
//
// Logline: Fail-closed emit+gcc+run asserts resistojet_spec_default_ammonia is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/resistojet_electrothermal.oo.
//
// Beats:
//   1. Call resistojet_spec_default_ammonia twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_resistojet_electrothermal: PASSED only if they match.

import "std/space_propulsion/resistojet_electrothermal.oo";

pub fn main() {
    let resistojet_electrothermal_mark: Int = 0;
    if resistojet_electrothermal_mark != 0 {
        process_exit(1);
    }
    let a: ResistojetSpec = resistojet_spec_default_ammonia();
    let b: ResistojetSpec = resistojet_spec_default_ammonia();
    if (a).propellant_type != (b).propellant_type {
        println("FAIL resistojet_spec_default_ammonia");
        process_exit(1);
    }
    println("prod_resistojet_electrothermal: PASSED");
}
