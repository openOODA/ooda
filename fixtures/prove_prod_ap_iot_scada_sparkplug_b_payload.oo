// # Product prove std/iot_scada/sparkplug_b_payload.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/sparkplug_b_payload.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/sparkplug_b_payload.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sparkplug_b_payload: PASSED only if they match.

import "std/iot_scada/sparkplug_b_payload.oo";

pub fn main() {
    let sparkplug_b_payload_a = sparkplug_next_seq(0);
    let sparkplug_b_payload_b = sparkplug_next_seq(0);
    if sparkplug_b_payload_a != sparkplug_b_payload_b {
        println("FAIL sparkplug_b_payload");
        process_exit(1);
    }
    println("prod_ap_sparkplug_b_payload: PASSED");
}
