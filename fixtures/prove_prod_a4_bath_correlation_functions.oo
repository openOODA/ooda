// # Product prove std/quantum_open_systems/bath_correlation_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts bath_thermal_correlation_time is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/bath_correlation_functions.oo.
//
// Beats:
//   1. Call bath_thermal_correlation_time twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bath_correlation_functions: PASSED only if they match.

import "std/quantum_open_systems/bath_correlation_functions.oo";

pub fn main() {
    let bath_correlation_functions_mark: Int = 0;
    if bath_correlation_functions_mark != 0 {
        process_exit(1);
    }
    let a: Float = bath_thermal_correlation_time(0.0);
    let b: Float = bath_thermal_correlation_time(0.0);
    if a != b {
        println("FAIL bath_thermal_correlation_time");
        process_exit(1);
    }
    println("prod_bath_correlation_functions: PASSED");
}
