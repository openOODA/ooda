import "std/sync/lockfree_stack.oo";

pub fn main() {
    let s: LockfreeStack = lockfree_stack_new();
    let n: Int = lockfree_stack_len(s);
    if n != 0 {
        println("FAIL lfstack 0");
        process_exit(1);
    }
    println("prod_lfstack: PASSED");
}
