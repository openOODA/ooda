// # End a Sock Closed
//
// Logline: Open, connect, and close so the Sock ends Closed as required.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Require end Closed.
//   2. Open, connect, then close.
//   3. Leave main with no later use.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE end Closed
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn close_sock: Open -> Closed

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn close_sock(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    connect(s);
    close_sock(s);
}
