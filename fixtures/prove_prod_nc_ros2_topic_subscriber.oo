// # Product prove std/robotics_ros2/ros2_topic_subscriber.oo
//
// Logline: Fail-closed emit+gcc+run asserts ros2_topic_subscriber_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_topic_subscriber.oo.
//
// Beats:
//   1. Call ros2_topic_subscriber_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ros2_topic_subscriber: PASSED only if it matches.

import "std/robotics_ros2/ros2_topic_subscriber.oo";

pub fn main() {
    let a: Int = ros2_topic_subscriber_probe();
    if a != 0 {
        println("FAIL ros2_topic_subscriber_probe");
        process_exit(1);
    }
    println("prod_nc_ros2_topic_subscriber: PASSED");
}
