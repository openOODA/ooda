// # Product prove std/lidar_perception/l_shape_box_fitter.oo
//
// Logline: Fail-closed emit+check asserts eval_area_criterion is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/l_shape_box_fitter.oo.
//
// Beats:
//   1. Call eval_area_criterion twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l_shape_box_fitter: PASSED only if they match.

import "std/lidar_perception/l_shape_box_fitter.oo";

pub fn main() {
    let l_shape_box_fitter_mark: Int = 0;
    if l_shape_box_fitter_mark != 0 { process_exit(1); }
    let a: Float = eval_area_criterion(0.0, 1.0, 0.0, 1.0);
    let b: Float = eval_area_criterion(0.0, 1.0, 0.0, 1.0);
    if a != b { process_exit(1); }
    println("prod_l_shape_box_fitter: PASSED");
}
