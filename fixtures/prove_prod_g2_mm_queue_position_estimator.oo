// # Product prove std/hft_alpha/mm_queue_position_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts queue_tracker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_queue_position_estimator.oo.
//
// Beats:
//   1. Call queue_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_queue_position_estimator: PASSED only if they match.

import "std/hft_alpha/mm_queue_position_estimator.oo";

pub fn main() {
    let mm_queue_position_estimator_mark: Int = 0;
    if mm_queue_position_estimator_mark != 0 {
        process_exit(1);
    }
    let a: QueueTrackerState = queue_tracker_new("x", 0.0, 0.0, 0.0, 0.0);
    let b: QueueTrackerState = queue_tracker_new("x", 0.0, 0.0, 0.0, 0.0);
    if (a).is_at_head_of_queue != (b).is_at_head_of_queue {
        println("FAIL queue_tracker_new");
        process_exit(1);
    }
    println("prod_g2_mm_queue_position_estimator: PASSED");
}
