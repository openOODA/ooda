// # Product prove std/gis_topo/proj_web_mercator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mercator_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_web_mercator.oo.
//
// Beats:
//   1. Call mercator_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_proj_web_mercator: PASSED only if they match.

import "std/gis_topo/proj_web_mercator.oo";

pub fn main() {
    let a: MercatorPoint = mercator_point_new(0.0, 0.0);
    let b: MercatorPoint = mercator_point_new(0.0, 0.0);
    if a.x != b.x {
        println("FAIL mercator_point_new");
        process_exit(1);
    }
    println("prod_proj_web_mercator: PASSED");
}
