// # Product prove std/physics_advanced/compressible_shock_wave.oo
//
// Logline: Fail-closed emit+gcc+run asserts oblique_shock_deflection_theta is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_shock_wave.oo.
//
// Beats:
//   1. Call oblique_shock_deflection_theta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compressible_shock_wave: PASSED only if they match.

import "std/physics_advanced/compressible_shock_wave.oo";

pub fn main() {
    let compressible_shock_wave_mark: Int = 0;
    if compressible_shock_wave_mark != 0 {
        process_exit(1);
    }
    let a: Float = oblique_shock_deflection_theta(0.0, 0.0, 0.0);
    let b: Float = oblique_shock_deflection_theta(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL oblique_shock_deflection_theta");
        process_exit(1);
    }
    println("prod_compressible_shock_wave: PASSED");
}
