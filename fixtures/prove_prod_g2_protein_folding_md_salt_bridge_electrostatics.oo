// # Product prove std/protein_folding/md_salt_bridge_electrostatics.oo
//
// Logline: Fail-closed emit+gcc+run asserts salt_bridge_screened_coulomb is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_salt_bridge_electrostatics.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call salt_bridge_screened_coulomb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_salt_bridge_electrostatics: PASSED only if they match.

import "std/protein_folding/md_salt_bridge_electrostatics.oo";

pub fn main() {
    let g2_a = salt_bridge_screened_coulomb(1.0, 1.0);
    let g2_b = salt_bridge_screened_coulomb(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL salt_bridge_screened_coulomb");
        process_exit(1);
    }
    println("prod_g2_md_salt_bridge_electrostatics: PASSED");
}
