// # emit-x86 const-int remainder
//
// Logline: Print 7 remainder 2 so emit-x86 can lower a const-int rem to 1.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Print 7 remainder 2.
//   3. as+ld stdout is 1, not 72.
//
// residual: SysV stays later.

pub fn main() {
    println(7 % 2);
}
