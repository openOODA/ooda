// # Product prove std/graph_networks/zigbee_cluster_tree_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts zigbee_calc_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/zigbee_cluster_tree_routing.oo.
//
// Beats:
//   1. Call zigbee_calc_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zigbee_cluster_tree_routing: PASSED only if they match.

import "std/graph_networks/zigbee_cluster_tree_routing.oo";

pub fn main() {
    let a: Int = zigbee_calc_pow(0, 0);
    let b: Int = zigbee_calc_pow(0, 0);
    if a != b {
        println("FAIL zigbee_calc_pow");
        process_exit(1);
    }
    println("prod_zigbee_cluster_tree_routing: PASSED");
}
