// # Allow public sys_exec argv
//
// Logline: Call sys_exec with a public literal while a secret name sits unused.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call sys_exec with literal "true".
//   3. Print 1 after the call.
//
// M135: non-secret argv may sys_exec (emit path)
// SECRET: token
pub fn main(sys: &SysCap) {
    let token = "s3cret-payload";
    let r = sys_exec(sys, "sh", "-c", "true");
    println(1);
}
