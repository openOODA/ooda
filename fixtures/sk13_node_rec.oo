// # Recursive List[Node] pool hang probe
//
// Logline: Node with kids: List[Node] must not hang emit-c (timeout 20).
//
// Setup: Isolated emit-c. Hostile hang probe. Not a destub of std.
//
// Beats:
//   1. Define Node with Int, String, and List[Node].
//   2. Build a one-child pool.
//   3. Print PASSED if emit+run finish.

type Node = struct {
    id: Int,
    tag: String,
    kids: List[Node]
};

pub fn main() {
    let mut kids: List[Node] = list_new();
    let leaf: Node = Node { id: 2, tag: "leaf", kids: kids };
    let mut ks: List[Node] = list_new();
    ks = list_push(ks, leaf);
    let root: Node = Node { id: 1, tag: "root", kids: ks };
    if root.id != 1 {
        println("FAIL root");
        process_exit(1);
    }
    if list_len(root.kids) != 1 {
        println("FAIL kids");
        process_exit(1);
    }
    println("sk13_node_rec: PASSED");
}
