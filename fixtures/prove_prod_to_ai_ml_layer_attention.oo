// # Product prove std/ai_ml/layer_attention.oo
//
// Logline: Fail-closed emit+gcc+run asserts attention_config_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_attention.oo.
//
// Beats:
//   1. Call attention_config_new using the layer_attention ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_layer_attention: PASSED only if asserts hold.

import "std/ai_ml/layer_attention.oo";

pub fn main() {
    let obj = attention_config_new(8, 8, true);
    let layer_attention_a = obj.embed_dim;
    if layer_attention_a != 8 {
        println("FAIL attention_config_new");
        process_exit(1);
    }
    println("prod_layer_attention: PASSED");
}
