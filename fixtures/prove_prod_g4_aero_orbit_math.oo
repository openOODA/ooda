// # Product prove std/aero/orbit_math.oo
//
// Logline: Fail-closed verification that orbital math trigonometry and angular normalization are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_math.oo.
//
// Beats:
//   1. Call math_pi and math_two_pi constants.
//   2. Evaluate math_abs, math_normalize_angle, math_atan2, and math_acos.
//   3. Assert deterministic results.
//   4. Print prod_g4_aero_orbit_math: PASSED only if all match.

import "std/aero/orbit_math.oo";

pub fn main() {
    let pi1: Float = math_pi();
    let pi2: Float = math_pi();
    if pi1 != pi2 || pi1 < 3.14 || pi1 > 3.15 {
        println("FAIL math_pi");
        process_exit(1);
    }

    let two_pi: Float = math_two_pi();
    if two_pi < 6.28 || two_pi > 6.29 {
        println("FAIL math_two_pi");
        process_exit(1);
    }

    let abs_val: Float = math_abs(0.0 - 5.5);
    if abs_val != 5.5 {
        println("FAIL math_abs");
        process_exit(1);
    }

    let norm_ang: Float = math_normalize_angle(two_pi + 1.0);
    if norm_ang < 0.99 || norm_ang > 1.01 {
        println("FAIL math_normalize_angle");
        process_exit(1);
    }

    let at2: Float = math_atan2(0.0, 1.0);
    if at2 != 0.0 {
        println("FAIL math_atan2");
        process_exit(1);
    }

    let ac: Float = math_acos(1.0);
    if ac != 0.0 {
        println("FAIL math_acos");
        process_exit(1);
    }

    println("prod_g4_aero_orbit_math: PASSED");
    process_exit(0);
}
