// # Product prove std/quantum_tensor_nets/entanglement_negativity_mps.oo
//
// Logline: Fail-closed emit+gcc+run asserts partial_transpose_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/entanglement_negativity_mps.oo.
//
// Beats:
//   1. Call partial_transpose_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_entanglement_negativity_mps: PASSED only if they match.

import "std/quantum_tensor_nets/entanglement_negativity_mps.oo";

pub fn main() {
    let entanglement_negativity_mps_mark: Int = 0;
    if entanglement_negativity_mps_mark != 0 {
        process_exit(1);
    }
    let a: PartialTransposeConfig = partial_transpose_config_default();
    let b: PartialTransposeConfig = partial_transpose_config_default();
    if (a).max_transfer_bond != (b).max_transfer_bond {
        println("FAIL partial_transpose_config_default");
        process_exit(1);
    }
    println("prod_g2_entanglement_negativity_mps: PASSED");
}
