// # Product prove std/sec/crypto/rsa_pss_params.oo
//
// Logline: Fail-closed emit+gcc+run asserts rsa_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/rsa_pss_params.oo.
//
// Beats:
//   1. Call rsa_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rsa_pss_params: PASSED only if they match.

import "std/sec/crypto/rsa_pss_params.oo";

pub fn main() {
    let a = rsa_checksum("x");
    let b = rsa_checksum("x");
    if a != b {
        println("FAIL rsa_checksum");
        process_exit(1);
    }
    println("prod_rsa_pss_params: PASSED");
}
