// # Product prove std/web_ecosystem/qs_query_string.oo
//
// Logline: Fail-closed emit+gcc+run asserts qs_pair_n is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/qs_query_string.oo.
//
// Beats:
//   1. Call qs_pair_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qs_query_string: PASSED only if they match.

import "std/web_ecosystem/qs_query_string.oo";

pub fn main() {
    let qs_query_string_mark: Int = 0;
    if qs_query_string_mark != 0 {
        process_exit(1);
    }
    let qs_query_string_a: Int = qs_pair_n(1, 1);
    let qs_query_string_b: Int = qs_pair_n(1, 1);
    if qs_query_string_a != qs_query_string_b {
        println("FAIL qs_pair_n");
        process_exit(1);
    }
    println("prod_qs_query_string: PASSED");
}
