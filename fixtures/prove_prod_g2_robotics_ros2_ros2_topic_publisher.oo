// # Product prove std/robotics_ros2/ros2_topic_publisher.oo
//
// Logline: Fail-closed emit+gcc+run asserts topic_qos_default is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_topic_publisher.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call topic_qos_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ros2_topic_publisher: PASSED only if they match.

import "std/robotics_ros2/ros2_topic_publisher.oo";

pub fn main() {
    let g2_oa: TopicQos = topic_qos_default();
    let g2_ob: TopicQos = topic_qos_default();
    let g2_a = (g2_oa).reliability;
    let g2_b = (g2_ob).reliability;
    if g2_a != g2_b {
        println("FAIL topic_qos_default.reliability");
        process_exit(1);
    }
    println("prod_g2_ros2_topic_publisher: PASSED");
}
