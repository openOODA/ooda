// # Product sync futex word prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/futex.oo.
//
// Setup: Product std/sync/futex.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(100, 7) addr 100 val 7 waiters 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/futex.oo";

pub fn main() {
    let fw: FutexWord = futex_new(100, 7);
    let a: Int = futex_addr(fw);
    if a != 100 {
        println("FAIL futex addr");
        process_exit(1);
    }
    let v: Int = futex_val(fw);
    if v != 7 {
        println("FAIL futex val");
        process_exit(1);
    }
    let w: Int = futex_waiters(fw);
    if w != 0 {
        println("FAIL futex waiters");
        process_exit(1);
    }
    println("prod_futexv: PASSED");
}
