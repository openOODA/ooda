// # Product prove std/net/socket_opts.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net/socket_opts.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/socket_opts.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_socket_opts: PASSED only if they match.

import "std/net/socket_opts.oo";

pub fn main() {
    let socket_opts_a = socket_opts_default();
    let socket_opts_b = socket_opts_default();
    let socket_opts_va = socket_opts_format(socket_opts_a);
    let socket_opts_vb = socket_opts_format(socket_opts_b);
    if socket_opts_va.contains(socket_opts_vb) == false {
        println("FAIL socket_opts");
        process_exit(1);
    }
    if socket_opts_vb.contains(socket_opts_va) == false {
        println("FAIL socket_opts");
        process_exit(1);
    }
    println("prod_ap_socket_opts: PASSED");
}
