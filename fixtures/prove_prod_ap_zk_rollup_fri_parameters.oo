// # Product prove std/zk_rollup/fri_parameters.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/fri_parameters.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_parameters.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_fri_parameters: PASSED only if they match.

import "std/zk_rollup/fri_parameters.oo";

pub fn main() {
    let fri_parameters_a = fri_parameters_100_bits(0);
    let fri_parameters_b = fri_parameters_100_bits(0);
    if fri_parameters_a.blowup_factor != fri_parameters_b.blowup_factor {
        println("FAIL fri_parameters");
        process_exit(1);
    }
    println("prod_ap_fri_parameters: PASSED");
}
