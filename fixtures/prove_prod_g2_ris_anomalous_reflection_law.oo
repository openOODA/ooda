// # Product prove std/telecom_6g/ris_anomalous_reflection_law.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_asin_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_anomalous_reflection_law.oo.
//
// Beats:
//   1. Call ris_asin_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ris_anomalous_reflection_law: PASSED only if they match.

import "std/telecom_6g/ris_anomalous_reflection_law.oo";

pub fn main() {
    let ris_anomalous_reflection_law_mark: Int = 0;
    if ris_anomalous_reflection_law_mark != 0 {
        process_exit(1);
    }
    let a: Float = ris_asin_approx(0.0);
    let b: Float = ris_asin_approx(0.0);
    if a != b {
        println("FAIL ris_asin_approx");
        process_exit(1);
    }
    println("prod_g2_ris_anomalous_reflection_law: PASSED");
}
