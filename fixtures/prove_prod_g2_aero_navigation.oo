// # Product prove std/aero/navigation.oo
//
// Logline: Fail-closed emit+gcc+run asserts navigation_fix_lat is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/navigation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call navigation_fix_lat twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_navigation: PASSED only if they match.

import "std/aero/navigation.oo";

pub fn main() {
    let g2_oa = navigation_fix_new(2, 2);
    let g2_ob = navigation_fix_new(2, 2);
    let g2_a = navigation_fix_lat(g2_oa);
    let g2_b = navigation_fix_lat(g2_ob);
    if g2_a != g2_b {
        println("FAIL navigation_fix_lat");
        process_exit(1);
    }
    println("prod_g2_navigation: PASSED");
}
