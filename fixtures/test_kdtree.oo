// # k-d tree adversarial suite
//
// Logline: Builds a k-d tree, matches nearest-neighbor distance against a brute-force scan, and bounds depth on clustered points.
//
// Setup: Pure. Imports kdtree_spatial modules. Run from ooda/.
//
// Beats:
//   1. Index scattered 2D points and query a neighbor.
//   2. Compare tree distance to an exhaustive linear scan.
//   3. Build a clustered set and require depth inside 32.

import "std/gis_spatial/kdtree_spatial.oo";

fn brute(coords: List[Float], k: Int, n: Int, q: List[Float]) -> Float {
    let mut best: Float = 1000000000.0;
    let mut i: Int = 0;
    while i < n {
        let d2: Float = kd_dist2(coords, k, i, q);
        if d2 < best {
            best = d2;
        }
        i = i + 1;
    }
    return best;
}

pub fn main() {
    let mut coords: List[Float] = list_new();
    coords = list_push(coords, 0.0);
    coords = list_push(coords, 0.0);
    coords = list_push(coords, 1.0);
    coords = list_push(coords, 0.0);
    coords = list_push(coords, 0.0);
    coords = list_push(coords, 1.0);
    coords = list_push(coords, 5.0);
    coords = list_push(coords, 5.0);
    coords = list_push(coords, 2.0);
    coords = list_push(coords, 3.0);
    let tree: KdTree = kdtree_spatial_build(coords, 2);
    let mut q: List[Float] = list_new();
    q = list_push(q, 1.1);
    q = list_push(q, 0.2);
    let ni: Result[Int, String] = kdtree_spatial_nn(tree, q);
    if ni.is_err() {
        println("FAIL nn");
        process_exit(1);
    }
    let td: Float = kdtree_spatial_nn_dist(tree, q);
    let bd: Float = brute(coords, 2, 5, q);
    let mut diff: Float = td - bd;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff > 0.0000001 {
        println("FAIL nn vs brute");
        process_exit(1);
    }
    println("NN distance equals brute-force scan");

    let mut cl: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 20 {
        cl = list_push(cl, 3.0);
        cl = list_push(cl, 4.0);
        i = i + 1;
    }
    let ct: KdTree = kdtree_spatial_build(cl, 2);
    if kdtree_spatial_depth(ct) > 32 {
        println("FAIL clustered depth");
        process_exit(1);
    }
    println("depth stays inside the stated bound on a clustered set");
    println("SUITE PASSED");
    println("test_kdtree: PASSED");
}
