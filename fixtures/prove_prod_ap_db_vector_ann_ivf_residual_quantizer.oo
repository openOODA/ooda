// # Product prove std/db_vector_ann/ivf_residual_quantizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/ivf_residual_quantizer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/ivf_residual_quantizer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_ivf_residual_quantizer: PASSED only if they match.

import "std/db_vector_ann/ivf_residual_quantizer.oo";

pub fn main() {
    let ivf_residual_quantizer_a = residual_config_default(0);
    let ivf_residual_quantizer_b = residual_config_default(0);
    if ivf_residual_quantizer_a.dimension != ivf_residual_quantizer_b.dimension {
        println("FAIL ivf_residual_quantizer");
        process_exit(1);
    }
    println("prod_ap_ivf_residual_quantizer: PASSED");
}
