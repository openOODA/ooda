// # Product prove std/auto/orca_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts orca_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_engine.oo.
//
// Beats:
//   1. Call orca_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orca_engine: PASSED only if they match.

import "std/auto/orca_engine.oo";

pub fn main() {
    let orca_engine_mark: Int = 0;
    if orca_engine_mark != 0 {
        process_exit(1);
    }
    let a: OrcaEng = orca_eng_new(0, 0);
    let b: OrcaEng = orca_eng_new(0, 0);
    if (a).dt_ms != (b).dt_ms {
        println("FAIL orca_eng_new");
        process_exit(1);
    }
    println("prod_orca_engine: PASSED");
}
