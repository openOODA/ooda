// # Product prove std/defi_derivatives/options_calendar_spread.oo
//
// Logline: Fail-closed emit+gcc+run asserts cal_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_calendar_spread.oo.
//
// Beats:
//   1. Call cal_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_options_calendar_spread: PASSED only if they match.

import "std/defi_derivatives/options_calendar_spread.oo";

pub fn main() {
    let options_calendar_spread_mark: Int = 0;
    if options_calendar_spread_mark != 0 {
        process_exit(1);
    }
    let a: Float = cal_norm_pdf(0.0);
    let b: Float = cal_norm_pdf(0.0);
    if a != b {
        println("FAIL cal_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_options_calendar_spread: PASSED");
}
