// # Product prove std/physics_advanced/ragdoll_joint_cone_twist.oo
//
// Logline: Fail-closed emit+gcc+run asserts cone_twist_shoulder_joint is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/ragdoll_joint_cone_twist.oo.
//
// Beats:
//   1. Call cone_twist_shoulder_joint twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ragdoll_joint_cone_twist: PASSED only if they match.

import "std/physics_advanced/ragdoll_joint_cone_twist.oo";

pub fn main() {
    let ragdoll_joint_cone_twist_mark: Int = 0;
    if ragdoll_joint_cone_twist_mark != 0 {
        process_exit(1);
    }
    let a: ConeTwistJoint = cone_twist_shoulder_joint();
    let b: ConeTwistJoint = cone_twist_shoulder_joint();
    if (a).swing_span_1_rad != (b).swing_span_1_rad {
        println("FAIL cone_twist_shoulder_joint");
        process_exit(1);
    }
    println("prod_ragdoll_joint_cone_twist: PASSED");
}
