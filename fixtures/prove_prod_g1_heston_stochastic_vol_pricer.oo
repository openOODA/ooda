// # Product prove std/defi_derivatives/heston_stochastic_vol_pricer.oo
//
// Logline: Fail-closed emit+gcc+run asserts heston_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/heston_stochastic_vol_pricer.oo.
//
// Beats:
//   1. Call heston_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heston_stochastic_vol_pricer: PASSED only if they match.

import "std/defi_derivatives/heston_stochastic_vol_pricer.oo";

pub fn main() {
    let a: HestonParameters = heston_params_default();
    let b: HestonParameters = heston_params_default();
    if a.v0 != b.v0 {
        println("FAIL heston_params_default");
        process_exit(1);
    }
    println("prod_heston_stochastic_vol_pricer: PASSED");
}
