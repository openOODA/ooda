// # Product prove std/db_vector_ann/vector_cosine_similarity.oo
//
// Logline: Fail-closed emit+gcc+run asserts isqrt_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_cosine_similarity.oo.
//
// Beats:
//   1. Call isqrt_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_cosine_similarity: PASSED only if they match.

import "std/db_vector_ann/vector_cosine_similarity.oo";

pub fn main() {
    let vector_cosine_similarity_mark: Int = 0;
    if vector_cosine_similarity_mark != 0 {
        process_exit(1);
    }
    let a: Int = isqrt_approx(0);
    let b: Int = isqrt_approx(0);
    if a != b {
        println("FAIL isqrt_approx");
        process_exit(1);
    }
    println("prod_vector_cosine_similarity: PASSED");
}
