// # Product TSV escape/unescape prove
//
// Logline: Fail-closed emit+gcc+run of shipped tsv_escape_field and tsv_unescape_field.
//
// Setup: Product std/encoding/tsv.oo. Tab and backslash. Destub none.
//
// Beats:
//   1. tsv_escape_field of a string with no tab is itself.
//   2. tsv_unescape_field of that escaped value is the original.
//   3. Tab becomes \\t; backslash becomes \\\\. Unescape recovers both.
//   4. Exit 1 before PASSED on a miss.

import "std/encoding/tsv.oo";

pub fn main() {
    let plain: String = tsv_escape_field("hello");
    if plain != "hello" {
        println("FAIL tsv plain");
        process_exit(1);
    }
    let plain_back: String = tsv_unescape_field(plain);
    if plain_back != "hello" {
        println("FAIL tsv unescape plain");
        process_exit(1);
    }
    let with_tab: String = "a\tb";
    let esc_tab: String = tsv_escape_field(with_tab);
    if esc_tab != "a\\tb" {
        println("FAIL tsv escape tab");
        process_exit(1);
    }
    let un_tab: String = tsv_unescape_field(esc_tab);
    if un_tab != with_tab {
        println("FAIL tsv unescape tab");
        process_exit(1);
    }
    let with_bs: String = "a\\b";
    let esc_bs: String = tsv_escape_field(with_bs);
    if esc_bs != "a\\\\b" {
        println("FAIL tsv escape backslash");
        process_exit(1);
    }
    let un_bs: String = tsv_unescape_field(esc_bs);
    if un_bs != with_bs {
        println("FAIL tsv unescape backslash");
        process_exit(1);
    }
    let n: Int = tsv_field_count("a\tb\tc");
    if n != 3 {
        println("FAIL tsv count");
        process_exit(1);
    }
    let mid: String = tsv_nth_field("a\tb\tc", 1);
    if mid != "b" {
        println("FAIL tsv nth");
        process_exit(1);
    }
    println("prod_tsv: PASSED");
}
