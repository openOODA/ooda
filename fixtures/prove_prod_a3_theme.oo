// # Product prove std/gui/theme.oo
//
// Logline: Fail-closed emit+gcc+run asserts theme_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/theme.oo.
//
// Beats:
//   1. Call theme_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_theme: PASSED only if they match.

import "std/gui/theme.oo";

pub fn main() {
    let a: Theme = theme_new(0, 0, 0, 0, 0, 0, true);
    let b: Theme = theme_new(0, 0, 0, 0, 0, 0, true);
    if (a).bg_color != (b).bg_color {
        println("FAIL theme_new");
        process_exit(1);
    }
    println("prod_theme: PASSED");
}
