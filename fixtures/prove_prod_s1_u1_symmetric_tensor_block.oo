// # Product prove std/quantum_tensor_nets/u1_symmetric_tensor_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts u1_tensor_block_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/u1_symmetric_tensor_block.oo.
//
// Beats:
//   1. Call u1_tensor_block_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_u1_symmetric_tensor_block: PASSED only if they match.

import "std/quantum_tensor_nets/u1_symmetric_tensor_block.oo";

pub fn main() {
    let u1_symmetric_tensor_block_mark: Int = 0;
    if u1_symmetric_tensor_block_mark != 0 {
        process_exit(1);
    }
    let u1_symmetric_tensor_block_a = u1_tensor_block_new(1, 1, 1, 1);
    let u1_symmetric_tensor_block_b = u1_tensor_block_new(1, 1, 1, 1);
    if (u1_symmetric_tensor_block_a).q_in != (u1_symmetric_tensor_block_b).q_in {
        println("FAIL u1_tensor_block_new");
        process_exit(1);
    }
    println("prod_u1_symmetric_tensor_block: PASSED");
}
