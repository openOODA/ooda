// # Product prove std/fin/hft_tick_order.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/hft_tick_order.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_tick_order.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hft_tick_order: PASSED only if they match.

import "std/fin/hft_tick_order.oo";

pub fn main() {
    let hft_tick_order_a = tick_data_create("x", 0, 0, 0, 0, 0, 0, 0, 0, "x", true);
    let hft_tick_order_b = tick_data_create("x", 0, 0, 0, 0, 0, 0, 0, 0, "x", true);
    let hft_tick_order_va = tick_data_calculate_spread(hft_tick_order_a);
    let hft_tick_order_vb = tick_data_calculate_spread(hft_tick_order_b);
    if hft_tick_order_va != hft_tick_order_vb {
        println("FAIL hft_tick_order");
        process_exit(1);
    }
    println("prod_ap_hft_tick_order: PASSED");
}
