// # Product prove std/quantum_topological/topological_braid_word_compiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_topological/topological_braid_word_compiler.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_braid_word_compiler.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_topological_braid_word_compiler: PASSED only if they match.

import "std/quantum_topological/topological_braid_word_compiler.oo";

pub fn main() {
    let topological_braid_word_compiler_a = target_gate_new(0, "x", 0.0);
    let topological_braid_word_compiler_b = target_gate_new(0, "x", 0.0);
    if topological_braid_word_compiler_a.gate_id != topological_braid_word_compiler_b.gate_id {
        println("FAIL topological_braid_word_compiler");
        process_exit(1);
    }
    println("prod_ap_topological_braid_word_compiler: PASSED");
}
