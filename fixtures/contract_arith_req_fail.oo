// # Arith requires fail
//
// Logline: Fail closed when shifted(-1) breaks x + 1 > 0.
//
// Beats:
//   1. Require x + 1 > 0.
//   2. Return x + 1.
//   3. Call with -1 so the require fails.

// M165: arith requires fail-closed when x + 1 > 0 is false
pub fn shifted(x: Int) -> Int
    requires x + 1 > 0
{
    return x + 1;
}

pub fn main() {
    println(shifted(-1));
}
