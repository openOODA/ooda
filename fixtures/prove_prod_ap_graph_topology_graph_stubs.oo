// # Product prove std/graph_topology/graph_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_topology/graph_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_stubs: PASSED only if they match.

import "std/graph_topology/graph_stubs.oo";

pub fn main() {
    let graph_stubs_a = graph_hardware_accel_init(0);
    let graph_stubs_b = graph_hardware_accel_init(0);
    if graph_stubs_a.device_id != graph_stubs_b.device_id {
        println("FAIL graph_stubs");
        process_exit(1);
    }
    println("prod_ap_graph_stubs: PASSED");
}
