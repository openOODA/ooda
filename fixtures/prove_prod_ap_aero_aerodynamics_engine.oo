// # Product prove std/aero/aerodynamics_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/aerodynamics_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/aerodynamics_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aerodynamics_engine: PASSED only if they match.

import "std/aero/aerodynamics_engine.oo";

pub fn main() {
    let aerodynamics_engine_a = compute_mach_number(0.0, 0.0);
    let aerodynamics_engine_b = compute_mach_number(0.0, 0.0);
    if aerodynamics_engine_a != aerodynamics_engine_b {
        println("FAIL aerodynamics_engine");
        process_exit(1);
    }
    println("prod_ap_aerodynamics_engine: PASSED");
}
