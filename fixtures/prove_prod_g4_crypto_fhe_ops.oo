// # Product prove std/crypto/fhe_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/fhe_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_ops.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_crypto_fhe_ops: PASSED and exit 0 only on match.

import "std/crypto/fhe_ops.oo";

pub fn main() {
    let probe_a: Int = fhe_ops_probe();
    let probe_b: Int = fhe_ops_probe();
    if probe_a != probe_b {
        println("FAIL fhe_ops probe");
        process_exit(1);
    }

    let params: FheParams = FheParams {
        scheme_type: "BFV",
        poly_modulus_degree: 4096,
        plain_modulus: 65537,
        security_level: 128,
        is_valid: true,
    };
    let pt_a: FhePlaintext = fhe_encode_int(42, params);
    let pt_b: FhePlaintext = fhe_encode_int(42, params);
    if (pt_a).value != (pt_b).value {
        println("FAIL fhe_ops encode value");
        process_exit(1);
    }

    let dec_a: Result[Int, String] = fhe_decode_int(pt_a);
    let dec_b: Result[Int, String] = fhe_decode_int(pt_b);
    if dec_a.is_ok() != dec_b.is_ok() {
        println("FAIL fhe_ops decode status");
        process_exit(1);
    }

    let pk_a: FhePublicKey = fhe_public_key_create("pk0", "poly0", "poly1");
    let pk_b: FhePublicKey = fhe_public_key_create("pk0", "poly0", "poly1");
    let enc_res_a: Result[FheCiphertext, String] = fhe_encrypt(pk_a, params, pt_a);
    let enc_res_b: Result[FheCiphertext, String] = fhe_encrypt(pk_b, params, pt_b);
    if enc_res_a.is_ok() != enc_res_b.is_ok() {
        println("FAIL fhe_ops encrypt status");
        process_exit(1);
    }

    println("prod_g4_crypto_fhe_ops: PASSED");
    process_exit(0);
}
