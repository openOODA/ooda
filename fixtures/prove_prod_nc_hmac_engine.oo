// # Product prove std/sec/crypto/hmac_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmac_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_engine.oo.
//
// Beats:
//   1. Call hmac_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hmac_engine: PASSED only if it matches.

import "std/sec/crypto/hmac_engine.oo";

pub fn main() {
    let a: Int = hmac_engine_probe();
    if a != 0 {
        println("FAIL hmac_engine_probe");
        process_exit(1);
    }
    println("prod_nc_hmac_engine: PASSED");
}
