// # Product prove std/db_columnar/columnar_memory_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_memory_pool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_memory_pool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_memory_pool: PASSED only if they match.

import "std/db_columnar/columnar_memory_pool.oo";

pub fn main() {
    let columnar_memory_pool_a = memory_pool_align_64(0);
    let columnar_memory_pool_b = memory_pool_align_64(0);
    if columnar_memory_pool_a != columnar_memory_pool_b {
        println("FAIL columnar_memory_pool");
        process_exit(1);
    }
    println("prod_ap_columnar_memory_pool: PASSED");
}
