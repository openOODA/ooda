// # Product prove std/bio_advanced/protein_surface_electrostatics.oo
//
// Logline: Fail-closed emit+gcc+run asserts electrostatics_screened_potential is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_surface_electrostatics.oo.
//
// Beats:
//   1. Call electrostatics_screened_potential twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_surface_electrostatics: PASSED only if they match.

import "std/bio_advanced/protein_surface_electrostatics.oo";

pub fn main() {
    let protein_surface_electrostatics_mark: Int = 0;
    if protein_surface_electrostatics_mark != 0 {
        process_exit(1);
    }
    let a: Float = electrostatics_screened_potential(0.0, 0.0, 0.0, 0.0);
    let b: Float = electrostatics_screened_potential(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL electrostatics_screened_potential");
        process_exit(1);
    }
    println("prod_protein_surface_electrostatics: PASSED");
}
