// # Hostile ident mul fold
//
// Logline: Print 3 * x so emit-wasm must miss a const 3*4 fold.
//
// Setup: One public main. Right operand is IDENT x, not INT.
//
// Beats:
//   1. Let x be 4.
//   2. Print 3 * x.
//   3. A 12-only module is a lie.

pub fn main() {
    let x = 4;
    println(3 * x);
}
