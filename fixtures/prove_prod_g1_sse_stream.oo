// # Product prove std/web_protocols/sse_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts sse_is_heartbeat is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/sse_stream.oo.
//
// Beats:
//   1. Call sse_is_heartbeat twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sse_stream: PASSED only if they match.

import "std/web_protocols/sse_stream.oo";

pub fn main() {
    let obj_a: SseEvent = sse_event_new(0, 0, 0, 0);
    let obj_b: SseEvent = sse_event_new(0, 0, 0, 0);
    let a: Int = sse_is_heartbeat(obj_a);
    let b: Int = sse_is_heartbeat(obj_b);
    if a != b {
        println("FAIL sse_is_heartbeat");
        process_exit(1);
    }
    println("prod_sse_stream: PASSED");
}
