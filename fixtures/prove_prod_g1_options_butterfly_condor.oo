// # Product prove std/defi_derivatives/options_butterfly_condor.oo
//
// Logline: Fail-closed emit+gcc+run asserts bc_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_butterfly_condor.oo.
//
// Beats:
//   1. Call bc_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_butterfly_condor: PASSED only if they match.

import "std/defi_derivatives/options_butterfly_condor.oo";

pub fn main() {
    let a: Float = bc_norm_pdf(0.0);
    let b: Float = bc_norm_pdf(0.0);
    if a != b {
        println("FAIL bc_norm_pdf");
        process_exit(1);
    }
    println("prod_options_butterfly_condor: PASSED");
}
