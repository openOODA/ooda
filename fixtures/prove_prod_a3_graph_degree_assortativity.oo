// # Product prove std/graph_networks/graph_degree_assortativity.oo
//
// Logline: Fail-closed emit+gcc+run asserts assortativity_compute is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/graph_degree_assortativity.oo.
//
// Beats:
//   1. Call assortativity_compute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_degree_assortativity: PASSED only if they match.

import "std/graph_networks/graph_degree_assortativity.oo";

pub fn main() {
    let graph_degree_assortativity_mark: Int = 0;
    if graph_degree_assortativity_mark != 0 {
        process_exit(1);
    }
    let a: AssortativityResult = assortativity_compute(0, list_new(), list_new());
    let b: AssortativityResult = assortativity_compute(0, list_new(), list_new());
    if (a).num_edges != (b).num_edges {
        println("FAIL assortativity_compute");
        process_exit(1);
    }
    println("prod_graph_degree_assortativity: PASSED");
}
