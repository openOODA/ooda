// # Product prove std/telecom_5g/dsp_window_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/dsp_window_functions.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_window_functions.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dsp_window_functions: PASSED only if they match.

import "std/telecom_5g/dsp_window_functions.oo";

pub fn main() {
    let dsp_window_functions_a = dsp_window_hann_sample(0, 0);
    let dsp_window_functions_b = dsp_window_hann_sample(0, 0);
    if dsp_window_functions_a != dsp_window_functions_b {
        println("FAIL dsp_window_functions");
        process_exit(1);
    }
    println("prod_ap_dsp_window_functions: PASSED");
}
