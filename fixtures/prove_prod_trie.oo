// # Product trie prove
import "std/collections/trie.oo";
pub fn main() {
    let mut t: Trie = trie_new();
    t = trie_insert(t, 7);
    let n: Int = trie_len(t);
    if n != 1 {
        println("FAIL trie len");
        process_exit(1);
    }
    let c7: Bool = trie_contains(t, 7);
    if c7 == false {
        println("FAIL trie 7");
        process_exit(1);
    }
    println("prod_trie: PASSED");
}
