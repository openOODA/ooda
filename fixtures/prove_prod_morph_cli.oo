// # Product Prove std/security_defense/morph_cli.oo
//
// Logline: Deterministic assertion fixture verifying Morph CLI options parsing, programmatic driver execution, and output generation.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/morph_cli.oo.
//
// Beats:
//   1. Parse CLI options with custom flags.
//   2. Run morpher pipeline and verify zero-trust execution.
//   3. Assert return code is 0 and print prod_morph_cli: PASSED.

import "std/security_defense/morph_cli.oo";

pub fn main() {
    let mut my_args: List[String] = list_new();
    my_args = list_push(my_args, "crypto_verify_fn");
    my_args = list_push(my_args, "--seed");
    my_args = list_push(my_args, "9999");
    my_args = list_push(my_args, "--json");

    let opts: MorphCliOptions = morph_cli_parse_args(my_args);

    if (opts).target_name != "crypto_verify_fn" {
        println("FAIL: target_name mismatch");
        process_exit(1);
    }

    if (opts).seed != 9999 {
        println("FAIL: seed mismatch");
        process_exit(1);
    }

    if !(opts).json_format {
        println("FAIL: json_format mismatch");
        process_exit(1);
    }

    let res: AstMorpherResult = morph_cli_run_pipeline(&opts);
    if !(res).success {
        println("FAIL: pipeline execution failed");
        process_exit(1);
    }

    if (res).total_blocks != 3 {
        println("FAIL: total_blocks mismatch");
        process_exit(1);
    }

    let code: Int = morph_cli_execute(my_args);
    if code != 0 {
        println("FAIL: morph_cli_execute non-zero exit code");
        process_exit(1);
    }

    println("prod_morph_cli: PASSED");
    process_exit(0);
}
