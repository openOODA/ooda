// # Product prove std/sec/crypto/sha3.oo
//
// Logline: Fail-closed emit+gcc+run asserts SHA-3 sponge state, checksums, and hex conversions are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/sha3.oo.
//
// Beats:
//   1. Calculate DJB2 checksum hashes and verify equality.
//   2. Test hex encoding and decoding roundtrips.
//   3. Inspect Sha3State properties and rate accessors.
//   4. Print prod_g4_sec_sha3: PASSED and exit 0.

import "std/sec/crypto/sha3.oo";

pub fn main() {
    let cs1: Int = shim_marker_sha3_checksum();
    let cs2: Int = shim_marker_sha3_checksum();
    if cs1 != cs2 {
        println("FAIL shim_marker_sha3_checksum");
        process_exit(1);
    }

    let hex1: String = shim_marker_hex_encode();
    let hex2: String = shim_marker_hex_encode();
    if hex1 != hex2 || chars_len(hex1) == 0 {
        println("FAIL shim_marker_hex_encode");
        process_exit(1);
    }

    let dec_res1: Result[String, String] = shim_marker_hex_decode("616263");
    let dec_res2: Result[String, String] = shim_marker_hex_decode("616263");
    let dec1: String = match dec_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let dec2: String = match dec_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec1 != dec2 || dec1 != "abc" {
        println("FAIL shim_marker_hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = shim_marker_constant_time_eq("keccak", "keccak");
    let eq_b: Bool = shim_marker_constant_time_eq("keccak", "keccak");
    if eq_a != eq_b || eq_a == false {
        println("FAIL shim_marker_constant_time_eq true");
        process_exit(1);
    }

    let neq_a: Bool = shim_marker_constant_time_eq("keccak", "sha3");
    let neq_b: Bool = shim_marker_constant_time_eq("keccak", "sha3");
    if neq_a != neq_b || neq_a == true {
        println("FAIL shim_marker_constant_time_eq false");
        process_exit(1);
    }

    let st1: Sha3State = shim_marker_state_new(1088, 512, 32);
    let st2: Sha3State = shim_marker_state_new(1088, 512, 32);
    if sha3_state_rate(st1) != sha3_state_rate(st2) || sha3_state_rate(st1) != 1088 {
        println("FAIL sha3_state_rate");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_sha3_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_sha3: PASSED");
    process_exit(0);
}
