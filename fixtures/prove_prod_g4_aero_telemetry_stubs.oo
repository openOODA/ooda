// # Product prove std/aero/telemetry_stubs.oo
//
// Logline: Fail-closed verification that telemetry stubs module readiness and TmBatch structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_stubs.oo.
//
// Beats:
//   1. Verify telemetry_module_ready is true.
//   2. Construct TmBatch instances with packet counts and byte lengths.
//   3. Assert deterministic batch getters.
//   4. Print prod_g4_aero_telemetry_stubs: PASSED and exit 0.

import "std/aero/telemetry_stubs.oo";

pub fn main() {
    let ready1: Bool = telemetry_module_ready();
    let ready2: Bool = telemetry_module_ready();
    if ready1 != ready2 {
        println("FAIL telemetry_module_ready");
        process_exit(1);
    }
    if ready1 != true {
        println("FAIL telemetry_module_ready not true");
        process_exit(1);
    }

    let b1: TmBatch = tm_batch_new(10, 1024);
    let b2: TmBatch = tm_batch_new(10, 1024);

    let cnt1: Int = tm_batch_count(b1);
    let cnt2: Int = tm_batch_count(b2);
    if cnt1 != cnt2 {
        println("FAIL tm_batch_count match");
        process_exit(1);
    }
    if cnt1 != 10 {
        println("FAIL tm_batch_count value");
        process_exit(1);
    }

    let bytes1: Int = tm_batch_bytes(b1);
    let bytes2: Int = tm_batch_bytes(b2);
    if bytes1 != bytes2 {
        println("FAIL tm_batch_bytes match");
        process_exit(1);
    }
    if bytes1 != 1024 {
        println("FAIL tm_batch_bytes value");
        process_exit(1);
    }

    println("prod_g4_aero_telemetry_stubs: PASSED");
    process_exit(0);
}
