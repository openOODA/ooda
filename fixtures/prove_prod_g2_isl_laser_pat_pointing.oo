// # Product prove std/satellite_dvb/isl_laser_pat_pointing.oo
//
// Logline: Fail-closed emit+gcc+run asserts laser_calc_point_ahead_angle_urad is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_laser_pat_pointing.oo.
//
// Beats:
//   1. Call laser_calc_point_ahead_angle_urad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isl_laser_pat_pointing: PASSED only if they match.

import "std/satellite_dvb/isl_laser_pat_pointing.oo";

pub fn main() {
    let isl_laser_pat_pointing_mark: Int = 0;
    if isl_laser_pat_pointing_mark != 0 {
        process_exit(1);
    }
    let a: Float = laser_calc_point_ahead_angle_urad(0.0);
    let b: Float = laser_calc_point_ahead_angle_urad(0.0);
    if a != b {
        println("FAIL laser_calc_point_ahead_angle_urad");
        process_exit(1);
    }
    println("prod_g2_isl_laser_pat_pointing: PASSED");
}
