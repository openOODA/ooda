// # Product prove std/astrodynamics/anomaly_kepler_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts kepler_iters is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/anomaly_kepler_solver.oo.
//
// Beats:
//   1. Call kepler_iters twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anomaly_kepler_solver: PASSED only if they match.

import "std/astrodynamics/anomaly_kepler_solver.oo";

pub fn main() {
    let anomaly_kepler_solver_mark: Int = 0;
    if anomaly_kepler_solver_mark != 0 {
        process_exit(1);
    }
    let a: Int = kepler_iters();
    let b: Int = kepler_iters();
    if a != b {
        println("FAIL kepler_iters");
        process_exit(1);
    }
    println("prod_anomaly_kepler_solver: PASSED");
}
