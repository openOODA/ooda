// # Product prove std/robotics_auv/underwater_manipulator_arm.oo
//
// Logline: Fail-closed emit+gcc+run asserts manipulator_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/underwater_manipulator_arm.oo.
//
// Beats:
//   1. Call manipulator_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_manipulator_config_default: PASSED only if they match.

import "std/robotics_auv/underwater_manipulator_arm.oo";

pub fn main() {
    let underwater_manipulator_arm_mark: Int = 0;
    if underwater_manipulator_arm_mark != 0 { process_exit(1); }
    let a: ManipulatorConfig = manipulator_config_default();
    let b: ManipulatorConfig = manipulator_config_default();
    if (a).link1_length_m != (b).link1_length_m {
        println("FAIL manipulator_config_default");
        process_exit(1);
    }
    println("prod_manipulator_config_default: PASSED");
}
