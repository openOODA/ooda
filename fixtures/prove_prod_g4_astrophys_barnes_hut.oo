// # Product prove std/astrophysics_relativity/nbody_barnes_hut_octree.oo
//
// Logline: Fail-closed verification that Barnes-Hut 3D octree construction and gravitational force evaluation are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/nbody_barnes_hut_octree.oo.
//
// Beats:
//   1. Initialize octree node and insert N-body particles.
//   2. Evaluate gravitational acceleration and potential energy on target position.
//   3. Assert deterministic multipole acceleration results.
//   4. Print prod_g4_astrophys_barnes_hut: PASSED and exit 0.

import "std/astrophysics_relativity/nbody_barnes_hut_octree.oo";

pub fn main() {
    let nbody_barnes_hut_octree_mark: Int = 0;
    if nbody_barnes_hut_octree_mark != 0 {
        process_exit(1);
    }

    let box: OctreeBoundingBox = OctreeBoundingBox {
        center_x: 0.0,
        center_y: 0.0,
        center_z: 0.0,
        half_size_m: 10000.0,
    };

    let p1: NBodyParticle = NBodyParticle {
        pos_x: 100.0,
        pos_y: 200.0,
        pos_z: 300.0,
        vel_x: 0.0,
        vel_y: 0.0,
        vel_z: 0.0,
        mass_kg: 5000000000.0,
    };

    let node0: OctreeNode = barnes_hut_node_new(box);
    let node_a: OctreeNode = barnes_hut_insert_particle(node0, p1);
    let node_b: OctreeNode = barnes_hut_insert_particle(node0, p1);

    if (node_a).total_mass_kg != (node_b).total_mass_kg || (node_a).total_mass_kg <= 0.0 {
        println("FAIL barnes_hut_insert_particle total_mass_kg");
        process_exit(1);
    }

    if (node_a).com_x != (node_b).com_x || (node_a).com_y != (node_b).com_y || (node_a).com_z != (node_b).com_z {
        println("FAIL barnes_hut_insert_particle COM");
        process_exit(1);
    }

    let acc_a: GravitationalAcceleration = barnes_hut_evaluate_node_force(node_a, 1000.0, 1000.0, 1000.0, 0.5, 1.0);
    let acc_b: GravitationalAcceleration = barnes_hut_evaluate_node_force(node_b, 1000.0, 1000.0, 1000.0, 0.5, 1.0);

    if (acc_a).acc_x != (acc_b).acc_x || (acc_a).acc_y != (acc_b).acc_y || (acc_a).acc_z != (acc_b).acc_z {
        println("FAIL barnes_hut_evaluate_node_force acc");
        process_exit(1);
    }

    if (acc_a).potential_energy_j != (acc_b).potential_energy_j || (acc_a).potential_energy_j >= 0.0 {
        println("FAIL barnes_hut_evaluate_node_force potential_energy_j");
        process_exit(1);
    }

    println("prod_g4_astrophys_barnes_hut: PASSED");
    process_exit(0);
}
