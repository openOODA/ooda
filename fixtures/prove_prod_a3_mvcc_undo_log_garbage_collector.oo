// # Product prove std/db_storage/mvcc_undo_log_garbage_collector.oo
//
// Logline: Fail-closed emit+gcc+run asserts undo_segment_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_undo_log_garbage_collector.oo.
//
// Beats:
//   1. Call undo_segment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_undo_log_garbage_collector: PASSED only if they match.

import "std/db_storage/mvcc_undo_log_garbage_collector.oo";

pub fn main() {
    let mvcc_undo_log_garbage_collector_mark: Int = 0;
    if mvcc_undo_log_garbage_collector_mark != 0 {
        process_exit(1);
    }
    let a: UndoSegment = undo_segment_new(0);
    let b: UndoSegment = undo_segment_new(0);
    if (a).segment_id != (b).segment_id {
        println("FAIL undo_segment_new");
        process_exit(1);
    }
    println("prod_mvcc_undo_log_garbage_collector: PASSED");
}
