// # Return from one match arm
//
// Logline: Connect in both match arms, return from Ok, and send after the Err join.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Connect and return in Ok.
//   3. Connect in Err, then send after the join.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    let r = Ok(1);
    match r {
        Ok(v) => {
            connect(s);
            return;
        }
        Err(e) => {
            connect(s);
        }
    }
    send(s);
}
