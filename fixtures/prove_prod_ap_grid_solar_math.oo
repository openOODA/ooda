// # Product prove std/grid/solar_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/solar_math.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_math.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_solar_math: PASSED only if they match.

import "std/grid/solar_math.oo";

pub fn main() {
    let solar_math_a = math_pi();
    let solar_math_b = math_pi();
    if solar_math_a != solar_math_b {
        println("FAIL solar_math");
        process_exit(1);
    }
    println("prod_ap_solar_math: PASSED");
}
