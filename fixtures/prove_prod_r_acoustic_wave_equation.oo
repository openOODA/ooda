// # Product prove std/physics_advanced/acoustic_wave_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts acoustic_medium_water value or determinism.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/acoustic_wave_equation.oo.
//
// Beats:
//   1. Call acoustic_medium_water twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_acoustic_wave_equation: PASSED only if asserts hold.

import "std/physics_advanced/acoustic_wave_equation.oo";

pub fn main() {
    let acoustic_wave_equation = acoustic_medium_water();
    let acoustic_wave_equation_b = acoustic_medium_water();
    if acoustic_wave_equation.sound_speed_c != 1481.0 {
        println("FAIL acoustic_medium_water sound_speed_c");
        process_exit(1);
    }
    if acoustic_wave_equation.sound_speed_c != acoustic_wave_equation_b.sound_speed_c {
        println("FAIL acoustic_medium_water det");
        process_exit(1);
    }
    println("prod_acoustic_wave_equation: PASSED");
}
