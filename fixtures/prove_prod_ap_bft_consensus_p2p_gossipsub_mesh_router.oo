// # Product prove std/bft_consensus/p2p_gossipsub_mesh_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/p2p_gossipsub_mesh_router.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/p2p_gossipsub_mesh_router.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_p2p_gossipsub_mesh_router: PASSED only if they match.

import "std/bft_consensus/p2p_gossipsub_mesh_router.oo";

pub fn main() {
    let p2p_gossipsub_mesh_router_a = gossip_topic_mesh_new("x", 0, 0, 0);
    let p2p_gossipsub_mesh_router_b = gossip_topic_mesh_new("x", 0, 0, 0);
    let p2p_gossipsub_mesh_router_va = gossip_mesh_needs_graft(p2p_gossipsub_mesh_router_a);
    let p2p_gossipsub_mesh_router_vb = gossip_mesh_needs_graft(p2p_gossipsub_mesh_router_b);
    if p2p_gossipsub_mesh_router_va != p2p_gossipsub_mesh_router_vb {
        println("FAIL p2p_gossipsub_mesh_router");
        process_exit(1);
    }
    println("prod_ap_p2p_gossipsub_mesh_router: PASSED");
}
