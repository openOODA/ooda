// # Pass two loops on one MaxCycles budget
//
// Logline: Two short whiles share one cycle budget and stay under the combined cap.
//
// Beats:
//   1. Honor the line-start fuel directive as one shared budget.
//   2. Run two two-step loops that spend four cycles together.
//   3. Print the summed counters under an eight-cycle cap.

// M58 shared fuel: two short whiles under combined budget
// MAX_CYCLES: 8
pub fn main() {
    let mut a = 0;
    while a < 2 {
        a = a + 1;
    }
    let mut b = 0;
    while b < 2 {
        b = b + 1;
    }
    println(a + b);
}
