// # Product prove std/db_storage/buffer_pool_frame_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts buffer_pool_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/buffer_pool_frame_manager.oo.
//
// Beats:
//   1. Call buffer_pool_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_buffer_pool_frame_manager: PASSED only if they match.

import "std/db_storage/buffer_pool_frame_manager.oo";

pub fn main() {
    let buffer_pool_frame_manager_mark: Int = 0;
    if buffer_pool_frame_manager_mark != 0 {
        process_exit(1);
    }
    let a: BufferPoolManager = buffer_pool_manager_new(0);
    let b: BufferPoolManager = buffer_pool_manager_new(0);
    if (a).pool_size != (b).pool_size {
        println("FAIL buffer_pool_manager_new");
        process_exit(1);
    }
    println("prod_buffer_pool_frame_manager: PASSED");
}
