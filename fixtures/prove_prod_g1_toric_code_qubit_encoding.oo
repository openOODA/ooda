// # Product prove std/quantum_topological/toric_code_qubit_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts logical_pauli_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_qubit_encoding.oo.
//
// Beats:
//   1. Call logical_pauli_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_toric_code_qubit_encoding: PASSED only if they match.

import "std/quantum_topological/toric_code_qubit_encoding.oo";

pub fn main() {
    let a: LogicalPauliOp = logical_pauli_op_new(0, 0, 0);
    let b: LogicalPauliOp = logical_pauli_op_new(0, 0, 0);
    if a.qubit_index != b.qubit_index {
        println("FAIL logical_pauli_op_new");
        process_exit(1);
    }
    println("prod_toric_code_qubit_encoding: PASSED");
}
