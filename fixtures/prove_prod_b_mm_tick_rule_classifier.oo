// # Product prove std/hft_alpha/mm_tick_rule_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_tick_rule_classifier_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_tick_rule_classifier.oo.
//
// Beats:
//   1. Call mm_tick_rule_classifier_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_tick_rule_classifier: PASSED only if they match.

import "std/hft_alpha/mm_tick_rule_classifier.oo";

pub fn main() {
    let a = mm_tick_rule_classifier_probe();
    let b = mm_tick_rule_classifier_probe();
    if a != b {
        println("FAIL mm_tick_rule_classifier_probe");
        process_exit(1);
    }
    println("prod_mm_tick_rule_classifier: PASSED");
}
