// # Product prove std/compilers/lsp_diagnostics.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsp_diag_severity_error is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_diagnostics.oo.
//
// Beats:
//   1. Call lsp_diag_severity_error twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsp_diagnostics: PASSED only if they match.

import "std/compilers/lsp_diagnostics.oo";

pub fn main() {
    let lsp_diagnostics_mark: Int = 0;
    if lsp_diagnostics_mark != 0 {
        process_exit(1);
    }
    let a: Int = lsp_diag_severity_error();
    let b: Int = lsp_diag_severity_error();
    if a != b {
        println("FAIL lsp_diag_severity_error");
        process_exit(1);
    }
    println("prod_lsp_diagnostics: PASSED");
}
