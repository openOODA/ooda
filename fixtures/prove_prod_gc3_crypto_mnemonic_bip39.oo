// # Product prove std/fintech_defi/crypto_mnemonic_bip39.oo
//
// Logline: Fail-closed emit+gcc+run asserts mnemonic_compute_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/crypto_mnemonic_bip39.oo.
//
// Beats:
//   1. Call mnemonic_compute_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crypto_mnemonic_bip39: PASSED only if they match.

import "std/fintech_defi/crypto_mnemonic_bip39.oo";

pub fn main() {
    let crypto_mnemonic_bip39_mark: Int = 0;
    if crypto_mnemonic_bip39_mark != 0 {
        process_exit(1);
    }
    let crypto_mnemonic_bip39_a: Int = mnemonic_compute_checksum(1);
    let crypto_mnemonic_bip39_b: Int = mnemonic_compute_checksum(1);
    if crypto_mnemonic_bip39_a != crypto_mnemonic_bip39_b {
        println("FAIL mnemonic_compute_checksum");
        process_exit(1);
    }
    println("prod_crypto_mnemonic_bip39: PASSED");
}
