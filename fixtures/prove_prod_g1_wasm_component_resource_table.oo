// # Product prove std/wasm_gc/wasm_component_resource_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts resource_table_rep is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_resource_table.oo.
//
// Beats:
//   1. Call resource_table_rep twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_resource_table: PASSED only if they match.

import "std/wasm_gc/wasm_component_resource_table.oo";

pub fn main() {
    let obj_a: ResourceTable = resource_table_new();
    let obj_b: ResourceTable = resource_table_new();
    let a: Int = resource_table_rep(obj_a, 0);
    let b: Int = resource_table_rep(obj_b, 0);
    if a != b {
        println("FAIL resource_table_rep");
        process_exit(1);
    }
    println("prod_wasm_component_resource_table: PASSED");
}
