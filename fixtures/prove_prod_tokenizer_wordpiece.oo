// # Product prove std/ai_ml/tokenizer_wordpiece.oo
//
// Logline: Fail-closed emit+gcc+run asserts wp_unk_id is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tokenizer_wordpiece.oo.
//
// Beats:
//   1. Call wp_unk_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tokenizer_wordpiece: PASSED only if they match.

import "std/ai_ml/tokenizer_wordpiece.oo";

pub fn main() {
    let a = wp_unk_id();
    let b = wp_unk_id();
    if a != b {
        println("FAIL wp_unk_id");
        process_exit(1);
    }
    println("prod_tokenizer_wordpiece: PASSED");
}
