// # Product prove std/space_propulsion/rocket_nozzle_method_characteristics.oo
//
// Logline: Fail-closed emit+gcc+run asserts prandtl_meyer_nu value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_nozzle_method_characteristics.oo.
//
// Beats:
//   1. Call prandtl_meyer_nu twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rocket_nozzle_method_characteristics: PASSED only if asserts hold.

import "std/space_propulsion/rocket_nozzle_method_characteristics.oo";

pub fn main() {
    let rocket_nozzle_method_characteristics_a: Float = prandtl_meyer_nu(0.0, 0.0);
    let rocket_nozzle_method_characteristics_b: Float = prandtl_meyer_nu(0.0, 0.0);
    if rocket_nozzle_method_characteristics_a != rocket_nozzle_method_characteristics_b {
        println("FAIL prandtl_meyer_nu");
        process_exit(1);
    }
    println("prod_rocket_nozzle_method_characteristics: PASSED");
}
