// # Product prove std/bft_consensus/fast_sync_state_chunker.oo
//
// Logline: Fail-closed emit+gcc+run asserts chunker_session_is_complete is a real value.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/fast_sync_state_chunker.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chunker_session_is_complete twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fast_sync_state_chunker: PASSED only if they match.

import "std/bft_consensus/fast_sync_state_chunker.oo";

pub fn main() {
    let g0_oa: ChunkerSession = ChunkerSession { target_height: 0, target_state_root: "x", total_chunks: 0, downloaded_chunks: 0, is_sync_complete: true };
    let g0_ob: ChunkerSession = ChunkerSession { target_height: 0, target_state_root: "x", total_chunks: 0, downloaded_chunks: 0, is_sync_complete: true };
    let g0_a = chunker_session_is_complete(g0_oa);
    let g0_b = chunker_session_is_complete(g0_ob);
    if g0_a != g0_b {
        println("FAIL chunker_session_is_complete");
        process_exit(1);
    }
    println("prod_gr_fast_sync_state_chunker: PASSED");
}
