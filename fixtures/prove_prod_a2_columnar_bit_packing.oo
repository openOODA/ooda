// # Product prove std/db_columnar/columnar_bit_packing.oo
//
// Logline: Fail-closed emit+gcc+run asserts bit_packing_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_bit_packing.oo.
//
// Beats:
//   1. Call bit_packing_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_bit_packing: PASSED only if they match.

import "std/db_columnar/columnar_bit_packing.oo";

pub fn main() {
    let columnar_bit_packing_mark: Int = 0;
    if columnar_bit_packing_mark != 0 {
        process_exit(1);
    }
    let a: BitPackingConfig = bit_packing_config_new(0, 0);
    let b: BitPackingConfig = bit_packing_config_new(0, 0);
    if (a).bit_width != (b).bit_width {
        println("FAIL bit_packing_config_new");
        process_exit(1);
    }
    println("prod_columnar_bit_packing: PASSED");
}
