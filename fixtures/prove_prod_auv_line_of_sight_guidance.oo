// # Product prove std/robotics_auv/auv_line_of_sight_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts los_guidance_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_line_of_sight_guidance.oo.
//
// Beats:
//   1. Call los_guidance_config_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_line_of_sight_guidance: PASSED only if they match.

import "std/robotics_auv/auv_line_of_sight_guidance.oo";

pub fn main() {
    let auv_line_of_sight_guidance_mark: Int = 0;
    if auv_line_of_sight_guidance_mark != 0 {
        process_exit(1);
    }
    let a: LosGuidanceConfig = los_guidance_config_default();
    let b: LosGuidanceConfig = los_guidance_config_default();
    if (a).field0 != (b).field0 {
        println("FAIL los_guidance_config_default");
        process_exit(1);
    }
    println("prod_auv_line_of_sight_guidance: PASSED");
}
