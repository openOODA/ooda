// # Product byte clamp prove
//
// Logline: Fail-closed emit+gcc+run of shipped byte_clamp and byte_in_range.
//
// Setup: Locked oodac. Calls ooda/std/byte.oo. No caps.
//
// Beats:
//   1. Clamp 300 to 255 and -1 to 0.
//   2. 16 is in range; 300 is not.
//   3. Exit 1 on any miss. Print prod_byte: PASSED only if all hold.

import "std/byte.oo";

pub fn main() {
    let hi: Int = byte_clamp(300);
    if hi != 255 {
        println("FAIL byte_clamp 300");
        process_exit(1);
    }
    let lo: Int = byte_clamp(-1);
    if lo != 0 {
        println("FAIL byte_clamp -1");
        process_exit(1);
    }
    let in16: Bool = byte_in_range(16);
    if !in16 {
        println("FAIL byte_in_range 16");
        process_exit(1);
    }
    let in300: Bool = byte_in_range(300);
    if in300 {
        println("FAIL byte_in_range 300");
        process_exit(1);
    }
    println("prod_byte: PASSED");
}
