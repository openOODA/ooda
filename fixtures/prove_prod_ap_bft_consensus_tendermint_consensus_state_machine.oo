// # Product prove std/bft_consensus/tendermint_consensus_state_machine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/tendermint_consensus_state_machine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_consensus_state_machine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tendermint_consensus_state_machine: PASSED only if they match.

import "std/bft_consensus/tendermint_consensus_state_machine.oo";

pub fn main() {
    let tendermint_consensus_state_machine_a = tendermint_step_new_round();
    let tendermint_consensus_state_machine_b = tendermint_step_new_round();
    if tendermint_consensus_state_machine_a != tendermint_consensus_state_machine_b {
        println("FAIL tendermint_consensus_state_machine");
        process_exit(1);
    }
    println("prod_ap_tendermint_consensus_state_machine: PASSED");
}
