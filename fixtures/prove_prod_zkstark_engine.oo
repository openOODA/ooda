import "std/sec/crypto/zkstark_engine.oo";

pub fn main() {
    let zkstark_engine_mark: Int = 0;
    if zkstark_engine_mark != 0 { process_exit(1); }
    let a: StarkProver = stark_prover_init("x", 0, 0, 0, 0);
    let b: StarkProver = stark_prover_init("x", 0, 0, 0, 0);
    if a != b { process_exit(1); }
    println("prod_zkstark_engine: PASSED");
}
