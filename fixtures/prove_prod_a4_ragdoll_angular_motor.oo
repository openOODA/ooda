// # Product prove std/physics_advanced/ragdoll_angular_motor.oo
//
// Logline: Fail-closed emit+gcc+run asserts angular_motor_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/ragdoll_angular_motor.oo.
//
// Beats:
//   1. Call angular_motor_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ragdoll_angular_motor: PASSED only if they match.

import "std/physics_advanced/ragdoll_angular_motor.oo";

pub fn main() {
    let ragdoll_angular_motor_mark: Int = 0;
    if ragdoll_angular_motor_mark != 0 {
        process_exit(1);
    }
    let a: AngularMotorConfig = angular_motor_config_new(0.0, 0.0, 0.0);
    let b: AngularMotorConfig = angular_motor_config_new(0.0, 0.0, 0.0);
    if (a).kp_stiffness != (b).kp_stiffness {
        println("FAIL angular_motor_config_new");
        process_exit(1);
    }
    println("prod_ragdoll_angular_motor: PASSED");
}
