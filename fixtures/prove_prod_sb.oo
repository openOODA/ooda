// # Product string builder prove
//
// Logline: Fail-closed emit+gcc+run of shipped sb_append / sb_to_string.
//
// Setup: Product std/text/string_builder.oo. hello + world.
//
// Beats:
//   1. Append hello then world is helloworld.
//   2. sb_len of that is 10.
//   3. Exit 1 before PASSED on a miss.

import "std/text/string_builder.oo";

pub fn main() {
    let b0: StringBuilder = sb_new();
    let b1: StringBuilder = sb_append(b0, "hello");
    let b2: StringBuilder = sb_append(b1, "world");
    let s: String = sb_to_string(b2);
    if s != "helloworld" {
        println("FAIL sb concat");
        process_exit(1);
    }
    let n: Int = sb_len(b2);
    if n != 10 {
        println("FAIL sb len");
        process_exit(1);
    }
    println("prod_sb: PASSED");
}
