// # Product prove std/space_propulsion/field_emission_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts feep_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/field_emission_electric_propulsion.oo.
//
// Beats:
//   1. Call feep_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_field_emission_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/field_emission_electric_propulsion.oo";

pub fn main() {
    let field_emission_electric_propulsion_mark: Int = 0;
    if field_emission_electric_propulsion_mark != 0 {
        process_exit(1);
    }
    let field_emission_electric_propulsion_a = feep_compute_performance(feep_spec_default_indium());
    let field_emission_electric_propulsion_b = feep_compute_performance(feep_spec_default_indium());
    if (field_emission_electric_propulsion_a).onset_voltage_v != (field_emission_electric_propulsion_b).onset_voltage_v {
        println("FAIL feep_compute_performance");
        process_exit(1);
    }
    println("prod_field_emission_electric_propulsion: PASSED");
}
