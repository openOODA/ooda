// # Product prove std/media_dsp/qoi_fast_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts qoi_color_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/qoi_fast_codec.oo.
//
// Beats:
//   1. Call qoi_color_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qoi_fast_codec: PASSED only if they match.

import "std/media_dsp/qoi_fast_codec.oo";

pub fn main() {
    let qoi_fast_codec_mark: Int = 0;
    if qoi_fast_codec_mark != 0 {
        process_exit(1);
    }
    let qoi_fast_codec_a: Int = qoi_color_hash(1, 1, 1, 1);
    let qoi_fast_codec_b: Int = qoi_color_hash(1, 1, 1, 1);
    if qoi_fast_codec_a != qoi_fast_codec_b {
        println("FAIL qoi_color_hash");
        process_exit(1);
    }
    println("prod_qoi_fast_codec: PASSED");
}
