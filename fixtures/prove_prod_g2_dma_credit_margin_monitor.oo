// # Product prove std/fintech_l3_book/dma_credit_margin_monitor.oo
//
// Logline: Fail-closed emit+gcc+run asserts account_margin_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_credit_margin_monitor.oo.
//
// Beats:
//   1. Call account_margin_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dma_credit_margin_monitor: PASSED only if they match.

import "std/fintech_l3_book/dma_credit_margin_monitor.oo";

pub fn main() {
    let dma_credit_margin_monitor_mark: Int = 0;
    if dma_credit_margin_monitor_mark != 0 {
        process_exit(1);
    }
    let a: AccountMarginState = account_margin_state_new("x", 0, 0, 0);
    let b: AccountMarginState = account_margin_state_new("x", 0, 0, 0);
    if (a).total_cash_fixed != (b).total_cash_fixed {
        println("FAIL account_margin_state_new");
        process_exit(1);
    }
    println("prod_g2_dma_credit_margin_monitor: PASSED");
}
