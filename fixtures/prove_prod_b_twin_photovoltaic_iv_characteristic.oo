// # Product prove std/digital_twin/twin_photovoltaic_iv_characteristic.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_photovoltaic_iv_characteristic_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_photovoltaic_iv_characteristic.oo.
//
// Beats:
//   1. Call twin_photovoltaic_iv_characteristic_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_twin_photovoltaic_iv_characteristic: PASSED only if they match.

import "std/digital_twin/twin_photovoltaic_iv_characteristic.oo";

pub fn main() {
    let a = twin_photovoltaic_iv_characteristic_probe();
    let b = twin_photovoltaic_iv_characteristic_probe();
    if a != b {
        println("FAIL twin_photovoltaic_iv_characteristic_probe");
        process_exit(1);
    }
    println("prod_twin_photovoltaic_iv_characteristic: PASSED");
}
