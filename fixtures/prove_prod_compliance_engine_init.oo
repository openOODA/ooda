// # Product prove std/enterprise/compliance.oo
//
// Logline: Fail-closed emit+gcc+run asserts compliance_engine_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/compliance.oo.
//
// Beats:
//   1. Call compliance_engine_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compliance_engine_init: PASSED only if they match.

import "std/enterprise/compliance.oo";

pub fn main() {
    let compliance_mark: Int = 0;
    if compliance_mark != 0 { process_exit(1); }
    let a = compliance_engine_init();
    let b = compliance_engine_init();
    if (a).total_evaluations != (b).total_evaluations {
        println("FAIL compliance_engine_init");
        process_exit(1);
    }
    println("prod_compliance_engine_init: PASSED");
}
