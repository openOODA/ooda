// # Product prove std/physics_advanced/orbital_relativity_schwarzschild.oo
//
// Logline: Fail-closed emit+gcc+run asserts schwarzschild_radius value or determinism.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/orbital_relativity_schwarzschild.oo.
//
// Beats:
//   1. Call schwarzschild_radius twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_orbital_relativity_schwarzschild: PASSED only if asserts hold.

import "std/physics_advanced/orbital_relativity_schwarzschild.oo";

pub fn main() {
    let orbital_relativity_schwarzschild_a: Float = schwarzschild_radius(1.0, 1.0);
    let orbital_relativity_schwarzschild_b: Float = schwarzschild_radius(1.0, 1.0);
    if orbital_relativity_schwarzschild_a != 2.0 {
        println("FAIL schwarzschild_radius");
        process_exit(1);
    }
    if orbital_relativity_schwarzschild_a != orbital_relativity_schwarzschild_b {
        println("FAIL schwarzschild_radius det");
        process_exit(1);
    }
    println("prod_orbital_relativity_schwarzschild: PASSED");
}
