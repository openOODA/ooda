// # Product prove std/satellite_dvb/dvb_s2x_modcod_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_modcod_select_optimal is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_modcod_table.oo.
//
// Beats:
//   1. Call dvb_modcod_select_optimal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dvb_s2x_modcod_table: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_modcod_table.oo";

pub fn main() {
    let dvb_s2x_modcod_table_mark: Int = 0;
    if dvb_s2x_modcod_table_mark != 0 {
        process_exit(1);
    }
    let a: Int = dvb_modcod_select_optimal(0.0, 0.0);
    let b: Int = dvb_modcod_select_optimal(0.0, 0.0);
    if a != b {
        println("FAIL dvb_modcod_select_optimal");
        process_exit(1);
    }
    println("prod_g2_dvb_s2x_modcod_table: PASSED");
}
