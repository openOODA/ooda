// # Product chunked prove
//
// Logline: Fail-closed emit+gcc+run of shipped chunked_int_to_hex/hex_to_int.
//
// Setup: Product std/io/chunked.oo. Hex 10 <-> a.
//
// Beats:
//   1. int_to_hex(10) is a; hex_to_int(a) is 10; hex 0 is 0.
//   2. Exit 1 before PASSED on a miss.

import "std/io/chunked.oo";

pub fn main() {
    let h: String = chunked_int_to_hex(10);
    if h != "a" {
        println("FAIL chunked hex");
        process_exit(1);
    }
    let n: Int = chunked_hex_to_int("a");
    if n != 10 {
        println("FAIL chunked int");
        process_exit(1);
    }
    let z: String = chunked_int_to_hex(0);
    if z != "0" {
        println("FAIL chunked zero");
        process_exit(1);
    }
    println("prod_chunked: PASSED");
}
