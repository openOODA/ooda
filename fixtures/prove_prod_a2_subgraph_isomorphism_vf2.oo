// # Product prove std/db_graph/subgraph_isomorphism_vf2.oo
//
// Logline: Fail-closed emit+gcc+run asserts vf2_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/subgraph_isomorphism_vf2.oo.
//
// Beats:
//   1. Call vf2_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_subgraph_isomorphism_vf2: PASSED only if they match.

import "std/db_graph/subgraph_isomorphism_vf2.oo";

pub fn main() {
    let subgraph_isomorphism_vf2_mark: Int = 0;
    if subgraph_isomorphism_vf2_mark != 0 {
        process_exit(1);
    }
    let a: VF2State = vf2_state_new(0, 0);
    let b: VF2State = vf2_state_new(0, 0);
    if (a).depth != (b).depth {
        println("FAIL vf2_state_new");
        process_exit(1);
    }
    println("prod_subgraph_isomorphism_vf2: PASSED");
}
