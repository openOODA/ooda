// # Minimax Audit: Stage 52 Go CSP Channels Red-Team
//
// Logline: Hostile probe that imports std/compilers/superpower_go.oo and asserts bounded buffer channel semantics and incremental build latency measurement.
//
// Setup: Pure .oo audit. Reads the public channel_new, channel_send, and measure_build functions and verifies real CSP channel invariants.
//
// Beats:
//   1. Verify initial channel state has zero items and is not closed.
//   2. Verify channel_send enforces buffer capacity bounds and blocks oversend.
//   3. Verify measure_build distinguishes sub-100ms builds and static binary flags.
//   4. Assert all Go CSP and compiler build invariants pass cleanly.

import "std/compilers/superpower_go.oo";

fn go_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

fn test_channel_new_initial_state() {
    let ch: SuperpowerGoChannel = superpower_go_channel_new(1, 16);
    go_assert("initial is_closed == false", ch.is_closed == false);
    go_assert("initial current_items == 0", ch.current_items == 0);
    go_assert("capacity == 16", ch.capacity == 16);
    go_assert("channel_id == 1", ch.channel_id == 1);
}

fn test_channel_send_bounded() {
    let ch0: SuperpowerGoChannel = superpower_go_channel_new(7, 2);
    let ch1: SuperpowerGoChannel = superpower_go_channel_send(ch0);
    let ch2: SuperpowerGoChannel = superpower_go_channel_send(ch1);
    let ch3: SuperpowerGoChannel = superpower_go_channel_send(ch2);
    let ch4: SuperpowerGoChannel = superpower_go_channel_send(ch3);
    // Bounded buffer capacity is 2; sending past capacity must not exceed capacity.
    go_assert("current_items bounded at capacity (2)", ch4.current_items == 2);
}

fn test_measure_build_metrics() {
    let p_fast: SuperpowerGoBuildPipeline = superpower_go_measure_build(100, 50);
    go_assert("50ms is_sub_100ms", p_fast.is_sub_100ms);
    go_assert("fast build is_static_binary true", p_fast.is_static_binary);
    let p_slow: SuperpowerGoBuildPipeline = superpower_go_measure_build(100, 200);
    go_assert("200ms not sub_100ms", p_slow.is_sub_100ms == false);
    go_assert("slow build is_static_binary true", p_slow.is_static_binary);
    let p_invalid: SuperpowerGoBuildPipeline = superpower_go_measure_build(0, 50);
    go_assert("0 mods is NOT static binary", p_invalid.is_static_binary == false);
}

fn test_audit_record() {
    let p: SuperpowerGoBuildPipeline = superpower_go_measure_build(10, 99);
    let ms: Int = p.elapsed_build_ms;
    go_assert("elapsed_build_ms is 99", ms == 99);
    let mods: Int = p.modules_compiled;
    go_assert("modules_compiled is 10", mods == 10);
}

pub fn main() {
    println("audit_go_csp: starting");
    test_channel_new_initial_state();
    println("step1 ok");
    test_channel_send_bounded();
    println("step2 ok");
    test_measure_build_metrics();
    println("step3 ok");
    test_audit_record();
    println("step4 ok");
    println("audit_go_csp: AUDIT COMPLETE (see findings in source)");
}
