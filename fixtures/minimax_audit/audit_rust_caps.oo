// # Minimax Audit: Stage 51 Rust Linear Capabilities Red-Team
//
// Logline: Hostile probe that imports std/compilers/superpower_rust.oo and asserts linear capability move semantics, borrow non-linearity, and dynamic ARC elision.
//
// Setup: Pure .oo audit. Reads the public capability_new, move_capability, and evaluate_arc_elision functions and verifies real capability ownership invariants.
//
// Beats:
//   1. Verify capability linearity: borrows and read-only caps are non-linear, owned caps are linear.
//   2. Verify initial capability state is un-moved.
//   3. Verify affine single-move semantics: first move succeeds, double-move is refused.
//   4. Verify dynamic ARC elision correctly models allocation counts.

import "std/compilers/superpower_rust.oo";

fn rust_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

fn test_capability_linearity() {
    let c1: SuperpowerRustCapability = superpower_rust_capability_new("BorrowCap", 1);
    rust_assert("BorrowCap is NOT linear", c1.is_linear == false);
    let c2: SuperpowerRustCapability = superpower_rust_capability_new("FsWriteCap", 2);
    rust_assert("FsWriteCap IS linear", c2.is_linear);
    let c3: SuperpowerRustCapability = superpower_rust_capability_new("ReadOnly", 3);
    rust_assert("ReadOnly is NOT linear", c3.is_linear == false);
}

fn test_capability_initial_moved_state() {
    let c: SuperpowerRustCapability = superpower_rust_capability_new("NetCap", 5);
    rust_assert("initial is_moved == false", c.is_moved == false);
}

fn test_move_capability_affine() {
    let c0: SuperpowerRustCapability = superpower_rust_capability_new("FsReadCap", 1);
    let c1: SuperpowerRustCapability = superpower_rust_move_capability(c0, 2);
    rust_assert("first move is_moved true", c1.is_moved);
    let c2: SuperpowerRustCapability = superpower_rust_move_capability(c1, 3);
    rust_assert("second move (double move) is REFUSED", c2.is_moved == false);
}

fn test_arc_elision_dynamic() {
    let e0: SuperpowerRustArcElision = superpower_rust_evaluate_arc_elision(0);
    rust_assert("0 allocs is NOT zero cost", e0.is_zero_cost == false);
    rust_assert("0 allocs overhead_reduction_pct == 0", e0.overhead_reduction_pct == 0);
    let e2: SuperpowerRustArcElision = superpower_rust_evaluate_arc_elision(50000);
    rust_assert("50000 allocs overhead_reduction_pct == 95", e2.overhead_reduction_pct == 95);
    let elided: Int = e2.elided_refcounts;
    let expected: Int = (50000 * 95) / 100;
    rust_assert("elided_refcounts computed from input", elided == expected);
}

pub fn main() {
    println("audit_rust_caps: starting");
    test_capability_linearity();
    println("step1 ok");
    test_capability_initial_moved_state();
    println("step2 ok");
    test_move_capability_affine();
    println("step3 ok");
    test_arc_elision_dynamic();
    println("step4 ok");
    println("audit_rust_caps: AUDIT COMPLETE (see findings in source)");
}
