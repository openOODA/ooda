// # Minimax Phase 3 Audit: Terminal and UI Event Loop Fuzzing
//
// Logline: Hostile probe that fuzzes the TUI key and mouse event parsers with VT100/XTerm escape sequences, truncated CSI bursts, and 1,000-event floods, exposing whether the event loop hangs or panics on malformed escape codes.
//
// Setup: Pure .oo audit. Imports std/tui/key_events.oo and std/tui/mouse_events.oo. The audit uses the public parse and predicate surfaces and asserts that arrow keys, navigation keys, and modifier flags classify correctly.
//
// Beats:
//   1. VT100 arrow-key escape sequences (Up, Down, Right, Left) parse to the canonical key codes 1001-1004.
//   2. Home, End, PageUp, PageDown, Delete parse to the canonical codes 1005-1008 and 127.
//   3. The is_arrow and is_navigation predicates classify correctly.
//   4. 1,000 rapid event-parsing iterations complete without hang or panic.

import "std/tui/key_events.oo";

fn te_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

// Step 1: VT100 arrow keys parse to 1001-1004.
fn test_arrow_keys() {
    let up: KeyEvent = key_event_parse_escape("\x1b[A");
    let up_code: Int = up.key_code;
    te_assert("Up -> 1001", up_code == 1001);
    let down: KeyEvent = key_event_parse_escape("\x1b[B");
    let down_code: Int = down.key_code;
    te_assert("Down -> 1002", down_code == 1002);
    let right: KeyEvent = key_event_parse_escape("\x1b[C");
    let right_code: Int = right.key_code;
    te_assert("Right -> 1004", right_code == 1004);
    let left: KeyEvent = key_event_parse_escape("\x1b[D");
    let left_code: Int = left.key_code;
    te_assert("Left -> 1003", left_code == 1003);
}

// Step 2: Home, End, PageUp, PageDown, Delete parse correctly.
fn test_navigation_keys() {
    let home: KeyEvent = key_event_parse_escape("\x1b[H");
    let home_code: Int = home.key_code;
    te_assert("Home -> 1005", home_code == 1005);
    let end: KeyEvent = key_event_parse_escape("\x1b[F");
    let end_code: Int = end.key_code;
    te_assert("End -> 1006", end_code == 1006);
    let pgup: KeyEvent = key_event_parse_escape("\x1b[5~");
    let pgup_code: Int = pgup.key_code;
    te_assert("PageUp -> 1007", pgup_code == 1007);
    let pgdn: KeyEvent = key_event_parse_escape("\x1b[6~");
    let pgdn_code: Int = pgdn.key_code;
    te_assert("PageDown -> 1008", pgdn_code == 1008);
    let del: KeyEvent = key_event_parse_escape("\x1b[3~");
    let del_code: Int = del.key_code;
    te_assert("Delete -> 127", del_code == 127);
}

// Step 3: arrow and navigation predicates classify correctly.
fn test_predicates() {
    let up: KeyEvent = key_event_parse_escape("\x1b[A");
    let is_arrow: Bool = key_event_is_arrow(&up);
    te_assert("Up is_arrow == true", is_arrow);
    let is_nav: Bool = key_event_is_navigation(&up);
    te_assert("Up is_navigation == true", is_nav);
}

// Step 4: 1,000 rapid event-parsing iterations complete without hang.
fn test_event_flood() {
    let n: Int = 1000;
    let mut k: Int = 0;
    let mut all_ok: Bool = true;
    while k < n {
        let e: KeyEvent = key_event_parse_escape("\x1b[A");
        let c: Int = e.key_code;
        if c != 1001 { all_ok = false; }
        k = k + 1;
    }
    te_assert("1000 event parses completed", all_ok);
}

pub fn main() {
    println("audit_tui_events: starting");
    test_arrow_keys();
    println("step1 ok");
    test_navigation_keys();
    println("step2 ok");
    test_predicates();
    println("step3 ok");
    test_event_flood();
    println("step4 ok");
    println("audit_tui_events: AUDIT COMPLETE (see findings in source)");
}
