// # Minimax Audit: Stage 48 Formal SMT Contract Prover Red-Team
//
// Logline: Hostile probe that imports std/prove/tier4_formal_smt_matrix.oo and asserts genuine SMT formula solving and contradiction rejection.
//
// Setup: Pure .oo audit. Reads the public contract_new and evaluate functions and verifies real contract verification behavior.
//
// Beats:
//   1. Verify contract_new rejects false/invalid formulas and approves valid contract propositions.
//   2. Verify evaluate distinguishes 0 from positive contracts with counterexample reporting.
//   3. Verify Landlock jails verified scaling on verified capability scopes.
//   4. Assert all SMT verification checks pass cleanly.

import "std/prove/tier4_formal_smt_matrix.oo";

fn smt_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

fn test_contract_new_smt() {
    let c1: Tier4FormalSmtMatrixContract = tier4_formal_smt_matrix_contract_new("0 == 1", 1, 1);
    smt_assert("'0 == 1' is NOT provable (UNSAT)", c1.is_provable == false);
    let c2: Tier4FormalSmtMatrixContract = tier4_formal_smt_matrix_contract_new("", 0, 0);
    smt_assert("empty contract is NOT provable", c2.is_provable == false);
    let c3: Tier4FormalSmtMatrixContract = tier4_formal_smt_matrix_contract_new("division by zero", -1, -1);
    smt_assert("negative clauses is NOT provable", c3.is_provable == false);
    let c_valid: Tier4FormalSmtMatrixContract = tier4_formal_smt_matrix_contract_new("x > 0 implies x >= 0", 2, 2);
    smt_assert("valid contract IS provable", c_valid.is_provable);
}

fn test_evaluate_with_varied_counts() {
    let r0: Tier4FormalSmtMatrixReport = tier4_formal_smt_matrix_evaluate(0);
    smt_assert("0 contracts is NOT certified", r0.is_tier4_certified == false);
    smt_assert("0 contracts counterexamples_found > 0", r0.counterexamples_found > 0);
    let r_big: Tier4FormalSmtMatrixReport = tier4_formal_smt_matrix_evaluate(1000000);
    smt_assert("1M contracts counterexamples_found is 0", r_big.counterexamples_found == 0);
    smt_assert("1M contracts is certified", r_big.is_tier4_certified);
}

fn test_landlock_jails_scaling() {
    let r: Tier4FormalSmtMatrixReport = tier4_formal_smt_matrix_evaluate(50);
    let jails: Int = r.landlock_jails_verified;
    smt_assert("landlock_jails_verified is 50 for 50 contracts", jails == 50);
}

fn test_audit_record() {
    let r: Tier4FormalSmtMatrixReport = tier4_formal_smt_matrix_evaluate(42);
    let proved: Int = r.total_contracts_proved;
    smt_assert("total_contracts_proved is 42", proved == 42);
}

pub fn main() {
    println("audit_smt_contracts: starting");
    test_contract_new_smt();
    println("step1 ok");
    test_evaluate_with_varied_counts();
    println("step2 ok");
    test_landlock_jails_scaling();
    println("step3 ok");
    test_audit_record();
    println("step4 ok");
    println("audit_smt_contracts: AUDIT COMPLETE (see findings in source)");
}
