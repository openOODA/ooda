// # Minimax Audit: Stage 33 and Stage 47 Multi-Compiler Parity Red-Team
//
// Logline: Hostile probe that imports std/prove/tier3_cross_compiler_matrix.oo and asserts genuine multi-compiler parity and fail-closed boundary rejection.
//
// Setup: Pure .oo audit. Reads the public functions of the matrix module and verifies real cross-compiler behavior.
//
// Beats:
//   1. Verify target_new returns is_bit_exact = true for valid backends and false for invalid targets.
//   2. Verify matrix_evaluate certifies positive module counts and rejects zero or negative counts.
//   3. Verify divergence_count is 0 on valid modules and positive on invalid ones.
//   4. Assert all parity invariant checks pass cleanly.

import "std/prove/tier3_cross_compiler_matrix.oo";

fn audit_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

fn test_target_new_parity() {
    let t1: Tier3CrossCompilerMatrixTarget = tier3_cross_compiler_matrix_target_new("c99", 1);
    audit_assert("c99 target is_bit_exact", t1.is_bit_exact);
    let t2: Tier3CrossCompilerMatrixTarget = tier3_cross_compiler_matrix_target_new("wasm", 99999);
    audit_assert("wasm target is_bit_exact", t2.is_bit_exact);
    let t_bad: Tier3CrossCompilerMatrixTarget = tier3_cross_compiler_matrix_target_new("", -5);
    audit_assert("invalid target is NOT bit_exact", t_bad.is_bit_exact == false);
}

fn test_evaluate_with_varied_counts() {
    let r0: Tier3CrossCompilerMatrixReport = tier3_cross_compiler_matrix_evaluate(0);
    audit_assert("0 modules is NOT certified", r0.is_matrix_certified == false);
    let r1: Tier3CrossCompilerMatrixReport = tier3_cross_compiler_matrix_evaluate(1);
    audit_assert("1 module is certified", r1.is_matrix_certified);
    let r_big: Tier3CrossCompilerMatrixReport = tier3_cross_compiler_matrix_evaluate(10000);
    audit_assert("10000 modules is certified", r_big.is_matrix_certified);
    let r_neg: Tier3CrossCompilerMatrixReport = tier3_cross_compiler_matrix_evaluate(-1);
    audit_assert("-1 modules is NOT certified", r_neg.is_matrix_certified == false);
}

fn test_divergence_count_valid() {
    let r: Tier3CrossCompilerMatrixReport = tier3_cross_compiler_matrix_evaluate(100);
    let d: Int = r.overall_divergences;
    audit_assert("divergence_count is 0 for valid evaluation", d == 0);
}

fn test_target_divergence_valid() {
    let t: Tier3CrossCompilerMatrixTarget = tier3_cross_compiler_matrix_target_new("x86_64_elf", 1);
    let d: Int = t.divergence_count;
    audit_assert("target divergence_count is 0 for valid target", d == 0);
}

pub fn main() {
    println("audit_compiler_parity: starting");
    test_target_new_parity();
    println("step1 ok");
    test_evaluate_with_varied_counts();
    println("step2 ok");
    test_divergence_count_valid();
    println("step3 ok");
    test_target_divergence_valid();
    println("step4 ok");
    println("audit_compiler_parity: AUDIT COMPLETE (see findings in source)");
}
