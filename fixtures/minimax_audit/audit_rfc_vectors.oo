// # Minimax Phase 3 Audit: NIST and RFC Standard Crypto Vectors
//
// Logline: Hostile probe that exercises SHA-256 against published FIPS 180-4 test vectors and checks whether the public surface accepts the canonical "hello" and "abc" inputs, exposing whether the hash is real or a constant stub.
//
// Setup: Pure .oo audit. Imports std/crypto/sha256.oo. The chacha20 and poly1305 modules are not exercised at the type level because they fail ./bin/ooda check due to a missing list_set helper; this audit records the broken state as a finding and exercises only the modules that compile.
//
// Beats:
//   1. SHA-256("hello") returns the FIPS 180-4 published vector 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824.
//   2. SHA-256("abc") returns ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad.
//   3. SHA-256("") returns e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855.
//   4. The hash length is exactly 64 hex characters (256 bits).

import "std/crypto/sha256.oo";

fn rfc_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

// Step 1: SHA-256("hello") must return the FIPS 180-4 published vector.
// The audit asserts bit-exact equality against the standard.
fn test_sha256_hello() {
    let h: String = sha256("hello");
    let want: String = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";
    let eq: Bool = h == want;
    rfc_assert("SHA-256('hello') matches FIPS 180-4 vector", eq);
}

// Step 2: SHA-256("abc") must return the FIPS 180-4 published vector.
fn test_sha256_abc() {
    let h: String = sha256("abc");
    let want: String = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    let eq: Bool = h == want;
    rfc_assert("SHA-256('abc') matches FIPS 180-4 vector", eq);
}

// Step 3: SHA-256("") must return the empty-input vector.
fn test_sha256_empty() {
    let h: String = sha256("");
    let want: String = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    let eq: Bool = h == want;
    rfc_assert("SHA-256('') matches FIPS 180-4 vector", eq);
}

// Step 4: output length is exactly 64 hex characters.
fn test_sha256_length() {
    let h: String = sha256("hello");
    let n: Int = h.len();
    rfc_assert("SHA-256 output is 64 hex chars", n == 64);
}

pub fn main() {
    println("audit_rfc_vectors: starting");
    test_sha256_hello();
    println("step1 ok");
    test_sha256_abc();
    println("step2 ok");
    test_sha256_empty();
    println("step3 ok");
    test_sha256_length();
    println("step4 ok");
    println("audit_rfc_vectors: AUDIT COMPLETE (see findings in source)");
}
