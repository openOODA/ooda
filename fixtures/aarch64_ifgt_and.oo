// # if 1 > 2 && true is leftover
//
// Logline: An && tail after INT>INT must fail closed.
//
// Setup: Folded INT GT INT requires LBRACE next. Sibling of locked if_tail.
//
// Beats:
//   1. if 1 > 2 && true print THEN.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if 1 > 2 && true {
        println("THEN");
    }
}
