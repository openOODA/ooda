// # Product prove std/fintech_defi/options_asian.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/options_asian.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_asian: PASSED only if they match.

import "std/fintech_defi/options_asian.oo";

pub fn main() {
    let options_asian_mark: Int = 0;
    if options_asian_mark != 0 {
        process_exit(1);
    }
    let options_asian_a: Float = int_to_float(1);
    let options_asian_b: Float = int_to_float(1);
    if options_asian_a != options_asian_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_options_asian: PASSED");
}
