// # Product prove std/protein_folding/alphafold_plddt_confidence.oo
//
// Logline: Fail-closed emit+gcc+run asserts af_classify_plddt is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/alphafold_plddt_confidence.oo.
//
// Beats:
//   1. Call af_classify_plddt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_alphafold_plddt_confidence: PASSED only if they match.

import "std/protein_folding/alphafold_plddt_confidence.oo";

pub fn main() {
    let alphafold_plddt_confidence_mark: Int = 0;
    if alphafold_plddt_confidence_mark != 0 {
        process_exit(1);
    }
    let a: String = af_classify_plddt(0.0);
    let b: String = af_classify_plddt(0.0);
    if a != b {
        println("FAIL af_classify_plddt");
        process_exit(1);
    }
    println("prod_alphafold_plddt_confidence: PASSED");
}
