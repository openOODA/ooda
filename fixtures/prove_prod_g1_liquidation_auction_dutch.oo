// # Product prove std/defi_derivatives/liquidation_auction_dutch.oo
//
// Logline: Fail-closed emit+gcc+run asserts dutch_auction_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/liquidation_auction_dutch.oo.
//
// Beats:
//   1. Call dutch_auction_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_liquidation_auction_dutch: PASSED only if they match.

import "std/defi_derivatives/liquidation_auction_dutch.oo";

pub fn main() {
    let a: DutchAuctionConfig = dutch_auction_config_default();
    let b: DutchAuctionConfig = dutch_auction_config_default();
    if a.auction_duration_sec != b.auction_duration_sec {
        println("FAIL dutch_auction_config_default");
        process_exit(1);
    }
    println("prod_liquidation_auction_dutch: PASSED");
}
