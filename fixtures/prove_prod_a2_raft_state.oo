// # Product prove std/cloud/raft_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts raft_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/raft_state.oo.
//
// Beats:
//   1. Call raft_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_raft_state: PASSED only if they match.

import "std/cloud/raft_state.oo";

pub fn main() {
    let a: RaftNodeState = raft_state_new("x", 0);
    let b: RaftNodeState = raft_state_new("x", 0);
    if (a).current_term != (b).current_term {
        println("FAIL raft_state_new");
        process_exit(1);
    }
    println("prod_raft_state: PASSED");
}
