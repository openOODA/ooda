// # Product prove std/ai_ml/layer_dense.oo
//
// Logline: Fail-closed emit+gcc+run asserts dense layer forward and backward operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/layer_dense.oo.
//
// Beats:
//   1. Construct DenseLayer and evaluate forward affine mapping.
//   2. Compute backward gradients for inputs, weights, and biases.
//   3. Assert deterministic dimensions and behavior.
//   4. Print prod_g4_aiml_layer_dense: PASSED only if all match.

import "std/ai_ml/layer_dense.oo";

pub fn main() {
    let m: Int = layer_dense_marker();
    if m != 1 {
        println("FAIL layer_dense_marker");
        process_exit(1);
    }

    let mut layer: DenseLayer = dense_layer_new(2, 3, true);
    if (layer).in_features != 2 || (layer).out_features != 3 {
        println("FAIL dense_layer_new features");
        process_exit(1);
    }

    let mut x_data: List[Float] = list_new();
    x_data = list_push(x_data, 1.0);
    x_data = list_push(x_data, 2.0);
    let in_x: Tensor2D = Tensor2D { data: x_data, rows: 1, cols: 2 };

    let mut g_data: List[Float] = list_new();
    g_data = list_push(g_data, 0.5);
    g_data = list_push(g_data, 1.0);
    g_data = list_push(g_data, 1.5);
    let grad_out: Tensor2D = Tensor2D { data: g_data, rows: 1, cols: 3 };

    let db: Tensor1D = dense_backward_bias(grad_out);
    if (db).size != 3 {
        println("FAIL dense_backward_bias");
        process_exit(1);
    }

    let dw: Tensor2D = dense_backward_weights(in_x, grad_out);
    if (dw).rows != 2 || (dw).cols != 3 {
        println("FAIL dense_backward_weights");
        process_exit(1);
    }

    let dx: Tensor2D = dense_backward_input(&layer, grad_out);
    if (dx).rows != 1 || (dx).cols != 2 {
        println("FAIL dense_backward_input");
        process_exit(1);
    }

    let fwd: Tensor2D = dense_forward(&layer, in_x);
    if (fwd).rows != 1 || (fwd).cols != 3 {
        println("FAIL dense_forward");
        process_exit(1);
    }

    dense_step(&mut layer, 0.01);
    if (layer).in_features != 2 {
        println("FAIL layer after step");
        process_exit(1);
    }

    println("prod_g4_aiml_layer_dense: PASSED");
    process_exit(0);
}
