// # Product prove std/fin/hft_stubs.oo
//
// Logline: Fail-closed verification of HFT stub imports and market microstructure pricing.
//
// Setup: Isolated emit-c. Imports std/fin/hft_stubs.oo.
//
// Beats:
//   1. Construct tick data and evaluate bid-ask spread and mid-price.
//   2. Create market order and assert quantity tracking.
//   3. Assert deterministic return values.
//   4. Print prod_g4_fin_hft_stubs: PASSED and exit 0.

import "std/fin/hft_stubs.oo";

pub fn main() {
    let tick1: TickData = tick_data_create("AAPL", 15000, 100, 14995, 15005, 500, 500, 1000000, 1, "NASDAQ", true);
    let tick2: TickData = tick_data_create("AAPL", 15000, 100, 14995, 15005, 500, 500, 1000000, 1, "NASDAQ", true);

    let sp1: Int = tick_data_calculate_spread(tick1);
    let sp2: Int = tick_data_calculate_spread(tick2);
    if sp1 != sp2 || sp1 != 10 {
        println("FAIL tick_data_calculate_spread");
        process_exit(1);
    }

    let mid1: Int = tick_data_calculate_mid_price(tick1);
    let mid2: Int = tick_data_calculate_mid_price(tick2);
    if mid1 != mid2 || mid1 != 15000 {
        println("FAIL tick_data_calculate_mid_price");
        process_exit(1);
    }

    let order1: MarketOrder = market_order_create(1, "AAPL", 1, 100, 15000, 0, 1000000);
    let rem: Int = market_order_remaining_qty(order1);
    if rem != 100 {
        println("FAIL market_order_remaining_qty");
        process_exit(1);
    }

    let filled: Bool = market_order_is_filled(order1);
    if filled != false {
        println("FAIL market_order_is_filled");
        process_exit(1);
    }

    println("prod_g4_fin_hft_stubs: PASSED");
    process_exit(0);
}
