// # Product prove std/neuro_bci/spike_sorting_pca_kmeans.oo
//
// Logline: Fail-closed emit+gcc+run asserts spike_sorting_pca_kmeans_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_sorting_pca_kmeans.oo.
//
// Beats:
//   1. Call spike_sorting_pca_kmeans_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_spike_sorting_pca_kmeans: PASSED only if it matches.

import "std/neuro_bci/spike_sorting_pca_kmeans.oo";

pub fn main() {
    let a: Int = spike_sorting_pca_kmeans_probe();
    if a != 0 {
        println("FAIL spike_sorting_pca_kmeans_probe");
        process_exit(1);
    }
    println("prod_nc_spike_sorting_pca_kmeans: PASSED");
}
