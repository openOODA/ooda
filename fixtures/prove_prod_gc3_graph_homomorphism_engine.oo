// # Product prove std/db_graph/graph_homomorphism_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts homomorphism_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_homomorphism_engine.oo.
//
// Beats:
//   1. Call homomorphism_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_homomorphism_engine: PASSED only if they match.

import "std/db_graph/graph_homomorphism_engine.oo";

pub fn main() {
    let graph_homomorphism_engine_mark: Int = 0;
    if graph_homomorphism_engine_mark != 0 {
        process_exit(1);
    }
    let graph_homomorphism_engine_a = homomorphism_result_new();
    let graph_homomorphism_engine_b = homomorphism_result_new();
    if (graph_homomorphism_engine_a).total_homomorphisms != (graph_homomorphism_engine_b).total_homomorphisms {
        println("FAIL homomorphism_result_new");
        process_exit(1);
    }
    println("prod_graph_homomorphism_engine: PASSED");
}
