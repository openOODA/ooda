// # Refuse a secret mmap path
//
// Logline: A tagged name must not reach the mmap path argument.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the mmap path.
//   3. Expect the sink to refuse.

// M-? mmap taint: secret must not reach mmap path arg
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "/lib/secret.so";
    let r = mmap(ffi, 4096, token);
    println(1);
}
