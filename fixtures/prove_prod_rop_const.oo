// # Product prove std/sec/sys/rop_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts gadget_type_unknown is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop_const.oo.
//
// Beats:
//   1. Call gadget_type_unknown twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rop_const: PASSED only if they match.

import "std/sec/sys/rop_const.oo";

pub fn main() {
    let a = gadget_type_unknown();
    let b = gadget_type_unknown();
    if a != b {
        println("FAIL gadget_type_unknown");
        process_exit(1);
    }
    println("prod_rop_const: PASSED");
}
