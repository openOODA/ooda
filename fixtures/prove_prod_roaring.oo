// # Product roaring_bitmap prove
//
// Logline: Fail-closed emit+gcc+run of shipped roaring_add/contains/len.
//
// Setup: Product std/collections/roaring_bitmap.oo. Add 3.
//
// Beats:
//   1. After add 3, contains 3 true, contains 2 false, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/roaring_bitmap.oo";

pub fn main() {
    let mut r: RoaringBitmap = roaring_new();
    r = roaring_add(r, 3);
    let n: Int = roaring_len(r);
    if n != 1 {
        println("FAIL roaring len");
        process_exit(1);
    }
    let c3: Bool = roaring_contains(r, 3);
    if c3 == false {
        println("FAIL roaring contains 3");
        process_exit(1);
    }
    let c2: Bool = roaring_contains(r, 2);
    if c2 == true {
        println("FAIL roaring contains 2");
        process_exit(1);
    }
    println("prod_roaring: PASSED");
}
