// # Product prove std/web_ecosystem/color_chalk.oo
//
// Logline: Fail-closed emit+gcc+run asserts chalk_wrap is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/color_chalk.oo.
//
// Beats:
//   1. Call chalk_wrap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_color_chalk: PASSED only if they match.

import "std/web_ecosystem/color_chalk.oo";
import "std/str.oo";

pub fn main() {
    let color_chalk_mark: Int = 0;
    if color_chalk_mark != 0 {
        process_exit(1);
    }
    let color_chalk_a: String = chalk_wrap("x", "x", "x");
    let color_chalk_b: String = chalk_wrap("x", "x", "x");
    if str_eq(color_chalk_a, color_chalk_b) == false {
        println("FAIL chalk_wrap");
        process_exit(1);
    }
    println("prod_color_chalk: PASSED");
}
