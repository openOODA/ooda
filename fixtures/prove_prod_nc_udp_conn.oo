// # Product prove std/net/udp_conn.oo
//
// Logline: Fail-closed emit+gcc+run asserts udp_conn_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/net/udp_conn.oo.
//
// Beats:
//   1. Call udp_conn_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_udp_conn: PASSED only if it matches.

import "std/net/udp_conn.oo";

pub fn main() {
    let a: Int = udp_conn_probe();
    if a != 0 {
        println("FAIL udp_conn_probe");
        process_exit(1);
    }
    println("prod_nc_udp_conn: PASSED");
}
