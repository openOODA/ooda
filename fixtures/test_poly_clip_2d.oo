// # Polygon clip adversarial suite
//
// Logline: Clips a simple subject against a convex window, including parallel, vertex-on-edge, and disjoint cases.
//
// Setup: Pure. Imports poly_clip_2d.oo. Run from ooda/.
//
// Beats:
//   1. Clip a triangle against a unit-scale square and require a nonempty result.
//   2. Feed a parallel edge and a vertex on a clip edge without crashing.
//   3. Clip a disjoint triangle and require an empty polygon.

import "std/gis_spatial/poly_clip_2d.oo";

pub fn main() {
    let mut clip: List[Float] = list_new();
    clip = list_push(clip, 0.0);
    clip = list_push(clip, 0.0);
    clip = list_push(clip, 10.0);
    clip = list_push(clip, 0.0);
    clip = list_push(clip, 10.0);
    clip = list_push(clip, 10.0);
    clip = list_push(clip, 0.0);
    clip = list_push(clip, 10.0);

    let mut subj: List[Float] = list_new();
    subj = list_push(subj, 0.0 - 2.0);
    subj = list_push(subj, 0.0 - 2.0);
    subj = list_push(subj, 5.0);
    subj = list_push(subj, 5.0);
    subj = list_push(subj, 0.0 - 2.0);
    subj = list_push(subj, 5.0);
    let o: PolyOut = poly_clip_2d(subj, clip);
    let of: Int = o.flag;
    if of < 1 {
        println("FAIL clip " + o.err);
        process_exit(1);
    }
    if o.n < 1 {
        println("FAIL expected overlap");
        process_exit(1);
    }
    println("convex clip of a simple subject");

    let mut par: List[Float] = list_new();
    par = list_push(par, 0.0);
    par = list_push(par, 0.0 - 1.0);
    par = list_push(par, 10.0);
    par = list_push(par, 0.0 - 1.0);
    par = list_push(par, 10.0);
    par = list_push(par, 1.0);
    par = list_push(par, 0.0);
    par = list_push(par, 1.0);
    let p2: PolyOut = poly_clip_2d(par, clip);
    let p2f: Int = p2.flag;
    if p2f < 1 {
        println("FAIL parallel " + p2.err);
        process_exit(1);
    }
    println("parallel and vertex-on-edge do not crash");

    let mut on: List[Float] = list_new();
    on = list_push(on, 0.0);
    on = list_push(on, 0.0);
    on = list_push(on, 5.0);
    on = list_push(on, 0.0);
    on = list_push(on, 0.0);
    on = list_push(on, 5.0);
    let p3: PolyOut = poly_clip_2d(on, clip);
    let p3f: Int = p3.flag;
    if p3f < 1 {
        println("FAIL on-edge " + p3.err);
        process_exit(1);
    }

    let mut far: List[Float] = list_new();
    far = list_push(far, 100.0);
    far = list_push(far, 100.0);
    far = list_push(far, 110.0);
    far = list_push(far, 100.0);
    far = list_push(far, 110.0);
    far = list_push(far, 110.0);
    let p4: PolyOut = poly_clip_2d(far, clip);
    let p4f: Int = p4.flag;
    if p4f < 1 {
        println("FAIL disjoint err");
        process_exit(1);
    }
    if p4.n > 0 {
        println("FAIL disjoint nonempty");
        process_exit(1);
    }
    println("disjoint subject vs clip is empty");
    println("SUITE PASSED");
    println("test_poly_clip_2d: PASSED");
}
