// # Product prove std/graph_networks/hyperanf_graph_diameter.oo
//
// Logline: Fail-closed emit+gcc+run asserts hyperanf_pow2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/hyperanf_graph_diameter.oo.
//
// Beats:
//   1. Call hyperanf_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hyperanf_graph_diameter: PASSED only if they match.

import "std/graph_networks/hyperanf_graph_diameter.oo";

pub fn main() {
    let hyperanf_graph_diameter_mark: Int = 0;
    if hyperanf_graph_diameter_mark != 0 {
        process_exit(1);
    }
    let hyperanf_graph_diameter_a: Int = hyperanf_pow2(1);
    let hyperanf_graph_diameter_b: Int = hyperanf_pow2(1);
    if hyperanf_graph_diameter_a != hyperanf_graph_diameter_b {
        println("FAIL hyperanf_pow2");
        process_exit(1);
    }
    println("prod_hyperanf_graph_diameter: PASSED");
}
