// # Product prove std/astro_advanced/halo_orbit_cr3bp.oo
//
// Logline: Fail-closed emit+gcc+run asserts halo_libration is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/halo_orbit_cr3bp.oo.
//
// Beats:
//   1. Call halo_libration twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_halo_orbit_cr3bp: PASSED only if they match.

import "std/astro_advanced/halo_orbit_cr3bp.oo";

pub fn main() {
    let a = halo_libration();
    let b = halo_libration();
    if a != b {
        println("FAIL halo_libration");
        process_exit(1);
    }
    println("prod_halo_orbit_cr3bp: PASSED");
}
