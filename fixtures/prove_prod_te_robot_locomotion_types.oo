// # Product prove std/robot/locomotion_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/locomotion_types.oo.
//
// Beats:
//   1. Call vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_locomotion_types: PASSED only if they match.

import "std/robot/locomotion_types.oo";

pub fn main() {
    let locomotion_types_mark: Int = 0;
    if locomotion_types_mark != 0 {
        process_exit(1);
    }
    let a: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let b: Vec3 = vec3_new(0.0, 0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL vec3_new");
        process_exit(1);
    }
    println("prod_locomotion_types: PASSED");
}
