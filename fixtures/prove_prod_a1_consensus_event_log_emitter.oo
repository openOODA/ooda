// # Product prove std/bft_consensus/consensus_event_log_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts event_log_buffer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/consensus_event_log_emitter.oo.
//
// Beats:
//   1. Call event_log_buffer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_consensus_event_log_emitter: PASSED only if they match.

import "std/bft_consensus/consensus_event_log_emitter.oo";

pub fn main() {
    let consensus_event_log_emitter_mark: Int = 0;
    if consensus_event_log_emitter_mark != 0 {
        process_exit(1);
    }
    let a: EventLogBuffer = event_log_buffer_new();
    let b: EventLogBuffer = event_log_buffer_new();
    if (a).total_events_emitted != (b).total_events_emitted {
        println("FAIL event_log_buffer_new");
        process_exit(1);
    }
    println("prod_consensus_event_log_emitter: PASSED");
}
