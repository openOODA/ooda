// # Deref constant field write emit lock
//
// Logline: Fail-closed emit+gcc+run of (*c).v = 0 write-through on &mut Cell.
//
// Setup: Backend-C. Constant RHS must mutate the caller Cell. Increment is a different lock.
//
// Beats:
//   1. Bind mut Cell v 10.
//   2. zero(&mut x) writes (*c).v = 0.
//   3. Exit 1 before PASSED when x.v is not 0.

type Cell = struct {
    v: Int
};

pub fn zero(c: &mut Cell) {
    (*c).v = 0;
}

pub fn main() {
    let mut x = Cell { v: 10 };
    zero(&mut x);
    if x.v != 0 {
        println("FAIL");
        process_exit(1);
    }
    println("deref_const_write_smoke: PASSED");
}
