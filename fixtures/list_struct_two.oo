// # Two struct list types in one file
//
// Logline: Fail-closed emit+gcc+run of List[Node] and List[Edge] together.
//
// Setup: Backend-C. Two user structs each own a list.
//
// Beats:
//   1. Push one Node and one Edge.
//   2. Get each and match fields.
//   3. Exit 1 before PASSED on a miss.

type Node = struct {
    id: Int,
    tag: String
};

type Edge = struct {
    src: Int,
    dst: Int
};

pub fn main() {
    let mut ns: List[Node] = list_new();
    let mut es: List[Edge] = list_new();
    let n0: Node = Node { id: 1, tag: "a" };
    let e0: Edge = Edge { src: 1, dst: 2 };
    ns = list_push(ns, n0);
    es = list_push(es, e0);
    let ng: Node = list_get(ns, 0);
    let eg: Edge = list_get(es, 0);
    if ng.id != 1 {
        println("FAIL node id");
        process_exit(1);
    }
    if ng.tag != "a" {
        println("FAIL node tag");
        process_exit(1);
    }
    if eg.src != 1 {
        println("FAIL edge src");
        process_exit(1);
    }
    if eg.dst != 2 {
        println("FAIL edge dst");
        process_exit(1);
    }
    if list_len(ns) != 1 {
        println("FAIL node len");
        process_exit(1);
    }
    if list_len(es) != 1 {
        println("FAIL edge len");
        process_exit(1);
    }
    println("list_struct_two: PASSED");
}
