// # Product prove std/os/temp_file_atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/temp_file_atomic.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/temp_file_atomic.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_temp_file_atomic: PASSED only if they match.

import "std/os/temp_file_atomic.oo";

pub fn main() {
    let temp_file_atomic_a = temp_file_make_name("x", 0);
    let temp_file_atomic_b = temp_file_make_name("x", 0);
    if temp_file_atomic_a.contains(temp_file_atomic_b) == false {
        println("FAIL temp_file_atomic");
        process_exit(1);
    }
    if temp_file_atomic_b.contains(temp_file_atomic_a) == false {
        println("FAIL temp_file_atomic");
        process_exit(1);
    }
    println("prod_ap_temp_file_atomic: PASSED");
}
