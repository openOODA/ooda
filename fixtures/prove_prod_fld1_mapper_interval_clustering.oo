// # Product prove std/tda_topology/mapper_interval_clustering.oo
//
// Logline: Fail-closed emit+gcc+run asserts mapper_cover_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/mapper_interval_clustering.oo.
//
// Beats:
//   1. Call mapper_cover_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mapper_interval_clustering: PASSED only if they match.

import "std/tda_topology/mapper_interval_clustering.oo";

pub fn main() {
    let mapper_interval_clustering_mark: Int = 0;
    if mapper_interval_clustering_mark != 0 {
        process_exit(1);
    }
    let mapper_interval_clustering_a = mapper_cover_new(1, 1.0, 1.0, 1.0);
    let mapper_interval_clustering_b = mapper_cover_new(1, 1.0, 1.0, 1.0);
    if (mapper_interval_clustering_a).num_intervals != (mapper_interval_clustering_b).num_intervals {
        println("FAIL mapper_cover_new");
        process_exit(1);
    }
    println("prod_mapper_interval_clustering: PASSED");
}
