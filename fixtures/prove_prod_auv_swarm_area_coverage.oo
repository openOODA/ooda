// # Product prove std/robotics_auv/auv_swarm_area_coverage.oo
//
// Logline: Fail-closed emit+gcc+run asserts area_coverage_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_swarm_area_coverage.oo.
//
// Beats:
//   1. Call area_coverage_config_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_swarm_area_coverage: PASSED only if they match.

import "std/robotics_auv/auv_swarm_area_coverage.oo";

pub fn main() {
    let auv_swarm_area_coverage_mark: Int = 0;
    if auv_swarm_area_coverage_mark != 0 {
        process_exit(1);
    }
    let a: AreaCoverageConfig = area_coverage_config_default();
    let b: AreaCoverageConfig = area_coverage_config_default();
    if (a).field0 != (b).field0 {
        println("FAIL area_coverage_config_default");
        process_exit(1);
    }
    println("prod_auv_swarm_area_coverage: PASSED");
}
