// # Product prove std/neuro_bci/neural_mass_kuramoto_sync.oo
//
// Logline: Fail-closed emit+gcc+run asserts kuramoto_network4_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neural_mass_kuramoto_sync.oo.
//
// Beats:
//   1. Call kuramoto_network4_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kuramoto_default: PASSED only if they match.

import "std/neuro_bci/neural_mass_kuramoto_sync.oo";

pub fn main() {
    let neural_mass_kuramoto_sync_mark: Int = 0;
    if neural_mass_kuramoto_sync_mark != 0 { process_exit(1); }
    let a: KuramotoNetwork4 = kuramoto_network4_default(0.5);
    let b: KuramotoNetwork4 = kuramoto_network4_default(0.5);
    let ak: Float = (a).coupling_k;
    let bk: Float = (b).coupling_k;
    if ak != bk {
        println("FAIL kuramoto_network4_default");
        process_exit(1);
    }
    println("prod_kuramoto_default: PASSED");
}
