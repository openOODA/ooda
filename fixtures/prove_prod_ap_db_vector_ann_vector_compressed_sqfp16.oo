// # Product prove std/db_vector_ann/vector_compressed_sqfp16.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_compressed_sqfp16.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_compressed_sqfp16.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_vector_compressed_sqfp16: PASSED only if they match.

import "std/db_vector_ann/vector_compressed_sqfp16.oo";

pub fn main() {
    let vector_compressed_sqfp16_a = fp16_config_default(0);
    let vector_compressed_sqfp16_b = fp16_config_default(0);
    if vector_compressed_sqfp16_a.dimension != vector_compressed_sqfp16_b.dimension {
        println("FAIL vector_compressed_sqfp16");
        process_exit(1);
    }
    println("prod_ap_vector_compressed_sqfp16: PASSED");
}
