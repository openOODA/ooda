// # Product prove std/quantum/gate_rotation.oo
//
// Logline: Fail-closed emit+gcc+run asserts phase_shift_matrix holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_rotation.oo.
//
// Beats:
//   1. Call phase_shift_matrix using the gate_rotation ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_gate_rotation: PASSED only if asserts hold.

import "std/quantum/gate_rotation.oo";

pub fn main() {
    let obj = phase_shift_matrix(0.0);
    let gate_rotation_a = obj.m00.real;
    let gate_rotation_b = obj.m00.real;
    if gate_rotation_a != gate_rotation_b {
        println("FAIL phase_shift_matrix");
        process_exit(1);
    }
    println("prod_gate_rotation: PASSED");
}
