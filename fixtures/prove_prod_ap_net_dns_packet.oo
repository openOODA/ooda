// # Product prove std/net/dns_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net/dns_packet.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/dns_packet.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dns_packet: PASSED only if they match.

import "std/net/dns_packet.oo";

pub fn main() {
    let dns_packet_a = dns_type_a();
    let dns_packet_b = dns_type_a();
    if dns_packet_a != dns_packet_b {
        println("FAIL dns_packet");
        process_exit(1);
    }
    println("prod_ap_dns_packet: PASSED");
}
