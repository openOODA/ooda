// # Product prove std/pbr_raytracing/ray_sphere_analytic.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_sphere_analytic_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/ray_sphere_analytic.oo.
//
// Beats:
//   1. Call ray_sphere_analytic_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ray_sphere_analytic: PASSED only if it matches.

import "std/pbr_raytracing/ray_sphere_analytic.oo";

pub fn main() {
    let a: Int = ray_sphere_analytic_probe();
    if a != 0 {
        println("FAIL ray_sphere_analytic_probe");
        process_exit(1);
    }
    println("prod_nc_ray_sphere_analytic: PASSED");
}
