// # Product lru_cache prove
//
// Logline: Fail-closed emit+gcc+run of shipped lru_new/put/len.
//
// Setup: Product std/collections/lru_cache.oo. List[Int] destub.
//
// Beats:
//   1. After put 7->1, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/lru_cache.oo";

pub fn main() {
    let mut c: LruCache = lru_new(4);
    c = lru_put(c, 7, 1);
    let n: Int = lru_len(c);
    if n != 1 {
        println("FAIL lru len");
        process_exit(1);
    }
    println("prod_lru: PASSED");
}
