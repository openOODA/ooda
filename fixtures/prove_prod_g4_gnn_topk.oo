// # Product prove std/graph_gnn/gnn_topk_pooling.oo
//
// Logline: Fail-closed verification that Top-K graph pooling configuration, projection vector generation, and node scoring are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_topk_pooling.oo.
//
// Beats:
//   1. Construct TopKPoolingConfig and initialize projection vectors with deterministic seed.
//   2. Run topk_score_node on sample node feature inputs.
//   3. Assert deterministic return values.
//   4. Print prod_g4_gnn_topk: PASSED only if all match.

import "std/graph_gnn/gnn_topk_pooling.oo";

pub fn main() {
    let cfg1: TopKPoolingConfig = topk_pooling_config_new(4, 2);
    let cfg2: TopKPoolingConfig = topk_pooling_config_new(4, 2);
    if cfg1.in_features != cfg2.in_features {
        println("FAIL topk_pooling_config_new in_features");
        process_exit(1);
    }
    if cfg1.k_nodes_to_keep != cfg2.k_nodes_to_keep {
        println("FAIL topk_pooling_config_new k_nodes_to_keep");
        process_exit(1);
    }

    let p1: List[Int] = topk_init_projection(4, 123);
    let p2: List[Int] = topk_init_projection(4, 123);

    let mut feats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        feats = list_push(feats, i + 5);
        i = i + 1;
    }

    let s1_0: Int = topk_score_node(4, p1, feats, 0);
    let s2_0: Int = topk_score_node(4, p2, feats, 0);
    if s1_0 != s2_0 {
        println("FAIL topk_score_node node 0");
        process_exit(1);
    }

    let s1_1: Int = topk_score_node(4, p1, feats, 4);
    let s2_1: Int = topk_score_node(4, p2, feats, 4);
    if s1_1 != s2_1 {
        println("FAIL topk_score_node node 1");
        process_exit(1);
    }

    println("prod_g4_gnn_topk: PASSED");
    process_exit(0);
}
