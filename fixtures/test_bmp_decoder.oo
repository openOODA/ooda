// # BMP decoder adversarial suite
//
// Logline: Parses 14+40 headers for 24-bit and 32-bit uncompressed RGB and rejects truncated and compressed files.
//
// Setup: Pure. Imports bmp_decoder.oo. Run from ooda/.
//
// Beats:
//   1. Make a 2x1 24-bit image and parse width, height, bits, and stride.
//   2. Make a 32-bit image and parse it.
//   3. Reject a short buffer and a nonzero compression field.

import "std/multimedia/bmp_decoder.oo";

pub fn main() {
    let e24: ByteOut = bmp_decoder_make(2, 1, 24);
    if e24.flag < 1 {
        println("FAIL make24 " + e24.err);
        process_exit(1);
    }
    let p24: BmpOut = bmp_decoder_parse(e24.bytes);
    if p24.flag < 1 {
        println("FAIL parse24 " + p24.err);
        process_exit(1);
    }
    if p24.width != 2 {
        println("FAIL w");
        process_exit(1);
    }
    if p24.bits != 24 {
        println("FAIL bits24");
        process_exit(1);
    }
    if p24.stride != 8 {
        println("FAIL stride24");
        process_exit(1);
    }
    let e32: ByteOut = bmp_decoder_make(1, 1, 32);
    let p32: BmpOut = bmp_decoder_parse(e32.bytes);
    if p32.flag < 1 {
        println("FAIL parse32");
        process_exit(1);
    }
    if p32.bits != 32 {
        println("FAIL bits32");
        process_exit(1);
    }
    println("14+40 headers");
    println("24-bit and 32-bit uncompressed");
    println("4-byte row pad");
    let mut cut: List[Int] = list_new();
    cut = list_push(cut, 66);
    let bad: BmpOut = bmp_decoder_parse(cut);
    if bad.flag > 0 {
        println("FAIL short ok");
        process_exit(1);
    }
    let mut tam: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(e24.bytes) {
        if i == 30 {
            tam = list_push(tam, 1);
        } else {
            tam = list_push(tam, list_get(e24.bytes, i));
        }
        i = i + 1;
    }
    let cmp: BmpOut = bmp_decoder_parse(tam);
    if cmp.flag > 0 {
        println("FAIL compressed ok");
        process_exit(1);
    }
    println("truncated/compressed Err");
    println("SUITE PASSED");
    println("test_bmp_decoder: PASSED");
}
