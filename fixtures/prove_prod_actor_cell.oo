// # Product prove std/sync/actor_cell.oo
//
// Logline: Fail-closed emit+gcc+run asserts actor_cell_is_active is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/actor_cell.oo.
//
// Beats:
//   1. Call actor_cell_is_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_actor_cell: PASSED only if they match.

import "std/sync/actor_cell.oo";

pub fn main() {
    let obj = actor_cell_new(0);
    let a = actor_cell_is_active(obj);
    let b = actor_cell_is_active(obj);
    if a != b {
        println("FAIL actor_cell_is_active");
        process_exit(1);
    }
    println("prod_actor_cell: PASSED");
}
