//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_state_space_derivation.oo.
//
// Beats:
//   1. Call bond_graph_state_space_derivation_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bond_graph_state_space_derivation: PASSED only if they match.

import "std/digital_twin/bond_graph_state_space_derivation.oo";

pub fn main() {
    let a: Int = bond_graph_state_space_derivation_probe();
    let b: Int = bond_graph_state_space_derivation_probe();
    if a != b {
        println("FAIL bond_graph_state_space_derivation_probe");
        process_exit(1);
    }
    println("prod_g2_bond_graph_state_space_derivation: PASSED");
}
