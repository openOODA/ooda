// # Product prove std/sec/watermark_policy.oo
//
// Logline: Fail-closed emit+gcc+run asserts watermark_policy_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/watermark_policy.oo.
//
// Beats:
//   1. Call watermark_policy_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_watermark_policy: PASSED only if they match.

import "std/sec/watermark_policy.oo";

pub fn main() {
    let watermark_policy_mark: Int = 0;
    if watermark_policy_mark != 0 {
        process_exit(1);
    }
    let watermark_policy_a = watermark_policy_init(1, 1);
    let watermark_policy_b = watermark_policy_init(1, 1);
    if (watermark_policy_a).algo_id != (watermark_policy_b).algo_id {
        println("FAIL watermark_policy_init");
        process_exit(1);
    }
    println("prod_watermark_policy: PASSED");
}
