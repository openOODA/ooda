// # Product prove std/genomics_advanced/ancient_dna_damage_mapdamage.oo
//
// Logline: Fail-closed emit+gcc+run asserts ancient_dna_damage_mapdamage_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/ancient_dna_damage_mapdamage.oo.
//
// Beats:
//   1. Call ancient_dna_damage_mapdamage_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ancient_dna_damage_mapdamage: PASSED only if it matches.

import "std/genomics_advanced/ancient_dna_damage_mapdamage.oo";

pub fn main() {
    let a: Int = ancient_dna_damage_mapdamage_probe();
    if a != 0 {
        println("FAIL ancient_dna_damage_mapdamage_probe");
        process_exit(1);
    }
    println("prod_nc_ancient_dna_damage_mapdamage: PASSED");
}
