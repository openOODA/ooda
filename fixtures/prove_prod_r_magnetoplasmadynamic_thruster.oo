// # Product prove std/space_propulsion/magnetoplasmadynamic_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpd_thruster_spec_default_argon value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/magnetoplasmadynamic_thruster.oo.
//
// Beats:
//   1. Call mpd_thruster_spec_default_argon twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_magnetoplasmadynamic_thruster: PASSED only if asserts hold.

import "std/space_propulsion/magnetoplasmadynamic_thruster.oo";

pub fn main() {
    let magnetoplasmadynamic_thruster: MpdThrusterSpec = mpd_thruster_spec_default_argon();
    let magnetoplasmadynamic_thruster_b: MpdThrusterSpec = mpd_thruster_spec_default_argon();
    if (magnetoplasmadynamic_thruster).anode_radius_m != 0.05 {
        println("FAIL mpd_thruster_spec_default_argon anode_radius_m");
        process_exit(1);
    }
    if (magnetoplasmadynamic_thruster).anode_radius_m != (magnetoplasmadynamic_thruster_b).anode_radius_m {
        println("FAIL mpd_thruster_spec_default_argon det");
        process_exit(1);
    }
    println("prod_magnetoplasmadynamic_thruster: PASSED");
}
