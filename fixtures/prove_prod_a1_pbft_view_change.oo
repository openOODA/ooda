// # Product prove std/bft_consensus/pbft_view_change.oo
//
// Logline: Fail-closed emit+gcc+run asserts view_change_elect_primary is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/pbft_view_change.oo.
//
// Beats:
//   1. Call view_change_elect_primary twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pbft_view_change: PASSED only if they match.

import "std/bft_consensus/pbft_view_change.oo";

pub fn main() {
    let pbft_view_change_mark: Int = 0;
    if pbft_view_change_mark != 0 {
        process_exit(1);
    }
    let a: Int = view_change_elect_primary(0, 0);
    let b: Int = view_change_elect_primary(0, 0);
    if a != b {
        println("FAIL view_change_elect_primary");
        process_exit(1);
    }
    println("prod_pbft_view_change: PASSED");
}
