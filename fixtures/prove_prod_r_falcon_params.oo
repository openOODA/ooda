// # Product prove std/pqc_nist/falcon_params.oo
//
// Logline: Fail-closed emit+gcc+run asserts falcon_params_1024 value or determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/falcon_params.oo.
//
// Beats:
//   1. Call falcon_params_1024 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_falcon_params: PASSED only if asserts hold.

import "std/pqc_nist/falcon_params.oo";

pub fn main() {
    let falcon_params = falcon_params_1024();
    let falcon_params_b = falcon_params_1024();
    if falcon_params.degree_n != 1024 {
        println("FAIL falcon_params_1024 degree_n");
        process_exit(1);
    }
    if falcon_params.degree_n != falcon_params_b.degree_n {
        println("FAIL falcon_params_1024 det");
        process_exit(1);
    }
    println("prod_falcon_params: PASSED");
}
