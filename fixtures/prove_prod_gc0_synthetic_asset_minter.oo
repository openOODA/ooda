// # Product prove std/fintech_defi/synthetic_asset_minter.oo
//
// Logline: Fail-closed emit+gcc+run asserts user_debt_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/synthetic_asset_minter.oo.
//
// Beats:
//   1. Call user_debt_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_synthetic_asset_minter: PASSED only if they match.

import "std/fintech_defi/synthetic_asset_minter.oo";

pub fn main() {
    let synthetic_asset_minter_mark: Int = 0;
    if synthetic_asset_minter_mark != 0 {
        process_exit(1);
    }
    let synthetic_asset_minter_a = user_debt_record_new("x");
    let synthetic_asset_minter_b = user_debt_record_new("x");
    if (synthetic_asset_minter_a).staked_collateral != (synthetic_asset_minter_b).staked_collateral {
        println("FAIL user_debt_record_new");
        process_exit(1);
    }
    println("prod_synthetic_asset_minter: PASSED");
}
