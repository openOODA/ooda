// # Product prove std/robotics_auv/control_surfaces_hydrofoils.oo
//
// Logline: Fail-closed emit+gcc+run asserts hydrofoil_state_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/control_surfaces_hydrofoils.oo.
//
// Beats:
//   1. Call hydrofoil_state_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hydrofoil_state_zero: PASSED only if they match.

import "std/robotics_auv/control_surfaces_hydrofoils.oo";

pub fn main() {
    let control_surfaces_hydrofoils_mark: Int = 0;
    if control_surfaces_hydrofoils_mark != 0 { process_exit(1); }
    let a: ControlSurfaceState = hydrofoil_state_zero();
    let b: ControlSurfaceState = hydrofoil_state_zero();
    let ad: Float = (a).current_deflection_rad;
    let bd: Float = (b).current_deflection_rad;
    if ad != bd {
        println("FAIL hydrofoil_state_zero");
        process_exit(1);
    }
    println("prod_hydrofoil_state_zero: PASSED");
}
