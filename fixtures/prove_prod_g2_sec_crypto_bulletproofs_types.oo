// # Product prove std/sec/crypto/bulletproofs_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts bp_range_rounds is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bp_range_rounds twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bulletproofs_types: PASSED only if they match.

import "std/sec/crypto/bulletproofs_types.oo";

pub fn main() {
    let g2_oa = bp_range_new(8, 2);
    let g2_ob = bp_range_new(8, 2);
    let g2_a = bp_range_rounds(g2_oa);
    let g2_b = bp_range_rounds(g2_ob);
    if g2_a != g2_b {
        println("FAIL bp_range_rounds");
        process_exit(1);
    }
    println("prod_g2_bulletproofs_types: PASSED");
}
