// # Product prove std/sec/crypto/blake3_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/blake3_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/blake3_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_blake3_stubs: PASSED and exit 0 only on match.

import "std/sec/crypto/blake3_stubs.oo";

pub fn main() {
    let probe_a: Int = blake3_stubs_probe();
    let probe_b: Int = blake3_stubs_probe();
    if probe_a != probe_b {
        println("FAIL blake3_stubs probe");
        process_exit(1);
    }

    let dummy_a: Int = __dummy_std_src_ooda_sec_crypto_blake3_stubs_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_crypto_blake3_stubs_oo();
    if dummy_a != dummy_b {
        println("FAIL blake3_stubs dummy");
        process_exit(1);
    }

    println("prod_g4_sec_blake3_stubs: PASSED");
    process_exit(0);
}
