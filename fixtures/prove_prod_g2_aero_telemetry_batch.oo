// # Product prove std/aero/telemetry_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts tm_batch_count is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_batch.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tm_batch_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telemetry_batch: PASSED only if they match.

import "std/aero/telemetry_batch.oo";

pub fn main() {
    let g2_oa = tm_batch_new(8, 2);
    let g2_ob = tm_batch_new(8, 2);
    let g2_a = tm_batch_count(g2_oa);
    let g2_b = tm_batch_count(g2_ob);
    if g2_a != g2_b {
        println("FAIL tm_batch_count");
        process_exit(1);
    }
    println("prod_g2_telemetry_batch: PASSED");
}
