// # Product prove std/hft_alpha/mm_guilbaud_pham_pro_rata.oo
//
// Logline: Fail-closed emit+gcc+run asserts pro_rata_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_guilbaud_pham_pro_rata.oo.
//
// Beats:
//   1. Call pro_rata_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_guilbaud_pham_pro_rata: PASSED only if they match.

import "std/hft_alpha/mm_guilbaud_pham_pro_rata.oo";

pub fn main() {
    let a: GuilbaudPhamParams = pro_rata_params_new(0.0, 0.0, 0.0, 0.0);
    let b: GuilbaudPhamParams = pro_rata_params_new(0.0, 0.0, 0.0, 0.0);
    if a.gamma_risk_aversion != b.gamma_risk_aversion {
        println("FAIL pro_rata_params_new");
        process_exit(1);
    }
    println("prod_mm_guilbaud_pham_pro_rata: PASSED");
}
