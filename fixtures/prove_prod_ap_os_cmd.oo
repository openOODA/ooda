// # Product prove std/os/cmd.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/cmd.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/cmd.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cmd: PASSED only if they match.

import "std/os/cmd.oo";

pub fn main() {
    let cmd_a = cmd_new("x");
    let cmd_b = cmd_new("x");
    if list_len(cmd_a) != list_len(cmd_b) {
        println("FAIL cmd");
        process_exit(1);
    }
    println("prod_ap_cmd: PASSED");
}
