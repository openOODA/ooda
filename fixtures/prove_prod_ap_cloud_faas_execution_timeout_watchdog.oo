    let execution_timeout_watchdog_a = execution_watchdog_new(0, 0);
    let execution_timeout_watchdog_b = execution_watchdog_new(0, 0);
    if execution_timeout_watchdog_a.invocation_id != execution_timeout_watchdog_b.invocation_id {
        println("FAIL execution_timeout_watchdog");
        process_exit(1);
