// # Product prove std/db_storage/vector_hnsw_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts hnsw_index_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/vector_hnsw_graph.oo.
//
// Beats:
//   1. Call hnsw_index_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_hnsw_graph: PASSED only if they match.

import "std/db_storage/vector_hnsw_graph.oo";

pub fn main() {
    let vector_hnsw_graph_mark: Int = 0;
    if vector_hnsw_graph_mark != 0 {
        process_exit(1);
    }
    let vector_hnsw_graph_a = hnsw_index_new(hnsw_config_default());
    let vector_hnsw_graph_b = hnsw_index_new(hnsw_config_default());
    if (vector_hnsw_graph_a).entry_point_id != (vector_hnsw_graph_b).entry_point_id {
        println("FAIL hnsw_index_new");
        process_exit(1);
    }
    println("prod_vector_hnsw_graph: PASSED");
}
