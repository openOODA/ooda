// # Product prove std/telecom_6g/telecom_6g_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts telecom_6g_hardware_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/telecom_6g_stubs.oo.
//
// Beats:
//   1. Call telecom_6g_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telecom_6g_stubs: PASSED only if they match.

import "std/telecom_6g/telecom_6g_stubs.oo";

pub fn main() {
    let telecom_6g_stubs_mark: Int = 0;
    if telecom_6g_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Telecom6gHardwareCapabilities = telecom_6g_hardware_capabilities_default();
    let b: Telecom6gHardwareCapabilities = telecom_6g_hardware_capabilities_default();
    if (a).supports_ris_controller != (b).supports_ris_controller {
        println("FAIL telecom_6g_hardware_capabilities_default");
        process_exit(1);
    }
    println("prod_g2_telecom_6g_stubs: PASSED");
}
