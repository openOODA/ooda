// # Product prove std/deep_ai/beam_search_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/beam_search_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/beam_search_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_beam_search_decoder: PASSED only if they match.

import "std/deep_ai/beam_search_decoder.oo";

pub fn main() {
    let beam_search_decoder_a = beam_length_penalty(0, 0);
    let beam_search_decoder_b = beam_length_penalty(0, 0);
    if beam_search_decoder_a != beam_search_decoder_b {
        println("FAIL beam_search_decoder");
        process_exit(1);
    }
    println("prod_ap_beam_search_decoder: PASSED");
}
