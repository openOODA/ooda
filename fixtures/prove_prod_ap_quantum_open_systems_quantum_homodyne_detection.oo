// # Product prove std/quantum_open_systems/quantum_homodyne_detection.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_homodyne_detection.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_homodyne_detection.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_homodyne_detection: PASSED only if they match.

import "std/quantum_open_systems/quantum_homodyne_detection.oo";

pub fn main() {
    let quantum_homodyne_detection_a = homodyne_detector_new(0.0, 0.0, 0.0);
    let quantum_homodyne_detection_b = homodyne_detector_new(0.0, 0.0, 0.0);
    let quantum_homodyne_detection_va = homodyne_signal_to_noise_ratio(quantum_homodyne_detection_a, 0.0, 0.0);
    let quantum_homodyne_detection_vb = homodyne_signal_to_noise_ratio(quantum_homodyne_detection_b, 0.0, 0.0);
    if quantum_homodyne_detection_va != quantum_homodyne_detection_vb {
        println("FAIL quantum_homodyne_detection");
        process_exit(1);
    }
    println("prod_ap_quantum_homodyne_detection: PASSED");
}
