// # Product prove std/sec/crypto/tss_stubs.oo
//
// Logline: Fail-closed emit+check asserts frost_compute_lagrange_coefficient is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss_stubs.oo.
//
// Beats:
//   1. Call frost_compute_lagrange_coefficient twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tss_stubs: PASSED only if they match.

import "std/sec/crypto/tss_stubs.oo";

pub fn main() {
    let tss_stubs_mark: Int = 0;
    if tss_stubs_mark != 0 { process_exit(1); }
    let active: List[Int] = list_new();
    let a: String = frost_compute_lagrange_coefficient(0, active, "0");
    let b: String = frost_compute_lagrange_coefficient(0, active, "0");
    if a != b { process_exit(1); }
    println("prod_tss_stubs: PASSED");
}
