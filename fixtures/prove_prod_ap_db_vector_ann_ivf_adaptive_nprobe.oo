// # Product prove std/db_vector_ann/ivf_adaptive_nprobe.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/ivf_adaptive_nprobe.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/ivf_adaptive_nprobe.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_ivf_adaptive_nprobe: PASSED only if they match.

import "std/db_vector_ann/ivf_adaptive_nprobe.oo";

pub fn main() {
    let ivf_adaptive_nprobe_a = adaptive_probe_config_default();
    let ivf_adaptive_nprobe_b = adaptive_probe_config_default();
    if ivf_adaptive_nprobe_a.min_nprobe != ivf_adaptive_nprobe_b.min_nprobe {
        println("FAIL ivf_adaptive_nprobe");
        process_exit(1);
    }
    println("prod_ap_ivf_adaptive_nprobe: PASSED");
}
