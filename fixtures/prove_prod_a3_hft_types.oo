// # Product prove std/fin/hft_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts hft_tick_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_types.oo.
//
// Beats:
//   1. Call hft_tick_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_types: PASSED only if they match.

import "std/fin/hft_types.oo";

pub fn main() {
    let hft_types_mark: Int = 0;
    if hft_types_mark != 0 {
        process_exit(1);
    }
    let a: TickData = hft_tick_new(0, 0, 0);
    let b: TickData = hft_tick_new(0, 0, 0);
    if (a).price != (b).price {
        println("FAIL hft_tick_new");
        process_exit(1);
    }
    println("prod_hft_types: PASSED");
}
