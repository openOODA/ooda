// # Product prove std/quantum_open_systems/dissipative_state_preparation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/dissipative_state_preparation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/dissipative_state_preparation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dissipative_state_preparation: PASSED only if they match.

import "std/quantum_open_systems/dissipative_state_preparation.oo";

pub fn main() {
    let dissipative_state_preparation_a = dissipative_prep_config_bell();
    let dissipative_state_preparation_b = dissipative_prep_config_bell();
    let dissipative_state_preparation_va = dissipative_steady_state_fidelity(dissipative_state_preparation_a);
    let dissipative_state_preparation_vb = dissipative_steady_state_fidelity(dissipative_state_preparation_b);
    if dissipative_state_preparation_va != dissipative_state_preparation_vb {
        println("FAIL dissipative_state_preparation");
        process_exit(1);
    }
    println("prod_ap_dissipative_state_preparation: PASSED");
}
