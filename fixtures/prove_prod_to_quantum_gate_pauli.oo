// # Product prove std/quantum/gate_pauli.oo
//
// Logline: Fail-closed emit+gcc+run asserts pauli_i_matrix holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_pauli.oo.
//
// Beats:
//   1. Call pauli_i_matrix using the gate_pauli ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_gate_pauli: PASSED only if asserts hold.

import "std/quantum/gate_pauli.oo";

pub fn main() {
    let obj = pauli_i_matrix();
    let gate_pauli_a = obj.m00.real;
    let gate_pauli_b = obj.m00.real;
    if gate_pauli_a != gate_pauli_b {
        println("FAIL pauli_i_matrix");
        process_exit(1);
    }
    println("prod_gate_pauli: PASSED");
}
