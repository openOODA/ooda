// # Product prove std/telecom/turbo_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/turbo_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/turbo_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_turbo_decoder: PASSED only if they match.

import "std/telecom/turbo_decoder.oo";

pub fn main() {
    let turbo_decoder_a = turbo_abs(0.0);
    let turbo_decoder_b = turbo_abs(0.0);
    if turbo_decoder_a != turbo_decoder_b {
        println("FAIL turbo_decoder");
        process_exit(1);
    }
    println("prod_ap_turbo_decoder: PASSED");
}
