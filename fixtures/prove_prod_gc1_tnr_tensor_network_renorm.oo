// # Product prove std/quantum_tensor_nets/tnr_tensor_network_renorm.oo
//
// Logline: Fail-closed emit+gcc+run asserts tnr_fixed_point_report_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tnr_tensor_network_renorm.oo.
//
// Beats:
//   1. Call tnr_fixed_point_report_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tnr_tensor_network_renorm: PASSED only if they match.

import "std/quantum_tensor_nets/tnr_tensor_network_renorm.oo";

pub fn main() {
    let tnr_tensor_network_renorm_mark: Int = 0;
    if tnr_tensor_network_renorm_mark != 0 {
        process_exit(1);
    }
    let tnr_tensor_network_renorm_a = tnr_fixed_point_report_new(1, 1.0, 1.0);
    let tnr_tensor_network_renorm_b = tnr_fixed_point_report_new(1, 1.0, 1.0);
    if (tnr_tensor_network_renorm_a).renorm_step != (tnr_tensor_network_renorm_b).renorm_step {
        println("FAIL tnr_fixed_point_report_new");
        process_exit(1);
    }
    println("prod_tnr_tensor_network_renorm: PASSED");
}
