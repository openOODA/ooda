// # Product prove std/ai_multimodal/speech_mel_filterbank.oo
//
// Logline: Fail-closed emit+gcc+run asserts speech_mel_filterbank_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/speech_mel_filterbank.oo.
//
// Beats:
//   1. Call speech_mel_filterbank_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_speech_mel_filterbank: PASSED only if they match.

import "std/ai_multimodal/speech_mel_filterbank.oo";

pub fn main() {
    let a: Int = speech_mel_filterbank_marker();
    let b: Int = speech_mel_filterbank_marker();
    if a != b {
        println("FAIL speech_mel_filterbank_marker");
        process_exit(1);
    }
    println("prod_speech_mel_filterbank: PASSED");
}
