// # Product prove std/telecom_6g/polar_crc_aided_scl_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts polar_path_penalty is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/polar_crc_aided_scl_decoder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call polar_path_penalty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polar_crc_aided_scl_decoder: PASSED only if they match.

import "std/telecom_6g/polar_crc_aided_scl_decoder.oo";

pub fn main() {
    let g2_a = polar_path_penalty(1.0, 2);
    let g2_b = polar_path_penalty(1.0, 2);
    if g2_a != g2_b {
        println("FAIL polar_path_penalty");
        process_exit(1);
    }
    println("prod_g2_polar_crc_aided_scl_decoder: PASSED");
}
