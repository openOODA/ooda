// # Call argument type mismatch
//
// Logline: Check refuses a String argument where the callee first param is Int.
//
// Setup: Single-file probe. Line of the call stays under 50.
//
// Beats:
//   1. Declare fn f with one Int param and bind it.
//   2. Call f with a string literal.
//   3. check must ERR type argument expects Int but got String.

fn f(x: Int) {
    let _y = x;
    println(_y);
}

pub fn main() {
    f("hi");
}
