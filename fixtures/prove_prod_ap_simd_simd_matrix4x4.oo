// # Product prove std/simd/simd_matrix4x4.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_matrix4x4.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_matrix4x4.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_matrix4x4: PASSED only if they match.

import "std/simd/simd_matrix4x4.oo";

pub fn main() {
    let simd_matrix4x4_a = simd_mat4_zero();
    let simd_matrix4x4_b = simd_mat4_zero();
    let simd_matrix4x4_va = simd_mat4_trace(simd_matrix4x4_a);
    let simd_matrix4x4_vb = simd_mat4_trace(simd_matrix4x4_b);
    if simd_matrix4x4_va != simd_matrix4x4_vb {
        println("FAIL simd_matrix4x4");
        process_exit(1);
    }
    println("prod_ap_simd_matrix4x4: PASSED");
}
