// # overflowing INT compare is leftover
//
// Logline: INT above signed 64-bit max must fail closed and not wrap into the then arm.
//
// Setup: 9223372036854775808 does not fit in signed 64-bit. Wrap would make < 1 true.
//
// Beats:
//   1. if 9223372036854775808 < 1 print BAD else print GE.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if 9223372036854775808 < 1 {
        println("BAD");
    } else {
        println("GE");
    }
}
