// # Product prove std/auto/lanelet_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/lanelet_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lanelet_types: PASSED only if they match.

import "std/auto/lanelet_types.oo";

pub fn main() {
    let lanelet_types_a = lanelet_abs_val(0);
    let lanelet_types_b = lanelet_abs_val(0);
    if lanelet_types_a != lanelet_types_b {
        println("FAIL lanelet_types");
        process_exit(1);
    }
    println("prod_ap_lanelet_types: PASSED");
}
