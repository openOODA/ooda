// # Product prove std/gis_spatial/kml_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/kml_writer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kml_writer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_kml_writer: PASSED only if they match.

import "std/gis_spatial/kml_writer.oo";

pub fn main() {
    let kml_writer_a = kml_style_new("x", "x", "x", 0.0);
    let kml_writer_b = kml_style_new("x", "x", "x", 0.0);
    if kml_writer_a.id != kml_writer_b.id {
        println("FAIL kml_writer");
        process_exit(1);
    }
    println("prod_ap_kml_writer: PASSED");
}
