// # Product prove std/synthetic_biology/chemical_langevin_sde.oo
//
// Logline: Fail-closed emit+gcc+run asserts cle_sqrt real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/chemical_langevin_sde.oo.
//
// Beats:
//   1. Call cle_sqrt with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_chemical_langevin_sde: PASSED only if the assert holds.

import "std/synthetic_biology/chemical_langevin_sde.oo";

pub fn main() {
    let chemical_langevin_sde_mark: Int = 0;
    if chemical_langevin_sde_mark != 0 {
        process_exit(1);
    }
    let chemical_langevin_sde_n: Float = cle_sqrt(0.0);
    if !(chemical_langevin_sde_n == 0.0) {
        println("FAIL cle_sqrt");
        process_exit(1);
    }
    println("prod_chemical_langevin_sde: PASSED");
}
