// # Product prove std/defi_derivatives/options_risk_reversal_collar.oo
//
// Logline: Fail-closed emit+gcc+run asserts rrc_norm_pdf is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_risk_reversal_collar.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rrc_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_options_risk_reversal_collar: PASSED only if they match.

import "std/defi_derivatives/options_risk_reversal_collar.oo";

pub fn main() {
    let g2_a = rrc_norm_pdf(1.0);
    let g2_b = rrc_norm_pdf(1.0);
    if g2_a != g2_b {
        println("FAIL rrc_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_options_risk_reversal_collar: PASSED");
}
