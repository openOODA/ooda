// # Product prove std/simd/simd_vec4i.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_vec4i.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_vec4i.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_vec4i: PASSED only if they match.

import "std/simd/simd_vec4i.oo";

pub fn main() {
    let simd_vec4i_a = vec4i_new(0, 0, 0, 0);
    let simd_vec4i_b = vec4i_new(0, 0, 0, 0);
    let simd_vec4i_va = vec4i_hadd(simd_vec4i_a);
    let simd_vec4i_vb = vec4i_hadd(simd_vec4i_b);
    if simd_vec4i_va != simd_vec4i_vb {
        println("FAIL simd_vec4i");
        process_exit(1);
    }
    println("prod_ap_simd_vec4i: PASSED");
}
