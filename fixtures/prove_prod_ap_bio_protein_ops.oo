// # Product prove std/bio/protein_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/protein_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_ops: PASSED only if they match.

import "std/bio/protein_ops.oo";

pub fn main() {
    let protein_ops_a = point3d_sqrt_approx(0);
    let protein_ops_b = point3d_sqrt_approx(0);
    if protein_ops_a != protein_ops_b {
        println("FAIL protein_ops");
        process_exit(1);
    }
    println("prod_ap_protein_ops: PASSED");
}
