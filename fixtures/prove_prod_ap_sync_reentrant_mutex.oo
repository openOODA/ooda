// # Product prove std/sync/reentrant_mutex.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sync/reentrant_mutex.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sync/reentrant_mutex.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_reentrant_mutex: PASSED only if they match.

import "std/sync/reentrant_mutex.oo";

pub fn main() {
    let reentrant_mutex_a = reentrant_mutex_new();
    let reentrant_mutex_b = reentrant_mutex_new();
    if reentrant_mutex_a.owner_id != reentrant_mutex_b.owner_id {
        println("FAIL reentrant_mutex");
        process_exit(1);
    }
    println("prod_ap_reentrant_mutex: PASSED");
}
