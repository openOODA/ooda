// # Product prove std/lidar_perception/euclidean_cluster_extractor.oo
//
// Logline: Fail-closed emit+gcc+run asserts euclidean_cluster_config_default real value.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/euclidean_cluster_extractor.oo.
//
// Beats:
//   1. Call euclidean_cluster_config_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_euclidean_cluster_extractor: PASSED only if the assert holds.

import "std/lidar_perception/euclidean_cluster_extractor.oo";

pub fn main() {
    let euclidean_cluster_extractor_a = euclidean_cluster_config_default();
    let euclidean_cluster_extractor_min_cluster_size: Int = (euclidean_cluster_extractor_a).min_cluster_size;
    if euclidean_cluster_extractor_min_cluster_size != 5 {
        println("FAIL euclidean_cluster_config_default");
        process_exit(1);
    }
    println("prod_euclidean_cluster_extractor: PASSED");
}
