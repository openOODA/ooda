// # Product prove std/astro_advanced/space_debris_conjunction.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/space_debris_conjunction.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/space_debris_conjunction.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_space_debris_conjunction: PASSED only if they match.

import "std/astro_advanced/space_debris_conjunction.oo";

pub fn main() {
    let space_debris_conjunction_a = conjunction_miss_m();
    let space_debris_conjunction_b = conjunction_miss_m();
    if space_debris_conjunction_a != space_debris_conjunction_b {
        println("FAIL space_debris_conjunction");
        process_exit(1);
    }
    println("prod_ap_space_debris_conjunction: PASSED");
}
