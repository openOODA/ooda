// # Product prove std/perf/memory_arena_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/memory_arena_pool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/memory_arena_pool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_memory_arena_pool: PASSED only if they match.

import "std/perf/memory_arena_pool.oo";

pub fn main() {
    let memory_arena_pool_a = arena_pool_create("x", 0);
    let memory_arena_pool_b = arena_pool_create("x", 0);
    let memory_arena_pool_va = arena_pool_active(memory_arena_pool_a);
    let memory_arena_pool_vb = arena_pool_active(memory_arena_pool_b);
    if memory_arena_pool_va != memory_arena_pool_vb {
        println("FAIL memory_arena_pool");
        process_exit(1);
    }
    println("prod_ap_memory_arena_pool: PASSED");
}
