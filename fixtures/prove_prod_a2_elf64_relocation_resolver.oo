// # Product prove std/compilers_vm/elf64_relocation_resolver.oo
//
// Logline: Fail-closed emit+gcc+run asserts r_x86_64_none is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/elf64_relocation_resolver.oo.
//
// Beats:
//   1. Call r_x86_64_none twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf64_relocation_resolver: PASSED only if they match.

import "std/compilers_vm/elf64_relocation_resolver.oo";

pub fn main() {
    let elf64_relocation_resolver_mark: Int = 0;
    if elf64_relocation_resolver_mark != 0 {
        process_exit(1);
    }
    let a: Int = r_x86_64_none();
    let b: Int = r_x86_64_none();
    if a != b {
        println("FAIL r_x86_64_none");
        process_exit(1);
    }
    println("prod_elf64_relocation_resolver: PASSED");
}
