// # Product prove std/fintech/interest_rate_swap.oo
//
// Logline: Fail-closed emit+gcc+run asserts irs_contract_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/interest_rate_swap.oo.
//
// Beats:
//   1. Call irs_contract_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_interest_rate_swap: PASSED only if they match.

import "std/fintech/interest_rate_swap.oo";

pub fn main() {
    let interest_rate_swap_mark: Int = 0;
    if interest_rate_swap_mark != 0 {
        process_exit(1);
    }
    let a: IrsContract = irs_contract_new("x", 0.0, 0, 0.0, true);
    let b: IrsContract = irs_contract_new("x", 0.0, 0, 0.0, true);
    if (a).fixed_rate_bps != (b).fixed_rate_bps {
        println("FAIL irs_contract_new");
        process_exit(1);
    }
    println("prod_g2_interest_rate_swap: PASSED");
}
