// # Product prove std/quantum_advanced/vqe_ansatz_adapt.oo
//
// Logline: Fail-closed emit+gcc+run asserts adapt_pool_qubit is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_ansatz_adapt.oo.
//
// Beats:
//   1. Call adapt_pool_qubit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vqe_ansatz_adapt: PASSED only if they match.

import "std/quantum_advanced/vqe_ansatz_adapt.oo";

pub fn main() {
    let vqe_ansatz_adapt_mark: Int = 0;
    if vqe_ansatz_adapt_mark != 0 {
        process_exit(1);
    }
    let vqe_ansatz_adapt_a = adapt_pool_qubit();
    let vqe_ansatz_adapt_b = adapt_pool_qubit();
    if (vqe_ansatz_adapt_a).mode != (vqe_ansatz_adapt_b).mode {
        println("FAIL adapt_pool_qubit");
        process_exit(1);
    }
    println("prod_vqe_ansatz_adapt: PASSED");
}
