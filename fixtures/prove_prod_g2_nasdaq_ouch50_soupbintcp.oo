// # Product prove std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo
//
// Logline: Fail-closed emit+gcc+run asserts soup_session_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo.
//
// Beats:
//   1. Call soup_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nasdaq_ouch50_soupbintcp: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_ouch50_soupbintcp.oo";

pub fn main() {
    let nasdaq_ouch50_soupbintcp_mark: Int = 0;
    if nasdaq_ouch50_soupbintcp_mark != 0 {
        process_exit(1);
    }
    let a: SoupSessionState = soup_session_new("x", 0);
    let b: SoupSessionState = soup_session_new("x", 0);
    if (a).inbound_seq != (b).inbound_seq {
        println("FAIL soup_session_new");
        process_exit(1);
    }
    println("prod_g2_nasdaq_ouch50_soupbintcp: PASSED");
}
