// # Product prove std/db_vector_ann/vector_scalar_quantization.oo
//
// Logline: Fail-closed emit+gcc+run asserts sq_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_scalar_quantization.oo.
//
// Beats:
//   1. Call sq_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_scalar_quantization: PASSED only if they match.

import "std/db_vector_ann/vector_scalar_quantization.oo";

pub fn main() {
    let vector_scalar_quantization_mark: Int = 0;
    if vector_scalar_quantization_mark != 0 {
        process_exit(1);
    }
    let a: SqConfig = sq_config_default(0, 0);
    let b: SqConfig = sq_config_default(0, 0);
    if (a).num_bits != (b).num_bits {
        println("FAIL sq_config_default");
        process_exit(1);
    }
    println("prod_vector_scalar_quantization: PASSED");
}
