// # Product prove std/scicomp/gamma_beta_special.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_ln_approx is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/gamma_beta_special.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call math_ln_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gamma_beta_special: PASSED only if they match.

import "std/scicomp/gamma_beta_special.oo";

pub fn main() {
    let g2_a = math_ln_approx(1.0);
    let g2_b = math_ln_approx(1.0);
    if g2_a != g2_b {
        println("FAIL math_ln_approx");
        process_exit(1);
    }
    println("prod_g2_gamma_beta_special: PASSED");
}
