// # Product prove std/quantum_open_systems/quantum_open_systems_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_open_systems_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_open_systems_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_quantum_open_systems_stubs: PASSED only if they match.

import "std/quantum_open_systems/quantum_open_systems_stubs.oo";

pub fn main() {
    let quantum_open_systems_stubs_a = open_quantum_capabilities_default();
    let quantum_open_systems_stubs_b = open_quantum_capabilities_default();
    if quantum_open_systems_stubs_a.max_resonator_modes != quantum_open_systems_stubs_b.max_resonator_modes {
        println("FAIL quantum_open_systems_stubs");
        process_exit(1);
    }
    println("prod_ap_quantum_open_systems_stubs: PASSED");
}
