// # Product prove std/astrodynamics/patched_conics.oo
//
// Logline: Fail-closed emit+gcc+run asserts patched_bodies is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/patched_conics.oo.
//
// Beats:
//   1. Call patched_bodies twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_patched_conics: PASSED only if they match.

import "std/astrodynamics/patched_conics.oo";

pub fn main() {
    let patched_conics_mark: Int = 0;
    if patched_conics_mark != 0 {
        process_exit(1);
    }
    let a: Int = patched_bodies();
    let b: Int = patched_bodies();
    if a != b {
        println("FAIL patched_bodies");
        process_exit(1);
    }
    println("prod_patched_conics: PASSED");
}
