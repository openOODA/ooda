// # Product prove std/security_defense/secure_zeroization_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_memory_zeroization is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/secure_zeroization_verifier.oo.
//
// Beats:
//   1. Call audit_memory_zeroization twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secure_zeroization_verifier: PASSED only if they match.

import "std/security_defense/secure_zeroization_verifier.oo";

pub fn main() {
    let secure_zeroization_verifier_mark: Int = 0;
    if secure_zeroization_verifier_mark != 0 {
        process_exit(1);
    }
    let a: ZeroizationAuditReport = audit_memory_zeroization(list_new(), 0);
    let b: ZeroizationAuditReport = audit_memory_zeroization(list_new(), 0);
    if (a).total_bytes_checked != (b).total_bytes_checked {
        println("FAIL audit_memory_zeroization");
        process_exit(1);
    }
    println("prod_secure_zeroization_verifier: PASSED");
}
