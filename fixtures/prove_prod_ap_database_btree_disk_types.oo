// # Product prove std/database/btree_disk_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/database/btree_disk_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/btree_disk_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_btree_disk_types: PASSED only if they match.

import "std/database/btree_disk_types.oo";

pub fn main() {
    let btree_disk_types_a = btree_header_new(0, 0, 0);
    let btree_disk_types_b = btree_header_new(0, 0, 0);
    let btree_disk_types_va = btree_header_page(btree_disk_types_a);
    let btree_disk_types_vb = btree_header_page(btree_disk_types_b);
    if btree_disk_types_va != btree_disk_types_vb {
        println("FAIL btree_disk_types");
        process_exit(1);
    }
    println("prod_ap_btree_disk_types: PASSED");
}
