// # Product prove std/astro_advanced/post_newtonian_ephemeris.oo
//
// Logline: Fail-closed emit+gcc+run asserts pn_order is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/post_newtonian_ephemeris.oo.
//
// Beats:
//   1. Call pn_order twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_post_newtonian_ephemeris: PASSED only if they match.

import "std/astro_advanced/post_newtonian_ephemeris.oo";

pub fn main() {
    let post_newtonian_ephemeris_mark: Int = 0;
    if post_newtonian_ephemeris_mark != 0 {
        process_exit(1);
    }
    let a: Int = pn_order();
    let b: Int = pn_order();
    if a != b {
        println("FAIL pn_order");
        process_exit(1);
    }
    println("prod_post_newtonian_ephemeris: PASSED");
}
