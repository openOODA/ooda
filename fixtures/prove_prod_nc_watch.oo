// # Product prove std/fs/watch.oo
//
// Logline: Fail-closed emit+gcc+run asserts watch_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fs/watch.oo.
//
// Beats:
//   1. Call watch_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_watch: PASSED only if it matches.

import "std/fs/watch.oo";

pub fn main() {
    let a: Int = watch_probe();
    if a != 0 {
        println("FAIL watch_probe");
        process_exit(1);
    }
    println("prod_nc_watch: PASSED");
}
