// # Product prove std/quantum_topological/topological_braid_word_compiler.oo
//
// Logline: Fail-closed emit+gcc+run asserts target_gate_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_braid_word_compiler.oo.
//
// Beats:
//   1. Call target_gate_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_braid_word_compiler: PASSED only if they match.

import "std/quantum_topological/topological_braid_word_compiler.oo";

pub fn main() {
    let topological_braid_word_compiler_mark: Int = 0;
    if topological_braid_word_compiler_mark != 0 {
        process_exit(1);
    }
    let a: TargetGateType = target_gate_new(0, "x", 0.0);
    let b: TargetGateType = target_gate_new(0, "x", 0.0);
    if (a).gate_id != (b).gate_id {
        println("FAIL target_gate_new");
        process_exit(1);
    }
    println("prod_topological_braid_word_compiler: PASSED");
}
