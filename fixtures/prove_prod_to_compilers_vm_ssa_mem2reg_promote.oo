// # Product prove std/compilers_vm/ssa_mem2reg_promote.oo
//
// Logline: Fail-closed emit+gcc+run asserts mem2reg_context_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_mem2reg_promote.oo.
//
// Beats:
//   1. Call mem2reg_context_new using the ssa_mem2reg_promote ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ssa_mem2reg_promote: PASSED only if asserts hold.

import "std/compilers_vm/ssa_mem2reg_promote.oo";

pub fn main() {
    let obj = mem2reg_context_new();
    let ssa_mem2reg_promote_a = obj.alloca_count;
    if ssa_mem2reg_promote_a != 0 {
        println("FAIL mem2reg_context_new");
        process_exit(1);
    }
    println("prod_ssa_mem2reg_promote: PASSED");
}
