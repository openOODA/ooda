// # Product prove std/astro_advanced/earth_moon_trans_lunar.oo
//
// Logline: Fail-closed emit+gcc+run asserts tli_delta_v is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/earth_moon_trans_lunar.oo.
//
// Beats:
//   1. Call tli_delta_v twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_earth_moon_trans_lunar: PASSED only if they match.

import "std/astro_advanced/earth_moon_trans_lunar.oo";

pub fn main() {
    let a = tli_delta_v();
    let b = tli_delta_v();
    if a != b {
        println("FAIL tli_delta_v");
        process_exit(1);
    }
    println("prod_earth_moon_trans_lunar: PASSED");
}
