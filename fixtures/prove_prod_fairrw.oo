// # Product sync fair rwlock prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/rwlock_fair.oo.
//
// Setup: Product std/sync/rwlock_fair.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New active readers 0 not write locked.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/rwlock_fair.oo";

pub fn main() {
    let l: FairRwLock = fair_rwlock_new();
    let n: Int = fair_rwlock_active_readers(l);
    if n != 0 {
        println("FAIL fairrw readers");
        process_exit(1);
    }
    if fair_rwlock_is_write_locked(l) {
        println("FAIL fairrw write");
        process_exit(1);
    }
    println("prod_fairrw: PASSED");
}
