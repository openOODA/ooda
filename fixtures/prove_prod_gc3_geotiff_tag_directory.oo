// # Product prove std/gis_topo/geotiff_tag_directory.oo
//
// Logline: Fail-closed emit+gcc+run asserts geotiff_tag_is_geokey is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/geotiff_tag_directory.oo.
//
// Beats:
//   1. Call geotiff_tag_is_geokey twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geotiff_tag_directory: PASSED only if they match.

import "std/gis_topo/geotiff_tag_directory.oo";

pub fn main() {
    let geotiff_tag_directory_mark: Int = 0;
    if geotiff_tag_directory_mark != 0 {
        process_exit(1);
    }
    let geotiff_tag_directory_a: Bool = geotiff_tag_is_geokey(1);
    let geotiff_tag_directory_b: Bool = geotiff_tag_is_geokey(1);
    if geotiff_tag_directory_a != geotiff_tag_directory_b {
        println("FAIL geotiff_tag_is_geokey");
        process_exit(1);
    }
    println("prod_geotiff_tag_directory: PASSED");
}
