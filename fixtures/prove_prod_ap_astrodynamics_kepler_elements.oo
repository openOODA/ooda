// # Product prove std/astrodynamics/kepler_elements.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/kepler_elements.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/kepler_elements.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kepler_elements: PASSED only if they match.

import "std/astrodynamics/kepler_elements.oo";

pub fn main() {
    let kepler_elements_a = kepler_n_el();
    let kepler_elements_b = kepler_n_el();
    if kepler_elements_a != kepler_elements_b {
        println("FAIL kepler_elements");
        process_exit(1);
    }
    println("prod_ap_kepler_elements: PASSED");
}
