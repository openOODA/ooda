// SPRINT Issue #12 fail-closed — large struct lit wrong field type.
// STATUS: expected ERR type on field 'd' (String expected, Int found).
type Big = struct {
    a: Int,
    b: Int,
    c: Int,
    d: String,
    e: Bool,
    f: Int,
};

pub fn main() {
    let x = Big {
        a: 1,
        b: 2,
        c: 3,
        d: 99,
        e: true,
        f: 6,
    };
}
