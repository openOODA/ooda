// # Build a large struct with a wrong field
//
// Logline: Fill Big.d with an Int so typecheck must emit a field-type error.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Define Big with six fields.
//   2. Set d to 99 instead of a String.
//   3. Leave the literal otherwise well typed.
//
// SPRINT Issue #12 fail-closed — large struct lit wrong field type.
// STATUS: expected ERR type on field 'd' (String expected, Int found).
type Big = struct {
    a: Int,
    b: Int,
    c: Int,
    d: String,
    e: Bool,
    f: Int,
};

pub fn main() {
    let x = Big {
        a: 1,
        b: 2,
        c: 3,
        d: 99,
        e: true,
        f: 6,
    };
}
