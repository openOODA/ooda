// SPRINT Issue #12 / #11 fail-closed — Int field compared with false.
// STATUS: expected ERR type (incompatible operands). Must not silent-pass.
type State = struct {
    flag: Bool,
    n: Int,
};

pub fn score(s: State) -> Int {
    if s.n == false {
        return 0;
    }
    return 1;
}

pub fn main() {}
