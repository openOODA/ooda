// # Export ItemB helpers
//
// Logline: Define ItemB and helpers that double, build a value, and read value_b.
//
// Setup: Test fixture. Keep all code exact. Param ib must differ from ia.
//
// Beats:
//   1. Define ItemB with tag, value_b, and is_valid.
//   2. Double in other_helper.
//   3. Build ItemB and return value_b.
//
// Issue #12 multi-module rail — module B (second import leaf).
// Param name `ib` must differ from module A's `ia` (shared names poison tables).
type ItemB = struct {
    tag: Int,
    value_b: Int,
    is_valid: Bool,
};

pub fn other_helper(x: Int) -> Int {
    return x * 2;
}

pub fn make_b(v: Int) -> ItemB {
    return ItemB { tag: 0, value_b: v, is_valid: true };
}

pub fn item_b_value(ib: ItemB) -> Int {
    let x: Int = ib.value_b;
    return x;
}
