// # Combine two shim modules
//
// Logline: Import both leaves, chain helpers, and pack ItemA plus ItemB values.
//
// Setup: Test fixture. Keep all code exact. Distinct param names across modules.
//
// Beats:
//   1. Import mod_a and mod_b.
//   2. Chain shared_helper into other_helper.
//   3. Pack both items and print combine plus pack.
//
// SPRINT Issue #12 / #10 rail — multi-module shim (dnssec.oo pattern).
// Imports two tiny modules; exercises cross-file type tables + free names.
// STATUS: expected PASS when param names are distinct across modules.
// Residual: duplicate free-name exports still accept (fixtures/xfail/dup_import_names).
// Residual: same param name on two struct fns poisons fields (fixtures/xfail/same_param_name).
import "./mod_a.oo";
import "./mod_b.oo";

pub fn combine(x: Int) -> Int {
    let a: Int = shared_helper(x);
    let b: Int = other_helper(a);
    return b;
}

pub fn pack(n: Int) -> Int {
    let ia: ItemA = make_a(n);
    let ib: ItemB = make_b(n);
    let va: Int = item_a_value(ia);
    let wb: Int = item_b_value(ib);
    return va + wb;
}

pub fn main() {
    println(combine(3));
    println(pack(5));
}
