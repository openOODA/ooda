// # Export ItemA helpers
//
// Logline: Define ItemA and helpers that add one, build a value, and read value_a.
//
// Setup: Test fixture. Keep all code exact. Distinct param names across modules.
//
// Beats:
//   1. Define ItemA with tag, value_a, and is_valid.
//   2. Add one in shared_helper.
//   3. Build ItemA and return value_a.
//
// Issue #12 multi-module rail — module A (dnssec-style split leaf).
// HONESTY: distinct param names required across modules (shared `it` poisons
// field tables — Issue #10 residual). See fixtures/xfail/same_param_name/.
type ItemA = struct {
    tag: Int,
    value_a: Int,
    is_valid: Bool,
};

pub fn shared_helper(x: Int) -> Int {
    return x + 1;
}

pub fn make_a(v: Int) -> ItemA {
    return ItemA { tag: 0, value_a: v, is_valid: true };
}

pub fn item_a_value(ia: ItemA) -> Int {
    let x: Int = ia.value_a;
    return x;
}
