// # Build and read a large struct
//
// Logline: Construct a six-field Big, sum two Int fields, and print the rest.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Fill Big with six typed fields.
//   2. Extract a and b, then add them.
//   3. Print the sum plus d, e, and f.
//
// SPRINT Issue #12 rail — large struct literal (≥5 fields) typecheck.
// STATUS: expected PASS. Corpus historically only had Point {x,y}.
// Residual honesty: wrong field types must ERR (see fail/large_struct_lit_type_bad.oo).
// Note: direct field+field binop still weak on some hosts — extract then add.
type Big = struct {
    a: Int,
    b: Int,
    c: Int,
    d: String,
    e: Bool,
    f: Int,
};

pub fn sum_ab(x: Big) -> Int {
    let aa: Int = x.a;
    let bb: Int = x.b;
    return aa + bb;
}

pub fn main() {
    let x = Big {
        a: 1,
        b: 2,
        c: 3,
        d: "hi",
        e: true,
        f: 6,
    };
    println(sum_ab(x));
    let dd: String = x.d;
    println(dd);
    let ee: Bool = x.e;
    println(ee);
    let ff: Int = x.f;
    println(ff);
}
