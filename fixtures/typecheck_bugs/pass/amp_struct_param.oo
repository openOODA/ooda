// SPRINT Issue #12 rail for Issue #6 — &UserStruct param + field access.
// STATUS: expected PASS on tip host (DnssecRecord-style field resolver / copy paths).
// Patterns: direct param.field, paren (param).field, intermediate typed copy.
// Residual honesty: if this turns red again, re-open Issue #6 — do not silent-green.
type Foo = struct {
    n: Int,
    flag: Bool,
};

// Direct field on &Foo — historically lost struct type in field-chain resolver.
pub fn get_n_direct(f: &Foo) -> Int {
    return f.n;
}

// Parenthesized receiver workaround used in library migrations.
pub fn get_n_paren(f: &Foo) -> Int {
    return (f).n;
}

// Dnssec-style: bind &Foo into local typed value then field-access.
pub fn get_n_copy(f: &Foo) -> Int {
    let copy: Foo = f;
    return copy.n;
}

pub fn get_flag_direct(f: &Foo) -> Bool {
    return f.flag;
}

pub fn main() {
    let x = Foo { n: 3, flag: true };
    println(get_n_direct(&x));
    println(get_n_paren(&x));
    println(get_n_copy(&x));
    println(get_flag_direct(&x));
}
