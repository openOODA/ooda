// SPRINT Issue #12 rail for Issue #11 — if field == false on user struct.
// STATUS: expected PASS for valid Bool fields (by-value and &UserStruct).
// Residual honesty: missing/non-Bool fields must stay fail-closed (see fail/).
type State = struct {
    flag: Bool,
    n: Int,
};

pub fn score(s: State) -> Int {
    if s.flag == false {
        return 0;
    }
    return s.n;
}

pub fn score_ref(s: &State) -> Int {
    if s.flag == false {
        return 0;
    }
    return s.n;
}

// Nested chain == false (common library form).
type Inner = struct {
    active: Bool,
};
type Outer = struct {
    inner: Inner,
};

pub fn outer_score(o: Outer) -> Int {
    if o.inner.active == false {
        return 0;
    }
    return 1;
}

pub fn main() {
    let s = State { flag: true, n: 7 };
    println(score(s));
    let s2 = State { flag: false, n: 9 };
    println(score_ref(&s2));
    let i = Inner { active: true };
    let o = Outer { inner: i };
    println(outer_score(o));
}
