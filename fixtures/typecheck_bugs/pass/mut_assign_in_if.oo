// # Assign a mut Int inside if
//
// Logline: Assign a typed mut Int inside an if and return the joined value.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Start x at 0.
//   2. Assign 42 when cond is true.
//   3. Print choose(true) and choose(false).
//
// SPRINT Issue #12 absence #3 — typed mut Int assigned inside if.
// STATUS: expected PASS. Two halves existed separately; combined form lacked a rail.
pub fn choose(cond: Bool) -> Int {
    let mut x: Int = 0;
    if cond {
        x = 42;
    }
    return x;
}

pub fn main() {
    println(choose(true));
    println(choose(false));
}
