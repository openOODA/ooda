// # Int is_ok refuse
//
// Logline: emit-llvm fail-closes .is_ok on an Int instead of extractvalue on i64.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. Bind n as Int 7.
//   2. Call n.is_ok().
//   3. Emit must print ERR llvm_emit.

pub fn main() {
    let n: Int = 7;
    println(n.is_ok().to_string());
}
