// # Product prove std/3d/gaussian.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/3d/gaussian.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gaussian: PASSED only if they match.

import "std/3d/gaussian.oo";

pub fn main() {
    let gaussian_a = shim_marker_cloud_new();
    let gaussian_b = shim_marker_cloud_new();
    let gaussian_va = shim_marker_cloud_count(gaussian_a);
    let gaussian_vb = shim_marker_cloud_count(gaussian_b);
    if gaussian_va != gaussian_vb {
        println("FAIL gaussian");
        process_exit(1);
    }
    println("prod_ap_gaussian: PASSED");
}
