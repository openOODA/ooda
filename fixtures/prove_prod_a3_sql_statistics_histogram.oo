// # Product prove std/db_storage/sql_statistics_histogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts histogram_bucket_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_statistics_histogram.oo.
//
// Beats:
//   1. Call histogram_bucket_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_statistics_histogram: PASSED only if they match.

import "std/db_storage/sql_statistics_histogram.oo";

pub fn main() {
    let sql_statistics_histogram_mark: Int = 0;
    if sql_statistics_histogram_mark != 0 {
        process_exit(1);
    }
    let a: HistogramBucket = histogram_bucket_new(0, 0, 0, 0);
    let b: HistogramBucket = histogram_bucket_new(0, 0, 0, 0);
    if (a).lower_bound != (b).lower_bound {
        println("FAIL histogram_bucket_new");
        process_exit(1);
    }
    println("prod_sql_statistics_histogram: PASSED");
}
