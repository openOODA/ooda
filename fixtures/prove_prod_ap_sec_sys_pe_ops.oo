// # Product prove std/sec/sys/pe_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/pe_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pe_ops: PASSED only if they match.

import "std/sec/sys/pe_ops.oo";

pub fn main() {
    let pe_ops_a = read_u16_le("x", 0);
    let pe_ops_b = read_u16_le("x", 0);
    if pe_ops_a != pe_ops_b {
        println("FAIL pe_ops");
        process_exit(1);
    }
    println("prod_ap_pe_ops: PASSED");
}
