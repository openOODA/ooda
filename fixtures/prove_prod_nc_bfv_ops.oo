// # Product prove std/sec/crypto/bfv_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_ops_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_ops.oo.
//
// Beats:
//   1. Call bfv_ops_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bfv_ops: PASSED only if it matches.

import "std/sec/crypto/bfv_ops.oo";

pub fn main() {
    let a: Int = bfv_ops_probe();
    if a != 0 {
        println("FAIL bfv_ops_probe");
        process_exit(1);
    }
    println("prod_nc_bfv_ops: PASSED");
}
