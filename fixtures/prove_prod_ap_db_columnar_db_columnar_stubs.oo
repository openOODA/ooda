// # Product prove std/db_columnar/db_columnar_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/db_columnar_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/db_columnar_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_db_columnar_stubs: PASSED only if they match.

import "std/db_columnar/db_columnar_stubs.oo";

pub fn main() {
    let db_columnar_stubs_a = db_columnar_fail_closed("x", 0);
    let db_columnar_stubs_b = db_columnar_fail_closed("x", 0);
    if db_columnar_stubs_a != db_columnar_stubs_b {
        println("FAIL db_columnar_stubs");
        process_exit(1);
    }
    println("prod_ap_db_columnar_stubs: PASSED");
}
