// # Product prove std/genomics_advanced/nanopore_squiggle_current.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_squiggle_current_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_squiggle_current.oo.
//
// Beats:
//   1. Call nanopore_squiggle_current_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanopore_squiggle_current: PASSED only if they match.

import "std/genomics_advanced/nanopore_squiggle_current.oo";

pub fn main() {
    let a = nanopore_squiggle_current_probe();
    let b = nanopore_squiggle_current_probe();
    if a != b {
        println("FAIL nanopore_squiggle_current_probe");
        process_exit(1);
    }
    println("prod_nanopore_squiggle_current: PASSED");
}
