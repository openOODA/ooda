// # Product prove std/math/matrix_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix_ops_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/math/matrix_ops.oo.
//
// Beats:
//   1. Call matrix_ops_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_matrix_ops: PASSED only if they match.

import "std/math/matrix_ops.oo";

pub fn main() {
    let a: Int = matrix_ops_probe();
    let b: Int = matrix_ops_probe();
    if a != 0 {
        println("FAIL matrix_ops_probe");
        process_exit(1);
    }
    if a != b {
        println("FAIL matrix_ops_probe");
        process_exit(1);
    }
    println("prod_matrix_ops: PASSED");
}
