// # Product prove std/markup/xml_tokenizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts xml_escape is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/xml_tokenizer.oo.
//
// Beats:
//   1. Call xml_escape twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xml_tokenizer: PASSED only if they match.

import "std/markup/xml_tokenizer.oo";

pub fn main() {
    let a = xml_escape("x");
    let b = xml_escape("x");
    if a != b {
        println("FAIL xml_escape");
        process_exit(1);
    }
    println("prod_xml_tokenizer: PASSED");
}
