// # Product line_writer prove
//
// Logline: Fail-closed emit+gcc+run of shipped line_writer_new/len.
//
// Setup: Product std/io/line_writer.oo. New writer is empty.
//
// Beats:
//   1. New line writer len is 0.
//   2. Exit 1 before PASSED on a miss.

import "std/io/line_writer.oo";

pub fn main() {
    let w: LineWriter = line_writer_new(8);
    let n: Int = line_writer_len(w);
    if n != 0 {
        println("FAIL linew len");
        process_exit(1);
    }
    println("prod_linew: PASSED");
}
