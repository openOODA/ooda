// # Product prove std/mesh_ebpf/ebpf_synproxy_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts synproxy_calc_cookie is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_synproxy_filter.oo.
//
// Beats:
//   1. Call synproxy_calc_cookie twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_synproxy_filter: PASSED only if they match.

import "std/mesh_ebpf/ebpf_synproxy_filter.oo";

pub fn main() {
    let ebpf_synproxy_filter_mark: Int = 0;
    if ebpf_synproxy_filter_mark != 0 {
        process_exit(1);
    }
    let ebpf_synproxy_filter_obj: SynProxyState = synproxy_new(1);
    let ebpf_synproxy_filter_a: Int = synproxy_calc_cookie(&ebpf_synproxy_filter_obj, 1, 1, 1, 1, 1, 1);
    let ebpf_synproxy_filter_b: Int = synproxy_calc_cookie(&ebpf_synproxy_filter_obj, 1, 1, 1, 1, 1, 1);
    if ebpf_synproxy_filter_a != ebpf_synproxy_filter_b {
        println("FAIL synproxy_calc_cookie");
        process_exit(1);
    }
    println("prod_ebpf_synproxy_filter: PASSED");
}
