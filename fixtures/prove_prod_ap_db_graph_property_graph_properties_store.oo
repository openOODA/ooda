// # Product prove std/db_graph/property_graph_properties_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_properties_store.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_properties_store.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_property_graph_properties_store: PASSED only if they match.

import "std/db_graph/property_graph_properties_store.oo";

pub fn main() {
    let property_graph_properties_store_a = property_block_new(0, 0, true);
    let property_graph_properties_store_b = property_block_new(0, 0, true);
    let property_graph_properties_store_va = property_block_find_str(property_graph_properties_store_a, "x");
    let property_graph_properties_store_vb = property_block_find_str(property_graph_properties_store_b, "x");
    if property_graph_properties_store_va.contains(property_graph_properties_store_vb) == false {
        println("FAIL property_graph_properties_store");
        process_exit(1);
    }
    if property_graph_properties_store_vb.contains(property_graph_properties_store_va) == false {
        println("FAIL property_graph_properties_store");
        process_exit(1);
    }
    println("prod_ap_property_graph_properties_store: PASSED");
}
