// # Product prove std/diag/log_formatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts format_text is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/log_formatter.oo.
//
// Beats:
//   1. Call format_text twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_log_formatter: PASSED only if they match.

import "std/diag/log_formatter.oo";

pub fn main() {
    let obj = record_new("x", "x", "x", 0);
    let a = format_text(obj);
    let b = format_text(obj);
    if a != b {
        println("FAIL format_text");
        process_exit(1);
    }
    println("prod_log_formatter: PASSED");
}
