// # Product prove std/fin/pricing.oo
//
// Logline: Fail-closed emit+gcc+run asserts option pricing and volatility surface evaluations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/pricing.oo.
//
// Beats:
//   1. Evaluate standard normal PDF and CDF distributions.
//   2. Compute Black-Scholes call option pricing result.
//   3. Construct parametric volatility surface and calculate implied volatility.
//   4. Print prod_g4_fin_pricing: PASSED and exit 0.

import "std/fin/pricing.oo";

pub fn main() {
    let pdf1: Float = shim_marker_normal_pdf();
    let pdf2: Float = shim_marker_normal_pdf();
    if pdf1 != pdf2 || pdf1 <= 0.0 {
        println("FAIL shim_marker_normal_pdf");
        process_exit(1);
    }

    let cdf1: Float = shim_marker_normal_cdf();
    let cdf2: Float = shim_marker_normal_cdf();
    if cdf1 != cdf2 || cdf1 < 0.499 || cdf1 > 0.501 {
        println("FAIL shim_marker_normal_cdf");
        process_exit(1);
    }

    let contract1: OptionContract = shim_marker_option_new();
    let contract2: OptionContract = shim_marker_option_new();
    let res1: PricingResult = shim_marker_price_bs(contract1);
    let res2: PricingResult = shim_marker_price_bs(contract2);
    if (res1).price != (res2).price || (res1).price <= 0.0 {
        println("FAIL shim_marker_price_bs");
        process_exit(1);
    }

    let surf1: VolatilitySurface = shim_marker_vol_surface();
    let surf2: VolatilitySurface = shim_marker_vol_surface();
    let vol1: Float = shim_marker_eval_vol(surf1);
    let vol2: Float = shim_marker_eval_vol(surf2);
    if vol1 != vol2 || vol1 <= 0.0 {
        println("FAIL shim_marker_eval_vol");
        process_exit(1);
    }

    println("prod_g4_fin_pricing: PASSED");
    process_exit(0);
}
