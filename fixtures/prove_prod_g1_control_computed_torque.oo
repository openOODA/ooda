// # Product prove std/robotics_ros2/control_computed_torque.oo
//
// Logline: Fail-closed emit+gcc+run asserts pd_gains_2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/control_computed_torque.oo.
//
// Beats:
//   1. Call pd_gains_2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_control_computed_torque: PASSED only if they match.

import "std/robotics_ros2/control_computed_torque.oo";

pub fn main() {
    let a: PDGains2D = pd_gains_2d_new(0.0, 0.0, 0.0, 0.0);
    let b: PDGains2D = pd_gains_2d_new(0.0, 0.0, 0.0, 0.0);
    if a.kp1 != b.kp1 {
        println("FAIL pd_gains_2d_new");
        process_exit(1);
    }
    println("prod_control_computed_torque: PASSED");
}
