// # Product prove std/math/bigdecimal_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts bigdec_add value or determinism.
//
// Setup: Isolated emit-c. Imports std/math/bigdecimal_ops.oo.
//
// Beats:
//   1. Call bigdec_add twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_bigdecimal_ops: PASSED only if asserts hold.

import "std/math/bigdecimal_ops.oo";

pub fn main() {
    let za = bigdec_zero();
    let zb = bigdec_one();
    let bigdecimal_ops_a = bigdec_add(za, zb);
    let bigdecimal_ops_b = bigdec_add(bigdec_zero(), bigdec_one());
    if bigdecimal_ops_a.scale != 0 {
        println("FAIL bigdec_add scale");
        process_exit(1);
    }
    if bigdecimal_ops_a.scale != bigdecimal_ops_b.scale {
        println("FAIL bigdec_add det");
        process_exit(1);
    }
    if bigdecimal_ops_a.is_neg != false {
        println("FAIL bigdec_add sign");
        process_exit(1);
    }
    println("prod_bigdecimal_ops: PASSED");
}
