// # Product prove std/fintech_l3_book/l3_order_book_memory_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts memory_pool_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_order_book_memory_pool.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call memory_pool_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_order_book_memory_pool: PASSED only if they match.

import "std/fintech_l3_book/l3_order_book_memory_pool.oo";

pub fn main() {
    let g2_oa: MemoryPoolConfig = memory_pool_config_new(8);
    let g2_ob: MemoryPoolConfig = memory_pool_config_new(8);
    let g2_a = (g2_oa).total_capacity;
    let g2_b = (g2_ob).total_capacity;
    if g2_a != g2_b {
        println("FAIL memory_pool_config_new.total_capacity");
        process_exit(1);
    }
    println("prod_g2_l3_order_book_memory_pool: PASSED");
}
