// # Product prove std/tui/tui_cell.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_cell_has_modifier is a real value.
//
// Setup: Isolated emit-c. Imports std/tui/tui_cell.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tui_cell_has_modifier twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tui_cell: PASSED only if they match.

import "std/tui/tui_cell.oo";

pub fn main() {
    let g2_oa = tui_cell_new(2, 2, 2);
    let g2_ob = tui_cell_new(2, 2, 2);
    let g2_a = tui_cell_has_modifier(g2_oa, 2);
    let g2_b = tui_cell_has_modifier(g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL tui_cell_has_modifier");
        process_exit(1);
    }
    println("prod_g2_tui_cell: PASSED");
}
