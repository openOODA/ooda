// # Product prove std/quantum_topological/topological_measurement_interferometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts interferometer_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_measurement_interferometry.oo.
//
// Beats:
//   1. Call interferometer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_measurement_interferometry: PASSED only if they match.

import "std/quantum_topological/topological_measurement_interferometry.oo";

pub fn main() {
    let a: InterferometerConfig = interferometer_config_new(0.0, 0.0, 0.0, 0.0);
    let b: InterferometerConfig = interferometer_config_new(0.0, 0.0, 0.0, 0.0);
    if a.area_nm2 != b.area_nm2 {
        println("FAIL interferometer_config_new");
        process_exit(1);
    }
    println("prod_topological_measurement_interferometry: PASSED");
}
