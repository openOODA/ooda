// # Product prove std/tda_topology/tda_topology_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts tda_capabilities_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/tda_topology/tda_topology_stubs.oo.
//
// Beats:
//   1. Call tda_capabilities_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_tda_topology_stubs: PASSED only if asserts hold.

import "std/tda_topology/tda_topology_stubs.oo";

pub fn main() {
    let tda_topology_stubs_a: TdaCapabilities = tda_capabilities_default();
    let tda_topology_stubs_b: TdaCapabilities = tda_capabilities_default();
    if tda_topology_stubs_a.max_point_cloud_size != tda_topology_stubs_b.max_point_cloud_size {
        println("FAIL tda_capabilities_default");
        process_exit(1);
    }
    println("prod_tda_topology_stubs: PASSED");
}
