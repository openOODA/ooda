// # Skip list adversarial suite
//
// Logline: Inserts, searches, and deletes on a 32-level skip list, then runs 50000 randomized cycles.
//
// Setup: Pure. Imports skiplist_concurrent modules. Run from ooda/.
//
// Beats:
//   1. Insert, search, and delete a few keys.
//   2. Prove no node level exceeds 32 and forwards stay ordered.
//   3. Run 50000 randomized insert/delete cycles.

import "std/collections/skiplist_concurrent_mut.oo";

pub fn main() {
    if skiplist_concurrent_mut_alive() < 1 {
        println("FAIL mut");
        process_exit(1);
    }
    let mut sl: SkipList = skiplist_concurrent_new();
    sl = skiplist_concurrent_insert(sl, 10, 100);
    sl = skiplist_concurrent_insert(sl, 5, 50);
    sl = skiplist_concurrent_insert(sl, 20, 200);
    let g: Result[Int, String] = skiplist_concurrent_search(sl, 10);
    if g.is_err() {
        println("FAIL search 10");
        process_exit(1);
    }
    match g {
        Ok(v) => {
            if v != 100 {
                println("FAIL val");
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL " + e);
            process_exit(1);
        }
    }
    sl = skiplist_concurrent_delete(sl, 5);
    let m: Result[Int, String] = skiplist_concurrent_search(sl, 5);
    if m.is_ok() {
        println("FAIL deleted");
        process_exit(1);
    }
    println("insert/search/delete");

    if skiplist_concurrent_max_level(sl) > 32 {
        println("FAIL max level");
        process_exit(1);
    }
    println("no node level > 32");

    if skiplist_concurrent_forward_ok(sl) < 1 {
        println("FAIL forward");
        process_exit(1);
    }

    let mut s: Int = 99;
    let mut i: Int = 0;
    while i < 50000 {
        s = (s * 1103515245 + 12345) & 2147483647;
        let k: Int = s % 32;
        s = (s * 1103515245 + 12345) & 2147483647;
        if (s & 1) == 0 {
            sl = skiplist_concurrent_insert(sl, k, k);
        } else {
            sl = skiplist_concurrent_delete(sl, k);
        }
        i = i + 1;
    }
    if skiplist_concurrent_forward_ok(sl) < 1 {
        println("FAIL forward after cycles");
        process_exit(1);
    }
    if skiplist_concurrent_max_level(sl) > 32 {
        println("FAIL level after cycles");
        process_exit(1);
    }
    println("forward-array consistency after mutations");
    println("50000 randomized insert/delete cycles");
    println("SUITE PASSED");
    println("test_skiplist: PASSED");
}
