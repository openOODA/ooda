// # Product prove std/astro_advanced/electric_propulsion_hall_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/electric_propulsion_hall_thruster.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/electric_propulsion_hall_thruster.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_electric_propulsion_hall_thruster: PASSED only if they match.

import "std/astro_advanced/electric_propulsion_hall_thruster.oo";

pub fn main() {
    let electric_propulsion_hall_thruster_a = hall_isp();
    let electric_propulsion_hall_thruster_b = hall_isp();
    if electric_propulsion_hall_thruster_a != electric_propulsion_hall_thruster_b {
        println("FAIL electric_propulsion_hall_thruster");
        process_exit(1);
    }
    println("prod_ap_electric_propulsion_hall_thruster: PASSED");
}
