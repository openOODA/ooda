// # Product prove std/aero/navigation_quat.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_quat_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_quat.oo.
//
// Beats:
//   1. Call nav_quat_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_navigation_quat: PASSED only if they match.

import "std/aero/navigation_quat.oo";

pub fn main() {
    let navigation_quat_mark: Int = 0;
    if navigation_quat_mark != 0 {
        process_exit(1);
    }
    let a: NavQuat = nav_quat_new(0, 0);
    let b: NavQuat = nav_quat_new(0, 0);
    if (a).w != (b).w {
        println("FAIL nav_quat_new");
        process_exit(1);
    }
    println("prod_g2_navigation_quat: PASSED");
}
