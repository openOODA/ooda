// # Product prove std/fintech_l3_book/itch_retail_price_improvement.oo
//
// Logline: Fail-closed emit+gcc+run asserts rpii_message_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/itch_retail_price_improvement.oo.
//
// Beats:
//   1. Call rpii_message_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_itch_retail_price_improvement: PASSED only if they match.

import "std/fintech_l3_book/itch_retail_price_improvement.oo";

pub fn main() {
    let itch_retail_price_improvement_mark: Int = 0;
    if itch_retail_price_improvement_mark != 0 {
        process_exit(1);
    }
    let a: RpiiMessage = rpii_message_new(0, "x", "x");
    let b: RpiiMessage = rpii_message_new(0, "x", "x");
    if (a).timestamp_ns != (b).timestamp_ns {
        println("FAIL rpii_message_new");
        process_exit(1);
    }
    println("prod_itch_retail_price_improvement: PASSED");
}
