// # Product prove std/compilers_polyhedral/hexagonal_tiling_stencil.oo
//
// Logline: Fail-closed emit+gcc+run asserts hexagonal_tile_internal_volume is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/hexagonal_tiling_stencil.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call hexagonal_tile_internal_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hexagonal_tiling_stencil: PASSED only if they match.

import "std/compilers_polyhedral/hexagonal_tiling_stencil.oo";

pub fn main() {
    let g2_oa: HexagonalTile = HexagonalTile { tile_id: 2, time_steps: 2, bottom_spatial_width: 8, top_spatial_width: 8, is_inverted: true };
    let g2_ob: HexagonalTile = HexagonalTile { tile_id: 2, time_steps: 2, bottom_spatial_width: 8, top_spatial_width: 8, is_inverted: true };
    let g2_a = hexagonal_tile_internal_volume(g2_oa);
    let g2_b = hexagonal_tile_internal_volume(g2_ob);
    if g2_a != g2_b {
        println("FAIL hexagonal_tile_internal_volume");
        process_exit(1);
    }
    println("prod_g2_hexagonal_tiling_stencil: PASSED");
}
