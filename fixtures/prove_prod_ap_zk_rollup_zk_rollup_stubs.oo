// # Product prove std/zk_rollup/zk_rollup_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/zk_rollup_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/zk_rollup_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zk_rollup_stubs: PASSED only if they match.

import "std/zk_rollup/zk_rollup_stubs.oo";

pub fn main() {
    let zk_rollup_stubs_a = zk_rollup_fail_closed("x", 0);
    let zk_rollup_stubs_b = zk_rollup_fail_closed("x", 0);
    if zk_rollup_stubs_a != zk_rollup_stubs_b {
        println("FAIL zk_rollup_stubs");
        process_exit(1);
    }
    println("prod_ap_zk_rollup_stubs: PASSED");
}
