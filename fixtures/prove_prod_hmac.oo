// # Product prove std/crypto/hmac.oo
//
// Logline: Fail-closed emit+gcc+run asserts hmac_sha256 is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/hmac.oo.
//
// Beats:
//   1. Call hmac_sha256 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hmac: PASSED only if they match.

import "std/crypto/hmac.oo";

pub fn main() {
    let a = hmac_sha256("x", "x");
    let b = hmac_sha256("x", "x");
    if a != b {
        println("FAIL hmac_sha256");
        process_exit(1);
    }
    println("prod_hmac: PASSED");
}
