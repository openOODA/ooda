// # Product stream_take prove
//
// Logline: Fail-closed emit+gcc+run of shipped stream_take peek/next/has_next.
//
// Setup: Product std/io/stream_take.oo. List[Int] destub.
//
// Beats:
//   1. [1,2,3] take 2 peeks 1 then 2; after two nexts has_next false.
//   2. Exit 1 before PASSED on a miss.

import "std/io/stream_take.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    xs = list_push(xs, 3);
    let mut st: StreamTake = stream_take_new(xs, 2);
    let p0: Int = stream_take_peek(st);
    if p0 != 1 {
        println("FAIL take peek1");
        process_exit(1);
    }
    st = stream_take_next(st);
    let p1: Int = stream_take_peek(st);
    if p1 != 2 {
        println("FAIL take peek2");
        process_exit(1);
    }
    st = stream_take_next(st);
    let more: Bool = stream_take_has_next(st);
    if more == true {
        println("FAIL take eof");
        process_exit(1);
    }
    println("prod_stake: PASSED");
}
