// # Product prove std/astrophysics_relativity/stellar_oppenheimer_volkoff.oo
//
// Logline: Fail-closed emit+gcc+run asserts TovState is a real value.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_oppenheimer_volkoff.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call TovState twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stellar_oppenheimer_volkoff: PASSED only if they match.

import "std/astrophysics_relativity/stellar_oppenheimer_volkoff.oo";

pub fn main() {
    let g2_oa: TovState = TovState { radius_m:1.0, enclosed_mass_kg:1.0, pressure_pa:1.0 };
    let g2_ob: TovState = TovState { radius_m:1.0, enclosed_mass_kg:1.0, pressure_pa:1.0 };
    let g2_a = (g2_oa).radius_m;
    let g2_b = (g2_ob).radius_m;
    if g2_a != g2_b {
        println("FAIL TovState.radius_m");
        process_exit(1);
    }
    println("prod_g2_stellar_oppenheimer_volkoff: PASSED");
}
