// # Const let bind inside if true then
//
// Logline: Print 7 from a let recorded only inside a folded true then.
//
// Setup: Side emit-aarch64 records KW_LET while in_main inside the harvested then.
//
// Beats:
//   1. if true { let n = 7; println(n) }.
//   2. Expect 7.
//   3. No leftover.

pub fn main() {
    if true {
        let n = 7;
        println(n);
    }
}
