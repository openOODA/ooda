// # Secret helper hits println
//
// Logline: hide returns a secret api_key and main prints the helper result.
//
// Beats:
//   1. Mark api_key as a SECRET.
//   2. hide returns that secret.
//   3. main prints hide() at a sink.

// SECRET helper return at sink
// SECRET: api_key
pub fn hide() -> String {
    let api_key = "tok";
    return api_key;
}
pub fn main() {
    println(hide());
}
