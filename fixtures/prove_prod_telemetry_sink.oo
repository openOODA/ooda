// # Product prove std/diag/telemetry_sink.oo
//
// Logline: Fail-closed emit+gcc+run asserts telemetry_sink_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/telemetry_sink.oo.
//
// Beats:
//   1. Call telemetry_sink_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_telemetry_sink: PASSED only if they match.

import "std/diag/telemetry_sink.oo";

pub fn main() {
    let obj = telemetry_sink_new(0);
    let a = telemetry_sink_len(obj);
    let b = telemetry_sink_len(obj);
    if a != b {
        println("FAIL telemetry_sink_len");
        process_exit(1);
    }
    println("prod_telemetry_sink: PASSED");
}
