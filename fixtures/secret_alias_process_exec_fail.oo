// # Refuse secret alias in process_exec
//
// Logline: Assigning a SECRET token to an alias and passing that alias to process_exec must fail closed.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Assign token to alias cmd.
//   3. Pass cmd to process_exec so the sink refuses.
//
// Secret alias must not reach process_exec
// SECRET: token
pub fn main(p: &ProcessCap) {
    let token = "s3cret-payload";
    let cmd = token;
    let r = process_exec(p, cmd);
    println(1);
}
