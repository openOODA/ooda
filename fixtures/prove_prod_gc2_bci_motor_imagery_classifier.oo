// # Product prove std/neuro_bci/bci_motor_imagery_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_erd_percent is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_motor_imagery_classifier.oo.
//
// Beats:
//   1. Call compute_erd_percent twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bci_motor_imagery_classifier: PASSED only if they match.

import "std/neuro_bci/bci_motor_imagery_classifier.oo";

pub fn main() {
    let bci_motor_imagery_classifier_mark: Int = 0;
    if bci_motor_imagery_classifier_mark != 0 {
        process_exit(1);
    }
    let bci_motor_imagery_classifier_a: Float = compute_erd_percent(1.0, 1.0);
    let bci_motor_imagery_classifier_b: Float = compute_erd_percent(1.0, 1.0);
    if bci_motor_imagery_classifier_a != bci_motor_imagery_classifier_b {
        println("FAIL compute_erd_percent");
        process_exit(1);
    }
    println("prod_bci_motor_imagery_classifier: PASSED");
}
