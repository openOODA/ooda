// # Product Prove std/embedded_hal/mmu_token_map.oo
//
// Logline: Deterministic assertion fixture verifying MMU page mapping, flag bitmask computation, and interrupt vector configuration.
//
// Setup: Standalone emit-c test fixture importing std/embedded_hal/mmu_token_map.oo.
//
// Beats:
//   1. Initialize MmuDirectory and map read/write/execute memory frames.
//   2. Assert physical addresses, page flags (bitmask), and total mapped bytes.
//   3. Initialize InterruptVectorEntry and UartPortDescriptor.
//   4. Print "prod_g4_emb_mmu_token_map: PASSED".

import "std/embedded_hal/mmu_token_map.oo";

pub fn main() {
    let mut mmu_dir: MmuDirectory = mmu_directory_new(1);

    // Map Page 0: Read-Only Executable (.text at 0x100000) -> flags: 1 | 8 = 9
    let _m0: Bool = mmu_map_frame(&mut mmu_dir, 1048576, false, true);

    // Map Page 1: Read-Write Data (.data at 0x200000) -> flags: 1 | 2 = 3
    let _m1: Bool = mmu_map_frame(&mut mmu_dir, 2097152, true, false);

    if (mmu_dir).entry_count != 2 {
        println("FAIL: entry_count mismatch");
        process_exit(1);
    }

    if (mmu_dir).total_mapped_bytes != 8192 {
        println("FAIL: total_mapped_bytes mismatch");
        process_exit(1);
    }

    let pte0: PageTableEntry = list_get((mmu_dir).entries, 0);
    if (pte0).flags_bitmask != 9 {
        println("FAIL: pte0 flags_bitmask mismatch");
        process_exit(1);
    }

    let pte1: PageTableEntry = list_get((mmu_dir).entries, 1);
    if (pte1).flags_bitmask != 3 {
        println("FAIL: pte1 flags_bitmask mismatch");
        process_exit(1);
    }

    let ivt: InterruptVectorEntry = interrupt_vector_entry_new(14, 101, 1);
    if (ivt).irq_number != 14 {
        println("FAIL: ivt irq_number mismatch");
        process_exit(1);
    }

    let uart: UartPortDescriptor = uart_port_descriptor_new(1010565120, 115200); // 0x3F215000 (BCM UART)
    if (uart).baud_rate != 115200 {
        println("FAIL: uart baud_rate mismatch");
        process_exit(1);
    }

    println("prod_g4_emb_mmu_token_map: PASSED");
    process_exit(0);
}
