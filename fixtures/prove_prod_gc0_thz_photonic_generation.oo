// # Product prove std/telecom_6g/thz_photonic_generation.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_photonic_emission_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_photonic_generation.oo.
//
// Beats:
//   1. Call thz_photonic_emission_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_photonic_generation: PASSED only if they match.

import "std/telecom_6g/thz_photonic_generation.oo";

pub fn main() {
    let thz_photonic_generation_mark: Int = 0;
    if thz_photonic_generation_mark != 0 {
        process_exit(1);
    }
    let thz_photonic_generation_a = thz_photonic_emission_eval(utc_pd_config_high_speed(), 1.0, 1.0, 1.0);
    let thz_photonic_generation_b = thz_photonic_emission_eval(utc_pd_config_high_speed(), 1.0, 1.0, 1.0);
    if (thz_photonic_generation_a).laser_beat_frequency_ghz != (thz_photonic_generation_b).laser_beat_frequency_ghz {
        println("FAIL thz_photonic_emission_eval");
        process_exit(1);
    }
    println("prod_thz_photonic_generation: PASSED");
}
