// # Product prove std/compilers_vm/opt_dead_code_elimination.oo
//
// Logline: Fail-closed emit+gcc+run asserts ssa_inst_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_dead_code_elimination.oo.
//
// Beats:
//   1. Call ssa_inst_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opt_dead_code_elimination: PASSED only if they match.

import "std/compilers_vm/opt_dead_code_elimination.oo";

pub fn main() {
    let a: SsaInstruction = ssa_inst_new(0, 0, 0, "x", 0);
    let b: SsaInstruction = ssa_inst_new(0, 0, 0, "x", 0);
    if a.inst_id != b.inst_id {
        println("FAIL ssa_inst_new");
        process_exit(1);
    }
    println("prod_opt_dead_code_elimination: PASSED");
}
