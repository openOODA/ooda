// M164 path A: List[Int] 0..255 Byte buffer free names (no multi-import)
pub fn main() {
    let mut bs: List[Int] = bytes_new();
    bs = bytes_push(bs, 65);
    bs = bytes_push(bs, 66);
    println(bytes_get(bs, 0));
    println(bytes_get(bs, 1));
    println(bytes_get(bs, 99));
    println(bytes_to_str(bs));
    println(bytes_len(bytes_to_str(bs)));
    println(byte_at(bytes_to_str(bs), 0));
    println(bytes_eq(bytes_from_str("AB"), "AB"));
    println(bytes_eq(bytes_concat("A", "B"), "AB"));
}
