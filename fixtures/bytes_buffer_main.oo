// M164 path A: List[Int] 0..255 Byte buffer (not List[Byte] ABI, not &str)
// Free names only (no multi-import) so oodac rebuild ships without std load.
pub fn main() {
    let mut bs: List[Int] = bytes_new();
    bs = bytes_push(bs, 65);
    bs = bytes_push(bs, 66);
    println(bytes_get(bs, 0));
    println(bytes_get(bs, 1));
    println(bytes_get(bs, 99));
    let s = bytes_to_str(bs);
    println(s);
    println(bytes_len(s));
    println(byte_at(s, 0));
    let v = bytes_from_str(s);
    println(bytes_eq(v, "AB"));
    let c = bytes_concat("A", "B");
    println(bytes_eq(c, "AB"));
}
