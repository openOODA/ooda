// # Product prove std/sec/crypto/plonk_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/plonk_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plonk_stubs: PASSED only if they match.

import "std/sec/crypto/plonk_stubs.oo";

pub fn main() {
    let plonk_stubs_a = plonk_eval_plookup_table_commitment(list_new());
    let plonk_stubs_b = plonk_eval_plookup_table_commitment(list_new());
    if plonk_stubs_a != plonk_stubs_b {
        println("FAIL plonk_stubs");
        process_exit(1);
    }
    println("prod_ap_plonk_stubs: PASSED");
}
