// # Product prove std/astrophysics_relativity/gw_stochastic_background_omega.oo
//
// Logline: Fail-closed emit+gcc+run asserts sgwb_critical_energy_density is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_stochastic_background_omega.oo.
//
// Beats:
//   1. Call sgwb_critical_energy_density twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_stochastic_background_omega: PASSED only if they match.

import "std/astrophysics_relativity/gw_stochastic_background_omega.oo";

pub fn main() {
    let gw_stochastic_background_omega_mark: Int = 0;
    if gw_stochastic_background_omega_mark != 0 {
        process_exit(1);
    }
    let a: Float = sgwb_critical_energy_density(0.0);
    let b: Float = sgwb_critical_energy_density(0.0);
    if a != b {
        println("FAIL sgwb_critical_energy_density");
        process_exit(1);
    }
    println("prod_gw_stochastic_background_omega: PASSED");
}
