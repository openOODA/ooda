// # Hostile if (x) fold
//
// Logline: Print fold-me or other from if (x) so emit-wasm must miss a const-paren fold.
//
// Setup: One public main. Paren operand is IDENT x.
//
// Beats:
//   1. Let x be true.
//   2. If (x) print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = true;
    if (x) {
        println("fold-me");
    } else {
        println("other");
    }
}
