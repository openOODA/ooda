// # Product prove std/telecom_5g/channel_awgn_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_box_muller_re is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_awgn_generator.oo.
//
// Beats:
//   1. Call channel_box_muller_re twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_awgn_generator: PASSED only if they match.

import "std/telecom_5g/channel_awgn_generator.oo";

pub fn main() {
    let channel_awgn_generator_mark: Int = 0;
    if channel_awgn_generator_mark != 0 {
        process_exit(1);
    }
    let a: Float = channel_box_muller_re(0.0, 0.0);
    let b: Float = channel_box_muller_re(0.0, 0.0);
    if a != b {
        println("FAIL channel_box_muller_re");
        process_exit(1);
    }
    println("prod_channel_awgn_generator: PASSED");
}
