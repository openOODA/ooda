// # Product prove std/sec/crypto/hmac_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/hmac_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hmac_ops: PASSED only if they match.

import "std/sec/crypto/hmac_ops.oo";

pub fn main() {
    let hmac_ops_a = checksum_calculate("x");
    let hmac_ops_b = checksum_calculate("x");
    if hmac_ops_a != hmac_ops_b {
        println("FAIL hmac_ops");
        process_exit(1);
    }
    println("prod_ap_hmac_ops: PASSED");
}
