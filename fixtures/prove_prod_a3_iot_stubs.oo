// # Product prove std/industrial_iot/iot_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts iot_hardware_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/iot_stubs.oo.
//
// Beats:
//   1. Call iot_hardware_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_iot_stubs: PASSED only if they match.

import "std/industrial_iot/iot_stubs.oo";

pub fn main() {
    let iot_stubs_mark: Int = 0;
    if iot_stubs_mark != 0 {
        process_exit(1);
    }
    let a: IndustrialIoHardwareConfig = iot_hardware_config_new(0, "x", 0);
    let b: IndustrialIoHardwareConfig = iot_hardware_config_new(0, "x", 0);
    if (a).bus_type != (b).bus_type {
        println("FAIL iot_hardware_config_new");
        process_exit(1);
    }
    println("prod_iot_stubs: PASSED");
}
