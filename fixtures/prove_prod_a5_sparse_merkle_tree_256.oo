// # Product prove std/zk_rollup/sparse_merkle_tree_256.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt256_hash_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_256.oo.
//
// Beats:
//   1. Call smt256_hash_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_merkle_tree_256: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_256.oo";

pub fn main() {
    let sparse_merkle_tree_256_mark: Int = 0;
    if sparse_merkle_tree_256_mark != 0 {
        process_exit(1);
    }
    let a: String = smt256_hash_pair("x", "x");
    let b: String = smt256_hash_pair("x", "x");
    if a != b {
        println("FAIL smt256_hash_pair");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_256: PASSED");
}
