// # Product prove std/sec/crypto/hmac_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/hmac_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hmac_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hmac_types: PASSED only if they match.

import "std/sec/crypto/hmac_types.oo";

pub fn main() {
    let hmac_types_a = hmac_key_new(0, 0, 0, 0);
    let hmac_types_b = hmac_key_new(0, 0, 0, 0);
    let hmac_types_va = hmac_key_used(hmac_types_a);
    let hmac_types_vb = hmac_key_used(hmac_types_b);
    if hmac_types_va != hmac_types_vb {
        println("FAIL hmac_types");
        process_exit(1);
    }
    println("prod_ap_hmac_types: PASSED");
}
