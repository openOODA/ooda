// # Product prove std/db_vector_ann/ivf_adaptive_nprobe.oo
//
// Logline: Fail-closed emit+gcc+run asserts adaptive_probe_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/ivf_adaptive_nprobe.oo.
//
// Beats:
//   1. Call adaptive_probe_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ivf_adaptive_nprobe: PASSED only if they match.

import "std/db_vector_ann/ivf_adaptive_nprobe.oo";

pub fn main() {
    let ivf_adaptive_nprobe_mark: Int = 0;
    if ivf_adaptive_nprobe_mark != 0 {
        process_exit(1);
    }
    let a: AdaptiveProbeConfig = adaptive_probe_config_default();
    let b: AdaptiveProbeConfig = adaptive_probe_config_default();
    if (a).min_nprobe != (b).min_nprobe {
        println("FAIL adaptive_probe_config_default");
        process_exit(1);
    }
    println("prod_ivf_adaptive_nprobe: PASSED");
}
