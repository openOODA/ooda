// # Product prove std/genomics_advanced/polygenic_risk_score_prs.oo
//
// Logline: Fail-closed emit+gcc+run asserts polygenic_risk_score_prs_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/polygenic_risk_score_prs.oo.
//
// Beats:
//   1. Call polygenic_risk_score_prs_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polygenic_risk_score_prs: PASSED only if they match.

import "std/genomics_advanced/polygenic_risk_score_prs.oo";

pub fn main() {
    let a = polygenic_risk_score_prs_probe();
    let b = polygenic_risk_score_prs_probe();
    if a != b {
        println("FAIL polygenic_risk_score_prs_probe");
        process_exit(1);
    }
    println("prod_polygenic_risk_score_prs: PASSED");
}
