// # Product prove std/graph_networks/minhash_lsh_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsh_hash_band is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/minhash_lsh_index.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call lsh_hash_band twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_minhash_lsh_index: PASSED only if they match.

import "std/graph_networks/minhash_lsh_index.oo";

pub fn main() {
    let g0_oa: MinHashSignature = MinHashSignature { doc_id: 0, signature: list_new() };
    let g0_ob: MinHashSignature = MinHashSignature { doc_id: 0, signature: list_new() };
    let g0_a = lsh_hash_band(&g0_oa, 0, 0);
    let g0_b = lsh_hash_band(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL lsh_hash_band");
        process_exit(1);
    }
    println("prod_gr_minhash_lsh_index: PASSED");
}
