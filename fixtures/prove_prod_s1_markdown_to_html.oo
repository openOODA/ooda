// # Product prove std/web_ecosystem/markdown_to_html.oo
//
// Logline: Fail-closed emit+gcc+run asserts markdown_to_html is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/markdown_to_html.oo.
//
// Beats:
//   1. Call markdown_to_html twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_markdown_to_html: PASSED only if they match.

import "std/web_ecosystem/markdown_to_html.oo";
import "std/str.oo";

pub fn main() {
    let markdown_to_html_mark: Int = 0;
    if markdown_to_html_mark != 0 {
        process_exit(1);
    }
    let markdown_to_html_a: String = markdown_to_html("x");
    let markdown_to_html_b: String = markdown_to_html("x");
    if str_eq(markdown_to_html_a, markdown_to_html_b) == false {
        println("FAIL markdown_to_html");
        process_exit(1);
    }
    println("prod_markdown_to_html: PASSED");
}
