// # Product prove std/math/matrix_decomp_svd.oo
//
// Logline: Fail-closed verification that SVD factorization, rank evaluation, and pseudo-inverse are deterministic.
//
// Setup: Isolated emit-c. Imports std/math/matrix_decomp_svd.oo.
//
// Beats:
//   1. Construct 2x2 matrix and decompose via matrix_svd_2x2.
//   2. Verify singular values and rank computation.
//   3. Compute pseudo-inverse via svd_pseudo_inverse_2x2.
//   4. Print prod_g4_matrix_decomp_svd: PASSED and exit 0.

import "std/math/matrix_decomp_svd.oo";

pub fn main() {
    let mut d: List[Float] = list_new();
    d = list_push(d, 3.0);
    d = list_push(d, 0.0);
    d = list_push(d, 0.0);
    d = list_push(d, 4.0);
    let mat: Matrix = Matrix { rows: 2, cols: 2, data: d };

    let svd1 = matrix_svd_2x2(mat);
    let svd2 = matrix_svd_2x2(mat);

    let s0_1 = list_get(svd1.s, 0);
    let s0_2 = list_get(svd2.s, 0);
    let s1_1 = list_get(svd1.s, 1);
    let s1_2 = list_get(svd2.s, 1);

    if s0_1 != s0_2 || s1_1 != s1_2 {
        println("FAIL matrix_svd_2x2 singular values mismatch");
        process_exit(1);
    }

    let rank_full1 = svd_rank(svd1, 0.0001);
    let rank_full2 = svd_rank(svd2, 0.0001);
    if rank_full1 != 2 || rank_full2 != 2 {
        println("FAIL svd_rank full");
        process_exit(1);
    }

    let rank_one = svd_rank(svd1, 3.5);
    if rank_one != 1 {
        println("FAIL svd_rank threshold");
        process_exit(1);
    }

    let pinv1 = svd_pseudo_inverse_2x2(svd1, 0.0001);
    let pinv2 = svd_pseudo_inverse_2x2(svd2, 0.0001);

    let p00_1 = matrix_get(pinv1, 0, 0);
    let p00_2 = matrix_get(pinv2, 0, 0);
    let p11_1 = matrix_get(pinv1, 1, 1);
    let p11_2 = matrix_get(pinv2, 1, 1);

    if p00_1 != p00_2 || p11_1 != p11_2 {
        println("FAIL svd_pseudo_inverse_2x2 mismatch");
        process_exit(1);
    }

    if p00_1 < 0.32 || p00_1 > 0.34 || p11_1 < 0.24 || p11_1 > 0.26 {
        println("FAIL svd_pseudo_inverse_2x2 values");
        process_exit(1);
    }

    println("prod_g4_matrix_decomp_svd: PASSED");
    process_exit(0);
}
