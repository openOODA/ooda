// # Product prove std/formal_verif/abstract_congruence_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts gcd is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_congruence_domain.oo.
//
// Beats:
//   1. Call gcd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abstract_congruence_domain: PASSED only if they match.

import "std/formal_verif/abstract_congruence_domain.oo";

pub fn main() {
    let abstract_congruence_domain_mark: Int = 0;
    if abstract_congruence_domain_mark != 0 {
        process_exit(1);
    }
    let a: Int = gcd(0, 0);
    let b: Int = gcd(0, 0);
    if a != b {
        println("FAIL gcd");
        process_exit(1);
    }
    println("prod_g2_abstract_congruence_domain: PASSED");
}
