// # Product prove std/net/org_src_net.oo
//
// Logline: Fail-closed emit+gcc+run asserts rx001_k is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/org_src_net.oo.
//
// Beats:
//   1. Call rx001_k twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_org_src_net: PASSED only if they match.

import "std/net/org_src_net.oo";

pub fn main() {
    let a = rx001_k();
    let b = rx001_k();
    if a != b {
        println("FAIL rx001_k");
        process_exit(1);
    }
    println("prod_org_src_net: PASSED");
}
