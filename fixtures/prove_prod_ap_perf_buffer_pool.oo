// # Product prove std/perf/buffer_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/buffer_pool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/buffer_pool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_buffer_pool: PASSED only if they match.

import "std/perf/buffer_pool.oo";

pub fn main() {
    let buffer_pool_a = buffer_pool_create("x", 0, 0);
    let buffer_pool_b = buffer_pool_create("x", 0, 0);
    let buffer_pool_va = buffer_pool_used(buffer_pool_a);
    let buffer_pool_vb = buffer_pool_used(buffer_pool_b);
    if buffer_pool_va != buffer_pool_vb {
        println("FAIL buffer_pool");
        process_exit(1);
    }
    println("prod_ap_buffer_pool: PASSED");
}
