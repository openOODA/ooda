// # Product btree_map prove
import "std/collections/btree_map.oo";
pub fn main() {
    let mut m: BTreeMap = btree_map_new();
    m = btree_map_insert(m, 7, 1);
    let n: Int = btree_map_len(m);
    if n != 1 {
        println("FAIL btreemap len");
        process_exit(1);
    }
    let c7: Bool = btree_map_contains(m, 7);
    if c7 == false {
        println("FAIL btreemap 7");
        process_exit(1);
    }
    let c3: Bool = btree_map_contains(m, 3);
    if c3 == true {
        println("FAIL btreemap 3");
        process_exit(1);
    }
    println("prod_btreemap: PASSED");
}
