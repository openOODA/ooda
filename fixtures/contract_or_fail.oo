// # Or requires fail
//
// Logline: Fail closed when both sides of a || requires are false.
//
// Beats:
//   1. Require a > 0 || b > 0.
//   2. Return a + b.
//   3. Call pick(0, 0).

// M162: || requires fail-closed when both sides false
pub fn pick(a: Int, b: Int) -> Int
    requires a > 0 || b > 0
{
    return a + b;
}

pub fn main() {
    println(pick(0, 0));
}
