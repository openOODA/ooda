// # Product prove std/web_ecosystem/zod_number_validator.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_number is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_number_validator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call zod_number twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_zod_number_validator: PASSED only if they match.

import "std/web_ecosystem/zod_number_validator.oo";

pub fn main() {
    let g0_oa = zod_number();
    let g0_ob = zod_number();
    let g0_a = (g0_oa).min_val;
    let g0_b = (g0_ob).min_val;
    if g0_a != g0_b {
        println("FAIL zod_number.min_val");
        process_exit(1);
    }
    println("prod_g0_zod_number_validator: PASSED");
}
