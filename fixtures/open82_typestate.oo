// # Product type_state_check
//
// Logline: type_state_check compares have to need at check time and at runtime.
//
// Setup: OPEN-82. Residual TYPE_STATE refuse is gone.
//
// Beats:
//   1. Const have == need is accepted at check.
//   2. Runtime fallback still compares the strings.
//   3. Print PASSED.

fn type_state_check(name: String, have: String, need: String) {
    if have != need {
        process_exit(1);
    }
}

pub fn main() {
    type_state_check("h", "Opened", "Opened");
    println("open82_typestate: PASSED");
}
