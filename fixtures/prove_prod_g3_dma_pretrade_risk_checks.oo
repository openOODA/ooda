// # Product prove std/fintech_l3_book/dma_pretrade_risk_checks.oo
//
// Logline: Fail-closed emit+gcc+run asserts dma_risk_limits_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_pretrade_risk_checks.oo.
//
// Beats:
//   1. Call dma_risk_limits_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_pretrade_risk_checks: PASSED only if they match.

import "std/fintech_l3_book/dma_pretrade_risk_checks.oo";

pub fn main() {
    let dma_pretrade_risk_checks_mark: Int = 0;
    if dma_pretrade_risk_checks_mark != 0 {
        process_exit(1);
    }
    let a: DmaRiskLimits = dma_risk_limits_default();
    let b: DmaRiskLimits = dma_risk_limits_default();
    if (a).max_order_shares != (b).max_order_shares {
        println("FAIL dma_risk_limits_default");
        process_exit(1);
    }
    println("prod_dma_pretrade_risk_checks: PASSED");
}
