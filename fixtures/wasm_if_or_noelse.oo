// # Const if false || true println no else
//
// Logline: Print or-ne when false || true and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If false || true print or-ne.
//   3. Leave no else and no other statements.

pub fn main() {
    if false || true {
        println("or-ne");
    }
}
