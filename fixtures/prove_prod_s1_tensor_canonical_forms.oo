// # Product prove std/quantum_tensor_nets/tensor_canonical_forms.oo
//
// Logline: Fail-closed emit+gcc+run asserts mixed_canonical_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tensor_canonical_forms.oo.
//
// Beats:
//   1. Call mixed_canonical_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensor_canonical_forms: PASSED only if they match.

import "std/quantum_tensor_nets/tensor_canonical_forms.oo";

pub fn main() {
    let tensor_canonical_forms_mark: Int = 0;
    if tensor_canonical_forms_mark != 0 {
        process_exit(1);
    }
    let tensor_canonical_forms_a = mixed_canonical_config_new(1, 1);
    let tensor_canonical_forms_b = mixed_canonical_config_new(1, 1);
    if (tensor_canonical_forms_a).num_sites != (tensor_canonical_forms_b).num_sites {
        println("FAIL mixed_canonical_config_new");
        process_exit(1);
    }
    println("prod_tensor_canonical_forms: PASSED");
}
