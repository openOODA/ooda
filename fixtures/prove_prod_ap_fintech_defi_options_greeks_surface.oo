// # Product prove std/fintech_defi/options_greeks_surface.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fintech_defi/options_greeks_surface.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/options_greeks_surface.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_options_greeks_surface: PASSED only if they match.

import "std/fintech_defi/options_greeks_surface.oo";

pub fn main() {
    let options_greeks_surface_a = greeks_norm_pdf(0.0);
    let options_greeks_surface_b = greeks_norm_pdf(0.0);
    if options_greeks_surface_a != options_greeks_surface_b {
        println("FAIL options_greeks_surface");
        process_exit(1);
    }
    println("prod_ap_options_greeks_surface: PASSED");
}
