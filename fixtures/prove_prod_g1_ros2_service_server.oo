// # Product prove std/robotics_ros2/ros2_service_server.oo
//
// Logline: Fail-closed emit+gcc+run asserts service_server_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_service_server.oo.
//
// Beats:
//   1. Call service_server_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros2_service_server: PASSED only if they match.

import "std/robotics_ros2/ros2_service_server.oo";

pub fn main() {
    let a: ServiceServer = service_server_new(0);
    let b: ServiceServer = service_server_new(0);
    if a.service_id != b.service_id {
        println("FAIL service_server_new");
        process_exit(1);
    }
    println("prod_ros2_service_server: PASSED");
}
