// # Product prove std/physics_advanced/boundary_layer_integral.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbulent_flat_plate_theta is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/boundary_layer_integral.oo.
//
// Beats:
//   1. Call turbulent_flat_plate_theta twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_boundary_layer_integral: PASSED only if they match.

import "std/physics_advanced/boundary_layer_integral.oo";

pub fn main() {
    let boundary_layer_integral_mark: Int = 0;
    if boundary_layer_integral_mark != 0 {
        process_exit(1);
    }
    let a: Float = turbulent_flat_plate_theta(0.0, 0.0);
    let b: Float = turbulent_flat_plate_theta(0.0, 0.0);
    if a != b {
        println("FAIL turbulent_flat_plate_theta");
        process_exit(1);
    }
    println("prod_boundary_layer_integral: PASSED");
}
