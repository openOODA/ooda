// # Product prove std/compilers_polyhedral/polyhedral_lexicographic_opt.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/polyhedral_lexicographic_opt.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_lexicographic_opt.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_polyhedral_lexicographic_opt: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_lexicographic_opt.oo";

pub fn main() {
    let polyhedral_lexicographic_opt_a = lexicographic_compare_vectors(0, 0, 0, 0, 0, 0, 0, 0);
    let polyhedral_lexicographic_opt_b = lexicographic_compare_vectors(0, 0, 0, 0, 0, 0, 0, 0);
    if polyhedral_lexicographic_opt_a != polyhedral_lexicographic_opt_b {
        println("FAIL polyhedral_lexicographic_opt");
        process_exit(1);
    }
    println("prod_ap_polyhedral_lexicographic_opt: PASSED");
}
