// # Product prove std/db_graph/property_graph_storage.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_storage.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_storage.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_property_graph_storage: PASSED only if they match.

import "std/db_graph/property_graph_storage.oo";

pub fn main() {
    let property_graph_storage_a = property_graph_store_new();
    let property_graph_storage_b = property_graph_store_new();
    if property_graph_storage_a.node_count != property_graph_storage_b.node_count {
        println("FAIL property_graph_storage");
        process_exit(1);
    }
    println("prod_ap_property_graph_storage: PASSED");
}
