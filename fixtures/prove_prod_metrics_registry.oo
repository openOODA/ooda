// # Product prove std/diag/metrics_registry.oo
//
// Logline: Fail-closed emit+gcc+run asserts registry_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/metrics_registry.oo.
//
// Beats:
//   1. Call registry_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metrics_registry: PASSED only if they match.

import "std/diag/metrics_registry.oo";

pub fn main() {
    let obj = registry_new();
    let a = registry_len(obj);
    let b = registry_len(obj);
    if a != b {
        println("FAIL registry_len");
        process_exit(1);
    }
    println("prod_metrics_registry: PASSED");
}
