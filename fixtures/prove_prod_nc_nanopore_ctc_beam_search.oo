import "std/genomics_advanced/nanopore_ctc_beam_search.oo";

pub fn main() {
    let a: Int = nanopore_ctc_beam_search_probe();
    if a != 0 {
        println("FAIL nanopore_ctc_beam_search_probe");
        process_exit(1);
    }
    println("prod_nc_nanopore_ctc_beam_search: PASSED");
}
