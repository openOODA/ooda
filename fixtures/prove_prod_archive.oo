// # Product prove std/archive/archive.oo
//
// Logline: Fail-closed emit+gcc+run asserts archive_detect_format is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/archive.oo.
//
// Beats:
//   1. Call archive_detect_format twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_archive: PASSED only if they match.

import "std/archive/archive.oo";

pub fn main() {
    let a = archive_detect_format("x");
    let b = archive_detect_format("x");
    if a != b {
        println("FAIL archive_detect_format");
        process_exit(1);
    }
    println("prod_archive: PASSED");
}
