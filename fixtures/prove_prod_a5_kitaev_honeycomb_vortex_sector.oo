// # Product prove std/quantum_topological/kitaev_honeycomb_vortex_sector.oo
//
// Logline: Fail-closed emit+gcc+run asserts kitaev_vortex_gap is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/kitaev_honeycomb_vortex_sector.oo.
//
// Beats:
//   1. Call kitaev_vortex_gap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kitaev_honeycomb_vortex_sector: PASSED only if they match.

import "std/quantum_topological/kitaev_honeycomb_vortex_sector.oo";

pub fn main() {
    let kitaev_honeycomb_vortex_sector_mark: Int = 0;
    if kitaev_honeycomb_vortex_sector_mark != 0 {
        process_exit(1);
    }
    let a: Float = kitaev_vortex_gap(0.0);
    let b: Float = kitaev_vortex_gap(0.0);
    if a != b {
        println("FAIL kitaev_vortex_gap");
        process_exit(1);
    }
    println("prod_kitaev_honeycomb_vortex_sector: PASSED");
}
