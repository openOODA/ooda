// # Product prove std/astrodynamics/lagrange_points.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/lagrange_points.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/lagrange_points.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lagrange_points: PASSED only if they match.

import "std/astrodynamics/lagrange_points.oo";

pub fn main() {
    let lagrange_points_a = lagrange_count();
    let lagrange_points_b = lagrange_count();
    if lagrange_points_a != lagrange_points_b {
        println("FAIL lagrange_points");
        process_exit(1);
    }
    println("prod_ap_lagrange_points: PASSED");
}
