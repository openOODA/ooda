// # Product prove std/tui/tui_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts tui_stubs_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/tui_stubs.oo.
//
// Beats:
//   1. Call tui_stubs_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tui_stubs: PASSED only if they match.

import "std/tui/tui_stubs.oo";

pub fn main() {
    let a = tui_stubs_probe();
    let b = tui_stubs_probe();
    if a != b {
        println("FAIL tui_stubs_probe");
        process_exit(1);
    }
    println("prod_tui_stubs: PASSED");
}
