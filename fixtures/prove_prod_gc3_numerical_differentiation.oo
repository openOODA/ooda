// # Product prove std/scicomp/numerical_differentiation.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_forward_1d is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/numerical_differentiation.oo.
//
// Beats:
//   1. Call diff_forward_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_numerical_differentiation: PASSED only if they match.

import "std/scicomp/numerical_differentiation.oo";

pub fn main() {
    let numerical_differentiation_mark: Int = 0;
    if numerical_differentiation_mark != 0 {
        process_exit(1);
    }
    let numerical_differentiation_a: Float = diff_forward_1d(1.0, 1.0, 1.0);
    let numerical_differentiation_b: Float = diff_forward_1d(1.0, 1.0, 1.0);
    if numerical_differentiation_a != numerical_differentiation_b {
        println("FAIL diff_forward_1d");
        process_exit(1);
    }
    println("prod_numerical_differentiation: PASSED");
}
