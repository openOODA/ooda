// # Product tensor prove
//
// Logline: Fail-closed emit+gcc+run of shipped tensor_len/new/get/set.
//
// Setup: Product std/math/tensor.oo. 2x3 row-major List[Int].
//
// Beats:
//   1. tensor_len(2,3) is 6; new get (0,0) is 0; set 7 then get 7.
//   2. Exit 1 before PASSED on a miss.

import "std/math/tensor.oo";

pub fn main() {
    let n: Int = tensor_len(2, 3);
    if n != 6 {
        println("FAIL tensor len");
        process_exit(1);
    }
    let mut t: List[Int] = tensor_new(2, 3);
    let z: Int = tensor_get(t, 0, 0, 3);
    if z != 0 {
        println("FAIL tensor get0");
        process_exit(1);
    }
    t = tensor_set(t, 0, 1, 3, 7);
    let v: Int = tensor_get(t, 0, 1, 3);
    if v != 7 {
        println("FAIL tensor set");
        process_exit(1);
    }
    println("prod_tensor: PASSED");
}
