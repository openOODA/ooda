// # MySQL wire codec adversarial suite
//
// Logline: Encodes then parses OK, ERR, and EOF frames and rejects truncated headers.
//
// Setup: Pure. Imports mysql_wire_codec.oo. Run from ooda/.
//
// Beats:
//   1. Wrap a payload with 3-byte length and sequence.
//   2. Encode OK 0x00, ERR 0xFF, and EOF 0xFE and parse kind plus sequence.
//   3. Reject a 3-byte truncated header.

import "std/database/mysql_wire_codec.oo";

fn must_kind(seq: Int, kind: Int, buf: List[Int], msg: String) {
    let p: ByteOut = mysql_wire_codec_parse(buf);
    if p.flag < 1 {
        println("FAIL " + msg + " " + p.err);
        process_exit(1);
    }
    if list_get(p.bytes, 0) != kind {
        println("FAIL kind " + msg);
        process_exit(1);
    }
    if list_get(p.bytes, 1) != seq {
        println("FAIL seq " + msg);
        process_exit(1);
    }
}

pub fn main() {
    let ok: ByteOut = mysql_wire_codec_ok(3);
    if ok.flag < 1 {
        println("FAIL ok enc");
        process_exit(1);
    }
    must_kind(3, 0, ok.bytes, "OK");
    let er: ByteOut = mysql_wire_codec_err(4, 1064);
    must_kind(4, 255, er.bytes, "ERR");
    let eo: ByteOut = mysql_wire_codec_eof(5);
    must_kind(5, 254, eo.bytes, "EOF");
    println("3-byte LE length + seq");
    println("OK 0x00 / ERR 0xFF / EOF 0xFE encode then parse");
    let mut tr: List[Int] = list_new();
    tr = list_push(tr, 1);
    tr = list_push(tr, 0);
    tr = list_push(tr, 0);
    let t: ByteOut = mysql_wire_codec_parse(tr);
    if t.flag > 0 {
        println("FAIL trunc ok");
        process_exit(1);
    }
    let st: Result[Int, String] = mysql_wire_codec_stat(t);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("truncated header Err");
    println("SUITE PASSED");
    println("test_mysql_wire_codec: PASSED");
}
