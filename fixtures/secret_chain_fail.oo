// # Refuse a multi-hop secret alias
//
// Logline: A third name inherits taint through two assigns from a tagged secret.
//
// Beats:
//   1. Tag x at line start.
//   2. Copy x to y and y to z.
//   3. Print z so the sink refuses.

// M59 multi-hop assign-prop: z inherits via y from SECRET x
// SECRET: x
pub fn main() {
    let x = "token";
    let y = x;
    let z = y;
    println(z);
}
