// # Product prove std/bioinformatics/rna_sequence.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_is_valid_nucleotide real value.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/rna_sequence.oo.
//
// Beats:
//   1. Call rna_is_valid_nucleotide with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_rna_sequence: PASSED only if the assert holds.

import "std/bioinformatics/rna_sequence.oo";

pub fn main() {
    let rna_sequence_n: Int = rna_is_valid_nucleotide(-1);
    if rna_sequence_n != 0 {
        println("FAIL rna_is_valid_nucleotide");
        process_exit(1);
    }
    println("prod_rna_sequence: PASSED");
}
