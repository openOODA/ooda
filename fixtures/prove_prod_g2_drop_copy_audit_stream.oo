// # Product prove std/fintech_l3_book/drop_copy_audit_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts drop_copy_session_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/drop_copy_audit_stream.oo.
//
// Beats:
//   1. Call drop_copy_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_drop_copy_audit_stream: PASSED only if they match.

import "std/fintech_l3_book/drop_copy_audit_stream.oo";

pub fn main() {
    let drop_copy_audit_stream_mark: Int = 0;
    if drop_copy_audit_stream_mark != 0 {
        process_exit(1);
    }
    let a: DropCopySession = drop_copy_session_new("x", "x");
    let b: DropCopySession = drop_copy_session_new("x", "x");
    if (a).last_sent_seq != (b).last_sent_seq {
        println("FAIL drop_copy_session_new");
        process_exit(1);
    }
    println("prod_g2_drop_copy_audit_stream: PASSED");
}
