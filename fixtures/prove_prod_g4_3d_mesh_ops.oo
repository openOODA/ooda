// # Product prove std/3d/mesh_ops.oo
//
// Logline: Fail-closed verification that 3D mesh and vector operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/mesh_ops.oo.
//
// Beats:
//   1. Perform Vector3 arithmetic, dot product, and cross product.
//   2. Construct Triangle and calculate centroid and normal vector.
//   3. Register triangles into Mesh and assert centroid calculations.
//   4. Print prod_g4_3d_mesh_ops: PASSED only if all match.

import "std/3d/mesh_ops.oo";

pub fn main() {
    let v1: Vector3 = vector3_new(1, 2, 3);
    let v2: Vector3 = vector3_new(4, 5, 6);

    let v_add: Vector3 = vector3_add(v1, v2);
    if (v_add).x != 5 || (v_add).y != 7 || (v_add).z != 9 {
        println("FAIL vector3_add");
        process_exit(1);
    }

    let dot: Int = vector3_dot(v1, v2);
    if dot != 32 {
        println("FAIL vector3_dot");
        process_exit(1);
    }

    let cross: Vector3 = vector3_cross(v1, v2);
    if (cross).x != 0 - 3 || (cross).y != 6 || (cross).z != 0 - 3 {
        println("FAIL vector3_cross");
        process_exit(1);
    }

    let len_sq: Int = vector3_length_squared(v1);
    if len_sq != 14 {
        println("FAIL vector3_length_squared");
        process_exit(1);
    }

    let p1: Vector3 = vector3_new(0, 0, 0);
    let p2: Vector3 = vector3_new(3, 0, 0);
    let p3: Vector3 = vector3_new(0, 3, 0);
    let tri: Triangle = triangle_new(p1, p2, p3);

    let cent: Vector3 = triangle_centroid(tri);
    if (cent).x != 1 || (cent).y != 1 || (cent).z != 0 {
        println("FAIL triangle_centroid");
        process_exit(1);
    }

    let mesh0: Mesh = mesh_new(42);
    let mesh1: Mesh = mesh_add_triangle(mesh0, tri);
    let tri_cnt: Int = mesh_get_triangle_count(mesh1);
    if tri_cnt != 1 {
        println("FAIL mesh_get_triangle_count");
        process_exit(1);
    }

    let m_cent: Vector3 = mesh_get_centroid(mesh1);
    if (m_cent).x != 1 || (m_cent).y != 1 || (m_cent).z != 0 {
        println("FAIL mesh_get_centroid");
        process_exit(1);
    }

    let mesh_trans: Mesh = mesh_translate(mesh1, 10, 20, 30);
    let mt_cent: Vector3 = mesh_get_centroid(mesh_trans);
    if (mt_cent).x != 11 || (mt_cent).y != 21 || (mt_cent).z != 30 {
        println("FAIL mesh_translate centroid");
        process_exit(1);
    }

    println("prod_g4_3d_mesh_ops: PASSED");
    process_exit(0);
}
