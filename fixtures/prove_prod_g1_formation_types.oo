// # Product prove std/aero/formation_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts form_vec3_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_types.oo.
//
// Beats:
//   1. Call form_vec3_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_formation_types: PASSED only if they match.

import "std/aero/formation_types.oo";

pub fn main() {
    let obj_a: FormVec3 = form_vec3_new(0, 0, 0);
    let obj_b: FormVec3 = form_vec3_new(0, 0, 0);
    let a: Int = form_vec3_x(obj_a);
    let b: Int = form_vec3_x(obj_b);
    if a != b {
        println("FAIL form_vec3_x");
        process_exit(1);
    }
    println("prod_formation_types: PASSED");
}
