// # Product prove std/db_columnar/columnar_vectorized_hash_agg.oo
//
// Logline: Fail-closed emit+gcc+run asserts hash_agg_table_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_hash_agg.oo.
//
// Beats:
//   1. Call hash_agg_table_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_vectorized_hash_agg: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_hash_agg.oo";

pub fn main() {
    let columnar_vectorized_hash_agg_mark: Int = 0;
    if columnar_vectorized_hash_agg_mark != 0 {
        process_exit(1);
    }
    let a: HashAggTable = hash_agg_table_new();
    let b: HashAggTable = hash_agg_table_new();
    if (a).num_groups != (b).num_groups {
        println("FAIL hash_agg_table_new");
        process_exit(1);
    }
    println("prod_columnar_vectorized_hash_agg: PASSED");
}
