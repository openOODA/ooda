// # Product prove std/compilers/macho_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts macho_magic_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/macho_header.oo.
//
// Beats:
//   1. Call macho_magic_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_macho_header: PASSED only if they match.

import "std/compilers/macho_header.oo";

pub fn main() {
    let macho_header_mark: Int = 0;
    if macho_header_mark != 0 {
        process_exit(1);
    }
    let a: Int = macho_magic_64();
    let b: Int = macho_magic_64();
    if a != b {
        println("FAIL macho_magic_64");
        process_exit(1);
    }
    println("prod_macho_header: PASSED");
}
