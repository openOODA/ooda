// # Product ROT13 prove
//
// Logline: Fail-closed emit+gcc+run of shipped rot13_transform.
//
// Setup: Product std/text/caesar_rot13.oo. ROT13 is an involution.
//
// Beats:
//   1. rot13_transform hello is uryyb.
//   2. rot13 of that is hello.
//   3. Exit 1 before PASSED on a miss.

import "std/text/caesar_rot13.oo";

pub fn main() {
    let enc: String = rot13_transform("hello");
    if enc != "uryyb" {
        println("FAIL rot13 hello");
        process_exit(1);
    }
    let back: String = rot13_transform(enc);
    if back != "hello" {
        println("FAIL rot13 involution");
        process_exit(1);
    }
    println("prod_rot13: PASSED");
}
