// # Product prove std/embedded_hal/dac_waveform_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts dac_channel_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/dac_waveform_generator.oo.
//
// Beats:
//   1. Call dac_channel_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dac_waveform_generator: PASSED only if they match.

import "std/embedded_hal/dac_waveform_generator.oo";

pub fn main() {
    let dac_waveform_generator_mark: Int = 0;
    if dac_waveform_generator_mark != 0 {
        process_exit(1);
    }
    let a: DacChannel = dac_channel_new(0, 0);
    let b: DacChannel = dac_channel_new(0, 0);
    if (a).channel_id != (b).channel_id {
        println("FAIL dac_channel_new");
        process_exit(1);
    }
    println("prod_dac_waveform_generator: PASSED");
}
