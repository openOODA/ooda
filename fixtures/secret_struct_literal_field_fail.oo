// # Refuse secret assigned in struct literal
//
// Logline: A struct literal initialized with a SECRET field taints the field read at println.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag secret_val as secret.
//   2. Initialize struct literal Box with v: secret_val.
//   3. Print the struct field b.v so the sink refuses.
//
// secret assigned in struct literal taints field read at println
type Box = struct { v: String };
// SECRET: secret_val
pub fn main() {
    let secret_val = "sensitive_data";
    let b = Box { v: secret_val };
    println(b.v);
}
