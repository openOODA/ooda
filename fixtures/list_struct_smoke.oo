// # List[struct] emit lock
//
// Logline: Fail-closed emit+gcc+run of List[Node] new, push, len, and get.
//
// Setup: Backend-C. Node has Int id and String tag.
//
// Beats:
//   1. Empty list has length 0.
//   2. Push one node; length is 1; id and tag match.
//   3. Exit 1 before PASSED on a miss.

type Node = struct {
    id: Int,
    tag: String
};

pub fn main() {
    let mut xs: List[Node] = list_new();
    if list_len(xs) != 0 {
        println("FAIL empty len");
        process_exit(1);
    }
    let n0: Node = Node { id: 7, tag: "ok" };
    xs = list_push(xs, n0);
    if list_len(xs) != 1 {
        println("FAIL push len");
        process_exit(1);
    }
    let g: Node = list_get(xs, 0);
    if g.id != 7 {
        println("FAIL get id");
        process_exit(1);
    }
    if g.tag != "ok" {
        println("FAIL get tag");
        process_exit(1);
    }
    println("list_struct_smoke: PASSED");
}
