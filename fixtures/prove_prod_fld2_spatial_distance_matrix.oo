// # Product prove std/tda_topology/spatial_distance_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts distance_matrix_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/spatial_distance_matrix.oo.
//
// Beats:
//   1. Call distance_matrix_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_distance_matrix: PASSED only if they match.

import "std/tda_topology/spatial_distance_matrix.oo";

pub fn main() {
    let spatial_distance_matrix_mark: Int = 0;
    if spatial_distance_matrix_mark != 0 {
        process_exit(1);
    }
    let spatial_distance_matrix_a: Int = distance_matrix_index(1, 1, 1);
    let spatial_distance_matrix_b: Int = distance_matrix_index(1, 1, 1);
    if spatial_distance_matrix_a != spatial_distance_matrix_b {
        println("FAIL distance_matrix_index");
        process_exit(1);
    }
    println("prod_spatial_distance_matrix: PASSED");
}
