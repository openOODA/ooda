// # Product prove std/nerf_3dgs/camera_distortion_undistort.oo
//
// Logline: Fail-closed emit+gcc+run asserts distortion_coefficients_none is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/camera_distortion_undistort.oo.
//
// Beats:
//   1. Call distortion_coefficients_none twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_camera_distortion_undistort: PASSED only if they match.

import "std/nerf_3dgs/camera_distortion_undistort.oo";

pub fn main() {
    let camera_distortion_undistort_mark: Int = 0;
    if camera_distortion_undistort_mark != 0 {
        process_exit(1);
    }
    let camera_distortion_undistort_a: DistortionCoefficients = distortion_coefficients_none();
    let camera_distortion_undistort_b: DistortionCoefficients = distortion_coefficients_none();
    if (camera_distortion_undistort_a).k1 != (camera_distortion_undistort_b).k1 {
        println("FAIL distortion_coefficients_none");
        process_exit(1);
    }
    println("prod_camera_distortion_undistort: PASSED");
}
