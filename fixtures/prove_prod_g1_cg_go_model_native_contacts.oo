// # Product prove std/protein_folding/cg_go_model_native_contacts.oo
//
// Logline: Fail-closed emit+gcc+run asserts go_calc_native_12_10 is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/cg_go_model_native_contacts.oo.
//
// Beats:
//   1. Call go_calc_native_12_10 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cg_go_model_native_contacts: PASSED only if they match.

import "std/protein_folding/cg_go_model_native_contacts.oo";

pub fn main() {
    let a: Float = go_calc_native_12_10(0.0, 0.0, 0.0);
    let b: Float = go_calc_native_12_10(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL go_calc_native_12_10");
        process_exit(1);
    }
    println("prod_cg_go_model_native_contacts: PASSED");
}
