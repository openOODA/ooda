// # Product prove std/physics_advanced/acoustic_pml_absorbing_boundary.oo
//
// Logline: Fail-closed emit+gcc+run asserts pml_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/acoustic_pml_absorbing_boundary.oo.
//
// Beats:
//   1. Call pml_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_acoustic_pml_absorbing_boundary: PASSED only if they match.

import "std/physics_advanced/acoustic_pml_absorbing_boundary.oo";

pub fn main() {
    let acoustic_pml_absorbing_boundary_mark: Int = 0;
    if acoustic_pml_absorbing_boundary_mark != 0 {
        process_exit(1);
    }
    let a: PmlConfig = pml_config_default(0.0, 0.0);
    let b: PmlConfig = pml_config_default(0.0, 0.0);
    if (a).pml_thickness != (b).pml_thickness {
        println("FAIL pml_config_default");
        process_exit(1);
    }
    println("prod_acoustic_pml_absorbing_boundary: PASSED");
}
