// # Product prove std/scicomp/convex_hull_graham.oo
//
// Logline: Fail-closed emit+gcc+run asserts convex_hull_graham_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/convex_hull_graham.oo.
//
// Beats:
//   1. Call convex_hull_graham_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_convex_hull_graham: PASSED only if it matches.

import "std/scicomp/convex_hull_graham.oo";

pub fn main() {
    let a: Int = convex_hull_graham_probe();
    if a != 0 {
        println("FAIL convex_hull_graham_probe");
        process_exit(1);
    }
    println("prod_nc_convex_hull_graham: PASSED");
}
