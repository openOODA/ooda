// # Product prove std/telecom_6g/zero_energy_ambient_backscatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts zero_energy_tag_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/zero_energy_ambient_backscatter.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call zero_energy_tag_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zero_energy_ambient_backscatter: PASSED only if they match.

import "std/telecom_6g/zero_energy_ambient_backscatter.oo";

pub fn main() {
    let g2_oa: AmbientBackscatterTagConfig = zero_energy_tag_config_default();
    let g2_ob: AmbientBackscatterTagConfig = zero_energy_tag_config_default();
    let g2_a = (g2_oa).antenna_aperture_cm2;
    let g2_b = (g2_ob).antenna_aperture_cm2;
    if g2_a != g2_b {
        println("FAIL zero_energy_tag_config_default.antenna_aperture_cm2");
        process_exit(1);
    }
    println("prod_g2_zero_energy_ambient_backscatter: PASSED");
}
