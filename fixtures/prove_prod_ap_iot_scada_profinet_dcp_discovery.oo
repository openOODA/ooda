// # Product prove std/iot_scada/profinet_dcp_discovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/profinet_dcp_discovery.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/iot_scada/profinet_dcp_discovery.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_profinet_dcp_discovery: PASSED only if they match.

import "std/iot_scada/profinet_dcp_discovery.oo";

pub fn main() {
    let profinet_dcp_discovery_a = profinet_dcp_identify_request(0);
    let profinet_dcp_discovery_b = profinet_dcp_identify_request(0);
    if profinet_dcp_discovery_a.service_id != profinet_dcp_discovery_b.service_id {
        println("FAIL profinet_dcp_discovery");
        process_exit(1);
    }
    println("prod_ap_profinet_dcp_discovery: PASSED");
}
