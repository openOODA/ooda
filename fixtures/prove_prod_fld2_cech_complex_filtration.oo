// # Product prove std/tda_topology/cech_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts cech_radius_1d is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/cech_complex_filtration.oo.
//
// Beats:
//   1. Call cech_radius_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cech_complex_filtration: PASSED only if they match.

import "std/tda_topology/cech_complex_filtration.oo";

pub fn main() {
    let cech_complex_filtration_mark: Int = 0;
    if cech_complex_filtration_mark != 0 {
        process_exit(1);
    }
    let cech_complex_filtration_a: Float = cech_radius_1d(1.0);
    let cech_complex_filtration_b: Float = cech_radius_1d(1.0);
    if cech_complex_filtration_a != cech_complex_filtration_b {
        println("FAIL cech_radius_1d");
        process_exit(1);
    }
    println("prod_cech_complex_filtration: PASSED");
}
