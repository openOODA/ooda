// # Product prove std/astrophysics_relativity/gr_wormhole_morris_thorne.oo
//
// Logline: Fail-closed emit+gcc+run asserts wormhole_shape_exponential is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_wormhole_morris_thorne.oo.
//
// Beats:
//   1. Call wormhole_shape_exponential twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_wormhole_morris_thorne: PASSED only if they match.

import "std/astrophysics_relativity/gr_wormhole_morris_thorne.oo";

pub fn main() {
    let gr_wormhole_morris_thorne_mark: Int = 0;
    if gr_wormhole_morris_thorne_mark != 0 {
        process_exit(1);
    }
    let a: Float = wormhole_shape_exponential(2.0, 1.0);
    let b: Float = wormhole_shape_exponential(2.0, 1.0);
    if a != b {
        println("FAIL wormhole_shape_exponential");
        process_exit(1);
    }
    println("prod_gr_wormhole_morris_thorne: PASSED");
}
