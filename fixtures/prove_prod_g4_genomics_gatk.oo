// # Product prove std/genomics_advanced/gatk_haplotype_caller.oo
//
// Logline: Fail-closed verification that GATK HaplotypeCaller active region detection and Pair-HMM likelihood scoring are deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/gatk_haplotype_caller.oo.
//
// Beats:
//   1. Evaluate active region scoring against threshold predicates.
//   2. Compute Pair-HMM alignment scores across matched and mismatched bases.
//   3. Assert deterministic boolean decisions and score evaluations.
//   4. Print prod_g4_genomics_gatk: PASSED only if all match.

import "std/genomics_advanced/gatk_haplotype_caller.oo";

pub fn main() {
    let act_a: Bool = gatk_is_region_active(5.5, 2.0);
    let act_b: Bool = gatk_is_region_active(5.5, 2.0);
    if !act_a || !act_b {
        println("FAIL gatk_is_region_active high");
        process_exit(1);
    }

    let inact: Bool = gatk_is_region_active(1.5, 2.0);
    if inact {
        println("FAIL gatk_is_region_active low");
        process_exit(1);
    }

    let score_a: Float = gatk_calc_pair_hmm_score(10, 2, 1.0, 3.0);
    let score_b: Float = gatk_calc_pair_hmm_score(10, 2, 1.0, 3.0);
    if score_a != score_b || score_a != 4.0 {
        println("FAIL gatk_calc_pair_hmm_score");
        process_exit(1);
    }

    let score_zero: Float = gatk_calc_pair_hmm_score(6, 2, 1.0, 3.0);
    if score_zero != 0.0 {
        println("FAIL gatk_calc_pair_hmm_score zero");
        process_exit(1);
    }

    println("prod_g4_genomics_gatk: PASSED");
    process_exit(0);
}
