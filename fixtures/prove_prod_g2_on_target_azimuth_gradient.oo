// # Product prove std/crispr_cas/on_target_azimuth_gradient.oo
//
// Logline: Fail-closed emit+gcc+run asserts on_target_azimuth_gradient_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/on_target_azimuth_gradient.oo.
//
// Beats:
//   1. Call on_target_azimuth_gradient_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_on_target_azimuth_gradient: PASSED only if they match.

import "std/crispr_cas/on_target_azimuth_gradient.oo";

pub fn main() {
    let a: Int = on_target_azimuth_gradient_probe();
    let b: Int = on_target_azimuth_gradient_probe();
    if a != b {
        println("FAIL on_target_azimuth_gradient_probe");
        process_exit(1);
    }
    println("prod_g2_on_target_azimuth_gradient: PASSED");
}
