// # Product prove std/zk_rollup/ecdsa_signature_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts ecdsa_signature_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/ecdsa_signature_recovery.oo.
//
// Beats:
//   1. Call ecdsa_signature_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ecdsa_signature_recovery: PASSED only if they match.

import "std/zk_rollup/ecdsa_signature_recovery.oo";

pub fn main() {
    let ecdsa_signature_recovery_mark: Int = 0;
    if ecdsa_signature_recovery_mark != 0 {
        process_exit(1);
    }
    let a: EcdsaSignature = ecdsa_signature_new("x", "x", 0);
    let b: EcdsaSignature = ecdsa_signature_new("x", "x", 0);
    if (a).recovery_id != (b).recovery_id {
        println("FAIL ecdsa_signature_new");
        process_exit(1);
    }
    println("prod_ecdsa_signature_recovery: PASSED");
}
