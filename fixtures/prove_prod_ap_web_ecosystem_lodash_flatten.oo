// # Product prove std/web_ecosystem/lodash_flatten.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/lodash_flatten.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_flatten.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lodash_flatten: PASSED only if they match.

import "std/web_ecosystem/lodash_flatten.oo";

pub fn main() {
    let lodash_flatten_a = lodash_flatten_n(0, 0);
    let lodash_flatten_b = lodash_flatten_n(0, 0);
    if lodash_flatten_a != lodash_flatten_b {
        println("FAIL lodash_flatten");
        process_exit(1);
    }
    println("prod_ap_lodash_flatten: PASSED");
}
