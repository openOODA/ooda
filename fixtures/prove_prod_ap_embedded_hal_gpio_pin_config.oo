// # Product prove std/embedded_hal/gpio_pin_config.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/gpio_pin_config.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/gpio_pin_config.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gpio_pin_config: PASSED only if they match.

import "std/embedded_hal/gpio_pin_config.oo";

pub fn main() {
    let gpio_pin_config_a = gpio_pin_new(0, 0);
    let gpio_pin_config_b = gpio_pin_new(0, 0);
    let gpio_pin_config_va = gpio_read_input(gpio_pin_config_a);
    let gpio_pin_config_vb = gpio_read_input(gpio_pin_config_b);
    if gpio_pin_config_va != gpio_pin_config_vb {
        println("FAIL gpio_pin_config");
        process_exit(1);
    }
    println("prod_ap_gpio_pin_config: PASSED");
}
