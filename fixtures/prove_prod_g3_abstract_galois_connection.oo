// # Product prove std/formal_verif/abstract_galois_connection.oo
//
// Logline: Fail-closed emit+gcc+run asserts galois_connection_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_galois_connection.oo.
//
// Beats:
//   1. Call galois_connection_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_abstract_galois_connection: PASSED only if they match.

import "std/formal_verif/abstract_galois_connection.oo";

pub fn main() {
    let abstract_galois_connection_mark: Int = 0;
    if abstract_galois_connection_mark != 0 {
        process_exit(1);
    }
    let a: GaloisConnection = galois_connection_new("x", true);
    let b: GaloisConnection = galois_connection_new("x", true);
    if (a).soundness_violations != (b).soundness_violations {
        println("FAIL galois_connection_new");
        process_exit(1);
    }
    println("prod_abstract_galois_connection: PASSED");
}
