// # Product prove std/fs/file_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_writer_bytes_written is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/file_writer.oo.
//
// Beats:
//   1. Call file_writer_bytes_written twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_writer: PASSED only if they match.

import "std/fs/file_writer.oo";

pub fn main() {
    let obj = file_writer_open("x", true);
    let a = file_writer_bytes_written(obj);
    let b = file_writer_bytes_written(obj);
    if a != b {
        println("FAIL file_writer_bytes_written");
        process_exit(1);
    }
    println("prod_file_writer: PASSED");
}
