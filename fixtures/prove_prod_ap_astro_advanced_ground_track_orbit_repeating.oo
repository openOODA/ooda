// # Product prove std/astro_advanced/ground_track_orbit_repeating.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/ground_track_orbit_repeating.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/ground_track_orbit_repeating.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ground_track_orbit_repeating: PASSED only if they match.

import "std/astro_advanced/ground_track_orbit_repeating.oo";

pub fn main() {
    let ground_track_orbit_repeating_a = repeat_revs();
    let ground_track_orbit_repeating_b = repeat_revs();
    if ground_track_orbit_repeating_a != ground_track_orbit_repeating_b {
        println("FAIL ground_track_orbit_repeating");
        process_exit(1);
    }
    println("prod_ap_ground_track_orbit_repeating: PASSED");
}
