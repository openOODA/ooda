// # Product prove std/gis_topo/dem_topographic_wetness.oo
//
// Logline: Fail-closed emit+gcc+run asserts twi_calc is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_topographic_wetness.oo.
//
// Beats:
//   1. Call twi_calc twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dem_topographic_wetness: PASSED only if they match.

import "std/gis_topo/dem_topographic_wetness.oo";

pub fn main() {
    let a: Float = twi_calc(0.0, 0.0);
    let b: Float = twi_calc(0.0, 0.0);
    if a != b {
        println("FAIL twi_calc");
        process_exit(1);
    }
    println("prod_dem_topographic_wetness: PASSED");
}
