// # Leftover collection for honesty lock
//
// Logline: LLVM fail-closes for x in 1 rather than inventing an iterator.
//
// Setup: Backend-LLVM. Only INT..INT range-for and List[Int] collection for are product.
//
// Beats:
//   1. for IDENT in INT without ...
//   2. Emit must not lower a scalar as a list.
//   3. Fail closed with ERR llvm_emit.

pub fn main() {
    for x in 1 {
        println(x.to_string());
    }
}
