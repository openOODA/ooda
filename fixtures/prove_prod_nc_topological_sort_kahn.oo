// # Product prove std/graph_topology/topological_sort_kahn.oo
//
// Logline: Fail-closed emit+gcc+run asserts topological_sort_kahn_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_topology/topological_sort_kahn.oo.
//
// Beats:
//   1. Call topological_sort_kahn_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_topological_sort_kahn: PASSED only if it matches.

import "std/graph_topology/topological_sort_kahn.oo";

pub fn main() {
    let a: Int = topological_sort_kahn_probe();
    if a != 0 {
        println("FAIL topological_sort_kahn_probe");
        process_exit(1);
    }
    println("prod_nc_topological_sort_kahn: PASSED");
}
