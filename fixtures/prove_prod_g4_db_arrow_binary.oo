// # Product prove std/db_columnar/arrow_variable_binary_array.oo
//
// Logline: Fail-closed verification that Apache Arrow variable-size binary and UTF-8 offset arrays are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_variable_binary_array.oo.
//
// Beats:
//   1. Initialize ArrowBinaryArray instance.
//   2. Append variable length string entries and update offset totals.
//   3. Compute slice info records and assert deterministic byte boundaries.
//   4. Print prod_g4_db_arrow_binary: PASSED and exit 0.

import "std/db_columnar/arrow_variable_binary_array.oo";

pub fn main() {
    let arr0: ArrowBinaryArray = arrow_binary_array_new();
    if arr0.length != 0 || arr0.total_bytes != 0 || arr0.null_count != 0 {
        println("FAIL arrow_binary_array_new");
        process_exit(1);
    }

    let arr1: ArrowBinaryArray = arrow_binary_array_append(arr0, 5, true);  // "hello"
    let arr2: ArrowBinaryArray = arrow_binary_array_append(arr1, 6, true);  // "world!"
    let arr3: ArrowBinaryArray = arrow_binary_array_append(arr2, 0, false); // null

    if arr3.length != 3 || arr3.total_bytes != 11 || arr3.null_count != 1 {
        println("FAIL arrow_binary_array_append dimensions");
        process_exit(1);
    }

    let slice0: StringSlice = arrow_binary_slice_info(0, 5, true);
    if slice0.offset != 0 || slice0.length != 5 || slice0.is_valid != true {
        println("FAIL slice0 info");
        process_exit(1);
    }

    let slice1: StringSlice = arrow_binary_slice_info(5, 6, true);
    if slice1.offset != 5 || slice1.length != 6 || slice1.is_valid != true {
        println("FAIL slice1 info");
        process_exit(1);
    }

    let slice2: StringSlice = arrow_binary_slice_info(11, 0, false);
    if slice2.offset != 11 || slice2.length != 0 || slice2.is_valid != false {
        println("FAIL slice2 info");
        process_exit(1);
    }

    println("prod_g4_db_arrow_binary: PASSED");
    process_exit(0);
}
