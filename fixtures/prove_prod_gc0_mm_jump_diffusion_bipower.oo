// # Product prove std/hft_alpha/mm_jump_diffusion_bipower.oo
//
// Logline: Fail-closed emit+gcc+run asserts jump_test_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_jump_diffusion_bipower.oo.
//
// Beats:
//   1. Call jump_test_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_jump_diffusion_bipower: PASSED only if they match.

import "std/hft_alpha/mm_jump_diffusion_bipower.oo";

pub fn main() {
    let mm_jump_diffusion_bipower_mark: Int = 0;
    if mm_jump_diffusion_bipower_mark != 0 {
        process_exit(1);
    }
    let mm_jump_diffusion_bipower_a = jump_test_config_default();
    let mm_jump_diffusion_bipower_b = jump_test_config_default();
    if (mm_jump_diffusion_bipower_a).significance_alpha_z != (mm_jump_diffusion_bipower_b).significance_alpha_z {
        println("FAIL jump_test_config_default");
        process_exit(1);
    }
    println("prod_mm_jump_diffusion_bipower: PASSED");
}
