// # Product prove std/zk_rollup/snark_verifier_circuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/snark_verifier_circuit.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/snark_verifier_circuit.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_snark_verifier_circuit: PASSED only if they match.

import "std/zk_rollup/snark_verifier_circuit.oo";

pub fn main() {
    let snark_verifier_circuit_a = circuit_gate_counter_new();
    let snark_verifier_circuit_b = circuit_gate_counter_new();
    if snark_verifier_circuit_a.num_variables != snark_verifier_circuit_b.num_variables {
        println("FAIL snark_verifier_circuit");
        process_exit(1);
    }
    println("prod_ap_snark_verifier_circuit: PASSED");
}
