// # Product prove std/formal_verif/sp_strongest_postcondition.oo
//
// Logline: Fail-closed emit+gcc+run asserts sp_forward_assign is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/sp_strongest_postcondition.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sp_forward_assign twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sp_strongest_postcondition: PASSED only if they match.

import "std/formal_verif/sp_strongest_postcondition.oo";

pub fn main() {
    let g2_oa: SymbolicState = symbolic_state_init();
    let g2_ob: SymbolicState = symbolic_state_init();
    let g2_a = sp_forward_assign(&g2_oa, "x", "x", 2);
    let g2_b = sp_forward_assign(&g2_ob, "x", "x", 2);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL sp_forward_assign");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL sp_forward_assign");
        process_exit(1);
    }
    println("prod_g2_sp_strongest_postcondition: PASSED");
}
