// # Product prove std/defi_derivatives/stress_testing_scenarios.oo
//
// Logline: Fail-closed emit+gcc+run asserts stress_scenario_black_swan is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/stress_testing_scenarios.oo.
//
// Beats:
//   1. Call stress_scenario_black_swan twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stress_testing_scenarios: PASSED only if they match.

import "std/defi_derivatives/stress_testing_scenarios.oo";

pub fn main() {
    let stress_testing_scenarios_mark: Int = 0;
    if stress_testing_scenarios_mark != 0 {
        process_exit(1);
    }
    let a: StressScenario = stress_scenario_black_swan();
    let b: StressScenario = stress_scenario_black_swan();
    if (a).spot_shock_pct != (b).spot_shock_pct {
        println("FAIL stress_scenario_black_swan");
        process_exit(1);
    }
    println("prod_g2_stress_testing_scenarios: PASSED");
}
