// # Product prove std/embedded_hal/spi_master_transaction.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/spi_master_transaction.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/spi_master_transaction.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_spi_master_transaction: PASSED only if they match.

import "std/embedded_hal/spi_master_transaction.oo";

pub fn main() {
    let spi_master_transaction_a = spi_config_new(0, 0, 0, 0, 0);
    let spi_master_transaction_b = spi_config_new(0, 0, 0, 0, 0);
    if spi_master_transaction_a.bus_id != spi_master_transaction_b.bus_id {
        println("FAIL spi_master_transaction");
        process_exit(1);
    }
    println("prod_ap_spi_master_transaction: PASSED");
}
