// # Tamper a pinned ingest lock cap
//
// Logline: Rewrite the ingar lock line to name#sha#Net so launch can refuse extra caps.
//
// Setup: cwd is ooda/. .ooda_modules/lock holds an ingar@ pin. ProcessCap runs one shell line.
//
// Beats:
//   1. Read the lock line that starts with ingar@.
//   2. Keep the name and sha fields.
//   3. Write the line back as name#sha#Net.

pub fn main(p: &ProcessCap) {
    let cmd: String = "awk 'BEGIN{FS=\"#\"} /^ingar@/{print $1 \"#\" $2 \"#Net\"; next} {print}' "
        + ".ooda_modules/lock > .ooda_modules/lock.tamper "
        + "&& mv .ooda_modules/lock.tamper .ooda_modules/lock";
    if process_exec(p, cmd).is_err() {
        println("FAIL caps tamper");
        process_exit(1);
    }
}
