// # Product prove std/db_storage/lsm_compaction_size_tiered.oo
//
// Logline: Fail-closed emit+gcc+run asserts size_tier_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_compaction_size_tiered.oo.
//
// Beats:
//   1. Call size_tier_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_compaction_size_tiered: PASSED only if they match.

import "std/db_storage/lsm_compaction_size_tiered.oo";

pub fn main() {
    let lsm_compaction_size_tiered_mark: Int = 0;
    if lsm_compaction_size_tiered_mark != 0 {
        process_exit(1);
    }
    let a: SizeTierConfig = size_tier_config_default();
    let b: SizeTierConfig = size_tier_config_default();
    if (a).min_threshold != (b).min_threshold {
        println("FAIL size_tier_config_default");
        process_exit(1);
    }
    println("prod_lsm_compaction_size_tiered: PASSED");
}
