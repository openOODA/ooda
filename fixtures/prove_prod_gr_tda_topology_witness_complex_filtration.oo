// # Product prove std/tda_topology/witness_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts landmark_set_add is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/witness_complex_filtration.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call landmark_set_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_witness_complex_filtration: PASSED only if they match.

import "std/tda_topology/witness_complex_filtration.oo";

pub fn main() {
    let mut g0_oa: LandmarkSet = LandmarkSet { landmark_indices: list_new(), landmark_count: 0, total_data_points: 0 };
    let mut g0_ob: LandmarkSet = LandmarkSet { landmark_indices: list_new(), landmark_count: 0, total_data_points: 0 };
    let g0_a = landmark_set_add(&g0_oa, 0);
    let g0_b = landmark_set_add(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL landmark_set_add");
        process_exit(1);
    }
    println("prod_gr_witness_complex_filtration: PASSED");
}
