// # Product prove std/protein_folding/folding_pathway_transition_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts tpt_calc_backward_committor is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_pathway_transition_state.oo.
//
// Beats:
//   1. Call tpt_calc_backward_committor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_folding_pathway_transition_state: PASSED only if they match.

import "std/protein_folding/folding_pathway_transition_state.oo";

pub fn main() {
    let folding_pathway_transition_state_mark: Int = 0;
    if folding_pathway_transition_state_mark != 0 {
        process_exit(1);
    }
    let a: Float = tpt_calc_backward_committor(0.0);
    let b: Float = tpt_calc_backward_committor(0.0);
    if a != b {
        println("FAIL tpt_calc_backward_committor");
        process_exit(1);
    }
    println("prod_g2_folding_pathway_transition_state: PASSED");
}
