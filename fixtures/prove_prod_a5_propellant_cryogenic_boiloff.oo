// # Product prove std/space_propulsion/propellant_cryogenic_boiloff.oo
//
// Logline: Fail-closed emit+gcc+run asserts cryo_storage_spec_default_lh2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_cryogenic_boiloff.oo.
//
// Beats:
//   1. Call cryo_storage_spec_default_lh2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_cryogenic_boiloff: PASSED only if they match.

import "std/space_propulsion/propellant_cryogenic_boiloff.oo";

pub fn main() {
    let propellant_cryogenic_boiloff_mark: Int = 0;
    if propellant_cryogenic_boiloff_mark != 0 {
        process_exit(1);
    }
    let a: CryoStorageSpec = cryo_storage_spec_default_lh2();
    let b: CryoStorageSpec = cryo_storage_spec_default_lh2();
    if (a).mli_num_layers != (b).mli_num_layers {
        println("FAIL cryo_storage_spec_default_lh2");
        process_exit(1);
    }
    println("prod_propellant_cryogenic_boiloff: PASSED");
}
