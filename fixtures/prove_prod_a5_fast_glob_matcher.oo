// # Product prove std/web_ecosystem/fast_glob_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts glob_match_star is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/fast_glob_matcher.oo.
//
// Beats:
//   1. Call glob_match_star twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fast_glob_matcher: PASSED only if they match.

import "std/web_ecosystem/fast_glob_matcher.oo";

pub fn main() {
    let fast_glob_matcher_mark: Int = 0;
    if fast_glob_matcher_mark != 0 {
        process_exit(1);
    }
    let a: Int = glob_match_star();
    let b: Int = glob_match_star();
    if a != b {
        println("FAIL glob_match_star");
        process_exit(1);
    }
    println("prod_fast_glob_matcher: PASSED");
}
