// # Product prove std/fintech/fast_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts fast_apply_copy_operator is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech/fast_decoder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fast_apply_copy_operator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fast_decoder: PASSED only if they match.

import "std/fintech/fast_decoder.oo";

pub fn main() {
    let g2_a = fast_apply_copy_operator(2, true, 2);
    let g2_b = fast_apply_copy_operator(2, true, 2);
    if g2_a != g2_b {
        println("FAIL fast_apply_copy_operator");
        process_exit(1);
    }
    println("prod_g2_fast_decoder: PASSED");
}
