// # Product prove std/web_ecosystem/jwt_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/jwt_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jwt_decoder: PASSED only if they match.

import "std/web_ecosystem/jwt_decoder.oo";

pub fn main() {
    let jwt_decoder_a = jwt_b64_index(0);
    let jwt_decoder_b = jwt_b64_index(0);
    if jwt_decoder_a != jwt_decoder_b {
        println("FAIL jwt_decoder");
        process_exit(1);
    }
    println("prod_ap_jwt_decoder: PASSED");
}
