// # Product prove std/aero/propulsion_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts propulsion_module_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion_stubs.oo.
//
// Beats:
//   1. Call propulsion_module_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propulsion_stubs: PASSED only if they match.

import "std/aero/propulsion_stubs.oo";

pub fn main() {
    let a = propulsion_module_ready();
    let b = propulsion_module_ready();
    if a != b {
        println("FAIL propulsion_module_ready");
        process_exit(1);
    }
    println("prod_propulsion_stubs: PASSED");
}
