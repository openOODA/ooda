// # Product prove ETL Modular Pipeline Library
//
// Logline: Verify the modular ETL library builds EtlField and EtlSchema records, validates record-shape against schema, and composes EtlRecord values in field order.
//
// Setup: Imports std/enterprise/etl.oo for the EtlField / EtlSchema / EtlRecord types. Pure value-returning helpers, no IO.
//
// Beats:
//   1. etl_field_create binds name, type, is_nullable, is_primary_key.
//   2. etl_schema_create, etl_schema_add_field, and etl_schema_find_field_index grow the schema in order.
//   3. etl_record_create, etl_record_add_value, and etl_record_set_value compose a record.
//   4. etl_record_validate gates on field_count match and non-null requirement.

import "std/enterprise/etl.oo";

pub fn test_etl_field_create() {
    let f: EtlField = etl_field_create("user_id", 1, false, true);
    let f_name: String = (f).name;
    if f_name != "user_id" {
        println("FAIL: etl_field_create must carry the name");
        process_exit(1);
    }
    let f_pk: Bool = (f).is_primary_key;
    if f_pk == false {
        println("FAIL: etl_field_create must carry is_primary_key");
        process_exit(1);
    }
    let f_nullable: Bool = (f).is_nullable;
    if f_nullable == true {
        println("FAIL: etl_field_create must carry is_nullable=false");
        process_exit(1);
    }
    println("PASS: etl_field_create");
}

pub fn test_etl_schema_add_and_find() {
    let mut sch: EtlSchema = etl_schema_create("users", 1);
    let f_id: EtlField = etl_field_create("id", 1, false, true);
    let f_name: EtlField = etl_field_create("name", 2, true, false);
    sch = etl_schema_add_field(sch, f_id);
    sch = etl_schema_add_field(sch, f_name);
    let idx_id: Int = etl_schema_find_field_index(&sch, "id");
    if idx_id != 0 {
        println("FAIL: id field must be at index 0");
        process_exit(1);
    }
    let idx_name: Int = etl_schema_find_field_index(&sch, "name");
    if idx_name != 1 {
        println("FAIL: name field must be at index 1");
        process_exit(1);
    }
    let idx_missing: Int = etl_schema_find_field_index(&sch, "missing");
    if idx_missing != -1 {
        println("FAIL: missing field must return -1");
        process_exit(1);
    }
    println("PASS: etl_schema add and find");
}

pub fn test_etl_record_create_and_set() {
    let mut rec: EtlRecord = etl_record_create(7, "users");
    rec = etl_record_add_value(&rec, "42");
    rec = etl_record_add_value(&rec, "alice");
    let v0: String = etl_record_get_value(&rec, 0);
    if v0 != "42" {
        println("FAIL: etl_record_get_value(0) must be 42");
        process_exit(1);
    }
    let v1: String = etl_record_get_value(&rec, 1);
    if v1 != "alice" {
        println("FAIL: etl_record_get_value(1) must be alice");
        process_exit(1);
    }
    let updated: EtlRecord = etl_record_set_value(&rec, 1, "bob");
    let v1_new: String = etl_record_get_value(&updated, 1);
    if v1_new != "bob" {
        println("FAIL: etl_record_set_value must replace the value");
        process_exit(1);
    }
    println("PASS: etl_record create and set");
}

pub fn test_etl_record_validate() {
    let mut sch: EtlSchema = etl_schema_create("orders", 1);
    let f_id: EtlField = etl_field_create("id", 1, false, true);
    let f_name: EtlField = etl_field_create("name", 2, false, false);
    sch = etl_schema_add_field(sch, f_id);
    sch = etl_schema_add_field(sch, f_name);
    let mut rec: EtlRecord = etl_record_create(1, "orders");
    rec = etl_record_add_value(&rec, "10");
    rec = etl_record_add_value(&rec, "widget");
    let ok: Bool = etl_record_validate(&rec, &sch);
    if ok == false {
        println("FAIL: valid record must validate");
        process_exit(1);
    }
    let mut bad: EtlRecord = etl_record_create(2, "orders");
    bad = etl_record_add_value(&bad, "20");
    let bad_ok: Bool = etl_record_validate(&bad, &sch);
    if bad_ok == true {
        println("FAIL: short record must fail validation");
        process_exit(1);
    }
    println("PASS: etl_record_validate");
}

pub fn main() {
    test_etl_field_create();
    test_etl_schema_add_and_find();
    test_etl_record_create_and_set();
    test_etl_record_validate();
    println("PROVE_PROD_ETL_MODULAR_PASSED");
}
