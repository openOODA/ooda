// # Product prove std/sec/sys/elf_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_types_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_types.oo.
//
// Beats:
//   1. Call elf_types_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_types: PASSED only if they match.

import "std/sec/sys/elf_types.oo";

pub fn main() {
    let a = elf_types_marker();
    let b = elf_types_marker();
    if a != b {
        println("FAIL elf_types_marker");
        process_exit(1);
    }
    println("prod_elf_types: PASSED");
}
