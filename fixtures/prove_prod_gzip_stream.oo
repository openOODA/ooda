// # Product prove std/archive/gzip_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts gzip_stream_validate_magic is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/gzip_stream.oo.
//
// Beats:
//   1. Call gzip_stream_validate_magic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gzip_stream: PASSED only if they match.

import "std/archive/gzip_stream.oo";

pub fn main() {
    let a = gzip_stream_validate_magic("x");
    let b = gzip_stream_validate_magic("x");
    if a != b {
        println("FAIL gzip_stream_validate_magic");
        process_exit(1);
    }
    println("prod_gzip_stream: PASSED");
}
