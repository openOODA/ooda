// # Product prove std/db_columnar/arrow_struct_array.oo
//
// Logline: Fail-closed verification that Apache Arrow StructArray and child field vectors are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_struct_array.oo.
//
// Beats:
//   1. Create child StructFieldVector for integer field values.
//   2. Extract field values by row index and assert deterministic elements.
//   3. Initialize ArrowStructArray and configure null counts.
//   4. Assert deterministic struct array dimensions and metadata.
//   5. Print prod_g4_db_arrow_struct: PASSED and exit 0.

import "std/db_columnar/arrow_struct_array.oo";

pub fn main() {
    let mut vals: List[Int] = list_new();
    vals = list_push(vals, 101);
    vals = list_push(vals, 202);
    vals = list_push(vals, 303);

    let fvec: StructFieldVector = struct_field_vector_new_int("user_id", vals);
    if fvec.length != 3 || fvec.type_id != 1 || fvec.field_name != "user_id" {
        println("FAIL struct_field_vector_new_int metadata");
        process_exit(1);
    }

    let v0: Int = struct_field_vector_get_int(fvec, 0);
    let v1: Int = struct_field_vector_get_int(fvec, 1);
    let v2: Int = struct_field_vector_get_int(fvec, 2);
    if v0 != 101 || v1 != 202 || v2 != 303 {
        println("FAIL struct_field_vector_get_int values");
        process_exit(1);
    }

    let arr0: ArrowStructArray = arrow_struct_array_new(2, 3);
    if arr0.num_fields != 2 || arr0.length != 3 || arr0.null_count != 0 {
        println("FAIL arrow_struct_array_new");
        process_exit(1);
    }

    let arr1: ArrowStructArray = arrow_struct_array_set_null_count(arr0, 1);
    if arr1.null_count != 1 || arr1.length != 3 {
        println("FAIL arrow_struct_array_set_null_count");
        process_exit(1);
    }

    println("prod_g4_db_arrow_struct: PASSED");
    process_exit(0);
}
