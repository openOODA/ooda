// # Product prove std/fin/yield_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/yield_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_yield_types: PASSED only if they match.

import "std/fin/yield_types.oo";

pub fn main() {
    let yield_types_a = discount_factor_new(0, 0);
    let yield_types_b = discount_factor_new(0, 0);
    let yield_types_va = discount_factor_tenor(yield_types_a);
    let yield_types_vb = discount_factor_tenor(yield_types_b);
    if yield_types_va != yield_types_vb {
        println("FAIL yield_types");
        process_exit(1);
    }
    println("prod_ap_yield_types: PASSED");
}
