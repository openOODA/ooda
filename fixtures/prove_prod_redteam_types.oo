// # Product prove std/sec/redteam_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts vulnerability_severity is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/redteam_types.oo.
//
// Beats:
//   1. Call vulnerability_severity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_redteam_types: PASSED only if they match.

import "std/sec/redteam_types.oo";

pub fn main() {
    let obj = vulnerability_new(0, 0);
    let a = vulnerability_severity(obj);
    let b = vulnerability_severity(obj);
    if a != b {
        println("FAIL vulnerability_severity");
        process_exit(1);
    }
    println("prod_redteam_types: PASSED");
}
