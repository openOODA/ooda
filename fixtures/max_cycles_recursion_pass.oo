// # Pass shallow recursive MaxCycles
//
// Logline: Shallow recursion stays under the shared cycle budget and returns zero.
//
// Beats:
//   1. Honor the line-start fuel directive as the shared budget.
//   2. Recurse three times from burn into itself.
//   3. Stay under fifty cycles and print the result.

// MAX_CYCLES: 50
// M126: shallow recursion under shared budget
fn burn(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return burn(n - 1);
}

pub fn main() {
    let x = burn(3);
    println(x);
}
