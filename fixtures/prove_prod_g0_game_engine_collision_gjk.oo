// # Product prove std/game_engine/collision_gjk.oo
//
// Logline: Fail-closed emit+gcc+run asserts gjk_dot is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/collision_gjk.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gjk_dot twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_collision_gjk: PASSED only if they match.

import "std/game_engine/collision_gjk.oo";

pub fn main() {
    let g0_a = gjk_dot(1.0, 1.0, 1.0, 1.0);
    let g0_b = gjk_dot(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL gjk_dot");
        process_exit(1);
    }
    println("prod_g0_collision_gjk: PASSED");
}
