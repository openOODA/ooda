// # Product prove std/astro_advanced/nuclear_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/nuclear_thermal_propulsion.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/nuclear_thermal_propulsion.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_nuclear_thermal_propulsion: PASSED only if they match.

import "std/astro_advanced/nuclear_thermal_propulsion.oo";

pub fn main() {
    let nuclear_thermal_propulsion_a = ntp_isp();
    let nuclear_thermal_propulsion_b = ntp_isp();
    if nuclear_thermal_propulsion_a != nuclear_thermal_propulsion_b {
        println("FAIL nuclear_thermal_propulsion");
        process_exit(1);
    }
    println("prod_ap_nuclear_thermal_propulsion: PASSED");
}
