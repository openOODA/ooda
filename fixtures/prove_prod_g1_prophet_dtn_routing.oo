// # Product prove std/graph_networks/prophet_dtn_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts prophet_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/prophet_dtn_routing.oo.
//
// Beats:
//   1. Call prophet_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prophet_dtn_routing: PASSED only if they match.

import "std/graph_networks/prophet_dtn_routing.oo";

pub fn main() {
    let a: ProphetRouter = prophet_create(0);
    let b: ProphetRouter = prophet_create(0);
    if a.local_id != b.local_id {
        println("FAIL prophet_create");
        process_exit(1);
    }
    println("prod_prophet_dtn_routing: PASSED");
}
