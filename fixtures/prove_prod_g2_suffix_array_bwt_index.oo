// # Product prove std/genomics_advanced/suffix_array_bwt_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts bwt_step_lf_mapping is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/suffix_array_bwt_index.oo.
//
// Beats:
//   1. Call bwt_step_lf_mapping twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_suffix_array_bwt_index: PASSED only if they match.

import "std/genomics_advanced/suffix_array_bwt_index.oo";

pub fn main() {
    let suffix_array_bwt_index_mark: Int = 0;
    if suffix_array_bwt_index_mark != 0 {
        process_exit(1);
    }
    let a: BwtIndexRange = bwt_step_lf_mapping(0, 0, 0);
    let b: BwtIndexRange = bwt_step_lf_mapping(0, 0, 0);
    if (a).low_idx != (b).low_idx {
        println("FAIL bwt_step_lf_mapping");
        process_exit(1);
    }
    println("prod_g2_suffix_array_bwt_index: PASSED");
}
