// # Product prove std/telecom_6g/thz_path_loss_sub_thz.oo
//
// Logline: Fail-closed emit+gcc+run asserts sub_thz_fspl_1m_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_path_loss_sub_thz.oo.
//
// Beats:
//   1. Call sub_thz_fspl_1m_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_thz_path_loss_sub_thz: PASSED only if they match.

import "std/telecom_6g/thz_path_loss_sub_thz.oo";

pub fn main() {
    let thz_path_loss_sub_thz_mark: Int = 0;
    if thz_path_loss_sub_thz_mark != 0 {
        process_exit(1);
    }
    let a: Float = sub_thz_fspl_1m_db(0.0);
    let b: Float = sub_thz_fspl_1m_db(0.0);
    if a != b {
        println("FAIL sub_thz_fspl_1m_db");
        process_exit(1);
    }
    println("prod_g2_thz_path_loss_sub_thz: PASSED");
}
