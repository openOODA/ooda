// # Product Prove std/security_defense/control_flow_flattening.oo
//
// Logline: Deterministic assertion fixture verifying control flow graph flattening into state-machine switch dispatchers.
//
// Setup: Isolated emit-c test fixture importing std/security_defense/control_flow_flattening.oo.
//
// Beats:
//   1. Construct FlattenedFunction with states and branching transitions.
//   2. Step through dispatcher transitions under deterministic branch conditions.
//   3. Assert exit state reached cleanly.
//   4. Print "prod_g4_sec_control_flow_flattening: PASSED".

import "std/security_defense/control_flow_flattening.oo";

pub fn main() {
    let mut ff: FlattenedFunction = flattened_function_new("test_flatten", 1, 99);
    let _b1: Bool = flattened_function_add_block(&mut ff, 1, 2, 2, 3, false);
    let _b2: Bool = flattened_function_add_block(&mut ff, 2, 4, 4, -1, false);
    let _b3: Bool = flattened_function_add_block(&mut ff, 3, 3, 4, -1, false);
    let _b4: Bool = flattened_function_add_block(&mut ff, 4, 1, 99, -1, true);

    if (ff).block_count != 4 {
        println("FAIL: block_count mismatch");
        process_exit(1);
    }

    // Step 1: from state 1 with cond=false -> state 2
    let s1: Bool = flattened_function_step(&mut ff, false);
    if !s1 || (ff).dispatcher_switch_var != 2 {
        println("FAIL: step 1 state mismatch");
        process_exit(1);
    }

    // Step 2: from state 2 -> state 4
    let s2: Bool = flattened_function_step(&mut ff, false);
    if !s2 || (ff).dispatcher_switch_var != 4 {
        println("FAIL: step 2 state mismatch");
        process_exit(1);
    }

    // Step 3: from state 4 (terminal) -> state 99, returns false
    let s3: Bool = flattened_function_step(&mut ff, false);
    if s3 || (ff).dispatcher_switch_var != 99 {
        println("FAIL: step 3 terminal mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_control_flow_flattening: PASSED");
    process_exit(0);
}
