// # Product prove std/compilers_polyhedral/autovec_masked_predication.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/autovec_masked_predication.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_masked_predication.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_autovec_masked_predication: PASSED only if they match.

import "std/compilers_polyhedral/autovec_masked_predication.oo";

pub fn main() {
    let autovec_masked_predication_a = vector_predicate_mask_new(0, 0, 0);
    let autovec_masked_predication_b = vector_predicate_mask_new(0, 0, 0);
    let autovec_masked_predication_va = predicate_can_skip_then(autovec_masked_predication_a);
    let autovec_masked_predication_vb = predicate_can_skip_then(autovec_masked_predication_b);
    if autovec_masked_predication_va != autovec_masked_predication_vb {
        println("FAIL autovec_masked_predication");
        process_exit(1);
    }
    println("prod_ap_autovec_masked_predication: PASSED");
}
