// job: pure multi-module build fixture for std/semver.oo
// check residual: oodac check is single-file; check library: oodac check std/semver.oo
// residual: prerelease/build not accepted on pure path A core parse
import "std/semver.oo";

pub fn main() {
    // Core: major/minor/patch of "1.2.3"
    assert_eq!(semver_major("1.2.3"), "1");
    assert_eq!(semver_minor("1.2.3"), "2");
    assert_eq!(semver_patch("1.2.3"), "3");
    // Result fail-closed surface
    assert_eq!(semver_parse("1.2.3"), Ok("1.2.3"));
    assert_eq!(semver_parse("1.2"), Err("invalid"));
    assert_eq!(semver_parse("01.2.3"), Err("invalid"));
    // zero is allowed as a single-digit component
    assert_eq!(semver_major("0.0.0"), "0");
    assert_eq!(semver_minor("0.0.0"), "0");
    assert_eq!(semver_patch("0.0.0"), "0");
    println("semver-ok");
}
