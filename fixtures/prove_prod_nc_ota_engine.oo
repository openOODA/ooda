// # Product prove std/edge/ota_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ota_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/edge/ota_engine.oo.
//
// Beats:
//   1. Call ota_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ota_engine: PASSED only if it matches.

import "std/edge/ota_engine.oo";

pub fn main() {
    let a: Int = ota_engine_probe();
    if a != 0 {
        println("FAIL ota_engine_probe");
        process_exit(1);
    }
    println("prod_nc_ota_engine: PASSED");
}
