// # Refuse secret dlopen path
//
// Logline: Pass a secret IDENT as the dlopen path so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag lib_path as secret.
//   2. Call dlopen with lib_path as the path.
//   3. Print 1 after the call.
//
// T2-4 TP: dlopen path arg is SECRET — MUST refuse
// SECRET: lib_path
pub fn main(ffi: &UnsafeFFICap) {
    let lib_path = "/tmp/evil.so";
    let r = dlopen(ffi, lib_path, 0);
    println(1);
}
