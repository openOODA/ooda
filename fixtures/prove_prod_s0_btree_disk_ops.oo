// # Product prove std/database/btree_disk_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts btree_node_key_at value or determinism.
//
// Setup: Isolated emit-c. Imports std/database/btree_disk_ops.oo.
//
// Beats:
//   1. Call btree_node_key_at twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_btree_disk_ops: PASSED only if asserts hold.

import "std/database/btree_disk_ops.oo";

pub fn main() {
    let node = btree_node_create(0, 1);
    let btree_disk_ops_a: Int = btree_node_key_at(node, 0);
    let btree_disk_ops_b: Int = btree_node_key_at(btree_node_create(0, 1), 0);
    if btree_disk_ops_a != btree_disk_ops_b {
        println("FAIL btree_node_key_at det");
        process_exit(1);
    }
    println("prod_btree_disk_ops: PASSED");
}
