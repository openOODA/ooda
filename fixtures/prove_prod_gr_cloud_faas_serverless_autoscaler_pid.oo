// # Product prove std/cloud_faas/serverless_autoscaler_pid.oo
//
// Logline: Fail-closed emit+gcc+run asserts autoscaler_calculate_target is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/serverless_autoscaler_pid.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call autoscaler_calculate_target twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_serverless_autoscaler_pid: PASSED only if they match.

import "std/cloud_faas/serverless_autoscaler_pid.oo";

pub fn main() {
    let mut g0_oa: PidControllerState = PidControllerState { kp: 0, ki: 0, kd: 0, target_concurrency: 0, integral_error: 0, last_error: 0, current_workers: 0, min_workers: 0, max_workers: 0 };
    let mut g0_ob: PidControllerState = PidControllerState { kp: 0, ki: 0, kd: 0, target_concurrency: 0, integral_error: 0, last_error: 0, current_workers: 0, min_workers: 0, max_workers: 0 };
    let g0_a = autoscaler_calculate_target(&g0_oa, 0);
    let g0_b = autoscaler_calculate_target(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL autoscaler_calculate_target");
        process_exit(1);
    }
    println("prod_gr_serverless_autoscaler_pid: PASSED");
}
