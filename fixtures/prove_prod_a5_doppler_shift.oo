// # Product prove std/telecom/doppler_shift.oo
//
// Logline: Fail-closed emit+gcc+run asserts doppler_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/doppler_shift.oo.
//
// Beats:
//   1. Call doppler_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_doppler_shift: PASSED only if they match.

import "std/telecom/doppler_shift.oo";

pub fn main() {
    let doppler_shift_mark: Int = 0;
    if doppler_shift_mark != 0 {
        process_exit(1);
    }
    let a: Float = doppler_pi();
    let b: Float = doppler_pi();
    if a != b {
        println("FAIL doppler_pi");
        process_exit(1);
    }
    println("prod_doppler_shift: PASSED");
}
