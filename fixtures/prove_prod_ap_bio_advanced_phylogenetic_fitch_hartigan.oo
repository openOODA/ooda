import "std/bio_advanced/phylogenetic_fitch_hartigan.oo";

pub fn main() {
    let phylogenetic_fitch_hartigan_a = fitch_char_to_mask("x");
    let phylogenetic_fitch_hartigan_b = fitch_char_to_mask("x");
    if phylogenetic_fitch_hartigan_a != phylogenetic_fitch_hartigan_b {
        println("FAIL phylogenetic_fitch_hartigan");
