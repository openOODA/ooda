// # Product prove std/quantum_tensor_nets/tensor_svd_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts svd_result_2x2_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tensor_svd_decomposition.oo.
//
// Beats:
//   1. Call svd_result_2x2_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensor_svd_decomposition: PASSED only if they match.

import "std/quantum_tensor_nets/tensor_svd_decomposition.oo";

pub fn main() {
    let tensor_svd_decomposition_mark: Int = 0;
    if tensor_svd_decomposition_mark != 0 {
        process_exit(1);
    }
    let a: SvdResult2x2 = svd_result_2x2_new();
    let b: SvdResult2x2 = svd_result_2x2_new();
    if (a).u00 != (b).u00 {
        println("FAIL svd_result_2x2_new");
        process_exit(1);
    }
    println("prod_tensor_svd_decomposition: PASSED");
}
