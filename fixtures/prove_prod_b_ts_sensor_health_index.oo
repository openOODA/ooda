// # Product prove std/industrial_predictive/ts_sensor_health_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts ts_sensor_health_index_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_sensor_health_index.oo.
//
// Beats:
//   1. Call ts_sensor_health_index_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_sensor_health_index: PASSED only if they match.

import "std/industrial_predictive/ts_sensor_health_index.oo";

pub fn main() {
    let a = ts_sensor_health_index_probe();
    let b = ts_sensor_health_index_probe();
    if a != b {
        println("FAIL ts_sensor_health_index_probe");
        process_exit(1);
    }
    println("prod_ts_sensor_health_index: PASSED");
}
