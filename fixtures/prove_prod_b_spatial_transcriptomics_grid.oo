// # Product prove std/genomics_advanced/spatial_transcriptomics_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_transcriptomics_grid_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/spatial_transcriptomics_grid.oo.
//
// Beats:
//   1. Call spatial_transcriptomics_grid_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_transcriptomics_grid: PASSED only if they match.

import "std/genomics_advanced/spatial_transcriptomics_grid.oo";

pub fn main() {
    let a = spatial_transcriptomics_grid_probe();
    let b = spatial_transcriptomics_grid_probe();
    if a != b {
        println("FAIL spatial_transcriptomics_grid_probe");
        process_exit(1);
    }
    println("prod_spatial_transcriptomics_grid: PASSED");
}
