// # Product prove std/protein_folding/alphafold_pair_representation.oo
//
// Logline: Fail-closed emit+gcc+run asserts af_sigmoid_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/alphafold_pair_representation.oo.
//
// Beats:
//   1. Call af_sigmoid_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_alphafold_pair_representation: PASSED only if they match.

import "std/protein_folding/alphafold_pair_representation.oo";

pub fn main() {
    let alphafold_pair_representation_mark: Int = 0;
    if alphafold_pair_representation_mark != 0 {
        process_exit(1);
    }
    let a: Float = af_sigmoid_approx(0.0);
    let b: Float = af_sigmoid_approx(0.0);
    if a != b {
        println("FAIL af_sigmoid_approx");
        process_exit(1);
    }
    println("prod_alphafold_pair_representation: PASSED");
}
