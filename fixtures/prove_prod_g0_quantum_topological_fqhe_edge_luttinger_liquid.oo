// # Product prove std/quantum_topological/fqhe_edge_luttinger_liquid.oo
//
// Logline: Fail-closed emit+gcc+run asserts chiral_edge_conductance_si is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_edge_luttinger_liquid.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call chiral_edge_conductance_si twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fqhe_edge_luttinger_liquid: PASSED only if they match.

import "std/quantum_topological/fqhe_edge_luttinger_liquid.oo";

pub fn main() {
    let g0_oa: ChiralEdgeLiquid = ChiralEdgeLiquid { filling_fraction_nu: 1.0, edge_velocity_m_s: 1.0, chiral_central_charge: 1.0, electron_tunneling_exponent: 1.0, // g = 1 / nu
    quasihole_scaling_dimension: 1.0 };
    let g0_ob: ChiralEdgeLiquid = ChiralEdgeLiquid { filling_fraction_nu: 1.0, edge_velocity_m_s: 1.0, chiral_central_charge: 1.0, electron_tunneling_exponent: 1.0, // g = 1 / nu
    quasihole_scaling_dimension: 1.0 };
    let g0_a = chiral_edge_conductance_si(&g0_oa);
    let g0_b = chiral_edge_conductance_si(&g0_ob);
    if g0_a != g0_b {
        println("FAIL chiral_edge_conductance_si");
        process_exit(1);
    }
    println("prod_g0_fqhe_edge_luttinger_liquid: PASSED");
}
