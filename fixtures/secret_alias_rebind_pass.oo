// # Clear a rebound secret alias
//
// Logline: Rebinding a tainted mutable name back to a clean literal should clear the sink.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Start y as that secret, then assign a clean literal.
//   3. Print y so a non-sticky pass rail can accept it.

// M-? alias rebind over-tainting: let mut to secret then to clean should clear
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let mut y = api_key;
    y = "clean";
    println(y);
}
