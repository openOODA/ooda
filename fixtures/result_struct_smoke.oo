// # Result[struct] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[Node, String] Ok payload fields.
//
// Setup: Backend-C. Node has Int id and String tag.
//
// Beats:
//   1. mk returns Ok of Node id 3.
//   2. Match Ok and read g.id.
//   3. Exit 1 before PASSED on a miss.

type Node = struct {
    id: Int,
    tag: String
};

fn mk() -> Result[Node, String] {
    return Ok(Node { id: 3, tag: "ok" });
}

pub fn main() {
    let r: Result[Node, String] = mk();
    match r {
        Ok(g) => {
            if g.id != 3 {
                println("FAIL id");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL err");
            process_exit(1);
        }
    }
    println("result_struct_smoke: PASSED");
}
