// # Product prove std/lidar_perception/lidar_loop_closure_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts ring_key_descriptor_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/lidar_loop_closure_detector.oo.
//
// Beats:
//   1. Call ring_key_descriptor_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lidar_loop_closure_detector: PASSED only if they match.

import "std/lidar_perception/lidar_loop_closure_detector.oo";

pub fn main() {
    let lidar_loop_closure_detector_mark: Int = 0;
    if lidar_loop_closure_detector_mark != 0 {
        process_exit(1);
    }
    let lidar_loop_closure_detector_a = ring_key_descriptor_zero();
    let lidar_loop_closure_detector_b = ring_key_descriptor_zero();
    if (lidar_loop_closure_detector_a).k0 != (lidar_loop_closure_detector_b).k0 {
        println("FAIL ring_key_descriptor_zero");
        process_exit(1);
    }
    println("prod_lidar_loop_closure_detector: PASSED");
}
