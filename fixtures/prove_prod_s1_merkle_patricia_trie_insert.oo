// # Product prove std/zk_rollup/merkle_patricia_trie_insert.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_common_prefix_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_insert.oo.
//
// Beats:
//   1. Call mpt_common_prefix_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_merkle_patricia_trie_insert: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_insert.oo";

pub fn main() {
    let merkle_patricia_trie_insert_mark: Int = 0;
    if merkle_patricia_trie_insert_mark != 0 {
        process_exit(1);
    }
    let merkle_patricia_trie_insert_a: Int = mpt_common_prefix_len(1, 1);
    let merkle_patricia_trie_insert_b: Int = mpt_common_prefix_len(1, 1);
    if merkle_patricia_trie_insert_a != merkle_patricia_trie_insert_b {
        println("FAIL mpt_common_prefix_len");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_insert: PASSED");
}
