// # Product prove std/db_storage/sql_volcano_iterator_scan.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_volcano_iterator_scan_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_volcano_iterator_scan.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sql_volcano_iterator_scan_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sql_volcano_iterator_scan: PASSED only if they match.

import "std/db_storage/sql_volcano_iterator_scan.oo";

pub fn main() {
    let g2_a = sql_volcano_iterator_scan_probe();
    let g2_b = sql_volcano_iterator_scan_probe();
    if g2_a != g2_b {
        println("FAIL sql_volcano_iterator_scan_probe");
        process_exit(1);
    }
    println("prod_g2_sql_volcano_iterator_scan: PASSED");
}
