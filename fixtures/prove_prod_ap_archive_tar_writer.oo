// # Product prove std/archive/tar_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/tar_writer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/tar_writer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tar_writer: PASSED only if they match.

import "std/archive/tar_writer.oo";

pub fn main() {
    let tar_writer_a = tar_to_octal(0, 0);
    let tar_writer_b = tar_to_octal(0, 0);
    if tar_writer_a.contains(tar_writer_b) == false {
        println("FAIL tar_writer");
        process_exit(1);
    }
    if tar_writer_b.contains(tar_writer_a) == false {
        println("FAIL tar_writer");
        process_exit(1);
    }
    println("prod_ap_tar_writer: PASSED");
}
