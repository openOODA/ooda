// # Product prove std/compilers_vm/bytecode_constant_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts cp_tag_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_constant_pool.oo.
//
// Beats:
//   1. Call cp_tag_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_constant_pool: PASSED only if they match.

import "std/compilers_vm/bytecode_constant_pool.oo";

pub fn main() {
    let bytecode_constant_pool_mark: Int = 0;
    if bytecode_constant_pool_mark != 0 {
        process_exit(1);
    }
    let a: Int = cp_tag_int();
    let b: Int = cp_tag_int();
    if a != b {
        println("FAIL cp_tag_int");
        process_exit(1);
    }
    println("prod_bytecode_constant_pool: PASSED");
}
