// # Product prove std/markup/json_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/json_ast.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_ast.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_json_ast: PASSED only if they match.

import "std/markup/json_ast.oo";

pub fn main() {
    let json_ast_a = json_node_null();
    let json_ast_b = json_node_null();
    let json_ast_va = json_is_null(json_ast_a);
    let json_ast_vb = json_is_null(json_ast_b);
    if json_ast_va != json_ast_vb {
        println("FAIL json_ast");
        process_exit(1);
    }
    println("prod_ap_json_ast: PASSED");
}
