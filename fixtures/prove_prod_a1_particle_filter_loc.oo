// # Product prove std/auto_robot/particle_filter_loc.oo
//
// Logline: Fail-closed emit+gcc+run asserts pf_mean_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/particle_filter_loc.oo.
//
// Beats:
//   1. Call pf_mean_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_particle_filter_loc: PASSED only if they match.

import "std/auto_robot/particle_filter_loc.oo";

pub fn main() {
    let particle_filter_loc_mark: Int = 0;
    if particle_filter_loc_mark != 0 {
        process_exit(1);
    }
    let a: Int = pf_mean_x(0, 0, 0, 0);
    let b: Int = pf_mean_x(0, 0, 0, 0);
    if a != b {
        println("FAIL pf_mean_x");
        process_exit(1);
    }
    println("prod_particle_filter_loc: PASSED");
}
