// # Product prove std/compilers_vm/bytecode_instruction_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/bytecode_instruction_set.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_instruction_set.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bytecode_instruction_set: PASSED only if they match.

import "std/compilers_vm/bytecode_instruction_set.oo";

pub fn main() {
    let bytecode_instruction_set_a = op_nop();
    let bytecode_instruction_set_b = op_nop();
    if bytecode_instruction_set_a != bytecode_instruction_set_b {
        println("FAIL bytecode_instruction_set");
        process_exit(1);
    }
    println("prod_ap_bytecode_instruction_set: PASSED");
}
