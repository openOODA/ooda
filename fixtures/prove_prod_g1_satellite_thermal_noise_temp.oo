// # Product prove std/satellite_dvb/satellite_thermal_noise_temp.oo
//
// Logline: Fail-closed emit+gcc+run asserts system_noise_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_thermal_noise_temp.oo.
//
// Beats:
//   1. Call system_noise_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_thermal_noise_temp: PASSED only if they match.

import "std/satellite_dvb/satellite_thermal_noise_temp.oo";

pub fn main() {
    let a: SystemNoiseConfig = system_noise_config_default();
    let b: SystemNoiseConfig = system_noise_config_default();
    if a.antenna_gain_dbi != b.antenna_gain_dbi {
        println("FAIL system_noise_config_default");
        process_exit(1);
    }
    println("prod_satellite_thermal_noise_temp: PASSED");
}
