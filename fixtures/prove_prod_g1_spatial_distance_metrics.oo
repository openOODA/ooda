// # Product prove std/gis_topo/spatial_distance_metrics.oo
//
// Logline: Fail-closed emit+gcc+run asserts dist_point_to_point_2d is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/spatial_distance_metrics.oo.
//
// Beats:
//   1. Call dist_point_to_point_2d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spatial_distance_metrics: PASSED only if they match.

import "std/gis_topo/spatial_distance_metrics.oo";

pub fn main() {
    let a: Float = dist_point_to_point_2d(0.0, 0.0, 0.0, 0.0);
    let b: Float = dist_point_to_point_2d(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL dist_point_to_point_2d");
        process_exit(1);
    }
    println("prod_spatial_distance_metrics: PASSED");
}
