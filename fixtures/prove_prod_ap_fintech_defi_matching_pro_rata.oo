// # Product prove std/fintech_defi/matching_pro_rata.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fintech_defi/matching_pro_rata.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/matching_pro_rata.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_matching_pro_rata: PASSED only if they match.

import "std/fintech_defi/matching_pro_rata.oo";

pub fn main() {
    let matching_pro_rata_a = pro_rata_quote_new(0, "x", 0, 0);
    let matching_pro_rata_b = pro_rata_quote_new(0, "x", 0, 0);
    if matching_pro_rata_a.order_id != matching_pro_rata_b.order_id {
        println("FAIL matching_pro_rata");
        process_exit(1);
    }
    println("prod_ap_matching_pro_rata: PASSED");
}
