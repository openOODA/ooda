// # Product prove std/deep_ai/moe_expert_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts moe_expert_layer_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/moe_expert_layer.oo.
//
// Beats:
//   1. Call moe_expert_layer_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_moe_expert_layer: PASSED only if they match.

import "std/deep_ai/moe_expert_layer.oo";

pub fn main() {
    let a: Int = moe_expert_layer_marker();
    let b: Int = moe_expert_layer_marker();
    if a != b {
        println("FAIL moe_expert_layer_marker");
        process_exit(1);
    }
    println("prod_g2_moe_expert_layer: PASSED");
}
