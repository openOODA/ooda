// # Product prove std/robotics_auv/bio_inspired_undulatory_fin.oo
//
// Logline: Fail-closed emit+gcc+run asserts biomimetic_fin_params_default_tuna holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/bio_inspired_undulatory_fin.oo.
//
// Beats:
//   1. Call biomimetic_fin_params_default_tuna using the bio_inspired_undulatory_fin ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_bio_inspired_undulatory_fin: PASSED only if asserts hold.

import "std/robotics_auv/bio_inspired_undulatory_fin.oo";

pub fn main() {
    let obj = biomimetic_fin_params_default_tuna();
    let bio_inspired_undulatory_fin_a = obj.body_length_m;
    if bio_inspired_undulatory_fin_a != 0.8 {
        println("FAIL biomimetic_fin_params_default_tuna");
        process_exit(1);
    }
    println("prod_bio_inspired_undulatory_fin: PASSED");
}
