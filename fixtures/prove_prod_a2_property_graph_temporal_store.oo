// # Product prove std/db_graph/property_graph_temporal_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts time_interval_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_temporal_store.oo.
//
// Beats:
//   1. Call time_interval_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_temporal_store: PASSED only if they match.

import "std/db_graph/property_graph_temporal_store.oo";

pub fn main() {
    let property_graph_temporal_store_mark: Int = 0;
    if property_graph_temporal_store_mark != 0 {
        process_exit(1);
    }
    let a: TimeInterval = time_interval_new(0, 0);
    let b: TimeInterval = time_interval_new(0, 0);
    if (a).start_ts != (b).start_ts {
        println("FAIL time_interval_new");
        process_exit(1);
    }
    println("prod_property_graph_temporal_store: PASSED");
}
