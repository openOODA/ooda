// # Product prove std/embedded_hal/i2c_master_smbus.oo
//
// Logline: Fail-closed emit+gcc+run asserts smbus_calculate_pec is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/i2c_master_smbus.oo.
//
// Beats:
//   1. Call smbus_calculate_pec twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_i2c_master_smbus: PASSED only if they match.

import "std/embedded_hal/i2c_master_smbus.oo";

pub fn main() {
    let i2c_master_smbus_mark: Int = 0;
    if i2c_master_smbus_mark != 0 {
        process_exit(1);
    }
    let a: Int = smbus_calculate_pec(list_new());
    let b: Int = smbus_calculate_pec(list_new());
    if a != b {
        println("FAIL smbus_calculate_pec");
        process_exit(1);
    }
    println("prod_i2c_master_smbus: PASSED");
}
