// # Product prove std/grid/solar_inverter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/solar_inverter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_inverter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_solar_inverter: PASSED only if they match.

import "std/grid/solar_inverter.oo";

pub fn main() {
    let solar_inverter_a = solar_inverter_new(0, 0.0, 0.0, 0.0);
    let solar_inverter_b = solar_inverter_new(0, 0.0, 0.0, 0.0);
    let solar_inverter_va = solar_inverter_calc_part_load_efficiency(solar_inverter_a, 0.0);
    let solar_inverter_vb = solar_inverter_calc_part_load_efficiency(solar_inverter_b, 0.0);
    if solar_inverter_va != solar_inverter_vb {
        println("FAIL solar_inverter");
        process_exit(1);
    }
    println("prod_ap_solar_inverter: PASSED");
}
