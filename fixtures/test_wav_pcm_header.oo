// # WAV PCM header adversarial suite
//
// Logline: Validates a RIFF WAVE fmt chunk of size 16 and PCM bounds, and rejects another format.
//
// Setup: Pure. Imports wav_pcm_header.oo. Run from ooda/.
//
// Beats:
//   1. Make a 44100 Hz stereo 16-bit header and parse it.
//   2. Recover channels, rate, and bits.
//   3. Reject a truncated buffer and audio format that is not 1.

import "std/multimedia/wav_pcm_header.oo";

pub fn main() {
    let e: ByteOut = wav_pcm_header_make(2, 44100, 16);
    if e.flag < 1 {
        println("FAIL make " + e.err);
        process_exit(1);
    }
    let p: WavOut = wav_pcm_header_parse(e.bytes);
    if p.flag < 1 {
        println("FAIL parse " + p.err);
        process_exit(1);
    }
    if p.channels != 2 {
        println("FAIL ch");
        process_exit(1);
    }
    if p.rate != 44100 {
        println("FAIL rate");
        process_exit(1);
    }
    if p.bits != 16 {
        println("FAIL bits");
        process_exit(1);
    }
    if p.format != 1 {
        println("FAIL format");
        process_exit(1);
    }
    println("WAVE + fmt size 16 + format 1 + channels/rate/bits bounds");
    let mut cut: List[Int] = list_new();
    cut = list_push(cut, 82);
    let bad: WavOut = wav_pcm_header_parse(cut);
    if bad.flag > 0 {
        println("FAIL short ok");
        process_exit(1);
    }
    let mut tam: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(e.bytes) {
        if i == 20 {
            tam = list_push(tam, 3);
        } else {
            tam = list_push(tam, list_get(e.bytes, i));
        }
        i = i + 1;
    }
    let nf: WavOut = wav_pcm_header_parse(tam);
    if nf.flag > 0 {
        println("FAIL format ok");
        process_exit(1);
    }
    println("other format Err");
    println("SUITE PASSED");
    println("test_wav_pcm_header: PASSED");
}
