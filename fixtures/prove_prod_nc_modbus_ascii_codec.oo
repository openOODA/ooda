// # Product prove std/iot_scada/modbus_ascii_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_ascii_codec_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/iot_scada/modbus_ascii_codec.oo.
//
// Beats:
//   1. Call modbus_ascii_codec_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_modbus_ascii_codec: PASSED only if it matches.

import "std/iot_scada/modbus_ascii_codec.oo";

pub fn main() {
    let a: Int = modbus_ascii_codec_probe();
    if a != 0 {
        println("FAIL modbus_ascii_codec_probe");
        process_exit(1);
    }
    println("prod_nc_modbus_ascii_codec: PASSED");
}
