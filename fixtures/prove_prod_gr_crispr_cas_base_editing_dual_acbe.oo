//   3. Print prod_gr_base_editing_dual_acbe: PASSED only if they match.

import "std/crispr_cas/base_editing_dual_acbe.oo";

pub fn main() {
    let g0_a = base_editing_dual_acbe_probe();
    let g0_b = base_editing_dual_acbe_probe();
    if g0_a != g0_b {
        println("FAIL base_editing_dual_acbe_probe");
        process_exit(1);
    }
    println("prod_gr_base_editing_dual_acbe: PASSED");
