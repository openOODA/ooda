// # Product prove std/bio_advanced/wig_coverage_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts wig_coverage_calculator_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/wig_coverage_calculator.oo.
//
// Beats:
//   1. Call wig_coverage_calculator_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wig_coverage_calculator: PASSED only if they match.

import "std/bio_advanced/wig_coverage_calculator.oo";

pub fn main() {
    let a: Int = wig_coverage_calculator_probe();
    let b: Int = wig_coverage_calculator_probe();
    if a != b {
        println("FAIL wig_coverage_calculator_probe");
        process_exit(1);
    }
    println("prod_g2_wig_coverage_calculator: PASSED");
}
