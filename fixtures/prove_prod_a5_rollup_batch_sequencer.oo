// # Product prove std/zk_rollup/rollup_batch_sequencer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_batch_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_batch_sequencer.oo.
//
// Beats:
//   1. Call rollup_batch_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_batch_sequencer: PASSED only if they match.

import "std/zk_rollup/rollup_batch_sequencer.oo";

pub fn main() {
    let rollup_batch_sequencer_mark: Int = 0;
    if rollup_batch_sequencer_mark != 0 {
        process_exit(1);
    }
    let a: RollupBatchHeader = rollup_batch_header_new(0, 0, 0, 0, 0, 0);
    let b: RollupBatchHeader = rollup_batch_header_new(0, 0, 0, 0, 0, 0);
    if (a).batch_number != (b).batch_number {
        println("FAIL rollup_batch_header_new");
        process_exit(1);
    }
    println("prod_rollup_batch_sequencer: PASSED");
}
