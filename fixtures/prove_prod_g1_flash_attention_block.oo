// # Product prove std/deep_ai/flash_attention_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_attention_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/flash_attention_block.oo.
//
// Beats:
//   1. Call block_attention_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flash_attention_block: PASSED only if they match.

import "std/deep_ai/flash_attention_block.oo";

pub fn main() {
    let a: BlockAttentionConfig = block_attention_config_new(0, 0, 0, 0.0, true);
    let b: BlockAttentionConfig = block_attention_config_new(0, 0, 0, 0.0, true);
    if a.block_m != b.block_m {
        println("FAIL block_attention_config_new");
        process_exit(1);
    }
    println("prod_flash_attention_block: PASSED");
}
