// # Product sync atomic rcu prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/atomic_rcu.oo.
//
// Setup: Product std/sync/atomic_rcu.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New cell version 1 retired 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/atomic_rcu.oo";

pub fn main() {
    let c: RcuCell = rcu_cell_new(42);
    let v: Int = rcu_version(c);
    if v != 1 {
        println("FAIL rcuver 1");
        process_exit(1);
    }
    let n: Int = rcu_retired_count(c);
    if n != 0 {
        println("FAIL rcu retired");
        process_exit(1);
    }
    println("prod_rcuver: PASSED");
}
