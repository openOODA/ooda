// # Product prove std/quantum_open_systems/quantum_refrigeration_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts absorption_refrigerator_cop is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_refrigeration_cooling.oo.
//
// Beats:
//   1. Call absorption_refrigerator_cop twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_refrigeration_cooling: PASSED only if they match.

import "std/quantum_open_systems/quantum_refrigeration_cooling.oo";

pub fn main() {
    let quantum_refrigeration_cooling_mark: Int = 0;
    if quantum_refrigeration_cooling_mark != 0 {
        process_exit(1);
    }
    let quantum_refrigeration_cooling_a: Float = absorption_refrigerator_cop(1.0, 1.0, 1.0);
    let quantum_refrigeration_cooling_b: Float = absorption_refrigerator_cop(1.0, 1.0, 1.0);
    if quantum_refrigeration_cooling_a != quantum_refrigeration_cooling_b {
        println("FAIL absorption_refrigerator_cop");
        process_exit(1);
    }
    println("prod_quantum_refrigeration_cooling: PASSED");
}
