// # Product prove std/robotics_auv/quadratic_damping_crossflow.oo
//
// Logline: Fail-closed emit+gcc+run asserts ittc_skin_friction_coefficient holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/quadratic_damping_crossflow.oo.
//
// Beats:
//   1. Call ittc_skin_friction_coefficient using the quadratic_damping_crossflow ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_quadratic_damping_crossflow: PASSED only if asserts hold.

import "std/robotics_auv/quadratic_damping_crossflow.oo";

pub fn main() {
    let quadratic_damping_crossflow_a = ittc_skin_friction_coefficient(0.0);
    let quadratic_damping_crossflow_b = ittc_skin_friction_coefficient(0.0);
    if quadratic_damping_crossflow_a != quadratic_damping_crossflow_b {
        println("FAIL ittc_skin_friction_coefficient");
        process_exit(1);
    }
    println("prod_quadratic_damping_crossflow: PASSED");
}
