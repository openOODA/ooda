// # Product prove std/robotics_auv/hydrodynamic_suction_bernoulli.oo
//
// Logline: Fail-closed emit+gcc+run asserts bsuc_isqrt_seed is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/hydrodynamic_suction_bernoulli.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bsuc_isqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hydrodynamic_suction_bernoulli: PASSED only if they match.

import "std/robotics_auv/hydrodynamic_suction_bernoulli.oo";

pub fn main() {
    let g2_a = bsuc_isqrt_seed(2, 2);
    let g2_b = bsuc_isqrt_seed(2, 2);
    if g2_a != g2_b {
        println("FAIL bsuc_isqrt_seed");
        process_exit(1);
    }
    println("prod_g2_hydrodynamic_suction_bernoulli: PASSED");
}
