// # Formal Param Shadowing Leak Test
//
// Logline: Test if shadowing a formal parameter in a block skips release.
//
// Setup: oodac emit-c fixtures/test_formal_shadow_leak.oo.
//
// Beats:
//   1. Shadow a formal param in a block.

fn foo(s: String) {
    {
        let s = "inner";
        println(s);
    }
}

pub fn main() {
    foo("outer");
}
