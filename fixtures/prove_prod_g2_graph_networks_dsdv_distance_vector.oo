// # Product prove std/graph_networks/dsdv_distance_vector.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsdv_find_idx is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/dsdv_distance_vector.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dsdv_find_idx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dsdv_distance_vector: PASSED only if they match.

import "std/graph_networks/dsdv_distance_vector.oo";

pub fn main() {
    let g2_oa: DsdvRoutingTable = dsdv_table_create(2);
    let g2_ob: DsdvRoutingTable = dsdv_table_create(2);
    let g2_a = dsdv_find_idx(&g2_oa, 2);
    let g2_b = dsdv_find_idx(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL dsdv_find_idx");
        process_exit(1);
    }
    println("prod_g2_dsdv_distance_vector: PASSED");
}
