// # Product prove std/synthetic_biology/substrate_channeling_metabolon.oo
//
// Logline: Fail-closed emit+gcc+run asserts metabolon_calc_capture_efficiency is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/substrate_channeling_metabolon.oo.
//
// Beats:
//   1. Call metabolon_calc_capture_efficiency twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_substrate_channeling_metabolon: PASSED only if they match.

import "std/synthetic_biology/substrate_channeling_metabolon.oo";

pub fn main() {
    let substrate_channeling_metabolon_mark: Int = 0;
    if substrate_channeling_metabolon_mark != 0 {
        process_exit(1);
    }
    let a: Float = metabolon_calc_capture_efficiency(0.0, 0.0, 0.0);
    let b: Float = metabolon_calc_capture_efficiency(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL metabolon_calc_capture_efficiency");
        process_exit(1);
    }
    println("prod_substrate_channeling_metabolon: PASSED");
}
