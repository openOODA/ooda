//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_tendermint_bft_validator_set: PASSED only if they match.

import "std/bft_consensus/tendermint_bft_validator_set.oo";

pub fn main() {
    let tendermint_bft_validator_set_a = tendermint_validator_new("x", 0);
    let tendermint_bft_validator_set_b = tendermint_validator_new("x", 0);
    if tendermint_bft_validator_set_a.address != tendermint_bft_validator_set_b.address {
        println("FAIL tendermint_bft_validator_set");
        process_exit(1);
    }
    println("prod_ap_tendermint_bft_validator_set: PASSED");
}
