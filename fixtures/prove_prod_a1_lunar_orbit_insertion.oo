// # Product prove std/astro_advanced/lunar_orbit_insertion.oo
//
// Logline: Fail-closed emit+gcc+run asserts loi_dv is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/lunar_orbit_insertion.oo.
//
// Beats:
//   1. Call loi_dv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lunar_orbit_insertion: PASSED only if they match.

import "std/astro_advanced/lunar_orbit_insertion.oo";

pub fn main() {
    let lunar_orbit_insertion_mark: Int = 0;
    if lunar_orbit_insertion_mark != 0 {
        process_exit(1);
    }
    let a: Int = loi_dv();
    let b: Int = loi_dv();
    if a != b {
        println("FAIL loi_dv");
        process_exit(1);
    }
    println("prod_lunar_orbit_insertion: PASSED");
}
