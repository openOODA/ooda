// # Product prove std/game_engine/input_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts input_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/input_manager.oo.
//
// Beats:
//   1. Call input_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_input_manager: PASSED only if they match.

import "std/game_engine/input_manager.oo";

pub fn main() {
    let a: InputState = input_state_new();
    let b: InputState = input_state_new();
    if a.keys_down_mask != 0 {
        println("FAIL input_state_new");
        process_exit(1);
    }
    if a.keys_down_mask != b.keys_down_mask {
        println("FAIL input_state_new");
        process_exit(1);
    }
    println("prod_input_manager: PASSED");
}
