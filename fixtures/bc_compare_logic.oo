// # Smoke bytecode compare and
//
// Logline: x > 1 && x < 5 must run on the bytecode interpreter.
//
// Setup: M6 compare plus &&.
//
// Beats:
//   1. Bind x to 3.
//   2. Test the bounds.
//   3. Print 1 when both hold.

pub fn main() {
    let x = 3;
    let ok = x > 1 && x < 5;
    if ok {
        println(1);
    } else {
        println(0);
    }
}
