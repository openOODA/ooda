// # Product prove std/bft_consensus/pbft_watermarks_log.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/pbft_watermarks_log.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/pbft_watermarks_log.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pbft_watermarks_log: PASSED only if they match.

import "std/bft_consensus/pbft_watermarks_log.oo";

pub fn main() {
    let pbft_watermarks_log_a = watermark_window_new(0, 0);
    let pbft_watermarks_log_b = watermark_window_new(0, 0);
    let pbft_watermarks_log_va = watermark_is_in_window(pbft_watermarks_log_a, 0);
    let pbft_watermarks_log_vb = watermark_is_in_window(pbft_watermarks_log_b, 0);
    if pbft_watermarks_log_va != pbft_watermarks_log_vb {
        println("FAIL pbft_watermarks_log");
        process_exit(1);
    }
    println("prod_ap_pbft_watermarks_log: PASSED");
}
