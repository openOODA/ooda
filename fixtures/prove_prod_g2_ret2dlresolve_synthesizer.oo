// # Product prove std/exploit_analysis/ret2dlresolve_synthesizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts dlresolve_structures_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/ret2dlresolve_synthesizer.oo.
//
// Beats:
//   1. Call dlresolve_structures_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ret2dlresolve_synthesizer: PASSED only if they match.

import "std/exploit_analysis/ret2dlresolve_synthesizer.oo";

pub fn main() {
    let ret2dlresolve_synthesizer_mark: Int = 0;
    if ret2dlresolve_synthesizer_mark != 0 {
        process_exit(1);
    }
    let a: DlResolveStructures = dlresolve_structures_new(0, "x", 0, 0, 0, 0, true);
    let b: DlResolveStructures = dlresolve_structures_new(0, "x", 0, 0, 0, 0, true);
    if (a).bss_base_address != (b).bss_base_address {
        println("FAIL dlresolve_structures_new");
        process_exit(1);
    }
    println("prod_g2_ret2dlresolve_synthesizer: PASSED");
}
