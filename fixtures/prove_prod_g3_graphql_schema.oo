// # Product prove std/web_protocols/graphql_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts gql_field_def_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/graphql_schema.oo.
//
// Beats:
//   1. Call gql_field_def_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graphql_schema: PASSED only if they match.

import "std/web_protocols/graphql_schema.oo";

pub fn main() {
    let graphql_schema_mark: Int = 0;
    if graphql_schema_mark != 0 {
        process_exit(1);
    }
    let a: GqlFieldDef = gql_field_def_new(0, 0, 0, 0);
    let b: GqlFieldDef = gql_field_def_new(0, 0, 0, 0);
    if (a).name != (b).name {
        println("FAIL gql_field_def_new");
        process_exit(1);
    }
    println("prod_graphql_schema: PASSED");
}
