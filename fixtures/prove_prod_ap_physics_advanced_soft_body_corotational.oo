// # Product prove std/physics_advanced/soft_body_corotational.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/soft_body_corotational.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_corotational.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_soft_body_corotational: PASSED only if they match.

import "std/physics_advanced/soft_body_corotational.oo";

pub fn main() {
    let soft_body_corotational_a = matrix3x3_identity();
    let soft_body_corotational_b = matrix3x3_identity();
    let soft_body_corotational_va = matrix3x3_determinant(soft_body_corotational_a);
    let soft_body_corotational_vb = matrix3x3_determinant(soft_body_corotational_b);
    if soft_body_corotational_va != soft_body_corotational_vb {
        println("FAIL soft_body_corotational");
        process_exit(1);
    }
    println("prod_ap_soft_body_corotational: PASSED");
}
