// # Product prove std/bft_consensus/round_timeout_pacemaker.oo
//
// Logline: Fail-closed emit+gcc+run asserts pacemaker_timer_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/round_timeout_pacemaker.oo.
//
// Beats:
//   1. Call pacemaker_timer_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_round_timeout_pacemaker: PASSED only if they match.

import "std/bft_consensus/round_timeout_pacemaker.oo";

pub fn main() {
    let round_timeout_pacemaker_mark: Int = 0;
    if round_timeout_pacemaker_mark != 0 {
        process_exit(1);
    }
    let a: PacemakerTimerState = pacemaker_timer_state_new(0, 0);
    let b: PacemakerTimerState = pacemaker_timer_state_new(0, 0);
    if (a).current_round != (b).current_round {
        println("FAIL pacemaker_timer_state_new");
        process_exit(1);
    }
    println("prod_round_timeout_pacemaker: PASSED");
}
