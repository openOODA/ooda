// # Product prove std/fin/hft_signals.oo
//
// Logline: Fail-closed verification that microstructure signals, execution reports, and bullish/bearish signal classifiers are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_signals.oo.
//
// Beats:
//   1. Construct bullish, bearish, and neutral microstructure signals.
//   2. Validate signal strength formula and direction predicates.
//   3. Create execution report and verify fill status calculations.
//   4. Print prod_g4_fin_hft_signals: PASSED and exit 0.

import "std/fin/hft_signals.oo";

pub fn main() {
    let sig_bull_a: MicrostructureSignal = microstructure_signal_create("AAPL", 0.5, 0.4, 0.4, 0.1, 1000000);
    let sig_bull_b: MicrostructureSignal = microstructure_signal_create("AAPL", 0.5, 0.4, 0.4, 0.1, 1000000);
    if (sig_bull_a).order_imbalance != (sig_bull_b).order_imbalance {
        println("FAIL microstructure_signal_create imbalance");
        process_exit(1);
    }
    if (sig_bull_a).signal_strength != (sig_bull_b).signal_strength {
        println("FAIL microstructure_signal_create strength");
        process_exit(1);
    }

    let is_bull_a: Bool = microstructure_signal_is_bullish(&sig_bull_a);
    let is_bull_b: Bool = microstructure_signal_is_bullish(&sig_bull_b);
    if is_bull_a != is_bull_b || !is_bull_a {
        println("FAIL microstructure_signal_is_bullish");
        process_exit(1);
    }

    let neg_imb: Float = 0.0 - 0.5;
    let neg_vwap: Float = 0.0 - 0.4;
    let neg_press: Float = 0.0 - 0.4;
    let sig_bear: MicrostructureSignal = microstructure_signal_create("MSFT", neg_imb, neg_vwap, neg_press, 0.8, 1000001);
    let is_bear: Bool = microstructure_signal_is_bearish(&sig_bear);
    if !is_bear {
        println("FAIL microstructure_signal_is_bearish");
        process_exit(1);
    }

    let rep_full: ExecutionReport = execution_report_create(101, 5001, "AAPL", 1, 100, 15025, 0, 2, 1000002);
    let rep_part: ExecutionReport = execution_report_create(102, 5002, "AAPL", 1, 50, 15025, 50, 2, 1000003);
    if !(rep_full).is_full_fill {
        println("FAIL execution_report full fill");
        process_exit(1);
    }
    if (rep_part).is_full_fill {
        println("FAIL execution_report partial fill");
        process_exit(1);
    }

    println("prod_g4_fin_hft_signals: PASSED");
    process_exit(0);
}
