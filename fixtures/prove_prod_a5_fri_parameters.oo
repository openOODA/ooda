// # Product prove std/zk_rollup/fri_parameters.oo
//
// Logline: Fail-closed emit+gcc+run asserts fri_parameters_100_bits is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_parameters.oo.
//
// Beats:
//   1. Call fri_parameters_100_bits twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fri_parameters: PASSED only if they match.

import "std/zk_rollup/fri_parameters.oo";

pub fn main() {
    let a: FriParameters = fri_parameters_100_bits(0);
    let b: FriParameters = fri_parameters_100_bits(0);
    if (a).blowup_factor != (b).blowup_factor {
        println("FAIL fri_parameters_100_bits");
        process_exit(1);
    }
    println("prod_fri_parameters: PASSED");
}
