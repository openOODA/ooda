// # Product prove std/astrophysics_relativity/relativistic_jets_beaming_doppler.oo
//
// Logline: Fail-closed emit+gcc+run asserts relativistic_lorentz_gamma is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/relativistic_jets_beaming_doppler.oo.
//
// Beats:
//   1. Call relativistic_lorentz_gamma twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_relativistic_jets_beaming_doppler: PASSED only if they match.

import "std/astrophysics_relativity/relativistic_jets_beaming_doppler.oo";

pub fn main() {
    let relativistic_jets_beaming_doppler_mark: Int = 0;
    if relativistic_jets_beaming_doppler_mark != 0 {
        process_exit(1);
    }
    let a: Int = relativistic_lorentz_gamma(0);
    let b: Int = relativistic_lorentz_gamma(0);
    if a != b {
        println("FAIL relativistic_lorentz_gamma");
        process_exit(1);
    }
    println("prod_relativistic_jets_beaming_doppler: PASSED");
}
