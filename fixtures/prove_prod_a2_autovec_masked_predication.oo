// # Product prove std/compilers_polyhedral/autovec_masked_predication.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_predicate_mask_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_masked_predication.oo.
//
// Beats:
//   1. Call vector_predicate_mask_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_masked_predication: PASSED only if they match.

import "std/compilers_polyhedral/autovec_masked_predication.oo";

pub fn main() {
    let autovec_masked_predication_mark: Int = 0;
    if autovec_masked_predication_mark != 0 {
        process_exit(1);
    }
    let a: VectorPredicateMask = vector_predicate_mask_new(0, 0, 0);
    let b: VectorPredicateMask = vector_predicate_mask_new(0, 0, 0);
    if (a).mask_id != (b).mask_id {
        println("FAIL vector_predicate_mask_new");
        process_exit(1);
    }
    println("prod_autovec_masked_predication: PASSED");
}
