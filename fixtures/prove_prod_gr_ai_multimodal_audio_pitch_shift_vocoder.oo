// # Product prove std/ai_multimodal/audio_pitch_shift_vocoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_pitch_ratio_from_semitones is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/audio_pitch_shift_vocoder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call audio_pitch_ratio_from_semitones twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_audio_pitch_shift_vocoder: PASSED only if they match.

import "std/ai_multimodal/audio_pitch_shift_vocoder.oo";

pub fn main() {
    let g0_a = audio_pitch_ratio_from_semitones(0.0);
    let g0_b = audio_pitch_ratio_from_semitones(0.0);
    if g0_a != g0_b {
        println("FAIL audio_pitch_ratio_from_semitones");
        process_exit(1);
    }
    println("prod_gr_audio_pitch_shift_vocoder: PASSED");
}
