// # Product prove std/robotics_ros2/control_sliding_mode_robust.oo
//
// Logline: Fail-closed emit+gcc+run asserts sliding_mode_config_new real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/control_sliding_mode_robust.oo.
//
// Beats:
//   1. Call sliding_mode_config_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_control_sliding_mode_robust: PASSED only if the assert holds.

import "std/robotics_ros2/control_sliding_mode_robust.oo";

pub fn main() {
    let control_sliding_mode_robust_mark: Int = 0;
    if control_sliding_mode_robust_mark != 0 {
        process_exit(1);
    }
    let control_sliding_mode_robust_a: SlidingModeConfig = sliding_mode_config_new(2.0, 2.0, 2.0, 2.0);
    let control_sliding_mode_robust_max_effort: Float = (control_sliding_mode_robust_a).max_effort;
    if !(control_sliding_mode_robust_max_effort == 2.0) {
        println("FAIL sliding_mode_config_new");
        process_exit(1);
    }
    println("prod_control_sliding_mode_robust: PASSED");
}
