// # Product prove std/satellite_dvb/dvb_rcs2_burst_structure.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_rcs2_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_rcs2_burst_structure.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dvb_rcs2_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_dvb_rcs2_burst_structure: PASSED only if they match.

import "std/satellite_dvb/dvb_rcs2_burst_structure.oo";

pub fn main() {
    let g0_a = dvb_rcs2_int_to_float(2);
    let g0_b = dvb_rcs2_int_to_float(2);
    if g0_a != g0_b {
        println("FAIL dvb_rcs2_int_to_float");
        process_exit(1);
    }
    println("prod_g0_dvb_rcs2_burst_structure: PASSED");
}
