// # Product prove std/physics_advanced/ragdoll_joint_hinge_revolute.oo
//
// Logline: Fail-closed emit+gcc+run asserts hinge_joint_knee is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/ragdoll_joint_hinge_revolute.oo.
//
// Beats:
//   1. Call hinge_joint_knee twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ragdoll_joint_hinge_revolute: PASSED only if they match.

import "std/physics_advanced/ragdoll_joint_hinge_revolute.oo";

pub fn main() {
    let ragdoll_joint_hinge_revolute_mark: Int = 0;
    if ragdoll_joint_hinge_revolute_mark != 0 {
        process_exit(1);
    }
    let a: HingeJoint = hinge_joint_knee();
    let b: HingeJoint = hinge_joint_knee();
    if (a).hinge_axis_x != (b).hinge_axis_x {
        println("FAIL hinge_joint_knee");
        process_exit(1);
    }
    println("prod_ragdoll_joint_hinge_revolute: PASSED");
}
