// # Product prove std/graph_networks/bloom_filter_counting.oo
//
// Logline: Fail-closed emit+gcc+run asserts cbf_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/bloom_filter_counting.oo.
//
// Beats:
//   1. Call cbf_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bloom_filter_counting: PASSED only if they match.

import "std/graph_networks/bloom_filter_counting.oo";

pub fn main() {
    let a: CountingBloomFilter = cbf_create(0, 0);
    let b: CountingBloomFilter = cbf_create(0, 0);
    if a.num_cells != b.num_cells {
        println("FAIL cbf_create");
        process_exit(1);
    }
    println("prod_bloom_filter_counting: PASSED");
}
