// # Product prove std/db_graph/graph_triangle_counting.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_local_clustering is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_triangle_counting.oo.
//
// Beats:
//   1. Call compute_local_clustering twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_triangle_counting: PASSED only if they match.

import "std/db_graph/graph_triangle_counting.oo";

pub fn main() {
    let graph_triangle_counting_mark: Int = 0;
    if graph_triangle_counting_mark != 0 {
        process_exit(1);
    }
    let a: Float = compute_local_clustering(0.0, 0.0);
    let b: Float = compute_local_clustering(0.0, 0.0);
    if a != b {
        println("FAIL compute_local_clustering");
        process_exit(1);
    }
    println("prod_graph_triangle_counting: PASSED");
}
