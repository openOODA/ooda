// # Product prove std/security_defense/rop_gadget_destroyer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rop_gadget_destroyer_scan_and_pad is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/rop_gadget_destroyer.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call rop_gadget_destroyer_scan_and_pad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_rop_gadget_destroyer: PASSED only if they match.

import "std/security_defense/rop_gadget_destroyer.oo";

pub fn main() {
    let mut g0_oa: BytecodeBuffer = BytecodeBuffer { bytes: list_new(), length: 0, gadgets_neutralized: 0 };
    let mut g0_ob: BytecodeBuffer = BytecodeBuffer { bytes: list_new(), length: 0, gadgets_neutralized: 0 };
    let g0_a = rop_gadget_destroyer_scan_and_pad(&g0_oa);
    let g0_b = rop_gadget_destroyer_scan_and_pad(&g0_ob);
    if g0_a != g0_b {
        println("FAIL rop_gadget_destroyer_scan_and_pad");
        process_exit(1);
    }
    println("prod_gr_rop_gadget_destroyer: PASSED");
}
