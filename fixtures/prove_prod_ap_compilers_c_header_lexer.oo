// # Product prove std/compilers/c_header_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/c_header_lexer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_lexer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_c_header_lexer: PASSED only if they match.

import "std/compilers/c_header_lexer.oo";

pub fn main() {
    let c_header_lexer_a = c_tok_eof();
    let c_header_lexer_b = c_tok_eof();
    if c_header_lexer_a != c_header_lexer_b {
        println("FAIL c_header_lexer");
        process_exit(1);
    }
    println("prod_ap_c_header_lexer: PASSED");
}
