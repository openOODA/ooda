// # Product prove std/tui/tui_renderer.oo
//
// Logline: Fail-closed emit+check asserts tui_render_ansi_move_to is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/tui_renderer.oo.
//
// Beats:
//   1. Call tui_render_ansi_move_to twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tui_renderer: PASSED only if they match.

import "std/tui/tui_renderer.oo";

pub fn main() {
    let tui_renderer_mark: Int = 0;
    if tui_renderer_mark != 0 { process_exit(1); }
    let a: String = tui_render_ansi_move_to(1, 2);
    let b: String = tui_render_ansi_move_to(1, 2);
    if a != b { process_exit(1); }
    println("prod_tui_renderer: PASSED");
}
