// # Product prove std/gis_topo/kdtree_3d_spatial.oo
//
// Logline: Fail-closed emit+gcc+run asserts kd_next_axis is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/kdtree_3d_spatial.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call kd_next_axis twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kdtree_3d_spatial: PASSED only if they match.

import "std/gis_topo/kdtree_3d_spatial.oo";

pub fn main() {
    let g2_a = kd_next_axis(2);
    let g2_b = kd_next_axis(2);
    if g2_a != g2_b {
        println("FAIL kd_next_axis");
        process_exit(1);
    }
    println("prod_g2_kdtree_3d_spatial: PASSED");
}
