// # Product prove std/fin/hft_latency.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/hft_latency.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_latency.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hft_latency: PASSED only if they match.

import "std/fin/hft_latency.oo";

pub fn main() {
    let hft_latency_a = latency_metrics_init();
    let hft_latency_b = latency_metrics_init();
    let hft_latency_va = latency_metrics_total_pipeline_ns(hft_latency_a);
    let hft_latency_vb = latency_metrics_total_pipeline_ns(hft_latency_b);
    if hft_latency_va != hft_latency_vb {
        println("FAIL hft_latency");
        process_exit(1);
    }
    println("prod_ap_hft_latency: PASSED");
}
