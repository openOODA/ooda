// # Product prove std/space_propulsion/rocket_thrust_vector_control.oo
//
// Logline: Fail-closed emit+gcc+run asserts tvc_gimbal_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_thrust_vector_control.oo.
//
// Beats:
//   1. Call tvc_gimbal_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rocket_thrust_vector_control: PASSED only if asserts hold.

import "std/space_propulsion/rocket_thrust_vector_control.oo";

pub fn main() {
    let rocket_thrust_vector_control: TvcGimbalSpec = tvc_gimbal_spec_default();
    let rocket_thrust_vector_control_b: TvcGimbalSpec = tvc_gimbal_spec_default();
    if (rocket_thrust_vector_control).thrust_nominal_n != 2200000.0 {
        println("FAIL tvc_gimbal_spec_default thrust_nominal_n");
        process_exit(1);
    }
    if (rocket_thrust_vector_control).thrust_nominal_n != (rocket_thrust_vector_control_b).thrust_nominal_n {
        println("FAIL tvc_gimbal_spec_default det");
        process_exit(1);
    }
    println("prod_rocket_thrust_vector_control: PASSED");
}
