// # Product prove std/db_storage/mvcc_in_memory_catalog.oo
//
// Logline: Fail-closed emit+gcc+run asserts column_meta_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_in_memory_catalog.oo.
//
// Beats:
//   1. Call column_meta_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_in_memory_catalog: PASSED only if they match.

import "std/db_storage/mvcc_in_memory_catalog.oo";

pub fn main() {
    let mvcc_in_memory_catalog_mark: Int = 0;
    if mvcc_in_memory_catalog_mark != 0 {
        process_exit(1);
    }
    let a: ColumnMeta = column_meta_new("x", "x", true, 0);
    let b: ColumnMeta = column_meta_new("x", "x", true, 0);
    if (a).column_index != (b).column_index {
        println("FAIL column_meta_new");
        process_exit(1);
    }
    println("prod_mvcc_in_memory_catalog: PASSED");
}
