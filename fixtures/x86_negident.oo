// # emit-x86 unary-minus ident print
//
// Logline: Bind n to 7 and print -n so emit-x86 can lower unary minus of a same-fn int ident.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. Bind n to 7.
//   3. Print unary minus of n.
//
// residual: general ALU stays later.

pub fn main() {
    let n = 7;
    println(-n);
}
