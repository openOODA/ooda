// # Product prove std/bft_consensus/hotstuff_chained_vote.oo
//
// Logline: Fail-closed emit+gcc+run asserts vote_accumulator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_chained_vote.oo.
//
// Beats:
//   1. Call vote_accumulator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hotstuff_chained_vote: PASSED only if they match.

import "std/bft_consensus/hotstuff_chained_vote.oo";

pub fn main() {
    let hotstuff_chained_vote_mark: Int = 0;
    if hotstuff_chained_vote_mark != 0 {
        process_exit(1);
    }
    let a: VoteAccumulator = vote_accumulator_new(0, "x", 0);
    let b: VoteAccumulator = vote_accumulator_new(0, "x", 0);
    if (a).view != (b).view {
        println("FAIL vote_accumulator_new");
        process_exit(1);
    }
    println("prod_g2_hotstuff_chained_vote: PASSED");
}
