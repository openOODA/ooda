// # Product prove std/astro_advanced/link_budget_shannon.oo
//
// Logline: Fail-closed emit+gcc+run asserts shannon_snr_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/link_budget_shannon.oo.
//
// Beats:
//   1. Call shannon_snr_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_link_budget_shannon: PASSED only if they match.

import "std/astro_advanced/link_budget_shannon.oo";

pub fn main() {
    let link_budget_shannon_mark: Int = 0;
    if link_budget_shannon_mark != 0 {
        process_exit(1);
    }
    let a: Int = shannon_snr_db();
    let b: Int = shannon_snr_db();
    if a != b {
        println("FAIL shannon_snr_db");
        process_exit(1);
    }
    println("prod_link_budget_shannon: PASSED");
}
