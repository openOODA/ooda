// # Product prove std/quantum_tensor_nets/peps_2d_tensor_network.oo
//
// Logline: Fail-closed emit+gcc+run asserts peps_node_entry_5d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_2d_tensor_network.oo.
//
// Beats:
//   1. Call peps_node_entry_5d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_peps_2d_tensor_network: PASSED only if they match.

import "std/quantum_tensor_nets/peps_2d_tensor_network.oo";

pub fn main() {
    let peps_2d_tensor_network_mark: Int = 0;
    if peps_2d_tensor_network_mark != 0 {
        process_exit(1);
    }
    let a: PepsNodeEntry5D = peps_node_entry_5d_new(0, 0, 0, 0, 0, 0.0);
    let b: PepsNodeEntry5D = peps_node_entry_5d_new(0, 0, 0, 0, 0, 0.0);
    if (a).phys != (b).phys {
        println("FAIL peps_node_entry_5d_new");
        process_exit(1);
    }
    println("prod_g2_peps_2d_tensor_network: PASSED");
}
