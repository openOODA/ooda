// # Product prove std/crypto/zkp_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/zkp_math.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_math.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zkp_math: PASSED only if they match.

import "std/crypto/zkp_math.oo";

pub fn main() {
    let zkp_math_a = zkp_mod_pow(0, 0, 0);
    let zkp_math_b = zkp_mod_pow(0, 0, 0);
    if zkp_math_a != zkp_math_b {
        println("FAIL zkp_math");
        process_exit(1);
    }
    println("prod_ap_zkp_math: PASSED");
}
