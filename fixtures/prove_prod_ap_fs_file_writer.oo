// # Product prove std/fs/file_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fs/file_writer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/file_writer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_file_writer: PASSED only if they match.

import "std/fs/file_writer.oo";

pub fn main() {
    let file_writer_a = file_writer_open("x", true);
    let file_writer_b = file_writer_open("x", true);
    let file_writer_va = file_writer_bytes_written(file_writer_a);
    let file_writer_vb = file_writer_bytes_written(file_writer_b);
    if file_writer_va != file_writer_vb {
        println("FAIL file_writer");
        process_exit(1);
    }
    println("prod_ap_file_writer: PASSED");
}
