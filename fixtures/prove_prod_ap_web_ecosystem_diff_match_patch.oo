// # Product prove std/web_ecosystem/diff_match_patch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/diff_match_patch.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/diff_match_patch.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diff_match_patch: PASSED only if they match.

import "std/web_ecosystem/diff_match_patch.oo";

pub fn main() {
    let diff_match_patch_a = diff_chunk_equal();
    let diff_match_patch_b = diff_chunk_equal();
    if diff_match_patch_a != diff_match_patch_b {
        println("FAIL diff_match_patch");
        process_exit(1);
    }
    println("prod_ap_diff_match_patch: PASSED");
}
