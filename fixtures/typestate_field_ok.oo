// # Field-stored typestate sock
//
// Logline: Store a sock on a Box field, connect it, and send through the field.
//
// Beats:
//   1. Open a Closed sock into p.s.
//   2. Connect the field handle.
//   3. Send on the same field.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

type Box = struct { s: Int }

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let mut p = Box { s: 0 };
    p.s = open_sock();
    connect(p.s);
    send(p.s);
}
