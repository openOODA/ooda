// # Product prove std/quantum_open_systems/bath_correlation_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/bath_correlation_functions.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/bath_correlation_functions.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bath_correlation_functions: PASSED only if they match.

import "std/quantum_open_systems/bath_correlation_functions.oo";

pub fn main() {
    let bath_correlation_functions_a = bath_thermal_correlation_time(0.0);
    let bath_correlation_functions_b = bath_thermal_correlation_time(0.0);
    if bath_correlation_functions_a != bath_correlation_functions_b {
        println("FAIL bath_correlation_functions");
        process_exit(1);
    }
    println("prod_ap_bath_correlation_functions: PASSED");
}
