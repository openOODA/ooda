// # Product prove std/robotics_ros2/dynamics_featherstone_rnea.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_vec_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/dynamics_featherstone_rnea.oo.
//
// Beats:
//   1. Call spatial_vec_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dynamics_featherstone_rnea: PASSED only if they match.

import "std/robotics_ros2/dynamics_featherstone_rnea.oo";

pub fn main() {
    let dynamics_featherstone_rnea_mark: Int = 0;
    if dynamics_featherstone_rnea_mark != 0 {
        process_exit(1);
    }
    let a: SpatialVector6D = spatial_vec_zero();
    let b: SpatialVector6D = spatial_vec_zero();
    if (a).wx != (b).wx {
        println("FAIL spatial_vec_zero");
        process_exit(1);
    }
    println("prod_g2_dynamics_featherstone_rnea: PASSED");
}
