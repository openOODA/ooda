// # Product sync actor cell prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/actor_cell.oo.
//
// Setup: Product std/sync/actor_cell.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New cell is not active. record_msg stays inactive.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/actor_cell.oo";

pub fn main() {
    let c: ActorCell = actor_cell_new(7);
    if actor_cell_is_active(c) {
        println("FAIL actcell active");
        process_exit(1);
    }
    let c2: ActorCell = actor_cell_record_msg(c);
    if actor_cell_is_active(c2) {
        println("FAIL actcell rec");
        process_exit(1);
    }
    println("prod_actcell: PASSED");
}
