// # Product prove std/diag/logger_structured_json.oo
//
// Logline: Fail-closed emit+gcc+run asserts log_json_format is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/logger_structured_json.oo.
//
// Beats:
//   1. Call log_json_format twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_logger_structured_json: PASSED only if they match.

import "std/diag/logger_structured_json.oo";

pub fn main() {
    let a = log_json_format("x", "x", "x");
    let b = log_json_format("x", "x", "x");
    if a != b {
        println("FAIL log_json_format");
        process_exit(1);
    }
    println("prod_logger_structured_json: PASSED");
}
