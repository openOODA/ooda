// # Product prove std/hft_alpha/mm_avellaneda_stoikov_ode.oo
//
// Logline: Fail-closed emit+gcc+run asserts as_is_inventory_at_limit is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_avellaneda_stoikov_ode.oo.
//
// Beats:
//   1. Call as_is_inventory_at_limit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_avellaneda_stoikov_ode: PASSED only if they match.

import "std/hft_alpha/mm_avellaneda_stoikov_ode.oo";

pub fn main() {
    let mm_avellaneda_stoikov_ode_mark: Int = 0;
    if mm_avellaneda_stoikov_ode_mark != 0 {
        process_exit(1);
    }
    let a: Bool = as_is_inventory_at_limit(0.0, 0.0);
    let b: Bool = as_is_inventory_at_limit(0.0, 0.0);
    if a != b {
        println("FAIL as_is_inventory_at_limit");
        process_exit(1);
    }
    println("prod_mm_avellaneda_stoikov_ode: PASSED");
}
