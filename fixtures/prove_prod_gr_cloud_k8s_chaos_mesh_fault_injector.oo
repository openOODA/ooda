// # Product prove std/cloud_k8s/chaos_mesh_fault_injector.oo
//
// Logline: Fail-closed emit+gcc+run asserts chaos_should_drop_packet is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/chaos_mesh_fault_injector.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chaos_should_drop_packet twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_chaos_mesh_fault_injector: PASSED only if they match.

import "std/cloud_k8s/chaos_mesh_fault_injector.oo";

pub fn main() {
    let g0_oa: ChaosExperiment = ChaosExperiment { name: "x", action: 0, target_selector: "x", latency_ms: 0, jitter_ms: 0, drop_percent: 0, duration_sec: 0, is_active: true };
    let g0_ob: ChaosExperiment = ChaosExperiment { name: "x", action: 0, target_selector: "x", latency_ms: 0, jitter_ms: 0, drop_percent: 0, duration_sec: 0, is_active: true };
    let g0_a = chaos_should_drop_packet(&g0_oa, 0);
    let g0_b = chaos_should_drop_packet(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL chaos_should_drop_packet");
        process_exit(1);
    }
    println("prod_gr_chaos_mesh_fault_injector: PASSED");
}
