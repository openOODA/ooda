// # Product prove std/nerf_3dgs/gaussian_radix_sort_depth.oo
//
// Logline: Fail-closed emit+gcc+run asserts float_to_sortable_int is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_radix_sort_depth.oo.
//
// Beats:
//   1. Call float_to_sortable_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gaussian_radix_sort_depth: PASSED only if they match.

import "std/nerf_3dgs/gaussian_radix_sort_depth.oo";

pub fn main() {
    let gaussian_radix_sort_depth_mark: Int = 0;
    if gaussian_radix_sort_depth_mark != 0 {
        process_exit(1);
    }
    let a: Int = float_to_sortable_int(0.0);
    let b: Int = float_to_sortable_int(0.0);
    if a != b {
        println("FAIL float_to_sortable_int");
        process_exit(1);
    }
    println("prod_g2_gaussian_radix_sort_depth: PASSED");
}
