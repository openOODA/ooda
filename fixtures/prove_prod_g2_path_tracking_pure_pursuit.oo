// # Product prove std/auto_mpc_control/path_tracking_pure_pursuit.oo
//
// Logline: Fail-closed emit+gcc+run asserts pure_pursuit_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/path_tracking_pure_pursuit.oo.
//
// Beats:
//   1. Call pure_pursuit_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_path_tracking_pure_pursuit: PASSED only if they match.

import "std/auto_mpc_control/path_tracking_pure_pursuit.oo";

pub fn main() {
    let path_tracking_pure_pursuit_mark: Int = 0;
    if path_tracking_pure_pursuit_mark != 0 {
        process_exit(1);
    }
    let a: PurePursuitConfig = pure_pursuit_config_default();
    let b: PurePursuitConfig = pure_pursuit_config_default();
    if (a).k_lookahead != (b).k_lookahead {
        println("FAIL pure_pursuit_config_default");
        process_exit(1);
    }
    println("prod_g2_path_tracking_pure_pursuit: PASSED");
}
