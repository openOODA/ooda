// # Product prove std/astro_advanced/orbit_determination_gauss.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/orbit_determination_gauss.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/orbit_determination_gauss.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbit_determination_gauss: PASSED only if they match.

import "std/astro_advanced/orbit_determination_gauss.oo";

pub fn main() {
    let orbit_determination_gauss_a = od_gauss_obs();
    let orbit_determination_gauss_b = od_gauss_obs();
    if orbit_determination_gauss_a != orbit_determination_gauss_b {
        println("FAIL orbit_determination_gauss");
        process_exit(1);
    }
    println("prod_ap_orbit_determination_gauss: PASSED");
}
