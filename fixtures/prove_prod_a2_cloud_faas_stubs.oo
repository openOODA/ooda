// # Product prove std/cloud_faas/cloud_faas_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts cloud_faas_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/cloud_faas_stubs.oo.
//
// Beats:
//   1. Call cloud_faas_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cloud_faas_stubs: PASSED only if they match.

import "std/cloud_faas/cloud_faas_stubs.oo";

pub fn main() {
    let cloud_faas_stubs_mark: Int = 0;
    if cloud_faas_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cloud_faas_fail_closed("x", 0);
    let b: Bool = cloud_faas_fail_closed("x", 0);
    if a != b {
        println("FAIL cloud_faas_fail_closed");
        process_exit(1);
    }
    println("prod_cloud_faas_stubs: PASSED");
}
