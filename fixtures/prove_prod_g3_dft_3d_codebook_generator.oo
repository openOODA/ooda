// # Product prove std/telecom_6g/dft_3d_codebook_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts dft_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/dft_3d_codebook_generator.oo.
//
// Beats:
//   1. Call dft_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dft_3d_codebook_generator: PASSED only if they match.

import "std/telecom_6g/dft_3d_codebook_generator.oo";

pub fn main() {
    let dft_3d_codebook_generator_mark: Int = 0;
    if dft_3d_codebook_generator_mark != 0 {
        process_exit(1);
    }
    let a: Float = dft_int_to_float(0);
    let b: Float = dft_int_to_float(0);
    if a != b {
        println("FAIL dft_int_to_float");
        process_exit(1);
    }
    println("prod_dft_3d_codebook_generator: PASSED");
}
