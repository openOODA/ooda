// # Patch a flat tensor
//
// Logline: Build a six-zero list, write indices 1 and 5, and print those cells plus length.
//
// Setup: Test fixture. Keep all code exact.
//
// Beats:
//   1. Fill a six-slot list with zeros.
//   2. Copy it while writing 7 and 9 at 1 and 5.
//   3. Print those cells, slot 0, and length.
//
// M166 path A: flat List[Int] row-major tensor helpers
pub fn main() {
    let mut t: List[Int] = list_new();
    let mut i = 0;
    while i < 6 {
        t = list_push(t, 0);
        i = i + 1;
    }
    // set indices 1 and 5
    let mut out: List[Int] = list_new();
    let n = list_len(t);
    let mut j = 0;
    while j < n {
        if j == 1 {
            out = list_push(out, 7);
        } else {
            if j == 5 {
                out = list_push(out, 9);
            } else {
                out = list_push(out, list_get(t, j));
            }
        }
        j = j + 1;
    }
    println(list_get(out, 1));
    println(list_get(out, 5));
    println(list_get(out, 0));
    println(list_len(out));
}
