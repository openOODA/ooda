// # Product prove std/quantum_open_systems/husimi_q_function_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts husimi_vacuum_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/husimi_q_function_dynamics.oo.
//
// Beats:
//   1. Call husimi_vacuum_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_husimi_q_function_dynamics: PASSED only if they match.

import "std/quantum_open_systems/husimi_q_function_dynamics.oo";

pub fn main() {
    let husimi_q_function_dynamics_mark: Int = 0;
    if husimi_q_function_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Float = husimi_vacuum_eval(0.0, 0.0);
    let b: Float = husimi_vacuum_eval(0.0, 0.0);
    if a != b {
        println("FAIL husimi_vacuum_eval");
        process_exit(1);
    }
    println("prod_husimi_q_function_dynamics: PASSED");
}
