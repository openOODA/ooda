// # Product prove std/tda_topology/zigzag_persistence_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts zigzag_interval_length is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/zigzag_persistence_core.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call zigzag_interval_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_zigzag_persistence_core: PASSED only if they match.

import "std/tda_topology/zigzag_persistence_core.oo";

pub fn main() {
    let g0_oa = zigzag_interval_new(0, 0, 0, 0);
    let g0_ob = zigzag_interval_new(0, 0, 0, 0);
    let g0_a = zigzag_interval_length(&g0_oa);
    let g0_b = zigzag_interval_length(&g0_ob);
    if g0_a != g0_b {
        println("FAIL zigzag_interval_length");
        process_exit(1);
    }
    println("prod_gr_zigzag_persistence_core: PASSED");
}
