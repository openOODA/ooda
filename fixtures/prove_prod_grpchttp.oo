// # Product cloud_k8s grpc http map prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud_k8s/grpc_status_codes.oo.
//
// Setup: Product std/cloud_k8s/grpc_status_codes.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. code 0 -> 200. 5 -> 404. 14 -> 503. unknown 9 -> 500.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud_k8s/grpc_status_codes.oo";

pub fn main() {
    let a: Int = grpc_status_to_http(0);
    if a != 200 {
        println("FAIL grpc 200");
        process_exit(1);
    }
    let b: Int = grpc_status_to_http(5);
    if b != 404 {
        println("FAIL grpc 404");
        process_exit(1);
    }
    let c: Int = grpc_status_to_http(14);
    if c != 503 {
        println("FAIL grpc 503");
        process_exit(1);
    }
    let d: Int = grpc_status_to_http(9);
    if d != 500 {
        println("FAIL grpc 500");
        process_exit(1);
    }
    println("prod_grpchttp: PASSED");
}
