// # Product prove std/physics/collision_contacts.oo
//
// Logline: Fail-closed emit+gcc+run asserts collision_contacts_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/physics/collision_contacts.oo.
//
// Beats:
//   1. Call collision_contacts_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_collision_contacts: PASSED only if it matches.

import "std/physics/collision_contacts.oo";

pub fn main() {
    let a: Int = collision_contacts_probe();
    if a != 0 {
        println("FAIL collision_contacts_probe");
        process_exit(1);
    }
    println("prod_nc_collision_contacts: PASSED");
}
