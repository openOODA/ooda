// # Product prove std/space_propulsion/launch_abort_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts launch_abort_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/launch_abort_envelope.oo.
//
// Beats:
//   1. Call launch_abort_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_launch_abort_envelope: PASSED only if asserts hold.

import "std/space_propulsion/launch_abort_envelope.oo";

pub fn main() {
    let launch_abort_envelope: LaunchAbortSpec = launch_abort_spec_default();
    let launch_abort_envelope_b: LaunchAbortSpec = launch_abort_spec_default();
    if (launch_abort_envelope).capsule_mass_kg != 10500.0 {
        println("FAIL launch_abort_spec_default capsule_mass_kg");
        process_exit(1);
    }
    if (launch_abort_envelope).capsule_mass_kg != (launch_abort_envelope_b).capsule_mass_kg {
        println("FAIL launch_abort_spec_default det");
        process_exit(1);
    }
    println("prod_launch_abort_envelope: PASSED");
}
