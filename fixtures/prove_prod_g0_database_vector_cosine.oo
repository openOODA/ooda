// # Product prove std/database/vector_cosine.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_isqrt is a real value.
//
// Setup: Isolated emit-c. Imports std/database/vector_cosine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call vector_isqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_vector_cosine: PASSED only if they match.

import "std/database/vector_cosine.oo";

pub fn main() {
    let g0_a = vector_isqrt(2);
    let g0_b = vector_isqrt(2);
    if g0_a != g0_b {
        println("FAIL vector_isqrt");
        process_exit(1);
    }
    println("prod_g0_vector_cosine: PASSED");
}
