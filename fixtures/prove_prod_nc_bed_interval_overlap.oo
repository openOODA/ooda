// # Product prove std/bio_advanced/bed_interval_overlap.oo
//
// Logline: Fail-closed emit+gcc+run asserts bed_interval_overlap_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/bed_interval_overlap.oo.
//
// Beats:
//   1. Call bed_interval_overlap_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bed_interval_overlap: PASSED only if it matches.

import "std/bio_advanced/bed_interval_overlap.oo";

pub fn main() {
    let a: Int = bed_interval_overlap_probe();
    if a != 0 {
        println("FAIL bed_interval_overlap_probe");
        process_exit(1);
    }
    println("prod_nc_bed_interval_overlap: PASSED");
}
