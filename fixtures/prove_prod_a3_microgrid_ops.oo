// # Product prove std/grid/microgrid_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts microgrid_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_ops.oo.
//
// Beats:
//   1. Call microgrid_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_microgrid_ops: PASSED only if they match.

import "std/grid/microgrid_ops.oo";

pub fn main() {
    let microgrid_ops_mark: Int = 0;
    if microgrid_ops_mark != 0 {
        process_exit(1);
    }
    let a: Float = microgrid_abs(0.0);
    let b: Float = microgrid_abs(0.0);
    if a != b {
        println("FAIL microgrid_abs");
        process_exit(1);
    }
    println("prod_microgrid_ops: PASSED");
}
