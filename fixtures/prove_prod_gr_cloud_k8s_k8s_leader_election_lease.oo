// # Product prove std/cloud_k8s/k8s_leader_election_lease.oo
//
// Logline: Fail-closed emit+gcc+run asserts k8s_lease_is_expired is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/k8s_leader_election_lease.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call k8s_lease_is_expired twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_k8s_leader_election_lease: PASSED only if they match.

import "std/cloud_k8s/k8s_leader_election_lease.oo";

pub fn main() {
    let g0_oa: K8sLease = K8sLease { name: "x", namespace: "x", holder_identity: "x", lease_duration_seconds: 0, acquire_time_ms: 0, renew_time_ms: 0, lease_transitions: 0 };
    let g0_ob: K8sLease = K8sLease { name: "x", namespace: "x", holder_identity: "x", lease_duration_seconds: 0, acquire_time_ms: 0, renew_time_ms: 0, lease_transitions: 0 };
    let g0_a = k8s_lease_is_expired(&g0_oa, 0);
    let g0_b = k8s_lease_is_expired(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL k8s_lease_is_expired");
        process_exit(1);
    }
    println("prod_gr_k8s_leader_election_lease: PASSED");
}
