// # Product prove std/perf/cpu_timer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/cpu_timer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/cpu_timer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cpu_timer: PASSED only if they match.

import "std/perf/cpu_timer.oo";

pub fn main() {
    let cpu_timer_a = cpu_timer_create("x");
    let cpu_timer_b = cpu_timer_create("x");
    let cpu_timer_va = cpu_timer_is_running(cpu_timer_a);
    let cpu_timer_vb = cpu_timer_is_running(cpu_timer_b);
    if cpu_timer_va != cpu_timer_vb {
        println("FAIL cpu_timer");
        process_exit(1);
    }
    println("prod_ap_cpu_timer: PASSED");
}
