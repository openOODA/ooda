// # Product prove std/auto/behavior.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/behavior.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_behavior: PASSED only if they match.

import "std/auto/behavior.oo";

pub fn main() {
    let behavior_a = shim_marker_status_success();
    let behavior_b = shim_marker_status_success();
    if behavior_a != behavior_b {
        println("FAIL behavior");
        process_exit(1);
    }
    println("prod_ap_behavior: PASSED");
}
