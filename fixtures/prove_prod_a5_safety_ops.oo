// # Product prove std/robot/safety_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts safety_clamp_speed is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/safety_ops.oo.
//
// Beats:
//   1. Call safety_clamp_speed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_safety_ops: PASSED only if they match.

import "std/robot/safety_ops.oo";

pub fn main() {
    let safety_ops_mark: Int = 0;
    if safety_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = safety_clamp_speed(0, 0);
    let b: Int = safety_clamp_speed(0, 0);
    if a != b {
        println("FAIL safety_clamp_speed");
        process_exit(1);
    }
    println("prod_safety_ops: PASSED");
}
