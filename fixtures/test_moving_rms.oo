// # Moving RMS adversarial suite
//
// Logline: Updates a sliding RMS incrementally and matches a full-window RMS on the same samples.
//
// Setup: Pure. Imports moving_rms.oo. Run from ooda/.
//
// Beats:
//   1. Push three samples into a window of capacity 3.
//   2. Push a fourth sample, dropping the first.
//   3. Match the incremental RMS to moving_rms_of on the live window.

import "std/media_dsp/moving_rms.oo";

pub fn main() {
    let a: RmsOut = moving_rms_step(0.0, 0, 3, 3.0, 0.0);
    let b: RmsOut = moving_rms_step(a.sumsq, a.n, 3, 4.0, 0.0);
    let c: RmsOut = moving_rms_step(b.sumsq, b.n, 3, 12.0, 0.0);
    if c.flag < 1 {
        println("FAIL fill " + c.err);
        process_exit(1);
    }
    let mut win: List[Float] = list_new();
    win = list_push(win, 3.0);
    win = list_push(win, 4.0);
    win = list_push(win, 12.0);
    let full: RmsOut = moving_rms_of(win);
    let mut d: Float = c.rms - full.rms;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.0001 {
        println("FAIL first window");
        process_exit(1);
    }
    let e: RmsOut = moving_rms_step(c.sumsq, c.n, 3, 0.0, 3.0);
    let mut win2: List[Float] = list_new();
    win2 = list_push(win2, 4.0);
    win2 = list_push(win2, 12.0);
    win2 = list_push(win2, 0.0);
    let full2: RmsOut = moving_rms_of(win2);
    let mut d2: Float = e.rms - full2.rms;
    if d2 < 0.0 {
        d2 = 0.0 - d2;
    }
    if d2 > 0.0001 {
        println("FAIL slide");
        process_exit(1);
    }
    println("sliding result matches a full-window check on the same samples");
    println("ring update is incremental");
    let st: Result[Int, String] = moving_rms_stat(e.flag, e.err);
    if st.is_err() {
        println("FAIL stat");
        process_exit(1);
    }
    println("SUITE PASSED");
    println("test_moving_rms: PASSED");
}
