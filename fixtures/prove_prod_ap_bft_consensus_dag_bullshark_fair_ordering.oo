// # Product prove std/bft_consensus/dag_bullshark_fair_ordering.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/dag_bullshark_fair_ordering.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_bullshark_fair_ordering.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dag_bullshark_fair_ordering: PASSED only if they match.

import "std/bft_consensus/dag_bullshark_fair_ordering.oo";

pub fn main() {
    let dag_bullshark_fair_ordering_a = bullshark_is_leader_round(0);
    let dag_bullshark_fair_ordering_b = bullshark_is_leader_round(0);
    if dag_bullshark_fair_ordering_a != dag_bullshark_fair_ordering_b {
        println("FAIL dag_bullshark_fair_ordering");
        process_exit(1);
    }
    println("prod_ap_dag_bullshark_fair_ordering: PASSED");
}
