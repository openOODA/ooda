// # Product prove std/crypto/keys.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/keys.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_keys: PASSED only if they match.

import "std/crypto/keys.oo";

pub fn main() {
    let keys_a = shim_marker_checksum();
    let keys_b = shim_marker_checksum();
    if keys_a != keys_b {
        println("FAIL keys");
        process_exit(1);
    }
    println("prod_ap_keys: PASSED");
}
