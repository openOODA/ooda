// # Product prove std/robotics_auv/pure_pursuit_underwater.oo
//
// Logline: Fail-closed emit+gcc+run asserts pure_pursuit_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/pure_pursuit_underwater.oo.
//
// Beats:
//   1. Call pure_pursuit_config_default using the pure_pursuit_underwater ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_pure_pursuit_underwater: PASSED only if asserts hold.

import "std/robotics_auv/pure_pursuit_underwater.oo";

pub fn main() {
    let obj = pure_pursuit_config_default();
    let pure_pursuit_underwater_a = obj.min_lookahead_m;
    if pure_pursuit_underwater_a != 5.0 {
        println("FAIL pure_pursuit_config_default");
        process_exit(1);
    }
    println("prod_pure_pursuit_underwater: PASSED");
}
