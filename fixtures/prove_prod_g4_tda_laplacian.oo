// # Product prove std/tda_topology/persistent_laplacian_spectra.oo
//
// Logline: Fail-closed verification that persistent Laplacian operators and spectral structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistent_laplacian_spectra.oo.
//
// Beats:
//   1. Construct persistent Laplacian matrix structures.
//   2. Validate dimension, filtration, and spectral parameters.
//   3. Assert deterministic return values.
//   4. Print prod_g4_tda_laplacian: PASSED and exit 0.

import "std/tda_topology/persistent_laplacian_spectra.oo";

pub fn main() {
    let a: PersistentLaplacian = persistent_laplacian_new(1, 0.5, 3);
    let b: PersistentLaplacian = persistent_laplacian_new(1, 0.5, 3);

    if (a).k_dimension != (b).k_dimension || (a).k_dimension != 1 {
        println("FAIL persistent_laplacian_new k_dimension");
        process_exit(1);
    }

    if (a).filtration_p != (b).filtration_p || (a).filtration_p != 0.5 {
        println("FAIL persistent_laplacian_new filtration_p");
        process_exit(1);
    }

    if (a).harmonic_betti_dim != (b).harmonic_betti_dim || (a).harmonic_betti_dim != 0 {
        println("FAIL persistent_laplacian_new harmonic_betti_dim");
        process_exit(1);
    }

    if (a).spectral_gap != (b).spectral_gap || (a).spectral_gap != 0.0 {
        println("FAIL persistent_laplacian_new spectral_gap");
        process_exit(1);
    }

    println("prod_g4_tda_laplacian: PASSED");
    process_exit(0);
}
