// # Product prove std/exploit_analysis/pie_base_leak_resolver.oo
//
// Logline: Fail-closed emit+gcc+run asserts pie_base_leak_resolver_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/pie_base_leak_resolver.oo.
//
// Beats:
//   1. Call pie_base_leak_resolver_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pie_base_leak_resolver: PASSED only if they match.

import "std/exploit_analysis/pie_base_leak_resolver.oo";

pub fn main() {
    let a = pie_base_leak_resolver_probe();
    let b = pie_base_leak_resolver_probe();
    if a != b {
        println("FAIL pie_base_leak_resolver_probe");
        process_exit(1);
    }
    println("prod_pie_base_leak_resolver: PASSED");
}
