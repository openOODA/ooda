// # Refuse a concatenated secret at eprintln
//
// Logline: Embedding a tagged name in a concat still reaches eprintln as tainted.
//
// Beats:
//   1. Tag token at line start.
//   2. Build msg as a prefix plus that name.
//   3. Pass msg to eprintln so the sink refuses.

// M-? string-interp taint: secret embedded in concat reaches eprintln (emit-c path)
// SECRET: token
pub fn main() {
    let token = "s3cret";
    let msg = "hi " + token;
    eprintln(msg);
}
