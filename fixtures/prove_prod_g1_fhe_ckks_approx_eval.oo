// # Product prove std/fhe_lattices/fhe_ckks_approx_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_ciphertext_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ckks_approx_eval.oo.
//
// Beats:
//   1. Call ckks_ciphertext_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_ckks_approx_eval: PASSED only if they match.

import "std/fhe_lattices/fhe_ckks_approx_eval.oo";

pub fn main() {
    let a: CkksCiphertext = ckks_ciphertext_new(list_new(), list_new(), 0, 0, 0.0, 0);
    let b: CkksCiphertext = ckks_ciphertext_new(list_new(), list_new(), 0, 0, 0.0, 0);
    if a.degree_n != b.degree_n {
        println("FAIL ckks_ciphertext_new");
        process_exit(1);
    }
    println("prod_fhe_ckks_approx_eval: PASSED");
}
