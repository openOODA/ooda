// # Product prove std/robotics_auv/pressure_depth_sensor_fusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts pressure_to_depth_saunders is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/pressure_depth_sensor_fusion.oo.
//
// Beats:
//   1. Call pressure_to_depth_saunders twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pressure_depth_sensor_fusion: PASSED only if they match.

import "std/robotics_auv/pressure_depth_sensor_fusion.oo";

pub fn main() {
    let obj_a: PressureSensorConfig = pressure_sensor_config_default();
    let obj_b: PressureSensorConfig = pressure_sensor_config_default();
    let a: Int = pressure_to_depth_saunders(obj_a, 0);
    let b: Int = pressure_to_depth_saunders(obj_b, 0);
    if a != b {
        println("FAIL pressure_to_depth_saunders");
        process_exit(1);
    }
    println("prod_pressure_depth_sensor_fusion: PASSED");
}
