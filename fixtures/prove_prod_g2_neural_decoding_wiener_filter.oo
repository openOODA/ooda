// # Product prove std/neuro_bci/neural_decoding_wiener_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts wiener_weights_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neural_decoding_wiener_filter.oo.
//
// Beats:
//   1. Call wiener_weights_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_neural_decoding_wiener_filter: PASSED only if they match.

import "std/neuro_bci/neural_decoding_wiener_filter.oo";

pub fn main() {
    let neural_decoding_wiener_filter_mark: Int = 0;
    if neural_decoding_wiener_filter_mark != 0 {
        process_exit(1);
    }
    let a: WienerWeights2x4 = wiener_weights_default();
    let b: WienerWeights2x4 = wiener_weights_default();
    if (a).w1_0 != (b).w1_0 {
        println("FAIL wiener_weights_default");
        process_exit(1);
    }
    println("prod_g2_neural_decoding_wiener_filter: PASSED");
}
