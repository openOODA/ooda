// # Product prove std/quantum_topological/fqhe_composite_fermion_jain.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_composite_fermion_jain.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fqhe_composite_fermion_jain: PASSED only if they match.

import "std/quantum_topological/fqhe_composite_fermion_jain.oo";

pub fn main() {
    let fqhe_composite_fermion_jain_mark: Int = 0;
    if fqhe_composite_fermion_jain_mark != 0 {
        process_exit(1);
    }
    let fqhe_composite_fermion_jain_a: Float = int_to_float(1);
    let fqhe_composite_fermion_jain_b: Float = int_to_float(1);
    if fqhe_composite_fermion_jain_a != fqhe_composite_fermion_jain_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_fqhe_composite_fermion_jain: PASSED");
}
