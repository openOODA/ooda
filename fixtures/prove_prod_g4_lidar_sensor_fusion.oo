// # Product prove std/lidar_perception/sensor_fusion_camera_lidar.oo
//
// Logline: Fail-closed verification that camera-LiDAR multi-modal projection and semantic fusion are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/sensor_fusion_camera_lidar.oo.
//
// Beats:
//   1. Construct RGB colors and PointXYZIRGB fused points.
//   2. Fuse camera 2D semantic classes into 3D points inside and outside viewing frustum.
//   3. Assert deterministic semantic classification results.
//   4. Print prod_g4_lidar_sensor_fusion: PASSED and exit 0.

import "std/lidar_perception/sensor_fusion_camera_lidar.oo";

pub fn main() {
    let col1: RGBColor = rgb_color_new(255, 128, 64);
    let col2: RGBColor = rgb_color_new(255, 128, 64);
    if (col1).r != (col2).r || (col1).g != 128 || (col1).b != 64 {
        println("FAIL rgb_color_new");
        process_exit(1);
    }

    let pt_rgb: PointXYZIRGB = point_xyz_irgb_new(10.0, 2.0, 0.5, 0.9, &col1, 3);
    if (pt_rgb).semantic_class != 3 || (pt_rgb).intensity != 0.9 || (pt_rgb).x != 10.0 {
        println("FAIL point_xyz_irgb_new");
        process_exit(1);
    }

    let k: CameraIntrinsics = camera_intrinsics_default();
    let pt_in_view: Point3D = point3d_new(0.0, 0.0, 10.0);
    let sem1: Int = fuse_camera_semantics_to_point(&pt_in_view, &k, 1280, 720, 5);
    let sem2: Int = fuse_camera_semantics_to_point(&pt_in_view, &k, 1280, 720, 5);
    if sem1 != sem2 || sem1 != 5 {
        println("FAIL fuse_camera_semantics_to_point in_view");
        process_exit(1);
    }

    let pt_behind: Point3D = point3d_new(0.0, 0.0, -2.0);
    let sem_behind: Int = fuse_camera_semantics_to_point(&pt_behind, &k, 1280, 720, 5);
    if sem_behind != 0 {
        println("FAIL fuse_camera_semantics_to_point behind");
        process_exit(1);
    }

    let pt_oob: Point3D = point3d_new(500.0, 500.0, 1.0);
    let sem_oob: Int = fuse_camera_semantics_to_point(&pt_oob, &k, 1280, 720, 5);
    if sem_oob != 0 {
        println("FAIL fuse_camera_semantics_to_point oob");
        process_exit(1);
    }

    println("prod_g4_lidar_sensor_fusion: PASSED");
    process_exit(0);
}
