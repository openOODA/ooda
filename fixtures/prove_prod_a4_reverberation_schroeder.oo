// # Product prove std/physics_advanced/reverberation_schroeder.oo
//
// Logline: Fail-closed emit+gcc+run asserts schroeder_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/reverberation_schroeder.oo.
//
// Beats:
//   1. Call schroeder_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_reverberation_schroeder: PASSED only if they match.

import "std/physics_advanced/reverberation_schroeder.oo";

pub fn main() {
    let reverberation_schroeder_mark: Int = 0;
    if reverberation_schroeder_mark != 0 {
        process_exit(1);
    }
    let a: Float = schroeder_int_to_float(0);
    let b: Float = schroeder_int_to_float(0);
    if a != b {
        println("FAIL schroeder_int_to_float");
        process_exit(1);
    }
    println("prod_reverberation_schroeder: PASSED");
}
