// # Product prove std/physics_advanced/orbital_relativity_schwarzschild.oo
//
// Logline: Fail-closed emit+gcc+run asserts relativity_config_earth value or determinism.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/orbital_relativity_schwarzschild.oo.
//
// Beats:
//   1. Call relativity_config_earth twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_orbital_relativity_schwarzschild: PASSED only if asserts hold.

import "std/physics_advanced/orbital_relativity_schwarzschild.oo";

pub fn main() {
    let orbital_relativity_schwarzschild = relativity_config_earth();
    let orbital_relativity_schwarzschild_b = relativity_config_earth();
    if orbital_relativity_schwarzschild.speed_of_light_c != 299792458.0 {
        println("FAIL relativity_config_earth speed_of_light_c");
        process_exit(1);
    }
    if orbital_relativity_schwarzschild.speed_of_light_c != orbital_relativity_schwarzschild_b.speed_of_light_c {
        println("FAIL relativity_config_earth det");
        process_exit(1);
    }
    println("prod_orbital_relativity_schwarzschild: PASSED");
}
