// # Product prove std/perf/rate_meter.oo
//
// Logline: Fail-closed emit+gcc+run asserts rate_meter_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/rate_meter.oo.
//
// Beats:
//   1. Call rate_meter_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rate_meter: PASSED only if they match.

import "std/perf/rate_meter.oo";

pub fn main() {
    let rate_meter_mark: Int = 0;
    if rate_meter_mark != 0 {
        process_exit(1);
    }
    let a: RateMeter = rate_meter_create("x", 1000);
    let b: RateMeter = rate_meter_create("x", 1000);
    if (a).window_ms != (b).window_ms {
        println("FAIL rate_meter_create");
        process_exit(1);
    }
    println("prod_rate_meter: PASSED");
}
