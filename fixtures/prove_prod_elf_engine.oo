// # Product prove std/sec/sys/elf_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_engine_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/elf_engine.oo.
//
// Beats:
//   1. Call elf_engine_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_engine: PASSED only if they match.

import "std/sec/sys/elf_engine.oo";

pub fn main() {
    let a = elf_engine_ready();
    let b = elf_engine_ready();
    if a != b {
        println("FAIL elf_engine_ready");
        process_exit(1);
    }
    println("prod_elf_engine: PASSED");
}
