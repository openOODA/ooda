// # Product prove std/sec/crypto/chacha20_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts chacha_state_rounds is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call chacha_state_rounds twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_chacha20_types: PASSED only if they match.

import "std/sec/crypto/chacha20_types.oo";

pub fn main() {
    let g0_oa = chacha_state_new(2, 8, 2);
    let g0_ob = chacha_state_new(2, 8, 2);
    let g0_a = chacha_state_rounds(g0_oa);
    let g0_b = chacha_state_rounds(g0_ob);
    if g0_a != g0_b {
        println("FAIL chacha_state_rounds");
        process_exit(1);
    }
    println("prod_g0_chacha20_types: PASSED");
}
