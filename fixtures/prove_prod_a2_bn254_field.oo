// # Product prove std/crypto_advanced/bn254_field.oo
//
// Logline: Fail-closed emit+gcc+run asserts bn254_fp_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_field.oo.
//
// Beats:
//   1. Call bn254_fp_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bn254_field: PASSED only if they match.

import "std/crypto_advanced/bn254_field.oo";

pub fn main() {
    let bn254_field_mark: Int = 0;
    if bn254_field_mark != 0 {
        process_exit(1);
    }
    let a: Bn254Fp = bn254_fp_new(0, 0);
    let b: Bn254Fp = bn254_fp_new(0, 0);
    if (a).val != (b).val {
        println("FAIL bn254_fp_new");
        process_exit(1);
    }
    println("prod_bn254_field: PASSED");
}
