// # Product sec audit const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/audit_const.oo.
//
// Setup: Product std/sec/sys/audit_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. type syscall 1300 execve 1309. always 2 arch 62.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/audit_const.oo";

pub fn main() {
    let a: Int = audit_type_syscall();
    if a != 1300 {
        println("FAIL aud sys");
        process_exit(1);
    }
    let b: Int = audit_type_execve();
    if b != 1309 {
        println("FAIL aud execve");
        process_exit(1);
    }
    let c: Int = audit_always();
    if c != 2 {
        println("FAIL aud always");
        process_exit(1);
    }
    let d: Int = audit_arch_x86_64();
    if d != 62 {
        println("FAIL aud arch");
        process_exit(1);
    }
    println("prod_audconst: PASSED");
}
