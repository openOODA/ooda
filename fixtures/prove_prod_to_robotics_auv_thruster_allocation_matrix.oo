import "std/robotics_auv/thruster_allocation_matrix.oo";

pub fn main() {
    let obj = thruster_allocation_zero();
    let thruster_allocation_matrix_a = obj.t1;
    if thruster_allocation_matrix_a != 0.0 {
        println("FAIL thruster_allocation_zero");
        process_exit(1);
    }
    println("prod_thruster_allocation_matrix: PASSED");
