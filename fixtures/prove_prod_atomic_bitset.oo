// # Product prove std/sync/atomic_bitset.oo
//
// Logline: Fail-closed emit+gcc+run asserts atomic_bitset_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/atomic_bitset.oo.
//
// Beats:
//   1. Call atomic_bitset_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atomic_bitset: PASSED only if they match.

import "std/sync/atomic_bitset.oo";

pub fn main() {
    let obj = atomic_bitset_new(0);
    let a = atomic_bitset_size(obj);
    let b = atomic_bitset_size(obj);
    if a != b {
        println("FAIL atomic_bitset_size");
        process_exit(1);
    }
    println("prod_atomic_bitset: PASSED");
}
