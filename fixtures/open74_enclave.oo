// # Enclave enter with measurement hash
//
// Logline: Enter a sealed function identity, print its SHA-256 measurement, and return it.
//
// Setup: OPEN-74. oo_enclave_enter requires &SysCap. Honest floor: measure + enter + return. Not SGX.
//
// Beats:
//   1. Measurement is 64 hex chars.
//   2. Same sealed identity is deterministic.
//   3. A different identity has a different measurement.

pub fn main(sys: &SysCap) {
    let m: String = oo_enclave_enter(sys, "sealed_fn");
    let again: String = oo_enclave_enter(sys, "sealed_fn");
    let other: String = oo_enclave_enter(sys, "other_fn");
    if chars_len(m) != 64 {
        println("FAIL meas len");
        process_exit(1);
    }
    if m != again {
        println("FAIL match");
        process_exit(1);
    }
    if m == other {
        println("FAIL distinct");
        process_exit(1);
    }
    let expect: String = crypto_sha256_internal("sealed_fn");
    if m != expect {
        println("FAIL sha256");
        process_exit(1);
    }
    println("open74: PASSED");
}
