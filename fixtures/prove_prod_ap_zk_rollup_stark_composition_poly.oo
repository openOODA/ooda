// # Product prove std/zk_rollup/stark_composition_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/stark_composition_poly.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_composition_poly.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_stark_composition_poly: PASSED only if they match.

import "std/zk_rollup/stark_composition_poly.oo";

pub fn main() {
    let stark_composition_poly_a = composition_poly_context_new(0, 0, 0);
    let stark_composition_poly_b = composition_poly_context_new(0, 0, 0);
    if stark_composition_poly_a.num_boundary_constraints != stark_composition_poly_b.num_boundary_constraints {
        println("FAIL stark_composition_poly");
        process_exit(1);
    }
    println("prod_ap_stark_composition_poly: PASSED");
}
