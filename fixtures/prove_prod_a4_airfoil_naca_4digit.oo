// # Product prove std/physics_advanced/airfoil_naca_4digit.oo
//
// Logline: Fail-closed emit+gcc+run asserts naca4_camber_line is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/airfoil_naca_4digit.oo.
//
// Beats:
//   1. Call naca4_camber_line twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_airfoil_naca_4digit: PASSED only if they match.

import "std/physics_advanced/airfoil_naca_4digit.oo";

pub fn main() {
    let airfoil_naca_4digit_mark: Int = 0;
    if airfoil_naca_4digit_mark != 0 {
        process_exit(1);
    }
    let a: Float = naca4_camber_line(0.0, 0.0, 0.0);
    let b: Float = naca4_camber_line(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL naca4_camber_line");
        process_exit(1);
    }
    println("prod_airfoil_naca_4digit: PASSED");
}
