// # Product prove std/aero/orbit_kepler.oo
//
// Logline: Fail-closed verification that orbital dynamics and Kepler equation solver are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_kepler.oo.
//
// Beats:
//   1. Compute circular orbit speed and orbital period twice.
//   2. Convert true anomaly to eccentric anomaly.
//   3. Assert deterministic return values.
//   4. Print prod_g4_aero_orbit_kepler: PASSED and exit 0.

import "std/aero/orbit_kepler.oo";

pub fn main() {
    let mu: Float = mu_earth();
    let r: Float = 7000000.0;

    let v_c1: Float = circular_orbit_speed(r, mu);
    let v_c2: Float = circular_orbit_speed(r, mu);
    if v_c1 != v_c2 {
        println("FAIL circular_orbit_speed");
        process_exit(1);
    }

    let t1: Float = orbital_period(r, mu);
    let t2: Float = orbital_period(r, mu);
    if t1 != t2 {
        println("FAIL orbital_period");
        process_exit(1);
    }

    let rp: Float = perigee_radius(r, 0.01);
    let ra: Float = apogee_radius(r, 0.01);
    if rp >= ra {
        println("FAIL perigee/apogee radius");
        process_exit(1);
    }

    let e_anom1: Float = true_to_eccentric_anomaly(0.5, 0.01);
    let e_anom2: Float = true_to_eccentric_anomaly(0.5, 0.01);
    if e_anom1 != e_anom2 {
        println("FAIL true_to_eccentric_anomaly");
        process_exit(1);
    }

    println("prod_g4_aero_orbit_kepler: PASSED");
    process_exit(0);
}
