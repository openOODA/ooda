// # Product prove std/aero/navigation.oo
//
// Logline: Fail-closed emit+gcc+run asserts navigation_fix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/navigation.oo.
//
// Beats:
//   1. Call navigation_fix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_navigation: PASSED only if they match.

import "std/aero/navigation.oo";

pub fn main() {
    let a: NavCoord = navigation_fix_new(0, 0);
    let b: NavCoord = navigation_fix_new(0, 0);
    if (a).lat_milli != (b).lat_milli {
        println("FAIL navigation_fix_new");
        process_exit(1);
    }
    println("prod_g2_navigation: PASSED");
}
