// # Product prove std/synthetic_biology/kill_switch_biocontainment.oo
//
// Logline: Fail-closed emit+gcc+run asserts killswitch_step real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/kill_switch_biocontainment.oo.
//
// Beats:
//   1. Call killswitch_step with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_kill_switch_biocontainment: PASSED only if the assert holds.

import "std/synthetic_biology/kill_switch_biocontainment.oo";

pub fn main() {
    let kill_switch_biocontainment_mark: Int = 0;
    if kill_switch_biocontainment_mark != 0 {
        process_exit(1);
    }
    let kill_switch_biocontainment_st: BiocontainmentState = BiocontainmentState { free_toxin_conc: 0.0, free_antitoxin_conc: 0.0, inactive_complex_conc: 0.0, time_minutes: 0.0 };
    let kill_switch_biocontainment_p: KillSwitchParams = KillSwitchParams { k_tx_toxin: 0.0, k_tx_antitoxin_max: 0.0, k_complex_binding: 0.0, d_antitoxin_fast: 0.0, d_toxin_slow: 0.0, lethal_toxin_threshold: 0.0 };
    let kill_switch_biocontainment_a = killswitch_step(&kill_switch_biocontainment_st, &kill_switch_biocontainment_p, 0.0, 0.0);
    let kill_switch_biocontainment_time_minutes: Float = (kill_switch_biocontainment_a).time_minutes;
    if !(kill_switch_biocontainment_time_minutes == 0.0) {
        println("FAIL killswitch_step");
        process_exit(1);
    }
    println("prod_kill_switch_biocontainment: PASSED");
}
