// # Product prove std/media_dsp/deflate_lz77_huffman.oo
//
// Logline: Fail-closed emit+gcc+run asserts deflate_decode_fixed_literal_symbol is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/deflate_lz77_huffman.oo.
//
// Beats:
//   1. Call deflate_decode_fixed_literal_symbol twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_deflate_lz77_huffman: PASSED only if they match.

import "std/media_dsp/deflate_lz77_huffman.oo";

pub fn main() {
    let deflate_lz77_huffman_mark: Int = 0;
    if deflate_lz77_huffman_mark != 0 {
        process_exit(1);
    }
    let deflate_lz77_huffman_a: Int = deflate_decode_fixed_literal_symbol(1);
    let deflate_lz77_huffman_b: Int = deflate_decode_fixed_literal_symbol(1);
    if deflate_lz77_huffman_a != deflate_lz77_huffman_b {
        println("FAIL deflate_decode_fixed_literal_symbol");
        process_exit(1);
    }
    println("prod_deflate_lz77_huffman: PASSED");
}
