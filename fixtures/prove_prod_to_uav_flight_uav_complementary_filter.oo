// # Product prove std/uav_flight/uav_complementary_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts mahony_config_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_complementary_filter.oo.
//
// Beats:
//   1. Call mahony_config_default using the uav_complementary_filter ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_uav_complementary_filter: PASSED only if asserts hold.

import "std/uav_flight/uav_complementary_filter.oo";

pub fn main() {
    let obj = mahony_config_default();
    let uav_complementary_filter_a = obj.kp_gain;
    if uav_complementary_filter_a != 2.0 {
        println("FAIL mahony_config_default");
        process_exit(1);
    }
    println("prod_uav_complementary_filter: PASSED");
}
