// # Product prove std/ai_multimodal/diffusion_ddpm_scheduler.oo
//
// Logline: Fail-closed emit+check asserts ddpm_beta_at is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_ddpm_scheduler.oo.
//
// Beats:
//   1. Call ddpm_beta_at twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_diffusion_ddpm_scheduler: PASSED only if they match.

import "std/ai_multimodal/diffusion_ddpm_scheduler.oo";

pub fn main() {
    let diffusion_ddpm_scheduler_mark: Int = 0;
    if diffusion_ddpm_scheduler_mark != 0 { process_exit(1); }
    let a: Int = ddpm_beta_at(1000, 1, 1000, 0);
    let b: Int = ddpm_beta_at(1000, 1, 1000, 0);
    if a != b { process_exit(1); }
    println("prod_diffusion_ddpm_scheduler: PASSED");
}
