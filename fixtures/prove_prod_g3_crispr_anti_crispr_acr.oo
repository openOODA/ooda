// # Product prove std/crispr_cas/crispr_anti_crispr_acr.oo
//
// Logline: Fail-closed emit+gcc+run asserts acr_get_standard_spec is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_anti_crispr_acr.oo.
//
// Beats:
//   1. Call acr_get_standard_spec twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crispr_anti_crispr_acr: PASSED only if they match.

import "std/crispr_cas/crispr_anti_crispr_acr.oo";

pub fn main() {
    let crispr_anti_crispr_acr_mark: Int = 0;
    if crispr_anti_crispr_acr_mark != 0 {
        process_exit(1);
    }
    let a: AcrInteractionSpec = acr_get_standard_spec("x");
    let b: AcrInteractionSpec = acr_get_standard_spec("x");
    if (a).affinity_kd_nm != (b).affinity_kd_nm {
        println("FAIL acr_get_standard_spec");
        process_exit(1);
    }
    println("prod_crispr_anti_crispr_acr: PASSED");
}
