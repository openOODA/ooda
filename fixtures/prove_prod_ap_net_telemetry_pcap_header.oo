// # Product prove std/net_telemetry/pcap_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net_telemetry/pcap_header.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/pcap_header.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pcap_header: PASSED only if they match.

import "std/net_telemetry/pcap_header.oo";

pub fn main() {
    let pcap_header_a = pcap_header_default();
    let pcap_header_b = pcap_header_default();
    if pcap_header_a.magic_number != pcap_header_b.magic_number {
        println("FAIL pcap_header");
        process_exit(1);
    }
    println("prod_ap_pcap_header: PASSED");
}
