// # Product prove std/crispr_cas/off_target_deepcrispr_cnn.oo
//
// Logline: Fail-closed emit+gcc+run asserts deepcrispr_encode_features is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/off_target_deepcrispr_cnn.oo.
//
// Beats:
//   1. Call deepcrispr_encode_features twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_off_target_deepcrispr_cnn: PASSED only if they match.

import "std/crispr_cas/off_target_deepcrispr_cnn.oo";

pub fn main() {
    let off_target_deepcrispr_cnn_mark: Int = 0;
    if off_target_deepcrispr_cnn_mark != 0 {
        process_exit(1);
    }
    let a: DeepCrisprChannelTensor = deepcrispr_encode_features("x", 0.0, 0.0, 0.0);
    let b: DeepCrisprChannelTensor = deepcrispr_encode_features("x", 0.0, 0.0, 0.0);
    if (a).guide_len != (b).guide_len {
        println("FAIL deepcrispr_encode_features");
        process_exit(1);
    }
    println("prod_g2_off_target_deepcrispr_cnn: PASSED");
}
