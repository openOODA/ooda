// # Product Hermite spline prove
//
// Logline: Fail-closed emit+gcc+run of shipped hermite_eval.
//
// Setup: Product std/math/spline_hermite_1d.oo. t=0 is p0; t=1 is p1.
//
// Beats:
//   1. hermite_eval(1,0,3,0,0) is 1.0.
//   2. hermite_eval(1,0,3,0,1) is 3.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/spline_hermite_1d.oo";

pub fn main() {
    let a: Float = hermite_eval(1.0, 0.0, 3.0, 0.0, 0.0);
    if a != 1.0 {
        println("FAIL hermite 0");
        process_exit(1);
    }
    let b: Float = hermite_eval(1.0, 0.0, 3.0, 0.0, 1.0);
    if b != 3.0 {
        println("FAIL hermite 1");
        process_exit(1);
    }
    println("prod_hermite: PASSED");
}
