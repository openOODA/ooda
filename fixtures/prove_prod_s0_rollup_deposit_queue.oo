// # Product prove std/zk_rollup/rollup_deposit_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts deposit_record_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_deposit_queue.oo.
//
// Beats:
//   1. Call deposit_record_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rollup_deposit_queue: PASSED only if asserts hold.

import "std/zk_rollup/rollup_deposit_queue.oo";

pub fn main() {
    let rollup_deposit_queue_a = deposit_record_new(0, 0, 0, 0, 0);
    let rollup_deposit_queue_b = deposit_record_new(0, 0, 0, 0, 0);
    if rollup_deposit_queue_a.deposit_index != rollup_deposit_queue_b.deposit_index {
        println("FAIL deposit_record_new");
        process_exit(1);
    }
    println("prod_rollup_deposit_queue: PASSED");
}
