// # Product prove std/aero/telemetry_engine.oo
//
// Logline: Fail-closed verification that telemetry multiplexing and stream processing operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_engine.oo.
//
// Beats:
//   1. Pack and unpack CCSDS primary packet headers and validate structure.
//   2. Validate transfer frames, payload capacities, and sequence continuity.
//   3. Calibrate telemetry channels and assert deterministic outputs.
//   4. Print prod_g4_aero_telemetry_engine: PASSED and exit 0.

import "std/aero/telemetry_engine.oo";

pub fn main() {
    let telemetry_engine_mark: Int = 0;
    if telemetry_engine_mark != 0 {
        process_exit(1);
    }

    let hdr: PacketHeader = PacketHeader {
        version: 0,
        packet_type: 0,
        sec_header_flag: 0,
        apid: 100,
        sequence_flags: 3,
        sequence_count: 42,
        packet_length: 64,
    };

    let v: Bool = packet_header_validate(hdr);
    if !v {
        println("FAIL packet_header_validate");
        process_exit(1);
    }

    let w1_a: Int = packet_header_pack_word1(hdr);
    let w1_b: Int = packet_header_pack_word1(hdr);
    if w1_a != w1_b {
        println("FAIL packet_header_pack_word1");
        process_exit(1);
    }

    let w2_a: Int = packet_header_pack_word2(hdr);
    let w2_b: Int = packet_header_pack_word2(hdr);
    if w2_a != w2_b {
        println("FAIL packet_header_pack_word2");
        process_exit(1);
    }

    let unp_hdr: PacketHeader = packet_header_unpack_word1(w1_a);
    if (unp_hdr).apid != 100 {
        println("FAIL packet_header_unpack_word1");
        process_exit(1);
    }

    let pkt: CcsdsPacket = CcsdsPacket {
        header: hdr,
        service_type: 3,
        service_subtype: 25,
    };

    let is_hk: Bool = ccsds_packet_is_housekeeping(pkt);
    if !is_hk {
        println("FAIL ccsds_packet_is_housekeeping");
        process_exit(1);
    }

    let gap: Int = check_sequence_continuity(40, 42);
    if gap != 1 {
        println("FAIL check_sequence_continuity");
        process_exit(1);
    }

    let frame: TelemetryFrame = TelemetryFrame {
        version: 0,
        spacecraft_id: 12,
        virtual_channel_id: 0,
        master_frame_count: 10,
        vc_frame_count: 5,
        operational_control_flag: false,
        frame_length: 1024,
    };

    let fv: Bool = telemetry_frame_validate(frame);
    if !fv {
        println("FAIL telemetry_frame_validate");
        process_exit(1);
    }

    let is_rt: Bool = telemetry_frame_is_realtime(frame);
    if !is_rt {
        println("FAIL telemetry_frame_is_realtime");
        process_exit(1);
    }

    let cap: Int = telemetry_frame_get_payload_capacity(frame);
    if cap != 1016 {
        println("FAIL telemetry_frame_get_payload_capacity");
        process_exit(1);
    }

    let cal_a: Float = telemetry_channel_calibrate(100, 0.5, 10.0);
    let cal_b: Float = telemetry_channel_calibrate(100, 0.5, 10.0);
    if cal_a != cal_b || cal_a != 60.0 {
        println("FAIL telemetry_channel_calibrate");
        process_exit(1);
    }

    let clamped: Float = telemetry_channel_clamp(150.0, 0.0, 100.0);
    if clamped != 100.0 {
        println("FAIL telemetry_channel_clamp");
        process_exit(1);
    }

    println("prod_g4_aero_telemetry_engine: PASSED");
    process_exit(0);
}
