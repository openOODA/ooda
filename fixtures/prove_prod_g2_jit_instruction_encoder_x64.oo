// # Product prove std/wasm_gc/jit_instruction_encoder_x64.oo
//
// Logline: Fail-closed emit+gcc+run asserts encode_rex_prefix is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_instruction_encoder_x64.oo.
//
// Beats:
//   1. Call encode_rex_prefix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jit_instruction_encoder_x64: PASSED only if they match.

import "std/wasm_gc/jit_instruction_encoder_x64.oo";

pub fn main() {
    let jit_instruction_encoder_x64_mark: Int = 0;
    if jit_instruction_encoder_x64_mark != 0 {
        process_exit(1);
    }
    let a: Int = encode_rex_prefix(0, 0, 0, 0);
    let b: Int = encode_rex_prefix(0, 0, 0, 0);
    if a != b {
        println("FAIL encode_rex_prefix");
        process_exit(1);
    }
    println("prod_g2_jit_instruction_encoder_x64: PASSED");
}
