// # Product prove std/db_columnar/columnar_simd_sum_agg.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_sum_accumulator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_simd_sum_agg.oo.
//
// Beats:
//   1. Call simd_sum_accumulator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_columnar_simd_sum_agg: PASSED only if they match.

import "std/db_columnar/columnar_simd_sum_agg.oo";

pub fn main() {
    let columnar_simd_sum_agg_mark: Int = 0;
    if columnar_simd_sum_agg_mark != 0 {
        process_exit(1);
    }
    let a: SimdSumAccumulator = simd_sum_accumulator_new();
    let b: SimdSumAccumulator = simd_sum_accumulator_new();
    if (a).lane_0 != (b).lane_0 {
        println("FAIL simd_sum_accumulator_new");
        process_exit(1);
    }
    println("prod_g2_columnar_simd_sum_agg: PASSED");
}
