// # Product prove std/quantum_topological/fqhe_haldane_pseudopotentials.oo
//
// Logline: Fail-closed emit+gcc+run asserts pseudopotential_set_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_haldane_pseudopotentials.oo.
//
// Beats:
//   1. Call pseudopotential_set_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fqhe_haldane_pseudopotentials: PASSED only if they match.

import "std/quantum_topological/fqhe_haldane_pseudopotentials.oo";

pub fn main() {
    let a: PseudopotentialSet = pseudopotential_set_new(0);
    let b: PseudopotentialSet = pseudopotential_set_new(0);
    if a.max_relative_angular_momentum != b.max_relative_angular_momentum {
        println("FAIL pseudopotential_set_new");
        process_exit(1);
    }
    println("prod_fqhe_haldane_pseudopotentials: PASSED");
}
