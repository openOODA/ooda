// # Product prove std/zk_rollup/pasta_curves_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/pasta_curves_cycle.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/pasta_curves_cycle.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pasta_curves_cycle: PASSED only if they match.

import "std/zk_rollup/pasta_curves_cycle.oo";

pub fn main() {
    let pasta_curves_cycle_a = pasta_field_switch_p_to_q(0, 0);
    let pasta_curves_cycle_b = pasta_field_switch_p_to_q(0, 0);
    if pasta_curves_cycle_a != pasta_curves_cycle_b {
        println("FAIL pasta_curves_cycle");
        process_exit(1);
    }
    println("prod_ap_pasta_curves_cycle: PASSED");
}
