// # Product prove std/fhe_lattices/fhe_ckks_bootstrap.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_bootstrap_coeff_to_slot_cost is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ckks_bootstrap.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ckks_bootstrap_coeff_to_slot_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_ckks_bootstrap: PASSED only if they match.

import "std/fhe_lattices/fhe_ckks_bootstrap.oo";

pub fn main() {
    let g2_a = ckks_bootstrap_coeff_to_slot_cost(2);
    let g2_b = ckks_bootstrap_coeff_to_slot_cost(2);
    if g2_a != g2_b {
        println("FAIL ckks_bootstrap_coeff_to_slot_cost");
        process_exit(1);
    }
    println("prod_g2_fhe_ckks_bootstrap: PASSED");
}
