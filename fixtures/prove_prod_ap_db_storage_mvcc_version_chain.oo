// # Product prove std/db_storage/mvcc_version_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/mvcc_version_chain.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_version_chain.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mvcc_version_chain: PASSED only if they match.

import "std/db_storage/mvcc_version_chain.oo";

pub fn main() {
    let mvcc_version_chain_a = mvcc_tuple_header_new(0);
    let mvcc_version_chain_b = mvcc_tuple_header_new(0);
    let mvcc_version_chain_va = is_version_visible(mvcc_version_chain_a, 0, 0, 0, list_new());
    let mvcc_version_chain_vb = is_version_visible(mvcc_version_chain_b, 0, 0, 0, list_new());
    if mvcc_version_chain_va != mvcc_version_chain_vb {
        println("FAIL mvcc_version_chain");
        process_exit(1);
    }
    println("prod_ap_mvcc_version_chain: PASSED");
}
