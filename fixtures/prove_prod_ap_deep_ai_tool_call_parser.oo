// # Product prove std/deep_ai/tool_call_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/tool_call_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/tool_call_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tool_call_parser: PASSED only if they match.

import "std/deep_ai/tool_call_parser.oo";

pub fn main() {
    let tool_call_parser_a = tool_call_parser_marker();
    let tool_call_parser_b = tool_call_parser_marker();
    if tool_call_parser_a != tool_call_parser_b {
        println("FAIL tool_call_parser");
        process_exit(1);
    }
    println("prod_ap_tool_call_parser: PASSED");
}
