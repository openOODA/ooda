// # Product prove std/bio/protein_stubs.oo
//
// Logline: Fail-closed verification that protein biophysics helpers are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_stubs.oo.
//
// Beats:
//   1. Construct AminoAcid from standard code table.
//   2. Query mass and charge deterministically.
//   3. Construct ProteinBackbone and assert initial residue count is zero.
//   4. Print prod_g4_bio_protein_stubs: PASSED and exit 0.

import "std/bio/protein_stubs.oo";

pub fn main() {
    let aa1: AminoAcid = amino_acid_from_code(1);
    let aa2: AminoAcid = amino_acid_from_code(1);
    let m1: Int = amino_acid_mass(aa1);
    let m2: Int = amino_acid_mass(aa2);
    if m1 != m2 || m1 != 7108 {
        println("FAIL amino_acid_mass");
        process_exit(1);
    }

    let ch1: Int = amino_acid_charge(aa1);
    let ch2: Int = amino_acid_charge(aa2);
    if ch1 != ch2 || ch1 != 0 {
        println("FAIL amino_acid_charge");
        process_exit(1);
    }

    let pb1: ProteinBackbone = protein_backbone_new(1);
    let pb2: ProteinBackbone = protein_backbone_new(1);
    let cnt1: Int = protein_backbone_get_residue_count(pb1);
    let cnt2: Int = protein_backbone_get_residue_count(pb2);
    if cnt1 != cnt2 || cnt1 != 0 {
        println("FAIL protein_backbone_get_residue_count");
        process_exit(1);
    }

    println("prod_g4_bio_protein_stubs: PASSED");
    process_exit(0);
}
