// # List index sugar
//
// Logline: Read a three-int list via list_get, index_get, and xs[i].
//
// Beats:
//   1. Push 10, 20, 30.
//   2. Print list_get 0/1 and index_get 2.
//   3. Print xs[0], xs[1], and xs[2].

// M166 path A: list indexing — list_get product + index_get alias + xs[i] sugar
// residual: not pointer arithmetic; not obj.rules field-index without List base
pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 10);
    xs = list_push(xs, 20);
    xs = list_push(xs, 30);
    // Product form
    println(list_get(xs, 0));
    println(list_get(xs, 1));
    // Free-name alias
    println(index_get(xs, 2));
    // LBRACKET sugar → list_get lower (Backend-C path A)
    println(xs[0]);
    println(xs[1]);
    println(xs[2]);
}
