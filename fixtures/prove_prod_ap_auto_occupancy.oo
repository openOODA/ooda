// # Product prove std/auto/occupancy.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/occupancy.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_occupancy: PASSED only if they match.

import "std/auto/occupancy.oo";

pub fn main() {
    let occupancy_a = shim_marker_log_odds_to_prob(0);
    let occupancy_b = shim_marker_log_odds_to_prob(0);
    if occupancy_a != occupancy_b {
        println("FAIL occupancy");
        process_exit(1);
    }
    println("prod_ap_occupancy: PASSED");
}
