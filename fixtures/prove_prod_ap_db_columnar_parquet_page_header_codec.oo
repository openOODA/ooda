// # Product prove std/db_columnar/parquet_page_header_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_page_header_codec.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_page_header_codec.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_parquet_page_header_codec: PASSED only if they match.

import "std/db_columnar/parquet_page_header_codec.oo";

pub fn main() {
    let parquet_page_header_codec_a = data_page_v1_new(0, 0, 0, 0);
    let parquet_page_header_codec_b = data_page_v1_new(0, 0, 0, 0);
    if parquet_page_header_codec_a.num_values != parquet_page_header_codec_b.num_values {
        println("FAIL parquet_page_header_codec");
        process_exit(1);
    }
    println("prod_ap_parquet_page_header_codec: PASSED");
}
