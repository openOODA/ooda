// # Product prove std/compilers_vm/ssa_alias_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts alias_no_alias is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_alias_analysis.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call alias_no_alias twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ssa_alias_analysis: PASSED only if they match.

import "std/compilers_vm/ssa_alias_analysis.oo";

pub fn main() {
    let g2_a = alias_no_alias();
    let g2_b = alias_no_alias();
    if g2_a != g2_b {
        println("FAIL alias_no_alias");
        process_exit(1);
    }
    println("prod_g2_ssa_alias_analysis: PASSED");
}
