// # Product prove std/compilers/elf_symbol.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/elf_symbol.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_symbol.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_elf_symbol: PASSED only if they match.

import "std/compilers/elf_symbol.oo";

pub fn main() {
    let elf_symbol_a = elf_stb_local();
    let elf_symbol_b = elf_stb_local();
    if elf_symbol_a != elf_symbol_b {
        println("FAIL elf_symbol");
        process_exit(1);
    }
    println("prod_ap_elf_symbol: PASSED");
}
