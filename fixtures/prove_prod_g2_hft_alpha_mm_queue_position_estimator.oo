// # Product prove std/hft_alpha/mm_queue_position_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts queue_tracker_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_queue_position_estimator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call queue_tracker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_queue_position_estimator: PASSED only if they match.

import "std/hft_alpha/mm_queue_position_estimator.oo";

pub fn main() {
    let g2_oa: QueueTrackerState = queue_tracker_new("x", 1.0, 1.0, 1.0, 1.0);
    let g2_ob: QueueTrackerState = queue_tracker_new("x", 1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).price_level;
    let g2_b = (g2_ob).price_level;
    if g2_a != g2_b {
        println("FAIL queue_tracker_new.price_level");
        process_exit(1);
    }
    println("prod_g2_mm_queue_position_estimator: PASSED");
}
