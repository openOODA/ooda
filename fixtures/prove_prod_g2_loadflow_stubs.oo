// # Product prove std/grid/loadflow_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts loadflow_module_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/loadflow_stubs.oo.
//
// Beats:
//   1. Call loadflow_module_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_loadflow_stubs: PASSED only if they match.

import "std/grid/loadflow_stubs.oo";

pub fn main() {
    let loadflow_stubs_mark: Int = 0;
    if loadflow_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = loadflow_module_ready();
    let b: Bool = loadflow_module_ready();
    if a != b {
        println("FAIL loadflow_module_ready");
        process_exit(1);
    }
    println("prod_g2_loadflow_stubs: PASSED");
}
