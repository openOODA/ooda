// # Product prove std/lidar_perception/gicp_generalized_matching.oo
//
// Logline: Fail-closed emit+gcc+run asserts gicp_generalized_matching_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/gicp_generalized_matching.oo.
//
// Beats:
//   1. Call gicp_generalized_matching_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_gicp_generalized_matching: PASSED only if it matches.

import "std/lidar_perception/gicp_generalized_matching.oo";

pub fn main() {
    let a: Int = gicp_generalized_matching_probe();
    if a != 0 {
        println("FAIL gicp_generalized_matching_probe");
        process_exit(1);
    }
    println("prod_nc_gicp_generalized_matching: PASSED");
}
