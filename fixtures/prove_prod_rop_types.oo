// # Product prove std/sec/sys/rop_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts rop_gadget_addr is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop_types.oo.
//
// Beats:
//   1. Call rop_gadget_addr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rop_types: PASSED only if they match.

import "std/sec/sys/rop_types.oo";

pub fn main() {
    let obj = rop_gadget_new(0, 0, 0);
    let a = rop_gadget_addr(obj);
    let b = rop_gadget_addr(obj);
    if a != b {
        println("FAIL rop_gadget_addr");
        process_exit(1);
    }
    println("prod_rop_types: PASSED");
}
