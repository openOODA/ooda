// # Product matrix_determinant prove
//
// Logline: Fail-closed emit+gcc+run of shipped mat4_det_identity/compute.
//
// Setup: Product std/math/matrix_determinant.oo. Identity det 1; diag 2 det 16.
//
// Beats:
//   1. Identity determinant is 1.0.
//   2. Diag(2,2,2,2) determinant is 16.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/matrix_determinant.oo";

pub fn main() {
    let id: Float = mat4_det_identity();
    if id != 1.0 {
        println("FAIL mat4det id");
        process_exit(1);
    }
    let d: Float = mat4_det_compute(
        2.0, 0.0, 0.0, 0.0,
        0.0, 2.0, 0.0, 0.0,
        0.0, 0.0, 2.0, 0.0,
        0.0, 0.0, 0.0, 2.0
    );
    if d != 16.0 {
        println("FAIL mat4det diag");
        process_exit(1);
    }
    println("prod_mat4det: PASSED");
}
