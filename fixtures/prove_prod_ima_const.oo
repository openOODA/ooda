// # Product prove std/sec/sys/ima_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_action_measure is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/ima_const.oo.
//
// Beats:
//   1. Call ima_action_measure twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ima_const: PASSED only if they match.

import "std/sec/sys/ima_const.oo";

pub fn main() {
    let a = ima_action_measure();
    let b = ima_action_measure();
    if a != b {
        println("FAIL ima_action_measure");
        process_exit(1);
    }
    println("prod_ima_const: PASSED");
}
