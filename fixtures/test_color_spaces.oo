// # Color space adversarial suite
//
// Logline: Converts RGB to HSL and HSV and inverts both transforms within a tight tolerance.
//
// Setup: Pure. Imports color_spaces.oo. Run from ooda/.
//
// Beats:
//   1. Convert red 255,0,0 to HSL and HSV.
//   2. Invert both and require RGB near 255,0,0.
//   3. Reject a channel outside 0..255.

import "std/multimedia/color_spaces.oo";

fn near(a: Float, b: Float, eps: Float) -> Int {
    let mut d: Float = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > eps {
        return 0;
    }
    return 1;
}

pub fn main() {
    let hsl: ColorOut = color_spaces_rgb_to_hsl(255, 0, 0);
    if hsl.flag < 1 {
        println("FAIL hsl " + hsl.err);
        process_exit(1);
    }
    if near(hsl.s, 100.0, 1.0) < 1 {
        println("FAIL hsl s");
        process_exit(1);
    }
    let back: ColorOut = color_spaces_hsl_to_rgb(hsl.h, hsl.s, hsl.v);
    if near(back.r, 255.0, 2.0) < 1 {
        println("FAIL hsl r");
        process_exit(1);
    }
    if near(back.g, 0.0, 2.0) < 1 {
        println("FAIL hsl g");
        process_exit(1);
    }
    let hsv: ColorOut = color_spaces_rgb_to_hsv(255, 0, 0);
    if hsv.flag < 1 {
        println("FAIL hsv");
        process_exit(1);
    }
    let back2: ColorOut = color_spaces_hsv_to_rgb(hsv.h, hsv.s, hsv.v);
    if near(back2.r, 255.0, 2.0) < 1 {
        println("FAIL hsv r");
        process_exit(1);
    }
    if near(back2.b, 0.0, 2.0) < 1 {
        println("FAIL hsv b");
        process_exit(1);
    }
    println("RGB<->HSL and RGB<->HSV round-trip within tight tolerance");
    let bad: ColorOut = color_spaces_rgb_to_hsl(0 - 1, 0, 0);
    if bad.flag > 0 {
        println("FAIL rgb ok");
        process_exit(1);
    }
    println("SUITE PASSED");
    println("test_color_spaces: PASSED");
}
