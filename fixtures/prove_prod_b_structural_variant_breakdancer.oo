// # Product prove std/genomics_advanced/structural_variant_breakdancer.oo
//
// Logline: Fail-closed emit+gcc+run asserts structural_variant_breakdancer_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/structural_variant_breakdancer.oo.
//
// Beats:
//   1. Call structural_variant_breakdancer_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_structural_variant_breakdancer: PASSED only if they match.

import "std/genomics_advanced/structural_variant_breakdancer.oo";

pub fn main() {
    let a = structural_variant_breakdancer_probe();
    let b = structural_variant_breakdancer_probe();
    if a != b {
        println("FAIL structural_variant_breakdancer_probe");
        process_exit(1);
    }
    println("prod_structural_variant_breakdancer: PASSED");
}
