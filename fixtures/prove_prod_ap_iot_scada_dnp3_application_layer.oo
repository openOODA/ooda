// # Product prove std/iot_scada/dnp3_application_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/dnp3_application_layer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_application_layer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dnp3_application_layer: PASSED only if they match.

import "std/iot_scada/dnp3_application_layer.oo";

pub fn main() {
    let dnp3_application_layer_a = dnp3_fc_read();
    let dnp3_application_layer_b = dnp3_fc_read();
    if dnp3_application_layer_a != dnp3_application_layer_b {
        println("FAIL dnp3_application_layer");
        process_exit(1);
    }
    println("prod_ap_dnp3_application_layer: PASSED");
}
