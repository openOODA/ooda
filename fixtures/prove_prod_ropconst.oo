// # Product sec rop const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/rop_const.oo.
//
// Setup: Product std/sec/sys/rop_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. gadget unknown 0 syscall 4. arch x86_64 62 aarch64 183.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/rop_const.oo";

pub fn main() {
    let a: Int = gadget_type_unknown();
    if a != 0 {
        println("FAIL rop unk");
        process_exit(1);
    }
    let b: Int = gadget_type_syscall();
    if b != 4 {
        println("FAIL rop sys");
        process_exit(1);
    }
    let c: Int = rop_arch_x86_64();
    if c != 62 {
        println("FAIL rop x64");
        process_exit(1);
    }
    let d: Int = rop_arch_aarch64();
    if d != 183 {
        println("FAIL rop arm");
        process_exit(1);
    }
    println("prod_ropconst: PASSED");
}
