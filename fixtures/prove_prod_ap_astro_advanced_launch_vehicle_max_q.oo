// # Product prove std/astro_advanced/launch_vehicle_max_q.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/launch_vehicle_max_q.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/launch_vehicle_max_q.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_launch_vehicle_max_q: PASSED only if they match.

import "std/astro_advanced/launch_vehicle_max_q.oo";

pub fn main() {
    let launch_vehicle_max_q_a = max_q_pa();
    let launch_vehicle_max_q_b = max_q_pa();
    if launch_vehicle_max_q_a != launch_vehicle_max_q_b {
        println("FAIL launch_vehicle_max_q");
        process_exit(1);
    }
    println("prod_ap_launch_vehicle_max_q: PASSED");
}
