// # Product Levenshtein prove
//
// Logline: Fail-closed emit+gcc+run of shipped levenshtein_distance.
//
// Setup: Product std/text/levenshtein.oo. kitten/sitting is 3.
//
// Beats:
//   1. levenshtein_distance("", "abc") is 3.
//   2. levenshtein_distance("kitten", "sitting") is 3.
//   3. Exit 1 before PASSED on a miss.

import "std/text/levenshtein.oo";

pub fn main() {
    let empty: Int = levenshtein_distance("", "abc");
    if empty != 3 {
        println("FAIL lev empty");
        process_exit(1);
    }
    let d: Int = levenshtein_distance("kitten", "sitting");
    if d != 3 {
        println("FAIL lev kitten");
        process_exit(1);
    }
    println("prod_levenshtein: PASSED");
}
