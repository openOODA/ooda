// # Product prove std/physics/rigid.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_rigid_body_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/rigid.oo.
//
// Beats:
//   1. Call shim_marker_rigid_body_new using the rigid ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_rigid: PASSED only if asserts hold.

import "std/physics/rigid.oo";

pub fn main() {
    let arg0 = shim_marker_vec3_new();
    let obj = shim_marker_rigid_body_new(arg0);
    let rigid_a = obj.mass;
    let rigid_b = obj.mass;
    if rigid_a != rigid_b {
        println("FAIL shim_marker_rigid_body_new");
        process_exit(1);
    }
    println("prod_rigid: PASSED");
}
