// # Product prove std/net/pay_pass.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_pass_auth_scheme is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/pay_pass.oo.
//
// Beats:
//   1. Call pay_pass_auth_scheme twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pay_pass: PASSED only if they match.

import "std/net/pay_pass.oo";

pub fn main() {
    let a = pay_pass_auth_scheme();
    let b = pay_pass_auth_scheme();
    if a != b {
        println("FAIL pay_pass_auth_scheme");
        process_exit(1);
    }
    println("prod_pay_pass: PASSED");
}
