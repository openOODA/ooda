// # Product prove std/3d/xr_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts xr_pose_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/xr_types.oo.
//
// Beats:
//   1. Call xr_pose_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xr_types: PASSED only if they match.

import "std/3d/xr_types.oo";

pub fn main() {
    let obj_a: XrPose = xr_pose_new(0, 0, 0);
    let obj_b: XrPose = xr_pose_new(0, 0, 0);
    let a: Int = xr_pose_x(obj_a);
    let b: Int = xr_pose_x(obj_b);
    if a != b {
        println("FAIL xr_pose_x");
        process_exit(1);
    }
    println("prod_xr_types: PASSED");
}
