// # List[List[Float]] emit lock
//
// Logline: Fail-closed emit+gcc+run of nested List[List[Float]] push and get.
//
// Setup: Backend-C. Inner list holds 1.5. Nested list_get must yield Float.
//
// Beats:
//   1. Push 1.5 onto an inner List[Float].
//   2. Push that inner list onto xs.
//   3. Exit 1 before PASSED when nested get is not 1.5.

pub fn main() {
    let mut inner: List[Float] = list_new();
    inner = list_push(inner, 1.5);
    let empty: List[List[Float]] = list_new();
    let xs: List[List[Float]] = list_push(empty, inner);
    if list_get(list_get(xs, 0), 0) < 1.4 {
        println("FAIL");
        process_exit(1);
    }
    if list_get(list_get(xs, 0), 0) > 1.6 {
        println("FAIL");
        process_exit(1);
    }
    println("list_ll_float_smoke: PASSED");
}
