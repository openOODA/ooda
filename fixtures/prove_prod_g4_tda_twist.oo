// # Product prove std/tda_topology/twist_reduction_algorithm.oo
//
// Logline: Fail-closed verification that Twist reduction tracking and paired barcode structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/twist_reduction_algorithm.oo.
//
// Beats:
//   1. Construct TwistTracker for simplex filtration.
//   2. Validate simplex capacity and initial pair count.
//   3. Assert deterministic return values.
//   4. Print prod_g4_tda_twist: PASSED and exit 0.

import "std/tda_topology/twist_reduction_algorithm.oo";

pub fn main() {
    let tt_a: TwistTracker = twist_tracker_new(10);
    let tt_b: TwistTracker = twist_tracker_new(10);

    if (tt_a).num_simplices != (tt_b).num_simplices || (tt_a).num_simplices != 10 {
        println("FAIL twist_tracker_new num_simplices");
        process_exit(1);
    }

    if (tt_a).pair_count != (tt_b).pair_count || (tt_a).pair_count != 0 {
        println("FAIL twist_tracker_new pair_count");
        process_exit(1);
    }

    let tp_a: TwistPair = TwistPair { birth_col: 1, death_col: 4, dimension: 1 };
    let tp_b: TwistPair = TwistPair { birth_col: 1, death_col: 4, dimension: 1 };

    if (tp_a).birth_col != (tp_b).birth_col || (tp_a).birth_col != 1 {
        println("FAIL TwistPair birth_col");
        process_exit(1);
    }

    if (tp_a).death_col != (tp_b).death_col || (tp_a).death_col != 4 {
        println("FAIL TwistPair death_col");
        process_exit(1);
    }

    if (tp_a).dimension != (tp_b).dimension || (tp_a).dimension != 1 {
        println("FAIL TwistPair dimension");
        process_exit(1);
    }

    println("prod_g4_tda_twist: PASSED");
    process_exit(0);
}
