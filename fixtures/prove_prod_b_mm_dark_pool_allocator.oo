// # Product prove std/hft_alpha/mm_dark_pool_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_dark_pool_allocator_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_dark_pool_allocator.oo.
//
// Beats:
//   1. Call mm_dark_pool_allocator_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_dark_pool_allocator: PASSED only if they match.

import "std/hft_alpha/mm_dark_pool_allocator.oo";

pub fn main() {
    let a = mm_dark_pool_allocator_probe();
    let b = mm_dark_pool_allocator_probe();
    if a != b {
        println("FAIL mm_dark_pool_allocator_probe");
        process_exit(1);
    }
    println("prod_mm_dark_pool_allocator: PASSED");
}
