// # Product prove std/aero/navigation_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_vec3_x is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/navigation_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nav_vec3_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_navigation_types: PASSED only if they match.

import "std/aero/navigation_types.oo";

pub fn main() {
    let g0_oa = nav_vec3_new(2, 2, 2);
    let g0_ob = nav_vec3_new(2, 2, 2);
    let g0_a = nav_vec3_x(g0_oa);
    let g0_b = nav_vec3_x(g0_ob);
    if g0_a != g0_b {
        println("FAIL nav_vec3_x");
        process_exit(1);
    }
    println("prod_g0_navigation_types: PASSED");
}
