// # Product prove std/media_dsp/opus_packet_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts opus_parse_toc_byte is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/opus_packet_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call opus_parse_toc_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opus_packet_parser: PASSED only if they match.

import "std/media_dsp/opus_packet_parser.oo";

pub fn main() {
    let g2_oa: OpusToc = opus_parse_toc_byte(2);
    let g2_ob: OpusToc = opus_parse_toc_byte(2);
    let g2_a = (g2_oa).config_id;
    let g2_b = (g2_ob).config_id;
    if g2_a != g2_b {
        println("FAIL opus_parse_toc_byte.config_id");
        process_exit(1);
    }
    println("prod_g2_opus_packet_parser: PASSED");
}
