// # Product prove std/genomics_advanced/pangenome_variation_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts pangenome_variation_graph_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/pangenome_variation_graph.oo.
//
// Beats:
//   1. Call pangenome_variation_graph_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pangenome_variation_graph: PASSED only if they match.

import "std/genomics_advanced/pangenome_variation_graph.oo";

pub fn main() {
    let a = pangenome_variation_graph_probe();
    let b = pangenome_variation_graph_probe();
    if a != b {
        println("FAIL pangenome_variation_graph_probe");
        process_exit(1);
    }
    println("prod_pangenome_variation_graph: PASSED");
}
