// # Product prove std/industrial_iot/sensor_calibration.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_calibration_apply is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/sensor_calibration.oo.
//
// Beats:
//   1. Call linear_calibration_apply twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sensor_calibration: PASSED only if they match.

import "std/industrial_iot/sensor_calibration.oo";

pub fn main() {
    let sensor_calibration_mark: Int = 0;
    if sensor_calibration_mark != 0 {
        process_exit(1);
    }
    let sensor_calibration_obj: LinearCalibration = linear_calibration_new(1.0, 1.0, 1.0, 1.0);
    let sensor_calibration_a: Float = linear_calibration_apply(&sensor_calibration_obj, 1.0);
    let sensor_calibration_b: Float = linear_calibration_apply(&sensor_calibration_obj, 1.0);
    if sensor_calibration_a != sensor_calibration_b {
        println("FAIL linear_calibration_apply");
        process_exit(1);
    }
    println("prod_sensor_calibration: PASSED");
}
