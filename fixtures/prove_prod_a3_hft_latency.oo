// # Product prove std/fin/hft_latency.oo
//
// Logline: Fail-closed emit+gcc+run asserts latency_metrics_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/hft_latency.oo.
//
// Beats:
//   1. Call latency_metrics_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_latency: PASSED only if they match.

import "std/fin/hft_latency.oo";

pub fn main() {
    let hft_latency_mark: Int = 0;
    if hft_latency_mark != 0 {
        process_exit(1);
    }
    let a: LatencyMetrics = latency_metrics_init();
    let b: LatencyMetrics = latency_metrics_init();
    if (a).wire_to_wire_ns != (b).wire_to_wire_ns {
        println("FAIL latency_metrics_init");
        process_exit(1);
    }
    println("prod_hft_latency: PASSED");
}
