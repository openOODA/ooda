// # Product prove std/compilers_polyhedral/polyhedral_scattering_function.oo
//
// Logline: Fail-closed emit+gcc+run asserts scattering_compute_timestamp is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_scattering_function.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call scattering_compute_timestamp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_polyhedral_scattering_function: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_scattering_function.oo";

pub fn main() {
    let g0_oa = scattering_function_new(2, 2);
    let g0_ob = scattering_function_new(2, 2);
    let g0_la = scattering_compute_timestamp(g0_oa, list_new());
    let g0_lb = scattering_compute_timestamp(g0_ob, list_new());
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL scattering_compute_timestamp");
        process_exit(1);
    }
    println("prod_g0_polyhedral_scattering_function: PASSED");
}
