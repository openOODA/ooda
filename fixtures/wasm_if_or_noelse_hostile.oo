// # Hostile if true || x no-else fold
//
// Logline: Print fold-me from if true || x with no else so emit-wasm must miss a const-or no-else fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be false.
//   2. If true || x print fold-me.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = false;
    if true || x {
        println("fold-me");
    }
}
