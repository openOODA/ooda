// # Test Result[List[Struct]] full suite
//
// Logline: Comprehensive test of Result[List[Item]] and Result[List[Header]].
//
// Setup: Backend-C. Custom structs Item and Header.
//
// Beats:
//   1. Item ok, err, match stmt, match let.
//   2. Header ok, err, match stmt, match let.
//   3. Element field checks.

type Item = struct {
    id: Int,
    name: String,
    val: Int
};

type Header = struct {
    title: String,
    count: Int
};

fn make_items_ok() -> Result[List[Item], String] {
    let mut xs: List[Item] = list_new();
    let it1: Item = Item { id: 101, name: "alpha", val: 10 };
    let it2: Item = Item { id: 102, name: "beta", val: 20 };
    xs = list_push(xs, it1);
    xs = list_push(xs, it2);
    return Ok(xs);
}

fn make_items_err() -> Result[List[Item], String] {
    return Err("item_load_failed");
}

fn test_items() {
    let empty_items: List[Item] = list_new();

    let r1: Result[List[Item], String] = make_items_ok();
    match r1 {
        Ok(items) => {
            if list_len(items) != 2 {
                println("FAIL items len");
                process_exit(1);
            }
            let i0: Item = list_get(items, 0);
            if i0.id != 101 || i0.name != "alpha" || i0.val != 10 {
                println("FAIL item 0");
                process_exit(1);
            }
            let i1: Item = list_get(items, 1);
            if i1.id != 102 || i1.name != "beta" || i1.val != 20 {
                println("FAIL item 1");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL r1 err");
            process_exit(1);
        }
    }

    let r2: Result[List[Item], String] = make_items_err();
    match r2 {
        Ok(items) => {
            println("FAIL r2 ok");
            process_exit(1);
        }
        Err(e) => {
            if e != "item_load_failed" {
                println("FAIL r2 err msg");
                process_exit(1);
            }
        }
    }

    let r3: Result[List[Item], String] = make_items_ok();
    let xs_ok: List[Item] = match r3 {
        Ok(v) => v,
        Err(e) => empty_items
    };
    if list_len(xs_ok) != 2 {
        println("FAIL match let ok len");
        process_exit(1);
    }

    let r4: Result[List[Item], String] = make_items_err();
    let xs_err: List[Item] = match r4 {
        Ok(v) => v,
        Err(e) => empty_items
    };
    if list_len(xs_err) != 0 {
        println("FAIL match let err len");
        process_exit(1);
    }
}

fn make_headers_ok() -> Result[List[Header], String] {
    let mut hs: List[Header] = list_new();
    let h1: Header = Header { title: "Content-Type", count: 1 };
    hs = list_push(hs, h1);
    return Ok(hs);
}

fn make_headers_err() -> Result[List[Header], String] {
    return Err("header_err");
}

fn test_headers() {
    let empty_headers: List[Header] = list_new();

    let rh1: Result[List[Header], String] = make_headers_ok();
    match rh1 {
        Ok(hs) => {
            if list_len(hs) != 1 {
                println("FAIL hs len");
                process_exit(1);
            }
            let h0: Header = list_get(hs, 0);
            if h0.title != "Content-Type" || h0.count != 1 {
                println("FAIL header 0");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL rh1 err");
            process_exit(1);
        }
    }

    let rh2: Result[List[Header], String] = make_headers_err();
    match rh2 {
        Ok(hs) => {
            println("FAIL rh2 ok");
            process_exit(1);
        }
        Err(e) => {
            if e != "header_err" {
                println("FAIL rh2 msg");
                process_exit(1);
            }
        }
    }

    let rh3: Result[List[Header], String] = make_headers_err();
    let hs_err: List[Header] = match rh3 {
        Ok(v) => v,
        Err(e) => empty_headers
    };
    if list_len(hs_err) != 0 {
        println("FAIL rh3 fallback len");
        process_exit(1);
    }
}

pub fn main() {
    test_items();
    test_headers();
    println("adv_result_list_struct_basic: PASSED");
}
