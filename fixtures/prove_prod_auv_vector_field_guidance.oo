// # Product prove std/robotics_auv/auv_vector_field_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_field_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_vector_field_guidance.oo.
//
// Beats:
//   1. Call vector_field_config_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_vector_field_guidance: PASSED only if they match.

import "std/robotics_auv/auv_vector_field_guidance.oo";

pub fn main() {
    let auv_vector_field_guidance_mark: Int = 0;
    if auv_vector_field_guidance_mark != 0 {
        process_exit(1);
    }
    let a: VectorFieldConfig = vector_field_config_default();
    let b: VectorFieldConfig = vector_field_config_default();
    if (a).field0 != (b).field0 {
        println("FAIL vector_field_config_default");
        process_exit(1);
    }
    println("prod_auv_vector_field_guidance: PASSED");
}
