// # Product prove std/compilers_polyhedral/affine_expression_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts affine_row_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_expression_matrix.oo.
//
// Beats:
//   1. Call affine_row_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_affine_expression_matrix: PASSED only if they match.

import "std/compilers_polyhedral/affine_expression_matrix.oo";

pub fn main() {
    let affine_expression_matrix_mark: Int = 0;
    if affine_expression_matrix_mark != 0 {
        process_exit(1);
    }
    let a: AffineRow = affine_row_new();
    let b: AffineRow = affine_row_new();
    if (a).length != (b).length {
        println("FAIL affine_row_new");
        process_exit(1);
    }
    println("prod_affine_expression_matrix: PASSED");
}
