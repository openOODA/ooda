// # Product prove std/fin/yield_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts compounding_type_to_string is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_ops.oo.
//
// Beats:
//   1. Call compounding_type_to_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_ops: PASSED only if they match.

import "std/fin/yield_ops.oo";

pub fn main() {
    let yield_ops_mark: Int = 0;
    if yield_ops_mark != 0 {
        process_exit(1);
    }
    let a: String = compounding_type_to_string(0);
    let b: String = compounding_type_to_string(0);
    if a != b {
        println("FAIL compounding_type_to_string");
        process_exit(1);
    }
    println("prod_yield_ops: PASSED");
}
