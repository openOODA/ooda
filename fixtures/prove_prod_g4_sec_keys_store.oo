// # Product prove std/crypto/keys_store.oo
//
// Logline: Fail-closed verification that KeyStore management, storage mutations, and key retrieval are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys_store.oo.
//
// Beats:
//   1. Initialize KeyStore container and verify initial key count.
//   2. Add SecretKey to store and verify updated count.
//   3. Retrieve secret key by ID and verify non-existent key fails closed.
//   4. Print prod_g4_sec_keys_store: PASSED and exit 0.

import "std/crypto/keys_store.oo";

pub fn main() {
    let pol: KeyStorePolicy = keystore_policy_init(false, 10, true, false);
    let mut ks: KeyStore = keystore_init("store1", pol, "secret123");

    let count0: Int = keystore_count_keys(&ks);
    if count0 != 0 {
        println("FAIL keystore_count_keys initial");
        process_exit(1);
    }

    let meta: KeyMetadata = key_metadata_create("key_s1", "AES", 0, 256, 1, 100, 200);
    let sk: SecretKey = secret_key_create(meta, "mysecretbytes123");

    let add_res: Result[Int, String] = keystore_add_secret_key(&mut ks, sk);
    if add_res.is_err() {
        println("FAIL keystore_add_secret_key is_err");
        process_exit(1);
    }

    let count1: Int = keystore_count_keys(&ks);
    if count1 != 1 {
        println("FAIL keystore_count_keys after add");
        process_exit(1);
    }

    let get_res: Result[SecretKey, String] = keystore_get_secret_key(&ks, "key_s1");
    if get_res.is_err() {
        println("FAIL keystore_get_secret_key found is_err");
        process_exit(1);
    }

    let miss_res: Result[SecretKey, String] = keystore_get_secret_key(&ks, "key_missing");
    if miss_res.is_ok() {
        println("FAIL keystore_get_secret_key missing was ok");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_crypto_keys_store_oo();
    if dummy != 0 {
        println("FAIL __dummy_std_src_ooda_crypto_keys_store_oo");
        process_exit(1);
    }

    println("prod_g4_sec_keys_store: PASSED");
    process_exit(0);
}
