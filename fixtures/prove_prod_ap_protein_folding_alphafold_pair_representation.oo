// # Product prove std/protein_folding/alphafold_pair_representation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/protein_folding/alphafold_pair_representation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/alphafold_pair_representation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_alphafold_pair_representation: PASSED only if they match.

import "std/protein_folding/alphafold_pair_representation.oo";

pub fn main() {
    let alphafold_pair_representation_a = af_sigmoid_approx(0.0);
    let alphafold_pair_representation_b = af_sigmoid_approx(0.0);
    if alphafold_pair_representation_a != alphafold_pair_representation_b {
        println("FAIL alphafold_pair_representation");
        process_exit(1);
    }
    println("prod_ap_alphafold_pair_representation: PASSED");
}
