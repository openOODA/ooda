// # Product prove std/web_ecosystem/nanoid_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanoid_next_rand is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/nanoid_generator.oo.
//
// Beats:
//   1. Call nanoid_next_rand twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanoid_generator: PASSED only if they match.

import "std/web_ecosystem/nanoid_generator.oo";

pub fn main() {
    let nanoid_generator_mark: Int = 0;
    if nanoid_generator_mark != 0 {
        process_exit(1);
    }
    let a: Int = nanoid_next_rand(0);
    let b: Int = nanoid_next_rand(0);
    if a != b {
        println("FAIL nanoid_next_rand");
        process_exit(1);
    }
    println("prod_nanoid_generator: PASSED");
}
