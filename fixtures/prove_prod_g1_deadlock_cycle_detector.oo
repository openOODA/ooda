// # Product prove std/formal_verif/deadlock_cycle_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts deadlock_detector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/deadlock_cycle_detector.oo.
//
// Beats:
//   1. Call deadlock_detector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_deadlock_cycle_detector: PASSED only if they match.

import "std/formal_verif/deadlock_cycle_detector.oo";

pub fn main() {
    let a: DeadlockDetector = deadlock_detector_new();
    let b: DeadlockDetector = deadlock_detector_new();
    if a.edge_count != 0 {
        println("FAIL deadlock_detector_new");
        process_exit(1);
    }
    if a.edge_count != b.edge_count {
        println("FAIL deadlock_detector_new");
        process_exit(1);
    }
    println("prod_deadlock_cycle_detector: PASSED");
}
