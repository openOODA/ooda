// # Product prove std/ai_multimodal/unet_residual_block_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts unet_res_silu is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_residual_block_2d.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call unet_res_silu twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_unet_residual_block_2d: PASSED only if they match.

import "std/ai_multimodal/unet_residual_block_2d.oo";

pub fn main() {
    let g0_a = unet_res_silu(1.0);
    let g0_b = unet_res_silu(1.0);
    if g0_a != g0_b {
        println("FAIL unet_res_silu");
        process_exit(1);
    }
    println("prod_g0_unet_residual_block_2d: PASSED");
}
