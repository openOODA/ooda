// # Product prove std/robotics_ros2/collision_octree_voxel_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts octree_node_new is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/collision_octree_voxel_map.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call octree_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_collision_octree_voxel_map: PASSED only if they match.

import "std/robotics_ros2/collision_octree_voxel_map.oo";

pub fn main() {
    let g2_oa: OctreeNode = octree_node_new(1.0, 1.0, 1.0, 1.0);
    let g2_ob: OctreeNode = octree_node_new(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).center_x;
    let g2_b = (g2_ob).center_x;
    if g2_a != g2_b {
        println("FAIL octree_node_new.center_x");
        process_exit(1);
    }
    println("prod_g2_collision_octree_voxel_map: PASSED");
}
