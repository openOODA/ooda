// # Product prove std/astrodynamics/hohmann_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts hohmann_burns is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/hohmann_transfer.oo.
//
// Beats:
//   1. Call hohmann_burns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hohmann_transfer: PASSED only if they match.

import "std/astrodynamics/hohmann_transfer.oo";

pub fn main() {
    let hohmann_transfer_mark: Int = 0;
    if hohmann_transfer_mark != 0 {
        process_exit(1);
    }
    let a: Int = hohmann_burns();
    let b: Int = hohmann_burns();
    if a != b {
        println("FAIL hohmann_burns");
        process_exit(1);
    }
    println("prod_hohmann_transfer: PASSED");
}
