// # Product prove std/db_graph/graph_betweenness_centrality.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_betweenness_centrality.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_betweenness_centrality.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_betweenness_centrality: PASSED only if they match.

import "std/db_graph/graph_betweenness_centrality.oo";

pub fn main() {
    let graph_betweenness_centrality_a = centrality_score_new(0, 0.0);
    let graph_betweenness_centrality_b = centrality_score_new(0, 0.0);
    if graph_betweenness_centrality_a.node_id != graph_betweenness_centrality_b.node_id {
        println("FAIL graph_betweenness_centrality");
        process_exit(1);
    }
    println("prod_ap_graph_betweenness_centrality: PASSED");
}
