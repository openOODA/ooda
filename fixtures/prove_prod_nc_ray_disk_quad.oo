// # Product prove std/pbr_raytracing/ray_disk_quad.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_disk_quad_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/ray_disk_quad.oo.
//
// Beats:
//   1. Call ray_disk_quad_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ray_disk_quad: PASSED only if it matches.

import "std/pbr_raytracing/ray_disk_quad.oo";

pub fn main() {
    let a: Int = ray_disk_quad_probe();
    if a != 0 {
        println("FAIL ray_disk_quad_probe");
        process_exit(1);
    }
    println("prod_nc_ray_disk_quad: PASSED");
}
