// # Product prove std/grid/freq.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/freq.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_grid_freq: PASSED and exit 0 only on match.

import "std/grid/freq.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_grid_freq_oo();
    let dummy_b: Int = __dummy_std_src_ooda_grid_freq_oo();
    if dummy_a != dummy_b {
        println("FAIL grid_freq dummy");
        process_exit(1);
    }

    let stable_a: Bool = shim_marker_freq_is_stable();
    let stable_b: Bool = shim_marker_freq_is_stable();
    if stable_a != stable_b {
        println("FAIL shim_marker_freq_is_stable");
        process_exit(1);
    }

    let dev_a: Float = shim_marker_freq_dev_pu();
    let dev_b: Float = shim_marker_freq_dev_pu();
    if dev_a != dev_b {
        println("FAIL shim_marker_freq_dev_pu");
        process_exit(1);
    }

    let freq_a: GridFrequency = shim_marker_freq_default();
    let freq_b: GridFrequency = shim_marker_freq_default();
    let updated_a: GridFrequency = shim_marker_freq_update(freq_a, 59.95, 0.1);
    let updated_b: GridFrequency = shim_marker_freq_update(freq_b, 59.95, 0.1);
    let cur_hz_a: Float = updated_a.current_hz;
    let cur_hz_b: Float = updated_b.current_hz;
    if cur_hz_a != cur_hz_b {
        println("FAIL shim_marker_freq_update current_hz");
        process_exit(1);
    }

    println("prod_g4_grid_freq: PASSED");
    process_exit(0);
}
