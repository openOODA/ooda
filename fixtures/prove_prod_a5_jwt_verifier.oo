// # Product prove std/web_ecosystem/jwt_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_clock_skew_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_verifier.oo.
//
// Beats:
//   1. Call jwt_clock_skew_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jwt_verifier: PASSED only if they match.

import "std/web_ecosystem/jwt_verifier.oo";

pub fn main() {
    let jwt_verifier_mark: Int = 0;
    if jwt_verifier_mark != 0 {
        process_exit(1);
    }
    let a: Int = jwt_clock_skew_default();
    let b: Int = jwt_clock_skew_default();
    if a != b {
        println("FAIL jwt_clock_skew_default");
        process_exit(1);
    }
    println("prod_jwt_verifier: PASSED");
}
