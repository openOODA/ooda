// # Product prove std/db_columnar/parquet_thrift_metadata.oo
//
// Logline: Fail-closed emit+gcc+run asserts schema_element_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_thrift_metadata.oo.
//
// Beats:
//   1. Call schema_element_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_thrift_metadata: PASSED only if they match.

import "std/db_columnar/parquet_thrift_metadata.oo";

pub fn main() {
    let parquet_thrift_metadata_mark: Int = 0;
    if parquet_thrift_metadata_mark != 0 {
        process_exit(1);
    }
    let a: SchemaElement = schema_element_new("x", 0, 0, 0);
    let b: SchemaElement = schema_element_new("x", 0, 0, 0);
    if (a).type_code != (b).type_code {
        println("FAIL schema_element_new");
        process_exit(1);
    }
    println("prod_parquet_thrift_metadata: PASSED");
}
