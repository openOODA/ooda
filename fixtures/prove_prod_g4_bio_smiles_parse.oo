// # Product prove std/bio/smiles_parse.oo
//
// Logline: Fail-closed verification that SMILES parsing and atom-bond operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_parse.oo.
//
// Beats:
//   1. Query atomic symbols to atomic numbers and centi-dalton weights.
//   2. Create Bond instances and verify bond properties.
//   3. Initialize SmilesMolecule and verify molecular weight calculation.
//   4. Print prod_g4_bio_smiles_parse: PASSED and exit 0.

import "std/bio/smiles_parse.oo";

pub fn main() {
    let z_c1: Int = atom_symbol_to_number("C");
    let z_c2: Int = atom_symbol_to_number("C");
    if z_c1 != z_c2 || z_c1 != 6 {
        println("FAIL atom_symbol_to_number C");
        process_exit(1);
    }

    let z_n: Int = atom_symbol_to_number("N");
    let z_o: Int = atom_symbol_to_number("O");
    if z_n != 7 || z_o != 8 {
        println("FAIL atom_symbol_to_number N/O");
        process_exit(1);
    }

    let w_c1: Int = atom_atomic_weight(6);
    let w_c2: Int = atom_atomic_weight(6);
    if w_c1 != w_c2 || w_c1 != 1201 {
        println("FAIL atom_atomic_weight");
        process_exit(1);
    }

    let b1: Bond = bond_create(0, 1, 1, 0);
    let b2: Bond = bond_create(0, 1, 1, 0);
    if (b1).atom1_idx != (b2).atom1_idx || (b1).bond_type != 1 {
        println("FAIL bond_create");
        process_exit(1);
    }

    let mol1: SmilesMolecule = smiles_molecule_init("CC");
    let mol2: SmilesMolecule = smiles_molecule_init("CC");
    let mw1: Int = smiles_molecule_weight(mol1);
    let mw2: Int = smiles_molecule_weight(mol2);
    if mw1 != mw2 || mw1 != 0 {
        println("FAIL smiles_molecule_weight");
        process_exit(1);
    }

    let a1: Atom = smiles_atom_new(6, 0, 4);
    let a_w1: Int = smiles_atom_weight_with_h(a1);
    let a_w2: Int = smiles_atom_weight_with_h(a1);
    if a_w1 != a_w2 || a_w1 != 1201 {
        println("FAIL smiles_atom_weight_with_h");
        process_exit(1);
    }

    println("prod_g4_bio_smiles_parse: PASSED");
    process_exit(0);
}
