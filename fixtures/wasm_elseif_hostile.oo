// # Hostile else-if IDENT fold
//
// Logline: Print elif-yes or fold-me from else if x so emit-wasm must miss a const else-if fold.
//
// Setup: One public main. Else-if condition is IDENT x, not KW_FALSE.
//
// Beats:
//   1. Let x be false.
//   2. If true print elif-yes else if x print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = false;
    if true {
        println("elif-yes");
    } else if x {
        println("fold-me");
    } else {
        println("other");
    }
}
