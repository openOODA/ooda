// # Product prove std/telecom_5g/sync_costas_loop.oo
//
// Logline: Fail-closed emit+gcc+run asserts sync_costas_ped_qpsk is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_costas_loop.oo.
//
// Beats:
//   1. Call sync_costas_ped_qpsk twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sync_costas_loop: PASSED only if they match.

import "std/telecom_5g/sync_costas_loop.oo";

pub fn main() {
    let sync_costas_loop_mark: Int = 0;
    if sync_costas_loop_mark != 0 {
        process_exit(1);
    }
    let a: Float = sync_costas_ped_qpsk(0.0, 0.0);
    let b: Float = sync_costas_ped_qpsk(0.0, 0.0);
    if a != b {
        println("FAIL sync_costas_ped_qpsk");
        process_exit(1);
    }
    println("prod_sync_costas_loop: PASSED");
}
