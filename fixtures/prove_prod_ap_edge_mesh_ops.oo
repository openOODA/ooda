// # Product prove std/edge/mesh_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/mesh_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/mesh_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mesh_ops: PASSED only if they match.

import "std/edge/mesh_ops.oo";

pub fn main() {
    let mesh_ops_a = mesh_link_init(0, 0, 0);
    let mesh_ops_b = mesh_link_init(0, 0, 0);
    let mesh_ops_va = mesh_link_is_healthy(mesh_ops_a);
    let mesh_ops_vb = mesh_link_is_healthy(mesh_ops_b);
    if mesh_ops_va != mesh_ops_vb {
        println("FAIL mesh_ops");
        process_exit(1);
    }
    println("prod_ap_mesh_ops: PASSED");
}
