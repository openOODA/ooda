// # Product prove std/zk_rollup/plonk_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_verifying_key_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_verifier.oo.
//
// Beats:
//   1. Call plonk_verifying_key_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_plonk_verifier: PASSED only if asserts hold.

import "std/zk_rollup/plonk_verifier.oo";

pub fn main() {
    let plonk_verifier = plonk_verifying_key_new(0);
    let plonk_verifier_b = plonk_verifying_key_new(0);
    if plonk_verifier.domain_size != plonk_verifier_b.domain_size {
        println("FAIL plonk_verifying_key_new");
        process_exit(1);
    }
    println("prod_plonk_verifier: PASSED");
}
