// # Product prove std/web_ecosystem/color_chalk.oo
//
// Logline: Fail-closed emit+gcc+run asserts chalk_wrap is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/color_chalk.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chalk_wrap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_color_chalk: PASSED only if they match.

import "std/web_ecosystem/color_chalk.oo";

pub fn main() {
    let g0_a = chalk_wrap("x", "x", "x");
    let g0_b = chalk_wrap("x", "x", "x");
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL chalk_wrap");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL chalk_wrap");
        process_exit(1);
    }
    println("prod_gr_color_chalk: PASSED");
}
