// # Product prove std/zk_rollup/fri_folding_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts fri_layer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/fri_folding_operator.oo.
//
// Beats:
//   1. Call fri_layer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fri_folding_operator: PASSED only if they match.

import "std/zk_rollup/fri_folding_operator.oo";

pub fn main() {
    let fri_folding_operator_mark: Int = 0;
    if fri_folding_operator_mark != 0 {
        process_exit(1);
    }
    let a: FriLayer = fri_layer_new(0, 0, 0, 0, 0, 0);
    let b: FriLayer = fri_layer_new(0, 0, 0, 0, 0, 0);
    if (a).round_index != (b).round_index {
        println("FAIL fri_layer_new");
        process_exit(1);
    }
    println("prod_fri_folding_operator: PASSED");
}
