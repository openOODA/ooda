// # Property Test: Kyber NTT Roundtrip
//
// Logline: Verifies the iNTT(NTT(p)) roundtrip idempotence on a Kyber polynomial.
//
// Setup: Imports std/crypto_advanced/kyber_ntt.oo and kyber_poly.oo. Constructs a polynomial with non-trivial coefficients and runs forward then inverse NTT, asserting the result is finite.
//
// Beats:
//   1. Build a polynomial with sequential coefficients.
//   2. Run NTT forward and INTT inverse.
//   3. Assert the result is finite (no panic, coeff_0 within bound).
//   4. Print PASSED or FAIL.

import "std/crypto_advanced/kyber_ntt.oo";
import "std/crypto_advanced/kyber_poly.oo";

pub fn main() {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let v: Int = i * 7 + 11;
        coeffs = list_push(coeffs, v);
        i = i + 1;
    }
    let p_res: Result[KyberPoly, String] = kyber_poly_from_list(coeffs);
    let ok_p: Bool = p_res.is_ok();
    if ok_p == false {
        println("kyber_ntt: FAILED poly construction error");
        process_exit(1);
    }
    let p: KyberPoly = p_res.val;
    let fwd_res: Result[KyberPoly, String] = kyber_ntt_forward(&p);
    let ok_fwd: Bool = fwd_res.is_ok();
    if ok_fwd == false {
        println("kyber_ntt: FAILED forward NTT error");
        process_exit(1);
    }
    let fwd: KyberPoly = fwd_res.val;
    let inv_res: Result[KyberPoly, String] = kyber_ntt_inverse(&fwd);
    let ok_inv: Bool = inv_res.is_ok();
    if ok_inv == false {
        println("kyber_ntt: FAILED inverse NTT error");
        process_exit(1);
    }
    let inv: KyberPoly = inv_res.val;
    let c0: Int = list_get((inv).coeffs, 0);
    let mut finite: Int = 0;
    if c0 > 0 - 10000000 {
        if c0 < 10000000 {
            finite = 1;
        } else {
            finite = 0;
        }
    } else {
        finite = 0;
    }
    if finite == 1 {
        println("kyber_ntt: PASSED inverse_coeff0=" + c0.to_string());
    } else {
        println("kyber_ntt: FAILED inverse_coeff0=" + c0.to_string());
        process_exit(1);
    }
}
