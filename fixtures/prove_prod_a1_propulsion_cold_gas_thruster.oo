// # Product prove std/astro_advanced/propulsion_cold_gas_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts cold_gas_isp is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/propulsion_cold_gas_thruster.oo.
//
// Beats:
//   1. Call cold_gas_isp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propulsion_cold_gas_thruster: PASSED only if they match.

import "std/astro_advanced/propulsion_cold_gas_thruster.oo";

pub fn main() {
    let propulsion_cold_gas_thruster_mark: Int = 0;
    if propulsion_cold_gas_thruster_mark != 0 {
        process_exit(1);
    }
    let a: Int = cold_gas_isp();
    let b: Int = cold_gas_isp();
    if a != b {
        println("FAIL cold_gas_isp");
        process_exit(1);
    }
    println("prod_propulsion_cold_gas_thruster: PASSED");
}
