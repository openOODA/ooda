// # Product prove std/astro_advanced/chemical_propulsion_isentropic.oo
//
// Logline: Fail-closed emit+gcc+run asserts isen_gamma is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/chemical_propulsion_isentropic.oo.
//
// Beats:
//   1. Call isen_gamma twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chemical_propulsion_isentropic: PASSED only if they match.

import "std/astro_advanced/chemical_propulsion_isentropic.oo";

pub fn main() {
    let a = isen_gamma();
    let b = isen_gamma();
    if a != b {
        println("FAIL isen_gamma");
        process_exit(1);
    }
    println("prod_chemical_propulsion_isentropic: PASSED");
}
