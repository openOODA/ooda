// # Product prove std/astrophysics_relativity/stellar_atmosphere_grey.oo
//
// Logline: Fail-closed emit+gcc+run asserts grey_atmosphere_temperature is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_atmosphere_grey.oo.
//
// Beats:
//   1. Call grey_atmosphere_temperature twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_atmosphere_grey: PASSED only if they match.

import "std/astrophysics_relativity/stellar_atmosphere_grey.oo";

pub fn main() {
    let stellar_atmosphere_grey_mark: Int = 0;
    if stellar_atmosphere_grey_mark != 0 {
        process_exit(1);
    }
    let a: Float = grey_atmosphere_temperature(0.0, 0.0);
    let b: Float = grey_atmosphere_temperature(0.0, 0.0);
    if a != b {
        println("FAIL grey_atmosphere_temperature");
        process_exit(1);
    }
    println("prod_stellar_atmosphere_grey: PASSED");
}
