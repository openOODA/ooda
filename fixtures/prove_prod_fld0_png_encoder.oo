// # Product prove std/multimedia/png_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_encoder.oo.
//
// Beats:
//   1. Call png_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_png_encoder: PASSED only if they match.

import "std/multimedia/png_encoder.oo";

pub fn main() {
    let png_encoder_mark: Int = 0;
    if png_encoder_mark != 0 {
        process_exit(1);
    }
    let png_encoder_a: Int = png_abs(1);
    let png_encoder_b: Int = png_abs(1);
    if png_encoder_a != png_encoder_b {
        println("FAIL png_abs");
        process_exit(1);
    }
    println("prod_png_encoder: PASSED");
}
