// # Product prove std/crypto/fhe_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_context_do_work is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_stubs.oo.
//
// Beats:
//   1. Call fhe_context_do_work twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_stubs: PASSED only if they match.

import "std/crypto/fhe_stubs.oo";

pub fn main() {
    let fhe_stubs_mark: Int = 0;
    if fhe_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = fhe_context_do_work(0, 0, 0);
    let b: Int = fhe_context_do_work(0, 0, 0);
    if a != b {
        println("FAIL fhe_context_do_work");
        process_exit(1);
    }
    println("prod_g2_fhe_stubs: PASSED");
}
