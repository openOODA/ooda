// # Product prove std/multimedia/color_yuv.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_yuv420_buffer_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/color_yuv.oo.
//
// Beats:
//   1. Call color_yuv420_buffer_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_color_yuv: PASSED only if they match.

import "std/multimedia/color_yuv.oo";

pub fn main() {
    let color_yuv_mark: Int = 0;
    if color_yuv_mark != 0 {
        process_exit(1);
    }
    let color_yuv_a: Int = color_yuv420_buffer_bytes(1, 1);
    let color_yuv_b: Int = color_yuv420_buffer_bytes(1, 1);
    if color_yuv_a != color_yuv_b {
        println("FAIL color_yuv420_buffer_bytes");
        process_exit(1);
    }
    println("prod_color_yuv: PASSED");
}
