// # Product prove std/telecom_5g/dsp_hilbert_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_hilbert_tap_coeff value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_hilbert_transform.oo.
//
// Beats:
//   1. Call dsp_hilbert_tap_coeff twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_dsp_hilbert_transform: PASSED only if asserts hold.

import "std/telecom_5g/dsp_hilbert_transform.oo";

pub fn main() {
    let dsp_hilbert_transform_a: Float = dsp_hilbert_tap_coeff(0, 0);
    let dsp_hilbert_transform_b: Float = dsp_hilbert_tap_coeff(0, 0);
    if dsp_hilbert_transform_a != dsp_hilbert_transform_b {
        println("FAIL dsp_hilbert_tap_coeff");
        process_exit(1);
    }
    println("prod_dsp_hilbert_transform: PASSED");
}
