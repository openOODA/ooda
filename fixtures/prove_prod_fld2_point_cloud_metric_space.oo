// # Product prove std/tda_topology/point_cloud_metric_space.oo
//
// Logline: Fail-closed emit+gcc+run asserts point_cloud_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/point_cloud_metric_space.oo.
//
// Beats:
//   1. Call point_cloud_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_point_cloud_metric_space: PASSED only if they match.

import "std/tda_topology/point_cloud_metric_space.oo";

pub fn main() {
    let point_cloud_metric_space_mark: Int = 0;
    if point_cloud_metric_space_mark != 0 {
        process_exit(1);
    }
    let point_cloud_metric_space_a = point_cloud_new(1);
    let point_cloud_metric_space_b = point_cloud_new(1);
    if (point_cloud_metric_space_a).point_count != (point_cloud_metric_space_b).point_count {
        println("FAIL point_cloud_new");
        process_exit(1);
    }
    println("prod_point_cloud_metric_space: PASSED");
}
