// # Product prove std/compilers_vm/bytecode_profiler_telemetry.oo
//
// Logline: Fail-closed emit+gcc+run asserts branch_feedback_new is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_profiler_telemetry.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call branch_feedback_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bytecode_profiler_telemetry: PASSED only if they match.

import "std/compilers_vm/bytecode_profiler_telemetry.oo";

pub fn main() {
    let g2_oa: BranchFeedback = branch_feedback_new(2);
    let g2_ob: BranchFeedback = branch_feedback_new(2);
    let g2_a = (g2_oa).branch_bc_offset;
    let g2_b = (g2_ob).branch_bc_offset;
    if g2_a != g2_b {
        println("FAIL branch_feedback_new.branch_bc_offset");
        process_exit(1);
    }
    println("prod_g2_bytecode_profiler_telemetry: PASSED");
}
