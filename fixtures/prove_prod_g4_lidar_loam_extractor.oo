// # Product prove std/lidar_perception/loam_feature_extractor.oo
//
// Logline: Fail-closed verification that LOAM feature configuration, curvature calculation, and edge/plane classification are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/loam_feature_extractor.oo.
//
// Beats:
//   1. Construct default LOAMFeatureConfig.
//   2. Compute point smoothness curvature metric.
//   3. Classify high-curvature edge point and low-curvature planar point.
//   4. Assert deterministic feature classification and curvature values.
//   5. Print prod_g4_lidar_loam_extractor: PASSED and exit 0.

import "std/lidar_perception/loam_feature_extractor.oo";

pub fn main() {
    let cfg1: LOAMFeatureConfig = loam_feature_config_default();
    let cfg2: LOAMFeatureConfig = loam_feature_config_default();

    if (cfg1).edge_threshold != (cfg2).edge_threshold || (cfg1).edge_threshold != 0.1 {
        println("FAIL loam_feature_config_default edge_threshold");
        process_exit(1);
    }
    if (cfg1).surf_threshold != (cfg2).surf_threshold || (cfg1).surf_threshold != 0.05 {
        println("FAIL loam_feature_config_default surf_threshold");
        process_exit(1);
    }
    if (cfg1).neighbor_window != (cfg2).neighbor_window || (cfg1).neighbor_window != 5 {
        println("FAIL loam_feature_config_default neighbor_window");
        process_exit(1);
    }

    let center: Point3D = Point3D { x: 10.0, y: 0.0, z: 0.0 };
    let curv1: Float = loam_compute_curvature(&center, 1.0, 0.0, 0.0, 5);
    let curv2: Float = loam_compute_curvature(&center, 1.0, 0.0, 0.0, 5);
    if curv1 != curv2 || curv1 <= 0.0 {
        println("FAIL loam_compute_curvature");
        process_exit(1);
    }

    let pt: PointXYZI = PointXYZI {
        x: 10.0,
        y: 5.0,
        z: 1.0,
        intensity: 50.0,
    };

    let feat_edge1: FeaturePointType = loam_classify_feature(&pt, 0.25, &cfg1);
    let feat_edge2: FeaturePointType = loam_classify_feature(&pt, 0.25, &cfg2);
    if (feat_edge1).is_edge != (feat_edge2).is_edge || !(feat_edge1).is_edge {
        println("FAIL loam_classify_feature edge");
        process_exit(1);
    }
    if (feat_edge1).is_plane {
        println("FAIL loam_classify_feature edge not plane");
        process_exit(1);
    }

    let feat_plane1: FeaturePointType = loam_classify_feature(&pt, 0.02, &cfg1);
    let feat_plane2: FeaturePointType = loam_classify_feature(&pt, 0.02, &cfg2);
    if (feat_plane1).is_plane != (feat_plane2).is_plane || !(feat_plane1).is_plane {
        println("FAIL loam_classify_feature plane");
        process_exit(1);
    }
    if (feat_plane1).is_edge {
        println("FAIL loam_classify_feature plane not edge");
        process_exit(1);
    }

    println("prod_g4_lidar_loam_extractor: PASSED");
    process_exit(0);
}
