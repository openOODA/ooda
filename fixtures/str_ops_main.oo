// # Probe owned string free names
//
// Logline: Print starts_with, ends_with, index_of, repeat, and uppercase over owned strings.
//
// Setup: Test fixture. Free names only. Keep all code exact.
//
// Beats:
//   1. Print prefix and suffix checks.
//   2. Print index_of hits and misses.
//   3. Print repeat and uppercase.
//
// M165 path A: owned string free names (not &str borrow / lifetimes)
// Free names only so oodac rebuild ships without std import.
pub fn main() {
    println(str_starts_with("hello", "he"));
    println(str_starts_with("hello", "lo"));
    println(str_ends_with("hello", "lo"));
    println(str_ends_with("hello", "he"));
    println(str_index_of("hello", "ll"));
    println(str_index_of("hello", "z"));
    println(str_repeat("ab", 3));
    println(str_to_uppercase("Hi"));
}
