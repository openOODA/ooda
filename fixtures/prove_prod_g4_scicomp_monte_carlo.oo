// # Product prove std/scicomp/monte_carlo_integrator.oo
//
// Logline: Fail-closed verification that LCG pseudorandom generation and Monte Carlo sample accumulation are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/monte_carlo_integrator.oo.
//
// Beats:
//   1. Initialize LCG RNG with seed and generate pseudo-random uniform floats.
//   2. Accumulate sample list to compute integral estimate, standard error, and bounds.
//   3. Assert identical values across seeded runs.
//   4. Print prod_g4_scicomp_monte_carlo: PASSED and exit 0.

import "std/scicomp/monte_carlo_integrator.oo";

pub fn main() {
    let mut rng1: LcgRng = lcg_rng_new(12345);
    let mut rng2: LcgRng = lcg_rng_new(12345);

    let f1: Float = lcg_next_float(&mut rng1);
    let f2: Float = lcg_next_float(&mut rng2);

    if f1 != f2 || f1 < 0.0 || f1 > 1.0 {
        println("FAIL lcg_next_float first");
        process_exit(1);
    }

    let f1_b: Float = lcg_next_float(&mut rng1);
    let f2_b: Float = lcg_next_float(&mut rng2);

    if f1_b != f2_b || f1_b < 0.0 || f1_b > 1.0 {
        println("FAIL lcg_next_float second");
        process_exit(1);
    }

    let mut samples: List[Float] = list_new();
    samples = list_push(samples, 2.0);
    samples = list_push(samples, 4.0);
    samples = list_push(samples, 6.0);

    let res1: MonteCarloResult = monte_carlo_accumulate(&samples, 2.0);
    let res2: MonteCarloResult = monte_carlo_accumulate(&samples, 2.0);

    if (res1).num_samples != (res2).num_samples || (res1).num_samples != 3 {
        println("FAIL monte_carlo_accumulate num_samples");
        process_exit(1);
    }

    if (res1).integral_estimate != (res2).integral_estimate || (res1).integral_estimate < 7.999 || (res1).integral_estimate > 8.001 {
        println("FAIL monte_carlo_accumulate integral_estimate");
        process_exit(1);
    }

    println("prod_g4_scicomp_monte_carlo: PASSED");
    process_exit(0);
}
