// # Product prove std/security_defense/chroot_jail_isolator.oo
//
// Logline: Fail-closed emit+gcc+run asserts chroot_jail_is_path_safe is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/chroot_jail_isolator.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chroot_jail_is_path_safe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_chroot_jail_isolator: PASSED only if they match.

import "std/security_defense/chroot_jail_isolator.oo";

pub fn main() {
    let g0_a = chroot_jail_is_path_safe("x");
    let g0_b = chroot_jail_is_path_safe("x");
    if g0_a != g0_b {
        println("FAIL chroot_jail_is_path_safe");
        process_exit(1);
    }
    println("prod_gr_chroot_jail_isolator: PASSED");
}
