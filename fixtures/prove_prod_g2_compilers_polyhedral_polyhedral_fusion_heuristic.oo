// # Product prove std/compilers_polyhedral/polyhedral_fusion_heuristic.oo
//
// Logline: Fail-closed emit+gcc+run asserts evaluate_fusion_legality is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_fusion_heuristic.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call evaluate_fusion_legality twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_fusion_heuristic: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_fusion_heuristic.oo";

pub fn main() {
    let g2_a = evaluate_fusion_legality(2);
    let g2_b = evaluate_fusion_legality(2);
    if g2_a != g2_b {
        println("FAIL evaluate_fusion_legality");
        process_exit(1);
    }
    println("prod_g2_polyhedral_fusion_heuristic: PASSED");
}
