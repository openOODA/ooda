// # Product prove std/quantum_open_systems/bath_spectral_density_ohmic.oo
//
// Logline: Fail-closed emit+gcc+run asserts spectral_drude_lorentz_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/bath_spectral_density_ohmic.oo.
//
// Beats:
//   1. Call spectral_drude_lorentz_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bath_spectral_density_ohmic: PASSED only if they match.

import "std/quantum_open_systems/bath_spectral_density_ohmic.oo";

pub fn main() {
    let bath_spectral_density_ohmic_mark: Int = 0;
    if bath_spectral_density_ohmic_mark != 0 {
        process_exit(1);
    }
    let a: Float = spectral_drude_lorentz_eval(0.0, 0.0, 0.0);
    let b: Float = spectral_drude_lorentz_eval(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL spectral_drude_lorentz_eval");
        process_exit(1);
    }
    println("prod_bath_spectral_density_ohmic: PASSED");
}
