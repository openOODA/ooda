// # Product prove std/telecom_5g/ofdm_papr_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts ofdm_papr_calc_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_papr_reduction.oo.
//
// Beats:
//   1. Call ofdm_papr_calc_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ofdm_papr_reduction: PASSED only if they match.

import "std/telecom_5g/ofdm_papr_reduction.oo";

pub fn main() {
    let ofdm_papr_reduction_mark: Int = 0;
    if ofdm_papr_reduction_mark != 0 {
        process_exit(1);
    }
    let a: Float = ofdm_papr_calc_db(0.0, 0.0);
    let b: Float = ofdm_papr_calc_db(0.0, 0.0);
    if a != b {
        println("FAIL ofdm_papr_calc_db");
        process_exit(1);
    }
    println("prod_ofdm_papr_reduction: PASSED");
}
