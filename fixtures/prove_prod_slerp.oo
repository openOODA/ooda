// # Product quat slerp prove
//
// Logline: Fail-closed emit+gcc+run of shipped quat_slerp / slerp_quat_dot.
//
// Setup: Product std/math/quaternion_slerp.oo. t=0 is q0; identity dot 1.
//
// Beats:
//   1. slerp_quat_dot of (0,0,0,1) with itself is 1.0.
//   2. quat_slerp(q0,q1,0) x equals q0.x.
//   3. Exit 1 before PASSED on a miss.

import "std/math/quaternion_slerp.oo";

pub fn main() {
    let q0: SlerpQuat = slerp_quat_new(0.0, 0.0, 0.0, 1.0);
    let q1: SlerpQuat = slerp_quat_new(0.0, 1.0, 0.0, 0.0);
    let d: Float = slerp_quat_dot(q0, q0);
    if d != 1.0 {
        println("FAIL slerp dot");
        process_exit(1);
    }
    let s0: SlerpQuat = quat_slerp(q0, q1, 0.0);
    let x: Float = s0.x;
    let w: Float = s0.w;
    if x != 0.0 {
        println("FAIL slerp t0 x");
        process_exit(1);
    }
    if w != 1.0 {
        println("FAIL slerp t0 w");
        process_exit(1);
    }
    println("prod_slerp: PASSED");
}
