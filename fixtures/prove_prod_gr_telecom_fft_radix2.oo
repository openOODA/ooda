// # Product prove std/telecom/fft_radix2.oo
//
// Logline: Fail-closed emit+gcc+run asserts fft_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/fft_radix2.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call fft_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fft_radix2: PASSED only if they match.

import "std/telecom/fft_radix2.oo";

pub fn main() {
    let g0_a = fft_pi();
    let g0_b = fft_pi();
    if g0_a != g0_b {
        println("FAIL fft_pi");
        process_exit(1);
    }
    println("prod_gr_fft_radix2: PASSED");
}
