// # Product prove std/fintech_l3_book/matching_pro_rata_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts calculate_pro_rata_share is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/matching_pro_rata_allocator.oo.
//
// Beats:
//   1. Call calculate_pro_rata_share twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_matching_pro_rata_allocator: PASSED only if they match.

import "std/fintech_l3_book/matching_pro_rata_allocator.oo";

pub fn main() {
    let matching_pro_rata_allocator_mark: Int = 0;
    if matching_pro_rata_allocator_mark != 0 {
        process_exit(1);
    }
    let a: Int = calculate_pro_rata_share(0, 0, 0, 0);
    let b: Int = calculate_pro_rata_share(0, 0, 0, 0);
    if a != b {
        println("FAIL calculate_pro_rata_share");
        process_exit(1);
    }
    println("prod_matching_pro_rata_allocator: PASSED");
}
