// # Product prove std/robotics_auv/fossen_6dof_hydrodynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts auv_pose_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/fossen_6dof_hydrodynamics.oo.
//
// Beats:
//   1. Call auv_pose_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auv_pose_zero: PASSED only if they match.

import "std/robotics_auv/fossen_6dof_hydrodynamics.oo";

pub fn main() {
    let fossen_6dof_hydrodynamics_mark: Int = 0;
    if fossen_6dof_hydrodynamics_mark != 0 { process_exit(1); }
    let a: AuvPose = auv_pose_zero();
    let b: AuvPose = auv_pose_zero();
    let ax: Float = (a).x;
    let bx: Float = (b).x;
    if ax != bx {
        println("FAIL auv_pose_zero");
        process_exit(1);
    }
    println("prod_auv_pose_zero: PASSED");
}
