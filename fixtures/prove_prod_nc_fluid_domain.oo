// # Product prove std/physics/fluid_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts fluid_domain_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/physics/fluid_domain.oo.
//
// Beats:
//   1. Call fluid_domain_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fluid_domain: PASSED only if it matches.

import "std/physics/fluid_domain.oo";

pub fn main() {
    let a: Int = fluid_domain_probe();
    if a != 0 {
        println("FAIL fluid_domain_probe");
        process_exit(1);
    }
    println("prod_nc_fluid_domain: PASSED");
}
