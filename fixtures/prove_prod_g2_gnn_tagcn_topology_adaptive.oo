// # Product prove std/graph_gnn/gnn_tagcn_topology_adaptive.oo
//
// Logline: Fail-closed emit+gcc+run asserts tagcn_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_tagcn_topology_adaptive.oo.
//
// Beats:
//   1. Call tagcn_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnn_tagcn_topology_adaptive: PASSED only if they match.

import "std/graph_gnn/gnn_tagcn_topology_adaptive.oo";

pub fn main() {
    let gnn_tagcn_topology_adaptive_mark: Int = 0;
    if gnn_tagcn_topology_adaptive_mark != 0 {
        process_exit(1);
    }
    let a: TAGCNConfig = tagcn_config_new(0, 0, 0, true);
    let b: TAGCNConfig = tagcn_config_new(0, 0, 0, true);
    if (a).in_features != (b).in_features {
        println("FAIL tagcn_config_new");
        process_exit(1);
    }
    println("prod_g2_gnn_tagcn_topology_adaptive: PASSED");
}
