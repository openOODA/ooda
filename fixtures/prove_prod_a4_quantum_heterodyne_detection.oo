// # Product prove std/quantum_open_systems/quantum_heterodyne_detection.oo
//
// Logline: Fail-closed emit+gcc+run asserts heterodyne_detector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_heterodyne_detection.oo.
//
// Beats:
//   1. Call heterodyne_detector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_heterodyne_detection: PASSED only if they match.

import "std/quantum_open_systems/quantum_heterodyne_detection.oo";

pub fn main() {
    let quantum_heterodyne_detection_mark: Int = 0;
    if quantum_heterodyne_detection_mark != 0 {
        process_exit(1);
    }
    let a: HeterodyneDetectorConfig = heterodyne_detector_new(0.0, 0.0);
    let b: HeterodyneDetectorConfig = heterodyne_detector_new(0.0, 0.0);
    if (a).efficiency_eta != (b).efficiency_eta {
        println("FAIL heterodyne_detector_new");
        process_exit(1);
    }
    println("prod_quantum_heterodyne_detection: PASSED");
}
