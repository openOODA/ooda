// # Product prove std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pulsar_magnetosphere_goldreich_julian: PASSED only if they match.

import "std/astrophysics_relativity/pulsar_magnetosphere_goldreich_julian.oo";

pub fn main() {
    let pulsar_magnetosphere_goldreich_julian_a = pulsar_parameters_compute(0, 0, 0, 0);
    let pulsar_magnetosphere_goldreich_julian_b = pulsar_parameters_compute(0, 0, 0, 0);
    let pulsar_magnetosphere_goldreich_julian_va = pulsar_omega(pulsar_magnetosphere_goldreich_julian_a);
    let pulsar_magnetosphere_goldreich_julian_vb = pulsar_omega(pulsar_magnetosphere_goldreich_julian_b);
    if pulsar_magnetosphere_goldreich_julian_va != pulsar_magnetosphere_goldreich_julian_vb {
        println("FAIL pulsar_magnetosphere_goldreich_julian");
        process_exit(1);
    }
    println("prod_ap_pulsar_magnetosphere_goldreich_julian: PASSED");
}
