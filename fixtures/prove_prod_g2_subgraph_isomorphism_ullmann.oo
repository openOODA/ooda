// # Product prove std/db_graph/subgraph_isomorphism_ullmann.oo
//
// Logline: Fail-closed emit+gcc+run asserts ullmann_matrix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/subgraph_isomorphism_ullmann.oo.
//
// Beats:
//   1. Call ullmann_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_subgraph_isomorphism_ullmann: PASSED only if they match.

import "std/db_graph/subgraph_isomorphism_ullmann.oo";

pub fn main() {
    let subgraph_isomorphism_ullmann_mark: Int = 0;
    if subgraph_isomorphism_ullmann_mark != 0 {
        process_exit(1);
    }
    let a: UllmannMatrix = ullmann_matrix_new(0, 0);
    let b: UllmannMatrix = ullmann_matrix_new(0, 0);
    if (a).rows != (b).rows {
        println("FAIL ullmann_matrix_new");
        process_exit(1);
    }
    println("prod_g2_subgraph_isomorphism_ullmann: PASSED");
}
