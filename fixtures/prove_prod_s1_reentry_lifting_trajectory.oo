// # Product prove std/space_propulsion/reentry_lifting_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts entry_compute_derivatives is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/reentry_lifting_trajectory.oo.
//
// Beats:
//   1. Call entry_compute_derivatives twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_reentry_lifting_trajectory: PASSED only if they match.

import "std/space_propulsion/reentry_lifting_trajectory.oo";

pub fn main() {
    let reentry_lifting_trajectory_mark: Int = 0;
    if reentry_lifting_trajectory_mark != 0 {
        process_exit(1);
    }
    let reentry_lifting_trajectory_a = entry_compute_derivatives(lifting_entry_vehicle_default(), 1.0, 1.0, 1.0, 1.0);
    let reentry_lifting_trajectory_b = entry_compute_derivatives(lifting_entry_vehicle_default(), 1.0, 1.0, 1.0, 1.0);
    if (reentry_lifting_trajectory_a).altitude_rate_m_s != (reentry_lifting_trajectory_b).altitude_rate_m_s {
        println("FAIL entry_compute_derivatives");
        process_exit(1);
    }
    println("prod_reentry_lifting_trajectory: PASSED");
}
