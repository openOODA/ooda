// # Product prove std/telecom_5g/nr5g_ldpc_base_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_ldpc_select_graph is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_ldpc_base_graph.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nr5g_ldpc_select_graph twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nr5g_ldpc_base_graph: PASSED only if they match.

import "std/telecom_5g/nr5g_ldpc_base_graph.oo";

pub fn main() {
    let g2_a = nr5g_ldpc_select_graph(8, 2);
    let g2_b = nr5g_ldpc_select_graph(8, 2);
    if g2_a != g2_b {
        println("FAIL nr5g_ldpc_select_graph");
        process_exit(1);
    }
    println("prod_g2_nr5g_ldpc_base_graph: PASSED");
}
