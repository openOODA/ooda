// # Product prove std/fintech_l3_book/nasdaq_itch50_moldudp64.oo
//
// Logline: Fail-closed emit+gcc+run asserts mold_is_heartbeat is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_moldudp64.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mold_is_heartbeat twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nasdaq_itch50_moldudp64: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_moldudp64.oo";

pub fn main() {
    let g2_oa: MoldPacketHeader = MoldPacketHeader { session_id: "x", sequence_number: 2, message_count: 8 };
    let g2_ob: MoldPacketHeader = MoldPacketHeader { session_id: "x", sequence_number: 2, message_count: 8 };
    let g2_a = mold_is_heartbeat(&g2_oa);
    let g2_b = mold_is_heartbeat(&g2_ob);
    if g2_a != g2_b {
        println("FAIL mold_is_heartbeat");
        process_exit(1);
    }
    println("prod_g2_nasdaq_itch50_moldudp64: PASSED");
}
