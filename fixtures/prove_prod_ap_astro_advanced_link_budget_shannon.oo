// # Product prove std/astro_advanced/link_budget_shannon.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/link_budget_shannon.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/link_budget_shannon.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_link_budget_shannon: PASSED only if they match.

import "std/astro_advanced/link_budget_shannon.oo";

pub fn main() {
    let link_budget_shannon_a = shannon_snr_db();
    let link_budget_shannon_b = shannon_snr_db();
    if link_budget_shannon_a != link_budget_shannon_b {
        println("FAIL link_budget_shannon");
        process_exit(1);
    }
    println("prod_ap_link_budget_shannon: PASSED");
}
