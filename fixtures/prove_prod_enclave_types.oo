// # Product prove std/sec/sys/enclave_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts enclave_type_vendor is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/enclave_types.oo.
//
// Beats:
//   1. Call enclave_type_vendor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_enclave_types: PASSED only if they match.

import "std/sec/sys/enclave_types.oo";

pub fn main() {
    let obj = enclave_type_new(0, 0);
    let a = enclave_type_vendor(obj);
    let b = enclave_type_vendor(obj);
    if a != b {
        println("FAIL enclave_type_vendor");
        process_exit(1);
    }
    println("prod_enclave_types: PASSED");
}
