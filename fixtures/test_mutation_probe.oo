// # Test Mutation Probe
//
// Logline: Directly exercises mut_apply and mut_was_applied to debug why killed=0 in the sweep.
//
// Setup: Imports operators and probes a simple source.
//
// Beats:
//   1. Build source "a<b".
//   2. Apply op 0 (rel_invert) and report mutated length + was_applied.
//   3. Print byte-by-byte diff.

import "qa/mutation/mutation_operators.oo";

pub fn main() -> Int {
    let src: List[Int] = mut_source_from_string("a<b");
    let m0: List[Int] = mut_apply(0, src);
    let w0: Int = mut_was_applied(0, src, m0);
    let len_src: Int = list_len(src);
    let len_mut: Int = list_len(m0);
    let line: String = "len_src=" + len_src.to_string() + " len_mut=" + len_mut.to_string() + " w0=" + w0.to_string();
    println(line);
    let mut bytes_src: String = "src:";
    let mut i: Int = 0;
    while i < len_src {
        let b: Int = list_get(src, i);
        let s: String = " [" + b.to_string() + "]";
        bytes_src = bytes_src + s;
        i = i + 1;
    }
    println(bytes_src);
    let mut bytes_mut: String = "mut:";
    let mut j: Int = 0;
    while j < len_mut {
        let b: Int = list_get(m0, j);
        let s: String = " [" + b.to_string() + "]";
        bytes_mut = bytes_mut + s;
        j = j + 1;
    }
    println(bytes_mut);
    if w0 == 1 {
        println("PROBE: PASSED mutator fires");
        return 0;
    }
    println("PROBE: FAILED mutator did not fire");
    return 1;
}
