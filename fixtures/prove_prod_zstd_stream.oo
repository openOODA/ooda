// # Product prove std/archive/zstd_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts zstd_check_magic is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zstd_stream.oo.
//
// Beats:
//   1. Call zstd_check_magic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zstd_stream: PASSED only if they match.

import "std/archive/zstd_stream.oo";

pub fn main() {
    let a = zstd_check_magic("x");
    let b = zstd_check_magic("x");
    if a != b {
        println("FAIL zstd_check_magic");
        process_exit(1);
    }
    println("prod_zstd_stream: PASSED");
}
