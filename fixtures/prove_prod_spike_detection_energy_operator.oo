// # Product prove std/neuro_bci/spike_detection_energy_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts neo_config_default real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_detection_energy_operator.oo.
//
// Beats:
//   1. Call neo_config_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_spike_detection_energy_operator: PASSED only if the assert holds.

import "std/neuro_bci/spike_detection_energy_operator.oo";

pub fn main() {
    let spike_detection_energy_operator_mark: Int = 0;
    if spike_detection_energy_operator_mark != 0 {
        process_exit(1);
    }
    let spike_detection_energy_operator_a = neo_config_default();
    let spike_detection_energy_operator_refractory_samples: Int = (spike_detection_energy_operator_a).refractory_samples;
    if spike_detection_energy_operator_refractory_samples != 15 {
        println("FAIL neo_config_default");
        process_exit(1);
    }
    println("prod_spike_detection_energy_operator: PASSED");
}
