// # Product prove std/industrial_predictive/ts_markov_health_states.oo
//
// Logline: Fail-closed emit+gcc+run asserts markov_model_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_markov_health_states.oo.
//
// Beats:
//   1. Call markov_model_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_markov_health_states: PASSED only if they match.

import "std/industrial_predictive/ts_markov_health_states.oo";

pub fn main() {
    let ts_markov_health_states_mark: Int = 0;
    if ts_markov_health_states_mark != 0 {
        process_exit(1);
    }
    let ts_markov_health_states_a: MarkovHealthModel = markov_model_default();
    let ts_markov_health_states_b: MarkovHealthModel = markov_model_default();
    if (ts_markov_health_states_a).p00 != (ts_markov_health_states_b).p00 {
        println("FAIL markov_model_default");
        process_exit(1);
    }
    println("prod_ts_markov_health_states: PASSED");
}
