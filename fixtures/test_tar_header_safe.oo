// # ustar header adversarial suite
//
// Logline: Builds a 512-byte ustar header, checks octal size and checksum, and rejects path escape and bad checksums.
//
// Setup: Pure. Imports tar_header_safe.oo. Run from ooda/.
//
// Beats:
//   1. Make a regular-file header and parse it.
//   2. Recover the size and type flag.
//   3. Reject a parent-directory name and a tampered checksum.

import "std/archive/tar_header_safe.oo";

pub fn main() {
    let e: ByteOut = tar_header_safe_make("ok.txt", 12, 48);
    if e.flag < 1 {
        println("FAIL make " + e.err);
        process_exit(1);
    }
    if list_len(e.bytes) != 512 {
        println("FAIL 512");
        process_exit(1);
    }
    let p: TarHdr = tar_header_safe_parse(e.bytes);
    if p.flag < 1 {
        println("FAIL parse " + p.err);
        process_exit(1);
    }
    if p.size != 12 {
        println("FAIL size");
        process_exit(1);
    }
    if p.typeflag != 48 {
        println("FAIL typeflag");
        process_exit(1);
    }
    println("512-byte ustar octal fields, checksum, typeflag");
    let esc: ByteOut = tar_header_safe_make("../x", 1, 48);
    if esc.flag > 0 {
        println("FAIL path ok");
        process_exit(1);
    }
    let abs: ByteOut = tar_header_safe_make("/a", 1, 48);
    if abs.flag > 0 {
        println("FAIL abs ok");
        process_exit(1);
    }
    println("../absolute path Err");
    let mut tam: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 512 {
        if i < 1 {
            tam = list_push(tam, 65);
        } else {
            tam = list_push(tam, list_get(e.bytes, i));
        }
        i = i + 1;
    }
    let bad: TarHdr = tar_header_safe_parse(tam);
    if bad.flag > 0 {
        println("FAIL checksum ok");
        process_exit(1);
    }
    println("bad checksum Err");
    println("SUITE PASSED");
    println("test_tar_header_safe: PASSED");
}
