// # Product prove std/tda_topology/circular_coordinates_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts wrap_to_2pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/circular_coordinates_tda.oo.
//
// Beats:
//   1. Call wrap_to_2pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_circular_coordinates_tda: PASSED only if they match.

import "std/tda_topology/circular_coordinates_tda.oo";

pub fn main() {
    let circular_coordinates_tda_mark: Int = 0;
    if circular_coordinates_tda_mark != 0 {
        process_exit(1);
    }
    let circular_coordinates_tda_a: Float = wrap_to_2pi(1.0);
    let circular_coordinates_tda_b: Float = wrap_to_2pi(1.0);
    if circular_coordinates_tda_a != circular_coordinates_tda_b {
        println("FAIL wrap_to_2pi");
        process_exit(1);
    }
    println("prod_circular_coordinates_tda: PASSED");
}
