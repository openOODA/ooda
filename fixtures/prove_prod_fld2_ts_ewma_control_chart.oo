// # Product prove std/industrial_predictive/ts_ewma_control_chart.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_ewma_control_chart.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_ewma_control_chart: PASSED only if they match.

import "std/industrial_predictive/ts_ewma_control_chart.oo";

pub fn main() {
    let ts_ewma_control_chart_mark: Int = 0;
    if ts_ewma_control_chart_mark != 0 {
        process_exit(1);
    }
    let ts_ewma_control_chart_a: Float = int_to_float(1);
    let ts_ewma_control_chart_b: Float = int_to_float(1);
    if ts_ewma_control_chart_a != ts_ewma_control_chart_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_ts_ewma_control_chart: PASSED");
}
