// # Product prove std/compilers_polyhedral/affine_access_relation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/affine_access_relation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_access_relation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_affine_access_relation: PASSED only if they match.

import "std/compilers_polyhedral/affine_access_relation.oo";

pub fn main() {
    let affine_access_relation_a = array_access_relation_new(0, "x", true, 0);
    let affine_access_relation_b = array_access_relation_new(0, "x", true, 0);
    let affine_access_relation_va = array_access_evaluate_index(affine_access_relation_a, 0, list_new());
    let affine_access_relation_vb = array_access_evaluate_index(affine_access_relation_b, 0, list_new());
    if affine_access_relation_va != affine_access_relation_vb {
        println("FAIL affine_access_relation");
        process_exit(1);
    }
    println("prod_ap_affine_access_relation: PASSED");
}
