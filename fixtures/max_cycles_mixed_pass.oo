// # Mixed loops under budget
//
// Logline: Share an eight-cycle budget across a short while and a short for.
//
// Beats:
//   1. Keep the eight-cycle marker.
//   2. While-increment a to 2; for-count 0..2.
//   3. Print a + s.

// M64 mixed while+for under shared budget
// MAX_CYCLES: 8
pub fn main() {
    let mut a = 0;
    while a < 2 {
        a = a + 1;
    }
    let mut s = 0;
    for i in 0..2 {
        s = s + 1;
    }
    println(a + s);
}
