// # Product prove std/space_propulsion/resistojet_electrothermal.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/resistojet_electrothermal.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/resistojet_electrothermal.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_resistojet_electrothermal: PASSED only if they match.

import "std/space_propulsion/resistojet_electrothermal.oo";

pub fn main() {
    let resistojet_electrothermal_a = resistojet_spec_default_ammonia();
    let resistojet_electrothermal_b = resistojet_spec_default_ammonia();
    if resistojet_electrothermal_a.propellant_type != resistojet_electrothermal_b.propellant_type {
        println("FAIL resistojet_electrothermal");
        process_exit(1);
    }
    println("prod_ap_resistojet_electrothermal: PASSED");
}
