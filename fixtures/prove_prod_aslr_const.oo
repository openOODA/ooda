// # Product prove std/sec/sys/aslr_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_mode_disabled is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/aslr_const.oo.
//
// Beats:
//   1. Call aslr_mode_disabled twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aslr_const: PASSED only if they match.

import "std/sec/sys/aslr_const.oo";

pub fn main() {
    let a = aslr_mode_disabled();
    let b = aslr_mode_disabled();
    if a != b {
        println("FAIL aslr_mode_disabled");
        process_exit(1);
    }
    println("prod_aslr_const: PASSED");
}
