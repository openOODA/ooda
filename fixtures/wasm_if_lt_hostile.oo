// # Hostile if 1 < x fold
//
// Logline: Print fold-me or other from if 1 < x so emit-wasm must miss a const-lt fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be 2.
//   2. If 1 < x print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = 2;
    if 1 < x {
        println("fold-me");
    } else {
        println("other");
    }
}
