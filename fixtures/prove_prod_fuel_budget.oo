// # Product prove std/sec/fuel_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts fuel_left is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/fuel_budget.oo.
//
// Beats:
//   1. Call fuel_left twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fuel_budget: PASSED only if they match.

import "std/sec/fuel_budget.oo";

pub fn main() {
    let obj = fuel_new(0);
    let a = fuel_left(obj);
    let b = fuel_left(obj);
    if a != b {
        println("FAIL fuel_left");
        process_exit(1);
    }
    println("prod_fuel_budget: PASSED");
}
