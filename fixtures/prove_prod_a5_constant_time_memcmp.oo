// # Product prove std/security_defense/constant_time_memcmp.oo
//
// Logline: Fail-closed emit+gcc+run asserts constant_time_memcmp_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/constant_time_memcmp.oo.
//
// Beats:
//   1. Call constant_time_memcmp_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_constant_time_memcmp: PASSED only if they match.

import "std/security_defense/constant_time_memcmp.oo";

pub fn main() {
    let a: Bool = constant_time_memcmp_bytes(list_new(), list_new(), 0);
    let b: Bool = constant_time_memcmp_bytes(list_new(), list_new(), 0);
    if a != b {
        println("FAIL constant_time_memcmp_bytes");
        process_exit(1);
    }
    println("prod_constant_time_memcmp: PASSED");
}
