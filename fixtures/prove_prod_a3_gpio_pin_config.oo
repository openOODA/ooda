// # Product prove std/embedded_hal/gpio_pin_config.oo
//
// Logline: Fail-closed emit+gcc+run asserts gpio_pin_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/gpio_pin_config.oo.
//
// Beats:
//   1. Call gpio_pin_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gpio_pin_config: PASSED only if they match.

import "std/embedded_hal/gpio_pin_config.oo";

pub fn main() {
    let gpio_pin_config_mark: Int = 0;
    if gpio_pin_config_mark != 0 {
        process_exit(1);
    }
    let a: GpioPin = gpio_pin_new(0, 0);
    let b: GpioPin = gpio_pin_new(0, 0);
    if (a).port != (b).port {
        println("FAIL gpio_pin_new");
        process_exit(1);
    }
    println("prod_gpio_pin_config: PASSED");
}
