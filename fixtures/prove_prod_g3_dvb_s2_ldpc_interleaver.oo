// # Product prove std/satellite_dvb/dvb_s2_ldpc_interleaver.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_interleaver_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2_ldpc_interleaver.oo.
//
// Beats:
//   1. Call dvb_interleaver_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvb_s2_ldpc_interleaver: PASSED only if they match.

import "std/satellite_dvb/dvb_s2_ldpc_interleaver.oo";

pub fn main() {
    let dvb_s2_ldpc_interleaver_mark: Int = 0;
    if dvb_s2_ldpc_interleaver_mark != 0 {
        process_exit(1);
    }
    let a: DvbInterleaverConfig = dvb_interleaver_config_new(0, 0);
    let b: DvbInterleaverConfig = dvb_interleaver_config_new(0, 0);
    if (a).mod_order_m != (b).mod_order_m {
        println("FAIL dvb_interleaver_config_new");
        process_exit(1);
    }
    println("prod_dvb_s2_ldpc_interleaver: PASSED");
}
