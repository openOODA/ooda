// # list_set emit lock
//
// Logline: Fail-closed emit+gcc+run of list_set that replaces index 0 with 8.
//
// Setup: Backend-C. list_set returns the updated List[Int].
//
// Beats:
//   1. Push 1 onto an empty list.
//   2. list_set index 0 to 8; get is 8.
//   3. Exit 1 before PASSED on a miss.

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_set(xs, 0, 8);
    if list_get(xs, 0) != 8 {
        println("FAIL");
        process_exit(1);
    }
    println("list_set_smoke: PASSED");
}
