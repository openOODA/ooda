// # Product prove std/telecom_5g/nr5g_polar_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_polar_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_polar_encoder.oo.
//
// Beats:
//   1. Call nr5g_polar_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nr5g_polar_encoder: PASSED only if they match.

import "std/telecom_5g/nr5g_polar_encoder.oo";

pub fn main() {
    let a: Nr5gPolarConfig = nr5g_polar_config_new(0, 0);
    let b: Nr5gPolarConfig = nr5g_polar_config_new(0, 0);
    if a.info_length_k != b.info_length_k {
        println("FAIL nr5g_polar_config_new");
        process_exit(1);
    }
    println("prod_nr5g_polar_encoder: PASSED");
}
