// # Product prove std/fintech_l3_book/dma_peg_order_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts pegged_order_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_peg_order_engine.oo.
//
// Beats:
//   1. Call pegged_order_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dma_peg_order_engine: PASSED only if they match.

import "std/fintech_l3_book/dma_peg_order_engine.oo";

pub fn main() {
    let dma_peg_order_engine_mark: Int = 0;
    if dma_peg_order_engine_mark != 0 {
        process_exit(1);
    }
    let a: PeggedOrder = pegged_order_new(0, "x", 0, "x", "x", 0, 0);
    let b: PeggedOrder = pegged_order_new(0, "x", 0, "x", "x", 0, 0);
    if (a).user_ref_number != (b).user_ref_number {
        println("FAIL pegged_order_new");
        process_exit(1);
    }
    println("prod_g2_dma_peg_order_engine: PASSED");
}
