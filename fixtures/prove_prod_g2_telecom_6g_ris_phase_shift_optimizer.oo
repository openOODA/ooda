// # Product prove std/telecom_6g/ris_phase_shift_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_ideal_phase_shift is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_phase_shift_optimizer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ris_ideal_phase_shift twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ris_phase_shift_optimizer: PASSED only if they match.

import "std/telecom_6g/ris_phase_shift_optimizer.oo";

pub fn main() {
    let g2_a = ris_ideal_phase_shift(1.0, 1.0);
    let g2_b = ris_ideal_phase_shift(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL ris_ideal_phase_shift");
        process_exit(1);
    }
    println("prod_g2_ris_phase_shift_optimizer: PASSED");
}
