// # Product prove std/macro.oo
//
// Logline: Fail-closed emit+gcc+run asserts macro_env_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/macro.oo.
//
// Beats:
//   1. Call macro_env_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_macro: PASSED only if they match.

import "std/macro.oo";

pub fn main() {
    let a: MacroEnv = macro_env_new();
    let b: MacroEnv = macro_env_new();
    if (a).gensym_counter != (b).gensym_counter {
        println("FAIL macro_env_new");
        process_exit(1);
    }
    println("prod_macro: PASSED");
}
