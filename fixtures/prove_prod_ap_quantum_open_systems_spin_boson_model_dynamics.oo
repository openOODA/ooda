// # Product prove std/quantum_open_systems/spin_boson_model_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/spin_boson_model_dynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/spin_boson_model_dynamics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_spin_boson_model_dynamics: PASSED only if they match.

import "std/quantum_open_systems/spin_boson_model_dynamics.oo";

pub fn main() {
    let spin_boson_model_dynamics_a = spin_boson_params_new(0.0, 0.0, 0.0, 0.0);
    let spin_boson_model_dynamics_b = spin_boson_params_new(0.0, 0.0, 0.0, 0.0);
    let spin_boson_model_dynamics_va = spin_boson_renormalized_tunneling(spin_boson_model_dynamics_a);
    let spin_boson_model_dynamics_vb = spin_boson_renormalized_tunneling(spin_boson_model_dynamics_b);
    if spin_boson_model_dynamics_va != spin_boson_model_dynamics_vb {
        println("FAIL spin_boson_model_dynamics");
        process_exit(1);
    }
    println("prod_ap_spin_boson_model_dynamics: PASSED");
}
