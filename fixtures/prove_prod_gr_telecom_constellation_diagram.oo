// # Product prove std/telecom/constellation_diagram.oo
//
// Logline: Fail-closed emit+gcc+run asserts constell_ln_approx is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/constellation_diagram.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call constell_ln_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_constellation_diagram: PASSED only if they match.

import "std/telecom/constellation_diagram.oo";

pub fn main() {
    let g0_a = constell_ln_approx(0.0);
    let g0_b = constell_ln_approx(0.0);
    if g0_a != g0_b {
        println("FAIL constell_ln_approx");
        process_exit(1);
    }
    println("prod_gr_constellation_diagram: PASSED");
}
