// # Product prove std/db_storage/lsm_sstable_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_handle_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_sstable_builder.oo.
//
// Beats:
//   1. Call block_handle_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_block_handle: PASSED only if they match.

import "std/db_storage/lsm_sstable_builder.oo";

pub fn main() {
    let lsm_sstable_builder_mark: Int = 0;
    if lsm_sstable_builder_mark != 0 { process_exit(1); }
    let a: BlockHandle = block_handle_new(100, 200);
    let b: BlockHandle = block_handle_new(100, 200);
    let ao: Int = (a).offset;
    let bo: Int = (b).offset;
    if ao != bo {
        println("FAIL block_handle_new");
        process_exit(1);
    }
    println("prod_block_handle: PASSED");
}
