// # Product prove std/quantum_topological/toric_code_star_plaquette.oo
//
// Logline: Fail-closed emit+gcc+run asserts toric_ground_state_degeneracy is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_star_plaquette.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call toric_ground_state_degeneracy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_toric_code_star_plaquette: PASSED only if they match.

import "std/quantum_topological/toric_code_star_plaquette.oo";

pub fn main() {
    let g2_a = toric_ground_state_degeneracy(2);
    let g2_b = toric_ground_state_degeneracy(2);
    if g2_a != g2_b {
        println("FAIL toric_ground_state_degeneracy");
        process_exit(1);
    }
    println("prod_g2_toric_code_star_plaquette: PASSED");
}
