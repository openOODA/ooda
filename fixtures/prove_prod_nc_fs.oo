// # Product prove std/os/fs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fs_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/os/fs.oo.
//
// Beats:
//   1. Call fs_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fs: PASSED only if it matches.

import "std/os/fs.oo";

pub fn main() {
    let a: Int = fs_probe();
    if a != 0 {
        println("FAIL fs_probe");
        process_exit(1);
    }
    println("prod_nc_fs: PASSED");
}
