// # Product prove std/db_storage/sql_vectorized_batch_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts column_vector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/sql_vectorized_batch_chunk.oo.
//
// Beats:
//   1. Call column_vector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_vectorized_batch_chunk: PASSED only if they match.

import "std/db_storage/sql_vectorized_batch_chunk.oo";

pub fn main() {
    let sql_vectorized_batch_chunk_mark: Int = 0;
    if sql_vectorized_batch_chunk_mark != 0 {
        process_exit(1);
    }
    let a: ColumnVector = column_vector_new("x", "x");
    let b: ColumnVector = column_vector_new("x", "x");
    let sa: String = (a).column_name;
    let sb: String = (b).column_name;
    if sa != sb {
        println("FAIL column_vector_new");
        process_exit(1);
    }
    println("prod_sql_vectorized_batch_chunk: PASSED");
}
