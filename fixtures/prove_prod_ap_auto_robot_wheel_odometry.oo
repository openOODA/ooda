// # Product prove std/auto_robot/wheel_odometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/wheel_odometry.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/auto_robot/wheel_odometry.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_wheel_odometry: PASSED only if they match.

import "std/auto_robot/wheel_odometry.oo";

pub fn main() {
    let wheel_odometry_a = wheel_odometry_new(0, 0, 0);
    let wheel_odometry_b = wheel_odometry_new(0, 0, 0);
    if wheel_odometry_a.x_milli != wheel_odometry_b.x_milli {
        println("FAIL wheel_odometry");
        process_exit(1);
    }
    println("prod_ap_wheel_odometry: PASSED");
}
