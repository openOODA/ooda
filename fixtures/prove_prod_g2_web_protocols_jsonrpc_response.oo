// # Product prove std/web_protocols/jsonrpc_response.oo
//
// Logline: Fail-closed emit+gcc+run asserts jsonrpc_response_id_is_null is a real value.
//
// Setup: Isolated emit-c. Imports std/web_protocols/jsonrpc_response.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call jsonrpc_response_id_is_null twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jsonrpc_response: PASSED only if they match.

import "std/web_protocols/jsonrpc_response.oo";

pub fn main() {
    let g2_oa = jsonrpc_response_success(2, 2);
    let g2_ob = jsonrpc_response_success(2, 2);
    let g2_a = jsonrpc_response_id_is_null(g2_oa);
    let g2_b = jsonrpc_response_id_is_null(g2_ob);
    if g2_a != g2_b {
        println("FAIL jsonrpc_response_id_is_null");
        process_exit(1);
    }
    println("prod_g2_jsonrpc_response: PASSED");
}
