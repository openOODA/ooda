// # Product prove std/bft_consensus/block_assembler_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_builder_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/block_assembler_builder.oo.
//
// Beats:
//   1. Call block_builder_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_block_assembler_builder: PASSED only if they match.

import "std/bft_consensus/block_assembler_builder.oo";

pub fn main() {
    let block_assembler_builder_mark: Int = 0;
    if block_assembler_builder_mark != 0 {
        process_exit(1);
    }
    let a: BlockBuilder = block_builder_new(0, 0, 0);
    let b: BlockBuilder = block_builder_new(0, 0, 0);
    if (a).height != (b).height {
        println("FAIL block_builder_new");
        process_exit(1);
    }
    println("prod_block_assembler_builder: PASSED");
}
