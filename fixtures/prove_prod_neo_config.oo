// # Product prove std/neuro_bci/spike_detection_energy_operator.oo
//
// Logline: Fail-closed emit+gcc+run asserts neo_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_detection_energy_operator.oo.
//
// Beats:
//   1. Call neo_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_neo_config: PASSED only if they match.

import "std/neuro_bci/spike_detection_energy_operator.oo";

pub fn main() {
    let spike_detection_energy_operator_mark: Int = 0;
    if spike_detection_energy_operator_mark != 0 { process_exit(1); }
    let a: NEODetectorConfig = neo_config_default();
    let b: NEODetectorConfig = neo_config_default();
    let ar: Int = (a).refractory_samples;
    let br: Int = (b).refractory_samples;
    if ar != br {
        println("FAIL neo_config_default");
        process_exit(1);
    }
    println("prod_neo_config: PASSED");
}
