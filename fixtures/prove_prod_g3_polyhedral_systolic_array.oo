// # Product prove std/compilers_polyhedral/polyhedral_systolic_array.oo
//
// Logline: Fail-closed emit+gcc+run asserts systolic_array_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_systolic_array.oo.
//
// Beats:
//   1. Call systolic_array_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_systolic_array: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_systolic_array.oo";

pub fn main() {
    let polyhedral_systolic_array_mark: Int = 0;
    if polyhedral_systolic_array_mark != 0 {
        process_exit(1);
    }
    let a: SystolicArrayConfig = systolic_array_config_new(0, 0);
    let b: SystolicArrayConfig = systolic_array_config_new(0, 0);
    if (a).array_width != (b).array_width {
        println("FAIL systolic_array_config_new");
        process_exit(1);
    }
    println("prod_polyhedral_systolic_array: PASSED");
}
