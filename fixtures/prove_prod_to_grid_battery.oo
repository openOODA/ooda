// # Product prove std/grid/battery.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_arbitrage_yield holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery.oo.
//
// Beats:
//   1. Call shim_marker_arbitrage_yield using the battery ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_battery: PASSED only if asserts hold.

import "std/grid/battery.oo";

pub fn main() {
    let battery_a = shim_marker_arbitrage_yield();
    let battery_b = shim_marker_arbitrage_yield();
    if battery_a != battery_b {
        println("FAIL shim_marker_arbitrage_yield");
        process_exit(1);
    }
    println("prod_battery: PASSED");
}
