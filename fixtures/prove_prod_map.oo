// # Product prove std/hash/map.oo
//
// Logline: Fail-closed emit+gcc+run asserts map_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/map.oo.
//
// Beats:
//   1. Call map_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_map: PASSED only if they match.

import "std/hash/map.oo";

pub fn main() {
    let obj = map_new();
    let a = map_len(obj);
    let b = map_len(obj);
    if a != b {
        println("FAIL map_len");
        process_exit(1);
    }
    println("prod_map: PASSED");
}
