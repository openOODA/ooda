// # Package manager and capability mint fixture
//
// Logline: Drive SemVer resolution, manifest locking, capability attenuation, and zero-trust token provenance.
//
// Setup: Test fixture importing PM and Mint modules. Exercises full resolution and mint verification.
//
// Beats:
//   1. Assert SemVer parsing, comparisons, and constraint solver satisfaction.
//   2. Build mock package registry, solve recursive dependency tree, and verify lockfile.
//   3. Mint capability tokens, delegate with attenuation, and prove zero-trust provenance.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "pm/pm_engine.oo";
import "src/ooda/sec/mint/mint.oo";

pub fn main() {
    // ---------------------------------------------------------------
    // Beat 1: SemVer parsing & constraint solving
    // ---------------------------------------------------------------
    let v1_res = pm_semver_parse("1.2.3");
    let v1 = v1_res.unwrap();
    if v1.major != 1 { println("FAIL: v1.major"); process_exit(1); }
    if v1.minor != 2 { println("FAIL: v1.minor"); process_exit(1); }
    if v1.patch != 3 { println("FAIL: v1.patch"); process_exit(1); }

    let v2_res = pm_semver_parse("1.3.0");
    let v2 = v2_res.unwrap();
    let cmp_12 = pm_semver_compare(&v1, &v2);
    if cmp_12 == 1 { println("FAIL: v1 < v2 comparison"); process_exit(1); }

    // Caret ^1.2.0 matches 1.2.3 and 1.3.0, but not 2.0.0
    let dep_caret = pm_dependency_new("crypto", "std", "^", 1, 2, 0, false, 7);
    let ok_c1 = pm_semver_satisfies(&v1, &dep_caret);
    if !ok_c1 { println("FAIL: caret match v1"); process_exit(1); }
    let ok_c2 = pm_semver_satisfies(&v2, &dep_caret);
    if !ok_c2 { println("FAIL: caret match v2"); process_exit(1); }

    let v_major2 = pm_semver_new(2, 0, 0);
    let ok_m2 = pm_semver_satisfies(&v_major2, &dep_caret);
    if ok_m2 { println("FAIL: caret must reject major bump"); process_exit(1); }

    // Tilde ~1.2.0 matches 1.2.3, but not 1.3.0
    let dep_tilde = pm_dependency_new("crypto", "std", "~", 1, 2, 0, false, 7);
    let ok_t1 = pm_semver_satisfies(&v1, &dep_tilde);
    if !ok_t1 { println("FAIL: tilde match v1"); process_exit(1); }
    let ok_t2 = pm_semver_satisfies(&v2, &dep_tilde);
    if ok_t2 { println("FAIL: tilde must reject minor bump"); process_exit(1); }

    // ---------------------------------------------------------------
    // Beat 2: Dependency resolution and deterministic lockfile
    // ---------------------------------------------------------------
    let mut root_app_res = pm_manifest_create("my_service", "org.openooda", "1.0.0", 15, "chk_root");
    let mut root_app = root_app_res.unwrap();
    let dep_sec = pm_dependency_new("sec_core", "org.openooda", "^", 1, 0, 0, false, 7);
    let _s1 = pm_manifest_add_dep(&mut root_app, dep_sec);

    let mut reg: List[PmManifest] = list_new();
    let mut sec1_res = pm_manifest_create("sec_core", "org.openooda", "1.1.0", 7, "chk_sec1");
    let mut sec1 = sec1_res.unwrap();
    let dep_hash = pm_dependency_new("hash_lib", "org.openooda", "^", 2, 0, 0, false, 3);
    let _s2 = pm_manifest_add_dep(&mut sec1, dep_hash);
    reg = list_push(reg, sec1);

    let sec2_res = pm_manifest_create("sec_core", "org.openooda", "1.2.0", 7, "chk_sec2");
    let sec2 = sec2_res.unwrap();
    reg = list_push(reg, sec2);

    let hash_res = pm_manifest_create("hash_lib", "org.openooda", "2.1.0", 3, "chk_hash");
    let hash_man = hash_res.unwrap();
    reg = list_push(reg, hash_man);

    let lock_res = pm_engine_resolve_and_lock(&root_app, reg, 10000);
    let lock = lock_res.unwrap();
    if !lock.is_locked { println("FAIL: lockfile is_locked"); process_exit(1); }
    if lock.total_entries == 0 { println("FAIL: lockfile entries count"); process_exit(1); }

    let lock_ver_res = pm_lockfile_verify(&lock, &root_app);
    if lock_ver_res.is_err() { println("FAIL: lockfile verification"); process_exit(1); }

    // ---------------------------------------------------------------
    // Beat 3: Capability Mint Authority and Zero-Trust Provenance
    // ---------------------------------------------------------------
    let mut mint_reg = mint_registry_init("mint_reg_01");
    let root_auth_ok = mint_engine_create_root(&mut mint_reg, "auth_root", "OODARootMint", "pk_root_hash_99", 63);
    if !root_auth_ok { println("FAIL: create root authority"); process_exit(1); }

    let root_tok_res = mint_registry_mint_token(
        &mut mint_reg,
        "auth_root",
        "tok_root_srv",
        "principal_srv",
        "ooda://service/node1",
        31,
        1000,
        3600,
        "nonce_abc"
    );
    let root_tok = root_tok_res.unwrap();

    let pol = mint_policy_default("policy_standard");
    let prov_res = mint_registry_verify_token(&mut mint_reg, "tok_root_srv", &pol, 1500);
    let prov = prov_res.unwrap();
    if !prov.is_proven { println("FAIL: provenance is_proven"); process_exit(1); }

    // Delegated child token with monotonic attenuation
    let child_tok_res = mint_token_delegate(
        &root_tok,
        "tok_child_worker",
        "principal_worker",
        7,
        1500,
        1800,
        "nonce_child"
    );
    let child_tok = child_tok_res.unwrap();

    let auth_root_res = mint_registry_find_authority(&mint_reg, "auth_root");
    let auth_root_item = auth_root_res.unwrap();
    let chain_prov_res = mint_verify_delegation_chain(
        &child_tok,
        &root_tok,
        &auth_root_item,
        &pol,
        2000
    );
    if chain_prov_res.is_err() { println("FAIL: chain provenance verification"); process_exit(1); }

    // Security Negative: Capability escalation in delegation must be rejected
    let escalate_res = mint_token_delegate(
        &root_tok,
        "tok_escalate",
        "attacker",
        63,
        1500,
        1800,
        "nonce_bad"
    );
    if escalate_res.is_ok() { println("FAIL: capability escalation must be rejected"); process_exit(1); }

    println("pm_mint_fixture-ok");
}
