// # Product prove std/formal_verif/sat_two_watched_literals.oo
//
// Logline: Fail-closed emit+gcc+run asserts watched_clause_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/sat_two_watched_literals.oo.
//
// Beats:
//   1. Call watched_clause_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sat_two_watched_literals: PASSED only if they match.

import "std/formal_verif/sat_two_watched_literals.oo";

pub fn main() {
    let a: WatchedClause = watched_clause_new(0, 0, 0);
    let b: WatchedClause = watched_clause_new(0, 0, 0);
    if a.clause_id != b.clause_id {
        println("FAIL watched_clause_new");
        process_exit(1);
    }
    println("prod_sat_two_watched_literals: PASSED");
}
