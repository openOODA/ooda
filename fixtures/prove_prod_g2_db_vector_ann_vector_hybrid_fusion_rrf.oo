// # Product prove std/db_vector_ann/vector_hybrid_fusion_rrf.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_rrf_single_rank is a real value.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_hybrid_fusion_rrf.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compute_rrf_single_rank twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_hybrid_fusion_rrf: PASSED only if they match.

import "std/db_vector_ann/vector_hybrid_fusion_rrf.oo";

pub fn main() {
    let g2_a = compute_rrf_single_rank(2, 2, 2);
    let g2_b = compute_rrf_single_rank(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL compute_rrf_single_rank");
        process_exit(1);
    }
    println("prod_g2_vector_hybrid_fusion_rrf: PASSED");
}
