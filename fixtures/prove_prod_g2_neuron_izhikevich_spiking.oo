// # Product prove std/neuro_bci/neuron_izhikevich_spiking.oo
//
// Logline: Fail-closed emit+gcc+run asserts izhikevich_params_regular_spiking is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/neuron_izhikevich_spiking.oo.
//
// Beats:
//   1. Call izhikevich_params_regular_spiking twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_neuron_izhikevich_spiking: PASSED only if they match.

import "std/neuro_bci/neuron_izhikevich_spiking.oo";

pub fn main() {
    let neuron_izhikevich_spiking_mark: Int = 0;
    if neuron_izhikevich_spiking_mark != 0 {
        process_exit(1);
    }
    let a: IzhikevichParams = izhikevich_params_regular_spiking();
    let b: IzhikevichParams = izhikevich_params_regular_spiking();
    if (a).a != (b).a {
        println("FAIL izhikevich_params_regular_spiking");
        process_exit(1);
    }
    println("prod_g2_neuron_izhikevich_spiking: PASSED");
}
