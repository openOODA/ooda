// # Product prove std/actor/mailbox.oo
//
// Logline: Fail-closed emit+gcc+run asserts mailbox_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/actor/mailbox.oo.
//
// Beats:
//   1. Call mailbox_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mailbox: PASSED only if they match.

import "std/actor/mailbox.oo";

pub fn main() {
    let obj_a: Mailbox = mailbox_new(1);
    let obj_b: Mailbox = mailbox_new(1);
    let a: Int = mailbox_len(obj_a);
    let b: Int = mailbox_len(obj_b);
    if a != 0 {
        println("FAIL mailbox_len");
        process_exit(1);
    }
    if a != b {
        println("FAIL mailbox_len");
        process_exit(1);
    }
    println("prod_mailbox: PASSED");
}
