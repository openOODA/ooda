// # Product prove std/zk_rollup/merkle_patricia_trie_root.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/merkle_patricia_trie_root.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_root.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_merkle_patricia_trie_root: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_root.oo";

pub fn main() {
    let merkle_patricia_trie_root_a = mpt_encode_nibbles(0, 0);
    let merkle_patricia_trie_root_b = mpt_encode_nibbles(0, 0);
    if merkle_patricia_trie_root_a != merkle_patricia_trie_root_b {
        println("FAIL merkle_patricia_trie_root");
        process_exit(1);
    }
    println("prod_ap_merkle_patricia_trie_root: PASSED");
}
