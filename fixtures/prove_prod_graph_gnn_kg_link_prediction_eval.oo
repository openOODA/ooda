// # Product prove std/graph_gnn/kg_link_prediction_eval.oo
//
// Logline: Fail-closed emit+check asserts compute_filtered_rank is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_link_prediction_eval.oo.
//
// Beats:
//   1. Call compute_filtered_rank twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kg_link_prediction_eval: PASSED only if they match.

import "std/graph_gnn/kg_link_prediction_eval.oo";

pub fn main() {
    let kg_link_prediction_eval_mark: Int = 0;
    if kg_link_prediction_eval_mark != 0 { process_exit(1); }
    let a: Int = compute_filtered_rank(list_new(), 0, list_new());
    let b: Int = compute_filtered_rank(list_new(), 0, list_new());
    if a != b { process_exit(1); }
    println("prod_kg_link_prediction_eval: PASSED");
}
