// # Product prove std/digital_twin/modelica_dae_residual_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts modelica_dae_residual_solver_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/modelica_dae_residual_solver.oo.
//
// Beats:
//   1. Call modelica_dae_residual_solver_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_modelica_dae_residual_solver: PASSED only if they match.

import "std/digital_twin/modelica_dae_residual_solver.oo";

pub fn main() {
    let a: Int = modelica_dae_residual_solver_probe();
    let b: Int = modelica_dae_residual_solver_probe();
    if a != b {
        println("FAIL modelica_dae_residual_solver_probe");
        process_exit(1);
    }
    println("prod_g2_modelica_dae_residual_solver: PASSED");
}
