// # Product prove std/perf/barrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/barrier.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/barrier.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_barrier: PASSED only if they match.

import "std/perf/barrier.oo";

pub fn main() {
    let barrier_a = barrier_create("x", 0);
    let barrier_b = barrier_create("x", 0);
    let barrier_va = barrier_is_open(barrier_a);
    let barrier_vb = barrier_is_open(barrier_b);
    if barrier_va != barrier_vb {
        println("FAIL barrier");
        process_exit(1);
    }
    println("prod_ap_barrier: PASSED");
}
