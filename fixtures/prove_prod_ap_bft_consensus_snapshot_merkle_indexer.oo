// # Product prove std/bft_consensus/snapshot_merkle_indexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/snapshot_merkle_indexer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/snapshot_merkle_indexer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_snapshot_merkle_indexer: PASSED only if they match.

import "std/bft_consensus/snapshot_merkle_indexer.oo";

pub fn main() {
    let snapshot_merkle_indexer_a = snapshot_index_new(0);
    let snapshot_merkle_indexer_b = snapshot_index_new(0);
    let snapshot_merkle_indexer_va = snapshot_is_due(snapshot_merkle_indexer_a, 0);
    let snapshot_merkle_indexer_vb = snapshot_is_due(snapshot_merkle_indexer_b, 0);
    if snapshot_merkle_indexer_va != snapshot_merkle_indexer_vb {
        println("FAIL snapshot_merkle_indexer");
        process_exit(1);
    }
    println("prod_ap_snapshot_merkle_indexer: PASSED");
}
