// # Product Damerau-Levenshtein prove
//
// Logline: Fail-closed emit+gcc+run of shipped damerau_levenshtein_distance.
//
// Setup: Product std/text/levenshtein_damerau.oo. Adjacent transposition is 1.
//
// Beats:
//   1. ab/ba is 1; empty/abc is 3.
//   2. kitten/sitting is 3.
//   3. Exit 1 before PASSED on a miss.

import "std/text/levenshtein_damerau.oo";

pub fn main() {
    let t: Int = damerau_levenshtein_distance("ab", "ba");
    if t != 1 {
        println("FAIL damerau ab/ba");
        process_exit(1);
    }
    let e: Int = damerau_levenshtein_distance("", "abc");
    if e != 3 {
        println("FAIL damerau empty");
        process_exit(1);
    }
    let k: Int = damerau_levenshtein_distance("kitten", "sitting");
    if k != 3 {
        println("FAIL damerau kitten");
        process_exit(1);
    }
    println("prod_damerau: PASSED");
}
