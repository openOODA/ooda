// # Product prove std/bft_consensus/light_client_header_sync.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_client_check_voting_power_overlap is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/light_client_header_sync.oo.
//
// Beats:
//   1. Call light_client_check_voting_power_overlap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_light_client_header_sync: PASSED only if they match.

import "std/bft_consensus/light_client_header_sync.oo";

pub fn main() {
    let light_client_header_sync_mark: Int = 0;
    if light_client_header_sync_mark != 0 {
        process_exit(1);
    }
    let a: Bool = light_client_check_voting_power_overlap(0, 0);
    let b: Bool = light_client_check_voting_power_overlap(0, 0);
    if a != b {
        println("FAIL light_client_check_voting_power_overlap");
        process_exit(1);
    }
    println("prod_light_client_header_sync: PASSED");
}
