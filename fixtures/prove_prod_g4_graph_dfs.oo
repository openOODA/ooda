// # Product prove std/graph_topology/graph_traversal_dfs.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth-first traversal, cycle detection, and connected components.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_traversal_dfs.oo.
//
// Beats:
//   1. Execute DFS traversal and assert vertex discovery count.
//   2. Find path between endpoints using DFS search.
//   3. Detect absence and presence of directed cycles.
//   4. Compute number of connected components in partitioned graphs.

import "std/graph_topology/graph_traversal_dfs.oo";
import "std/graph_topology/graph_adjacency_list.oo";

pub fn main() {
    let mut g1: GraphAdjList = adj_list_create(true);
    adj_list_add_vertex(&mut g1, 0);
    adj_list_add_vertex(&mut g1, 1);
    adj_list_add_vertex(&mut g1, 2);
    adj_list_add_edge_directed(&mut g1, 0, 1, 1);
    adj_list_add_edge_directed(&mut g1, 1, 2, 1);

    let res1: DfsResult = dfs_traverse(&g1, 0, 3);
    let cnt1: Int = (res1).visited_count;
    if cnt1 != 3 {
        println("FAIL dfs_traverse visited_count");
        process_exit(1);
    }

    let path1: List[Int] = dfs_find_path(&g1, 0, 2, 3);
    let plen: Int = list_len(path1);
    if plen != 3 {
        println("FAIL dfs_find_path length");
        process_exit(1);
    }

    let has_c1: Bool = dfs_detect_cycle_directed(&g1, 3);
    if has_c1 == true {
        println("FAIL false cycle detected");
        process_exit(1);
    }

    adj_list_add_edge_directed(&mut g1, 2, 0, 1);
    let has_c2: Bool = dfs_detect_cycle_directed(&g1, 3);
    if has_c2 == false {
        println("FAIL cycle detection failed");
        process_exit(1);
    }

    let mut g2: GraphAdjList = adj_list_create(false);
    adj_list_add_edge(&mut g2, 0, 1, 1);
    adj_list_add_edge(&mut g2, 2, 3, 1);

    let comp_cnt: Int = dfs_connected_components(&g2, 4);
    if comp_cnt != 2 {
        println("FAIL dfs_connected_components");
        process_exit(1);
    }

    println("prod_g4_graph_dfs: PASSED");
    process_exit(0);
}
