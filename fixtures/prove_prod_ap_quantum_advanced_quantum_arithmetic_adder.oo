// # Product prove std/quantum_advanced/quantum_arithmetic_adder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/quantum_arithmetic_adder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_arithmetic_adder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_arithmetic_adder: PASSED only if they match.

import "std/quantum_advanced/quantum_arithmetic_adder.oo";

pub fn main() {
    let quantum_arithmetic_adder_a = draper_phase_angle(0);
    let quantum_arithmetic_adder_b = draper_phase_angle(0);
    if quantum_arithmetic_adder_a != quantum_arithmetic_adder_b {
        println("FAIL quantum_arithmetic_adder");
        process_exit(1);
    }
    println("prod_ap_quantum_arithmetic_adder: PASSED");
}
