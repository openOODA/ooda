// # Product prove std/security_defense/stack_canary_guard.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_canary_generate_terminator is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/stack_canary_guard.oo.
//
// Beats:
//   1. Call stack_canary_generate_terminator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stack_canary_guard: PASSED only if they match.

import "std/security_defense/stack_canary_guard.oo";

pub fn main() {
    let stack_canary_guard_mark: Int = 0;
    if stack_canary_guard_mark != 0 {
        process_exit(1);
    }
    let stack_canary_guard_a: Int = stack_canary_generate_terminator();
    let stack_canary_guard_b: Int = stack_canary_generate_terminator();
    if stack_canary_guard_a != stack_canary_guard_b {
        println("FAIL stack_canary_generate_terminator");
        process_exit(1);
    }
    println("prod_stack_canary_guard: PASSED");
}
