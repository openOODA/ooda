// # Product prove std/telecom/lte_rrc.oo
//
// Logline: Fail-closed emit+gcc+run asserts lte_rrc_is_connected is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/lte_rrc.oo.
//
// Beats:
//   1. Call lte_rrc_is_connected twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lte_rrc: PASSED only if they match.

import "std/telecom/lte_rrc.oo";

pub fn main() {
    let lte_rrc_mark: Int = 0;
    if lte_rrc_mark != 0 {
        process_exit(1);
    }
    let lte_rrc_obj: LteRrcState = lte_rrc_new(1);
    let lte_rrc_a: Bool = lte_rrc_is_connected(&lte_rrc_obj);
    let lte_rrc_b: Bool = lte_rrc_is_connected(&lte_rrc_obj);
    if lte_rrc_a != lte_rrc_b {
        println("FAIL lte_rrc_is_connected");
        process_exit(1);
    }
    println("prod_lte_rrc: PASSED");
}
