// # Product prove std/quantum_tensor_nets/tensor_dense_nd.oo
//
// Logline: Fail-closed emit+gcc+run asserts dense_tensor_nd_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tensor_dense_nd.oo.
//
// Beats:
//   1. Call dense_tensor_nd_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensor_dense_nd: PASSED only if they match.

import "std/quantum_tensor_nets/tensor_dense_nd.oo";

pub fn main() {
    let a: DenseTensorND = dense_tensor_nd_new(list_new());
    let b: DenseTensorND = dense_tensor_nd_new(list_new());
    if a.rank != b.rank {
        println("FAIL dense_tensor_nd_new");
        process_exit(1);
    }
    println("prod_tensor_dense_nd: PASSED");
}
