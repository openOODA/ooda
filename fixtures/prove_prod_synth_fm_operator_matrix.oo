// # Product prove std/media_dsp/synth_fm_operator_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts fm_operator_new real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_fm_operator_matrix.oo.
//
// Beats:
//   1. Call fm_operator_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_fm_operator_matrix: PASSED only if the assert holds.

import "std/media_dsp/synth_fm_operator_matrix.oo";

pub fn main() {
    let synth_fm_operator_matrix_mark: Int = 0;
    if synth_fm_operator_matrix_mark != 0 {
        process_exit(1);
    }
    let synth_fm_operator_matrix_a: FmOperator = fm_operator_new(2.0, 2.0);
    let synth_fm_operator_matrix_feedback_amount: Float = (synth_fm_operator_matrix_a).feedback_amount;
    if !(synth_fm_operator_matrix_feedback_amount == 2.0) {
        println("FAIL fm_operator_new");
        process_exit(1);
    }
    println("prod_synth_fm_operator_matrix: PASSED");
}
