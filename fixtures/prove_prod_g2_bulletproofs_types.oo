// # Product prove std/sec/crypto/bulletproofs_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts bp_range_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_types.oo.
//
// Beats:
//   1. Call bp_range_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bulletproofs_types: PASSED only if they match.

import "std/sec/crypto/bulletproofs_types.oo";

pub fn main() {
    let bulletproofs_types_mark: Int = 0;
    if bulletproofs_types_mark != 0 {
        process_exit(1);
    }
    let a: RangeProof = bp_range_new(0, 0);
    let b: RangeProof = bp_range_new(0, 0);
    if (a).bit_width != (b).bit_width {
        println("FAIL bp_range_new");
        process_exit(1);
    }
    println("prod_g2_bulletproofs_types: PASSED");
}
