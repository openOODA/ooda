// # Product prove std/genomics_advanced/metagenomic_bracken_abundance.oo
//
// Logline: Fail-closed emit+gcc+run asserts metagenomic_bracken_abundance_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/metagenomic_bracken_abundance.oo.
//
// Beats:
//   1. Call metagenomic_bracken_abundance_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_metagenomic_bracken_abundance: PASSED only if they match.

import "std/genomics_advanced/metagenomic_bracken_abundance.oo";

pub fn main() {
    let a = metagenomic_bracken_abundance_probe();
    let b = metagenomic_bracken_abundance_probe();
    if a != b {
        println("FAIL metagenomic_bracken_abundance_probe");
        process_exit(1);
    }
    println("prod_metagenomic_bracken_abundance: PASSED");
}
