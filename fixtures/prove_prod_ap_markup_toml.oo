// # Product prove std/markup/toml.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/toml.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/toml.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_toml: PASSED only if they match.

import "std/markup/toml.oo";

pub fn main() {
    let toml_a = toml_parse("x");
    let toml_b = toml_parse("x");
    if toml_a.is_ok() != toml_b.is_ok() {
        println("FAIL toml");
        process_exit(1);
    }
    println("prod_ap_toml: PASSED");
}
