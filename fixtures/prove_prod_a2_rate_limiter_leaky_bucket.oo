// # Product prove std/cloud/rate_limiter_leaky_bucket.oo
//
// Logline: Fail-closed emit+gcc+run asserts leaky_bucket_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/rate_limiter_leaky_bucket.oo.
//
// Beats:
//   1. Call leaky_bucket_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rate_limiter_leaky_bucket: PASSED only if they match.

import "std/cloud/rate_limiter_leaky_bucket.oo";

pub fn main() {
    let rate_limiter_leaky_bucket_mark: Int = 0;
    if rate_limiter_leaky_bucket_mark != 0 {
        process_exit(1);
    }
    let a: LeakyBucket = leaky_bucket_new(0, 0, 0);
    let b: LeakyBucket = leaky_bucket_new(0, 0, 0);
    if (a).capacity != (b).capacity {
        println("FAIL leaky_bucket_new");
        process_exit(1);
    }
    println("prod_rate_limiter_leaky_bucket: PASSED");
}
