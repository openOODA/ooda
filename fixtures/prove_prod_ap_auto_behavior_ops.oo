// # Product prove std/auto/behavior_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/behavior_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_behavior_ops: PASSED only if they match.

import "std/auto/behavior_ops.oo";

pub fn main() {
    let behavior_ops_a = beh_op_new(0, 0);
    let behavior_ops_b = beh_op_new(0, 0);
    let behavior_ops_va = beh_op_tree_id(behavior_ops_a);
    let behavior_ops_vb = beh_op_tree_id(behavior_ops_b);
    if behavior_ops_va != behavior_ops_vb {
        println("FAIL behavior_ops");
        process_exit(1);
    }
    println("prod_ap_behavior_ops: PASSED");
}
