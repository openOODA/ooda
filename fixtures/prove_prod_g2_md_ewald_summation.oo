// # Product prove std/protein_folding/md_ewald_summation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ewald_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_ewald_summation.oo.
//
// Beats:
//   1. Call ewald_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_md_ewald_summation: PASSED only if they match.

import "std/protein_folding/md_ewald_summation.oo";

pub fn main() {
    let md_ewald_summation_mark: Int = 0;
    if md_ewald_summation_mark != 0 {
        process_exit(1);
    }
    let a: EwaldParams = ewald_params_default(0.0);
    let b: EwaldParams = ewald_params_default(0.0);
    if (a).k_max != (b).k_max {
        println("FAIL ewald_params_default");
        process_exit(1);
    }
    println("prod_g2_md_ewald_summation: PASSED");
}
