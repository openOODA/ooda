// # Product prove std/bft_consensus/delegation_reward_distributor.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/delegation_reward_distributor.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/delegation_reward_distributor.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_delegation_reward_distributor: PASSED only if they match.

import "std/bft_consensus/delegation_reward_distributor.oo";

pub fn main() {
    let delegation_reward_distributor_a = compute_delegator_share(0, 0, 0);
    let delegation_reward_distributor_b = compute_delegator_share(0, 0, 0);
    if delegation_reward_distributor_a != delegation_reward_distributor_b {
        println("FAIL delegation_reward_distributor");
        process_exit(1);
    }
    println("prod_ap_delegation_reward_distributor: PASSED");
}
