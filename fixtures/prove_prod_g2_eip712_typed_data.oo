// # Product prove std/fintech_defi/eip712_typed_data.oo
//
// Logline: Fail-closed emit+gcc+run asserts eip712_domain_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/eip712_typed_data.oo.
//
// Beats:
//   1. Call eip712_domain_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eip712_typed_data: PASSED only if they match.

import "std/fintech_defi/eip712_typed_data.oo";

pub fn main() {
    let eip712_typed_data_mark: Int = 0;
    if eip712_typed_data_mark != 0 {
        process_exit(1);
    }
    let a: Eip712Domain = eip712_domain_new("x", "x", 0, "x");
    let b: Eip712Domain = eip712_domain_new("x", "x", 0, "x");
    if (a).chain_id != (b).chain_id {
        println("FAIL eip712_domain_new");
        process_exit(1);
    }
    println("prod_g2_eip712_typed_data: PASSED");
}
