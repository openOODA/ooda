// # Product prove std/genomics_advanced/hic_contact_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_contact_matrix_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_contact_matrix.oo.
//
// Beats:
//   1. Call hic_contact_matrix_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hic_contact_matrix: PASSED only if it matches.

import "std/genomics_advanced/hic_contact_matrix.oo";

pub fn main() {
    let a: Int = hic_contact_matrix_probe();
    if a != 0 {
        println("FAIL hic_contact_matrix_probe");
        process_exit(1);
    }
    println("prod_nc_hic_contact_matrix: PASSED");
}
