// # Product prove std/sec/sys/landlock_ruleset.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_ruleset_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/landlock_ruleset.oo.
//
// Beats:
//   1. Call landlock_ruleset_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_landlock_ruleset: PASSED only if asserts hold.

import "std/sec/sys/landlock_ruleset.oo";

pub fn main() {
    let landlock_ruleset_a = landlock_ruleset_new("x", 1, 2);
    let landlock_ruleset_b = landlock_ruleset_new("x", 1, 2);
    if landlock_ruleset_a.handled_access_fs != 1 {
        println("FAIL landlock_ruleset_new fs");
        process_exit(1);
    }
    if landlock_ruleset_a.handled_access_net != 2 {
        println("FAIL landlock_ruleset_new net");
        process_exit(1);
    }
    if landlock_ruleset_a.handled_access_fs != landlock_ruleset_b.handled_access_fs {
        println("FAIL landlock_ruleset_new det");
        process_exit(1);
    }
    println("prod_landlock_ruleset: PASSED");
}
