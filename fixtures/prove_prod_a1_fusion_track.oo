// # Product prove std/auto/fusion_track.oo
//
// Logline: Fail-closed emit+gcc+run asserts fus_trk_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_track.oo.
//
// Beats:
//   1. Call fus_trk_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fusion_track: PASSED only if they match.

import "std/auto/fusion_track.oo";

pub fn main() {
    let fusion_track_mark: Int = 0;
    if fusion_track_mark != 0 {
        process_exit(1);
    }
    let a: FusTrk = fus_trk_new(0, 0);
    let b: FusTrk = fus_trk_new(0, 0);
    if (a).hits != (b).hits {
        println("FAIL fus_trk_new");
        process_exit(1);
    }
    println("prod_fusion_track: PASSED");
}
