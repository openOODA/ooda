// # Product prove std/astrophysics_relativity/gw_quadrupole_formula.oo
//
// Logline: Fail-closed emit+gcc+run asserts peters_mathews_f_e is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_quadrupole_formula.oo.
//
// Beats:
//   1. Call peters_mathews_f_e twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_quadrupole_formula: PASSED only if they match.

import "std/astrophysics_relativity/gw_quadrupole_formula.oo";

pub fn main() {
    let gw_quadrupole_formula_mark: Int = 0;
    if gw_quadrupole_formula_mark != 0 {
        process_exit(1);
    }
    let a: Int = peters_mathews_f_e(0);
    let b: Int = peters_mathews_f_e(0);
    if a != b {
        println("FAIL peters_mathews_f_e");
        process_exit(1);
    }
    println("prod_gw_quadrupole_formula: PASSED");
}
