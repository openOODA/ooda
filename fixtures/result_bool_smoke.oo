// # Result[Bool] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[Bool, String] Ok payload as Bool.
//
// Setup: Backend-C. Ok(true) must stay Bool, not a string.
//
// Beats:
//   1. f returns Ok(true).
//   2. Match binds n as Bool true.
//   3. Exit 1 before PASSED on a miss.

pub fn f() -> Result[Bool, String] {
    return Ok(true);
}

pub fn main() {
    let r: Result[Bool, String] = f();
    let n: Bool = match r {
        Ok(v) => v,
        Err(e) => false
    };
    if n == false {
        println("FAIL");
        process_exit(1);
    }
    println("result_bool_smoke: PASSED");
}
