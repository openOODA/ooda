// # Product prove std/zk_rollup/rollup_batch_sequencer.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_batch_header_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_batch_sequencer.oo.
//
// Beats:
//   1. Call rollup_batch_header_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rollup_batch_sequencer: PASSED only if asserts hold.

import "std/zk_rollup/rollup_batch_sequencer.oo";

pub fn main() {
    let rollup_batch_sequencer_a = rollup_batch_header_new(1, 0, 0, 0, 0, 0);
    let rollup_batch_sequencer_b = rollup_batch_header_new(1, 0, 0, 0, 0, 0);
    if rollup_batch_sequencer_a.batch_number != rollup_batch_sequencer_b.batch_number {
        println("FAIL rollup_batch_header_new");
        process_exit(1);
    }
    println("prod_rollup_batch_sequencer: PASSED");
}
