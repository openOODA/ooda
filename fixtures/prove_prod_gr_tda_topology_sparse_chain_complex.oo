// # Product prove std/tda_topology/sparse_chain_complex.oo
//
// Logline: Fail-closed emit+gcc+run asserts chain_add_term is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sparse_chain_complex.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chain_add_term twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_sparse_chain_complex: PASSED only if they match.

import "std/tda_topology/sparse_chain_complex.oo";

pub fn main() {
    let mut g0_oa = chain_new(0);
    let mut g0_ob = chain_new(0);
    let g0_a = chain_add_term(&g0_oa, 0, 0);
    let g0_b = chain_add_term(&g0_ob, 0, 0);
    if g0_a != g0_b {
        println("FAIL chain_add_term");
        process_exit(1);
    }
    println("prod_gr_sparse_chain_complex: PASSED");
}
