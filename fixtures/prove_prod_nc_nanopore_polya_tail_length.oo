// # Product prove std/genomics_advanced/nanopore_polya_tail_length.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_polya_tail_length_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_polya_tail_length.oo.
//
// Beats:
//   1. Call nanopore_polya_tail_length_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_nanopore_polya_tail_length: PASSED only if it matches.

import "std/genomics_advanced/nanopore_polya_tail_length.oo";

pub fn main() {
    let a: Int = nanopore_polya_tail_length_probe();
    if a != 0 {
        println("FAIL nanopore_polya_tail_length_probe");
        process_exit(1);
    }
    println("prod_nc_nanopore_polya_tail_length: PASSED");
}
