// # Product prove std/ai_ml/onnx_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts onnx_engine_new holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/onnx_engine.oo.
//
// Beats:
//   1. Call onnx_engine_new using the onnx_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_onnx_engine: PASSED only if asserts hold.

import "std/ai_ml/onnx_engine.oo";

pub fn main() {
    let obj = onnx_engine_new();
    let onnx_engine_a = obj.is_initialized;
    if !onnx_engine_a {
        println("FAIL onnx_engine_new");
        process_exit(1);
    }
    println("prod_onnx_engine: PASSED");
}
