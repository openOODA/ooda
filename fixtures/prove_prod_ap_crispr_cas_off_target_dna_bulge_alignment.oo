// # Product prove std/crispr_cas/off_target_dna_bulge_alignment.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crispr_cas/off_target_dna_bulge_alignment.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/off_target_dna_bulge_alignment.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_off_target_dna_bulge_alignment: PASSED only if they match.

import "std/crispr_cas/off_target_dna_bulge_alignment.oo";

pub fn main() {
    let off_target_dna_bulge_alignment_a = bulge_score_penalty("x", 0, 0);
    let off_target_dna_bulge_alignment_b = bulge_score_penalty("x", 0, 0);
    if off_target_dna_bulge_alignment_a != off_target_dna_bulge_alignment_b {
        println("FAIL off_target_dna_bulge_alignment");
        process_exit(1);
    }
    println("prod_ap_off_target_dna_bulge_alignment: PASSED");
}
