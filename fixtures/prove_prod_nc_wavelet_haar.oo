// # Product prove std/scicomp/wavelet_haar.oo
//
// Logline: Fail-closed emit+gcc+run asserts wavelet_haar_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/wavelet_haar.oo.
//
// Beats:
//   1. Call wavelet_haar_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_wavelet_haar: PASSED only if it matches.

import "std/scicomp/wavelet_haar.oo";

pub fn main() {
    let a: Int = wavelet_haar_probe();
    if a != 0 {
        println("FAIL wavelet_haar_probe");
        process_exit(1);
    }
    println("prod_nc_wavelet_haar: PASSED");
}
