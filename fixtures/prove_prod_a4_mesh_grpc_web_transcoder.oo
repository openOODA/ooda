// # Product prove std/mesh_ebpf/mesh_grpc_web_transcoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts grpc_web_http_to_grpc_status is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_grpc_web_transcoder.oo.
//
// Beats:
//   1. Call grpc_web_http_to_grpc_status twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_grpc_web_transcoder: PASSED only if they match.

import "std/mesh_ebpf/mesh_grpc_web_transcoder.oo";

pub fn main() {
    let mesh_grpc_web_transcoder_mark: Int = 0;
    if mesh_grpc_web_transcoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = grpc_web_http_to_grpc_status(0);
    let b: Int = grpc_web_http_to_grpc_status(0);
    if a != b {
        println("FAIL grpc_web_http_to_grpc_status");
        process_exit(1);
    }
    println("prod_mesh_grpc_web_transcoder: PASSED");
}
