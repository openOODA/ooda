// # Product prove BLAKE3 Modular Hash Library
//
// Logline: Verify the modular BLAKE3 one-shot hash from blake3.oo, blake3_core.oo, and blake3_codec.oo returns a 64-character lowercase hex digest and is deterministic for fixed input, diverges on tamper.
//
// Setup: Imports std/hash/blake3.oo, blake3_core.oo, and blake3_codec.oo. Pure Int 32-bit hash function, no IO.
//
// Beats:
//   1. Hash the empty string and assert a 64-character lowercase hex digest.
//   2. Hash "abc" and assert a deterministic 64-character lowercase hex digest.
//   3. Verify hash determinism: same input twice produces the same digest.
//   4. Verify hash sensitivity: distinct inputs produce distinct digests.

import "std/hash/blake3.oo";
import "std/hash/blake3_core.oo";
import "std/hash/blake3_codec.oo";

pub fn hex_len(s: String) -> Int {
    return s.len();
}

pub fn hex_is_lowercase(s: String) -> Bool {
    let n: Int = s.len();
    let mut i: Int = 0;
    while i < n {
        let c: Int = byte_at(s, i);
        let is_digit: Bool = c >= 48 && c <= 57;
        let is_lower: Bool = c >= 97 && c <= 122;
        if is_digit == false {
            if is_lower == false {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

pub fn hex_chars_valid(s: String) -> Bool {
    let n: Int = s.len();
    if n != 64 {
        return false;
    }
    return hex_is_lowercase(s);
}

pub fn test_blake3_empty() {
    let d: String = blake3("");
    if hex_chars_valid(d) == false {
        println("FAIL: blake3 empty digest is not 64 lowercase hex chars");
        process_exit(1);
    }
    let d2: String = blake3("");
    if d != d2 {
        println("FAIL: blake3 empty is not deterministic");
        process_exit(1);
    }
    println("PASS: blake3 empty -> 64-hex deterministic");
}

pub fn test_blake3_abc() {
    let d: String = blake3("abc");
    if hex_chars_valid(d) == false {
        println("FAIL: blake3 abc digest is not 64 lowercase hex chars");
        process_exit(1);
    }
    let d2: String = blake3("abc");
    if d != d2 {
        println("FAIL: blake3 abc is not deterministic");
        process_exit(1);
    }
    println("PASS: blake3 abc -> 64-hex deterministic");
}

pub fn test_blake3_sensitivity() {
    let d1: String = blake3("abc");
    let d2: String = blake3("abd");
    if d1 == d2 {
        println("FAIL: blake3 collision on single-byte tamper");
        process_exit(1);
    }
    let d3: String = blake3("ab");
    let d4: String = blake3("abc");
    if d3 == d4 {
        println("FAIL: blake3 collision on length change");
        process_exit(1);
    }
    println("PASS: blake3 detects single-byte and length tampering");
}

pub fn test_blake3_known_vector() {
    let d: String = blake3("");
    if hex_chars_valid(d) == false {
        println("FAIL: known vector digest format");
        process_exit(1);
    }
    println("PASS: blake3 known vector format check");
}

pub fn main() {
    test_blake3_empty();
    test_blake3_abc();
    test_blake3_sensitivity();
    test_blake3_known_vector();
    println("PROVE_PROD_BLAKE3_MODULAR_PASSED");
}
