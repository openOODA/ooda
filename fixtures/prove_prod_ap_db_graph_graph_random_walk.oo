// # Product prove std/db_graph/graph_random_walk.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_random_walk.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_random_walk.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_random_walk: PASSED only if they match.

import "std/db_graph/graph_random_walk.oo";

pub fn main() {
    let graph_random_walk_a = compute_node2vec_alpha(0, 0.0, 0.0);
    let graph_random_walk_b = compute_node2vec_alpha(0, 0.0, 0.0);
    if graph_random_walk_a != graph_random_walk_b {
        println("FAIL graph_random_walk");
        process_exit(1);
    }
    println("prod_ap_graph_random_walk: PASSED");
}
