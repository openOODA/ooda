
import "std/geometry/convex_hull.oo";
pub fn main() {
    let mut p: List[Float] = list_new();
    p = list_push(p, 0.0);
    p = list_push(p, 0.0);
    p = list_push(p, 1.0);
    p = list_push(p, 0.0);
    p = list_push(p, 1.0);
    p = list_push(p, 1.0);
    p = list_push(p, 0.0);
    p = list_push(p, 1.0);
    p = list_push(p, 0.5);
    p = list_push(p, 0.5);
    let h: List[Float] = match convex_hull_build(p) { Ok(v) => v, Err(e) => list_new() };
    println("hull len=" + list_len(h).to_string());
}
