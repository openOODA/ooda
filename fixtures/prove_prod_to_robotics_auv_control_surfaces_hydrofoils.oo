// # Product prove std/robotics_auv/control_surfaces_hydrofoils.oo
//
// Logline: Fail-closed emit+gcc+run asserts hydrofoil_params_default_rudder holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/control_surfaces_hydrofoils.oo.
//
// Beats:
//   1. Call hydrofoil_params_default_rudder using the control_surfaces_hydrofoils ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_control_surfaces_hydrofoils: PASSED only if asserts hold.

import "std/robotics_auv/control_surfaces_hydrofoils.oo";

pub fn main() {
    let obj = hydrofoil_params_default_rudder();
    let control_surfaces_hydrofoils_a = obj.area_m2;
    if control_surfaces_hydrofoils_a != 0.015 {
        println("FAIL hydrofoil_params_default_rudder");
        process_exit(1);
    }
    println("prod_control_surfaces_hydrofoils: PASSED");
}
