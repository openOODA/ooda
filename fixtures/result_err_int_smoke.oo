// # Result[Int, Int] Err payload lock
//
// Logline: Fail-closed emit+gcc+run of Result[Int, Int] so Err(7) is an int, not a string.
//
// Setup: Backend-C. E is Int. Match Err must bind long long.
//
// Beats:
//   1. Return Err(7).
//   2. Match Err payload equals 7.
//   3. Exit 1 before PASSED on a miss.

pub fn boom() -> Result[Int, Int] {
    return Err(7);
}

pub fn main() {
    let r: Result[Int, Int] = boom();
    let v: Int = match r {
        Ok(x) => x,
        Err(e) => e
    };
    if v != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("result_err_int_smoke: PASSED");
}
