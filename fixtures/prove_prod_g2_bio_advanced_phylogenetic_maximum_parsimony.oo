// # Product prove std/bio_advanced/phylogenetic_maximum_parsimony.oo
//
// Logline: Fail-closed emit+gcc+run asserts parsimony_calc_consistency_index is a real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/phylogenetic_maximum_parsimony.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call parsimony_calc_consistency_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_phylogenetic_maximum_parsimony: PASSED only if they match.

import "std/bio_advanced/phylogenetic_maximum_parsimony.oo";

pub fn main() {
    let g2_a = parsimony_calc_consistency_index(2, 8);
    let g2_b = parsimony_calc_consistency_index(2, 8);
    if g2_a != g2_b {
        println("FAIL parsimony_calc_consistency_index");
        process_exit(1);
    }
    println("prod_g2_phylogenetic_maximum_parsimony: PASSED");
}
