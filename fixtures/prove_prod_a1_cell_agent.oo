// # Product prove std/bio/cell_agent.oo
//
// Logline: Fail-closed emit+gcc+run asserts agent_cell_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_agent.oo.
//
// Beats:
//   1. Call agent_cell_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cell_agent: PASSED only if they match.

import "std/bio/cell_agent.oo";

pub fn main() {
    let cell_agent_mark: Int = 0;
    if cell_agent_mark != 0 {
        process_exit(1);
    }
    let a: AgentCell = agent_cell_new(0, "x", 0.0, 0.0);
    let b: AgentCell = agent_cell_new(0, "x", 0.0, 0.0);
    if (a).cell_id != (b).cell_id {
        println("FAIL agent_cell_new");
        process_exit(1);
    }
    println("prod_cell_agent: PASSED");
}
