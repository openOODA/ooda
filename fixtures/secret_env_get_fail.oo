// # Refuse a secret env_get key
//
// Logline: A tagged name must not be used as the env_get key.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the key.
//   3. Expect the sink to refuse.

// M140: Secret must not be used as env_get key
// SECRET: token
pub fn main(envc: &EnvCap) {
    let token = "SECRET_KEY";
    let r = env_get(envc, token);
    println(1);
}
