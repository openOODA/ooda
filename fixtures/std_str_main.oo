// # Drive owned string helpers
//
// Logline: Call std/str length, empty, eq, contains, concat, char_at, and slice helpers.
//
// Setup: Test fixture. Imports std/str.oo. Check the library as a single file.
//
// Beats:
//   1. Print length and empty checks.
//   2. Print eq and contains flags.
//   3. Print concat, char_at, and a slice.
//
// check residual: oodac check is single-file; check library: oodac check std/str.oo
import "std/str.oo";

pub fn main() {
    let s = "hello";
    println(str_len(s));
    if str_is_empty("") {
        println(1);
    } else {
        println(0);
    }
    if str_eq(s, "hello") {
        println(1);
    } else {
        println(0);
    }
    if str_contains(s, "ell") {
        println(1);
    } else {
        println(0);
    }
    let t: String = str_concat("a", "b");
    println(t);
    let c: String = str_char_at(s, 0);
    println(c);
    let u: String = str_sub(s, 1, 4);
    println(u);
}
