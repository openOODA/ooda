// # emit-x86 bump concat of two strings
//
// Logline: Call cat on yy and zz so emit-x86 must copy into a .bss bump then print yyzz.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No const-fold of concat.
//
// Beats:
//   1. Declare cat as return a plus b.
//   2. Print cat("yy", "zz").
//   3. Expect yyzz from a real call.

fn cat(a: String, b: String) -> String {
    return a + b;
}

pub fn main() {
    println(cat("yy", "zz"));
}
