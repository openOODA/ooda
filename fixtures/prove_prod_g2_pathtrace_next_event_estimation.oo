// # Product prove std/pbr_raytracing/pathtrace_next_event_estimation.oo
//
// Logline: Fail-closed emit+gcc+run asserts pathtrace_next_event_estimation_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pathtrace_next_event_estimation.oo.
//
// Beats:
//   1. Call pathtrace_next_event_estimation_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pathtrace_next_event_estimation: PASSED only if they match.

import "std/pbr_raytracing/pathtrace_next_event_estimation.oo";

pub fn main() {
    let a: Int = pathtrace_next_event_estimation_probe();
    let b: Int = pathtrace_next_event_estimation_probe();
    if a != b {
        println("FAIL pathtrace_next_event_estimation_probe");
        process_exit(1);
    }
    println("prod_g2_pathtrace_next_event_estimation: PASSED");
}
