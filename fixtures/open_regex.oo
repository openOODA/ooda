// # Product regex a+ match and miss
//
// Logline: nfa_simulate matches aaa and misses bbb for pattern a+.
//
// Setup: OPEN-45. ooda/std/text/regex_nfa.oo. Not a full DFA.
//
// Beats:
//   1. Match aaa.
//   2. Miss bbb.
//   3. Print PASSED.

import "std/text/regex_nfa.oo";

pub fn main() {
    let ok: Bool = nfa_simulate("a+", "aaa");
    let no: Bool = nfa_simulate("a+", "bbb");
    if !ok {
        println("FAIL match");
        process_exit(1);
    }
    if no {
        println("FAIL miss");
        process_exit(1);
    }
    println("open_regex: PASSED");
}