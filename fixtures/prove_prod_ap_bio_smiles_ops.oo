// # Product prove std/bio/smiles_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/smiles_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_smiles_ops: PASSED only if they match.

import "std/bio/smiles_ops.oo";

pub fn main() {
    let smiles_ops_a = atom_symbol_to_number("x");
    let smiles_ops_b = atom_symbol_to_number("x");
    if smiles_ops_a != smiles_ops_b {
        println("FAIL smiles_ops");
        process_exit(1);
    }
    println("prod_ap_smiles_ops: PASSED");
}
