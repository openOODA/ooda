// # Product prove std/db_vector_ann/vector_matryoshka_slicing.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_matryoshka_slicing.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_matryoshka_slicing.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vector_matryoshka_slicing: PASSED only if they match.

import "std/db_vector_ann/vector_matryoshka_slicing.oo";

pub fn main() {
    let vector_matryoshka_slicing_a = slice_matryoshka_prefix(list_new(), 0);
    let vector_matryoshka_slicing_b = slice_matryoshka_prefix(list_new(), 0);
    if list_len(vector_matryoshka_slicing_a) != list_len(vector_matryoshka_slicing_b) {
        println("FAIL vector_matryoshka_slicing");
        process_exit(1);
    }
    println("prod_ap_vector_matryoshka_slicing: PASSED");
}
