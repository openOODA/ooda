// # Product prove std/robot/safety.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_clamp_speed holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/safety.oo.
//
// Beats:
//   1. Call shim_marker_clamp_speed using the safety ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_safety: PASSED only if asserts hold.

import "std/robot/safety.oo";

pub fn main() {
    let safety_a = shim_marker_clamp_speed(0, 0);
    let safety_b = shim_marker_clamp_speed(0, 0);
    if safety_a != safety_b {
        println("FAIL shim_marker_clamp_speed");
        process_exit(1);
    }
    println("prod_safety: PASSED");
}
