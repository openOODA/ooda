// # println outside fn main is leftover
//
// Logline: A helper println STRING plus main println must fail closed.
//
// Setup: Side emit-aarch64 harvests only the main body. Helper prints are leftover.
//
// Beats:
//   1. helper prints OUT.
//   2. main prints Hello.
//   3. Emit must ERR leftover and must not write OUT then Hello.

fn helper() {
    println("OUT");
}

pub fn main() {
    println("Hello");
}
