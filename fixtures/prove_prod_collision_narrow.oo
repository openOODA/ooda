// # Product prove std/physics/collision_narrow.oo
//
// Logline: Fail-closed emit+gcc+run asserts sphere_intersects_sphere is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/collision_narrow.oo.
//
// Beats:
//   1. Call sphere_intersects_sphere twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_collision_narrow: PASSED only if they match.

import "std/physics/collision_narrow.oo";

pub fn main() {
    let collision_narrow_mark: Int = 0;
    if collision_narrow_mark != 0 {
        process_exit(1);
    }
    let a: Int = sphere_intersects_sphere(0, 0);
    let b: Int = sphere_intersects_sphere(0, 0);
    if a != b {
        println("FAIL sphere_intersects_sphere");
        process_exit(1);
    }
    println("prod_collision_narrow: PASSED");
}
