// # Product cloud leaky bucket prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud/rate_limiter_leaky_bucket.oo.
//
// Setup: Product std/cloud/rate_limiter_leaky_bucket.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New bucket is not full and wait is 0.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud/rate_limiter_leaky_bucket.oo";

pub fn main() {
    let b: LeakyBucket = leaky_bucket_new(10, 2, 0);
    let f: Int = leaky_bucket_is_full(b);
    if f != 0 {
        println("FAIL leaky full");
        process_exit(1);
    }
    let w: Int = leaky_bucket_estimated_wait_ms(b);
    if w != 0 {
        println("FAIL leaky wait");
        process_exit(1);
    }
    println("prod_leakybkt: PASSED");
}
