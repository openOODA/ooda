// # Product prove std/telecom_5g/dsp_iq_imbalance_corrector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom_5g/dsp_iq_imbalance_corrector.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_iq_imbalance_corrector.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dsp_iq_imbalance_corrector: PASSED only if they match.

import "std/telecom_5g/dsp_iq_imbalance_corrector.oo";

pub fn main() {
    let dsp_iq_imbalance_corrector_a = dsp_iq_calc_irr_db(0.0, 0.0);
    let dsp_iq_imbalance_corrector_b = dsp_iq_calc_irr_db(0.0, 0.0);
    if dsp_iq_imbalance_corrector_a != dsp_iq_imbalance_corrector_b {
        println("FAIL dsp_iq_imbalance_corrector");
        process_exit(1);
    }
    println("prod_ap_dsp_iq_imbalance_corrector: PASSED");
}
