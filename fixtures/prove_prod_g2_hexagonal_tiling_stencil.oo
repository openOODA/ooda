// # Product prove std/compilers_polyhedral/hexagonal_tiling_stencil.oo
//
// Logline: Fail-closed emit+gcc+run asserts hexagonal_tile_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/hexagonal_tiling_stencil.oo.
//
// Beats:
//   1. Call hexagonal_tile_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hexagonal_tiling_stencil: PASSED only if they match.

import "std/compilers_polyhedral/hexagonal_tiling_stencil.oo";

pub fn main() {
    let hexagonal_tiling_stencil_mark: Int = 0;
    if hexagonal_tiling_stencil_mark != 0 {
        process_exit(1);
    }
    let a: HexagonalTile = hexagonal_tile_new(0, 0, 0, 0, true);
    let b: HexagonalTile = hexagonal_tile_new(0, 0, 0, 0, true);
    if (a).tile_id != (b).tile_id {
        println("FAIL hexagonal_tile_new");
        process_exit(1);
    }
    println("prod_g2_hexagonal_tiling_stencil: PASSED");
}
