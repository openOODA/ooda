// # Product prove std/multimedia/mp4_box.oo
//
// Logline: Fail-closed emit+gcc+run asserts mp4_box_is_container is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/mp4_box.oo.
//
// Beats:
//   1. Call mp4_box_is_container twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mp4_box: PASSED only if they match.

import "std/multimedia/mp4_box.oo";

pub fn main() {
    let a = mp4_box_is_container("x");
    let b = mp4_box_is_container("x");
    if a != b {
        println("FAIL mp4_box_is_container");
        process_exit(1);
    }
    println("prod_mp4_box: PASSED");
}
