// # Product prove std/tui/theme_light.oo
//
// Logline: Fail-closed emit+gcc+run asserts theme_light_solarized is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/theme_light.oo.
//
// Beats:
//   1. Call theme_light_solarized twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_theme_light: PASSED only if they match.

import "std/tui/theme_light.oo";

pub fn main() {
    let theme_light_mark: Int = 0;
    if theme_light_mark != 0 {
        process_exit(1);
    }
    let theme_light_a = theme_light_solarized();
    let theme_light_b = theme_light_solarized();
    if (theme_light_a).bg != (theme_light_b).bg {
        println("FAIL theme_light_solarized");
        process_exit(1);
    }
    println("prod_theme_light: PASSED");
}
