// # Product prove std/cloud_k8s/load_balancer_round_robin.oo
//
// Logline: Fail-closed emit+gcc+run asserts round_robin_balancer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/load_balancer_round_robin.oo.
//
// Beats:
//   1. Call round_robin_balancer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_load_balancer_round_robin: PASSED only if they match.

import "std/cloud_k8s/load_balancer_round_robin.oo";

pub fn main() {
    let load_balancer_round_robin_mark: Int = 0;
    if load_balancer_round_robin_mark != 0 {
        process_exit(1);
    }
    let a: RoundRobinBalancer = round_robin_balancer_new(0, 0);
    let b: RoundRobinBalancer = round_robin_balancer_new(0, 0);
    if (a).w0 != (b).w0 {
        println("FAIL round_robin_balancer_new");
        process_exit(1);
    }
    println("prod_load_balancer_round_robin: PASSED");
}
