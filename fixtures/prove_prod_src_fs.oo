// # Product prove std/fs/src_fs.oo
//
// Logline: Fail-closed emit+gcc+run asserts rx000_k is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/src_fs.oo.
//
// Beats:
//   1. Call rx000_k twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_src_fs: PASSED only if they match.

import "std/fs/src_fs.oo";

pub fn main() {
    let a = rx000_k();
    let b = rx000_k();
    if a != b {
        println("FAIL rx000_k");
        process_exit(1);
    }
    println("prod_src_fs: PASSED");
}
