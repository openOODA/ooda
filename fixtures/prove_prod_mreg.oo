// # Product diag metrics registry prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/metrics_registry.oo.
//
// Setup: Product std/diag/metrics_registry.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New len 0 empty.
//   2. counter_inc then len 1.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/metrics_registry.oo";

pub fn main() {
    let r0: MetricsRegistry = registry_new();
    let n0: Int = registry_len(r0);
    if n0 != 0 {
        println("FAIL mreg 0");
        process_exit(1);
    }
    if registry_is_empty(r0) == false {
        println("FAIL mreg empty");
        process_exit(1);
    }
    let r1: MetricsRegistry = registry_counter_inc(r0, "hits", 3);
    let n1: Int = registry_len(r1);
    if n1 != 1 {
        println("FAIL mreg 1");
        process_exit(1);
    }
    let p: String = registry_format_prometheus(r1);
    if p != "# TYPE hits counter\nhits 3\n" {
        println("FAIL mreg prom");
        process_exit(1);
    }
    println("prod_mreg: PASSED");
}
