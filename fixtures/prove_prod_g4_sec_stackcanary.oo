// # Product prove std/sec/sys/stackcanary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/stackcanary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/stackcanary.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_stackcanary: PASSED and exit 0 only on match.

import "std/sec/sys/stackcanary.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_sys_stackcanary_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_sys_stackcanary_oo();
    if dummy_a != dummy_b {
        println("FAIL stackcanary dummy");
        process_exit(1);
    }

    let lvl_a: Int = shim_marker_canary_level_standard();
    let lvl_b: Int = shim_marker_canary_level_standard();
    if lvl_a != lvl_b {
        println("FAIL canary_level_standard");
        process_exit(1);
    }

    let cookie_a: Int = shim_marker_canary_default_magic_cookie();
    let cookie_b: Int = shim_marker_canary_default_magic_cookie();
    if cookie_a != cookie_b {
        println("FAIL canary_default_magic_cookie");
        process_exit(1);
    }

    let si_a: StackIntegrity = shim_marker_stack_integrity_new();
    let si_b: StackIntegrity = shim_marker_stack_integrity_new();
    let passed_si_a: StackIntegrity = stack_integrity_pass(si_a);
    let passed_si_b: StackIntegrity = stack_integrity_pass(si_b);
    let checked_a: Int = passed_si_a.total_frames_checked;
    let checked_b: Int = passed_si_b.total_frames_checked;
    if checked_a != checked_b {
        println("FAIL total_frames_checked");
        process_exit(1);
    }

    println("prod_g4_sec_stackcanary: PASSED");
    process_exit(0);
}
