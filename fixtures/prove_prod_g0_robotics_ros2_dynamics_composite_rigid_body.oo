// # Product prove std/robotics_ros2/dynamics_composite_rigid_body.oo
//
// Logline: Fail-closed emit+gcc+run asserts crba_is_positive_definite is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/dynamics_composite_rigid_body.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call crba_is_positive_definite twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_dynamics_composite_rigid_body: PASSED only if they match.

import "std/robotics_ros2/dynamics_composite_rigid_body.oo";

pub fn main() {
    let g0_oa: InertiaMatrix2x2 = InertiaMatrix2x2 { m11: 1.0, m12: 1.0, m21: 1.0, m22: 1.0, determinant: 1.0 };
    let g0_ob: InertiaMatrix2x2 = InertiaMatrix2x2 { m11: 1.0, m12: 1.0, m21: 1.0, m22: 1.0, determinant: 1.0 };
    let g0_a = crba_is_positive_definite(&g0_oa);
    let g0_b = crba_is_positive_definite(&g0_ob);
    if g0_a != g0_b {
        println("FAIL crba_is_positive_definite");
        process_exit(1);
    }
    println("prod_g0_dynamics_composite_rigid_body: PASSED");
}
