// # Product prove std/space_propulsion/rocket_film_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts film_cooling_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_film_cooling.oo.
//
// Beats:
//   1. Call film_cooling_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_film_cooling: PASSED only if they match.

import "std/space_propulsion/rocket_film_cooling.oo";

pub fn main() {
    let rocket_film_cooling_mark: Int = 0;
    if rocket_film_cooling_mark != 0 {
        process_exit(1);
    }
    let a: FilmCoolingSpec = film_cooling_spec_default();
    let b: FilmCoolingSpec = film_cooling_spec_default();
    if (a).film_mass_fraction != (b).film_mass_fraction {
        println("FAIL film_cooling_spec_default");
        process_exit(1);
    }
    println("prod_rocket_film_cooling: PASSED");
}
