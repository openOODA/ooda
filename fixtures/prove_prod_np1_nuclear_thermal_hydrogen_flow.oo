// # Product prove std/space_propulsion/nuclear_thermal_hydrogen_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntr_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/nuclear_thermal_hydrogen_flow.oo.
//
// Beats:
//   1. Call ntr_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nuclear_thermal_hydrogen_flow: PASSED only if they match.

import "std/space_propulsion/nuclear_thermal_hydrogen_flow.oo";

pub fn main() {
    let nuclear_thermal_hydrogen_flow_mark: Int = 0;
    if nuclear_thermal_hydrogen_flow_mark != 0 {
        process_exit(1);
    }
    let nuclear_thermal_hydrogen_flow_a = ntr_compute_performance(ntr_spec_default_nerva());
    let nuclear_thermal_hydrogen_flow_b = ntr_compute_performance(ntr_spec_default_nerva());
    if (nuclear_thermal_hydrogen_flow_a).hydrogen_exit_temp_k != (nuclear_thermal_hydrogen_flow_b).hydrogen_exit_temp_k {
        println("FAIL ntr_compute_performance");
        process_exit(1);
    }
    println("prod_nuclear_thermal_hydrogen_flow: PASSED");
}
