// # Product prove std/simd/simd_lerp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_lerp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_lerp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_lerp: PASSED only if they match.

import "std/simd/simd_lerp.oo";

pub fn main() {
    let simd_lerp_a = simd_lerp_f32(0.0, 0.0, 0.0);
    let simd_lerp_b = simd_lerp_f32(0.0, 0.0, 0.0);
    if simd_lerp_a != simd_lerp_b {
        println("FAIL simd_lerp");
        process_exit(1);
    }
    println("prod_ap_simd_lerp: PASSED");
}
