// # Product prove std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_choi_jamiolkowski_isomorphism: PASSED only if they match.

import "std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo";

pub fn main() {
    let choi_jamiolkowski_isomorphism_a = choi_depolarizing_channel(0.0);
    let choi_jamiolkowski_isomorphism_b = choi_depolarizing_channel(0.0);
    let choi_jamiolkowski_isomorphism_va = choi_matrix_trace(choi_jamiolkowski_isomorphism_a);
    let choi_jamiolkowski_isomorphism_vb = choi_matrix_trace(choi_jamiolkowski_isomorphism_b);
    if choi_jamiolkowski_isomorphism_va != choi_jamiolkowski_isomorphism_vb {
        println("FAIL choi_jamiolkowski_isomorphism");
        process_exit(1);
    }
    println("prod_ap_choi_jamiolkowski_isomorphism: PASSED");
}
