// # Product prove std/security_defense/anti_debug_ptrace_probe.oo
//
// Logline: Fail-closed emit+gcc+run asserts anti_debug_probe_all is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/anti_debug_ptrace_probe.oo.
//
// Beats:
//   1. Call anti_debug_probe_all twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anti_debug_ptrace_probe: PASSED only if they match.

import "std/security_defense/anti_debug_ptrace_probe.oo";

pub fn main() {
    let anti_debug_ptrace_probe_mark: Int = 0;
    if anti_debug_ptrace_probe_mark != 0 {
        process_exit(1);
    }
    let anti_debug_ptrace_probe_a = anti_debug_probe_all(1, 1, 1);
    let anti_debug_ptrace_probe_b = anti_debug_probe_all(1, 1, 1);
    if (anti_debug_ptrace_probe_a).defense_action != (anti_debug_ptrace_probe_b).defense_action {
        println("FAIL anti_debug_probe_all");
        process_exit(1);
    }
    println("prod_anti_debug_ptrace_probe: PASSED");
}
