// # Product prove std/zk_rollup/mimc_cipher_permutation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimc_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/mimc_cipher_permutation.oo.
//
// Beats:
//   1. Call mimc_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimc_cipher_permutation: PASSED only if they match.

import "std/zk_rollup/mimc_cipher_permutation.oo";

pub fn main() {
    let mimc_cipher_permutation_mark: Int = 0;
    if mimc_cipher_permutation_mark != 0 {
        process_exit(1);
    }
    let a: MimcParams = mimc_params_default(1, 1);
    let b: MimcParams = mimc_params_default(1, 1);
    if (a).n_rounds != (b).n_rounds {
        println("FAIL mimc_params_default");
        process_exit(1);
    }
    println("prod_mimc_cipher_permutation: PASSED");
}
