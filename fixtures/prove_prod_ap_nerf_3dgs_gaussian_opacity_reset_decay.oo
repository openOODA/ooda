// # Product prove std/nerf_3dgs/gaussian_opacity_reset_decay.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/nerf_3dgs/gaussian_opacity_reset_decay.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/gaussian_opacity_reset_decay.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gaussian_opacity_reset_decay: PASSED only if they match.

import "std/nerf_3dgs/gaussian_opacity_reset_decay.oo";

pub fn main() {
    let gaussian_opacity_reset_decay_a = should_reset_opacity(0, 0);
    let gaussian_opacity_reset_decay_b = should_reset_opacity(0, 0);
    if gaussian_opacity_reset_decay_a != gaussian_opacity_reset_decay_b {
        println("FAIL gaussian_opacity_reset_decay");
        process_exit(1);
    }
    println("prod_ap_gaussian_opacity_reset_decay: PASSED");
}
