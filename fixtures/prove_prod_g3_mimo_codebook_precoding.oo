// # Product prove std/telecom_5g/mimo_codebook_precoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_codebook_cophasing_phase_rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_codebook_precoding.oo.
//
// Beats:
//   1. Call nr5g_codebook_cophasing_phase_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimo_codebook_precoding: PASSED only if they match.

import "std/telecom_5g/mimo_codebook_precoding.oo";

pub fn main() {
    let mimo_codebook_precoding_mark: Int = 0;
    if mimo_codebook_precoding_mark != 0 {
        process_exit(1);
    }
    let a: Float = nr5g_codebook_cophasing_phase_rad(0);
    let b: Float = nr5g_codebook_cophasing_phase_rad(0);
    if a != b {
        println("FAIL nr5g_codebook_cophasing_phase_rad");
        process_exit(1);
    }
    println("prod_mimo_codebook_precoding: PASSED");
}
