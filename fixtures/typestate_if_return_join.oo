// # Join after a returning if
//
// Logline: Connect in both arms, return from the true arm, and send after the else join.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Connect and return in the true arm.
//   3. Connect in else, then send after the join.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    if true {
        connect(s);
        return;
    } else {
        connect(s);
    }
    send(s);
}
