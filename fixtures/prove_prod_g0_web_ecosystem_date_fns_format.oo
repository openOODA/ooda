// # Product prove std/web_ecosystem/date_fns_format.oo
//
// Logline: Fail-closed emit+gcc+run asserts datetime_is_leap is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/date_fns_format.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call datetime_is_leap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_date_fns_format: PASSED only if they match.

import "std/web_ecosystem/date_fns_format.oo";

pub fn main() {
    let g0_a = datetime_is_leap(2);
    let g0_b = datetime_is_leap(2);
    if g0_a != g0_b {
        println("FAIL datetime_is_leap");
        process_exit(1);
    }
    println("prod_g0_date_fns_format: PASSED");
}
