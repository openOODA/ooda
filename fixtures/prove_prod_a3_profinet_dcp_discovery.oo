// # Product prove std/iot_scada/profinet_dcp_discovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts profinet_dcp_identify_request is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/profinet_dcp_discovery.oo.
//
// Beats:
//   1. Call profinet_dcp_identify_request twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_profinet_dcp_discovery: PASSED only if they match.

import "std/iot_scada/profinet_dcp_discovery.oo";

pub fn main() {
    let profinet_dcp_discovery_mark: Int = 0;
    if profinet_dcp_discovery_mark != 0 {
        process_exit(1);
    }
    let a: ProfinetDcpHeader = profinet_dcp_identify_request(0);
    let b: ProfinetDcpHeader = profinet_dcp_identify_request(0);
    if (a).service_id != (b).service_id {
        println("FAIL profinet_dcp_identify_request");
        process_exit(1);
    }
    println("prod_profinet_dcp_discovery: PASSED");
}
