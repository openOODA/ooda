// # Product prove std/astrophysics_relativity/gr_gravitational_time_delay_shapiro.oo
//
// Logline: Fail-closed emit+gcc+run asserts shapiro_delay_solar_system is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_gravitational_time_delay_shapiro.oo.
//
// Beats:
//   1. Call shapiro_delay_solar_system twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_gravitational_time_delay_shapiro: PASSED only if they match.

import "std/astrophysics_relativity/gr_gravitational_time_delay_shapiro.oo";

pub fn main() {
    let gr_gravitational_time_delay_shapiro_mark: Int = 0;
    if gr_gravitational_time_delay_shapiro_mark != 0 {
        process_exit(1);
    }
    let a: ShapiroDelayResult = shapiro_delay_solar_system(0, 0, 0, 0);
    let b: ShapiroDelayResult = shapiro_delay_solar_system(0, 0, 0, 0);
    if (a).mass_msun != (b).mass_msun {
        println("FAIL shapiro_delay_solar_system");
        process_exit(1);
    }
    println("prod_gr_gravitational_time_delay_shapiro: PASSED");
}
