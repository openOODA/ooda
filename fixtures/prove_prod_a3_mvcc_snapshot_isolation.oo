// # Product prove std/db_storage/mvcc_snapshot_isolation.oo
//
// Logline: Fail-closed emit+gcc+run asserts snapshot_descriptor_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_snapshot_isolation.oo.
//
// Beats:
//   1. Call snapshot_descriptor_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_snapshot_isolation: PASSED only if they match.

import "std/db_storage/mvcc_snapshot_isolation.oo";

pub fn main() {
    let mvcc_snapshot_isolation_mark: Int = 0;
    if mvcc_snapshot_isolation_mark != 0 {
        process_exit(1);
    }
    let a: TxSnapshotDescriptor = snapshot_descriptor_create(0, 0, 0, list_new());
    let b: TxSnapshotDescriptor = snapshot_descriptor_create(0, 0, 0, list_new());
    if (a).snapshot_tx_id != (b).snapshot_tx_id {
        println("FAIL snapshot_descriptor_create");
        process_exit(1);
    }
    println("prod_mvcc_snapshot_isolation: PASSED");
}
