// # Product prove std/fhe_lattices/fhe_bgv_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts bgv_ciphertext_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bgv_ciphertext.oo.
//
// Beats:
//   1. Call bgv_ciphertext_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_bgv_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_bgv_ciphertext.oo";

pub fn main() {
    let fhe_bgv_ciphertext_mark: Int = 0;
    if fhe_bgv_ciphertext_mark != 0 {
        process_exit(1);
    }
    let a: BgvCiphertext = bgv_ciphertext_new(list_new(), list_new(), 0, 0, 0, 0);
    let b: BgvCiphertext = bgv_ciphertext_new(list_new(), list_new(), 0, 0, 0, 0);
    if (a).degree_n != (b).degree_n {
        println("FAIL bgv_ciphertext_new");
        process_exit(1);
    }
    println("prod_g2_fhe_bgv_ciphertext: PASSED");
}
