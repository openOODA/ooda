// # Product prove std/aero/formation.oo
//
// Logline: Fail-closed emit+gcc+run asserts formation_vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation.oo.
//
// Beats:
//   1. Call formation_vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_formation: PASSED only if they match.

import "std/aero/formation.oo";

pub fn main() {
    let a: FormVec3 = formation_vec3_new(0, 0, 0);
    let b: FormVec3 = formation_vec3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL formation_vec3_new");
        process_exit(1);
    }
    println("prod_formation: PASSED");
}
