// # Product prove std/bio_advanced/protein_surface_electrostatics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/protein_surface_electrostatics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_surface_electrostatics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_surface_electrostatics: PASSED only if they match.

import "std/bio_advanced/protein_surface_electrostatics.oo";

pub fn main() {
    let protein_surface_electrostatics_a = electrostatics_screened_potential(0.0, 0.0, 0.0, 0.0);
    let protein_surface_electrostatics_b = electrostatics_screened_potential(0.0, 0.0, 0.0, 0.0);
    if protein_surface_electrostatics_a != protein_surface_electrostatics_b {
        println("FAIL protein_surface_electrostatics");
        process_exit(1);
    }
    println("prod_ap_protein_surface_electrostatics: PASSED");
}
