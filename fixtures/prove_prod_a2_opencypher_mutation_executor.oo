// # Product prove std/db_graph/opencypher_mutation_executor.oo
//
// Logline: Fail-closed emit+gcc+run asserts mutation_stats_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_mutation_executor.oo.
//
// Beats:
//   1. Call mutation_stats_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_mutation_executor: PASSED only if they match.

import "std/db_graph/opencypher_mutation_executor.oo";

pub fn main() {
    let opencypher_mutation_executor_mark: Int = 0;
    if opencypher_mutation_executor_mark != 0 {
        process_exit(1);
    }
    let a: MutationStats = mutation_stats_empty();
    let b: MutationStats = mutation_stats_empty();
    if (a).nodes_created != (b).nodes_created {
        println("FAIL mutation_stats_empty");
        process_exit(1);
    }
    println("prod_opencypher_mutation_executor: PASSED");
}
