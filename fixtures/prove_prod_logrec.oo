// # Product diag log formatter prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/log_formatter.oo.
//
// Setup: Product std/diag/log_formatter.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. format_text 1000 INFO app hi.
//   2. format_json and logfmt match.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/log_formatter.oo";

pub fn main() {
    let rec: LogRecord = record_new("INFO", "hi", "app", 1000);
    let t: String = format_text(rec);
    if t != "1000 [INFO] app: hi" {
        println("FAIL logrec text");
        process_exit(1);
    }
    let j: String = format_json(rec);
    if j != "{\"ts\":1000,\"level\":\"INFO\",\"target\":\"app\",\"msg\":\"hi\"}" {
        println("FAIL logrec json");
        process_exit(1);
    }
    let lf: String = format_logfmt(rec);
    if lf != "ts=1000 level=INFO target=app msg=\"hi\"" {
        println("FAIL logrec logfmt");
        process_exit(1);
    }
    println("prod_logrec: PASSED");
}
