// # Product prove std/iot_scada/bacnet_object_dictionary.oo
//
// Logline: Fail-closed emit+gcc+run asserts bacnet_object_id_encode is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_object_dictionary.oo.
//
// Beats:
//   1. Call bacnet_object_id_encode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bacnet_object_dictionary: PASSED only if they match.

import "std/iot_scada/bacnet_object_dictionary.oo";

pub fn main() {
    let bacnet_object_dictionary_mark: Int = 0;
    if bacnet_object_dictionary_mark != 0 {
        process_exit(1);
    }
    let a: Int = bacnet_object_id_encode(0, 0);
    let b: Int = bacnet_object_id_encode(0, 0);
    if a != b {
        println("FAIL bacnet_object_id_encode");
        process_exit(1);
    }
    println("prod_bacnet_object_dictionary: PASSED");
}
