// # Product trie_compact prove
import "std/collections/trie_compact.oo";
pub fn main() {
    let mut t: CompactTrie = compact_trie_new();
    t = compact_trie_insert(t, 7);
    let ok: Bool = compact_trie_search(t, 7);
    if ok == false {
        println("FAIL ctrie 7");
        process_exit(1);
    }
    let no: Bool = compact_trie_search(t, 3);
    if no == true {
        println("FAIL ctrie 3");
        process_exit(1);
    }
    println("prod_ctrie: PASSED");
}
