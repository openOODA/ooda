// # Product prove std/quantum_topological/topological_walker_wang_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts 3D Walker-Wang topological models and bulk string tension calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_walker_wang_3d.oo.
//
// Beats:
//   1. Construct Fibonacci, Semion, and Toric Code 3D Walker-Wang models.
//   2. Validate category modularity and boundary/bulk excitation properties.
//   3. Compute bulk string tension for modular (confined) and non-modular (deconfined) categories.
//   4. Print prod_g4_quantum_walker_wang: PASSED and exit 0.

import "std/quantum_topological/topological_walker_wang_3d.oo";

pub fn main() {
    let fib: WalkerWang3DModel = walker_wang_fibonacci_3d();
    let sem: WalkerWang3DModel = walker_wang_semion_3d();
    let tc: WalkerWang3DModel = walker_wang_toric_code_3d();

    if (fib).is_modular_category != 1 || (fib).boundary_has_chiral_anyons != 1 || (fib).bulk_has_point_anyons != 0 {
        println("FAIL walker_wang_fibonacci_3d");
        process_exit(1);
    }

    if (sem).is_modular_category != 1 || (sem).boundary_has_chiral_anyons != 1 {
        println("FAIL walker_wang_semion_3d");
        process_exit(1);
    }

    if (tc).is_modular_category != 0 || (tc).bulk_has_point_anyons != 1 || (tc).boundary_has_chiral_anyons != 0 {
        println("FAIL walker_wang_toric_code_3d");
        process_exit(1);
    }

    let tension_fib1: Float = walker_wang_bulk_string_tension(&fib, 10.0);
    let tension_fib2: Float = walker_wang_bulk_string_tension(&fib, 10.0);
    let tension_tc: Float = walker_wang_bulk_string_tension(&tc, 10.0);

    if tension_fib1 != tension_fib2 || tension_fib1 < 0.49 || tension_fib1 > 0.51 {
        println("FAIL walker_wang_bulk_string_tension fib");
        process_exit(1);
    }
    if tension_tc != 0.0 {
        println("FAIL walker_wang_bulk_string_tension tc");
        process_exit(1);
    }

    println("prod_g4_quantum_walker_wang: PASSED");
    process_exit(0);
}
