// # Product prove std/fintech_l3_book/l3_order_book_memory_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts memory_pool_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_order_book_memory_pool.oo.
//
// Beats:
//   1. Call memory_pool_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_order_book_memory_pool: PASSED only if they match.

import "std/fintech_l3_book/l3_order_book_memory_pool.oo";

pub fn main() {
    let l3_order_book_memory_pool_mark: Int = 0;
    if l3_order_book_memory_pool_mark != 0 {
        process_exit(1);
    }
    let a: MemoryPoolConfig = memory_pool_config_new(0);
    let b: MemoryPoolConfig = memory_pool_config_new(0);
    if (a).total_capacity != (b).total_capacity {
        println("FAIL memory_pool_config_new");
        process_exit(1);
    }
    println("prod_g2_l3_order_book_memory_pool: PASSED");
}
