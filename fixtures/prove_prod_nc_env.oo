// # Product prove std/os/env.oo
//
// Logline: Fail-closed emit+gcc+run asserts env_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/os/env.oo.
//
// Beats:
//   1. Call env_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_env: PASSED only if it matches.

import "std/os/env.oo";

pub fn main() {
    let a: Int = env_probe();
    if a != 0 {
        println("FAIL env_probe");
        process_exit(1);
    }
    println("prod_nc_env: PASSED");
}
