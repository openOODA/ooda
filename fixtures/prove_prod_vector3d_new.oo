// # Product prove std/uav_flight/uav_coordinate_frames.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector3d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_coordinate_frames.oo.
//
// Beats:
//   1. Call vector3d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector3d_new: PASSED only if they match.

import "std/uav_flight/uav_coordinate_frames.oo";

pub fn main() {
    let uav_coordinate_frames_mark: Int = 0;
    if uav_coordinate_frames_mark != 0 { process_exit(1); }
    let a: Vector3D = vector3d_new(1.0, 2.0, 3.0);
    let b: Vector3D = vector3d_new(1.0, 2.0, 3.0);
    let ax: Float = (a).x;
    let bx: Float = (b).x;
    if ax != bx {
        println("FAIL vector3d_new");
        process_exit(1);
    }
    println("prod_vector3d_new: PASSED");
}
