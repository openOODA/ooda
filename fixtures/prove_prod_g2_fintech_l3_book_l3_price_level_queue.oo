// # Product prove std/fintech_l3_book/l3_price_level_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts l3_price_level_is_empty is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_price_level_queue.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call l3_price_level_is_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_l3_price_level_queue: PASSED only if they match.

import "std/fintech_l3_book/l3_price_level_queue.oo";

pub fn main() {
    let g2_oa: L3PriceLevel = L3PriceLevel { price_fixed: 2, total_shares: 2, order_count: 8, head_order_id: 2, tail_order_id: 2 };
    let g2_ob: L3PriceLevel = L3PriceLevel { price_fixed: 2, total_shares: 2, order_count: 8, head_order_id: 2, tail_order_id: 2 };
    let g2_a = l3_price_level_is_empty(&g2_oa);
    let g2_b = l3_price_level_is_empty(&g2_ob);
    if g2_a != g2_b {
        println("FAIL l3_price_level_is_empty");
        process_exit(1);
    }
    println("prod_g2_l3_price_level_queue: PASSED");
}
