// # Product prove std/astrophysics_relativity/stellar_eddington_luminosity.oo
//
// Logline: Fail-closed emit+gcc+run asserts eddington_thomson_opacity is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_eddington_luminosity.oo.
//
// Beats:
//   1. Call eddington_thomson_opacity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_eddington_luminosity: PASSED only if they match.

import "std/astrophysics_relativity/stellar_eddington_luminosity.oo";

pub fn main() {
    let stellar_eddington_luminosity_mark: Int = 0;
    if stellar_eddington_luminosity_mark != 0 {
        process_exit(1);
    }
    let a: Int = eddington_thomson_opacity(0);
    let b: Int = eddington_thomson_opacity(0);
    if a != b {
        println("FAIL eddington_thomson_opacity");
        process_exit(1);
    }
    println("prod_stellar_eddington_luminosity: PASSED");
}
