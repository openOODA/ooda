// # Allow clean struct field in process_exec
//
// Logline: Passing a clean struct field to process_exec stays allowed beside unused secret.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag secret_cmd as secret.
//   2. Build CmdConfig with clean payload.
//   3. Pass cfg.payload to process_exec and succeed.
//
// clean struct field may reach process_exec
type CmdConfig = struct { payload: String };
// SECRET: secret_cmd
pub fn main(p: &ProcessCap) {
    let secret_cmd = "s3cret-payload";
    let cfg = CmdConfig { payload: "true" };
    let r = process_exec(p, cfg.payload);
    println(1);
}
