// # Product prove std/industrial_iot/opcua_binary_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/opcua_binary_header.oo.
//
// Beats:
//   1. Call opcua_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opcua_binary_header: PASSED only if they match.

import "std/industrial_iot/opcua_binary_header.oo";

pub fn main() {
    let opcua_binary_header_mark: Int = 0;
    if opcua_binary_header_mark != 0 {
        process_exit(1);
    }
    let a: OpcUaMessageHeader = opcua_header_new("x", "x", 0, 0);
    let b: OpcUaMessageHeader = opcua_header_new("x", "x", 0, 0);
    if (a).message_size != (b).message_size {
        println("FAIL opcua_header_new");
        process_exit(1);
    }
    println("prod_g2_opcua_binary_header: PASSED");
}
