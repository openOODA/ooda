// # Scoped arena bump under AllocCap
//
// Logline: Create a 4KiB arena, alloc 16, reset, alloc again.
//
// Setup: OPEN-50. oo_arena_* runtime. After compiler rebuild.
//
// Beats:
//   1. arena_create 4096.
//   2. arena_alloc 16 then reset.
//   3. Print PASSED.

pub fn main(alloc: &AllocCap) {
    let a: Result[String, String] = arena_create(alloc, 4096);
    if a.is_err() {
        println("FAIL create");
        process_exit(1);
    }
    let b: Result[String, String] = arena_alloc(alloc, 0, 16);
    if b.is_err() {
        println("FAIL alloc");
        process_exit(1);
    }
    let c: Result[String, String] = arena_reset(alloc, 0);
    if c.is_err() {
        println("FAIL reset");
        process_exit(1);
    }
    println("open_arena: PASSED");
}