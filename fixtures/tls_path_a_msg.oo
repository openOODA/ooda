// # Print a tls_connect residual
//
// Logline: Call tls_connect and print the Ok or Err payload for smoke grep.
//
// Setup: Test fixture. Smoke pairs this with a local TCP peer first.
//
// Beats:
//   1. Call tls_connect to 127.0.0.1:1.
//   2. Match Ok or Err into msg.
//   3. Print msg.
//
// M163: print tls residual / insecure residual payload for smoke grep.
// Smoke pairs this with a local TCP peer so TCP succeeds first.
pub fn main(net: &NetCap) {
    let r: Result[String, String] = tls_connect(net, "127.0.0.1", 1);
    let msg: String = match r {
        Ok(v) => v,
        Err(e) => e
    };
    println(msg);
}
