// # Product prove std/hash/crc32.oo
//
// Logline: Fail-closed emit+gcc+run asserts crc32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/crc32.oo.
//
// Beats:
//   1. Call crc32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crc32: PASSED only if they match.

import "std/hash/crc32.oo";

pub fn main() {
    let a = crc32("x");
    let b = crc32("x");
    if a != b {
        println("FAIL crc32");
        process_exit(1);
    }
    println("prod_crc32: PASSED");
}
