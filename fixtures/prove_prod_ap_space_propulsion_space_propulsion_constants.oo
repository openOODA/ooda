// # Product prove std/space_propulsion/space_propulsion_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/space_propulsion_constants.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/space_propulsion_constants.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_space_propulsion_constants: PASSED only if they match.

import "std/space_propulsion/space_propulsion_constants.oo";

pub fn main() {
    let space_propulsion_constants_a = const_pi();
    let space_propulsion_constants_b = const_pi();
    if space_propulsion_constants_a != space_propulsion_constants_b {
        println("FAIL space_propulsion_constants");
        process_exit(1);
    }
    println("prod_ap_space_propulsion_constants: PASSED");
}
