// M164 path A: process-local channel under ThreadCap (new/send/recv)
pub fn main(thread: &ThreadCap) {
    let c: Result[String, String] = channel_new(thread);
    if c.is_ok() {
        // Int slot 0 after first channel_new → Ok("ch:0")
        let s: Result[String, String] = channel_send(thread, 0, "hi");
        if s.is_ok() {
            let m: Result[String, String] = channel_recv(thread, 0);
            if m.is_ok() {
                let msg: String = m.unwrap();
                println(msg);
            } else {
                println("recv-fail");
            }
        } else {
            println("send-fail");
        }
    } else {
        println("new-fail");
    }
}
