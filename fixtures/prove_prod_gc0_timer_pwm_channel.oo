// # Product prove std/embedded_hal/timer_pwm_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts hardware_timer_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/timer_pwm_channel.oo.
//
// Beats:
//   1. Call hardware_timer_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_timer_pwm_channel: PASSED only if they match.

import "std/embedded_hal/timer_pwm_channel.oo";

pub fn main() {
    let timer_pwm_channel_mark: Int = 0;
    if timer_pwm_channel_mark != 0 {
        process_exit(1);
    }
    let timer_pwm_channel_a = hardware_timer_new(1, 1);
    let timer_pwm_channel_b = hardware_timer_new(1, 1);
    if (timer_pwm_channel_a).timer_id != (timer_pwm_channel_b).timer_id {
        println("FAIL hardware_timer_new");
        process_exit(1);
    }
    println("prod_timer_pwm_channel: PASSED");
}
