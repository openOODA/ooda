// # emit-x86 const INT==INT else print
//
// Logline: Print yes from the else of if 1==0 so emit-x86 can fold a false const-int compare.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. Then lock is x86_int_if.oo.
//
// Beats:
//   1. Declare main.
//   2. if 1==0 print no else print yes.
//   3. Expect yes only.

pub fn main() {
    if 1 == 0 {
        println("no");
    } else {
        println("yes");
    }
}