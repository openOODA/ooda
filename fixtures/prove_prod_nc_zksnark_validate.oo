// # Product prove std/sec/crypto/zksnark_validate.oo
//
// Logline: Fail-closed emit+gcc+run asserts zksnark_validate_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_validate.oo.
//
// Beats:
//   1. Call zksnark_validate_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_zksnark_validate: PASSED only if it matches.

import "std/sec/crypto/zksnark_validate.oo";

pub fn main() {
    let a: Int = zksnark_validate_probe();
    if a != 0 {
        println("FAIL zksnark_validate_probe");
        process_exit(1);
    }
    println("prod_nc_zksnark_validate: PASSED");
}
