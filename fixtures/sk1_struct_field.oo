// # Valid struct field read must stay OK
//
// Logline: Point.x field get must still typecheck.
//
// Setup: Isolated check. Point is a local struct.
//
// Beats:
//   1. Define Point with Int x and y.
//   2. Bind a literal.
//   3. Print p.x.

type Point = struct {
    x: Int,
    y: Int,
};

pub fn main() {
    let p = Point { x: 1, y: 2 };
    println(p.x);
}
