// # Product prove Parsers & Codecs (Zero-Trust)
//
// Logline: Reads ooda/std/parsers/csv_stream.oo, ooda/std/parsers/leb128.oo, and ooda/std/parsers/base58.oo directly and asserts the actual observed behavior of csv_split_line, leb128_encode, and base58 alphabet lookup on representative inputs.
//
// Setup: Imports the three parser modules. Pure value-returning helpers, no IO. Tests use the .oo-native `Q` sentinel that csv_is_quote and the hex-bytes output of leb128_encode to make assertions testable without multi-byte UTF-8 string equality.
//
// Beats:
//   1. TACTICAL: csv_split_line on a simple comma-separated line returns 3 fields; on a quoted field with a comma returns 1 field; on an empty line returns 1 empty field.
//   2. TACTICAL: leb128_encode of 0 is one byte; of 127 is one byte (no continuation); of 128 is two bytes (continuation).
//   3. OPERATIONAL: csv_split_line_safe returns Err on an unterminated quoted field.
//   4. OPERATIONAL: base58 alphabet has 58 characters and no 0OIl characters (the canonical Bitcoin exclusion set).
//   5. STRATEGY: base58_index_of returns -1 for an invalid character and a valid index for a valid character.

import "std/parsers/csv_stream.oo";
import "std/parsers/leb128.oo";
import "std/parsers/base58.oo";

pub fn test_csv_split_simple() {
    // Simple 3-field line. csv uses "Q" as the quote sentinel internally
    // and the source uses no multi-byte chars, so we can split the
    // output on a marker to count fields.
    let f1: List[String] = csv_split_line("a,b,c");
    let n1: Int = list_len(f1);
    if n1 != 3 { println("FAIL: simple 3-field must return 3, got n1"); process_exit(1); }
    let empty: List[String] = csv_split_line("");
    if list_len(empty) != 1 { println("FAIL: empty line must return 1 empty field"); process_exit(1); }
    println("PASS: csv_split_line simple cases (tactical)");
}

pub fn test_csv_split_quoted_with_comma() {
    // Quoted field with a comma: must be one field, not two.
    // The source uses "Q" as the quote char, so "Qa,b,Qc" is one quoted field "a,b".
    let fields: List[String] = csv_split_line("Qa,b,Q,c");
    let n: Int = list_len(fields);
    if n != 2 { println("FAIL: quoted comma must yield 2 fields, got n"); process_exit(1); }
    println("PASS: csv quoted field with comma is one field (tactical)");
}

pub fn test_csv_split_line_safe_unterminated() {
    // An unterminated quoted field must return Err.
    let r: Result[List[String], String] = csv_split_line_safe("Qunterminated");
    if r.is_ok() { println("FAIL: unterminated quote must return Err"); process_exit(1); }
    println("PASS: csv_split_line_safe returns Err on unterminated quote (operational)");
}

pub fn test_leb128_encode_basic() {
    // leb128_encode_u64(0) is one byte (no continuation, value 0).
    let s0: String = leb128_encode_u64(0);
    if str_len(s0) != 2 { println("FAIL: leb128(0) must be 1 byte (2 hex chars), got slen"); process_exit(1); }
    // leb128_encode_u64(127) is one byte (max single-byte value, 0x7F).
    let s127: String = leb128_encode_u64(127);
    if str_len(s127) != 2 { println("FAIL: leb128(127) must be 1 byte"); process_exit(1); }
    // leb128_encode_u64(128) is two bytes (continuation bit set on byte 0).
    let s128: String = leb128_encode_u64(128);
    if str_len(s128) != 4 { println("FAIL: leb128(128) must be 2 bytes"); process_exit(1); }
    // leb128_encode_u64(300) is two bytes: 0xAC 0x02 (172 + 128, then 2).
    let s300: String = leb128_encode_u64(300);
    if str_len(s300) != 4 { println("FAIL: leb128(300) must be 2 bytes"); process_exit(1); }
    println("PASS: leb128_encode basic cases (tactical)");
}

pub fn test_base58_alphabet_size_and_exclusions() {
    // The Bitcoin Base58 alphabet has 58 characters and excludes 0, O, I, l.
    let alpha: String = base58_alphabet();
    if str_len(alpha) != 58 { println("FAIL: base58 alphabet must be 58 chars, got alen"); process_exit(1); }
    // The excluded characters must not be present.
    if str_contains(alpha, "0") { println("FAIL: 0 must not be in base58 alphabet"); process_exit(1); }
    if str_contains(alpha, "O") { println("FAIL: O must not be in base58 alphabet"); process_exit(1); }
    if str_contains(alpha, "I") { println("FAIL: I must not be in base58 alphabet"); process_exit(1); }
    if str_contains(alpha, "l") { println("FAIL: l must not be in base58 alphabet"); process_exit(1); }
    println("PASS: base58 alphabet has 58 chars and excludes 0OIl (operational)");
}

pub fn test_base58_index_of_valid_and_invalid() {
    // The first char of the alphabet is "1", the second is "2", etc.
    let i1: Int = base58_index_of("1");
    if i1 != 0 { println("FAIL: base58_index_of(1) must be 0, got i1"); process_exit(1); }
    let i2: Int = base58_index_of("2");
    if i2 != 1 { println("FAIL: base58_index_of(2) must be 1, got i2"); process_exit(1); }
    // The 58th char (last) is "z".
    let last: String = str_sub(base58_alphabet(), 57, 58);
    let ilast: Int = base58_index_of(last);
    if ilast != 57 { println("FAIL: base58_index_of(last) must be 57, got ilast"); process_exit(1); }
    // The invalid char "0" must return -1.
    let i0: Int = base58_index_of("0");
    if i0 != 0 - 1 { println("FAIL: base58_index_of(0) must be -1, got i0"); process_exit(1); }
    println("PASS: base58_index_of returns correct indices and -1 for invalid (strategy)");
}

pub fn main() {
    test_csv_split_simple();
    test_csv_split_quoted_with_comma();
    test_csv_split_line_safe_unterminated();
    test_leb128_encode_basic();
    test_base58_alphabet_size_and_exclusions();
    test_base58_index_of_valid_and_invalid();
    println("PROVE_PROD_PARSERS_PASSED");
}
