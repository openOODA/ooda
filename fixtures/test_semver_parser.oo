// # SemVer 2.0.0 adversarial suite
//
// Logline: Parses MAJOR.MINOR.PATCH with prerelease and build, checks precedence, and matches ^ ~ >= ranges.
//
// Setup: Pure. Imports semver_parser.oo. Run from ooda/.
//
// Beats:
//   1. Parse a version with prerelease and build.
//   2. Prove prerelease is less than the release.
//   3. Match caret, tilde, and greater-or-equal ranges.
//   4. Reject a numeric leading zero.

import "std/parsers/semver_parser.oo";

pub fn main() {
    let v: SemVer = semver_parser_parse("1.2.3-alpha.1+build.5");
    if v.flag < 1 {
        println("FAIL parse " + v.err);
        process_exit(1);
    }
    if v.major != 1 {
        println("FAIL major");
        process_exit(1);
    }
    if v.minor != 2 {
        println("FAIL minor");
        process_exit(1);
    }
    if v.patch != 3 {
        println("FAIL patch");
        process_exit(1);
    }
    println("parse MAJOR.MINOR.PATCH-PRERELEASE+BUILD");
    let rel: SemVer = semver_parser_parse("1.2.3");
    let c: Result[Int, String] = semver_parser_cmp(v.flag, v.err, v.major, v.minor, v.patch, v.npre, v.pres, rel.flag, rel.err, rel.major, rel.minor, rel.patch, rel.npre, rel.pres);
    match c {
        Ok(x) => {
            if x >= 0 {
                println("FAIL pre < release");
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL cmp " + e);
            process_exit(1);
        }
    }
    println("precedence pre < release");
    let r1: Result[Int, String] = semver_parser_range("1.2.4", "^1.2.3");
    let r2: Result[Int, String] = semver_parser_range("1.2.4", "~1.2.3");
    let r3: Result[Int, String] = semver_parser_range("1.2.3", ">= 1.2.3");
    let r4: Result[Int, String] = semver_parser_range("2.0.0", "^1.2.3");
    match r1 {
        Ok(a) => {
            if a < 1 {
                println("FAIL caret");
                process_exit(1);
            }
        },
        Err(e1) => {
            println("FAIL caret " + e1);
            process_exit(1);
        }
    }
    match r2 {
        Ok(b) => {
            if b < 1 {
                println("FAIL tilde");
                process_exit(1);
            }
        },
        Err(e2) => {
            println("FAIL tilde " + e2);
            process_exit(1);
        }
    }
    match r3 {
        Ok(g) => {
            if g < 1 {
                println("FAIL ge");
                process_exit(1);
            }
        },
        Err(e3) => {
            println("FAIL ge " + e3);
            process_exit(1);
        }
    }
    match r4 {
        Ok(n) => {
            if n > 0 {
                println("FAIL caret 2.0");
                process_exit(1);
            }
        },
        Err(e4) => {
            println("FAIL caret2 " + e4);
            process_exit(1);
        }
    }
    println("^/~/>= range match");
    let z: SemVer = semver_parser_parse("01.0.0");
    if z.flag > 0 {
        println("FAIL leading zero ok");
        process_exit(1);
    }
    let st: Result[Int, String] = semver_parser_stat(z.flag, z.err, 0);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("leading-zero Err");
    println("SUITE PASSED");
    println("test_semver_parser: PASSED");
}
