// # Product prove std/quantum_topological/fqhe_moore_read_pfaffian.oo
//
// Logline: Fail-closed emit+gcc+run asserts moore_read_quasihole_degeneracy is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/fqhe_moore_read_pfaffian.oo.
//
// Beats:
//   1. Call moore_read_quasihole_degeneracy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fqhe_moore_read_pfaffian: PASSED only if they match.

import "std/quantum_topological/fqhe_moore_read_pfaffian.oo";

pub fn main() {
    let fqhe_moore_read_pfaffian_mark: Int = 0;
    if fqhe_moore_read_pfaffian_mark != 0 {
        process_exit(1);
    }
    let a: Int = moore_read_quasihole_degeneracy(0);
    let b: Int = moore_read_quasihole_degeneracy(0);
    if a != b {
        println("FAIL moore_read_quasihole_degeneracy");
        process_exit(1);
    }
    println("prod_fqhe_moore_read_pfaffian: PASSED");
}
