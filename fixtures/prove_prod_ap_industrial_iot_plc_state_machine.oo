// # Product prove std/industrial_iot/plc_state_machine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_iot/plc_state_machine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/plc_state_machine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plc_state_machine: PASSED only if they match.

import "std/industrial_iot/plc_state_machine.oo";

pub fn main() {
    let plc_state_machine_a = plc_state_name_code(0);
    let plc_state_machine_b = plc_state_name_code(0);
    if plc_state_machine_a != plc_state_machine_b {
        println("FAIL plc_state_machine");
        process_exit(1);
    }
    println("prod_ap_plc_state_machine: PASSED");
}
