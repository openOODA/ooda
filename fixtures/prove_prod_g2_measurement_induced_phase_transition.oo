// # Product prove std/quantum_open_systems/measurement_induced_phase_transition.oo
//
// Logline: Fail-closed emit+gcc+run asserts mipt_critical_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/measurement_induced_phase_transition.oo.
//
// Beats:
//   1. Call mipt_critical_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_measurement_induced_phase_transition: PASSED only if they match.

import "std/quantum_open_systems/measurement_induced_phase_transition.oo";

pub fn main() {
    let measurement_induced_phase_transition_mark: Int = 0;
    if measurement_induced_phase_transition_mark != 0 {
        process_exit(1);
    }
    let a: Float = mipt_critical_threshold();
    let b: Float = mipt_critical_threshold();
    if a != b {
        println("FAIL mipt_critical_threshold");
        process_exit(1);
    }
    println("prod_g2_measurement_induced_phase_transition: PASSED");
}
