// # Product prove std/fintech_defi/liquidation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts lending_position_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/liquidation_engine.oo.
//
// Beats:
//   1. Call lending_position_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_liquidation_engine: PASSED only if they match.

import "std/fintech_defi/liquidation_engine.oo";

pub fn main() {
    let a: LendingPosition = lending_position_new("x", 0);
    let b: LendingPosition = lending_position_new("x", 0);
    if a.total_debt_usd != b.total_debt_usd {
        println("FAIL lending_position_new");
        process_exit(1);
    }
    println("prod_liquidation_engine: PASSED");
}
