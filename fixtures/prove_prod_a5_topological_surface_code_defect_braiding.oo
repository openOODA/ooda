// # Product prove std/quantum_topological/topological_surface_code_defect_braiding.oo
//
// Logline: Fail-closed emit+gcc+run asserts defect_hole_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_surface_code_defect_braiding.oo.
//
// Beats:
//   1. Call defect_hole_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_surface_code_defect_braiding: PASSED only if they match.

import "std/quantum_topological/topological_surface_code_defect_braiding.oo";

pub fn main() {
    let topological_surface_code_defect_braiding_mark: Int = 0;
    if topological_surface_code_defect_braiding_mark != 0 {
        process_exit(1);
    }
    let a: DefectHole = defect_hole_new(0, 0, 0, 0, 0);
    let b: DefectHole = defect_hole_new(0, 0, 0, 0, 0);
    if (a).hole_id != (b).hole_id {
        println("FAIL defect_hole_new");
        process_exit(1);
    }
    println("prod_topological_surface_code_defect_braiding: PASSED");
}
