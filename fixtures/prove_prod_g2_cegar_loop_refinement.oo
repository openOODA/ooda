// # Product prove std/formal_verif/cegar_loop_refinement.oo
//
// Logline: Fail-closed emit+gcc+run asserts cegar_is_spurious_counterexample is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/cegar_loop_refinement.oo.
//
// Beats:
//   1. Call cegar_is_spurious_counterexample twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cegar_loop_refinement: PASSED only if they match.

import "std/formal_verif/cegar_loop_refinement.oo";

pub fn main() {
    let cegar_loop_refinement_mark: Int = 0;
    if cegar_loop_refinement_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cegar_is_spurious_counterexample(true);
    let b: Bool = cegar_is_spurious_counterexample(true);
    if a != b {
        println("FAIL cegar_is_spurious_counterexample");
        process_exit(1);
    }
    println("prod_g2_cegar_loop_refinement: PASSED");
}
