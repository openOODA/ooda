// # Product prove std/bft_consensus/bft_consensus_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/bft_consensus_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/bft_consensus_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bft_consensus_stubs: PASSED only if they match.

import "std/bft_consensus/bft_consensus_stubs.oo";

pub fn main() {
    let bft_consensus_stubs_a = bft_consensus_fail_closed("x", 0);
    let bft_consensus_stubs_b = bft_consensus_fail_closed("x", 0);
    if bft_consensus_stubs_a != bft_consensus_stubs_b {
        println("FAIL bft_consensus_stubs");
        process_exit(1);
    }
    println("prod_ap_bft_consensus_stubs: PASSED");
}
