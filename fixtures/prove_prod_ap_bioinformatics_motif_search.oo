// # Product prove std/bioinformatics/motif_search.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/motif_search.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/motif_search.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_motif_search: PASSED only if they match.

import "std/bioinformatics/motif_search.oo";

pub fn main() {
    let motif_search_a = int_pow4(0);
    let motif_search_b = int_pow4(0);
    if motif_search_a != motif_search_b {
        println("FAIL motif_search");
        process_exit(1);
    }
    println("prod_ap_motif_search: PASSED");
}
