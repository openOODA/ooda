// # Product prove std/tda_topology/extended_persistence_homology.oo
//
// Logline: Fail-closed emit+gcc+run asserts extended_diagram_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/extended_persistence_homology.oo.
//
// Beats:
//   1. Call extended_diagram_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_extended_persistence_homology: PASSED only if they match.

import "std/tda_topology/extended_persistence_homology.oo";

pub fn main() {
    let extended_persistence_homology_mark: Int = 0;
    if extended_persistence_homology_mark != 0 {
        process_exit(1);
    }
    let extended_persistence_homology_a = extended_diagram_new(1);
    let extended_persistence_homology_b = extended_diagram_new(1);
    if (extended_persistence_homology_a).pair_count != (extended_persistence_homology_b).pair_count {
        println("FAIL extended_diagram_new");
        process_exit(1);
    }
    println("prod_extended_persistence_homology: PASSED");
}
