// # Product prove std/digital_twin/asset_parameter_online_adaptation.oo
//
// Logline: Fail-closed emit+gcc+run asserts rls_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_parameter_online_adaptation.oo.
//
// Beats:
//   1. Call rls_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_asset_parameter_online_adaptation: PASSED only if they match.

import "std/digital_twin/asset_parameter_online_adaptation.oo";

pub fn main() {
    let asset_parameter_online_adaptation_mark: Int = 0;
    if asset_parameter_online_adaptation_mark != 0 {
        process_exit(1);
    }
    let a: RlsState = rls_state_new(0, 0.0, 0.0);
    let b: RlsState = rls_state_new(0, 0.0, 0.0);
    if (a).num_params != (b).num_params {
        println("FAIL rls_state_new");
        process_exit(1);
    }
    println("prod_g2_asset_parameter_online_adaptation: PASSED");
}
