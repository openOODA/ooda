// # Product prove std/grid/wind_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts wind_farm_lidar_wake_effect_sim is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/wind_stubs.oo.
//
// Beats:
//   1. Call wind_farm_lidar_wake_effect_sim twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wind_stubs: PASSED only if they match.

import "std/grid/wind_stubs.oo";

pub fn main() {
    let wind_stubs_mark: Int = 0;
    if wind_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Float = wind_farm_lidar_wake_effect_sim(0, 0, 0);
    let b: Float = wind_farm_lidar_wake_effect_sim(0, 0, 0);
    if a != b {
        println("FAIL wind_farm_lidar_wake_effect_sim");
        process_exit(1);
    }
    println("prod_g2_wind_stubs: PASSED");
}
