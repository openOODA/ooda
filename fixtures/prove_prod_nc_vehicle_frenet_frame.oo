// # Product prove std/auto_mpc_control/vehicle_frenet_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts vehicle_frenet_frame_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_frenet_frame.oo.
//
// Beats:
//   1. Call vehicle_frenet_frame_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_vehicle_frenet_frame: PASSED only if it matches.

import "std/auto_mpc_control/vehicle_frenet_frame.oo";

pub fn main() {
    let a: Int = vehicle_frenet_frame_probe();
    if a != 0 {
        println("FAIL vehicle_frenet_frame_probe");
        process_exit(1);
    }
    println("prod_nc_vehicle_frenet_frame: PASSED");
}
