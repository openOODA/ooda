// # Product prove std/robotics_auv/added_mass_damping_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/robotics_auv/added_mass_damping_matrix.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/added_mass_damping_matrix.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_added_mass_damping_matrix: PASSED only if they match.

import "std/robotics_auv/added_mass_damping_matrix.oo";

pub fn main() {
    let added_mass_damping_matrix_a = adam_abs(0);
    let added_mass_damping_matrix_b = adam_abs(0);
    if added_mass_damping_matrix_a != added_mass_damping_matrix_b {
        println("FAIL added_mass_damping_matrix");
        process_exit(1);
    }
    println("prod_ap_added_mass_damping_matrix: PASSED");
}
