// # Product prove std/hft_alpha/mm_cancel_to_trade_ratio.oo
//
// Logline: Fail-closed emit+gcc+run asserts message_counter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_cancel_to_trade_ratio.oo.
//
// Beats:
//   1. Call message_counter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_cancel_to_trade_ratio: PASSED only if they match.

import "std/hft_alpha/mm_cancel_to_trade_ratio.oo";

pub fn main() {
    let a: MessageCounter = message_counter_new(0.0);
    let b: MessageCounter = message_counter_new(0.0);
    if a.orders_placed != b.orders_placed {
        println("FAIL message_counter_new");
        process_exit(1);
    }
    println("prod_mm_cancel_to_trade_ratio: PASSED");
}
