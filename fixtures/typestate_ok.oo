// # Walk a socket to Closed
//
// Logline: Open, connect, send, and close a Sock through the legal TYPESTATE order.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Connect to Open and send.
//   3. Close back to Closed.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open
// TYPESTATE fn close_sock: Open -> Closed

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }
fn close_sock(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    connect(s);
    send(s);
    close_sock(s);
}
