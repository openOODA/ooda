// # Product Prove std/security_defense/metamorphic_pipeline.oo
//
// Logline: Deterministic assertion fixture verifying end-to-end metamorphic diversification, instruction mutation, and ROP mitigation.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/metamorphic_pipeline.oo.
//
// Beats:
//   1. Build sample function CFG, instruction stream, and bytecode buffer.
//   2. Execute metamorphic_pipeline_execute with deterministic seed.
//   3. Assert non-zero mutation counts and diversification score.
//   4. Print "prod_g4_sec_metamorphic_pipeline: PASSED".

import "std/security_defense/metamorphic_pipeline.oo";

pub fn main() {
    let mut ctx: MetamorphicContext = metamorphic_context_new(1337);

    // Setup CFG
    let mut cfg: FunctionCfg = function_cfg_new("target_fn", 0);
    let _b0: Bool = function_cfg_add_block(&mut cfg, 0, 4, 1, -1);
    let _b1: Bool = function_cfg_add_block(&mut cfg, 1, 6, 2, -1);
    let _b2: Bool = function_cfg_add_block(&mut cfg, 2, 3, -1, -1);

    // Setup Instruction Stream
    let mut insns: InstructionStream = instruction_stream_new();
    let _i0: Bool = instruction_stream_append(&mut insns, 0, 1, 0, 0); // MOV_IMM 0 (zeroing)
    let _i1: Bool = instruction_stream_append(&mut insns, 3, 1, 1, 10); // ADD_IMM 10

    // Setup Bytecode Buffer containing an unintended 0xC3 (195)
    let mut bytecode: BytecodeBuffer = bytecode_buffer_new();
    bytecode_buffer_append(&mut bytecode, 72);  // 0x48 (REX.W)
    bytecode_buffer_append(&mut bytecode, 137); // 0x89 (MOV)
    bytecode_buffer_append(&mut bytecode, 195); // 0xC3 (RET in intermediate position)
    bytecode_buffer_append(&mut bytecode, 144); // 0x90 (NOP)

    let ok: Bool = metamorphic_pipeline_execute(&mut ctx, &mut cfg, &mut insns, &mut bytecode);

    if !ok {
        println("FAIL: metamorphic_pipeline_execute returned false");
        process_exit(1);
    }

    let score: Int = metamorphic_metrics_get_score(&ctx);
    if score <= 0 {
        println("FAIL: diversification_score <= 0");
        process_exit(1);
    }

    if ((ctx).metrics).blocks_permuted != 3 {
        println("FAIL: blocks_permuted mismatch");
        process_exit(1);
    }

    if ((ctx).metrics).rop_gadgets_neutralized != 1 {
        println("FAIL: rop_gadgets_neutralized mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_metamorphic_pipeline: PASSED");
    process_exit(0);
}
