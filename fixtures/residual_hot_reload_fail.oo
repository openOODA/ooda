// # Call residual hot_reload
//
// Logline: A bare call to hot_reload is the residual fail rail for that surface.
//
// Beats:
//   1. Invoke the residual name from main.
//   2. Bind the result so the call is live.
//   3. Expect check or emit to refuse the residual.

pub fn main() { let r = hot_reload("x.oo"); }
