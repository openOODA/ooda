// # Product prove std/zk_rollup/sparse_merkle_tree_256.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/sparse_merkle_tree_256.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_256.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sparse_merkle_tree_256: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_256.oo";

pub fn main() {
    let sparse_merkle_tree_256_a = smt256_hash_pair("x", "x");
    let sparse_merkle_tree_256_b = smt256_hash_pair("x", "x");
    if sparse_merkle_tree_256_a.contains(sparse_merkle_tree_256_b) == false {
        println("FAIL sparse_merkle_tree_256");
        process_exit(1);
    }
    if sparse_merkle_tree_256_b.contains(sparse_merkle_tree_256_a) == false {
        println("FAIL sparse_merkle_tree_256");
        process_exit(1);
    }
    println("prod_ap_sparse_merkle_tree_256: PASSED");
}
