// # Product prove std/crypto/sha256_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/sha256_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/sha256_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sha256_types: PASSED only if they match.

import "std/crypto/sha256_types.oo";

pub fn main() {
    let sha256_types_a = sha256_state_new(0, 0);
    let sha256_types_b = sha256_state_new(0, 0);
    let sha256_types_va = sha256_state_h0(sha256_types_a);
    let sha256_types_vb = sha256_state_h0(sha256_types_b);
    if sha256_types_va != sha256_types_vb {
        println("FAIL sha256_types");
        process_exit(1);
    }
    println("prod_ap_sha256_types: PASSED");
}
