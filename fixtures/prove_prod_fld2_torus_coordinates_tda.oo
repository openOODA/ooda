// # Product prove std/tda_topology/torus_coordinates_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts torus_angular_diff is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/torus_coordinates_tda.oo.
//
// Beats:
//   1. Call torus_angular_diff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_torus_coordinates_tda: PASSED only if they match.

import "std/tda_topology/torus_coordinates_tda.oo";

pub fn main() {
    let torus_coordinates_tda_mark: Int = 0;
    if torus_coordinates_tda_mark != 0 {
        process_exit(1);
    }
    let torus_coordinates_tda_a: Float = torus_angular_diff(1.0, 1.0);
    let torus_coordinates_tda_b: Float = torus_angular_diff(1.0, 1.0);
    if torus_coordinates_tda_a != torus_coordinates_tda_b {
        println("FAIL torus_angular_diff");
        process_exit(1);
    }
    println("prod_torus_coordinates_tda: PASSED");
}
