// # Product prove std/simd/simd_gather_scatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_indices4_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_gather_scatter.oo.
//
// Beats:
//   1. Call simd_indices4_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_gather_scatter: PASSED only if they match.

import "std/simd/simd_gather_scatter.oo";

pub fn main() {
    let obj = simd_indices4_new(0, 0, 0, 0);
    let a = obj.i0;
    let b = obj.i0;
    if a != b {
        println("FAIL simd_indices4_new");
        process_exit(1);
    }
    println("prod_simd_gather_scatter: PASSED");
}
