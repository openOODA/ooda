//
// Setup: Isolated emit-c. Imports std/db_graph/graph_bfs_dfs_traversal.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_bfs_dfs_traversal: PASSED only if they match.

import "std/db_graph/graph_bfs_dfs_traversal.oo";

pub fn main() {
    let graph_bfs_dfs_traversal_a = traversal_history_new();
    let graph_bfs_dfs_traversal_b = traversal_history_new();
    if graph_bfs_dfs_traversal_a.total_visited != graph_bfs_dfs_traversal_b.total_visited {
        println("FAIL graph_bfs_dfs_traversal");
        process_exit(1);
