// # Product prove std/quantum/gate_phase.oo
//
// Logline: Fail-closed emit+gcc+run asserts gate_s_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_phase.oo.
//
// Beats:
//   1. Call gate_s_matrix twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_phase: PASSED only if they match.

import "std/quantum/gate_phase.oo";

pub fn main() {
    let gate_phase_mark: Int = 0;
    if gate_phase_mark != 0 {
        process_exit(1);
    }
    let a: Matrix2x2 = gate_s_matrix();
    let b: Matrix2x2 = gate_s_matrix();
    if (a).m00 != (b).m00 {
        println("FAIL gate_s_matrix");
        process_exit(1);
    }
    println("prod_gate_phase: PASSED");
}
