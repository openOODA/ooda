// # SQLite page header adversarial suite
//
// Logline: Decodes B-tree page types 2, 5, 10, and 13, maps content offset 0 to 65536, and rejects short or unknown pages.
//
// Setup: Pure. Imports sqlite_page_header.oo. Run from ooda/.
//
// Beats:
//   1. Decode each allowed page type.
//   2. Read freeblock, cell count, content offset, and fragments.
//   3. Treat content offset 0 as 65536.
//   4. Reject type 0 and a 7-byte buffer.

import "std/database/sqlite_page_header.oo";

fn hdr(pt: Int, fb: Int, cells: Int, off: Int, fr: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    o = list_push(o, pt);
    o = list_push(o, (fb >> 8) & 255);
    o = list_push(o, fb & 255);
    o = list_push(o, (cells >> 8) & 255);
    o = list_push(o, cells & 255);
    o = list_push(o, (off >> 8) & 255);
    o = list_push(o, off & 255);
    o = list_push(o, fr & 255);
    return o;
}

fn must_type(pt: Int, msg: String) {
    let h: SqliteHdr = sqlite_page_header_parse(hdr(pt, 16, 3, 100, 2));
    let f: Int = h.flag;
    if f < 1 {
        println("FAIL " + msg);
        process_exit(1);
    }
    if h.ptype != pt {
        println("FAIL ptype");
        process_exit(1);
    }
    if h.freeblock != 16 {
        println("FAIL freeblock");
        process_exit(1);
    }
    if h.cells != 3 {
        println("FAIL cells");
        process_exit(1);
    }
    if h.content != 100 {
        println("FAIL content");
        process_exit(1);
    }
    if h.frag != 2 {
        println("FAIL frag");
        process_exit(1);
    }
}

pub fn main() {
    must_type(2, "type2");
    must_type(5, "type5");
    must_type(10, "type10");
    must_type(13, "type13");
    println("types 2/5/10/13 decode");
    println("freeblock, cell count, content offset, fragments");
    let z: SqliteHdr = sqlite_page_header_parse(hdr(13, 0, 1, 0, 0));
    if z.flag < 1 {
        println("FAIL zero off");
        process_exit(1);
    }
    if z.content != 65536 {
        println("FAIL 65536");
        process_exit(1);
    }
    println("content offset 0 yields 65536");
    let bad: SqliteHdr = sqlite_page_header_parse(hdr(0, 0, 0, 0, 0));
    if bad.flag > 0 {
        println("FAIL type 0");
        process_exit(1);
    }
    let mut sh: List[Int] = list_new();
    sh = list_push(sh, 13);
    let s: SqliteHdr = sqlite_page_header_parse(sh);
    if s.flag > 0 {
        println("FAIL short");
        process_exit(1);
    }
    let st: Result[Int, String] = sqlite_page_header_stat(s);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("other type / short buffer Err");
    println("SUITE PASSED");
    println("test_sqlite_page_header: PASSED");
}
