// # Product prove std/zk_rollup/pasta_curves_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts pasta_cycle_params_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/pasta_curves_cycle.oo.
//
// Beats:
//   1. Call pasta_cycle_params_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pasta_curves_cycle: PASSED only if they match.

import "std/zk_rollup/pasta_curves_cycle.oo";

pub fn main() {
    let pasta_curves_cycle_mark: Int = 0;
    if pasta_curves_cycle_mark != 0 {
        process_exit(1);
    }
    let a: PastaCycleParams = pasta_cycle_params_init();
    let b: PastaCycleParams = pasta_cycle_params_init();
    if (a).pallas_base_field_p != (b).pallas_base_field_p {
        println("FAIL pasta_cycle_params_init");
        process_exit(1);
    }
    println("prod_pasta_curves_cycle: PASSED");
}
