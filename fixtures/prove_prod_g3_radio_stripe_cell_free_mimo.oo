// # Product prove std/telecom_6g/radio_stripe_cell_free_mimo.oo
//
// Logline: Fail-closed emit+gcc+run asserts stripe_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/radio_stripe_cell_free_mimo.oo.
//
// Beats:
//   1. Call stripe_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_radio_stripe_cell_free_mimo: PASSED only if they match.

import "std/telecom_6g/radio_stripe_cell_free_mimo.oo";

pub fn main() {
    let radio_stripe_cell_free_mimo_mark: Int = 0;
    if radio_stripe_cell_free_mimo_mark != 0 {
        process_exit(1);
    }
    let a: Float = stripe_int_to_float(0);
    let b: Float = stripe_int_to_float(0);
    if a != b {
        println("FAIL stripe_int_to_float");
        process_exit(1);
    }
    println("prod_radio_stripe_cell_free_mimo: PASSED");
}
