// # Product prove std/db_storage/lsm_bloom_filter_block.oo
//
// Logline: Fail-closed emit+gcc+run asserts bloom_hash_seed is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/lsm_bloom_filter_block.oo.
//
// Beats:
//   1. Call bloom_hash_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsm_bloom_filter_block: PASSED only if they match.

import "std/db_storage/lsm_bloom_filter_block.oo";

pub fn main() {
    let lsm_bloom_filter_block_mark: Int = 0;
    if lsm_bloom_filter_block_mark != 0 {
        process_exit(1);
    }
    let a: Int = bloom_hash_seed("x", 0);
    let b: Int = bloom_hash_seed("x", 0);
    if a != b {
        println("FAIL bloom_hash_seed");
        process_exit(1);
    }
    println("prod_lsm_bloom_filter_block: PASSED");
}
