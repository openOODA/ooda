// # Product prove std/graph_topology/shortest_path_bellman_ford.oo
//
// Logline: Fail-closed emit+gcc+run asserts shortest_path_bellman_ford_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/shortest_path_bellman_ford.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call shortest_path_bellman_ford_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_shortest_path_bellman_ford: PASSED only if they match.

import "std/graph_topology/shortest_path_bellman_ford.oo";

pub fn main() {
    let g2_a = shortest_path_bellman_ford_probe();
    let g2_b = shortest_path_bellman_ford_probe();
    if g2_a != g2_b {
        println("FAIL shortest_path_bellman_ford_probe");
        process_exit(1);
    }
    println("prod_g2_shortest_path_bellman_ford: PASSED");
}
