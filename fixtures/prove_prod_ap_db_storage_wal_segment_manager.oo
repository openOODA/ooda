// # Product prove std/db_storage/wal_segment_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/wal_segment_manager.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_segment_manager.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wal_segment_manager: PASSED only if they match.

import "std/db_storage/wal_segment_manager.oo";

pub fn main() {
    let wal_segment_manager_a = wal_segment_manager_new(0);
    let wal_segment_manager_b = wal_segment_manager_new(0);
    let wal_segment_manager_va = wal_should_rotate(wal_segment_manager_a, 0);
    let wal_segment_manager_vb = wal_should_rotate(wal_segment_manager_b, 0);
    if wal_segment_manager_va != wal_segment_manager_vb {
        println("FAIL wal_segment_manager");
        process_exit(1);
    }
    println("prod_ap_wal_segment_manager: PASSED");
}
