// # Unwrap an Err Result
//
// Logline: Result.unwrap on Err exits with the unwrap error rail.
//
// Beats:
//   1. Build Err("boom") in make_err.
//   2. Unwrap without a match.
//   3. Fail at runtime with ERR unwrap.

// Fail-at-runtime: unwrap on Err exits with ERR unwrap
pub fn make_err() -> Result[String, String] {
    return Err("boom");
}

pub fn main() {
    let r: Result[String, String] = make_err();
    let s: String = r.unwrap();
    println(s);
}
