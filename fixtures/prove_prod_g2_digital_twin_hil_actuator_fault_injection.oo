// # Product prove std/digital_twin/hil_actuator_fault_injection.oo
//
// Logline: Fail-closed emit+gcc+run asserts fault_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/digital_twin/hil_actuator_fault_injection.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fault_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hil_actuator_fault_injection: PASSED only if they match.

import "std/digital_twin/hil_actuator_fault_injection.oo";

pub fn main() {
    let g2_oa: FaultConfig = fault_config_new(2, 1.0, 1.0, 1.0, 1.0);
    let g2_ob: FaultConfig = fault_config_new(2, 1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).fault_type;
    let g2_b = (g2_ob).fault_type;
    if g2_a != g2_b {
        println("FAIL fault_config_new.fault_type");
        process_exit(1);
    }
    println("prod_g2_hil_actuator_fault_injection: PASSED");
}
