// # Product prove std/nerf_3dgs/tensoorf_tensor_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts tensorf_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/tensoorf_tensor_decomposition.oo.
//
// Beats:
//   1. Call tensorf_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensoorf_tensor_decomposition: PASSED only if they match.

import "std/nerf_3dgs/tensoorf_tensor_decomposition.oo";

pub fn main() {
    let a: TensoRFConfig = tensorf_config_default();
    let b: TensoRFConfig = tensorf_config_default();
    if a.grid_dim_x != b.grid_dim_x {
        println("FAIL tensorf_config_default");
        process_exit(1);
    }
    println("prod_tensoorf_tensor_decomposition: PASSED");
}
