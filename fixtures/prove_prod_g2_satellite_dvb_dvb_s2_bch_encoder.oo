// # Product prove std/satellite_dvb/dvb_s2_bch_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_bch_step_lfsr is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2_bch_encoder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dvb_bch_step_lfsr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dvb_s2_bch_encoder: PASSED only if they match.

import "std/satellite_dvb/dvb_s2_bch_encoder.oo";

pub fn main() {
    let g2_a = dvb_bch_step_lfsr(2, 2, 2);
    let g2_b = dvb_bch_step_lfsr(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL dvb_bch_step_lfsr");
        process_exit(1);
    }
    println("prod_g2_dvb_s2_bch_encoder: PASSED");
}
