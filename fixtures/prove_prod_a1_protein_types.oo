// # Product prove std/bio/protein_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts protein_point3d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_types.oo.
//
// Beats:
//   1. Call protein_point3d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_types: PASSED only if they match.

import "std/bio/protein_types.oo";

pub fn main() {
    let protein_types_mark: Int = 0;
    if protein_types_mark != 0 {
        process_exit(1);
    }
    let a: Point3D = protein_point3d_new(0, 0, 0);
    let b: Point3D = protein_point3d_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL protein_point3d_new");
        process_exit(1);
    }
    println("prod_protein_types: PASSED");
}
