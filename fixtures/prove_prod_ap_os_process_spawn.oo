// # Product prove std/os/process_spawn.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/process_spawn.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/process_spawn.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_process_spawn: PASSED only if they match.

import "std/os/process_spawn.oo";

pub fn main() {
    let process_spawn_a = process_spawn_config_new("x");
    let process_spawn_b = process_spawn_config_new("x");
    let process_spawn_va = process_spawn_to_cmd(process_spawn_a);
    let process_spawn_vb = process_spawn_to_cmd(process_spawn_b);
    if process_spawn_va.contains(process_spawn_vb) == false {
        println("FAIL process_spawn");
        process_exit(1);
    }
    if process_spawn_vb.contains(process_spawn_va) == false {
        println("FAIL process_spawn");
        process_exit(1);
    }
    println("prod_ap_process_spawn: PASSED");
}
