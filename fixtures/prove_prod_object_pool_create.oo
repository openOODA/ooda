// # Product prove std/perf/small_object_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts object_pool_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/small_object_pool.oo.
//
// Beats:
//   1. Call object_pool_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_object_pool_create: PASSED only if they match.

import "std/perf/small_object_pool.oo";

pub fn main() {
    let small_object_pool_mark: Int = 0;
    if small_object_pool_mark != 0 { process_exit(1); }
    let a: ObjectPool = object_pool_create("p1", 16, 8);
    let b: ObjectPool = object_pool_create("p1", 16, 8);
    let ac: Int = (a).capacity;
    let bc: Int = (b).capacity;
    if ac != bc {
        println("FAIL object_pool_create");
        process_exit(1);
    }
    println("prod_object_pool_create: PASSED");
}
