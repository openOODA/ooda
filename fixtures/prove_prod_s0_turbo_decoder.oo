// # Product prove std/telecom/turbo_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbo_abs value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom/turbo_decoder.oo.
//
// Beats:
//   1. Call turbo_abs twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_turbo_decoder: PASSED only if asserts hold.

import "std/telecom/turbo_decoder.oo";

pub fn main() {
    let turbo_decoder_a: Float = turbo_abs(0.0);
    let turbo_decoder_b: Float = turbo_abs(0.0);
    if turbo_decoder_a != turbo_decoder_b {
        println("FAIL turbo_abs");
        process_exit(1);
    }
    println("prod_turbo_decoder: PASSED");
}
