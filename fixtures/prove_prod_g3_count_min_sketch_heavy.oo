// # Product prove std/graph_networks/count_min_sketch_heavy.oo
//
// Logline: Fail-closed emit+gcc+run asserts cms_hash is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/count_min_sketch_heavy.oo.
//
// Beats:
//   1. Call cms_hash twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_count_min_sketch_heavy: PASSED only if they match.

import "std/graph_networks/count_min_sketch_heavy.oo";

pub fn main() {
    let count_min_sketch_heavy_mark: Int = 0;
    if count_min_sketch_heavy_mark != 0 {
        process_exit(1);
    }
    let a: Int = cms_hash(0, 0, 0, 0);
    let b: Int = cms_hash(0, 0, 0, 0);
    if a != b {
        println("FAIL cms_hash");
        process_exit(1);
    }
    println("prod_count_min_sketch_heavy: PASSED");
}
