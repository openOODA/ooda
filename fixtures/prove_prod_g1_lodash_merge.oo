// # Product prove std/web_ecosystem/lodash_merge.oo
//
// Logline: Fail-closed emit+gcc+run asserts lodash_get_kv is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_merge.oo.
//
// Beats:
//   1. Call lodash_get_kv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lodash_merge: PASSED only if they match.

import "std/web_ecosystem/lodash_merge.oo";

pub fn main() {
    let obj_a: KvMap = kv_map_new(0, 0, 0, 0);
    let obj_b: KvMap = kv_map_new(0, 0, 0, 0);
    let a: Int = lodash_get_kv(obj_a, 0, 0);
    let b: Int = lodash_get_kv(obj_b, 0, 0);
    if a != b {
        println("FAIL lodash_get_kv");
        process_exit(1);
    }
    println("prod_lodash_merge: PASSED");
}
