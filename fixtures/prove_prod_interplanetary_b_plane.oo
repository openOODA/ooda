// # Product prove std/astro_advanced/interplanetary_b_plane.oo
//
// Logline: Fail-closed emit+gcc+run asserts bplane_b_mag is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/interplanetary_b_plane.oo.
//
// Beats:
//   1. Call bplane_b_mag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_interplanetary_b_plane: PASSED only if they match.

import "std/astro_advanced/interplanetary_b_plane.oo";

pub fn main() {
    let a = bplane_b_mag();
    let b = bplane_b_mag();
    if a != b {
        println("FAIL bplane_b_mag");
        process_exit(1);
    }
    println("prod_interplanetary_b_plane: PASSED");
}
