import "std/quantum_tensor_nets/cft_scaling_dimensions_mera.oo";

pub fn main() {
    let a: ScalingOperatorDimension = scaling_operator_from_eigenvalue("x", 0.0, 0.0);
    let b: ScalingOperatorDimension = scaling_operator_from_eigenvalue("x", 0.0, 0.0);
    if a.eigenvalue_magnitude != b.eigenvalue_magnitude {
        println("FAIL scaling_operator_from_eigenvalue");
        process_exit(1);
    }
    println("prod_cft_scaling_dimensions_mera: PASSED");
}
