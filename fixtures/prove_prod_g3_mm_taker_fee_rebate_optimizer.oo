// # Product prove std/hft_alpha/mm_taker_fee_rebate_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts venue_fee_profile_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_taker_fee_rebate_optimizer.oo.
//
// Beats:
//   1. Call venue_fee_profile_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_taker_fee_rebate_optimizer: PASSED only if they match.

import "std/hft_alpha/mm_taker_fee_rebate_optimizer.oo";

pub fn main() {
    let mm_taker_fee_rebate_optimizer_mark: Int = 0;
    if mm_taker_fee_rebate_optimizer_mark != 0 {
        process_exit(1);
    }
    let a: VenueFeeProfile = venue_fee_profile_new("x", 0.0, 0.0, true, 0.0);
    let b: VenueFeeProfile = venue_fee_profile_new("x", 0.0, 0.0, true, 0.0);
    if (a).is_inverted_fee_model != (b).is_inverted_fee_model {
        println("FAIL venue_fee_profile_new");
        process_exit(1);
    }
    println("prod_mm_taker_fee_rebate_optimizer: PASSED");
}
