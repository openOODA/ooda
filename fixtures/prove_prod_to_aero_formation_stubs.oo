// # Product prove std/aero/formation_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts formation_module_ready holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_stubs.oo.
//
// Beats:
//   1. Call formation_module_ready using the formation_stubs ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_formation_stubs: PASSED only if asserts hold.

import "std/aero/formation_stubs.oo";

pub fn main() {
    let formation_stubs_a = formation_module_ready();
    if !formation_stubs_a {
        println("FAIL formation_module_ready");
        process_exit(1);
    }
    println("prod_formation_stubs: PASSED");
}
