// # Product prove std/industrial_iot/sensor_telemetry_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts sensor_telemetry_checksum is a real value.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/sensor_telemetry_frame.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call sensor_telemetry_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_sensor_telemetry_frame: PASSED only if they match.

import "std/industrial_iot/sensor_telemetry_frame.oo";

pub fn main() {
    let g0_a = sensor_telemetry_checksum(0, 0, 0, 0);
    let g0_b = sensor_telemetry_checksum(0, 0, 0, 0);
    if g0_a != g0_b {
        println("FAIL sensor_telemetry_checksum");
        process_exit(1);
    }
    println("prod_gr_sensor_telemetry_frame: PASSED");
}
