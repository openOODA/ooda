// # Product prove std/digital_twin/digital_twin_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/digital_twin/digital_twin_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/digital_twin_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_digital_twin_stubs: PASSED only if they match.

import "std/digital_twin/digital_twin_stubs.oo";

pub fn main() {
    let digital_twin_stubs_a = digital_twin_stub_dac_dma_latch(0, 0);
    let digital_twin_stubs_b = digital_twin_stub_dac_dma_latch(0, 0);
    if digital_twin_stubs_a != digital_twin_stubs_b {
        println("FAIL digital_twin_stubs");
        process_exit(1);
    }
    println("prod_ap_digital_twin_stubs: PASSED");
}
