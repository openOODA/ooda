// # Product prove std/robotics_auv/active_disturbance_rejection_auv.oo
//
// Logline: Fail-closed emit+gcc+run asserts adrc_config_default_surge holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/active_disturbance_rejection_auv.oo.
//
// Beats:
//   1. Call adrc_config_default_surge using the active_disturbance_rejection_auv ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_active_disturbance_rejection_auv: PASSED only if asserts hold.

import "std/robotics_auv/active_disturbance_rejection_auv.oo";

pub fn main() {
    let obj = adrc_config_default_surge();
    let active_disturbance_rejection_auv_a = obj.omega_o_observer_bw;
    if active_disturbance_rejection_auv_a != 20.0 {
        println("FAIL adrc_config_default_surge");
        process_exit(1);
    }
    println("prod_active_disturbance_rejection_auv: PASSED");
}
