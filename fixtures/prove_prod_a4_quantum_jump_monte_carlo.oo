// # Product prove std/quantum_open_systems/quantum_jump_monte_carlo.oo
//
// Logline: Fail-closed emit+gcc+run asserts mcwf_c_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_jump_monte_carlo.oo.
//
// Beats:
//   1. Call mcwf_c_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_jump_monte_carlo: PASSED only if they match.

import "std/quantum_open_systems/quantum_jump_monte_carlo.oo";

pub fn main() {
    let quantum_jump_monte_carlo_mark: Int = 0;
    if quantum_jump_monte_carlo_mark != 0 {
        process_exit(1);
    }
    let a: Complex = mcwf_c_new(0.0, 0.0);
    let b: Complex = mcwf_c_new(0.0, 0.0);
    if (a).real != (b).real {
        println("FAIL mcwf_c_new");
        process_exit(1);
    }
    println("prod_quantum_jump_monte_carlo: PASSED");
}
