// # SMT const requires hold
//
// Logline: Constant requires/ensures/spec 1 == 1 is sat at check; runtime if+exit still emits for non-const.
//
// Setup: OPEN-81. Check names the rail smt.
//
// Beats:
//   1. requires 1 == 1 is sat.
//   2. ensures 2 == 2 is sat.
//   3. spec 1 != 0 is sat; non-const x > 0 stays runtime.

pub fn held(x: Int) -> Int
    requires 1 == 1
    ensures 2 == 2
    spec 1 != 0
    requires x > 0
{
    return x;
}

pub fn main() {
    println(held(3));
}
