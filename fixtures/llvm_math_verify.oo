// # LLVM Math Verify Fixture
//
// Logline: Exercises pure math functions, integer algorithms, float operations, and verify blocks on the LLVM backend.
//
// Setup: Pure math helper functions with verify blocks and main execution assertions.
//
// Beats:
//   1. Test integer factorial, gcd, fibonacci, and prime checking.
//   2. Test float polynomial evaluation and hypotenuse square.
//   3. Verify pure functions with verify blocks and test direct assertions in main.

pub fn math_factorial(n: Int) -> Int {
    let mut res = 1;
    let mut i = 1;
    while i <= n {
        res = res * i;
        i = i + 1;
    }
    return res;
}

verify math_factorial {
    assert_eq!(math_factorial(0), 1);
    assert_eq!(math_factorial(1), 1);
    assert_eq!(math_factorial(5), 120);
}

pub fn math_gcd(a: Int, b: Int) -> Int {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let rem = x % y;
        x = y;
        y = rem;
    }
    return x;
}

verify math_gcd {
    assert_eq!(math_gcd(12, 8), 4);
    assert_eq!(math_gcd(54, 24), 6);
    assert_eq!(math_gcd(17, 13), 1);
}

pub fn math_fib(n: Int) -> Int {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    let mut a = 0;
    let mut b = 1;
    let mut i = 2;
    while i <= n {
        let c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

verify math_fib {
    assert_eq!(math_fib(0), 0);
    assert_eq!(math_fib(1), 1);
    assert_eq!(math_fib(6), 8);
    assert_eq!(math_fib(7), 13);
}

pub fn math_is_prime(n: Int) -> Bool {
    if n <= 1 { return false; }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

verify math_is_prime {
    assert_eq!(math_is_prime(2), true);
    assert_eq!(math_is_prime(3), true);
    assert_eq!(math_is_prime(4), false);
    assert_eq!(math_is_prime(17), true);
    assert_eq!(math_is_prime(18), false);
}

pub fn math_poly(x: Float, a: Float, b: Float, c: Float) -> Float {
    let ax2 = a * x * x;
    let bx = b * x;
    return ax2 + bx + c;
}

verify math_poly {
    assert_eq!(math_poly(2.0, 3.0, 4.0, 5.0), 25.0);
    assert_eq!(math_poly(0.0, 1.0, 2.0, 3.0), 3.0);
}

pub fn math_hypot_sq(x: Float, y: Float) -> Float {
    return x * x + y * y;
}

verify math_hypot_sq {
    assert_eq!(math_hypot_sq(3.0, 4.0), 25.0);
    assert_eq!(math_hypot_sq(5.0, 12.0), 169.0);
}

pub fn main() {
    let f5 = math_factorial(5);
    assert_eq!(f5, 120);
    println(f5);

    let g = math_gcd(54, 24);
    assert_eq!(g, 6);
    println(g);

    let fib7 = math_fib(7);
    assert_eq!(fib7, 13);
    println(fib7);

    let p17 = math_is_prime(17);
    assert_eq!(p17, true);
    println(p17);

    let p18 = math_is_prime(18);
    assert_eq!(p18, false);
    println(p18);

    let poly = math_poly(2.0, 3.0, 4.0, 5.0);
    assert_eq!(poly, 25.0);
    println(poly);

    let h = math_hypot_sq(3.0, 4.0);
    assert_eq!(h, 25.0);
    println(h);

    println("LLVM_MATH_VERIFY_OK");
}
