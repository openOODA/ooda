// # Product prove std/security_defense/opaque_predicate_builder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/opaque_predicate_builder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/opaque_predicate_builder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_opaque_predicate_builder: PASSED only if they match.

import "std/security_defense/opaque_predicate_builder.oo";

pub fn main() {
    let opaque_predicate_builder_a = opaque_predicate_eval_even(0);
    let opaque_predicate_builder_b = opaque_predicate_eval_even(0);
    if opaque_predicate_builder_a != opaque_predicate_builder_b {
        println("FAIL opaque_predicate_builder");
        process_exit(1);
    }
    println("prod_ap_opaque_predicate_builder: PASSED");
}
