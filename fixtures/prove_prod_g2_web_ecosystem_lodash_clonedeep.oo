// # Product prove std/web_ecosystem/lodash_clonedeep.oo
//
// Logline: Fail-closed emit+gcc+run asserts clone_int is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_clonedeep.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call clone_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lodash_clonedeep: PASSED only if they match.

import "std/web_ecosystem/lodash_clonedeep.oo";

pub fn main() {
    let g2_a = clone_int(2);
    let g2_b = clone_int(2);
    if g2_a != g2_b {
        println("FAIL clone_int");
        process_exit(1);
    }
    println("prod_g2_lodash_clonedeep: PASSED");
}
