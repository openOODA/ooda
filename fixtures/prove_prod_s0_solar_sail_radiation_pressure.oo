// # Product prove std/space_propulsion/solar_sail_radiation_pressure.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_sail_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_sail_radiation_pressure.oo.
//
// Beats:
//   1. Call solar_sail_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_solar_sail_radiation_pressure: PASSED only if asserts hold.

import "std/space_propulsion/solar_sail_radiation_pressure.oo";

pub fn main() {
    let solar_sail_radiation_pressure_a: SolarSailSpec = solar_sail_spec_default();
    let solar_sail_radiation_pressure_b: SolarSailSpec = solar_sail_spec_default();
    if solar_sail_radiation_pressure_a.sail_area_m2 != solar_sail_radiation_pressure_b.sail_area_m2 {
        println("FAIL solar_sail_spec_default");
        process_exit(1);
    }
    println("prod_solar_sail_radiation_pressure: PASSED");
}
