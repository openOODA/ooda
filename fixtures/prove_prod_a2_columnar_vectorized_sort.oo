// # Product prove std/db_columnar/columnar_vectorized_sort.oo
//
// Logline: Fail-closed emit+gcc+run asserts permutation_vector_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_sort.oo.
//
// Beats:
//   1. Call permutation_vector_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_vectorized_sort: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_sort.oo";

pub fn main() {
    let columnar_vectorized_sort_mark: Int = 0;
    if columnar_vectorized_sort_mark != 0 {
        process_exit(1);
    }
    let a: PermutationVector = permutation_vector_identity(0);
    let b: PermutationVector = permutation_vector_identity(0);
    if (a).length != (b).length {
        println("FAIL permutation_vector_identity");
        process_exit(1);
    }
    println("prod_columnar_vectorized_sort: PASSED");
}
