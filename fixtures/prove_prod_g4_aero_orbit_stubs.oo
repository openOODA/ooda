// # Product prove std/aero/orbit_stubs.oo
//
// Logline: Fail-closed verification that orbit stubs module imports and associated orbital calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_stubs.oo.
//
// Beats:
//   1. Verify orbital module marker and state coordinate constructors.
//   2. Calculate orbital inclination plane change delta-V.
//   3. Assert deterministic outputs.
//   4. Print prod_g4_aero_orbit_stubs: PASSED and exit 0.

import "std/aero/orbit_stubs.oo";

pub fn main() {
    let m: Int = orbit_engine_marker();
    if m != 1 {
        println("FAIL orbit_engine_marker");
        process_exit(1);
    }

    let dv_a: Float = calculate_inclination_change_dv(7500.0, 0.05);
    let dv_b: Float = calculate_inclination_change_dv(7500.0, 0.05);
    if dv_a != dv_b {
        println("FAIL calculate_inclination_change_dv");
        process_exit(1);
    }

    let pos: Vec3 = vec3_zero();
    let vel: Vec3 = vec3_zero();
    let st: EciState = eci_state_new(pos, vel, 0.0);
    let ep: Float = st.epoch_sec;
    if ep != 0.0 {
        println("FAIL eci_state_new");
        process_exit(1);
    }

    println("prod_g4_aero_orbit_stubs: PASSED");
    process_exit(0);
}
