// # Product prove std/ai_ml/tensor_autograd.oo
//
// Logline: Fail-closed emit+gcc+run asserts op_add is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_autograd.oo.
//
// Beats:
//   1. Call op_add twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tensor_autograd: PASSED only if they match.

import "std/ai_ml/tensor_autograd.oo";

pub fn main() {
    let a = op_add();
    let b = op_add();
    if a != b {
        println("FAIL op_add");
        process_exit(1);
    }
    println("prod_tensor_autograd: PASSED");
}
