// # Product prove std/gis_topo/point_cloud_voxel_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts voxel_accum_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/point_cloud_voxel_grid.oo.
//
// Beats:
//   1. Call voxel_accum_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_point_cloud_voxel_grid: PASSED only if they match.

import "std/gis_topo/point_cloud_voxel_grid.oo";

pub fn main() {
    let point_cloud_voxel_grid_mark: Int = 0;
    if point_cloud_voxel_grid_mark != 0 {
        process_exit(1);
    }
    let point_cloud_voxel_grid_a = voxel_accum_new(1, 1, 1);
    let point_cloud_voxel_grid_b = voxel_accum_new(1, 1, 1);
    if (point_cloud_voxel_grid_a).vx != (point_cloud_voxel_grid_b).vx {
        println("FAIL voxel_accum_new");
        process_exit(1);
    }
    println("prod_point_cloud_voxel_grid: PASSED");
}
