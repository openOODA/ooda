// # Product prove std/quantum_open_systems/quantum_otto_heat_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/quantum_otto_heat_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_otto_heat_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_otto_heat_engine: PASSED only if they match.

import "std/quantum_open_systems/quantum_otto_heat_engine.oo";

pub fn main() {
    let quantum_otto_heat_engine_a = quantum_otto_config_new(0.0, 0.0, 0.0, 0.0);
    let quantum_otto_heat_engine_b = quantum_otto_config_new(0.0, 0.0, 0.0, 0.0);
    let quantum_otto_heat_engine_va = quantum_otto_efficiency_ideal(quantum_otto_heat_engine_a);
    let quantum_otto_heat_engine_vb = quantum_otto_efficiency_ideal(quantum_otto_heat_engine_b);
    if quantum_otto_heat_engine_va != quantum_otto_heat_engine_vb {
        println("FAIL quantum_otto_heat_engine");
        process_exit(1);
    }
    println("prod_ap_quantum_otto_heat_engine: PASSED");
}
