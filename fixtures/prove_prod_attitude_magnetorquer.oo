// # Product prove std/astro_advanced/attitude_magnetorquer.oo
//
// Logline: Fail-closed emit+gcc+run asserts mag_dipole is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_magnetorquer.oo.
//
// Beats:
//   1. Call mag_dipole twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_magnetorquer: PASSED only if they match.

import "std/astro_advanced/attitude_magnetorquer.oo";

pub fn main() {
    let a = mag_dipole(0);
    let b = mag_dipole(0);
    if a != b {
        println("FAIL mag_dipole");
        process_exit(1);
    }
    println("prod_attitude_magnetorquer: PASSED");
}
