// # Product prove std/quantum_topological/anyon_majorana_zero_modes.oo
//
// Logline: Fail-closed emit+gcc+run asserts majorana_wire_energy_split is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_majorana_zero_modes.oo.
//
// Beats:
//   1. Call majorana_wire_energy_split twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_anyon_majorana_zero_modes: PASSED only if they match.

import "std/quantum_topological/anyon_majorana_zero_modes.oo";

pub fn main() {
    let anyon_majorana_zero_modes_mark: Int = 0;
    if anyon_majorana_zero_modes_mark != 0 {
        process_exit(1);
    }
    let a: Float = majorana_wire_energy_split(0.0, 0.0);
    let b: Float = majorana_wire_energy_split(0.0, 0.0);
    if a != b {
        println("FAIL majorana_wire_energy_split");
        process_exit(1);
    }
    println("prod_g2_anyon_majorana_zero_modes: PASSED");
}
