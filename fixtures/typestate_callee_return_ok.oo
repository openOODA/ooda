// # Callee return after open
//
// Logline: wrap opens the sock, returns, and main sends on the Open handle.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap calls actually then returns.
//   3. main sends on the now-Open sock.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn actually: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

fn wrap(s: Int) {
    actually(s);
    return;
}

pub fn main() {
    let s = open_sock();
    wrap(s);
    send(s);
}
