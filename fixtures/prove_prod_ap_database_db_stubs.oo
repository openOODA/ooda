// # Product prove std/database/db_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/database/db_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/database/db_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_db_stubs: PASSED only if they match.

import "std/database/db_stubs.oo";

pub fn main() {
    let db_stubs_a = db_hardware_direct_io_init(0);
    let db_stubs_b = db_hardware_direct_io_init(0);
    if db_stubs_a.device_fd != db_stubs_b.device_fd {
        println("FAIL db_stubs");
        process_exit(1);
    }
    println("prod_ap_db_stubs: PASSED");
}
