// # Product prove std/telecom_5g/mimo_svd_beamforming.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimo_svd_decomp_2x2_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mimo_svd_beamforming.oo.
//
// Beats:
//   1. Call mimo_svd_decomp_2x2_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimo_svd_beamforming: PASSED only if they match.

import "std/telecom_5g/mimo_svd_beamforming.oo";

pub fn main() {
    let a: MimoSvdDecomp2x2 = mimo_svd_decomp_2x2_new(0.0, 0.0);
    let b: MimoSvdDecomp2x2 = mimo_svd_decomp_2x2_new(0.0, 0.0);
    if a.effective_rank != b.effective_rank {
        println("FAIL mimo_svd_decomp_2x2_new");
        process_exit(1);
    }
    println("prod_mimo_svd_beamforming: PASSED");
}
