// # Product prove std/tda_topology/sliced_wasserstein_kernel.oo
//
// Logline: Fail-closed emit+gcc+run asserts sliced_wasserstein_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sliced_wasserstein_kernel.oo.
//
// Beats:
//   1. Call sliced_wasserstein_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sliced_wasserstein_kernel: PASSED only if they match.

import "std/tda_topology/sliced_wasserstein_kernel.oo";

pub fn main() {
    let sliced_wasserstein_kernel_mark: Int = 0;
    if sliced_wasserstein_kernel_mark != 0 {
        process_exit(1);
    }
    let sliced_wasserstein_kernel_a = sliced_wasserstein_new(1);
    let sliced_wasserstein_kernel_b = sliced_wasserstein_new(1);
    if (sliced_wasserstein_kernel_a).num_directions != (sliced_wasserstein_kernel_b).num_directions {
        println("FAIL sliced_wasserstein_new");
        process_exit(1);
    }
    println("prod_sliced_wasserstein_kernel: PASSED");
}
