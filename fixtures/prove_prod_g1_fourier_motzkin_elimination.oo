// # Product prove std/compilers_polyhedral/fourier_motzkin_elimination.oo
//
// Logline: Fail-closed emit+gcc+run asserts fm_inequality_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/fourier_motzkin_elimination.oo.
//
// Beats:
//   1. Call fm_inequality_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fourier_motzkin_elimination: PASSED only if they match.

import "std/compilers_polyhedral/fourier_motzkin_elimination.oo";

pub fn main() {
    let a: FmInequality = fm_inequality_new(list_new(), 0);
    let b: FmInequality = fm_inequality_new(list_new(), 0);
    if a.constant_val != b.constant_val {
        println("FAIL fm_inequality_new");
        process_exit(1);
    }
    println("prod_fourier_motzkin_elimination: PASSED");
}
