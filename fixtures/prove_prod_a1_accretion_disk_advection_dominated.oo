// # Product prove std/astrophysics_relativity/accretion_disk_advection_dominated.oo
//
// Logline: Fail-closed emit+gcc+run asserts adaf_self_similar_evaluate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/accretion_disk_advection_dominated.oo.
//
// Beats:
//   1. Call adaf_self_similar_evaluate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_accretion_disk_advection_dominated: PASSED only if they match.

import "std/astrophysics_relativity/accretion_disk_advection_dominated.oo";

pub fn main() {
    let accretion_disk_advection_dominated_mark: Int = 0;
    if accretion_disk_advection_dominated_mark != 0 {
        process_exit(1);
    }
    let a: AdafFlowPoint = adaf_self_similar_evaluate(0, 0, 0, 0, 0);
    let b: AdafFlowPoint = adaf_self_similar_evaluate(0, 0, 0, 0, 0);
    if (a).radius_rg != (b).radius_rg {
        println("FAIL adaf_self_similar_evaluate");
        process_exit(1);
    }
    println("prod_accretion_disk_advection_dominated: PASSED");
}
