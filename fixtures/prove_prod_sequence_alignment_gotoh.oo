// # Product prove std/bio_advanced/sequence_alignment_gotoh.oo
//
// Logline: Fail-closed emit+gcc+run asserts gotoh_calc_gap_cost real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_alignment_gotoh.oo.
//
// Beats:
//   1. Call gotoh_calc_gap_cost with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_sequence_alignment_gotoh: PASSED only if the assert holds.

import "std/bio_advanced/sequence_alignment_gotoh.oo";

pub fn main() {
    let sequence_alignment_gotoh_mark: Int = 0;
    if sequence_alignment_gotoh_mark != 0 {
        process_exit(1);
    }
    let sequence_alignment_gotoh_params: GotohParams = GotohParams { match_score: 0, mismatch_penalty: 0, gap_open: 0, gap_extend: 0 };
    let sequence_alignment_gotoh_n: Int = gotoh_calc_gap_cost(0, &sequence_alignment_gotoh_params);
    if sequence_alignment_gotoh_n != 0 {
        println("FAIL gotoh_calc_gap_cost");
        process_exit(1);
    }
    println("prod_sequence_alignment_gotoh: PASSED");
}
