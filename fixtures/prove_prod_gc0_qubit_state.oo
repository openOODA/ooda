// # Product prove std/quantum/qubit_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts complex_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/qubit_state.oo.
//
// Beats:
//   1. Call complex_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qubit_state: PASSED only if they match.

import "std/quantum/qubit_state.oo";

pub fn main() {
    let qubit_state_mark: Int = 0;
    if qubit_state_mark != 0 {
        process_exit(1);
    }
    let qubit_state_a = complex_zero();
    let qubit_state_b = complex_zero();
    if (qubit_state_a).real != (qubit_state_b).real {
        println("FAIL complex_zero");
        process_exit(1);
    }
    println("prod_qubit_state: PASSED");
}
