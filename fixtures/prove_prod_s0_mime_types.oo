// # Product prove std/web_ecosystem/mime_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts mime_lookup_extension value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/mime_types.oo.
//
// Beats:
//   1. Call mime_lookup_extension twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_mime_types: PASSED only if asserts hold.

import "std/web_ecosystem/mime_types.oo";

pub fn main() {
    let mime_types_a: String = mime_lookup_extension("x");
    let mime_types_b: String = mime_lookup_extension("x");
    if chars_len(mime_types_a) != chars_len(mime_types_b) {
        println("FAIL mime_lookup_extension");
        process_exit(1);
    }
    println("prod_mime_types: PASSED");
}
