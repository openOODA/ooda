
import "pm/manifest_parse.oo";
import "pm/archive_unpack.oo";

pub fn is_valid_pkg_name(name: String) -> Bool {
    if name == "" || name == "." || name == ".." { return false; }
    if name.contains("/") || name.contains("\\") { return false; }
    if name.contains("..") { return false; }
    return true;
}

pub fn pm_validate_capability_escalation(requested_caps: Int, granted_caps: Int) -> Bool {
    let mut req: Int = requested_caps;
    let mut granted: Int = granted_caps;
    let mut bit: Int = 0;
    while bit < 8 {
        let r_bit: Int = req % 2;
        let g_bit: Int = granted % 2;
        if r_bit == 1 && g_bit == 0 {
            return false;
        }
        req = req / 2;
        granted = granted / 2;
        bit = bit + 1;
    }
    return true;
}

pub fn main() {
    let v1: PmSemVer = pm_semver_new(1, 2, 3);
    let v2: PmSemVer = pm_semver_new(1, 3, 0);

    let cmp1: Int = pm_semver_compare(v1, v2);
    if cmp1 != -1 {
        println("FAIL: SemVer compare 1.2.3 < 1.3.0 expected -1");
        process_exit(1);
    }

    let cmp2: Int = pm_semver_compare(v2, v1);
    if cmp2 != 1 {
        println("FAIL: SemVer compare 1.3.0 > 1.2.3 expected 1");
        process_exit(1);
    }

    let dep_caret: PmDependency = pm_dependency_new("lib_a", "org.openooda", "^", 1, 2, 0, false, 3);
    let sat_caret: Bool = pm_semver_satisfies(v1, dep_caret);
    if !sat_caret {
        println("FAIL: 1.2.3 should satisfy ^1.2.0");
        process_exit(1);
    }

    let dep_gte: PmDependency = pm_dependency_new("lib_a", "org.openooda", ">=", 1, 0, 0, false, 3);
    let sat_gte: Bool = pm_semver_satisfies(v1, dep_gte);
    if !sat_gte {
        println("FAIL: 1.2.3 should satisfy >=1.0.0");
        process_exit(1);
    }

    let cap_none: Int = 0;
    let cap_net: Int = 2;
    let cap_root: Int = 3;
    let cap_sys: Int = 4;

    let ok_grant: Bool = pm_validate_capability_escalation(cap_net, cap_root);
    if !ok_grant {
        println("FAIL: root should be permitted to delegate net cap");
        process_exit(1);
    }

    let bad_grant: Bool = pm_validate_capability_escalation(cap_sys, cap_net);
    if bad_grant {
        println("FAIL: net cap must not be permitted to escalate to sys cap");
        process_exit(1);
    }

    let pkg_content: String = "package payload { fn run() { println(42); } }";
    let chk: String = pm_archive_checksum(pkg_content);
    if !pm_archive_verify_checksum(pkg_content, chk) {
        println("FAIL: CAS checksum verification failed");
        process_exit(1);
    }

    if is_valid_pkg_name("valid_pkg-name") == false {
        println("FAIL: valid package name rejected");
        process_exit(1);
    }
    if is_valid_pkg_name("../evil_traversal") == true {
        println("FAIL: path traversal name was not rejected");
        process_exit(1);
    }
    if pm_archive_validate_path("safe/dest/path") == false {
        println("FAIL: safe relative destination path rejected");
        process_exit(1);
    }
    if pm_archive_validate_path("/etc/passwd") == true {
        println("FAIL: absolute path was not rejected");
        process_exit(1);
    }
    if pm_archive_validate_path("modules/../../root") == true {
        println("FAIL: path traversal relative escape was not rejected");
        process_exit(1);
    }

    println("OK: PM_RESOLVE_LOCK_VERIFY_SUCCESS");
}
