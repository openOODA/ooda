// # Product prove std/gis_topo/h3_grid_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts H3 grid distance and local planar coordinate transformations are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/h3_grid_distance.oo.
//
// Beats:
//   1. Construct H3 planar coordinates and compute axial Manhattan distance.
//   2. Create H3 cell index structures and calculate discrete cell grid step distance.
//   3. Assert deterministic distance and ground distance calculations.
//   4. Print prod_g4_gis_h3_distance: PASSED and exit 0.

import "std/gis_topo/h3_grid_distance.oo";

pub fn main() {
    let c1: H3CoordIJ = h3_coord_ij_new(10, 20);
    let c2: H3CoordIJ = h3_coord_ij_new(15, 25);

    let d_ij1: Int = h3_distance_ij(&c1, &c2);
    let d_ij2: Int = h3_distance_ij(&c1, &c2);
    if d_ij1 != d_ij2 || d_ij1 != 5 {
        println("FAIL h3_distance_ij");
        process_exit(1);
    }

    let origin: H3Index = h3_index_new(0, 100, 8, 10, false);
    let dest: H3Index = h3_index_new(0, 106, 8, 10, false);

    let steps1: Int = h3_grid_distance(&origin, &dest);
    let steps2: Int = h3_grid_distance(&origin, &dest);
    if steps1 != steps2 || steps1 <= 0 {
        println("FAIL h3_grid_distance");
        process_exit(1);
    }

    let m1: Float = h3_approx_ground_distance_m(&origin, &dest);
    let m2: Float = h3_approx_ground_distance_m(&origin, &dest);
    if m1 != m2 || m1 <= 0.0 {
        println("FAIL h3_approx_ground_distance_m");
        process_exit(1);
    }

    println("prod_g4_gis_h3_distance: PASSED");
    process_exit(0);
}
