// # Product prove std/wasm_gc/wasm_gc_type_checker.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_gc_type_checker_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_type_checker.oo.
//
// Beats:
//   1. Call wasm_gc_type_checker_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_wasm_gc_type_checker: PASSED only if it matches.

import "std/wasm_gc/wasm_gc_type_checker.oo";

pub fn main() {
    let a: Int = wasm_gc_type_checker_probe();
    if a != 0 {
        println("FAIL wasm_gc_type_checker_probe");
        process_exit(1);
    }
    println("prod_nc_wasm_gc_type_checker: PASSED");
}
