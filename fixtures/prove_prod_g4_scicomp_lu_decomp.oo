// # Product prove std/scicomp/lu_decomp.oo
//
// Logline: Fail-closed verification that LU decomposition, determinant computation, and linear system solve are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/lu_decomp.oo.
//
// Beats:
//   1. Call lu_decomp_probe and construct a 2x2 dense matrix.
//   2. Compute LU decomposition and evaluate matrix determinant.
//   3. Solve linear system Ax = b via forward/backward substitution and assert solution.
//   4. Print prod_g4_scicomp_lu_decomp: PASSED and exit 0.

import "std/scicomp/lu_decomp.oo";

pub fn main() {
    let p: Int = lu_decomp_probe();
    if p != 0 {
        println("FAIL lu_decomp_probe");
        process_exit(1);
    }

    let mut mat: DenseMatrix = dense_mat_new(2, 2);
    dense_mat_set(mat, 0, 0, 2.0);
    dense_mat_set(mat, 0, 1, 1.0);
    dense_mat_set(mat, 1, 0, 1.0);
    dense_mat_set(mat, 1, 1, 2.0);

    let factor1: LuFactor = lu_decompose(&mat);
    let factor2: LuFactor = lu_decompose(&mat);

    if (factor1).is_singular != false || (factor1).dim != 2 {
        println("FAIL lu_decompose properties");
        process_exit(1);
    }

    let det1: Float = lu_determinant(&factor1);
    let det2: Float = lu_determinant(&factor2);
    if det1 != det2 || det1 < 2.999 || det1 > 3.001 {
        println("FAIL lu_determinant");
        process_exit(1);
    }

    let mut b: List[Float] = list_new();
    b = list_push(b, 5.0);
    b = list_push(b, 4.0);

    let x1: List[Float] = lu_solve(&factor1, &b);
    let x2: List[Float] = lu_solve(&factor2, &b);

    let x0: Float = list_get(x1, 0);
    let x_1: Float = list_get(x1, 1);

    if x0 != list_get(x2, 0) || x0 < 1.999 || x0 > 2.001 {
        println("FAIL lu_solve x0");
        process_exit(1);
    }
    if x_1 < 0.999 || x_1 > 1.001 {
        println("FAIL lu_solve x1");
        process_exit(1);
    }

    println("prod_g4_scicomp_lu_decomp: PASSED");
    process_exit(0);
}
