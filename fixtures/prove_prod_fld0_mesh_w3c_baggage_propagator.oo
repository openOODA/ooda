// # Product prove std/mesh_ebpf/mesh_w3c_baggage_propagator.oo
//
// Logline: Fail-closed emit+gcc+run asserts w3c_get_baggage is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_w3c_baggage_propagator.oo.
//
// Beats:
//   1. Call w3c_get_baggage twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mesh_w3c_baggage_propagator: PASSED only if they match.

import "std/mesh_ebpf/mesh_w3c_baggage_propagator.oo";
import "std/str.oo";

pub fn main() {
    let mesh_w3c_baggage_propagator_mark: Int = 0;
    if mesh_w3c_baggage_propagator_mark != 0 {
        process_exit(1);
    }
    let mesh_w3c_baggage_propagator_obj: W3CTraceContext = w3c_trace_context_new("x", "x");
    let mesh_w3c_baggage_propagator_a: String = w3c_get_baggage(&mesh_w3c_baggage_propagator_obj, "x");
    let mesh_w3c_baggage_propagator_b: String = w3c_get_baggage(&mesh_w3c_baggage_propagator_obj, "x");
    if str_eq(mesh_w3c_baggage_propagator_a, mesh_w3c_baggage_propagator_b) == false {
        println("FAIL w3c_get_baggage");
        process_exit(1);
    }
    println("prod_mesh_w3c_baggage_propagator: PASSED");
}
