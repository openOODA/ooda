// # Product prove std/mesh_ebpf/ebpf_packet_checksum.oo
//
// Logline: Fail-closed emit+gcc+run asserts checksum_calc_ipv4_header is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_packet_checksum.oo.
//
// Beats:
//   1. Call checksum_calc_ipv4_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_packet_checksum: PASSED only if they match.

import "std/mesh_ebpf/ebpf_packet_checksum.oo";

pub fn main() {
    let ebpf_packet_checksum_mark: Int = 0;
    if ebpf_packet_checksum_mark != 0 {
        process_exit(1);
    }
    let ebpf_packet_checksum_a: Int = checksum_calc_ipv4_header(1, 1, 1, 1, 1, 1, 1, 1, 1);
    let ebpf_packet_checksum_b: Int = checksum_calc_ipv4_header(1, 1, 1, 1, 1, 1, 1, 1, 1);
    if ebpf_packet_checksum_a != ebpf_packet_checksum_b {
        println("FAIL checksum_calc_ipv4_header");
        process_exit(1);
    }
    println("prod_ebpf_packet_checksum: PASSED");
}
