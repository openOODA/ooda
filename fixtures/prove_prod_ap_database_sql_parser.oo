// # Product prove std/database/sql_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/database/sql_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sql_parser: PASSED only if they match.

import "std/database/sql_parser.oo";

pub fn main() {
    let sql_parser_a = sql_parse_query("x");
    let sql_parser_b = sql_parse_query("x");
    if sql_parser_a.is_ok() != sql_parser_b.is_ok() {
        println("FAIL sql_parser");
        process_exit(1);
    }
    println("prod_ap_sql_parser: PASSED");
}
