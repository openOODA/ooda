// # Product prove std/quantum_tensor_nets/variational_mps_compression.oo
//
// Logline: Fail-closed emit+gcc+run asserts compression_frobenius_distance is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/variational_mps_compression.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compression_frobenius_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_variational_mps_compression: PASSED only if they match.

import "std/quantum_tensor_nets/variational_mps_compression.oo";

pub fn main() {
    let g2_a = compression_frobenius_distance(1.0);
    let g2_b = compression_frobenius_distance(1.0);
    if g2_a != g2_b {
        println("FAIL compression_frobenius_distance");
        process_exit(1);
    }
    println("prod_g2_variational_mps_compression: PASSED");
}
