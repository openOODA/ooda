// # Product prove std/genomics_advanced/hic_ab_compartment_eigen.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_ab_compartment_eigen_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_ab_compartment_eigen.oo.
//
// Beats:
//   1. Call hic_ab_compartment_eigen_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hic_ab_compartment_eigen: PASSED only if it matches.

import "std/genomics_advanced/hic_ab_compartment_eigen.oo";

pub fn main() {
    let a: Int = hic_ab_compartment_eigen_probe();
    if a != 0 {
        println("FAIL hic_ab_compartment_eigen_probe");
        process_exit(1);
    }
    println("prod_nc_hic_ab_compartment_eigen: PASSED");
}
