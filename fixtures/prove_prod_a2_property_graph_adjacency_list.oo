// # Product prove std/db_graph/property_graph_adjacency_list.oo
//
// Logline: Fail-closed emit+gcc+run asserts csr_graph_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_adjacency_list.oo.
//
// Beats:
//   1. Call csr_graph_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_adjacency_list: PASSED only if they match.

import "std/db_graph/property_graph_adjacency_list.oo";

pub fn main() {
    let property_graph_adjacency_list_mark: Int = 0;
    if property_graph_adjacency_list_mark != 0 {
        process_exit(1);
    }
    let a: CSRGraphLayout = csr_graph_new(0);
    let b: CSRGraphLayout = csr_graph_new(0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL csr_graph_new");
        process_exit(1);
    }
    println("prod_property_graph_adjacency_list: PASSED");
}
