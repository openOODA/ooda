// # Product prove std/quantum_tensor_nets/dmrg_infinite_idmrg.oo
//
// Logline: Fail-closed emit+gcc+run asserts idmrg_step_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/dmrg_infinite_idmrg.oo.
//
// Beats:
//   1. Call idmrg_step_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dmrg_infinite_idmrg: PASSED only if they match.

import "std/quantum_tensor_nets/dmrg_infinite_idmrg.oo";

pub fn main() {
    let dmrg_infinite_idmrg_mark: Int = 0;
    if dmrg_infinite_idmrg_mark != 0 {
        process_exit(1);
    }
    let dmrg_infinite_idmrg_a = idmrg_step_result_new(1, 1.0, 1.0, 1, 1.0);
    let dmrg_infinite_idmrg_b = idmrg_step_result_new(1, 1.0, 1.0, 1, 1.0);
    if (dmrg_infinite_idmrg_a).step_number != (dmrg_infinite_idmrg_b).step_number {
        println("FAIL idmrg_step_result_new");
        process_exit(1);
    }
    println("prod_dmrg_infinite_idmrg: PASSED");
}
