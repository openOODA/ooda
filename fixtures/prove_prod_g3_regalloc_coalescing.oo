// # Product prove std/compilers_vm/regalloc_coalescing.oo
//
// Logline: Fail-closed emit+gcc+run asserts briggs_criterion is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_coalescing.oo.
//
// Beats:
//   1. Call briggs_criterion twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_regalloc_coalescing: PASSED only if they match.

import "std/compilers_vm/regalloc_coalescing.oo";

pub fn main() {
    let regalloc_coalescing_mark: Int = 0;
    if regalloc_coalescing_mark != 0 {
        process_exit(1);
    }
    let a: Bool = briggs_criterion(0, 0);
    let b: Bool = briggs_criterion(0, 0);
    if a != b {
        println("FAIL briggs_criterion");
        process_exit(1);
    }
    println("prod_regalloc_coalescing: PASSED");
}
