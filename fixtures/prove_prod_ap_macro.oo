// # Product prove std/macro.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/macro.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/macro.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_macro: PASSED only if they match.

import "std/macro.oo";

pub fn main() {
    let macro_a = macro_env_new();
    let macro_b = macro_env_new();
    if macro_a.gensym_counter != macro_b.gensym_counter {
        println("FAIL macro");
        process_exit(1);
    }
    println("prod_ap_macro: PASSED");
}
