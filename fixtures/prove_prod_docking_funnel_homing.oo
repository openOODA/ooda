// # Product prove std/robotics_auv/docking_funnel_homing.oo
//
// Logline: Fail-closed emit+gcc+run asserts docking_cone_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/docking_funnel_homing.oo.
//
// Beats:
//   1. Call docking_cone_config_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_docking_funnel_homing: PASSED only if they match.

import "std/robotics_auv/docking_funnel_homing.oo";

pub fn main() {
    let docking_funnel_homing_mark: Int = 0;
    if docking_funnel_homing_mark != 0 {
        process_exit(1);
    }
    let a: DockingConeConfig = docking_cone_config_default();
    let b: DockingConeConfig = docking_cone_config_default();
    if (a).cone_length_m != (b).cone_length_m {
        println("FAIL docking_cone_config_default");
        process_exit(1);
    }
    println("prod_docking_funnel_homing: PASSED");
}
