// # Product prove std/fhe_lattices/fhe_ckks_bootstrap.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_bootstrap_coeff_to_slot_cost is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ckks_bootstrap.oo.
//
// Beats:
//   1. Call ckks_bootstrap_coeff_to_slot_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_ckks_bootstrap: PASSED only if they match.

import "std/fhe_lattices/fhe_ckks_bootstrap.oo";

pub fn main() {
    let fhe_ckks_bootstrap_mark: Int = 0;
    if fhe_ckks_bootstrap_mark != 0 {
        process_exit(1);
    }
    let a: Int = ckks_bootstrap_coeff_to_slot_cost(0);
    let b: Int = ckks_bootstrap_coeff_to_slot_cost(0);
    if a != b {
        println("FAIL ckks_bootstrap_coeff_to_slot_cost");
        process_exit(1);
    }
    println("prod_g2_fhe_ckks_bootstrap: PASSED");
}
