// # Product prove std/database/sql_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_plan_node_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_planner.oo.
//
// Beats:
//   1. Call sql_plan_node_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_planner: PASSED only if they match.

import "std/database/sql_planner.oo";

pub fn main() {
    let sql_planner_mark: Int = 0;
    if sql_planner_mark != 0 {
        process_exit(1);
    }
    let a: PlanNode = sql_plan_node_create(0, "x");
    let b: PlanNode = sql_plan_node_create(0, "x");
    if (a).kind != (b).kind {
        println("FAIL sql_plan_node_create");
        process_exit(1);
    }
    println("prod_sql_planner: PASSED");
}
