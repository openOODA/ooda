// # Product prove std/media_dsp/png_filter_paeth.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_filter_type_none is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/png_filter_paeth.oo.
//
// Beats:
//   1. Call png_filter_type_none twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_png_filter_paeth: PASSED only if they match.

import "std/media_dsp/png_filter_paeth.oo";

pub fn main() {
    let png_filter_paeth_mark: Int = 0;
    if png_filter_paeth_mark != 0 {
        process_exit(1);
    }
    let a: Int = png_filter_type_none();
    let b: Int = png_filter_type_none();
    if a != b {
        println("FAIL png_filter_type_none");
        process_exit(1);
    }
    println("prod_png_filter_paeth: PASSED");
}
