// # Product prove std/sec/crypto/kms_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/kms_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kms_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_kms_stubs: PASSED and exit 0 only on match.

import "std/sec/crypto/kms_stubs.oo";

pub fn main() {
    let kms_stubs_ready_a: Bool = kms_module_ready();
    let kms_stubs_ready_b: Bool = kms_module_ready();
    if kms_stubs_ready_a != kms_stubs_ready_b {
        println("FAIL kms_stubs ready");
        process_exit(1);
    }

    let pol_a: KmsKeyPolicy = kms_key_policy_create("POL_001", "ENCRYPT,DECRYPT", 1000, false, true, 90, true);
    let pol_b: KmsKeyPolicy = kms_key_policy_create("POL_001", "ENCRYPT,DECRYPT", 1000, false, true, 90, true);
    if (pol_a).is_active != (pol_b).is_active {
        println("FAIL kms_stubs key policy active");
        process_exit(1);
    }

    let allow_a: Bool = kms_key_policy_allows_operation(&pol_a, "ENCRYPT");
    let allow_b: Bool = kms_key_policy_allows_operation(&pol_b, "ENCRYPT");
    if allow_a != allow_b {
        println("FAIL kms_stubs policy allows operation");
        process_exit(1);
    }

    println("prod_g4_sec_kms_stubs: PASSED");
    process_exit(0);
}
