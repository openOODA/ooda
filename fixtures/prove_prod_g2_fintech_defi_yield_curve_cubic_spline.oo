// # Product prove std/fintech_defi/yield_curve_cubic_spline.oo
//
// Logline: Fail-closed emit+gcc+run asserts cubic_spline_interpolate_linear is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/yield_curve_cubic_spline.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cubic_spline_interpolate_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_yield_curve_cubic_spline: PASSED only if they match.

import "std/fintech_defi/yield_curve_cubic_spline.oo";

pub fn main() {
    let g2_oa = cubic_spline_new();
    let g2_ob = cubic_spline_new();
    let g2_a = cubic_spline_interpolate_linear(&g2_oa, 1.0);
    let g2_b = cubic_spline_interpolate_linear(&g2_ob, 1.0);
    if g2_a != g2_b {
        println("FAIL cubic_spline_interpolate_linear");
        process_exit(1);
    }
    println("prod_g2_yield_curve_cubic_spline: PASSED");
}
