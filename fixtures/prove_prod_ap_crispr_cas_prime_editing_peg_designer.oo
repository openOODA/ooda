// # Product prove std/crispr_cas/prime_editing_peg_designer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crispr_cas/prime_editing_peg_designer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_peg_designer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_prime_editing_peg_designer: PASSED only if they match.

import "std/crispr_cas/prime_editing_peg_designer.oo";

pub fn main() {
    let prime_editing_peg_designer_a = peg_combine_extension("x", "x");
    let prime_editing_peg_designer_b = peg_combine_extension("x", "x");
    if prime_editing_peg_designer_a.contains(prime_editing_peg_designer_b) == false {
        println("FAIL prime_editing_peg_designer");
        process_exit(1);
    }
    if prime_editing_peg_designer_b.contains(prime_editing_peg_designer_a) == false {
        println("FAIL prime_editing_peg_designer");
        process_exit(1);
    }
    println("prod_ap_prime_editing_peg_designer: PASSED");
}
