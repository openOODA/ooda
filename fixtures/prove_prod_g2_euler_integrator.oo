// # Product prove std/physics/euler_integrator.oo
//
// Logline: Fail-closed emit+gcc+run asserts euler_state2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/euler_integrator.oo.
//
// Beats:
//   1. Call euler_state2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_euler_integrator: PASSED only if they match.

import "std/physics/euler_integrator.oo";

pub fn main() {
    let euler_integrator_mark: Int = 0;
    if euler_integrator_mark != 0 {
        process_exit(1);
    }
    let a: EulerState2D = euler_state2d_new(0.0, 0.0, 0.0);
    let b: EulerState2D = euler_state2d_new(0.0, 0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL euler_state2d_new");
        process_exit(1);
    }
    println("prod_g2_euler_integrator: PASSED");
}
