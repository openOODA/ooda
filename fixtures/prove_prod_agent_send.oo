// # Product prove std/sec/agent_send.oo
//
// Logline: Fail-closed emit+gcc+run asserts msg_carries_token is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/agent_send.oo.
//
// Beats:
//   1. Call msg_carries_token twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_agent_send: PASSED only if they match.

import "std/sec/agent_send.oo";

pub fn main() {
    let a = msg_carries_token("x");
    let b = msg_carries_token("x");
    if a != b {
        println("FAIL msg_carries_token");
        process_exit(1);
    }
    println("prod_agent_send: PASSED");
}
