// # Product prove std/game_engine/ecs_system.oo
//
// Logline: Fail-closed emit+gcc+run asserts system_phase_physics holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_system.oo.
//
// Beats:
//   1. Call system_phase_physics using the ecs_system ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ecs_system: PASSED only if asserts hold.

import "std/game_engine/ecs_system.oo";

pub fn main() {
    let ecs_system_a = system_phase_physics();
    if ecs_system_a != 3 {
        println("FAIL system_phase_physics");
        process_exit(1);
    }
    println("prod_ecs_system: PASSED");
}
