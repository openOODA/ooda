// # Product prove std/cloud_faas/workflow_saga_coordinator.oo
//
// Logline: Fail-closed emit+gcc+run asserts saga_coordinator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/workflow_saga_coordinator.oo.
//
// Beats:
//   1. Call saga_coordinator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_workflow_saga_coordinator: PASSED only if they match.

import "std/cloud_faas/workflow_saga_coordinator.oo";

pub fn main() {
    let workflow_saga_coordinator_mark: Int = 0;
    if workflow_saga_coordinator_mark != 0 {
        process_exit(1);
    }
    let workflow_saga_coordinator_a: SagaCoordinator = saga_coordinator_new("x");
    let workflow_saga_coordinator_b: SagaCoordinator = saga_coordinator_new("x");
    if (workflow_saga_coordinator_a).current_step_index != (workflow_saga_coordinator_b).current_step_index {
        println("FAIL saga_coordinator_new");
        process_exit(1);
    }
    println("prod_workflow_saga_coordinator: PASSED");
}
