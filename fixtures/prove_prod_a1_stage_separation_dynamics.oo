// # Product prove std/astro_advanced/stage_separation_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts sep_delta_v is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/stage_separation_dynamics.oo.
//
// Beats:
//   1. Call sep_delta_v twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stage_separation_dynamics: PASSED only if they match.

import "std/astro_advanced/stage_separation_dynamics.oo";

pub fn main() {
    let stage_separation_dynamics_mark: Int = 0;
    if stage_separation_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: Int = sep_delta_v();
    let b: Int = sep_delta_v();
    if a != b {
        println("FAIL sep_delta_v");
        process_exit(1);
    }
    println("prod_stage_separation_dynamics: PASSED");
}
