// # Product prove std/net/udp_conn.oo
//
// Logline: Fail-closed emit+gcc+run asserts udp_conn_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/udp_conn.oo.
//
// Beats:
//   1. Call udp_conn_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_udp_conn: PASSED only if they match.

import "std/net/udp_conn.oo";

pub fn main() {
    let a = udp_conn_probe();
    let b = udp_conn_probe();
    if a != b {
        println("FAIL udp_conn_probe");
        process_exit(1);
    }
    println("prod_udp_conn: PASSED");
}
