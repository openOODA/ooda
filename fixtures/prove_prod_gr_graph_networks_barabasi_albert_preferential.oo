// # Product prove std/graph_networks/barabasi_albert_preferential.oo
//
// Logline: Fail-closed emit+gcc+run asserts ba_update_degree is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/barabasi_albert_preferential.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ba_update_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_barabasi_albert_preferential: PASSED only if they match.

import "std/graph_networks/barabasi_albert_preferential.oo";

pub fn main() {
    let g0_la = ba_update_degree(list_new(), 0, 0);
    let g0_lb = ba_update_degree(list_new(), 0, 0);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL ba_update_degree");
        process_exit(1);
    }
    println("prod_gr_barabasi_albert_preferential: PASSED");
}
