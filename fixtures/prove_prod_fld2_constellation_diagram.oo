// # Product prove std/telecom/constellation_diagram.oo
//
// Logline: Fail-closed emit+gcc+run asserts constell_ln_approx is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/constellation_diagram.oo.
//
// Beats:
//   1. Call constell_ln_approx twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_constellation_diagram: PASSED only if they match.

import "std/telecom/constellation_diagram.oo";

pub fn main() {
    let constellation_diagram_mark: Int = 0;
    if constellation_diagram_mark != 0 {
        process_exit(1);
    }
    let constellation_diagram_a: Float = constell_ln_approx(1.0);
    let constellation_diagram_b: Float = constell_ln_approx(1.0);
    if constellation_diagram_a != constellation_diagram_b {
        println("FAIL constell_ln_approx");
        process_exit(1);
    }
    println("prod_constellation_diagram: PASSED");
}
