// # Product prove std/enterprise/etl.oo
//
// Logline: Fail-closed emit+check asserts etl_stream_raw_pointer_buffer is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/etl.oo.
//
// Beats:
//   1. Call etl_stream_raw_pointer_buffer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_etl: PASSED only if they match.

import "std/enterprise/etl.oo";

pub fn main() {
    let etl_mark: Int = 0;
    if etl_mark != 0 { process_exit(1); }
    let a: Int = etl_stream_raw_pointer_buffer(0, 0);
    let b: Int = etl_stream_raw_pointer_buffer(0, 0);
    if a != b { process_exit(1); }
    println("prod_etl: PASSED");
}
