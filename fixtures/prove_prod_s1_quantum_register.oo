// # Product prove std/quantum/quantum_register.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_pow2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/quantum_register.oo.
//
// Beats:
//   1. Call int_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_register: PASSED only if they match.

import "std/quantum/quantum_register.oo";

pub fn main() {
    let quantum_register_mark: Int = 0;
    if quantum_register_mark != 0 {
        process_exit(1);
    }
    let quantum_register_a: Int = int_pow2(1);
    let quantum_register_b: Int = int_pow2(1);
    if quantum_register_a != quantum_register_b {
        println("FAIL int_pow2");
        process_exit(1);
    }
    println("prod_quantum_register: PASSED");
}
