// # Product prove std/aero/propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts propulsion_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion.oo.
//
// Beats:
//   1. Call propulsion_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_propulsion: PASSED only if they match.

import "std/aero/propulsion.oo";

pub fn main() {
    let a: PropEng = propulsion_eng_new(0, 0);
    let b: PropEng = propulsion_eng_new(0, 0);
    if (a).thrust != (b).thrust {
        println("FAIL propulsion_eng_new");
        process_exit(1);
    }
    println("prod_g2_propulsion: PASSED");
}
