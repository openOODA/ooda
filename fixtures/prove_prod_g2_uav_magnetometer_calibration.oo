// # Product prove std/uav_flight/uav_magnetometer_calibration.oo
//
// Logline: Fail-closed emit+gcc+run asserts mag_calib_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_magnetometer_calibration.oo.
//
// Beats:
//   1. Call mag_calib_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_magnetometer_calibration: PASSED only if they match.

import "std/uav_flight/uav_magnetometer_calibration.oo";

pub fn main() {
    let uav_magnetometer_calibration_mark: Int = 0;
    if uav_magnetometer_calibration_mark != 0 {
        process_exit(1);
    }
    let a: MagCalibParams = mag_calib_params_default();
    let b: MagCalibParams = mag_calib_params_default();
    if (a).declination_rad != (b).declination_rad {
        println("FAIL mag_calib_params_default");
        process_exit(1);
    }
    println("prod_g2_uav_magnetometer_calibration: PASSED");
}
