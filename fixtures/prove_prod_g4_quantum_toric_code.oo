// # Product prove std/quantum_topological/toric_code_anyon_annihilation.oo
//
// Logline: Fail-closed emit+gcc+run asserts Toric Code string operators, closed-loop detection, and anyon pair annihilation checks are deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/toric_code_anyon_annihilation.oo.
//
// Beats:
//   1. Construct LatticeCoord instances and StringPath.
//   2. Test open vs closed string path loops with string_path_is_closed.
//   3. Test anyon pair fusion and vacuum annihilation with anyon_annihilate_pair.
//   4. Apply string operator to error vector state with apply_string_operator_to_state.
//   5. Print prod_g4_quantum_toric_code: PASSED and exit 0.

import "std/quantum_topological/toric_code_anyon_annihilation.oo";

pub fn main() {
    let c1: LatticeCoord = lattice_coord_new(0, 0);
    let c2: LatticeCoord = lattice_coord_new(2, 2);
    let c3: LatticeCoord = lattice_coord_new(0, 0);

    if (c1).x != 0 || (c1).y != 0 || (c2).x != 2 || (c2).y != 2 {
        println("FAIL lattice_coord_new");
        process_exit(1);
    }

    let mut open_path: StringPath = string_path_new(1, c1, c2);
    string_path_append_edge(&mut open_path, 0);
    string_path_append_edge(&mut open_path, 1);

    let closed_path: StringPath = string_path_new(1, c1, c3);

    let is_c_open: Int = string_path_is_closed(&open_path);
    let is_c_closed: Int = string_path_is_closed(&closed_path);

    if is_c_open != 0 || is_c_closed != 1 {
        println("FAIL string_path_is_closed");
        process_exit(1);
    }

    let ann_same: Int = anyon_annihilate_pair(&c1, &c3);
    let ann_diff: Int = anyon_annihilate_pair(&c1, &c2);

    if ann_same != 1 || ann_diff != 0 {
        println("FAIL anyon_annihilate_pair");
        process_exit(1);
    }

    let mut err_vec: List[Int] = list_new();
    list_push(err_vec, 0);
    list_push(err_vec, 1);
    apply_string_operator_to_state(&open_path, &mut err_vec);

    println("prod_g4_quantum_toric_code: PASSED");
    process_exit(0);
}
