// # Product prove std/compilers/lsp_completion.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/lsp_completion.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_completion.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_lsp_completion: PASSED only if they match.

import "std/compilers/lsp_completion.oo";

pub fn main() {
    let lsp_completion_a = lsp_item_kind_text();
    let lsp_completion_b = lsp_item_kind_text();
    if lsp_completion_a != lsp_completion_b {
        println("FAIL lsp_completion");
        process_exit(1);
    }
    println("prod_ap_lsp_completion: PASSED");
}
