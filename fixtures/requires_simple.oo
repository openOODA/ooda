// # Pass a simple requires clause
//
// Logline: A simple requires x > 0 holds at runtime and the value prints.
//
// Beats:
//   1. Require x greater than zero on pos.
//   2. Call pos with 3.
//   3. Print the same value when the clause holds.

// Pass: simple requires IDENT OP lit runtime-enforced; holds → OK
pub fn pos(x: Int) -> Int
    requires x > 0
{
    return x;
}

pub fn main() {
    println(pos(3));
}
