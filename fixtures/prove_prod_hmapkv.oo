// # Product hash string map prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/map.oo.
//
// Setup: Product std/hash/map.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty map length is 0.
//   2. Insert then length is 1 and get_or hits.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/map.oo";

pub fn main() {
    let mut m: HashMap = map_new();
    let n0: Int = map_len(m);
    if n0 != 0 {
        println("FAIL map empty len");
        process_exit(1);
    }
    m = map_insert(m, "k", "v");
    let n1: Int = map_len(m);
    if n1 != 1 {
        println("FAIL map len 1");
        process_exit(1);
    }
    let v: String = map_get_or(m, "k", "missing");
    if v != "v" {
        println("FAIL map get v");
        process_exit(1);
    }
    let miss: String = map_get_or(m, "no", "d");
    if miss != "d" {
        println("FAIL map default");
        process_exit(1);
    }
    println("prod_hmapkv: PASSED");
}
