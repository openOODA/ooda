// # Product prove std/zk_rollup/schnorr_signature_batch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/schnorr_signature_batch.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/schnorr_signature_batch.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_schnorr_signature_batch: PASSED only if they match.

import "std/zk_rollup/schnorr_signature_batch.oo";

pub fn main() {
    let schnorr_signature_batch_a = schnorr_signature_new(0, 0, 0);
    let schnorr_signature_batch_b = schnorr_signature_new(0, 0, 0);
    if schnorr_signature_batch_a.point_r_x != schnorr_signature_batch_b.point_r_x {
        println("FAIL schnorr_signature_batch");
        process_exit(1);
    }
    println("prod_ap_schnorr_signature_batch: PASSED");
}
