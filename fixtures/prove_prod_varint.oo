// # Product varint ZigZag prove
//
// Logline: Fail-closed emit+gcc+run of shipped zigzag and unsigned varint length.
//
// Setup: Product std/encoding/varint.oo. Protobuf/LEB128 published mapping.
//
// Beats:
//   1. zigzag_encode 0/-1/1 is 0/1/2.
//   2. zigzag_decode of 1 is -1.
//   3. varint_encoded_len 1 is 1; 128 is 2. Exit 1 before PASSED on a miss.

import "std/encoding/varint.oo";

pub fn main() {
    if zigzag_encode(0) != 0 {
        println("FAIL zigzag 0");
        process_exit(1);
    }
    if zigzag_encode(0 - 1) != 1 {
        println("FAIL zigzag -1");
        process_exit(1);
    }
    if zigzag_encode(1) != 2 {
        println("FAIL zigzag 1");
        process_exit(1);
    }
    if zigzag_decode(1) != (0 - 1) {
        println("FAIL zigzag_decode 1");
        process_exit(1);
    }
    if varint_encoded_len(1) != 1 {
        println("FAIL varint len 1");
        process_exit(1);
    }
    if varint_encoded_len(128) != 2 {
        println("FAIL varint len 128");
        process_exit(1);
    }
    println("prod_varint: PASSED");
}
