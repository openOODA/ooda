// # Product prove std/telecom_6g/ris_polarization_conversion.oo
//
// Logline: Fail-closed emit+gcc+run asserts metasurface_polarizer_cross_converter is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_polarization_conversion.oo.
//
// Beats:
//   1. Call metasurface_polarizer_cross_converter twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ris_polarization_conversion: PASSED only if they match.

import "std/telecom_6g/ris_polarization_conversion.oo";

pub fn main() {
    let ris_polarization_conversion_mark: Int = 0;
    if ris_polarization_conversion_mark != 0 {
        process_exit(1);
    }
    let a: PolarizationMatrix = metasurface_polarizer_cross_converter();
    let b: PolarizationMatrix = metasurface_polarizer_cross_converter();
    if (a).r_xx_mag != (b).r_xx_mag {
        println("FAIL metasurface_polarizer_cross_converter");
        process_exit(1);
    }
    println("prod_ris_polarization_conversion: PASSED");
}
