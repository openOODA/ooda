// # Product prove std/db_storage/buffer_pool_clock_sweep.oo
//
// Logline: Fail-closed emit+gcc+run asserts clock_frame_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/buffer_pool_clock_sweep.oo.
//
// Beats:
//   1. Call clock_frame_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_buffer_pool_clock_sweep: PASSED only if they match.

import "std/db_storage/buffer_pool_clock_sweep.oo";

pub fn main() {
    let buffer_pool_clock_sweep_mark: Int = 0;
    if buffer_pool_clock_sweep_mark != 0 {
        process_exit(1);
    }
    let a: ClockFrame = clock_frame_new(0, 0);
    let b: ClockFrame = clock_frame_new(0, 0);
    if (a).frame_id != (b).frame_id {
        println("FAIL clock_frame_new");
        process_exit(1);
    }
    println("prod_buffer_pool_clock_sweep: PASSED");
}
