// # Product prove std/net_telemetry/telemetry_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/net_telemetry/telemetry_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/telemetry_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_telemetry_stubs: PASSED only if they match.

import "std/net_telemetry/telemetry_stubs.oo";

pub fn main() {
    let telemetry_stubs_a = nic_hardware_config_new("x", 0, true, true);
    let telemetry_stubs_b = nic_hardware_config_new("x", 0, true, true);
    if telemetry_stubs_a.interface_name != telemetry_stubs_b.interface_name {
        println("FAIL telemetry_stubs");
        process_exit(1);
    }
    println("prod_ap_telemetry_stubs: PASSED");
}
