// # Const if 1!=2 || 3!=3 println no else
//
// Logline: Print neqor-ne when 1!=2 || 3!=3 and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If 1!=2 || 3!=3 print neqor-ne.
//   3. Leave no else and no other statements.

pub fn main() {
    if 1 != 2 || 3 != 3 {
        println("neqor-ne");
    }
}
