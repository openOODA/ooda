// # Product prove std/fin/orderbook.oo
//
// Logline: Fail-closed emit+gcc+run asserts financial order book operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook.oo.
//
// Beats:
//   1. Create limit order and initialize order book.
//   2. Add buy order and verify best bid and depth level.
//   3. Assert deterministic return values.
//   4. Print prod_g4_fin_orderbook: PASSED and exit 0.

import "std/fin/orderbook.oo";

pub fn main() {
    let order1: LimitOrder = shim_marker_order_create();
    let order2: LimitOrder = shim_marker_order_create();
    if (order1).order_id != (order2).order_id || (order1).price != 15000 {
        println("FAIL shim_marker_order_create");
        process_exit(1);
    }

    let ob0: OrderBook = shim_marker_orderbook_init();
    let ob1: OrderBook = shim_marker_add_order(ob0, order1);
    let ob2: OrderBook = shim_marker_add_order(ob0, order2);

    let bb1: Int = shim_marker_best_bid(ob1);
    let bb2: Int = shim_marker_best_bid(ob2);
    if bb1 != bb2 || bb1 != 15000 {
        println("FAIL shim_marker_best_bid");
        process_exit(1);
    }

    let mid1: Int = shim_marker_mid_price(ob1);
    let mid2: Int = shim_marker_mid_price(ob2);
    if mid1 != mid2 || mid1 != 15000 {
        println("FAIL shim_marker_mid_price");
        process_exit(1);
    }

    let canceled_ob: OrderBook = shim_marker_cancel_order(ob1);
    let bb_after: Int = shim_marker_best_bid(canceled_ob);
    if bb_after != 0 {
        println("FAIL shim_marker_cancel_order");
        process_exit(1);
    }

    println("prod_g4_fin_orderbook: PASSED");
    process_exit(0);
}
