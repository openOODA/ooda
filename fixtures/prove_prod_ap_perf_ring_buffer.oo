// # Product prove std/perf/ring_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/ring_buffer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/ring_buffer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ring_buffer: PASSED only if they match.

import "std/perf/ring_buffer.oo";

pub fn main() {
    let ring_buffer_a = ring_buffer_create("x", 0);
    let ring_buffer_b = ring_buffer_create("x", 0);
    let ring_buffer_va = ring_buffer_size(ring_buffer_a);
    let ring_buffer_vb = ring_buffer_size(ring_buffer_b);
    if ring_buffer_va != ring_buffer_vb {
        println("FAIL ring_buffer");
        process_exit(1);
    }
    println("prod_ap_ring_buffer: PASSED");
}
