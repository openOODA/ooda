// # Product Base58 Bitcoin prove
//
// Logline: Fail-closed emit+gcc+run of shipped base58_bitcoin_encode_int.
//
// Setup: Product std/text/base58_bitcoin.oo. Alphabet[0]=1, [1]=2.
//
// Beats:
//   1. encode_int(0) is 1.
//   2. encode_int(58) is 21 (58/58 rem 0 then 1).
//   3. Exit 1 before PASSED on a miss.

import "std/text/base58_bitcoin.oo";

pub fn main() {
    let z: String = base58_bitcoin_encode_int(0);
    if z != "1" {
        println("FAIL b58btc 0");
        process_exit(1);
    }
    let f: String = base58_bitcoin_encode_int(58);
    if f != "21" {
        println("FAIL b58btc 58");
        process_exit(1);
    }
    let ok: Bool = base58_bitcoin_is_valid_char("1");
    if ok == false {
        println("FAIL b58btc valid 1");
        process_exit(1);
    }
    println("prod_b58btc: PASSED");
}
