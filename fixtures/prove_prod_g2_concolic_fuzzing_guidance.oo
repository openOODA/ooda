// # Product prove std/exploit_analysis/concolic_fuzzing_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts branch_condition_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/concolic_fuzzing_guidance.oo.
//
// Beats:
//   1. Call branch_condition_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_concolic_fuzzing_guidance: PASSED only if they match.

import "std/exploit_analysis/concolic_fuzzing_guidance.oo";

pub fn main() {
    let concolic_fuzzing_guidance_mark: Int = 0;
    if concolic_fuzzing_guidance_mark != 0 {
        process_exit(1);
    }
    let a: BranchConditionNode = branch_condition_node_new(0, true, "x", 0);
    let b: BranchConditionNode = branch_condition_node_new(0, true, "x", 0);
    if (a).branch_address != (b).branch_address {
        println("FAIL branch_condition_node_new");
        process_exit(1);
    }
    println("prod_g2_concolic_fuzzing_guidance: PASSED");
}
