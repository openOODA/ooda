// # Product prove std/web_ecosystem/diff_match_patch.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_chunk_equal is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/diff_match_patch.oo.
//
// Beats:
//   1. Call diff_chunk_equal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_diff_match_patch: PASSED only if they match.

import "std/web_ecosystem/diff_match_patch.oo";

pub fn main() {
    let diff_match_patch_mark: Int = 0;
    if diff_match_patch_mark != 0 {
        process_exit(1);
    }
    let diff_match_patch_a: Int = diff_chunk_equal();
    let diff_match_patch_b: Int = diff_chunk_equal();
    if diff_match_patch_a != diff_match_patch_b {
        println("FAIL diff_chunk_equal");
        process_exit(1);
    }
    println("prod_diff_match_patch: PASSED");
}
