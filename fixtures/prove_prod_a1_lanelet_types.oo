// # Product prove std/auto/lanelet_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts lanelet_abs_val is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_types.oo.
//
// Beats:
//   1. Call lanelet_abs_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lanelet_types: PASSED only if they match.

import "std/auto/lanelet_types.oo";

pub fn main() {
    let lanelet_types_mark: Int = 0;
    if lanelet_types_mark != 0 {
        process_exit(1);
    }
    let a: Int = lanelet_abs_val(0);
    let b: Int = lanelet_abs_val(0);
    if a != b {
        println("FAIL lanelet_abs_val");
        process_exit(1);
    }
    println("prod_lanelet_types: PASSED");
}
