// # Product prove std/astrophysics_relativity/stellar_nucleosynthesis_pp_cno.oo
//
// Logline: Fail-closed emit+gcc+run asserts nuclear_pp_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_nucleosynthesis_pp_cno.oo.
//
// Beats:
//   1. Call nuclear_pp_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_nucleosynthesis_pp_cno: PASSED only if they match.

import "std/astrophysics_relativity/stellar_nucleosynthesis_pp_cno.oo";

pub fn main() {
    let stellar_nucleosynthesis_pp_cno_mark: Int = 0;
    if stellar_nucleosynthesis_pp_cno_mark != 0 {
        process_exit(1);
    }
    let a: Int = nuclear_pp_rate(0, 0, 0);
    let b: Int = nuclear_pp_rate(0, 0, 0);
    if a != b {
        println("FAIL nuclear_pp_rate");
        process_exit(1);
    }
    println("prod_stellar_nucleosynthesis_pp_cno: PASSED");
}
