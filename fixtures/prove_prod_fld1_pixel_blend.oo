// # Product prove std/multimedia/pixel_blend.oo
//
// Logline: Fail-closed emit+gcc+run asserts blend_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/pixel_blend.oo.
//
// Beats:
//   1. Call blend_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pixel_blend: PASSED only if they match.

import "std/multimedia/pixel_blend.oo";

pub fn main() {
    let pixel_blend_mark: Int = 0;
    if pixel_blend_mark != 0 {
        process_exit(1);
    }
    let pixel_blend_a: Float = blend_abs(1.0);
    let pixel_blend_b: Float = blend_abs(1.0);
    if pixel_blend_a != pixel_blend_b {
        println("FAIL blend_abs");
        process_exit(1);
    }
    println("prod_pixel_blend: PASSED");
}
