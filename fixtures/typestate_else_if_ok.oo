// # Connect around an else-if return
//
// Logline: Connect in the live arms and return from the middle else-if so send is legal.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Connect in the true arm and the last else.
//   3. Return from the false else-if, then send.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    if true {
        connect(s);
    } else if false {
        return;
    } else {
        connect(s);
    }
    send(s);
}
