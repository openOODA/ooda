// # Product prove std/defi_derivatives/perpetual_adld_deleverage.oo
//
// Logline: Fail-closed emit+gcc+run asserts calc_adl_score is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_adld_deleverage.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call calc_adl_score twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_perpetual_adld_deleverage: PASSED only if they match.

import "std/defi_derivatives/perpetual_adld_deleverage.oo";

pub fn main() {
    let g0_a = calc_adl_score(1.0, 1.0, 1.0, 1.0);
    let g0_b = calc_adl_score(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL calc_adl_score");
        process_exit(1);
    }
    println("prod_g0_perpetual_adld_deleverage: PASSED");
}
