// # Product C emit: requires raw.len() > 0
//
// Logline: Fail-closed emit+gcc+run of a requires clause that calls .len().
//
// Setup: Isolated emit-c. Contract lowers IDENT.len() to oo_str_len.
//
// Beats:
//   1. contract_len_hi("ab") is 2.
//   2. Exit 1 on miss. Print prod_contract_len: PASSED only if it holds.

pub fn contract_len_hi(raw: String) -> Int
    requires raw.len() > 0
{
    return chars_len(raw);
}

pub fn main() {
    let n: Int = contract_len_hi("ab");
    if n != 2 {
        println("FAIL contract_len");
        process_exit(1);
    }
    println("prod_contract_len: PASSED");
}
