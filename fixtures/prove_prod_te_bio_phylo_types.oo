// # Product prove std/bio/phylo_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/phylo_types.oo.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_phylo_types: PASSED only if they match.

import "std/bio/phylo_types.oo";

pub fn main() {
    let phylo_types_mark: Int = 0;
    if phylo_types_mark != 0 {
        process_exit(1);
    }
    let a: Float = int_to_float(0);
    let b: Float = int_to_float(0);
    if a != b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_phylo_types: PASSED");
}
