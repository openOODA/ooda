// # Product prove std/fs/path.oo
//
// Logline: Fail-closed emit+gcc+run asserts path_is_absolute is a real value.
//
// Setup: Isolated emit-c. Imports std/fs/path.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call path_is_absolute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_path: PASSED only if they match.

import "std/fs/path.oo";

pub fn main() {
    let g0_a = path_is_absolute("x");
    let g0_b = path_is_absolute("x");
    if g0_a != g0_b {
        println("FAIL path_is_absolute");
        process_exit(1);
    }
    println("prod_g0_path: PASSED");
}
