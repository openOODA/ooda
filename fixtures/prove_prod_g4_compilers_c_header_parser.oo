// # Product prove std/compilers/c_header_parser.oo
//
// Logline: Fail-closed verification of C header abstract syntax tree parser and token ingestion.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_parser.oo.
//
// Beats:
//   1. Construct CParserState over token stream and verify cursor traversal.
//   2. Parse pointer indirection type specifiers.
//   3. Parse typedef aliases, struct declarations, and function signatures.
//   4. Print prod_g4_compilers_c_header_parser: PASSED and exit 0.

import "std/compilers/c_header_parser.oo";
import "std/compilers/c_header_lexer.oo";
import "std/compilers/c_header_ast.oo";

pub fn main() {
    let empty_toks: List[CToken] = list_new();
    let p0: CParserState = c_parser_new(empty_toks);
    let at_end: Bool = c_parser_is_at_end(&p0);
    if !at_end {
        println("FAIL c_parser_is_at_end empty");
        process_exit(1);
    }

    let eof_k: Int = c_parser_peek_kind(&p0);
    if eof_k != c_tok_eof() {
        println("FAIL c_parser_peek_kind eof");
        process_exit(1);
    }

    let mut toks: List[CToken] = list_new();
    toks = list_push(toks, c_token_new(c_tok_kw_int(), 1, 1, 0));
    toks = list_push(toks, c_token_new(c_tok_star(), 1, 5, 0));

    let mut p1: CParserState = c_parser_new(toks);
    let t: CType = c_parser_parse_type(&mut p1);
    let ptr_depth: Int = (t).pointer_depth;
    let tname: String = (t).type_name;
    if ptr_depth != 1 || tname != "int" {
        println("FAIL c_parser_parse_type pointer");
        process_exit(1);
    }

    let mut ttoks: List[CToken] = list_new();
    ttoks = list_push(ttoks, c_token_new(c_tok_kw_typedef(), 1, 1, 0));
    ttoks = list_push(ttoks, c_token_new(c_tok_kw_int(), 1, 9, 0));
    ttoks = list_push(ttoks, c_token_new(c_tok_ident(), 1, 13, 0));

    let mut p2: CParserState = c_parser_new(ttoks);
    let td: CTypedefDecl = c_parser_parse_typedef(&mut p2);
    let td_target_depth: Int = ((td).target_type).pointer_depth;
    if td_target_depth != 0 {
        println("FAIL c_parser_parse_typedef");
        process_exit(1);
    }

    let mut stoks: List[CToken] = list_new();
    stoks = list_push(stoks, c_token_new(c_tok_kw_struct(), 1, 1, 0));
    stoks = list_push(stoks, c_token_new(c_tok_ident(), 1, 8, 0));

    let mut p3: CParserState = c_parser_new(stoks);
    let st: CStructDecl = c_parser_parse_struct(&mut p3);
    let is_un: Bool = (st).is_union;
    if is_un {
        println("FAIL c_parser_parse_struct is_union");
        process_exit(1);
    }

    println("prod_g4_compilers_c_header_parser: PASSED");
    process_exit(0);
}
