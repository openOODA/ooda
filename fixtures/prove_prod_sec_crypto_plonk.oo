// # Product prove std/sec/crypto/plonk.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_mod_add is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk.oo.
//
// Beats:
//   1. Call shim_marker_mod_add twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk: PASSED only if they match.

import "std/sec/crypto/plonk.oo";

pub fn main() {
    let plonk_mark: Int = 0;
    if plonk_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_mod_add();
    let b: Int = shim_marker_mod_add();
    if a != b { process_exit(1); }
    println("prod_plonk: PASSED");
}
