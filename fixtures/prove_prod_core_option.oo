// # Product std/core option helpers prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/core/option.oo Some/None helpers.
//
// Setup: Tree oodac emit-c. Calls ooda/std/core/option.oo. Destub none. No caps.
//
// Beats:
//   1. opt_is_some(opt_some("x")) is true.
//   2. opt_is_none(opt_none()) is true.
//   3. opt_unwrap_or(opt_none(), "d") == "d".
//   4. opt_unwrap_or(opt_some("x"), "d") == "x".
//   5. Exit 1 on any miss. Print prod_core_option: PASSED only if all hold.

import "std/core/option.oo";

pub fn main() {
    let some_o: Result[String, String] = opt_some("x");
    if !opt_is_some(some_o) {
        println("FAIL opt_is_some");
        process_exit(1);
    }
    let none_o: Result[String, String] = opt_none();
    if !opt_is_none(none_o) {
        println("FAIL opt_is_none");
        process_exit(1);
    }
    let d: String = opt_unwrap_or(opt_none(), "d");
    if d != "d" {
        println("FAIL opt_unwrap_or none");
        process_exit(1);
    }
    let x: String = opt_unwrap_or(opt_some("x"), "d");
    if x != "x" {
        println("FAIL opt_unwrap_or some");
        process_exit(1);
    }
    println("prod_core_option: PASSED");
}
