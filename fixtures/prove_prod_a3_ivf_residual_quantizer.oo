// # Product prove std/db_vector_ann/ivf_residual_quantizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts residual_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/ivf_residual_quantizer.oo.
//
// Beats:
//   1. Call residual_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ivf_residual_quantizer: PASSED only if they match.

import "std/db_vector_ann/ivf_residual_quantizer.oo";

pub fn main() {
    let ivf_residual_quantizer_mark: Int = 0;
    if ivf_residual_quantizer_mark != 0 {
        process_exit(1);
    }
    let a: ResidualConfig = residual_config_default(0);
    let b: ResidualConfig = residual_config_default(0);
    if (a).dimension != (b).dimension {
        println("FAIL residual_config_default");
        process_exit(1);
    }
    println("prod_ivf_residual_quantizer: PASSED");
}
