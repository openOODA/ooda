// # Product prove std/bio/cell_pop.oo
//
// Logline: Fail-closed verification that cell population dynamics and culture environments are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/cell_pop.oo.
//
// Beats:
//   1. Construct CellEnvironment and verify physiological parameters.
//   2. Initialize CellLine and CellPopulation structures.
//   3. Initialize CellCulture and verify initial passage state.
//   4. Print prod_g4_bio_cell_pop: PASSED and exit 0.

import "std/bio/cell_pop.oo";

pub fn main() {
    let cell_pop_mark: Int = 0;
    if cell_pop_mark != 0 {
        process_exit(1);
    }
    let env1: CellEnvironment = cell_environment_default();
    let env2: CellEnvironment = cell_environment_default();

    let phys1: Bool = cell_environment_is_physiological(&env1);
    let phys2: Bool = cell_environment_is_physiological(&env2);
    if !phys1 || !phys2 {
        println("FAIL cell_environment_is_physiological");
        process_exit(1);
    }

    let line1: CellLine = cell_line_new("CL-1", "Human", "Lung", true, 22.0);
    let line2: CellLine = cell_line_new("CL-1", "Human", "Lung", true, 22.0);
    if (line1).base_doubling_time != (line2).base_doubling_time || (line1).base_doubling_time != 22.0 {
        println("FAIL cell_line_new");
        process_exit(1);
    }

    let pop1: CellPopulation = cell_population_new(100);
    let pop2: CellPopulation = cell_population_new(100);

    let sz1: Int = cell_population_size(pop1);
    let sz2: Int = cell_population_size(pop2);
    if sz1 != sz2 || sz1 != 100 {
        println("FAIL cell_population_size");
        process_exit(1);
    }

    let dens1: Float = cell_population_density(pop1, 10.0);
    let dens2: Float = cell_population_density(pop2, 10.0);
    if dens1 != dens2 || dens1 != 10.0 {
        println("FAIL cell_population_density");
        process_exit(1);
    }

    let cult1: CellCulture = cell_culture_new(101, "Culture_A", pop1, env1);
    let cult2: CellCulture = cell_culture_new(101, "Culture_A", pop2, env2);
    if (cult1).passage_number != (cult2).passage_number || (cult1).passage_number != 1 {
        println("FAIL cell_culture_new");
        process_exit(1);
    }

    let passaged1: CellCulture = cell_culture_passage(cult1, 2.0);
    let passaged2: CellCulture = cell_culture_passage(cult2, 2.0);
    if (passaged1).passage_number != (passaged2).passage_number || (passaged1).population.current_count != (passaged2).population.current_count || (passaged1).population.current_count != 50 {
        println("FAIL cell_culture_passage");
        process_exit(1);
    }

    println("prod_g4_bio_cell_pop: PASSED");
    process_exit(0);
}
