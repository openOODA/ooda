// # Product prove std/diag/event_timeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts event_timeline_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/event_timeline.oo.
//
// Beats:
//   1. Call event_timeline_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_event_timeline: PASSED only if they match.

import "std/diag/event_timeline.oo";

pub fn main() {
    let obj = event_timeline_new(0);
    let a = event_timeline_count(obj);
    let b = event_timeline_count(obj);
    if a != b {
        println("FAIL event_timeline_count");
        process_exit(1);
    }
    println("prod_event_timeline: PASSED");
}
