// # Product prove std/sec/crypto/plonk_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_batch_verifier_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/plonk_verifier.oo.
//
// Beats:
//   1. Call plonk_batch_verifier_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_plonk_verifier: PASSED only if they match.

import "std/sec/crypto/plonk_verifier.oo";

pub fn main() {
    let plonk_verifier_mark: Int = 0;
    if plonk_verifier_mark != 0 {
        process_exit(1);
    }
    let a: PlonkBatchVerifier = plonk_batch_verifier_init("x");
    let b: PlonkBatchVerifier = plonk_batch_verifier_init("x");
    if (a).verified_count != (b).verified_count {
        println("FAIL plonk_batch_verifier_init");
        process_exit(1);
    }
    println("prod_g2_plonk_verifier: PASSED");
}
