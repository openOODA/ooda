// # Product prove std/quantum_open_systems/quantum_thermodynamics_work_heat.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_first_law_residual is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/quantum_thermodynamics_work_heat.oo.
//
// Beats:
//   1. Call quantum_first_law_residual twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_thermodynamics_work_heat: PASSED only if they match.

import "std/quantum_open_systems/quantum_thermodynamics_work_heat.oo";

pub fn main() {
    let quantum_thermodynamics_work_heat_mark: Int = 0;
    if quantum_thermodynamics_work_heat_mark != 0 {
        process_exit(1);
    }
    let a: Float = quantum_first_law_residual(0.0, 0.0, 0.0);
    let b: Float = quantum_first_law_residual(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL quantum_first_law_residual");
        process_exit(1);
    }
    println("prod_quantum_thermodynamics_work_heat: PASSED");
}
