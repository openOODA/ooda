// # Product prove std/tda_topology/topological_density_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian_kernel_eval is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/topological_density_estimator.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call gaussian_kernel_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_topological_density_estimator: PASSED only if they match.

import "std/tda_topology/topological_density_estimator.oo";

pub fn main() {
    let g0_a = gaussian_kernel_eval(0.0, 0.0);
    let g0_b = gaussian_kernel_eval(0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL gaussian_kernel_eval");
        process_exit(1);
    }
    println("prod_gr_topological_density_estimator: PASSED");
}
