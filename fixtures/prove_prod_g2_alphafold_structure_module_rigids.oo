// # Product prove std/protein_folding/alphafold_structure_module_rigids.oo
//
// Logline: Fail-closed emit+gcc+run asserts af_identity_frame is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/alphafold_structure_module_rigids.oo.
//
// Beats:
//   1. Call af_identity_frame twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_alphafold_structure_module_rigids: PASSED only if they match.

import "std/protein_folding/alphafold_structure_module_rigids.oo";

pub fn main() {
    let alphafold_structure_module_rigids_mark: Int = 0;
    if alphafold_structure_module_rigids_mark != 0 {
        process_exit(1);
    }
    let a: RigidFrame3D = af_identity_frame(0);
    let b: RigidFrame3D = af_identity_frame(0);
    if (a).residue_index != (b).residue_index {
        println("FAIL af_identity_frame");
        process_exit(1);
    }
    println("prod_g2_alphafold_structure_module_rigids: PASSED");
}
