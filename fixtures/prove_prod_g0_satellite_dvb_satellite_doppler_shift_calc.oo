// # Product prove std/satellite_dvb/satellite_doppler_shift_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts satellite_calc_doppler_hz is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_doppler_shift_calc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call satellite_calc_doppler_hz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_satellite_doppler_shift_calc: PASSED only if they match.

import "std/satellite_dvb/satellite_doppler_shift_calc.oo";

pub fn main() {
    let g0_a = satellite_calc_doppler_hz(1.0, 1.0);
    let g0_b = satellite_calc_doppler_hz(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL satellite_calc_doppler_hz");
        process_exit(1);
    }
    println("prod_g0_satellite_doppler_shift_calc: PASSED");
}
