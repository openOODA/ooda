// # Product prove std/compilers/wasm_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/wasm_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_engine: PASSED only if they match.

import "std/compilers/wasm_engine.oo";

pub fn main() {
    let wasm_engine_a = wasm_page_bytes();
    let wasm_engine_b = wasm_page_bytes();
    if wasm_engine_a != wasm_engine_b {
        println("FAIL wasm_engine");
        process_exit(1);
    }
    println("prod_ap_wasm_engine: PASSED");
}
