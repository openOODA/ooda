// # Product prove std/fs/file_info.oo
//
// Logline: Fail-closed emit+gcc+run asserts file_info_format_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/file_info.oo.
//
// Beats:
//   1. Call file_info_format_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_file_info: PASSED only if they match.

import "std/fs/file_info.oo";

pub fn main() {
    let a = file_info_format_size(0);
    let b = file_info_format_size(0);
    if a != b {
        println("FAIL file_info_format_size");
        process_exit(1);
    }
    println("prod_file_info: PASSED");
}
