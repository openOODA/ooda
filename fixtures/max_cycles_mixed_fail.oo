// # Mixed loops exceed budget
//
// Logline: Share a four-cycle budget across a while and a longer for.
//
// Beats:
//   1. Keep the four-cycle marker.
//   2. While-increment a to 2.
//   3. For 0..5 then expect the shared budget to trip.

// M64 mixed while+for share per-fn budget
// MAX_CYCLES: 4
pub fn main() {
    let mut a = 0;
    while a < 2 {
        a = a + 1;
    }
    let mut s = 0;
    for i in 0..5 {
        s = s + 1;
    }
    println(s);
}
