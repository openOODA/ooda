// # Product prove std/graph_topology/mst_prim.oo
//
// Logline: Fail-closed emit+gcc+run asserts Prim's minimum spanning tree algorithm and total tree weight.
//
// Setup: Isolated emit-c. Imports std/graph_topology/mst_prim.oo.
//
// Beats:
//   1. Construct weighted connected graph with redundant cycle edges.
//   2. Compute minimum spanning tree via Prim's algorithm.
//   3. Assert spanning property, exact minimal weight, and edge count.
//   4. Print prod_g4_graph_mst_prim: PASSED on success.

import "std/graph_topology/mst_prim.oo";
import "std/graph_topology/graph_adjacency_list.oo";
import "std/graph_topology/graph_edge_list.oo";

pub fn main() {
    let mut g: GraphAdjList = adj_list_create(false);
    adj_list_add_edge(&mut g, 0, 1, 10);
    adj_list_add_edge(&mut g, 1, 2, 20);
    adj_list_add_edge(&mut g, 0, 2, 30);

    let res: PrimMstResult = prim_mst(&g, 3, 0);
    let span: Bool = (res).is_spanning;
    if span == false {
        println("FAIL prim_mst is_spanning");
        process_exit(1);
    }

    let w: Int = prim_mst_weight(&res);
    if w != 30 {
        println("FAIL prim_mst_weight");
        process_exit(1);
    }

    let e_cnt: Int = prim_mst_edge_count(&res);
    if e_cnt != 2 {
        println("FAIL prim_mst_edge_count");
        process_exit(1);
    }

    adj_list_add_vertex(&mut g, 3);
    let res_disc: PrimMstResult = prim_mst(&g, 4, 0);
    let span_disc: Bool = (res_disc).is_spanning;
    if span_disc == true {
        println("FAIL prim_mst disconnected spanning");
        process_exit(1);
    }

    println("prod_g4_graph_mst_prim: PASSED");
    process_exit(0);
}
