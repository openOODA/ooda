// # Product prove std/ai_ml/tokenizer_bpe.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/tokenizer_bpe.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tokenizer_bpe.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tokenizer_bpe: PASSED only if they match.

import "std/ai_ml/tokenizer_bpe.oo";

pub fn main() {
    let tokenizer_bpe_a = bpe_vocab_size();
    let tokenizer_bpe_b = bpe_vocab_size();
    if tokenizer_bpe_a != tokenizer_bpe_b {
        println("FAIL tokenizer_bpe");
        process_exit(1);
    }
    println("prod_ap_tokenizer_bpe: PASSED");
}
