// # Product prove std/multimedia/png_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_crc32_byte_table is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_chunk.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call png_crc32_byte_table twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_png_chunk: PASSED only if they match.

import "std/multimedia/png_chunk.oo";

pub fn main() {
    let g0_a = png_crc32_byte_table(0);
    let g0_b = png_crc32_byte_table(0);
    if g0_a != g0_b {
        println("FAIL png_crc32_byte_table");
        process_exit(1);
    }
    println("prod_gr_png_chunk: PASSED");
}
