// # Product prove std/bio_advanced/crispr_prime_editing.oo
//
// Logline: Fail-closed verification that CRISPR prime editing pegRNA design and melting temp scoring are deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_prime_editing.oo.
//
// Beats:
//   1. Verify default prime editing parameters.
//   2. Compute PBS melting temperature via Wallace formula (assert == 28.0 for "ATGCATGCAT").
//   3. Score pegRNA design and assert deterministic overall score.
//   4. Print prod_g4_bio_crispr_prime: PASSED and exit 0.

import "std/bio_advanced/crispr_prime_editing.oo";

pub fn main() {
    let crispr_prime_editing_mark: Int = 0;
    if crispr_prime_editing_mark != 0 {
        process_exit(1);
    }
    let p: PrimeEditParams = prime_params_default();
    if (p).optimal_pbs_len_min != 10 || (p).target_pbs_tm != 34.0 {
        println("FAIL prime_params_default");
        process_exit(1);
    }

    let tm1: Float = prime_calc_pbs_tm("ATGCATGCAT");
    let tm2: Float = prime_calc_pbs_tm("ATGCATGCAT");
    if tm1 != tm2 || tm1 != 28.0 {
        println("FAIL prime_calc_pbs_tm");
        process_exit(1);
    }

    let des1: PegRnaDesign = prime_score_design("ACGTACGTACGTACGTACGT", "ATGCATGCAT", "GATTACAGATTACA", 5);
    let des2: PegRnaDesign = prime_score_design("ACGTACGTACGTACGTACGT", "ATGCATGCAT", "GATTACAGATTACA", 5);
    if (des1).overall_score != (des2).overall_score || (des1).overall_score != 91.0 {
        println("FAIL prime_score_design");
        process_exit(1);
    }

    if (des1).pbs_length != 10 || (des1).rtt_length != 14 {
        println("FAIL design lengths");
        process_exit(1);
    }

    println("prod_g4_bio_crispr_prime: PASSED");
    process_exit(0);
}
