// # Product prove std/sec/sys/pe_parse.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/pe_parse.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_parse.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pe_parse: PASSED only if they match.

import "std/sec/sys/pe_parse.oo";

pub fn main() {
    let pe_parse_a = pe_parse_dos_header("x");
    let pe_parse_b = pe_parse_dos_header("x");
    if pe_parse_a.is_ok() != pe_parse_b.is_ok() {
        println("FAIL pe_parse");
        process_exit(1);
    }
    println("prod_ap_pe_parse: PASSED");
}
