// # Product prove std/crypto/pbkdf2.oo
//
// Logline: Fail-closed emit+gcc+run asserts pbkdf2 is a real value.
//
// Setup: Isolated emit-c. Imports std/crypto/pbkdf2.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pbkdf2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pbkdf2: PASSED only if they match.

import "std/crypto/pbkdf2.oo";

pub fn main() {
    let g2_a = pbkdf2("x", "x", 2, 8);
    let g2_b = pbkdf2("x", "x", 2, 8);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL pbkdf2");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL pbkdf2");
        process_exit(1);
    }
    println("prod_g2_pbkdf2: PASSED");
}
