// # Product prove std/compilers/elf_linker.oo
//
// Logline: Fail-closed verification that ELF static linker configuration, section and symbol registration, and layout computation are deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_linker.oo.
//
// Beats:
//   1. Configure ELF linker state with default x86_64 target configuration.
//   2. Register text and data sections and calculate layout offsets.
//   3. Register ELF symbols and perform layout resolution.
//   4. Print prod_g4_compilers_elf_linker: PASSED and exit 0.

import "std/compilers/elf_linker.oo";

pub fn main() {
    let cfg1: ElfLinkerConfig = elf_linker_config_default();
    let cfg2: ElfLinkerConfig = elf_linker_config_default();
    if (cfg1).target_arch != (cfg2).target_arch || (cfg1).page_size != 4096 {
        println("FAIL elf_linker_config_default");
        process_exit(1);
    }

    let mut state1: ElfLinkerState = elf_linker_init(cfg1);
    let mut state2: ElfLinkerState = elf_linker_init(cfg2);
    if (state1).total_size != (state2).total_size || (state1).total_size != 64 {
        println("FAIL elf_linker_init");
        process_exit(1);
    }

    let sec_text: ElfSection64 = elf_section64_text(100, 4194304);
    let sec_data: ElfSection64 = elf_section64_data(50, 4194404);

    state1 = elf_linker_add_section(state1, sec_text);
    state1 = elf_linker_add_section(state1, sec_data);
    state2 = elf_linker_add_section(state2, sec_text);
    state2 = elf_linker_add_section(state2, sec_data);

    if (state1).section_count != (state2).section_count || (state1).section_count != 2 {
        println("FAIL elf_linker_add_section count");
        process_exit(1);
    }

    if (state1).total_size != (state2).total_size || (state1).total_size != 214 {
        println("FAIL elf_linker_add_section size");
        process_exit(1);
    }

    let sym_main: ElfSymbol64 = elf_symbol64_function(1, 1, 4194304, 32);
    state1 = elf_linker_add_symbol(state1, sym_main);
    state2 = elf_linker_add_symbol(state2, sym_main);

    if (state1).symbol_count != (state2).symbol_count || (state1).symbol_count != 1 {
        println("FAIL elf_linker_add_symbol");
        process_exit(1);
    }

    let sz1: Int = elf_linker_resolve_and_layout(&mut state1);
    let sz2: Int = elf_linker_resolve_and_layout(&mut state2);
    if sz1 != sz2 || sz1 != 214 || !(state1).is_linked || !(state2).is_linked {
        println("FAIL elf_linker_resolve_and_layout");
        process_exit(1);
    }

    println("prod_g4_compilers_elf_linker: PASSED");
    process_exit(0);
}
