// # Product prove std/fintech/greeks_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts greeks_calc_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fintech/greeks_calc.oo.
//
// Beats:
//   1. Call greeks_calc_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_greeks_calc: PASSED only if it matches.

import "std/fintech/greeks_calc.oo";

pub fn main() {
    let a: Int = greeks_calc_probe();
    if a != 0 {
        println("FAIL greeks_calc_probe");
        process_exit(1);
    }
    println("prod_nc_greeks_calc: PASSED");
}
