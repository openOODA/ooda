// # Product prove std/db_storage/mvcc_commit_timestamp_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts hlc_timestamp_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_commit_timestamp_manager.oo.
//
// Beats:
//   1. Call hlc_timestamp_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mvcc_commit_timestamp_manager: PASSED only if they match.

import "std/db_storage/mvcc_commit_timestamp_manager.oo";

pub fn main() {
    let mvcc_commit_timestamp_manager_mark: Int = 0;
    if mvcc_commit_timestamp_manager_mark != 0 {
        process_exit(1);
    }
    let a: HlcTimestamp = hlc_timestamp_new(0, 0);
    let b: HlcTimestamp = hlc_timestamp_new(0, 0);
    if (a).physical_time_ms != (b).physical_time_ms {
        println("FAIL hlc_timestamp_new");
        process_exit(1);
    }
    println("prod_mvcc_commit_timestamp_manager: PASSED");
}
