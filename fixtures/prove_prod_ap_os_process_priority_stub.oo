// # Product prove std/os/process_priority_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/process_priority_stub.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/process_priority_stub.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_process_priority_stub: PASSED only if they match.

import "std/os/process_priority_stub.oo";

pub fn main() {
    let process_priority_stub_a = priority_config_new(0, 0);
    let process_priority_stub_b = priority_config_new(0, 0);
    let process_priority_stub_va = priority_is_realtime_high(process_priority_stub_a);
    let process_priority_stub_vb = priority_is_realtime_high(process_priority_stub_b);
    if process_priority_stub_va != process_priority_stub_vb {
        println("FAIL process_priority_stub");
        process_exit(1);
    }
    println("prod_ap_process_priority_stub: PASSED");
}
