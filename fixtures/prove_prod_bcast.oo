// # Product sync broadcast channel prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/channel_broadcast.oo.
//
// Setup: Product std/sync/channel_broadcast.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New len 0. Subscribe pending 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/channel_broadcast.oo";

pub fn main() {
    let ch: BroadcastChannel = broadcast_new(8);
    let n: Int = broadcast_len(ch);
    if n != 0 {
        println("FAIL bcast len");
        process_exit(1);
    }
    let rx: BroadcastReceiver = broadcast_subscribe(ch);
    let p: Int = broadcast_pending_count(ch, rx);
    if p != 0 {
        println("FAIL bcast pending");
        process_exit(1);
    }
    if broadcast_has_pending(ch, rx) {
        println("FAIL bcast has");
        process_exit(1);
    }
    println("prod_bcast: PASSED");
}
