// # Product prove std/perf/semaphore.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/semaphore.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/semaphore.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_semaphore: PASSED only if they match.

import "std/perf/semaphore.oo";

pub fn main() {
    let semaphore_a = semaphore_create("x", 0, 0);
    let semaphore_b = semaphore_create("x", 0, 0);
    let semaphore_va = semaphore_available(semaphore_a);
    let semaphore_vb = semaphore_available(semaphore_b);
    if semaphore_va != semaphore_vb {
        println("FAIL semaphore");
        process_exit(1);
    }
    println("prod_ap_semaphore: PASSED");
}
