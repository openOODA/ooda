// # Try postfix on a Result
//
// Logline: Call a Result function with ? and print the Ok payload.
//
// Setup: OPEN-5 try floor. boom returns Ok.
//
// Beats:
//   1. Return Ok("yes").
//   2. Bind boom()?.
//   3. Print the payload.

pub fn boom() -> Result[String, String] {
    return Ok("yes");
}

pub fn main() {
    let y = boom()?;
    println(y);
}
