// # Product prove std/robot/slam_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts pose2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/slam_types.oo.
//
// Beats:
//   1. Call pose2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_slam_types: PASSED only if they match.

import "std/robot/slam_types.oo";

pub fn main() {
    let slam_types_mark: Int = 0;
    if slam_types_mark != 0 {
        process_exit(1);
    }
    let a: Pose2D = pose2d_new(0, 0, 0);
    let b: Pose2D = pose2d_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL pose2d_new");
        process_exit(1);
    }
    println("prod_slam_types: PASSED");
}
