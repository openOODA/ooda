// # Product prove std/astro_advanced/launch_abort_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/launch_abort_trajectory.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/launch_abort_trajectory.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_launch_abort_trajectory: PASSED only if they match.

import "std/astro_advanced/launch_abort_trajectory.oo";

pub fn main() {
    let launch_abort_trajectory_a = abort_mode();
    let launch_abort_trajectory_b = abort_mode();
    if launch_abort_trajectory_a != launch_abort_trajectory_b {
        println("FAIL launch_abort_trajectory");
        process_exit(1);
    }
    println("prod_ap_launch_abort_trajectory: PASSED");
}
