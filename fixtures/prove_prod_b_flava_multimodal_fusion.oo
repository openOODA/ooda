// # Product prove std/ai_multimodal/flava_multimodal_fusion.oo
//
// Logline: Fail-closed emit+gcc+run asserts flava_multimodal_fusion_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/flava_multimodal_fusion.oo.
//
// Beats:
//   1. Call flava_multimodal_fusion_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flava_multimodal_fusion: PASSED only if they match.

import "std/ai_multimodal/flava_multimodal_fusion.oo";

pub fn main() {
    let a = flava_multimodal_fusion_marker();
    let b = flava_multimodal_fusion_marker();
    if a != b {
        println("FAIL flava_multimodal_fusion_marker");
        process_exit(1);
    }
    println("prod_flava_multimodal_fusion: PASSED");
}
