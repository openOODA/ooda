// # Product prove std/iot_scada/opcua_data_value.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_status_good real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_data_value.oo.
//
// Beats:
//   1. Call opcua_status_good with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_opcua_data_value: PASSED only if the assert holds.

import "std/iot_scada/opcua_data_value.oo";

pub fn main() {
    let opcua_data_value_n: Int = opcua_status_good();
    if opcua_data_value_n != 0 {
        println("FAIL opcua_status_good");
        process_exit(1);
    }
    println("prod_opcua_data_value: PASSED");
}
