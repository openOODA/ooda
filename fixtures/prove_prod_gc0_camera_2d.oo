// # Product prove std/game_engine/camera_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_2d_set_target is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/camera_2d.oo.
//
// Beats:
//   1. Call camera_2d_set_target twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_camera_2d: PASSED only if they match.

import "std/game_engine/camera_2d.oo";

pub fn main() {
    let camera_2d_mark: Int = 0;
    if camera_2d_mark != 0 {
        process_exit(1);
    }
    let camera_2d_a = camera_2d_set_target(camera_2d_new(1.0, 1.0), 1.0, 1.0);
    let camera_2d_b = camera_2d_set_target(camera_2d_new(1.0, 1.0), 1.0, 1.0);
    if (camera_2d_a).x != (camera_2d_b).x {
        println("FAIL camera_2d_set_target");
        process_exit(1);
    }
    println("prod_camera_2d: PASSED");
}
