// # Product prove std/fin/aml_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/aml_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_aml_types: PASSED only if they match.

import "std/fin/aml_types.oo";

pub fn main() {
    let aml_types_a = aml_risk_new(0, 0, 0);
    let aml_types_b = aml_risk_new(0, 0, 0);
    let aml_types_va = aml_risk_score(aml_types_a);
    let aml_types_vb = aml_risk_score(aml_types_b);
    if aml_types_va != aml_types_vb {
        println("FAIL aml_types");
        process_exit(1);
    }
    println("prod_ap_aml_types: PASSED");
}
