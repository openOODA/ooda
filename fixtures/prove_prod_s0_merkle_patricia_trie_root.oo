// # Product prove std/zk_rollup/merkle_patricia_trie_root.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_encode_nibbles value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_root.oo.
//
// Beats:
//   1. Call mpt_encode_nibbles twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_merkle_patricia_trie_root: PASSED only if asserts hold.

import "std/zk_rollup/merkle_patricia_trie_root.oo";

pub fn main() {
    let merkle_patricia_trie_root_a: Int = mpt_encode_nibbles(0, 0);
    let merkle_patricia_trie_root_b: Int = mpt_encode_nibbles(0, 0);
    if merkle_patricia_trie_root_a != merkle_patricia_trie_root_b {
        println("FAIL mpt_encode_nibbles");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_root: PASSED");
}
