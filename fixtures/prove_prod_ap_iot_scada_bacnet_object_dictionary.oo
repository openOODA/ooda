// # Product prove std/iot_scada/bacnet_object_dictionary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/bacnet_object_dictionary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_object_dictionary.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bacnet_object_dictionary: PASSED only if they match.

import "std/iot_scada/bacnet_object_dictionary.oo";

pub fn main() {
    let bacnet_object_dictionary_a = bacnet_object_id_encode(0, 0);
    let bacnet_object_dictionary_b = bacnet_object_id_encode(0, 0);
    if bacnet_object_dictionary_a != bacnet_object_dictionary_b {
        println("FAIL bacnet_object_dictionary");
        process_exit(1);
    }
    println("prod_ap_bacnet_object_dictionary: PASSED");
}
