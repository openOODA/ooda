// # Product prove std/fin/aml_risk.oo
//
// Logline: Fail-closed emit+gcc+run asserts aml_risk_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_risk.oo.
//
// Beats:
//   1. Call aml_risk_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aml_risk: PASSED only if they match.

import "std/fin/aml_risk.oo";

pub fn main() {
    let aml_risk_mark: Int = 0;
    if aml_risk_mark != 0 {
        process_exit(1);
    }
    let aml_risk_a = aml_risk_init(1, 1, 1);
    let aml_risk_b = aml_risk_init(1, 1, 1);
    if (aml_risk_a).entity_id != (aml_risk_b).entity_id {
        println("FAIL aml_risk_init");
        process_exit(1);
    }
    println("prod_aml_risk: PASSED");
}
