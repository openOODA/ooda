// # Product vec3 reject prove
//
// Logline: Fail-closed emit+gcc+run of shipped vec3_reject.
//
// Setup: Product std/math/vector_rejection.oo. (1,1,0) reject (1,0,0) is (0,1,0).
//
// Beats:
//   1. Reject x is 0.0 and y is 1.0.
//   2. Exit 1 before PASSED on a miss.

import "std/math/vector_rejection.oo";

pub fn main() {
    let u: Vec3 = vec3_new(1.0, 1.0, 0.0);
    let v: Vec3 = vec3_new(1.0, 0.0, 0.0);
    let r: Vec3 = vec3_reject(u, v);
    let rx: Float = vec3_get_x(r);
    let ry: Float = vec3_get_y(r);
    if rx != 0.0 {
        println("FAIL reject x");
        process_exit(1);
    }
    if ry != 1.0 {
        println("FAIL reject y");
        process_exit(1);
    }
    println("prod_reject: PASSED");
}
