// # Product prove std/exploit_analysis/stack_canary_leak_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_canary_new_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/stack_canary_leak_analyzer.oo.
//
// Beats:
//   1. Call stack_canary_new_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stack_canary_leak_analyzer: PASSED only if they match.

import "std/exploit_analysis/stack_canary_leak_analyzer.oo";

pub fn main() {
    let a: StackCanaryValue = stack_canary_new_64(0);
    let b: StackCanaryValue = stack_canary_new_64(0);
    if a.raw_canary_value != b.raw_canary_value {
        println("FAIL stack_canary_new_64");
        process_exit(1);
    }
    println("prod_stack_canary_leak_analyzer: PASSED");
}
