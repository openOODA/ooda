// # Product prove std/markup/msgpack.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/msgpack.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/msgpack.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_msgpack: PASSED only if they match.

import "std/markup/msgpack.oo";

pub fn main() {
    let msgpack_a = msgpack_encode_nil();
    let msgpack_b = msgpack_encode_nil();
    if list_len(msgpack_a) != list_len(msgpack_b) {
        println("FAIL msgpack");
        process_exit(1);
    }
    println("prod_ap_msgpack: PASSED");
}
