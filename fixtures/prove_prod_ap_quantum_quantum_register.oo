// # Product prove std/quantum/quantum_register.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum/quantum_register.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/quantum_register.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_register: PASSED only if they match.

import "std/quantum/quantum_register.oo";

pub fn main() {
    let quantum_register_a = int_pow2(0);
    let quantum_register_b = int_pow2(0);
    if quantum_register_a != quantum_register_b {
        println("FAIL quantum_register");
        process_exit(1);
    }
    println("prod_ap_quantum_register: PASSED");
}
