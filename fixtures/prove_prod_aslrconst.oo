//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/aslr_const.oo";

pub fn main() {
    let a: Int = aslr_mode_disabled();
    if a != 0 {
        println("FAIL aslr dis");
        process_exit(1);
    }
    let b: Int = aslr_mode_full();
    if b != 3 {
        println("FAIL aslr full");
        process_exit(1);
    }
    let c: Int = aslr_violation_pie_disabled();
    if c != 4 {
        println("FAIL aslr pie");
        process_exit(1);
    }
    println("prod_aslrconst: PASSED");
}
