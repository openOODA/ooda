// # Product prove std/db_storage/mvcc_snapshot_isolation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/mvcc_snapshot_isolation.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_storage/mvcc_snapshot_isolation.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_mvcc_snapshot_isolation: PASSED only if they match.

import "std/db_storage/mvcc_snapshot_isolation.oo";

pub fn main() {
    let mvcc_snapshot_isolation_a = snapshot_descriptor_create(0, 0, 0, list_new());
    let mvcc_snapshot_isolation_b = snapshot_descriptor_create(0, 0, 0, list_new());
    if mvcc_snapshot_isolation_a.snapshot_tx_id != mvcc_snapshot_isolation_b.snapshot_tx_id {
        println("FAIL mvcc_snapshot_isolation");
        process_exit(1);
    }
    println("prod_ap_mvcc_snapshot_isolation: PASSED");
}
