// # Product prove std/exploit_analysis/buffer_overflow_offset_finder.oo
//
// Logline: Fail-closed emit+gcc+run asserts cyclic_calculate_payload_padding is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/buffer_overflow_offset_finder.oo.
//
// Beats:
//   1. Call cyclic_calculate_payload_padding twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_buffer_overflow_offset_finder: PASSED only if they match.

import "std/exploit_analysis/buffer_overflow_offset_finder.oo";

pub fn main() {
    let buffer_overflow_offset_finder_mark: Int = 0;
    if buffer_overflow_offset_finder_mark != 0 {
        process_exit(1);
    }
    let a: Int = cyclic_calculate_payload_padding(0, 0);
    let b: Int = cyclic_calculate_payload_padding(0, 0);
    if a != b {
        println("FAIL cyclic_calculate_payload_padding");
        process_exit(1);
    }
    println("prod_buffer_overflow_offset_finder: PASSED");
}
