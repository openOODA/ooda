// # Refuse secret tcp_write payload
//
// Logline: Pass a secret IDENT as the tcp_write payload so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call tcp_write with token as the payload.
//   3. Print 1 after the call.
//
// T2 peer1 args: tcp_write(net, slot, secret) payload must refuse
// SECRET: token
pub fn main(net: &NetCap) {
    let token = "s3cret-payload";
    let slot = 0;
    let r = tcp_write(net, slot, token);
    println(1);
}
