// # Product prove std/uav_flight/uav_motor_esc_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts motor_esc_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_motor_esc_dynamics.oo.
//
// Beats:
//   1. Call motor_esc_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_motor_esc_dynamics: PASSED only if they match.

import "std/uav_flight/uav_motor_esc_dynamics.oo";

pub fn main() {
    let a: MotorEscParams = motor_esc_params_default();
    let b: MotorEscParams = motor_esc_params_default();
    if a.kv_rpm_per_v != b.kv_rpm_per_v {
        println("FAIL motor_esc_params_default");
        process_exit(1);
    }
    println("prod_uav_motor_esc_dynamics: PASSED");
}
