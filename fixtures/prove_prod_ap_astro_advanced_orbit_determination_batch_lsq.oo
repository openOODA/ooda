import "std/astro_advanced/orbit_determination_batch_lsq.oo";

pub fn main() {
    let orbit_determination_batch_lsq_a = od_lsq_obs();
    let orbit_determination_batch_lsq_b = od_lsq_obs();
    if orbit_determination_batch_lsq_a != orbit_determination_batch_lsq_b {
        println("FAIL orbit_determination_batch_lsq");
        process_exit(1);
    }
