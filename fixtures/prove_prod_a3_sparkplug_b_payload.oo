// # Product prove std/iot_scada/sparkplug_b_payload.oo
//
// Logline: Fail-closed emit+gcc+run asserts sparkplug_next_seq is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/sparkplug_b_payload.oo.
//
// Beats:
//   1. Call sparkplug_next_seq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparkplug_b_payload: PASSED only if they match.

import "std/iot_scada/sparkplug_b_payload.oo";

pub fn main() {
    let sparkplug_b_payload_mark: Int = 0;
    if sparkplug_b_payload_mark != 0 {
        process_exit(1);
    }
    let a: Int = sparkplug_next_seq(0);
    let b: Int = sparkplug_next_seq(0);
    if a != b {
        println("FAIL sparkplug_next_seq");
        process_exit(1);
    }
    println("prod_sparkplug_b_payload: PASSED");
}
