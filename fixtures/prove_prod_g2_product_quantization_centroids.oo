// # Product prove std/db_vector_ann/product_quantization_centroids.oo
//
// Logline: Fail-closed emit+gcc+run asserts pq_codebook_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/product_quantization_centroids.oo.
//
// Beats:
//   1. Call pq_codebook_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_product_quantization_centroids: PASSED only if they match.

import "std/db_vector_ann/product_quantization_centroids.oo";

pub fn main() {
    let product_quantization_centroids_mark: Int = 0;
    if product_quantization_centroids_mark != 0 {
        process_exit(1);
    }
    let a: PqCodebookConfig = pq_codebook_config_new(0, 0);
    let b: PqCodebookConfig = pq_codebook_config_new(0, 0);
    if (a).total_dimension != (b).total_dimension {
        println("FAIL pq_codebook_config_new");
        process_exit(1);
    }
    println("prod_g2_product_quantization_centroids: PASSED");
}
