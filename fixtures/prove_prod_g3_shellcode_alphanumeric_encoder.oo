// # Product prove std/exploit_analysis/shellcode_alphanumeric_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts is_ascii_alphanumeric is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/shellcode_alphanumeric_encoder.oo.
//
// Beats:
//   1. Call is_ascii_alphanumeric twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shellcode_alphanumeric_encoder: PASSED only if they match.

import "std/exploit_analysis/shellcode_alphanumeric_encoder.oo";

pub fn main() {
    let shellcode_alphanumeric_encoder_mark: Int = 0;
    if shellcode_alphanumeric_encoder_mark != 0 {
        process_exit(1);
    }
    let a: Bool = is_ascii_alphanumeric(0);
    let b: Bool = is_ascii_alphanumeric(0);
    if a != b {
        println("FAIL is_ascii_alphanumeric");
        process_exit(1);
    }
    println("prod_shellcode_alphanumeric_encoder: PASSED");
}
