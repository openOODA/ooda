// # Product prove std/security_defense/secure_zeroization_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/secure_zeroization_verifier.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/security_defense/secure_zeroization_verifier.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_secure_zeroization_verifier: PASSED only if they match.

import "std/security_defense/secure_zeroization_verifier.oo";

pub fn main() {
    let secure_zeroization_verifier_a = audit_memory_zeroization(list_new(), 0);
    let secure_zeroization_verifier_b = audit_memory_zeroization(list_new(), 0);
    if secure_zeroization_verifier_a.total_bytes_checked != secure_zeroization_verifier_b.total_bytes_checked {
        println("FAIL secure_zeroization_verifier");
        process_exit(1);
    }
    println("prod_ap_secure_zeroization_verifier: PASSED");
}
