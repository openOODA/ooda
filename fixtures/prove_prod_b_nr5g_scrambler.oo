// # Product prove std/telecom_5g/nr5g_scrambler.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_scrambler_cinit_pdsch is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_scrambler.oo.
//
// Beats:
//   1. Call nr5g_scrambler_cinit_pdsch twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nr5g_scrambler: PASSED only if they match.

import "std/telecom_5g/nr5g_scrambler.oo";

pub fn main() {
    let a = nr5g_scrambler_cinit_pdsch(0, 0, 0);
    let b = nr5g_scrambler_cinit_pdsch(0, 0, 0);
    if a != b {
        println("FAIL nr5g_scrambler_cinit_pdsch");
        process_exit(1);
    }
    println("prod_nr5g_scrambler: PASSED");
}
