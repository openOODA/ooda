// # Product prove std/media_dsp/synth_chorus_flanger_mod.oo
//
// Logline: Fail-closed emit+gcc+run asserts chorus_current_delay_samples is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_chorus_flanger_mod.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chorus_current_delay_samples twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_synth_chorus_flanger_mod: PASSED only if they match.

import "std/media_dsp/synth_chorus_flanger_mod.oo";

pub fn main() {
    let g0_oa: ChorusVoice = ChorusVoice { base_delay_ms: 0.0, depth_ms: 0.0, lfo_rate_hz: 0.0, lfo_phase: 0.0, feedback: 0.0 };
    let g0_ob: ChorusVoice = ChorusVoice { base_delay_ms: 0.0, depth_ms: 0.0, lfo_rate_hz: 0.0, lfo_phase: 0.0, feedback: 0.0 };
    let g0_a = chorus_current_delay_samples(&g0_oa, 0.0, 0.0);
    let g0_b = chorus_current_delay_samples(&g0_ob, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL chorus_current_delay_samples");
        process_exit(1);
    }
    println("prod_gr_synth_chorus_flanger_mod: PASSED");
}
