// # Product prove std/web_ecosystem/zod_array_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_array is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_array_schema.oo.
//
// Beats:
//   1. Call zod_array twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zod_array_schema: PASSED only if they match.

import "std/web_ecosystem/zod_array_schema.oo";

pub fn main() {
    let zod_array_schema_mark: Int = 0;
    if zod_array_schema_mark != 0 {
        process_exit(1);
    }
    let a: ZodArraySchema = zod_array();
    let b: ZodArraySchema = zod_array();
    if (a).min_items != (b).min_items {
        println("FAIL zod_array");
        process_exit(1);
    }
    println("prod_zod_array_schema: PASSED");
}
