// # Product prove std/bio/dna.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/dna.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/dna.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dna: PASSED only if they match.

import "std/bio/dna.oo";

pub fn main() {
    let dna_a = int_abs(0);
    let dna_b = int_abs(0);
    if dna_a != dna_b {
        println("FAIL dna");
        process_exit(1);
    }
    println("prod_ap_dna: PASSED");
}
