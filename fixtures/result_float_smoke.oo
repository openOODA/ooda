// # Result[Float] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[Float, String] Ok payload as Float.
//
// Setup: Backend-C. Ok(1.5) must stay Float, not oo_int_to_str.
//
// Beats:
//   1. f returns Ok(1.5).
//   2. Match binds n as Float; range n > 1.4 && n < 1.6.
//   3. Exit 1 before PASSED on a miss.

pub fn f() -> Result[Float, String] {
    return Ok(1.5);
}

pub fn main() {
    let r: Result[Float, String] = f();
    let n: Float = match r {
        Ok(v) => v,
        Err(e) => 0.0
    };
    if !(n > 1.4 && n < 1.6) {
        println("FAIL");
        process_exit(1);
    }
    println("result_float_smoke: PASSED");
}
