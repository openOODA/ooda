// # Product prove std/web_ecosystem/zod_object_schema.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_object_missing value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_object_schema.oo.
//
// Beats:
//   1. Call zod_object_missing twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_zod_object_schema: PASSED only if asserts hold.

import "std/web_ecosystem/zod_object_schema.oo";

pub fn main() {
    let zod_object_schema_a: Int = zod_object_missing(1, 1);
    let zod_object_schema_b: Int = zod_object_missing(1, 1);
    if zod_object_schema_a != zod_object_schema_b {
        println("FAIL zod_object_missing");
        process_exit(1);
    }
    println("prod_zod_object_schema: PASSED");
}
