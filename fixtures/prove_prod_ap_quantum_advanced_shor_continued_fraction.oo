// # Product prove std/quantum_advanced/shor_continued_fraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/shor_continued_fraction.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_continued_fraction.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_shor_continued_fraction: PASSED only if they match.

import "std/quantum_advanced/shor_continued_fraction.oo";

pub fn main() {
    let shor_continued_fraction_a = gcd(0, 0);
    let shor_continued_fraction_b = gcd(0, 0);
    if shor_continued_fraction_a != shor_continued_fraction_b {
        println("FAIL shor_continued_fraction");
        process_exit(1);
    }
    println("prod_ap_shor_continued_fraction: PASSED");
}
