// # Product prove std/formal_verif/k_induction_invariant_prover.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/k_induction_invariant_prover.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/k_induction_invariant_prover.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_k_induction_invariant_prover: PASSED only if they match.

import "std/formal_verif/k_induction_invariant_prover.oo";

pub fn main() {
    let k_induction_invariant_prover_a = k_induction_build_step_query(0, "x");
    let k_induction_invariant_prover_b = k_induction_build_step_query(0, "x");
    if k_induction_invariant_prover_a.contains(k_induction_invariant_prover_b) == false {
        println("FAIL k_induction_invariant_prover");
        process_exit(1);
    }
    if k_induction_invariant_prover_b.contains(k_induction_invariant_prover_a) == false {
        println("FAIL k_induction_invariant_prover");
        process_exit(1);
    }
    println("prod_ap_k_induction_invariant_prover: PASSED");
}
