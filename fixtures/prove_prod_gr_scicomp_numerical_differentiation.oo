// # Product prove std/scicomp/numerical_differentiation.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_forward_1d is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/numerical_differentiation.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call diff_forward_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_numerical_differentiation: PASSED only if they match.

import "std/scicomp/numerical_differentiation.oo";

pub fn main() {
    let g0_a = diff_forward_1d(0.0, 0.0, 0.0);
    let g0_b = diff_forward_1d(0.0, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL diff_forward_1d");
        process_exit(1);
    }
    println("prod_gr_numerical_differentiation: PASSED");
}
