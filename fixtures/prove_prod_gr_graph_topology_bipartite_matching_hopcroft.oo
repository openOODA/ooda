// # Product prove std/graph_topology/bipartite_matching_hopcroft.oo
//
// Logline: Fail-closed emit+gcc+run asserts bipartite_matching_hopcroft_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/bipartite_matching_hopcroft.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call bipartite_matching_hopcroft_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_bipartite_matching_hopcroft: PASSED only if they match.

import "std/graph_topology/bipartite_matching_hopcroft.oo";

pub fn main() {
    let g0_a = bipartite_matching_hopcroft_probe();
    let g0_b = bipartite_matching_hopcroft_probe();
    if g0_a != g0_b {
        println("FAIL bipartite_matching_hopcroft_probe");
        process_exit(1);
    }
    println("prod_gr_bipartite_matching_hopcroft: PASSED");
}
