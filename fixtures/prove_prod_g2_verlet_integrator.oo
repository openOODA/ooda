// # Product prove std/physics/verlet_integrator.oo
//
// Logline: Fail-closed emit+gcc+run asserts verlet_integrator_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/verlet_integrator.oo.
//
// Beats:
//   1. Call verlet_integrator_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_verlet_integrator: PASSED only if they match.

import "std/physics/verlet_integrator.oo";

pub fn main() {
    let a: VerletIntegratorState = verlet_integrator_default();
    let b: VerletIntegratorState = verlet_integrator_default();
    if (a).substeps != (b).substeps {
        println("FAIL verlet_integrator_default");
        process_exit(1);
    }
    println("prod_g2_verlet_integrator: PASSED");
}
