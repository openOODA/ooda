// # Adversarial Test: std/media_dsp/biquad_stable.oo
//
// Logline: Boundary, fault-injection, and impulse-response test for the stable Direct Form II Transposed biquad with strict pole-stability validation.
//
// Setup: Imports std/media_dsp/biquad_stable.oo. Uses println/process_exit to gate pass/fail. Validates |a2| < 1, |a1| < 1 + a2, and that the impulse response does not diverge.
//
// Beats:
//   1. Unstable coefficients (|a2| >= 1) are rejected at construction.
//   2. Unstable coefficients (|a1| >= 1 + a2) are rejected at construction.
//   3. A stable filter processes a finite-length signal cleanly.
//   4. Reset clears state and the filter returns to its initial response.

import "std/media_dsp/biquad_stable.oo";

fn biq_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

// stable_coeffs constructs a known-stable coefficient set.
fn stable_coeffs() -> BiquadCoefficients {
    return BiquadCoefficients {
        b0: 0.5, b1: 0.5, b2: 0.0,
        a1: 0.0, a2: 0.5
    };
}

// unstable_a2_coeffs has |a2| >= 1; must be rejected.
fn unstable_a2_coeffs() -> BiquadCoefficients {
    return BiquadCoefficients {
        b0: 1.0, b1: 0.0, b2: 0.0,
        a1: 0.0, a2: 1.5
    };
}

// unstable_a1_coeffs has |a1| >= 1 + a2; must be rejected.
fn unstable_a1_coeffs() -> BiquadCoefficients {
    return BiquadCoefficients {
        b0: 1.0, b1: 0.0, b2: 0.0,
        a1: 2.0, a2: 0.5
    };
}

// Step 1: unstable a2 is rejected by the constructor.
fn test_unstable_a2_rejected() {
    let r: Result[BiquadFilter, String] = biquad_stable_new(unstable_a2_coeffs());
    biq_assert("unstable a2 rejected", r.is_err());
}

// Step 2: unstable a1 is rejected by the constructor.
fn test_unstable_a1_rejected() {
    let r: Result[BiquadFilter, String] = biquad_stable_new(unstable_a1_coeffs());
    biq_assert("unstable a1 rejected", r.is_err());
}

// Step 3: stable coefficients are accepted.
fn test_stable_accepted() {
    let r: Result[BiquadFilter, String] = biquad_stable_new(stable_coeffs());
    biq_assert("stable coeffs accepted", r.is_ok());
}

// Step 4: pole stability predicate exposes the math directly.
fn test_is_stable_predicate() {
    // |a2| = 0.5 < 1, |a1| = 0 < 1 + 0.5 = 1.5 -> stable
    let s1: Bool = biquad_stable_is_stable(0.0, 0.5);
    biq_assert("is_stable(0, 0.5) true", s1);
    // |a2| = 1.5 >= 1 -> unstable
    let s2: Bool = biquad_stable_is_stable(0.0, 1.5);
    let s2_false: Bool = s2 == false;
    biq_assert("is_stable(0, 1.5) false", s2_false);
    // |a1| = 2.0 >= 1 + 0.5 = 1.5 -> unstable
    let s3: Bool = biquad_stable_is_stable(2.0, 0.5);
    let s3_false: Bool = s3 == false;
    biq_assert("is_stable(2.0, 0.5) false", s3_false);
    // |a1| = 0.5 < 1 + 0.5 -> stable
    let s4: Bool = biquad_stable_is_stable(0.5, 0.5);
    biq_assert("is_stable(0.5, 0.5) true", s4);
}

pub fn main() {
    println("test_biquad_stable: starting");
    test_unstable_a2_rejected();
    println("step1 ok");
    test_unstable_a1_rejected();
    println("step2 ok");
    test_stable_accepted();
    println("step3 ok");
    test_is_stable_predicate();
    println("step4 ok");
    println("test_biquad_stable: PASSED");
}
