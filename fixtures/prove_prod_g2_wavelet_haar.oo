// # Product prove std/scicomp/wavelet_haar.oo
//
// Logline: Fail-closed emit+gcc+run asserts wavelet_haar_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/wavelet_haar.oo.
//
// Beats:
//   1. Call wavelet_haar_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wavelet_haar: PASSED only if they match.

import "std/scicomp/wavelet_haar.oo";

pub fn main() {
    let a: Int = wavelet_haar_probe();
    let b: Int = wavelet_haar_probe();
    if a != b {
        println("FAIL wavelet_haar_probe");
        process_exit(1);
    }
    println("prod_g2_wavelet_haar: PASSED");
}
