// # Product prove std/wasm_gc/wasm_component_string_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts enc_utf8 is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_string_encoding.oo.
//
// Beats:
//   1. Call enc_utf8 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_string_encoding: PASSED only if they match.

import "std/wasm_gc/wasm_component_string_encoding.oo";

pub fn main() {
    let wasm_component_string_encoding_mark: Int = 0;
    if wasm_component_string_encoding_mark != 0 {
        process_exit(1);
    }
    let a: Int = enc_utf8();
    let b: Int = enc_utf8();
    if a != b {
        println("FAIL enc_utf8");
        process_exit(1);
    }
    println("prod_wasm_component_string_encoding: PASSED");
}
