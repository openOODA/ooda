// # Product prove std/robotics_ros2/motion_prm_graph_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts prm_can_connect is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/motion_prm_graph_planner.oo.
//
// Beats:
//   1. Call prm_can_connect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_motion_prm_graph_planner: PASSED only if they match.

import "std/robotics_ros2/motion_prm_graph_planner.oo";

pub fn main() {
    let motion_prm_graph_planner_mark: Int = 0;
    if motion_prm_graph_planner_mark != 0 {
        process_exit(1);
    }
    let a: Bool = prm_can_connect(0.0, 0.0);
    let b: Bool = prm_can_connect(0.0, 0.0);
    if a != b {
        println("FAIL prm_can_connect");
        process_exit(1);
    }
    println("prod_g2_motion_prm_graph_planner: PASSED");
}
