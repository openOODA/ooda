// # Product prove std/quantum_tensor_nets/variational_mps_compression.oo
//
// Logline: Fail-closed emit+gcc+run asserts compression_frobenius_distance is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/variational_mps_compression.oo.
//
// Beats:
//   1. Call compression_frobenius_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_variational_mps_compression: PASSED only if they match.

import "std/quantum_tensor_nets/variational_mps_compression.oo";

pub fn main() {
    let variational_mps_compression_mark: Int = 0;
    if variational_mps_compression_mark != 0 {
        process_exit(1);
    }
    let a: Float = compression_frobenius_distance(0.0);
    let b: Float = compression_frobenius_distance(0.0);
    if a != b {
        println("FAIL compression_frobenius_distance");
        process_exit(1);
    }
    println("prod_g2_variational_mps_compression: PASSED");
}
