// # Product prove std/db_vector_ann/vector_l2_squared_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_l2_squared_distance is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_l2_squared_distance.oo.
//
// Beats:
//   1. Call compute_l2_squared_distance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_l2_squared_distance: PASSED only if they match.

import "std/db_vector_ann/vector_l2_squared_distance.oo";

pub fn main() {
    let vector_l2_squared_distance_mark: Int = 0;
    if vector_l2_squared_distance_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_l2_squared_distance(list_new(), list_new());
    let b: Int = compute_l2_squared_distance(list_new(), list_new());
    if a != b {
        println("FAIL compute_l2_squared_distance");
        process_exit(1);
    }
    println("prod_vector_l2_squared_distance: PASSED");
}
