// # Product prove std/defi_derivatives/stress_testing_scenarios.oo
//
// Logline: Fail-closed emit+gcc+run asserts stress_scenario_black_swan is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/stress_testing_scenarios.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call stress_scenario_black_swan twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_stress_testing_scenarios: PASSED only if they match.

import "std/defi_derivatives/stress_testing_scenarios.oo";

pub fn main() {
    let g2_oa: StressScenario = stress_scenario_black_swan();
    let g2_ob: StressScenario = stress_scenario_black_swan();
    let g2_a = (g2_oa).spot_shock_pct;
    let g2_b = (g2_ob).spot_shock_pct;
    if g2_a != g2_b {
        println("FAIL stress_scenario_black_swan.spot_shock_pct");
        process_exit(1);
    }
    println("prod_g2_stress_testing_scenarios: PASSED");
}
