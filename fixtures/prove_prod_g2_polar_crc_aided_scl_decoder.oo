// # Product prove std/telecom_6g/polar_crc_aided_scl_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts polar_path_penalty is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/polar_crc_aided_scl_decoder.oo.
//
// Beats:
//   1. Call polar_path_penalty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polar_crc_aided_scl_decoder: PASSED only if they match.

import "std/telecom_6g/polar_crc_aided_scl_decoder.oo";

pub fn main() {
    let polar_crc_aided_scl_decoder_mark: Int = 0;
    if polar_crc_aided_scl_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Float = polar_path_penalty(0.0, 0);
    let b: Float = polar_path_penalty(0.0, 0);
    if a != b {
        println("FAIL polar_path_penalty");
        process_exit(1);
    }
    println("prod_g2_polar_crc_aided_scl_decoder: PASSED");
}
