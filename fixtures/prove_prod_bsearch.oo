// # Product binary search prove
//
// Logline: Fail-closed emit+gcc+run of shipped binary_search_exact.
//
// Setup: Product std/collections/binary_search.oo. Sorted List[Int].
//
// Beats:
//   1. Search 5 in 1,3,5,7 is index 2.
//   2. Search 4 is Err.
//   3. Exit 1 before PASSED on a miss.

import "std/collections/binary_search.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 3);
    xs = list_push(xs, 5);
    xs = list_push(xs, 7);
    let idx: Int = binary_search_lower_bound(xs, 5);
    if idx != 2 {
        println("FAIL bsearch idx");
        process_exit(1);
    }
    let ins: Int = binary_search_lower_bound(xs, 4);
    if ins != 2 {
        println("FAIL bsearch insert");
        process_exit(1);
    }
    let up: Int = binary_search_upper_bound(xs, 5);
    if up != 3 {
        println("FAIL bsearch upper");
        process_exit(1);
    }
    println("prod_bsearch: PASSED");
}
