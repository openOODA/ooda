// # Product prove std/genomics_advanced/pangenome_variation_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts pangenome_variation_graph_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/pangenome_variation_graph.oo.
//
// Beats:
//   1. Call pangenome_variation_graph_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pangenome_variation_graph: PASSED only if it matches.

import "std/genomics_advanced/pangenome_variation_graph.oo";

pub fn main() {
    let a: Int = pangenome_variation_graph_probe();
    if a != 0 {
        println("FAIL pangenome_variation_graph_probe");
        process_exit(1);
    }
    println("prod_nc_pangenome_variation_graph: PASSED");
}
