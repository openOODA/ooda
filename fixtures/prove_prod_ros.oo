// # Product prove std/robot/ros.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_qos_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/ros.oo.
//
// Beats:
//   1. Call shim_marker_qos_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros: PASSED only if they match.

import "std/robot/ros.oo";

pub fn main() {
    let ros_mark: Int = 0;
    if ros_mark != 0 {
        process_exit(1);
    }
    let a: QosProfile = shim_marker_qos_default();
    let b: QosProfile = shim_marker_qos_default();
    if (a).reliability != (b).reliability {
        println("FAIL shim_marker_qos_default");
        process_exit(1);
    }
    println("prod_ros: PASSED");
}
