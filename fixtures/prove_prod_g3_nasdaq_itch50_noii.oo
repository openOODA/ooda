// # Product prove std/fintech_l3_book/nasdaq_itch50_noii.oo
//
// Logline: Fail-closed emit+gcc+run asserts noii_compute_imbalance_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_noii.oo.
//
// Beats:
//   1. Call noii_compute_imbalance_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nasdaq_itch50_noii: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_noii.oo";

pub fn main() {
    let nasdaq_itch50_noii_mark: Int = 0;
    if nasdaq_itch50_noii_mark != 0 {
        process_exit(1);
    }
    let a: Float = noii_compute_imbalance_ratio(0, 0);
    let b: Float = noii_compute_imbalance_ratio(0, 0);
    if a != b {
        println("FAIL noii_compute_imbalance_ratio");
        process_exit(1);
    }
    println("prod_nasdaq_itch50_noii: PASSED");
}
