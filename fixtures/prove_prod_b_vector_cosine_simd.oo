// # Product prove std/db_storage/vector_cosine_simd.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_cosine_simd_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/vector_cosine_simd.oo.
//
// Beats:
//   1. Call vector_cosine_simd_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_cosine_simd: PASSED only if they match.

import "std/db_storage/vector_cosine_simd.oo";

pub fn main() {
    let a = vector_cosine_simd_probe();
    let b = vector_cosine_simd_probe();
    if a != b {
        println("FAIL vector_cosine_simd_probe");
        process_exit(1);
    }
    println("prod_vector_cosine_simd: PASSED");
}
