// # Product prove std/robotics_ros2/kinematics_inverse_jacobian_dls.oo
//
// Logline: Fail-closed emit+gcc+run asserts jacobian_2x2_new is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/kinematics_inverse_jacobian_dls.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call jacobian_2x2_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kinematics_inverse_jacobian_dls: PASSED only if they match.

import "std/robotics_ros2/kinematics_inverse_jacobian_dls.oo";

pub fn main() {
    let g2_oa: Jacobian2x2 = jacobian_2x2_new(1.0, 1.0, 1.0, 1.0);
    let g2_ob: Jacobian2x2 = jacobian_2x2_new(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).j11;
    let g2_b = (g2_ob).j11;
    if g2_a != g2_b {
        println("FAIL jacobian_2x2_new.j11");
        process_exit(1);
    }
    println("prod_g2_kinematics_inverse_jacobian_dls: PASSED");
}
