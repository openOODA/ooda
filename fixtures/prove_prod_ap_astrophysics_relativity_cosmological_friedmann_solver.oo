// # Product prove std/astrophysics_relativity/cosmological_friedmann_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/cosmological_friedmann_solver.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_friedmann_solver.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cosmological_friedmann_solver: PASSED only if they match.

import "std/astrophysics_relativity/cosmological_friedmann_solver.oo";

pub fn main() {
    let cosmological_friedmann_solver_a = friedmann_e_z(0, 0, 0, 0, 0);
    let cosmological_friedmann_solver_b = friedmann_e_z(0, 0, 0, 0, 0);
    if cosmological_friedmann_solver_a != cosmological_friedmann_solver_b {
        println("FAIL cosmological_friedmann_solver");
        process_exit(1);
    }
    println("prod_ap_cosmological_friedmann_solver: PASSED");
}
