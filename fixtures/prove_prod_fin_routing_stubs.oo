// # Product prove std/fin/routing_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts routing_solve_multi_venue_linear_opt is a fail-closed stub.
//
// Setup: Isolated emit-c. Imports std/fin/routing_stubs.oo.
//
// Beats:
//   1. Call routing_solve_multi_venue_linear_opt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_routing_stubs: PASSED only if they match.

import "std/fin/routing_stubs.oo";

pub fn main() {
    let fin_routing_stubs_mark: Int = 0;
    if fin_routing_stubs_mark != 0 {
        process_exit(1);
    }
    let a: OrderRoute = routing_solve_multi_venue_linear_opt(SmartOrderRouter { ptr: 0, len: 0, cap: 0 }, "x", 1, 1);
    let b: OrderRoute = routing_solve_multi_venue_linear_opt(SmartOrderRouter { ptr: 0, len: 0, cap: 0 }, "x", 1, 1);
    if (a).qty != (b).qty {
        println("FAIL routing_solve_multi_venue_linear_opt");
        process_exit(1);
    }
    println("prod_routing_stubs: PASSED");
}
