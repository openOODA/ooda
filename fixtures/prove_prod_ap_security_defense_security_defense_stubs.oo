// # Product prove std/security_defense/security_defense_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/security_defense_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/security_defense_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_security_defense_stubs: PASSED only if they match.

import "std/security_defense/security_defense_stubs.oo";

pub fn main() {
    let security_defense_stubs_a = mock_is_security_test_suite_ready();
    let security_defense_stubs_b = mock_is_security_test_suite_ready();
    if security_defense_stubs_a != security_defense_stubs_b {
        println("FAIL security_defense_stubs");
        process_exit(1);
    }
    println("prod_ap_security_defense_stubs: PASSED");
}
