// # Product prove std/fin/orderbook_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts limit_order_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_types.oo.
//
// Beats:
//   1. Call limit_order_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orderbook_types: PASSED only if they match.

import "std/fin/orderbook_types.oo";

pub fn main() {
    let orderbook_types_mark: Int = 0;
    if orderbook_types_mark != 0 {
        process_exit(1);
    }
    let a: LimitOrder = limit_order_new(0, 0, 0);
    let b: LimitOrder = limit_order_new(0, 0, 0);
    if (a).order_id != (b).order_id {
        println("FAIL limit_order_new");
        process_exit(1);
    }
    println("prod_orderbook_types: PASSED");
}
