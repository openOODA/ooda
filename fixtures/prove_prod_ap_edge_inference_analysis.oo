// # Product prove std/edge/inference_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/inference_analysis.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_analysis.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_inference_analysis: PASSED only if they match.

import "std/edge/inference_analysis.oo";

pub fn main() {
    let inference_analysis_a = inference_select_optimal_backend(0, 0);
    let inference_analysis_b = inference_select_optimal_backend(0, 0);
    if inference_analysis_a != inference_analysis_b {
        println("FAIL inference_analysis");
        process_exit(1);
    }
    println("prod_ap_inference_analysis: PASSED");
}
