// # Quote and backslash println bytes
//
// Logline: Print a string with quotes and a backslash so escape and write length match.
//
// Setup: Token text is say "hi" \ok (12 bytes). Write length is 13 with newline.
//
// Beats:
//   1. Declare main.
//   2. Print the escaped string.
//   3. Expect mov x2, #13 and escaped .ascii.

pub fn main() {
    println("say \"hi\" \\ok");
}
