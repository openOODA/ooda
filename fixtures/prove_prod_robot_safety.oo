// # Product prove std/robot/safety.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_clamp_speed is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/safety.oo.
//
// Beats:
//   1. Call shim_marker_clamp_speed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_robot_safety: PASSED only if they match.

import "std/robot/safety.oo";

pub fn main() {
    let robot_safety_mark: Int = 0;
    if robot_safety_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_clamp_speed(5, 10);
    let b: Int = shim_marker_clamp_speed(5, 10);
    if a != b { process_exit(1); }
    println("prod_robot_safety: PASSED");
}
