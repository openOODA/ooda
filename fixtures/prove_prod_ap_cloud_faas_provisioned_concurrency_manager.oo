// # Product prove std/cloud_faas/provisioned_concurrency_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_faas/provisioned_concurrency_manager.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/provisioned_concurrency_manager.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_provisioned_concurrency_manager: PASSED only if they match.

import "std/cloud_faas/provisioned_concurrency_manager.oo";

pub fn main() {
    let provisioned_concurrency_manager_a = provisioned_concurrency_manager_new(0, 0);
    let provisioned_concurrency_manager_b = provisioned_concurrency_manager_new(0, 0);
    if provisioned_concurrency_manager_a.function_id != provisioned_concurrency_manager_b.function_id {
        println("FAIL provisioned_concurrency_manager");
        process_exit(1);
    }
    println("prod_ap_provisioned_concurrency_manager: PASSED");
}
