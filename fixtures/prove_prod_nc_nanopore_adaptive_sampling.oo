// # Product prove std/genomics_advanced/nanopore_adaptive_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_adaptive_sampling_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_adaptive_sampling.oo.
//
// Beats:
//   1. Call nanopore_adaptive_sampling_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_nanopore_adaptive_sampling: PASSED only if it matches.

import "std/genomics_advanced/nanopore_adaptive_sampling.oo";

pub fn main() {
    let a: Int = nanopore_adaptive_sampling_probe();
    if a != 0 {
        println("FAIL nanopore_adaptive_sampling_probe");
        process_exit(1);
    }
    println("prod_nc_nanopore_adaptive_sampling: PASSED");
}
