// # Product prove std/sync/condvar.oo
//
// Logline: Fail-closed emit+gcc+run asserts condvar_wait_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/condvar.oo.
//
// Beats:
//   1. Call condvar_wait_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_condvar: PASSED only if they match.

import "std/sync/condvar.oo";

pub fn main() {
    let obj = condvar_new(0);
    let a = condvar_wait_count(obj);
    let b = condvar_wait_count(obj);
    if a != b {
        println("FAIL condvar_wait_count");
        process_exit(1);
    }
    println("prod_condvar: PASSED");
}
