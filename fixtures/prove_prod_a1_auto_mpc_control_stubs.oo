// # Product prove std/auto_mpc_control/auto_mpc_control_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts auto_hal_steer_write_stub is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/auto_mpc_control_stubs.oo.
//
// Beats:
//   1. Call auto_hal_steer_write_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_auto_mpc_control_stubs: PASSED only if they match.

import "std/auto_mpc_control/auto_mpc_control_stubs.oo";

pub fn main() {
    let auto_mpc_control_stubs_mark: Int = 0;
    if auto_mpc_control_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = auto_hal_steer_write_stub(0.0, true);
    let b: Int = auto_hal_steer_write_stub(0.0, true);
    if a != b {
        println("FAIL auto_hal_steer_write_stub");
        process_exit(1);
    }
    println("prod_auto_mpc_control_stubs: PASSED");
}
