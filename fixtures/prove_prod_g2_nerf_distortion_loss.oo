// # Product prove std/nerf_3dgs/nerf_distortion_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts distortion_loss_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_distortion_loss.oo.
//
// Beats:
//   1. Call distortion_loss_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nerf_distortion_loss: PASSED only if they match.

import "std/nerf_3dgs/nerf_distortion_loss.oo";

pub fn main() {
    let nerf_distortion_loss_mark: Int = 0;
    if nerf_distortion_loss_mark != 0 {
        process_exit(1);
    }
    let a: Float = distortion_loss_pair(0.0, 0.0, 0.0, 0.0);
    let b: Float = distortion_loss_pair(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL distortion_loss_pair");
        process_exit(1);
    }
    println("prod_g2_nerf_distortion_loss: PASSED");
}
