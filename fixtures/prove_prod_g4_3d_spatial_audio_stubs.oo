// # Product prove std/3d/spatial_audio_stubs.oo
//
// Logline: Fail-closed verification that spatial audio stub module and AudioSource data structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/spatial_audio_stubs.oo.
//
// Beats:
//   1. Construct AudioSource instances with spatial coordinates and volume.
//   2. Read and verify volume and position fields.
//   3. Print prod_g4_3d_spatial_audio_stubs: PASSED only if all match.

import "std/3d/spatial_audio_stubs.oo";

pub fn main() {
    let src1: AudioSource = audio_source_new(10, 20, 30, 85);
    let src2: AudioSource = audio_source_new(10, 20, 30, 85);
    if (src1).x != (src2).x || (src1).y != (src2).y || (src1).z != (src2).z {
        println("FAIL audio_source_new coordinates");
        process_exit(1);
    }

    let vol1: Int = audio_source_volume(src1);
    let vol2: Int = audio_source_volume(src2);
    if vol1 != vol2 || vol1 != 85 {
        println("FAIL audio_source_volume");
        process_exit(1);
    }

    let src_quiet: AudioSource = audio_source_new(0, 0, 0, 0);
    let vol_quiet: Int = audio_source_volume(src_quiet);
    if vol_quiet != 0 {
        println("FAIL audio_source_volume quiet");
        process_exit(1);
    }

    println("prod_g4_3d_spatial_audio_stubs: PASSED");
    process_exit(0);
}
