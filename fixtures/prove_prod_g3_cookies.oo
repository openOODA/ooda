// # Product prove std/net/cookies.oo
//
// Logline: Fail-closed emit+gcc+run asserts cookie_parse_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/cookies.oo.
//
// Beats:
//   1. Call cookie_parse_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cookies: PASSED only if they match.

import "std/net/cookies.oo";

pub fn main() {
    let cookies_mark: Int = 0;
    if cookies_mark != 0 {
        process_exit(1);
    }
    let a: String = cookie_parse_name("x");
    let b: String = cookie_parse_name("x");
    if a != b {
        println("FAIL cookie_parse_name");
        process_exit(1);
    }
    println("prod_cookies: PASSED");
}
