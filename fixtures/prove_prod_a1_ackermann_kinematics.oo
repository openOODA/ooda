// # Product prove std/auto_robot/ackermann_kinematics.oo
//
// Logline: Fail-closed emit+gcc+run asserts ack_track_half is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/ackermann_kinematics.oo.
//
// Beats:
//   1. Call ack_track_half twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ackermann_kinematics: PASSED only if they match.

import "std/auto_robot/ackermann_kinematics.oo";

pub fn main() {
    let ackermann_kinematics_mark: Int = 0;
    if ackermann_kinematics_mark != 0 {
        process_exit(1);
    }
    let a: Int = ack_track_half(0);
    let b: Int = ack_track_half(0);
    if a != b {
        println("FAIL ack_track_half");
        process_exit(1);
    }
    println("prod_ackermann_kinematics: PASSED");
}
