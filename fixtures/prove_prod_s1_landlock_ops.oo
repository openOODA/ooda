// # Product prove std/sec/sys/landlock_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts access_rights_has_fs_permission is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/landlock_ops.oo.
//
// Beats:
//   1. Call access_rights_has_fs_permission twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_landlock_ops: PASSED only if they match.

import "std/sec/sys/landlock_ops.oo";

pub fn main() {
    let landlock_ops_mark: Int = 0;
    if landlock_ops_mark != 0 {
        process_exit(1);
    }
    let landlock_ops_a: Bool = access_rights_has_fs_permission(1, 1);
    let landlock_ops_b: Bool = access_rights_has_fs_permission(1, 1);
    if landlock_ops_a != landlock_ops_b {
        println("FAIL access_rights_has_fs_permission");
        process_exit(1);
    }
    println("prod_landlock_ops: PASSED");
}
