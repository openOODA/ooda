// # Product prove std/satellite_dvb/gnss_multipath_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts gnss_calc_code_minus_carrier_m is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_multipath_detector.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gnss_calc_code_minus_carrier_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_multipath_detector: PASSED only if they match.

import "std/satellite_dvb/gnss_multipath_detector.oo";

pub fn main() {
    let g2_a = gnss_calc_code_minus_carrier_m(1.0, 1.0, 1.0);
    let g2_b = gnss_calc_code_minus_carrier_m(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL gnss_calc_code_minus_carrier_m");
        process_exit(1);
    }
    println("prod_g2_gnss_multipath_detector: PASSED");
}
