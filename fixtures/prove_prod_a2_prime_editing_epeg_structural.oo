// # Product prove std/crispr_cas/prime_editing_epeg_structural.oo
//
// Logline: Fail-closed emit+gcc+run asserts epeg_get_motif_seq is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_epeg_structural.oo.
//
// Beats:
//   1. Call epeg_get_motif_seq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prime_editing_epeg_structural: PASSED only if they match.

import "std/crispr_cas/prime_editing_epeg_structural.oo";
import "std/str.oo";

pub fn main() {
    let prime_editing_epeg_structural_mark: Int = 0;
    if prime_editing_epeg_structural_mark != 0 {
        process_exit(1);
    }
    let a: String = epeg_get_motif_seq("x");
    let b: String = epeg_get_motif_seq("x");
    if str_eq(a, b) == false {
        println("FAIL epeg_get_motif_seq");
        process_exit(1);
    }
    println("prod_prime_editing_epeg_structural: PASSED");
}
