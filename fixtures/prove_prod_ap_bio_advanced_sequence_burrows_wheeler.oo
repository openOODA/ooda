// # Product prove std/bio_advanced/sequence_burrows_wheeler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/sequence_burrows_wheeler.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_burrows_wheeler.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sequence_burrows_wheeler: PASSED only if they match.

import "std/bio_advanced/sequence_burrows_wheeler.oo";

pub fn main() {
    let sequence_burrows_wheeler_a = bwt_char_count("x", "x");
    let sequence_burrows_wheeler_b = bwt_char_count("x", "x");
    if sequence_burrows_wheeler_a != sequence_burrows_wheeler_b {
        println("FAIL sequence_burrows_wheeler");
        process_exit(1);
    }
    println("prod_ap_sequence_burrows_wheeler: PASSED");
}
