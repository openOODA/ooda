// # Product prove std/formal_verif/concurrency_data_race_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts lockset_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/concurrency_data_race_detector.oo.
//
// Beats:
//   1. Call lockset_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_concurrency_data_race_detector: PASSED only if they match.

import "std/formal_verif/concurrency_data_race_detector.oo";

pub fn main() {
    let concurrency_data_race_detector_mark: Int = 0;
    if concurrency_data_race_detector_mark != 0 {
        process_exit(1);
    }
    let a: Lockset = lockset_empty();
    let b: Lockset = lockset_empty();
    if (a).count != (b).count {
        println("FAIL lockset_empty");
        process_exit(1);
    }
    println("prod_concurrency_data_race_detector: PASSED");
}
