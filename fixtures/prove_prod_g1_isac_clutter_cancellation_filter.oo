// # Product prove std/telecom_6g/isac_clutter_cancellation_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts mti_filter_config_3pulse is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_clutter_cancellation_filter.oo.
//
// Beats:
//   1. Call mti_filter_config_3pulse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isac_clutter_cancellation_filter: PASSED only if they match.

import "std/telecom_6g/isac_clutter_cancellation_filter.oo";

pub fn main() {
    let a: MtiFilterConfig = mti_filter_config_3pulse(0.0);
    let b: MtiFilterConfig = mti_filter_config_3pulse(0.0);
    if a.filter_order != b.filter_order {
        println("FAIL mti_filter_config_3pulse");
        process_exit(1);
    }
    println("prod_isac_clutter_cancellation_filter: PASSED");
}
