// # Product prove std/game_engine/particle_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts particle_emitter_new real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/particle_emitter.oo.
//
// Beats:
//   1. Call particle_emitter_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_particle_emitter: PASSED only if the assert holds.

import "std/game_engine/particle_emitter.oo";

pub fn main() {
    let particle_emitter_a: ParticleEmitter = particle_emitter_new(7, 2.0, 2.0, 2.0);
    let particle_emitter_emitter_id: Int = (particle_emitter_a).emitter_id;
    if particle_emitter_emitter_id != 7 {
        println("FAIL particle_emitter_new");
        process_exit(1);
    }
    println("prod_particle_emitter: PASSED");
}
