// # Product prove std/zk_rollup/rollup_validity_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts validity_proof_envelope_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_validity_proof.oo.
//
// Beats:
//   1. Call validity_proof_envelope_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_validity_proof: PASSED only if they match.

import "std/zk_rollup/rollup_validity_proof.oo";

pub fn main() {
    let rollup_validity_proof_mark: Int = 0;
    if rollup_validity_proof_mark != 0 {
        process_exit(1);
    }
    let rollup_validity_proof_a = validity_proof_envelope_new(1, 1, 1, 1, 1);
    let rollup_validity_proof_b = validity_proof_envelope_new(1, 1, 1, 1, 1);
    if (rollup_validity_proof_a).proof_system_tag != (rollup_validity_proof_b).proof_system_tag {
        println("FAIL validity_proof_envelope_new");
        process_exit(1);
    }
    println("prod_rollup_validity_proof: PASSED");
}
