// # Product prove std/cloud/circuit_breaker.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_breaker_get_state_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/circuit_breaker.oo.
//
// Beats:
//   1. Call circuit_breaker_get_state_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_circuit_breaker: PASSED only if they match.

import "std/cloud/circuit_breaker.oo";
import "std/str.oo";

pub fn main() {
    let a: String = circuit_breaker_get_state_name(0);
    let b: String = circuit_breaker_get_state_name(0);
    if str_eq(a, b) == false {
        println("FAIL circuit_breaker_get_state_name");
        process_exit(1);
    }
    println("prod_circuit_breaker: PASSED");
}
