import "std/iot_scada/dnp3_object_library.oo";

pub fn main() {
    let dnp3_object_library_a = dnp3_binary_input_new(0, true, 0);
    let dnp3_object_library_b = dnp3_binary_input_new(0, true, 0);
    if dnp3_object_library_a.point_index != dnp3_object_library_b.point_index {
        println("FAIL dnp3_object_library");
        process_exit(1);
