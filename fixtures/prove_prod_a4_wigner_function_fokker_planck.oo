// # Product prove std/quantum_open_systems/wigner_function_fokker_planck.oo
//
// Logline: Fail-closed emit+gcc+run asserts wigner_coherent_state_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/wigner_function_fokker_planck.oo.
//
// Beats:
//   1. Call wigner_coherent_state_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wigner_function_fokker_planck: PASSED only if they match.

import "std/quantum_open_systems/wigner_function_fokker_planck.oo";

pub fn main() {
    let wigner_function_fokker_planck_mark: Int = 0;
    if wigner_function_fokker_planck_mark != 0 {
        process_exit(1);
    }
    let a: Float = wigner_coherent_state_eval(0.0, 0.0, 0.0, 0.0);
    let b: Float = wigner_coherent_state_eval(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL wigner_coherent_state_eval");
        process_exit(1);
    }
    println("prod_wigner_function_fokker_planck: PASSED");
}
