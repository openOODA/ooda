// # Product prove std/bft_consensus/tendermint_block_part_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts block_part_set_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/tendermint_block_part_set.oo.
//
// Beats:
//   1. Call block_part_set_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tendermint_block_part_set: PASSED only if they match.

import "std/bft_consensus/tendermint_block_part_set.oo";

pub fn main() {
    let tendermint_block_part_set_mark: Int = 0;
    if tendermint_block_part_set_mark != 0 {
        process_exit(1);
    }
    let a: BlockPartSet = block_part_set_new(0, "x");
    let b: BlockPartSet = block_part_set_new(0, "x");
    if (a).received_count != (b).received_count {
        println("FAIL block_part_set_new");
        process_exit(1);
    }
    println("prod_tendermint_block_part_set: PASSED");
}
