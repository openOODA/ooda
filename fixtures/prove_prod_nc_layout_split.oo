// # Product prove std/tui/layout_split.oo
//
// Logline: Fail-closed emit+gcc+run asserts layout_split_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/tui/layout_split.oo.
//
// Beats:
//   1. Call layout_split_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_layout_split: PASSED only if it matches.

import "std/tui/layout_split.oo";

pub fn main() {
    let a: Int = layout_split_probe();
    if a != 0 {
        println("FAIL layout_split_probe");
        process_exit(1);
    }
    println("prod_nc_layout_split: PASSED");
}
