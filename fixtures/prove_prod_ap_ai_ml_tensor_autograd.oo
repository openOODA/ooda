// # Product prove std/ai_ml/tensor_autograd.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_ml/tensor_autograd.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tensor_autograd.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tensor_autograd: PASSED only if they match.

import "std/ai_ml/tensor_autograd.oo";

pub fn main() {
    let tensor_autograd_a = op_add();
    let tensor_autograd_b = op_add();
    if tensor_autograd_a != tensor_autograd_b {
        println("FAIL tensor_autograd");
        process_exit(1);
    }
    println("prod_ap_tensor_autograd: PASSED");
}
