// # emit-x86 const-int not-equal if
//
// Logline: If 1 is not 2 print yes else no so emit-x86 takes one harvestable arm.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the true != branch.
//   3. as+ld stdout is yes only.
//
// residual: if true/false stay later.

pub fn main() {
    if 1 != 2 {
        println("yes");
    } else {
        println("no");
    }
}
