// # Product prove std/satellite_dvb/gnss_multipath_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts gnss_calc_code_minus_carrier_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_multipath_detector.oo.
//
// Beats:
//   1. Call gnss_calc_code_minus_carrier_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gnss_multipath_detector: PASSED only if they match.

import "std/satellite_dvb/gnss_multipath_detector.oo";

pub fn main() {
    let gnss_multipath_detector_mark: Int = 0;
    if gnss_multipath_detector_mark != 0 {
        process_exit(1);
    }
    let a: Float = gnss_calc_code_minus_carrier_m(0.0, 0.0, 0.0);
    let b: Float = gnss_calc_code_minus_carrier_m(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL gnss_calc_code_minus_carrier_m");
        process_exit(1);
    }
    println("prod_g2_gnss_multipath_detector: PASSED");
}
