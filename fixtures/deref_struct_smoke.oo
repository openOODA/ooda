// # Deref field write emit lock
//
// Logline: Fail-closed emit+gcc+run of (*c).v write-through on &mut Cell.
//
// Setup: Backend-C. (*p).f must mutate the caller Cell.
//
// Beats:
//   1. Bind mut Cell v 10.
//   2. bump(&mut x) adds one via (*c).v.
//   3. Exit 1 before PASSED when x.v is not 11.

type Cell = struct {
    v: Int
};

pub fn bump(c: &mut Cell) {
    (*c).v = (*c).v + 1;
}

pub fn main() {
    let mut x = Cell { v: 10 };
    bump(&mut x);
    if x.v != 11 {
        println("FAIL");
        process_exit(1);
    }
    println("deref_struct_smoke: PASSED");
}
