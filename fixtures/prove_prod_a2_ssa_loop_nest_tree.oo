// # Product prove std/compilers_vm/ssa_loop_nest_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts loop_info_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_loop_nest_tree.oo.
//
// Beats:
//   1. Call loop_info_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ssa_loop_nest_tree: PASSED only if they match.

import "std/compilers_vm/ssa_loop_nest_tree.oo";

pub fn main() {
    let ssa_loop_nest_tree_mark: Int = 0;
    if ssa_loop_nest_tree_mark != 0 {
        process_exit(1);
    }
    let a: LoopInfo = loop_info_new(0, 0, 0);
    let b: LoopInfo = loop_info_new(0, 0, 0);
    if (a).loop_id != (b).loop_id {
        println("FAIL loop_info_new");
        process_exit(1);
    }
    println("prod_ssa_loop_nest_tree: PASSED");
}
