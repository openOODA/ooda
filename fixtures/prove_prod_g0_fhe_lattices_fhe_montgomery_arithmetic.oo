// # Product prove std/fhe_lattices/fhe_montgomery_arithmetic.oo
//
// Logline: Fail-closed emit+gcc+run asserts barrett_reduce is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_montgomery_arithmetic.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call barrett_reduce twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_montgomery_arithmetic: PASSED only if they match.

import "std/fhe_lattices/fhe_montgomery_arithmetic.oo";

pub fn main() {
    let g0_a = barrett_reduce(2, 2, 2, 2);
    let g0_b = barrett_reduce(2, 2, 2, 2);
    if g0_a != g0_b {
        println("FAIL barrett_reduce");
        process_exit(1);
    }
    println("prod_g0_fhe_montgomery_arithmetic: PASSED");
}
