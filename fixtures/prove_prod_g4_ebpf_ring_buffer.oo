// # Product prove std/mesh_ebpf/ebpf_map_ring_buffer.oo
//
// Logline: Fail-closed emit+gcc+run asserts eBPF ring buffer reserve, commit, and consume operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_map_ring_buffer.oo.
//
// Beats:
//   1. Initialize ring buffer with fixed capacity.
//   2. Reserve, commit, and consume telemetry event records.
//   3. Assert deterministic head/tail offsets and byte accounting.
//   4. Print prod_g4_ebpf_ring_buffer: PASSED and exit 0.

import "std/mesh_ebpf/ebpf_map_ring_buffer.oo";

pub fn main() {
    let mut rb: EbpfRingBuffer = ebpf_ring_buffer_new(4);
    if (rb).capacity != 4 {
        println("FAIL ebpf_ring_buffer_new capacity");
        process_exit(1);
    }
    if (rb).dropped_records != 0 {
        println("FAIL ebpf_ring_buffer_new dropped_records");
        process_exit(1);
    }

    let ok_res1: Bool = ebpf_ring_buffer_reserve(&mut rb, 101, 64, 12345);
    if !ok_res1 {
        println("FAIL ebpf_ring_buffer_reserve 1");
        process_exit(1);
    }

    let ok_commit: Bool = ebpf_ring_buffer_commit(&mut rb, 101);
    if !ok_commit {
        println("FAIL ebpf_ring_buffer_commit");
        process_exit(1);
    }
    if (rb).total_bytes_written != 64 {
        println("FAIL ebpf_ring_buffer total_bytes_written");
        process_exit(1);
    }

    let consumed: Int = ebpf_ring_buffer_consume(&mut rb);
    if consumed != 1 {
        println("FAIL ebpf_ring_buffer_consume");
        process_exit(1);
    }
    if (rb).tail != 1 {
        println("FAIL ebpf_ring_buffer tail");
        process_exit(1);
    }

    println("prod_g4_ebpf_ring_buffer: PASSED");
    process_exit(0);
}
