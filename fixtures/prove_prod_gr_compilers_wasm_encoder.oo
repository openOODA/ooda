// # Product prove std/compilers/wasm_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_buffer_size is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_encoder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wasm_buffer_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_wasm_encoder: PASSED only if they match.

import "std/compilers/wasm_encoder.oo";

pub fn main() {
    let g0_oa = wasm_buffer_new();
    let g0_ob = wasm_buffer_new();
    let g0_a = wasm_buffer_size(&g0_oa);
    let g0_b = wasm_buffer_size(&g0_ob);
    if g0_a != g0_b {
        println("FAIL wasm_buffer_size");
        process_exit(1);
    }
    println("prod_gr_wasm_encoder: PASSED");
}
