// # Product prove std/net_telemetry/pcap_reader.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcap_reader_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/pcap_reader.oo.
//
// Beats:
//   1. Call pcap_reader_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pcap_reader: PASSED only if it matches.

import "std/net_telemetry/pcap_reader.oo";

pub fn main() {
    let a: Int = pcap_reader_probe();
    if a != 0 {
        println("FAIL pcap_reader_probe");
        process_exit(1);
    }
    println("prod_nc_pcap_reader: PASSED");
}
