import "std/space_propulsion/launch_abort_envelope.oo";

pub fn main() {
    let launch_abort_envelope_a = launch_abort_spec_default();
    let launch_abort_envelope_b = launch_abort_spec_default();
    if launch_abort_envelope_a.capsule_mass_kg != launch_abort_envelope_b.capsule_mass_kg {
        println("FAIL launch_abort_envelope");
        process_exit(1);
    }
    println("prod_ap_launch_abort_envelope: PASSED");
