// # Product prove std/quantum_advanced/clifford_tableau.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/clifford_tableau.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/clifford_tableau.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_clifford_tableau: PASSED only if they match.

import "std/quantum_advanced/clifford_tableau.oo";

pub fn main() {
    let clifford_tableau_a = tableau_new(0);
    let clifford_tableau_b = tableau_new(0);
    if clifford_tableau_a.num_qubits != clifford_tableau_b.num_qubits {
        println("FAIL clifford_tableau");
        process_exit(1);
    }
    println("prod_ap_clifford_tableau: PASSED");
}
