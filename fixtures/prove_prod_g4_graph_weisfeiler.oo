// # Product prove std/graph_gnn/graph_weisfeiler_lehman_test.oo
//
// Logline: Fail-closed verification that 1-WL graph color refinement and histogram comparison are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_weisfeiler_lehman_test.oo.
//
// Beats:
//   1. Construct WLConfig and test wl_hash_combine.
//   2. Run wl_refine_step and wl_compare_histograms on isomorphic graph pairs.
//   3. Assert deterministic return values.
//   4. Print prod_g4_graph_weisfeiler: PASSED only if all match.

import "std/graph_gnn/graph_weisfeiler_lehman_test.oo";

pub fn main() {
    let cfg1: WLConfig = wl_config_new(5);
    let cfg2: WLConfig = wl_config_new(5);
    if cfg1.num_iterations != cfg2.num_iterations {
        println("FAIL wl_config_new num_iterations");
        process_exit(1);
    }

    let h1: Int = wl_hash_combine(12345, 6789);
    let h2: Int = wl_hash_combine(12345, 6789);
    if h1 != h2 {
        println("FAIL wl_hash_combine");
        process_exit(1);
    }

    let mut colors1: List[Int] = list_new();
    colors1 = list_push(colors1, 1);
    colors1 = list_push(colors1, 1);
    colors1 = list_push(colors1, 1);

    let mut colors2: List[Int] = list_new();
    colors2 = list_push(colors2, 1);
    colors2 = list_push(colors2, 1);
    colors2 = list_push(colors2, 1);

    // Graph 1 (triangle: 0-1, 1-2, 2-0)
    let mut neighs1: List[Int] = list_new();
    neighs1 = list_push(neighs1, 1);
    neighs1 = list_push(neighs1, 2);
    neighs1 = list_push(neighs1, 0);
    neighs1 = list_push(neighs1, 2);
    neighs1 = list_push(neighs1, 0);
    neighs1 = list_push(neighs1, 1);

    let mut offs1: List[Int] = list_new();
    offs1 = list_push(offs1, 0);
    offs1 = list_push(offs1, 2);
    offs1 = list_push(offs1, 4);
    offs1 = list_push(offs1, 6);

    let refined1: List[Int] = wl_refine_step(colors1, neighs1, offs1, 3);
    let refined2: List[Int] = wl_refine_step(colors2, neighs1, offs1, 3);

    let len1: Int = list_len(refined1);
    let len2: Int = list_len(refined2);
    if len1 != len2 {
        println("FAIL wl_refine_step length mismatch");
        process_exit(1);
    }
    if len1 != 3 {
        println("FAIL wl_refine_step length expected");
        process_exit(1);
    }

    let r0_1: Int = list_get(refined1, 0);
    let r0_2: Int = list_get(refined2, 0);
    if r0_1 != r0_2 {
        println("FAIL wl refine r0");
        process_exit(1);
    }

    let is_iso: Bool = wl_compare_histograms(refined1, refined2);
    if !is_iso {
        println("FAIL wl_compare_histograms");
        process_exit(1);
    }

    println("prod_g4_graph_weisfeiler: PASSED");
    process_exit(0);
}
