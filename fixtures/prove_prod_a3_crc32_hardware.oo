// # Product prove std/embedded_hal/crc32_hardware.oo
//
// Logline: Fail-closed emit+gcc+run asserts crc32_reverse_byte is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/crc32_hardware.oo.
//
// Beats:
//   1. Call crc32_reverse_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_crc32_hardware: PASSED only if they match.

import "std/embedded_hal/crc32_hardware.oo";

pub fn main() {
    let crc32_hardware_mark: Int = 0;
    if crc32_hardware_mark != 0 {
        process_exit(1);
    }
    let a: Int = crc32_reverse_byte(0);
    let b: Int = crc32_reverse_byte(0);
    if a != b {
        println("FAIL crc32_reverse_byte");
        process_exit(1);
    }
    println("prod_crc32_hardware: PASSED");
}
