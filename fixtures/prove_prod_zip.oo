// # Product prove std/archive/zip.oo
//
// Logline: Fail-closed emit+gcc+run asserts zip_detect is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/zip.oo.
//
// Beats:
//   1. Call zip_detect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_zip: PASSED only if they match.

import "std/archive/zip.oo";

pub fn main() {
    let a = zip_detect("x");
    let b = zip_detect("x");
    if a != b {
        println("FAIL zip_detect");
        process_exit(1);
    }
    println("prod_zip: PASSED");
}
