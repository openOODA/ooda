// # Product prove std/gis_spatial/kdtree_spatial.oo
//
// Logline: Fail-closed emit+gcc+run asserts kd_point2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kdtree_spatial.oo.
//
// Beats:
//   1. Call kd_point2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kdtree_spatial: PASSED only if they match.

import "std/gis_spatial/kdtree_spatial.oo";

pub fn main() {
    let kdtree_spatial_mark: Int = 0;
    if kdtree_spatial_mark != 0 {
        process_exit(1);
    }
    let a: KdPoint2D = kd_point2d_new(0.0, 0.0, 0);
    let b: KdPoint2D = kd_point2d_new(0.0, 0.0, 0);
    if (a).id != (b).id {
        println("FAIL kd_point2d_new");
        process_exit(1);
    }
    println("prod_g2_kdtree_spatial: PASSED");
}
