// # Product prove std/telecom_5g/dsp_fir_equiripple.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_fir_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_fir_equiripple.oo.
//
// Beats:
//   1. Call dsp_fir_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_fir_equiripple: PASSED only if they match.

import "std/telecom_5g/dsp_fir_equiripple.oo";

pub fn main() {
    let dsp_fir_equiripple_mark: Int = 0;
    if dsp_fir_equiripple_mark != 0 {
        process_exit(1);
    }
    let dsp_fir_equiripple_a: Float = dsp_fir_int_to_float(1);
    let dsp_fir_equiripple_b: Float = dsp_fir_int_to_float(1);
    if dsp_fir_equiripple_a != dsp_fir_equiripple_b {
        println("FAIL dsp_fir_int_to_float");
        process_exit(1);
    }
    println("prod_dsp_fir_equiripple: PASSED");
}
