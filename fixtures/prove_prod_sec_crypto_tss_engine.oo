// # Product prove std/sec/crypto/tss_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts tss_policy_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss_engine.oo.
//
// Beats:
//   1. Call tss_policy_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tss_engine: PASSED only if they match.

import "std/sec/crypto/tss_engine.oo";

pub fn main() {
    let tss_engine_mark: Int = 0;
    if tss_engine_mark != 0 {
        process_exit(1);
    }
    let a: TssSecurityPolicy = tss_policy_init(true, true, 2);
    let b: TssSecurityPolicy = tss_policy_init(true, true, 2);
    if (a).min_threshold != (b).min_threshold {
        println("FAIL tss_policy_init");
        process_exit(1);
    }
    println("prod_tss_engine: PASSED");
}
