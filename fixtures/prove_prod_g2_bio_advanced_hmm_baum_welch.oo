// # Product prove std/bio_advanced/hmm_baum_welch.oo
//
// Logline: Fail-closed emit+gcc+run asserts baum_welch_reestimate_transition is a real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/hmm_baum_welch.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call baum_welch_reestimate_transition twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_hmm_baum_welch: PASSED only if they match.

import "std/bio_advanced/hmm_baum_welch.oo";

pub fn main() {
    let g2_a = baum_welch_reestimate_transition(1.0, 1.0, 1.0, 2);
    let g2_b = baum_welch_reestimate_transition(1.0, 1.0, 1.0, 2);
    if g2_a != g2_b {
        println("FAIL baum_welch_reestimate_transition");
        process_exit(1);
    }
    println("prod_g2_hmm_baum_welch: PASSED");
}
