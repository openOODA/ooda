// # Product prove std/db_vector_ann/vector_hybrid_fusion_rrf.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_rrf_single_rank is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_hybrid_fusion_rrf.oo.
//
// Beats:
//   1. Call compute_rrf_single_rank twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vector_hybrid_fusion_rrf: PASSED only if they match.

import "std/db_vector_ann/vector_hybrid_fusion_rrf.oo";

pub fn main() {
    let vector_hybrid_fusion_rrf_mark: Int = 0;
    if vector_hybrid_fusion_rrf_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_rrf_single_rank(0, 0, 0);
    let b: Int = compute_rrf_single_rank(0, 0, 0);
    if a != b {
        println("FAIL compute_rrf_single_rank");
        process_exit(1);
    }
    println("prod_g2_vector_hybrid_fusion_rrf: PASSED");
}
