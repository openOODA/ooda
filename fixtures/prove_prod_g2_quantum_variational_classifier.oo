// # Product prove std/quantum_advanced/quantum_variational_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts vqc_prediction_to_probability is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_variational_classifier.oo.
//
// Beats:
//   1. Call vqc_prediction_to_probability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_variational_classifier: PASSED only if they match.

import "std/quantum_advanced/quantum_variational_classifier.oo";

pub fn main() {
    let quantum_variational_classifier_mark: Int = 0;
    if quantum_variational_classifier_mark != 0 {
        process_exit(1);
    }
    let a: Float = vqc_prediction_to_probability(0.0);
    let b: Float = vqc_prediction_to_probability(0.0);
    if a != b {
        println("FAIL vqc_prediction_to_probability");
        process_exit(1);
    }
    println("prod_g2_quantum_variational_classifier: PASSED");
}
