// # Allow a public eprintln argument
//
// Logline: A public string may go to eprintln while a tagged name sits unused.
//
// Beats:
//   1. Tag tok at line start.
//   2. Pass a public IDENT to eprintln.
//   3. Print zero so the pass rail has an allowed sink too.

// SECRET: tok
// public string may go to eprintln
pub fn main() {
    let tok = "secret-token";
    let pub = "ok";
    eprintln(pub);
    println(0);
}
