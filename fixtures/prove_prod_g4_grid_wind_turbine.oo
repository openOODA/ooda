// # Product prove std/grid/wind_turbine.oo
//
// Logline: Fail-closed verification of wind turbine operational simulation, safety boundaries, and telemetry extraction.
//
// Setup: Isolated emit-c. Imports std/grid/wind_turbine.oo.
//
// Beats:
//   1. Construct wind turbine model and step simulation under operating wind conditions.
//   2. Extract turbine telemetry and verify power generation and efficiency metrics.
//   3. Trigger fault state, assert pitch feathering, and verify safety boundary check.
//   4. Print prod_g4_grid_wind_turbine: PASSED and exit 0.

import "std/grid/wind_turbine.oo";
import "std/grid/wind_turbine_ops.oo";

pub fn main() {
    let t0: WindTurbine = wind_turbine_default(1);
    let t0_b: WindTurbine = wind_turbine_default(1);

    let id_a: Int = (t0).id;
    let id_b: Int = (t0_b).id;
    if id_a != id_b || id_a != 1 {
        println("FAIL wind_turbine_default id");
        process_exit(1);
    }

    let rated_kw: Float = (t0).rated_power_kw;
    if rated_kw != 3000.0 {
        println("FAIL wind_turbine_default rated_power");
        process_exit(1);
    }

    let t_run1: WindTurbine = wind_turbine_update_wind(t0, 12.0, 0.0, 1.225, 1.0);
    let t_run2: WindTurbine = wind_turbine_update_wind(t0, 12.0, 0.0, 1.225, 1.0);

    let pwr1: Float = (t_run1).output_power_kw;
    let pwr2: Float = (t_run2).output_power_kw;
    if pwr1 != pwr2 || pwr1 <= 0.0 {
        println("FAIL wind_turbine_update_wind power");
        process_exit(1);
    }

    let is_safe_normal: Bool = wind_turbine_is_safe(t_run1, 80.0);
    if !is_safe_normal {
        println("FAIL wind_turbine_is_safe normal");
        process_exit(1);
    }

    let telem: TurbineTelemetry = turbine_telemetry_extract(t_run1);
    let tid: Int = (telem).turbine_id;
    let is_fault_telem: Bool = (telem).is_fault;
    let tpwr: Float = (telem).power_kw;
    if tid != 1 || is_fault_telem || tpwr != pwr1 {
        println("FAIL turbine_telemetry_extract");
        process_exit(1);
    }

    let t_fault: WindTurbine = wind_turbine_trigger_fault(t_run1);
    let fault_status: Int = (t_fault).status;
    if fault_status != 4 {
        println("FAIL wind_turbine_trigger_fault status");
        process_exit(1);
    }

    let is_safe_fault: Bool = wind_turbine_is_safe(t_fault, 80.0);
    if is_safe_fault {
        println("FAIL wind_turbine_is_safe fault");
        process_exit(1);
    }

    let t_yaw: WindTurbine = wind_turbine_yaw_align(t0, 10.0, 2.0);
    let yaw_val: Float = (t_yaw).yaw_angle_deg;
    if yaw_val <= 0.0 {
        println("FAIL wind_turbine_yaw_align");
        process_exit(1);
    }

    println("prod_g4_grid_wind_turbine: PASSED");
    process_exit(0);
}
