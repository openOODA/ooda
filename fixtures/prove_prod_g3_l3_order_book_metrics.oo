// # Product prove std/fintech_l3_book/l3_order_book_metrics.oo
//
// Logline: Fail-closed emit+gcc+run asserts book_imbalance_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_order_book_metrics.oo.
//
// Beats:
//   1. Call book_imbalance_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_order_book_metrics: PASSED only if they match.

import "std/fintech_l3_book/l3_order_book_metrics.oo";

pub fn main() {
    let l3_order_book_metrics_mark: Int = 0;
    if l3_order_book_metrics_mark != 0 {
        process_exit(1);
    }
    let a: BookImbalanceState = book_imbalance_state_new();
    let b: BookImbalanceState = book_imbalance_state_new();
    if (a).total_adds != (b).total_adds {
        println("FAIL book_imbalance_state_new");
        process_exit(1);
    }
    println("prod_l3_order_book_metrics: PASSED");
}
