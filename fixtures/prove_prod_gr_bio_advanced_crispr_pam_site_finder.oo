// # Product prove std/bio_advanced/crispr_pam_site_finder.oo
//
// Logline: Fail-closed emit+gcc+run asserts crispr_substr is a real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/crispr_pam_site_finder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call crispr_substr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_crispr_pam_site_finder: PASSED only if they match.

import "std/bio_advanced/crispr_pam_site_finder.oo";

pub fn main() {
    let g0_a = crispr_substr("x", 0, 0);
    let g0_b = crispr_substr("x", 0, 0);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL crispr_substr");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL crispr_substr");
        process_exit(1);
    }
    println("prod_gr_crispr_pam_site_finder: PASSED");
}
