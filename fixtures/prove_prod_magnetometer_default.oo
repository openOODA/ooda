// # Product prove std/robotics_auv/magnetic_compass_declination.oo
//
// Logline: Fail-closed emit+gcc+run asserts magnetometer_calib_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/magnetic_compass_declination.oo.
//
// Beats:
//   1. Call magnetometer_calib_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_magnetometer_default: PASSED only if they match.

import "std/robotics_auv/magnetic_compass_declination.oo";

pub fn main() {
    let magnetic_compass_declination_mark: Int = 0;
    if magnetic_compass_declination_mark != 0 { process_exit(1); }
    let a: MagnetometerCalib = magnetometer_calib_default();
    let b: MagnetometerCalib = magnetometer_calib_default();
    let ah: Float = (a).hard_iron_offset_x;
    let bh: Float = (b).hard_iron_offset_x;
    if ah != bh {
        println("FAIL magnetometer_calib_default");
        process_exit(1);
    }
    println("prod_magnetometer_default: PASSED");
}
