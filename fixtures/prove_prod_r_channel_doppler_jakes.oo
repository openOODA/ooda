// # Product prove std/telecom_5g/channel_doppler_jakes.oo
//
// Logline: Fail-closed emit+gcc+run asserts jakes_doppler_model_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_doppler_jakes.oo.
//
// Beats:
//   1. Call jakes_doppler_model_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_channel_doppler_jakes: PASSED only if asserts hold.

import "std/telecom_5g/channel_doppler_jakes.oo";

pub fn main() {
    let channel_doppler_jakes: JakesDopplerModel = jakes_doppler_model_new(1.0, 0.0);
    let channel_doppler_jakes_b: JakesDopplerModel = jakes_doppler_model_new(1.0, 0.0);
    if (channel_doppler_jakes).num_oscillators != 8 {
        println("FAIL jakes oscillators");
        process_exit(1);
    }
    if (channel_doppler_jakes).num_oscillators != (channel_doppler_jakes_b).num_oscillators {
        println("FAIL jakes det");
        process_exit(1);
    }
    println("prod_channel_doppler_jakes: PASSED");
}
