// # Product prove std/astrophysics_relativity/magnetar_crust_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/magnetar_crust_cooling.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/magnetar_crust_cooling.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_magnetar_crust_cooling: PASSED only if they match.

import "std/astrophysics_relativity/magnetar_crust_cooling.oo";

pub fn main() {
    let magnetar_crust_cooling_a = magnetar_quantum_critical_b();
    let magnetar_crust_cooling_b = magnetar_quantum_critical_b();
    if magnetar_crust_cooling_a != magnetar_crust_cooling_b {
        println("FAIL magnetar_crust_cooling");
        process_exit(1);
    }
    println("prod_ap_magnetar_crust_cooling: PASSED");
}
