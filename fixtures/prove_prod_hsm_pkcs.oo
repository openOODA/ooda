import "std/sec/crypto/hsm_pkcs.oo";

pub fn main() {
    let hsm_pkcs_mark: Int = 0;
    if hsm_pkcs_mark != 0 { process_exit(1); }
    let a: Result[Bool, String] = hsm_c_initialize(0, "x");
    let b: Result[Bool, String] = hsm_c_initialize(0, "x");
    if a != b { process_exit(1); }
    println("prod_hsm_pkcs: PASSED");
}
