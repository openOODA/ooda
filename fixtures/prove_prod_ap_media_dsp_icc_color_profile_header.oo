// # Product prove std/media_dsp/icc_color_profile_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/icc_color_profile_header.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/icc_color_profile_header.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_icc_color_profile_header: PASSED only if they match.

import "std/media_dsp/icc_color_profile_header.oo";

pub fn main() {
    let icc_color_profile_header_a = icc_srgb_to_linear(0.0);
    let icc_color_profile_header_b = icc_srgb_to_linear(0.0);
    if icc_color_profile_header_a != icc_color_profile_header_b {
        println("FAIL icc_color_profile_header");
        process_exit(1);
    }
    println("prod_ap_icc_color_profile_header: PASSED");
}
