// # Product prove std/quantum/gate_toffoli.oo
//
// Logline: Fail-closed emit+gcc+run asserts apply_toffoli does not crash on a |0...0> register.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_toffoli.oo.
//
// Beats:
//   1. Construct a 3-qubit register and apply apply_toffoli twice.
//   2. Print prod_gate_toffoli: PASSED if no crash.

import "std/quantum/gate_toffoli.oo";

pub fn main() {
    let gate_toffoli_mark: Int = 0;
    if gate_toffoli_mark != 0 {
        process_exit(1);
    }
    let r: QuantumRegister = register_new(3);
    apply_toffoli(r, 0, 1, 2);
    apply_toffoli(r, 0, 1, 2);
    println("prod_gate_toffoli: PASSED");
}
