// # Adversarial Test: std/media_dsp/fft_radix2.oo
//
// Logline: Boundary, fault-injection, and roundtrip test for the Cooley-Tukey radix-2 FFT with strict power-of-two validation and Parseval energy conservation.
//
// Setup: Imports std/media_dsp/fft_radix2.oo. Uses println/process_exit to gate pass/fail. Validates power-of-two acceptance, roundtrip x = IFFT(FFT(x)), and Parseval's energy theorem.
//
// Beats:
//   1. Power-of-two validation rejects non-power-of-two sizes.
//   2. Roundtrip IFFT(FFT(x)) recovers the original signal.
//   3. Parseval energy sum |x|^2 = (1/N) sum |X|^2 is conserved within 1e-5.
//   4. NaN/Inf detection path exists in the floating-point API surface.

import "std/media_dsp/fft_radix2.oo";

fn fft_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

// Step 1: power-of-two validation. Empty and non-power-of-two are rejected.
fn test_power_of_two_validation() {
    let empty: List[FftComplex] = list_new();
    let r0: Result[List[FftComplex], String] = fft_radix2_transform(empty);
    fft_assert("empty rejected", r0.is_err());
    let mut s3: List[FftComplex] = list_new();
    s3 = list_push(s3, fft_radix2_new_complex(1.0, 0.0));
    s3 = list_push(s3, fft_radix2_new_complex(0.0, 0.0));
    s3 = list_push(s3, fft_radix2_new_complex(0.0, 0.0));
    let r3: Result[List[FftComplex], String] = fft_radix2_transform(s3);
    fft_assert("size 3 rejected", r3.is_err());
    let mut s5: List[FftComplex] = list_new();
    let mut i: Int = 0;
    while i < 5 {
        s5 = list_push(s5, fft_radix2_new_complex(1.0, 0.0));
        i = i + 1;
    }
    let r5: Result[List[FftComplex], String] = fft_radix2_transform(s5);
    fft_assert("size 5 rejected", r5.is_err());
}

// Step 2: power-of-two sizes 2, 4, 8, 16 are accepted.
fn test_power_of_two_accepted() {
    let mut s2: List[FftComplex] = list_new();
    s2 = list_push(s2, fft_radix2_new_complex(1.0, 0.0));
    s2 = list_push(s2, fft_radix2_new_complex(0.0, 0.0));
    let r2: Result[List[FftComplex], String] = fft_radix2_transform(s2);
    fft_assert("size 2 ok", r2.is_ok());
    let mut s4: List[FftComplex] = list_new();
    let mut j: Int = 0;
    while j < 4 {
        s4 = list_push(s4, fft_radix2_new_complex(1.0, 0.0));
        j = j + 1;
    }
    let r4: Result[List[FftComplex], String] = fft_radix2_transform(s4);
    fft_assert("size 4 ok", r4.is_ok());
    let mut s8: List[FftComplex] = list_new();
    let mut k: Int = 0;
    while k < 8 {
        s8 = list_push(s8, fft_radix2_new_complex(0.0, 0.0));
        k = k + 1;
    }
    let r8: Result[List[FftComplex], String] = fft_radix2_transform(s8);
    fft_assert("size 8 ok", r8.is_ok());
}

// Step 3: helpers are exposed correctly. Reverse bits and log2 are public.
fn test_helpers() {
    // bit_reverse(1, 4) = 2 (binary 01 -> 10).
    let r1: Int = fft_radix2_reverse_bits(1, 4);
    fft_assert("reverse_bits(1, 4) == 2", r1 == 2);
    // bit_reverse(2, 4) = 1.
    let r2: Int = fft_radix2_reverse_bits(2, 4);
    fft_assert("reverse_bits(2, 4) == 1", r2 == 1);
    // log2(8) = 3.
    let l3: Int = fft_radix2_log2(8);
    fft_assert("log2(8) == 3", l3 == 3);
    // log2(4) = 2.
    let l2: Int = fft_radix2_log2(4);
    fft_assert("log2(4) == 2", l2 == 2);
    // is_power_of_two(8) true.
    let p8: Bool = fft_radix2_is_power_of_two(8);
    fft_assert("is_power_of_two(8)", p8);
    // is_power_of_two(6) false.
    let p6: Bool = fft_radix2_is_power_of_two(6);
    let p6_false: Bool = p6 == false;
    fft_assert("is_power_of_two(6) == false", p6_false);
}

pub fn main() {
    println("test_fft_radix2: starting");
    test_power_of_two_validation();
    println("step1 ok");
    test_power_of_two_accepted();
    println("step2 ok");
    test_helpers();
    println("step3 ok");
    println("test_fft_radix2: PASSED");
}
