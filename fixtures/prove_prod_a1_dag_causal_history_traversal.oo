// # Product prove std/bft_consensus/dag_causal_history_traversal.oo
//
// Logline: Fail-closed emit+gcc+run asserts causal_traversal_context_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_causal_history_traversal.oo.
//
// Beats:
//   1. Call causal_traversal_context_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dag_causal_history_traversal: PASSED only if they match.

import "std/bft_consensus/dag_causal_history_traversal.oo";

pub fn main() {
    let dag_causal_history_traversal_mark: Int = 0;
    if dag_causal_history_traversal_mark != 0 {
        process_exit(1);
    }
    let a: CausalTraversalContext = causal_traversal_context_new("x", 0);
    let b: CausalTraversalContext = causal_traversal_context_new("x", 0);
    if (a).visited_count != (b).visited_count {
        println("FAIL causal_traversal_context_new");
        process_exit(1);
    }
    println("prod_dag_causal_history_traversal: PASSED");
}
