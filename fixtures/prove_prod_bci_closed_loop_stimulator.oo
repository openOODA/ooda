// # Product prove std/neuro_bci/bci_closed_loop_stimulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts stim_config_peak_locked real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_closed_loop_stimulator.oo.
//
// Beats:
//   1. Call stim_config_peak_locked with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_bci_closed_loop_stimulator: PASSED only if the assert holds.

import "std/neuro_bci/bci_closed_loop_stimulator.oo";

pub fn main() {
    let bci_closed_loop_stimulator_mark: Int = 0;
    if bci_closed_loop_stimulator_mark != 0 {
        process_exit(1);
    }
    let bci_closed_loop_stimulator_a: StimTriggerConfig = stim_config_peak_locked();
    let bci_closed_loop_stimulator_target_phase_rad: Float = (bci_closed_loop_stimulator_a).target_phase_rad;
    if !(bci_closed_loop_stimulator_target_phase_rad == 0.0) {
        println("FAIL stim_config_peak_locked");
        process_exit(1);
    }
    println("prod_bci_closed_loop_stimulator: PASSED");
}
