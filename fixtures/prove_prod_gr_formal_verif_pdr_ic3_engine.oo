// # Product prove std/formal_verif/pdr_ic3_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts pdr_add_lemma is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/pdr_ic3_engine.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call pdr_add_lemma twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_pdr_ic3_engine: PASSED only if they match.

import "std/formal_verif/pdr_ic3_engine.oo";

pub fn main() {
    let mut g0_oa = pdr_engine_new();
    let mut g0_ob = pdr_engine_new();
    let g0_a = pdr_add_lemma(&g0_oa, 0, "x");
    let g0_b = pdr_add_lemma(&g0_ob, 0, "x");
    if g0_a != g0_b {
        println("FAIL pdr_add_lemma");
        process_exit(1);
    }
    println("prod_gr_pdr_ic3_engine: PASSED");
}
