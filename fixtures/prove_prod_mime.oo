// # Product MIME type prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/net/mime.oo extension and text class.
//
// Setup: Tree oodac emit-c. Calls ooda/std/net/mime.oo. Destub none. No caps.
//
// Beats:
//   1. mime_from_extension("json") is application/json.
//   2. mime_from_extension("html") is text/html.
//   3. mime_is_text("text/plain") is true.
//   4. mime_with_charset("text/html","utf-8") is text/html; charset=utf-8.
//   5. Exit 1 on any miss. Print prod_mime: PASSED only if all hold.

import "std/net/mime.oo";

pub fn main() {
    let j: String = mime_from_extension("json");
    if j != "application/json" {
        println("FAIL mime json");
        process_exit(1);
    }
    let h: String = mime_from_extension("html");
    if h != "text/html" {
        println("FAIL mime html");
        process_exit(1);
    }
    if !mime_is_text("text/plain") {
        println("FAIL mime is_text");
        process_exit(1);
    }
    let cs: String = mime_with_charset("text/html", "utf-8");
    if cs != "text/html; charset=utf-8" {
        println("FAIL mime charset");
        process_exit(1);
    }
    println("prod_mime: PASSED");
}
