// # Product buffered FD stream
//
// Logline: Write through a 2-byte buffer, flush, and read the store back.
//
// Setup: OPEN-76. ooda/std/fs/stream.oo. In-memory fd, no caps.
//
// Beats:
//   1. Write hello on fd 3 with cap 2.
//   2. Require a pending tail before flush.
//   3. Read he / ll / o and print PASSED.

import "std/fs/stream.oo";

pub fn main() {
    let mut s: FdStream = fd_stream_open(3, 2);
    s = fd_stream_write(s, "hello");
    if fd_stream_fd(s) != 3 {
        println("FAIL fd");
        process_exit(1);
    }
    if fd_stream_store(s) != "hell" {
        println("FAIL store before flush");
        process_exit(1);
    }
    if fd_stream_pending(s) != 1 {
        println("FAIL pending");
        process_exit(1);
    }
    s = fd_stream_flush(s);
    if fd_stream_store(s) != "hello" {
        println("FAIL flush");
        process_exit(1);
    }
    s = fd_stream_rewind(s);
    let r1: FdRead = fd_stream_read(s, 2);
    if fd_read_data(r1) != "he" {
        println("FAIL read1");
        process_exit(1);
    }
    let r2: FdRead = fd_stream_read(fd_read_stream(r1), 2);
    if fd_read_data(r2) != "ll" {
        println("FAIL read2");
        process_exit(1);
    }
    let r3: FdRead = fd_stream_read(fd_read_stream(r2), 2);
    if fd_read_data(r3) != "o" {
        println("FAIL read3");
        process_exit(1);
    }
    println("open76: PASSED");
}
