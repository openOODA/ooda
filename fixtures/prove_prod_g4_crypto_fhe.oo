// # Product prove std/crypto/fhe.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto/fhe.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_crypto_fhe: PASSED and exit 0 only on match.

import "std/crypto/fhe.oo";

pub fn main() {
    let chk_a: Int = shim_marker_checksum();
    let chk_b: Int = shim_marker_checksum();
    if chk_a != chk_b {
        println("FAIL fhe checksum");
        process_exit(1);
    }

    let deg_a: Int = fhe_params_degree(shim_marker_params_create());
    let deg_b: Int = fhe_params_degree(shim_marker_params_create());
    if deg_a != deg_b {
        println("FAIL fhe params degree");
        process_exit(1);
    }

    let p_a: FheParams = fhe_params_new(1, 4096, 128);
    let p_b: FheParams = fhe_params_new(1, 4096, 128);
    let flags_a: Int = fhe_params_flags(p_a);
    let flags_b: Int = fhe_params_flags(p_b);
    if flags_a != flags_b {
        println("FAIL fhe params flags");
        process_exit(1);
    }

    let pt_a: FhePlaintext = shim_marker_encode();
    let pt_b: FhePlaintext = shim_marker_encode();
    if (pt_a).value != (pt_b).value {
        println("FAIL fhe encode value");
        process_exit(1);
    }

    println("prod_g4_crypto_fhe: PASSED");
    process_exit(0);
}
