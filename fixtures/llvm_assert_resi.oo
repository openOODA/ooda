// # Int Result assert_eq refuse
//
// Logline: emit-llvm fail-closes assert_eq of two Result[Int] values instead of icmp on the compound.
//
// Setup: Backend-LLVM. Int Result == stays the typed operator lock.
//
// Beats:
//   1. Bind two Result[Int, String] Ok values.
//   2. assert_eq them.
//   3. Emit must print ERR llvm_emit.

pub fn main() {
    let a: Result[Int, String] = Ok(7);
    let b: Result[Int, String] = Ok(7);
    assert_eq(a, b);
}
