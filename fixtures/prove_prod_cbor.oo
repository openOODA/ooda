// # Product prove std/markup/cbor.oo
//
// Logline: Fail-closed emit+gcc+run asserts cbor_major_uint is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/cbor.oo.
//
// Beats:
//   1. Call cbor_major_uint twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cbor: PASSED only if they match.

import "std/markup/cbor.oo";

pub fn main() {
    let a = cbor_major_uint();
    let b = cbor_major_uint();
    if a != b {
        println("FAIL cbor_major_uint");
        process_exit(1);
    }
    println("prod_cbor: PASSED");
}
