// # Product prove std/archive/tar.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/tar.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/tar.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tar: PASSED only if they match.

import "std/archive/tar.oo";

pub fn main() {
    let tar_a = tar_detect("x");
    let tar_b = tar_detect("x");
    if tar_a.is_ok() != tar_b.is_ok() {
        println("FAIL tar");
        process_exit(1);
    }
    println("prod_ap_tar: PASSED");
}
