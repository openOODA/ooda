// # Product prove std/fin/routing_venue.oo
//
// Logline: Fail-closed emit+gcc+run asserts routing_venue_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing_venue.oo.
//
// Beats:
//   1. Call routing_venue_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_routing_venue: PASSED only if they match.

import "std/fin/routing_venue.oo";

pub fn main() {
    let routing_venue_mark: Int = 0;
    if routing_venue_mark != 0 {
        process_exit(1);
    }
    let routing_venue_a = routing_venue_init(1, 1, 1);
    let routing_venue_b = routing_venue_init(1, 1, 1);
    if (routing_venue_a).side != (routing_venue_b).side {
        println("FAIL routing_venue_init");
        process_exit(1);
    }
    println("prod_routing_venue: PASSED");
}
