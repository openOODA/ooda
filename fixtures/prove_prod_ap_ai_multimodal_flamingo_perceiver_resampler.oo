// # Product prove std/ai_multimodal/flamingo_perceiver_resampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/flamingo_perceiver_resampler.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/flamingo_perceiver_resampler.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_flamingo_perceiver_resampler: PASSED only if they match.

import "std/ai_multimodal/flamingo_perceiver_resampler.oo";

pub fn main() {
    let flamingo_perceiver_resampler_a = perceiver_config_new(0, 0, 0, 0);
    let flamingo_perceiver_resampler_b = perceiver_config_new(0, 0, 0, 0);
    let flamingo_perceiver_resampler_va = perceiver_n_out(flamingo_perceiver_resampler_a);
    let flamingo_perceiver_resampler_vb = perceiver_n_out(flamingo_perceiver_resampler_b);
    if flamingo_perceiver_resampler_va != flamingo_perceiver_resampler_vb {
        println("FAIL flamingo_perceiver_resampler");
        process_exit(1);
    }
    println("prod_ap_flamingo_perceiver_resampler: PASSED");
}
