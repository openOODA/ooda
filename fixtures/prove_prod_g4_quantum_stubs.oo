// # Product prove std/quantum/quantum_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum/quantum_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/quantum_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_quantum_stubs: PASSED and exit 0 only on match.

import "std/quantum/quantum_stubs.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_quantum_quantum_stubs_oo();
    let dummy_b: Int = __dummy_std_src_ooda_quantum_quantum_stubs_oo();
    if dummy_a != dummy_b {
        println("FAIL quantum_stubs dummy");
        process_exit(1);
    }

    let cal_a: Bool = quantum_stub_ion_trap_calibrate();
    let cal_b: Bool = quantum_stub_ion_trap_calibrate();
    if cal_a != cal_b {
        println("FAIL quantum_stub_ion_trap_calibrate");
        process_exit(1);
    }

    let dur_a: Int = quantum_stub_pulse_schedule("X", 20.0);
    let dur_b: Int = quantum_stub_pulse_schedule("X", 20.0);
    if dur_a != dur_b {
        println("FAIL quantum_stub_pulse_schedule");
        process_exit(1);
    }

    let temp_a: Float = quantum_stub_cryo_fridge_temp_mk();
    let temp_b: Float = quantum_stub_cryo_fridge_temp_mk();
    if temp_a != temp_b {
        println("FAIL quantum_stub_cryo_fridge_temp_mk");
        process_exit(1);
    }

    let t1_a: Float = quantum_stub_qubit_t1_us(1);
    let t1_b: Float = quantum_stub_qubit_t1_us(1);
    if t1_a != t1_b {
        println("FAIL quantum_stub_qubit_t1_us");
        process_exit(1);
    }

    println("prod_g4_quantum_stubs: PASSED");
    process_exit(0);
}
