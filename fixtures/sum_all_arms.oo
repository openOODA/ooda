// # User-sum match names every variant
//
// Logline: Check accepts a Flag match that names On and Off.
//
// Setup: type Flag = On | Off. Exhaust is the variant set.
//
// Beats:
//   1. Match On and Off on an annotated Flag let.
//   2. No variant is missing.
//   3. check must OK.

type Flag = On | Off;

pub fn main() {
    let a: Flag = On;
    let v: Int = match a {
        On => 1,
        Off => 0
    };
}
