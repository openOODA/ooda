// # Product prove std/game_engine/collision_circle.oo
//
// Logline: Fail-closed emit+gcc+run asserts circle2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/collision_circle.oo.
//
// Beats:
//   1. Call circle2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_collision_circle: PASSED only if they match.

import "std/game_engine/collision_circle.oo";

pub fn main() {
    let collision_circle_mark: Int = 0;
    if collision_circle_mark != 0 {
        process_exit(1);
    }
    let a: Circle2D = circle2d_new(0.0, 0.0, 0.0);
    let b: Circle2D = circle2d_new(0.0, 0.0, 0.0);
    if (a).cx != (b).cx {
        println("FAIL circle2d_new");
        process_exit(1);
    }
    println("prod_collision_circle: PASSED");
}
