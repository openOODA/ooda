// # Product prove std/gis_spatial/kml_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/kml_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kml_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kml_parser: PASSED only if they match.

import "std/gis_spatial/kml_parser.oo";

pub fn main() {
    let kml_parser_a = kml_identify_tag("x");
    let kml_parser_b = kml_identify_tag("x");
    if kml_parser_a != kml_parser_b {
        println("FAIL kml_parser");
        process_exit(1);
    }
    println("prod_ap_kml_parser: PASSED");
}
