// # Product prove std/web_ecosystem/date_fns_timezone.oo
//
// Logline: Fail-closed emit+gcc+run asserts timezone_abs_minutes is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/date_fns_timezone.oo.
//
// Beats:
//   1. Call timezone_abs_minutes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_date_fns_timezone: PASSED only if they match.

import "std/web_ecosystem/date_fns_timezone.oo";

pub fn main() {
    let date_fns_timezone_mark: Int = 0;
    if date_fns_timezone_mark != 0 {
        process_exit(1);
    }
    let a: Int = timezone_abs_minutes(0);
    let b: Int = timezone_abs_minutes(0);
    if a != b {
        println("FAIL timezone_abs_minutes");
        process_exit(1);
    }
    println("prod_g2_date_fns_timezone: PASSED");
}
