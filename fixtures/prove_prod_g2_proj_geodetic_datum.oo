// # Product prove std/gis_topo/proj_geodetic_datum.oo
//
// Logline: Fail-closed emit+gcc+run asserts datum_wgs84 is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_geodetic_datum.oo.
//
// Beats:
//   1. Call datum_wgs84 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_proj_geodetic_datum: PASSED only if they match.

import "std/gis_topo/proj_geodetic_datum.oo";

pub fn main() {
    let proj_geodetic_datum_mark: Int = 0;
    if proj_geodetic_datum_mark != 0 {
        process_exit(1);
    }
    let a: GeodeticDatum = datum_wgs84();
    let b: GeodeticDatum = datum_wgs84();
    if (a).epsg_code != (b).epsg_code {
        println("FAIL datum_wgs84");
        process_exit(1);
    }
    println("prod_g2_proj_geodetic_datum: PASSED");
}
