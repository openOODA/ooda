// # Product prove std/sec/sys/kernel_audit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/kernel_audit_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kernel_audit_types: PASSED only if they match.

import "std/sec/sys/kernel_audit_types.oo";

pub fn main() {
    let kernel_audit_types_a = audit_rule_new(0, 0);
    let kernel_audit_types_b = audit_rule_new(0, 0);
    let kernel_audit_types_va = audit_rule_perm(kernel_audit_types_a);
    let kernel_audit_types_vb = audit_rule_perm(kernel_audit_types_b);
    if kernel_audit_types_va != kernel_audit_types_vb {
        println("FAIL kernel_audit_types");
        process_exit(1);
    }
    println("prod_ap_kernel_audit_types: PASSED");
}
