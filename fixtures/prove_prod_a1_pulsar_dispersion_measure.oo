// # Product prove std/astrophysics_relativity/pulsar_dispersion_measure.oo
//
// Logline: Fail-closed emit+gcc+run asserts pulsar_dispersion_measure_invert is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/pulsar_dispersion_measure.oo.
//
// Beats:
//   1. Call pulsar_dispersion_measure_invert twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pulsar_dispersion_measure: PASSED only if they match.

import "std/astrophysics_relativity/pulsar_dispersion_measure.oo";

pub fn main() {
    let a: Int = pulsar_dispersion_measure_invert(0, 0);
    let b: Int = pulsar_dispersion_measure_invert(0, 0);
    if a != b {
        println("FAIL pulsar_dispersion_measure_invert");
        process_exit(1);
    }
    println("prod_pulsar_dispersion_measure: PASSED");
}
