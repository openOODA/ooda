// # List[struct] out-of-range get
//
// Logline: Fail-closed emit+gcc+run of List[Node] get past the end.
//
// Setup: Backend-C. Empty list get must print ERR and exit 1.
//
// Beats:
//   1. Build an empty List[Node].
//   2. Call list_get at index 0.
//   3. That path must not print PASSED.

type Node = struct {
    id: Int,
    tag: String
};

pub fn main() {
    let xs: List[Node] = list_new();
    let g: Node = list_get(xs, 0);
    if g.id == 0 {
        println("list_struct_oob: LEAKED");
    }
    println("list_struct_oob: LEAKED");
}
