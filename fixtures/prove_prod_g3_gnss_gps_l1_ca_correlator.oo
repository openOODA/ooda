// # Product prove std/satellite_dvb/gnss_gps_l1_ca_correlator.oo
//
// Logline: Fail-closed emit+gcc+run asserts epl_correlator_arm_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_gps_l1_ca_correlator.oo.
//
// Beats:
//   1. Call epl_correlator_arm_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gnss_gps_l1_ca_correlator: PASSED only if they match.

import "std/satellite_dvb/gnss_gps_l1_ca_correlator.oo";

pub fn main() {
    let gnss_gps_l1_ca_correlator_mark: Int = 0;
    if gnss_gps_l1_ca_correlator_mark != 0 {
        process_exit(1);
    }
    let a: EplCorrelatorArm = epl_correlator_arm_new();
    let b: EplCorrelatorArm = epl_correlator_arm_new();
    if (a).i_early != (b).i_early {
        println("FAIL epl_correlator_arm_new");
        process_exit(1);
    }
    println("prod_gnss_gps_l1_ca_correlator: PASSED");
}
