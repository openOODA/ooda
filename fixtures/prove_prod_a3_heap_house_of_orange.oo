// # Product prove std/exploit_analysis/heap_house_of_orange.oo
//
// Logline: Fail-closed emit+gcc+run asserts house_of_orange_plan_build is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_house_of_orange.oo.
//
// Beats:
//   1. Call house_of_orange_plan_build twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_house_of_orange: PASSED only if they match.

import "std/exploit_analysis/heap_house_of_orange.oo";

pub fn main() {
    let heap_house_of_orange_mark: Int = 0;
    if heap_house_of_orange_mark != 0 {
        process_exit(1);
    }
    let a: HouseOfOrangePlan = house_of_orange_plan_build(0, 0, 0);
    let b: HouseOfOrangePlan = house_of_orange_plan_build(0, 0, 0);
    if (a).original_top_size != (b).original_top_size {
        println("FAIL house_of_orange_plan_build");
        process_exit(1);
    }
    println("prod_heap_house_of_orange: PASSED");
}
