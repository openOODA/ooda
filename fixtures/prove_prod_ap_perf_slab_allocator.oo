// # Product prove std/perf/slab_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/slab_allocator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/slab_allocator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_slab_allocator: PASSED only if they match.

import "std/perf/slab_allocator.oo";

pub fn main() {
    let slab_allocator_a = slab_create("x", 0, 0);
    let slab_allocator_b = slab_create("x", 0, 0);
    let slab_allocator_va = slab_utilization(slab_allocator_a);
    let slab_allocator_vb = slab_utilization(slab_allocator_b);
    if slab_allocator_va != slab_allocator_vb {
        println("FAIL slab_allocator");
        process_exit(1);
    }
    println("prod_ap_slab_allocator: PASSED");
}
