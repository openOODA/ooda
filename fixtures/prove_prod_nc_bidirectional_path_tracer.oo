// # Product prove std/pbr_raytracing/bidirectional_path_tracer.oo
//
// Logline: Fail-closed emit+gcc+run asserts bidirectional_path_tracer_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/bidirectional_path_tracer.oo.
//
// Beats:
//   1. Call bidirectional_path_tracer_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_bidirectional_path_tracer: PASSED only if it matches.

import "std/pbr_raytracing/bidirectional_path_tracer.oo";

pub fn main() {
    let a: Int = bidirectional_path_tracer_probe();
    if a != 0 {
        println("FAIL bidirectional_path_tracer_probe");
        process_exit(1);
    }
    println("prod_nc_bidirectional_path_tracer: PASSED");
}
