// # Product prove std/genomics_advanced/hic_ab_compartment_eigen.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_ab_compartment_eigen_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_ab_compartment_eigen.oo.
//
// Beats:
//   1. Call hic_ab_compartment_eigen_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hic_ab_compartment_eigen: PASSED only if they match.

import "std/genomics_advanced/hic_ab_compartment_eigen.oo";

pub fn main() {
    let a = hic_ab_compartment_eigen_probe();
    let b = hic_ab_compartment_eigen_probe();
    if a != b {
        println("FAIL hic_ab_compartment_eigen_probe");
        process_exit(1);
    }
    println("prod_hic_ab_compartment_eigen: PASSED");
}
