// # Product prove std/bio/dna_sw.oo
//
// Logline: Fail-closed emit+gcc+run asserts sw_align is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/dna_sw.oo.
//
// Beats:
//   1. Call sw_align twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dna_sw: PASSED only if they match.

import "std/bio/dna_sw.oo";

pub fn main() {
    let dna_sw_mark: Int = 0;
    if dna_sw_mark != 0 {
        process_exit(1);
    }
    let a: SwAlignment = sw_align(list_new(), 0, list_new(), 0, 0, 0, 0);
    let b: SwAlignment = sw_align(list_new(), 0, list_new(), 0, 0, 0, 0);
    if (a).rows != (b).rows {
        println("FAIL sw_align");
        process_exit(1);
    }
    println("prod_dna_sw: PASSED");
}
