// # Product prove std/formal_verif/abstract_polyhedra_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_constraint_eval is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_polyhedra_domain.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call linear_constraint_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_abstract_polyhedra_domain: PASSED only if they match.

import "std/formal_verif/abstract_polyhedra_domain.oo";

pub fn main() {
    let g2_oa: LinearConstraint = LinearConstraint { coefficients: list_new(), constant_bound: 2, is_equality: true };
    let g2_ob: LinearConstraint = LinearConstraint { coefficients: list_new(), constant_bound: 2, is_equality: true };
    let g2_a = linear_constraint_eval(&g2_oa, list_new());
    let g2_b = linear_constraint_eval(&g2_ob, list_new());
    if g2_a != g2_b {
        println("FAIL linear_constraint_eval");
        process_exit(1);
    }
    println("prod_g2_abstract_polyhedra_domain: PASSED");
}
