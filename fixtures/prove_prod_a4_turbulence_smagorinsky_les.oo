// # Product prove std/physics_advanced/turbulence_smagorinsky_les.oo
//
// Logline: Fail-closed emit+gcc+run asserts van_driest_damping_factor is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/turbulence_smagorinsky_les.oo.
//
// Beats:
//   1. Call van_driest_damping_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_turbulence_smagorinsky_les: PASSED only if they match.

import "std/physics_advanced/turbulence_smagorinsky_les.oo";

pub fn main() {
    let turbulence_smagorinsky_les_mark: Int = 0;
    if turbulence_smagorinsky_les_mark != 0 {
        process_exit(1);
    }
    let a: Float = van_driest_damping_factor(0.0, 0.0);
    let b: Float = van_driest_damping_factor(0.0, 0.0);
    if a != b {
        println("FAIL van_driest_damping_factor");
        process_exit(1);
    }
    println("prod_turbulence_smagorinsky_les: PASSED");
}
