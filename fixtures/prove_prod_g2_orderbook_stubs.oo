// # Product prove std/fin/orderbook_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts orderbook_execute_atomic_cas_match is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/orderbook_stubs.oo.
//
// Beats:
//   1. Call orderbook_execute_atomic_cas_match twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_orderbook_stubs: PASSED only if they match.

import "std/fin/orderbook_stubs.oo";

pub fn main() {
    let orderbook_stubs_mark: Int = 0;
    if orderbook_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Int = orderbook_execute_atomic_cas_match(0, 0);
    let b: Int = orderbook_execute_atomic_cas_match(0, 0);
    if a != b {
        println("FAIL orderbook_execute_atomic_cas_match");
        process_exit(1);
    }
    println("prod_g2_orderbook_stubs: PASSED");
}
