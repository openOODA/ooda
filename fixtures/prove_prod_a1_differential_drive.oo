// # Product prove std/auto_robot/differential_drive.oo
//
// Logline: Fail-closed emit+gcc+run asserts diff_v_left is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/differential_drive.oo.
//
// Beats:
//   1. Call diff_v_left twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_differential_drive: PASSED only if they match.

import "std/auto_robot/differential_drive.oo";

pub fn main() {
    let differential_drive_mark: Int = 0;
    if differential_drive_mark != 0 {
        process_exit(1);
    }
    let a: Int = diff_v_left(0, 0, 0);
    let b: Int = diff_v_left(0, 0, 0);
    if a != b {
        println("FAIL diff_v_left");
        process_exit(1);
    }
    println("prod_differential_drive: PASSED");
}
