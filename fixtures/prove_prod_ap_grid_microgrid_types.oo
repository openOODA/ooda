// # Product prove std/grid/microgrid_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/microgrid_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/microgrid_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_microgrid_types: PASSED only if they match.

import "std/grid/microgrid_types.oo";

pub fn main() {
    let microgrid_types_a = microgrid_state_new(0, 0);
    let microgrid_types_b = microgrid_state_new(0, 0);
    let microgrid_types_va = microgrid_state_load(microgrid_types_a);
    let microgrid_types_vb = microgrid_state_load(microgrid_types_b);
    if microgrid_types_va != microgrid_types_vb {
        println("FAIL microgrid_types");
        process_exit(1);
    }
    println("prod_ap_microgrid_types: PASSED");
}
