// # Product diag event timeline prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/event_timeline.oo.
//
// Setup: Product std/diag/event_timeline.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New count is 0.
//   2. Record twice then count is 2. Capacity 1 drops extra.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/event_timeline.oo";

pub fn main() {
    let t0: EventTimeline = event_timeline_new(2);
    let n0: Int = event_timeline_count(t0);
    if n0 != 0 {
        println("FAIL evtl 0");
        process_exit(1);
    }
    let t1: EventTimeline = event_timeline_record(t0, "a");
    let t2: EventTimeline = event_timeline_record(t1, "b");
    let n: Int = event_timeline_count(t2);
    if n != 2 {
        println("FAIL evtl 2");
        process_exit(1);
    }
    let t3: EventTimeline = event_timeline_record(t2, "c");
    let n3: Int = event_timeline_count(t3);
    if n3 != 2 {
        println("FAIL evtl cap");
        process_exit(1);
    }
    println("prod_evtl: PASSED");
}
