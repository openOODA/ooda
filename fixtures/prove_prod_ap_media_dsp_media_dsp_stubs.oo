// # Product prove std/media_dsp/media_dsp_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/media_dsp_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/media_dsp/media_dsp_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_media_dsp_stubs: PASSED only if they match.

import "std/media_dsp/media_dsp_stubs.oo";

pub fn main() {
    let media_dsp_stubs_a = media_dsp_capabilities_default();
    let media_dsp_stubs_b = media_dsp_capabilities_default();
    if media_dsp_stubs_a.max_sample_rate != media_dsp_stubs_b.max_sample_rate {
        println("FAIL media_dsp_stubs");
        process_exit(1);
    }
    println("prod_ap_media_dsp_stubs: PASSED");
}
