// # if 10 <= 010 is leftover
//
// Logline: Leading-zero INT order-compare must fail closed and not emit LE or GT.
//
// Setup: Decimal 010 is 10; C 010LL is octal 8. Folding either way is a wrong arm.
//
// Beats:
//   1. if 10 <= 010 print LE else print GT.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if 10 <= 010 {
        println("LE");
    } else {
        println("GT");
    }
}
