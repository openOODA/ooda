// # Product prove std/astro_advanced/attitude_triad_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts triad_yaw is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_triad_algorithm.oo.
//
// Beats:
//   1. Call triad_yaw twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attitude_triad_algorithm: PASSED only if they match.

import "std/astro_advanced/attitude_triad_algorithm.oo";

pub fn main() {
    let a = triad_yaw(0);
    let b = triad_yaw(0);
    if a != b {
        println("FAIL triad_yaw");
        process_exit(1);
    }
    println("prod_attitude_triad_algorithm: PASSED");
}
