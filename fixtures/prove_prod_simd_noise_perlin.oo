// # Product prove std/simd/simd_noise_perlin.oo
//
// Logline: Fail-closed emit+gcc+run asserts perlin_fade is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_noise_perlin.oo.
//
// Beats:
//   1. Call perlin_fade twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_noise_perlin: PASSED only if they match.

import "std/simd/simd_noise_perlin.oo";

pub fn main() {
    let a = perlin_fade(0.0);
    let b = perlin_fade(0.0);
    if a != b {
        println("FAIL perlin_fade");
        process_exit(1);
    }
    println("prod_simd_noise_perlin: PASSED");
}
