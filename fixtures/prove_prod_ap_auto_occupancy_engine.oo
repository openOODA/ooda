// # Product prove std/auto/occupancy_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/occupancy_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_occupancy_engine: PASSED only if they match.

import "std/auto/occupancy_engine.oo";

pub fn main() {
    let occupancy_engine_a = occ_eng_new(0, 0);
    let occupancy_engine_b = occ_eng_new(0, 0);
    let occupancy_engine_va = occ_eng_dim_x(occupancy_engine_a);
    let occupancy_engine_vb = occ_eng_dim_x(occupancy_engine_b);
    if occupancy_engine_va != occupancy_engine_vb {
        println("FAIL occupancy_engine");
        process_exit(1);
    }
    println("prod_ap_occupancy_engine: PASSED");
}
