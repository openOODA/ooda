// # Product prove std/database/wal_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts wal_recovery_state_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/wal_recovery.oo.
//
// Beats:
//   1. Call wal_recovery_state_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wal_recovery: PASSED only if they match.

import "std/database/wal_recovery.oo";

pub fn main() {
    let a: RecoveryState = wal_recovery_state_init();
    let b: RecoveryState = wal_recovery_state_init();
    if (a).last_checkpoint_lsn != (b).last_checkpoint_lsn {
        println("FAIL wal_recovery_state_init");
        process_exit(1);
    }
    println("prod_g2_wal_recovery: PASSED");
}
