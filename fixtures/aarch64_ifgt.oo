// # Const INT>INT if print
//
// Logline: Print GT from if 2>1 and LE from the else of if 1>2.
//
// Setup: Side emit-aarch64 folds INT GT INT only when LBRACE follows.
//
// Beats:
//   1. if 2 > 1 print GT.
//   2. if 1 > 2 else print LE.
//   3. Expect GT and LE.

pub fn main() {
    if 2 > 1 {
        println("GT");
    }
    if 1 > 2 {
        println("BAD");
    } else {
        println("LE");
    }
}
