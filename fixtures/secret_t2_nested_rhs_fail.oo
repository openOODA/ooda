// # Refuse nested wrap of a secret
//
// Logline: Pass a secret through wrap and outer, then print the result.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag api_key as secret.
//   2. Return the same string from wrap and outer.
//   3. Print outer(wrap(api_key)).
//
// SECRET: api_key
fn wrap(s: String) -> String { return s; }
fn outer(s: String) -> String { return wrap(s); }
pub fn main() {
    let api_key = "x";
    let y = outer(wrap(api_key));
    println(y);
}
