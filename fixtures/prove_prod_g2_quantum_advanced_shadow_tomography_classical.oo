// # Product prove std/quantum_advanced/shadow_tomography_classical.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadow_single_qubit_estimator is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shadow_tomography_classical.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call shadow_single_qubit_estimator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_shadow_tomography_classical: PASSED only if they match.

import "std/quantum_advanced/shadow_tomography_classical.oo";

pub fn main() {
    let g2_a = shadow_single_qubit_estimator(2, 2, 2);
    let g2_b = shadow_single_qubit_estimator(2, 2, 2);
    if g2_a != g2_b {
        println("FAIL shadow_single_qubit_estimator");
        process_exit(1);
    }
    println("prod_g2_shadow_tomography_classical: PASSED");
}
