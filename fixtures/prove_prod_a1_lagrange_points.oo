// # Product prove std/astrodynamics/lagrange_points.oo
//
// Logline: Fail-closed emit+gcc+run asserts lagrange_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/lagrange_points.oo.
//
// Beats:
//   1. Call lagrange_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lagrange_points: PASSED only if they match.

import "std/astrodynamics/lagrange_points.oo";

pub fn main() {
    let lagrange_points_mark: Int = 0;
    if lagrange_points_mark != 0 {
        process_exit(1);
    }
    let a: Int = lagrange_count();
    let b: Int = lagrange_count();
    if a != b {
        println("FAIL lagrange_count");
        process_exit(1);
    }
    println("prod_lagrange_points: PASSED");
}
