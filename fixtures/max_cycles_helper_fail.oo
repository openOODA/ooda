// # Helper exceeds cycle budget
//
// Logline: Burn ten iterations in a helper under a three-cycle per-fn budget.
//
// Beats:
//   1. Keep the three-cycle marker.
//   2. burn while-increments i to n.
//   3. main prints burn(10) so the helper trips.

// M92 MaxCycles on helper fn (shared per-fn, not main)
// MAX_CYCLES: 3
fn burn(n: Int) -> Int {
    let mut i = 0;
    while i < n {
        i = i + 1;
    }
    return i;
}
pub fn main() {
    println(burn(10));
}
