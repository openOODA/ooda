// # Product prove std/embedded_hal/usb_device_cdc.oo
//
// Logline: Fail-closed emit+gcc+run asserts usb_cdc_line_coding_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/usb_device_cdc.oo.
//
// Beats:
//   1. Call usb_cdc_line_coding_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_usb_device_cdc: PASSED only if they match.

import "std/embedded_hal/usb_device_cdc.oo";

pub fn main() {
    let usb_device_cdc_mark: Int = 0;
    if usb_device_cdc_mark != 0 {
        process_exit(1);
    }
    let a: UsbCdcLineCoding = usb_cdc_line_coding_new(0);
    let b: UsbCdcLineCoding = usb_cdc_line_coding_new(0);
    if (a).baud_rate != (b).baud_rate {
        println("FAIL usb_cdc_line_coding_new");
        process_exit(1);
    }
    println("prod_usb_device_cdc: PASSED");
}
