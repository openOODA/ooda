// # Product prove std/enterprise/audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/enterprise/audit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_audit: PASSED only if they match.

import "std/enterprise/audit.oo";

pub fn main() {
    let audit_a = audit_severity_code(0);
    let audit_b = audit_severity_code(0);
    if audit_a != audit_b {
        println("FAIL audit");
        process_exit(1);
    }
    println("prod_ap_audit: PASSED");
}
