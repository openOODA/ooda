// # Product prove std/physics_advanced/orbital_atmospheric_drag_nrlmsise.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermospheric_density_leo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/orbital_atmospheric_drag_nrlmsise.oo.
//
// Beats:
//   1. Call thermospheric_density_leo twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbital_atmospheric_drag_nrlmsise: PASSED only if they match.

import "std/physics_advanced/orbital_atmospheric_drag_nrlmsise.oo";

pub fn main() {
    let orbital_atmospheric_drag_nrlmsise_mark: Int = 0;
    if orbital_atmospheric_drag_nrlmsise_mark != 0 {
        process_exit(1);
    }
    let a: Float = thermospheric_density_leo(0.0);
    let b: Float = thermospheric_density_leo(0.0);
    if a != b {
        println("FAIL thermospheric_density_leo");
        process_exit(1);
    }
    println("prod_orbital_atmospheric_drag_nrlmsise: PASSED");
}
