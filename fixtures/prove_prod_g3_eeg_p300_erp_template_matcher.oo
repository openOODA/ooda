// # Product prove std/neuro_bci/eeg_p300_erp_template_matcher.oo
//
// Logline: Fail-closed emit+gcc+run asserts p300_template_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_p300_erp_template_matcher.oo.
//
// Beats:
//   1. Call p300_template_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eeg_p300_erp_template_matcher: PASSED only if they match.

import "std/neuro_bci/eeg_p300_erp_template_matcher.oo";

pub fn main() {
    let eeg_p300_erp_template_matcher_mark: Int = 0;
    if eeg_p300_erp_template_matcher_mark != 0 {
        process_exit(1);
    }
    let a: P300Template4 = p300_template_default();
    let b: P300Template4 = p300_template_default();
    if (a).p250_uv != (b).p250_uv {
        println("FAIL p300_template_default");
        process_exit(1);
    }
    println("prod_eeg_p300_erp_template_matcher: PASSED");
}
