// # Product prove std/hft_alpha/mm_tick_rule_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_tick_rule_classifier_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_tick_rule_classifier.oo.
//
// Beats:
//   1. Call mm_tick_rule_classifier_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_mm_tick_rule_classifier: PASSED only if it matches.

import "std/hft_alpha/mm_tick_rule_classifier.oo";

pub fn main() {
    let a: Int = mm_tick_rule_classifier_probe();
    if a != 0 {
        println("FAIL mm_tick_rule_classifier_probe");
        process_exit(1);
    }
    println("prod_nc_mm_tick_rule_classifier: PASSED");
}
