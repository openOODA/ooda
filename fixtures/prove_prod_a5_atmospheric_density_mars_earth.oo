// # Product prove std/space_propulsion/atmospheric_density_mars_earth.oo
//
// Logline: Fail-closed emit+gcc+run asserts atmosphere_earth_us76 is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/atmospheric_density_mars_earth.oo.
//
// Beats:
//   1. Call atmosphere_earth_us76 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atmospheric_density_mars_earth: PASSED only if they match.

import "std/space_propulsion/atmospheric_density_mars_earth.oo";

pub fn main() {
    let atmospheric_density_mars_earth_mark: Int = 0;
    if atmospheric_density_mars_earth_mark != 0 {
        process_exit(1);
    }
    let a: AtmosphereState = atmosphere_earth_us76(0.0);
    let b: AtmosphereState = atmosphere_earth_us76(0.0);
    if (a).altitude_m != (b).altitude_m {
        println("FAIL atmosphere_earth_us76");
        process_exit(1);
    }
    println("prod_atmospheric_density_mars_earth: PASSED");
}
