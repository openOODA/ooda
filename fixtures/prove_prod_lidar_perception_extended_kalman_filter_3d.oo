// # Product prove std/lidar_perception/extended_kalman_filter_3d.oo
//
// Logline: Fail-closed emit+check asserts mahalanobis_distance_sq_2d is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/extended_kalman_filter_3d.oo.
//
// Beats:
//   1. Call mahalanobis_distance_sq_2d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_extended_kalman_filter_3d: PASSED only if they match.

import "std/lidar_perception/extended_kalman_filter_3d.oo";

pub fn main() {
    let extended_kalman_filter_3d_mark: Int = 0;
    if extended_kalman_filter_3d_mark != 0 { process_exit(1); }
    let a: Float = mahalanobis_distance_sq_2d(1.0, 1.0, 1.0, 1.0);
    let b: Float = mahalanobis_distance_sq_2d(1.0, 1.0, 1.0, 1.0);
    if a != b { process_exit(1); }
    println("prod_extended_kalman_filter_3d: PASSED");
}
