// # Product prove std/deep_ai/flash_attention_backward.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_attention_backward_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/flash_attention_backward.oo.
//
// Beats:
//   1. Call flash_attention_backward_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flash_attention_backward: PASSED only if they match.

import "std/deep_ai/flash_attention_backward.oo";

pub fn main() {
    let flash_attention_backward_mark: Int = 0;
    if flash_attention_backward_mark != 0 {
        process_exit(1);
    }
    let flash_attention_backward_a: Int = flash_attention_backward_marker();
    let flash_attention_backward_b: Int = flash_attention_backward_marker();
    if flash_attention_backward_a != flash_attention_backward_b {
        println("FAIL flash_attention_backward_marker");
        process_exit(1);
    }
    println("prod_flash_attention_backward: PASSED");
}
