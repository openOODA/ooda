// # Product prove std/graph_networks/chord_dht_finger_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts chord_pow2 is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/chord_dht_finger_table.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call chord_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_chord_dht_finger_table: PASSED only if they match.

import "std/graph_networks/chord_dht_finger_table.oo";

pub fn main() {
    let g0_a = chord_pow2(0);
    let g0_b = chord_pow2(0);
    if g0_a != g0_b {
        println("FAIL chord_pow2");
        process_exit(1);
    }
    println("prod_gr_chord_dht_finger_table: PASSED");
}
