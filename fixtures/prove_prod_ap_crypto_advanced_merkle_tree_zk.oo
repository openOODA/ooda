// # Product prove std/crypto_advanced/merkle_tree_zk.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/merkle_tree_zk.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/merkle_tree_zk.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_merkle_tree_zk: PASSED only if they match.

import "std/crypto_advanced/merkle_tree_zk.oo";

pub fn main() {
    let merkle_tree_zk_a = merkle_zk_derive_nullifier("x", 0);
    let merkle_tree_zk_b = merkle_zk_derive_nullifier("x", 0);
    if merkle_tree_zk_a.contains(merkle_tree_zk_b) == false {
        println("FAIL merkle_tree_zk");
        process_exit(1);
    }
    if merkle_tree_zk_b.contains(merkle_tree_zk_a) == false {
        println("FAIL merkle_tree_zk");
        process_exit(1);
    }
    println("prod_ap_merkle_tree_zk: PASSED");
}
