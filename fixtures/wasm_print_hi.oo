// # Println literal for WASI emit
//
// Logline: Print Hello, openOODA! so emit-wasm can plant a WASI fd_write body.
//
// Setup: No imports. One public main. The body is only a println of that literal.
//
// Beats:
//   1. Declare public main.
//   2. Print the Hello, openOODA! literal.
//   3. Leave no other statements so wasm_fn_println_lit can see a print-only body.

pub fn main() { println("Hello, openOODA!"); }
