// # Product prove std/wasm_gc/wasm_gc_i31_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/wasm_gc/wasm_gc_i31_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_i31_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_gc_i31_ops: PASSED only if they match.

import "std/wasm_gc/wasm_gc_i31_ops.oo";

pub fn main() {
    let wasm_gc_i31_ops_a = i31_max_signed();
    let wasm_gc_i31_ops_b = i31_max_signed();
    if wasm_gc_i31_ops_a != wasm_gc_i31_ops_b {
        println("FAIL wasm_gc_i31_ops");
        process_exit(1);
    }
    println("prod_ap_wasm_gc_i31_ops: PASSED");
}
