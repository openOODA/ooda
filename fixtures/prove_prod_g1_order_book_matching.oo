// # Product prove std/fintech_defi/order_book_matching.oo
//
// Logline: Fail-closed emit+gcc+run asserts l3_book_order_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/order_book_matching.oo.
//
// Beats:
//   1. Call l3_book_order_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_order_book_matching: PASSED only if they match.

import "std/fintech_defi/order_book_matching.oo";

pub fn main() {
    let a: L3BookOrder = l3_book_order_new(0, "x", true, 0, 0, 0);
    let b: L3BookOrder = l3_book_order_new(0, "x", true, 0, 0, 0);
    if a.order_id != b.order_id {
        println("FAIL l3_book_order_new");
        process_exit(1);
    }
    println("prod_order_book_matching: PASSED");
}
