// # Fail a simple requires clause
//
// Logline: A simple requires x >= 0 fails at runtime on a negative argument.
//
// Beats:
//   1. Require x non-negative on pos.
//   2. Call pos with 0 - 1.
//   3. Trip the runtime contract rail.

// Fail-at-runtime: requires x >= 0 violated → non-zero + contract message
pub fn pos(x: Int) -> Int
    requires x >= 0
{
    return x + 1;
}

pub fn main() {
    println(pos(0 - 1));
}
