// # Product prove std/wasm_gc/wasm_gc_struct_new.oo
//
// Logline: Fail-closed emit+gcc+run asserts gc_struct_descriptor_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_struct_new.oo.
//
// Beats:
//   1. Call gc_struct_descriptor_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_gc_struct_new: PASSED only if they match.

import "std/wasm_gc/wasm_gc_struct_new.oo";

pub fn main() {
    let wasm_gc_struct_new_mark: Int = 0;
    if wasm_gc_struct_new_mark != 0 {
        process_exit(1);
    }
    let a: GcStructDescriptor = gc_struct_descriptor_new(0);
    let b: GcStructDescriptor = gc_struct_descriptor_new(0);
    if (a).type_index != (b).type_index {
        println("FAIL gc_struct_descriptor_new");
        process_exit(1);
    }
    println("prod_g2_wasm_gc_struct_new: PASSED");
}
