// # Product prove std/quantum_advanced/vqe_energy_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts optimizer_param_shift_step is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_energy_optimizer.oo.
//
// Beats:
//   1. Call optimizer_param_shift_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vqe_energy_optimizer: PASSED only if they match.

import "std/quantum_advanced/vqe_energy_optimizer.oo";

pub fn main() {
    let vqe_energy_optimizer_mark: Int = 0;
    if vqe_energy_optimizer_mark != 0 {
        process_exit(1);
    }
    let vqe_energy_optimizer_a: Float = optimizer_param_shift_step(1.0, 1.0);
    let vqe_energy_optimizer_b: Float = optimizer_param_shift_step(1.0, 1.0);
    if vqe_energy_optimizer_a != vqe_energy_optimizer_b {
        println("FAIL optimizer_param_shift_step");
        process_exit(1);
    }
    println("prod_vqe_energy_optimizer: PASSED");
}
