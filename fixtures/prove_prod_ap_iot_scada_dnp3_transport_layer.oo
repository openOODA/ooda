// # Product prove std/iot_scada/dnp3_transport_layer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/dnp3_transport_layer.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/iot_scada/dnp3_transport_layer.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_dnp3_transport_layer: PASSED only if they match.

import "std/iot_scada/dnp3_transport_layer.oo";

pub fn main() {
    let dnp3_transport_layer_a = dnp3_transport_header_new(true, true, 0);
    let dnp3_transport_layer_b = dnp3_transport_header_new(true, true, 0);
    if dnp3_transport_layer_a.is_fir != dnp3_transport_layer_b.is_fir {
        println("FAIL dnp3_transport_layer");
        process_exit(1);
    }
    println("prod_ap_dnp3_transport_layer: PASSED");
}
