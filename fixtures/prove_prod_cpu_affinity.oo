// # Product prove std/os/cpu_affinity.oo
//
// Logline: Fail-closed emit+gcc+run asserts cpu_set_is_set is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/cpu_affinity.oo.
//
// Beats:
//   1. Call cpu_set_is_set twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cpu_affinity: PASSED only if they match.

import "std/os/cpu_affinity.oo";

pub fn main() {
    let obj = cpu_set_new(0);
    let a = cpu_set_is_set(obj, 0);
    let b = cpu_set_is_set(obj, 0);
    if a != b {
        println("FAIL cpu_set_is_set");
        process_exit(1);
    }
    println("prod_cpu_affinity: PASSED");
}
