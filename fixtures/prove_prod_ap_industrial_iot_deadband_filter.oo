// # Product prove std/industrial_iot/deadband_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_iot/deadband_filter.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/deadband_filter.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_deadband_filter: PASSED only if they match.

import "std/industrial_iot/deadband_filter.oo";

pub fn main() {
    let deadband_filter_a = deadband_filter_new(0.0);
    let deadband_filter_b = deadband_filter_new(0.0);
    if deadband_filter_a.deadband_value != deadband_filter_b.deadband_value {
        println("FAIL deadband_filter");
        process_exit(1);
    }
    println("prod_ap_deadband_filter: PASSED");
}
