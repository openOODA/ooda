// # Product prove std/quantum/qasm_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts parse_int_from_str holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/qasm_parser.oo.
//
// Beats:
//   1. Call parse_int_from_str using the qasm_parser ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_qasm_parser: PASSED only if asserts hold.

import "std/quantum/qasm_parser.oo";

pub fn main() {
    let qasm_parser_a = parse_int_from_str("x");
    let qasm_parser_b = parse_int_from_str("x");
    if qasm_parser_a != qasm_parser_b {
        println("FAIL parse_int_from_str");
        process_exit(1);
    }
    println("prod_qasm_parser: PASSED");
}
