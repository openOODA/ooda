// # Product prove std/db_columnar/columnar_rolling_window.oo
//
// Logline: Fail-closed emit+gcc+run asserts window_frame_config_sliding is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_rolling_window.oo.
//
// Beats:
//   1. Call window_frame_config_sliding twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_rolling_window: PASSED only if they match.

import "std/db_columnar/columnar_rolling_window.oo";

pub fn main() {
    let columnar_rolling_window_mark: Int = 0;
    if columnar_rolling_window_mark != 0 {
        process_exit(1);
    }
    let a: WindowFrameConfig = window_frame_config_sliding(0);
    let b: WindowFrameConfig = window_frame_config_sliding(0);
    if (a).window_size != (b).window_size {
        println("FAIL window_frame_config_sliding");
        process_exit(1);
    }
    println("prod_columnar_rolling_window: PASSED");
}
