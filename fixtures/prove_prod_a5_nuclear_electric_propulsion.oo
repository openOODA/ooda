// # Product prove std/space_propulsion/nuclear_electric_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts nep_system_spec_default_1mwe is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/nuclear_electric_propulsion.oo.
//
// Beats:
//   1. Call nep_system_spec_default_1mwe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nuclear_electric_propulsion: PASSED only if they match.

import "std/space_propulsion/nuclear_electric_propulsion.oo";

pub fn main() {
    let nuclear_electric_propulsion_mark: Int = 0;
    if nuclear_electric_propulsion_mark != 0 {
        process_exit(1);
    }
    let a: NepSystemSpec = nep_system_spec_default_1mwe();
    let b: NepSystemSpec = nep_system_spec_default_1mwe();
    if (a).reactor_thermal_power_kw != (b).reactor_thermal_power_kw {
        println("FAIL nep_system_spec_default_1mwe");
        process_exit(1);
    }
    println("prod_nuclear_electric_propulsion: PASSED");
}
