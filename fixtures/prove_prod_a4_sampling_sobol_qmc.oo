// # Product prove std/pbr_raytracing/sampling_sobol_qmc.oo
//
// Logline: Fail-closed emit+gcc+run asserts van_der_corput_base2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/sampling_sobol_qmc.oo.
//
// Beats:
//   1. Call van_der_corput_base2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sampling_sobol_qmc: PASSED only if they match.

import "std/pbr_raytracing/sampling_sobol_qmc.oo";

pub fn main() {
    let sampling_sobol_qmc_mark: Int = 0;
    if sampling_sobol_qmc_mark != 0 {
        process_exit(1);
    }
    let a: Float = van_der_corput_base2(0);
    let b: Float = van_der_corput_base2(0);
    if a != b {
        println("FAIL van_der_corput_base2");
        process_exit(1);
    }
    println("prod_sampling_sobol_qmc: PASSED");
}
