// # Product prove std/astro_advanced/mars_aerocapture_corridor.oo
//
// Logline: Fail-closed emit+gcc+run asserts aero_corridor_km is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/mars_aerocapture_corridor.oo.
//
// Beats:
//   1. Call aero_corridor_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mars_aerocapture_corridor: PASSED only if they match.

import "std/astro_advanced/mars_aerocapture_corridor.oo";

pub fn main() {
    let mars_aerocapture_corridor_mark: Int = 0;
    if mars_aerocapture_corridor_mark != 0 {
        process_exit(1);
    }
    let a: Int = aero_corridor_km();
    let b: Int = aero_corridor_km();
    if a != b {
        println("FAIL aero_corridor_km");
        process_exit(1);
    }
    println("prod_mars_aerocapture_corridor: PASSED");
}
