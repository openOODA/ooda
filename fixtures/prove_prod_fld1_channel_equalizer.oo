// # Product prove std/telecom/channel_equalizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts equalizer_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/channel_equalizer.oo.
//
// Beats:
//   1. Call equalizer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_channel_equalizer: PASSED only if they match.

import "std/telecom/channel_equalizer.oo";

pub fn main() {
    let channel_equalizer_mark: Int = 0;
    if channel_equalizer_mark != 0 {
        process_exit(1);
    }
    let channel_equalizer_a = equalizer_config_new(1, 1.0);
    let channel_equalizer_b = equalizer_config_new(1, 1.0);
    if (channel_equalizer_a).algo_type != (channel_equalizer_b).algo_type {
        println("FAIL equalizer_config_new");
        process_exit(1);
    }
    println("prod_channel_equalizer: PASSED");
}
