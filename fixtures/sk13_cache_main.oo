// # Entry for per-module .o warm build
//
// Logline: Import sk13_cache_lib and print sk13_n so warm rebuild stays 3.
//
// Setup: Isolated oodac build. Two modules.
//
// Beats:
//   1. Import the lib.
//   2. Call sk13_n in main.
//   3. Print the Int.

import "sk13_cache_lib.oo";

pub fn main() {
    let n: Int = sk13_n();
    println(n);
}
