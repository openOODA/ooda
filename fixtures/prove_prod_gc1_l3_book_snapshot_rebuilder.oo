// # Product prove std/fintech_l3_book/l3_book_snapshot_rebuilder.oo
//
// Logline: Fail-closed emit+gcc+run asserts snapshot_checkpoint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_book_snapshot_rebuilder.oo.
//
// Beats:
//   1. Call snapshot_checkpoint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_book_snapshot_rebuilder: PASSED only if they match.

import "std/fintech_l3_book/l3_book_snapshot_rebuilder.oo";

pub fn main() {
    let l3_book_snapshot_rebuilder_mark: Int = 0;
    if l3_book_snapshot_rebuilder_mark != 0 {
        process_exit(1);
    }
    let l3_book_snapshot_rebuilder_a = snapshot_checkpoint_new(1, 1, 1, 1);
    let l3_book_snapshot_rebuilder_b = snapshot_checkpoint_new(1, 1, 1, 1);
    if (l3_book_snapshot_rebuilder_a).sequence_number != (l3_book_snapshot_rebuilder_b).sequence_number {
        println("FAIL snapshot_checkpoint_new");
        process_exit(1);
    }
    println("prod_l3_book_snapshot_rebuilder: PASSED");
}
