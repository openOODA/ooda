// # Result[Int] emit lock
//
// Logline: Fail-closed emit+gcc+run of Result[Int, String] Ok payload as Int.
//
// Setup: Backend-C. Ok(7) must stay Int, not oo_int_to_str.
//
// Beats:
//   1. f returns Ok(7).
//   2. Match binds n as Int 7.
//   3. Exit 1 before PASSED on a miss.

pub fn f() -> Result[Int, String] {
    return Ok(7);
}

pub fn main() {
    let r: Result[Int, String] = f();
    let n: Int = match r {
        Ok(v) => v,
        Err(e) => 0
    };
    if n != 7 {
        println("FAIL");
        process_exit(1);
    }
    println("result_int_smoke: PASSED");
}
