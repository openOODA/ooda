// # Product prove std/synthetic_biology/yield_stoichiometry_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts yield_calc_degree_of_reduction is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/yield_stoichiometry_calculator.oo.
//
// Beats:
//   1. Call yield_calc_degree_of_reduction twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_calc_gamma: PASSED only if they match.

import "std/synthetic_biology/yield_stoichiometry_calculator.oo";

pub fn main() {
    let yield_stoichiometry_calculator_mark: Int = 0;
    if yield_stoichiometry_calculator_mark != 0 { process_exit(1); }
    let f: ChemicalFormula = ChemicalFormula { name: "glucose", carbon_atoms: 6, hydrogen_atoms: 12, oxygen_atoms: 6, nitrogen_atoms: 0, molecular_weight_g_mol: 180.0 };
    let a: Float = yield_calc_degree_of_reduction(&f);
    let b: Float = yield_calc_degree_of_reduction(&f);
    if a != b {
        println("FAIL yield_calc_degree_of_reduction");
        process_exit(1);
    }
    println("prod_yield_calc_gamma: PASSED");
}
