// # Product prove std/pbr_raytracing/sampling_sobol_qmc.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pbr_raytracing/sampling_sobol_qmc.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/sampling_sobol_qmc.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sampling_sobol_qmc: PASSED only if they match.

import "std/pbr_raytracing/sampling_sobol_qmc.oo";

pub fn main() {
    let sampling_sobol_qmc_a = van_der_corput_base2(0);
    let sampling_sobol_qmc_b = van_der_corput_base2(0);
    if sampling_sobol_qmc_a != sampling_sobol_qmc_b {
        println("FAIL sampling_sobol_qmc");
        process_exit(1);
    }
    println("prod_ap_sampling_sobol_qmc: PASSED");
}
