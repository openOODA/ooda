// # Simple ensures pass
//
// Logline: Increment a non-negative int and keep result >= 0.
//
// Beats:
//   1. Require x >= 0.
//   2. Ensure result >= 0 and return x + 1.
//   3. Print pos(1).

// Pass: simple ensures result OP INT runtime-enforced
pub fn pos(x: Int) -> Int
    requires x >= 0
    ensures result >= 0
{
    return x + 1;
}

pub fn main() {
    println(pos(1));
}
