// # Product prove std/pbr_raytracing/pathtrace_next_event_estimation.oo
//
// Logline: Fail-closed emit+gcc+run asserts pathtrace_next_event_estimation_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pathtrace_next_event_estimation.oo.
//
// Beats:
//   1. Call pathtrace_next_event_estimation_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pathtrace_next_event_estimation: PASSED only if it matches.

import "std/pbr_raytracing/pathtrace_next_event_estimation.oo";

pub fn main() {
    let a: Int = pathtrace_next_event_estimation_probe();
    if a != 0 {
        println("FAIL pathtrace_next_event_estimation_probe");
        process_exit(1);
    }
    println("prod_nc_pathtrace_next_event_estimation: PASSED");
}
