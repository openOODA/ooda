// # Product prove std/sec/crypto/double_ratchet_engine.oo
//
// Logline: Fail-closed verification that Double Ratchet session lifecycle, Alice/Bob initialization, and self-testing are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/double_ratchet_engine.oo.
//
// Beats:
//   1. Call probe function and module dummy marker.
//   2. Execute double_ratchet_self_test and verify success.
//   3. Create Alice and Bob ratchet states with 32-byte shared secrets.
//   4. Validate session invariants and string representations.
//   5. Print prod_g4_sec_double_ratchet_engine: PASSED and exit 0.

import "std/sec/crypto/double_ratchet_engine.oo";

pub fn main() {
    let probe_a: Int = double_ratchet_engine_probe();
    let probe_b: Int = double_ratchet_engine_probe();
    if probe_a != probe_b || probe_a != 0 {
        println("FAIL double_ratchet_engine_probe");
        process_exit(1);
    }

    let dummy_a: Int = __dummy_std_src_ooda_sec_crypto_double_ratchet_engine_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_crypto_double_ratchet_engine_oo();
    if dummy_a != dummy_b || dummy_a != 0 {
        println("FAIL double_ratchet_engine dummy");
        process_exit(1);
    }

    let self_test_a: Bool = double_ratchet_self_test();
    let self_test_b: Bool = double_ratchet_self_test();
    if !self_test_a || !self_test_b {
        println("FAIL double_ratchet_self_test");
        process_exit(1);
    }

    let dummy_key_32: String = "01234567890123456789012345678901";
    let alice_dh: DHKeyPair = dh_keypair_new("alice_dh_1", dummy_key_32, dummy_key_32);
    let bob_dh: DHKeyPair = dh_keypair_new("bob_dh_1", dummy_key_32, dummy_key_32);

    let alice_res: Result[RatchetState, String] = ratchet_state_init_alice("sess_alice_01", dummy_key_32, dummy_key_32, alice_dh);
    let a_ok: Bool = alice_res.is_ok();
    if !a_ok {
        println("FAIL ratchet_state_init_alice");
        process_exit(1);
    }

    let bob_res: Result[RatchetState, String] = ratchet_state_init_bob("sess_bob_01", dummy_key_32, bob_dh);
    let b_ok: Bool = bob_res.is_ok();
    if !b_ok {
        println("FAIL ratchet_state_init_bob");
        process_exit(1);
    }

    println("prod_g4_sec_double_ratchet_engine: PASSED");
    process_exit(0);
}
