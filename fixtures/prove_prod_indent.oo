// # Product indent prove
//
// Logline: Fail-closed emit+gcc+run of shipped indent_line.
//
// Setup: Product std/text/indent_formatter.oo. Default 4 spaces.
//
// Beats:
//   1. indent_line x level 1 is four spaces then x.
//   2. Empty line stays empty.
//   3. Exit 1 before PASSED on a miss.

import "std/text/indent_formatter.oo";

pub fn main() {
    let cfg: IndentConfig = indent_config_default();
    let s: String = indent_line("x", 1, cfg);
    if s != "    x" {
        println("FAIL indent");
        process_exit(1);
    }
    let e: String = indent_line("", 2, cfg);
    if e != "" {
        println("FAIL indent empty");
        process_exit(1);
    }
    println("prod_indent: PASSED");
}
