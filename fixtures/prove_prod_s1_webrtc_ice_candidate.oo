// # Product prove std/web_protocols/webrtc_ice_candidate.oo
//
// Logline: Fail-closed emit+gcc+run asserts ice_candidate_compute_priority is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/webrtc_ice_candidate.oo.
//
// Beats:
//   1. Call ice_candidate_compute_priority twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_webrtc_ice_candidate: PASSED only if they match.

import "std/web_protocols/webrtc_ice_candidate.oo";

pub fn main() {
    let webrtc_ice_candidate_mark: Int = 0;
    if webrtc_ice_candidate_mark != 0 {
        process_exit(1);
    }
    let webrtc_ice_candidate_a: Int = ice_candidate_compute_priority(1, 1, 1);
    let webrtc_ice_candidate_b: Int = ice_candidate_compute_priority(1, 1, 1);
    if webrtc_ice_candidate_a != webrtc_ice_candidate_b {
        println("FAIL ice_candidate_compute_priority");
        process_exit(1);
    }
    println("prod_webrtc_ice_candidate: PASSED");
}
