// # Product cloud load balancer rr prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/cloud/load_balancer_rr.oo.
//
// Setup: Product std/cloud/load_balancer_rr.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new last_pick -1 request 0. first select of 5,1 is 0.
//   9. Exit 1 before PASSED on a miss.

import "std/cloud/load_balancer_rr.oo";

pub fn main() {
    let lb: LoadBalancerRr = load_balancer_rr_new(5, 1);
    let p0: Int = load_balancer_last_pick(lb);
    if p0 != -1 {
        println("FAIL lb init pick");
        process_exit(1);
    }
    let n0: Int = load_balancer_request_n(lb);
    if n0 != 0 {
        println("FAIL lb n0");
        process_exit(1);
    }
    let lb1: LoadBalancerRr = load_balancer_select_server(lb);
    let p1: Int = load_balancer_last_pick(lb1);
    if p1 != 0 {
        println("FAIL lb pick0");
        process_exit(1);
    }
    let n1: Int = load_balancer_request_n(lb1);
    if n1 != 1 {
        println("FAIL lb n1");
        process_exit(1);
    }
    println("prod_lbrr: PASSED");
}
