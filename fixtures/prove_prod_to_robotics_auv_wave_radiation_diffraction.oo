// # Product prove std/robotics_auv/wave_radiation_diffraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts wave_length_deep_water holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/wave_radiation_diffraction.oo.
//
// Beats:
//   1. Call wave_length_deep_water using the wave_radiation_diffraction ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_wave_radiation_diffraction: PASSED only if asserts hold.

import "std/robotics_auv/wave_radiation_diffraction.oo";

pub fn main() {
    let wave_radiation_diffraction_a = wave_length_deep_water(0.0);
    let wave_radiation_diffraction_b = wave_length_deep_water(0.0);
    if wave_radiation_diffraction_a != wave_radiation_diffraction_b {
        println("FAIL wave_length_deep_water");
        process_exit(1);
    }
    println("prod_wave_radiation_diffraction: PASSED");
}
