// # Product prove std/hft_alpha/mm_cartea_jaimungal_drift.oo
//
// Logline: Fail-closed emit+gcc+run asserts cj_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_cartea_jaimungal_drift.oo.
//
// Beats:
//   1. Call cj_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_cartea_jaimungal_drift: PASSED only if they match.

import "std/hft_alpha/mm_cartea_jaimungal_drift.oo";

pub fn main() {
    let mm_cartea_jaimungal_drift_mark: Int = 0;
    if mm_cartea_jaimungal_drift_mark != 0 {
        process_exit(1);
    }
    let a: CjParams = cj_params_new(0.0, 0.0, 0.0, 0.0);
    let b: CjParams = cj_params_new(0.0, 0.0, 0.0, 0.0);
    if (a).gamma_inventory_risk != (b).gamma_inventory_risk {
        println("FAIL cj_params_new");
        process_exit(1);
    }
    println("prod_g2_mm_cartea_jaimungal_drift: PASSED");
}
