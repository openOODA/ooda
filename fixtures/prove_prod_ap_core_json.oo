// # Product prove std/core/json.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/core/json.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/core/json.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_json: PASSED only if they match.

import "std/core/json.oo";

pub fn main() {
    let json_a: String = stringify("hi");
    if chars_len(json_a) != 2 {
        println("FAIL json");
        process_exit(1);
    }
    println("prod_ap_json: PASSED");
}
