// # Product prove std/exploit_analysis/ret2csu_gadget_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ret2csu_call_frame_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/ret2csu_gadget_analyzer.oo.
//
// Beats:
//   1. Call ret2csu_call_frame_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ret2csu_gadget_analyzer: PASSED only if they match.

import "std/exploit_analysis/ret2csu_gadget_analyzer.oo";

pub fn main() {
    let a: CsuCallFrame = ret2csu_call_frame_new(0, 0, 0, 0);
    let b: CsuCallFrame = ret2csu_call_frame_new(0, 0, 0, 0);
    if a.func_got_pointer != b.func_got_pointer {
        println("FAIL ret2csu_call_frame_new");
        process_exit(1);
    }
    println("prod_ret2csu_gadget_analyzer: PASSED");
}
