// # Product prove std/perf/perf_counters.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/perf_counters.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/perf_counters.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_perf_counters: PASSED only if they match.

import "std/perf/perf_counters.oo";

pub fn main() {
    let perf_counters_a = perf_counters_create("x");
    let perf_counters_b = perf_counters_create("x");
    let perf_counters_va = perf_counters_cycles(perf_counters_a);
    let perf_counters_vb = perf_counters_cycles(perf_counters_b);
    if perf_counters_va != perf_counters_vb {
        println("FAIL perf_counters");
        process_exit(1);
    }
    println("prod_ap_perf_counters: PASSED");
}
