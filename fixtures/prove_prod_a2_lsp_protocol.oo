// # Product prove std/compilers/lsp_protocol.oo
//
// Logline: Fail-closed emit+gcc+run asserts lsp_position_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_protocol.oo.
//
// Beats:
//   1. Call lsp_position_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lsp_protocol: PASSED only if they match.

import "std/compilers/lsp_protocol.oo";

pub fn main() {
    let lsp_protocol_mark: Int = 0;
    if lsp_protocol_mark != 0 {
        process_exit(1);
    }
    let a: LspPosition = lsp_position_new(0, 0);
    let b: LspPosition = lsp_position_new(0, 0);
    if (a).line != (b).line {
        println("FAIL lsp_position_new");
        process_exit(1);
    }
    println("prod_lsp_protocol: PASSED");
}
