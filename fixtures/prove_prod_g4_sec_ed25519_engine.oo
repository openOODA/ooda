// # Product prove std/sec/crypto/ed25519_engine.oo
//
// Logline: Fail-closed verification that Ed25519 engine lifecycle, security policies, and batch verifiers are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519_engine.oo.
//
// Beats:
//   1. Initialize Ed25519SecurityPolicy and Ed25519Engine.
//   2. Initialize Ed25519BatchVerifier and evaluate engine work metrics.
//   3. Assert deterministic return values.
//   4. Print prod_g4_sec_ed25519_engine: PASSED and exit 0.

import "std/sec/crypto/ed25519_engine.oo";

pub fn main() {
    let pol_a: Ed25519SecurityPolicy = ed25519_policy_init(false, true);
    let pol_b: Ed25519SecurityPolicy = ed25519_policy_init(false, true);
    if (pol_a).fail_closed != (pol_b).fail_closed || !(pol_a).fail_closed {
        println("FAIL ed25519_policy_init fail_closed");
        process_exit(1);
    }
    if (pol_a).require_sys_cap != (pol_b).require_sys_cap || (pol_a).require_sys_cap {
        println("FAIL ed25519_policy_init require_sys_cap");
        process_exit(1);
    }

    let eng_a: Ed25519Engine = ed25519_engine_init("eng_01", pol_a);
    let eng_b: Ed25519Engine = ed25519_engine_init("eng_01", pol_b);
    if (eng_a).signed_count != (eng_b).signed_count || (eng_a).signed_count != 0 {
        println("FAIL ed25519_engine_init signed_count");
        process_exit(1);
    }

    let work_a: Int = ed25519_engine_do_work(&eng_a);
    let work_b: Int = ed25519_engine_do_work(&eng_b);
    if work_a != work_b || work_a != 0 {
        println("FAIL ed25519_engine_do_work");
        process_exit(1);
    }

    let batch_a: Ed25519BatchVerifier = ed25519_batch_verifier_init("batch_01");
    let batch_b: Ed25519BatchVerifier = ed25519_batch_verifier_init("batch_01");
    if (batch_a).total_signatures != (batch_b).total_signatures || (batch_a).total_signatures != 0 {
        println("FAIL ed25519_batch_verifier_init total_signatures");
        process_exit(1);
    }

    println("prod_g4_sec_ed25519_engine: PASSED");
    process_exit(0);
}
