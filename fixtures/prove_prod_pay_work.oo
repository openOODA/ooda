// # Product prove std/net/pay_work.oo
//
// Logline: Fail-closed emit+gcc+run asserts pay_work_hex_zero_bits on a known hex.
//
// Setup: Isolated emit-c. Imports std/net/pay_work.oo.
//
// Beats:
//   1. Call pay_work_hex_zero_bits on a hex string of zeros.
//   2. Exit 1 if the bit count is not positive.
//   3. Print prod_pay_work: PASSED only if the assert holds.

import "std/net/pay_work.oo";

pub fn main() {
    let n: Int = pay_work_hex_zero_bits("00");
    if n < 1 {
        println("FAIL pay_work_hex_zero_bits");
        process_exit(1);
    }
    let n2: Int = pay_work_hex_zero_bits("00");
    if n != n2 {
        println("FAIL pay_work_hex_zero_bits det");
        process_exit(1);
    }
    println("prod_pay_work: PASSED");
}
