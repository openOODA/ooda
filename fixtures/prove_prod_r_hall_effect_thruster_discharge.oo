// # Product prove std/space_propulsion/hall_effect_thruster_discharge.oo
//
// Logline: Fail-closed emit+gcc+run asserts hall_thruster_spec_default_5kw value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/hall_effect_thruster_discharge.oo.
//
// Beats:
//   1. Call hall_thruster_spec_default_5kw twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_hall_effect_thruster_discharge: PASSED only if asserts hold.

import "std/space_propulsion/hall_effect_thruster_discharge.oo";

pub fn main() {
    let hall_effect_thruster_discharge = hall_thruster_spec_default_5kw();
    let hall_effect_thruster_discharge_b = hall_thruster_spec_default_5kw();
    if hall_effect_thruster_discharge.discharge_voltage_v != 300.0 {
        println("FAIL hall_thruster_spec_default_5kw discharge_voltage_v");
        process_exit(1);
    }
    if hall_effect_thruster_discharge.discharge_voltage_v != hall_effect_thruster_discharge_b.discharge_voltage_v {
        println("FAIL hall_thruster_spec_default_5kw det");
        process_exit(1);
    }
    println("prod_hall_effect_thruster_discharge: PASSED");
}
