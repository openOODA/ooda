// # Product prove std/physics_advanced/lattice_boltzmann_d2q9.oo
//
// Logline: Fail-closed emit+gcc+run asserts d2q9_weight is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_d2q9.oo.
//
// Beats:
//   1. Call d2q9_weight twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lattice_boltzmann_d2q9: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_d2q9.oo";

pub fn main() {
    let lattice_boltzmann_d2q9_mark: Int = 0;
    if lattice_boltzmann_d2q9_mark != 0 {
        process_exit(1);
    }
    let a: Float = d2q9_weight(0);
    let b: Float = d2q9_weight(0);
    if a != b {
        println("FAIL d2q9_weight");
        process_exit(1);
    }
    println("prod_lattice_boltzmann_d2q9: PASSED");
}
