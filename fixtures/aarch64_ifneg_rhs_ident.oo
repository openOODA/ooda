// # if 1 > -x is leftover
//
// Logline: INT GT MINUS IDENT must fail closed and not emit YES.
//
// Setup: x is a bind, not a const INT after minus. Sibling of locked INT OP -INT.
//
// Beats:
//   1. Bind x to 0.
//   2. if 1 > -x print YES.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = 0;
    if 1 > -x {
        println("YES");
    }
}
