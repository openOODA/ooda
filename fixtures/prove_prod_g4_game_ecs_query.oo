// # Product prove std/game_engine/ecs_query.oo
//
// Logline: Fail-closed emit+gcc+run asserts ECS archetype and component queries are deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/ecs_query.oo.
//
// Beats:
//   1. Construct renderable and physics component bitmask queries.
//   2. Evaluate entity mask matching against component bitmasks.
//   3. Track query match execution statistics.
//   4. Print prod_g4_game_ecs_query: PASSED and exit 0.

import "std/game_engine/ecs_query.oo";

pub fn main() {
    let q_rend: ComponentQuery = query_renderable_2d();
    let q_phys: ComponentQuery = query_physics_2d();

    let m_rend1: Int = query_matches_mask(&q_rend, (q_rend).all_mask);
    let m_rend2: Int = query_matches_mask(&q_rend, (q_rend).all_mask);
    if m_rend1 != m_rend2 || m_rend1 != 1 {
        println("FAIL query_matches_mask renderable");
        process_exit(1);
    }

    let m_miss: Int = query_matches_mask(&q_rend, 0);
    if m_miss != 0 {
        println("FAIL query_matches_mask zero");
        process_exit(1);
    }

    let custom_q: ComponentQuery = query_with_filter(3, 0, 4);
    let m_filt: Int = query_matches_mask(&custom_q, 3);
    if m_filt != 1 {
        println("FAIL query_with_filter match");
        process_exit(1);
    }

    let mut stats: QueryResult = query_result_new();
    stats = query_result_add_match(stats);
    stats = query_result_add_miss(stats);
    if (stats).matched_count != 1 || (stats).total_scanned != 2 {
        println("FAIL query_result tracking");
        process_exit(1);
    }

    println("prod_g4_game_ecs_query: PASSED");
    process_exit(0);
}
