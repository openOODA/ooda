// # Product prove std/bioinformatics/protein_translation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/protein_translation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/protein_translation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_protein_translation: PASSED only if they match.

import "std/bioinformatics/protein_translation.oo";

pub fn main() {
    let protein_translation_a = int_pow4(0);
    let protein_translation_b = int_pow4(0);
    if protein_translation_a != protein_translation_b {
        println("FAIL protein_translation");
        process_exit(1);
    }
    println("prod_ap_protein_translation: PASSED");
}
