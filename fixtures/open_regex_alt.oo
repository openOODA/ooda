// # Product regex a|b match and miss
//
// Logline: nfa_simulate matches a and b for pattern a|b and misses c.
//
// Setup: OPEN-45. ooda/std/text/regex_nfa.oo. Pattern-string | split.
//
// Beats:
//   1. Match a.
//   2. Match b.
//   3. Miss c.
//   4. Print PASSED.

import "std/text/regex_nfa.oo";

pub fn main() {
    let a_ok: Bool = nfa_simulate("a|b", "a");
    let b_ok: Bool = nfa_simulate("a|b", "b");
    let c_no: Bool = nfa_simulate("a|b", "c");
    if !a_ok {
        println("FAIL match a");
        process_exit(1);
    }
    if !b_ok {
        println("FAIL match b");
        process_exit(1);
    }
    if c_no {
        println("FAIL miss c");
        process_exit(1);
    }
    println("open_regex_alt: PASSED");
}
