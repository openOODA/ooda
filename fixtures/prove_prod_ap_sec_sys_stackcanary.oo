// # Product prove std/sec/sys/stackcanary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/stackcanary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/stackcanary.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stackcanary: PASSED only if they match.

import "std/sec/sys/stackcanary.oo";

pub fn main() {
    let stackcanary_a = shim_marker_canary_level_standard();
    let stackcanary_b = shim_marker_canary_level_standard();
    if stackcanary_a != stackcanary_b {
        println("FAIL stackcanary");
        process_exit(1);
    }
    println("prod_ap_stackcanary: PASSED");
}
