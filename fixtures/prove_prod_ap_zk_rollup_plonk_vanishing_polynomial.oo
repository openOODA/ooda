// # Product prove std/zk_rollup/plonk_vanishing_polynomial.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/plonk_vanishing_polynomial.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_vanishing_polynomial.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_plonk_vanishing_polynomial: PASSED only if they match.

import "std/zk_rollup/plonk_vanishing_polynomial.oo";

pub fn main() {
    let plonk_vanishing_polynomial_a = vanishing_poly_config_new(0, 0, 0);
    let plonk_vanishing_polynomial_b = vanishing_poly_config_new(0, 0, 0);
    let plonk_vanishing_polynomial_va = vanishing_poly_eval_zh(plonk_vanishing_polynomial_a, 0);
    let plonk_vanishing_polynomial_vb = vanishing_poly_eval_zh(plonk_vanishing_polynomial_b, 0);
    if plonk_vanishing_polynomial_va != plonk_vanishing_polynomial_vb {
        println("FAIL plonk_vanishing_polynomial");
        process_exit(1);
    }
    println("prod_ap_plonk_vanishing_polynomial: PASSED");
}
