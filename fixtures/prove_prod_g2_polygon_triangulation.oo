// # Product prove std/scicomp/polygon_triangulation.oo
//
// Logline: Fail-closed emit+gcc+run asserts polygon_triangulation_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/polygon_triangulation.oo.
//
// Beats:
//   1. Call polygon_triangulation_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polygon_triangulation: PASSED only if they match.

import "std/scicomp/polygon_triangulation.oo";

pub fn main() {
    let a: Int = polygon_triangulation_probe();
    let b: Int = polygon_triangulation_probe();
    if a != b {
        println("FAIL polygon_triangulation_probe");
        process_exit(1);
    }
    println("prod_g2_polygon_triangulation: PASSED");
}
