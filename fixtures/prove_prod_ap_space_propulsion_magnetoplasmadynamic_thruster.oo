// # Product prove std/space_propulsion/magnetoplasmadynamic_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/magnetoplasmadynamic_thruster.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/magnetoplasmadynamic_thruster.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_magnetoplasmadynamic_thruster: PASSED only if they match.

import "std/space_propulsion/magnetoplasmadynamic_thruster.oo";

pub fn main() {
    let magnetoplasmadynamic_thruster_a = mpd_thruster_spec_default_argon();
    let magnetoplasmadynamic_thruster_b = mpd_thruster_spec_default_argon();
    if magnetoplasmadynamic_thruster_a.anode_radius_m != magnetoplasmadynamic_thruster_b.anode_radius_m {
        println("FAIL magnetoplasmadynamic_thruster");
        process_exit(1);
    }
    println("prod_ap_magnetoplasmadynamic_thruster: PASSED");
