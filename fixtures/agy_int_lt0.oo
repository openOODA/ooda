// # Smoke Int less-than zero
//
// Logline: sign() and a raw 0-1 < 0 compare prove the AGY Int path.
//
// Setup: M168 product path A; negative Int compare was a library blocker.
//
// Beats:
//   1. Return -1, 0, or 1 from sign.
//   2. Print sign of -3, 0, and 5.
//   3. Print 0 - 1 < 0.

pub fn sign(x: Int) -> Int {
    if x < 0 {
        return 0 - 1;
    }
    if x == 0 {
        return 0;
    }
    return 1;
}
pub fn main() {
    println(sign(0 - 3));
    println(sign(0));
    println(sign(5));
    println(0 - 1 < 0);
}
