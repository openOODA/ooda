// M168: Int < 0 comparison product path A (AGY library blocker)
pub fn sign(x: Int) -> Int {
    if x < 0 {
        return 0 - 1;
    }
    if x == 0 {
        return 0;
    }
    return 1;
}
pub fn main() {
    println(sign(0 - 3));
    println(sign(0));
    println(sign(5));
    println(0 - 1 < 0);
}
