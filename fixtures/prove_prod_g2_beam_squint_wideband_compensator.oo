// # Product prove std/telecom_6g/beam_squint_wideband_compensator.oo
//
// Logline: Fail-closed emit+gcc+run asserts beam_squint_angle_rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/beam_squint_wideband_compensator.oo.
//
// Beats:
//   1. Call beam_squint_angle_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_beam_squint_wideband_compensator: PASSED only if they match.

import "std/telecom_6g/beam_squint_wideband_compensator.oo";

pub fn main() {
    let beam_squint_wideband_compensator_mark: Int = 0;
    if beam_squint_wideband_compensator_mark != 0 {
        process_exit(1);
    }
    let a: Float = beam_squint_angle_rad(0.0, 0.0, 0.0);
    let b: Float = beam_squint_angle_rad(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL beam_squint_angle_rad");
        process_exit(1);
    }
    println("prod_g2_beam_squint_wideband_compensator: PASSED");
}
