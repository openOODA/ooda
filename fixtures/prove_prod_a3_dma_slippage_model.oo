// # Product prove std/fintech_l3_book/dma_slippage_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts slippage_estimate_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_slippage_model.oo.
//
// Beats:
//   1. Call slippage_estimate_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dma_slippage_model: PASSED only if they match.

import "std/fintech_l3_book/dma_slippage_model.oo";

pub fn main() {
    let dma_slippage_model_mark: Int = 0;
    if dma_slippage_model_mark != 0 {
        process_exit(1);
    }
    let a: SlippageEstimate = slippage_estimate_new("x", 0, 0, 0, 0);
    let b: SlippageEstimate = slippage_estimate_new("x", 0, 0, 0, 0);
    if (a).shares != (b).shares {
        println("FAIL slippage_estimate_new");
        process_exit(1);
    }
    println("prod_dma_slippage_model: PASSED");
}
