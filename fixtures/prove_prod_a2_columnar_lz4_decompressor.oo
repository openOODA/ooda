// # Product prove std/db_columnar/columnar_lz4_decompressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts lz4_parse_token is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_lz4_decompressor.oo.
//
// Beats:
//   1. Call lz4_parse_token twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_lz4_decompressor: PASSED only if they match.

import "std/db_columnar/columnar_lz4_decompressor.oo";

pub fn main() {
    let columnar_lz4_decompressor_mark: Int = 0;
    if columnar_lz4_decompressor_mark != 0 {
        process_exit(1);
    }
    let a: Lz4Token = lz4_parse_token(0);
    let b: Lz4Token = lz4_parse_token(0);
    if (a).literal_length != (b).literal_length {
        println("FAIL lz4_parse_token");
        process_exit(1);
    }
    println("prod_columnar_lz4_decompressor: PASSED");
}
