// # Ignore a mid-line secret mention
//
// Logline: Mentioning a secret directive mid-comment does not tag the name.
//
// Beats:
//   1. Keep the mid-line mention, not a line-start tag.
//   2. Bind x to a token literal.
//   3. Print x so emit stays allowed.

// Mention // SECRET: x mid-line is not a tag
pub fn main() {
    let x = "token";
    println(x);
}
