// # Product prove std/multimedia/pixel_blend.oo
//
// Logline: Fail-closed emit+gcc+run asserts blend_abs is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/pixel_blend.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call blend_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_pixel_blend: PASSED only if they match.

import "std/multimedia/pixel_blend.oo";

pub fn main() {
    let g0_a = blend_abs(0.0);
    let g0_b = blend_abs(0.0);
    if g0_a != g0_b {
        println("FAIL blend_abs");
        process_exit(1);
    }
    println("prod_gr_pixel_blend: PASSED");
}
