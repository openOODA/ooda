// # Product prove std/graph_topology/max_flow_edmonds_karp.oo
//
// Logline: Fail-closed emit+gcc+run asserts max_flow_edmonds_karp_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_topology/max_flow_edmonds_karp.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call max_flow_edmonds_karp_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_max_flow_edmonds_karp: PASSED only if they match.

import "std/graph_topology/max_flow_edmonds_karp.oo";

pub fn main() {
    let g0_a = max_flow_edmonds_karp_probe();
    let g0_b = max_flow_edmonds_karp_probe();
    if g0_a != g0_b {
        println("FAIL max_flow_edmonds_karp_probe");
        process_exit(1);
    }
    println("prod_gr_max_flow_edmonds_karp: PASSED");
}
