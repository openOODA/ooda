// # Product prove std/grid/battery_bank.oo
//
// Logline: Fail-closed emit+gcc+run asserts soc_calculate_pct is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/battery_bank.oo.
//
// Beats:
//   1. Call soc_calculate_pct twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_battery_bank: PASSED only if they match.

import "std/grid/battery_bank.oo";

pub fn main() {
    let battery_bank_mark: Int = 0;
    if battery_bank_mark != 0 {
        process_exit(1);
    }
    let a: Float = soc_calculate_pct(0.0, 0.0);
    let b: Float = soc_calculate_pct(0.0, 0.0);
    if a != b {
        println("FAIL soc_calculate_pct");
        process_exit(1);
    }
    println("prod_battery_bank: PASSED");
}
