// # Product IoError prove
//
// Logline: Fail-closed emit+gcc+run of shipped io_error_eof / is_eof / is_not_found.
//
// Setup: Product std/io/io_error.oo. Kind tags.
//
// Beats:
//   1. io_error_eof is EOF.
//   2. io_error_not_found of x is NotFound and not EOF.
//   3. Exit 1 before PASSED on a miss.

import "std/io/io_error.oo";

pub fn main() {
    let e: IoError = io_error_eof();
    if io_error_is_eof(e) == false {
        println("FAIL eof");
        process_exit(1);
    }
    let n: IoError = io_error_not_found("x");
    if io_error_is_not_found(n) == false {
        println("FAIL notfound");
        process_exit(1);
    }
    if io_error_is_eof(n) == true {
        println("FAIL not eof");
        process_exit(1);
    }
    println("prod_ioerr: PASSED");
}
