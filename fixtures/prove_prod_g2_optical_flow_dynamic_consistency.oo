// # Product prove std/nerf_3dgs/optical_flow_dynamic_consistency.oo
//
// Logline: Fail-closed emit+gcc+run asserts flow_vector_2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/optical_flow_dynamic_consistency.oo.
//
// Beats:
//   1. Call flow_vector_2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_optical_flow_dynamic_consistency: PASSED only if they match.

import "std/nerf_3dgs/optical_flow_dynamic_consistency.oo";

pub fn main() {
    let optical_flow_dynamic_consistency_mark: Int = 0;
    if optical_flow_dynamic_consistency_mark != 0 {
        process_exit(1);
    }
    let a: FlowVector2D = flow_vector_2d_new(0.0, 0.0, 0.0);
    let b: FlowVector2D = flow_vector_2d_new(0.0, 0.0, 0.0);
    if (a).du != (b).du {
        println("FAIL flow_vector_2d_new");
        process_exit(1);
    }
    println("prod_g2_optical_flow_dynamic_consistency: PASSED");
}
