// # Product prove std/auto_mpc_control/vehicle_kinematic_bicycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts kinematic_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/vehicle_kinematic_bicycle.oo.
//
// Beats:
//   1. Call kinematic_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vehicle_kinematic_bicycle: PASSED only if they match.

import "std/auto_mpc_control/vehicle_kinematic_bicycle.oo";

pub fn main() {
    let vehicle_kinematic_bicycle_mark: Int = 0;
    if vehicle_kinematic_bicycle_mark != 0 {
        process_exit(1);
    }
    let vehicle_kinematic_bicycle_a = kinematic_state_new(1.0, 1.0, 1.0, 1.0);
    let vehicle_kinematic_bicycle_b = kinematic_state_new(1.0, 1.0, 1.0, 1.0);
    if (vehicle_kinematic_bicycle_a).x != (vehicle_kinematic_bicycle_b).x {
        println("FAIL kinematic_state_new");
        process_exit(1);
    }
    println("prod_vehicle_kinematic_bicycle: PASSED");
}
