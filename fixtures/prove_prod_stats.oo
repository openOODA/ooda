// # Product stats prove
//
// Logline: Fail-closed emit+gcc+run of shipped stats_sum/mean on List[Int].
//
// Setup: Product std/math/stats.oo. 1,3,5 sum 9 mean 3.
//
// Beats:
//   1. stats_sum of 1,3,5 is 9.
//   2. stats_mean of that is 3.
//   3. Exit 1 before PASSED on a miss.

import "std/math/stats.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 3);
    xs = list_push(xs, 5);
    let s: Int = stats_sum(xs);
    if s != 9 {
        println("FAIL stats sum");
        process_exit(1);
    }
    let m: Int = stats_mean(xs);
    if m != 3 {
        println("FAIL stats mean");
        process_exit(1);
    }
    println("prod_stats: PASSED");
}
