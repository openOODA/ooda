// # Product prove std/compilers/elf_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_machine_x86_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/elf_header.oo.
//
// Beats:
//   1. Call elf_machine_x86_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf_header: PASSED only if they match.

import "std/compilers/elf_header.oo";

pub fn main() {
    let elf_header_mark: Int = 0;
    if elf_header_mark != 0 {
        process_exit(1);
    }
    let a: Int = elf_machine_x86_64();
    let b: Int = elf_machine_x86_64();
    if a != b {
        println("FAIL elf_machine_x86_64");
        process_exit(1);
    }
    println("prod_elf_header: PASSED");
}
