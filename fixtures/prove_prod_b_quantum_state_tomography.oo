// # Product prove std/quantum_advanced/quantum_state_tomography.oo
//
// Logline: Fail-closed emit+gcc+run asserts quantum_state_tomography_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_state_tomography.oo.
//
// Beats:
//   1. Call quantum_state_tomography_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_state_tomography: PASSED only if they match.

import "std/quantum_advanced/quantum_state_tomography.oo";

pub fn main() {
    let a = quantum_state_tomography_probe();
    let b = quantum_state_tomography_probe();
    if a != b {
        println("FAIL quantum_state_tomography_probe");
        process_exit(1);
    }
    println("prod_quantum_state_tomography: PASSED");
}
