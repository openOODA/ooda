// # Product prove std/3d/spatial_audio.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_source_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/spatial_audio.oo.
//
// Beats:
//   1. Call shim_marker_source_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_spatial_audio: PASSED only if they match.

import "std/3d/spatial_audio.oo";

pub fn main() {
    let spatial_audio_mark: Int = 0;
    if spatial_audio_mark != 0 {
        process_exit(1);
    }
    let a: AudioSource = shim_marker_source_new();
    let b: AudioSource = shim_marker_source_new();
    if (a).x != (b).x {
        println("FAIL shim_marker_source_new");
        process_exit(1);
    }
    println("prod_g2_spatial_audio: PASSED");
}
