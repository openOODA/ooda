// # Product prove std/astrophysics_relativity/magnetar_crust_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts magnetar_quantum_critical_b is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/magnetar_crust_cooling.oo.
//
// Beats:
//   1. Call magnetar_quantum_critical_b twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_magnetar_crust_cooling: PASSED only if they match.

import "std/astrophysics_relativity/magnetar_crust_cooling.oo";

pub fn main() {
    let magnetar_crust_cooling_mark: Int = 0;
    if magnetar_crust_cooling_mark != 0 {
        process_exit(1);
    }
    let a: Float = magnetar_quantum_critical_b();
    let b: Float = magnetar_quantum_critical_b();
    if a != b {
        println("FAIL magnetar_quantum_critical_b");
        process_exit(1);
    }
    println("prod_magnetar_crust_cooling: PASSED");
}
