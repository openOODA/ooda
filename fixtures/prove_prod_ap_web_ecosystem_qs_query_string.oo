// # Product prove std/web_ecosystem/qs_query_string.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/qs_query_string.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/qs_query_string.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_qs_query_string: PASSED only if they match.

import "std/web_ecosystem/qs_query_string.oo";

pub fn main() {
    let qs_query_string_a = qs_pair_n(0, 0);
    let qs_query_string_b = qs_pair_n(0, 0);
    if qs_query_string_a != qs_query_string_b {
        println("FAIL qs_query_string");
        process_exit(1);
    }
    println("prod_ap_qs_query_string: PASSED");
}
