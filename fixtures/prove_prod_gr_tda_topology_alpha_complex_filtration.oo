// # Product prove std/tda_topology/alpha_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts alpha_complex_count_active is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/alpha_complex_filtration.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call alpha_complex_count_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_alpha_complex_filtration: PASSED only if they match.

import "std/tda_topology/alpha_complex_filtration.oo";

pub fn main() {
    let g0_oa = alpha_complex_new(0.0, 0);
    let g0_ob = alpha_complex_new(0.0, 0);
    let g0_a = alpha_complex_count_active(&g0_oa, 0.0);
    let g0_b = alpha_complex_count_active(&g0_ob, 0.0);
    if g0_a != g0_b {
        println("FAIL alpha_complex_count_active");
        process_exit(1);
    }
    println("prod_gr_alpha_complex_filtration: PASSED");
}
