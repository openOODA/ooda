// # Product prove std/fintech_l3_book/l3_price_band_collar.oo
//
// Logline: Fail-closed emit+gcc+run asserts luld_band_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_price_band_collar.oo.
//
// Beats:
//   1. Call luld_band_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_price_band_collar: PASSED only if they match.

import "std/fintech_l3_book/l3_price_band_collar.oo";

pub fn main() {
    let a: LuldBand = luld_band_new("x", 0, 0, 0);
    let b: LuldBand = luld_band_new("x", 0, 0, 0);
    if a.reference_price_fixed != b.reference_price_fixed {
        println("FAIL luld_band_new");
        process_exit(1);
    }
    println("prod_l3_price_band_collar: PASSED");
}
