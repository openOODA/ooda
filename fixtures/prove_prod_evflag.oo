// # Product sync event flag group prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/event_flag_group.oo.
//
// Setup: Product std/sync/event_flag_group.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New flags 0: match_all 0 true, match_any 1 false.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/event_flag_group.oo";

pub fn main() {
    let g: EventFlagGroup = event_flag_group_new();
    if event_flag_match_all(g, 0) == false {
        println("FAIL evflag all0");
        process_exit(1);
    }
    if event_flag_match_any(g, 1) {
        println("FAIL evflag any1");
        process_exit(1);
    }
    if event_flag_match_all(g, 1) {
        println("FAIL evflag all1");
        process_exit(1);
    }
    println("prod_evflag: PASSED");
}
