// # Product prove std/pbr_raytracing/light_area_diffuse.oo
//
// Logline: Fail-closed emit+gcc+run asserts light_area_diffuse_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/light_area_diffuse.oo.
//
// Beats:
//   1. Call light_area_diffuse_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_light_area_diffuse: PASSED only if it matches.

import "std/pbr_raytracing/light_area_diffuse.oo";

pub fn main() {
    let a: Int = light_area_diffuse_probe();
    if a != 0 {
        println("FAIL light_area_diffuse_probe");
        process_exit(1);
    }
    println("prod_nc_light_area_diffuse: PASSED");
}
