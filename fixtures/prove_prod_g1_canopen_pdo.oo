// # Product prove std/industrial_iot/canopen_pdo.oo
//
// Logline: Fail-closed emit+gcc+run asserts canopen_pdo_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/canopen_pdo.oo.
//
// Beats:
//   1. Call canopen_pdo_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_canopen_pdo: PASSED only if they match.

import "std/industrial_iot/canopen_pdo.oo";

pub fn main() {
    let a: CanopenPdoConfig = canopen_pdo_config_new(0, 0, 0, 0);
    let b: CanopenPdoConfig = canopen_pdo_config_new(0, 0, 0, 0);
    if a.cob_id != b.cob_id {
        println("FAIL canopen_pdo_config_new");
        process_exit(1);
    }
    println("prod_canopen_pdo: PASSED");
}
