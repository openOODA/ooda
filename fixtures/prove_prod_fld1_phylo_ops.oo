// # Product prove std/bio/phylo_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts taxon_create_full is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/phylo_ops.oo.
//
// Beats:
//   1. Call taxon_create_full twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_phylo_ops: PASSED only if they match.

import "std/bio/phylo_ops.oo";

pub fn main() {
    let phylo_ops_mark: Int = 0;
    if phylo_ops_mark != 0 {
        process_exit(1);
    }
    let phylo_ops_a = taxon_create_full(1, "x", "x", 1, 1, true);
    let phylo_ops_b = taxon_create_full(1, "x", "x", 1, 1, true);
    if (phylo_ops_a).id != (phylo_ops_b).id {
        println("FAIL taxon_create_full");
        process_exit(1);
    }
    println("prod_phylo_ops: PASSED");
}
