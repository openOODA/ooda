// # Product prove std/pbr_raytracing/surface_interaction.oo
//
// Logline: Fail-closed emit+gcc+run asserts surface_interaction_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/surface_interaction.oo.
//
// Beats:
//   1. Call surface_interaction_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_surface_interaction: PASSED only if it matches.

import "std/pbr_raytracing/surface_interaction.oo";

pub fn main() {
    let a: Int = surface_interaction_probe();
    if a != 0 {
        println("FAIL surface_interaction_probe");
        process_exit(1);
    }
    println("prod_nc_surface_interaction: PASSED");
}
