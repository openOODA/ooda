// # Product prove std/exploit_analysis/got_overwrite_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts got_target_analysis_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/got_overwrite_analyzer.oo.
//
// Beats:
//   1. Call got_target_analysis_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_got_overwrite_analyzer: PASSED only if they match.

import "std/exploit_analysis/got_overwrite_analyzer.oo";

pub fn main() {
    let got_overwrite_analyzer_mark: Int = 0;
    if got_overwrite_analyzer_mark != 0 {
        process_exit(1);
    }
    let got_overwrite_analyzer_a = got_target_analysis_new("x");
    let got_overwrite_analyzer_b = got_target_analysis_new("x");
    if (got_overwrite_analyzer_a).writable_entry_count != (got_overwrite_analyzer_b).writable_entry_count {
        println("FAIL got_target_analysis_new");
        process_exit(1);
    }
    println("prod_got_overwrite_analyzer: PASSED");
}
