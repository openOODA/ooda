// # Product prove std/astrophysics_relativity/cosmological_dark_energy_w_eos.oo
//
// Logline: Fail-closed verification that dynamical dark energy CPL equation of state calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/cosmological_dark_energy_w_eos.oo.
//
// Beats:
//   1. Compute dark energy equation of state parameter w(z) in milli-units.
//   2. Evaluate dark energy evolution point across redshift steps.
//   3. Verify equation of state value and status flags.
//   4. Print prod_g4_astrophys_dark_energy: PASSED and exit 0.

import "std/astrophysics_relativity/cosmological_dark_energy_w_eos.oo";

pub fn main() {
    let cosmological_dark_energy_w_eos_mark: Int = 0;
    if cosmological_dark_energy_w_eos_mark != 0 {
        process_exit(1);
    }

    let w_milli_a: Int = dark_energy_w_milli(-1000, 200, 1);
    let w_milli_b: Int = dark_energy_w_milli(-1000, 200, 1);
    if w_milli_a != w_milli_b || w_milli_a != -900 {
        println("FAIL dark_energy_w_milli");
        process_exit(1);
    }

    let pt_a: DarkEnergyEvolutionPoint = dark_energy_evaluate_point(-1000, 0, 300, 700, 1);
    let pt_b: DarkEnergyEvolutionPoint = dark_energy_evaluate_point(-1000, 0, 300, 700, 1);

    let w_val_a: Int = dark_energy_w(pt_a);
    let w_val_b: Int = dark_energy_w(pt_b);
    if w_val_a != w_val_b || w_val_a != -1000 {
        println("FAIL dark_energy_w");
        process_exit(1);
    }

    let flags_a: Int = dark_energy_flags(pt_a);
    let flags_b: Int = dark_energy_flags(pt_b);
    if flags_a != flags_b || flags_a <= 0 {
        println("FAIL dark_energy_flags");
        process_exit(1);
    }

    if (pt_a).omega_m_milli != (pt_b).omega_m_milli || (pt_a).omega_m_milli <= 0 {
        println("FAIL dark_energy_evaluate_point omega_m_milli");
        process_exit(1);
    }

    println("prod_g4_astrophys_dark_energy: PASSED");
    process_exit(0);
}
