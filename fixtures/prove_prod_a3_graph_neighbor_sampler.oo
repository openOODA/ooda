// # Product prove std/graph_gnn/graph_neighbor_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts csr_graph_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_neighbor_sampler.oo.
//
// Beats:
//   1. Call csr_graph_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_neighbor_sampler: PASSED only if they match.

import "std/graph_gnn/graph_neighbor_sampler.oo";

pub fn main() {
    let graph_neighbor_sampler_mark: Int = 0;
    if graph_neighbor_sampler_mark != 0 {
        process_exit(1);
    }
    let a: CSRGraph = csr_graph_new(0, 0, list_new(), list_new());
    let b: CSRGraph = csr_graph_new(0, 0, list_new(), list_new());
    if (a).num_nodes != (b).num_nodes {
        println("FAIL csr_graph_new");
        process_exit(1);
    }
    println("prod_graph_neighbor_sampler: PASSED");
}
