// # Product prove std/compilers_polyhedral/polyhedral_fusion_heuristic.oo
//
// Logline: Fail-closed emit+gcc+run asserts evaluate_fusion_legality is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_fusion_heuristic.oo.
//
// Beats:
//   1. Call evaluate_fusion_legality twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_fusion_heuristic: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_fusion_heuristic.oo";

pub fn main() {
    let polyhedral_fusion_heuristic_mark: Int = 0;
    if polyhedral_fusion_heuristic_mark != 0 {
        process_exit(1);
    }
    let a: Bool = evaluate_fusion_legality(0);
    let b: Bool = evaluate_fusion_legality(0);
    if a != b {
        println("FAIL evaluate_fusion_legality");
        process_exit(1);
    }
    println("prod_g2_polyhedral_fusion_heuristic: PASSED");
}
