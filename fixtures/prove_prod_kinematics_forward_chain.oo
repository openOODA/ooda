// # Product prove std/robotics_ros2/kinematics_forward_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix4x4_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/kinematics_forward_chain.oo.
//
// Beats:
//   1. Call matrix4x4_identity twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kinematics_forward_chain: PASSED only if they match.

import "std/robotics_ros2/kinematics_forward_chain.oo";

pub fn main() {
    let kinematics_forward_chain_mark: Int = 0;
    if kinematics_forward_chain_mark != 0 {
        process_exit(1);
    }
    let a: Matrix4x4Homogeneous = matrix4x4_identity();
    let b: Matrix4x4Homogeneous = matrix4x4_identity();
    if (a).r11 != (b).r11 {
        println("FAIL matrix4x4_identity");
        process_exit(1);
    }
    println("prod_kinematics_forward_chain: PASSED");
}
