// # Product prove std/aero/orbit_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/orbit_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orbit_stubs: PASSED only if they match.

import "std/aero/orbit_stubs.oo";

pub fn main() {
    let orbit_stubs_a = parse_tle_to_orbit("x", "x");
    let orbit_stubs_b = parse_tle_to_orbit("x", "x");
    let orbit_stubs_va = generate_ground_track(orbit_stubs_a, 0.0, 0.0);
    let orbit_stubs_vb = generate_ground_track(orbit_stubs_b, 0.0, 0.0);
    if orbit_stubs_va != orbit_stubs_vb {
        println("FAIL orbit_stubs");
        process_exit(1);
    }
    println("prod_ap_orbit_stubs: PASSED");
}
