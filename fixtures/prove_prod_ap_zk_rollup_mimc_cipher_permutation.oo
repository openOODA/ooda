// # Product prove std/zk_rollup/mimc_cipher_permutation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/mimc_cipher_permutation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/mimc_cipher_permutation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mimc_cipher_permutation: PASSED only if they match.

import "std/zk_rollup/mimc_cipher_permutation.oo";

pub fn main() {
    let mimc_cipher_permutation_a = mimc_sbox_cube(0, 0);
    let mimc_cipher_permutation_b = mimc_sbox_cube(0, 0);
    if mimc_cipher_permutation_a != mimc_cipher_permutation_b {
        println("FAIL mimc_cipher_permutation");
        process_exit(1);
    }
    println("prod_ap_mimc_cipher_permutation: PASSED");
}
