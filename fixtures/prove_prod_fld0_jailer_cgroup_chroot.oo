// # Product prove std/cloud_faas/jailer_cgroup_chroot.oo
//
// Logline: Fail-closed emit+gcc+run asserts jailer_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/jailer_cgroup_chroot.oo.
//
// Beats:
//   1. Call jailer_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jailer_cgroup_chroot: PASSED only if they match.

import "std/cloud_faas/jailer_cgroup_chroot.oo";

pub fn main() {
    let jailer_cgroup_chroot_mark: Int = 0;
    if jailer_cgroup_chroot_mark != 0 {
        process_exit(1);
    }
    let jailer_cgroup_chroot_a: JailerConfig = jailer_config_new("x", "x", "x", 1, 1);
    let jailer_cgroup_chroot_b: JailerConfig = jailer_config_new("x", "x", "x", 1, 1);
    if (jailer_cgroup_chroot_a).uid != (jailer_cgroup_chroot_b).uid {
        println("FAIL jailer_config_new");
        process_exit(1);
    }
    println("prod_jailer_cgroup_chroot: PASSED");
}
