// # Product prove std/bft_consensus/dag_narwhal_mempool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/dag_narwhal_mempool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_narwhal_mempool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dag_narwhal_mempool: PASSED only if they match.

import "std/bft_consensus/dag_narwhal_mempool.oo";

pub fn main() {
    let dag_narwhal_mempool_a = availability_certificate_new("x", 0, 0, 0);
    let dag_narwhal_mempool_b = availability_certificate_new("x", 0, 0, 0);
    let dag_narwhal_mempool_va = availability_certificate_is_valid(dag_narwhal_mempool_a);
    let dag_narwhal_mempool_vb = availability_certificate_is_valid(dag_narwhal_mempool_b);
    if dag_narwhal_mempool_va != dag_narwhal_mempool_vb {
        println("FAIL dag_narwhal_mempool");
        process_exit(1);
    }
    println("prod_ap_dag_narwhal_mempool: PASSED");
}
