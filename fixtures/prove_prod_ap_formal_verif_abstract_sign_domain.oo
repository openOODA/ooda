// # Product prove std/formal_verif/abstract_sign_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/abstract_sign_domain.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_sign_domain.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_abstract_sign_domain: PASSED only if they match.

import "std/formal_verif/abstract_sign_domain.oo";

pub fn main() {
    let abstract_sign_domain_a = sign_bottom();
    let abstract_sign_domain_b = sign_bottom();
    let abstract_sign_domain_va = sign_is_bottom(abstract_sign_domain_a);
    let abstract_sign_domain_vb = sign_is_bottom(abstract_sign_domain_b);
    if abstract_sign_domain_va != abstract_sign_domain_vb {
        println("FAIL abstract_sign_domain");
        process_exit(1);
    }
    println("prod_ap_abstract_sign_domain: PASSED");
}
