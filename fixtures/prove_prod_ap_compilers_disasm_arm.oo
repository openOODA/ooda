// # Product prove std/compilers/disasm_arm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/disasm_arm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/disasm_arm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_disasm_arm: PASSED only if they match.

import "std/compilers/disasm_arm.oo";

pub fn main() {
    let disasm_arm_a = arm64_reg_num(0);
    let disasm_arm_b = arm64_reg_num(0);
    if disasm_arm_a != disasm_arm_b {
        println("FAIL disasm_arm");
        process_exit(1);
    }
    println("prod_ap_disasm_arm: PASSED");
}
