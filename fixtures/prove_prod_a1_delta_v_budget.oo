// # Product prove std/astrodynamics/delta_v_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts leo_dv is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/delta_v_budget.oo.
//
// Beats:
//   1. Call leo_dv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_delta_v_budget: PASSED only if they match.

import "std/astrodynamics/delta_v_budget.oo";

pub fn main() {
    let delta_v_budget_mark: Int = 0;
    if delta_v_budget_mark != 0 {
        process_exit(1);
    }
    let a: Int = leo_dv();
    let b: Int = leo_dv();
    if a != b {
        println("FAIL leo_dv");
        process_exit(1);
    }
    println("prod_delta_v_budget: PASSED");
}
