// # Product prove std/exploit_analysis/mitigation_matrix_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mitigation_profile_standard_linux is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/mitigation_matrix_evaluator.oo.
//
// Beats:
//   1. Call mitigation_profile_standard_linux twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mitigation_matrix_evaluator: PASSED only if they match.

import "std/exploit_analysis/mitigation_matrix_evaluator.oo";

pub fn main() {
    let mitigation_matrix_evaluator_mark: Int = 0;
    if mitigation_matrix_evaluator_mark != 0 {
        process_exit(1);
    }
    let mitigation_matrix_evaluator_a = mitigation_profile_standard_linux();
    let mitigation_matrix_evaluator_b = mitigation_profile_standard_linux();
    if (mitigation_matrix_evaluator_a).has_nx != (mitigation_matrix_evaluator_b).has_nx {
        println("FAIL mitigation_profile_standard_linux");
        process_exit(1);
    }
    println("prod_mitigation_matrix_evaluator: PASSED");
}
