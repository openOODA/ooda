// # Product prove std/defi_derivatives/perpetual_funding_arbitrage.oo
//
// Logline: Fail-closed emit+gcc+run asserts basis_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_funding_arbitrage.oo.
//
// Beats:
//   1. Call basis_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_perpetual_funding_arbitrage: PASSED only if they match.

import "std/defi_derivatives/perpetual_funding_arbitrage.oo";

pub fn main() {
    let perpetual_funding_arbitrage_mark: Int = 0;
    if perpetual_funding_arbitrage_mark != 0 {
        process_exit(1);
    }
    let a: BasisYieldConfig = basis_config_default();
    let b: BasisYieldConfig = basis_config_default();
    if (a).spot_taker_fee != (b).spot_taker_fee {
        println("FAIL basis_config_default");
        process_exit(1);
    }
    println("prod_g2_perpetual_funding_arbitrage: PASSED");
}
