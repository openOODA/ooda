// # Product prove std/net/socket_opts.oo
//
// Logline: Fail-closed emit+gcc+run asserts socket_opts_format is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/socket_opts.oo.
//
// Beats:
//   1. Call socket_opts_format twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_socket_opts: PASSED only if they match.

import "std/net/socket_opts.oo";

pub fn main() {
    let obj = socket_opts_default();
    let a = socket_opts_format(obj);
    let b = socket_opts_format(obj);
    if a != b {
        println("FAIL socket_opts_format");
        process_exit(1);
    }
    println("prod_socket_opts: PASSED");
}
