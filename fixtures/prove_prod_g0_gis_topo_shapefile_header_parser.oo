// # Product prove std/gis_topo/shapefile_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts shapefile_type_name is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/shapefile_header_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call shapefile_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_shapefile_header_parser: PASSED only if they match.

import "std/gis_topo/shapefile_header_parser.oo";

pub fn main() {
    let g0_a = shapefile_type_name(2);
    let g0_b = shapefile_type_name(2);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL shapefile_type_name");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL shapefile_type_name");
        process_exit(1);
    }
    println("prod_g0_shapefile_header_parser: PASSED");
}
