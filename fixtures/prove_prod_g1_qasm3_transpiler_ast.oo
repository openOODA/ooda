// # Product prove std/quantum_advanced/qasm3_transpiler_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts qasm3_node_qubit_decl is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/qasm3_transpiler_ast.oo.
//
// Beats:
//   1. Call qasm3_node_qubit_decl twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qasm3_transpiler_ast: PASSED only if they match.

import "std/quantum_advanced/qasm3_transpiler_ast.oo";

pub fn main() {
    let a: Qasm3NodeType = qasm3_node_qubit_decl();
    let b: Qasm3NodeType = qasm3_node_qubit_decl();
    if a.code != b.code {
        println("FAIL qasm3_node_qubit_decl");
        process_exit(1);
    }
    println("prod_qasm3_transpiler_ast: PASSED");
}
