// # Product prove std/zk_rollup/mimc_cipher_permutation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mimc_sbox_cube is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/mimc_cipher_permutation.oo.
//
// Beats:
//   1. Call mimc_sbox_cube twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mimc_cipher_permutation: PASSED only if they match.

import "std/zk_rollup/mimc_cipher_permutation.oo";

pub fn main() {
    let mimc_cipher_permutation_mark: Int = 0;
    if mimc_cipher_permutation_mark != 0 {
        process_exit(1);
    }
    let mimc_cipher_permutation_a: Int = mimc_sbox_cube(1, 1);
    let mimc_cipher_permutation_b: Int = mimc_sbox_cube(1, 1);
    if mimc_cipher_permutation_a != mimc_cipher_permutation_b {
        println("FAIL mimc_sbox_cube");
        process_exit(1);
    }
    println("prod_mimc_cipher_permutation: PASSED");
}
