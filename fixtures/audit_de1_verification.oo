// # DE1 Audit Verification Test Harness
// Comprehensive edge-case proof for HashMap and JSON modules.

import "std/hash/map.oo";
import "std/markup/json.oo";
import "std/result.oo";

pub fn main() {
    println("--- START DE1 AUDIT VERIFICATION ---");

    // ==========================================
    // SECTION 1: HashMap Audit & Edge Cases
    // ==========================================
    println("Test 1.1: Map creation & empty checks");
    let mut m: HashMap = map_new();
    if !map_is_empty(m) { println("FAIL: map_is_empty on new map"); process_exit(1); }
    if map_len(m) != 0 { println("FAIL: map_len != 0 on new map"); process_exit(1); }
    if map_has(m, "nonexistent") { println("FAIL: map_has on empty map"); process_exit(1); }

    println("Test 1.2: Empty key handling");
    m = map_insert(m, "", "empty_key_value");
    if map_is_empty(m) { println("FAIL: map_is_empty with empty key"); process_exit(1); }
    if map_len(m) != 1 { println("FAIL: map_len != 1 with empty key"); process_exit(1); }
    if !map_has(m, "") { println("FAIL: map_has empty key"); process_exit(1); }
    let ek_res: Result[String, String] = map_get(m, "");
    if !ek_res.is_ok() { println("FAIL: map_get empty key"); process_exit(1); }
    if res_unwrap_or(ek_res, "") != "empty_key_value" { println("FAIL: map_get empty key mismatch"); process_exit(1); }

    println("Test 1.3: Key prefix / substring collisions");
    m = map_insert(m, "user", "Alice");
    m = map_insert(m, "user_id", "12345");
    m = map_insert(m, "username", "alice_in_wonderland");
    m = map_insert(m, "us", "US_REGION");
    if map_len(m) != 5 { println("FAIL: map_len != 5"); process_exit(1); }

    if map_get_or(m, "user", "") != "Alice" { println("FAIL: user key mismatch"); process_exit(1); }
    if map_get_or(m, "user_id", "") != "12345" { println("FAIL: user_id key mismatch"); process_exit(1); }
    if map_get_or(m, "username", "") != "alice_in_wonderland" { println("FAIL: username key mismatch"); process_exit(1); }
    if map_get_or(m, "us", "") != "US_REGION" { println("FAIL: us key mismatch"); process_exit(1); }

    println("Test 1.4: Special characters in keys and values");
    m = map_insert(m, "path/to/resource.json", "https://api.example.com/v1?q=test&page=1");
    m = map_insert(m, "quoted:\"key\"", "value with spaces and symbols!@#$%^&*()");
    if map_get_or(m, "path/to/resource.json", "") != "https://api.example.com/v1?q=test&page=1" {
        println("FAIL: url path key mismatch");
        process_exit(1);
    }
    if map_get_or(m, "quoted:\"key\"", "") != "value with spaces and symbols!@#$%^&*()" {
        println("FAIL: quoted key mismatch");
        process_exit(1);
    }

    println("Test 1.5: Multiple updates to the same key");
    m = map_insert(m, "counter", "1");
    let len_before: Int = map_len(m);
    m = map_insert(m, "counter", "2");
    m = map_insert(m, "counter", "3");
    m = map_insert(m, "counter", "final_42");
    if map_len(m) != len_before { println("FAIL: multiple updates changed map length"); process_exit(1); }
    if map_get_or(m, "counter", "") != "final_42" { println("FAIL: multiple updates value mismatch"); process_exit(1); }

    println("Test 1.6: map_keys and map_values collection");
    let keys: List[String] = map_keys(m);
    let vals: List[String] = map_values(m);
    if list_len(keys) != map_len(m) { println("FAIL: map_keys length mismatch"); process_exit(1); }
    if list_len(vals) != map_len(m) { println("FAIL: map_values length mismatch"); process_exit(1); }

    println("Test 1.7: map_remove behavior");
    m = map_remove(m, "nonexistent"); // No-op
    let mut cur_len: Int = map_len(m);
    m = map_remove(m, "user");
    if map_len(m) != cur_len - 1 { println("FAIL: remove len mismatch"); process_exit(1); }
    if map_has(m, "user") { println("FAIL: removed key still present"); process_exit(1); }
    let rem_r: Result[String, String] = map_get(m, "user");
    if !rem_r.is_err() { println("FAIL: removed key map_get did not return Err"); process_exit(1); }

    // Remove empty key
    m = map_remove(m, "");
    if map_has(m, "") { println("FAIL: empty key still present after remove"); process_exit(1); }

    // ==========================================
    // SECTION 2: JSON Parser & Builder Audit
    // ==========================================
    println("Test 2.1: json_escape edge cases");
    let raw_esc: String = "Line1\nLine2\tTabbed \"Quoted\" \\Backslash\\";
    let esc_res: String = json_escape(raw_esc);
    let expected_esc: String = "Line1\\nLine2\\tTabbed \\\"Quoted\\\" \\\\Backslash\\\\";
    if esc_res != expected_esc {
        println("FAIL: json_escape mismatch. Got: " + esc_res);
        process_exit(1);
    }

    println("Test 2.2: json_builder_* construction");
    let mut jb: String = json_builder_new();
    jb = json_builder_add_string(jb, "title", "Audit \"DE1\" Report");
    jb = json_builder_add_int(jb, "code", 200);
    jb = json_builder_add_int(jb, "neg_val", -42);
    jb = json_builder_add_bool(jb, "active", true);
    jb = json_builder_add_bool(jb, "deprecated", false);
    jb = json_builder_add_string(jb, "empty_str", "");
    jb = json_builder_finish(jb);

    println("Constructed JSON: " + jb);

    println("Test 2.3: json_get_string extraction with quotes and empty strings");
    let title_res: Result[String, String] = json_get_string(jb, "title");
    if !title_res.is_ok() { println("FAIL: json_get_string title"); process_exit(1); }
    if res_unwrap_or(title_res, "") != "Audit \\\"DE1\\\" Report" {
        println("FAIL: title string mismatch: " + res_unwrap_or(title_res, ""));
        process_exit(1);
    }

    let empty_res: Result[String, String] = json_get_string(jb, "empty_str");
    if !empty_res.is_ok() { println("FAIL: json_get_string empty_str"); process_exit(1); }
    if res_unwrap_or(empty_res, "NOT_EMPTY") != "" {
        println("FAIL: empty_str mismatch");
        process_exit(1);
    }

    println("Test 2.4: json_get_value extraction for numbers and booleans");
    let code_val: Result[String, String] = json_get_value(jb, "code");
    if res_unwrap_or(code_val, "") != "200" { println("FAIL: code value mismatch"); process_exit(1); }

    let neg_val: Result[String, String] = json_get_value(jb, "neg_val");
    if res_unwrap_or(neg_val, "") != "-42" { println("FAIL: neg_val mismatch"); process_exit(1); }

    let act_val: Result[String, String] = json_get_value(jb, "active");
    if res_unwrap_or(act_val, "") != "true" { println("FAIL: active value mismatch"); process_exit(1); }

    let dep_val: Result[String, String] = json_get_value(jb, "deprecated");
    if res_unwrap_or(dep_val, "") != "false" { println("FAIL: deprecated value mismatch"); process_exit(1); }

    println("Test 2.5: json_find_key & error handling");
    let notfound_res: Result[String, String] = json_get_string(jb, "unknown_field");
    if !notfound_res.is_err() { println("FAIL: json_get_string on unknown key should be Err"); process_exit(1); }

    let type_err_res: Result[String, String] = json_get_string(jb, "code");
    if !type_err_res.is_err() { println("FAIL: json_get_string on integer should return Err(NOT_A_STRING)"); process_exit(1); }

    println("ALL DE1 AUDIT TESTS PASSED CLEANLY!");
}
