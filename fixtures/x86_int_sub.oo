// # emit-x86 const int minus
//
// Logline: Print 5 minus 2 so emit-x86 can lower const-int ALU to 3.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare main.
//   2. Print the const integer 5 minus 2.
//   3. Expect 3, not leftover.

pub fn main() {
    println(5 - 2);
}
