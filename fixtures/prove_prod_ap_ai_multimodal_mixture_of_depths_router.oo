// # Product prove std/ai_multimodal/mixture_of_depths_router.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/mixture_of_depths_router.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/mixture_of_depths_router.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mixture_of_depths_router: PASSED only if they match.

import "std/ai_multimodal/mixture_of_depths_router.oo";

pub fn main() {
    let mixture_of_depths_router_a = mod_combine_token(0, 0, 0, 0);
    let mixture_of_depths_router_b = mod_combine_token(0, 0, 0, 0);
    if mixture_of_depths_router_a != mixture_of_depths_router_b {
        println("FAIL mixture_of_depths_router");
        process_exit(1);
    }
    println("prod_ap_mixture_of_depths_router: PASSED");
}
