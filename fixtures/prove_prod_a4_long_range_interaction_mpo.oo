// # Product prove std/quantum_tensor_nets/long_range_interaction_mpo.oo
//
// Logline: Fail-closed emit+gcc+run asserts power_law_mpo_bond_dimension is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/long_range_interaction_mpo.oo.
//
// Beats:
//   1. Call power_law_mpo_bond_dimension twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_long_range_interaction_mpo: PASSED only if they match.

import "std/quantum_tensor_nets/long_range_interaction_mpo.oo";

pub fn main() {
    let long_range_interaction_mpo_mark: Int = 0;
    if long_range_interaction_mpo_mark != 0 {
        process_exit(1);
    }
    let a: Int = power_law_mpo_bond_dimension(0);
    let b: Int = power_law_mpo_bond_dimension(0);
    if a != b {
        println("FAIL power_law_mpo_bond_dimension");
        process_exit(1);
    }
    println("prod_long_range_interaction_mpo: PASSED");
}
