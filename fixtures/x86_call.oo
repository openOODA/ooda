// # emit-x86 no-arg const return call
//
// Logline: Call hi and print its ok string so emit-x86 can fold a no-arg const return.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No concat.
//
// Beats:
//   1. Declare hi with a const string return.
//   2. Print hi().
//   3. Expect ok.

fn hi() -> String {
    return "ok";
}

pub fn main() {
    println(hi());
}
