// # Product prove std/sec/sys/kernel_audit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/kernel_audit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/kernel_audit.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_kernel_audit: PASSED and exit 0 only on match.

import "std/sec/sys/kernel_audit.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_sys_kernel_audit_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_sys_kernel_audit_oo();
    if dummy_a != dummy_b {
        println("FAIL kernel_audit dummy");
        process_exit(1);
    }

    let p_exec_a: Int = shim_marker_audit_perm_exec();
    let p_exec_b: Int = shim_marker_audit_perm_exec();
    if p_exec_a != p_exec_b {
        println("FAIL shim_marker_audit_perm_exec");
        process_exit(1);
    }

    let l_watch_a: Int = shim_marker_audit_list_watch();
    let l_watch_b: Int = shim_marker_audit_list_watch();
    if l_watch_a != l_watch_b {
        println("FAIL shim_marker_audit_list_watch");
        process_exit(1);
    }

    let perm_direct_a: Int = audit_perm_exec();
    let perm_direct_b: Int = audit_perm_exec();
    if perm_direct_a != perm_direct_b {
        println("FAIL audit_perm_exec");
        process_exit(1);
    }

    println("prod_g4_sec_kernel_audit: PASSED");
    process_exit(0);
}
