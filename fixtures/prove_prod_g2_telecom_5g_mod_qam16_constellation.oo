// # Product prove std/telecom_5g/mod_qam16_constellation.oo
//
// Logline: Fail-closed emit+gcc+run asserts mod_qam16_pam4_map is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/mod_qam16_constellation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mod_qam16_pam4_map twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mod_qam16_constellation: PASSED only if they match.

import "std/telecom_5g/mod_qam16_constellation.oo";

pub fn main() {
    let g2_a = mod_qam16_pam4_map(2);
    let g2_b = mod_qam16_pam4_map(2);
    if g2_a != g2_b {
        println("FAIL mod_qam16_pam4_map");
        process_exit(1);
    }
    println("prod_g2_mod_qam16_constellation: PASSED");
}
