// # Product prove std/fintech_defi/staking_yield_compounder.oo
//
// Logline: Fail-closed emit+gcc+run asserts staking_pool_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/staking_yield_compounder.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call staking_pool_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_staking_yield_compounder: PASSED only if they match.

import "std/fintech_defi/staking_yield_compounder.oo";

pub fn main() {
    let g2_oa: StakingPool = staking_pool_new("x", "x", 2, 2, 2);
    let g2_ob: StakingPool = staking_pool_new("x", "x", 2, 2, 2);
    let g2_a = (g2_oa).total_staked;
    let g2_b = (g2_ob).total_staked;
    if g2_a != g2_b {
        println("FAIL staking_pool_new.total_staked");
        process_exit(1);
    }
    println("prod_g2_staking_yield_compounder: PASSED");
}
