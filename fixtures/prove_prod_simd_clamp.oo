// # Product prove std/simd/simd_clamp.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_clamp_f32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_clamp.oo.
//
// Beats:
//   1. Call simd_clamp_f32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_clamp: PASSED only if they match.

import "std/simd/simd_clamp.oo";

pub fn main() {
    let a = simd_clamp_f32(0.0, 0.0, 0.0);
    let b = simd_clamp_f32(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL simd_clamp_f32");
        process_exit(1);
    }
    println("prod_simd_clamp: PASSED");
}
