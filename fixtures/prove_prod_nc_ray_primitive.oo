// # Product prove std/pbr_raytracing/ray_primitive.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_primitive_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/ray_primitive.oo.
//
// Beats:
//   1. Call ray_primitive_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_ray_primitive: PASSED only if it matches.

import "std/pbr_raytracing/ray_primitive.oo";

pub fn main() {
    let a: Int = ray_primitive_probe();
    if a != 0 {
        println("FAIL ray_primitive_probe");
        process_exit(1);
    }
    println("prod_nc_ray_primitive: PASSED");
}
