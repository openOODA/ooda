// # Product prove std/os/terminal_cursor.oo
//
// Logline: Fail-closed emit+gcc+run asserts cursor_up is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_cursor.oo.
//
// Beats:
//   1. Call cursor_up twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_cursor: PASSED only if they match.

import "std/os/terminal_cursor.oo";
import "std/str.oo";

pub fn main() {
    let terminal_cursor_mark: Int = 0;
    if terminal_cursor_mark != 0 {
        process_exit(1);
    }
    let terminal_cursor_a: String = cursor_up(1);
    let terminal_cursor_b: String = cursor_up(1);
    if str_eq(terminal_cursor_a, terminal_cursor_b) == false {
        println("FAIL cursor_up");
        process_exit(1);
    }
    println("prod_terminal_cursor: PASSED");
}
