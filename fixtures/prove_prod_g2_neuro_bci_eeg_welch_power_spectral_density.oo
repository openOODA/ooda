// # Product prove std/neuro_bci/eeg_welch_power_spectral_density.oo
//
// Logline: Fail-closed emit+gcc+run asserts welch_hanning_window_4pt is a real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_welch_power_spectral_density.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call welch_hanning_window_4pt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eeg_welch_power_spectral_density: PASSED only if they match.

import "std/neuro_bci/eeg_welch_power_spectral_density.oo";

pub fn main() {
    let g2_oa: WindowedEpoch4 = welch_hanning_window_4pt(1.0, 1.0, 1.0, 1.0);
    let g2_ob: WindowedEpoch4 = welch_hanning_window_4pt(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).w0;
    let g2_b = (g2_ob).w0;
    if g2_a != g2_b {
        println("FAIL welch_hanning_window_4pt.w0");
        process_exit(1);
    }
    println("prod_g2_eeg_welch_power_spectral_density: PASSED");
}
