// # Connect after a nested return
//
// Logline: Return from a nested false if, connect on the live paths, and send after the join.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Return from the inner false arm.
//   3. Connect on the live paths, then send.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    if true {
        if false {
            connect(s);
            return;
        }
        connect(s);
    } else {
        connect(s);
    }
    send(s);
}
