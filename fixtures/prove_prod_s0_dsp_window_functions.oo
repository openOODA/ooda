// # Product prove std/telecom_5g/dsp_window_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_window_hann_sample value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_window_functions.oo.
//
// Beats:
//   1. Call dsp_window_hann_sample twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_dsp_window_functions: PASSED only if asserts hold.

import "std/telecom_5g/dsp_window_functions.oo";

pub fn main() {
    let dsp_window_functions_a: Float = dsp_window_hann_sample(0, 0);
    let dsp_window_functions_b: Float = dsp_window_hann_sample(0, 0);
    if dsp_window_functions_a != dsp_window_functions_b {
        println("FAIL dsp_window_hann_sample");
        process_exit(1);
    }
    println("prod_dsp_window_functions: PASSED");
}
