// # Result[String] sret return lock
//
// Logline: Fail-closed emit+gcc+run of a Result[String] function returned via sret.
//
// Setup: Backend-C. Result[String, String] is %OoResS (24 bytes).
//
// Beats:
//   1. f returns Ok("hi").
//   2. Match Ok payload is hi; Err FAIL.
//   3. Exit 1 before PASSED on a miss.

fn f() -> Result[String, String] {
    return Ok("hi");
}

pub fn main() {
    let r: Result[String, String] = f();
    let mut flag: Int = 0;
    match r {
        Ok(s) => {
            if s == "hi" {
                flag = 1;
            }
        }
        Err(e) => {
            println("FAIL");
            process_exit(1);
        }
    }
    if flag != 1 {
        println("FAIL");
        process_exit(1);
    }
    println("ress_sret_smoke: PASSED");
}
