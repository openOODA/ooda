// # Product prove std/neuro_bci/eeg_welch_power_spectral_density.oo
//
// Logline: Fail-closed emit+gcc+run asserts welch_hanning_window_4pt is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_welch_power_spectral_density.oo.
//
// Beats:
//   1. Call welch_hanning_window_4pt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eeg_welch_power_spectral_density: PASSED only if they match.

import "std/neuro_bci/eeg_welch_power_spectral_density.oo";

pub fn main() {
    let eeg_welch_power_spectral_density_mark: Int = 0;
    if eeg_welch_power_spectral_density_mark != 0 {
        process_exit(1);
    }
    let a: WindowedEpoch4 = welch_hanning_window_4pt(0.0, 0.0, 0.0, 0.0);
    let b: WindowedEpoch4 = welch_hanning_window_4pt(0.0, 0.0, 0.0, 0.0);
    if (a).w0 != (b).w0 {
        println("FAIL welch_hanning_window_4pt");
        process_exit(1);
    }
    println("prod_g2_eeg_welch_power_spectral_density: PASSED");
}
