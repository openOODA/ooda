// # Product prove std/compilers/c_header_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/c_header_ast.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_ast.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_c_header_ast: PASSED only if they match.

import "std/compilers/c_header_ast.oo";

pub fn main() {
    let c_header_ast_a = c_type_kind_void();
    let c_header_ast_b = c_type_kind_void();
    if c_header_ast_a != c_header_ast_b {
        println("FAIL c_header_ast");
        process_exit(1);
    }
    println("prod_ap_c_header_ast: PASSED");
}
