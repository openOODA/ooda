// # Product prove std/edge/power_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power_types.oo.
//
// Beats:
//   1. Call battery_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_power_types: PASSED only if they match.

import "std/edge/power_types.oo";

pub fn main() {
    let power_types_mark: Int = 0;
    if power_types_mark != 0 {
        process_exit(1);
    }
    let a: BatteryState = battery_state_new(0, 0, 0, 0, 0, 0, 0);
    let b: BatteryState = battery_state_new(0, 0, 0, 0, 0, 0, 0);
    if (a).capacity_pct != (b).capacity_pct {
        println("FAIL battery_state_new");
        process_exit(1);
    }
    println("prod_power_types: PASSED");
}
