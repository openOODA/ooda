// # Product prove std/gis_topo/kdtree_3d_spatial.oo
//
// Logline: Fail-closed emit+gcc+run asserts kd_next_axis is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/kdtree_3d_spatial.oo.
//
// Beats:
//   1. Call kd_next_axis twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kdtree_3d_spatial: PASSED only if they match.

import "std/gis_topo/kdtree_3d_spatial.oo";

pub fn main() {
    let kdtree_3d_spatial_mark: Int = 0;
    if kdtree_3d_spatial_mark != 0 {
        process_exit(1);
    }
    let a: Int = kd_next_axis(0);
    let b: Int = kd_next_axis(0);
    if a != b {
        println("FAIL kd_next_axis");
        process_exit(1);
    }
    println("prod_g2_kdtree_3d_spatial: PASSED");
}
