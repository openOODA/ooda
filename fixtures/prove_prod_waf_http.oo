// # Product prove std/sec/net/waf_http.oo
//
// Logline: Fail-closed emit+gcc+run asserts waf_http_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/waf_http.oo.
//
// Beats:
//   1. Call waf_http_ready twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_waf_http: PASSED only if they match.

import "std/sec/net/waf_http.oo";

pub fn main() {
    let a = waf_http_ready();
    let b = waf_http_ready();
    if a != b {
        println("FAIL waf_http_ready");
        process_exit(1);
    }
    println("prod_waf_http: PASSED");
}
