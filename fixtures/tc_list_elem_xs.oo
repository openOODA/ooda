// # List element mismatch on xs
//
// Logline: Check refuses list_push of a String into Int list xs.
//
// Setup: Single-file probe. The list name is xs, not ys.
//
// Beats:
//   1. Bind xs as List[Int].
//   2. Push a string literal.
//   3. check must ERR type list element mismatch.

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, "hi");
}
