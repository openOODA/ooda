// # Product prove std/db_columnar/columnar_vectorized_sort.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_vectorized_sort.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_vectorized_sort.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_columnar_vectorized_sort: PASSED only if they match.

import "std/db_columnar/columnar_vectorized_sort.oo";

pub fn main() {
    let columnar_vectorized_sort_a = permutation_vector_identity(0);
    let columnar_vectorized_sort_b = permutation_vector_identity(0);
    if columnar_vectorized_sort_a.length != columnar_vectorized_sort_b.length {
        println("FAIL columnar_vectorized_sort");
        process_exit(1);
    }
    println("prod_ap_columnar_vectorized_sort: PASSED");
}
