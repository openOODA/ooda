import "std/quantum_tensor_nets/dmrg_excited_states.oo";

pub fn main() {
    let dmrg_excited_states_a = excited_state_penalty_new(0, 0.0);
    let dmrg_excited_states_b = excited_state_penalty_new(0, 0.0);
    if dmrg_excited_states_a.state_id != dmrg_excited_states_b.state_id {
        println("FAIL dmrg_excited_states");
        process_exit(1);
    }
    println("prod_ap_dmrg_excited_states: PASSED");
