// # emit-x86 const-int less if
//
// Logline: If 1 is less than 2 print yes else no.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the true less branch.
//   3. as+ld stdout is yes only.
//
// residual: SysV stays later.

pub fn main() {
    if 1 < 2 {
        println("yes");
    } else {
        println("no");
    }
}
