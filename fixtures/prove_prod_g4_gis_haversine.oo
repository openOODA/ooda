// # Product prove std/gis_spatial/haversine.oo
//
// Logline: Fail-closed verification that Haversine great-circle spherical distance, radius, and midpoint calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/haversine.oo.
//
// Beats:
//   1. Query nominal spherical Earth radius.
//   2. Calculate great-circle spherical distances in meters and kilometers.
//   3. Compute spherical geographic midpoint between coordinate pairs.
//   4. Print prod_g4_gis_haversine: PASSED only if all match.

import "std/gis_spatial/haversine.oo";

pub fn main() {
    let r_a: Float = haversine_earth_radius_m();
    let r_b: Float = haversine_earth_radius_m();
    if r_a != r_b || r_a != 6371000.0 {
        println("FAIL haversine_earth_radius_m");
        process_exit(1);
    }

    let d_zero_a: Float = haversine_distance(0.0, 0.0, 0.0, 0.0);
    let d_zero_b: Float = haversine_distance(0.0, 0.0, 0.0, 0.0);
    if d_zero_a != d_zero_b || d_zero_a != 0.0 {
        println("FAIL haversine_distance zero");
        process_exit(1);
    }

    let d_km: Float = haversine_distance_km(0.0, 0.0, 0.0, 0.0);
    if d_km != 0.0 {
        println("FAIL haversine_distance_km zero");
        process_exit(1);
    }

    let mid: GeoPoint2D = haversine_midpoint(10.0, 20.0, 30.0, 40.0);
    if (mid).x != 30.0 || (mid).y != 20.0 {
        println("FAIL haversine_midpoint");
        process_exit(1);
    }

    println("prod_g4_gis_haversine: PASSED");
    process_exit(0);
}
