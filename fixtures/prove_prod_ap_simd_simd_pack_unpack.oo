// # Product prove std/simd/simd_pack_unpack.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_pack_unpack.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_pack_unpack.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_pack_unpack: PASSED only if they match.

import "std/simd/simd_pack_unpack.oo";

pub fn main() {
    let simd_pack_unpack_a = simd_pack_4bytes(0, 0, 0, 0);
    let simd_pack_unpack_b = simd_pack_4bytes(0, 0, 0, 0);
    if simd_pack_unpack_a != simd_pack_unpack_b {
        println("FAIL simd_pack_unpack");
        process_exit(1);
    }
    println("prod_ap_simd_pack_unpack: PASSED");
}
