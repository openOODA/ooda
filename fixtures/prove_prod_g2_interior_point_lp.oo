// # Product prove std/scicomp/interior_point_lp.oo
//
// Logline: Fail-closed emit+gcc+run asserts ip_lp_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/interior_point_lp.oo.
//
// Beats:
//   1. Call ip_lp_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_interior_point_lp: PASSED only if they match.

import "std/scicomp/interior_point_lp.oo";

pub fn main() {
    let interior_point_lp_mark: Int = 0;
    if interior_point_lp_mark != 0 {
        process_exit(1);
    }
    let a: IpLpConfig = ip_lp_config_default();
    let b: IpLpConfig = ip_lp_config_default();
    if (a).max_iters != (b).max_iters {
        println("FAIL ip_lp_config_default");
        process_exit(1);
    }
    println("prod_g2_interior_point_lp: PASSED");
}
