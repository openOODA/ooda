// # Product prove std/robotics_ros2/slam_loop_closure_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts loop_detector_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_loop_closure_detector.oo.
//
// Beats:
//   1. Call loop_detector_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_slam_loop_closure_detector: PASSED only if they match.

import "std/robotics_ros2/slam_loop_closure_detector.oo";

pub fn main() {
    let slam_loop_closure_detector_mark: Int = 0;
    if slam_loop_closure_detector_mark != 0 {
        process_exit(1);
    }
    let a: LoopDetectorConfig = loop_detector_config_default();
    let b: LoopDetectorConfig = loop_detector_config_default();
    if (a).min_keyframe_separation != (b).min_keyframe_separation {
        println("FAIL loop_detector_config_default");
        process_exit(1);
    }
    println("prod_g2_slam_loop_closure_detector: PASSED");
}
