// # Product prove std/auto/fusion_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/fusion_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fusion_engine: PASSED only if they match.

import "std/auto/fusion_engine.oo";

pub fn main() {
    let fusion_engine_a = fus_eng_new(0, 0);
    let fusion_engine_b = fus_eng_new(0, 0);
    let fusion_engine_va = fus_eng_active(fusion_engine_a);
    let fusion_engine_vb = fus_eng_active(fusion_engine_b);
    if fusion_engine_va != fusion_engine_vb {
        println("FAIL fusion_engine");
        process_exit(1);
    }
    println("prod_ap_fusion_engine: PASSED");
}
