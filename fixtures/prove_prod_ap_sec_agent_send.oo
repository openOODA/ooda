// # Product prove std/sec/agent_send.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/agent_send.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/agent_send.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_agent_send: PASSED only if they match.

import "std/sec/agent_send.oo";

pub fn main() {
    let agent_send_a = msg_carries_token("x");
    let agent_send_b = msg_carries_token("x");
    if agent_send_a != agent_send_b {
        println("FAIL agent_send");
        process_exit(1);
    }
    println("prod_ap_agent_send: PASSED");
}
