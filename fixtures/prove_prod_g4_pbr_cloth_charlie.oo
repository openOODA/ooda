// # Product prove std/pbr_raytracing/brdf_cloth_charlie_sheen.oo
//
// Logline: Fail-closed verification that Charlie sheen cloth BRDF evaluation and normal distribution are deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_cloth_charlie_sheen.oo.
//
// Beats:
//   1. Construct default ClothParams.
//   2. Compute Charlie normal distribution response.
//   3. Evaluate cloth micro-fiber sheen and diffuse BRDF reflectance.
//   4. Print prod_g4_pbr_cloth_charlie: PASSED and exit 0.

import "std/pbr_raytracing/brdf_cloth_charlie_sheen.oo";

pub fn main() {
    let params1: ClothParams = cloth_params_default();
    let params2: ClothParams = cloth_params_default();

    if (params1).sheen_roughness != (params2).sheen_roughness || (params1).sheen_roughness != 0.3 {
        println("FAIL cloth_params_default sheen_roughness");
        process_exit(1);
    }

    let d1: Float = charlie_distribution(0.7, 0.3);
    let d2: Float = charlie_distribution(0.7, 0.3);
    if d1 != d2 || d1 <= 0.0 {
        println("FAIL charlie_distribution");
        process_exit(1);
    }

    let l: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let v: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let n: Vec3 = vec3_new(0.0, 0.0, 1.0);

    let eval1: Vec3 = cloth_eval(&l, &v, &n, &params1);
    let eval2: Vec3 = cloth_eval(&l, &v, &n, &params2);

    if (eval1).x != (eval2).x || (eval1).x <= 0.0 {
        println("FAIL cloth_eval x");
        process_exit(1);
    }
    if (eval1).y != (eval2).y || (eval1).y <= 0.0 {
        println("FAIL cloth_eval y");
        process_exit(1);
    }
    if (eval1).z != (eval2).z || (eval1).z <= 0.0 {
        println("FAIL cloth_eval z");
        process_exit(1);
    }

    println("prod_g4_pbr_cloth_charlie: PASSED");
    process_exit(0);
}
