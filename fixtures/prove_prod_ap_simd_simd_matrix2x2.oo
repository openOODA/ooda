// # Product prove std/simd/simd_matrix2x2.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_matrix2x2.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_matrix2x2.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_matrix2x2: PASSED only if they match.

import "std/simd/simd_matrix2x2.oo";

pub fn main() {
    let simd_matrix2x2_a = simd_mat2_new(0.0, 0.0, 0.0, 0.0);
    let simd_matrix2x2_b = simd_mat2_new(0.0, 0.0, 0.0, 0.0);
    let simd_matrix2x2_va = simd_mat2_det(simd_matrix2x2_a);
    let simd_matrix2x2_vb = simd_mat2_det(simd_matrix2x2_b);
    if simd_matrix2x2_va != simd_matrix2x2_vb {
        println("FAIL simd_matrix2x2");
        process_exit(1);
    }
    println("prod_ap_simd_matrix2x2: PASSED");
}
