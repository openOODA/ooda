// # Product prove std/pbr_raytracing/brdf_dielectric_specular.oo
//
// Logline: Fail-closed verification that smooth dielectric reflection and transmission sampling are deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_dielectric_specular.oo.
//
// Beats:
//   1. Call module probe and assert zero return code.
//   2. Sample specular reflection and refractive transmission at normal incidence.
//   3. Assert deterministic transmission flags, PDF weights, and attenuation colors.
//   4. Print prod_g4_pbr_dielectric: PASSED and exit 0.

import "std/pbr_raytracing/brdf_dielectric_specular.oo";

pub fn main() {
    let p1: Int = brdf_dielectric_specular_probe();
    let p2: Int = brdf_dielectric_specular_probe();
    if p1 != p2 || p1 != 0 {
        println("FAIL brdf_dielectric_specular_probe");
        process_exit(1);
    }

    let glass: DielectricParams = dielectric_new(1.5, 1.0, vec3_new(1.0, 1.0, 1.0));
    if (glass).ior_inside != 1.5 || (glass).ior_outside != 1.0 {
        println("FAIL dielectric_new");
        process_exit(1);
    }

    let wo: Vec3 = vec3_new(0.0, 0.0, 1.0);
    let n: Vec3 = vec3_new(0.0, 0.0, 1.0);

    let sample_refl1: SpecularSample = dielectric_sample(&wo, &n, &glass, 0.001);
    let sample_refl2: SpecularSample = dielectric_sample(&wo, &n, &glass, 0.001);
    if (sample_refl1).is_transmission != 0 || (sample_refl2).is_transmission != 0 {
        println("FAIL dielectric_sample reflection transmission flag");
        process_exit(1);
    }
    if (sample_refl1).pdf != (sample_refl2).pdf || (sample_refl1).pdf <= 0.0 {
        println("FAIL dielectric_sample reflection pdf");
        process_exit(1);
    }

    let sample_trans1: SpecularSample = dielectric_sample(&wo, &n, &glass, 0.999);
    let sample_trans2: SpecularSample = dielectric_sample(&wo, &n, &glass, 0.999);
    if (sample_trans1).is_transmission != 1 || (sample_trans2).is_transmission != 1 {
        println("FAIL dielectric_sample refraction transmission flag");
        process_exit(1);
    }
    if (sample_trans1).pdf != (sample_trans2).pdf || (sample_trans1).pdf <= 0.0 {
        println("FAIL dielectric_sample refraction pdf");
        process_exit(1);
    }

    println("prod_g4_pbr_dielectric: PASSED");
    process_exit(0);
}
