// # Product prove std/sec/crypto/bfv_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts bfv_stubs_flags is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call bfv_stubs_flags twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bfv_stubs: PASSED only if they match.

import "std/sec/crypto/bfv_stubs.oo";

pub fn main() {
    let g2_oa = bfv_stubs_init(2, 2, 2);
    let g2_ob = bfv_stubs_init(2, 2, 2);
    let g2_a = bfv_stubs_flags(g2_oa);
    let g2_b = bfv_stubs_flags(g2_ob);
    if g2_a != g2_b {
        println("FAIL bfv_stubs_flags");
        process_exit(1);
    }
    println("prod_g2_bfv_stubs: PASSED");
}
