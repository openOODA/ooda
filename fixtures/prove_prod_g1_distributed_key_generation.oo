// # Product prove std/bft_consensus/distributed_key_generation.oo
//
// Logline: Fail-closed emit+gcc+run asserts dkg_is_qual_satisfied is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/distributed_key_generation.oo.
//
// Beats:
//   1. Call dkg_is_qual_satisfied twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_distributed_key_generation: PASSED only if they match.

import "std/bft_consensus/distributed_key_generation.oo";

pub fn main() {
    let obj_a: DkgSession = dkg_session_new(0, 0);
    let obj_b: DkgSession = dkg_session_new(0, 0);
    let a: Bool = dkg_is_qual_satisfied(obj_a);
    let b: Bool = dkg_is_qual_satisfied(obj_b);
    if a != b {
        println("FAIL dkg_is_qual_satisfied");
        process_exit(1);
    }
    println("prod_distributed_key_generation: PASSED");
}
