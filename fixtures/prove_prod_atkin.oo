// # Product prime list prove
//
// Logline: Fail-closed emit+gcc+run of shipped atkin_sieve_count.
//
// Setup: Product std/math/prime_sieve_atkin.oo. Primes <= 10 are 2,3,5,7.
//
// Beats:
//   1. atkin_sieve_count of limit 10 is 4.
//   2. Limit 1 is 0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/prime_sieve_atkin.oo";

pub fn main() {
    let s: AtkinSieve = atkin_sieve_generate(10);
    let n: Int = atkin_sieve_count(s);
    if n != 4 {
        println("FAIL atkin 10");
        process_exit(1);
    }
    let s1: AtkinSieve = atkin_sieve_generate(1);
    let n1: Int = atkin_sieve_count(s1);
    if n1 != 0 {
        println("FAIL atkin 1");
        process_exit(1);
    }
    println("prod_atkin: PASSED");
}
