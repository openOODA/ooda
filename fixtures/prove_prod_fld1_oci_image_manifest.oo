// # Product prove std/cloud_k8s/oci_image_manifest.oo
//
// Logline: Fail-closed emit+gcc+run asserts oci_image_manifest_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/oci_image_manifest.oo.
//
// Beats:
//   1. Call oci_image_manifest_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_oci_image_manifest: PASSED only if they match.

import "std/cloud_k8s/oci_image_manifest.oo";

pub fn main() {
    let oci_image_manifest_mark: Int = 0;
    if oci_image_manifest_mark != 0 {
        process_exit(1);
    }
    let oci_image_manifest_a = oci_image_manifest_new(oci_descriptor_new("x", "x", 1));
    let oci_image_manifest_b = oci_image_manifest_new(oci_descriptor_new("x", "x", 1));
    if (oci_image_manifest_a).schema_version != (oci_image_manifest_b).schema_version {
        println("FAIL oci_image_manifest_new");
        process_exit(1);
    }
    println("prod_oci_image_manifest: PASSED");
}
