// # Product prove std/space_propulsion/propellant_tank_pressurization.oo
//
// Logline: Fail-closed emit+gcc+run asserts tank_pressurization_spec_default_methalox is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_tank_pressurization.oo.
//
// Beats:
//   1. Call tank_pressurization_spec_default_methalox twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propellant_tank_pressurization: PASSED only if they match.

import "std/space_propulsion/propellant_tank_pressurization.oo";

pub fn main() {
    let propellant_tank_pressurization_mark: Int = 0;
    if propellant_tank_pressurization_mark != 0 {
        process_exit(1);
    }
    let a: TankPressurizationSpec = tank_pressurization_spec_default_methalox();
    let b: TankPressurizationSpec = tank_pressurization_spec_default_methalox();
    if (a).pressurant_gas_type != (b).pressurant_gas_type {
        println("FAIL tank_pressurization_spec_default_methalox");
        process_exit(1);
    }
    println("prod_propellant_tank_pressurization: PASSED");
}
