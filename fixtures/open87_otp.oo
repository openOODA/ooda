// # otp_supervise restarts on fail once
//
// Logline: Spawn an actor, supervise once, second supervise is refused.
//
// Setup: OPEN-87. ThreadCap. Restart-on-fail once. Not residual refuse.
//
// Beats:
//   1. actor_spawn.
//   2. otp_supervise once is Ok.
//   3. Second call is Err; print PASSED.

pub fn main(thread: &ThreadCap) {
    let a: Result[String, String] = actor_spawn(thread, "w");
    if a.is_err() {
        println("FAIL spawn");
        process_exit(1);
    }
    let r: Result[String, String] = otp_supervise(thread, 0);
    if r.is_err() {
        println("FAIL supervise");
        process_exit(1);
    }
    let r2: Result[String, String] = otp_supervise(thread, 0);
    if r2.is_ok() {
        println("FAIL once");
        process_exit(1);
    }
    println("open87_otp: PASSED");
}
