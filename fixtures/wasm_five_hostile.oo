// # Hostile IDENT fifth println
//
// Logline: Print four strings then IDENT x so emit-wasm must miss a five-string fold.
//
// Setup: One public main. Fifth print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-d, then x.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println(x);
}
