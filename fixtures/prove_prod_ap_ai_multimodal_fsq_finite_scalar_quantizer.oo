// # Product prove std/ai_multimodal/fsq_finite_scalar_quantizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/fsq_finite_scalar_quantizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/fsq_finite_scalar_quantizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fsq_finite_scalar_quantizer: PASSED only if they match.

import "std/ai_multimodal/fsq_finite_scalar_quantizer.oo";

pub fn main() {
    let fsq_finite_scalar_quantizer_a = fsq_config_new(0, 0);
    let fsq_finite_scalar_quantizer_b = fsq_config_new(0, 0);
    let fsq_finite_scalar_quantizer_va = fsq_codebook_size(fsq_finite_scalar_quantizer_a);
    let fsq_finite_scalar_quantizer_vb = fsq_codebook_size(fsq_finite_scalar_quantizer_b);
    if fsq_finite_scalar_quantizer_va != fsq_finite_scalar_quantizer_vb {
        println("FAIL fsq_finite_scalar_quantizer");
        process_exit(1);
    }
    println("prod_ap_fsq_finite_scalar_quantizer: PASSED");
}
