// # Product prove std/fintech_defi/options_greeks_surface.oo
//
// Logline: Fail-closed emit+gcc+run asserts greeks_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/options_greeks_surface.oo.
//
// Beats:
//   1. Call greeks_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_options_greeks_surface: PASSED only if they match.

import "std/fintech_defi/options_greeks_surface.oo";

pub fn main() {
    let options_greeks_surface_mark: Int = 0;
    if options_greeks_surface_mark != 0 {
        process_exit(1);
    }
    let a: Float = greeks_norm_pdf(0.0);
    let b: Float = greeks_norm_pdf(0.0);
    if a != b {
        println("FAIL greeks_norm_pdf");
        process_exit(1);
    }
    println("prod_options_greeks_surface: PASSED");
}
