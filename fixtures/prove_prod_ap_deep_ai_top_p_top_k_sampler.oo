// # Product prove std/deep_ai/top_p_top_k_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/deep_ai/top_p_top_k_sampler.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/top_p_top_k_sampler.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_top_p_top_k_sampler: PASSED only if they match.

import "std/deep_ai/top_p_top_k_sampler.oo";

pub fn main() {
    let top_p_top_k_sampler_a = tpk_softmax4(0, 0, 0, 0, 0);
    let top_p_top_k_sampler_b = tpk_softmax4(0, 0, 0, 0, 0);
    let top_p_top_k_sampler_va = tpk_sample(top_p_top_k_sampler_a, 0);
    let top_p_top_k_sampler_vb = tpk_sample(top_p_top_k_sampler_b, 0);
    if top_p_top_k_sampler_va != top_p_top_k_sampler_vb {
        println("FAIL top_p_top_k_sampler");
        process_exit(1);
    }
    println("prod_ap_top_p_top_k_sampler: PASSED");
}
