// # Product prove std/sec/sys/pe_engine.oo
//
// Logline: Fail-closed emit+check asserts pe_get_data_directory_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_engine.oo.
//
// Beats:
//   1. Call pe_get_data_directory_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pe_engine: PASSED only if they match.

import "std/sec/sys/pe_engine.oo";

pub fn main() {
    let pe_engine_mark: Int = 0;
    if pe_engine_mark != 0 { process_exit(1); }
    let a: String = pe_get_data_directory_name(0);
    let b: String = pe_get_data_directory_name(0);
    if a != b { process_exit(1); }
    println("prod_pe_engine: PASSED");
}
