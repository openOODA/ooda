// # Product AES-128-ECB encrypt
//
// Logline: Encrypt one NIST block and print the hex ciphertext.
//
// Setup: OPEN-77. ooda/std/core/crypto.oo. Does not process_exit.
//
// Beats:
//   1. Decode the NIST AES-128 key and plaintext.
//   2. Encrypt and require 69c4e0d86a7b0430d8cdb78070b4c55a.
//   3. Print the hex and PASSED.

import "std/core/crypto.oo";
import "std/encoding/hex.oo";

pub fn main() {
    let kr: Result[String, String] = hex_decode("000102030405060708090a0b0c0d0e0f");
    if kr.is_err() {
        println("FAIL key");
        process_exit(1);
    }
    let pr: Result[String, String] = hex_decode("00112233445566778899aabbccddeeff");
    if pr.is_err() {
        println("FAIL plain");
        process_exit(1);
    }
    let key: String = kr.unwrap();
    let plain: String = pr.unwrap();
    let c: String = aes_encrypt(key, plain);
    println(c);
    if c != "69c4e0d86a7b0430d8cdb78070b4c55a" {
        println("FAIL aes nist");
        process_exit(1);
    }
    println("open77: PASSED");
}
