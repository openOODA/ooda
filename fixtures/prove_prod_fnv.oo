// # Product prove std/hash/fnv.oo
//
// Logline: Fail-closed emit+gcc+run asserts fnv1a_32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/fnv.oo.
//
// Beats:
//   1. Call fnv1a_32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fnv: PASSED only if they match.

import "std/hash/fnv.oo";

pub fn main() {
    let a = fnv1a_32("x");
    let b = fnv1a_32("x");
    if a != b {
        println("FAIL fnv1a_32");
        process_exit(1);
    }
    println("prod_fnv: PASSED");
}
