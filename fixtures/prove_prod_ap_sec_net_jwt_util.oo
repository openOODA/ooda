// # Product prove std/sec/net/jwt_util.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/jwt_util.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_util.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jwt_util: PASSED only if they match.

import "std/sec/net/jwt_util.oo";

pub fn main() {
    let jwt_util_a = jwt_str_eq("x", "x");
    let jwt_util_b = jwt_str_eq("x", "x");
    if jwt_util_a != jwt_util_b {
        println("FAIL jwt_util");
        process_exit(1);
    }
    println("prod_ap_jwt_util: PASSED");
}
