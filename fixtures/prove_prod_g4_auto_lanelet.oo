// # Product prove std/auto/lanelet.oo
//
// Logline: Fail-closed verification that HD lanelet map facade, geometry helpers, and engine operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet.oo.
//
// Beats:
//   1. Call waypoint and lanelet shim markers.
//   2. Verify integer math helper routines and LltOp / LltEng structures.
//   3. Assert deterministic state.
//   4. Print prod_g4_auto_lanelet: PASSED only if all match.

import "std/auto/lanelet.oo";

pub fn main() {
    let wp_zero: Waypoint = shim_marker_waypoint_zero();
    if (wp_zero).id != 0 || (wp_zero).x != 0 || (wp_zero).y != 0 {
        println("FAIL shim_marker_waypoint_zero");
        process_exit(1);
    }

    let wp_new: Waypoint = shim_marker_waypoint_new();
    if (wp_new).id != 1 {
        println("FAIL shim_marker_waypoint_new");
        process_exit(1);
    }

    let bnd: LaneBoundary = shim_marker_lane_boundary_new();
    if (bnd).id != 1 || (bnd).boundary_type != 1 {
        println("FAIL shim_marker_lane_boundary_new");
        process_exit(1);
    }

    let llt: Lanelet = shim_marker_lanelet_empty();
    if (llt).id != 0 {
        println("FAIL shim_marker_lanelet_empty");
        process_exit(1);
    }

    let eng: LaneletEngine = shim_marker_engine_init();
    let work_res: Int = shim_marker_engine_do_work(&eng);
    if work_res != 0 {
        println("FAIL shim_marker_engine_do_work");
        process_exit(1);
    }

    let abs_res: Int = lanelet_abs_val(0 - 42);
    if abs_res != 42 {
        println("FAIL lanelet_abs_val");
        process_exit(1);
    }

    let min_res: Int = lanelet_min_val(10, 20);
    let max_res: Int = lanelet_max_val(10, 20);
    if min_res != 10 || max_res != 20 {
        println("FAIL lanelet_min_max_val");
        process_exit(1);
    }

    let sqrt_res: Int = lanelet_isqrt(144);
    if sqrt_res != 12 {
        println("FAIL lanelet_isqrt");
        process_exit(1);
    }

    let op: LltOp = llt_op_new(65, 1);
    let spd: Int = llt_op_speed(op);
    if spd != 65 {
        println("FAIL llt_op_speed");
        process_exit(1);
    }

    let eng_rec: LltEng = llt_eng_new(101, 5);
    let mid: Int = llt_eng_map_id(eng_rec);
    if mid != 101 {
        println("FAIL llt_eng_map_id");
        process_exit(1);
    }

    println("prod_g4_auto_lanelet: PASSED");
    process_exit(0);
}
