// # Product prove std/telecom_5g/telecom_5g_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_hardware_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/telecom_5g_stubs.oo.
//
// Beats:
//   1. Call nr5g_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_telecom_5g_stubs: PASSED only if they match.

import "std/telecom_5g/telecom_5g_stubs.oo";

pub fn main() {
    let a: Nr5gHardwareCapabilities = nr5g_hardware_capabilities_default();
    let b: Nr5gHardwareCapabilities = nr5g_hardware_capabilities_default();
    if a.num_rf_channels != b.num_rf_channels {
        println("FAIL nr5g_hardware_capabilities_default");
        process_exit(1);
    }
    println("prod_telecom_5g_stubs: PASSED");
}
