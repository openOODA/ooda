// # List[List[Int]] emit lock
//
// Logline: Fail-closed emit+gcc+run of nested List[List[Int]] push and get.
//
// Setup: Backend-C. Inner list holds 4. Nested list_get must yield Int.
//
// Beats:
//   1. Push 4 onto an inner List[Int].
//   2. Push that inner list onto xs.
//   3. Exit 1 before PASSED when nested get is not 4.

pub fn main() {
    let mut inner: List[Int] = list_new();
    inner = list_push(inner, 4);
    let empty: List[List[Int]] = list_new();
    let xs: List[List[Int]] = list_push(empty, inner);
    if list_get(list_get(xs, 0), 0) != 4 {
        println("FAIL");
        process_exit(1);
    }
    println("list_ll_int_smoke: PASSED");
}
