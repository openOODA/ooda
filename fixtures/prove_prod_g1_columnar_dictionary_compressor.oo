// # Product prove std/db_columnar/columnar_dictionary_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts dict_compressor_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_dictionary_compressor.oo.
//
// Beats:
//   1. Call dict_compressor_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_dictionary_compressor: PASSED only if they match.

import "std/db_columnar/columnar_dictionary_compressor.oo";

pub fn main() {
    let a: DictCompressorConfig = dict_compressor_config_default();
    let b: DictCompressorConfig = dict_compressor_config_default();
    if a.max_dictionary_entries != b.max_dictionary_entries {
        println("FAIL dict_compressor_config_default");
        process_exit(1);
    }
    println("prod_columnar_dictionary_compressor: PASSED");
}
