// # Product sync countdown latch prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/latch_countdown.oo.
//
// Setup: Product std/sync/latch_countdown.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(3) count 3 not zero. new(0) is zero. negative clamps 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/latch_countdown.oo";

pub fn main() {
    let l: CountdownLatch = latch_new(3);
    let n: Int = latch_get_count(l);
    if n != 3 {
        println("FAIL latch 3");
        process_exit(1);
    }
    if latch_is_zero(l) {
        println("FAIL latch not zero");
        process_exit(1);
    }
    let z: CountdownLatch = latch_new(0);
    if latch_is_zero(z) == false {
        println("FAIL latch zero");
        process_exit(1);
    }
    let n2: Int = latch_get_count(latch_new(-5));
    if n2 != 0 {
        println("FAIL latch clamp");
        process_exit(1);
    }
    println("prod_latchc: PASSED");
}
