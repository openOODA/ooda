// # Product prove std/web_ecosystem/ulid_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts crockford_base32_alphabet is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/ulid_generator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call crockford_base32_alphabet twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_ulid_generator: PASSED only if they match.

import "std/web_ecosystem/ulid_generator.oo";

pub fn main() {
    let g0_a = crockford_base32_alphabet();
    let g0_b = crockford_base32_alphabet();
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL crockford_base32_alphabet");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL crockford_base32_alphabet");
        process_exit(1);
    }
    println("prod_g0_ulid_generator: PASSED");
}
