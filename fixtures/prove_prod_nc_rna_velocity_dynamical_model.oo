// # Product prove std/genomics_advanced/rna_velocity_dynamical_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_velocity_dynamical_model_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/rna_velocity_dynamical_model.oo.
//
// Beats:
//   1. Call rna_velocity_dynamical_model_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_rna_velocity_dynamical_model: PASSED only if it matches.

import "std/genomics_advanced/rna_velocity_dynamical_model.oo";

pub fn main() {
    let a: Int = rna_velocity_dynamical_model_probe();
    if a != 0 {
        println("FAIL rna_velocity_dynamical_model_probe");
        process_exit(1);
    }
    println("prod_nc_rna_velocity_dynamical_model: PASSED");
}
