// # Product prove std/astro_advanced/orbit_determination_herrick_gibbs.oo
//
// Logline: Fail-closed emit+gcc+run asserts od_hg_obs is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/orbit_determination_herrick_gibbs.oo.
//
// Beats:
//   1. Call od_hg_obs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbit_determination_herrick_gibbs: PASSED only if they match.

import "std/astro_advanced/orbit_determination_herrick_gibbs.oo";

pub fn main() {
    let orbit_determination_herrick_gibbs_mark: Int = 0;
    if orbit_determination_herrick_gibbs_mark != 0 {
        process_exit(1);
    }
    let a: Int = od_hg_obs();
    let b: Int = od_hg_obs();
    if a != b {
        println("FAIL od_hg_obs");
        process_exit(1);
    }
    println("prod_orbit_determination_herrick_gibbs: PASSED");
}
