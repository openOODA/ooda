// # Product prove std/tda_topology/sliding_window_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts sliding_window_detect_anomaly is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/sliding_window_tda.oo.
//
// Beats:
//   1. Call sliding_window_detect_anomaly twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sliding_window_tda: PASSED only if they match.

import "std/tda_topology/sliding_window_tda.oo";

pub fn main() {
    let sliding_window_tda_mark: Int = 0;
    if sliding_window_tda_mark != 0 {
        process_exit(1);
    }
    let sliding_window_tda_obj: SlidingWindowTda = sliding_window_tda_new(sliding_window_config_new(1, 1, 1, 1));
    let sliding_window_tda_a: Bool = sliding_window_detect_anomaly(&sliding_window_tda_obj, 1, 1.0);
    let sliding_window_tda_b: Bool = sliding_window_detect_anomaly(&sliding_window_tda_obj, 1, 1.0);
    if sliding_window_tda_a != sliding_window_tda_b {
        println("FAIL sliding_window_detect_anomaly");
        process_exit(1);
    }
    println("prod_sliding_window_tda: PASSED");
}
