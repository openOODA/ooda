// # Product prove std/ai_ml/tokenizer_bpe.oo
//
// Logline: Fail-closed emit+gcc+run asserts bpe_vocab_size is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/tokenizer_bpe.oo.
//
// Beats:
//   1. Call bpe_vocab_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tokenizer_bpe: PASSED only if they match.

import "std/ai_ml/tokenizer_bpe.oo";

pub fn main() {
    let a = bpe_vocab_size();
    let b = bpe_vocab_size();
    if a != b {
        println("FAIL bpe_vocab_size");
        process_exit(1);
    }
    println("prod_tokenizer_bpe: PASSED");
}
