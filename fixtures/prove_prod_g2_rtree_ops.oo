// # Product prove std/gis_spatial/rtree_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtree_ops_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/rtree_ops.oo.
//
// Beats:
//   1. Call rtree_ops_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_rtree_ops: PASSED only if they match.

import "std/gis_spatial/rtree_ops.oo";

pub fn main() {
    let a: Int = rtree_ops_probe();
    let b: Int = rtree_ops_probe();
    if a != b {
        println("FAIL rtree_ops_probe");
        process_exit(1);
    }
    println("prod_g2_rtree_ops: PASSED");
}
