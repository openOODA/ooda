// # Product prove std/db_graph/property_graph_delta_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/property_graph_delta_store.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_delta_store.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_property_graph_delta_store: PASSED only if they match.

import "std/db_graph/property_graph_delta_store.oo";

pub fn main() {
    let property_graph_delta_store_a = graph_delta_store_new(0);
    let property_graph_delta_store_b = graph_delta_store_new(0);
    if property_graph_delta_store_a.tx_id != property_graph_delta_store_b.tx_id {
        println("FAIL property_graph_delta_store");
        process_exit(1);
    }
    println("prod_ap_property_graph_delta_store: PASSED");
}
