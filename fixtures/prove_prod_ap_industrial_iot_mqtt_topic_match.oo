// # Product prove std/industrial_iot/mqtt_topic_match.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/industrial_iot/mqtt_topic_match.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/mqtt_topic_match.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mqtt_topic_match: PASSED only if they match.

import "std/industrial_iot/mqtt_topic_match.oo";

pub fn main() {
    let mqtt_topic_match_a = mqtt_topic_is_valid_name("x");
    let mqtt_topic_match_b = mqtt_topic_is_valid_name("x");
    if mqtt_topic_match_a != mqtt_topic_match_b {
        println("FAIL mqtt_topic_match");
        process_exit(1);
    }
    println("prod_ap_mqtt_topic_match: PASSED");
}
