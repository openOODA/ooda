// # Product prove std/crypto_advanced/bulletproofs_inner_product.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/bulletproofs_inner_product.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bulletproofs_inner_product.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_bulletproofs_inner_product: PASSED only if they match.

import "std/crypto_advanced/bulletproofs_inner_product.oo";

pub fn main() {
    let bulletproofs_inner_product_a = bulletproofs_inner_product(list_new(), list_new(), 0);
    let bulletproofs_inner_product_b = bulletproofs_inner_product(list_new(), list_new(), 0);
    if bulletproofs_inner_product_a != bulletproofs_inner_product_b {
        println("FAIL bulletproofs_inner_product");
        process_exit(1);
    }
    println("prod_ap_bulletproofs_inner_product: PASSED");
}
