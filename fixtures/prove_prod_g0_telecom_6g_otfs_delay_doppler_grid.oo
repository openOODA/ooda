// # Product prove std/telecom_6g/otfs_delay_doppler_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts otfs_isfft_kernel_phase is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/otfs_delay_doppler_grid.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call otfs_isfft_kernel_phase twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_otfs_delay_doppler_grid: PASSED only if they match.

import "std/telecom_6g/otfs_delay_doppler_grid.oo";

pub fn main() {
    let g0_a = otfs_isfft_kernel_phase(2, 2, 2, 2, 2, 2);
    let g0_b = otfs_isfft_kernel_phase(2, 2, 2, 2, 2, 2);
    if g0_a != g0_b {
        println("FAIL otfs_isfft_kernel_phase");
        process_exit(1);
    }
    println("prod_g0_otfs_delay_doppler_grid: PASSED");
}
