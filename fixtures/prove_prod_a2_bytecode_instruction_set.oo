// # Product prove std/compilers_vm/bytecode_instruction_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts op_nop is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/bytecode_instruction_set.oo.
//
// Beats:
//   1. Call op_nop twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bytecode_instruction_set: PASSED only if they match.

import "std/compilers_vm/bytecode_instruction_set.oo";

pub fn main() {
    let bytecode_instruction_set_mark: Int = 0;
    if bytecode_instruction_set_mark != 0 {
        process_exit(1);
    }
    let a: Int = op_nop();
    let b: Int = op_nop();
    if a != b {
        println("FAIL op_nop");
        process_exit(1);
    }
    println("prod_bytecode_instruction_set: PASSED");
}
