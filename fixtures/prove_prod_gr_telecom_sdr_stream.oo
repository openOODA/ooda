// # Product prove std/telecom/sdr_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_stream_int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/sdr_stream.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call sdr_stream_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_sdr_stream: PASSED only if they match.

import "std/telecom/sdr_stream.oo";

pub fn main() {
    let g0_a = sdr_stream_int_to_float(0);
    let g0_b = sdr_stream_int_to_float(0);
    if g0_a != g0_b {
        println("FAIL sdr_stream_int_to_float");
        process_exit(1);
    }
    println("prod_gr_sdr_stream: PASSED");
}
