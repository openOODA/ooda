// # Product prove std/robotics_ros2/slam_loop_closure_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts loop_detector_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/slam_loop_closure_detector.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call loop_detector_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_slam_loop_closure_detector: PASSED only if they match.

import "std/robotics_ros2/slam_loop_closure_detector.oo";

pub fn main() {
    let g2_oa: LoopDetectorConfig = loop_detector_config_default();
    let g2_ob: LoopDetectorConfig = loop_detector_config_default();
    let g2_a = (g2_oa).min_keyframe_separation;
    let g2_b = (g2_ob).min_keyframe_separation;
    if g2_a != g2_b {
        println("FAIL loop_detector_config_default.min_keyframe_separation");
        process_exit(1);
    }
    println("prod_g2_slam_loop_closure_detector: PASSED");
}
