// # Product prove std/zk_rollup/stark_air_constraint.oo
//
// Logline: Fail-closed emit+gcc+run asserts air_boundary_constraint_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_air_constraint.oo.
//
// Beats:
//   1. Call air_boundary_constraint_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_stark_air_constraint: PASSED only if asserts hold.

import "std/zk_rollup/stark_air_constraint.oo";

pub fn main() {
    let stark_air_constraint_a: AirBoundaryConstraint = air_boundary_constraint_new(0, 0, 0);
    let stark_air_constraint_b: AirBoundaryConstraint = air_boundary_constraint_new(0, 0, 0);
    if stark_air_constraint_a.column_index != stark_air_constraint_b.column_index {
        println("FAIL air_boundary_constraint_new");
        process_exit(1);
    }
    println("prod_stark_air_constraint: PASSED");
}
