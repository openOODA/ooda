// # Product prove std/zk_rollup/rollup_withdrawal_merkle.oo
//
// Logline: Fail-closed emit+gcc+run asserts withdrawal_message_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_withdrawal_merkle.oo.
//
// Beats:
//   1. Call withdrawal_message_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_withdrawal_merkle: PASSED only if they match.

import "std/zk_rollup/rollup_withdrawal_merkle.oo";

pub fn main() {
    let rollup_withdrawal_merkle_mark: Int = 0;
    if rollup_withdrawal_merkle_mark != 0 {
        process_exit(1);
    }
    let a: WithdrawalMessage = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    let b: WithdrawalMessage = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    if (a).withdrawal_id != (b).withdrawal_id {
        println("FAIL withdrawal_message_new");
        process_exit(1);
    }
    println("prod_rollup_withdrawal_merkle: PASSED");
}
