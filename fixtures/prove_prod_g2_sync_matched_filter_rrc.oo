// # Product prove std/telecom_5g/sync_matched_filter_rrc.oo
//
// Logline: Fail-closed emit+gcc+run asserts sync_rrc_tap_coeff is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sync_matched_filter_rrc.oo.
//
// Beats:
//   1. Call sync_rrc_tap_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sync_matched_filter_rrc: PASSED only if they match.

import "std/telecom_5g/sync_matched_filter_rrc.oo";

pub fn main() {
    let sync_matched_filter_rrc_mark: Int = 0;
    if sync_matched_filter_rrc_mark != 0 {
        process_exit(1);
    }
    let a: Float = sync_rrc_tap_coeff(0.0, 0.0);
    let b: Float = sync_rrc_tap_coeff(0.0, 0.0);
    if a != b {
        println("FAIL sync_rrc_tap_coeff");
        process_exit(1);
    }
    println("prod_g2_sync_matched_filter_rrc: PASSED");
}
