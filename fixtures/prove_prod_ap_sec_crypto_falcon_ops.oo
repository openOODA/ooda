// # Product prove std/sec/crypto/falcon_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_falcon_ops: PASSED only if they match.

import "std/sec/crypto/falcon_ops.oo";

pub fn main() {
    let falcon_ops_a = falcon_checksum_string("x");
    let falcon_ops_b = falcon_checksum_string("x");
    if falcon_ops_a != falcon_ops_b {
        println("FAIL falcon_ops");
        process_exit(1);
    }
    println("prod_ap_falcon_ops: PASSED");
}
