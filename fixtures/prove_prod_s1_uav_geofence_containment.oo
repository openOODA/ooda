// # Product prove std/uav_flight/uav_geofence_containment.oo
//
// Logline: Fail-closed emit+gcc+run asserts gef_isqrt_seed is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_geofence_containment.oo.
//
// Beats:
//   1. Call gef_isqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_geofence_containment: PASSED only if they match.

import "std/uav_flight/uav_geofence_containment.oo";

pub fn main() {
    let uav_geofence_containment_mark: Int = 0;
    if uav_geofence_containment_mark != 0 {
        process_exit(1);
    }
    let uav_geofence_containment_a: Int = gef_isqrt_seed(1, 1);
    let uav_geofence_containment_b: Int = gef_isqrt_seed(1, 1);
    if uav_geofence_containment_a != uav_geofence_containment_b {
        println("FAIL gef_isqrt_seed");
        process_exit(1);
    }
    println("prod_uav_geofence_containment: PASSED");
}
