// # Product prove std/astrophysics_relativity/accretion_bondi_hoyle_lyttleton.oo
//
// Logline: Fail-closed emit+gcc+run asserts bhl_ambient_sound_speed is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/accretion_bondi_hoyle_lyttleton.oo.
//
// Beats:
//   1. Call bhl_ambient_sound_speed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_accretion_bondi_hoyle_lyttleton: PASSED only if they match.

import "std/astrophysics_relativity/accretion_bondi_hoyle_lyttleton.oo";

pub fn main() {
    let accretion_bondi_hoyle_lyttleton_mark: Int = 0;
    if accretion_bondi_hoyle_lyttleton_mark != 0 {
        process_exit(1);
    }
    let a: Int = bhl_ambient_sound_speed(0, 0);
    let b: Int = bhl_ambient_sound_speed(0, 0);
    if a != b {
        println("FAIL bhl_ambient_sound_speed");
        process_exit(1);
    }
    println("prod_accretion_bondi_hoyle_lyttleton: PASSED");
}
