// # Product prove std/astrophysics_relativity/gw_quasi_normal_modes.oo
//
// Logline: Fail-closed emit+gcc+run asserts qnm_fundamental_l2m2_evaluate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_quasi_normal_modes.oo.
//
// Beats:
//   1. Call qnm_fundamental_l2m2_evaluate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gw_quasi_normal_modes: PASSED only if they match.

import "std/astrophysics_relativity/gw_quasi_normal_modes.oo";

pub fn main() {
    let gw_quasi_normal_modes_mark: Int = 0;
    if gw_quasi_normal_modes_mark != 0 {
        process_exit(1);
    }
    let a: QuasiNormalModeResult = qnm_fundamental_l2m2_evaluate(0.0, 0.0);
    let b: QuasiNormalModeResult = qnm_fundamental_l2m2_evaluate(0.0, 0.0);
    if (a).mass_kg != (b).mass_kg {
        println("FAIL qnm_fundamental_l2m2_evaluate");
        process_exit(1);
    }
    println("prod_gw_quasi_normal_modes: PASSED");
}
