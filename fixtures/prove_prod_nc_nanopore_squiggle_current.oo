// # Product prove std/genomics_advanced/nanopore_squiggle_current.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_squiggle_current_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_squiggle_current.oo.
//
// Beats:
//   1. Call nanopore_squiggle_current_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_nanopore_squiggle_current: PASSED only if it matches.

import "std/genomics_advanced/nanopore_squiggle_current.oo";

pub fn main() {
    let a: Int = nanopore_squiggle_current_probe();
    if a != 0 {
        println("FAIL nanopore_squiggle_current_probe");
        process_exit(1);
    }
    println("prod_nc_nanopore_squiggle_current: PASSED");
}
