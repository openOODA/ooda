// # Product prove std/scenario.oo
//
// Logline: Fail-closed emit+gcc+run asserts expect_equal holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/scenario.oo.
//
// Beats:
//   1. Call expect_equal using the scenario ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_scenario: PASSED only if asserts hold.

import "std/scenario.oo";

pub fn main() {
    let xa = expect_equal("x", "x");
    let xb = expect_equal("x", "x");
    let scenario_a = xa.is_ok();
    if !scenario_a {
        println("FAIL expect_equal");
        process_exit(1);
    }
    println("prod_scenario: PASSED");
}
