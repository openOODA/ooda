// # Product prove std/tda_topology/clique_complex_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts is_clique_in_adj_matrix is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/clique_complex_graph.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call is_clique_in_adj_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_clique_complex_graph: PASSED only if they match.

import "std/tda_topology/clique_complex_graph.oo";

pub fn main() {
    let g0_a = is_clique_in_adj_matrix(list_new(), list_new(), 0);
    let g0_b = is_clique_in_adj_matrix(list_new(), list_new(), 0);
    if g0_a != g0_b {
        println("FAIL is_clique_in_adj_matrix");
        process_exit(1);
    }
    println("prod_gr_clique_complex_graph: PASSED");
}
