// # Product prove std/quantum_tensor_nets/partition_function_2d_ising.oo
//
// Logline: Fail-closed emit+gcc+run asserts ising_2d_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/partition_function_2d_ising.oo.
//
// Beats:
//   1. Call ising_2d_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_partition_function_2d_ising: PASSED only if they match.

import "std/quantum_tensor_nets/partition_function_2d_ising.oo";

pub fn main() {
    let a: Ising2DConfig = ising_2d_config_new(0.0, 0.0);
    let b: Ising2DConfig = ising_2d_config_new(0.0, 0.0);
    if a.coupling_j != b.coupling_j {
        println("FAIL ising_2d_config_new");
        process_exit(1);
    }
    println("prod_partition_function_2d_ising: PASSED");
}
