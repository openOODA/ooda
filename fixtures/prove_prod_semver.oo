// # Product semver gate
//
// Logline: Fail-closed emit+gcc+run of shipped std/semver.oo core parse.
//
// Setup: Tree oodac emit-c. Calls semver_is_valid and semver_major. No caps.
//
// Beats:
//   1. semver_is_valid("1.2.3") is true.
//   2. semver_is_valid("01.0.0") is false (leading zero).
//   3. semver_major("1.2.3") is "1". Exit 1 before PASSED on a miss.

import "std/semver.oo";

pub fn main() {
    if !semver_is_valid("1.2.3") {
        println("FAIL valid 1.2.3");
        process_exit(1);
    }
    if semver_is_valid("01.0.0") {
        println("FAIL leading zero");
        process_exit(1);
    }
    if semver_major("1.2.3") != "1" {
        println("FAIL major");
        process_exit(1);
    }
    println("prod_semver: PASSED");
}
