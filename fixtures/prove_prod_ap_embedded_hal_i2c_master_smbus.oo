// # Product prove std/embedded_hal/i2c_master_smbus.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/i2c_master_smbus.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/i2c_master_smbus.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_i2c_master_smbus: PASSED only if they match.

import "std/embedded_hal/i2c_master_smbus.oo";

pub fn main() {
    let i2c_master_smbus_a = smbus_calculate_pec(list_new());
    let i2c_master_smbus_b = smbus_calculate_pec(list_new());
    if i2c_master_smbus_a != i2c_master_smbus_b {
        println("FAIL i2c_master_smbus");
        process_exit(1);
    }
    println("prod_ap_i2c_master_smbus: PASSED");
}
