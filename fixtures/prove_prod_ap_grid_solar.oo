// # Product prove std/grid/solar.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/solar.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_solar: PASSED only if they match.

import "std/grid/solar.oo";

pub fn main() {
    let solar_a = shim_marker_math_pi();
    let solar_b = shim_marker_math_pi();
    if solar_a != solar_b {
        println("FAIL solar");
        process_exit(1);
    }
    println("prod_ap_solar: PASSED");
}
