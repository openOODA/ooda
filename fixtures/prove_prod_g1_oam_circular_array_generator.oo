// # Product prove std/telecom_6g/oam_circular_array_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts uca_oam_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/oam_circular_array_generator.oo.
//
// Beats:
//   1. Call uca_oam_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_oam_circular_array_generator: PASSED only if they match.

import "std/telecom_6g/oam_circular_array_generator.oo";

pub fn main() {
    let a: UcaOamConfig = uca_oam_config_default(0);
    let b: UcaOamConfig = uca_oam_config_default(0);
    if a.num_array_elements != b.num_array_elements {
        println("FAIL uca_oam_config_default");
        process_exit(1);
    }
    println("prod_oam_circular_array_generator: PASSED");
}
