// # Product prove std/iot_scada/scada_redundancy_arbiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts scada_node_standby_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/scada_redundancy_arbiter.oo.
//
// Beats:
//   1. Call scada_node_standby_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_scada_redundancy_arbiter: PASSED only if they match.

import "std/iot_scada/scada_redundancy_arbiter.oo";

pub fn main() {
    let scada_redundancy_arbiter_mark: Int = 0;
    if scada_redundancy_arbiter_mark != 0 {
        process_exit(1);
    }
    let scada_redundancy_arbiter_a = scada_node_standby_new(1);
    let scada_redundancy_arbiter_b = scada_node_standby_new(1);
    if (scada_redundancy_arbiter_a).node_id != (scada_redundancy_arbiter_b).node_id {
        println("FAIL scada_node_standby_new");
        process_exit(1);
    }
    println("prod_scada_redundancy_arbiter: PASSED");
}
