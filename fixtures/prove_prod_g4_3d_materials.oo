// # Product prove std/3d/materials.oo
//
// Logline: Fail-closed verification that 3D materials facade and color blending operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/materials.oo.
//
// Beats:
//   1. Verify color presets, material constructors, and color blending routines.
//   2. Call shim markers and assert deterministic Color and Material values.
//   3. Print prod_g4_3d_materials: PASSED and exit 0.

import "std/3d/materials.oo";

pub fn main() {
    let materials_mark: Int = 0;
    if materials_mark != 0 {
        process_exit(1);
    }

    let cw_a: Color = shim_marker_color_white();
    let cw_b: Color = shim_marker_color_white();
    if (cw_a).r != (cw_b).r || (cw_a).g != (cw_b).g || (cw_a).b != (cw_b).b || (cw_a).a != 255 {
        println("FAIL shim_marker_color_white");
        process_exit(1);
    }

    let cb: Color = shim_marker_color_black();
    if (cb).r != 0 || (cb).g != 0 || (cb).b != 0 || (cb).a != 255 {
        println("FAIL shim_marker_color_black");
        process_exit(1);
    }

    let c_blend: Color = shim_marker_color_blend();
    if (c_blend).a != 255 {
        println("FAIL shim_marker_color_blend");
        process_exit(1);
    }

    let m_def: Material = shim_marker_material_default();
    if (m_def).roughness != 128 || (m_def).metallic != 0 {
        println("FAIL shim_marker_material_default");
        process_exit(1);
    }

    let m_mir: Material = shim_marker_material_mirror();
    if (m_mir).roughness != 0 || (m_mir).metallic != 255 {
        println("FAIL shim_marker_material_mirror");
        process_exit(1);
    }

    let m_blend: Material = shim_marker_material_blend();
    if (m_blend).metallic != 0 {
        println("FAIL shim_marker_material_blend");
        process_exit(1);
    }

    let mark: Int = materials_marker();
    if mark != 1 {
        println("FAIL materials_marker");
        process_exit(1);
    }

    println("prod_g4_3d_materials: PASSED");
    process_exit(0);
}
