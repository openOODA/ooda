// # N-string const concat
//
// Logline: Print STRING plus STRING and a bound concat let.
//
// Setup: Side emit-aarch64 folds const string plus chains in main.
//
// Beats:
//   1. Print A plus B.
//   2. Bind x to C plus D.
//   3. Print x.

pub fn main() {
    println("A" + "B");
    let x = "C" + "D";
    println(x);
}
