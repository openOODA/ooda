// # Product prove std/zk_rollup/logup_lookup_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts logup_fraction_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/logup_lookup_argument.oo.
//
// Beats:
//   1. Call logup_fraction_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_logup_lookup_argument: PASSED only if they match.

import "std/zk_rollup/logup_lookup_argument.oo";

pub fn main() {
    let logup_lookup_argument_mark: Int = 0;
    if logup_lookup_argument_mark != 0 {
        process_exit(1);
    }
    let a: LogupFraction = logup_fraction_new(0, 0);
    let b: LogupFraction = logup_fraction_new(0, 0);
    if (a).numerator != (b).numerator {
        println("FAIL logup_fraction_new");
        process_exit(1);
    }
    println("prod_logup_lookup_argument: PASSED");
}
