// # emit-x86 const-int less-or-equal if
//
// Logline: If 1 is less than or equal to 1 print yes else no.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the true less-or-equal branch.
//   3. as+ld stdout is yes only.
//
// residual: SysV stays later.

pub fn main() {
    if 1 <= 1 {
        println("yes");
    } else {
        println("no");
    }
}
