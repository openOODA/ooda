// # Product prove std/diag/stopwatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts stopwatch_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/diag/stopwatch.oo.
//
// Beats:
//   1. Call stopwatch_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_stopwatch: PASSED only if it matches.

import "std/diag/stopwatch.oo";

pub fn main() {
    let a: Int = stopwatch_probe();
    if a != 0 {
        println("FAIL stopwatch_probe");
        process_exit(1);
    }
    println("prod_nc_stopwatch: PASSED");
}
