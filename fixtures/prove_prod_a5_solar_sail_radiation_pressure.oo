// # Product prove std/space_propulsion/solar_sail_radiation_pressure.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_sail_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_sail_radiation_pressure.oo.
//
// Beats:
//   1. Call solar_sail_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_sail_radiation_pressure: PASSED only if they match.

import "std/space_propulsion/solar_sail_radiation_pressure.oo";

pub fn main() {
    let solar_sail_radiation_pressure_mark: Int = 0;
    if solar_sail_radiation_pressure_mark != 0 {
        process_exit(1);
    }
    let a: SolarSailSpec = solar_sail_spec_default();
    let b: SolarSailSpec = solar_sail_spec_default();
    if (a).sail_area_m2 != (b).sail_area_m2 {
        println("FAIL solar_sail_spec_default");
        process_exit(1);
    }
    println("prod_solar_sail_radiation_pressure: PASSED");
}
