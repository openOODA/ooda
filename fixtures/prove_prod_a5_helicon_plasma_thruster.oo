// # Product prove std/space_propulsion/helicon_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts helicon_spec_default_argon is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/helicon_plasma_thruster.oo.
//
// Beats:
//   1. Call helicon_spec_default_argon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_helicon_plasma_thruster: PASSED only if they match.

import "std/space_propulsion/helicon_plasma_thruster.oo";

pub fn main() {
    let helicon_plasma_thruster_mark: Int = 0;
    if helicon_plasma_thruster_mark != 0 {
        process_exit(1);
    }
    let a: HeliconThrusterSpec = helicon_spec_default_argon();
    let b: HeliconThrusterSpec = helicon_spec_default_argon();
    if (a).rf_power_w != (b).rf_power_w {
        println("FAIL helicon_spec_default_argon");
        process_exit(1);
    }
    println("prod_helicon_plasma_thruster: PASSED");
}
