// # Product prove std/fintech_defi/hft_vpin_flow_toxicity.oo
//
// Logline: Fail-closed emit+gcc+run asserts vpin_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/hft_vpin_flow_toxicity.oo.
//
// Beats:
//   1. Call vpin_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hft_vpin_flow_toxicity: PASSED only if they match.

import "std/fintech_defi/hft_vpin_flow_toxicity.oo";

pub fn main() {
    let hft_vpin_flow_toxicity_mark: Int = 0;
    if hft_vpin_flow_toxicity_mark != 0 {
        process_exit(1);
    }
    let a: VpinConfig = vpin_config_new(0, 0, 0);
    let b: VpinConfig = vpin_config_new(0, 0, 0);
    if (a).bucket_volume_size != (b).bucket_volume_size {
        println("FAIL vpin_config_new");
        process_exit(1);
    }
    println("prod_hft_vpin_flow_toxicity: PASSED");
}
