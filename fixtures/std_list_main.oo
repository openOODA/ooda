// # std/core/list product
//
// Logline: Import list helpers and print first and last of a two-item list.
//
// Setup: Product std import. No FS or net.
//
// Beats:
//   1. Push 1 and 2.
//   2. Print first and last.

import "std/core/list.oo";

pub fn main() {
    let mut xs = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    match list_first(xs) {
        Ok(a) => println(a),
        Err(e) => println(e),
    }
    match list_last(xs) {
        Ok(b) => println(b),
        Err(e) => println(e),
    }
}
