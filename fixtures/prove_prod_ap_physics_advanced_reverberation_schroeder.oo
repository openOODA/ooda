// # Product prove std/physics_advanced/reverberation_schroeder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/reverberation_schroeder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/reverberation_schroeder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_reverberation_schroeder: PASSED only if they match.

import "std/physics_advanced/reverberation_schroeder.oo";

pub fn main() {
    let reverberation_schroeder_a = schroeder_int_to_float(0);
    let reverberation_schroeder_b = schroeder_int_to_float(0);
    if reverberation_schroeder_a != reverberation_schroeder_b {
        println("FAIL reverberation_schroeder");
        process_exit(1);
    }
    println("prod_ap_reverberation_schroeder: PASSED");
}
