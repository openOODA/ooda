// # Product prove std/satellite_dvb/gnss_galileo_e1_boc.oo
//
// Logline: Fail-closed emit+gcc+run asserts galileo_boc11_autocorrelation is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_galileo_e1_boc.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call galileo_boc11_autocorrelation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_gnss_galileo_e1_boc: PASSED only if they match.

import "std/satellite_dvb/gnss_galileo_e1_boc.oo";

pub fn main() {
    let g0_a = galileo_boc11_autocorrelation(1.0);
    let g0_b = galileo_boc11_autocorrelation(1.0);
    if g0_a != g0_b {
        println("FAIL galileo_boc11_autocorrelation");
        process_exit(1);
    }
    println("prod_g0_gnss_galileo_e1_boc: PASSED");
}
