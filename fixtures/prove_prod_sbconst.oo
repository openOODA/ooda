// # Product sec secure boot const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/secure_boot_const.oo.
//
// Setup: Product std/sec/sys/secure_boot_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. cert x509 1 sha512 5. action deny 2.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/secure_boot_const.oo";

pub fn main() {
    let a: Int = sboot_cert_x509();
    if a != 1 {
        println("FAIL sb x509");
        process_exit(1);
    }
    let b: Int = sboot_cert_sha512();
    if b != 5 {
        println("FAIL sb sha512");
        process_exit(1);
    }
    let c: Int = sboot_action_deny();
    if c != 2 {
        println("FAIL sb deny");
        process_exit(1);
    }
    println("prod_sbconst: PASSED");
}
