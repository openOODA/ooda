// # Product prove std/net_telemetry/tcp_segment.oo
//
// Logline: Fail-closed emit+gcc+run asserts tcp_flags_is_syn_only is a real value.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/tcp_segment.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tcp_flags_is_syn_only twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tcp_segment: PASSED only if they match.

import "std/net_telemetry/tcp_segment.oo";

pub fn main() {
    let g2_oa: TcpFlags = TcpFlags { fin: true, syn: true, rst: true, psh: true, ack: true, urg: true, ece: true, cwr: true };
    let g2_ob: TcpFlags = TcpFlags { fin: true, syn: true, rst: true, psh: true, ack: true, urg: true, ece: true, cwr: true };
    let g2_a = tcp_flags_is_syn_only(&g2_oa);
    let g2_b = tcp_flags_is_syn_only(&g2_ob);
    if g2_a != g2_b {
        println("FAIL tcp_flags_is_syn_only");
        process_exit(1);
    }
    println("prod_g2_tcp_segment: PASSED");
}
