// # Product prove std/db_vector_ann/vector_jaccard_similarity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/vector_jaccard_similarity.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_jaccard_similarity.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_vector_jaccard_similarity: PASSED only if they match.

import "std/db_vector_ann/vector_jaccard_similarity.oo";

pub fn main() {
    let vector_jaccard_similarity_a = jaccard_config_default();
    let vector_jaccard_similarity_b = jaccard_config_default();
    if vector_jaccard_similarity_a.scale_factor != vector_jaccard_similarity_b.scale_factor {
        println("FAIL vector_jaccard_similarity");
        process_exit(1);
    }
    println("prod_ap_vector_jaccard_similarity: PASSED");
}
