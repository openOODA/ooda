// # Product prove std/text/format.oo
//
// Logline: Fail-closed emit+gcc+run asserts format_pad_left value or determinism.
//
// Setup: Isolated emit-c. Imports std/text/format.oo.
//
// Beats:
//   1. Call format_pad_left twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_format: PASSED only if asserts hold.

import "std/text/format.oo";

pub fn main() {
    let format_a: String = format_pad_left("hi", 5, " ");
    let format_b: String = format_pad_left("hi", 5, " ");
    if chars_len(format_a) != 5 {
        println("FAIL format_pad_left len");
        process_exit(1);
    }
    if chars_len(format_a) != chars_len(format_b) {
        println("FAIL format_pad_left det");
        process_exit(1);
    }
    println("prod_format: PASSED");
}
