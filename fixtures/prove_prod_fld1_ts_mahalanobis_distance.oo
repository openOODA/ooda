// # Product prove std/industrial_predictive/ts_mahalanobis_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_mahalanobis_distance.oo.
//
// Beats:
//   1. Call math_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_mahalanobis_distance: PASSED only if they match.

import "std/industrial_predictive/ts_mahalanobis_distance.oo";

pub fn main() {
    let ts_mahalanobis_distance_mark: Int = 0;
    if ts_mahalanobis_distance_mark != 0 {
        process_exit(1);
    }
    let ts_mahalanobis_distance_a: Float = math_sqrt(1.0);
    let ts_mahalanobis_distance_b: Float = math_sqrt(1.0);
    if ts_mahalanobis_distance_a != ts_mahalanobis_distance_b {
        println("FAIL math_sqrt");
        process_exit(1);
    }
    println("prod_ts_mahalanobis_distance: PASSED");
}
