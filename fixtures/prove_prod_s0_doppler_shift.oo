// # Product prove std/telecom/doppler_shift.oo
//
// Logline: Fail-closed emit+gcc+run asserts doppler_pi value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom/doppler_shift.oo.
//
// Beats:
//   1. Call doppler_pi twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_doppler_shift: PASSED only if asserts hold.

import "std/telecom/doppler_shift.oo";

pub fn main() {
    let doppler_shift_a: Float = doppler_pi();
    let doppler_shift_b: Float = doppler_pi();
    if doppler_shift_a != doppler_shift_b {
        println("FAIL doppler_pi");
        process_exit(1);
    }
    println("prod_doppler_shift: PASSED");
}
