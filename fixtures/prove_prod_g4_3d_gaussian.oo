// # Product prove std/3d/gaussian.oo
//
// Logline: Fail-closed emit+gcc+run asserts 3D Gaussian splatting facade operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian.oo.
//
// Beats:
//   1. Call gaussian_marker, shim_marker_identity, and shim_marker_cloud_new.
//   2. Call shim_marker_fit_result and shim_marker_stubs.
//   3. Assert deterministic return values.
//   4. Print prod_g4_3d_gaussian: PASSED only if all match.

import "std/3d/gaussian.oo";

pub fn main() {
    let m: Int = gaussian_marker();
    if m != 1 {
        println("FAIL gaussian_marker");
        process_exit(1);
    }

    let id_a: Gaussian3D = shim_marker_identity();
    let id_b: Gaussian3D = shim_marker_identity();
    if (id_a).opacity != (id_b).opacity {
        println("FAIL shim_marker_identity");
        process_exit(1);
    }

    let c: GaussianCloud = shim_marker_cloud_new();
    let cnt: Int = shim_marker_cloud_count(c);
    if cnt != 0 {
        println("FAIL shim_marker_cloud_count");
        process_exit(1);
    }

    let stubs_res: Int = shim_marker_stubs();
    if stubs_res != 1 {
        println("FAIL shim_marker_stubs");
        process_exit(1);
    }

    let fit: GaussianFitResult = shim_marker_fit_result();
    if (fit).iterations != 0 {
        println("FAIL shim_marker_fit_result");
        process_exit(1);
    }

    println("prod_g4_3d_gaussian: PASSED");
    process_exit(0);
}
