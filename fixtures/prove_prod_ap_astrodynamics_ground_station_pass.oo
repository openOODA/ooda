// # Product prove std/astrodynamics/ground_station_pass.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/ground_station_pass.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/ground_station_pass.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ground_station_pass: PASSED only if they match.

import "std/astrodynamics/ground_station_pass.oo";

pub fn main() {
    let ground_station_pass_a = min_elev_deg();
    let ground_station_pass_b = min_elev_deg();
    if ground_station_pass_a != ground_station_pass_b {
        println("FAIL ground_station_pass");
        process_exit(1);
    }
    println("prod_ap_ground_station_pass: PASSED");
}
