// # Product prove std/db_storage/wal_group_commit.oo
//
// Logline: Fail-closed emit+gcc+run asserts group_commit_epoch_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_group_commit.oo.
//
// Beats:
//   1. Call group_commit_epoch_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_group_commit: PASSED only if they match.

import "std/db_storage/wal_group_commit.oo";

pub fn main() {
    let wal_group_commit_mark: Int = 0;
    if wal_group_commit_mark != 0 {
        process_exit(1);
    }
    let a: GroupCommitEpoch = group_commit_epoch_new(0);
    let b: GroupCommitEpoch = group_commit_epoch_new(0);
    if (a).epoch_id != (b).epoch_id {
        println("FAIL group_commit_epoch_new");
        process_exit(1);
    }
    println("prod_wal_group_commit: PASSED");
}
