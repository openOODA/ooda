// # Product prove std/wasm_gc/jit_instruction_encoder_arm64.oo
//
// Logline: Fail-closed emit+gcc+run asserts arm64_stream_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_instruction_encoder_arm64.oo.
//
// Beats:
//   1. Call arm64_stream_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_instruction_encoder_arm64: PASSED only if they match.

import "std/wasm_gc/jit_instruction_encoder_arm64.oo";

pub fn main() {
    let a: Arm64Stream = arm64_stream_new();
    let b: Arm64Stream = arm64_stream_new();
    if a.word_count != 0 {
        println("FAIL arm64_stream_new");
        process_exit(1);
    }
    if a.word_count != b.word_count {
        println("FAIL arm64_stream_new");
        process_exit(1);
    }
    println("prod_jit_instruction_encoder_arm64: PASSED");
}
