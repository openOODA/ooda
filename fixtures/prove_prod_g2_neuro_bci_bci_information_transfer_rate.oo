// # Product prove std/neuro_bci/bci_information_transfer_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts itr_log2 is a real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_information_transfer_rate.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call itr_log2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bci_information_transfer_rate: PASSED only if they match.

import "std/neuro_bci/bci_information_transfer_rate.oo";

pub fn main() {
    let g2_a = itr_log2(1.0);
    let g2_b = itr_log2(1.0);
    if g2_a != g2_b {
        println("FAIL itr_log2");
        process_exit(1);
    }
    println("prod_g2_bci_information_transfer_rate: PASSED");
}
