// # Product prove std/os/process.oo
//
// Logline: Fail-closed emit+gcc+run asserts process_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/process.oo.
//
// Beats:
//   1. Call process_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_process: PASSED only if they match.

import "std/os/process.oo";

pub fn main() {
    let a = process_probe();
    let b = process_probe();
    if a != b {
        println("FAIL process_probe");
        process_exit(1);
    }
    println("prod_process: PASSED");
}
