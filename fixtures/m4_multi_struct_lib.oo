// # Milestone 4 multi-module struct library
//
// Logline: Provide struct Point and functions for method call lowering tests.
//
// Setup: Imported by m4_multi_struct_main.oo.
//
// Beats:
//   1. Define Point struct with x and y coordinates.
//   2. Define value receiver functions scale and dist_sq.
//   3. Define reference receiver function shift_x.
//   4. Define Result-returning constructor make_point.

type Point = struct {
    x: Int,
    y: Int
};

pub fn scale(p: Point, factor: Int) -> Point {
    return Point { x: p.x * factor, y: p.y * factor };
}

pub fn dist_sq(p: Point) -> Int {
    return p.x * p.x + p.y * p.y;
}

pub fn shift_x(p: &Point, dx: Int) -> Point {
    return Point { x: p.x + dx, y: p.y };
}

pub fn make_point(x: Int, y: Int) -> Result[Point, String] {
    if x < 0 {
        return Err("negative x");
    }
    return Ok(Point { x: x, y: y });
}

pub fn try_invert(p: Point) -> Result[Point, String] {
    if p.x == 0 && p.y == 0 {
        return Err("zero point cannot be inverted");
    }
    return Ok(Point { x: 0 - p.x, y: 0 - p.y });
}

pub fn try_scale(p: &Point, factor: Int) -> Result[Point, String] {
    if factor == 0 {
        return Err("zero scale factor");
    }
    return Ok(Point { x: p.x * factor, y: p.y * factor });
}

pub fn add_points(a: Point, b: Point) -> Point {
    return Point { x: a.x + b.x, y: a.y + b.y };
}

