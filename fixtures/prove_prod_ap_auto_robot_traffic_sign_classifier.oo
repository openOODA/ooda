// # Product prove std/auto_robot/traffic_sign_classifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/traffic_sign_classifier.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/traffic_sign_classifier.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_traffic_sign_classifier: PASSED only if they match.

import "std/auto_robot/traffic_sign_classifier.oo";

pub fn main() {
    let traffic_sign_classifier_a = traffic_sign_state_default();
    let traffic_sign_classifier_b = traffic_sign_state_default();
    let traffic_sign_classifier_va = traffic_sign_requires_stop(traffic_sign_classifier_a);
    let traffic_sign_classifier_vb = traffic_sign_requires_stop(traffic_sign_classifier_b);
    if traffic_sign_classifier_va != traffic_sign_classifier_vb {
        println("FAIL traffic_sign_classifier");
        process_exit(1);
    }
    println("prod_ap_traffic_sign_classifier: PASSED");
}
