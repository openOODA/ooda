// # Product prove std/sync/ring_channel.oo
//
// Logline: Fail-closed emit+gcc+run asserts ring_channel_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/ring_channel.oo.
//
// Beats:
//   1. Call ring_channel_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ring_channel: PASSED only if they match.

import "std/sync/ring_channel.oo";

pub fn main() {
    let obj = ring_channel_new(0);
    let a = obj.capacity;
    let b = obj.capacity;
    if a != b {
        println("FAIL ring_channel_new");
        process_exit(1);
    }
    println("prod_ring_channel: PASSED");
}
