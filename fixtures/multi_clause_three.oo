// # Pass three simple contract clauses
//
// Logline: Three simple requires and three simple ensures all hold on a sum.
//
// Beats:
//   1. Require a, b, and c non-negative.
//   2. Ensure the result is non-negative and at least a and b.
//   3. Sum 1, 2, and 3 so every clause holds.

// M67 three simple requires + ensures AND
pub fn clamp(a: Int, b: Int, c: Int) -> Int
    requires a >= 0
    requires b >= 0
    requires c >= 0
    ensures result >= 0
    ensures result >= a
    ensures result >= b
{
    return a + b + c;
}
pub fn main() {
    println(clamp(1, 2, 3));
}
