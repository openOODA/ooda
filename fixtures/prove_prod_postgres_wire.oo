// # Product prove std/database/postgres_wire.oo
//
// Logline: Fail-closed emit+gcc+run asserts pg_session_create real value.
//
// Setup: Isolated emit-c. Imports std/database/postgres_wire.oo.
//
// Beats:
//   1. Call pg_session_create with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_postgres_wire: PASSED only if the assert holds.

import "std/database/postgres_wire.oo";

pub fn main() {
    let postgres_wire_mark: Int = 0;
    if postgres_wire_mark != 0 {
        process_exit(1);
    }
    let postgres_wire_a: PgSession = pg_session_create(7);
    let postgres_wire_session_id: Int = (postgres_wire_a).session_id;
    if postgres_wire_session_id != 7 {
        println("FAIL pg_session_create");
        process_exit(1);
    }
    println("prod_postgres_wire: PASSED");
}
