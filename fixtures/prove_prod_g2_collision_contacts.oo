// # Product prove std/physics/collision_contacts.oo
//
// Logline: Fail-closed emit+gcc+run asserts collision_contacts_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/collision_contacts.oo.
//
// Beats:
//   1. Call collision_contacts_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_collision_contacts: PASSED only if they match.

import "std/physics/collision_contacts.oo";

pub fn main() {
    let a: Int = collision_contacts_probe();
    let b: Int = collision_contacts_probe();
    if a != b {
        println("FAIL collision_contacts_probe");
        process_exit(1);
    }
    println("prod_g2_collision_contacts: PASSED");
}
