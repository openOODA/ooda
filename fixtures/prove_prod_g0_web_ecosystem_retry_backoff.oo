// # Product prove std/web_ecosystem/retry_backoff.oo
//
// Logline: Fail-closed emit+gcc+run asserts retry_should_retry is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/retry_backoff.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call retry_should_retry twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_retry_backoff: PASSED only if they match.

import "std/web_ecosystem/retry_backoff.oo";

pub fn main() {
    let g0_oa = retry_strategy_default();
    let g0_ob = retry_strategy_default();
    let g0_a = retry_should_retry(g0_oa, 2);
    let g0_b = retry_should_retry(g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL retry_should_retry");
        process_exit(1);
    }
    println("prod_g0_retry_backoff: PASSED");
}
