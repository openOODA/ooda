// # Product prove std/astrophysics_relativity/stellar_atmosphere_grey.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/stellar_atmosphere_grey.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_atmosphere_grey.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stellar_atmosphere_grey: PASSED only if they match.

import "std/astrophysics_relativity/stellar_atmosphere_grey.oo";

pub fn main() {
    let stellar_atmosphere_grey_a = grey_atmosphere_temperature(0.0, 0.0);
    let stellar_atmosphere_grey_b = grey_atmosphere_temperature(0.0, 0.0);
    if stellar_atmosphere_grey_a != stellar_atmosphere_grey_b {
        println("FAIL stellar_atmosphere_grey");
        process_exit(1);
    }
    println("prod_ap_stellar_atmosphere_grey: PASSED");
}
