// # Product prove std/protein_folding/folding_monte_carlo_metropolis.oo
//
// Logline: Fail-closed emit+gcc+run asserts mc_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_monte_carlo_metropolis.oo.
//
// Beats:
//   1. Call mc_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_folding_monte_carlo_metropolis: PASSED only if they match.

import "std/protein_folding/folding_monte_carlo_metropolis.oo";

pub fn main() {
    let a: McParams = mc_params_default(0.0);
    let b: McParams = mc_params_default(0.0);
    if a.temperature_k != b.temperature_k {
        println("FAIL mc_params_default");
        process_exit(1);
    }
    println("prod_folding_monte_carlo_metropolis: PASSED");
}
