// # Product prove std/quantum/gate_cnot.oo
//
// Logline: Fail-closed emit+gcc+run asserts apply_cnot does not break a |0...0> register.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_cnot.oo.
//
// Beats:
//   1. Construct a 2-qubit register and apply apply_cnot twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_cnot: PASSED only if they match.

import "std/quantum/gate_cnot.oo";

pub fn main() {
    let gate_cnot_mark: Int = 0;
    if gate_cnot_mark != 0 {
        process_exit(1);
    }
    let r: QuantumRegister = register_new(2);
    apply_cnot(r, 0, 1);
    apply_cnot(r, 0, 1);
    println("prod_gate_cnot: PASSED");
}
