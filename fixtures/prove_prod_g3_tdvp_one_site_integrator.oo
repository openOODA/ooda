// # Product prove std/quantum_tensor_nets/tdvp_one_site_integrator.oo
//
// Logline: Fail-closed emit+gcc+run asserts tdvp_one_site_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tdvp_one_site_integrator.oo.
//
// Beats:
//   1. Call tdvp_one_site_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tdvp_one_site_integrator: PASSED only if they match.

import "std/quantum_tensor_nets/tdvp_one_site_integrator.oo";

pub fn main() {
    let tdvp_one_site_integrator_mark: Int = 0;
    if tdvp_one_site_integrator_mark != 0 {
        process_exit(1);
    }
    let a: TdvpOneSiteConfig = tdvp_one_site_config_default(0, 0.0, 0.0);
    let b: TdvpOneSiteConfig = tdvp_one_site_config_default(0, 0.0, 0.0);
    if (a).num_sites != (b).num_sites {
        println("FAIL tdvp_one_site_config_default");
        process_exit(1);
    }
    println("prod_tdvp_one_site_integrator: PASSED");
}
