// # Product prove std/db_vector_ann/vector_matryoshka_slicing.oo
//
// Logline: Fail-closed emit+gcc+run asserts matryoshka_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_matryoshka_slicing.oo.
//
// Beats:
//   1. Call matryoshka_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_matryoshka_slicing: PASSED only if they match.

import "std/db_vector_ann/vector_matryoshka_slicing.oo";

pub fn main() {
    let vector_matryoshka_slicing_mark: Int = 0;
    if vector_matryoshka_slicing_mark != 0 {
        process_exit(1);
    }
    let a: MatryoshkaConfig = matryoshka_config_default(0, 0);
    let b: MatryoshkaConfig = matryoshka_config_default(0, 0);
    if (a).short_dimension != (b).short_dimension {
        println("FAIL matryoshka_config_default");
        process_exit(1);
    }
    println("prod_vector_matryoshka_slicing: PASSED");
}
