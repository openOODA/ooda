// # Product prove std/wasm_gc/wasm_component_flatten_abi.oo
//
// Logline: Fail-closed emit+gcc+run asserts should_pass_by_memory is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_flatten_abi.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call should_pass_by_memory twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wasm_component_flatten_abi: PASSED only if they match.

import "std/wasm_gc/wasm_component_flatten_abi.oo";

pub fn main() {
    let g2_a = should_pass_by_memory(8);
    let g2_b = should_pass_by_memory(8);
    if g2_a != g2_b {
        println("FAIL should_pass_by_memory");
        process_exit(1);
    }
    println("prod_g2_wasm_component_flatten_abi: PASSED");
}
