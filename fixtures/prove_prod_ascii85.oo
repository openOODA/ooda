// # Product prove std/encoding/ascii85.oo
//
// Logline: Fail-closed emit+gcc+run asserts ascii85_encode value or determinism.
//
// Setup: Isolated emit-c. Imports std/encoding/ascii85.oo.
//
// Beats:
//   1. Call ascii85_encode twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ascii85: PASSED only if asserts hold.

import "std/encoding/ascii85.oo";

pub fn main() {
    let ascii85: String = ascii85_encode("Man ");
    let ascii85_b: String = ascii85_encode("Man ");
    if chars_len(ascii85) != 5 {
        println("FAIL ascii85_encode len");
        process_exit(1);
    }
    if chars_len(ascii85) != chars_len(ascii85_b) {
        println("FAIL ascii85_encode det");
        process_exit(1);
    }
    println("prod_ascii85: PASSED");
}
