// # Product Ascii85 encode/decode
//
// Logline: Adobe PLRM Ascii85 of Man[space] is 9jqo^; decode returns Man[space].
//
// Setup: Product std/encoding/ascii85.oo. Destub none. No caps.
//
// Beats:
//   1. ascii85_encode("Man ") equals 9jqo^ (Adobe PostScript Language Reference).
//   2. ascii85_decode of that is Ok("Man "); framed <~9jqo^~> also decodes.
//   3. Miss process_exit(1) before PASSED.

import "std/encoding/ascii85.oo";

pub fn main() {
    let enc: String = ascii85_encode("Man ");
    if enc != "9jqo^" {
        println("FAIL ascii85_encode");
        process_exit(1);
    }
    let enc8: String = ascii85_encode("Man is d");
    if enc8 != "9jqo^BlbD-" {
        println("FAIL ascii85_encode 8");
        process_exit(1);
    }
    let dec_r: Result[String, String] = ascii85_decode("9jqo^");
    if dec_r.is_err() {
        println("FAIL ascii85_decode err");
        process_exit(1);
    }
    let dec: String = dec_r.unwrap();
    if dec != "Man " {
        println("FAIL ascii85_decode");
        process_exit(1);
    }
    let fr_r: Result[String, String] = ascii85_decode("<~9jqo^~>");
    if fr_r.is_err() {
        println("FAIL ascii85_decode framed err");
        process_exit(1);
    }
    let fr: String = fr_r.unwrap();
    if fr != "Man " {
        println("FAIL ascii85_decode framed");
        process_exit(1);
    }
    println("prod_ascii85: PASSED");
}
