// # IDENT range-for emit lock
//
// Logline: Fail-closed emit+gcc+run of for i in 0..n with IDENT high bound.
//
// Setup: Backend-C. High bound is the ident n, not an INT token.
//
// Beats:
//   1. Bind n = 3.
//   2. Sum i in 0..n.
//   3. Exit 1 before PASSED when the sum is not 3.

pub fn main() {
    let n: Int = 3;
    let mut s: Int = 0;
    for i in 0..n {
        s = s + i;
    }
    if s != 3 {
        println("FAIL");
        process_exit(1);
    }
    println("for_ident_range_smoke: PASSED");
}
