// # Product prove std/hft_alpha/mm_kyle_lambda_impact.oo
//
// Logline: Fail-closed emit+gcc+run asserts kyle_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_kyle_lambda_impact.oo.
//
// Beats:
//   1. Call kyle_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_kyle_lambda_impact: PASSED only if they match.

import "std/hft_alpha/mm_kyle_lambda_impact.oo";

pub fn main() {
    let mm_kyle_lambda_impact_mark: Int = 0;
    if mm_kyle_lambda_impact_mark != 0 {
        process_exit(1);
    }
    let a: KyleParams = kyle_params_new(0.0, 0.0, 0.0);
    let b: KyleParams = kyle_params_new(0.0, 0.0, 0.0);
    if (a).fundamental_variance_v != (b).fundamental_variance_v {
        println("FAIL kyle_params_new");
        process_exit(1);
    }
    println("prod_g2_mm_kyle_lambda_impact: PASSED");
}
