// # Product prove std/fintech_defi/collateral_vault.oo
//
// Logline: Fail-closed emit+gcc+run asserts collateral_type_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/collateral_vault.oo.
//
// Beats:
//   1. Call collateral_type_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_collateral_vault: PASSED only if they match.

import "std/fintech_defi/collateral_vault.oo";

pub fn main() {
    let a: CollateralType = collateral_type_new("x", 0, 0, 0);
    let b: CollateralType = collateral_type_new("x", 0, 0, 0);
    if a.total_deposited != b.total_deposited {
        println("FAIL collateral_type_new");
        process_exit(1);
    }
    println("prod_collateral_vault: PASSED");
}
