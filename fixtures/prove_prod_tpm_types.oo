// # Product prove std/sec/crypto/tpm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts tpm_nv_id is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tpm_types.oo.
//
// Beats:
//   1. Call tpm_nv_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tpm_types: PASSED only if they match.

import "std/sec/crypto/tpm_types.oo";

pub fn main() {
    let obj = tpm_nv_new(0, 0, 0);
    let a = tpm_nv_id(obj);
    let b = tpm_nv_id(obj);
    if a != b {
        println("FAIL tpm_nv_id");
        process_exit(1);
    }
    println("prod_tpm_types: PASSED");
}
