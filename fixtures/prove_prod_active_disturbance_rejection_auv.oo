// # Product prove std/robotics_auv/active_disturbance_rejection_auv.oo
//
// Logline: Fail-closed emit+gcc+run asserts adrc_config_default_surge is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/active_disturbance_rejection_auv.oo.
//
// Beats:
//   1. Call adrc_config_default_surge twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_active_disturbance_rejection_auv: PASSED only if they match.

import "std/robotics_auv/active_disturbance_rejection_auv.oo";

pub fn main() {
    let active_disturbance_rejection_auv_mark: Int = 0;
    if active_disturbance_rejection_auv_mark != 0 {
        process_exit(1);
    }
    let a: AdrcConfig = adrc_config_default_surge();
    let b: AdrcConfig = adrc_config_default_surge();
    if (a).field0 != (b).field0 {
        println("FAIL adrc_config_default_surge");
        process_exit(1);
    }
    println("prod_active_disturbance_rejection_auv: PASSED");
}
