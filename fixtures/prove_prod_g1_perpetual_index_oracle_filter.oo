// # Product prove std/defi_derivatives/perpetual_index_oracle_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts index_filter_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/perpetual_index_oracle_filter.oo.
//
// Beats:
//   1. Call index_filter_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_perpetual_index_oracle_filter: PASSED only if they match.

import "std/defi_derivatives/perpetual_index_oracle_filter.oo";

pub fn main() {
    let a: IndexFilterConfig = index_filter_config_default();
    let b: IndexFilterConfig = index_filter_config_default();
    if a.max_staleness_sec != b.max_staleness_sec {
        println("FAIL index_filter_config_default");
        process_exit(1);
    }
    println("prod_perpetual_index_oracle_filter: PASSED");
}
