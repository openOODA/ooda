// # Product simple diff prove
//
// Logline: Fail-closed emit+gcc+run of shipped diff_simple_compare_two/has_diff.
//
// Setup: Product std/text/diff_simple.oo. Two-line compare.
//
// Beats:
//   1. Equal lines have no differences.
//   2. Unequal lines have one difference.
//   3. Exit 1 before PASSED on a miss.

import "std/text/diff_simple.oo";

pub fn main() {
    let eq: SimpleDiff = diff_simple_compare_two("hello", "hello");
    let hd: Bool = eq.has_differences;
    if hd == true {
        println("FAIL diffsimple equal");
        process_exit(1);
    }
    let ne: SimpleDiff = diff_simple_compare_two("hello", "world");
    let hd2: Bool = ne.has_differences;
    if hd2 == false {
        println("FAIL diffsimple differ");
        process_exit(1);
    }
    let dc: Int = ne.diff_count;
    if dc != 1 {
        println("FAIL diffsimple count");
        process_exit(1);
    }
    println("prod_diffsimple: PASSED");
}
