// # Product prove std/auto_robot/lin_bus_master.oo
//
// Logline: Fail-closed emit+gcc+run asserts lin_compute_pid is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/lin_bus_master.oo.
//
// Beats:
//   1. Call lin_compute_pid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lin_bus_master: PASSED only if they match.

import "std/auto_robot/lin_bus_master.oo";

pub fn main() {
    let lin_bus_master_mark: Int = 0;
    if lin_bus_master_mark != 0 {
        process_exit(1);
    }
    let a: Int = lin_compute_pid(0);
    let b: Int = lin_compute_pid(0);
    if a != b {
        println("FAIL lin_compute_pid");
        process_exit(1);
    }
    println("prod_lin_bus_master: PASSED");
}
