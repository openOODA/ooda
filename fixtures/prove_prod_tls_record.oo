// # Product prove std/net/tls_record.oo
//
// Logline: Fail-closed emit+gcc+run asserts tls_record_content_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/tls_record.oo.
//
// Beats:
//   1. Call tls_record_content_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tls_record: PASSED only if they match.

import "std/net/tls_record.oo";

pub fn main() {
    let a = tls_record_content_name(0);
    let b = tls_record_content_name(0);
    if a != b {
        println("FAIL tls_record_content_name");
        process_exit(1);
    }
    println("prod_tls_record: PASSED");
}
