// # Product prove std/db_columnar/parquet_delta_encoding.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_delta_encoding.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_delta_encoding.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_parquet_delta_encoding: PASSED only if they match.

import "std/db_columnar/parquet_delta_encoding.oo";

pub fn main() {
    let parquet_delta_encoding_a = delta_decode_zigzag(0);
    let parquet_delta_encoding_b = delta_decode_zigzag(0);
    if parquet_delta_encoding_a != parquet_delta_encoding_b {
        println("FAIL parquet_delta_encoding");
        process_exit(1);
    }
    println("prod_ap_parquet_delta_encoding: PASSED");
}
