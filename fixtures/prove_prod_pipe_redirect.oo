// # Product prove std/os/pipe_redirect.oo
//
// Logline: Fail-closed emit+gcc+run asserts redirect_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/pipe_redirect.oo.
//
// Beats:
//   1. Call redirect_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pipe_redirect: PASSED only if they match.

import "std/os/pipe_redirect.oo";

pub fn main() {
    let obj = redirect_config_default();
    let a = obj.stdin_mode;
    let b = obj.stdin_mode;
    if a != b {
        println("FAIL redirect_config_default");
        process_exit(1);
    }
    println("prod_pipe_redirect: PASSED");
}
