// # Product prove std/os/temp_dir.oo
//
// Logline: Fail-closed emit+gcc+run asserts temp_dir_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/os/temp_dir.oo.
//
// Beats:
//   1. Call temp_dir_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_temp_dir: PASSED only if it matches.

import "std/os/temp_dir.oo";

pub fn main() {
    let a: Int = temp_dir_probe();
    if a != 0 {
        println("FAIL temp_dir_probe");
        process_exit(1);
    }
    println("prod_nc_temp_dir: PASSED");
}
