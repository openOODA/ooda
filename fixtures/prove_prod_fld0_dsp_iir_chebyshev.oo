// # Product prove std/telecom_5g/dsp_iir_chebyshev.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_chebyshev_epsilon is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/dsp_iir_chebyshev.oo.
//
// Beats:
//   1. Call dsp_chebyshev_epsilon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_iir_chebyshev: PASSED only if they match.

import "std/telecom_5g/dsp_iir_chebyshev.oo";

pub fn main() {
    let dsp_iir_chebyshev_mark: Int = 0;
    if dsp_iir_chebyshev_mark != 0 {
        process_exit(1);
    }
    let dsp_iir_chebyshev_a: Float = dsp_chebyshev_epsilon(1.0);
    let dsp_iir_chebyshev_b: Float = dsp_chebyshev_epsilon(1.0);
    if dsp_iir_chebyshev_a != dsp_iir_chebyshev_b {
        println("FAIL dsp_chebyshev_epsilon");
        process_exit(1);
    }
    println("prod_dsp_iir_chebyshev: PASSED");
}
