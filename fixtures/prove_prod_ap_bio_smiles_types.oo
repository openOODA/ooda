// # Product prove std/bio/smiles_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio/smiles_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_smiles_types: PASSED only if they match.

import "std/bio/smiles_types.oo";

pub fn main() {
    let smiles_types_a = smiles_atom_new(0, 0, 0);
    let smiles_types_b = smiles_atom_new(0, 0, 0);
    let smiles_types_va = smiles_atom_z(smiles_types_a);
    let smiles_types_vb = smiles_atom_z(smiles_types_b);
    if smiles_types_va != smiles_types_vb {
        println("FAIL smiles_types");
        process_exit(1);
    }
    println("prod_ap_smiles_types: PASSED");
}
