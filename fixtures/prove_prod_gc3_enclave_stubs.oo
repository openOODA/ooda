// # Product prove std/sec/sys/enclave_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts enclave_stubs_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/enclave_stubs.oo.
//
// Beats:
//   1. Call enclave_stubs_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_enclave_stubs: PASSED only if they match.

import "std/sec/sys/enclave_stubs.oo";

pub fn main() {
    let enclave_stubs_mark: Int = 0;
    if enclave_stubs_mark != 0 {
        process_exit(1);
    }
    let enclave_stubs_a = enclave_stubs_init(1, 1);
    let enclave_stubs_b = enclave_stubs_init(1, 1);
    if (enclave_stubs_a).vendor != (enclave_stubs_b).vendor {
        println("FAIL enclave_stubs_init");
        process_exit(1);
    }
    println("prod_enclave_stubs: PASSED");
}
