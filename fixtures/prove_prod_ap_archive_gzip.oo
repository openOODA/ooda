// # Product prove std/archive/gzip.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/archive/gzip.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/archive/gzip.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gzip: PASSED only if they match.

import "std/archive/gzip.oo";

pub fn main() {
    let gzip_a = gzip_detect("x");
    let gzip_b = gzip_detect("x");
    if gzip_a.is_ok() != gzip_b.is_ok() {
        println("FAIL gzip");
        process_exit(1);
    }
    println("prod_ap_gzip: PASSED");
}
