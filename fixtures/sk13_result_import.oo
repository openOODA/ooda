// # Allow-listed std/result import with only Ok(1)
//
// Logline: import std/result.oo plus used Ok(1) must stay check OK.
//
// Setup: Isolated check. Ok is prelude; r is used so unused-let cannot fire.
//
// Beats:
//   1. Import allow-listed std/result.oo.
//   2. Bind r to Ok(1) and print is_ok.
//   3. check must print OK.

import "std/result.oo";

pub fn main() {
    let r = Ok(1);
    println(r.is_ok());
}
