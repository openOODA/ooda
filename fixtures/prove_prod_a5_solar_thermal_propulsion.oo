// # Product prove std/space_propulsion/solar_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_thermal_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/solar_thermal_propulsion.oo.
//
// Beats:
//   1. Call solar_thermal_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_thermal_propulsion: PASSED only if they match.

import "std/space_propulsion/solar_thermal_propulsion.oo";

pub fn main() {
    let solar_thermal_propulsion_mark: Int = 0;
    if solar_thermal_propulsion_mark != 0 {
        process_exit(1);
    }
    let a: SolarThermalSpec = solar_thermal_spec_default();
    let b: SolarThermalSpec = solar_thermal_spec_default();
    if (a).concentrator_area_m2 != (b).concentrator_area_m2 {
        println("FAIL solar_thermal_spec_default");
        process_exit(1);
    }
    println("prod_solar_thermal_propulsion: PASSED");
}
