// # Product prove std/uav_flight/uav_hexacopter_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/uav_flight/uav_hexacopter_dynamics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_hexacopter_dynamics.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_uav_hexacopter: PASSED and exit 0 only on match.

import "std/uav_flight/uav_hexacopter_dynamics.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_uav_flight_uav_hexacopter_dynamics_oo();
    let dummy_b: Int = __dummy_std_src_ooda_uav_flight_uav_hexacopter_dynamics_oo();
    if dummy_a != dummy_b {
        println("FAIL uav_hexacopter dummy");
        process_exit(1);
    }

    let params_a: HexacopterParams = hexacopter_params_default();
    let params_b: HexacopterParams = hexacopter_params_default();
    let mass_a: Float = params_a.mass;
    let mass_b: Float = params_b.mass;
    if mass_a != mass_b {
        println("FAIL hexacopter_params_default mass");
        process_exit(1);
    }

    let cmd_a: HexacopterThrustTorque = hexacopter_thrust_torque_new(10.0, 0.0, 0.0, 0.0);
    let cmd_b: HexacopterThrustTorque = hexacopter_thrust_torque_new(10.0, 0.0, 0.0, 0.0);

    let motors_a: HexacopterMotorOutputs = hexacopter_allocate_motors(params_a, cmd_a);
    let motors_b: HexacopterMotorOutputs = hexacopter_allocate_motors(params_b, cmd_b);
    let m1_a: Float = motors_a.m1;
    let m1_b: Float = motors_b.m1;
    if m1_a != m1_b {
        println("FAIL hexacopter_allocate_motors m1");
        process_exit(1);
    }

    println("prod_g4_uav_hexacopter: PASSED");
    process_exit(0);
}
