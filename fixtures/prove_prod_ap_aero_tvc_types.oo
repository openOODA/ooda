// # Product prove std/aero/tvc_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/tvc_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tvc_types: PASSED only if they match.

import "std/aero/tvc_types.oo";

pub fn main() {
    let tvc_types_a = tvc_abs_milli(0);
    let tvc_types_b = tvc_abs_milli(0);
    if tvc_types_a != tvc_types_b {
        println("FAIL tvc_types");
        process_exit(1);
    }
    println("prod_ap_tvc_types: PASSED");
}
