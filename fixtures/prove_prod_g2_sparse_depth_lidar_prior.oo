// # Product prove std/nerf_3dgs/sparse_depth_lidar_prior.oo
//
// Logline: Fail-closed emit+gcc+run asserts depth_huber_loss is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/sparse_depth_lidar_prior.oo.
//
// Beats:
//   1. Call depth_huber_loss twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sparse_depth_lidar_prior: PASSED only if they match.

import "std/nerf_3dgs/sparse_depth_lidar_prior.oo";

pub fn main() {
    let sparse_depth_lidar_prior_mark: Int = 0;
    if sparse_depth_lidar_prior_mark != 0 {
        process_exit(1);
    }
    let a: Float = depth_huber_loss(0.0, 0.0, 0.0);
    let b: Float = depth_huber_loss(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL depth_huber_loss");
        process_exit(1);
    }
    println("prod_g2_sparse_depth_lidar_prior: PASSED");
}
