// # Product prove std/security_defense/aslr_entropy_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts aslr_compute_variance_bits is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/aslr_entropy_verifier.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call aslr_compute_variance_bits twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_aslr_entropy_verifier: PASSED only if they match.

import "std/security_defense/aslr_entropy_verifier.oo";

pub fn main() {
    let g0_a = aslr_compute_variance_bits(list_new(), 0);
    let g0_b = aslr_compute_variance_bits(list_new(), 0);
    if g0_a != g0_b {
        println("FAIL aslr_compute_variance_bits");
        process_exit(1);
    }
    println("prod_gr_aslr_entropy_verifier: PASSED");
}
