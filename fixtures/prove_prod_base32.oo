// # Product Base32 encode/decode
//
// Logline: RFC 4648 Base32 of foo is MZXW6===; decode returns foo.
//
// Setup: Product std/encoding/base32.oo. Destub none. No caps.
//
// Beats:
//   1. base32_encode("foo") equals MZXW6===.
//   2. base32_decode of that is Ok("foo"); Err is fail-closed.
//   3. Miss process_exit(1) before PASSED.
// Destub: RFC 4648 pad lengths and full 5-byte decode groups.

import "std/encoding/base32.oo";

pub fn main() {
    let empty: String = base32_encode("");
    if empty != "" {
        println("FAIL base32_encode empty");
        process_exit(1);
    }
    let enc: String = base32_encode("foo");
    if enc != "MZXW6===" {
        println("FAIL base32_encode");
        process_exit(1);
    }
    let dec_r: Result[String, String] = base32_decode("MZXW6===");
    if dec_r.is_err() {
        println("FAIL base32_decode err");
        process_exit(1);
    }
    let dec: String = dec_r.unwrap();
    if dec != "foo" {
        println("FAIL base32_decode");
        process_exit(1);
    }
    println("prod_base32: PASSED");
}
