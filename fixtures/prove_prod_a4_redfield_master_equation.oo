// # Product prove std/quantum_open_systems/redfield_master_equation.oo
//
// Logline: Fail-closed emit+gcc+run asserts redfield_rates_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/redfield_master_equation.oo.
//
// Beats:
//   1. Call redfield_rates_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_redfield_master_equation: PASSED only if they match.

import "std/quantum_open_systems/redfield_master_equation.oo";

pub fn main() {
    let redfield_master_equation_mark: Int = 0;
    if redfield_master_equation_mark != 0 {
        process_exit(1);
    }
    let a: RedfieldRates2x2 = redfield_rates_new(0.0, 0.0, 0.0, 0.0);
    let b: RedfieldRates2x2 = redfield_rates_new(0.0, 0.0, 0.0, 0.0);
    if (a).rate_0_to_1 != (b).rate_0_to_1 {
        println("FAIL redfield_rates_new");
        process_exit(1);
    }
    println("prod_redfield_master_equation: PASSED");
}
