// # Product prove std/compilers/disasm_x86.oo
//
// Logline: Fail-closed emit+gcc+run asserts x86_reg_id is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/disasm_x86.oo.
//
// Beats:
//   1. Call x86_reg_id twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_disasm_x86: PASSED only if they match.

import "std/compilers/disasm_x86.oo";

pub fn main() {
    let disasm_x86_mark: Int = 0;
    if disasm_x86_mark != 0 {
        process_exit(1);
    }
    let a: Int = x86_reg_id(0);
    let b: Int = x86_reg_id(0);
    if a != b {
        println("FAIL x86_reg_id");
        process_exit(1);
    }
    println("prod_disasm_x86: PASSED");
}
