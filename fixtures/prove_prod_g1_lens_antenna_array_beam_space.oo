// # Product prove std/telecom_6g/lens_antenna_array_beam_space.oo
//
// Logline: Fail-closed emit+gcc+run asserts lens_antenna_config_rotman_d_band is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/lens_antenna_array_beam_space.oo.
//
// Beats:
//   1. Call lens_antenna_config_rotman_d_band twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lens_antenna_array_beam_space: PASSED only if they match.

import "std/telecom_6g/lens_antenna_array_beam_space.oo";

pub fn main() {
    let a: LensAntennaConfig = lens_antenna_config_rotman_d_band();
    let b: LensAntennaConfig = lens_antenna_config_rotman_d_band();
    if a.feed_antenna_elements != b.feed_antenna_elements {
        println("FAIL lens_antenna_config_rotman_d_band");
        process_exit(1);
    }
    println("prod_lens_antenna_array_beam_space: PASSED");
}
