// # Product prove std/gis_topo/lidar_las_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts las_raw_to_world_x is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/lidar_las_header_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call las_raw_to_world_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_lidar_las_header_parser: PASSED only if they match.

import "std/gis_topo/lidar_las_header_parser.oo";

pub fn main() {
    let g0_oa: LasHeader = LasHeader { version_major: 2, version_minor: 2, point_format: 2, num_points: 2, scale_x: 1.0, scale_y: 1.0, scale_z: 1.0, offset_x: 1.0, offset_y: 1.0, offset_z: 1.0, min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g0_ob: LasHeader = LasHeader { version_major: 2, version_minor: 2, point_format: 2, num_points: 2, scale_x: 1.0, scale_y: 1.0, scale_z: 1.0, offset_x: 1.0, offset_y: 1.0, offset_z: 1.0, min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g0_a = las_raw_to_world_x(&g0_oa, 2);
    let g0_b = las_raw_to_world_x(&g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL las_raw_to_world_x");
        process_exit(1);
    }
    println("prod_g0_lidar_las_header_parser: PASSED");
}
