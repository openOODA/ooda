// # Product prove std/astrodynamics/attitude_reaction_wheels.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/attitude_reaction_wheels.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/attitude_reaction_wheels.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_reaction_wheels: PASSED only if they match.

import "std/astrodynamics/attitude_reaction_wheels.oo";

pub fn main() {
    let attitude_reaction_wheels_a = rw_count();
    let attitude_reaction_wheels_b = rw_count();
    if attitude_reaction_wheels_a != attitude_reaction_wheels_b {
        println("FAIL attitude_reaction_wheels");
        process_exit(1);
    }
    println("prod_ap_attitude_reaction_wheels: PASSED");
}
