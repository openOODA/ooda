import "std/quantum_open_systems/lindbladian_spectral_gap.oo";

pub fn main() {
    let lindbladian_spectral_gap_a = liouvillian_gap_estimate_qubit(0.0, 0.0, 0.0);
    let lindbladian_spectral_gap_b = liouvillian_gap_estimate_qubit(0.0, 0.0, 0.0);
    if lindbladian_spectral_gap_a.spectral_gap_delta != lindbladian_spectral_gap_b.spectral_gap_delta {
        println("FAIL lindbladian_spectral_gap");
        process_exit(1);
    }
    println("prod_ap_lindbladian_spectral_gap: PASSED");
