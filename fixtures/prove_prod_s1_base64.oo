// # Product prove std/encoding/base64.oo
//
// Logline: Fail-closed emit+gcc+run asserts base64_is_valid is deterministic.
//
// Setup: Isolated emit-c. Imports std/encoding/base64.oo.
//
// Beats:
//   1. Call base64_is_valid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_base64: PASSED only if they match.

import "std/encoding/base64.oo";

pub fn main() {
    let base64_mark: Int = 0;
    if base64_mark != 0 {
        process_exit(1);
    }
    let base64_a: Bool = base64_is_valid("x");
    let base64_b: Bool = base64_is_valid("x");
    if base64_a != base64_b {
        println("FAIL base64_is_valid");
        process_exit(1);
    }
    println("prod_base64: PASSED");
}
