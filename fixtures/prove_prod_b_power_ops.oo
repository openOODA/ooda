// # Product prove std/edge/power_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts power_ops_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power_ops.oo.
//
// Beats:
//   1. Call power_ops_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_power_ops: PASSED only if they match.

import "std/edge/power_ops.oo";

pub fn main() {
    let a = power_ops_probe();
    let b = power_ops_probe();
    if a != b {
        println("FAIL power_ops_probe");
        process_exit(1);
    }
    println("prod_power_ops: PASSED");
}
