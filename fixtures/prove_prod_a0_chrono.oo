// # Product prove std/time/chrono.oo
//
// Logline: Fail-closed emit+gcc+run asserts chrono_secs_to_ms is deterministic.
//
// Setup: Isolated emit-c. Imports std/time/chrono.oo.
//
// Beats:
//   1. Call chrono_secs_to_ms twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chrono: PASSED only if they match.

import "std/time/chrono.oo";

pub fn main() {
    let a = chrono_secs_to_ms(0);
    let b = chrono_secs_to_ms(0);
    if a != b {
        println("FAIL chrono_secs_to_ms");
        process_exit(1);
    }
    println("prod_chrono: PASSED");
}
