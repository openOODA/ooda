// # Void Result call? refuse
//
// Logline: emit-llvm fail-closes call? on Result[Void] instead of extracting the Err slot.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. Bind r as Result[Void, String].
//   2. Apply the try postfix.
//   3. Emit must print ERR llvm_emit.

pub fn main() {
    let r: Result[Void, String] = Err("e");
    r?;
}
