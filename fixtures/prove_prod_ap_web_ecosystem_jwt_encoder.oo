// # Product prove std/web_ecosystem/jwt_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/jwt_encoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/jwt_encoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jwt_encoder: PASSED only if they match.

import "std/web_ecosystem/jwt_encoder.oo";

pub fn main() {
    let jwt_encoder_a = base64_table();
    let jwt_encoder_b = base64_table();
    if jwt_encoder_a.contains(jwt_encoder_b) == false {
        println("FAIL jwt_encoder");
        process_exit(1);
    }
    if jwt_encoder_b.contains(jwt_encoder_a) == false {
        println("FAIL jwt_encoder");
        process_exit(1);
    }
    println("prod_ap_jwt_encoder: PASSED");
}
