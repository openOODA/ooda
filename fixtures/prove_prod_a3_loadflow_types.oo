// # Product prove std/grid/loadflow_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts complex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/loadflow_types.oo.
//
// Beats:
//   1. Call complex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_loadflow_types: PASSED only if they match.

import "std/grid/loadflow_types.oo";

pub fn main() {
    let loadflow_types_mark: Int = 0;
    if loadflow_types_mark != 0 {
        process_exit(1);
    }
    let a: ComplexNum = complex_new(0, 0);
    let b: ComplexNum = complex_new(0, 0);
    if (a).re != (b).re {
        println("FAIL complex_new");
        process_exit(1);
    }
    println("prod_loadflow_types: PASSED");
}
