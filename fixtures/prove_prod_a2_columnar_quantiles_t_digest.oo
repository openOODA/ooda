// # Product prove std/db_columnar/columnar_quantiles_t_digest.oo
//
// Logline: Fail-closed emit+gcc+run asserts tdigest_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_quantiles_t_digest.oo.
//
// Beats:
//   1. Call tdigest_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_quantiles_t_digest: PASSED only if they match.

import "std/db_columnar/columnar_quantiles_t_digest.oo";

pub fn main() {
    let columnar_quantiles_t_digest_mark: Int = 0;
    if columnar_quantiles_t_digest_mark != 0 {
        process_exit(1);
    }
    let a: TDigestState = tdigest_state_new(0);
    let b: TDigestState = tdigest_state_new(0);
    if (a).max_centroids != (b).max_centroids {
        println("FAIL tdigest_state_new");
        process_exit(1);
    }
    println("prod_columnar_quantiles_t_digest: PASSED");
}
