// # Product prove std/fhe_lattices/fhe_tfhe_trlwe.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_tfhe_trlwe_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_tfhe_trlwe.oo.
//
// Beats:
//   1. Call fhe_tfhe_trlwe_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_tfhe_trlwe: PASSED only if they match.

import "std/fhe_lattices/fhe_tfhe_trlwe.oo";

pub fn main() {
    let fhe_tfhe_trlwe_mark: Int = 0;
    if fhe_tfhe_trlwe_mark != 0 {
        process_exit(1);
    }
    let fhe_tfhe_trlwe_a: Int = fhe_tfhe_trlwe_probe();
    let fhe_tfhe_trlwe_b: Int = fhe_tfhe_trlwe_probe();
    if fhe_tfhe_trlwe_a != fhe_tfhe_trlwe_b {
        println("FAIL fhe_tfhe_trlwe_probe");
        process_exit(1);
    }
    println("prod_fhe_tfhe_trlwe: PASSED");
}
