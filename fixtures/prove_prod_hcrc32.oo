// # Product hash CRC-32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/crc32.oo.
//
// Setup: Product std/hash/crc32.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty CRC-32 is 0.
//   2. 123456789 is 3421780262 (ISO-HDLC).
//   9. Exit 1 before PASSED on a miss.

import "std/hash/crc32.oo";

pub fn main() {
    let e: Int = crc32("");
    if e != 0 {
        println("FAIL crc32 empty");
        process_exit(1);
    }
    let n: Int = crc32("123456789");
    if n != 3421780262 {
        println("FAIL crc32 123456789");
        process_exit(1);
    }
    println("prod_hcrc32: PASSED");
}
