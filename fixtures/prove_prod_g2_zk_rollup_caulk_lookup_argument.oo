// # Product prove std/zk_rollup/caulk_lookup_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts caulk_vanish_eval is a real value.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/caulk_lookup_argument.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call caulk_vanish_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_caulk_lookup_argument: PASSED only if they match.

import "std/zk_rollup/caulk_lookup_argument.oo";

pub fn main() {
    let g2_a = caulk_vanish_eval(8, 2, 2, 2, 2);
    let g2_b = caulk_vanish_eval(8, 2, 2, 2, 2);
    if g2_a != g2_b {
        println("FAIL caulk_vanish_eval");
        process_exit(1);
    }
    println("prod_g2_caulk_lookup_argument: PASSED");
}
