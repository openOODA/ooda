// # Product prove std/fintech_l3_book/fast_binary_wire_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts price_fixed_from_float is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/fast_binary_wire_codec.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call price_fixed_from_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fast_binary_wire_codec: PASSED only if they match.

import "std/fintech_l3_book/fast_binary_wire_codec.oo";

pub fn main() {
    let g0_a = price_fixed_from_float(1.0);
    let g0_b = price_fixed_from_float(1.0);
    if g0_a != g0_b {
        println("FAIL price_fixed_from_float");
        process_exit(1);
    }
    println("prod_g0_fast_binary_wire_codec: PASSED");
}
