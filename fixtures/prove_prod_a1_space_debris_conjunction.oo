// # Product prove std/astro_advanced/space_debris_conjunction.oo
//
// Logline: Fail-closed emit+gcc+run asserts conjunction_miss_m is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/space_debris_conjunction.oo.
//
// Beats:
//   1. Call conjunction_miss_m twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_space_debris_conjunction: PASSED only if they match.

import "std/astro_advanced/space_debris_conjunction.oo";

pub fn main() {
    let space_debris_conjunction_mark: Int = 0;
    if space_debris_conjunction_mark != 0 {
        process_exit(1);
    }
    let a: Int = conjunction_miss_m();
    let b: Int = conjunction_miss_m();
    if a != b {
        println("FAIL conjunction_miss_m");
        process_exit(1);
    }
    println("prod_space_debris_conjunction: PASSED");
}
