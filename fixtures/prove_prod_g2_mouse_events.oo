// # Product prove std/tui/mouse_events.oo
//
// Logline: Fail-closed emit+gcc+run asserts mouse_event_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/mouse_events.oo.
//
// Beats:
//   1. Call mouse_event_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mouse_events: PASSED only if they match.

import "std/tui/mouse_events.oo";

pub fn main() {
    let mouse_events_mark: Int = 0;
    if mouse_events_mark != 0 {
        process_exit(1);
    }
    let a: MouseEvent = mouse_event_new(0, 0, 0, 0);
    let b: MouseEvent = mouse_event_new(0, 0, 0, 0);
    if (a).kind != (b).kind {
        println("FAIL mouse_event_new");
        process_exit(1);
    }
    println("prod_g2_mouse_events: PASSED");
}
