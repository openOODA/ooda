// # Product prove std/astro_advanced/relativistic_time_dilation.oo
//
// Logline: Fail-closed emit+gcc+run asserts gps_clock_ns is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/relativistic_time_dilation.oo.
//
// Beats:
//   1. Call gps_clock_ns twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_relativistic_time_dilation: PASSED only if they match.

import "std/astro_advanced/relativistic_time_dilation.oo";

pub fn main() {
    let relativistic_time_dilation_mark: Int = 0;
    if relativistic_time_dilation_mark != 0 {
        process_exit(1);
    }
    let a: Int = gps_clock_ns();
    let b: Int = gps_clock_ns();
    if a != b {
        println("FAIL gps_clock_ns");
        process_exit(1);
    }
    println("prod_relativistic_time_dilation: PASSED");
}
