// # Huffman tree adversarial suite
//
// Logline: Proves prefix-free codes, fail-closed decode, and a 10000-byte random text roundtrip on the shipped Huffman codec.
//
// Setup: Pure. Imports std/compression/huffman_tree.oo. Run from ooda/.
//
// Beats:
//   1. Roundtrip a short mixed string and prove prefix-free lengths.
//   2. Reject a corrupted bitstream, an incomplete tree, and a single-symbol degeneracy.
//   3. Roundtrip 10000 random text bytes.

import "std/compression/huffman_tree.oo";

fn need(flag: Int, err: String, bytes: List[Int], msg: String) -> List[Int] {
    if flag < 1 {
        println("FAIL " + msg + ": " + err);
        process_exit(1);
    }
    return bytes;
}

fn eq_bytes(a: List[Int], b: List[Int]) -> Bool {
    if list_len(a) != list_len(b) {
        return false;
    }
    let mut i: Int = 0;
    while i < list_len(a) {
        if list_get(a, i) != list_get(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pack_lens(pack: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        o = list_push(o, list_get(pack, i));
        i = i + 1;
    }
    return o;
}

pub fn main() {
    let mut src: List[Int] = list_new();
    src = list_push(src, 97);
    src = list_push(src, 98);
    src = list_push(src, 99);
    src = list_push(src, 97);
    let enc: ByteOut = huffman_tree_encode(src);
    let pack: List[Int] = need(enc.flag, enc.err, enc.bytes, "enc");
    let dec: ByteOut = huffman_tree_decode(pack);
    let back: List[Int] = need(dec.flag, dec.err, dec.bytes, "dec");
    if eq_bytes(src, back) == false {
        println("FAIL short roundtrip");
        process_exit(1);
    }
    let lens: List[Int] = pack_lens(pack);
    if huffman_tree_is_prefix_free(lens) == false {
        println("FAIL prefix-free");
        process_exit(1);
    }
    println("prefix-free property holds");

    let mut bad: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(pack) - 1 {
        bad = list_push(bad, list_get(pack, i));
        i = i + 1;
    }
    let tr: ByteOut = huffman_tree_decode(bad);
    let trf: Int = tr.flag;
    if trf > 0 {
        println("FAIL truncated not err");
        process_exit(1);
    }
    println("corrupted bitstream is Err");

    let mut inc: List[Int] = list_new();
    i = 0;
    while i < 256 {
        inc = list_push(inc, 0);
        i = i + 1;
    }
    inc = list_push(inc, 3);
    inc = list_push(inc, 1);
    let ir: ByteOut = huffman_tree_decode(inc);
    let irf: Int = ir.flag;
    if irf > 0 {
        println("FAIL incomplete not err");
        process_exit(1);
    }
    println("incomplete tree is Err");

    let mut deg: List[Int] = list_new();
    i = 0;
    while i < 256 {
        if i == 65 {
            deg = list_push(deg, 1);
        } else {
            deg = list_push(deg, 0);
        }
        i = i + 1;
    }
    deg = list_push(deg, 1);
    deg = list_push(deg, 0);
    let dr: ByteOut = huffman_tree_decode(deg);
    let drf: Int = dr.flag;
    if drf > 0 {
        println("FAIL degenerate not err");
        process_exit(1);
    }
    println("degenerate single-character is Err");

    let mut big: List[Int] = list_new();
    let mut s: Int = 1234567;
    i = 0;
    while i < 10000 {
        s = (s * 1103515245 + 12345) & 2147483647;
        big = list_push(big, 97 + (s % 26));
        i = i + 1;
    }
    let be: ByteOut = huffman_tree_encode(big);
    let bp: List[Int] = need(be.flag, be.err, be.bytes, "bigenc");
    let bd: ByteOut = huffman_tree_decode(bp);
    let bb: List[Int] = need(bd.flag, bd.err, bd.bytes, "bigdec");
    if eq_bytes(big, bb) == false {
        println("FAIL 10000 roundtrip");
        process_exit(1);
    }
    println("10000-byte random text roundtrip");
    println("SUITE PASSED");
    println("test_huffman_tree: PASSED");
}
