// # Product prove std/graph_networks/modularity_matrix_optimization.oo
//
// Logline: Fail-closed emit+gcc+run asserts modularity_eval_q is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/modularity_matrix_optimization.oo.
//
// Beats:
//   1. Call modularity_eval_q twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_modularity_matrix_optimization: PASSED only if they match.

import "std/graph_networks/modularity_matrix_optimization.oo";

pub fn main() {
    let modularity_matrix_optimization_mark: Int = 0;
    if modularity_matrix_optimization_mark != 0 {
        process_exit(1);
    }
    let a: Int = modularity_eval_q(0, list_new(), list_new(), 0, list_new());
    let b: Int = modularity_eval_q(0, list_new(), list_new(), 0, list_new());
    if a != b {
        println("FAIL modularity_eval_q");
        process_exit(1);
    }
    println("prod_g2_modularity_matrix_optimization: PASSED");
}
