// # Product prove std/sec/net/mtls_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts mTLS policy configuration and engine lifecycle are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_engine.oo.
//
// Beats:
//   1. Initialize MtlsSecurityPolicy and evaluate configuration properties.
//   2. Add allowed SAN to policy and verify propagation.
//   3. Initialize MtlsEngine and verify halt controls.
//   4. Print prod_g4_sec_mtls_engine: PASSED and exit 0.

import "std/sec/net/mtls_engine.oo";

pub fn main() {
    let pol1: MtlsSecurityPolicy = mtls_policy_init("pol_01", "TLSv1.3", true, 3, true);
    let pol2: MtlsSecurityPolicy = mtls_policy_init("pol_01", "TLSv1.3", true, 3, true);

    if (pol1).mandatory_client_auth != (pol2).mandatory_client_auth || (pol1).mandatory_client_auth == false {
        println("FAIL mtls_policy_init mandatory_client_auth");
        process_exit(1);
    }

    if (pol1).max_cert_chain_depth != (pol2).max_cert_chain_depth || (pol1).max_cert_chain_depth != 3 {
        println("FAIL mtls_policy_init max_cert_chain_depth");
        process_exit(1);
    }

    if (pol1).fail_closed != (pol2).fail_closed || (pol1).fail_closed == false {
        println("FAIL mtls_policy_init fail_closed");
        process_exit(1);
    }

    let pol_san1: MtlsSecurityPolicy = mtls_policy_add_allowed_san(pol1, "example.com");
    let pol_san2: MtlsSecurityPolicy = mtls_policy_add_allowed_san(pol2, "example.com");
    if list_len((pol_san1).allowed_sans) != list_len((pol_san2).allowed_sans) || list_len((pol_san1).allowed_sans) != 1 {
        println("FAIL mtls_policy_add_allowed_san");
        process_exit(1);
    }

    let mut eng1: MtlsEngine = mtls_engine_init("ENG_01", pol1);
    let mut eng2: MtlsEngine = mtls_engine_init("ENG_01", pol2);

    if (eng1).total_handshakes != (eng2).total_handshakes || (eng1).total_handshakes != 0 {
        println("FAIL total_handshakes");
        process_exit(1);
    }

    if (eng1).system_halted != (eng2).system_halted || (eng1).system_halted == true {
        println("FAIL system_halted initial");
        process_exit(1);
    }

    mtls_engine_halt(&mut eng1);
    mtls_engine_halt(&mut eng2);
    if (eng1).system_halted != (eng2).system_halted || (eng1).system_halted == false {
        println("FAIL mtls_engine_halt");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_net_mtls_engine_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_mtls_engine: PASSED");
    process_exit(0);
}
