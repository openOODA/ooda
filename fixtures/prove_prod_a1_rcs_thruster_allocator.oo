// # Product prove std/astrodynamics/rcs_thruster_allocator.oo
//
// Logline: Fail-closed emit+gcc+run asserts rcs_thrusters is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/rcs_thruster_allocator.oo.
//
// Beats:
//   1. Call rcs_thrusters twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rcs_thruster_allocator: PASSED only if they match.

import "std/astrodynamics/rcs_thruster_allocator.oo";

pub fn main() {
    let rcs_thruster_allocator_mark: Int = 0;
    if rcs_thruster_allocator_mark != 0 {
        process_exit(1);
    }
    let a: Int = rcs_thrusters();
    let b: Int = rcs_thrusters();
    if a != b {
        println("FAIL rcs_thrusters");
        process_exit(1);
    }
    println("prod_rcs_thruster_allocator: PASSED");
}
