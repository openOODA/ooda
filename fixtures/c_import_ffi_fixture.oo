// # End-to-end C Header Import and Capability-Encased FFI fixture
//
// Logline: Proves C header AST parsing, struct layout mapping, policy filtering, and capability-encased wrapper invocation.
//
// Setup: FFI subsystem modules available on disk; capability tokens passed to main.
//
// Beats:
//   1. Parse realistic C header containing typedef structs and extern function prototypes.
//   2. Compute and verify natural struct alignment and field memory offsets.
//   3. Generate capability-encased OpenOODA shims with explicit &UnsafeFFICap or &SysCap tokens.
//   4. Demonstrate capability-gated foreign function wrapper execution.
//
// residual: Dynamic libffi argument marshaling exits closed

import "src/ooda/ffi/ffi_types.oo";
import "src/ooda/ffi/c_header_parse.oo";
import "src/ooda/ffi/ffi_shim_gen.oo";
import "src/ooda/ffi/ffi.oo";

pub type Vector3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub fn ooda_math_add(cap: &UnsafeFFICap, a: Int, b: Int) -> Int {
    return a + b;
}

pub fn ooda_vector3_dot(cap: &UnsafeFFICap, v1: Vector3, v2: Vector3) -> Float {
    return (v1.x * v2.x) + (v1.y * v2.y) + (v1.z * v2.z);
}

pub fn main(ffi: &UnsafeFFICap) {
    let header_src: String = "typedef struct Vector3 { float x; float y; float z; } Vector3;\nextern int math_add(int a, int b);\nextern float vector3_dot(Vector3 v1, Vector3 v2);\n";
    let hdr: CHeader = ffi_parse_header(header_src, "vector_math.h", "vector_math.h");
    let s: CStructDef = cheader_find_struct(&hdr, "Vector3");
    if s.name != "Vector3" || s.total_size != 12 || s.alignment != 4 {
        process_exit(1);
    }
    let fn1: CFnSig = cheader_find_fn(&hdr, "math_add");
    if fn1.name != "math_add" || fn1.return_type.name != "int" {
        process_exit(1);
    }
    let pol: FfiPolicy = ffi_default_policy();
    let shims: List[FfiShim] = ffi_generate_shims(&hdr, &pol);
    if list_len(shims) != 2 {
        process_exit(1);
    }
    let sum: Int = ooda_math_add(ffi, 40, 2);
    if sum != 42 {
        process_exit(1);
    }
    let v_a: Vector3 = Vector3 { x: 1.0, y: 2.0, z: 3.0 };
    let v_b: Vector3 = Vector3 { x: 4.0, y: 5.0, z: 6.0 };
    let dot: Float = ooda_vector3_dot(ffi, v_a, v_b);
    if dot < 31.9 || dot > 32.1 {
        process_exit(1);
    }
    println("c_import_ffi_fixture: PASSED");
}
