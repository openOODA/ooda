// # Product prove std/perf/memory_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/memory_pool.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/memory_pool.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_memory_pool: PASSED only if they match.

import "std/perf/memory_pool.oo";

pub fn main() {
    let memory_pool_a = mem_pool_create("x", 0, 0);
    let memory_pool_b = mem_pool_create("x", 0, 0);
    let memory_pool_va = mem_pool_used(memory_pool_a);
    let memory_pool_vb = mem_pool_used(memory_pool_b);
    if memory_pool_va != memory_pool_vb {
        println("FAIL memory_pool");
        process_exit(1);
    }
    println("prod_ap_memory_pool: PASSED");
}
