// # Data-Oriented Design and Struct-of-Arrays fixture
//
// Logline: Prove contiguous columnar allocation, AoS-to-SoA transformation, and SIMD kinematic streaming.
//
// Setup: Pure record definitions, column slicing, and contiguous buffer operations.
//
// Beats:
//   1. Build AoS entity records and transform into contiguous SoA columnar buffers.
//   2. Slice columnar field arrays and verify cache-aligned memory footprint.
//   3. Execute archetype chunk kinematic streaming and SIMD vector dot products.
//
// residual: AVX-512 hardware register mapping and unaligned traps exit closed

type AosEntity = struct {
    id: Int,
    x: Int,
    y: Int,
    z: Int,
    vx: Int,
    vy: Int,
    vz: Int,
    health: Int
};

pub fn align_to_cache_line(bytes: Int, cache_line: Int) -> Int {
    let rem: Int = bytes % cache_line;
    if rem == 0 {
        return bytes;
    }
    return bytes + (cache_line - rem);
}

pub fn soa_slice_column(col: List[Int], start: Int, length: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let total: Int = list_len(col);
    let mut i: Int = start;
    let end: Int = start + length;
    while i < end {
        if i < total {
            out = list_push(out, list_get(col, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn simd_dot_product(a: List[Int], b: List[Int]) -> Int {
    let len_a: Int = list_len(a);
    let len_b: Int = list_len(b);
    let n: Int = if len_a < len_b { len_a } else { len_b };
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let va: Int = list_get(a, i);
        let vb: Int = list_get(b, i);
        sum = sum + (va * vb);
        i = i + 1;
    }
    return sum;
}

pub fn simd_fma_stream(a: List[Int], factor: Int, bias: Int) -> List[Int] {
    let n: Int = list_len(a);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let va: Int = list_get(a, i);
        out = list_push(out, (va * factor) + bias);
        i = i + 1;
    }
    return out;
}

pub fn soa_integrate_motion(pos: List[Int], vel: List[Int], dt_ms: Int) -> List[Int] {
    let n: Int = list_len(pos);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let p: Int = list_get(pos, i);
        let v: Int = list_get(vel, i);
        out = list_push(out, p + ((v * dt_ms) / 1000));
        i = i + 1;
    }
    return out;
}

pub fn main() {
    // 1. AoS creation
    let e1 = AosEntity { id: 1, x: 100, y: 200, z: 300, vx: 10, vy: 20, vz: 30, health: 100 };
    let e2 = AosEntity { id: 2, x: 400, y: 500, z: 600, vx: 15, vy: 25, vz: 35, health: 90 };
    let e3 = AosEntity { id: 3, x: 700, y: 800, z: 900, vx: 20, vy: 30, vz: 40, health: 80 };

    // 2. Transform AoS -> SoA columnar vectors
    let mut col_id: List[Int] = list_new();
    let mut col_x: List[Int] = list_new();
    let mut col_y: List[Int] = list_new();
    let mut col_z: List[Int] = list_new();
    let mut col_vx: List[Int] = list_new();
    let mut col_vy: List[Int] = list_new();
    let mut col_vz: List[Int] = list_new();
    let mut col_hp: List[Int] = list_new();

    col_id = list_push(col_id, e1.id);
    col_x = list_push(col_x, e1.x);
    col_y = list_push(col_y, e1.y);
    col_z = list_push(col_z, e1.z);
    col_vx = list_push(col_vx, e1.vx);
    col_vy = list_push(col_vy, e1.vy);
    col_vz = list_push(col_vz, e1.vz);
    col_hp = list_push(col_hp, e1.health);

    col_id = list_push(col_id, e2.id);
    col_x = list_push(col_x, e2.x);
    col_y = list_push(col_y, e2.y);
    col_z = list_push(col_z, e2.z);
    col_vx = list_push(col_vx, e2.vx);
    col_vy = list_push(col_vy, e2.vy);
    col_vz = list_push(col_vz, e2.vz);
    col_hp = list_push(col_hp, e2.health);

    col_id = list_push(col_id, e3.id);
    col_x = list_push(col_x, e3.x);
    col_y = list_push(col_y, e3.y);
    col_z = list_push(col_z, e3.z);
    col_vx = list_push(col_vx, e3.vx);
    col_vy = list_push(col_vy, e3.vy);
    col_vz = list_push(col_vz, e3.vz);
    col_hp = list_push(col_hp, e3.health);

    if list_len(col_id) == 3 {
        println("aos_to_soa_ok");
    }

    // 3. Cache alignment verification (8 elements * 8 bytes = 64 bytes cache line)
    let raw_bytes: Int = 3 * 8;
    let aligned_bytes: Int = 0 + align_to_cache_line(raw_bytes, 64);
    if aligned_bytes == 64 {
        println("cache_align_ok");
    }

    // 4. Slice field array
    let slice_x: List[Int] = soa_slice_column(col_x, 0, 2);
    if list_len(slice_x) == 2 {
        if list_get(slice_x, 0) == 100 {
            if list_get(slice_x, 1) == 400 {
                println("slice_field_ok");
            }
        }
    }

    // 5. Stream transform FMA
    let scaled: List[Int] = simd_fma_stream(col_x, 2, 50);
    if list_get(scaled, 0) == 250 {
        if list_get(scaled, 1) == 850 {
            println("simd_fma_ok");
        }
    }

    // 6. SIMD dot product
    let dot: Int = 0 + simd_dot_product(col_x, col_vx);
    // 100*10 + 400*15 + 700*20 = 1000 + 6000 + 14000 = 21000
    if dot == 21000 {
        println("stream_dot_ok");
    }

    // 7. Kinematic integration stream (dt = 1000ms = 1s)
    let moved_x: List[Int] = soa_integrate_motion(col_x, col_vx, 1000);
    let moved_y: List[Int] = soa_integrate_motion(col_y, col_vy, 1000);
    let moved_z: List[Int] = soa_integrate_motion(col_z, col_vz, 1000);
    if list_get(moved_x, 0) == 110 {
        if list_get(moved_y, 0) == 220 {
            if list_get(moved_z, 0) == 330 {
                println("kinematics_ok");
            }
        }
    }

    println("dod_fixture: PASSED");
}
