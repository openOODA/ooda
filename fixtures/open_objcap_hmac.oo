// # HMAC object-capability notary
//
// Logline: Seal a capability string; attenuation shrinks rights; tamper fails.
//
// Setup: OPEN-37/38. HMAC-SHA256 of uri|rights via crypto_hmac_sha256_internal. CHS digest, not kernel object caps.
//
// Beats:
//   1. Seal FsWrite|/tmp|7 with key k.
//   2. Verify the same payload matches.
//   3. Child FsWrite|/tmp/sub|3 (rights 7&3=3) has a different seal.
//   4. Tampered FsWrite|/etc|7 must not match the first seal.

import "std/sec/objcap_hmac.oo";

pub fn main() {
    let key: String = "k";
    let payload: String = "FsWrite|/tmp|7";
    let seal: String = objcap_hmac_seal(key, payload);
    let again: String = objcap_hmac_seal(key, payload);
    if seal != again {
        println("FAIL match");
        process_exit(1);
    }
    let child: String = objcap_hmac_seal(key, "FsWrite|/tmp/sub|3");
    if seal == child {
        println("FAIL attenuate");
        process_exit(1);
    }
    let tampered: String = objcap_hmac_seal(key, "FsWrite|/etc|7");
    if seal == tampered {
        println("FAIL tamper");
        process_exit(1);
    }
    println("open_objcap_hmac: PASSED");
}
