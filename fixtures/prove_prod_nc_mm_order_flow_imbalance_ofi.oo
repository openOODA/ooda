// # Product prove std/hft_alpha/mm_order_flow_imbalance_ofi.oo
//
// Logline: Fail-closed emit+gcc+run asserts mm_order_flow_imbalance_ofi_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_order_flow_imbalance_ofi.oo.
//
// Beats:
//   1. Call mm_order_flow_imbalance_ofi_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_mm_order_flow_imbalance_ofi: PASSED only if it matches.

import "std/hft_alpha/mm_order_flow_imbalance_ofi.oo";

pub fn main() {
    let a: Int = mm_order_flow_imbalance_ofi_probe();
    if a != 0 {
        println("FAIL mm_order_flow_imbalance_ofi_probe");
        process_exit(1);
    }
    println("prod_nc_mm_order_flow_imbalance_ofi: PASSED");
}
