// # Product prove std/crypto/zkp_stubs.oo
//
// Logline: Fail-closed verification that ZKP cryptographic stubs and companion primitives execute deterministically.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_stubs.oo.
//
// Beats:
//   1. Execute Schnorr proof generation and verification.
//   2. Validate homomorphic Pedersen commitment arithmetic.
//   3. Prove and verify range proofs over secret bounds.
//   4. Print prod_g4_crypto_zkp_stubs: PASSED and exit 0.

import "std/crypto/zkp_stubs.oo";

pub fn main() {
    let v_modulus: Int = 1009;
    let v_generator: Int = 11;
    let v_sec_gen: Int = 17;
    let v_secret: Int = 42;
    let v_blinding: Int = 123;

    let v_pub_key: Int = zkp_mod_pow(v_generator, v_secret, v_modulus);
    let v_schnorr = schnorr_prove(v_secret, v_pub_key, v_generator, v_blinding, v_modulus);
    let schnorr_ok: Bool = schnorr_verify(v_schnorr);

    if !schnorr_ok {
        println("FAIL schnorr_verify");
        process_exit(1);
    }

    let v_comm1: PedersenCommitment = pedersen_commitment_create(v_generator, v_sec_gen, 10, 5, v_modulus);
    let v_comm2: PedersenCommitment = pedersen_commitment_create(v_generator, v_sec_gen, 20, 7, v_modulus);
    let v_comm_sum: PedersenCommitment = pedersen_commitment_homomorphic_add(v_comm1, v_comm2);
    let v_expected_sum: PedersenCommitment = pedersen_commitment_create(v_generator, v_sec_gen, 30, 12, v_modulus);

    if pedersen_opening(v_comm_sum) != pedersen_opening(v_expected_sum) {
        println("FAIL pedersen_commitment_homomorphic_add mismatch");
        process_exit(1);
    }

    let v_range_p = zkp_range_prove(15, 0, 100, 99, v_generator, v_sec_gen, v_modulus);
    let range_ok: Bool = zkp_range_verify(v_range_p, v_generator, v_sec_gen, v_modulus);

    if !range_ok {
        println("FAIL zkp_range_verify");
        process_exit(1);
    }

    println("prod_g4_crypto_zkp_stubs: PASSED");
    process_exit(0);
}
