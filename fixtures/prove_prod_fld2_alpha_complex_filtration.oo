// # Product prove std/tda_topology/alpha_complex_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts alpha_simplex_1d is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/alpha_complex_filtration.oo.
//
// Beats:
//   1. Call alpha_simplex_1d twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_alpha_complex_filtration: PASSED only if they match.

import "std/tda_topology/alpha_complex_filtration.oo";

pub fn main() {
    let alpha_complex_filtration_mark: Int = 0;
    if alpha_complex_filtration_mark != 0 {
        process_exit(1);
    }
    let alpha_complex_filtration_a = alpha_simplex_1d(1, 1, 1.0);
    let alpha_complex_filtration_b = alpha_simplex_1d(1, 1, 1.0);
    if (alpha_complex_filtration_a).v0 != (alpha_complex_filtration_b).v0 {
        println("FAIL alpha_simplex_1d");
        process_exit(1);
    }
    println("prod_alpha_complex_filtration: PASSED");
}
