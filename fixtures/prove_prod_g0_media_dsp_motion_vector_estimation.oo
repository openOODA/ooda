// # Product prove std/media_dsp/motion_vector_estimation.oo
//
// Logline: Fail-closed emit+gcc+run asserts motion_sad_pixel_pair is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/motion_vector_estimation.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call motion_sad_pixel_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_motion_vector_estimation: PASSED only if they match.

import "std/media_dsp/motion_vector_estimation.oo";

pub fn main() {
    let g0_a = motion_sad_pixel_pair(2, 2);
    let g0_b = motion_sad_pixel_pair(2, 2);
    if g0_a != g0_b {
        println("FAIL motion_sad_pixel_pair");
        process_exit(1);
    }
    println("prod_g0_motion_vector_estimation: PASSED");
}
