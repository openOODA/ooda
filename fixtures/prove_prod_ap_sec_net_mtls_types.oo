// # Product prove std/sec/net/mtls_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/net/mtls_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/mtls_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mtls_types: PASSED only if they match.

import "std/sec/net/mtls_types.oo";

pub fn main() {
    let mtls_types_a = checksum_calculate("x");
    let mtls_types_b = checksum_calculate("x");
    if mtls_types_a != mtls_types_b {
        println("FAIL mtls_types");
        process_exit(1);
    }
    println("prod_ap_mtls_types: PASSED");
}
