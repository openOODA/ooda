// # Product prove std/web_ecosystem/nanoid_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/nanoid_generator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/nanoid_generator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_nanoid_generator: PASSED only if they match.

import "std/web_ecosystem/nanoid_generator.oo";

pub fn main() {
    let nanoid_generator_a = nanoid_next_rand(0);
    let nanoid_generator_b = nanoid_next_rand(0);
    if nanoid_generator_a != nanoid_generator_b {
        println("FAIL nanoid_generator");
        process_exit(1);
    }
    println("prod_ap_nanoid_generator: PASSED");
}
