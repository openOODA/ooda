// # Product prove std/security_defense/dep_nx_enforcer.oo
//
// Logline: Fail-closed emit+gcc+run asserts page_prot_rw is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/dep_nx_enforcer.oo.
//
// Beats:
//   1. Call page_prot_rw twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dep_nx_enforcer: PASSED only if they match.

import "std/security_defense/dep_nx_enforcer.oo";

pub fn main() {
    let dep_nx_enforcer_mark: Int = 0;
    if dep_nx_enforcer_mark != 0 {
        process_exit(1);
    }
    let dep_nx_enforcer_a = page_prot_rw();
    let dep_nx_enforcer_b = page_prot_rw();
    if (dep_nx_enforcer_a).read != (dep_nx_enforcer_b).read {
        println("FAIL page_prot_rw");
        process_exit(1);
    }
    println("prod_dep_nx_enforcer: PASSED");
}
