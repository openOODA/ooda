// # Product prove std/crispr_cas/crispr_screen_mageck_enrichment.oo
//
// Logline: Fail-closed emit+gcc+run asserts mageck_calc_lfc is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_screen_mageck_enrichment.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call mageck_calc_lfc twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_screen_mageck_enrichment: PASSED only if they match.

import "std/crispr_cas/crispr_screen_mageck_enrichment.oo";

pub fn main() {
    let g2_a = mageck_calc_lfc(1.0, 1.0);
    let g2_b = mageck_calc_lfc(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL mageck_calc_lfc");
        process_exit(1);
    }
    println("prod_g2_crispr_screen_mageck_enrichment: PASSED");
}
