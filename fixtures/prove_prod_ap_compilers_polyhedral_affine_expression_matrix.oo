// # Product prove std/compilers_polyhedral/affine_expression_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/affine_expression_matrix.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/affine_expression_matrix.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_affine_expression_matrix: PASSED only if they match.

import "std/compilers_polyhedral/affine_expression_matrix.oo";

pub fn main() {
    let affine_expression_matrix_a = affine_matrix_new(0, 0);
    let affine_expression_matrix_b = affine_matrix_new(0, 0);
    let affine_expression_matrix_va = affine_matrix_get_entry(affine_expression_matrix_a, 0, 0);
    let affine_expression_matrix_vb = affine_matrix_get_entry(affine_expression_matrix_b, 0, 0);
    if affine_expression_matrix_va != affine_expression_matrix_vb {
        println("FAIL affine_expression_matrix");
        process_exit(1);
    }
    println("prod_ap_affine_expression_matrix: PASSED");
}
