// # Product glob match prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/fs/glob.oo wildcard and exact match.
//
// Setup: Tree oodac emit-c. Calls ooda/std/fs/glob.oo. Destub none. No caps.
//
// Beats:
//   1. glob_has_wildcards("*") is true.
//   2. glob_has_wildcards("abc") is false.
//   3. glob_matches("abc","abc") is true.
//   4. glob_matches("a?c","abc") is true.
//   5. Exit 1 on any miss. Print prod_glob: PASSED only if all hold.

import "std/fs/glob.oo";

pub fn main() {
    if !glob_has_wildcards("*") {
        println("FAIL glob wild *");
        process_exit(1);
    }
    if glob_has_wildcards("abc") {
        println("FAIL glob wild abc");
        process_exit(1);
    }
    if !glob_matches("abc", "abc") {
        println("FAIL glob exact");
        process_exit(1);
    }
    if !glob_matches("a?c", "abc") {
        println("FAIL glob qmark");
        process_exit(1);
    }
    println("prod_glob: PASSED");
}
