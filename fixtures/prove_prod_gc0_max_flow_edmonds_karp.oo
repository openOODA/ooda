// # Product prove std/graph_topology/max_flow_edmonds_karp.oo
//
// Logline: Fail-closed emit+gcc+run asserts max_flow_edmonds_karp_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/max_flow_edmonds_karp.oo.
//
// Beats:
//   1. Call max_flow_edmonds_karp_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_max_flow_edmonds_karp: PASSED only if they match.

import "std/graph_topology/max_flow_edmonds_karp.oo";

pub fn main() {
    let max_flow_edmonds_karp_mark: Int = 0;
    if max_flow_edmonds_karp_mark != 0 {
        process_exit(1);
    }
    let max_flow_edmonds_karp_a: Int = max_flow_edmonds_karp_probe();
    let max_flow_edmonds_karp_b: Int = max_flow_edmonds_karp_probe();
    if max_flow_edmonds_karp_a != max_flow_edmonds_karp_b {
        println("FAIL max_flow_edmonds_karp_probe");
        process_exit(1);
    }
    println("prod_max_flow_edmonds_karp: PASSED");
}
