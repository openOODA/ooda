// # Product prove std/scicomp/svd_golub_reinsch.oo
//
// Logline: Fail-closed emit+gcc+run asserts svd_decompose_2x2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/svd_golub_reinsch.oo.
//
// Beats:
//   1. Call svd_decompose_2x2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_svd_golub_reinsch: PASSED only if they match.

import "std/scicomp/svd_golub_reinsch.oo";

pub fn main() {
    let svd_golub_reinsch_mark: Int = 0;
    if svd_golub_reinsch_mark != 0 {
        process_exit(1);
    }
    let a: SvdResult = svd_decompose_2x2(0.0, 0.0, 0.0, 0.0);
    let b: SvdResult = svd_decompose_2x2(0.0, 0.0, 0.0, 0.0);
    if (a).rows != (b).rows {
        println("FAIL svd_decompose_2x2");
        process_exit(1);
    }
    println("prod_g2_svd_golub_reinsch: PASSED");
}
