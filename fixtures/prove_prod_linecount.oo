// # Product line/word count prove
//
// Logline: Fail-closed emit+gcc+run of shipped text_line_count/text_word_count.
//
// Setup: Product std/text/line_counter.oo. hello world is 1 line 2 words.
//
// Beats:
//   1. text_line_count hello world is 1; text_word_count is 2.
//   2. a\\nb is 2 lines.
//   3. Exit 1 before PASSED on a miss.

import "std/text/line_counter.oo";

pub fn main() {
    let lines: Int = text_line_count("hello world");
    if lines != 1 {
        println("FAIL lines");
        process_exit(1);
    }
    let words: Int = text_word_count("hello world");
    if words != 2 {
        println("FAIL words");
        process_exit(1);
    }
    let nl: Int = text_line_count("a\nb");
    if nl != 2 {
        println("FAIL nl");
        process_exit(1);
    }
    println("prod_linecount: PASSED");
}
