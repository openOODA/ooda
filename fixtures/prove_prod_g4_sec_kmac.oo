// # Product prove std/sec/crypto/kmac.oo
//
// Logline: Fail-closed emit+gcc+run asserts KMAC NIST SP 800-185 encoding and configuration operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/kmac.oo.
//
// Beats:
//   1. Evaluate left_encode, right_encode, and encode_string on sample inputs.
//   2. Validate bytepad framing and configuration rate accessors.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_sec_kmac: PASSED and exit 0.

import "std/sec/crypto/kmac.oo";

pub fn main() {
    let le_res1: Result[String, String] = shim_marker_left_encode(0);
    let le_res2: Result[String, String] = shim_marker_left_encode(0);
    let le1: String = match le_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let le2: String = match le_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if le1 != le2 || chars_len(le1) != 2 || byte_at(le1, 0) != 1 || byte_at(le1, 1) != 0 {
        println("FAIL left_encode 0");
        process_exit(1);
    }

    let re_res1: Result[String, String] = shim_marker_right_encode(0);
    let re_res2: Result[String, String] = shim_marker_right_encode(0);
    let re1: String = match re_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let re2: String = match re_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if re1 != re2 || chars_len(re1) != 2 || byte_at(re1, 0) != 0 || byte_at(re1, 1) != 1 {
        println("FAIL right_encode 0");
        process_exit(1);
    }

    let enc_res1: Result[String, String] = shim_marker_encode_string("ABC");
    let enc_res2: Result[String, String] = shim_marker_encode_string("ABC");
    let enc1: String = match enc_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let enc2: String = match enc_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if enc1 != enc2 || chars_len(enc1) != 5 {
        println("FAIL encode_string ABC");
        process_exit(1);
    }

    let pad_res1: Result[String, String] = shim_marker_bytepad("test", 168);
    let pad_res2: Result[String, String] = shim_marker_bytepad("test", 168);
    let pad1: String = match pad_res1 {
        Ok(s) => s,
        Err(_) => "",
    };
    let pad2: String = match pad_res2 {
        Ok(s) => s,
        Err(_) => "",
    };
    if pad1 != pad2 || chars_len(pad1) != 168 {
        println("FAIL bytepad");
        process_exit(1);
    }

    let cfg1: KmacConfig = shim_marker_config_new(1088, 512, 256);
    let cfg2: KmacConfig = shim_marker_config_new(1088, 512, 256);
    if kmac_config_rate(cfg1) != kmac_config_rate(cfg2) || kmac_config_rate(cfg1) != 1088 {
        println("FAIL kmac_config_rate");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_kmac_oo();
    if dummy != 0 {
        println("FAIL dummy");
        process_exit(1);
    }

    println("prod_g4_sec_kmac: PASSED");
    process_exit(0);
}
