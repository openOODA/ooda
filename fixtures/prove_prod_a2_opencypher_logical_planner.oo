// # Product prove std/db_graph/opencypher_logical_planner.oo
//
// Logline: Fail-closed emit+gcc+run asserts logical_plan_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_logical_planner.oo.
//
// Beats:
//   1. Call logical_plan_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_logical_planner: PASSED only if they match.

import "std/db_graph/opencypher_logical_planner.oo";

pub fn main() {
    let opencypher_logical_planner_mark: Int = 0;
    if opencypher_logical_planner_mark != 0 {
        process_exit(1);
    }
    let a: LogicalPlanNode = logical_plan_node_new(0, 0, "x", "x", "x", 0);
    let b: LogicalPlanNode = logical_plan_node_new(0, 0, "x", "x", "x", 0);
    if (a).node_id != (b).node_id {
        println("FAIL logical_plan_node_new");
        process_exit(1);
    }
    println("prod_opencypher_logical_planner: PASSED");
}
