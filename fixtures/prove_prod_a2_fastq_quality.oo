// # Product prove std/bioinformatics/fastq_quality.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_pow64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/fastq_quality.oo.
//
// Beats:
//   1. Call int_pow64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fastq_quality: PASSED only if they match.

import "std/bioinformatics/fastq_quality.oo";

pub fn main() {
    let fastq_quality_mark: Int = 0;
    if fastq_quality_mark != 0 {
        process_exit(1);
    }
    let a: Int = int_pow64(0);
    let b: Int = int_pow64(0);
    if a != b {
        println("FAIL int_pow64");
        process_exit(1);
    }
    println("prod_fastq_quality: PASSED");
}
