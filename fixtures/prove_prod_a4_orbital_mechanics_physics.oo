// # Product prove std/physics/orbital_mechanics_physics.oo
//
// Logline: Fail-closed emit+gcc+run asserts orbital_vis_viva_speed is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/orbital_mechanics_physics.oo.
//
// Beats:
//   1. Call orbital_vis_viva_speed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbital_mechanics_physics: PASSED only if they match.

import "std/physics/orbital_mechanics_physics.oo";

pub fn main() {
    let orbital_mechanics_physics_mark: Int = 0;
    if orbital_mechanics_physics_mark != 0 {
        process_exit(1);
    }
    let a: Float = orbital_vis_viva_speed(0.0, 0.0, 0.0);
    let b: Float = orbital_vis_viva_speed(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL orbital_vis_viva_speed");
        process_exit(1);
    }
    println("prod_orbital_mechanics_physics: PASSED");
}
