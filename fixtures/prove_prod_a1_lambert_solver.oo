// # Product prove std/astrodynamics/lambert_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts lambert_revs is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/lambert_solver.oo.
//
// Beats:
//   1. Call lambert_revs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lambert_solver: PASSED only if they match.

import "std/astrodynamics/lambert_solver.oo";

pub fn main() {
    let lambert_solver_mark: Int = 0;
    if lambert_solver_mark != 0 {
        process_exit(1);
    }
    let a: Int = lambert_revs();
    let b: Int = lambert_revs();
    if a != b {
        println("FAIL lambert_revs");
        process_exit(1);
    }
    println("prod_lambert_solver: PASSED");
}
