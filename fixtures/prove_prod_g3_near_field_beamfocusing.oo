// # Product prove std/telecom_6g/near_field_beamfocusing.oo
//
// Logline: Fail-closed emit+gcc+run asserts near_field_focus_config_sub_thz is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/near_field_beamfocusing.oo.
//
// Beats:
//   1. Call near_field_focus_config_sub_thz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_near_field_beamfocusing: PASSED only if they match.

import "std/telecom_6g/near_field_beamfocusing.oo";

pub fn main() {
    let near_field_beamfocusing_mark: Int = 0;
    if near_field_beamfocusing_mark != 0 {
        process_exit(1);
    }
    let a: NearFieldFocusConfig = near_field_focus_config_sub_thz();
    let b: NearFieldFocusConfig = near_field_focus_config_sub_thz();
    if (a).carrier_frequency_ghz != (b).carrier_frequency_ghz {
        println("FAIL near_field_focus_config_sub_thz");
        process_exit(1);
    }
    println("prod_near_field_beamfocusing: PASSED");
}
