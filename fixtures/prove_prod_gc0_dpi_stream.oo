// # Product prove std/net_telemetry/dpi_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts dpi_stream_session_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/dpi_stream.oo.
//
// Beats:
//   1. Call dpi_stream_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dpi_stream: PASSED only if they match.

import "std/net_telemetry/dpi_stream.oo";

pub fn main() {
    let dpi_stream_mark: Int = 0;
    if dpi_stream_mark != 0 {
        process_exit(1);
    }
    let dpi_stream_a = dpi_stream_session_new("x", 1);
    let dpi_stream_b = dpi_stream_session_new("x", 1);
    if (dpi_stream_a).expected_seq != (dpi_stream_b).expected_seq {
        println("FAIL dpi_stream_session_new");
        process_exit(1);
    }
    println("prod_dpi_stream: PASSED");
}
