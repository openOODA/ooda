// # Product prove std/sec/crypto/double_ratchet_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/double_ratchet_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/double_ratchet_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_double_ratchet_types: PASSED only if they match.

import "std/sec/crypto/double_ratchet_types.oo";

pub fn main() {
    let double_ratchet_types_a = ratchet_chain_new(0, 0, 0);
    let double_ratchet_types_b = ratchet_chain_new(0, 0, 0);
    let double_ratchet_types_va = ratchet_chain_index(double_ratchet_types_a);
    let double_ratchet_types_vb = ratchet_chain_index(double_ratchet_types_b);
    if double_ratchet_types_va != double_ratchet_types_vb {
        println("FAIL double_ratchet_types");
        process_exit(1);
    }
    println("prod_ap_double_ratchet_types: PASSED");
}
