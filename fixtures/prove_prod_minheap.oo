// # Product min_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped min_heap_push/len/contains.
//
// Setup: Product std/collections/min_heap.oo. Push 3 and 7.
//
// Beats:
//   1. After 3 and 7, len 2; contains 3 true; contains 1 false.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/min_heap.oo";

pub fn main() {
    let mut h: MinHeap = min_heap_new();
    h = min_heap_push(h, 3);
    h = min_heap_push(h, 7);
    let n: Int = min_heap_len(h);
    if n != 2 {
        println("FAIL minheap len");
        process_exit(1);
    }
    let c3: Bool = min_heap_contains(h, 3);
    if c3 == false {
        println("FAIL minheap contains 3");
        process_exit(1);
    }
    let c1: Bool = min_heap_contains(h, 1);
    if c1 == true {
        println("FAIL minheap contains 1");
        process_exit(1);
    }
    println("prod_minheap: PASSED");
}
