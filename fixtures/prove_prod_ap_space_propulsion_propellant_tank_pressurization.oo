// # Product prove std/space_propulsion/propellant_tank_pressurization.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/propellant_tank_pressurization.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_tank_pressurization.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_propellant_tank_pressurization: PASSED only if they match.

import "std/space_propulsion/propellant_tank_pressurization.oo";

pub fn main() {
    let propellant_tank_pressurization_a = tank_pressurization_spec_default_methalox();
    let propellant_tank_pressurization_b = tank_pressurization_spec_default_methalox();
    if propellant_tank_pressurization_a.tank_diameter_m != propellant_tank_pressurization_b.tank_diameter_m {
        println("FAIL propellant_tank_pressurization");
        process_exit(1);
    }
    println("prod_ap_propellant_tank_pressurization: PASSED");
}
