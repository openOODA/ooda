// # Product prove std/zk_rollup/plonk_permutation_argument.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_permutation_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_permutation_argument.oo.
//
// Beats:
//   1. Call plonk_permutation_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_permutation_argument: PASSED only if they match.

import "std/zk_rollup/plonk_permutation_argument.oo";

pub fn main() {
    let plonk_permutation_argument_mark: Int = 0;
    if plonk_permutation_argument_mark != 0 {
        process_exit(1);
    }
    let plonk_permutation_argument_a = plonk_permutation_state_new(1, 1, 1, 1);
    let plonk_permutation_argument_b = plonk_permutation_state_new(1, 1, 1, 1);
    if (plonk_permutation_argument_a).domain_size != (plonk_permutation_argument_b).domain_size {
        println("FAIL plonk_permutation_state_new");
        process_exit(1);
    }
    println("prod_plonk_permutation_argument: PASSED");
}
