// # Product prove std/fin/var_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts var_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_types.oo.
//
// Beats:
//   1. Call var_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_var_types: PASSED only if they match.

import "std/fin/var_types.oo";

pub fn main() {
    let var_types_mark: Int = 0;
    if var_types_mark != 0 {
        process_exit(1);
    }
    let a: VarResult = var_result_new(0, 0, 0);
    let b: VarResult = var_result_new(0, 0, 0);
    if (a).var_bps != (b).var_bps {
        println("FAIL var_result_new");
        process_exit(1);
    }
    println("prod_var_types: PASSED");
}
