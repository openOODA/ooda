// # Product prove std/space_propulsion/electrodynamic_tether_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts edt_spec_default_leo_deorbit value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/electrodynamic_tether_propulsion.oo.
//
// Beats:
//   1. Call edt_spec_default_leo_deorbit twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_electrodynamic_tether_propulsion: PASSED only if asserts hold.

import "std/space_propulsion/electrodynamic_tether_propulsion.oo";

pub fn main() {
    let electrodynamic_tether_propulsion_a: EdtSystemSpec = edt_spec_default_leo_deorbit();
    let electrodynamic_tether_propulsion_b: EdtSystemSpec = edt_spec_default_leo_deorbit();
    if electrodynamic_tether_propulsion_a.// e.g. 35 uT in LEO
    mode_thrust_or_drag != electrodynamic_tether_propulsion_b.// e.g. 35 uT in LEO
    mode_thrust_or_drag {
        println("FAIL edt_spec_default_leo_deorbit");
        process_exit(1);
    }
    println("prod_electrodynamic_tether_propulsion: PASSED");
}
