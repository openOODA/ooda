// # Product prove std/fhe_lattices/fhe_collective_keygen.oo
//
// Logline: Fail-closed emit+gcc+run asserts collective_keygen_verify_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_collective_keygen.oo.
//
// Beats:
//   1. Call collective_keygen_verify_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_collective_keygen: PASSED only if they match.

import "std/fhe_lattices/fhe_collective_keygen.oo";

pub fn main() {
    let fhe_collective_keygen_mark: Int = 0;
    if fhe_collective_keygen_mark != 0 {
        process_exit(1);
    }
    let a: Bool = collective_keygen_verify_threshold(0, 0);
    let b: Bool = collective_keygen_verify_threshold(0, 0);
    if a != b {
        println("FAIL collective_keygen_verify_threshold");
        process_exit(1);
    }
    println("prod_g2_fhe_collective_keygen: PASSED");
}
