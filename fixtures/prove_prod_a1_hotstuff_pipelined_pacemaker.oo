// # Product prove std/bft_consensus/hotstuff_pipelined_pacemaker.oo
//
// Logline: Fail-closed emit+gcc+run asserts pacemaker_get_leader is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_pipelined_pacemaker.oo.
//
// Beats:
//   1. Call pacemaker_get_leader twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hotstuff_pipelined_pacemaker: PASSED only if they match.

import "std/bft_consensus/hotstuff_pipelined_pacemaker.oo";

pub fn main() {
    let hotstuff_pipelined_pacemaker_mark: Int = 0;
    if hotstuff_pipelined_pacemaker_mark != 0 {
        process_exit(1);
    }
    let a: Int = pacemaker_get_leader(0, 0);
    let b: Int = pacemaker_get_leader(0, 0);
    if a != b {
        println("FAIL pacemaker_get_leader");
        process_exit(1);
    }
    println("prod_hotstuff_pipelined_pacemaker: PASSED");
}
