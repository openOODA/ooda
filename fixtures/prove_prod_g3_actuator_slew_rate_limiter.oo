// # Product prove std/auto_mpc_control/actuator_slew_rate_limiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts actuator_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/actuator_slew_rate_limiter.oo.
//
// Beats:
//   1. Call actuator_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_actuator_slew_rate_limiter: PASSED only if they match.

import "std/auto_mpc_control/actuator_slew_rate_limiter.oo";

pub fn main() {
    let actuator_slew_rate_limiter_mark: Int = 0;
    if actuator_slew_rate_limiter_mark != 0 {
        process_exit(1);
    }
    let a: ActuatorParams = actuator_params_default();
    let b: ActuatorParams = actuator_params_default();
    if (a).time_constant_tau != (b).time_constant_tau {
        println("FAIL actuator_params_default");
        process_exit(1);
    }
    println("prod_actuator_slew_rate_limiter: PASSED");
}
