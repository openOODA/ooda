// # Product prove std/cloud_faas/execution_timeout_watchdog.oo
//
// Logline: Fail-closed emit+gcc+run asserts execution_watchdog_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/execution_timeout_watchdog.oo.
//
// Beats:
//   1. Call execution_watchdog_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_execution_timeout_watchdog: PASSED only if they match.

import "std/cloud_faas/execution_timeout_watchdog.oo";

pub fn main() {
    let execution_timeout_watchdog_mark: Int = 0;
    if execution_timeout_watchdog_mark != 0 {
        process_exit(1);
    }
    let a: WatchdogTimer = execution_watchdog_new(0, 0);
    let b: WatchdogTimer = execution_watchdog_new(0, 0);
    if (a).invocation_id != (b).invocation_id {
        println("FAIL execution_watchdog_new");
        process_exit(1);
    }
    println("prod_execution_timeout_watchdog: PASSED");
}
