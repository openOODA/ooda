// # Product prove std/sec/sys/rop.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_gadget_type_pop_reg is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/rop.oo.
//
// Beats:
//   1. Call shim_marker_gadget_type_pop_reg twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rop: PASSED only if they match.

import "std/sec/sys/rop.oo";

pub fn main() {
    let rop_mark: Int = 0;
    if rop_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_gadget_type_pop_reg();
    let b: Int = shim_marker_gadget_type_pop_reg();
    if a != b { process_exit(1); }
    println("prod_rop: PASSED");
}
