// # Mixed or-and requires fail
//
// Logline: Fail closed when (a > 0 || b > 0) && c >= 0 sees a negative c.
//
// Beats:
//   1. Require any positive a or b and a non-negative c.
//   2. Return a + b + c.
//   3. Call with 1, 0, -1 so the and side fails.

// M165: (a > 0 || b > 0) && c >= 0 fail-closed when c < 0
pub fn any_pos_nonneg(a: Int, b: Int, c: Int) -> Int
    requires (a > 0 || b > 0) && c >= 0
{
    return a + b + c;
}

pub fn main() {
    println(any_pos_nonneg(1, 0, -1));
}
