// # Product combinations prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_combinations_count.
//
// Setup: Product std/math/combinatorics_combs.oo. C(5,2)=10.
//
// Beats:
//   1. C(5, 2) is 10.
//   2. C(10, 0) is 1.
//   3. C(4, 5) is 0.
//   4. Exit 1 before PASSED on a miss.

import "std/math/combinatorics_combs.oo";

pub fn main() {
    let c52: Int = math_combinations_count(5, 2);
    if c52 != 10 {
        println("FAIL C(5,2)");
        process_exit(1);
    }
    let c100: Int = math_combinations_count(10, 0);
    if c100 != 1 {
        println("FAIL C(10,0)");
        process_exit(1);
    }
    let c45: Int = math_combinations_count(4, 5);
    if c45 != 0 {
        println("FAIL C(4,5)");
        process_exit(1);
    }
    println("prod_combs: PASSED");
}
