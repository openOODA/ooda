// # Product prove std/grid/wind_turbine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/wind_turbine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/wind_turbine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wind_turbine: PASSED only if they match.

import "std/grid/wind_turbine.oo";
import "std/grid/wind_turbine_ops.oo";

pub fn main() {
    let wind_turbine_a = wind_turbine_new(0, 0.0, 0.0, 0.0);
    let wind_turbine_b = wind_turbine_new(0, 0.0, 0.0, 0.0);
    let wind_turbine_va = wind_turbine_is_safe(wind_turbine_a, 0.0);
    let wind_turbine_vb = wind_turbine_is_safe(wind_turbine_b, 0.0);
    if wind_turbine_va != wind_turbine_vb {
        println("FAIL wind_turbine");
        process_exit(1);
    }
    println("prod_ap_wind_turbine: PASSED");
}
