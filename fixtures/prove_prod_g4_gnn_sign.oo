// # Product prove std/graph_gnn/gnn_sign_scalable_inception.oo
//
// Logline: Fail-closed verification that SIGN multi-hop inception diffusion forward evaluation is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/gnn_sign_scalable_inception.oo.
//
// Beats:
//   1. Construct SIGNConfig and initialize branch and final weights with deterministic seed.
//   2. Run sign_forward_node on sample diffused features.
//   3. Assert deterministic return values.
//   4. Print prod_g4_gnn_sign: PASSED only if all match.

import "std/graph_gnn/gnn_sign_scalable_inception.oo";

pub fn main() {
    let cfg1: SIGNConfig = sign_config_new(4, 2, 2, 3);
    let cfg2: SIGNConfig = sign_config_new(4, 2, 2, 3);
    if cfg1.in_features != cfg2.in_features {
        println("FAIL sign_config_new in_features");
        process_exit(1);
    }
    if cfg1.hidden_features != cfg2.hidden_features {
        println("FAIL sign_config_new hidden_features");
        process_exit(1);
    }
    if cfg1.out_features != cfg2.out_features {
        println("FAIL sign_config_new out_features");
        process_exit(1);
    }
    if cfg1.num_diffusions != cfg2.num_diffusions {
        println("FAIL sign_config_new num_diffusions");
        process_exit(1);
    }

    // 3 * 4 * 2 = 24
    let bw1: List[Int] = sign_init_weights(24, 77);
    let bw2: List[Int] = sign_init_weights(24, 77);

    // 6 * 2 = 12
    let fw1: List[Int] = sign_init_weights(12, 88);
    let fw2: List[Int] = sign_init_weights(12, 88);

    let mut fb1: List[Int] = list_new();
    fb1 = list_push(fb1, 0);
    fb1 = list_push(fb1, 0);
    let mut fb2: List[Int] = list_new();
    fb2 = list_push(fb2, 0);
    fb2 = list_push(fb2, 0);

    // 3 * 4 = 12 diffused features
    let mut feats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        feats = list_push(feats, i + 1);
        i = i + 1;
    }

    let out1: List[Int] = sign_forward_node(cfg1, bw1, fw1, fb1, feats);
    let out2: List[Int] = sign_forward_node(cfg2, bw2, fw2, fb2, feats);

    let len1: Int = list_len(out1);
    let len2: Int = list_len(out2);
    if len1 != len2 {
        println("FAIL sign_forward_node length mismatch");
        process_exit(1);
    }
    if len1 != 2 {
        println("FAIL sign_forward_node length expected");
        process_exit(1);
    }

    let o0_a: Int = list_get(out1, 0);
    let o0_b: Int = list_get(out2, 0);
    if o0_a != o0_b {
        println("FAIL sign_forward_node o0");
        process_exit(1);
    }

    let o1_a: Int = list_get(out1, 1);
    let o1_b: Int = list_get(out2, 1);
    if o1_a != o1_b {
        println("FAIL sign_forward_node o1");
        process_exit(1);
    }

    println("prod_g4_gnn_sign: PASSED");
    process_exit(0);
}
