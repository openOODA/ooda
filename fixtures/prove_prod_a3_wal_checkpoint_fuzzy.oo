// # Product prove std/db_storage/wal_checkpoint_fuzzy.oo
//
// Logline: Fail-closed emit+gcc+run asserts fuzzy_checkpoint_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_checkpoint_fuzzy.oo.
//
// Beats:
//   1. Call fuzzy_checkpoint_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_checkpoint_fuzzy: PASSED only if they match.

import "std/db_storage/wal_checkpoint_fuzzy.oo";

pub fn main() {
    let wal_checkpoint_fuzzy_mark: Int = 0;
    if wal_checkpoint_fuzzy_mark != 0 {
        process_exit(1);
    }
    let a: FuzzyCheckpointRecord = fuzzy_checkpoint_record_new(0, 0);
    let b: FuzzyCheckpointRecord = fuzzy_checkpoint_record_new(0, 0);
    if (a).checkpoint_id != (b).checkpoint_id {
        println("FAIL fuzzy_checkpoint_record_new");
        process_exit(1);
    }
    println("prod_wal_checkpoint_fuzzy: PASSED");
}
