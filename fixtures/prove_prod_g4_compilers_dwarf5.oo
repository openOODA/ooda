// # Product prove std/compilers_vm/dwarf5_debug_lines.oo
//
// Logline: Fail-closed verification of DWARF5 debug line state machine transitions and matrix emission.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/dwarf5_debug_lines.oo.
//
// Beats:
//   1. Initialize DWARF5 default line header and state machine.
//   2. Step state machine with PC advances, line advances, and special opcodes.
//   3. Assert deterministic state transitions and row emissions.
//   4. Print prod_g4_compilers_dwarf5: PASSED and exit 0.

import "std/compilers_vm/dwarf5_debug_lines.oo";

pub fn main() {
    let hdr: DwarfLineHeader = dwarf_line_header_default();
    let ver: Int = (hdr).version;
    let base: Int = (hdr).line_base;
    let range: Int = (hdr).line_range;
    let opbase: Int = (hdr).opcode_base;

    if ver != 5 || base != -5 || range != 14 || opbase != 13 {
        println("FAIL dwarf_line_header_default");
        process_exit(1);
    }

    let mut sm: DwarfLineStateMachine = dwarf_line_state_machine_new(hdr);
    let row0: LineMatrixRow = (sm).current_row;
    let addr0: Int = (row0).address;
    let line0: Int = (row0).line_number;
    if addr0 != 0 || line0 != 1 {
        println("FAIL dwarf_line_state_machine_new initial row");
        process_exit(1);
    }

    sm = dwarf_step_advance_pc(sm, 16);
    sm = dwarf_step_advance_line(sm, 4);
    sm = dwarf_step_emit_row(sm);

    let rows_cnt1: Int = (sm).row_count;
    if rows_cnt1 != 1 {
        println("FAIL dwarf_step_emit_row count");
        process_exit(1);
    }

    sm = dwarf_step_special_opcode(sm, 20);
    let rows_cnt2: Int = (sm).row_count;
    if rows_cnt2 != 2 {
        println("FAIL dwarf_step_special_opcode count");
        process_exit(1);
    }

    println("prod_g4_compilers_dwarf5: PASSED");
    process_exit(0);
}
