// # Product prove std/deep_ai/qlora_nf4_quantize.oo
//
// Logline: Fail-closed emit+gcc+run asserts qlora_nf4_quantize_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/deep_ai/qlora_nf4_quantize.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call qlora_nf4_quantize_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_qlora_nf4_quantize: PASSED only if they match.

import "std/deep_ai/qlora_nf4_quantize.oo";

pub fn main() {
    let g0_a = qlora_nf4_quantize_marker();
    let g0_b = qlora_nf4_quantize_marker();
    if g0_a != g0_b {
        println("FAIL qlora_nf4_quantize_marker");
        process_exit(1);
    }
    println("prod_gr_qlora_nf4_quantize: PASSED");
}
