// # Product std/core string helpers prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/core/str.oo length, empty, concat, contains.
//
// Setup: Tree oodac emit-c. Calls ooda/std/core/str.oo. Destub none. No caps.
//
// Beats:
//   1. str_len("hi") is 2.
//   2. str_is_empty("") is true.
//   3. str_concat("a","b") is "ab".
//   4. str_contains("hello","ell") is true.
//   5. Exit 1 on any miss. Print prod_core_str: PASSED only if all hold.

import "std/core/str.oo";

pub fn main() {
    let n: Int = str_len("hi");
    if n != 2 {
        println("FAIL str_len");
        process_exit(1);
    }
    if !str_is_empty("") {
        println("FAIL str_is_empty");
        process_exit(1);
    }
    let ab: String = str_concat("a", "b");
    if ab != "ab" {
        println("FAIL str_concat");
        process_exit(1);
    }
    if !str_contains("hello", "ell") {
        println("FAIL str_contains");
        process_exit(1);
    }
    println("prod_core_str: PASSED");
}
