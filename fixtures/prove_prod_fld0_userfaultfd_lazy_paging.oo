// # Product prove std/cloud_faas/userfaultfd_lazy_paging.oo
//
// Logline: Fail-closed emit+gcc+run asserts userfaultfd_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/userfaultfd_lazy_paging.oo.
//
// Beats:
//   1. Call userfaultfd_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_userfaultfd_lazy_paging: PASSED only if they match.

import "std/cloud_faas/userfaultfd_lazy_paging.oo";

pub fn main() {
    let userfaultfd_lazy_paging_mark: Int = 0;
    if userfaultfd_lazy_paging_mark != 0 {
        process_exit(1);
    }
    let userfaultfd_lazy_paging_a: UserfaultfdManager = userfaultfd_manager_new("x", 1);
    let userfaultfd_lazy_paging_b: UserfaultfdManager = userfaultfd_manager_new("x", 1);
    if (userfaultfd_lazy_paging_a).page_size_bytes != (userfaultfd_lazy_paging_b).page_size_bytes {
        println("FAIL userfaultfd_manager_new");
        process_exit(1);
    }
    println("prod_userfaultfd_lazy_paging: PASSED");
}
