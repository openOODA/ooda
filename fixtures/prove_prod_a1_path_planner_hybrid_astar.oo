// # Product prove std/auto_robot/path_planner_hybrid_astar.oo
//
// Logline: Fail-closed emit+gcc+run asserts hastar_f is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/path_planner_hybrid_astar.oo.
//
// Beats:
//   1. Call hastar_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_path_planner_hybrid_astar: PASSED only if they match.

import "std/auto_robot/path_planner_hybrid_astar.oo";

pub fn main() {
    let path_planner_hybrid_astar_mark: Int = 0;
    if path_planner_hybrid_astar_mark != 0 {
        process_exit(1);
    }
    let a: Int = hastar_f(0, 0);
    let b: Int = hastar_f(0, 0);
    if a != b {
        println("FAIL hastar_f");
        process_exit(1);
    }
    println("prod_path_planner_hybrid_astar: PASSED");
}
