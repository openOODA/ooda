// # Product prove std/graph_topology/pagerank_power_iteration.oo
//
// Logline: Fail-closed emit+gcc+run asserts pagerank_power_iteration_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_topology/pagerank_power_iteration.oo.
//
// Beats:
//   1. Call pagerank_power_iteration_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pagerank_power_iteration: PASSED only if it matches.

import "std/graph_topology/pagerank_power_iteration.oo";

pub fn main() {
    let a: Int = pagerank_power_iteration_probe();
    if a != 0 {
        println("FAIL pagerank_power_iteration_probe");
        process_exit(1);
    }
    println("prod_nc_pagerank_power_iteration: PASSED");
}
