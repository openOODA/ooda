// # Product prove std/auto_mpc_control/mpc_linear_time_invariant.oo
//
// Logline: Fail-closed emit+gcc+run asserts lti_mpc_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_linear_time_invariant.oo.
//
// Beats:
//   1. Call lti_mpc_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mpc_linear_time_invariant: PASSED only if they match.

import "std/auto_mpc_control/mpc_linear_time_invariant.oo";

pub fn main() {
    let mpc_linear_time_invariant_mark: Int = 0;
    if mpc_linear_time_invariant_mark != 0 {
        process_exit(1);
    }
    let a: LTIMPCConfig = lti_mpc_config_default();
    let b: LTIMPCConfig = lti_mpc_config_default();
    if (a).horizon_n != (b).horizon_n {
        println("FAIL lti_mpc_config_default");
        process_exit(1);
    }
    println("prod_g2_mpc_linear_time_invariant: PASSED");
}
