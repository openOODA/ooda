// # Leftover println ident is not a string let
//
// Logline: Fold must miss when println(ident) is not a same-fn string-literal let.
//
// Setup: emit-x86 honesty must ERR x86_emit, not emit nope. Do not lower calls.
//
// Beats:
//   1. main binds message from foo.
//   2. println(message) is not a string-literal let in that fn.
//   3. foo returns nope; greet-fold and call lowering stay residual.

pub fn main() {
    let message = foo();
    println(message);
}

fn foo() -> String { return "nope"; }
