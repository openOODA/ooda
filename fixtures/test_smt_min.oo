// # Test SMT Solver (Minimal)
//
// Logline: Proves the 3 acceptance theorems using the inner DPLL + Fourier-Motzkin modules directly.
//
// Setup: Imports smt_linear_qf_lia.oo and smt_dpll.oo; tests Sat/Unsat via bounded FM search and DPLL.
//
// Beats:
//   1. Theorem 1: x > 5 AND (x + 1 <= 6) is UNSAT (so implication x>5 => x+1>6 holds).
//   2. Theorem 2: 0 == 1 is UNSAT.
//   3. Theorem 3: x >= 0 AND x < 0 is UNSAT.

import "std/formal_verif/smt_linear_qf_lia.oo";
import "std/formal_verif/smt_dpll.oo";

pub fn prove_x_gt5_implies_xp1_gt6() -> Int {
    // (x > 5) AND (x + 1 <= 6) is UNSAT. Senses: 4=GT, 0=LE.
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0 - 5, 4));  // x - 5 > 0
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0 - 5, 0));  // x - 5 <= 0
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0, 100, 0, 100);
    let result: Int = list_get(r, 0);
    if result == 0 { return 1; }
    return 0;
}

pub fn prove_zero_eq_one() -> Int {
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(0, 0, 0 - 1, 2));
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0 - 10, 10, 0 - 10, 10);
    let result: Int = list_get(r, 0);
    if result == 0 { return 1; }
    return 0;
}

pub fn prove_x_ge0_and_x_lt0() -> Int {
    // x >= 0 (sense 3 = GE) AND x < 0 (sense 1 = LT) is UNSAT.
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0, 3));  // x >= 0
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0, 1));  // x < 0
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0 - 10, 10, 0 - 10, 10);
    let result: Int = list_get(r, 0);
    if result == 0 { return 1; }
    return 0;
}

pub fn main() -> Int {
    let mut passed: Int = 0;
    let r1: Int = prove_x_gt5_implies_xp1_gt6();
    let r2: Int = prove_zero_eq_one();
    let r3: Int = prove_x_ge0_and_x_lt0();
    if r1 == 1 { passed = passed + 1; }
    if r2 == 1 { passed = passed + 1; }
    if r3 == 1 { passed = passed + 1; }
    println("SMT_THEOREMS: " + passed.to_string() + "/3");
    if passed == 3 {
        println("PASSED");
        return 0;
    }
    println("FAILED");
    return 1;
}
