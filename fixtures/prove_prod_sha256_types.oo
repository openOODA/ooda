// # Product prove std/crypto/sha256_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha256_state_h0 is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/sha256_types.oo.
//
// Beats:
//   1. Call sha256_state_h0 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha256_types: PASSED only if they match.

import "std/crypto/sha256_types.oo";

pub fn main() {
    let obj = sha256_state_new(0, 0);
    let a = sha256_state_h0(obj);
    let b = sha256_state_h0(obj);
    if a != b {
        println("FAIL sha256_state_h0");
        process_exit(1);
    }
    println("prod_sha256_types: PASSED");
}
