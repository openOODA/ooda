// # Product prove std/astro_advanced/attitude_triad_algorithm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/attitude_triad_algorithm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/attitude_triad_algorithm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_attitude_triad_algorithm: PASSED only if they match.

import "std/astro_advanced/attitude_triad_algorithm.oo";

pub fn main() {
    let attitude_triad_algorithm_a = triad_yaw(0);
    let attitude_triad_algorithm_b = triad_yaw(0);
    if attitude_triad_algorithm_a != attitude_triad_algorithm_b {
        println("FAIL attitude_triad_algorithm");
        process_exit(1);
    }
    println("prod_ap_attitude_triad_algorithm: PASSED");
}
