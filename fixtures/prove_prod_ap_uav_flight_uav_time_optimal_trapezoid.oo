// # Product prove std/uav_flight/uav_time_optimal_trapezoid.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/uav_flight/uav_time_optimal_trapezoid.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_time_optimal_trapezoid.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_uav_time_optimal_trapezoid: PASSED only if they match.

import "std/uav_flight/uav_time_optimal_trapezoid.oo";

pub fn main() {
    let uav_time_optimal_trapezoid_a = trap_isqrt_seed(0, 0);
    let uav_time_optimal_trapezoid_b = trap_isqrt_seed(0, 0);
    if uav_time_optimal_trapezoid_a != uav_time_optimal_trapezoid_b {
        println("FAIL uav_time_optimal_trapezoid");
        process_exit(1);
    }
    println("prod_ap_uav_time_optimal_trapezoid: PASSED");
}
