// # Product prove std/cloud/s3_auth_v4.oo
//
// Logline: Fail-closed emit+gcc+run asserts s3_auth_v4_canonical_uri is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/s3_auth_v4.oo.
//
// Beats:
//   1. Call s3_auth_v4_canonical_uri twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_s3_auth_v4: PASSED only if they match.

import "std/cloud/s3_auth_v4.oo";

pub fn main() {
    let a = s3_auth_v4_canonical_uri("x");
    let b = s3_auth_v4_canonical_uri("x");
    if a != b {
        println("FAIL s3_auth_v4_canonical_uri");
        process_exit(1);
    }
    println("prod_s3_auth_v4: PASSED");
}
