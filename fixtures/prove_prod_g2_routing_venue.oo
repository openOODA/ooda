// # Product prove std/fin/routing_venue.oo
//
// Logline: Fail-closed emit+gcc+run asserts routing_venue_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing_venue.oo.
//
// Beats:
//   1. Call routing_venue_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_routing_venue: PASSED only if they match.

import "std/fin/routing_venue.oo";

pub fn main() {
    let a: Int = routing_venue_probe();
    let b: Int = routing_venue_probe();
    if a != b {
        println("FAIL routing_venue_probe");
        process_exit(1);
    }
    println("prod_g2_routing_venue: PASSED");
}
