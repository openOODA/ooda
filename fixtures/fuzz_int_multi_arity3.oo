// Pure Int arity-3 sample (M49 In). Residual fail-closed is arity≥4 → fuzz_int_multi_arity4.oo.
// Prefer fixtures/fuzz_int_multi3_add.oo for the CI pass rail.
// FUZZ_DOMAIN: int
// FUZZ_TARGET: triple_add 0 10
// FUZZ_REQUIRES: triple_add x >= 0 && y >= 0 && z >= 0
// FUZZ_ENSURES: triple_add result == x + y + z
fn triple_add(x: Int, y: Int, z: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    requires z >= 0;
    ensures result == x + y + z;
    return x + y + z;
}

