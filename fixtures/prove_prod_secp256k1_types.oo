// # Product prove std/sec/crypto/secp256k1_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts secp256k1_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/secp256k1_types.oo.
//
// Beats:
//   1. Call secp256k1_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_secp256k1_types: PASSED only if they match.

import "std/sec/crypto/secp256k1_types.oo";

pub fn main() {
    let a = secp256k1_checksum("x");
    let b = secp256k1_checksum("x");
    if a != b {
        println("FAIL secp256k1_checksum");
        process_exit(1);
    }
    println("prod_secp256k1_types: PASSED");
}
