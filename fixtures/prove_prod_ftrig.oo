// # Product fast trig prove
//
// Logline: Fail-closed emit+gcc+run of shipped fast_deg2rad / fast_rad2deg.
//
// Setup: Product std/math/fast_trig.oo. 180 deg is pi; pi rad is 180.
//
// Beats:
//   1. fast_deg2rad(180) is 3.141592653589793.
//   2. fast_rad2deg of that is 180.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/fast_trig.oo";

pub fn main() {
    let r: Float = fast_deg2rad(180.0);
    if r != 3.141592653589793 {
        println("FAIL deg2rad");
        process_exit(1);
    }
    let d: Float = fast_rad2deg(r);
    if d != 180.0 {
        println("FAIL rad2deg");
        process_exit(1);
    }
    println("prod_ftrig: PASSED");
}
