// # Product prove std/satellite_dvb/dvb_s2x_bb_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_s2x_crc8_step is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_bb_header.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dvb_s2x_crc8_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_dvb_s2x_bb_header: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_bb_header.oo";

pub fn main() {
    let g0_a = dvb_s2x_crc8_step(2, 2);
    let g0_b = dvb_s2x_crc8_step(2, 2);
    if g0_a != g0_b {
        println("FAIL dvb_s2x_crc8_step");
        process_exit(1);
    }
    println("prod_g0_dvb_s2x_bb_header: PASSED");
}
