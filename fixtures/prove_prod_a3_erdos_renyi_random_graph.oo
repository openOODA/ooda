// # Product prove std/graph_networks/erdos_renyi_random_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts er_check_giant_component_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/erdos_renyi_random_graph.oo.
//
// Beats:
//   1. Call er_check_giant_component_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_erdos_renyi_random_graph: PASSED only if they match.

import "std/graph_networks/erdos_renyi_random_graph.oo";

pub fn main() {
    let erdos_renyi_random_graph_mark: Int = 0;
    if erdos_renyi_random_graph_mark != 0 {
        process_exit(1);
    }
    let a: Bool = er_check_giant_component_threshold(0, 0);
    let b: Bool = er_check_giant_component_threshold(0, 0);
    if a != b {
        println("FAIL er_check_giant_component_threshold");
        process_exit(1);
    }
    println("prod_erdos_renyi_random_graph: PASSED");
}
