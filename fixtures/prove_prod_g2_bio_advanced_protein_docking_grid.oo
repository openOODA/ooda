// # Product prove std/bio_advanced/protein_docking_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts docking_lennard_jones_energy is a real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_docking_grid.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call docking_lennard_jones_energy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_protein_docking_grid: PASSED only if they match.

import "std/bio_advanced/protein_docking_grid.oo";

pub fn main() {
    let g2_a = docking_lennard_jones_energy(1.0, 1.0, 1.0);
    let g2_b = docking_lennard_jones_energy(1.0, 1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL docking_lennard_jones_energy");
        process_exit(1);
    }
    println("prod_g2_protein_docking_grid: PASSED");
}
