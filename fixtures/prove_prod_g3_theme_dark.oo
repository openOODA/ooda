// # Product prove std/tui/theme_dark.oo
//
// Logline: Fail-closed emit+gcc+run asserts theme_dark_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/tui/theme_dark.oo.
//
// Beats:
//   1. Call theme_dark_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_theme_dark: PASSED only if they match.

import "std/tui/theme_dark.oo";

pub fn main() {
    let a: TuiDarkTheme = theme_dark_default();
    let b: TuiDarkTheme = theme_dark_default();
    if (a).bg != (b).bg {
        println("FAIL theme_dark_default");
        process_exit(1);
    }
    println("prod_theme_dark: PASSED");
}
