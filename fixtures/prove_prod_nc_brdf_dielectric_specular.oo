// # Product prove std/pbr_raytracing/brdf_dielectric_specular.oo
//
// Logline: Fail-closed emit+gcc+run asserts brdf_dielectric_specular_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/brdf_dielectric_specular.oo.
//
// Beats:
//   1. Call brdf_dielectric_specular_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_brdf_dielectric_specular: PASSED only if it matches.

import "std/pbr_raytracing/brdf_dielectric_specular.oo";

pub fn main() {
    let a: Int = brdf_dielectric_specular_probe();
    if a != 0 {
        println("FAIL brdf_dielectric_specular_probe");
        process_exit(1);
    }
    println("prod_nc_brdf_dielectric_specular: PASSED");
}
