// # Product prove std/net/websocket_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts ws_frame_opcode_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/websocket_frame.oo.
//
// Beats:
//   1. Call ws_frame_opcode_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_websocket_frame: PASSED only if they match.

import "std/net/websocket_frame.oo";

pub fn main() {
    let a = ws_frame_opcode_name(0);
    let b = ws_frame_opcode_name(0);
    if a != b {
        println("FAIL ws_frame_opcode_name");
        process_exit(1);
    }
    println("prod_websocket_frame: PASSED");
}
