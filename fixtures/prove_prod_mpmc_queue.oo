// # Product prove std/sync/mpmc_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpmc_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/mpmc_queue.oo.
//
// Beats:
//   1. Call mpmc_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpmc_queue: PASSED only if they match.

import "std/sync/mpmc_queue.oo";

pub fn main() {
    let obj = mpmc_new(0);
    let a = mpmc_len(obj);
    let b = mpmc_len(obj);
    if a != b {
        println("FAIL mpmc_len");
        process_exit(1);
    }
    println("prod_mpmc_queue: PASSED");
}
