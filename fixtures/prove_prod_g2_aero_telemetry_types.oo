// # Product prove std/aero/telemetry_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts packet_header_apid is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call packet_header_apid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telemetry_types: PASSED only if they match.

import "std/aero/telemetry_types.oo";

pub fn main() {
    let g2_oa = packet_header_new(2, 8, 8);
    let g2_ob = packet_header_new(2, 8, 8);
    let g2_a = packet_header_apid(g2_oa);
    let g2_b = packet_header_apid(g2_ob);
    if g2_a != g2_b {
        println("FAIL packet_header_apid");
        process_exit(1);
    }
    println("prod_g2_telemetry_types: PASSED");
}
