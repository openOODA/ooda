// # Product prove std/aero/attitude_dcm.oo
//
// Logline: Fail-closed emit+gcc+run asserts dcm_cell_r00 is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_dcm.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dcm_cell_r00 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_attitude_dcm: PASSED only if they match.

import "std/aero/attitude_dcm.oo";

pub fn main() {
    let g2_oa = dcm_cell_new(2, 2);
    let g2_ob = dcm_cell_new(2, 2);
    let g2_a = dcm_cell_r00(g2_oa);
    let g2_b = dcm_cell_r00(g2_ob);
    if g2_a != g2_b {
        println("FAIL dcm_cell_r00");
        process_exit(1);
    }
    println("prod_g2_attitude_dcm: PASSED");
}
