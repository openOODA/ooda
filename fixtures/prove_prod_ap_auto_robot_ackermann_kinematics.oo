// # Product prove std/auto_robot/ackermann_kinematics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/ackermann_kinematics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/ackermann_kinematics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ackermann_kinematics: PASSED only if they match.

import "std/auto_robot/ackermann_kinematics.oo";

pub fn main() {
    let ackermann_kinematics_a = ack_track_half(0);
    let ackermann_kinematics_b = ack_track_half(0);
    if ackermann_kinematics_a != ackermann_kinematics_b {
        println("FAIL ackermann_kinematics");
        process_exit(1);
    }
    println("prod_ap_ackermann_kinematics: PASSED");
}
