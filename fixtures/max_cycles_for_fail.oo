// # For exceeds cycle budget
//
// Logline: Count a 0..10 for-range past a two-cycle budget.
//
// Beats:
//   1. Keep the two-cycle marker.
//   2. For i in 0..10 increment s.
//   3. Expect the shared budget to trip.

// M54 MaxCycles path B — range-for exceeds budget
// MAX_CYCLES: 2
pub fn main() {
    let mut s = 0;
    for i in 0..10 {
        s = s + 1;
    }
    println(s);
}
