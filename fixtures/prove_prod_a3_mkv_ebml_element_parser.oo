// # Product prove std/media_dsp/mkv_ebml_element_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts ebml_id_header is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/mkv_ebml_element_parser.oo.
//
// Beats:
//   1. Call ebml_id_header twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mkv_ebml_element_parser: PASSED only if they match.

import "std/media_dsp/mkv_ebml_element_parser.oo";

pub fn main() {
    let mkv_ebml_element_parser_mark: Int = 0;
    if mkv_ebml_element_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = ebml_id_header();
    let b: Int = ebml_id_header();
    if a != b {
        println("FAIL ebml_id_header");
        process_exit(1);
    }
    println("prod_mkv_ebml_element_parser: PASSED");
}
