// # Product prove std/sec/sys/enclave_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts enclave_vendor_intel is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/enclave_const.oo.
//
// Beats:
//   1. Call enclave_vendor_intel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_enclave_const: PASSED only if they match.

import "std/sec/sys/enclave_const.oo";

pub fn main() {
    let a = enclave_vendor_intel();
    let b = enclave_vendor_intel();
    if a != b {
        println("FAIL enclave_vendor_intel");
        process_exit(1);
    }
    println("prod_enclave_const: PASSED");
}
