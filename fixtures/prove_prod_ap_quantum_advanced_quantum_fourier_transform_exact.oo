// # Product prove std/quantum_advanced/quantum_fourier_transform_exact.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_advanced/quantum_fourier_transform_exact.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_fourier_transform_exact.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_quantum_fourier_transform_exact: PASSED only if they match.

import "std/quantum_advanced/quantum_fourier_transform_exact.oo";

pub fn main() {
    let quantum_fourier_transform_exact_a = qft_calc_angle(0, 0);
    let quantum_fourier_transform_exact_b = qft_calc_angle(0, 0);
    if quantum_fourier_transform_exact_a != quantum_fourier_transform_exact_b {
        println("FAIL quantum_fourier_transform_exact");
        process_exit(1);
    }
    println("prod_ap_quantum_fourier_transform_exact: PASSED");
}
