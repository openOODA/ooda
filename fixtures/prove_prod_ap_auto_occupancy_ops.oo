// # Product prove std/auto/occupancy_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/occupancy_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_occupancy_ops: PASSED only if they match.

import "std/auto/occupancy_ops.oo";

pub fn main() {
    let occupancy_ops_a = occ_op_new(0, 0);
    let occupancy_ops_b = occ_op_new(0, 0);
    let occupancy_ops_va = occ_op_voxel(occupancy_ops_a);
    let occupancy_ops_vb = occ_op_voxel(occupancy_ops_b);
    if occupancy_ops_va != occupancy_ops_vb {
        println("FAIL occupancy_ops");
        process_exit(1);
    }
    println("prod_ap_occupancy_ops: PASSED");
}
