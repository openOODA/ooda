// # Product prove std/fintech/fpml_trade.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_to_float is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech/fpml_trade.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_fpml_trade: PASSED only if they match.

import "std/fintech/fpml_trade.oo";

pub fn main() {
    let g0_a = int_to_float(0);
    let g0_b = int_to_float(0);
    if g0_a != g0_b {
        println("FAIL int_to_float");
        process_exit(1);
    }
    println("prod_gr_fpml_trade: PASSED");
}
