// # Cross-library typestate send
//
// Logline: Open a library sock, connect it, and send after the Open transition.
//
// Beats:
//   1. Import typestate_lib and open a Closed sock.
//   2. Connect the same handle to Open.
//   3. Send on the Open sock.

import "typestate_lib.oo";

pub fn main() {
    let s = open_sock();
    connect(s);
    send(s);
}
