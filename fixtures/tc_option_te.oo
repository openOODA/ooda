// # Check distinguishes Option T
//
// Logline: Typecheck refuses Option[Int] where Option[String] is required.
//
// Setup: Check must read Option T, not only the word Option.
//
// Beats:
//   1. f returns Option[Int].
//   2. g takes Option[String].
//   3. g(f()) must not typecheck.

pub fn f() -> Option[Int] {
    return Some(1);
}

pub fn g(r: Option[String]) -> Int {
    return 0;
}

pub fn main() {
    let x: Int = g(f());
}
