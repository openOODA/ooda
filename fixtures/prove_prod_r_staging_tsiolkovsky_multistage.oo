// # Product prove std/space_propulsion/staging_tsiolkovsky_multistage.oo
//
// Logline: Fail-closed emit+gcc+run asserts two_stage_spec_default_orbital value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/staging_tsiolkovsky_multistage.oo.
//
// Beats:
//   1. Call two_stage_spec_default_orbital twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_staging_tsiolkovsky_multistage: PASSED only if asserts hold.

import "std/space_propulsion/staging_tsiolkovsky_multistage.oo";

pub fn main() {
    let staging_tsiolkovsky_multistage: TwoStageRocketSpec = two_stage_spec_default_orbital();
    let staging_tsiolkovsky_multistage_b: TwoStageRocketSpec = two_stage_spec_default_orbital();
    if (staging_tsiolkovsky_multistage).payload_mass_kg != 15000.0 {
        println("FAIL two_stage_spec_default_orbital payload_mass_kg");
        process_exit(1);
    }
    if (staging_tsiolkovsky_multistage).payload_mass_kg != (staging_tsiolkovsky_multistage_b).payload_mass_kg {
        println("FAIL two_stage_spec_default_orbital det");
        process_exit(1);
    }
    println("prod_staging_tsiolkovsky_multistage: PASSED");
}
