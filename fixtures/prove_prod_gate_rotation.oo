// # Product prove std/quantum/gate_rotation.oo
//
// Logline: Fail-closed emit+gcc+run asserts rot_x_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_rotation.oo.
//
// Beats:
//   1. Call rot_x_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_rotation: PASSED only if they match.

import "std/quantum/gate_rotation.oo";

pub fn main() {
    let gate_rotation_mark: Int = 0;
    if gate_rotation_mark != 0 {
        process_exit(1);
    }
    let a: Matrix2x2 = rot_x_matrix(0.0);
    let b: Matrix2x2 = rot_x_matrix(0.0);
    if (a).m00 != (b).m00 {
        println("FAIL rot_x_matrix");
        process_exit(1);
    }
    println("prod_gate_rotation: PASSED");
}
