// # Product prove std/formal_verif/wlp_calculus_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts wlp_eval_assign is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/wlp_calculus_evaluator.oo.
//
// Beats:
//   1. Call wlp_eval_assign twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wlp_calculus_evaluator: PASSED only if they match.

import "std/formal_verif/wlp_calculus_evaluator.oo";

pub fn main() {
    let wlp_calculus_evaluator_mark: Int = 0;
    if wlp_calculus_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: String = wlp_eval_assign("x", "x", "x");
    let b: String = wlp_eval_assign("x", "x", "x");
    if a != b {
        println("FAIL wlp_eval_assign");
        process_exit(1);
    }
    println("prod_wlp_calculus_evaluator: PASSED");
}
