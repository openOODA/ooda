// # Product prove std/net/cidr.oo
//
// Logline: Fail-closed emit+gcc+run asserts cidr_to_string is a real value.
//
// Setup: Isolated emit-c. Imports std/net/cidr.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cidr_to_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_cidr: PASSED only if they match.

import "std/net/cidr.oo";

pub fn main() {
    let g2_oa = cidr_new(2, 2, 2, 2, 2);
    let g2_ob = cidr_new(2, 2, 2, 2, 2);
    let g2_a = cidr_to_string(g2_oa);
    let g2_b = cidr_to_string(g2_ob);
    if chars_len(g2_a) != chars_len(g2_b) {
        println("FAIL cidr_to_string");
        process_exit(1);
    }
    if chars_len(g2_a) < 0 {
        println("FAIL cidr_to_string");
        process_exit(1);
    }
    println("prod_g2_cidr: PASSED");
}
