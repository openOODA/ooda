// # Product prove std/astro_advanced/solar_radiation_pressure.oo
//
// Logline: Fail-closed emit+gcc+run asserts srp_w_m2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/solar_radiation_pressure.oo.
//
// Beats:
//   1. Call srp_w_m2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_radiation_pressure: PASSED only if they match.

import "std/astro_advanced/solar_radiation_pressure.oo";

pub fn main() {
    let solar_radiation_pressure_mark: Int = 0;
    if solar_radiation_pressure_mark != 0 {
        process_exit(1);
    }
    let a: Int = srp_w_m2();
    let b: Int = srp_w_m2();
    if a != b {
        println("FAIL srp_w_m2");
        process_exit(1);
    }
    println("prod_solar_radiation_pressure: PASSED");
}
