// # Product prove std/hash/sha3.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/hash/sha3.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/sha3.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sha3: PASSED only if they match.

import "std/hash/sha3.oo";

pub fn main() {
    let sha3_a = sha3_256("x");
    let sha3_b = sha3_256("x");
    if sha3_a.contains(sha3_b) == false {
        println("FAIL sha3");
        process_exit(1);
    }
    if sha3_b.contains(sha3_a) == false {
        println("FAIL sha3");
        process_exit(1);
    }
    println("prod_ap_sha3: PASSED");
}
