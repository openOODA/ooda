// # Product prove std/compilers_vm/wasm_threads_atomic.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_threads_atomic.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_threads_atomic.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_threads_atomic: PASSED only if they match.

import "std/compilers_vm/wasm_threads_atomic.oo";

pub fn main() {
    let wasm_threads_atomic_a = atomic_memory_atomic_notify();
    let wasm_threads_atomic_b = atomic_memory_atomic_notify();
    if wasm_threads_atomic_a != wasm_threads_atomic_b {
        println("FAIL wasm_threads_atomic");
        process_exit(1);
    }
    println("prod_ap_wasm_threads_atomic: PASSED");
}
