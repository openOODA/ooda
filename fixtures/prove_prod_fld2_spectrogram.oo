// # Product prove std/multimedia/spectrogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts spec_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/spectrogram.oo.
//
// Beats:
//   1. Call spec_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spectrogram: PASSED only if they match.

import "std/multimedia/spectrogram.oo";

pub fn main() {
    let spectrogram_mark: Int = 0;
    if spectrogram_mark != 0 {
        process_exit(1);
    }
    let spectrogram_a: Float = spec_pi();
    let spectrogram_b: Float = spec_pi();
    if spectrogram_a != spectrogram_b {
        println("FAIL spec_pi");
        process_exit(1);
    }
    println("prod_spectrogram: PASSED");
}
