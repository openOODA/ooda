// # Product prove std/net_telemetry/eth_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts eth_frame_parse is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/eth_frame.oo.
//
// Beats:
//   1. Call eth_frame_parse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eth_frame: PASSED only if they match.

import "std/net_telemetry/eth_frame.oo";

pub fn main() {
    let a: EthernetFrame = eth_frame_parse(list_new());
    let b: EthernetFrame = eth_frame_parse(list_new());
    if a.ethertype != b.ethertype {
        println("FAIL eth_frame_parse");
        process_exit(1);
    }
    println("prod_eth_frame: PASSED");
}
