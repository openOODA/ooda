// # Product prove std/markup/xml.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/xml.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/xml.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_xml: PASSED only if they match.

import "std/markup/xml.oo";

pub fn main() {
    let xml_a = xml_parse("x");
    let xml_b = xml_parse("x");
    if xml_a.is_ok() != xml_b.is_ok() {
        println("FAIL xml");
        process_exit(1);
    }
    println("prod_ap_xml: PASSED");
}
