// # Product prove std/space_propulsion/rocket_propulsion_isentropic.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/rocket_propulsion_isentropic.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_propulsion_isentropic.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rocket_propulsion_isentropic: PASSED only if they match.

import "std/space_propulsion/rocket_propulsion_isentropic.oo";

pub fn main() {
    let rocket_propulsion_isentropic_a = nozzle_estimate_exit_mach(0.0, 0.0);
    let rocket_propulsion_isentropic_b = nozzle_estimate_exit_mach(0.0, 0.0);
    if rocket_propulsion_isentropic_a != rocket_propulsion_isentropic_b {
        println("FAIL rocket_propulsion_isentropic");
        process_exit(1);
    }
    println("prod_ap_rocket_propulsion_isentropic: PASSED");
}
