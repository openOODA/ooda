// # Product prove std/fhe_lattices/fhe_poly_ntt_arithmetic.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntt_bit_reverse is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_poly_ntt_arithmetic.oo.
//
// Beats:
//   1. Call ntt_bit_reverse twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_poly_ntt_arithmetic: PASSED only if they match.

import "std/fhe_lattices/fhe_poly_ntt_arithmetic.oo";

pub fn main() {
    let fhe_poly_ntt_arithmetic_mark: Int = 0;
    if fhe_poly_ntt_arithmetic_mark != 0 {
        process_exit(1);
    }
    let a: Int = ntt_bit_reverse(0, 0);
    let b: Int = ntt_bit_reverse(0, 0);
    if a != b {
        println("FAIL ntt_bit_reverse");
        process_exit(1);
    }
    println("prod_g2_fhe_poly_ntt_arithmetic: PASSED");
}
