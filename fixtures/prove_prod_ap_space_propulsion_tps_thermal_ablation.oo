// # Product prove std/space_propulsion/tps_thermal_ablation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/space_propulsion/tps_thermal_ablation.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/tps_thermal_ablation.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_tps_thermal_ablation: PASSED only if they match.

import "std/space_propulsion/tps_thermal_ablation.oo";

pub fn main() {
    let tps_thermal_ablation_a = ablator_spec_default_pica();
    let tps_thermal_ablation_b = ablator_spec_default_pica();
    if tps_thermal_ablation_a.virgin_density_kg_m3 != tps_thermal_ablation_b.virgin_density_kg_m3 {
        println("FAIL tps_thermal_ablation");
        process_exit(1);
    }
    println("prod_ap_tps_thermal_ablation: PASSED");
}
