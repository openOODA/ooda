// # Product prove std/space_propulsion/propellant_tank_pressurization.oo
//
// Logline: Fail-closed emit+gcc+run asserts tank_pressurization_spec_default_methalox value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_tank_pressurization.oo.
//
// Beats:
//   1. Call tank_pressurization_spec_default_methalox twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_propellant_tank_pressurization: PASSED only if asserts hold.

import "std/space_propulsion/propellant_tank_pressurization.oo";

pub fn main() {
    let propellant_tank_pressurization: TankPressurizationSpec = tank_pressurization_spec_default_methalox();
    let propellant_tank_pressurization_b: TankPressurizationSpec = tank_pressurization_spec_default_methalox();
    if (propellant_tank_pressurization).pressurant_gas_type != 3 {
        println("FAIL tank_pressurization_spec_default_methalox pressurant_gas_type");
        process_exit(1);
    }
    if (propellant_tank_pressurization).pressurant_gas_type != (propellant_tank_pressurization_b).pressurant_gas_type {
        println("FAIL tank_pressurization_spec_default_methalox det");
        process_exit(1);
    }
    println("prod_propellant_tank_pressurization: PASSED");
}
