// # Seed leftover match Result
//
// Logline: Bind Ok("ok") and match it as a statement so emit-c can print OoResS.
//
// Setup: Tiny Backend-C fixture. No caps. No write_file.
//
// Beats:
//   1. Bind r as Result[String, String] Ok("ok").
//   2. Match Ok(x) and print the payload.
//   3. Match Err(e) and print the error.

pub fn main() {
    let r: Result[String, String] = Ok("ok");
    match r {
        Ok(x) => println(x),
        Err(e) => println(e)
    }
}
