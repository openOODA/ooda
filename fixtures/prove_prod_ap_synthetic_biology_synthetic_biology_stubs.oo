//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_synthetic_biology_stubs: PASSED only if they match.

import "std/synthetic_biology/synthetic_biology_stubs.oo";

pub fn main() {
    let synthetic_biology_stubs_a = synbio_stub_gpu_ssa_throughput_trajectories_per_sec(0);
    let synthetic_biology_stubs_b = synbio_stub_gpu_ssa_throughput_trajectories_per_sec(0);
    if synthetic_biology_stubs_a != synthetic_biology_stubs_b {
        println("FAIL synthetic_biology_stubs");
        process_exit(1);
    }
    println("prod_ap_synthetic_biology_stubs: PASSED");
