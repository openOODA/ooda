// # Product prove std/scicomp/qr_decomp.oo
//
// Logline: Fail-closed emit+gcc+run asserts qr_decomp_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/scicomp/qr_decomp.oo.
//
// Beats:
//   1. Call qr_decomp_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_qr_decomp: PASSED only if it matches.

import "std/scicomp/qr_decomp.oo";

pub fn main() {
    let a: Int = qr_decomp_probe();
    if a != 0 {
        println("FAIL qr_decomp_probe");
        process_exit(1);
    }
    println("prod_nc_qr_decomp: PASSED");
}
