// # Product prove std/embedded_hal/riscv_csr.oo
//
// Logline: Fail-closed emit+gcc+run asserts riscv_csr_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/riscv_csr.oo.
//
// Beats:
//   1. Call riscv_csr_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_riscv_csr: PASSED only if they match.

import "std/embedded_hal/riscv_csr.oo";

pub fn main() {
    let a: RiscvCsrState = riscv_csr_init();
    let b: RiscvCsrState = riscv_csr_init();
    if (a).mstatus != (b).mstatus {
        println("FAIL riscv_csr_init");
        process_exit(1);
    }
    println("prod_riscv_csr: PASSED");
}
