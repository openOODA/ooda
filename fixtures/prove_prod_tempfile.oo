// # Product prove std/fs/tempfile.oo
//
// Logline: Fail-closed emit+gcc+run of tempfile_generate_name.
//
// Setup: Isolated emit-c. Imports std/fs/tempfile.oo.
//
// Beats:
//   1. tempfile_generate_name("x", 1, ".t") length > 4.
//   2. Exit 1 on miss. Print prod_tempfile: PASSED only if it holds.

import "std/fs/tempfile.oo";

pub fn main() {
    let tempfile_a: String = tempfile_generate_name("x", 1, ".t");
    if chars_len(tempfile_a) < 5 {
        println("FAIL tempfile");
        process_exit(1);
    }
    println("prod_tempfile: PASSED");
}
