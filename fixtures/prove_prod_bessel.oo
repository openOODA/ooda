// # Product Bessel prove
//
// Logline: Fail-closed emit+gcc+run of shipped bessel_j0 / bessel_j1.
//
// Setup: Product std/math/special_bessel.oo. J0(0)=1; J1(0)=0.
//
// Beats:
//   1. bessel_j0(0) is 1.0.
//   2. bessel_j1(0) is 0.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/special_bessel.oo";

pub fn main() {
    let j0: Float = bessel_j0(0.0);
    if j0 != 1.0 {
        println("FAIL j0");
        process_exit(1);
    }
    let j1: Float = bessel_j1(0.0);
    if j1 != 0.0 {
        println("FAIL j1");
        process_exit(1);
    }
    println("prod_bessel: PASSED");
}
