// # Product prove std/embedded_hal/embedded_hal_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/embedded_hal_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/embedded_hal_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_embedded_hal_stubs: PASSED only if they match.

import "std/embedded_hal/embedded_hal_stubs.oo";

pub fn main() {
    let embedded_hal_stubs_a = hal_hardware_config_new(0, 0);
    let embedded_hal_stubs_b = hal_hardware_config_new(0, 0);
    if embedded_hal_stubs_a.device_base_addr != embedded_hal_stubs_b.device_base_addr {
        println("FAIL embedded_hal_stubs");
        process_exit(1);
    }
    println("prod_ap_embedded_hal_stubs: PASSED");
}
