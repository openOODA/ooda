// # Product prove std/tda_topology/simplicial_complex_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts simplicial_complex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/simplicial_complex_core.oo.
//
// Beats:
//   1. Call simplicial_complex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simplicial_complex_core: PASSED only if they match.

import "std/tda_topology/simplicial_complex_core.oo";

pub fn main() {
    let simplicial_complex_core_mark: Int = 0;
    if simplicial_complex_core_mark != 0 {
        process_exit(1);
    }
    let simplicial_complex_core_a = simplicial_complex_new(1);
    let simplicial_complex_core_b = simplicial_complex_new(1);
    if (simplicial_complex_core_a).simplex_count != (simplicial_complex_core_b).simplex_count {
        println("FAIL simplicial_complex_new");
        process_exit(1);
    }
    println("prod_simplicial_complex_core: PASSED");
}
