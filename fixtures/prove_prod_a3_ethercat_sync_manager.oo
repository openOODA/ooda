// # Product prove std/iot_scada/ethercat_sync_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts ethercat_sm_mailbox_out is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/ethercat_sync_manager.oo.
//
// Beats:
//   1. Call ethercat_sm_mailbox_out twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ethercat_sync_manager: PASSED only if they match.

import "std/iot_scada/ethercat_sync_manager.oo";

pub fn main() {
    let ethercat_sync_manager_mark: Int = 0;
    if ethercat_sync_manager_mark != 0 {
        process_exit(1);
    }
    let a: EthercatSyncManager = ethercat_sm_mailbox_out(0, 0);
    let b: EthercatSyncManager = ethercat_sm_mailbox_out(0, 0);
    if (a).channel_index != (b).channel_index {
        println("FAIL ethercat_sm_mailbox_out");
        process_exit(1);
    }
    println("prod_ethercat_sync_manager: PASSED");
}
