// # Product sync timer wheel prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/timer_wheel.oo.
//
// Setup: Product std/sync/timer_wheel.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New tick 0 pending 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/timer_wheel.oo";

pub fn main() {
    let tw: TimerWheel = timer_wheel_new(16);
    let t: Int = timer_wheel_current_tick(tw);
    if t != 0 {
        println("FAIL twheel tick");
        process_exit(1);
    }
    let p: Int = timer_wheel_pending_count(tw);
    if p != 0 {
        println("FAIL twheel pending");
        process_exit(1);
    }
    println("prod_twheel: PASSED");
}
