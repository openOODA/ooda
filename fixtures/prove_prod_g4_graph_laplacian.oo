// # Product prove std/graph_gnn/graph_pos_enc_laplacian.oo
//
// Logline: Fail-closed verification that Laplacian positional encoding projection and sign-flip transformations are deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_pos_enc_laplacian.oo.
//
// Beats:
//   1. Construct LapPEConfig and initialize projection weights with deterministic seed.
//   2. Run lap_pe_transform_node on sample raw eigenvector coordinates.
//   3. Assert deterministic return values.
//   4. Print prod_g4_graph_laplacian: PASSED only if all match.

import "std/graph_gnn/graph_pos_enc_laplacian.oo";

pub fn main() {
    let cfg1: LapPEConfig = lap_pe_config_new(4, 3);
    let cfg2: LapPEConfig = lap_pe_config_new(4, 3);
    if cfg1.num_eigenvectors != cfg2.num_eigenvectors {
        println("FAIL lap_pe_config_new num_eigenvectors");
        process_exit(1);
    }
    if cfg1.pe_dim != cfg2.pe_dim {
        println("FAIL lap_pe_config_new pe_dim");
        process_exit(1);
    }

    // 4 * 3 = 12 weights
    let w1: List[Int] = lap_pe_init_weights(12, 55);
    let w2: List[Int] = lap_pe_init_weights(12, 55);

    let mut b1: List[Int] = list_new();
    b1 = list_push(b1, 1);
    b1 = list_push(b1, 2);
    b1 = list_push(b1, 3);
    let mut b2: List[Int] = list_new();
    b2 = list_push(b2, 1);
    b2 = list_push(b2, 2);
    b2 = list_push(b2, 3);

    let mut eigs1: List[Int] = list_new();
    eigs1 = list_push(eigs1, 10);
    eigs1 = list_push(eigs1, 20);
    eigs1 = list_push(eigs1, 30);
    eigs1 = list_push(eigs1, 40);

    let mut eigs2: List[Int] = list_new();
    eigs2 = list_push(eigs2, 10);
    eigs2 = list_push(eigs2, 20);
    eigs2 = list_push(eigs2, 30);
    eigs2 = list_push(eigs2, 40);

    let mut signs1: List[Int] = list_new();
    signs1 = list_push(signs1, 1);
    signs1 = list_push(signs1, 0 - 1);
    signs1 = list_push(signs1, 1);
    signs1 = list_push(signs1, 0 - 1);

    let mut signs2: List[Int] = list_new();
    signs2 = list_push(signs2, 1);
    signs2 = list_push(signs2, 0 - 1);
    signs2 = list_push(signs2, 1);
    signs2 = list_push(signs2, 0 - 1);

    let out1: List[Int] = lap_pe_transform_node(cfg1, w1, b1, eigs1, signs1);
    let out2: List[Int] = lap_pe_transform_node(cfg2, w2, b2, eigs2, signs2);

    let len1: Int = list_len(out1);
    let len2: Int = list_len(out2);
    if len1 != len2 {
        println("FAIL lap_pe_transform_node length mismatch");
        process_exit(1);
    }
    if len1 != 3 {
        println("FAIL lap_pe_transform_node length expected");
        process_exit(1);
    }

    let o0_1: Int = list_get(out1, 0);
    let o0_2: Int = list_get(out2, 0);
    if o0_1 != o0_2 {
        println("FAIL lap_pe o0");
        process_exit(1);
    }

    let o1_1: Int = list_get(out1, 1);
    let o1_2: Int = list_get(out2, 1);
    if o1_1 != o1_2 {
        println("FAIL lap_pe o1");
        process_exit(1);
    }

    println("prod_g4_graph_laplacian: PASSED");
    process_exit(0);
}
