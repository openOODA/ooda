// # Product prove std/os/signal.oo
//
// Logline: Fail-closed emit+gcc+run asserts signal_sighup is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/signal.oo.
//
// Beats:
//   1. Call signal_sighup twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_signal: PASSED only if they match.

import "std/os/signal.oo";

pub fn main() {
    let a = signal_sighup();
    let b = signal_sighup();
    if a != b {
        println("FAIL signal_sighup");
        process_exit(1);
    }
    println("prod_signal: PASSED");
}
