// # Product prove std/cloud_k8s/otel_trace_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts otel_sampler_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/otel_trace_sampler.oo.
//
// Beats:
//   1. Call otel_sampler_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_otel_trace_sampler: PASSED only if they match.

import "std/cloud_k8s/otel_trace_sampler.oo";

pub fn main() {
    let otel_trace_sampler_mark: Int = 0;
    if otel_trace_sampler_mark != 0 {
        process_exit(1);
    }
    let otel_trace_sampler_a = otel_sampler_ratio(1);
    let otel_trace_sampler_b = otel_sampler_ratio(1);
    if (otel_trace_sampler_a).sampler_type != (otel_trace_sampler_b).sampler_type {
        println("FAIL otel_sampler_ratio");
        process_exit(1);
    }
    println("prod_otel_trace_sampler: PASSED");
}
