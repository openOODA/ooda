// # Product prove std/tda_topology/point_cloud_metric_space.oo
//
// Logline: Fail-closed emit+gcc+run asserts point_cloud_centroid is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/point_cloud_metric_space.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call point_cloud_centroid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_point_cloud_metric_space: PASSED only if they match.

import "std/tda_topology/point_cloud_metric_space.oo";

pub fn main() {
    let g0_oa = point_cloud_new(0);
    let g0_ob = point_cloud_new(0);
    let g0_la = point_cloud_centroid(&g0_oa);
    let g0_lb = point_cloud_centroid(&g0_ob);
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL point_cloud_centroid");
        process_exit(1);
    }
    println("prod_gr_point_cloud_metric_space: PASSED");
}
