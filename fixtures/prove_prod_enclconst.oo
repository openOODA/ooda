import "std/sec/sys/enclave_const.oo";

pub fn main() {
    let a: Int = enclave_vendor_intel();
    if a != 1 {
        println("FAIL encl intel");
        process_exit(1);
    }
    let b: Int = enclave_attr_debug();
    if b != 1 {
        println("FAIL encl debug");
        process_exit(1);
    }
    let c: Int = enclave_attr_kss();
    if c != 16 {
        println("FAIL encl kss");
        process_exit(1);
    }
    println("prod_enclconst: PASSED");
}
