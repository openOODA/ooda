// # Product prove std/astrophysics_relativity/gr_kerr_newman_spacetime.oo
//
// Logline: Fail-closed emit+gcc+run asserts kerr_newman_evaluate is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_kerr_newman_spacetime.oo.
//
// Beats:
//   1. Call kerr_newman_evaluate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_kerr_newman_spacetime: PASSED only if they match.

import "std/astrophysics_relativity/gr_kerr_newman_spacetime.oo";

pub fn main() {
    let gr_kerr_newman_spacetime_mark: Int = 0;
    if gr_kerr_newman_spacetime_mark != 0 {
        process_exit(1);
    }
    let a: KerrNewmanGeometry = kerr_newman_evaluate(0, 0, 0, 0, 0);
    let b: KerrNewmanGeometry = kerr_newman_evaluate(0, 0, 0, 0, 0);
    if (a).mass != (b).mass {
        println("FAIL kerr_newman_evaluate");
        process_exit(1);
    }
    println("prod_gr_kerr_newman_spacetime: PASSED");
}
