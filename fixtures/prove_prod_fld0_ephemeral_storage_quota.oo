// # Product prove std/cloud_faas/ephemeral_storage_quota.oo
//
// Logline: Fail-closed emit+gcc+run asserts ephemeral_storage_quota_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/ephemeral_storage_quota.oo.
//
// Beats:
//   1. Call ephemeral_storage_quota_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ephemeral_storage_quota: PASSED only if they match.

import "std/cloud_faas/ephemeral_storage_quota.oo";

pub fn main() {
    let ephemeral_storage_quota_mark: Int = 0;
    if ephemeral_storage_quota_mark != 0 {
        process_exit(1);
    }
    let ephemeral_storage_quota_a: EphemeralStorageQuota = ephemeral_storage_quota_new("x", 1);
    let ephemeral_storage_quota_b: EphemeralStorageQuota = ephemeral_storage_quota_new("x", 1);
    if (ephemeral_storage_quota_a).max_quota_mb != (ephemeral_storage_quota_b).max_quota_mb {
        println("FAIL ephemeral_storage_quota_new");
        process_exit(1);
    }
    println("prod_ephemeral_storage_quota: PASSED");
}
