// # Product prove std/bio_advanced/sequence_entropy_profile.oo
//
// Logline: Fail-closed emit+gcc+run asserts entropy_log2 real value.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_entropy_profile.oo.
//
// Beats:
//   1. Call entropy_log2 with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_sequence_entropy_profile: PASSED only if the assert holds.

import "std/bio_advanced/sequence_entropy_profile.oo";

pub fn main() {
    let sequence_entropy_profile_mark: Int = 0;
    if sequence_entropy_profile_mark != 0 {
        process_exit(1);
    }
    let sequence_entropy_profile_n: Float = entropy_log2(0.0);
    if !(sequence_entropy_profile_n == -13.2877) {
        println("FAIL entropy_log2");
        process_exit(1);
    }
    println("prod_sequence_entropy_profile: PASSED");
}
