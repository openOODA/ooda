// # Product 2x2 eigen prove
//
// Logline: Fail-closed emit+gcc+run of shipped matrix_eigen_2x2_solve.
//
// Setup: Product std/math/matrix_eigen_2x2.oo. Closed-form characteristic roots.
//
// Beats:
//   1. Identity (1,0,0,1) eigenvalues are 1 and 1.
//   2. Diagonal (2,0,0,3) eigenvalues are 3 and 2.
//   3. Exit 1 before PASSED on a miss.

import "std/math/matrix_eigen_2x2.oo";

pub fn main() {
    let id: Eigen2x2 = matrix_eigen_2x2_solve(1.0, 0.0, 0.0, 1.0);
    let i1: Float = id.lambda1;
    let i2: Float = id.lambda2;
    if i1 != 1.0 {
        println("FAIL eigen id l1");
        process_exit(1);
    }
    if i2 != 1.0 {
        println("FAIL eigen id l2");
        process_exit(1);
    }
    let d: Eigen2x2 = matrix_eigen_2x2_solve(2.0, 0.0, 0.0, 3.0);
    let l1: Float = d.lambda1;
    let l2: Float = d.lambda2;
    if l1 != 3.0 {
        println("FAIL eigen diag l1");
        process_exit(1);
    }
    if l2 != 2.0 {
        println("FAIL eigen diag l2");
        process_exit(1);
    }
    println("prod_eigen: PASSED");
}
