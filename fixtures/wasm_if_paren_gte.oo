// # Const if (2 >= 1) println
//
// Logline: Print pgte-then when the condition is (2 >= 1).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (2 >= 1) print pgte-then else print pgte-else.
//   3. Leave no other statements.

pub fn main() {
    if (2 >= 1) {
        println("pgte-then");
    } else {
        println("pgte-else");
    }
}
