// # Product prove std/auto/behavior_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/behavior_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_behavior_types: PASSED only if they match.

import "std/auto/behavior_types.oo";

pub fn main() {
    let behavior_types_a = behavior_types_marker();
    let behavior_types_b = behavior_types_marker();
    if behavior_types_a != behavior_types_b {
        println("FAIL behavior_types");
        process_exit(1);
    }
    println("prod_ap_behavior_types: PASSED");
}
