// # Product prove std/3d/xr.oo
//
// Logline: Fail-closed verification that XR facade poses, views, and session lifecycles are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/xr.oo.
//
// Beats:
//   1. Call XR pose, view, session, and frame constructors.
//   2. Assert deterministic structural properties across repeated calls.
//   3. Print prod_g4_3d_xr: PASSED and exit 0.

import "std/3d/xr.oo";

pub fn main() {
    let xr_mark: Int = 0;
    if xr_mark != 0 {
        process_exit(1);
    }

    let p_a: XrPose = shim_marker_pose_identity();
    let p_b: XrPose = shim_marker_pose_identity();
    if (p_a).x != (p_b).x || (p_a).y != (p_b).y || (p_a).z != (p_b).z || (p_a).x != 0 {
        println("FAIL shim_marker_pose_identity");
        process_exit(1);
    }

    let sess: XrSession = shim_marker_session_new();
    if (sess).id != 0 || (sess).active != 1 || (sess).fov != 90000 {
        println("FAIL shim_marker_session_new");
        process_exit(1);
    }

    let view: XrView = shim_marker_view_new(p_a);
    if (view).fov != 90000 || (view).eye_index != 0 {
        println("FAIL shim_marker_view_new");
        process_exit(1);
    }

    let frame: XrFrame = shim_marker_frame_new(sess, p_a);
    if (frame).session_id != 0 || (frame).view_count != 0 {
        println("FAIL shim_marker_frame_new");
        process_exit(1);
    }

    let mark_t: Int = xr_types_facade();
    let mark_o: Int = xr_ops_marker();
    let mark_x: Int = xr_marker();
    if mark_t != 1 || mark_o != 1 || mark_x != 1 {
        println("FAIL xr markers");
        process_exit(1);
    }

    println("prod_g4_3d_xr: PASSED");
    process_exit(0);
}
