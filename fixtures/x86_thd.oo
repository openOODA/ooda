// # emit-x86 three-arg SysV rdx call
//
// Logline: Call thd on xx, yy, and hi and print the third arg so emit-x86 must lea %rdx then call.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No const-fold.
//
// Beats:
//   1. Declare three-arg String passthrough of the third param.
//   2. Print thd("xx", "yy", "hi").
//   3. Expect hi from a real call.

fn thd(a: String, b: String, c: String) -> String {
    return c;
}

pub fn main() {
    println(thd("xx", "yy", "hi"));
}
