// # Product prove std/fintech/greeks_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts greeks_calc_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech/greeks_calc.oo.
//
// Beats:
//   1. Call greeks_calc_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_greeks_calc: PASSED only if they match.

import "std/fintech/greeks_calc.oo";

pub fn main() {
    let a = greeks_calc_probe();
    let b = greeks_calc_probe();
    if a != b {
        println("FAIL greeks_calc_probe");
        process_exit(1);
    }
    println("prod_greeks_calc: PASSED");
}
