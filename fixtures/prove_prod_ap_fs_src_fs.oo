// # Product prove std/fs/src_fs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fs/src_fs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fs/src_fs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_src_fs: PASSED only if they match.

import "std/fs/src_fs.oo";

pub fn main() {
    let src_fs_a = rx000_k();
    let src_fs_b = rx000_k();
    if src_fs_a != src_fs_b {
        println("FAIL src_fs");
        process_exit(1);
    }
    println("prod_ap_src_fs: PASSED");
}
