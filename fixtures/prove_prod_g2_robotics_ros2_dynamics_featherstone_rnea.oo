// # Product prove std/robotics_ros2/dynamics_featherstone_rnea.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_vec_zero is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/dynamics_featherstone_rnea.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call spatial_vec_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dynamics_featherstone_rnea: PASSED only if they match.

import "std/robotics_ros2/dynamics_featherstone_rnea.oo";

pub fn main() {
    let g2_oa: SpatialVector6D = spatial_vec_zero();
    let g2_ob: SpatialVector6D = spatial_vec_zero();
    let g2_a = (g2_oa).wx;
    let g2_b = (g2_ob).wx;
    if g2_a != g2_b {
        println("FAIL spatial_vec_zero.wx");
        process_exit(1);
    }
    println("prod_g2_dynamics_featherstone_rnea: PASSED");
}
