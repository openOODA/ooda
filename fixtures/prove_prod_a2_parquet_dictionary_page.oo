// # Product prove std/db_columnar/parquet_dictionary_page.oo
//
// Logline: Fail-closed emit+gcc+run asserts dictionary_table_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_dictionary_page.oo.
//
// Beats:
//   1. Call dictionary_table_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_parquet_dictionary_page: PASSED only if they match.

import "std/db_columnar/parquet_dictionary_page.oo";

pub fn main() {
    let parquet_dictionary_page_mark: Int = 0;
    if parquet_dictionary_page_mark != 0 {
        process_exit(1);
    }
    let a: DictionaryTable = dictionary_table_new();
    let b: DictionaryTable = dictionary_table_new();
    if (a).entry_count != (b).entry_count {
        println("FAIL dictionary_table_new");
        process_exit(1);
    }
    println("prod_parquet_dictionary_page: PASSED");
}
