// # Product prove std/security_defense/vm_environment_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts hypervisor_signature_match is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/vm_environment_detector.oo.
//
// Beats:
//   1. Call hypervisor_signature_match twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vm_environment_detector: PASSED only if they match.

import "std/security_defense/vm_environment_detector.oo";

pub fn main() {
    let vm_environment_detector_mark: Int = 0;
    if vm_environment_detector_mark != 0 {
        process_exit(1);
    }
    let a: String = hypervisor_signature_match("x");
    let b: String = hypervisor_signature_match("x");
    if a != b {
        println("FAIL hypervisor_signature_match");
        process_exit(1);
    }
    println("prod_vm_environment_detector: PASSED");
}
