// # Product prove std/ai_ml/loss_cross_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts categorical cross-entropy loss operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/loss_cross_entropy.oo.
//
// Beats:
//   1. Construct logits and target class vectors.
//   2. Call loss_cross_entropy_single, loss_cross_entropy_smoothed, and loss_cross_entropy_grad.
//   3. Assert deterministic return values and gradients.
//   4. Print prod_g4_aiml_loss_cross_entropy: PASSED only if all match.

import "std/ai_ml/loss_cross_entropy.oo";

pub fn main() {
    let mut l_data: List[Float] = list_new();
    l_data = list_push(l_data, 1.0);
    l_data = list_push(l_data, 2.0);
    l_data = list_push(l_data, 0.5);
    let logits: Tensor1D = Tensor1D { data: l_data, size: 3 };

    let loss_a: Float = loss_cross_entropy_single(logits, 1);
    let loss_b: Float = loss_cross_entropy_single(logits, 1);
    if loss_a != loss_b {
        println("FAIL loss_cross_entropy_single");
        process_exit(1);
    }

    let loss_sm_a: Float = loss_cross_entropy_smoothed(logits, 1, 0.1);
    let loss_sm_b: Float = loss_cross_entropy_smoothed(logits, 1, 0.1);
    if loss_sm_a != loss_sm_b {
        println("FAIL loss_cross_entropy_smoothed");
        process_exit(1);
    }

    let grad: Tensor1D = loss_cross_entropy_grad(logits, 1);
    if (grad).size != 3 {
        println("FAIL loss_cross_entropy_grad size");
        process_exit(1);
    }

    println("prod_g4_aiml_loss_cross_entropy: PASSED");
    process_exit(0);
}
