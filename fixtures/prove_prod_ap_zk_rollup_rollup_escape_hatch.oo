// # Product prove std/zk_rollup/rollup_escape_hatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_escape_hatch.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_escape_hatch.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_rollup_escape_hatch: PASSED only if they match.

import "std/zk_rollup/rollup_escape_hatch.oo";

pub fn main() {
    let rollup_escape_hatch_a = escape_hatch_init(0);
    let rollup_escape_hatch_b = escape_hatch_init(0);
    if rollup_escape_hatch_a.is_active != rollup_escape_hatch_b.is_active {
        println("FAIL rollup_escape_hatch");
        process_exit(1);
    }
    println("prod_ap_rollup_escape_hatch: PASSED");
}
