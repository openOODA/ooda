// # Product prove std/formal_verif/separation_logic_bi_abduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts separation_logic_bi_abduction_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/formal_verif/separation_logic_bi_abduction.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call separation_logic_bi_abduction_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_separation_logic_bi_abduction: PASSED only if they match.

import "std/formal_verif/separation_logic_bi_abduction.oo";

pub fn main() {
    let g2_a = separation_logic_bi_abduction_probe();
    let g2_b = separation_logic_bi_abduction_probe();
    if g2_a != g2_b {
        println("FAIL separation_logic_bi_abduction_probe");
        process_exit(1);
    }
    println("prod_g2_separation_logic_bi_abduction: PASSED");
}
