//   3. Print prod_ap_diffusion_ddpm_scheduler: PASSED only if they match.

import "std/ai_multimodal/diffusion_ddpm_scheduler.oo";

pub fn main() {
    let diffusion_ddpm_scheduler_a = ddpm_beta_at(0, 0, 0, 0);
    let diffusion_ddpm_scheduler_b = ddpm_beta_at(0, 0, 0, 0);
    if diffusion_ddpm_scheduler_a != diffusion_ddpm_scheduler_b {
        println("FAIL diffusion_ddpm_scheduler");
        process_exit(1);
    }
    println("prod_ap_diffusion_ddpm_scheduler: PASSED");
