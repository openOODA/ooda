// # Product prove std/defi_derivatives/liquidation_flash_liquidator.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_liquidator_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/liquidation_flash_liquidator.oo.
//
// Beats:
//   1. Call flash_liquidator_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_liquidation_flash_liquidator: PASSED only if they match.

import "std/defi_derivatives/liquidation_flash_liquidator.oo";

pub fn main() {
    let liquidation_flash_liquidator_mark: Int = 0;
    if liquidation_flash_liquidator_mark != 0 {
        process_exit(1);
    }
    let a: FlashLiquidatorParams = flash_liquidator_params_default();
    let b: FlashLiquidatorParams = flash_liquidator_params_default();
    if (a).flash_loan_fee_rate != (b).flash_loan_fee_rate {
        println("FAIL flash_liquidator_params_default");
        process_exit(1);
    }
    println("prod_liquidation_flash_liquidator: PASSED");
}
