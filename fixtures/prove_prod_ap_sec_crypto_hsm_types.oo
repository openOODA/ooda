// # Product prove std/sec/crypto/hsm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/hsm_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hsm_types: PASSED only if they match.

import "std/sec/crypto/hsm_types.oo";

pub fn main() {
    let hsm_types_a = hsm_handle_new(0, 0, 0);
    let hsm_types_b = hsm_handle_new(0, 0, 0);
    let hsm_types_va = hsm_handle_id(hsm_types_a);
    let hsm_types_vb = hsm_handle_id(hsm_types_b);
    if hsm_types_va != hsm_types_vb {
        println("FAIL hsm_types");
        process_exit(1);
    }
    println("prod_ap_hsm_types: PASSED");
}
