// # Product prove std/telecom_6g/zero_energy_ambient_backscatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts zero_energy_tag_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/zero_energy_ambient_backscatter.oo.
//
// Beats:
//   1. Call zero_energy_tag_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zero_energy_ambient_backscatter: PASSED only if they match.

import "std/telecom_6g/zero_energy_ambient_backscatter.oo";

pub fn main() {
    let zero_energy_ambient_backscatter_mark: Int = 0;
    if zero_energy_ambient_backscatter_mark != 0 {
        process_exit(1);
    }
    let a: AmbientBackscatterTagConfig = zero_energy_tag_config_default();
    let b: AmbientBackscatterTagConfig = zero_energy_tag_config_default();
    if (a).antenna_aperture_cm2 != (b).antenna_aperture_cm2 {
        println("FAIL zero_energy_tag_config_default");
        process_exit(1);
    }
    println("prod_g2_zero_energy_ambient_backscatter: PASSED");
}
