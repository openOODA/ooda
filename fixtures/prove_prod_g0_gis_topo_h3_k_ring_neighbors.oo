// # Product prove std/gis_topo/h3_k_ring_neighbors.oo
//
// Logline: Fail-closed emit+gcc+run asserts h3_k_ring_size is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/h3_k_ring_neighbors.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call h3_k_ring_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_h3_k_ring_neighbors: PASSED only if they match.

import "std/gis_topo/h3_k_ring_neighbors.oo";

pub fn main() {
    let g0_a = h3_k_ring_size(2);
    let g0_b = h3_k_ring_size(2);
    if g0_a != g0_b {
        println("FAIL h3_k_ring_size");
        process_exit(1);
    }
    println("prod_g0_h3_k_ring_neighbors: PASSED");
}
