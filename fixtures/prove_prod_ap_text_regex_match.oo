// # Product prove std/text/regex_match.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/text/regex_match.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/text/regex_match.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_regex_match: PASSED only if they match.

import "std/text/regex_match.oo";

pub fn main() {
    let regex_match_a = match_count_occurrences("x", "x");
    let regex_match_b = match_count_occurrences("x", "x");
    if regex_match_a != regex_match_b {
        println("FAIL regex_match");
        process_exit(1);
    }
    println("prod_ap_regex_match: PASSED");
}
