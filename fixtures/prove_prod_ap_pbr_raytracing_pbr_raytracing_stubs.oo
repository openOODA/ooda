// # Product prove std/pbr_raytracing/pbr_raytracing_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pbr_raytracing/pbr_raytracing_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pbr_raytracing_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pbr_raytracing_stubs: PASSED only if they match.

import "std/pbr_raytracing/pbr_raytracing_stubs.oo";

pub fn main() {
    let pbr_raytracing_stubs_a = raytracing_capabilities_default();
    let pbr_raytracing_stubs_b = raytracing_capabilities_default();
    if pbr_raytracing_stubs_a.max_bvh_depth != pbr_raytracing_stubs_b.max_bvh_depth {
        println("FAIL pbr_raytracing_stubs");
        process_exit(1);
    }
    println("prod_ap_pbr_raytracing_stubs: PASSED");
}
