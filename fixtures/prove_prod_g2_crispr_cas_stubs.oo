// # Product prove std/crispr_cas/crispr_cas_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts crispr_stub_gpu_cfd_matrix_time_ms is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/crispr_cas_stubs.oo.
//
// Beats:
//   1. Call crispr_stub_gpu_cfd_matrix_time_ms twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_cas_stubs: PASSED only if they match.

import "std/crispr_cas/crispr_cas_stubs.oo";

pub fn main() {
    let crispr_cas_stubs_mark: Int = 0;
    if crispr_cas_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Float = crispr_stub_gpu_cfd_matrix_time_ms(0, 0);
    let b: Float = crispr_stub_gpu_cfd_matrix_time_ms(0, 0);
    if a != b {
        println("FAIL crispr_stub_gpu_cfd_matrix_time_ms");
        process_exit(1);
    }
    println("prod_g2_crispr_cas_stubs: PASSED");
}
