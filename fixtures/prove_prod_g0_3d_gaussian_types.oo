// # Product prove std/3d/gaussian_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian3d_opacity is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call gaussian3d_opacity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_gaussian_types: PASSED only if they match.

import "std/3d/gaussian_types.oo";

pub fn main() {
    let g0_oa = gaussian3d_new(2, 2, 2, 2);
    let g0_ob = gaussian3d_new(2, 2, 2, 2);
    let g0_a = gaussian3d_opacity(g0_oa);
    let g0_b = gaussian3d_opacity(g0_ob);
    if g0_a != g0_b {
        println("FAIL gaussian3d_opacity");
        process_exit(1);
    }
    println("prod_g0_gaussian_types: PASSED");
}
