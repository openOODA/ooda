// # Product prove std/astro_advanced/aerobraking_drag_pass.oo
//
// Logline: Fail-closed emit+gcc+run asserts aero_drag_cd is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/aerobraking_drag_pass.oo.
//
// Beats:
//   1. Call aero_drag_cd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aerobraking_drag_pass: PASSED only if they match.

import "std/astro_advanced/aerobraking_drag_pass.oo";

pub fn main() {
    let a = aero_drag_cd();
    let b = aero_drag_cd();
    if a != b {
        println("FAIL aero_drag_cd");
        process_exit(1);
    }
    println("prod_aerobraking_drag_pass: PASSED");
}
