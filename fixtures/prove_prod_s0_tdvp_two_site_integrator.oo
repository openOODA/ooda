// # Product prove std/quantum_tensor_nets/tdvp_two_site_integrator.oo
//
// Logline: Fail-closed emit+gcc+run asserts tdvp_two_site_config_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tdvp_two_site_integrator.oo.
//
// Beats:
//   1. Call tdvp_two_site_config_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_tdvp_two_site_integrator: PASSED only if asserts hold.

import "std/quantum_tensor_nets/tdvp_two_site_integrator.oo";

pub fn main() {
    let tdvp_two_site_integrator_a: TdvpTwoSiteConfig = tdvp_two_site_config_default(0, 1.0, 1.0);
    let tdvp_two_site_integrator_b: TdvpTwoSiteConfig = tdvp_two_site_config_default(0, 1.0, 1.0);
    if tdvp_two_site_integrator_a.num_sites != tdvp_two_site_integrator_b.num_sites {
        println("FAIL tdvp_two_site_config_default");
        process_exit(1);
    }
    println("prod_tdvp_two_site_integrator: PASSED");
}
