// # Product prove std/synthetic_biology/repressilator_oscillator_ode.oo
//
// Logline: Fail-closed emit+gcc+run asserts repr_pow real value.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/repressilator_oscillator_ode.oo.
//
// Beats:
//   1. Call repr_pow with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_repressilator_oscillator_ode: PASSED only if the assert holds.

import "std/synthetic_biology/repressilator_oscillator_ode.oo";

pub fn main() {
    let repressilator_oscillator_ode_mark: Int = 0;
    if repressilator_oscillator_ode_mark != 0 {
        process_exit(1);
    }
    let repressilator_oscillator_ode_n: Float = repr_pow(0.0, 0);
    if !(repressilator_oscillator_ode_n == 1.0) {
        println("FAIL repr_pow");
        process_exit(1);
    }
    println("prod_repressilator_oscillator_ode: PASSED");
}
