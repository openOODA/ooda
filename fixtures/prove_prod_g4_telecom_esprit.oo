// # Product prove std/telecom_6g/isac_esprit_direction_finding.oo
//
// Logline: Fail-closed verification that ESPRIT array configurations and DOA angle estimation are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/isac_esprit_direction_finding.oo.
//
// Beats:
//   1. Construct default 16-element ESPRIT array configuration.
//   2. Estimate spatial arrival angle for broadside and oblique phases.
//   3. Assert deterministic return values.
//   4. Print prod_g4_telecom_esprit: PASSED and exit 0.

import "std/telecom_6g/isac_esprit_direction_finding.oo";

pub fn main() {
    let cfg_a: EspritArrayConfig = esprit_config_default_16ant();
    let cfg_b: EspritArrayConfig = esprit_config_default_16ant();

    if (cfg_a).num_total_elements != (cfg_b).num_total_elements || (cfg_a).num_total_elements != 16 {
        println("FAIL esprit_config_default_16ant num_total_elements");
        process_exit(1);
    }

    if (cfg_a).carrier_frequency_ghz != (cfg_b).carrier_frequency_ghz || (cfg_a).carrier_frequency_ghz != 140.0 {
        println("FAIL esprit_config_default_16ant carrier_frequency_ghz");
        process_exit(1);
    }

    let src0_a: EspritEstimatedSource = esprit_solve_angle(0.0, cfg_a);
    let src0_b: EspritEstimatedSource = esprit_solve_angle(0.0, cfg_b);
    if (src0_a).estimated_angle_deg != (src0_b).estimated_angle_deg || (src0_a).estimated_angle_deg != 0.0 {
        println("FAIL esprit_solve_angle broadside");
        process_exit(1);
    }

    let src1_a: EspritEstimatedSource = esprit_solve_angle(0.5, cfg_a);
    let src1_b: EspritEstimatedSource = esprit_solve_angle(0.5, cfg_b);
    if (src1_a).estimated_angle_rad != (src1_b).estimated_angle_rad {
        println("FAIL esprit_solve_angle estimated_angle_rad");
        process_exit(1);
    }
    if (src1_a).estimated_angle_deg != (src1_b).estimated_angle_deg {
        println("FAIL esprit_solve_angle estimated_angle_deg");
        process_exit(1);
    }

    println("prod_g4_telecom_esprit: PASSED");
    process_exit(0);
}
