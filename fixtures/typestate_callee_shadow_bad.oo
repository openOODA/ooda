// # Callee shadows the sock
//
// Logline: wrap shadows its Closed parameter with a new open_sock and never opens the original.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap rebinds s to a new sock.
//   3. The caller's sock stays Closed.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }

fn wrap(s: Int) {
    let s = open_sock();
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
