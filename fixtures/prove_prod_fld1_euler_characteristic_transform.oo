// # Product prove std/tda_topology/euler_characteristic_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts ect_vertex_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/euler_characteristic_transform.oo.
//
// Beats:
//   1. Call ect_vertex_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_euler_characteristic_transform: PASSED only if they match.

import "std/tda_topology/euler_characteristic_transform.oo";

pub fn main() {
    let euler_characteristic_transform_mark: Int = 0;
    if euler_characteristic_transform_mark != 0 {
        process_exit(1);
    }
    let euler_characteristic_transform_a = ect_vertex_new(1, 1.0, 1.0);
    let euler_characteristic_transform_b = ect_vertex_new(1, 1.0, 1.0);
    if (euler_characteristic_transform_a).id != (euler_characteristic_transform_b).id {
        println("FAIL ect_vertex_new");
        process_exit(1);
    }
    println("prod_euler_characteristic_transform: PASSED");
}
