// # Product prove std/protein_folding/folding_markov_state_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts msm_check_detailed_balance is a real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_markov_state_model.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call msm_check_detailed_balance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_folding_markov_state_model: PASSED only if they match.

import "std/protein_folding/folding_markov_state_model.oo";

pub fn main() {
    let g0_a = msm_check_detailed_balance(1.0, 1.0, 1.0, 1.0);
    let g0_b = msm_check_detailed_balance(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL msm_check_detailed_balance");
        process_exit(1);
    }
    println("prod_g0_folding_markov_state_model: PASSED");
}
