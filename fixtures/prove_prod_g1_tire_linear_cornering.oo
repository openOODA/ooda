// # Product prove std/auto_mpc_control/tire_linear_cornering.oo
//
// Logline: Fail-closed emit+gcc+run asserts linear_tire_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_linear_cornering.oo.
//
// Beats:
//   1. Call linear_tire_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tire_linear_cornering: PASSED only if they match.

import "std/auto_mpc_control/tire_linear_cornering.oo";

pub fn main() {
    let a: LinearTireParams = linear_tire_params_default();
    let b: LinearTireParams = linear_tire_params_default();
    if a.nominal_stiff != b.nominal_stiff {
        println("FAIL linear_tire_params_default");
        process_exit(1);
    }
    println("prod_tire_linear_cornering: PASSED");
}
