// # Product prove std/web_ecosystem/form_data_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts form_data_encode_n is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/form_data_parser.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call form_data_encode_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_form_data_parser: PASSED only if they match.

import "std/web_ecosystem/form_data_parser.oo";

pub fn main() {
    let g0_a = form_data_encode_n(2);
    let g0_b = form_data_encode_n(2);
    if g0_a != g0_b {
        println("FAIL form_data_encode_n");
        process_exit(1);
    }
    println("prod_g0_form_data_parser: PASSED");
}
