// # Product net URL prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/net/url.oo default ports and query param.
//
// Setup: Tree oodac emit-c. Calls ooda/std/net/url.oo. Destub none. No network.
//
// Beats:
//   1. url_default_port("https") is 443.
//   2. url_default_port("http") is 80.
//   3. url_get_param("a=1&b=2","b") is 2.
//   4. url_is_https(url_new("https","h",0,"/")) is true.
//   5. Exit 1 on any miss. Print prod_neturl: PASSED only if all hold.

import "std/net/url.oo";

pub fn main() {
    let hs: Int = url_default_port("https");
    if hs != 443 {
        println("FAIL url https port");
        process_exit(1);
    }
    let ht: Int = url_default_port("http");
    if ht != 80 {
        println("FAIL url http port");
        process_exit(1);
    }
    let b: String = url_get_param("a=1&b=2", "b");
    if b != "2" {
        println("FAIL url get_param");
        process_exit(1);
    }
    let u: ParsedUrl = url_new("https", "h", 0, "/");
    if !url_is_https(u) {
        println("FAIL url_is_https");
        process_exit(1);
    }
    println("prod_neturl: PASSED");
}
