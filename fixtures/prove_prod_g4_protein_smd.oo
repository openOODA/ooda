// # Product prove std/protein_folding/md_steered_molecular_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts steered molecular dynamics target, force, work, and state calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_steered_molecular_dynamics.oo.
//
// Beats:
//   1. Calculate moving spring target position with smd_calc_target_pos.
//   2. Compute steering force with smd_calc_pulling_force.
//   3. Compute incremental mechanical work with smd_step_work.
//   4. Evaluate full pulling state with smd_evaluate_state.
//   5. Print prod_g4_protein_smd: PASSED and exit 0.

import "std/protein_folding/md_steered_molecular_dynamics.oo";

pub fn main() {
    let proto: SmdProtocol = SmdProtocol {
        pulling_velocity_a_per_ps: 0.1,
        spring_constant_k: 10.0,
        initial_distance_a: 5.0,
        temperature_k: 300.0,
    };

    let target_pos: Float = smd_calc_target_pos(&proto, 10.0);
    if target_pos < 5.99 || target_pos > 6.01 {
        println("FAIL smd_calc_target_pos");
        process_exit(1);
    }

    let force: Float = smd_calc_pulling_force(&proto, 5.5, target_pos);
    if force < 4.99 || force > 5.01 {
        println("FAIL smd_calc_pulling_force");
        process_exit(1);
    }

    let d_work: Float = smd_step_work(4.0, 6.0, 0.1);
    if d_work < 0.49 || d_work > 0.51 {
        println("FAIL smd_step_work");
        process_exit(1);
    }

    let state1: PullingState = smd_evaluate_state(&proto, 10.0, 5.5, 1.25);
    let state2: PullingState = smd_evaluate_state(&proto, 10.0, 5.5, 1.25);

    if (state1).time_ps != (state2).time_ps || (state1).target_distance_a != (state2).target_distance_a {
        println("FAIL smd_evaluate_state consistency");
        process_exit(1);
    }
    if (state1).pulling_force_kcal_per_a < 4.99 || (state1).pulling_force_kcal_per_a > 5.01 {
        println("FAIL smd_evaluate_state force");
        process_exit(1);
    }
    if (state1).cumulative_work_kcal < 1.24 || (state1).cumulative_work_kcal > 1.26 {
        println("FAIL smd_evaluate_state work");
        process_exit(1);
    }

    println("prod_g4_protein_smd: PASSED");
    process_exit(0);
}
