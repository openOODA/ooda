// # Product prove std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo
//
// Logline: Fail-closed emit+gcc+run asserts score_tuning_candidate is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call score_tuning_candidate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_unroll_factor_tuner: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_unroll_factor_tuner.oo";

pub fn main() {
    let g2_oa = tuning_candidate_new(2, 2, 2, 2, 2, 2);
    let g2_ob = tuning_candidate_new(2, 2, 2, 2, 2, 2);
    let g2_a = score_tuning_candidate(g2_oa);
    let g2_b = score_tuning_candidate(g2_ob);
    if g2_a != g2_b {
        println("FAIL score_tuning_candidate");
        process_exit(1);
    }
    println("prod_g2_polyhedral_unroll_factor_tuner: PASSED");
}
