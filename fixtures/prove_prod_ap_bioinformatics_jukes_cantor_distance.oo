// # Product prove std/bioinformatics/jukes_cantor_distance.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/jukes_cantor_distance.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/jukes_cantor_distance.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_jukes_cantor_distance: PASSED only if they match.

import "std/bioinformatics/jukes_cantor_distance.oo";

pub fn main() {
    let jukes_cantor_distance_a = jukes_cantor_distance_x1000(0);
    let jukes_cantor_distance_b = jukes_cantor_distance_x1000(0);
    if jukes_cantor_distance_a != jukes_cantor_distance_b {
        println("FAIL jukes_cantor_distance");
        process_exit(1);
    }
    println("prod_ap_jukes_cantor_distance: PASSED");
}
