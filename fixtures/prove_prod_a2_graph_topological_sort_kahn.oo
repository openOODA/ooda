// # Product prove std/db_graph/graph_topological_sort_kahn.oo
//
// Logline: Fail-closed emit+gcc+run asserts topo_sort_result_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_topological_sort_kahn.oo.
//
// Beats:
//   1. Call topo_sort_result_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_topological_sort_kahn: PASSED only if they match.

import "std/db_graph/graph_topological_sort_kahn.oo";

pub fn main() {
    let graph_topological_sort_kahn_mark: Int = 0;
    if graph_topological_sort_kahn_mark != 0 {
        process_exit(1);
    }
    let a: TopoSortResult = topo_sort_result_new();
    let b: TopoSortResult = topo_sort_result_new();
    if (a).num_processed != (b).num_processed {
        println("FAIL topo_sort_result_new");
        process_exit(1);
    }
    println("prod_graph_topological_sort_kahn: PASSED");
}
