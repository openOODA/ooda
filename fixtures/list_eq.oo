// List[Int] deep equality on interp + WASM ($list_eq).
pub fn main() {
    let mut a: List[Int] = list_new();
    a = a.push(10);
    a = a.push(20);
    let mut b: List[Int] = list_new();
    b = b.push(10);
    b = b.push(20);
    let mut c: List[Int] = list_new();
    c = c.push(10);
    c = c.push(21);
    if a == b {
        println(1);
    } else {
        println(0);
    }
    if a == c {
        println(1);
    } else {
        println(0);
    }
}
