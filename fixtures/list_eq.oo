// # List[Int] equality
//
// Logline: Compare two equal lists and one unequal list and print 1 then 0.
//
// Beats:
//   1. Build a and b as [10, 20].
//   2. Build c as [10, 21].
//   3. Print 1 when a == b and 0 when a == c.

// List[Int] deep equality on interp + WASM ($list_eq).
pub fn main() {
    let mut a: List[Int] = list_new();
    a = a.push(10);
    a = a.push(20);
    let mut b: List[Int] = list_new();
    b = b.push(10);
    b = b.push(20);
    let mut c: List[Int] = list_new();
    c = c.push(10);
    c = c.push(21);
    if a == b {
        println(1);
    } else {
        println(0);
    }
    if a == c {
        println(1);
    } else {
        println(0);
    }
}
