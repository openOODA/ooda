// # Product prove std/genomics_advanced/telomere_repeat_hunter.oo
//
// Logline: Fail-closed emit+gcc+run asserts telomere_repeat_hunter_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/telomere_repeat_hunter.oo.
//
// Beats:
//   1. Call telomere_repeat_hunter_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_telomere_repeat_hunter: PASSED only if they match.

import "std/genomics_advanced/telomere_repeat_hunter.oo";

pub fn main() {
    let a = telomere_repeat_hunter_probe();
    let b = telomere_repeat_hunter_probe();
    if a != b {
        println("FAIL telomere_repeat_hunter_probe");
        process_exit(1);
    }
    println("prod_telomere_repeat_hunter: PASSED");
}
