// # Product prove std/genomics_advanced/hardy_weinberg_equilibrium_test.oo
//
// Logline: Fail-closed emit+gcc+run asserts hardy_weinberg_equilibrium_test_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hardy_weinberg_equilibrium_test.oo.
//
// Beats:
//   1. Call hardy_weinberg_equilibrium_test_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hardy_weinberg_equilibrium_test: PASSED only if they match.

import "std/genomics_advanced/hardy_weinberg_equilibrium_test.oo";

pub fn main() {
    let a = hardy_weinberg_equilibrium_test_probe();
    let b = hardy_weinberg_equilibrium_test_probe();
    if a != b {
        println("FAIL hardy_weinberg_equilibrium_test_probe");
        process_exit(1);
    }
    println("prod_hardy_weinberg_equilibrium_test: PASSED");
}
