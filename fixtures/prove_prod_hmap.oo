// # Product hash_map prove
//
// Logline: Fail-closed emit+gcc+run of shipped hash_map_insert/contains/len.
//
// Setup: Product std/collections/hash_map.oo. List[Int] destub.
//
// Beats:
//   1. After insert 7->1, contains 7 true; contains 3 false; len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/hash_map.oo";

pub fn main() {
    let mut m: IntMap = hash_map_new();
    m = hash_map_insert(m, 7, 1);
    let n: Int = hash_map_len(m);
    if n != 1 {
        println("FAIL hmap len");
        process_exit(1);
    }
    let c7: Bool = hash_map_contains(m, 7);
    if c7 == false {
        println("FAIL hmap 7");
        process_exit(1);
    }
    let c3: Bool = hash_map_contains(m, 3);
    if c3 == true {
        println("FAIL hmap 3");
        process_exit(1);
    }
    println("prod_hmap: PASSED");
}
