// # Product prove std/auto/orca_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts vec2_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_types.oo.
//
// Beats:
//   1. Call vec2_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orca_types: PASSED only if they match.

import "std/auto/orca_types.oo";

pub fn main() {
    let orca_types_mark: Int = 0;
    if orca_types_mark != 0 {
        process_exit(1);
    }
    let a: Vec2 = vec2_new(0.0, 0.0);
    let b: Vec2 = vec2_new(0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL vec2_new");
        process_exit(1);
    }
    println("prod_orca_types: PASSED");
}
