// # Product prove std/quantum_advanced/quantum_annealing_qubo.oo
//
// Logline: Fail-closed emit+gcc+run asserts qubo_matrix_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_annealing_qubo.oo.
//
// Beats:
//   1. Call qubo_matrix_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_quantum_annealing_qubo: PASSED only if they match.

import "std/quantum_advanced/quantum_annealing_qubo.oo";

pub fn main() {
    let quantum_annealing_qubo_mark: Int = 0;
    if quantum_annealing_qubo_mark != 0 {
        process_exit(1);
    }
    let a: QuboMatrix = qubo_matrix_new(0);
    let b: QuboMatrix = qubo_matrix_new(0);
    if (a).num_variables != (b).num_variables {
        println("FAIL qubo_matrix_new");
        process_exit(1);
    }
    println("prod_g2_quantum_annealing_qubo: PASSED");
}
