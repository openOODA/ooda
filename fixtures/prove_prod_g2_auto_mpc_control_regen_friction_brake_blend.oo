// # Product prove std/auto_mpc_control/regen_friction_brake_blend.oo
//
// Logline: Fail-closed emit+gcc+run asserts brake_blend_params_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/regen_friction_brake_blend.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call brake_blend_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_regen_friction_brake_blend: PASSED only if they match.

import "std/auto_mpc_control/regen_friction_brake_blend.oo";

pub fn main() {
    let g2_oa: BrakeBlendParams = brake_blend_params_default();
    let g2_ob: BrakeBlendParams = brake_blend_params_default();
    let g2_a = (g2_oa).max_regen_force_n;
    let g2_b = (g2_ob).max_regen_force_n;
    if g2_a != g2_b {
        println("FAIL brake_blend_params_default.max_regen_force_n");
        process_exit(1);
    }
    println("prod_g2_regen_friction_brake_blend: PASSED");
}
