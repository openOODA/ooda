// # Product prove std/bio_advanced/sam_cigar_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts cigar_consumes_query is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sam_cigar_parser.oo.
//
// Beats:
//   1. Call cigar_consumes_query twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sam_cigar_parser: PASSED only if they match.

import "std/bio_advanced/sam_cigar_parser.oo";

pub fn main() {
    let sam_cigar_parser_mark: Int = 0;
    if sam_cigar_parser_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cigar_consumes_query("x");
    let b: Bool = cigar_consumes_query("x");
    if a != b {
        println("FAIL cigar_consumes_query");
        process_exit(1);
    }
    println("prod_g2_sam_cigar_parser: PASSED");
}
