// # Product prove std/wasm_gc/jit_calling_convention.oo
//
// Logline: Fail-closed emit+gcc+run asserts plan_sysv_amd64_args is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_calling_convention.oo.
//
// Beats:
//   1. Call plan_sysv_amd64_args twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_calling_convention: PASSED only if they match.

import "std/wasm_gc/jit_calling_convention.oo";

pub fn main() {
    let jit_calling_convention_mark: Int = 0;
    if jit_calling_convention_mark != 0 {
        process_exit(1);
    }
    let jit_calling_convention_a = plan_sysv_amd64_args(1);
    let jit_calling_convention_b = plan_sysv_amd64_args(1);
    if (jit_calling_convention_a).arch_type != (jit_calling_convention_b).arch_type {
        println("FAIL plan_sysv_amd64_args");
        process_exit(1);
    }
    println("prod_jit_calling_convention: PASSED");
}
