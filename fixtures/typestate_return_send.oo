// # Return a send from Closed
//
// Logline: Return send(s) on a Closed Sock so TYPESTATE must refuse the call.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Skip connect.
//   3. Return send(s).
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn send(s: Int) -> Int { return s; }

pub fn main() {
    let s = open_sock();
    return send(s);
}
