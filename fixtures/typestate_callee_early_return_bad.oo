// # Callee early return
//
// Logline: wrap returns before actually, so the Closed sock never opens.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap hits return on the true branch.
//   3. actually never runs.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn actually: Closed -> Open
// TYPESTATE fn wrap: Closed -> Open

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }

fn wrap(s: Int) {
    if true {
        return;
    }
    actually(s);
}

pub fn main() {
    let s = open_sock();
    wrap(s);
}
