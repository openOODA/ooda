// # Product diag health registry prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/health_check_registry.oo.
//
// Setup: Product std/diag/health_check_registry.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New registry is healthy.
//   2. failed report is not healthy.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/health_check_registry.oo";

pub fn main() {
    let r0: HealthRegistry = health_registry_new();
    if health_is_healthy(r0) == false {
        println("FAIL health new");
        process_exit(1);
    }
    let r1: HealthRegistry = health_report_ok(r0, "api");
    if health_is_healthy(r1) == false {
        println("FAIL health ok");
        process_exit(1);
    }
    let r2: HealthRegistry = health_report_failed(r1, "db");
    if health_is_healthy(r2) {
        println("FAIL health failed");
        process_exit(1);
    }
    println("prod_healthr: PASSED");
}
