// # Product diag metrics counter prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/metrics_counter.oo.
//
// Setup: Product std/diag/metrics_counter.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New counter is 0.
//   2. inc then add 4 is 5.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/metrics_counter.oo";

pub fn main() {
    let c0: MetricsCounter = metrics_counter_new("hits");
    let z: Int = metrics_counter_get(c0);
    if z != 0 {
        println("FAIL mcnt 0");
        process_exit(1);
    }
    let c1: MetricsCounter = metrics_counter_inc(c0);
    let c2: MetricsCounter = metrics_counter_add(c1, 4);
    let n: Int = metrics_counter_get(c2);
    if n != 5 {
        println("FAIL mcnt 5");
        process_exit(1);
    }
    let c3: MetricsCounter = metrics_counter_add(c2, 0);
    let n2: Int = metrics_counter_get(c3);
    if n2 != 5 {
        println("FAIL mcnt no-op add");
        process_exit(1);
    }
    println("prod_mcnt: PASSED");
}
