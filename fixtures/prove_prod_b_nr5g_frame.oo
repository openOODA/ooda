// # Product prove std/telecom/nr5g_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_frame_sfn_increment is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/nr5g_frame.oo.
//
// Beats:
//   1. Call nr5g_frame_sfn_increment twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nr5g_frame: PASSED only if they match.

import "std/telecom/nr5g_frame.oo";

pub fn main() {
    let a = nr5g_frame_sfn_increment(0, 0);
    let b = nr5g_frame_sfn_increment(0, 0);
    if a != b {
        println("FAIL nr5g_frame_sfn_increment");
        process_exit(1);
    }
    println("prod_nr5g_frame: PASSED");
}
