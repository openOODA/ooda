// # Product prove std/protein_folding/md_umbrella_sampling_pmf.oo
//
// Logline: Fail-closed emit+gcc+run asserts md_umbrella_sampling_pmf_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_umbrella_sampling_pmf.oo.
//
// Beats:
//   1. Call md_umbrella_sampling_pmf_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_md_umbrella_sampling_pmf: PASSED only if they match.

import "std/protein_folding/md_umbrella_sampling_pmf.oo";

pub fn main() {
    let a = md_umbrella_sampling_pmf_probe();
    let b = md_umbrella_sampling_pmf_probe();
    if a != b {
        println("FAIL md_umbrella_sampling_pmf_probe");
        process_exit(1);
    }
    println("prod_md_umbrella_sampling_pmf: PASSED");
}
