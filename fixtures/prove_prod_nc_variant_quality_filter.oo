// # Product prove std/bio_advanced/variant_quality_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts variant_quality_filter_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/variant_quality_filter.oo.
//
// Beats:
//   1. Call variant_quality_filter_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_variant_quality_filter: PASSED only if it matches.

import "std/bio_advanced/variant_quality_filter.oo";

pub fn main() {
    let a: Int = variant_quality_filter_probe();
    if a != 0 {
        println("FAIL variant_quality_filter_probe");
        process_exit(1);
    }
    println("prod_nc_variant_quality_filter: PASSED");
}
