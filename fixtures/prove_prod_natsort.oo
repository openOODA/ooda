// # Product natural sort prove
//
// Logline: Fail-closed emit+gcc+run of shipped natural_cmp.
//
// Setup: Product std/text/natural_sort.oo. item2 < item10.
//
// Beats:
//   1. natural_cmp item2 item10 is -1.
//   2. natural_cmp item10 item2 is 1.
//   3. Exit 1 before PASSED on a miss.

import "std/text/natural_sort.oo";

pub fn main() {
    let a: Int = natural_cmp("item2", "item10");
    if a != 0 - 1 {
        println("FAIL natsort 2<10");
        process_exit(1);
    }
    let b: Int = natural_cmp("item10", "item2");
    if b != 1 {
        println("FAIL natsort 10>2");
        process_exit(1);
    }
    println("prod_natsort: PASSED");
}
