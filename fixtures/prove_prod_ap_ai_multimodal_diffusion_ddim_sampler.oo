// # Product prove std/ai_multimodal/diffusion_ddim_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/diffusion_ddim_sampler.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_ddim_sampler.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diffusion_ddim_sampler: PASSED only if they match.

import "std/ai_multimodal/diffusion_ddim_sampler.oo";

pub fn main() {
    let diffusion_ddim_sampler_a = ddim_pred_x0(0, 0, 0);
    let diffusion_ddim_sampler_b = ddim_pred_x0(0, 0, 0);
    if diffusion_ddim_sampler_a != diffusion_ddim_sampler_b {
        println("FAIL diffusion_ddim_sampler");
        process_exit(1);
    }
    println("prod_ap_diffusion_ddim_sampler: PASSED");
}
