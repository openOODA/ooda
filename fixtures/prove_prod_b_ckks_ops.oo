// # Product prove std/sec/crypto/ckks_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_ops_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ckks_ops.oo.
//
// Beats:
//   1. Call ckks_ops_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ckks_ops: PASSED only if they match.

import "std/sec/crypto/ckks_ops.oo";

pub fn main() {
    let a = ckks_ops_probe();
    let b = ckks_ops_probe();
    if a != b {
        println("FAIL ckks_ops_probe");
        process_exit(1);
    }
    println("prod_ckks_ops: PASSED");
}
