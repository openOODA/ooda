// # Product prove std/quantum_open_systems/input_output_cavity_theory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/input_output_cavity_theory.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/input_output_cavity_theory.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_input_output_cavity_theory: PASSED only if they match.

import "std/quantum_open_systems/input_output_cavity_theory.oo";

pub fn main() {
    let input_output_cavity_theory_a = cavity_input_output_params_new(0.0, 0.0, 0.0);
    let input_output_cavity_theory_b = cavity_input_output_params_new(0.0, 0.0, 0.0);
    let input_output_cavity_theory_va = cavity_power_reflectivity(input_output_cavity_theory_a);
    let input_output_cavity_theory_vb = cavity_power_reflectivity(input_output_cavity_theory_b);
    if input_output_cavity_theory_va != input_output_cavity_theory_vb {
        println("FAIL input_output_cavity_theory");
        process_exit(1);
    }
    println("prod_ap_input_output_cavity_theory: PASSED");
}
