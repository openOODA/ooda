// # Product prove std/iot_scada/modbus_function_codes.oo
//
// Logline: Fail-closed emit+gcc+run asserts modbus_fc_read_coils is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/modbus_function_codes.oo.
//
// Beats:
//   1. Call modbus_fc_read_coils twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_modbus_function_codes: PASSED only if they match.

import "std/iot_scada/modbus_function_codes.oo";

pub fn main() {
    let modbus_function_codes_mark: Int = 0;
    if modbus_function_codes_mark != 0 {
        process_exit(1);
    }
    let a: Int = modbus_fc_read_coils();
    let b: Int = modbus_fc_read_coils();
    if a != b {
        println("FAIL modbus_fc_read_coils");
        process_exit(1);
    }
    println("prod_modbus_function_codes: PASSED");
}
