// # Product prove std/multimedia/pcm_audio.oo
//
// Logline: Fail-closed emit+gcc+run asserts pcm_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/pcm_audio.oo.
//
// Beats:
//   1. Call pcm_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pcm_audio: PASSED only if they match.

import "std/multimedia/pcm_audio.oo";

pub fn main() {
    let pcm_audio_mark: Int = 0;
    if pcm_audio_mark != 0 {
        process_exit(1);
    }
    let pcm_audio_a: Float = pcm_int_to_float(1);
    let pcm_audio_b: Float = pcm_int_to_float(1);
    if pcm_audio_a != pcm_audio_b {
        println("FAIL pcm_int_to_float");
        process_exit(1);
    }
    println("prod_pcm_audio: PASSED");
}
