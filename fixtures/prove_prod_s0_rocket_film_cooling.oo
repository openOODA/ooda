// # Product prove std/space_propulsion/rocket_film_cooling.oo
//
// Logline: Fail-closed emit+gcc+run asserts film_cooling_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_film_cooling.oo.
//
// Beats:
//   1. Call film_cooling_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_rocket_film_cooling: PASSED only if asserts hold.

import "std/space_propulsion/rocket_film_cooling.oo";

pub fn main() {
    let rocket_film_cooling_a: FilmCoolingSpec = film_cooling_spec_default();
    let rocket_film_cooling_b: FilmCoolingSpec = film_cooling_spec_default();
    if rocket_film_cooling_a.film_mass_fraction != rocket_film_cooling_b.film_mass_fraction {
        println("FAIL film_cooling_spec_default");
        process_exit(1);
    }
    println("prod_rocket_film_cooling: PASSED");
}
