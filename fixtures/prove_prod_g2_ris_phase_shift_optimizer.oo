// # Product prove std/telecom_6g/ris_phase_shift_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ris_ideal_phase_shift is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_phase_shift_optimizer.oo.
//
// Beats:
//   1. Call ris_ideal_phase_shift twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_ris_phase_shift_optimizer: PASSED only if they match.

import "std/telecom_6g/ris_phase_shift_optimizer.oo";

pub fn main() {
    let ris_phase_shift_optimizer_mark: Int = 0;
    if ris_phase_shift_optimizer_mark != 0 {
        process_exit(1);
    }
    let a: Float = ris_ideal_phase_shift(0.0, 0.0);
    let b: Float = ris_ideal_phase_shift(0.0, 0.0);
    if a != b {
        println("FAIL ris_ideal_phase_shift");
        process_exit(1);
    }
    println("prod_g2_ris_phase_shift_optimizer: PASSED");
}
