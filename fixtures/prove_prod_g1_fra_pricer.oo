// # Product prove std/fintech_defi/fra_pricer.oo
//
// Logline: Fail-closed emit+gcc+run asserts fra_contract_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/fra_pricer.oo.
//
// Beats:
//   1. Call fra_contract_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fra_pricer: PASSED only if they match.

import "std/fintech_defi/fra_pricer.oo";

pub fn main() {
    let a: FraContract = fra_contract_new(0.0, 0.0, 0.0, 0.0, true);
    let b: FraContract = fra_contract_new(0.0, 0.0, 0.0, 0.0, true);
    if a.is_payer != b.is_payer {
        println("FAIL fra_contract_new");
        process_exit(1);
    }
    println("prod_fra_pricer: PASSED");
}
