// # Product prove std/pbr_raytracing/pathtrace_integrator_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts pathtrace_integrator_core_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/pathtrace_integrator_core.oo.
//
// Beats:
//   1. Call pathtrace_integrator_core_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_pathtrace_integrator_core: PASSED only if it matches.

import "std/pbr_raytracing/pathtrace_integrator_core.oo";

pub fn main() {
    let a: Int = pathtrace_integrator_core_probe();
    if a != 0 {
        println("FAIL pathtrace_integrator_core_probe");
        process_exit(1);
    }
    println("prod_nc_pathtrace_integrator_core: PASSED");
}
