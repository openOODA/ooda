// # Product prove std/zk_rollup/plonk_gate_selector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/plonk_gate_selector.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_gate_selector.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_plonk_gate_selector: PASSED only if they match.

import "std/zk_rollup/plonk_gate_selector.oo";

pub fn main() {
    let plonk_gate_selector_a = plonk_gate_selectors_arithmetic_add(0);
    let plonk_gate_selector_b = plonk_gate_selectors_arithmetic_add(0);
    if plonk_gate_selector_a.q_l != plonk_gate_selector_b.q_l {
        println("FAIL plonk_gate_selector");
        process_exit(1);
    }
    println("prod_ap_plonk_gate_selector: PASSED");
}
