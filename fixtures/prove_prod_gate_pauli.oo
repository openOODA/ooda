// # Product prove std/quantum/gate_pauli.oo
//
// Logline: Fail-closed emit+gcc+run asserts pauli_x_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_pauli.oo.
//
// Beats:
//   1. Call pauli_x_matrix twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_pauli: PASSED only if they match.

import "std/quantum/gate_pauli.oo";

pub fn main() {
    let gate_pauli_mark: Int = 0;
    if gate_pauli_mark != 0 {
        process_exit(1);
    }
    let a: Matrix2x2 = pauli_x_matrix();
    let b: Matrix2x2 = pauli_x_matrix();
    if (a).m00 != (b).m00 {
        println("FAIL pauli_x_matrix");
        process_exit(1);
    }
    println("prod_gate_pauli: PASSED");
}
