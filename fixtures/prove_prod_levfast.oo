// # Product levenshtein_fast prove
//
// Logline: Fail-closed emit+gcc+run of shipped levenshtein_distance_fast.
//
// Setup: Product std/text/levenshtein_fast.oo. Wagner-Fischer two-row.
//
// Beats:
//   1. kitten/sitting is 3 (Wikipedia).
//   2. equal strings are 0; empty vs abc is 3.
//   3. Exit 1 before PASSED on a miss.

import "std/text/levenshtein_fast.oo";

pub fn main() {
    let d: Int = levenshtein_distance_fast("kitten", "sitting");
    if d != 3 {
        println("FAIL levfast kitten");
        process_exit(1);
    }
    let z: Int = levenshtein_distance_fast("abc", "abc");
    if z != 0 {
        println("FAIL levfast equal");
        process_exit(1);
    }
    let e: Int = levenshtein_distance_fast("", "abc");
    if e != 3 {
        println("FAIL levfast empty");
        process_exit(1);
    }
    println("prod_levfast: PASSED");
}
