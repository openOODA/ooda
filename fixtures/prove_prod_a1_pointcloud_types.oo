// # Product prove std/auto_robot/pointcloud_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts point_xyz_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_types.oo.
//
// Beats:
//   1. Call point_xyz_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pointcloud_types: PASSED only if they match.

import "std/auto_robot/pointcloud_types.oo";

pub fn main() {
    let pointcloud_types_mark: Int = 0;
    if pointcloud_types_mark != 0 {
        process_exit(1);
    }
    let a: PointXYZ = point_xyz_new(0, 0, 0);
    let b: PointXYZ = point_xyz_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL point_xyz_new");
        process_exit(1);
    }
    println("prod_pointcloud_types: PASSED");
}
