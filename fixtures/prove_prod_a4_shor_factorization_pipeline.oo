// # Product prove std/quantum_advanced/shor_factorization_pipeline.oo
//
// Logline: Fail-closed emit+gcc+run asserts shor_gcd is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_factorization_pipeline.oo.
//
// Beats:
//   1. Call shor_gcd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shor_factorization_pipeline: PASSED only if they match.

import "std/quantum_advanced/shor_factorization_pipeline.oo";

pub fn main() {
    let shor_factorization_pipeline_mark: Int = 0;
    if shor_factorization_pipeline_mark != 0 {
        process_exit(1);
    }
    let a: Int = shor_gcd(0, 0);
    let b: Int = shor_gcd(0, 0);
    if a != b {
        println("FAIL shor_gcd");
        process_exit(1);
    }
    println("prod_shor_factorization_pipeline: PASSED");
}
