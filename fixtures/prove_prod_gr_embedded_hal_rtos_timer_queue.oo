// # Product prove std/embedded_hal/rtos_timer_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_timer_is_active is a real value.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_timer_queue.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call rtos_timer_is_active twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_rtos_timer_queue: PASSED only if they match.

import "std/embedded_hal/rtos_timer_queue.oo";

pub fn main() {
    let g0_oa = rtos_timer_queue_new();
    let g0_ob = rtos_timer_queue_new();
    let g0_a = rtos_timer_is_active(g0_oa, 0);
    let g0_b = rtos_timer_is_active(g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL rtos_timer_is_active");
        process_exit(1);
    }
    println("prod_gr_rtos_timer_queue: PASSED");
}
