// # Product prove std/scicomp/clifford_rotor.oo
//
// Logline: Fail-closed emit+gcc+run asserts rotor_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/clifford_rotor.oo.
//
// Beats:
//   1. Call rotor_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_clifford_rotor: PASSED only if they match.

import "std/scicomp/clifford_rotor.oo";

pub fn main() {
    let clifford_rotor_mark: Int = 0;
    if clifford_rotor_mark != 0 {
        process_exit(1);
    }
    let a: CliffordRotor = rotor_identity();
    let b: CliffordRotor = rotor_identity();
    if (a).a != (b).a {
        println("FAIL rotor_identity");
        process_exit(1);
    }
    println("prod_g2_clifford_rotor: PASSED");
}
