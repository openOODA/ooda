// # Product prove std/space_propulsion/nuclear_thermal_hydrogen_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntr_spec_default_nerva value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/nuclear_thermal_hydrogen_flow.oo.
//
// Beats:
//   1. Call ntr_spec_default_nerva twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_nuclear_thermal_hydrogen_flow: PASSED only if asserts hold.

import "std/space_propulsion/nuclear_thermal_hydrogen_flow.oo";

pub fn main() {
    let nuclear_thermal_hydrogen_flow_a: NtrReactorSpec = ntr_spec_default_nerva();
    let nuclear_thermal_hydrogen_flow_b: NtrReactorSpec = ntr_spec_default_nerva();
    if nuclear_thermal_hydrogen_flow_a.thermal_power_mw != nuclear_thermal_hydrogen_flow_b.thermal_power_mw {
        println("FAIL ntr_spec_default_nerva");
        process_exit(1);
    }
    println("prod_nuclear_thermal_hydrogen_flow: PASSED");
}
