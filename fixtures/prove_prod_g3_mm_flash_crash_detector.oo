// # Product prove std/hft_alpha/mm_flash_crash_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_crash_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_flash_crash_detector.oo.
//
// Beats:
//   1. Call flash_crash_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mm_flash_crash_detector: PASSED only if they match.

import "std/hft_alpha/mm_flash_crash_detector.oo";

pub fn main() {
    let mm_flash_crash_detector_mark: Int = 0;
    if mm_flash_crash_detector_mark != 0 {
        process_exit(1);
    }
    let a: FlashCrashConfig = flash_crash_config_default();
    let b: FlashCrashConfig = flash_crash_config_default();
    if (a).depth_drop_threshold_pct != (b).depth_drop_threshold_pct {
        println("FAIL flash_crash_config_default");
        process_exit(1);
    }
    println("prod_mm_flash_crash_detector: PASSED");
}
