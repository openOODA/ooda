// # Product prove std/mesh_ebpf/mesh_distributed_tracing_w3c.oo
//
// Logline: Fail-closed emit+gcc+run asserts W3C distributed trace context creation, header formatting, and span lifecycle are deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/mesh_distributed_tracing_w3c.oo.
//
// Beats:
//   1. Initialize W3C distributed tracer.
//   2. Start root and child spans; format W3C traceparent headers.
//   3. Assert deterministic header serialization, span durations, and active trace accounting.
//   4. Print prod_g4_ebpf_tracing_w3c: PASSED and exit 0.

import "std/mesh_ebpf/mesh_distributed_tracing_w3c.oo";

pub fn main() {
    let mut tracer: W3CTracer = w3c_tracer_new();

    let root_span: W3CSpan = w3c_start_span(
        &mut tracer,
        "4bf92f3577b34da6a3ce929d0e0e4736",
        "0000000000000000",
        "00f067aa0ba902b7",
        "ingress_gateway",
        10000,
        true
    );

    let tp_header: String = w3c_format_traceparent_header(&root_span);
    if tp_header != "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" {
        println("FAIL format_traceparent_header sampled");
        process_exit(1);
    }

    let child_span: W3CSpan = w3c_start_span(
        &mut tracer,
        "4bf92f3577b34da6a3ce929d0e0e4736",
        "00f067aa0ba902b7",
        "5fb397be34d23b0f",
        "auth_service",
        12000,
        false
    );

    let tp_child: String = w3c_format_traceparent_header(&child_span);
    if tp_child != "00-4bf92f3577b34da6a3ce929d0e0e4736-5fb397be34d23b0f-00" {
        println("FAIL format_traceparent_header unsampled");
        process_exit(1);
    }

    if (tracer).total_spans_created != 2 {
        println("FAIL total_spans_created");
        process_exit(1);
    }

    let child_dur: Int = w3c_finish_span(&mut tracer, "5fb397be34d23b0f", 15000);
    if child_dur != 3000 {
        println("FAIL finish_span child_dur");
        process_exit(1);
    }

    let root_dur: Int = w3c_finish_span(&mut tracer, "00f067aa0ba902b7", 20000);
    if root_dur != 10000 {
        println("FAIL finish_span root_dur");
        process_exit(1);
    }

    if (tracer).total_spans_finished != 2 {
        println("FAIL total_spans_finished");
        process_exit(1);
    }

    println("prod_g4_ebpf_tracing_w3c: PASSED");
    process_exit(0);
}
