// # Product prove std/satellite_dvb/satellite_link_budget_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts satellite_link_budget_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_link_budget_calc.oo.
//
// Beats:
//   1. Call satellite_link_budget_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_link_budget_calc: PASSED only if they match.

import "std/satellite_dvb/satellite_link_budget_calc.oo";

pub fn main() {
    let a: SatelliteLinkBudget = satellite_link_budget_default();
    let b: SatelliteLinkBudget = satellite_link_budget_default();
    if a.eirp_tx_dbw != b.eirp_tx_dbw {
        println("FAIL satellite_link_budget_default");
        process_exit(1);
    }
    println("prod_satellite_link_budget_calc: PASSED");
}
