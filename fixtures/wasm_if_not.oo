// # Const if !false println
//
// Logline: Print not-then when the condition is !false.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If !false print not-then else print not-else.
//   3. Leave no other statements.

pub fn main() {
    if !false {
        println("not-then");
    } else {
        println("not-else");
    }
}
