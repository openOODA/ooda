// # Product prove std/quantum_advanced/quantum_walk_coined.oo
//
// Logline: Fail-closed emit+gcc+run asserts coined_walk_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_walk_coined.oo.
//
// Beats:
//   1. Call coined_walk_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_walk_coined: PASSED only if they match.

import "std/quantum_advanced/quantum_walk_coined.oo";

pub fn main() {
    let quantum_walk_coined_mark: Int = 0;
    if quantum_walk_coined_mark != 0 {
        process_exit(1);
    }
    let a: CoinedWalk1D = coined_walk_init(0);
    let b: CoinedWalk1D = coined_walk_init(0);
    if (a).num_positions != (b).num_positions {
        println("FAIL coined_walk_init");
        process_exit(1);
    }
    println("prod_quantum_walk_coined: PASSED");
}
