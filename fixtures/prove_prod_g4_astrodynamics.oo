// # Product prove std/astrodynamics/astrodynamics.oo
//
// Logline: Fail-closed verification that unified astrodynamics facade functions and constructors are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/astrodynamics.oo.
//
// Beats:
//   1. Construct 3D vectors and Keplerian orbit objects via unified facade.
//   2. Compute Hohmann orbital transfer delta-V and rocket stage descriptors.
//   3. Assert deterministic execution.
//   4. Print prod_g4_astrodynamics: PASSED and exit 0.

import "std/astrodynamics/astrodynamics.oo";

pub fn main() {
    let v: Vector3 = astro_shim_vec3(1.0, 2.0, 3.0);
    if (v).x != 1.0 || (v).y != 2.0 || (v).z != 3.0 {
        println("FAIL astro_shim_vec3");
        process_exit(1);
    }

    let orb: KeplerOrbit = astro_shim_kepler_orbit(7000000.0, 0.001, 398600441800000.0);
    if (orb).semi_major_axis != 7000000.0 {
        println("FAIL astro_shim_kepler_orbit");
        process_exit(1);
    }

    let hoh: HohmannTransfer = astro_shim_hohmann(7000000.0, 42000000.0, 398600441800000.0);
    if (hoh).total_delta_v <= 0.0 {
        println("FAIL astro_shim_hohmann");
        process_exit(1);
    }

    let stage: RocketStage = astro_shim_rocket_stage(1, 1000.0, 9000.0, 300.0);
    if (stage).stage_number != 1 || (stage).isp_sea_level != 300.0 {
        println("FAIL astro_shim_rocket_stage");
        process_exit(1);
    }

    println("prod_g4_astrodynamics: PASSED");
    process_exit(0);
}
