// # Product prove std/telecom_6g/thz_atmospheric_attenuation.oo
//
// Logline: Fail-closed emit+gcc+run asserts thz_dry_air_specific_attenuation_db_km is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_atmospheric_attenuation.oo.
//
// Beats:
//   1. Call thz_dry_air_specific_attenuation_db_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_atmospheric_attenuation: PASSED only if they match.

import "std/telecom_6g/thz_atmospheric_attenuation.oo";

pub fn main() {
    let thz_atmospheric_attenuation_mark: Int = 0;
    if thz_atmospheric_attenuation_mark != 0 {
        process_exit(1);
    }
    let a: Float = thz_dry_air_specific_attenuation_db_km(0.0, 0.0, 0.0);
    let b: Float = thz_dry_air_specific_attenuation_db_km(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL thz_dry_air_specific_attenuation_db_km");
        process_exit(1);
    }
    println("prod_thz_atmospheric_attenuation: PASSED");
}
