// # Product prove std/tda_topology/topological_density_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts gaussian_kernel_eval is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/topological_density_estimator.oo.
//
// Beats:
//   1. Call gaussian_kernel_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_density_estimator: PASSED only if they match.

import "std/tda_topology/topological_density_estimator.oo";

pub fn main() {
    let topological_density_estimator_mark: Int = 0;
    if topological_density_estimator_mark != 0 {
        process_exit(1);
    }
    let topological_density_estimator_a: Float = gaussian_kernel_eval(1.0, 1.0);
    let topological_density_estimator_b: Float = gaussian_kernel_eval(1.0, 1.0);
    if topological_density_estimator_a != topological_density_estimator_b {
        println("FAIL gaussian_kernel_eval");
        process_exit(1);
    }
    println("prod_topological_density_estimator: PASSED");
}
