// # Product prove std/pqc_nist/pqc_tls_hybrid_key_exchange.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/pqc_nist/pqc_tls_hybrid_key_exchange.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_tls_hybrid_key_exchange.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_pqc_tls_hybrid_key_exchange: PASSED only if they match.

import "std/pqc_nist/pqc_tls_hybrid_key_exchange.oo";

pub fn main() {
    let pqc_tls_hybrid_key_exchange_a = tls_group_x25519_mlkem768();
    let pqc_tls_hybrid_key_exchange_b = tls_group_x25519_mlkem768();
    if pqc_tls_hybrid_key_exchange_a.group_id != pqc_tls_hybrid_key_exchange_b.group_id {
        println("FAIL pqc_tls_hybrid_key_exchange");
        process_exit(1);
    }
    println("prod_ap_pqc_tls_hybrid_key_exchange: PASSED");
}
