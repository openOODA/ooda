// # Product prove std/telecom/psk_modulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts psk_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/psk_modulator.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call psk_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_psk_modulator: PASSED only if they match.

import "std/telecom/psk_modulator.oo";

pub fn main() {
    let g0_a = psk_pi();
    let g0_b = psk_pi();
    if g0_a != g0_b {
        println("FAIL psk_pi");
        process_exit(1);
    }
    println("prod_gr_psk_modulator: PASSED");
}
