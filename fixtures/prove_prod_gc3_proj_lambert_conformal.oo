// # Product prove std/gis_topo/proj_lambert_conformal.oo
//
// Logline: Fail-closed emit+gcc+run asserts lcc_deg2rad is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_lambert_conformal.oo.
//
// Beats:
//   1. Call lcc_deg2rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_proj_lambert_conformal: PASSED only if they match.

import "std/gis_topo/proj_lambert_conformal.oo";

pub fn main() {
    let proj_lambert_conformal_mark: Int = 0;
    if proj_lambert_conformal_mark != 0 {
        process_exit(1);
    }
    let proj_lambert_conformal_a: Float = lcc_deg2rad(1.0);
    let proj_lambert_conformal_b: Float = lcc_deg2rad(1.0);
    if proj_lambert_conformal_a != proj_lambert_conformal_b {
        println("FAIL lcc_deg2rad");
        process_exit(1);
    }
    println("prod_proj_lambert_conformal: PASSED");
}
