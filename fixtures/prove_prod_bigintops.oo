// # Product bigint_ops prove
//
// Logline: Fail-closed emit+gcc+run of shipped bigint_add_abs.
//
// Setup: Product std/math/bigint_ops.oo. Base-10 1+1=2.
//
// Beats:
//   1. one+one first digit is 2 and count is 1.
//   2. Exit 1 before PASSED on a miss.

import "std/math/bigint.oo";
import "std/math/bigint_ops.oo";

pub fn main() {
    let a: BigInt = bigint_one();
    let b: BigInt = bigint_one();
    let s: BigInt = bigint_add_abs(a, b);
    let digits: List[Int] = s.digits;
    let d0: Int = list_get(digits, 0);
    if d0 != 2 {
        println("FAIL bigintops 1+1 digit");
        process_exit(1);
    }
    let c: Int = s.count;
    if c != 1 {
        println("FAIL bigintops count");
        process_exit(1);
    }
    println("prod_bigintops: PASSED");
}
