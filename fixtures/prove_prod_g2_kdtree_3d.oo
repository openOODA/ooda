// # Product prove std/lidar_perception/kdtree_3d.oo
//
// Logline: Fail-closed emit+gcc+run asserts kdtree_should_search_other_side is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/kdtree_3d.oo.
//
// Beats:
//   1. Call kdtree_should_search_other_side twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kdtree_3d: PASSED only if they match.

import "std/lidar_perception/kdtree_3d.oo";

pub fn main() {
    let kdtree_3d_mark: Int = 0;
    if kdtree_3d_mark != 0 {
        process_exit(1);
    }
    let a: Bool = kdtree_should_search_other_side(0.0, 0.0);
    let b: Bool = kdtree_should_search_other_side(0.0, 0.0);
    if a != b {
        println("FAIL kdtree_should_search_other_side");
        process_exit(1);
    }
    println("prod_g2_kdtree_3d: PASSED");
}
