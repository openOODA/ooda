import "std/quantum_open_systems/density_matrix_purity_entropy.oo";

pub fn main() {
    let density_matrix_purity_entropy_a = density_purity_eval(0.0, 0.0, 0.0, 0.0);
    let density_matrix_purity_entropy_b = density_purity_eval(0.0, 0.0, 0.0, 0.0);
    if density_matrix_purity_entropy_a != density_matrix_purity_entropy_b {
        println("FAIL density_matrix_purity_entropy");
        process_exit(1);
    }
