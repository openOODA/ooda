// # Product prove std/db_columnar/arrow_chunked_array.oo
//
// Logline: Fail-closed verification that Apache Arrow ChunkedArray creation, chunk addition, and index resolution are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_chunked_array.oo.
//
// Beats:
//   1. Initialize empty ArrowChunkedArray instance.
//   2. Add integer buffer chunks and verify total length and chunk counts.
//   3. Resolve logical row locations to chunk indexes and offsets.
//   4. Assert deterministic location results.
//   5. Print prod_g4_db_arrow_chunked: PASSED and exit 0.

import "std/db_columnar/arrow_chunked_array.oo";

pub fn main() {
    let arr0: ArrowChunkedArray = arrow_chunked_array_new(1);
    if arr0.total_length != 0 || arr0.num_chunks != 0 {
        println("FAIL arrow_chunked_array_new");
        process_exit(1);
    }

    let arr1: ArrowChunkedArray = arrow_chunked_array_add_chunk(arr0, 3);
    let arr2: ArrowChunkedArray = arrow_chunked_array_add_chunk(arr1, 2);

    let tot_len: Int = arr2.total_length;
    let n_chunks: Int = arr2.num_chunks;
    if tot_len != 5 || n_chunks != 2 {
        println("FAIL chunk lengths");
        process_exit(1);
    }

    let loc0: ChunkLocation = arrow_chunked_array_locate_chunk(3, 0);
    if loc0.chunk_index != 0 || loc0.offset_in_chunk != 0 {
        println("FAIL locate row 0");
        process_exit(1);
    }

    let loc3: ChunkLocation = arrow_chunked_array_locate_chunk(3, 3);
    if loc3.chunk_index != 1 || loc3.offset_in_chunk != 0 {
        println("FAIL locate row 3");
        process_exit(1);
    }

    let loc4: ChunkLocation = arrow_chunked_array_locate_chunk(3, 4);
    if loc4.chunk_index != 1 || loc4.offset_in_chunk != 1 {
        println("FAIL locate row 4");
        process_exit(1);
    }

    println("prod_g4_db_arrow_chunked: PASSED");
    process_exit(0);
}
