// # Product prove std/auto_mpc_control/mpc_linear_time_invariant.oo
//
// Logline: Fail-closed emit+gcc+run asserts lti_mpc_config_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_linear_time_invariant.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call lti_mpc_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mpc_linear_time_invariant: PASSED only if they match.

import "std/auto_mpc_control/mpc_linear_time_invariant.oo";

pub fn main() {
    let g2_oa: LTIMPCConfig = lti_mpc_config_default();
    let g2_ob: LTIMPCConfig = lti_mpc_config_default();
    let g2_a = (g2_oa).horizon_n;
    let g2_b = (g2_ob).horizon_n;
    if g2_a != g2_b {
        println("FAIL lti_mpc_config_default.horizon_n");
        process_exit(1);
    }
    println("prod_g2_mpc_linear_time_invariant: PASSED");
}
