// # Product prove std/physics_advanced/soft_body_corotational.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix3x3_identity is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/soft_body_corotational.oo.
//
// Beats:
//   1. Call matrix3x3_identity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_soft_body_corotational: PASSED only if they match.

import "std/physics_advanced/soft_body_corotational.oo";

pub fn main() {
    let soft_body_corotational_mark: Int = 0;
    if soft_body_corotational_mark != 0 {
        process_exit(1);
    }
    let a: Matrix3x3 = matrix3x3_identity();
    let b: Matrix3x3 = matrix3x3_identity();
    if (a).m00 != (b).m00 {
        println("FAIL matrix3x3_identity");
        process_exit(1);
    }
    println("prod_soft_body_corotational: PASSED");
}
