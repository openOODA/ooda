// # Product prove std/database/wal_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts wal_recovery_is_tx_committed is a real value.
//
// Setup: Isolated emit-c. Imports std/database/wal_recovery.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call wal_recovery_is_tx_committed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_wal_recovery: PASSED only if they match.

import "std/database/wal_recovery.oo";

pub fn main() {
    let g2_oa: RecoveryState = RecoveryState { last_checkpoint_lsn: 2, recovered_tx_count: 8, committed_tx_ids: list_new(), aborted_tx_ids: list_new(), active_tx_ids: list_new(), redo_records_applied: 2 };
    let g2_ob: RecoveryState = RecoveryState { last_checkpoint_lsn: 2, recovered_tx_count: 8, committed_tx_ids: list_new(), aborted_tx_ids: list_new(), active_tx_ids: list_new(), redo_records_applied: 2 };
    let g2_a = wal_recovery_is_tx_committed(&g2_oa, 2);
    let g2_b = wal_recovery_is_tx_committed(&g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL wal_recovery_is_tx_committed");
        process_exit(1);
    }
    println("prod_g2_wal_recovery: PASSED");
}
