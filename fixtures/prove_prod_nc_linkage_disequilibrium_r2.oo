//
// Setup: Isolated emit-c. Imports std/genomics_advanced/linkage_disequilibrium_r2.oo.
//
// Beats:
//   1. Call linkage_disequilibrium_r2_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_linkage_disequilibrium_r2: PASSED only if it matches.

import "std/genomics_advanced/linkage_disequilibrium_r2.oo";

pub fn main() {
    let a: Int = linkage_disequilibrium_r2_probe();
    if a != 0 {
        println("FAIL linkage_disequilibrium_r2_probe");
        process_exit(1);
    }
    println("prod_nc_linkage_disequilibrium_r2: PASSED");
}
