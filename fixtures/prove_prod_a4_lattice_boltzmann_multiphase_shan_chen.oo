// # Product prove std/physics_advanced/lattice_boltzmann_multiphase_shan_chen.oo
//
// Logline: Fail-closed emit+gcc+run asserts shan_chen_potential_psi is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_multiphase_shan_chen.oo.
//
// Beats:
//   1. Call shan_chen_potential_psi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lattice_boltzmann_multiphase_shan_chen: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_multiphase_shan_chen.oo";

pub fn main() {
    let lattice_boltzmann_multiphase_shan_chen_mark: Int = 0;
    if lattice_boltzmann_multiphase_shan_chen_mark != 0 {
        process_exit(1);
    }
    let a: Float = shan_chen_potential_psi(0.0, 0.0);
    let b: Float = shan_chen_potential_psi(0.0, 0.0);
    if a != b {
        println("FAIL shan_chen_potential_psi");
        process_exit(1);
    }
    println("prod_lattice_boltzmann_multiphase_shan_chen: PASSED");
}
