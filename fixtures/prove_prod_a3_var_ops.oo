// # Product prove std/fin/var_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts z_score_for_confidence is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/var_ops.oo.
//
// Beats:
//   1. Call z_score_for_confidence twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_var_ops: PASSED only if they match.

import "std/fin/var_ops.oo";

pub fn main() {
    let var_ops_mark: Int = 0;
    if var_ops_mark != 0 {
        process_exit(1);
    }
    let a: Float = z_score_for_confidence(0.0);
    let b: Float = z_score_for_confidence(0.0);
    if a != b {
        println("FAIL z_score_for_confidence");
        process_exit(1);
    }
    println("prod_var_ops: PASSED");
}
