// # List[List[String]] emit lock
//
// Logline: Fail-closed emit+gcc+run of nested List[List[String]] push and get.
//
// Setup: Backend-C. Inner list holds hi. Nested list_get must yield String.
//
// Beats:
//   1. Push hi onto an inner List[String].
//   2. Push that inner list onto xs.
//   3. Exit 1 before PASSED when nested get is not hi.

pub fn main() {
    let mut inner: List[String] = list_new();
    inner = list_push(inner, "hi");
    let empty: List[List[String]] = list_new();
    let xs: List[List[String]] = list_push(empty, inner);
    if list_get(list_get(xs, 0), 0) != "hi" {
        println("FAIL");
        process_exit(1);
    }
    println("list_ll_str_smoke: PASSED");
}
