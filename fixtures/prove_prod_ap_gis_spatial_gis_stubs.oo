// # Product prove std/gis_spatial/gis_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/gis_stubs.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/gis_stubs.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_gis_stubs: PASSED only if they match.

import "std/gis_spatial/gis_stubs.oo";

pub fn main() {
    let gis_stubs_a = gis_hardware_accel_init(0);
    let gis_stubs_b = gis_hardware_accel_init(0);
    if gis_stubs_a.device_id != gis_stubs_b.device_id {
        println("FAIL gis_stubs");
        process_exit(1);
    }
    println("prod_ap_gis_stubs: PASSED");
}
