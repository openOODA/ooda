// # Product prove std/gis_topo/lidar_ground_classification.oo
//
// Logline: Fail-closed emit+gcc+run asserts lidar_class_ground is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/lidar_ground_classification.oo.
//
// Beats:
//   1. Call lidar_class_ground twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lidar_ground_classification: PASSED only if they match.

import "std/gis_topo/lidar_ground_classification.oo";

pub fn main() {
    let lidar_ground_classification_mark: Int = 0;
    if lidar_ground_classification_mark != 0 {
        process_exit(1);
    }
    let a: Int = lidar_class_ground();
    let b: Int = lidar_class_ground();
    if a != b {
        println("FAIL lidar_class_ground");
        process_exit(1);
    }
    println("prod_lidar_ground_classification: PASSED");
}
