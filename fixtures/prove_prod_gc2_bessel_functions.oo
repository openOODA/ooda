// # Product prove std/scicomp/bessel_functions.oo
//
// Logline: Fail-closed emit+gcc+run asserts bessel_j0 is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/bessel_functions.oo.
//
// Beats:
//   1. Call bessel_j0 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bessel_functions: PASSED only if they match.

import "std/scicomp/bessel_functions.oo";

pub fn main() {
    let bessel_functions_mark: Int = 0;
    if bessel_functions_mark != 0 {
        process_exit(1);
    }
    let bessel_functions_a: Float = bessel_j0(1.0);
    let bessel_functions_b: Float = bessel_j0(1.0);
    if bessel_functions_a != bessel_functions_b {
        println("FAIL bessel_j0");
        process_exit(1);
    }
    println("prod_bessel_functions: PASSED");
}
