// # Int arity-2 add fail
//
// Logline: Return x + y + 1 while ensuring result == x + y.
//
// Beats:
//   1. Keep FUZZ_DOMAIN int and target multi_bad 0 30.
//   2. Require x, y >= 0 and ensure result == x + y.
//   3. Return the sum plus one so the rail fails.

// Pure Int arity-2 multi-arg fuzz fail fixture: ensures result == x + y but body lies.
// FUZZ_DOMAIN: int
// FUZZ_TARGET: multi_bad 0 30
// FUZZ_REQUIRES: multi_bad x >= 0 && y >= 0
// FUZZ_ENSURES: multi_bad result == x + y
fn multi_bad(x: Int, y: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    ensures result == x + y;
    return x + y + 1;
}

