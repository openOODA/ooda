// # Product prove std/robotics_auv/ocean_current_kinematics.oo
//
// Logline: Fail-closed emit+gcc+run asserts ocean_current_profile_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/ocean_current_kinematics.oo.
//
// Beats:
//   1. Call ocean_current_profile_default using the ocean_current_kinematics ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ocean_current_kinematics: PASSED only if asserts hold.

import "std/robotics_auv/ocean_current_kinematics.oo";

pub fn main() {
    let obj = ocean_current_profile_default();
    let ocean_current_kinematics_a = obj.surface_speed_m_s;
    if ocean_current_kinematics_a != 0.5 {
        println("FAIL ocean_current_profile_default");
        process_exit(1);
    }
    println("prod_ocean_current_kinematics: PASSED");
}
