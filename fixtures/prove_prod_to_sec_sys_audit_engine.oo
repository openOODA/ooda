// # Product prove std/sec/sys/audit_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_check_path_prefix holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/audit_engine.oo.
//
// Beats:
//   1. Call audit_check_path_prefix using the audit_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_audit_engine: PASSED only if asserts hold.

import "std/sec/sys/audit_engine.oo";

pub fn main() {
    let audit_engine_a = audit_check_path_prefix("x", "x");
    let audit_engine_b = audit_check_path_prefix("x", "x");
    if audit_engine_a != audit_engine_b {
        println("FAIL audit_check_path_prefix");
        process_exit(1);
    }
    println("prod_audit_engine: PASSED");
}
