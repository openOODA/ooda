// # Product prove std/net/dns_client.oo
//
// Logline: Fail-closed emit+gcc+run asserts dns_client_format_query is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/dns_client.oo.
//
// Beats:
//   1. Call dns_client_format_query twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dns_client: PASSED only if they match.

import "std/net/dns_client.oo";

pub fn main() {
    let a = dns_client_format_query("x", 0);
    let b = dns_client_format_query("x", 0);
    if a != b {
        println("FAIL dns_client_format_query");
        process_exit(1);
    }
    println("prod_dns_client: PASSED");
}
