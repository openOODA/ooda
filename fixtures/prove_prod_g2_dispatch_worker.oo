// # Product prove std/swarm/dispatch_worker.oo
//
// Logline: Fail-closed emit+gcc+run asserts dispatcher_config_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch_worker.oo.
//
// Beats:
//   1. Call dispatcher_config_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dispatch_worker: PASSED only if they match.

import "std/swarm/dispatch_worker.oo";

pub fn main() {
    let dispatch_worker_mark: Int = 0;
    if dispatch_worker_mark != 0 {
        process_exit(1);
    }
    let a: DispatcherConfig = dispatcher_config_init(0, 0, 0, 0, 0);
    let b: DispatcherConfig = dispatcher_config_init(0, 0, 0, 0, 0);
    if (a).strategy != (b).strategy {
        println("FAIL dispatcher_config_init");
        process_exit(1);
    }
    println("prod_g2_dispatch_worker: PASSED");
}
