// # Product prove std/sec/crypto/chacha20.oo
//
// Logline: Fail-closed emit+gcc+run asserts chacha20 operations and shim markers are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20.oo.
//
// Beats:
//   1. Call shim markers and core operations twice with concrete test inputs.
//   2. Assert deterministic results and consistent state validation.
//   3. Print prod_g4_sec_chacha20: PASSED and exit 0.

import "std/sec/crypto/chacha20.oo";

pub fn main() {
    let cs1: Int = shim_marker_checksum();
    let cs2: Int = shim_marker_checksum();
    if cs1 != cs2 {
        println("FAIL shim_marker_checksum");
        process_exit(1);
    }

    let hex1: String = shim_marker_hex_encode();
    let hex2: String = shim_marker_hex_encode();
    if hex1 != hex2 {
        println("FAIL shim_marker_hex_encode");
        process_exit(1);
    }

    let pad1: String = shim_marker_pad16();
    let pad2: String = shim_marker_pad16();
    if pad1 != pad2 {
        println("FAIL shim_marker_pad16");
        process_exit(1);
    }

    let pol1: ChaCha20SecurityPolicy = shim_marker_policy_default();
    let pol2: ChaCha20SecurityPolicy = shim_marker_policy_default();
    if (pol1).min_rounds != (pol2).min_rounds {
        println("FAIL shim_marker_policy_default");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_sec_crypto_chacha20_oo();
    if dummy != 0 {
        println("FAIL __dummy_std_src_ooda_sec_crypto_chacha20_oo");
        process_exit(1);
    }

    println("prod_g4_sec_chacha20: PASSED");
    process_exit(0);
}
