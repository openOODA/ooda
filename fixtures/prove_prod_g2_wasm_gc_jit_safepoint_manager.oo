// # Product prove std/wasm_gc/jit_safepoint_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_map_entry_new is a real value.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_safepoint_manager.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call stack_map_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jit_safepoint_manager: PASSED only if they match.

import "std/wasm_gc/jit_safepoint_manager.oo";

pub fn main() {
    let g2_oa: StackMapEntry = stack_map_entry_new(2);
    let g2_ob: StackMapEntry = stack_map_entry_new(2);
    let g2_a = (g2_oa).code_offset;
    let g2_b = (g2_ob).code_offset;
    if g2_a != g2_b {
        println("FAIL stack_map_entry_new.code_offset");
        process_exit(1);
    }
    println("prod_g2_jit_safepoint_manager: PASSED");
}
