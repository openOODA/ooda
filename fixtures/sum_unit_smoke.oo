// # User sum unit variant emit lock
//
// Logline: Fail-closed emit+gcc+run of On | Off with no payload.
//
// Setup: Backend-C. Unit arms are tags, not Int 0 for both.
//
// Beats:
//   1. On match yields 1.
//   2. Off match yields 0.
//   3. Exit 1 before PASSED on a miss.

type Flag = On | Off;

pub fn main() {
    let a: Flag = On;
    let v: Int = match a {
        On => 1,
        Off => 0
    };
    if v != 1 {
        println("FAIL on");
        process_exit(1);
    }
    let b: Flag = Off;
    let v2: Int = match b {
        On => 1,
        Off => 0
    };
    if v2 != 0 {
        println("FAIL off");
        process_exit(1);
    }
    println("sum_unit_smoke: PASSED");
}
