// # Product prove std/quantum_advanced/quantum_color_code.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_green is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_color_code.oo.
//
// Beats:
//   1. Call color_green twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_color_code: PASSED only if they match.

import "std/quantum_advanced/quantum_color_code.oo";

pub fn main() {
    let quantum_color_code_mark: Int = 0;
    if quantum_color_code_mark != 0 {
        process_exit(1);
    }
    let quantum_color_code_a = color_green();
    let quantum_color_code_b = color_green();
    if (quantum_color_code_a).color_id != (quantum_color_code_b).color_id {
        println("FAIL color_green");
        process_exit(1);
    }
    println("prod_quantum_color_code: PASSED");
}
