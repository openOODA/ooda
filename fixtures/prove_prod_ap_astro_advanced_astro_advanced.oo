// # Product prove std/astro_advanced/astro_advanced.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/astro_advanced.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/astro_advanced.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_astro_advanced: PASSED only if they match.

import "std/astro_advanced/astro_advanced.oo";

pub fn main() {
    let astro_advanced_a = astro_adv_ok();
    let astro_advanced_b = astro_adv_ok();
    if astro_advanced_a != astro_advanced_b {
        println("FAIL astro_advanced");
        process_exit(1);
    }
    println("prod_ap_astro_advanced: PASSED");
}
