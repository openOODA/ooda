// # Product prove std/tda_topology/topological_time_series_delay.oo
//
// Logline: Fail-closed emit+gcc+run asserts delay_point_cloud_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/topological_time_series_delay.oo.
//
// Beats:
//   1. Call delay_point_cloud_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_time_series_delay: PASSED only if they match.

import "std/tda_topology/topological_time_series_delay.oo";

pub fn main() {
    let topological_time_series_delay_mark: Int = 0;
    if topological_time_series_delay_mark != 0 {
        process_exit(1);
    }
    let topological_time_series_delay_a = delay_point_cloud_new(delay_config_new(1, 1));
    let topological_time_series_delay_b = delay_point_cloud_new(delay_config_new(1, 1));
    if (topological_time_series_delay_a).vector_count != (topological_time_series_delay_b).vector_count {
        println("FAIL delay_point_cloud_new");
        process_exit(1);
    }
    println("prod_topological_time_series_delay: PASSED");
}
