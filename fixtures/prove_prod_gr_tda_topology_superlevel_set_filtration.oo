// # Product prove std/tda_topology/superlevel_set_filtration.oo
//
// Logline: Fail-closed emit+gcc+run asserts merge_tree_record_merge is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/superlevel_set_filtration.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call merge_tree_record_merge twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_superlevel_set_filtration: PASSED only if they match.

import "std/tda_topology/superlevel_set_filtration.oo";

pub fn main() {
    let mut g0_oa = superlevel_merge_tree_new();
    let mut g0_ob = superlevel_merge_tree_new();
    let g0_a = merge_tree_record_merge(&g0_oa, 0, 0, 0.0, 0.0);
    let g0_b = merge_tree_record_merge(&g0_ob, 0, 0, 0.0, 0.0);
    if g0_a != g0_b {
        println("FAIL merge_tree_record_merge");
        process_exit(1);
    }
    println("prod_gr_superlevel_set_filtration: PASSED");
