// # Product prove std/math/matrix_solve.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix_solve_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/math/matrix_solve.oo.
//
// Beats:
//   1. Call matrix_solve_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_matrix_solve: PASSED only if they match.

import "std/math/matrix_solve.oo";

pub fn main() {
    let a = matrix_solve_probe();
    let b = matrix_solve_probe();
    if a != b {
        println("FAIL matrix_solve_probe");
        process_exit(1);
    }
    println("prod_matrix_solve: PASSED");
}
