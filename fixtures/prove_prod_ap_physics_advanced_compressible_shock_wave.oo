// # Product prove std/physics_advanced/compressible_shock_wave.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/compressible_shock_wave.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_shock_wave.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_compressible_shock_wave: PASSED only if they match.

import "std/physics_advanced/compressible_shock_wave.oo";

pub fn main() {
    let compressible_shock_wave_a = oblique_shock_deflection_theta(0.0, 0.0, 0.0);
    let compressible_shock_wave_b = oblique_shock_deflection_theta(0.0, 0.0, 0.0);
    if compressible_shock_wave_a != compressible_shock_wave_b {
        println("FAIL compressible_shock_wave");
        process_exit(1);
    }
    println("prod_ap_compressible_shock_wave: PASSED");
}
