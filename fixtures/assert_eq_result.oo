// M161: assert_eq! + structural == on Result[String,String] (OoResS)
// job: prove Ok/Err equality for verify harness rewrite and main-path assert_eq
// residual: String payload only; generic Result[T,E] not lowered

pub fn make_ok(s: String) -> Result[String, String] {
    return Ok(s);
}

pub fn make_err(s: String) -> Result[String, String] {
    return Err(s);
}

// Co-located verify: assert_eq! rewrites to != / == on Results (oo_res_eq).
verify make_ok {
    assert_eq!(make_ok("a"), Ok("a"));
    assert_eq!(make_err("e"), Err("e"));
}

pub fn main() {
    // Structural Ok == Ok
    let a: Result[String, String] = Ok("a");
    let b: Result[String, String] = Ok("a");
    if a == b {
        println("ok-eq");
    } else {
        println("ok-ne");
    }
    // Structural Err == Err
    let e1: Result[String, String] = Err("x");
    let e2: Result[String, String] = Err("x");
    if e1 == e2 {
        println("err-eq");
    } else {
        println("err-ne");
    }
    // Ok vs Err must not equal
    if a == e1 {
        println("should-not");
    } else {
        println("ok-err-ne");
    }
    // Direct assert_eq! (C _Generic OoResS / LLVM structural extractvalue)
    assert_eq!(make_ok("a"), Ok("a"));
    assert_eq!(make_err("boom"), Err("boom"));
    // Mismatch fail-closed would abort; equal payloads pass through
    assert_eq!(a, b);
    println("pass");
}
