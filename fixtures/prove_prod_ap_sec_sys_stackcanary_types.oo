import "std/sec/sys/stackcanary_types.oo";

pub fn main() {
    let stackcanary_types_a = stack_integrity_new();
    let stackcanary_types_b = stack_integrity_new();
    if stackcanary_types_a.total_frames_checked != stackcanary_types_b.total_frames_checked {
        println("FAIL stackcanary_types");
