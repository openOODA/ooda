// # Product prove std/fhe_lattices/fhe_tfhe_trgsw.oo
//
// Logline: Fail-closed emit+gcc+run asserts torus_cmux_eval_selector is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_tfhe_trgsw.oo.
//
// Beats:
//   1. Call torus_cmux_eval_selector twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_tfhe_trgsw: PASSED only if they match.

import "std/fhe_lattices/fhe_tfhe_trgsw.oo";

pub fn main() {
    let fhe_tfhe_trgsw_mark: Int = 0;
    if fhe_tfhe_trgsw_mark != 0 {
        process_exit(1);
    }
    let a: Float = torus_cmux_eval_selector(0.0, 0.0, 0.0);
    let b: Float = torus_cmux_eval_selector(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL torus_cmux_eval_selector");
        process_exit(1);
    }
    println("prod_g2_fhe_tfhe_trgsw: PASSED");
}
