// # emit-x86 generic dynamic List[T] fixture
//
// Logline: Dynamic List[T] operations: list_new, list_push (with doubling reallocation), list_get, list_len.
//
// Beats:
//   1. Allocate list_new().
//   2. Push 20 elements (exceeding initial 16 capacity to trigger doubling reallocation).
//   3. Read list_len, list_get(0), list_get(19).
//   4. Print values to verify x86_64 lowering.

pub fn main() {
    let mut xs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 20 {
        xs = list_push(xs, 100 + i);
        i = i + 1;
    }
    let n: Int = list_len(xs);
    let first: Int = list_get(xs, 0);
    let last: Int = list_get(xs, 19);
    println(n);
    println(first);
    println(last);
}
