// # Product prove std/media_dsp/synth_chorus_flanger_mod.oo
//
// Logline: Fail-closed emit+gcc+run asserts chorus_current_delay_samples is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_chorus_flanger_mod.oo.
//
// Beats:
//   1. Call chorus_current_delay_samples twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_synth_chorus_flanger_mod: PASSED only if they match.

import "std/media_dsp/synth_chorus_flanger_mod.oo";

pub fn main() {
    let synth_chorus_flanger_mod_mark: Int = 0;
    if synth_chorus_flanger_mod_mark != 0 {
        process_exit(1);
    }
    let synth_chorus_flanger_mod_obj: ChorusVoice = chorus_voice_default();
    let synth_chorus_flanger_mod_a: Float = chorus_current_delay_samples(&synth_chorus_flanger_mod_obj, 1.0, 1.0);
    let synth_chorus_flanger_mod_b: Float = chorus_current_delay_samples(&synth_chorus_flanger_mod_obj, 1.0, 1.0);
    if synth_chorus_flanger_mod_a != synth_chorus_flanger_mod_b {
        println("FAIL chorus_current_delay_samples");
        process_exit(1);
    }
    println("prod_synth_chorus_flanger_mod: PASSED");
}
