// # Product scatter_gather prove
//
// Logline: Fail-closed emit+gcc+run of shipped iovec add/count/gather.
//
// Setup: Product std/io/scatter_gather.oo. List[Int] destub.
//
// Beats:
//   1. add 7 then 3: count 2, gather_sum 10.
//   2. Exit 1 before PASSED on a miss.

import "std/io/scatter_gather.oo";

pub fn main() {
    let mut a: IoVecArray = iovec_array_new();
    a = iovec_array_add(a, 7);
    a = iovec_array_add(a, 3);
    let c: Int = iovec_array_count(a);
    if c != 2 {
        println("FAIL scatter count");
        process_exit(1);
    }
    let s: Int = iovec_gather_sum(a, 8);
    if s != 10 {
        println("FAIL scatter sum");
        process_exit(1);
    }
    let g0: Int = iovec_array_get(a, 0);
    if g0 != 7 {
        println("FAIL scatter get");
        process_exit(1);
    }
    println("prod_scatter: PASSED");
}
