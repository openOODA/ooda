// # Product hash FNV-1a 32 prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/fnv.oo.
//
// Setup: Product std/hash/fnv.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty is 2166136261.
//   2. a is 3826002220.
//   3. foobar is 3214735720.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/fnv.oo";

pub fn main() {
    let e: Int = fnv1a_32("");
    if e != 2166136261 {
        println("FAIL fnv empty");
        process_exit(1);
    }
    let a: Int = fnv1a_32("a");
    if a != 3826002220 {
        println("FAIL fnv a");
        process_exit(1);
    }
    let fb: Int = fnv1a_32("foobar");
    if fb != 3214735720 {
        println("FAIL fnv foobar");
        process_exit(1);
    }
    println("prod_hashfnv: PASSED");
}
