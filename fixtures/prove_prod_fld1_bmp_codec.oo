// # Product prove std/multimedia/bmp_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts bmp_row_stride is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/bmp_codec.oo.
//
// Beats:
//   1. Call bmp_row_stride twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bmp_codec: PASSED only if they match.

import "std/multimedia/bmp_codec.oo";

pub fn main() {
    let bmp_codec_mark: Int = 0;
    if bmp_codec_mark != 0 {
        process_exit(1);
    }
    let bmp_codec_a: Int = bmp_row_stride(1, 1);
    let bmp_codec_b: Int = bmp_row_stride(1, 1);
    if bmp_codec_a != bmp_codec_b {
        println("FAIL bmp_row_stride");
        process_exit(1);
    }
    println("prod_bmp_codec: PASSED");
}
