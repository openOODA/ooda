// # Product pipe prove
//
// Logline: Fail-closed emit+gcc+run of shipped pipe_write/available.
//
// Setup: Product std/io/pipe.oo. Write hi.
//
// Beats:
//   1. After write hi, available is 2.
//   2. Exit 1 before PASSED on a miss.

import "std/io/pipe.oo";

pub fn main() {
    let mut p: Pipe = pipe_new(16);
    p = pipe_write(p, "hi");
    let n: Int = pipe_available(p);
    if n != 2 {
        println("FAIL pipe avail");
        process_exit(1);
    }
    println("prod_pipe: PASSED");
}
