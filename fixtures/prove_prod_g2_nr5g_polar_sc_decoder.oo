// # Product prove std/telecom_5g/nr5g_polar_sc_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_polar_f_node_llr is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_polar_sc_decoder.oo.
//
// Beats:
//   1. Call nr5g_polar_f_node_llr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_nr5g_polar_sc_decoder: PASSED only if they match.

import "std/telecom_5g/nr5g_polar_sc_decoder.oo";

pub fn main() {
    let nr5g_polar_sc_decoder_mark: Int = 0;
    if nr5g_polar_sc_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Float = nr5g_polar_f_node_llr(0.0, 0.0);
    let b: Float = nr5g_polar_f_node_llr(0.0, 0.0);
    if a != b {
        println("FAIL nr5g_polar_f_node_llr");
        process_exit(1);
    }
    println("prod_g2_nr5g_polar_sc_decoder: PASSED");
}
