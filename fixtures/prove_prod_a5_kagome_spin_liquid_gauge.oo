// # Product prove std/quantum_topological/kagome_spin_liquid_gauge.oo
//
// Logline: Fail-closed emit+gcc+run asserts kagome_spinon_vison_mutual_phase is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/kagome_spin_liquid_gauge.oo.
//
// Beats:
//   1. Call kagome_spinon_vison_mutual_phase twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kagome_spin_liquid_gauge: PASSED only if they match.

import "std/quantum_topological/kagome_spin_liquid_gauge.oo";

pub fn main() {
    let kagome_spin_liquid_gauge_mark: Int = 0;
    if kagome_spin_liquid_gauge_mark != 0 {
        process_exit(1);
    }
    let a: Float = kagome_spinon_vison_mutual_phase();
    let b: Float = kagome_spinon_vison_mutual_phase();
    if a != b {
        println("FAIL kagome_spinon_vison_mutual_phase");
        process_exit(1);
    }
    println("prod_kagome_spin_liquid_gauge: PASSED");
}
