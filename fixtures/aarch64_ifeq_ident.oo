// # if x == 1 is leftover
//
// Logline: IDENT compare must fail closed and not emit YES.
//
// Setup: x is a bind, not a const INT cond prefix.
//
// Beats:
//   1. Bind x to 1.
//   2. if x == 1 print YES.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = 1;
    if x == 1 {
        println("YES");
    }
}
