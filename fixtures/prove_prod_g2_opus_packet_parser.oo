// # Product prove std/media_dsp/opus_packet_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts opus_parse_toc_byte is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/opus_packet_parser.oo.
//
// Beats:
//   1. Call opus_parse_toc_byte twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opus_packet_parser: PASSED only if they match.

import "std/media_dsp/opus_packet_parser.oo";

pub fn main() {
    let opus_packet_parser_mark: Int = 0;
    if opus_packet_parser_mark != 0 {
        process_exit(1);
    }
    let a: OpusToc = opus_parse_toc_byte(0);
    let b: OpusToc = opus_parse_toc_byte(0);
    if (a).config_id != (b).config_id {
        println("FAIL opus_parse_toc_byte");
        process_exit(1);
    }
    println("prod_g2_opus_packet_parser: PASSED");
}
