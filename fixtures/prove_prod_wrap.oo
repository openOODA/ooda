// # Product word wrap prove
//
// Logline: Fail-closed emit+gcc+run of shipped word_wrap_to_string.
//
// Setup: Product std/text/word_wrap.oo. Width 8 wraps hello world.
//
// Beats:
//   1. word_wrap_to_string hello world width 8 is hello\\nworld.
//   2. Width 20 stays one line.
//   3. Exit 1 before PASSED on a miss.

import "std/text/word_wrap.oo";

pub fn main() {
    let cfg: WrapConfig = wrap_config_new(8);
    let w: String = word_wrap_to_string("hello world", cfg);
    if w != "hello\nworld" {
        println("FAIL wrap 8");
        process_exit(1);
    }
    let wide: WrapConfig = wrap_config_new(20);
    let one: String = word_wrap_to_string("hello world", wide);
    if one != "hello world" {
        println("FAIL wrap 20");
        process_exit(1);
    }
    println("prod_wrap: PASSED");
}
