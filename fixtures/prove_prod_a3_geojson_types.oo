// # Product prove std/gis_spatial/geojson_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts geo_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/geojson_types.oo.
//
// Beats:
//   1. Call geo_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geojson_types: PASSED only if they match.

import "std/gis_spatial/geojson_types.oo";

pub fn main() {
    let geojson_types_mark: Int = 0;
    if geojson_types_mark != 0 {
        process_exit(1);
    }
    let a: GeoPoint2D = geo_point_new(0, 0);
    let b: GeoPoint2D = geo_point_new(0, 0);
    if (a).x != (b).x {
        println("FAIL geo_point_new");
        process_exit(1);
    }
    println("prod_geojson_types: PASSED");
}
