// # Product prove std/auto_mpc_control/regen_friction_brake_blend.oo
//
// Logline: Fail-closed emit+gcc+run asserts brake_blend_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/regen_friction_brake_blend.oo.
//
// Beats:
//   1. Call brake_blend_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_regen_friction_brake_blend: PASSED only if they match.

import "std/auto_mpc_control/regen_friction_brake_blend.oo";

pub fn main() {
    let regen_friction_brake_blend_mark: Int = 0;
    if regen_friction_brake_blend_mark != 0 {
        process_exit(1);
    }
    let a: BrakeBlendParams = brake_blend_params_default();
    let b: BrakeBlendParams = brake_blend_params_default();
    if (a).max_regen_force_n != (b).max_regen_force_n {
        println("FAIL brake_blend_params_default");
        process_exit(1);
    }
    println("prod_g2_regen_friction_brake_blend: PASSED");
}
