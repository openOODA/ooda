// # Product prove std/telecom_6g/thz_plasma_frequency_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts semiconductor_inas_sub_thz is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/thz_plasma_frequency_model.oo.
//
// Beats:
//   1. Call semiconductor_inas_sub_thz twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thz_plasma_frequency_model: PASSED only if they match.

import "std/telecom_6g/thz_plasma_frequency_model.oo";

pub fn main() {
    let a: SemiconductorCarrierModel = semiconductor_inas_sub_thz();
    let b: SemiconductorCarrierModel = semiconductor_inas_sub_thz();
    if a.carrier_density_m3 != b.carrier_density_m3 {
        println("FAIL semiconductor_inas_sub_thz");
        process_exit(1);
    }
    println("prod_thz_plasma_frequency_model: PASSED");
}
