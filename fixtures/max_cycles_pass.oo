// # Pass while under MaxCycles budget
//
// Logline: A short while loop stays under the file-level cycle budget and prints the count.
//
// Beats:
//   1. Honor the line-start fuel directive as the shared budget.
//   2. Increment a counter three times while under eight cycles.
//   3. Print the final count for the pass rail.

// M48 MaxCycles path A — pass: while iterations under budget
// MAX_CYCLES: 8
pub fn main() {
    let mut i = 0;
    while i < 3 {
        i = i + 1;
    }
    println(i);
}
