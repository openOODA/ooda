// # Product prove std/ai_multimodal/audio_whisper_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts whisper_decoder_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/audio_whisper_decoder.oo.
//
// Beats:
//   1. Call whisper_decoder_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audio_whisper_decoder: PASSED only if they match.

import "std/ai_multimodal/audio_whisper_decoder.oo";

pub fn main() {
    let a: WhisperDecoderConfig = whisper_decoder_config_new(0, 0, 0, 0);
    let b: WhisperDecoderConfig = whisper_decoder_config_new(0, 0, 0, 0);
    if a.vocab_size != b.vocab_size {
        println("FAIL whisper_decoder_config_new");
        process_exit(1);
    }
    println("prod_audio_whisper_decoder: PASSED");
}
