// # Product prove std/edge/ota.oo
//
// Logline: Fail-closed verification that OTA facade shim operations and update lifecycle methods are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/ota.oo.
//
// Beats:
//   1. Construct OTA manifests and slots via shim markers.
//   2. Initialize OTA manager and verify state transitions across update chunks.
//   3. Execute payload verification, apply update, and confirm boot.
//   4. Print prod_g4_edge_ota: PASSED and exit 0.

import "std/edge/ota.oo";

pub fn main() {
    let m_a: OtaManifest = shim_marker_manifest_new();
    let m_b: OtaManifest = shim_marker_manifest_new();
    if (m_a).version_major != (m_b).version_major || (m_a).image_size_bytes != 1024 {
        println("FAIL shim_marker_manifest_new");
        process_exit(1);
    }

    let s_a: OtaPartitionSlot = shim_marker_slot_new();
    let s_b: OtaPartitionSlot = shim_marker_slot_new();
    if (s_a).slot_id != (s_b).slot_id || (s_a).version_code != 10000 {
        println("FAIL shim_marker_slot_new");
        process_exit(1);
    }

    let cap: &SysCap = 0;
    let mut mgr_a: OtaManager = shim_marker_manager_init(cap);
    let mut mgr_b: OtaManager = shim_marker_manager_init(cap);
    let busy_a: Bool = shim_marker_is_busy(&mgr_a);
    let busy_b: Bool = shim_marker_is_busy(&mgr_b);
    if busy_a != busy_b || busy_a != false {
        println("FAIL shim_marker_is_busy initial");
        process_exit(1);
    }

    let start_a: Bool = shim_marker_start_update(&mut mgr_a, &m_a);
    let start_b: Bool = shim_marker_start_update(&mut mgr_b, &m_b);
    if start_a != start_b || !start_a {
        println("FAIL shim_marker_start_update");
        process_exit(1);
    }

    let chunk_a: Int = shim_marker_chunk_recv(&mut mgr_a);
    let chunk_b: Int = shim_marker_chunk_recv(&mut mgr_b);
    if chunk_a != chunk_b || chunk_a != 2 {
        println("FAIL shim_marker_chunk_recv");
        process_exit(1);
    }

    let verify_a: Bool = shim_marker_verify_payload(&mut mgr_a);
    let verify_b: Bool = shim_marker_verify_payload(&mut mgr_b);
    if verify_a != verify_b || !verify_a {
        println("FAIL shim_marker_verify_payload");
        process_exit(1);
    }

    let apply_a: Bool = shim_marker_apply_update(&mut mgr_a, cap);
    let apply_b: Bool = shim_marker_apply_update(&mut mgr_b, cap);
    if apply_a != apply_b || !apply_a {
        println("FAIL shim_marker_apply_update");
        process_exit(1);
    }

    let boot_a: Bool = shim_marker_mark_boot(&mut mgr_a);
    let boot_b: Bool = shim_marker_mark_boot(&mut mgr_b);
    if boot_a != boot_b || !boot_a {
        println("FAIL shim_marker_mark_boot");
        process_exit(1);
    }

    println("prod_g4_edge_ota: PASSED");
    process_exit(0);
}
