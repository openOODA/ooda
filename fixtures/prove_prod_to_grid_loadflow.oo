// # Product prove std/grid/loadflow.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_math_pi holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/loadflow.oo.
//
// Beats:
//   1. Call shim_marker_math_pi using the loadflow ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_loadflow: PASSED only if asserts hold.

import "std/grid/loadflow.oo";

pub fn main() {
    let loadflow_a = shim_marker_math_pi();
    let loadflow_b = shim_marker_math_pi();
    if loadflow_a != loadflow_b {
        println("FAIL shim_marker_math_pi");
        process_exit(1);
    }
    println("prod_loadflow: PASSED");
}
