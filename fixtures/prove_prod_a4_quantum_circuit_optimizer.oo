// # Product prove std/quantum_advanced/quantum_circuit_optimizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts circuit_merge_rotations_angle is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_circuit_optimizer.oo.
//
// Beats:
//   1. Call circuit_merge_rotations_angle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_circuit_optimizer: PASSED only if they match.

import "std/quantum_advanced/quantum_circuit_optimizer.oo";

pub fn main() {
    let quantum_circuit_optimizer_mark: Int = 0;
    if quantum_circuit_optimizer_mark != 0 {
        process_exit(1);
    }
    let a: Float = circuit_merge_rotations_angle(0.0, 0.0);
    let b: Float = circuit_merge_rotations_angle(0.0, 0.0);
    if a != b {
        println("FAIL circuit_merge_rotations_angle");
        process_exit(1);
    }
    println("prod_quantum_circuit_optimizer: PASSED");
}
