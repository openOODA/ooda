// # Product prove std/robot/safety_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts safety_fault_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/robot/safety_stubs.oo.
//
// Beats:
//   1. Call safety_fault_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_safety_stubs: PASSED only if asserts hold.

import "std/robot/safety_stubs.oo";

pub fn main() {
    let safety_stubs_a: SafetyFault = safety_fault_new(0, 0, 0);
    let safety_stubs_b: SafetyFault = safety_fault_new(0, 0, 0);
    if safety_stubs_a.code != safety_stubs_b.code {
        println("FAIL safety_fault_new");
        process_exit(1);
    }
    println("prod_safety_stubs: PASSED");
}
