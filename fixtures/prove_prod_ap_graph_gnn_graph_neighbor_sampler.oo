// # Product prove std/graph_gnn/graph_neighbor_sampler.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_gnn/graph_neighbor_sampler.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_neighbor_sampler.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_neighbor_sampler: PASSED only if they match.

import "std/graph_gnn/graph_neighbor_sampler.oo";

pub fn main() {
    let graph_neighbor_sampler_a = csr_graph_new(0, 0, list_new(), list_new());
    let graph_neighbor_sampler_b = csr_graph_new(0, 0, list_new(), list_new());
    if graph_neighbor_sampler_a.num_nodes != graph_neighbor_sampler_b.num_nodes {
        println("FAIL graph_neighbor_sampler");
        process_exit(1);
    }
    println("prod_ap_graph_neighbor_sampler: PASSED");
}
