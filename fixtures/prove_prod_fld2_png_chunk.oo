// # Product prove std/multimedia/png_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_crc32_byte_table is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_chunk.oo.
//
// Beats:
//   1. Call png_crc32_byte_table twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_png_chunk: PASSED only if they match.

import "std/multimedia/png_chunk.oo";

pub fn main() {
    let png_chunk_mark: Int = 0;
    if png_chunk_mark != 0 {
        process_exit(1);
    }
    let png_chunk_a: Int = png_crc32_byte_table(1);
    let png_chunk_b: Int = png_crc32_byte_table(1);
    if png_chunk_a != png_chunk_b {
        println("FAIL png_crc32_byte_table");
        process_exit(1);
    }
    println("prod_png_chunk: PASSED");
}
