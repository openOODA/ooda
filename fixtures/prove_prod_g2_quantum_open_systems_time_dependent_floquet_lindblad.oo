// # Product prove std/quantum_open_systems/time_dependent_floquet_lindblad.oo
//
// Logline: Fail-closed emit+gcc+run asserts floquet_quasi_energy_splitting is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/time_dependent_floquet_lindblad.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call floquet_quasi_energy_splitting twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_time_dependent_floquet_lindblad: PASSED only if they match.

import "std/quantum_open_systems/time_dependent_floquet_lindblad.oo";

pub fn main() {
    let g2_oa: FloquetDriveParams = FloquetDriveParams { static_detuning_delta: 1.0, drive_amplitude_v0: 1.0, drive_frequency_omega: 1.0 };
    let g2_ob: FloquetDriveParams = FloquetDriveParams { static_detuning_delta: 1.0, drive_amplitude_v0: 1.0, drive_frequency_omega: 1.0 };
    let g2_a = floquet_quasi_energy_splitting(g2_oa);
    let g2_b = floquet_quasi_energy_splitting(g2_ob);
    if g2_a != g2_b {
        println("FAIL floquet_quasi_energy_splitting");
        process_exit(1);
    }
    println("prod_g2_time_dependent_floquet_lindblad: PASSED");
}
