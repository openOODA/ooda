// # Product prove std/digital_twin/twin_battery_electrochemical_ecm.oo
//
// Logline: Fail-closed emit+gcc+run asserts battery_eval_ocv is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/twin_battery_electrochemical_ecm.oo.
//
// Beats:
//   1. Call battery_eval_ocv twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_twin_battery_electrochemical_ecm: PASSED only if they match.

import "std/digital_twin/twin_battery_electrochemical_ecm.oo";

pub fn main() {
    let twin_battery_electrochemical_ecm_mark: Int = 0;
    if twin_battery_electrochemical_ecm_mark != 0 {
        process_exit(1);
    }
    let a: Float = battery_eval_ocv(0.0);
    let b: Float = battery_eval_ocv(0.0);
    if a != b {
        println("FAIL battery_eval_ocv");
        process_exit(1);
    }
    println("prod_twin_battery_electrochemical_ecm: PASSED");
}
