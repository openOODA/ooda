// # Product prove std/security_defense/constant_time_memcmp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/constant_time_memcmp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/constant_time_memcmp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_constant_time_memcmp: PASSED only if they match.

import "std/security_defense/constant_time_memcmp.oo";

pub fn main() {
    let constant_time_memcmp_a = constant_time_memcmp_bytes(list_new(), list_new(), 0);
    let constant_time_memcmp_b = constant_time_memcmp_bytes(list_new(), list_new(), 0);
    if constant_time_memcmp_a != constant_time_memcmp_b {
        println("FAIL constant_time_memcmp");
        process_exit(1);
    }
    println("prod_ap_constant_time_memcmp: PASSED");
}
