// # Product prove std/quantum_advanced/randomized_benchmarking.oo
//
// Logline: Fail-closed emit+gcc+run asserts rb_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/randomized_benchmarking.oo.
//
// Beats:
//   1. Call rb_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_randomized_benchmarking: PASSED only if they match.

import "std/quantum_advanced/randomized_benchmarking.oo";

pub fn main() {
    let a: RbConfig = rb_config_new(0, 0, 0);
    let b: RbConfig = rb_config_new(0, 0, 0);
    if a.num_qubits != b.num_qubits {
        println("FAIL rb_config_new");
        process_exit(1);
    }
    println("prod_randomized_benchmarking: PASSED");
}
