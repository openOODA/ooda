// # Product prove std/digital_twin/bond_graph_causality_scap.oo
//
// Logline: Fail-closed emit+gcc+run asserts scap_verify_junction_rules is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_causality_scap.oo.
//
// Beats:
//   1. Call scap_verify_junction_rules twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bond_graph_causality_scap: PASSED only if they match.

import "std/digital_twin/bond_graph_causality_scap.oo";

pub fn main() {
    let bond_graph_causality_scap_mark: Int = 0;
    if bond_graph_causality_scap_mark != 0 {
        process_exit(1);
    }
    let a: Bool = scap_verify_junction_rules(true, 0, 0, 0);
    let b: Bool = scap_verify_junction_rules(true, 0, 0, 0);
    if a != b {
        println("FAIL scap_verify_junction_rules");
        process_exit(1);
    }
    println("prod_g2_bond_graph_causality_scap: PASSED");
}
