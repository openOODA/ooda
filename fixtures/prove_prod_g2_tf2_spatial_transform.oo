// # Product prove std/robotics_ros2/tf2_spatial_transform.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/tf2_spatial_transform.oo.
//
// Beats:
//   1. Call vector3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tf2_spatial_transform: PASSED only if they match.

import "std/robotics_ros2/tf2_spatial_transform.oo";

pub fn main() {
    let tf2_spatial_transform_mark: Int = 0;
    if tf2_spatial_transform_mark != 0 {
        process_exit(1);
    }
    let a: Vector3 = vector3_new(0.0, 0.0, 0.0);
    let b: Vector3 = vector3_new(0.0, 0.0, 0.0);
    if (a).x != (b).x {
        println("FAIL vector3_new");
        process_exit(1);
    }
    println("prod_g2_tf2_spatial_transform: PASSED");
}
