// # emit-x86 real one-arg greet call
//
// Logline: Print greet World via a call so emit-x86 must lea %rdi then concat in the bump.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. Not hello.oo fold shape.
//
// Beats:
//   1. Declare greet as prefix plus name plus suffix.
//   2. Print greet("World") directly.
//   3. Expect Hello, World! from a real call.

fn greet(name: String) -> String {
    return "Hello, " + name + "!";
}

pub fn main() {
    println(greet("World"));
}
