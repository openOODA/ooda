// # Product prove std/telecom/doppler_shift.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/telecom/doppler_shift.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/doppler_shift.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_doppler_shift: PASSED only if they match.

import "std/telecom/doppler_shift.oo";

pub fn main() {
    let doppler_shift_a = doppler_pi();
    let doppler_shift_b = doppler_pi();
    if doppler_shift_a != doppler_shift_b {
        println("FAIL doppler_shift");
        process_exit(1);
    }
    println("prod_ap_doppler_shift: PASSED");
}
