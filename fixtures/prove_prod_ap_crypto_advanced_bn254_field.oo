// # Product prove std/crypto_advanced/bn254_field.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/bn254_field.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bn254_field.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_bn254_field: PASSED only if they match.

import "std/crypto_advanced/bn254_field.oo";

pub fn main() {
    let bn254_field_a = bn254_fp_new(0, 0);
    let bn254_field_b = bn254_fp_new(0, 0);
    if bn254_field_a.val != bn254_field_b.val {
        println("FAIL bn254_field");
        process_exit(1);
    }
    println("prod_ap_bn254_field: PASSED");
}
