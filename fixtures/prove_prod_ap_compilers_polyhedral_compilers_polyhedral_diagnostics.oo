// # Product prove std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_compilers_polyhedral_diagnostics: PASSED only if they match.

import "std/compilers_polyhedral/compilers_polyhedral_diagnostics.oo";

pub fn main() {
    let compilers_polyhedral_diagnostics_a = polyhedral_audit_report_new("x");
    let compilers_polyhedral_diagnostics_b = polyhedral_audit_report_new("x");
    let compilers_polyhedral_diagnostics_va = audit_report_summarize_speedup(compilers_polyhedral_diagnostics_a);
    let compilers_polyhedral_diagnostics_vb = audit_report_summarize_speedup(compilers_polyhedral_diagnostics_b);
    if compilers_polyhedral_diagnostics_va != compilers_polyhedral_diagnostics_vb {
        println("FAIL compilers_polyhedral_diagnostics");
        process_exit(1);
    }
    println("prod_ap_compilers_polyhedral_diagnostics: PASSED");
}
