// # Product prove std/formal_verif/wp_calculus_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts wp_eval_skip is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/wp_calculus_evaluator.oo.
//
// Beats:
//   1. Call wp_eval_skip twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wp_calculus_evaluator: PASSED only if they match.

import "std/formal_verif/wp_calculus_evaluator.oo";

pub fn main() {
    let wp_calculus_evaluator_mark: Int = 0;
    if wp_calculus_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: String = wp_eval_skip("x");
    let b: String = wp_eval_skip("x");
    if a != b {
        println("FAIL wp_eval_skip");
        process_exit(1);
    }
    println("prod_wp_calculus_evaluator: PASSED");
}
