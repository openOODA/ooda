// # Collection for-in List[String] emit lock
//
// Logline: Fail-closed emit+gcc+run of for x in xs over List[String].
//
// Setup: Backend-C. Loop body sees String elements.
//
// Beats:
//   1. Push a and b.
//   2. Concat with for x in xs.
//   3. Exit 1 before PASSED when the concat is not ab.

pub fn main() {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    let mut s: String = "";
    for x in xs {
        s = s + x;
    }
    if s != "ab" {
        println("FAIL");
        process_exit(1);
    }
    println("for_list_str_smoke: PASSED");
}
