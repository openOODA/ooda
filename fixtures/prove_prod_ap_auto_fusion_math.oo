// # Product prove std/auto/fusion_math.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/fusion_math.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/fusion_math.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fusion_math: PASSED only if they match.

import "std/auto/fusion_math.oo";

pub fn main() {
    let fusion_math_a = fus_vec3_new(0, 0, 0);
    let fusion_math_b = fus_vec3_new(0, 0, 0);
    let fusion_math_va = fus_vec3_x(fusion_math_a);
    let fusion_math_vb = fus_vec3_x(fusion_math_b);
    if fusion_math_va != fusion_math_vb {
        println("FAIL fusion_math");
        process_exit(1);
    }
    println("prod_ap_fusion_math: PASSED");
}
