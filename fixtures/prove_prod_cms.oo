// # Product count_min_sketch prove
//
// Logline: Fail-closed emit+gcc+run of shipped count_min_sketch_add/estimate.
//
// Setup: Product std/collections/count_min_sketch.oo. Width 8 depth 1, hash 3.
//
// Beats:
//   1. After add hash 3 count 1, estimate 3 is 1; estimate 4 is 0.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/count_min_sketch.oo";

pub fn main() {
    let mut s: CountMinSketch = count_min_sketch_new(8, 1);
    s = count_min_sketch_add(s, 3, 1);
    let e3: Int = count_min_sketch_estimate(s, 3);
    if e3 != 1 {
        println("FAIL cms est 3");
        process_exit(1);
    }
    let e4: Int = count_min_sketch_estimate(s, 4);
    if e4 != 0 {
        println("FAIL cms est 4");
        process_exit(1);
    }
    println("prod_cms: PASSED");
}
