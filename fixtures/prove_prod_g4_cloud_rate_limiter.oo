// # Product prove std/cloud_k8s/rate_limiter_sliding_window.oo
//
// Logline: Fail-closed verification that sliding window rate limiter is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/rate_limiter_sliding_window.oo.
//
// Beats:
//   1. Create sliding window rate limiters with identical parameters.
//   2. Call sliding_window_allow and sliding_window_advance.
//   3. Assert deterministic quota evaluation and window advancement.
//   4. Print prod_g4_cloud_rate_limiter: PASSED and exit 0.

import "std/cloud_k8s/rate_limiter_sliding_window.oo";

pub fn main() {
    let mut sw1: SlidingWindowLimiter = sliding_window_new(5, 1000, 1000);
    let mut sw2: SlidingWindowLimiter = sliding_window_new(5, 1000, 1000);

    let allow1_a: Bool = sliding_window_allow(&mut sw1, 1000);
    let allow1_b: Bool = sliding_window_allow(&mut sw2, 1000);
    if allow1_a != allow1_b {
        println("FAIL sliding_window_allow 1");
        process_exit(1);
    }
    if allow1_a != true {
        println("FAIL sliding_window_allow 1 expected true");
        process_exit(1);
    }

    let allow2_a: Bool = sliding_window_allow(&mut sw1, 1100);
    let allow2_b: Bool = sliding_window_allow(&mut sw2, 1100);
    if allow2_a != allow2_b {
        println("FAIL sliding_window_allow 2");
        process_exit(1);
    }
    if allow2_a != true {
        println("FAIL sliding_window_allow 2 expected true");
        process_exit(1);
    }

    sliding_window_advance(&mut sw1, 2500);
    sliding_window_advance(&mut sw2, 2500);

    let allow3_a: Bool = sliding_window_allow(&mut sw1, 2500);
    let allow3_b: Bool = sliding_window_allow(&mut sw2, 2500);
    if allow3_a != allow3_b {
        println("FAIL sliding_window_allow 3");
        process_exit(1);
    }
    if allow3_a != true {
        println("FAIL sliding_window_allow 3 expected true");
        process_exit(1);
    }

    println("prod_g4_cloud_rate_limiter: PASSED");
    process_exit(0);
}
