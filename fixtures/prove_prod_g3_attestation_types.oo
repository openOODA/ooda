// # Product prove std/sec/attestation_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts attestation_policy_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/attestation_types.oo.
//
// Beats:
//   1. Call attestation_policy_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_attestation_types: PASSED only if they match.

import "std/sec/attestation_types.oo";

pub fn main() {
    let attestation_types_mark: Int = 0;
    if attestation_types_mark != 0 {
        process_exit(1);
    }
    let a: AttestationPolicy = attestation_policy_new(0, 0);
    let b: AttestationPolicy = attestation_policy_new(0, 0);
    if (a).min_trust_score != (b).min_trust_score {
        println("FAIL attestation_policy_new");
        process_exit(1);
    }
    println("prod_attestation_types: PASSED");
}
