// # Product prove std/os/env.oo
//
// Logline: Fail-closed emit+gcc+run asserts env_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/env.oo.
//
// Beats:
//   1. Call env_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_env: PASSED only if they match.

import "std/os/env.oo";

pub fn main() {
    let a = env_probe();
    let b = env_probe();
    if a != b {
        println("FAIL env_probe");
        process_exit(1);
    }
    println("prod_env: PASSED");
}
