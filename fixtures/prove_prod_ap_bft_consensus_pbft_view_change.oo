// # Product prove std/bft_consensus/pbft_view_change.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/pbft_view_change.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/pbft_view_change.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pbft_view_change: PASSED only if they match.

import "std/bft_consensus/pbft_view_change.oo";

pub fn main() {
    let pbft_view_change_a = view_change_elect_primary(0, 0);
    let pbft_view_change_b = view_change_elect_primary(0, 0);
    if pbft_view_change_a != pbft_view_change_b {
        println("FAIL pbft_view_change");
        process_exit(1);
    }
    println("prod_ap_pbft_view_change: PASSED");
}
