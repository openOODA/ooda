// # Product prove std/iot_scada/plc_sequential_function_chart.oo
//
// Logline: Fail-closed emit+gcc+run asserts sfc_transition_eval is a real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/plc_sequential_function_chart.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call sfc_transition_eval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_plc_sequential_function_chart: PASSED only if they match.

import "std/iot_scada/plc_sequential_function_chart.oo";

pub fn main() {
    let g0_oa: SfcStep = SfcStep { step_id: 0, is_initial: true, is_active: true, active_time_ms: 0 };
    let g0_ob: SfcStep = SfcStep { step_id: 0, is_initial: true, is_active: true, active_time_ms: 0 };
    let g0_a = sfc_transition_eval(&g0_oa, true);
    let g0_b = sfc_transition_eval(&g0_ob, true);
    if g0_a != g0_b {
        println("FAIL sfc_transition_eval");
        process_exit(1);
    }
    println("prod_gr_plc_sequential_function_chart: PASSED");
}
