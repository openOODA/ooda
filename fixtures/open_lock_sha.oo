// # SHA-256 lock payload
//
// Logline: A lock string hashes to 64 hex chars. Not a live registry.
//
// Setup: OPEN-42. crypto_sha256_internal. ooda add stays residual.
//
// Beats:
//   1. Hash pkg@1.0.
//   2. Require length 64.
//   3. Print PASSED.

pub fn main() {
    let h: String = crypto_sha256_internal("pkg@1.0");
    if chars_len(h) != 64 {
        println("FAIL len");
        process_exit(1);
    }
    println(h);
    println("open_lock_sha: PASSED");
}