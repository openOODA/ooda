// # Product prove std/quantum_tensor_nets/string_bond_states_sbs.oo
//
// Logline: Fail-closed emit+gcc+run asserts sbs_string_pattern_new is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/string_bond_states_sbs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sbs_string_pattern_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_string_bond_states_sbs: PASSED only if they match.

import "std/quantum_tensor_nets/string_bond_states_sbs.oo";

pub fn main() {
    let g2_oa: SbsStringPattern = sbs_string_pattern_new(2, list_new(), 2);
    let g2_ob: SbsStringPattern = sbs_string_pattern_new(2, list_new(), 2);
    let g2_a = (g2_oa).string_id;
    let g2_b = (g2_ob).string_id;
    if g2_a != g2_b {
        println("FAIL sbs_string_pattern_new.string_id");
        process_exit(1);
    }
    println("prod_g2_string_bond_states_sbs: PASSED");
}
