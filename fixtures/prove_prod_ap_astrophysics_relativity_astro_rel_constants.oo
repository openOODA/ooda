// # Product prove std/astrophysics_relativity/astro_rel_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/astro_rel_constants.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/astro_rel_constants.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_astro_rel_constants: PASSED only if they match.

import "std/astrophysics_relativity/astro_rel_constants.oo";

pub fn main() {
    let astro_rel_constants_a = const_c();
    let astro_rel_constants_b = const_c();
    if astro_rel_constants_a != astro_rel_constants_b {
        println("FAIL astro_rel_constants");
        process_exit(1);
    }
    println("prod_ap_astro_rel_constants: PASSED");
}
