// # Product prove std/graph_topology/k_core_decomposition.oo
//
// Logline: Fail-closed verification of k-core graph decomposition and coreness pruning.
//
// Setup: Isolated emit-c. Imports std/graph_topology/k_core_decomposition.oo.
//
// Beats:
//   1. Construct an undirected graph with a 3-clique and a degree-1 leaf.
//   2. Compute k-core decomposition and assert max_core and per-vertex coreness values.
//   3. Filter vertices belonging to 2-core, 1-core, and 3-core subgraphs.
//   4. Print prod_g4_graph_k_core: PASSED and exit 0.

import "std/graph_topology/k_core_decomposition.oo";

pub fn main() {
    let mut g: GraphAdjList = adj_list_create(false);
    adj_list_add_edge(&mut g, 0, 1, 1);
    adj_list_add_edge(&mut g, 1, 2, 1);
    adj_list_add_edge(&mut g, 2, 0, 1);
    adj_list_add_edge(&mut g, 2, 3, 1);

    let res1: KCoreResult = k_core_decompose(&g, 4);
    let res2: KCoreResult = k_core_decompose(&g, 4);

    let max_c1: Int = (res1).max_core;
    let max_c2: Int = (res2).max_core;
    if max_c1 != max_c2 || max_c1 != 2 {
        println("FAIL max_core");
        process_exit(1);
    }

    let c0: Int = k_core_get_coreness(&res1, 0);
    let c1: Int = k_core_get_coreness(&res1, 1);
    let c2: Int = k_core_get_coreness(&res1, 2);
    let c3: Int = k_core_get_coreness(&res1, 3);

    if c0 != 2 || c1 != 2 || c2 != 2 || c3 != 1 {
        println("FAIL coreness values");
        process_exit(1);
    }

    let k2_nodes: List[Int] = k_core_filter_k(&res1, 2);
    let k1_nodes: List[Int] = k_core_filter_k(&res1, 1);
    let k3_nodes: List[Int] = k_core_filter_k(&res1, 3);

    let len_k2: Int = list_len(k2_nodes);
    let len_k1: Int = list_len(k1_nodes);
    let len_k3: Int = list_len(k3_nodes);

    if len_k2 != 3 || len_k1 != 4 || len_k3 != 0 {
        println("FAIL filter_k counts");
        process_exit(1);
    }

    println("prod_g4_graph_k_core: PASSED");
    process_exit(0);
}
