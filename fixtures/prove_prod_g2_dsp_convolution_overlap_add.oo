// # Product prove std/media_dsp/dsp_convolution_overlap_add.oo
//
// Logline: Fail-closed emit+gcc+run asserts dsp_ola_engine_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/dsp_convolution_overlap_add.oo.
//
// Beats:
//   1. Call dsp_ola_engine_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dsp_convolution_overlap_add: PASSED only if they match.

import "std/media_dsp/dsp_convolution_overlap_add.oo";

pub fn main() {
    let dsp_convolution_overlap_add_mark: Int = 0;
    if dsp_convolution_overlap_add_mark != 0 {
        process_exit(1);
    }
    let a: OverlapAddEngine = dsp_ola_engine_new(0, 0);
    let b: OverlapAddEngine = dsp_ola_engine_new(0, 0);
    if (a).block_length_l != (b).block_length_l {
        println("FAIL dsp_ola_engine_new");
        process_exit(1);
    }
    println("prod_g2_dsp_convolution_overlap_add: PASSED");
}
