// # Product prove std/genomics_advanced/methylation_bisulfite_caller.oo
//
// Logline: Fail-closed emit+gcc+run asserts methylation_bisulfite_caller_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/methylation_bisulfite_caller.oo.
//
// Beats:
//   1. Call methylation_bisulfite_caller_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_methylation_bisulfite_caller: PASSED only if it matches.

import "std/genomics_advanced/methylation_bisulfite_caller.oo";

pub fn main() {
    let a: Int = methylation_bisulfite_caller_probe();
    if a != 0 {
        println("FAIL methylation_bisulfite_caller_probe");
        process_exit(1);
    }
    println("prod_nc_methylation_bisulfite_caller: PASSED");
}
