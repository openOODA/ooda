// # Product prove std/sec/net/jwt_util.oo
//
// Logline: Fail-closed emit+gcc+run asserts jwt_str_eq is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/net/jwt_util.oo.
//
// Beats:
//   1. Call jwt_str_eq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jwt_util: PASSED only if they match.

import "std/sec/net/jwt_util.oo";

pub fn main() {
    let a = jwt_str_eq("x", "x");
    let b = jwt_str_eq("x", "x");
    if a != b {
        println("FAIL jwt_str_eq");
        process_exit(1);
    }
    println("prod_jwt_util: PASSED");
}
