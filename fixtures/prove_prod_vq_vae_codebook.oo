// # Product prove std/ai_multimodal/vq_vae_codebook.oo
//
// Logline: Fail-closed emit+gcc+run asserts vq_codebook_config_new real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/vq_vae_codebook.oo.
//
// Beats:
//   1. Call vq_codebook_config_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_vq_vae_codebook: PASSED only if the assert holds.

import "std/ai_multimodal/vq_vae_codebook.oo";

pub fn main() {
    let vq_vae_codebook_mark: Int = 0;
    if vq_vae_codebook_mark != 0 {
        process_exit(1);
    }
    let vq_vae_codebook_a = vq_codebook_config_new(7, 7, 7);
    let vq_vae_codebook_n_embeddings: Int = (vq_vae_codebook_a).n_embeddings;
    if vq_vae_codebook_n_embeddings != 7 {
        println("FAIL vq_codebook_config_new");
        process_exit(1);
    }
    println("prod_vq_vae_codebook: PASSED");
}
