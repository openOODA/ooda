// # emit-x86 let-bound int-first mixed concat
//
// Logline: Bind s to 7 plus x and print s so emit-x86 can lower a same-fn int-first concat.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind s to 7 plus x.
//   3. Print s.
//
// residual: greet calls stay later.

pub fn main() {
    let s = 7 + "x";
    println(s);
}
