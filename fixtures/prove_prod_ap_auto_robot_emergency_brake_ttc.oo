// # Product prove std/auto_robot/emergency_brake_ttc.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/emergency_brake_ttc.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/emergency_brake_ttc.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_emergency_brake_ttc: PASSED only if they match.

import "std/auto_robot/emergency_brake_ttc.oo";

pub fn main() {
    let emergency_brake_ttc_a = ttc_quot(0, 0);
    let emergency_brake_ttc_b = ttc_quot(0, 0);
    if emergency_brake_ttc_a != emergency_brake_ttc_b {
        println("FAIL emergency_brake_ttc");
        process_exit(1);
    }
    println("prod_ap_emergency_brake_ttc: PASSED");
}
