// Beats: Defines Point struct and methods.

pub type Point = struct {
    x: Int,
    y: Int,
};

pub fn point_scale(p: Point, factor: Int) -> Point {
    return Point { x: p.x * factor, y: p.y * factor };
}

pub fn point_sum(p: Point) -> Int {
    return p.x + p.y;
}
