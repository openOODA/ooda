// # Product prove std/sec/crypto/tss_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts tss_params_t is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/tss_types.oo.
//
// Beats:
//   1. Call tss_params_t twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tss_types: PASSED only if they match.

import "std/sec/crypto/tss_types.oo";

pub fn main() {
    let obj = tss_params_new(0, 0, 0);
    let a = tss_params_t(obj);
    let b = tss_params_t(obj);
    if a != b {
        println("FAIL tss_params_t");
        process_exit(1);
    }
    println("prod_tss_types: PASSED");
}
