// # Refuse a secret-tagged callee
//
// Logline: A function whose name is tagged secret taints the call result at println.
//
// Beats:
//   1. Tag get_secret at line start.
//   2. Bind x to that call.
//   3. Print x so the sink refuses.

// M113: function returning a secret propagates taint
// SECRET: get_secret
pub fn get_secret() -> String {
    return "token";
}

pub fn main() {
    let x = get_secret();
    println(x);
}
