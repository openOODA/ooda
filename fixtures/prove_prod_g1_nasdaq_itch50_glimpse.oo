// # Product prove std/fintech_l3_book/nasdaq_itch50_glimpse.oo
//
// Logline: Fail-closed emit+gcc+run asserts glimpse_session_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_itch50_glimpse.oo.
//
// Beats:
//   1. Call glimpse_session_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nasdaq_itch50_glimpse: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_itch50_glimpse.oo";

pub fn main() {
    let a: GlimpseSessionState = glimpse_session_new();
    let b: GlimpseSessionState = glimpse_session_new();
    if a.sync_sequence_number != 0 {
        println("FAIL glimpse_session_new");
        process_exit(1);
    }
    if a.sync_sequence_number != b.sync_sequence_number {
        println("FAIL glimpse_session_new");
        process_exit(1);
    }
    println("prod_nasdaq_itch50_glimpse: PASSED");
}
