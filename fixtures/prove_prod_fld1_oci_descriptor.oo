// # Product prove std/cloud/oci_descriptor.oo
//
// Logline: Fail-closed emit+gcc+run asserts oci_descriptor_config is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud/oci_descriptor.oo.
//
// Beats:
//   1. Call oci_descriptor_config twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_oci_descriptor: PASSED only if they match.

import "std/cloud/oci_descriptor.oo";

pub fn main() {
    let oci_descriptor_mark: Int = 0;
    if oci_descriptor_mark != 0 {
        process_exit(1);
    }
    let oci_descriptor_a = oci_descriptor_config("x", 1);
    let oci_descriptor_b = oci_descriptor_config("x", 1);
    if (oci_descriptor_a).size != (oci_descriptor_b).size {
        println("FAIL oci_descriptor_config");
        process_exit(1);
    }
    println("prod_oci_descriptor: PASSED");
}
