// # Product prove std/wasm_gc/wasm_gc_i31_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts i31_max_signed is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_i31_ops.oo.
//
// Beats:
//   1. Call i31_max_signed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_i31_ops: PASSED only if they match.

import "std/wasm_gc/wasm_gc_i31_ops.oo";

pub fn main() {
    let wasm_gc_i31_ops_mark: Int = 0;
    if wasm_gc_i31_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = i31_max_signed();
    let b: Int = i31_max_signed();
    if a != b {
        println("FAIL i31_max_signed");
        process_exit(1);
    }
    println("prod_wasm_gc_i31_ops: PASSED");
}
