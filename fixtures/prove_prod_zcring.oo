// # Product ringbuf_zerocopy prove
//
// Logline: Fail-closed emit+gcc+run of shipped zc_ring write/peek/len.
//
// Setup: Product std/io/ringbuf_zerocopy.oo. List[Int] destub.
//
// Beats:
//   1. new(4) write 7 then 3: len 2 peek 7; after read peek 3.
//   2. Exit 1 before PASSED on a miss.

import "std/io/ringbuf_zerocopy.oo";

pub fn main() {
    let mut r: ZeroCopyRing = zc_ring_new(4);
    let cap: Int = zc_ring_capacity(r);
    if cap != 4 {
        println("FAIL zcring cap");
        process_exit(1);
    }
    r = zc_ring_write(r, 7);
    r = zc_ring_write(r, 3);
    let n: Int = zc_ring_len(r);
    if n != 2 {
        println("FAIL zcring len");
        process_exit(1);
    }
    let p0: Int = zc_ring_peek(r);
    if p0 != 7 {
        println("FAIL zcring peek7");
        process_exit(1);
    }
    r = zc_ring_read(r);
    let p1: Int = zc_ring_peek(r);
    if p1 != 3 {
        println("FAIL zcring peek3");
        process_exit(1);
    }
    println("prod_zcring: PASSED");
}
