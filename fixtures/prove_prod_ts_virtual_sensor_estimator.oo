// # Product prove std/industrial_predictive/ts_virtual_sensor_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts virtual_sensor_default_stator real value.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_virtual_sensor_estimator.oo.
//
// Beats:
//   1. Call virtual_sensor_default_stator with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_ts_virtual_sensor_estimator: PASSED only if the assert holds.

import "std/industrial_predictive/ts_virtual_sensor_estimator.oo";

pub fn main() {
    let ts_virtual_sensor_estimator_mark: Int = 0;
    if ts_virtual_sensor_estimator_mark != 0 {
        process_exit(1);
    }
    let ts_virtual_sensor_estimator_a: VirtualSensorWeights = virtual_sensor_default_stator();
    let ts_virtual_sensor_estimator_w_intercept: Float = (ts_virtual_sensor_estimator_a).w_intercept;
    if !(ts_virtual_sensor_estimator_w_intercept == 25.0) {
        println("FAIL virtual_sensor_default_stator");
        process_exit(1);
    }
    println("prod_ts_virtual_sensor_estimator: PASSED");
}
