// # Product prove std/markup/msgpack.oo
//
// Logline: Fail-closed emit+gcc+run asserts msgpack_encode_nil is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/msgpack.oo.
//
// Beats:
//   1. Call msgpack_encode_nil twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_msgpack: PASSED only if they match.

import "std/markup/msgpack.oo";

pub fn main() {
    let xa = msgpack_encode_nil();
    let xb = msgpack_encode_nil();
    let a = list_len(xa);
    let b = list_len(xb);
    if a != b {
        println("FAIL msgpack_encode_nil");
        process_exit(1);
    }
    println("prod_msgpack: PASSED");
}
