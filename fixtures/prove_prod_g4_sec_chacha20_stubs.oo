// # Product prove std/sec/crypto/chacha20_stubs.oo
//
// Logline: Fail-closed verification that ChaCha20 stub interfaces, state validation, and key/nonce helpers are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20_stubs.oo.
//
// Beats:
//   1. Call module stub marker __dummy_std_src_ooda_sec_crypto_chacha20_stubs_oo.
//   2. Validate checksum calculations and hex encode/decode routines.
//   3. Initialize and validate ChaChaKey, ChaChaNonce, and ChaChaState.
//   4. Print prod_g4_sec_chacha20_stubs: PASSED and exit 0.

import "std/sec/crypto/chacha20_stubs.oo";

pub fn main() {
    let dummy_marker: Int = __dummy_std_src_ooda_sec_crypto_chacha20_stubs_oo();
    if dummy_marker != 0 {
        println("FAIL dummy_marker");
        process_exit(1);
    }

    let cs_a: Int = checksum_calculate("chacha20_test_vector");
    let cs_b: Int = checksum_calculate("chacha20_test_vector");
    if cs_a != cs_b {
        println("FAIL checksum_calculate");
        process_exit(1);
    }

    let hpair_a: String = byte_to_hex_pair(255);
    let hpair_b: String = byte_to_hex_pair(255);
    if hpair_a != hpair_b || hpair_a != "ff" {
        println("FAIL byte_to_hex_pair");
        process_exit(1);
    }

    let hval_a: Int = hex_char_to_val(102);
    let hval_b: Int = hex_char_to_val(102);
    if hval_a != hval_b || hval_a != 15 {
        println("FAIL hex_char_to_val");
        process_exit(1);
    }

    let enc_a: String = hex_encode("chacha_key");
    let enc_b: String = hex_encode("chacha_key");
    if enc_a != enc_b {
        println("FAIL hex_encode");
        process_exit(1);
    }

    let dec_res_a: Result[String, String] = hex_decode(enc_a);
    let dec_a: String = match dec_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec_a != "chacha_key" {
        println("FAIL hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = bytes_constant_time_eq("key12345", "key12345");
    let eq_b: Bool = bytes_constant_time_eq("key12345", "wrong123");
    if !eq_a || eq_b {
        println("FAIL bytes_constant_time_eq");
        process_exit(1);
    }

    let key_res: Result[ChaChaKey, String] = chacha_key_create("k1", "01234567890123456789012345678901");
    let k_ok: Bool = key_res.is_ok();
    if !k_ok {
        println("FAIL chacha_key_create");
        process_exit(1);
    }

    let nonce_res: Result[ChaChaNonce, String] = chacha_nonce_create("n1", "012345678901");
    let n_ok: Bool = nonce_res.is_ok();
    if !n_ok {
        println("FAIL chacha_nonce_create");
        process_exit(1);
    }

    let st: ChaChaState = chacha_state_new(20, 1, 1);
    let r_cnt: Int = chacha_state_rounds(st);
    if r_cnt != 20 {
        println("FAIL chacha_state_rounds");
        process_exit(1);
    }

    let s_ok: Bool = chacha_state_validate(&st);
    if !s_ok {
        println("FAIL chacha_state_validate");
        process_exit(1);
    }

    println("prod_g4_sec_chacha20_stubs: PASSED");
    process_exit(0);
}
