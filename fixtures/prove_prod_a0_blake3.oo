// # Product prove std/hash/blake3.oo
//
// Logline: Fail-closed emit+gcc+run asserts blake3 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/blake3.oo.
//
// Beats:
//   1. Call blake3 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_blake3: PASSED only if they match.

import "std/hash/blake3.oo";

pub fn main() {
    let a: String = blake3("x");
    let b: String = blake3("x");
    if a != b {
        println("FAIL blake3");
        process_exit(1);
    }
    println("prod_blake3: PASSED");
}
