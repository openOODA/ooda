// # Connect only in one branch
//
// Logline: Connect inside a true if so the join stays Closed and later use is blocked.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Connect only in the true branch.
//   3. End with no post-join send.
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    if true {
        connect(s);
    }
}
