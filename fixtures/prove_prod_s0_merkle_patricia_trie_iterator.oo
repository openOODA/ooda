// # Product prove std/zk_rollup/merkle_patricia_trie_iterator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpt_entry_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_iterator.oo.
//
// Beats:
//   1. Call mpt_entry_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_merkle_patricia_trie_iterator: PASSED only if asserts hold.

import "std/zk_rollup/merkle_patricia_trie_iterator.oo";

pub fn main() {
    let merkle_patricia_trie_iterator_a = mpt_entry_new(0, 0);
    let merkle_patricia_trie_iterator_b = mpt_entry_new(0, 0);
    if merkle_patricia_trie_iterator_a.key_hex != merkle_patricia_trie_iterator_b.key_hex {
        println("FAIL mpt_entry_new");
        process_exit(1);
    }
    println("prod_merkle_patricia_trie_iterator: PASSED");
}
