// # Product prove std/compilers/wasm_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts wasm_limits_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/wasm_types.oo.
//
// Beats:
//   1. Call wasm_limits_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_types: PASSED only if they match.

import "std/compilers/wasm_types.oo";

pub fn main() {
    let wasm_types_mark: Int = 0;
    if wasm_types_mark != 0 {
        process_exit(1);
    }
    let a: WasmLimits = wasm_limits_new(0, 0, 0);
    let b: WasmLimits = wasm_limits_new(0, 0, 0);
    if (a).min != (b).min {
        println("FAIL wasm_limits_new");
        process_exit(1);
    }
    println("prod_wasm_types: PASSED");
}
