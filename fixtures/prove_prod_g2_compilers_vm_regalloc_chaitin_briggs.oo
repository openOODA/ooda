// # Product prove std/compilers_vm/regalloc_chaitin_briggs.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_assignment_new is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/regalloc_chaitin_briggs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call color_assignment_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_regalloc_chaitin_briggs: PASSED only if they match.

import "std/compilers_vm/regalloc_chaitin_briggs.oo";

pub fn main() {
    let g2_oa: ColorAssignment = color_assignment_new(2, 2, 2);
    let g2_ob: ColorAssignment = color_assignment_new(2, 2, 2);
    let g2_a = (g2_oa).var_id;
    let g2_b = (g2_ob).var_id;
    if g2_a != g2_b {
        println("FAIL color_assignment_new.var_id");
        process_exit(1);
    }
    println("prod_g2_regalloc_chaitin_briggs: PASSED");
}
