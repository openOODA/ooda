// # Product prove std/neuro_bci/eeg_wavelet_spectrogram_morlet.oo
//
// Logline: Fail-closed emit+gcc+run asserts morlet_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_wavelet_spectrogram_morlet.oo.
//
// Beats:
//   1. Call morlet_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eeg_wavelet_spectrogram_morlet: PASSED only if they match.

import "std/neuro_bci/eeg_wavelet_spectrogram_morlet.oo";

pub fn main() {
    let a: MorletWaveletParams = morlet_params_default(0.0, 0.0);
    let b: MorletWaveletParams = morlet_params_default(0.0, 0.0);
    if a.center_freq_hz != b.center_freq_hz {
        println("FAIL morlet_params_default");
        process_exit(1);
    }
    println("prod_eeg_wavelet_spectrogram_morlet: PASSED");
}
