// # Product prove std/zk_rollup/rollup_withdrawal_merkle.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/rollup_withdrawal_merkle.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_withdrawal_merkle.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rollup_withdrawal_merkle: PASSED only if they match.

import "std/zk_rollup/rollup_withdrawal_merkle.oo";

pub fn main() {
    let rollup_withdrawal_merkle_a = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    let rollup_withdrawal_merkle_b = withdrawal_message_new(0, "x", "x", "x", 0, 0);
    let rollup_withdrawal_merkle_va = withdrawal_message_hash(rollup_withdrawal_merkle_a);
    let rollup_withdrawal_merkle_vb = withdrawal_message_hash(rollup_withdrawal_merkle_b);
    if rollup_withdrawal_merkle_va.contains(rollup_withdrawal_merkle_vb) == false {
        println("FAIL rollup_withdrawal_merkle");
        process_exit(1);
    }
    if rollup_withdrawal_merkle_vb.contains(rollup_withdrawal_merkle_va) == false {
        println("FAIL rollup_withdrawal_merkle");
        process_exit(1);
    }
    println("prod_ap_rollup_withdrawal_merkle: PASSED");
}
