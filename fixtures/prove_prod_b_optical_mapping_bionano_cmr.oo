// # Product prove std/genomics_advanced/optical_mapping_bionano_cmr.oo
//
// Logline: Fail-closed emit+gcc+run asserts optical_mapping_bionano_cmr_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/optical_mapping_bionano_cmr.oo.
//
// Beats:
//   1. Call optical_mapping_bionano_cmr_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_optical_mapping_bionano_cmr: PASSED only if they match.

import "std/genomics_advanced/optical_mapping_bionano_cmr.oo";

pub fn main() {
    let a = optical_mapping_bionano_cmr_probe();
    let b = optical_mapping_bionano_cmr_probe();
    if a != b {
        println("FAIL optical_mapping_bionano_cmr_probe");
        process_exit(1);
    }
    println("prod_optical_mapping_bionano_cmr: PASSED");
}
