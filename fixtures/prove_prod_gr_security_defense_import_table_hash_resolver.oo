// # Product prove std/security_defense/import_table_hash_resolver.oo
//
// Logline: Fail-closed emit+gcc+run asserts ror13_hash_step is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/import_table_hash_resolver.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ror13_hash_step twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_import_table_hash_resolver: PASSED only if they match.

import "std/security_defense/import_table_hash_resolver.oo";

pub fn main() {
    let g0_a = ror13_hash_step(0, 0);
    let g0_b = ror13_hash_step(0, 0);
    if g0_a != g0_b {
        println("FAIL ror13_hash_step");
        process_exit(1);
    }
    println("prod_gr_import_table_hash_resolver: PASSED");
}
