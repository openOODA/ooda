// # if x < 2 is leftover
//
// Logline: IDENT LT INT must fail closed and not emit YES.
//
// Setup: x is a bind, not a const INT cond prefix. Sibling of locked IDENT== and INT>IDENT.
//
// Beats:
//   1. Bind x to 1.
//   2. if x < 2 print YES.
//   3. Emit must ERR leftover.

pub fn main() {
    let x = 1;
    if x < 2 {
        println("YES");
    }
}
