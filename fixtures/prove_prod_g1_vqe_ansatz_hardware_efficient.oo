// # Product prove std/quantum_advanced/vqe_ansatz_hardware_efficient.oo
//
// Logline: Fail-closed emit+gcc+run asserts entangle_linear is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_ansatz_hardware_efficient.oo.
//
// Beats:
//   1. Call entangle_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vqe_ansatz_hardware_efficient: PASSED only if they match.

import "std/quantum_advanced/vqe_ansatz_hardware_efficient.oo";

pub fn main() {
    let a: EntanglementType = entangle_linear();
    let b: EntanglementType = entangle_linear();
    if a.mode != b.mode {
        println("FAIL entangle_linear");
        process_exit(1);
    }
    println("prod_vqe_ansatz_hardware_efficient: PASSED");
}
