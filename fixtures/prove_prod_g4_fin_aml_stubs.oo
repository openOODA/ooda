// # Product prove std/fin/aml_stubs.oo
//
// Logline: Fail-closed verification that AML stub imports, risk scoring, and compliance profiles are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml_stubs.oo.
//
// Beats:
//   1. Construct transaction node and compute multi-factor AML risk scores.
//   2. Validate compliance profile and sanction entity constructors.
//   3. Assert deterministic scores, severity tiers, and alert triggers.
//   4. Print prod_g4_fin_aml_stubs: PASSED and exit 0.

import "std/fin/aml_stubs.oo";

pub fn main() {
    let tx_a: TransactionNode = transaction_node_new("TX100", "Alice", "Bob", 50000, 1600000000, "WIRE", "US", false);
    let tx_b: TransactionNode = transaction_node_new("TX100", "Alice", "Bob", 50000, 1600000000, "WIRE", "US", false);
    if (tx_a).amount != (tx_b).amount || (tx_a).amount != 50000 {
        println("FAIL transaction_node_new amount");
        process_exit(1);
    }
    if (tx_a).is_flagged != (tx_b).is_flagged || (tx_a).is_flagged != false {
        println("FAIL transaction_node_new flagged");
        process_exit(1);
    }

    let risk_a: RiskScore = risk_score_new("CUST_001", 30, 20, 15, 20);
    let risk_b: RiskScore = risk_score_new("CUST_001", 30, 20, 15, 20);
    if (risk_a).final_score != (risk_b).final_score || (risk_a).final_score != 85 {
        println("FAIL risk_score_new final_score");
        process_exit(1);
    }
    if (risk_a).requires_sar != true {
        println("FAIL risk_score_new requires_sar");
        process_exit(1);
    }

    let leg_risk_a: AmlRisk = aml_risk_new(101, 75, 0);
    let leg_risk_b: AmlRisk = aml_risk_new(101, 75, 0);
    let sc_a: Int = aml_risk_score(leg_risk_a);
    let sc_b: Int = aml_risk_score(leg_risk_b);
    if sc_a != sc_b || sc_a != 75 {
        println("FAIL aml_risk_score");
        process_exit(1);
    }

    let prof: ComplianceProfile = compliance_profile_new("ENT_99", true, false);
    if !(prof).kyc_verified || (prof).pep_status {
        println("FAIL compliance_profile_new");
        process_exit(1);
    }

    let rule: PatternRule = pattern_rule_new("R_01", "Structuring", 10000, 86400, 3, 40, true);
    if !(rule).is_enabled || (rule).threshold_amount != 10000 {
        println("FAIL pattern_rule_new");
        process_exit(1);
    }

    println("prod_g4_fin_aml_stubs: PASSED");
    process_exit(0);
}
