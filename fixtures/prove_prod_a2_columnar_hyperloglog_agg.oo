// # Product prove std/db_columnar/columnar_hyperloglog_agg.oo
//
// Logline: Fail-closed emit+gcc+run asserts hll_calc_rho is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_hyperloglog_agg.oo.
//
// Beats:
//   1. Call hll_calc_rho twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_hyperloglog_agg: PASSED only if they match.

import "std/db_columnar/columnar_hyperloglog_agg.oo";

pub fn main() {
    let columnar_hyperloglog_agg_mark: Int = 0;
    if columnar_hyperloglog_agg_mark != 0 {
        process_exit(1);
    }
    let a: Int = hll_calc_rho(0);
    let b: Int = hll_calc_rho(0);
    if a != b {
        println("FAIL hll_calc_rho");
        process_exit(1);
    }
    println("prod_columnar_hyperloglog_agg: PASSED");
}
