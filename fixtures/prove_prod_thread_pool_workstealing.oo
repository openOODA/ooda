// # Product prove std/sync/thread_pool_workstealing.oo
//
// Logline: Fail-closed emit+gcc+run asserts steal_deque_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/thread_pool_workstealing.oo.
//
// Beats:
//   1. Call steal_deque_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_thread_pool_workstealing: PASSED only if they match.

import "std/sync/thread_pool_workstealing.oo";

pub fn main() {
    let obj = steal_deque_new();
    let a = steal_deque_len(obj);
    let b = steal_deque_len(obj);
    if a != b {
        println("FAIL steal_deque_len");
        process_exit(1);
    }
    println("prod_thread_pool_workstealing: PASSED");
}
