// # Product prove std/aero/attitude_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts att_vec3_x is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call att_vec3_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_attitude_types: PASSED only if they match.

import "std/aero/attitude_types.oo";

pub fn main() {
    let g2_oa = att_vec3_new(2, 2, 2);
    let g2_ob = att_vec3_new(2, 2, 2);
    let g2_a = att_vec3_x(g2_oa);
    let g2_b = att_vec3_x(g2_ob);
    if g2_a != g2_b {
        println("FAIL att_vec3_x");
        process_exit(1);
    }
    println("prod_g2_attitude_types: PASSED");
}
