// # Product prove std/robotics_auv/pipeline_tracking_visual_servoing.oo
//
// Logline: Fail-closed emit+gcc+run asserts visual_servoing_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/pipeline_tracking_visual_servoing.oo.
//
// Beats:
//   1. Call visual_servoing_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_visual_servoing_config_default: PASSED only if they match.

import "std/robotics_auv/pipeline_tracking_visual_servoing.oo";

pub fn main() {
    let pipeline_tracking_visual_servoing_mark: Int = 0;
    if pipeline_tracking_visual_servoing_mark != 0 { process_exit(1); }
    let a: VisualServoingConfig = visual_servoing_config_default();
    let b: VisualServoingConfig = visual_servoing_config_default();
    if (a).camera_focal_length_px != (b).camera_focal_length_px {
        println("FAIL visual_servoing_config_default");
        process_exit(1);
    }
    println("prod_visual_servoing_config_default: PASSED");
}
