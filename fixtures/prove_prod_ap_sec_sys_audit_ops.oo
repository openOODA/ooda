// # Product prove std/sec/sys/audit_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/audit_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/audit_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_audit_ops: PASSED only if they match.

import "std/sec/sys/audit_ops.oo";

pub fn main() {
    let audit_ops_a = __dummy_std_src_ooda_sec_sys_audit_ops_oo();
    let audit_ops_b = __dummy_std_src_ooda_sec_sys_audit_ops_oo();
    if audit_ops_a != audit_ops_b {
        println("FAIL audit_ops");
        process_exit(1);
    }
    println("prod_ap_audit_ops: PASSED");
}
