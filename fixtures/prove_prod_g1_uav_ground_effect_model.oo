// # Product prove std/uav_flight/uav_ground_effect_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts ground_effect_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_ground_effect_model.oo.
//
// Beats:
//   1. Call ground_effect_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_ground_effect_model: PASSED only if they match.

import "std/uav_flight/uav_ground_effect_model.oo";

pub fn main() {
    let a: GroundEffectConfig = ground_effect_config_default(0);
    let b: GroundEffectConfig = ground_effect_config_default(0);
    if a.rotor_radius_mm != b.rotor_radius_mm {
        println("FAIL ground_effect_config_default");
        process_exit(1);
    }
    println("prod_uav_ground_effect_model: PASSED");
}
