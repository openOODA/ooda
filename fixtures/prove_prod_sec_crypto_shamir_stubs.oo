// # Product prove std/sec/crypto/shamir_stubs.oo
//
// Logline: Fail-closed emit+check asserts gf256_mul is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/shamir_stubs.oo.
//
// Beats:
//   1. Call gf256_mul twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shamir_stubs: PASSED only if they match.

import "std/sec/crypto/shamir_stubs.oo";

pub fn main() {
    let shamir_stubs_mark: Int = 0;
    if shamir_stubs_mark != 0 { process_exit(1); }
    let a: Int = gf256_mul(3, 5);
    let b: Int = gf256_mul(3, 5);
    if a != b { process_exit(1); }
    println("prod_shamir_stubs: PASSED");
}
