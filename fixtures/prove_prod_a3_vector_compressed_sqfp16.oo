// # Product prove std/db_vector_ann/vector_compressed_sqfp16.oo
//
// Logline: Fail-closed emit+gcc+run asserts fp16_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_compressed_sqfp16.oo.
//
// Beats:
//   1. Call fp16_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_compressed_sqfp16: PASSED only if they match.

import "std/db_vector_ann/vector_compressed_sqfp16.oo";

pub fn main() {
    let vector_compressed_sqfp16_mark: Int = 0;
    if vector_compressed_sqfp16_mark != 0 {
        process_exit(1);
    }
    let a: Fp16Config = fp16_config_default(0);
    let b: Fp16Config = fp16_config_default(0);
    if (a).dimension != (b).dimension {
        println("FAIL fp16_config_default");
        process_exit(1);
    }
    println("prod_vector_compressed_sqfp16: PASSED");
}
