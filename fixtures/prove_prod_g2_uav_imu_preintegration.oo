// # Product prove std/uav_flight/uav_imu_preintegration.oo
//
// Logline: Fail-closed emit+gcc+run asserts preintegrated_imu_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_imu_preintegration.oo.
//
// Beats:
//   1. Call preintegrated_imu_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_imu_preintegration: PASSED only if they match.

import "std/uav_flight/uav_imu_preintegration.oo";

pub fn main() {
    let uav_imu_preintegration_mark: Int = 0;
    if uav_imu_preintegration_mark != 0 {
        process_exit(1);
    }
    let a: PreintegratedImuState = preintegrated_imu_init();
    let b: PreintegratedImuState = preintegrated_imu_init();
    if (a).total_dt != (b).total_dt {
        println("FAIL preintegrated_imu_init");
        process_exit(1);
    }
    println("prod_g2_uav_imu_preintegration: PASSED");
}
