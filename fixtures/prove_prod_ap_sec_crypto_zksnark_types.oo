// # Product prove std/sec/crypto/zksnark_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/zksnark_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/zksnark_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_zksnark_types: PASSED only if they match.

import "std/sec/crypto/zksnark_types.oo";

pub fn main() {
    let zksnark_types_a = zksnark_protocol_groth16();
    let zksnark_types_b = zksnark_protocol_groth16();
    if zksnark_types_a != zksnark_types_b {
        println("FAIL zksnark_types");
        process_exit(1);
    }
    println("prod_ap_zksnark_types: PASSED");
}
