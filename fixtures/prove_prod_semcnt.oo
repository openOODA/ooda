// # Product sync counting semaphore prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/semaphore_counting.oo.
//
// Setup: Product std/sync/semaphore_counting.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(7, 10) available 7.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/semaphore_counting.oo";

pub fn main() {
    let s: CountingSemaphore = semaphore_new(7, 10);
    let n: Int = semaphore_available(s);
    if n != 7 {
        println("FAIL semcnt 7");
        process_exit(1);
    }
    println("prod_semcnt: PASSED");
}
