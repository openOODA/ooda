// # Product prove std/sec/sys/pe_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts pe_get_data_directory_name holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/pe_engine.oo.
//
// Beats:
//   1. Call pe_get_data_directory_name using the pe_engine ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_pe_engine: PASSED only if asserts hold.

import "std/sec/sys/pe_engine.oo";
import "std/str.oo";

pub fn main() {
    let pe_engine_a = pe_get_data_directory_name(0);
    let pe_engine_b = pe_get_data_directory_name(0);
    if chars_len(pe_engine_a) != chars_len(pe_engine_b) {
        println("FAIL pe_get_data_directory_name");
        process_exit(1);
    }
    if !str_contains(pe_engine_a, pe_engine_b) {
        println("FAIL pe_get_data_directory_name");
        process_exit(1);
    }
    if !str_contains(pe_engine_b, pe_engine_a) {
        println("FAIL pe_get_data_directory_name");
        process_exit(1);
    }
    println("prod_pe_engine: PASSED");
}
