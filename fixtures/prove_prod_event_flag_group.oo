// # Product prove std/sync/event_flag_group.oo
//
// Logline: Fail-closed emit+gcc+run asserts event_flag_match_all is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/event_flag_group.oo.
//
// Beats:
//   1. Call event_flag_match_all twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_event_flag_group: PASSED only if they match.

import "std/sync/event_flag_group.oo";

pub fn main() {
    let obj = event_flag_group_new();
    let a = event_flag_match_all(obj, 0);
    let b = event_flag_match_all(obj, 0);
    if a != b {
        println("FAIL event_flag_match_all");
        process_exit(1);
    }
    println("prod_event_flag_group: PASSED");
}
