// # Product prove std/gis_spatial/shapefile_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts shapefile_type_name is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/shapefile_header.oo.
//
// Beats:
//   1. Call shapefile_type_name twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shapefile_header: PASSED only if they match.

import "std/gis_spatial/shapefile_header.oo";

pub fn main() {
    let shapefile_header_mark: Int = 0;
    if shapefile_header_mark != 0 {
        process_exit(1);
    }
    let a: String = shapefile_type_name(0);
    let b: String = shapefile_type_name(0);
    if a != b {
        println("FAIL shapefile_type_name");
        process_exit(1);
    }
    println("prod_shapefile_header: PASSED");
}
