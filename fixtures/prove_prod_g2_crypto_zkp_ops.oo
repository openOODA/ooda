// # Product prove std/crypto/zkp_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts pedersen_commitment_verify is a real value.
//
// Setup: Isolated emit-c. Imports std/crypto/zkp_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pedersen_commitment_verify twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zkp_ops: PASSED only if they match.

import "std/crypto/zkp_ops.oo";

pub fn main() {
    let g2_oa = pedersen_commitment_create(2, 2, 2, 2, 2);
    let g2_ob = pedersen_commitment_create(2, 2, 2, 2, 2);
    let g2_a = pedersen_commitment_verify(g2_oa, 2);
    let g2_b = pedersen_commitment_verify(g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL pedersen_commitment_verify");
        process_exit(1);
    }
    println("prod_g2_zkp_ops: PASSED");
}
