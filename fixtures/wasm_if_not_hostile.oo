// # Hostile if !x fold
//
// Logline: Print fold-me or other from if !x so emit-wasm must miss a const-not fold.
//
// Setup: One public main. Operand is IDENT x.
//
// Beats:
//   1. Let x be false.
//   2. If !x print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn main() {
    let x = false;
    if !x {
        println("fold-me");
    } else {
        println("other");
    }
}
