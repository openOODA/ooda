// # Product prove std/ai_multimodal/siglip_sigmoid_loss.oo
//
// Logline: Fail-closed emit+gcc+run asserts siglip_sigmoid_loss_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/siglip_sigmoid_loss.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call siglip_sigmoid_loss_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_siglip_sigmoid_loss: PASSED only if they match.

import "std/ai_multimodal/siglip_sigmoid_loss.oo";

pub fn main() {
    let g2_a = siglip_sigmoid_loss_marker();
    let g2_b = siglip_sigmoid_loss_marker();
    if g2_a != g2_b {
        println("FAIL siglip_sigmoid_loss_marker");
        process_exit(1);
    }
    println("prod_g2_siglip_sigmoid_loss: PASSED");
}
