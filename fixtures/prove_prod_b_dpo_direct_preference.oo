// # Product prove std/deep_ai/dpo_direct_preference.oo
//
// Logline: Fail-closed emit+gcc+run asserts dpo_direct_preference_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/dpo_direct_preference.oo.
//
// Beats:
//   1. Call dpo_direct_preference_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dpo_direct_preference: PASSED only if they match.

import "std/deep_ai/dpo_direct_preference.oo";

pub fn main() {
    let a = dpo_direct_preference_marker();
    let b = dpo_direct_preference_marker();
    if a != b {
        println("FAIL dpo_direct_preference_marker");
        process_exit(1);
    }
    println("prod_dpo_direct_preference: PASSED");
}
