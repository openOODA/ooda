// # Product prove std/neuro_bci/bci_information_transfer_rate.oo
//
// Logline: Fail-closed emit+gcc+run asserts itr_log2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_information_transfer_rate.oo.
//
// Beats:
//   1. Call itr_log2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_bci_information_transfer_rate: PASSED only if they match.

import "std/neuro_bci/bci_information_transfer_rate.oo";

pub fn main() {
    let bci_information_transfer_rate_mark: Int = 0;
    if bci_information_transfer_rate_mark != 0 {
        process_exit(1);
    }
    let a: Float = itr_log2(0.0);
    let b: Float = itr_log2(0.0);
    if a != b {
        println("FAIL itr_log2");
        process_exit(1);
    }
    println("prod_g2_bci_information_transfer_rate: PASSED");
}
