// # Product prove std/sec/crypto/falcon_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon_poly.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_poly.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_falcon_poly: PASSED only if they match.

import "std/sec/crypto/falcon_poly.oo";

pub fn main() {
    let falcon_poly_a = falcon_polynomial_center_mod(0, 0);
    let falcon_poly_b = falcon_polynomial_center_mod(0, 0);
    if falcon_poly_a != falcon_poly_b {
        println("FAIL falcon_poly");
        process_exit(1);
    }
    println("prod_ap_falcon_poly: PASSED");
}
