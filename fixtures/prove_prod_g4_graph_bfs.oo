// # Product prove std/graph_topology/graph_traversal_bfs.oo
//
// Logline: Fail-closed emit+gcc+run asserts breadth-first traversal, shortest paths, and bipartiteness.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_traversal_bfs.oo.
//
// Beats:
//   1. Construct undirected graph and execute level-order BFS traversal.
//   2. Reconstruct shortest unweighted path between distant vertices.
//   3. Assert whole-graph connectivity and 2-color bipartite check.
//   4. Print prod_g4_graph_bfs: PASSED on success.

import "std/graph_topology/graph_traversal_bfs.oo";
import "std/graph_topology/graph_adjacency_list.oo";

pub fn main() {
    let mut g: GraphAdjList = adj_list_create(false);
    adj_list_add_edge(&mut g, 0, 1, 1);
    adj_list_add_edge(&mut g, 1, 2, 1);

    let res: BfsResult = bfs_traverse(&g, 0, 3);
    let count: Int = (res).visited_count;
    if count != 3 {
        println("FAIL bfs_traverse visited_count");
        process_exit(1);
    }

    let d2: Int = list_get((res).distances, 2);
    if d2 != 2 {
        println("FAIL bfs_traverse distance");
        process_exit(1);
    }

    let path: List[Int] = bfs_shortest_path(&g, 0, 2, 3);
    let p_len: Int = list_len(path);
    if p_len != 3 {
        println("FAIL bfs_shortest_path length");
        process_exit(1);
    }

    let p0: Int = list_get(path, 0);
    let p1: Int = list_get(path, 1);
    let p2: Int = list_get(path, 2);
    if p0 != 0 || p1 != 1 || p2 != 2 {
        println("FAIL bfs_shortest_path nodes");
        process_exit(1);
    }

    let conn: Bool = bfs_is_connected(&g, 3);
    if conn == false {
        println("FAIL bfs_is_connected");
        process_exit(1);
    }

    let bip: Bool = bfs_bipartite_check(&g, 3);
    if bip == false {
        println("FAIL bfs_bipartite_check");
        process_exit(1);
    }

    println("prod_g4_graph_bfs: PASSED");
    process_exit(0);
}
