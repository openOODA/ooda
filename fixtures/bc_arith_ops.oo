// # Smoke bytecode SUB and DIV
//
// Logline: Integer divide then subtract must run on the bytecode interpreter.
//
// Setup: M6; modulo lives in bc_mod_ops.
//
// Beats:
//   1. Compute 20 / 4.
//   2. Subtract 1.
//   3. Print 4.

pub fn main() {
    let a = 20 / 4;
    let b = a - 1;
    println(b);
}
