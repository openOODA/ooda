// # Product prove std/telecom_5g/ofdm_pilot_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts ofdm_pilot_ls_re is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/ofdm_pilot_estimator.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ofdm_pilot_ls_re twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_ofdm_pilot_estimator: PASSED only if they match.

import "std/telecom_5g/ofdm_pilot_estimator.oo";

pub fn main() {
    let g0_a = ofdm_pilot_ls_re(1.0, 1.0, 1.0, 1.0);
    let g0_b = ofdm_pilot_ls_re(1.0, 1.0, 1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL ofdm_pilot_ls_re");
        process_exit(1);
    }
    println("prod_g0_ofdm_pilot_estimator: PASSED");
}
