// # Product prove std/genomics_advanced/debruijn_graph_assembly.oo
//
// Logline: Fail-closed emit+gcc+run asserts debruijn_assemble_unitig is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/debruijn_graph_assembly.oo.
//
// Beats:
//   1. Call debruijn_assemble_unitig twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_debruijn_graph_assembly: PASSED only if they match.

import "std/genomics_advanced/debruijn_graph_assembly.oo";

pub fn main() {
    let debruijn_graph_assembly_mark: Int = 0;
    if debruijn_graph_assembly_mark != 0 {
        process_exit(1);
    }
    let a: ContigAssemblyResult = debruijn_assemble_unitig(0, 0, 0);
    let b: ContigAssemblyResult = debruijn_assemble_unitig(0, 0, 0);
    if (a).node_count != (b).node_count {
        println("FAIL debruijn_assemble_unitig");
        process_exit(1);
    }
    println("prod_g2_debruijn_graph_assembly: PASSED");
}
