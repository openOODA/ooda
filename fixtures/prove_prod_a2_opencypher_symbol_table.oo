// # Product prove std/db_graph/opencypher_symbol_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts cypher_symbol_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_symbol_table.oo.
//
// Beats:
//   1. Call cypher_symbol_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_symbol_table: PASSED only if they match.

import "std/db_graph/opencypher_symbol_table.oo";

pub fn main() {
    let opencypher_symbol_table_mark: Int = 0;
    if opencypher_symbol_table_mark != 0 {
        process_exit(1);
    }
    let a: CypherSymbol = cypher_symbol_new("x", 0, "x", 0);
    let b: CypherSymbol = cypher_symbol_new("x", 0, "x", 0);
    if (a).symbol_kind != (b).symbol_kind {
        println("FAIL cypher_symbol_new");
        process_exit(1);
    }
    println("prod_opencypher_symbol_table: PASSED");
}
