// # Product prove std/crypto/merkle.oo
//
// Logline: Fail-closed emit+gcc+run asserts dummy_merkle is a real value.
//
// Setup: Isolated emit-c. Imports std/crypto/merkle.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dummy_merkle twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_merkle: PASSED only if they match.

import "std/crypto/sha256_types.oo";
import "std/crypto/merkle.oo";

pub fn main() {
    let g0_a = dummy_merkle();
    let g0_b = dummy_merkle();
    if g0_a != g0_b {
        println("FAIL dummy_merkle");
        process_exit(1);
    }
    println("prod_gr_merkle: PASSED");
}
