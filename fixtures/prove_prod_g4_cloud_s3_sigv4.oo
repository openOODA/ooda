// # Product prove std/cloud_k8s/s3_sigv4_signer.oo
//
// Logline: Fail-closed verification of AWS SigV4 signer credential scope and string-to-sign generation.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/s3_sigv4_signer.oo.
//
// Beats:
//   1. Construct SigV4 credentials and request structures.
//   2. Derive credential scope and string-to-sign.
//   3. Assert deterministic credential scope and string-to-sign derivation.
//   4. Print prod_g4_cloud_s3_sigv4: PASSED and exit 0.

import "std/cloud_k8s/s3_sigv4_signer.oo";

pub fn main() {
    let creds: SigV4Credentials = sigv4_credentials_new(
        "AKIAIOSFODNN7EXAMPLE",
        "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
        "us-east-1",
        "s3"
    );

    let req: SigV4Request = SigV4Request {
        method: "GET",
        uri: "/test.txt",
        query_string: "",
        date_stamp: "20260819",
        amz_date: "20260819T120000Z",
        payload_hash: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    };

    let scope1: String = sigv4_credential_scope(&creds, "20260819");
    let scope2: String = sigv4_credential_scope(&creds, "20260819");
    if scope1 != scope2 {
        println("FAIL sigv4_credential_scope match");
        process_exit(1);
    }
    if scope1 != "20260819/us-east-1/s3/aws4_request" {
        println("FAIL sigv4_credential_scope value");
        process_exit(1);
    }

    let h: String = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    let sts1: String = sigv4_string_to_sign(&creds, &req, h);
    let sts2: String = sigv4_string_to_sign(&creds, &req, h);
    if sts1 != sts2 {
        println("FAIL sigv4_string_to_sign match");
        process_exit(1);
    }

    println("prod_g4_cloud_s3_sigv4: PASSED");
    process_exit(0);
}
