// # if 00 == 0 is leftover
//
// Logline: Leading-zero INT compare must fail closed and not emit EQ or NE.
//
// Setup: 00 is not a canonical decimal INT token. Product C octal and decimal disagree.
//
// Beats:
//   1. if 00 == 0 print EQ else print NE.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn main() {
    if 00 == 0 {
        println("EQ");
    } else {
        println("NE");
    }
}
