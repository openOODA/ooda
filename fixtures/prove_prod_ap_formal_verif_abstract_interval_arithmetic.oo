// # Product prove std/formal_verif/abstract_interval_arithmetic.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/abstract_interval_arithmetic.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/abstract_interval_arithmetic.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_abstract_interval_arithmetic: PASSED only if they match.

import "std/formal_verif/abstract_interval_arithmetic.oo";

pub fn main() {
    let abstract_interval_arithmetic_a = interval_bottom();
    let abstract_interval_arithmetic_b = interval_bottom();
    let abstract_interval_arithmetic_va = interval_is_empty(abstract_interval_arithmetic_a);
    let abstract_interval_arithmetic_vb = interval_is_empty(abstract_interval_arithmetic_b);
    if abstract_interval_arithmetic_va != abstract_interval_arithmetic_vb {
        println("FAIL abstract_interval_arithmetic");
        process_exit(1);
    }
    println("prod_ap_abstract_interval_arithmetic: PASSED");
}
