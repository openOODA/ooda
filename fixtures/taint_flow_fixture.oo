// # Field-Level Information Flow Taint Tracking and Secret Guard Fixture
//
// Logline: Fixture proving field-level taint propagation, secret sink interception, and sanitizer bypass prevention.
//
// Setup: Test fixture exercising information flow tracking across struct fields, assignments, binary operations, and sinks.
//
// Beats:
//   1. Prove field-level taint propagation from struct secret fields across multiple assignments and expressions.
//   2. Prove strict interception and rejection when tainted secret data reaches LogSink, NetEgressSink, or FsWriteSink.
//   3. Prove approved sanitizer (e.g. SHA256 HMAC or Masking) declassifies taint safely and permits egress.
//   4. Prove unapproved or spoofed sanitizers are rejected and fail-closed under strict policy.
//   5. Output test markers and confirm end-to-end verification passing.
//
// residual: Dynamic distributed multi-node information-flow tracking lowers via kernel capability filters

import "src/ooda/sec/taint/taint.oo";

pub fn test_field_taint_propagation() -> Bool {
    let mut g: FlowGraph = taint_init_graph(10, "g_field_prop");
    g = taint_mark_secret(g, "user_rec", "api_token", "env.SECRET_TOKEN");
    g = taint_mark_user_input(g, "user_rec", "username", "http.param.user");
    g = taint_mark_clean(g, "user_rec", "account_id");

    g = taint_assign(g, "user_rec", "api_token", "tok_var", "");
    g = taint_assign(g, "user_rec", "username", "name_var", "");
    g = taint_assign(g, "user_rec", "account_id", "id_var", "");
    g = taint_combine_expr(g, "tok_var", "", "id_var", "", "auth_payload", "");

    let lbl_tok: TaintLabel = flow_graph_get_label(g, "tok_var", "");
    let lbl_name: TaintLabel = flow_graph_get_label(g, "name_var", "");
    let lbl_id: TaintLabel = flow_graph_get_label(g, "id_var", "");
    let lbl_auth: TaintLabel = flow_graph_get_label(g, "auth_payload", "");

    if lbl_tok.level != taint_level_secret() { return false; }
    if lbl_name.level != taint_level_user_input() { return false; }
    if lbl_id.level != taint_level_clean() { return false; }
    if lbl_auth.level != taint_level_secret() { return false; }
    return true;
}

pub fn test_secret_sink_interception() -> Bool {
    let mut g: FlowGraph = taint_init_graph(20, "g_sink_guard");
    let pol: TaintPolicy = taint_policy_strict(1, "strict_pol");
    g = taint_mark_secret(g, "db_secret", "password", "vault.db_pass");
    g = taint_mark_untrusted_net(g, "net_payload", "body", "tcp.recv");

    if taint_verify_log(g, pol, "db_secret", "password") { return false; }
    if taint_verify_net(g, pol, "db_secret", "password") { return false; }
    if taint_verify_fs(g, pol, "db_secret", "password") { return false; }
    if taint_verify_exec(g, pol, "net_payload", "body") { return false; }

    return true;
}

pub fn test_sanitizer_declassification() -> Bool {
    let mut g: FlowGraph = taint_init_graph(30, "g_sanitizer");
    let pol: TaintPolicy = taint_policy_strict(1, "strict_pol");
    g = taint_mark_secret(g, "card_info", "cvv", "db.cc.cvv");

    let san_sha: SanitizerFn = sanitizer_fn_new(1, "sha256_mask", taint_level_secret(), taint_level_clean(), true);
    let san_unapproved: SanitizerFn = sanitizer_fn_new(2, "bypass_leak", taint_level_secret(), taint_level_clean(), false);

    g = taint_sanitize(g, "card_info", "cvv", "masked_cvv", "", san_sha);
    g = taint_sanitize(g, "card_info", "cvv", "leaked_cvv", "", san_unapproved);

    let lbl_masked: TaintLabel = flow_graph_get_label(g, "masked_cvv", "");
    let lbl_leaked: TaintLabel = flow_graph_get_label(g, "leaked_cvv", "");

    if lbl_masked.level != taint_level_clean() { return false; }
    if lbl_leaked.level != taint_level_secret() { return false; }

    if !taint_verify_log(g, pol, "masked_cvv", "") { return false; }
    if taint_verify_log(g, pol, "leaked_cvv", "") { return false; }

    return true;
}

pub fn main() {
    if !test_field_taint_propagation() {
        println("FAIL: test_field_taint_propagation");
        process_exit(1);
    }
    println("TAINT_FLOW_ASSIGN_PROPAGATE_OK");
    println("TAINT_EXPR_JOIN_OK");
    println("TAINT_FIELD_PROJECTION_OK");

    if !test_secret_sink_interception() {
        println("FAIL: test_secret_sink_interception");
        process_exit(1);
    }
    println("TAINT_POLICY_INIT_OK");
    println("TAINT_SINK_INTERCEPT_OK");

    if !test_sanitizer_declassification() {
        println("FAIL: test_sanitizer_declassification");
        process_exit(1);
    }
    println("TAINT_SANITIZER_DECLASSIFY_OK");
    println("TAINT_UNAUTHORIZED_BYPASS_FAIL_OK");

    println("TAINT_FLOW_FIXTURE_ALL_PASSED");
}
