// # emit-x86 two-arg SysV rsi call
//
// Logline: Call snd on xx and hi and print the second arg so emit-x86 must lea %rsi then call.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No const-fold.
//
// Beats:
//   1. Declare two-arg String passthrough of the second param.
//   2. Print snd("xx", "hi").
//   3. Expect hi from a real call.

fn snd(a: String, b: String) -> String {
    return b;
}

pub fn main() {
    println(snd("xx", "hi"));
}
