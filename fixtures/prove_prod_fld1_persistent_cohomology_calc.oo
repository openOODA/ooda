// # Product prove std/tda_topology/persistent_cohomology_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts persistent_cocycle_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/persistent_cohomology_calc.oo.
//
// Beats:
//   1. Call persistent_cocycle_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_persistent_cohomology_calc: PASSED only if they match.

import "std/tda_topology/persistent_cohomology_calc.oo";

pub fn main() {
    let persistent_cohomology_calc_mark: Int = 0;
    if persistent_cohomology_calc_mark != 0 {
        process_exit(1);
    }
    let persistent_cohomology_calc_a = persistent_cocycle_new(1, 1.0, 1.0);
    let persistent_cohomology_calc_b = persistent_cocycle_new(1, 1.0, 1.0);
    if (persistent_cohomology_calc_a).cocycle_id != (persistent_cohomology_calc_b).cocycle_id {
        println("FAIL persistent_cocycle_new");
        process_exit(1);
    }
    println("prod_persistent_cohomology_calc: PASSED");
}
