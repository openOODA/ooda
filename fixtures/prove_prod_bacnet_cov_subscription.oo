// # Product prove std/iot_scada/bacnet_cov_subscription.oo
//
// Logline: Fail-closed emit+gcc+run asserts bacnet_cov_sub_new real value.
//
// Setup: Isolated emit-c. Imports std/iot_scada/bacnet_cov_subscription.oo.
//
// Beats:
//   1. Call bacnet_cov_sub_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_bacnet_cov_subscription: PASSED only if the assert holds.

import "std/iot_scada/bacnet_cov_subscription.oo";

pub fn main() {
    let bacnet_cov_subscription_a = bacnet_cov_sub_new(7, 7, 7, 7, 2.0);
    let bacnet_cov_subscription_subscriber_process_id: Int = (bacnet_cov_subscription_a).subscriber_process_id;
    if bacnet_cov_subscription_subscriber_process_id != 7 {
        println("FAIL bacnet_cov_sub_new");
        process_exit(1);
    }
    println("prod_bacnet_cov_subscription: PASSED");
}
