// # Product prove std/bft_consensus/hotstuff_quorum_certificate.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bft_consensus/hotstuff_quorum_certificate.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/hotstuff_quorum_certificate.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_hotstuff_quorum_certificate: PASSED only if they match.

import "std/bft_consensus/hotstuff_quorum_certificate.oo";

pub fn main() {
    let hotstuff_quorum_certificate_a = hotstuff_check_3chain_commit(0, 0, 0, 0);
    let hotstuff_quorum_certificate_b = hotstuff_check_3chain_commit(0, 0, 0, 0);
    if hotstuff_quorum_certificate_a != hotstuff_quorum_certificate_b {
        println("FAIL hotstuff_quorum_certificate");
        process_exit(1);
    }
    println("prod_ap_hotstuff_quorum_certificate: PASSED");
}
