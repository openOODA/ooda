// # Product prove std/tui/box_drawing.oo
//
// Logline: Fail-closed emit+gcc+run asserts box_glyphs_get_corner is a real value.
//
// Setup: Isolated emit-c. Imports std/tui/box_drawing.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call box_glyphs_get_corner twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_box_drawing: PASSED only if they match.

import "std/tui/box_drawing.oo";

pub fn main() {
    let g0_oa = box_glyphs_single();
    let g0_ob = box_glyphs_single();
    let g0_a = box_glyphs_get_corner(&g0_oa, true, true);
    let g0_b = box_glyphs_get_corner(&g0_ob, true, true);
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL box_glyphs_get_corner");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL box_glyphs_get_corner");
        process_exit(1);
    }
    println("prod_g0_box_drawing: PASSED");
}
