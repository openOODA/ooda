// # Product prove std/net/tcp_conn.oo
//
// Logline: Fail-closed emit+gcc+run asserts tcp_conn_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/tcp_conn.oo.
//
// Beats:
//   1. Call tcp_conn_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tcp_conn: PASSED only if they match.

import "std/net/tcp_conn.oo";

pub fn main() {
    let a = tcp_conn_probe();
    let b = tcp_conn_probe();
    if a != b {
        println("FAIL tcp_conn_probe");
        process_exit(1);
    }
    println("prod_tcp_conn: PASSED");
}
