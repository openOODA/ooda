// # Product prove std/space_propulsion/low_thrust_edelbaum_transfer.oo
//
// Logline: Fail-closed emit+gcc+run asserts edelbaum_compute_transfer is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/low_thrust_edelbaum_transfer.oo.
//
// Beats:
//   1. Call edelbaum_compute_transfer twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_low_thrust_edelbaum_transfer: PASSED only if they match.

import "std/space_propulsion/low_thrust_edelbaum_transfer.oo";

pub fn main() {
    let low_thrust_edelbaum_transfer_mark: Int = 0;
    if low_thrust_edelbaum_transfer_mark != 0 {
        process_exit(1);
    }
    let low_thrust_edelbaum_transfer_a = edelbaum_compute_transfer(edelbaum_spec_default_leo_to_geo());
    let low_thrust_edelbaum_transfer_b = edelbaum_compute_transfer(edelbaum_spec_default_leo_to_geo());
    if (low_thrust_edelbaum_transfer_a).initial_velocity_m_s != (low_thrust_edelbaum_transfer_b).initial_velocity_m_s {
        println("FAIL edelbaum_compute_transfer");
        process_exit(1);
    }
    println("prod_low_thrust_edelbaum_transfer: PASSED");
}
