// # Product running stats prove
//
// Logline: Fail-closed emit+gcc+run of shipped running_stats_update/mean/variance.
//
// Setup: Product std/math/statistics_running.oo. Welford on 1,2,3.
//
// Beats:
//   1. Mean of 1,2,3 is 2.0; count is 3.
//   2. Sample variance is 1.0 (m2=2, n-1=2).
//   3. Exit 1 before PASSED on a miss.

import "std/math/statistics_running.oo";

pub fn main() {
    let mut s: RunningStats = running_stats_new();
    s = running_stats_update(s, 1.0);
    s = running_stats_update(s, 2.0);
    s = running_stats_update(s, 3.0);
    let c: Int = running_stats_count(s);
    if c != 3 {
        println("FAIL runstat count");
        process_exit(1);
    }
    let m: Float = running_stats_mean(s);
    if m != 2.0 {
        println("FAIL runstat mean");
        process_exit(1);
    }
    let v: Float = running_stats_variance(s);
    if v != 1.0 {
        println("FAIL runstat var");
        process_exit(1);
    }
    println("prod_runstat: PASSED");
}
