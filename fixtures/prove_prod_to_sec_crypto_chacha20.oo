// # Product prove std/sec/crypto/chacha20.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_checksum holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/chacha20.oo.
//
// Beats:
//   1. Call shim_marker_checksum using the chacha20 ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_chacha20: PASSED only if asserts hold.

import "std/sec/crypto/chacha20.oo";

pub fn main() {
    let chacha20_a = shim_marker_checksum();
    let chacha20_b = shim_marker_checksum();
    if chacha20_a != chacha20_b {
        println("FAIL shim_marker_checksum");
        process_exit(1);
    }
    println("prod_chacha20: PASSED");
}
