// # Product prove std/digital_twin/asset_clock_drift_synchronizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts clock_servo_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_clock_drift_synchronizer.oo.
//
// Beats:
//   1. Call clock_servo_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_asset_clock_drift_synchronizer: PASSED only if they match.

import "std/digital_twin/asset_clock_drift_synchronizer.oo";

pub fn main() {
    let asset_clock_drift_synchronizer_mark: Int = 0;
    if asset_clock_drift_synchronizer_mark != 0 {
        process_exit(1);
    }
    let a: ClockServoState = clock_servo_new(0.5, 0.1);
    let b: ClockServoState = clock_servo_new(0.5, 0.1);
    if (a).kp_gain != (b).kp_gain {
        println("FAIL clock_servo_new");
        process_exit(1);
    }
    println("prod_asset_clock_drift_synchronizer: PASSED");
}
