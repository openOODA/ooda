// # Product prove std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntn_float_to_int_ceil is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo.
//
// Beats:
//   1. Call ntn_float_to_int_ceil twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_satellite_ntn_3gpp_timing_advance: PASSED only if they match.

import "std/satellite_dvb/satellite_ntn_3gpp_timing_advance.oo";

pub fn main() {
    let satellite_ntn_3gpp_timing_advance_mark: Int = 0;
    if satellite_ntn_3gpp_timing_advance_mark != 0 {
        process_exit(1);
    }
    let a: Int = ntn_float_to_int_ceil(0.0);
    let b: Int = ntn_float_to_int_ceil(0.0);
    if a != b {
        println("FAIL ntn_float_to_int_ceil");
        process_exit(1);
    }
    println("prod_g2_satellite_ntn_3gpp_timing_advance: PASSED");
}
