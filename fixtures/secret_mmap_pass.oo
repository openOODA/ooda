// # Allow a public mmap path
//
// Logline: A non-secret path may reach mmap while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public path instead.
//   3. Expect emit to allow the call.

// M-? mmap clean: non-secret path may mmap (emit path)
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "s3cret";
    let r = mmap(ffi, 4096, "/lib/x.so");
    println(1);
}
