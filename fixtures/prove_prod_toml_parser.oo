// # Product prove std/markup/toml_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts toml_has_key is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/toml_parser.oo.
//
// Beats:
//   1. Call toml_has_key twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_toml_parser: PASSED only if they match.

import "std/markup/toml_parser.oo";

pub fn main() {
    let obj = toml_doc_new("x");
    let a = toml_has_key(obj, "x", "x");
    let b = toml_has_key(obj, "x", "x");
    if a != b {
        println("FAIL toml_has_key");
        process_exit(1);
    }
    println("prod_toml_parser: PASSED");
}
