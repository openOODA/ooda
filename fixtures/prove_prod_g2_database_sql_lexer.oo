// # Product prove std/database/sql_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_is_keyword is a real value.
//
// Setup: Isolated emit-c. Imports std/database/sql_lexer.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sql_is_keyword twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sql_lexer: PASSED only if they match.

import "std/database/sql_lexer.oo";

pub fn main() {
    let g2_a = sql_is_keyword("x");
    let g2_b = sql_is_keyword("x");
    if g2_a != g2_b {
        println("FAIL sql_is_keyword");
        process_exit(1);
    }
    println("prod_g2_sql_lexer: PASSED");
}
