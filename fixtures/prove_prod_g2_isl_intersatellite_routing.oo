// # Product prove std/satellite_dvb/isl_intersatellite_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts isl_calc_intra_plane_distance_km is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_intersatellite_routing.oo.
//
// Beats:
//   1. Call isl_calc_intra_plane_distance_km twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_isl_intersatellite_routing: PASSED only if they match.

import "std/satellite_dvb/isl_intersatellite_routing.oo";

pub fn main() {
    let isl_intersatellite_routing_mark: Int = 0;
    if isl_intersatellite_routing_mark != 0 {
        process_exit(1);
    }
    let a: Float = isl_calc_intra_plane_distance_km(0.0, 0);
    let b: Float = isl_calc_intra_plane_distance_km(0.0, 0);
    if a != b {
        println("FAIL isl_calc_intra_plane_distance_km");
        process_exit(1);
    }
    println("prod_g2_isl_intersatellite_routing: PASSED");
}
