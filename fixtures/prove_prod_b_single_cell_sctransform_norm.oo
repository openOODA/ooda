// # Product prove std/genomics_advanced/single_cell_sctransform_norm.oo
//
// Logline: Fail-closed emit+gcc+run asserts single_cell_sctransform_norm_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/single_cell_sctransform_norm.oo.
//
// Beats:
//   1. Call single_cell_sctransform_norm_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_single_cell_sctransform_norm: PASSED only if they match.

import "std/genomics_advanced/single_cell_sctransform_norm.oo";

pub fn main() {
    let a = single_cell_sctransform_norm_probe();
    let b = single_cell_sctransform_norm_probe();
    if a != b {
        println("FAIL single_cell_sctransform_norm_probe");
        process_exit(1);
    }
    println("prod_single_cell_sctransform_norm: PASSED");
}
