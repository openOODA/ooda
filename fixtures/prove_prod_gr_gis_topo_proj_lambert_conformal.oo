// # Product prove std/gis_topo/proj_lambert_conformal.oo
//
// Logline: Fail-closed emit+gcc+run asserts lcc_deg2rad is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/proj_lambert_conformal.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call lcc_deg2rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_proj_lambert_conformal: PASSED only if they match.

import "std/gis_topo/proj_lambert_conformal.oo";

pub fn main() {
    let g0_a = lcc_deg2rad(0.0);
    let g0_b = lcc_deg2rad(0.0);
    if g0_a != g0_b {
        println("FAIL lcc_deg2rad");
        process_exit(1);
    }
    println("prod_gr_proj_lambert_conformal: PASSED");
}
