// # Mixed STRING plus bound ident
//
// Logline: Print a prefix plus a same-fn string bind plus a suffix.
//
// Setup: Side emit-aarch64 mixes STRING and bound IDENT in one println.
//
// Beats:
//   1. Bind n to World.
//   2. Print Hello, plus n plus !.
//   3. Leave unbound idents leftover.

pub fn main() {
    let n = "World";
    println("Hello, " + n + "!");
}
