// # Product prove std/simd/simd_quat.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_quat.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_quat.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_quat: PASSED only if they match.

import "std/simd/simd_quat.oo";

pub fn main() {
    let simd_quat_a = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    let simd_quat_b = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    let simd_quat_va = simd_quat_norm_sq(simd_quat_a);
    let simd_quat_vb = simd_quat_norm_sq(simd_quat_b);
    if simd_quat_va != simd_quat_vb {
        println("FAIL simd_quat");
        process_exit(1);
    }
    println("prod_ap_simd_quat: PASSED");
}
