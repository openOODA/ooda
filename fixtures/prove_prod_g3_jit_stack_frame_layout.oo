// # Product prove std/wasm_gc/jit_stack_frame_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts jit_frame_layout_calculate is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_stack_frame_layout.oo.
//
// Beats:
//   1. Call jit_frame_layout_calculate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_stack_frame_layout: PASSED only if they match.

import "std/wasm_gc/jit_stack_frame_layout.oo";

pub fn main() {
    let jit_stack_frame_layout_mark: Int = 0;
    if jit_stack_frame_layout_mark != 0 {
        process_exit(1);
    }
    let a: JitFrameLayout = jit_frame_layout_calculate(0, 0, 0);
    let b: JitFrameLayout = jit_frame_layout_calculate(0, 0, 0);
    if (a).num_callee_saved_regs != (b).num_callee_saved_regs {
        println("FAIL jit_frame_layout_calculate");
        process_exit(1);
    }
    println("prod_jit_stack_frame_layout: PASSED");
}
