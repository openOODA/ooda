// # Product prove std/aero/telemetry_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts packet_header_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_types.oo.
//
// Beats:
//   1. Call packet_header_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telemetry_types: PASSED only if they match.

import "std/aero/telemetry_types.oo";

pub fn main() {
    let telemetry_types_mark: Int = 0;
    if telemetry_types_mark != 0 {
        process_exit(1);
    }
    let a: PacketHeader = packet_header_new(0, 0, 0);
    let b: PacketHeader = packet_header_new(0, 0, 0);
    if (a).apid != (b).apid {
        println("FAIL packet_header_new");
        process_exit(1);
    }
    println("prod_g2_telemetry_types: PASSED");
}
