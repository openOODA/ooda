// # Product prove std/compilers/macho_header.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/macho_header.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/macho_header.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_macho_header: PASSED only if they match.

import "std/compilers/macho_header.oo";

pub fn main() {
    let macho_header_a = macho_magic_64();
    let macho_header_b = macho_magic_64();
    if macho_header_a != macho_header_b {
        println("FAIL macho_header");
        process_exit(1);
    }
    println("prod_ap_macho_header: PASSED");
}
