// # Product prove std/database/sql_lexer.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_is_keyword is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_lexer.oo.
//
// Beats:
//   1. Call sql_is_keyword twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sql_lexer: PASSED only if they match.

import "std/database/sql_lexer.oo";

pub fn main() {
    let sql_lexer_mark: Int = 0;
    if sql_lexer_mark != 0 {
        process_exit(1);
    }
    let a: Bool = sql_is_keyword("x");
    let b: Bool = sql_is_keyword("x");
    if a != b {
        println("FAIL sql_is_keyword");
        process_exit(1);
    }
    println("prod_g2_sql_lexer: PASSED");
}
