// # Product prove std/graph_gnn/kg_negative_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts negative_sampling_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_negative_sampling.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call negative_sampling_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kg_negative_sampling: PASSED only if they match.

import "std/graph_gnn/kg_negative_sampling.oo";

pub fn main() {
    let g2_oa: NegativeSamplingConfig = negative_sampling_config_new(2, 2, 1.0, true);
    let g2_ob: NegativeSamplingConfig = negative_sampling_config_new(2, 2, 1.0, true);
    let g2_a = (g2_oa).num_entities;
    let g2_b = (g2_ob).num_entities;
    if g2_a != g2_b {
        println("FAIL negative_sampling_config_new.num_entities");
        process_exit(1);
    }
    println("prod_g2_kg_negative_sampling: PASSED");
}
