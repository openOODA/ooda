// # Product prove std/markup/json_writer.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_escape_str is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_writer.oo.
//
// Beats:
//   1. Call json_escape_str twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json_writer: PASSED only if they match.

import "std/markup/json_writer.oo";

pub fn main() {
    let a = json_escape_str("x");
    let b = json_escape_str("x");
    if a != b {
        println("FAIL json_escape_str");
        process_exit(1);
    }
    println("prod_json_writer: PASSED");
}
