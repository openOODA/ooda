// # Product prove std/token_opt/token_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts token_budget_config_new is a real value.
//
// Setup: Isolated emit-c. Imports std/token_opt/token_budget.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call token_budget_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_token_budget: PASSED only if they match.

import "std/token_opt/token_budget.oo";

pub fn main() {
    let g2_oa = token_budget_config_new(2, 2);
    let g2_ob = token_budget_config_new(2, 2);
    let g2_a = (g2_oa).max_context_tokens;
    let g2_b = (g2_ob).max_context_tokens;
    if g2_a != g2_b {
        println("FAIL token_budget_config_new.max_context_tokens");
        process_exit(1);
    }
    println("prod_g2_token_budget: PASSED");
}
