// # Product prove std/astrophysics_relativity/stellar_structure_equations.oo
//
// Logline: Fail-closed emit+gcc+run asserts stellar_ideal_gas_density is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/stellar_structure_equations.oo.
//
// Beats:
//   1. Call stellar_ideal_gas_density twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stellar_structure_equations: PASSED only if they match.

import "std/astrophysics_relativity/stellar_structure_equations.oo";

pub fn main() {
    let stellar_structure_equations_mark: Int = 0;
    if stellar_structure_equations_mark != 0 {
        process_exit(1);
    }
    let a: Float = stellar_ideal_gas_density(0.0, 0.0, 0.0);
    let b: Float = stellar_ideal_gas_density(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL stellar_ideal_gas_density");
        process_exit(1);
    }
    println("prod_stellar_structure_equations: PASSED");
}
