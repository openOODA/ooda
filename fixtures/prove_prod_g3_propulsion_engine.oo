// # Product prove std/aero/propulsion_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts prop_eng_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/propulsion_engine.oo.
//
// Beats:
//   1. Call prop_eng_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_propulsion_engine: PASSED only if they match.

import "std/aero/propulsion_engine.oo";

pub fn main() {
    let propulsion_engine_mark: Int = 0;
    if propulsion_engine_mark != 0 {
        process_exit(1);
    }
    let a: PropEng = prop_eng_new(0, 0);
    let b: PropEng = prop_eng_new(0, 0);
    if (a).thrust != (b).thrust {
        println("FAIL prop_eng_new");
        process_exit(1);
    }
    println("prod_propulsion_engine: PASSED");
}
