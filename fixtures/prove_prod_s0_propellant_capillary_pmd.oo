// # Product prove std/space_propulsion/propellant_capillary_pmd.oo
//
// Logline: Fail-closed emit+gcc+run asserts capillary_pmd_spec_default_hydrazine value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_capillary_pmd.oo.
//
// Beats:
//   1. Call capillary_pmd_spec_default_hydrazine twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_propellant_capillary_pmd: PASSED only if asserts hold.

import "std/space_propulsion/propellant_capillary_pmd.oo";

pub fn main() {
    let propellant_capillary_pmd_a: CapillaryPmdSpec = capillary_pmd_spec_default_hydrazine();
    let propellant_capillary_pmd_b: CapillaryPmdSpec = capillary_pmd_spec_default_hydrazine();
    if propellant_capillary_pmd_a.screen_pore_radius_um != propellant_capillary_pmd_b.screen_pore_radius_um {
        println("FAIL capillary_pmd_spec_default_hydrazine");
        process_exit(1);
    }
    println("prod_propellant_capillary_pmd: PASSED");
}
