// # Product prove std/sh.oo
//
// Logline: Fail-closed emit+gcc+run asserts sh_arg_ok is deterministic.
//
// Setup: Isolated emit-c. Imports std/sh.oo.
//
// Beats:
//   1. Call sh_arg_ok twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sh: PASSED only if they match.

import "std/sh.oo";

pub fn main() {
    let a: Bool = sh_arg_ok("x");
    let b: Bool = sh_arg_ok("x");
    if a != b {
        println("FAIL sh_arg_ok");
        process_exit(1);
    }
    println("prod_sh: PASSED");
}
