// # Product prove std/defi_derivatives/defi_options_vault_dov.oo
//
// Logline: Fail-closed emit+gcc+run asserts dov_norm_pdf is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/defi_options_vault_dov.oo.
//
// Beats:
//   1. Call dov_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_defi_options_vault_dov: PASSED only if they match.

import "std/defi_derivatives/defi_options_vault_dov.oo";

pub fn main() {
    let defi_options_vault_dov_mark: Int = 0;
    if defi_options_vault_dov_mark != 0 {
        process_exit(1);
    }
    let a: Float = dov_norm_pdf(0.0);
    let b: Float = dov_norm_pdf(0.0);
    if a != b {
        println("FAIL dov_norm_pdf");
        process_exit(1);
    }
    println("prod_g2_defi_options_vault_dov: PASSED");
}
