// # Product prove std/compilers_vm/ssa_dominator_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts cfg_block_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/ssa_dominator_tree.oo.
//
// Beats:
//   1. Call cfg_block_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ssa_dominator_tree: PASSED only if they match.

import "std/compilers_vm/ssa_dominator_tree.oo";

pub fn main() {
    let ssa_dominator_tree_mark: Int = 0;
    if ssa_dominator_tree_mark != 0 {
        process_exit(1);
    }
    let a: CfgBlock = cfg_block_new(0, "x");
    let b: CfgBlock = cfg_block_new(0, "x");
    if (a).id != (b).id {
        println("FAIL cfg_block_new");
        process_exit(1);
    }
    println("prod_ssa_dominator_tree: PASSED");
}
