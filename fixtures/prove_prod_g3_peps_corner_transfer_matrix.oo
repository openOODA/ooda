// # Product prove std/quantum_tensor_nets/peps_corner_transfer_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts ctmrg_correlation_length is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_corner_transfer_matrix.oo.
//
// Beats:
//   1. Call ctmrg_correlation_length twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_peps_corner_transfer_matrix: PASSED only if they match.

import "std/quantum_tensor_nets/peps_corner_transfer_matrix.oo";

pub fn main() {
    let peps_corner_transfer_matrix_mark: Int = 0;
    if peps_corner_transfer_matrix_mark != 0 {
        process_exit(1);
    }
    let a: Float = ctmrg_correlation_length(0.0, 0.0);
    let b: Float = ctmrg_correlation_length(0.0, 0.0);
    if a != b {
        println("FAIL ctmrg_correlation_length");
        process_exit(1);
    }
    println("prod_peps_corner_transfer_matrix: PASSED");
}
