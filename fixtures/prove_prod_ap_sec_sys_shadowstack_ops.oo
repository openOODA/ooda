// # Product prove std/sec/sys/shadowstack_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/shadowstack_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/shadowstack_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_shadowstack_ops: PASSED only if they match.

import "std/sec/sys/shadowstack_ops.oo";

pub fn main() {
    let shadowstack_ops_a = shadowstack_slot_cap();
    let shadowstack_ops_b = shadowstack_slot_cap();
    if shadowstack_ops_a != shadowstack_ops_b {
        println("FAIL shadowstack_ops");
        process_exit(1);
    }
    println("prod_ap_shadowstack_ops: PASSED");
}
