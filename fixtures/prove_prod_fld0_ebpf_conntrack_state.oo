// # Product prove std/mesh_ebpf/ebpf_conntrack_state.oo
//
// Logline: Fail-closed emit+gcc+run asserts conntrack_table_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/ebpf_conntrack_state.oo.
//
// Beats:
//   1. Call conntrack_table_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ebpf_conntrack_state: PASSED only if they match.

import "std/mesh_ebpf/ebpf_conntrack_state.oo";

pub fn main() {
    let ebpf_conntrack_state_mark: Int = 0;
    if ebpf_conntrack_state_mark != 0 {
        process_exit(1);
    }
    let ebpf_conntrack_state_a: ConntrackTable = conntrack_table_new();
    let ebpf_conntrack_state_b: ConntrackTable = conntrack_table_new();
    if (ebpf_conntrack_state_a).total_connections != (ebpf_conntrack_state_b).total_connections {
        println("FAIL conntrack_table_new");
        process_exit(1);
    }
    println("prod_ebpf_conntrack_state: PASSED");
}
