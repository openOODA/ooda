// # Product prove std/media_dsp/flac_subframe_decorrelator.oo
//
// Logline: Fail-closed emit+gcc+run asserts flac_fixed_predict_sample is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/flac_subframe_decorrelator.oo.
//
// Beats:
//   1. Call flac_fixed_predict_sample twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_flac_subframe_decorrelator: PASSED only if they match.

import "std/media_dsp/flac_subframe_decorrelator.oo";

pub fn main() {
    let flac_subframe_decorrelator_mark: Int = 0;
    if flac_subframe_decorrelator_mark != 0 {
        process_exit(1);
    }
    let a: Int = flac_fixed_predict_sample(0, list_new(), 0);
    let b: Int = flac_fixed_predict_sample(0, list_new(), 0);
    if a != b {
        println("FAIL flac_fixed_predict_sample");
        process_exit(1);
    }
    println("prod_flac_subframe_decorrelator: PASSED");
}
