// # Product prove std/exploit_analysis/heap_fastbin_dup_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts fastbin_list_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_fastbin_dup_detector.oo.
//
// Beats:
//   1. Call fastbin_list_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_fastbin_dup_detector: PASSED only if they match.

import "std/exploit_analysis/heap_fastbin_dup_detector.oo";

pub fn main() {
    let a: FastbinList = fastbin_list_new(0, 0);
    let b: FastbinList = fastbin_list_new(0, 0);
    if a.index != b.index {
        println("FAIL fastbin_list_new");
        process_exit(1);
    }
    println("prod_heap_fastbin_dup_detector: PASSED");
}
