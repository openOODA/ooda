// # Product prove std/io/io_uring_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts io_uring_sq_len is a real value.
//
// Setup: Isolated emit-c. Imports std/io/io_uring_stub.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call io_uring_sq_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_io_uring_stub: PASSED only if they match.

import "std/io/io_uring_stub.oo";

pub fn main() {
    let g0_oa = io_uring_new(8);
    let g0_ob = io_uring_new(8);
    let g0_a = io_uring_sq_len(g0_oa);
    let g0_b = io_uring_sq_len(g0_ob);
    if g0_a != g0_b {
        println("FAIL io_uring_sq_len");
        process_exit(1);
    }
    println("prod_g0_io_uring_stub: PASSED");
}
