// # Product prove std/crypto_advanced/bulletproofs_range_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts bulletproofs_range_prover_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/bulletproofs_range_proof.oo.
//
// Beats:
//   1. Call bulletproofs_range_prover_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bulletproofs_range_proof: PASSED only if they match.

import "std/crypto_advanced/bulletproofs_range_proof.oo";

pub fn main() {
    let bulletproofs_range_proof_mark: Int = 0;
    if bulletproofs_range_proof_mark != 0 {
        process_exit(1);
    }
    let a: BulletproofsRangeProver = bulletproofs_range_prover_init(0, 0);
    let b: BulletproofsRangeProver = bulletproofs_range_prover_init(0, 0);
    if (a).bits_len != (b).bits_len {
        println("FAIL bulletproofs_range_prover_init");
        process_exit(1);
    }
    println("prod_bulletproofs_range_proof: PASSED");
}
