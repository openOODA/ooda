// # Const else-if print
//
// Logline: Print YES from else-if true, OK from a true then, and ELSE from a false/false else.
//
// Setup: Side emit-aarch64 walks else-if after a false then and skip_else after a true then.
//
// Beats:
//   1. if false else if true print YES.
//   2. if true else if true print OK not BAD.
//   3. if false else if false else print ELSE.

pub fn main() {
    if false {
        println("BAD");
    } else if true {
        println("YES");
    }
    if true {
        println("OK");
    } else if true {
        println("BAD2");
    }
    if false {
        println("BAD3");
    } else if false {
        println("BAD4");
    } else {
        println("ELSE");
    }
}
