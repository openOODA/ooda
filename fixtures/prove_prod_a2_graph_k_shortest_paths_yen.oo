// # Product prove std/db_graph/graph_k_shortest_paths_yen.oo
//
// Logline: Fail-closed emit+gcc+run asserts ranked_path_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_k_shortest_paths_yen.oo.
//
// Beats:
//   1. Call ranked_path_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_k_shortest_paths_yen: PASSED only if they match.

import "std/db_graph/graph_k_shortest_paths_yen.oo";

pub fn main() {
    let graph_k_shortest_paths_yen_mark: Int = 0;
    if graph_k_shortest_paths_yen_mark != 0 {
        process_exit(1);
    }
    let a: RankedPath = ranked_path_new(0, 0.0);
    let b: RankedPath = ranked_path_new(0, 0.0);
    if (a).rank != (b).rank {
        println("FAIL ranked_path_new");
        process_exit(1);
    }
    println("prod_graph_k_shortest_paths_yen: PASSED");
}
