// # Product prove std/cloud_faas/idempotency_key_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts idempotency_store_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/idempotency_key_store.oo.
//
// Beats:
//   1. Call idempotency_store_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_idempotency_key_store: PASSED only if they match.

import "std/cloud_faas/idempotency_key_store.oo";

pub fn main() {
    let idempotency_key_store_mark: Int = 0;
    if idempotency_key_store_mark != 0 {
        process_exit(1);
    }
    let a: IdempotencyStore = idempotency_store_new(0);
    let b: IdempotencyStore = idempotency_store_new(0);
    if (a).ttl_seconds != (b).ttl_seconds {
        println("FAIL idempotency_store_new");
        process_exit(1);
    }
    println("prod_idempotency_key_store: PASSED");
}
