// # Product prove std/media_dsp/h264_sps_pps_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/h264_sps_pps_decoder.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/h264_sps_pps_decoder.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_h264_sps_pps_decoder: PASSED only if they match.

import "std/media_dsp/h264_sps_pps_decoder.oo";

pub fn main() {
    let h264_sps_pps_decoder_a = h264_decode_ue_golomb(0, 0);
    let h264_sps_pps_decoder_b = h264_decode_ue_golomb(0, 0);
    if h264_sps_pps_decoder_a != h264_sps_pps_decoder_b {
        println("FAIL h264_sps_pps_decoder");
        process_exit(1);
    }
    println("prod_ap_h264_sps_pps_decoder: PASSED");
}
