// # Product prove std/crispr_cas/prime_editing_epeg_structural.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crispr_cas/prime_editing_epeg_structural.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_epeg_structural.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_prime_editing_epeg_structural: PASSED only if they match.

import "std/crispr_cas/prime_editing_epeg_structural.oo";

pub fn main() {
    let prime_editing_epeg_structural_a = epeg_get_motif_seq("x");
    let prime_editing_epeg_structural_b = epeg_get_motif_seq("x");
    if prime_editing_epeg_structural_a.contains(prime_editing_epeg_structural_b) == false {
        println("FAIL prime_editing_epeg_structural");
        process_exit(1);
    }
    if prime_editing_epeg_structural_b.contains(prime_editing_epeg_structural_a) == false {
        println("FAIL prime_editing_epeg_structural");
        process_exit(1);
    }
    println("prod_ap_prime_editing_epeg_structural: PASSED");
}
