// # Const INT!=INT if print
//
// Logline: Print NZ from if 1!=0 and EQ from the else of if 1!=1.
//
// Setup: Side emit-aarch64 folds INT NEQ INT only when LBRACE follows.
//
// Beats:
//   1. if 1 != 0 print NZ.
//   2. if 1 != 1 else print EQ.
//   3. Expect NZ and EQ.

pub fn main() {
    if 1 != 0 {
        println("NZ");
    }
    if 1 != 1 {
        println("BAD");
    } else {
        println("EQ");
    }
}
