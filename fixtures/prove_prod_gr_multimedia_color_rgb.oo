// # Product prove std/multimedia/color_rgb.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_int_to_f is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/color_rgb.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call color_int_to_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_color_rgb: PASSED only if they match.

import "std/multimedia/color_rgb.oo";

pub fn main() {
    let g0_a = color_int_to_f(0);
    let g0_b = color_int_to_f(0);
    if g0_a != g0_b {
        println("FAIL color_int_to_f");
        process_exit(1);
    }
    println("prod_gr_color_rgb: PASSED");
}
