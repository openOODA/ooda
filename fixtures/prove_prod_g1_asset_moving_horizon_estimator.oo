// # Product prove std/digital_twin/asset_moving_horizon_estimator.oo
//
// Logline: Fail-closed emit+gcc+run asserts mhe_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/asset_moving_horizon_estimator.oo.
//
// Beats:
//   1. Call mhe_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_asset_moving_horizon_estimator: PASSED only if they match.

import "std/digital_twin/asset_moving_horizon_estimator.oo";

pub fn main() {
    let a: MheState = mhe_state_new(0, 0.0);
    let b: MheState = mhe_state_new(0, 0.0);
    if a.current_estimate != b.current_estimate {
        println("FAIL mhe_state_new");
        process_exit(1);
    }
    println("prod_asset_moving_horizon_estimator: PASSED");
}
