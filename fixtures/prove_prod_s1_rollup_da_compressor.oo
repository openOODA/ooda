// # Product prove std/zk_rollup/rollup_da_compressor.oo
//
// Logline: Fail-closed emit+gcc+run asserts state_diff_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_da_compressor.oo.
//
// Beats:
//   1. Call state_diff_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_da_compressor: PASSED only if they match.

import "std/zk_rollup/rollup_da_compressor.oo";

pub fn main() {
    let rollup_da_compressor_mark: Int = 0;
    if rollup_da_compressor_mark != 0 {
        process_exit(1);
    }
    let rollup_da_compressor_a = state_diff_record_new(1, 1, 1);
    let rollup_da_compressor_b = state_diff_record_new(1, 1, 1);
    if (rollup_da_compressor_a).account_index != (rollup_da_compressor_b).account_index {
        println("FAIL state_diff_record_new");
        process_exit(1);
    }
    println("prod_rollup_da_compressor: PASSED");
}
