// # Product prove std/aero/formation_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/aero/formation_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_formation_engine: PASSED only if they match.

import "std/aero/formation_engine.oo";

pub fn main() {
    let formation_engine_a = hcw_compute_mean_motion(0.0, 0.0);
    let formation_engine_b = hcw_compute_mean_motion(0.0, 0.0);
    if formation_engine_a != formation_engine_b {
        println("FAIL formation_engine");
        process_exit(1);
    }
    println("prod_ap_formation_engine: PASSED");
}
