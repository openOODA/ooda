// # Product prove std/crypto_advanced/crypto_pq_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crypto_advanced/crypto_pq_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/crypto_pq_stubs.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_crypto_pq_stubs: PASSED only if they match.

import "std/crypto_advanced/crypto_pq_stubs.oo";

pub fn main() {
    let crypto_pq_stubs_a = crypto_pq_fail_closed("x", 0);
    let crypto_pq_stubs_b = crypto_pq_fail_closed("x", 0);
    if crypto_pq_stubs_a != crypto_pq_stubs_b {
        println("FAIL crypto_pq_stubs");
        process_exit(1);
    }
    println("prod_ap_crypto_pq_stubs: PASSED");
}
