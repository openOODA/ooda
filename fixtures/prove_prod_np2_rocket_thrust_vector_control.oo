// # Product prove std/space_propulsion/rocket_thrust_vector_control.oo
//
// Logline: Fail-closed emit+gcc+run asserts tvc_compute_actuator_stroke is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_thrust_vector_control.oo.
//
// Beats:
//   1. Call tvc_compute_actuator_stroke twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_thrust_vector_control: PASSED only if they match.

import "std/space_propulsion/rocket_thrust_vector_control.oo";

pub fn main() {
    let rocket_thrust_vector_control_mark: Int = 0;
    if rocket_thrust_vector_control_mark != 0 {
        process_exit(1);
    }
    let rocket_thrust_vector_control_a: Float = tvc_compute_actuator_stroke(tvc_gimbal_spec_default(), 1.0);
    let rocket_thrust_vector_control_b: Float = tvc_compute_actuator_stroke(tvc_gimbal_spec_default(), 1.0);
    if rocket_thrust_vector_control_a != rocket_thrust_vector_control_b {
        println("FAIL tvc_compute_actuator_stroke");
        process_exit(1);
    }
    println("prod_rocket_thrust_vector_control: PASSED");
}
