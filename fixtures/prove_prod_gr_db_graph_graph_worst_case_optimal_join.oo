// # Product prove std/db_graph/graph_worst_case_optimal_join.oo
//
// Logline: Fail-closed emit+gcc+run asserts wcoj_intersect_two is a real value.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_worst_case_optimal_join.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wcoj_intersect_two twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_graph_worst_case_optimal_join: PASSED only if they match.

import "std/db_graph/graph_worst_case_optimal_join.oo";

pub fn main() {
    let g0_la = wcoj_intersect_two(list_new(), list_new());
    let g0_lb = wcoj_intersect_two(list_new(), list_new());
    let g0_a = list_len(g0_la);
    let g0_b = list_len(g0_lb);
    if g0_a != g0_b {
        println("FAIL wcoj_intersect_two");
        process_exit(1);
    }
    println("prod_gr_graph_worst_case_optimal_join: PASSED");
}
