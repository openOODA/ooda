// # Product prove std/3d/lights_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ambient_light_get_intensity is a real value.
//
// Setup: Isolated emit-c. Imports std/3d/lights_engine.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ambient_light_get_intensity twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lights_engine: PASSED only if they match.

import "std/3d/lights_engine.oo";

pub fn main() {
    let g2_oa = ambient_light_default();
    let g2_ob = ambient_light_default();
    let g2_a = ambient_light_get_intensity(g2_oa);
    let g2_b = ambient_light_get_intensity(g2_ob);
    if g2_a != g2_b {
        println("FAIL ambient_light_get_intensity");
        process_exit(1);
    }
    println("prod_g2_lights_engine: PASSED");
}
