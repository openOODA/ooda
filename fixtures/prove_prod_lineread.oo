// # Product line_reader prove
//
// Logline: Fail-closed emit+gcc+run of shipped line_reader_new/has_next/next.
//
// Setup: Product std/io/line_reader.oo. Source "ab".
//
// Beats:
//   1. has_next true; next line is ab; line_number 1.
//   2. Exit 1 before PASSED on a miss.

import "std/io/line_reader.oo";

pub fn main() {
    let r: LineReader = line_reader_new("ab");
    let h: Bool = line_reader_has_next(r);
    if h == false {
        println("FAIL lineread has");
        process_exit(1);
    }
    let it: LineItem = line_reader_next(r);
    let ln: String = it.line;
    if ln != "ab" {
        println("FAIL lineread line");
        process_exit(1);
    }
    let num: Int = it.line_number;
    if num != 1 {
        println("FAIL lineread num");
        process_exit(1);
    }
    println("prod_lineread: PASSED");
}
