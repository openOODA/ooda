// # Product prove std/aero/formation_stubs.oo
//
// Logline: Fail-closed verification that formation stubs module readiness and relative state structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_stubs.oo.
//
// Beats:
//   1. Check formation_module_ready is true.
//   2. Construct relative state vector instances.
//   3. Assert deterministic state coordinates.
//   4. Print prod_g4_aero_formation_stubs: PASSED and exit 0.

import "std/aero/formation_stubs.oo";

pub fn main() {
    let ready1: Bool = formation_module_ready();
    let ready2: Bool = formation_module_ready();
    if ready1 != ready2 {
        println("FAIL formation_module_ready");
        process_exit(1);
    }
    if ready1 != true {
        println("FAIL formation_module_ready not true");
        process_exit(1);
    }

    let pos: Vec3 = vec3_new(100.0, 200.0, 300.0);
    let vel: Vec3 = vec3_new(1.0, 2.0, 3.0);
    let st: RelativeState = relative_state_new(pos, vel, 0.0);
    let st_pos: Vec3 = st.position;
    let px: Float = st_pos.x;
    let py: Float = st_pos.y;
    let pz: Float = st_pos.z;

    if px != 100.0 {
        println("FAIL relative state position x");
        process_exit(1);
    }
    if py != 200.0 {
        println("FAIL relative state position y");
        process_exit(1);
    }
    if pz != 300.0 {
        println("FAIL relative state position z");
        process_exit(1);
    }

    println("prod_g4_aero_formation_stubs: PASSED");
    process_exit(0);
}
