// # Product prove std/robotics_ros2/ros2_topic_subscriber.oo
//
// Logline: Fail-closed emit+gcc+run asserts ros2_topic_subscriber_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/ros2_topic_subscriber.oo.
//
// Beats:
//   1. Call ros2_topic_subscriber_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ros2_topic_subscriber: PASSED only if they match.

import "std/robotics_ros2/ros2_topic_subscriber.oo";

pub fn main() {
    let a = ros2_topic_subscriber_probe();
    let b = ros2_topic_subscriber_probe();
    if a != b {
        println("FAIL ros2_topic_subscriber_probe");
        process_exit(1);
    }
    println("prod_ros2_topic_subscriber: PASSED");
}
