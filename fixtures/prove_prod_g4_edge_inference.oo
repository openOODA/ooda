// # Product prove std/edge/inference.oo
//
// Logline: Fail-closed emit+gcc+run asserts edge model inference configuration and analysis.
//
// Setup: Isolated emit-c. Imports std/edge/inference.oo.
//
// Beats:
//   1. Verify inference admission checks and latency estimation.
//   2. Compute optimal compute backend given battery and thermal state.
//   3. Estimate memory footprint and energy consumption.
//   4. Print prod_g4_edge_inference: PASSED on success.

import "std/edge/inference.oo";

pub fn main() {
    let can_proc: Bool = shim_marker_can_process();
    if can_proc == false {
        println("FAIL shim_marker_can_process");
        process_exit(1);
    }

    let est_lat: Int = shim_marker_estimate_latency();
    if est_lat <= 0 {
        println("FAIL shim_marker_estimate_latency");
        process_exit(1);
    }

    let avg_lat: Int = shim_marker_avg_latency();
    if avg_lat < 0 {
        println("FAIL shim_marker_avg_latency");
        process_exit(1);
    }

    let energy: Int = shim_marker_energy();
    if energy <= 0 {
        println("FAIL shim_marker_energy");
        process_exit(1);
    }

    let opt_backend: Int = shim_marker_optimal_backend();
    if opt_backend != 1 {
        println("FAIL shim_marker_optimal_backend");
        process_exit(1);
    }

    let hot_backend: Int = inference_select_optimal_backend(80, 85);
    if hot_backend != 2 {
        println("FAIL inference_select_optimal_backend throttle");
        process_exit(1);
    }

    let mem_mb: Int = shim_marker_memory();
    if mem_mb < 1 {
        println("FAIL shim_marker_memory");
        process_exit(1);
    }

    let mem_calc: Int = inference_estimate_memory_usage_mb(64, 10, 0);
    if mem_calc != mem_mb {
        println("FAIL inference_estimate_memory_usage_mb mismatch");
        process_exit(1);
    }

    println("prod_g4_edge_inference: PASSED");
    process_exit(0);
}
