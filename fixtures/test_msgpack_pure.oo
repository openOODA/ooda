// # MessagePack adversarial suite
//
// Logline: Roundtrips fixint, int8/16/32, nil, bool, bin, fixarray, and fixmap, and rejects bad tags.
//
// Setup: Pure. Imports msgpack_pure.oo. Run from ooda/.
//
// Beats:
//   1. Encode then decode each named MessagePack form.
//   2. Prove integer values survive signed tags.
//   3. Reject an unknown tag and a truncated int16.

import "std/encoding/msgpack_pure.oo";

fn need(flag: Int, err: String, msg: String) {
    if flag < 1 {
        println("FAIL " + msg + ": " + err);
        process_exit(1);
    }
}

fn must_err(flag: Int, msg: String) {
    if flag > 0 {
        println("FAIL " + msg);
        process_exit(1);
    }
}

pub fn main() {
    let e0: ByteOut = msgpack_pure_enc_int(24);
    need(e0.flag, e0.err, "fixint");
    let d0: MsgOut = msgpack_pure_decode(e0.bytes);
    need(d0.flag, d0.err, "fixint dec");
    if d0.n != 24 {
        println("FAIL fixint n");
        process_exit(1);
    }
    let e1: ByteOut = msgpack_pure_enc_int(0 - 1);
    let d1: MsgOut = msgpack_pure_decode(e1.bytes);
    need(d1.flag, d1.err, "negfix");
    if d1.n != 0 - 1 {
        println("FAIL negfix");
        process_exit(1);
    }
    let e8: ByteOut = msgpack_pure_enc_int(0 - 100);
    let d8: MsgOut = msgpack_pure_decode(e8.bytes);
    need(d8.flag, d8.err, "int8");
    if d8.n != 0 - 100 {
        println("FAIL int8");
        process_exit(1);
    }
    let e16: ByteOut = msgpack_pure_enc_int(200);
    let d16: MsgOut = msgpack_pure_decode(e16.bytes);
    need(d16.flag, d16.err, "int16");
    if d16.n != 200 {
        println("FAIL int16");
        process_exit(1);
    }
    let e32: ByteOut = msgpack_pure_enc_int(40000);
    let d32: MsgOut = msgpack_pure_decode(e32.bytes);
    need(d32.flag, d32.err, "int32");
    if d32.n != 40000 {
        println("FAIL int32");
        process_exit(1);
    }
    let en: ByteOut = msgpack_pure_enc_nil();
    let dn: MsgOut = msgpack_pure_decode(en.bytes);
    need(dn.flag, dn.err, "nil");
    let eb: ByteOut = msgpack_pure_enc_bool(1);
    let db: MsgOut = msgpack_pure_decode(eb.bytes);
    need(db.flag, db.err, "bool");
    let mut bin: List[Int] = list_new();
    bin = list_push(bin, 1);
    bin = list_push(bin, 2);
    let ebin: ByteOut = msgpack_pure_enc_bin(bin);
    let dbin: MsgOut = msgpack_pure_decode(ebin.bytes);
    need(dbin.flag, dbin.err, "bin");
    if dbin.n != 2 {
        println("FAIL bin n");
        process_exit(1);
    }
    let mut big: List[Int] = list_new();
    let mut bi: Int = 0;
    while bi < 256 {
        big = list_push(big, bi & 255);
        bi = bi + 1;
    }
    let ebig: ByteOut = msgpack_pure_enc_bin(big);
    need(ebig.flag, ebig.err, "bin16");
    if list_get(ebig.bytes, 0) != 197 {
        println("FAIL bin16 tag");
        process_exit(1);
    }
    let dbig: MsgOut = msgpack_pure_decode(ebig.bytes);
    need(dbig.flag, dbig.err, "bin16 dec");
    if dbig.n != 256 {
        println("FAIL bin16 n");
        process_exit(1);
    }
    let ea: ByteOut = msgpack_pure_enc_array(1, e0.bytes);
    let da: MsgOut = msgpack_pure_decode(ea.bytes);
    need(da.flag, da.err, "array");
    if da.kind != 4 {
        println("FAIL array kind");
        process_exit(1);
    }
    let em: ByteOut = msgpack_pure_enc_map(1, e0.bytes);
    let dm: MsgOut = msgpack_pure_decode(em.bytes);
    need(dm.flag, dm.err, "map");
    if dm.kind != 5 {
        println("FAIL map kind");
        process_exit(1);
    }
    println("fixint, int8/16/32, nil, bool, bin8/16, fixarray, fixmap round-trip");
    let mut bad: List[Int] = list_new();
    bad = list_push(bad, 193);
    let tb: MsgOut = msgpack_pure_decode(bad);
    must_err(tb.flag, "bad tag");
    let mut tr: List[Int] = list_new();
    tr = list_push(tr, 209);
    let tt: MsgOut = msgpack_pure_decode(tr);
    must_err(tt.flag, "truncated");
    println("bad/truncated tag Err");
    println("SUITE PASSED");
    println("test_msgpack_pure: PASSED");
}
