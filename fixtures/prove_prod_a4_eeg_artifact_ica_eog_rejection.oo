// # Product prove std/neuro_bci/eeg_artifact_ica_eog_rejection.oo
//
// Logline: Fail-closed emit+gcc+run asserts ica_compute_kurtosis_4pt is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_artifact_ica_eog_rejection.oo.
//
// Beats:
//   1. Call ica_compute_kurtosis_4pt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_eeg_artifact_ica_eog_rejection: PASSED only if they match.

import "std/neuro_bci/eeg_artifact_ica_eog_rejection.oo";

pub fn main() {
    let eeg_artifact_ica_eog_rejection_mark: Int = 0;
    if eeg_artifact_ica_eog_rejection_mark != 0 {
        process_exit(1);
    }
    let a: Float = ica_compute_kurtosis_4pt(0.0, 0.0, 0.0, 0.0);
    let b: Float = ica_compute_kurtosis_4pt(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL ica_compute_kurtosis_4pt");
        process_exit(1);
    }
    println("prod_eeg_artifact_ica_eog_rejection: PASSED");
}
