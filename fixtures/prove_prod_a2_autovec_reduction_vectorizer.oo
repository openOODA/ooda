// # Product prove std/compilers_polyhedral/autovec_reduction_vectorizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_horizontal_reduction_steps is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/autovec_reduction_vectorizer.oo.
//
// Beats:
//   1. Call compute_horizontal_reduction_steps twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_autovec_reduction_vectorizer: PASSED only if they match.

import "std/compilers_polyhedral/autovec_reduction_vectorizer.oo";

pub fn main() {
    let autovec_reduction_vectorizer_mark: Int = 0;
    if autovec_reduction_vectorizer_mark != 0 {
        process_exit(1);
    }
    let a: Int = compute_horizontal_reduction_steps(0);
    let b: Int = compute_horizontal_reduction_steps(0);
    if a != b {
        println("FAIL compute_horizontal_reduction_steps");
        process_exit(1);
    }
    println("prod_autovec_reduction_vectorizer: PASSED");
}
