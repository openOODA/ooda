// # Product prove std/uav_flight/uav_potential_field_avoidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts apf_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_potential_field_avoidance.oo.
//
// Beats:
//   1. Call apf_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_potential_field_avoidance: PASSED only if they match.

import "std/uav_flight/uav_potential_field_avoidance.oo";

pub fn main() {
    let uav_potential_field_avoidance_mark: Int = 0;
    if uav_potential_field_avoidance_mark != 0 {
        process_exit(1);
    }
    let a: ApfConfig = apf_config_default();
    let b: ApfConfig = apf_config_default();
    if (a).k_attractive != (b).k_attractive {
        println("FAIL apf_config_default");
        process_exit(1);
    }
    println("prod_g2_uav_potential_field_avoidance: PASSED");
}
