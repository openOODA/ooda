// # Product prove std/wasm_gc/jit_deoptimization.oo
//
// Logline: Fail-closed emit+gcc+run asserts deopt_bailout_trigger is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_deoptimization.oo.
//
// Beats:
//   1. Call deopt_bailout_trigger twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_deoptimization: PASSED only if they match.

import "std/wasm_gc/jit_deoptimization.oo";

pub fn main() {
    let jit_deoptimization_mark: Int = 0;
    if jit_deoptimization_mark != 0 {
        process_exit(1);
    }
    let jit_deoptimization_a = deopt_bailout_trigger(1, 1, 1);
    let jit_deoptimization_b = deopt_bailout_trigger(1, 1, 1);
    if (jit_deoptimization_a).reason_code != (jit_deoptimization_b).reason_code {
        println("FAIL deopt_bailout_trigger");
        process_exit(1);
    }
    println("prod_jit_deoptimization: PASSED");
}
