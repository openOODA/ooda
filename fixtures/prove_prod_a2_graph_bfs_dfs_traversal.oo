// # Product prove std/db_graph/graph_bfs_dfs_traversal.oo
//
// Logline: Fail-closed emit+gcc+run asserts traversal_history_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_bfs_dfs_traversal.oo.
//
// Beats:
//   1. Call traversal_history_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_bfs_dfs_traversal: PASSED only if they match.

import "std/db_graph/graph_bfs_dfs_traversal.oo";

pub fn main() {
    let graph_bfs_dfs_traversal_mark: Int = 0;
    if graph_bfs_dfs_traversal_mark != 0 {
        process_exit(1);
    }
    let a: TraversalHistory = traversal_history_new();
    let b: TraversalHistory = traversal_history_new();
    if (a).total_visited != (b).total_visited {
        println("FAIL traversal_history_new");
        process_exit(1);
    }
    println("prod_graph_bfs_dfs_traversal: PASSED");
}
