// # Product prove std/quantum_advanced/shadow_tomography_classical.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadow_single_qubit_estimator is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shadow_tomography_classical.oo.
//
// Beats:
//   1. Call shadow_single_qubit_estimator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_shadow_tomography_classical: PASSED only if they match.

import "std/quantum_advanced/shadow_tomography_classical.oo";

pub fn main() {
    let shadow_tomography_classical_mark: Int = 0;
    if shadow_tomography_classical_mark != 0 {
        process_exit(1);
    }
    let a: Float = shadow_single_qubit_estimator(0, 0, 0);
    let b: Float = shadow_single_qubit_estimator(0, 0, 0);
    if a != b {
        println("FAIL shadow_single_qubit_estimator");
        process_exit(1);
    }
    println("prod_g2_shadow_tomography_classical: PASSED");
}
