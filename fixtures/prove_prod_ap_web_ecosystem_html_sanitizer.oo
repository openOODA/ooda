// # Product prove std/web_ecosystem/html_sanitizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/html_sanitizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/html_sanitizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_html_sanitizer: PASSED only if they match.

import "std/web_ecosystem/html_sanitizer.oo";

pub fn main() {
    let html_sanitizer_a = html_tag_script();
    let html_sanitizer_b = html_tag_script();
    if html_sanitizer_a != html_sanitizer_b {
        println("FAIL html_sanitizer");
        process_exit(1);
    }
    println("prod_ap_html_sanitizer: PASSED");
}
