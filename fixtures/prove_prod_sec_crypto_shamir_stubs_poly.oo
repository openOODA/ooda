// # Product prove std/sec/crypto/shamir_stubs.oo
//
// Logline: Fail-closed emit+check asserts shamir_generate_random_polynomial is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/shamir_stubs.oo.
//
// Beats:
//   1. Call shamir_generate_random_polynomial twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shamir_stubs_poly: PASSED only if they match.

import "std/sec/crypto/shamir_stubs.oo";

pub fn main() {
    let shamir_stubs_poly_mark: Int = 0;
    if shamir_stubs_poly_mark != 0 { process_exit(1); }
    let a = shamir_generate_random_polynomial(1, 2, 3);
    let b = shamir_generate_random_polynomial(1, 2, 3);
    if a != b { process_exit(1); }
    println("prod_shamir_stubs_poly: PASSED");
}
