// # Const if (1 <= 2) println
//
// Logline: Print plte-then when the condition is (1 <= 2).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (1 <= 2) print plte-then else print plte-else.
//   3. Leave no other statements.

pub fn main() {
    if (1 <= 2) {
        println("plte-then");
    } else {
        println("plte-else");
    }
}
