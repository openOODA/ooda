// # Product prove std/compilers_vm/compilers_vm_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts generate_diamond_cfg is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/compilers_vm_stubs.oo.
//
// Beats:
//   1. Call generate_diamond_cfg twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compilers_vm_stubs: PASSED only if they match.

import "std/compilers_vm/compilers_vm_stubs.oo";

pub fn main() {
    let compilers_vm_stubs_mark: Int = 0;
    if compilers_vm_stubs_mark != 0 {
        process_exit(1);
    }
    let compilers_vm_stubs_a = generate_diamond_cfg();
    let compilers_vm_stubs_b = generate_diamond_cfg();
    if (compilers_vm_stubs_a).entry_id != (compilers_vm_stubs_b).entry_id {
        println("FAIL generate_diamond_cfg");
        process_exit(1);
    }
    println("prod_compilers_vm_stubs: PASSED");
}
