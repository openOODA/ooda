// # Product prove std/hash/sha3.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha3_256 value or determinism.
//
// Setup: Isolated emit-c. Imports std/hash/sha3.oo.
//
// Beats:
//   1. Call sha3_256 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_sha3: PASSED only if asserts hold.

import "std/hash/sha3.oo";

pub fn main() {
    let sha3_a: String = sha3_256("");
    let sha3_b: String = sha3_256("");
    if chars_len(sha3_a) != 64 {
        println("FAIL sha3_256 len");
        process_exit(1);
    }
    if chars_len(sha3_a) != chars_len(sha3_b) {
        println("FAIL sha3_256 det");
        process_exit(1);
    }
    println("prod_sha3: PASSED");
}
