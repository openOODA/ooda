// # Product prove std/telecom_6g/telecom_6g_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts telecom_6g_hardware_capabilities_default is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/telecom_6g_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call telecom_6g_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_telecom_6g_stubs: PASSED only if they match.

import "std/telecom_6g/telecom_6g_stubs.oo";

pub fn main() {
    let g2_oa: Telecom6gHardwareCapabilities = telecom_6g_hardware_capabilities_default();
    let g2_ob: Telecom6gHardwareCapabilities = telecom_6g_hardware_capabilities_default();
    let g2_a = (g2_oa).max_carrier_frequency_ghz;
    let g2_b = (g2_ob).max_carrier_frequency_ghz;
    if g2_a != g2_b {
        println("FAIL telecom_6g_hardware_capabilities_default.max_carrier_frequency_ghz");
        process_exit(1);
    }
    println("prod_g2_telecom_6g_stubs: PASSED");
}
