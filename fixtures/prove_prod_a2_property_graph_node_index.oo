// # Product prove std/db_graph/property_graph_node_index.oo
//
// Logline: Fail-closed emit+gcc+run asserts node_label_index_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_node_index.oo.
//
// Beats:
//   1. Call node_label_index_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_node_index: PASSED only if they match.

import "std/db_graph/property_graph_node_index.oo";

pub fn main() {
    let property_graph_node_index_mark: Int = 0;
    if property_graph_node_index_mark != 0 {
        process_exit(1);
    }
    let a: NodeLabelIndex = node_label_index_new(0);
    let b: NodeLabelIndex = node_label_index_new(0);
    if (a).label_id != (b).label_id {
        println("FAIL node_label_index_new");
        process_exit(1);
    }
    println("prod_property_graph_node_index: PASSED");
}
