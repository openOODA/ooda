// # Return a secret parameter
//
// Logline: Return a secret-tagged parameter and print the result under a clean name.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag parameter x as secret.
//   2. Return x from leak with no local rebind.
//   3. Print the caller binding.
//
// T1-5 attack: return secret without naming secret as a local let in body
// Only // SECRET: x and return x (param). Caller println(out) with clean name.
// Expect: interproc return taint residual / bypass.
// SECRET: x
pub fn leak(x: String) -> String {
    return x;
}
pub fn main() {
    let out = leak("token");
    println(out);
}
