// # Product prove std/db_columnar/arrow_vectorized_filter.oo
//
// Logline: Fail-closed verification that Apache Arrow vectorized filter kernels and selection vector filtering are deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/arrow_vectorized_filter.oo.
//
// Beats:
//   1. Construct integer array and evaluate equality filter count kernel.
//   2. Evaluate greater-than filter count kernel and check true counts.
//   3. Compute matching selection indices and apply to integer column.
//   4. Assert deterministic filtered row count and values.
//   5. Print prod_g4_db_arrow_filter: PASSED and exit 0.

import "std/db_columnar/arrow_vectorized_filter.oo";

pub fn main() {
    let mut vals: List[Int] = list_new();
    vals = list_push(vals, 10);
    vals = list_push(vals, 25);
    vals = list_push(vals, 30);
    vals = list_push(vals, 25);
    vals = list_push(vals, 50);

    let mask_eq: FilterMask = filter_kernel_eq_count(vals, 25);
    if mask_eq.true_count != 2 || mask_eq.total_count != 5 {
        println("FAIL filter_kernel_eq_count");
        process_exit(1);
    }

    let mask_gt: FilterMask = filter_kernel_gt_count(vals, 20);
    if mask_gt.true_count != 4 || mask_gt.total_count != 5 {
        println("FAIL filter_kernel_gt_count");
        process_exit(1);
    }

    let sel: List[Int] = filter_kernel_eq_indices(vals, 25);
    if list_len(sel) != 2 {
        println("FAIL filter_kernel_eq_indices len");
        process_exit(1);
    }

    let idx0: Int = list_get(sel, 0);
    let idx1: Int = list_get(sel, 1);
    if idx0 != 1 || idx1 != 3 {
        println("FAIL selection indices");
        process_exit(1);
    }

    let filtered: List[Int] = filter_apply_selection(vals, sel);
    if list_len(filtered) != 2 {
        println("FAIL filter_apply_selection len");
        process_exit(1);
    }

    let f0: Int = list_get(filtered, 0);
    let f1: Int = list_get(filtered, 1);
    if f0 != 25 || f1 != 25 {
        println("FAIL filtered values");
        process_exit(1);
    }

    println("prod_g4_db_arrow_filter: PASSED");
    process_exit(0);
}
