// # Hostile env_get Escape Probe
//
// Logline: Refuse host env keys and accept only an OO_ probe key under EnvCap.
//
// Setup: Needs &EnvCap. Smoke sets OO_HOSTILE_PROBE=ok before run.
//
// Beats:
//   1. env_get of HOME, PATH, USER, and SECRET returns Err.
//   2. env_get of OO_HOSTILE_PROBE returns Ok("ok").
//   3. Print hostile_env_get: PASSED.

pub fn main(env: &EnvCap) {
    let home: Result[String, String] = env_get(env, "HOME");
    if home.is_ok() {
        println("FAIL: HOME must fail closed");
        process_exit(1);
    }
    let path: Result[String, String] = env_get(env, "PATH");
    if path.is_ok() {
        println("FAIL: PATH must fail closed");
        process_exit(1);
    }
    let user: Result[String, String] = env_get(env, "USER");
    if user.is_ok() {
        println("FAIL: USER must fail closed");
        process_exit(1);
    }
    let secret: Result[String, String] = env_get(env, "SECRET");
    if secret.is_ok() {
        println("FAIL: SECRET must fail closed");
        process_exit(1);
    }
    let probe: Result[String, String] = env_get(env, "OO_HOSTILE_PROBE");
    match probe {
        Ok(s) => {
            if s != "ok" {
                println("FAIL: OO_HOSTILE_PROBE value");
                process_exit(1);
            }
        },
        Err(_) => {
            println("FAIL: OO_HOSTILE_PROBE missing");
            process_exit(1);
        }
    }
    println("hostile_env_get: PASSED");
}
