// # Product prove std/media_dsp/adpcm_ima_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_step_size is a real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/adpcm_ima_decoder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call ima_step_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_adpcm_ima_decoder: PASSED only if they match.

import "std/media_dsp/adpcm_ima_decoder.oo";

pub fn main() {
    let g0_a = ima_step_size(0);
    let g0_b = ima_step_size(0);
    if g0_a != g0_b {
        println("FAIL ima_step_size");
        process_exit(1);
    }
    println("prod_gr_adpcm_ima_decoder: PASSED");
}
