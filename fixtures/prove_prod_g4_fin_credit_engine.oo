// # Product prove std/fin/credit_engine.oo
//
// Logline: Fail-closed verification that financial credit scoring and default probability assessments are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/credit_engine.oo.
//
// Beats:
//   1. Construct borrower profile and credit facility structures.
//   2. Compute credit scores, default probabilities, and credit risk assessments.
//   3. Assert deterministic rating grades and approval recommendations.
//   4. Print prod_g4_fin_credit_engine: PASSED and exit 0.

import "std/fin/credit_engine.oo";
import "std/fin/credit_engine_compute.oo";
import "std/fin/credit_engine_assess.oo";

pub fn main() {
    let probe1: Int = credit_engine_probe();
    let probe2: Int = credit_engine_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL credit_engine_probe");
        process_exit(1);
    }

    let prof1: BorrowerProfile = borrower_profile_new("B100", 120000.0, 15000.0, 1200.0, 84, 10, 0, 0, 0.12, 1, true);
    let prof2: BorrowerProfile = borrower_profile_new("B100", 120000.0, 15000.0, 1200.0, 84, 10, 0, 0, 0.12, 1, true);

    let score1: CreditScore = compute_credit_score(&prof1);
    let score2: CreditScore = compute_credit_score(&prof2);

    if (score1).score != (score2).score || (score1).score < 700 {
        println("FAIL compute_credit_score");
        process_exit(1);
    }

    let fac1: CreditFacility = credit_facility_new("F100", "B100", 25000.0, 0.055, 36, 50000.0);
    let fac2: CreditFacility = credit_facility_new("F100", "B100", 25000.0, 0.055, 36, 50000.0);

    let dp1: DefaultProbability = compute_default_probability(&score1, &prof1, &fac1);
    let dp2: DefaultProbability = compute_default_probability(&score2, &prof2, &fac2);

    if (dp1).rating_tier != (dp2).rating_tier || (dp1).rating_tier <= 0 {
        println("FAIL compute_default_probability");
        process_exit(1);
    }

    let assess1: CreditRiskAssessment = assess_borrower_credit(&prof1, &fac1);
    let assess2: CreditRiskAssessment = assess_borrower_credit(&prof2, &fac2);

    if (assess1).approval_status != (assess2).approval_status || (assess1).approval_status != 1 {
        println("FAIL assess_borrower_credit");
        process_exit(1);
    }

    println("prod_g4_fin_credit_engine: PASSED");
    process_exit(0);
}
