// # Product prove std/grid/wind_curve.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/wind_curve.oo.
//
// Beats:
//   1. Call math_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wind_curve_math: PASSED only if they match.

import "std/grid/wind_curve.oo";

pub fn main() {
    let wind_curve_mark: Int = 0;
    if wind_curve_mark != 0 { process_exit(1); }
    let a: Float = math_pi();
    let b: Float = math_pi();
    if a != b {
        println("FAIL math_pi");
        process_exit(1);
    }
    println("prod_wind_curve_math: PASSED");
}
