// # Product prove std/genomics_advanced/nanopore_adaptive_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts nanopore_adaptive_sampling_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/nanopore_adaptive_sampling.oo.
//
// Beats:
//   1. Call nanopore_adaptive_sampling_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nanopore_adaptive_sampling: PASSED only if they match.

import "std/genomics_advanced/nanopore_adaptive_sampling.oo";

pub fn main() {
    let a = nanopore_adaptive_sampling_probe();
    let b = nanopore_adaptive_sampling_probe();
    if a != b {
        println("FAIL nanopore_adaptive_sampling_probe");
        process_exit(1);
    }
    println("prod_nanopore_adaptive_sampling: PASSED");
}
