// # Product prove std/sync/async_reactor.oo
//
// Logline: Fail-closed emit+gcc+run asserts reactor_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/async_reactor.oo.
//
// Beats:
//   1. Call reactor_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_async_reactor: PASSED only if they match.

import "std/sync/async_reactor.oo";

pub fn main() {
    let obj = reactor_new();
    let a = reactor_count(obj);
    let b = reactor_count(obj);
    if a != b {
        println("FAIL reactor_count");
        process_exit(1);
    }
    println("prod_async_reactor: PASSED");
}
