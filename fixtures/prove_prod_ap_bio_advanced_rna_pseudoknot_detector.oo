// # Product prove std/bio_advanced/rna_pseudoknot_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bio_advanced/rna_pseudoknot_detector.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/rna_pseudoknot_detector.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rna_pseudoknot_detector: PASSED only if they match.

import "std/bio_advanced/rna_pseudoknot_detector.oo";

pub fn main() {
    let rna_pseudoknot_detector_a = rna_pairs_cross(0, 0, 0, 0);
    let rna_pseudoknot_detector_b = rna_pairs_cross(0, 0, 0, 0);
    if rna_pseudoknot_detector_a != rna_pseudoknot_detector_b {
        println("FAIL rna_pseudoknot_detector");
        process_exit(1);
    }
    println("prod_ap_rna_pseudoknot_detector: PASSED");
}
