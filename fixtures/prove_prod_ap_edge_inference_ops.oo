// # Product prove std/edge/inference_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/edge/inference_ops.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/edge/inference_ops.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_inference_ops: PASSED only if they match.

import "std/edge/inference_ops.oo";

pub fn main() {
    let inference_ops_a = model_config_full(0, 0, 0, 0, 0, 0, 0, 0);
    let inference_ops_b = model_config_full(0, 0, 0, 0, 0, 0, 0, 0);
    if inference_ops_a.model_id != inference_ops_b.model_id {
        println("FAIL inference_ops");
        process_exit(1);
    }
    println("prod_ap_inference_ops: PASSED");
}
