// # Product prove std/fin/routing.oo
//
// Logline: Fail-closed verification that financial order routing facade operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/routing.oo.
//
// Beats:
//   1. Initialize order route, execution report, and venue structures.
//   2. Apply fills and cancellations to route records.
//   3. Assert deterministic fill rates and net amounts.
//   4. Print prod_g4_fin_routing: PASSED and exit 0.

import "std/fin/routing.oo";

pub fn main() {
    let probe1: Int = routing_probe();
    let probe2: Int = routing_probe();
    if probe1 != probe2 || probe1 != 0 {
        println("FAIL routing_probe");
        process_exit(1);
    }

    let r1: OrderRoute = shim_marker_order_route_init();
    let r2: OrderRoute = shim_marker_order_route_init();

    let rem1: Int = shim_marker_route_rem_qty(r1);
    let rem2: Int = shim_marker_route_rem_qty(r2);
    if rem1 != rem2 || rem1 != 100 {
        println("FAIL shim_marker_route_rem_qty");
        process_exit(1);
    }

    let filled1: OrderRoute = shim_marker_route_fill(r1);
    let filled2: OrderRoute = shim_marker_route_fill(r2);

    let fr1: Int = shim_marker_fill_rate(filled1);
    let fr2: Int = shim_marker_fill_rate(filled2);
    if fr1 != fr2 || fr1 != 50 {
        println("FAIL shim_marker_fill_rate");
        process_exit(1);
    }

    let rep1: ExecutionReport = shim_marker_execution_report_init();
    let rep2: ExecutionReport = shim_marker_execution_report_init();

    let net1: Int = shim_marker_net_amount(rep1);
    let net2: Int = shim_marker_net_amount(rep2);
    if net1 != net2 || net1 != 1500005 {
        println("FAIL shim_marker_net_amount");
        process_exit(1);
    }

    println("prod_g4_fin_routing: PASSED");
    process_exit(0);
}
