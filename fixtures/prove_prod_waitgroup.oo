// # Product prove std/sync/waitgroup.oo
//
// Logline: Fail-closed emit+gcc+run asserts waitgroup_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/waitgroup.oo.
//
// Beats:
//   1. Call waitgroup_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_waitgroup: PASSED only if they match.

import "std/sync/waitgroup.oo";

pub fn main() {
    let obj = waitgroup_new();
    let a = waitgroup_count(obj);
    let b = waitgroup_count(obj);
    if a != b {
        println("FAIL waitgroup_count");
        process_exit(1);
    }
    println("prod_waitgroup: PASSED");
}
