// # Allow a third name beside two secrets
//
// Logline: Two tagged names sit unused while a public c may print.
//
// Beats:
//   1. Tag a and b at line start.
//   2. Bind a public c beside them.
//   3. Print c so the sink stays allowed.

// SECRET: a
// SECRET: b
pub fn main() {
    let a = "x";
    let b = "y";
    let c = "ok";
    println(c);
}
