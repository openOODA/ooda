// # emit-x86 string plus unary-minus ident concat
//
// Logline: Bind n to 7 and print n= plus unary-minus n so emit-x86 can lower STRING plus -ident.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind n to 7.
//   3. Print n= plus unary-minus n.
//
// residual: general ALU stays later.

pub fn main() {
    let n = 7;
    println("n=" + -n);
}
