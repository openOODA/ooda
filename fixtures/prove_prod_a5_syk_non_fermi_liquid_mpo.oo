// # Product prove std/quantum_tensor_nets/syk_non_fermi_liquid_mpo.oo
//
// Logline: Fail-closed emit+gcc+run asserts syk_lyapunov_exponent_bound is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/syk_non_fermi_liquid_mpo.oo.
//
// Beats:
//   1. Call syk_lyapunov_exponent_bound twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_syk_non_fermi_liquid_mpo: PASSED only if they match.

import "std/quantum_tensor_nets/syk_non_fermi_liquid_mpo.oo";

pub fn main() {
    let syk_non_fermi_liquid_mpo_mark: Int = 0;
    if syk_non_fermi_liquid_mpo_mark != 0 {
        process_exit(1);
    }
    let a: Float = syk_lyapunov_exponent_bound(0.0);
    let b: Float = syk_lyapunov_exponent_bound(0.0);
    if a != b {
        println("FAIL syk_lyapunov_exponent_bound");
        process_exit(1);
    }
    println("prod_syk_non_fermi_liquid_mpo: PASSED");
}
