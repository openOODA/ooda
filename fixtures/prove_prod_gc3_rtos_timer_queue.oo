// # Product prove std/embedded_hal/rtos_timer_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtos_timer_queue_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_timer_queue.oo.
//
// Beats:
//   1. Call rtos_timer_queue_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtos_timer_queue: PASSED only if they match.

import "std/embedded_hal/rtos_timer_queue.oo";

pub fn main() {
    let rtos_timer_queue_mark: Int = 0;
    if rtos_timer_queue_mark != 0 {
        process_exit(1);
    }
    let rtos_timer_queue_a = rtos_timer_queue_new();
    let rtos_timer_queue_b = rtos_timer_queue_new();
    if (rtos_timer_queue_a).current_tick != (rtos_timer_queue_b).current_tick {
        println("FAIL rtos_timer_queue_new");
        process_exit(1);
    }
    println("prod_rtos_timer_queue: PASSED");
}
