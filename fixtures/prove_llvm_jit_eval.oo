// # Product prove LLVM JIT Execution Engine and Expression Evaluation
//
// Logline: Verify LLVM JIT dynamic evaluation, expression wrapping, multi-statement snippets, and return values.
//
// Setup: Isolated emit-c or native run. Exercises llvm_jit_engine module under FsCap and SysCap.
//
// Beats:
//   1. Verify llvm_jit_engine_wrap_source on expressions and statement blocks.
//   2. Dynamically evaluate arithmetic, string, and loop snippets via LLVM JIT.
//   3. Assert deterministic results and print prove_llvm_jit_eval: PASSED.

import "oodac/llvm_jit_engine.oo";

pub fn main(fs: &FsCap, sys: &SysCap) {
    let wrap1: String = llvm_jit_engine_wrap_source("10 + 20");
    if !llvm_jit_engine_has_substr(wrap1, "println(10 + 20);") || !llvm_jit_engine_has_substr(wrap1, "pub fn main()") {
        println("FAIL: wrap expression");
        process_exit(1);
    }

    let wrap2: String = llvm_jit_engine_wrap_source("let x = 5; println(x * 2);");
    if !llvm_jit_engine_has_substr(wrap2, "let x = 5; println(x * 2);") || !llvm_jit_engine_has_substr(wrap2, "pub fn main()") {
        println("FAIL: wrap statements");
        process_exit(1);
    }

    let res_arith: Result[String, String] = llvm_jit_engine_eval_expr(fs, sys, "100 + 42");
    if res_arith.is_err() {
        println("FAIL: eval arith error");
        process_exit(1);
    }
    let out_arith: String = match res_arith { Ok(s) => s, Err(e) => e };
    if !llvm_jit_engine_has_substr(out_arith, "142") {
        println("FAIL: eval arith output: " + out_arith);
        process_exit(1);
    }

    let res_str: Result[String, String] = llvm_jit_engine_eval_expr(fs, sys, "\"LLVM_\" + \"JIT_OK\"");
    if res_str.is_err() {
        println("FAIL: eval str error");
        process_exit(1);
    }
    let out_str: String = match res_str { Ok(s) => s, Err(e) => e };
    if !llvm_jit_engine_has_substr(out_str, "LLVM_JIT_OK") {
        println("FAIL: eval str output: " + out_str);
        process_exit(1);
    }

    let loop_code: String = "let mut s = 0; let mut i = 1; while i <= 5 { s = s + i; i = i + 1; }; println(s);";
    let res_loop: Result[String, String] = llvm_jit_engine_eval_expr(fs, sys, loop_code);
    if res_loop.is_err() {
        println("FAIL: eval loop error");
        process_exit(1);
    }
    let out_loop: String = match res_loop { Ok(s) => s, Err(e) => e };
    if !llvm_jit_engine_has_substr(out_loop, "15") {
        println("FAIL: eval loop output: " + out_loop);
        process_exit(1);
    }

    println("prove_llvm_jit_eval: PASSED");
}
