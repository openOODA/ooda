// # Product prove std/fintech_defi/yield_curve_cubic_spline.oo
//
// Logline: Fail-closed emit+gcc+run asserts spline_knot_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/yield_curve_cubic_spline.oo.
//
// Beats:
//   1. Call spline_knot_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_yield_curve_cubic_spline: PASSED only if they match.

import "std/fintech_defi/yield_curve_cubic_spline.oo";

pub fn main() {
    let yield_curve_cubic_spline_mark: Int = 0;
    if yield_curve_cubic_spline_mark != 0 {
        process_exit(1);
    }
    let a: SplineKnot = spline_knot_new(0.0, 0.0);
    let b: SplineKnot = spline_knot_new(0.0, 0.0);
    if (a).tenor != (b).tenor {
        println("FAIL spline_knot_new");
        process_exit(1);
    }
    println("prod_g2_yield_curve_cubic_spline: PASSED");
}
