// # Product prove std/token_opt/semantic_chunk.oo
//
// Logline: Fail-closed emit+gcc+run asserts semantic_chunker_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/token_opt/semantic_chunk.oo.
//
// Beats:
//   1. Call semantic_chunker_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_semantic_chunk: PASSED only if they match.

import "std/token_opt/semantic_chunk.oo";

pub fn main() {
    let a: SemanticChunker = semantic_chunker_new(0, 0);
    let b: SemanticChunker = semantic_chunker_new(0, 0);
    if a.max_tokens_per_chunk != b.max_tokens_per_chunk {
        println("FAIL semantic_chunker_new");
        process_exit(1);
    }
    println("prod_semantic_chunk: PASSED");
}
