// # Product prove std/defi_derivatives/liquidation_debt_cascade.oo
//
// Logline: Fail-closed emit+gcc+run asserts calc_unrealized_pnl is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/liquidation_debt_cascade.oo.
//
// Beats:
//   1. Call calc_unrealized_pnl twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_liquidation_debt_cascade: PASSED only if they match.

import "std/defi_derivatives/liquidation_debt_cascade.oo";

pub fn main() {
    let liquidation_debt_cascade_mark: Int = 0;
    if liquidation_debt_cascade_mark != 0 {
        process_exit(1);
    }
    let a: Float = calc_unrealized_pnl(0.0, 0.0, 0.0);
    let b: Float = calc_unrealized_pnl(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL calc_unrealized_pnl");
        process_exit(1);
    }
    println("prod_g2_liquidation_debt_cascade: PASSED");
}
