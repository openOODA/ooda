// # Product prove std/auto_robot/particle_filter_loc.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/particle_filter_loc.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/particle_filter_loc.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_particle_filter_loc: PASSED only if they match.

import "std/auto_robot/particle_filter_loc.oo";

pub fn main() {
    let particle_filter_loc_a = pf_mean_x(0, 0, 0, 0);
    let particle_filter_loc_b = pf_mean_x(0, 0, 0, 0);
    if particle_filter_loc_a != particle_filter_loc_b {
        println("FAIL particle_filter_loc");
        process_exit(1);
    }
    println("prod_ap_particle_filter_loc: PASSED");
}
