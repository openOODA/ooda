// # Product prove std/markup/yaml_tokenizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/markup/yaml_tokenizer.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/yaml_tokenizer.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_yaml_tokenizer: PASSED only if they match.

import "std/markup/yaml_tokenizer.oo";

pub fn main() {
    let yaml_tokenizer_a = yaml_is_scalar_char("x");
    let yaml_tokenizer_b = yaml_is_scalar_char("x");
    if yaml_tokenizer_a != yaml_tokenizer_b {
        println("FAIL yaml_tokenizer");
        process_exit(1);
    }
    println("prod_ap_yaml_tokenizer: PASSED");
}
