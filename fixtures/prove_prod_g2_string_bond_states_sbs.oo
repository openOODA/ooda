// # Product prove std/quantum_tensor_nets/string_bond_states_sbs.oo
//
// Logline: Fail-closed emit+gcc+run asserts sbs_string_pattern_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/string_bond_states_sbs.oo.
//
// Beats:
//   1. Call sbs_string_pattern_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_string_bond_states_sbs: PASSED only if they match.

import "std/quantum_tensor_nets/string_bond_states_sbs.oo";

pub fn main() {
    let string_bond_states_sbs_mark: Int = 0;
    if string_bond_states_sbs_mark != 0 {
        process_exit(1);
    }
    let a: SbsStringPattern = sbs_string_pattern_new(0, list_new(), 0);
    let b: SbsStringPattern = sbs_string_pattern_new(0, list_new(), 0);
    if (a).string_id != (b).string_id {
        println("FAIL sbs_string_pattern_new");
        process_exit(1);
    }
    println("prod_g2_string_bond_states_sbs: PASSED");
}
