// # Product prove std/ai_multimodal/diffusion_cfg_guidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/ai_multimodal/diffusion_cfg_guidance.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/diffusion_cfg_guidance.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_diffusion_cfg_guidance: PASSED only if they match.

import "std/ai_multimodal/diffusion_cfg_guidance.oo";

pub fn main() {
    let diffusion_cfg_guidance_a = cfg_guide_one(0, 0, 0);
    let diffusion_cfg_guidance_b = cfg_guide_one(0, 0, 0);
    if diffusion_cfg_guidance_a != diffusion_cfg_guidance_b {
        println("FAIL diffusion_cfg_guidance");
        process_exit(1);
    }
    println("prod_ap_diffusion_cfg_guidance: PASSED");
}
