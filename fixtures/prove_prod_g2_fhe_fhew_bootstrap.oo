// # Product prove std/fhe_lattices/fhe_fhew_bootstrap.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhew_extract_msb is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_fhew_bootstrap.oo.
//
// Beats:
//   1. Call fhew_extract_msb twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_fhew_bootstrap: PASSED only if they match.

import "std/fhe_lattices/fhe_fhew_bootstrap.oo";

pub fn main() {
    let fhe_fhew_bootstrap_mark: Int = 0;
    if fhe_fhew_bootstrap_mark != 0 {
        process_exit(1);
    }
    let a: Int = fhew_extract_msb(0, 0);
    let b: Int = fhew_extract_msb(0, 0);
    if a != b {
        println("FAIL fhew_extract_msb");
        process_exit(1);
    }
    println("prod_g2_fhe_fhew_bootstrap: PASSED");
}
