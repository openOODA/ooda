// # Product prove std/robotics_ros2/kinematics_inverse_jacobian_dls.oo
//
// Logline: Fail-closed emit+gcc+run asserts jacobian_2x2_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/kinematics_inverse_jacobian_dls.oo.
//
// Beats:
//   1. Call jacobian_2x2_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_kinematics_inverse_jacobian_dls: PASSED only if they match.

import "std/robotics_ros2/kinematics_inverse_jacobian_dls.oo";

pub fn main() {
    let kinematics_inverse_jacobian_dls_mark: Int = 0;
    if kinematics_inverse_jacobian_dls_mark != 0 {
        process_exit(1);
    }
    let a: Jacobian2x2 = jacobian_2x2_new(0.0, 0.0, 0.0, 0.0);
    let b: Jacobian2x2 = jacobian_2x2_new(0.0, 0.0, 0.0, 0.0);
    if (a).j11 != (b).j11 {
        println("FAIL jacobian_2x2_new");
        process_exit(1);
    }
    println("prod_g2_kinematics_inverse_jacobian_dls: PASSED");
}
