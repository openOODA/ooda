// # Refuse a secret process_exit code
//
// Logline: A tagged name must not reach process_exit.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the exit code.
//   3. Expect the sink to refuse.

// Secret refuse: process_exit
// SECRET: token
pub fn main() {
    let token = 1;
    process_exit(token);
}
