// # Product prove advanced crypto
//
// Logline: Fail-closed emit+gcc+run drives ChaCha20-Poly1305, Ed25519, Shamir, and TOTP and checks recover plus refuse.
//
// Setup: Isolated emit-c. Run from ooda/.
//
// Beats:
//   1. Seal then open matches plaintext; a mutated tag is Err.
//   2. Compress then decompress a computed Ed25519 point; scalar 2 is not the identity.
//   3. k shares recover the secret; k-1 does not.
//   4. TOTP yields 6-digit and 8-digit codes at a fixed 30-second step.

import "std/crypto_advanced/chacha20_poly1305.oo";
import "std/crypto_advanced/ed25519_curve.oo";
import "std/crypto_advanced/shamir_secret.oo";
import "std/crypto_advanced/totp_rfc6238.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn same_ints(a: List[Int], b: List[Int]) -> Bool {
    if list_len(a) != list_len(b) { return false; }
    let mut i: Int = 0;
    while i < list_len(a) {
        if list_get(a, i) != list_get(b, i) { return false; }
        i = i + 1;
    }
    return true;
}

fn unwrap(r: Result[List[Int], String], msg: String) -> List[Int] {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return list_new(); }
    }
}

fn unwrap_s(r: Result[String, String], msg: String) -> String {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return ""; }
    }
}

fn fill(n: Int, v: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, v);
        i = i + 1;
    }
    return o;
}

fn prove_aead() {
    let key: List[Int] = fill(32, 7);
    let nonce: List[Int] = fill(12, 9);
    let aad: List[Int] = fill(4, 1);
    let pt: List[Int] = fill(19, 65);
    let sealed: List[Int] = unwrap(chacha20_poly1305_seal(key, nonce, aad, pt), "aead seal");
    if list_len(sealed) != 19 + 16 { fail("aead ct+tag length"); }
    let open: List[Int] = unwrap(chacha20_poly1305_open(key, nonce, aad, sealed), "aead open");
    if same_ints(open, pt) == false { fail("aead open mismatch"); }
    let mut bad: List[Int] = sealed;
    bad = list_set(bad, list_len(bad) - 1, list_get(bad, list_len(bad) - 1) ^ 1);
    let bad_r: Result[List[Int], String] = chacha20_poly1305_open(key, nonce, aad, bad);
    match bad_r {
        Ok(got) => { fail("aead bad tag accepted n=" + list_len(got).to_string()); },
        Err(e) => { println("ChaCha20-Poly1305 bad tag Err=" + e); }
    }
    println("ChaCha20-Poly1305 seal/open recover n=" + list_len(pt).to_string());
}

fn prove_ed() {
    let b: List[Int] = ed25519_curve_base();
    let p2: List[Int] = ed25519_curve_scalarmult(b, 2);
    let id: List[Int] = ed25519_curve_identity();
    let cb: List[Int] = unwrap(ed25519_curve_compress(b), "ed compress B");
    let rec: List[Int] = unwrap(ed25519_curve_decompress(cb), "ed decompress B");
    let cb2: List[Int] = unwrap(ed25519_curve_compress(rec), "ed recompress");
    if same_ints(cb, cb2) == false { fail("ed compress/decompress"); }
    let c2: List[Int] = unwrap(ed25519_curve_compress(p2), "ed compress [2]B");
    let cid: List[Int] = unwrap(ed25519_curve_compress(id), "ed compress I");
    if same_ints(c2, cid) { fail("ed [2]B is identity"); }
    let d2: List[Int] = ed25519_curve_double(b);
    let cd: List[Int] = unwrap(ed25519_curve_compress(d2), "ed compress 2B");
    if same_ints(c2, cd) == false { fail("ed scalarmult 2 != double"); }
    println("Ed25519 compress/decompress and scalar 2 not identity");
}

fn prove_shamir() {
    let mut secret: List[Int] = list_new();
    secret = list_push(secret, 42);
    secret = list_push(secret, 99);
    secret = list_push(secret, 7);
    let pack: List[Int] = unwrap(shamir_secret_split(secret, 3, 5, 1234567), "shamir split");
    let got: List[Int] = unwrap(shamir_secret_recover(pack, 3), "shamir recover k");
    if same_ints(got, secret) == false { fail("shamir k recover"); }
    let k1: Result[List[Int], String] = shamir_secret_recover(pack, 2);
    match k1 {
        Ok(wrong) => { fail("shamir k-1 recovered n=" + list_len(wrong).to_string()); },
        Err(e) => { println("Shamir k-1 Err=" + e); }
    }
    println("Shamir k recover k-1 refuse");
}

fn prove_totp() {
    let key: String = "12345678901234567890123456789012";
    let c6: String = unwrap_s(totp_rfc6238_code6(key, 59), "totp6");
    let c8: String = unwrap_s(totp_rfc6238_code8(key, 59), "totp8");
    if c6.len() != 6 { fail("totp 6 length"); }
    if c8.len() != 8 { fail("totp 8 length"); }
    let again: String = unwrap_s(totp_rfc6238_at(key, 59, 6), "totp6 again");
    if again != c6 { fail("totp not deterministic"); }
    println("TOTP 6=" + c6 + " 8=" + c8 + " step=59");
}

pub fn main() {
    prove_aead();
    prove_ed();
    prove_shamir();
    prove_totp();
    println("prove_prod_crypto_adv: PASSED");
}
