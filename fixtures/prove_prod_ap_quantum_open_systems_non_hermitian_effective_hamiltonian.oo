import "std/quantum_open_systems/non_hermitian_effective_hamiltonian.oo";

pub fn main() {
    let non_hermitian_effective_hamiltonian_a: Complex = Complex { real: 0.0, imag: 0.0 };
    let non_hermitian_effective_hamiltonian_b: Complex = Complex { real: 0.0, imag: 0.0 };
    if non_hermitian_effective_hamiltonian_a.real != non_hermitian_effective_hamiltonian_b.real {
        println("FAIL non_hermitian_effective_hamiltonian");
        process_exit(1);
    }
