// # emit-x86 else-less if true
//
// Logline: If true print yes so emit-x86 can lower a bool then-arm.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Declare main.
//   2. Take the true branch.
//   3. as+ld stdout is yes.
//
// residual: SysV stays later.

pub fn main() {
    if true {
        println("yes");
    }
}
