// # Product prove std/formal_verif/smt_branch_and_bound_lia.oo
//
// Logline: Fail-closed emit+gcc+run asserts lia_is_integral is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/smt_branch_and_bound_lia.oo.
//
// Beats:
//   1. Call lia_is_integral twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_smt_branch_and_bound_lia: PASSED only if they match.

import "std/formal_verif/smt_branch_and_bound_lia.oo";

pub fn main() {
    let smt_branch_and_bound_lia_mark: Int = 0;
    if smt_branch_and_bound_lia_mark != 0 {
        process_exit(1);
    }
    let a: Bool = lia_is_integral(0, 0);
    let b: Bool = lia_is_integral(0, 0);
    if a != b {
        println("FAIL lia_is_integral");
        process_exit(1);
    }
    println("prod_g2_smt_branch_and_bound_lia: PASSED");
}
