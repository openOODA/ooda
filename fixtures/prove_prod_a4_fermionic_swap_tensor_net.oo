// # Product prove std/quantum_tensor_nets/fermionic_swap_tensor_net.oo
//
// Logline: Fail-closed emit+gcc+run asserts fermionic_bond_parity_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/fermionic_swap_tensor_net.oo.
//
// Beats:
//   1. Call fermionic_bond_parity_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fermionic_swap_tensor_net: PASSED only if they match.

import "std/quantum_tensor_nets/fermionic_swap_tensor_net.oo";

pub fn main() {
    let fermionic_swap_tensor_net_mark: Int = 0;
    if fermionic_swap_tensor_net_mark != 0 {
        process_exit(1);
    }
    let a: FermionicBondParity = fermionic_bond_parity_new(0, 0);
    let b: FermionicBondParity = fermionic_bond_parity_new(0, 0);
    if (a).bond_index != (b).bond_index {
        println("FAIL fermionic_bond_parity_new");
        process_exit(1);
    }
    println("prod_fermionic_swap_tensor_net: PASSED");
}
