// # Product prove std/neuro_bci/synapse_short_term_plasticity.oo
//
// Logline: Fail-closed emit+gcc+run asserts stp_params_depressing real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/synapse_short_term_plasticity.oo.
//
// Beats:
//   1. Call stp_params_depressing with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synapse_short_term_plasticity: PASSED only if the assert holds.

import "std/neuro_bci/synapse_short_term_plasticity.oo";

pub fn main() {
    let synapse_short_term_plasticity_mark: Int = 0;
    if synapse_short_term_plasticity_mark != 0 {
        process_exit(1);
    }
    let synapse_short_term_plasticity_a = stp_params_depressing();
    let synapse_short_term_plasticity_u_baseline: Float = (synapse_short_term_plasticity_a).u_baseline;
    if !(synapse_short_term_plasticity_u_baseline == 0.5) {
        println("FAIL stp_params_depressing");
        process_exit(1);
    }
    println("prod_synapse_short_term_plasticity: PASSED");
}
