// # Product prove std/satellite_dvb/dvb_s2x_modcod_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_modcod_select_optimal is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_modcod_table.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dvb_modcod_select_optimal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dvb_s2x_modcod_table: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_modcod_table.oo";

pub fn main() {
    let g2_a = dvb_modcod_select_optimal(1.0, 1.0);
    let g2_b = dvb_modcod_select_optimal(1.0, 1.0);
    if g2_a != g2_b {
        println("FAIL dvb_modcod_select_optimal");
        process_exit(1);
    }
    println("prod_g2_dvb_s2x_modcod_table: PASSED");
}
