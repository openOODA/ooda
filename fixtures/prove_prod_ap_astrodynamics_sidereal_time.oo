// # Product prove std/astrodynamics/sidereal_time.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/sidereal_time.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/sidereal_time.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sidereal_time: PASSED only if they match.

import "std/astrodynamics/sidereal_time.oo";

pub fn main() {
    let sidereal_time_a = sidereal_day_s();
    let sidereal_time_b = sidereal_day_s();
    if sidereal_time_a != sidereal_time_b {
        println("FAIL sidereal_time");
        process_exit(1);
    }
    println("prod_ap_sidereal_time: PASSED");
}
