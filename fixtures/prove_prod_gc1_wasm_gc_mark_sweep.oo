// # Product prove std/wasm_gc/wasm_gc_mark_sweep.oo
//
// Logline: Fail-closed emit+gcc+run asserts mark_sweep_collector_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_mark_sweep.oo.
//
// Beats:
//   1. Call mark_sweep_collector_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_mark_sweep: PASSED only if they match.

import "std/wasm_gc/wasm_gc_mark_sweep.oo";

pub fn main() {
    let wasm_gc_mark_sweep_mark: Int = 0;
    if wasm_gc_mark_sweep_mark != 0 {
        process_exit(1);
    }
    let wasm_gc_mark_sweep_a = mark_sweep_collector_new();
    let wasm_gc_mark_sweep_b = mark_sweep_collector_new();
    if (wasm_gc_mark_sweep_a).object_count != (wasm_gc_mark_sweep_b).object_count {
        println("FAIL mark_sweep_collector_new");
        process_exit(1);
    }
    println("prod_wasm_gc_mark_sweep: PASSED");
}
