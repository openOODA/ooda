// # Chrono and Time Module Verification Proof Fixture
//
// Logline: Proves timestamp acquisition, monotonic progression, duration conversion, and formatting under TimeCap.
//
// Setup: Requires explicit &TimeCap capability token.
//
// Beats:
//   1. Acquire initial timestamp and verify positive value.
//   2. Sleep for small interval and verify elapsed delta is monotonic.
//   3. Validate duration conversions (hours, minutes, days).
//   4. Validate duration string formatting.
// RULES.oot 1.4: Default-deny for time effects. Explicit &TimeCap required.
// RULES.oot 1.6: Prove happy path timing.
// RULES.oot 1.7: Under 256 lines.

import "std/time/chrono.oo";

pub fn main(time_cap: &TimeCap) {
    let t0: Int = chrono_now_ms(time_cap);
    if t0 <= 0 {
        println("FAIL: now_ms should be positive");
        process_exit(1);
    }

    chrono_sleep_ms(time_cap, 10);

    let elapsed: Int = chrono_elapsed_ms(time_cap, t0);
    if elapsed < 0 {
        println("FAIL: elapsed time cannot be negative");
        process_exit(1);
    }

    // Unit conversions
    let ms_in_sec: Int = chrono_secs_to_ms(5);
    if ms_in_sec != 5000 {
        println("FAIL: 5 secs to ms mismatch");
        process_exit(1);
    }

    let ms_in_min: Int = chrono_mins_to_ms(2);
    if ms_in_min != 120000 {
        println("FAIL: 2 mins to ms mismatch");
        process_exit(1);
    }

    // Formatting
    let fmt_small: String = chrono_format_ms(250);
    if fmt_small != "250ms" {
        println("FAIL: fmt_small mismatch: " + fmt_small);
        process_exit(1);
    }

    println("OK: CHRONO_SMOKE_PROOF_PASSED");
}
