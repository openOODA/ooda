// # Product prove std/cloud_faas/idempotency_key_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/cloud_faas/idempotency_key_store.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/idempotency_key_store.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_idempotency_key_store: PASSED only if they match.

import "std/cloud_faas/idempotency_key_store.oo";

pub fn main() {
    let idempotency_key_store_a = idempotency_store_new(0);
    let idempotency_key_store_b = idempotency_store_new(0);
    if idempotency_key_store_a.ttl_seconds != idempotency_key_store_b.ttl_seconds {
        println("FAIL idempotency_key_store");
        process_exit(1);
    }
    println("prod_ap_idempotency_key_store: PASSED");
}
