// # Product prove std/crypto/keys_stubs.oo
//
// Logline: Fail-closed verification that keystore key revocation and workload accounting are deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/keys_stubs.oo.
//
// Beats:
//   1. Initialize KeyStore container and populate with SecretKey.
//   2. Compute keystore work metric and assert determinism.
//   3. Revoke existing key and verify absent key revocation returns false.
//   4. Print prod_g4_sec_keys_stubs: PASSED and exit 0.

import "std/crypto/keys_stubs.oo";

pub fn main() {
    let pol: KeyStorePolicy = keystore_policy_init(false, 10, true, false);
    let mut ks: KeyStore = keystore_init("store_stub", pol, "master_pwd");

    let meta: KeyMetadata = key_metadata_create("key_rev1", "AES", 0, 256, 1, 100, 200);
    let sk: SecretKey = secret_key_create(meta, "bytes_for_revocation");

    let add_res: Result[Int, String] = keystore_add_secret_key(&mut ks, sk);
    if add_res.is_err() {
        println("FAIL keystore_add_secret_key");
        process_exit(1);
    }

    let w1: Int = keystore_do_work(&ks);
    let w2: Int = keystore_do_work(&ks);

    if w1 != w2 || w1 <= 0 {
        println("FAIL keystore_do_work mismatch");
        process_exit(1);
    }

    let rev_ok: Bool = keystore_revoke_key(&mut ks, "key_rev1");
    if !rev_ok {
        println("FAIL keystore_revoke_key existing");
        process_exit(1);
    }

    let rev_none: Bool = keystore_revoke_key(&mut ks, "key_nonexistent");
    if rev_none {
        println("FAIL keystore_revoke_key non-existing was true");
        process_exit(1);
    }

    let dummy: Int = __dummy_std_src_ooda_crypto_keys_stubs_oo();
    if dummy != 0 {
        println("FAIL __dummy_std_src_ooda_crypto_keys_stubs_oo");
        process_exit(1);
    }

    println("prod_g4_sec_keys_stubs: PASSED");
    process_exit(0);
}
