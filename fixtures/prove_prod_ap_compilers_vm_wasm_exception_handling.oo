// # Product prove std/compilers_vm/wasm_exception_handling.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers_vm/wasm_exception_handling.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/wasm_exception_handling.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wasm_exception_handling: PASSED only if they match.

import "std/compilers_vm/wasm_exception_handling.oo";

pub fn main() {
    let wasm_exception_handling_a = catch_kind_tag();
    let wasm_exception_handling_b = catch_kind_tag();
    if wasm_exception_handling_a != wasm_exception_handling_b {
        println("FAIL wasm_exception_handling");
        process_exit(1);
    }
    println("prod_ap_wasm_exception_handling: PASSED");
}
