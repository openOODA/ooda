// # Product prove std/markup/msgpack_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts msgpack_decode_str_payload is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/msgpack_decoder.oo.
//
// Beats:
//   1. Call msgpack_decode_str_payload twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_msgpack_decoder: PASSED only if they match.

import "std/markup/msgpack_decoder.oo";

pub fn main() {
    let a = msgpack_decode_str_payload(list_new(), 0, 0);
    let b = msgpack_decode_str_payload(list_new(), 0, 0);
    if a != b {
        println("FAIL msgpack_decode_str_payload");
        process_exit(1);
    }
    println("prod_msgpack_decoder: PASSED");
}
