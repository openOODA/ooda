// # Product prove std/synthetic_biology/crispr_dcas9_logic_gate.oo
//
// Logline: Fail-closed emit+gcc+run asserts crispr_binding_fraction is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/crispr_dcas9_logic_gate.oo.
//
// Beats:
//   1. Call crispr_binding_fraction twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_crispr_dcas9_logic_gate: PASSED only if they match.

import "std/synthetic_biology/crispr_dcas9_logic_gate.oo";

pub fn main() {
    let crispr_dcas9_logic_gate_mark: Int = 0;
    if crispr_dcas9_logic_gate_mark != 0 {
        process_exit(1);
    }
    let a: Float = crispr_binding_fraction(0.0, 0.0, 0.0);
    let b: Float = crispr_binding_fraction(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL crispr_binding_fraction");
        process_exit(1);
    }
    println("prod_g2_crispr_dcas9_logic_gate: PASSED");
}
