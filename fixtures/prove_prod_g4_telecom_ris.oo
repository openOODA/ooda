// # Product prove std/telecom_6g/ris_phase_shift_optimizer.oo
//
// Logline: Fail-closed verification that RIS phase-shift optimization, quantization, and loss metrics are deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_phase_shift_optimizer.oo.
//
// Beats:
//   1. Construct default 64x64 RIS array configuration.
//   2. Compute ideal cascaded reflection phase shift.
//   3. Optimize discrete element phase states across quantization levels.
//   4. Assert deterministic return values.
//   5. Print prod_g4_telecom_ris: PASSED and exit 0.

import "std/telecom_6g/ris_phase_shift_optimizer.oo";

pub fn main() {
    let cfg_a: RisArrayConfig = ris_array_config_default_64x64();
    let cfg_b: RisArrayConfig = ris_array_config_default_64x64();

    if (cfg_a).num_elements_x != (cfg_b).num_elements_x || (cfg_a).num_elements_x != 64 {
        println("FAIL ris_array_config_default_64x64 num_elements_x");
        process_exit(1);
    }

    if (cfg_a).quantization_bits != (cfg_b).quantization_bits || (cfg_a).quantization_bits != 2 {
        println("FAIL ris_array_config_default_64x64 quantization_bits");
        process_exit(1);
    }

    let ideal_a: Float = ris_ideal_phase_shift(0.5, 0.5);
    let ideal_b: Float = ris_ideal_phase_shift(0.5, 0.5);
    if ideal_a != ideal_b {
        println("FAIL ris_ideal_phase_shift");
        process_exit(1);
    }

    let q1_a: Float = ris_quantize_phase(ideal_a, 1);
    let q1_b: Float = ris_quantize_phase(ideal_b, 1);
    if q1_a != q1_b {
        println("FAIL ris_quantize_phase 1-bit");
        process_exit(1);
    }

    let elem_a: RisPhaseElement = ris_optimize_element(0, 0, 0.5, 0.5, 2);
    let elem_b: RisPhaseElement = ris_optimize_element(0, 0, 0.5, 0.5, 2);

    if (elem_a).ideal_phase_rad != (elem_b).ideal_phase_rad {
        println("FAIL ris_optimize_element ideal_phase_rad");
        process_exit(1);
    }

    if (elem_a).quantized_phase_rad != (elem_b).quantized_phase_rad {
        println("FAIL ris_optimize_element quantized_phase_rad");
        process_exit(1);
    }

    let loss_a: Float = ris_quantization_loss_factor(2);
    let loss_b: Float = ris_quantization_loss_factor(2);
    if loss_a != loss_b || loss_a <= 0.0 {
        println("FAIL ris_quantization_loss_factor");
        process_exit(1);
    }

    println("prod_g4_telecom_ris: PASSED");
    process_exit(0);
}
