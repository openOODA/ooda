// # Product prove std/auto/behavior_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts status_invalid value or determinism.
//
// Setup: Isolated emit-c. Imports std/auto/behavior_engine.oo.
//
// Beats:
//   1. Call status_invalid twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_behavior_engine: PASSED only if asserts hold.

import "std/auto/behavior_engine.oo";

pub fn main() {
    let behavior_engine_a: Int = status_invalid();
    let behavior_engine_b: Int = status_invalid();
    if behavior_engine_a != behavior_engine_b {
        println("FAIL status_invalid");
        process_exit(1);
    }
    println("prod_behavior_engine: PASSED");
}
