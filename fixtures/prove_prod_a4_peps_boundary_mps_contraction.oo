// # Product prove std/quantum_tensor_nets/peps_boundary_mps_contraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts boundary_mps_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/peps_boundary_mps_contraction.oo.
//
// Beats:
//   1. Call boundary_mps_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_peps_boundary_mps_contraction: PASSED only if they match.

import "std/quantum_tensor_nets/peps_boundary_mps_contraction.oo";

pub fn main() {
    let peps_boundary_mps_contraction_mark: Int = 0;
    if peps_boundary_mps_contraction_mark != 0 {
        process_exit(1);
    }
    let a: BoundaryMpsConfig = boundary_mps_config_default(0);
    let b: BoundaryMpsConfig = boundary_mps_config_default(0);
    if (a).boundary_chi_max != (b).boundary_chi_max {
        println("FAIL boundary_mps_config_default");
        process_exit(1);
    }
    println("prod_peps_boundary_mps_contraction: PASSED");
}
