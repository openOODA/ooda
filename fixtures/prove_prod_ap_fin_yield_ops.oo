// # Product prove std/fin/yield_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fin/yield_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/yield_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_yield_ops: PASSED only if they match.

import "std/fin/yield_ops.oo";

pub fn main() {
    let yield_ops_a = compounding_type_to_string(0);
    let yield_ops_b = compounding_type_to_string(0);
    if yield_ops_a.contains(yield_ops_b) == false {
        println("FAIL yield_ops");
        process_exit(1);
    }
    if yield_ops_b.contains(yield_ops_a) == false {
        println("FAIL yield_ops");
        process_exit(1);
    }
    println("prod_ap_yield_ops: PASSED");
}
