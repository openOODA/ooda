// # Product prove std/graph_gnn/graph_pagerank_power_iter.oo
//
// Logline: Fail-closed verification that PageRank power iteration calculation is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_pagerank_power_iter.oo.
//
// Beats:
//   1. Construct PageRankConfig and initialize graph transition structures.
//   2. Run pagerank_power_iteration_step on sample graph.
//   3. Assert deterministic return values.
//   4. Print prod_g4_graph_pagerank: PASSED only if all match.

import "std/graph_gnn/graph_pagerank_power_iter.oo";

pub fn main() {
    let cfg1: PageRankConfig = pagerank_config_new(3, 850, 20, 1);
    let cfg2: PageRankConfig = pagerank_config_new(3, 850, 20, 1);
    if cfg1.num_nodes != cfg2.num_nodes {
        println("FAIL pagerank_config_new num_nodes");
        process_exit(1);
    }
    if cfg1.damping_factor_milli != cfg2.damping_factor_milli {
        println("FAIL pagerank_config_new damping_factor");
        process_exit(1);
    }
    if cfg1.max_iterations != cfg2.max_iterations {
        println("FAIL pagerank_config_new max_iterations");
        process_exit(1);
    }

    let mut p1: List[Int] = list_new();
    p1 = list_push(p1, 333);
    p1 = list_push(p1, 333);
    p1 = list_push(p1, 334);

    let mut p2: List[Int] = list_new();
    p2 = list_push(p2, 333);
    p2 = list_push(p2, 333);
    p2 = list_push(p2, 334);

    let mut v1: List[Int] = list_new();
    v1 = list_push(v1, 333);
    v1 = list_push(v1, 333);
    v1 = list_push(v1, 334);

    let mut v2: List[Int] = list_new();
    v2 = list_push(v2, 333);
    v2 = list_push(v2, 333);
    v2 = list_push(v2, 334);

    // in-neighbors: node 0 <- 1; node 1 <- 2; node 2 <- 0, 1
    let mut in_n1: List[Int] = list_new();
    in_n1 = list_push(in_n1, 1);
    in_n1 = list_push(in_n1, 2);
    in_n1 = list_push(in_n1, 0);
    in_n1 = list_push(in_n1, 1);

    let mut in_offs1: List[Int] = list_new();
    in_offs1 = list_push(in_offs1, 0);
    in_offs1 = list_push(in_offs1, 1);
    in_offs1 = list_push(in_offs1, 2);
    in_offs1 = list_push(in_offs1, 4);

    let mut in_n2: List[Int] = list_new();
    in_n2 = list_push(in_n2, 1);
    in_n2 = list_push(in_n2, 2);
    in_n2 = list_push(in_n2, 0);
    in_n2 = list_push(in_n2, 1);

    let mut in_offs2: List[Int] = list_new();
    in_offs2 = list_push(in_offs2, 0);
    in_offs2 = list_push(in_offs2, 1);
    in_offs2 = list_push(in_offs2, 2);
    in_offs2 = list_push(in_offs2, 4);

    // out degrees: node 0: 1; node 1: 2; node 2: 1
    let mut out_deg1: List[Int] = list_new();
    out_deg1 = list_push(out_deg1, 1);
    out_deg1 = list_push(out_deg1, 2);
    out_deg1 = list_push(out_deg1, 1);

    let mut out_deg2: List[Int] = list_new();
    out_deg2 = list_push(out_deg2, 1);
    out_deg2 = list_push(out_deg2, 2);
    out_deg2 = list_push(out_deg2, 1);

    let next_p1: List[Int] = pagerank_power_iteration_step(cfg1, p1, v1, in_n1, in_offs1, out_deg1);
    let next_p2: List[Int] = pagerank_power_iteration_step(cfg2, p2, v2, in_n2, in_offs2, out_deg2);

    let len1: Int = list_len(next_p1);
    let len2: Int = list_len(next_p2);
    if len1 != len2 {
        println("FAIL pagerank_power_iteration_step length mismatch");
        process_exit(1);
    }
    if len1 != 3 {
        println("FAIL pagerank_power_iteration_step length expected");
        process_exit(1);
    }

    let val0_1: Int = list_get(next_p1, 0);
    let val0_2: Int = list_get(next_p2, 0);
    if val0_1 != val0_2 {
        println("FAIL pagerank val 0");
        process_exit(1);
    }

    let val1_1: Int = list_get(next_p1, 1);
    let val1_2: Int = list_get(next_p2, 1);
    if val1_1 != val1_2 {
        println("FAIL pagerank val 1");
        process_exit(1);
    }

    println("prod_g4_graph_pagerank: PASSED");
    process_exit(0);
}
