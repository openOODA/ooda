// # Product prove std/space_propulsion/helicon_plasma_thruster.oo
//
// Logline: Fail-closed emit+gcc+run asserts helicon_spec_default_argon value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/helicon_plasma_thruster.oo.
//
// Beats:
//   1. Call helicon_spec_default_argon twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_helicon_plasma_thruster: PASSED only if asserts hold.

import "std/space_propulsion/helicon_plasma_thruster.oo";

pub fn main() {
    let helicon_plasma_thruster: HeliconThrusterSpec = helicon_spec_default_argon();
    let helicon_plasma_thruster_b: HeliconThrusterSpec = helicon_spec_default_argon();
    if (helicon_plasma_thruster).rf_power_w != 1200.0 {
        println("FAIL helicon_spec_default_argon rf_power_w");
        process_exit(1);
    }
    if (helicon_plasma_thruster).rf_power_w != (helicon_plasma_thruster_b).rf_power_w {
        println("FAIL helicon_spec_default_argon det");
        process_exit(1);
    }
    println("prod_helicon_plasma_thruster: PASSED");
}
