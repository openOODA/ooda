// # Product prove std/net/x402.oo
//
// Logline: Fail-closed emit+gcc+run asserts x402_is_payment_required is a real value.
//
// Setup: Isolated emit-c. Imports std/net/x402.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call x402_is_payment_required twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_x402: PASSED only if they match.

import "std/net/x402.oo";

pub fn main() {
    let g2_a = x402_is_payment_required(2);
    let g2_b = x402_is_payment_required(2);
    if g2_a != g2_b {
        println("FAIL x402_is_payment_required");
        process_exit(1);
    }
    println("prod_g2_x402: PASSED");
}
