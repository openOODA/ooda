// # Product prove std/crypto/fhe_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_stubs_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_stubs.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call fhe_stubs_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_fhe_stubs: PASSED only if they match.

import "std/crypto/fhe_stubs.oo";

pub fn main() {
    let g2_a = fhe_stubs_probe();
    let g2_b = fhe_stubs_probe();
    if g2_a != g2_b {
        println("FAIL fhe_stubs_probe");
        process_exit(1);
    }
    println("prod_g2_fhe_stubs: PASSED");
}
