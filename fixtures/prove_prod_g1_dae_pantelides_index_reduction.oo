// # Product prove std/digital_twin/dae_pantelides_index_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts pantelides_init_graph is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/dae_pantelides_index_reduction.oo.
//
// Beats:
//   1. Call pantelides_init_graph twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dae_pantelides_index_reduction: PASSED only if they match.

import "std/digital_twin/dae_pantelides_index_reduction.oo";

pub fn main() {
    let a: DaeIncidenceGraph = pantelides_init_graph(0, 0);
    let b: DaeIncidenceGraph = pantelides_init_graph(0, 0);
    if a.num_equations != b.num_equations {
        println("FAIL pantelides_init_graph");
        process_exit(1);
    }
    println("prod_dae_pantelides_index_reduction: PASSED");
}
