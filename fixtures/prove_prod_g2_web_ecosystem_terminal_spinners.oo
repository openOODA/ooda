// # Product prove std/web_ecosystem/terminal_spinners.oo
//
// Logline: Fail-closed emit+gcc+run asserts spinner_dots_n is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/terminal_spinners.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call spinner_dots_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_terminal_spinners: PASSED only if they match.

import "std/web_ecosystem/terminal_spinners.oo";

pub fn main() {
    let g2_a = spinner_dots_n();
    let g2_b = spinner_dots_n();
    if g2_a != g2_b {
        println("FAIL spinner_dots_n");
        process_exit(1);
    }
    println("prod_g2_terminal_spinners: PASSED");
}
