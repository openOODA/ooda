// # Product prove std/neuro_bci/spike_train_cross_correlogram.oo
//
// Logline: Fail-closed emit+gcc+run asserts correlogram5_empty is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/spike_train_cross_correlogram.oo.
//
// Beats:
//   1. Call correlogram5_empty twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spike_train_cross_correlogram: PASSED only if they match.

import "std/neuro_bci/spike_train_cross_correlogram.oo";

pub fn main() {
    let a: CrossCorrelogram5 = correlogram5_empty();
    let b: CrossCorrelogram5 = correlogram5_empty();
    if a.lag_neg2 != 0 {
        println("FAIL correlogram5_empty");
        process_exit(1);
    }
    if a.lag_neg2 != b.lag_neg2 {
        println("FAIL correlogram5_empty");
        process_exit(1);
    }
    println("prod_spike_train_cross_correlogram: PASSED");
}
