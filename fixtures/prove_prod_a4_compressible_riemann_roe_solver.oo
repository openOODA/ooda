// # Product prove std/physics_advanced/compressible_riemann_roe_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts euler_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_riemann_roe_solver.oo.
//
// Beats:
//   1. Call euler_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compressible_riemann_roe_solver: PASSED only if they match.

import "std/physics_advanced/compressible_riemann_roe_solver.oo";

pub fn main() {
    let compressible_riemann_roe_solver_mark: Int = 0;
    if compressible_riemann_roe_solver_mark != 0 {
        process_exit(1);
    }
    let a: EulerState1D = euler_state_new(0.0, 0.0, 0.0, 0.0);
    let b: EulerState1D = euler_state_new(0.0, 0.0, 0.0, 0.0);
    if (a).rho != (b).rho {
        println("FAIL euler_state_new");
        process_exit(1);
    }
    println("prod_compressible_riemann_roe_solver: PASSED");
}
