// # Product prove std/web_ecosystem/lodash_groupby.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_has_prefix is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_groupby.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call int_has_prefix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_lodash_groupby: PASSED only if they match.

import "std/web_ecosystem/lodash_groupby.oo";

pub fn main() {
    let g0_a = int_has_prefix(2, 2);
    let g0_b = int_has_prefix(2, 2);
    if g0_a != g0_b {
        println("FAIL int_has_prefix");
        process_exit(1);
    }
    println("prod_g0_lodash_groupby: PASSED");
}
