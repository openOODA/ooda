// # Product prove std/auto_robot/canfd_frame.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/canfd_frame.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/canfd_frame.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_canfd_frame: PASSED only if they match.

import "std/auto_robot/canfd_frame.oo";

pub fn main() {
    let canfd_frame_a = canfd_dlc_to_len(0);
    let canfd_frame_b = canfd_dlc_to_len(0);
    if canfd_frame_a != canfd_frame_b {
        println("FAIL canfd_frame");
        process_exit(1);
    }
    println("prod_ap_canfd_frame: PASSED");
}
