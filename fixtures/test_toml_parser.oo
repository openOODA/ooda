// # TOML parser adversarial suite
//
// Logline: Parses nested tables plus int, bool, and quoted string and looks up those keys.
//
// Setup: Pure. Imports toml_parser.oo. Run from ooda/.
//
// Beats:
//   1. Parse a document with [server] and [server.tls].
//   2. Lookup integer, boolean, and quoted string paths.
//   3. Require the recovered values to match the source text.

import "std/parsers/toml_parser.oo";

pub fn main() {
    let src: String = "name = \"openOODA\"\nenabled = true\n[server]\nport = 8080\n[server.tls]\non = false\n";
    let d: TomlDoc = toml_parser_parse(src);
    let st: Result[Int, String] = toml_parser_stat(d);
    if st.is_err() {
        println("FAIL parse");
        process_exit(1);
    }
    let port: Result[Int, String] = toml_parser_get_int(d, "server.port");
    match port {
        Ok(v) => {
            if v != 8080 {
                println("FAIL port");
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL int " + e);
            process_exit(1);
        }
    }
    let en: Result[Int, String] = toml_parser_get_bool(d, "enabled");
    match en {
        Ok(v) => {
            if v != 1 {
                println("FAIL bool");
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL bool " + e);
            process_exit(1);
        }
    }
    let nm: Result[String, String] = toml_parser_get_str(d, "name");
    match nm {
        Ok(v) => {
            if v == "openOODA" {
                println("nested table + int/bool/quoted-string lookup matches the source text");
            } else {
                println("FAIL name " + v);
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL str " + e);
            process_exit(1);
        }
    }
    let off: Result[Int, String] = toml_parser_get_bool(d, "server.tls.on");
    match off {
        Ok(v) => {
            if v != 0 {
                println("FAIL nested bool");
                process_exit(1);
            }
        },
        Err(e) => {
            println("FAIL tls " + e);
            process_exit(1);
        }
    }
    let bad: TomlDoc = toml_parser_parse("noequals");
    let bst: Result[Int, String] = toml_parser_stat(bad);
    if bst.is_ok() {
        println("FAIL syntax");
        process_exit(1);
    }
    println("SUITE PASSED");
    println("test_toml_parser: PASSED");
}
