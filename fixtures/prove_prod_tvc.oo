// # Product prove std/aero/tvc.oo
//
// Logline: Fail-closed emit+gcc+run asserts tvc_facade_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/tvc.oo.
//
// Beats:
//   1. Call tvc_facade_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tvc: PASSED only if they match.

import "std/aero/tvc.oo";

pub fn main() {
    let a = tvc_facade_abs(0);
    let b = tvc_facade_abs(0);
    if a != b {
        println("FAIL tvc_facade_abs");
        process_exit(1);
    }
    println("prod_tvc: PASSED");
}
