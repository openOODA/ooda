// # Fail recursive MaxCycles fuel
//
// Logline: Deep recursion debits the shared cycle budget and exceeds a tight cap.
//
// Beats:
//   1. Honor the line-start fuel directive as the shared budget.
//   2. Recurse twenty times from burn into itself.
//   3. Exceed five cycles so the rail sees a max-cycles refuse.

// MAX_CYCLES: 5
// M126: recursive calls debit shared fuel → exceed
fn burn(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return burn(n - 1);
}

pub fn main() {
    let x = burn(20);
    println(x);
}
