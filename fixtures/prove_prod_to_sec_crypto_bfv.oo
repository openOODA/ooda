// # Product prove std/sec/crypto/bfv.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_checksum holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bfv.oo.
//
// Beats:
//   1. Call shim_marker_checksum using the bfv ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_bfv: PASSED only if asserts hold.

import "std/sec/crypto/bfv.oo";

pub fn main() {
    let bfv_a = shim_marker_checksum();
    let bfv_b = shim_marker_checksum();
    if bfv_a != bfv_b {
        println("FAIL shim_marker_checksum");
        process_exit(1);
    }
    println("prod_bfv: PASSED");
}
