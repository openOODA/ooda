// # OPEN-86 checkpoint rollback
//
// Logline: Checkpoint a value and roll it back.
//
// Setup: checkpoint and rollback are product C.
//
// Beats:
//   1. Checkpoint 7.
//   2. Rollback.
//   3. Print open86: PASSED.

pub fn main() {
    let a = checkpoint(7);
    let b = rollback();
    println(a);
    println(b);
    println("open86: PASSED");
}
