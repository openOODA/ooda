// # User-sum match must name every variant
//
// Logline: Check refuses a Flag match that drops Off.
//
// Setup: type Flag = On | Off. Check T/E of sums is the variant set.
//
// Beats:
//   1. Match On only on an annotated Flag let.
//   2. Off is missing.
//   3. check must ERR.

type Flag = On | Off;

pub fn main() {
    let a: Flag = On;
    let v: Int = match a {
        On => 1
    };
}
