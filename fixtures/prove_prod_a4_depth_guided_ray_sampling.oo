// # Product prove std/nerf_3dgs/depth_guided_ray_sampling.oo
//
// Logline: Fail-closed emit+gcc+run asserts sample_gaussian_depth is deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/depth_guided_ray_sampling.oo.
//
// Beats:
//   1. Call sample_gaussian_depth twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_depth_guided_ray_sampling: PASSED only if they match.

import "std/nerf_3dgs/depth_guided_ray_sampling.oo";

pub fn main() {
    let depth_guided_ray_sampling_mark: Int = 0;
    if depth_guided_ray_sampling_mark != 0 {
        process_exit(1);
    }
    let a: Float = sample_gaussian_depth(0.0, 0.0, 0.0);
    let b: Float = sample_gaussian_depth(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL sample_gaussian_depth");
        process_exit(1);
    }
    println("prod_depth_guided_ray_sampling: PASSED");
}
