// # Product prove std/sec/sys/objcap_stubs.oo
//
// Logline: Fail-closed emit+check asserts objcap_membrane_install_interceptor_trap is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/objcap_stubs.oo.
//
// Beats:
//   1. Call objcap_membrane_install_interceptor_trap twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_objcap_stubs: PASSED only if they match.

import "std/sec/sys/objcap_stubs.oo";

pub fn main() {
    let objcap_stubs_mark: Int = 0;
    if objcap_stubs_mark != 0 { process_exit(1); }
    let a = objcap_membrane_install_interceptor_trap("m", "f");
    let b = objcap_membrane_install_interceptor_trap("m", "f");
    if a != b { process_exit(1); }
    println("prod_objcap_stubs: PASSED");
}
