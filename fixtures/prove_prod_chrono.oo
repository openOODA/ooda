// # Product time chrono units prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/time/chrono.oo.
//
// Setup: Product std/time/chrono.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. secs/mins/hours/days to ms.
//   2. format_ms 500, 1500, 61000.
//   9. Exit 1 before PASSED on a miss.

import "std/time/chrono.oo";

pub fn main() {
    let a: Int = chrono_secs_to_ms(2);
    if a != 2000 {
        println("FAIL chrono secs");
        process_exit(1);
    }
    let b: Int = chrono_mins_to_ms(1);
    if b != 60000 {
        println("FAIL chrono mins");
        process_exit(1);
    }
    let c: Int = chrono_hours_to_ms(1);
    if c != 3600000 {
        println("FAIL chrono hours");
        process_exit(1);
    }
    let d: Int = chrono_days_to_ms(1);
    if d != 86400000 {
        println("FAIL chrono days");
        process_exit(1);
    }
    let f0: String = chrono_format_ms(500);
    if f0 != "500ms" {
        println("FAIL chrono 500ms");
        process_exit(1);
    }
    let f1: String = chrono_format_ms(1500);
    if f1 != "1s 500ms" {
        println("FAIL chrono 1500");
        process_exit(1);
    }
    let f2: String = chrono_format_ms(61000);
    if f2 != "1m 1s" {
        println("FAIL chrono 61000");
        process_exit(1);
    }
    println("prod_chrono: PASSED");
}
