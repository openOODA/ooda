// # Product prove std/quantum_topological/kitaev_honeycomb_spin_liquid.oo
//
// Logline: Fail-closed emit+gcc+run asserts honeycomb_bond_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/kitaev_honeycomb_spin_liquid.oo.
//
// Beats:
//   1. Call honeycomb_bond_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kitaev_honeycomb_spin_liquid: PASSED only if they match.

import "std/quantum_topological/kitaev_honeycomb_spin_liquid.oo";

pub fn main() {
    let a: HoneycombBond = honeycomb_bond_new(0, 0, 0, 0.0);
    let b: HoneycombBond = honeycomb_bond_new(0, 0, 0, 0.0);
    if a.site_j != b.site_j {
        println("FAIL honeycomb_bond_new");
        process_exit(1);
    }
    println("prod_kitaev_honeycomb_spin_liquid: PASSED");
}
