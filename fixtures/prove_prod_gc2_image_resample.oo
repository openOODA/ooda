// # Product prove std/multimedia/image_resample.oo
//
// Logline: Fail-closed emit+gcc+run asserts resample_int_to_f is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/image_resample.oo.
//
// Beats:
//   1. Call resample_int_to_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_image_resample: PASSED only if they match.

import "std/multimedia/image_resample.oo";

pub fn main() {
    let image_resample_mark: Int = 0;
    if image_resample_mark != 0 {
        process_exit(1);
    }
    let image_resample_a: Float = resample_int_to_f(1);
    let image_resample_b: Float = resample_int_to_f(1);
    if image_resample_a != image_resample_b {
        println("FAIL resample_int_to_f");
        process_exit(1);
    }
    println("prod_image_resample: PASSED");
}
