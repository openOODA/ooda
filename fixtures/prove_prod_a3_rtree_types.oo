// # Product prove std/gis_spatial/rtree_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtree_box_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/rtree_types.oo.
//
// Beats:
//   1. Call rtree_box_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rtree_types: PASSED only if they match.

import "std/gis_spatial/rtree_types.oo";

pub fn main() {
    let rtree_types_mark: Int = 0;
    if rtree_types_mark != 0 {
        process_exit(1);
    }
    let a: RTreeBox = rtree_box_new(0, 0);
    let b: RTreeBox = rtree_box_new(0, 0);
    if (a).min_x != (b).min_x {
        println("FAIL rtree_box_new");
        process_exit(1);
    }
    println("prod_rtree_types: PASSED");
}
