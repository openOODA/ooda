// # Product prove std/fintech_l3_book/dma_credit_margin_monitor.oo
//
// Logline: Fail-closed emit+gcc+run asserts account_margin_state_new is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/dma_credit_margin_monitor.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call account_margin_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dma_credit_margin_monitor: PASSED only if they match.

import "std/fintech_l3_book/dma_credit_margin_monitor.oo";

pub fn main() {
    let g2_oa: AccountMarginState = account_margin_state_new("x", 2, 2, 2);
    let g2_ob: AccountMarginState = account_margin_state_new("x", 2, 2, 2);
    let g2_a = (g2_oa).total_cash_fixed;
    let g2_b = (g2_ob).total_cash_fixed;
    if g2_a != g2_b {
        println("FAIL account_margin_state_new.total_cash_fixed");
        process_exit(1);
    }
    println("prod_g2_dma_credit_margin_monitor: PASSED");
}
