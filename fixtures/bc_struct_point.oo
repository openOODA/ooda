// # Struct point fields
//
// Logline: Build a Point literal and print its x and y fields.
//
// Beats:
//   1. Construct Point { x: 3, y: 4 }.
//   2. Print p.x.
//   3. Print p.y.

// M6: struct lit + field get on bytecode VM
pub fn main() {
    let p = Point { x: 3, y: 4 };
    println(p.x);
    println(p.y);
}
