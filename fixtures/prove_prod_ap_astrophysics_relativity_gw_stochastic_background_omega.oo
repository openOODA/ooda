    let gw_stochastic_background_omega_a = sgwb_critical_energy_density(0.0);
    let gw_stochastic_background_omega_b = sgwb_critical_energy_density(0.0);
    if gw_stochastic_background_omega_a != gw_stochastic_background_omega_b {
        println("FAIL gw_stochastic_background_omega");
