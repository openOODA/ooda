// # Product prove std/db_graph/opencypher_volcano_executor.oo
//
// Logline: Fail-closed emit+gcc+run asserts volcano_tuple_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_volcano_executor.oo.
//
// Beats:
//   1. Call volcano_tuple_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_volcano_executor: PASSED only if they match.

import "std/db_graph/opencypher_volcano_executor.oo";

pub fn main() {
    let a: VolcanoTuple = volcano_tuple_new(0, 0, 0);
    let b: VolcanoTuple = volcano_tuple_new(0, 0, 0);
    if a.tuple_id != b.tuple_id {
        println("FAIL volcano_tuple_new");
        process_exit(1);
    }
    println("prod_opencypher_volcano_executor: PASSED");
}
