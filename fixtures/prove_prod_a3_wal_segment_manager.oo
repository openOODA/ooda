// # Product prove std/db_storage/wal_segment_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts wal_segment_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_segment_manager.oo.
//
// Beats:
//   1. Call wal_segment_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wal_segment_manager: PASSED only if they match.

import "std/db_storage/wal_segment_manager.oo";

pub fn main() {
    let a: WalSegmentManager = wal_segment_manager_new(0);
    let b: WalSegmentManager = wal_segment_manager_new(0);
    if (a).segment_size_limit != (b).segment_size_limit {
        println("FAIL wal_segment_manager_new");
        process_exit(1);
    }
    println("prod_wal_segment_manager: PASSED");
}
