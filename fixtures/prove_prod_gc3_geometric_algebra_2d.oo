// # Product prove std/scicomp/geometric_algebra_2d.oo
//
// Logline: Fail-closed emit+gcc+run asserts mv2_scalar is deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/geometric_algebra_2d.oo.
//
// Beats:
//   1. Call mv2_scalar twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_geometric_algebra_2d: PASSED only if they match.

import "std/scicomp/geometric_algebra_2d.oo";

pub fn main() {
    let geometric_algebra_2d_mark: Int = 0;
    if geometric_algebra_2d_mark != 0 {
        process_exit(1);
    }
    let geometric_algebra_2d_a = mv2_scalar(1.0);
    let geometric_algebra_2d_b = mv2_scalar(1.0);
    if (geometric_algebra_2d_a).s != (geometric_algebra_2d_b).s {
        println("FAIL mv2_scalar");
        process_exit(1);
    }
    println("prod_geometric_algebra_2d: PASSED");
}
