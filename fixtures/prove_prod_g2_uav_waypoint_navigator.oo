// # Product prove std/uav_flight/uav_waypoint_navigator.oo
//
// Logline: Fail-closed emit+gcc+run asserts nav_waypoint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_waypoint_navigator.oo.
//
// Beats:
//   1. Call nav_waypoint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_waypoint_navigator: PASSED only if they match.

import "std/uav_flight/uav_waypoint_navigator.oo";

pub fn main() {
    let uav_waypoint_navigator_mark: Int = 0;
    if uav_waypoint_navigator_mark != 0 {
        process_exit(1);
    }
    let a: NavWaypoint = nav_waypoint_new(0, 0, 0, 0, 0, 0, 0, 0);
    let b: NavWaypoint = nav_waypoint_new(0, 0, 0, 0, 0, 0, 0, 0);
    if (a).x_mm != (b).x_mm {
        println("FAIL nav_waypoint_new");
        process_exit(1);
    }
    println("prod_g2_uav_waypoint_navigator: PASSED");
}
