// # Product prove std/ai_ml/activation_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts act_relu is a real value.
//
// Setup: Isolated emit-c. Imports std/ai_ml/activation_ops.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call act_relu twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_activation_ops: PASSED only if they match.

import "std/ai_ml/activation_ops.oo";

pub fn main() {
    let g0_a = act_relu(0.0);
    let g0_b = act_relu(0.0);
    if g0_a != g0_b {
        println("FAIL act_relu");
        process_exit(1);
    }
    println("prod_gr_activation_ops: PASSED");
}
