// # Allow a public alias beside a secret
//
// Logline: A public literal bound to y is not tainted just because x is tagged.
//
// Beats:
//   1. Tag x at line start.
//   2. Bind y to a public literal, not that IDENT.
//   3. Print y so the sink stays allowed.

// M53 path B — no prop when RHS is not secret IDENT
// SECRET: x
pub fn main() {
    let x = "token";
    let y = "public";
    println(y);
}
