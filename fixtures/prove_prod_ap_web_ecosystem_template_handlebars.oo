// # Product prove std/web_ecosystem/template_handlebars.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/template_handlebars.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/template_handlebars.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_template_handlebars: PASSED only if they match.

import "std/web_ecosystem/template_handlebars.oo";

pub fn main() {
    let template_handlebars_a = handlebars_escape_kind(0);
    let template_handlebars_b = handlebars_escape_kind(0);
    if template_handlebars_a != template_handlebars_b {
        println("FAIL template_handlebars");
        process_exit(1);
    }
    println("prod_ap_template_handlebars: PASSED");
}
