// # Product prove std/swarm/dispatch.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_healthy holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/swarm/dispatch.oo.
//
// Beats:
//   1. Call shim_marker_healthy using the dispatch ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_dispatch: PASSED only if asserts hold.

import "std/swarm/dispatch.oo";

pub fn main() {
    let dispatch_a = shim_marker_healthy();
    let dispatch_b = shim_marker_healthy();
    if dispatch_a != dispatch_b {
        println("FAIL shim_marker_healthy");
        process_exit(1);
    }
    println("prod_dispatch: PASSED");
}
