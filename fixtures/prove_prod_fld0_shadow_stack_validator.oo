// # Product prove std/security_defense/shadow_stack_validator.oo
//
// Logline: Fail-closed emit+gcc+run asserts shadow_stack_is_healthy is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/shadow_stack_validator.oo.
//
// Beats:
//   1. Call shadow_stack_is_healthy twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shadow_stack_validator: PASSED only if they match.

import "std/security_defense/shadow_stack_validator.oo";

pub fn main() {
    let shadow_stack_validator_mark: Int = 0;
    if shadow_stack_validator_mark != 0 {
        process_exit(1);
    }
    let shadow_stack_validator_obj: ShadowStack = shadow_stack_new(1);
    let shadow_stack_validator_a: Bool = shadow_stack_is_healthy(&shadow_stack_validator_obj);
    let shadow_stack_validator_b: Bool = shadow_stack_is_healthy(&shadow_stack_validator_obj);
    if shadow_stack_validator_a != shadow_stack_validator_b {
        println("FAIL shadow_stack_is_healthy");
        process_exit(1);
    }
    println("prod_shadow_stack_validator: PASSED");
}
