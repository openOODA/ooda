// # Product sync fiber scheduler prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/fiber_scheduler.oo.
//
// Setup: Product std/sync/fiber_scheduler.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New len 0 empty.
//   2. Spawn then len 1.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/fiber_scheduler.oo";

pub fn main() {
    let s0: FiberScheduler = scheduler_new();
    let n0: Int = scheduler_len(s0);
    if n0 != 0 {
        println("FAIL fsched 0");
        process_exit(1);
    }
    if scheduler_is_empty(s0) == false {
        println("FAIL fsched empty");
        process_exit(1);
    }
    let s1: FiberScheduler = scheduler_spawn(s0, "f1");
    let n1: Int = scheduler_len(s1);
    if n1 != 1 {
        println("FAIL fsched 1");
        process_exit(1);
    }
    println("prod_fsched: PASSED");
}
