// # Product sync fiber state prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/fiber.oo.
//
// Setup: Product std/sync/fiber.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Create is runnable.
//   2. Yield is suspended. Terminate is terminated.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/fiber.oo";

pub fn main() {
    let f: FiberState = fiber_create(1, "w", "p");
    if fiber_is_runnable(f) == false {
        println("FAIL fiber run");
        process_exit(1);
    }
    if fiber_is_suspended(f) {
        println("FAIL fiber not susp");
        process_exit(1);
    }
    let y: FiberState = fiber_yield(f, "v");
    if fiber_is_suspended(y) == false {
        println("FAIL fiber yield");
        process_exit(1);
    }
    if fiber_is_runnable(y) {
        println("FAIL fiber yield run");
        process_exit(1);
    }
    let t: FiberState = fiber_terminate(f, "done");
    if fiber_is_terminated(t) == false {
        println("FAIL fiber term");
        process_exit(1);
    }
    println("prod_fiberst: PASSED");
}
