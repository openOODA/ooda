// # Product prove std/media_dsp/aiff_audio_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts aiff_decode_ieee_extended is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/aiff_audio_parser.oo.
//
// Beats:
//   1. Call aiff_decode_ieee_extended twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_aiff_audio_parser: PASSED only if they match.

import "std/media_dsp/aiff_audio_parser.oo";

pub fn main() {
    let aiff_audio_parser_mark: Int = 0;
    if aiff_audio_parser_mark != 0 {
        process_exit(1);
    }
    let a: Float = aiff_decode_ieee_extended(0, 0);
    let b: Float = aiff_decode_ieee_extended(0, 0);
    if a != b {
        println("FAIL aiff_decode_ieee_extended");
        process_exit(1);
    }
    println("prod_aiff_audio_parser: PASSED");
}
