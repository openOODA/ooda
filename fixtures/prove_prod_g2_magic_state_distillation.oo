// # Product prove std/quantum_advanced/magic_state_distillation.oo
//
// Logline: Fail-closed emit+gcc+run asserts magic_state_is_below_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/magic_state_distillation.oo.
//
// Beats:
//   1. Call magic_state_is_below_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_magic_state_distillation: PASSED only if they match.

import "std/quantum_advanced/magic_state_distillation.oo";

pub fn main() {
    let magic_state_distillation_mark: Int = 0;
    if magic_state_distillation_mark != 0 {
        process_exit(1);
    }
    let a: Int = magic_state_is_below_threshold(0.0);
    let b: Int = magic_state_is_below_threshold(0.0);
    if a != b {
        println("FAIL magic_state_is_below_threshold");
        process_exit(1);
    }
    println("prod_g2_magic_state_distillation: PASSED");
}
