// # Product prove std/exploit_analysis/shellcode_polymorphic_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts detect_getpc_stub is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/shellcode_polymorphic_decoder.oo.
//
// Beats:
//   1. Call detect_getpc_stub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shellcode_polymorphic_decoder: PASSED only if they match.

import "std/exploit_analysis/shellcode_polymorphic_decoder.oo";

pub fn main() {
    let shellcode_polymorphic_decoder_mark: Int = 0;
    if shellcode_polymorphic_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Bool = detect_getpc_stub(list_new());
    let b: Bool = detect_getpc_stub(list_new());
    if a != b {
        println("FAIL detect_getpc_stub");
        process_exit(1);
    }
    println("prod_shellcode_polymorphic_decoder: PASSED");
}
