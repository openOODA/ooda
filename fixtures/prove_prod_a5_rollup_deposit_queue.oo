// # Product prove std/zk_rollup/rollup_deposit_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts deposit_record_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_deposit_queue.oo.
//
// Beats:
//   1. Call deposit_record_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_deposit_queue: PASSED only if they match.

import "std/zk_rollup/rollup_deposit_queue.oo";

pub fn main() {
    let rollup_deposit_queue_mark: Int = 0;
    if rollup_deposit_queue_mark != 0 {
        process_exit(1);
    }
    let a: DepositRecord = deposit_record_new(0, 0, 0, 0, 0);
    let b: DepositRecord = deposit_record_new(0, 0, 0, 0, 0);
    if (a).deposit_index != (b).deposit_index {
        println("FAIL deposit_record_new");
        process_exit(1);
    }
    println("prod_rollup_deposit_queue: PASSED");
}
