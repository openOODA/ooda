// # Product prove std/auto/lanelet_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts llt_op_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/lanelet_ops.oo.
//
// Beats:
//   1. Call llt_op_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lanelet_ops: PASSED only if they match.

import "std/auto/lanelet_ops.oo";

pub fn main() {
    let lanelet_ops_mark: Int = 0;
    if lanelet_ops_mark != 0 {
        process_exit(1);
    }
    let a: LltOp = llt_op_new(0, 0);
    let b: LltOp = llt_op_new(0, 0);
    if (a).speed_kph != (b).speed_kph {
        println("FAIL llt_op_new");
        process_exit(1);
    }
    println("prod_lanelet_ops: PASSED");
}
