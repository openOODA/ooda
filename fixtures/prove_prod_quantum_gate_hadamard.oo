// # Product prove std/quantum/gate_hadamard.oo
//
// Logline: Fail-closed emit+check asserts hadamard_is_hermitian is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_hadamard.oo.
//
// Beats:
//   1. Call hadamard_is_hermitian twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_hadamard: PASSED only if they match.

import "std/quantum/gate_hadamard.oo";

pub fn main() {
    let gate_hadamard_mark: Int = 0;
    if gate_hadamard_mark != 0 { process_exit(1); }
    let a: Bool = hadamard_is_hermitian();
    let b: Bool = hadamard_is_hermitian();
    if a != b { process_exit(1); }
    println("prod_gate_hadamard: PASSED");
}
