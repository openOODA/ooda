// # Product prove std/hash/sha512.oo
//
// Logline: Fail-closed emit+gcc+run asserts sha512 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/sha512.oo.
//
// Beats:
//   1. Call sha512 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha512: PASSED only if they match.

import "std/hash/sha512.oo";

pub fn main() {
    let a = sha512("x");
    let b = sha512("x");
    if a != b {
        println("FAIL sha512");
        process_exit(1);
    }
    println("prod_sha512: PASSED");
}
