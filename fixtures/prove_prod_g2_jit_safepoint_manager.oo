// # Product prove std/wasm_gc/jit_safepoint_manager.oo
//
// Logline: Fail-closed emit+gcc+run asserts stack_map_entry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_safepoint_manager.oo.
//
// Beats:
//   1. Call stack_map_entry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_jit_safepoint_manager: PASSED only if they match.

import "std/wasm_gc/jit_safepoint_manager.oo";

pub fn main() {
    let jit_safepoint_manager_mark: Int = 0;
    if jit_safepoint_manager_mark != 0 {
        process_exit(1);
    }
    let a: StackMapEntry = stack_map_entry_new(0);
    let b: StackMapEntry = stack_map_entry_new(0);
    if (a).code_offset != (b).code_offset {
        println("FAIL stack_map_entry_new");
        process_exit(1);
    }
    println("prod_g2_jit_safepoint_manager: PASSED");
}
