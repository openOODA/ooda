// # Product prove std/defi_derivatives/options_barrier_partial_time.oo
//
// Logline: Fail-closed emit+gcc+run asserts pb_norm_pdf is a real value.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/options_barrier_partial_time.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pb_norm_pdf twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_options_barrier_partial_time: PASSED only if they match.

import "std/defi_derivatives/options_barrier_partial_time.oo";

pub fn main() {
    let g0_a = pb_norm_pdf(1.0);
    let g0_b = pb_norm_pdf(1.0);
    if g0_a != g0_b {
        println("FAIL pb_norm_pdf");
        process_exit(1);
    }
    println("prod_g0_options_barrier_partial_time: PASSED");
}
