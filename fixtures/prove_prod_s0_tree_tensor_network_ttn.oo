// # Product prove std/quantum_tensor_nets/tree_tensor_network_ttn.oo
//
// Logline: Fail-closed emit+gcc+run asserts ttn_node_leaf_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tree_tensor_network_ttn.oo.
//
// Beats:
//   1. Call ttn_node_leaf_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_tree_tensor_network_ttn: PASSED only if asserts hold.

import "std/quantum_tensor_nets/tree_tensor_network_ttn.oo";

pub fn main() {
    let tree_tensor_network_ttn_a: TtnNode = ttn_node_leaf_new(0, 0, 0, 0);
    let tree_tensor_network_ttn_b: TtnNode = ttn_node_leaf_new(0, 0, 0, 0);
    if tree_tensor_network_ttn_a.node_id != tree_tensor_network_ttn_b.node_id {
        println("FAIL ttn_node_leaf_new");
        process_exit(1);
    }
    println("prod_tree_tensor_network_ttn: PASSED");
}
