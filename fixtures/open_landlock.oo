// # Landlock Path Jail Fixture
//
// Logline: Call product landlock_restrict and prove empty allowlists fail closed, then jail writes if the ABI exists.
//
// Setup: Needs &SysCap, &EnvCap, and &FsWriteCap. Product name landlock_restrict lowers to C symbol oo_landlock_restrict.
//
// Beats:
//   1. Empty read and write dirs return Err.
//   2. Query oo_landlock_is_available.
//   3. If the ABI is missing, a real restrict also returns Err.
//   4. If the ABI exists, restrict writes to OO_LL_JAIL and refuse OO_LL_OUT.

import "std/sec/landlock.oo";

pub fn main(sys: &SysCap, env: &EnvCap, fw: &FsWriteCap) {
    let empty: Result[Bool, String] = landlock_restrict(sys, "", "");
    if empty.is_ok() {
        println("FAIL: empty dirs must fail closed");
        process_exit(1);
    }

    let avail: Int = oo_landlock_is_available();
    let jail_r: Result[String, String] = env_get(env, "OO_LL_JAIL");
    let out_r: Result[String, String] = env_get(env, "OO_LL_OUT");
    let jail: String = match jail_r {
        Ok(s) => s,
        Err(_) => "/tmp/oo_open_ll_jail"
    };
    let outside: String = match out_r {
        Ok(s) => s,
        Err(_) => "/tmp/oo_open_ll_out.txt"
    };

    if avail <= 0 {
        let r: Result[Bool, String] = landlock_restrict(sys, jail, jail);
        if r.is_ok() {
            println("FAIL: restrict ok without ABI");
            process_exit(1);
        }
        println("OK: LANDLOCK_UNAVAILABLE");
        return;
    }

    let r: Result[Bool, String] = landlock_restrict(sys, "/", jail);
    if r.is_err() {
        println("FAIL: restrict failed while available");
        process_exit(1);
    }

    let inside: String = jail + "/in.txt";
    let win: Result[Void, String] = write_file(fw, inside, "inside");
    if win.is_err() {
        println("FAIL: write inside jail");
        process_exit(1);
    }
    let wout: Result[Void, String] = write_file(fw, outside, "outside");
    if wout.is_ok() {
        println("FAIL: write outside jail succeeded");
        process_exit(1);
    }
    println("OK: LANDLOCK_JAIL");
}
