// # Product prove std/compilers/lsp_protocol.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/compilers/lsp_protocol.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/compilers/lsp_protocol.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_lsp_protocol: PASSED only if they match.

import "std/compilers/lsp_protocol.oo";

pub fn main() {
    let lsp_protocol_a = lsp_position_new(0, 0);
    let lsp_protocol_b = lsp_position_new(0, 0);
    if lsp_protocol_a.line != lsp_protocol_b.line {
        println("FAIL lsp_protocol");
        process_exit(1);
    }
    println("prod_ap_lsp_protocol: PASSED");
}
