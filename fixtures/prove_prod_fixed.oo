// # Product Q16.16 fixed-point prove
//
// Logline: Fail-closed emit+gcc+run of shipped fixed_from_int/add/mul/to_int.
//
// Setup: Product std/math/fixed_point.oo. Scale 65536.
//
// Beats:
//   1. 2+3 is 5.
//   2. 2*3 is 6.
//   3. Exit 1 before PASSED on a miss.

import "std/math/fixed_point.oo";

pub fn main() {
    let a: Fixed64 = fixed_from_int(2);
    let b: Fixed64 = fixed_from_int(3);
    let s: Fixed64 = fixed_add(a, b);
    let si: Int = fixed_to_int(s);
    if si != 5 {
        println("FAIL fixed add");
        process_exit(1);
    }
    let p: Fixed64 = fixed_mul(a, b);
    let pi: Int = fixed_to_int(p);
    if pi != 6 {
        println("FAIL fixed mul");
        process_exit(1);
    }
    println("prod_fixed: PASSED");
}
