// # Product prove std/gis_spatial/kml_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts kml_identify_tag is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/kml_parser.oo.
//
// Beats:
//   1. Call kml_identify_tag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kml_parser: PASSED only if they match.

import "std/gis_spatial/kml_parser.oo";

pub fn main() {
    let kml_parser_mark: Int = 0;
    if kml_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = kml_identify_tag("x");
    let b: Int = kml_identify_tag("x");
    if a != b {
        println("FAIL kml_identify_tag");
        process_exit(1);
    }
    println("prod_kml_parser: PASSED");
}
