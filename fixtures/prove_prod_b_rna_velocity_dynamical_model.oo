// # Product prove std/genomics_advanced/rna_velocity_dynamical_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_velocity_dynamical_model_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/rna_velocity_dynamical_model.oo.
//
// Beats:
//   1. Call rna_velocity_dynamical_model_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rna_velocity_dynamical_model: PASSED only if they match.

import "std/genomics_advanced/rna_velocity_dynamical_model.oo";

pub fn main() {
    let a = rna_velocity_dynamical_model_probe();
    let b = rna_velocity_dynamical_model_probe();
    if a != b {
        println("FAIL rna_velocity_dynamical_model_probe");
        process_exit(1);
    }
    println("prod_rna_velocity_dynamical_model: PASSED");
}
