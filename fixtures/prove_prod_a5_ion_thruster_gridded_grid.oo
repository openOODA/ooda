// # Product prove std/space_propulsion/ion_thruster_gridded_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts gridded_ion_spec_default_xenon is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ion_thruster_gridded_grid.oo.
//
// Beats:
//   1. Call gridded_ion_spec_default_xenon twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ion_thruster_gridded_grid: PASSED only if they match.

import "std/space_propulsion/ion_thruster_gridded_grid.oo";

pub fn main() {
    let ion_thruster_gridded_grid_mark: Int = 0;
    if ion_thruster_gridded_grid_mark != 0 {
        process_exit(1);
    }
    let a: GriddedIonSpec = gridded_ion_spec_default_xenon();
    let b: GriddedIonSpec = gridded_ion_spec_default_xenon();
    if (a).num_apertures != (b).num_apertures {
        println("FAIL gridded_ion_spec_default_xenon");
        process_exit(1);
    }
    println("prod_ion_thruster_gridded_grid: PASSED");
}
