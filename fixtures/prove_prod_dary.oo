// # Product heap_dary prove
//
// Logline: Fail-closed emit+gcc+run of shipped dary_heap_push/len.
//
// Setup: Product std/collections/heap_dary.oo. Degree 4, two pushes.
//
// Beats:
//   1. After two pushes, len is 2.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/heap_dary.oo";

pub fn main() {
    let mut h: DaryHeap = dary_heap_new(4);
    h = dary_heap_push(h, 3);
    h = dary_heap_push(h, 7);
    let n: Int = dary_heap_len(h);
    if n != 2 {
        println("FAIL dary len");
        process_exit(1);
    }
    println("prod_dary: PASSED");
}
