// # Product prove std/hft_alpha/mm_cartea_jaimungal_drift.oo
//
// Logline: Fail-closed emit+gcc+run asserts cj_params_new is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_cartea_jaimungal_drift.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cj_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_cartea_jaimungal_drift: PASSED only if they match.

import "std/hft_alpha/mm_cartea_jaimungal_drift.oo";

pub fn main() {
    let g2_oa: CjParams = cj_params_new(1.0, 1.0, 1.0, 1.0);
    let g2_ob: CjParams = cj_params_new(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).gamma_inventory_risk;
    let g2_b = (g2_ob).gamma_inventory_risk;
    if g2_a != g2_b {
        println("FAIL cj_params_new.gamma_inventory_risk");
        process_exit(1);
    }
    println("prod_g2_mm_cartea_jaimungal_drift: PASSED");
}
