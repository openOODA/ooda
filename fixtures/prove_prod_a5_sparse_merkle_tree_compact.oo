// # Product prove std/zk_rollup/sparse_merkle_tree_compact.oo
//
// Logline: Fail-closed emit+gcc+run asserts smt_compact_node_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_compact.oo.
//
// Beats:
//   1. Call smt_compact_node_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sparse_merkle_tree_compact: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_compact.oo";

pub fn main() {
    let sparse_merkle_tree_compact_mark: Int = 0;
    if sparse_merkle_tree_compact_mark != 0 {
        process_exit(1);
    }
    let a: SmtCompactNode = smt_compact_node_new(0, "x", "x", true);
    let b: SmtCompactNode = smt_compact_node_new(0, "x", "x", true);
    if (a).bit_depth != (b).bit_depth {
        println("FAIL smt_compact_node_new");
        process_exit(1);
    }
    println("prod_sparse_merkle_tree_compact: PASSED");
}
