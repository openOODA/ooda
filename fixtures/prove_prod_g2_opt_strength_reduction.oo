// # Product prove std/compilers_vm/opt_strength_reduction.oo
//
// Logline: Fail-closed emit+gcc+run asserts primary_ind_var_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_strength_reduction.oo.
//
// Beats:
//   1. Call primary_ind_var_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_opt_strength_reduction: PASSED only if they match.

import "std/compilers_vm/opt_strength_reduction.oo";

pub fn main() {
    let opt_strength_reduction_mark: Int = 0;
    if opt_strength_reduction_mark != 0 {
        process_exit(1);
    }
    let a: PrimaryIndVar = primary_ind_var_new("x", 0, 0, 0);
    let b: PrimaryIndVar = primary_ind_var_new("x", 0, 0, 0);
    if (a).init_val != (b).init_val {
        println("FAIL primary_ind_var_new");
        process_exit(1);
    }
    println("prod_g2_opt_strength_reduction: PASSED");
}
