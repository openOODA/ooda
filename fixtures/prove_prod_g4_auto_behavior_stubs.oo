// # Product prove std/auto/behavior_stubs.oo
//
// Logline: Fail-closed verification that autonomous vehicle behavior stubs markers and types are deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/behavior_stubs.oo.
//
// Beats:
//   1. Query behavior types and ops stubs markers.
//   2. Initialize vehicle state, decision node, and behavior tree structures.
//   3. Assert deterministic state creation.
//   4. Print prod_g4_auto_behavior_stubs: PASSED and exit 0.

import "std/auto/behavior_stubs.oo";

pub fn main() {
    let behavior_stubs_mark: Int = 0;
    if behavior_stubs_mark != 0 {
        process_exit(1);
    }

    let m_types_a: Int = behavior_types_stubs_mark();
    let m_types_b: Int = behavior_types_stubs_mark();
    if m_types_a != m_types_b || m_types_a != 1 {
        println("FAIL behavior_types_stubs_mark");
        process_exit(1);
    }

    let m_ops_a: Int = behavior_ops_stubs_mark();
    let m_ops_b: Int = behavior_ops_stubs_mark();
    if m_ops_a != m_ops_b {
        println("FAIL behavior_ops_stubs_mark");
        process_exit(1);
    }

    let node_a: DecisionNode = decision_node_new(1, 0, "root");
    let node_b: DecisionNode = decision_node_new(1, 0, "root");
    if (node_a).id != (node_b).id || (node_a).node_type != (node_b).node_type {
        println("FAIL decision_node_new");
        process_exit(1);
    }

    let tree_a: BehaviorTree = behavior_tree_new(1, 16);
    let tree_b: BehaviorTree = behavior_tree_new(1, 16);
    if (tree_a).tree_id != (tree_b).tree_id || (tree_a).max_nodes != (tree_b).max_nodes {
        println("FAIL behavior_tree_new");
        process_exit(1);
    }

    let v_a: VehicleState = vehicle_state_zero();
    let v_b: VehicleState = vehicle_state_zero();
    if (v_a).id != (v_b).id || (v_a).speed != (v_b).speed {
        println("FAIL vehicle_state_zero");
        process_exit(1);
    }

    println("prod_g4_auto_behavior_stubs: PASSED");
    process_exit(0);
}
