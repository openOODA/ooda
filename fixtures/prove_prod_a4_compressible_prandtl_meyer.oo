// # Product prove std/physics_advanced/compressible_prandtl_meyer.oo
//
// Logline: Fail-closed emit+gcc+run asserts prandtl_meyer_nu is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_prandtl_meyer.oo.
//
// Beats:
//   1. Call prandtl_meyer_nu twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compressible_prandtl_meyer: PASSED only if they match.

import "std/physics_advanced/compressible_prandtl_meyer.oo";

pub fn main() {
    let compressible_prandtl_meyer_mark: Int = 0;
    if compressible_prandtl_meyer_mark != 0 {
        process_exit(1);
    }
    let a: Float = prandtl_meyer_nu(0.0, 0.0);
    let b: Float = prandtl_meyer_nu(0.0, 0.0);
    if a != b {
        println("FAIL prandtl_meyer_nu");
        process_exit(1);
    }
    println("prod_compressible_prandtl_meyer: PASSED");
}
