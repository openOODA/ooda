// # Product prove std/space_propulsion/ballistic_entry_deceleration.oo
//
// Logline: Fail-closed emit+gcc+run asserts ballistic_compute_allen_eggers is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ballistic_entry_deceleration.oo.
//
// Beats:
//   1. Call ballistic_compute_allen_eggers twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ballistic_entry_deceleration: PASSED only if they match.

import "std/space_propulsion/ballistic_entry_deceleration.oo";

pub fn main() {
    let ballistic_entry_deceleration_mark: Int = 0;
    if ballistic_entry_deceleration_mark != 0 {
        process_exit(1);
    }
    let ballistic_entry_deceleration_a = ballistic_compute_allen_eggers(ballistic_entry_spec_default());
    let ballistic_entry_deceleration_b = ballistic_compute_allen_eggers(ballistic_entry_spec_default());
    if (ballistic_entry_deceleration_a).max_deceleration_g != (ballistic_entry_deceleration_b).max_deceleration_g {
        println("FAIL ballistic_compute_allen_eggers");
        process_exit(1);
    }
    println("prod_ballistic_entry_deceleration: PASSED");
}
