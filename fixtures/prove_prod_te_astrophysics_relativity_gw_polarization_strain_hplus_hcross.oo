// # Product prove std/astrophysics_relativity/gw_polarization_strain_hplus_hcross.oo
//
// Logline: Fail-closed emit+gcc+run asserts gw_polarization_strains real value.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gw_polarization_strain_hplus_hcross.oo.
//
// Beats:
//   1. Call gw_polarization_strains with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_gw_polarization_strain_hplus_hcross: PASSED only if the assert holds.

import "std/astrophysics_relativity/gw_polarization_strain_hplus_hcross.oo";

pub fn main() {
    let gw_polarization_strain_hplus_hcross_mark: Int = 0;
    if gw_polarization_strain_hplus_hcross_mark != 0 {
        process_exit(1);
    }
    let gw_polarization_strain_hplus_hcross_a: GWStrainPolarization = gw_polarization_strains(2.0, 2.0, 2.0, AntennaPatternFunctions { f_plus: 0.0, f_cross: 0.0, antenna_power: 0.0 });
    let gw_polarization_strain_hplus_hcross_inclination_rad: Float = (gw_polarization_strain_hplus_hcross_a).inclination_rad;
    if !(gw_polarization_strain_hplus_hcross_inclination_rad == 2.0) {
        println("FAIL gw_polarization_strains");
        process_exit(1);
    }
    println("prod_gw_polarization_strain_hplus_hcross: PASSED");
}
