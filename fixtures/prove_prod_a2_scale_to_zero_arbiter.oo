// # Product prove std/cloud_faas/scale_to_zero_arbiter.oo
//
// Logline: Fail-closed emit+gcc+run asserts scale_to_zero_arbiter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_faas/scale_to_zero_arbiter.oo.
//
// Beats:
//   1. Call scale_to_zero_arbiter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_scale_to_zero_arbiter: PASSED only if they match.

import "std/cloud_faas/scale_to_zero_arbiter.oo";

pub fn main() {
    let a: ScaleToZeroArbiter = scale_to_zero_arbiter_new(0);
    let b: ScaleToZeroArbiter = scale_to_zero_arbiter_new(0);
    if (a).idle_timeout_ms != (b).idle_timeout_ms {
        println("FAIL scale_to_zero_arbiter_new");
        process_exit(1);
    }
    println("prod_scale_to_zero_arbiter: PASSED");
}
