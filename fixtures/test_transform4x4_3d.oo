// # 4x4 transform adversarial suite
//
// Logline: Exercises translation, axis-angle rotation, non-uniform scale, perspective, inverse, and singular fail-closed.
//
// Setup: Pure. Imports transform4x4_3d modules. Run from ooda/.
//
// Beats:
//   1. Build the four named constructors.
//   2. Invert a translation-scale product and check M * inv near identity.
//   3. Invert a zero-scale matrix and require singular matrix: det is 0.

import "std/geometry/transform4x4_3d_inv.oo";

fn near_i(m: List[Float]) -> Bool {
    let mut i: Int = 0;
    while i < 16 {
        let mut want: Float = 0.0;
        if i % 5 == 0 {
            want = 1.0;
        }
        let mut d: Float = list_get(m, i) - want;
        if d < 0.0 {
            d = 0.0 - d;
        }
        if d > 0.0001 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn main() {
    let t: List[Float] = transform4x4_translate(1.0, 2.0, 3.0);
    let r: List[Float] = transform4x4_rotate_axis(0.0, 0.0, 1.0, 0.5);
    let s: List[Float] = transform4x4_scale(2.0, 3.0, 4.0);
    let p: List[Float] = transform4x4_perspective(1.0, 1.0, 0.1, 100.0);
    if list_len(t) != 16 {
        println("FAIL t");
        process_exit(1);
    }
    if list_len(r) != 16 {
        println("FAIL r");
        process_exit(1);
    }
    if list_len(s) != 16 {
        println("FAIL s");
        process_exit(1);
    }
    if list_len(p) != 16 {
        println("FAIL p");
        process_exit(1);
    }
    println("translation, axis-angle, non-uniform scale, perspective are exercised");

    let m: List[Float] = transform4x4_mul(t, s);
    let st: Result[Int, String] = transform4x4_invert(m);
    if st.is_err() {
        println("FAIL invert");
        process_exit(1);
    }
    let inv: List[Float] = transform4x4_inverse(m);
    if list_len(inv) != 16 {
        println("FAIL inv len");
        process_exit(1);
    }
    let id: List[Float] = transform4x4_mul(m, inv);
    if near_i(id) == false {
        println("FAIL M*inv");
        process_exit(1);
    }
    println("invertible pair satisfies M * M^-1 = I");

    let z: List[Float] = transform4x4_scale(1.0, 1.0, 0.0);
    let zs: Result[Int, String] = transform4x4_invert(z);
    if zs.is_ok() {
        println("FAIL singular ok");
        process_exit(1);
    }
    match zs {
        Ok(v) => {
            println("FAIL ok arm " + v.to_string());
            process_exit(1);
        },
        Err(e) => {
            if e == "singular matrix: det is 0" {
                println("singular matrix: det is 0");
            } else {
                println("FAIL err " + e);
                process_exit(1);
            }
        }
    }
    println("SUITE PASSED");
    println("test_transform4x4_3d: PASSED");
}
