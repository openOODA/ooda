// # Product prove std/web_ecosystem/terminal_table_formatter.oo
//
// Logline: Fail-closed emit+gcc+run asserts table_pad_n is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/terminal_table_formatter.oo.
//
// Beats:
//   1. Call table_pad_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_table_formatter: PASSED only if they match.

import "std/web_ecosystem/terminal_table_formatter.oo";

pub fn main() {
    let terminal_table_formatter_mark: Int = 0;
    if terminal_table_formatter_mark != 0 {
        process_exit(1);
    }
    let a: Int = table_pad_n(0, 0);
    let b: Int = table_pad_n(0, 0);
    if a != b {
        println("FAIL table_pad_n");
        process_exit(1);
    }
    println("prod_terminal_table_formatter: PASSED");
}
