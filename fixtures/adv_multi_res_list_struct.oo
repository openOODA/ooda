// # Test multiple Result[List[Struct]] functions
//
// Logline: Test Result[List[Item]] and Result[List[Header]].
//
// Setup: Backend-C.
//
// Beats:
//   1. Struct 1 in Result[List].
//   2. Struct 2 in Result[List].
//   3. Match each.

type Item = struct {
    id: Int,
    name: String,
    val: Int
};

type Header = struct {
    title: String,
    count: Int
};

fn make_items_ok() -> Result[List[Item], String] {
    let mut xs: List[Item] = list_new();
    let it1: Item = Item { id: 101, name: "alpha", val: 10 };
    xs = list_push(xs, it1);
    return Ok(xs);
}

fn make_headers_ok() -> Result[List[Header], String] {
    let mut hs: List[Header] = list_new();
    let h1: Header = Header { title: "Content-Type", count: 1 };
    hs = list_push(hs, h1);
    return Ok(hs);
}

pub fn main() {
    let r1: Result[List[Item], String] = make_items_ok();
    match r1 {
        Ok(items) => {
            if list_len(items) != 1 {
                println("FAIL r1 len");
                process_exit(1);
            }
            let it: Item = list_get(items, 0);
            if it.id != 101 || it.name != "alpha" || it.val != 10 {
                println("FAIL r1 item");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL r1 err");
            process_exit(1);
        }
    }

    let r2: Result[List[Header], String] = make_headers_ok();
    match r2 {
        Ok(hs) => {
            if list_len(hs) != 1 {
                println("FAIL r2 len");
                process_exit(1);
            }
            let h: Header = list_get(hs, 0);
            if h.title != "Content-Type" || h.count != 1 {
                println("FAIL r2 header");
                process_exit(1);
            }
        }
        Err(e) => {
            println("FAIL r2 err");
            process_exit(1);
        }
    }

    println("multi_res_list_struct: PASSED");
}
