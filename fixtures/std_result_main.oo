// # Drive result helpers
//
// Logline: Construct Ok and Err results, map them, and print unwrap_or plus ok_eq checks.
//
// Setup: Test fixture. Imports result.oo. Check the library as a single file.
//
// Beats:
//   1. Print unwrap_or on Ok and Err.
//   2. Map the Err message and print the fallback.
//   3. Prefix an Ok payload and compare it with res_ok_eq.
//
// check residual: oodac check is single-file (import not resolved);
//   check the library: oodac check std/result.oo
import "result.oo";

pub fn main() {
    let r: Result[String, String] = res_ok("hi");
    if res_is_ok(r) {
        let s: String = res_unwrap_or(r, "no");
        println(s);
    }
    let bad: Result[String, String] = res_err("boom");
    if res_is_err(bad) {
        let s2: String = res_unwrap_or(bad, "fallback");
        println(s2);
    }
    let m: Result[String, String] = res_map_err(bad, "mapped");
    let s3: String = res_unwrap_or(m, "x");
    println(s3);
    // M159 growth: map_ok_prefix + ok_eq
    let p: Result[String, String] = res_map_ok_prefix(res_ok("hi"), "pre-");
    if res_ok_eq(p, "pre-hi") {
        println("map-ok");
    }
    if res_ok_eq(bad, "nope") {
        println("should-not");
    } else {
        println("ok-eq-err");
    }
}
