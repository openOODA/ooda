// # OPEN-70 import_c and lto_xlang_link are product
//
// Logline: import_c and lto_xlang_link check as product names; emit+gcc+run prints OK.
//
// Setup: After compiler rebuild. import_c("stdio.h") is a free call.
//
// Beats:
//   1. Call import_c("stdio.h").
//   2. Call lto_xlang_link with two object names.
//   3. Print OK.

pub fn main() {
    import_c("stdio.h");
    lto_xlang_link("a.o", "b.o");
    println("OK");
}
