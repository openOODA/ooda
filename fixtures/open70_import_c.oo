// # OPEN-70 import_c reads a header; LTO runs gcc -flto
//
// Logline: import_c("stdio.h") returns a size; a missing header is 0; lto_xlang_link is 0.
//
// Setup: oo_import_c / oo_lto_xlang_link. A `(0 /* import_c */)` no-op fails.
//
// Beats:
//   1. stdio.h is at least 32 bytes.
//   2. A missing header returns 0.
//   3. lto_xlang_link compiles two units with -flto.

pub fn main() {
    let n = import_c("stdio.h");
    if n < 32 {
        println("FAIL import_c");
        process_exit(1);
    }
    let miss = import_c("ooda_no_such_header_zzz.h");
    if miss != 0 {
        println("FAIL missing");
        process_exit(1);
    }
    let lk = lto_xlang_link("a", "b");
    if lk != 0 {
        println("FAIL lto");
        process_exit(1);
    }
    println("OK");
}
