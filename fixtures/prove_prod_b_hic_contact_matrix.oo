// # Product prove std/genomics_advanced/hic_contact_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts hic_contact_matrix_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/hic_contact_matrix.oo.
//
// Beats:
//   1. Call hic_contact_matrix_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hic_contact_matrix: PASSED only if they match.

import "std/genomics_advanced/hic_contact_matrix.oo";

pub fn main() {
    let a = hic_contact_matrix_probe();
    let b = hic_contact_matrix_probe();
    if a != b {
        println("FAIL hic_contact_matrix_probe");
        process_exit(1);
    }
    println("prod_hic_contact_matrix: PASSED");
}
