// # Product prove std/space_propulsion/rocket_turbopump_cycle.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbopump_spec_default_ffsc is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_turbopump_cycle.oo.
//
// Beats:
//   1. Call turbopump_spec_default_ffsc twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_turbopump_cycle: PASSED only if they match.

import "std/space_propulsion/rocket_turbopump_cycle.oo";

pub fn main() {
    let rocket_turbopump_cycle_mark: Int = 0;
    if rocket_turbopump_cycle_mark != 0 {
        process_exit(1);
    }
    let a: TurbopumpSpec = turbopump_spec_default_ffsc();
    let b: TurbopumpSpec = turbopump_spec_default_ffsc();
    if (a).cycle_type != (b).cycle_type {
        println("FAIL turbopump_spec_default_ffsc");
        process_exit(1);
    }
    println("prod_rocket_turbopump_cycle: PASSED");
}
