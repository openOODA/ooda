// # Product prove std/telecom_5g/nr5g_scrambler.oo
//
// Logline: Fail-closed emit+gcc+run asserts nr5g_scrambler_cinit_pdsch is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/nr5g_scrambler.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call nr5g_scrambler_cinit_pdsch twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_nr5g_scrambler: PASSED only if they match.

import "std/telecom_5g/nr5g_scrambler.oo";

pub fn main() {
    let g0_a = nr5g_scrambler_cinit_pdsch(2, 2, 2);
    let g0_b = nr5g_scrambler_cinit_pdsch(2, 2, 2);
    if g0_a != g0_b {
        println("FAIL nr5g_scrambler_cinit_pdsch");
        process_exit(1);
    }
    println("prod_g0_nr5g_scrambler: PASSED");
}
