// # Product prove std/zk_rollup/plonk_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts plonk_verifying_key_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/plonk_verifier.oo.
//
// Beats:
//   1. Call plonk_verifying_key_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plonk_verifier: PASSED only if they match.

import "std/zk_rollup/plonk_verifier.oo";

pub fn main() {
    let plonk_verifier_mark: Int = 0;
    if plonk_verifier_mark != 0 {
        process_exit(1);
    }
    let a: PlonkVerifyingKey = plonk_verifying_key_new(0);
    let b: PlonkVerifyingKey = plonk_verifying_key_new(0);
    if (a).domain_size != (b).domain_size {
        println("FAIL plonk_verifying_key_new");
        process_exit(1);
    }
    println("prod_plonk_verifier: PASSED");
}
