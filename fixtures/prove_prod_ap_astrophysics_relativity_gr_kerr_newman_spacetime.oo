// # Product prove std/astrophysics_relativity/gr_kerr_newman_spacetime.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/gr_kerr_newman_spacetime.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_kerr_newman_spacetime.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gr_kerr_newman_spacetime: PASSED only if they match.

import "std/astrophysics_relativity/gr_kerr_newman_spacetime.oo";

pub fn main() {
    let gr_kerr_newman_spacetime_a = kerr_newman_evaluate(0, 0, 0, 0, 0);
    let gr_kerr_newman_spacetime_b = kerr_newman_evaluate(0, 0, 0, 0, 0);
    let gr_kerr_newman_spacetime_va = kn_r_plus(gr_kerr_newman_spacetime_a);
    let gr_kerr_newman_spacetime_vb = kn_r_plus(gr_kerr_newman_spacetime_b);
    if gr_kerr_newman_spacetime_va != gr_kerr_newman_spacetime_vb {
        println("FAIL gr_kerr_newman_spacetime");
        process_exit(1);
    }
    println("prod_ap_gr_kerr_newman_spacetime: PASSED");
}
