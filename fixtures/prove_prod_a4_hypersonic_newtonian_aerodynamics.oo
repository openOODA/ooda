// # Product prove std/physics_advanced/hypersonic_newtonian_aerodynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts modified_newtonian_cp_max is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/hypersonic_newtonian_aerodynamics.oo.
//
// Beats:
//   1. Call modified_newtonian_cp_max twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hypersonic_newtonian_aerodynamics: PASSED only if they match.

import "std/physics_advanced/hypersonic_newtonian_aerodynamics.oo";

pub fn main() {
    let hypersonic_newtonian_aerodynamics_mark: Int = 0;
    if hypersonic_newtonian_aerodynamics_mark != 0 {
        process_exit(1);
    }
    let a: Float = modified_newtonian_cp_max(0.0, 0.0);
    let b: Float = modified_newtonian_cp_max(0.0, 0.0);
    if a != b {
        println("FAIL modified_newtonian_cp_max");
        process_exit(1);
    }
    println("prod_hypersonic_newtonian_aerodynamics: PASSED");
}
