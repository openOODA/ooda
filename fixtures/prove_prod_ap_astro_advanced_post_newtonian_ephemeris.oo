// # Product prove std/astro_advanced/post_newtonian_ephemeris.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/post_newtonian_ephemeris.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/post_newtonian_ephemeris.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_post_newtonian_ephemeris: PASSED only if they match.

import "std/astro_advanced/post_newtonian_ephemeris.oo";

pub fn main() {
    let post_newtonian_ephemeris_a = pn_order();
    let post_newtonian_ephemeris_b = pn_order();
    if post_newtonian_ephemeris_a != post_newtonian_ephemeris_b {
        println("FAIL post_newtonian_ephemeris");
        process_exit(1);
    }
    println("prod_ap_post_newtonian_ephemeris: PASSED");
}
