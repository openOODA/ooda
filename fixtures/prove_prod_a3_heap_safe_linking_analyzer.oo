// # Product prove std/exploit_analysis/heap_safe_linking_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts safe_link_protect is deterministic.
//
// Setup: Isolated emit-c. Imports std/exploit_analysis/heap_safe_linking_analyzer.oo.
//
// Beats:
//   1. Call safe_link_protect twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_safe_linking_analyzer: PASSED only if they match.

import "std/exploit_analysis/heap_safe_linking_analyzer.oo";

pub fn main() {
    let heap_safe_linking_analyzer_mark: Int = 0;
    if heap_safe_linking_analyzer_mark != 0 {
        process_exit(1);
    }
    let a: Int = safe_link_protect(0, 0);
    let b: Int = safe_link_protect(0, 0);
    if a != b {
        println("FAIL safe_link_protect");
        process_exit(1);
    }
    println("prod_heap_safe_linking_analyzer: PASSED");
}
