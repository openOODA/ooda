// # Product prove std/zk_rollup/recursive_snark_accumulator.oo
//
// Logline: Fail-closed emit+gcc+run asserts relaxed_r1cs_instance_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/recursive_snark_accumulator.oo.
//
// Beats:
//   1. Call relaxed_r1cs_instance_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_recursive_snark_accumulator: PASSED only if they match.

import "std/zk_rollup/recursive_snark_accumulator.oo";

pub fn main() {
    let recursive_snark_accumulator_mark: Int = 0;
    if recursive_snark_accumulator_mark != 0 {
        process_exit(1);
    }
    let a: RelaxedR1csInstance = relaxed_r1cs_instance_new(0, 0, 0);
    let b: RelaxedR1csInstance = relaxed_r1cs_instance_new(0, 0, 0);
    if (a).commit_w != (b).commit_w {
        println("FAIL relaxed_r1cs_instance_new");
        process_exit(1);
    }
    println("prod_recursive_snark_accumulator: PASSED");
}
