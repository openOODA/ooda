// # Product prove std/deep_ai/clip_vision_projection.oo
//
// Logline: Fail-closed emit+gcc+run asserts clip_vision_projection_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/deep_ai/clip_vision_projection.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call clip_vision_projection_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_clip_vision_projection: PASSED only if they match.

import "std/deep_ai/clip_vision_projection.oo";

pub fn main() {
    let g2_a = clip_vision_projection_marker();
    let g2_b = clip_vision_projection_marker();
    if g2_a != g2_b {
        println("FAIL clip_vision_projection_marker");
        process_exit(1);
    }
    println("prod_g2_clip_vision_projection: PASSED");
}
