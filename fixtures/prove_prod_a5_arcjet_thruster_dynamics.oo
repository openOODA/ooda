// # Product prove std/space_propulsion/arcjet_thruster_dynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts arcjet_spec_default_hydrazine is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/arcjet_thruster_dynamics.oo.
//
// Beats:
//   1. Call arcjet_spec_default_hydrazine twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_arcjet_thruster_dynamics: PASSED only if they match.

import "std/space_propulsion/arcjet_thruster_dynamics.oo";

pub fn main() {
    let arcjet_thruster_dynamics_mark: Int = 0;
    if arcjet_thruster_dynamics_mark != 0 {
        process_exit(1);
    }
    let a: ArcjetSpec = arcjet_spec_default_hydrazine();
    let b: ArcjetSpec = arcjet_spec_default_hydrazine();
    if (a).propellant_type != (b).propellant_type {
        println("FAIL arcjet_spec_default_hydrazine");
        process_exit(1);
    }
    println("prod_arcjet_thruster_dynamics: PASSED");
}
