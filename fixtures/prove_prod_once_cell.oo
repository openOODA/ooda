// # Product prove std/sync/once_cell.oo
//
// Logline: Fail-closed emit+gcc+run asserts once_cell_is_set is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/once_cell.oo.
//
// Beats:
//   1. Call once_cell_is_set twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_once_cell: PASSED only if they match.

import "std/sync/once_cell.oo";

pub fn main() {
    let obj = once_cell_new();
    let a = once_cell_is_set(obj);
    let b = once_cell_is_set(obj);
    if a != b {
        println("FAIL once_cell_is_set");
        process_exit(1);
    }
    println("prod_once_cell: PASSED");
}
