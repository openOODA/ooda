// # Product prove std/astrodynamics/kepler_orbit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrodynamics/kepler_orbit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/kepler_orbit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kepler_orbit: PASSED only if they match.

import "std/astrodynamics/kepler_orbit.oo";

pub fn main() {
    let kepler_orbit_a = kepler_mu_earth();
    let kepler_orbit_b = kepler_mu_earth();
    if kepler_orbit_a != kepler_orbit_b {
        println("FAIL kepler_orbit");
        process_exit(1);
    }
    println("prod_ap_kepler_orbit: PASSED");
}
