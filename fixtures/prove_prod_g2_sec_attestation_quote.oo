// # Product prove std/sec/attestation_quote.oo
//
// Logline: Fail-closed emit+gcc+run asserts attestation_quote_score is a real value.
//
// Setup: Isolated emit-c. Imports std/sec/attestation_quote.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call attestation_quote_score twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_attestation_quote: PASSED only if they match.

import "std/sec/attestation_quote.oo";

pub fn main() {
    let g2_oa = attestation_quote_create("x", "x", "x", "x", 2);
    let g2_ob = attestation_quote_create("x", "x", "x", "x", 2);
    let g2_a = attestation_quote_score(g2_oa);
    let g2_b = attestation_quote_score(g2_ob);
    if g2_a != g2_b {
        println("FAIL attestation_quote_score");
        process_exit(1);
    }
    println("prod_g2_attestation_quote: PASSED");
}
