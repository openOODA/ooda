// # Product prove std/satellite_dvb/satellite_transponder_volterra.oo
//
// Logline: Fail-closed emit+gcc+run asserts volterra_acpr_improvement_db is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_transponder_volterra.oo.
//
// Beats:
//   1. Call volterra_acpr_improvement_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_satellite_transponder_volterra: PASSED only if they match.

import "std/satellite_dvb/satellite_transponder_volterra.oo";

pub fn main() {
    let satellite_transponder_volterra_mark: Int = 0;
    if satellite_transponder_volterra_mark != 0 {
        process_exit(1);
    }
    let a: Float = volterra_acpr_improvement_db(0.0, 0.0);
    let b: Float = volterra_acpr_improvement_db(0.0, 0.0);
    if a != b {
        println("FAIL volterra_acpr_improvement_db");
        process_exit(1);
    }
    println("prod_satellite_transponder_volterra: PASSED");
}
