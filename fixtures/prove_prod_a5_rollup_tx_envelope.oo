// # Product prove std/zk_rollup/rollup_tx_envelope.oo
//
// Logline: Fail-closed emit+gcc+run asserts rollup_tx_envelope_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/rollup_tx_envelope.oo.
//
// Beats:
//   1. Call rollup_tx_envelope_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rollup_tx_envelope: PASSED only if they match.

import "std/zk_rollup/rollup_tx_envelope.oo";

pub fn main() {
    let a: RollupTxEnvelope = rollup_tx_envelope_new(0, 0, 0, 0, 0, 0);
    let b: RollupTxEnvelope = rollup_tx_envelope_new(0, 0, 0, 0, 0, 0);
    if (a).tx_type != (b).tx_type {
        println("FAIL rollup_tx_envelope_new");
        process_exit(1);
    }
    println("prod_rollup_tx_envelope: PASSED");
}
