// # Product trie_radix prove
import "std/collections/trie_radix.oo";
pub fn main() {
    let mut t: RadixTrie = radix_trie_new();
    t = radix_trie_insert(t, 7);
    let ok: Bool = radix_trie_contains(t, 7);
    if ok == false {
        println("FAIL rtrie 7");
        process_exit(1);
    }
    let n: Int = radix_trie_len(t);
    if n != 1 {
        println("FAIL rtrie len");
        process_exit(1);
    }
    println("prod_rtrie: PASSED");
}
