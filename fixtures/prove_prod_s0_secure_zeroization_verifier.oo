// # Product prove std/security_defense/secure_zeroization_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_memory_zeroization value or determinism.
//
// Setup: Isolated emit-c. Imports std/security_defense/secure_zeroization_verifier.oo.
//
// Beats:
//   1. Call audit_memory_zeroization twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_secure_zeroization_verifier: PASSED only if asserts hold.

import "std/security_defense/secure_zeroization_verifier.oo";

pub fn main() {
    let secure_zeroization_verifier_a: ZeroizationAuditReport = audit_memory_zeroization(list_new(), 0);
    let secure_zeroization_verifier_b: ZeroizationAuditReport = audit_memory_zeroization(list_new(), 0);
    if secure_zeroization_verifier_a.is_fully_zeroed != true {
        println("FAIL audit_memory_zeroization");
        process_exit(1);
    }
    if secure_zeroization_verifier_a.is_fully_zeroed != secure_zeroization_verifier_b.is_fully_zeroed {
        println("FAIL audit_memory_zeroization det");
        process_exit(1);
    }
    println("prod_secure_zeroization_verifier: PASSED");
}
