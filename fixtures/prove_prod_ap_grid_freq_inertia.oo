// # Product prove std/grid/freq_inertia.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/grid/freq_inertia.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/freq_inertia.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_freq_inertia: PASSED only if they match.

import "std/grid/freq_inertia.oo";

pub fn main() {
    let freq_inertia_a = freq_math_abs(0.0);
    let freq_inertia_b = freq_math_abs(0.0);
    if freq_inertia_a != freq_inertia_b {
        println("FAIL freq_inertia");
        process_exit(1);
    }
    println("prod_ap_freq_inertia: PASSED");
}
