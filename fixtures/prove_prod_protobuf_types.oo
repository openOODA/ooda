// # Product prove std/markup/protobuf_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts pb_wire_type_for_proto_type is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/protobuf_types.oo.
//
// Beats:
//   1. Call pb_wire_type_for_proto_type twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protobuf_types: PASSED only if they match.

import "std/markup/protobuf_types.oo";

pub fn main() {
    let a = pb_wire_type_for_proto_type("x");
    let b = pb_wire_type_for_proto_type("x");
    if a != b {
        println("FAIL pb_wire_type_for_proto_type");
        process_exit(1);
    }
    println("prod_protobuf_types: PASSED");
}
