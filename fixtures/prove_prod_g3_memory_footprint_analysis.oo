// # Product prove std/compilers_polyhedral/memory_footprint_analysis.oo
//
// Logline: Fail-closed emit+gcc+run asserts array_footprint_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/memory_footprint_analysis.oo.
//
// Beats:
//   1. Call array_footprint_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_memory_footprint_analysis: PASSED only if they match.

import "std/compilers_polyhedral/memory_footprint_analysis.oo";

pub fn main() {
    let memory_footprint_analysis_mark: Int = 0;
    if memory_footprint_analysis_mark != 0 {
        process_exit(1);
    }
    let a: ArrayFootprint = array_footprint_new("x", 0);
    let b: ArrayFootprint = array_footprint_new("x", 0);
    if (a).element_size_bytes != (b).element_size_bytes {
        println("FAIL array_footprint_new");
        process_exit(1);
    }
    println("prod_memory_footprint_analysis: PASSED");
}
