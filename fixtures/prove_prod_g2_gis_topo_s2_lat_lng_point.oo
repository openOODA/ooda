// # Product prove std/gis_topo/s2_lat_lng_point.oo
//
// Logline: Fail-closed emit+gcc+run asserts s2_deg_to_rad is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/s2_lat_lng_point.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call s2_deg_to_rad twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_s2_lat_lng_point: PASSED only if they match.

import "std/gis_topo/s2_lat_lng_point.oo";

pub fn main() {
    let g2_a = s2_deg_to_rad(1.0);
    let g2_b = s2_deg_to_rad(1.0);
    if g2_a != g2_b {
        println("FAIL s2_deg_to_rad");
        process_exit(1);
    }
    println("prod_g2_s2_lat_lng_point: PASSED");
}
