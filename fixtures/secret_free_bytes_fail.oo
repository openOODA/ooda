// # Refuse a secret free_bytes size
//
// Logline: A secret size argument must not reach free_bytes.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the size.
//   3. Expect the sink to refuse.

// Secret refuse: free_bytes
// SECRET: token
pub fn main(al: &AllocCap) {
    let token = 64;
    let r = free_bytes(al, token);
    println(1);
}
