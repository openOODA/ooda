// # Product prove std/compilers_polyhedral/simd_instruction_cost_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts target_simd_max_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/simd_instruction_cost_model.oo.
//
// Beats:
//   1. Call target_simd_max_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_instruction_cost_model: PASSED only if they match.

import "std/compilers_polyhedral/simd_instruction_cost_model.oo";

pub fn main() {
    let obj_a: TargetSimdIsa = target_simd_isa_avx2();
    let obj_b: TargetSimdIsa = target_simd_isa_avx2();
    let a: Int = target_simd_max_bytes(obj_a);
    let b: Int = target_simd_max_bytes(obj_b);
    if a != b {
        println("FAIL target_simd_max_bytes");
        process_exit(1);
    }
    println("prod_simd_instruction_cost_model: PASSED");
}
