// # Product prove std/auto/occupancy_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts abs_val is a real value.
//
// Setup: Isolated emit-c. Imports std/auto/occupancy_types.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call abs_val twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_occupancy_types: PASSED only if they match.

import "std/auto/occupancy_types.oo";

pub fn main() {
    let g2_a = abs_val(2);
    let g2_b = abs_val(2);
    if g2_a != g2_b {
        println("FAIL abs_val");
        process_exit(1);
    }
    println("prod_g2_occupancy_types: PASSED");
}
