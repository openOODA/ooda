// # Complex ensures fail
//
// Logline: Violate a complex ensures by returning x + y + 1.
//
// Beats:
//   1. Require x > 0 and y > 0.
//   2. Ensure result == x + y (and > 0).
//   3. Call with 3, 4 so the extra +1 trips ensures.

// Fail: complex ensures violated
pub fn complex_fn(x: Int, y: Int) -> Int
    requires (x > 0 && y > 0)
    ensures result > 0 && (result == x + y)
{
    return x + y + 1;
}

pub fn main() {
    println(complex_fn(3, 4));
}
