// # Product prove std/auto_mpc_control/mpc_adaptive_weight_tuning.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_adaptive_weights is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/mpc_adaptive_weight_tuning.oo.
//
// Beats:
//   1. Call compute_adaptive_weights twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_mpc_adaptive_weight_tuning: PASSED only if they match.

import "std/auto_mpc_control/mpc_adaptive_weight_tuning.oo";

pub fn main() {
    let mpc_adaptive_weight_tuning_mark: Int = 0;
    if mpc_adaptive_weight_tuning_mark != 0 {
        process_exit(1);
    }
    let a: AdaptiveWeights = compute_adaptive_weights(0.0, 0.0, 0.0, true);
    let b: AdaptiveWeights = compute_adaptive_weights(0.0, 0.0, 0.0, true);
    if (a).weight_cte != (b).weight_cte {
        println("FAIL compute_adaptive_weights");
        process_exit(1);
    }
    println("prod_mpc_adaptive_weight_tuning: PASSED");
}
