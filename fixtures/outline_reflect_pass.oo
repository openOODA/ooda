// # Outline public and private surfaces
//
// Logline: A parse-only outline and reflect fixture mixes public, private, caps, contracts, and verify.
//
// Beats:
//   1. Hide a private helper next to a contracted public scale.
//   2. Carry a verify block and an FsCap helper.
//   3. Enter main under SysCap and print scale(1).

// Pass fixture for ooda outline / ooda reflect (parse-only; no exec).
// Public + private + caps + contracts + verify.

fn hidden(x: Int) -> Int {
    return x;
}

pub fn scale(x: Int) -> Int
    requires x >= 0
    ensures result >= x
{
    return x + 1;
}

verify scale {
    assert_eq!(scale(1), 2);
}

pub fn touch(fs: &FsCap, path: String) -> String {
    return path;
}

pub fn main(sys: &SysCap) {
    let y = scale(1);
    println(y);
}
