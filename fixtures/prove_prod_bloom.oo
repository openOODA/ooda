// # Product bloom_filter prove
//
// Logline: Fail-closed emit+gcc+run of shipped bloom_new/is_empty/num_bits.
//
// Setup: Product std/collections/bloom_filter.oo. Min 64 bits.
//
// Beats:
//   1. New filter is empty; num_bits of 64 is 64.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/bloom_filter.oo";

pub fn main() {
    let bf: BloomFilter = bloom_new(64, 2);
    let e: Bool = bloom_is_empty(bf);
    if e == false {
        println("FAIL bloom empty");
        process_exit(1);
    }
    let n: Int = bloom_num_bits(bf);
    if n != 64 {
        println("FAIL bloom bits");
        process_exit(1);
    }
    println("prod_bloom: PASSED");
}
