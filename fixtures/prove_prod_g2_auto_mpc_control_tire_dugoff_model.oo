// # Product prove std/auto_mpc_control/tire_dugoff_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts dugoff_params_default is a real value.
//
// Setup: Isolated emit-c. Imports std/auto_mpc_control/tire_dugoff_model.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call dugoff_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tire_dugoff_model: PASSED only if they match.

import "std/auto_mpc_control/tire_dugoff_model.oo";

pub fn main() {
    let g2_oa: DugoffParams = dugoff_params_default();
    let g2_ob: DugoffParams = dugoff_params_default();
    let g2_a = (g2_oa).stiff_longitudinal;
    let g2_b = (g2_ob).stiff_longitudinal;
    if g2_a != g2_b {
        println("FAIL dugoff_params_default.stiff_longitudinal");
        process_exit(1);
    }
    println("prod_g2_tire_dugoff_model: PASSED");
}
