// # Product prove std/db_graph/opencypher_group_aggregate.oo
//
// Logline: Fail-closed emit+gcc+run asserts group_accumulator_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_group_aggregate.oo.
//
// Beats:
//   1. Call group_accumulator_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opencypher_group_aggregate: PASSED only if they match.

import "std/db_graph/opencypher_group_aggregate.oo";

pub fn main() {
    let opencypher_group_aggregate_mark: Int = 0;
    if opencypher_group_aggregate_mark != 0 {
        process_exit(1);
    }
    let a: GroupAccumulator = group_accumulator_new("x");
    let b: GroupAccumulator = group_accumulator_new("x");
    if (a).count_val != (b).count_val {
        println("FAIL group_accumulator_new");
        process_exit(1);
    }
    println("prod_opencypher_group_aggregate: PASSED");
}
