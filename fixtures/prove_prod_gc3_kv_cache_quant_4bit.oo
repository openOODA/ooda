// # Product prove std/deep_ai/kv_cache_quant_4bit.oo
//
// Logline: Fail-closed emit+gcc+run asserts kv_cache_quant_4bit_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/deep_ai/kv_cache_quant_4bit.oo.
//
// Beats:
//   1. Call kv_cache_quant_4bit_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_kv_cache_quant_4bit: PASSED only if they match.

import "std/deep_ai/kv_cache_quant_4bit.oo";

pub fn main() {
    let kv_cache_quant_4bit_mark: Int = 0;
    if kv_cache_quant_4bit_mark != 0 {
        process_exit(1);
    }
    let kv_cache_quant_4bit_a: Int = kv_cache_quant_4bit_marker();
    let kv_cache_quant_4bit_b: Int = kv_cache_quant_4bit_marker();
    if kv_cache_quant_4bit_a != kv_cache_quant_4bit_b {
        println("FAIL kv_cache_quant_4bit_marker");
        process_exit(1);
    }
    println("prod_kv_cache_quant_4bit: PASSED");
}
