// # Product prove std/math/blas_level2.oo
//
// Logline: Fail-closed emit+gcc+run asserts blas_level2_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/math/blas_level2.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call blas_level2_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_blas_level2: PASSED only if they match.

import "std/math/blas_level2.oo";

pub fn main() {
    let g2_a = blas_level2_probe();
    let g2_b = blas_level2_probe();
    if g2_a != g2_b {
        println("FAIL blas_level2_probe");
        process_exit(1);
    }
    println("prod_g2_blas_level2: PASSED");
}
