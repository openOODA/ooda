// # Product prove std/net/tls_session.oo
//
// Logline: Fail-closed emit+gcc+run asserts tls_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/tls_session.oo.
//
// Beats:
//   1. Call tls_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tls_session: PASSED only if they match.

import "std/net/tls_session.oo";

pub fn main() {
    let obj = tls_config_new("x", 0);
    let a = obj.port;
    let b = obj.port;
    if a != b {
        println("FAIL tls_config_new");
        process_exit(1);
    }
    println("prod_tls_session: PASSED");
}
