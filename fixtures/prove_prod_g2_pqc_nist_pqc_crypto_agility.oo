// # Product prove std/pqc_nist/pqc_crypto_agility.oo
//
// Logline: Fail-closed emit+gcc+run asserts agility_policy_cnsa_20 is a real value.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_crypto_agility.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call agility_policy_cnsa_20 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_pqc_crypto_agility: PASSED only if they match.

import "std/pqc_nist/pqc_crypto_agility.oo";

pub fn main() {
    let g2_oa: AgilityPolicy = agility_policy_cnsa_20();
    let g2_ob: AgilityPolicy = agility_policy_cnsa_20();
    let g2_a = (g2_oa).minimum_security_level;
    let g2_b = (g2_ob).minimum_security_level;
    if g2_a != g2_b {
        println("FAIL agility_policy_cnsa_20.minimum_security_level");
        process_exit(1);
    }
    println("prod_g2_pqc_crypto_agility: PASSED");
}
