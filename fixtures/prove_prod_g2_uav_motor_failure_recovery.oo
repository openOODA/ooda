// # Product prove std/uav_flight/uav_motor_failure_recovery.oo
//
// Logline: Fail-closed emit+gcc+run asserts motor_fault_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_motor_failure_recovery.oo.
//
// Beats:
//   1. Call motor_fault_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_uav_motor_failure_recovery: PASSED only if they match.

import "std/uav_flight/uav_motor_failure_recovery.oo";

pub fn main() {
    let uav_motor_failure_recovery_mark: Int = 0;
    if uav_motor_failure_recovery_mark != 0 {
        process_exit(1);
    }
    let a: MotorFaultConfig = motor_fault_config_default();
    let b: MotorFaultConfig = motor_fault_config_default();
    if (a).tilt_error_threshold_rad != (b).tilt_error_threshold_rad {
        println("FAIL motor_fault_config_default");
        process_exit(1);
    }
    println("prod_g2_uav_motor_failure_recovery: PASSED");
}
