// # Product prove std/telecom/dsp_filter_iir.oo
//
// Logline: Fail-closed emit+gcc+run asserts iir_pi is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/dsp_filter_iir.oo.
//
// Beats:
//   1. Call iir_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dsp_filter_iir: PASSED only if they match.

import "std/telecom/dsp_filter_iir.oo";

pub fn main() {
    let dsp_filter_iir_mark: Int = 0;
    if dsp_filter_iir_mark != 0 {
        process_exit(1);
    }
    let dsp_filter_iir_a: Float = iir_pi();
    let dsp_filter_iir_b: Float = iir_pi();
    if dsp_filter_iir_a != dsp_filter_iir_b {
        println("FAIL iir_pi");
        process_exit(1);
    }
    println("prod_dsp_filter_iir: PASSED");
}
