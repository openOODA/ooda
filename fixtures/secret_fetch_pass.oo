// # Allow a public fetch URL
//
// Logline: A non-secret URL may reach fetch while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public URL instead.
//   3. Expect emit to allow the call.

// M131: non-secret URL may fetch (emit path; runtime still needs NetCap)
// SECRET: token
pub fn main(net: &NetCap) {
    let token = "s3cret";
    let public = "http://example.invalid/ok";
    let r = fetch(net, public);
    println(1);
}
