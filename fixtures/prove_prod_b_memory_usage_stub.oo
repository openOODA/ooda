// # Product prove std/os/memory_usage_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts memory_usage_stub_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/memory_usage_stub.oo.
//
// Beats:
//   1. Call memory_usage_stub_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_memory_usage_stub: PASSED only if they match.

import "std/os/memory_usage_stub.oo";

pub fn main() {
    let a = memory_usage_stub_probe();
    let b = memory_usage_stub_probe();
    if a != b {
        println("FAIL memory_usage_stub_probe");
        process_exit(1);
    }
    println("prod_memory_usage_stub: PASSED");
}
