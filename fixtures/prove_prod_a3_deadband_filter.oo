// # Product prove std/industrial_iot/deadband_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts deadband_filter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_iot/deadband_filter.oo.
//
// Beats:
//   1. Call deadband_filter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_deadband_filter: PASSED only if they match.

import "std/industrial_iot/deadband_filter.oo";

pub fn main() {
    let a: DeadbandFilter = deadband_filter_new(0.0);
    let b: DeadbandFilter = deadband_filter_new(0.0);
    if (a).deadband_value != (b).deadband_value {
        println("FAIL deadband_filter_new");
        process_exit(1);
    }
    println("prod_deadband_filter: PASSED");
}
