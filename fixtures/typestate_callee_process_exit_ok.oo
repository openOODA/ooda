// # Callee exits before send
//
// Logline: wrap opens another sock then process_exit, so the later send is unreachable.
//
// Beats:
//   1. Open a Closed sock and pass it to wrap.
//   2. wrap constructs a local sock and exits the process.
//   3. main's send never runs.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn wrap: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn send(s: Int) { let x = s; }

fn wrap(s: Int) {
    let t = open_sock();
    process_exit(1);
}

pub fn main() {
    let s = open_sock();
    wrap(s);
    send(s);
}
