// # Product prove std/quantum_tensor_nets/gilt_graph_independent_trg.oo
//
// Logline: Fail-closed emit+gcc+run asserts gilt_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/gilt_graph_independent_trg.oo.
//
// Beats:
//   1. Call gilt_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gilt_graph_independent_trg: PASSED only if they match.

import "std/quantum_tensor_nets/gilt_graph_independent_trg.oo";

pub fn main() {
    let gilt_graph_independent_trg_mark: Int = 0;
    if gilt_graph_independent_trg_mark != 0 {
        process_exit(1);
    }
    let a: GiltConfig = gilt_config_default();
    let b: GiltConfig = gilt_config_default();
    if (a).filter_epsilon != (b).filter_epsilon {
        println("FAIL gilt_config_default");
        process_exit(1);
    }
    println("prod_gilt_graph_independent_trg: PASSED");
}
