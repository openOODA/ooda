// # Product prove std/telecom_5g/sdr_agc_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_agc_sample_power_db is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sdr_agc_controller.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call sdr_agc_sample_power_db twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_sdr_agc_controller: PASSED only if they match.

import "std/telecom_5g/sdr_agc_controller.oo";

pub fn main() {
    let g0_a = sdr_agc_sample_power_db(1.0, 1.0);
    let g0_b = sdr_agc_sample_power_db(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL sdr_agc_sample_power_db");
        process_exit(1);
    }
    println("prod_g0_sdr_agc_controller: PASSED");
}
