// # Product prove std/telecom/dsp_filter_iir.oo
//
// Logline: Fail-closed emit+gcc+run asserts iir_pi is a real value.
//
// Setup: Isolated emit-c. Imports std/telecom/dsp_filter_iir.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call iir_pi twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dsp_filter_iir: PASSED only if they match.

import "std/telecom/dsp_filter_iir.oo";

pub fn main() {
    let g0_a = iir_pi();
    let g0_b = iir_pi();
    if g0_a != g0_b {
        println("FAIL iir_pi");
        process_exit(1);
    }
    println("prod_gr_dsp_filter_iir: PASSED");
}
