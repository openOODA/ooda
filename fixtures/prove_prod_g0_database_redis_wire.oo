// # Product prove std/database/redis_wire.oo
//
// Logline: Fail-closed emit+gcc+run asserts redis_encode_simple_string is a real value.
//
// Setup: Isolated emit-c. Imports std/database/redis_wire.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call redis_encode_simple_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_redis_wire: PASSED only if they match.

import "std/database/redis_wire.oo";

pub fn main() {
    let g0_a = redis_encode_simple_string("x");
    let g0_b = redis_encode_simple_string("x");
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL redis_encode_simple_string");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL redis_encode_simple_string");
        process_exit(1);
    }
    println("prod_g0_redis_wire: PASSED");
}
