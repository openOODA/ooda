// # Product prove std/quantum_open_systems/lindbladian_spectral_gap.oo
//
// Logline: Fail-closed emit+gcc+run asserts liouvillian_gap_estimate_qubit is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/lindbladian_spectral_gap.oo.
//
// Beats:
//   1. Call liouvillian_gap_estimate_qubit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lindbladian_spectral_gap: PASSED only if they match.

import "std/quantum_open_systems/lindbladian_spectral_gap.oo";

pub fn main() {
    let lindbladian_spectral_gap_mark: Int = 0;
    if lindbladian_spectral_gap_mark != 0 {
        process_exit(1);
    }
    let a: LiouvillianGapResult = liouvillian_gap_estimate_qubit(0.0, 0.0, 0.0);
    let b: LiouvillianGapResult = liouvillian_gap_estimate_qubit(0.0, 0.0, 0.0);
    if (a).spectral_gap_delta != (b).spectral_gap_delta {
        println("FAIL liouvillian_gap_estimate_qubit");
        process_exit(1);
    }
    println("prod_lindbladian_spectral_gap: PASSED");
}
