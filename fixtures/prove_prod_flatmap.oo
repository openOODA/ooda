// # Product flat_map prove
import "std/collections/flat_map.oo";
pub fn main() {
    let mut m: FlatMap = flat_map_new();
    m = flat_map_insert(m, 7, 1);
    let n: Int = flat_map_len(m);
    if n != 1 {
        println("FAIL flatmap len");
        process_exit(1);
    }
    let c7: Bool = flat_map_contains(m, 7);
    if c7 == false {
        println("FAIL flatmap 7");
        process_exit(1);
    }
    let c3: Bool = flat_map_contains(m, 3);
    if c3 == true {
        println("FAIL flatmap 3");
        process_exit(1);
    }
    println("prod_flatmap: PASSED");
}
