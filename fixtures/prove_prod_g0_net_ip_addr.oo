// # Product prove std/net/ip_addr.oo
//
// Logline: Fail-closed emit+gcc+run asserts ipv4_to_int is a real value.
//
// Setup: Isolated emit-c. Imports std/net/ip_addr.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ipv4_to_int twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_ip_addr: PASSED only if they match.

import "std/net/ip_addr.oo";

pub fn main() {
    let g0_oa = ipv4_new(2, 2, 2, 2);
    let g0_ob = ipv4_new(2, 2, 2, 2);
    let g0_a = ipv4_to_int(g0_oa);
    let g0_b = ipv4_to_int(g0_ob);
    if g0_a != g0_b {
        println("FAIL ipv4_to_int");
        process_exit(1);
    }
    println("prod_g0_ip_addr: PASSED");
}
