// # Cycles mention only
//
// Logline: Loop a hundred times with no line-start cycles marker.
//
// Beats:
//   1. Mention the directive only inside a docs sentence.
//   2. While-increment i to 100.
//   3. Print 100; no fuel is injected.

// Note: path A uses MAX_CYCLES with N in docs only
pub fn main() {
    let mut i = 0;
    while i < 100 {
        i = i + 1;
    }
    println(i);
}
