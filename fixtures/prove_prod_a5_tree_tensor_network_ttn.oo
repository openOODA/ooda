// # Product prove std/quantum_tensor_nets/tree_tensor_network_ttn.oo
//
// Logline: Fail-closed emit+gcc+run asserts ttn_node_leaf_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tree_tensor_network_ttn.oo.
//
// Beats:
//   1. Call ttn_node_leaf_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tree_tensor_network_ttn: PASSED only if they match.

import "std/quantum_tensor_nets/tree_tensor_network_ttn.oo";

pub fn main() {
    let tree_tensor_network_ttn_mark: Int = 0;
    if tree_tensor_network_ttn_mark != 0 {
        process_exit(1);
    }
    let a: TtnNode = ttn_node_leaf_new(0, 0, 0, 0);
    let b: TtnNode = ttn_node_leaf_new(0, 0, 0, 0);
    if (a).node_id != (b).node_id {
        println("FAIL ttn_node_leaf_new");
        process_exit(1);
    }
    println("prod_tree_tensor_network_ttn: PASSED");
}
