//   3. Print prod_ap_airfoil_lift_drag_polar: PASSED only if they match.

import "std/physics_advanced/airfoil_lift_drag_polar.oo";

pub fn main() {
    let airfoil_lift_drag_polar_a = lift_to_drag_ratio(0.0, 0.0);
    let airfoil_lift_drag_polar_b = lift_to_drag_ratio(0.0, 0.0);
    if airfoil_lift_drag_polar_a != airfoil_lift_drag_polar_b {
        println("FAIL airfoil_lift_drag_polar");
        process_exit(1);
    }
    println("prod_ap_airfoil_lift_drag_polar: PASSED");
