// # Product prove std/sec/crypto/sha3_ops.oo
//
// Logline: Fail-closed emit+check asserts sha3_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/sha3_ops.oo.
//
// Beats:
//   1. Call sha3_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sha3_ops: PASSED only if they match.

import "std/sec/crypto/sha3_ops.oo";

pub fn main() {
    let sha3_ops_mark: Int = 0;
    if sha3_ops_mark != 0 { process_exit(1); }
    let a: Int = sha3_checksum("x");
    let b: Int = sha3_checksum("x");
    if a != b { process_exit(1); }
    println("prod_sha3_ops: PASSED");
}
