// # Product prove std/web_ecosystem/lodash_throttle.oo
//
// Logline: Fail-closed emit+gcc+run asserts throttle_can_execute is a real value.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/lodash_throttle.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call throttle_can_execute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_lodash_throttle: PASSED only if they match.

import "std/web_ecosystem/lodash_throttle.oo";

pub fn main() {
    let g2_oa = throttle_new(2);
    let g2_ob = throttle_new(2);
    let g2_a = throttle_can_execute(g2_oa, 2);
    let g2_b = throttle_can_execute(g2_ob, 2);
    if g2_a != g2_b {
        println("FAIL throttle_can_execute");
        process_exit(1);
    }
    println("prod_g2_lodash_throttle: PASSED");
}
