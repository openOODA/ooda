// # Refuse a secret dlopen flag
//
// Logline: A secret in the dlopen flag argument must not pass the sink.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass that name as the third dlopen argument.
//   3. Expect the sink to refuse.

// M-? dlopen non-path arg taint: secret in 2nd arg (flag) not refused
// SECRET: token
pub fn main(ffi: &UnsafeFFICap) {
    let token = "s3cret-flag";
    let r = dlopen(ffi, "libx.so", token);
    println(1);
}
