// # Product prove std/security_defense/side_channel_jitter_injector.oo
//
// Logline: Fail-closed emit+gcc+run asserts jitter_inject_delay is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/side_channel_jitter_injector.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call jitter_inject_delay twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_side_channel_jitter_injector: PASSED only if they match.

import "std/security_defense/side_channel_jitter_injector.oo";

pub fn main() {
    let mut g0_oa: JitterProfile = JitterProfile { min_iterations: 0, max_iterations: 0, seed: 0, jitters_executed: 0 };
    let mut g0_ob: JitterProfile = JitterProfile { min_iterations: 0, max_iterations: 0, seed: 0, jitters_executed: 0 };
    let g0_a = jitter_inject_delay(&g0_oa);
    let g0_b = jitter_inject_delay(&g0_ob);
    if g0_a != g0_b {
        println("FAIL jitter_inject_delay");
        process_exit(1);
    }
    println("prod_gr_side_channel_jitter_injector: PASSED");
}
