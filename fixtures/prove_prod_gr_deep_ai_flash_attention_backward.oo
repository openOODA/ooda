// # Product prove std/deep_ai/flash_attention_backward.oo
//
// Logline: Fail-closed emit+gcc+run asserts flash_attention_backward_marker is a real value.
//
// Setup: Isolated emit-c. Imports std/deep_ai/flash_attention_backward.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call flash_attention_backward_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_flash_attention_backward: PASSED only if they match.

import "std/deep_ai/flash_attention_backward.oo";

pub fn main() {
    let g0_a = flash_attention_backward_marker();
    let g0_b = flash_attention_backward_marker();
    if g0_a != g0_b {
        println("FAIL flash_attention_backward_marker");
        process_exit(1);
    }
    println("prod_gr_flash_attention_backward: PASSED");
}
