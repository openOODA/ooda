// # Product deque prove
//
// Logline: Fail-closed emit+gcc+run of shipped deque_push_back/len.
//
// Setup: Product std/collections/deque.oo. List[Int] destub.
//
// Beats:
//   1. After push_back 7, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/deque.oo";

pub fn main() {
    let mut d: Deque = deque_new();
    d = deque_push_back(d, 7);
    let n: Int = deque_len(d);
    if n != 1 {
        println("FAIL deque len");
        process_exit(1);
    }
    println("prod_deque: PASSED");
}
