// # Product prove std/sync/atomic_flag.oo
//
// Logline: Fail-closed emit+gcc+run asserts atomic_flag_test is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/atomic_flag.oo.
//
// Beats:
//   1. Call atomic_flag_test twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_atomic_flag: PASSED only if they match.

import "std/sync/atomic_flag.oo";

pub fn main() {
    let obj = atomic_flag_new();
    let a = atomic_flag_test(obj);
    let b = atomic_flag_test(obj);
    if a != b {
        println("FAIL atomic_flag_test");
        process_exit(1);
    }
    println("prod_atomic_flag: PASSED");
}
