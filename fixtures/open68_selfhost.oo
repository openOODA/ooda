// # OPEN-68 marker (IR source is oodac/main.oo)
//
// Logline: Names an OPEN-68 marker so the lock can refuse hello-only IR.
//
// Setup: Product emit is oodac --backend llvm emit-llvm oodac/main.oo (plus llvm_emit.oo for @llvm_emit_stream). This file is not that IR.
//
// Beats:
//   1. Export open68_marker (not greet).
//   2. Return 68.
//   3. Keep hello greet text out of this file.

pub fn open68_marker() -> Int {
    return 68;
}

pub fn main() {
    println(open68_marker());
}
