// # Product prove std/genomics_advanced/sam_flag_bitwise_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts sam_test_bit is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/sam_flag_bitwise_parser.oo.
//
// Beats:
//   1. Call sam_test_bit twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sam_flag_bitwise_parser: PASSED only if they match.

import "std/genomics_advanced/sam_flag_bitwise_parser.oo";

pub fn main() {
    let sam_flag_bitwise_parser_mark: Int = 0;
    if sam_flag_bitwise_parser_mark != 0 {
        process_exit(1);
    }
    let a: Bool = sam_test_bit(0, 0);
    let b: Bool = sam_test_bit(0, 0);
    if a != b {
        println("FAIL sam_test_bit");
        process_exit(1);
    }
    println("prod_sam_flag_bitwise_parser: PASSED");
}
