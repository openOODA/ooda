// # Product prove std/fintech_l3_book/nasdaq_ouch50_order_entry.oo
//
// Logline: Fail-closed emit+gcc+run asserts ouch_enter_order_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/nasdaq_ouch50_order_entry.oo.
//
// Beats:
//   1. Call ouch_enter_order_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nasdaq_ouch50_order_entry: PASSED only if they match.

import "std/fintech_l3_book/nasdaq_ouch50_order_entry.oo";

pub fn main() {
    let a: OuchEnterOrder = ouch_enter_order_new(0, "x", 0, "x", 0, 0, "x");
    let b: OuchEnterOrder = ouch_enter_order_new(0, "x", 0, "x", 0, 0, "x");
    if a.user_ref_number != b.user_ref_number {
        println("FAIL ouch_enter_order_new");
        process_exit(1);
    }
    println("prod_nasdaq_ouch50_order_entry: PASSED");
}
