// # Product prove std/quantum_advanced/interleaved_randomized_benchmarking.oo
//
// Logline: Fail-closed emit+gcc+run asserts irb_target_cnot is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/interleaved_randomized_benchmarking.oo.
//
// Beats:
//   1. Call irb_target_cnot twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_interleaved_randomized_benchmarking: PASSED only if they match.

import "std/quantum_advanced/interleaved_randomized_benchmarking.oo";

pub fn main() {
    let a: InterleavedTargetGate = irb_target_cnot();
    let b: InterleavedTargetGate = irb_target_cnot();
    if a.gate_name_code != b.gate_name_code {
        println("FAIL irb_target_cnot");
        process_exit(1);
    }
    println("prod_interleaved_randomized_benchmarking: PASSED");
}
