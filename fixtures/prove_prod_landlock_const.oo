// # Product prove std/sec/sys/landlock_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts landlock_access_fs_execute is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/landlock_const.oo.
//
// Beats:
//   1. Call landlock_access_fs_execute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_landlock_const: PASSED only if they match.

import "std/sec/sys/landlock_const.oo";

pub fn main() {
    let a = landlock_access_fs_execute();
    let b = landlock_access_fs_execute();
    if a != b {
        println("FAIL landlock_access_fs_execute");
        process_exit(1);
    }
    println("prod_landlock_const: PASSED");
}
