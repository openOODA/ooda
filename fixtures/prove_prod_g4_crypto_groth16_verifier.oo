// # Product prove std/crypto_advanced/groth16_verifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts groth16 verification engine is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/groth16_verifier.oo.
//
// Beats:
//   1. Construct verifying key, proving key, and proof object.
//   2. Accumulate public inputs on G1 deterministically.
//   3. Execute groth16_verify twice and assert matching verification results.
//   4. Print prod_g4_crypto_groth16_verifier: PASSED and exit 0.

import "std/crypto_advanced/groth16_verifier.oo";

pub fn main() {
    let g1_gen: Bn254G1Affine = bn254_g1_generator(1009);
    let g2_gen: Bn254G2Affine = bn254_g2_generator(1009);

    let vk: Groth16VerifyingKey = groth16_vk_init(g1_gen, g2_gen, g2_gen, g2_gen, 2);
    if !(vk).is_valid || (vk).num_inputs != 2 {
        println("FAIL groth16_vk_init");
        process_exit(1);
    }

    let mut inputs: List[Int] = list_new();
    inputs = list_push(inputs, 2);
    inputs = list_push(inputs, 3);

    let acc1: Bn254G1Affine = groth16_accumulate_public_inputs(vk, inputs);
    let acc2: Bn254G1Affine = groth16_accumulate_public_inputs(vk, inputs);
    if ((acc1).x).val != ((acc2).x).val || ((acc1).y).val != ((acc2).y).val {
        println("FAIL groth16_accumulate_public_inputs mismatch");
        process_exit(1);
    }

    let mut priv_wit: List[Int] = list_new();
    priv_wit = list_push(priv_wit, 7);
    let wit: Groth16Witness = groth16_witness_new(inputs, priv_wit);
    let pk: Groth16ProvingKey = groth16_proving_key_new(g1_gen, g1_gen, g2_gen, g1_gen, g2_gen);
    let proof: Groth16Proof = groth16_prove(pk, wit, 3, 5, "v_proof");

    let res1: Groth16VerifyResult = groth16_verify(vk, proof, inputs);
    let res2: Groth16VerifyResult = groth16_verify(vk, proof, inputs);

    if (res1).is_valid != (res2).is_valid || !(res1).is_valid {
        println("FAIL groth16_verify is_valid mismatch");
        process_exit(1);
    }
    if (res1).error_code != (res2).error_code || (res1).error_code != 0 {
        println("FAIL groth16_verify error_code mismatch");
        process_exit(1);
    }
    if chars_len((res1).details) != chars_len((res2).details) || chars_len((res1).details) == 0 {
        println("FAIL groth16_verify details mismatch");
        process_exit(1);
    }

    let invalid_proof: Groth16Proof = groth16_proof_empty(1009);
    let res_inv: Groth16VerifyResult = groth16_verify(vk, invalid_proof, inputs);
    if (res_inv).is_valid || (res_inv).error_code != 1 {
        println("FAIL groth16_verify invalid proof should fail closed");
        process_exit(1);
    }

    println("prod_g4_crypto_groth16_verifier: PASSED");
    process_exit(0);
}
