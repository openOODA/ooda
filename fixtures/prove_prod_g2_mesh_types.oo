// # Product prove std/3d/mesh_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/mesh_types.oo.
//
// Beats:
//   1. Call vector3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mesh_types: PASSED only if they match.

import "std/3d/mesh_types.oo";

pub fn main() {
    let mesh_types_mark: Int = 0;
    if mesh_types_mark != 0 {
        process_exit(1);
    }
    let a: Vector3 = vector3_new(0, 0, 0);
    let b: Vector3 = vector3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL vector3_new");
        process_exit(1);
    }
    println("prod_g2_mesh_types: PASSED");
}
