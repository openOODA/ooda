// # Product prove std/satellite_dvb/dvb_s2_bch_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts dvb_bch_step_lfsr is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2_bch_encoder.oo.
//
// Beats:
//   1. Call dvb_bch_step_lfsr twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dvb_s2_bch_encoder: PASSED only if they match.

import "std/satellite_dvb/dvb_s2_bch_encoder.oo";

pub fn main() {
    let dvb_s2_bch_encoder_mark: Int = 0;
    if dvb_s2_bch_encoder_mark != 0 {
        process_exit(1);
    }
    let a: Int = dvb_bch_step_lfsr(0, 0, 0);
    let b: Int = dvb_bch_step_lfsr(0, 0, 0);
    if a != b {
        println("FAIL dvb_bch_step_lfsr");
        process_exit(1);
    }
    println("prod_g2_dvb_s2_bch_encoder: PASSED");
}
