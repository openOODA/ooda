// # Product reader prove
//
// Logline: Fail-closed emit+gcc+run of shipped reader_from_string/advance/is_eof.
//
// Setup: Product std/io/reader.oo. In-memory "hello".
//
// Beats:
//   1. New reader not eof; after advance 5, eof true; position 5.
//   2. Exit 1 before PASSED on a miss.

import "std/io/reader.oo";

pub fn main() {
    let mut r: Reader = reader_from_string("hello");
    let e0: Bool = reader_is_eof(r);
    if e0 == true {
        println("FAIL reader eof0");
        process_exit(1);
    }
    r = reader_advance(r, 5);
    let e1: Bool = reader_is_eof(r);
    if e1 == false {
        println("FAIL reader eof1");
        process_exit(1);
    }
    let p: Int = reader_position(r);
    if p != 5 {
        println("FAIL reader pos");
        process_exit(1);
    }
    println("prod_reader: PASSED");
}
