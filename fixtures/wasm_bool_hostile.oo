// # Hostile ident bool fold
//
// Logline: Print flag so emit-wasm must miss a const true fold.
//
// Setup: One public main. Operand is IDENT flag, not KW_TRUE.
//
// Beats:
//   1. Let flag be true.
//   2. Print flag.
//   3. A true-only module is a lie.

pub fn main() {
    let flag = true;
    println(flag);
}
