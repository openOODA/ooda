// # Product prove std/enterprise/erp.oo
//
// Logline: Fail-closed emit+gcc+run asserts inventory_item_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/erp.oo.
//
// Beats:
//   1. Call inventory_item_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_erp: PASSED only if they match.

import "std/enterprise/erp.oo";

pub fn main() {
    let a: InventoryItem = inventory_item_init(0, 0, 0, 0, 0, 0);
    let b: InventoryItem = inventory_item_init(0, 0, 0, 0, 0, 0);
    if a.id != b.id {
        println("FAIL inventory_item_init");
        process_exit(1);
    }
    println("prod_erp: PASSED");
}
