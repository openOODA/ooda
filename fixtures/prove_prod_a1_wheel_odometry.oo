// # Product prove std/auto_robot/wheel_odometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts wheel_odometry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/wheel_odometry.oo.
//
// Beats:
//   1. Call wheel_odometry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wheel_odometry: PASSED only if they match.

import "std/auto_robot/wheel_odometry.oo";

pub fn main() {
    let a: WheelOdometryState = wheel_odometry_new(0, 0, 0);
    let b: WheelOdometryState = wheel_odometry_new(0, 0, 0);
    if (a).x_milli != (b).x_milli {
        println("FAIL wheel_odometry_new");
        process_exit(1);
    }
    println("prod_wheel_odometry: PASSED");
}
