// # Product prove std/robotics_auv/auv_mpc_trajectory_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts mpc_horizon_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_mpc_trajectory_tracker.oo.
//
// Beats:
//   1. Call mpc_horizon_config_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_mpc_trajectory_tracker: PASSED only if they match.

import "std/robotics_auv/auv_mpc_trajectory_tracker.oo";

pub fn main() {
    let auv_mpc_trajectory_tracker_mark: Int = 0;
    if auv_mpc_trajectory_tracker_mark != 0 {
        process_exit(1);
    }
    let a: MpcHorizonConfig = mpc_horizon_config_default();
    let b: MpcHorizonConfig = mpc_horizon_config_default();
    if (a).field0 != (b).field0 {
        println("FAIL mpc_horizon_config_default");
        process_exit(1);
    }
    println("prod_auv_mpc_trajectory_tracker: PASSED");
}
