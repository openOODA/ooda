// # Product prove std/fhe_lattices/fhe_module_lwe.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_module_lwe_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_module_lwe.oo.
//
// Beats:
//   1. Call fhe_module_lwe_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_fhe_module_lwe: PASSED only if it matches.

import "std/fhe_lattices/fhe_module_lwe.oo";

pub fn main() {
    let a: Int = fhe_module_lwe_probe();
    if a != 0 {
        println("FAIL fhe_module_lwe_probe");
        process_exit(1);
    }
    println("prod_nc_fhe_module_lwe: PASSED");
}
