// # Product prove std/db_vector_ann/vector_memory_budget_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts estimate_vector_memory is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/vector_memory_budget_controller.oo.
//
// Beats:
//   1. Call estimate_vector_memory twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_memory_budget_controller: PASSED only if they match.

import "std/db_vector_ann/vector_memory_budget_controller.oo";

pub fn main() {
    let vector_memory_budget_controller_mark: Int = 0;
    if vector_memory_budget_controller_mark != 0 {
        process_exit(1);
    }
    let a: Int = estimate_vector_memory(0, 0, 0);
    let b: Int = estimate_vector_memory(0, 0, 0);
    if a != b {
        println("FAIL estimate_vector_memory");
        process_exit(1);
    }
    println("prod_vector_memory_budget_controller: PASSED");
}
