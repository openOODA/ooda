// # emit-x86 ALU compare if
//
// Logline: If 1 plus 1 equals 2 print yes else no.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet.
//
// Beats:
//   1. Fold 1 plus 1 equals 2.
//   2. Take the true branch.
//   3. as+ld stdout is yes only.
//
// residual: C precedence stays later.

pub fn main() {
    if 1 + 1 == 2 {
        println("yes");
    } else {
        println("no");
    }
}
