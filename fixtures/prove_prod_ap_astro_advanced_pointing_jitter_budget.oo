// # Product prove std/astro_advanced/pointing_jitter_budget.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/pointing_jitter_budget.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/pointing_jitter_budget.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pointing_jitter_budget: PASSED only if they match.

import "std/astro_advanced/pointing_jitter_budget.oo";

pub fn main() {
    let pointing_jitter_budget_a = jitter_urad();
    let pointing_jitter_budget_b = jitter_urad();
    if pointing_jitter_budget_a != pointing_jitter_budget_b {
        println("FAIL pointing_jitter_budget");
        process_exit(1);
    }
    println("prod_ap_pointing_jitter_budget: PASSED");
}
