// # Product prove std/net_telemetry/ipv4_packet.oo
//
// Logline: Fail-closed emit+gcc+run asserts ipv4_address_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/ipv4_packet.oo.
//
// Beats:
//   1. Call ipv4_address_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ipv4_packet: PASSED only if they match.

import "std/net_telemetry/ipv4_packet.oo";

pub fn main() {
    let a: Ipv4Address = ipv4_address_new(0, 0, 0, 0);
    let b: Ipv4Address = ipv4_address_new(0, 0, 0, 0);
    if a.o1 != b.o1 {
        println("FAIL ipv4_address_new");
        process_exit(1);
    }
    println("prod_ipv4_packet: PASSED");
}
