// # Product prove std/multimedia/png_encoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts png_abs is a real value.
//
// Setup: Isolated emit-c. Imports std/multimedia/png_encoder.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call png_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_png_encoder: PASSED only if they match.

import "std/multimedia/png_encoder.oo";

pub fn main() {
    let g0_a = png_abs(0);
    let g0_b = png_abs(0);
    if g0_a != g0_b {
        println("FAIL png_abs");
        process_exit(1);
    }
    println("prod_gr_png_encoder: PASSED");
}
