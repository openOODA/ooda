// # Product prove std/bioinformatics/pdb_atom_record.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/bioinformatics/pdb_atom_record.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/pdb_atom_record.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pdb_atom_record: PASSED only if they match.

import "std/bioinformatics/pdb_atom_record.oo";

pub fn main() {
    let pdb_atom_record_a = point3d_new(0, 0, 0);
    let pdb_atom_record_b = point3d_new(0, 0, 0);
    let pdb_atom_record_va = point3d_x(pdb_atom_record_a);
    let pdb_atom_record_vb = point3d_x(pdb_atom_record_b);
    if pdb_atom_record_va != pdb_atom_record_vb {
        println("FAIL pdb_atom_record");
        process_exit(1);
    }
    println("prod_ap_pdb_atom_record: PASSED");
}
