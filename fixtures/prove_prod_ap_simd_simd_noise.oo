// # Product prove std/simd/simd_noise.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_noise.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_noise.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_simd_noise: PASSED only if they match.

import "std/simd/simd_noise.oo";

pub fn main() {
    let simd_noise_a = simd_noise_fade(0.0);
    let simd_noise_b = simd_noise_fade(0.0);
    if simd_noise_a != simd_noise_b {
        println("FAIL simd_noise");
        process_exit(1);
    }
    println("prod_ap_simd_noise: PASSED");
}
