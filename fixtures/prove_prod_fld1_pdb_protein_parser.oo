// # Product prove std/bioinformatics/pdb_protein_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts pdb_chain_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/pdb_protein_parser.oo.
//
// Beats:
//   1. Call pdb_chain_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_pdb_protein_parser: PASSED only if they match.

import "std/bioinformatics/pdb_protein_parser.oo";

pub fn main() {
    let pdb_protein_parser_mark: Int = 0;
    if pdb_protein_parser_mark != 0 {
        process_exit(1);
    }
    let pdb_protein_parser_a = pdb_chain_new("x", true);
    let pdb_protein_parser_b = pdb_chain_new("x", true);
    if (pdb_protein_parser_a).residue_count != (pdb_protein_parser_b).residue_count {
        println("FAIL pdb_chain_new");
        process_exit(1);
    }
    println("prod_pdb_protein_parser: PASSED");
}
