// # Product prove std/quantum/qft_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts qft_math_pi_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/qft_engine.oo.
//
// Beats:
//   1. Call qft_math_pi_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_qft_engine: PASSED only if they match.

import "std/quantum/qft_engine.oo";

pub fn main() {
    let qft_engine_mark: Int = 0;
    if qft_engine_mark != 0 {
        process_exit(1);
    }
    let a: Int = qft_math_pi_milli();
    let b: Int = qft_math_pi_milli();
    if a != b {
        println("FAIL qft_math_pi_milli");
        process_exit(1);
    }
    println("prod_qft_engine: PASSED");
}
