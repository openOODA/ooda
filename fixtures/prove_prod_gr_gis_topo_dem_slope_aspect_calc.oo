// # Product prove std/gis_topo/dem_slope_aspect_calc.oo
//
// Logline: Fail-closed emit+gcc+run asserts dem_slope_aspect_calc_probe is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/dem_slope_aspect_calc.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call dem_slope_aspect_calc_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_dem_slope_aspect_calc: PASSED only if they match.

import "std/gis_topo/dem_slope_aspect_calc.oo";

pub fn main() {
    let g0_a = dem_slope_aspect_calc_probe();
    let g0_b = dem_slope_aspect_calc_probe();
    if g0_a != g0_b {
        println("FAIL dem_slope_aspect_calc_probe");
        process_exit(1);
    }
    println("prod_gr_dem_slope_aspect_calc: PASSED");
}
