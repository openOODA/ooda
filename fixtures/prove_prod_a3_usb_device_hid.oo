// # Product prove std/embedded_hal/usb_device_hid.oo
//
// Logline: Fail-closed emit+gcc+run asserts usb_hid_keyboard_report_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/usb_device_hid.oo.
//
// Beats:
//   1. Call usb_hid_keyboard_report_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_usb_device_hid: PASSED only if they match.

import "std/embedded_hal/usb_device_hid.oo";

pub fn main() {
    let usb_device_hid_mark: Int = 0;
    if usb_device_hid_mark != 0 {
        process_exit(1);
    }
    let a: UsbHidKeyboardReport = usb_hid_keyboard_report_new();
    let b: UsbHidKeyboardReport = usb_hid_keyboard_report_new();
    if (a).modifier_keys != (b).modifier_keys {
        println("FAIL usb_hid_keyboard_report_new");
        process_exit(1);
    }
    println("prod_usb_device_hid: PASSED");
}
