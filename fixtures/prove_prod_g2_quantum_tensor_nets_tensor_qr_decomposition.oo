// # Product prove std/quantum_tensor_nets/tensor_qr_decomposition.oo
//
// Logline: Fail-closed emit+gcc+run asserts qr_decompose_2x2 is a real value.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/tensor_qr_decomposition.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call qr_decompose_2x2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tensor_qr_decomposition: PASSED only if they match.

import "std/quantum_tensor_nets/tensor_qr_decomposition.oo";

pub fn main() {
    let g2_oa: QrResult2x2 = qr_decompose_2x2(1.0, 1.0, 1.0, 1.0);
    let g2_ob: QrResult2x2 = qr_decompose_2x2(1.0, 1.0, 1.0, 1.0);
    let g2_a = (g2_oa).q00;
    let g2_b = (g2_ob).q00;
    if g2_a != g2_b {
        println("FAIL qr_decompose_2x2.q00");
        process_exit(1);
    }
    println("prod_g2_tensor_qr_decomposition: PASSED");
}
