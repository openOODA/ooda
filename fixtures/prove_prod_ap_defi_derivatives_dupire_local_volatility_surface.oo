//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_dupire_local_volatility_surface: PASSED only if they match.

import "std/defi_derivatives/dupire_local_volatility_surface.oo";

pub fn main() {
    let dupire_local_volatility_surface_a = dupire_surface_new("x", 0.0, 0.0, 0.0);
    let dupire_local_volatility_surface_b = dupire_surface_new("x", 0.0, 0.0, 0.0);
    if dupire_local_volatility_surface_a.underlying_symbol != dupire_local_volatility_surface_b.underlying_symbol {
        println("FAIL dupire_local_volatility_surface");
        process_exit(1);
    }
    println("prod_ap_dupire_local_volatility_surface: PASSED");
}
