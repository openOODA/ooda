// # Product prove std/fin/yield_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts yield_curve_fit_nelson_siegel is a fail-closed stub.
//
// Setup: Isolated emit-c. Imports std/fin/yield_stubs.oo.
//
// Beats:
//   1. Call yield_curve_fit_nelson_siegel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_yield_stubs: PASSED only if they match.

import "std/fin/yield_stubs.oo";

pub fn main() {
    let yield_stubs_mark: Int = 0;
    if yield_stubs_mark != 0 {
        process_exit(1);
    }
    let a: YieldCurveParams = yield_curve_fit_nelson_siegel(0, 0, 0);
    let b: YieldCurveParams = yield_curve_fit_nelson_siegel(0, 0, 0);
    if (a).beta0 != (b).beta0 {
        println("FAIL yield_curve_fit_nelson_siegel");
        process_exit(1);
    }
    println("prod_yield_stubs: PASSED");
}
