    let industrial_predictive_stubs_a = predictive_stub_vibration_adc_dma_status(0);
    let industrial_predictive_stubs_b = predictive_stub_vibration_adc_dma_status(0);
    if industrial_predictive_stubs_a != industrial_predictive_stubs_b {
        println("FAIL industrial_predictive_stubs");
        process_exit(1);
