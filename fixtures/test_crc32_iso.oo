// # CRC-32 ISO adversarial suite
//
// Logline: Agrees bitwise and table CRC-32 on the published 123456789 vector.
//
// Setup: Pure. Imports crc32_iso.oo. Run from ooda/.
//
// Beats:
//   1. Hash ASCII 123456789 with the bitwise mixer.
//   2. Hash the same buffer with the table mixer.
//   3. Require both to equal 0xCBF43926.

import "std/hash/crc32_iso.oo";

pub fn main() {
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    let s: String = "123456789";
    while i < bytes_len(s) {
        b = list_push(b, byte_at(s, i));
        i = i + 1;
    }
    let bits: Int = crc32_iso_bits(b);
    let tab: Int = crc32_iso_table(b);
    let want: Int = crc32_iso_checkvec();
    if bits != tab {
        println("FAIL bits vs table");
        process_exit(1);
    }
    println("bitwise and table match");
    if bits != want {
        println("FAIL checkvec");
        process_exit(1);
    }
    let st: Result[Int, String] = crc32_iso_stat(bits, want);
    if st.is_err() {
        println("FAIL stat");
        process_exit(1);
    }
    println("123456789 -> 0xCBF43926");
    println("SUITE PASSED");
    println("test_crc32_iso: PASSED");
}
