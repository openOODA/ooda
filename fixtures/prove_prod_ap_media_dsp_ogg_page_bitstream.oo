// # Product prove std/media_dsp/ogg_page_bitstream.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/ogg_page_bitstream.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/ogg_page_bitstream.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ogg_page_bitstream: PASSED only if they match.

import "std/media_dsp/ogg_page_bitstream.oo";

pub fn main() {
    let ogg_page_bitstream_a = ogg_flag_continued();
    let ogg_page_bitstream_b = ogg_flag_continued();
    if ogg_page_bitstream_a != ogg_page_bitstream_b {
        println("FAIL ogg_page_bitstream");
        process_exit(1);
    }
    println("prod_ap_ogg_page_bitstream: PASSED");
}
