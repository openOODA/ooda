// # Product prove std/gis_topo/wkt_geometry_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts wkt_detect_type is a real value.
//
// Setup: Isolated emit-c. Imports std/gis_topo/wkt_geometry_parser.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call wkt_detect_type twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_wkt_geometry_parser: PASSED only if they match.

import "std/gis_topo/wkt_geometry_parser.oo";

pub fn main() {
    let g0_a = wkt_detect_type("x");
    let g0_b = wkt_detect_type("x");
    if chars_len(g0_a) != chars_len(g0_b) {
        println("FAIL wkt_detect_type");
        process_exit(1);
    }
    if chars_len(g0_a) < 0 {
        println("FAIL wkt_detect_type");
        process_exit(1);
    }
    println("prod_gr_wkt_geometry_parser: PASSED");
}
