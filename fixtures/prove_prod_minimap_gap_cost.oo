// # Product prove std/genomics_advanced/minimap2_minimizer_chain.oo
//
// Logline: Fail-closed emit+gcc+run asserts minimap_calc_gap_cost is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/minimap2_minimizer_chain.oo.
//
// Beats:
//   1. Call minimap_calc_gap_cost twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_minimap_gap_cost: PASSED only if they match.

import "std/genomics_advanced/minimap2_minimizer_chain.oo";

pub fn main() {
    let minimap2_minimizer_chain_mark: Int = 0;
    if minimap2_minimizer_chain_mark != 0 { process_exit(1); }
    let a: Int = minimap_calc_gap_cost(10, 5, 4, 2);
    let b: Int = minimap_calc_gap_cost(10, 5, 4, 2);
    if a != b {
        println("FAIL minimap_calc_gap_cost");
        process_exit(1);
    }
    println("prod_minimap_gap_cost: PASSED");
}
