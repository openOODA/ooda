import "std/crypto_advanced/bulletproofs_range_proof.oo";

pub fn main() {
    let bulletproofs_range_proof_a = bulletproofs_range_prover_init(0, 0);
    let bulletproofs_range_proof_b = bulletproofs_range_prover_init(0, 0);
    if bulletproofs_range_proof_a.bits_len != bulletproofs_range_proof_b.bits_len {
        println("FAIL bulletproofs_range_proof");
