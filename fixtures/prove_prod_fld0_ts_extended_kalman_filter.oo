// # Product prove std/industrial_predictive/ts_extended_kalman_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts math_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/industrial_predictive/ts_extended_kalman_filter.oo.
//
// Beats:
//   1. Call math_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ts_extended_kalman_filter: PASSED only if they match.

import "std/industrial_predictive/ts_extended_kalman_filter.oo";

pub fn main() {
    let ts_extended_kalman_filter_mark: Int = 0;
    if ts_extended_kalman_filter_mark != 0 {
        process_exit(1);
    }
    let ts_extended_kalman_filter_a: Float = math_sqrt(1.0);
    let ts_extended_kalman_filter_b: Float = math_sqrt(1.0);
    if ts_extended_kalman_filter_a != ts_extended_kalman_filter_b {
        println("FAIL math_sqrt");
        process_exit(1);
    }
    println("prod_ts_extended_kalman_filter: PASSED");
}
