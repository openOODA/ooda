// # Product prove std/crypto_advanced/merkle_tree_zk.oo
//
// Logline: Fail-closed emit+gcc+run asserts merkle_zk_derive_nullifier is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/merkle_tree_zk.oo.
//
// Beats:
//   1. Call merkle_zk_derive_nullifier twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_merkle_tree_zk: PASSED only if they match.

import "std/crypto_advanced/merkle_tree_zk.oo";
import "std/str.oo";

pub fn main() {
    let merkle_tree_zk_mark: Int = 0;
    if merkle_tree_zk_mark != 0 {
        process_exit(1);
    }
    let a: String = merkle_zk_derive_nullifier("x", 0);
    let b: String = merkle_zk_derive_nullifier("x", 0);
    if str_eq(a, b) == false {
        println("FAIL merkle_zk_derive_nullifier");
        process_exit(1);
    }
    println("prod_merkle_tree_zk: PASSED");
}
