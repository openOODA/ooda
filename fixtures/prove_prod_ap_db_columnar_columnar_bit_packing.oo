// # Product prove std/db_columnar/columnar_bit_packing.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_bit_packing.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_bit_packing.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_columnar_bit_packing: PASSED only if they match.

import "std/db_columnar/columnar_bit_packing.oo";

pub fn main() {
    let columnar_bit_packing_a = bit_packing_config_new(0, 0);
    let columnar_bit_packing_b = bit_packing_config_new(0, 0);
    if columnar_bit_packing_a.bit_width != columnar_bit_packing_b.bit_width {
        println("FAIL columnar_bit_packing");
        process_exit(1);
    }
    println("prod_ap_columnar_bit_packing: PASSED");
}
