// # Product prove std/sync/timer_wheel.oo
//
// Logline: Fail-closed emit+gcc+run asserts timer_wheel_current_tick is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/timer_wheel.oo.
//
// Beats:
//   1. Call timer_wheel_current_tick twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_timer_wheel: PASSED only if they match.

import "std/sync/timer_wheel.oo";

pub fn main() {
    let obj = timer_wheel_new(0);
    let a = timer_wheel_current_tick(obj);
    let b = timer_wheel_current_tick(obj);
    if a != b {
        println("FAIL timer_wheel_current_tick");
        process_exit(1);
    }
    println("prod_timer_wheel: PASSED");
}
