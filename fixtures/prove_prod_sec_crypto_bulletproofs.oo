// # Product prove std/sec/crypto/bulletproofs.oo
//
// Logline: Fail-closed emit+check asserts shim_marker_mod_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs.oo.
//
// Beats:
//   1. Call shim_marker_mod_pow twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bulletproofs: PASSED only if they match.

import "std/sec/crypto/bulletproofs.oo";

pub fn main() {
    let bulletproofs_mark: Int = 0;
    if bulletproofs_mark != 0 { process_exit(1); }
    let a: Int = shim_marker_mod_pow();
    let b: Int = shim_marker_mod_pow();
    if a != b { process_exit(1); }
    println("prod_bulletproofs: PASSED");
}
