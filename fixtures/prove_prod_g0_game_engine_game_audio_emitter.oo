// # Product prove std/game_engine/game_audio_emitter.oo
//
// Logline: Fail-closed emit+gcc+run asserts audio_falloff_linear is a real value.
//
// Setup: Isolated emit-c. Imports std/game_engine/game_audio_emitter.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call audio_falloff_linear twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_game_audio_emitter: PASSED only if they match.

import "std/game_engine/game_audio_emitter.oo";

pub fn main() {
    let g0_a = audio_falloff_linear();
    let g0_b = audio_falloff_linear();
    if g0_a != g0_b {
        println("FAIL audio_falloff_linear");
        process_exit(1);
    }
    println("prod_g0_game_audio_emitter: PASSED");
}
