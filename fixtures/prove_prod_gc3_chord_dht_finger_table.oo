// # Product prove std/graph_networks/chord_dht_finger_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts chord_pow2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/chord_dht_finger_table.oo.
//
// Beats:
//   1. Call chord_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_chord_dht_finger_table: PASSED only if they match.

import "std/graph_networks/chord_dht_finger_table.oo";

pub fn main() {
    let chord_dht_finger_table_mark: Int = 0;
    if chord_dht_finger_table_mark != 0 {
        process_exit(1);
    }
    let chord_dht_finger_table_a: Int = chord_pow2(1);
    let chord_dht_finger_table_b: Int = chord_pow2(1);
    if chord_dht_finger_table_a != chord_dht_finger_table_b {
        println("FAIL chord_pow2");
        process_exit(1);
    }
    println("prod_chord_dht_finger_table: PASSED");
}
