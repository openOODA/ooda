// # Product prove std/genomics_advanced/polygenic_risk_score_prs.oo
//
// Logline: Fail-closed emit+gcc+run asserts polygenic_risk_score_prs_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/polygenic_risk_score_prs.oo.
//
// Beats:
//   1. Call polygenic_risk_score_prs_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_polygenic_risk_score_prs: PASSED only if it matches.

import "std/genomics_advanced/polygenic_risk_score_prs.oo";

pub fn main() {
    let a: Int = polygenic_risk_score_prs_probe();
    if a != 0 {
        println("FAIL polygenic_risk_score_prs_probe");
        process_exit(1);
    }
    println("prod_nc_polygenic_risk_score_prs: PASSED");
}
