// # Product prove std/physics_advanced/solar_radiation_pressure.oo
//
// Logline: Fail-closed emit+gcc+run asserts srp_cannonball_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/solar_radiation_pressure.oo.
//
// Beats:
//   1. Call srp_cannonball_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_radiation_pressure: PASSED only if they match.

import "std/physics_advanced/solar_radiation_pressure.oo";

pub fn main() {
    let solar_radiation_pressure_mark: Int = 0;
    if solar_radiation_pressure_mark != 0 {
        process_exit(1);
    }
    let a: SpacecraftSrpProperties = srp_cannonball_new(0.0, 0.0, 0.0);
    let b: SpacecraftSrpProperties = srp_cannonball_new(0.0, 0.0, 0.0);
    if (a).cross_section_area_m2 != (b).cross_section_area_m2 {
        println("FAIL srp_cannonball_new");
        process_exit(1);
    }
    println("prod_solar_radiation_pressure: PASSED");
}
