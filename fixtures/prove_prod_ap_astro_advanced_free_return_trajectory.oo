// # Product prove std/astro_advanced/free_return_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astro_advanced/free_return_trajectory.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/free_return_trajectory.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_free_return_trajectory: PASSED only if they match.

import "std/astro_advanced/free_return_trajectory.oo";

pub fn main() {
    let free_return_trajectory_a = free_return_tof_hours();
    let free_return_trajectory_b = free_return_tof_hours();
    if free_return_trajectory_a != free_return_trajectory_b {
        println("FAIL free_return_trajectory");
        process_exit(1);
    }
    println("prod_ap_free_return_trajectory: PASSED");
}
