// # Product prove std/enterprise/audit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_severity_to_string is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/audit_types.oo.
//
// Beats:
//   1. Call audit_severity_to_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit_types: PASSED only if they match.

import "std/enterprise/audit_types.oo";

pub fn main() {
    let audit_types_mark: Int = 0;
    if audit_types_mark != 0 {
        process_exit(1);
    }
    let a: String = audit_severity_to_string(0);
    let b: String = audit_severity_to_string(0);
    if a != b {
        println("FAIL audit_severity_to_string");
        process_exit(1);
    }
    println("prod_audit_types: PASSED");
}
