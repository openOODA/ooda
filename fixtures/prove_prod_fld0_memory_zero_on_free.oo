// # Product prove std/security_defense/memory_zero_on_free.oo
//
// Logline: Fail-closed emit+gcc+run asserts secure_memory_manager_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/memory_zero_on_free.oo.
//
// Beats:
//   1. Call secure_memory_manager_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_memory_zero_on_free: PASSED only if they match.

import "std/security_defense/memory_zero_on_free.oo";

pub fn main() {
    let memory_zero_on_free_mark: Int = 0;
    if memory_zero_on_free_mark != 0 {
        process_exit(1);
    }
    let memory_zero_on_free_a: SecureMemoryManager = secure_memory_manager_new();
    let memory_zero_on_free_b: SecureMemoryManager = secure_memory_manager_new();
    if (memory_zero_on_free_a).buffer_count != (memory_zero_on_free_b).buffer_count {
        println("FAIL secure_memory_manager_new");
        process_exit(1);
    }
    println("prod_memory_zero_on_free: PASSED");
}
