// # Product prove std/perf/rwlock.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/rwlock.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/rwlock.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rwlock: PASSED only if they match.

import "std/perf/rwlock.oo";

pub fn main() {
    let rwlock_a = rwlock_create("x");
    let rwlock_b = rwlock_create("x");
    let rwlock_va = rwlock_active_readers(rwlock_a);
    let rwlock_vb = rwlock_active_readers(rwlock_b);
    if rwlock_va != rwlock_vb {
        println("FAIL rwlock");
        process_exit(1);
    }
    println("prod_ap_rwlock: PASSED");
}
