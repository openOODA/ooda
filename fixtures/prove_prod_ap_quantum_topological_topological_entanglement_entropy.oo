// # Product prove std/quantum_topological/topological_entanglement_entropy.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_topological/topological_entanglement_entropy.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_entanglement_entropy.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_topological_entanglement_entropy: PASSED only if they match.

import "std/quantum_topological/topological_entanglement_entropy.oo";

pub fn main() {
    let topological_entanglement_entropy_a = total_quantum_dim_from_gamma(0.0);
    let topological_entanglement_entropy_b = total_quantum_dim_from_gamma(0.0);
    if topological_entanglement_entropy_a != topological_entanglement_entropy_b {
        println("FAIL topological_entanglement_entropy");
        process_exit(1);
    }
    println("prod_ap_topological_entanglement_entropy: PASSED");
}
