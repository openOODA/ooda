// # Product prove std/lidar_perception/passthrough_filter.oo
//
// Logline: Fail-closed verification that LiDAR passthrough filtering, blind spot detection, and range clipping are deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/passthrough_filter.oo.
//
// Beats:
//   1. Query default and highway PassthroughLimits and BlindSpotBox dimensions.
//   2. Evaluate ego-vehicle blind spot point containment predicates.
//   3. Execute Cartesian and range passthrough filtering for Point3D and PointXYZI.
//   4. Print prod_g4_lidar_passthrough: PASSED only if all match.

import "std/lidar_perception/passthrough_filter.oo";

pub fn main() {
    let lim: PassthroughLimits = passthrough_limits_default();
    if (lim).min_range != 0.5 || (lim).max_range != 120.0 || !(lim).keep_inside {
        println("FAIL passthrough_limits_default");
        process_exit(1);
    }

    let hw_lim: PassthroughLimits = passthrough_limits_highway();
    if (hw_lim).max_range != 220.0 {
        println("FAIL passthrough_limits_highway");
        process_exit(1);
    }

    let blind: BlindSpotBox = blind_spot_box_default();
    if (blind).max_x != 2.5 || (blind).max_y != 1.2 || (blind).max_z != 1.0 {
        println("FAIL blind_spot_box_default");
        process_exit(1);
    }

    let p_blind: Point3D = point3d_new(0.0, 0.0, 0.0);
    let in_blind: Bool = is_point_in_blind_spot(&p_blind, &blind);
    if !in_blind {
        println("FAIL is_point_in_blind_spot");
        process_exit(1);
    }

    let p_valid: Point3D = point3d_new(10.0, 5.0, 1.0);
    let passes: Bool = passthrough_filter_eval(&p_valid, &lim, &blind);
    if !passes {
        println("FAIL passthrough_filter_eval valid");
        process_exit(1);
    }

    let p_far: Point3D = point3d_new(200.0, 0.0, 0.0);
    let rejects: Bool = passthrough_filter_eval(&p_far, &lim, &blind);
    if rejects {
        println("FAIL passthrough_filter_eval far");
        process_exit(1);
    }

    let p_xyzi: PointXYZI = PointXYZI { x: 10.0, y: 5.0, z: 1.0, intensity: 50.0 };
    let xyzi_passes: Bool = passthrough_filter_xyzi(&p_xyzi, &lim, &blind);
    if !xyzi_passes {
        println("FAIL passthrough_filter_xyzi");
        process_exit(1);
    }

    println("prod_g4_lidar_passthrough: PASSED");
    process_exit(0);
}
