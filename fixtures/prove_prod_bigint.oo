// # Product bigint prove
//
// Logline: Fail-closed emit+gcc+run of shipped bigint_zero/one/is_zero.
//
// Setup: Product std/math/bigint.oo. Sign-magnitude zero and one.
//
// Beats:
//   1. bigint_is_zero(zero) is true; bigint_is_zero(one) is false.
//   2. bigint_is_neg(zero) is false.
//   3. Exit 1 before PASSED on a miss.

import "std/math/bigint.oo";

pub fn main() {
    let z: BigInt = bigint_zero();
    let o: BigInt = bigint_one();
    let zz: Bool = bigint_is_zero(z);
    if zz == false {
        println("FAIL bigint zero");
        process_exit(1);
    }
    let oz: Bool = bigint_is_zero(o);
    if oz == true {
        println("FAIL bigint one not zero");
        process_exit(1);
    }
    let zn: Bool = bigint_is_neg(z);
    if zn == true {
        println("FAIL bigint zero neg");
        process_exit(1);
    }
    println("prod_bigint: PASSED");
}
