// # Product prove std/gui/layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts rect_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/layout.oo.
//
// Beats:
//   1. Call rect_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_layout: PASSED only if they match.

import "std/gui/layout.oo";

pub fn main() {
    let layout_mark: Int = 0;
    if layout_mark != 0 {
        process_exit(1);
    }
    let a: Rect = rect_new(0, 0, 0, 0);
    let b: Rect = rect_new(0, 0, 0, 0);
    if (a).x != (b).x {
        println("FAIL rect_new");
        process_exit(1);
    }
    println("prod_g2_layout: PASSED");
}
