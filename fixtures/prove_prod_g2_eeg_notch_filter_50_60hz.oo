// # Product prove std/neuro_bci/eeg_notch_filter_50_60hz.oo
//
// Logline: Fail-closed emit+gcc+run asserts notch_state_zero is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/eeg_notch_filter_50_60hz.oo.
//
// Beats:
//   1. Call notch_state_zero twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eeg_notch_filter_50_60hz: PASSED only if they match.

import "std/neuro_bci/eeg_notch_filter_50_60hz.oo";

pub fn main() {
    let eeg_notch_filter_50_60hz_mark: Int = 0;
    if eeg_notch_filter_50_60hz_mark != 0 {
        process_exit(1);
    }
    let a: NotchFilterState = notch_state_zero();
    let b: NotchFilterState = notch_state_zero();
    if (a).d1 != (b).d1 {
        println("FAIL notch_state_zero");
        process_exit(1);
    }
    println("prod_g2_eeg_notch_filter_50_60hz: PASSED");
}
