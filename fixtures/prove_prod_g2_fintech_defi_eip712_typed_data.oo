// # Product prove std/fintech_defi/eip712_typed_data.oo
//
// Logline: Fail-closed emit+gcc+run asserts eip712_compute_domain_separator is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/eip712_typed_data.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call eip712_compute_domain_separator twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_eip712_typed_data: PASSED only if they match.

import "std/fintech_defi/eip712_typed_data.oo";

pub fn main() {
    let g2_oa: Eip712Domain = Eip712Domain { name: "x", version: "x", chain_id: 2, verifying_contract: "x", salt_hash: 2 };
    let g2_ob: Eip712Domain = Eip712Domain { name: "x", version: "x", chain_id: 2, verifying_contract: "x", salt_hash: 2 };
    let g2_a = eip712_compute_domain_separator(&g2_oa);
    let g2_b = eip712_compute_domain_separator(&g2_ob);
    if g2_a != g2_b {
        println("FAIL eip712_compute_domain_separator");
        process_exit(1);
    }
    println("prod_g2_eip712_typed_data: PASSED");
}
