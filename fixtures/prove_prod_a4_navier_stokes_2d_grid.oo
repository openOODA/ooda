// # Product prove std/physics_advanced/navier_stokes_2d_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts mac_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/navier_stokes_2d_grid.oo.
//
// Beats:
//   1. Call mac_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_navier_stokes_2d_grid: PASSED only if they match.

import "std/physics_advanced/navier_stokes_2d_grid.oo";

pub fn main() {
    let navier_stokes_2d_grid_mark: Int = 0;
    if navier_stokes_2d_grid_mark != 0 {
        process_exit(1);
    }
    let a: Float = mac_int_to_float(0);
    let b: Float = mac_int_to_float(0);
    if a != b {
        println("FAIL mac_int_to_float");
        process_exit(1);
    }
    println("prod_navier_stokes_2d_grid: PASSED");
}
