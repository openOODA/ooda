// # Product prove std/space_propulsion/space_propulsion_constants.oo
//
// Logline: Fail-closed emit+gcc+run asserts const_pi value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/space_propulsion_constants.oo.
//
// Beats:
//   1. Call const_pi twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_space_propulsion_constants: PASSED only if asserts hold.

import "std/space_propulsion/space_propulsion_constants.oo";

pub fn main() {
    let space_propulsion_constants: Float = const_pi();
    let space_propulsion_constants_b: Float = const_pi();
    if space_propulsion_constants != space_propulsion_constants_b {
        println("FAIL const_pi");
        process_exit(1);
    }
    println("prod_space_propulsion_constants: PASSED");
}
