// # Product prove std/sec/sys/audit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_types_module_loaded is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/audit_types.oo.
//
// Beats:
//   1. Call audit_types_module_loaded twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit_types: PASSED only if they match.

import "std/sec/sys/audit_types.oo";

pub fn main() {
    let a = audit_types_module_loaded();
    let b = audit_types_module_loaded();
    if a != b {
        println("FAIL audit_types_module_loaded");
        process_exit(1);
    }
    println("prod_audit_types: PASSED");
}
