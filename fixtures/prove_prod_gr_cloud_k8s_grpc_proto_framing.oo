// # Product prove std/cloud_k8s/grpc_proto_framing.oo
//
// Logline: Fail-closed emit+gcc+run asserts grpc_frame_header_size is a real value.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/grpc_proto_framing.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call grpc_frame_header_size twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_grpc_proto_framing: PASSED only if they match.

import "std/cloud_k8s/grpc_proto_framing.oo";

pub fn main() {
    let g0_a = grpc_frame_header_size();
    let g0_b = grpc_frame_header_size();
    if g0_a != g0_b {
        println("FAIL grpc_frame_header_size");
        process_exit(1);
    }
    println("prod_gr_grpc_proto_framing: PASSED");
}
