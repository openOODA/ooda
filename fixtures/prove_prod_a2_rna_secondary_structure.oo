// # Product prove std/bioinformatics/rna_secondary_structure.oo
//
// Logline: Fail-closed emit+gcc+run asserts int_pow4 is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/rna_secondary_structure.oo.
//
// Beats:
//   1. Call int_pow4 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rna_secondary_structure: PASSED only if they match.

import "std/bioinformatics/rna_secondary_structure.oo";

pub fn main() {
    let rna_secondary_structure_mark: Int = 0;
    if rna_secondary_structure_mark != 0 {
        process_exit(1);
    }
    let a: Int = int_pow4(0);
    let b: Int = int_pow4(0);
    if a != b {
        println("FAIL int_pow4");
        process_exit(1);
    }
    println("prod_rna_secondary_structure: PASSED");
}
