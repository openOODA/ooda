// # Product prove std/web_ecosystem/cuid2_generator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/cuid2_generator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/cuid2_generator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_cuid2_generator: PASSED only if they match.

import "std/web_ecosystem/cuid2_generator.oo";

pub fn main() {
    let cuid2_generator_a = cuid2_hash_step(0, 0);
    let cuid2_generator_b = cuid2_hash_step(0, 0);
    if cuid2_generator_a != cuid2_generator_b {
        println("FAIL cuid2_generator");
        process_exit(1);
    }
    println("prod_ap_cuid2_generator: PASSED");
}
