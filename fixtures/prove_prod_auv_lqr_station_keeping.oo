// # Product prove std/robotics_auv/auv_lqr_station_keeping.oo
//
// Logline: Fail-closed emit+gcc+run asserts lqr_station_gains_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/auv_lqr_station_keeping.oo.
//
// Beats:
//   1. Call lqr_station_gains_default twice with no args.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_auv_lqr_station_keeping: PASSED only if they match.

import "std/robotics_auv/auv_lqr_station_keeping.oo";

pub fn main() {
    let auv_lqr_station_keeping_mark: Int = 0;
    if auv_lqr_station_keeping_mark != 0 {
        process_exit(1);
    }
    let a: LqrStationGains = lqr_station_gains_default();
    let b: LqrStationGains = lqr_station_gains_default();
    if (a).field0 != (b).field0 {
        println("FAIL lqr_station_gains_default");
        process_exit(1);
    }
    println("prod_auv_lqr_station_keeping: PASSED");
}
