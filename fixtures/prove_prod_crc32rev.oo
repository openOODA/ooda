// # Product embedded crc32 reverse byte prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/embedded_hal/crc32_hardware.oo.
//
// Setup: Product std/embedded_hal/crc32_hardware.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. reverse_byte 0 is 0, 1 is 128, 255 is 255.
//   9. Exit 1 before PASSED on a miss.

import "std/embedded_hal/crc32_hardware.oo";

pub fn main() {
    let z: Int = crc32_reverse_byte(0);
    if z != 0 {
        println("FAIL crc32rev 0");
        process_exit(1);
    }
    let a: Int = crc32_reverse_byte(1);
    if a != 128 {
        println("FAIL crc32rev 1");
        process_exit(1);
    }
    let f: Int = crc32_reverse_byte(255);
    if f != 255 {
        println("FAIL crc32rev 255");
        process_exit(1);
    }
    println("prod_crc32rev: PASSED");
}
