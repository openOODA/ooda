// # Product prove std/os/dynamic_library_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/os/dynamic_library_stub.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/dynamic_library_stub.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_dynamic_library_stub: PASSED only if they match.

import "std/os/dynamic_library_stub.oo";

pub fn main() {
    let dynamic_library_stub_a = dynlib_desc_new("x");
    let dynamic_library_stub_b = dynlib_desc_new("x");
    let dynamic_library_stub_va = dynlib_path(dynamic_library_stub_a);
    let dynamic_library_stub_vb = dynlib_path(dynamic_library_stub_b);
    if dynamic_library_stub_va.contains(dynamic_library_stub_vb) == false {
        println("FAIL dynamic_library_stub");
        process_exit(1);
    }
    if dynamic_library_stub_vb.contains(dynamic_library_stub_va) == false {
        println("FAIL dynamic_library_stub");
        process_exit(1);
    }
    println("prod_ap_dynamic_library_stub: PASSED");
}
