// # Product prove std/physics_advanced/compressible_isentropic_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts isentropic_temperature_ratio is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_isentropic_flow.oo.
//
// Beats:
//   1. Call isentropic_temperature_ratio twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compressible_isentropic_flow: PASSED only if they match.

import "std/physics_advanced/compressible_isentropic_flow.oo";

pub fn main() {
    let compressible_isentropic_flow_mark: Int = 0;
    if compressible_isentropic_flow_mark != 0 {
        process_exit(1);
    }
    let a: Float = isentropic_temperature_ratio(0.0, 0.0);
    let b: Float = isentropic_temperature_ratio(0.0, 0.0);
    if a != b {
        println("FAIL isentropic_temperature_ratio");
        process_exit(1);
    }
    println("prod_compressible_isentropic_flow: PASSED");
}
