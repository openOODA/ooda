// # Hostile Cap Attenuate Escape Probe
//
// Logline: Refuse empty or forged parent seals and keep child rights distinct.
//
// Setup: Product cap_attenuate / cap_attenuate_ok HMAC child seals from a parent.
//
// Beats:
//   1. Empty parent and empty rights fail closed.
//   2. Forged 64-hex parent does not match a real parent seal for the same rights.
//   3. Child "r" differs from child "rwx" under the same real parent.

pub fn main() {
    if cap_attenuate_ok("", "r") {
        println("FAIL: empty parent ok");
        process_exit(1);
    }
    if cap_attenuate_ok("deadbeef", "") {
        println("FAIL: empty rights ok");
        process_exit(1);
    }
    let empty_child: String = cap_attenuate("", "r");
    if chars_len(empty_child) != 0 {
        println("FAIL: empty parent must yield empty seal");
        process_exit(1);
    }

    let parent: String = crypto_hmac_sha256_internal("root", "rwx");
    let forged: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    let real_r: String = cap_attenuate(parent, "r");
    let fake_r: String = cap_attenuate(forged, "r");
    if chars_len(real_r) != 64 {
        println("FAIL: real child len");
        process_exit(1);
    }
    if real_r == fake_r {
        println("FAIL: forged parent matched real child");
        process_exit(1);
    }
    if !cap_attenuate_ok(parent, "r") {
        println("FAIL: real parent ok");
        process_exit(1);
    }
    if !cap_attenuate_ok(forged, "r") {
        println("FAIL: forged parent still HMAC-ok shape");
        process_exit(1);
    }

    let child_w: String = cap_attenuate(parent, "rwx");
    if real_r == child_w {
        println("FAIL: rights escalation collision");
        process_exit(1);
    }
    println("hostile_attenuate: PASSED");
}
