// # Product prove std/fhe_lattices/fhe_bgv_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts bgv_eval_depth_consumed is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bgv_evaluator.oo.
//
// Beats:
//   1. Call bgv_eval_depth_consumed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_bgv_evaluator: PASSED only if they match.

import "std/fhe_lattices/fhe_bgv_evaluator.oo";

pub fn main() {
    let fhe_bgv_evaluator_mark: Int = 0;
    if fhe_bgv_evaluator_mark != 0 {
        process_exit(1);
    }
    let a: Int = bgv_eval_depth_consumed(0, 0);
    let b: Int = bgv_eval_depth_consumed(0, 0);
    if a != b {
        println("FAIL bgv_eval_depth_consumed");
        process_exit(1);
    }
    println("prod_fhe_bgv_evaluator: PASSED");
}
