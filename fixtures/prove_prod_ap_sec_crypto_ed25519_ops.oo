// # Product prove std/sec/crypto/ed25519_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/ed25519_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_ed25519_ops: PASSED only if they match.

import "std/sec/crypto/ed25519_ops.oo";

pub fn main() {
    let ed25519_ops_a = ed25519_checksum("x");
    let ed25519_ops_b = ed25519_checksum("x");
    if ed25519_ops_a != ed25519_ops_b {
        println("FAIL ed25519_ops");
        process_exit(1);
    }
    println("prod_ap_ed25519_ops: PASSED");
}
