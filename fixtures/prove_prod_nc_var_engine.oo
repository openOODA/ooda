// # Product prove std/fin/var_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts var_engine_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/fin/var_engine.oo.
//
// Beats:
//   1. Call var_engine_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_var_engine: PASSED only if it matches.

import "std/fin/var_engine.oo";

pub fn main() {
    let a: Int = var_engine_probe();
    if a != 0 {
        println("FAIL var_engine_probe");
        process_exit(1);
    }
    println("prod_nc_var_engine: PASSED");
}
