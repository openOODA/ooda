// # Product prove std/graph_networks/hyperanf_graph_diameter.oo
//
// Logline: Fail-closed emit+gcc+run asserts hyperanf_pow2 is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/hyperanf_graph_diameter.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call hyperanf_pow2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_hyperanf_graph_diameter: PASSED only if they match.

import "std/graph_networks/hyperanf_graph_diameter.oo";

pub fn main() {
    let g0_a = hyperanf_pow2(0);
    let g0_b = hyperanf_pow2(0);
    if g0_a != g0_b {
        println("FAIL hyperanf_pow2");
        process_exit(1);
    }
    println("prod_gr_hyperanf_graph_diameter: PASSED");
}
