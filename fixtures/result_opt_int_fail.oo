// # Result[Option[Int]] emit honesty lock
//
// Logline: emit-c fail-closes Result[Option[Int], String] rather than inventing OoRes_Option.
//
// Setup: Backend-C. Nested Option inside Result is residual.
//
// Beats:
//   1. Return Result[Option[Int], String].
//   2. Emit must not invent OoRes_Option.
//   3. Fail closed with ERR c_emit.

pub fn f() -> Result[Option[Int], String] {
    return Ok(Some(1));
}

pub fn main() {
    let r: Result[Option[Int], String] = f();
    println("should_not_emit");
}
