// # Product prove std/compilers_polyhedral/polyhedral_spatial_locality.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_cache_line_waste_percent is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_spatial_locality.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call spatial_cache_line_waste_percent twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_polyhedral_spatial_locality: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_spatial_locality.oo";

pub fn main() {
    let g2_a = spatial_cache_line_waste_percent(2, 2);
    let g2_b = spatial_cache_line_waste_percent(2, 2);
    if g2_a != g2_b {
        println("FAIL spatial_cache_line_waste_percent");
        process_exit(1);
    }
    println("prod_g2_polyhedral_spatial_locality: PASSED");
}
