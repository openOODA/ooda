// # Window function adversarial suite
//
// Logline: Builds four named windows of the same N, checks energy greater than zero, and rejects N less than 4.
//
// Setup: Pure. Imports window_funcs.oo. Run from ooda/.
//
// Beats:
//   1. Prove Hann, Hamming, Blackman-Harris, and Flat-Top of length 8.
//   2. Require sum of squares near 1 and Hann w0 near 0 versus Hamming w0 > 0.
//   3. Reject N less than 4. A Hann of all-ones is Err.

import "std/media_dsp/window_funcs.oo";

pub fn main() {
    let n: Int = 8;
    let h: Result[Int, String] = window_funcs_prove(0, n);
    if h.is_err() {
        println("FAIL hann");
        process_exit(1);
    }
    let m: Result[Int, String] = window_funcs_prove(1, n);
    if m.is_err() {
        println("FAIL hamming");
        process_exit(1);
    }
    let b: Result[Int, String] = window_funcs_prove(2, n);
    if b.is_err() {
        println("FAIL bh");
        process_exit(1);
    }
    let f: Result[Int, String] = window_funcs_prove(3, n);
    if f.is_err() {
        println("FAIL flat");
        process_exit(1);
    }
    println("all four named windows of the same N>=4");
    let hn: WinOut = window_funcs_hann(n);
    if hn.flag < 1 {
        println("FAIL hann box");
        process_exit(1);
    }
    let he: Float = hn.energy;
    let hw0: Float = hn.w0;
    let mut ed: Float = he - 1.0;
    if ed < 0.0 {
        ed = 0.0 - ed;
    }
    if ed > 0.01 {
        println("FAIL hann energy");
        process_exit(1);
    }
    let mut a0: Float = hw0;
    if a0 < 0.0 {
        a0 = 0.0 - a0;
    }
    if a0 > 0.01 {
        println("FAIL hann ones");
        process_exit(1);
    }
    println("Hann w0~0");
    let hm: WinOut = window_funcs_hamming(n);
    if hm.flag < 1 {
        println("FAIL hamming box");
        process_exit(1);
    }
    let me: Float = hm.energy;
    let mw0: Float = hm.w0;
    let mut md: Float = me - 1.0;
    if md < 0.0 {
        md = 0.0 - md;
    }
    if md > 0.01 {
        println("FAIL hamming energy");
        process_exit(1);
    }
    if mw0 <= 0.0 {
        println("FAIL hamming w0");
        process_exit(1);
    }
    println("Hamming w0>0");
    println("sum w^2 > 0");
    let z: WinOut = window_funcs_hann(3);
    if z.flag > 0 {
        println("FAIL N=3");
        process_exit(1);
    }
    let st: Result[Int, String] = window_funcs_stat(z.flag, z.err, 0);
    if st.is_ok() {
        println("FAIL stat");
        process_exit(1);
    }
    println("N<4 is Err");
    println("SUITE PASSED");
    println("test_window_funcs: PASSED");
}
