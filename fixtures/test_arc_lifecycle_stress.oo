// # ARC Lifecycle and Scope Exit Stress Fixture
//
// Logline: Stress-tests ARC retain/release parity under deep nesting, shadowing, and heavy loop allocations.
//
// Setup: Compile and run with AddressSanitizer to verify zero memory leaks and zero double frees.
//
// Beats:
//   1. Execute nested blocks with shadowed strings and lists.
//   2. Run 1000-iteration loop with inner temporary allocations.
//   3. Verify formal parameter isolation from inner block releases.
//   4. Assert correct computed results across all nested scopes.

fn test_shadow_scopes(formal_s: String) -> String {
    let mut root_val = formal_s + "_root";
    {
        let mut shadow_s = root_val + "_level1";
        let mut list1: List[String] = list_new();
        list1 = list_push(list1, shadow_s);
        {
            let mut shadow_s = shadow_s + "_level2";
            let mut list2: List[Int] = list_new();
            list2 = list_push(list2, 42);
            {
                let mut shadow_s = shadow_s + "_level3";
                let mut list3: List[String] = list_new();
                list3 = list_push(list3, shadow_s);
                list3 = list_push(list3, "item");
                if list_len(list3) != 2 {
                    println("FAIL: list3 len");
                    process_exit(1);
                }
            }
            if list_len(list2) != 1 {
                println("FAIL: list2 len");
                process_exit(1);
            }
        }
        if list_len(list1) != 1 {
            println("FAIL: list1 len");
            process_exit(1);
        }
    }
    return root_val;
}

fn test_loop_allocations() {
    let mut acc: String = "";
    let mut total_nums: Int = 0;
    let mut i: Int = 0;
    while i < 200 {
        // Inner scope temporary string and list allocations
        let tmp_str: String = "iter_" + i.to_string();
        let mut tmp_list: List[Int] = list_new();
        tmp_list = list_push(tmp_list, i);
        tmp_list = list_push(tmp_list, i * 2);
        total_nums = total_nums + list_get(tmp_list, 0) + list_get(tmp_list, 1);
        if i % 50 == 0 {
            acc = acc + tmp_str + ";";
        }
        i = i + 1;
    }
    if total_nums != 59700 {
        println("FAIL: loop total_nums expected 59700, got " + total_nums.to_string());
        process_exit(1);
    }
    if acc != "iter_0;iter_50;iter_100;iter_150;" {
        println("FAIL: loop acc expected iter_0;iter_50;iter_100;iter_150;, got " + acc);
        process_exit(1);
    }
}

fn test_prefix_collision_names() {
    let foo = "foo_val";
    let foobar = "foobar_val";
    let foobaz = "foobaz_val";
    let mut f_list: List[String] = list_new();
    f_list = list_push(f_list, foo);
    f_list = list_push(f_list, foobar);
    f_list = list_push(f_list, foobaz);
    if list_len(f_list) != 3 {
        println("FAIL: prefix list len");
        process_exit(1);
    }
    if list_get(f_list, 0) != "foo_val" || list_get(f_list, 1) != "foobar_val" || list_get(f_list, 2) != "foobaz_val" {
        println("FAIL: prefix list contents");
        process_exit(1);
    }
}

pub fn main() {
    println("Running ARC Lifecycle Stress Fixture...");
    let res = test_shadow_scopes("start");
    if res != "start_root" {
        println("FAIL: test_shadow_scopes return value");
        process_exit(1);
    }
    test_loop_allocations();
    test_prefix_collision_names();
    println("ARC_LIFECYCLE_STRESS_PASSED");
}
