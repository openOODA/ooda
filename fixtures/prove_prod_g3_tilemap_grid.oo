// # Product prove std/game_engine/tilemap_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts grid_type_orthogonal is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/tilemap_grid.oo.
//
// Beats:
//   1. Call grid_type_orthogonal twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tilemap_grid: PASSED only if they match.

import "std/game_engine/tilemap_grid.oo";

pub fn main() {
    let tilemap_grid_mark: Int = 0;
    if tilemap_grid_mark != 0 {
        process_exit(1);
    }
    let a: Int = grid_type_orthogonal();
    let b: Int = grid_type_orthogonal();
    if a != b {
        println("FAIL grid_type_orthogonal");
        process_exit(1);
    }
    println("prod_tilemap_grid: PASSED");
}
