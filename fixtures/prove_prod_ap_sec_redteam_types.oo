// # Product prove std/sec/redteam_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/redteam_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/redteam_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_redteam_types: PASSED only if they match.

import "std/sec/redteam_types.oo";

pub fn main() {
    let redteam_types_a = vulnerability_new(0, 0);
    let redteam_types_b = vulnerability_new(0, 0);
    let redteam_types_va = vulnerability_severity(redteam_types_a);
    let redteam_types_vb = vulnerability_severity(redteam_types_b);
    if redteam_types_va != redteam_types_vb {
        println("FAIL redteam_types");
        process_exit(1);
    }
    println("prod_ap_redteam_types: PASSED");
}
