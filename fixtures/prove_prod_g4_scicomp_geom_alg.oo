// # Product prove std/scicomp/geometric_algebra_3d.oo
//
// Logline: Fail-closed verification that 3D geometric algebra multivector operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/geometric_algebra_3d.oo.
//
// Beats:
//   1. Construct 3D multivectors across scalar, vector, bivector, and pseudoscalar grades.
//   2. Evaluate multivector addition, scaling, reversion, and Hodge dual.
//   3. Assert deterministic results across repeated invocations.
//   4. Print prod_g4_scicomp_geom_alg: PASSED and exit 0.

import "std/scicomp/geometric_algebra_3d.oo";

pub fn main() {
    let s1: MultiVector3D = mv3_scalar(3.0);
    let s2: MultiVector3D = mv3_scalar(3.0);
    if (s1).s != (s2).s || (s1).s != 3.0 {
        println("FAIL mv3_scalar");
        process_exit(1);
    }

    let v1: MultiVector3D = mv3_vector(1.0, 2.0, 3.0);
    let v2: MultiVector3D = mv3_vector(1.0, 2.0, 3.0);
    if (v1).e1 != (v2).e1 || (v1).e2 != 2.0 || (v1).e3 != 3.0 {
        println("FAIL mv3_vector");
        process_exit(1);
    }

    let b1: MultiVector3D = mv3_bivector(4.0, 5.0, 6.0);
    if (b1).e12 != 4.0 || (b1).e23 != 5.0 || (b1).e31 != 6.0 {
        println("FAIL mv3_bivector");
        process_exit(1);
    }

    let p1: MultiVector3D = mv3_pseudoscalar(7.0);
    if (p1).e123 != 7.0 {
        println("FAIL mv3_pseudoscalar");
        process_exit(1);
    }

    let sum1: MultiVector3D = mv3_add(&v1, &v2);
    let sum2: MultiVector3D = mv3_add(&v1, &v2);
    if (sum1).e1 != (sum2).e1 || (sum1).e1 != 2.0 || (sum1).e2 != 4.0 || (sum1).e3 != 6.0 {
        println("FAIL mv3_add");
        process_exit(1);
    }

    let scaled: MultiVector3D = mv3_scale(&v1, 3.0);
    if (scaled).e1 != 3.0 || (scaled).e2 != 6.0 || (scaled).e3 != 9.0 {
        println("FAIL mv3_scale");
        process_exit(1);
    }

    let rev: MultiVector3D = mv3_reverse(&b1);
    if (rev).e12 != (0.0 - 4.0) || (rev).e23 != (0.0 - 5.0) || (rev).e31 != (0.0 - 6.0) {
        println("FAIL mv3_reverse");
        process_exit(1);
    }

    let dual: MultiVector3D = mv3_hodge_dual(&v1);
    if (dual).e23 != 1.0 || (dual).e31 != 2.0 || (dual).e12 != (0.0 - 3.0) {
        println("FAIL mv3_hodge_dual");
        process_exit(1);
    }

    println("prod_g4_scicomp_geom_alg: PASSED");
    process_exit(0);
}
