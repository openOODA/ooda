// # Product prove std/crispr_cas/prime_editing_flap_equilibration.oo
//
// Logline: Fail-closed emit+gcc+run asserts flap_calc_equilibrium is a real value.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_flap_equilibration.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call flap_calc_equilibrium twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_prime_editing_flap_equilibration: PASSED only if they match.

import "std/crispr_cas/prime_editing_flap_equilibration.oo";

pub fn main() {
    let g2_oa: FlapEquilibriumState = flap_calc_equilibrium(1.0, 1.0, 8);
    let g2_ob: FlapEquilibriumState = flap_calc_equilibrium(1.0, 1.0, 8);
    let g2_a = (g2_oa).edited_flap_dg;
    let g2_b = (g2_ob).edited_flap_dg;
    if g2_a != g2_b {
        println("FAIL flap_calc_equilibrium.edited_flap_dg");
        process_exit(1);
    }
    println("prod_g2_prime_editing_flap_equilibration: PASSED");
}
