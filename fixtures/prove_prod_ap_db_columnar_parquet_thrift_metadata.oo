// # Product prove std/db_columnar/parquet_thrift_metadata.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/parquet_thrift_metadata.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/parquet_thrift_metadata.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_parquet_thrift_metadata: PASSED only if they match.

import "std/db_columnar/parquet_thrift_metadata.oo";

pub fn main() {
    let parquet_thrift_metadata_a = file_metadata_new(0, "x");
    let parquet_thrift_metadata_b = file_metadata_new(0, "x");
    let parquet_thrift_metadata_va = file_metadata_find_column_index(parquet_thrift_metadata_a, "x");
    let parquet_thrift_metadata_vb = file_metadata_find_column_index(parquet_thrift_metadata_b, "x");
    if parquet_thrift_metadata_va != parquet_thrift_metadata_vb {
        println("FAIL parquet_thrift_metadata");
        process_exit(1);
    }
    println("prod_ap_parquet_thrift_metadata: PASSED");
}
