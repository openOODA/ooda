// # Product prove std/os/symlink_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts symlink_target is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/symlink_stub.oo.
//
// Beats:
//   1. Call symlink_target twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_symlink_stub: PASSED only if they match.

import "std/os/symlink_stub.oo";

pub fn main() {
    let obj = symlink_desc_new("x", "x");
    let a = symlink_target(obj);
    let b = symlink_target(obj);
    if a != b {
        println("FAIL symlink_target");
        process_exit(1);
    }
    println("prod_symlink_stub: PASSED");
}
