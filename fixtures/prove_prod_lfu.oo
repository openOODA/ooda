// # Product lfu_cache prove
//
// Logline: Fail-closed emit+gcc+run of shipped lfu_put/len.
//
// Setup: Product std/collections/lfu_cache.oo. List[Int] destub.
//
// Beats:
//   1. After put 7->1, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/lfu_cache.oo";

pub fn main() {
    let mut c: LfuCache = lfu_new(4);
    c = lfu_put(c, 7, 1);
    let n: Int = lfu_len(c);
    if n != 1 {
        println("FAIL lfu len");
        process_exit(1);
    }
    println("prod_lfu: PASSED");
}
