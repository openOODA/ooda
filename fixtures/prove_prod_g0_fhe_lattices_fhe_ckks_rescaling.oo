// # Product prove std/fhe_lattices/fhe_ckks_rescaling.oo
//
// Logline: Fail-closed emit+gcc+run asserts ckks_rescale_coeff is a real value.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_ckks_rescaling.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ckks_rescale_coeff twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_fhe_ckks_rescaling: PASSED only if they match.

import "std/fhe_lattices/fhe_ckks_rescaling.oo";

pub fn main() {
    let g0_a = ckks_rescale_coeff(2, 2);
    let g0_b = ckks_rescale_coeff(2, 2);
    if g0_a != g0_b {
        println("FAIL ckks_rescale_coeff");
        process_exit(1);
    }
    println("prod_g0_fhe_ckks_rescaling: PASSED");
}
