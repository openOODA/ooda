// # Product prove std/digital_twin/bond_graph_thermal_domain.oo
//
// Logline: Fail-closed emit+gcc+run asserts thermal_conduction_resistance is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/bond_graph_thermal_domain.oo.
//
// Beats:
//   1. Call thermal_conduction_resistance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bond_graph_thermal_domain: PASSED only if they match.

import "std/digital_twin/bond_graph_thermal_domain.oo";

pub fn main() {
    let bond_graph_thermal_domain_mark: Int = 0;
    if bond_graph_thermal_domain_mark != 0 {
        process_exit(1);
    }
    let a: Float = thermal_conduction_resistance(0.0, 0.0, 0.0);
    let b: Float = thermal_conduction_resistance(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL thermal_conduction_resistance");
        process_exit(1);
    }
    println("prod_bond_graph_thermal_domain: PASSED");
}
