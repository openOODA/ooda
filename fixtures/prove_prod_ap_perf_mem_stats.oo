// # Product prove std/perf/mem_stats.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/perf/mem_stats.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/mem_stats.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mem_stats: PASSED only if they match.

import "std/perf/mem_stats.oo";

pub fn main() {
    let mem_stats_a = mem_stats_create("x");
    let mem_stats_b = mem_stats_create("x");
    let mem_stats_va = mem_stats_live(mem_stats_a);
    let mem_stats_vb = mem_stats_live(mem_stats_b);
    if mem_stats_va != mem_stats_vb {
        println("FAIL mem_stats");
        process_exit(1);
    }
    println("prod_ap_mem_stats: PASSED");
}
