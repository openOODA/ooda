// # Product prove std/graph_topology/hits_authority_hub.oo
//
// Logline: Fail-closed emit+gcc+run asserts hits_authority_hub_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_topology/hits_authority_hub.oo.
//
// Beats:
//   1. Call hits_authority_hub_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_hits_authority_hub: PASSED only if it matches.

import "std/graph_topology/hits_authority_hub.oo";

pub fn main() {
    let a: Int = hits_authority_hub_probe();
    if a != 0 {
        println("FAIL hits_authority_hub_probe");
        process_exit(1);
    }
    println("prod_nc_hits_authority_hub: PASSED");
}
