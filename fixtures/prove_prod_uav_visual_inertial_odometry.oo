// # Product prove std/uav_flight/uav_visual_inertial_odometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_intrinsics_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_visual_inertial_odometry.oo.
//
// Beats:
//   1. Call camera_intrinsics_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_visual_inertial_odometry: PASSED only if they match.

import "std/uav_flight/uav_visual_inertial_odometry.oo";

pub fn main() {
    let uav_visual_inertial_odometry_mark: Int = 0;
    if uav_visual_inertial_odometry_mark != 0 {
        process_exit(1);
    }
    let a: CameraIntrinsics = camera_intrinsics_default();
    let b: CameraIntrinsics = camera_intrinsics_default();
    if (a).fx != (b).fx {
        println("FAIL camera_intrinsics_default");
        process_exit(1);
    }
    println("prod_uav_visual_inertial_odometry: PASSED");
}
