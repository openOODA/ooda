// # emit-x86 minus-first mix bound then printed
//
// Logline: Bind s to unary-minus 7 plus x and print s so emit-x86 can lower a mix let.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No hello fold.
//
// Beats:
//   1. Declare main.
//   2. Bind s to unary-minus 7 plus x.
//   3. Print s.
//
// residual: int plus int and greet calls stay later.

pub fn main() {
    let s = -7 + "x";
    println(s);
}
