// # Product prove std/web_protocols/turn_allocation.oo
//
// Logline: Fail-closed emit+gcc+run asserts turn_channel_in_range is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/turn_allocation.oo.
//
// Beats:
//   1. Call turn_channel_in_range twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_turn_allocation: PASSED only if they match.

import "std/web_protocols/turn_allocation.oo";

pub fn main() {
    let turn_allocation_mark: Int = 0;
    if turn_allocation_mark != 0 {
        process_exit(1);
    }
    let a: Int = turn_channel_in_range(0);
    let b: Int = turn_channel_in_range(0);
    if a != b {
        println("FAIL turn_channel_in_range");
        process_exit(1);
    }
    println("prod_turn_allocation: PASSED");
}
